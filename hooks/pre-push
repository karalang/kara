#!/usr/bin/env bash
# Pre-push gate: run the bug-ledger integrity lint before every push, so a
# malformed docs/bug-ledger.jsonl is caught locally instead of reddening the
# required `Lint` CI job on main. The recurring offender is a stale PRE-REBASE
# fix SHA: a row's `fix` is filled in with a commit SHA that a later rebase
# changes, leaving the ledger citing a SHA that no longer resolves.
#
# Enable per-clone (core.hooksPath is not set by `git clone`):
#     scripts/install-hooks.sh          # or: git config core.hooksPath hooks
# Bypass a single push when you deliberately need to:
#     git push --no-verify
#
# COVERAGE — bug-lint rule 6 asks whether a fix SHA RESOLVES, which needs
# history, so on a shallow clone it runs only over the rows the tree changes and
# its full-tree audit is skipped. Neither half sees the case this hook was
# written for: an orphaned commit keeps its object in the clone that made it, so
# it resolves there and the check passes (B-2026-09-16-8). Rule 6b is the half
# that catches it — reachability from HEAD/origin/main, which needs no history at
# all. Rule 6's full-tree audit still wants an un-shallow clone, so
# `git fetch --unshallow` remains worth it where it is cheap.
#
# NOTE ON REACH — this hook is opt-in per clone (core.hooksPath is not set by
# `git clone`), so in a fresh container it is INERT until install-hooks.sh runs.
# Do not treat it as the only gate: run scripts/bug-lint.sh explicitly after a
# close, which is what CLAUDE.md's ledger workflow asks for.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
lint="$repo_root/scripts/bug-lint.sh"

if [ ! -x "$lint" ]; then
    echo "pre-push: $lint not found or not executable — skipping bug-ledger lint" >&2
    exit 0
fi

if "$lint"; then
    exit 0
fi

echo >&2
echo "pre-push: bug-ledger lint failed — push blocked." >&2
echo "  Fix the error(s) above in docs/bug-ledger.jsonl (a dangling fix SHA is" >&2
echo "  usually a pre-rebase SHA — cite the post-rebase commit instead), then" >&2
echo "  regenerate the rollup:  python3 scripts/bug-curve.py --inject docs/bug-ledger.md" >&2
echo "  Or bypass this one push with:  git push --no-verify" >&2
exit 1
