// Cost-summary fixture. It used to trigger an RC fallback for `d` in
// `process`; under the core rules `consume` and `use_d` borrow, so the
// `karac query cost-summary` driver tests assert it has none (core
// semantics §6.4, B-2026-11-06-5).
struct Data { value: i64 }
fn consume(d: Data) {}
fn use_d(d: Data) {}

fn process(d: Data) {
    match d.value {
        0 => consume(d),
        _ => {}
    }
    use_d(d);
}

fn main() {
    process(Data { value: 0 });
}
