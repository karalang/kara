struct V { o: Option[Option[i64]] }
fn ig(x: V) -> i64 { 1 }
fn main() {
    let n = env.args().len() as i64;
    let mut i: i64 = 0; let mut acc: i64 = 0;
    while i < 10 {
        let v: V = V { o: Option.Some(Option.Some(n + i)) };
        acc = acc + ig(v);
        i = i + 1;
    }
    println(acc);
}
