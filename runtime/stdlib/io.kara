// runtime/stdlib/io.kara
//
// Ambient effect-resource method signatures lifted from
// `register_compiler_intrinsic_env` into baked stdlib source. Despite the
// filename, the file's scope is every entry in `PRELUDE_EFFECT_RESOURCES`:
// I/O primitives (`Stdin`, `Stdout`, `Stderr`, `FileSystem`), the
// nondeterminism resources (`Clock`, `RandomSource`), and `Env`. Each one
// is registered as a `SymbolKind::EffectResource` via the prelude; the
// empty struct here exists purely so `impl <Resource> { ... }` has a target
// type for `env_add_impl` to register methods against. Authoring the
// signatures here lets the surface grow in source instead of in three
// hand-coded sites per method.
//
// Method bodies are placeholder `#[compiler_builtin]` stubs: real dispatch
// fires in `eval_resource_method` → `dispatch_builtin_resource_method_with_values`
// (interpreter), which routes through the provider stack so
// `with_provider[Stdin](Fake {}, || ...)` interception keeps working.
//
// Slice 1 baked Stdin; slice 2 extended to Stdout / Stderr / FileSystem /
// Env; slice 3 added Clock / RandomSource for symmetry (no behavior change —
// they had no manual typechecker registration before). The lowercase
// module-path forms `env.args()` / `env.var(name)` stay as manual
// `env.functions` entries in `register_compiler_intrinsic_env` — they
// alias the capitalized `Env.args()` / `Env.var(name)` paths but the
// lowercase form has no syntactic representation as an impl method.

struct Stdin { }

// Lazy line iterator over standard input (design.md § "Source effects flow
// through adaptors" — `io.lines()` binds `reads(Stdin), blocks`). Empty marker;
// stdin is ambient, so — unlike the File-backed `LinesIter` — it carries no
// reader handle. Iteration is driven by the compiler (interpreter for-loop
// drain / codegen per-iteration `karac_runtime_stdin_read_line` loop), yielding
// `Result[String, IoError]` per line (trailing newline stripped) until EOF, the
// same Item shape as `BufReader.lines()`. Reached as `stdin.lines()` /
// `Stdin.lines()` (the surface `Stdin.read_line` uses; the design's `io.`
// prefix is not a wired module alias for any stdin method).
struct StdinLines { }

impl StdinLines {
    // The next line, without its `\n` / `\r\n`, or `None` at EOF. A `for`
    // loop over `stdin.lines()` calls it once per round (the MIR backends'
    // native `StdinLines.next`); the legacy interpreter drains the loop
    // itself.
    #[compiler_builtin]
    fn next(mut ref self) -> Option[Result[String, IoError]] with reads(Stdin) blocks { None }
}

impl Stdin {
    #[compiler_builtin]
    fn read_line() -> Result[String, IoError] { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn read_to_string() -> Result[String, IoError] { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn lines() -> StdinLines with reads(Stdin) blocks { StdinLines { } }
}

struct Stdout { }

impl Stdout {
    #[compiler_builtin]
    fn print(s: ref String) { }

    #[compiler_builtin]
    fn println(s: ref String) { }

    #[compiler_builtin]
    fn flush() { }
}

struct Stderr { }

impl Stderr {
    #[compiler_builtin]
    fn print(s: ref String) { }

    #[compiler_builtin]
    fn println(s: ref String) { }

    #[compiler_builtin]
    fn flush() { }
}

struct FileSystem { }

impl FileSystem {
    #[compiler_builtin]
    fn read_to_string(path: Str) -> Result[String, IoError] { Err(IoError.Other("placeholder")) }

    // `fs.read_lines(path)` — read a whole file and split it into lines
    // (design.md § I/O; phase-8 line 773). Slurp-first, matching the fs
    // surface's philosophy: returns an eager `Vec[String]` (not a streaming
    // iterator), with the outer `Result` for open/read failure. Line splitting
    // follows Rust `str::lines()` — split on `\n`, strip a trailing `\r`, and a
    // final newline yields no trailing empty element. `karac run` only at v1;
    // `karac build` rejects it loudly (codegen for the `Result[Vec[String], _]`
    // return is a tracked follow-on).
    #[compiler_builtin]
    fn read_lines(path: Str) -> Result[Vec[String], IoError] with reads(FileSystem) {
        Err(IoError.Other("placeholder"))
    }

    #[compiler_builtin]
    fn write(path: Str, contents: Str) -> Result[(), IoError] { Err(IoError.Other("placeholder")) }

    // The rest of the file system surface (docs/library/io.md § Files,
    // B-2026-10-14-54). `exists` is `false` on any error; `read_dir` gives
    // the entry names sorted byte-wise.
    #[compiler_builtin]
    fn exists(path: Str) -> bool with reads(FileSystem) { false }

    #[compiler_builtin]
    fn metadata(path: Str) -> Result[Metadata, IoError] with reads(FileSystem) {
        Err(IoError.Other("placeholder"))
    }

    #[compiler_builtin]
    fn read_dir(path: Str) -> Result[Vec[String], IoError] with reads(FileSystem) {
        Err(IoError.Other("placeholder"))
    }

    #[compiler_builtin]
    fn create_dir(path: Str) -> Result[(), IoError] with writes(FileSystem) {
        Err(IoError.Other("placeholder"))
    }

    #[compiler_builtin]
    fn create_dir_all(path: Str) -> Result[(), IoError] with writes(FileSystem) {
        Err(IoError.Other("placeholder"))
    }

    #[compiler_builtin]
    fn remove_file(path: Str) -> Result[(), IoError] with writes(FileSystem) {
        Err(IoError.Other("placeholder"))
    }

    #[compiler_builtin]
    fn remove_dir(path: Str) -> Result[(), IoError] with writes(FileSystem) {
        Err(IoError.Other("placeholder"))
    }

    #[compiler_builtin]
    fn remove_dir_all(path: Str) -> Result[(), IoError] with writes(FileSystem) {
        Err(IoError.Other("placeholder"))
    }

    #[compiler_builtin]
    fn rename(from: Str, to: Str) -> Result[(), IoError] with writes(FileSystem) {
        Err(IoError.Other("placeholder"))
    }

    #[compiler_builtin]
    fn copy(from: Str, to: Str) -> Result[i64, IoError] with reads(FileSystem) writes(FileSystem) {
        Err(IoError.Other("placeholder"))
    }

    // Byte twins of `read_to_string` / `write` (B-2026-10-15-28).
    #[compiler_builtin]
    fn read_bytes(path: Str) -> Result[Vec[u8], IoError] with reads(FileSystem) {
        Err(IoError.Other("placeholder"))
    }

    #[compiler_builtin]
    fn write_bytes(path: Str, content: Slice[u8]) -> Result[(), IoError] with writes(FileSystem) {
        Err(IoError.Other("placeholder"))
    }

    // Links, modes and times, for tools that restore what an archive
    // records (B-2026-10-15-59).
    #[compiler_builtin]
    fn symlink(target: Str, link: Str) -> Result[(), IoError] with writes(FileSystem) {
        Err(IoError.Other("placeholder"))
    }

    #[compiler_builtin]
    fn read_link(path: Str) -> Result[String, IoError] with reads(FileSystem) {
        Err(IoError.Other("placeholder"))
    }

    #[compiler_builtin]
    fn symlink_metadata(path: Str) -> Result[Metadata, IoError] with reads(FileSystem) {
        Err(IoError.Other("placeholder"))
    }

    #[compiler_builtin]
    fn set_permissions(path: Str, mode: i64) -> Result[(), IoError] with writes(FileSystem) {
        Err(IoError.Other("placeholder"))
    }

    #[compiler_builtin]
    fn set_modified(path: Str, ms: i64) -> Result[(), IoError] with writes(FileSystem) {
        Err(IoError.Other("placeholder"))
    }
}

// What `fs.metadata(path)` (which follows symbolic links) and
// `fs.symlink_metadata(path)` (which does not) return: the size in bytes,
// the kind, the modification time in milliseconds since the Unix epoch,
// and the mode's permission bits. Fields will be added, so build one only
// by calling `metadata`.
struct Metadata {
    len: i64,
    is_file: bool,
    is_dir: bool,
    modified_ms: i64,
    is_symlink: bool,
    mode: i64,
}

// Phase 8 `File` handle slice F1 (2026-05-26): stateful file I/O. The
// struct body is empty by design — like `Map[K,V]` / `Sender[T]` /
// `Pool[T]`, the actual state (an `Arc<Mutex<std::fs::File>>`) lives
// on the `Value::File` interpreter variant; the typechecker only
// needs to know the type exists. Constructors `File.open` / `.create`
// / `.append` return `Result[File, IoError]`; instance methods
// `read` / `write` / `flush` / `sync_all` / `sync_data` thread through
// the mutex. Drop on the last Arc closes the OS file descriptor.
// `metadata` is deferred to a follow-on slice. See
// `phase-8-stdlib-floor.md` "File handle type" entry for the full
// sub-task plan.
struct File { }

impl File {
    #[compiler_builtin]
    fn open(path: Str) -> Result[File, IoError] with reads(FileSystem) { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn create(path: Str) -> Result[File, IoError] with writes(FileSystem) { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn append(path: Str) -> Result[File, IoError] with writes(FileSystem) { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn read(ref self, buf: mut Slice[u8]) -> Result[i64, IoError] with reads(FileSystem) { Err(IoError.Other("placeholder")) }

    // `write` soils the cancel-safe state of the receiver: buffered
    // OS-level writes may remain unflushed, and cancelling between
    // `write` and `flush` would discard the pending bytes silently.
    // The slice-3 RAII-across-yield walker reads this attribute and
    // rejects a yield while any `File` binding has an unflushed
    // write. Clear methods are a comma-separated list, first name is
    // the one the diagnostic suggests: `flush` is the cheapest, and
    // `sync_all` / `sync_data` also clear because they are strictly
    // stronger (they flush *and* fsync).
    #[compiler_builtin]
    #[cancel_unsafe_until(method: "flush,sync_all,sync_data")]
    fn write(ref self, buf: Slice[u8]) -> Result[i64, IoError] with writes(FileSystem) { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn flush(ref self) -> Result[(), IoError] with writes(FileSystem) { Err(IoError.Other("placeholder")) }

    // Durability. `flush` is NOT a substitute: it pushes userspace
    // buffers and never the OS page cache, so flushed-only data is
    // still lost on power failure. `sync_all` issues the real fsync
    // (contents + metadata); `sync_data` is the fdatasync-shaped
    // cheaper form that may skip metadata, falling back to a full
    // fsync where the platform has no fdatasync — so it is never less
    // durable than it claims. design.md § cancellation safety names
    // these two as the caller's durability obligation before a yield.
    #[compiler_builtin]
    fn sync_all(ref self) -> Result[(), IoError] with writes(FileSystem) { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn sync_data(ref self) -> Result[(), IoError] with writes(FileSystem) { Err(IoError.Other("placeholder")) }

    // B-2026-08-10-3 — random access. Returns the NEW absolute position
    // from the start of the file, so the common "where am I?" query is
    // `f.seek(SeekFrom.Current, 0)` with no separate `tell`.
    //
    // `reads(FileSystem)` rather than `writes`: seek moves the handle's
    // cursor and never touches file CONTENTS. That matches `read`, which
    // also advances the cursor and is likewise `reads` — the effect
    // describes what happens to the resource's data, not to the handle.
    //
    // Note the argument order mirrors the runtime ABI (`whence` then
    // `offset`) rather than Rust's payload-carrying `SeekFrom::Start(n)`.
    // See the ledger row for that trade.
    #[compiler_builtin]
    fn seek(ref self, whence: own SeekFrom, offset: i64) -> Result[i64, IoError] with reads(FileSystem) { Err(IoError.Other("placeholder")) }

    // B-2026-10-15-28. Truncates or zero-extends the file to `len` bytes
    // without moving the cursor; a negative `len` is `InvalidInput`.
    #[compiler_builtin]
    fn set_len(ref self, len: i64) -> Result[(), IoError] with writes(FileSystem) { Err(IoError.Other("placeholder")) }

    // The general way to open a file: `File.options().read(true)
    // .write(true).create(true).open(path)`. Building the options touches
    // nothing.
    #[compiler_builtin]
    fn options() -> OpenOptions { OpenOptions { flags: 0 } }
}

// How `OpenOptions.open` opens a file (B-2026-10-15-28): one bit per
// option, read 1, write 2, append 4, truncate 8, create 16, create_new 32.
// Build one only with `File.options()`. Every method is a native of the
// MIR backends; the builder's only set or clear a bit.
struct OpenOptions { flags: i64 }

impl OpenOptions {
    #[compiler_builtin]
    fn read(own self, on: bool) -> OpenOptions { self }

    #[compiler_builtin]
    fn write(own self, on: bool) -> OpenOptions { self }

    #[compiler_builtin]
    fn append(own self, on: bool) -> OpenOptions { self }

    #[compiler_builtin]
    fn truncate(own self, on: bool) -> OpenOptions { self }

    #[compiler_builtin]
    fn create(own self, on: bool) -> OpenOptions { self }

    #[compiler_builtin]
    fn create_new(own self, on: bool) -> OpenOptions { self }

    // The effects are the union of reading and writing, because the
    // options are run-time values.
    #[compiler_builtin]
    fn open(ref self, path: Str) -> Result[File, IoError] with reads(FileSystem) writes(FileSystem) { Err(IoError.Other("placeholder")) }
}

// B-2026-08-10-3. Payload-free by design: the offset rides `File.seek`'s
// second parameter, so this enum is exactly the runtime's `whence` byte
// (0 = Start, 1 = Current, 2 = End) and the lowering is a tag truncation.
//
// `Start` counts forward from byte 0 and rejects a negative offset at the
// OS layer (surfacing as `Err`); `Current` and `End` accept negatives, so
// `SeekFrom.End, -4` addresses the last four bytes.
enum SeekFrom {
    Start,
    Current,
    End,
}

// The provider traits of the program-rooted resources (core-semantics
// §14.7). The v2 library declares the resources with their defaults
// (`effect resource Env: EnvProvider = OsEnv {};`, in
// runtime/stdlib/source/providers.kara); a test double implements the
// trait and is bound with `with_provider[Env](fake, || ..)`. Every method
// has a body that panics naming the resource and the method, so a double
// states only the methods it uses, a test never reaches the real
// environment, clock or random source by accident, and a method added
// here later breaks no existing double.
trait EnvProvider {
    // The program's arguments, the program's name first.
    fn args(ref self) -> Vec[String] {
        panic("Env.args called on a provider that does not implement it")
    }

    fn var(ref self, name: Str) -> Result[String, VarError] {
        panic("Env.var called on a provider that does not implement it")
    }

    fn set(mut ref self, name: Str, value: Str) {
        panic("Env.set called on a provider that does not implement it")
    }
}

trait ClockProvider {
    // Whole seconds since the Unix epoch.
    fn now(ref self) -> i64 {
        panic("Clock.now called on a provider that does not implement it")
    }

    // Nanoseconds from an origin fixed for the process; never goes
    // backwards.
    fn monotonic_ns(ref self) -> i64 {
        panic("Clock.monotonic_ns called on a provider that does not implement it")
    }

    // Nanoseconds since the Unix epoch, from a clock that may jump.
    fn wall_ns(ref self) -> i64 {
        panic("Clock.wall_ns called on a provider that does not implement it")
    }
}

trait RandomProvider {
    // A draw advances the source, so it takes the provider by `mut ref`
    // (core-semantics §14.7): two draws keep their order, and a seeded or
    // counting fake can keep its state.
    fn next_u64(mut ref self) -> u64 {
        panic("RandomSource.next_u64 called on a provider that does not implement it")
    }
}

struct Env { }

impl Env {
    #[compiler_builtin]
    fn args() -> Vec[String] { Vec.new() }

    #[compiler_builtin]
    fn var(name: Str) -> Result[String, VarError] { Err(VarError.NotPresent) }

    #[compiler_builtin]
    fn set(name: own String, value: own String) { }
}

struct Clock { }

impl Clock {
    #[compiler_builtin]
    fn now() -> i64 { 0 }

    // Nanoseconds from an arbitrary origin fixed for the process; never
    // goes backwards. For measuring intervals (`Instant`).
    #[compiler_builtin]
    fn monotonic_ns() -> i64 { 0 }

    // Nanoseconds since the Unix epoch, from the system clock, which may
    // jump (`SystemTime`). 0 for a clock set before the epoch.
    #[compiler_builtin]
    fn wall_ns() -> i64 { 0 }
}

struct RandomSource { }

impl RandomSource {
    #[compiler_builtin]
    fn next_u64() -> u64 { 0 }
}

// `?`-propagation from `env.var(...) -> Result[String, VarError]` into a
// function returning `Result[T, IoError]` desugars to `IoError.from(e)`,
// which dispatches through this impl. Variant mapping: `NotPresent` is the
// "missing key" condition (mirrors `IoError.NotFound`); `NotUnicode` is the
// "decoded payload was not valid UTF-8" condition (mirrors
// `IoError.InvalidUtf8`). One-way only — the reverse direction is not
// meaningful (a generic I/O error has no `VarError` projection).
impl From for IoError {
    fn from(e: own VarError) -> IoError {
        match e {
            VarError.NotPresent => IoError.NotFound,
            VarError.NotUnicode => IoError.InvalidUtf8,
        }
    }
}
