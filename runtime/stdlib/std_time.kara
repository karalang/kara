// `std.time`: `Duration`, `SystemTime` and `sleep`
// (docs/library/time-random-env.md; B-2026-10-15-10). `Clock` and
// `sleep_ms` are globals of the library.

/// A span of time, held in nanoseconds.
#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Debug)]
pub struct Duration {
    ns: i64,
}

impl Duration {
    /// `ms` milliseconds.
    pub fn ms(ms: i64) -> Duration {
        Duration { ns: ms * 1000000 }
    }

    /// `secs` seconds.
    pub fn secs(secs: i64) -> Duration {
        Duration { ns: secs * 1000000000 }
    }

    /// The whole milliseconds in this span.
    pub fn as_ms(self) -> i64 {
        self.ns / 1000000
    }
}

/// Wall-clock time, which can jump when the system clock is set. Use an
/// `Instant` to measure how long something takes.
#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Debug)]
pub struct SystemTime {
    ns: i64,
}

impl SystemTime {
    /// The current wall-clock time.
    pub fn now() -> SystemTime with reads(Clock) {
        SystemTime { ns: Clock.wall_ns() }
    }

    /// The span since the Unix epoch.
    pub fn since_epoch(self) -> Duration {
        Duration { ns: self.ns }
    }
}

/// Parks the calling task for `d`.
pub fn sleep(d: Duration) with reads(Clock) blocks suspends {
    sleep_ms(d.as_ms());
}
