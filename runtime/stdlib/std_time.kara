// `std.time`: `Duration`, `Instant`, `SystemTime` and `sleep`
// (docs/library/time-random-env.md; B-2026-10-15-10). `Clock` and
// `sleep_ms` are globals of the library.

/// A span of time, held in nanoseconds.
#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Debug)]
pub struct Duration {
    ns: i64,
}

impl Duration {
    /// `ms` milliseconds.
    pub fn ms(ms: i64) -> Duration {
        Duration { ns: ms * 1000000 }
    }

    /// `secs` seconds.
    pub fn secs(secs: i64) -> Duration {
        Duration { ns: secs * 1000000000 }
    }

    /// The whole milliseconds in this span.
    pub fn as_ms(self) -> i64 {
        self.ns / 1000000
    }

    // When a `select`'s `after(self)` arm entered now fires, on the
    // monotonic clock (core-semantics §11.11; `select_desugar.rs`).
    pub fn __select_at(self) -> i64 with reads(Clock) {
        Clock.monotonic_ns() + self.ns
    }
}

/// Wall-clock time, which can jump when the system clock is set. Use an
/// `Instant` to measure how long something takes.
#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Debug)]
pub struct SystemTime {
    ns: i64,
}

impl SystemTime {
    /// The current wall-clock time.
    pub fn now() -> SystemTime with reads(Clock) {
        SystemTime { ns: Clock.wall_ns() }
    }

    /// The span since the Unix epoch.
    pub fn since_epoch(self) -> Duration {
        Duration { ns: self.ns }
    }
}

/// A point on the monotonic clock, for measuring elapsed time:
/// `later - earlier` is a `Duration`, and `i + d` an `Instant`.
///
/// Read one with `Instant.now()`. `Clock.now()` is wall-clock epoch
/// seconds, not an `Instant` (docs/library/time-random-env.md).
#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Debug)]
pub struct Instant {
    ns: i64,
}

impl Instant {
    /// The current reading of the monotonic clock.
    pub fn now() -> Instant with reads(Clock) {
        Instant { ns: Clock.monotonic_ns() }
    }

    /// The span from `earlier` to this instant (`self - earlier`).
    pub fn duration_since(self, earlier: Instant) -> Duration {
        Duration { ns: self.ns - earlier.ns }
    }

    /// The instant `d` after this one (`self + d`).
    pub fn add(self, d: Duration) -> Instant {
        Instant { ns: self.ns + d.ns }
    }

    /// The span from this instant to now.
    pub fn elapsed(self) -> Duration with reads(Clock) {
        Duration { ns: Clock.monotonic_ns() - self.ns }
    }
}

impl Sub for Instant {
    type Output = Duration;

    /// The span from `rhs` to this instant.
    fn sub(own self, rhs: own Instant) -> Duration {
        Duration { ns: self.ns - rhs.ns }
    }
}

impl Add[Duration] for Instant {
    type Output = Instant;

    /// The instant `rhs` after this one.
    fn add(own self, rhs: own Duration) -> Instant {
        Instant { ns: self.ns + rhs.ns }
    }
}

/// What `timeout` gives when its deadline passes first.
pub struct TimedOut {}

/// Runs `f` as a task scope bounded by `d` (core-semantics §11.10): its
/// value, or `Err(TimedOut)` once `d` has passed, when the scope is
/// cancelled and `f` stops at the wait it is in.
pub fn timeout[T](d: Duration, f: own OnceFn() -> T) -> Result[T, TimedOut] with reads(Clock) blocks suspends {
    let group = TaskGroup.new().__deadline_at(d.__select_at());
    match group.spawn(f).try_join() {
        Ok(v) => Ok(v),
        Err(_) => Err(TimedOut {}),
    }
}

/// Parks the calling task for `d`.
pub fn sleep(d: Duration) with reads(Clock) blocks suspends {
    sleep_ms(d.as_ms());
}
