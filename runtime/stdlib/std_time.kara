// `std.time`: `Duration`, `Instant`, `SystemTime` and `sleep`
// (docs/library/time-random-env.md; B-2026-10-15-10). `Clock` and
// `sleep_ms` are globals of the library.

/// A span of time, held in nanoseconds.
#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Debug)]
pub struct Duration {
    ns: i64,
}

impl Duration {
    /// `ms` milliseconds.
    pub fn ms(ms: i64) -> Duration {
        Duration { ns: ms * 1000000 }
    }

    /// `secs` seconds.
    pub fn secs(secs: i64) -> Duration {
        Duration { ns: secs * 1000000000 }
    }

    /// `us` microseconds (B-2026-11-11-33).
    pub fn us(us: i64) -> Duration {
        Duration { ns: us * 1000 }
    }

    /// `ns` nanoseconds.
    pub fn ns(ns: i64) -> Duration {
        Duration { ns: ns }
    }

    /// The whole seconds in this span.
    pub fn as_secs(self) -> i64 {
        self.ns / 1000000000
    }

    /// The whole milliseconds in this span.
    pub fn as_ms(self) -> i64 {
        self.ns / 1000000
    }

    /// The whole microseconds in this span.
    pub fn as_us(self) -> i64 {
        self.ns / 1000
    }

    /// The nanoseconds in this span.
    pub fn as_ns(self) -> i64 {
        self.ns
    }

    // When a `select`'s `after(self)` arm entered now fires, on the
    // monotonic clock (core-semantics §11.11; `select_desugar.rs`).
    pub fn __select_at(self) -> i64 with reads(Clock) {
        Clock.monotonic_ns() + self.ns
    }
}

impl Add for Duration {
    type Output = Duration;

    /// The two spans end to end (B-2026-11-11-72).
    fn add(own self, rhs: own Duration) -> Duration {
        Duration { ns: self.ns + rhs.ns }
    }
}

impl Sub for Duration {
    type Output = Duration;

    /// This span less `rhs`, negative when `rhs` is longer.
    fn sub(own self, rhs: own Duration) -> Duration {
        Duration { ns: self.ns - rhs.ns }
    }
}

impl Mul[i64] for Duration {
    type Output = Duration;

    /// This span `rhs` times over.
    fn mul(own self, rhs: own i64) -> Duration {
        Duration { ns: self.ns * rhs }
    }
}

impl Div[i64] for Duration {
    type Output = Duration;

    /// This span cut into `rhs` equal parts, rounded toward zero.
    fn div(own self, rhs: own i64) -> Duration {
        Duration { ns: self.ns / rhs }
    }
}

impl Display for Duration {
    /// Go's `time.Duration` text (review ruling on B-2026-11-17-67): under
    /// a second, the largest of `ns`, `µs` and `ms` that keeps a whole part
    /// (`250ms`, `1.5µs`, `999ns`); from a second up, hours, minutes and
    /// seconds with the leading zero units left out (`1.5s`, `1m30s`,
    /// `2h0m0s`). The fraction keeps no trailing zeros, a negative span
    /// leads with `-`, and zero is `0s`.
    fn to_string(ref self) -> String {
        // The magnitude as a `u64`, which holds `i64.MIN`'s too.
        let u: u64 = if self.ns < 0 {
            ((0 - (self.ns + 1)) as u64) + 1
        } else {
            self.ns as u64
        };
        let mut out = String.new();
        if u == 0 {
            return "0s";
        }
        if u < 1000000000 {
            let mut scale: u64 = 1000000;
            let mut unit = "ms";
            if u < 1000 {
                scale = 1;
                unit = "ns";
            } else if u < 1000000 {
                scale = 1000;
                unit = "µs";
            }
            out.push_str(f"{u / scale}");
            out.push_str(duration_fraction(u % scale, scale));
            out.push_str(unit);
        } else {
            let secs = u / 1000000000;
            let h = secs / 3600;
            let m = secs / 60 % 60;
            if h > 0 {
                out.push_str(f"{h}h");
            }
            if h > 0 or m > 0 {
                out.push_str(f"{m}m");
            }
            out.push_str(f"{secs % 60}");
            out.push_str(duration_fraction(u % 1000000000, 1000000000));
            out.push_str("s");
        }
        if self.ns < 0 {
            return f"-{out}";
        }
        out
    }
}

// `rem / scale` as a decimal fraction, `scale` a power of ten: `""` for none,
// otherwise `.` and its digits without trailing zeros (`.5`, `.0625`).
fn duration_fraction(rem: u64, scale: u64) -> String {
    if rem == 0 {
        return "";
    }
    let mut digits = String.new();
    let mut place = scale / 10;
    let mut r = rem;
    while place > 0 and r > 0 {
        digits.push_str(f"{r / place}");
        r = r % place;
        place = place / 10;
    }
    f".{digits}"
}

/// Wall-clock time, which can jump when the system clock is set. Use an
/// `Instant` to measure how long something takes.
#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Debug)]
pub struct SystemTime {
    ns: i64,
}

impl SystemTime {
    /// The current wall-clock time.
    pub fn now() -> SystemTime with reads(Clock) {
        SystemTime { ns: Clock.wall_ns() }
    }

    /// The span since the Unix epoch.
    pub fn since_epoch(self) -> Duration {
        Duration { ns: self.ns }
    }
}

/// A point on the monotonic clock, for measuring elapsed time:
/// `later - earlier` is a `Duration`, and `i + d` an `Instant`.
///
/// Read one with `Instant.now()`. `Clock.now()` is wall-clock epoch
/// seconds, not an `Instant` (docs/library/time-random-env.md).
#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Debug)]
pub struct Instant {
    ns: i64,
}

impl Instant {
    /// The current reading of the monotonic clock.
    pub fn now() -> Instant with reads(Clock) {
        Instant { ns: Clock.monotonic_ns() }
    }

    /// The span from `earlier` to this instant (`self - earlier`).
    pub fn duration_since(self, earlier: Instant) -> Duration {
        Duration { ns: self.ns - earlier.ns }
    }

    /// The instant `d` after this one (`self + d`).
    pub fn add(self, d: Duration) -> Instant {
        Instant { ns: self.ns + d.ns }
    }

    /// The span from this instant to now.
    pub fn elapsed(self) -> Duration with reads(Clock) {
        Duration { ns: Clock.monotonic_ns() - self.ns }
    }
}

impl Sub for Instant {
    type Output = Duration;

    /// The span from `rhs` to this instant.
    fn sub(own self, rhs: own Instant) -> Duration {
        Duration { ns: self.ns - rhs.ns }
    }
}

impl Add[Duration] for Instant {
    type Output = Instant;

    /// The instant `rhs` after this one.
    fn add(own self, rhs: own Duration) -> Instant {
        Instant { ns: self.ns + rhs.ns }
    }
}

/// What `timeout` gives when its deadline passes first.
pub struct TimedOut {}

/// Runs `f` as a task scope bounded by `d` (core-semantics §11.10): its
/// value, or `Err(TimedOut)` once `d` has passed, when the scope is
/// cancelled and `f` stops at the wait it is in. `f`'s value crosses back
/// from the task, so `T: CrossTask` (design.md § `CrossTask`).
pub fn timeout[T: CrossTask](d: Duration, f: own OnceFn() -> T + CrossTask) -> Result[T, TimedOut] with reads(Clock) blocks suspends {
    let group = TaskGroup.new().__deadline_at(d.__select_at());
    match group.spawn(f).try_join() {
        Ok(v) => Ok(v),
        Err(_) => Err(TimedOut {}),
    }
}

/// Parks the calling task for `d`, to the nanosecond (B-2026-11-11-33).
pub fn sleep(d: Duration) with reads(Clock) blocks suspends {
    __sleep_ns(d.ns);
}
