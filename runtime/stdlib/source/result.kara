// `Result[T, E]`'s methods, as Kāra (redesign A2; docs/library/core-types.md).
//
// Appended to the program by the MIR pipeline only; see `option.kara` in
// this directory for why the legacy backends do not read it.

impl[T, E] Result[T, E] {
    fn is_ok(ref self) -> bool {
        match self {
            Ok(_) => true,
            Err(_) => false,
        }
    }

    fn is_err(ref self) -> bool {
        match self {
            Ok(_) => false,
            Err(_) => true,
        }
    }

    fn ok(own self) -> Option[T] {
        match self {
            Ok(x) => Some(x),
            Err(_) => None,
        }
    }

    fn err(own self) -> Option[E] {
        match self {
            Ok(_) => None,
            Err(e) => Some(e),
        }
    }

    fn map[U](own self, f: own OnceFn(own T) -> U) -> Result[U, E] {
        match self {
            Ok(x) => Ok(f(x)),
            Err(e) => Err(e),
        }
    }

    fn map_err[F](own self, f: own OnceFn(own E) -> F) -> Result[T, F] {
        match self {
            Ok(x) => Ok(x),
            Err(e) => Err(f(e)),
        }
    }

    fn and_then[U](own self, f: own OnceFn(own T) -> Result[U, E]) -> Result[U, E] {
        match self {
            Ok(x) => f(x),
            Err(e) => Err(e),
        }
    }

    fn or_else[F](own self, f: own OnceFn(own E) -> Result[T, F]) -> Result[T, F] {
        match self {
            Ok(x) => Ok(x),
            Err(e) => f(e),
        }
    }

    fn unwrap(own self) -> T {
        match self {
            Ok(x) => x,
            Err(_) => panic("called unwrap() on Err"),
        }
    }

    fn expect(own self, msg: own String) -> T {
        match self {
            Ok(x) => x,
            Err(_) => panic(msg),
        }
    }

    fn unwrap_err(own self) -> E {
        match self {
            Ok(_) => panic("called unwrap_err() on Ok"),
            Err(e) => e,
        }
    }

    fn unwrap_or(own self, default: own T) -> T {
        match self {
            Ok(x) => x,
            Err(_) => default,
        }
    }

    fn unwrap_or_else(own self, f: own OnceFn(own E) -> T) -> T {
        match self {
            Ok(x) => x,
            Err(e) => f(e),
        }
    }
}
