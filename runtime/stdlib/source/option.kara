// `Option[T]`'s methods, as Kāra (redesign A2; docs/library/core-types.md).
//
// The MIR pipeline appends this file to the program, so these bodies are
// what `opt.map(f)` runs there. The legacy backends do not read it: they
// keep their hard-coded arms until the legacy pipeline is deleted (M3), and
// then the type in `../option.kara` and these methods become one file.
//
// Written in today's parameter spelling (bare `self` is owned, `ref self`
// borrows); the D5 migration rewrites it with everything else.

impl[T] Option[T] {
    fn is_some(ref self) -> bool {
        match self {
            Some(_) => true,
            None => false,
        }
    }

    fn is_none(ref self) -> bool {
        match self {
            Some(_) => false,
            None => true,
        }
    }

    fn is_some_and(ref self, pred: OnceFn(ref T) -> bool) -> bool {
        match self {
            Some(x) => pred(x),
            None => false,
        }
    }

    fn unwrap(self) -> T {
        match self {
            Some(x) => x,
            None => panic("called unwrap() on None"),
        }
    }

    fn expect(self, msg: String) -> T {
        match self {
            Some(x) => x,
            None => panic(msg),
        }
    }

    fn unwrap_or(self, default: T) -> T {
        match self {
            Some(x) => x,
            None => default,
        }
    }

    fn unwrap_or_else(self, f: OnceFn() -> T) -> T {
        match self {
            Some(x) => x,
            None => f(),
        }
    }

    fn map[U](self, f: OnceFn(T) -> U) -> Option[U] {
        match self {
            Some(x) => Some(f(x)),
            None => None,
        }
    }

    fn map_or[U](self, default: U, f: OnceFn(T) -> U) -> U {
        match self {
            Some(x) => f(x),
            None => default,
        }
    }

    fn and_then[U](self, f: OnceFn(T) -> Option[U]) -> Option[U] {
        match self {
            Some(x) => f(x),
            None => None,
        }
    }

    fn r#or(self, other: Option[T]) -> Option[T] {
        match self {
            Some(x) => Some(x),
            None => other,
        }
    }

    fn or_else(self, f: OnceFn() -> Option[T]) -> Option[T] {
        match self {
            Some(x) => Some(x),
            None => f(),
        }
    }

    fn filter(self, pred: OnceFn(ref T) -> bool) -> Option[T] {
        match self {
            Some(x) => if pred(x) { Some(x) } else { None },
            None => None,
        }
    }

    fn ok_or[E](self, err: E) -> Result[T, E] {
        match self {
            Some(x) => Ok(x),
            None => Err(err),
        }
    }

    fn ok_or_else[E](self, f: OnceFn() -> E) -> Result[T, E] {
        match self {
            Some(x) => Ok(x),
            None => Err(f()),
        }
    }

    fn zip[U](self, other: Option[U]) -> Option[(T, U)] {
        match self {
            Some(x) => match other {
                Some(y) => Some((x, y)),
                None => None,
            },
            None => None,
        }
    }
}
