// `Option[T]`'s methods, as Kāra (redesign A2; docs/library/core-types.md).
//
// The MIR pipeline appends this file to the program, so these bodies are
// what `opt.map(f)` runs there. The legacy backends do not read it: they
// keep their hard-coded arms until the legacy pipeline is deleted (M3), and
// then the type in `../option.kara` and these methods become one file.
//
// Written in the D5 spelling (`docs/library/core-types.md`): `own` marks
// what a method takes ownership of, which today means the same as a bare
// parameter. `ref self` stays until the flip makes it a redundant spelling.

impl[T] Option[T] {
    fn is_some(ref self) -> bool {
        match self {
            Some(_) => true,
            None => false,
        }
    }

    fn is_none(ref self) -> bool {
        match self {
            Some(_) => false,
            None => true,
        }
    }

    fn is_some_and(ref self, pred: own OnceFn(ref T) -> bool) -> bool {
        match self {
            Some(x) => pred(x),
            None => false,
        }
    }

    fn unwrap(own self) -> T {
        match self {
            Some(x) => x,
            None => panic("called unwrap() on None"),
        }
    }

    fn expect(own self, msg: own String) -> T {
        match self {
            Some(x) => x,
            None => panic(msg),
        }
    }

    fn unwrap_or(own self, default: own T) -> T {
        match self {
            Some(x) => x,
            None => default,
        }
    }

    fn unwrap_or_else(own self, f: own OnceFn() -> T) -> T {
        match self {
            Some(x) => x,
            None => f(),
        }
    }

    fn map[U](own self, f: own OnceFn(own T) -> U) -> Option[U] {
        match self {
            Some(x) => Some(f(x)),
            None => None,
        }
    }

    fn map_or[U](own self, default: own U, f: own OnceFn(own T) -> U) -> U {
        match self {
            Some(x) => f(x),
            None => default,
        }
    }

    fn and_then[U](own self, f: own OnceFn(own T) -> Option[U]) -> Option[U] {
        match self {
            Some(x) => f(x),
            None => None,
        }
    }

    fn or(own self, other: own Option[T]) -> Option[T] {
        match self {
            Some(x) => Some(x),
            None => other,
        }
    }

    fn or_else(own self, f: own OnceFn() -> Option[T]) -> Option[T] {
        match self {
            Some(x) => Some(x),
            None => f(),
        }
    }

    fn filter(own self, pred: own OnceFn(ref T) -> bool) -> Option[T] {
        match self {
            Some(x) => if pred(x) { Some(x) } else { None },
            None => None,
        }
    }

    fn ok_or[E](own self, err: own E) -> Result[T, E] {
        match self {
            Some(x) => Ok(x),
            None => Err(err),
        }
    }

    fn ok_or_else[E](own self, f: own OnceFn() -> E) -> Result[T, E] {
        match self {
            Some(x) => Ok(x),
            None => Err(f()),
        }
    }

    fn zip[U](own self, other: own Option[U]) -> Option[(T, U)] {
        match self {
            Some(x) => match other {
                Some(y) => Some((x, y)),
                None => None,
            },
            None => None,
        }
    }
}

impl[T: Clone] Option[ref T] {
    /// The value this borrows, cloned: `m.get(k).cloned() ?? d`.
    fn cloned(own self) -> Option[T] {
        match self {
            Some(x) => Some(x.clone()),
            None => None,
        }
    }
}
