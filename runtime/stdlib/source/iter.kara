// `Iterator` and the adaptors that need no function argument, as Kāra
// (redesign A2; docs/library/iterators.md).
//
// The MIR pipeline appends this file to the program. Its `trait Iterator`
// shadows the baked declaration in `../iterator.kara`, so every type that
// implements `next` gets these provided methods, the library's adaptors as
// much as a program's own iterators. The legacy backends do not read it.
//
// Each adaptor is a struct holding the iterator it wraps. The adaptors that
// store a function (`map`, `filter`, ...) take it as a type parameter with a
// function-trait bound (`F: MutFn(own Self.Item) -> U`), so the adaptor is a
// view and the function's captures follow core semantics §9.1. An adaptor
// whose items are the function's results carries their type `U` as a struct
// parameter too, so the `impl` can name it.

trait Iterator {
    type Item;

    fn next(mut ref self) -> Option[Self.Item];

    /// The number of items.
    fn count(own self) -> i64 {
        let mut it = self;
        let mut n = 0;
        while let Some(_) = it.next() {
            n = n + 1;
        }
        n
    }

    /// The last item, or `None` if there are none.
    fn last(own self) -> Option[Self.Item] {
        let mut it = self;
        let mut last: Option[Self.Item] = None;
        while let Some(x) = it.next() {
            last = Some(x);
        }
        last
    }

    /// The item at index `n`, counting from 0.
    fn nth(own self, n: i64) -> Option[Self.Item] {
        let mut it = self;
        let mut i = 0;
        while let Some(x) = it.next() {
            if i == n {
                return Some(x);
            }
            i = i + 1;
        }
        None
    }

    /// At most `n` items.
    fn take(own self, n: i64) -> IterTake[Self] {
        IterTake { it: self, left: n }
    }

    /// Drops the first `n` items.
    fn skip(own self, n: i64) -> IterSkip[Self] {
        IterSkip { it: self, left: n }
    }

    /// Pairs each item with its index, from 0.
    fn enumerate(own self) -> IterEnumerate[Self] {
        IterEnumerate { it: self, i: 0 }
    }

    /// The first item, then every `step`-th.
    fn step_by(own self, step: i64) -> IterStepBy[Self] {
        IterStepBy { it: self, step: step, first: true }
    }

    // A default method's own generics are named apart from every library
    // iterator impl's (`T`, `K`, `V`, `I`, `A`, `B`, `F`, `U`): a call's
    // generic arguments are matched by name, so a method `K` copied into
    // `impl[K, V] .. SortedMapIter[K, V]` was read as the map's key
    // (B-2026-10-21-4).
    /// This iterator's items, then `other`'s.
    fn chain[J: Iterator[Item = Self.Item]](own self, other: own J) -> IterChain[Self, J] {
        IterChain { a: self, b: other, a_done: false }
    }

    /// Pairs of items, one from each, until either runs out.
    fn zip[J: Iterator](own self, other: own J) -> IterZip[Self, J] {
        IterZip { a: self, b: other }
    }

    /// `f` applied to each item.
    fn map[OutV, FnV: MutFn(own Self.Item) -> OutV](own self, f: own FnV) -> IterMap[Self, FnV, OutV] {
        IterMap { it: self, f: f }
    }

    /// The items `pred` holds for.
    fn filter[FnV: MutFn(Self.Item) -> bool](own self, pred: own FnV) -> IterFilter[Self, FnV] {
        IterFilter { it: self, pred: pred }
    }

    /// The `Some` results of `f` applied to each item.
    fn filter_map[OutV, FnV: MutFn(own Self.Item) -> Option[OutV]](own self, f: own FnV) -> IterFilterMap[Self, FnV, OutV] {
        IterFilterMap { it: self, f: f }
    }

    /// The items up to the first one `pred` does not hold for.
    fn take_while[FnV: MutFn(Self.Item) -> bool](own self, pred: own FnV) -> IterTakeWhile[Self, FnV] {
        IterTakeWhile { it: self, pred: pred, done: false }
    }

    /// The items from the first one `pred` does not hold for.
    fn skip_while[FnV: MutFn(Self.Item) -> bool](own self, pred: own FnV) -> IterSkipWhile[Self, FnV] {
        IterSkipWhile { it: self, pred: pred, skipping: true }
    }

    /// The items, calling `f` on each as it passes.
    fn inspect[FnV: MutFn(Self.Item)](own self, f: own FnV) -> IterInspect[Self, FnV] {
        IterInspect { it: self, f: f }
    }

    /// The items of each iterator `f` returns, in turn.
    fn flat_map[OutV: Iterator, FnV: MutFn(own Self.Item) -> OutV](own self, f: own FnV) -> IterFlatMap[Self, FnV, OutV] {
        IterFlatMap { it: self, f, cur: None }
    }

    /// The items of each item, in turn.
    fn flatten(own self) -> IterFlatten[Self, Self.Item] {
        IterFlatten { it: self, cur: None }
    }

    /// Threads a state through the items: `f` returns the next state and
    /// the item to yield, and the first `None` ends the iteration.
    fn scan[StateV, OutV, FnV: MutFn(own StateV, own Self.Item) -> Option[(StateV, OutV)]](own self, init: own StateV, f: own FnV) -> IterScan[Self, StateV, FnV, OutV] {
        IterScan { it: self, state: Some(init), f }
    }

    /// An iterator that can look at its next item without taking it.
    fn peekable(own self) -> Peekable[Self, Self.Item] {
        Peekable { it: self, peeked: None }
    }

    /// Borrows the iterator instead of consuming it.
    fn by_ref(mut ref self) -> IterByRef[Self] {
        IterByRef { it: self }
    }

    /// Folds every item into an accumulator, front to back.
    fn fold[AccV](own self, init: own AccV, f: own MutFn(own AccV, own Self.Item) -> AccV) -> AccV {
        let mut it = self;
        let mut acc = init;
        while let Some(x) = it.next() {
            acc = f(acc, x);
        }
        acc
    }

    /// Calls `f` on every item.
    fn for_each(own self, f: own MutFn(own Self.Item)) {
        let mut it = self;
        while let Some(x) = it.next() {
            f(x);
        }
    }

    /// Whether `pred` holds for some item; stops at the first that does.
    fn any(mut ref self, pred: own MutFn(own Self.Item) -> bool) -> bool {
        while let Some(x) = self.next() {
            if pred(x) {
                return true;
            }
        }
        false
    }

    /// Whether `pred` holds for every item; stops at the first that does not.
    fn all(mut ref self, pred: own MutFn(own Self.Item) -> bool) -> bool {
        while let Some(x) = self.next() {
            if not pred(x) {
                return false;
            }
        }
        true
    }

    /// The first item `pred` holds for.
    fn find(mut ref self, pred: own MutFn(Self.Item) -> bool) -> Option[Self.Item] {
        while let Some(x) = self.next() {
            if pred(x) {
                return Some(x);
            }
        }
        None
    }

    /// The items, gathered into a collection of the type the context names.
    /// A `ref` to a `Copy` item is read as the item (`ItemV`).
    fn collect[ItemV, C: FromIterator[ItemV]](own self) -> C {
        let values: ItemValues[Self, ItemV] = ItemValues { it: self };
        C.from_iter(values)
    }

    /// An owned copy of each viewed item (`ItemV` is the type a `ref ItemV` item
    /// views).
    fn cloned[ItemV](own self) -> IterCloned[Self, ItemV] {
        IterCloned { it: self }
    }

    /// The items added up; 0 if there are none. A `ref` to a `Copy` item is
    /// read as the item (`ItemV`).
    fn sum[ItemV: Default + Add[Output = ItemV]](own self) -> ItemV {
        let mut it = self;
        let mut acc: ItemV = ItemV.default();
        while let Some(x) = it.next() {
            let v: ItemV = iter_read_value(x);
            acc = acc + v;
        }
        acc
    }

    /// The items multiplied together; 1 if there are none. A `ref` to a
    /// `Copy` item is read as the item (`ItemV`).
    fn product[ItemV: MulIdentity + Mul[Output = ItemV]](own self) -> ItemV {
        let mut it = self;
        let mut acc: ItemV = ItemV.mul_identity();
        while let Some(x) = it.next() {
            let v: ItemV = iter_read_value(x);
            acc = acc * v;
        }
        acc
    }

    /// The smallest item, the first of several equal ones; `None` if there
    /// are none.
    fn min(own self) -> Option[Self.Item] where Self.Item: Ord {
        let mut it = self;
        let mut best: Option[Self.Item] = None;
        while let Some(x) = it.next() {
            best = match best {
                None => Some(x),
                Some(b) => if x < b { Some(x) } else { Some(b) },
            };
        }
        best
    }

    /// The largest item, the last of several equal ones; `None` if there are
    /// none.
    fn max(own self) -> Option[Self.Item] where Self.Item: Ord {
        let mut it = self;
        let mut best: Option[Self.Item] = None;
        while let Some(x) = it.next() {
            best = match best {
                None => Some(x),
                Some(b) => if x >= b { Some(x) } else { Some(b) },
            };
        }
        best
    }

    /// The smallest item by `cmp`, the first of several equal ones.
    fn min_by(own self, cmp: own MutFn(Self.Item, Self.Item) -> Ordering) -> Option[Self.Item] {
        let mut it = self;
        let mut best: Option[Self.Item] = None;
        while let Some(x) = it.next() {
            best = match best {
                None => Some(x),
                Some(b) => if cmp(x, b).is_lt() { Some(x) } else { Some(b) },
            };
        }
        best
    }

    /// The largest item by `cmp`, the last of several equal ones.
    fn max_by(own self, cmp: own MutFn(Self.Item, Self.Item) -> Ordering) -> Option[Self.Item] {
        let mut it = self;
        let mut best: Option[Self.Item] = None;
        while let Some(x) = it.next() {
            best = match best {
                None => Some(x),
                Some(b) => if cmp(x, b).is_ge() { Some(x) } else { Some(b) },
            };
        }
        best
    }

    /// The item whose `key` is smallest, the first of several equal ones.
    fn min_by_key[KeyV: Ord](own self, key: own MutFn(Self.Item) -> KeyV) -> Option[Self.Item] {
        let mut it = self;
        let mut best: Option[(KeyV, Self.Item)] = None;
        while let Some(x) = it.next() {
            let k = key(x);
            best = match best {
                None => Some((k, x)),
                Some((bk, b)) => if k < bk { Some((k, x)) } else { Some((bk, b)) },
            };
        }
        match best {
            Some((_, b)) => Some(b),
            None => None,
        }
    }

    /// The item whose `key` is largest, the last of several equal ones.
    fn max_by_key[KeyV: Ord](own self, key: own MutFn(Self.Item) -> KeyV) -> Option[Self.Item] {
        let mut it = self;
        let mut best: Option[(KeyV, Self.Item)] = None;
        while let Some(x) = it.next() {
            let k = key(x);
            best = match best {
                None => Some((k, x)),
                Some((bk, b)) => if k >= bk { Some((k, x)) } else { Some((bk, b)) },
            };
        }
        match best {
            Some((_, b)) => Some(b),
            None => None,
        }
    }

    /// The first `Some` that `f` returns.
    fn find_map[OutV](own self, f: own MutFn(own Self.Item) -> Option[OutV]) -> Option[OutV] {
        let mut it = self;
        while let Some(x) = it.next() {
            match f(x) {
                Some(u) => return Some(u),
                None => {}
            }
        }
        None
    }

    /// The items `pred` holds for, then the items it does not.
    fn partition(own self, pred: own MutFn(Self.Item) -> bool) -> (Vec[Self.Item], Vec[Self.Item]) {
        let mut it = self;
        let mut yes: Vec[Self.Item] = Vec.new();
        let mut no: Vec[Self.Item] = Vec.new();
        while let Some(x) = it.next() {
            if pred(x) {
                yes.push(x);
            } else {
                no.push(x);
            }
        }
        (yes, no)
    }

    /// The items combined front to back by `f`; `None` if there are none.
    fn reduce[ItemV](own self, f: own MutFn(own ItemV, own ItemV) -> ItemV) -> Option[ItemV] {
        let mut it = self;
        let mut acc: Option[ItemV] = None;
        while let Some(x) = it.next() {
            let v: ItemV = iter_read_value(x);
            acc = match acc {
                None => Some(v),
                Some(a) => Some(f(a, v)),
            };
        }
        acc
    }

    /// The index of the first item `pred` holds for.
    fn position(mut ref self, pred: own MutFn(Self.Item) -> bool) -> Option[i64] {
        let mut i = 0;
        while let Some(x) = self.next() {
            if pred(x) {
                return Some(i);
            }
            i = i + 1;
        }
        None
    }
}

struct IterTake[I] {
    it: I,
    left: i64,
}

impl[I: Iterator] Iterator for IterTake[I] {
    type Item = I.Item;

    fn next(mut ref self) -> Option[I.Item] {
        if self.left <= 0 {
            return None;
        }
        self.left = self.left - 1;
        self.it.next()
    }
}

struct IterSkip[I] {
    it: I,
    left: i64,
}

impl[I: Iterator] Iterator for IterSkip[I] {
    type Item = I.Item;

    fn next(mut ref self) -> Option[I.Item] {
        while self.left > 0 {
            self.left = self.left - 1;
            if self.it.next().is_none() {
                return None;
            }
        }
        self.it.next()
    }
}

struct IterEnumerate[I] {
    it: I,
    i: i64,
}

impl[I: Iterator] Iterator for IterEnumerate[I] {
    type Item = (i64, I.Item);

    fn next(mut ref self) -> Option[(i64, I.Item)] {
        match self.it.next() {
            Some(x) => {
                let k = self.i;
                self.i = self.i + 1;
                Some((k, x))
            }
            None => None,
        }
    }
}

struct IterStepBy[I] {
    it: I,
    step: i64,
    first: bool,
}

impl[I: Iterator] Iterator for IterStepBy[I] {
    type Item = I.Item;

    fn next(mut ref self) -> Option[I.Item] {
        if self.first {
            self.first = false;
            return self.it.next();
        }
        let mut k = 1;
        while k < self.step {
            if self.it.next().is_none() {
                return None;
            }
            k = k + 1;
        }
        self.it.next()
    }
}

struct IterChain[A, B] {
    a: A,
    b: B,
    a_done: bool,
}

impl[A: Iterator, B: Iterator[Item = A.Item]] Iterator for IterChain[A, B] {
    type Item = A.Item;

    fn next(mut ref self) -> Option[A.Item] {
        if not self.a_done {
            match self.a.next() {
                Some(x) => return Some(x),
                None => self.a_done = true,
            }
        }
        self.b.next()
    }
}

struct IterZip[A, B] {
    a: A,
    b: B,
}

impl[A: Iterator, B: Iterator] Iterator for IterZip[A, B] {
    type Item = (A.Item, B.Item);

    fn next(mut ref self) -> Option[(A.Item, B.Item)] {
        match self.a.next() {
            Some(x) => match self.b.next() {
                Some(y) => Some((x, y)),
                None => None,
            },
            None => None,
        }
    }
}

struct IterMap[I, F, U] {
    it: I,
    f: F,
}

impl[I: Iterator, F: MutFn(own I.Item) -> U, U] Iterator for IterMap[I, F, U] {
    type Item = U;

    fn next(mut ref self) -> Option[U] {
        match self.it.next() {
            Some(x) => Some((self.f)(x)),
            None => None,
        }
    }
}

struct IterFilter[I, F] {
    it: I,
    pred: F,
}

impl[I: Iterator, F: MutFn(I.Item) -> bool] Iterator for IterFilter[I, F] {
    type Item = I.Item;

    fn next(mut ref self) -> Option[I.Item] {
        while let Some(x) = self.it.next() {
            if (self.pred)(x) {
                return Some(x);
            }
        }
        None
    }
}

struct IterFilterMap[I, F, U] {
    it: I,
    f: F,
}

impl[I: Iterator, F: MutFn(own I.Item) -> Option[U], U] Iterator for IterFilterMap[I, F, U] {
    type Item = U;

    fn next(mut ref self) -> Option[U] {
        while let Some(x) = self.it.next() {
            match (self.f)(x) {
                Some(y) => return Some(y),
                None => {}
            }
        }
        None
    }
}

struct IterTakeWhile[I, F] {
    it: I,
    pred: F,
    done: bool,
}

impl[I: Iterator, F: MutFn(I.Item) -> bool] Iterator for IterTakeWhile[I, F] {
    type Item = I.Item;

    fn next(mut ref self) -> Option[I.Item] {
        if self.done {
            return None;
        }
        match self.it.next() {
            Some(x) => {
                if (self.pred)(x) {
                    return Some(x);
                }
                self.done = true;
                None
            }
            None => None,
        }
    }
}

struct IterSkipWhile[I, F] {
    it: I,
    pred: F,
    skipping: bool,
}

impl[I: Iterator, F: MutFn(I.Item) -> bool] Iterator for IterSkipWhile[I, F] {
    type Item = I.Item;

    fn next(mut ref self) -> Option[I.Item] {
        while let Some(x) = self.it.next() {
            if self.skipping and (self.pred)(x) {
                continue;
            }
            self.skipping = false;
            return Some(x);
        }
        None
    }
}

struct IterInspect[I, F] {
    it: I,
    f: F,
}

impl[I: Iterator, F: MutFn(I.Item)] Iterator for IterInspect[I, F] {
    type Item = I.Item;

    fn next(mut ref self) -> Option[I.Item] {
        match self.it.next() {
            Some(x) => {
                (self.f)(x);
                Some(x)
            }
            None => None,
        }
    }
}

/// `x` read as a `B` (core semantics §5.10): a `ref` to a `Copy` value is
/// copied out, and any other value moves. The MIR builder lowers each call
/// in place, so the body never runs.
fn iter_read_value[A, B](x: own A) -> B {
    panic("iter_read_value is lowered at each call")
}

/// A clone of the value `x` views. The MIR builder lowers each call in
/// place, so the body never runs.
fn iter_clone_value[A, B](x: own A) -> B {
    panic("iter_clone_value is lowered at each call")
}

struct IterCloned[I, V] {
    it: I,
}

impl[I: Iterator, V] Iterator for IterCloned[I, V] {
    type Item = V;

    fn next(mut ref self) -> Option[V] {
        match self.it.next() {
            Some(x) => {
                let v: V = iter_clone_value(x);
                Some(v)
            }
            None => None,
        }
    }
}

/// The items of `it` read as values: a `ref` to a `Copy` item is read as
/// the item.
struct ItemValues[I, V] {
    it: I,
}

impl[I: Iterator, V] Iterator for ItemValues[I, V] {
    type Item = V;

    fn next(mut ref self) -> Option[V] {
        match self.it.next() {
            Some(x) => {
                let v: V = iter_read_value(x);
                Some(v)
            }
            None => None,
        }
    }
}

struct IterFlatMap[I, F, U] {
    it: I,
    f: F,
    cur: Option[U],
}

impl[I: Iterator, F: MutFn(own I.Item) -> U, U: Iterator] Iterator for IterFlatMap[I, F, U] {
    type Item = U.Item;

    fn next(mut ref self) -> Option[U.Item] {
        loop {
            match self.cur.take() {
                Some(inner) => {
                    let mut inner = inner;
                    match inner.next() {
                        Some(x) => {
                            self.cur = Some(inner);
                            return Some(x);
                        }
                        None => {}
                    }
                }
                None => {}
            }
            match self.it.next() {
                Some(x) => self.cur = Some((self.f)(x)),
                None => return None,
            }
        }
    }
}

struct IterFlatten[I, U] {
    it: I,
    cur: Option[U],
}

impl[I: Iterator[Item = U], U: Iterator] Iterator for IterFlatten[I, U] {
    type Item = U.Item;

    fn next(mut ref self) -> Option[U.Item] {
        loop {
            match self.cur.take() {
                Some(inner) => {
                    let mut inner = inner;
                    match inner.next() {
                        Some(x) => {
                            self.cur = Some(inner);
                            return Some(x);
                        }
                        None => {}
                    }
                }
                None => {}
            }
            match self.it.next() {
                Some(x) => self.cur = Some(x),
                None => return None,
            }
        }
    }
}

struct IterScan[I, A, F, U] {
    it: I,
    state: Option[A],
    f: F,
}

impl[I: Iterator, A, F: MutFn(own A, own I.Item) -> Option[(A, U)], U] Iterator for IterScan[I, A, F, U] {
    type Item = U;

    fn next(mut ref self) -> Option[U] {
        let Some(a) = self.state.take() else {
            return None;
        };
        let Some(x) = self.it.next() else {
            return None;
        };
        match (self.f)(a, x) {
            Some((next, u)) => {
                self.state = Some(next);
                Some(u)
            }
            None => None,
        }
    }
}

/// An iterator that can look at its next item without taking it.
struct Peekable[I, T] {
    it: I,
    peeked: Option[Option[T]],
}

impl[I: Iterator[Item = T], T] Iterator for Peekable[I, T] {
    type Item = I.Item;

    fn next(mut ref self) -> Option[I.Item] {
        match self.peeked.take() {
            Some(v) => v,
            None => self.it.next(),
        }
    }
}

impl[I: Iterator[Item = T], T] Peekable[I, T] {
    /// The next item, borrowed, without taking it.
    fn peek(mut ref self) -> Option[ref T] {
        if self.peeked.is_none() {
            self.peeked = Some(self.it.next());
        }
        match self.peeked.as_ref() {
            Some(o) => match o {
                Some(x) => Some(x),
                None => None,
            },
            None => None,
        }
    }
}

struct IterByRef[I] {
    it: mut ref I,
}

impl[I: Iterator] Iterator for IterByRef[I] {
    type Item = I.Item;

    fn next(mut ref self) -> Option[I.Item] {
        self.it.next()
    }
}

/// A collection that can be built from an iterator's items (`collect`).
trait FromIterator[T] {
    fn from_iter[I: Iterator[Item = T]](iter: own I) -> Self;
}

/// An iterator that can also yield from the back.
trait DoubleEndedIterator: Iterator {
    fn next_back(mut ref self) -> Option[Self.Item];

    /// The items, back to front.
    fn rev(own self) -> IterRev[Self] {
        IterRev { it: self }
    }
}

struct IterRev[I] {
    it: I,
}

impl[I: DoubleEndedIterator] Iterator for IterRev[I] {
    type Item = I.Item;

    fn next(mut ref self) -> Option[I.Item] {
        self.it.next_back()
    }
}

impl[I: DoubleEndedIterator] DoubleEndedIterator for IterRev[I] {
    fn next_back(mut ref self) -> Option[I.Item] {
        self.it.next()
    }
}

/// A number's multiplicative identity, which `product` starts from.
trait MulIdentity {
    fn mul_identity() -> Self;
}

impl MulIdentity for i8 {
    fn mul_identity() -> i8 {
        1
    }
}

impl MulIdentity for i16 {
    fn mul_identity() -> i16 {
        1
    }
}

impl MulIdentity for i32 {
    fn mul_identity() -> i32 {
        1
    }
}

impl MulIdentity for i64 {
    fn mul_identity() -> i64 {
        1
    }
}

impl MulIdentity for i128 {
    fn mul_identity() -> i128 {
        1
    }
}

impl MulIdentity for isize {
    fn mul_identity() -> isize {
        1
    }
}

impl MulIdentity for u8 {
    fn mul_identity() -> u8 {
        1
    }
}

impl MulIdentity for u16 {
    fn mul_identity() -> u16 {
        1
    }
}

impl MulIdentity for u32 {
    fn mul_identity() -> u32 {
        1
    }
}

impl MulIdentity for u64 {
    fn mul_identity() -> u64 {
        1
    }
}

impl MulIdentity for u128 {
    fn mul_identity() -> u128 {
        1
    }
}

impl MulIdentity for usize {
    fn mul_identity() -> usize {
        1
    }
}

impl MulIdentity for f32 {
    fn mul_identity() -> f32 {
        1.0
    }
}

impl MulIdentity for f64 {
    fn mul_identity() -> f64 {
        1.0
    }
}
