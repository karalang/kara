}

/// The values of a sorted map, in key order, each borrowed.
struct SortedMapValues[K, V] {
    m: ref SortedMap[K, V],
    front: i64,
    back: i64,
}

impl[K, V] Iterator for SortedMapValues[K, V] {
    type Item = ref V;

    fn next(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        let i = self.front;
        self.front = i + 1;
        let (_, v) = self.m.entry_at(i);
        Some(v)
    }
}

impl[K, V] DoubleEndedIterator for SortedMapValues[K, V] {
    fn next_back(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        self.back = self.back - 1;
        let (_, v) = self.m.entry_at(self.back);
        Some(v)
