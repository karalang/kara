// The iterators over the library's collections, as Kāra (redesign A2;
// docs/library/iterators.md).
//
// The MIR pipeline appends this file to the program. Each source is a struct
// that borrows its collection and holds a position, so an iterator over a
// borrowed collection is a view (core semantics §5.2) and its items are
// `ref T`. The legacy backends do not read it.

/// The elements of a `Vec`, front to back, each borrowed.
struct VecIter[T] {
    v: ref Vec[T],
    front: i64,
    back: i64,
}

impl[T] Iterator for VecIter[T] {
    type Item = ref T;

    fn next(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        let i = self.front;
        self.front = i + 1;
        self.v.get(i)
    }
}

/// The elements of a `Vec`, front to back, each borrowed to be changed in
/// place (B-2026-10-21-51). Each element is handed out once.
struct VecIterMut[T] {
    v: mut ref Vec[T],
    front: i64,
    back: i64,
}

impl[T] Iterator for VecIterMut[T] {
    type Item = mut ref T;

    fn next(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        let i = self.front;
        self.front = i + 1;
        Some(mut self.v[i])
    }
}

impl[T] DoubleEndedIterator for VecIterMut[T] {
    fn next_back(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        self.back = self.back - 1;
        Some(mut self.v[self.back])
    }
}

impl[T: Clone] Slice[T] {
    /// Overwrites every element with a clone of the matching element of
    /// `src`; the lengths must agree (docs/library/collections.md).
    fn clone_from_slice(mut ref self, src: Slice[T]) {
        if self.len() != src.len() {
            panic("clone_from_slice: destination and source slices have different lengths");
        }
        let mut i = 0;
        while i < self.len() {
            self[i] = src[i].clone();
            i = i + 1;
        }
    }
}

/// The elements of a slice, front to back, each borrowed.
struct SliceIter[T] {
    s: Slice[T],
    front: i64,
    back: i64,
}

impl[T] Iterator for SliceIter[T] {
    type Item = ref T;

    fn next(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        let i = self.front;
        self.front = i + 1;
        self.s.get(i)
    }
}

impl[T] DoubleEndedIterator for SliceIter[T] {
    fn next_back(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        self.back = self.back - 1;
        self.s.get(self.back)
    }
}

impl[T] Slice[T] {
    /// The elements, front to back, each borrowed.
    fn iter(self) -> SliceIter[T] {
        SliceIter { s: self, front: 0, back: self.len() }
    }
}

impl[T: Display] Slice[T] {
    /// The elements' `Display` forms, with `sep` between each adjacent pair
    /// (B-2026-10-14-4, B-2026-10-14-67).
    fn join(self, sep: Str) -> String {
        let mut out = String.new();
        let mut first = true;
        for x in self.iter() {
            if not first {
                out.push_str(sep);
            }
            first = false;
            out.push_str(f"{x}");
        }
        out
    }

    /// The elements' `Display` forms, with nothing between.
    fn concat(self) -> String {
        self.join("")
    }
}

/// The elements of a `Vec`, front to back, each moved out. `front` holds
/// the next ones reversed, so `pop` takes the first; `back` holds the last
/// ones in order, so `pop` takes the last. Each side refills from the other
/// when it runs out, so a walk from one end moves each element once.
struct VecIntoIter[T] {
    front: Vec[T],
    back: Vec[T],
}

impl[T] Iterator for VecIntoIter[T] {
    type Item = T;

    fn next(mut ref self) -> Option[T] {
        if self.front.is_empty() {
            while let Some(x) = self.back.pop() {
                self.front.push(x);
            }
        }
        self.front.pop()
    }
}

impl[T] DoubleEndedIterator for VecIntoIter[T] {
    fn next_back(mut ref self) -> Option[T] {
        if self.back.is_empty() {
            while let Some(x) = self.front.pop() {
                self.back.push(x);
            }
        }
        self.back.pop()
    }
}

impl[T] Drop for VecIntoIter[T] {
    /// The elements not taken drop front to back, as the vector's would.
    fn drop(mut ref self) {
        self.front.reverse();
    }
}

impl[T] Vec[T] {
    /// The elements, front to back, each borrowed.
    fn iter(ref self) -> VecIter[T] {
        VecIter { v: self, front: 0, back: self.len() }
    }

    /// The elements, front to back, each borrowed to be changed in place.
    fn iter_mut(mut ref self) -> VecIterMut[T] {
        let n = self.len();
        VecIterMut { v: self, front: 0, back: n }
    }

    fn is_empty(ref self) -> bool {
        self.len() == 0
    }

    /// The first element, borrowed, or `None` when the vector is empty.
    fn first(ref self) -> Option[ref T] {
        self.get(0)
    }

    /// The elements in reverse order, in place.
    fn reverse(mut ref self) {
        let mut i = 0;
        let mut j = self.len() - 1;
        while i < j {
            self.swap(i, j);
            i = i + 1;
            j = j - 1;
        }
    }

    /// Removes and returns the element at `idx`, moving the last element
    /// into its place. An index out of bounds aborts, as `v[idx]` does.
    fn swap_remove(mut ref self, idx: i64) -> T {
        let last = self.len() - 1;
        self.swap(idx, last);
        self.pop().unwrap()
    }

    /// Removes and returns the first element `pred` accepts, shifting the
    /// rest down, or `None` when it accepts none.
    fn remove_first(mut ref self, pred: own MutFn(T) -> bool) -> Option[T] {
        let mut f = pred;
        let mut i = 0;
        while i < self.len() {
            if f(self[i]) {
                return Some(self.remove(i));
            }
            i = i + 1;
        }
        None
    }
}

impl[T: PartialEq] Vec[T] {
    /// Whether some element equals `x`.
    fn contains(ref self, x: ref T) -> bool {
        for e in self.iter() {
            if e == x {
                return true;
            }
        }
        false
    }
}

impl[T] DoubleEndedIterator for VecIter[T] {
    fn next_back(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        self.back = self.back - 1;
        self.v.get(self.back)
    }
}

/// The elements of a set, in the set's iteration order, each borrowed.
struct SetIter[T] {
    s: ref Set[T],
    front: i64,
    back: i64,
}

impl[T] Iterator for SetIter[T] {
    type Item = ref T;

    fn next(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        let i = self.front;
        self.front = i + 1;
        Some(self.s.entry_at(i))
    }
}

impl[T] Set[T] {
    /// The elements, in the set's iteration order, each borrowed.
    fn iter(ref self) -> SetIter[T] {
        SetIter { s: self, front: 0, back: self.len() }
    }

    /// A set of the list's elements; a repeated element is kept once
    /// (docs/library/collections.md, Collection literals).
    fn from(v: own Vec[T]) -> Set[T] {
        let mut out: Set[T] = Set.new();
        for x in v.into_iter() {
            out.insert(x);
        }
        out
    }
}

/// The elements of a deque, front to back, each borrowed.
struct DequeIter[T] {
    d: ref VecDeque[T],
    front: i64,
    back: i64,
}

impl[T] Iterator for DequeIter[T] {
    type Item = ref T;

    fn next(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        let i = self.front;
        self.front = i + 1;
        Some(self.d.entry_at(i))
    }
}

impl[T] DoubleEndedIterator for DequeIter[T] {
    fn next_back(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        self.back = self.back - 1;
        Some(self.d.entry_at(self.back))
    }
}

/// The elements of a sorted set, in ascending order, each borrowed.
struct SortedSetIter[T] {
    s: ref SortedSet[T],
    front: i64,
    back: i64,
}

impl[T] Iterator for SortedSetIter[T] {
    type Item = ref T;

    fn next(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        let i = self.front;
        self.front = i + 1;
        Some(self.s.entry_at(i))
    }
}

impl[T] DoubleEndedIterator for SortedSetIter[T] {
    fn next_back(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        self.back = self.back - 1;
        Some(self.s.entry_at(self.back))
    }
}

impl[T] SortedSet[T] {
    /// The elements, in ascending order, each borrowed.
    fn iter(ref self) -> SortedSetIter[T] {
        SortedSetIter { s: self, front: 0, back: self.len() }
    }
}

impl[T: Ord] SortedSet[T] {
    /// The elements in `[from, to)`, ascending, each borrowed; none when
    /// `from >= to`.
    fn range(ref self, from: T, to: T) -> SortedSetIter[T] {
        let front = self.bound_index(from, false);
        let back = self.bound_index(to, false);
        SortedSetIter { s: self, front, back: if back < front { front } else { back } }
    }

    /// The elements in `[from, to]`, ascending, each borrowed; none when
    /// `from > to`.
    fn range_inclusive(ref self, from: T, to: T) -> SortedSetIter[T] {
        let front = self.bound_index(from, false);
        let back = self.bound_index(to, true);
        SortedSetIter { s: self, front, back: if back < front { front } else { back } }
    }

    /// The index of the first element `>= x` (`> x` when `past` is set),
    /// by binary search: the elements are in order.
    fn bound_index(ref self, x: T, past: bool) -> i64 {
        let mut lo = 0;
        let mut hi = self.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            let e = self.entry_at(mid);
            let before = if past { e <= x } else { e < x };
            if before {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        lo
    }
}

/// The entries of a map, in the map's iteration order: each key and value
/// borrowed.
struct MapIter[K, V] {
    m: ref Map[K, V],
    front: i64,
    back: i64,
}

impl[K, V] Iterator for MapIter[K, V] {
    type Item = (ref K, ref V);

    fn next(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        let i = self.front;
        self.front = i + 1;
        let (k, v) = self.m.entry_at(i);
        Some((k, v))
    }
}

impl[K, V] Map[K, V] {
    /// A map of the list's `(key, value)` pairs; a repeated key keeps its
    /// last value (docs/library/collections.md, Collection literals).
    fn from(v: own Vec[(K, V)]) -> Map[K, V] {
        let mut out: Map[K, V] = Map.new();
        for (k, x) in v.into_iter() {
            out.insert(k, x);
        }
        out
    }

    /// The entries, in the map's iteration order, each key and value
    /// borrowed.
    fn iter(ref self) -> MapIter[K, V] {
        MapIter { m: self, front: 0, back: self.len() }
    }

    /// The keys, in the map's iteration order, each borrowed.
    fn keys(ref self) -> MapKeys[K, V] {
        MapKeys { m: self, front: 0, back: self.len() }
    }

    /// The values, in the map's iteration order, each borrowed.
    fn values(ref self) -> MapValues[K, V] {
        MapValues { m: self, front: 0, back: self.len() }
    }

    /// The value at `key`, borrowed to be changed in place.
    fn get_mut(mut ref self, key: K) -> Option[mut ref V] {
        if self.contains_key(key) {
            Some(mut self[key])
        } else {
            None
        }
    }
}

/// The keys of a map, in the map's iteration order, each borrowed.
struct MapKeys[K, V] {
    m: ref Map[K, V],
    front: i64,
    back: i64,
}

impl[K, V] Iterator for MapKeys[K, V] {
    type Item = ref K;

    fn next(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        let i = self.front;
        self.front = i + 1;
        let (k, _) = self.m.entry_at(i);
        Some(k)
    }
}

/// The values of a map, in the map's iteration order, each borrowed.
struct MapValues[K, V] {
    m: ref Map[K, V],
    front: i64,
    back: i64,
}

impl[K, V] Iterator for MapValues[K, V] {
    type Item = ref V;

    fn next(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        let i = self.front;
        self.front = i + 1;
        let (_, v) = self.m.entry_at(i);
        Some(v)
    }
}

/// The entries of a sorted map, in ascending key order: each key and value
/// borrowed.
struct SortedMapIter[K, V] {
    m: ref SortedMap[K, V],
    front: i64,
    back: i64,
}

impl[K, V] Iterator for SortedMapIter[K, V] {
    type Item = (ref K, ref V);

    fn next(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        let i = self.front;
        self.front = i + 1;
        let (k, v) = self.m.entry_at(i);
        Some((k, v))
    }
}

impl[K, V] DoubleEndedIterator for SortedMapIter[K, V] {
    fn next_back(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        self.back = self.back - 1;
        let (k, v) = self.m.entry_at(self.back);
        Some((k, v))
    }
}

impl[K, V] SortedMap[K, V] {
    /// The entries, in ascending key order, each key and value borrowed.
    fn iter(ref self) -> SortedMapIter[K, V] {
        SortedMapIter { m: self, front: 0, back: self.len() }
    }

    /// The keys, ascending, each borrowed.
    fn keys(ref self) -> SortedMapKeys[K, V] {
        SortedMapKeys { m: self, front: 0, back: self.len() }
    }

    /// The values, in key order, each borrowed.
    fn values(ref self) -> SortedMapValues[K, V] {
        SortedMapValues { m: self, front: 0, back: self.len() }
    }

    /// The value at `key`, borrowed to be changed in place.
    fn get_mut(mut ref self, key: K) -> Option[mut ref V] {
        if self.contains_key(key) {
            Some(mut self[key])
        } else {
            None
        }
    }
}

impl[K: Ord, V] SortedMap[K, V] {
    /// The entries with keys in `[from, to)`, ascending, each key and
    /// value borrowed; none when `from >= to`.
    fn range(ref self, from: K, to: K) -> SortedMapIter[K, V] {
        let front = self.bound_index(from, false);
        let back = self.bound_index(to, false);
        SortedMapIter { m: self, front, back: if back < front { front } else { back } }
    }

    /// The entries with keys in `[from, to]`, ascending; none when
    /// `from > to`.
    fn range_inclusive(ref self, from: K, to: K) -> SortedMapIter[K, V] {
        let front = self.bound_index(from, false);
        let back = self.bound_index(to, true);
        SortedMapIter { m: self, front, back: if back < front { front } else { back } }
    }

    /// The index of the first key `>= key` (`> key` when `past` is set),
    /// by binary search: the keys are in order.
    fn bound_index(ref self, key: K, past: bool) -> i64 {
        let mut lo = 0;
        let mut hi = self.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            let (k, _) = self.entry_at(mid);
            let before = if past { k <= key } else { k < key };
            if before {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        lo
    }
}

/// The keys of a sorted map, ascending, each borrowed.
struct SortedMapKeys[K, V] {
    m: ref SortedMap[K, V],
    front: i64,
    back: i64,
}

impl[K, V] Iterator for SortedMapKeys[K, V] {
    type Item = ref K;

    fn next(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        let i = self.front;
        self.front = i + 1;
        let (k, _) = self.m.entry_at(i);
        Some(k)
    }
}

impl[K, V] DoubleEndedIterator for SortedMapKeys[K, V] {
    fn next_back(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        self.back = self.back - 1;
        let (k, _) = self.m.entry_at(self.back);
        Some(k)
    }
}

/// The values of a sorted map, in key order, each borrowed.
struct SortedMapValues[K, V] {
    m: ref SortedMap[K, V],
    front: i64,
    back: i64,
}

impl[K, V] Iterator for SortedMapValues[K, V] {
    type Item = ref V;

    fn next(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        let i = self.front;
        self.front = i + 1;
        let (_, v) = self.m.entry_at(i);
        Some(v)
    }
}

impl[K, V] DoubleEndedIterator for SortedMapValues[K, V] {
    fn next_back(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        self.back = self.back - 1;
        let (_, v) = self.m.entry_at(self.back);
        Some(v)
    }
}

/// The chars of a `String`, front to back. A char is a copy, so the items
/// are values; the iterator borrows the text.
struct StrChars {
    s: ref String,
    pos: i64,
    back: i64,
}

impl Iterator for StrChars {
    type Item = char;

    fn next(mut ref self) -> Option[char] {
        if self.pos >= self.back {
            return None;
        }
        let c = self.s.char_at_byte(self.pos);
        self.pos = self.pos + c.len_utf8();
        Some(c)
    }
}

impl DoubleEndedIterator for StrChars {
    fn next_back(mut ref self) -> Option[char] {
        if self.back <= self.pos {
            return None;
        }
        let c = self.s.char_before_byte(self.back);
        self.back = self.back - c.len_utf8();
        Some(c)
    }
}

impl String {
    /// The chars, front to back; `rev()` walks them back to front.
    fn chars(ref self) -> StrChars {
        StrChars { s: self, pos: 0, back: self.len() }
    }
}

/// The chars of a `Str`, front to back: [`StrChars`] over a view rather
/// than a borrowed `String` (B-2026-10-13-26).
struct StrViewChars {
    s: Str,
    pos: i64,
    back: i64,
}

impl Iterator for StrViewChars {
    type Item = char;

    fn next(mut ref self) -> Option[char] {
        if self.pos >= self.back {
            return None;
        }
        let c = self.s.char_at_byte(self.pos);
        self.pos = self.pos + c.len_utf8();
        Some(c)
    }
}

impl DoubleEndedIterator for StrViewChars {
    fn next_back(mut ref self) -> Option[char] {
        if self.back <= self.pos {
            return None;
        }
        let c = self.s.char_before_byte(self.back);
        self.back = self.back - c.len_utf8();
        Some(c)
    }
}

impl StringSlice {
    /// The chars, front to back; `rev()` walks them back to front.
    fn chars(self) -> StrViewChars {
        StrViewChars { s: self, pos: 0, back: self.len() }
    }

    /// The pieces between the occurrences of `sep`, front to back, each a
    /// view into the text (docs/library/strings.md, B-2026-10-12-7). Text
    /// with no `sep` is one piece; an empty `sep` matches at both ends and
    /// between every pair of chars.
    fn split(self, sep: Str) -> StrSplit {
        let pos = if sep.is_empty() { -1 } else { 0 };
        StrSplit { s: self, sep: sep, pos: pos, done: false }
    }

    /// The lines, each a view without its `\n` or `\r\n`; a final line
    /// end starts no empty line.
    fn lines(self) -> StrLines {
        StrLines { s: self, pos: 0 }
    }

    /// The runs of non-whitespace chars, each a view into the text.
    fn split_whitespace(self) -> StrWords {
        StrWords { s: self, pos: 0 }
    }

    /// The text without leading and trailing whitespace, a view into it.
    fn trim(self) -> Str {
        self.trim_start().trim_end()
    }

    /// The text without leading whitespace, a view into it.
    fn trim_start(self) -> Str {
        let n = self.len();
        let mut at = 0;
        while at < n {
            let c = self.char_at_byte(at);
            if not c.is_whitespace() {
                break;
            }
            at = at + c.len_utf8();
        }
        self.slice(at, n)
    }

    /// The text without trailing whitespace, a view into it.
    fn trim_end(self) -> Str {
        let mut end = self.len();
        while end > 0 {
            let c = self.char_before_byte(end);
            if not c.is_whitespace() {
                break;
            }
            end = end - c.len_utf8();
        }
        self.slice(0, end)
    }

    /// The byte offset of the last occurrence of `pat`, a valid place to cut
    /// with `s[a..b]`. An empty `pat` is found at the end (B-2026-10-15-15).
    fn rfind(self, pat: Str) -> Option[i64] {
        let n = self.len();
        let m = pat.len();
        if m > n {
            return None;
        }
        let mut at = n;
        loop {
            if at + m <= n and self.slice(at, n).starts_with(pat) {
                return Some(at);
            }
            if at == 0 {
                return None;
            }
            at = at - self.char_before_byte(at).len_utf8();
        }
    }

    /// The text before and after the first `sep`, both views into it; `None`
    /// when `sep` does not occur.
    fn split_once(self, sep: Str) -> Option[(Str, Str)] {
        match self.find(sep) {
            Some(i) => Some((self.slice(0, i), self.slice(i + sep.len(), self.len()))),
            None => None,
        }
    }

    /// The text before and after the last `sep`, both views into it; `None`
    /// when `sep` does not occur.
    fn rsplit_once(self, sep: Str) -> Option[(Str, Str)] {
        match self.rfind(sep) {
            Some(i) => Some((self.slice(0, i), self.slice(i + sep.len(), self.len()))),
            None => None,
        }
    }

    /// The text after `prefix`, a view into it; `None` when the text does
    /// not start with `prefix`.
    fn strip_prefix(self, prefix: Str) -> Option[Str] {
        if self.starts_with(prefix) {
            Some(self.slice(prefix.len(), self.len()))
        } else {
            None
        }
    }

    /// The text before `suffix`, a view into it; `None` when the text does
    /// not end with `suffix`.
    fn strip_suffix(self, suffix: Str) -> Option[Str] {
        if self.ends_with(suffix) {
            Some(self.slice(0, self.len() - suffix.len()))
        } else {
            None
        }
    }

    /// At most `n` pieces, as `split` makes them, the last one holding the
    /// rest of the text. `n <= 0` makes none.
    fn splitn(self, n: i64, sep: Str) -> StrSplitN {
        StrSplitN { inner: self.split(sep), left: n }
    }
}

impl String {
    /// The empty string: what `T: Default` calls, and what `String.new`
    /// names as a function value (`or_insert_with(String.new)`).
    fn default() -> String {
        String.new()
    }

    /// `split` of the text as a `Str`: each piece is a view into `self`.
    fn split(ref self, sep: Str) -> StrSplit {
        self.as_str().split(sep)
    }

    /// `lines` of the text as a `Str`: each line is a view into `self`.
    fn lines(ref self) -> StrLines {
        self.as_str().lines()
    }

    /// `split_whitespace` of the text as a `Str`.
    fn split_whitespace(ref self) -> StrWords {
        self.as_str().split_whitespace()
    }

    /// `trim` of the text as a `Str`: a view into `self`.
    fn trim(ref self) -> Str {
        self.as_str().trim()
    }

    /// `trim_start` of the text as a `Str`: a view into `self`.
    fn trim_start(ref self) -> Str {
        self.as_str().trim_start()
    }

    /// `trim_end` of the text as a `Str`: a view into `self`.
    fn trim_end(ref self) -> Str {
        self.as_str().trim_end()
    }

    /// `rfind` of the text as a `Str`.
    fn rfind(ref self, pat: Str) -> Option[i64] {
        self.as_str().rfind(pat)
    }

    /// `split_once` of the text as a `Str`: both pieces are views into `self`.
    fn split_once(ref self, sep: Str) -> Option[(Str, Str)] {
        self.as_str().split_once(sep)
    }

    /// `rsplit_once` of the text as a `Str`: both pieces are views into `self`.
    fn rsplit_once(ref self, sep: Str) -> Option[(Str, Str)] {
        self.as_str().rsplit_once(sep)
    }

    /// `strip_prefix` of the text as a `Str`: a view into `self`.
    fn strip_prefix(ref self, prefix: Str) -> Option[Str] {
        self.as_str().strip_prefix(prefix)
    }

    /// `strip_suffix` of the text as a `Str`: a view into `self`.
    fn strip_suffix(ref self, suffix: Str) -> Option[Str] {
        self.as_str().strip_suffix(suffix)
    }

    /// `splitn` of the text as a `Str`: each piece is a view into `self`.
    fn splitn(ref self, n: i64, sep: Str) -> StrSplitN {
        self.as_str().splitn(n, sep)
    }
}

/// The pieces of a `Str` between the occurrences of a separator: `split`.
/// `pos` is the byte the next piece starts at; with an empty separator it
/// starts at -1, for the empty piece before the first char.
struct StrSplit {
    s: Str,
    sep: Str,
    pos: i64,
    done: bool,
}

impl Iterator for StrSplit {
    type Item = Str;

    fn next(mut ref self) -> Option[Self.Item] {
        if self.done {
            return None;
        }
        let n = self.s.len();
        if self.sep.is_empty() {
            if self.pos < 0 {
                self.pos = 0;
                return Some(self.s.slice(0, 0));
            }
            if self.pos >= n {
                self.done = true;
                return Some(self.s.slice(n, n));
            }
            let at = self.pos;
            self.pos = at + self.s.char_at_byte(at).len_utf8();
            return Some(self.s.slice(at, self.pos));
        }
        let at = self.pos;
        match self.s.find_at_byte(self.sep, at) {
            Some(i) => {
                self.pos = i + self.sep.len();
                Some(self.s.slice(at, i))
            }
            None => {
                self.done = true;
                Some(self.s.slice(at, n))
            }
        }
    }
}

/// At most `left` more pieces of a `Str` between the occurrences of a
/// separator, the last holding the rest of the text: `splitn`.
struct StrSplitN {
    inner: StrSplit,
    left: i64,
}

impl Iterator for StrSplitN {
    type Item = Str;

    fn next(mut ref self) -> Option[Self.Item] {
        if self.left <= 0 {
            return None;
        }
        self.left = self.left - 1;
        if self.left > 0 {
            return self.inner.next();
        }
        if self.inner.done {
            return None;
        }
        self.inner.done = true;
        let at = if self.inner.pos < 0 { 0 } else { self.inner.pos };
        Some(self.inner.s.slice(at, self.inner.s.len()))
    }
}

/// The lines of a `Str`: `lines`. `pos` is the byte the next line starts at.
struct StrLines {
    s: Str,
    pos: i64,
}

impl Iterator for StrLines {
    type Item = Str;

    fn next(mut ref self) -> Option[Self.Item] {
        let n = self.s.len();
        if self.pos >= n {
            return None;
        }
        let at = self.pos;
        match self.s.find_at_byte("\n", at) {
            Some(i) => {
                self.pos = i + 1;
                // A `\r\n` ends the line too; a lone `\r` is text.
                let mut end = i;
                if end > at and self.s.char_before_byte(end) == '\r' {
                    end = end - 1;
                }
                Some(self.s.slice(at, end))
            }
            None => {
                self.pos = n;
                Some(self.s.slice(at, n))
            }
        }
    }
}

/// The runs of non-whitespace chars of a `Str`: `split_whitespace`. `pos`
/// is the byte the search for the next run starts at.
struct StrWords {
    s: Str,
    pos: i64,
}

impl Iterator for StrWords {
    type Item = Str;

    fn next(mut ref self) -> Option[Self.Item] {
        let n = self.s.len();
        while self.pos < n {
            let c = self.s.char_at_byte(self.pos);
            if not c.is_whitespace() {
                break;
            }
            self.pos = self.pos + c.len_utf8();
        }
        if self.pos >= n {
            return None;
        }
        let at = self.pos;
        while self.pos < n {
            let c = self.s.char_at_byte(self.pos);
            if c.is_whitespace() {
                break;
            }
            self.pos = self.pos + c.len_utf8();
        }
        Some(self.s.slice(at, self.pos))
    }
}

impl[T] FromIterator[T] for Vec[T] {
    fn from_iter[I: Iterator[Item = T]](iter: own I) -> Vec[T] {
        let mut it = iter;
        let mut out: Vec[T] = Vec.new();
        while let Some(x) = it.next() {
            out.push(x);
        }
        out
    }
}

impl FromIterator[char] for String {
    fn from_iter[I: Iterator[Item = char]](iter: own I) -> String {
        let mut it = iter;
        let mut out = String.new();
        while let Some(c) = it.next() {
            out.push(c);
        }
        out
    }
}

impl[K, V] FromIterator[(K, V)] for Map[K, V] {
    fn from_iter[I: Iterator[Item = (K, V)]](iter: own I) -> Map[K, V] {
        let mut it = iter;
        let mut out: Map[K, V] = Map.new();
        while let Some((k, v)) = it.next() {
            out.insert(k, v);
        }
        out
    }
}

impl[T] FromIterator[T] for Set[T] {
    fn from_iter[I: Iterator[Item = T]](iter: own I) -> Set[T] {
        let mut it = iter;
        let mut out: Set[T] = Set.new();
        while let Some(x) = it.next() {
            out.insert(x);
        }
        out
    }
}

// B-2026-10-14-20: the ordered twins of `Set` and `Map`.
impl[T] FromIterator[T] for SortedSet[T] {
    fn from_iter[I: Iterator[Item = T]](iter: own I) -> SortedSet[T] {
        let mut it = iter;
        let mut out: SortedSet[T] = SortedSet.new();
        while let Some(x) = it.next() {
            out.insert(x);
        }
        out
    }
}

impl[K, V] FromIterator[(K, V)] for SortedMap[K, V] {
    fn from_iter[I: Iterator[Item = (K, V)]](iter: own I) -> SortedMap[K, V] {
        let mut it = iter;
        let mut out: SortedMap[K, V] = SortedMap.new();
        while let Some((k, v)) = it.next() {
            out.insert(k, v);
        }
        out
    }
}

// B-2026-10-14-17: front to back, in the iterator's order.
impl[T] FromIterator[T] for VecDeque[T] {
    fn from_iter[I: Iterator[Item = T]](iter: own I) -> VecDeque[T] {
        let mut it = iter;
        let mut out: VecDeque[T] = VecDeque.new();
        while let Some(x) = it.next() {
            out.push_back(x);
        }
        out
    }
}

// `v.extend(items)` from a source that is not a `Vec`, slice or array: the
// MIR builder calls one of these (docs/library/collections.md, `extend`
// takes any `IntoIterator[Item = T]`). Each item moves onto the end in order.

// An iterator's `ref` items to a `Copy` element are copied out
// (`d.extend(v.iter())`), as `ItemValues` reads them; other items move.
fn vec_extend_iter[T, I: Iterator](v: mut ref Vec[T], items: own I) {
    let mut it = items;
    while let Some(x) = it.next() {
        let y: T = iter_read_value(x);
        v.push(y);
    }
}

// A type that is `IntoIterator` and not itself an iterator gives its items
// through `into_iter` (B-2026-10-20-32).
fn vec_extend_into[T, C: IntoIterator[Item = T]](v: mut ref Vec[T], items: own C) {
    let mut it = items.into_iter();
    while let Some(x) = it.next() {
        v.push(x);
    }
}

fn vec_extend_set[T](v: mut ref Vec[T], items: own Set[T]) {
    for x in items.into_iter() {
        v.push(x);
    }
}

fn vec_extend_sorted_set[T](v: mut ref Vec[T], items: own SortedSet[T]) {
    for x in items.into_iter() {
        v.push(x);
    }
}

fn vec_extend_deque[T](v: mut ref Vec[T], items: own VecDeque[T]) {
    for x in items.into_iter() {
        v.push(x);
    }
}

fn vec_extend_map[K, V](v: mut ref Vec[(K, V)], items: own Map[K, V]) {
    for (k, x) in items.into_iter() {
        v.push((k, x));
    }
}

fn vec_extend_sorted_map[K, V](v: mut ref Vec[(K, V)], items: own SortedMap[K, V]) {
    for (k, x) in items.into_iter() {
        v.push((k, x));
    }
}

/// Moves the front `k` elements of `d` to its back, in order.
fn deque_rotate_front[T](d: mut ref VecDeque[T], k: i64) {
    let mut i = 0;
    while i < k {
        let x = d.pop_front().unwrap();
        d.push_back(x);
        i = i + 1;
    }
}

// `d.extend(items)` on a `VecDeque`, which has no native `extend`: each
// item is pushed onto the back in order (B-2026-10-26-18).
fn deque_extend_iter[T, I: Iterator](d: mut ref VecDeque[T], items: own I) {
    let mut it = items;
    while let Some(x) = it.next() {
        let y: T = iter_read_value(x);
        d.push_back(y);
    }
}

fn deque_extend_into[T, C: IntoIterator[Item = T]](d: mut ref VecDeque[T], items: own C) {
    let mut it = items.into_iter();
    while let Some(x) = it.next() {
        d.push_back(x);
    }
}

fn deque_extend_vec[T](d: mut ref VecDeque[T], items: own Vec[T]) {
    for x in items.into_iter() {
        d.push_back(x);
    }
}

fn deque_extend_set[T](d: mut ref VecDeque[T], items: own Set[T]) {
    for x in items.into_iter() {
        d.push_back(x);
    }
}

fn deque_extend_sorted_set[T](d: mut ref VecDeque[T], items: own SortedSet[T]) {
    for x in items.into_iter() {
        d.push_back(x);
    }
}

fn deque_extend_deque[T](d: mut ref VecDeque[T], items: own VecDeque[T]) {
    let mut src = items;
    while let Some(x) = src.pop_front() {
        d.push_back(x);
    }
}

fn deque_extend_map[K, V](d: mut ref VecDeque[(K, V)], items: own Map[K, V]) {
    for (k, x) in items.into_iter() {
        d.push_back((k, x));
    }
}

fn deque_extend_sorted_map[K, V](d: mut ref VecDeque[(K, V)], items: own SortedMap[K, V]) {
    for (k, x) in items.into_iter() {
        d.push_back((k, x));
    }
}

// The collections' `default()`, empty: what `T: Default` calls (`Default`
// is a builtin, satisfied by a type's `default` associated function), and
// what a `#[serde(skip)]` collection field reads back as.

impl[T] Vec[T] {
    fn default() -> Vec[T] {
        Vec.new()
    }
}

impl[T] VecDeque[T] {
    /// The elements, front to back, each borrowed.
    fn iter(ref self) -> DequeIter[T] {
        DequeIter { d: self, front: 0, back: self.len() }
    }

    fn default() -> VecDeque[T] {
        VecDeque.new()
    }


    // The rest of collections.md's surface (B-2026-10-26-18), on the
    // native ends: an element moves by rotating the ring through
    // `pop_front` / `push_back`, which never reallocates.

    /// Removes and returns the element at `idx` (0 is the front). An index
    /// out of bounds aborts, as `Vec.remove` does.
    fn remove(mut ref self, idx: i64) -> T {
        let n = self.len();
        if idx < 0 or idx >= n {
            panic("index out of bounds");
        }
        deque_rotate_front(mut self, idx);
        let out = self.pop_front().unwrap();
        deque_rotate_front(mut self, n - 1 - idx);
        out
    }

    /// Exchanges the elements at `i` and `j`, as `Vec.swap` does.
    fn swap(mut ref self, i: i64, j: i64) {
        let n = self.len();
        if i < 0 or i >= n or j < 0 or j >= n {
            panic("index out of bounds");
        }
        if i == j {
            return;
        }
        let lo = if i < j { i } else { j };
        let hi = if i < j { j } else { i };
        let y = self.remove(hi);
        let x = self.remove(lo);
        self.insert(lo, y);
        self.insert(hi, x);
    }

    /// Keeps the elements `pred` accepts, front to back.
    fn retain(mut ref self, pred: own MutFn(T) -> bool) {
        let mut f = pred;
        let n = self.len();
        let mut i = 0;
        while i < n {
            let x = self.pop_front().unwrap();
            if f(x) {
                self.push_back(x);
            }
            i = i + 1;
        }
    }

    /// Drops the elements from index `len` to the back; nothing when `len`
    /// is at least the length.
    fn truncate(mut ref self, len: i64) {
        while self.len() > len {
            let _ = self.pop_back();
        }
    }
}

impl[T: PartialEq] VecDeque[T] {
    /// Whether some element equals `x`.
    fn contains(ref self, x: ref T) -> bool {
        for e in self.iter() {
            if e == x {
                return true;
            }
        }
        false
    }
}

impl[T] Set[T] {
    fn default() -> Set[T] {
        Set.new()
    }
}

impl[T] SortedSet[T] {
    fn default() -> SortedSet[T] {
        SortedSet.new()
    }
}

impl[K, V] Map[K, V] {
    fn default() -> Map[K, V] {
        Map.new()
    }
}

impl[K, V] SortedMap[K, V] {
    fn default() -> SortedMap[K, V] {
        SortedMap.new()
    }
}

// Each collection is consumed through `IntoIterator` (design.md §
// `Iterator` and `Iterable`, B-2026-10-20-32), so a generic
// `C: IntoIterator` takes one; `for` borrows it instead.
impl[T] IntoIterator for Vec[T] {
    type Item = T;

    /// The elements, front to back, each moved out of the vector.
    fn into_iter(own self) -> VecIntoIter[T] {
        VecIntoIter { front: Vec.new(), back: self }
    }
}

impl[T] IntoIterator for VecDeque[T] {
    type Item = T;

    /// The elements moved out, front to back.
    fn into_iter(own self) -> VecIntoIter[T] {
        let mut d = self;
        let mut v: Vec[T] = Vec.new();
        while let Some(x) = d.pop_front() {
            v.push(x);
        }
        v.into_iter()
    }
}

impl[T] IntoIterator for Set[T] {
    type Item = T;

    /// The elements moved out, in the set's iteration order.
    fn into_iter(own self) -> VecIntoIter[T] {
        let mut c = self;
        c.drain_entries().into_iter()
    }
}

impl[T] IntoIterator for SortedSet[T] {
    type Item = T;

    /// The elements moved out, in the set's iteration order.
    fn into_iter(own self) -> VecIntoIter[T] {
        let mut c = self;
        c.drain_entries().into_iter()
    }
}

impl[K, V] IntoIterator for Map[K, V] {
    type Item = (K, V);

    /// The entries, each a `(key, value)` pair, moved out, in the map's iteration order.
    fn into_iter(own self) -> VecIntoIter[(K, V)] {
        let mut c = self;
        c.drain_entries().into_iter()
    }
}

impl[K, V] IntoIterator for SortedMap[K, V] {
    type Item = (K, V);

    /// The entries, each a `(key, value)` pair, moved out, in the map's iteration order.
    fn into_iter(own self) -> VecIntoIter[(K, V)] {
        let mut c = self;
        c.drain_entries().into_iter()
    }
}

// `f64.total_cmp` and `f32.total_cmp` named as a value: the comparator
// `w.sort_by(f64.total_cmp)` passes (docs/library/collections.md). The MIR
// builder names these for the path (B-2026-10-21-30).
fn f64_total_cmp(a: f64, b: f64) -> Ordering {
    a.total_cmp(b)
}

fn f32_total_cmp(a: f32, b: f32) -> Ordering {
    a.total_cmp(b)
}

// `F64.from` and `F32.from` named as a value (`v.iter().map(F64.from)`):
// the wrapper's constructor is the interpreter's and the backend's own, so
// the MIR builder names these for the path, as it does `f64_total_cmp`.
fn f64_wrapper_from(value: f64) -> F64 {
    F64.from(value)
}

fn f32_wrapper_from(value: f32) -> F32 {
    F32.from(value)
}
