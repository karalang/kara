// The iterators over the library's collections, as Kāra (redesign A2;
// docs/library/iterators.md).
//
// The MIR pipeline appends this file to the program. Each source is a struct
// that borrows its collection and holds a position, so an iterator over a
// borrowed collection is a view (core semantics §5.2) and its items are
// `ref T`. The legacy backends do not read it.

/// The elements of a `Vec`, front to back, each borrowed.
struct VecIter[T] {
    v: ref Vec[T],
    front: i64,
    back: i64,
}

impl[T] Iterator for VecIter[T] {
    type Item = ref T;

    fn next(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        let i = self.front;
        self.front = i + 1;
        self.v.get(i)
    }
}

/// The elements of a slice, front to back, each borrowed.
struct SliceIter[T] {
    s: Slice[T],
    front: i64,
    back: i64,
}

impl[T] Iterator for SliceIter[T] {
    type Item = ref T;

    fn next(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        let i = self.front;
        self.front = i + 1;
        self.s.get(i)
    }
}

impl[T] DoubleEndedIterator for SliceIter[T] {
    fn next_back(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        self.back = self.back - 1;
        self.s.get(self.back)
    }
}

impl[T] Slice[T] {
    /// The elements, front to back, each borrowed.
    fn iter(self) -> SliceIter[T] {
        SliceIter { s: self, front: 0, back: self.len() }
    }
}

impl[T: Display] Slice[T] {
    /// The elements' `Display` forms, with `sep` between each adjacent pair
    /// (B-2026-10-14-4, B-2026-10-14-67).
    fn join(self, sep: Str) -> String {
        let mut out = String.new();
        let mut first = true;
        for x in self.iter() {
            if not first {
                out.push_str(sep);
            }
            first = false;
            out.push_str(f"{x}");
        }
        out
    }

    /// The elements' `Display` forms, with nothing between.
    fn concat(self) -> String {
        self.join("")
    }
}

/// The elements of a `Vec`, front to back, each moved out. `front` holds
/// the next ones reversed, so `pop` takes the first; `back` holds the last
/// ones in order, so `pop` takes the last. Each side refills from the other
/// when it runs out, so a walk from one end moves each element once.
struct VecIntoIter[T] {
    front: Vec[T],
    back: Vec[T],
}

impl[T] Iterator for VecIntoIter[T] {
    type Item = T;

    fn next(mut ref self) -> Option[T] {
        if self.front.is_empty() {
            while let Some(x) = self.back.pop() {
                self.front.push(x);
            }
        }
        self.front.pop()
    }
}

impl[T] DoubleEndedIterator for VecIntoIter[T] {
    fn next_back(mut ref self) -> Option[T] {
        if self.back.is_empty() {
            while let Some(x) = self.front.pop() {
                self.back.push(x);
            }
        }
        self.back.pop()
    }
}

impl[T] Drop for VecIntoIter[T] {
    /// The elements not taken drop front to back, as the vector's would.
    fn drop(mut ref self) {
        self.front.reverse();
    }
}

impl[T] Vec[T] {
    /// The elements, front to back, each borrowed.
    fn iter(ref self) -> VecIter[T] {
        VecIter { v: self, front: 0, back: self.len() }
    }

    /// The elements, front to back, each moved out of the vector.
    fn into_iter(own self) -> VecIntoIter[T] {
        VecIntoIter { front: Vec.new(), back: self }
    }

    fn is_empty(ref self) -> bool {
        self.len() == 0
    }

    /// The first element, borrowed, or `None` when the vector is empty.
    fn first(ref self) -> Option[ref T] {
        self.get(0)
    }

    /// The elements in reverse order, in place.
    fn reverse(mut ref self) {
        let mut i = 0;
        let mut j = self.len() - 1;
        while i < j {
            self.swap(i, j);
            i = i + 1;
            j = j - 1;
        }
    }

    /// Removes and returns the element at `idx`, moving the last element
    /// into its place. An index out of bounds aborts, as `v[idx]` does.
    fn swap_remove(mut ref self, idx: i64) -> T {
        let last = self.len() - 1;
        self.swap(idx, last);
        self.pop().unwrap()
    }
}

impl[T: PartialEq] Vec[T] {
    /// Whether some element equals `x`.
    fn contains(ref self, x: ref T) -> bool {
        for e in self.iter() {
            if e == x {
                return true;
            }
        }
        false
    }
}

impl[T] DoubleEndedIterator for VecIter[T] {
    fn next_back(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        self.back = self.back - 1;
        self.v.get(self.back)
    }
}

/// The elements of a set, in the set's iteration order, each borrowed.
struct SetIter[T] {
    s: ref Set[T],
    front: i64,
    back: i64,
}

impl[T] Iterator for SetIter[T] {
    type Item = ref T;

    fn next(mut ref self) -> Option[Self.Item] {
        if self.front >= self.back {
            return None;
        }
        let i = self.front;
        self.front = i + 1;
        Some(self.s.entry_at(i))
    }
}

impl[T] Set[T] {
    /// The elements, in the set's iteration order, each borrowed.
    fn iter(ref self) -> SetIter[T] {
        SetIter { s: self, front: 0, back: self.len() }
    }
}

