// runtime/stdlib/source/http_server.kara
//
// `Server.serve`, `serve_static`, `serve_tls`, `serve_ws` and
// `serve_ws_tls` on the v2 pipeline, as docs/library/io.md § HTTP server
// describes them. The MIR pipeline appends this file, with net.kara and
// websocket.kara, to a program that names one of them (`BAKED_SOURCES` in
// src/mir/lower.rs). It is Kāra over the listeners and streams, so its
// waits suspend in a task as theirs do; only parsing a request into the
// `Request` the handler reads, and writing a `Response` out, are native
// (src/http1.rs).
//
// Each connection is a task of an isolating group (core-semantics §11.12),
// kept for the requests that follow while the client asks to keep it: a
// connection that stalls holds only its own task, and a handler that
// panics ends only its own connection (B-2026-10-25-41).

struct Server { }

// What the servers accept connections on.
enum HttpListener {
    Plain(TcpListener),
    Tls(TlsListener),
}

impl HttpListener {
    fn accept(ref self) -> Result[WsConn, NetError] with sends(Network) receives(Network) blocks suspends {
        match self {
            HttpListener.Plain(l) => match l.accept() {
                Ok(s) => Ok(WsConn.Plain(s)),
                Err(e) => Err(e),
            },
            HttpListener.Tls(l) => match l.accept() {
                Ok(s) => Ok(WsConn.Tls(s)),
                Err(e) => Err(e),
            },
        }
    }

    fn local_addr(ref self) -> Result[String, NetError] {
        match self {
            HttpListener.Plain(l) => l.local_addr(),
            HttpListener.Tls(l) => l.local_addr(),
        }
    }
}

// What a connection's request task is answering, for the connection's
// task to read when that task panics (B-2026-11-20-10).
struct Answering {
    req: Request,
    handling: bool,
}

impl Server {
    // Answers every request with a 200 and `body`.
    #[unstable(note: "serve_static is a fixed-body convenience subsumed by Server.serve(handler); use serve(handler) for real servers")]
    fn serve_static(addr: own String, body: own String) -> Result[(), HttpError] with sends(Network) receives(Network) blocks suspends {
        match TcpListener.bind(addr) {
            Ok(l) => {
                let l = HttpListener.Plain(l);
                let group = TaskGroup.new();
                let accepting = group.spawn(|| Server.__fixed_connections(l, body));
                accepting.join()
            }
            Err(e) => Err(Server.__failed(f"{addr}: bind failed", e)),
        }
    }

    // Answers each request with `handler`'s response. The handler borrows
    // the request: io.md's `Fn(Request)`, as a user's bare parameter reads
    // (core-semantics.md §4.1). The library's own signatures are not
    // rewritten that way, so they spell the borrow `ref Request`; with a
    // bare `Request` a closure handler took it by value (B-2026-10-25-48).
    fn serve(addr: own String, handler: own Fn(ref Request) -> Response + CrossTask) -> Result[(), HttpError] with sends(Network) receives(Network) blocks suspends {
        match TcpListener.bind(addr) {
            Ok(l) => Server.__serve(HttpListener.Plain(l), handler, Server.__no_session, false),
            Err(e) => Err(Server.__failed(f"{addr}: bind failed", e)),
        }
    }

    // `serve` over TLS, with the certificate chain `cert_pem` and the
    // private key `key_pem` (PEM text, as `TlsListener.bind_tls` takes).
    // A connection whose handshake fails is dropped.
    fn serve_tls(addr: own String, cert_pem: own String, key_pem: own String, handler: own Fn(ref Request) -> Response + CrossTask) -> Result[(), HttpError] with sends(Network) receives(Network) blocks suspends {
        match TlsListener.bind_tls(addr, cert_pem, key_pem) {
            Ok(l) => Server.__serve(HttpListener.Tls(l), handler, Server.__no_session, false),
            Err(e) => Err(Server.__failed(f"{addr}: bind failed", e)),
        }
    }

    // `serve`, where a handler that answers a WebSocket handshake request
    // with status 101 upgrades the connection: the server sends the
    // handshake's own 101 and runs `ws_handler` on the connection, in the
    // connection's task.
    fn serve_ws(addr: own String, handler: own Fn(ref Request) -> Response + CrossTask, ws_handler: own Fn(own WebSocket) + CrossTask) -> Result[(), HttpError] with sends(Network) receives(Network) blocks suspends {
        match TcpListener.bind(addr) {
            Ok(l) => Server.__serve(HttpListener.Plain(l), handler, ws_handler, true),
            Err(e) => Err(Server.__failed(f"{addr}: bind failed", e)),
        }
    }

    // `serve_ws` over TLS.
    fn serve_ws_tls(addr: own String, cert_pem: own String, key_pem: own String, handler: own Fn(ref Request) -> Response + CrossTask, ws_handler: own Fn(own WebSocket) + CrossTask) -> Result[(), HttpError] with sends(Network) receives(Network) blocks suspends {
        match TlsListener.bind_tls(addr, cert_pem, key_pem) {
            Ok(l) => Server.__serve(HttpListener.Tls(l), handler, ws_handler, true),
            Err(e) => Err(Server.__failed(f"{addr}: bind failed", e)),
        }
    }

    // Serves the connections `l` accepts. The accept loop is a task of its
    // own, so the connections' tasks run while it waits.
    fn __serve(l: own HttpListener, handler: own Fn(ref Request) -> Response + CrossTask, ws_handler: own Fn(own WebSocket) + CrossTask, upgrades: bool) -> Result[(), HttpError] with sends(Network) receives(Network) blocks suspends {
        let group = TaskGroup.new();
        let accepting = group.spawn(|| Server.__connections(l, handler, ws_handler, upgrades));
        accepting.join()
    }

    // A failed `accept` is retried, never returned: out of descriptors
    // (EMFILE, ENFILE), out of memory, or a connection the client aborted
    // first is a moment's condition, and the connections being served are
    // what frees it (docs/library/io.md, B-2026-11-17-49). The pause
    // before the retry starts at 5 ms and doubles up to 1 s, reset by the
    // next connection accepted, as Go's net/http does; it suspends, so the
    // connections' tasks run meanwhile.
    fn __connections(l: own HttpListener, handler: own Fn(ref Request) -> Response + CrossTask, ws_handler: own Fn(own WebSocket) + CrossTask, upgrades: bool) -> Result[(), HttpError] with sends(Network) receives(Network) blocks suspends {
        let connections = TaskGroup.isolating();
        let mut pause = 0;
        loop {
            let conn = match l.accept() {
                Ok(conn) => conn,
                Err(NetError.Interrupted) => continue,
                Err(_) => {
                    pause = Server.__backoff(pause);
                    continue;
                }
            };
            pause = 0;
            let _ = connections.spawn(|| Server.__connection(conn, handler, ws_handler, upgrades));
        }
    }

    fn __fixed_connections(l: own HttpListener, body: own String) -> Result[(), HttpError] with sends(Network) receives(Network) blocks suspends {
        let connections = TaskGroup.isolating();
        let mut pause = 0;
        loop {
            let conn = match l.accept() {
                Ok(conn) => conn,
                Err(NetError.Interrupted) => continue,
                Err(_) => {
                    pause = Server.__backoff(pause);
                    continue;
                }
            };
            pause = 0;
            let _ = connections.spawn(|| Server.__fixed_connection(conn, body));
        }
    }

    // Waits out a failed `accept`: the pause after one of `pause` ms (0
    // for the first), which it returns.
    fn __backoff(pause: i64) -> i64 with suspends {
        let next = if pause == 0 {
            5
        } else if pause >= 500 {
            1000
        } else {
            pause * 2
        };
        sleep_ms(next);
        next
    }

    // Answers the requests `conn` sends with `handler`'s responses, until
    // the client closes it or asks to. With `upgrades`, a 101 to a
    // WebSocket handshake request is the upgrade instead: the connection,
    // past the request, goes to `ws_handler` as a `WebSocket`.
    //
    // The requests are answered in a task of their own, in an isolating
    // group, so a handler that panics ends that task and this one answers
    // for it: one line on standard error naming the request, and a 500
    // when no byte of its response has gone out (review-thread ruling,
    // B-2026-11-20-10). One task per connection, not per request: a
    // request pays nothing for it.
    fn __connection(conn: own WsConn, handler: Fn(ref Request) -> Response + CrossTask, ws_handler: Fn(own WebSocket) + CrossTask, upgrades: bool) with sends(Network) receives(Network) blocks suspends {
        let mut state = Answering { req: Request { __id: 0 }, handling: false };
        match Server.__answer_all(conn, handler, upgrades, mut state) {
            Ok(None) => {}
            Ok(Some(rest)) => {
                let ws = WebSocket {
                    conn: conn,
                    buf: rest,
                    frag_op: 0,
                    frag: Vec.new(),
                    closed: false,
                    close_code: None,
                    close_sent: false,
                };
                // The 101 is out, so a session that panics is only logged;
                // its connection closes as the session's `WebSocket` drops.
                let sessions = TaskGroup.isolating();
                let session = sessions.spawn(|| ws_handler(ws));
                match session.join() {
                    Ok(_) => {}
                    Err(failed) => Server.__log_failure(state.req, "WebSocket session", failed),
                }
            }
            Err(failed) => {
                Server.__log_failure(state.req, "handler", failed);
                if state.handling {
                    let refusal = Server.__refusal(500);
                    let _ = conn.write_all(refusal.bytes());
                    let _ = conn.shutdown_write();
                }
            }
        }
    }

    // `__requests` in a task of an isolating group of its own: its value,
    // or how it failed.
    fn __answer_all(conn: WsConn, handler: Fn(ref Request) -> Response + CrossTask, upgrades: bool, state: mut ref Answering) -> Result[Option[Vec[u8]], TaskFailed] with sends(Network) receives(Network) blocks suspends {
        let group = TaskGroup.isolating();
        let requests = group.spawn(|| Server.__requests(conn, handler, upgrades, mut state));
        requests.join()
    }

    // The request loop of `__connection`: `None` once the connection is
    // done, or the bytes after the request a WebSocket upgrade answered.
    // `state` holds the request being answered and whether its handler is
    // running, for `__connection` to read when this task panics.
    fn __requests(conn: WsConn, handler: Fn(ref Request) -> Response + CrossTask, upgrades: bool, state: mut ref Answering) -> Option[Vec[u8]] with sends(Network) receives(Network) blocks suspends {
        let mut buf: Vec[u8] = Vec.new();
        loop {
            let used = Server.__next(conn, mut buf);
            if used < 0 {
                return None;
            }
            // The request is the program's own value, so a task the handler
            // spawns reads it too (B-2026-11-20-54).
            state.req = Request { __id: Server.__served() };
            state.handling = true;
            let resp = handler(state.req);
            state.handling = false;
            // A 101 under `serve_ws` is the upgrade, for a request that is a
            // valid opening handshake; one that asks to upgrade but is not
            // valid is answered 400, or 426 for a version other than 13
            // (RFC 6455 §4.2.2, B-2026-11-17-57). A 101 to a request that
            // does not ask to upgrade is a handler error, answered 500: the
            // client cannot follow a switch it did not ask for
            // (review-thread ruling 2026-11-17).
            if upgrades and resp.status == 101 {
                match Server.__handshake_key(state.req) {
                    Ok(key) => {
                        let accept = WebSocket.__accept_key(key);
                        let reply = f"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: {accept}\r\n\r\n";
                        match conn.write_all(reply.bytes()) {
                            Ok(_) => {}
                            Err(_) => return None,
                        }
                        return Some(buf.split_off(used));
                    }
                    Err(status) => {
                        let refusal = Server.__refusal(status);
                        let _ = conn.write_all(refusal.bytes());
                        let _ = conn.shutdown_write();
                        return None;
                    }
                }
            }
            // The response decides last whether the connection stays: a
            // handler's `connection: close` closes it (B-2026-11-17-48).
            let wire = Server.__wire(resp);
            let keep = Server.__keep_alive();
            match conn.write_all(wire) {
                Ok(_) => {}
                Err(_) => return None,
            }
            if not keep {
                let _ = conn.shutdown_write();
                return None;
            }
            buf = buf.split_off(used);
        }
    }

    // `__connection` with a 200 and `body` as every answer.
    fn __fixed_connection(conn: own WsConn, body: String) with sends(Network) receives(Network) blocks suspends {
        let mut buf: Vec[u8] = Vec.new();
        loop {
            let used = Server.__next(conn, mut buf);
            if used < 0 {
                return;
            }
            let wire = Server.__wire_fixed(body);
            let keep = Server.__keep_alive();
            match conn.write_all(wire) {
                Ok(_) => {}
                Err(_) => return,
            }
            if not keep {
                let _ = conn.shutdown_write();
                return;
            }
            buf = buf.split_off(used);
        }
    }

    // Reads off `conn` until `buf` starts with a whole request, and makes
    // it the current one: the bytes it took, or -1 when the connection
    // holds no more requests.
    //
    // Each read waits as long as `__wait_ms` says (docs/library/io.md,
    // B-2026-11-17-50): a connection that sends no new request for 60 s
    // is closed silently; a request whose head is not whole 30 s after its
    // first byte, or whose body stalls for 60 s, is answered 408. The
    // buffer is parsed again only once it holds the bytes `__need` names,
    // so a large body is not re-read from its start after every read
    // (B-2026-11-17-51). A client that asks `Expect: 100-continue` gets
    // the interim `100 Continue` once, before its body is read
    // (B-2026-11-17-53).
    fn __next(conn: WsConn, buf: mut ref Vec[u8]) -> i64 with sends(Network) receives(Network) blocks suspends {
        let mut chunk = [0u8; 8192];
        let mut continued = false;
        let mut used = Server.__install(buf, false);
        loop {
            if used == -100 {
                if not continued {
                    continued = true;
                    match conn.write_all("HTTP/1.1 100 Continue\r\n\r\n".bytes()) {
                        Ok(_) => {}
                        Err(_) => return -1,
                    }
                }
                used = 0;
            }
            if used != 0 {
                break;
            }
            let wait = Server.__wait_ms();
            let ms = if wait < 0 { 0 - wait } else { wait };
            let _ = conn.set_read_timeout(Some(ms));
            match conn.read(mut chunk) {
                Ok(0) => used = Server.__install(buf, true),
                Ok(n) => {
                    buf.extend_from_slice(chunk[0..n]);
                    if buf.len() >= Server.__need() {
                        used = Server.__install(buf, false);
                    }
                }
                Err(NetError.Interrupted) => {}
                Err(NetError.TimedOut) => {
                    if wait > 0 {
                        return -1;
                    }
                    used = -408;
                }
                Err(_) => return -1,
            }
        }
        // A request the server refuses is answered with its status (400,
        // 408, 413, 431 or 501) without the handler, and its connection
        // closes (docs/library/io.md).
        if used < -1 {
            let refusal = Server.__refusal(0 - used);
            let _ = conn.write_all(refusal.bytes());
            let _ = conn.shutdown_write();
            return -1;
        }
        let _ = conn.set_read_timeout(None);
        used
    }

    // The answer to a request refused with `status`, which closes its
    // connection.
    fn __refusal(status: i64) -> String {
        let reason = match status {
            500 => "Internal Server Error",
            408 => "Request Timeout",
            413 => "Content Too Large",
            426 => "Upgrade Required",
            431 => "Request Header Fields Too Large",
            501 => "Not Implemented",
            _ => "Bad Request",
        };
        let extra = if status == 426 { "Sec-WebSocket-Version: 13\r\n" } else { "" };
        f"HTTP/1.1 {status} {reason}\r\n{extra}content-length: 0\r\nconnection: close\r\n\r\n"
    }

    // One line on standard error for a handler or session of `req` that
    // panicked: the request line and the panic (B-2026-11-20-10). A
    // cancelled one is the server shutting down, which says nothing.
    fn __log_failure(req: Request, what: Str, failed: TaskFailed) {
        match failed {
            TaskFailed.Panicked { message, location } => {
                let one_line = message.replace("\n", "\\n");
                Server.__report(f"http server: the {what} for {req.method()} {req.url()} panicked at {location}: {one_line}");
            }
            TaskFailed.Cancelled => {}
        }
    }

    // The current request as a `Request` of its own: its id among the
    // requests a program holds (`Request.new`'s), so every task reads it.
    // The connection keeps what its response reads.
    #[compiler_builtin]
    fn __served() -> i64 {
        0
    }

    // Writes `line` and a newline to the process's standard error, as the
    // runtime's own warnings go: no `writes(Stderr)`, and no provider, so
    // logging a handler's panic leaves `serve`'s effects as documented.
    #[compiler_builtin]
    fn __report(line: String) {}

    // The session of a server that does not upgrade, which never runs.
    fn __no_session(ws: own WebSocket) {}

    // The client's key when `req` is a WebSocket opening handshake (RFC
    // 6455 §4.2.1), else the status its refusal takes
    // (`WebSocket.__handshake`).
    fn __handshake_key(req: Request) -> Result[String, i64] {
        WebSocket.__handshake(
            req.method(),
            req.header("upgrade".to_string()),
            req.header("sec-websocket-version".to_string()),
            req.header("sec-websocket-key".to_string()),
        )
    }

    // `BOUND_PORT=<n>` on stderr, as `serve` prints it for a test harness.
    fn __failed(what: Str, e: NetError) -> HttpError {
        let why = match e {
            NetError.Interrupted => "interrupted".to_string(),
            NetError.Other(code) => f"os error {code}",
            NetError.AddrInUse => "address in use".to_string(),
            NetError.ConnectionRefused => "connection refused".to_string(),
            NetError.PermissionDenied => "permission denied".to_string(),
            NetError.TimedOut => "timed out".to_string(),
            NetError.WouldBlock => "would block".to_string(),
            NetError.InvalidInput => "invalid input".to_string(),
            NetError.Tls(_) => "TLS failure".to_string(),
            NetError.Protocol => "protocol error".to_string(),
            NetError.ProviderUnavailable => "provider unavailable".to_string(),
            NetError.Unsupported => "unsupported".to_string(),
            NetError.UnexpectedEof => "unexpected end of stream".to_string(),
        };
        HttpError { message: f"{what}: {why}" }
    }

    // Makes the request at the start of `buf` the running task's current
    // one, which `Request`'s methods read: the bytes it took, 0 when `buf`
    // holds no whole request yet (and `eof` says more may come; -100 when
    // the client also waits for a `100 Continue`), -1 when the connection
    // holds no request, or minus the status (400, 413, 431, 501) of the
    // answer to one the server refuses (src/http1.rs `Progress::install`).
    #[compiler_builtin]
    fn __install(buf: Slice[u8], eof: bool) -> i64 {
        -1
    }

    // How many bytes `buf` must hold before `__install` can give another
    // answer for the request it is reading.
    #[compiler_builtin]
    fn __need() -> i64 {
        0
    }

    // How long the next read for the current connection may wait, in ms:
    // positive between requests, negative inside one.
    #[compiler_builtin]
    fn __wait_ms() -> i64 {
        0
    }

    // Whether the current request keeps its connection open for the next.
    #[compiler_builtin]
    fn __keep_alive() -> bool {
        false
    }

    // `resp` as the bytes of an HTTP/1.1 response to the current request,
    // with its headers when its type has them.
    #[compiler_builtin]
    fn __wire(resp: Response) -> Vec[u8] {
        Vec.new()
    }

    // A 200 with `body`, as `__wire` writes it.
    #[compiler_builtin]
    fn __wire_fixed(body: Str) -> Vec[u8] {
        Vec.new()
    }
}
