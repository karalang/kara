// A built-in type's method named as a value (design.md § Function values:
// `T.m` is a function whose first parameter is the receiver), for the
// methods the compiler implements natively and so has no body to name:
// the checker types `i64.abs` as `method_value_i64_abs` and the MIR builder
// lowers it to that function, which behaves as a function of the same
// signature written by hand would (B-2026-11-24-7). A method with no entry
// here is refused with the closure to write instead.

fn method_value_i8_abs(x: i8) -> i8 {
    x.abs()
}

fn method_value_i16_abs(x: i16) -> i16 {
    x.abs()
}

fn method_value_i32_abs(x: i32) -> i32 {
    x.abs()
}

fn method_value_i64_abs(x: i64) -> i64 {
    x.abs()
}

fn method_value_i128_abs(x: i128) -> i128 {
    x.abs()
}

fn method_value_i8_to_string(x: i8) -> String {
    x.to_string()
}

fn method_value_i16_to_string(x: i16) -> String {
    x.to_string()
}

fn method_value_i32_to_string(x: i32) -> String {
    x.to_string()
}

