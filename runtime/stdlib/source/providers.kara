// runtime/stdlib/source/providers.kara
//
// The program-rooted resources on the v2 pipeline (core-semantics §14.7,
// §14.10; B-2026-10-20-11): `Env`, `Clock`, `RandomSource` and the
// standard streams `Stdout`, `Stderr` and `Stdin`, each with a library
// provider trait (runtime/stdlib/io.kara) and a default provider, a static
// value of a type below. A call on a resource outside any `with_provider`
// uses the default; inside `with_provider[Env](fake, || ..)` it uses `fake`.
//
// The defaults' methods are the operating system's. The interpreter keeps
// them as natives of the ambient resource they serve (`Env.var`, ...); the
// compiled backend reaches the same runtime calls.

struct OsEnv {}

impl EnvProvider for OsEnv {
    #[compiler_builtin]
    fn args(ref self) -> Vec[String] { Vec.new() }

    #[compiler_builtin]
    fn var(ref self, name: Str) -> Result[String, VarError] { Err(VarError.NotPresent) }

    #[compiler_builtin]
    fn set(mut ref self, name: Str, value: Str) { }
}

struct OsClock {}

impl ClockProvider for OsClock {
    #[compiler_builtin]
    fn now(ref self) -> i64 { 0 }

    #[compiler_builtin]
    fn monotonic_ns(ref self) -> i64 { 0 }

    #[compiler_builtin]
    fn wall_ns(ref self) -> i64 { 0 }
}

struct OsRandom {}

impl RandomProvider for OsRandom {
    #[compiler_builtin]
    fn next_u64(mut ref self) -> u64 { 0 }
}

struct OsStdout {}

impl StdoutProvider for OsStdout {
    #[compiler_builtin]
    fn write(mut ref self, s: Str) { }

    #[compiler_builtin]
    fn flush(mut ref self) { }
}

struct OsStderr {}

impl StderrProvider for OsStderr {
    #[compiler_builtin]
    fn write(mut ref self, s: Str) { }

    #[compiler_builtin]
    fn flush(mut ref self) { }
}

struct OsStdin {}

impl StdinProvider for OsStdin {
    #[compiler_builtin]
    fn read_line(mut ref self) -> Result[String, IoError] { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn read_to_string(mut ref self) -> Result[String, IoError] { Err(IoError.Other("placeholder")) }
}

effect resource Env: EnvProvider = OsEnv {};
effect resource Clock: ClockProvider = OsClock {};
effect resource RandomSource: RandomProvider = OsRandom {};
effect resource Stdout: StdoutProvider = OsStdout {};
effect resource Stderr: StderrProvider = OsStderr {};
effect resource Stdin: StdinProvider = OsStdin {};
