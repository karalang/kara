// runtime/stdlib/source/providers.kara
//
// The program-rooted resources on the v2 pipeline (core-semantics §14.7,
// §14.10; B-2026-10-20-11): `Env`, `Clock`, `RandomSource` and the
// standard streams `Stdout`, `Stderr` and `Stdin`, and `FileSystem`'s path
// operations (§14.11), each with a library
// provider trait (runtime/stdlib/io.kara) and a default provider, a static
// value of a type below. A call on a resource outside any `with_provider`
// uses the default; inside `with_provider[Env](fake, || ..)` it uses `fake`.
//
// The defaults' methods are the operating system's. The interpreter keeps
// them as natives of the ambient resource they serve (`Env.var`, ...); the
// compiled backend reaches the same runtime calls.

struct OsEnv {}

impl EnvProvider for OsEnv {
    #[compiler_builtin]
    fn args(ref self) -> Vec[String] { Vec.new() }

    #[compiler_builtin]
    fn var(ref self, name: Str) -> Result[String, VarError] { Err(VarError.NotPresent) }

    #[compiler_builtin]
    fn set(mut ref self, name: Str, value: Str) { }
}

struct OsClock {}

impl ClockProvider for OsClock {
    #[compiler_builtin]
    fn now(ref self) -> i64 { 0 }

    #[compiler_builtin]
    fn monotonic_ns(ref self) -> i64 { 0 }

    #[compiler_builtin]
    fn wall_ns(ref self) -> i64 { 0 }
}

struct OsRandom {}

impl RandomProvider for OsRandom {
    #[compiler_builtin]
    fn next_u64(mut ref self) -> u64 { 0 }
}

struct OsStdout {}

impl StdoutProvider for OsStdout {
    #[compiler_builtin]
    fn write(mut ref self, s: Str) { }

    #[compiler_builtin]
    fn flush(mut ref self) { }
}

struct OsStderr {}

impl StderrProvider for OsStderr {
    #[compiler_builtin]
    fn write(mut ref self, s: Str) { }

    #[compiler_builtin]
    fn flush(mut ref self) { }
}

struct OsStdin {}

impl StdinProvider for OsStdin {
    #[compiler_builtin]
    fn read_line(mut ref self) -> Result[String, IoError] { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn read_to_string(mut ref self) -> Result[String, IoError] { Err(IoError.Other("placeholder")) }
}

struct OsFileSystem {}

impl FileSystemProvider for OsFileSystem {
    #[compiler_builtin]
    fn read_to_string(ref self, path: Str) -> Result[String, IoError] { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn read_lines(ref self, path: Str) -> Result[Vec[String], IoError] { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn exists(ref self, path: Str) -> bool { false }

    #[compiler_builtin]
    fn metadata(ref self, path: Str) -> Result[Metadata, IoError] { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn read_dir(ref self, path: Str) -> Result[Vec[String], IoError] { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn read_bytes(ref self, path: Str) -> Result[Vec[u8], IoError] { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn read_link(ref self, path: Str) -> Result[String, IoError] { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn symlink_metadata(ref self, path: Str) -> Result[Metadata, IoError] { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn write(mut ref self, path: Str, contents: Str) -> Result[(), IoError] { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn create_dir(mut ref self, path: Str) -> Result[(), IoError] { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn create_dir_all(mut ref self, path: Str) -> Result[(), IoError] { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn remove_file(mut ref self, path: Str) -> Result[(), IoError] { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn remove_dir(mut ref self, path: Str) -> Result[(), IoError] { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn remove_dir_all(mut ref self, path: Str) -> Result[(), IoError] { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn rename(mut ref self, from: Str, to: Str) -> Result[(), IoError] { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn copy(mut ref self, from: Str, to: Str) -> Result[i64, IoError] { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn write_bytes(mut ref self, path: Str, content: Slice[u8]) -> Result[(), IoError] { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn symlink(mut ref self, target: Str, link: Str) -> Result[(), IoError] { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn set_permissions(mut ref self, path: Str, mode: i64) -> Result[(), IoError] { Err(IoError.Other("placeholder")) }

    #[compiler_builtin]
    fn set_modified(mut ref self, path: Str, ms: i64) -> Result[(), IoError] { Err(IoError.Other("placeholder")) }
}

effect resource Env: EnvProvider = OsEnv {};
effect resource Clock: ClockProvider = OsClock {};
effect resource RandomSource: RandomProvider = OsRandom {};
effect resource Stdout: StdoutProvider = OsStdout {};
effect resource Stderr: StderrProvider = OsStderr {};
effect resource Stdin: StdinProvider = OsStdin {};
effect resource FileSystem: FileSystemProvider = OsFileSystem {};
