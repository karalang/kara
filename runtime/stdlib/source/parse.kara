// `ParseError` and the `Result` of a number type's `parse`, as Kāra
// (docs/library/core-types.md § Parsing; B-2026-10-12-6).
//
// The number natives answer `Option[T]`; the MIR builder hands that answer
// and the input to one of the `parse_result_*` functions below, which says
// what went wrong when there is no number. Only a failed parse reads the
// input again.

/// Why a number type's `parse` found no number.
enum ParseError {
    /// The input is empty.
    Empty,
    /// The input holds a character that cannot appear in a number of this type.
    InvalidDigit,
    /// The value is above the type's maximum.
    Overflow,
    /// The value is below the type's minimum.
    Underflow,
    /// Any other malformed input.
    Invalid,
}

impl Display for ParseError {
    fn to_string(ref self) -> String {
        match self {
            ParseError.Empty => "cannot parse a number from an empty string",
            ParseError.InvalidDigit => "invalid digit found in string",
            ParseError.Overflow => "number too large to fit in target type",
            ParseError.Underflow => "number too small to fit in target type",
            ParseError.Invalid => "invalid number",
        }
    }
}

/// An integer type's `parse`: `o` is the native's answer for `s`.
fn parse_result_int[T](o: own Option[T], s: Str, signed: bool) -> Result[T, ParseError] {
    match o {
        Some(n) => Ok(n),
        None => Err(parse_int_error(s, signed)),
    }
}

/// A float type's `parse`: `o` is the native's answer for `s`.
fn parse_result_float[T](o: own Option[T], s: Str) -> Result[T, ParseError] {
    match o {
        Some(n) => Ok(n),
        None => {
            if parse_blank(s) {
                Err(ParseError.Empty)
            } else {
                Err(ParseError.Invalid)
            }
        }
    }
}

/// Why `s` holds no integer of a type that fits: an empty input, a
/// character that is not a digit, or digits past the type's range. The
/// whitespace `parse` ignores around the number is ignored here too, so
/// `"   "` is `Empty` and `" -1 "` for an unsigned type is `Underflow`
/// (B-2026-11-13-21). One pass over the chars, testing with `parse_space`
/// rather than `s.trim()` or `c.is_whitespace()`: their natives would link
/// std's panic hook into every program that parses
/// (tests/mir_panic_free_natives.rs).
fn parse_int_error(s: Str, signed: bool) -> ParseError {
    let mut negative = false;
    let mut digits = 0;
    let mut nonzero = false;
    let mut started = false;
    let mut ended = false;
    for c in s.chars() {
        if parse_space(c) {
            if started {
                ended = true;
            }
        } else if ended {
            return ParseError.InvalidDigit;
        } else if not started and (c == '+' or c == '-') {
            started = true;
            negative = c == '-';
        } else if c < '0' or c > '9' {
            return ParseError.InvalidDigit;
        } else {
            started = true;
            digits += 1;
            if c != '0' {
                nonzero = true;
            }
        }
    }
    if not started {
        ParseError.Empty
    } else if digits == 0 {
        ParseError.InvalidDigit
    } else if negative and (signed or nonzero) {
        ParseError.Underflow
    } else if negative {
        // `-0` is no value below the minimum, and an integer never reports
        // `Invalid`: the `-` is the character that cannot appear.
        ParseError.InvalidDigit
    } else {
        ParseError.Overflow
    }
}

/// `s` holds nothing but whitespace (or nothing at all).
fn parse_blank(s: Str) -> bool {
    for c in s.chars() {
        if not parse_space(c) {
            return false;
        }
    }
    true
}

/// `c` has Unicode's White_Space property, the set Rust's `str::trim` strips
/// and so the set the parse natives ignore around a number.
fn parse_space(c: char) -> bool {
    (c >= '\u{9}' and c <= '\u{d}')
        or c == ' '
        or c == '\u{85}'
        or c == '\u{a0}'
        or c == '\u{1680}'
        or (c >= '\u{2000}' and c <= '\u{200a}')
        or c == '\u{2028}'
        or c == '\u{2029}'
        or c == '\u{202f}'
        or c == '\u{205f}'
        or c == '\u{3000}'
}
