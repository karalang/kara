// The ranges `a..b` and `a..=b` as values, as Kāra (redesign A2;
// docs/library/iterators.md).
//
// The MIR pipeline appends this file to the program, and the checker types
// the range syntax as these structs. A `for` loop straight over a range
// literal is lowered as a counting loop and never builds one; a range held,
// passed or adapted (`(0..n).rev()`) is one of these. The legacy backends do
// not read it.

/// A type a range counts through, one step at a time.
trait RangeStep {
    /// The next value up.
    fn step_forward(ref self) -> Self;

    /// The next value down.
    fn step_backward(ref self) -> Self;

    /// The value `n` steps up, or `None` when that passes `end`; `self`
    /// is at most `end`. Lets `step_by` over a range jump rather than walk.
    fn step_forward_within(ref self, n: i64, end: ref Self) -> Option[Self];

    /// The last value `self + k * step` (`k >= 0`) that is at most `end`;
    /// `self` is at most `end` and `step` is positive. Lets `step_by` over
    /// a range walk back from where it would end.
    fn last_step_within(ref self, step: i64, end: ref Self) -> Self;
}

impl RangeStep for i8 {
    fn step_forward(ref self) -> i8 {
        self + 1
    }

    fn step_backward(ref self) -> i8 {
        self - 1
    }

    fn step_forward_within(ref self, n: i64, end: ref i8) -> Option[i8] {
        let to = (self as i128) + (n as i128);
        if to > (end as i128) {
            return None;
        }
        Some(to as i8)
    }

    fn last_step_within(ref self, step: i64, end: ref i8) -> i8 {
        let (s, n) = (self as i128, step as i128);
        (s + ((end as i128) - s) / n * n) as i8
    }
}

