}

// A char steps through the Unicode scalars, over the surrogate gap
// `0xD800..=0xDFFF` as Rust's `Step for char` does, so `'a'..='z'` counts
// the letters (kata 2083). Its ordinal closes the gap: a scalar above it
// counts `0x800` lower.
fn char_ordinal(c: char) -> i64 {
    let code = c as i64;
    if code >= 0xE000 { code - 0x800 } else { code }
}

fn char_of_ordinal(n: i64) -> char {
    let code = if n >= 0xD800 { n + 0x800 } else { n };
    char.try_from(code).unwrap()
}

impl RangeStep for char {
    fn step_forward(ref self) -> char {
        char_of_ordinal(char_ordinal(self) + 1)
    }

    fn step_backward(ref self) -> char {
        char_of_ordinal(char_ordinal(self) - 1)
    }

    fn step_forward_within(ref self, n: i64, end: ref char) -> Option[char] {
        let to = char_ordinal(self) + n;
        if to > char_ordinal(end) {
            return None;
        }
        Some(char_of_ordinal(to))
    }

    fn last_step_within(ref self, step: i64, end: ref char) -> char {
        let s = char_ordinal(self);
        char_of_ordinal(s + (char_ordinal(end) - s) / step * step)
    }
}

/// The values from `start` up to, but not including, `end`. A range is a
/// pair of bounds, so it copies like one: `for i in r { for j in r {..} }`
/// walks `r` twice.
#[derive(Copy, Clone)]
struct Range[T] {
    start: T,
    end: T,
}

impl[T: RangeStep + PartialOrd + Copy] Iterator for Range[T] {
    type Item = T;

    fn next(mut ref self) -> Option[T] {
        if self.start >= self.end {
            return None;
        }
        let v = self.start;
        self.start = v.step_forward();
        Some(v)
    }

    fn advance_by(mut ref self, n: i64) -> bool {
        if n <= 0 {
            return true;
        }
        if self.start >= self.end {
            return false;
        }
        match self.start.step_forward_within(n, self.end) {
            Some(v) => {
                self.start = v;
                true
            }
            None => {
                self.start = self.end;
                false
            }
        }
    }
}

impl[T: RangeStep + PartialOrd + Copy] DoubleEndedIterator for Range[T] {
    fn next_back(mut ref self) -> Option[T] {
        if self.start >= self.end {
            return None;
        }
        self.end = self.end.step_backward();
        Some(self.end)
    }
}

impl[T: PartialOrd + Copy] Range[T] {
    /// The range itself: a range is already an iterator.
    fn iter(ref self) -> Range[T] {
        self
    }

    /// Whether `x` lies in the range.
    fn contains(ref self, x: ref T) -> bool {
        *x >= self.start and *x < self.end
    }

    /// Whether the range holds no values.
    fn is_empty(ref self) -> bool {
        not (self.start < self.end)
    }
}

/// The values from `start` up to and including `end`.
#[derive(Copy, Clone)]
struct RangeInclusive[T] {
    start: T,
    end: T,
    /// Set once the last value has been given out, since `start` cannot step
    /// past `end` when `end` is the type's largest value.
    exhausted: bool,
}

impl[T: RangeStep + PartialOrd + Copy] Iterator for RangeInclusive[T] {
    type Item = T;

    fn next(mut ref self) -> Option[T] {
        if self.exhausted or self.start > self.end {
            return None;
        }
        let v = self.start;
        if v >= self.end {
            self.exhausted = true;
        } else {
            self.start = v.step_forward();
        }
        Some(v)
    }

    fn advance_by(mut ref self, n: i64) -> bool {
        if n <= 0 {
            return true;
        }
        if self.exhausted or self.start > self.end {
            return false;
        }
        match self.start.step_forward_within(n, self.end) {
            Some(v) => {
                self.start = v;
                true
            }
            None => {
                // Exactly the values left is still a full advance.
                let exact = match self.start.step_forward_within(n - 1, self.end) {
                    Some(v) => v == self.end,
                    None => false,
                };
                self.exhausted = true;
                exact
            }
        }
    }
}

impl[T: RangeStep + PartialOrd + Copy] DoubleEndedIterator for RangeInclusive[T] {
    fn next_back(mut ref self) -> Option[T] {
        if self.exhausted or self.start > self.end {
            return None;
        }
        let v = self.end;
        if v <= self.start {
            self.exhausted = true;
        } else {
            self.end = v.step_backward();
        }
        Some(v)
    }
}

impl[T: RangeStep + PartialOrd + Copy] DoubleEndedIterator for IterStepBy[Range[T]] {
    /// `(0..n).step_by(k).rev()`: a step over a range walks back from the last
    /// value it reaches, `start + j * k`, and shrinks the range's end past it,
    /// so both ends of one step meet in the middle (B-2026-11-05-35).
    fn next_back(mut ref self) -> Option[T] {
        if self.it.start >= self.it.end {
            return None;
        }
        // The value the step gives next: the start until the first is
        // given out, then the one `step - 1` on.
        let from = if self.first {
            self.it.start
        } else {
            match self.it.start.step_forward_within(self.step - 1, self.it.end) {
                Some(v) => v,
                None => return None,
            }
        };
        if from >= self.it.end {
            return None;
        }
        let last = from.last_step_within(self.step, self.it.end.step_backward());
        self.it.end = last;
        Some(last)
    }
}

impl[T: RangeStep + PartialOrd + Copy] DoubleEndedIterator for IterStepBy[RangeInclusive[T]] {
    fn next_back(mut ref self) -> Option[T] {
        if self.it.exhausted or self.it.start > self.it.end {
            return None;
        }
        let from = if self.first {
            self.it.start
        } else {
            match self.it.start.step_forward_within(self.step - 1, self.it.end) {
                Some(v) => v,
                None => return None,
            }
        };
        let last = from.last_step_within(self.step, self.it.end);
        if last == from {
            self.it.exhausted = true;
        } else {
            self.it.end = last.step_backward();
        }
        Some(last)
    }
}

impl[T: PartialOrd + Copy] RangeInclusive[T] {
    /// The range itself: a range is already an iterator.
    fn iter(ref self) -> RangeInclusive[T] {
        self
    }

    /// Whether `x` lies in the range.
    fn contains(ref self, x: ref T) -> bool {
        *x >= self.start and *x <= self.end
    }

    /// Whether the range holds no values.
    fn is_empty(ref self) -> bool {
        self.exhausted or self.start > self.end
    }
}

/// The values from `start` up, with no end: `(1..).take(3)`. It stops only
/// when something stops asking. The type's largest value is in the range;
/// asking for the one after it overflows the way `+ 1` does.
#[derive(Copy, Clone)]
struct RangeFrom[T] {
    start: T,
    /// Set once `start` has been given out: the next call steps first, so
    /// giving out the largest value does not overflow (B-2026-11-05-20).
    given: bool,
}

impl[T: RangeStep + PartialOrd + Copy] Iterator for RangeFrom[T] {
    type Item = T;

    fn next(mut ref self) -> Option[T] {
        if self.given {
            self.start = self.start.step_forward();
        }
        self.given = true;
        Some(self.start)
    }
}

impl[T: PartialOrd + Copy] RangeFrom[T] {
    /// The range itself: a range is already an iterator.
    fn iter(ref self) -> RangeFrom[T] {
        self
    }

    /// Whether `x` lies in the range: from `start` up, or past it once
    /// `start` has been given out.
    fn contains(ref self, x: ref T) -> bool {
        if self.given {
            *x > self.start
        } else {
            *x >= self.start
        }
    }
}

/// The values below `end`: `..n`. It has no start, so it is not an
/// iterator; it is a slice index (`items[..n]`) and a bound to test
/// against (design.md § 6).
#[derive(Copy, Clone)]
struct RangeTo[T] {
    end: T,
}

impl[T: PartialOrd + Copy] RangeTo[T] {
    /// Whether `x` lies in the range.
    fn contains(ref self, x: ref T) -> bool {
        *x < self.end
    }
}

/// The values up to and including `end`: `..=n`. Like `RangeTo`, it is not
/// an iterator.
#[derive(Copy, Clone)]
struct RangeToInclusive[T] {
    end: T,
}

impl[T: PartialOrd + Copy] RangeToInclusive[T] {
    /// Whether `x` lies in the range.
    fn contains(ref self, x: ref T) -> bool {
        *x <= self.end
    }
}

/// Every value: `..`. It names a whole sequence as a slice index
/// (`items[..]`).
#[derive(Copy, Clone)]
struct RangeFull {}
