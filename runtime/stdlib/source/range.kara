    }

    fn step_backward(ref self) -> u128 {
        self - 1
    }

    fn step_forward_within(ref self, n: i64, end: ref u128) -> Option[u128] {
        if end - self < n as u128 {
            return None;
        }
        Some(self + n as u128)
    }
}

impl RangeStep for usize {
    fn step_forward(ref self) -> usize {
        self + 1
