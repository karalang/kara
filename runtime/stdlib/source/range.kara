impl RangeStep for i128 {
    fn step_forward(ref self) -> i128 {
        self + 1
    }

    fn step_backward(ref self) -> i128 {
        self - 1
    }

    fn step_forward_within(ref self, n: i64, end: ref i128) -> Option[i128] {
        if (end.wrapping_sub(self) as u128) < n as u128 {
            return None;
        }
        Some(self + n as i128)
    }
}

