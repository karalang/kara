        self + 1
    }

    fn step_backward(ref self) -> u128 {
        self - 1
    }

    fn step_forward_within(ref self, n: i64, end: ref u128) -> Option[u128] {
        if end - self < n as u128 {
            return None;
        }
        Some(self + n as u128)
    }

    fn last_step_within(ref self, step: i64, end: ref u128) -> u128 {
        let n = step as u128;
        self + (end - self) / n * n
    }
}

