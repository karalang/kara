// Channels, as Kāra (docs/library/concurrency.md § Channels).
//
// The MIR pipeline appends this file to the program. The ends' own methods
// (`send`, `try_send`, `recv`, `try_recv`, `clone`) are natives of the MIR
// backends; what is written here is what composes them. The legacy backends
// do not read it.

/// A channel holding at most `cap` values in flight: `send` waits while it
/// is full. `cap` is at least 1.
#[allow(deprecated)]
pub fn channel[T](cap: i64) -> (Sender[T], Receiver[T]) {
    if cap < 1 {
        panic("a channel holds at least 1 value")
    }
    Channel.bounded(cap)
}

/// The values a receiver takes, in the order they were sent, until every
/// sender is gone and the channel is empty.
struct ReceiverIter[T] {
    rx: Receiver[T],
}

impl[T] Iterator for ReceiverIter[T] {
    type Item = T;

    fn next(mut ref self) -> Option[Self.Item] {
        self.rx.recv()
    }
}

// A receiver has nothing to lend, so it is `IntoIterator` and not
// iterated by `for` (design.md § `Iterator` and `Iterable`).
impl[T] IntoIterator for Receiver[T] {
    type Item = T;

    /// The values received, until the channel is closed and drained.
    fn into_iter(own self) -> ReceiverIter[T] {
        ReceiverIter { rx: self }
    }
}

impl[T] Receiver[T] {
    // Whether every sender is gone. A native of each MIR backend.
    #[compiler_builtin]
    fn __closed(ref self) -> bool {
        self.__closed()
    }
}

/// Why `Receiver.recv_timeout` gave no value (core-semantics §11.11).
pub enum RecvTimeoutError {
    /// Every sender is gone and the channel is drained.
    Closed,
    /// The timeout passed first.
    TimedOut,
}

/// Why `Sender.send_timeout` did not send, with the value it hands back.
pub enum SendTimeoutError[T] {
    /// No receiver is left.
    Closed(T),
    /// The timeout passed first.
    TimedOut(T),
}

// What a `select` stands for (core-semantics §11.11): `select_desugar.rs`
// writes the calls.

// A receive arm's result slot, empty.
fn __select_recv_none[T](rx: ref Receiver[T]) -> Option[Option[T]] {
    None
}

// The receive, tried without waiting: `None` while the arm is not ready,
// else what `recv` gives, `None` once every sender is gone and the channel
// is drained. A closed channel takes no more values, so the second
// `try_recv` is the answer.
fn __select_recv[T](rx: ref Receiver[T]) -> Option[Option[T]] {
    match rx.try_recv() {
        Some(v) => Some(Some(v)),
        None => if rx.__closed() { Some(rx.try_recv()) } else { None },
    }
}

// A send arm's result slot, empty.
fn __select_send_none[T](tx: ref Sender[T]) -> Option[Result[(), SendError[T]]] {
    None
}

// The send of the value in `slot`, tried without waiting: `None`, with the
// value back in `slot`, while the channel is full, else what `send` gives,
// the value then gone from `slot`.
fn __select_send[T](tx: ref Sender[T], slot: mut ref Option[T]) -> Option[Result[(), SendError[T]]] {
    match slot.take() {
        Some(v) => match tx.try_send(v) {
            Err(SendError.Full(v)) => {
                *slot = Some(v);
                None
            }
            r => Some(r),
        },
        None => None,
    }
}

// A count every channel operation that changes a channel (a value sent or
// received, an end dropped) moves on. A native of each MIR backend.
#[compiler_builtin]
fn __select_epoch() -> i64 {
    0
}

// Waits until the count has moved past `epoch` or the monotonic clock
// reads `until` (-1: no deadline), so a `select` with no arm ready tries
// its arms again. Outside a task nothing else can move the count, so the
// wait is for the deadline, and with none the program is deadlocked. A
// native of each MIR backend.
#[compiler_builtin]
fn __select_park(epoch: i64, until: i64) with suspends {}

// Whether the monotonic clock has reached `at`: an `after` arm is ready.
fn __select_due(at: i64) -> bool with reads(Clock) {
    Clock.monotonic_ns() >= at
}


/// What `m.lock()` returns (docs/library/concurrency.md § `Mutex[T]`):
/// `value` is the protected value, and the guard releases the mutex when
/// it drops, so every exit from its scope (`return`, `break`, `?`)
/// releases it. A `lock m x { ... }` block is a guard in a scope of its
/// own.
pub struct MutexGuard[T] {
    pub value: mut ref T,
    mutex: ref Mutex[T],
}

impl[T] Mutex[T] {
    /// Waits until no other task holds the mutex, then returns its guard.
    fn lock(ref self) -> MutexGuard[T] with blocks {
        MutexGuard { value: self.acquire(), mutex: self }
    }

    // Waits until no other task holds the mutex, marks it held and returns
    // the protected value. A native of each MIR backend.
    #[compiler_builtin]
    fn acquire(ref self) -> mut ref T with blocks {
        self.acquire()
    }

    // Clears the mark `acquire` set, for the next waiting task.
    #[compiler_builtin]
    fn release(ref self) {}
}

impl[T] Drop for MutexGuard[T] {
    fn drop(mut ref self) {
        self.mutex.release();
    }
}
