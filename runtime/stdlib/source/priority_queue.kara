// `PriorityQueue[T: Ord]` as the MIR pipeline reads it (redesign A2):
// a copy of `../priority_queue.kara` whose `peek` returns the spec's
// `Option[ref T]`, a view of the root, where the baked copy has to clone
// it (a legacy body cannot build a borrow-carrying `Option`). The legacy
// backends still compile `../priority_queue.kara`. The two copies become
// one file when the legacy pipeline is deleted (M3), as `ordering.kara`'s
// do.
//
// runtime/stdlib/priority_queue.kara
//
// `PriorityQueue[T: Ord]` — a `Vec[T]`-backed binary heap.
// Phase 11 § General-purpose collections.
//
// **Why `PriorityQueue` and not `BinaryHeap`.** Rust names its
// collections after their IMPLEMENTATION (`HashMap`, `BTreeMap`,
// `BinaryHeap`) so the performance profile is visible at the use site.
// Kāra does not: it ships `Map` and `Set`, not `HashMap` / `HashSet`,
// and qualifies only when there is a real choice to make (`SortedMap`).
// `BinaryHeap` would be the one implementation-named collection in the
// stdlib. `PriorityQueue` is also the ADT name, so it survives an
// implementation change — a later pairing or d-ary heap can back this
// same type, where `BinaryHeap` would become a lie. The cost of an ADT
// name is that the complexity profile is no longer in it, so it is
// stated here instead:
//
//     push / pop      O(log n)
//     peek / len      O(1)      — `peek` COPIES the root; see its note
//     from            O(n)      — Floyd heapify, not n pushes
//     into_sorted_vec O(n log n)
//     decrease-key    NOT PROVIDED — no handle is returned by `push`.
//     merge           NOT PROVIDED — no better than push-each here.
//
// A caller who needs decrease-key (the textbook Dijkstra bound) or a
// cheap meld wants a Fibonacci or pairing heap, which this is not.
//
// **This module is written in Kāra, with real bodies.** Every other
// collection (`Vec`, `Map`, `Set`, `VecDeque`, `SortedMap`, `SortedSet`)
// is a `#[compiler_builtin]` signature stub backed by a Rust
// implementation, because each of those owns a runtime representation —
// a hash table, a B-tree, a ring buffer. A binary heap owns none: with
// exactly two children per node the tree is index arithmetic over a flat
// array (children of `i` at `2i+1` / `2i+2`), so it is a `Vec[T]` plus
// comparisons. A Rust twin would buy nothing the monomorphized `Vec[T]`
// does not already give, and would put a third copy of the sift
// algorithm (interpreter + codegen + runtime) where the language can
// express one. The bodies below compile through the baked-stdlib path
// (`lower_stdlib_source` → `declare_stdlib_program` /
// `compile_stdlib_program`, `src/codegen.rs`), the same path `Ordering`,
// `protobuf`, `process` and `cli` already use for their non-builtin
// bodies.
//
// **Direction: SMALLEST FIRST by default.** `PriorityQueue.new()` pops
// the smallest element; `PriorityQueue.max_first()` is the sibling that
// pops the largest. This is the natural reading of a priority queue —
// lowest priority number served first — and it matches Java's
// `PriorityQueue` and Python's `heapq`. (Rust's `BinaryHeap` is
// max-first, but that default is only workable there because
// `std::cmp::Reverse` makes the other direction cheap; Kāra has no such
// wrapper, and all five hand-rolled heaps in the kata corpus want
// smallest-first.) The direction is a FIELD rather than two types, so a
// queue can be handed to a generic consumer without the direction
// entering its signature.
//
// Ordering is `T: Ord` on the impl block. The sifts compare elements in
// place or against the one element they carry in a hole, so a non-`Copy`
// `T` (`String`, a nested `Vec`) is never cloned to be compared.

struct PriorityQueue[=T] {
    xs: Vec[T],
    max: bool,
}

impl[T: Ord] PriorityQueue[T] {
    // An empty queue that pops the SMALLEST element first.
    fn new() -> PriorityQueue[T] {
        PriorityQueue { xs: Vec.new(), max: false }
    }

    // An empty queue that pops the LARGEST element first.
    fn max_first() -> PriorityQueue[T] {
        PriorityQueue { xs: Vec.new(), max: true }
    }

    // Build a smallest-first queue from an existing vector in O(n) —
    // Floyd's heapify, sifting down from the last internal node rather
    // than pushing n times (which would be O(n log n)).
    fn from(v: own Vec[T]) -> PriorityQueue[T] {
        let mut h = PriorityQueue { xs: v, max: false };
        h.heapify();
        h
    }

    // `from`'s largest-first sibling, same O(n) build.
    fn max_first_from(v: own Vec[T]) -> PriorityQueue[T] {
        let mut h = PriorityQueue { xs: v, max: true };
        h.heapify();
        h
    }

    // Restore the heap property over the whole backing vector in O(n).
    // Starts at the last internal node: every later index is a leaf, and
    // a leaf is trivially a valid heap of one.
    fn heapify(mut ref self) {
        let n = self.xs.len();
        let mut i = n / 2 - 1;
        while i >= 0 {
            self.sift_down(i);
            i = i - 1;
        }
    }

    fn len(ref self) -> i64 {
        self.xs.len()
    }

    fn is_empty(ref self) -> bool {
        self.xs.len() == 0
    }

    fn clear(mut ref self) {
        self.xs.clear();
    }

    // `Vec.swap` rather than the read-and-reassign spelling: exchanging two
    // elements through index reads (`let t = xs[i]; xs[i] = xs[j]; xs[j] = t`)
    // is the form design.md § "The index operator (`expr[i]`)" rejects for a
    // non-`Copy` `T`, and `T` here is unconstrained. It also ran the wrong
    // number of `Drop` bodies (B-2026-08-26-21): the two backends disagreed on
    // whether such a store destroys or relocates the displaced element.
    // `swap` has ONE meaning — both values stay live, so no body runs — and
    // both backends now implement it identically.
    fn swap(mut ref self, i: i64, j: i64) {
        self.xs.swap(i, j);
    }

    // Sift the element at `start` up toward the root until the heap
    // property holds above it.
    fn sift_up(mut ref self, start: i64) {
        pq_sift_up(mut self.xs, 0, start, self.max);
    }

    // Sift the element at `start` down until the heap property holds
    // below it.
    fn sift_down(mut ref self, start: i64) {
        pq_sift_down(mut self.xs, start, self.max);
    }

    fn push(mut ref self, x: own T) {
        self.xs.push(x);
        let n = self.xs.len();
        self.sift_up(n - 1);
    }

    // Read the next element WITHOUT removing it — the smallest of a
    // smallest-first queue, the largest of a largest-first one — or
    // `None` when empty. Both directions keep their winner at the root,
    // and the root of a heap is always index 0, so this is one indexing
    // operation and no comparisons.
    //
    // A view of the root, as docs/library/collections.md gives it
    // (`Option[ref T]`): `Vec.get` borrows it out of the backing vector,
    // so nothing is copied.
    fn peek(ref self) -> Option[ref T] {
        self.xs.get(0)
    }

    // Remove and return the next element — the smallest of a
    // smallest-first queue, the largest of a largest-first one — or
    // `None` when empty. Swaps the root to the end so the pop is O(1) on
    // the backing vector, then sifts the replacement root down to the
    // bottom and back up (`sift_down_to_bottom`).
    fn pop(mut ref self) -> Option[T] {
        let n = self.xs.len();
        if n == 0 {
            return None;
        }
        self.swap(0, n - 1);
        let top = self.xs.pop();
        self.sift_down_to_bottom(0);
        top
    }

    // Floyd's pop, as Rust's `BinaryHeap::pop` and Python's `heapq` do
    // it: see `pq_sift_to_bottom`.
    fn sift_down_to_bottom(mut ref self, start: i64) {
        pq_sift_to_bottom(mut self.xs, start, self.max);
    }

    // Drain into a vector in pop order: ascending for a smallest-first
    // queue, descending for a largest-first one.
    fn into_sorted_vec(own self) -> Vec[T] {
        let mut h = self;
        let mut out: Vec[T] = Vec.new();
        while h.xs.len() > 0 {
            match h.pop() {
                Some(v) => {
                    out.push(v);
                }
                None => {}
            }
        }
        out
    }
}

// The sift loops work on a slice view of the backing vector rather than
// on `self.xs`: a slice's pointer and length are values, so a store into an
// element cannot change them and they stay in registers, where through
// `self` they were reloaded every level and each index was checked against
// the reloaded length (B-2026-11-08-10, kata 480). Each direction has its
// own loop, so `max` is tested once, not once a level.
//
// Each sift moves a hole, as Rust's `BinaryHeap` does, rather than swapping
// (B-2026-11-08-87): the element being sifted is read out once into `x`,
// each element it passes moves one level into the hole, and `x` is written
// into the slot where it settles. A swap a level moved three elements, and
// one of more than a word went through a stack slot. While the hole is
// open its slot holds a stale copy of the element that moved out of it, so
// the `defer` that fills it is the guard: a `cmp` that panics inside an
// isolating group (core-semantics §11.12) runs it at teardown, and the
// slice holds every element exactly once, as it did with the swaps. The
// hole itself is never compared.

// Sift the element at `from` up toward `start` until the heap property
// holds above it.
fn pq_sift_up[T: Ord](xs: mut Slice[T], start: i64, from: i64, max: bool) {
    let p: *mut T = ptr.mut(xs[from]);
    let base: *mut T = ptr.mut(xs[0]);
    let mut hole = from;
    // Safety: `from` is in bounds (indexed above). Its slot keeps the bits
    // until the defer below writes `x` back into the hole.
    let x = unsafe { p.read() };
    // Safety: `hole` is always an index on the path, in bounds, whose bits
    // were copied out; writing `x` there leaves each element in the slice
    // once.
    defer {
        unsafe {
            base.offset(hole).write(x);
        }
    }
    if max {
        while hole > start {
            let parent = (hole - 1) / 2;
            if x > xs[parent] {
                // Safety: `parent` was indexed in bounds above, and `hole`
                // holds a stale copy.
                unsafe {
                    base.offset(hole).write(base.offset(parent).read());
                }
                hole = parent;
            } else {
                break;
            }
        }
    } else {
        while hole > start {
            let parent = (hole - 1) / 2;
            if x < xs[parent] {
                // Safety: as above.
                unsafe {
                    base.offset(hole).write(base.offset(parent).read());
                }
                hole = parent;
            } else {
                break;
            }
        }
    }
}

// Sift the element at `start` down until the heap property holds below it:
// at each level the better child moves up into the hole if it outranks the
// element being sifted.
fn pq_sift_down[T: Ord](xs: mut Slice[T], start: i64, max: bool) {
    let n = xs.len();
    let p: *mut T = ptr.mut(xs[start]);
    let base: *mut T = ptr.mut(xs[0]);
    let mut hole = start;
    // Safety: as in `pq_sift_up`.
    let x = unsafe { p.read() };
    // Safety: as in `pq_sift_up`.
    defer {
        unsafe {
            base.offset(hole).write(x);
        }
    }
    let mut c = 2 * hole + 1;
    if max {
        while c < n {
            if c + 1 < n and xs[c + 1] > xs[c] {
                c = c + 1;
            }
            if xs[c] > x {
                // Safety: `c` was indexed in bounds above.
                unsafe {
                    base.offset(hole).write(base.offset(c).read());
                }
                hole = c;
                c = 2 * hole + 1;
            } else {
                break;
            }
        }
    } else {
        while c < n {
            if c + 1 < n and xs[c + 1] < xs[c] {
                c = c + 1;
            }
            if xs[c] < x {
                // Safety: as above.
                unsafe {
                    base.offset(hole).write(base.offset(c).read());
                }
                hole = c;
                c = 2 * hole + 1;
            } else {
                break;
            }
        }
    }
}

// Floyd's pop, as Rust's `BinaryHeap::pop` and Python's `heapq` do it:
// walk the hole at `start` down to a leaf along the better child, one
// comparison a level, then sift the element carried there back up, no
// higher than `start`. The element swapped into the root comes from the
// bottom and usually belongs near it, so this compares about half as often
// as `sift_down`, which tests both children against the element at every
// level (B-2026-11-04-55, kata 1046). On a tie the right child is taken, as
// `heapq` takes it. The child is picked by adding the comparison, which
// compiles to a conditional move rather than a branch on random keys.
fn pq_sift_to_bottom[T: Ord](xs: mut Slice[T], start: i64, max: bool) {
    let n = xs.len();
    if start >= n {
        return;
    }
    let p: *mut T = ptr.mut(xs[start]);
    let base: *mut T = ptr.mut(xs[0]);
    let mut hole = start;
    // Safety: as in `pq_sift_up`.
    let x = unsafe { p.read() };
    // Safety: as in `pq_sift_up`.
    defer {
        unsafe {
            base.offset(hole).write(x);
        }
    }
    let mut c = 2 * hole + 1;
    if max {
        while c + 1 < n {
            c = c + (xs[c] <= xs[c + 1]) as i64;
            // Safety: `c` and `c + 1` were indexed in bounds above.
            unsafe {
                base.offset(hole).write(base.offset(c).read());
            }
            hole = c;
            c = 2 * hole + 1;
        }
    } else {
        while c + 1 < n {
            c = c + (xs[c] >= xs[c + 1]) as i64;
            // Safety: as above.
            unsafe {
                base.offset(hole).write(base.offset(c).read());
            }
            hole = c;
            c = 2 * hole + 1;
        }
    }
    if c + 1 == n {
        // Safety: `c` is `n - 1`, the last slot.
        unsafe {
            base.offset(hole).write(base.offset(c).read());
        }
        hole = c;
    }
    if max {
        while hole > start {
            let parent = (hole - 1) / 2;
            if x > xs[parent] {
                // Safety: `parent` was indexed in bounds above.
                unsafe {
                    base.offset(hole).write(base.offset(parent).read());
                }
                hole = parent;
            } else {
                break;
            }
        }
    } else {
        while hole > start {
            let parent = (hole - 1) / 2;
            if x < xs[parent] {
                // Safety: as above.
                unsafe {
                    base.offset(hole).write(base.offset(parent).read());
                }
                hole = parent;
            } else {
                break;
            }
        }
    }
}

// "Every collection implements FromIterator" (docs/library/collections.md,
// Common traits): `collect` builds a smallest-first queue, as `from` does.
impl[T: Ord] FromIterator[T] for PriorityQueue[T] {
    fn from_iter[I: Iterator[Item = T]](iter: own I) -> PriorityQueue[T] {
        let mut it = iter;
        let mut v: Vec[T] = Vec.new();
        while let Some(x) = it.next() {
            v.push(x);
        }
        PriorityQueue.from(v)
    }
}
