// runtime/stdlib/runtime.kara
//
// Item (4) of the four-piece Debugger Contract per `design.md § AI-First
// Compiler Interface > Debugger Contract`. Slice 5 of the Phase 8
// auto-concurrency slate; closes out the contract by exposing the runtime
// introspection surface as Kāra-callable APIs.
//
// `Runtime` is an empty-marker type whose role is to host the three
// `#[compiler_builtin]` introspection methods at the canonical
// `Runtime.list_par_blocks()` / `Runtime.list_tasks()` /
// `Runtime.has_debug_metadata()` paths (matching the design.md `std.runtime::*`
// surface — Kāra's call syntax for module-path is `Module.fn()`, so the
// capitalized struct name plays the role of the module).
//
// Bodies are placeholder stubs; real dispatch fires through:
//   - codegen: `compile_assoc_call` adds three arms that emit calls into
//     runtime extern fns (`karac_runtime_has_debug_metadata`,
//     `karac_runtime_list_par_blocks_into`).
//   - interpreter: path-string match in `eval_call` returns empty/false
//     (the tree-walk interpreter has no `KaracFrame` / `ACTIVE_FRAMES`
//     state — degrades cleanly per design.md "try-then-degrade" contract).
//
// `ParBlockInfo` / `TaskInfo` / `WaitTarget` are the v1 contract surface.
// Once shipped, field names and types become stable per `design.md § Stability`;
// additive variant additions on `WaitTarget` (`PeerTask`, `IoHandle`) are
// non-breaking when Phase 6.3's network event loop ships, but field renames
// or type changes are major-version breaks.

// One row per active `par {}` block (design.md § Debugger contract,
// elements 1, 2 and 4; B-2026-11-05-34). `spawn_site_id` is the block's
// id, the same in every run of the binary: a hash of its `file:line:col`.
// `parent_task_id` is the task running the block (element 2): `main` is 1.
// `worker_locations` is where each branch starts, as `file:line`, in
// order (empty for a `par for`, whose workers share one body).
// The runtime writes these rows (`karac_mir_list_par_blocks`), and the
// backend refuses to compile a call to the list if this layout changes
// under it: fields may only be added at the end, with the runtime's row.
pub struct ParBlockInfo {
    spawn_site_id: u32,
    file: String,
    line: u32,
    col: u32,
    worker_count: u32,
    parent_task_id: u64,
    worker_locations: Vec[String],
}

// One row per suspended task (elements 2, 3 and 4): what it waits on, where
// it was spawned (`spawn_site_id`, `file`, `line`, `col`; zero and empty
// when the task was not spawned at a site the binary recorded), its own
// id, and the task whose group spawned it (`parent_task_id`, 0 for the
// root task, `main`). `EffectSummary` (design.md) is after v1: effect
// sets are not values yet, and adding the field later is additive.
pub struct TaskInfo {
    spawn_site_id: u32,
    wait_target: WaitTarget,
    file: String,
    line: u32,
    col: u32,
    task_id: u64,
    parent_task_id: u64,
}

// What a suspended task waits on (element 3). Variants are only added, at
// the end, so a variant keeps its index.
// - `Running`: nothing; it can run when a worker takes it.
// - `PeerTask(task_id)`: another task: a join, a channel, a lock or a
//   pool. For a join, `task_id` is the joined task's (`TaskInfo.task_id`);
//   it is 0 for the rest, which wait on no one task, and while the joined
//   task is running.
// - `IoHandle(fd)`: a descriptor to become readable or writable.
// - `Sleep`: a deadline (`sleep_ms`).
// `Running` rather than `None`, which would shadow `Option.None` at scope 0.
pub enum WaitTarget {
    Running,
    PeerTask(u64),
    IoHandle(i64),
    Sleep,
}

// Empty-marker type — exists so the three introspection methods have a
// receiver type for `impl Runtime { ... }`. Same pattern as
// `runtime/stdlib/io.kara`'s `struct Stdin { }` etc.
pub struct Runtime { }

impl Runtime {
    // Whether the binary carries the runtime debug metadata: a compiled
    // build does unless `--release` stripped it; the MIR interpreter keeps
    // none.
    #[compiler_builtin]
    fn has_debug_metadata() -> bool { false }

    // Every active `par {}` block on every worker, oldest first. Empty
    // outside any, and without the metadata.
    #[compiler_builtin]
    fn list_par_blocks() -> Vec[ParBlockInfo] { Vec.new() }

    // Every suspended task, by id. Empty without the metadata.
    #[compiler_builtin]
    fn list_tasks() -> Vec[TaskInfo] { Vec.new() }
}
