// runtime/stdlib/hash.kara
//
// CR-202 slice 5e / B-2026-08-22-6. Per design.md § `Hash` and `Hasher`, the
// surface is three traits: `Hash` says how to feed a value into a hasher,
// `Hasher` says how to absorb bytes and produce a digest, and `BuildHasher`
// says how a table mints a fresh `Hasher` per hash. The split is why
// `Map[K, V, FxBuildHasher]` and `Map[K, V, SipHash13BuildHasher]` can share
// every key impl — the key never learns which hasher is in force.
//
// Pre-5e Hash was not registered in `env.traits` at all. Slice 5e added it
// without the `H: Hasher` bound, because `Hasher` was not baked; B-2026-08-22-6
// bakes both companion traits and restores the bound.

// How bytes become a digest. A `Map` calls `write` once per key with that key's
// byte image and then `finish` — see `Codegen::emit_hash_bytes_call` for the
// compiled shape and `interpreter::user_hasher` for the interpreted twin.
//
// The convenience methods carry DEFAULT BODIES, so an impl supplies only
// `write` and `finish`. They exist so a `Hash` impl can feed a scalar without
// spelling the byte conversion at every call site.
trait Hasher {
    fn write(mut ref self, bytes: ref Slice[u8]);
    fn finish(ref self) -> u64;

    fn write_u8(mut ref self, n: u8) { self.write([n]) }
    fn write_u16(mut ref self, n: u16) { self.write(n.to_ne_bytes()) }
    fn write_u32(mut ref self, n: u32) { self.write(n.to_ne_bytes()) }
    fn write_u64(mut ref self, n: u64) { self.write(n.to_ne_bytes()) }
    fn write_usize(mut ref self, n: usize) { self.write(n.to_ne_bytes()) }
    fn write_i8(mut ref self, n: i8) { self.write(n.to_ne_bytes()) }
    fn write_i16(mut ref self, n: i16) { self.write(n.to_ne_bytes()) }
    fn write_i32(mut ref self, n: i32) { self.write(n.to_ne_bytes()) }
    fn write_i64(mut ref self, n: i64) { self.write(n.to_ne_bytes()) }
    fn write_isize(mut ref self, n: isize) { self.write(n.to_ne_bytes()) }
}

// Per-table configuration, separate from per-hash state: the `BuildHasher` is
// what `Map[K, V, H]` names, and `build()` is what mints the `Hasher` a single
// hash runs through.
//
// A builder named in a container's type must be a struct with NO FIELDS. The
// slot names a TYPE, not a value, so there is nowhere for fields to come from —
// both backends construct the builder themselves before calling `build()`. Put
// a seed inside `build()`, where it can be read from wherever it actually
// lives. A field-carrying builder is rejected at the container, not here.
trait BuildHasher {
    type Hasher: Hasher;
    fn build(ref self) -> Self.Hasher;
}

trait Hash {
    fn hash[H: Hasher](ref self, hasher: mut ref H);
}

// ── The two hasher selectors ──────────────────────────────────────────
//
// design.md § `Hash` and `Hasher`, "Default hasher for v1", spells both:
// "`Map[K, V]` and `Set[T]` without an explicit hasher use
// `SipHash13BuildHasher`, seeded from a per-process random source ... Users
// who pin the hasher (`Map[K, V, FxBuildHasher]`) opt out of both the
// DoS-resistance guarantee and the version-stability escape hatch."
//
// WHAT THESE ARE: type-level SELECTORS for the two hashes the compiler ships
// in the runtime. They are NOT `impl BuildHasher` sites, and they never will
// be — naming one routes the container straight at `karac_hash_bytes` /
// `karac_hash_bytes_fx`, a single call per hash with no user frame in it.
// A user hasher (B-2026-08-22-6) takes the OTHER path: name any type that
// `impl BuildHasher for` in the same slot and both backends dispatch through
// its `build` / `write` / `finish`. So the trailing argument now accepts three
// things — these two, and anything the user implements.
//
// They stay zero-field structs because a config-free selector holds no state
// and nothing ever constructs one; they exist so that intent can be written
// down in the type.

// SipHash-1-3 with a per-process random key — the DEFAULT for every `Map` and
// `Set` that does not name a hasher, and the reason iteration order differs
// from one process to the next. Naming it explicitly is exactly equivalent to
// leaving the parameter off; it exists so that intent can be written down.
struct SipHash13BuildHasher { }

// FxHash — rotate-xor-multiply against a fixed multiplier, no key. Floodable by
// anyone who can read the multiplier out of the compiler's source. Because it
// is unkeyed, iteration order is stable across runs of one binary. Reach for it
// only when the keys cannot come from an adversary, and never for
// `Map[String, _]` keyed on request data.
//
// IT IS NOT CURRENTLY FASTER, which is what this was offered for. Measured
// compiled on arm64, 200 000 `String` inserts plus 1 000 000 lookups: 1.23 s
// against the default's 0.09 s — 13.7x SLOWER (B-2026-08-22-29). There is also
// a correctness defect on the non-default path (B-2026-08-22-27). Until both
// are closed, pinning this buys nothing but the stable order.
struct FxBuildHasher { }

// ── The sink a user `impl Hash` writes into ───────────────────────────
//
// `Map`/`Set` key hashing has two halves, and design.md § `Hash` and `Hasher`
// keeps them apart on purpose: `Hash` decides WHICH BYTES a value contributes,
// `BuildHasher`/`Hasher` decides HOW those bytes become a digest. This type is
// the seam. When a key's type carries its own `impl Hash`, both backends hand
// the impl one of these, let it write whatever it likes, and then feed the
// collected bytes to the container's hasher — the same `karac_hash_bytes` (or
// the same user `BuildHasher`) a key without an `impl Hash` would reach.
//
// A CONSEQUENCE WORTH NAMING: this makes the two backends agree byte for byte.
// Without an `impl Hash` they deliberately do not — the section above records
// that a compiled binary feeds the key's memory image while the interpreter
// feeds a canonical flattening of the `Value`, so digests differ between
// `karac run` and a compiled binary. Once the user's impl decides the bytes,
// there is no memory image and no flattening left to disagree about.
//
// `finish` exists only to satisfy the trait. The compiler reads `bytes`
// directly and never calls it, because the digest is the CONTAINER's business
// and this type has no way to know which hasher the container was built with.
struct KeyByteSink { mut bytes: Vec[u8] }

// The `write_*` convenience methods are SPELLED OUT rather than inherited.
// `synthesize_trait_default_methods` copies a trait's default bodies into
// implementing blocks, but it runs over the USER program — a baked stdlib impl
// like this one is spliced in from the prelude and never passes through it, so
// the defaults are absent from this impl's item list. Both backends key off
// that list (`eval_method_call` dispatch and codegen's
// `make_impl_method_function` alike), so an inherited default is missing in
// both: the interpreter reported "method 'write_i64' not found on type
// 'KeyByteSink'". Each body below is the trait's own default, verbatim, so the
// bytes are identical to what an inheriting impl would produce.
impl Hasher for KeyByteSink {
    fn write(mut ref self, bytes: ref Slice[u8]) {
        let mut i = 0;
        while i < bytes.len() {
            self.bytes.push(bytes[i]);
            i = i + 1;
        }
    }
    fn finish(ref self) -> u64 { 0 }

    fn write_u8(mut ref self, n: u8) { self.write([n]) }
    fn write_u16(mut ref self, n: u16) { self.write(n.to_ne_bytes()) }
    fn write_u32(mut ref self, n: u32) { self.write(n.to_ne_bytes()) }
    fn write_u64(mut ref self, n: u64) { self.write(n.to_ne_bytes()) }
    fn write_usize(mut ref self, n: usize) { self.write(n.to_ne_bytes()) }
    fn write_i8(mut ref self, n: i8) { self.write(n.to_ne_bytes()) }
    fn write_i16(mut ref self, n: i16) { self.write(n.to_ne_bytes()) }
    fn write_i32(mut ref self, n: i32) { self.write(n.to_ne_bytes()) }
    fn write_i64(mut ref self, n: i64) { self.write(n.to_ne_bytes()) }
    fn write_isize(mut ref self, n: isize) { self.write(n.to_ne_bytes()) }
}
