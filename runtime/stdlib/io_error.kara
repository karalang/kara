// runtime/stdlib/io_error.kara
//
// CR-202 slice 6.1j. Error type returned by I/O standard library
// functions. Lives in the prelude so it does not need an import.
//
// `Display` is written out (below) and `Debug` derived: a program's user
// reads the Display, as `lgrep: nope: not found` or a `main() ->
// Result[(), IoError]`'s `Error: {e}` line, so it is a short phrase, and
// `Debug` names the variant (io.md § Errors, B-2026-11-08-30). The MIR
// pipeline runs `source/io_error.kara`'s copy of the impl.
//
// `InvalidInput` (an argument the operation refuses: a negative length,
// a negative `SeekFrom.Start`, an `OpenOptions` combination that opens
// nothing) and `Unsupported` (an operation this platform does not have)
// joined at B-2026-10-15-28; `ProviderUnavailable` (a file opened under a
// `FileSystem` override, used after that override's call returned,
// core-semantics §14.11) with provider overrides. Every backend builds a
// variant by NAME, so the order here is the documented one, not a runtime
// code.

#[derive(Debug)]
enum IoError {
    NotFound,
    PermissionDenied,
    AlreadyExists,
    InvalidInput,
    UnexpectedEof,
    InvalidUtf8,
    Interrupted,
    Unsupported,
    ProviderUnavailable,
    Other(String),
}

impl Display for IoError {
    fn to_string(ref self) -> String {
        match self {
            NotFound => "not found",
            PermissionDenied => "permission denied",
            AlreadyExists => "already exists",
            InvalidInput => "invalid input",
            UnexpectedEof => "unexpected end of file",
            InvalidUtf8 => "invalid UTF-8",
            Interrupted => "interrupted",
            Unsupported => "unsupported",
            ProviderUnavailable => "provider unavailable",
            Other(msg) => msg.clone(),
        }
    }
}
