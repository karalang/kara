// runtime/stdlib/into_iterator.kara
//
// design.md § `Iterator` and `Iterable`: `IntoIterator` is an ordinary
// library trait for consuming a collection. `into_iter` takes `own self`
// and returns an iterator over `Item`; `for` never calls it, and a
// generic consumer (`fn total[C: IntoIterator[Item = i64]](c: own C)`)
// does, explicitly. Each impl's `impl Iterator` is its own type.

trait IntoIterator {
    type Item;
    fn into_iter(own self) -> impl Iterator[Item = Self.Item];
}
