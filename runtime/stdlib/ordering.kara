// runtime/stdlib/ordering.kara
//
// Comparison ordering. Returned by `Ord.cmp` and as the inner payload
// of `PartialOrd.partial_cmp`'s `Option`. Per design.md § Comparison
// Traits.
//
// The memory-ordering set used by `Atomic` operations (Relaxed,
// Acquire, Release, AcqRel, SeqCst) lives in a separate type
// `MemoryOrdering` (see `memory_ordering.kara`); the two semantics
// previously shared this name, which made `Ord.cmp(a, b) ==
// Ordering.Less` fail to typecheck.

#[derive(Eq, Copy)]
enum Ordering {
    Less,
    Equal,
    Greater,
}

impl Ordering {
    fn is_lt(ref self) -> bool { match self { Ordering.Less => true, _ => false } }
    fn is_le(ref self) -> bool { match self { Ordering.Greater => false, _ => true } }
    fn is_gt(ref self) -> bool { match self { Ordering.Greater => true, _ => false } }
    fn is_ge(ref self) -> bool { match self { Ordering.Less => false, _ => true } }
    fn is_eq(ref self) -> bool { match self { Ordering.Equal => true, _ => false } }
}

// ── std.cmp free functions (roadmap Phase 8 § std.cmp) ──────────────
//
// `min` / `max` / `clamp` over any `Ord` type. Pure (no effect clause):
// `Ord.cmp` is side-effect free, so these carry the empty effect set.
// Ties return the *first* argument for both `min` and `max` — a single
// consistent rule rather than Rust's min-first / max-second asymmetry.
//
// Correct in the interpreter (`karac run`) and compiled output (`karac
// build`) for every `Ord` type, including HEAP-owning ones (`String`,
// heap structs/enums). The compiled heap-`Ord` case was a codegen leak
// these bodies (`match a.cmp(b) { Greater => b, _ => a }`) surfaced —
// returning one owned param while the caller/callee failed to drop the
// other's buffer — fixed in both the non-generic and generic/monomorphized
// paths (B-2026-07-08-6).

pub fn min[T: Ord](a: T, b: T) -> T {
    match a.cmp(b) {
        Ordering.Greater => b,
        _ => a,
    }
}

pub fn max[T: Ord](a: T, b: T) -> T {
    match a.cmp(b) {
        Ordering.Less => b,
        _ => a,
    }
}

// Clamp `value` into the inclusive range `[low, high]`. Caller must pass
// `low <= high`; when `low > high` the low bound wins (value is pinned to
// `low`), matching the "clamp to the nearer active bound" reading.
pub fn clamp[T: Ord](value: T, low: T, high: T) -> T {
    match value.cmp(low) {
        Ordering.Less => low,
        _ => match value.cmp(high) {
            Ordering.Greater => high,
            _ => value,
        },
    }
}

// ── `Option[Ordering]` predicates ───────────────────────────────────
//
// These live HERE, not beside `enum Option` in `option.kara`, because
// codegen compiles this module's bodies and does not compile that one
// (`compiled_stdlib_programs`). Adding option.kara to that list was
// measured and is NOT the fix: it re-declares `enum Option[+T]`, whose
// layout codegen builds itself, and the redeclaration replaced the
// builtin two-word `{tag, payload}` shape — `build_option_some_via_phis`
// then panicked with `ExtractOutOfRange` and three Map/Set codegen tests
// failed. Relocating just the impl block declares the five methods with
// no second Option layout (B-2026-08-26-23).
//
// Without them compiled, `Option[Ordering].is_lt()` ran correctly under
// `--interp` and failed to BUILD for every receiver, including a plain
// `let o: Option[Ordering]` local. That gap is what forced the ordering
// operators to desugar through `Ord.cmp` rather than design.md's
// specified `PartialOrd.partial_cmp(a, b).is_lt()`.
// Partial-comparison helpers for `Option[Ordering]`. Per design.md §
// Comparison Traits (lines 5268-5277): `None` — "incomparable" — yields
// `false` for every predicate, matching IEEE-754's `NaN < 5.0`,
// `5.0 > NaN`, and `NaN == NaN` all being `false`. The baked-impl-walk
// (precedent: `runtime/stdlib/ordering.kara:20-26`) registers this block
// automatically; args-aware impl-table lookup (shipped 2026-05-08 at
// `2b867a4`) routes `Option[Ordering].is_lt(...)` here while leaving
// `Option[T].is_lt(...)` undefined for other T.
impl Option[Ordering] {
    fn is_lt(ref self) -> bool { match self { Some(Ordering.Less) => true, _ => false } }
    fn is_le(ref self) -> bool { match self { Some(Ordering.Less) | Some(Ordering.Equal) => true, _ => false } }
    fn is_gt(ref self) -> bool { match self { Some(Ordering.Greater) => true, _ => false } }
    fn is_ge(ref self) -> bool { match self { Some(Ordering.Greater) | Some(Ordering.Equal) => true, _ => false } }
    fn is_eq(ref self) -> bool { match self { Some(Ordering.Equal) => true, _ => false } }
}
