impl Sha512 {
    pub fn new() -> Sha512 {
        Sha512 { h: CryptoSha2.start(512) }
    }

    /// Adds `data` to what the digest covers.
    pub fn update(mut ref self, data: Slice[u8]) {
        CryptoSha2.update(self.h, data);
    }

    /// The digest of everything added.
    pub fn finish(own self) -> Array[u8, 64] {
        let mut s = self;
        let mut out = [0u8; 64];
        CryptoSha2.finish(s.h, mut out);
        s.h = 0;
        out
    }
}

// Drop-skip-sound: if this Drop never runs, the running hash's state (a
// few hundred bytes the native side allocated) leaks, and nothing else:
// the handle is a plain integer that no other value shares, and the
// state holds no OS resource. An HMAC's keyed state is not wiped when
// it is freed either, so a leak exposes nothing a free would hide.
impl Drop for Sha512 {
    fn drop(mut ref self) {
        if self.h != 0 {
            CryptoSha2.free(self.h);
        }
    }
}
