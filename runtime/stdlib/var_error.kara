// runtime/stdlib/var_error.kara
//
// CR-202 slice 6.1j. Error type returned by `env.var(name)`.
// Resolved as `std.env.VarError` per brainstorming v49 (Q2=B). Two
// unit variants — `Result[String, VarError]` stays
// forward-compatible if we ever add reasons (e.g. permission
// errors), but no payload today: Kāra's strict-UTF-8 `String` rules
// out a Rust-style `NotUnicode(OsString)` carrier.
//
// `Display` is written out so a `fn main() -> Result[(), VarError]`
// satisfies the entry-point `E: Display` bound with a phrase its user
// reads; `Debug` names the variant (io.md § Errors, B-2026-11-08-30).

#[derive(Debug)]
enum VarError {
    NotPresent,
    NotUnicode,
}

impl Display for VarError {
    fn to_string(ref self) -> String {
        match self {
            NotPresent => "environment variable not found",
            NotUnicode => "environment variable is not valid unicode",
        }
    }
}
