// runtime/stdlib/f32.kara
//
// CR-202 slice 6.1d. `F32` is the total-order f32 wrapper — adds
// `Eq` / `Ord` / `Hash` to a 32-bit float by treating NaN as a
// concrete distinguishable bit pattern. The structural derives match
// what the legacy hardcoded `register_builtin_types` arm inserted
// directly. Method dispatch stays in the hardcoded path.

#[derive(Eq, Ord, Hash, PartialEq, PartialOrd, Copy)]
struct F32 {
    value: f32,
}

// B-2026-08-11-8 — sibling of `F64.from`; see f64.kara for the full
// rationale. Ordinary Kāra body: the wrapper is a single-field struct
// in both backends, so the struct literal lowers correctly everywhere.
impl F32 {
    fn from(value: f32) -> F32 {
        F32 { value: value }
    }
}
