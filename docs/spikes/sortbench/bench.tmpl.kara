// B-2026-08-11-10 sort benchmark harness (template).
//
// Rebuilt from docs/spikes/sort-algorithm-gap.md § Method — the original lived
// in a prior session's scratchpad and is gone with it.
//
//   n = 150_000 elements of (i64, i64), comparator |x, y| x.0.cmp(y.0)
//   timing = the 1-round / R-round SLOPE (removes process startup + input
//   build); a MODE=cloneonly build subtracts the per-round base.clone().
//
// Placeholders substituted by gen.sh: @PATTERN@ @ROUNDS@ @SORT@

fn build(n: i64) -> Vec[(i64, i64)] {
    let mut v: Vec[(i64, i64)] = Vec.new();
    // Fixed-seed LCG so every variant sorts byte-identical input.
    let mut seed: i64 = 12345;
    let mut i: i64 = 0;
    while i < n {
        seed = (seed * 1103515245 + 12345) % 2147483648;
        let r = seed;
        let mut k: i64 = 0;
        @PATTERN@
        v.push((k, i));
        i = i + 1;
    }
    return v;
}

fn main() {
    let n: i64 = 150000;
    let rounds: i64 = @ROUNDS@;
    let base = build(n);

    let mut checksum: i64 = 0;
    let mut r: i64 = 0;
    while r < rounds {
        let mut work = base.clone();
        @SORT@
        // Consume both ends so nothing is dead-code eliminated.
        checksum = checksum + work[0].0 + work[n - 1].0;
        r = r + 1;
    }
    println(f"checksum={checksum}");
}
