// Declarations the documentation's examples rely on and do not show.
//
// A block fenced ```kara,uses=NAME is checked (and run, when it is a whole
// program) after the section `// context: NAME` below, or after the block of
// the same document fenced ```kara,name=NAME. Each section is the smallest
// honest stand-in for what the prose takes as given: a `fetch_orders` an
// example calls, the `Config` it reads. A section never declares what the
// example itself is showing. docs/design-conformance.md says how the sweeps
// read this file.

// context: d-point
struct Point { x: i64, y: i64 }

// context: d-config
struct Config { port: i64 }
fn load_config(path: Str) -> Config with reads(FileSystem) { Config { port: 8080 } }

// context: d-app-context
pub effect resource UserDB;
pub effect resource Cache;
pub struct Config { pub database_url: String, pub max_connections: i64, pub timeout_ms: i64 }
fn load_config(path: String) -> Result[Config, AnyError] with reads(FileSystem) reads(Env) {
    Ok(Config { database_url: "db://local", max_connections: 4, timeout_ms: 100 })
}
pub struct DbPool { size: i64 }
impl DbPool {
    fn connect(url: own String, max: i64) -> Result[DbPool, AnyError] with sends(Network) receives(Network) blocks {
        Ok(DbPool { size: max })
    }
}
pub struct Logger { timeout_ms: i64 }
impl Logger {
    fn new(timeout_ms: i64) -> Logger { Logger { timeout_ms } }
}
pub struct Request { token: String }
pub struct Response { body: String }
impl Response {
    fn ok(body: own String) -> Response { Response { body } }
}
pub struct User { pub id: i64 }
impl AppContext {
    fn authorize(self, token: String) -> Result[User, AnyError] with reads(UserDB) { Ok(User { id: 1 }) }
    fn fetch_profile(self, id: i64) -> Result[String, AnyError] with writes(Cache) { Ok("profile") }
}
fn run_server(ctx: own AppContext, port: i64) -> Result[(), AnyError]
    with reads(UserDB) writes(Cache) sends(Network) receives(Network) blocks
{
    Ok(())
}

