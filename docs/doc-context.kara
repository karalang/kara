}
struct Receipt { id: i64 }
struct Request { id: i64 }
impl Request {
    fn receipt(self) -> Receipt { Receipt { id: self.id } }
}
struct Response { status: i64 }
fn read_request(conn: mut ref TcpStream) -> Result[Request, ServerError] { Ok(Request { id: 1 }) }
fn send_receipt(receipt: own Receipt) {}
fn handle(req: own Request) -> Response { Response { status: 200 } }
fn write_response(conn: mut ref TcpStream, resp: own Response) -> Result[(), ServerError] { Ok(()) }

