// examples/phase0/dashboard.kara
//
// Proof of Value: Effect-driven auto-concurrency.
//
// This program fetches data from three independent sources,
// processes it, and writes a summary. The programmer writes
// sequential-looking code — the compiler parallelizes it.
//
// COMPILE-ONLY. This file type-checks and is the subject of the effect
// analysis the README walks through; it does not RUN, because no
// `with_provider` scope ever binds an implementation to the three resources
// below. Running it stops at "no provider bound for resource 'UserDB'".
// `examples/db_pipeline` is the runnable counterpart — same shape, with an
// `InMemoryDb` provider and a `with_provider` binding.

// Declared WITHOUT a provider trait, which is the bare `effect resource R;`
// form. These three previously read `: DatabaseProvider` — a trait this file
// never defined and the resolver never checked (B-2026-07-29-17, fixed
// 2026-07-29; the declaration is now validated).
//
// Writing the contract out is not the smaller fix it looks like. A provider
// trait IS consulted for call typing once it exists, and these three resources
// return different row types (`Profile`, `Vec[Order]`, `Vec[Notification]`),
// so it needs an associated `type Row` plus a concrete `impl` per resource to
// bind it — at which point this file has become `examples/db_pipeline`, which
// already demonstrates exactly that with an `InMemoryDb` and a `with_provider`
// binding. This file's subject is the effect ANALYSIS below, so it declares
// the resources and stops there.
effect resource UserDB;
effect resource OrderDB;
effect resource NotifDB;

// The error type the three fetches share. Defined locally because this file
// is a single-file demo: `examples/db_pipeline` declares the same vocabulary
// (`DbError` alongside its own `DatabaseProvider`) as a multi-module package.
#[derive(Display)]
enum DbError {
    NotFound { table: String },
    Backend { message: String },
}

struct Profile {
    name: String,
    email: String,
    tier: String,
}

struct Order {
    id: u64,
    total: f64,
    status: String,
}

struct Notification {
    message: String,
    unread: bool,
}

struct Dashboard {
    greeting: String,
    order_summary: String,
    alert: String,
}

// Private functions — effects are inferred by the compiler from the body.
// No annotations needed. The compiler traces the call graph and determines:
//   fetch_profile       → reads(UserDB)   (from UserDB.query_one)
//   fetch_orders        → reads(OrderDB)  (from OrderDB.query)
//   fetch_notifications → reads(NotifDB)  (from NotifDB.query)
//
// In a runnable program each resource would be backed by a provider trait and
// a concrete implementation injected via `with_provider` — see
// `examples/db_pipeline`. This file stops at the declaration (see the note on
// the resources above); the effect inference below does not depend on the
// binding, which is the point being made.

fn fetch_profile(user_id: u64) -> Result[Profile, DbError] {
    UserDB.query_one("SELECT name, email, tier FROM users WHERE id = ?", user_id)
}

fn fetch_orders(user_id: u64) -> Result[Vec[Order], DbError] {
    OrderDB.query("SELECT id, total, status FROM orders WHERE user_id = ?", user_id)
}

fn fetch_notifications(user_id: u64) -> Result[Vec[Notification], DbError] {
    NotifDB.query("SELECT message, unread FROM notifications WHERE user_id = ?", user_id)
}

// Pure function — no effects, no I/O.
fn build_dashboard(profile: Profile, orders: Vec[Order], notifs: Vec[Notification]) -> Dashboard {
    let total_spent = orders.iter().fold(0.0, |sum, o| sum + o.total);
    let pending = orders.iter().filter(|o| o.status == "pending").count();
    let unread = notifs.iter().filter(|n| n.unread).count();

    Dashboard {
        greeting: f"Welcome back, {profile.name} ({profile.tier})",
        order_summary: f"{orders.len()} orders (${total_spent:.2}), {pending} pending",
        alert: match unread {
            0 => "No new notifications".to_string(),
            1 => "1 unread notification".to_string(),
            n => f"{n} unread notifications",
        },
    }
}

// main is private too — effects inferred automatically.
// The compiler infers: reads(Env), reads(UserDB), reads(OrderDB), reads(NotifDB), writes(Stdio)
fn main() -> Result[(), DbError] {
    let args = env.args();
    let user_id = match u64.parse(args.get(1).unwrap_or("1")) {
        Some(id) => id,
        // Default rather than fail: the point of this demo is the effect
        // analysis below, not argument parsing. (It also keeps the demo out of
        // the way of B-2026-07-29-18 — under `karac run`, `env.args()` returns
        // karac's own argv, so `args[1]` is the literal string "run".)
        None => 1,
    };

    // Three independent reads on different resources.
    // The compiler sees: reads(UserDB), reads(OrderDB), reads(NotifDB)
    // No conflicts, no data dependencies → runs all three concurrently.
    let profile = fetch_profile(user_id)?;
    let orders = fetch_orders(user_id)?;
    let notifs = fetch_notifications(user_id)?;

    // Sync point: build_dashboard needs all three results.
    let dashboard = build_dashboard(profile, orders, notifs);

    println(dashboard.greeting);
    println(dashboard.order_summary);
    println(dashboard.alert);
    Ok(())
}
