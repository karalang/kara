// display.kara — Terminal rendering of a Grid.
//
// GAP-K: CLOSED (2026-08-26, B-2026-08-26-11) — efficient string accumulation
//   exists.  This note used to say a `StringBuilder` or `String.with_capacity(n)`
//   + repeated `push_char` "would fix this", and that "without it, we fall back
//   to per-cell println".  Both halves are now available: `String.with_capacity(n)`
//   and `String.push(c: char)` — the char-append is spelled `push`, matching
//   `Vec.push`, which is why a search for `push_char` found nothing.  `push`
//   encodes the scalar to UTF-8 in place with an inline ASCII fast path, so a
//   build-a-row-then-flush-once renderer is O(n) with one write per ROW.
//
//   The renderer below still uses the per-cell fallback: rewriting it is a real
//   change needing its own expected-output check, not a doc fix, so it was left
//   for a separate pass rather than folded into the correction of this comment.
//
// GAP-L: No ANSI / terminal control in stdlib.
//   Clearing the screen requires writing the ANSI escape sequence directly
//   as a raw string.  A stdlib `terminal.clear()` with `writes(Stdout)` effect
//   would be cleaner and portable.

import grid.Grid;

pub fn render(grid: ref Grid) with writes(Stdout) {
    let mut y: i64 = 0;
    while y < grid.height {
        let mut row = "";
        let mut x: i64 = 0;
        while x < grid.width {
            // GAP-K: String + String allocates on every iteration.
            row = row + if grid.get(x, y) { "█" } else { "·" };
            x = x + 1;
        }
        println(row);
        y = y + 1;
    }
    println(f"population: {grid.population()}");
}

pub fn clear_screen() with writes(Stdout) {
    // GAP-L, sharpened 2026-07-29: the raw ANSI escape cannot even be
    // WRITTEN today. Kāra's string literals support `\n`, `\t`, `\r`, `\\`
    // and `\"` and nothing else — there is no `\x1b`, no `\u{1b}`, and no
    // char-from-code-point — so `"\x1b[2J\x1b[H"` is a lex error, not merely
    // an unportable idiom. Until a stdlib `terminal.clear()` (or a numeric
    // escape) exists, separate frames with blank lines instead.
    println("");
    println("");
}
