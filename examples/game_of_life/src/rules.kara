// rules.kara — Pure Conway's Game of Life rules.
// No effects: these functions are ideal candidates for auto-parallelism.
//
// This module is deliberately Grid-FREE. `count_neighbors` lives in
// `grid.kara` because it takes a `ref Grid`: keeping it here made
// `rules` import `grid` while `grid` imported `rules`, which the compiler
// correctly rejects as `E0223 grid → rules → grid`. Splitting on the Grid
// dependency — rule arithmetic here, Grid traversal there — breaks the cycle
// without either module growing a back-edge.

// Conway's B3/S23 rule:
//   - A dead cell with exactly 3 neighbours becomes alive (birth).
//   - A live cell with 2 or 3 neighbours survives.
//   - All other cells die or stay dead.
pub fn next_state(alive: bool, neighbors: i64) -> bool {
    if alive {
        neighbors == 2 or neighbors == 3
    } else {
        neighbors == 3
    }
}
