// Minimal WebSocket echo server (plaintext ws://).
//
// `WebSocket` / `TcpListener` are `std.net` (docs/library/io.md §
// WebSocket). The handler echoes each text or binary message back until
// the client closes. For the TLS variant, swap
// `TcpListener.bind` + `WebSocket.accept` for `TlsListener.bind_tls` +
// `WebSocket.accept_tls` (see examples/ws_idle_holder).
//
// Build & run:  karac run examples/std_net/ws_echo.kara
fn echo(ws: own WebSocket) {
    let mut ws = ws;
    loop {
        match ws.recv() {
            Ok(WsMessage.Text(t)) => {
                if ws.send_text(t).is_err() { break; }
            }
            Ok(WsMessage.Binary(b)) => {
                if ws.send_binary(b).is_err() { break; }
            }
            Ok(WsMessage.Close(_)) => { break; }
            Ok(_) => {}
            Err(_) => { break; }
        }
    }
}

fn main() {
    let listener = TcpListener.bind("127.0.0.1:8080").unwrap();
    loop {
        match WebSocket.accept(listener) {
            Result.Ok(ws) => { echo(ws); }
            Result.Err(_) => {}
        }
    }
}
