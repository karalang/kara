// examples/leetcode/group_anagrams.kara
//
// LeetCode #49: Group Anagrams
// Given an array of strings, group anagrams together.
// e.g. ["eat","tea","tan","ate","nat","bat"] → [["bat"],["eat","tea","ate"],["tan","nat"]]
//
// Demonstrates: SortedMap, string operations, iterators
//
// The groups come out in key order (a SortedMap walks its keys sorted), so the
// output is the same on every run. A `Map` walk is in a per-process random
// order, which would print the groups differently each time.

fn group_anagrams(strs: ref Vec[String]) -> Vec[Vec[String]] {
    let mut groups: SortedMap[String, Vec[String]] = SortedMap.new();

    for s in strs.iter() {
        let key = s.sorted();
        groups.entry(key).or_insert(Vec.new()).push(s.clone());
    }

    groups.values().cloned().collect()
}

fn main() {
    // Test 1
    let strs = ["eat", "tea", "tan", "ate", "nat", "bat"];
    let groups = group_anagrams(strs);
    println(f"Input:  {strs}");
    println(f"Output: {groups}");
    println("");

    // Test 2: single element
    let strs2 = ["a"];
    let groups2 = group_anagrams(strs2);
    println(f"Input:  {strs2}");
    println(f"Output: {groups2}");
    println("");

    // Test 3: empty string
    let strs3 = [""];
    let groups3 = group_anagrams(strs3);
    println(f"Input:  {strs3}");
    println(f"Output: {groups3}");
}

// Expected output:
// Input:  [eat, tea, tan, ate, nat, bat]
// Output: [[bat], [eat, tea, ate], [tan, nat]]
//
// Input:  [a]
// Output: [[a]]
//
// Input:  []
// Output: [[]]
