// design.md §9 Conversions: `AnyError` itself does not implement `Error`, so
// it does not meet an `E: Error` bound.
struct Bad { code: i64 }
impl Display for Bad { fn to_string(self) -> String { f"bad {self.code}" } }
impl Error for Bad {}
fn describe[E: Error](e: E) -> String { e.to_string() }
fn main() {
    let e: AnyError = AnyError.from(Bad { code: 1 });
    println(describe(e));
}
