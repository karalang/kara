// design.md §9 impl Trait, what the result borrows: the borrow ends with the
// value's scope, so a value in an inner block frees `v` for the write after it.
trait Show { fn show(self) -> i64; }
impl Show for i64 { fn show(self) -> i64 { self } }
fn size(v: Vec[i64]) -> impl Show { v.len() }
fn main() {
    let mut v = [1, 2];
    {
        let r = size(v);
        println(r.show());
    }
    v.push(3);
    println(v.len());
}
