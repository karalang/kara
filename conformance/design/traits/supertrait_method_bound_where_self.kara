trait Seq {
    fn items(self) -> Vec[i64];
    fn twice(self) -> Vec[i64] where Self: Clone {
        let c = self.clone();
        let mut v = self.items();
        v.extend(c.items());
        v
    }
}
#[derive(Clone)]
struct Yes { v: Vec[i64] }
struct No { v: Vec[i64] }
impl Seq for Yes { fn items(self) -> Vec[i64] { self.v.clone() } }
impl Seq for No { fn items(self) -> Vec[i64] { self.v.clone() } }
fn main() {
    println(f"{Yes { v: [1] }.twice()}");
    println(f"{No { v: [2] }.items()}");
}
