fn one() -> i64 { 1 }
fn zero() -> i64 { 0 }
fn main() {
    println("before");
    let mut m: Map[String, i64] = Map.new();
    m.insert("a".to_string(), 1);
    println(f"{m["b".to_string()]}");
    println("after");
}
