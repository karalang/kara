fn one() -> i64 { 1 }
fn zero() -> i64 { 0 }
fn main() {
    println("before");
    let r: Result[i64, String] = Err("why".to_string());
    println(f"{r.unwrap()}");
    println("after");
}
// design.md conformance (moved from the shared folder's design-10-13): panic: unwrap Err: exit 101, stdout kept, report on stderr at the caller
