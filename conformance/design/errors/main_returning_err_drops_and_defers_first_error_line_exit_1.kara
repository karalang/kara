
struct Noisy {}
impl Drop for Noisy { fn drop(mut ref self) { println("dropped"); } }
fn main() -> Result[(), String] {
    let _n = Noisy {};
    defer println("deferred");
    errdefer println("errdeferred");
    println("work");
    Err("it broke".to_string())
}
// design.md conformance (moved from the shared folder's design-10-13): main returning Err: drops and defers first, Error line, exit 1
