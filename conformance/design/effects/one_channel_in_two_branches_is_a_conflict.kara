// one channel in two branches is a conflict

import std.sync.{Receiver, SendError, Sender};

fn produce(tx: Sender[i64], from: i64, to: i64) -> Result[(), SendError[i64]] { for i in from..to { tx.send(i)?; } Ok(()) }
fn main() {
    let (tx, rx): (Sender[i64], Receiver[i64]) = channel(8);
    let (r1, r2) = par { produce(tx, 0, 4), produce(tx, 4, 8) };
}
