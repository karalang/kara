struct K { v: i64 }
impl PartialEq for K { fn eq(self, o: K) -> bool { self.v == o.v } }
impl Eq for K { }
impl Hash for K { fn hash[H: Hasher](self, h: mut ref H) { println("hash"); h.write_i64(self.v); } }
fn f(k: i64) -> i64 { let s: Set[K] = Set.new(); if s.contains(K { v: k }) { 1 } else { 0 } }
fn main() { let (a, b) = par { f(1), f(2) }; println(a + b); }
