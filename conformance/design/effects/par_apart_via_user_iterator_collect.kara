struct Ct { n: i64 }
impl Iterator for Ct { type Item = i64; fn next(mut ref self) -> Option[i64] { if self.n == 0 { None } else { self.n -= 1; Some(self.n) } } }
fn f(k: i64) -> i64 { let v: Vec[i64] = Ct { n: k }.collect(); v.len() as i64 }
fn main() { let (a, b) = par { f(1), f(2) }; println(a + b); }
