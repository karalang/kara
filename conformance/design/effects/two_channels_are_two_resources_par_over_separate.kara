// two channels are two resources: par over separate senders is accepted

import std.sync.{Receiver, SendError, Sender};

fn produce(tx: Sender[i64], from: i64, to: i64) -> Result[(), SendError[i64]] { for i in from..to { tx.send(i)?; } Ok(()) }
fn main() {
    let (tx1, rx1): (Sender[i64], Receiver[i64]) = channel(8);
    let (tx2, rx2): (Sender[i64], Receiver[i64]) = channel(8);
    let (r1, r2) = par { produce(tx1, 0, 4), produce(tx2, 4, 8) };
    let mut s = 0;
    for _ in 0..4 { s += rx1.recv().unwrap() + rx2.recv().unwrap(); }
    println(f"{r1.is_ok()} {r2.is_ok()} {s}");
}
