// design.md §11 property 3: storing the handle in a non-frozen slot is refused.
shared struct Node { val: i64, mut neighbors: Vec[Node] }
fn build() -> Node { let r = Node { val: 1, neighbors: Vec.new() }; r.neighbors.push(Node { val: 2, neighbors: Vec.new() }); r.neighbors.push(Node { val: 3, neighbors: Vec.new() }); r }
shared struct Holder { mut held: Option[Node] }
fn esc(n: frozen Node, b: Holder) { b.held = Some(n); }
fn main() { let g = freeze build(); let b = Holder { held: None }; esc(g, b); }
