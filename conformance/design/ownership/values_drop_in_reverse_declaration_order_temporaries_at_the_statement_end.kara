struct Loud { n: String }
impl Drop for Loud {
    fn drop(mut ref self) { println(f"drop {self.n}"); }
}
fn make(n: own String) -> Loud { Loud { n: n } }
fn main() {
    let a = make("a");
    let b = make("b");
    {
        let c = make("c");
        println("inner end");
    }
    println(f"temp {make("t").n.len()}");
    println("after temp");
    let d = make("d");
    println("main end");
}
