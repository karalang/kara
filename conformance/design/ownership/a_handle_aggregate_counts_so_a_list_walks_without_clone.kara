shared struct Node {
    val: i64,
    mut next: Option[Node],
}
fn main() {
    let c = Node { val: 3, next: None };
    let b = Node { val: 2, next: Some(c) };
    let a = Node { val: 1, next: Some(b) };
    let mut cur = Some(a);
    let mut sum = 0;
    while let Some(node) = cur {
        sum = sum + node.val;
        cur = node.next;
    }
    let pair = (a, 10);
    let again = pair;
    println(f"{sum} {pair.0.val} {again.1} {a.val}");
}
