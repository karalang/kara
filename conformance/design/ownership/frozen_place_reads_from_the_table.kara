// design.md §11 What a frozen place permits: each permitted row of the table, summed.
shared struct Deep { d: i64 }
shared struct Inner { deep: Deep }
shared struct Node { val: i64, inner: Inner, mut kids: Vec[Node], mut next: Option[Node], mut count: i64 }
fn leaf(v: i64) -> Node { Node { val: v, inner: Inner { deep: Deep { d: v * 10 } }, kids: Vec.new(), next: None, count: 0 } }
fn build() -> Node { let r = leaf(1); r.kids.push(leaf(2)); r.kids.push(leaf(3)); r.next = Some(leaf(4)); r }
fn g(n: frozen Node) -> i64 { n.val }
fn reads(n: frozen Node) -> i64 {
    let mut t = n.inner.deep.d;
    t += n.kids[1].val;
    t += g(n.kids[0]);
    t += n.kids.len();
    if n.kids.is_empty() { t += 1000; }
    for k in n.kids { t += k.val; }
    for k in n.kids.iter() { t += k.val; }
    let k = n.kids[0];
    t += g(k);
    match n.next { Some(m) => { t += g(m); } None => {} }
    let c = || n.val * 100;
    t += c();
    t
}
fn main() { let g = freeze build(); println(reads(g)); }
