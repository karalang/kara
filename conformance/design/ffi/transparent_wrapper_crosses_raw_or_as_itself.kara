/// libc.
///
/// # Safety
///
/// The declarations match glibc.
unsafe extern "C" {
    pure fn abs(x: i32) -> i32;
}
/// libc, declared over the wrappers.
///
/// # Safety
///
/// labs and llabs take a long; each wrapper is laid out as one.
unsafe extern "C" {
    pure fn labs(x: Wide) -> i64;
    pure fn llabs(x: Neg) -> i64;
}
// design.md §15 (6652-6664, 6694): `.raw()` is the explicit unwrap at the
// boundary; or declare the foreign signature in terms of the wrapper. A
// transparent struct or a distinct type crosses as its one field.
#[repr(transparent)]
distinct type Fd = i32;
#[repr(transparent)]
distinct type Wide = i64;
#[repr(transparent)]
#[derive(Copy, Clone)]
struct Neg { v: i64 }
fn main() {
    let fd = Fd(-3);
    println(f"{abs(fd.raw())} {labs(Wide(-40))} {llabs(Neg { v: -500 })}");
}
