/// libc.
///
/// # Safety
///
/// The declarations match glibc.
unsafe extern "C" {
    pure fn abs(x: i32) -> i32;
}
// design.md §15 (6664): passing a wrapper to a foreign parameter of the
// inner type needs an explicit `.raw()`; the type system tells them apart.
#[repr(transparent)]
distinct type Fd = i32;
fn main() {
    let fd = Fd(-3);
    println(f"{abs(fd)}");
}
