// design.md §15 (6365): no implicit `*mut T` -> `*const T` coercion at a
// call; the mismatch carries a machine-applicable fix inserting ` as *const T`.
fn first(p: *const i64) -> i64 {
    // Safety: callers pass a pointer to a live i64.
    unsafe { *p }
}
fn main() {
    let mut x: i64 = 9;
    let q: *mut i64 = ptr.mut(x);
    println(f"{first(q as *const i64)}");
}
