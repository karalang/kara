// design.md §15 (6242): `unsafe` does not switch off the effect system;
// the enclosing (public) function must still declare what it does.
pub fn show(x: i64) -> i64 {
    let p: *const i64 = ptr.const(x);
    // Safety: p points at the live parameter x.
    unsafe {
        println(f"{*p}");
        *p
    }
}
fn main() { show(1); }
