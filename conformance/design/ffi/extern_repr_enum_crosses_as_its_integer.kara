/// libc.
///
/// # Safety
///
/// The declarations match glibc.
unsafe extern "C" {
    pure fn abs(x: Level) -> i32;
}
// design.md §15 What crosses (6694): a C-like #[repr(intN)] enum crosses
// as its C integer, holding the declared discriminant.
#[repr(i32)]
enum Level { Low = -7, High = 9 }
fn main() { println(f"{abs(Level.Low)} {abs(Level.High)}"); }
