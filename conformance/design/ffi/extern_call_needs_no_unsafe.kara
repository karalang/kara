// design.md §15 (6330, 6706): calling a function declared in an
// `unsafe extern { }` block is not an unsafe operation; no `unsafe { }`.
/// libc.
///
/// # Safety
///
/// labs reads only its argument.
unsafe extern "C" {
    pure fn labs(x: i64) -> i64;
}
fn main() {
    let v = labs(-12);
    println(f"{v}");
}
