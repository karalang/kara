/// libc.
///
/// # Safety
///
/// The declarations match glibc.
unsafe extern "C" {
    pure fn abs(x: i32) -> i32;
    pure fn fabs(x: f64) -> f64;
    pure fn fabsf(x: f32) -> f32;
    pure fn toupper(c: i32) -> i32;
    pure fn llabs(x: i64) -> i64;
}
// design.md §15 What crosses (6694): integers, f32, f64 by value.
fn main() {
    let a = abs(-3);
    let b = fabs(-2.5);
    let c = fabsf(-1.5);
    let d = toupper(97);
    let e = llabs(-9_000_000_000);
    println(f"{a} {b} {c} {d} {e}");
}
