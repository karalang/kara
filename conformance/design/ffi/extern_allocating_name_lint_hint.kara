/// libc.
///
/// # Safety
///
/// The declarations match glibc.
effect resource Heap;
unsafe extern "C" {
    fn strdup(s: *const u8) -> *mut u8 with writes(Stdout);
    fn free(p: *mut u8) with writes(Stdout);
}
// design.md §15 (6746, 6748): the linter flags a known allocating libc
// entry declared without allocates(Heap); still accepted.
fn main() {
    let p = strdup(c"x".as_ptr());
    println(f"{ptr.is_null(p as *const u8)}");
    free(p);
}
