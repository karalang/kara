/// libc.
///
/// # Safety
///
/// The declarations match glibc.
unsafe extern "C" {
    fn usleep(us: u32) -> i32 with writes(Stdout);
}
// design.md §15 (6744, 6748): the linter flags a common omission when a
// name matches a known blocking libc entry; the program is still accepted.
fn main() { println(f"{usleep(1)}"); }
