// design.md §15 #[repr] (6495): C ABI layout: field order preserved, C padding rules.
#[repr(C)]
struct UsbDescriptor {
    length: u8,
    descriptor_type: u8,
    bcd_usb: u16,
    device_class: u8,
}
#[repr(C)]
struct Padded { a: u8, b: u32, c: u8 }
#[repr(C)]
struct Wide { a: u8, b: f64 }
fn main() {
    println(f"{UsbDescriptor.size_of()} {UsbDescriptor.align_of()}");
    println(f"{Padded.size_of()} {Padded.align_of()}");
    println(f"{Wide.size_of()} {Wide.align_of()}");
}
