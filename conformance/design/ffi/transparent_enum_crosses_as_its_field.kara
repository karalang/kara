// design.md §15 #[repr(transparent)] (6616, 6628): a single-variant one-field enum is a
// permitted carrier, identical to its field at every C-ABI boundary, as an argument too.
/// libc.
///
/// # Safety
///
/// abs takes an int; Only is laid out as one.
unsafe extern "C" {
    pure fn abs(x: Only) -> i32;
}
#[repr(transparent)]
enum Only { V(i32) }
fn main() {
    println(f"{Only.size_of()} {abs(Only.V(-9))}");
}
