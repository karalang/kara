// design.md §6 Assignment and core-semantics.md §8.2: the place's operands once, then the value.
fn ix(tag: String, i: i64) -> i64 {
    println(tag);
    i
}
fn val(tag: String, v: i64) -> i64 {
    println(tag);
    v
}
fn main() {
    let mut v: Vec[i64] = [1, 2, 3];
    v[ix("place", 0)] = val("value", 10);
    v[ix("compound-place", 1)] += val("compound-value", 5);
    println(f"{v[0]} {v[1]} {v[2]}");
}
