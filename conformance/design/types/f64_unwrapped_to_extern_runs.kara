// design.md §5 Floats: control, `f32` and `f64` cross `extern` boundaries directly.
/// # Safety
/// `fabs` reads only its argument.
unsafe extern "C" { fn fabs(x: f64) -> f64; }
fn main() {
    let w = F64.from(-1.5);
    // Safety: fabs is pure.
    let r = unsafe { fabs(w.value) };
    println(f"{r}");
}
