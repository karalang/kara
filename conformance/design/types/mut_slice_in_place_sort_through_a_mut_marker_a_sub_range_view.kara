// design.md conformance (moved from the shared folder's design-5-7): mut Slice: in-place sort through a mut marker, a sub-range view
fn bump(xs: mut Slice[i64]) { for i in 0..xs.len() { xs[i] += 100; } }
fn main() {
    let mut v = [3, 1, 4, 1, 5];
    bump(mut v[1..4]);
    println(f"{v}");
    bump(mut v);
    println(f"{v}");
}
