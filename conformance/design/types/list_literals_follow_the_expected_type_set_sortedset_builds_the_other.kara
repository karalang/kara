// design.md conformance (moved from the shared folder's design-5-7): list literals follow the expected type: Set, SortedSet; == builds the other side's type
fn main() {
    let s: Set[i64] = [3, 1, 3];
    let t: SortedSet[i64] = [3, 1, 2];
    let m: Array[u8, 4] = [75, 82, 69, 67];
    println(f"{s.len()} {t} {m != [75, 82, 69, 67]} {s == [1, 3]}");
}
