// design.md conformance (moved from the shared folder's design-5-7): size_of: primitives, a repr(transparent) distinct type, Option[dyn Trait] is two words
trait Shape { fn area(self) -> f64; }
type OptShape = Option[dyn Shape];
type DynShape = dyn Shape;
#[repr(transparent)]
distinct type Fd = i32;
fn main() {
    println(f"{i8.size_of()} {u16.size_of()} {i64.size_of()} {f32.size_of()} {char.size_of()} {bool.size_of()}");
    println(f"{Fd.size_of()} {OptShape.size_of()} {DynShape.size_of()}");
}
