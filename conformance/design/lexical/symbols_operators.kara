fn main() {
    let a = 17;
    let b = 5;
    println(f"{a + b} {a - b} {a * b} {a / b} {a % b}");
    println(f"{a == b} {a != b} {a < b} {a <= b} {a > b} {a >= b}");
    println(f"{a & b} {a | b} {a ^ b} {~a} {a << 2} {a >> 1}");
    let mut x = 6;
    x += 4; x -= 1; x *= 3; x /= 2; x %= 7;
    println(x);
    let mut y = 12;
    y &= 10; y |= 1; y ^= 3; y <<= 2; y >>= 1;
    println(y);
    let mut n = 0;
    for i in 0..3 { n += i; }
    for i in 0..=3 { n += i; }
    println(n);
    let o: Option[i64] = None;
    println(o ?? 9);
}
