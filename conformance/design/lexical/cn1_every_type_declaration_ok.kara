struct UserAccount { id: i64 }
enum IoError { InvalidUtf8, NotFound }
trait Shape { fn area(self) -> i64; }
impl Shape for UserAccount { fn area(self) -> i64 { self.id } }
type UserId = i64;
distinct type Meters = f64;
effect resource Ledger;
struct Pair[A, B] { a: A, b: B }
fn main() {
    let u = UserAccount { id: 4 };
    let id: UserId = 7;
    let m = Meters(2.5);
    let p = Pair { a: 1, b: true };
    let e = IoError.NotFound;
    let k = match e { IoError.InvalidUtf8 => 0, IoError.NotFound => 1 };
    println(u.area() + id + k);
    println(p.b);
}
