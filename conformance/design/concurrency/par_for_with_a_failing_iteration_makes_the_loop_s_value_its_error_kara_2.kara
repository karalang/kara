
fn step(i: i64) -> Result[i64, String] {
    if i == 1 { Err("stop".to_string()) } else { Ok(i) }
}
fn run() -> Result[Vec[i64], String] { let v = par for i in 0..5 { step(i)? }; Ok(v) }
fn main() { println(f"{run()}"); }
// design.md conformance (moved from the shared folder's design-10-13): par for with ?: a failing iteration makes the loop's value its error (KARAC_THREADS=4)
