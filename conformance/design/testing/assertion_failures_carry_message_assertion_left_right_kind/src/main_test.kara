test "assert fails" { let x = 2; assert(x > 3); }
test "eq fails" { let v = 4; assert_eq(v, 5); }
test "ne fails" { assert_ne(7, 7); }
test "msg" { assert(1 == 2, "custom words"); }
test "eq msg" { assert_eq(1, 2, "eq words"); }
// design.md §14 conformance: Assertion messages: `assert` names the source text; `assert_eq` adds left/right lines; `assert_ne` adds a value line; the `assertion`, `left`, `right` and `kind` fields; a custom message replaces the first line and keeps the operand lines.
