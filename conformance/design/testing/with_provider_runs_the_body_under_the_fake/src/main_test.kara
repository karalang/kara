struct FakeClock { t: i64 }
impl ClockProvider for FakeClock { fn now(ref self) -> i64 { self.t } }
fn refuse() -> Result[FakeClock, String] { Err("refused") }
fn boom() -> FakeClock { panic("ctor") }
#[with_provider(Clock, FakeClock { t: 5 })]
test "fake clock" { assert(Clock.now() == 5); }
#[with_provider(Clock, FakeClock { t: 5 })]
test "provider body fails" { assert(false); }
#[with_provider(Clock, refuse())]
test "ctor err" { println("body ran"); }
#[with_provider(Clock, boom())]
test "ctor panics" { println("body ran"); }
// design.md §14 conformance: `#[with_provider(R, e)]` runs the body inside `with_provider`; a failure lists `providers`; `e` that is `Err` or panics fails the case before its body with `provider_construction_failed`, `resource`, `duration_ms: 0`.
