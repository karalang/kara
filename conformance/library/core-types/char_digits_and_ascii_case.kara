fn main() {
    println('7'.to_digit(10) ?? 99);
    println('f'.to_digit(16) ?? 99);
    println('g'.to_digit(16).is_none());
    println('z'.is_digit(36));
    println(char.from_digit(11, 16) ?? '?');
    println('a'.eq_ignore_ascii_case('A'));
    println('é'.eq_ignore_ascii_case('É'));
    let b: u8 = 65;
    println(b.to_ascii_lowercase());
    println(b.eq_ignore_ascii_case(97));
}
