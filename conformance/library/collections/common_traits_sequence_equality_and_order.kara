fn main() {
    let a: Vec[i64] = [1, 2].to_vec();
    let b: Vec[i64] = [1, 2].to_vec();
    let c: Vec[i64] = [1, 3].to_vec();
    let d: Vec[i64] = [1, 2, 0].to_vec();
    println(a == b);
    println(a != c);
    println(a < c);
    println(a < d);
    println(a.cmp(d) == Ordering.Less);
    let x: Array[i64, 2] = [1, 2];
    let y: Array[i64, 2] = [1, 2];
    println(x == y);
    let mut p: VecDeque[i64] = VecDeque.new();
    p.push_back(1);
    let mut q: VecDeque[i64] = VecDeque.new();
    q.push_back(2);
    println(p < q);
    println(a.as_slice() == b.as_slice());
}
