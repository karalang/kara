fn main() {
    let s: Vec[i64] = [1, 3, 5, 8, 13].to_vec();
    println(s.binary_search(8) ?? -1);
    println(s.binary_search(4) ?? -1);
    println(s.binary_search(0) ?? -1);
    println(s.binary_search(99) ?? -1);
    let d: Vec[i64] = [2, 2, 2].to_vec();
    let i = d.binary_search(2) ?? -1;
    println(i >= 0 and i <= 2);
    println(s.partition_point(|x| x < 5));
    println(s.partition_point(|x| x < 0));
    println(s.partition_point(|x| x < 100));
    let e: Vec[i64] = Vec.new();
    println(e.partition_point(|x| x < 1));
}
