import std.hash.{FxBuildHasher};

fn main() {
    let d: Map[i64, i64] = Map.from([(1, 2)].to_vec());
    println(f"d {d[1]}");
    let x: Map[i64, i64, FxBuildHasher] = Map.from([(5, 6)].to_vec());
    println(f"x {x[5]}");
    let c: Map[i64, i64] = (0..3).map(|i| (i, i)).collect();
    println(f"c {c[2]}");
}
