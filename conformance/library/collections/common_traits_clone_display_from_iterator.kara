fn main() {
    let v: Vec[i64] = [1, 2].to_vec();
    let a: Array[i64, 2] = [3, 4];
    let mut d: VecDeque[i64] = VecDeque.new();
    d.push_back(5);
    let m: SortedMap[i64, String] = SortedMap.from([(1, "a".to_string()), (2, "b".to_string())]);
    let s: SortedSet[i64] = SortedSet.from([2, 1]);
    let one: Map[i64, i64] = Map.from([(1, 2)]);
    let os: Set[i64] = Set.from([9]);
    println(v);
    println(a);
    println(v.as_slice());
    println(d);
    println(m);
    println(s);
    println(one);
    println(os);
    let ev: Vec[i64] = Vec.new();
    let em: SortedMap[i64, i64] = SortedMap.new();
    let es: Set[i64] = Set.new();
    println(ev);
    println(em);
    println(es);
    let c = m.clone();
    println(c == m);
    let pq: PriorityQueue[i64] = [3, 1, 2].to_vec().into_iter().collect();
    println(pq.peek() ?? -1);
    let col: SortedSet[i64] = [5, 4].to_vec().into_iter().collect();
    println(col);
}
