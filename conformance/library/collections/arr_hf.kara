import std.hash.{Hasher, BuildHasher};
import std.hash.{FxBuildHasher};
struct Rec { n: u64 }
impl Hasher for Rec {
    fn write(mut ref self, bytes: Slice[u8]) { for b in bytes.iter() { self.n = self.n.wrapping_mul(31).wrapping_add(*b as u64); } }
    fn finish(self) -> u64 { self.n }
}
struct RecBuild {}
impl BuildHasher for RecBuild {
    type Hasher = Rec;
    fn build(self) -> Rec { Rec { n: 7 } }
}
fn main() {
    let m: Map[String, i64, RecBuild] = Map.from([("a".to_string(), 1), ("b".to_string(), 2)].to_vec());
    let s: Set[i64, RecBuild] = Set.from([4, 5].to_vec());
    let f: Map[i64, i64, FxBuildHasher] = Map.from([(1, 2)].to_vec());
    let mut g: Map[String, i64, RecBuild] = Map.new();
    g.insert("k".to_string(), 1);
    match g.get_mut("k") { Some(r) => { *r += 1; }, None => {} }
    let d: Map[i64, i64] = Map.from([(1, 2)].to_vec());
    let mut e: Map[i64, i64] = Map.new();
    e.extend([(3, 4)].to_vec());
    e.retain(|k, v| true);
    match e.get_mut(3) { Some(r) => { *r += 1; }, None => {} }
    let mut t: Set[i64] = Set.from([1, 2].to_vec());
    t.retain(|x| x != 1);
    t.extend([7].to_vec());
    println(f"{m["a"]} {m.get("b") ?? -1} {s.contains(5)} {f[1]} {g["k"]} {d[1]} {e[3]} {t.contains(2)} {t.contains(7)} {t.contains(1)}");
}
