fn main() {
    let mut v: Vec[i64] = [1, 2, 3].to_vec();
    v.reverse();
    println(v);
    v.swap(0, 2);
    println(v);
    v.swap(1, 1);
    println(v);
    v.fill(7);
    println(v);
    let mut s: Vec[String] = ["a".to_string(), "b".to_string()].to_vec();
    s.swap(0, 1);
    println(s);
}
