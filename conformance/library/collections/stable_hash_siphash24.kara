import std.hash.{StableHash};

fn content_id(payload: Str) -> u64 { StableHash.siphash24(payload.bytes(), 0, 0) }
fn main() {
    println(content_id("") == content_id(""));
    let key0: u64 = 0x0706050403020100;
    let key1: u64 = 0x0f0e0d0c0b0a0908;
    let mut b: Vec[u8] = Vec.new();
    println(f"{StableHash.siphash24(b, key0, key1):x}");
    for i in 0..15 { b.push(i as u8); }
    println(f"{StableHash.siphash24(b, key0, key1):x}");
}
