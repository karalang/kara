fn run() -> Result[(), AllocError] {
    let mut w: Vec[i64] = Vec.try_with_capacity(1024)?;
    w.try_push(42)?;
    w.try_insert(0, 41)?;
    w.try_extend([43, 44])?;
    w.try_extend_from_slice([45])?;
    w.try_reserve(10)?;
    w.try_reserve_exact(10)?;
    w.try_resize(6, 0)?;
    let c = w.try_clone()?;
    println(c);
    let it: Vec[i64] = Vec.try_from_iter((0..3).map(|x| x))?;
    println(it);
    let mut s = String.try_with_capacity(4)?;
    s.try_push('a')?;
    s.try_push_str("bc")?;
    s.try_reserve(3)?;
    println(s.try_clone()?);
    let mut m: Map[i64, i64] = Map.new();
    println(m.try_insert(1, 2)?.is_none());
    println(m.try_insert(1, 3)? ?? -1);
    let mut st: Set[i64] = Set.new();
    println(st.try_insert(1)?);
    println(st.try_insert(1)?);
    let mut d: VecDeque[i64] = VecDeque.try_with_capacity(2)?;
    d.try_insert(0, 7)?;
    let mut ss: SortedSet[i64] = SortedSet.new();
    println(ss.try_insert(3)?);
    m.try_reserve(4)?;
    Ok(())
}
fn main() {
    match run() { Ok(()) => println("ok"), Err(e) => println(e) }
}
