// `windows` and `chunks` walked where they are written, by `into_iter()` or
// by `for`, give the same runs in the same order as the collected `Vec`
// (B-2026-11-20-109), with the iterator surface a `Vec`'s has.
fn main() {
    let v: Vec[i64] = [1, 2, 3, 4, 5].to_vec();
    let w: Vec[Slice[i64]] = v.windows(3).into_iter().collect();
    println(w);
    let c: Vec[Slice[i64]] = v.chunks(2).into_iter().rev().collect();
    println(c);
    println(v.windows(2).into_iter().filter(|p| p[0] < p[1]).count());
    println(v.windows(6).into_iter().len());
    println(v.chunks(5).into_iter().len());
    let mut it = v.chunks(2).into_iter();
    println(it.next());
    println(it.next_back());
    println(it.len());
    for p in v.as_slice().windows(4) {
        println(p);
    }
    for r in v.chunks(3) {
        println(r.len());
    }
    let names: Vec[String] = ["a".to_string(), "b".to_string(), "c".to_string()].to_vec();
    for p in names.windows(2).into_iter() {
        println(f"{p[0]}{p[1]}");
    }
    let stored = v.windows(2);
    println(stored.len());
}
