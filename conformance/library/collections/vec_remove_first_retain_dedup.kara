fn main() {
    let mut v: Vec[i64] = [1, 4, 2, 4, 6].to_vec();
    println(v.remove_first(|x| x == 4) ?? -1);
    println(v);
    println(v.remove_first(|x| x == 9) ?? -1);
    v.retain(|x| x % 2 == 0);
    println(v);
    let mut d: Vec[i64] = [1, 1, 2, 1, 3, 3].to_vec();
    d.dedup();
    println(d);
}
