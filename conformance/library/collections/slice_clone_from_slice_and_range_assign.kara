fn main() {
    let mut v: Vec[String] = ["a".to_string(), "b".to_string(), "c".to_string()].to_vec();
    let src: Vec[String] = ["x".to_string(), "y".to_string()].to_vec();
    v[1..3].clone_from_slice(src);
    println(v);
    let mut n: Vec[i64] = [0, 0, 0, 0].to_vec();
    let m: Vec[i64] = [7, 8].to_vec();
    n[1..3] = m;
    println(n);
    n[0] = 5;
    println(n);
}
