// VecDeque, PriorityQueue, iteration, Display, equality and ordering, fallible twins.
fn vs(v: Slice[i64]) -> String {
    let mut o = "[".to_string();
    let mut first = true;
    for x in v.iter() { if not first { o.push_str(","); } first = false; o.push_str(f"{*x}"); }
    o.push_str("]");
    o
}
fn oi(x: Option[i64]) -> String { match x { Some(n) => f"Some({n})", None => "None".to_string() } }
fn orf(x: Option[ref i64]) -> String { match x { Some(n) => f"Some({*n})", None => "None".to_string() } }
fn dq(d: ref VecDeque[i64]) -> String { let v: Vec[i64] = d.iter().cloned().collect(); vs(v.as_slice()) }

fn main() {
    let mut d: VecDeque[i64] = VecDeque.with_capacity(-1);
    d.push_back(2); d.push_back(3); d.push_front(1); d.push_front(0);
    println(f"deque={dq(d)} front={orf(d.front())} back={orf(d.back())} get1={orf(d.get(1))} get4={orf(d.get(4))} get-1={orf(d.get(-1))} len={d.len()}");
    println(f"pop_front={oi(d.pop_front())} pop_back={oi(d.pop_back())} after={dq(d)} contains2={d.contains(2)} contains9={d.contains(9)}");
    d.insert(0, 10); d.insert(3, 30); d.insert(2, 20);
    println(f"insert={dq(d)}");
    println(f"remove1={d.remove(1)} after={dq(d)}");
    d.swap(0, 3); println(f"swap={dq(d)}");
    d.extend([5, 6, 7].to_vec()); d.retain(|x| x != 6);
    println(f"extend+retain={dq(d)}");
    d.truncate(99); d.truncate(4); println(f"truncate4={dq(d)}");
    for x in d.iter_mut() { *x += 1; }
    println(f"iter_mut={dq(d)} display={d}");
    let dv: Vec[i64] = d.clone().into_iter().collect();
    d.truncate(-2); println(f"truncate-2={dq(d)} empty={d.is_empty()} pop={oi(d.pop_front())}");
    let mut ring: VecDeque[i64] = VecDeque.new();
    for i in 0..5 { ring.push_back(i); }
    for _ in 0..3 { let _ = ring.pop_front(); }
    for i in 5..9 { ring.push_back(i); }
    ring.push_front(-1);
    let rr: Vec[i64] = ring.iter().cloned().rev().collect();
    println(f"wrapped={dq(ring)} into_iter={vs(dv.as_slice())} rev={vs(rr.as_slice())}");
    let d2: VecDeque[i64] = [1, 2].to_vec().into_iter().collect();
    let d3: VecDeque[i64] = [1, 2].to_vec().into_iter().collect();
    let d4: VecDeque[i64] = [1, 3].to_vec().into_iter().collect();
    println(f"deque eq={d2 == d3} ne={d2 != d4} lt={d2 < d4}");
    match VecDeque.try_with_capacity(4) { Ok(x) => { let y: VecDeque[i64] = x; println(f"try_with_capacity ok len={y.len()}"); } Err(_) => println("try err") }
    // PriorityQueue
    let mut pq: PriorityQueue[i64] = PriorityQueue.new();
    pq.push(5); pq.push(1); pq.push(4); pq.push(1);
    println(f"pq peek={orf(pq.peek())} len={pq.len()} pop={oi(pq.pop())} pop={oi(pq.pop())} pop={oi(pq.pop())} len={pq.len()}");
    let mut mx: PriorityQueue[i64] = PriorityQueue.max_first();
    mx.push(5); mx.push(9); mx.push(2);
    println(f"max peek={orf(mx.peek())} pop={oi(mx.pop())}");
    let srt = PriorityQueue.from([9, 7, 8, 1, 3].to_vec()).into_sorted_vec();
    let srtm = PriorityQueue.max_first_from([9, 7, 8, 1, 3].to_vec()).into_sorted_vec();
    println(f"into_sorted_vec={vs(srt.as_slice())} max={vs(srtm.as_slice())}");
    let h = PriorityQueue.from([9, 7, 8, 1, 3].to_vec());
    let it: Vec[i64] = h.iter().cloned().collect();
    let iv = h.clone().into_vec();
    let ii: Vec[i64] = h.clone().into_iter().collect();
    let mut fo: Vec[i64] = Vec.new();
    for x in h.iter() { fo.push(*x); }
    println(f"pq own order iter={vs(it.as_slice())} into_vec={vs(iv.as_slice())} into_iter={vs(ii.as_slice())} for={vs(fo.as_slice())} display={h}");
    let mut ep: PriorityQueue[i64] = PriorityQueue.new();
    println(f"empty pq peek={orf(ep.peek())} pop={oi(ep.pop())} empty={ep.is_empty()} display={ep}");
    let mut cl = PriorityQueue.from([3, 1].to_vec()); cl.clear(); println(f"clear len={cl.len()}");
    // Display
    let v: Vec[i64] = [1, 2].to_vec();
    let e: Vec[i64] = Vec.new();
    let a: Array[i64, 2] = [3, 4];
    let sm: SortedMap[i64, String] = SortedMap.from([(2, "b".to_string()), (1, "a".to_string())].to_vec());
    let st: SortedSet[i64] = SortedSet.from([2, 1].to_vec());
    let one: Map[String, i64] = Map.from([("k".to_string(), 1)].to_vec());
    let os: Set[i64] = Set.from([7].to_vec());
    let em: Map[String, i64] = Map.new();
    let es: Set[i64] = Set.new();
    let vstr: Vec[String] = ["x".to_string(), "y z".to_string()].to_vec();
    println(f"display vec={v} empty={e} array={a} slice={v.as_slice()} sm={sm} sset={st} map1={one} set1={os} emap={em} eset={es} strings={vstr}");
    let nested: Vec[Vec[i64]] = [[1].to_vec(), Vec.new()].to_vec();
    println(f"nested={nested}");
    // equality / ordering
    let w: Vec[i64] = [1, 2].to_vec();
    let x: Vec[i64] = [1, 2, 0].to_vec();
    let y: Vec[i64] = [1, 3].to_vec();
    println(f"vec eq={v == w} lt prefix={w < x} lt={x < y} gt={y > x} cmp={w.cmp(x) == Ordering.Less} empty lt={e < w}");
    let a2: Array[i64, 2] = [3, 4];
    println(f"array eq={a == a2} slice eq={v.as_slice() == w.as_slice()}");
    let m1: Map[String, i64] = Map.from([("a".to_string(), 1), ("b".to_string(), 2)].to_vec());
    let m2: Map[String, i64] = Map.from([("b".to_string(), 2), ("a".to_string(), 1)].to_vec());
    let m3: Map[String, i64] = Map.from([("b".to_string(), 3), ("a".to_string(), 1)].to_vec());
    let s1: Set[i64] = Set.from([1, 2, 3].to_vec());
    let s2: Set[i64] = Set.from([3, 2, 1].to_vec());
    let s3: Set[i64] = Set.from([3, 2].to_vec());
    let sm2: SortedMap[i64, String] = SortedMap.from([(1, "a".to_string()), (2, "b".to_string())].to_vec());
    let st2: SortedSet[i64] = SortedSet.from([1, 2].to_vec());
    println(f"map eq={m1 == m2} ne={m1 != m3} set eq={s1 == s2} ne={s1 != s3} sm eq={sm == sm2} sset eq={st == st2}");
    // fallible twins
    let mut f: Vec[i64] = Vec.new();
    let r1 = f.try_push(1).is_ok();
    let r2 = f.try_insert(0, 0).is_ok();
    let r3 = f.try_extend([2, 3].to_vec()).is_ok();
    let r4 = f.try_extend_from_slice(v.as_slice()).is_ok();
    let r5 = f.try_reserve(10).is_ok();
    let r6 = f.try_reserve_exact(1).is_ok();
    let r7 = f.try_resize(8, 9).is_ok();
    let fc = match f.try_clone() { Ok(c) => c.len(), Err(_) => -1 };
    println(f"try_* ok={r1}{r2}{r3}{r4}{r5}{r6}{r7} f={vs(f.as_slice())} try_clone len={fc}");
    let big: Result[Vec[i64], AllocError] = Vec.try_with_capacity(9223372036854775807);
    match big { Ok(_) => println("huge ok?"), Err(err) => println(f"huge capacity err={err}") }
    let mut g: Vec[i64] = Vec.new();
    match g.try_reserve(9223372036854775807) { Ok(_) => println("huge reserve ok?"), Err(err) => println(f"huge reserve err={err} eq={err == AllocError.CapacityOverflow}") }
    let tf: Result[Vec[i64], AllocError] = Vec.try_from_iter(0..3);
    println(f"try_from_iter={match tf { Ok(t) => vs(t.as_slice()), Err(_) => "err".to_string() }}");
    let mut tm: Map[String, i64] = Map.new();
    let i1 = tm.try_insert("a".to_string(), 1);
    let i2 = tm.try_insert("a".to_string(), 2);
    println(f"map try_insert={match i1 { Ok(o) => oi(o), Err(_) => "err".to_string() }},{match i2 { Ok(o) => oi(o), Err(_) => "err".to_string() }}");
    let mut ts: Set[i64] = Set.new();
    println(f"set try_insert={ts.try_insert(1).unwrap()},{ts.try_insert(1).unwrap()}");
    let mut s: String = String.new();
    let sr = s.try_push('a').is_ok() and s.try_push_str("bc").is_ok() and s.try_reserve(4).is_ok();
    println(f"string try={sr} s={s} oom display={AllocError.OutOfMemory { requested_bytes: 64 }}");
}
