fn main() {
    let mut v: Vec[(i64, i64)] = [(2, 0), (1, 1), (2, 2), (1, 3)].to_vec();
    v.sort_by_key(|p| p.0);
    println(v);
    let mut w: Vec[(i64, i64)] = [(2, 0), (1, 1), (2, 2), (1, 3)].to_vec();
    w.sort_by(|a, b| b.0.cmp(a.0));
    println(w);
    let mut n: Vec[i64] = [3, 1, 2].to_vec();
    n.sort();
    println(n);
    let mut f: Vec[f64] = [2.5, -1.0, 0.5].to_vec();
    f.sort_by(f64.total_cmp);
    println(f);
}
