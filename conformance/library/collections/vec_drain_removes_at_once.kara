fn main() {
    let mut v: Vec[i64] = [1, 2, 3, 4, 5].to_vec();
    let got: Vec[i64] = v.drain(1..3).collect();
    println(got);
    println(v);
    let _ = v.drain(0..1);
    println(v);
    let mut w: Vec[i64] = [1, 2].to_vec();
    let none: Vec[i64] = w.drain(2..2).collect();
    println(none.len());
}
