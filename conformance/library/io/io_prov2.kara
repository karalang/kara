// Stdin override: read_to_string not implemented panics naming stream and method.
import std.io.{StdinProvider};

struct In {}
impl StdinProvider for In {}
fn main() {
    with_provider[Stdin](In {}, || {
        match stdin.read_to_string() { Ok(s) => println(f"got {q(s)}"), Err(e) => println(f"err[{e}]") }
    });
}

fn q(s: Str) -> String {
    let mut o = "\"".to_string();
    for c in s.chars() {
        if c == '\n' { o.push_str("\\n"); }
        else if c == '\r' { o.push_str("\\r"); }
        else if c == '\t' { o.push_str("\\t"); }
        else if c == '\0' { o.push_str("\\0"); }
        else if c == '"' { o.push_str("\\\""); }
        else { o.push(c); }
    }
    o.push_str("\"");
    o
}
fn qv(v: ref Vec[String]) -> String {
    let mut o = "[".to_string();
    let mut first = true;
    for s in v {
        if not first { o.push_str(", "); }
        first = false;
        o.push_str(q(s));
    }
    o.push_str("]");
    o
}
fn qo(x: Option[i32]) -> String { match x { Some(n) => f"Some({n})", None => "None".to_string() } }
