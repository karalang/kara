import std.net.{TcpListener, TcpStream, NetError};
fn kind(e: NetError) -> Str {
    match e {
        NetError.InvalidInput => "InvalidInput",
        NetError.TimedOut => "TimedOut",
        NetError.UnexpectedEof => "UnexpectedEof",
        _ => "other",
    }
}
fn main() {
    let l = TcpListener.bind("127.0.0.1:0").unwrap();
    let c = TcpStream.connect(l.local_addr().unwrap()).unwrap();
    let s = l.accept().unwrap();
    let mut none: Vec[u8] = Vec.new();
    println(s.read_exact(mut none).is_ok());
    c.write_all("ab".bytes()).unwrap();
    drop(c);
    let mut buf = [0u8; 4];
    match s.read_exact(mut buf) {
        Ok(_) => println("full"),
        Err(e) => println(f"{kind(e)} {buf[0]} {buf[1]}"),
    }
}
