fn sum(xs: Slice[i64]) -> i64 {
    let mut acc = 0;
    for x in xs { acc = acc + x; }
    acc
}

fn sort_in_place(xs: mut Slice[i64]) {
    xs.sort();
}

fn main() {
    let v: Vec[i64] = [1, 2, 3, 4];
    let a: Array[i64, 3] = [10, 20, 30];
    println(f"{sum(v)} {sum(a)} {sum(v[1..3])}");
    let s = v.as_slice();
    let f = || sum(s);
    println(f"{f()}");
    let mut w = [3, 1, 4, 1, 5];
    sort_in_place(mut w[1..4]);
    println(f"{w}");
    sort_in_place(mut w);
    println(f"{w}");
}
