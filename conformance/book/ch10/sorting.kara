fn main() {
    let mut v = [3, 1, 4, 1, 5, 9, 2, 6];
    v.sort();
    println(f"{v}");
    v.sort_by(|a, b| a.cmp(b));
    println(f"{v}");
    v.sort_by(|a, b| b.cmp(a));
    println(f"{v}");
    let mut pairs: Vec[(i64, i64)] = [(1, 5), (2, 9), (3, 1)];
    pairs.sort_by(|a, b| b.1.cmp(a.1));
    println(f"{pairs}");
}
