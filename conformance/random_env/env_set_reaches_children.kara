import std.process.{Command};
fn main() {
    env.set("KARA_TRE_CHILD", "seen");
    match Command.new("sh").args(["-c", "echo $KARA_TRE_CHILD"]).output() {
        Ok(o) => print(String.from_utf8(o.stdout).unwrap_or("?".to_string())),
        Err(e) => println(f"err {e}"),
    }
    println(env.var("KARA_TRE_CHILD").unwrap_or("unset".to_string()));
}
