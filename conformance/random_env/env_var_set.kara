import std.process.{Command};

fn port() -> i64 {
    match env.var("PORT") {
        Ok(s) => i64.parse(s).unwrap_or(8080),
        Err(_) => 8080,
    }
}

fn show(name: Str) {
    match env.var(name) {
        Ok(v) => println(f"{name}=[{v}]"),
        Err(VarError.NotPresent) => println(f"{name} not present"),
        Err(VarError.NotUnicode) => println(f"{name} not unicode"),
    }
}

fn main() {
    show("KARA_CONF_SET");
    show("KARA_CONF_EMPTY");
    show("KARA_CONF_UNSET");
    show("KARA_CONF_BAD");
    println(f"{port()}");
    env.set("PORT", "9090");
    println(f"{port()}");
    env.set("KARA_CONF_UNSET", "now set = with equals");
    show("KARA_CONF_UNSET");
    env.set("KARA_CONF_SET", "");
    show("KARA_CONF_SET");
    // A child started afterwards sees the variable.
    let out = Command.new("sh").arg("-c").arg("printf '%s' \"$KARA_CONF_UNSET\"").output().unwrap();
    let text = String.from_utf8(out.stdout).unwrap_or("?");
    println(f"child sees [{text}]");
}
