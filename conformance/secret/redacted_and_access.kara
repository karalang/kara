import std.secret.{Secret};

#[derive(Debug)]
struct User {
    name: String,
    token: Secret[String],
}

// secret.md: a derived Debug prints a Secret field as `<redacted>`; expose
// and expose_mut are the way in; ct_eq compares every byte.
fn main() {
    let mut u = User { name: "alice".to_string(), token: Secret.new("s3cret".to_string()) };
    println(u.fmt_debug());
    println(u.token.expose());
    u.token.expose_mut().push_str("!");
    println(u.token.expose());
    let a: Secret[String] = Secret.new("s3cret!".to_string());
    let b: Secret[String] = Secret.new("s3cret?".to_string());
    println(u.token.ct_eq(a));
    println(u.token.ct_eq(b));
    let v1: Secret[Vec[u8]] = Secret.new([1u8, 2u8, 3u8]);
    let v2: Secret[Vec[u8]] = Secret.new([1u8, 2u8]);
    println(v1.ct_eq(v2));
}
