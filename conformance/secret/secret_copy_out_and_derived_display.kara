import std.secret.{Secret};
#[derive(Display)]
struct Login { user: String, pass: Secret[String] }
fn main() {
    let a: Secret[String] = Secret.new("pw".to_string());
    let plain: String = a.expose().clone();
    drop(a);
    println(plain);
    let l = Login { user: "ada".to_string(), pass: Secret.new("hunter2".to_string()) };
    println(f"{l}");
}
