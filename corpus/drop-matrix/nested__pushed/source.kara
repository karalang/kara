struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
struct W { k: i64, a: R, b: R }
impl Drop for W { fn drop(mut ref self) { println(f"w{self.k}"); } }
struct Q { w: W, t: (R, R) }
fn main() {
    let mut v: Vec[Q] = [];
    v.push(Q { w: W { k: 1, a: R { id: 11 }, b: R { id: 21 } }, t: (R { id: 31 }, R { id: 41 }) });
    v.push(Q { w: W { k: 2, a: R { id: 12 }, b: R { id: 22 } }, t: (R { id: 32 }, R { id: 42 }) });
    println("end");
}
