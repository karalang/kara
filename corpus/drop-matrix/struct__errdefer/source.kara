struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
struct P { a: R, b: R, c: R }
fn f(fail: bool) -> Result[i64, i64] {
    let x = P { a: R { id: 1 }, b: R { id: 11 }, c: R { id: 21 } };
    errdefer {
        println("rollback");
    }
    let y = P { a: R { id: 2 }, b: R { id: 12 }, c: R { id: 22 } };
    if fail {
        return Err(1);
    }
    Ok(0)
}
fn main() {
    let _ = f(false);
    println("--");
    let _ = f(true);
}
