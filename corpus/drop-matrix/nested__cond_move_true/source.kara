struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
struct W { k: i64, a: R, b: R }
impl Drop for W { fn drop(mut ref self) { println(f"w{self.k}"); } }
struct Q { w: W, t: (R, R) }
fn consume(x: Q) {
    let l = R { id: 9 };
    println("in");
}
fn f(c: bool) {
    let x = Q { w: W { k: 1, a: R { id: 11 }, b: R { id: 21 } }, t: (R { id: 31 }, R { id: 41 }) };
    if c {
        consume(x);
    }
    println("end");
}
fn main() {
    f(true);
    println("after");
}
