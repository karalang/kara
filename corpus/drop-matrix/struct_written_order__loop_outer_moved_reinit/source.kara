struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
struct P { a: R, b: R, c: R }
fn consume(x: own P) {
    let l = R { id: 9 };
    println("in");
}
fn main() {
    let mut x = P { c: R { id: 25 }, a: R { id: 5 }, b: R { id: 15 } };
    for i in 0..2 {
        consume(x);
        x = P { c: R { id: i + 20 }, a: R { id: i + 0 }, b: R { id: i + 10 } };
    }
    println("done");
}
