struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
struct P { a: R, b: R, c: R }
fn consume(x: P) {
    let l = R { id: 9 };
    println("in");
}
fn f(c: bool) {
    let x = P { a: R { id: 1 }, b: R { id: 11 }, c: R { id: 21 } };
    if c {
        consume(x);
    }
    println("end");
}
fn main() {
    f(false);
    println("after");
}
