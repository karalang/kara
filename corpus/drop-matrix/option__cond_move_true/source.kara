struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
fn consume(x: own Option[R]) {
    let l = R { id: 9 };
    println("in");
}
fn f(c: bool) {
    let x = Some(R { id: 1 });
    if c {
        consume(x);
    }
    println("end");
}
fn main() {
    f(true);
    println("after");
}
