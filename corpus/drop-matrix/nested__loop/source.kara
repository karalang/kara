struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
struct W { k: i64, a: R, b: R }
impl Drop for W { fn drop(mut ref self) { println(f"w{self.k}"); } }
struct Q { w: W, t: (R, R) }
fn main() {
    for i in 0..2 {
        let x = Q { w: W { k: i + 0, a: R { id: i + 10 }, b: R { id: i + 20 } }, t: (R { id: i + 30 }, R { id: i + 40 }) };
        println("it");
    }
    println("done");
}
