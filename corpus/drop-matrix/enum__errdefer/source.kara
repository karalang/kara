struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
enum E { Two(R, R), One(R) }
fn f(fail: bool) -> Result[i64, i64] {
    let x = E.Two(R { id: 1 }, R { id: 11 });
    errdefer {
        println("rollback");
    }
    let y = E.Two(R { id: 2 }, R { id: 12 });
    if fail {
        return Err(1);
    }
    Ok(0)
}
fn main() {
    let _ = f(false);
    println("--");
    let _ = f(true);
}
