struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
struct W { k: i64, a: R, b: R }
impl Drop for W { fn drop(mut ref self) { println(f"w{self.k}"); } }
fn consume(x: W) {
    let l = R { id: 9 };
    println("in");
}
fn main() {
    let mut x = W { k: 5, a: R { id: 15 }, b: R { id: 25 } };
    for i in 0..2 {
        consume(x);
        x = W { k: i + 0, a: R { id: i + 10 }, b: R { id: i + 20 } };
    }
    println("done");
}
