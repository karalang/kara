struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
struct W { k: i64, a: R, b: R }
impl Drop for W { fn drop(mut ref self) { println(f"w{self.k}"); } }
fn f(fail: bool) -> Result[i64, i64] {
    let x = W { k: 1, a: R { id: 11 }, b: R { id: 21 } };
    errdefer {
        println("rollback");
    }
    let y = W { k: 2, a: R { id: 12 }, b: R { id: 22 } };
    if fail {
        return Err(1);
    }
    Ok(0)
}
fn main() {
    let _ = f(false);
    println("--");
    let _ = f(true);
}
