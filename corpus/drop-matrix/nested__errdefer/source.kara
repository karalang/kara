struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
struct W { k: i64, a: R, b: R }
impl Drop for W { fn drop(mut ref self) { println(f"w{self.k}"); } }
struct Q { w: W, t: (R, R) }
fn f(fail: bool) -> Result[i64, i64] {
    let x = Q { w: W { k: 1, a: R { id: 11 }, b: R { id: 21 } }, t: (R { id: 31 }, R { id: 41 }) };
    errdefer {
        println("rollback");
    }
    let y = Q { w: W { k: 2, a: R { id: 12 }, b: R { id: 22 } }, t: (R { id: 32 }, R { id: 42 }) };
    if fail {
        return Err(1);
    }
    Ok(0)
}
fn main() {
    let _ = f(false);
    println("--");
    let _ = f(true);
}
