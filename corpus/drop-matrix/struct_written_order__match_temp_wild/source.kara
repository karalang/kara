struct R { id: i64 }
impl Drop for R { fn drop(mut ref self) { println(f"d{self.id}"); } }
struct P { a: R, b: R, c: R }
fn make() -> P {
    P { c: R { id: 21 }, a: R { id: 1 }, b: R { id: 11 } }
}
fn main() {
    match make() {
        _ => {
            println("arm");
        },
    }
    println("end");
}
