== self-test: cache-control
  max-age=60                         max-age Some(60) s-maxage None no-store false no-cache false private false revalidate false stale-if-error 0
  public, max-age=0, s-maxage=30     max-age Some(0) s-maxage Some(30) no-store false no-cache false private false revalidate false stale-if-error 0
  no-store                           max-age None s-maxage None no-store true no-cache false private false revalidate false stale-if-error 0
  private, max-age=600               max-age Some(600) s-maxage None no-store false no-cache false private true revalidate false stale-if-error 0
  no-cache, must-revalidate          max-age None s-maxage None no-store false no-cache true private false revalidate true stale-if-error 0
  max-age="20", stale-if-error=300   max-age Some(20) s-maxage None no-store false no-cache false private false revalidate false stale-if-error 300
  MAX-AGE=5, Proxy-Revalidate        max-age Some(5) s-maxage None no-store false no-cache false private false revalidate true stale-if-error 0
  max-age=soon                       max-age None s-maxage None no-store false no-cache false private false revalidate false stale-if-error 0
