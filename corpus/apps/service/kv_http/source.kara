// A key-value store served over HTTP/1.1 on a real loopback TCP socket.
//
// The server and its client run in one thread: the client connects and
// writes a whole request batch, the kernel buffers it, then the server
// accepts, reads to end of input, answers every request it parsed, and
// closes. Bodies are JSON, through the derived Serialize/Deserialize.
//
// Workarounds for v2 gaps, each to revert once its row is fixed:
//   B-2026-10-12-6   i64.parse returns Option, not Result[i64, ParseError]
//   B-2026-10-12-7   split() is an eager Vec[String]: `.iter()` before map,
//                    and a split piece is copied out with `.to_string()`

#[derive(Serialize, Deserialize)]
struct PutBody { value: String, tags: Vec[String] }

#[derive(Serialize, Deserialize)]
struct Item { key: String, value: String, tags: Vec[String], version: i64 }

#[derive(Serialize, Deserialize)]
struct Listing { count: i64, keys: Vec[String] }

#[derive(Serialize, Deserialize)]
struct ErrorBody { error: String, status: i64 }

#[derive(Serialize, Deserialize)]
struct Stats { requests: i64, hits: i64, misses: i64, writes: i64, bytes_in: i64 }

struct Request {
    method: String,
    path: String,
    headers: Vec[(String, String)],
    body: String,
}

struct Reply { status: i64, body: String }

struct Store {
    items: SortedMap[String, Item],
    stats: Stats,
}

fn reason(status: i64) -> String {
    match status {
        200 => "OK".to_string(),
        201 => "Created".to_string(),
        204 => "No Content".to_string(),
        400 => "Bad Request".to_string(),
        404 => "Not Found".to_string(),
        405 => "Method Not Allowed".to_string(),
        411 => "Length Required".to_string(),
        _ => "Unknown".to_string(),
    }
}

fn error_reply(status: i64, msg: Str) -> Reply {
    let e = ErrorBody { error: msg.to_string(), status: status };
    Reply { status: status, body: Json.serialize(e) }
}

fn header_value(req: ref Request, name: Str) -> Option[String] {
    for (k, v) in req.headers.iter() {
        if k.to_lowercase() == name.to_lowercase() {
            return Some(v.clone());
        }
    }
    None
}

// Parses as many complete requests as `raw` holds. A request whose body is
// shorter than its Content-Length ends the batch: the rest never arrived.
fn parse_requests(raw: Str) -> Result[Vec[Request], String] {
    let mut out: Vec[Request] = Vec.new();
    let mut rest = raw.to_string();
    while rest.len() > 0 {
        let head_end = match rest.find("\r\n\r\n") {
            Some(i) => i,
            None => return Err(f"truncated head after {out.len()} requests"),
        };
        let head = rest[0..head_end].to_string();
        let mut lines: Vec[String] = Vec.new();
        for l in head.split("\r\n") {
            lines.push(l.to_string());
        }
        let first: Vec[String] = lines[0].split(" ").iter().map(|p| p.to_string()).collect();
        if first.len() != 3 or not first[2].starts_with("HTTP/1.") {
            return Err(f"bad request line [{lines[0]}]");
        }
        let mut headers: Vec[(String, String)] = Vec.new();
        let mut i = 1;
        while i < lines.len() {
            match lines[i].find(":") {
                Some(c) => {
                    let k = lines[i][0..c].trim().to_string();
                    let v = lines[i][c + 1..lines[i].len()].trim().to_string();
                    headers.push((k, v));
                }
                None => return Err(f"bad header [{lines[i]}]"),
            }
            i = i + 1;
        }
        let mut req = Request {
            method: first[0].clone(),
            path: first[1].clone(),
            headers: headers,
            body: String.new(),
        };
        let body_start = head_end + 4;
        let len = match header_value(req, "content-length") {
            Some(v) => match i64.parse(v) {
                Some(n) => n,
                None => return Err(f"bad content-length [{v}]"),
            },
            None => 0,
        };
        if body_start + len > rest.len() {
            return Err(f"body short by {body_start + len - rest.len()} bytes");
        }
        req.body = rest[body_start..body_start + len].to_string();
        rest = rest[body_start + len..rest.len()].to_string();
        out.push(req);
    }
    Ok(out)
}

fn key_of(path: Str) -> Option[String] {
    if path.starts_with("/kv/") and path.len() > 4 {
        Some(path[4..path.len()].to_string())
    } else {
        None
    }
}

fn handle(store: mut ref Store, req: ref Request) -> Reply {
    store.stats.requests += 1;
    store.stats.bytes_in += req.body.len();
    if req.path == "/kv" {
        if req.method != "GET" {
            return error_reply(405, "list is GET only");
        }
        let mut keys: Vec[String] = Vec.new();
        for (k, _) in store.items.iter() {
            keys.push(k.clone());
        }
        let l = Listing { count: keys.len(), keys: keys };
        return Reply { status: 200, body: Json.serialize(l) };
    }
    if req.path == "/stats" {
        return Reply { status: 200, body: Json.serialize(store.stats) };
    }
    let key = match key_of(req.path) {
        Some(k) => k,
        None => return error_reply(404, f"no route {req.path}"),
    };
    if req.method == "GET" {
        match store.items.get(key) {
            Some(item) => {
                store.stats.hits += 1;
                Reply { status: 200, body: Json.serialize(item) }
            }
            None => {
                store.stats.misses += 1;
                error_reply(404, f"no key {key}")
            }
        }
    } else if req.method == "PUT" {
        if header_value(req, "content-length").is_none() {
            return error_reply(411, "PUT needs a body");
        }
        let parsed: Result[PutBody, DeserializeError] = Json.deserialize(req.body);
        match parsed {
            Ok(b) => {
                let version = match store.items.get(key) {
                    Some(old) => old.version + 1,
                    None => 1,
                };
                let item = Item { key: key.clone(), value: b.value, tags: b.tags, version: version };
                let status = if version == 1 { 201 } else { 200 };
                let body = Json.serialize(item);
                store.items.insert(key, item);
                store.stats.writes += 1;
                Reply { status: status, body: body }
            }
            Err(_) => error_reply(400, "bad json"),
        }
    } else if req.method == "DELETE" {
        match store.items.remove(key) {
            Some(_) => {
                store.stats.writes += 1;
                Reply { status: 204, body: String.new() }
            }
            None => {
                store.stats.misses += 1;
                error_reply(404, f"no key {key}")
            }
        }
    } else {
        error_reply(405, f"method {req.method}")
    }
}

fn render(r: ref Reply) -> String {
    let mut s = f"HTTP/1.1 {r.status} {reason(r.status)}\r\n";
    if r.body.len() > 0 {
        s.push_str("Content-Type: application/json\r\n");
    }
    s.push_str(f"Content-Length: {r.body.len()}\r\n\r\n");
    s.push_str(r.body);
    s
}

fn read_all(conn: ref TcpStream) -> Result[String, String] {
    let mut bytes: Vec[u8] = Vec.new();
    let mut buf: Array[u8, 64] = [0u8; 64];
    loop {
        match conn.read(mut buf) {
            Ok(0) => break,
            Ok(n) => {
                let mut i = 0;
                while i < n {
                    bytes.push(buf[i]);
                    i = i + 1;
                }
            }
            Err(_) => return Err("read failed".to_string()),
        }
    }
    match String.from_utf8(bytes) {
        Ok(s) => Ok(s),
        Err(_) => Err("not utf-8".to_string()),
    }
}

fn request(method: Str, path: Str, body: Option[String]) -> String {
    let mut s = f"{method} {path} HTTP/1.1\r\nHost: 127.0.0.1\r\nUser-Agent: kv-client\r\n";
    match body {
        Some(b) => {
            s.push_str(f"Content-Length: {b.len()}\r\n\r\n");
            s.push_str(b);
        }
        None => s.push_str("\r\n"),
    }
    s
}

// Sends one batch on a fresh connection, lets the server answer it, and
// prints each response's status line and body.
fn exchange(listener: ref TcpListener, addr: Str, store: mut ref Store, label: Str, batch: Str) {
    println(f"== {label}");
    let client = match TcpStream.connect(addr) {
        Ok(c) => c,
        Err(_) => {
            println("connect failed");
            return;
        }
    };
    match client.write_all(batch.bytes()) {
        Ok(_) => {}
        Err(_) => println("client write failed"),
    }
    match client.shutdown_write() {
        Ok(_) => {}
        Err(_) => println("shutdown failed"),
    }
    match listener.accept() {
        Ok(conn) => {
            let mut out = String.new();
            match read_all(conn) {
                Ok(raw) => match parse_requests(raw) {
                    Ok(reqs) => {
                        for r in reqs.iter() {
                            out.push_str(render(handle(store, r)));
                        }
                    }
                    Err(e) => out.push_str(render(error_reply(400, e))),
                },
                Err(e) => out.push_str(render(error_reply(400, e))),
            }
            match conn.write_all(out.bytes()) {
                Ok(_) => {}
                Err(_) => println("server write failed"),
            }
        }
        Err(_) => println("accept failed"),
    }
    match read_all(client) {
        Ok(resp) => print_responses(resp),
        Err(e) => println(f"client read: {e}"),
    }
}

// The client side: splits the stream back into responses by Content-Length.
fn print_responses(resp: Str) {
    let mut at = 0;
    while at < resp.len() {
        let rest = resp[at..resp.len()];
        let head_end = match rest.find("\r\n\r\n") {
            Some(i) => i,
            None => {
                println(f"  trailing [{rest}]");
                return;
            }
        };
        let mut len = 0;
        let mut status = "";
        for line in rest[0..head_end].split("\r\n") {
            if line.starts_with("HTTP/1.1 ") {
                status = line.to_string();
            } else if line.to_lowercase().starts_with("content-length:") {
                len = i64.parse(line[15..line.len()].trim()).unwrap_or(0);
            }
        }
        let body = rest[head_end + 4..head_end + 4 + len];
        if len == 0 {
            println(f"  {status} (empty)");
        } else {
            println(f"  {status} {body}");
        }
        at = at + head_end + 4 + len;
    }
}

fn put(key: Str, value: Str, tags: own Vec[String]) -> String {
    let b = PutBody { value: value.to_string(), tags: tags };
    request("PUT", f"/kv/{key}", Some(Json.serialize(b)))
}

fn main() {
    let addr = "127.0.0.1:47731";
    let listener = match TcpListener.bind(addr) {
        Ok(l) => l,
        Err(_) => {
            println("bind failed");
            return;
        }
    };
    let mut store = Store {
        items: SortedMap.new(),
        stats: Stats { requests: 0, hits: 0, misses: 0, writes: 0, bytes_in: 0 },
    };
    exchange(listener, addr, mut store, "create", put("alpha", "first", vec!["a".to_string()]));
    let mut batch = put("beta", "second", vec!["b".to_string(), "hot".to_string()]);
    batch.push_str(put("gamma", "third \"quoted\"", Vec.new()));
    batch.push_str(put("alpha", "first, again", vec!["a".to_string(), "v2".to_string()]));
    exchange(listener, addr, mut store, "pipelined writes", batch);
    let mut reads = request("GET", "/kv/alpha", None);
    reads.push_str(request("GET", "/kv/missing", None));
    reads.push_str(request("GET", "/kv", None));
    exchange(listener, addr, mut store, "reads", reads);
    let mut errs = request("PUT", "/kv/bad", Some("{\"value\": 3}".to_string()));
    errs.push_str(request("POST", "/kv/alpha", Some("{}".to_string())));
    errs.push_str(request("GET", "/nowhere", None));
    errs.push_str(request("PUT", "/kv/nobody", None));
    exchange(listener, addr, mut store, "errors", errs);
    let mut dels = request("DELETE", "/kv/beta", None);
    dels.push_str(request("DELETE", "/kv/beta", None));
    dels.push_str(request("GET", "/kv", None));
    exchange(listener, addr, mut store, "deletes", dels);
    exchange(listener, addr, mut store, "garbage", "HELLO\r\n\r\n".to_string());
    let mut short = request("PUT", "/kv/delta", Some("{\"value\":\"x\",\"tags\":[]}".to_string()));
    short = short[0..short.len() - 5].to_string();
    exchange(listener, addr, mut store, "short body", short);
    exchange(listener, addr, mut store, "stats", request("GET", "/stats", None));
}
