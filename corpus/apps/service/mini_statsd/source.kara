// data/statsd-modern.js
fn file_2() -> String {
    """
// A modern deployment: idle stats are deleted, keys are left as sent,
// and graphite uses the new namespace with prefixes and a suffix.
{
  port: 8125,
  mgmt_port: 8126,
  graphitePort: 2003,
  graphiteHost: \"127.0.0.1\",
  flushInterval: 5000,
  deleteIdleStats: true,
  gaugesMaxTTL: 2,
  percentThreshold: 99.9,
  calculatedTimerMetrics: ['count', 'mean', 'upper', 'upper_99_9', 'count_ps'],
  prefixStats: 'agg',
  keyNameSanitize: false,
  graphite: {
    legacyNamespace: false,
    globalPrefix: 'acme',
    prefixCounter: '',
    prefixTimer: 't',
    globalSuffix: 'host1'
  },
  flush_counts: false
}

"""
}

fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

// The bytes a block of hex digits spells; line breaks are skipped.
fn unhex(s: String) -> Vec[u8] {
    let b = to_bytes(s);
    let mut digits: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        if is_hex(b[i]) {
            digits.push(hex_val(b[i]));
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < digits.len() {
        out.push(digits[i] * 16 + digits[i + 1]);
        i += 2;
    }
    out
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data")?;
    put("data/jobs.txt", file_0())?;
    put("data/statsd-classic.js", file_1())?;
    put("data/statsd-modern.js", file_2())?;
    Ok(())
}

// The names of the input files.
fn data_names() -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    v.push("jobs.txt".to_string());
    v.push("statsd-classic.js".to_string());
    v.push("statsd-modern.js".to_string());
    v
}

// ------------------------------------------------------------ the sockets

fn read_all(conn: ref TcpStream) -> String {
    let mut bytes: Vec[u8] = Vec.new();
    let mut buf: Array[u8, 4096] = [0u8; 4096];
    loop {
        match conn.read(mut buf) {
            Ok(0) => break,
            Ok(n) => {
                for i in 0..n {
                    bytes.push(buf[i]);
                }
            }
            Err(_) => break,
        }
    }
    String.from_utf8(bytes).unwrap_or("?".to_string())
}

struct Net {
    udp: UdpSocket,
    udp_addr: String,
    client: UdpSocket,
    mgmt: TcpListener,
    mgmt_addr: String,
    graphite: TcpListener,
    graphite_addr: String,
}

// The daemon's sockets on the ports its config names, as statsd binds them.
fn open_net(cfg: ref Vec[Field]) -> Result[Net, String] {
    let host = text_or(cfg, "address", "127.0.0.1");
    let udp_addr = f"{host}:{num_or(cfg, "port", 8125.0) as i64}";
    let mgmt_addr = f"{text_or(cfg, "mgmt_address", "127.0.0.1")}:{num_or(cfg, "mgmt_port", 8126.0) as i64}";
    let graphite_addr = f"{text_or(cfg, "graphiteHost", "127.0.0.1")}:{num_or(cfg, "graphitePort", 2003.0) as i64}";
    let udp = match UdpSocket.bind(udp_addr) {
        Ok(s) => s,
        Err(_) => return Err(f"cannot bind {udp_addr}"),
    };
    let client = match UdpSocket.bind("127.0.0.1:0") {
        Ok(s) => s,
        Err(_) => return Err("udp client bind failed".to_string()),
    };
    let mgmt = match TcpListener.bind(mgmt_addr) {
        Ok(l) => l,
        Err(_) => return Err(f"cannot bind {mgmt_addr}"),
    };
    let graphite = match TcpListener.bind(graphite_addr) {
        Ok(l) => l,
        Err(_) => return Err(f"cannot bind {graphite_addr}"),
    };
    Ok(Net {
        udp: udp,
        udp_addr: udp_addr,
        client: client,
        mgmt: mgmt,
        mgmt_addr: mgmt_addr,
        graphite: graphite,
        graphite_addr: graphite_addr,
    })
}

// A client sends one datagram; the daemon receives it and handles it.
fn send(net: ref Net, d: mut ref Daemon, payload: Str) {
    match net.client.send_to(payload.bytes(), net.udp_addr) {
        Ok(_) => {}
        Err(_) => {
            println("send failed");
            return;
        }
    }
    let mut buf: Array[u8, 8192] = [0u8; 8192];
    match net.udp.recv_from(mut buf) {
        Ok((n, _)) => {
            let mut v: Vec[u8] = Vec.new();
            for i in 0..n {
                v.push(buf[i]);
            }
            d.packet(from_bytes(v));
        }
        Err(_) => println("recv failed"),
    }
}

// A console client sends one command; the daemon answers it.
fn admin(net: ref Net, d: mut ref Daemon, command: Str) {
    let client = match TcpStream.connect(net.mgmt_addr) {
        Ok(c) => c,
        Err(_) => {
            println("connect failed");
            return;
        }
    };
    match client.write_all(command.bytes()) {
        Ok(_) => {}
        Err(_) => println("client write failed"),
    }
    match client.shutdown_write() {
        Ok(_) => {}
        Err(_) => println("shutdown failed"),
    }
    let mut closed = false;
    match net.mgmt.accept() {
        Ok(conn) => {
            let line = read_all(conn);
            match d.admin(line) {
                Some(reply) => {
                    match conn.write_all(reply.bytes()) {
                        Ok(_) => {}
                        Err(_) => println("server write failed"),
                    }
                }
                None => closed = true,
            }
        }
        Err(_) => println("accept failed"),
    }
    print(read_all(client));
    if closed {
        println("(connection closed)");
    }
}

// The graphite backend connects and writes one flush; the collector
// reads it.
fn flush(net: ref Net, d: mut ref Daemon) {
    let payload = d.flush();
    let backend = match TcpStream.connect(net.graphite_addr) {
        Ok(c) => c,
        Err(_) => {
            println("graphite connect failed");
            return;
        }
    };
    match backend.write_all(payload.bytes()) {
        Ok(_) => {}
        Err(_) => println("graphite write failed"),
    }
    match backend.shutdown_write() {
        Ok(_) => {}
        Err(_) => println("graphite shutdown failed"),
    }
    match net.graphite.accept() {
        Ok(conn) => print(read_all(conn)),
        Err(_) => println("graphite accept failed"),
    }
}

fn main() {
    if let Err(e) = write_data() {
        println(e);
        return;
    }
    let jobs = match fs.read_to_string("data/jobs.txt") {
        Ok(t) => t,
        Err(_) => {
            println("cannot read data/jobs.txt");
            return;
        }
    };
    let mut daemon: Option[Daemon] = None;
    let mut net: Option[Net] = None;
    for line in lines_of(jobs).iter() {
        if line.len() == 0 or starts_with(line, "#") {
            continue;
        }
        println(f"$ {line}");
        let (cmd, _, arg) = partition(line, b' ');
        if cmd == "config" {
            match fs.read_to_string(f"data/{arg}") {
                Ok(text) => {
                    let cfg = parse_config(text);
                    net = None; // the old daemon's sockets close first
                    match open_net(cfg) {
                        Ok(n) => net = Some(n),
                        Err(e) => println(e),
                    }
                    daemon = Some(Daemon.new(cfg));
                }
                Err(_) => println(f"cannot read data/{arg}"),
            }
        } else {
            match daemon {
                Some(mut ref d) => match net {
                    Some(ref n) => {
                        if cmd == "send" {
                            send(n, mut d, arg.replace("\\n", "\n"));
                        } else if cmd == "admin" {
                            admin(n, mut d, arg);
                        } else if cmd == "flush" {
                            flush(n, mut d);
                        }
                    }
                    None => println("no sockets"),
                },
                None => println("no daemon running"),
            }
        }
        println("");
    }
}
