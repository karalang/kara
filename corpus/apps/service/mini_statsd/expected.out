$ config statsd-classic.js

$ send gorets:1|c

$ send gorets:1|c|@0.1

$ send gorets:2|c|@0.3

$ send glork:320|ms\nglork:100|ms\nglork:250|ms|@0.5

$ send api.latency:12|ms|#env:prod,region:eu

$ send api.latency:48|ms|#env:prod,region:eu\napi.latency:75|ms|#env:prod,region:eu\napi.latency:260|ms|#env:prod,region:eu\napi.latency:101|ms|#env:prod,region:eu

$ send gaugor:333|g

$ send gaugor:-10|g\ngaugor:+4|g

$ send uniques:765|s\nuniques:765|s\nuniques:3|s\nuniques:|s

$ send users online:7|g

$ send a/b/c:1|c

$ send weird$key!:5|c

$ send 404:1|c

$ send multi:1|c:2|c:3|ms

$ send nokey\nbad1:|c\nbad2:abc|c\nbad3:-5|ms\nbad4:5|c|0.1\nbad5:5|c|@-1

$ send hex:0x10|c\nspaced: 7 |c\nexp:1e2|ms\nrate:1|c|@1e-1\nfrac:.5|c\nhisto:3|h\nlate:5|ms \nzero:1|c|@0

$ send \n\n

