// modbus_server: a Modbus/TCP server (the industrial register protocol
// PLCs, meters and drives speak) on loopback TCP, and the clients that use
// it. A frame is the MBAP header (transaction id, protocol id, length, unit,
// all big-endian) and a PDU whose first byte is the function code. Each
// connection is served by its own task; the data model (coils, discrete
// inputs, holding and input registers) is shared under one lock, and
// writing ON to the last coil stops the server.

import std.sync.{TaskGroup, Mutex};
import std.net.{TcpListener, TcpStream};

const N_COILS: i64 = 64;
const N_DISCRETE: i64 = 32;
const N_HOLDING: i64 = 32;
const N_INPUT: i64 = 16;
const HALT_COIL: i64 = 63;
const UNIT: u8 = 1;

const DEVICE: Array[Str, 3] = ["Kara Industrial", "KX-485", "v0.8.2"];

fn exception_name(code: u8) -> Str {
    match code {
        1 => "illegal function",
        2 => "illegal data address",
        3 => "illegal data value",
        11 => "gateway target failed to respond",
        _ => "unknown",
    }
}

#[derive(Debug, Clone, Copy)]
struct Exception { value: u8 }

struct Server {
    coils: Vec[bool],
    discrete: Vec[bool],
    holding: Vec[u16],
    inputs: Vec[u16],
    log: Vec[String],
    counts: SortedMap[String, i64],
    conns: SortedMap[i64, i64],
    stopping: bool,
}

impl Server {
    fn new() -> Server {
        Server {
            coils: (0..N_COILS).map(|i| i % 3 == 0).collect(),
            discrete: (0..N_DISCRETE).map(|i| (i * 7) % 5 < 2).collect(),
            holding: (0..N_HOLDING).map(|i| (i * 100) as u16).collect(),
            inputs: (0..N_INPUT).map(|i| (0x1000 + i * 3) as u16).collect(),
            log: Vec.new(),
            counts: SortedMap.new(),
            conns: SortedMap.new(),
            stopping: false,
        }
    }

    fn count(mut ref self, key: Str) {
        *self.counts.entry(key.to_string()).or_insert(0) += 1;
    }
}

fn u16_at(b: Slice[u8], i: i64) -> u16 {
    ((b[i] as u16) << 8) | b[i + 1]
}

fn be16(v: u16) -> Array[u8, 2] {
    v.to_be_bytes()
}

fn pack_bits(bits: Slice[bool]) -> Vec[u8] {
    let mut out = Vec.filled((bits.len() + 7) / 8, 0u8);
    for (i, on) in bits.iter().enumerate() {
        if *on {
            out[i / 8] |= 1 << (i % 8);
        }
    }
    out
}

fn unpack_bits(data: Slice[u8], n: i64) -> Vec[bool] {
    (0..n).map(|i| (data[i / 8] >> (i % 8)) & 1 == 1).collect()
}

fn need(pdu: Slice[u8], n: i64) -> Result[(), Exception] {
    if pdu.len() < n {
        return Err(Exception { value: 3 });
    }
    Ok(())
}

fn check_range(addr: i64, qty: i64, size: i64) -> Result[(), Exception] {
    if addr + qty > size {
        return Err(Exception { value: 2 });
    }
    Ok(())
}

fn regs_reply(fc: u8, regs: Slice[u16]) -> Vec[u8] {
    let mut out = [fc, (regs.len() * 2) as u8];
    for v in regs {
        out.extend_from_slice(be16(*v));
    }
    out
}

/// The response PDU for a request PDU (function code first).
fn handle(srv: mut ref Server, pdu: Slice[u8]) -> Result[Vec[u8], Exception] {
    let fc = pdu[0];
    match fc {
        1 | 2 => {
            need(pdu, 5)?;
            let addr = u16_at(pdu, 1) as i64;
            let qty = u16_at(pdu, 3) as i64;
            if qty < 1 or qty > 2000 {
                return Err(Exception { value: 3 });
            }
            let table = if fc == 1 { ref srv.coils } else { ref srv.discrete };
            check_range(addr, qty, table.len())?;
            let data = pack_bits(table[addr..addr + qty]);
            let mut out = [fc, data.len() as u8];
            out.extend(data);
            Ok(out)
        }
        3 | 4 => {
            need(pdu, 5)?;
            let addr = u16_at(pdu, 1) as i64;
            let qty = u16_at(pdu, 3) as i64;
            if qty < 1 or qty > 125 {
                return Err(Exception { value: 3 });
            }
            let table = if fc == 3 { ref srv.holding } else { ref srv.inputs };
            check_range(addr, qty, table.len())?;
            Ok(regs_reply(fc, table[addr..addr + qty]))
        }
        5 => {
            need(pdu, 5)?;
            let addr = u16_at(pdu, 1) as i64;
            let value = u16_at(pdu, 3);
            if value != 0xFF00 and value != 0 {
                return Err(Exception { value: 3 });
            }
            check_range(addr, 1, N_COILS)?;
            srv.coils[addr] = value == 0xFF00;
            if addr == HALT_COIL and value == 0xFF00 {
                srv.stopping = true;
            }
            Ok(pdu[..5].to_vec())
        }
        6 => {
            need(pdu, 5)?;
            let addr = u16_at(pdu, 1) as i64;
            check_range(addr, 1, N_HOLDING)?;
            srv.holding[addr] = u16_at(pdu, 3);
            Ok(pdu[..5].to_vec())
        }
        15 => {
            need(pdu, 6)?;
            let addr = u16_at(pdu, 1) as i64;
            let qty = u16_at(pdu, 3) as i64;
            let nbytes = pdu[5] as i64;
            if qty < 1 or qty > 1968 or nbytes != (qty + 7) / 8 or pdu.len() < 6 + nbytes {
                return Err(Exception { value: 3 });
            }
            check_range(addr, qty, N_COILS)?;
            for (i, on) in unpack_bits(pdu[6..6 + nbytes], qty).into_iter().enumerate() {
                srv.coils[addr + i] = on;
            }
            Ok(pdu[..5].to_vec())
        }
        16 => {
            need(pdu, 6)?;
            let addr = u16_at(pdu, 1) as i64;
            let qty = u16_at(pdu, 3) as i64;
            let nbytes = pdu[5] as i64;
            if qty < 1 or qty > 123 or nbytes != qty * 2 or pdu.len() < 6 + nbytes {
                return Err(Exception { value: 3 });
            }
            check_range(addr, qty, N_HOLDING)?;
            for i in 0..qty {
                srv.holding[addr + i] = u16_at(pdu, 6 + 2 * i);
            }
            Ok(pdu[..5].to_vec())
        }
        22 => {
            need(pdu, 7)?;
            let addr = u16_at(pdu, 1) as i64;
            let and_mask = u16_at(pdu, 3);
            let or_mask = u16_at(pdu, 5);
            check_range(addr, 1, N_HOLDING)?;
            let cur = srv.holding[addr];
            srv.holding[addr] = (cur & and_mask) | (or_mask & ~ and_mask);
            Ok(pdu[..7].to_vec())
        }
        23 => {
            need(pdu, 10)?;
            let raddr = u16_at(pdu, 1) as i64;
            let rqty = u16_at(pdu, 3) as i64;
            let waddr = u16_at(pdu, 5) as i64;
            let wqty = u16_at(pdu, 7) as i64;
            let nbytes = pdu[9] as i64;
            if rqty < 1 or rqty > 125 or wqty < 1 or wqty > 121 or nbytes != wqty * 2
                or pdu.len() < 10 + nbytes
            {
                return Err(Exception { value: 3 });
            }
            check_range(raddr, rqty, N_HOLDING)?;
            check_range(waddr, wqty, N_HOLDING)?;
            for i in 0..wqty {
                srv.holding[waddr + i] = u16_at(pdu, 10 + 2 * i);
            }
            Ok(regs_reply(fc, srv.holding[raddr..raddr + rqty]))
        }
        43 => {
            need(pdu, 2)?;
            if pdu[1] != 14 {
                return Err(Exception { value: 1 });
            }
            need(pdu, 4)?;
            let code = pdu[2];
            let obj = pdu[3] as i64;
            let ids: Vec[i64] = match code {
                1 => [0, 1, 2],
                4 => {
                    if obj >= DEVICE.len() {
                        return Err(Exception { value: 2 });
                    }
                    [obj]
                }
                _ => return Err(Exception { value: 3 }),
            };
            let mut out = [fc, 14, code, 1, 0, 0, ids.len() as u8];
            for i in ids {
                out.push(i as u8);
                out.push(DEVICE[i].len() as u8);
                out.extend_from_slice(DEVICE[i].bytes());
            }
            Ok(out)
        }
        _ => Err(Exception { value: 1 }),
    }
}

/// Up to `n` bytes: fewer only when the peer stopped sending.
fn read_full(sock: mut ref TcpStream, n: i64) -> Vec[u8] {
    let mut buf = Vec.filled(n, 0u8);
    let mut got = 0;
    while got < n {
        match sock.read(mut buf[got..]) {
            Ok(0) | Err(_) => break,
            Ok(k) => got += k,
        }
    }
    buf.truncate(got);
    buf
}

fn serve_conn(srv: Mutex[Server], sock: own TcpStream, conn_no: i64) {
    let mut sock = sock;
    let mut served = 0;
    loop {
        let head = read_full(mut sock, 7);
        if head.is_empty() {
            break;
        }
        if head.len() < 7 {
            srv.lock().value.log.push(f"conn {conn_no}: truncated header ({head.len()} bytes)");
            break;
        }
        let tid = u16_at(head, 0);
        let pid = u16_at(head, 2);
        let length = u16_at(head, 4) as i64;
        let unit = head[6];
        if length < 2 or length > 254 {
            let mut s = srv.lock();
            s.value.log.push(f"conn {conn_no}: bad length {length}, closing");
            s.value.count("bad length");
            break;
        }
        let pdu = read_full(mut sock, length - 1);
        if pdu.len() < length - 1 {
            srv.lock().value.log.push(f"conn {conn_no}: truncated frame t={tid:04x} ({pdu.len()} of {length - 1} bytes)");
            break;
        }
        let reply = {
            let mut s = srv.lock();
            if pid != 0 {
                s.value.log.push(f"conn {conn_no}: t={tid:04x} protocol id {pid}, dropped");
                s.value.count("dropped");
                continue;
            }
            served += 1;
            let fc = pdu[0];
            s.value.count(f"fc {fc:02x}");
            let result = if unit != UNIT and unit != 255 {
                Err(Exception { value: 11 })
            } else {
                handle(mut s.value, pdu)
            };
            match result {
                Ok(r) => {
                    s.value.log.push(f"conn {conn_no}: t={tid:04x} u={unit} fc={fc:02x} -> ok");
                    r
                }
                Err(Exception { value: code }) => {
                    s.value.log.push(f"conn {conn_no}: t={tid:04x} u={unit} fc={fc:02x} -> exception {code:02x}");
                    s.value.count(f"exception {code:02x}");
                    [fc | 0x80, code]
                }
            }
        };
        let mut frame = head[..4].to_vec();
        frame.extend_from_slice(be16((reply.len() + 1) as u16));
        frame.push(unit);
        frame.extend(reply);
        sock.write_all(frame).unwrap();
    }
    drop(sock);
    srv.lock().value.conns.insert(conn_no, served);
}

fn serve(srv: Mutex[Server], listener: TcpListener) {
    let group = TaskGroup.new();
    let mut conn_no = 0;
    loop {
        let sock = listener.accept().unwrap();
        if srv.lock().value.stopping {
            drop(sock);
            break;
        }
        conn_no += 1;
        let n = conn_no;
        group.spawn(|| serve_conn(srv, sock, n));
    }
    drop(listener);
}

// ------------------------------------------------------------ the clients

fn bits_text(bits: Slice[bool]) -> String {
    bits.iter().map(|b| if *b { '1' } else { '0' }).collect()
}

struct Client {
    name: String,
    sock: TcpStream,
    tid: u16,
}

impl Client {
    fn connect(name: Str, addr: Str) -> Client {
        Client { name: name.to_string(), sock: TcpStream.connect(addr).unwrap(), tid: 0 }
    }

    fn frame(mut ref self, unit: u8, pdu: Slice[u8], tid: Option[u16], pid: u16) -> Vec[u8] {
        let tid = match tid {
            Some(t) => t,
            None => {
                self.tid += 1;
                self.tid
            }
        };
        let mut out = Vec.new();
        out.extend_from_slice(be16(tid));
        out.extend_from_slice(be16(pid));
        out.extend_from_slice(be16((pdu.len() + 1) as u16));
        out.push(unit);
        out.extend_from_slice(pdu);
        out
    }

    /// One response: (tid, unit, pdu), or None at the end of the stream.
    fn recv(mut ref self) -> Option[(u16, u8, Vec[u8])] {
        let head = read_full(mut self.sock, 7);
        if head.len() < 7 {
            return None;
        }
        let pdu = read_full(mut self.sock, u16_at(head, 4) as i64 - 1);
        Some((u16_at(head, 0), head[6], pdu))
    }

    fn show(self, what: Str, reply: Option[(u16, u8, Vec[u8])], qty: i64) {
        let (tid, unit, pdu) = match reply {
            None => {
                println(f"{self.name}: {what} -> closed by server");
                return;
            }
            Some(r) => r,
        };
        let fc = pdu[0];
        let text = if fc & 0x80 != 0 {
            f"exception {pdu[1]:02x} {exception_name(pdu[1])}"
        } else {
            match fc {
                1 | 2 => f"bits {bits_text(unpack_bits(pdu[2..], qty))} ({pdu[1]} bytes)",
                3 | 4 | 23 => {
                    let n = pdu[1] as i64 / 2;
                    let regs: Vec[String] = (0..n).map(|i| f"{u16_at(pdu, 2 + 2 * i):04x}").collect();
                    f"regs {regs.join(" ")}"
                }
                5 | 6 => f"echo addr={u16_at(pdu, 1)} value={u16_at(pdu, 3):04x}",
                15 | 16 => f"wrote addr={u16_at(pdu, 1)} qty={u16_at(pdu, 3)}",
                22 => f"masked addr={u16_at(pdu, 1)} and={u16_at(pdu, 3):04x} or={u16_at(pdu, 5):04x}",
                43 => {
                    let n = pdu[6] as i64;
                    let mut i = 7;
                    let mut parts = Vec.new();
                    for _ in 0..n {
                        let obj = pdu[i];
                        let len = pdu[i + 1] as i64;
                        let text = String.from_utf8(pdu[i + 2..i + 2 + len].to_vec()).unwrap();
                        parts.push(f"{obj}={text}");
                        i += 2 + len;
                    }
                    f"device code={pdu[2]} {parts.join(", ")}"
                }
                _ => "?",
            }
        };
        println(f"{self.name}: t={tid:04x} u={unit} {what} -> {text}");
    }

    fn ask_unit(mut ref self, what: Str, pdu: Slice[u8], unit: u8, qty: i64) {
        let frame = self.frame(unit, pdu, None, 0);
        self.sock.write_all(frame).unwrap();
        let reply = self.recv();
        self.show(what, reply, qty);
    }

    fn ask(mut ref self, what: Str, pdu: Slice[u8]) {
        self.ask_unit(what, pdu, UNIT, 0);
    }

    fn read_bits(mut ref self, fc: u8, addr: u16, qty: u16) {
        let kind = if fc == 1 { "coils" } else { "inputs" };
        let mut pdu = [fc];
        pdu.extend_from_slice(be16(addr));
        pdu.extend_from_slice(be16(qty));
        self.ask_unit(f"read {kind} {addr}+{qty}", pdu, UNIT, qty);
    }

    fn read_regs(mut ref self, fc: u8, addr: u16, qty: u16, unit: u8) {
        let kind = if fc == 3 { "holding" } else { "input regs" };
        let mut pdu = [fc];
        pdu.extend_from_slice(be16(addr));
        pdu.extend_from_slice(be16(qty));
        self.ask_unit(f"read {kind} {addr}+{qty}", pdu, unit, 0);
    }
}

fn pdu(parts: Slice[Slice[u8]]) -> Vec[u8] {
    parts.concat()
}

fn main() {
    let srv = Mutex.new(Server.new());
    let listener = TcpListener.bind("127.0.0.1:0").unwrap();
    let addr = listener.local_addr().unwrap().to_string();
    let group = TaskGroup.new();
    group.spawn(|| serve(srv, listener));

    println("== plc");
    let mut c = Client.connect("plc", addr);
    c.read_bits(1, 0, 20);
    c.read_bits(2, 0, 10);
    c.read_regs(3, 0, 5, UNIT);
    c.read_regs(4, 0, 4, UNIT);
    c.ask("write coil 5 on", pdu([[5], be16(5), be16(0xFF00)]));
    c.ask("write coil 6 = 1234", pdu([[5], be16(6), be16(0x1234)]));
    c.read_bits(1, 0, 10);
    c.ask("write holding 3", pdu([[6], be16(3), be16(0xBEEF)]));
    c.read_regs(3, 0, 5, UNIT);
    c.ask("write coils 10+10", pdu([[15], be16(10), be16(10), [2, 0b1010_1100, 0b01]]));
    c.read_bits(1, 8, 16);
    c.ask("write holding 20+3", pdu([[16], be16(20), be16(3), [6], be16(1), be16(2), be16(3)]));
    c.read_regs(3, 18, 6, UNIT);
    c.ask("mask holding 3", pdu([[22], be16(3), be16(0xF0F2), be16(0x0025)]));
    c.read_regs(3, 3, 1, UNIT);
    c.ask(
        "read 0+4, write 1+2",
        pdu([[23], be16(0), be16(4), be16(1), be16(2), [4], be16(0x1111), be16(0x2222)]),
    );
    drop(c);

    println("== edge");
    let mut e = Client.connect("edge", addr);
    e.read_bits(1, 0, 0);
    e.read_bits(1, 0, 2001);
    e.read_bits(1, 60, 10);
    e.read_bits(2, 31, 1);
    e.read_regs(3, 0, 126, UNIT);
    e.read_regs(3, 30, 5, UNIT);
    e.read_regs(4, 15, 1, UNIT);
    e.ask("function 07", [7]);
    e.ask("encapsulated 0d", [43, 13, 1, 0]);
    e.ask("device basic", [43, 14, 1, 0]);
    e.ask("device object 1", [43, 14, 4, 1]);
    e.ask("device object 9", [43, 14, 4, 9]);
    e.ask("device code 2", [43, 14, 2, 0]);
    e.read_regs(4, 0, 2, 7);
    e.read_regs(4, 0, 2, 255);
    e.ask("write coils, short count", pdu([[15], be16(0), be16(9), [1, 0xFF]]));
    e.ask("short read", [3, 0, 1]);
    e.ask("write holding 40", pdu([[6], be16(40), be16(1)]));
    e.ask("write coil 64", pdu([[5], be16(64), be16(0)]));
    drop(e);

    println("== pipeline");
    let mut p = Client.connect("pipeline", addr);
    let mut burst = Vec.new();
    for a in [0u16, 4, 8] {
        let f = p.frame(UNIT, pdu([[3], be16(a), be16(2)]), Some(0x10 + a), 0);
        burst.extend(f);
    }
    p.sock.write_all(burst).unwrap();
    for a in [0u16, 4, 8] {
        let reply = p.recv();
        p.show(f"burst read holding {a}+2", reply, 0);
    }
    let mut two = p.frame(UNIT, pdu([[3], be16(0), be16(1)]), None, 5);
    two.extend(p.frame(UNIT, pdu([[4], be16(1), be16(1)]), None, 0));
    p.sock.write_all(two).unwrap();
    let reply = p.recv();
    p.show("after a foreign protocol id", reply, 0);
    drop(p);

    println("== broken");
    let mut b = Client.connect("broken", addr);
    b.sock.write_all(pdu([be16(0x77), be16(0), be16(300), [UNIT]])).unwrap();
    let reply = b.recv();
    b.show("length 300", reply, 0);
    drop(b);
    let mut t = Client.connect("torn", addr);
    let f = t.frame(UNIT, pdu([[3], be16(0), be16(2)]), None, 0);
    t.sock.write_all(f[..9]).unwrap();
    t.sock.shutdown_write().unwrap();
    let reply = t.recv();
    t.show("half a frame", reply, 0);
    drop(t);
    let mut t = Client.connect("torn", addr);
    t.sock.write_all([0, 1, 0]).unwrap();
    t.sock.shutdown_write().unwrap();
    let reply = t.recv();
    t.show("three bytes", reply, 0);
    drop(t);

    println("== admin");
    let mut a = Client.connect("admin", addr);
    a.ask("write coil 63 on", pdu([[5], be16(HALT_COIL as u16), be16(0xFF00)]));
    drop(a);
    drop(TcpStream.connect(addr).unwrap()); // wakes the accept loop
    drop(group);

    let srv = srv.into_inner();
    println("== server log");
    for line in ref srv.log {
        println(f"{line}");
    }
    println("== counts");
    for (key, n) in ref srv.counts {
        println(f"{key}: {n}");
    }
    println("== connections");
    for (conn_no, n) in ref srv.conns {
        println(f"conn {conn_no}: {n} requests");
    }
    println("== tables");
    println(f"coils   {bits_text(srv.coils)}");
    let first: Vec[String] = srv.holding[..8].iter().map(|v| f"{v:04x}").collect();
    println(f"holding {first.join(" ")}");
    let second: Vec[String] = srv.holding[16..24].iter().map(|v| f"{v:04x}").collect();
    println(f"holding {second.join(" ")}");
}
