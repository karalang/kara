// tcp_balancer: a layer-4 load balancer in the shape of HAProxy's TCP mode.
// Clients connect to the front address; each connection is handed to a
// healthy backend, chosen round-robin or by fewest active connections, and
// the balancer copies bytes both ways until each side has finished,
// passing a half-close through. Backends are health-checked with a PING
// that must be answered PONG: a backend comes up after RISE good checks in
// a row and goes down after FALL bad ones. With no backend up, a client is
// told so and closed. The health logic runs first against a fake Network
// with a scripted answer per check; then three real backends serve on
// loopback while the program changes their health between rounds.

import std.sync.{TaskGroup, Mutex, Atomic};
import std.time.{Duration, sleep};
import std.io.{BufReader};

const FRONT: Str = "127.0.0.1:47756";
const ALPHA: Str = "127.0.0.1:47757";
const BETA: Str = "127.0.0.1:47758";
const GAMMA: Str = "127.0.0.1:47759";
const RISE: i64 = 2;
const FALL: i64 = 2;
const CHECK_TIMEOUT_MS: i64 = 500;

#[derive(Clone, Copy, PartialEq)]
enum Policy {
    RoundRobin,
    LeastConn,
}

#[derive(Clone)]
struct Backend {
    name: String,
    addr: String,
    up: bool,
    streak: i64,
    active: i64,
    total: i64,
    bytes_in: i64,
    bytes_out: i64,
}

struct Pool {
    backends: Vec[Backend],
    next: i64,
    policy: Policy,
    events: Vec[String],
}

sync struct Balancer {
    pool: Mutex[Pool],
    open: Atomic[i64],
    ready: Atomic[bool],
}

fn new_balancer(backends: Slice[(Str, Str)]) -> Balancer {
    let mut list = Vec.new();
    for (name, addr) in backends {
        list.push(Backend {
            name: name.to_string(),
            addr: addr.to_string(),
            up: false,
            streak: 0,
            active: 0,
            total: 0,
            bytes_in: 0,
            bytes_out: 0,
        });
    }
    Balancer {
        pool: Mutex.new(Pool { backends: list, next: 0, policy: Policy.RoundRobin, events: Vec.new() }),
        open: Atomic.new(0),
        ready: Atomic.new(false),
    }
}

impl Balancer {
    fn log(self, event: String) {
        let g = self.pool.lock();
        g.value.events.push(event);
    }

    // The events since the last call.
    fn take_events(self) -> Vec[String] {
        let g = self.pool.lock();
        std.mem.take(&mut g.value.events)
    }

    fn set_policy(self, p: Policy) {
        let g = self.pool.lock();
        g.value.policy = p;
    }
}

// ------------------------------------------------------------ health checks

fn probe(addr: Str) -> Result<(), String> {
    let s = TcpStream.connect(addr).map_err(|e| format!("connect: {}", e))?;
    s.set_read_timeout(Some(CHECK_TIMEOUT_MS)).map_err(|e| format!("timeout: {}", e))?;
    s.write_all("PING\n".bytes()).map_err(|e| format!("write: {}", e))?;
    let mut buf = [0u8; 64];
    let mut got: Vec[u8] = Vec.new();
    loop {
        let n = s.read(&mut buf).map_err(|e| format!("read: {}", e))?;
        if n == 0 {
            break;
        }
        got.extend_from_slice(&buf[0..n]);
        if got.contains(&10u8) {
            break;
        }
    }
    let text = String.from_utf8(got).unwrap_or(String.new());
    let line = text.trim();
    if line == "PONG" {
        Ok(())
    } else if line.is_empty() {
        Err("closed without an answer".to_string())
    } else {
        Err(format!("answered {}", line))
    }
}

// One check of every backend. The probes run without the lock; a result
// moves a backend's streak, and RISE or FALL in a row flips it.
fn check_round(bal: Balancer) {
    let addrs: Vec[String] = {
        let g = bal.pool.lock();
        g.value.backends.iter().map(|b| b.addr.clone()).collect()
    };
    let results: Vec[Result[(), String]] = addrs.iter().map(|a| probe(a)).collect();
    let g = bal.pool.lock();
    for i in 0..results.len() {
        let b = &mut g.value.backends[i];
        match &results[i] {
            Ok(()) => {
                if b.up {
                    b.streak = 0;
                } else {
                    b.streak += 1;
                    if b.streak >= RISE {
                        b.up = true;
                        b.streak = 0;
                        g.value.events.push(format!("{} up", b.name));
                    }
                }
            }
            Err(why) => {
                if !b.up {
                    b.streak = 0;
                } else {
                    b.streak += 1;
                    if b.streak >= FALL {
                        b.up = false;
                        b.streak = 0;
                        g.value.events.push(format!("{} down: {}", b.name, why));
                    }
                }
            }
        }
    }
}

// --------------------------------------------------------------- balancing

fn pick(pool: &mut Pool) -> Option<usize> {
    let n = pool.backends.len();
    match pool.policy {
        Policy.RoundRobin => {
            for k in 0..n {
                let i = (pool.next + k) % n;
                if pool.backends[i].up {
                    pool.next = (i + 1) % n;
                    return Some(i);
                }
            }
            None
        }
        Policy.LeastConn => {
            let mut best: Option<usize> = None;
            for i in 0..n {
                let b = &pool.backends[i];
                if !b.up {
                    continue;
                }
                best = match best {
                    None => Some(i),
                    Some(j) if b.active < pool.backends[j].active => Some(i),
                    keep => keep,
                };
            }
            best
        }
    }
}

// Copies until `from` ends, then half-closes `to`. Returns the bytes copied.
fn pipe(from: &TcpStream, to: &TcpStream) -> i64 {
    let mut buf = [0u8; 1024];
    let mut total = 0;
    loop {
        match from.read(&mut buf) {
            Ok(0) => break,
            Ok(n) => {
                if to.write_all(&buf[0..n]).is_err() {
                    break;
                }
                total += n;
            }
            Err(_) => break,
        }
    }
    let _ = to.shutdown_write();
    total
}

// Tells the client why, then closes as a lingering close does: our side
// first, then whatever the client still sends is read and dropped, so the
// close does not reset the connection under the answer.
fn refuse(client: TcpStream, why: Str) {
    let _ = client.write_all(f"{why}\n".bytes());
    let _ = client.shutdown_write();
    let _ = client.set_read_timeout(Some(1000));
    let mut buf = [0u8; 256];
    loop {
        match client.read(mut buf) {
            Ok(0) => break,
            Ok(_) => {}
            Err(_) => break,
        }
    }
}

fn proxy(bal: Balancer, client: TcpStream) {
    let picked = {
        let g = bal.pool.lock();
        match pick(&mut g.value) {
            Some(i) => {
                let b = &mut g.value.backends[i];
                b.active += 1;
                b.total += 1;
                Some((i, b.addr.clone(), b.name.clone()))
            }
            None => None,
        }
    };
    let (i, addr, name) = match picked {
        Some(p) => p,
        None => {
            refuse(client, "503 no backend available");
            bal.log("refused a client: no backend up".to_string());
            bal.open.fetch_sub(1);
            return;
        }
    };
    let upstream = match TcpStream.connect(&addr) {
        Ok(s) => s,
        Err(e) => {
            refuse(client, f"502 {name} unreachable");
            let g = bal.pool.lock();
            g.value.backends[i].active -= 1;
            g.value.events.push(format!("{}: connect failed: {}", name, e));
            drop(g);
            bal.open.fetch_sub(1);
            return;
        }
    };
    let group = TaskGroup.new();
    let sent = group.spawn(|| pipe(&client, &upstream));
    let received = pipe(&upstream, &client);
    let sent = sent.join();
    let g = bal.pool.lock();
    let b = &mut g.value.backends[i];
    b.active -= 1;
    b.bytes_in += sent;
    b.bytes_out += received;
    drop(g);
    bal.open.fetch_sub(1);
}

fn front(bal: Balancer, addr: Str) -> Result<(), NetError> {
    let listener = TcpListener.bind(addr)?;
    bal.ready.store(true);
    let tasks = TaskGroup.new();
    loop {
        let conn = listener.accept()?;
        bal.open.fetch_add(1);
        tasks.spawn(move || proxy(bal, conn));
    }
}

// ----------------------------------------------------------------- backends

sync struct Health {
    sick: Vec[Atomic[bool]],
}

// Answers PING with PONG (FAIL while sick) and any other line with its
// name and the line in capitals, until the client half-closes.
fn serve_backend(name: Str, conn: TcpStream, health: Health, me: usize) {
    let reader = BufReader.new(conn.try_clone().unwrap());
    for line in reader.lines() {
        let line = match line {
            Ok(l) => l,
            Err(_) => break,
        };
        let reply = if line == "PING" {
            if health.sick[me].load() { "FAIL".to_string() } else { "PONG".to_string() }
        } else {
            format!("{} {}", name, line.to_uppercase())
        };
        if conn.write_all(format!("{}\n", reply).bytes()).is_err() {
            break;
        }
    }
}

fn backend(name: Str, addr: Str, health: Health, me: usize) -> Result<(), NetError> {
    let listener = TcpListener.bind(addr)?;
    let tasks = TaskGroup.new();
    loop {
        let conn = listener.accept()?;
        tasks.spawn(move || serve_backend(name, conn, health, me));
    }
}

// ---------------------------------------------------------------- self-test

// Answers each check by a script: alpha always PONG, beta FAIL for its
// first two checks, gamma refuses its first three connections, delta
// answers nothing.
struct FakeNet {
    next: i64,
    handles: Map[i64, String],
    attempts: Map[String, i64],
    answered: Set[i64],
}

impl NetworkProvider for FakeNet {
    fn connect(&mut self, addr: &str) -> Result<i64, NetError> {
        let n = self.attempts.get(addr).copied().unwrap_or(0) + 1;
        self.attempts.insert(addr.to_string(), n);
        if addr == "gamma:1" && n <= 3 {
            return Err(NetError.ConnectionRefused);
        }
        self.next += 1;
        self.handles.insert(self.next, addr.to_string());
        Ok(self.next)
    }

    fn write_stream(&mut self, h: i64, buf: &[u8]) -> Result<i64, NetError> {
        Ok(buf.len())
    }

    fn read_stream(&mut self, h: i64, buf: &mut [u8]) -> Result<i64, NetError> {
        if self.answered.contains(&h) {
            return Ok(0);
        }
        self.answered.insert(h);
        let addr = self.handles[&h].clone();
        let n = self.attempts[&addr];
        let reply = match addr.as_str() {
            "alpha:1" => "PONG\n",
            "beta:1" => if n <= 2 { "FAIL\n" } else { "PONG\n" },
            "gamma:1" => "PONG\n",
            _ => "",
        };
        let bytes = reply.bytes();
        for i in 0..bytes.len() {
            buf[i] = bytes[i];
        }
        Ok(bytes.len())
    }

    fn close(&mut self, h: i64) {}
}

fn show_pool(bal: Balancer) {
    let g = bal.pool.lock();
    let states: Vec[String] = g.value.backends.iter()
        .map(|b| format!("{}={}{}", b.name, if b.up { "up" } else { "down" }, if b.streak > 0 { format!("({})", b.streak) } else { String.new() }))
        .collect();
    println!("    {}", states.join(" "));
}

fn self_test() {
    println("== self-test: health checks");
    let bal = new_balancer(&[("alpha", "alpha:1"), ("beta", "beta:1"), ("gamma", "gamma:1"), ("delta", "delta:1")]);
    providers {
        Network => FakeNet { next: 0, handles: Map.new(), attempts: Map.new(), answered: Set.new() },
    } in {
        for round in 1..=5 {
            check_round(bal);
            println(f"  round {round}");
            for e in bal.take_events() {
                println(f"    event: {e}");
            }
            show_pool(bal);
        }
    }

    println("== self-test: picking");
    let g = bal.pool.lock();
    let mut order = Vec.new();
    for _ in 0..5 {
        order.push(pick(&mut g.value).map(|i| g.value.backends[i].name.clone()).unwrap_or("none".to_string()));
    }
    println(f"  round-robin: {order.join(" ")}");
    g.value.policy = Policy.LeastConn;
    g.value.backends[0].active = 3;
    g.value.backends[1].active = 1;
    g.value.backends[2].active = 1;
    let mut order = Vec.new();
    for _ in 0..4 {
        match pick(&mut g.value) {
            Some(i) => {
                g.value.backends[i].active += 1;
                order.push(g.value.backends[i].name.clone());
            }
            None => order.push("none".to_string()),
        }
    }
    println(f"  least-conn from 3/1/1: {order.join(" ")}");
    for b in g.value.backends.iter_mut() {
        b.up = false;
    }
    println(f"  all down: {pick(&mut g.value).is_none()}");
}

// --------------------------------------------------------------------- live

fn wait_up(addrs: &[&str]) -> bool {
    for _ in 0..100 {
        if addrs.iter().all(|a| TcpStream.connect(a).is_ok()) {
            return true;
        }
        sleep(Duration.ms(20));
    }
    false
}

fn wait_ready(bal: Balancer) -> bool {
    for _ in 0..100 {
        if bal.ready.load() {
            return true;
        }
        sleep(Duration.ms(20));
    }
    false
}

// Waits until the balancer holds `n` connections, so each client's
// accounting is done before the next client is placed.
fn settle(bal: Balancer, n: i64) {
    for _ in 0..500 {
        if bal.open.load() == n {
            return;
        }
        sleep(Duration.ms(5));
    }
    println(f"  (still {bal.open.load()} open, wanted {n})");
}

fn read_all(s: &TcpStream) -> String {
    let mut out: Vec[u8] = Vec.new();
    let mut buf = [0u8; 256];
    loop {
        match s.read(&mut buf) {
            Ok(0) => break,
            Ok(n) => out.extend_from_slice(&buf[0..n]),
            Err(e) => {
                out.extend_from_slice(format!("<{}>", e).bytes());
                break;
            }
        }
    }
    String.from_utf8(out).unwrap_or("<not utf-8>".to_string())
}

fn client(bal: Balancer, id: i64, lines: &[&str], keep: i64) {
    match TcpStream.connect(FRONT) {
        Ok(s) => {
            for l in lines {
                let _ = s.write_all(format!("{}\n", l).bytes());
            }
            let _ = s.shutdown_write();
            let text = read_all(&s);
            println(f"  client {id}: {text.trim_end().replace("\n", " | ")}");
        }
        Err(e) => println(f"  client {id}: connect failed: {e}"),
    }
    settle(bal, keep);
}

fn rounds(bal: Balancer, n: i64) {
    for _ in 0..n {
        check_round(bal);
    }
    for e in bal.take_events() {
        println(f"  event: {e}");
    }
}

fn main() {
    self_test();

    let health = Health { sick: vec![Atomic.new(false), Atomic.new(false), Atomic.new(false)] };
    let bal = new_balancer(&[("alpha", ALPHA), ("beta", BETA), ("gamma", GAMMA)]);
    let group = TaskGroup.new();
    group.spawn(|| backend("alpha", ALPHA, health, 0));
    group.spawn(|| backend("beta", BETA, health, 1));
    group.spawn(|| front(bal, FRONT));
    println(f"== live: listening {wait_up(&[ALPHA, BETA]) and wait_ready(bal)}");

    println("== live: alpha and beta come up; gamma is not running");
    rounds(bal, 2);
    client(bal, 1, &["hello", "world"], 0);
    client(bal, 2, &["one"], 0);
    client(bal, 3, &["two", "three", "four"], 0);
    client(bal, 4, &[], 0);

    println("== live: beta reports FAIL");
    health.sick[1].store(true);
    rounds(bal, 1);
    rounds(bal, 1);
    client(bal, 5, &["five"], 0);
    client(bal, 6, &["six"], 0);

    println("== live: gamma starts");
    group.spawn(|| backend("gamma", GAMMA, health, 2));
    println(f"  listening {wait_up(&[GAMMA])}");
    rounds(bal, 2);
    client(bal, 7, &["seven"], 0);
    client(bal, 8, &["eight"], 0);

    println("== live: least connections, one client held open");
    bal.set_policy(Policy.LeastConn);
    let held = TcpStream.connect(FRONT).unwrap();
    let _ = held.write_all("held\n".bytes());
    let mut buf = [0u8; 64];
    let n = held.read(&mut buf).unwrap_or(0);
    println(f"  held: {String.from_utf8(buf[0..n].to_vec()).unwrap_or(String.new()).trim_end()}");
    settle(bal, 1);
    client(bal, 9, &["nine"], 1);
    client(bal, 10, &["ten"], 1);
    let _ = held.shutdown_write();
    println(f"  held, after: {read_all(&held).trim_end()}");
    drop(held);
    settle(bal, 0);

    println("== live: every backend sick");
    health.sick[0].store(true);
    health.sick[2].store(true);
    rounds(bal, 2);
    client(bal, 11, &["anyone?"], 0);
    for e in bal.take_events() {
        println(f"  event: {e}");
    }

    println("== live: totals");
    {
        let g = bal.pool.lock();
        for b in g.value.backends.iter() {
            println(f"  {b.name}: {if b.up { "up" } else { "down" }}, {b.total} connections, {b.bytes_in} bytes in, {b.bytes_out} bytes out");
        }
    }
    group.cancel();
    println("done");
}
