// A REST service for todo items, the way a small web framework is put
// together: a hand-written JSON library (parser with positioned errors,
// writer with escapes), a router of function values with `:id` path
// parameters and 404 / 405 answers, a middleware chain of closures (bearer
// auth on writes, a request id), an access log, query-string filters, and
// HTTP/1.1 keep-alive with several pipelined requests on one connection.
//
// The server and its client run in one thread: the client connects, writes
// every request of a session and shuts down its write side; the server
// accepts, reads to end of input, answers each request in order, and
// closes; the client splits the responses by Content-Length.
//
// Workarounds for v2 gaps, each to revert once its row is fixed:
//   B-2026-10-12-6   number parse returns Option, not Result
//   B-2026-10-12-7   split() is an eager Vec[String]: bound before .iter()
//   B-2026-10-14-59  the auth closure's binding carries its full Fn type
//   B-2026-10-14-60  field() calls find_field, an index loop over the Vec
//   B-2026-10-14-61  middleware is called as middleware[i](r), not m(r)

const ADDR: Str = "127.0.0.1:47733";
const TOKEN: Str = "s3cret";

// ---- JSON -------------------------------------------------------------

enum JVal { Null, Bool(bool), Num(f64), Text(String), Arr(Vec[JVal]), Obj(Vec[(String, JVal)]) }

struct JsonReader { chars: Vec[char], at: i64 }

impl JsonReader {
    fn fail(self, what: Str) -> String {
        f"{what} at offset {self.at}"
    }

    fn skip_ws(mut ref self) {
        while self.at < self.chars.len() {
            let c = self.chars[self.at];
            if c == ' ' or c == '\n' or c == '\t' or c == '\r' {
                self.at += 1;
            } else {
                break;
            }
        }
    }

    fn peek(self) -> Option[char] {
        if self.at < self.chars.len() { Some(self.chars[self.at]) } else { None }
    }

    fn expect(mut ref self, c: char) -> Result[(), String] {
        self.skip_ws();
        match self.peek() {
            Some(d) => {
                if d == c {
                    self.at += 1;
                    Ok(())
                } else {
                    Err(self.fail(f"expected '{c}', found '{d}'"))
                }
            }
            None => Err(self.fail(f"expected '{c}', found end of input")),
        }
    }

    fn word(mut ref self, w: Str, v: own JVal) -> Result[JVal, String] {
        for c in w.chars() {
            if self.peek() != Some(c) {
                return Err(self.fail(f"invalid literal, expected {w}"));
            }
            self.at += 1;
        }
        Ok(v)
    }

    fn string(mut ref self) -> Result[String, String] {
        self.expect('"')?;
        let mut out = String.new();
        loop {
            let c = match self.peek() {
                Some(c) => c,
                None => return Err(self.fail("unterminated string")),
            };
            self.at += 1;
            if c == '"' {
                return Ok(out);
            }
            if c != '\\' {
                if (c as u32) < 32u32 {
                    return Err(self.fail("control character in string"));
                }
                out.push(c);
                continue;
            }
            let e = match self.peek() {
                Some(e) => e,
                None => return Err(self.fail("unterminated escape")),
            };
            self.at += 1;
            match e {
                '"' => out.push('"'),
                '\\' => out.push('\\'),
                '/' => out.push('/'),
                'n' => out.push('\n'),
                't' => out.push('\t'),
                'r' => out.push('\r'),
                'b' => out.push('\u{8}'),
                'f' => out.push('\u{c}'),
                'u' => {
                    let mut code = 0u32;
                    for _ in 0..4 {
                        let h = match self.peek() {
                            Some(h) => h,
                            None => return Err(self.fail("short \\u escape")),
                        };
                        let d = match h.to_digit(16) {
                            Some(d) => d,
                            None => return Err(self.fail("bad hex digit in \\u escape")),
                        };
                        code = code * 16u32 + d;
                        self.at += 1;
                    }
                    match char.try_from(code) {
                        Ok(ch) => out.push(ch),
                        Err(_) => return Err(self.fail("\\u escape is not a scalar value")),
                    }
                }
                _ => return Err(self.fail(f"bad escape '\\{e}'")),
            }
        }
    }

    fn number(mut ref self) -> Result[JVal, String] {
        let start = self.at;
        while self.at < self.chars.len() {
            let c = self.chars[self.at];
            if c.is_ascii_digit() or c == '-' or c == '+' or c == '.' or c == 'e' or c == 'E' {
                self.at += 1;
            } else {
                break;
            }
        }
        let text: String = self.chars[start..self.at].iter().collect();
        match f64.parse(text).ok() {
            Some(x) => Ok(JVal.Num(x)),
            None => {
                self.at = start;
                Err(self.fail(f"bad number '{text}'"))
            }
        }
    }

    fn value(mut ref self, depth: i64) -> Result[JVal, String] {
        if depth > 32 {
            return Err(self.fail("nesting too deep"));
        }
        self.skip_ws();
        match self.peek() {
            None => Err(self.fail("expected a value, found end of input")),
            Some('n') => self.word("null", JVal.Null),
            Some('t') => self.word("true", JVal.Bool(true)),
            Some('f') => self.word("false", JVal.Bool(false)),
            Some('"') => Ok(JVal.Text(self.string()?)),
            Some('[') => {
                self.at += 1;
                let mut items: Vec[JVal] = Vec.new();
                self.skip_ws();
                if self.peek() == Some(']') {
                    self.at += 1;
                    return Ok(JVal.Arr(items));
                }
                loop {
                    items.push(self.value(depth + 1)?);
                    self.skip_ws();
                    match self.peek() {
                        Some(',') => self.at += 1,
                        Some(']') => {
                            self.at += 1;
                            return Ok(JVal.Arr(items));
                        }
                        _ => return Err(self.fail("expected ',' or ']'")),
                    }
                }
            }
            Some('{') => {
                self.at += 1;
                let mut fields: Vec[(String, JVal)] = Vec.new();
                self.skip_ws();
                if self.peek() == Some('}') {
                    self.at += 1;
                    return Ok(JVal.Obj(fields));
                }
                loop {
                    self.skip_ws();
                    let k = self.string()?;
                    self.expect(':')?;
                    let v = self.value(depth + 1)?;
                    fields.push((k, v));
                    self.skip_ws();
                    match self.peek() {
                        Some(',') => self.at += 1,
                        Some('}') => {
                            self.at += 1;
                            return Ok(JVal.Obj(fields));
                        }
                        _ => return Err(self.fail("expected ',' or '}'")),
                    }
                }
            }
            Some(c) => {
                if c == '-' or c.is_ascii_digit() {
                    self.number()
                } else {
                    Err(self.fail(f"unexpected '{c}'"))
                }
            }
        }
    }
}

fn parse_json(text: Str) -> Result[JVal, String] {
    let mut r = JsonReader { chars: text.chars().collect(), at: 0 };
    let v = r.value(0)?;
    r.skip_ws();
    if r.at < r.chars.len() {
        return Err(r.fail("trailing characters"));
    }
    Ok(v)
}

fn quote(s: Str, out: mut ref String) {
    out.push('"');
    for c in s.chars() {
        match c {
            '"' => out.push_str("\\\""),
            '\\' => out.push_str("\\\\"),
            '\n' => out.push_str("\\n"),
            '\r' => out.push_str("\\r"),
            '\t' => out.push_str("\\t"),
            '\u{8}' => out.push_str("\\b"),
            '\u{c}' => out.push_str("\\f"),
            _ => {
                if (c as u32) < 32u32 {
                    out.push_str(f"\\u{c as u32:04x}");
                } else {
                    out.push(c);
                }
            }
        }
    }
    out.push('"');
}

fn write_json(v: ref JVal, out: mut ref String) {
    match v {
        JVal.Null => out.push_str("null"),
        JVal.Bool(b) => out.push_str(if b { "true" } else { "false" }),
        JVal.Num(x) => {
            if x == x.floor() and x.abs() < 1e15 {
                out.push_str(f"{x as i64}");
            } else {
                out.push_str(f"{x}");
            }
        }
        JVal.Text(s) => quote(s, mut out),
        JVal.Arr(items) => {
            out.push('[');
            let mut first = true;
            for it in items.iter() {
                if not first {
                    out.push(',');
                }
                first = false;
                write_json(it, mut out);
            }
            out.push(']');
        }
        JVal.Obj(fields) => {
            out.push('{');
            let mut first = true;
            for (k, it) in fields.iter() {
                if not first {
                    out.push(',');
                }
                first = false;
                quote(k, mut out);
                out.push(':');
                write_json(it, mut out);
            }
            out.push('}');
        }
    }
}

fn to_json(v: ref JVal) -> String {
    let mut s = String.new();
    write_json(v, mut s);
    s
}

fn find_field(fields: ref Vec[(String, JVal)], name: Str) -> Option[ref JVal] {
    let mut i = 0;
    while i < fields.len() {
        if fields[i].0 == name {
            let it = ref fields[i].1;
            return Some(it);
        }
        i += 1;
    }
    None
}

fn field(v: ref JVal, name: Str) -> Option[ref JVal] {
    match v {
        JVal.Obj(fields) => find_field(fields, name),
        _ => None,
    }
}

// ---- HTTP and routing -------------------------------------------------

struct HttpReq { method: String, path: String, query: Vec[(String, String)], headers: Vec[(String, String)], body: String, id: i64 }

struct HttpResp { status: i64, body: String }

struct Todo { id: i64, title: String, done: bool, tags: Vec[String] }

struct State { todos: SortedMap[i64, Todo], next_id: i64, log: Vec[String] }

struct Route { method: String, pattern: Vec[String], handler: Fn(mut ref State, ref HttpReq, ref Vec[String]) -> HttpResp }

fn reason(status: i64) -> Str {
    match status {
        200 => "OK",
        201 => "Created",
        204 => "No Content",
        400 => "Bad Request",
        401 => "Unauthorized",
        404 => "Not Found",
        405 => "Method Not Allowed",
        _ => "Unknown",
    }
}

fn error(status: i64, msg: Str) -> HttpResp {
    let body = JVal.Obj(vec![("error".to_string(), JVal.Text(msg.to_string()))]);
    HttpResp { status: status, body: to_json(body) }
}

fn header(r: ref HttpReq, name: Str) -> Option[String] {
    for (k, v) in r.headers.iter() {
        if k.to_lowercase() == name.to_lowercase() {
            return Some(v.clone());
        }
    }
    None
}

fn segments(path: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for s in path.split("/") {
        if not s.is_empty() {
            out.push(s.to_string());
        }
    }
    out
}

// The parameters a pattern captures from a path, or None if it does not
// match. A `:name` segment matches any one segment.
fn match_route(pattern: ref Vec[String], path: ref Vec[String]) -> Option[Vec[String]] {
    if pattern.len() != path.len() {
        return None;
    }
    let mut params: Vec[String] = Vec.new();
    for i in 0..pattern.len() {
        if pattern[i].starts_with(":") {
            params.push(path[i].clone());
        } else if pattern[i] != path[i] {
            return None;
        }
    }
    Some(params)
}

fn percent_decode(s: Str) -> String {
    let b = s.bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        if b[i] == 43u8 {
            out.push(32u8);
        } else if b[i] == 37u8 and i + 2 < b.len() {
            let hex: String = s[i + 1..i + 3].to_string();
            match u8.from_str_radix(hex, 16) {
                Some(v) => {
                    out.push(v);
                    i += 2;
                }
                None => out.push(b[i]),
            }
        } else {
            out.push(b[i]);
        }
        i += 1;
    }
    String.from_utf8(out).unwrap_or(s.to_string())
}

fn todo_json(t: ref Todo) -> JVal {
    let tags: Vec[JVal] = t.tags.iter().map(|s| JVal.Text(s.clone())).collect();
    JVal.Obj(vec![
        ("id".to_string(), JVal.Num(t.id as f64)),
        ("title".to_string(), JVal.Text(t.title.clone())),
        ("done".to_string(), JVal.Bool(t.done)),
        ("tags".to_string(), JVal.Arr(tags)),
    ])
}

fn ok_json(status: i64, v: ref JVal) -> HttpResp {
    HttpResp { status: status, body: to_json(v) }
}

fn id_param(params: ref Vec[String]) -> Result[i64, HttpResp] {
    match i64.parse(params[0]).ok() {
        Some(n) => Ok(n),
        None => Err(error(400, f"bad id '{params[0]}'")),
    }
}

fn h_health(st: mut ref State, r: ref HttpReq, p: ref Vec[String]) -> HttpResp {
    let v = JVal.Obj(vec![("ok".to_string(), JVal.Bool(true)), ("todos".to_string(), JVal.Num(st.todos.len() as f64))]);
    ok_json(200, v)
}

fn h_list(st: mut ref State, r: ref HttpReq, p: ref Vec[String]) -> HttpResp {
    let mut want_done: Option[bool] = None;
    let mut want_tag: Option[String] = None;
    for (k, v) in r.query.iter() {
        if k == "done" {
            want_done = Some(v == "true");
        } else if k == "tag" {
            want_tag = Some(v.clone());
        }
    }
    let mut items: Vec[JVal] = Vec.new();
    for (_, t) in st.todos.iter() {
        let done_ok = match want_done {
            Some(d) => t.done == d,
            None => true,
        };
        let tag_ok = match want_tag {
            Some(ref g) => t.tags.contains(g),
            None => true,
        };
        if done_ok and tag_ok {
            items.push(todo_json(t));
        }
    }
    ok_json(200, JVal.Arr(items))
}

fn h_create(st: mut ref State, r: ref HttpReq, p: ref Vec[String]) -> HttpResp {
    let body = match parse_json(r.body) {
        Ok(v) => v,
        Err(e) => return error(400, f"invalid JSON: {e}"),
    };
    let title = match field(body, "title") {
        Some(JVal.Text(s)) => s.clone(),
        Some(_) => return error(400, "title must be a string"),
        None => return error(400, "title is required"),
    };
    let mut tags: Vec[String] = Vec.new();
    match field(body, "tags") {
        Some(JVal.Arr(items)) => {
            for it in items.iter() {
                match it {
                    JVal.Text(s) => tags.push(s.clone()),
                    _ => return error(400, "tags must be strings"),
                }
            }
        }
        Some(_) => return error(400, "tags must be an array"),
        None => {}
    }
    let id = st.next_id;
    st.next_id += 1;
    let t = Todo { id: id, title: title, done: false, tags: tags };
    let v = todo_json(t);
    st.todos.insert(id, t);
    ok_json(201, v)
}

fn h_get(st: mut ref State, r: ref HttpReq, p: ref Vec[String]) -> HttpResp {
    let id = match id_param(p) {
        Ok(n) => n,
        Err(resp) => return resp,
    };
    match st.todos.get(id) {
        Some(t) => ok_json(200, todo_json(t)),
        None => error(404, f"no todo {id}"),
    }
}

fn h_patch(st: mut ref State, r: ref HttpReq, p: ref Vec[String]) -> HttpResp {
    let id = match id_param(p) {
        Ok(n) => n,
        Err(resp) => return resp,
    };
    let body = match parse_json(r.body) {
        Ok(v) => v,
        Err(e) => return error(400, f"invalid JSON: {e}"),
    };
    let mut t = match st.todos.remove(id) {
        Some(t) => t,
        None => return error(404, f"no todo {id}"),
    };
    let mut problem: Option[String] = None;
    match field(body, "done") {
        Some(JVal.Bool(b)) => t.done = b,
        Some(_) => problem = Some("done must be a boolean".to_string()),
        None => {}
    }
    match field(body, "title") {
        Some(JVal.Text(s)) => t.title = s.clone(),
        Some(_) => problem = Some("title must be a string".to_string()),
        None => {}
    }
    let v = todo_json(t);
    st.todos.insert(id, t);
    match problem {
        Some(m) => error(400, m),
        None => ok_json(200, v),
    }
}

fn h_delete(st: mut ref State, r: ref HttpReq, p: ref Vec[String]) -> HttpResp {
    let id = match id_param(p) {
        Ok(n) => n,
        Err(resp) => return resp,
    };
    match st.todos.remove(id) {
        Some(_) => HttpResp { status: 204, body: String.new() },
        None => error(404, f"no todo {id}"),
    }
}

fn route(method: Str, pattern: Str, handler: escaping Fn(mut ref State, ref HttpReq, ref Vec[String]) -> HttpResp with allocates(Heap)) -> Route {
    Route { method: method.to_string(), pattern: segments(pattern), handler: handler }
}

fn dispatch(routes: ref Vec[Route], st: mut ref State, r: ref HttpReq) -> HttpResp {
    let path = segments(r.path);
    let mut allowed: Vec[String] = Vec.new();
    for rt in routes.iter() {
        match match_route(rt.pattern, path) {
            Some(params) => {
                if rt.method == r.method {
                    return (rt.handler)(mut st, r, params);
                }
                allowed.push(rt.method.clone());
            }
            None => {}
        }
    }
    if allowed.is_empty() {
        error(404, f"no route for {r.path}")
    } else {
        error(405, f"use {allowed.join(", ")}")
    }
}

// Middleware runs before routing; the first that answers wins.
fn handle(routes: ref Vec[Route], middleware: ref Vec[Fn(ref HttpReq) -> Option[HttpResp] with allocates(Heap)], st: mut ref State, r: ref HttpReq) -> HttpResp {
    let mut i = 0;
    while i < middleware.len() {
        match middleware[i](r) {
            Some(resp) => return resp,
            None => {}
        }
        i += 1;
    }
    dispatch(routes, mut st, r)
}

fn parse_requests(raw: Str) -> Result[Vec[HttpReq], String] {
    let mut out: Vec[HttpReq] = Vec.new();
    let mut at = 0;
    while at < raw.len() {
        let rest = raw[at..raw.len()];
        let head_end = match rest.find("\r\n\r\n") {
            Some(i) => i,
            None => return Err("incomplete request head".to_string()),
        };
        let head = rest[0..head_end];
        let all_lines: Vec[Str] = head.split("\r\n").collect();
        let mut lines = all_lines.iter();
        let first = match lines.next() {
            Some(l) => l.to_string(),
            None => return Err("empty request".to_string()),
        };
        let parts: Vec[String] = first.split(" ").map(|s| s.to_string()).collect();
        if parts.len() != 3 {
            return Err(f"bad request line '{first}'");
        }
        let mut headers: Vec[(String, String)] = Vec.new();
        let mut length = 0;
        for l in lines {
            match l.find(":") {
                Some(i) => {
                    let k = l[0..i].trim().to_string();
                    let v = l[i + 1..l.len()].trim().to_string();
                    if k.to_lowercase() == "content-length" {
                        length = match i64.parse(v).ok() {
                            Some(n) => n,
                            None => return Err(f"bad Content-Length '{v}'"),
                        };
                    }
                    headers.push((k, v));
                }
                None => return Err(f"bad header '{l}'"),
            }
        }
        let body_start = at + head_end + 4;
        if body_start + length > raw.len() {
            return Err("body shorter than Content-Length".to_string());
        }
        let body = raw[body_start..body_start + length].to_string();
        let target = parts[1].clone();
        let (path, qs) = match target.find("?") {
            Some(i) => (target[0..i].to_string(), target[i + 1..target.len()].to_string()),
            None => (target.clone(), String.new()),
        };
        let mut query: Vec[(String, String)] = Vec.new();
        for pair in qs.split("&") {
            if pair.is_empty() {
                continue;
            }
            match pair.find("=") {
                Some(i) => query.push((percent_decode(pair[0..i]), percent_decode(pair[i + 1..pair.len()]))),
                None => query.push((percent_decode(pair), String.new())),
            }
        }
        out.push(HttpReq { method: parts[0].clone(), path: path, query: query, headers: headers, body: body, id: 0 });
        at = body_start + length;
    }
    Ok(out)
}

fn render(resp: ref HttpResp, id: i64) -> String {
    let mut s = f"HTTP/1.1 {resp.status} {reason(resp.status)}\r\nX-Request-Id: {id}\r\nContent-Length: {resp.body.len()}\r\n";
    if not resp.body.is_empty() {
        s.push_str("Content-Type: application/json\r\n");
    }
    s.push_str("\r\n");
    s.push_str(resp.body);
    s
}

fn read_all(conn: ref TcpStream) -> Result[String, String] {
    let mut bytes: Vec[u8] = Vec.new();
    let mut buf: Array[u8, 64] = [0u8; 64];
    loop {
        match conn.read(mut buf) {
            Ok(0) => break,
            Ok(n) => {
                for i in 0..n {
                    bytes.push(buf[i]);
                }
            }
            Err(_) => return Err("read failed".to_string()),
        }
    }
    match String.from_utf8(bytes) {
        Ok(s) => Ok(s),
        Err(_) => Err("not utf-8".to_string()),
    }
}

struct App { routes: Vec[Route], middleware: Vec[Fn(ref HttpReq) -> Option[HttpResp]], next_request: i64 }

fn serve_conn(srv: mut ref App, st: mut ref State, raw: Str) -> String {
    let reqs = match parse_requests(raw) {
        Ok(r) => r,
        Err(e) => return render(error(400, e), 0),
    };
    let mut out = String.new();
    for r in reqs.iter() {
        srv.next_request += 1;
        let resp = handle(srv.routes, srv.middleware, mut st, r);
        st.log.push(f"#{srv.next_request} {r.method} {r.path} -> {resp.status} ({resp.body.len()} bytes)");
        out.push_str(render(resp, srv.next_request));
    }
    out
}

fn request(method: Str, target: Str, auth: bool, body: Str) -> String {
    let mut s = f"{method} {target} HTTP/1.1\r\nHost: 127.0.0.1\r\n";
    if auth {
        s.push_str(f"Authorization: Bearer {TOKEN}\r\n");
    }
    if not body.is_empty() {
        s.push_str(f"Content-Type: application/json\r\nContent-Length: {body.len()}\r\n");
    }
    s.push_str("\r\n");
    s.push_str(body);
    s
}

fn print_responses(resp: Str) {
    let mut at = 0;
    while at < resp.len() {
        let rest = resp[at..resp.len()];
        let head_end = match rest.find("\r\n\r\n") {
            Some(i) => i,
            None => {
                println("  (truncated response)");
                return;
            }
        };
        let head = rest[0..head_end];
        let mut status = String.new();
        let mut rid = String.new();
        let mut length = 0;
        let mut first = true;
        for l in head.split("\r\n") {
            if first {
                status = l.to_string();
                first = false;
            } else if l.starts_with("Content-Length: ") {
                length = i64.parse(l[16..l.len()]).unwrap_or(0);
            } else if l.starts_with("X-Request-Id: ") {
                rid = l[14..l.len()].to_string();
            }
        }
        let body = rest[head_end + 4..head_end + 4 + length];
        if body.is_empty() {
            println(f"  [{rid}] {status}");
        } else {
            println(f"  [{rid}] {status} {body}");
        }
        at += head_end + 4 + length;
    }
}

fn session(listener: ref TcpListener, srv: mut ref App, st: mut ref State, label: Str, batch: Str) {
    println(f"== {label}");
    let client = match TcpStream.connect(ADDR) {
        Ok(c) => c,
        Err(_) => {
            println("connect failed");
            return;
        }
    };
    match client.write_all(batch.bytes()) {
        Ok(_) => {}
        Err(_) => println("client write failed"),
    }
    match client.shutdown_write() {
        Ok(_) => {}
        Err(_) => println("shutdown failed"),
    }
    match listener.accept() {
        Ok(conn) => {
            let out = match read_all(conn) {
                Ok(raw) => serve_conn(mut srv, mut st, raw),
                Err(e) => render(error(400, e), 0),
            };
            match conn.write_all(out.bytes()) {
                Ok(_) => {}
                Err(_) => println("server write failed"),
            }
        }
        Err(_) => println("accept failed"),
    }
    match read_all(client) {
        Ok(resp) => print_responses(resp),
        Err(e) => println(f"client read: {e}"),
    }
}

fn main() {
    let listener = match TcpListener.bind(ADDR) {
        Ok(l) => l,
        Err(_) => {
            println("bind failed");
            return;
        }
    };
    let token = f"Bearer {TOKEN}";
    let auth: Fn(ref HttpReq) -> Option[HttpResp] with allocates(Heap) = |r: ref HttpReq| {
        if r.method == "GET" {
            return None;
        }
        match header(r, "authorization") {
            Some(h) => if h == token { None } else { Some(error(401, "bad token")) },
            None => Some(error(401, "missing bearer token")),
        }
    };
    let too_big = |r: ref HttpReq| {
        if r.body.len() > 256 { Some(error(400, "body too large")) } else { None }
    };
    let mut srv = App {
        routes: vec![
            route("GET", "/health", h_health),
            route("GET", "/todos", h_list),
            route("POST", "/todos", h_create),
            route("GET", "/todos/:id", h_get),
            route("PATCH", "/todos/:id", h_patch),
            route("DELETE", "/todos/:id", h_delete),
        ],
        middleware: vec![auth, too_big],
        next_request: 0,
    };
    let mut st = State { todos: SortedMap.new(), next_id: 1, log: Vec.new() };

    let mut b = request("GET", "/health", false, "");
    b.push_str(request("POST", "/todos", true, "{\"title\": \"buy milk\", \"tags\": [\"home\", \"errand\"]}"));
    b.push_str(request("POST", "/todos", true, "{\"title\":\"write \\\"report\\\"\\n\\tdraft \\u00e9t\\u00e9\",\"tags\":[\"work\"]}"));
    b.push_str(request("POST", "/todos", true, "  { \"title\" : \"call mum\" , \"tags\" : [ ] , \"priority\" : 2.5 }  "));
    b.push_str(request("GET", "/todos", false, ""));
    session(listener, mut srv, mut st, "create", b);

    let mut b = request("PATCH", "/todos/1", true, "{\"done\": true}");
    b.push_str(request("GET", "/todos?done=true", false, ""));
    b.push_str(request("GET", "/todos?done=false&tag=work", false, ""));
    b.push_str(request("GET", "/todos?tag=home%20x", false, ""));
    b.push_str(request("GET", "/todos/2", false, ""));
    b.push_str(request("DELETE", "/todos/3", true, ""));
    b.push_str(request("GET", "/todos/3", false, ""));
    session(listener, mut srv, mut st, "update", b);

    let mut b = request("POST", "/todos", false, "{\"title\": \"no auth\"}");
    b.push_str(request("DELETE", "/todos/1", false, ""));
    b.push_str(request("PUT", "/todos/1", true, "{}"));
    b.push_str(request("GET", "/nope", false, ""));
    b.push_str(request("GET", "/todos/abc", false, ""));
    b.push_str(request("POST", "/todos", true, "{\"title\": 5}"));
    b.push_str(request("POST", "/todos", true, "{\"tags\": []}"));
    b.push_str(request("POST", "/todos", true, "{\"title\": \"x\", \"tags\": [1]}"));
    b.push_str(request("POST", "/todos", true, "{\"title\" \"x\"}"));
    b.push_str(request("POST", "/todos", true, "[1, 2,]"));
    b.push_str(request("POST", "/todos", true, "{\"title\": \"bad \\q\"}"));
    b.push_str(request("POST", "/todos", true, "{\"title\": \"x\"} extra"));
    b.push_str(request("POST", "/todos", true, "tru"));
    b.push_str(request("PATCH", "/todos/2", true, "{\"done\": \"yes\"}"));
    b.push_str(request("PATCH", "/todos/9", true, "{\"done\": true}"));
    session(listener, mut srv, mut st, "errors", b);

    let mut long = String.from("{\"title\": \"");
    for _ in 0..300 {
        long.push('x');
    }
    long.push_str("\"}");
    let mut b = request("POST", "/todos", true, long);
    b.push_str(request("GET", "/health", false, ""));
    session(listener, mut srv, mut st, "limits", b);

    println("== access log");
    for l in st.log.iter() {
        println(f"  {l}");
    }
}
