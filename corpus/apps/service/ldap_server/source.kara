// ldap_server: an LDAPv3 directory server on loopback TCP (RFC 4511), every
// message BER-encoded, and the scripted clients that bind, search with RFC
// 4515 filter strings, compare, add, modify and delete. Each connection is
// a task; the directory is one tree behind a mutex, kept in tree order.

import std.io.{BufReader};
import std.net.{TcpListener, TcpStream};
import std.sync.{Mutex};
import std.time.Duration;
import std.sync.{TaskGroup};

const ADDR: Str = "127.0.0.1:23787";
const SESSIONS: i64 = 6;
const BASE: Str = "dc=kara,dc=test";
const ADMIN: Str = "cn=admin,dc=kara,dc=test";
// Obviously fake credentials.
const ADMIN_PASSWORD: Str = "not-a-real-secret/admin";
const NOTICE_OID: Str = "1.3.6.1.4.1.1466.20036";
const MAX_MESSAGE: i64 = 1 << 20;

const SUCCESS: i64 = 0;
const PROTOCOL_ERROR: i64 = 2;
const SIZE_LIMIT_EXCEEDED: i64 = 4;
const COMPARE_FALSE: i64 = 5;
const COMPARE_TRUE: i64 = 6;
const AUTH_METHOD_NOT_SUPPORTED: i64 = 7;
const NO_SUCH_ATTRIBUTE: i64 = 16;
const ATTRIBUTE_OR_VALUE_EXISTS: i64 = 20;
const NO_SUCH_OBJECT: i64 = 32;
const INVALID_DN_SYNTAX: i64 = 34;
const INVALID_CREDENTIALS: i64 = 49;
const INSUFFICIENT_ACCESS: i64 = 50;
const NAMING_VIOLATION: i64 = 64;
const OBJECT_CLASS_VIOLATION: i64 = 65;
const NOT_ALLOWED_ON_NON_LEAF: i64 = 66;
const ENTRY_ALREADY_EXISTS: i64 = 68;

fn result_name(code: i64) -> String {
    let name = match code {
        0 => "success",
        1 => "operationsError",
        2 => "protocolError",
        4 => "sizeLimitExceeded",
        5 => "compareFalse",
        6 => "compareTrue",
        7 => "authMethodNotSupported",
        16 => "noSuchAttribute",
        20 => "attributeOrValueExists",
        32 => "noSuchObject",
        34 => "invalidDNSyntax",
        49 => "invalidCredentials",
        50 => "insufficientAccessRights",
        64 => "namingViolation",
        65 => "objectClassViolation",
        66 => "notAllowedOnNonLeaf",
        68 => "entryAlreadyExists",
        _ => return code.to_string(),
    };
    name.to_string()
}

/// Attribute types whose values order and match as integers.
fn is_numeric(t: Str) -> bool {
    let t = t.to_ascii_lowercase();
    t == "uidnumber" or t == "gidnumber"
}

/// Attribute types whose values match exactly, byte for byte.
fn is_exact(t: Str) -> bool {
    t.to_ascii_lowercase() == "userpassword"
}

#[derive(Debug)]
struct BerError { value: String }

// ---- BER

fn enc_len(n: i64) -> Vec[u8] {
    if n < 0x80 {
        [n as u8]
    } else if n < 0x100 {
        [0x81, n as u8]
    } else if n < 0x10000 {
        [0x82, (n >> 8) as u8, (n & 0xff) as u8]
    } else {
        [0x83, (n >> 16) as u8, ((n >> 8) & 0xff) as u8, (n & 0xff) as u8]
    }
}

fn tlv(tag: u8, content: Slice[u8]) -> Vec[u8] {
    let mut out = [tag];
    out.extend_from_slice(enc_len(content.len()));
    out.extend_from_slice(content);
    out
}

fn enc_int(tag: u8, n: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut n = n;
    loop {
        out.insert(0, (n & 0xff) as u8);
        n >>= 8;
        if (n == 0 and out[0] < 0x80) or (n == -1 and out[0] >= 0x80) {
            break;
        }
    }
    tlv(tag, out)
}

fn enc_str(tag: u8, s: Str) -> Vec[u8] {
    tlv(tag, s.bytes())
}

fn seq(tag: u8, parts: Vec[Vec[u8]]) -> Vec[u8] {
    let mut body = Vec.new();
    for p in parts {
        body.extend_from_slice(p);
    }
    tlv(tag, body)
}

/// Reads TLVs off a byte string; every read checks the bounds.
struct Reader {
    data: Vec[u8],
    pos: i64,
}

impl Reader {
    fn new(data: Slice[u8]) -> Reader {
        Reader { data: data.to_vec(), pos: 0 }
    }

    fn done(self) -> bool {
        self.pos >= self.data.len()
    }

    fn read(mut ref self) -> Result[(u8, Vec[u8]), BerError] {
        if self.pos + 2 > self.data.len() {
            return Err(BerError { value: "truncated".to_string() });
        }
        let tag = self.data[self.pos];
        if tag & 0x1f == 0x1f {
            return Err(BerError { value: "high tag numbers are not used".to_string() });
        }
        let first = self.data[self.pos + 1];
        self.pos += 2;
        let n = if first < 0x80 {
            first as i64
        } else {
            let k = (first & 0x7f) as i64;
            if k == 0 or k > 3 {
                return Err(BerError { value: "bad length".to_string() });
            }
            if self.pos + k > self.data.len() {
                return Err(BerError { value: "truncated".to_string() });
            }
            let mut n = 0;
            for b in self.data[self.pos..self.pos + k] {
                n = n * 256 + *b;
            }
            self.pos += k;
            n
        };
        if self.pos + n > self.data.len() {
            return Err(BerError { value: "truncated".to_string() });
        }
        let body = self.data[self.pos..self.pos + n].to_vec();
        self.pos += n;
        Ok((tag, body))
    }

    fn expect(mut ref self, tag: u8) -> Result[Vec[u8], BerError] {
        let (t, body) = self.read()?;
        if t != tag {
            return Err(BerError { value: f"expected tag 0x{tag:02x}, got 0x{t:02x}" });
        }
        Ok(body)
    }

    fn int(mut ref self, tag: u8) -> Result[i64, BerError] {
        let body = self.expect(tag)?;
        if body.is_empty() or body.len() > 8 {
            return Err(BerError { value: "bad integer".to_string() });
        }
        let mut n: i64 = if body[0] >= 0x80 { -1 } else { 0 };
        for b in ref body {
            n = (n << 8) | *b;
        }
        Ok(n)
    }

    fn text(mut ref self, tag: u8) -> Result[String, BerError] {
        let body = self.expect(tag)?;
        String.from_utf8(body).map_err(|_| BerError { value: "not UTF-8".to_string() })
    }

    fn boolean(mut ref self) -> Result[bool, BerError] {
        let body = self.expect(0x01)?;
        if body.len() != 1 {
            return Err(BerError { value: "bad boolean".to_string() });
        }
        Ok(body[0] != 0)
    }
}

// ---- distinguished names

/// The RDNs of a DN string, split at unescaped commas; None if bad.
fn split_dn(dn: Str) -> Option[Vec[(String, String)]] {
    if dn.is_empty() {
        return Some(Vec.new());
    }
    let chars: Vec[char] = dn.chars().collect();
    let mut parts: Vec[String] = Vec.new();
    let mut cur = String.new();
    let mut i = 0;
    while i < chars.len() {
        let c = chars[i];
        if c == '\\' {
            if i + 1 >= chars.len() {
                return None;
            }
            cur.push(c);
            cur.push(chars[i + 1]);
            i += 2;
            continue;
        }
        if c == ',' {
            parts.push(cur.clone());
            cur.clear();
        } else {
            cur.push(c);
        }
        i += 1;
    }
    parts.push(cur);
    let mut out = Vec.new();
    for p in ref parts {
        let k = p.find("=")?;
        if k == 0 {
            return None;
        }
        let t = p[..k].trim();
        let v = p[k + 1..].trim();
        if t.is_empty() or v.is_empty() {
            return None;
        }
        out.push((t.to_string(), v.to_string()));
    }
    Some(out)
}

fn unescape(v: Str) -> String {
    let chars: Vec[char] = v.chars().collect();
    let mut out = String.new();
    let mut i = 0;
    while i < chars.len() {
        if chars[i] == '\\' and i + 1 < chars.len() {
            out.push(chars[i + 1]);
            i += 2;
        } else {
            out.push(chars[i]);
            i += 1;
        }
    }
    out
}

/// The DN's identity, root first: its RDNs with types and values
/// case-folded and the values unescaped. A map keyed by it walks the tree
/// in order, each entry before its children.
fn tree_key(rdns: Slice[(String, String)]) -> Vec[String] {
    rdns.iter()
        .rev()
        .map(|(t, v)| f"{t.to_ascii_lowercase()}={unescape(v).to_ascii_lowercase()}")
        .collect()
}

fn parent_of(key: Slice[String]) -> Vec[String] {
    key[..key.len() - 1].to_vec()
}

// ---- the directory

#[derive(Clone)]
struct Entry {
    dn: String,
    attrs: Vec[(String, Vec[String])],
}

impl Entry {
    fn get(self, name: Str) -> Option[ref Vec[String]] {
        for (t, vs) in ref self.attrs {
            if t.eq_ignore_ascii_case(name) {
                return Some(vs);
            }
        }
        None
    }
}

struct State {
    entries: SortedMap[Vec[String], Entry],
    ops: SortedMap[String, i64],
    results: SortedMap[i64, i64],
}

fn attrs(pairs: Slice[(Str, Slice[Str])]) -> Vec[(String, Vec[String])] {
    pairs
        .iter()
        .map(|(t, vs)| (t.to_string(), vs.iter().map(|v| v.to_string()).collect()))
        .collect()
}

fn seed() -> Vec[(String, Vec[(String, Vec[String])])] {
    let people = f"ou=people,{BASE}";
    [
        (BASE.to_string(), attrs([("objectClass", ["top", "domain"]), ("dc", ["kara"])])),
        (people.clone(), attrs([("objectClass", ["organizationalUnit"]), ("ou", ["people"])])),
        (
            f"ou=groups,{BASE}",
            attrs([("objectClass", ["organizationalUnit"]), ("ou", ["groups"])]),
        ),
        (
            ADMIN.to_string(),
            attrs([
                ("objectClass", ["person"]),
                ("cn", ["admin"]),
                ("sn", ["Admin"]),
                ("userPassword", [ADMIN_PASSWORD]),
            ]),
        ),
        (
            f"uid=alice,{people}",
            attrs([
                ("objectClass", ["person", "posixAccount"]),
                ("uid", ["alice"]),
                ("cn", ["Alice Liddell"]),
                ("sn", ["Liddell"]),
                ("mail", ["alice@kara.test"]),
                ("uidNumber", ["1001"]),
                ("userPassword", ["not-a-real-secret/alice"]),
            ]),
        ),
        (
            f"uid=bob,{people}",
            attrs([
                ("objectClass", ["person", "posixAccount"]),
                ("uid", ["bob"]),
                ("cn", ["Bob Builder"]),
                ("sn", ["Builder"]),
                ("mail", ["bob@kara.test", "builder@kara.test"]),
                ("uidNumber", ["1002"]),
                ("userPassword", ["not-a-real-secret/bob"]),
            ]),
        ),
        (
            f"uid=carol,{people}",
            attrs([
                ("objectClass", ["person", "posixAccount"]),
                ("uid", ["carol"]),
                ("cn", ["Carol Danvers"]),
                ("sn", ["Danvers"]),
                ("uidNumber", ["1010"]),
                ("userPassword", ["not-a-real-secret/carol"]),
            ]),
        ),
        (
            f"cn=Smith\\, John,{people}",
            attrs([
                ("objectClass", ["person"]),
                ("cn", ["Smith, John"]),
                ("sn", ["Smith"]),
                ("mail", ["jsmith@kara.test"]),
            ]),
        ),
        (
            f"cn=staff,ou=groups,{BASE}",
            attrs([
                ("objectClass", ["groupOfNames"]),
                ("cn", ["staff"]),
                ("member", [f"uid=alice,{people}".as_str(), f"uid=bob,{people}".as_str()]),
            ]),
        ),
    ]
}

impl State {
    fn new() -> State {
        let mut entries = SortedMap.new();
        for (dn, attrs) in seed().into_iter() {
            let key = tree_key(split_dn(dn).unwrap());
            entries.insert(key, Entry { dn, attrs });
        }
        State { entries, ops: SortedMap.new(), results: SortedMap.new() }
    }

    /// The DN of the deepest existing ancestor of `rdns`, as stored.
    fn matched_dn(self, rdns: Slice[(String, String)]) -> String {
        for i in 1..=rdns.len() {
            if let Some(e) = self.entries.get(tree_key(rdns[i..])) {
                return e.dn.clone();
            }
        }
        String.new()
    }

    fn count_op(mut ref self, op: Str) {
        *self.ops.entry(op.to_string()).or_insert(0) += 1;
    }
}

// ---- filters

shared enum Filter {
    And(Vec[Filter]),
    Or(Vec[Filter]),
    Not(Filter),
    Eq(String, String),
    Ge(String, String),
    Le(String, String),
    Substr(String, Option[String], Vec[String], Option[String]),
    Present(String),
}

/// Compares value `a` with assertion `b` for type `t`; None if they cannot
/// be compared.
fn value_cmp(t: Str, a: Str, b: Str) -> Option[Ordering] {
    if is_numeric(t) {
        let x: i64 = i64.parse(a).ok()?;
        let y: i64 = i64.parse(b).ok()?;
        return Some(x.cmp(y));
    }
    if is_exact(t) {
        return Some(a.cmp(b));
    }
    Some(a.to_ascii_lowercase().cmp(b.to_ascii_lowercase()))
}

fn substr_match(v: Str, initial: ref Option[String], anys: Slice[String], fin: ref Option[String]) -> bool {
    let v = v.to_ascii_lowercase();
    let mut pos = 0;
    if let Some(i) = initial {
        let i = i.to_ascii_lowercase();
        if not v.starts_with(i) {
            return false;
        }
        pos = i.len();
    }
    for a in anys {
        let a = a.to_ascii_lowercase();
        match v[pos..].find(a) {
            Some(k) => pos += k + a.len(),
            None => return false,
        }
    }
    if let Some(f) = fin {
        let f = f.to_ascii_lowercase();
        if v.len() - pos < f.len() or not v.ends_with(f) {
            return false;
        }
    }
    true
}

fn visible(e: ref Entry, t: Str, admin: bool) -> Option[ref Vec[String]] {
    if is_exact(t) and not admin {
        return None;
    }
    e.get(t)
}

fn matches(e: ref Entry, f: ref Filter, admin: bool) -> bool {
    match f {
        Filter.And(fs) => fs.iter().all(|g| matches(e, g, admin)),
        Filter.Or(fs) => fs.iter().any(|g| matches(e, g, admin)),
        Filter.Not(g) => not matches(e, g, admin),
        Filter.Present(t) => visible(e, t, admin).is_some(),
        Filter.Substr(t, initial, anys, fin) => match visible(e, t, admin) {
            Some(vs) => vs.iter().any(|v| substr_match(v, initial, anys, fin)),
            None => false,
        },
        Filter.Eq(t, want) | Filter.Ge(t, want) | Filter.Le(t, want) => {
            let vs = match visible(e, t, admin) {
                Some(vs) => vs,
                None => return false,
            };
            for v in vs {
                let c = match value_cmp(t, v, want) {
                    Some(c) => c,
                    None => continue,
                };
                let hit = match f {
                    Filter.Eq { .. } => c == Ordering.Equal,
                    Filter.Ge { .. } => c != Ordering.Less,
                    _ => c != Ordering.Greater,
                };
                if hit {
                    return true;
                }
            }
            false
        }
    }
}

fn read_filter(r: mut ref Reader) -> Result[Filter, BerError] {
    let (tag, body) = r.read()?;
    let mut inner = Reader.new(body);
    match tag {
        0xa0 | 0xa1 => {
            let mut parts = Vec.new();
            while not inner.done() {
                parts.push(read_filter(mut inner)?);
            }
            if parts.is_empty() {
                return Err(BerError { value: "empty filter set".to_string() });
            }
            Ok(if tag == 0xa0 { Filter.And(parts) } else { Filter.Or(parts) })
        }
        0xa2 => {
            let f = read_filter(mut inner)?;
            if not inner.done() {
                return Err(BerError { value: "trailing bytes in not".to_string() });
            }
            Ok(Filter.Not(f))
        }
        0xa3 | 0xa5 | 0xa6 | 0xa8 => {
            let t = inner.text(0x04)?;
            let v = inner.text(0x04)?;
            Ok(match tag {
                0xa5 => Filter.Ge(t, v),
                0xa6 => Filter.Le(t, v),
                _ => Filter.Eq(t, v),
            })
        }
        0xa4 => {
            let t = inner.text(0x04)?;
            let mut subs = Reader.new(inner.expect(0x30)?);
            let mut initial: Option[String] = None;
            let mut anys: Vec[String] = Vec.new();
            let mut fin: Option[String] = None;
            while not subs.done() {
                let (st, sv) = subs.read()?;
                let sv = String.from_utf8(sv).map_err(|_| BerError { value: "not UTF-8".to_string() })?;
                if st == 0x80 and initial.is_none() and anys.is_empty() and fin.is_none() {
                    initial = Some(sv);
                } else if st == 0x81 and fin.is_none() {
                    anys.push(sv);
                } else if st == 0x82 and fin.is_none() {
                    fin = Some(sv);
                } else {
                    return Err(BerError { value: "bad substrings".to_string() });
                }
            }
            Ok(Filter.Substr(t, initial, anys, fin))
        }
        0x87 => Ok(Filter.Present(String.from_utf8_lossy(body).to_string())),
        _ => Err(BerError { value: f"unknown filter tag 0x{tag:02x}" }),
    }
}

// ---- operations

/// A result code, a matched DN and a diagnostic message.
type Outcome = (i64, String, String);

fn fail(code: i64, message: own String) -> Outcome {
    (code, String.new(), message)
}

fn ok() -> Outcome {
    (SUCCESS, String.new(), String.new())
}

fn result(tag: u8, o: ref Outcome) -> Vec[u8] {
    seq(tag, [enc_int(0x0a, o.0), enc_str(0x04, o.1), enc_str(0x04, o.2)])
}

fn entry_attrs(e: ref Entry, wanted: Slice[String], types_only: bool, admin: bool) -> Vec[Vec[u8]] {
    let mut out = Vec.new();
    let all_user = wanted.is_empty() or wanted.iter().any(|w| w == "*");
    let names: Vec[String] = wanted.iter().map(|w| w.to_ascii_lowercase()).collect();
    if names.len() > 0 and names.iter().all(|n| n == "1.1") {
        return out;
    }
    for (t, vs) in ref e.attrs {
        let lt = t.to_ascii_lowercase();
        if is_exact(lt) and not admin {
            continue;
        }
        if all_user or names.contains(lt) {
            let vals: Vec[Vec[u8]] = if types_only {
                Vec.new()
            } else {
                vs.iter().map(|v| enc_str(0x04, v)).collect()
            };
            out.push(seq(0x30, [enc_str(0x04, t), seq(0x31, vals)]));
        }
    }
    out
}

fn do_search(
    st: ref State,
    mid: i64,
    r: mut ref Reader,
    admin: bool,
    out: mut ref Vec[u8],
) -> Result[Outcome, BerError] {
    let base = r.text(0x04)?;
    let scope = r.int(0x0a)?;
    r.int(0x0a)?; // derefAliases
    let size_limit = r.int(0x02)?;
    r.int(0x02)?; // timeLimit
    let types_only = r.boolean()?;
    let f = read_filter(mut r)?;
    let mut list = Reader.new(r.expect(0x30)?);
    let mut wanted = Vec.new();
    while not list.done() {
        wanted.push(list.text(0x04)?);
    }
    if scope < 0 or scope > 2 {
        return Ok(fail(PROTOCOL_ERROR, "scope must be 0, 1 or 2".to_string()));
    }
    let rdns = match split_dn(base) {
        Some(rdns) => rdns,
        None => return Ok(fail(INVALID_DN_SYNTAX, f"invalid DN '{base}'")),
    };
    let nb = tree_key(rdns);
    if not st.entries.contains_key(nb) {
        return Ok((NO_SUCH_OBJECT, st.matched_dn(rdns), f"no entry {base}"));
    }
    let mut sent = 0;
    for (n, e) in ref st.entries {
        let inside = match scope {
            0 => *n == nb,
            1 => n.len() == nb.len() + 1 and n.starts_with(nb),
            _ => n.starts_with(nb),
        };
        if not inside or not matches(e, f, admin) {
            continue;
        }
        if size_limit > 0 and sent == size_limit {
            return Ok(fail(SIZE_LIMIT_EXCEEDED, f"more than {size_limit} entries"));
        }
        let body = seq(
            0x64,
            [enc_str(0x04, e.dn), seq(0x30, entry_attrs(e, wanted, types_only, admin))],
        );
        out.extend_from_slice(seq(0x30, [enc_int(0x02, mid), body]));
        sent += 1;
    }
    Ok(ok())
}

/// SEQUENCE OF SEQUENCE { type, SET OF value }.
fn read_attr_list(r: mut ref Reader) -> Result[Vec[(String, Vec[String])], BerError] {
    let mut out = Vec.new();
    let mut rr = Reader.new(r.expect(0x30)?);
    while not rr.done() {
        let mut one = Reader.new(rr.expect(0x30)?);
        let t = one.text(0x04)?;
        let mut vals = Reader.new(one.expect(0x31)?);
        let mut vs = Vec.new();
        while not vals.done() {
            vs.push(vals.text(0x04)?);
        }
        out.push((t, vs));
    }
    Ok(out)
}

fn has_value(t: Str, vs: Slice[String], v: Str) -> bool {
    vs.iter().any(|x| value_cmp(t, x, v) == Some(Ordering.Equal))
}

fn do_add(st: mut ref State, r: mut ref Reader, admin: bool) -> Result[Outcome, BerError] {
    let dn = r.text(0x04)?;
    let attrs = read_attr_list(mut r)?;
    if not admin {
        return Ok(fail(INSUFFICIENT_ACCESS, "add needs the admin bind".to_string()));
    }
    let rdns = match split_dn(dn) {
        Some(rdns) if not rdns.is_empty() => rdns,
        _ => return Ok(fail(INVALID_DN_SYNTAX, f"invalid DN '{dn}'")),
    };
    let key = tree_key(rdns);
    if st.entries.contains_key(key) {
        return Ok(fail(ENTRY_ALREADY_EXISTS, f"{dn} already exists"));
    }
    if not st.entries.contains_key(parent_of(key)) {
        return Ok((NO_SUCH_OBJECT, st.matched_dn(rdns), f"no parent for {dn}"));
    }
    let e = Entry { dn: dn.clone(), attrs };
    if e.get("objectClass").map_or(true, |v| v.is_empty()) {
        return Ok(fail(OBJECT_CLASS_VIOLATION, "an entry needs an objectClass".to_string()));
    }
    let (t, v) = ref rdns[0];
    let naming = unescape(v);
    let vs = e.get(t).cloned().unwrap_or_default();
    if not has_value(t, vs, naming) {
        return Ok(fail(NAMING_VIOLATION, f"the entry has no {t} value {naming}"));
    }
    st.entries.insert(key, e);
    Ok(ok())
}

fn do_delete(st: mut ref State, body: Slice[u8], admin: bool) -> Result[Outcome, BerError] {
    let dn = String.from_utf8(body.to_vec()).map_err(|_| BerError { value: "not UTF-8".to_string() })?;
    if not admin {
        return Ok(fail(INSUFFICIENT_ACCESS, "delete needs the admin bind".to_string()));
    }
    let rdns = match split_dn(dn) {
        Some(rdns) if not rdns.is_empty() => rdns,
        _ => return Ok(fail(INVALID_DN_SYNTAX, f"invalid DN '{dn}'")),
    };
    let key = tree_key(rdns);
    if not st.entries.contains_key(key) {
        return Ok((NO_SUCH_OBJECT, st.matched_dn(rdns), f"no entry {dn}"));
    }
    if st.entries.keys().any(|m| not m.is_empty() and parent_of(m) == key) {
        return Ok(fail(NOT_ALLOWED_ON_NON_LEAF, f"{dn} has children"));
    }
    st.entries.remove(key);
    Ok(ok())
}

fn do_modify(st: mut ref State, r: mut ref Reader, admin: bool, bound: Slice[String]) -> Result[Outcome, BerError] {
    let dn = r.text(0x04)?;
    let mut changes: Vec[(i64, String, Vec[String])] = Vec.new();
    let mut rr = Reader.new(r.expect(0x30)?);
    while not rr.done() {
        let mut one = Reader.new(rr.expect(0x30)?);
        let op = one.int(0x0a)?;
        let mut m = Reader.new(one.expect(0x30)?);
        let t = m.text(0x04)?;
        let mut vals = Reader.new(m.expect(0x31)?);
        let mut vs = Vec.new();
        while not vals.done() {
            vs.push(vals.text(0x04)?);
        }
        if op < 0 or op > 2 {
            return Ok(fail(PROTOCOL_ERROR, f"unknown modify operation {op}"));
        }
        changes.push((op, t, vs));
    }
    let rdns = match split_dn(dn) {
        Some(rdns) if not rdns.is_empty() => rdns,
        _ => return Ok(fail(INVALID_DN_SYNTAX, f"invalid DN '{dn}'")),
    };
    let key = tree_key(rdns);
    if not st.entries.contains_key(key) {
        return Ok((NO_SUCH_OBJECT, st.matched_dn(rdns), f"no entry {dn}"));
    }
    let self_mail = bound == key.as_slice() and changes.iter().all(|(_, t, _)| t.eq_ignore_ascii_case("mail"));
    if not admin and not self_mail {
        return Ok(fail(
            INSUFFICIENT_ACCESS,
            "only the admin, or a user changing their own mail".to_string(),
        ));
    }
    let mut attrs = st.entries[key].attrs.clone();
    for (op, t, vs) in ref changes {
        let at = attrs.iter().position(|(x, _)| x.eq_ignore_ascii_case(t));
        match op {
            0 => {
                let at = match at {
                    Some(at) => at,
                    None => {
                        attrs.push((t.clone(), vs.clone()));
                        continue;
                    }
                };
                for v in vs {
                    if has_value(t, attrs[at].1, v) {
                        return Ok(fail(ATTRIBUTE_OR_VALUE_EXISTS, f"{t} already has {v}"));
                    }
                    attrs[at].1.push(v.clone());
                }
            }
            1 => {
                let at = match at {
                    Some(at) => at,
                    None => return Ok(fail(NO_SUCH_ATTRIBUTE, f"no {t} to delete")),
                };
                if vs.is_empty() {
                    attrs.remove(at);
                    continue;
                }
                for v in vs {
                    let k = attrs[at]
                        .1
                        .iter()
                        .position(|x| value_cmp(t, x, v) == Some(Ordering.Equal));
                    match k {
                        Some(k) => {
                            attrs[at].1.remove(k);
                        }
                        None => return Ok(fail(NO_SUCH_ATTRIBUTE, f"{t} has no value {v}")),
                    }
                }
                if attrs[at].1.is_empty() {
                    attrs.remove(at);
                }
            }
            _ => match at {
                None => {
                    if not vs.is_empty() {
                        attrs.push((t.clone(), vs.clone()));
                    }
                }
                Some(at) => {
                    if vs.is_empty() {
                        attrs.remove(at);
                    } else {
                        attrs[at].1 = vs.clone();
                    }
                }
            },
        }
    }
    if not attrs.iter().any(|(t, _)| t.eq_ignore_ascii_case("objectClass")) {
        return Ok(fail(OBJECT_CLASS_VIOLATION, "an entry needs an objectClass".to_string()));
    }
    let (rt, rv) = ref rdns[0];
    let naming = unescape(rv);
    let rvs = attrs
        .iter()
        .find(|(t, _)| t.eq_ignore_ascii_case(rt))
        .map(|(_, vs)| vs.clone())
        .unwrap_or_default();
    if not has_value(rt, rvs, naming) {
        return Ok(fail(NAMING_VIOLATION, f"the change removes the naming value {naming}"));
    }
    st.entries.get_mut(key).unwrap().attrs = attrs;
    Ok(ok())
}

fn do_compare(st: ref State, r: mut ref Reader, admin: bool) -> Result[Outcome, BerError] {
    let dn = r.text(0x04)?;
    let mut ava = Reader.new(r.expect(0x30)?);
    let t = ava.text(0x04)?;
    let v = ava.text(0x04)?;
    let rdns = match split_dn(dn) {
        Some(rdns) => rdns,
        None => return Ok(fail(INVALID_DN_SYNTAX, f"invalid DN '{dn}'")),
    };
    let key = tree_key(rdns);
    let e = match st.entries.get(key) {
        Some(e) => e,
        None => return Ok((NO_SUCH_OBJECT, st.matched_dn(rdns), f"no entry {dn}")),
    };
    match visible(e, t, admin) {
        None => Ok(fail(NO_SUCH_ATTRIBUTE, f"no {t}")),
        Some(vs) if has_value(t, vs, v) => Ok(fail(COMPARE_TRUE, String.new())),
        Some(_) => Ok(fail(COMPARE_FALSE, String.new())),
    }
}

/// The bind's outcome, and who is bound after it (None: anonymous).
fn do_bind(st: ref State, r: mut ref Reader) -> Result[(Outcome, Option[Vec[String]]), BerError] {
    let version = r.int(0x02)?;
    let name = r.text(0x04)?;
    let (tag, cred) = r.read()?;
    if version != 3 {
        return Ok((fail(PROTOCOL_ERROR, f"version {version} is not supported"), None));
    }
    if tag != 0x80 {
        return Ok((fail(AUTH_METHOD_NOT_SUPPORTED, "only simple binds".to_string()), None));
    }
    let password = String.from_utf8_lossy(cred).to_string();
    if name.is_empty() and password.is_empty() {
        return Ok((ok(), None));
    }
    let rdns = match split_dn(name) {
        Some(rdns) => rdns,
        None => return Ok((fail(INVALID_DN_SYNTAX, f"invalid DN '{name}'"), None)),
    };
    let key = tree_key(rdns);
    let known = match st.entries.get(key).and_then(|e| e.get("userPassword")) {
        Some(pw) => pw.contains(password),
        None => false,
    };
    if not known {
        return Ok((fail(INVALID_CREDENTIALS, String.new()), None));
    }
    Ok((ok(), Some(key)))
}

/// One whole message off the stream: its tag, its length and its content.
/// None at a clean close.
fn read_message(r: mut ref BufReader[TcpStream]) -> Result[Option[Vec[u8]], BerError] {
    let mut head = [0u8; 2];
    match r.read(mut head[..1]) {
        Ok(0) => return Ok(None),
        Ok(_) => {}
        Err(_) => return Ok(None),
    }
    r.read_exact(mut head[1..2]).map_err(|_| BerError { value: "truncated".to_string() })?;
    let mut data = head.to_vec();
    let first = head[1];
    let n = if first >= 0x80 {
        let k = (first & 0x7f) as i64;
        if k == 0 or k > 3 {
            return Err(BerError { value: "bad length".to_string() });
        }
        let mut more = Vec.filled(k, 0u8);
        r.read_exact(mut more).map_err(|_| BerError { value: "truncated".to_string() })?;
        data.extend_from_slice(more);
        more.iter().fold(0, |n, b| n * 256 + *b)
    } else {
        first as i64
    };
    if n > MAX_MESSAGE {
        return Err(BerError { value: "message too large".to_string() });
    }
    let mut body = Vec.filled(n, 0u8);
    r.read_exact(mut body).map_err(|_| BerError { value: "truncated".to_string() })?;
    data.extend_from_slice(body);
    Ok(Some(data))
}

fn parse_message(raw: Slice[u8]) -> Result[(i64, u8, Vec[u8]), BerError] {
    let mut outer = Reader.new(raw);
    let mut msg = Reader.new(outer.expect(0x30)?);
    let mid = msg.int(0x02)?;
    let (tag, body) = msg.read()?;
    Ok((mid, tag, body))
}

fn response_tag(op: u8) -> u8 {
    match op {
        0x60 => 0x61,
        0x63 => 0x65,
        0x68 => 0x69,
        0x4a => 0x6b,
        0x66 => 0x67,
        0x6e => 0x6f,
        _ => 0x78,
    }
}

fn handle(st: mut ref State, mid: i64, tag: u8, body: Slice[u8], bound: mut ref Option[Vec[String]], out: mut ref Vec[u8]) -> Result[Outcome, BerError] {
    let admin_key = tree_key(split_dn(ADMIN).unwrap());
    let admin = bound.as_ref() == Some(ref admin_key);
    let mut r = Reader.new(body);
    match tag {
        0x60 => {
            st.count_op("bind");
            let (o, who) = do_bind(st, mut r)?;
            *bound = who;
            Ok(o)
        }
        0x63 => {
            st.count_op("search");
            do_search(st, mid, mut r, admin, mut out)
        }
        0x68 => {
            st.count_op("add");
            do_add(mut st, mut r, admin)
        }
        0x4a => {
            st.count_op("delete");
            do_delete(mut st, body, admin)
        }
        0x66 => {
            st.count_op("modify");
            let me = bound.clone().unwrap_or_default();
            do_modify(mut st, mut r, admin, me)
        }
        0x6e => {
            st.count_op("compare");
            do_compare(st, mut r, admin)
        }
        _ => {
            st.count_op("unknown");
            Ok(fail(PROTOCOL_ERROR, f"unsupported operation 0x{tag:02x}"))
        }
    }
}

fn serve(state: Mutex[State], conn: own TcpStream) {
    let w = conn.try_clone().unwrap();
    let mut r = BufReader.new(conn);
    let mut bound: Option[Vec[String]] = None;
    loop {
        let parsed = read_message(mut r).and_then(|raw| match raw {
            Some(raw) => parse_message(raw).map(|a0| Some(a0)),
            None => Ok(None),
        });
        let (mid, tag, body) = match parsed {
            Ok(Some(m)) => m,
            Ok(None) => break,
            Err(BerError { value: why }) => {
                let notice = seq(
                    0x78,
                    [
                        enc_int(0x0a, PROTOCOL_ERROR),
                        enc_str(0x04, ""),
                        enc_str(0x04, f"malformed message: {why}"),
                        enc_str(0x8a, NOTICE_OID),
                    ],
                );
                let _ = w.write_all(seq(0x30, [enc_int(0x02, 0), notice]));
                state.lock().value.count_op("malformed");
                break;
            }
        };
        if tag == 0x42 {
            state.lock().value.count_op("unbind");
            break;
        }
        let mut out = Vec.new();
        {
            let mut st = state.lock();
            let o = match handle(mut st.value, mid, tag, body, mut bound, mut out) {
                Ok(o) => o,
                Err(BerError { value: why }) => fail(PROTOCOL_ERROR, f"bad request: {why}"),
            };
            *st.value.results.entry(o.0).or_insert(0) += 1;
            out.extend_from_slice(seq(0x30, [enc_int(0x02, mid), result(response_tag(tag), o)]));
        }
        if w.write_all(out).is_err() {
            break;
        }
    }
}

fn run_server(state: Mutex[State], listener: TcpListener) {
    let group = TaskGroup.new();
    for _ in 0..SESSIONS {
        let conn = listener.accept().unwrap();
        let st = ref state;
        group.spawn(|| serve(st, conn));
    }
}

// ---- the clients: RFC 4515 filter strings to BER

fn unescape_filter(v: Str) -> Result[String, String] {
    let b = v.bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        if b[i] == b'\\' {
            if i + 2 >= b.len() {
                return Err("bad escape".to_string());
            }
            let hex = String.from_utf8(b[i + 1..i + 3]).map_err(|_| "bad escape".to_string())?;
            out.push(u8.from_str_radix(hex, 16).ok_or_else(|| "bad escape".to_string())?);
            i += 3;
        } else {
            out.push(b[i]);
            i += 1;
        }
    }
    String.from_utf8(out).map_err(|_| "not UTF-8".to_string())
}

fn parse_filter(s: Str, i: i64) -> Result[(Vec[u8], i64), String] {
    let b = s.bytes();
    if i >= b.len() or b[i] != b'(' {
        return Err(f"expected '(' at {i}");
    }
    let mut i = i + 1;
    if b[i] == b'&' or b[i] == b'|' {
        let tag = if b[i] == b'&' { 0xa0 } else { 0xa1 };
        i += 1;
        let mut parts = Vec.new();
        while i < b.len() and b[i] == b'(' {
            let (p, next) = parse_filter(s, i)?;
            parts.push(p);
            i = next;
        }
        if i >= b.len() or b[i] != b')' {
            return Err(f"expected ')' at {i}");
        }
        return Ok((seq(tag, parts), i + 1));
    }
    if b[i] == b'!' {
        let (p, next) = parse_filter(s, i + 1)?;
        if next >= b.len() or b[next] != b')' {
            return Err(f"expected ')' at {next}");
        }
        return Ok((seq(0xa2, [p]), next + 1));
    }
    let end = match s[i..].find(")") {
        Some(k) => i + k,
        None => return Err("unclosed filter".to_string()),
    };
    let item = s[i..end];
    for (op, tag) in [(">=", 0xa5u8), ("<=", 0xa6), ("~=", 0xa8)] {
        if let Some(k) = item.find(op) {
            if k > 0 {
                let v = unescape_filter(item[k + 2..])?;
                return Ok((seq(tag, [enc_str(0x04, item[..k]), enc_str(0x04, v)]), end + 1));
            }
        }
    }
    let k = match item.find("=") {
        Some(k) if k > 0 => k,
        _ => return Err(f"no '=' in '{item}'"),
    };
    let (t, v) = (item[..k], item[k + 1..]);
    if v == "*" {
        return Ok((enc_str(0x87, t), end + 1));
    }
    if v.contains("*") {
        let pieces: Vec[Str] = v.split("*").collect();
        let mut subs = Vec.new();
        if not pieces[0].is_empty() {
            subs.push(enc_str(0x80, unescape_filter(pieces[0])?));
        }
        for p in pieces[1..pieces.len() - 1] {
            if not p.is_empty() {
                subs.push(enc_str(0x81, unescape_filter(p)?));
            }
        }
        let last = pieces[pieces.len() - 1];
        if not last.is_empty() {
            subs.push(enc_str(0x82, unescape_filter(last)?));
        }
        return Ok((seq(0xa4, [enc_str(0x04, t), seq(0x30, subs)]), end + 1));
    }
    let v = unescape_filter(v)?;
    Ok((seq(0xa3, [enc_str(0x04, t), enc_str(0x04, v)]), end + 1))
}

fn filter_ber(s: Str) -> Vec[u8] {
    let (f, rest) = parse_filter(s, 0).unwrap();
    assert_eq(rest, s.len(), f"trailing text in filter '{s}'");
    f
}

struct Client {
    name: String,
    sock: TcpStream,
    r: BufReader[TcpStream],
    next_id: i64,
}

/// A received message: its id, its operation tag and the operation's body.
type Received = Option[(i64, u8, Vec[u8])];

impl Client {
    fn connect(name: Str) -> Client {
        let sock = TcpStream.connect(ADDR).unwrap();
        sock.set_read_timeout(Some(2 * 1000)).unwrap();
        let r = BufReader.new(sock.try_clone().unwrap());
        Client { name: name.to_string(), sock, r, next_id: 1 }
    }

    fn say(self, line: Str) {
        println(f"{self.name} {line}");
    }

    fn send(mut ref self, op: own Vec[u8]) -> i64 {
        let mid = self.next_id;
        self.next_id += 1;
        self.sock.write_all(seq(0x30, [enc_int(0x02, mid), op])).unwrap();
        mid
    }

    fn recv(mut ref self) -> Received {
        match read_message(mut self.r) {
            Ok(Some(raw)) => parse_message(raw).ok(),
            Ok(None) => None,
            Err(BerError { value: why }) => {
                self.say(f"<- bad message: {why}");
                None
            }
        }
    }

    fn result_line(self, mid: i64, got: ref Received) -> String {
        let (rid, tag, body) = match got {
            Some(g) => g,
            None => return "(closed)".to_string(),
        };
        let mut r = Reader.new(body);
        let code = r.int(0x0a).unwrap();
        let matched = r.text(0x04).unwrap();
        let text = r.text(0x04).unwrap();
        let mut out = result_name(code);
        if rid != mid {
            out += f" (for message {rid}, sent {mid})";
        }
        if not matched.is_empty() {
            out += f" matched={matched}";
        }
        if not text.is_empty() {
            out += f": {text}";
        }
        if tag == 0x78 and not r.done() {
            out += f" [{r.text(0x8a).unwrap()}]";
        }
        out
    }

    fn bind(mut ref self, dn: Str, password: Str, version: i64) {
        let op = seq(0x60, [enc_int(0x02, version), enc_str(0x04, dn), enc_str(0x80, password)]);
        let mid = self.send(op);
        let got = self.recv();
        let who = if dn.is_empty() { "anonymous" } else { dn };
        self.say(f"bind {who} -> {self.result_line(mid, got)}");
    }

    fn search(mut ref self, base: Str, scope: Str, flt: Str, attrs: Slice[Str], size_limit: i64, types_only: bool) {
        let scope_n = match scope {
            "base" => 0,
            "one" => 1,
            _ => 2,
        };
        let op = seq(
            0x63,
            [
                enc_str(0x04, base),
                enc_int(0x0a, scope_n),
                enc_int(0x0a, 0),
                enc_int(0x02, size_limit),
                enc_int(0x02, 0),
                tlv(0x01, if types_only { [0xff] } else { [0x00] }),
                filter_ber(flt),
                seq(0x30, attrs.iter().map(|a| enc_str(0x04, a)).collect()),
            ],
        );
        let mid = self.send(op);
        let mut entries: Vec[String] = Vec.new();
        let got = loop {
            let got = self.recv();
            let body = match ref got {
                Some((_, 0x64, body)) => body.clone(),
                _ => break got,
            };
            let mut r = Reader.new(body);
            let dn = r.text(0x04).unwrap();
            let mut list = Reader.new(r.expect(0x30).unwrap());
            let mut shown = Vec.new();
            while not list.done() {
                let mut one = Reader.new(list.expect(0x30).unwrap());
                let t = one.text(0x04).unwrap();
                let mut vals = Reader.new(one.expect(0x31).unwrap());
                let mut vs = Vec.new();
                while not vals.done() {
                    vs.push(vals.text(0x04).unwrap());
                }
                if vs.is_empty() {
                    shown.push(t);
                } else {
                    shown.push(f"{t}={vs.join("|")}");
                }
            }
            if shown.is_empty() {
                entries.push(f"  {dn}");
            } else {
                entries.push(f"  {dn}: {shown.join("; ")}");
            }
        };
        let mut what = f"search {scope} {if base.is_empty() { "(root)" } else { base }} {flt}";
        if not attrs.is_empty() {
            what += f" [{attrs.join(",")}]";
        }
        if size_limit > 0 {
            what += f" limit {size_limit}";
        }
        self.say(f"{what} -> {entries.len()} entries, {self.result_line(mid, got)}");
        for line in ref entries {
            println(f"{line}");
        }
    }

    fn add(mut ref self, dn: Str, attrs: Slice[(Str, Slice[Str])]) {
        let list = attrs
            .iter()
            .map(|(t, vs)| {
                seq(0x30, [enc_str(0x04, t), seq(0x31, vs.iter().map(|v| enc_str(0x04, v)).collect())])
            })
            .collect();
        let mid = self.send(seq(0x68, [enc_str(0x04, dn), seq(0x30, list)]));
        let got = self.recv();
        self.say(f"add {dn} -> {self.result_line(mid, got)}");
    }

    fn delete(mut ref self, dn: Str) {
        let mid = self.send(enc_str(0x4a, dn));
        let got = self.recv();
        self.say(f"delete {dn} -> {self.result_line(mid, got)}");
    }

    fn modify(mut ref self, dn: Str, changes: Slice[(Str, Str, Slice[Str])]) {
        let mut list = Vec.new();
        let mut what = Vec.new();
        for (o, t, vs) in changes {
            let code = match o {
                "add" => 0,
                "delete" => 1,
                _ => 2,
            };
            let vals = vs.iter().map(|v| enc_str(0x04, v)).collect();
            list.push(seq(0x30, [enc_int(0x0a, code), seq(0x30, [enc_str(0x04, t), seq(0x31, vals)])]));
            if vs.is_empty() {
                what.push(f"{o} {t}");
            } else {
                what.push(f"{o} {t} {vs.join("|")}");
            }
        }
        let mid = self.send(seq(0x66, [enc_str(0x04, dn), seq(0x30, list)]));
        let got = self.recv();
        self.say(f"modify {dn} ({what.join(", ")}) -> {self.result_line(mid, got)}");
    }

    fn compare(mut ref self, dn: Str, t: Str, v: Str) {
        let op = seq(0x6e, [enc_str(0x04, dn), seq(0x30, [enc_str(0x04, t), enc_str(0x04, v)])]);
        let mid = self.send(op);
        let got = self.recv();
        self.say(f"compare {dn} {t}={v} -> {self.result_line(mid, got)}");
    }

    fn raw(mut ref self, label: Str, data: Slice[u8]) {
        self.sock.write_all(data).unwrap();
        let got = self.recv();
        self.say(f"{label} -> {self.result_line(0, got)}");
        let after = self.recv();
        self.say(f"then -> {if after.is_none() { "(closed)" } else { "more" }}");
    }

    fn unbind(mut ref self) {
        self.send(tlv(0x42, []));
        let got = self.recv();
        self.say(f"unbind -> {if got.is_none() { "(closed)" } else { "more" }}");
    }
}

fn main() {
    let listener = TcpListener.bind(ADDR).unwrap();
    let state = Mutex.new(State.new());
    let group = TaskGroup.new();
    let st = ref state;
    group.spawn(|| run_server(st, listener));

    let people = f"ou=people,{BASE}";
    let alice_dn = f"uid=alice,{people}";
    let bob_dn = f"uid=bob,{people}";
    let carol_dn = f"uid=carol,{people}";
    let dave_dn = f"uid=dave,{people}";

    println("== anonymous reads");
    let mut anon = Client.connect("anon");
    anon.bind("", "", 3);
    anon.search(BASE, "one", "(objectClass=*)", ["ou"], 0, false);
    anon.search(BASE, "sub", "(&(objectClass=person)(uidNumber>=1002))", ["cn", "uidNumber"], 0, false);
    anon.search(people, "one", "(|(cn=*liddell)(sn=Dan*)(mail=*@kara.test))", ["uid"], 0, false);
    anon.search(people, "sub", "(cn=b*b*r)", ["cn"], 0, false);
    anon.search(BASE, "sub", "(!(objectClass=posixAccount))", ["1.1"], 0, false);
    anon.search(BASE, "sub", "(cn=Smith\\2c John)", ["cn", "mail"], 0, false);
    anon.search(f"CN=smith\\, john,OU=People,{BASE}", "base", "(objectClass=*)", ["sn"], 0, false);
    anon.search(bob_dn, "base", "(objectClass=*)", [], 0, false);
    anon.search(BASE, "sub", "(userPassword=*)", ["uid"], 0, false);
    anon.search(BASE, "sub", "(uidNumber<=1001)", ["uid"], 0, true);
    anon.search(people, "one", "(objectClass=person)", ["uid"], 2, false);
    anon.search(f"ou=robots,{BASE}", "sub", "(objectClass=*)", [], 0, false);
    anon.search("not a dn", "sub", "(objectClass=*)", [], 0, false);
    anon.compare(alice_dn, "mail", "ALICE@KARA.TEST");
    anon.compare(alice_dn, "uidNumber", "1002");
    anon.compare(alice_dn, "userPassword", "not-a-real-secret/alice");
    anon.compare(f"uid=zed,{people}", "cn", "Zed");
    anon.add(f"uid=mallory,{people}", [("objectClass", ["person"]), ("uid", ["mallory"])]);
    anon.unbind();

    println("== alice");
    let mut alice = Client.connect("alice");
    alice.bind(alice_dn, "wrong", 3);
    alice.bind(f"uid=nobody,{people}", "x", 3);
    alice.bind(alice_dn, "not-a-real-secret/alice", 3);
    alice.modify(alice_dn, [("add", "mail", ["liddell@kara.test"])]);
    alice.modify(alice_dn, [("add", "mail", ["Alice@Kara.Test"])]);
    alice.modify(alice_dn, [("replace", "cn", ["Alice"])]);
    alice.modify(bob_dn, [("delete", "mail", ["bob@kara.test"])]);
    alice.search(alice_dn, "base", "(objectClass=*)", ["mail"], 0, false);
    alice.delete(carol_dn);
    alice.unbind();

    println("== admin");
    let mut admin = Client.connect("admin");
    admin.bind(ADMIN, ADMIN_PASSWORD, 3);
    admin.add(
        dave_dn,
        [
            ("objectClass", ["person", "posixAccount"]),
            ("uid", ["dave"]),
            ("cn", ["Dave Lister"]),
            ("sn", ["Lister"]),
            ("uidNumber", ["1003"]),
            ("userPassword", ["not-a-real-secret/dave"]),
        ],
    );
    admin.add(dave_dn, [("objectClass", ["person"]), ("uid", ["dave"])]);
    admin.add(f"uid=eve,ou=robots,{BASE}", [("objectClass", ["person"]), ("uid", ["eve"])]);
    admin.add(f"uid=eve,{people}", [("uid", ["eve"])]);
    admin.add(f"uid=eve,{people}", [("objectClass", ["person"]), ("cn", ["Eve"])]);
    admin.add(f"uid eve,{people}", [("objectClass", ["person"])]);
    admin.modify(
        bob_dn,
        [
            ("delete", "mail", ["BOB@kara.test"]),
            ("replace", "uidNumber", ["2002"]),
            ("add", "description", ["builds things", "fixes things"]),
        ],
    );
    admin.modify(bob_dn, [("delete", "mail", ["nobody@kara.test"]), ("replace", "sn", ["Gone"])]);
    admin.modify(bob_dn, [("delete", "telephoneNumber", [])]);
    admin.modify(bob_dn, [("delete", "uid", [])]);
    admin.modify(bob_dn, [("replace", "objectClass", [])]);
    admin.modify(bob_dn, [("delete", "description", [])]);
    admin.search(bob_dn, "base", "(objectClass=*)", [], 0, false);
    admin.search(BASE, "sub", "(uidNumber>=1003)", ["uid", "uidNumber", "userPassword"], 0, false);
    admin.compare(dave_dn, "userPassword", "not-a-real-secret/dave");
    admin.compare(dave_dn, "userPassword", "NOT-A-REAL-SECRET/DAVE");
    admin.delete(people);
    admin.delete(carol_dn);
    admin.delete(carol_dn);
    admin.delete(f"cn=Smith\\, John,{people}");
    admin.unbind();

    println("== old client");
    let mut old = Client.connect("old");
    old.bind(alice_dn, "not-a-real-secret/alice", 2);
    drop(old);

    println("== broken client");
    let mut bad = Client.connect("broken");
    bad.raw("indefinite length", [0x30, 0x80, 0x02, 0x01, 0x01, 0x00, 0x00]);
    drop(bad);

    println("== final tree");
    let mut last = Client.connect("anon");
    last.search(BASE, "sub", "(objectClass=*)", ["1.1"], 0, false);
    last.unbind();
    drop(last);

    drop(group);
    let st = state.lock();
    println(f"== server: {st.value.entries.len()} entries");
    let ops: Vec[String] = st.value.ops.iter().map(|(k, v)| f"{k}={v}").collect();
    println(f"ops {ops.join(" ")}");
    let results: Vec[String] = st.value.results.iter().map(|(k, v)| f"{k}={v}").collect();
    println(f"results {results.join(" ")}");
}
