fn data_part_2(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("role server\n");
    t.push_str("recv GET / HTTP/1.1\\r\\nHost: x\\r\\n\\r\\n\n");
    t.push_str("response 200 1.1 OK | Content-Length: 1\n");
    t.push_str("data too long\n");
    t.push_str("data x\n");
    t.push_str("eom\n");
    t.push_str("recv more\n");
    v.push(DataFile { path: "scripts/snd-11-after-error.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("role client\n");
    t.push_str("request GET / 1.1 | Host: x\n");
    t.push_str("failed\n");
    t.push_str("eom\n");
    t.push_str("recv HTTP/1.1 200 OK\\r\\n\\r\\n\n");
    v.push(DataFile { path: "scripts/snd-12-send-failed.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("# The Host header goes first on the wire, whatever order it was given in.\n");
    t.push_str("role client\n");
    t.push_str("request OPTIONS * 1.1 | User-Agent: probe/1.0 | Accept: */* | HOST: Example.COM:8080\n");
    t.push_str("eom\n");
    v.push(DataFile { path: "scripts/snd-13-host-first.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("# A plain GET, answered with a body, then a second request on the same connection.\n");
    t.push_str("role server\n");
    t.push_str("recv GET /index.html HTTP/1.1\\r\\nHost: www.example.com\\r\\nAccept: text/html\\r\\n\\r\\n\n");
    t.push_str("response 200 1.1 OK | Content-Type: text/html; charset=utf-8 | Content-Length: 13\n");
    t.push_str("data <h1>Hi</h1>\\n\n");
    t.push_str("data .\n");
    t.push_str("eom\n");
    t.push_str("cycle\n");
    t.push_str("recv GET /favicon.ico HTTP/1.1\\r\\nHost: www.example.com\\r\\n\\r\\n\n");
    t.push_str("response 404 1.1 Not Found | Content-Length: 0\n");
    t.push_str("eom\n");
    t.push_str("cycle\n");
    v.push(DataFile { path: "scripts/srv-01-get-keepalive.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("# curl's request arriving one byte at a time, then answered with JSON.\n");
    t.push_str("role server\n");
    t.push_str("recvfile captures/curl-get.bin 40\n");
    t.push_str("response 200 1.1 OK | Content-Type: application/json | Content-Length: 2\n");
    t.push_str("data []\n");
    t.push_str("eom\n");
    v.push(DataFile { path: "scripts/srv-02-curl-bytewise.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("role server\n");
    t.push_str("recvfile captures/browser-post.bin 97\n");
    t.push_str("response 303 1.1 See Other | Location: /cart | Set-Cookie: session=7c1f; HttpOnly; Secure | Content-Length: 0\n");
    t.push_str("eom\n");
    t.push_str("cycle\n");
    v.push(DataFile { path: "scripts/srv-03-browser-post.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("# A chunked PUT that waits for 100 Continue, with chunk sizes in mixed case.\n");
    t.push_str("role server\n");
    t.push_str("recvfile captures/upload-head.bin 64\n");
    t.push_str("info 100 1.1 Continue\n");
    t.push_str("recvfile captures/upload-body.bin 16\n");
    t.push_str("response 201 1.1 Created | Location: /uploads/report.csv\n");
    t.push_str("data stored\\n\n");
    t.push_str("eom\n");
    t.push_str("cycle\n");
    v.push(DataFile { path: "scripts/srv-04-chunked-upload.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("# Three requests in one read: h11 hands over one and pauses on the rest.\n");
    t.push_str("role server\n");
    t.push_str("recvfile captures/pipelined.bin 4096\n");
    t.push_str("response 200 1.1 OK | Content-Length: 4\n");
    t.push_str("data a{}\\n\n");
    t.push_str("eom\n");
    t.push_str("cycle\n");
    t.push_str("drain\n");
    t.push_str("response 200 1.1 OK | Content-Length: 3\n");
    t.push_str("data ;\\n\\n\n");
    t.push_str("eom\n");
    t.push_str("cycle\n");
    t.push_str("drain\n");
    t.push_str("response 200 1.1 OK | Content-Type: image/png\n");
    t.push_str("data \\x89PNG\n");
    t.push_str("eom\n");
    t.push_str("next\n");
    t.push_str("eof\n");
    v.push(DataFile { path: "scripts/srv-05-pipelined.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("# An HTTP/1.0 client: no Host needed, and a response without a length is closed.\n");
    t.push_str("role server\n");
    t.push_str("recv GET / HTTP/1.0\\r\\n\\r\\n\n");
    t.push_str("response 200 1.1 OK | Content-Type: text/plain | Content-Length: 5\n");
    t.push_str("data hello\n");
    t.push_str("eom\n");
    t.push_str("cycle\n");
    v.push(DataFile { path: "scripts/srv-06-http10-client.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("role server\n");
    t.push_str("recv GET /stream HTTP/1.0\\r\\nUser-Agent: Wget/1.21\\r\\n\\r\\n\n");
    t.push_str("response 200 1.1 OK | Content-Type: text/event-stream | Transfer-Encoding: chunked\n");
    t.push_str("data event: tick\\n\\n\n");
    t.push_str("data event: tick\\n\\n\n");
    t.push_str("eom\n");
    t.push_str("close\n");
    v.push(DataFile { path: "scripts/srv-07-http10-unframed.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("# A 1.1 client and a streamed reply: h11 adds Transfer-Encoding and drops Content-Length.\n");
    t.push_str("role server\n");
    t.push_str("recv GET /events HTTP/1.1\\r\\nHost: feed.example\\r\\nConnection: Keep-Alive\\r\\n\\r\\n\n");
    t.push_str("response 200 1.1 OK | Cache-Control: no-cache\n");
    t.push_str("data id: 1\\ndata: first\\n\\n\n");
    t.push_str("data\n");
    t.push_str("data id: 2\\ndata: second\\n\\n\n");
    t.push_str("eom | X-Stream-End: clean | Server-Timing: total;dur=12\n");
    t.push_str("cycle\n");
    v.push(DataFile { path: "scripts/srv-08-chunked-response.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("role server\n");
    t.push_str("recv DELETE /items/42 HTTP/1.1\\r\\nHost: api\\r\\nConnection: Close, TE\\r\\n\\r\\n\n");
    t.push_str("response 204 1.1 No Content | Connection: keep-alive\n");
    t.push_str("eom\n");
    t.push_str("cycle\n");
    t.push_str("recv GET / HTTP/1.1\\r\\nHost: api\\r\\n\\r\\n\n");
    t.push_str("eof\n");
    t.push_str("close\n");
    v.push(DataFile { path: "scripts/srv-09-connection-close.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("# HEAD: the response keeps its Content-Length and sends no body.\n");
    t.push_str("role server\n");
    t.push_str("recv HEAD /big.iso HTTP/1.1\\r\\nHost: mirror.example\\r\\n\\r\\n\n");
    t.push_str("response 200 1.1 OK | Content-Length: 4700000000 | Accept-Ranges: bytes\n");
    t.push_str("data x\n");
    t.push_str("eom\n");
    v.push(DataFile { path: "scripts/srv-10-head.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("role server\n");
    t.push_str("recv HEAD /live HTTP/1.1\\r\\nHost: tv\\r\\n\\r\\n\n");
    t.push_str("response 200 1.1 OK | Content-Type: video/mp2t\n");
    t.push_str("eom\n");
    t.push_str("cycle\n");
    v.push(DataFile { path: "scripts/srv-11-head-unframed.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("# An Upgrade to WebSocket: after 101 the connection belongs to the new protocol.\n");
    t.push_str("role server\n");
    t.push_str("recv GET /chat HTTP/1.1\\r\\nHost: ws.example.com\\r\\nUpgrade: websocket\\r\\nConnection: Upgrade\\r\\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\\r\\nSec-WebSocket-Version: 13\\r\\n\\r\\n\\x81\\x85\\x37\\xfa\\x21\\x3d\\x7f\\x9f\\x4d\\x51\\x58\n");
    t.push_str("next\n");
    t.push_str("info 101 1.1 Switching Protocols | Upgrade: websocket | Connection: Upgrade | Sec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\n");
    t.push_str("next\n");
    v.push(DataFile { path: "scripts/srv-12-websocket-upgrade.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("role server\n");
    t.push_str("recv GET /chat HTTP/1.1\\r\\nHost: ws\\r\\nUpgrade: h2c\\r\\nConnection: Upgrade, HTTP2-Settings\\r\\nHTTP2-Settings: AAMAAABkAAQAoAAAAAIAAAAA\\r\\n\\r\\n\n");
    t.push_str("next\n");
    t.push_str("response 200 1.1 OK | Content-Length: 3\n");
    t.push_str("data ok\n");
    t.push_str("data k\n");
    t.push_str("eom\n");
    t.push_str("cycle\n");
    v.push(DataFile { path: "scripts/srv-13-upgrade-declined.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("role server\n");
    t.push_str("recv CONNECT db.internal:5432 HTTP/1.1\\r\\nHost: db.internal:5432\\r\\n\\r\\n\n");
    t.push_str("response 200 1.1 Connection established\n");
    t.push_str("next\n");
    t.push_str("recv \\x00\\x00\\x00\\x08\\x04\\xd2\\x16\\x2f\n");
    v.push(DataFile { path: "scripts/srv-14-connect.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("role server\n");
    t.push_str("recv CONNECT evil.example:25 HTTP/1.1\\r\\nHost: evil.example:25\\r\\nContent-Length: 0\\r\\n\\r\\n\n");
    t.push_str("response 403 1.1 Forbidden | Content-Length: 0\n");
    t.push_str("eom\n");
    t.push_str("cycle\n");
    v.push(DataFile { path: "scripts/srv-15-connect-refused.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("# Obsolete line folding joins continuation lines with one space.\n");
    t.push_str("role server\n");
    t.push_str("recv POST /soap HTTP/1.1\\r\\nHost: legacy\\r\\nSOAPAction: \"urn:\\r\\n\\t  getQuote\"\\r\\nX-Long: a\\r\\n b\\r\\n  c\\r\\nContent-Length: 0\\r\\n\\r\\n\n");
    v.push(DataFile { path: "scripts/srv-16-obs-fold.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("# Values are trimmed of spaces and tabs; empty values and odd bytes are fine.\n");
    t.push_str("role server\n");
    t.push_str("recv GET / HTTP/1.1\\r\\nHost:example.com\\r\\nX-Empty:\\r\\nX-Spaces: \\t a  b \\t \\r\\nX-Ctl: a\\x01b\\r\\nX-Obs: caf\\xc3\\xa9\\r\\nACCEPT: */*\\r\\n\\r\\n\n");
    v.push(DataFile { path: "scripts/srv-17-header-forms.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("# Bare LF line endings are accepted too.\n");
    t.push_str("role server\n");
    t.push_str("recv GET /lf HTTP/1.1\\nHost: x\\nContent-Length: 3\\n\\nabc\n");
    v.push(DataFile { path: "scripts/srv-18-lf-only.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("role server\n");
    t.push_str("recv POST /a HTTP/1.1\\r\\nHost: x\\r\\nContent-Length: 5, 5,5\\r\\n\\r\\nhello\n");
    t.push_str("response 200 1.1 OK | Content-Length: 0\n");
    t.push_str("eom\n");
    t.push_str("cycle\n");
    t.push_str("recv POST /b HTTP/1.1\\r\\nHost: x\\r\\nContent-Length: 3\\r\\ncontent-length: 3\\r\\n\\r\\nabc\n");
    v.push(DataFile { path: "scripts/srv-19-content-length-forms.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("role server\n");
    t.push_str("recv POST /ingest HTTP/1.1\\r\\nHost: x\\r\\nTransfer-Encoding: Chunked\\r\\n\\r\\n\n");
    t.push_str("recv 4;name=\"first\"; ext\\r\\nWiki\\r\\n5 \\t\\r\\npedia\\r\\nE\\r\\n in\\r\\n\\r\\nchunks.\\r\\n\n");
    t.push_str("recv 0;done\\r\\nContent-MD5: 1B2M2Y8AsgTpgAmY7PhCfg==\\r\\nX-Trailer:   x  \\r\\n\\r\\n\n");
    v.push(DataFile { path: "scripts/srv-20-chunked-trailers.h11".to_string(), hex: false, body: t });
}

fn data_part_3(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("# A chunk whose data and CRLF arrive in separate reads.\n");
    t.push_str("role server\n");
    t.push_str("recv POST /x HTTP/1.1\\r\\nHost: x\\r\\nTransfer-Encoding: chunked\\r\\n\\r\\n6\\r\\nhel\n");
    t.push_str("recv lo!\n");
    t.push_str("recv \\r\n");
    t.push_str("recv \\n\n");
    t.push_str("recv 0\\r\\n\n");
    t.push_str("recv \\r\\n\n");
    v.push(DataFile { path: "scripts/srv-21-chunk-split.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("role server\n");
    t.push_str("recv POST /upload HTTP/1.1\\r\\nHost: x\\r\\nContent-Length: 10\\r\\n\\r\\n12345\n");
    t.push_str("eof\n");
    t.push_str("next\n");
    v.push(DataFile { path: "scripts/srv-22-eof-mid-body.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("role server\n");
    t.push_str("recv POST /upload HTTP/1.1\\r\\nHost: x\\r\\nTransfer-Encoding: chunked\\r\\n\\r\\n5\\r\\nabc\n");
    t.push_str("eof\n");
    v.push(DataFile { path: "scripts/srv-23-eof-mid-chunked.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("role server\n");
    t.push_str("recv GET / HTTP/1.1\\r\\nHost: x\\r\\n\n");
    t.push_str("eof\n");
    t.push_str("recv more\n");
    v.push(DataFile { path: "scripts/srv-24-eof-mid-headers.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("role server\n");
    t.push_str("eof\n");
    t.push_str("next\n");
    t.push_str("recv late\n");
    v.push(DataFile { path: "scripts/srv-25-eof-idle.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("role server\n");
    t.push_str("recv GET / HTTP/1.1\\r\\nHost: x\\r\\n\\r\\n\n");
    t.push_str("response 200 1.1 OK | Content-Length: 0\n");
    t.push_str("eom\n");
    t.push_str("cycle\n");
    t.push_str("eof\n");
    v.push(DataFile { path: "scripts/srv-26-keepalive-then-close.h11".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("role server\n");
    t.push_str("recv GET / HTTP/1.1\\r\\nHost: x\\r\\nConnection: close\\r\\n\\r\\nGET /again HTTP/1.1\\r\\n\\r\\n\n");
    t.push_str("response 200 1.1 OK | Content-Length: 1\n");
    t.push_str("data !\n");
    t.push_str("eom\n");
    t.push_str("next\n");
    v.push(DataFile { path: "scripts/srv-27-data-after-close-request.h11".to_string(), hex: false, body: t });
}
