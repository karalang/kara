fn data_files() -> Vec[(String, String)] {
    let mut v: Vec[(String, String)] = Vec.new();
    v.push(("sessions.txt".to_string(), file_0()));
    v
}

// ------------------------------------------------------------ the sockets

fn read_all(conn: ref TcpStream) -> Vec[u8] {
    let mut bytes: Vec[u8] = Vec.new();
    let mut buf: Array[u8, 4096] = [0u8; 4096];
    loop {
        match conn.read(mut buf) {
            Ok(0) => break,
            Ok(n) => {
                for i in 0..n {
                    bytes.push(buf[i]);
                }
            }
            Err(_) => break,
        }
    }
    bytes
}

struct Session {
    name: String,
    advance: i64,
    lines: Vec[String],
}

fn read_sessions(text: Str) -> Vec[Session] {
    let mut sessions: Vec[Session] = Vec.new();
    for line in text.split("\n") {
        if line.starts_with("=== ") {
            sessions.push(Session { name: line[4..].to_string(), advance: 0, lines: Vec.new() });
        } else if line.starts_with("@advance ") {
            let n = sessions.len() - 1;
            sessions[n].advance = i64.parse(line[9..]).unwrap_or(0);
        } else if not sessions.is_empty() {
            let n = sessions.len() - 1;
            if not line.is_empty() or not sessions[n].lines.is_empty() {
                sessions[n].lines.push(line.clone());
            }
        }
    }
    sessions
}

fn write_data() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        return Err(f"{e}");
    }
    for (name, text) in data_files() {
        if let Err(e) = fs.write(f"data/{name}", text) {
            return Err(f"{e}");
        }
    }
    Ok(())
}

fn run() -> Result[(), String] {
    write_data()?;
    let text = match fs.read_to_string("data/sessions.txt".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"{e}"),
    };
    let listener = match TcpListener.bind(ADDR) {
        Ok(l) => l,
        Err(_) => return Err(f"cannot bind {ADDR}"),
    };
    let mut cache = Cache.new();
    println(f"mini_memcached: listening on {ADDR}, {LIMIT} bytes of memory");
    for s in read_sessions(text.as_str()) {
        let mut lines = s.lines.clone();
        while not lines.is_empty() and lines[lines.len() - 1].is_empty() {
            lines.pop();
        }
        cache.now += s.advance;
        cache.connections += 1;
        let mut payload: Vec[u8] = Vec.new();
        for l in lines {
            payload.extend_from_slice(l.bytes());
            payload.extend_from_slice("\r\n".bytes());
        }
        println(f"=== {s.name} (t+{cache.now - 2})");
        let client = match TcpStream.connect(ADDR) {
            Ok(c) => c,
            Err(_) => return Err("connect failed".to_string()),
        };
        if client.write_all(payload.as_slice()).is_err() {
            return Err("client write failed".to_string());
        }
        if client.shutdown_write().is_err() {
            return Err("shutdown failed".to_string());
        }
        let mut c = Conn { reply: Vec.new(), log: Vec.new() };
        let mut used = 0;
        {
            let conn = match listener.accept() {
                Ok(conn) => conn,
                Err(_) => return Err("accept failed".to_string()),
            };
            let received = read_all(conn);
            used = serve(mut cache, received, mut c);
            if conn.write_all(c.reply.as_slice()).is_err() {
                return Err("server write failed".to_string());
            }
        }
        let got = read_all(client);
        for l in c.log {
            println(l);
        }
        println(f"--- client sent {payload.len()} bytes, server read {used}, client got {got.len()}");
    }
    println(f"mini_memcached: {cache.items.len()} items, {cache.bytes} bytes");
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"error: {e}");
    }
}
