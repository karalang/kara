// dhcp_server: a DHCP server (RFC 2131, options of RFC 2132) on loopback
// UDP. One server task answers each datagram in turn from a pool of five
// addresses: DISCOVER gets an OFFER, REQUEST an ACK or a NAK, INFORM an ACK
// without a lease, and RELEASE and DECLINE no answer. Scripted clients on
// the main task, each with a socket of its own, send each kind and print
// what comes back; then the server prints its log and leases.

import std::sync::{TaskGroup, Mutex};

const ADDR: &str = "127.0.0.1:47769";
const DATAGRAMS: i64 = 25;
const QUIET_MS: i64 = 300;
const COOKIE: [u8; 4] = [99, 130, 83, 99];

const SERVER_ID: [u8; 4] = [10, 0, 0, 1];
const ROUTER: [u8; 4] = [10, 0, 0, 1];
const DNS: [u8; 4] = [10, 0, 0, 53];
const MASK: [u8; 4] = [255, 255, 255, 0];
const POOL_FIRST: u8 = 100;
const POOL_SIZE: u8 = 5;
const LEASE: u32 = 3600;

const DISCOVER: u8 = 1;
const OFFER: u8 = 2;
const REQUEST: u8 = 3;
const DECLINE: u8 = 4;
const ACK: u8 = 5;
const NAK: u8 = 6;
const RELEASE: u8 = 7;
const INFORM: u8 = 8;
const KINDS: [&str; 9] = ["?", "DISCOVER", "OFFER", "REQUEST", "DECLINE", "ACK", "NAK", "RELEASE", "INFORM"];

const OPT_MASK: u8 = 1;
const OPT_ROUTER: u8 = 3;
const OPT_DNS: u8 = 6;
const OPT_HOSTNAME: u8 = 12;
const OPT_REQUESTED: u8 = 50;
const OPT_LEASE: u8 = 51;
const OPT_TYPE: u8 = 53;
const OPT_SERVER: u8 = 54;
const OPT_PARAMS: u8 = 55;
const OPT_MESSAGE: u8 = 56;
const OPT_T1: u8 = 58;
const OPT_T2: u8 = 59;

fn ip_text(b: &[u8]) -> String {
    b.iter().map(|x| x.to_string()).collect::<Vec<String>>().join(".")
}

fn mac_text(b: &[u8]) -> String {
    b.iter().map(|x| format!("{:02x}", x)).collect::<Vec<String>>().join(":")
}

// The options after the magic cookie, up to the end option.
fn parse_options(pkt: &[u8], from: usize) -> Result<SortedMap<u8, Vec<u8>>, String> {
    let mut opts = SortedMap::new();
    let mut i = from;
    loop {
        if i >= pkt.len() {
            return Err("no end option".to_string());
        }
        let code = pkt[i];
        if code == 255 {
            break;
        }
        if code == 0 {
            i += 1;
            continue;
        }
        if i + 1 >= pkt.len() || i + 2 + pkt[i + 1] as usize > pkt.len() {
            return Err("option overruns".to_string());
        }
        let n = pkt[i + 1] as usize;
        opts.insert(code, pkt[i + 2..i + 2 + n].to_vec());
        i += 2 + n;
    }
    Ok(opts)
}

struct Request {
    kind: u8,
    xid: Vec<u8>,
    ciaddr: Vec<u8>,
    chaddr: Vec<u8>,
    opts: SortedMap<u8, Vec<u8>>,
}

fn parse(pkt: &[u8]) -> Result<Request, String> {
    if pkt.len() < 240 {
        return Err("short".to_string());
    }
    if pkt[0] != 1 {
        return Err("not a request".to_string());
    }
    if pkt[1] != 1 || pkt[2] != 6 {
        return Err("not ethernet".to_string());
    }
    if pkt[236..240] != COOKIE {
        return Err("bad cookie".to_string());
    }
    let opts = parse_options(pkt, 240)?;
    let kind = match opts.get(&OPT_TYPE) {
        Some(k) if k.len() == 1 && k[0] >= 1 && k[0] <= 8 => k[0],
        _ => return Err("no message type".to_string()),
    };
    Ok(Request {
        kind,
        xid: pkt[4..8].to_vec(),
        ciaddr: pkt[12..16].to_vec(),
        chaddr: pkt[28..34].to_vec(),
        opts,
    })
}

fn option(code: u8, data: &[u8]) -> Vec<u8> {
    let mut out = vec![code, data.len() as u8];
    out.extend_from_slice(data);
    out
}

fn message(op: u8, xid: &[u8], ciaddr: &[u8], yiaddr: &[u8], chaddr: &[u8], opts: &[Vec<u8>]) -> Vec<u8> {
    let mut pkt = vec![0u8; 240];
    pkt[0] = op;
    pkt[1] = 1;
    pkt[2] = 6;
    pkt[4..8].copy_from_slice(xid);
    pkt[12..16].copy_from_slice(ciaddr);
    pkt[16..20].copy_from_slice(yiaddr);
    pkt[20..24].copy_from_slice(&SERVER_ID);
    pkt[28..34].copy_from_slice(chaddr);
    pkt[236..240].copy_from_slice(&COOKIE);
    for o in opts {
        pkt.extend_from_slice(o);
    }
    pkt.push(255);
    pkt
}

#[derive(Clone, PartialEq)]
enum State {
    Offered,
    Bound,
    Declined,
}

#[derive(Clone)]
struct Slot {
    state: State,
    mac: Vec<u8>,
}

struct Book {
    log: Vec<String>,
    counts: SortedMap<String, i64>,
    slots: SortedMap<u8, Slot>,
}

impl Book {
    fn note(&mut self, line: String, count: &str) {
        self.log.push(line);
        *self.counts.entry(count.to_string()).or_insert(0) += 1;
    }

    fn holds(&self, k: u8, state: State, mac: &[u8]) -> bool {
        match self.slots.get(&k) {
            Some(s) => s.state == state && s.mac == mac,
            None => false,
        }
    }

    fn holder(&self, mac: &[u8], state: State) -> Option<u8> {
        for (k, s) in self.slots.iter() {
            if s.state == state && s.mac == mac {
                return Some(*k);
            }
        }
        None
    }

    fn free(&self, k: u8) -> bool {
        k >= POOL_FIRST && k < POOL_FIRST + POOL_SIZE && !self.slots.contains_key(&k)
    }

    fn drop_offers(&mut self, mac: &[u8]) {
        let offered: Vec<u8> = self
            .slots
            .iter()
            .filter(|(_, s)| s.state == State::Offered && s.mac == mac)
            .map(|(k, _)| *k)
            .collect();
        for k in offered {
            self.slots.remove(&k);
        }
    }

    fn handle(&mut self, pkt: &[u8]) -> Option<Vec<u8>> {
        let r = match parse(pkt) {
            Ok(r) => r,
            Err(e) => {
                self.note(format!("dropped: {}", e), "dropped");
                return None;
            }
        };
        let mac = r.chaddr.clone();
        let mut who = mac_text(&mac);
        if let Some(name) = r.opts.get(&OPT_HOSTNAME) {
            who.push_str(&format!(" ({})", String::from_utf8_lossy(name)));
        }
        let want: Option<Vec<u8>> = match r.opts.get(&OPT_REQUESTED) {
            Some(w) if w.len() == 4 => Some(w.clone()),
            _ => None,
        };
        match r.kind {
            DISCOVER => {
                self.drop_offers(&mac);
                let mut k = self.holder(&mac, State::Bound);
                if k.is_none() {
                    if let Some(w) = &want {
                        if w[..3] == SERVER_ID[..3] && self.free(w[3]) {
                            k = Some(w[3]);
                        }
                    }
                }
                if k.is_none() {
                    k = (POOL_FIRST..POOL_FIRST + POOL_SIZE).find(|j| self.free(*j));
                }
                let k = match k {
                    Some(k) => k,
                    None => {
                        self.note(format!("{} DISCOVER: pool exhausted", who), "exhausted");
                        return None;
                    }
                };
                if !self.holds(k, State::Bound, &mac) {
                    self.slots.insert(k, Slot { state: State::Offered, mac: mac.clone() });
                }
                self.note(format!("{} DISCOVER -> OFFER 10.0.0.{}", who, k), "offer");
                Some(reply(OFFER, &r, &[0, 0, 0, 0], &[10, 0, 0, k], true))
            }
            REQUEST => {
                if let Some(sid) = r.opts.get(&OPT_SERVER) {
                    if sid[..] != SERVER_ID[..] {
                        self.drop_offers(&mac);
                        self.note(format!("{} REQUEST: chose server {}", who, ip_text(sid)), "elsewhere");
                        return None;
                    }
                }
                let addr = match &want {
                    Some(w) => w.clone(),
                    None => r.ciaddr.clone(),
                };
                let k = addr[3];
                let ours = addr[..3] == SERVER_ID[..3] && k >= POOL_FIRST && k < POOL_FIRST + POOL_SIZE;
                let ok = if r.opts.contains_key(&OPT_SERVER) {
                    ours && self.holds(k, State::Offered, &mac)
                } else {
                    ours && self.holds(k, State::Bound, &mac)
                };
                if !ok {
                    self.drop_offers(&mac);
                    self.note(format!("{} REQUEST {} -> NAK", who, ip_text(&addr)), "nak");
                    return Some(reply(NAK, &r, &[0, 0, 0, 0], &[0, 0, 0, 0], false));
                }
                self.slots.insert(k, Slot { state: State::Bound, mac: mac.clone() });
                self.note(format!("{} REQUEST {} -> ACK", who, ip_text(&addr)), "ack");
                Some(reply(ACK, &r, &[0, 0, 0, 0], &[10, 0, 0, k], true))
            }
            RELEASE => {
                let k = r.ciaddr[3];
                if self.holds(k, State::Bound, &mac) {
                    self.slots.remove(&k);
                    self.note(format!("{} RELEASE {}", who, ip_text(&r.ciaddr)), "release");
                } else {
                    self.note(format!("{} RELEASE {}: not its lease", who, ip_text(&r.ciaddr)), "ignored");
                }
                None
            }
            DECLINE => {
                let mine = match &want {
                    Some(w) => match self.slots.get(&w[3]) {
                        Some(s) => s.mac == mac,
                        None => false,
                    },
                    None => false,
                };
                if mine {
                    let w = want.unwrap();
                    self.slots.insert(w[3], Slot { state: State::Declined, mac: Vec::new() });
                    self.note(format!("{} DECLINE {}: marked in use", who, ip_text(&w)), "decline");
                } else {
                    self.note(format!("{} DECLINE: not its address", who), "ignored");
                }
                None
            }
            INFORM => {
                self.note(format!("{} INFORM {} -> ACK", who, ip_text(&r.ciaddr)), "inform");
                Some(reply(ACK, &r, &r.ciaddr, &[0, 0, 0, 0], false))
            }
            _ => {
                self.note(format!("{} {}: not a client message", who, KINDS[r.kind as usize]), "dropped");
                None
            }
        }
    }
}

fn be32(n: u32) -> [u8; 4] {
    n.to_be_bytes()
}

fn reply(kind: u8, r: &Request, ciaddr: &[u8], yiaddr: &[u8], lease: bool) -> Vec<u8> {
    let params = r.opts.get(&OPT_PARAMS);
    let mut out = vec![option(OPT_TYPE, &[kind]), option(OPT_SERVER, &SERVER_ID)];
    if lease {
        out.push(option(OPT_LEASE, &be32(LEASE)));
        out.push(option(OPT_T1, &be32(LEASE / 2)));
        out.push(option(OPT_T2, &be32(LEASE * 7 / 8)));
    }
    if kind != NAK {
        for (code, data) in [(OPT_MASK, MASK), (OPT_ROUTER, ROUTER), (OPT_DNS, DNS)] {
            let asked = match params {
                Some(p) => p.contains(&code),
                None => true,
            };
            if asked {
                out.push(option(code, &data));
            }
        }
    } else {
        out.push(option(OPT_MESSAGE, b"address not yours"));
    }
    message(2, &r.xid, ciaddr, yiaddr, &r.chaddr, &out)
}

sync struct Server {
    book: Mutex<Book>,
}

fn serve(srv: &Server, sock: &UdpSocket) {
    let mut buf = [0u8; 1500];
    for _ in 0..DATAGRAMS {
        let (len, peer) = sock.recv_from(&mut buf).unwrap();
        let out = {
            let mut g = srv.book.lock();
            g.value.handle(&buf[..len])
        };
        if let Some(pkt) = out {
            let _ = sock.send_to(&pkt, peer);
        }
    }
}

// One line for a server's reply.
fn describe(pkt: &[u8], xid: &[u8]) -> String {
    if pkt.len() < 240 || pkt[0] != 2 || pkt[236..240] != COOKIE {
        return "not a reply".to_string();
    }
    if pkt[4..8] != *xid {
        return "wrong xid".to_string();
    }
    let opts = match parse_options(pkt, 240) {
        Ok(o) => o,
        Err(_) => return "truncated reply".to_string(),
    };
    let mut parts: Vec<String> = Vec::new();
    let kind = match opts.get(&OPT_TYPE) {
        Some(k) if k.len() == 1 && (k[0] as usize) < KINDS.len() => k[0] as usize,
        _ => 0,
    };
    parts.push(KINDS[kind].to_string());
    if pkt[16..20] != [0u8; 4] {
        parts.push(format!("yiaddr={}", ip_text(&pkt[16..20])));
    }
    if pkt[12..16] != [0u8; 4] {
        parts.push(format!("ciaddr={}", ip_text(&pkt[12..16])));
    }
    for (code, data) in opts.iter() {
        match *code {
            OPT_SERVER => parts.push(format!("server={}", ip_text(data))),
            OPT_MASK => parts.push(format!("mask={}", ip_text(data))),
            OPT_ROUTER => parts.push(format!("router={}", ip_text(data))),
            OPT_DNS => parts.push(format!("dns={}", ip_text(data))),
            OPT_LEASE | OPT_T1 | OPT_T2 => {
                let n = u32::from_be_bytes([data[0], data[1], data[2], data[3]]);
                let name = match *code {
                    OPT_LEASE => "lease",
                    OPT_T1 => "t1",
                    _ => "t2",
                };
                parts.push(format!("{}={}", name, n));
            }
            OPT_MESSAGE => parts.push(format!("message=\"{}\"", String::from_utf8_lossy(data))),
            _ => {}
        }
    }
    parts.join(" ")
}

struct Client {
    name: String,
    mac: Vec<u8>,
    xid: Vec<u8>,
    hostname: String,
    sock: UdpSocket,
}

impl Client {
    fn new(name: &str, n: u8, hostname: &str) -> Client {
        let sock = UdpSocket::bind("127.0.0.1:0").unwrap();
        Client {
            name: name.to_string(),
            mac: vec![2, 0, 0, 0, 0, n],
            xid: vec![0x4B, 0x41, 0x52, n],
            hostname: hostname.to_string(),
            sock,
        }
    }

    fn send(&self, kind: u8, ciaddr: &[u8], extra: Vec<Vec<u8>>) {
        let mut opts = vec![option(OPT_TYPE, &[kind])];
        if !self.hostname.is_empty() {
            opts.push(option(OPT_HOSTNAME, self.hostname.as_bytes()));
        }
        opts.extend(extra);
        let pkt = message(1, &self.xid, ciaddr, &[0, 0, 0, 0], &self.mac, &opts);
        let _ = self.sock.send_to(&pkt, ADDR);
    }

    fn send_raw(&self, pkt: &[u8]) {
        let _ = self.sock.send_to(pkt, ADDR);
    }

    // Prints the reply, or that none came within `wait_ms`.
    fn recv(&self, wait_ms: i64) {
        let _ = self.sock.set_read_timeout(Some(wait_ms));
        let mut buf = [0u8; 1500];
        match self.sock.recv_from(&mut buf) {
            Ok((n, _)) => println!("{}: {}", self.name, describe(&buf[..n], &self.xid)),
            Err(_) => println!("{}: no reply", self.name),
        }
    }
}

fn requested(ip: &[u8]) -> Vec<u8> {
    option(OPT_REQUESTED, ip)
}

fn server_id(ip: &[u8]) -> Vec<u8> {
    option(OPT_SERVER, ip)
}

fn main() {
    let srv = Server {
        book: Mutex::new(Book { log: Vec::new(), counts: SortedMap::new(), slots: SortedMap::new() }),
    };
    let sock = UdpSocket::bind(ADDR).unwrap();
    let group = TaskGroup::new();
    let server = group.spawn(|| serve(&srv, &sock));
    let zero = [0u8; 4];

    let alpha = Client::new("alpha", 1, "alpha");
    alpha.send(DISCOVER, &zero, vec![]);
    alpha.recv(2000);
    alpha.send(REQUEST, &zero, vec![requested(&[10, 0, 0, 100]), server_id(&SERVER_ID)]);
    alpha.recv(2000);

    let beta = Client::new("beta", 2, "beta");
    beta.send(DISCOVER, &zero, vec![requested(&[10, 0, 0, 103])]);
    beta.recv(2000);
    beta.send(REQUEST, &zero, vec![requested(&[10, 0, 0, 103]), server_id(&[10, 0, 0, 9])]);
    beta.recv(QUIET_MS);
    beta.send(DISCOVER, &zero, vec![option(OPT_PARAMS, &[OPT_MASK, OPT_DNS])]);
    beta.recv(2000);
    beta.send(REQUEST, &zero, vec![requested(&[10, 0, 0, 101]), server_id(&SERVER_ID), option(OPT_PARAMS, &[OPT_MASK, OPT_DNS])]);
    beta.recv(2000);

    alpha.send(REQUEST, &[10, 0, 0, 100], vec![]);
    alpha.recv(2000);

    let gamma = Client::new("gamma", 3, "");
    gamma.send(REQUEST, &zero, vec![requested(&[10, 0, 0, 104])]);
    gamma.recv(2000);
    gamma.send(DISCOVER, &zero, vec![]);
    gamma.recv(2000);
    gamma.send(REQUEST, &zero, vec![requested(&[10, 0, 0, 104]), server_id(&SERVER_ID)]);
    gamma.recv(2000);
    gamma.send(DISCOVER, &zero, vec![]);
    gamma.recv(2000);
    gamma.send(REQUEST, &zero, vec![requested(&[10, 0, 0, 102]), server_id(&SERVER_ID)]);
    gamma.recv(2000);
    gamma.send(DECLINE, &zero, vec![requested(&[10, 0, 0, 102]), server_id(&SERVER_ID)]);
    gamma.recv(QUIET_MS);

    alpha.send(RELEASE, &[10, 0, 0, 100], vec![server_id(&SERVER_ID)]);
    alpha.recv(QUIET_MS);
    beta.send(RELEASE, &[10, 0, 0, 100], vec![server_id(&SERVER_ID)]);
    beta.recv(QUIET_MS);

    let delta = Client::new("delta", 4, "delta");
    delta.send(DISCOVER, &zero, vec![]);
    delta.recv(2000);

    for (i, name) in ["epsilon", "zeta", "eta"].iter().enumerate() {
        let c = Client::new(name, 7 + i as u8, name);
        c.send(DISCOVER, &zero, vec![]);
        c.recv(if *name != "eta" { 2000 } else { QUIET_MS });
    }

    let office = Client::new("office", 5, "printer");
    office.send(INFORM, &[10, 0, 0, 50], vec![option(OPT_PARAMS, &[OPT_ROUTER])]);
    office.recv(2000);

    let bad = Client::new("broken", 6, "");
    bad.send_raw(&[0u8; 10]);
    bad.recv(QUIET_MS);
    let mut pkt = message(1, &bad.xid, &zero, &zero, &bad.mac, &[option(OPT_TYPE, &[DISCOVER])]);
    pkt[236] = 0;
    bad.send_raw(&pkt);
    bad.recv(QUIET_MS);
    bad.send_raw(&message(2, &bad.xid, &zero, &zero, &bad.mac, &[option(OPT_TYPE, &[OFFER])]));
    bad.recv(QUIET_MS);
    bad.send_raw(&message(1, &bad.xid, &zero, &zero, &bad.mac, &[option(OPT_HOSTNAME, b"x")]));
    bad.recv(QUIET_MS);
    let mut pkt = message(1, &bad.xid, &zero, &zero, &bad.mac, &[option(OPT_TYPE, &[DISCOVER])]);
    pkt.pop();
    pkt.extend_from_slice(&[OPT_HOSTNAME, 9, 65]);
    bad.send_raw(&pkt);
    bad.recv(QUIET_MS);

    let _ = server.join();
    println!("== server");
    let g = srv.book.lock();
    for (i, line) in g.value.log.iter().enumerate() {
        println!("#{} {}", i + 1, line);
    }
    for (k, v) in g.value.counts.iter() {
        println!("{}: {}", k, v);
    }
    println!("== leases");
    for (k, s) in g.value.slots.iter() {
        let state = match s.state {
            State::Offered => "offered",
            State::Bound => "bound",
            State::Declined => "declined",
        };
        let mac = if s.mac.is_empty() { "-".to_string() } else { mac_text(&s.mac) };
        println!("10.0.0.{} {} {}", k, state, mac);
    }
}
