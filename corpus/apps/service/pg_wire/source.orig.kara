// pg_wire: a PostgreSQL wire-protocol (v3) server on loopback TCP. Each
// connection is a task that reads the startup message, asks for a
// cleartext password, and then answers simple-protocol queries over one
// in-memory table, `items (id int4, name text, qty int4)`, with a small SQL
// subset: SELECT (columns, WHERE, ORDER BY), INSERT, UPDATE, DELETE, and
// BEGIN / COMMIT / ROLLBACK, where a transaction works on its own copy of
// the rows and an error aborts it until ROLLBACK. Messages are framed as a
// tag byte and a big-endian length. Scripted clients on the main task
// decode every message they get back; the server then prints its rows.

import std::sync::{TaskGroup, Mutex};
import std::io::BufReader;

const ADDR: &str = "127.0.0.1:47781";
const SESSIONS: usize = 4;
const INT4: i32 = 23;
const TEXT: i32 = 25;

fn columns() -> Vec<(String, i32)> {
    vec![("id".to_string(), INT4), ("name".to_string(), TEXT), ("qty".to_string(), INT4)]
}

fn password_of(user: &str) -> Option<String> {
    match user {
        "alice" => Some("wonder".to_string()),
        "bob" => Some("builder".to_string()),
        _ => None,
    }
}

#[derive(Clone, PartialEq)]
enum Value {
    Int(i64),
    Text(String),
    Null,
}

impl Value {
    fn render(&self) -> Option<String> {
        match self {
            Value::Int(n) => Some(n.to_string()),
            Value::Text(s) => Some(s.clone()),
            Value::Null => None,
        }
    }

    fn type_name(&self) -> &str {
        match self {
            Value::Int(_) => "integer",
            _ => "text",
        }
    }
}

type Row = Vec<Value>;

struct State {
    rows: Vec<Row>,
    next_pid: i32,
    queries: i64,
}

fn seed() -> Vec<Row> {
    vec![
        vec![Value::Int(1), Value::Text("apple".to_string()), Value::Int(5)],
        vec![Value::Int(2), Value::Text("banana".to_string()), Value::Int(12)],
        vec![Value::Int(3), Value::Text("cherry".to_string()), Value::Int(0)],
    ]
}

sync struct Db {
    state: Mutex<State>,
}

// ------------------------------------------------------------ framing

fn msg(tag: u8, body: &[u8]) -> Vec<u8> {
    let mut out = vec![tag];
    out.extend_from_slice(&((body.len() + 4) as i32).to_be_bytes());
    out.extend_from_slice(body);
    out
}

fn cstr(out: &mut Vec<u8>, s: &str) {
    out.extend_from_slice(s.as_bytes());
    out.push(0);
}

fn fields_msg(tag: u8, severity: &str, code: &str, text: &str) -> Vec<u8> {
    let mut body = Vec::new();
    body.push(b'S');
    cstr(&mut body, severity);
    body.push(b'C');
    cstr(&mut body, code);
    body.push(b'M');
    cstr(&mut body, text);
    body.push(0);
    msg(tag, &body)
}

fn error(code: &str, text: &str) -> Vec<u8> {
    fields_msg(b'E', "ERROR", code, text)
}

fn notice(code: &str, text: &str) -> Vec<u8> {
    fields_msg(b'N', "WARNING", code, text)
}

fn ready(status: u8) -> Vec<u8> {
    msg(b'Z', &[status])
}

fn row_description(cols: &[(String, i32)]) -> Vec<u8> {
    let mut body = Vec::new();
    body.extend_from_slice(&(cols.len() as i16).to_be_bytes());
    for (name, oid) in cols {
        cstr(&mut body, name);
        let size: i16 = if *oid == INT4 { 4 } else { -1 };
        body.extend_from_slice(&0i32.to_be_bytes());
        body.extend_from_slice(&0i16.to_be_bytes());
        body.extend_from_slice(&oid.to_be_bytes());
        body.extend_from_slice(&size.to_be_bytes());
        body.extend_from_slice(&(-1i32).to_be_bytes());
        body.extend_from_slice(&0i16.to_be_bytes());
    }
    msg(b'T', &body)
}

fn data_row(values: &[Value]) -> Vec<u8> {
    let mut body = Vec::new();
    body.extend_from_slice(&(values.len() as i16).to_be_bytes());
    for v in values {
        match v.render() {
            None => body.extend_from_slice(&(-1i32).to_be_bytes()),
            Some(s) => {
                body.extend_from_slice(&(s.len() as i32).to_be_bytes());
                body.extend_from_slice(s.as_bytes());
            }
        }
    }
    msg(b'D', &body)
}

fn complete(tag: &str) -> Vec<u8> {
    let mut body = Vec::new();
    cstr(&mut body, tag);
    msg(b'C', &body)
}

fn be_i32(b: &[u8]) -> i32 {
    i32::from_be_bytes([b[0], b[1], b[2], b[3]])
}

fn be_i16(b: &[u8]) -> i16 {
    i16::from_be_bytes([b[0], b[1]])
}

// ------------------------------------------------------------ SQL subset

struct SqlError {
    code: String,
    text: String,
}

fn sql_error(code: &str, text: String) -> SqlError {
    SqlError { code: code.to_string(), text }
}

#[derive(Clone, PartialEq)]
enum Tok {
    Word(String),
    Num(i64),
    Str(String),
    Op(String),
    End,
}

fn tokens(sql: &str) -> Result<Vec<Tok>, SqlError> {
    let chars: Vec<char> = sql.chars().collect();
    let mut out = Vec::new();
    let mut i = 0;
    while i < chars.len() {
        let c = chars[i];
        if c.is_whitespace() {
            i += 1;
        } else if c == '\'' {
            let mut j = i + 1;
            let mut text = String::new();
            loop {
                if j >= chars.len() {
                    return Err(sql_error("42601", "unterminated quoted string".to_string()));
                }
                if chars[j] == '\'' {
                    if j + 1 < chars.len() && chars[j + 1] == '\'' {
                        text.push('\'');
                        j += 2;
                        continue;
                    }
                    break;
                }
                text.push(chars[j]);
                j += 1;
            }
            out.push(Tok::Str(text));
            i = j + 1;
        } else if c.is_ascii_digit() || (c == '-' && i + 1 < chars.len() && chars[i + 1].is_ascii_digit()) {
            let mut j = i + 1;
            while j < chars.len() && chars[j].is_ascii_digit() {
                j += 1;
            }
            let digits: String = chars[i..j].iter().collect();
            out.push(Tok::Num(digits.parse().unwrap()));
            i = j;
        } else if c.is_alphabetic() || c == '_' {
            let mut j = i;
            while j < chars.len() && (chars[j].is_alphanumeric() || chars[j] == '_') {
                j += 1;
            }
            let word: String = chars[i..j].iter().collect();
            out.push(Tok::Word(word.to_lowercase()));
            i = j;
        } else if i + 1 < chars.len() && ["<=", ">=", "<>", "!="].contains(&format!("{}{}", c, chars[i + 1]).as_str()) {
            out.push(Tok::Op(format!("{}{}", c, chars[i + 1])));
            i += 2;
        } else if "=<>,()*".contains(c) {
            out.push(Tok::Op(c.to_string()));
            i += 1;
        } else {
            return Err(sql_error("42601", format!("syntax error at or near \"{}\"", c)));
        }
    }
    Ok(out)
}

struct Parser {
    toks: Vec<Tok>,
    pos: usize,
}

impl Parser {
    fn peek(&self) -> Tok {
        if self.pos < self.toks.len() { self.toks[self.pos].clone() } else { Tok::End }
    }

    fn next(&mut self) -> Tok {
        let t = self.peek();
        self.pos += 1;
        t
    }

    fn near(&self) -> String {
        match self.peek() {
            Tok::End => "end of input".to_string(),
            Tok::Word(w) => format!("\"{}\"", w),
            Tok::Num(n) => format!("\"{}\"", n),
            Tok::Str(s) => format!("\"{}\"", s),
            Tok::Op(o) => format!("\"{}\"", o),
        }
    }

    fn syntax(&self) -> SqlError {
        sql_error("42601", format!("syntax error at or near {}", self.near()))
    }

    fn is_word(&self, w: &str) -> bool {
        self.peek() == Tok::Word(w.to_string())
    }

    fn is_op(&self, o: &str) -> bool {
        self.peek() == Tok::Op(o.to_string())
    }

    fn expect_word(&mut self, w: &str) -> Result<(), SqlError> {
        if !self.is_word(w) {
            return Err(self.syntax());
        }
        self.pos += 1;
        Ok(())
    }

    fn expect_op(&mut self, o: &str) -> Result<(), SqlError> {
        if !self.is_op(o) {
            return Err(self.syntax());
        }
        self.pos += 1;
        Ok(())
    }

    fn table(&mut self) -> Result<(), SqlError> {
        match self.peek() {
            Tok::Word(w) => {
                self.pos += 1;
                if w != "items" {
                    return Err(sql_error("42P01", format!("relation \"{}\" does not exist", w)));
                }
                Ok(())
            }
            _ => Err(self.syntax()),
        }
    }

    fn column(&mut self) -> Result<usize, SqlError> {
        match self.peek() {
            Tok::Word(w) => {
                self.pos += 1;
                match columns().iter().position(|(name, _)| *name == w) {
                    Some(i) => Ok(i),
                    None => Err(sql_error("42703", format!("column \"{}\" does not exist", w))),
                }
            }
            _ => Err(self.syntax()),
        }
    }

    fn value(&mut self) -> Result<Value, SqlError> {
        let v = match self.peek() {
            Tok::Num(n) => Value::Int(n),
            Tok::Str(s) => Value::Text(s),
            Tok::Word(w) if w == "null" => Value::Null,
            _ => return Err(self.syntax()),
        };
        self.pos += 1;
        Ok(v)
    }

    fn condition(&mut self) -> Result<Option<(usize, String, Value)>, SqlError> {
        if !self.is_word("where") {
            return Ok(None);
        }
        self.pos += 1;
        let col = self.column()?;
        let op = match self.peek() {
            Tok::Op(o) if ["=", "<", ">", "<=", ">=", "<>", "!="].contains(&o.as_str()) => o,
            _ => return Err(self.syntax()),
        };
        self.pos += 1;
        let v = self.value()?;
        Ok(Some((col, op, v)))
    }

    fn done(&self) -> Result<(), SqlError> {
        if self.peek() != Tok::End {
            return Err(self.syntax());
        }
        Ok(())
    }
}

fn matches(row: &Row, cond: &Option<(usize, String, Value)>) -> Result<bool, SqlError> {
    let (col, op, v) = match cond {
        None => return Ok(true),
        Some(c) => c,
    };
    let ord = match (&row[*col], v) {
        (Value::Null, _) | (_, Value::Null) => return Ok(false),
        (Value::Int(a), Value::Int(b)) => a.cmp(b),
        (Value::Text(a), Value::Text(b)) => a.cmp(b),
        (x, y) => {
            return Err(sql_error(
                "42883",
                format!("operator does not exist: {} {} {}", x.type_name(), op, y.type_name()),
            ))
        }
    };
    Ok(match op.as_str() {
        "=" => ord == Ordering::Equal,
        "<" => ord == Ordering::Less,
        ">" => ord == Ordering::Greater,
        "<=" => ord != Ordering::Greater,
        ">=" => ord != Ordering::Less,
        _ => ord != Ordering::Equal,
    })
}

fn check_types(values: &[Value]) -> Result<(), SqlError> {
    for ((name, oid), v) in columns().iter().zip(values.iter()) {
        match v {
            Value::Text(s) if *oid == INT4 => {
                return Err(sql_error("22P02", format!("invalid input syntax for type integer: \"{}\"", s)))
            }
            Value::Int(_) if *oid == TEXT => {
                return Err(sql_error(
                    "42804",
                    format!("column \"{}\" is of type text but expression is of type integer", name),
                ))
            }
            _ => {}
        }
    }
    Ok(())
}

fn filter(rows: &[Row], cond: &Option<(usize, String, Value)>) -> Result<Vec<Row>, SqlError> {
    let mut hits = Vec::new();
    for r in rows {
        if matches(r, cond)? {
            hits.push(r.clone());
        }
    }
    Ok(hits)
}

// Runs one statement against `rows`, returning the messages to send.
fn execute(rows: &mut Vec<Row>, sql: &str) -> Result<Vec<Vec<u8>>, SqlError> {
    let mut p = Parser { toks: tokens(sql)?, pos: 0 };
    if p.is_word("select") {
        p.pos += 1;
        let mut cols = Vec::new();
        if p.is_op("*") {
            p.pos += 1;
            cols = (0..columns().len()).collect();
        } else {
            cols.push(p.column()?);
            while p.is_op(",") {
                p.pos += 1;
                cols.push(p.column()?);
            }
        }
        p.expect_word("from")?;
        p.table()?;
        let cond = p.condition()?;
        let mut order = None;
        if p.is_word("order") {
            p.pos += 1;
            p.expect_word("by")?;
            order = Some(p.column()?);
        }
        p.done()?;
        let mut hits = filter(rows, &cond)?;
        if let Some(c) = order {
            hits.sort_by(|a, b| match (&a[c], &b[c]) {
                (Value::Null, Value::Null) => Ordering::Equal,
                (Value::Null, _) => Ordering::Greater,
                (_, Value::Null) => Ordering::Less,
                (Value::Int(x), Value::Int(y)) => x.cmp(y),
                (Value::Text(x), Value::Text(y)) => x.cmp(y),
                _ => Ordering::Equal,
            });
        }
        let all = columns();
        let described: Vec<(String, i32)> = cols.iter().map(|&c| all[c].clone()).collect();
        let mut out = vec![row_description(&described)];
        for r in &hits {
            let values: Vec<Value> = cols.iter().map(|&c| r[c].clone()).collect();
            out.push(data_row(&values));
        }
        out.push(complete(&format!("SELECT {}", hits.len())));
        return Ok(out);
    }
    if p.is_word("insert") {
        p.pos += 1;
        p.expect_word("into")?;
        p.table()?;
        p.expect_word("values")?;
        p.expect_op("(")?;
        let mut values = vec![p.value()?];
        while p.is_op(",") {
            p.pos += 1;
            values.push(p.value()?);
        }
        p.expect_op(")")?;
        p.done()?;
        if values.len() > columns().len() {
            return Err(sql_error("42601", "INSERT has more expressions than target columns".to_string()));
        }
        if values.len() < columns().len() {
            return Err(sql_error("42601", "INSERT has more target columns than expressions".to_string()));
        }
        check_types(&values)?;
        if values[0] != Value::Null && rows.iter().any(|r| r[0] == values[0]) {
            return Err(sql_error(
                "23505",
                "duplicate key value violates unique constraint \"items_pkey\"".to_string(),
            ));
        }
        rows.push(values);
        return Ok(vec![complete("INSERT 0 1")]);
    }
    if p.is_word("update") {
        p.pos += 1;
        p.table()?;
        p.expect_word("set")?;
        let col = p.column()?;
        p.expect_op("=")?;
        let v = p.value()?;
        let cond = p.condition()?;
        p.done()?;
        let mut probe = vec![Value::Null; columns().len()];
        probe[col] = v.clone();
        check_types(&probe)?;
        let mut n = 0;
        for r in rows.iter_mut() {
            if matches(r, &cond)? {
                r[col] = v.clone();
                n += 1;
            }
        }
        return Ok(vec![complete(&format!("UPDATE {}", n))]);
    }
    if p.is_word("delete") {
        p.pos += 1;
        p.expect_word("from")?;
        p.table()?;
        let cond = p.condition()?;
        p.done()?;
        let mut keep = Vec::new();
        for r in rows.iter() {
            if !matches(r, &cond)? {
                keep.push(r.clone());
            }
        }
        let n = rows.len() - keep.len();
        *rows = keep;
        return Ok(vec![complete(&format!("DELETE {}", n))]);
    }
    Err(p.syntax())
}

// ------------------------------------------------------------ the server

struct Session {
    snapshot: Option<Vec<Row>>,
    failed: bool,
}

impl Session {
    fn status(&self) -> u8 {
        match (&self.snapshot, self.failed) {
            (None, _) => b'I',
            (Some(_), true) => b'E',
            (Some(_), false) => b'T',
        }
    }
}

fn run_query(st: &mut State, s: &mut Session, text: &str) -> Vec<Vec<u8>> {
    let mut out = Vec::new();
    let stmts: Vec<&str> = text.split(';').map(|q| q.trim()).collect();
    if stmts.iter().all(|q| q.is_empty()) {
        return vec![msg(b'I', &[])];
    }
    for q in stmts {
        if q.is_empty() {
            continue;
        }
        let word = q.split_whitespace().next().unwrap().to_lowercase();
        if s.failed && word != "rollback" && word != "commit" {
            out.push(error(
                "25P02",
                "current transaction is aborted, commands ignored until end of transaction block",
            ));
            return out;
        }
        if word == "begin" {
            if s.snapshot.is_some() {
                out.push(notice("25001", "there is already a transaction in progress"));
            } else {
                s.snapshot = Some(st.rows.clone());
            }
            out.push(complete("BEGIN"));
            continue;
        }
        if word == "commit" || word == "rollback" {
            match s.snapshot.take() {
                None => {
                    out.push(notice("25P01", "there is no transaction in progress"));
                    out.push(complete(&word.to_uppercase()));
                }
                Some(rows) => {
                    if word == "commit" && !s.failed {
                        st.rows = rows;
                        out.push(complete("COMMIT"));
                    } else {
                        out.push(complete("ROLLBACK"));
                    }
                }
            }
            s.failed = false;
            continue;
        }
        let in_tx = s.snapshot.is_some();
        let mut rows = match &s.snapshot {
            Some(r) => r.clone(),
            None => st.rows.clone(),
        };
        match execute(&mut rows, q) {
            Ok(msgs) => out.extend(msgs),
            Err(e) => {
                out.push(error(&e.code, &e.text));
                if in_tx {
                    s.failed = true;
                }
                return out;
            }
        }
        if in_tx {
            s.snapshot = Some(rows);
        } else {
            st.rows = rows;
        }
    }
    out
}

fn read_message(r: &mut BufReader<TcpStream>) -> Option<(u8, Vec<u8>)> {
    let mut head = [0u8; 5];
    if r.read_exact(&mut head).is_err() {
        return None;
    }
    let n = be_i32(&head[1..5]) as usize;
    let mut body = vec![0u8; n - 4];
    if r.read_exact(&mut body).is_err() {
        return None;
    }
    Some((head[0], body))
}

fn serve(db: &Db, conn: TcpStream) {
    let out = conn.try_clone().unwrap();
    let mut r = BufReader::new(conn);
    let mut head = [0u8; 8];
    if r.read_exact(&mut head).is_err() {
        return;
    }
    let length = be_i32(&head[0..4]) as usize;
    let proto = be_i32(&head[4..8]);
    let mut body = vec![0u8; length - 8];
    if r.read_exact(&mut body).is_err() {
        return;
    }
    let parts: Vec<String> = body
        .split(|&b| b == 0)
        .map(|p| String::from_utf8(p.to_vec()).unwrap())
        .collect();
    let mut user = String::new();
    let mut i = 0;
    while i + 1 < parts.len() {
        if parts[i] == "user" {
            user = parts[i + 1].clone();
        }
        i += 2;
    }
    if proto != 196608 {
        let _ = out.write_all(&error(
            "0A000",
            &format!("unsupported frontend protocol {}.{}", proto >> 16, proto & 0xFFFF),
        ));
        return;
    }
    let _ = out.write_all(&msg(b'R', &3i32.to_be_bytes()));
    let (tag, pw) = match read_message(&mut r) {
        None => return,
        Some(m) => m,
    };
    let password = String::from_utf8(pw[..pw.len() - 1].to_vec()).unwrap();
    if tag != b'p' || password_of(&user) != Some(password) {
        let _ = out.write_all(&error(
            "28P01",
            &format!("password authentication failed for user \"{}\"", user),
        ));
        return;
    }
    let pid = {
        let mut g = db.state.lock();
        let pid = g.value.next_pid;
        g.value.next_pid += 1;
        pid
    };
    let mut hello = msg(b'R', &0i32.to_be_bytes());
    let mut p1 = Vec::new();
    cstr(&mut p1, "server_version");
    cstr(&mut p1, "16.0-kara");
    hello.extend(msg(b'S', &p1));
    let mut p2 = Vec::new();
    cstr(&mut p2, "client_encoding");
    cstr(&mut p2, "UTF8");
    hello.extend(msg(b'S', &p2));
    let mut key = pid.to_be_bytes().to_vec();
    key.extend_from_slice(&(pid * 7919 % 65536).to_be_bytes());
    hello.extend(msg(b'K', &key));
    hello.extend(ready(b'I'));
    let _ = out.write_all(&hello);
    let mut s = Session { snapshot: None, failed: false };
    loop {
        let (tag, body) = match read_message(&mut r) {
            None => break,
            Some(m) => m,
        };
        if tag == b'X' {
            break;
        }
        let mut reply = Vec::new();
        if tag != b'Q' {
            reply.extend(error("08P01", &format!("unsupported message type '{}'", tag as char)));
        } else {
            let text = String::from_utf8(body[..body.len() - 1].to_vec()).unwrap();
            let mut g = db.state.lock();
            g.value.queries += 1;
            for m in run_query(&mut g.value, &mut s, &text) {
                reply.extend(m);
            }
        }
        reply.extend(ready(s.status()));
        let _ = out.write_all(&reply);
    }
}

fn run_server(db: &Db, listener: TcpListener) {
    let tasks = TaskGroup::new();
    for _ in 0..SESSIONS {
        let conn = listener.accept().unwrap();
        tasks.spawn(|| serve(db, conn));
    }
}

// ------------------------------------------------------------ the clients

struct Client {
    name: String,
    sock: TcpStream,
    r: BufReader<TcpStream>,
}

fn fields_text(body: &[u8]) -> String {
    let mut out = Vec::new();
    for part in body.split(|&b| b == 0) {
        if !part.is_empty() {
            let text = String::from_utf8(part[1..].to_vec()).unwrap();
            out.push(format!("{}={}", part[0] as char, text));
        }
    }
    out.join(" ")
}

fn cstring_at(body: &[u8], at: usize) -> (String, usize) {
    let mut end = at;
    while body[end] != 0 {
        end += 1;
    }
    (String::from_utf8(body[at..end].to_vec()).unwrap(), end + 1)
}

impl Client {
    fn connect(name: &str) -> Client {
        let sock = TcpStream::connect(ADDR).unwrap();
        let _ = sock.set_read_timeout(Some(2000));
        Client { name: name.to_string(), r: BufReader::new(sock.try_clone().unwrap()), sock }
    }

    fn say(&self, line: &str) {
        println!("{} {}", self.name, line);
    }

    // Prints every message up to ReadyForQuery or the close, and returns
    // the ReadyForQuery status ('R' when the server asked for a password,
    // and an empty string when it closed).
    fn drain(&mut self) -> String {
        loop {
            let (tag, body) = match read_message(&mut self.r) {
                None => {
                    self.say("<- (closed)");
                    return String::new();
                }
                Some(m) => m,
            };
            match tag {
                b'R' => {
                    let code = be_i32(&body[0..4]);
                    let what = match code {
                        0 => "ok".to_string(),
                        3 => "cleartext password".to_string(),
                        n => n.to_string(),
                    };
                    self.say(&format!("<- Authentication {}", what));
                    if code == 3 {
                        return "R".to_string();
                    }
                }
                b'S' => {
                    let (k, at) = cstring_at(&body, 0);
                    let (v, _) = cstring_at(&body, at);
                    self.say(&format!("<- ParameterStatus {}={}", k, v));
                }
                b'K' => {
                    self.say(&format!("<- BackendKeyData pid={} key={}", be_i32(&body[0..4]), be_i32(&body[4..8])));
                }
                b'Z' => {
                    let st = (body[0] as char).to_string();
                    self.say(&format!("<- ReadyForQuery {}", st));
                    return st;
                }
                b'T' => {
                    let n = be_i16(&body[0..2]);
                    let mut at = 2;
                    let mut cols = Vec::new();
                    for _ in 0..n {
                        let (name, end) = cstring_at(&body, at);
                        let oid = be_i32(&body[end + 6..end + 10]);
                        let size = be_i16(&body[end + 10..end + 12]);
                        let ty = match oid {
                            INT4 => "int4".to_string(),
                            TEXT => "text".to_string(),
                            o => o.to_string(),
                        };
                        cols.push(format!("{}:{}/{}", name, ty, size));
                        at = end + 18;
                    }
                    self.say(&format!("<- RowDescription {}", cols.join(" ")));
                }
                b'D' => {
                    let n = be_i16(&body[0..2]);
                    let mut at = 2;
                    let mut vals = Vec::new();
                    for _ in 0..n {
                        let size = be_i32(&body[at..at + 4]);
                        at += 4;
                        if size < 0 {
                            vals.push("NULL".to_string());
                        } else {
                            let end = at + size as usize;
                            vals.push(String::from_utf8(body[at..end].to_vec()).unwrap());
                            at = end;
                        }
                    }
                    self.say(&format!("<- DataRow {}", vals.join(" | ")));
                }
                b'C' => {
                    let (t, _) = cstring_at(&body, 0);
                    self.say(&format!("<- CommandComplete {}", t));
                }
                b'I' => self.say("<- EmptyQueryResponse"),
                b'E' => self.say(&format!("<- ErrorResponse {}", fields_text(&body))),
                b'N' => self.say(&format!("<- NoticeResponse {}", fields_text(&body))),
                t => self.say(&format!("<- {} ({} bytes)", t as char, body.len())),
            }
        }
    }

    fn startup(&mut self, user: &str, password: &str, proto: i32) -> bool {
        let mut params = Vec::new();
        cstr(&mut params, "user");
        cstr(&mut params, user);
        cstr(&mut params, "database");
        cstr(&mut params, "shop");
        params.push(0);
        self.say(&format!("-> StartupMessage user={} protocol={}.{}", user, proto >> 16, proto & 0xFFFF));
        let mut packet = ((params.len() + 8) as i32).to_be_bytes().to_vec();
        packet.extend_from_slice(&proto.to_be_bytes());
        packet.extend(params);
        let _ = self.sock.write_all(&packet);
        if self.drain() != "R" {
            return false;
        }
        self.say("-> PasswordMessage");
        let mut body = Vec::new();
        cstr(&mut body, password);
        let _ = self.sock.write_all(&msg(b'p', &body));
        !self.drain().is_empty()
    }

    fn query(&mut self, sql: &str) {
        self.say(&format!("-> Query {}", sql));
        let mut body = Vec::new();
        cstr(&mut body, sql);
        let _ = self.sock.write_all(&msg(b'Q', &body));
        self.drain();
    }

    fn raw(&mut self, tag: u8, body: &[u8]) {
        self.say(&format!("-> {} ({} bytes)", tag as char, body.len()));
        let _ = self.sock.write_all(&msg(tag, body));
        self.drain();
    }

    fn terminate(&mut self) {
        self.say("-> Terminate");
        let _ = self.sock.write_all(&msg(b'X', &[]));
        if read_message(&mut self.r).is_none() {
            self.say("<- (closed)");
        }
    }
}

fn main() {
    let listener = TcpListener::bind(ADDR).unwrap();
    let db = Db {
        state: Mutex::new(State { rows: seed(), next_pid: 1001, queries: 0 }),
    };
    let group = TaskGroup::new();
    group.spawn(|| run_server(&db, listener));

    println!("== session 1: a wrong password");
    let mut m = Client::connect("mallory");
    m.startup("alice", "guess", 196608);
    drop(m);

    println!("== session 2: an unsupported protocol version");
    let mut o = Client::connect("old");
    o.startup("alice", "wonder", 131072);
    drop(o);

    println!("== session 3: alice queries and writes");
    let mut a = Client::connect("alice");
    a.startup("alice", "wonder", 196608);
    a.query("SELECT * FROM items");
    a.query("SELECT name, qty FROM items WHERE qty > 3 ORDER BY qty");
    a.query("INSERT INTO items VALUES (4, 'dragon''s fruit', 7)");
    a.query("INSERT INTO items VALUES (5, NULL, 1); SELECT id, name FROM items WHERE id >= 4");
    a.query("INSERT INTO items VALUES (4, 'again', 1)");
    a.query("INSERT INTO items VALUES (6, 'fig')");
    a.query("INSERT INTO items VALUES ('six', 'fig', 1)");
    a.query("UPDATE items SET qty = 9 WHERE name = 'apple'");
    a.query("UPDATE items SET name = 3 WHERE id = 1");
    a.query("DELETE FROM items WHERE qty = 0");
    a.query("SELECT price FROM items");
    a.query("SELECT * FROM orders");
    a.query("SELEC * FROM items");
    a.query("SELECT * FROM items WHERE name = 'x");
    a.query("SELECT * FROM items WHERE qty = 'many'");
    a.query("");
    a.query(" ; ");
    let mut parse = Vec::new();
    cstr(&mut parse, "");
    cstr(&mut parse, "SELECT 1");
    parse.extend_from_slice(&[0, 0]);
    a.raw(b'P', &parse);

    println!("== session 4: bob's transaction while alice reads");
    let mut b = Client::connect("bob");
    b.startup("bob", "builder", 196608);
    b.query("BEGIN");
    b.query("UPDATE items SET qty = 100 WHERE id = 2");
    b.query("INSERT INTO items VALUES (7, 'grape', 30)");
    b.query("SELECT id, qty FROM items ORDER BY id");
    a.query("SELECT id, qty FROM items ORDER BY id");
    b.query("BEGIN");
    b.query("COMMIT");
    a.query("SELECT id, qty FROM items ORDER BY id");
    b.query("BEGIN; DELETE FROM items WHERE id = 1; SELECT * FROM nowhere; SELECT 1");
    b.query("SELECT * FROM items");
    b.query("ROLLBACK");
    b.query("COMMIT");
    b.query("SELECT count FROM items");
    b.query("SELECT * FROM items ORDER BY name");
    b.terminate();
    a.terminate();
    drop(b);
    drop(a);

    drop(group);
    let g = db.state.lock();
    println!("== server: {} queries, {} rows", g.value.queries, g.value.rows.len());
    let mut rows = g.value.rows.clone();
    rows.sort_by_key(|r| match r[0] {
        Value::Int(n) => n,
        _ => 0,
    });
    for r in &rows {
        let shown: Vec<String> = r.iter().map(|v| v.render().unwrap_or("NULL".to_string())).collect();
        println!("{}", shown.join(" | "));
    }
}
