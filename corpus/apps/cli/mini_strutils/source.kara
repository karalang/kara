    s.push_str("u2c\tfoo__bar\n");
    s.push_str("u2c\t\n");
    s.push_str("u2c\tUPPER_CASE\n");
    s.push_str("u2c\ttrailing_\n");
    s.push_str("ord\t0\n");
    s.push_str("ord\t1\n");
    s.push_str("ord\t2\n");
    s.push_str("ord\t3\n");
    s.push_str("ord\t4\n");
    s.push_str("ord\t5\n");
    s.push_str("ord\t11\n");
    s.push_str("ord\t12\n");
    s.push_str("ord\t13\n");
    s.push_str("ord\t21\n");
    s.push_str("ord\t22\n");
    s.push_str("ord\t23\n");
    s.push_str("ord\t100\n");
    s.push_str("ord\t101\n");
    s.push_str("ord\t111\n");
    s.push_str("ord\t1515\n");
    s.push_str("ord\t3694839230\n");
