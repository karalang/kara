> !sanitize snippets.txt
  '<p>Hello <b>world</b></p>'
    => '<p>Hello <b>world</b></p>'
  '<script>alert("x")</script><p>after</p>'
    => '<p>after</p>'
  '<a href="javascript:alert(1)" title="t">link</a>'
    => '<a href="" title="t">link</a>'
  '<a href="http://ok.example.com/" target="_blank" rel="Nofollow">ok</a>'
    => '<a href="http://ok.example.com/" rel="nofollow" target="_blank">ok</a>'
  '<div style="color: blue; background: url(http://x/y.png) red; margin: 0 auto">styled</div>'
    => '<div style="color: blue; background: red; margin: 0 auto;">styled</div>'
  '<span style="font-weight: bold; behavior: url(x.htc)">b</span>'
    => '<span style="font-weight: bold;">b</span>'
  '<img src="x.png" onerror="evil()" width="10">'
    => '<img src="x.png" width="10" />'
  '<!-- a comment --><p>text</p><?php echo 1 ?>'
    => '<!-- a comment --><p>text</p>'
  '<table><tr><td colspan="2">cell</td></tr></table>'
    => '<table><tr><td colspan="2">cell</td></tr></table>'
  '<p>5 &lt; 6 &amp;&amp; 7 &gt; 3 &nbsp; &bogus; &#169; &#x41; &#150;</p>'
    => '<p>5 &lt; 6 &amp;&amp; 7 &gt; 3 &nbsp; &amp;bogus &#169; &#x41; &#x2013;</p>'
  '<object data="movie.swf"><param name="a" value="b"></object>text'
    => 'text'
  '<br/><hr/><p/>end'
    => '<br /><hr /><p></p>end'
  '<style>body{display:none}</style>visible'
    => 'visible'
  '<p>unclosed <b>bold <i>italic'
    => '<p>unclosed <b>bold <i>italic'
  '<A HREF="/Upper" CLASS="x">CAPS</A>'
    => '<a class="x" href="/Upper">CAPS</a>'
  '<form action="/f"><input type="TEXT" name="q"></form>'
    => '<form action="/f"><input name="q" type="text" /></form>'
  "<p title='single' id=plain>attrs</p>"
    => '<p id="plain" title="single">attrs</p>'
  '<applet code="x"></applet>after applet'
    => 'after applet'
  '<p>line one\r\nline two</p>'
    => '<p>line one\nline two</p>'
  '<![CDATA[raw]]> and <!-- unterminated'
    => '&lt;![CDATA[raw]]> and'
> !resolve snippets.txt http://site.example.org/a/b/
  '<p>Hello <b>world</b></p>'
    => '<p>Hello <b>world</b></p>'
  '<script>alert("x")</script><p>after</p>'
    => '<script>alert("x")</script><p>after</p>'
  '<a href="javascript:alert(1)" title="t">link</a>'
    => '<a href="javascript:alert(1)" title="t">link</a>'
  '<a href="http://ok.example.com/" target="_blank" rel="Nofollow">ok</a>'
    => '<a href="http://ok.example.com/" rel="nofollow" target="_blank">ok</a>'
  '<div style="color: blue; background: url(http://x/y.png) red; margin: 0 auto">styled</div>'
    => '<div style="color: blue; background: url(http://x/y.png) red; margin: 0 auto">styled</div>'
  '<span style="font-weight: bold; behavior: url(x.htc)">b</span>'
    => '<span style="font-weight: bold; behavior: url(x.htc)">b</span>'
  '<img src="x.png" onerror="evil()" width="10">'
    => '<img onerror="evil()" src="http://site.example.org/a/b/x.png" width="10" />'
  '<!-- a comment --><p>text</p><?php echo 1 ?>'
    => '<!-- a comment --><p>text</p><?php echo 1 ?>'
  '<table><tr><td colspan="2">cell</td></tr></table>'
    => '<table><tr><td colspan="2">cell</td></tr></table>'
  '<p>5 &lt; 6 &amp;&amp; 7 &gt; 3 &nbsp; &bogus; &#169; &#x41; &#150;</p>'
    => '<p>5 &lt; 6 &amp;&amp; 7 &gt; 3 &nbsp; &amp;bogus &#169; &#x41; &#x2013;</p>'
  '<object data="movie.swf"><param name="a" value="b"></object>text'
    => '<object data="http://site.example.org/a/b/movie.swf"><param name="a" value="b" /></object>text'
  '<br/><hr/><p/>end'
    => '<br /><hr /><p></p>end'
  '<style>body{display:none}</style>visible'
    => '<style>body{display:none}</style>visible'
  '<p>unclosed <b>bold <i>italic'
    => '<p>unclosed <b>bold <i>italic'
  '<A HREF="/Upper" CLASS="x">CAPS</A>'
    => '<a class="x" href="http://site.example.org/Upper">CAPS</a>'
  '<form action="/f"><input type="TEXT" name="q"></form>'
    => '<form action="http://site.example.org/f"><input name="q" type="text" /></form>'
  "<p title='single' id=plain>attrs</p>"
    => '<p id="plain" title="single">attrs</p>'
  '<applet code="x"></applet>after applet'
    => '<applet code="x"></applet>after applet'
  '<p>line one\r\nline two</p>'
    => '<p>line one\r\nline two</p>'
