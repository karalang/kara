// mini_feedparser: a port of feedparser 6.0.11 (BSD-2) with sgmllib3k 1.0.0 (BSD).
fn byte_str(b: ref Vec[u8], from: i64, to: i64) -> String {
    let mut v: Vec[u8] = Vec.new();
    // clamped like a Python slice
    let hi = if to > b.len() as i64 { b.len() as i64 } else { to };
    for i in from..hi {
        v.push(b[i]);
    }
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn to_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn from_bytes(v: Vec[u8]) -> String {
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn is_alpha(c: u8) -> bool {
    (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z')
}

fn is_alnum(c: u8) -> bool {
    is_digit(c) or is_alpha(c)
}

// A word character, as `\w` and `\b` see it.
fn is_word(c: u8) -> bool {
    is_alnum(c) or c == b'_' or c >= 128
}

// White space, as `\s` and str.strip see it.
fn is_ws(c: u8) -> bool {
    c == b' ' or c == b'\t' or c == b'\n' or c == b'\r' or c == 11 or c == 12
}

fn lower_byte(c: u8) -> u8 {
    if c >= b'A' and c <= b'Z' { c + 32 } else { c }
}

fn lower(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        out.push(lower_byte(b[i]));
    }
    from_bytes(out)
}

fn strip(s: Str) -> String {
    let b = to_bytes(s);
    let mut i: i64 = 0;
    let mut j = b.len();
    while i < j and is_ws(b[i]) {
        i += 1;
    }
    while j > i and is_ws(b[j - 1]) {
        j -= 1;
    }
    byte_str(b, i, j)
}

fn split_ws(s: Str) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        while i < b.len() and is_ws(b[i]) {
            i += 1;
        }
        let st = i;
        while i < b.len() and not is_ws(b[i]) {
            i += 1;
        }
        if i > st {
            out.push(byte_str(b, st, i));
        }
    }
    out
}

fn split_on(s: Str, sep: u8) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut st: i64 = 0;
    for i in 0..b.len() {
        if b[i] == sep {
            out.push(byte_str(b, st, i));
            st = i + 1;
        }
    }
    out.push(byte_str(b, st, b.len()));
    out
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

// The lines of a file, without their newlines.
fn lines_of(text: Str) -> Vec[String] {
    let mut v = split_on(text, b'\n');
    if v.len() > 0 and v[v.len() - 1].len() == 0 {
        v.pop();
    }
    v
}

fn contains_str(v: ref Vec[String], s: Str) -> bool {
    for i in 0..v.len() {
        if v[i] == s {
            return true;
        }
    }
    false
}

// A stable sort of strings.
fn sort_strings(v: own Vec[String]) -> Vec[String] {
    let mut v = v;
    for i in 1..v.len() {
        let mut j = i;
        while j > 0 and v[j - 1] > v[j] {
            v.swap(j - 1, j);
            j -= 1;
        }
    }
    v
}

// Python's repr of a str.
fn py_repr(s: Str) -> String {
    let b = to_bytes(s);
    let mut has_single = false;
    let mut has_double = false;
    for i in 0..b.len() {
        if b[i] == b'\'' {
            has_single = true;
        }
        if b[i] == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let hex = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    out.push(q);
    let mut skip = false;
    for i in 0..b.len() {
        let c = b[i];
        if skip {
            skip = false;
            continue;
        }
        // U+0080 to U+00A0 and U+00AD are not printable either
        let next: u8 = if i + 1 < b.len() { b[i + 1] } else { 0 };
        if c == 0xC2 and next >= 0x80 and (next <= 0xA0 or next == 0xAD) {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(next / 16) as i64]);
            out.push(hex[(next % 16) as i64]);
            skip = true;
        } else if c == q or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c < 32 or c == 127 {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    from_bytes(out)
}


fn upper(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        let c = b[i];
        out.push(if c >= b'a' and c <= b'z' { c - 32 } else { c });
    }
    from_bytes(out)
}

// Whether `pat` occurs in `b` at `i`.
fn starts_at(b: ref Vec[u8], i: i64, pat: Str) -> bool {
    let p = to_bytes(pat);
    if i < 0 or i + p.len() > b.len() {
        return false;
    }
    for k in 0..p.len() {
        if b[i + k] != p[k] {
            return false;
        }
    }
    true
}

fn starts_with(s: Str, pat: Str) -> bool {
    starts_at(to_bytes(s), 0, pat)
}

fn find_str(s: Str, pat: Str) -> i64 {
    let b = to_bytes(s);
    for i in 0..b.len() + 1 {
        if starts_at(b, i, pat) {
            return i;
        }
    }
    -1
}

fn first_byte(s: Str) -> u8 {
    let b = to_bytes(s);
    if b.len() > 0 { b[0] } else { 0 }
}

fn byte_at(s: Str, i: i64) -> u8 {
    let b = to_bytes(s);
    if i >= 0 and i < b.len() { b[i] } else { 0 }
}

fn slice_from(s: Str, i: i64) -> String {
    let b = to_bytes(s);
    byte_str(b, i, b.len())
}

fn spaces(n: i64) -> String {
    let mut out = String.new();
    for _ in 0..n {
        out.push_str(" ");
    }
    out
}


// ------------------------------------------------------------ more text

fn is_hex(c: u8) -> bool {
    is_digit(c) or (c >= b'a' and c <= b'f') or (c >= b'A' and c <= b'F')
}

fn hex_val(c: u8) -> u8 {
    if is_digit(c) {
        c - b'0'
    } else if c >= b'a' and c <= b'f' {
        c - b'a' + 10
    } else {
        c - b'A' + 10
    }
}

fn find_byte(s: Str, c: u8) -> i64 {
    let b = to_bytes(s);
    for i in 0..b.len() {
        if b[i] == c {
            return i;
        }
    }
    -1
}

fn rfind_byte(s: Str, c: u8) -> i64 {
    let b = to_bytes(s);
    let mut i = b.len() - 1;
    while i >= 0 {
        if b[i] == c {
            return i;
        }
        i -= 1;
    }
    -1
}

fn has_byte(s: Str, c: u8) -> bool {
    find_byte(s, c) >= 0
}

fn slice(s: Str, from: i64, to: i64) -> String {
    byte_str(to_bytes(s), from, to)
}

// str.partition and str.rpartition on one byte: (before, found, after).
fn partition(s: Str, c: u8) -> (String, bool, String) {
    let i = find_byte(s, c);
    if i < 0 {
        return (s.to_string(), false, String.new());
    }
    (slice(s, 0, i), true, slice_from(s, i + 1))
}

fn rpartition(s: Str, c: u8) -> (String, bool, String) {
    let i = rfind_byte(s, c);
    if i < 0 {
        return (String.new(), false, s.to_string());
    }
    (slice(s, 0, i), true, slice_from(s, i + 1))
}

fn replace_byte(s: Str, c: u8, with: Str) -> String {
    let b = to_bytes(s);
    let w = to_bytes(with);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        if b[i] == c {
            for k in 0..w.len() {
                out.push(w[k]);
            }
        } else {
            out.push(b[i]);
        }
    }
    from_bytes(out)
}

fn opt_repr(v: ref Option[String]) -> String {
    match v {
        Some(s) => py_repr(s),
        None => "None".to_string(),
    }
}

// The data files spell tabs, line ends and control characters as \t,
// \n, \r and \xNN.
fn unescape(line: Str) -> String {
    let b = to_bytes(line);
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let c = b[i];
        if c == b'\\' and i + 1 < b.len() {
            let n = b[i + 1];
            if n == b't' {
                out.push(b'\t');
                i += 2;
                continue;
            }
            if n == b'n' {
                out.push(b'\n');
                i += 2;
                continue;
            }
            if n == b'r' {
                out.push(b'\r');
                i += 2;
                continue;
            }
            if n == b'\\' {
                out.push(b'\\');
                i += 2;
                continue;
            }
            if n == b'x' and i + 3 < b.len() {
                out.push(hex_val(b[i + 2]) * 16 + hex_val(b[i + 3]));
                i += 4;
                continue;
            }
        }
        out.push(c);
        i += 1;
    }
    from_bytes(out)
}

fn push_str_bytes(out: mut ref Vec[u8], s: Str) {
    let b = to_bytes(s);
    for i in 0..b.len() {
        out.push(b[i]);
    }
}

// bytes.decode('utf-8', 'replace'): each maximal ill-formed subpart
// becomes one U+FFFD, as CPython's decoder does it.
fn utf8_replace(b: ref Vec[u8]) -> String {
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let c = b[i];
        if c < 0x80 {
            out.push(c);
            i += 1;
            continue;
        }
        let mut need: i64 = 0;
        let mut lo: u8 = 0x80;
        let mut hi: u8 = 0xBF;
        if c >= 0xC2 and c <= 0xDF {
            need = 1;
        } else if c >= 0xE0 and c <= 0xEF {
            need = 2;
            if c == 0xE0 {
                lo = 0xA0;
            }
            if c == 0xED {
                hi = 0x9F;
            }
        } else if c >= 0xF0 and c <= 0xF4 {
            need = 3;
            if c == 0xF0 {
                lo = 0x90;
            }
            if c == 0xF4 {
                hi = 0x8F;
            }
        }
        if need == 0 {
            push_str_bytes(mut out, "\u{FFFD}");
            i += 1;
            continue;
        }
        let mut j = i + 1;
        let mut ok = true;
        for k in 0..need {
            if j >= b.len() {
                ok = false;
                break;
            }
            let d = b[j];
            let (l, h) = if k == 0 { (lo, hi) } else { (0x80 as u8, 0xBF as u8) };
            if d < l or d > h {
                ok = false;
                break;
            }
            j += 1;
        }
        if ok {
            for k in i..j {
                out.push(b[k]);
            }
        } else {
            push_str_bytes(mut out, "\u{FFFD}");
        }
        i = j;
    }
    from_bytes(out)
}

// A stable sort of (name, count) pairs: the highest count first, then
// by name.
fn sort_counts(names: ref Vec[String], counts: ref Vec[i64]) -> Vec[i64] {
    let mut order: Vec[i64] = Vec.new();
    for i in 0..names.len() {
        order.push(i);
    }
    for i in 1..order.len() {
        let mut j = i;
        while j > 0 {
            let a = order[j - 1];
            let b = order[j];
            let after = counts[a] < counts[b] or (counts[a] == counts[b] and names[a] > names[b]);
            if not after {
                break;
            }
            order.swap(j - 1, j);
            j -= 1;
        }
    }
    order
}

fn bump(names: mut ref Vec[String], counts: mut ref Vec[i64], name: Str) {
    for i in 0..names.len() {
        if names[i] == name {
            counts[i] += 1;
            return;
        }
    }
    names.push(name.to_string());
    counts.push(1);
}

// ------------------------------------------------------------ ipaddress

// IPv4Address's parser: four decimal octets, no leading zeros.
fn is_ipv4(s: Str) -> bool {
    let parts = split_on(s, b'.');
    if parts.len() != 4 {
        return false;
    }
    for i in 0..parts.len() {
        let b = to_bytes(parts[i]);
        if b.len() == 0 or b.len() > 3 {
            return false;
        }
        let mut n: i64 = 0;
        for k in 0..b.len() {
            if not is_digit(b[k]) {
                return false;
            }
            n = n * 10 + (b[k] - b'0') as i64;
        }
        if n > 255 or (b.len() > 1 and b[0] == b'0') {
            return false;
        }
    }
    true
}

fn is_hextet(s: Str) -> bool {
    let b = to_bytes(s);
    if b.len() == 0 or b.len() > 4 {
        return false;
    }
    for k in 0..b.len() {
        if not is_hex(b[k]) {
            return false;
        }
    }
    true
}

// IPv6Address's parser: at most one `::`, eight hextets in all, an IPv4
// tail, and a `%scope`.
fn is_ipv6(s: Str) -> bool {
    let (addr, has_scope, scope) = partition(s, b'%');
    if has_scope and (scope.len() == 0 or has_byte(scope, b'%')) {
        return false;
    }
    let mut parts = split_on(addr, b':');
    if parts.len() < 3 {
        return false;
    }
    let last = parts[parts.len() - 1].clone();
    if has_byte(last, b'.') {
        if not is_ipv4(last) {
            return false;
        }
        parts.pop();
        parts.push("0".to_string());
        parts.push("0".to_string());
    }
    if parts.len() > 9 {
        return false;
    }
    let n = parts.len();
    let mut skip: i64 = -1;
    for i in 1..n - 1 {
        if parts[i].len() == 0 {
            if skip >= 0 {
                return false;
            }
            skip = i;
        }
    }
    let mut hi = n;
    let mut lo: i64 = 0;
    if skip >= 0 {
        hi = skip;
        lo = n - skip - 1;
        if parts[0].len() == 0 {
            hi -= 1;
            if hi > 0 {
                return false;
            }
        }
        if parts[n - 1].len() == 0 {
            lo -= 1;
            if lo > 0 {
                return false;
            }
        }
        if 8 - (hi + lo) < 1 {
            return false;
        }
    } else if n != 8 or parts[0].len() == 0 or parts[n - 1].len() == 0 {
        return false;
    }
    for i in 0..hi {
        if not is_hextet(parts[i]) {
            return false;
        }
    }
    for i in n - lo..n {
        if not is_hextet(parts[i]) {
            return false;
        }
    }
    true
}

// urllib.parse's _check_bracketed_host.
fn check_bracketed_host(host: Str) -> Result[(), String] {
    let b = to_bytes(host);
    if b.len() > 0 and (b[0] == b'v' or b[0] == b'V') {
        // \A[vV][a-fA-F0-9]+\..+\Z
        let mut i: i64 = 1;
        while i < b.len() and is_hex(b[i]) {
            i += 1;
        }
        if i == 1 or i >= b.len() or b[i] != b'.' or i + 1 >= b.len() {
            return Err("IPvFuture address is invalid".to_string());
        }
        return Ok(());
    }
    if is_ipv4(host) {
        return Err("An IPv4 address cannot be in brackets".to_string());
    }
    if not is_ipv6(host) {
        return Err(f"{py_repr(host)} does not appear to be an IPv4 or IPv6 address");
    }
    Ok(())
}

// ------------------------------------------------------------ split and parse

fn uses_relative(s: Str) -> bool {
    contains_str(["", "ftp", "http", "gopher", "nntp", "imap", "wais", "file", "https", "shttp", "mms", "prospero", "rtsp", "rtsps", "rtspu", "sftp", "svn", "svn+ssh", "ws", "wss"], s)
}

fn uses_netloc(s: Str) -> bool {
    contains_str(["", "ftp", "http", "gopher", "nntp", "telnet", "imap", "wais", "file", "mms", "https", "shttp", "snews", "prospero", "rtsp", "rtsps", "rtspu", "rsync", "svn", "svn+ssh", "sftp", "nfs", "git", "git+ssh", "ws", "wss", "itms-services"], s)
}

fn uses_params(s: Str) -> bool {
    contains_str(["", "ftp", "hdl", "prospero", "http", "imap", "https", "shttp", "rtsp", "rtsps", "rtspu", "sip", "sips", "mms", "sftp", "tel"], s)
}

fn is_scheme_char(c: u8) -> bool {
    is_alnum(c) or c == b'+' or c == b'-' or c == b'.'
}

#[derive(Clone)]
struct Split {
    scheme: String,
    netloc: String,
    path: String,
    query: String,
    fragment: String,
}

#[derive(Clone)]
struct Parsed {
    scheme: String,
    netloc: String,
    path: String,
    params: String,
    query: String,
    fragment: String,
}

impl Split {
    fn repr(ref self) -> String {
        f"SplitResult(scheme={py_repr(self.scheme)}, netloc={py_repr(self.netloc)}, path={py_repr(self.path)}, query={py_repr(self.query)}, fragment={py_repr(self.fragment)})"
    }

    // _userinfo
    fn username(ref self) -> Option[String] {
        let (userinfo, have_info, _) = rpartition(self.netloc, b'@');
        if not have_info {
            return None;
        }
        let (user, _, _) = partition(userinfo, b':');
        Some(user)
    }

    fn password(ref self) -> Option[String] {
        let (userinfo, have_info, _) = rpartition(self.netloc, b'@');
        if not have_info {
            return None;
        }
        let (_, have_password, password) = partition(userinfo, b':');
        if have_password { Some(password) } else { None }
    }

    // _hostinfo: the host and the port as written.
    fn hostinfo(ref self) -> (String, Option[String]) {
        let (_, _, hostinfo) = rpartition(self.netloc, b'@');
        let (_, have_open_br, bracketed) = partition(hostinfo, b'[');
        let mut host = String.new();
        let mut port = String.new();
        if have_open_br {
            let (h, _, rest) = partition(bracketed, b']');
            let (_, _, p) = partition(rest, b':');
            host = h;
            port = p;
        } else {
            let (h, _, p) = partition(hostinfo, b':');
            host = h;
            port = p;
        }
        if port.len() == 0 { (host, None) } else { (host, Some(port)) }
    }

    fn hostname(ref self) -> Option[String] {
        let (host, _) = self.hostinfo();
        if host.len() == 0 {
            return None;
        }
        // a scope's zone keeps its case
        let (h, percent, zone) = partition(host, b'%');
        if percent { Some(f"{lower(h)}%{zone}") } else { Some(lower(h)) }
    }

    fn port(ref self) -> Result[Option[i64], String] {
        let (_, port) = self.hostinfo();
        let p = match port {
            Some(p) => p,
            None => return Ok(None),
        };
        let b = to_bytes(p);
        let mut n: i64 = 0;
        for i in 0..b.len() {
            if not is_digit(b[i]) {
                return Err(f"Port could not be cast to integer value as {py_repr(p)}");
            }
            if n <= 1000000 {
                n = n * 10 + (b[i] - b'0') as i64;
            }
        }
        if n > 65535 {
            return Err("Port out of range 0-65535".to_string());
        }
        Ok(Some(n))
    }
}

impl Parsed {
    fn repr(ref self) -> String {
        f"ParseResult(scheme={py_repr(self.scheme)}, netloc={py_repr(self.netloc)}, path={py_repr(self.path)}, params={py_repr(self.params)}, query={py_repr(self.query)}, fragment={py_repr(self.fragment)})"
    }
}

// _splitnetloc: the netloc runs to the first of / ? #.
fn split_netloc(url: Str, start: i64) -> (String, String) {
    let b = to_bytes(url);
    let mut delim = b.len();
    for i in start..b.len() {
        if b[i] == b'/' or b[i] == b'?' or b[i] == b'#' {
            delim = i;
            break;
        }
    }
    (byte_str(b, start, delim), byte_str(b, delim, b.len()))
}

fn check_bracketed_netloc(netloc: Str) -> Result[(), String] {
    let (_, _, host_and_port) = rpartition(netloc, b'@');
    let (before, have_open_br, bracketed) = partition(host_and_port, b'[');
    if have_open_br {
        if before.len() > 0 {
            return Err("Invalid IPv6 URL".to_string());
        }
        let (host, _, port) = partition(bracketed, b']');
        if port.len() > 0 and first_byte(port) != b':' {
            return Err("Invalid IPv6 URL".to_string());
        }
        return check_bracketed_host(host);
    }
    let (host, _, _) = partition(host_and_port, b':');
    check_bracketed_host(host)
}

fn urlsplit(url_in: Str, scheme_in: Str) -> Result[Split, String] {
    // lstrip the C0 controls and space, then drop every tab and line end
    let ub = to_bytes(url_in);
    let mut st: i64 = 0;
    while st < ub.len() and ub[st] <= 32 {
        st += 1;
    }
    let mut kept: Vec[u8] = Vec.new();
    for i in st..ub.len() {
        let c = ub[i];
        if c != b'\t' and c != b'\r' and c != b'\n' {
            kept.push(c);
        }
    }
    let mut url = from_bytes(kept);
    let mut scheme = strip_scheme(scheme_in);
    let mut netloc = String.new();
    let mut query = String.new();
    let mut fragment = String.new();
    let i = find_byte(url, b':');
    if i > 0 and is_alpha(first_byte(url)) {
        let b = to_bytes(url);
        let mut all = true;
        for k in 0..i {
            if not is_scheme_char(b[k]) {
                all = false;
                break;
            }
        }
        if all {
            scheme = lower(byte_str(b, 0, i));
            url = byte_str(b, i + 1, b.len());
        }
    }
    if starts_with(url, "//") {
        let (n, rest) = split_netloc(url, 2);
        netloc = n;
        url = rest;
        let open = has_byte(netloc, b'[');
        let close = has_byte(netloc, b']');
        if open != close {
            return Err("Invalid IPv6 URL".to_string());
        }
        if open and close {
            check_bracketed_netloc(netloc)?;
        }
    }
    if has_byte(url, b'#') {
        let (u, _, f) = partition(url, b'#');
        url = u;
        fragment = f;
    }
    if has_byte(url, b'?') {
        let (u, _, q) = partition(url, b'?');
        url = u;
        query = q;
    }
    Ok(Split { scheme: scheme, netloc: netloc, path: url, query: query, fragment: fragment })
}

// The scheme argument: C0 controls and space stripped at both ends, tabs
// and line ends dropped.
fn strip_scheme(s: Str) -> String {
    let b = to_bytes(s);
    let mut st: i64 = 0;
    let mut en = b.len();
    while st < en and b[st] <= 32 {
        st += 1;
    }
    while en > st and b[en - 1] <= 32 {
        en -= 1;
    }
    let mut out: Vec[u8] = Vec.new();
    for i in st..en {
        if b[i] != b'\t' and b[i] != b'\r' and b[i] != b'\n' {
            out.push(b[i]);
        }
    }
    from_bytes(out)
}

// _splitparams: the params follow the `;` in the last segment.
fn split_params(url: Str) -> (String, String) {
    let i = if has_byte(url, b'/') {
        let b = to_bytes(url);
        let mut at: i64 = -1;
        for k in rfind_byte(url, b'/')..b.len() {
            if b[k] == b';' {
                at = k;
                break;
            }
        }
        if at < 0 {
            return (url.to_string(), String.new());
        }
        at
    } else {
        find_byte(url, b';')
    };
    (slice(url, 0, i), slice_from(url, i + 1))
}

fn urlparse(url: Str, scheme: Str) -> Result[Parsed, String] {
    let s = urlsplit(url, scheme)?;
    let mut path = s.path.clone();
    let mut params = String.new();
    if uses_params(s.scheme) and has_byte(path, b';') {
        let (p, a) = split_params(path);
        path = p;
        params = a;
    }
    Ok(Parsed { scheme: s.scheme, netloc: s.netloc, path: path, params: params, query: s.query, fragment: s.fragment })
}

fn urlunsplit(scheme: Str, netloc: Str, path: Str, query: Str, fragment: Str) -> String {
    let mut url = path.to_string();
    if netloc.len() > 0 {
        if url.len() > 0 and first_byte(url) != b'/' {
            url = f"/{url}";
        }
        url = f"//{netloc}{url}";
    } else if starts_with(url, "//") {
        url = f"//{url}";
    } else if scheme.len() > 0 and uses_netloc(scheme) and (url.len() == 0 or first_byte(url) == b'/') {
        url = f"//{url}";
    }
    if scheme.len() > 0 {
        url = f"{scheme}:{url}";
    }
    if query.len() > 0 {
        url = f"{url}?{query}";
    }
    if fragment.len() > 0 {
        url = f"{url}#{fragment}";
    }
    url
}

fn unsplit(s: ref Split) -> String {
    urlunsplit(s.scheme, s.netloc, s.path, s.query, s.fragment)
}

fn urlunparse(p: ref Parsed) -> String {
    let path = if p.params.len() > 0 { f"{p.path};{p.params}" } else { p.path.clone() };
    urlunsplit(p.scheme, p.netloc, path, p.query, p.fragment)
}

fn urljoin(base: Str, url: Str) -> Result[String, String] {
    if base.len() == 0 {
        return Ok(url.to_string());
    }
    if url.len() == 0 {
        return Ok(base.to_string());
    }
    let b = urlparse(base, "")?;
    let mut u = urlparse(url, b.scheme)?;
    if u.scheme != b.scheme or not uses_relative(u.scheme) {
        return Ok(url.to_string());
    }
    if uses_netloc(u.scheme) {
        if u.netloc.len() > 0 {
            return Ok(urlunparse(u));
        }
        u.netloc = b.netloc.clone();
    }
    if u.path.len() == 0 and u.params.len() == 0 {
        u.path = b.path.clone();
        u.params = b.params.clone();
        if u.query.len() == 0 {
            u.query = b.query.clone();
        }
        return Ok(urlunparse(u));
    }
    let mut base_parts = split_on(b.path, b'/');
    if base_parts[base_parts.len() - 1].len() > 0 {
        // the last segment is not a directory
        base_parts.pop();
    }
    let mut segments: Vec[String] = Vec.new();
    if first_byte(u.path) == b'/' {
        segments = split_on(u.path, b'/');
    } else {
        let rel = split_on(u.path, b'/');
        let mut all = base_parts.clone();
        for i in 0..rel.len() {
            all.push(rel[i].clone());
        }
        // drop the empty segments between the first and the last
        for i in 0..all.len() {
            if i == 0 or i == all.len() - 1 or all[i].len() > 0 {
                segments.push(all[i].clone());
            }
        }
    }
    let mut resolved: Vec[String] = Vec.new();
    for i in 0..segments.len() {
        if segments[i] == ".." {
            if resolved.len() > 0 {
                resolved.pop();
            }
        } else if segments[i] != "." {
            resolved.push(segments[i].clone());
        }
    }
    let last = segments[segments.len() - 1].clone();
    if last == "." or last == ".." {
        resolved.push(String.new());
    }
    let joined = join(resolved, "/");
    u.path = if joined.len() > 0 { joined } else { "/".to_string() };
    Ok(urlunparse(u))
}

fn split_c(s: ref String, sep: char) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}
fn hex_digit(c: char) -> i64 {
    let n = c as i64;
    if n >= 97 { n - 87 } else if n >= 65 { n - 55 } else { n - 48 }
}
fn chars_of(s: ref String) -> Vec[char] {
    s.chars().collect()
}
fn chars_str(cs: ref Vec[char], a: i64, b: i64) -> String {
    let mut out = String.new();
    let mut k = a;
    while k < b {
        out.push(cs[k]);
        k += 1;
    }
    out
}

fn hex_bytes(s: ref String) -> Vec[u8] {
    let cs: Vec[char] = s.chars().collect();
    let n = cs.len() as i64;
    let mut out: Vec[u8] = Vec.new();
    let mut k: i64 = 0;
    while k < n {
        if cs[k] == 'z' {
            let mut j = k + 1;
            let mut count: i64 = 0;
            while cs[j] != '.' {
                count = count * 10 + (cs[j] as i64 - 48);
                j += 1;
            }
            let mut z: i64 = 0;
            while z < count {
                out.push(0);
                z += 1;
            }
            k = j + 1;
        } else {
            out.push((hex_digit(cs[k]) * 16 + hex_digit(cs[k + 1])) as u8);
            k += 2;
        }
    }
    out
}

fn hex_string(s: ref String) -> String {
    String.from_utf8(hex_bytes(s)).unwrap_or(String.new())
}

fn dirname_of(path: ref String) -> String {
    let cs = chars_of(path);
    let mut cut: i64 = -1;
    let mut k: i64 = 0;
    while k < cs.len() as i64 {
        if cs[k] == '/' {
            cut = k;
        }
        k += 1;
    }
    if cut < 0 { String.new() } else { chars_str(cs, 0, cut) }
}

fn write_inputs() -> Result[(), String] {
    let _ = fs.create_dir_all("data".to_string());
    for line in split_c(inputs_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_c(line, ' ');
        let path = f"data/{f[0]}";
        let _ = fs.create_dir_all(dirname_of(path));
        let bytes = if f.len() > 1 { hex_bytes(f[1]) } else { Vec.new() };
        if let Err(e) = fs.write_bytes(path, bytes) {
            return Err(f"cannot write {f[0]}: {e}");
        }
    }
    Ok(())
}


// ---- The value model: feedparser's FeedParserDicts and lists live in
// arenas so that a context (entries[-1], feed['image'], ...) is shared the
// way Python shares the dict object.

#[derive(Clone)]
enum Val {
    Null,
    Bool(bool),
    Int(i64),
    Str(String),
    D(i64),
    L(i64),
    Tm(Vec[i64]),
}

struct Store {
    dk: Vec[Vec[String]],
    dv: Vec[Vec[Val]],
    ls: Vec[Vec[Val]],
}

fn store_new() -> Store {
    Store { dk: Vec.new(), dv: Vec.new(), ls: Vec.new() }
}

fn sv(s: Str) -> Val {
    Val.Str(s.to_string())
}

fn d_new(st: mut ref Store) -> i64 {
    st.dk.push(Vec.new());
    st.dv.push(Vec.new());
    st.dk.len() as i64 - 1
}

fn l_new(st: mut ref Store) -> i64 {
    st.ls.push(Vec.new());
    st.ls.len() as i64 - 1
}

fn d_find(st: ref Store, d: i64, k: Str) -> i64 {
    let ks = ref st.dk[d];
    for i in 0..ks.len() {
        if ks[i] == k {
            return i as i64;
        }
    }
    -1
}

fn d_raw(st: ref Store, d: i64, k: Str) -> Option[Val] {
    let i = d_find(st, d, k);
    if i < 0 {
        return None;
    }
    Some(st.dv[d][i].clone())
}

fn d_has(st: ref Store, d: i64, k: Str) -> bool {
    d_find(st, d, k) >= 0
}

fn d_put(st: mut ref Store, d: i64, k: Str, v: own Val) {
    let i = d_find(st, d, k);
    if i >= 0 {
        st.dv[d][i] = v;
    } else {
        st.dk[d].push(k.to_string());
        st.dv[d].push(v);
    }
}

fn d_del(st: mut ref Store, d: i64, k: Str) {
    let i = d_find(st, d, k);
    if i >= 0 {
        st.dk[d].remove(i);
        st.dv[d].remove(i);
    }
}

fn d_clear(st: mut ref Store, d: i64) {
    st.dk[d] = Vec.new();
    st.dv[d] = Vec.new();
}

fn keymap1(k: Str) -> String {
    let t = [
        "channel", "feed", "items", "entries", "guid", "id", "date", "updated",
        "date_parsed", "updated_parsed", "description", "summary",
        "description_detail", "summary_detail", "url", "href", "modified", "updated",
        "modified_parsed", "updated_parsed", "issued", "published",
        "issued_parsed", "published_parsed", "copyright", "rights",
        "copyright_detail", "rights_detail", "tagline", "subtitle",
        "tagline_detail", "subtitle_detail",
    ];
    let mut i: i64 = 0;
    while i < 32 {
        if t[i] == k {
            return t[i + 1].to_string();
        }
        i += 2;
    }
    k.to_string()
}

// FeedParserDict.__setitem__
fn fset(st: mut ref Store, d: i64, k: Str, v: own Val) {
    let rk = keymap1(k);
    d_put(mut st, d, rk, v);
}

// FeedParserDict.__getitem__, for the keys the parser itself reads.
fn fget(st: ref Store, d: i64, k: Str) -> Option[Val] {
    if k == "description" or k == "description_detail" {
        let a = if k == "description" { "summary" } else { "summary_detail" };
        let b = if k == "description" { "subtitle" } else { "subtitle_detail" };
        if d_has(st, d, a) {
            return d_raw(st, d, a);
        }
        if d_has(st, d, b) {
            return d_raw(st, d, b);
        }
        return d_raw(st, d, k);
    }
    if k == "updated" or k == "updated_parsed" {
        if not d_has(st, d, k) {
            let alt = if k == "updated" { "published" } else { "published_parsed" };
            return d_raw(st, d, alt);
        }
        return d_raw(st, d, k);
    }
    let rk = keymap1(k);
    if d_has(st, d, rk) {
        return d_raw(st, d, rk);
    }
    d_raw(st, d, k)
}

fn fhas(st: ref Store, d: i64, k: Str) -> bool {
    if k == "updated" or k == "updated_parsed" {
        return d_has(st, d, k);
    }
    fget(st, d, k).is_some()
}

// FeedParserDict.setdefault: returns the stored value.
fn fsetdefault(st: mut ref Store, d: i64, k: Str, v: own Val) -> Val {
    if not fhas(st, d, k) {
        fset(mut st, d, k, v.clone());
        return v;
    }
    match fget(st, d, k) {
        Some(x) => x,
        None => Val.Null,
    }
}

fn fget_str(st: ref Store, d: i64, k: Str) -> String {
    match fget(st, d, k) {
        Some(Val.Str(s)) => s,
        _ => String.new(),
    }
}

fn val_dict(v: ref Val) -> i64 {
    match v {
        Val.D(i) => i,
        _ => -1,
    }
}

fn val_list(v: ref Val) -> i64 {
    match v {
        Val.L(i) => i,
        _ => -1,
    }
}

fn deep_copy(st: mut ref Store, v: ref Val) -> Val {
    match v {
        Val.D(d) => {
            let nd = d_new(mut st);
            let n = st.dk[d].len();
            for i in 0..n {
                let k = st.dk[d][i].clone();
                let x = st.dv[d][i].clone();
                let c = deep_copy(mut st, x);
                d_put(mut st, nd, k, c);
            }
            Val.D(nd)
        }
        Val.L(l) => {
            let nl = l_new(mut st);
            let n = st.ls[l].len();
            for i in 0..n {
                let x = st.ls[l][i].clone();
                let c = deep_copy(mut st, x);
                st.ls[nl].push(c);
            }
            Val.L(nl)
        }
        _ => v.clone(),
    }
}

fn val_eq(st: ref Store, a: ref Val, b: ref Val) -> bool {
    match (a, b) {
        (Val.Null, Val.Null) => true,
        (Val.Bool(x), Val.Bool(y)) => x == y,
        (Val.Int(x), Val.Int(y)) => x == y,
        (Val.Str(x), Val.Str(y)) => x == y,
        (Val.D(x), Val.D(y)) => {
            if st.dk[x].len() != st.dk[y].len() {
                return false;
            }
            for i in 0..st.dk[x].len() {
                let j = d_find(st, y, st.dk[x][i]);
                if j < 0 or not val_eq(st, st.dv[x][i], st.dv[y][j]) {
                    return false;
                }
            }
            true
        }
        _ => false,
    }
}

fn tm_repr(t: ref Vec[i64]) -> String {
    let mut s = "(".to_string();
    for i in 0..t.len() {
        if i > 0 {
            s.push_str(", ");
        }
        s.push_str(f"{t[i]}");
    }
    s.push_str(")");
    s
}

fn scalar(st: ref Store, v: ref Val) -> String {
    match v {
        Val.Null => "None".to_string(),
        Val.Bool(b) => if b { "True".to_string() } else { "False".to_string() },
        Val.Int(i) => f"{i}",
        Val.Str(s) => py_repr(s),
        Val.Tm(t) => tm_repr(t),
        Val.D(_) => "{}".to_string(),
        Val.L(_) => "[]".to_string(),
    }
}

fn nonempty(st: ref Store, v: ref Val) -> bool {
    match v {
        Val.D(d) => st.dk[d].len() > 0,
        Val.L(l) => st.ls[l].len() > 0,
        _ => false,
    }
}

fn dump(st: ref Store, v: ref Val, ind: Str, out: mut ref Vec[String]) {
    let deeper = f"{ind}  ";
    match v {
        Val.D(d) => {
            for i in 0..st.dk[d].len() {
                let k = st.dk[d][i].clone();
                let x = ref st.dv[d][i];
                if nonempty(st, x) {
                    out.push(f"{ind}{k}:");
                    dump(st, x, deeper, mut out);
                } else {
                    out.push(f"{ind}{k}: {scalar(st, x)}");
                }
            }
        }
        Val.L(l) => {
            for i in 0..st.ls[l].len() {
                let x = ref st.ls[l][i];
                if nonempty(st, x) {
                    out.push(f"{ind}- [{i}]");
                    dump(st, x, deeper, mut out);
                } else {
                    out.push(f"{ind}- {scalar(st, x)}");
                }
            }
        }
        _ => {}
    }
}

// ---- sgmllib's SGMLParser.goahead with feedparser's patched patterns
// (sgml.py), as an event list. No subclass defines start_/do_ methods, so
// the tag stack stays empty and every tag goes to unknown_starttag /
// unknown_endtag; the events are replayed into the three consumers.

struct Ev {
    k: i64,
    a: String,
    attrs: Vec[(String, String)],
}

fn ev(k: i64, a: Str) -> Ev {
    Ev { k: k, a: a.to_string(), attrs: Vec.new() }
}

const EV_START: i64 = 0;
const EV_END: i64 = 1;
const EV_DATA: i64 = 2;
const EV_CHARREF: i64 = 3;
const EV_ENTREF: i64 = 4;
const EV_COMMENT: i64 = 5;
const EV_PI: i64 = 6;
const EV_DECL: i64 = 7;
const EV_RAWDATA: i64 = 8;

fn bat(b: ref Vec[u8], i: i64) -> u8 {
    if i >= 0 and i < b.len() as i64 { b[i] } else { 0 }
}

fn is_tagc(c: u8) -> bool {
    is_alnum(c) or c == b'-' or c == b'_' or c == b'.' or c == b':'
}

fn is_attrc(c: u8) -> bool {
    is_alnum(c) or c == b'-' or c == b':' or c == b'.' or c == b'_'
}

fn is_unq_valc(c: u8) -> bool {
    if is_alnum(c) {
        return true;
    }
    let set = to_bytes("[]-./,:;+*%?!&$()_#=~'\"@");
    for x in set {
        if x == c {
            return true;
        }
    }
    false
}

// feedparser's _EndBracketRegEx, matched at i; returns the end of the match
// (a '<' or '>' follows it), or -1.
fn endbracket_fp(b: ref Vec[u8], i: i64) -> i64 {
    let n = b.len() as i64;
    let mut p = i;
    loop {
        if p >= n {
            break;
        }
        let c = b[p];
        if c == b'<' or c == b'>' {
            break;
        }
        if c == b'"' or c == b'\'' {
            let mut q = p + 1;
            while q < n and b[q] != c {
                q += 1;
            }
            if q >= n {
                break;
            }
            let la = bat(b, q + 1);
            let mut ok = la == b'>' or la == b'/' or is_ws(la);
            if not ok and is_word(la) {
                let mut r = q + 1;
                while r < n and is_word(b[r]) {
                    r += 1;
                }
                ok = bat(b, r) == b'=';
            }
            if not ok {
                break;
            }
            p = q + 1;
        } else {
            p += 1;
        }
    }
    if p < n and (b[p] == b'<' or b[p] == b'>') {
        return p;
    }
    let mut q = i;
    while q < n and b[q] != b'\n' {
        if b[q] == b'<' or b[q] == b'>' {
            return q;
        }
        q += 1;
    }
    -1
}

fn find_lt_gt(b: ref Vec[u8], i: i64) -> i64 {
    let mut q = i;
    while q < b.len() as i64 {
        if b[q] == b'<' or b[q] == b'>' {
            return q;
        }
        q += 1;
    }
    -1
}

// entity_or_charref.sub(_convert_ref) with _BaseHTMLProcessor's converters.
fn convert_refs(s: Str) -> String {
    let b = to_bytes(s);
    let n = b.len() as i64;
    let mut out = String.new();
    let mut i: i64 = 0;
    let mut last: i64 = 0;
    while i < n {
        if b[i] == b'&' and i + 2 < n + 1 and bat(b, i + 1) == b'#' and is_digit(bat(b, i + 2)) {
            let mut j = i + 2;
            while j < n and is_digit(b[j]) {
                j += 1;
            }
            out.push_str(byte_str(b, last, i));
            out.push_str("&#");
            out.push_str(byte_str(b, i + 2, j));
            out.push_str(";");
            if bat(b, j) == b';' {
                j += 1;
            }
            i = j;
            last = j;
        } else {
            i += 1;
        }
    }
    out.push_str(byte_str(b, last, n));
    out
}

// _BaseHTMLProcessor.feed's three rewrites.
fn sgml_prep(data: Str) -> String {
    let b = to_bytes(data);
    let n = b.len() as i64;
    let mut out = String.new();
    let mut count: i64 = 0;
    let mut last: i64 = 0;
    for i in 0..n {
        if count < 2 and b[i] == b'<' and bat(b, i + 1) == b'!' {
            if not (starts_at(b, i + 2, "DOCTYPE") or starts_at(b, i + 2, "--") or bat(b, i + 2) == b'[') {
                out.push_str(byte_str(b, last, i));
                out.push_str("&lt;!");
                last = i + 2;
                count += 1;
            }
        }
    }
    out.push_str(byte_str(b, last, n));
    // <([^<>\s]+?)\s*/>
    let b2 = to_bytes(out);
    let n2 = b2.len() as i64;
    let mut o2 = String.new();
    let mut i: i64 = 0;
    let mut last2: i64 = 0;
    while i < n2 {
        if b2[i] == b'<' {
            let mut j = i + 1;
            let mut found: i64 = -1;
            let mut endm: i64 = -1;
            while j < n2 and b2[j] != b'<' and b2[j] != b'>' and not is_ws(b2[j]) {
                j += 1;
                let mut k = j;
                while k < n2 and is_ws(b2[k]) {
                    k += 1;
                }
                if bat(b2, k) == b'/' and bat(b2, k + 1) == b'>' {
                    found = j;
                    endm = k + 2;
                    break;
                }
            }
            if found > 0 {
                let tag = byte_str(b2, i + 1, found);
                o2.push_str(byte_str(b2, last2, i));
                if is_void(tag) {
                    o2.push_str(f"<{tag} />");
                } else {
                    o2.push_str(f"<{tag}></{tag}>");
                }
                i = endm;
                last2 = endm;
                continue;
            }
        }
        i += 1;
    }
    o2.push_str(byte_str(b2, last2, n2));
    o2.replace("&#39;", "'").replace("&#34;", "\"")
}

fn is_void(t: Str) -> bool {
    let v = [
        "area", "base", "basefont", "br", "col", "command", "embed", "frame", "hr",
        "img", "input", "isindex", "keygen", "link", "meta", "param", "source", "track", "wbr",
    ];
    for x in v {
        if x == t {
            return true;
        }
    }
    false
}

// mode: 0 loose feed parser, 1 sanitizer, 2 URI resolver.
fn sgml_events(data: Str, mode: i64, xhtml: bool) -> Vec[Ev] {
    let b = to_bytes(sgml_prep(data));
    let n = b.len() as i64;
    let mut evs: Vec[Ev] = Vec.new();
    let mut lasttag = "???".to_string();
    let mut start: i64 = 0;
    let mut pass: i64 = 0;
    while pass < 2 {
        let end = pass == 1;
        let mut i = start;
        while i < n {
            let mut j = i;
            while j < n and b[j] != b'&' and b[j] != b'<' {
                j += 1;
            }
            if i < j {
                evs.push(ev(EV_DATA, byte_str(b, i, j)));
            }
            i = j;
            if i == n {
                break;
            }
            let c1 = bat(b, i + 1);
            if b[i] == b'<' {
                if c1 == b'>' or is_alpha(c1) {
                    let k = parse_starttag(b, i, mut evs, mut lasttag, xhtml);
                    if k < 0 {
                        break;
                    }
                    i = k;
                    continue;
                }
                if c1 == b'/' {
                    let m = find_lt_gt(b, i + 1);
                    if m < 0 {
                        break;
                    }
                    let tag = lower(strip(byte_str(b, i + 2, m)));
                    evs.push(ev(EV_END, tag));
                    i = if b[m] == b'>' { m + 1 } else { m };
                    continue;
                }
                if starts_at(b, i, "<!--") {
                    let k = parse_comment(b, i);
                    if k >= 0 {
                        evs.push(ev(EV_COMMENT, byte_str(b, i + 4, comment_body_end(b, i))));
                        i = k;
                        continue;
                    }
                    if mode != 1 {
                        break;
                    }
                    let mut q = i + 4;
                    let mut e2 = n;
                    while q + 1 < n {
                        if b[q] == b'-' and b[q + 1] == b'-' {
                            let mut r = q + 2;
                            while r < n and b[r] != b'>' {
                                r += 1;
                            }
                            if r < n {
                                e2 = r + 1;
                                break;
                            }
                        }
                        q += 1;
                    }
                    i = e2;
                    continue;
                }
                if c1 == b'?' {
                    let m = find_byte(byte_str(b, i + 2, n), b'>');
                    if m < 0 {
                        break;
                    }
                    evs.push(ev(EV_PI, byte_str(b, i + 2, i + 2 + m)));
                    i = i + 2 + m + 1;
                    continue;
                }
                if c1 == b'!' {
                    if mode != 0 and starts_at(b, i, "<![") {
                        let k = find_str(byte_str(b, i + 3, n), "]]>");
                        if k < 0 {
                            break;
                        }
                        i = i + 3 + k + 3;
                        continue;
                    }
                    if mode == 0 and starts_at(b, i, "<![CDATA[") {
                        let rest = byte_str(b, i + 9, n);
                        let k = find_str(rest, "]]>");
                        if k < 0 {
                            i = n;
                            continue;
                        }
                        evs.push(ev(EV_RAWDATA, xml_escape(byte_str(b, i + 9, i + 9 + k))));
                        i = i + 9 + k + 3;
                        continue;
                    }
                    let m = find_byte(byte_str(b, i, n), b'>');
                    if m < 0 {
                        break;
                    }
                    if mode != 0 {
                        evs.push(ev(EV_DECL, byte_str(b, i + 2, i + m)));
                    }
                    i = i + m + 1;
                    continue;
                }
            } else {
                // charref &#(\d+|[xX][0-9a-fA-F]+);
                if c1 == b'#' {
                    let c2 = bat(b, i + 2);
                    let mut j2 = i + 2;
                    if is_digit(c2) {
                        while j2 < n and is_digit(b[j2]) {
                            j2 += 1;
                        }
                    } else if c2 == b'x' or c2 == b'X' {
                        j2 = i + 3;
                        while j2 < n and is_hex(b[j2]) {
                            j2 += 1;
                        }
                        if j2 == i + 3 {
                            j2 = -1;
                        }
                    } else {
                        j2 = -1;
                    }
                    if j2 > 0 and bat(b, j2) == b';' {
                        evs.push(ev(EV_CHARREF, byte_str(b, i + 2, j2)));
                        i = j2 + 1;
                        continue;
                    }
                }
                // entityref &([a-zA-Z][-.a-zA-Z0-9]*)[^a-zA-Z0-9]
                if is_alpha(c1) {
                    let mut j2 = i + 2;
                    while j2 < n and (is_alnum(b[j2]) or b[j2] == b'-' or b[j2] == b'.') {
                        j2 += 1;
                    }
                    if j2 < n {
                        evs.push(ev(EV_ENTREF, byte_str(b, i + 1, j2)));
                        i = if b[j2] == b';' { j2 + 1 } else { j2 };
                        continue;
                    }
                }
            }
            // incomplete
            let mut j3 = i + 1;
            if b[i] == b'&' {
                if is_alpha(c1) {
                    j3 = i + 2;
                    while j3 < n and is_alnum(b[j3]) {
                        j3 += 1;
                    }
                } else if c1 == b'#' {
                    j3 = i + 2;
                    while j3 < n and is_digit(b[j3]) {
                        j3 += 1;
                    }
                }
            } else {
                let from = if c1 == b'/' and is_alpha(bat(b, i + 2)) {
                    i + 2
                } else if is_alpha(c1) or c1 == b'!' {
                    i + 1
                } else {
                    -1
                };
                if c1 == b'/' and from < 0 {
                    j3 = i + 2;
                } else if from > 0 {
                    j3 = from + 1;
                    while j3 < n and b[j3] != b'<' and b[j3] != b'>' {
                        j3 += 1;
                    }
                }
            }
            if j3 == n {
                break;
            }
            evs.push(ev(EV_DATA, byte_str(b, i, j3)));
            i = j3;
        }
        if end and i < n {
            evs.push(ev(EV_DATA, byte_str(b, i, n)));
            i = n;
        }
        start = i;
        pass += 1;
    }
    evs
}

fn comment_body_end(b: ref Vec[u8], i: i64) -> i64 {
    let mut q = i + 4;
    while q + 1 < b.len() as i64 {
        if b[q] == b'-' and b[q + 1] == b'-' {
            let mut r = q + 2;
            while r < b.len() as i64 and is_ws(b[r]) {
                r += 1;
            }
            if bat(b, r) == b'>' {
                return q;
            }
        }
        q += 1;
    }
    -1
}

// _markupbase.parse_comment: the end of --\s*>, or -1.
fn parse_comment(b: ref Vec[u8], i: i64) -> i64 {
    let q = comment_body_end(b, i);
    if q < 0 {
        return -1;
    }
    let mut r = q + 2;
    while is_ws(b[r]) {
        r += 1;
    }
    r + 1
}

fn parse_starttag(b: ref Vec[u8], i: i64, evs: mut ref Vec[Ev], lasttag: mut ref String, xhtml: bool) -> i64 {
    let n = b.len() as i64;
    // shorttagopen <[a-zA-Z][-.a-zA-Z0-9]*/
    let mut p = i + 1;
    while p < n and (is_alnum(b[p]) or b[p] == b'-' or b[p] == b'.') {
        p += 1;
    }
    if bat(b, p) == b'/' and is_alpha(bat(b, i + 1)) {
        let mut q = p + 1;
        while q < n and b[q] != b'/' {
            q += 1;
        }
        if q >= n {
            return -1;
        }
        let tag = lower(byte_str(b, i + 1, p));
        evs.push(ev(EV_START, tag.clone()));
        evs.push(ev(EV_DATA, byte_str(b, p + 1, q)));
        evs.push(ev(EV_END, tag));
        return q + 1;
    }
    let j0 = endbracket_fp(b, i + 1);
    if j0 < 0 {
        return -1;
    }
    let mut j = j0;
    let mut attrs: Vec[(String, String)] = Vec.new();
    let mut k: i64 = 0;
    let mut tag = String.new();
    if bat(b, i + 1) == b'>' {
        k = j;
        tag = lasttag.clone();
    } else {
        k = i + 2;
        while k < n and is_tagc(b[k]) {
            k += 1;
        }
        tag = lower(byte_str(b, i + 1, k));
        *lasttag = tag.clone();
    }
    while k < j {
        let mut p2 = k;
        while p2 < n and is_ws(b[p2]) {
            p2 += 1;
        }
        let c = bat(b, p2);
        if not (is_alpha(c) or c == b'_') {
            break;
        }
        let ns = p2;
        p2 += 1;
        while p2 < n and is_attrc(b[p2]) {
            p2 += 1;
        }
        let name = byte_str(b, ns, p2);
        if bat(b, p2) == b'$' {
            p2 += 1;
        }
        let mut q = p2;
        while q < n and is_ws(b[q]) {
            q += 1;
        }
        let mut value = name.clone();
        if bat(b, q) == b'=' {
            q += 1;
            while q < n and is_ws(b[q]) {
                q += 1;
            }
            let vs = q;
            let qc = bat(b, q);
            let mut done = false;
            if qc == b'\'' or qc == b'"' {
                let mut r = q + 1;
                while r < n and b[r] != qc {
                    r += 1;
                }
                if r < n {
                    q = r + 1;
                    done = true;
                }
            }
            if not done {
                while q < n and is_unq_valc(b[q]) {
                    q += 1;
                }
            }
            let mut v = byte_str(b, vs, q);
            let vb = to_bytes(v);
            if vb.len() >= 1 and (vb[0] == b'\'' or vb[0] == b'"') and vb[vb.len() - 1] == vb[0] {
                v = byte_str(vb, 1, vb.len() as i64 - 1);
            }
            value = convert_refs(v);
            p2 = q;
        }
        attrs.push((lower(name), value));
        k = p2;
    }
    if b[j] == b'>' {
        j += 1;
    }
    let mut e = ev(EV_START, tag);
    e.attrs = attrs;
    evs.push(e);
    if xhtml and j > 2 and b[j - 2] == b'/' and b[j - 1] == b'>' {
        evs.push(ev(EV_END, lasttag.clone()));
    }
    j
}

fn xml_escape(s: Str) -> String {
    s.replace("&", "&amp;").replace(">", "&gt;").replace("<", "&lt;")
}

// ---- _BaseHTMLProcessor, _HTMLSanitizer and RelativeURIResolver.

struct Tables {
    elems: Vec[String],
    attrs: Vec[String],
    unacc: Vec[String],
    cssprops: Vec[String],
    csskw: Vec[String],
    ents: Vec[String],
    entcp: Vec[i64],
    cp1252: Vec[i64],
    ns_uri: Vec[String],
    ns_pre: Vec[String],
    schemes: Vec[String],
}

fn words(s: Str) -> Vec[String] {
    split_ws(s)
}

fn load_tables() -> Tables {
    let mut ents: Vec[String] = Vec.new();
    let mut entcp: Vec[i64] = Vec.new();
    for w in words(tbl_entities()) {
        let p = partition(w, b'=');
        ents.push(p.0);
        entcp.push(py_int(p.2).unwrap_or(0));
    }
    let mut cp: Vec[i64] = Vec.new();
    for w in words(tbl_cp1252()) {
        cp.push(py_int(w).unwrap_or(0));
    }
    let mut nu: Vec[String] = Vec.new();
    let mut np: Vec[String] = Vec.new();
    for line in split_c(tbl_namespaces(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let p = partition(line, b' ');
        nu.push(p.0);
        np.push(if p.2 == "-" { String.new() } else { p.2 });
    }
    Tables {
        elems: words(tbl_elements()),
        attrs: words(tbl_attributes()),
        unacc: words("script applet style"),
        cssprops: words(tbl_css_properties()),
        csskw: words(tbl_css_keywords()),
        ents: ents,
        entcp: entcp,
        cp1252: cp,
        ns_uri: nu,
        ns_pre: np,
        schemes: words(tbl_schemes()),
    }
}

fn ent_cp(t: ref Tables, name: Str) -> i64 {
    for i in 0..t.ents.len() {
        if t.ents[i] == name {
            return t.entcp[i];
        }
    }
    -1
}

// The _cp1252 translate table: 128..159 to their cp1252 characters.
fn cp1252_of(t: ref Tables, c: i64) -> i64 {
    if c >= 128 and c < 160 { t.cp1252[c - 128] } else { -1 }
}

fn chr_str(c: i64) -> String {
    let mut s = String.new();
    match char.try_from(c as u32) {
        Ok(ch) => s.push(ch),
        Err(_) => {}
    }
    s
}

// str.translate(_cp1252)
fn translate_cp1252(t: ref Tables, s: Str) -> String {
    let mut out = String.new();
    for ch in s.chars() {
        let c = ch as i64;
        let m = cp1252_of(t, c);
        if m >= 0 {
            out.push_str(chr_str(m));
        } else {
            out.push(ch);
        }
    }
    out
}

fn hex_lower(v: i64) -> String {
    let d = "0123456789abcdef";
    if v == 0 {
        return "0".to_string();
    }
    let mut x = v;
    let mut out: Vec[u8] = Vec.new();
    let db = to_bytes(d);
    while x > 0 {
        out.insert(0, db[x % 16]);
        x = x / 16;
    }
    from_bytes(out)
}

// re.sub(r"&(?!#\d+;|#x[0-9a-fA-F]+;|\w+;)", "&amp;", v)
fn bare_amp(v: Str) -> String {
    let b = to_bytes(v);
    let n = b.len() as i64;
    let mut out = String.new();
    let mut last: i64 = 0;
    for i in 0..n {
        if b[i] != b'&' {
            continue;
        }
        let mut ok = false;
        if bat(b, i + 1) == b'#' {
            let mut j = i + 2;
            while j < n and is_digit(b[j]) {
                j += 1;
            }
            if j > i + 2 and bat(b, j) == b';' {
                ok = true;
            }
            if bat(b, i + 2) == b'x' {
                let mut j2 = i + 3;
                while j2 < n and is_hex(b[j2]) {
                    j2 += 1;
                }
                if j2 > i + 3 and bat(b, j2) == b';' {
                    ok = true;
                }
            }
        }
        let mut j = i + 1;
        while j < n and is_word(b[j]) {
            j += 1;
        }
        if j > i + 1 and bat(b, j) == b';' {
            ok = true;
        }
        if not ok {
            out.push_str(byte_str(b, last, i));
            out.push_str("&amp;");
            last = i + 1;
        }
    }
    out.push_str(byte_str(b, last, n));
    out
}

fn normalize_attrs(attrs: ref Vec[(String, String)]) -> Vec[(String, String)] {
    let mut ks: Vec[String] = Vec.new();
    let mut vs: Vec[String] = Vec.new();
    for a in attrs {
        let k = lower(a.0);
        let mut found = false;
        for i in 0..ks.len() {
            if ks[i] == k {
                vs[i] = a.1.clone();
                found = true;
            }
        }
        if not found {
            ks.push(k);
            vs.push(a.1.clone());
        }
    }
    let mut out: Vec[(String, String)] = Vec.new();
    for i in 0..ks.len() {
        let v = if ks[i] == "rel" or ks[i] == "type" { lower(vs[i]) } else { vs[i].clone() };
        out.push((ks[i].clone(), v));
    }
    // attrs.sort(): by key, then value
    let mut i: i64 = 1;
    while i < out.len() as i64 {
        let mut j = i;
        while j > 0 and (out[j - 1].0 > out[j].0 or (out[j - 1].0 == out[j].0 and out[j - 1].1 > out[j].1)) {
            out.swap(j - 1, j);
            j -= 1;
        }
        i += 1;
    }
    out
}

fn base_start(pieces: mut ref Vec[String], tag: Str, attrs: ref Vec[(String, String)]) {
    let mut sa = String.new();
    for a in attrs {
        let v = bare_amp(a.1.replace(">", "&gt;").replace("<", "&lt;").replace("\"", "&quot;"));
        sa.push_str(f" {a.0}=\"{v}\"");
    }
    if is_void(tag) {
        pieces.push(f"<{tag}{sa} />");
    } else {
        pieces.push(f"<{tag}{sa}>");
    }
}

fn base_other(t: ref Tables, pieces: mut ref Vec[String], e: ref Ev) {
    if e.k == EV_END {
        if not is_void(e.a) {
            pieces.push(f"</{e.a}>");
        }
    } else if e.k == EV_CHARREF {
        let r = lower(e.a);
        let v = if starts_with(r, "x") { parse_hex(slice_from(r, 1)) } else { py_int(r).unwrap_or(0) };
        let m = cp1252_of(t, v);
        if m >= 0 {
            pieces.push(f"&#x{hex_lower(m)};");
        } else {
            pieces.push(f"&#{r};");
        }
    } else if e.k == EV_ENTREF {
        if ent_cp(t, e.a) >= 0 or e.a == "apos" {
            pieces.push(f"&{e.a};");
        } else {
            pieces.push(f"&amp;{e.a}");
        }
    } else if e.k == EV_DATA or e.k == EV_RAWDATA {
        pieces.push(e.a.clone());
    } else if e.k == EV_COMMENT {
        pieces.push(f"<!--{e.a}-->");
    } else if e.k == EV_PI {
        pieces.push(f"<?{e.a}>");
    } else if e.k == EV_DECL {
        pieces.push(f"<!{e.a}>");
    }
}

fn parse_hex(s: Str) -> i64 {
    let mut v: i64 = 0;
    for c in to_bytes(s) {
        v = v * 16 + hex_val(c) as i64;
    }
    v
}

fn in_list(v: ref Vec[String], s: Str) -> bool {
    for x in v {
        if x == s {
            return true;
        }
    }
    false
}

fn sanitize_html(t: ref Tables, src: Str, ty: Str) -> String {
    let src2 = src.replace("<![CDATA[", "&lt;![CDATA[");
    let evs = sgml_events(src2, 1, ty == "application/xhtml+xml");
    let mut pieces: Vec[String] = Vec.new();
    let mut unacc: i64 = 0;
    for e in evs {
        if e.k == EV_START {
            if not in_list(t.elems, e.a) {
                if in_list(t.unacc, e.a) {
                    unacc += 1;
                }
                continue;
            }
            let mut clean: Vec[(String, String)] = Vec.new();
            for a in normalize_attrs(e.attrs) {
                if a.0 == "style" and in_list(t.attrs, "style") {
                    let cv = sanitize_style(t, a.1);
                    if cv.len() > 0 {
                        clean.push((a.0.clone(), cv));
                    }
                } else if in_list(t.attrs, a.0) {
                    let v = if a.0 == "href" { safe_uri(t, a.1, "") } else { a.1.clone() };
                    clean.push((a.0.clone(), v));
                }
            }
            base_start(mut pieces, e.a, clean);
        } else if e.k == EV_END {
            if not in_list(t.elems, e.a) {
                if in_list(t.unacc, e.a) {
                    unacc -= 1;
                }
                continue;
            }
            base_other(t, mut pieces, e);
        } else if e.k == EV_DATA or e.k == EV_RAWDATA {
            if unacc == 0 {
                pieces.push(e.a.clone());
            }
        } else if e.k == EV_PI or e.k == EV_DECL {
        } else {
            base_other(t, mut pieces, e);
        }
    }
    let mut out = String.new();
    for p in pieces {
        out.push_str(p);
    }
    py_strip(out).replace("\r\n", "\n")
}

fn resolve_relative(t: ref Tables, src: Str, base: Str, ty: Str) -> String {
    let rel = to_bytes("a href;applet codebase;area href;audio src;blockquote cite;body background;del cite;form action;frame longdesc;frame src;iframe longdesc;iframe src;head profile;img longdesc;img src;img usemap;input src;input usemap;ins cite;link href;object classid;object codebase;object data;object usemap;q cite;script src;source src;video poster;video src");
    let pairs = split_on(from_bytes(rel), b';');
    let evs = sgml_events(src, 2, ty == "application/xhtml+xml");
    let mut pieces: Vec[String] = Vec.new();
    for e in evs {
        if e.k == EV_START {
            let mut out: Vec[(String, String)] = Vec.new();
            for a in normalize_attrs(e.attrs) {
                let key = f"{e.a} {a.0}";
                let mut v = a.1.clone();
                if in_list(pairs, key) {
                    let r = safe_uri(t, base, py_strip(a.1));
                    if r.len() > 0 {
                        v = r;
                    }
                }
                out.push((a.0.clone(), v));
            }
            base_start(mut pieces, e.a, out);
        } else {
            base_other(t, mut pieces, e);
        }
    }
    let mut out = String.new();
    for p in pieces {
        out.push_str(p);
    }
    out
}

// The gauntlet: ^([:,;#%.\sa-zA-Z0-9!]|\w-\w|'[\s\w]+'|"[\s\w]+"|\([\d,\s]+\))*$
fn style_gauntlet(s: Str) -> bool {
    let b = to_bytes(s);
    let n = b.len() as i64;
    let mut reach: Vec[bool] = Vec.new();
    for _ in 0..(n + 1) {
        reach.push(false);
    }
    reach[0] = true;
    for i in 0..n {
        if not reach[i] {
            continue;
        }
        let c = b[i];
        if is_alnum(c) or is_ws(c) or c == b':' or c == b',' or c == b';' or c == b'#' or c == b'%' or c == b'.' or c == b'!' {
            reach[i + 1] = true;
        }
        if is_word(c) and bat(b, i + 1) == b'-' and is_word(bat(b, i + 2)) {
            reach[i + 3] = true;
        }
        if c == b'\'' or c == b'"' {
            let mut j = i + 1;
            while j < n and (is_ws(b[j]) or is_word(b[j])) {
                j += 1;
            }
            if j > i + 1 and bat(b, j) == c {
                // any shorter run cannot close, so this is the only match
                reach[j + 1] = true;
            }
        }
        if c == b'(' {
            let mut j = i + 1;
            while j < n and (is_digit(b[j]) or b[j] == b',' or is_ws(b[j])) {
                j += 1;
            }
            if j > i + 1 and bat(b, j) == b')' {
                reach[j + 1] = true;
            }
        }
    }
    reach[n]
}

fn css_name_end(b: ref Vec[u8], i: i64) -> i64 {
    let mut j = i;
    while j < b.len() as i64 and (is_word(b[j]) or b[j] == b'-') {
        j += 1;
    }
    j
}

// \s*[-\w]+\s*:\s*[^:;]*;?  matched at i; returns the end, or -1.
fn css_decl_at(b: ref Vec[u8], i: i64, name_at: mut ref (i64, i64), val_at: mut ref (i64, i64)) -> i64 {
    let n = b.len() as i64;
    let mut p = i;
    while p < n and is_ws(b[p]) {
        p += 1;
    }
    let q = css_name_end(b, p);
    if q == p {
        return -1;
    }
    let mut r = q;
    while r < n and is_ws(b[r]) {
        r += 1;
    }
    if bat(b, r) != b':' {
        return -1;
    }
    r += 1;
    while r < n and is_ws(b[r]) {
        r += 1;
    }
    let vs = r;
    while r < n and b[r] != b':' and b[r] != b';' {
        r += 1;
    }
    *name_at = (p, q);
    *val_at = (vs, r);
    if bat(b, r) == b';' {
        r += 1;
    }
    r
}

fn css_value_ok(t: ref Tables, k: Str) -> bool {
    if in_list(t.csskw, k) {
        return true;
    }
    let b = to_bytes(k);
    let n = b.len() as i64;
    if n > 1 and b[0] == b'#' {
        let mut ok = true;
        for i in 1..n {
            if not (is_digit(b[i]) or (b[i] >= b'a' and b[i] <= b'f')) {
                ok = false;
            }
        }
        if ok {
            return true;
        }
    }
    // \d{0,2}\.?\d{0,2}(cm|em|ex|in|mm|pc|pt|px|%|,|\))?$
    let mut i: i64 = 0;
    while i < n and i < 2 and is_digit(b[i]) {
        i += 1;
    }
    if bat(b, i) == b'.' {
        i += 1;
    }
    let st = i;
    while i < n and i - st < 2 and is_digit(b[i]) {
        i += 1;
    }
    let rest = byte_str(b, i, n);
    let units = ["", "cm", "em", "ex", "in", "mm", "pc", "pt", "px", "%", ",", ")"];
    for u in units {
        if rest == u {
            return true;
        }
    }
    starts_with(k, "rgb(") and rgb_ok(byte_str(b, 4, n))
}

// \d+%?,\d*%?,?\d*%?\)?$ after "rgb("
fn rgb_ok(s: Str) -> bool {
    let b = to_bytes(s);
    let n = b.len() as i64;
    let mut i: i64 = 0;
    let st = i;
    while i < n and is_digit(b[i]) {
        i += 1;
    }
    if i == st {
        return false;
    }
    if bat(b, i) == b'%' {
        i += 1;
    }
    if bat(b, i) != b',' {
        return false;
    }
    i += 1;
    while i < n and is_digit(b[i]) {
        i += 1;
    }
    if bat(b, i) == b'%' {
        i += 1;
    }
    if bat(b, i) == b',' {
        i += 1;
    }
    while i < n and is_digit(b[i]) {
        i += 1;
    }
    if bat(b, i) == b'%' {
        i += 1;
    }
    if bat(b, i) == b')' {
        i += 1;
    }
    i == n
}

fn sanitize_style(t: ref Tables, style0: Str) -> String {
    // url\s*\(\s*[^\s)]+?\s*\)\s*  ->  ' '
    let b0 = to_bytes(style0);
    let n0 = b0.len() as i64;
    let mut style = String.new();
    let mut i: i64 = 0;
    let mut last: i64 = 0;
    while i < n0 {
        if starts_at(b0, i, "url") {
            let mut p = i + 3;
            while p < n0 and is_ws(b0[p]) {
                p += 1;
            }
            if bat(b0, p) == b'(' {
                p += 1;
                while p < n0 and is_ws(b0[p]) {
                    p += 1;
                }
                let s = p;
                while p < n0 and not is_ws(b0[p]) and b0[p] != b')' {
                    p += 1;
                }
                let mut q = p;
                while q < n0 and is_ws(b0[q]) {
                    q += 1;
                }
                if p > s and bat(b0, q) == b')' {
                    q += 1;
                    while q < n0 and is_ws(b0[q]) {
                        q += 1;
                    }
                    style.push_str(byte_str(b0, last, i));
                    style.push_str(" ");
                    i = q;
                    last = q;
                    continue;
                }
            }
        }
        i += 1;
    }
    style.push_str(byte_str(b0, last, n0));
    if not style_gauntlet(style) {
        return String.new();
    }
    let b = to_bytes(style);
    let n = b.len() as i64;
    let mut left = String.new();
    let mut na = (0, 0);
    let mut va = (0, 0);
    let mut p: i64 = 0;
    while p < n {
        let e = css_decl_at(b, p, mut na, mut va);
        if e > p {
            p = e;
        } else {
            left.push_str(byte_str(b, p, p + 1));
            p += 1;
        }
    }
    if py_strip(left).len() > 0 {
        return String.new();
    }
    let mut clean: Vec[String] = Vec.new();
    p = 0;
    while p < n {
        // findall ([-\w]+)\s*:\s*([^:;]*)
        let q = css_name_end(b, p);
        if q == p {
            p += 1;
            continue;
        }
        let mut r = q;
        while r < n and is_ws(b[r]) {
            r += 1;
        }
        if bat(b, r) != b':' {
            p += 1;
            continue;
        }
        r += 1;
        while r < n and is_ws(b[r]) {
            r += 1;
        }
        let vs = r;
        while r < n and b[r] != b':' and b[r] != b';' {
            r += 1;
        }
        let prop = byte_str(b, p, q);
        let value = byte_str(b, vs, r);
        p = r;
        if value.len() == 0 {
            continue;
        }
        let lp = lower(prop);
        let head = lower(partition(prop, b'-').0);
        if in_list(t.cssprops, lp) {
            clean.push(f"{prop}: {value};");
        } else if head == "background" or head == "border" or head == "margin" or head == "padding" {
            let mut ok = true;
            for kw in split_ws(value) {
                if not css_value_ok(t, kw) {
                    ok = false;
                    break;
                }
            }
            if ok {
                clean.push(f"{prop}: {value};");
            }
        }
    }
    join(clean, " ")
}

fn py_strip(s: Str) -> String {
    strip(s)
}

// ---- The strict path: the parts of expat + xml.sax.expatreader (with
// feature_namespaces on) that feeds reach, as an event list. An error stops
// the scan and carries expat's line and column.

struct XEv {
    k: i64,
    ns: String,
    has_ns: bool,
    local: String,
    attrs: Vec[(String, String, String)],
    text: String,
}

struct XRes {
    evs: Vec[XEv],
    err: String,
}

fn xev(k: i64) -> XEv {
    XEv { k: k, ns: String.new(), has_ns: false, local: String.new(), attrs: Vec.new(), text: String.new() }
}

fn line_col(b: ref Vec[u8], pos: i64) -> String {
    let mut line: i64 = 1;
    let mut col: i64 = 0;
    for i in 0..pos {
        if b[i] == b'\n' {
            line += 1;
            col = 0;
        } else if b[i] < 0x80 or b[i] >= 0xC0 {
            col += 1;
        }
    }
    f"{line}:{col}"
}

fn is_namec(c: u8) -> bool {
    is_alnum(c) or c == b'-' or c == b'_' or c == b'.' or c == b':' or c >= 0x80
}

fn is_name0(c: u8) -> bool {
    is_alpha(c) or c == b'_' or c == b':' or c >= 0x80
}

// A reference at b[i] == '&'; Ok((text, end)) or Err((pos, msg)).
fn xml_ref(b: ref Vec[u8], i: i64) -> Result[(String, i64), (i64, String)] {
    let n = b.len() as i64;
    if bat(b, i + 1) == b'#' {
        let hexr = bat(b, i + 2) == b'x';
        let mut j = if hexr { i + 3 } else { i + 2 };
        let st = j;
        while j < n and (if hexr { is_hex(b[j]) } else { is_digit(b[j]) }) {
            j += 1;
        }
        if j == st or bat(b, j) != b';' {
            return Err((j, "not well-formed (invalid token)".to_string()));
        }
        let s = byte_str(b, st, j);
        let v = if hexr { parse_hex(s) } else { py_int(s).unwrap_or(0) };
        if v == 0 or v > 0x10FFFF {
            return Err((i, "reference to invalid character number".to_string()));
        }
        return Ok((chr_str(v), j + 1));
    }
    if not is_name0(bat(b, i + 1)) {
        return Err((i + 1, "not well-formed (invalid token)".to_string()));
    }
    let mut j = i + 2;
    while j < n and is_namec(b[j]) {
        j += 1;
    }
    if bat(b, j) != b';' {
        return Err((j, "not well-formed (invalid token)".to_string()));
    }
    let name = byte_str(b, i + 1, j);
    let t = if name == "amp" { "&" } else if name == "lt" { "<" } else if name == "gt" { ">" } else if name == "quot" { "\"" } else if name == "apos" { "'" } else { "" };
    if t.len() == 0 {
        return Err((i, "undefined entity".to_string()));
    }
    Ok((t.to_string(), j + 1))
}

fn ns_lookup(scopes: ref Vec[(String, String)], prefix: Str) -> Option[String] {
    if prefix == "xml" {
        return Some("http://www.w3.org/XML/1998/namespace".to_string());
    }
    let mut i = scopes.len() as i64 - 1;
    while i >= 0 {
        if scopes[i].0 == prefix {
            return Some(scopes[i].1.clone());
        }
        i -= 1;
    }
    None
}

fn xml_scan(data: ref Vec[u8]) -> XRes {
    let b = data;
    let n = b.len() as i64;
    let mut evs: Vec[XEv] = Vec.new();
    let mut stack: Vec[(String, i64)] = Vec.new();
    let mut scopes: Vec[(String, String)] = Vec.new();
    let mut seen_root = false;
    let mut i: i64 = 0;
    let mut text = String.new();
    while i < n {
        let c = b[i];
        let in_content = stack.len() > 0;
        if c != b'<' and c != b'&' {
            if not in_content {
                if is_ws(c) {
                    i += 1;
                    continue;
                }
                let msg = if seen_root { "junk after document element" } else { "syntax error" };
                return XRes { evs: evs, err: f"{line_col(b, i)}: {msg}" };
            }
            let mut j = i;
            while j < n and b[j] != b'<' and b[j] != b'&' {
                if b[j] == b']' and bat(b, j + 1) == b']' and bat(b, j + 2) == b'>' {
                    return XRes { evs: evs, err: f"{line_col(b, j)}: not well-formed (invalid token)" };
                }
                j += 1;
            }
            text.push_str(byte_str(b, i, j));
            i = j;
            continue;
        }
        if c == b'&' {
            if not in_content {
                return XRes { evs: evs, err: f"{line_col(b, i)}: not well-formed (invalid token)" };
            }
            match xml_ref(b, i) {
                Ok((t, e)) => {
                    text.push_str(t);
                    i = e;
                }
                Err((p, m)) => {
                    return XRes { evs: evs, err: f"{line_col(b, p)}: {m}" };
                }
            }
            continue;
        }
        if starts_at(b, i, "<![CDATA[") and in_content {
            let k = find_str(byte_str(b, i + 9, n), "]]>");
            if k < 0 {
                return XRes { evs: evs, err: f"{line_col(b, n)}: unclosed CDATA section" };
            }
            text.push_str(byte_str(b, i + 9, i + 9 + k));
            i = i + 9 + k + 3;
            continue;
        }
        if text.len() > 0 {
            let mut e = xev(2);
            e.text = text;
            evs.push(e);
            text = String.new();
        }
        if starts_at(b, i, "<!--") {
            let k = find_str(byte_str(b, i + 4, n), "-->");
            if k < 0 {
                return XRes { evs: evs, err: f"{line_col(b, n)}: unclosed token" };
            }
            i = i + 4 + k + 3;
            continue;
        }
        if starts_at(b, i, "<?") {
            let k = find_str(byte_str(b, i + 2, n), "?>");
            if k < 0 {
                return XRes { evs: evs, err: f"{line_col(b, n)}: unclosed token" };
            }
            i = i + 2 + k + 2;
            continue;
        }
        if starts_at(b, i, "</") {
            let mut j = i + 2;
            while j < n and is_namec(b[j]) {
                j += 1;
            }
            let name = byte_str(b, i + 2, j);
            while j < n and is_ws(b[j]) {
                j += 1;
            }
            if j >= n {
                return XRes { evs: evs, err: f"{line_col(b, n)}: unclosed token" };
            }
            if b[j] != b'>' {
                return XRes { evs: evs, err: f"{line_col(b, j)}: not well-formed (invalid token)" };
            }
            if stack.len() == 0 or stack[stack.len() - 1].0 != name {
                return XRes { evs: evs, err: f"{line_col(b, i + 2)}: mismatched tag" };
            }
            let top = stack.pop().unwrap();
            let p = partition(name, b':');
            let (pre, loc) = if p.1 { (p.0, p.2) } else { (String.new(), p.0) };
            let mut e = xev(1);
            match ns_lookup(scopes, pre) {
                Some(u) => {
                    if u.len() > 0 {
                        e.ns = u;
                        e.has_ns = true;
                    }
                }
                None => {}
            }
            e.local = loc;
            evs.push(e);
            while scopes.len() as i64 > top.1 {
                scopes.pop();
            }
            i = j + 1;
            continue;
        }
        if starts_at(b, i, "<!") {
            if seen_root or in_content {
                return XRes { evs: evs, err: f"{line_col(b, i)}: not well-formed (invalid token)" };
            }
            let k = find_byte(byte_str(b, i, n), b'>');
            i = i + k + 1;
            continue;
        }
        // a start tag
        if seen_root and not in_content {
            return XRes { evs: evs, err: f"{line_col(b, i)}: junk after document element" };
        }
        if not is_name0(bat(b, i + 1)) {
            return XRes { evs: evs, err: f"{line_col(b, i + 1)}: not well-formed (invalid token)" };
        }
        let mut j = i + 1;
        while j < n and is_namec(b[j]) {
            j += 1;
        }
        let name = byte_str(b, i + 1, j);
        let mut raw: Vec[(String, String)] = Vec.new();
        let mut empty = false;
        loop {
            let s0 = j;
            while j < n and is_ws(b[j]) {
                j += 1;
            }
            if j >= n {
                return XRes { evs: evs, err: f"{line_col(b, n)}: unclosed token" };
            }
            if b[j] == b'>' {
                j += 1;
                break;
            }
            if b[j] == b'/' and bat(b, j + 1) == b'>' {
                empty = true;
                j += 2;
                break;
            }
            if j == s0 or not is_name0(b[j]) {
                return XRes { evs: evs, err: f"{line_col(b, j)}: not well-formed (invalid token)" };
            }
            let ns0 = j;
            while j < n and is_namec(b[j]) {
                j += 1;
            }
            let an = byte_str(b, ns0, j);
            while j < n and is_ws(b[j]) {
                j += 1;
            }
            if bat(b, j) != b'=' {
                return XRes { evs: evs, err: f"{line_col(b, j)}: not well-formed (invalid token)" };
            }
            j += 1;
            while j < n and is_ws(b[j]) {
                j += 1;
            }
            let q = bat(b, j);
            if q != b'"' and q != b'\'' {
                return XRes { evs: evs, err: f"{line_col(b, j)}: not well-formed (invalid token)" };
            }
            j += 1;
            let mut v = String.new();
            while j < n and b[j] != q {
                if b[j] == b'&' {
                    match xml_ref(b, j) {
                        Ok((t, e)) => {
                            v.push_str(t);
                            j = e;
                        }
                        Err((p, m)) => {
                            return XRes { evs: evs, err: f"{line_col(b, p)}: {m}" };
                        }
                    }
                    continue;
                }
                if b[j] == b'<' {
                    return XRes { evs: evs, err: f"{line_col(b, j)}: not well-formed (invalid token)" };
                }
                if b[j] == b'\n' or b[j] == b'\t' or b[j] == b'\r' {
                    v.push_str(" ");
                } else {
                    v.push_str(byte_str(b, j, j + 1));
                }
                j += 1;
            }
            j += 1;
            for a in raw {
                if a.0 == an {
                    return XRes { evs: evs, err: f"{line_col(b, ns0)}: duplicate attribute" };
                }
            }
            raw.push((an, v));
        }
        let mark = scopes.len() as i64;
        for a in raw {
            if a.0 == "xmlns" {
                scopes.push((String.new(), a.1.clone()));
                let mut e = xev(3);
                e.local = String.new();
                e.text = a.1.clone();
                evs.push(e);
            } else if starts_with(a.0, "xmlns:") {
                scopes.push((slice_from(a.0, 6), a.1.clone()));
                let mut e = xev(3);
                e.local = slice_from(a.0, 6);
                e.text = a.1.clone();
                evs.push(e);
            }
        }
        let p = partition(name, b':');
        let (pre, loc) = if p.1 { (p.0, p.2) } else { (String.new(), p.0) };
        let mut e = xev(0);
        match ns_lookup(scopes, pre) {
            Some(u) => {
                if u.len() > 0 {
                    e.ns = u;
                    e.has_ns = true;
                }
            }
            None => {
                if pre.len() > 0 {
                    return XRes { evs: evs, err: f"{line_col(b, i)}: unbound prefix" };
                }
            }
        }
        e.local = loc;
        for a in raw {
            if a.0 == "xmlns" or starts_with(a.0, "xmlns:") {
                continue;
            }
            let ap = partition(a.0, b':');
            if ap.1 {
                match ns_lookup(scopes, ap.0) {
                    Some(u) => e.attrs.push((u, ap.2.clone(), a.1.clone())),
                    None => {
                        return XRes { evs: evs, err: f"{line_col(b, i)}: unbound prefix" };
                    }
                }
            } else {
                e.attrs.push((String.new(), a.0.clone(), a.1.clone()));
            }
        }
        let endev = if empty {
            let mut x = xev(1);
            x.ns = e.ns.clone();
            x.has_ns = e.has_ns;
            x.local = e.local.clone();
            Some(x)
        } else {
            None
        };
        evs.push(e);
        seen_root = true;
        match endev {
            Some(x) => {
                evs.push(x);
                while scopes.len() as i64 > mark {
                    scopes.pop();
                }
            }
            None => stack.push((name, mark)),
        }
        i = j;
    }
    if stack.len() > 0 or not seen_root {
        return XRes { evs: evs, err: f"{line_col(b, n)}: no element found" };
    }
    XRes { evs: evs, err: String.new() }
}

// ---- _FeedParserMixin and the _base / dc / itunes namespace handlers.

struct P {
    st: Store,
    feed: i64,
    entries: i64,
    version: String,
    nsuse: i64,
    nsmap: Vec[(String, String)],
    infeed: bool,
    inentry: bool,
    incontent: i64,
    intextinput: bool,
    inimage: bool,
    inauthor: bool,
    incontributor: bool,
    inpublisher: bool,
    insource: bool,
    sourcedata: i64,
    cp: i64,
    summary_key: String,
    stack: Vec[(String, bool, Vec[String])],
    basestack: Vec[String],
    langstack: Vec[String],
    baseuri: String,
    lang: String,
    title_depth: i64,
    depth: i64,
    has_content: bool,
    guidislink: bool,
    pdm: Vec[(i64, String, i64)],
    loose: bool,
}

fn p_new(base: Str, loose: bool) -> P {
    let mut st = store_new();
    let feed = d_new(mut st);
    let entries = l_new(mut st);
    let nsuse = d_new(mut st);
    let sd = d_new(mut st);
    let cp = d_new(mut st);
    P { st: st, feed: feed, entries: entries, version: String.new(), nsuse: nsuse, nsmap: Vec.new(),
        infeed: false, inentry: false, incontent: 0, intextinput: false, inimage: false, inauthor: false,
        incontributor: false, inpublisher: false, insource: false, sourcedata: sd, cp: cp,
        summary_key: String.new(), stack: Vec.new(), basestack: Vec.new(), langstack: Vec.new(),
        baseuri: base.to_string(), lang: String.new(), title_depth: -1, depth: 0, has_content: false,
        guidislink: false, pdm: Vec.new(), loose: loose }
}

fn last_entry(p: ref P) -> i64 {
    let n = p.st.ls[p.entries].len();
    val_dict(p.st.ls[p.entries][n - 1])
}

fn cp_type(p: ref P, dflt: Str) -> String {
    match d_raw(p.st, p.cp, "type") {
        Some(Val.Str(s)) => s,
        Some(_) => String.new(),
        None => dflt.to_string(),
    }
}

fn map_content_type(t: Str) -> String {
    let l = lower(t);
    if l == "text" or l == "plain" { "text/plain".to_string() } else if l == "html" { "text/html".to_string() } else if l == "xhtml" { "application/xhtml+xml".to_string() } else { l }
}

fn is_htmlish(t: Str) -> bool {
    t == "application/xhtml+xml" or t == "text/html"
}

fn get_context(p: ref P) -> i64 {
    if p.insource {
        return p.sourcedata;
    }
    if p.inimage and d_has(p.st, p.feed, "image") {
        return val_dict(d_raw(p.st, p.feed, "image").unwrap());
    }
    if p.intextinput {
        return val_dict(d_raw(p.st, p.feed, "textinput").unwrap_or(Val.Null));
    }
    if p.inentry {
        return last_entry(p);
    }
    p.feed
}

fn track_namespace(t: ref Tables, p: mut ref P, prefix: Str, uri0: Str) {
    let mut uri = uri0.to_string();
    let mut lu = lower(uri);
    if p.version.len() == 0 {
        if prefix == "" and lu == "http://my.netscape.com/rdf/simple/0.9/" {
            p.version = "rss090".to_string();
        } else if lu == "http://purl.org/rss/1.0/" {
            p.version = "rss10".to_string();
        } else if lu == "http://www.w3.org/2005/atom" {
            p.version = "atom10".to_string();
        }
    }
    if find_str(lu, "backend.userland.com/rss") >= 0 {
        uri = "http://backend.userland.com/rss".to_string();
        lu = uri.clone();
    }
    for i in 0..t.ns_uri.len() {
        if lower(t.ns_uri[i]) == lu {
            let pre = t.ns_pre[i].clone();
            // the default namespace is tracked under None, which no lookup uses
            let mut found = prefix == "";
            for j in 0..p.nsmap.len() {
                if p.nsmap[j].0 == prefix {
                    p.nsmap[j].1 = pre.clone();
                    found = true;
                }
            }
            if not found {
                p.nsmap.push((prefix.to_string(), pre.clone()));
            }
            d_put(mut p.st, p.nsuse, pre, Val.Str(uri));
            return;
        }
    }
    d_put(mut p.st, p.nsuse, prefix, Val.Str(uri));
}

fn nsmap_get(p: ref P, k: Str) -> String {
    for x in p.nsmap {
        if x.0 == k {
            return x.1.clone();
        }
    }
    k.to_string()
}

fn strattrs(p: ref P, attrs: ref Vec[(String, String)]) -> String {
    let mut s = String.new();
    for a in attrs {
        let v = if p.loose { a.1.replace("\"", "&quot;") } else { xml_escape(a.1).replace("\"", "&quot;") };
        s.push_str(f" {a.0}=\"{v}\"");
    }
    s
}

fn handle_data(p: mut ref P, text: Str, escape: bool) {
    if p.stack.len() == 0 {
        return;
    }
    let t = if escape and cp_type(p, "") == "application/xhtml+xml" { xml_escape(text) } else { text.to_string() };
    let n = p.stack.len();
    p.stack[n - 1].2.push(t);
}

fn attr_get(a: ref Vec[(String, String)], k: Str) -> Option[String] {
    for x in a {
        if x.0 == k {
            return Some(x.1.clone());
        }
    }
    None
}

fn attr_set(a: mut ref Vec[(String, String)], k: Str, v: Str) {
    for i in 0..a.len() {
        if a[i].0 == k {
            a[i].1 = v.to_string();
            return;
        }
    }
    a.push((k.to_string(), v.to_string()));
}

fn unknown_starttag(t: ref Tables, p: mut ref P, tag0: Str, attrs0: ref Vec[(String, String)]) {
    p.depth += 1;
    let mut attrs: Vec[(String, String)] = Vec.new();
    for a in attrs0 {
        let k = lower(a.0);
        let mut v = if k == "rel" or k == "type" { lower(a.1) } else { a.1.clone() };
        if p.loose {
            v = v.replace("&amp;", "&");
        }
        attrs.push((k, v));
    }
    let mut ad: Vec[(String, String)] = Vec.new();
    for a in attrs {
        attr_set(mut ad, a.0, a.1);
    }
    let bu = match attr_get(ad, "xml:base") { Some(x) => Some(x), None => attr_get(ad, "base") };
    let baseuri = match bu {
        Some(x) => if x.len() > 0 { x } else { p.baseuri.clone() },
        None => p.baseuri.clone(),
    };
    if p.baseuri.len() > 0 {
        let r = safe_uri(t, p.baseuri, baseuri);
        if r.len() > 0 {
            p.baseuri = r;
        }
    } else {
        p.baseuri = urljoin_fp(p.baseuri, baseuri);
    }
    let lg = match attr_get(ad, "xml:lang") { Some(x) => Some(x), None => attr_get(ad, "lang") };
    let lang = match lg {
        Some(x) => x,
        None => p.lang.clone(),
    };
    if lang.len() > 0 and (tag0 == "feed" or tag0 == "rss" or tag0 == "rdf:rdf") {
        d_put(mut p.st, p.feed, "language", Val.Str(lang.replace("_", "-")));
    }
    p.lang = lang.clone();
    p.basestack.push(p.baseuri.clone());
    p.langstack.push(lang);
    for a in attrs {
        if starts_with(a.0, "xmlns:") {
            track_namespace(t, mut p, slice_from(a.0, 6), a.1);
        } else if a.0 == "xmlns" {
            track_namespace(t, mut p, "", a.1);
        }
    }
    let mut tag = tag0.to_string();
    if p.incontent > 0 and not ends_with(cp_type(p, "xml"), "xml") {
        if tag == "xhtml:div" or tag == "div" {
            return;
        }
        d_put(mut p.st, p.cp, "type", sv("application/xhtml+xml"));
    }
    if p.incontent > 0 and cp_type(p, "") == "application/xhtml+xml" {
        let pt = partition(tag, b':');
        if pt.1 {
            tag = pt.2;
        }
        let s = f"<{tag}{strattrs(p, attrs)}>";
        handle_data(mut p, s, false);
        return;
    }
    let pt = partition(tag, b':');
    let (pre0, suffix) = if pt.1 { (pt.0, pt.2) } else { (String.new(), pt.0) };
    let mut prefix = nsmap_get(p, pre0);
    if prefix.len() > 0 {
        prefix = f"{prefix}_";
    }
    if prefix.len() == 0 and not (tag == "title" or tag == "link" or tag == "description" or tag == "name") {
        p.intextinput = false;
    }
    if prefix.len() == 0 and not (tag == "title" or tag == "link" or tag == "description" or tag == "url" or tag == "href" or tag == "width" or tag == "height") {
        p.inimage = false;
    }
    let name = f"{prefix}{suffix}";
    if not start_handler(t, mut p, name, mut ad) {
        if ad.len() == 0 {
            push(mut p, name, true);
        } else {
            let c = get_context(p);
            let nd = d_new(mut p.st);
            for a in ad {
                d_put(mut p.st, nd, a.0, Val.Str(a.1.clone()));
            }
            fset(mut p.st, c, name, Val.D(nd));
        }
    }
}

fn unknown_endtag(t: ref Tables, p: mut ref P, tag: Str) {
    let pt = partition(tag, b':');
    let (pre0, suffix) = if pt.1 { (pt.0, pt.2) } else { (String.new(), pt.0) };
    let mut prefix = nsmap_get(p, pre0);
    if prefix.len() > 0 {
        prefix = f"{prefix}_";
    }
    let name = f"{prefix}{suffix}";
    if not end_handler(t, mut p, name) {
        let _ = pop(t, mut p, name, true);
    }
    let mut skip = false;
    if p.incontent > 0 and not ends_with(cp_type(p, "xml"), "xml") {
        if tag == "xhtml:div" or tag == "div" {
            skip = true;
        } else {
            d_put(mut p.st, p.cp, "type", sv("application/xhtml+xml"));
        }
    }
    if not skip {
        if p.incontent > 0 and cp_type(p, "") == "application/xhtml+xml" {
            let parts = split_on(tag, b':');
            let l = parts[parts.len() - 1].clone();
            handle_data(mut p, f"</{l}>", false);
        }
    }
    if p.basestack.len() > 0 {
        p.basestack.pop();
        if p.basestack.len() > 0 and p.basestack[p.basestack.len() - 1].len() > 0 {
            p.baseuri = p.basestack[p.basestack.len() - 1].clone();
        }
    }
    if p.langstack.len() > 0 {
        p.langstack.pop();
        if p.langstack.len() > 0 {
            p.lang = p.langstack[p.langstack.len() - 1].clone();
        }
    }
    p.depth -= 1;
}

fn push(p: mut ref P, el: Str, expecting: bool) {
    p.stack.push((el.to_string(), expecting, Vec.new()));
}

fn ends_with(s: Str, suf: Str) -> bool {
    s.ends_with(suf)
}

fn looks_like_html(t: ref Tables, s: Str) -> bool {
    let b = to_bytes(s);
    let n = b.len() as i64;
    let mut close_tag = false;
    let mut ref_seen = false;
    for i in 0..n {
        if b[i] == b'<' and bat(b, i + 1) == b'/' {
            let e = css_word_end(b, i + 2);
            if e > i + 2 and bat(b, e) == b'>' {
                close_tag = true;
            }
        }
        if b[i] == b'&' {
            let st = if bat(b, i + 1) == b'#' { i + 2 } else { i + 1 };
            let e = css_word_end(b, st);
            if e > st and bat(b, e) == b';' {
                ref_seen = true;
            }
        }
    }
    if not (close_tag or ref_seen) {
        return false;
    }
    let mut i: i64 = 0;
    while i < n {
        if b[i] == b'<' {
            let st = if bat(b, i + 1) == b'/' { i + 2 } else { i + 1 };
            let e = css_word_end(b, st);
            if e > st {
                if not in_list(t.elems, lower(byte_str(b, st, e))) {
                    return false;
                }
                i = e;
                continue;
            }
        }
        if b[i] == b'&' {
            let e = css_word_end(b, i + 1);
            if e > i + 1 and bat(b, e) == b';' {
                if ent_cp(t, byte_str(b, i + 1, e)) < 0 {
                    return false;
                }
                i = e + 1;
                continue;
            }
        }
        i += 1;
    }
    true
}

fn css_word_end(b: ref Vec[u8], i: i64) -> i64 {
    let mut j = i;
    while j < b.len() as i64 and is_word(b[j]) {
        j += 1;
    }
    j
}

fn loose_decode(p: ref P, d0: Str) -> String {
    let mut d = d0.replace("&#60;", "&lt;").replace("&#x3c;", "&lt;").replace("&#x3C;", "&lt;")
        .replace("&#62;", "&gt;").replace("&#x3e;", "&gt;").replace("&#x3E;", "&gt;")
        .replace("&#38;", "&amp;").replace("&#x26;", "&amp;").replace("&#34;", "&quot;")
        .replace("&#x22;", "&quot;").replace("&#39;", "&apos;").replace("&#x27;", "&apos;");
    if not ends_with(cp_type(p, "xml"), "xml") {
        d = d.replace("&lt;", "<").replace("&gt;", ">").replace("&amp;", "&").replace("&quot;", "\"")
            .replace("&apos;", "'").replace("&#x2f;", "/").replace("&#x2F;", "/");
    }
    d
}

// &([A-Za-z0-9_]+);  ->  &\1
fn amp_unsemi(s: Str) -> String {
    let b = to_bytes(s);
    let n = b.len() as i64;
    let mut out = String.new();
    let mut last: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        if b[i] == b'&' {
            let mut j = i + 1;
            while j < n and (is_alnum(b[j]) or b[j] == b'_') {
                j += 1;
            }
            if j > i + 1 and bat(b, j) == b';' {
                out.push_str(byte_str(b, last, j));
                last = j + 1;
                i = j + 1;
                continue;
            }
        }
        i += 1;
    }
    out.push_str(byte_str(b, last, n));
    out
}

fn pop(t: ref Tables, p: mut ref P, el0: Str, strip_ws: bool) -> Option[String] {
    if p.stack.len() == 0 or p.stack[p.stack.len() - 1].0 != el0 {
        return None;
    }
    let (_, expecting, pieces0) = p.stack.pop().unwrap();
    let mut pieces = pieces0;
    let mut el = el0.to_string();
    if p.version == "atom10" and cp_type(p, "text") == "application/xhtml+xml" {
        while pieces.len() > 1 and strip(pieces[pieces.len() - 1]).len() == 0 {
            pieces.pop();
        }
        while pieces.len() > 1 and strip(pieces[0]).len() == 0 {
            pieces.remove(0);
        }
        if pieces.len() > 0 and (pieces[0] == "<div>" or starts_with(pieces[0], "<div ")) and pieces[pieces.len() - 1] == "</div>" {
            let mut depth: i64 = 0;
            let mut broke = false;
            for k in 0..(pieces.len() - 1) {
                let pc = ref pieces[k];
                if starts_with(pc, "</") {
                    depth -= 1;
                    if depth == 0 {
                        broke = true;
                        break;
                    }
                } else if starts_with(pc, "<") and not ends_with(pc, "/>") {
                    depth += 1;
                }
            }
            if not broke {
                pieces.remove(0);
                pieces.pop();
            }
        }
    }
    let mut output = String.new();
    for pc in pieces {
        output.push_str(pc);
    }
    if strip_ws {
        output = strip(output);
    }
    if not expecting {
        return Some(output);
    }
    let can_be_rel = ["comments", "docs", "href", "icon", "id", "link", "logo", "url", "wfw_comment", "wfw_commentrss"];
    let mut is_rel = false;
    for x in can_be_rel {
        if x == el {
            is_rel = true;
        }
    }
    if is_rel and output.len() > 0 and (el != "id" or p.guidislink) {
        output = urljoin_fp(p.baseuri, output);
    }
    if p.loose {
        output = loose_decode(p, output);
    }
    if not starts_with(p.version, "atom") and cp_type(p, "") == "text/plain" {
        if looks_like_html(t, output) {
            d_put(mut p.st, p.cp, "type", sv("text/html"));
        }
    }
    d_del(mut p.st, p.cp, "mode");
    d_del(mut p.st, p.cp, "base64");
    let ty = cp_type(p, "text/html");
    let htmlish = is_htmlish(map_content_type(ty));
    let rich = ["content", "copyright", "description", "info", "rights", "subtitle", "summary", "tagline", "title"];
    let mut is_rich = false;
    for x in rich {
        if x == el {
            is_rich = true;
        }
    }
    if htmlish and is_rich {
        output = resolve_relative(t, output, p.baseuri, ty);
        output = sanitize_html(t, output, ty);
    }
    output = translate_cp1252(t, output);
    if el == "category" or el == "tags" or el == "itunes_keywords" {
        return Some(output);
    }
    if el == "title" and -1 < p.title_depth and p.title_depth <= p.depth {
        return Some(output);
    }
    if p.inentry and not p.insource {
        let e = last_entry(p);
        if el == "content" {
            let l = fsetdefault(mut p.st, e, "content", Val.L(l_new(mut p.st)));
            let c = deep_copy(mut p.st, Val.D(p.cp));
            d_put(mut p.st, val_dict(c), "value", Val.Str(output.clone()));
            p.st.ls[val_list(l)].push(c);
        } else if el == "link" {
            if not p.inimage {
                output = amp_unsemi(output.replace("&amp;", "&"));
                fset(mut p.st, e, "link", Val.Str(output.clone()));
                if output.len() > 0 {
                    let links = val_list(fget(p.st, e, "links").unwrap());
                    let n = p.st.ls[links].len();
                    let ld = val_dict(p.st.ls[links][n - 1]);
                    fset(mut p.st, ld, "href", Val.Str(output.clone()));
                }
            }
        } else {
            if el == "description" {
                el = "summary".to_string();
            }
            let mut old: i64 = -1;
            for x in p.pdm {
                if x.0 == e and x.1 == el {
                    old = x.2;
                }
            }
            if old < 0 or p.depth <= old {
                let mut found = false;
                for k in 0..p.pdm.len() {
                    if p.pdm[k].0 == e and p.pdm[k].1 == el {
                        p.pdm[k].2 = p.depth;
                        found = true;
                    }
                }
                if not found {
                    p.pdm.push((e, el.clone(), p.depth));
                }
                fset(mut p.st, e, el, Val.Str(output.clone()));
            }
            if p.incontent > 0 {
                let c = deep_copy(mut p.st, Val.D(p.cp));
                d_put(mut p.st, val_dict(c), "value", Val.Str(output.clone()));
                fset(mut p.st, e, f"{el}_detail", c);
            }
        }
    } else if p.infeed or p.insource {
        let ctx = get_context(p);
        if el == "description" {
            el = "subtitle".to_string();
        }
        fset(mut p.st, ctx, el, Val.Str(output.clone()));
        if el == "link" {
            output = amp_unsemi(output);
            fset(mut p.st, ctx, el, Val.Str(output.clone()));
            let links = val_list(fget(p.st, ctx, "links").unwrap());
            let n = p.st.ls[links].len();
            let ld = val_dict(p.st.ls[links][n - 1]);
            fset(mut p.st, ld, "href", Val.Str(output.clone()));
        } else if p.incontent > 0 {
            let c = deep_copy(mut p.st, Val.D(p.cp));
            d_put(mut p.st, val_dict(c), "value", Val.Str(output.clone()));
            fset(mut p.st, ctx, f"{el}_detail", c);
        }
    }
    Some(output)
}

fn push_content(p: mut ref P, tag: Str, ad: ref Vec[(String, String)], dflt: Str, expecting: bool) {
    p.incontent += 1;
    p.lang = p.lang.replace("_", "-");
    p.cp = d_new(mut p.st);
    let ty = map_content_type(attr_get(ad, "type").unwrap_or(dflt.to_string()));
    d_put(mut p.st, p.cp, "type", Val.Str(ty.clone()));
    d_put(mut p.st, p.cp, "language", if p.lang.len() > 0 { Val.Str(p.lang.clone()) } else { Val.Null });
    d_put(mut p.st, p.cp, "base", Val.Str(p.baseuri.clone()));
    let b64 = attr_get(ad, "mode").unwrap_or(String.new()) == "base64" or not (starts_with(ty, "text/") or ends_with(ty, "+xml") or ends_with(ty, "/xml"));
    d_put(mut p.st, p.cp, "base64", Val.Int(if b64 { 1 } else { 0 }));
    push(mut p, tag, expecting);
}

fn pop_content(t: ref Tables, p: mut ref P, tag: Str) -> Option[String] {
    let v = pop(t, mut p, tag, true);
    p.incontent -= 1;
    d_clear(mut p.st, p.cp);
    v
}

fn ctx_list(p: mut ref P, c: i64, k: Str) -> i64 {
    let l = fsetdefault(mut p.st, c, k, Val.L(l_new(mut p.st)));
    val_list(l)
}

fn save(p: mut ref P, k: Str, v: own Val, overwrite: bool) {
    let c = get_context(p);
    if overwrite {
        fset(mut p.st, c, k, v);
    } else {
        let _ = fsetdefault(mut p.st, c, k, v);
    }
}

fn save_author(p: mut ref P, k: Str, v: Str, prefix: Str) {
    let c = get_context(p);
    let det = val_dict(fsetdefault(mut p.st, c, f"{prefix}_detail", Val.D(d_new(mut p.st))));
    fset(mut p.st, det, k, sv(v));
    sync_author(mut p, "author");
    let l = fsetdefault(mut p.st, c, "authors", Val.L(l_new(mut p.st)));
    let li = val_list(l);
    if p.st.ls[li].len() == 0 {
        let nd = d_new(mut p.st);
        p.st.ls[li].push(Val.D(nd));
    }
    let last = val_dict(p.st.ls[li][p.st.ls[li].len() - 1]);
    fset(mut p.st, last, k, sv(v));
}

fn save_contributor(p: mut ref P, k: Str, v: Str) {
    let c = get_context(p);
    let li = ctx_list(mut p, c, "contributors");
    if p.st.ls[li].len() == 0 {
        let nd = d_new(mut p.st);
        p.st.ls[li].push(Val.D(nd));
    }
    let last = val_dict(p.st.ls[li][p.st.ls[li].len() - 1]);
    fset(mut p.st, last, k, sv(v));
}

// The email pattern of _sync_author_detail, searched; (start, end) or None.
fn find_email(s: Str) -> Option[(i64, i64)] {
    let b = to_bytes(s);
    let n = b.len() as i64;
    for st in 0..n {
        let lc = |c: u8| is_alnum(c) or c == b'_' or c == b'-' or c == b'.' or c == b'+';
        if not lc(b[st]) {
            continue;
        }
        let mut at = st;
        while at < n and lc(b[at]) {
            at += 1;
        }
        if bat(b, at) != b'@' {
            continue;
        }
        let mut ends: Vec[i64] = Vec.new();
        let mut q = at + 1;
        loop {
            let mut r = q;
            while r < n and (is_alnum(b[r]) or b[r] == b'-') {
                r += 1;
            }
            if r > q and bat(b, r) == b'.' {
                ends.push(r + 1);
                q = r + 1;
            } else {
                break;
            }
        }
        let mut k = ends.len() as i64 - 1;
        while k >= 0 {
            let d = ends[k];
            let mut e = d;
            while e < n and e - d < 4 and is_alpha(b[e]) {
                e += 1;
            }
            if e - d < 2 {
                e = d;
                while e < n and e - d < 3 and is_digit(b[e]) {
                    e += 1;
                }
            }
            if e > d {
                if bat(b, e) == b']' {
                    e += 1;
                }
                return Some((st, e));
            }
            k -= 1;
        }
    }
    None
}

fn sync_author(p: mut ref P, key: Str) {
    let c = get_context(p);
    let mut det: i64 = -1;
    match fget(p.st, c, f"{key}s") {
        Some(Val.L(l)) => {
            if p.st.ls[l].len() > 0 {
                det = val_dict(p.st.ls[l][p.st.ls[l].len() - 1]);
            }
        }
        _ => {}
    }
    if det >= 0 and p.st.dk[det].len() > 0 {
        let name = fget_str(p.st, det, "name");
        let email = fget_str(p.st, det, "email");
        if name.len() > 0 and email.len() > 0 {
            fset(mut p.st, c, key, Val.Str(f"{name} ({email})"));
        } else if name.len() > 0 {
            fset(mut p.st, c, key, Val.Str(name));
        } else if email.len() > 0 {
            fset(mut p.st, c, key, Val.Str(email));
        }
        return;
    }
    let mut author = fget_str(p.st, c, key);
    if author.len() == 0 {
        return;
    }
    let mut email = String.new();
    match find_email(author) {
        Some((s, e)) => {
            let ab = to_bytes(author);
            email = byte_str(ab, s, e);
            author = strip(author.replace(email, "").replace("()", "").replace("<>", "").replace("&lt;&gt;", ""));
            if starts_with(author, "(") {
                author = slice_from(author, 1);
            }
            if ends_with(author, ")") {
                let ab2 = to_bytes(author);
                author = byte_str(ab2, 0, ab2.len() as i64 - 1);
            }
            author = strip(author);
        }
        None => {}
    }
    let dd = if det >= 0 { det } else { d_new(mut p.st) };
    if author.len() > 0 or email.len() > 0 {
        let _ = fsetdefault(mut p.st, c, f"{key}_detail", Val.D(dd));
    }
    if author.len() > 0 {
        fset(mut p.st, dd, "name", Val.Str(author));
    }
    if email.len() > 0 {
        fset(mut p.st, dd, "email", Val.Str(email));
    }
}

fn opt_val(s: ref Option[String]) -> Val {
    match s {
        Some(x) => Val.Str(x.clone()),
        None => Val.Null,
    }
}

fn add_tag(p: mut ref P, term: Option[String], scheme: Option[String], label: Option[String]) {
    let c = get_context(p);
    let tags = ctx_list(mut p, c, "tags");
    let e = |o: ref Option[String]| match o { Some(x) => x.len() == 0, None => true };
    if e(term) and e(scheme) and e(label) {
        return;
    }
    let nd = d_new(mut p.st);
    fset(mut p.st, nd, "term", opt_val(term));
    fset(mut p.st, nd, "scheme", opt_val(scheme));
    fset(mut p.st, nd, "label", opt_val(label));
    let v = Val.D(nd);
    for x in p.st.ls[tags] {
        if val_eq(p.st, x, v) {
            return;
        }
    }
    p.st.ls[tags].push(v);
}

fn enforce_href(ad: mut ref Vec[(String, String)]) {
    let h = match attr_get(ad, "url") { Some(x) => Some(x), None => match attr_get(ad, "uri") { Some(x) => Some(x), None => attr_get(ad, "href") } };
    match h {
        Some(x) => {
            if x.len() > 0 {
                ad.retain(|a| a.0 != "url" and a.0 != "uri");
                attr_set(mut ad, "href", x);
            }
        }
        None => {}
    }
}

fn attrs_dict(p: mut ref P, ad: ref Vec[(String, String)]) -> i64 {
    let nd = d_new(mut p.st);
    for a in ad {
        fset(mut p.st, nd, a.0, Val.Str(a.1.clone()));
    }
    nd
}

fn in_any(p: ref P) -> bool {
    p.infeed or p.inentry or p.insource
}

fn start_handler(t: ref Tables, p: mut ref P, name0: Str, ad: mut ref Vec[(String, String)]) -> bool {
    let al = [
        "managingeditor author", "dc_author author", "dc_creator author", "itunes_author author",
        "textInput textinput", "homepage url", "uri url", "tagline subtitle", "itunes_subtitle subtitle",
        "copyright rights", "dc_rights rights", "entry item", "issued published", "pubdate published",
        "dcterms_issued published", "modified updated", "lastbuilddate updated", "dc_date updated",
        "dcterms_modified updated", "keywords category", "dc_subject category", "id guid",
        "xhtml_body body", "fullitem content_encoded", "dc_description description",
        "dc_language language", "dc_publisher webmaster", "dc_title title", "itunes_name name",
        "itunes_email email", "itunes_summary summary", "dcterms_created created",
        "feedburner_browserfriendly info", "itunes_link itunes_image",
    ];
    let mut name = name0.to_string();
    for a in al {
        let pr = partition(a, b' ');
        if pr.0 == name {
            name = pr.2;
            break;
        }
    }
    let n = name.as_str();
    if n == "rss" {
        if p.version.len() == 0 or not starts_with(p.version, "rss") {
            let av = attr_get(ad, "version").unwrap_or(String.new());
            p.version = if av == "0.91" { "rss091u".to_string() } else if av == "0.92" { "rss092".to_string() } else if av == "0.93" { "rss093".to_string() } else if av == "0.94" { "rss094".to_string() } else if starts_with(av, "2.") { "rss20".to_string() } else { "rss".to_string() };
        }
    } else if n == "channel" {
        p.infeed = true;
    } else if n == "feed" {
        p.infeed = true;
        if p.version.len() == 0 {
            let av = attr_get(ad, "version").unwrap_or(String.new());
            p.version = if av == "0.1" { "atom01".to_string() } else if av == "0.2" { "atom02".to_string() } else if av == "0.3" { "atom03".to_string() } else { "atom".to_string() };
        }
    } else if n == "image" or n == "textinput" {
        let c = get_context(p);
        if n == "textinput" or not p.inentry {
            let _ = fsetdefault(mut p.st, c, n, Val.D(d_new(mut p.st)));
        }
        if n == "image" { p.inimage = true; } else { p.intextinput = true; }
        p.title_depth = -1;
        push(mut p, n, false);
    } else if n == "author" {
        p.inauthor = true;
        push(mut p, "author", true);
        let c = get_context(p);
        let l = ctx_list(mut p, c, "authors");
        let nd = d_new(mut p.st);
        p.st.ls[l].push(Val.D(nd));
    } else if n == "contributor" or n == "dc_contributor" {
        p.incontributor = true;
        let c = get_context(p);
        let l = ctx_list(mut p, c, "contributors");
        let nd = d_new(mut p.st);
        p.st.ls[l].push(Val.D(nd));
        push(mut p, if n == "contributor" { "contributor" } else { "name" }, false);
    } else if n == "name" or n == "width" or n == "height" or n == "email" {
        push(mut p, n, false);
    } else if n == "url" {
        push(mut p, "href", true);
    } else if n == "subtitle" or n == "rights" or n == "info" {
        push_content(mut p, n, ad, "text/plain", true);
    } else if n == "item" {
        let nd = d_new(mut p.st);
        p.st.ls[p.entries].push(Val.D(nd));
        push(mut p, "item", false);
        p.inentry = true;
        p.guidislink = false;
        p.title_depth = -1;
        let about = attr_get(ad, f"{nsmap_get(p, "rdf")}:about");
        match about {
            Some(x) => {
                if x.len() > 0 {
                    let c = get_context(p);
                    fset(mut p.st, c, "id", Val.Str(x));
                }
            }
            None => {}
        }
    } else if n == "language" or n == "published" or n == "updated" or n == "created" {
        push(mut p, n, true);
    } else if n == "webmaster" {
        push(mut p, "publisher", true);
    } else if n == "category" or n == "itunes_category" {
        if n == "itunes_category" {
            add_tag(mut p, attr_get(ad, "text"), Some("http://www.itunes.com/".to_string()), None);
        } else {
            let sch = match attr_get(ad, "scheme") { Some(x) => Some(x), None => attr_get(ad, "domain") };
            add_tag(mut p, attr_get(ad, "term"), sch, attr_get(ad, "label"));
        }
        push(mut p, "category", true);
    } else if n == "cloud" {
        let c = get_context(p);
        let nd = attrs_dict(mut p, ad);
        fset(mut p.st, c, "cloud", Val.D(nd));
    } else if n == "link" {
        if attr_get(ad, "rel").is_none() {
            attr_set(mut ad, "rel", "alternate");
        }
        if attr_get(ad, "rel").unwrap() == "self" {
            if attr_get(ad, "type").is_none() { attr_set(mut ad, "type", "application/atom+xml"); }
        } else if attr_get(ad, "type").is_none() {
            attr_set(mut ad, "type", "text/html");
        }
        let c = get_context(p);
        enforce_href(mut ad);
        match attr_get(ad, "href") {
            Some(h) => attr_set(mut ad, "href", urljoin_fp(p.baseuri, h)),
            None => {}
        }
        let expecting = in_any(p);
        let l = ctx_list(mut p, c, "links");
        if not (p.inentry and p.inimage) {
            let nd = attrs_dict(mut p, ad);
            p.st.ls[l].push(Val.D(nd));
        }
        match attr_get(ad, "href") {
            Some(h) => {
                if attr_get(ad, "rel").unwrap_or(String.new()) == "alternate" and is_htmlish(map_content_type(attr_get(ad, "type").unwrap_or(String.new()))) {
                    fset(mut p.st, c, "link", Val.Str(h));
                }
            }
            None => push(mut p, "link", expecting),
        }
    } else if n == "guid" {
        p.guidislink = attr_get(ad, "ispermalink").unwrap_or("true".to_string()) == "true";
        push(mut p, "id", true);
    } else if n == "title" {
        let e = in_any(p);
        push_content(mut p, "title", ad, "text/plain", e);
    } else if n == "description" or n == "summary" {
        let c = get_context(p);
        if fhas(p.st, c, "summary") and not p.has_content {
            p.summary_key = "content".to_string();
            p.has_content = true;
            push_content(mut p, "content", ad, "text/plain", true);
            push(mut p, "content", true);
        } else if n == "description" {
            let e = in_any(p);
            push_content(mut p, "description", ad, "text/html", e);
        } else {
            p.summary_key = "summary".to_string();
            push_content(mut p, "summary", ad, "text/plain", true);
        }
    } else if n == "generator" {
        enforce_href(mut ad);
        match attr_get(ad, "href") {
            Some(h) => attr_set(mut ad, "href", urljoin_fp(p.baseuri, h)),
            None => {}
        }
        let c = get_context(p);
        let nd = attrs_dict(mut p, ad);
        fset(mut p.st, c, "generator_detail", Val.D(nd));
        push(mut p, "generator", true);
    } else if n == "enclosure" {
        enforce_href(mut ad);
        let c = get_context(p);
        attr_set(mut ad, "rel", "enclosure");
        let l = ctx_list(mut p, c, "links");
        let nd = attrs_dict(mut p, ad);
        p.st.ls[l].push(Val.D(nd));
    } else if n == "source" {
        match attr_get(ad, "url") {
            Some(u) => fset(mut p.st, p.sourcedata, "href", Val.Str(u)),
            None => {}
        }
        push(mut p, "source", true);
        p.insource = true;
        p.title_depth = -1;
    } else if n == "content" {
        p.has_content = true;
        push_content(mut p, "content", ad, "text/plain", true);
        match attr_get(ad, "src") {
            Some(s) => {
                if s.len() > 0 {
                    d_put(mut p.st, p.cp, "src", Val.Str(s));
                }
            }
            None => {}
        }
        push(mut p, "content", true);
    } else if n == "body" {
        push_content(mut p, "content", ad, "application/xhtml+xml", true);
    } else if n == "content_encoded" {
        p.has_content = true;
        push_content(mut p, "content", ad, "text/html", true);
    } else if n == "itunes_owner" {
        p.inpublisher = true;
        push(mut p, "publisher", false);
    } else if n == "itunes_image" {
        push(mut p, "itunes_image", false);
        let h = attr_get(ad, "href").unwrap_or(String.new());
        let u = attr_get(ad, "url").unwrap_or(String.new());
        if h.len() > 0 or u.len() > 0 {
            let c = get_context(p);
            let nd = d_new(mut p.st);
            fset(mut p.st, nd, "href", Val.Str(if h.len() > 0 { h } else { u }));
            fset(mut p.st, c, "image", Val.D(nd));
        }
    } else if n == "tags" {
        push(mut p, "tags", true);
    } else {
        return false;
    }
    true
}

fn end_handler(t: ref Tables, p: mut ref P, name0: Str) -> bool {
    let al = [
        "feed channel", "textInput textinput", "managingeditor author", "dc_author author",
        "dc_creator author", "itunes_author author", "homepage url", "uri url", "tagline subtitle",
        "itunes_subtitle subtitle", "copyright rights", "dc_rights rights", "entry item",
        "issued published", "pubdate published", "dcterms_issued published", "modified updated",
        "lastbuilddate updated", "dc_date updated", "dcterms_modified updated", "keywords category",
        "dc_subject category", "itunes_category category", "id guid", "abstract description",
        "dc_description description", "body content", "xhtml_body content", "content_encoded content",
        "fullitem content", "dc_language language", "dc_publisher webmaster", "dc_title title",
        "itunes_name name", "itunes_email email", "itunes_summary summary", "dcterms_created created",
        "feedburner_browserfriendly info",
    ];
    let mut name = name0.to_string();
    for a in al {
        let pr = partition(a, b' ');
        if pr.0 == name {
            name = pr.2;
            break;
        }
    }
    let n = name.as_str();
    if n == "channel" {
        p.infeed = false;
    } else if n == "image" or n == "textinput" {
        let _ = pop(t, mut p, n, true);
        if n == "image" { p.inimage = false; } else { p.intextinput = false; }
    } else if n == "author" {
        let _ = pop(t, mut p, "author", true);
        p.inauthor = false;
        sync_author(mut p, "author");
    } else if n == "contributor" {
        let _ = pop(t, mut p, "contributor", true);
        p.incontributor = false;
    } else if n == "name" or n == "dc_contributor" {
        let v = pop(t, mut p, "name", true).unwrap_or(String.new());
        if p.inpublisher {
            save_author(mut p, "name", v, "publisher");
        } else if p.inauthor {
            save_author(mut p, "name", v, "author");
        } else if p.incontributor {
            save_contributor(mut p, "name", v);
        } else if p.intextinput {
            let c = get_context(p);
            fset(mut p.st, c, "name", Val.Str(v));
        }
        if n == "dc_contributor" {
            p.incontributor = false;
        }
    } else if n == "width" or n == "height" {
        let v = pop(t, mut p, n, true).unwrap_or(String.new());
        let iv = py_int(v).unwrap_or(0);
        if p.inimage {
            let c = get_context(p);
            fset(mut p.st, c, n, Val.Int(iv));
        }
    } else if n == "url" {
        let v = pop(t, mut p, "href", true).unwrap_or(String.new());
        if p.inauthor {
            save_author(mut p, "href", v, "author");
        } else if p.incontributor {
            save_contributor(mut p, "href", v);
        }
    } else if n == "email" {
        let v = pop(t, mut p, "email", true).unwrap_or(String.new());
        if p.inpublisher {
            save_author(mut p, "email", v, "publisher");
        } else if p.inauthor {
            save_author(mut p, "email", v, "author");
        } else if p.incontributor {
            save_contributor(mut p, "email", v);
        }
    } else if n == "subtitle" or n == "rights" or n == "info" {
        let _ = pop_content(t, mut p, n);
    } else if n == "item" {
        let _ = pop(t, mut p, "item", true);
        p.inentry = false;
        p.has_content = false;
    } else if n == "language" {
        p.lang = pop(t, mut p, "language", true).unwrap_or(String.new());
    } else if n == "webmaster" {
        let _ = pop(t, mut p, "publisher", true);
        sync_author(mut p, "publisher");
    } else if n == "published" or n == "updated" or n == "created" {
        let v = pop(t, mut p, n, true);
        let pd = match v { Some(s) => parse_date(s), None => Val.Null };
        save(mut p, f"{n}_parsed", pd, true);
    } else if n == "category" {
        let v = pop(t, mut p, "category", true).unwrap_or(String.new());
        if v.len() == 0 {
            return true;
        }
        let c = get_context(p);
        let tags = val_list(fget(p.st, c, "tags").unwrap());
        let nt = p.st.ls[tags].len();
        let mut set_last = false;
        if nt > 0 {
            let ld = val_dict(p.st.ls[tags][nt - 1]);
            let term = fget(p.st, ld, "term").unwrap_or(Val.Null);
            let empty = match term { Val.Str(s) => s.len() == 0, _ => true };
            if empty {
                fset(mut p.st, ld, "term", Val.Str(v.clone()));
                set_last = true;
            }
        }
        if not set_last {
            add_tag(mut p, Some(v), None, None);
        }
    } else if n == "link" {
        let _ = pop(t, mut p, "link", true);
    } else if n == "guid" {
        let v = pop(t, mut p, "id", true).unwrap_or(String.new());
        let c = get_context(p);
        let gl = p.guidislink and not fhas(p.st, c, "link");
        save(mut p, "guidislink", Val.Bool(gl), false);
        if p.guidislink {
            save(mut p, "link", Val.Str(v), false);
        }
    } else if n == "title" {
        let v = pop_content(t, mut p, "title").unwrap_or(String.new());
        if v.len() > 0 {
            p.title_depth = p.depth;
        }
    } else if n == "description" or n == "summary" {
        if p.summary_key == "content" {
            end_content(t, mut p);
        } else if n == "description" {
            let _ = pop_content(t, mut p, "description");
        } else {
            let k = if p.summary_key.len() > 0 { p.summary_key.clone() } else { "summary".to_string() };
            let _ = pop_content(t, mut p, k);
        }
        p.summary_key = String.new();
    } else if n == "generator" {
        let v = pop(t, mut p, "generator", true).unwrap_or(String.new());
        let c = get_context(p);
        match fget(p.st, c, "generator_detail") {
            Some(Val.D(g)) => fset(mut p.st, g, "name", Val.Str(v)),
            _ => {}
        }
    } else if n == "source" {
        p.insource = false;
        let v = pop(t, mut p, "source", true).unwrap_or(String.new());
        if v.len() > 0 {
            fset(mut p.st, p.sourcedata, "title", Val.Str(v));
        }
        let c = get_context(p);
        let cp = deep_copy(mut p.st, Val.D(p.sourcedata));
        fset(mut p.st, c, "source", cp);
        d_clear(mut p.st, p.sourcedata);
    } else if n == "content" {
        end_content(t, mut p);
    } else if n == "itunes_owner" {
        let _ = pop(t, mut p, "publisher", true);
        p.inpublisher = false;
        sync_author(mut p, "publisher");
    } else if n == "itunes_keywords" {
        let v = pop(t, mut p, "itunes_keywords", true).unwrap_or(String.new());
        for term in split_on(v, b',') {
            let s = strip(term);
            if s.len() > 0 {
                add_tag(mut p, Some(s), Some("http://www.itunes.com/".to_string()), None);
            }
        }
    } else if n == "itunes_block" {
        let v = pop(t, mut p, "itunes_block", false).unwrap_or(String.new());
        let c = get_context(p);
        fset(mut p.st, c, "itunes_block", Val.Int(if v == "yes" or v == "Yes" { 1 } else { 0 }));
    } else if n == "itunes_explicit" {
        let v = pop(t, mut p, "itunes_explicit", false).unwrap_or(String.new());
        let c = get_context(p);
        fset(mut p.st, c, "itunes_explicit", if v == "yes" { Val.Bool(true) } else if v == "clean" { Val.Bool(false) } else { Val.Null });
    } else if n == "tags" {
        let v = pop(t, mut p, "tags", true).unwrap_or(String.new());
        for term in split_on(v, b',') {
            add_tag(mut p, Some(strip(term)), None, None);
        }
    } else {
        return false;
    }
    true
}

fn end_content(t: ref Tables, p: mut ref P) {
    let ty = map_content_type(cp_type(p, ""));
    let copy = ty == "text/plain" or is_htmlish(ty);
    let v = pop_content(t, mut p, "content");
    if copy {
        save(mut p, "summary", opt_val(v), false);
    }
}

// ---- urls.py, datetimes (w3dtf, rfc822), encodings, the parse driver and
// the programs.

fn urljoin_fp(base: Str, uri0: Str) -> String {
    // _urifixer: ^([A-Za-z][A-Za-z0-9+-.]*://)(/*)(.*?)  ->  \1\3
    let b = to_bytes(uri0);
    let n = b.len() as i64;
    let mut uri = uri0.to_string();
    if n > 0 and is_alpha(b[0]) {
        let mut i: i64 = 1;
        while i < n and (is_alnum(b[i]) or (b[i] >= b'+' and b[i] <= b'.')) {
            i += 1;
        }
        if starts_at(b, i, "://") {
            let mut j = i + 3;
            while j < n and b[j] == b'/' {
                j += 1;
            }
            uri = f"{byte_str(b, 0, i + 3)}{byte_str(b, j, n)}";
        }
    }
    match urljoin(base, uri) {
        Ok(s) => s,
        Err(_) => String.new(),
    }
}

fn safe_uri(t: ref Tables, base: Str, rel: Str) -> String {
    if base.len() == 0 {
        return rel.to_string();
    }
    if rel.len() == 0 {
        let sch = match urlparse(base, "") { Ok(pp) => pp.scheme, Err(_) => return String.new() };
        if sch.len() == 0 or in_list(t.schemes, sch) {
            return base.to_string();
        }
        return String.new();
    }
    let u = urljoin_fp(base, rel);
    if not in_list(t.schemes, partition(strip(u), b':').0) {
        return String.new();
    }
    u
}

// int() of a str: optional whitespace and sign, digits with single '_'.
fn py_int(s: Str) -> Option[i64] {
    let t = strip(s);
    let b = to_bytes(t);
    let n = b.len() as i64;
    let mut i: i64 = 0;
    let mut neg = false;
    if i < n and (b[i] == b'+' or b[i] == b'-') {
        neg = b[i] == b'-';
        i += 1;
    }
    if i >= n or not is_digit(b[i]) {
        return None;
    }
    let mut v: i64 = 0;
    while i < n {
        if is_digit(b[i]) {
            v = v * 10 + (b[i] - b'0') as i64;
        } else if b[i] == b'_' and is_digit(bat(b, i + 1)) and i > 0 and is_digit(b[i - 1]) {
        } else {
            return None;
        }
        i += 1;
    }
    Some(if neg { -v } else { v })
}

// int(float(s)) for the time fields of w3dtf.
fn py_int_float(s: Str) -> Option[i64] {
    let t = strip(s);
    let p = partition(t, b'.');
    if not p.1 {
        return py_int(t);
    }
    let whole = if p.0.len() == 0 or p.0 == "-" or p.0 == "+" { f"{p.0}0" } else { p.0.clone() };
    for c in to_bytes(p.2) {
        if not is_digit(c) {
            return None;
        }
    }
    if p.0.len() == 0 and p.2.len() == 0 {
        return None;
    }
    py_int(whole)
}

fn is_leap(y: i64) -> bool {
    (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
}

fn mdays(y: i64, m: i64) -> i64 {
    let d = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    if m == 2 and is_leap(y) { 29 } else { d[m - 1] }
}

fn days_before(y: i64) -> i64 {
    let y1 = y - 1;
    y1 * 365 + y1 / 4 - y1 / 100 + y1 / 400
}

fn ordinal(y: i64, m: i64, d: i64) -> i64 {
    let mut o = days_before(y) + d;
    for k in 1..m {
        o += mdays(y, k);
    }
    o
}

// datetime(y, m, d, H, M, S) - timedelta(hours=th, minutes=tm), as
// utctimetuple(); None where datetime raises.
fn stamp(y: i64, m: i64, d: i64, hh: i64, mi: i64, ss: i64, th: i64, tm: i64) -> Val {
    if y < 1 or y > 9999 or m < 1 or m > 12 or d < 1 or d > mdays(y, m) or hh < 0 or hh > 23 or mi < 0 or mi > 59 or ss < 0 or ss > 59 {
        return Val.Null;
    }
    let secs = (ordinal(y, m, d) * 86400 + hh * 3600 + mi * 60 + ss) - (th * 3600 + tm * 60);
    let mut days = secs / 86400;
    let mut rem = secs % 86400;
    if rem < 0 {
        rem += 86400;
        days -= 1;
    }
    if days < 1 or days > ordinal(9999, 12, 31) {
        return Val.Null;
    }
    let mut yy = 1 + (days - 1) / 366;
    while ordinal(yy + 1, 1, 1) <= days {
        yy += 1;
    }
    let yday = days - ordinal(yy, 1, 1) + 1;
    let mut mm: i64 = 1;
    let mut left = yday;
    while left > mdays(yy, mm) {
        left -= mdays(yy, mm);
        mm += 1;
    }
    let wday = (days + 6) % 7;
    Val.Tm([yy, mm, left, rem / 3600, rem % 3600 / 60, rem % 60, wday, yday, 0].to_vec())
}

fn tz_named(z: Str, rfc: bool) -> i64 {
    let t = [
        "ut 0", "gmt 0", "z 0", "adt -3", "ast -4", "at -4", "edt -4", "est -5", "et -5", "cdt -5",
        "cst -6", "ct -6", "mdt -6", "mst -7", "mt -7", "pdt -7", "pst -8", "pt -8", "a -1", "n 1",
        "m -12", "y 12", "met 1", "mest 2",
    ];
    for i in 0..24 {
        if i >= 22 and not rfc {
            break;
        }
        let pr = partition(t[i], b' ');
        if pr.0 == z {
            return py_int(pr.2).unwrap_or(0);
        }
    }
    0
}

fn date_w3dtf(s0: Str) -> Val {
    if strip(s0).len() == 0 {
        return Val.Null;
    }
    let mut parts = split_on(lower(s0), b't');
    if parts.len() == 1 {
        parts = split_ws(parts[0]);
        if parts.len() == 1 {
            parts.push("00:00:00z".to_string());
        }
    } else if parts.len() > 2 {
        return Val.Null;
    }
    if parts.len() < 2 {
        return Val.Null;
    }
    let p0 = partition(parts[0], b'-');
    let mut date: Vec[String] = Vec.new();
    date.push(p0.0.clone());
    if p0.1 {
        let p1 = partition(p0.2, b'-');
        date.push(p1.0.clone());
        if p1.1 {
            date.push(p1.2.clone());
        }
    }
    if to_bytes(date[0]).len() != 4 {
        return Val.Null;
    }
    while date.len() < 3 {
        date.push("1".to_string());
    }
    let (y, m, d) = match (py_int(date[0]), py_int(date[1]), py_int(date[2])) {
        (Some(a), Some(b), Some(c)) => (a, b, c),
        _ => return Val.Null,
    };
    let mut p1 = parts[1].clone();
    let mut p2 = String.new();
    if ends_with(p1, "z") {
        let pb = to_bytes(p1);
        p1 = byte_str(pb, 0, pb.len() as i64 - 1);
        p2 = "z".to_string();
    }
    let mut loc = find_byte(p1, b'-') + 1;
    if loc == 0 {
        loc = find_byte(p1, b'+') + 1;
    }
    if loc == 0 {
        loc = to_bytes(p1).len() as i64 + 1;
    }
    loc -= 1;
    let pb = to_bytes(p1);
    let tzpart = byte_str(pb, loc, pb.len() as i64);
    if p2.len() == 0 {
        p2 = tzpart;
    }
    let tpart = byte_str(pb, 0, loc);
    let mut time: Vec[String] = Vec.new();
    let q0 = partition(tpart, b':');
    time.push(q0.0.clone());
    if q0.1 {
        let q1 = partition(q0.2, b':');
        time.push(q1.0.clone());
        if q1.1 {
            time.push(q1.2.clone());
        }
    }
    while time.len() < 3 {
        time.push("0".to_string());
    }
    let mut th: i64 = 0;
    let mut tmn: i64 = 0;
    let zb = to_bytes(p2);
    if zb.len() > 0 and (zb[0] == b'-' or zb[0] == b'+') {
        let a = py_int(byte_str(zb, 1, 3));
        let b = py_int(byte_str(zb, 4, zb.len() as i64));
        match (a, b) {
            (Some(x), Some(z)) => {
                th = x;
                tmn = z;
            }
            _ => return Val.Null,
        }
        if zb[0] == b'-' {
            th = -th;
            tmn = -tmn;
        }
    } else {
        th = tz_named(p2, false);
    }
    match (py_int_float(time[0]), py_int_float(time[1]), py_int_float(time[2])) {
        (Some(a), Some(b), Some(c)) => stamp(y, m, d, a, b, c, th, tmn),
        _ => Val.Null,
    }
}

fn month_of(s: Str) -> i64 {
    let ms = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"];
    let b = to_bytes(s);
    let k = byte_str(b, 0, if b.len() < 3 { b.len() as i64 } else { 3 });
    for i in 0..12 {
        if ms[i] == k {
            return i as i64 + 1;
        }
    }
    0
}

fn date_rfc822(s0: Str) -> Val {
    let mut parts = split_ws(lower(s0));
    if parts.len() < 5 {
        parts.push("00:00:00".to_string());
        parts.push("0000".to_string());
    }
    let days = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"];
    let pb = to_bytes(parts[0]);
    let d3 = byte_str(pb, 0, if pb.len() < 3 { pb.len() as i64 } else { 3 });
    for x in days {
        if x == d3 {
            parts.remove(0);
            break;
        }
    }
    if parts.len() < 5 {
        return Val.Null;
    }
    let mut month = month_of(parts[1]);
    let day = match py_int(parts[0]) {
        Some(d) => d,
        None => {
            if month_of(parts[0]) > 0 {
                match py_int(parts[1]) {
                    Some(d) => {
                        month = month_of(parts[0]);
                        d
                    }
                    None => return Val.Null,
                }
            } else {
                return Val.Null;
            }
        }
    };
    if month == 0 {
        return Val.Null;
    }
    let mut year = match py_int(parts[2]) { Some(y) => y, None => return Val.Null };
    if to_bytes(parts[2]).len() <= 2 {
        year += if year < 90 { 2000 } else { 1900 };
    }
    let mut tp = split_on(parts[3], b':');
    while tp.len() < 3 {
        tp.push("0".to_string());
    }
    if tp.len() > 3 {
        return Val.Null;
    }
    let (hh, mi, ss) = match (py_int(tp[0]), py_int(tp[1]), py_int(tp[2])) {
        (Some(a), Some(b), Some(c)) => (a, b, c),
        _ => return Val.Null,
    };
    let mut z = parts[4].clone();
    if starts_with(z, "etc/") {
        z = slice_from(z, 4);
    }
    if starts_with(z, "gmt") {
        let r = slice_from(z, 3).replace(":", "");
        z = if r.len() > 0 { r } else { "gmt".to_string() };
    }
    let zb = to_bytes(z);
    let mut th: i64 = 0;
    let mut tmn: i64 = 0;
    if zb.len() > 0 and (zb[0] == b'-' or zb[0] == b'+') {
        let mstart = if has_byte(z, b':') { 4 } else { 3 };
        match (py_int(byte_str(zb, 1, 3)), py_int(byte_str(zb, mstart, zb.len() as i64))) {
            (Some(a), Some(b)) => {
                th = a;
                tmn = b;
            }
            _ => return Val.Null,
        }
        if zb[0] == b'-' {
            th = -th;
            tmn = -tmn;
        }
    } else {
        th = tz_named(z, true);
    }
    stamp(year, month, day, hh, mi, ss, th, tmn)
}

fn parse_date(s: Str) -> Val {
    if s.len() == 0 {
        return Val.Null;
    }
    let a = date_w3dtf(s);
    match a {
        Val.Tm(_) => return a,
        _ => {}
    }
    date_rfc822(s)
}

struct Res {
    p: P,
    bozo: bool,
    exc: String,
    encoding: String,
    version: String,
    headers: Vec[(String, String)],
    bozo_one: bool,
}

fn decode_as(b: ref Vec[u8], enc: Str, t: ref Tables) -> Option[String] {
    if enc == "utf-8" {
        let s = utf8_replace(b);
        if to_bytes(s) == *b { return Some(s); }
        return None;
    }
    if enc == "us-ascii" {
        for c in b {
            if *c >= 0x80 { return None; }
        }
        return Some(from_bytes(b.clone()));
    }
    if enc == "iso-8859-1" or enc == "windows-1252" {
        let mut s = String.new();
        for c in b {
            let v = *c as i64;
            let m = if enc == "windows-1252" { cp1252_of(t, v) } else { -1 };
            if enc == "windows-1252" and v >= 128 and v < 160 and m < 0 {
                return None;
            }
            s.push_str(chr_str(if m >= 0 { m } else { v }));
        }
        return Some(s);
    }
    None
}

fn convert_to_utf8(t: ref Tables, r: mut ref Res, data0: ref Vec[u8]) -> Vec[u8] {
    let mut data = data0.clone();
    let mut bom = String.new();
    if data.len() >= 3 and data[0] == 0xEF and data[1] == 0xBB and data[2] == 0xBF {
        bom = "utf-8".to_string();
        data = data[3..].to_vec();
    }
    let mut xml_enc = String.new();
    if starts_at(data, 0, "<?") {
        let mut hb: Vec[u8] = Vec.new();
        for k in 0..(if data.len() > 200 { 200 } else { data.len() }) {
            hb.push(if data[k] < 0x80 { data[k] } else { b'?' });
        }
        let head = from_bytes(hb);
        let line = partition(head, b'\n').0;
        let k = find_str(line, "encoding=");
        if k >= 0 and find_str(line, "?>") > k {
            let lb = to_bytes(line);
            let q = lb[k + 9];
            if q == b'"' or q == b'\'' {
                let rest = byte_str(lb, k + 10, lb.len() as i64);
                let e = find_byte(rest, q);
                if e >= 0 {
                    xml_enc = lower(slice(rest, 0, e));
                }
            }
        }
    }
    let has_hdr = r.headers.len() > 0;
    let rfc = if has_hdr { if xml_enc.len() > 0 { xml_enc.clone() } else { "iso-8859-1".to_string() } } else if xml_enc.len() > 0 { xml_enc.clone() } else { "utf-8".to_string() };
    if has_hdr {
        r.bozo = true;
        r.exc = "NonXMLContentType: no Content-type specified".to_string();
    }
    let mut tried: Vec[String] = Vec.new();
    let cands = [rfc.clone(), xml_enc.clone(), bom.clone(), "utf-8".to_string(), "windows-1252".to_string(), "iso-8859-2".to_string()];
    for c in cands {
        if c.len() == 0 or in_list(tried, c) {
            continue;
        }
        tried.push(c.clone());
        let enc = if c == "latin-1" or c == "iso8859-1" { "iso-8859-1".to_string() } else { c.clone() };
        match decode_as(data, enc, t) {
            Some(s) => {
                let decl = "<?xml version='1.0' encoding='utf-8'?>";
                let out = if starts_with(s, "<?xml") {
                    let e = find_byte(s, b'>');
                    f"{decl}{slice_from(s, e + 1)}"
                } else {
                    f"{decl}\n{s}"
                };
                if c != rfc {
                    r.bozo = true;
                    r.exc = f"CharacterEncodingOverride: document declared as {rfc}, but parsed as {c}";
                }
                r.encoding = c.clone();
                return to_bytes(out);
            }
            None => {}
        }
    }
    r.encoding = String.new();
    data
}

// replace_doctype: drops a DOCTYPE line before the root and notes Netscape's.
fn replace_doctype(r: mut ref Res, data: ref Vec[u8]) -> Vec[u8] {
    let s = from_bytes(data.clone());
    let k = find_str(s, "<!DOCTYPE");
    let first = find_str(s, "<r");
    if k < 0 {
        return data.clone();
    }
    let e = k + find_byte(slice_from(s, k), b'>');
    let dt = lower(slice(s, k, e));
    if find_str(dt, "netscape") >= 0 {
        r.version = "rss091n".to_string();
    }
    let _ = first;
    to_bytes(f"{slice(s, 0, k)}{slice_from(s, e + 1)}")
}

fn feed_parse(t: ref Tables, path: Str, base: Str) -> Res {
    let bytes = match fs.read_bytes(f"data/{path}") { Ok(b) => b, Err(_) => Vec.new() };
    let mut r = Res { p: p_new("", false), bozo: false, exc: "-".to_string(), encoding: String.new(), version: String.new(), headers: Vec.new(), bozo_one: false };
    if base.len() > 0 {
        r.headers.push(("content-location".to_string(), base.to_string()));
    }
    let data1 = convert_to_utf8(t, mut r, bytes);
    let data = replace_doctype(mut r, data1);
    let baseuri = safe_uri(t, "", base);
    let base2 = if baseuri.len() > 0 { baseuri } else { safe_uri(t, base, "") };
    let xr = xml_scan(data);
    let mut strict_ok = r.encoding.len() > 0 and xr.err.len() == 0;
    if r.encoding.len() > 0 and xr.err.len() > 0 {
        r.bozo = true;
        r.exc = f"SAXParseException: <unknown>:{xr.err}";
        r.bozo_one = true;
    }
    if strict_ok {
        let mut p = p_new(base2, false);
        for e in xr.evs {
            if e.k == 3 {
                if e.text.len() > 0 {
                    track_namespace(t, mut p, e.local, e.text);
                }
            } else if e.k == 2 {
                handle_data(mut p, e.text, true);
            } else {
                let lns = lower(e.ns);
                let mut pre = String.new();
                let mut matched = false;
                for i in 0..t.ns_uri.len() {
                    if lower(t.ns_uri[i]) == lns {
                        pre = t.ns_pre[i].clone();
                        matched = true;
                    }
                }
                let mut local = lower(e.local);
                if matched and pre.len() > 0 {
                    local = f"{lower(pre)}:{local}";
                } else if e.has_ns and not matched {
                    let nd = p.nsuse;
                    for i in 0..p.st.dk[nd].len() {
                        let k = p.st.dk[nd][i].clone();
                        match p.st.dv[nd][i] {
                            Val.Str(u) => {
                                if k.len() > 0 and u == e.ns {
                                    local = f"{k}:{local}";
                                    break;
                                }
                            }
                            _ => {}
                        }
                    }
                }
                if e.k == 0 {
                    let mut ad: Vec[(String, String)] = Vec.new();
                    for a in e.attrs {
                        let mut ap = String.new();
                        for i in 0..t.ns_uri.len() {
                            if lower(t.ns_uri[i]) == lower(a.0) and a.0.len() > 0 {
                                ap = t.ns_pre[i].clone();
                            }
                        }
                        let key = if ap.len() > 0 { f"{ap}:{a.1}" } else { a.1.clone() };
                        attr_set(mut ad, lower(key), a.2);
                    }
                    unknown_starttag(t, mut p, local, ad);
                } else {
                    unknown_endtag(t, mut p, local);
                }
            }
        }
        r.p = p;
    } else {
        let mut p = p_new(base2, true);
        let text = utf8_replace(data);
        for e in sgml_events(text, 0, true) {
            if e.k == EV_START {
                unknown_starttag(t, mut p, e.a, e.attrs);
            } else if e.k == EV_END {
                unknown_endtag(t, mut p, e.a);
            } else if e.k == EV_DATA {
                handle_data(mut p, e.a, true);
            } else if e.k == EV_RAWDATA {
                handle_data(mut p, e.a, false);
            } else if e.k == EV_CHARREF {
                if p.stack.len() > 0 {
                    let rf = lower(e.a);
                    let keep = ["34", "38", "39", "60", "62", "x22", "x26", "x27", "x3c", "x3e"];
                    let txt = if in_list(keep.to_vec().iter().map(|x| x.to_string()).collect(), rf) { f"&#{rf};" } else if starts_with(rf, "x") { chr_str(parse_hex(slice_from(rf, 1))) } else { chr_str(py_int(rf).unwrap_or(0)) };
                    let n = p.stack.len();
                    p.stack[n - 1].2.push(txt);
                }
            } else if e.k == EV_ENTREF {
                if p.stack.len() > 0 {
                    let a = e.a.clone();
                    let txt = if a == "lt" or a == "gt" or a == "quot" or a == "amp" or a == "apos" { f"&{a};" } else { let c = ent_cp(t, a); if c < 0 { f"&{a};" } else { chr_str(c) } };
                    let n = p.stack.len();
                    p.stack[n - 1].2.push(txt);
                }
            }
        }
        r.p = p;
    }
    if r.version.len() == 0 {
        r.version = r.p.version.clone();
    }
    r
}

fn exc_of(r: ref Res) -> String {
    r.exc.clone()
}

fn res_get(r: ref Res, d: i64, k: Str) -> String {
    fget_str(r.p.st, d, k)
}

fn dump_parse(t: ref Tables, path: Str, base: Str) {
    let r = feed_parse(t, path, base);
    let mut out: Vec[String] = Vec.new();
    out.push(f"  bozo: {if r.bozo_one { "1" } else if r.bozo { "True" } else { "False" }}");
    out.push(f"  encoding: {py_repr(r.encoding)}");
    out.push(f"  version: {py_repr(r.version)}");
    out.push(f"  bozo_exception: {r.exc}");
    out.push("  headers:".to_string());
    for h in r.headers {
        out.push(f"    {h.0}: {py_repr(h.1)}");
    }
    out.push("  namespaces:".to_string());
    dump(r.p.st, Val.D(r.p.nsuse), "    ", mut out);
    out.push("  feed:".to_string());
    dump(r.p.st, Val.D(r.p.feed), "    ", mut out);
    out.push(f"  entries: {r.p.st.ls[r.p.entries].len()}");
    dump(r.p.st, Val.L(r.p.entries), "    ", mut out);
    for l in out {
        println(l);
    }
}

fn tm_of(v: ref Option[Val]) -> Vec[i64] {
    match v {
        Some(Val.Tm(x)) => x.clone(),
        _ => Vec.new(),
    }
}

fn pad2(v: i64) -> String {
    if v < 10 { f"0{v}" } else { f"{v}" }
}

fn stamp_str(x: ref Vec[i64]) -> String {
    if x.len() == 0 {
        return "-".to_string();
    }
    f"{x[0]}-{pad2(x[1])}-{pad2(x[2])} {pad2(x[3])}:{pad2(x[4])}:{pad2(x[5])}"
}

fn tm_less(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    for i in 0..6 {
        if a[i] != b[i] {
            return a[i] < b[i];
        }
    }
    false
}

fn first16(s: Str) -> String {
    let mut out = String.new();
    let mut n: i64 = 0;
    for c in s.chars() {
        if n == 16 {
            break;
        }
        out.push(c);
        n += 1;
    }
    while n < 16 {
        out.push(' ');
        n += 1;
    }
    out
}

fn entries_of(r: ref Res) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for x in r.p.st.ls[r.p.entries] {
        v.push(val_dict(x));
    }
    v
}

fn prog_digest(t: ref Tables, files: ref Vec[String]) {
    let mut rows: Vec[(Vec[i64], String, String, String)] = Vec.new();
    for f in files {
        let r = feed_parse(t, f, "");
        let ft = if fhas(r.p.st, r.p.feed, "title") { res_get(r, r.p.feed, "title") } else { "?".to_string() };
        for e in entries_of(r) {
            let mut tm = tm_of(fget(r.p.st, e, "updated_parsed"));
            if tm.len() == 0 {
                tm = tm_of(fget(r.p.st, e, "published_parsed"));
            }
            let et = if fhas(r.p.st, e, "title") { res_get(r, e, "title") } else { "(untitled)".to_string() };
            let ln = if fhas(r.p.st, e, "link") { res_get(r, e, "link") } else { "-".to_string() };
            rows.push((tm, ft.clone(), et, ln));
        }
    }
    let mut dated: Vec[(Vec[i64], String, String, String)] = Vec.new();
    let mut undated: Vec[(Vec[i64], String, String, String)] = Vec.new();
    for x in rows {
        if x.0.len() > 0 {
            // sorted(reverse=True) is stable: equal keys keep input order
            let mut k = dated.len() as i64;
            while k > 0 and tm_less(dated[k - 1].0, x.0) {
                k -= 1;
            }
            dated.insert(k, x.clone());
        } else {
            undated.push(x.clone());
        }
    }
    println(f"  {rows.len()} entries from {files.len()} feeds, {undated.len()} undated");
    for x in undated {
        dated.push(x.clone());
    }
    let mut n: i64 = 0;
    for x in dated {
        if n == 10 {
            break;
        }
        println(f"  {stamp_str(x.0)}  {first16(x.1)} {x.2} <{x.3}>");
        n += 1;
    }
}

fn prog_tags(t: ref Tables, files: ref Vec[String]) {
    let mut terms: Vec[String] = Vec.new();
    let mut counts: Vec[i64] = Vec.new();
    for f in files {
        let r = feed_parse(t, f, "");
        let mut ds = [r.p.feed].to_vec();
        for e in entries_of(r) {
            ds.push(e);
        }
        for d in ds {
            match fget(r.p.st, d, "tags") {
                Some(Val.L(l)) => {
                    for tg in r.p.st.ls[l] {
                        let term = lower(fget_str(r.p.st, val_dict(tg), "term"));
                        if term.len() > 0 {
                            bump(mut terms, mut counts, term);
                        }
                    }
                }
                _ => {}
            }
        }
    }
    for i in sort_counts(terms, counts) {
        let c = counts[i];
        let pad = if c < 10 { "  " } else if c < 100 { " " } else { "" };
        println(f"  {pad}{c} {terms[i]}");
    }
}

fn xml_attr(s: Str) -> String {
    s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
}

fn prog_opml(t: ref Tables, files: ref Vec[String]) {
    println("  <opml version=\"2.0\"><body>");
    for f in files {
        let r = feed_parse(t, f, "");
        let n = r.p.st.ls[r.p.entries].len();
        if r.bozo and n == 0 {
            println(f"  <!-- skipped {f}: {partition(r.exc, b':').0} -->");
            continue;
        }
        let title = if fhas(r.p.st, r.p.feed, "title") { res_get(r, r.p.feed, "title") } else { f.clone() };
        let ty = if starts_with(r.version, "atom") { "atom" } else { "rss" };
        let link = res_get(r, r.p.feed, "link");
        println(f"    <outline text=\"{xml_attr(title)}\" type=\"{ty}\" xmlUrl=\"{xml_attr(f)}\" htmlUrl=\"{xml_attr(link)}\"/>");
    }
    println("  </body></opml>");
}

fn ljust(s: Str, w: i64) -> String {
    let mut out = s.to_string();
    let mut n = s.chars().count() as i64;
    while n < w {
        out.push(' ');
        n += 1;
    }
    out
}

fn prog_health(t: ref Tables, files: ref Vec[String]) {
    for f in files {
        let r = feed_parse(t, f, "");
        let v = if r.version.len() > 0 { r.version.clone() } else { "?".to_string() };
        let enc = if r.encoding.len() > 0 { r.encoding.clone() } else { "-".to_string() };
        let n = r.p.st.ls[r.p.entries].len() as i64;
        let ns = if n < 10 { f" {n}" } else { f"{n}" };
        let st = if not r.bozo { "ok".to_string() } else { f"bozo {partition(r.exc, b':').0}" };
        println(f"  {ljust(slice_from(f, 6), 28)} {ljust(v, 8)} {ljust(enc, 12)} {ns} entries  {st}");
    }
}

fn read_lines(path: Str) -> Vec[String] {
    let s = match fs.read_bytes(f"data/{path}") { Ok(b) => utf8_replace(b), Err(_) => String.new() };
    let mut v = split_c(s, '\n');
    v.pop();
    v
}

fn main() {
    if let Err(e) = write_inputs() {
        eprintln(e);
        return;
    }
    let t = load_tables();
    for hex in split_c(jobs_text(), '\n') {
        if hex.len() == 0 {
            continue;
        }
        let line = hex_string(hex);
        println(f"> {line}");
        let w = split_c(line, ' ');
        let mut rest: Vec[String] = Vec.new();
        for k in 1..w.len() {
            rest.push(w[k].clone());
        }
        if w[0] == "parse" {
            let base = if w.len() > 2 { w[2].clone() } else { String.new() };
            dump_parse(t, w[1], base);
        } else if w[0] == "!dates" {
            for s in read_lines(w[1]) {
                let v = parse_date(s);
                let shown = match v { Val.Tm(x) => tm_repr(x), _ => "None".to_string() };
                println(f"  {py_repr(s)} -> {shown}");
            }
        } else if w[0] == "!sanitize" or w[0] == "!resolve" {
            for s0 in read_lines(w[1]) {
                let s = unescape(s0);
                let o = if w[0] == "!sanitize" { sanitize_html(t, s, "text/html") } else { resolve_relative(t, s, w[2], "text/html") };
                println(f"  {py_repr(s)}\n    => {py_repr(o)}");
            }
        } else if w[0] == "!digest" {
            prog_digest(t, rest);
        } else if w[0] == "!tags" {
            prog_tags(t, rest);
        } else if w[0] == "!opml" {
            prog_opml(t, rest);
        } else if w[0] == "!health" {
            prog_health(t, rest);
        }
    }
}

