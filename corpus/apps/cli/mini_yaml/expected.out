== deploy.yaml
--- document 1
{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "shop-api",
    "namespace": "shop",
    "labels": {
      "app": "shop-api",
      "tier": "backend"
    }
  },
  "spec": {
    "replicas": 3,
    "selector": {
      "matchLabels": {
        "app": "shop-api",
        "tier": "backend"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "shop-api",
          "tier": "backend"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "api",
            "image": "registry.example.com/shop/api:1.9.0",
            "args": [
              "--port=8000",
              "--workers",
              "4"
            ],
            "ports": [
              {
                "containerPort": 8000,
                "protocol": "TCP"
              }
            ],
            "env": [
              {
                "name": "DEBUG",
                "value": "false"
              },
              {
                "name": "CACHE_TTL",
                "value": "300"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "250m",
                "memory": "256Mi"
              },
              "limits": {
                "cpu": "1",
                "memory": "512Mi"
              }
            }
          },
          {
            "name": "log-shipper",
            "image": "registry.example.com/infra/vector:0.41"
          }
        ]
      }
    }
  }
}
--- document 2
{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "shop-api",
    "namespace": "shop"
  },
  "spec": {
    "type": "ClusterIP",
    "selector": {
      "app": "shop-api"
    },
    "ports": [
      {
        "port": 80,
        "targetPort": 8000
      }
    ]
  }
}
--- document 3
{
  "apiVersion": "v1",
  "kind": "ConfigMap",
  "metadata": {
    "name": "shop-api-config"
  },
  "data": {
    "app.ini": "[server]\nport = 8000\n\n[cache]\nttl = 300\n",
    "motd": "Welcome to the shop API. Deploys happen on Tuesdays.\nAsk in #shop-ops.\n",
    "empty.txt": ""
  }
}
== compose.yaml
--- document 1
{
  "version": "3.8",
  "x-common": {
    "restart": "unless-stopped",
    "logging": {
      "driver": "json-file",
      "options": {
        "max-size": "10m",
        "max-file": "3"
      }
    }
  },
  "services": {
    "web": {
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "image": "nginx:1.27",
      "ports": [
        "8080:80",
        "443:443"
      ],
      "depends_on": [
        "api"
      ]
    },
    "api": {
      "restart": "always",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "build": "./api",
      "environment": [
        "DATABASE_URL=postgres://shop@db/shop",
        "WORKERS=4"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-f",
          "http://localhost:8000/healthz"
        ],
        "interval": "30s",
        "retries": 3
      }
    },
    "db": {
      "image": "postgres:16",
      "ports": [
        "5432:5432"
      ],
      "volumes": [
        "db-data:/var/lib/postgresql/data"
      ]
    },
    "ssh": {
      "image": "linuxserver/openssh-server",
      "ports": [
        1342
      ]
    }
  },
  "volumes": {
    "db-data": null
  }
}
== ci.yml
--- document 1
{
  "name": "CI",
  "true": {
    "push": {
      "branches": [
        "main"
      ]
    },
    "pull_request": null
  },
  "jobs": {
    "test": {
      "runs-on": "${{ matrix.os }}",
      "strategy": {
        "fail-fast": false,
        "matrix": {
          "os": [
            "ubuntu-24.04",
            "macos-14"
          ],
          "python": [
            "3.11",
            "3.12",
            3.1
          ]
        }
      },
      "steps": [
        {
          "uses": "actions/checkout@v4"
        },
        {
          "name": "Install",
          "run": "python -m pip install -U pip\npip install -e \".[test]\"\n"
        },
        {
          "name": "Test",
          "run": "pytest -q --maxfail=1",
          "env": {
            "CI": true,
            "PYTHONHASHSEED": 0
          }
        },
        {
          "name": "Summary",
          "if": "${{ always() }}",
          "run": "echo \"tests finished for ${{ matrix.os }}\" >> $GITHUB_STEP_SUMMARY"
        }
      ]
    }
  }
}
== site.yml
--- document 1
[
  {
    "hosts": "web",
    "become": true,
    "vars": {
      "http_port": 80,
      "max_clients": 200
    },
    "tasks": [
      {
        "name": "install nginx",
        "apt": "name=nginx state=present update_cache=yes"
      },
      {
        "name": "write config",
        "template": {
          "src": "nginx.conf.j2",
          "dest": "/etc/nginx/nginx.conf",
          "mode": 420
        },
        "notify": "restart nginx"
      },
      {
        "name": "config dir",
        "file": {
          "path": "/etc/nginx/conf.d",
          "state": "directory",
          "mode": "0755"
        }
      },
      {
        "name": "open firewall",
        "ufw": "rule=allow port={{ http_port }}",
        "when": "ansible_os_family == \"Debian\" and firewall_enabled"
      }
    ],
    "handlers": [
      {
        "name": "restart nginx",
        "service": "name=nginx state=restarted"
      }
    ]
  }
]
