{'name': True, 'port': True, 'workers': True, 'timeout': True, 'debug': True, 'ratio': True, 'admin_ip': True, 'hosts': True, 'log_level': True, 'tags': True, 'retry': True, 'owner': True, 'greeting': True, 'database': True, 'features': {'search': True, 'export': False, 'beta': True}, 'metrics': True}
