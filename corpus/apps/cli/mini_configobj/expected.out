== write
-- write webapp
# webapp.ini: settings for the shop front end
# edit with care, the deploy tool rewrites this file

name = shop-frontend
version = 2.14.0
owners = alice@example.com, bob@example.com
debug = off    # never on in production
motd = '''Welcome to the shop.
Orders placed after 18:00 ship the next day.'''

# the HTTP server
[server]
    host = 0.0.0.0
    port = 8080
    workers = 8
    allowed_hosts = shop.example.com, www.shop.example.com, "localhost, 127.0.0.1"
    timeout = 30.5
    # keep-alive in seconds
    keepalive = 5

[database]
    engine = postgresql
    [[primary]]
        host = db1.internal
        port = 5432
        user = shop
        password = "s3cr3t#with#hashes"
    [[replica]]
        host = db2.internal
        port = 5433
        options = sslmode=require, connect_timeout=10

[logging]
    level = INFO
    format = %(asctime)s %(levelname)s %(message)s
    [[handlers]]
        [[[console]]]
            class = StreamHandler
            stream = ext://sys.stdout
        [[[file]]]
            class = RotatingFileHandler
            filename = /var/log/shop/app.log
            maxBytes = 10485760
            backupCount = 5
[cache]
    backend = redis
    servers = ,
    ttl = ""
# end of file
<EOF>
-- write quotes
plain = hello world
spaced = "  padded  "
hash = "has # inside"
both = '''it's "quoted" here'''
single_item = alpha,
empty_list = ,
empty_quoted = ""
empty = ""
commas = "a, b", c
nested_quotes = it's, 'say "hi"'
tab = a	b
trailing_comma = a, b, c
key with = sign = yes
quoted key = 1
"key#hash" = value
spaces in key = fine
multi = '''first
second'''
multi_double = '''a
b
c'''# inline after multiline
oneline_triple = just one# comment
<EOF>
-- write crlf
# windows line endings<CR>
a = 1<CR>
[s]<CR>
b = two words<CR>
<EOF>
-- write dropback
[a]
    [[b]]
        [[[c]]]
            leaf = 1
    [[d]]
        x = 2
[e]
    y = 3
    [[f]]
        [[[g]]]
            z = 4
[h]
<EOF>
-- write indent
top = 1
[a]
	x = 1
	[[b]]
		y = 2
<EOF>
-- write empty

<EOF>
-- write unicode
! UnicodeEncodeError: 'ascii' codec can't encode character '\xe9' in position 5: ordinal not in range(128)
-- load unicode8 etc/unicode.ini {"encoding": "utf-8"}
ok
-- write unicode8
# café settings
greeting = Grüße, 世界
name = Zoë
[ünïcode]
key = naïve
<EOF>
