-- write ed
# webapp.ini: settings for the shop front end
# edit with care, the deploy tool rewrites this file

version = 2.14.0
owners = alice@example.com, bob@example.com
debug = off    # never on in production
motd = '''Welcome to the shop.
Orders placed after 18:00 ship the next day.'''

# the HTTP server
[server]
    host = 0.0.0.0
    port = 9090
    processes = 8
    allowed_hosts = shop.example.com, www.shop.example.com, "localhost, 127.0.0.1"
    timeout = 30.5
    aliases = shop, store
    empty = ,
    one = only,
    tricky = '''it's "both"'''
    lead = " leading space"
    hashy = "a#b"
    withnl = '''line1
line2'''
    num = 42
    flt = 0.1
    none = None
    yes = True
    backlog = 128

[db]
    engine = postgresql
    [[primary]]
        host = db1.internal
        port = 5432
        user = shop
        password = "s3cr3t#with#hashes"
    [[replica]]
        host = db2.internal
        port = 5433
        options = sslmode=require, connect_timeout=10

[logging]
    level = INFO
    format = %(asctime)s %(levelname)s %(message)s
    [[handlers]]
        [[[file]]]
            class = RotatingFileHandler
            filename = /var/log/shop/app.log
            maxBytes = 10485760
            backupCount = 5
[newsec]
    a = 1
    [[inner]]
        b = 2
# end of file
