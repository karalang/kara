ConfigObj({'name': 'inventory', 'port': 8443, 'workers': 12, 'debug': True, 'ratio': 0.75, 'admin_ip': '10.0.0.1', 'hosts': ['alpha.example.com', 'beta.example.com'], 'log_level': 'WARNING', 'retry': [3, 0.5], 'unexpected': '1', 'timeout': 30.0, 'tags': [], 'owner': None, 'greeting': 'hello, world', 'database': {'url': 'postgres://inv@db/inv', 'pool': 20, 'backup': False, 'replicas': {'east': {'host': 'db-east', 'port': 5433}, 'west': {'host': 'db-west', 'port': 5432}}}, 'features': {'search': True, 'export': 'maybe', 'beta': False}, 'extra_section': {'x': '1'}, 'metrics': {'enabled': True, 'interval': 60}})
