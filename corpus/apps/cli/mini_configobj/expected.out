-- write base
# shipped defaults
app = billing
debug = true
[server]
host = 0.0.0.0
port = 9000
[[tls]]
enabled = true
cert = /etc/ssl/billing.pem
[queues]
names = invoices, reminders, dunning
workers = 16
old = replaced by a value
[audit]
sink = file
old = scalar now
[[file]]
path = /tmp/audit.log
