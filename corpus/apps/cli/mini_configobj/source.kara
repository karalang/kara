fn file_etc_webapp_ini_0(t: mut ref String) {
    t.push_str("# webapp.ini: settings for the shop front end\n");
    t.push_str("# edit with care, the deploy tool rewrites this file\n");
    t.push_str("\n");
    t.push_str("name = shop-frontend\n");
    t.push_str("version = 2.14.0\n");
    t.push_str("owners = alice@example.com, bob@example.com\n");
    t.push_str("debug = off   # never on in production\n");
    t.push_str("motd = \"\"\"Welcome to the shop.\n");
    t.push_str("Orders placed after 18:00 ship the next day.\"\"\"\n");
    t.push_str("\n");
    t.push_str("# the HTTP server\n");
    t.push_str("[server]\n");
    t.push_str("host = 0.0.0.0\n");
    t.push_str("port = 8080\n");
    t.push_str("workers = 8\n");
    t.push_str("allowed_hosts = shop.example.com, www.shop.example.com, \"localhost, 127.0.0.1\"\n");
    t.push_str("timeout = 30.5\n");
    t.push_str("    # keep-alive in seconds\n");
    t.push_str("    keepalive = 5\n");
    t.push_str("\n");
    t.push_str("[database]\n");
    t.push_str("engine = postgresql\n");
    t.push_str("    [[primary]]\n");
    t.push_str("    host = db1.internal\n");
    t.push_str("    port = 5432\n");
    t.push_str("    user = shop\n");
    t.push_str("    password = 's3cr3t#with#hashes'\n");
    t.push_str("    [[replica]]\n");
    t.push_str("    host = db2.internal\n");
    t.push_str("    port = 5433\n");
    t.push_str("    options = sslmode=require, connect_timeout=10,\n");
    t.push_str("\n");
    t.push_str("[logging]\n");
    t.push_str("level = INFO\n");
    t.push_str("format = '%(asctime)s %(levelname)s %(message)s'\n");
    t.push_str("    [[handlers]]\n");
    t.push_str("        [[[console]]]\n");
    t.push_str("        class = StreamHandler\n");
    t.push_str("        stream = ext://sys.stdout\n");
    t.push_str("        [[[file]]]\n");
    t.push_str("        class = RotatingFileHandler\n");
    t.push_str("        filename = /var/log/shop/app.log\n");
    t.push_str("        maxBytes = 10485760\n");
    t.push_str("        backupCount = 5\n");
    t.push_str("[cache]\n");
    t.push_str("backend = redis\n");
    t.push_str("servers = ,\n");
    t.push_str("ttl =\n");
    t.push_str("# end of file\n");
}

fn file_jobs_tsv_0(t: mut ref String) {
    t.push_str("== load and repr\n");
    t.push_str("load\twebapp\tetc/webapp.ini\t{}\n");
    t.push_str("repr\twebapp\n");
    t.push_str("load\tquotes\tetc/quotes.ini\t{}\n");
    t.push_str("repr\tquotes\n");
    t.push_str("load\tcrlf\tetc/crlf.ini\t{}\n");
    t.push_str("repr\tcrlf\n");
