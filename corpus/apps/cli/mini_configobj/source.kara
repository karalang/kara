// mini_configobj: configobj 5.0.9 and its validate module, the INI-style
// config reader that Python services, deploy tools and test runners use
// for nested settings files with comments, lists, multi-line values and
// %(name)s or ${name} interpolation, checked against a configspec. The
// port covers parsing (section nesting by bracket depth, quoting, lists,
// triple-quoted values, comments and the errors a bad file raises, alone
// or collected), lookups with both interpolation engines, editing (set,
// rename, del, pop, setdefault, popitem, merge, walk), writing the file
// back with its comments, newline style and encoding, the as_int /
// as_bool / as_float / as_list helpers, and validation: every built-in
// check of validate.py with its argument binding and errors, defaults,
// __many__ sections, copy mode, preserve_errors, flatten_errors,
// get_extra_values and restore_defaults.
//
// configobj and validate are built on re, so this carries mini_re's
// regular expression engine (Python 3.13's parser and an sre-style
// backtracking matcher) and compiles the patterns from their own source
// text (the generated section). The program writes data/ (the config
// files and jobs.tsv, as mk.py writes them), then runs the jobs.
// expected.out is the output of oracle.py, which runs the same jobs
// through the copies of configobj and validate in configobj/.

// ------------------------------------------------------------ errors

struct ReErr {
    kind: String,
    msg: String,
    pos: i64,
}

fn re_error(msg: own String, pos: i64) -> ReErr {
    ReErr { kind: "error".to_string(), msg: msg, pos: pos }
}

fn other_error(kind: Str, msg: own String) -> ReErr {
    ReErr { kind: kind.to_string(), msg: msg, pos: -1 }
}

fn err_text(e: ref ReErr) -> String {
    if e.kind == "error" {
        if e.pos >= 0 {
            return f"error: {e.msg} at position {e.pos}";
        }
        return f"error: {e.msg}";
    }
    f"{e.kind}: {e.msg}"
}

// -------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for cp in s {
        if cp < 0x80 {
            out.push(cp as u8);
        } else if cp < 0x800 {
            out.push((0xC0 | (cp >> 6)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else if cp < 0x10000 {
            out.push((0xE0 | (cp >> 12)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (cp >> 18)) as u8);
            out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

// s[start:end], clamped to the string the way Python clamps a slice
fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = if start < 0 { 0 } else { start };
    let stop = if end > s.len() { s.len() } else { end };
    while i < stop {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

fn str_repr(s: ref Vec[i64], out: mut ref Vec[i64]) {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
}

fn repr_of(s: ref Vec[i64]) -> String {
    let mut out: Vec[i64] = Vec.new();
    str_repr(s, mut out);
    to_string(out)
}

// ----------------------------------------------------- character kinds

fn is_decimal(c: i64) -> bool {
    if c < 0x80 {
        return c >= 48 and c <= 57;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return true;
        }
    }
    false
}

fn is_space(c: i64, ascii: bool) -> bool {
    if c == 32 or (c >= 9 and c <= 13) {
        return true;
    }
    if ascii {
        return false;
    }
    (c >= 0x1C and c <= 0x1F) or c == 0x85 or c == 0xA0 or c == 0x1680 or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F or c == 0x3000
}

fn as_char(c: i64) -> Option[char] {
    if c < 0 or (c >= 0xD800 and c <= 0xDFFF) or c > 0x10FFFF {
        return None;
    }
    char.try_from(c as u32).ok()
}

fn is_word(c: i64, ascii: bool) -> bool {
    if c < 0x80 {
        return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
    }
    if ascii {
        return false;
    }
    match as_char(c) {
        Some(ch) => ch.is_alphanumeric(),
        None => false,
    }
}

fn lower(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 65 and c <= 90 { c + 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_lowercase() as u32 as i64,
        None => c,
    }
}

fn upper(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 97 and c <= 122 { c - 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_uppercase() as u32 as i64,
        None => c,
    }
}

// ------------------------------------------------------- parsed form

// The categories of \d \D \s \S \w \W.
fn cat_digit() -> i64 { 0 }
fn cat_not_digit() -> i64 { 1 }
fn cat_space() -> i64 { 2 }
fn cat_not_space() -> i64 { 3 }
fn cat_word() -> i64 { 4 }
fn cat_not_word() -> i64 { 5 }

// The positions ^ $ \A \Z \b \B and the forms the compiler turns them
// into under MULTILINE.
fn at_beginning() -> i64 { 0 }
fn at_beginning_line() -> i64 { 1 }
fn at_beginning_string() -> i64 { 2 }
fn at_end() -> i64 { 3 }
fn at_end_line() -> i64 { 4 }
fn at_end_string() -> i64 { 5 }
fn at_boundary() -> i64 { 6 }
fn at_non_boundary() -> i64 { 7 }

#[derive(Clone)]
enum Item {
    Lit(i64),
    Range(i64, i64),
    Cat(i64),
}

enum Node {
    Lit(i64),
    NotLit(i64),
    Any,
    In(Vec[Item], bool),
    At(i64),
    Branch(Vec[Vec[Node]]),
    // group (0: none), flags turned on, flags turned off, contents
    Group(i64, i64, i64, Vec[Node]),
    // 0 greedy, 1 lazy, 2 possessive; min; max; the item repeated
    Repeat(i64, i64, i64, Vec[Node]),
    Atomic(Vec[Node]),
    // direction (1 ahead, -1 behind), negative, contents
    Assert(i64, bool, Vec[Node]),
    GroupRef(i64),
    // group, yes branch, no branch
    Exists(i64, Vec[Node], Vec[Node]),
    Failure,
}

fn is_repeat(n: ref Node) -> bool {
    match n {
        Node.Repeat(_, _, _, _) => true,
        _ => false,
    }
}

fn is_at(n: ref Node) -> bool {
    match n {
        Node.At(_) => true,
        _ => false,
    }
}

fn flag_i() -> i64 { 2 }
fn flag_l() -> i64 { 4 }
fn flag_m() -> i64 { 8 }
fn flag_s() -> i64 { 16 }
fn flag_u() -> i64 { 32 }
fn flag_x() -> i64 { 64 }
fn flag_a() -> i64 { 256 }
fn type_flags() -> i64 { 4 | 32 | 256 }
fn maxrepeat() -> i64 { 4294967295 }
fn maxgroups() -> i64 { 1073741823 }
fn maxwidth() -> i64 { 1 << 62 }

fn flag_value(c: i64) -> i64 {
    match c {
        105 => 2,
        76 => 4,
        109 => 8,
        115 => 16,
        120 => 64,
        97 => 256,
        117 => 32,
        _ => 0,
    }
}

// ------------------------------------------------------------ tokens

// One token: nothing at the end of the pattern (n 0), a character (n 1),
// or a backslash and the character after it (n 2).
#[derive(Copy, Clone)]
struct T {
    n: i64,
    a: i64,
    b: i64,
}

fn tok_none() -> T {
    T { n: 0, a: 0, b: 0 }
}

fn tok_is(t: T, c: i64) -> bool {
    t.n == 1 and t.a == c
}

fn tok_text(t: T) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    if t.n >= 1 {
        v.push(t.a);
    }
    if t.n == 2 {
        v.push(t.b);
    }
    v
}

fn is_ascii_letter(c: i64) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

fn is_hex(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

fn is_oct(c: i64) -> bool {
    c >= 48 and c <= 55
}

fn is_dec(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn digits_value(s: ref Vec[i64], start: i64, base: i64) -> i64 {
    let mut v = 0;
    let mut i = start;
    while i < s.len() {
        let c = s[i];
        let d = if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 };
        v = v * base + d;
        i += 1;
    }
    v
}

// str.isidentifier, near enough: a letter or underscore, then letters,
// digits and underscores.
fn is_identifier(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    let mut i = 0;
    while i < name.len() {
        let c = name[i];
        let ok = if c == 95 {
            true
        } else if i == 0 {
            match as_char(c) {
                Some(ch) => ch.is_alphabetic(),
                None => false,
            }
        } else {
            is_word(c, false)
        };
        if not ok {
            return false;
        }
        i += 1;
    }
    true
}

fn is_ascii_decimal(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    for c in name {
        if not is_dec(c) {
            return false;
        }
    }
    true
}

struct Tokenizer {
    s: Vec[i64],
    index: i64,
    next: T,
}

impl Tokenizer {
    fn advance(mut ref self) -> Result[(), ReErr] {
        let index = self.index;
        if index >= self.s.len() {
            self.next = tok_none();
            return Ok(());
        }
        let c = self.s[index];
        if c == 92 {
            if index + 1 >= self.s.len() {
                return Err(re_error("bad escape (end of pattern)".to_string(), self.s.len() - 1));
            }
            self.next = T { n: 2, a: 92, b: self.s[index + 1] };
            self.index = index + 2;
        } else {
            self.next = T { n: 1, a: c, b: 0 };
            self.index = index + 1;
        }
        Ok(())
    }

    fn get(mut ref self) -> Result[T, ReErr] {
        let t = self.next;
        self.advance()?;
        Ok(t)
    }

    fn take(mut ref self, c: i64) -> Result[bool, ReErr] {
        if tok_is(self.next, c) {
            self.advance()?;
            return Ok(true);
        }
        Ok(false)
    }

    fn tell(ref self) -> i64 {
        self.index - self.next.n
    }

    fn seek(mut ref self, index: i64) -> Result[(), ReErr] {
        self.index = index;
        self.advance()
    }

    fn error(ref self, msg: own String, offset: i64) -> ReErr {
        re_error(msg, self.tell() - offset)
    }

    // getwhile: up to n characters of a kind (0 octal, 1 decimal, 2 hex).
    fn getwhile(mut ref self, n: i64, kind: i64, out: mut ref Vec[i64]) -> Result[(), ReErr] {
        let mut k = 0;
        while k < n {
            let t = self.next;
            if t.n != 1 {
                break;
            }
            let ok = if kind == 0 { is_oct(t.a) } else if kind == 1 { is_dec(t.a) } else { is_hex(t.a) };
            if not ok {
                break;
            }
            out.push(t.a);
            self.advance()?;
            k += 1;
        }
        Ok(())
    }

    fn getuntil(mut ref self, terminator: i64, name: Str) -> Result[Vec[i64], ReErr] {
        let mut result: Vec[i64] = Vec.new();
        loop {
            let c = self.next;
            self.advance()?;
            if c.n == 0 {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 0));
                }
                let term = to_string(vec_of(terminator));
                return Err(self.error(f"missing {term}, unterminated name", result.len()));
            }
            if tok_is(c, terminator) {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 1));
                }
                break;
            }
            push_all(mut result, tok_text(c));
        }
        Ok(result)
    }

    fn checkgroupname(ref self, name: ref Vec[i64], offset: i64) -> Result[(), ReErr] {
        if not is_identifier(name) {
            return Err(self.error(f"bad character in group name {repr_of(name)}", name.len() + offset));
        }
        Ok(())
    }
}

fn vec_of(c: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(c);
    v
}

fn new_tokenizer(s: ref Vec[i64]) -> Result[Tokenizer, ReErr] {
    let mut t = Tokenizer { s: s.clone(), index: 0, next: tok_none() };
    t.advance()?;
    Ok(t)
}

// ------------------------------------------------------------ parser

#[derive(Clone)]
struct Width {
    lo: i64,
    hi: i64,
}

struct ParseState {
    flags: i64,
    names: Vec[(Vec[i64], i64)],
    // per group: whether it is closed, and its width
    closed: Vec[bool],
    widths: Vec[Width],
    lookbehind_groups: i64,
    // conditional references by number, in order: (group, position)
    refpos: Vec[(i64, i64)],
}

impl ParseState {
    fn groups(ref self) -> i64 {
        self.closed.len()
    }

    fn group_of(ref self, name: ref Vec[i64]) -> i64 {
        for (n, g) in self.names.iter() {
            if same(n, name) {
                return *g;
            }
        }
        -1
    }

    fn checkgroup(ref self, gid: i64) -> bool {
        gid < self.groups() and self.closed[gid]
    }

    fn checklookbehindgroup(ref self, gid: i64, src: ref Tokenizer) -> Result[(), ReErr] {
        if self.lookbehind_groups >= 0 {
            if not self.checkgroup(gid) {
                return Err(src.error("cannot refer to an open group".to_string(), 0));
            }
            if gid >= self.lookbehind_groups {
                return Err(src.error("cannot refer to group defined in the same lookbehind subpattern".to_string(), 0));
            }
        }
        Ok(())
    }
}

fn add_width(a: i64, b: i64) -> i64 {
    if a >= maxwidth() - b { maxwidth() } else { a + b }
}

fn mul_width(a: i64, n: i64) -> i64 {
    if a == 0 or n == 0 {
        0
    } else if a >= maxwidth() / n {
        maxwidth()
    } else {
        a * n
    }
}

// SubPattern.getwidth.
fn width_of(widths: ref Vec[Width], p: ref Vec[Node]) -> Width {
    let mut lo = 0;
    let mut hi = 0;
    for n in p.iter() {
        match n {
            Node.Branch(items) => {
                let mut i = maxwidth();
                let mut j = 0;
                for item in items.iter() {
                    let w = width_of(widths, item);
                    if w.lo < i {
                        i = w.lo;
                    }
                    if w.hi > j {
                        j = w.hi;
                    }
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Atomic(body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Group(_, _, _, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Repeat(_, min, max, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, mul_width(w.lo, *min));
                if *max == maxrepeat() and w.hi > 0 {
                    hi = maxwidth();
                } else {
                    hi = add_width(hi, mul_width(w.hi, *max));
                }
            }
            Node.GroupRef(g) => {
                let w = ref widths[*g];
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Exists(_, yes, no) => {
                let wy = width_of(widths, yes);
                let mut i = wy.lo;
                let mut j = wy.hi;
                if no.len() > 0 {
                    let wn = width_of(widths, no);
                    if wn.lo < i {
                        i = wn.lo;
                    }
                    if wn.hi > j {
                        j = wn.hi;
                    }
                } else {
                    i = 0;
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Lit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.NotLit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.Any => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.In(_, _) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            _ => {}
        }
    }
    Width { lo: lo, hi: hi }
}

fn category_of(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        100 => 0,
        68 => 1,
        115 => 2,
        83 => 3,
        119 => 4,
        87 => 5,
        _ => -1,
    }
}

fn escape_value(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        97 => 7,
        98 => 8,
        102 => 12,
        110 => 10,
        114 => 13,
        116 => 9,
        118 => 11,
        92 => 92,
        _ => -1,
    }
}

// \x, \u and \U: the escape text so far, and the code point.
fn hex_escape(src: mut ref Tokenizer, t: T, esc: mut ref Vec[i64]) -> Result[i64, ReErr] {
    let n = if t.b == 120 { 2 } else if t.b == 117 { 4 } else { 8 };
    src.getwhile(n, 2, mut esc)?;
    if esc.len() != n + 2 {
        return Err(src.error(f"incomplete escape {to_string(esc)}", esc.len()));
    }
    let c = digits_value(esc, 2, 16);
    if c > 0x10FFFF {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(c)
}

// _class_escape: an escape inside [...], a literal or a category.
fn class_escape(src: mut ref Tokenizer, t: T) -> Result[Item, ReErr] {
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Item.Lit(e));
    }
    let cat = category_of(t);
    if cat >= 0 {
        return Ok(Item.Cat(cat));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Item.Lit(v));
    }
    if is_oct(c) {
        src.getwhile(2, 0, mut esc)?;
        let v = digits_value(esc, 1, 8);
        if v > 0o377 {
            return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
        }
        return Ok(Item.Lit(v));
    }
    if is_dec(c) or is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Item.Lit(c))
}

// _escape: an escape outside a set.
fn escape(src: mut ref Tokenizer, t: T, st: ref ParseState) -> Result[Node, ReErr] {
    let cat = category_of(t);
    if cat >= 0 {
        let mut items: Vec[Item] = Vec.new();
        items.push(Item.Cat(cat));
        return Ok(Node.In(items, false));
    }
    match t.b {
        65 => return Ok(Node.At(at_beginning_string())),
        98 => return Ok(Node.At(at_boundary())),
        66 => return Ok(Node.At(at_non_boundary())),
        90 => return Ok(Node.At(at_end_string())),
        _ => {}
    }
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Node.Lit(e));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Node.Lit(v));
    }
    if c == 48 {
        src.getwhile(2, 0, mut esc)?;
        return Ok(Node.Lit(digits_value(esc, 1, 8)));
    }
    if is_dec(c) {
        // an octal escape or a group reference
        let nt = src.next;
        if nt.n == 1 and is_dec(nt.a) {
            esc.push(nt.a);
            src.advance()?;
            let nt2 = src.next;
            if is_oct(esc[1]) and is_oct(esc[2]) and nt2.n == 1 and is_oct(nt2.a) {
                esc.push(nt2.a);
                src.advance()?;
                let v = digits_value(esc, 1, 8);
                if v > 0o377 {
                    return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
                }
                return Ok(Node.Lit(v));
            }
        }
        let group = digits_value(esc, 1, 10);
        if group < st.groups() {
            if not st.checkgroup(group) {
                return Err(src.error("cannot refer to an open group".to_string(), esc.len()));
            }
            st.checklookbehindgroup(group, src)?;
            return Ok(Node.GroupRef(group));
        }
        return Err(src.error(f"invalid group reference {group}", esc.len() - 1));
    }
    if is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Node.Lit(c))
}

fn parse_sub(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64) -> Result[Vec[Node], ReErr] {
    let mut items: Vec[Vec[Node]] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let first = nested == 0 and items.len() == 0;
        let item = parse_seq(mut src, mut st, verbose, nested + 1, first)?;
        items.push(item);
        if not src.take(124)? {
            break;
        }
        if nested == 0 {
            verbose = (st.flags & flag_x()) != 0;
        }
    }
    if items.len() == 1 {
        return Ok(items.pop().unwrap());
    }
    let mut out: Vec[Node] = Vec.new();
    out.push(Node.Branch(items));
    Ok(out)
}

// _parse_flags: None (as Err-free Ok(None)) for global flags, else the
// flags turned on and off.
fn parse_flags(src: mut ref Tokenizer, st: mut ref ParseState, first_char: T) -> Result[Option[(i64, i64)], ReErr] {
    let mut ch = first_char;
    let mut add = 0;
    let mut del = 0;
    if not tok_is(ch, 45) {
        loop {
            let flag = flag_value(ch.a);
            if ch.a == 76 {
                return Err(src.error("bad inline flags: cannot use 'L' flag with a str pattern".to_string(), 0));
            }
            add = add | flag;
            if (flag & type_flags()) != 0 and (add & type_flags()) != flag {
                return Err(src.error("bad inline flags: flags 'a', 'u' and 'L' are incompatible".to_string(), 0));
            }
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing -, : or )".to_string(), 0));
            }
            if tok_is(ch, 41) or tok_is(ch, 45) or tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing -, : or )" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if tok_is(ch, 41) {
        st.flags = st.flags | add;
        return Ok(None);
    }
    if tok_is(ch, 45) {
        ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("missing flag".to_string(), 0));
        }
        if ch.n != 1 or flag_value(ch.a) == 0 {
            let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing flag" };
            return Err(src.error(msg.to_string(), ch.n));
        }
        loop {
            let flag = flag_value(ch.a);
            if (flag & type_flags()) != 0 {
                return Err(src.error("bad inline flags: cannot turn off flags 'a', 'u' and 'L'".to_string(), 0));
            }
            del = del | flag;
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing :".to_string(), 0));
            }
            if tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing :" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if (add & del) != 0 {
        return Err(src.error("bad inline flags: flag turned on and off".to_string(), 1));
    }
    Ok(Some((add, del)))
}

fn is_alpha(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

fn parse_set(src: mut ref Tokenizer, out: mut ref Vec[Node]) -> Result[(), ReErr] {
    let here = src.tell() - 1;
    let mut set: Vec[Item] = Vec.new();
    let negate = src.take(94)?;
    loop {
        let this = src.get()?;
        if this.n == 0 {
            return Err(src.error("unterminated character set".to_string(), src.tell() - here));
        }
        if tok_is(this, 93) and set.len() > 0 {
            break;
        }
        let code1 = if this.n == 2 { class_escape(mut src, this)? } else { Item.Lit(this.a) };
        if src.take(45)? {
            let that = src.get()?;
            if that.n == 0 {
                return Err(src.error("unterminated character set".to_string(), src.tell() - here));
            }
            if tok_is(that, 93) {
                set.push(code1);
                set.push(Item.Lit(45));
                break;
            }
            let code2 = if that.n == 2 { class_escape(mut src, that)? } else { Item.Lit(that.a) };
            let text = f"{to_string(tok_text(this))}-{to_string(tok_text(that))}";
            let offset = this.n + 1 + that.n;
            let lo = match code1 {
                Item.Lit(c) => c,
                _ => -1,
            };
            let hi = match code2 {
                Item.Lit(c) => c,
                _ => -1,
            };
            if lo < 0 or hi < 0 or hi < lo {
                return Err(src.error(f"bad character range {text}", offset));
            }
            set.push(Item.Range(lo, hi));
        } else {
            set.push(code1);
        }
    }
    if set.len() == 1 {
        let only = ref set[0];
        if let Item.Lit(c) = only {
            if negate {
                out.push(Node.NotLit(*c));
            } else {
                out.push(Node.Lit(*c));
            }
            return Ok(());
        }
    }
    out.push(Node.In(set, negate));
    Ok(())
}

// The quantifier just read (its first character is `this`), applied to
// the last item. Returns false when `{` turned out to be a literal.
fn parse_repeat(src: mut ref Tokenizer, this: T, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let here = src.tell();
    let mut min = 0;
    let mut max = maxrepeat();
    if tok_is(this, 63) {
        max = 1;
    } else if tok_is(this, 43) {
        min = 1;
    } else if tok_is(this, 123) {
        if tok_is(src.next, 125) {
            out.push(Node.Lit(123));
            return Ok(false);
        }
        let mut lo: Vec[i64] = Vec.new();
        let mut hi: Vec[i64] = Vec.new();
        while src.next.n == 1 and is_dec(src.next.a) {
            lo.push(src.get()?.a);
        }
        if src.take(44)? {
            while src.next.n == 1 and is_dec(src.next.a) {
                hi.push(src.get()?.a);
            }
        } else {
            hi = lo.clone();
        }
        if not src.take(125)? {
            out.push(Node.Lit(123));
            src.seek(here)?;
            return Ok(false);
        }
        if lo.len() > 0 {
            if lo.len() > 10 or digits_value(lo, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            min = digits_value(lo, 0, 10);
        }
        if hi.len() > 0 {
            if hi.len() > 10 or digits_value(hi, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            max = digits_value(hi, 0, 10);
            if max < min {
                return Err(src.error("min repeat greater than max repeat".to_string(), src.tell() - here));
            }
        }
    }
    if out.len() == 0 or is_at(out[out.len() - 1]) {
        return Err(src.error("nothing to repeat".to_string(), src.tell() - here + 1));
    }
    if is_repeat(out[out.len() - 1]) {
        return Err(src.error("multiple repeat".to_string(), src.tell() - here + 1));
    }
    let last = out.pop().unwrap();
    let mut body: Vec[Node] = Vec.new();
    match last {
        Node.Group(0, 0, 0, p) => body = p,
        other => body.push(other),
    }
    let kind = if src.take(63)? { 1 } else if src.take(43)? { 2 } else { 0 };
    out.push(Node.Repeat(kind, min, max, body));
    Ok(true)
}

fn parse_seq(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64, first: bool) -> Result[Vec[Node], ReErr] {
    let mut out: Vec[Node] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let this = src.next;
        if this.n == 0 or tok_is(this, 124) or tok_is(this, 41) {
            break;
        }
        src.advance()?;
        if verbose {
            if this.n == 1 and (this.a == 32 or (this.a >= 9 and this.a <= 13)) {
                continue;
            }
            if tok_is(this, 35) {
                loop {
                    let t = src.get()?;
                    if t.n == 0 or tok_is(t, 10) {
                        break;
                    }
                }
                continue;
            }
        }
        if this.n == 2 {
            let node = escape(mut src, this, st)?;
            out.push(node);
            continue;
        }
        let c = this.a;
        if c == 91 {
            parse_set(mut src, mut out)?;
        } else if c == 42 or c == 43 or c == 63 or c == 123 {
            parse_repeat(mut src, this, mut out)?;
        } else if c == 46 {
            out.push(Node.Any);
        } else if c == 94 {
            out.push(Node.At(at_beginning()));
        } else if c == 36 {
            out.push(Node.At(at_end()));
        } else if c == 40 {
            if parse_group(mut src, mut st, mut verbose, nested, first, mut out)? {
                continue;
            }
        } else {
            out.push(Node.Lit(c));
        }
    }
    Ok(out)
}

// `(` and what follows. Returns true for a construct that adds nothing
// (a comment, global flags).
fn parse_group(src: mut ref Tokenizer, st: mut ref ParseState, verbose: mut ref bool, nested: i64, first: bool, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let start = src.tell() - 1;
    let mut capture = true;
    let mut atomic = false;
    let mut name: Vec[i64] = Vec.new();
    let mut named = false;
    let mut add = 0;
    let mut del = 0;
    if src.take(63)? {
        let ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("unexpected end of pattern".to_string(), 0));
        }
        if tok_is(ch, 80) {
            if src.take(60)? {
                name = src.getuntil(62, "group name")?;
                src.checkgroupname(name, 1)?;
                named = true;
            } else if src.take(61)? {
                let ref_name = src.getuntil(41, "group name")?;
                src.checkgroupname(ref_name, 1)?;
                let gid = st.group_of(ref_name);
                if gid < 0 {
                    return Err(src.error(f"unknown group name {repr_of(ref_name)}", ref_name.len() + 1));
                }
                if not st.checkgroup(gid) {
                    return Err(src.error("cannot refer to an open group".to_string(), ref_name.len() + 1));
                }
                st.checklookbehindgroup(gid, src)?;
                out.push(Node.GroupRef(gid));
                return Ok(true);
            } else {
                let c2 = src.get()?;
                if c2.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                return Err(src.error(f"unknown extension ?P{to_string(tok_text(c2))}", c2.n + 2));
            }
        } else if tok_is(ch, 58) {
            capture = false;
        } else if tok_is(ch, 35) {
            loop {
                if src.next.n == 0 {
                    return Err(src.error("missing ), unterminated comment".to_string(), src.tell() - start));
                }
                if tok_is(src.get()?, 41) {
                    break;
                }
            }
            return Ok(true);
        } else if tok_is(ch, 61) or tok_is(ch, 33) or tok_is(ch, 60) {
            let mut kind = ch;
            let mut dir = 1;
            let mut outer_lookbehind = 0;
            if tok_is(ch, 60) {
                kind = src.get()?;
                if kind.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                if not (tok_is(kind, 61) or tok_is(kind, 33)) {
                    return Err(src.error(f"unknown extension ?<{to_string(tok_text(kind))}", kind.n + 2));
                }
                dir = -1;
                outer_lookbehind = st.lookbehind_groups;
                if outer_lookbehind < 0 {
                    st.lookbehind_groups = st.groups();
                }
            }
            let p = parse_sub(mut src, mut st, *verbose, nested + 1)?;
            if dir < 0 and outer_lookbehind < 0 {
                st.lookbehind_groups = -1;
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            if tok_is(kind, 61) {
                out.push(Node.Assert(dir, false, p));
            } else if p.len() > 0 {
                out.push(Node.Assert(dir, true, p));
            } else {
                out.push(Node.Failure);
            }
            return Ok(true);
        } else if tok_is(ch, 40) {
            let condname = src.getuntil(41, "group name")?;
            let mut condgroup = 0;
            if not is_ascii_decimal(condname) {
                src.checkgroupname(condname, 1)?;
                condgroup = st.group_of(condname);
                if condgroup < 0 {
                    return Err(src.error(f"unknown group name {repr_of(condname)}", condname.len() + 1));
                }
            } else {
                if condname.len() > 10 {
                    return Err(src.error(f"invalid group reference {to_string(condname)}", condname.len() + 1));
                }
                condgroup = digits_value(condname, 0, 10);
                if condgroup == 0 {
                    return Err(src.error("bad group number".to_string(), condname.len() + 1));
                }
                if condgroup >= maxgroups() {
                    return Err(src.error(f"invalid group reference {condgroup}", condname.len() + 1));
                }
                let mut seen = false;
                for (g, _) in st.refpos.iter() {
                    if *g == condgroup {
                        seen = true;
                    }
                }
                if not seen {
                    st.refpos.push((condgroup, src.tell() - condname.len() - 1));
                }
            }
            st.checklookbehindgroup(condgroup, src)?;
            let yes = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
            let mut no: Vec[Node] = Vec.new();
            if src.take(124)? {
                no = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
                if tok_is(src.next, 124) {
                    return Err(src.error("conditional backref with more than two branches".to_string(), 0));
                }
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            out.push(Node.Exists(condgroup, yes, no));
            return Ok(true);
        } else if tok_is(ch, 62) {
            capture = false;
            atomic = true;
        } else if (ch.n == 1 and flag_value(ch.a) != 0) or tok_is(ch, 45) {
            match parse_flags(mut src, mut st, ch)? {
                None => {
                    if not first or out.len() > 0 {
                        return Err(src.error("global flags not at the start of the expression".to_string(), src.tell() - start));
                    }
                    *verbose = (st.flags & flag_x()) != 0;
                    return Ok(true);
                }
                Some((a, d)) => {
                    add = a;
                    del = d;
                    capture = false;
                }
            }
        } else {
            return Err(src.error(f"unknown extension ?{to_string(tok_text(ch))}", ch.n + 1));
        }
    }
    let mut group = 0;
    if capture {
        group = st.groups();
        st.closed.push(false);
        st.widths.push(Width { lo: 0, hi: 0 });
        if named {
            let was = st.group_of(name);
            if was >= 0 {
                return Err(src.error(f"redefinition of group name {repr_of(name)} as group {group}; was group {was}", name.len() + 1));
            }
            st.names.push((name.clone(), group));
        }
    }
    let sub_verbose = (*verbose or (add & flag_x()) != 0) and (del & flag_x()) == 0;
    let p = parse_sub(mut src, mut st, sub_verbose, nested + 1)?;
    if not src.take(41)? {
        return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
    }
    if group > 0 {
        let w = width_of(st.widths, p);
        st.widths[group] = w;
        st.closed[group] = true;
    }
    if atomic {
        out.push(Node.Atomic(p));
    } else {
        out.push(Node.Group(group, add, del, p));
    }
    Ok(false)
}

struct Parsed {
    nodes: Vec[Node],
    flags: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
    widths: Vec[Width],
}

fn parse(pattern: ref Vec[i64], flags: i64) -> Result[Parsed, ReErr] {
    let mut src = new_tokenizer(pattern)?;
    let mut st = ParseState {
        flags: flags,
        names: Vec.new(),
        closed: Vec.new(),
        widths: Vec.new(),
        lookbehind_groups: -1,
        refpos: Vec.new(),
    };
    // group 0 is the whole match
    st.closed.push(true);
    st.widths.push(Width { lo: 0, hi: 0 });
    let nodes = parse_sub(mut src, mut st, (flags & flag_x()) != 0, 0)?;
    if (st.flags & flag_a()) != 0 and (st.flags & flag_u()) != 0 {
        return Err(other_error("ValueError", "ASCII and UNICODE flags are incompatible".to_string()));
    }
    if src.next.n != 0 {
        return Err(src.error("unbalanced parenthesis".to_string(), 0));
    }
    for (g, pos) in st.refpos.iter() {
        if *g >= st.groups() {
            return Err(re_error(f"invalid group reference {*g}", *pos));
        }
    }
    let groups = st.groups() - 1;
    Ok(Parsed { nodes: nodes, flags: st.flags, groups: groups, names: st.names, widths: st.widths })
}

// ---------------------------------------------------------- compiler

enum Op {
    // character (lowered when case-insensitive), case-insensitive, ASCII
    Lit(i64, bool, bool),
    NotLit(i64, bool, bool),
    Any,
    AnyAll,
    // set, case-insensitive, ASCII-only categories
    In(i64, bool, bool),
    // anchor kind, ASCII-only word boundary
    At(i64, bool),
    Mark(i64),
    Split(i64, i64),
    Jmp(i64),
    // repeat register, the Until it starts at
    RepInit(i64, i64),
    // register, min, max, greedy, body, exit
    Until(i64, i64, i64, bool, i64, i64),
    Ref(i64, bool, bool),
    // lookbehind width (-1 for lookahead), negative, sub-program, next
    Look(i64, bool, i64, i64),
    Atomic(i64, i64),
    Exists(i64, i64),
    Fail,
    Succeed,
    Match,
}

#[derive(Clone)]
struct Program {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
}

struct CharSet {
    items: Vec[Item],
    negate: bool,
}

fn combine(flags: i64, add: i64, del: i64) -> i64 {
    let mut f = flags;
    if (add & type_flags()) != 0 {
        f = f & (0x7FFFFFFF ^ type_flags());
    }
    (f | add) & (0x7FFFFFFF ^ del)
}

struct Compiler {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
}

impl Compiler {
    fn emit(mut ref self, op: own Op) -> i64 {
        self.ops.push(op);
        self.ops.len() - 1
    }

    fn here(ref self) -> i64 {
        self.ops.len()
    }

    fn compile(mut ref self, p: ref Parsed, nodes: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let icase = (flags & flag_i()) != 0;
        let ascii = (flags & flag_a()) != 0;
        for n in nodes.iter() {
            match n {
                Node.Lit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.Lit(v, icase, ascii));
                }
                Node.NotLit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.NotLit(v, icase, ascii));
                }
                Node.Any => {
                    if (flags & flag_s()) != 0 {
                        self.emit(Op.AnyAll);
                    } else {
                        self.emit(Op.Any);
                    }
                }
                Node.In(items, negate) => {
                    self.sets.push(CharSet { items: items.clone(), negate: *negate });
                    let idx = self.sets.len() - 1;
                    self.emit(Op.In(idx, icase, ascii));
                }
                Node.At(kind) => {
                    let mut k = *kind;
                    if (flags & flag_m()) != 0 {
                        if k == at_beginning() {
                            k = at_beginning_line();
                        } else if k == at_end() {
                            k = at_end_line();
                        }
                    }
                    self.emit(Op.At(k, ascii));
                }
                Node.Branch(items) => {
                    let mut ends: Vec[i64] = Vec.new();
                    let mut i = 0;
                    while i < items.len() {
                        if i + 1 < items.len() {
                            let split = self.emit(Op.Fail);
                            self.compile(p, items[i], flags)?;
                            ends.push(self.emit(Op.Fail));
                            let next = self.here();
                            self.ops[split] = Op.Split(split + 1, next);
                        } else {
                            self.compile(p, items[i], flags)?;
                        }
                        i += 1;
                    }
                    let end = self.here();
                    for at in ends {
                        self.ops[at] = Op.Jmp(end);
                    }
                }
                Node.Group(g, add, off, body) => {
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g));
                    }
                    self.compile(p, body, combine(flags, *add, *off))?;
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g + 1));
                    }
                }
                Node.Repeat(kind, min, max, body) => {
                    if *kind == 2 {
                        let at = self.emit(Op.Fail);
                        self.compile_repeat(p, *min, *max, true, body, flags)?;
                        self.emit(Op.Succeed);
                        let next = self.here();
                        self.ops[at] = Op.Atomic(at + 1, next);
                    } else {
                        self.compile_repeat(p, *min, *max, *kind == 0, body, flags)?;
                    }
                }
                Node.Atomic(body) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Atomic(at + 1, next);
                }
                Node.Assert(dir, negative, body) => {
                    let mut width = -1;
                    if *dir < 0 {
                        let w = width_of(p.widths, body);
                        if w.lo != w.hi {
                            return Err(other_error("error", "look-behind requires fixed-width pattern".to_string()));
                        }
                        width = w.lo;
                    }
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Look(width, *negative, at + 1, next);
                }
                Node.GroupRef(g) => {
                    self.emit(Op.Ref(*g, icase, ascii));
                }
                Node.Exists(g, yes, no) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, yes, flags)?;
                    if no.len() > 0 {
                        let jump = self.emit(Op.Fail);
                        let no_pc = self.here();
                        self.compile(p, no, flags)?;
                        let end = self.here();
                        self.ops[jump] = Op.Jmp(end);
                        self.ops[at] = Op.Exists(*g, no_pc);
                    } else {
                        let end = self.here();
                        self.ops[at] = Op.Exists(*g, end);
                    }
                }
                Node.Failure => {
                    self.emit(Op.Fail);
                }
            }
        }
        Ok(())
    }

    fn compile_repeat(mut ref self, p: ref Parsed, min: i64, max: i64, greedy: bool, body: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let r = self.repeats;
        self.repeats += 1;
        let init = self.emit(Op.Fail);
        self.compile(p, body, flags)?;
        let until = self.emit(Op.Fail);
        self.ops[init] = Op.RepInit(r, until);
        self.ops[until] = Op.Until(r, min, max, greedy, init + 1, until + 1);
        Ok(())
    }
}

fn compile(pattern: ref Vec[i64], flags: i64) -> Result[Program, ReErr] {
    let p = parse(pattern, flags)?;
    let mut c = Compiler { ops: Vec.new(), sets: Vec.new(), repeats: 0 };
    c.compile(p, p.nodes, p.flags)?;
    c.emit(Op.Match);
    Ok(Program { ops: c.ops, sets: c.sets, repeats: c.repeats, groups: p.groups, names: p.names })
}

// ----------------------------------------------------------- matcher

struct Undo {
    kind: i64,
    idx: i64,
    old: i64,
}

struct Choice {
    pc: i64,
    pos: i64,
    trail: i64,
    // 0: resume at pc; 1: a lazy repeat's Until, after its tail failed
    mode: i64,
}

struct Matcher {
    s: Vec[i64],
    marks: Vec[i64],
    counts: Vec[i64],
    lasts: Vec[i64],
    lastindex: i64,
    trail: Vec[Undo],
    start: i64,
    must_advance: bool,
    match_all: bool,
}

impl Matcher {
    fn set_mark(mut ref self, slot: i64, v: i64) {
        self.trail.push(Undo { kind: 0, idx: slot, old: self.marks[slot] });
        self.marks[slot] = v;
    }

    fn set_count(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 1, idx: r, old: self.counts[r] });
        self.counts[r] = v;
    }

    fn set_last(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 2, idx: r, old: self.lasts[r] });
        self.lasts[r] = v;
    }

    fn set_lastindex(mut ref self, v: i64) {
        self.trail.push(Undo { kind: 3, idx: 0, old: self.lastindex });
        self.lastindex = v;
    }

    fn undo_to(mut ref self, len: i64) {
        while self.trail.len() > len {
            let u = self.trail.pop().unwrap();
            if u.kind == 0 {
                self.marks[u.idx] = u.old;
            } else if u.kind == 1 {
                self.counts[u.idx] = u.old;
            } else if u.kind == 2 {
                self.lasts[u.idx] = u.old;
            } else {
                self.lastindex = u.old;
            }
        }
    }

    // A group that has both marks, the end not before the start.
    fn group_span(ref self, g: i64) -> (i64, i64) {
        let a = self.marks[2 * g];
        let b = self.marks[2 * g + 1];
        if a < 0 or b < 0 or b < a {
            return (-1, -1);
        }
        (a, b)
    }

    fn at(ref self, kind: i64, ascii: bool, pos: i64) -> bool {
        let n = self.s.len();
        if kind == 0 or kind == 2 {
            return pos == 0;
        }
        if kind == 1 {
            return pos == 0 or self.s[pos - 1] == 10;
        }
        if kind == 3 {
            return pos == n or (pos == n - 1 and self.s[pos] == 10);
        }
        if kind == 4 {
            return pos == n or self.s[pos] == 10;
        }
        if kind == 5 {
            return pos == n;
        }
        if n == 0 {
            return false;
        }
        let before = pos > 0 and is_word(self.s[pos - 1], ascii);
        let after = pos < n and is_word(self.s[pos], ascii);
        if kind == 6 { before != after } else { before == after }
    }

    // Runs the program from pc at pos, backtracking through its own
    // choices only. Returns where it succeeded, or -1.
    fn run(mut ref self, prog: ref Program, pc0: i64, pos0: i64, top: bool) -> i64 {
        let base = self.trail.len();
        let mut choices: Vec[Choice] = Vec.new();
        let mut pc = pc0;
        let mut pos = pos0;
        let mut mode = 0;
        loop {
            let mut ok = true;
            let op = ref prog.ops[pc];
            if mode == 1 {
                // a lazy repeat whose tail failed: try one more item
                mode = 0;
                ok = false;
                if let Op.Until(r, _, max, _, body, _) = op {
                    let count = self.counts[*r] + 1;
                    if not ((count >= *max and *max != maxrepeat()) or pos == self.lasts[*r]) {
                        self.set_count(*r, count);
                        self.set_last(*r, pos);
                        pc = *body;
                        ok = true;
                    }
                }
                if ok {
                    continue;
                }
            } else {
                match op {
                    Op.Lit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) == *c } else { self.s[pos] == *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.NotLit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) != *c } else { self.s[pos] != *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Any => {
                        if pos < self.s.len() and self.s[pos] != 10 {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.AnyAll => {
                        if pos < self.s.len() {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.In(set, icase, ascii) => {
                        if pos < self.s.len() and in_set(prog.sets[*set], self.s[pos], *icase, *ascii) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.At(kind, ascii) => {
                        if self.at(*kind, *ascii, pos) {
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Mark(slot) => {
                        self.set_mark(*slot, pos);
                        if (*slot & 1) == 1 {
                            self.set_lastindex(*slot / 2);
                        }
                        pc += 1;
                    }
                    Op.Split(a, b) => {
                        choices.push(Choice { pc: *b, pos: pos, trail: self.trail.len(), mode: 0 });
                        pc = *a;
                    }
                    Op.Jmp(a) => pc = *a,
                    Op.RepInit(r, until) => {
                        self.set_count(*r, -1);
                        self.set_last(*r, -1);
                        pc = *until;
                    }
                    Op.Until(r, min, max, greedy, body, exit) => {
                        let count = self.counts[*r] + 1;
                        if count < *min {
                            self.set_count(*r, count);
                            pc = *body;
                        } else if *greedy {
                            if (count < *max or *max == maxrepeat()) and pos != self.lasts[*r] {
                                choices.push(Choice { pc: *exit, pos: pos, trail: self.trail.len(), mode: 0 });
                                self.set_count(*r, count);
                                self.set_last(*r, pos);
                                pc = *body;
                            } else {
                                pc = *exit;
                            }
                        } else {
                            choices.push(Choice { pc: pc, pos: pos, trail: self.trail.len(), mode: 1 });
                            pc = *exit;
                        }
                    }
                    Op.Ref(g, icase, ascii) => {
                        let (a, b) = self.group_span(*g);
                        if a < 0 {
                            ok = false;
                        } else {
                            let len = b - a;
                            if pos + len > self.s.len() {
                                ok = false;
                            } else {
                                let mut k = 0;
                                while k < len {
                                    let x = self.s[a + k];
                                    let y = self.s[pos + k];
                                    let eq = if *icase { lower(x, *ascii) == lower(y, *ascii) } else { x == y };
                                    if not eq {
                                        ok = false;
                                        break;
                                    }
                                    k += 1;
                                }
                                if ok {
                                    pos += len;
                                    pc += 1;
                                }
                            }
                        }
                    }
                    Op.Look(width, negative, sub, next) => {
                        let mark = self.trail.len();
                        let from = if *width < 0 { pos } else { pos - *width };
                        let found = from >= 0 and self.run(prog, *sub, from, false) >= 0;
                        if *negative {
                            self.undo_to(mark);
                            if found {
                                ok = false;
                            } else {
                                pc = *next;
                            }
                        } else if found {
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Atomic(sub, next) => {
                        let end = self.run(prog, *sub, pos, false);
                        if end >= 0 {
                            pos = end;
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Exists(g, no) => {
                        let (a, _) = self.group_span(*g);
                        if a >= 0 {
                            pc += 1;
                        } else {
                            pc = *no;
                        }
                    }
                    Op.Fail => ok = false,
                    Op.Succeed => return pos,
                    Op.Match => {
                        if top and ((self.match_all and pos != self.s.len()) or (self.must_advance and pos == self.start)) {
                            ok = false;
                        } else {
                            return pos;
                        }
                    }
                }
            }
            if not ok {
                match choices.pop() {
                    Some(ch) => {
                        self.undo_to(ch.trail);
                        pc = ch.pc;
                        pos = ch.pos;
                        mode = ch.mode;
                    }
                    None => {
                        self.undo_to(base);
                        return -1;
                    }
                }
            }
        }
    }
}

fn in_items(set: ref CharSet, c: i64, ascii: bool) -> bool {
    for item in set.items.iter() {
        let hit = match item {
            Item.Lit(l) => c == *l,
            Item.Range(lo, hi) => c >= *lo and c <= *hi,
            Item.Cat(k) => {
                let kind = *k;
                if kind == 0 {
                    if ascii { c >= 48 and c <= 57 } else { is_decimal(c) }
                } else if kind == 1 {
                    if ascii { not (c >= 48 and c <= 57) } else { not is_decimal(c) }
                } else if kind == 2 {
                    is_space(c, ascii)
                } else if kind == 3 {
                    not is_space(c, ascii)
                } else if kind == 4 {
                    is_word(c, ascii)
                } else {
                    not is_word(c, ascii)
                }
            }
        };
        if hit {
            return true;
        }
    }
    false
}

// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = lower(c, ascii);
        if lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program, s: ref Vec[i64]) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        s: s.clone(),
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn find(m: mut ref Matcher, prog: ref Program, from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= m.s.len() {
        let mut k = 0;
        while k < m.marks.len() {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}

// All the matches finditer gives: each search starts where the last
// match ended, and must move on past an empty one.
fn all_matches(prog: ref Program, s: ref Vec[i64], limit: i64) -> Vec[Found] {
    let mut m = new_matcher(prog, s);
    let mut out: Vec[Found] = Vec.new();
    let mut pos = 0;
    let mut must_advance = false;
    while pos <= s.len() and (limit == 0 or out.len() < limit) {
        match find(mut m, prog, pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    out
}

fn group_text(s: ref Vec[i64], span: (i64, i64), out: mut ref Vec[i64]) {
    let (a, b) = span;
    if a < 0 {
        push_ascii(mut out, "None");
    } else {
        str_repr(slice(s, a, b), mut out);
    }
}

fn span_text(span: (i64, i64)) -> String {
    let (a, b) = span;
    f"({a}, {b})"
}

fn show_match(prog: ref Program, s: ref Vec[i64], found: ref Option[Found], out: mut ref Vec[i64]) {
    let m = match found {
        Some(m) => m,
        None => {
            push_ascii(mut out, "  None\n");
            return;
        }
    };
    push_ascii(mut out, f"  span={span_text((m.start, m.end))} match=");
    str_repr(slice(s, m.start, m.end), mut out);
    out.push(10);
    if prog.groups > 0 {
        push_ascii(mut out, "  groups=(");
        let mut g = 0;
        while g < m.spans.len() {
            if g > 0 {
                push_ascii(mut out, ", ");
            }
            group_text(s, m.spans[g], mut out);
            g += 1;
        }
        if m.spans.len() == 1 {
            push_ascii(mut out, ",");
        }
        push_ascii(mut out, ")\n  spans=[");
        g = 0;
        while g < m.spans.len() {
            if g > 0 {
                push_ascii(mut out, ", ");
            }
            push_ascii(mut out, span_text(m.spans[g]));
            g += 1;
        }
        push_ascii(mut out, "]\n");
    }
    if prog.names.len() > 0 {
        push_ascii(mut out, "  named=");
        group_dict(prog, s, m, mut out);
        out.push(10);
    }
}

fn group_dict(prog: ref Program, s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    out.push(123);
    let mut k = 0;
    while k < prog.names.len() {
        if k > 0 {
            push_ascii(mut out, ", ");
        }
        let (name, g) = ref prog.names[k];
        str_repr(name, mut out);
        push_ascii(mut out, ": ");
        group_text(s, m.spans[g - 1], mut out);
        k += 1;
    }
    out.push(125);
}

// findall's item: the match, the one group, or a tuple of the groups,
// with '' for a group that did not take part.
fn findall_item(prog: ref Program, s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    if prog.groups == 0 {
        str_repr(slice(s, m.start, m.end), mut out);
        return;
    }
    if prog.groups > 1 {
        out.push(40);
    }
    let mut g = 0;
    while g < m.spans.len() {
        if g > 0 {
            push_ascii(mut out, ", ");
        }
        let (a, b) = m.spans[g];
        if a < 0 {
            push_ascii(mut out, "''");
        } else {
            str_repr(slice(s, a, b), mut out);
        }
        g += 1;
    }
    if prog.groups > 1 {
        out.push(41);
    }
}

// A replacement template: literal text and group numbers.
enum Piece {
    Text(Vec[i64]),
    Group(i64),
}

// _parser.parse_template.
fn parse_template(repl: ref Vec[i64], prog: ref Program) -> Result[Vec[Piece], ReErr] {
    let mut s = new_tokenizer(repl)?;
    let mut pieces: Vec[Piece] = Vec.new();
    let mut literal: Vec[i64] = Vec.new();
    loop {
        let this = s.get()?;
        if this.n == 0 {
            break;
        }
        if this.n == 1 {
            literal.push(this.a);
            continue;
        }
        let c = this.b;
        let mut index = -1;
        let mut offset = 0;
        if c == 103 {
            if not s.take(60)? {
                return Err(s.error("missing <".to_string(), 0));
            }
            let name = s.getuntil(62, "group name")?;
            if not is_ascii_decimal(name) {
                s.checkgroupname(name, 1)?;
                let mut found = -1;
                for (n, g) in prog.names.iter() {
                    if same(n, name) {
                        found = *g;
                    }
                }
                if found < 0 {
                    return Err(other_error("IndexError", f"unknown group name {repr_of(name)}"));
                }
                index = found;
            } else {
                if name.len() > 10 or digits_value(name, 0, 10) >= maxgroups() {
                    return Err(s.error(f"invalid group reference {to_string(name)}", name.len() + 1));
                }
                index = digits_value(name, 0, 10);
            }
            offset = name.len() + 1;
        } else if c == 48 {
            let mut text = tok_text(this);
            if s.next.n == 1 and is_oct(s.next.a) {
                text.push(s.get()?.a);
                if s.next.n == 1 and is_oct(s.next.a) {
                    text.push(s.get()?.a);
                }
            }
            literal.push(digits_value(text, 1, 8) & 0xFF);
            continue;
        } else if is_dec(c) {
            let mut text = tok_text(this);
            if s.next.n == 1 and is_dec(s.next.a) {
                text.push(s.get()?.a);
                if is_oct(c) and is_oct(text[2]) and s.next.n == 1 and is_oct(s.next.a) {
                    text.push(s.get()?.a);
                    let v = digits_value(text, 1, 8);
                    if v > 0o377 {
                        return Err(s.error(f"octal escape value {to_string(text)} outside of range 0-0o377", text.len()));
                    }
                    literal.push(v);
                    continue;
                }
            }
            index = digits_value(text, 1, 10);
            offset = text.len() - 1;
        } else {
            let e = escape_value(this);
            if e >= 0 {
                literal.push(e);
            } else if is_ascii_letter(c) {
                return Err(s.error(f"bad escape {to_string(tok_text(this))}", 2));
            } else {
                literal.push(92);
                literal.push(c);
            }
            continue;
        }
        if index > prog.groups {
            return Err(s.error(f"invalid group reference {index}", offset));
        }
        pieces.push(Piece.Text(literal));
        literal = Vec.new();
        pieces.push(Piece.Group(index));
    }
    pieces.push(Piece.Text(literal));
    Ok(pieces)
}

fn expand(pieces: ref Vec[Piece], s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    for piece in pieces.iter() {
        match piece {
            Piece.Text(t) => push_all(mut out, t),
            Piece.Group(g) => {
                let (a, b) = if *g == 0 { (m.start, m.end) } else { m.spans[*g - 1] };
                if a >= 0 {
                    push_all(mut out, slice(s, a, b));
                }
            }
        }
    }
}

// ------------------------------------------------------------ Python values
//
// What a config holds: strings and lists of strings as parsed, the
// int, float, bool and None values validation turns them into, tuples,
// and sections (by index into the config's arena of sections).

#[derive(Clone)]
enum Val {
    Str(Vec[i64]),
    List(Vec[Val]),
    Tuple(Vec[Val]),
    Int(i128),
    Float(f64),
    Bool(bool),
    Nil,
    Sec(i64),
}

// A Python exception as `! Kind: message`.
#[derive(Clone)]
struct PyErr {
    kind: String,
    msg: Vec[i64],
}

fn perr(kind: Str, msg: ref Vec[i64]) -> PyErr {
    PyErr { kind: kind.to_string(), msg: msg.clone() }
}

fn perr_s(kind: Str, msg: Str) -> PyErr {
    PyErr { kind: kind.to_string(), msg: cp(msg) }
}

fn cp(s: Str) -> Vec[i64] {
    codepoints(s.bytes())
}

fn cps(s: ref String) -> Vec[i64] {
    codepoints(s.bytes())
}

fn cat(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut out = a.clone();
    push_all(mut out, b);
    out
}

fn cat3(a: ref Vec[i64], b: ref Vec[i64], c: ref Vec[i64]) -> Vec[i64] {
    let mut out = a.clone();
    push_all(mut out, b);
    push_all(mut out, c);
    out
}

fn has(s: ref Vec[i64], c: i64) -> bool {
    for x in s {
        if x == c {
            return true;
        }
    }
    false
}

fn find_sub(s: ref Vec[i64], sub: ref Vec[i64], from: i64) -> i64 {
    let mut i = from;
    while i + sub.len() <= s.len() {
        let mut k = 0;
        while k < sub.len() and s[i + k] == sub[k] {
            k += 1;
        }
        if k == sub.len() {
            return i;
        }
        i += 1;
    }
    -1
}

fn starts(s: ref Vec[i64], prefix: Str) -> bool {
    let p = cp(prefix);
    if p.len() > s.len() {
        return false;
    }
    let mut i = 0;
    while i < p.len() {
        if s[i] != p[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn eq_s(s: ref Vec[i64], t: Str) -> bool {
    same(s, cp(t))
}

fn replace_sub(s: ref Vec[i64], old: ref Vec[i64], new: ref Vec[i64]) -> Vec[i64] {
    if old.len() == 0 {
        return s.clone();
    }
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < s.len() {
        let at = find_sub(s, old, i);
        if at < 0 {
            push_all(mut out, slice(s, i, s.len()));
            break;
        }
        push_all(mut out, slice(s, i, at));
        push_all(mut out, new);
        i = at + old.len();
    }
    out
}

// str.strip(), str.lstrip(): Python's whitespace
fn py_strip(s: ref Vec[i64]) -> Vec[i64] {
    let mut a = 0;
    let mut b = s.len();
    while a < b and is_space(s[a], false) {
        a += 1;
    }
    while b > a and is_space(s[b - 1], false) {
        b -= 1;
    }
    slice(s, a, b)
}

fn py_lstrip(s: ref Vec[i64]) -> Vec[i64] {
    let mut a = 0;
    while a < s.len() and is_space(s[a], false) {
        a += 1;
    }
    slice(s, a, s.len())
}

fn py_lower(s: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s {
        out.push(lower(c, false));
    }
    out
}

fn count_of(s: ref Vec[i64], c: i64) -> i64 {
    let mut n = 0;
    for x in s {
        if x == c {
            n += 1;
        }
    }
    n
}

fn contains_key(keys: ref Vec[Vec[i64]], k: ref Vec[i64]) -> bool {
    for x in keys {
        if same(x, k) {
            return true;
        }
    }
    false
}

fn index_key(keys: ref Vec[Vec[i64]], k: ref Vec[i64]) -> i64 {
    let mut i = 0;
    while i < keys.len() {
        if same(keys[i], k) {
            return i;
        }
        i += 1;
    }
    -1
}

fn remove_key(keys: mut ref Vec[Vec[i64]], k: ref Vec[i64]) {
    let i = index_key(keys, k);
    if i >= 0 {
        keys.remove(i);
    }
}

fn type_name(v: ref Val) -> Str {
    match v {
        Val.Str(_) => "str",
        Val.List(_) => "list",
        Val.Tuple(_) => "tuple",
        Val.Int(_) => "int",
        Val.Float(_) => "float",
        Val.Bool(_) => "bool",
        Val.Nil => "NoneType",
        Val.Sec(_) => "Section",
    }
}

fn is_str(v: ref Val) -> bool {
    match v {
        Val.Str(_) => true,
        _ => false,
    }
}

fn str_of(v: ref Val) -> Vec[i64] {
    match v {
        Val.Str(s) => s.clone(),
        _ => Vec.new(),
    }
}

fn float_text(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    if x == f64.INFINITY {
        return "inf".to_string();
    }
    if x == -f64.INFINITY {
        return "-inf".to_string();
    }
    f"{x}"
}

// ---- equality, as Python compares the values validation produces

fn num_of(v: ref Val) -> Option[f64] {
    match v {
        Val.Int(n) => Some(n as f64),
        Val.Float(f) => Some(f),
        Val.Bool(b) => Some(if b { 1.0 } else { 0.0 }),
        _ => None,
    }
}

fn int_like(v: ref Val) -> Option[i128] {
    match v {
        Val.Int(n) => Some(n),
        Val.Bool(b) => Some(if b { 1 } else { 0 }),
        _ => None,
    }
}

fn seq_eq(a: ref Vec[Val], b: ref Vec[Val]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if not py_eq(a[i], b[i]) {
            return false;
        }
        i += 1;
    }
    true
}

fn py_eq(a: ref Val, b: ref Val) -> bool {
    match (a, b) {
        (Val.Str(x), Val.Str(y)) => same(x, y),
        (Val.List(x), Val.List(y)) => seq_eq(x, y),
        (Val.Tuple(x), Val.Tuple(y)) => seq_eq(x, y),
        (Val.Nil, Val.Nil) => true,
        (Val.Sec(x), Val.Sec(y)) => x == y,
        _ => {
            match (int_like(a), int_like(b)) {
                (Some(x), Some(y)) => x == y,
                _ => match (num_of(a), num_of(b)) {
                    (Some(x), Some(y)) => x == y,
                    _ => false,
                },
            }
        }
    }
}

// ---- Python's int() and float() of a string

const DIGIT_STARTS: Array[i64, 67] = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];

// the value of a Unicode decimal digit (the runs is_decimal knows), or -1
fn decimal_value(c: i64) -> i64 {
    if c >= 48 and c <= 57 {
        return c - 48;
    }
    if c < 0x80 {
        return -1;
    }
    for s in DIGIT_STARTS {
        if c >= s and c < s + 10 {
            return c - s;
        }
    }
    -1
}

// int(text): None where Python raises ValueError (or past 128 bits)
fn parse_int(text: ref Vec[i64]) -> Option[i128] {
    let s = py_strip(text);
    let mut i = 0;
    let mut neg = false;
    if i < s.len() and (s[i] == 43 or s[i] == 45) {
        neg = s[i] == 45;
        i += 1;
    }
    if i >= s.len() {
        return None;
    }
    let mut n: i128 = 0;
    let mut prev_digit = false;
    while i < s.len() {
        let c = s[i];
        if c == 95 {
            if not prev_digit or i + 1 >= s.len() or decimal_value(s[i + 1]) < 0 {
                return None;
            }
            prev_digit = false;
        } else {
            let d = decimal_value(c);
            if d < 0 {
                return None;
            }
            n = n.checked_mul(10)?.checked_add(d as i128)?;
            prev_digit = true;
        }
        i += 1;
    }
    Some(if neg { -n } else { n })
}

fn int_error(text: ref Vec[i64]) -> PyErr {
    perr("ValueError", cat(cp("invalid literal for int() with base 10: "), cp(repr_of(text))))
}

fn float_error(text: ref Vec[i64]) -> PyErr {
    perr("ValueError", cat(cp("could not convert string to float: "), cp(repr_of(text))))
}

// digits with single underscores between them, appended as ASCII;
// the index after them
fn digit_part(s: ref Vec[i64], start: i64, out: mut ref Vec[i64]) -> i64 {
    let mut i = start;
    while i < s.len() {
        let d = decimal_value(s[i]);
        if d >= 0 {
            out.push(48 + d);
            i += 1;
        } else if s[i] == 95 and i > start and i + 1 < s.len() and decimal_value(s[i + 1]) >= 0 and decimal_value(s[i - 1]) >= 0 {
            i += 1;
        } else {
            break;
        }
    }
    i
}

// float(text): None where Python raises ValueError
fn parse_float(text: ref Vec[i64]) -> Option[f64] {
    let s = py_strip(text);
    let mut i = 0;
    let mut sign: Vec[i64] = Vec.new();
    if i < s.len() and (s[i] == 43 or s[i] == 45) {
        if s[i] == 45 {
            sign.push(45);
        }
        i += 1;
    }
    let rest = py_lower(slice(s, i, s.len()));
    if eq_s(rest, "inf") or eq_s(rest, "infinity") {
        return Some(if sign.len() > 0 { -f64.INFINITY } else { f64.INFINITY });
    }
    if eq_s(rest, "nan") {
        return Some(f64.NAN);
    }
    let mut ascii = sign.clone();
    let mut int_part: Vec[i64] = Vec.new();
    let after_int = digit_part(s, i, mut int_part);
    let has_int = after_int > i;
    i = after_int;
    if has_int {
        push_all(mut ascii, int_part);
    } else {
        ascii.push(48);
    }
    let mut has_frac = false;
    if i < s.len() and s[i] == 46 {
        i += 1;
        let mut frac: Vec[i64] = Vec.new();
        let after = digit_part(s, i, mut frac);
        has_frac = after > i;
        i = after;
        ascii.push(46);
        if has_frac {
            push_all(mut ascii, frac);
        } else {
            ascii.push(48);
        }
    }
    if not has_int and not has_frac {
        return None;
    }
    if i < s.len() and (s[i] == 101 or s[i] == 69) {
        i += 1;
        ascii.push(101);
        if i < s.len() and (s[i] == 43 or s[i] == 45) {
            ascii.push(s[i]);
            i += 1;
        }
        let mut exp: Vec[i64] = Vec.new();
        let after = digit_part(s, i, mut exp);
        if after == i {
            return None;
        }
        i = after;
        push_all(mut ascii, exp);
    }
    if i != s.len() {
        return None;
    }
    f64.parse(to_string(ascii)).ok()
}

// int(v) of any value
fn int_of(v: ref Val) -> Result[i128, PyErr] {
    match v {
        Val.Str(s) => match parse_int(s) {
            Some(n) => Ok(n),
            None => Err(int_error(s)),
        },
        Val.Int(n) => Ok(n),
        Val.Bool(b) => Ok(if b { 1 } else { 0 }),
        Val.Float(f) => Ok(f as i128),
        _ => Err(perr("TypeError", cp(f"int() argument must be a string, a bytes-like object or a real number, not '{type_name(v)}'"))),
    }
}

fn float_of(v: ref Val) -> Result[f64, PyErr] {
    match v {
        Val.Str(s) => match parse_float(s) {
            Some(f) => Ok(f),
            None => Err(float_error(s)),
        },
        Val.Int(n) => Ok(n as f64),
        Val.Bool(b) => Ok(if b { 1.0 } else { 0.0 }),
        Val.Float(f) => Ok(f),
        _ => Err(perr("TypeError", cp(f"float() argument must be a string or a real number, not '{type_name(v)}'"))),
    }
}

// ---- JSON, for the job arguments: objects keep their key order

#[derive(Clone)]
enum J {
    Null,
    Bool(bool),
    Int(i128),
    Float(f64),
    Str(Vec[i64]),
    Arr(Vec[J]),
    Obj(Vec[(Vec[i64], J)]),
}

#[derive(Clone)]
struct Jr {
    c: Vec[i64],
    pos: i64,
}

impl Jr {
    fn skip(mut ref self) {
        while self.pos < self.c.len() and (self.c[self.pos] == 32 or self.c[self.pos] == 10 or self.c[self.pos] == 9 or self.c[self.pos] == 13) {
            self.pos += 1;
        }
    }

    fn peek(ref self) -> i64 {
        if self.pos < self.c.len() { self.c[self.pos] } else { -1 }
    }

    fn word(mut ref self, w: Str) -> bool {
        let wc = cp(w);
        let mut k = 0;
        while k < wc.len() {
            if self.pos + k >= self.c.len() or self.c[self.pos + k] != wc[k] {
                return false;
            }
            k += 1;
        }
        self.pos += wc.len();
        true
    }

    fn hex4(mut ref self) -> i64 {
        let mut n = 0;
        let mut k = 0;
        while k < 4 {
            let c = self.c[self.pos];
            let d = if c >= 48 and c <= 57 { c - 48 } else if c >= 97 and c <= 102 { c - 87 } else { c - 55 };
            n = n * 16 + d;
            self.pos += 1;
            k += 1;
        }
        n
    }

    fn string(mut ref self) -> Vec[i64] {
        self.pos += 1;
        let mut out: Vec[i64] = Vec.new();
        while self.pos < self.c.len() and self.c[self.pos] != 34 {
            let x = self.c[self.pos];
            if x != 92 {
                out.push(x);
                self.pos += 1;
                continue;
            }
            let e = self.c[self.pos + 1];
            self.pos += 2;
            if e == 117 {
                let mut u = self.hex4();
                if u >= 0xD800 and u < 0xDC00 and self.pos + 1 < self.c.len() and self.c[self.pos] == 92 and self.c[self.pos + 1] == 117 {
                    self.pos += 2;
                    let lo = self.hex4();
                    u = 0x10000 + (u - 0xD800) * 0x400 + (lo - 0xDC00);
                }
                out.push(u);
            } else {
                out.push(if e == 110 { 10 } else if e == 116 { 9 } else if e == 114 { 13 } else if e == 98 { 8 } else if e == 102 { 12 } else { e });
            }
        }
        self.pos += 1;
        out
    }

    fn number(mut ref self) -> J {
        let start = self.pos;
        let mut is_float = false;
        while self.pos < self.c.len() {
            let x = self.c[self.pos];
            if x == 46 or x == 101 or x == 69 {
                is_float = true;
            } else if not ((x >= 48 and x <= 57) or x == 45 or x == 43) {
                break;
            }
            self.pos += 1;
        }
        let text = to_string(slice(self.c, start, self.pos));
        if is_float {
            J.Float(f64.parse(text).unwrap_or(0.0))
        } else {
            J.Int(i128.parse(text).unwrap_or(0))
        }
    }

    fn value(mut ref self) -> J {
        self.skip();
        let x = self.peek();
        if x == 123 {
            self.pos += 1;
            let mut items: Vec[(Vec[i64], J)] = Vec.new();
            self.skip();
            if self.peek() == 125 {
                self.pos += 1;
                return J.Obj(items);
            }
            loop {
                self.skip();
                let k = self.string();
                self.skip();
                self.pos += 1;
                let v = self.value();
                items.push((k, v));
                self.skip();
                let sep = self.peek();
                self.pos += 1;
                if sep != 44 {
                    break;
                }
            }
            return J.Obj(items);
        }
        if x == 91 {
            self.pos += 1;
            let mut out: Vec[J] = Vec.new();
            self.skip();
            if self.peek() == 93 {
                self.pos += 1;
                return J.Arr(out);
            }
            loop {
                out.push(self.value());
                self.skip();
                let sep = self.peek();
                self.pos += 1;
                if sep != 44 {
                    break;
                }
            }
            return J.Arr(out);
        }
        if x == 34 {
            return J.Str(self.string());
        }
        if self.word("true") {
            return J.Bool(true);
        }
        if self.word("false") {
            return J.Bool(false);
        }
        if self.word("null") {
            return J.Null;
        }
        self.number()
    }
}

fn load_json(text: ref Vec[i64]) -> J {
    let mut r = Jr { c: text.clone(), pos: 0 };
    r.value()
}

fn j_get(j: ref J, key: Str) -> Option[J] {
    match j {
        J.Obj(items) => {
            for (k, v) in items.iter() {
                if eq_s(k, key) {
                    return Some(v.clone());
                }
            }
            None
        }
        _ => None,
    }
}

fn j_bool(j: ref J, key: Str, dflt: bool) -> bool {
    match j_get(j, key) {
        Some(J.Bool(b)) => b,
        _ => dflt,
    }
}
// ------------------------------------------------------------ the patterns
//
// configobj and validate find everything with re; these are their
// compiled patterns, built from the pattern text and flags of the
// copies in configobj/ (see the generated section).

struct Pats {
    keyword: Program,
    sectionmarker: Program,
    valueexp: Program,
    listvalueexp: Program,
    nolistvalue: Program,
    single_line_single: Program,
    single_line_double: Program,
    multi_line_single: Program,
    multi_line_double: Program,
    cp_keycre: Program,
    tp_keycre: Program,
    func_re: Program,
    key_arg: Program,
    list_arg: Program,
    list_members: Program,
    paramfinder: Program,
}

fn compile_named(name: Str) -> Result[Program, String] {
    let (text, flags) = pattern_source(name);
    match compile(cps(text), flags) {
        Ok(p) => Ok(p),
        Err(e) => Err(f"pattern {name}: {err_text(e)}"),
    }
}

fn new_pats() -> Result[Pats, String] {
    Ok(Pats {
        keyword: compile_named("keyword")?,
        sectionmarker: compile_named("sectionmarker")?,
        valueexp: compile_named("valueexp")?,
        listvalueexp: compile_named("listvalueexp")?,
        nolistvalue: compile_named("nolistvalue")?,
        single_line_single: compile_named("single_line_single")?,
        single_line_double: compile_named("single_line_double")?,
        multi_line_single: compile_named("multi_line_single")?,
        multi_line_double: compile_named("multi_line_double")?,
        cp_keycre: compile_named("cp_keycre")?,
        tp_keycre: compile_named("tp_keycre")?,
        func_re: compile_named("func_re")?,
        key_arg: compile_named("key_arg")?,
        list_arg: compile_named("list_arg")?,
        list_members: compile_named("list_members")?,
        paramfinder: compile_named("paramfinder")?,
    })
}

// pattern.match(s), pattern.search(s, pos)
fn re_match(p: ref Program, s: ref Vec[i64]) -> Option[Found] {
    let mut m = new_matcher(p, s);
    find(mut m, p, 0, false, 1)
}

fn re_search(p: ref Program, s: ref Vec[i64], from: i64) -> Option[Found] {
    if from > s.len() {
        return None;
    }
    let mut m = new_matcher(p, s);
    find(mut m, p, from, false, 0)
}

// match.group(g): None for a group that did not take part
fn grp(s: ref Vec[i64], f: ref Found, g: i64) -> Option[Vec[i64]] {
    let (a, b) = f.spans[g - 1];
    if a < 0 { None } else { Some(slice(s, a, b)) }
}

fn grp_named(p: ref Program, s: ref Vec[i64], f: ref Found, name: Str) -> Option[Vec[i64]] {
    for (n, g) in p.names.iter() {
        if eq_s(n, name) {
            return grp(s, f, g);
        }
    }
    None
}

// pattern.findall(s) for a pattern with one group
fn findall1(p: ref Program, s: ref Vec[i64]) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    for f in all_matches(p, s, 0) {
        out.push(grp(s, f, 1).unwrap_or(Vec.new()));
    }
    out
}

// ------------------------------------------------------------ sections

// ConfigObj's `interpolation` option: False, True or an engine name
#[derive(Clone)]
enum Interp {
    Off,
    On,
    Name(Vec[i64]),
}

fn interp_truthy(i: ref Interp) -> bool {
    match i {
        Interp.Off => false,
        Interp.On => true,
        Interp.Name(s) => s.len() > 0,
    }
}

#[derive(Clone)]
struct Sec {
    name: Option[Vec[i64]],
    depth: i64,
    parent: i64,
    scalars: Vec[Vec[i64]],
    sections: Vec[Vec[i64]],
    // the dict itself
    keys: Vec[Vec[i64]],
    vals: Vec[Val],
    // comments and inline_comments, which always share their keys
    ckeys: Vec[Vec[i64]],
    comments: Vec[Vec[Vec[i64]]],
    inline: Vec[Option[Vec[i64]]],
    // a section of the configspec, or -1 for None
    configspec: i64,
    defaults: Vec[Vec[i64]],
    dkeys: Vec[Vec[i64]],
    dvals: Vec[Val],
    extra_values: Vec[Vec[i64]],
    created: bool,
    // the interpolation engine once chosen: 0 configparser, 1 template
    engine: i64,
}

fn new_sec(parent: i64, depth: i64, name: own Option[Vec[i64]]) -> Sec {
    Sec {
        name: name,
        depth: depth,
        parent: parent,
        scalars: Vec.new(),
        sections: Vec.new(),
        keys: Vec.new(),
        vals: Vec.new(),
        ckeys: Vec.new(),
        comments: Vec.new(),
        inline: Vec.new(),
        configspec: -1,
        defaults: Vec.new(),
        dkeys: Vec.new(),
        dvals: Vec.new(),
        extra_values: Vec.new(),
        created: false,
        engine: -1,
    }
}

// one error _handle_error stored
#[derive(Clone)]
struct CfgErr {
    kind: String,
    msg: Vec[i64],
    line_number: i64,
    line: Vec[i64],
}

#[derive(Clone)]
struct Config {
    secs: Vec[Sec],
    interpolation: Interp,
    list_values: bool,
    raise_errors: bool,
    stringify: bool,
    indent_type: Option[Vec[i64]],
    encoding: Option[Vec[i64]],
    write_empty_values: bool,
    inspec: bool,
    initial_comment: Vec[Vec[i64]],
    final_comment: Vec[Vec[i64]],
    newlines: Option[Vec[i64]],
    errors: Vec[CfgErr],
    // the configspec, when one was given (zero or one of them)
    spec: Vec[Config],
}

fn new_config() -> Config {
    let mut secs: Vec[Sec] = Vec.new();
    secs.push(new_sec(0, 0, None));
    Config {
        secs: secs,
        interpolation: Interp.On,
        list_values: true,
        raise_errors: false,
        stringify: true,
        indent_type: None,
        encoding: None,
        write_empty_values: false,
        inspec: false,
        initial_comment: Vec.new(),
        final_comment: Vec.new(),
        newlines: None,
        errors: Vec.new(),
        spec: Vec.new(),
    }
}

fn key_error(key: ref Vec[i64]) -> PyErr {
    perr("KeyError", cp(repr_of(key)))
}

fn raw_get(c: ref Config, si: i64, key: ref Vec[i64]) -> Option[Val] {
    let i = index_key(c.secs[si].keys, key);
    if i < 0 { None } else { Some(c.secs[si].vals[i].clone()) }
}

fn in_dict(c: ref Config, si: i64, key: ref Vec[i64]) -> bool {
    index_key(c.secs[si].keys, key) >= 0
}

fn dict_set(c: mut ref Config, si: i64, key: ref Vec[i64], v: own Val) {
    let i = index_key(c.secs[si].keys, key);
    if i < 0 {
        c.secs[si].keys.push(key.clone());
        c.secs[si].vals.push(v.clone());
    } else {
        c.secs[si].vals[i] = v;
    }
}

fn dict_del(c: mut ref Config, si: i64, key: ref Vec[i64]) -> bool {
    let i = index_key(c.secs[si].keys, key);
    if i < 0 {
        return false;
    }
    c.secs[si].keys.remove(i);
    c.secs[si].vals.remove(i);
    true
}

fn sec_of(v: ref Val) -> i64 {
    match v {
        Val.Sec(i) => i,
        _ => -1,
    }
}

fn order(c: ref Config, si: i64) -> Vec[Vec[i64]] {
    let mut out = c.secs[si].scalars.clone();
    for k in c.secs[si].sections.iter() {
        out.push(k.clone());
    }
    out
}

fn comment_index(c: ref Config, si: i64, key: ref Vec[i64]) -> i64 {
    index_key(c.secs[si].ckeys, key)
}

fn set_comments(c: mut ref Config, si: i64, key: ref Vec[i64], lines: own Vec[Vec[i64]], inline: own Option[Vec[i64]]) {
    let i = comment_index(c, si, key);
    if i < 0 {
        c.secs[si].ckeys.push(key.clone());
        c.secs[si].comments.push(lines.clone());
        c.secs[si].inline.push(inline.clone());
    } else {
        c.secs[si].comments[i] = lines;
        c.secs[si].inline[i] = inline;
    }
}

fn set_inline(c: mut ref Config, si: i64, key: ref Vec[i64], inline: own Option[Vec[i64]]) {
    let i = comment_index(c, si, key);
    if i >= 0 {
        c.secs[si].inline[i] = inline;
    }
}

fn set_comment_lines(c: mut ref Config, si: i64, key: ref Vec[i64], lines: own Vec[Vec[i64]]) {
    let i = comment_index(c, si, key);
    if i >= 0 {
        c.secs[si].comments[i] = lines;
    }
}

// Section.__setitem__ for a value that is not a dict
fn set_value(c: mut ref Config, si: i64, key: ref Vec[i64], value: own Val) -> Result[(), PyErr] {
    if comment_index(c, si, key) < 0 {
        set_comments(mut c, si, key, Vec.new(), Some(Vec.new()));
    }
    remove_key(mut c.secs[si].defaults, key);
    match value {
        Val.Sec(_) => {
            if not in_dict(c, si, key) {
                c.secs[si].sections.push(key.clone());
            }
            dict_set(mut c, si, key, value);
        }
        _ => {
            if not in_dict(c, si, key) {
                c.secs[si].scalars.push(key.clone());
            }
            if not c.stringify {
                match value {
                    Val.Str(_) => {}
                    Val.List(ref items) => {
                        for e in items.iter() {
                            if not is_str(e) {
                                return Err(perr("TypeError", cp(f"Value is not a string \"{to_string(py_str(e))}\".")));
                            }
                        }
                    }
                    Val.Tuple(ref items) => {
                        for e in items.iter() {
                            if not is_str(e) {
                                return Err(perr("TypeError", cp(f"Value is not a string \"{to_string(py_str(e))}\".")));
                            }
                        }
                    }
                    _ => return Err(perr("TypeError", cp(f"Value is not a string \"{to_string(py_str(value))}\"."))),
                }
            }
            dict_set(mut c, si, key, value);
        }
    }
    Ok(())
}

// Section.__setitem__ for a dict: a new section built from its items
fn set_dict(c: mut ref Config, si: i64, key: ref Vec[i64], items: ref Vec[(Vec[i64], J)]) -> Result[(), PyErr] {
    if comment_index(c, si, key) < 0 {
        set_comments(mut c, si, key, Vec.new(), Some(Vec.new()));
    }
    remove_key(mut c.secs[si].defaults, key);
    if not in_dict(c, si, key) {
        c.secs[si].sections.push(key.clone());
    }
    let depth = c.secs[si].depth + 1;
    c.secs.push(new_sec(si, depth, Some(key.clone())));
    let ni = c.secs.len() - 1;
    for (k, v) in items.iter() {
        set_json(mut c, ni, k, v)?;
    }
    dict_set(mut c, si, key, Val.Sec(ni));
    Ok(())
}

fn json_val(j: ref J) -> Val {
    match j {
        J.Null => Val.Nil,
        J.Bool(b) => Val.Bool(b),
        J.Int(n) => Val.Int(n),
        J.Float(f) => Val.Float(f),
        J.Str(s) => Val.Str(s.clone()),
        J.Arr(items) => Val.List(items.iter().map(|x| json_val(x)).collect()),
        J.Obj(_) => Val.Nil,
    }
}

fn set_json(c: mut ref Config, si: i64, key: ref Vec[i64], j: ref J) -> Result[(), PyErr] {
    match j {
        J.Obj(items) => set_dict(mut c, si, key, items),
        _ => set_value(mut c, si, key, json_val(j)),
    }
}

// ------------------------------------------------------------ interpolation

fn missing_option(key: ref Vec[i64]) -> PyErr {
    perr("MissingInterpolationOption", cat3(cp("missing option \""), key, cp("\" in interpolation.")))
}

fn is_none(v: ref Option[Val]) -> bool {
    match v {
        None => true,
        Some(Val.Nil) => true,
        _ => false,
    }
}

fn is_sec_val(v: ref Option[Val]) -> bool {
    match v {
        Some(Val.Sec(_)) => true,
        _ => false,
    }
}

// InterpolationEngine._fetch: the value and the section it was found in
fn fetch(c: mut ref Config, si: i64, key: ref Vec[i64]) -> Result[(Val, i64), PyErr] {
    let save = c.interpolation.clone();
    c.interpolation = Interp.Off;
    let mut cur = si;
    let mut val: Option[Val] = None;
    loop {
        val = raw_get(c, cur, key);
        if not is_none(val) and not is_sec_val(val) {
            break;
        }
        val = match raw_get(c, cur, cp("DEFAULT")) {
            None => None,
            Some(Val.Sec(d)) => raw_get(c, d, key),
            Some(other) => {
                // .get on a value that is not a dict: the error leaves
                // interpolation switched off, as in configobj
                return Err(perr("AttributeError", cp(f"'{type_name(other)}' object has no attribute 'get'")));
            }
        };
        if not is_none(val) and not is_sec_val(val) {
            break;
        }
        if c.secs[cur].parent == cur {
            break;
        }
        cur = c.secs[cur].parent;
    }
    c.interpolation = save;
    match val {
        Some(v) => {
            match v {
                Val.Nil => Err(missing_option(key)),
                _ => Ok((v, cur)),
            }
        }
        None => Err(missing_option(key)),
    }
}

fn on_trail(trail: ref Vec[(Vec[i64], Option[Vec[i64]])], key: ref Vec[i64], name: ref Option[Vec[i64]]) -> i64 {
    let mut i = 0;
    while i < trail.len() {
        let (k, n) = trail[i].clone();
        if same(k, key) {
            let same_name = match (n, name) {
                (None, None) => true,
                (Some(a), Some(b)) => same(a, b),
                _ => false,
            };
            if same_name {
                return i;
            }
        }
        i += 1;
    }
    -1
}

fn recursive_interpolate(c: mut ref Config, re: ref Pats, si: i64, eng: i64, key: ref Vec[i64], value: ref Val, sname: ref Option[Vec[i64]], trail: mut ref Vec[(Vec[i64], Option[Vec[i64]])]) -> Result[Vec[i64], PyErr] {
    if on_trail(trail, key, sname) >= 0 {
        return Err(perr("InterpolationLoopError", cat3(cp("interpolation loop detected in value \""), key, cp("\"."))));
    }
    trail.push((key.clone(), sname.clone()));
    let mut v = match value {
        Val.Str(s) => s.clone(),
        _ => return Err(perr("TypeError", cp(f"expected string or bytes-like object, got '{type_name(value)}'"))),
    };
    let keycre = if eng == 0 { re.cp_keycre.clone() } else { re.tp_keycre.clone() };
    let mut m = re_search(keycre, v, 0);
    loop {
        let found = match m {
            Some(f) => f,
            None => break,
        };
        let mut lookup: Option[Vec[i64]] = None;
        let mut replacement: Vec[i64] = Vec.new();
        if eng == 0 {
            lookup = grp(v, found, 1);
        } else {
            let named = grp_named(keycre, v, found, "named");
            lookup = match named {
                Some(n) => if n.len() > 0 { Some(n) } else { grp_named(keycre, v, found, "braced") },
                None => grp_named(keycre, v, found, "braced"),
            };
            if lookup.is_none() {
                replacement = match grp_named(keycre, v, found, "escaped") {
                    Some(_) => cp("$"),
                    None => slice(v, found.start, found.end),
                };
            }
        }
        if let Some(k) = lookup {
            let (fv, fs) = fetch(mut c, si, k)?;
            let fname = c.secs[fs].name.clone();
            replacement = recursive_interpolate(mut c, re, si, eng, k, fv, fname, mut trail)?;
        }
        let start = found.start;
        let mut next = slice(v, 0, start);
        push_all(mut next, replacement);
        push_all(mut next, slice(v, found.end, v.len()));
        v = next;
        m = re_search(keycre, v, start + replacement.len());
    }
    let at = on_trail(trail, key, sname);
    trail.remove(at);
    Ok(v)
}

// Section._interpolate
fn interpolate(c: mut ref Config, re: ref Pats, si: i64, key: ref Vec[i64], value: ref Vec[i64]) -> Result[Vec[i64], PyErr] {
    if c.secs[si].engine < 0 {
        let name = match c.interpolation {
            Interp.Name(s) => py_lower(s),
            _ => cp("configparser"),
        };
        if eq_s(name, "configparser") {
            c.secs[si].engine = 0;
        } else if eq_s(name, "template") {
            c.secs[si].engine = 1;
        } else {
            c.interpolation = Interp.Off;
            return Ok(value.clone());
        }
    }
    let eng = c.secs[si].engine;
    let cookie = if eng == 0 { 37 } else { 36 };
    if not has(value, cookie) {
        return Ok(value.clone());
    }
    let mut trail: Vec[(Vec[i64], Option[Vec[i64]])] = Vec.new();
    let sname = c.secs[si].name.clone();
    recursive_interpolate(mut c, re, si, eng, key, Val.Str(value.clone()), sname, mut trail)
}

// Section.__getitem__
fn getitem(c: mut ref Config, re: ref Pats, si: i64, key: ref Vec[i64]) -> Result[Val, PyErr] {
    let val = match raw_get(c, si, key) {
        Some(v) => v,
        None => return Err(key_error(key)),
    };
    if interp_truthy(c.interpolation) {
        match val {
            Val.Str(s) => return Ok(Val.Str(interpolate(mut c, re, si, key, s)?)),
            Val.List(items) => {
                let mut out: Vec[Val] = Vec.new();
                for e in items.iter() {
                    match e {
                        Val.Str(s) => out.push(Val.Str(interpolate(mut c, re, si, key, s)?)),
                        _ => out.push(e.clone()),
                    }
                }
                return Ok(Val.List(out));
            }
            _ => {}
        }
    }
    Ok(val)
}

// Section.get(key) with no default: None for a missing key
fn get_opt(c: mut ref Config, re: ref Pats, si: i64, key: ref Vec[i64]) -> Result[Option[Val], PyErr] {
    match getitem(mut c, re, si, key) {
        Ok(v) => Ok(Some(v)),
        Err(e) => if e.kind == "KeyError" { Ok(None) } else { Err(e) },
    }
}

// ------------------------------------------------------------ repr and str

fn py_str(v: ref Val) -> Vec[i64] {
    match v {
        Val.Str(s) => s.clone(),
        _ => {
            let mut out: Vec[i64] = Vec.new();
            plain_repr(v, mut out);
            out
        }
    }
}

// repr of a value with no section in it
fn plain_repr(v: ref Val, out: mut ref Vec[i64]) {
    match v {
        Val.Str(s) => str_repr(s, mut out),
        Val.List(items) => {
            out.push(91);
            let mut first = true;
            for e in items.iter() {
                if not first {
                    push_ascii(mut out, ", ");
                }
                first = false;
                plain_repr(e, mut out);
            }
            out.push(93);
        }
        Val.Tuple(items) => {
            out.push(40);
            let mut first = true;
            for e in items.iter() {
                if not first {
                    push_ascii(mut out, ", ");
                }
                first = false;
                plain_repr(e, mut out);
            }
            if items.len() == 1 {
                out.push(44);
            }
            out.push(41);
        }
        Val.Int(n) => push_ascii(mut out, f"{n}"),
        Val.Float(f) => push_ascii(mut out, float_text(f)),
        Val.Bool(b) => push_ascii(mut out, if b { "True" } else { "False" }),
        Val.Nil => push_ascii(mut out, "None"),
        Val.Sec(_) => push_ascii(mut out, "{...}"),
    }
}

fn val_repr(c: mut ref Config, re: ref Pats, v: ref Val, out: mut ref Vec[i64]) -> Result[(), PyErr] {
    match v {
        Val.Sec(i) => section_repr(mut c, re, i, false, mut out),
        Val.List(items) => {
            out.push(91);
            let mut first = true;
            for e in items.iter() {
                if not first {
                    push_ascii(mut out, ", ");
                }
                first = false;
                val_repr(mut c, re, e, mut out)?;
            }
            out.push(93);
            Ok(())
        }
        _ => {
            plain_repr(v, mut out);
            Ok(())
        }
    }
}

// Section.__repr__ (ConfigObj's for the top): a value whose
// interpolation names a missing option is shown uninterpolated
fn section_repr(c: mut ref Config, re: ref Pats, si: i64, top: bool, out: mut ref Vec[i64]) -> Result[(), PyErr] {
    if top {
        push_ascii(mut out, "ConfigObj(");
    }
    out.push(123);
    let mut first = true;
    for key in order(c, si) {
        let v = match getitem(mut c, re, si, key) {
            Ok(v) => v,
            Err(e) => {
                if e.kind != "MissingInterpolationOption" {
                    return Err(e);
                }
                raw_get(c, si, key).unwrap()
            }
        };
        if not first {
            push_ascii(mut out, ", ");
        }
        first = false;
        str_repr(key, mut out);
        push_ascii(mut out, ": ");
        val_repr(mut c, re, v, mut out)?;
    }
    out.push(125);
    if top {
        out.push(41);
    }
    Ok(())
}

// Section.dict(): like the repr, but an interpolation error stops it
fn dict_repr(c: mut ref Config, re: ref Pats, si: i64, out: mut ref Vec[i64]) -> Result[(), PyErr] {
    out.push(123);
    let mut first = true;
    for key in order(c, si) {
        let v = getitem(mut c, re, si, key)?;
        if not first {
            push_ascii(mut out, ", ");
        }
        first = false;
        str_repr(key, mut out);
        push_ascii(mut out, ": ");
        match v {
            Val.Sec(i) => dict_repr(mut c, re, i, mut out)?,
            _ => val_repr(mut c, re, v, mut out)?,
        }
    }
    out.push(125);
    Ok(())
}

fn repr_text(c: mut ref Config, re: ref Pats, v: ref Val) -> Result[String, PyErr] {
    let mut out: Vec[i64] = Vec.new();
    val_repr(mut c, re, v, mut out)?;
    Ok(to_string(out))
}
// ------------------------------------------------------------ reading
//
// ConfigObj._load and _parse: the file read as bytes and split the way
// readlines() splits, each line decoded, the newline style taken from
// the first line that has one, and the lines matched against the
// section marker and keyword patterns.

#[derive(Clone)]
struct LoadErr {
    err: PyErr,
    // the errors stored, when parsing went on past them
    errors: Vec[CfgErr],
    // whether the exception carries the half-built config (error.config)
    has_config: bool,
}

fn load_err(e: own PyErr) -> LoadErr {
    LoadErr { err: e, errors: Vec.new(), has_config: false }
}

// readlines(), decoded: None when the file does not exist
fn read_lines(path: ref String) -> Option[Vec[Vec[i64]]] {
    let text = match fs.read_to_string(path.clone()) {
        Ok(t) => t,
        Err(_) => return None,
    };
    let c = cps(text);
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    for ch in c {
        cur.push(ch);
        if ch == 10 {
            out.push(cur);
            cur = Vec.new();
        }
    }
    if cur.len() > 0 {
        out.push(cur);
    }
    Some(out)
}

fn rstrip_newlines(s: ref Vec[i64]) -> Vec[i64] {
    let mut b = s.len();
    while b > 0 and (s[b - 1] == 10 or s[b - 1] == 13) {
        b -= 1;
    }
    slice(s, 0, b)
}

fn ends_with(s: ref Vec[i64], t: Str) -> bool {
    let p = cp(t);
    if p.len() > s.len() {
        return false;
    }
    same(slice(s, s.len() - p.len(), s.len()), p)
}

// ConfigObj(path, ...) after the options are set
fn load_file(c: mut ref Config, re: ref Pats, path: ref String, file_error: bool) -> Result[(), LoadErr] {
    let content = match read_lines(path) {
        Some(lines) => lines,
        None => {
            if file_error {
                return Err(load_err(perr("OSError", cp(f"Config file not found: \"{path}\"."))));
            }
            Vec.new()
        }
    };
    for line in content.iter() {
        if line.len() == 0 or (line[line.len() - 1] != 13 and line[line.len() - 1] != 10) {
            continue;
        }
        if ends_with(line, "\r\n") {
            c.newlines = Some(cp("\r\n"));
        } else if ends_with(line, "\n") {
            c.newlines = Some(cp("\n"));
        } else {
            c.newlines = Some(cp("\r"));
        }
        break;
    }
    let lines: Vec[Vec[i64]] = content.iter().map(|l| rstrip_newlines(l)).collect();
    if let Err(e) = parse_lines(mut c, re, lines) {
        return Err(load_err(e));
    }
    if c.errors.len() > 0 {
        let first = c.errors[0].line_number;
        let err = if c.errors.len() > 1 {
            perr("ConfigObjError", cp(f"Parsing failed with several errors.\nFirst error at line {first}."))
        } else {
            PyErr { kind: c.errors[0].kind.clone(), msg: c.errors[0].msg.clone() }
        };
        return Err(LoadErr { err: err, errors: c.errors.clone(), has_config: true });
    }
    Ok(())
}

// _handle_error: raised at once with raise_errors, stored otherwise
fn handle_error(c: mut ref Config, text: ref Vec[i64], kind: Str, lines: ref Vec[Vec[i64]], cur_index: i64) -> Result[(), PyErr] {
    let n = cur_index + 1;
    let msg = cat(text, cp(f" at line {n}."));
    if c.raise_errors {
        return Err(perr(kind, msg));
    }
    c.errors.push(CfgErr { kind: kind.to_string(), msg: msg, line_number: n, line: lines[cur_index].clone() });
    Ok(())
}

// _unquote: None where it raises SyntaxError
fn unquote(value: ref Vec[i64]) -> Option[Vec[i64]] {
    if value.len() == 0 {
        return None;
    }
    let a = value[0];
    if a == value[value.len() - 1] and (a == 34 or a == 39) {
        return Some(slice(value, 1, value.len() - 1));
    }
    Some(value.clone())
}

// _match_depth: None where it raises SyntaxError
fn match_depth(c: ref Config, sect: i64, depth: i64) -> Option[i64] {
    let mut s = sect;
    while depth < c.secs[s].depth {
        if s == c.secs[s].parent {
            return None;
        }
        s = c.secs[s].parent;
    }
    if c.secs[s].depth == depth { Some(s) } else { None }
}

// a value, its comment, and the index of its last line
#[derive(Clone)]
struct Multi {
    value: Vec[i64],
    comment: Option[Vec[i64]],
    index: i64,
}

// _multiline: None where it raises SyntaxError
fn multiline(re: ref Pats, value: ref Vec[i64], lines: ref Vec[Vec[i64]], start: i64, maxline: i64) -> Option[Multi] {
    let quot = slice(value, 0, 3);
    let mut newvalue = slice(value, 3, value.len());
    let double = quot[0] == 34;
    let single_line = if double { re.single_line_double.clone() } else { re.single_line_single.clone() };
    let multi_line = if double { re.multi_line_double.clone() } else { re.multi_line_single.clone() };
    if let Some(m) = re_match(single_line, value) {
        return Some(Multi { value: grp(value, m, 1).unwrap_or(Vec.new()), comment: grp(value, m, 2), index: start });
    }
    if find_sub(newvalue, quot, 0) >= 0 {
        return None;
    }
    let mut cur_index = start;
    let mut line: Vec[i64] = Vec.new();
    let mut closed = false;
    while cur_index < maxline {
        cur_index += 1;
        newvalue.push(10);
        line = lines[cur_index].clone();
        if find_sub(line, quot, 0) < 0 {
            push_all(mut newvalue, line);
        } else {
            closed = true;
            break;
        }
    }
    if not closed {
        return None;
    }
    let m = re_match(multi_line, line)?;
    let v = grp(line, m, 1).unwrap_or(Vec.new());
    Some(Multi { value: cat(newvalue, v), comment: grp(line, m, 2), index: cur_index })
}

// a parsed value: a string or a list of them, and its comment
#[derive(Clone)]
struct Handled {
    value: Val,
    comment: Option[Vec[i64]],
}

// _handle_value: None where it raises SyntaxError
fn handle_value(c: ref Config, re: ref Pats, value: ref Vec[i64]) -> Option[Handled] {
    if c.inspec {
        return Some(Handled { value: Val.Str(value.clone()), comment: Some(Vec.new()) });
    }
    if not c.list_values {
        let m = re_match(re.nolistvalue, value)?;
        return Some(Handled { value: Val.Str(grp(value, m, 1).unwrap_or(Vec.new())), comment: grp(value, m, 2) });
    }
    let m = re_match(re.valueexp, value)?;
    let list_values = grp(value, m, 1);
    let mut single = grp(value, m, 2);
    let empty_list = grp(value, m, 3);
    let comment = grp(value, m, 4);
    let lv_empty = match list_values {
        Some(ref lv) => lv.len() == 0,
        None => false,
    };
    if lv_empty and single.is_none() {
        return None;
    }
    if empty_list.is_some() {
        return Some(Handled { value: Val.List(Vec.new()), comment: comment });
    }
    if let Some(s) = single.clone() {
        let lv_truthy = match list_values {
            Some(ref lv) => lv.len() > 0,
            None => false,
        };
        if lv_truthy and s.len() == 0 {
            single = None;
        } else {
            let t = if s.len() == 0 { cp("\"\"") } else { s };
            single = Some(unquote(t)?);
        }
    }
    if lv_empty {
        return Some(Handled { value: Val.Str(single.unwrap_or(Vec.new())), comment: comment });
    }
    let mut items: Vec[Val] = Vec.new();
    for v in findall1(re.listvalueexp, list_values.unwrap_or(Vec.new())) {
        items.push(Val.Str(unquote(v)?));
    }
    if let Some(s) = single {
        items.push(Val.Str(s));
    }
    Some(Handled { value: Val.List(items), comment: comment })
}

// ConfigObj._parse; Err only for an error raised at once (raise_errors)
fn parse_lines(c: mut ref Config, re: ref Pats, lines: ref Vec[Vec[i64]]) -> Result[(), PyErr] {
    let temp_list_values = c.list_values;
    let mut comment_list: Vec[Vec[i64]] = Vec.new();
    let mut done_start = false;
    let mut this_section = 0;
    let maxline = lines.len() - 1;
    let mut cur_index = -1;
    let mut reset_comment = false;
    while cur_index < maxline {
        if reset_comment {
            comment_list = Vec.new();
        }
        cur_index += 1;
        let line = lines[cur_index].clone();
        let sline = py_strip(line);
        if sline.len() == 0 or sline[0] == 35 {
            reset_comment = false;
            comment_list.push(line);
            continue;
        }
        if not done_start {
            c.initial_comment = comment_list.clone();
            comment_list = Vec.new();
            done_start = true;
        }
        reset_comment = true;
        if let Some(m) = re_match(re.sectionmarker, line) {
            let indent = grp(line, m, 1).unwrap_or(Vec.new());
            let sect_open = grp(line, m, 2).unwrap_or(Vec.new());
            let sect_name = grp(line, m, 3).unwrap_or(Vec.new());
            let sect_close = grp(line, m, 4).unwrap_or(Vec.new());
            let comment = grp(line, m, 5);
            if indent.len() > 0 and c.indent_type.is_none() {
                c.indent_type = Some(indent);
            }
            let cur_depth = count_of(sect_open, 91);
            if cur_depth != count_of(sect_close, 93) {
                handle_error(mut c, cp("Cannot compute the section depth"), "NestingError", lines, cur_index)?;
                continue;
            }
            let this_depth = c.secs[this_section].depth;
            let mut parent = 0;
            if cur_depth < this_depth {
                match match_depth(c, this_section, cur_depth) {
                    Some(s) => parent = c.secs[s].parent,
                    None => {
                        handle_error(mut c, cp("Cannot compute nesting level"), "NestingError", lines, cur_index)?;
                        continue;
                    }
                }
            } else if cur_depth == this_depth {
                parent = c.secs[this_section].parent;
            } else if cur_depth == this_depth + 1 {
                parent = this_section;
            } else {
                handle_error(mut c, cp("Section too nested"), "NestingError", lines, cur_index)?;
                continue;
            }
            let name = unquote(sect_name).unwrap_or(Vec.new());
            if in_dict(c, parent, name) {
                handle_error(mut c, cp("Duplicate section name"), "DuplicateError", lines, cur_index)?;
                continue;
            }
            c.secs.push(new_sec(parent, cur_depth, Some(name.clone())));
            this_section = c.secs.len() - 1;
            if let Err(e) = set_value(mut c, parent, name, Val.Sec(this_section)) {
                return Err(e);
            }
            set_inline(mut c, parent, name, comment);
            set_comment_lines(mut c, parent, name, comment_list.clone());
            continue;
        }
        let m = match re_match(re.keyword, line) {
            Some(m) => m,
            None => {
                let text = cat3(cp("Invalid line ("), cp(repr_of(line)), cp(") (matched as neither section nor keyword)"));
                handle_error(mut c, text, "ParseError", lines, cur_index)?;
                continue;
            }
        };
        let indent = grp(line, m, 1).unwrap_or(Vec.new());
        let key = grp(line, m, 2).unwrap_or(Vec.new());
        let value = grp(line, m, 3).unwrap_or(Vec.new());
        if indent.len() > 0 and c.indent_type.is_none() {
            c.indent_type = Some(indent);
        }
        let mut stored = Val.Nil;
        let mut comment: Option[Vec[i64]] = None;
        let head = slice(value, 0, 3);
        if eq_s(head, "\"\"\"") or eq_s(head, "'''") {
            match multiline(re, value, lines, cur_index, maxline) {
                Some(mv) => {
                    stored = Val.Str(mv.value);
                    comment = mv.comment;
                    cur_index = mv.index;
                }
                None => {
                    handle_error(mut c, cp("Parse error in multiline value"), "ParseError", lines, cur_index)?;
                    continue;
                }
            }
        } else {
            match handle_value(c, re, value) {
                Some(h) => {
                    stored = h.value;
                    comment = h.comment;
                }
                None => {
                    handle_error(mut c, cp("Parse error in value"), "ParseError", lines, cur_index)?;
                    continue;
                }
            }
        }
        let k = unquote(key).unwrap_or(Vec.new());
        if in_dict(c, this_section, k) {
            handle_error(mut c, cp("Duplicate keyword name"), "DuplicateError", lines, cur_index)?;
            continue;
        }
        set_value(mut c, this_section, k, stored)?;
        set_inline(mut c, this_section, k, comment);
        set_comment_lines(mut c, this_section, k, comment_list.clone());
    }
    if c.indent_type.is_none() {
        c.indent_type = Some(Vec.new());
    }
    if c.secs[0].keys.len() == 0 and c.initial_comment.len() == 0 {
        c.initial_comment = comment_list;
    } else if not reset_comment {
        c.final_comment = comment_list;
    }
    c.list_values = temp_list_values;
    Ok(())
}

// ------------------------------------------------------------ writing

const DEFAULT_INDENT_TYPE: Str = "    ";

fn cannot_quote(value: ref Vec[i64]) -> PyErr {
    perr("ConfigObjError", cat3(cp("Value \""), value, cp("\" cannot be safely quoted.")))
}

fn wrap(value: ref Vec[i64], quot: Str) -> Vec[i64] {
    let q = cp(quot);
    cat3(q, value, q)
}

// _get_single_quote, as the quote characters to wrap in
fn single_quote(value: ref Vec[i64]) -> Result[Str, PyErr] {
    if has(value, 39) and has(value, 34) {
        return Err(cannot_quote(value));
    }
    if has(value, 34) { Ok("'") } else { Ok("\"") }
}

fn triple_quote(value: ref Vec[i64]) -> Result[Str, PyErr] {
    let td = find_sub(value, cp("\"\"\""), 0) >= 0;
    let ts = find_sub(value, cp("'''"), 0) >= 0;
    if td and ts {
        return Err(cannot_quote(value));
    }
    if not td { Ok("'''") } else { Ok("\"\"\"") }
}

fn in_wspace_plus(ch: i64) -> bool {
    ch == 32 or ch == 13 or ch == 10 or ch == 11 or ch == 9 or ch == 39 or ch == 34
}

// _quote
fn quote_value(c: ref Config, value: ref Val, multiline: bool) -> Result[Vec[i64], PyErr] {
    if multiline and c.write_empty_values {
        if let Val.Str(s) = value {
            if s.len() == 0 {
                return Ok(Vec.new());
            }
        }
    }
    if multiline {
        let items = match value {
            Val.List(v) => Some(v.clone()),
            Val.Tuple(v) => Some(v.clone()),
            _ => None,
        };
        if let Some(v) = items {
            if v.len() == 0 {
                return Ok(cp(","));
            }
            if v.len() == 1 {
                return Ok(cat(quote_value(c, v[0], false)?, cp(",")));
            }
            let mut out: Vec[i64] = Vec.new();
            let mut first = true;
            for e in v.iter() {
                if not first {
                    push_ascii(mut out, ", ");
                }
                first = false;
                push_all(mut out, quote_value(c, e, false)?);
            }
            return Ok(out);
        }
    }
    let text = match value {
        Val.Str(s) => s.clone(),
        _ => {
            if c.stringify {
                py_str(value)
            } else {
                return Err(perr("TypeError", cat3(cp("Value \""), py_str(value), cp("\" is not a string."))));
            }
        }
    };
    if text.len() == 0 {
        return Ok(cp("\"\""));
    }
    let nl = has(text, 10);
    let hash = has(text, 35);
    let sq = has(text, 39);
    let dq = has(text, 34);
    let no_lists_no_quotes = not c.list_values and not nl and not hash;
    let need_triple = multiline and ((sq and dq) or nl);
    let hash_triple_quote = multiline and not need_triple and sq and dq and hash;
    let check_for_single = (no_lists_no_quotes or not need_triple) and not hash_triple_quote;
    let mut quot = "";
    if check_for_single {
        if not c.list_values {
            quot = "";
        } else if nl {
            return Err(cannot_quote(text));
        } else if not in_wspace_plus(text[0]) and not in_wspace_plus(text[text.len() - 1]) and not has(text, 44) {
            quot = "";
        } else {
            quot = single_quote(text)?.to_string();
        }
    } else {
        quot = triple_quote(text)?.to_string();
    }
    if quot == "" and hash and c.list_values {
        quot = single_quote(text)?.to_string();
    }
    Ok(wrap(text, quot))
}

fn indent_of(c: ref Config) -> Vec[i64] {
    c.indent_type.clone().unwrap_or(Vec.new())
}

// _handle_comment
fn handle_comment(c: ref Config, comment: ref Option[Vec[i64]]) -> Vec[i64] {
    let text = match comment {
        Some(t) => t.clone(),
        None => return Vec.new(),
    };
    if text.len() == 0 {
        return Vec.new();
    }
    let mut start = indent_of(c);
    if text[0] != 35 {
        push_ascii(mut start, " # ");
    }
    cat(start, text)
}

fn repeat_text(t: ref Vec[i64], n: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < n {
        push_all(mut out, t);
        k += 1;
    }
    out
}

fn comment_out(line: ref Vec[i64]) -> Vec[i64] {
    let stripped = py_strip(line);
    if stripped.len() > 0 and stripped[0] != 35 {
        return cat(cp("# "), line);
    }
    line.clone()
}

// write(section=...): the lines; `top` is write() with no section, which
// switches interpolation off and adds the initial and final comments.
// An error on the way leaves interpolation switched off, as in configobj.
fn write_lines(c: mut ref Config, re: ref Pats, si: i64, top: bool) -> Result[Vec[Vec[i64]], PyErr] {
    if c.indent_type.is_none() {
        c.indent_type = Some(cp(DEFAULT_INDENT_TYPE));
    }
    let mut out: Vec[Vec[i64]] = Vec.new();
    let int_val = c.interpolation.clone();
    if top {
        c.interpolation = Interp.Off;
        for line in c.initial_comment.iter() {
            out.push(comment_out(line));
        }
    }
    let indent_string = repeat_text(indent_of(c), c.secs[si].depth);
    for entry in order(c, si) {
        if contains_key(c.secs[si].defaults, entry) {
            continue;
        }
        let ci = comment_index(c, si, entry);
        if ci < 0 {
            return Err(key_error(entry));
        }
        for comment_line in c.secs[si].comments[ci].clone() {
            let l = py_lstrip(comment_line);
            let shown = if l.len() > 0 and l[0] != 35 { cat(cp("# "), l) } else { l };
            out.push(cat(indent_string, shown));
        }
        let this_entry = getitem(mut c, re, si, entry)?;
        let comment = handle_comment(c, c.secs[si].inline[ci].clone());
        match this_entry {
            Val.Sec(child) => {
                let depth = c.secs[child].depth;
                let mut line = indent_string.clone();
                push_all(mut line, repeat_text(cp("["), depth));
                push_all(mut line, quote_value(c, Val.Str(entry.clone()), false)?);
                push_all(mut line, repeat_text(cp("]"), depth));
                push_all(mut line, comment);
                out.push(line);
                for l in write_lines(mut c, re, child, false)? {
                    out.push(l.clone());
                }
            }
            _ => {
                let val = quote_value(c, this_entry, true)?;
                let mut line = indent_string.clone();
                push_all(mut line, quote_value(c, Val.Str(entry.clone()), false)?);
                push_ascii(mut line, " = ");
                push_all(mut line, val);
                push_all(mut line, comment);
                out.push(line);
            }
        }
    }
    if top {
        for line in c.final_comment.iter() {
            out.push(comment_out(line));
        }
        c.interpolation = int_val;
    }
    Ok(out)
}

fn hex_esc(ch: i64) -> String {
    if ch <= 0xFF {
        f"\\x{hex_n(ch, 2)}"
    } else if ch <= 0xFFFF {
        f"\\u{hex_n(ch, 4)}"
    } else {
        f"\\U{hex_n(ch, 8)}"
    }
}

// write(outfile): the lines joined with the file's newline and encoded
fn write_text(c: mut ref Config, re: ref Pats) -> Result[Vec[i64], PyErr] {
    let lines = write_lines(mut c, re, 0, true)?;
    let newline = c.newlines.clone().unwrap_or(cp("\n"));
    let mut output: Vec[i64] = Vec.new();
    let mut first = true;
    for l in lines.iter() {
        if not first {
            push_all(mut output, newline);
        }
        first = false;
        push_all(mut output, l);
    }
    if output.len() < newline.len() or not same(slice(output, output.len() - newline.len(), output.len()), newline) {
        push_all(mut output, newline);
    }
    if c.encoding.is_none() {
        let mut i = 0;
        while i < output.len() {
            if output[i] >= 128 {
                let mut j = i + 1;
                while j < output.len() and output[j] >= 128 {
                    j += 1;
                }
                let what = if j == i + 1 { f"character '{hex_esc(output[i])}' in position {i}" } else { f"characters in position {i}-{j - 1}" };
                return Err(perr("UnicodeEncodeError", cp(f"'ascii' codec can't encode {what}: ordinal not in range(128)")));
            }
            i += 1;
        }
    }
    Ok(output)
}
// ------------------------------------------------------------ validate.py
//
// Validator: a check string such as `integer(min=1, default=4)` is taken
// apart with validate's own regexes, its arguments bound the way Python
// binds them to the check function, and the value converted or refused.

#[derive(Clone)]
enum CArg {
    S(Vec[i64]),
    L(Vec[Vec[i64]]),
}

#[derive(Clone)]
struct Check {
    name: Vec[i64],
    args: Vec[Vec[i64]],
    kn: Vec[Vec[i64]],
    kv: Vec[CArg],
    default: Option[CArg],
}

fn unquote_v(val: ref Vec[i64]) -> Vec[i64] {
    if val.len() >= 2 and (val[0] == 39 or val[0] == 34) and val[0] == val[val.len() - 1] {
        return slice(val, 1, val.len() - 1);
    }
    val.clone()
}

fn kw_set(kn: mut ref Vec[Vec[i64]], kv: mut ref Vec[CArg], key: ref Vec[i64], v: own CArg) {
    let i = index_key(kn, key);
    if i < 0 {
        kn.push(key.clone());
        kv.push(v.clone());
    } else {
        kv[i] = v;
    }
}

fn is_quoted_none(v: ref Vec[i64]) -> bool {
    eq_s(v, "'None'") or eq_s(v, "\"None\"")
}

// Validator._parse_check
fn parse_check(re: ref Pats, check: ref Vec[i64]) -> Check {
    let f = match re_match(re.func_re, check) {
        Some(f) => f,
        None => return Check { name: check.clone(), args: Vec.new(), kn: Vec.new(), kv: Vec.new(), default: None },
    };
    let name = grp(check, f, 1).unwrap_or(Vec.new());
    let arg_string = grp(check, f, 2).unwrap_or(Vec.new());
    let mut args: Vec[Vec[i64]] = Vec.new();
    let mut kn: Vec[Vec[i64]] = Vec.new();
    let mut kv: Vec[CArg] = Vec.new();
    for raw in findall1(re.paramfinder, arg_string) {
        let arg = py_strip(raw);
        if let Some(lm) = re_match(re.list_arg, arg) {
            let key = grp(arg, lm, 1).unwrap_or(Vec.new());
            let body = grp(arg, lm, 2).unwrap_or(Vec.new());
            let mut members: Vec[Vec[i64]] = Vec.new();
            for m in findall1(re.list_members, body) {
                members.push(unquote_v(m));
            }
            kw_set(mut kn, mut kv, key, CArg.L(members));
            continue;
        }
        if let Some(km) = re_match(re.key_arg, arg) {
            let mut val = grp(arg, km, 2).unwrap_or(Vec.new());
            if not is_quoted_none(val) {
                val = unquote_v(val);
            }
            kw_set(mut kn, mut kv, grp(arg, km, 1).unwrap_or(Vec.new()), CArg.S(val));
            continue;
        }
        args.push(unquote_v(arg));
    }
    let mut default: Option[CArg] = None;
    let di = index_key(kn, cp("default"));
    if di >= 0 {
        default = Some(kv[di].clone());
        kn.remove(di);
        kv.remove(di);
    }
    Check { name: name, args: args, kn: kn, kv: kv, default: default }
}

fn arg_val(a: ref CArg) -> Val {
    match a {
        CArg.S(s) => Val.Str(s.clone()),
        CArg.L(items) => {
            let mut out: Vec[Val] = Vec.new();
            for x in items.iter() {
                out.push(Val.Str(x.clone()));
            }
            Val.List(out)
        }
    }
}

// Validator._handle_none: Val.Nil stands for None
fn handle_none(a: ref CArg) -> Val {
    match a {
        CArg.S(s) => {
            if eq_s(s, "None") {
                Val.Nil
            } else if is_quoted_none(s) {
                Val.Str(unquote_v(s))
            } else {
                Val.Str(s.clone())
            }
        }
        _ => arg_val(a),
    }
}

// ---- the exceptions

fn vdt(kind: Str, v: ref Val, tail: Str) -> PyErr {
    perr(kind, cat3(cp("the value \""), py_str(v), cp(tail)))
}

fn vtype(v: ref Val) -> PyErr {
    vdt("VdtTypeError", v, "\" is of the wrong type.")
}

fn vvalue(v: ref Val) -> PyErr {
    vdt("VdtValueError", v, "\" is unacceptable.")
}

fn too_small(v: ref Val) -> PyErr {
    vdt("VdtValueTooSmallError", v, "\" is too small.")
}

fn too_big(v: ref Val) -> PyErr {
    vdt("VdtValueTooBigError", v, "\" is too big.")
}

fn too_short(v: ref Val) -> PyErr {
    vdt("VdtValueTooShortError", v, "\" is too short.")
}

fn too_long(v: ref Val) -> PyErr {
    vdt("VdtValueTooLongError", v, "\" is too long.")
}

fn param_error(name: ref Vec[i64], value: ref Vec[i64]) -> PyErr {
    perr("VdtParamError", cat(cat3(cp("passed an incorrect value \""), value, cp("\" for parameter \"")), cat(name, cp("\"."))))
}

// the ValidateError family, which validate() catches
fn is_vdt(kind: ref String) -> bool {
    kind == "ValidateError" or kind == "VdtMissingValue" or kind == "VdtUnknownCheckError" or kind == "VdtTypeError" or kind == "VdtValueError" or kind == "VdtValueTooSmallError" or kind == "VdtValueTooBigError" or kind == "VdtValueTooShortError" or kind == "VdtValueTooLongError"
}

// ---- argument binding

// 0: f(value); 1: f(value, min=None, max=None); 2: f(value, *args);
// 3: Validator._pass(self, value); -1: no such check
fn kind_of(name: ref Vec[i64]) -> i64 {
    if name.len() == 0 or eq_s(name, "pass") {
        return 3;
    }
    if eq_s(name, "boolean") or eq_s(name, "ip_addr") {
        return 0;
    }
    if eq_s(name, "mixed_list") or eq_s(name, "option") {
        return 2;
    }
    let ranged = ["integer", "float", "string", "list", "tuple", "int_list", "float_list", "bool_list", "string_list", "ip_addr_list", "force_list"];
    for r in ranged {
        if eq_s(name, r) {
            return 1;
        }
    }
    -1
}

fn fun_label(name: ref Vec[i64]) -> String {
    if name.len() == 0 or eq_s(name, "pass") {
        return "Validator._pass".to_string();
    }
    if eq_s(name, "force_list") {
        return "force_list".to_string();
    }
    f"is_{to_string(name)}"
}

fn type_error(text: String) -> PyErr {
    perr("TypeError", cp(text))
}

// the min and max a ranged check was given, None where it was not
fn bind(ck: ref Check, kind: i64) -> Result[Vec[Option[Val]], PyErr] {
    let label = fun_label(ck.name);
    let n = ck.args.len();
    let mut slots: Vec[Option[Val]] = Vec.new();
    slots.push(None);
    slots.push(None);
    if kind == 1 {
        let mut i = 0;
        while i < n and i < 2 {
            slots[i] = Some(Val.Str(ck.args[i].clone()));
            i += 1;
        }
    }
    let mut k = 0;
    while k < ck.kn.len() {
        let key = ck.kn[k].clone();
        let name = to_string(key);
        let mut j = -1;
        if kind == 1 and eq_s(key, "min") {
            j = 0;
        } else if kind == 1 and eq_s(key, "max") {
            j = 1;
        }
        if eq_s(key, "value") or (kind == 3 and eq_s(key, "self")) or (j >= 0 and j < n) {
            return Err(type_error(f"{label}() got multiple values for argument '{name}'"));
        }
        if j < 0 {
            return Err(type_error(f"{label}() got an unexpected keyword argument '{name}'"));
        }
        slots[j] = Some(arg_val(ck.kv[k]));
        k += 1;
    }
    if kind == 0 and n > 0 {
        return Err(type_error(f"{label}() takes 1 positional argument but {n + 1} were given"));
    }
    if kind == 1 and n > 2 {
        return Err(type_error(f"{label}() takes from 1 to 3 positional arguments but {n + 1} were given"));
    }
    if kind == 3 and n > 0 {
        return Err(type_error(f"{label}() takes 2 positional arguments but {n + 2} were given"));
    }
    Ok(slots)
}

// _is_num_param for one parameter
fn int_param(name: Str, v: ref Option[Val]) -> Result[Option[i128], PyErr] {
    match v {
        None => Ok(None),
        Some(Val.Str(s)) => match parse_int(s) {
            Some(x) => Ok(Some(x)),
            None => Err(param_error(cp(name), s)),
        },
        Some(other) => Err(param_error(cp(name), py_str(other))),
    }
}

fn float_param(name: Str, v: ref Option[Val]) -> Result[Option[f64], PyErr] {
    match v {
        None => Ok(None),
        Some(Val.Str(s)) => match parse_float(s) {
            Some(x) => Ok(Some(x)),
            None => Err(param_error(cp(name), s)),
        },
        Some(other) => Err(param_error(cp(name), py_str(other))),
    }
}

// ---- the checks

fn is_integer(v: ref Val, mn: Option[i128], mx: Option[i128]) -> Result[Val, PyErr] {
    let n = match v {
        Val.Int(x) => x,
        Val.Bool(b) => if b { 1 } else { 0 },
        Val.Str(s) => match parse_int(s) {
            Some(x) => x,
            None => return Err(vtype(v)),
        },
        _ => return Err(vtype(v)),
    };
    let out = match v {
        Val.Bool(_) => v.clone(),
        _ => Val.Int(n),
    };
    if let Some(lo) = mn {
        if n < lo {
            return Err(too_small(out));
        }
    }
    if let Some(hi) = mx {
        if n > hi {
            return Err(too_big(out));
        }
    }
    Ok(out)
}

fn is_float(v: ref Val, mn: Option[f64], mx: Option[f64]) -> Result[Val, PyErr] {
    let x = match v {
        Val.Float(x) => x,
        Val.Int(n) => n as f64,
        Val.Bool(b) => if b { 1.0 } else { 0.0 },
        Val.Str(s) => match parse_float(s) {
            Some(x) => x,
            None => return Err(vtype(v)),
        },
        _ => return Err(vtype(v)),
    };
    let out = Val.Float(x);
    if let Some(lo) = mn {
        if x < lo {
            return Err(too_small(out));
        }
    }
    if let Some(hi) = mx {
        if x > hi {
            return Err(too_big(out));
        }
    }
    Ok(out)
}

fn is_boolean(v: ref Val) -> Result[Val, PyErr] {
    if let Val.Str(s) = v {
        let l = py_lower(s);
        for t in ["on", "1", "true", "yes"] {
            if eq_s(l, t) {
                return Ok(Val.Bool(true));
            }
        }
        for t in ["off", "0", "false", "no"] {
            if eq_s(l, t) {
                return Ok(Val.Bool(false));
            }
        }
        return Err(vtype(v));
    }
    match num_of(v) {
        Some(x) => {
            if x == 0.0 {
                Ok(Val.Bool(false))
            } else if x == 1.0 {
                Ok(Val.Bool(true))
            } else {
                Err(vtype(v))
            }
        }
        None => Err(vtype(v)),
    }
}

// glibc's inet_aton: up to four parts, each strtoul(base 0), the last
// one filling the remaining bytes; whitespace may end the address
fn c_space(c: i64) -> bool {
    c == 32 or (c >= 9 and c <= 13)
}

fn c_digit(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn hex_digit_value(c: i64) -> i64 {
    if c_digit(c) {
        c - 48
    } else if c >= 97 and c <= 102 {
        c - 87
    } else if c >= 65 and c <= 70 {
        c - 55
    } else {
        -1
    }
}

fn inet_aton(s: ref Vec[i64]) -> bool {
    let maxes = [0xffffffff, 0xffffff, 0xffff, 0xff];
    let mut parts = 0;
    let mut i = 0;
    let mut val: i128 = 0;
    let n = s.len();
    loop {
        if i >= n or not c_digit(s[i]) {
            return false;
        }
        let mut base = 10;
        if s[i] == 48 {
            base = 8;
            if i + 2 < n and (s[i + 1] == 120 or s[i + 1] == 88) and hex_digit_value(s[i + 2]) >= 0 {
                base = 16;
                i += 2;
            }
        }
        val = 0;
        while i < n {
            let d = hex_digit_value(s[i]);
            if d < 0 or d >= base {
                break;
            }
            if val <= 0xffffffffff {
                val = val * (base as i128) + (d as i128);
            }
            i += 1;
        }
        if val > 0xffffffff {
            return false;
        }
        if i < n and s[i] == 46 {
            if parts > 2 or val > 0xff {
                return false;
            }
            parts += 1;
            i += 1;
        } else {
            break;
        }
    }
    if i < n and not c_space(s[i]) {
        return false;
    }
    val <= (maxes[parts] as i128)
}

fn is_ip_addr(v: ref Val) -> Result[Val, PyErr] {
    let s = match v {
        Val.Str(s) => py_strip(s),
        _ => return Err(vtype(v)),
    };
    let out = Val.Str(s.clone());
    if not inet_aton(py_strip(s)) {
        return Err(vvalue(out));
    }
    Ok(out)
}

fn members_of(v: ref Val) -> Option[Vec[Val]] {
    match v {
        Val.List(items) => Some(items.clone()),
        Val.Tuple(items) => Some(items.clone()),
        _ => None,
    }
}

fn is_list(v: ref Val, mn: ref Option[Val], mx: ref Option[Val]) -> Result[Vec[Val], PyErr] {
    let lo = int_param("min", mn)?;
    let hi = int_param("max", mx)?;
    let items = match members_of(v) {
        Some(items) => items,
        None => return Err(vtype(v)),
    };
    let len = items.len() as i128;
    if let Some(l) = lo {
        if len < l {
            return Err(too_short(v));
        }
    }
    if let Some(h) = hi {
        if len > h {
            return Err(too_long(v));
        }
    }
    Ok(items)
}

fn is_string(v: ref Val, mn: ref Option[Val], mx: ref Option[Val]) -> Result[Val, PyErr] {
    let s = match v {
        Val.Str(s) => s.clone(),
        _ => return Err(vtype(v)),
    };
    let lo = int_param("min", mn)?;
    let hi = int_param("max", mx)?;
    let len = s.len() as i128;
    if let Some(l) = lo {
        if len < l {
            return Err(too_short(v));
        }
    }
    if let Some(h) = hi {
        if len > h {
            return Err(too_long(v));
        }
    }
    Ok(v.clone())
}

// is_mixed_list's fun_dict
fn mixed_one(kind: ref Vec[i64], v: ref Val) -> Result[Val, PyErr] {
    let none: Option[Val] = None;
    if eq_s(kind, "integer") {
        is_integer(v, None, None)
    } else if eq_s(kind, "float") {
        is_float(v, None, None)
    } else if eq_s(kind, "ip_addr") {
        is_ip_addr(v)
    } else if eq_s(kind, "string") {
        is_string(v, none, none)
    } else if eq_s(kind, "boolean") {
        is_boolean(v)
    } else {
        Err(param_error(cp("mixed_list"), cp(repr_of(kind))))
    }
}

fn is_mixed_list(v: ref Val, kinds: ref Vec[Vec[i64]]) -> Result[Val, PyErr] {
    let items = match v {
        Val.Str(s) => {
            let mut out: Vec[Val] = Vec.new();
            for ch in s {
                out.push(Val.Str(vec_of(ch)));
            }
            out
        }
        Val.List(items) => items.clone(),
        Val.Tuple(items) => items.clone(),
        _ => return Err(vtype(v)),
    };
    if items.len() < kinds.len() {
        return Err(too_short(v));
    }
    if items.len() > kinds.len() {
        return Err(too_long(v));
    }
    let mut out: Vec[Val] = Vec.new();
    let mut i = 0;
    while i < items.len() {
        out.push(mixed_one(kinds[i], items[i])?);
        i += 1;
    }
    Ok(Val.List(out))
}

fn is_option(v: ref Val, options: ref Vec[Vec[i64]]) -> Result[Val, PyErr] {
    let s = match v {
        Val.Str(s) => s.clone(),
        _ => return Err(vtype(v)),
    };
    if not contains_key(options, s) {
        return Err(vvalue(v));
    }
    Ok(v.clone())
}

fn each(items: ref Vec[Val], kind: Str) -> Result[Val, PyErr] {
    let mut out: Vec[Val] = Vec.new();
    for m in items.iter() {
        out.push(mixed_one(cp(kind), m)?);
    }
    Ok(Val.List(out))
}

// Validator._check_value
fn check_value(v: ref Val, ck: ref Check) -> Result[Val, PyErr] {
    let kind = kind_of(ck.name);
    if kind < 0 {
        return Err(perr("VdtUnknownCheckError", cat3(cp("the check \""), ck.name, cp("\" is unknown."))));
    }
    let slots = bind(ck, kind)?;
    if kind == 3 {
        return Ok(v.clone());
    }
    let name = ck.name.clone();
    if kind == 0 {
        if eq_s(name, "boolean") {
            return is_boolean(v);
        }
        return is_ip_addr(v);
    }
    if kind == 2 {
        if eq_s(name, "option") {
            return is_option(v, ck.args);
        }
        return is_mixed_list(v, ck.args);
    }
    let mn = slots[0].clone();
    let mx = slots[1].clone();
    if eq_s(name, "integer") {
        let lo = int_param("min", mn)?;
        let hi = int_param("max", mx)?;
        return is_integer(v, lo, hi);
    }
    if eq_s(name, "float") {
        let lo = float_param("min", mn)?;
        let hi = float_param("max", mx)?;
        return is_float(v, lo, hi);
    }
    if eq_s(name, "string") {
        return is_string(v, mn, mx);
    }
    if eq_s(name, "string_list") {
        if is_str(v) {
            return Err(vtype(v));
        }
        return each(is_list(v, mn, mx)?, "string");
    }
    if eq_s(name, "force_list") {
        let lv = match members_of(v) {
            Some(_) => v.clone(),
            None => Val.List(vec![v.clone()]),
        };
        return Ok(Val.List(is_list(lv, mn, mx)?));
    }
    let items = match v {
        Val.Str(_) => return Err(vtype(v)),
        _ => is_list(v, mn, mx)?,
    };
    if eq_s(name, "list") {
        Ok(Val.List(items))
    } else if eq_s(name, "tuple") {
        Ok(Val.Tuple(items))
    } else if eq_s(name, "int_list") {
        each(items, "integer")
    } else if eq_s(name, "float_list") {
        each(items, "float")
    } else if eq_s(name, "bool_list") {
        each(items, "boolean")
    } else {
        each(items, "ip_addr")
    }
}

// Validator.check: `missing` takes the default instead of the value
fn vcheck(re: ref Pats, check: ref Vec[i64], value: ref Val, missing: bool) -> Result[Val, PyErr] {
    let ck = parse_check(re, check);
    let mut v = value.clone();
    if missing {
        match ck.default.clone() {
            None => return Err(perr_s("VdtMissingValue", "")),
            Some(d) => v = handle_none(d),
        }
    }
    if let Val.Nil = v {
        return Ok(Val.Nil);
    }
    check_value(v, ck)
}

fn get_default_value(re: ref Pats, check: ref Vec[i64]) -> Result[Val, PyErr] {
    let ck = parse_check(re, check);
    let d = match ck.default.clone() {
        Some(d) => d.clone(),
        None => return Err(key_error(cat3(cp("Check \""), check, cp("\" has no default value.")))),
    };
    let v = handle_none(d);
    if let Val.Nil = v {
        return Ok(Val.Nil);
    }
    check_value(v, ck)
}
// ------------------------------------------------------------ ConfigObj.validate
//
// The configspec is a second config; each section of the config being
// checked names its configspec section by index (-1 for None).

#[derive(Clone)]
enum Res {
    T,
    F,
    E(PyErr),
    D(Vec[(Vec[i64], Res)]),
}

#[derive(Clone)]
struct VState {
    keys: Vec[Vec[i64]],
    vals: Vec[Res],
    ret_true: bool,
    ret_false: bool,
}

#[derive(Clone)]
struct VOpts {
    preserve: bool,
    copy: bool,
}

fn out_set(st: mut ref VState, key: ref Vec[i64], r: own Res) {
    let i = index_key(st.keys, key);
    if i < 0 {
        st.keys.push(key.clone());
        st.vals.push(r.clone());
    } else {
        st.vals[i] = r;
    }
}

fn spec_comments(sp: ref Config, ci: i64, key: ref Vec[i64]) -> (Vec[Vec[i64]], Option[Vec[i64]]) {
    let i = comment_index(sp, ci, key);
    if i < 0 {
        (Vec.new(), Some(Vec.new()))
    } else {
        (sp.secs[ci].comments[i].clone(), sp.secs[ci].inline[i].clone())
    }
}

fn copy_comments(c: mut ref Config, sp: ref Config, si: i64, ci: i64, key: ref Vec[i64]) {
    let (lines, inline) = spec_comments(sp, ci, key);
    set_comments(mut c, si, key, lines, inline);
}

fn default_pop(c: mut ref Config, si: i64, key: ref Vec[i64]) {
    let i = index_key(c.secs[si].dkeys, key);
    if i >= 0 {
        c.secs[si].dkeys.remove(i);
        c.secs[si].dvals.remove(i);
    }
}

// ConfigObj._set_configspec
fn set_configspec(c: mut ref Config, sp: ref Config, si: i64, copy: bool) -> Result[(), PyErr] {
    let ci = c.secs[si].configspec;
    if let Some(Val.Sec(mi)) = raw_get(sp, ci, cp("__many__")) {
        for entry in c.secs[si].sections.clone() {
            if not in_dict(sp, ci, entry) {
                let sub = sec_of(raw_get(c, si, entry).unwrap());
                c.secs[sub].configspec = mi;
            }
        }
    }
    for entry in sp.secs[ci].sections.clone() {
        if eq_s(entry, "__many__") {
            continue;
        }
        if not in_dict(c, si, entry) {
            let none: Vec[(Vec[i64], J)] = Vec.new();
            set_dict(mut c, si, entry, none)?;
            let sub = sec_of(raw_get(c, si, entry).unwrap());
            c.secs[sub].created = true;
            if copy {
                copy_comments(mut c, sp, si, ci, entry);
            }
        }
        if let Some(Val.Sec(sub)) = raw_get(c, si, entry) {
            c.secs[sub].configspec = sec_of(raw_get(sp, ci, entry).unwrap());
        }
    }
    Ok(())
}

fn as_list_text(v: ref Val) -> Val {
    match v {
        Val.Str(_) => v.clone(),
        _ => Val.Str(py_str(v)),
    }
}

// validate_entry
fn validate_entry(c: mut ref Config, re: ref Pats, sp: ref Config, si: i64, entry: ref Vec[i64], spec: ref Vec[i64], val: ref Val, missing: bool, o: ref VOpts, st: mut ref VState) -> Result[(), PyErr] {
    let ci = c.secs[si].configspec;
    default_pop(mut c, si, entry);
    if let Some(sv) = raw_get(sp, ci, entry) {
        match get_default_value(re, str_of(sv)) {
            Ok(d) => {
                c.secs[si].dkeys.push(entry.clone());
                c.secs[si].dvals.push(d);
            }
            Err(e) => {
                if not (e.kind == "KeyError" or is_vdt(e.kind)) {
                    return Err(e);
                }
            }
        }
    }
    match vcheck(re, spec, val, missing) {
        Err(e) => {
            if not is_vdt(e.kind) {
                return Err(e);
            }
            if not o.preserve or e.kind == "VdtMissingValue" {
                out_set(mut st, entry, Res.F);
            } else {
                out_set(mut st, entry, Res.E(e));
                st.ret_false = false;
            }
            st.ret_true = false;
        }
        Ok(chk) => {
            st.ret_false = false;
            out_set(mut st, entry, Res.T);
            if c.stringify or missing {
                let mut check = chk.clone();
                if not c.stringify {
                    check = match chk {
                        Val.List(items) => Val.List(items.iter().map(|x| as_list_text(x)).collect()),
                        Val.Tuple(items) => Val.List(items.iter().map(|x| as_list_text(x)).collect()),
                        Val.Nil => if missing { Val.Str(Vec.new()) } else { Val.Str(cp("None")) },
                        _ => as_list_text(chk),
                    };
                }
                if missing or not py_eq(check, val) {
                    set_value(mut c, si, entry, check)?;
                }
            }
            if not o.copy and missing and not contains_key(c.secs[si].defaults, entry) {
                c.secs[si].defaults.push(entry.clone());
            }
        }
    }
    Ok(())
}

fn res_truthy(r: ref Res) -> bool {
    match r {
        Res.F => false,
        _ => true,
    }
}

fn validate_sec(c: mut ref Config, re: ref Pats, sp: ref Config, si: i64, o: ref VOpts) -> Result[Res, PyErr] {
    set_configspec(mut c, sp, si, o.copy)?;
    let ci = c.secs[si].configspec;
    let spec = sp.secs[ci].clone();
    let mut st = VState { keys: Vec.new(), vals: Vec.new(), ret_true: true, ret_false: true };
    let mut unvalidated: Vec[Vec[i64]] = Vec.new();
    for k in c.secs[si].scalars.iter() {
        if not in_dict(sp, ci, k) {
            unvalidated.push(k.clone());
        }
    }
    let mut incorrect_sections: Vec[Vec[i64]] = Vec.new();
    for k in spec.sections.iter() {
        if contains_key(c.secs[si].scalars, k) {
            incorrect_sections.push(k.clone());
        }
    }
    let mut incorrect_scalars: Vec[Vec[i64]] = Vec.new();
    for k in spec.scalars.iter() {
        if contains_key(c.secs[si].sections, k) {
            incorrect_scalars.push(k.clone());
        }
    }
    for entry in spec.scalars.iter() {
        if eq_s(entry, "__many__") or eq_s(entry, "___many___") {
            continue;
        }
        let present = contains_key(c.secs[si].scalars, entry);
        let mut missing = false;
        let mut val = Val.Nil;
        if not present or contains_key(c.secs[si].defaults, entry) {
            missing = true;
            if o.copy and not present {
                copy_comments(mut c, sp, si, ci, entry);
            }
        } else {
            val = getitem(mut c, re, si, entry)?;
        }
        let check = str_of(raw_get(sp, ci, entry).unwrap());
        validate_entry(mut c, re, sp, si, entry, check, val, missing, o, mut st)?;
    }
    let mut many: Option[Vec[i64]] = None;
    if contains_key(spec.scalars, cp("__many__")) {
        many = Some(str_of(raw_get(sp, ci, cp("__many__")).unwrap()));
    } else if contains_key(spec.scalars, cp("___many___")) {
        many = Some(str_of(raw_get(sp, ci, cp("___many___")).unwrap()));
    }
    if let Some(m) = many {
        for entry in unvalidated.iter() {
            let val = getitem(mut c, re, si, entry)?;
            validate_entry(mut c, re, sp, si, entry, m, val, false, o, mut st)?;
        }
        unvalidated = Vec.new();
    }
    for entry in incorrect_scalars.iter() {
        st.ret_true = false;
        if not o.preserve {
            out_set(mut st, entry, Res.F);
        } else {
            st.ret_false = false;
            let msg = cat3(cp("Value "), cp(repr_of(entry)), cp(" was provided as a section"));
            out_set(mut st, entry, Res.E(perr("ValidateError", msg)));
        }
    }
    for entry in incorrect_sections.iter() {
        st.ret_true = false;
        if not o.preserve {
            out_set(mut st, entry, Res.F);
        } else {
            st.ret_false = false;
            let msg = cat3(cp("Section "), cp(repr_of(entry)), cp(" was provided as a single value"));
            out_set(mut st, entry, Res.E(perr("ValidateError", msg)));
        }
    }
    for entry in c.secs[si].sections.clone() {
        if si == 0 and eq_s(entry, "DEFAULT") {
            continue;
        }
        let sub = sec_of(raw_get(c, si, entry).unwrap());
        if c.secs[sub].configspec < 0 {
            unvalidated.push(entry.clone());
            continue;
        }
        if o.copy {
            copy_comments(mut c, sp, si, ci, entry);
        }
        let r = validate_sec(mut c, re, sp, sub, o)?;
        match r {
            Res.F => st.ret_true = false,
            Res.T => st.ret_false = false,
            _ => st.ret_true = false,
        }
        out_set(mut st, entry, r);
    }
    c.secs[si].extra_values = unvalidated;
    if o.preserve and not c.secs[si].created {
        st.ret_false = false;
    }
    if st.ret_false and o.preserve and st.keys.len() > 0 {
        let mut any = false;
        for r in st.vals.iter() {
            if res_truthy(r) {
                any = true;
            }
        }
        st.ret_false = not any;
    }
    if st.ret_true {
        return Ok(Res.T);
    }
    if st.ret_false {
        return Ok(Res.F);
    }
    let mut items: Vec[(Vec[i64], Res)] = Vec.new();
    let mut i = 0;
    while i < st.keys.len() {
        items.push((st.keys[i].clone(), st.vals[i].clone()));
        i += 1;
    }
    Ok(Res.D(items))
}

fn validate(c: mut ref Config, re: ref Pats, o: ref VOpts) -> Result[Res, PyErr] {
    if c.spec.len() == 0 {
        return Err(perr_s("ValueError", "No configspec supplied."));
    }
    let sp = c.spec[0].clone();
    if o.copy {
        c.initial_comment = sp.initial_comment.clone();
        c.final_comment = sp.final_comment.clone();
        c.encoding = sp.encoding.clone();
        c.newlines = sp.newlines.clone();
        c.indent_type = sp.indent_type.clone();
    }
    validate_sec(mut c, re, sp, 0, o)
}

// ---- the results

fn exc_repr(e: ref PyErr, out: mut ref Vec[i64]) {
    push_ascii(mut out, e.kind.as_str());
    out.push(40);
    if e.msg.len() > 0 or e.kind != "VdtMissingValue" {
        str_repr(e.msg, mut out);
    }
    out.push(41);
}

fn res_repr(r: ref Res, out: mut ref Vec[i64]) {
    match r {
        Res.T => push_ascii(mut out, "True"),
        Res.F => push_ascii(mut out, "False"),
        Res.E(e) => exc_repr(e, mut out),
        Res.D(items) => {
            out.push(123);
            let mut first = true;
            for (k, v) in items.iter() {
                if not first {
                    push_ascii(mut out, ", ");
                }
                first = false;
                str_repr(k, mut out);
                push_ascii(mut out, ": ");
                res_repr(v, mut out);
            }
            out.push(125);
        }
    }
}

#[derive(Clone)]
struct Flat {
    levels: Vec[Vec[i64]],
    key: Option[Vec[i64]],
    res: Res,
}

fn flatten(c: ref Config, si: i64, res: ref Res, levels: mut ref Vec[Vec[i64]], out: mut ref Vec[Flat]) {
    match res {
        Res.T => {}
        Res.D(items) => {
            for (key, val) in items.iter() {
                if let Res.T = val {
                    continue;
                }
                if let Some(Val.Sec(sub)) = raw_get(c, si, key) {
                    levels.push(key.clone());
                    flatten(c, sub, val, mut levels, mut out);
                    continue;
                }
                out.push(Flat { levels: levels.clone(), key: Some(key.clone()), res: val.clone() });
            }
            if levels.len() > 0 {
                levels.pop();
            }
        }
        _ => {
            out.push(Flat { levels: levels.clone(), key: None, res: res.clone() });
            if levels.len() > 0 {
                levels.pop();
            }
        }
    }
}

// -1, 0, 1 the way Python orders two strings
fn cmp_text(a: ref Vec[i64], b: ref Vec[i64]) -> i64 {
    let mut i = 0;
    while i < a.len() and i < b.len() {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 };
        }
        i += 1;
    }
    if a.len() < b.len() {
        -1
    } else if a.len() > b.len() {
        1
    } else {
        0
    }
}

fn flat_less(a: ref Flat, b: ref Flat) -> bool {
    let mut i = 0;
    while i < a.levels.len() and i < b.levels.len() {
        let d = cmp_text(a.levels[i], b.levels[i]);
        if d != 0 {
            return d < 0;
        }
        i += 1;
    }
    if a.levels.len() != b.levels.len() {
        return a.levels.len() < b.levels.len();
    }
    match (a.key.clone(), b.key.clone()) {
        (Some(x), Some(y)) => cmp_text(x, y) < 0,
        (None, Some(_)) => true,
        _ => false,
    }
}

fn flatten_errors(c: ref Config, res: ref Res) -> Vec[Flat] {
    let mut levels: Vec[Vec[i64]] = Vec.new();
    let mut out: Vec[Flat] = Vec.new();
    flatten(c, 0, res, mut levels, mut out);
    let mut i = 1;
    while i < out.len() {
        let mut j = i;
        while j > 0 and flat_less(out[j], out[j - 1]) {
            out.swap(j, j - 1);
            j -= 1;
        }
        i += 1;
    }
    out
}

fn flat_repr(f: ref Flat) -> String {
    let mut out: Vec[i64] = Vec.new();
    push_ascii(mut out, "([");
    let mut first = true;
    for l in f.levels.iter() {
        if not first {
            push_ascii(mut out, ", ");
        }
        first = false;
        str_repr(l, mut out);
    }
    push_ascii(mut out, "], ");
    match f.key {
        Some(k) => str_repr(k, mut out),
        None => push_ascii(mut out, "None"),
    }
    push_ascii(mut out, ", ");
    res_repr(f.res, mut out);
    out.push(41);
    to_string(out)
}

fn extra_values(c: ref Config, si: i64, prepend: ref Vec[Vec[i64]], out: mut ref Vec[(Vec[Vec[i64]], Vec[i64])]) {
    for name in c.secs[si].extra_values.iter() {
        out.push((prepend.clone(), name.clone()));
    }
    for name in c.secs[si].sections.iter() {
        if not contains_key(c.secs[si].extra_values, name) {
            let sub = sec_of(raw_get(c, si, name).unwrap());
            let mut p = prepend.clone();
            p.push(name.clone());
            extra_values(c, sub, p, mut out);
        }
    }
}

fn extra_repr(c: ref Config) -> String {
    let mut items: Vec[(Vec[Vec[i64]], Vec[i64])] = Vec.new();
    let none: Vec[Vec[i64]] = Vec.new();
    extra_values(c, 0, none, mut items);
    let mut out: Vec[i64] = Vec.new();
    out.push(91);
    let mut first = true;
    for (path, name) in items.iter() {
        if not first {
            push_ascii(mut out, ", ");
        }
        first = false;
        push_ascii(mut out, "((");
        let mut pf = true;
        for p in path.iter() {
            if not pf {
                push_ascii(mut out, ", ");
            }
            pf = false;
            str_repr(p, mut out);
        }
        if path.len() == 1 {
            out.push(44);
        }
        push_ascii(mut out, "), ");
        str_repr(name, mut out);
        out.push(41);
    }
    out.push(93);
    to_string(out)
}

fn restore_defaults(c: mut ref Config, si: i64) {
    let mut i = 0;
    while i < c.secs[si].dkeys.len() {
        let k = c.secs[si].dkeys[i].clone();
        let v = c.secs[si].dvals[i].clone();
        dict_set(mut c, si, k, v);
        if not contains_key(c.secs[si].defaults, k) {
            c.secs[si].defaults.push(k);
        }
        i += 1;
    }
    for name in c.secs[si].sections.clone() {
        let sub = sec_of(raw_get(c, si, name).unwrap());
        restore_defaults(mut c, sub);
    }
}
// ------------------------------------------------------------ editing

// Section.__delitem__
fn del_key(c: mut ref Config, si: i64, key: ref Vec[i64]) -> Result[(), PyErr] {
    if not dict_del(mut c, si, key) {
        return Err(key_error(key));
    }
    if contains_key(c.secs[si].scalars, key) {
        remove_key(mut c.secs[si].scalars, key);
    } else {
        remove_key(mut c.secs[si].sections, key);
    }
    let i = comment_index(c, si, key);
    if i >= 0 {
        c.secs[si].ckeys.remove(i);
        c.secs[si].comments.remove(i);
        let _ = c.secs[si].inline.remove(i);
    }
    Ok(())
}

// Section.rename: the value is fetched (so interpolated) on the way
fn rename(c: mut ref Config, re: ref Pats, si: i64, old: ref Vec[i64], new: ref Vec[i64]) -> Result[(), PyErr] {
    let in_scalars = contains_key(c.secs[si].scalars, old);
    if not in_scalars and not contains_key(c.secs[si].sections, old) {
        return Err(key_error(cat3(cp("Key \""), old, cp("\" not found."))));
    }
    let val = getitem(mut c, re, si, old)?;
    dict_del(mut c, si, old);
    dict_set(mut c, si, new, val);
    if in_scalars {
        let pos = index_key(c.secs[si].scalars, old);
        c.secs[si].scalars.remove(pos);
        c.secs[si].scalars.insert(pos, new.clone());
    } else {
        let pos = index_key(c.secs[si].sections, old);
        c.secs[si].sections.remove(pos);
        c.secs[si].sections.insert(pos, new.clone());
    }
    let i = comment_index(c, si, old);
    let lines = c.secs[si].comments[i].clone();
    let inline = c.secs[si].inline[i].clone();
    c.secs[si].ckeys.remove(i);
    c.secs[si].comments.remove(i);
    let _ = c.secs[si].inline.remove(i);
    set_comments(mut c, si, new, lines, inline);
    Ok(())
}

// Section.__setitem__ of a section from another config: a copy
fn copy_section(c: mut ref Config, re: ref Pats, si: i64, key: ref Vec[i64], o: mut ref Config, osi: i64) -> Result[(), PyErr] {
    if comment_index(c, si, key) < 0 {
        set_comments(mut c, si, key, Vec.new(), Some(Vec.new()));
    }
    remove_key(mut c.secs[si].defaults, key);
    if not in_dict(c, si, key) {
        c.secs[si].sections.push(key.clone());
    }
    let depth = c.secs[si].depth + 1;
    c.secs.push(new_sec(si, depth, Some(key.clone())));
    let ni = c.secs.len() - 1;
    for k in order(o, osi) {
        let v = getitem(mut o, re, osi, k)?;
        match v {
            Val.Sec(x) => copy_section(mut c, re, ni, k, mut o, x)?,
            _ => set_value(mut c, ni, k, v)?,
        }
    }
    dict_set(mut c, si, key, Val.Sec(ni));
    Ok(())
}

fn merge(c: mut ref Config, re: ref Pats, si: i64, o: mut ref Config, osi: i64) -> Result[(), PyErr] {
    let mut items: Vec[(Vec[i64], Val)] = Vec.new();
    for k in order(o, osi) {
        let v = getitem(mut o, re, osi, k)?;
        items.push((k.clone(), v));
    }
    for (key, val) in items.iter() {
        let mine = if in_dict(c, si, key) { sec_of(getitem(mut c, re, si, key)?) } else { -1 };
        match val {
            Val.Sec(b) => {
                if mine >= 0 {
                    merge(mut c, re, mine, mut o, b)?;
                } else {
                    copy_section(mut c, re, si, key, mut o, b)?;
                }
            }
            _ => set_value(mut c, si, key, val.clone())?,
        }
    }
    Ok(())
}

// ---- Section.walk with the two transforms the jobs use

#[derive(Clone)]
enum Wo {
    Nil,
    F,
    D(Vec[(Vec[i64], Wo)]),
}

fn wo_set(out: mut ref Vec[(Vec[i64], Wo)], key: ref Vec[i64], v: own Wo) {
    let mut i = 0;
    while i < out.len() {
        let (k, _) = out[i].clone();
        if same(k, key) {
            out[i] = (key.clone(), v);
            return;
        }
        i += 1;
    }
    out.push((key.clone(), v));
}

#[derive(Clone)]
struct Walk {
    // "rename" (with call_on_sections) or "int"
    rename: bool,
    strict: bool,
    old: Vec[i64],
    new: Vec[i64],
}

fn transform(c: mut ref Config, re: ref Pats, si: i64, key: ref Vec[i64], wk: ref Walk) -> Result[(), PyErr] {
    let val = getitem(mut c, re, si, key)?;
    if wk.rename {
        let newkey = replace_sub(key, wk.old, wk.new);
        rename(mut c, re, si, key, newkey)?;
        if let Val.Str(s) = val {
            set_value(mut c, si, newkey, Val.Str(replace_sub(s, wk.old, wk.new)))?;
        }
        return Ok(());
    }
    let n = int_of(val)?;
    set_value(mut c, si, key, Val.Int(n))
}

fn walk(c: mut ref Config, re: ref Pats, si: i64, wk: ref Walk) -> Result[Vec[(Vec[i64], Wo)], PyErr] {
    let mut out: Vec[(Vec[i64], Wo)] = Vec.new();
    let n = c.secs[si].scalars.len();
    let mut i = 0;
    while i < n {
        let entry = c.secs[si].scalars[i].clone();
        match transform(mut c, re, si, entry, wk) {
            Ok(()) => wo_set(mut out, c.secs[si].scalars[i].clone(), Wo.Nil),
            Err(e) => {
                if wk.strict {
                    return Err(e);
                }
                wo_set(mut out, c.secs[si].scalars[i].clone(), Wo.F);
            }
        }
        i += 1;
    }
    let m = c.secs[si].sections.len();
    let mut j = 0;
    while j < m {
        let entry = c.secs[si].sections[j].clone();
        if wk.rename {
            if let Err(e) = transform(mut c, re, si, entry, wk) {
                if wk.strict {
                    return Err(e);
                }
                wo_set(mut out, c.secs[si].sections[j].clone(), Wo.F);
            }
        }
        let now = c.secs[si].sections[j].clone();
        let sub = sec_of(getitem(mut c, re, si, now)?);
        let inner = walk(mut c, re, sub, wk)?;
        wo_set(mut out, now, Wo.D(inner));
        j += 1;
    }
    Ok(out)
}

fn wo_repr(items: ref Vec[(Vec[i64], Wo)], out: mut ref Vec[i64]) {
    out.push(123);
    let mut first = true;
    for (k, v) in items.iter() {
        if not first {
            push_ascii(mut out, ", ");
        }
        first = false;
        str_repr(k, mut out);
        push_ascii(mut out, ": ");
        match v {
            Wo.Nil => push_ascii(mut out, "None"),
            Wo.F => push_ascii(mut out, "False"),
            Wo.D(inner) => wo_repr(inner, mut out),
        }
    }
    out.push(125);
}

// ------------------------------------------------------------ the jobs

#[derive(Clone)]
struct DataFile {
    path: String,
    body: String,
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data_files() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        if let Err(e) = fs.write(f"data/{file.path}", file.body.clone()) {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

// a jobs.tsv column with its \\, \n and \t escapes undone
fn unescape(s: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < s.len() {
        if s[i] == 92 and i + 1 < s.len() {
            let n = s[i + 1];
            out.push(if n == 110 { 10 } else if n == 116 { 9 } else { n });
            i += 2;
        } else {
            out.push(s[i]);
            i += 1;
        }
    }
    out
}

fn split_on(s: ref Vec[i64], sep: i64) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    for ch in s {
        if ch == sep {
            out.push(cur);
            cur = Vec.new();
        } else {
            cur.push(ch);
        }
    }
    out.push(cur);
    out
}

struct W {
    names: Vec[Vec[i64]],
    cfgs: Vec[Config],
    rnames: Vec[Vec[i64]],
    rvals: Vec[Res],
}

fn fail(e: ref PyErr) -> String {
    f"! {e.kind}: {to_string(e.msg)}"
}

fn show_text(s: ref Vec[i64]) -> String {
    let mut out: Vec[i64] = Vec.new();
    for ch in s {
        if ch == 13 {
            push_ascii(mut out, "<CR>");
        } else {
            out.push(ch);
        }
    }
    to_string(out)
}

fn text_list_repr(items: ref Vec[Vec[i64]], out: mut ref Vec[i64]) {
    out.push(91);
    let mut first = true;
    for x in items.iter() {
        if not first {
            push_ascii(mut out, ", ");
        }
        first = false;
        str_repr(x, mut out);
    }
    out.push(93);
}

fn register(w: mut ref W, name: ref Vec[i64], c: own Config) {
    let i = index_key(w.names, name);
    if i < 0 {
        w.names.push(name.clone());
        w.cfgs.push(c.clone());
    } else {
        w.cfgs[i] = c;
    }
}

fn set_result(w: mut ref W, name: ref Vec[i64], r: own Res) {
    let i = index_key(w.rnames, name);
    if i < 0 {
        w.rnames.push(name.clone());
        w.rvals.push(r.clone());
    } else {
        w.rvals[i] = r;
    }
}

fn load_spec(re: ref Pats, path: ref String) -> Result[Config, PyErr] {
    let mut s = new_config();
    s.raise_errors = true;
    s.inspec = true;
    s.list_values = false;
    match load_file(mut s, re, path, true) {
        Ok(()) => Ok(s),
        Err(le) => {
            if le.err.kind == "OSError" {
                Err(perr("OSError", cat(cp("Reading configspec failed: "), le.err.msg)))
            } else {
                Err(perr("ConfigspecError", cat(cp("Parsing configspec failed: "), le.err.msg)))
            }
        }
    }
}

fn load(w: mut ref W, re: ref Pats, args: ref Vec[Vec[i64]], out: mut ref Vec[String]) {
    let opts = load_json(args[2]);
    let mut c = new_config();
    match j_get(opts, "interpolation") {
        Some(J.Bool(b)) => c.interpolation = if b { Interp.On } else { Interp.Off },
        Some(J.Str(s)) => c.interpolation = Interp.Name(s),
        _ => {}
    }
    c.raise_errors = j_bool(opts, "raise_errors", false);
    c.list_values = j_bool(opts, "list_values", true);
    c.stringify = j_bool(opts, "stringify", true);
    c.write_empty_values = j_bool(opts, "write_empty_values", false);
    if let Some(J.Str(s)) = j_get(opts, "encoding") {
        c.encoding = Some(s);
    }
    if let Some(J.Str(s)) = j_get(opts, "indent_type") {
        c.indent_type = Some(s);
    }
    let path = f"data/{to_string(args[1])}";
    if let Err(le) = load_file(mut c, re, path, false) {
        out.push(fail(le.err));
        if le.errors.len() > 1 {
            for x in le.errors.iter() {
                out.push(f"  {x.kind} at {x.line_number}: {to_string(x.msg)} {repr_of(x.line)}");
            }
        }
        if le.has_config {
            register(mut w, args[0], c);
        }
        return;
    }
    if let Some(J.Str(spec)) = j_get(opts, "configspec") {
        match load_spec(re, f"data/{to_string(spec)}") {
            Ok(s) => {
                c.spec.push(s);
                c.secs[0].configspec = 0;
            }
            Err(e) => {
                out.push(fail(e));
                return;
            }
        }
    }
    register(mut w, args[0], c);
    out.push("ok".to_string());
}

// walk_to: the value at a /-separated path, "" for the config itself
fn walk_to(c: mut ref Config, re: ref Pats, path: ref Vec[i64]) -> Result[Val, PyErr] {
    let mut v = Val.Sec(0);
    if path.len() == 0 {
        return Ok(v);
    }
    for seg in split_on(path, 47) {
        let si = sec_of(v);
        if si < 0 {
            return Err(perr("TypeError", cp(f"string indices must be integers, not 'str'")));
        }
        v = getitem(mut c, re, si, seg)?;
    }
    Ok(v)
}

fn walk_sec(c: mut ref Config, re: ref Pats, path: ref Vec[i64]) -> Result[i64, PyErr] {
    let v = walk_to(mut c, re, path)?;
    let si = sec_of(v);
    if si < 0 {
        return Err(perr("AttributeError", cp(f"'{type_name(v)}' object has no attribute 'keys'")));
    }
    Ok(si)
}

// the section a path's last segment sits in, and that segment
fn parent_and_key(c: mut ref Config, re: ref Pats, path: ref Vec[i64]) -> Result[(i64, Vec[i64]), PyErr] {
    let segs = split_on(path, 47);
    let mut parent: Vec[i64] = Vec.new();
    let mut k = 0;
    while k + 1 < segs.len() {
        if k > 0 {
            parent.push(47);
        }
        push_all(mut parent, segs[k]);
        k += 1;
    }
    let si = walk_sec(mut c, re, parent)?;
    Ok((si, segs[segs.len() - 1].clone()))
}

fn arg_or_empty(args: ref Vec[Vec[i64]], i: i64) -> Vec[i64] {
    if i < args.len() { args[i].clone() } else { Vec.new() }
}

fn top_repr(c: mut ref Config, re: ref Pats, v: ref Val) -> Result[String, PyErr] {
    let mut out: Vec[i64] = Vec.new();
    match v {
        Val.Sec(0) => section_repr(mut c, re, 0, true, mut out)?,
        _ => val_repr(mut c, re, v, mut out)?,
    }
    Ok(to_string(out))
}

fn comments_of(c: ref Config, si: i64, out: mut ref Vec[String]) {
    if si == 0 {
        let mut t: Vec[i64] = cp("initial ");
        text_list_repr(c.initial_comment, mut t);
        out.push(to_string(t));
    }
    for k in order(c, si) {
        let i = comment_index(c, si, k);
        let mut t = k.clone();
        t.push(32);
        text_list_repr(c.secs[si].comments[i], mut t);
        t.push(32);
        match c.secs[si].inline[i] {
            Some(s) => str_repr(s, mut t),
            None => push_ascii(mut t, "None"),
        }
        out.push(to_string(t));
    }
    if si == 0 {
        let mut t: Vec[i64] = cp("final ");
        text_list_repr(c.final_comment, mut t);
        out.push(to_string(t));
    }
}

fn as_bool(v: ref Val) -> Result[Val, PyErr] {
    if py_eq(v, Val.Bool(true)) {
        return Ok(Val.Bool(true));
    }
    if py_eq(v, Val.Bool(false)) {
        return Ok(Val.Bool(false));
    }
    if let Val.Str(s) = v {
        let l = py_lower(s);
        for t in ["yes", "on", "1", "true"] {
            if eq_s(l, t) {
                return Ok(Val.Bool(true));
            }
        }
        for t in ["no", "off", "0", "false"] {
            if eq_s(l, t) {
                return Ok(Val.Bool(false));
            }
        }
    }
    Err(perr("ValueError", cat3(cp("Value \""), py_str(v), cp("\" is neither True nor False"))))
}

fn run_config_op(w: mut ref W, re: ref Pats, ci: i64, op: ref Vec[i64], args: ref Vec[Vec[i64]], out: mut ref Vec[String]) -> Result[(), PyErr] {
    let mut c = w.cfgs[ci].clone();
    let r = config_op(mut w, mut c, re, op, args, mut out);
    w.cfgs[ci] = c;
    r
}

fn config_op(w: mut ref W, c: mut ref Config, re: ref Pats, op: ref Vec[i64], args: ref Vec[Vec[i64]], out: mut ref Vec[String]) -> Result[(), PyErr] {
    let path = arg_or_empty(args, 1);
    if eq_s(op, "repr") or eq_s(op, "get") {
        let v = walk_to(mut c, re, path)?;
        out.push(top_repr(mut c, re, v)?);
    } else if eq_s(op, "keys") {
        let si = walk_sec(mut c, re, path)?;
        let mut t: Vec[i64] = Vec.new();
        text_list_repr(order(c, si), mut t);
        out.push(to_string(t));
    } else if eq_s(op, "items") {
        let si = walk_sec(mut c, re, path)?;
        let mut t: Vec[i64] = Vec.new();
        t.push(91);
        let mut first = true;
        for k in order(c, si) {
            let v = getitem(mut c, re, si, k)?;
            if not first {
                push_ascii(mut t, ", ");
            }
            first = false;
            t.push(40);
            str_repr(k, mut t);
            push_ascii(mut t, ", ");
            val_repr(mut c, re, v, mut t)?;
            t.push(41);
        }
        t.push(93);
        out.push(to_string(t));
    } else if eq_s(op, "dict") {
        let si = walk_sec(mut c, re, path)?;
        let mut t: Vec[i64] = Vec.new();
        dict_repr(mut c, re, si, mut t)?;
        out.push(to_string(t));
    } else if eq_s(op, "comments") {
        let si = walk_sec(mut c, re, path)?;
        comments_of(c, si, mut out);
    } else if eq_s(op, "write") {
        if args.len() > 1 {
            let si = walk_sec(mut c, re, path)?;
            for line in write_lines(mut c, re, si, false)? {
                out.push(show_text(line));
            }
        } else {
            let text = write_text(mut c, re)?;
            out.push(f"{show_text(text)}<EOF>");
        }
    } else if eq_s(op, "set") {
        let (si, key) = parent_and_key(mut c, re, path)?;
        set_json(mut c, si, key, load_json(args[2]))?;
        out.push("ok".to_string());
    } else if eq_s(op, "rename") {
        let si = walk_sec(mut c, re, path)?;
        rename(mut c, re, si, args[2], args[3])?;
        out.push("ok".to_string());
    } else if eq_s(op, "del") {
        let (si, key) = parent_and_key(mut c, re, path)?;
        del_key(mut c, si, key)?;
        out.push("ok".to_string());
    } else if eq_s(op, "pop") {
        let (si, key) = parent_and_key(mut c, re, path)?;
        let v = getitem(mut c, re, si, key)?;
        del_key(mut c, si, key)?;
        out.push(top_repr(mut c, re, v)?);
    } else if eq_s(op, "setdefault") {
        let (si, key) = parent_and_key(mut c, re, path)?;
        let v = match getitem(mut c, re, si, key) {
            Ok(v) => v,
            Err(e) => {
                if e.kind != "KeyError" {
                    return Err(e);
                }
                set_value(mut c, si, key, Val.Str(args[2].clone()))?;
                getitem(mut c, re, si, key)?
            }
        };
        out.push(top_repr(mut c, re, v)?);
    } else if eq_s(op, "popitem") {
        let si = walk_sec(mut c, re, path)?;
        let seq = order(c, si);
        if seq.len() == 0 {
            return Err(key_error(cp(": 'popitem(): dictionary is empty'")));
        }
        let key = seq[0].clone();
        let v = getitem(mut c, re, si, key)?;
        del_key(mut c, si, key)?;
        let mut t: Vec[i64] = Vec.new();
        t.push(40);
        str_repr(key, mut t);
        push_ascii(mut t, ", ");
        val_repr(mut c, re, v, mut t)?;
        t.push(41);
        out.push(to_string(t));
    } else if eq_s(op, "merge") {
        let oi = index_key(w.names, args[1]);
        if oi < 0 {
            return Err(key_error(args[1]));
        }
        let mut o = w.cfgs[oi].clone();
        merge(mut c, re, 0, mut o, 0)?;
        out.push("ok".to_string());
    } else if eq_s(op, "walk_rename") or eq_s(op, "walk_int") {
        let wk = if eq_s(op, "walk_rename") {
            Walk { rename: true, strict: true, old: args[1].clone(), new: args[2].clone() }
        } else {
            Walk { rename: false, strict: eq_s(args[1], "strict"), old: Vec.new(), new: Vec.new() }
        };
        let items = walk(mut c, re, 0, wk)?;
        let mut t: Vec[i64] = Vec.new();
        wo_repr(items, mut t);
        out.push(to_string(t));
    } else if eq_s(op, "validate") {
        let opts = load_json(args[1]);
        let o = VOpts { preserve: j_bool(opts, "preserve_errors", false), copy: j_bool(opts, "copy", false) };
        let r = validate(mut c, re, o)?;
        let mut t: Vec[i64] = Vec.new();
        res_repr(r, mut t);
        set_result(mut w, args[0], r);
        out.push(to_string(t));
    } else if eq_s(op, "flatten") {
        let ri = index_key(w.rnames, args[0]);
        if ri < 0 {
            return Err(key_error(args[0]));
        }
        for f in flatten_errors(c, w.rvals[ri]) {
            out.push(flat_repr(f));
        }
    } else if eq_s(op, "extra") {
        out.push(extra_repr(c));
    } else if eq_s(op, "restore_defaults") {
        restore_defaults(mut c, 0);
        out.push("ok".to_string());
    } else {
        let (si, key) = parent_and_key(mut c, re, path)?;
        let v = getitem(mut c, re, si, key)?;
        let res = if eq_s(op, "as_int") {
            Val.Int(int_of(v)?)
        } else if eq_s(op, "as_float") {
            Val.Float(float_of(v)?)
        } else if eq_s(op, "as_bool") {
            as_bool(v)?
        } else {
            match v {
                Val.List(items) => Val.List(items.clone()),
                Val.Tuple(items) => Val.List(items.clone()),
                _ => Val.List(vec![v.clone()]),
            }
        };
        out.push(top_repr(mut c, re, res)?);
    }
    Ok(())
}

fn run_job(w: mut ref W, re: ref Pats, parts: ref Vec[Vec[i64]], out: mut ref Vec[String]) {
    let op = parts[0].clone();
    let args: Vec[Vec[i64]] = parts.iter().skip(1).map(|x| x.clone()).collect();
    if eq_s(op, "load") {
        load(mut w, re, args, mut out);
        return;
    }
    if eq_s(op, "check") {
        let j = load_json(args[1]);
        let missing = match j {
            J.Null => true,
            _ => false,
        };
        match vcheck(re, args[0], json_val(j), missing) {
            Ok(v) => {
                let mut t: Vec[i64] = Vec.new();
                plain_repr(v, mut t);
                out.push(to_string(t));
            }
            Err(e) => out.push(fail(e)),
        }
        return;
    }
    if eq_s(op, "default") {
        match get_default_value(re, args[0]) {
            Ok(v) => {
                let mut t: Vec[i64] = Vec.new();
                plain_repr(v, mut t);
                out.push(to_string(t));
            }
            Err(e) => out.push(fail(e)),
        }
        return;
    }
    let ci = index_key(w.names, args[0]);
    if ci < 0 {
        out.push("! AttributeError: 'NoneType' object has no attribute".to_string());
        return;
    }
    if let Err(e) = run_config_op(mut w, re, ci, op, args, mut out) {
        out.push(fail(e));
    }
}

fn main() {
    if let Err(e) = write_data_files() {
        eprintln(e);
        return;
    }
    let re = match new_pats() {
        Ok(p) => p,
        Err(e) => {
            eprintln(e);
            return;
        }
    };
    let mut w = W { names: Vec.new(), cfgs: Vec.new(), rnames: Vec.new(), rvals: Vec.new() };
    let jobs = match fs.read_to_string("data/jobs.tsv") {
        Ok(t) => cps(t),
        Err(e) => {
            eprintln(f"cannot read data/jobs.tsv: {e}");
            return;
        }
    };
    let mut out: Vec[String] = Vec.new();
    for line in split_on(jobs, 10) {
        if line.len() == 0 {
            continue;
        }
        if starts(line, "== ") {
            out.push(to_string(line));
            continue;
        }
        let raw = split_on(line, 9);
        let mut head: Vec[i64] = cp("-- ");
        let mut first = true;
        for r in raw.iter() {
            if not first {
                head.push(32);
            }
            first = false;
            push_all(mut head, r);
        }
        out.push(to_string(head));
        let parts: Vec[Vec[i64]] = raw.iter().map(|r| unescape(r)).collect();
        run_job(mut w, re, parts, mut out);
        for l in out {
            println(l);
        }
        out = Vec.new();
    }
    for line in out {
        println(line);
    }
}
