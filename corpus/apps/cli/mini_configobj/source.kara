fn pattern_keyword_0(t: mut ref String) {
    t.push_str("^ # line start\n");
    t.push_str("        (\\s*)                   # indentation\n");
    t.push_str("        (                       # keyword\n");
    t.push_str("            (?:\".*?\")|          # double quotes\n");
    t.push_str("            (?:'.*?')|          # single quotes\n");
    t.push_str("            (?:[^'\"=].*?)       # no quotes\n");
    t.push_str("        )\n");
    t.push_str("        \\s*=\\s*                 # divider\n");
    t.push_str("        (.*)                    # value (including list values and comments)\n");
    t.push_str("        $   # line end\n");
    t.push_str("        ");
}

fn pattern_sectionmarker_0(t: mut ref String) {
    t.push_str("^\n");
    t.push_str("        (\\s*)                     # 1: indentation\n");
    t.push_str("        ((?:\\[\\s*)+)              # 2: section marker open\n");
    t.push_str("        (                         # 3: section name open\n");
    t.push_str("            (?:\"\\s*\\S.*?\\s*\")|    # at least one non-space with double quotes\n");
    t.push_str("            (?:'\\s*\\S.*?\\s*')|    # at least one non-space with single quotes\n");
    t.push_str("            (?:[^'\"\\s].*?)        # at least one non-space unquoted\n");
    t.push_str("        )                         # section name close\n");
    t.push_str("        ((?:\\s*\\])+)              # 4: section marker close\n");
    t.push_str("        \\s*(\\#.*)?                # 5: optional comment\n");
    t.push_str("        $");
}

fn pattern_valueexp_0(t: mut ref String) {
    t.push_str("^\n");
    t.push_str("        (?:\n");
    t.push_str("            (?:\n");
    t.push_str("                (\n");
    t.push_str("                    (?:\n");
    t.push_str("                        (?:\n");
    t.push_str("                            (?:\".*?\")|              # double quotes\n");
    t.push_str("                            (?:'.*?')|              # single quotes\n");
    t.push_str("                            (?:[^'\",\\#][^,\\#]*?)    # unquoted\n");
    t.push_str("                        )\n");
    t.push_str("                        \\s*,\\s*                     # comma\n");
    t.push_str("                    )*      # match all list items ending in a comma (if any)\n");
    t.push_str("                )\n");
    t.push_str("                (\n");
    t.push_str("                    (?:\".*?\")|                      # double quotes\n");
    t.push_str("                    (?:'.*?')|                      # single quotes\n");
    t.push_str("                    (?:[^'\",\\#\\s][^,]*?)|           # unquoted\n");
    t.push_str("                    (?:(?<!,))                      # Empty value\n");
    t.push_str("                )?          # last item in a list - or string value\n");
    t.push_str("            )|\n");
    t.push_str("            (,)             # alternatively a single comma - empty list\n");
    t.push_str("        )\n");
    t.push_str("        \\s*(\\#.*)?          # optional comment\n");
    t.push_str("        $");
}

fn pattern_listvalueexp_0(t: mut ref String) {
    t.push_str("\n");
    t.push_str("        (\n");
    t.push_str("            (?:\".*?\")|          # double quotes\n");
    t.push_str("            (?:'.*?')|          # single quotes\n");
    t.push_str("            (?:[^'\",\\#]?.*?)       # unquoted\n");
    t.push_str("        )\n");
    t.push_str("        \\s*,\\s*                 # comma\n");
    t.push_str("        ");
}

fn pattern_nolistvalue_0(t: mut ref String) {
    t.push_str("^\n");
    t.push_str("        (\n");
    t.push_str("            (?:\".*?\")|          # double quotes\n");
    t.push_str("            (?:'.*?')|          # single quotes\n");
    t.push_str("            (?:[^'\"\\#].*?)|     # unquoted\n");
    t.push_str("            (?:)                # Empty value\n");
    t.push_str("        )\n");
    t.push_str("        \\s*(\\#.*)?              # optional comment\n");
    t.push_str("        $");
}

fn pattern_single_line_single_0(t: mut ref String) {
    t.push_str("^'''(.*?)'''\\s*(#.*)?$");
}

fn pattern_single_line_double_0(t: mut ref String) {
    t.push_str("^\"\"\"(.*?)\"\"\"\\s*(#.*)?$");
}

fn pattern_multi_line_single_0(t: mut ref String) {
    t.push_str("^(.*?)'''\\s*(#.*)?$");
}

fn pattern_multi_line_double_0(t: mut ref String) {
    t.push_str("^(.*?)\"\"\"\\s*(#.*)?$");
}

fn pattern_cp_keycre_0(t: mut ref String) {
    t.push_str("%\\(([^)]*)\\)s");
}

fn pattern_tp_keycre_0(t: mut ref String) {
    t.push_str("\n");
    t.push_str("        \\$(?:\n");
    t.push_str("          (?P<escaped>\\$)              |   # Two $ signs\n");
    t.push_str("          (?P<named>[_a-z][_a-z0-9]*)  |   # $name format\n");
    t.push_str("          {(?P<braced>[^}]*)}              # ${name} format\n");
    t.push_str("        )\n");
    t.push_str("        ");
}

fn pattern_func_re_0(t: mut ref String) {
    t.push_str("([^\\(\\)]+?)\\((.*)\\)");
}

fn pattern_key_arg_0(t: mut ref String) {
    t.push_str("^([a-zA-Z_][a-zA-Z0-9_]*)\\s*=\\s*(.*)$");
}

fn pattern_list_arg_0(t: mut ref String) {
    t.push_str("\n");
    t.push_str("    (?:\n");
    t.push_str("        ([a-zA-Z_][a-zA-Z0-9_]*)\\s*=\\s*list\\(\n");
    t.push_str("            (\n");
    t.push_str("                (?:\n");
    t.push_str("                    \\s*\n");
    t.push_str("                    (?:\n");
    t.push_str("                        (?:\".*?\")|              # double quotes\n");
    t.push_str("                        (?:'.*?')|              # single quotes\n");
    t.push_str("                        (?:[^'\",\\s\\)][^,\\)]*?)  # unquoted\n");
    t.push_str("                    )\n");
    t.push_str("                    \\s*,\\s*\n");
    t.push_str("                )*\n");
    t.push_str("                (?:\n");
    t.push_str("                    (?:\".*?\")|              # double quotes\n");
    t.push_str("                    (?:'.*?')|              # single quotes\n");
    t.push_str("                    (?:[^'\",\\s\\)][^,\\)]*?)  # unquoted\n");
    t.push_str("                )?                          # last one\n");
    t.push_str("            )\n");
    t.push_str("        \\)\n");
    t.push_str("    )\n");
}

fn pattern_list_members_0(t: mut ref String) {
    t.push_str("\n");
    t.push_str("    (\n");
    t.push_str("        (?:\".*?\")|              # double quotes\n");
    t.push_str("        (?:'.*?')|              # single quotes\n");
    t.push_str("        (?:[^'\",\\s=][^,=]*?)       # unquoted\n");
    t.push_str("    )\n");
    t.push_str("    (?:\n");
    t.push_str("    (?:\\s*,\\s*)|(?:\\s*$)            # comma\n");
    t.push_str("    )\n");
}

fn pattern_paramfinder_0(t: mut ref String) {
    t.push_str("\n");
    t.push_str("    (?:\n");
    t.push_str("        (\n");
    t.push_str("            (?:\n");
    t.push_str("                [a-zA-Z_][a-zA-Z0-9_]*\\s*=\\s*list\\(\n");
    t.push_str("                    (?:\n");
    t.push_str("                        \\s*\n");
    t.push_str("                        (?:\n");
    t.push_str("                            (?:\".*?\")|              # double quotes\n");
    t.push_str("                            (?:'.*?')|              # single quotes\n");
    t.push_str("                            (?:[^'\",\\s\\)][^,\\)]*?)       # unquoted\n");
    t.push_str("                        )\n");
    t.push_str("                        \\s*,\\s*\n");
    t.push_str("                    )*\n");
    t.push_str("                    (?:\n");
    t.push_str("                        (?:\".*?\")|              # double quotes\n");
    t.push_str("                        (?:'.*?')|              # single quotes\n");
    t.push_str("                        (?:[^'\",\\s\\)][^,\\)]*?)       # unquoted\n");
    t.push_str("                    )?                              # last one\n");
    t.push_str("                \\)\n");
    t.push_str("            )|\n");
    t.push_str("            (?:\n");
    t.push_str("                (?:\".*?\")|              # double quotes\n");
    t.push_str("                (?:'.*?')|              # single quotes\n");
    t.push_str("                (?:[^'\",\\s=][^,=]*?)|       # unquoted\n");
    t.push_str("                (?:                         # keyword argument\n");
    t.push_str("                    [a-zA-Z_][a-zA-Z0-9_]*\\s*=\\s*\n");
    t.push_str("                    (?:\n");
    t.push_str("                        (?:\".*?\")|              # double quotes\n");
    t.push_str("                        (?:'.*?')|              # single quotes\n");
    t.push_str("                        (?:[^'\",\\s=][^,=]*?)       # unquoted\n");
    t.push_str("                    )\n");
    t.push_str("                )\n");
    t.push_str("            )\n");
    t.push_str("        )\n");
    t.push_str("        (?:\n");
    t.push_str("            (?:\\s*,\\s*)|(?:\\s*$)            # comma\n");
    t.push_str("        )\n");
    t.push_str("    )\n");
    t.push_str("    ");
}

