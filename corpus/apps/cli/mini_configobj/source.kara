// The pattern text and flags of each regex configobj and validate compile.
fn pattern_source(name: Str) -> (String, i64) {
    let mut t = String.new();
    let mut flags = 0;
    if name == "keyword" {
        pattern_keyword_0(mut t);
        flags = 96;
    } else if name == "sectionmarker" {
        pattern_sectionmarker_0(mut t);
        flags = 96;
    } else if name == "valueexp" {
        pattern_valueexp_0(mut t);
        flags = 96;
    } else if name == "listvalueexp" {
        pattern_listvalueexp_0(mut t);
        flags = 96;
    } else if name == "nolistvalue" {
        pattern_nolistvalue_0(mut t);
        flags = 96;
    } else if name == "single_line_single" {
        pattern_single_line_single_0(mut t);
        flags = 32;
    } else if name == "single_line_double" {
        pattern_single_line_double_0(mut t);
        flags = 32;
    } else if name == "multi_line_single" {
        pattern_multi_line_single_0(mut t);
        flags = 32;
    } else if name == "multi_line_double" {
        pattern_multi_line_double_0(mut t);
        flags = 32;
    } else if name == "cp_keycre" {
        pattern_cp_keycre_0(mut t);
        flags = 32;
    } else if name == "tp_keycre" {
        pattern_tp_keycre_0(mut t);
        flags = 98;
    } else if name == "func_re" {
        pattern_func_re_0(mut t);
        flags = 48;
    } else if name == "key_arg" {
        pattern_key_arg_0(mut t);
        flags = 48;
    } else if name == "list_arg" {
        pattern_list_arg_0(mut t);
        flags = 112;
    } else if name == "list_members" {
        pattern_list_members_0(mut t);
        flags = 112;
    } else if name == "paramfinder" {
        pattern_paramfinder_0(mut t);
        flags = 112;
    }
    (t, flags)
}

