    v.push("GBS|T|||timestamp:ts;lat_err;lon_err;alt_err;sat_prn_num_f;pro_miss:dec;est_bias;est_bias_dev".to_string());
    v.push("GGA|T|latlon,vgga|is_valid,latitude,latitude_minutes,latitude_seconds,longitude,longitude_minutes,longitude_seconds|timestamp:ts;lat;lat_dir;lon;lon_dir;gps_qual:int;num_sats;horizontal_dil;altitude:float;altitude_units;geo_sep;geo_sep_units;age_gps_data;ref_station_id".to_string());
    v.push("GLL|T|latlon,vstatus|is_valid,latitude,latitude_minutes,latitude_seconds,longitude,longitude_minutes,longitude_seconds|lat;lat_dir;lon;lon_dir;timestamp:ts;status;faa_mode".to_string());
    v.push("GNS|T|latlon|latitude,latitude_minutes,latitude_seconds,longitude,longitude_minutes,longitude_seconds|timestamp:ts;lat;lat_dir;lon;lon_dir;mode_indicator;num_sats;hdop;altitude;geo_sep;age_gps_data;diferential".to_string());
    v.push("GRS|T|||timestamp:ts;residuals_mode:int;sv_res_01:float;sv_res_02:float;sv_res_03:float;sv_res_04:float;sv_res_05:float;sv_res_06:float;sv_res_07:float;sv_res_08:float;sv_res_09:float;sv_res_10:float;sv_res_11:float;sv_res_12:float".to_string());
    v.push("GSA|T|vgsa|is_valid|mode;mode_fix_type;sv_id01;sv_id02;sv_id03;sv_id04;sv_id05;sv_id06;sv_id07;sv_id08;sv_id09;sv_id10;sv_id11;sv_id12;pdop;hdop;vdop".to_string());
