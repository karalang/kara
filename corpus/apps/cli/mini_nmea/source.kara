// mini_nmea: pynmea2 1.19.0, the NMEA 0183 library for Python, on the
// logs of a morning's sail out of the Solent:
// - NMEASentence.parse: the sentence regex with its optional '$', the
//   three sentence-type forms (proprietary, query, talker) tried in
//   order, the data up to the first '*', the checksum (any case), the
//   trailing white space, and the errors it raises (ParseError,
//   ChecksumError, SentenceTypeError) with their tuple messages;
// - the 58 talker sentence classes and the proprietary ones of eleven
//   manufacturers, each manufacturer with its own __new__ rule for
//   picking a subclass from the first fields, read from pynmea2's own
//   class definitions (gen_kara.py);
// - the field model: __getattr__ by field name, '' for a missing field,
//   None for an empty one, the converters (timestamp, datestamp through
//   strptime's %d%m%y regex, int, float, Decimal, str and
//   utcfromtimestamp) and the raw string when a converter raises;
// - the mixins: latitude and longitude from DDDMM.MMMM with minutes and
//   seconds, datetime, the is_valid rules, ZDA's local time zone, route
//   waypoint lists, XDR transducers, SeaTalk command names;
// - __repr__, render with each option, __setattr__ into the data list,
//   and Python's repr of the values (datetime.time, Decimal, ...);
// - NMEAStreamReader in its three error modes over chunked input and
//   over a file, and NMEAFile's iteration, read, readline and next;
// - four programs on top: a voyage report, a GPX track, a multiplexer
//   that re-talks and re-checksums sentences, and an alarm watch.
//
// The inputs are data/jobs.txt and the logs beside it, made by mk.py.
// expected.out is the output of oracle.py, which runs the same jobs
// through pynmea2 itself (the copy in pynmea2/).

fn write_data() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data/out".to_string()) {
        return Err(f"cannot create data/out: {e}");
    }
    for file in data_files() {
        let (name, body) = file;
        let p = f"data/{name}";
        if let Err(e) = fs.write(p.clone(), body) {
            return Err(f"cannot write {p}: {e}");
        }
    }
    Ok(())
}

// ------------------------------------------------------------ text

fn chars_of(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn str_of(cs: ref Vec[char]) -> String {
    let mut s = String.new();
    for c in cs.iter() {
        s.push(*c);
    }
    s
}

fn slice_chars(cs: ref Vec[char], from: i64, to: i64) -> Vec[char] {
    let mut out: Vec[char] = Vec.new();
    let mut a = if from < 0 { 0 } else { from };
    let b = if to > cs.len() { cs.len() } else { to };
    while a < b {
        out.push(cs[a]);
        a += 1;
    }
    out
}

fn substr(s: ref String, from: i64, to: i64) -> String {
    str_of(slice_chars(chars_of(s), from, to))
}

fn char_len(s: ref String) -> i64 {
    s.chars().count()
}

fn split_on(s: ref String, sep: char) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn split_str(s: ref String, sep: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for p in s.split(sep) {
        out.push(p.to_string());
    }
    out
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut s = String.new();
    let mut first = true;
    for p in parts.iter() {
        if not first {
            s.push_str(sep);
        }
        s.push_str(p);
        first = false;
    }
    s
}

fn split_ws(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if is_space(c) {
            if cur.len() > 0 {
                out.push(cur);
                cur = String.new();
            }
        } else {
            cur.push(c);
        }
    }
    if cur.len() > 0 {
        out.push(cur);
    }
    out
}

fn ascii_upper(c: char) -> char {
    if c >= 'a' and c <= 'z' {
        char.try_from((c as u32) - 32).unwrap_or(c)
    } else {
        c
    }
}

fn ascii_lower(c: char) -> char {
    if c >= 'A' and c <= 'Z' {
        char.try_from((c as u32) + 32).unwrap_or(c)
    } else {
        c
    }
}

fn upper_str(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        out.push(ascii_upper(c));
    }
    out
}

// str.isspace
fn is_space(c: char) -> bool {
    let n = c as u32;
    (n >= 9 and n <= 13) or n == 32 or (n >= 0x1c and n <= 0x1f) or n == 0x85 or n == 0xa0
        or n == 0x1680 or (n >= 0x2000 and n <= 0x200a) or n == 0x2028 or n == 0x2029
        or n == 0x202f or n == 0x205f or n == 0x3000
}

fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

// \w on ASCII text
fn is_word(c: char) -> bool {
    is_digit(c) or (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_'
}

fn is_hex(c: char) -> bool {
    is_digit(c) or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F')
}

fn hex_digit(c: char) -> i64 {
    if is_digit(c) {
        ((c as u32) - 48) as i64
    } else if c >= 'a' and c <= 'f' {
        ((c as u32) - 87) as i64
    } else {
        ((c as u32) - 55) as i64
    }
}

fn hex2(n: i64) -> String {
    f"{n:02x}"
}

// repr(str)
fn repr_str(s: ref String) -> String {
    let has_sq = s.contains("'");
    let has_dq = s.contains("\"");
    let q = if has_sq and not has_dq { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        let n = c as u32;
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if n < 0x20 or (n >= 0x7f and n <= 0xa0) or n == 0xad {
            out.push_str(f"\\x{hex2(n as i64)}");
        } else {
            out.push(c);
        }
    }
    out.push(q);
    out
}

fn repr_list(items: ref Vec[String]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for s in items.iter() {
        parts.push(repr_str(s));
    }
    f"[{join(parts, ", ")}]"
}

fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    f"{x}"
}

fn utf8_len(s: ref String) -> i64 {
    s.len()
}

// ------------------------------------------------------------ big integers

// Magnitudes as 32-bit limbs, least significant first, with no high
// zero limbs (zero is the empty vector).
fn big_trim(a: mut ref Vec[u32]) {
    while a.len() > 0 and a[a.len() - 1] == 0 {
        a.pop();
    }
}

fn big_mul_add(a: mut ref Vec[u32], m: u64, add: u64) {
    let mut carry = add;
    for i in 0..a.len() {
        let t = (a[i] as u64) * m + carry;
        a[i] = (t & 4294967295) as u32;
        carry = t >> 32;
    }
    while carry > 0 {
        a.push((carry & 4294967295) as u32);
        carry = carry >> 32;
    }
}

fn big_from_digits(ds: ref Vec[u8]) -> Vec[u32] {
    let mut a: Vec[u32] = Vec.new();
    for d in ds.iter() {
        big_mul_add(mut a, 10, *d as u64);
    }
    big_trim(mut a);
    a
}

fn big_pow10(n: i64) -> Vec[u32] {
    let mut a: Vec[u32] = Vec.new();
    a.push(1);
    let mut k = n;
    while k >= 9 {
        big_mul_add(mut a, 1000000000, 0);
        k -= 9;
    }
    while k > 0 {
        big_mul_add(mut a, 10, 0);
        k -= 1;
    }
    a
}

fn big_mul(a: ref Vec[u32], b: ref Vec[u32]) -> Vec[u32] {
    let mut out: Vec[u32] = Vec.new();
    for _ in 0..(a.len() + b.len()) {
        out.push(0);
    }
    for i in 0..a.len() {
        let mut carry: u64 = 0;
        for j in 0..b.len() {
            let t = (a[i] as u64) * (b[j] as u64) + (out[i + j] as u64) + carry;
            out[i + j] = (t & 4294967295) as u32;
            carry = t >> 32;
        }
        let mut k = i + b.len();
        while carry > 0 {
            let t = (out[k] as u64) + carry;
            out[k] = (t & 4294967295) as u32;
            carry = t >> 32;
            k += 1;
        }
    }
    big_trim(mut out);
    out
}

fn big_bitlen(a: ref Vec[u32]) -> i64 {
    if a.len() == 0 {
        return 0;
    }
    let mut top = a[a.len() - 1];
    let mut n: i64 = 0;
    while top > 0 {
        n += 1;
        top = top >> 1;
    }
    (a.len() - 1) * 32 + n
}

fn big_shl(a: ref Vec[u32], bits: i64) -> Vec[u32] {
    let mut out: Vec[u32] = Vec.new();
    for _ in 0..(bits / 32) {
        out.push(0);
    }
    let s = bits % 32;
    let mut carry: u64 = 0;
    for i in 0..a.len() {
        let t = ((a[i] as u64) << s) | carry;
        out.push((t & 4294967295) as u32);
        carry = t >> 32;
    }
    if carry > 0 {
        out.push(carry as u32);
    }
    big_trim(mut out);
    out
}

fn big_shr1(a: mut ref Vec[u32]) {
    let mut i = 0;
    while i < a.len() {
        let hi: u32 = if i + 1 < a.len() { a[i + 1] & 1 } else { 0 };
        a[i] = (a[i] >> 1) | (hi << 31);
        i += 1;
    }
    big_trim(mut a);
}

fn big_cmp(a: ref Vec[u32], b: ref Vec[u32]) -> i64 {
    if a.len() != b.len() {
        return if a.len() < b.len() { -1 } else { 1 };
    }
    let mut i = a.len() - 1;
    while i >= 0 {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 };
        }
        i -= 1;
    }
    0
}

// a -= b, where a >= b.
fn big_sub(a: mut ref Vec[u32], b: ref Vec[u32]) {
    let mut borrow: i64 = 0;
    for i in 0..a.len() {
        let bv: i64 = if i < b.len() { b[i] as i64 } else { 0 };
        let mut t = (a[i] as i64) - bv - borrow;
        if t < 0 {
            t += 4294967296;
            borrow = 1;
        } else {
            borrow = 0;
        }
        a[i] = t as u32;
    }
    big_trim(mut a);
}

// ------------------------------------------------------------ decimal to float

// The f64 nearest to digits * 10**exp10, ties to even, as CPython's
// float() gives it. digits holds the digit values without leading zeros.
fn decimal_to_f64(digits: ref Vec[u8], exp10: i64, neg: bool) -> f64 {
    let mut ds = digits.clone();
    let mut e10 = exp10;
    while ds.len() > 0 and ds[ds.len() - 1] == 0 {
        ds.pop();
        e10 += 1;
    }
    let sign: f64 = if neg { -1.0 } else { 1.0 };
    if ds.len() == 0 {
        return sign * 0.0;
    }
    let n = ds.len();
    if n + e10 > 310 {
        return sign * f64.INFINITY;
    }
    if n + e10 < -330 {
        return sign * 0.0;
    }
    // The digits and the power of ten are exact, so one operation
    // rounds correctly.
    if n <= 15 and e10 >= -22 and e10 <= 22 {
        let mut m: f64 = 0.0;
        for d in ds.iter() {
            m = m * 10.0 + (*d as f64);
        }
        let mut p: f64 = 1.0;
        let mut k = if e10 < 0 { -e10 } else { e10 };
        while k > 0 {
            p *= 10.0;
            k -= 1;
        }
        return sign * (if e10 < 0 { m / p } else { m * p });
    }
    let mut num = big_from_digits(ds);
    let mut den: Vec[u32] = Vec.new();
    den.push(1);
    if e10 >= 0 {
        num = big_mul(num, big_pow10(e10));
    } else {
        den = big_pow10(-e10);
    }
    // q = floor(num * 2**s / den) with 54 bits: the 53 of the result
    // and one to round on.
    let mut s = 54 - (big_bitlen(num) - big_bitlen(den));
    if s > 1075 {
        s = 1075;
    }
    let mut q: u64 = 0;
    let mut rem: Vec[u32] = Vec.new();
    let mut tries = 0;
    while tries < 2 {
        let mut n2 = if s > 0 { big_shl(num, s) } else { num.clone() };
        let d2 = if s < 0 { big_shl(den, -s) } else { den.clone() };
        let mut dd = big_shl(d2, 55);
        q = 0;
        let mut bit = 55;
        while bit >= 0 {
            if big_cmp(n2, dd) >= 0 {
                big_sub(mut n2, dd);
                q = q | ((1 as u64) << bit);
            }
            big_shr1(mut dd);
            bit -= 1;
        }
        rem = n2;
        if q >= ((1 as u64) << 54) and s < 1075 {
            s -= 1;
            tries += 1;
            continue;
        }
        if q < ((1 as u64) << 53) and s < 1075 {
            s += 1;
            tries += 1;
            continue;
        }
        break;
    }
    let mut mant = q >> 1;
    let round = (q & 1) == 1;
    let sticky = rem.len() > 0;
    if round and (sticky or (mant & 1) == 1) {
        mant += 1;
    }
    // The value is mant * 2**(1 - s).
    let mut e2 = 1 - s;
    if mant == ((1 as u64) << 53) {
        mant = mant >> 1;
        e2 += 1;
    }
    let bits: u64 = if mant < ((1 as u64) << 52) {
        // Subnormal: s is 1075 and the exponent field is zero.
        mant
    } else {
        let biased = e2 + 1075;
        if biased >= 2047 {
            return sign * f64.INFINITY;
        }
        ((biased as u64) << 52) | (mant & (((1 as u64) << 52) - 1))
    };
    sign * bits.bits_as_f64()
}

// ------------------------------------------------------------ float() and int()

// What float() and int() do first: the white space at the ends is
// stripped and underscores between digits removed.
fn number_text(cs: ref Vec[char]) -> Option[Vec[char]] {
    let mut a = 0;
    while a < cs.len() and is_space(cs[a]) {
        a += 1;
    }
    let mut b = cs.len();
    while b > a and is_space(cs[b - 1]) {
        b -= 1;
    }
    let mut out: Vec[char] = Vec.new();
    let mut prev = ' ';
    for i in a..b {
        let c = cs[i];
        if (c as u32) >= 128 {
            return None;
        }
        if c == '_' {
            if not is_digit(prev) {
                return None;
            }
        } else {
            if prev == '_' and not is_digit(c) {
                return None;
            }
            out.push(c);
        }
        prev = c;
    }
    if prev == '_' {
        return None;
    }
    Some(out)
}

fn lower_word(cs: ref Vec[char], from: i64) -> String {
    let mut s = String.new();
    for i in from..cs.len() {
        s.push(ascii_lower(cs[i]));
    }
    s
}

// float() of a str; None where it raises ValueError.
fn py_float(cs: ref Vec[char]) -> Option[f64] {
    let t = number_text(cs)?;
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == '+' or t[i] == '-') {
        neg = t[i] == '-';
        i += 1;
    }
    let sign: f64 = if neg { -1.0 } else { 1.0 };
    let w = lower_word(t, i);
    if w == "inf" or w == "infinity" {
        return Some(sign * f64.INFINITY);
    }
    if w == "nan" {
        return Some(f64.INFINITY - f64.INFINITY);
    }
    let mut digits: Vec[u8] = Vec.new();
    let mut seen = false;
    let mut exp10: i64 = 0;
    while i < t.len() and is_digit(t[i]) {
        seen = true;
        let d = ((t[i] as u32) - 48) as u8;
        if digits.len() > 0 or d != 0 {
            digits.push(d);
        }
        i += 1;
    }
    if i < t.len() and t[i] == '.' {
        i += 1;
        while i < t.len() and is_digit(t[i]) {
            seen = true;
            let d = ((t[i] as u32) - 48) as u8;
            if digits.len() > 0 or d != 0 {
                digits.push(d);
            }
            exp10 -= 1;
            i += 1;
        }
    }
    if not seen {
        return None;
    }
    if i < t.len() and (t[i] == 'e' or t[i] == 'E') {
        i += 1;
        let mut eneg = false;
        if i < t.len() and (t[i] == '+' or t[i] == '-') {
            eneg = t[i] == '-';
            i += 1;
        }
        let st = i;
        let mut e: i64 = 0;
        while i < t.len() and is_digit(t[i]) {
            if e < 100000000 {
                e = e * 10 + ((t[i] as u32) - 48) as i64;
            }
            i += 1;
        }
        if i == st {
            return None;
        }
        exp10 += if eneg { -e } else { e };
    }
    if i != t.len() {
        return None;
    }
    Some(decimal_to_f64(digits, exp10, neg))
}

fn py_float_s(s: ref String) -> Option[f64] {
    py_float(chars_of(s))
}

// int() of a str; None where it raises ValueError (and, here, where the
// value would not fit in an i64).
fn py_int(cs: ref Vec[char]) -> Option[i64] {
    let t = number_text(cs)?;
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == '+' or t[i] == '-') {
        neg = t[i] == '-';
        i += 1;
    }
    if i == t.len() {
        return None;
    }
    let mut n: i64 = 0;
    let mut sig = 0;
    while i < t.len() {
        if not is_digit(t[i]) {
            return None;
        }
        n = n * 10 + ((t[i] as u32) - 48) as i64;
        if n > 0 {
            sig += 1;
        }
        if sig > 17 {
            return None;
        }
        i += 1;
    }
    Some(if neg { -n } else { n })
}

fn py_int_s(s: ref String) -> Option[i64] {
    py_int(chars_of(s))
}

// ------------------------------------------------------------ Decimal

// A decimal.Decimal: special is 0 for a finite number, 1 for Infinity,
// 2 for NaN and 3 for sNaN (whose payload digits are kept).
#[derive(Clone)]
struct Dec {
    neg: bool,
    coef: i128,
    exp: i64,
    special: i64,
    payload: String,
}

fn dec_new(neg: bool, coef: i128, exp: i64) -> Dec {
    Dec { neg: neg, coef: coef, exp: exp, special: 0, payload: String.new() }
}

// Decimal(str): the white space at the ends is stripped and every
// underscore dropped before the string is read.
fn parse_dec(s: ref String) -> Option[Dec] {
    let cs = chars_of(s);
    let mut a = 0;
    while a < cs.len() and is_space(cs[a]) {
        a += 1;
    }
    let mut b = cs.len();
    while b > a and is_space(cs[b - 1]) {
        b -= 1;
    }
    let mut t: Vec[char] = Vec.new();
    for i in a..b {
        if cs[i] != '_' {
            if (cs[i] as u32) >= 128 {
                return None;
            }
            t.push(cs[i]);
        }
    }
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == '+' or t[i] == '-') {
        neg = t[i] == '-';
        i += 1;
    }
    let w = lower_word(t, i);
    if w == "inf" or w == "infinity" {
        return Some(Dec { neg: neg, coef: 0, exp: 0, special: 1, payload: String.new() });
    }
    if w.starts_with("nan") or w.starts_with("snan") {
        let skip: i64 = if w.starts_with("nan") { 3 } else { 4 };
        let wc = chars_of(w);
        let mut p = String.new();
        let mut k = skip;
        while k < wc.len() {
            if not is_digit(wc[k]) {
                return None;
            }
            if p.len() > 0 or wc[k] != '0' {
                p.push(wc[k]);
            }
            k += 1;
        }
        return Some(Dec { neg: neg, coef: 0, exp: 0, special: if skip == 3 { 2 } else { 3 }, payload: p });
    }
    let mut coef: i128 = 0;
    let mut nd = 0;
    let mut seen = false;
    let mut exp: i64 = 0;
    while i < t.len() and is_digit(t[i]) {
        seen = true;
        coef = coef * 10 + (((t[i] as u32) - 48) as i128);
        if coef > 0 {
            nd += 1;
        }
        i += 1;
    }
    if i < t.len() and t[i] == '.' {
        i += 1;
        while i < t.len() and is_digit(t[i]) {
            seen = true;
            coef = coef * 10 + (((t[i] as u32) - 48) as i128);
            if coef > 0 {
                nd += 1;
            }
            exp -= 1;
            i += 1;
        }
    }
    if not seen or nd > 36 {
        return None;
    }
    if i < t.len() and (t[i] == 'e' or t[i] == 'E') {
        i += 1;
        let mut eneg = false;
        if i < t.len() and (t[i] == '+' or t[i] == '-') {
            eneg = t[i] == '-';
            i += 1;
        }
        let st = i;
        let mut e: i64 = 0;
        while i < t.len() and is_digit(t[i]) {
            if e < 100000000 {
                e = e * 10 + ((t[i] as u32) - 48) as i64;
            }
            i += 1;
        }
        if i == st {
            return None;
        }
        exp += if eneg { -e } else { e };
    }
    if i != t.len() {
        return None;
    }
    Some(dec_new(neg, coef, exp))
}

fn digits_of(n: i128) -> String {
    f"{n}"
}

// Decimal.__str__ (to_sci_string)
fn dec_str(d: ref Dec) -> String {
    let sign = if d.neg { "-" } else { "" };
    if d.special == 1 {
        return f"{sign}Infinity";
    }
    if d.special == 2 {
        return f"{sign}NaN{d.payload}";
    }
    if d.special == 3 {
        return f"{sign}sNaN{d.payload}";
    }
    let ds = digits_of(d.coef);
    let nd = ds.len();
    let leftdigits = d.exp + nd;
    let dotplace = if d.exp <= 0 and leftdigits > -6 { leftdigits } else { 1 };
    let mut intpart = String.new();
    let mut fracpart = String.new();
    if dotplace <= 0 {
        intpart.push('0');
        fracpart.push('.');
        for _ in 0..(-dotplace) {
            fracpart.push('0');
        }
        fracpart.push_str(ds);
    } else if dotplace >= nd {
        intpart.push_str(ds);
        for _ in 0..(dotplace - nd) {
            intpart.push('0');
        }
    } else {
        intpart = substr(ds, 0, dotplace);
        fracpart = f".{substr(ds, dotplace, nd)}";
    }
    let e = leftdigits - dotplace;
    let exp = if e == 0 { String.new() } else if e > 0 { f"E+{e}" } else { f"E{e}" };
    f"{sign}{intpart}{fracpart}{exp}"
}

fn pow10_i128(n: i64) -> i128 {
    let mut p: i128 = 1;
    for _ in 0..n {
        p = p * 10;
    }
    p
}

// The signed coefficients of two finite decimals over their smaller
// exponent.
fn dec_align(a: ref Dec, b: ref Dec) -> (i128, i128, i64) {
    let e = if a.exp < b.exp { a.exp } else { b.exp };
    let mut ca = a.coef * pow10_i128(a.exp - e);
    let mut cb = b.coef * pow10_i128(b.exp - e);
    if a.neg {
        ca = -ca;
    }
    if b.neg {
        cb = -cb;
    }
    (ca, cb, e)
}

fn dec_cmp(a: ref Dec, b: ref Dec) -> i64 {
    let (ca, cb, _) = dec_align(a, b);
    if ca < cb {
        -1
    } else if ca > cb {
        1
    } else {
        0
    }
}

fn dec_sub(a: ref Dec, b: ref Dec) -> Dec {
    let (ca, cb, e) = dec_align(a, b);
    let r = ca - cb;
    if r == 0 {
        return dec_new(a.neg and not b.neg, 0, e);
    }
    if r < 0 { dec_new(true, -r, e) } else { dec_new(false, r, e) }
}

fn dec_of_int(n: i64) -> Dec {
    if n < 0 { dec_new(true, (-n) as i128, 0) } else { dec_new(false, n as i128, 0) }
}

fn dec_float(d: ref Dec) -> f64 {
    py_float_s(dec_str(d)).unwrap_or(0.0)
}

// ------------------------------------------------------------ dates and times

fn is_leap(y: i64) -> bool {
    (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
}

fn days_in_month(y: i64, m: i64) -> i64 {
    if m == 2 {
        return if is_leap(y) { 29 } else { 28 };
    }
    if m == 4 or m == 6 or m == 9 or m == 11 { 30 } else { 31 }
}

fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

// Days since 1970-01-01 of a proleptic Gregorian date.
fn days_from_civil(y0: i64, m: i64, d: i64) -> i64 {
    let y = if m <= 2 { y0 - 1 } else { y0 };
    let era = floor_div(y, 400);
    let yoe = y - era * 400;
    let mp = if m > 2 { m - 3 } else { m + 9 };
    let doy = (153 * mp + 2) / 5 + d - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

fn civil_from_days(z0: i64) -> (i64, i64, i64) {
    let z = z0 + 719468;
    let era = floor_div(z, 146097);
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let y = yoe + era * 400;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = if mp < 10 { mp + 3 } else { mp - 9 };
    (if m <= 2 { y + 1 } else { y }, m, d)
}

// datetime.time; utc says whether tzinfo is datetime.timezone.utc.
#[derive(Clone)]
struct Tm {
    h: i64,
    m: i64,
    s: i64,
    us: i64,
    utc: bool,
}

// datetime.datetime; tz is 0 when naive, 1 for timezone.utc and 2 for a
// fixed offset of off minutes.
#[derive(Clone)]
struct Dt {
    y: i64,
    mo: i64,
    d: i64,
    h: i64,
    mi: i64,
    s: i64,
    us: i64,
    tz: i64,
    off: i64,
}

fn tm_repr(t: ref Tm) -> String {
    let mut s = f"datetime.time({t.h}, {t.m}";
    if t.us != 0 {
        s.push_str(f", {t.s}, {t.us}");
    } else if t.s != 0 {
        s.push_str(f", {t.s}");
    }
    if t.utc {
        s.push_str(", tzinfo=datetime.timezone.utc");
    }
    s.push(')');
    s
}

fn date_repr(y: i64, m: i64, d: i64) -> String {
    f"datetime.date({y}, {m}, {d})"
}

fn dt_repr(t: ref Dt) -> String {
    let mut s = f"datetime.datetime({t.y}, {t.mo}, {t.d}, {t.h}, {t.mi}";
    if t.us != 0 {
        s.push_str(f", {t.s}, {t.us}");
    } else if t.s != 0 {
        s.push_str(f", {t.s}");
    }
    if t.tz == 1 {
        s.push_str(", tzinfo=datetime.timezone.utc");
    }
    s.push(')');
    s
}

fn offset_text(off: i64) -> String {
    let sign = if off < 0 { "-" } else { "+" };
    let a = if off < 0 { -off } else { off };
    f"{sign}{a / 60:02}:{a % 60:02}"
}

fn dt_iso(t: ref Dt, sep: Str) -> String {
    let mut s = f"{t.y:04}-{t.mo:02}-{t.d:02}{sep}{t.h:02}:{t.mi:02}:{t.s:02}";
    if t.us != 0 {
        s.push_str(f".{t.us:06}");
    }
    if t.tz == 1 {
        s.push_str("+00:00");
    } else if t.tz == 2 {
        s.push_str(offset_text(t.off));
    }
    s
}

// The same wall clock moved by a number of minutes.
fn dt_add_minutes(t: ref Dt, mins: i64) -> Dt {
    let total = days_from_civil(t.y, t.mo, t.d) * 1440 + t.h * 60 + t.mi + mins;
    let days = floor_div(total, 1440);
    let rem = total - days * 1440;
    let (y, mo, d) = civil_from_days(days);
    Dt { y: y, mo: mo, d: d, h: rem / 60, mi: rem % 60, s: t.s, us: t.us, tz: t.tz, off: t.off }
}

fn round_half_even(x: f64) -> f64 {
    let r = x.round();
    if (x - r).abs() == 0.5 {
        2.0 * (x / 2.0).round()
    } else {
        r
    }
}

// datetime.utcfromtimestamp: the fraction is rounded half to even to
// microseconds, as _PyTime_ObjectToTimeval does.
fn utcfromtimestamp(t: f64) -> Option[Dt] {
    if t != t {
        return None;
    }
    let mut ip = t.trunc();
    let mut fp = (t - ip) * 1000000.0;
    fp = round_half_even(fp);
    if fp >= 1000000.0 {
        fp -= 1000000.0;
        ip += 1.0;
    } else if fp < 0.0 {
        fp += 1000000.0;
        ip -= 1.0;
    }
    if ip.abs() > 300000000000.0 {
        return None;
    }
    let secs = ip as i64;
    let days = floor_div(secs, 86400);
    let rem = secs - days * 86400;
    let (y, mo, d) = civil_from_days(days);
    if y < 1 or y > 9999 {
        return None;
    }
    Some(Dt { y: y, mo: mo, d: d, h: rem / 3600, mi: rem / 60 % 60, s: rem % 60, us: fp as i64, tz: 0, off: 0 })
}

// ------------------------------------------------------------ values

// A Python value as the sentence objects hand them out.
#[derive(Clone)]
enum Val {
    None,
    Bool(bool),
    Str(String),
    Int(i64),
    Float(f64),
    Dec(Dec),
    Time(Tm),
    Date(i64, i64, i64),
    Dt(Dt),
    List(Vec[String]),
    Trans(Vec[String]),
    Func(String),
}

fn repr_val(v: ref Val) -> String {
    match v {
        Val.None => "None".to_string(),
        Val.Bool(b) => if *b { "True".to_string() } else { "False".to_string() },
        Val.Str(s) => repr_str(s),
        Val.Int(n) => f"{n}",
        Val.Float(x) => float_repr(*x),
        Val.Dec(d) => f"Decimal('{dec_str(d)}')",
        Val.Time(t) => tm_repr(t),
        Val.Date(y, m, d) => date_repr(*y, *m, *d),
        Val.Dt(t) => dt_repr(t),
        Val.List(xs) => repr_list(xs),
        Val.Trans(xs) => f"Transducer(type={repr_str(xs[0])}, value={repr_str(xs[1])}, units={repr_str(xs[2])}, id={repr_str(xs[3])})",
        Val.Func(name) => f"<function {name}>",
    }
}

// str() of a value
fn str_val(v: ref Val) -> String {
    match v {
        Val.Str(s) => s.clone(),
        Val.Dec(d) => dec_str(d),
        Val.Dt(t) => dt_iso(t, " "),
        _ => repr_val(v),
    }
}

// The type name an error message gives for a value.
fn type_name(v: ref Val) -> String {
    let s = match v {
        Val.None => "None",
        Val.Bool(_) => "bool",
        Val.Str(_) => "str",
        Val.Int(_) => "int",
        Val.Float(_) => "float",
        Val.Dec(_) => "decimal.Decimal",
        Val.Time(_) => "datetime.time",
        Val.Date(_, _, _) => "datetime.date",
        Val.Dt(_) => "datetime.datetime",
        Val.List(_) => "list",
        Val.Trans(_) => "Transducer",
        Val.Func(_) => "function",
    };
    s.to_string()
}

fn val_is(v: ref Val, s: Str) -> bool {
    match v {
        Val.Str(x) => x == s,
        _ => false,
    }
}

fn val_text(v: ref Val) -> String {
    match v {
        Val.Str(x) => x.clone(),
        _ => String.new(),
    }
}

fn truthy(v: ref Val) -> bool {
    match v {
        Val.None => false,
        Val.Bool(b) => *b,
        Val.Str(s) => s.len() > 0,
        Val.Int(n) => *n != 0,
        Val.Float(x) => *x != 0.0,
        Val.Dec(d) => d.special != 0 or d.coef != 0,
        Val.List(xs) => xs.len() > 0,
        _ => true,
    }
}

// ------------------------------------------------------------ errors

// An exception: its class name and str().
struct PyErr {
    kind: String,
    msg: String,
}

fn perr(kind: Str, msg: own String) -> PyErr {
    PyErr { kind: kind.to_string(), msg: msg }
}

fn err_text(e: ref PyErr) -> String {
    f"{e.kind}: {e.msg}"
}

fn is_parse_error(e: ref PyErr) -> bool {
    e.kind == "ParseError" or e.kind == "ChecksumError" or e.kind == "SentenceTypeError"
}

// ParseError(message, data) keeps (message, data) as its one argument,
// so str() shows the tuple.
fn parse_error_list(kind: Str, msg: ref String, data: ref Vec[String]) -> PyErr {
    perr(kind, f"({repr_str(msg)}, {repr_list(data)})")
}

fn parse_error_line(kind: Str, msg: ref String, line: ref String) -> PyErr {
    perr(kind, f"({repr_str(msg)}, {repr_str(line)})")
}

fn index_error() -> PyErr {
    perr("IndexError", "list index out of range".to_string())
}

fn attr_error(name: ref String) -> PyErr {
    perr("AttributeError", name.clone())
}

// ------------------------------------------------------------ classes

struct Field {
    name: String,
    conv: String,
}

struct Cls {
    name: String,
    base: String,
    flags: Vec[String],
    props: Vec[String],
    fields: Vec[Field],
    idx: Map[String, i64],
}

impl Cls {
    fn has_flag(self, f: Str) -> bool {
        for x in self.flags.iter() {
            if x == f {
                return true;
            }
        }
        false
    }

    fn has_prop(self, p: ref String) -> bool {
        for x in self.props.iter() {
            if x == p {
                return true;
            }
        }
        false
    }

    fn valid_kind(self) -> bool {
        self.has_flag("vstatus") or self.has_flag("vrmc") or self.has_flag("vgsa") or self.has_flag("vgga")
            or self.has_flag("vvbw")
    }
}

struct Lib {
    classes: Vec[Cls],
    query: i64,
    generic: i64,
}

fn parse_cls(line: ref String) -> Cls {
    let parts = split_on(line, '|');
    let mut flags: Vec[String] = Vec.new();
    if parts[2].len() > 0 {
        flags = split_on(parts[2], ',');
    }
    let mut props: Vec[String] = Vec.new();
    if parts[3].len() > 0 {
        props = split_on(parts[3], ',');
    }
    let mut fields: Vec[Field] = Vec.new();
    let mut idx: Map[String, i64] = Map.new();
    if parts[4].len() > 0 {
        for f in split_on(parts[4], ';') {
            let bits = split_on(f, ':');
            let mut name = bits[0].clone();
            let mut conv = if bits.len() > 1 { bits[1].clone() } else { String.new() };
            if name.ends_with("!") {
                name = substr(name, 0, char_len(name) - 1);
                conv = "!".to_string();
            }
            // name_to_idx: a later field with the same name wins
            idx.insert(name.clone(), fields.len());
            fields.push(Field { name: name, conv: conv });
        }
    }
    Cls { name: parts[0].clone(), base: parts[1].clone(), flags: flags, props: props, fields: fields, idx: idx }
}

fn load_lib() -> Lib {
    let mut classes: Vec[Cls] = Vec.new();
    for l in class_lines() {
        classes.push(parse_cls(l));
    }
    let query = classes.len();
    classes.push(parse_cls("QuerySentence|Q||||".to_string()));
    let generic = classes.len();
    classes.push(parse_cls("ProprietarySentence|G||||".to_string()));
    Lib { classes: classes, query: query, generic: generic }
}

impl Lib {
    fn find(self, base: Str, name: ref String) -> i64 {
        let mut i = 0;
        while i < self.classes.len() {
            if self.classes[i].base == base and self.classes[i].name == name {
                return i;
            }
            i += 1;
        }
        -1
    }
}

// ------------------------------------------------------------ sentences

// A sentence object: its class, the data list, and the instance
// attributes __init__ set (talker, manufacturer, ...) or a caller did.
struct Msg {
    cls: i64,
    kind: i64,
    data: Vec[String],
    inst: Vec[(String, Val)],
}

const TALKER: i64 = 0;
const QUERY: i64 = 1;
const PROP: i64 = 2;

impl Msg {
    fn inst_get(self, name: ref String) -> Option[Val] {
        for (k, v) in self.inst.iter() {
            if k == name {
                return Some(v.clone());
            }
        }
        None
    }

    fn inst_set(mut ref self, name: ref String, v: own Val) {
        let mut i = 0;
        while i < self.inst.len() {
            if self.inst[i].0 == name {
                self.inst[i] = (name.clone(), v);
                return;
            }
            i += 1;
        }
        self.inst.push((name.clone(), v));
    }

    fn inst_str(self, name: Str) -> String {
        match self.inst_get(name.to_string()) {
            Some(v) => str_val(v),
            None => String.new(),
        }
    }
}

fn new_msg(cls: i64, kind: i64, data: own Vec[String]) -> Msg {
    Msg { cls: cls, kind: kind, data: data, inst: Vec.new() }
}

fn talker_msg(cls: i64, talker: ref String, stype: ref String, data: own Vec[String]) -> Msg {
    let mut m = new_msg(cls, TALKER, data);
    m.inst_set("talker".to_string(), Val.Str(talker.clone()));
    m.inst_set("sentence_type".to_string(), Val.Str(stype.clone()));
    m
}

fn query_msg(lib: ref Lib, talker: ref String, listener: ref String, stype: ref String) -> Msg {
    let mut m = new_msg(lib.query, QUERY, Vec.new());
    m.inst_set("talker".to_string(), Val.Str(talker.clone()));
    m.inst_set("listener".to_string(), Val.Str(listener.clone()));
    m.inst_set("sentence_type".to_string(), Val.Str(stype.clone()));
    m
}

fn at(data: ref Vec[String], i: i64) -> Result[String, PyErr] {
    if i < data.len() { Ok(data[i].clone()) } else { Err(index_error()) }
}

// ASHRATT.match: ^\d{6}\.\d{2,3}$
fn att_match(s: ref String) -> bool {
    let mut cs = chars_of(s);
    if cs.len() > 0 and cs[cs.len() - 1] == '\n' {
        cs.pop();
    }
    if cs.len() != 9 and cs.len() != 10 {
        return false;
    }
    for i in 0..cs.len() {
        let ok = if i == 6 { cs[i] == '.' } else { is_digit(cs[i]) };
        if not ok {
            return false;
        }
    }
    true
}

// ProprietarySentence.sentence_types.get(manufacturer, ProprietarySentence)
// and then that class's __new__, which picks a subclass from the data.
fn make_proprietary(lib: ref Lib, man: ref String, data: own Vec[String]) -> Result[Msg, PyErr] {
    let g = lib.find("P", man);
    if g < 0 {
        let mut m = new_msg(lib.generic, PROP, data);
        m.inst_set("manufacturer".to_string(), Val.Str(man.clone()));
        return Ok(m);
    }
    let mut sub_name = String.new();
    let mut stype: Option[String] = None;
    let mut body = data.clone();
    let mut att = false;
    if man == "ASH" {
        sub_name = f"{man}R{at(data, 1)?}";
        if lib.find(man, sub_name) < 0 and att_match(data[1]) {
            att = true;
        }
    } else if man == "GRM" or man == "KWD" or man == "MGN" or man == "SRF" {
        sub_name = f"{man}{data[0]}";
        stype = Some(sub_name.clone());
    } else if man == "RDI" {
        sub_name = f"{man}{data[0]}";
    } else if man == "SXN" or man == "UBX" {
        sub_name = f"{man}{at(data, 1)?}";
    } else if man == "VTX" {
        sub_name = f"{man}{at(data, 1)?}";
        stype = Some(f"{man}{data[0]}");
    } else if man == "TNL" {
        let st = if data[0].len() > 0 { data[0].clone() } else { at(data, 1)? };
        sub_name = f"{man}{st}";
        stype = Some(st);
    } else if man == "NOR" {
        sub_name = f"{man}{data[0]}";
        stype = Some(sub_name.clone());
        body = data[1..].to_vec();
    }
    let mut cls = if att { lib.find(man, "ASHRATT".to_string()) } else { lib.find(man, sub_name) };
    if cls < 0 {
        cls = g;
    }
    let mut m = new_msg(cls, PROP, body);
    if lib.classes[cls].name == "ASHRATT" {
        m.inst_set("subtype".to_string(), Val.Str("ATT".to_string()));
    }
    if let Some(st) = stype {
        m.inst_set("sentence_type".to_string(), Val.Str(st));
    }
    m.inst_set("manufacturer".to_string(), Val.Str(man.clone()));
    Ok(m)
}

fn xor_checksum(s: ref String) -> i64 {
    let mut c: i64 = 0;
    for ch in s.chars() {
        c = c ^ ((ch as u32) as i64);
    }
    c
}

fn all_space(cs: ref Vec[char], from: i64) -> bool {
    let mut i = from;
    while i < cs.len() {
        if not is_space(cs[i]) {
            return false;
        }
        i += 1;
    }
    true
}

fn words(cs: ref Vec[char], from: i64, to: i64) -> bool {
    if to > cs.len() {
        return false;
    }
    let mut i = from;
    while i < to {
        if not is_word(cs[i]) {
            return false;
        }
        i += 1;
    }
    true
}

// NMEASentence.sentence_re.match: the start of the sentence type, its
// end, the end of the data and the start of the checksum (-1 for none).
fn match_sentence(cs: ref Vec[char]) -> Option[(i64, i64, i64, i64)] {
    let n = cs.len();
    let mut i = 0;
    while i < n and is_space(cs[i]) {
        i += 1;
    }
    if i < n and cs[i] == '$' {
        i += 1;
    }
    let mut ends: Vec[i64] = Vec.new();
    if i < n and (cs[i] == 'P' or cs[i] == 'p') and words(cs, i + 1, i + 4) {
        ends.push(i + 4);
    }
    if words(cs, i, i + 4) and i + 9 <= n and (cs[i + 4] == 'Q' or cs[i + 4] == 'q') and cs[i + 5] == ','
        and words(cs, i + 6, i + 9) {
        ends.push(i + 9);
    }
    if words(cs, i, i + 5) and i + 6 <= n and cs[i + 5] == ',' {
        ends.push(i + 6);
    }
    for e in ends.iter() {
        let mut d = *e;
        while d < n and cs[d] != '*' {
            d += 1;
        }
        if d == n {
            return Some((i, *e, d, -1));
        }
        if d + 3 <= n and is_hex(cs[d + 1]) and is_hex(cs[d + 2]) and all_space(cs, d + 3) {
            return Some((i, *e, d, d + 1));
        }
    }
    None
}

// NMEASentence.parse
fn parse_sentence(lib: ref Lib, line: ref String, check: bool) -> Result[Msg, PyErr] {
    let cs = chars_of(line);
    let (st, te, de, ck) = match match_sentence(cs) {
        Some(r) => r,
        None => return Err(parse_error_line("ParseError", "could not parse data".to_string(), line)),
    };
    let nmea_str = str_of(slice_chars(cs, st, de));
    let data_str = str_of(slice_chars(cs, te, de));
    let stype = upper_str(str_of(slice_chars(cs, st, te)));
    let data = split_on(data_str, ',');
    if ck >= 0 {
        let cs1 = hex_digit(cs[ck]) * 16 + hex_digit(cs[ck + 1]);
        let cs2 = xor_checksum(nmea_str);
        if cs1 != cs2 {
            return Err(parse_error_list("ChecksumError", f"checksum does not match: {cs1:02X} != {cs2:02X}", data));
        }
    } else if check {
        return Err(parse_error_list("ChecksumError", "strict checking requested but checksum missing".to_string(), data));
    }
    let t = chars_of(stype);
    if t.len() == 6 and words(t, 0, 5) and t[5] == ',' {
        let talker = str_of(slice_chars(t, 0, 2));
        let sentence = str_of(slice_chars(t, 2, 5));
        let cls = lib.find("T", sentence);
        if cls < 0 {
            return Err(parse_error_line("SentenceTypeError", f"Unknown sentence type {stype}", line));
        }
        return Ok(talker_msg(cls, talker, sentence, data));
    }
    if t.len() == 9 and words(t, 0, 4) and t[4] == 'Q' and t[5] == ',' and words(t, 6, 9) and data_str.len() == 0 {
        return Ok(query_msg(lib, str_of(slice_chars(t, 0, 2)), str_of(slice_chars(t, 2, 4)), str_of(slice_chars(t, 6, 9))));
    }
    if t.len() == 4 and t[0] == 'P' and words(t, 1, 4) {
        return make_proprietary(lib, str_of(slice_chars(t, 1, 4)), data);
    }
    Err(parse_error_line("ParseError", f"could not parse sentence type: {repr_str(stype)}", line))
}

// ------------------------------------------------------------ converters

// nmea_utils.timestamp: hhmmss[.ss] to a time in UTC.
fn conv_timestamp(s: ref String) -> Option[Val] {
    let cs = chars_of(s);
    let ms_s = slice_chars(cs, 6, cs.len());
    let mut us: i64 = 0;
    if ms_s.len() > 0 {
        let x = py_float(ms_s)? * 1000000.0;
        if x != x or x.abs() > 1000000000000.0 {
            return None;
        }
        us = x.trunc() as i64;
    }
    let h = py_int(slice_chars(cs, 0, 2))?;
    let m = py_int(slice_chars(cs, 2, 4))?;
    let sec = py_int(slice_chars(cs, 4, 6))?;
    if h < 0 or h > 23 or m < 0 or m > 59 or sec < 0 or sec > 59 or us < 0 or us > 999999 {
        return None;
    }
    Some(Val.Time(Tm { h: h, m: m, s: sec, us: us, utc: true }))
}

fn two_digits(cs: ref Vec[char], i: i64) -> bool {
    i + 2 <= cs.len() and is_digit(cs[i]) and is_digit(cs[i + 1])
}

fn digit_at(cs: ref Vec[char], i: i64) -> i64 {
    ((cs[i] as u32) - 48) as i64
}

// The (end, value) pairs strptime's %d alternatives match at i, in the
// order the regex tries them: 3[0-1]|[1-2]\d|0[1-9]|[1-9]| [1-9]
fn day_alts(cs: ref Vec[char], i: i64) -> Vec[(i64, i64)] {
    let mut out: Vec[(i64, i64)] = Vec.new();
    let n = cs.len();
    if i + 2 <= n and cs[i] == '3' and (cs[i + 1] == '0' or cs[i + 1] == '1') {
        out.push((i + 2, 30 + digit_at(cs, i + 1)));
    }
    if i + 2 <= n and (cs[i] == '1' or cs[i] == '2') and is_digit(cs[i + 1]) {
        out.push((i + 2, digit_at(cs, i) * 10 + digit_at(cs, i + 1)));
    }
    if i + 2 <= n and cs[i] == '0' and cs[i + 1] >= '1' and cs[i + 1] <= '9' {
        out.push((i + 2, digit_at(cs, i + 1)));
    }
    if i + 1 <= n and cs[i] >= '1' and cs[i] <= '9' {
        out.push((i + 1, digit_at(cs, i)));
    }
    if i + 2 <= n and cs[i] == ' ' and cs[i + 1] >= '1' and cs[i + 1] <= '9' {
        out.push((i + 2, digit_at(cs, i + 1)));
    }
    out
}

// %m: 1[0-2]|0[1-9]|[1-9]
fn month_alts(cs: ref Vec[char], i: i64) -> Vec[(i64, i64)] {
    let mut out: Vec[(i64, i64)] = Vec.new();
    let n = cs.len();
    if i + 2 <= n and cs[i] == '1' and cs[i + 1] >= '0' and cs[i + 1] <= '2' {
        out.push((i + 2, 10 + digit_at(cs, i + 1)));
    }
    if i + 2 <= n and cs[i] == '0' and cs[i + 1] >= '1' and cs[i + 1] <= '9' {
        out.push((i + 2, digit_at(cs, i + 1)));
    }
    if i + 1 <= n and cs[i] >= '1' and cs[i] <= '9' {
        out.push((i + 1, digit_at(cs, i)));
    }
    out
}

// nmea_utils.datestamp: datetime.strptime(s, '%d%m%y').date(). The
// regex takes its first match, which need not reach the end of the
// string ("unconverted data remains").
fn conv_datestamp(s: ref String) -> Option[Val] {
    let cs = chars_of(s);
    for (de, day) in day_alts(cs, 0) {
        for (me, month) in month_alts(cs, de) {
            if two_digits(cs, me) {
                if me + 2 != cs.len() {
                    return None;
                }
                let yy = digit_at(cs, me) * 10 + digit_at(cs, me + 1);
                let year = if yy <= 68 { yy + 2000 } else { yy + 1900 };
                if day > days_in_month(year, month) {
                    return None;
                }
                return Some(Val.Date(year, month, day));
            }
        }
    }
    None
}

fn convert(conv: ref String, v: ref String) -> Option[Val] {
    if conv == "ts" {
        conv_timestamp(v)
    } else if conv == "ds" {
        conv_datestamp(v)
    } else if conv == "int" {
        Some(Val.Int(py_int_s(v)?))
    } else if conv == "float" {
        Some(Val.Float(py_float_s(v)?))
    } else if conv == "dec" {
        Some(Val.Dec(parse_dec(v)?))
    } else if conv == "str" {
        Some(Val.Str(v.clone()))
    } else {
        // NOR's lambda x: datetime.utcfromtimestamp(float(x))
        Some(Val.Dt(utcfromtimestamp(py_float_s(v)?)?))
    }
}

// ------------------------------------------------------------ attributes

fn cls_of(lib: ref Lib, m: ref Msg) -> ref Cls {
    ref lib.classes[m.cls]
}

// NMEASentence.__getattr__
fn field_attr(lib: ref Lib, m: ref Msg, name: ref String) -> Result[Val, PyErr] {
    let c = cls_of(lib, m);
    let i = match c.idx.get(name) {
        Some(i) => i,
        None => return Err(attr_error(name)),
    };
    let conv = c.fields[i].conv.clone();
    let v = if i < m.data.len() { m.data[i].clone() } else { String.new() };
    if conv.len() == 0 {
        return Ok(Val.Str(v));
    }
    if conv == "!" {
        return Ok(Val.Func("NMEASentence.checksum".to_string()));
    }
    if v.len() == 0 {
        return Ok(Val.None);
    }
    match convert(conv, v) {
        Some(x) => Ok(x),
        None => Ok(Val.Str(v)),
    }
}

// getattr(sentence, name): the properties first, then the instance
// attributes, then __getattr__ (which a property raising AttributeError
// also falls back to).
fn getattr(lib: ref Lib, m: ref Msg, name: Str) -> Result[Val, PyErr] {
    let n = name.to_string();
    if n == "data" {
        return Ok(Val.List(m.data.clone()));
    }
    if cls_of(lib, m).has_prop(n) {
        match prop(lib, m, n) {
            Ok(v) => return Ok(v),
            Err(e) => {
                if e.kind != "AttributeError" {
                    return Err(e);
                }
            }
        }
    } else if let Some(v) = m.inst_get(n) {
        return Ok(v);
    }
    field_attr(lib, m, n)
}

fn attr_str(lib: ref Lib, m: ref Msg, name: Str) -> Result[String, PyErr] {
    Ok(val_text(getattr(lib, m, name)?))
}

// nmea_utils.dm_to_sd
fn dm_to_sd(v: ref Val) -> Result[f64, PyErr] {
    let dm = match v {
        Val.Str(s) => s.clone(),
        Val.None => return Ok(0.0),
        _ => str_val(v),
    };
    if dm.len() == 0 or dm == "0" {
        return Ok(0.0);
    }
    // ^(\d+)(\d\d\.\d+)$
    let mut cs = chars_of(dm);
    if cs.len() > 0 and cs[cs.len() - 1] == '\n' {
        cs.pop();
    }
    let mut dot = -1;
    let mut ok = true;
    for i in 0..cs.len() {
        if cs[i] == '.' {
            if dot >= 0 {
                ok = false;
            }
            dot = i;
        } else if not is_digit(cs[i]) {
            ok = false;
        }
    }
    if not ok or dot < 3 or dot == cs.len() - 1 {
        return Err(perr("ValueError", f"Geographic coordinate value '{dm}' is not valid DDDMM.MMM"));
    }
    let d = py_float(slice_chars(cs, 0, dot - 2)).unwrap_or(0.0);
    let mm = py_float(slice_chars(cs, dot - 2, cs.len())).unwrap_or(0.0);
    Ok(d + mm / 60.0)
}

fn signed_deg(lib: ref Lib, m: ref Msg, field: Str, dir: Str, pos: Str, neg: Str) -> Result[f64, PyErr] {
    let sd = dm_to_sd(getattr(lib, m, field)?)?;
    let d = getattr(lib, m, dir)?;
    if val_is(d, pos) {
        Ok(sd)
    } else if val_is(d, neg) {
        Ok(-sd)
    } else {
        Ok(0.0)
    }
}

fn int_arg(v: ref Val) -> Result[i64, PyErr] {
    match v {
        Val.Int(n) => Ok(*n),
        Val.Bool(b) => Ok(if *b { 1 } else { 0 }),
        _ => Err(perr("TypeError", f"'{py_type_name(v)}' object cannot be interpreted as an integer")),
    }
}

fn py_type_name(v: ref Val) -> String {
    if type_name(v) == "None" { "NoneType".to_string() } else { type_name(v) }
}

// datetime.date(year=..., month=..., day=...)
fn make_date(y: ref Val, mo: ref Val, d: ref Val) -> Result[Val, PyErr] {
    let year = int_arg(y)?;
    let month = int_arg(mo)?;
    let day = int_arg(d)?;
    if year < 1 or year > 9999 {
        return Err(perr("ValueError", f"year {year} is out of range"));
    }
    if month < 1 or month > 12 {
        return Err(perr("ValueError", "month must be in 1..12".to_string()));
    }
    if day < 1 or day > days_in_month(year, month) {
        return Err(perr("ValueError", "day is out of range for month".to_string()));
    }
    Ok(Val.Date(year, month, day))
}

// datetime.datetime.combine(date, time)
fn combine(d: ref Val, t: ref Val) -> Result[Dt, PyErr] {
    let (y, mo, dd) = match d {
        Val.Date(y, mo, dd) => (*y, *mo, *dd),
        Val.Dt(x) => (x.y, x.mo, x.d),
        _ => return Err(perr("TypeError", f"combine() argument 1 must be datetime.date, not {type_name(d)}")),
    };
    match t {
        Val.Time(x) => Ok(Dt { y: y, mo: mo, d: dd, h: x.h, mi: x.m, s: x.s, us: x.us, tz: if x.utc { 1 } else { 0 }, off: 0 }),
        _ => Err(perr("TypeError", f"combine() argument 2 must be datetime.time, not {type_name(t)}")),
    }
}

fn timedelta_repr(mins: i64) -> String {
    let total = mins * 60;
    let days = floor_div(total, 86400);
    let secs = total - days * 86400;
    let mut parts: Vec[String] = Vec.new();
    if days != 0 {
        parts.push(f"days={days}");
    }
    if secs != 0 {
        parts.push(f"seconds={secs}");
    }
    if parts.len() == 0 {
        return "datetime.timedelta(0)".to_string();
    }
    f"datetime.timedelta({join(parts, ", ")})"
}

// ZDA.localdatetime: combine, then astimezone(TZInfo(hh, mm)), whose
// utcoffset is timedelta(hours=hh, minutes=mm).
fn zda_local(lib: ref Lib, m: ref Msg) -> Result[Val, PyErr] {
    let ds = prop(lib, m, "datestamp".to_string())?;
    let ts = getattr(lib, m, "timestamp")?;
    let d = combine(ds, ts)?;
    let hh = getattr(lib, m, "local_zone")?;
    let mm = getattr(lib, m, "local_zone_minutes")?;
    let mins = match mm {
        Val.Int(n) => n,
        _ => return Err(perr("TypeError", f"unsupported type for timedelta minutes component: {py_type_name(mm)}")),
    };
    let hours = match hh {
        Val.Int(n) => n,
        _ => return Err(perr("TypeError", f"unsupported type for timedelta hours component: {py_type_name(hh)}")),
    };
    let off = hours * 60 + mins;
    if off <= -1440 or off >= 1440 {
        return Err(perr("ValueError", f"offset must be a timedelta strictly between -timedelta(hours=24) and timedelta(hours=24), not {timedelta_repr(off)}."));
    }
    let mut local = dt_add_minutes(d, off);
    local.tz = 2;
    local.off = off;
    Ok(Val.Dt(local))
}

fn slice_from(data: ref Vec[String], from: i64) -> Vec[String] {
    if from >= data.len() {
        return Vec.new();
    }
    data[from..].to_vec()
}

fn in_chars(v: ref Val, set: Str) -> bool {
    match v {
        Val.Str(s) => char_len(s) == 1 and set.contains(s.as_str()),
        _ => false,
    }
}

// The properties the mixins and a few classes add.
fn prop(lib: ref Lib, m: ref Msg, name: ref String) -> Result[Val, PyErr] {
    let c = cls_of(lib, m);
    if name == "latitude" {
        return Ok(Val.Float(signed_deg(lib, m, "lat", "lat_dir", "N", "S")?));
    }
    if name == "longitude" {
        return Ok(Val.Float(signed_deg(lib, m, "lon", "lon_dir", "E", "W")?));
    }
    if name == "latitude_minutes" or name == "longitude_minutes" {
        let x = if name == "latitude_minutes" { signed_deg(lib, m, "lat", "lat_dir", "N", "S")? } else { signed_deg(lib, m, "lon", "lon_dir", "E", "W")? };
        return Ok(Val.Float((x * 60.0).abs() % 60.0));
    }
    if name == "latitude_seconds" or name == "longitude_seconds" {
        let x = if name == "latitude_seconds" { signed_deg(lib, m, "lat", "lat_dir", "N", "S")? } else { signed_deg(lib, m, "lon", "lon_dir", "E", "W")? };
        return Ok(Val.Float((x * 3600.0).abs() % 60.0));
    }
    if name == "datetime" {
        let ds = getattr(lib, m, "datestamp")?;
        let ts = getattr(lib, m, "timestamp")?;
        return Ok(Val.Dt(combine(ds, ts)?));
    }
    if name == "datestamp" {
        let y = getattr(lib, m, "year")?;
        let mo = getattr(lib, m, "month")?;
        let d = getattr(lib, m, "day")?;
        return make_date(y, mo, d);
    }
    if name == "localdatetime" {
        return zda_local(lib, m);
    }
    if name == "is_valid" {
        if c.has_flag("vstatus") or c.has_flag("vrmc") {
            let mut ok = val_is(getattr(lib, m, "status")?, "A");
            if c.has_flag("vrmc") {
                if c.idx.get("mode_indicator".to_string()).unwrap_or(99) < m.data.len() {
                    ok = ok and in_chars(getattr(lib, m, "mode_indicator")?, "ADEFMPRS");
                }
                if c.idx.get("nav_status".to_string()).unwrap_or(99) < m.data.len() {
                    ok = ok and in_chars(getattr(lib, m, "nav_status")?, "SCU");
                }
            }
            return Ok(Val.Bool(ok));
        }
        if c.has_flag("vgsa") {
            let v = getattr(lib, m, "mode_fix_type")?;
            let s = str_val(v);
            return match py_int_s(s) {
                Some(n) => Ok(Val.Bool(n == 2 or n == 3)),
                None => Err(perr("ValueError", f"invalid literal for int() with base 10: {repr_str(s)}")),
            };
        }
        if c.has_flag("vgga") {
            return match getattr(lib, m, "gps_qual")? {
                Val.Int(n) => Ok(Val.Bool(n >= 1 and n < 6)),
                _ => Ok(Val.Bool(false)),
            };
        }
        let a = getattr(lib, m, "data_validity_water_spd")?;
        let b = getattr(lib, m, "data_validity_grnd_spd")?;
        return Ok(Val.Bool(val_text(a) == val_text(b) and val_is(b, "A")));
    }
    if name == "waypoint_list" {
        return Ok(Val.List(slice_from(m.data, if c.has_flag("rte") { 4 } else { 0 })));
    }
    if name == "num_transducers" {
        return Ok(Val.Int(m.data.len() / 4));
    }
    if name == "command_name" {
        return Ok(Val.Str(seatalk_command(attr_str(lib, m, "cmd")?)));
    }
    if name == "satellite_list" {
        return Ok(Val.List(slice_from(m.data, 1)));
    }
    if name == "tzinfo" {
        return Ok(Val.Func("TZInfo".to_string()));
    }
    Err(attr_error(name))
}

fn transducer(m: ref Msg, i: i64) -> Val {
    Val.Trans(m.data[(i * 4)..(i * 4 + 4)].to_vec())
}

// NMEASentence.__setattr__: a field name stores str(value) in the data
// list; anything else goes through normal attribute assignment.
fn setattr(lib: ref Lib, m: mut ref Msg, name: ref String, v: own Val) -> Result[(), PyErr] {
    let c = cls_of(lib, m);
    if let Some(i) = c.idx.get(name) {
        if i >= m.data.len() {
            return Err(perr("IndexError", "list assignment index out of range".to_string()));
        }
        m.data[i] = str_val(v);
        return Ok(());
    }
    if c.has_prop(name) {
        if name == "waypoint_list" {
            let keep = if c.has_flag("rte") { 4 } else { 0 };
            let mut d: Vec[String] = Vec.new();
            let mut i = 0;
            while i < keep and i < m.data.len() {
                d.push(m.data[i].clone());
                i += 1;
            }
            if let Val.List(xs) = v {
                for x in xs.iter() {
                    d.push(x.clone());
                }
            }
            m.data = d;
            return Ok(());
        }
        return Err(perr("AttributeError", f"property {repr_str(name)} of {repr_str(c.name)} object has no setter"));
    }
    m.inst_set(name, v);
    Ok(())
}

// ------------------------------------------------------------ rendering

fn identifier(lib: ref Lib, m: ref Msg) -> String {
    if m.kind == TALKER {
        return f"{m.inst_str("talker")}{m.inst_str("sentence_type")},";
    }
    if m.kind == QUERY {
        return f"{m.inst_str("talker")}{m.inst_str("listener")}Q,{m.inst_str("sentence_type")}";
    }
    let c = cls_of(lib, m);
    if c.name == "NOR" or c.base == "NOR" {
        return f"P{m.inst_str("sentence_type")},";
    }
    f"P{m.inst_str("manufacturer")}"
}

fn render(lib: ref Lib, m: ref Msg, checksum: bool, dollar: bool, newline: ref String) -> String {
    let mut res = f"{identifier(lib, m)}{join(m.data, ",")}";
    if checksum {
        let c = xor_checksum(res);
        res.push_str(f"*{c:02X}");
    }
    if dollar {
        res = f"${res}";
    }
    res.push_str(newline);
    res
}

fn render_str(lib: ref Lib, m: ref Msg) -> String {
    render(lib, m, true, true, String.new())
}

// NMEASentence.__repr__
fn repr_msg(lib: ref Lib, m: ref Msg) -> String {
    let c = cls_of(lib, m);
    let mut r: Vec[String] = Vec.new();
    let mut d: Vec[String] = Vec.new();
    let mut i = 0;
    while i < m.data.len() {
        if i >= c.fields.len() {
            d.push(m.data[i].clone());
        } else {
            let name = c.fields[i].name.clone();
            let v = match getattr(lib, m, name) {
                Ok(v) => repr_val(v),
                Err(e) => f"<{err_text(e)}>",
            };
            r.push(f"{name}={v}");
        }
        i += 1;
    }
    let extra = if d.len() > 0 { f" data={repr_list(d)}" } else { String.new() };
    f"<{c.name}({join(r, ", ")}){extra}>"
}

// ------------------------------------------------------------ files

fn read_text(name: ref String) -> String {
    fs.read_to_string(f"data/{name}").unwrap_or(String.new())
}

// The file's lines split on "\n", so a CRLF line keeps its "\r".
fn lines_of(name: ref String) -> Vec[String] {
    let mut ls = split_on(read_text(name), '\n');
    if ls.len() > 0 and ls[ls.len() - 1].len() == 0 {
        ls.pop();
    }
    ls
}

// A file opened for reading in text mode: universal newlines turn
// "\r\n" and a lone "\r" into "\n".
struct TextFile {
    lines: Vec[String],
    pos: i64,
}

fn open_text(name: ref String) -> TextFile {
    let mut lines: Vec[String] = Vec.new();
    let mut cur = String.new();
    let cs = chars_of(read_text(name));
    let mut i = 0;
    while i < cs.len() {
        let c = cs[i];
        if c == '\r' or c == '\n' {
            if c == '\r' and i + 1 < cs.len() and cs[i + 1] == '\n' {
                i += 1;
            }
            cur.push('\n');
            lines.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
        i += 1;
    }
    if cur.len() > 0 {
        lines.push(cur);
    }
    TextFile { lines: lines, pos: 0 }
}

impl TextFile {
    fn readline(mut ref self) -> String {
        if self.pos >= self.lines.len() {
            return String.new();
        }
        self.pos += 1;
        self.lines[self.pos - 1].clone()
    }
}

// ------------------------------------------------------------ parse jobs

fn show_prop(name: Str, r: own Result[Val, PyErr]) {
    match r {
        Ok(v) => println(f"  {name} {repr_val(v)}"),
        Err(e) => println(f"  {name} ! {err_text(e)}"),
    }
}

fn show_props(lib: ref Lib, m: ref Msg) {
    let c = cls_of(lib, m);
    println(f"  str {render_str(lib, m)}");
    println(f"  plain {render(lib, m, false, false, String.new())}");
    if c.has_flag("latlon") {
        for n in ["latitude", "longitude", "latitude_minutes", "longitude_minutes", "latitude_seconds", "longitude_seconds"] {
            show_prop(n, getattr(lib, m, n));
        }
    }
    if c.has_flag("zda") {
        show_prop("datestamp", getattr(lib, m, "datestamp"));
        match getattr(lib, m, "localdatetime") {
            Ok(v) => println(f"  localdatetime {str_val(v)}"),
            Err(e) => println(f"  localdatetime ! {err_text(e)}"),
        }
    }
    if c.has_flag("dt") {
        show_prop("datetime", getattr(lib, m, "datetime"));
    }
    if c.valid_kind() {
        show_prop("is_valid", getattr(lib, m, "is_valid"));
    }
    if c.has_flag("rte") or c.has_flag("r00") {
        show_prop("waypoint_list", getattr(lib, m, "waypoint_list"));
    }
    if c.has_flag("xdr") {
        let n = m.data.len() / 4;
        show_prop("num_transducers", Ok(Val.Int(n)));
        for i in 0..n {
            show_prop("transducer", Ok(transducer(m, i)));
        }
    }
    if c.has_flag("seatalk") {
        show_prop("command_name", getattr(lib, m, "command_name"));
    }
    if c.has_flag("ubx03") {
        show_prop("satellite_list", getattr(lib, m, "satellite_list"));
    }
}

fn job_parse(lib: ref Lib, name: ref String, check: bool) {
    let mut n = 0;
    for line in lines_of(name) {
        n += 1;
        match parse_sentence(lib, line, check) {
            Ok(m) => {
                println(f"{n} {repr_msg(lib, m)}");
                if not check {
                    show_props(lib, m);
                }
            }
            Err(e) => println(f"{n} ! {err_text(e)}"),
        }
    }
}

fn job_attrs(lib: ref Lib, name: ref String, names: ref Vec[String]) {
    let mut n = 0;
    for line in lines_of(name) {
        n += 1;
        match parse_sentence(lib, line, false) {
            Ok(m) => {
                let mut parts: Vec[String] = Vec.new();
                for a in names.iter() {
                    match getattr(lib, m, a) {
                        Ok(v) => parts.push(f"{a}={repr_val(v)}"),
                        Err(e) => parts.push(f"{a}!{err_text(e)}"),
                    }
                }
                println(f"{n} {join(parts, " ")}");
            }
            Err(e) => println(f"{n} ! {err_text(e)}"),
        }
    }
}

// ------------------------------------------------------------ NMEAStreamReader

struct Reader {
    errors: String,
    buffer: String,
}

fn new_reader(errors: ref String) -> Result[Reader, PyErr] {
    if errors != "raise" and errors != "yield" and errors != "ignore" {
        return Err(perr("ValueError", f"errors must be one of ('raise', 'yield', 'ignore') (was: {repr_str(errors)})"));
    }
    Ok(Reader { errors: errors.clone(), buffer: String.new() })
}

// NMEAStreamReader.next(data), run to the end: what it yields (a
// sentence, or a ParseError in 'yield' mode) and what it raises.
fn reader_next(lib: ref Lib, r: mut ref Reader, data: ref String) -> (Vec[Result[Msg, PyErr]], Option[PyErr]) {
    let mut lines = split_on(f"{r.buffer}{data}", '\n');
    r.buffer = lines.pop().unwrap_or(String.new());
    let mut got: Vec[Result[Msg, PyErr]] = Vec.new();
    for line in lines {
        match parse_sentence(lib, line, false) {
            Ok(m) => got.push(Ok(m)),
            Err(e) => {
                if not is_parse_error(e) or r.errors == "raise" {
                    return (got, Some(e));
                }
                if r.errors == "yield" {
                    got.push(Err(e));
                }
            }
        }
    }
    (got, None)
}

fn show_batch(lib: ref Lib, label: ref String, got: ref Vec[Result[Msg, PyErr]], raised: ref Option[PyErr]) {
    println(f"{label}: {got.len()}");
    for x in got.iter() {
        match x {
            Ok(m) => println(f"  {repr_msg(lib, m)}"),
            Err(e) => println(f"  error {err_text(e)}"),
        }
    }
    if let Some(e) = raised {
        println(f"  raised {err_text(e)}");
    }
}

fn job_stream(lib: ref Lib, name: ref String, mode: ref String, size: i64) {
    let text = chars_of(read_text(name));
    let mut r = match new_reader(mode) {
        Ok(r) => r,
        Err(e) => {
            println(f"! {err_text(e)}");
            return;
        }
    };
    let mut k = 0;
    while k < text.len() {
        let piece = str_of(slice_chars(text, k, k + size));
        let (got, raised) = reader_next(lib, mut r, piece);
        show_batch(lib, f"chunk {k / size}", got, raised);
        k += size;
    }
    println(f"buffer {repr_str(r.buffer)}");
}

fn job_streamfile(lib: ref Lib, name: ref String, mode: ref String, calls: i64) {
    let mut f = open_text(name);
    let mut r = match new_reader(mode) {
        Ok(r) => r,
        Err(e) => {
            println(f"! {err_text(e)}");
            return;
        }
    };
    for i in 0..calls {
        let data = f.readline();
        let (got, raised) = reader_next(lib, mut r, data);
        show_batch(lib, f"call {i}", got, raised);
    }
}

// ------------------------------------------------------------ NMEAFile

fn job_file(lib: ref Lib, name: ref String) {
    let f = open_text(name);
    for line in f.lines.iter() {
        match parse_sentence(lib, line, false) {
            Ok(m) => println(repr_msg(lib, m)),
            Err(e) => {
                println(f"! {err_text(e)}");
                return;
            }
        }
    }
}

fn job_fileread(lib: ref Lib, name: ref String) {
    let f = open_text(name);
    let mut ms: Vec[Msg] = Vec.new();
    for line in f.lines.iter() {
        match parse_sentence(lib, line, false) {
            Ok(m) => ms.push(m),
            Err(e) => {
                println(f"! {err_text(e)}");
                return;
            }
        }
    }
    println(f"{ms.len()} sentences");
    for m in ms.iter() {
        println(render_str(lib, m));
    }
}

fn job_filelines(lib: ref Lib, name: ref String, n: i64) {
    let mut f = open_text(name);
    for i in 0..n {
        let line = f.readline();
        match parse_sentence(lib, line, false) {
            Ok(m) => println(f"{i} {repr_msg(lib, m)}"),
            Err(e) => println(f"{i} ! {err_text(e)}"),
        }
    }
}

// ------------------------------------------------------------ edit and build

fn value_of(text: ref String) -> Result[Val, PyErr] {
    let body = substr(text, 2, char_len(text));
    if text.starts_with("i:") {
        return match py_int_s(body) {
            Some(n) => Ok(Val.Int(n)),
            None => Err(perr("ValueError", f"invalid literal for int() with base 10: {repr_str(body)}")),
        };
    }
    if text.starts_with("f:") {
        return match py_float_s(body) {
            Some(x) => Ok(Val.Float(x)),
            None => Err(perr("ValueError", f"could not convert string to float: {repr_str(body)}")),
        };
    }
    if text.starts_with("d:") {
        return match parse_dec(body) {
            Some(d) => Ok(Val.Dec(d)),
            None => Err(perr("InvalidOperation", "[<class 'decimal.ConversionSyntax'>]".to_string())),
        };
    }
    Ok(Val.Str(text.clone()))
}

fn job_edit(lib: ref Lib, name: ref String, n: i64, assigns: ref Vec[String]) {
    let line = lines_of(name)[n - 1].clone();
    let mut m = match parse_sentence(lib, line, false) {
        Ok(m) => m,
        Err(e) => {
            println(f"! {err_text(e)}");
            return;
        }
    };
    println(f"before {repr_msg(lib, m)}");
    let mut names: Vec[String] = Vec.new();
    for a in assigns.iter() {
        let eq = match a.find("=") {
            Some(i) => i,
            None => continue,
        };
        let k = a[0..eq].to_string();
        let v = a[(eq + 1)..].to_string();
        let val = if k == "waypoint_list" { Val.List(split_on(v, '|')) } else { value_of(v).unwrap_or(Val.Str(v.clone())) };
        names.push(k.clone());
        let shown = repr_val(val);
        match setattr(lib, mut m, k, val) {
            Ok(()) => println(f"set {k} {shown}"),
            Err(e) => println(f"set {k} ! {err_text(e)}"),
        }
    }
    println(f"after {repr_msg(lib, m)}");
    for k in names.iter() {
        match getattr(lib, m, k) {
            Ok(v) => println(f"  {k} {repr_val(v)}"),
            Err(e) => println(f"  {k} ! {err_text(e)}"),
        }
    }
    println(f"  str {render_str(lib, m)}");
}

fn job_build(lib: ref Lib, kind: ref String, args: ref Vec[String]) {
    let made: Result[Msg, PyErr] = if kind == "build" {
        let cls = lib.find("T", args[0]);
        if cls < 0 {
            Err(perr("AttributeError", f"module 'pynmea2' has no attribute {repr_str(args[0])}"))
        } else {
            Ok(talker_msg(cls, args[1], args[0], split_on(args[2], ',')))
        }
    } else if kind == "buildp" {
        make_proprietary(lib, args[0], split_on(args[1], ','))
    } else {
        Ok(query_msg(lib, args[0], args[1], args[2]))
    };
    match made {
        Ok(m) => {
            println(repr_msg(lib, m));
            println(f"  str {render_str(lib, m)}");
        }
        Err(e) => println(f"! {err_text(e)}"),
    }
}

fn job_render(lib: ref Lib, name: ref String, n: i64) {
    let line = lines_of(name)[n - 1].clone();
    let m = match parse_sentence(lib, line, false) {
        Ok(m) => m,
        Err(e) => {
            println(f"! {err_text(e)}");
            return;
        }
    };
    let opts: Vec[(bool, bool, Str)] = [(true, true, ""), (false, true, ""), (true, false, ""), (false, false, ""),
        (true, true, "\r\n"), (true, true, "\n"), (false, false, ";")];
    for (cs, dollar, nl) in opts {
        println(repr_str(render(lib, m, cs, dollar, nl.to_string())));
    }
}

// ------------------------------------------------------------ programs

fn parsed(lib: ref Lib, name: ref String) -> (Vec[Msg], i64) {
    let mut out: Vec[Msg] = Vec.new();
    let mut errors = 0;
    for line in lines_of(name) {
        match parse_sentence(lib, line, false) {
            Ok(m) => out.push(m),
            Err(_) => errors += 1,
        }
    }
    (out, errors)
}

fn cls_name(lib: ref Lib, m: ref Msg) -> String {
    cls_of(lib, m).name.clone()
}

fn get_or_none(lib: ref Lib, m: ref Msg, name: Str) -> Val {
    getattr(lib, m, name).unwrap_or(Val.None)
}

fn as_f64(v: ref Val) -> f64 {
    match v {
        Val.Float(x) => *x,
        Val.Int(n) => *n as f64,
        Val.Dec(d) => dec_float(d),
        _ => 0.0,
    }
}

fn radians(x: f64) -> f64 {
    x * (3.141592653589793 / 180.0)
}

fn haversine_nm(a: (f64, f64), b: (f64, f64)) -> f64 {
    let la1 = radians(a.0);
    let lo1 = radians(a.1);
    let la2 = radians(b.0);
    let lo2 = radians(b.1);
    let s1 = ((la2 - la1) / 2.0).sin();
    let s2 = ((lo2 - lo1) / 2.0).sin();
    let h = s1 * s1 + la1.cos() * la2.cos() * s2 * s2;
    2.0 * 3440.065 * h.sqrt().asin()
}

#[derive(Clone)]
struct Fix {
    when: Dt,
    lat: f64,
    lon: f64,
    sog: f64,
}

fn rmc_fix(lib: ref Lib, m: ref Msg) -> Result[Fix, PyErr] {
    let when = match getattr(lib, m, "datetime")? {
        Val.Dt(t) => t,
        _ => return Err(perr("TypeError", "datetime".to_string())),
    };
    let lat = as_f64(getattr(lib, m, "latitude")?);
    let lon = as_f64(getattr(lib, m, "longitude")?);
    let sog = as_f64(getattr(lib, m, "spd_over_grnd")?);
    Ok(Fix { when: when, lat: lat, lon: lon, sog: sog })
}

fn is_valid(lib: ref Lib, m: ref Msg) -> bool {
    truthy(get_or_none(lib, m, "is_valid"))
}

fn dec_of(v: ref Val) -> Option[Dec] {
    match v {
        Val.Dec(d) => Some(d.clone()),
        _ => None,
    }
}

// min() and max() of decimals: the first of equal values is kept.
fn dec_min_max(xs: ref Vec[Dec]) -> (Dec, Dec) {
    let mut lo = xs[0].clone();
    let mut hi = xs[0].clone();
    for x in xs.iter() {
        if dec_cmp(x, lo) < 0 {
            lo = x.clone();
        }
        if dec_cmp(x, hi) > 0 {
            hi = x.clone();
        }
    }
    (lo, hi)
}

fn route_of(lib: ref Lib, ms: ref Vec[Msg]) -> Vec[String] {
    let mut route: Vec[String] = Vec.new();
    for m in ms.iter() {
        if cls_name(lib, m) == "RTE" {
            if val_is(get_or_none(lib, m, "sen_num"), "1") {
                route = Vec.new();
                route.push(str_val(get_or_none(lib, m, "active_route_id")));
            }
            if let Val.List(ws) = get_or_none(lib, m, "waypoint_list") {
                for w in ws.iter() {
                    route.push(w.clone());
                }
            }
        }
    }
    route
}

fn wpl_pos(lib: ref Lib, m: ref Msg) -> (f64, f64) {
    let la = dm_to_sd(get_or_none(lib, m, "lat")).unwrap_or(0.0);
    let lo = dm_to_sd(get_or_none(lib, m, "lon")).unwrap_or(0.0);
    let sa = if val_is(get_or_none(lib, m, "lat_dir"), "N") { 1.0 } else { -1.0 };
    let so = if val_is(get_or_none(lib, m, "lon_dir"), "E") { 1.0 } else { -1.0 };
    (la * sa, lo * so)
}

fn job_report(lib: ref Lib, name: ref String) {
    let (ms, errors) = parsed(lib, name);
    let mut counts: Map[String, i64] = Map.new();
    for m in ms.iter() {
        let k = cls_name(lib, m);
        let c = counts.get(k).unwrap_or(0);
        counts.insert(k, c + 1);
    }
    println(f"sentences {ms.len()}, errors {errors}");
    let mut keys: Vec[String] = Vec.new();
    for (k, _) in counts.iter() {
        keys.push(k.clone());
    }
    keys.sort();
    let mut parts: Vec[String] = Vec.new();
    for k in keys.iter() {
        parts.push(f"{k}:{counts.get(k).unwrap_or(0)}");
    }
    println(f"types {join(parts, " ")}");
    let mut fixes: Vec[Fix] = Vec.new();
    for m in ms.iter() {
        if cls_name(lib, m) == "RMC" and is_valid(lib, m) {
            match rmc_fix(lib, m) {
                Ok(f) => fixes.push(f),
                Err(e) => println(f"rmc skipped: {err_text(e)}"),
            }
        }
    }
    if fixes.len() > 0 {
        let first = fixes[0].clone();
        let last = fixes[fixes.len() - 1].clone();
        println(f"first fix {dt_iso(first.when, "T")}");
        println(f"last fix {dt_iso(last.when, "T")}");
        let mut dist = 0.0;
        let mut i = 1;
        while i < fixes.len() {
            dist += haversine_nm((fixes[i - 1].lat, fixes[i - 1].lon), (fixes[i].lat, fixes[i].lon));
            i += 1;
        }
        let mut mx = fixes[0].sog;
        let mut sum = 0.0;
        for f in fixes.iter() {
            if f.sog > mx {
                mx = f.sog;
            }
            sum += f.sog;
        }
        let mean = sum / (fixes.len() as f64);
        println(f"fixes {fixes.len()}, distance {dist:.3} nm, max sog {mx:.2} kn, mean sog {mean:.2} kn");
        println(f"from {first.lat:.5},{first.lon:.5} to {last.lat:.5},{last.lon:.5}");
    }
    let mut quals: Map[String, i64] = Map.new();
    for m in ms.iter() {
        if cls_name(lib, m) == "GGA" {
            let k = repr_val(get_or_none(lib, m, "gps_qual"));
            let c = quals.get(k).unwrap_or(0);
            quals.insert(k, c + 1);
        }
    }
    if quals.len() > 0 {
        let mut qk: Vec[String] = Vec.new();
        for (k, _) in quals.iter() {
            qk.push(k.clone());
        }
        qk.sort();
        let mut qs: Vec[String] = Vec.new();
        for k in qk.iter() {
            qs.push(f"{k}:{quals.get(k).unwrap_or(0)}");
        }
        println(f"gga quality {join(qs, " ")}");
    }
    let mut depths: Vec[Dec] = Vec.new();
    let mut temps: Vec[Dec] = Vec.new();
    let mut winds: Vec[Dec] = Vec.new();
    for m in ms.iter() {
        let c = cls_name(lib, m);
        if c == "DPT" {
            if let Some(d) = dec_of(get_or_none(lib, m, "depth")) {
                depths.push(d);
            }
        } else if c == "MTW" {
            if let Some(d) = dec_of(get_or_none(lib, m, "temperature")) {
                temps.push(d);
            }
        } else if c == "MWV" and val_is(get_or_none(lib, m, "reference"), "T") {
            if let Some(d) = dec_of(get_or_none(lib, m, "wind_speed")) {
                winds.push(d);
            }
        }
    }
    if depths.len() > 0 {
        let (lo, hi) = dec_min_max(depths);
        println(f"depth min {dec_str(lo)} max {dec_str(hi)} over {depths.len()}");
    }
    if temps.len() > 0 {
        let (lo, hi) = dec_min_max(temps);
        println(f"water {dec_str(lo)}..{dec_str(hi)} C");
    }
    if winds.len() > 0 {
        let (_, hi) = dec_min_max(winds);
        let mut sum = 0.0;
        for w in winds.iter() {
            sum += dec_float(w);
        }
        let mean = sum / (winds.len() as f64);
        println(f"true wind max {dec_str(hi)} kn, mean {mean:.1} kn");
    }
    for m in ms.iter() {
        let c = cls_name(lib, m);
        if c == "ZDA" {
            match getattr(lib, m, "localdatetime") {
                Ok(v) => println(f"zda {str_val(v)}"),
                Err(e) => println(f"zda ! {err_text(e)}"),
            }
        } else if c == "TXT" {
            println(f"text {str_val(get_or_none(lib, m, "text"))}");
        } else if c == "XDR" {
            for i in 0..(m.data.len() / 4) {
                let t = m.data[(i * 4)..(i * 4 + 4)].to_vec();
                println(f"sensor {t[3]} {t[1]} {t[2]}");
            }
        }
    }
    let route = route_of(lib, ms);
    if route.len() > 0 {
        println(f"route {route[0]}: {join(route[1..].to_vec(), " ")}");
    }
    for m in ms.iter() {
        if cls_name(lib, m) == "WPL" {
            let (la, lo) = wpl_pos(lib, m);
            println(f"waypoint {str_val(get_or_none(lib, m, "waypoint_id"))} {la:.5} {lo:.5}");
        }
    }
}

fn job_gpx(lib: ref Lib, name: ref String, out: ref String) {
    let (ms, _) = parsed(lib, name);
    let mut wnames: Vec[String] = Vec.new();
    let mut wpos: Vec[(f64, f64)] = Vec.new();
    let mut lines: Vec[String] = Vec.new();
    lines.push("<?xml version=\"1.0\" encoding=\"UTF-8\"?>".to_string());
    lines.push("<gpx version=\"1.1\" creator=\"mini_nmea\">".to_string());
    for m in ms.iter() {
        if cls_name(lib, m) == "WPL" {
            let (la, lo) = wpl_pos(lib, m);
            let id = str_val(get_or_none(lib, m, "waypoint_id"));
            let mut found = false;
            for i in 0..wnames.len() {
                if wnames[i] == id {
                    wpos[i] = (la, lo);
                    found = true;
                }
            }
            if not found {
                wnames.push(id.clone());
                wpos.push((la, lo));
            }
            lines.push(f"  <wpt lat=\"{la:.6}\" lon=\"{lo:.6}\"><name>{id}</name></wpt>");
        }
    }
    let route = route_of(lib, ms);
    if route.len() > 0 {
        lines.push(f"  <rte><name>{route[0]}</name>");
        for w in route[1..].iter() {
            let mut at = -1;
            for i in 0..wnames.len() {
                if wnames[i] == w {
                    at = i;
                }
            }
            if at >= 0 {
                lines.push(f"    <rtept lat=\"{wpos[at].0:.6}\" lon=\"{wpos[at].1:.6}\"><name>{w}</name></rtept>");
            } else {
                lines.push(f"    <!-- {w}: no position -->");
            }
        }
        lines.push("  </rte>".to_string());
    }
    lines.push(f"  <trk><name>{name}</name><trkseg>");
    let mut alt: Map[String, Val] = Map.new();
    for m in ms.iter() {
        if cls_name(lib, m) == "GGA" and truthy(get_or_none(lib, m, "gps_qual")) {
            alt.insert(repr_val(get_or_none(lib, m, "timestamp")), get_or_none(lib, m, "altitude"));
        }
    }
    for m in ms.iter() {
        if cls_name(lib, m) == "RMC" and is_valid(lib, m) {
            let fix = match rmc_fix(lib, m) {
                Ok(f) => f,
                Err(_) => continue,
            };
            let t = dt_iso(fix.when, "T").replace("+00:00", "Z");
            let ele_s = match alt.get(repr_val(get_or_none(lib, m, "timestamp"))) {
                Some(v) => match v {
                    Val.None => String.new(),
                    _ => f"<ele>{repr_val(v)}</ele>",
                },
                None => String.new(),
            };
            let course = repr_val(get_or_none(lib, m, "true_course"));
            let speed = fix.sog * 0.514444;
            lines.push(f"    <trkpt lat=\"{fix.lat:.6}\" lon=\"{fix.lon:.6}\">{ele_s}<time>{t}</time><course>{course}</course><speed>{speed:.3}</speed></trkpt>");
        }
    }
    lines.push("  </trkseg></trk>".to_string());
    lines.push("</gpx>".to_string());
    let text = f"{join(lines, "\n")}\n";
    if let Err(e) = fs.write(f"data/out/{out}", text.clone()) {
        println(f"cannot write {out}: {e}");
        return;
    }
    println(f"wrote {out}, {utf8_len(text)} bytes");
    print(text);
}

fn job_mux(lib: ref Lib, out: ref String, talker: ref String, types: ref String, names: ref Vec[String]) {
    let keep = split_on(types, ',');
    let mut rendered = String.new();
    let mut kept = 0;
    let mut dropped = 0;
    let mut errors = 0;
    for name in names.iter() {
        for line in lines_of(name) {
            let mut m = match parse_sentence(lib, line, false) {
                Ok(m) => m,
                Err(_) => {
                    errors += 1;
                    continue;
                }
            };
            let st = m.inst_str("sentence_type");
            let mut wanted = false;
            for k in keep.iter() {
                if *k == st {
                    wanted = true;
                }
            }
            if m.kind == TALKER and wanted {
                m.inst_set("talker".to_string(), Val.Str(talker.clone()));
                rendered.push_str(render(lib, m, true, true, "\r\n".to_string()));
                kept += 1;
            } else {
                dropped += 1;
            }
        }
    }
    let p = f"data/out/{out}";
    if let Err(e) = fs.write(p.clone(), rendered.clone()) {
        println(f"cannot write {p}: {e}");
        return;
    }
    println(f"kept {kept}, dropped {dropped}, errors {errors}, {utf8_len(rendered)} bytes");
    let back = split_str(fs.read_to_string(p).unwrap_or(String.new()), "\r\n");
    let mut i = 0;
    while i + 1 < back.len() {
        match parse_sentence(lib, back[i], true) {
            Ok(m) => {
                if i % 9 == 0 or i == back.len() - 2 {
                    println(f"{i} {back[i]} {repr_val(get_or_none(lib, m, "timestamp"))}");
                }
            }
            Err(e) => println(f"{i} ! {err_text(e)}"),
        }
        i += 1;
    }
}

fn job_alarms(lib: ref Lib, names: ref Vec[String]) {
    let mut clock = "--:--:--".to_string();
    let mut no_fix = false;
    for name in names.iter() {
        let mut n = 0;
        for line in lines_of(name) {
            n += 1;
            let m = match parse_sentence(lib, line, false) {
                Ok(m) => m,
                Err(e) => {
                    println(f"{clock} {name}:{n} unreadable ({e.kind})");
                    continue;
                }
            };
            let c = cls_name(lib, m);
            if c == "RMC" {
                if let Val.Time(t) = get_or_none(lib, m, "timestamp") {
                    clock = f"{t.h:02}:{t.m:02}:{t.s:02}";
                }
            }
            if c == "GGA" {
                let q = get_or_none(lib, m, "gps_qual");
                let zero = match q {
                    Val.Int(x) => x == 0,
                    _ => false,
                };
                if zero and not no_fix {
                    no_fix = true;
                    println(f"{clock} gps fix lost ({str_val(get_or_none(lib, m, "num_sats"))} sats)");
                } else if truthy(q) and no_fix {
                    no_fix = false;
                    println(f"{clock} gps fix back, quality {repr_val(q)}");
                }
            } else if c == "GSA" {
                match getattr(lib, m, "is_valid") {
                    Ok(v) => {
                        if not truthy(v) {
                            println(f"{clock} gsa says no 3d fix (mode {repr_val(get_or_none(lib, m, "mode_fix_type"))})");
                        }
                    }
                    Err(e) => println(f"{clock} gsa mode unreadable: {e.msg}"),
                }
            } else if c == "DPT" {
                if let Some(d) = dec_of(get_or_none(lib, m, "depth")) {
                    if dec_cmp(d, parse_dec("6.0".to_string()).unwrap()) < 0 {
                        let off = dec_of(get_or_none(lib, m, "offset")).unwrap_or(dec_of_int(0));
                        println(f"{clock} shallow water: {dec_str(dec_sub(d, off))} m under the keel");
                    }
                }
            } else if c == "MWV" {
                if val_is(get_or_none(lib, m, "reference"), "T") {
                    if let Some(w) = dec_of(get_or_none(lib, m, "wind_speed")) {
                        if dec_cmp(w, dec_of_int(18)) > 0 {
                            println(f"{clock} true wind {dec_str(w)} kn");
                        }
                    }
                }
            } else if c == "XTE" {
                let d = py_float_s(str_val(get_or_none(lib, m, "cross_track_err_dist"))).unwrap_or(0.0);
                if d > 0.04 {
                    println(f"{clock} off track {d:.2} nm, steer {str_val(get_or_none(lib, m, "correction_dir"))}");
                }
            } else if c == "AAM" {
                if val_is(get_or_none(lib, m, "arrival_circ_entered"), "A") {
                    println(f"{clock} arrived at {str_val(get_or_none(lib, m, "waypoint_id"))}");
                }
            } else if c == "ALK" {
                println(f"{clock} seatalk {str_val(get_or_none(lib, m, "cmd"))}: {str_val(get_or_none(lib, m, "command_name"))}");
            } else if c == "RPM" {
                if not is_valid(lib, m) {
                    println(f"{clock} rpm sensor {str_val(get_or_none(lib, m, "source"))}{repr_val(get_or_none(lib, m, "engine_no"))} not valid");
                }
            } else if c == "TTM" {
                if let Some(d) = dec_of(get_or_none(lib, m, "dist_cpa")) {
                    if dec_cmp(d, dec_of_int(2)) < 0 {
                        println(f"{clock} target {str_val(get_or_none(lib, m, "name"))} {repr_val(get_or_none(lib, m, "target_number"))} CPA {dec_str(d)} nm in {str_val(get_or_none(lib, m, "time_cpa"))} min");
                    }
                }
            } else if c == "GRME" {
                if let Some(h) = dec_of(get_or_none(lib, m, "hpe")) {
                    if dec_cmp(h, dec_of_int(10)) > 0 {
                        println(f"{clock} garmin hpe {dec_str(h)} {str_val(get_or_none(lib, m, "hpe_unit"))}");
                    }
                }
            }
        }
    }
}

fn num_arg(s: ref String) -> i64 {
    py_int_s(s).unwrap_or(0)
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    let lib = load_lib();
    for raw in split_on(read_text("jobs.txt".to_string()), '\n') {
        let j = split_ws(raw);
        if j.len() == 0 {
            continue;
        }
        println(f"== {join(j, " ")}");
        let k = j[0].clone();
        if k == "parse" {
            job_parse(lib, j[1], false);
        } else if k == "strict" {
            job_parse(lib, j[1], true);
        } else if k == "attrs" {
            job_attrs(lib, j[1], split_on(j[2], ','));
        } else if k == "stream" {
            job_stream(lib, j[1], j[2], num_arg(j[3]));
        } else if k == "streamfile" {
            job_streamfile(lib, j[1], j[2], num_arg(j[3]));
        } else if k == "file" {
            job_file(lib, j[1]);
        } else if k == "fileread" {
            job_fileread(lib, j[1]);
        } else if k == "filelines" or k == "filenext" {
            job_filelines(lib, j[1], num_arg(j[2]));
        } else if k == "edit" {
            job_edit(lib, j[1], num_arg(j[2]), j[3..].to_vec());
        } else if k == "build" or k == "buildp" or k == "query" {
            job_build(lib, k, j[1..].to_vec());
        } else if k == "render" {
            job_render(lib, j[1], num_arg(j[2]));
        } else if k == "report" {
            job_report(lib, j[1]);
        } else if k == "gpx" {
            job_gpx(lib, j[1], j[2]);
        } else if k == "mux" {
            job_mux(lib, j[1], j[2], j[3], j[4..].to_vec());
        } else if k == "alarms" {
            job_alarms(lib, j[1..].to_vec());
        }
    }
}
// ------------------------------------------------------------ classes

// pynmea2's sentence classes, one per line: name | base (T for
// TalkerSentence, P for a manufacturer class under ProprietarySentence,
// else the manufacturer class it is registered with) | mixins | the
// properties the class has | fields as name[:converter], in order.
fn class_lines() -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    v.push("AAM|T|||arrival_circ_entered;perp_passed;circle_rad;circle_rad_unit;waypoint_id".to_string());
    v.push("ALK|T|seatalk|command_name|cmd;data_byte1;data_byte2;data_byte3;data_byte4;data_byte5;data_byte6;data_byte7;data_byte8;data_byte9".to_string());
    v.push("ALM|T|||total_num_msgs;msg_num;sat_prn_num;gps_week_num;sv_health;eccentricity;alamanac_ref_time;inc_angle;rate_right_asc;root_semi_major_axis;arg_perigee;lat_asc_node;mean_anom;f0_clock_param;f1_clock_param".to_string());
    v.push("APA|T|||status_gen;status_cycle_lock;cross_track_err_mag;dir_steer;cross_track_unit;arr_circle_entered;perp_passed;bearing_to_dest;bearing_type;dest_waypoint_id".to_string());
    v.push("APB|T|||status_gen;status_cycle_lock;cross_track_err_mag;dir_steer;cross_track_unit;arr_circle_entered;perp_passed;bearing_to_dest;bearing_type;dest_waypoint_id;bearing_pres_dest;bearing_pres_dest_type;heading_to_dest;heading_to_dest_type".to_string());
    v.push("BEC|T|||timestamp:ts;waypoint_lat;waypoint_lat_dir;waypoint_lon;waypoint_lon_dir;bearing_true;bearing_true_sym;bearing_mag;bearing_mag_sym;nautical_miles;nautical_miles_sym;waypoint_id;faa_mode".to_string());
    v.push("BOD|T|||bearing_t:dec;bearing_t_type;bearing_mag:dec;bearing_mag_type;dest;start".to_string());
    v.push("BWC|T|||timestamp:ts;lat_next;lat_next_direction;lon_next;lon_next_direction;true_track;true_track_sym;mag_track;mag_sym;range_next;range_unit;waypoint_name".to_string());
    v.push("BWR|T|||timestamp:ts;lat_next;lat_next_direction;lon_next;lon_next_direction;true_track;true_track_sym;mag_track;mag_sym;range_next;range_unit;waypoint_name".to_string());
    v.push("BWW|T|||bearing_deg_true;bearing_deg_true_sym;bearing_deg_mag;bearing_deg_mag_sym;waypoint_id_dest;waypoint_id_orig".to_string());
    v.push("DBS|T|||depth_feet:dec;feets;depth_meter:dec;meters;depth_ fathoms:dec;fathoms".to_string());
    v.push("DBT|T|||depth_feet:dec;unit_feet;depth_meters:dec;unit_meters;depth_fathoms:dec;unit_fathoms".to_string());
    v.push("DPT|T|||depth:dec;offset:dec;range:dec".to_string());
