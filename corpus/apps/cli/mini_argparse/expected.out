# pkg: the main parser
$ pkg --help
  |usage: pkg [-h] [-V] [-v] [-q] [-C DIR] [--color {auto,always,never}]
  |           [--index-url URL] [--timeout TIMEOUT]
  |           COMMAND ...
  |
  |A small package manager. It installs, removes and lists packages from a
  |configured index, and keeps a lock file next to the project.
  |
  |options:
  |  -h, --help            show this help message and exit
  |  -V, --version         show program's version number and exit
  |  -v, --verbose         print more output; repeat for even more (-vv)
  |  -q, --quiet           print only errors
  |  -C, --directory DIR   run as if started in DIR
  |  --color {auto,always,never}
  |                        when to color the output (default: auto)
  |  --index-url URL       base URL of the package index
  |  --timeout TIMEOUT     network timeout in seconds
  |
  |commands:
  |  COMMAND
  |    install (i, add)    install packages
  |    remove (rm)         remove packages
  |    list                list installed packages
  |    search              search the index
  |    config              read and write settings
  |    run                 run a script from the project file
  |
  |Run "pkg COMMAND --help" for the options of one command.
  exit 0
$ pkg -V
  |pkg 2.4.1
  exit 0
$ pkg --version
  |pkg 2.4.1
  exit 0
