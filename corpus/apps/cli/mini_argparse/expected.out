$ pkg install --help
  |usage: pkg install [-h] [-U] [-r FILE] [--no-deps] [-j JOBS] [--target TARGET]
  |                   [--user | --system]
  |                   PACKAGE [PACKAGE ...]
  |
  |Install packages and their dependencies.
  |
  |positional arguments:
  |  PACKAGE               a package name, optionally with a version such as
  |                        requests==2.31 or a range such as 'flask>=3,<4'
  |
  |options:
  |  -h, --help            show this help message and exit
  |  -U, --upgrade         upgrade packages that are already installed
  |  -r, --requirement FILE
  |                        install from the given requirements file; may be given
  |                        more than once
  |  --no-deps             don't install dependencies
  |  -j, --jobs JOBS       number of parallel downloads (default: 4)
  |  --target TARGET       install into this directory instead of the environment
  |  --user                install for the current user
  |  --system              install for all users
  exit 0
