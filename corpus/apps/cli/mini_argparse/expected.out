# backup: one parser with a required group
$ backup --help
  |usage: backup [-h] (--full | --incremental | --since DATE) [-l {0,1,3,9,19}]
  |              [--dedupe] [-x GLOB] [--keep N] [-n] [--rate MIN MAX]
  |              [--notify [EMAIL]] [--tz-offset HOURS]
  |              source dest
  |
  |Copy a directory tree into a dated, compressed archive.
  |
  |positional arguments:
  |  source                directory to back up
  |  dest                  where to write the archive
  |
  |options:
  |  -h, --help            show this help message and exit
  |  --full                copy everything
  |  --incremental         copy what changed since the last backup
  |  --since DATE          copy what changed since DATE
  |  -x, --exclude GLOB    skip files matching GLOB
  |  --keep N              keep the newest N archives and delete the older ones
  |  -n, --dry-run         show what would be copied
  |  --rate MIN MAX        limit the bandwidth to between MIN and MAX KiB/s
  |  --notify [EMAIL]      mail a report when done (to root@localhost if no
  |                        address is given)
  |  --tz-offset HOURS     hours to add to file times
  |
  |compression:
  |  Archives are compressed with zstd. Level 0 stores the files uncompressed.
  |
  |  -l, --level {0,1,3,9,19}
  |                        zstd level (default: 3)
  |  --dedupe              store identical files once
  |
  |examples:
  |  backup --full /home /mnt/disk
  |  backup --since 2024-01-01 --exclude '*.tmp' /etc /mnt/disk
  exit 0
$ backup --full /home /mnt/disk
  Namespace(source='/home', dest='/mnt/disk', full=True, incremental=False, since=None, level=3, dedupe=False, exclude=None, keep=7, dry_run=False, rate=None, notify=None, tz_offset=0)
$ backup --incremental -n -x '*.tmp' -x .cache /home /mnt/disk
  Namespace(source='/home', dest='/mnt/disk', full=False, incremental=True, since=None, level=3, dedupe=False, exclude=['*.tmp', '.cache'], keep=7, dry_run=True, rate=None, notify=None, tz_offset=0)
$ backup --since 2024-01-01 --level 19 --dedupe /etc /mnt/disk
