}

fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data")?;
    put("data/cases.txt", file_0())?;
    Ok(())
}

// ------------------------------------------------------------ the runs

fn read_file(path: Str) -> Result[String, String] {
    match fs.read_to_string(path.to_string()) {
        Ok(t) => Ok(t),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

fn print_block(text: Str, mark: Str) {
    let ls = lines_of(text);
    for i in 0..ls.len() {
        println(f"  {mark}{ls[i]}");
    }
}

fn run() -> Result[(), String] {
    write_data()?;
    let cases = lines_of(read_file("data/cases.txt")?);
    for c in 0..cases.len() {
        let line = cases[c].clone();
        if line.len() == 0 {
            continue;
        }
        if first_byte(line) == b'#' {
            println(line);
            continue;
        }
        let argv = shlex_split(line);
        let cli = if argv[0] == "pkg" { pkg() } else { backup() };
        let mut args: Vec[String] = Vec.new();
        for i in 1..argv.len() {
            args.push(argv[i].clone());
        }
        println(f"$ {line}");
        match cli.parsers[0].parse_args(cli, args) {
            Ok(ns) => println(f"  {ns.repr()}"),
            Err(e) => {
                print_block(e.out, "|");
                print_block(e.err, "!");
                println(f"  exit {e.status}");
            }
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_argparse: {e}");
    }
}
