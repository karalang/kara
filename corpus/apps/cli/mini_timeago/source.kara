// mini_timeago: a port of timeago 1.0.16 (MIT, hustcc), the "3 hours
// ago" formatter, run as the labels of a team's activity feed (commits,
// deploys, comments, scheduled jobs) in each of the library's 44 locales.
// Every op of data/jobs.tsv is a call on timeago.format() or
// timeago.parser.parse(). See README.md.

// ------------------------------------------------------------ chars

fn to_chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn text(raw: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut s = String.new();
    let mut k = lo;
    while k < hi {
        s.push(raw[k]);
        k += 1;
    }
    s
}

fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn chr(n: i64) -> char {
    match char.try_from(n) {
        Ok(c) => c,
        Err(_) => '?',
    }
}

fn hex_digits(n: i64, width: i64) -> String {
    let d: Vec[char] = "0123456789abcdef".chars().collect();
    let mut out = String.new();
    let mut k = width;
    while k > 0 {
        k -= 1;
        out.push(d[(n >> (4 * k)) & 15]);
    }
    out
}

fn hex_val(c: char) -> i64 {
    if is_digit(c) {
        c as i64 - 48
    } else if c >= 'a' and c <= 'f' {
        c as i64 - 87
    } else {
        c as i64 - 55
    }
}

fn hex_int(s: ref String) -> i64 {
    let mut v = 0;
    for c in s.chars() {
        v = v * 16 + hex_val(c);
    }
    v
}

fn hex_text(s: ref String) -> String {
    let cs = to_chars(s);
    let mut b: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < cs.len() {
        b.push((hex_val(cs[i]) * 16 + hex_val(cs[i + 1])) as u8);
        i += 2;
    }
    match String.from_utf8(b) {
        Ok(s) => s,
        Err(_) => String.new(),
    }
}

// str.split(sep) for a one-character separator: always at least one piece.
fn split_char(s: ref String, sep: char) -> Vec[String] {
    let mut pieces: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            pieces.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    pieces.push(cur);
    pieces
}

// str.isspace: Unicode White_Space plus U+001C..U+001F.
fn py_space(c: char) -> bool {
    c.is_whitespace() or (c >= '\u{1c}' and c <= '\u{1f}')
}

// ------------------------------------------------------------ repr()

// str.isprintable(), for the characters the jobs hold.
fn py_printable(c: char) -> bool {
    let n = c as i64;
    if n < 0x20 or (n >= 0x7f and n <= 0xa0) or n == 0xad {
        return false;
    }
    if n == 0x1680 or (n >= 0x2000 and n <= 0x200f) or (n >= 0x2028 and n <= 0x202f) {
        return false;
    }
    if (n >= 0x205f and n <= 0x206f) or n == 0x3000 or n == 0xfeff or (n >= 0xfff9 and n <= 0xfffb) {
        return false;
    }
    not (n >= 0xe000 and n <= 0xf8ff)
}

fn char_esc(n: i64) -> String {
    if n < 0x100 {
        f"\\x{hex_digits(n, 2)}"
    } else if n < 0x10000 {
        f"\\u{hex_digits(n, 4)}"
    } else {
        f"\\U{hex_digits(n, 8)}"
    }
}

fn py_repr(s: ref String) -> String {
    let q = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if py_printable(c) {
            out.push(c);
        } else {
            out.push_str(char_esc(c as i64));
        }
    }
    out.push(q);
    out
}

// ------------------------------------------------------------ decimal to float (correctly rounded)

// Magnitudes as 32-bit limbs, least significant first, with no high
// zero limbs (zero is the empty vector).
fn big_trim(a: mut ref Vec[u32]) {
    while a.len() > 0 and a[a.len() - 1] == 0 {
        a.pop();
    }
}

fn big_mul_add(a: mut ref Vec[u32], m: u64, add: u64) {
    let mut carry = add;
    for i in 0..a.len() {
        let t = (a[i] as u64) * m + carry;
        a[i] = (t & 4294967295) as u32;
        carry = t >> 32;
    }
    while carry > 0 {
        a.push((carry & 4294967295) as u32);
        carry = carry >> 32;
    }
}

fn big_from_digits(ds: ref Vec[u8]) -> Vec[u32] {
    let mut a: Vec[u32] = Vec.new();
    for d in ds.iter() {
        big_mul_add(mut a, 10, *d as u64);
    }
    big_trim(mut a);
    a
}

fn big_pow10(n: i64) -> Vec[u32] {
    let mut a: Vec[u32] = [1];
    let mut k = n;
    while k >= 9 {
        big_mul_add(mut a, 1000000000, 0);
        k -= 9;
    }
    while k > 0 {
        big_mul_add(mut a, 10, 0);
        k -= 1;
    }
    a
}

fn big_mul(a: ref Vec[u32], b: ref Vec[u32]) -> Vec[u32] {
    let mut out: Vec[u32] = Vec.new();
    for _ in 0..(a.len() + b.len()) {
        out.push(0);
    }
    for i in 0..a.len() {
        let mut carry: u64 = 0;
        for j in 0..b.len() {
            let t = (a[i] as u64) * (b[j] as u64) + (out[i + j] as u64) + carry;
            out[i + j] = (t & 4294967295) as u32;
            carry = t >> 32;
        }
        let mut k = i + b.len();
        while carry > 0 {
            let t = (out[k] as u64) + carry;
            out[k] = (t & 4294967295) as u32;
            carry = t >> 32;
            k += 1;
        }
    }
    big_trim(mut out);
    out
}

fn big_bitlen(a: ref Vec[u32]) -> i64 {
    if a.len() == 0 {
        return 0;
    }
    let mut top = a[a.len() - 1];
    let mut n: i64 = 0;
    while top > 0 {
        n += 1;
        top = top >> 1;
    }
    (a.len() - 1) * 32 + n
}

fn big_shl(a: ref Vec[u32], bits: i64) -> Vec[u32] {
    let mut out: Vec[u32] = Vec.new();
    for _ in 0..(bits / 32) {
        out.push(0);
    }
    let s = bits % 32;
    let mut carry: u64 = 0;
    for i in 0..a.len() {
        let t = ((a[i] as u64) << s) | carry;
        out.push((t & 4294967295) as u32);
        carry = t >> 32;
    }
    if carry > 0 {
        out.push(carry as u32);
    }
    big_trim(mut out);
    out
}

fn big_shr1(a: mut ref Vec[u32]) {
    let mut i = 0;
    while i < a.len() {
        let hi: u32 = if i + 1 < a.len() { a[i + 1] & 1 } else { 0 };
        a[i] = (a[i] >> 1) | (hi << 31);
        i += 1;
    }
    big_trim(mut a);
}

fn big_cmp(a: ref Vec[u32], b: ref Vec[u32]) -> i64 {
    if a.len() != b.len() {
        return if a.len() < b.len() { -1 } else { 1 };
    }
    let mut i = a.len() - 1;
    while i >= 0 {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 };
        }
        i -= 1;
    }
    0
}

// a -= b, where a >= b.
fn big_sub(a: mut ref Vec[u32], b: ref Vec[u32]) {
    let mut borrow: i64 = 0;
    for i in 0..a.len() {
        let bv: i64 = if i < b.len() { b[i] as i64 } else { 0 };
        let mut t = (a[i] as i64) - bv - borrow;
        if t < 0 {
            t += 4294967296;
            borrow = 1;
        } else {
            borrow = 0;
        }
        a[i] = t as u32;
    }
    big_trim(mut a);
}

// ------------------------------------------------------------ decimal to float

// The f64 nearest to digits * 10**exp10, ties to even, as CPython's
// float() gives it. digits holds the digit values without leading zeros.
fn decimal_to_f64(digits: ref Vec[u8], exp10: i64, neg: bool) -> f64 {
    let mut ds = digits.clone();
    let mut e10 = exp10;
    while ds.len() > 0 and ds[ds.len() - 1] == 0 {
        ds.pop();
        e10 += 1;
    }
    let sign: f64 = if neg { -1.0 } else { 1.0 };
    if ds.len() == 0 {
        return sign * 0.0;
    }
    let n = ds.len();
    if n + e10 > 310 {
        return sign * f64.INFINITY;
    }
    if n + e10 < -330 {
        return sign * 0.0;
    }
    // The digits and the power of ten are exact, so one operation
    // rounds correctly.
    if n <= 15 and e10 >= -22 and e10 <= 22 {
        let mut m: f64 = 0.0;
        for d in ds.iter() {
            m = m * 10.0 + (*d as f64);
        }
        let mut p: f64 = 1.0;
        let mut k = if e10 < 0 { -e10 } else { e10 };
        while k > 0 {
            p *= 10.0;
            k -= 1;
        }
        return sign * (if e10 < 0 { m / p } else { m * p });
    }
    let mut num = big_from_digits(ds);
    let mut den: Vec[u32] = [1];
    if e10 >= 0 {
        num = big_mul(num, big_pow10(e10));
    } else {
        den = big_pow10(-e10);
    }
    // q = floor(num * 2**s / den) with 54 bits: the 53 of the result
    // and one to round on.
    let mut s = 54 - (big_bitlen(num) - big_bitlen(den));
    if s > 1075 {
        s = 1075;
    }
    let mut q: u64 = 0;
    let mut rem: Vec[u32] = Vec.new();
    let mut tries = 0;
    while tries < 2 {
        let mut n2 = if s > 0 { big_shl(num, s) } else { num.clone() };
        let d2 = if s < 0 { big_shl(den, -s) } else { den.clone() };
        let mut dd = big_shl(d2, 55);
        q = 0;
        let mut bit = 55;
        while bit >= 0 {
            if big_cmp(n2, dd) >= 0 {
                big_sub(mut n2, dd);
                q = q | ((1 as u64) << bit);
            }
            big_shr1(mut dd);
            bit -= 1;
        }
        rem = n2;
        if q >= ((1 as u64) << 54) and s < 1075 {
            s -= 1;
            tries += 1;
            continue;
        }
        if q < ((1 as u64) << 53) and s < 1075 {
            s += 1;
            tries += 1;
            continue;
        }
        break;
    }
    let mut mant = q >> 1;
    let round = (q & 1) == 1;
    let sticky = rem.len() > 0;
    if round and (sticky or (mant & 1) == 1) {
        mant += 1;
    }
    // The value is mant * 2**(1 - s).
    let mut e2 = 1 - s;
    if mant == ((1 as u64) << 53) {
        mant = mant >> 1;
        e2 += 1;
    }
    let bits: u64 = if mant < ((1 as u64) << 52) {
        // Subnormal: s is 1075 and the exponent field is zero.
        mant
    } else {
        let biased = e2 + 1075;
        if biased >= 2047 {
            return sign * f64.INFINITY;
        }
        ((biased as u64) << 52) | (mant & (((1 as u64) << 52) - 1))
    };
    sign * bits.bits_as_f64()
}


// ------------------------------------------------------------ dates

fn fdiv(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

fn fmod(a: i64, b: i64) -> i64 {
    a - fdiv(a, b) * b
}

fn is_leap(y: i64) -> bool {
    (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
}

fn days_in_month(y: i64, m: i64) -> i64 {
    if m == 2 {
        if is_leap(y) { 29 } else { 28 }
    } else if m == 4 or m == 6 or m == 9 or m == 11 {
        30
    } else {
        31
    }
}

fn valid_date(y: i64, m: i64, d: i64) -> bool {
    y >= 1 and y <= 9999 and m >= 1 and m <= 12 and d >= 1 and d <= days_in_month(y, m)
}

// Days from 1970-01-01 to the proleptic Gregorian date.
fn days_from_civil(y0: i64, m: i64, d: i64) -> i64 {
    let y = if m <= 2 { y0 - 1 } else { y0 };
    let era = fdiv(y, 400);
    let yoe = y - era * 400;
    let mp = if m > 2 { m - 3 } else { m + 9 };
    let doy = (153 * mp + 2) / 5 + d - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

fn civil_from_days(z0: i64) -> (i64, i64, i64) {
    let z = z0 + 719468;
    let era = fdiv(z, 146097);
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = if mp < 10 { mp + 3 } else { mp - 9 };
    let y = yoe + era * 400 + if m <= 2 { 1 } else { 0 };
    (y, m, d)
}

// A datetime: naive, or with a fixed UTC offset in seconds.
#[derive(Clone)]
struct DateTime {
    y: i64,
    mo: i64,
    d: i64,
    h: i64,
    mi: i64,
    s: i64,
    us: i64,
    off: Option[i64],
}

// A normalized timedelta: 0 <= secs < 86400 and 0 <= us < 1000000.
#[derive(Clone)]
struct Delta {
    days: i64,
    secs: i64,
    us: i64,
}

fn td_new(days: i64, secs: i64, us: i64) -> Delta {
    let s1 = secs + fdiv(us, 1000000);
    let u = fmod(us, 1000000);
    Delta { days: days + fdiv(s1, 86400), secs: fmod(s1, 86400), us: u }
}

fn td_repr(t: ref Delta) -> String {
    let mut parts: Vec[String] = Vec.new();
    if t.days != 0 {
        parts.push(f"days={t.days}");
    }
    if t.secs != 0 {
        parts.push(f"seconds={t.secs}");
    }
    if t.us != 0 {
        parts.push(f"microseconds={t.us}");
    }
    if parts.is_empty() {
        parts.push("0".to_string());
    }
    let inner = join(parts, ", ");
    f"datetime.timedelta({inner})"
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

fn tz_repr(off: i64) -> String {
    if off == 0 {
        "datetime.timezone.utc".to_string()
    } else {
        f"datetime.timezone({td_repr(td_new(0, off, 0))})"
    }
}

// repr(datetime): a zero microsecond, then a zero second, are left out.
fn dt_repr(t: ref DateTime) -> String {
    let mut l: Vec[i64] = [t.y, t.mo, t.d, t.h, t.mi, t.s, t.us];
    for _ in 0..2 {
        if l[l.len() - 1] == 0 {
            let _ = l.pop();
        }
    }
    let mut parts: Vec[String] = Vec.new();
    for v in l.iter() {
        parts.push(v.to_string());
    }
    if let Some(off) = t.off {
        parts.push(f"tzinfo={tz_repr(off)}");
    }
    let inner = join(parts, ", ");
    f"datetime.datetime({inner})"
}

fn midnight(y: i64, mo: i64, d: i64) -> DateTime {
    DateTime { y: y, mo: mo, d: d, h: 0, mi: 0, s: 0, us: 0, off: None }
}

// The UTC datetime `secs` seconds and `us` microseconds after the epoch,
// as datetime.fromtimestamp() gives it with TZ=UTC.
fn from_epoch(secs: i64, us: i64) -> DateTime {
    let days = fdiv(secs, 86400);
    let rem = fmod(secs, 86400);
    let (y, mo, d) = civil_from_days(days);
    DateTime { y: y, mo: mo, d: d, h: rem / 3600, mi: rem / 60 % 60, s: rem % 60, us: us, off: None }
}

// C's round(): halves away from zero.
fn round_away(x: f64) -> f64 {
    let t = (x as i64) as f64;
    let diff = x - t;
    if diff >= 0.5 {
        t + 1.0
    } else if diff <= -0.5 {
        t - 1.0
    } else {
        t
    }
}

// _PyTime_RoundHalfEven
fn round_half_even(x: f64) -> f64 {
    let r = round_away(x);
    let gap = x - r;
    if gap == 0.5 or gap == -0.5 {
        2.0 * round_away(x / 2.0)
    } else {
        r
    }
}

// datetime.fromtimestamp(x) for a float: modf, then the fraction scaled
// to microseconds and rounded half to even, carried into the seconds.
fn from_float_ts(x: f64) -> DateTime {
    let mut ip = (x as i64) as f64;
    let frac = x - ip;
    let mut fp = round_half_even(frac * 1000000.0);
    if fp >= 1000000.0 {
        fp -= 1000000.0;
        ip += 1.0;
    } else if fp < 0.0 {
        fp += 1000000.0;
        ip -= 1.0;
    }
    from_epoch(ip as i64, fp as i64)
}

// ------------------------------------------------------------ values

enum Val {
    Nil,
    Bool(bool),
    Int(i64),
    // the float and its repr() as the job file gives it
    Float(f64, String),
    Str(String),
    // an empty list: a type the parser does not know
    List,
    Date(i64, i64, i64),
    Dt(DateTime),
    Td(Delta),
}

struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: ref String) -> Exc {
    Exc { kind: kind.to_string(), msg: msg.clone() }
}

fn show(v: ref Val) -> String {
    match v {
        Val.Nil => "None".to_string(),
        Val.Bool(b) => if *b { "True".to_string() } else { "False".to_string() },
        Val.Int(n) => n.to_string(),
        Val.Float(_, r) => r.clone(),
        Val.Str(s) => py_repr(s),
        Val.List => "[]".to_string(),
        Val.Date(y, m, d) => f"datetime.date({y}, {m}, {d})",
        Val.Dt(t) => dt_repr(t),
        Val.Td(t) => td_repr(t),
    }
}

fn ints(s: ref String) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for p in split_char(s, ',') {
        out.push(dec_int(p));
    }
    out
}

fn dec_int(s: ref String) -> i64 {
    let cs = to_chars(s);
    let mut v = 0;
    let mut neg = false;
    for c in cs.iter() {
        if *c == '-' {
            neg = true;
        } else {
            v = v * 10 + (*c as i64 - 48);
        }
    }
    if neg { -v } else { v }
}

fn decode_val(w: ref String) -> Val {
    if w == "n" {
        return Val.Nil;
    }
    if w == "l" {
        return Val.List;
    }
    let cs = to_chars(w);
    let mut k = 0;
    while cs[k] != ':' {
        k += 1;
    }
    let t = text(cs, 0, k);
    let rest = text(cs, k + 1, cs.len());
    if t == "b" {
        Val.Bool(rest == "1")
    } else if t == "i" {
        Val.Int(dec_int(rest))
    } else if t == "f" {
        Val.Float(f64.parse(rest).unwrap(), rest)
    } else if t == "s" {
        Val.Str(hex_text(rest))
    } else if t == "d" {
        let n = ints(rest);
        Val.Date(n[0], n[1], n[2])
    } else if t == "td" {
        let n = ints(rest);
        Val.Td(td_new(n[0], n[1], n[2]))
    } else {
        let n = ints(rest);
        let off = if n.len() == 8 { Some(n[7]) } else { None };
        Val.Dt(DateTime { y: n[0], mo: n[1], d: n[2], h: n[3], mi: n[4], s: n[5], us: n[6], off: off })
    }
}

// ------------------------------------------------------------ timeago.parser

// The fixed date.today() of the run (see oracle.py).
const TODAY_Y: i64 = 2026;
const TODAY_M: i64 = 10;
const TODAY_D: i64 = 23;

// int(s) for a str: whitespace, a sign, then decimal digits of any script
// with single underscores between them. `ds` holds the runs of decimal
// digits from digits_text(). A value too large for any date is capped.
fn py_int(s: ref String, ds: ref Vec[(i64, i64)]) -> Option[i64] {
    let cs = to_chars(s);
    let mut a = 0;
    let mut b = cs.len();
    while a < b and py_space(cs[a]) {
        a += 1;
    }
    while b > a and py_space(cs[b - 1]) {
        b -= 1;
    }
    let mut i = a;
    let mut neg = false;
    if i < b and (cs[i] == '+' or cs[i] == '-') {
        neg = cs[i] == '-';
        i += 1;
    }
    if i >= b {
        return None;
    }
    let mut v = 0;
    let mut prev_digit = false;
    while i < b {
        let c = cs[i];
        if c == '_' {
            if not prev_digit or i + 1 == b {
                return None;
            }
            prev_digit = false;
        } else {
            let dv = digit_value(c, ds)?;
            if v < 1000000000000 {
                v = v * 10 + dv;
            }
            prev_digit = true;
        }
        i += 1;
    }
    Some(if neg { -v } else { v })
}

fn digit_value(c: char, ds: ref Vec[(i64, i64)]) -> Option[i64] {
    if is_digit(c) {
        return Some(c as i64 - 48);
    }
    let n = c as i64;
    for r in ds.iter() {
        let (lo, hi) = *r;
        if n >= lo and n <= hi {
            return Some(n - lo);
        }
    }
    None
}

// _string_to_date
fn string_to_date(s: ref String, ds: ref Vec[(i64, i64)]) -> Option[(i64, i64, i64)] {
    if s.is_empty() {
        return None;
    }
    let a = split_char(s, '-');
    if a.len() < 3 {
        return None;
    }
    let y = py_int(a[0], ds)?;
    let m = py_int(a[1], ds)?;
    let d = py_int(a[2], ds)?;
    if valid_date(y, m, d) { Some((y, m, d)) } else { None }
}

// _string_to_time
fn string_to_time(s: ref String, ds: ref Vec[(i64, i64)]) -> Option[(i64, i64, i64)] {
    if s.is_empty() {
        return None;
    }
    let a = split_char(s, ':');
    if a.len() < 3 {
        return None;
    }
    let h = py_int(a[0], ds)?;
    let m = py_int(a[1], ds)?;
    let sec = py_int(a[2], ds)?;
    if h >= 0 and h <= 23 and m >= 0 and m <= 59 and sec >= 0 and sec <= 59 { Some((h, m, sec)) } else { None }
}

// _combine_date_time
fn combine(d: Option[(i64, i64, i64)], t: Option[(i64, i64, i64)]) -> Option[DateTime] {
    let (y, mo, dd) = d?;
    let (h, mi, s) = t?;
    Some(DateTime { y: y, mo: mo, d: dd, h: h, mi: mi, s: s, us: 0, off: None })
}

// string_to_data_time
fn string_to_dt(s: ref String, ds: ref Vec[(i64, i64)]) -> Option[DateTime] {
    if s.is_empty() {
        return None;
    }
    let d = s.replace("/", "-");
    if d.contains(" ") {
        let parts = split_char(d, ' ');
        if parts.len() == 2 {
            return combine(string_to_date(parts[0], ds), string_to_time(parts[1], ds));
        }
        return None;
    }
    if d.contains("-") {
        return combine(string_to_date(d, ds), Some((0, 0, 0)));
    }
    if d.contains(":") {
        return combine(Some((TODAY_Y, TODAY_M, TODAY_D)), string_to_time(d, ds));
    }
    None
}

// parser.parse
fn parse(v: ref Val, ds: ref Vec[(i64, i64)]) -> Option[DateTime] {
    match v {
        Val.Dt(t) => Some(t.clone()),
        Val.Date(y, m, d) => Some(midnight(*y, *m, *d)),
        Val.Bool(b) => Some(from_epoch(if *b { 1 } else { 0 }, 0)),
        Val.Int(n) => Some(from_epoch(*n, 0)),
        Val.Float(x, _) => Some(from_float_ts(*x)),
        Val.Str(s) => string_to_dt(s, ds),
        _ => None,
    }
}

// now - date
fn dt_sub(a: ref DateTime, b: ref DateTime) -> Result[Delta, Exc] {
    if a.off.is_some() != b.off.is_some() {
        return Err(exc("TypeError", "can't subtract offset-naive and offset-aware datetimes"));
    }
    let days = days_from_civil(a.y, a.mo, a.d) - days_from_civil(b.y, b.mo, b.d);
    let mut secs = (a.h * 3600 + a.mi * 60 + a.s) - (b.h * 3600 + b.mi * 60 + b.s);
    secs -= a.off.unwrap_or(0);
    secs += b.off.unwrap_or(0);
    Ok(td_new(days, secs, a.us - b.us))
}

fn digits_of(n: i64, width: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for c in n.to_string().chars() {
        out.push((c as i64 - 48) as u8);
    }
    while out.len() < width {
        out.insert(0, 0);
    }
    out
}

// timedelta.total_seconds(): the exact microsecond count over 10**6,
// rounded once to the nearest float, as Python's int / int division
// rounds it.
fn total_seconds(t: ref Delta) -> f64 {
    let s = t.days * 86400 + t.secs;
    let neg = s < 0;
    let (whole, frac) = if not neg {
        (s, t.us)
    } else if t.us > 0 {
        (-s - 1, 1000000 - t.us)
    } else {
        (-s, 0)
    };
    let mut ds = digits_of(whole, 0);
    for x in digits_of(frac, 6) {
        ds.push(x);
    }
    while ds.len() > 0 and ds[0] == 0 {
        ds.remove(0);
    }
    decimal_to_f64(ds, -6, neg)
}

// ------------------------------------------------------------ the locales

struct Loc {
    name: String,
    func: bool,
    rows: Vec[Vec[String]],
}

fn load_locales() -> Vec[Loc] {
    let mut out: Vec[Loc] = Vec.new();
    for line in split_char(locale_text(), '\n') {
        if line.is_empty() {
            continue;
        }
        let f = split_char(line, '\t');
        if f[0] == "L" {
            out.push(Loc { name: f[1].clone(), func: f[2] == "func", rows: Vec.new() });
        } else {
            let last = out.len() - 1;
            out[last].rows.push(f[1..].to_vec());
        }
    }
    out
}

fn load_digits() -> Vec[(i64, i64)] {
    let mut out: Vec[(i64, i64)] = Vec.new();
    for line in split_char(digits_text(), '\n') {
        let f = split_char(line, ' ');
        if f.len() == 2 {
            out.push((hex_int(f[0]), hex_int(f[1])));
        }
    }
    out
}

fn in_range(n: i64, lo: i64, hi: i64) -> bool {
    n >= lo and n <= hi
}

// The template of a locale whose LOCALE is generate(row, y), which picks a
// plural form by the number.
fn plural_template(loc: ref Loc, row: i64, y: i64, n: i64) -> String {
    let base = loc.rows[row].clone();
    let name = loc.name.clone();
    if name == "sk" {
        if y == 1 and n < 5 and y + 1 < base.len() {
            return base[y + 1].clone();
        }
        return base[y].clone();
    }
    if row % 2 == 0 {
        return base[y].clone();
    }
    if name == "ru" or name == "uk" {
        let t = if n > 20 { n % 10 } else { n };
        if t == 1 {
            base[y].clone()
        } else if in_range(t, 2, 4) {
            base[y + 2].clone()
        } else {
            base[y + 4].clone()
        }
    } else if name == "pl" {
        if in_range(n % 10, 2, 4) and not in_range(n % 100, 12, 14) {
            base[y + 2].clone()
        } else {
            base[y].clone()
        }
    } else if name == "lt" {
        let (r10, r100) = (n % 10, n % 100);
        if (10 < r100 and r100 < 20) or r10 == 0 {
            base[y + 4].clone()
        } else if r10 != 1 {
            base[y + 2].clone()
        } else {
            base[y].clone()
        }
    } else {
        // ar
        if n == 2 {
            base[y].clone()
        } else if in_range(n, 3, 10) {
            base[y + 2].clone()
        } else {
            base[y + 4].clone()
        }
    }
}

// ------------------------------------------------------------ timeago.format

fn date_error() -> Exc {
    exc("ParameterUnvalid", py_repr("the parameter `date` should be datetime / timedelta, or datetime formatted string."))
}

fn now_error() -> Exc {
    exc("ParameterUnvalid", py_repr("the parameter `now` should be datetime, or datetime formatted string."))
}

fn format(args: ref Vec[Val], locales: ref Vec[Loc], ds: ref Vec[(i64, i64)]) -> Result[String, Exc] {
    let delta = match args[0] {
        Val.Td(t) => t.clone(),
        _ => {
            let date = parse(args[0], ds);
            let now = parse(args[1], ds);
            let d = match date {
                Some(d) => d,
                None => return Err(date_error()),
            };
            let n = match now {
                Some(n) => n,
                None => return Err(now_error()),
            };
            dt_sub(n, d)?
        }
    };
    let mut diff = total_seconds(delta) as i64;
    let mut ago_in = 0;
    if diff < 0 {
        ago_in = 1;
        diff = -diff;
    }
    let sec_array: Vec[f64] = [60.0, 60.0, 24.0, 7.0, 365.0 / 7.0 / 12.0, 12.0];
    let mut x = diff as f64;
    let mut i = 0;
    while i < 6 {
        let tmp = sec_array[i];
        if x >= tmp {
            i += 1;
            x = x / tmp;
        } else {
            break;
        }
    }
    let n = x as i64;
    i *= 2;
    if n > (if i == 0 { 9 } else { 1 }) {
        i += 1;
    }
    let want = if args.len() > 2 {
        match args[2] {
            Val.Str(s) => s.clone(),
            _ => "en".to_string(),
        }
    } else {
        "en".to_string()
    };
    let mut k = 0;
    let mut found = false;
    for j in 0..locales.len() {
        if locales[j].name == want {
            k = j;
            found = true;
        }
    }
    if not found {
        for j in 0..locales.len() {
            if locales[j].name == "en" {
                k = j;
            }
        }
    }
    let loc = ref locales[k];
    let tmp = if loc.func { plural_template(loc, i, ago_in, n) } else { loc.rows[i][ago_in].clone() };
    if tmp.contains("%s") {
        Ok(tmp.replace("%s", n.to_string()))
    } else {
        Ok(tmp)
    }
}

// ------------------------------------------------------------ the jobs

fn emit(out: mut ref String, s: ref String) {
    out.push_str(s);
    out.push('\n');
}

fn main() {
    let locales = load_locales();
    let ds = load_digits();
    let mut out = String.new();
    for line in split_char(jobs_text(), '\n') {
        if line.is_empty() {
            continue;
        }
        let f = split_char(line, '\t');
        if f[0] == "job" {
            emit(mut out, f"== {f[1]}");
            continue;
        }
        let mut args: Vec[Val] = Vec.new();
        let mut shown: Vec[String] = Vec.new();
        for k in 1..f.len() {
            let v = decode_val(f[k]);
            shown.push(show(v));
            args.push(v);
        }
        let inner = join(shown, ", ");
        emit(mut out, f"> {f[0]}({inner})");
        if f[0] == "parse" {
            match parse(args[0], ds) {
                Some(t) => emit(mut out, f"  -> {dt_repr(t)}"),
                None => emit(mut out, "  -> None"),
            }
            continue;
        }
        match format(args, locales, ds) {
            Ok(s) => emit(mut out, f"  -> {s}"),
            Err(e) => emit(mut out, f"  error {e.kind}: {e.msg}"),
        }
    }
    print(out);
}

