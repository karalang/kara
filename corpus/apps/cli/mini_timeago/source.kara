    s.push_str("R\t1 yıl önce\t1 yıl içinde\nR\t%s yıl önce\t%s yıl içinde\nL\tuk\tfunc\nR\tщойно\tчерез мить\nR\t%s секунду тому\tчерез %s секунду\t%s секунди тому\tчерез %s секунди\t%s секунд тому\tчерез %s секунд\nR\tхвилину тому\tчерез хвилину\nR\t%s хвилину тому\tчерез %s хвилину\t%s хвилини тому\tчерез %s хвилини\t%s хвилин тому\tчерез %s минут\nR\tгодину тому\tчерез годину\nR\t%s годину тому\tчерез %s годину\t%s години тому\tчерез %s години\t%s годин тому\tчерез %s годин\nR\tвчора\tзавтра\nR\t%s день тому\tчерез %s день\t%s дні тому\tчерез %s дні\t%s днів тому\tчерез %s днів\nR\tтиждень тому\tчерез тиждень\nR\t%s тиждень тому\tчерез %s тиждень\t%s тиждні тому\tчерез %s тиждні\t%s тижднів тому\tчерез %s тижднів\nR\tмісяць тому\tчерез місяць\nR\t%s місяць тому\tчерез %s місяць\t%s місяці тому\tчерез %s місяці\t%s місяців тому\tчерез %s місяців\nR\tрік тому\tчерез рік\nR\t%s рік тому\tчерез %s рік\t%s роки тому\tчерез %s роки\t%s років тому\tчерез %s років\nL\tvi\tlist\nR\tvừa xong\tmột lúc\nR\t%s giây trước\ttrong %s giây\n");
    s.push_str("R\t1 phút trước\ttrong 1 phút\nR\t%s phút trước\ttrong %s phút\nR\t1 giờ trước\ttrong 1 giờ\nR\t%s giờ trước\ttrong %s giờ\nR\t1 ngày trước\ttrong 1 ngày\nR\t%s ngày trước\ttrong %s ngày\nR\t1 tuần trước\ttrong 1 tuần\nR\t%s tuần trước\ttrong %s tuần\nR\t1 tháng trước\ttrong 1 tháng\nR\t%s tháng trước\ttrong %s tháng\nR\t1 năm trước\ttrong 1 năm\nR\t%s năm trước\ttrong %s năm\nL\tzh_CN\tlist\nR\t刚刚\t片刻后\nR\t%s秒前\t%s秒后\nR\t1分钟前\t1分钟后\nR\t%s分钟前\t%s分钟后\nR\t1小时前\t1小时后\nR\t%s小时前\t%s小时后\nR\t1天前\t1天后\nR\t%s天前\t%s天后\nR\t1周前\t1周后\nR\t%s周前\t%s周后\nR\t1月前\t1月后\nR\t%s月前\t%s月后\nR\t1年前\t1年后\nR\t%s年前\t%s年后\nL\tzh_TW\tlist\nR\t剛剛\t片刻後\nR\t%s秒前\t%s秒後\nR\t1分鐘前\t1分鐘後\nR\t%s分鐘前\t%s分鐘後\nR\t1小時前\t1小時後\nR\t%s小時前\t%s小時後\nR\t1天前\t1天後\nR\t%s天前\t%s天後\nR\t1周前\t1周後\nR\t%s周前\t%s周後\nR\t1月前\t1月後\nR\t%s月前\t%s月後\nR\t1年前\t1年後\nR\t%s年前\t%s年後\n");
    s
}

