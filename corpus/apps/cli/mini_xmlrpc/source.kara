fn data_part_1(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("<?xml version=\"1.0\"?><methodCall><methodName>blob.concat</methodName><params><param><value><array><data><value><base64>SGVsbG8s</base64></value><value><base64>IHdvcmxk</base64></value><value><base64>IQ==</base64></value></data></array></value></param></params></methodCall>");
