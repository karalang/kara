// ------------------------------------------------------------ text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn cp(s: Str) -> Vec[i64] {
    codepoints(s.bytes())
}

fn cps(s: ref String) -> Vec[i64] {
    codepoints(s.bytes())
}

// Text with no surrogates in it, as a String.
fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for c in s {
        if c < 0x80 {
            out.push(c as u8);
        } else if c < 0x800 {
            out.push((0xC0 | (c >> 6)) as u8);
            out.push((0x80 | (c & 0x3F)) as u8);
        } else if c < 0x10000 {
            out.push((0xE0 | (c >> 12)) as u8);
            out.push((0x80 | ((c >> 6) & 0x3F)) as u8);
            out.push((0x80 | (c & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (c >> 18)) as u8);
            out.push((0x80 | ((c >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((c >> 6) & 0x3F)) as u8);
            out.push((0x80 | (c & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn starts_with(s: ref Vec[i64], p: ref Vec[i64]) -> bool {
    if p.len() > s.len() {
        return false;
    }
    for i in 0..p.len() {
        if s[i] != p[i] {
            return false;
        }
    }
    true
}

fn hex_n(c: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(c >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

fn hex_val(c: i64) -> i64 {
    if c >= 48 and c <= 57 {
        return c - 48;
    }
    if c >= 97 and c <= 102 {
        return c - 87;
    }
    if c >= 65 and c <= 70 {
        return c - 55;
    }
    -1
}

fn split_cp(s: ref Vec[i64], sep: i64) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    for c in s {
        if c == sep {
            out.push(cur);
            cur = Vec.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn split_tabs(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == '\t' {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

// the lines of a file, without their \n, as Python's iteration gives
// them
fn text_lines(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == '\n' {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    if not cur.is_empty() {
        out.push(cur);
    }
    out
}

fn sort_strings(v: mut ref Vec[String]) {
    let mut i = 1;
    while i < v.len() {
        let mut j = i;
        while j > 0 and v[j] < v[j - 1] {
            let t = v[j].clone();
            v[j] = v[j - 1].clone();
            v[j - 1] = t;
            j -= 1;
        }
        i += 1;
    }
}

fn is_surrogate(c: i64) -> bool {
    c >= 0xD800 and c <= 0xDFFF
}

// ------------------------------------------------------------ reprs

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

// repr() of a str
fn repr_of(s: ref Vec[i64]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    let mut out: Vec[i64] = Vec.new();
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
    to_string(out)
}

fn pr(s: ref String) -> String {
    repr_of(cps(s))
}
// ------------------------------------------------------------ Python values

// The values XML-RPC carries, as Python holds them after loads() with
// use_builtin_types: a datetime is its seconds since 0001-01-01, and a
// timedelta (which only appears on its way into an addition) its seconds.
const P_NONE: i64 = 0;
const P_BOOL: i64 = 1;
const P_INT: i64 = 2;
const P_FLOAT: i64 = 3;
const P_STR: i64 = 4;
const P_BYTES: i64 = 5;
const P_LIST: i64 = 6;
const P_DICT: i64 = 7;
const P_DATE: i64 = 8;
const P_DELTA: i64 = 9;

#[derive(Clone)]
struct Py {
    t: i64,
    i: i64,
    f: f64,
    s: String,
    by: Vec[i64],
    // a list's items, or a dict's values in order
    items: Vec[Py],
    // a dict's keys, in insertion order
    keys: Vec[Py],
}

fn py(t: i64) -> Py {
    Py { t: t, i: 0, f: 0.0, s: String.new(), by: Vec.new(), items: Vec.new(), keys: Vec.new() }
}

fn py_none() -> Py {
    py(P_NONE)
}

fn py_bool(b: bool) -> Py {
    let mut v = py(P_BOOL);
    v.i = if b { 1 } else { 0 };
    v
}

fn py_int(n: i64) -> Py {
    let mut v = py(P_INT);
    v.i = n;
    v
}

fn py_float(x: f64) -> Py {
    let mut v = py(P_FLOAT);
    v.f = x;
    v
}

fn py_str(s: own String) -> Py {
    let mut v = py(P_STR);
    v.s = s;
    v
}

fn py_text(s: Str) -> Py {
    py_str(s.to_string())
}

fn py_bytes(b: own Vec[i64]) -> Py {
    let mut v = py(P_BYTES);
    v.by = b;
    v
}

fn py_list(items: own Vec[Py]) -> Py {
    let mut v = py(P_LIST);
    v.items = items;
    v
}

fn type_name(v: ref Py) -> String {
    let n = match v.t {
        0 => "NoneType",
        1 => "bool",
        2 => "int",
        3 => "float",
        4 => "str",
        5 => "bytes",
        6 => "list",
        7 => "dict",
        8 => "datetime.datetime",
        _ => "datetime.timedelta",
    };
    n.to_string()
}

fn is_intlike(v: ref Py) -> bool {
    v.t == P_INT or v.t == P_BOOL
}

fn is_number(v: ref Py) -> bool {
    v.t == P_INT or v.t == P_BOOL or v.t == P_FLOAT
}

fn as_float(v: ref Py) -> f64 {
    if v.t == P_FLOAT { v.f } else { v.i as f64 }
}

// Python's == between values that can be dict keys.
fn py_eq(a: ref Py, b: ref Py) -> bool {
    if is_number(a) and is_number(b) {
        if is_intlike(a) and is_intlike(b) {
            return a.i == b.i;
        }
        return as_float(a) == as_float(b);
    }
    if a.t != b.t {
        return false;
    }
    if a.t == P_NONE {
        return true;
    }
    if a.t == P_STR {
        return a.s == b.s;
    }
    if a.t == P_BYTES {
        return same(a.by, b.by);
    }
    a.i == b.i
}

fn dict_find(d: ref Py, k: ref Py) -> i64 {
    let mut n = 0;
    while n < d.keys.len() {
        if py_eq(d.keys[n], k) {
            return n;
        }
        n += 1;
    }
    -1
}

// d[k] = v, keeping the position of a key already there.
fn dict_set(d: mut ref Py, k: own Py, v: own Py) {
    let at = dict_find(d, k);
    if at >= 0 {
        d.items[at] = v;
    } else {
        d.keys.push(k);
        d.items.push(v);
    }
}

// ------------------------------------------------------------ dates

fn is_leap(y: i64) -> bool {
    (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
}

fn days_in_month(y: i64, m: i64) -> i64 {
    if m == 2 {
        return if is_leap(y) { 29 } else { 28 };
    }
    if m == 4 or m == 6 or m == 9 or m == 11 { 30 } else { 31 }
}

fn days_before_year(y: i64) -> i64 {
    let p = y - 1;
    p * 365 + p / 4 - p / 100 + p / 400
}

fn days_before_month(y: i64, m: i64) -> i64 {
    let mut n = 0;
    let mut k = 1;
    while k < m {
        n += days_in_month(y, k);
        k += 1;
    }
    n
}

// 0001-01-01 is day 1, as date.toordinal() counts.
fn ymd_to_ord(y: i64, m: i64, d: i64) -> i64 {
    days_before_year(y) + days_before_month(y, m) + d
}

fn ord_to_ymd(ord: i64) -> (i64, i64, i64) {
    let mut y = (ord - 1) / 366 + 1;
    while days_before_year(y + 1) < ord {
        y += 1;
    }
    let mut n = ord - days_before_year(y);
    let mut m = 1;
    while n > days_in_month(y, m) {
        n -= days_in_month(y, m);
        m += 1;
    }
    (y, m, n)
}

const MAX_ORD: i64 = 3652059;

fn py_date(y: i64, m: i64, d: i64, hh: i64, mm: i64, ss: i64) -> Py {
    let mut v = py(P_DATE);
    v.i = ymd_to_ord(y, m, d) * 86400 + hh * 3600 + mm * 60 + ss;
    v
}

// year, month, day, hour, minute, second
fn date_fields(v: ref Py) -> Vec[i64] {
    let ord = v.i / 86400;
    let secs = v.i % 86400;
    let (y, m, d) = ord_to_ymd(ord);
    vec![y, m, d, secs / 3600, secs / 60 % 60, secs % 60]
}

fn pad(n: i64, w: i64) -> String {
    let mut s = n.to_string();
    while s.len() < w {
        s = f"0{s}";
    }
    s
}

// xmlrpc.client's _iso8601_format
fn iso8601(v: ref Py) -> String {
    let f = date_fields(v);
    f"{pad(f[0], 4)}{pad(f[1], 2)}{pad(f[2], 2)}T{pad(f[3], 2)}:{pad(f[4], 2)}:{pad(f[5], 2)}"
}

// ------------------------------------------------------------ repr

fn bytes_repr(b: ref Vec[i64]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for c in b.iter() {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    let mut out: Vec[i64] = Vec.new();
    out.push(98);
    out.push(quote);
    for c in b.iter() {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c >= 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else {
            out.push(c);
        }
    }
    out.push(quote);
    to_string(out)
}

fn repr(v: ref Py) -> String {
    if v.t == P_NONE {
        return "None".to_string();
    }
    if v.t == P_BOOL {
        return if v.i == 1 { "True".to_string() } else { "False".to_string() };
    }
    if v.t == P_INT {
        return v.i.to_string();
    }
    if v.t == P_FLOAT {
        return float_repr(v.f);
    }
    if v.t == P_STR {
        return pr(v.s);
    }
    if v.t == P_BYTES {
        return bytes_repr(v.by);
    }
    if v.t == P_LIST {
        let mut out = "[".to_string();
        let mut k = 0;
        while k < v.items.len() {
            if k > 0 {
                out.push_str(", ");
            }
            out.push_str(repr(v.items[k]).as_str());
            k += 1;
        }
        out.push_str("]");
        return out;
    }
    if v.t == P_DICT {
        let mut out = "{".to_string();
        let mut k = 0;
        while k < v.keys.len() {
            if k > 0 {
                out.push_str(", ");
            }
            out.push_str(f"{repr(v.keys[k])}: {repr(v.items[k])}");
            k += 1;
        }
        out.push_str("}");
        return out;
    }
    if v.t == P_DATE {
        let f = date_fields(v);
        let mut out = f"datetime.datetime({f[0]}, {f[1]}, {f[2]}, {f[3]}, {f[4]}";
        if f[5] != 0 {
            out.push_str(f", {f[5]}");
        }
        out.push_str(")");
        return out;
    }
    f"datetime.timedelta(seconds={v.i})"
}

fn tuple_repr(vs: ref Vec[Py]) -> String {
    let mut out = "(".to_string();
    let mut k = 0;
    while k < vs.len() {
        if k > 0 {
            out.push_str(", ");
        }
        out.push_str(repr(vs[k]).as_str());
        k += 1;
    }
    if vs.len() == 1 {
        out.push_str(",");
    }
    out.push_str(")");
    out
}

fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    f"{x}"
}

// str() of a value, where it differs from repr()
fn py_to_str(v: ref Py) -> String {
    if v.t == P_STR { v.s.clone() } else { repr(v) }
}

// ------------------------------------------------------------ exceptions

// A raised exception: a Fault carries its code and string, anything else
// its class (as `type()` prints it, module first) and its str().
struct Exc {
    fault: bool,
    cls: String,
    text: String,
    code: Py,
    string: Py,
}

fn py_exc(cls: Str, text: own String) -> Exc {
    Exc { fault: false, cls: cls.to_string(), text: text, code: py_none(), string: py_none() }
}

fn type_error(text: own String) -> Exc {
    py_exc("TypeError", text)
}

fn fault(code: own Py, string: own Py) -> Exc {
    Exc { fault: true, cls: "xmlrpc.client.Fault".to_string(), text: String.new(), code: code, string: string }
}

// type(e).__name__
fn exc_name(e: ref Exc) -> String {
    let v = cps(e.cls);
    let mut k = v.len() - 1;
    while k >= 0 and v[k] != 46 {
        k -= 1;
    }
    to_string(slice(v, k + 1, v.len()))
}

// "%s:%s" % (type(exc), exc), the faultString the server sends
fn exc_line(e: ref Exc) -> String {
    f"<class '{e.cls}'>:{e.text}"
}
// ------------------------------------------------------------ Python's int() and float()

fn is_py_space(c: i64) -> bool {
    c == 32 or (c >= 9 and c <= 13) or (c >= 0x1C and c <= 0x1F)
}

fn strip_cps(v: ref Vec[i64]) -> Vec[i64] {
    let mut a = 0;
    let mut b = v.len();
    while a < b and is_py_space(v[a]) {
        a += 1;
    }
    while b > a and is_py_space(v[b - 1]) {
        b -= 1;
    }
    slice(v, a, b)
}

fn is_dig(c: i64) -> bool {
    c >= 48 and c <= 57
}

// A run of digits with single underscores between them, from i; the
// index after it, or -1 when an underscore is misplaced.
fn digit_run(v: ref Vec[i64], i: i64) -> i64 {
    let mut j = i;
    while j < v.len() and is_dig(v[j]) {
        j += 1;
        if j + 1 < v.len() and v[j] == 95 and is_dig(v[j + 1]) {
            j += 1;
        }
    }
    if j < v.len() and v[j] == 95 {
        return -1;
    }
    j
}

// int(s) in base 10
fn parse_int(s: ref String) -> Option[i64] {
    let v = strip_cps(cps(s));
    let mut i = 0;
    let mut neg = false;
    if i < v.len() and (v[i] == 43 or v[i] == 45) {
        neg = v[i] == 45;
        i += 1;
    }
    let end = digit_run(v, i);
    if end <= i or end != v.len() {
        return None;
    }
    let mut n: i64 = 0;
    while i < end {
        if v[i] != 95 {
            n = n * 10 + (v[i] - 48);
        }
        i += 1;
    }
    Some(if neg { -n } else { n })
}

fn lower_cps(v: ref Vec[i64]) -> String {
    let mut out: Vec[i64] = Vec.new();
    for c in v.iter() {
        out.push(if c >= 65 and c <= 90 { c + 32 } else { c });
    }
    to_string(out)
}

// float(s)
fn parse_float(s: ref String) -> Option[f64] {
    let v = strip_cps(cps(s));
    let mut i = 0;
    let mut neg = false;
    if i < v.len() and (v[i] == 43 or v[i] == 45) {
        neg = v[i] == 45;
        i += 1;
    }
    let word = lower_cps(slice(v, i, v.len()));
    if word == "inf" or word == "infinity" {
        return Some(if neg { -f64.INFINITY } else { f64.INFINITY });
    }
    if word == "nan" {
        return Some(f64.NAN);
    }
    let a = digit_run(v, i);
    if a < 0 {
        return None;
    }
    let mut j = a;
    let mut digits = a > i;
    if j < v.len() and v[j] == 46 {
        let b = digit_run(v, j + 1);
        if b < 0 {
            return None;
        }
        digits = digits or b > j + 1;
        j = b;
    }
    if not digits {
        return None;
    }
    if j < v.len() and (v[j] == 101 or v[j] == 69) {
        let mut k = j + 1;
        if k < v.len() and (v[k] == 43 or v[k] == 45) {
            k += 1;
        }
        let c = digit_run(v, k);
        if c <= k {
            return None;
        }
        j = c;
    }
    if j != v.len() {
        return None;
    }
    let mut t: Vec[i64] = Vec.new();
    for c in v.iter() {
        if c != 95 {
            t.push(c);
        }
    }
    match f64.parse(to_string(t)) {
        Ok(x) => Some(x),
        Err(_) => None,
    }
}

// ------------------------------------------------------------ base64

fn b64_value(c: i64) -> i64 {
    if c >= 65 and c <= 90 {
        return c - 65;
    }
    if c >= 97 and c <= 122 {
        return c - 71;
    }
    if c >= 48 and c <= 57 {
        return c + 4;
    }
    if c == 43 {
        return 62;
    }
    if c == 47 {
        return 63;
    }
    64
}

// binascii.a2b_base64 outside strict mode: anything off the alphabet is
// skipped, and padding ends the data once it completes a quad.
fn b64_decode(s: ref String) -> Result[Vec[i64], Exc] {
    let mut out: Vec[i64] = Vec.new();
    let mut quad = 0;
    let mut left = 0;
    let mut pads = 0;
    for c in cps(s).iter() {
        if c == 61 {
            if quad >= 2 {
                pads += 1;
                if quad + pads >= 4 {
                    return Ok(out);
                }
            }
            continue;
        }
        let v = b64_value(c);
        if v >= 64 {
            continue;
        }
        pads = 0;
        if quad == 0 {
            quad = 1;
            left = v;
        } else if quad == 1 {
            quad = 2;
            out.push(((left << 2) | (v >> 4)) & 255);
            left = v & 15;
        } else if quad == 2 {
            quad = 3;
            out.push(((left << 4) | (v >> 2)) & 255);
            left = v & 3;
        } else {
            quad = 0;
            out.push(((left << 6) | v) & 255);
            left = 0;
        }
    }
    if quad == 1 {
        return Err(py_exc("binascii.Error", f"Invalid base64-encoded string: number of data characters ({out.len() / 3 * 4 + 1}) cannot be 1 more than a multiple of 4"));
    }
    if quad != 0 {
        return Err(py_exc("binascii.Error", "Incorrect padding".to_string()));
    }
    Ok(out)
}

fn b64_char(n: i64) -> i64 {
    if n < 26 {
        return n + 65;
    }
    if n < 52 {
        return n + 71;
    }
    if n < 62 {
        return n - 4;
    }
    if n == 62 { 43 } else { 47 }
}

// base64.encodebytes: 76 characters to a line, each line ended.
fn b64_lines(b: ref Vec[i64]) -> String {
    let mut out: Vec[i64] = Vec.new();
    let mut start = 0;
    while start < b.len() {
        let end = if start + 57 < b.len() { start + 57 } else { b.len() };
        let mut k = start;
        while k < end {
            let n = end - k;
            let b0 = b[k];
            let b1 = if n > 1 { b[k + 1] } else { 0 };
            let b2 = if n > 2 { b[k + 2] } else { 0 };
            out.push(b64_char(b0 >> 2));
            out.push(b64_char(((b0 & 3) << 4) | (b1 >> 4)));
            out.push(if n > 1 { b64_char(((b1 & 15) << 2) | (b2 >> 6)) } else { 61 });
            out.push(if n > 2 { b64_char(b2 & 63) } else { 61 });
            k += 3;
        }
        out.push(10);
        start = end;
    }
    to_string(out)
}

// ------------------------------------------------------------ strptime

// One field of the regex _strptime builds for "%Y%m%dT%H:%M:%S", as its
// alternatives in the order re tries them; each is a run of character
// ranges.
fn alternatives(spec: Str) -> Vec[Vec[(i64, i64)]] {
    let mut out: Vec[Vec[(i64, i64)]] = Vec.new();
    for alt in split_cp(cp(spec), 124).iter() {
        let mut run: Vec[(i64, i64)] = Vec.new();
        let mut k = 0;
        while k < alt.len() {
            if alt[k] == 91 {
                run.push((alt[k + 1], alt[k + 3]));
                k += 5;
            } else if alt[k] == 68 {
                run.push((48, 57));
                k += 1;
            } else {
                run.push((alt[k], alt[k]));
                k += 1;
            }
        }
        out.push(run);
    }
    out
}

fn date_fields_re() -> Vec[Vec[Vec[(i64, i64)]]] {
    vec![
        alternatives("DDDD"),
        alternatives("1[0-2]|0[1-9]|[1-9]"),
        alternatives("3[0-1]|[1-2]D|0[1-9]|[1-9]| [1-9]"),
        alternatives("T"),
        alternatives("2[0-3]|[0-1]D|D"),
        alternatives(":"),
        alternatives("[0-5]D|D"),
        alternatives(":"),
        alternatives("6[0-1]|[0-5]D|D"),
    ]
}

fn fold(c: i64) -> i64 {
    if c >= 97 and c <= 122 { c - 32 } else { c }
}

// re.match with IGNORECASE and backtracking: where each field ends.
fn match_fields(fields: ref Vec[Vec[Vec[(i64, i64)]]], k: i64, s: ref Vec[i64], at: i64, ends: mut ref Vec[i64]) -> bool {
    if k == fields.len() {
        return true;
    }
    for alt in fields[k].iter() {
        if at + alt.len() > s.len() {
            continue;
        }
        let mut ok = true;
        let mut j = 0;
        while j < alt.len() {
            let c = fold(s[at + j]);
            let (lo, hi) = alt[j];
            if c < fold(lo) or c > fold(hi) {
                ok = false;
                break;
            }
            j += 1;
        }
        if ok {
            ends.push(at + alt.len());
            if match_fields(fields, k + 1, s, at + alt.len(), mut ends) {
                return true;
            }
            ends.pop();
        }
    }
    false
}

fn number_at(s: ref Vec[i64], a: i64, b: i64) -> i64 {
    let mut n = 0;
    let mut k = a;
    while k < b {
        if s[k] != 32 {
            n = n * 10 + s[k] - 48;
        }
        k += 1;
    }
    n
}

// datetime.strptime(data, "%Y%m%dT%H:%M:%S")
fn strptime(data: ref String) -> Result[Py, Exc] {
    let s = cps(data);
    let mut ends: Vec[i64] = Vec.new();
    if not match_fields(date_fields_re(), 0, s, 0, mut ends) {
        return Err(py_exc("ValueError", f"time data {pr(data)} does not match format '%Y%m%dT%H:%M:%S'"));
    }
    let end = ends[ends.len() - 1];
    if end != s.len() {
        return Err(py_exc("ValueError", f"unconverted data remains: {to_string(slice(s, end, s.len()))}"));
    }
    let y = number_at(s, 0, ends[0]);
    let m = number_at(s, ends[0], ends[1]);
    let d = number_at(s, ends[1], ends[2]);
    let hh = number_at(s, ends[3], ends[4]);
    let mm = number_at(s, ends[5], ends[6]);
    let ss = number_at(s, ends[7], ends[8]);
    if y < 1 or y > 9999 {
        return Err(py_exc("ValueError", f"year {y} is out of range"));
    }
    if d > days_in_month(y, m) {
        return Err(py_exc("ValueError", "day is out of range for month".to_string()));
    }
    if ss > 59 {
        return Err(py_exc("ValueError", "second must be in 0..59".to_string()));
    }
    Ok(py_date(y, m, d, hh, mm, ss))
}

// ------------------------------------------------------------ loads

// xmlrpc.client.Unmarshaller, fed by the parser below as expat feeds it.
struct Um {
    stack: Vec[Py],
    marks: Vec[i64],
    data: String,
    value: bool,
    typ: String,
    method: Option[String],
}

fn last_part(tag: ref String) -> String {
    let v = cps(tag);
    let mut k = v.len() - 1;
    while k >= 0 and v[k] != 58 {
        k -= 1;
    }
    to_string(slice(v, k + 1, v.len()))
}

fn handled(tag: ref String) -> bool {
    let t = tag.as_str();
    t == "nil" or t == "boolean" or t == "i1" or t == "i2" or t == "i4" or t == "i8" or t == "int" or t == "biginteger" or t == "double" or t == "float" or t == "string" or t == "name" or t == "array" or t == "struct" or t == "base64" or t == "dateTime.iso8601" or t == "value" or t == "params" or t == "fault" or t == "methodName"
}

fn um_start(u: mut ref Um, raw: ref String) -> Result[(), Exc] {
    let tag = last_part(raw);
    if tag == "array" or tag == "struct" {
        u.marks.push(u.stack.len());
    }
    u.data = String.new();
    if u.value and not handled(tag) {
        return Err(py_exc("xmlrpc.client.ResponseError", f"ResponseError({pr(f"unknown tag {pr(tag)}")})"));
    }
    u.value = tag == "value";
    Ok(())
}

fn um_data(u: mut ref Um, text: ref String) {
    u.data.push_str(text.as_str());
}

fn um_end(u: mut ref Um, raw: ref String) -> Result[(), Exc] {
    let tag = if handled(raw) { raw.clone() } else { last_part(raw) };
    if not handled(tag) {
        return Ok(());
    }
    let data = u.data.clone();
    let t = tag.as_str();
    if t == "nil" {
        u.stack.push(py_none());
        u.value = false;
    } else if t == "boolean" {
        if data == "0" {
            u.stack.push(py_bool(false));
        } else if data == "1" {
            u.stack.push(py_bool(true));
        } else {
            return Err(type_error("bad boolean value".to_string()));
        }
        u.value = false;
    } else if t == "i1" or t == "i2" or t == "i4" or t == "i8" or t == "int" or t == "biginteger" {
        match parse_int(data) {
            Some(n) => u.stack.push(py_int(n)),
            None => return Err(py_exc("ValueError", f"invalid literal for int() with base 10: {pr(data)}")),
        }
        u.value = false;
    } else if t == "double" or t == "float" {
        match parse_float(data) {
            Some(x) => u.stack.push(py_float(x)),
            None => return Err(py_exc("ValueError", f"could not convert string to float: {pr(data)}")),
        }
        u.value = false;
    } else if t == "string" or t == "name" {
        u.stack.push(py_str(data));
        u.value = false;
    } else if t == "array" {
        let mark = u.marks.pop().unwrap();
        let mut items: Vec[Py] = Vec.new();
        while u.stack.len() > mark {
            items.push(u.stack.pop().unwrap());
        }
        items.reverse();
        u.stack.push(py_list(items));
        u.value = false;
    } else if t == "struct" {
        let mark = u.marks.pop().unwrap();
        let mut items: Vec[Py] = Vec.new();
        while u.stack.len() > mark {
            items.push(u.stack.pop().unwrap());
        }
        items.reverse();
        let mut d = py(P_DICT);
        let mut k = 0;
        while k < items.len() {
            if k + 1 >= items.len() {
                return Err(py_exc("IndexError", "list index out of range".to_string()));
            }
            let key = items[k].clone();
            if key.t == P_LIST or key.t == P_DICT {
                return Err(type_error(f"unhashable type: '{type_name(key)}'"));
            }
            dict_set(mut d, key, items[k + 1].clone());
            k += 2;
        }
        u.stack.push(d);
        u.value = false;
    } else if t == "base64" {
        u.stack.push(py_bytes(b64_decode(data)?));
    } else if t == "dateTime.iso8601" {
        u.stack.push(strptime(data)?);
    } else if t == "value" {
        if u.value {
            u.stack.push(py_str(data));
            u.value = false;
        }
    } else if t == "params" {
        u.typ = "params".to_string();
    } else if t == "fault" {
        u.typ = "fault".to_string();
    } else {
        u.method = Some(data);
        u.typ = "methodName".to_string();
    }
    Ok(())
}

fn um_close(u: ref Um) -> Result[(Vec[Py], Option[String]), Exc] {
    if u.typ.len() == 0 or u.marks.len() > 0 {
        return Err(py_exc("xmlrpc.client.ResponseError", "ResponseError()".to_string()));
    }
    if u.typ == "fault" {
        if u.stack.len() == 0 {
            return Err(py_exc("IndexError", "list index out of range".to_string()));
        }
        let d = ref u.stack[0];
        if d.t != P_DICT {
            return Err(type_error(f"xmlrpc.client.Fault() argument after ** must be a mapping, not {type_name(d)}"));
        }
        let c = dict_find(d, py_text("faultCode"));
        let s = dict_find(d, py_text("faultString"));
        if c < 0 and s < 0 {
            return Err(type_error("Fault.__init__() missing 2 required positional arguments: 'faultCode' and 'faultString'".to_string()));
        }
        if c < 0 or s < 0 {
            let which = if c < 0 { "faultCode" } else { "faultString" };
            return Err(type_error(f"Fault.__init__() missing 1 required positional argument: '{which}'"));
        }
        return Err(fault(d.items[c].clone(), d.items[s].clone()));
    }
    Ok((u.stack.clone(), u.method.clone()))
}

// The XML parser, as much of expat as these bodies need: the prolog and
// epilog, elements, character and entity references, CDATA sections,
// comments and processing instructions, and expat's three structural
// errors with their positions.
struct Xr {
    s: Vec[i64],
    i: i64,
}

fn xr_at(x: ref Xr, k: i64) -> i64 {
    if x.i + k < x.s.len() { x.s[x.i + k] } else { -1 }
}

fn xr_looking(x: ref Xr, lit: Str) -> bool {
    let l = cp(lit);
    let mut k = 0;
    while k < l.len() {
        if xr_at(x, k) != l[k] {
            return false;
        }
        k += 1;
    }
    true
}

fn xr_skip_to(x: mut ref Xr, lit: Str) {
    while x.i < x.s.len() and not xr_looking(x, lit) {
        x.i += 1;
    }
    x.i += cp(lit).len();
}

fn xml_ws(c: i64) -> bool {
    c == 32 or c == 9 or c == 10 or c == 13
}

fn expat_error(x: ref Xr, what: Str, at: i64) -> Exc {
    let mut line = 1;
    let mut col = 0;
    let mut k = 0;
    while k < at {
        if x.s[k] == 10 {
            line += 1;
            col = 0;
        } else {
            col += 1;
        }
        k += 1;
    }
    py_exc("xml.parsers.expat.ExpatError", f"{what}: line {line}, column {col}")
}

fn xr_name(x: mut ref Xr) -> String {
    let start = x.i;
    while x.i < x.s.len() {
        let c = x.s[x.i];
        if xml_ws(c) or c == 47 or c == 62 or c == 61 {
            break;
        }
        x.i += 1;
    }
    to_string(slice(x.s, start, x.i))
}

fn xr_entity(x: mut ref Xr, out: mut ref Vec[i64]) {
    x.i += 1;
    let start = x.i;
    while xr_at(x, 0) != 59 {
        x.i += 1;
    }
    let name = slice(x.s, start, x.i);
    x.i += 1;
    if name.len() > 1 and name[0] == 35 {
        let mut n = 0;
        if name[1] == 120 {
            for c in slice(name, 2, name.len()).iter() {
                n = n * 16 + hex_val(c);
            }
        } else {
            for c in slice(name, 1, name.len()).iter() {
                n = n * 10 + c - 48;
            }
        }
        out.push(n);
        return;
    }
    let t = to_string(name);
    out.push(if t == "lt" { 60 } else if t == "gt" { 62 } else if t == "amp" { 38 } else if t == "quot" { 34 } else { 39 });
}

fn skip_misc(x: mut ref Xr) -> bool {
    while x.i < x.s.len() and xml_ws(x.s[x.i]) {
        x.i += 1;
    }
    if xr_looking(x, "<?") {
        xr_skip_to(mut x, "?>");
        return true;
    }
    if xr_looking(x, "<!--") {
        xr_skip_to(mut x, "-->");
        return true;
    }
    false
}

// xmlrpc.client.loads(data, use_builtin_types=True)
fn loads(text: ref String) -> Result[(Vec[Py], Option[String]), Exc] {
    let mut u = Um { stack: Vec.new(), marks: Vec.new(), data: String.new(), value: false, typ: String.new(), method: None };
    let mut x = Xr { s: normalize_newlines(cps(text)), i: 0 };
    while skip_misc(mut x) {
    }
    if x.i >= x.s.len() or xr_at(x, 0) != 60 {
        return Err(expat_error(x, if x.i >= x.s.len() { "no element found" } else { "syntax error" }, x.i));
    }
    let mut open: Vec[String] = Vec.new();
    let mut text_run: Vec[i64] = Vec.new();
    loop {
        if x.i >= x.s.len() {
            return Err(expat_error(x, "no element found", x.i));
        }
        let c = x.s[x.i];
        if c != 60 and c != 38 {
            text_run.push(c);
            x.i += 1;
            continue;
        }
        if c == 38 {
            xr_entity(mut x, mut text_run);
            continue;
        }
        if xr_looking(x, "<![CDATA[") {
            x.i += 9;
            while not xr_looking(x, "]]>") {
                text_run.push(x.s[x.i]);
                x.i += 1;
            }
            x.i += 3;
            continue;
        }
        if text_run.len() > 0 {
            um_data(mut u, to_string(text_run));
            text_run = Vec.new();
        }
        if xr_looking(x, "<!--") {
            xr_skip_to(mut x, "-->");
            continue;
        }
        if xr_looking(x, "<?") {
            xr_skip_to(mut x, "?>");
            continue;
        }
        if xr_looking(x, "</") {
            x.i += 2;
            let at = x.i;
            let name = xr_name(mut x);
            if open.len() == 0 or open[open.len() - 1] != name {
                return Err(expat_error(x, "mismatched tag", at));
            }
            xr_skip_to(mut x, ">");
            open.pop();
            um_end(mut u, name)?;
            if open.len() == 0 {
                break;
            }
            continue;
        }
        x.i += 1;
        let name = xr_name(mut x);
        let mut empty = false;
        loop {
            while xml_ws(xr_at(x, 0)) {
                x.i += 1;
            }
            let d = xr_at(x, 0);
            if d == 62 {
                x.i += 1;
                break;
            }
            if d == 47 {
                x.i += 2;
                empty = true;
                break;
            }
            xr_name(mut x);
            while xr_at(x, 0) != 34 and xr_at(x, 0) != 39 {
                x.i += 1;
            }
            let q = xr_at(x, 0);
            x.i += 1;
            while xr_at(x, 0) != q {
                x.i += 1;
            }
            x.i += 1;
        }
        um_start(mut u, name)?;
        if empty {
            um_end(mut u, name)?;
            if open.len() == 0 {
                break;
            }
        } else {
            open.push(name);
        }
    }
    loop {
        if not skip_misc(mut x) {
            break;
        }
    }
    if x.i < x.s.len() {
        return Err(expat_error(x, "junk after document element", x.i));
    }
    um_close(u)
}

fn normalize_newlines(s: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < s.len() {
        if s[k] == 13 {
            out.push(10);
            if k + 1 < s.len() and s[k + 1] == 10 {
                k += 1;
            }
        } else {
            out.push(s[k]);
        }
        k += 1;
    }
    out
}

// ------------------------------------------------------------ dumps

fn escape(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c == '&' {
            out.push_str("&amp;");
        } else if c == '<' {
            out.push_str("&lt;");
        } else if c == '>' {
            out.push_str("&gt;");
        } else {
            out.push(c);
        }
    }
    out
}

// xmlrpc.client.Marshaller with allow_none off
fn dump(v: ref Py, out: mut ref String) -> Result[(), Exc] {
    if v.t == P_NONE {
        return Err(type_error("cannot marshal None unless allow_none is enabled".to_string()));
    }
    if v.t == P_BOOL {
        out.push_str(f"<value><boolean>{v.i}</boolean></value>\n");
    } else if v.t == P_INT {
        if v.i > 2147483647 or v.i < -2147483648 {
            return Err(py_exc("OverflowError", "int exceeds XML-RPC limits".to_string()));
        }
        out.push_str(f"<value><int>{v.i}</int></value>\n");
    } else if v.t == P_FLOAT {
        out.push_str(f"<value><double>{float_repr(v.f)}</double></value>\n");
    } else if v.t == P_STR {
        out.push_str(f"<value><string>{escape(v.s)}</string></value>\n");
    } else if v.t == P_BYTES {
        out.push_str(f"<value><base64>\n{b64_lines(v.by)}</base64></value>\n");
    } else if v.t == P_LIST {
        out.push_str("<value><array><data>\n");
        for item in v.items.iter() {
            dump(item, mut out)?;
        }
        out.push_str("</data></array></value>\n");
    } else if v.t == P_DICT {
        out.push_str("<value><struct>\n");
        let mut k = 0;
        while k < v.keys.len() {
            out.push_str("<member>\n");
            if v.keys[k].t != P_STR {
                return Err(type_error("dictionary key must be string".to_string()));
            }
            out.push_str(f"<name>{escape(v.keys[k].s)}</name>\n");
            dump(v.items[k], mut out)?;
            out.push_str("</member>\n");
            k += 1;
        }
        out.push_str("</struct></value>\n");
    } else if v.t == P_DATE {
        out.push_str(f"<value><dateTime.iso8601>{iso8601(v)}</dateTime.iso8601></value>\n");
    } else {
        return Err(type_error(f"cannot marshal {type_name(v)} objects"));
    }
    Ok(())
}

fn response_text(body: ref String) -> String {
    f"<?xml version='1.0'?>\n<methodResponse>\n{body}</methodResponse>\n"
}

fn dumps_params(params: ref Vec[Py]) -> Result[String, Exc] {
    let mut out = "<params>\n".to_string();
    for p in params.iter() {
        out.push_str("<param>\n");
        dump(p, mut out)?;
        out.push_str("</param>\n");
    }
    out.push_str("</params>\n");
    Ok(response_text(out))
}

fn dumps_fault(code: ref Py, string: ref Py) -> Result[String, Exc] {
    let mut d = py(P_DICT);
    dict_set(mut d, py_text("faultCode"), code.clone());
    dict_set(mut d, py_text("faultString"), string.clone());
    let mut out = "<fault>\n".to_string();
    dump(d, mut out)?;
    out.push_str("</fault>\n");
    Ok(response_text(out))
}
// ------------------------------------------------------------ the service

// Python's + between two values.
fn py_add(a: ref Py, b: ref Py) -> Result[Py, Exc] {
    if is_number(a) and is_number(b) {
        if is_intlike(a) and is_intlike(b) {
            return Ok(py_int(a.i + b.i));
        }
        return Ok(py_float(as_float(a) + as_float(b)));
    }
    if a.t == P_STR {
        if b.t == P_STR {
            return Ok(py_str(f"{a.s}{b.s}"));
        }
        return Err(type_error(f"can only concatenate str (not \"{type_name(b)}\") to str"));
    }
    if a.t == P_LIST {
        if b.t == P_LIST {
            let mut items = a.items.clone();
            for x in b.items.iter() {
                items.push(x.clone());
            }
            return Ok(py_list(items));
        }
        return Err(type_error(f"can only concatenate list (not \"{type_name(b)}\") to list"));
    }
    if a.t == P_BYTES {
        if b.t == P_BYTES {
            let mut by = a.by.clone();
            push_all(mut by, b.by);
            return Ok(py_bytes(by));
        }
        return Err(type_error(f"can't concat {type_name(b)} to bytes"));
    }
    if a.t == P_DATE and b.t == P_DELTA {
        let t = a.i + b.i;
        if t < 86400 or t >= (MAX_ORD + 1) * 86400 {
            return Err(py_exc("OverflowError", "date value out of range".to_string()));
        }
        let mut v = py(P_DATE);
        v.i = t;
        return Ok(v);
    }
    Err(type_error(f"unsupported operand type(s) for +: '{type_name(a)}' and '{type_name(b)}'"))
}

// What `for x in v` walks, or the TypeError for a value that is not
// iterable (worded by the caller).
fn iterate(v: ref Py) -> Option[Vec[Py]] {
    if v.t == P_LIST {
        return Some(v.items.clone());
    }
    if v.t == P_DICT {
        return Some(v.keys.clone());
    }
    if v.t == P_STR {
        let mut out: Vec[Py] = Vec.new();
        for c in v.s.chars() {
            out.push(py_str(c.to_string()));
        }
        return Some(out);
    }
    if v.t == P_BYTES {
        let mut out: Vec[Py] = Vec.new();
        for b in v.by.iter() {
            out.push(py_int(b));
        }
        return Some(out);
    }
    None
}

fn not_iterable(v: ref Py) -> Exc {
    type_error(f"'{type_name(v)}' object is not iterable")
}

// sum(values): CPython's int loop, then its compensated float loop,
// then plain additions.
fn py_sum(values: ref Py) -> Result[Py, Exc] {
    let items = match iterate(values) {
        Some(v) => v,
        None => return Err(not_iterable(values)),
    };
    let mut k = 0;
    let mut acc: i64 = 0;
    while k < items.len() and is_intlike(items[k]) {
        acc += items[k].i;
        k += 1;
    }
    if k == items.len() {
        return Ok(py_int(acc));
    }
    let mut result = py_add(py_int(acc), items[k])?;
    k += 1;
    if result.t == P_FLOAT {
        let mut f = result.f;
        let mut c = 0.0;
        loop {
            if k == items.len() {
                if c != 0.0 and not is_inf_or_nan(c) {
                    f += c;
                }
                return Ok(py_float(f));
            }
            let item = ref items[k];
            if item.t == P_FLOAT {
                let x = item.f;
                let t = f + x;
                if f.abs() >= x.abs() {
                    c += (f - t) + x;
                } else {
                    c += (x - t) + f;
                }
                f = t;
                k += 1;
                continue;
            }
            if is_intlike(item) {
                f += item.i as f64;
                k += 1;
                continue;
            }
            if c != 0.0 and not is_inf_or_nan(c) {
                f += c;
            }
            result = py_float(f);
            break;
        }
    }
    while k < items.len() {
        result = py_add(result, items[k])?;
        k += 1;
    }
    Ok(result)
}

fn is_inf_or_nan(x: f64) -> bool {
    x != x or x - x != 0.0
}

fn py_div(a: ref Py, b: ref Py) -> Result[Py, Exc] {
    if not (is_number(a) and is_number(b)) {
        return Err(type_error(f"unsupported operand type(s) for /: '{type_name(a)}' and '{type_name(b)}'"));
    }
    if as_float(b) == 0.0 {
        let msg = if is_intlike(a) and is_intlike(b) { "division by zero" } else { "float division by zero" };
        return Err(py_exc("ZeroDivisionError", msg.to_string()));
    }
    Ok(py_float(as_float(a) / as_float(b)))
}

fn py_join(sep: ref Py, items: ref Py) -> Result[Py, Exc] {
    if sep.t != P_STR and sep.t != P_BYTES {
        return Err(py_exc("AttributeError", f"'{type_name(sep)}' object has no attribute 'join'"));
    }
    let parts = match iterate(items) {
        Some(v) => v,
        None => return Err(type_error("can only join an iterable".to_string())),
    };
    let mut k = 0;
    while k < parts.len() {
        if parts[k].t != sep.t {
            let want = if sep.t == P_STR { "str instance" } else { "a bytes-like object" };
            return Err(type_error(f"sequence item {k}: expected {want}, {type_name(parts[k])} found"));
        }
        k += 1;
    }
    if sep.t == P_STR {
        let mut out = String.new();
        k = 0;
        while k < parts.len() {
            if k > 0 {
                out.push_str(sep.s.as_str());
            }
            out.push_str(parts[k].s.as_str());
            k += 1;
        }
        return Ok(py_str(out));
    }
    let mut out: Vec[i64] = Vec.new();
    k = 0;
    while k < parts.len() {
        if k > 0 {
            push_all(mut out, sep.by);
        }
        push_all(mut out, parts[k].by);
        k += 1;
    }
    Ok(py_bytes(out))
}

fn is_bytes_space(c: i64) -> bool {
    c == 32 or (c >= 9 and c <= 13)
}

// split() with no separator: runs of whitespace, none at the ends.
fn split_runs(v: ref Vec[i64], space: bool) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    let mut inword = false;
    for c in v.iter() {
        let ws = if space { is_py_space(c) or c == 0x85 or c == 0xA0 } else { is_bytes_space(c) };
        if ws {
            if inword {
                out.push(cur);
                cur = Vec.new();
                inword = false;
            }
        } else {
            cur.push(c);
            inword = true;
        }
    }
    if inword {
        out.push(cur);
    }
    out
}

fn split_on(v: ref Vec[i64], sep: ref Vec[i64]) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut start = 0;
    let mut k = 0;
    while k + sep.len() <= v.len() {
        let mut j = 0;
        while j < sep.len() and v[k + j] == sep[j] {
            j += 1;
        }
        if j == sep.len() {
            out.push(slice(v, start, k));
            k += sep.len();
            start = k;
        } else {
            k += 1;
        }
    }
    out.push(slice(v, start, v.len()));
    out
}

fn py_split(text: ref Py, sep: ref Py) -> Result[Py, Exc] {
    if text.t == P_STR {
        let parts = if sep.t == P_NONE {
            split_runs(cps(text.s), true)
        } else if sep.t == P_STR {
            if sep.s.len() == 0 {
                return Err(py_exc("ValueError", "empty separator".to_string()));
            }
            split_on(cps(text.s), cps(sep.s))
        } else {
            return Err(type_error(f"must be str or None, not {type_name(sep)}"));
        };
        let mut out: Vec[Py] = Vec.new();
        for p in parts.iter() {
            out.push(py_str(to_string(p)));
        }
        return Ok(py_list(out));
    }
    if text.t == P_BYTES {
        let parts = if sep.t == P_NONE {
            split_runs(text.by, false)
        } else if sep.t == P_BYTES {
            if sep.by.len() == 0 {
                return Err(py_exc("ValueError", "empty separator".to_string()));
            }
            split_on(text.by, sep.by)
        } else {
            return Err(type_error(f"a bytes-like object is required, not '{type_name(sep)}'"));
        };
        let mut out: Vec[Py] = Vec.new();
        for p in parts.iter() {
            out.push(py_bytes(p.clone()));
        }
        return Ok(py_list(out));
    }
    Err(py_exc("AttributeError", f"'{type_name(text)}' object has no attribute 'split'"))
}

fn py_len(v: ref Py) -> Result[Py, Exc] {
    if v.t == P_STR {
        return Ok(py_int(cps(v.s).len()));
    }
    if v.t == P_BYTES {
        return Ok(py_int(v.by.len()));
    }
    if v.t == P_LIST {
        return Ok(py_int(v.items.len()));
    }
    if v.t == P_DICT {
        return Ok(py_int(v.keys.len()));
    }
    Err(type_error(f"object of type '{type_name(v)}' has no len()"))
}

fn delta_part(v: ref Py, which: Str) -> Result[i64, Exc] {
    if is_intlike(v) {
        return Ok(v.i);
    }
    if v.t == P_FLOAT {
        return Ok(v.f as i64);
    }
    Err(type_error(f"unsupported type for timedelta {which} component: {type_name(v)}"))
}

fn py_shift(when: ref Py, days: ref Py, seconds: ref Py) -> Result[Py, Exc] {
    let d = delta_part(days, "days")?;
    let s = delta_part(seconds, "seconds")?;
    let mut delta = py(P_DELTA);
    delta.i = d * 86400 + s;
    py_add(when, delta)
}

// The key-value store the kv.* methods share across requests.
struct Store {
    keys: Vec[String],
    values: Vec[Py],
}

fn store_find(st: ref Store, k: ref String) -> i64 {
    let mut n = 0;
    while n < st.keys.len() {
        if st.keys[n] == k {
            return n;
        }
        n += 1;
    }
    -1
}

fn need_key(key: ref Py) -> Result[(), Exc] {
    if key.t != P_STR {
        return Err(fault(py_int(400), py_text("key must be a string")));
    }
    Ok(())
}

fn no_key(key: ref Py) -> Exc {
    fault(py_int(404), py_str(f"no such key: {repr(key)}"))
}

// ------------------------------------------------------------ dispatch

// A registered method: its XML-RPC name, the Python function's
// qualified name and parameters (for the TypeErrors a wrong count
// raises), and its docstring.
#[derive(Clone)]
struct Method {
    name: String,
    qual: String,
    params: Vec[String],
    star: bool,
    doc: String,
}

fn method(name: Str, qual: Str, params: Str, doc: Str) -> Method {
    let mut ps: Vec[String] = Vec.new();
    for p in split_cp(cp(params), 32).iter() {
        if p.len() > 0 {
            ps.push(to_string(p));
        }
    }
    Method { name: name.to_string(), qual: qual.to_string(), params: ps, star: false, doc: doc.to_string() }
}

fn methods() -> Vec[Method] {
    let mut v: Vec[Method] = Vec.new();
    v.push(method("math.add", "add", "a b", "Return a + b."));
    v.push(method("math.div", "div", "a b", "Return a / b."));
    v.push(method("math.sum", "total", "values", "Return the sum of a list of numbers."));
    v.push(method("text.join", "join", "sep items", "Join strings with a separator."));
    v.push(method("text.split", "split", "text sep", "Split a string on a separator, or on runs of whitespace."));
    v.push(method("kv.put", "put", "key value", "Store a value under a key."));
    v.push(method("kv.get", "get", "key", "Return the value stored under a key."));
    v.push(method("kv.pop", "pop", "key", "Remove a key and return its value."));
    v.push(method("kv.keys", "keys", "", "Return the stored keys in order."));
    v.push(method("blob.concat", "concat", "blobs", "Join a list of byte strings."));
    v.push(method("blob.size", "size", "value", "Return the length of a value."));
    v.push(method("time.shift", "shift", "when days seconds", "Move a time by a number of days and seconds."));
    v.push(method("sys.void", "void", "", "Return nothing."));
    let mut echo = method("echo", "echo", "", "Return the arguments as a list.");
    echo.star = true;
    v.push(echo);
    let d = "SimpleXMLRPCDispatcher.";
    v.push(method("system.listMethods", f"{d}system_listMethods".as_str(), "self", "system.listMethods() => ['add', 'subtract', 'multiple']\n\nReturns a list of the methods supported by the server."));
    v.push(method("system.methodSignature", f"{d}system_methodSignature".as_str(), "self method_name", "system.methodSignature('add') => [double, int, int]\n\nReturns a list describing the signature of the method. In the\nabove example, the add method takes two integers as arguments\nand returns a double result.\n\nThis server does NOT support system.methodSignature."));
    v.push(method("system.methodHelp", f"{d}system_methodHelp".as_str(), "self method_name", "system.methodHelp('add') => \"Adds two integers together\"\n\nReturns a string containing documentation for the specified method."));
    v.push(method("system.multicall", f"{d}system_multicall".as_str(), "self call_list", "system.multicall([{'methodName': 'add', 'params': [2, 2]}, ...]) => [[4], ...]\n\nAllows the caller to package multiple XML-RPC calls into a single\nrequest.\n\nSee http://www.xmlrpc.com/discuss/msgReader$1208"));
    v
}

fn plural(n: i64, word: Str) -> String {
    if n == 1 { word.to_string() } else { f"{word}s" }
}

// The TypeError Python raises for a call with the wrong number of
// positional arguments, or None when the count fits.
fn arity_error(m: ref Method, given: i64) -> Option[Exc] {
    if m.star {
        return None;
    }
    let bound = m.params.len() > 0 and m.params[0] == "self";
    let want = m.params.len();
    let got = if bound { given + 1 } else { given };
    if got > want {
        let verb = if got == 1 { "was" } else { "were" };
        return Some(type_error(f"{m.qual}() takes {want} positional {plural(want, "argument")} but {got} {verb} given"));
    }
    if got < want {
        let missing = slice_strings(m.params, got, want);
        let mut names = String.new();
        let mut k = 0;
        while k < missing.len() {
            if k > 0 {
                names.push_str(if k == missing.len() - 1 { if missing.len() > 2 { ", and " } else { " and " } } else { ", " });
            }
            names.push_str(f"'{missing[k]}'");
            k += 1;
        }
        return Some(type_error(f"{m.qual}() missing {missing.len()} required positional {plural(missing.len(), "argument")}: {names}"));
    }
    None
}

fn slice_strings(v: ref Vec[String], a: i64, b: i64) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut k = a;
    while k < b {
        out.push(v[k].clone());
        k += 1;
    }
    out
}

struct Dispatcher {
    methods: Vec[Method],
    store: Store,
}

fn find_method(srv: ref Dispatcher, name: ref Py) -> i64 {
    if name.t != P_STR {
        return -1;
    }
    let mut k = 0;
    while k < srv.methods.len() {
        if srv.methods[k].name == name.s {
            return k;
        }
        k += 1;
    }
    -1
}

fn unhashable(v: ref Py) -> Option[Exc] {
    if v.t == P_LIST or v.t == P_DICT {
        return Some(type_error(f"unhashable type: '{type_name(v)}'"));
    }
    None
}

// SimpleXMLRPCDispatcher._dispatch: func(*params)
fn dispatch(srv: mut ref Dispatcher, name: ref Py, args: ref Py) -> Result[Py, Exc] {
    if let Some(e) = unhashable(name) {
        return Err(e);
    }
    let at = find_method(srv, name);
    if at < 0 {
        return Err(py_exc("Exception", f"method \"{py_to_str(name)}\" is not supported"));
    }
    let m = srv.methods[at].clone();
    let p = match iterate(args) {
        Some(v) => v,
        None => return Err(type_error(f"__main__.{m.qual}() argument after * must be an iterable, not {type_name(args)}")),
    };
    if let Some(e) = arity_error(m, p.len()) {
        return Err(e);
    }
    let f = m.qual.as_str();
    if f == "add" {
        return py_add(p[0], p[1]);
    }
    if f == "div" {
        return py_div(p[0], p[1]);
    }
    if f == "total" {
        return py_sum(p[0]);
    }
    if f == "join" {
        return py_join(p[0], p[1]);
    }
    if f == "split" {
        return py_split(p[0], p[1]);
    }
    if f == "put" {
        need_key(p[0])?;
        let at = store_find(srv.store, p[0].s);
        if at >= 0 {
            srv.store.values[at] = p[1].clone();
        } else {
            srv.store.keys.push(p[0].s.clone());
            srv.store.values.push(p[1].clone());
        }
        return Ok(py_bool(true));
    }
    if f == "get" or f == "pop" {
        need_key(p[0])?;
        let at = store_find(srv.store, p[0].s);
        if at < 0 {
            return Err(no_key(p[0]));
        }
        let v = srv.store.values[at].clone();
        if f == "pop" {
            srv.store.keys.remove(at);
            srv.store.values.remove(at);
        }
        return Ok(v);
    }
    if f == "keys" {
        let mut ks = srv.store.keys.clone();
        sort_strings(mut ks);
        let mut out: Vec[Py] = Vec.new();
        for k in ks.iter() {
            out.push(py_str(k.clone()));
        }
        return Ok(py_list(out));
    }
    if f == "concat" {
        return py_join(py_bytes(Vec.new()), p[0]);
    }
    if f == "size" {
        return py_len(p[0]);
    }
    if f == "shift" {
        return py_shift(p[0], p[1], p[2]);
    }
    if f == "void" {
        return Ok(py_none());
    }
    if f == "echo" {
        return Ok(py_list(p.clone()));
    }
    let n = m.name.as_str();
    if n == "system.listMethods" {
        let mut names: Vec[String] = Vec.new();
        for x in srv.methods.iter() {
            names.push(x.name.clone());
        }
        sort_strings(mut names);
        let mut out: Vec[Py] = Vec.new();
        for x in names.iter() {
            out.push(py_str(x.clone()));
        }
        return Ok(py_list(out));
    }
    if n == "system.methodSignature" {
        return Ok(py_text("signatures not supported"));
    }
    if n == "system.methodHelp" {
        if let Some(e) = unhashable(p[0]) {
            return Err(e);
        }
        let at = find_method(srv, p[0]);
        return Ok(if at < 0 { py_text("") } else { py_str(srv.methods[at].doc.clone()) });
    }
    multicall(mut srv, p[0])
}

// call[key], as Python subscripts each kind of value with a str
fn subscript(call: ref Py, key: Str) -> Result[Py, Exc] {
    if call.t == P_DICT {
        let at = dict_find(call, py_text(key));
        if at < 0 {
            return Err(py_exc("KeyError", pr(key.to_string())));
        }
        return Ok(call.items[at].clone());
    }
    if call.t == P_LIST {
        return Err(type_error("list indices must be integers or slices, not str".to_string()));
    }
    if call.t == P_STR {
        return Err(type_error("string indices must be integers, not 'str'".to_string()));
    }
    if call.t == P_BYTES {
        return Err(type_error("byte indices must be integers or slices, not str".to_string()));
    }
    Err(type_error(f"'{type_name(call)}' object is not subscriptable"))
}

// SimpleXMLRPCDispatcher.system_multicall: a failing call becomes a fault
// struct in the results, but a malformed entry fails the whole request.
fn multicall(srv: mut ref Dispatcher, calls: ref Py) -> Result[Py, Exc] {
    let entries = match iterate(calls) {
        Some(v) => v,
        None => return Err(not_iterable(calls)),
    };
    let mut results: Vec[Py] = Vec.new();
    for call in entries.iter() {
        let name = subscript(call, "methodName")?;
        let params = subscript(call, "params")?;
        match dispatch(mut srv, name, params) {
            Ok(v) => results.push(py_list(vec![v])),
            Err(e) => {
                let mut d = py(P_DICT);
                if e.fault {
                    dict_set(mut d, py_text("faultCode"), e.code.clone());
                    dict_set(mut d, py_text("faultString"), e.string.clone());
                } else {
                    dict_set(mut d, py_text("faultCode"), py_int(1));
                    dict_set(mut d, py_text("faultString"), py_str(exc_line(e)));
                }
                results.push(d);
            }
        }
    }
    Ok(py_list(results))
}

fn fault_response(e: ref Exc) -> String {
    let r = if e.fault { dumps_fault(e.code, e.string) } else { dumps_fault(py_int(1), py_str(exc_line(e))) };
    match r {
        Ok(t) => t,
        Err(x) => f"(marshalling the fault failed: {x.text})\n",
    }
}

// SimpleXMLRPCDispatcher._marshaled_dispatch
fn marshaled_dispatch(srv: mut ref Dispatcher, body: ref String) -> String {
    let (params, name) = match loads(body) {
        Ok(r) => r,
        Err(e) => return fault_response(e),
    };
    let method = match name {
        Some(n) => py_str(n),
        None => py_none(),
    };
    let r = match dispatch(mut srv, method, py_list(params)) {
        Ok(v) => dumps_params(vec![v]),
        Err(e) => Err(e),
    };
    match r {
        Ok(t) => t,
        Err(e) => fault_response(e),
    }
}
// ------------------------------------------------------------ files

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn unhex(s: ref String) -> Vec[u8] {
    let d = cps(s);
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < d.len() {
        out.push((hex_val(d[i]) * 16 + hex_val(d[i + 1])) as u8);
        i += 2;
    }
    out
}

fn write_data() -> Result[(), String] {
    if fs.create_dir_all("data/requests".to_string()).is_err() {
        return Err("cannot create data/requests".to_string());
    }
    for file in data_files() {
        let p = f"data/{file.path}";
        let r = if file.hex { fs.write_bytes(p.clone(), unhex(file.body)) } else { fs.write(p.clone(), file.body.clone()) };
        if r.is_err() {
            return Err(f"cannot write {p}");
        }
    }
    Ok(())
}

// ------------------------------------------------------------ main

fn run() -> Result[(), String] {
    write_data()?;
    let mut names = match fs.read_dir("data/requests".to_string()) {
        Ok(v) => v,
        Err(_) => return Err("cannot list data/requests".to_string()),
    };
    sort_strings(mut names);
    let mut srv = Dispatcher { methods: methods(), store: Store { keys: Vec.new(), values: Vec.new() } };
    for name in names.iter() {
        let body = match fs.read_to_string(f"data/requests/{name}") {
            Ok(t) => t,
            Err(_) => return Err(f"cannot read {name}"),
        };
        println(f"== {name}");
        match loads(body) {
            Ok((params, method)) => {
                let m = match method {
                    Some(n) => pr(n),
                    None => "None".to_string(),
                };
                println(f"loads {m} {tuple_repr(params)}");
            }
            Err(e) => {
                if e.fault {
                    println(f"loads ! Fault {repr(e.code)} {repr(e.string)}");
                } else {
                    println(f"loads ! {exc_name(e)}: {e.text}");
                }
            }
        }
        let out = marshaled_dispatch(mut srv, body);
        for line in split_cp(cps(out), 10).iter() {
            println(f"| {to_string(line)}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        eprintln(e);
    }
}
// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    v
}

