// mini_email_validator: email addresses as email-validator 2.2.0 checks
// them, the library FastAPI and pydantic call for EmailStr and that
// sign-up forms use to turn what a user typed into an address worth
// storing. The port covers:
// - splitting off a display name ("Name <addr>"), quoted names and the
//   unquoting of their escapes;
// - the local part: dot-atom, internationalized characters, quoted
//   strings, the unsafe-character categories and their displays, and
//   case-folded RFC 2142 role names;
// - the domain: UTS #46 mapping, NFC, label rules and IDNA 2008 through
//   the IDNA code of mini_idna, special-use and test names, and length
//   limits on the ASCII and Unicode forms;
// - domain literals, [IPv4] and [IPv6:...], through the address code of
//   mini_ipaddress;
// - deliverability: MX records with the null MX, the A and AAAA
//   fallback for globally routable addresses only, the reject-all SPF
//   record, and the DNS failures that leave deliverability unknown;
// - the normalized, ASCII and SMTPUTF8 results, as_constructor and the
//   JSON dictionary, and the python -m email_validator command line;
// - a sign-up log that keeps one account per normalized address.
//
// DNS answers come from data/dns.tsv, the way upstream's own tests
// replay a cache of real answers. expected.out is the output of
// oracle.py, which runs the jobs through email-validator itself.

// ------------------------------------------------------------ text

fn chars_of(s: Str) -> Vec[char] {
    s.chars().collect()
}

fn str_of(cs: ref Vec[char]) -> String {
    let mut s = String.new();
    for c in cs.iter() {
        s.push(*c);
    }
    s
}

fn sub_chars(cs: ref Vec[char], from: i64, to: i64) -> Vec[char] {
    let mut v: Vec[char] = Vec.new();
    for i in from..to {
        v.push(cs[i]);
    }
    v
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

fn ascii_lower(c: char) -> char {
    if c >= 'A' and c <= 'Z' {
        char.try_from((c as u32) + 32).unwrap_or(c)
    } else {
        c
    }
}

fn hex_char(n: u32) -> char {
    let h: Vec[char] = "0123456789abcdef".chars().collect();
    h[(n & 15) as i64]
}

// n in lowercase hex, padded with zeros to width digits.
fn hex_pad(n: u32, width: i64) -> String {
    let mut ds: Vec[char] = Vec.new();
    let mut m = n;
    while m > 0 {
        ds.push(hex_char(m));
        m = m / 16;
    }
    while ds.len() < width {
        ds.push('0');
    }
    let mut s = String.new();
    let mut i = ds.len() - 1;
    while i >= 0 {
        s.push(ds[i]);
        i -= 1;
    }
    s
}

fn hex_parse(s: Str) -> u64 {
    let mut n: u64 = 0;
    for c in s.chars() {
        let d = if c >= '0' and c <= '9' {
            (c as u32) - ('0' as u32)
        } else {
            (c as u32) - ('a' as u32) + 10
        };
        n = n * 16 + (d as u64);
    }
    n
}

fn dec_parse(s: Str) -> i64 {
    let mut n: i64 = 0;
    for c in s.chars() {
        n = n * 10 + ((c as u32) - ('0' as u32)) as i64;
    }
    n
}

// ------------------------------------------------------------ JSON in

// The jobs file holds strings, numbers, booleans, null, arrays and
// objects. A number keeps its text.
#[derive(Clone)]
enum J {
    S(String),
    N(String),
    F(f64),
    A(Vec[J]),
    O(Vec[(String, J)]),
    B(bool),
    Null,
}

fn json_space(c: char) -> bool {
    c == ' ' or c == '\n' or c == '\r' or c == '\t'
}

fn json_num_char(c: char) -> bool {
    (c >= '0' and c <= '9') or c == '-' or c == '+' or c == '.' or c == 'e' or c == 'E'
}

struct JsonIn {
    cs: Vec[char],
    pos: i64,
}

impl JsonIn {
    fn ws(mut ref self) {
        while self.pos < self.cs.len() and json_space(self.cs[self.pos]) {
            self.pos += 1;
        }
    }

    fn word(mut ref self, w: Str) -> bool {
        let wc: Vec[char] = w.chars().collect();
        if self.pos + wc.len() > self.cs.len() {
            return false;
        }
        let mut k = 0;
        while k < wc.len() {
            if self.cs[self.pos + k] != wc[k] {
                return false;
            }
            k += 1;
        }
        self.pos += wc.len();
        true
    }

    fn hex4(mut ref self) -> u32 {
        let mut n: u32 = 0;
        let mut k = 0;
        while k < 4 {
            let c = ascii_lower(self.cs[self.pos]);
            let d = if c >= '0' and c <= '9' {
                (c as u32) - ('0' as u32)
            } else {
                (c as u32) - ('a' as u32) + 10
            };
            n = n * 16 + d;
            self.pos += 1;
            k += 1;
        }
        n
    }

    fn value(mut ref self) -> Result[J, String] {
        self.ws();
        if self.pos >= self.cs.len() {
            return Err("unexpected end of JSON".to_string());
        }
        let c = self.cs[self.pos];
        if c == '[' {
            self.pos += 1;
            let mut items: Vec[J] = Vec.new();
            self.ws();
            if self.pos < self.cs.len() and self.cs[self.pos] == ']' {
                self.pos += 1;
                return Ok(J.A(items));
            }
            loop {
                items.push(self.value()?);
                self.ws();
                if self.pos >= self.cs.len() {
                    return Err("unterminated JSON array".to_string());
                }
                let d = self.cs[self.pos];
                self.pos += 1;
                if d == ']' {
                    return Ok(J.A(items));
                }
                if d != ',' {
                    return Err(f"bad JSON array separator {d}");
                }
            }
        }
        if c == '{' {
            self.pos += 1;
            let mut members: Vec[(String, J)] = Vec.new();
            self.ws();
            if self.pos < self.cs.len() and self.cs[self.pos] == '}' {
                self.pos += 1;
                return Ok(J.O(members));
            }
            loop {
                let key = match self.value()? {
                    J.S(k) => k,
                    _ => return Err("JSON object key is not a string".to_string()),
                };
                self.ws();
                if self.pos >= self.cs.len() or self.cs[self.pos] != ':' {
                    return Err("missing ':' in JSON object".to_string());
                }
                self.pos += 1;
                let v = self.value()?;
                members.push((key, v));
                self.ws();
                if self.pos >= self.cs.len() {
                    return Err("unterminated JSON object".to_string());
                }
                let d = self.cs[self.pos];
                self.pos += 1;
                if d == '}' {
                    return Ok(J.O(members));
                }
                if d != ',' {
                    return Err(f"bad JSON object separator {d}");
                }
            }
        }
        if self.word("true") {
            return Ok(J.B(true));
        }
        if self.word("false") {
            return Ok(J.B(false));
        }
        if self.word("null") {
            return Ok(J.Null);
        }
        if c == '-' or (c >= '0' and c <= '9') {
            let st = self.pos;
            while self.pos < self.cs.len() and json_num_char(self.cs[self.pos]) {
                self.pos += 1;
            }
            return Ok(J.N(str_of(sub_chars(self.cs, st, self.pos))));
        }
        if c != '"' {
            return Err(f"unexpected JSON character {c}");
        }
        self.pos += 1;
        let mut s = String.new();
        while self.pos < self.cs.len() {
            let d = self.cs[self.pos];
            self.pos += 1;
            if d == '"' {
                return Ok(J.S(s));
            }
            if d != '\\' {
                s.push(d);
                continue;
            }
            let e = self.cs[self.pos];
            self.pos += 1;
            if e == 'n' {
                s.push('\n');
            } else if e == 't' {
                s.push('\t');
            } else if e == 'r' {
                s.push('\r');
            } else if e == 'b' {
                s.push('\u{8}');
            } else if e == 'f' {
                s.push('\u{c}');
            } else if e == 'u' {
                let mut n = self.hex4();
                if n >= 0xD800 and n < 0xDC00 {
                    self.pos += 2;
                    let lo = self.hex4();
                    n = 0x10000 + ((n - 0xD800) << 10) + (lo - 0xDC00);
                }
                s.push(char.try_from(n).unwrap_or('?'));
            } else {
                s.push(e);
            }
        }
        Err("unterminated JSON string".to_string())
    }
}

fn json_line(l: ref String) -> Result[J, String] {
    let mut p = JsonIn { cs: l.chars().collect(), pos: 0 };
    p.value()
}

fn j_get(j: ref J, key: Str) -> J {
    match j {
        J.O(members) => {
            for (k, v) in members.iter() {
                if k == key {
                    return v.clone();
                }
            }
            J.Null
        }
        _ => J.Null,
    }
}

fn j_str(j: ref J, key: Str) -> String {
    match j_get(j, key) {
        J.S(s) => s,
        _ => String.new(),
    }
}

fn j_bool(j: ref J, key: Str) -> bool {
    match j_get(j, key) {
        J.B(b) => b,
        _ => false,
    }
}

fn j_strs(j: ref J, key: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    if let J.A(items) = j_get(j, key) {
        for it in items.iter() {
            if let J.S(s) = it {
                out.push(s.clone());
            }
        }
    }
    out
}

// Whether the object has the member at all.
fn j_present(j: ref J, key: Str) -> bool {
    if let J.O(members) = j {
        for (k, _) in members.iter() {
            if k == key {
                return true;
            }
        }
    }
    false
}


// ------------------------------------------------------------ code points

// Text is handled as code points, since a decoded A-label can hold lone
// surrogates, which Python's str allows and a char does not.
fn cps_of(s: Str) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s.chars() {
        out.push((c as u32) as i64);
    }
    out
}

fn ascii_cps(s: Str) -> Vec[i64] {
    cps_of(s)
}

fn cps_str(cs: ref Vec[i64]) -> String {
    let mut s = String.new();
    for c in cs.iter() {
        s.push(char.try_from(*c as u32).unwrap_or('?'));
    }
    s
}

fn sub(cs: ref Vec[i64], from: i64, to: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    let mut i = from;
    while i < to {
        v.push(cs[i]);
        i += 1;
    }
    v
}

fn concat(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut v = a.clone();
    for c in b.iter() {
        v.push(*c);
    }
    v
}

fn cps_eq(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    true
}

fn is_ascii(cs: ref Vec[i64]) -> bool {
    for c in cs.iter() {
        if *c >= 128 {
            return false;
        }
    }
    true
}

// str.lower() on ASCII.
fn ascii_lower_cps(cs: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in cs.iter() {
        out.push(if *c >= 65 and *c <= 90 { *c + 32 } else { *c });
    }
    out
}

fn starts_with_cps(cs: ref Vec[i64], p: Str) -> bool {
    let pc = cps_of(p);
    if cs.len() < pc.len() {
        return false;
    }
    for i in 0..pc.len() {
        if cs[i] != pc[i] {
            return false;
        }
    }
    true
}

fn hex_upper(n: i64, width: i64) -> String {
    let h: Vec[char] = "0123456789ABCDEF".chars().collect();
    let mut ds: Vec[char] = Vec.new();
    let mut m = n;
    while m > 0 {
        ds.push(h[m % 16]);
        m = m / 16;
    }
    while ds.len() < width {
        ds.push('0');
    }
    let mut s = String.new();
    let mut i = ds.len() - 1;
    while i >= 0 {
        s.push(ds[i]);
        i -= 1;
    }
    s
}

fn hex_lower(n: i64, width: i64) -> String {
    let mut out = String.new();
    for c in hex_upper(n, width).chars() {
        out.push(ascii_lower(c));
    }
    out
}

// idna's _unot: U+ and at least four upper-case hex digits.
fn unot(cp: i64) -> String {
    f"U+{hex_upper(cp, 4)}"
}

fn hex_cps(s: Str) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    if s.len() == 0 {
        return out;
    }
    for h in s.split(" ") {
        out.push(hex_parse(h) as i64);
    }
    out
}

// ------------------------------------------------------------ the tables

// What Python's unicodedata says about one character.
struct UInfo {
    ccc: i64,
    // The canonical decomposition, one level; empty if there is none.
    decomp: Vec[i64],
    printable: bool,
    named: bool,
    bidi: String,
    category: String,
    // unicodedata.name, kept only for the characters whose names
    // email-validator shows (empty when there is none).
    name: String,
}

// One row of idna's UTS #46 table: the status from start on.
struct Uts46Row {
    start: i64,
    status: char,
    replacement: Vec[i64],
}

struct Tables {
    index: Map[i64, i64],
    infos: Vec[UInfo],
    // Primary composites by (first << 21) | second.
    compose: Map[i64, i64],
    uts46: Vec[Uts46Row],
    // idna's code point classes, scripts and joining types, each a list
    // of [start, end) ranges in order.
    set_names: Vec[String],
    sets: Vec[Vec[(i64, i64)]],
}

fn load_tables(unicode: ref String, uts46: ref String, idnadata: ref String) -> Tables {
    let mut t = Tables {
        index: Map.new(),
        infos: Vec.new(),
        compose: Map.new(),
        uts46: Vec.new(),
        set_names: Vec.new(),
        sets: Vec.new(),
    };
    for line in unicode.lines() {
        if line.len() == 0 or line.starts_with("#") {
            continue;
        }
        let f: Vec[Str] = line.split(";").collect();
        let cp = hex_parse(f[0]) as i64;
        let decomp = hex_cps(f[2]);
        let flags = f[3].to_string();
        if flags.contains("c") {
            t.compose.insert((decomp[0] << 21) | decomp[1], cp);
        }
        t.index.insert(cp, t.infos.len());
        t.infos.push(UInfo {
            ccc: dec_parse(f[1]),
            decomp: decomp,
            printable: not flags.contains("p"),
            named: not flags.contains("n"),
            bidi: f[4].to_string(),
            category: f[5].to_string(),
            name: if f.len() > 6 { f[6].to_string() } else { String.new() },
        });
    }
    for line in uts46.lines() {
        if line.len() == 0 or line.starts_with("#") {
            continue;
        }
        let f: Vec[Str] = line.split(";").collect();
        let st: Vec[char] = f[1].chars().collect();
        t.uts46.push(Uts46Row { start: hex_parse(f[0]) as i64, status: st[0], replacement: hex_cps(f[2]) });
    }
    for line in idnadata.lines() {
        if line.len() == 0 or line.starts_with("#") {
            continue;
        }
        let f: Vec[Str] = line.split(" ").collect();
        let name = f[0].to_string();
        let n = t.set_names.len();
        if n == 0 or t.set_names[n - 1] != name {
            t.set_names.push(name);
            t.sets.push(Vec.new());
        }
        let k = t.sets.len() - 1;
        t.sets[k].push((hex_parse(f[1]) as i64, hex_parse(f[2]) as i64));
    }
    t
}

impl Tables {
    fn at(ref self, cp: i64) -> i64 {
        match self.index.get(cp) {
            Some(i) => *i,
            None => -1,
        }
    }

    fn ccc(ref self, cp: i64) -> i64 {
        let i = self.at(cp);
        if i < 0 { 0 } else { self.infos[i].ccc }
    }

    fn named(ref self, cp: i64) -> bool {
        let i = self.at(cp);
        i >= 0 and self.infos[i].named
    }

    fn printable(ref self, cp: i64) -> bool {
        let i = self.at(cp);
        i >= 0 and self.infos[i].printable
    }

    // unicodedata.bidirectional: "" for a character it does not know.
    fn bidi(ref self, cp: i64) -> String {
        let i = self.at(cp);
        if i < 0 { String.new() } else { self.infos[i].bidi.clone() }
    }

    // unicodedata.category: "Cn" for a character it does not know.
    fn category(ref self, cp: i64) -> String {
        let i = self.at(cp);
        if i < 0 { "Cn".to_string() } else { self.infos[i].category.clone() }
    }

    fn uname(ref self, cp: i64) -> String {
        let i = self.at(cp);
        if i < 0 { String.new() } else { self.infos[i].name.clone() }
    }

    fn is_mark(ref self, cp: i64) -> bool {
        let i = self.at(cp);
        i >= 0 and self.infos[i].category.starts_with("M")
    }

    // intranges_contain on the named set.
    fn in_set(ref self, name: Str, cp: i64) -> bool {
        for k in 0..self.set_names.len() {
            if self.set_names[k] == name {
                let mut lo = 0;
                let mut hi = self.sets[k].len();
                while lo < hi {
                    let mid = (lo + hi) / 2;
                    let (a, _) = self.sets[k][mid];
                    if a <= cp {
                        lo = mid + 1;
                    } else {
                        hi = mid;
                    }
                }
                if lo == 0 {
                    return false;
                }
                let (a, b) = self.sets[k][lo - 1];
                return a <= cp and cp < b;
            }
        }
        false
    }

    fn joining_type(ref self, cp: i64) -> String {
        for jt in ["C", "D", "L", "R", "T"] {
            if self.in_set(f"joining:{jt}", cp) {
                return jt.to_string();
            }
        }
        String.new()
    }

    // The UTS #46 row for a code point: the last one starting at or
    // before it.
    fn uts46_row(ref self, cp: i64) -> i64 {
        let mut lo = 0;
        let mut hi = self.uts46.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if self.uts46[mid].start <= cp {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        lo - 1
    }

    // ---------------------------------------------------------- NFC

    fn decompose_into(ref self, cp: i64, out: mut ref Vec[i64]) {
        if cp >= 0xAC00 and cp < 0xAC00 + 11172 {
            let s = cp - 0xAC00;
            out.push(0x1100 + s / 588);
            out.push(0x1161 + (s % 588) / 28);
            if s % 28 != 0 {
                out.push(0x11A7 + s % 28);
            }
            return;
        }
        let i = self.at(cp);
        if i < 0 or self.infos[i].decomp.len() == 0 {
            out.push(cp);
            return;
        }
        for d in self.infos[i].decomp.clone().iter() {
            self.decompose_into(*d, mut out);
        }
    }

    fn nfd(ref self, cs: ref Vec[i64]) -> Vec[i64] {
        let mut out: Vec[i64] = Vec.new();
        for c in cs.iter() {
            self.decompose_into(*c, mut out);
        }
        let mut i = 1;
        while i < out.len() {
            let mut j = i;
            while j > 0 and self.ccc(out[j]) != 0 and self.ccc(out[j - 1]) > self.ccc(out[j]) {
                let t = out[j];
                out[j] = out[j - 1];
                out[j - 1] = t;
                j -= 1;
            }
            i += 1;
        }
        out
    }

    fn composite(ref self, a: i64, b: i64) -> i64 {
        if a >= 0x1100 and a < 0x1113 and b >= 0x1161 and b < 0x1176 {
            return 0xAC00 + ((a - 0x1100) * 21 + (b - 0x1161)) * 28;
        }
        if a >= 0xAC00 and a < 0xAC00 + 11172 and (a - 0xAC00) % 28 == 0 and b > 0x11A7 and b < 0x11C3 {
            return a + (b - 0x11A7);
        }
        match self.compose.get((a << 21) | b) {
            Some(c) => *c,
            None => -1,
        }
    }

    // unicodedata.normalize("NFC").
    fn nfc(ref self, cs: ref Vec[i64]) -> Vec[i64] {
        let d = self.nfd(cs);
        let mut out: Vec[i64] = Vec.new();
        let mut starter: i64 = -1;
        // The class of the last character kept since the starter, or -1
        // when the starter is the last one kept.
        let mut last: i64 = -1;
        for c in d.iter() {
            let cc = self.ccc(*c);
            if starter >= 0 {
                let blocked = last != -1 and (last == 0 or last >= cc);
                if not blocked {
                    let comp = self.composite(out[starter], *c);
                    if comp >= 0 {
                        out[starter] = comp;
                        continue;
                    }
                }
            }
            if cc == 0 {
                starter = out.len();
                last = -1;
            } else {
                last = cc;
            }
            out.push(*c);
        }
        out
    }

    // ---------------------------------------------------------- repr

    // repr() of a str.
    fn repr(ref self, cs: ref Vec[i64]) -> String {
        let mut has_single = false;
        let mut has_double = false;
        for c in cs.iter() {
            if *c == 39 {
                has_single = true;
            }
            if *c == 34 {
                has_double = true;
            }
        }
        let q: i64 = if has_single and not has_double { 34 } else { 39 };
        let mut out = String.new();
        out.push(char.try_from(q as u32).unwrap_or('?'));
        for c in cs.iter() {
            let x = *c;
            if x == q or x == 92 {
                out.push('\\');
                out.push(char.try_from(x as u32).unwrap_or('?'));
            } else if x == 9 {
                out.push_str("\\t");
            } else if x == 10 {
                out.push_str("\\n");
            } else if x == 13 {
                out.push_str("\\r");
            } else if x < 32 or x == 127 {
                out.push_str(f"\\x{hex_lower(x, 2)}");
            } else if x < 128 or self.printable(x) {
                out.push(char.try_from(x as u32).unwrap_or('?'));
            } else if x < 256 {
                out.push_str(f"\\x{hex_lower(x, 2)}");
            } else if x < 65536 {
                out.push_str(f"\\u{hex_lower(x, 4)}");
            } else {
                out.push_str(f"\\U{hex_lower(x, 8)}");
            }
        }
        out.push(char.try_from(q as u32).unwrap_or('?'));
        out
    }

    // repr() of bytes that are all ASCII.
    fn bytes_repr(ref self, cs: ref Vec[i64]) -> String {
        let mut out = "b".to_string();
        let mut has_single = false;
        let mut has_double = false;
        for c in cs.iter() {
            if *c == 39 {
                has_single = true;
            }
            if *c == 34 {
                has_double = true;
            }
        }
        let q: i64 = if has_single and not has_double { 34 } else { 39 };
        out.push(char.try_from(q as u32).unwrap_or('?'));
        for c in cs.iter() {
            let x = *c;
            if x == q or x == 92 {
                out.push('\\');
                out.push(char.try_from(x as u32).unwrap_or('?'));
            } else if x == 9 {
                out.push_str("\\t");
            } else if x == 10 {
                out.push_str("\\n");
            } else if x == 13 {
                out.push_str("\\r");
            } else if x < 32 or x >= 127 {
                out.push_str(f"\\x{hex_lower(x, 2)}");
            } else {
                out.push(char.try_from(x as u32).unwrap_or('?'));
            }
        }
        out.push(char.try_from(q as u32).unwrap_or('?'));
        out
    }
}

// ------------------------------------------------------------ errors

// An IDNAError or one of its subclasses, with idna's machine-readable
// code and the 1-based position (-1 where there is none).
#[derive(Clone)]
struct IdnaError {
    kind: String,
    code: String,
    position: i64,
    msg: String,
}

fn ierr(kind: Str, code: Str, position: i64, msg: own String) -> IdnaError {
    IdnaError { kind: kind.to_string(), code: code.to_string(), position: position, msg: msg }
}

fn plain(code: Str, msg: Str) -> IdnaError {
    ierr("IDNAError", code, -1, msg.to_string())
}

fn show_err(e: ref IdnaError) -> String {
    let at = if e.position < 0 { String.new() } else { f" at {e.position}" };
    f"{e.kind} {e.code}{at}: {e.msg}"
}

const MAX_INPUT: i64 = 1024;
const MAX_DOMAIN: i64 = 253;

// ------------------------------------------------------------ label checks

fn in_list(s: ref String, names: ref Vec[Str]) -> bool {
    for n in names.iter() {
        if s == *n {
            return true;
        }
    }
    false
}

// The Bidi Rule of RFC 5893.
fn check_bidi(label: ref Vec[i64], check_ltr: bool, t: ref Tables) -> Result[(), IdnaError] {
    if label.len() > MAX_INPUT {
        return Err(plain("input_too_long", "Label too long"));
    }
    let mut bidi_label = false;
    for i in 0..label.len() {
        let d = t.bidi(label[i]);
        if d.len() == 0 {
            let r = t.repr(label);
            return Err(ierr("IDNABidiError", "bidi_unknown_direction", i + 1, f"Unknown directionality in label {r} at position {i + 1}"));
        }
        if d == "R" or d == "AL" or d == "AN" {
            bidi_label = true;
        }
    }
    if not bidi_label and not check_ltr {
        return Ok(());
    }
    let first = t.bidi(label[0]);
    let rtl = if first == "R" or first == "AL" {
        true
    } else if first == "L" {
        false
    } else {
        let r = t.repr(label);
        return Err(ierr("IDNABidiError", "bidi_rule_1", 1, f"First codepoint in label {r} must be directionality L, R or AL"));
    };
    let rtl_allowed: Vec[Str] = ["R", "AL", "AN", "EN", "ES", "CS", "ET", "ON", "BN", "NSM"];
    let ltr_allowed: Vec[Str] = ["L", "EN", "ES", "CS", "ET", "ON", "BN", "NSM"];
    let mut valid_ending = false;
    let mut ending: i64 = 1;
    let mut number_type = String.new();
    for i in 0..label.len() {
        let idx = i + 1;
        let d = t.bidi(label[i]);
        if rtl {
            if not in_list(d, rtl_allowed) {
                return Err(ierr("IDNABidiError", "bidi_rule_2", idx, f"Invalid direction for codepoint at position {idx} in a right-to-left label"));
            }
            if d == "R" or d == "AL" or d == "EN" or d == "AN" {
                valid_ending = true;
                ending = idx;
            } else if d != "NSM" {
                valid_ending = false;
                ending = idx;
            }
            if d == "AN" or d == "EN" {
                if number_type.len() == 0 {
                    number_type = d.clone();
                } else if number_type != d {
                    return Err(ierr("IDNABidiError", "bidi_rule_4", idx, "Can not mix numeral types in a right-to-left label".to_string()));
                }
            }
        } else {
            if not in_list(d, ltr_allowed) {
                return Err(ierr("IDNABidiError", "bidi_rule_5", idx, f"Invalid direction for codepoint at position {idx} in a left-to-right label"));
            }
            if d == "L" or d == "EN" {
                valid_ending = true;
                ending = idx;
            } else if d != "NSM" {
                valid_ending = false;
                ending = idx;
            }
        }
    }
    if not valid_ending {
        let code = if rtl { "bidi_rule_3" } else { "bidi_rule_6" };
        return Err(ierr("IDNABidiError", code, ending, "Label ends with illegal codepoint directionality".to_string()));
    }
    Ok(())
}

fn check_initial_combiner(label: ref Vec[i64], t: ref Tables) -> Result[(), IdnaError] {
    if label.len() > 0 and t.is_mark(label[0]) {
        return Err(ierr("IDNAError", "leading_combiner", 1, "Label begins with an illegal combining character".to_string()));
    }
    Ok(())
}

fn check_hyphen_ok(label: ref Vec[i64]) -> Result[(), IdnaError] {
    if label.len() >= 4 and label[2] == 45 and label[3] == 45 {
        return Err(plain("hyphen_3_4", "Label has disallowed hyphens in 3rd and 4th position"));
    }
    if label.len() > 0 and (label[0] == 45 or label[label.len() - 1] == 45) {
        return Err(plain("hyphen_start_end", "Label must not start or end with a hyphen"));
    }
    Ok(())
}

fn check_nfc(label: ref Vec[i64], t: ref Tables) -> Result[(), IdnaError] {
    if label.len() > MAX_INPUT {
        return Err(plain("input_too_long", "Label too long"));
    }
    if not cps_eq(t.nfc(label), label) {
        return Err(plain("not_nfc", "Label must be in Normalization Form C"));
    }
    Ok(())
}

// idna's _combining_class: Err where Python raises ValueError, for a
// character of class 0 that has no name.
fn combining_class(cp: i64, t: ref Tables) -> Result[i64, ()] {
    let v = t.ccc(cp);
    if v == 0 and not t.named(cp) {
        return Err(());
    }
    Ok(v)
}

// RFC 5892 Appendix A.1 and A.2: ZERO WIDTH NON-JOINER and JOINER.
fn valid_contextj(label: ref Vec[i64], pos: i64, t: ref Tables) -> Result[bool, ()] {
    let cp = label[pos];
    if cp == 0x200C {
        if pos > 0 and combining_class(label[pos - 1], t)? == 9 {
            return Ok(true);
        }
        let mut ok = false;
        let mut i = pos - 1;
        while i >= 0 {
            let jt = t.joining_type(label[i]);
            if jt == "T" {
                i -= 1;
                continue;
            }
            if jt == "L" or jt == "D" {
                ok = true;
            }
            break;
        }
        if not ok {
            return Ok(false);
        }
        ok = false;
        let mut k = pos + 1;
        while k < label.len() {
            let jt = t.joining_type(label[k]);
            if jt == "T" {
                k += 1;
                continue;
            }
            if jt == "R" or jt == "D" {
                ok = true;
            }
            break;
        }
        return Ok(ok);
    }
    if cp == 0x200D {
        return Ok(pos > 0 and combining_class(label[pos - 1], t)? == 9);
    }
    Ok(false)
}

// RFC 5892 Appendix A.3 to A.9.
fn valid_contexto(label: ref Vec[i64], pos: i64, t: ref Tables) -> bool {
    let cp = label[pos];
    let n = label.len();
    if cp == 0xB7 {
        return pos > 0 and pos < n - 1 and label[pos - 1] == 0x6C and label[pos + 1] == 0x6C;
    }
    if cp == 0x375 {
        if pos < n - 1 and n > 1 {
            return t.in_set("script:Greek", label[pos + 1]);
        }
        return false;
    }
    if cp == 0x5F3 or cp == 0x5F4 {
        if pos > 0 {
            return t.in_set("script:Hebrew", label[pos - 1]);
        }
        return false;
    }
    if cp == 0x30FB {
        for c in label.iter() {
            if *c == 0x30FB {
                continue;
            }
            if t.in_set("script:Hiragana", *c) or t.in_set("script:Katakana", *c) or t.in_set("script:Han", *c) {
                return true;
            }
        }
        return false;
    }
    if cp >= 0x660 and cp <= 0x669 {
        for c in label.iter() {
            if *c >= 0x6F0 and *c <= 0x6F9 {
                return false;
            }
        }
        return true;
    }
    if cp >= 0x6F0 and cp <= 0x6F9 {
        for c in label.iter() {
            if *c >= 0x660 and *c <= 0x669 {
                return false;
            }
        }
        return true;
    }
    false
}

fn check_label(label: ref Vec[i64], t: ref Tables) -> Result[(), IdnaError] {
    if label.len() > MAX_INPUT {
        return Err(plain("input_too_long", "Label too long"));
    }
    if label.len() == 0 {
        return Err(plain("empty_label", "Empty Label"));
    }
    if label.len() > MAX_DOMAIN + 1 {
        return Err(plain("label_too_long", "Label too long"));
    }
    check_nfc(label, t)?;
    check_hyphen_ok(label)?;
    check_initial_combiner(label, t)?;
    for pos in 0..label.len() {
        let cp = label[pos];
        let at = pos + 1;
        if t.in_set("PVALID", cp) {
            continue;
        }
        if t.in_set("CONTEXTJ", cp) {
            match valid_contextj(label, pos, t) {
                Err(_) => {
                    let r = t.repr(label);
                    return Err(ierr("IDNAError", "unknown_codepoint", at, f"Unknown codepoint adjacent to joiner {unot(cp)} at position {at} in {r}"));
                }
                Ok(false) => {
                    let r = t.repr(label);
                    return Err(ierr("InvalidCodepointContext", "contextj", at, f"Joiner {unot(cp)} not allowed at position {at} in {r}"));
                }
                Ok(true) => {}
            }
        } else if t.in_set("CONTEXTO", cp) {
            if not valid_contexto(label, pos, t) {
                let r = t.repr(label);
                return Err(ierr("InvalidCodepointContext", "contexto", at, f"Codepoint {unot(cp)} not allowed at position {at} in {r}"));
            }
        } else {
            let r = t.repr(label);
            return Err(ierr("InvalidCodepoint", "disallowed_codepoint", at, f"Codepoint {unot(cp)} at position {at} of {r} not allowed"));
        }
    }
    check_bidi(label, false, t)
}

// ------------------------------------------------------------ Punycode

// RFC 3492 as Python's encodings.punycode writes and reads it.

fn puny_t(j: i64, bias: i64) -> i64 {
    let r = 36 * (j + 1) - bias;
    if r < 1 {
        1
    } else if r > 26 {
        26
    } else {
        r
    }
}

fn puny_adapt(delta0: i64, first: bool, numchars: i64) -> i64 {
    let mut delta = if first { delta0 / 700 } else { delta0 / 2 };
    delta += delta / numchars;
    let mut divisions = 0;
    while delta > 455 {
        delta = delta / 35;
        divisions += 36;
    }
    divisions + (36 * delta / (delta + 38))
}

fn puny_digit(d: i64) -> i64 {
    if d < 26 { 97 + d } else { 48 + d - 26 }
}

fn punycode_encode(text: ref Vec[i64]) -> Vec[i64] {
    let mut base: Vec[i64] = Vec.new();
    let mut extended: Vec[i64] = Vec.new();
    for c in text.iter() {
        if *c < 128 {
            base.push(*c);
        } else {
            let mut seen = false;
            for e in extended.iter() {
                if *e == *c {
                    seen = true;
                }
            }
            if not seen {
                extended.push(*c);
            }
        }
    }
    extended.sort();
    // Insertion unsort coding.
    let mut deltas: Vec[i64] = Vec.new();
    let mut oldchar: i64 = 0x80;
    let mut oldindex: i64 = -1;
    for ch in extended.iter() {
        let c = *ch;
        let mut curlen: i64 = 0;
        for x in text.iter() {
            if *x < c {
                curlen += 1;
            }
        }
        let mut delta = (curlen + 1) * (c - oldchar);
        let mut index: i64 = -1;
        let mut pos: i64 = -1;
        loop {
            // selective_find
            let mut found = false;
            loop {
                pos += 1;
                if pos == text.len() {
                    break;
                }
                let x = text[pos];
                if x == c {
                    index += 1;
                    found = true;
                    break;
                } else if x < c {
                    index += 1;
                }
            }
            if not found {
                break;
            }
            delta += index - oldindex;
            deltas.push(delta - 1);
            oldindex = index;
            delta = 0;
        }
        oldchar = c;
    }
    // Bias adaptation and the variable-length integers.
    let mut out: Vec[i64] = Vec.new();
    let mut bias: i64 = 72;
    for points in 0..deltas.len() {
        let mut n = deltas[points];
        let mut j: i64 = 0;
        loop {
            let t = puny_t(j, bias);
            if n < t {
                out.push(puny_digit(n));
                break;
            }
            out.push(puny_digit(t + (n - t) % (36 - t)));
            n = (n - t) / (36 - t);
            j += 1;
        }
        bias = puny_adapt(deltas[points], points == 0, base.len() + points + 1);
    }
    if base.len() > 0 {
        let mut r = base.clone();
        r.push(45);
        for c in out.iter() {
            r.push(*c);
        }
        return r;
    }
    out
}

const PUNY_CAP: i64 = 35184372088832;

// The text a Punycode string decodes to, or None where Python's codec
// raises. Numbers are capped well past the point where the character
// they lead to is out of range, which is an error either way.
fn punycode_decode(text: ref Vec[i64]) -> Option[Vec[i64]] {
    let mut dash: i64 = -1;
    for i in 0..text.len() {
        if text[i] == 45 {
            dash = i;
        }
    }
    let mut base: Vec[i64] = Vec.new();
    let mut ext: Vec[i64] = Vec.new();
    if dash >= 0 {
        base = sub(text, 0, dash);
    }
    for i in (dash + 1)..text.len() {
        let c = text[i];
        ext.push(if c >= 97 and c <= 122 { c - 32 } else { c });
    }
    let mut ch: i64 = 0x80;
    let mut pos: i64 = -1;
    let mut bias: i64 = 72;
    let mut extpos: i64 = 0;
    while extpos < ext.len() {
        // decode_generalized_number
        let mut p = extpos;
        let mut result: i64 = 0;
        let mut w: i64 = 1;
        let mut j: i64 = 0;
        loop {
            if p >= ext.len() {
                return None;
            }
            let c = ext[p];
            p += 1;
            let digit = if c >= 65 and c <= 90 {
                c - 65
            } else if c >= 48 and c <= 57 {
                c - 22
            } else {
                return None;
            };
            let t = puny_t(j, bias);
            result += digit * w;
            if result > PUNY_CAP {
                result = PUNY_CAP;
            }
            if digit < t {
                break;
            }
            w = w * (36 - t);
            if w > PUNY_CAP {
                w = PUNY_CAP;
            }
            j += 1;
        }
        let delta = result;
        pos += delta + 1;
        ch += pos / (base.len() + 1);
        if ch > 0x10FFFF {
            return None;
        }
        pos = pos % (base.len() + 1);
        base.insert(pos, ch);
        bias = puny_adapt(delta, extpos == 0, base.len());
        extpos = p;
    }
    Some(base)
}

// ------------------------------------------------------------ labels

fn alabel(label: ref Vec[i64], t: ref Tables) -> Result[Vec[i64], IdnaError] {
    if label.len() > MAX_INPUT {
        return Err(plain("input_too_long", "Label too long"));
    }
    if is_ascii(label) {
        ulabel(label, t)?;
        if label.len() > 63 {
            return Err(plain("label_too_long", "Label too long"));
        }
        return Ok(label.clone());
    }
    check_label(label, t)?;
    let out = concat(ascii_cps("xn--"), punycode_encode(label));
    if out.len() > 63 {
        return Err(plain("label_too_long", "Label too long"));
    }
    Ok(out)
}

fn ulabel(label: ref Vec[i64], t: ref Tables) -> Result[Vec[i64], IdnaError] {
    if label.len() > MAX_INPUT {
        return Err(plain("input_too_long", "Label too long"));
    }
    if not is_ascii(label) {
        check_label(label, t)?;
        return Ok(label.clone());
    }
    let mut lb = ascii_lower_cps(label);
    if starts_with_cps(lb, "xn--") {
        lb = sub(lb, 4, lb.len());
        if lb.len() == 0 {
            return Err(plain("invalid_alabel", "Malformed A-label, no Punycode eligible content found"));
        }
        if lb[lb.len() - 1] == 45 {
            return Err(plain("invalid_alabel", "A-label must not end with a hyphen"));
        }
    } else {
        check_label(lb, t)?;
        return Ok(lb);
    }
    let u = match punycode_decode(lb) {
        Some(u) => u,
        None => return Err(plain("invalid_alabel", "Invalid A-label")),
    };
    if not cps_eq(punycode_encode(u), lb) {
        return Err(plain("non_canonical_alabel", "A-label is not the canonical Punycode encoding of its U-label"));
    }
    check_label(u, t)?;
    Ok(u)
}

// ------------------------------------------------------------ UTS #46

// An ASCII character UseSTD3ASCIIRules rejects: anything but a lower-case
// letter, a digit, '-' and '.'.
fn std3_bad(c: i64) -> bool {
    (c >= 0 and c <= 0x2C) or c == 0x2F or (c >= 0x3A and c <= 0x60) or (c >= 0x7B and c <= 0x7F)
}

fn check_std3(text: ref Vec[i64], domain: ref Vec[i64], offset: i64, t: ref Tables) -> Result[(), IdnaError] {
    for i in 0..text.len() {
        if std3_bad(text[i]) {
            let p = offset + i + 1;
            let r = t.repr(domain);
            return Err(ierr("InvalidCodepoint", "uts46_std3", p, f"Codepoint {unot(text[i])} not allowed at position {p} in {r}"));
        }
    }
    Ok(())
}

fn uts46_remap(domain: ref Vec[i64], std3: bool, t: ref Tables) -> Result[Vec[i64], IdnaError] {
    if domain.len() > MAX_INPUT {
        return Err(plain("input_too_long", "Domain too long"));
    }
    if is_ascii(domain) {
        let result = ascii_lower_cps(domain);
        if std3 {
            check_std3(result, domain, 0, t)?;
        }
        return Ok(result);
    }
    let mut output: Vec[i64] = Vec.new();
    let mut start: i64 = 0;
    for pos in 0..domain.len() {
        let cp = domain[pos];
        let i = t.uts46_row(cp);
        let status = t.uts46[i].status;
        if status == 'V' or status == 'D' {
            continue;
        }
        let replacement = if status == 'M' {
            t.uts46[i].replacement.clone()
        } else if status == 'I' {
            Vec.new()
        } else {
            let r = t.repr(domain);
            return Err(ierr("InvalidCodepoint", "uts46_disallowed", pos + 1, f"Codepoint {unot(cp)} not allowed at position {pos + 1} in {r}"));
        };
        if start < pos {
            let run = sub(domain, start, pos);
            if std3 {
                check_std3(run, domain, start, t)?;
            }
            for c in run.iter() {
                output.push(*c);
            }
        }
        if replacement.len() > 0 {
            if std3 {
                for c in replacement.iter() {
                    if std3_bad(*c) {
                        let r = t.repr(domain);
                        return Err(ierr("InvalidCodepoint", "uts46_std3", pos + 1, f"Codepoint {unot(cp)} not allowed at position {pos + 1} in {r}"));
                    }
                }
            }
            for c in replacement.iter() {
                output.push(*c);
            }
        }
        start = pos + 1;
    }
    if start == 0 {
        if std3 {
            check_std3(domain, domain, 0, t)?;
        }
        return Ok(t.nfc(domain));
    }
    let tail = sub(domain, start, domain.len());
    if std3 {
        check_std3(tail, domain, start, t)?;
    }
    for c in tail.iter() {
        output.push(*c);
    }
    Ok(t.nfc(output))
}

// ------------------------------------------------------------ domains

fn is_dot(c: i64, strict: bool) -> bool {
    c == 0x2E or (not strict and (c == 0x3002 or c == 0xFF0E or c == 0xFF61))
}

fn split_labels(s: ref Vec[i64], strict: bool) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    for c in s.iter() {
        if is_dot(*c, strict) {
            out.push(cur.clone());
            cur = Vec.new();
        } else {
            cur.push(*c);
        }
    }
    out.push(cur);
    out
}

fn join_labels(parts: ref Vec[Vec[i64]]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push(0x2E);
        }
        for c in parts[i].iter() {
            out.push(*c);
        }
    }
    out
}

struct Opts {
    strict: bool,
    uts46: bool,
    std3: bool,
    display: bool,
}

fn encode(s0: ref Vec[i64], o: ref Opts, t: ref Tables) -> Result[Vec[i64], IdnaError] {
    if s0.len() > MAX_INPUT {
        return Err(plain("input_too_long", "Domain too long"));
    }
    let s = if o.uts46 { uts46_remap(s0, o.std3, t)? } else { s0.clone() };
    if s.len() > MAX_DOMAIN + 1 {
        return Err(plain("domain_too_long", "Domain too long"));
    }
    let mut labels = split_labels(s, o.strict);
    if labels.len() == 1 and labels[0].len() == 0 {
        return Err(plain("empty_domain", "Empty domain"));
    }
    let mut trailing = false;
    if labels[labels.len() - 1].len() == 0 {
        labels.pop();
        trailing = true;
    }
    let mut result: Vec[Vec[i64]] = Vec.new();
    for label in labels.iter() {
        let a = alabel(label, t)?;
        if a.len() == 0 {
            return Err(plain("empty_label", "Empty label"));
        }
        result.push(a);
    }
    if trailing {
        result.push(Vec.new());
    }
    let out = join_labels(result);
    if out.len() > MAX_DOMAIN + (if trailing { 1 } else { 0 }) {
        return Err(plain("domain_too_long", "Domain too long"));
    }
    Ok(out)
}

fn decode(s0: ref Vec[i64], o: ref Opts, t: ref Tables) -> Result[Vec[i64], IdnaError] {
    if s0.len() > MAX_INPUT {
        return Err(plain("input_too_long", "Domain too long"));
    }
    let s = if o.uts46 { uts46_remap(s0, o.std3, t)? } else { s0.clone() };
    if s.len() > MAX_DOMAIN + 1 {
        return Err(plain("domain_too_long", "Domain too long"));
    }
    let mut labels = split_labels(s, o.strict);
    if labels.len() == 1 and labels[0].len() == 0 {
        return Err(plain("empty_domain", "Empty domain"));
    }
    let mut trailing = false;
    if labels[labels.len() - 1].len() == 0 {
        labels.pop();
        trailing = true;
    }
    let mut result: Vec[Vec[i64]] = Vec.new();
    for label in labels.iter() {
        let u = match ulabel(label, t) {
            Ok(u) => u,
            Err(e) => {
                let low = ascii_lower_cps(sub(label, 0, if label.len() < 4 { label.len() } else { 4 }));
                if o.display and cps_eq(low, ascii_cps("xn--")) {
                    ascii_lower_cps(label)
                } else {
                    return Err(e);
                }
            }
        };
        if u.len() == 0 {
            return Err(plain("empty_label", "Empty label"));
        }
        result.push(u);
    }
    if trailing {
        result.push(Vec.new());
    }
    Ok(join_labels(result))
}


// ------------------------------------------------------------ bytes and text

fn byte_str(b: ref Vec[u8], from: i64, to: i64) -> String {
    let mut v: Vec[u8] = Vec.new();
    for i in from..to {
        v.push(b[i]);
    }
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn to_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn from_bytes(v: Vec[u8]) -> String {
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn is_alpha(c: u8) -> bool {
    (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z')
}

fn is_alnum(c: u8) -> bool {
    is_digit(c) or is_alpha(c)
}

// White space, as `\s` and str.strip see it.
fn is_ws(c: u8) -> bool {
    c == b' ' or c == b'\t' or c == b'\n' or c == b'\r' or c == 11 or c == 12
}

fn lower_byte(c: u8) -> u8 {
    if c >= b'A' and c <= b'Z' { c + 32 } else { c }
}

fn lower(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        out.push(lower_byte(b[i]));
    }
    from_bytes(out)
}

fn strip(s: Str) -> String {
    let b = to_bytes(s);
    let mut i: i64 = 0;
    let mut j = b.len();
    while i < j and is_ws(b[i]) {
        i += 1;
    }
    while j > i and is_ws(b[j - 1]) {
        j -= 1;
    }
    byte_str(b, i, j)
}

fn split_ws(s: Str) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        while i < b.len() and is_ws(b[i]) {
            i += 1;
        }
        let st = i;
        while i < b.len() and not is_ws(b[i]) {
            i += 1;
        }
        if i > st {
            out.push(byte_str(b, st, i));
        }
    }
    out
}

fn split_on(s: Str, sep: u8) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut st: i64 = 0;
    for i in 0..b.len() {
        if b[i] == sep {
            out.push(byte_str(b, st, i));
            st = i + 1;
        }
    }
    out.push(byte_str(b, st, b.len()));
    out
}

fn ip_join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

// The lines of a file, without their newlines.
fn lines_of(text: Str) -> Vec[String] {
    let mut v = split_on(text, b'\n');
    if v.len() > 0 and v[v.len() - 1].len() == 0 {
        v.pop();
    }
    v
}

// Python's repr of a str.
fn py_repr(s: Str) -> String {
    let b = to_bytes(s);
    let mut has_single = false;
    let mut has_double = false;
    for i in 0..b.len() {
        if b[i] == b'\'' {
            has_single = true;
        }
        if b[i] == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let hex = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    out.push(q);
    let mut skip = false;
    for i in 0..b.len() {
        let c = b[i];
        if skip {
            skip = false;
            continue;
        }
        // U+0080 to U+00A0 and U+00AD are not printable either
        let next: u8 = if i + 1 < b.len() { b[i + 1] } else { 0 };
        if c == 0xC2 and next >= 0x80 and (next <= 0xA0 or next == 0xAD) {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(next / 16) as i64]);
            out.push(hex[(next % 16) as i64]);
            skip = true;
        } else if c == q or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c < 32 or c == 127 {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    from_bytes(out)
}

fn upper(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        let c = b[i];
        out.push(if c >= b'a' and c <= b'z' { c - 32 } else { c });
    }
    from_bytes(out)
}

// Whether `pat` occurs in `b` at `i`.
fn starts_at(b: ref Vec[u8], i: i64, pat: Str) -> bool {
    let p = to_bytes(pat);
    if i < 0 or i + p.len() > b.len() {
        return false;
    }
    for k in 0..p.len() {
        if b[i + k] != p[k] {
            return false;
        }
    }
    true
}

fn starts_with(s: Str, pat: Str) -> bool {
    starts_at(to_bytes(s), 0, pat)
}

fn find_str(s: Str, pat: Str) -> i64 {
    let b = to_bytes(s);
    for i in 0..b.len() + 1 {
        if starts_at(b, i, pat) {
            return i;
        }
    }
    -1
}

fn first_byte(s: Str) -> u8 {
    let b = to_bytes(s);
    if b.len() > 0 { b[0] } else { 0 }
}

fn slice_from(s: Str, i: i64) -> String {
    let b = to_bytes(s);
    byte_str(b, i, b.len())
}

fn is_hex(c: u8) -> bool {
    is_digit(c) or (c >= b'a' and c <= b'f') or (c >= b'A' and c <= b'F')
}

fn hex_val(c: u8) -> u8 {
    if is_digit(c) {
        c - b'0'
    } else if c >= b'a' and c <= b'f' {
        c - b'a' + 10
    } else {
        c - b'A' + 10
    }
}

fn find_byte(s: Str, c: u8) -> i64 {
    let b = to_bytes(s);
    for i in 0..b.len() {
        if b[i] == c {
            return i;
        }
    }
    -1
}

fn rfind_byte(s: Str, c: u8) -> i64 {
    let b = to_bytes(s);
    let mut i = b.len() - 1;
    while i >= 0 {
        if b[i] == c {
            return i;
        }
        i -= 1;
    }
    -1
}

fn has_byte(s: Str, c: u8) -> bool {
    find_byte(s, c) >= 0
}

fn slice(s: Str, from: i64, to: i64) -> String {
    byte_str(to_bytes(s), from, to)
}

// str.partition and str.rpartition on one byte: (before, found, after).
fn partition(s: Str, c: u8) -> (String, bool, String) {
    let i = find_byte(s, c);
    if i < 0 {
        return (s.to_string(), false, String.new());
    }
    (slice(s, 0, i), true, slice_from(s, i + 1))
}

fn rpartition(s: Str, c: u8) -> (String, bool, String) {
    let i = rfind_byte(s, c);
    if i < 0 {
        return (String.new(), false, s.to_string());
    }
    (slice(s, 0, i), true, slice_from(s, i + 1))
}

// Python's repr of a bytes object.
fn bytes_repr(b: ref Vec[u8]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for i in 0..b.len() {
        if b[i] == b'\'' {
            has_single = true;
        }
        if b[i] == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let hex = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    out.push(b'b');
    out.push(q);
    for i in 0..b.len() {
        let c = b[i];
        if c == q or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c < 32 or c >= 127 {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    from_bytes(out)
}

fn ip_is_ascii(s: Str) -> bool {
    let b = to_bytes(s);
    for i in 0..b.len() {
        if b[i] >= 0x80 {
            return false;
        }
    }
    true
}

fn py_int(s: Str) -> Option[i64] {
    let b = to_bytes(strip(s));
    let mut i: i64 = 0;
    let mut neg = false;
    if i < b.len() and (b[i] == b'+' or b[i] == b'-') {
        neg = b[i] == b'-';
        i += 1;
    }
    if i >= b.len() {
        return None;
    }
    let mut n: i64 = 0;
    let mut prev_digit = false;
    while i < b.len() {
        let c = b[i];
        if is_digit(c) {
            n = n * 10 + (c - b'0') as i64;
            prev_digit = true;
        } else if c == b'_' and prev_digit and i + 1 < b.len() and is_digit(b[i + 1]) {
            prev_digit = false;
        } else {
            return None;
        }
        i += 1;
    }
    if neg { Some(-n) } else { Some(n) }
}

// The code points of a string.
fn code_points(s: Str) -> Vec[i64] {
    let b = to_bytes(s);
    let mut out: Vec[i64] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | (b[i + 1] as i64 & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | ((b[i + 1] as i64 & 0x3F) << 6) | (b[i + 2] as i64 & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | ((b[i + 1] as i64 & 0x3F) << 12) | ((b[i + 2] as i64 & 0x3F) << 6) | (b[i + 3] as i64 & 0x3F));
            i += 4;
        }
    }
    out
}

fn push_code_point(out: mut ref Vec[u8], cp: i64) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push(((cp >> 6) | 0xC0) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    } else if cp < 0x10000 {
        out.push(((cp >> 12) | 0xE0) as u8);
        out.push((((cp >> 6) & 0x3F) | 0x80) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    } else {
        out.push(((cp >> 18) | 0xF0) as u8);
        out.push((((cp >> 12) & 0x3F) | 0x80) as u8);
        out.push((((cp >> 6) & 0x3F) | 0x80) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    }
}

// ------------------------------------------------------------ errors and numbers

// A raised exception: its class name and its message.
#[derive(Clone)]
struct IpError {
    kind: String,
    msg: String,
}

fn raise(kind: Str, msg: own String) -> IpError {
    IpError { kind: kind.to_string(), msg: msg }
}

fn ave(msg: own String) -> IpError {
    raise("AddressValueError", msg)
}

fn nve(msg: own String) -> IpError {
    raise("NetmaskValueError", msg)
}

fn ve(msg: own String) -> IpError {
    raise("ValueError", msg)
}

fn te(msg: own String) -> IpError {
    raise("TypeError", msg)
}

fn ip_show_err(e: ref IpError) -> String {
    f"{e.kind}: {e.msg}"
}

// AddressValueError and NetmaskValueError are what ip_address and
// ip_network catch before they try the other version.
fn is_addr_or_mask(e: ref IpError) -> bool {
    e.kind == "AddressValueError" or e.kind == "NetmaskValueError"
}

fn u128_max() -> u128 {
    (0xFFFF_FFFF_FFFF_FFFF << 64) | 0xFFFF_FFFF_FFFF_FFFF
}

fn all_ones(v: i64) -> u128 {
    if v == 4 { 0xFFFF_FFFFu128 } else { u128_max() }
}

fn max_plen(v: i64) -> i64 {
    if v == 4 { 32 } else { 128 }
}

// (1 << n) - 1, also for n = 128.
fn low_ones(n: i64) -> u128 {
    if n >= 128 { u128_max() } else { (1u128 << n) - 1 }
}

fn bit_length(x: u128) -> i64 {
    let mut n: i64 = 0;
    let mut y = x;
    while y > 0 {
        y = y >> 1;
        n += 1;
    }
    n
}

// _count_righthand_zero_bits
fn zero_bits(x: u128, bits: i64) -> i64 {
    if x == 0 {
        return bits;
    }
    let mut n: i64 = 0;
    let mut y = x;
    while y & 1 == 0 {
        y = y >> 1;
        n += 1;
    }
    if n < bits { n } else { bits }
}

fn hex_str(x: u128) -> String {
    if x == 0 {
        return "0".to_string();
    }
    let hex = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    let mut y = x;
    while y > 0 {
        out.push(hex[(y & 15) as i64]);
        y = y >> 4;
    }
    out.reverse();
    from_bytes(out)
}

// `n` digits in base 2 or 16, with leading zeros.
fn digits(x: u128, n: i64, base: i64, up: bool) -> String {
    let hex = to_bytes(if up { "0123456789ABCDEF" } else { "0123456789abcdef" });
    let shift: i64 = if base == 2 { 1 } else { 4 };
    let mask: u128 = if base == 2 { 1 } else { 15 };
    let mut out: Vec[u8] = Vec.new();
    let mut y = x;
    for _ in 0..n {
        out.push(hex[(y & mask) as i64]);
        y = y >> shift;
    }
    out.reverse();
    from_bytes(out)
}

// A decimal string plus a small number, for a value past 2**128.
fn dec_add(a: Str, n: i64) -> String {
    let b = to_bytes(a);
    let mut out: Vec[u8] = Vec.new();
    let mut carry = n;
    let mut i = b.len() - 1;
    while i >= 0 or carry > 0 {
        let d = if i >= 0 { (b[i] - b'0') as i64 } else { 0 };
        let s = d + carry;
        out.push(b'0' + (s % 10) as u8);
        carry = s / 10;
        i -= 1;
    }
    out.reverse();
    from_bytes(out)
}

// ------------------------------------------------------------ addresses

#[derive(Clone)]
struct Addr {
    v: i64,
    ip: u128,
    // the IPv6 zone after `%`, "" for none
    scope: String,
}

fn addr_of(v: i64, ip: u128) -> Addr {
    Addr { v: v, ip: ip, scope: String.new() }
}

fn v4_str(ip: u128) -> String {
    f"{(ip >> 24) & 255}.{(ip >> 16) & 255}.{(ip >> 8) & 255}.{ip & 255}"
}

// _compress_hextets: the longest run of two or more zeros becomes "".
fn compress(ip: u128) -> String {
    let mut h: Vec[String] = Vec.new();
    let mut k: i64 = 112;
    while k >= 0 {
        h.push(hex_str((ip >> k) & 0xFFFF));
        k -= 16;
    }
    let mut best_start: i64 = -1;
    let mut best_len: i64 = 0;
    let mut start: i64 = -1;
    let mut len: i64 = 0;
    for i in 0..h.len() {
        if h[i] == "0" {
            len += 1;
            if start == -1 {
                start = i;
            }
            if len > best_len {
                best_len = len;
                best_start = start;
            }
        } else {
            len = 0;
            start = -1;
        }
    }
    if best_len > 1 {
        let end = best_start + best_len;
        let mut out: Vec[String] = Vec.new();
        if best_start == 0 {
            out.push(String.new());
        }
        for i in 0..best_start {
            out.push(h[i].clone());
        }
        out.push(String.new());
        for i in end..h.len() {
            out.push(h[i].clone());
        }
        if end == h.len() {
            out.push(String.new());
        }
        return ip_join(out, ":");
    }
    ip_join(h, ":")
}

// _string_from_ip_int
fn plain_str(v: i64, ip: u128) -> String {
    if v == 4 { v4_str(ip) } else { compress(ip) }
}

fn is_mapped(a: ref Addr) -> bool {
    a.v == 6 and (a.ip >> 32) == 0xFFFF
}

fn mapped_v4(a: ref Addr) -> Addr {
    addr_of(4, a.ip & 0xFFFF_FFFF)
}

// str(address)
fn addr_str(a: ref Addr) -> String {
    if a.v == 4 {
        return v4_str(a.ip);
    }
    let s = if is_mapped(a) { f"{compress(a.ip >> 32)}:{v4_str(a.ip & 0xFFFF_FFFF)}" } else { compress(a.ip) };
    if a.scope.len() > 0 { f"{s}%{a.scope}" } else { s }
}

fn addr_repr(a: ref Addr) -> String {
    f"IPv{a.v}Address({py_repr(addr_str(a))})"
}

// The eight hextets in full, as the exploded form spells them.
fn raw_exploded(ip: u128) -> String {
    let mut h: Vec[String] = Vec.new();
    let mut k: i64 = 112;
    while k >= 0 {
        h.push(digits((ip >> k) & 0xFFFF, 4, 16, false));
        k -= 16;
    }
    ip_join(h, ":")
}

fn addr_exploded(a: ref Addr) -> String {
    if a.v == 4 {
        return v4_str(a.ip);
    }
    if is_mapped(a) {
        return f"{slice(raw_exploded(a.ip), 0, 30)}{v4_str(a.ip & 0xFFFF_FFFF)}";
    }
    let s = raw_exploded(a.ip);
    if a.scope.len() > 0 { f"{s}%{a.scope}" } else { s }
}

// The characters of `s` from the last, without colons, joined by dots.
fn reverse_dotted(s: Str) -> String {
    let cps = code_points(s);
    let mut out: Vec[u8] = Vec.new();
    let mut i = cps.len() - 1;
    let mut first = true;
    while i >= 0 {
        if cps[i] != 58 {
            if not first {
                out.push(b'.');
            }
            push_code_point(mut out, cps[i]);
            first = false;
        }
        i -= 1;
    }
    from_bytes(out)
}

fn reverse_pointer(a: ref Addr) -> String {
    if a.v == 4 {
        let o = split_on(v4_str(a.ip), b'.');
        return f"{o[3]}.{o[2]}.{o[1]}.{o[0]}.in-addr.arpa";
    }
    if is_mapped(a) {
        let raw = f"{slice(raw_exploded(a.ip), 0, 30)}{digits(a.ip & 0xFFFF_FFFF, 8, 16, false)}";
        return f"{reverse_dotted(raw)}.ip6.arpa";
    }
    f"{reverse_dotted(addr_exploded(a))}.ip6.arpa"
}

fn packed(a: ref Addr) -> Vec[u8] {
    let n: i64 = if a.v == 4 { 4 } else { 16 };
    let mut out: Vec[u8] = Vec.new();
    let mut k = (n - 1) * 8;
    while k >= 0 {
        out.push(((a.ip >> k) & 255) as u8);
        k -= 8;
    }
    out
}

// ------------------------------------------------------------ parsing

fn all_ascii_digits(s: Str) -> bool {
    let b = to_bytes(s);
    if b.len() == 0 {
        return false;
    }
    for i in 0..b.len() {
        if not is_digit(b[i]) {
            return false;
        }
    }
    true
}

fn digits_value(s: Str) -> u128 {
    let b = to_bytes(s);
    let mut n: u128 = 0;
    for i in 0..b.len() {
        n = n * 10 + (b[i] - b'0') as u128;
    }
    n
}

// _parse_octet, with its message before " in %r" is added.
fn parse_octet(s: Str) -> Result[u128, String] {
    if s.len() == 0 {
        return Err("Empty octet not permitted".to_string());
    }
    if not all_ascii_digits(s) {
        return Err(f"Only decimal digits permitted in {py_repr(s)}");
    }
    if s.len() > 3 {
        return Err(f"At most 3 characters permitted in {py_repr(s)}");
    }
    if s != "0" and first_byte(s) == b'0' {
        return Err(f"Leading zeros are not permitted in {py_repr(s)}");
    }
    let n = digits_value(s);
    if n > 255 {
        return Err(f"Octet {n} (> 255) not permitted");
    }
    Ok(n)
}

// _BaseV4._ip_int_from_string
fn v4_int(s: Str) -> Result[u128, IpError] {
    if s.len() == 0 {
        return Err(ave("Address cannot be empty".to_string()));
    }
    let octets = split_on(s, b'.');
    if octets.len() != 4 {
        return Err(ave(f"Expected 4 octets in {py_repr(s)}"));
    }
    let mut ip: u128 = 0;
    for i in 0..4 {
        match parse_octet(octets[i]) {
            Ok(n) => ip = (ip << 8) | n,
            Err(m) => return Err(ave(f"{m} in {py_repr(s)}")),
        }
    }
    Ok(ip)
}

// _parse_hextet
fn parse_hextet(s: Str) -> Result[u128, String] {
    let cps = code_points(s);
    let mut n: u128 = 0;
    for i in 0..cps.len() {
        let c = cps[i];
        if c >= 128 or not is_hex(c as u8) {
            return Err(f"Only hex digits permitted in {py_repr(s)}");
        }
    }
    if cps.len() > 4 {
        return Err(f"At most 4 characters permitted in {py_repr(s)}");
    }
    if cps.len() == 0 {
        return Err("invalid literal for int() with base 16: ''".to_string());
    }
    for i in 0..cps.len() {
        n = n * 16 + hex_val(cps[i] as u8) as u128;
    }
    Ok(n)
}

// str.split(sep, maxsplit)
fn split_max(s: Str, sep: u8, max: i64) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut st: i64 = 0;
    for i in 0..b.len() {
        if b[i] == sep and out.len() < max {
            out.push(byte_str(b, st, i));
            st = i + 1;
        }
    }
    out.push(byte_str(b, st, b.len()));
    out
}

// _BaseV6._ip_int_from_string
fn v6_int(s: Str) -> Result[u128, IpError] {
    let r = py_repr(s);
    if s.len() == 0 {
        return Err(ave("Address cannot be empty".to_string()));
    }
    let cps = code_points(s);
    if cps.len() > 45 {
        return Err(ave(f"At most 45 characters expected in {r}"));
    }
    let mut parts = split_max(s, b':', 9);
    if parts.len() < 3 {
        return Err(ave(f"At least 3 parts expected in {r}"));
    }
    let last = parts[parts.len() - 1].clone();
    if has_byte(last, b'.') {
        parts.pop();
        let v4 = match v4_addr(last) {
            Ok(a) => a.ip,
            Err(e) => return Err(ave(f"{e.msg} in {r}")),
        };
        parts.push(hex_str((v4 >> 16) & 0xFFFF));
        parts.push(hex_str(v4 & 0xFFFF));
    }
    if parts.len() > 9 {
        return Err(ave(f"At most 8 colons permitted in {r}"));
    }
    let n = parts.len();
    let mut skip: i64 = -1;
    for i in 1..n - 1 {
        if parts[i].len() == 0 {
            if skip >= 0 {
                return Err(ave(f"At most one '::' permitted in {r}"));
            }
            skip = i;
        }
    }
    let mut hi: i64 = 0;
    let mut lo: i64 = 0;
    let mut skipped: i64 = 0;
    if skip >= 0 {
        hi = skip;
        lo = n - skip - 1;
        if parts[0].len() == 0 {
            hi -= 1;
            if hi > 0 {
                return Err(ave(f"Leading ':' only permitted as part of '::' in {r}"));
            }
        }
        if parts[n - 1].len() == 0 {
            lo -= 1;
            if lo > 0 {
                return Err(ave(f"Trailing ':' only permitted as part of '::' in {r}"));
            }
        }
        skipped = 8 - (hi + lo);
        if skipped < 1 {
            return Err(ave(f"Expected at most 7 other parts with '::' in {r}"));
        }
    } else {
        if n != 8 {
            return Err(ave(f"Exactly 8 parts expected without '::' in {r}"));
        }
        if parts[0].len() == 0 {
            return Err(ave(f"Leading ':' only permitted as part of '::' in {r}"));
        }
        if parts[n - 1].len() == 0 {
            return Err(ave(f"Trailing ':' only permitted as part of '::' in {r}"));
        }
        hi = n;
    }
    let mut ip: u128 = 0;
    for i in 0..hi {
        match parse_hextet(parts[i]) {
            Ok(h) => ip = (ip << 16) | h,
            Err(m) => return Err(ave(f"{m} in {r}")),
        }
    }
    if skipped < 8 {
        ip = ip << (16 * skipped);
    }
    for i in n - lo..n {
        match parse_hextet(parts[i]) {
            Ok(h) => ip = (ip << 16) | h,
            Err(m) => return Err(ave(f"{m} in {r}")),
        }
    }
    Ok(ip)
}

// IPv4Address(str)
fn v4_addr(s: Str) -> Result[Addr, IpError] {
    if has_byte(s, b'/') {
        return Err(ave(f"Unexpected '/' in {py_repr(s)}"));
    }
    Ok(addr_of(4, v4_int(s)?))
}

// IPv6Address(str), with _split_scope_id
fn v6_addr(s: Str) -> Result[Addr, IpError] {
    if has_byte(s, b'/') {
        return Err(ave(f"Unexpected '/' in {py_repr(s)}"));
    }
    let (addr, sep, scope) = partition(s, b'%');
    if sep and (scope.len() == 0 or has_byte(scope, b'%')) {
        return Err(ave(f"Invalid IPv6 address: \"{py_repr(s)}\""));
    }
    let ip = v6_int(addr)?;
    Ok(Addr { v: 6, ip: ip, scope: scope })
}

fn parse_addr(v: i64, s: Str) -> Result[Addr, IpError] {
    if v == 4 { v4_addr(s) } else { v6_addr(s) }
}

fn ip_address(s: Str) -> Result[Addr, IpError] {
    for v in [4, 6] {
        match parse_addr(v, s) {
            Ok(a) => return Ok(a),
            Err(e) => {
                if not is_addr_or_mask(e) {
                    return Err(e);
                }
            }
        }
    }
    Err(ve(f"{py_repr(s)} does not appear to be an IPv4 or IPv6 address"))
}

// ------------------------------------------------------------ netmasks

fn mask_of(v: i64, plen: i64) -> u128 {
    let all = all_ones(v);
    if plen >= max_plen(v) { all } else { all ^ (all >> plen) }
}

fn bad_netmask(s: Str) -> IpError {
    nve(f"{py_repr(s)} is not a valid netmask")
}

fn prefix_from_prefix_string(v: i64, s: Str) -> Result[i64, IpError] {
    if not all_ascii_digits(s) or s.len() > 4 {
        return Err(bad_netmask(s));
    }
    let n = digits_value(s) as i64;
    if n > max_plen(v) {
        return Err(bad_netmask(s));
    }
    Ok(n)
}

// _prefix_from_ip_int: -1 when the mask mixes zeroes and ones.
fn prefix_from_ip_int(v: i64, ip: u128) -> i64 {
    let trailing = zero_bits(ip, max_plen(v));
    let plen = max_plen(v) - trailing;
    let leading = if trailing >= 128 { 0u128 } else { ip >> trailing };
    if leading != low_ones(plen) {
        return -1;
    }
    plen
}

// _prefix_from_ip_string: a netmask, else a hostmask.
fn prefix_from_ip_string(v: i64, s: Str) -> Result[i64, IpError] {
    let ip = match v4_int(s) {
        Ok(n) => n,
        Err(_) => return Err(bad_netmask(s)),
    };
    let p = prefix_from_ip_int(v, ip);
    if p >= 0 {
        return Ok(p);
    }
    let q = prefix_from_ip_int(v, ip ^ all_ones(v));
    if q >= 0 {
        return Ok(q);
    }
    Err(bad_netmask(s))
}

fn make_netmask(v: i64, s: Str) -> Result[i64, IpError] {
    match prefix_from_prefix_string(v, s) {
        Ok(p) => Ok(p),
        Err(e) => if v == 4 { prefix_from_ip_string(v, s) } else { Err(e) },
    }
}

// ------------------------------------------------------------ networks

#[derive(Clone)]
struct Net {
    // the network address, which keeps a scope id it was written with
    addr: Addr,
    plen: i64,
}

fn net_of(v: i64, ip: u128, plen: i64) -> Net {
    Net { addr: addr_of(v, ip), plen: plen }
}

fn netmask(n: ref Net) -> u128 {
    mask_of(n.addr.v, n.plen)
}

fn hostmask(n: ref Net) -> u128 {
    netmask(n) ^ all_ones(n.addr.v)
}

fn broadcast(n: ref Net) -> u128 {
    n.addr.ip | hostmask(n)
}

fn net_str(n: ref Net) -> String {
    f"{addr_str(n.addr)}/{n.plen}"
}

fn net_repr(n: ref Net) -> String {
    f"IPv{n.addr.v}Network({py_repr(net_str(n))})"
}

fn net_mask_str(n: ref Net) -> String {
    plain_str(n.addr.v, netmask(n))
}

fn net_hostmask_str(n: ref Net) -> String {
    plain_str(n.addr.v, hostmask(n))
}

fn num_addresses(n: ref Net) -> u128 {
    broadcast(n) - n.addr.ip + 1
}

// num_addresses as text: ::/0 holds 2**128 addresses, one more than a u128.
fn num_addresses_str(n: ref Net) -> String {
    let span = broadcast(n) - n.addr.ip;
    if span == u128_max() { dec_add(f"{span}", 1) } else { f"{span + 1}" }
}

// The address part and the mask part of "addr[/mask]".
fn split_addr_prefix(s: Str) -> Result[Vec[String], IpError] {
    let parts = split_on(s, b'/');
    if parts.len() > 2 {
        return Err(ave(f"Only one '/' permitted in {py_repr(s)}"));
    }
    Ok(parts)
}

// IPv4Network(str, strict) and IPv6Network(str, strict)
fn parse_net(v: i64, s: Str, strict: bool) -> Result[Net, IpError] {
    let parts = split_addr_prefix(s)?;
    let mut a = parse_addr(v, parts[0])?;
    let plen = if parts.len() == 2 { make_netmask(v, parts[1])? } else { max_plen(v) };
    let mask = mask_of(v, plen);
    if a.ip & mask != a.ip {
        if strict {
            return Err(ve(f"{addr_str(a)}/{plen} has host bits set"));
        }
        a = addr_of(v, a.ip & mask);
    }
    Ok(Net { addr: a, plen: plen })
}

fn ip_network(s: Str, strict: bool) -> Result[Net, IpError] {
    for v in [4, 6] {
        match parse_net(v, s, strict) {
            Ok(n) => return Ok(n),
            Err(e) => {
                if not is_addr_or_mask(e) {
                    return Err(e);
                }
            }
        }
    }
    Err(ve(f"{py_repr(s)} does not appear to be an IPv4 or IPv6 network"))
}

// `a in n`
fn contains(n: ref Net, a: ref Addr) -> bool {
    n.addr.v == a.v and (a.ip & netmask(n)) == n.addr.ip
}

fn net_eq(a: ref Net, b: ref Net) -> bool {
    a.addr.v == b.addr.v and a.addr.ip == b.addr.ip and a.addr.scope == b.addr.scope and a.plen == b.plen
}

// _BaseNetwork.__lt__, for networks of one version
fn net_lt(a: ref Net, b: ref Net) -> bool {
    if a.addr.ip != b.addr.ip {
        return a.addr.ip < b.addr.ip;
    }
    netmask(a) < netmask(b)
}

fn sort_nets(v: own Vec[Net]) -> Vec[Net] {
    let mut v = v;
    for i in 1..v.len() {
        let mut j = i;
        while j > 0 and net_lt(v[j], v[j - 1]) {
            v.swap(j - 1, j);
            j -= 1;
        }
    }
    v
}

fn same_version_error(a: Str, b: Str) -> IpError {
    te(f"{a} and {b} are not of the same version")
}

fn subnet_of(a: ref Net, b: ref Net) -> Result[bool, IpError] {
    if a.addr.v != b.addr.v {
        return Err(same_version_error(net_str(a), net_str(b)));
    }
    Ok(b.addr.ip <= a.addr.ip and broadcast(b) >= broadcast(a))
}

fn overlaps(a: ref Net, b: ref Net) -> bool {
    let ab = addr_of(a.addr.v, broadcast(a));
    let bb = addr_of(b.addr.v, broadcast(b));
    contains(b, a.addr) or contains(b, ab) or contains(a, b.addr) or contains(a, bb)
}

// subnets(new_prefix=p)
fn subnets(n: ref Net, p: i64) -> Result[Vec[Net], IpError] {
    let v = n.addr.v;
    let mut out: Vec[Net] = Vec.new();
    if n.plen == max_plen(v) {
        out.push(n.clone());
        return Ok(out);
    }
    if p < n.plen {
        return Err(ve("new prefix must be longer".to_string()));
    }
    if p > max_plen(v) {
        return Err(ve(f"prefix length diff {p} is invalid for netblock {net_str(n)}"));
    }
    let count = 1u128 << (p - n.plen);
    let step = 1u128 << (max_plen(v) - p);
    let mut k: u128 = 0;
    while k < count {
        out.push(net_of(v, n.addr.ip + k * step, p));
        k += 1;
    }
    Ok(out)
}

// subnets(): the two halves.
fn halves(n: ref Net) -> Vec[Net] {
    match subnets(n, n.plen + 1) {
        Ok(v) => v,
        Err(_) => Vec.new(),
    }
}

// supernet(prefixlen_diff=d)
fn supernet(n: ref Net, d: i64) -> Result[Net, IpError] {
    if n.plen == 0 {
        return Ok(n.clone());
    }
    let p = n.plen - d;
    if p < 0 {
        return Err(ve(f"current prefixlen is {n.plen}, cannot have a prefixlen_diff of {d}"));
    }
    let m = if d >= 128 { 0u128 } else { netmask(n) << d };
    Ok(net_of(n.addr.v, n.addr.ip & m, p))
}

fn supernet1(n: ref Net) -> Net {
    match supernet(n, 1) {
        Ok(s) => s,
        Err(_) => n.clone(),
    }
}

// address_exclude
fn exclude(a: ref Net, b: ref Net) -> Result[Vec[Net], IpError] {
    if a.addr.v != b.addr.v {
        return Err(same_version_error(net_str(a), net_str(b)));
    }
    if not subnet_of(b, a)? {
        return Err(ve(f"{net_str(b)} not contained in {net_str(a)}"));
    }
    let mut out: Vec[Net] = Vec.new();
    if net_eq(a, b) {
        return Ok(out);
    }
    let mut h = halves(a);
    while not net_eq(h[0], b) and not net_eq(h[1], b) {
        if subnet_of(b, h[0])? {
            out.push(h[1].clone());
            h = halves(h[0]);
        } else if subnet_of(b, h[1])? {
            out.push(h[0].clone());
            h = halves(h[1]);
        } else {
            return Err(raise("AssertionError", "Error performing exclusion".to_string()));
        }
    }
    if net_eq(h[0], b) {
        out.push(h[1].clone());
    } else {
        out.push(h[0].clone());
    }
    Ok(out)
}

// summarize_address_range
fn summarize(first: ref Addr, last: ref Addr) -> Result[Vec[Net], IpError] {
    if first.v != last.v {
        return Err(same_version_error(addr_str(first), addr_str(last)));
    }
    if first.ip > last.ip {
        return Err(ve("last IP address must be greater than first".to_string()));
    }
    let v = first.v;
    let bits = max_plen(v);
    let mut out: Vec[Net] = Vec.new();
    let mut f = first.ip;
    let l = last.ip;
    loop {
        let span = l - f;
        let fit = if span == u128_max() { 128 } else { bit_length(span + 1) - 1 };
        let z = zero_bits(f, bits);
        let nbits = if z < fit { z } else { fit };
        out.push(net_of(v, f, bits - nbits));
        let add = low_ones(nbits);
        if f + add == all_ones(v) or f + add >= l {
            break;
        }
        f = f + add + 1;
    }
    Ok(out)
}

// _collapse_addresses_internal
fn collapse_nets(nets: ref Vec[Net]) -> Vec[Net] {
    let mut to_merge: Vec[Net] = nets.clone();
    let mut keys: Vec[Net] = Vec.new();
    let mut vals: Vec[Net] = Vec.new();
    while to_merge.len() > 0 {
        let net = to_merge[to_merge.len() - 1].clone();
        to_merge.pop();
        let sup = supernet1(net);
        let mut at: i64 = -1;
        for k in 0..keys.len() {
            if net_eq(keys[k], sup) {
                at = k;
            }
        }
        if at < 0 {
            keys.push(sup);
            vals.push(net);
        } else if not net_eq(vals[at], net) {
            keys.remove(at);
            vals.remove(at);
            to_merge.push(sup);
        }
    }
    let sorted = sort_nets(vals);
    let mut out: Vec[Net] = Vec.new();
    for i in 0..sorted.len() {
        if out.len() > 0 and broadcast(out[out.len() - 1]) >= broadcast(sorted[i]) {
            continue;
        }
        out.push(sorted[i].clone());
    }
    out
}

// An address or a network, as collapse_addresses takes them.
#[derive(Clone)]
struct Item {
    is_net: bool,
    addr: Addr,
    net: Net,
}

fn addr_item(a: ref Addr) -> Item {
    Item { is_net: false, addr: a.clone(), net: net_of(a.v, a.ip, max_plen(a.v)) }
}

fn net_item(n: ref Net) -> Item {
    Item { is_net: true, addr: n.addr.clone(), net: n.clone() }
}

fn item_str(it: ref Item) -> String {
    if it.is_net { net_str(it.net) } else { addr_str(it.addr) }
}

fn collapse(items: ref Vec[Item]) -> Result[Vec[Net], IpError] {
    let mut ips: Vec[Addr] = Vec.new();
    let mut ip_items: Vec[Item] = Vec.new();
    let mut nets: Vec[Net] = Vec.new();
    for i in 0..items.len() {
        let it = items[i].clone();
        let v = it.addr.v;
        if not it.is_net or it.net.plen == max_plen(v) {
            if ips.len() > 0 and ips[ips.len() - 1].v != v {
                return Err(same_version_error(item_str(it), item_str(ip_items[ip_items.len() - 1])));
            }
            ips.push(it.addr.clone());
            ip_items.push(it);
        } else {
            if nets.len() > 0 and nets[nets.len() - 1].addr.v != v {
                return Err(same_version_error(net_str(it.net), net_str(nets[nets.len() - 1])));
            }
            nets.push(it.net.clone());
        }
    }
    // sorted(set(ips))
    let mut uniq: Vec[Addr] = Vec.new();
    for i in 0..ips.len() {
        let mut seen = false;
        for k in 0..uniq.len() {
            if uniq[k].ip == ips[i].ip and uniq[k].scope == ips[i].scope {
                seen = true;
            }
        }
        if not seen {
            uniq.push(ips[i].clone());
        }
    }
    for i in 1..uniq.len() {
        let mut j = i;
        while j > 0 and uniq[j].ip < uniq[j - 1].ip {
            uniq.swap(j - 1, j);
            j -= 1;
        }
    }
    let mut all: Vec[Net] = Vec.new();
    let mut st: i64 = 0;
    for i in 0..uniq.len() {
        let end_run = i + 1 == uniq.len() or uniq[i + 1].ip != uniq[i].ip + 1;
        if end_run {
            let r = summarize(uniq[st], uniq[i])?;
            for k in 0..r.len() {
                all.push(r[k].clone());
            }
            st = i + 1;
        }
    }
    for i in 0..nets.len() {
        all.push(nets[i].clone());
    }
    Ok(collapse_nets(all))
}

// ------------------------------------------------------------ interfaces

#[derive(Clone)]
struct Iface {
    addr: Addr,
    net: Net,
}

fn parse_iface(v: i64, s: Str) -> Result[Iface, IpError] {
    let parts = split_addr_prefix(s)?;
    let a = parse_addr(v, parts[0])?;
    let plen = if parts.len() == 2 { make_netmask(v, parts[1])? } else { max_plen(v) };
    let mask = mask_of(v, plen);
    let na = if a.ip & mask != a.ip { addr_of(v, a.ip & mask) } else { a.clone() };
    Ok(Iface { addr: a, net: Net { addr: na, plen: plen } })
}

fn ip_interface(s: Str) -> Result[Iface, IpError] {
    for v in [4, 6] {
        match parse_iface(v, s) {
            Ok(i) => return Ok(i),
            Err(e) => {
                if not is_addr_or_mask(e) {
                    return Err(e);
                }
            }
        }
    }
    Err(ve(f"{py_repr(s)} does not appear to be an IPv4 or IPv6 interface"))
}

// ------------------------------------------------------------ special ranges

fn cidr(s: Str) -> Net {
    match ip_network(s, true) {
        Ok(n) => n,
        Err(_) => net_of(4, 0, 0),
    }
}

fn in_cidr(a: ref Addr, s: Str) -> bool {
    contains(cidr(s), a)
}

fn in_any(a: ref Addr, list: ref Vec[String]) -> bool {
    for i in 0..list.len() {
        if in_cidr(a, list[i]) {
            return true;
        }
    }
    false
}

fn words(s: Str) -> Vec[String] {
    split_ws(s)
}

// The not globally reachable blocks of the IANA special-purpose registries,
// and their exceptions, as ipaddress lists them.
fn private_nets(v: i64) -> Vec[String] {
    if v == 4 {
        words("0.0.0.0/8 10.0.0.0/8 127.0.0.0/8 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.0.0.170/31 192.0.2.0/24 192.168.0.0/16 198.18.0.0/15 198.51.100.0/24 203.0.113.0/24 240.0.0.0/4 255.255.255.255/32")
    } else {
        words("::1/128 ::/128 ::ffff:0:0/96 64:ff9b:1::/48 100::/64 2001::/23 2001:db8::/32 2002::/16 3fff::/20 fc00::/7 fe80::/10")
    }
}

fn private_exceptions(v: i64) -> Vec[String] {
    if v == 4 {
        words("192.0.0.9/32 192.0.0.10/32")
    } else {
        words("2001:1::1/128 2001:1::2/128 2001:3::/32 2001:4:112::/48 2001:20::/28 2001:30::/28")
    }
}

fn reserved_v6() -> Vec[String] {
    words("::/8 100::/8 200::/7 400::/6 800::/5 1000::/4 4000::/3 6000::/3 8000::/3 A000::/3 C000::/3 E000::/4 F000::/5 F800::/6 FE00::/9")
}

// The is_* properties of an address. An IPv4-mapped address answers with
// its IPv4 address's, except for is_site_local.
fn addr_flag(a: ref Addr, name: Str) -> bool {
    if is_mapped(a) and name != "site_local" {
        return addr_flag(mapped_v4(a), name);
    }
    let v4 = a.v == 4;
    if name == "private" {
        return in_any(a, private_nets(a.v)) and not in_any(a, private_exceptions(a.v));
    }
    if name == "global" {
        if v4 {
            return not in_cidr(a, "100.64.0.0/10") and not addr_flag(a, "private");
        }
        return not addr_flag(a, "private");
    }
    if name == "multicast" {
        return in_cidr(a, if v4 { "224.0.0.0/4" } else { "ff00::/8" });
    }
    if name == "loopback" {
        return if v4 { in_cidr(a, "127.0.0.0/8") } else { a.ip == 1 };
    }
    if name == "link_local" {
        return in_cidr(a, if v4 { "169.254.0.0/16" } else { "fe80::/10" });
    }
    if name == "reserved" {
        return if v4 { in_cidr(a, "240.0.0.0/4") } else { in_any(a, reserved_v6()) };
    }
    if name == "unspecified" {
        return a.ip == 0;
    }
    if name == "site_local" {
        return not v4 and in_cidr(a, "fec0::/10");
    }
    false
}

// The is_* properties of a network.
fn net_flag(n: ref Net, name: Str) -> bool {
    let v = n.addr.v;
    let first = n.addr.clone();
    let last = addr_of(v, broadcast(n));
    if name == "private" {
        let p = private_nets(v);
        let x = private_exceptions(v);
        let mut any = false;
        for i in 0..p.len() {
            let pn = cidr(p[i]);
            if contains(pn, first) and contains(pn, last) {
                any = true;
            }
        }
        for i in 0..x.len() {
            let xn = cidr(x[i]);
            if contains(xn, first) or contains(xn, last) {
                return false;
            }
        }
        return any;
    }
    if name == "global" {
        if v == 4 and in_cidr(first, "100.64.0.0/10") and in_cidr(last, "100.64.0.0/10") {
            return false;
        }
        return not net_flag(n, "private");
    }
    if name == "site_local" and v == 4 {
        return false;
    }
    addr_flag(first, name) and addr_flag(last, name)
}

fn flag_names() -> Vec[String] {
    words("private global multicast loopback link_local reserved unspecified site_local")
}

fn addr_flags(a: ref Addr) -> String {
    let names = flag_names();
    let mut on: Vec[String] = Vec.new();
    for i in 0..names.len() {
        // IPv4Address has no is_site_local
        if a.v == 4 and names[i] == "site_local" {
            continue;
        }
        if addr_flag(a, names[i]) {
            on.push(names[i].clone());
        }
    }
    if on.len() == 0 { "-".to_string() } else { ip_join(on, " ") }
}

fn net_flags(n: ref Net) -> String {
    let names = flag_names();
    let mut on: Vec[String] = Vec.new();
    for i in 0..names.len() {
        if net_flag(n, names[i]) {
            on.push(names[i].clone());
        }
    }
    if on.len() == 0 { "-".to_string() } else { ip_join(on, " ") }
}


// ------------------------------------------------------------ errors

// EmailSyntaxError, EmailUndeliverableError, or an exception that is not
// an EmailNotValidError at all (ValueError, TypeError).
#[derive(Clone)]
struct EvError {
    kind: String,
    msg: String,
}

fn syntax(msg: own String) -> EvError {
    EvError { kind: "EmailSyntaxError".to_string(), msg: msg }
}

fn undeliverable(msg: own String) -> EvError {
    EvError { kind: "EmailUndeliverableError".to_string(), msg: msg }
}

fn failure(e: ref EvError) -> String {
    f"! {e.kind}: {e.msg}"
}

// ------------------------------------------------------------ rfc_constants

const EMAIL_MAX_LENGTH: i64 = 254;
const LOCAL_PART_MAX_LENGTH: i64 = 64;
const DNS_LABEL_LENGTH_LIMIT: i64 = 63;
const DOMAIN_MAX_LENGTH: i64 = 253;

fn cp_alnum(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

// ATEXT: the characters RFC 5322 3.2.3 permits in an atom.
fn is_atext(c: i64) -> bool {
    if cp_alnum(c) {
        return true;
    }
    for x in "_!#$%&'*+-/=?^`{|}~".chars() {
        if c == (x as u32) as i64 {
            return true;
        }
    }
    false
}

// ATEXT_RE: ATEXT plus dots.
fn atext_or_dot(c: i64) -> bool {
    c == 46 or is_atext(c)
}

// ATEXT_INTL: ATEXT plus U+0080 to U+10FFFF (RFC 6531 3.3).
fn atext_intl(c: i64) -> bool {
    is_atext(c) or c >= 0x80
}

fn atext_intl_or_dot(c: i64) -> bool {
    c == 46 or atext_intl(c)
}

// ATEXT_HOSTNAME_INTL
fn hostname_intl(c: i64) -> bool {
    cp_alnum(c) or c == 45 or c == 46 or c >= 0x80
}

// QTEXT_INTL
fn qtext_intl(c: i64) -> bool {
    (c >= 0x20 and c <= 0x7E) or c >= 0x80
}

// DOMAIN_LITERAL_CHARS: [!-ú^-~]
fn domain_literal_char(c: i64) -> bool {
    c >= 0x21 and c <= 0xFA
}

// DOT_ATOM_TEXT and DOT_ATOM_TEXT_INTL: runs of allowed characters
// separated by single dots, matched against the whole string.
fn dot_atom(cs: ref Vec[i64], intl: bool) -> bool {
    if cs.len() == 0 {
        return false;
    }
    let mut run = 0;
    for c in cs.iter() {
        if *c == 46 {
            if run == 0 {
                return false;
            }
            run = 0;
        } else if (intl and atext_intl(*c)) or (not intl and is_atext(*c)) {
            run += 1;
        } else {
            return false;
        }
    }
    run > 0
}

// DOT_ATOM_TEXT_HOSTNAME: labels of letters, digits and inner hyphens.
fn dot_atom_hostname(cs: ref Vec[i64]) -> bool {
    for label in split_on_cp(cs, 46).iter() {
        if label.len() == 0 or not cp_alnum(label[0]) or not cp_alnum(label[label.len() - 1]) {
            return false;
        }
        for c in label.iter() {
            if not cp_alnum(*c) and *c != 45 {
                return false;
            }
        }
    }
    true
}

fn split_on_cp(cs: ref Vec[i64], sep: i64) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    for c in cs.iter() {
        if *c == sep {
            out.push(cur.clone());
            cur = Vec.new();
        } else {
            cur.push(*c);
        }
    }
    out.push(cur);
    out
}

const RFC2142: Array[Str, 15] = ["info", "marketing", "sales", "support", "abuse", "noc", "security", "postmaster",
    "hostmaster", "usenet", "news", "webmaster", "www", "uucp", "ftp"];

const SPECIAL_USE: Array[Str, 6] = ["arpa", "invalid", "local", "localhost", "onion", "test"];

// ------------------------------------------------------------ text

fn cps_has(cs: ref Vec[i64], c: i64) -> bool {
    for x in cs.iter() {
        if *x == c {
            return true;
        }
    }
    false
}

fn cps_find(cs: ref Vec[i64], p: Str) -> bool {
    let pc = cps_of(p);
    if pc.len() > cs.len() {
        return false;
    }
    let mut i = 0;
    while i + pc.len() <= cs.len() {
        let mut k = 0;
        while k < pc.len() and cs[i + k] == pc[k] {
            k += 1;
        }
        if k == pc.len() {
            return true;
        }
        i += 1;
    }
    false
}

fn ends_with_cps(cs: ref Vec[i64], p: Str) -> bool {
    let pc = cps_of(p);
    if cs.len() < pc.len() {
        return false;
    }
    let off = cs.len() - pc.len();
    for i in 0..pc.len() {
        if cs[off + i] != pc[i] {
            return false;
        }
    }
    true
}

fn rstrip_cp(cs: ref Vec[i64], c: i64) -> Vec[i64] {
    let mut n = cs.len();
    while n > 0 and cs[n - 1] == c {
        n -= 1;
    }
    sub(cs, 0, n)
}

// str.isspace()
fn py_space(c: i64) -> bool {
    (c >= 9 and c <= 13) or (c >= 28 and c <= 32) or c == 0x85 or c == 0xA0 or c == 0x1680
        or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F
        or c == 0x3000
}

fn rstrip_space(cs: ref Vec[i64]) -> Vec[i64] {
    let mut n = cs.len();
    while n > 0 and py_space(cs[n - 1]) {
        n -= 1;
    }
    sub(cs, 0, n)
}

fn strip_space(cs: ref Vec[i64]) -> Vec[i64] {
    let r = rstrip_space(cs);
    let mut i = 0;
    while i < r.len() and py_space(r[i]) {
        i += 1;
    }
    sub(r, i, r.len())
}

fn utf8_len(cp: i64) -> i64 {
    if cp < 0x80 {
        1
    } else if cp < 0x800 {
        2
    } else if cp < 0x10000 {
        3
    } else {
        4
    }
}

fn utf8_total(cs: ref Vec[i64]) -> i64 {
    let mut n = 0;
    for c in cs.iter() {
        n += utf8_len(*c);
    }
    n
}

fn join_strs(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

// sorted(set_of_strings)
fn sorted_unique(v: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for s in v.iter() {
        let mut seen = false;
        for o in out.iter() {
            if o == s {
                seen = true;
            }
        }
        if not seen {
            out.push(s.clone());
        }
    }
    out.sort();
    out
}

fn py_bool(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

fn opt_repr(o: ref Option[Vec[i64]], t: ref Tables) -> String {
    match o {
        Some(v) => t.repr(v),
        None => "None".to_string(),
    }
}

// ------------------------------------------------------------ syntax.py

fn safe_character_display(c: i64, t: ref Tables) -> String {
    if c == 92 {
        return "\"\\\"".to_string();
    }
    let cat = t.category(c);
    if cat.starts_with("L") or cat.starts_with("N") or cat.starts_with("P") or cat.starts_with("S") {
        let mut one: Vec[i64] = Vec.new();
        one.push(c);
        return t.repr(one);
    }
    let h = if c < 0xFFFF { f"U+{hex_upper(c, 4)}" } else { f"U+{hex_upper(c, 8)}" };
    let name = t.uname(c);
    if name.len() == 0 { h } else { name }
}

// ", ".join(sorted({safe_character_display(c) for c in s if bad(c)}))
fn bad_list(cs: ref Vec[i64], bad: ref Vec[bool], t: ref Tables) -> String {
    let mut shown: Vec[String] = Vec.new();
    for i in 0..cs.len() {
        if bad[i] {
            shown.push(safe_character_display(cs[i], t));
        }
    }
    join_strs(sorted_unique(shown), ", ")
}

fn any_bad(bad: ref Vec[bool]) -> bool {
    for b in bad.iter() {
        if *b {
            return true;
        }
    }
    false
}

// split_string_at_unquoted_special
fn split_at_special(text: ref Vec[i64], specials: ref Vec[i64], t: ref Tables) -> Result[(Vec[i64], Vec[i64]), EvError] {
    let mut inside_quote = false;
    let mut escaped = false;
    let mut left: Vec[i64] = Vec.new();
    for i in 0..text.len() {
        let c = text[i];
        let rest = t.nfc(sub(text, i, text.len()));
        if rest[0] != c {
            left.push(c);
        } else if inside_quote {
            left.push(c);
            if c == 92 and not escaped {
                escaped = true;
            } else if c == 34 and not escaped {
                inside_quote = false;
                escaped = false;
            } else {
                escaped = false;
            }
        } else if c == 34 {
            left.push(c);
            inside_quote = true;
        } else if cps_has(specials, c) {
            break;
        } else {
            left.push(c);
        }
    }
    if left.len() == text.len() {
        return Err(syntax("An email address must have an @-sign.".to_string()));
    }
    let right = sub(text, left.len(), text.len());
    Ok((left, right))
}

// unquote_quoted_string
fn unquote(text: ref Vec[i64], t: ref Tables) -> Result[(Vec[i64], bool), EvError] {
    let mut quoted = false;
    let mut escaped = false;
    let mut value: Vec[i64] = Vec.new();
    for i in 0..text.len() {
        let c = text[i];
        if quoted {
            if escaped {
                value.push(c);
                escaped = false;
            } else if c == 92 {
                escaped = true;
            } else if c == 34 {
                if i != text.len() - 1 {
                    let mut shown: Vec[String] = Vec.new();
                    for k in (i + 1)..text.len() {
                        shown.push(safe_character_display(text[k], t));
                    }
                    return Err(syntax(f"Extra character(s) found after close quote: {join_strs(shown, ", ")}"));
                }
                break;
            } else {
                value.push(c);
            }
        } else if i == 0 and c == 34 {
            quoted = true;
        } else {
            value.push(c);
        }
    }
    Ok((value, quoted))
}

struct Split {
    display_name: Option[Vec[i64]],
    local_part: Vec[i64],
    domain_part: Vec[i64],
    quoted: bool,
}

fn split_email(email: ref Vec[i64], t: ref Tables) -> Result[Split, EvError] {
    let (left0, right0) = split_at_special(email, cps_of("@<"), t)?;
    let mut display_name: Option[Vec[i64]] = None;
    let mut local_part = left0.clone();
    let mut domain_part = right0.clone();
    if right0.len() > 0 and right0[0] == 60 {
        let left = rstrip_space(left0);
        let (dn, dn_quoted) = unquote(left, t)?;
        if not dn_quoted {
            let mut bad: Vec[bool] = Vec.new();
            for c in dn.iter() {
                bad.push((not atext_or_dot(*c) and *c != 32) or *c == 46);
            }
            if any_bad(bad) {
                return Err(syntax(f"The display name contains invalid characters when not quoted: {bad_list(dn, bad, t)}."));
            }
        }
        check_unsafe_chars(dn, true, t)?;
        if not cps_has(right0, 62) {
            return Err(syntax("An open angle bracket at the start of the email address has to be followed by a close angle bracket at the end.".to_string()));
        }
        let right = rstrip_cp(right0, 32);
        if right[right.len() - 1] != 62 {
            return Err(syntax("There can't be anything after the email address.".to_string()));
        }
        let addr_spec = rstrip_cp(sub(right, 1, right.len()), 62);
        let (l, d) = split_at_special(addr_spec, cps_of("@"), t)?;
        local_part = l;
        domain_part = d;
        display_name = Some(dn);
    }
    if domain_part.len() > 0 and domain_part[0] == 64 {
        domain_part = sub(domain_part, 1, domain_part.len());
    }
    let (local, quoted) = unquote(local_part, t)?;
    Ok(Split { display_name: display_name, local_part: local, domain_part: domain_part, quoted: quoted })
}

fn length_reason(n: i64, limit: i64) -> String {
    let diff = n - limit;
    let suffix = if diff > 1 { "s" } else { "" };
    f"({diff} character{suffix} too many)"
}

struct LocalInfo {
    local_part: Vec[i64],
    ascii_local_part: Option[Vec[i64]],
    smtputf8: bool,
}

fn validate_local_part(local: ref Vec[i64], allow_smtputf8: bool, allow_empty_local: bool, quoted_local_part: bool, t: ref Tables) -> Result[LocalInfo, EvError] {
    if local.len() == 0 {
        if not allow_empty_local {
            return Err(syntax("There must be something before the @-sign.".to_string()));
        }
        return Ok(LocalInfo { local_part: local.clone(), ascii_local_part: Some(local.clone()), smtputf8: false });
    }
    if local.len() > LOCAL_PART_MAX_LENGTH {
        let reason = length_reason(local.len(), LOCAL_PART_MAX_LENGTH);
        return Err(syntax(f"The email address is too long before the @-sign {reason}."));
    }
    if dot_atom(local, false) {
        return Ok(LocalInfo { local_part: local.clone(), ascii_local_part: Some(local.clone()), smtputf8: false });
    }
    let mut valid = "";
    let mut requires_smtputf8 = false;
    if dot_atom(local, true) {
        if not allow_smtputf8 {
            let mut bad: Vec[bool] = Vec.new();
            for c in local.iter() {
                bad.push(not atext_or_dot(*c));
            }
            if any_bad(bad) {
                return Err(syntax(f"Internationalized characters before the @-sign are not supported: {bad_list(local, bad, t)}."));
            }
            return Err(syntax("Internationalized characters before the @-sign are not supported.".to_string()));
        }
        valid = "dot-atom";
        requires_smtputf8 = true;
    } else if quoted_local_part {
        let mut bad: Vec[bool] = Vec.new();
        for c in local.iter() {
            bad.push(not qtext_intl(*c));
        }
        if any_bad(bad) {
            return Err(syntax(f"The email address contains invalid characters in quotes before the @-sign: {bad_list(local, bad, t)}."));
        }
        let mut non_ascii: Vec[bool] = Vec.new();
        for c in local.iter() {
            non_ascii.push(not (*c >= 32 and *c <= 126));
        }
        if any_bad(non_ascii) {
            requires_smtputf8 = true;
            if not allow_smtputf8 {
                return Err(syntax(f"Internationalized characters before the @-sign are not supported: {bad_list(local, non_ascii, t)}."));
            }
        }
        valid = "quoted";
    }
    if valid.len() > 0 {
        check_unsafe_chars(local, valid == "quoted", t)?;
        let mut out = local.clone();
        if valid == "quoted" {
            out = Vec.new();
            out.push(34);
            for c in local.iter() {
                if *c == 34 or *c == 92 {
                    out.push(92);
                }
                out.push(*c);
            }
            out.push(34);
        }
        let ascii = if requires_smtputf8 { None } else { Some(out.clone()) };
        return Ok(LocalInfo { local_part: out, ascii_local_part: ascii, smtputf8: requires_smtputf8 });
    }
    let mut bad: Vec[bool] = Vec.new();
    for c in local.iter() {
        bad.push(not atext_intl_or_dot(*c));
    }
    if any_bad(bad) {
        return Err(syntax(f"The email address contains invalid characters before the @-sign: {bad_list(local, bad, t)}."));
    }
    check_dot_atom(local, "An email address cannot start with a {}.", "An email address cannot have a {} immediately before the @-sign.", false)?;
    Err(syntax("The email address contains invalid characters before the @-sign.".to_string()))
}

fn check_unsafe_chars(s: ref Vec[i64], allow_space: bool, t: ref Tables) -> Result[(), EvError] {
    let mut bad: Vec[i64] = Vec.new();
    for i in 0..s.len() {
        let c = s[i];
        let cat = t.category(c);
        let first = if cat.len() > 0 { cat.chars().next().unwrap() } else { '?' };
        let is_bad = if first == 'L' or first == 'N' or first == 'P' or first == 'S' {
            false
        } else if first == 'M' {
            i == 0
        } else if cat == "Zs" {
            not allow_space
        } else {
            true
        };
        if is_bad and not cps_has(bad, c) {
            bad.push(c);
        }
    }
    if bad.len() > 0 {
        bad.sort();
        let mut shown: Vec[String] = Vec.new();
        for c in bad.iter() {
            shown.push(safe_character_display(*c, t));
        }
        return Err(syntax(f"The email address contains unsafe characters: {join_strs(shown, ", ")}."));
    }
    Ok(())
}

fn fill(template: Str, word: Str) -> String {
    template.replace("{}", word)
}

fn check_dot_atom(label: ref Vec[i64], start_descr: Str, end_descr: Str, is_hostname: bool) -> Result[(), EvError] {
    if ends_with_cps(label, ".") {
        return Err(syntax(fill(end_descr, "period")));
    }
    if starts_with_cps(label, ".") {
        return Err(syntax(fill(start_descr, "period")));
    }
    if cps_find(label, "..") {
        return Err(syntax("An email address cannot have two periods in a row.".to_string()));
    }
    if is_hostname {
        if ends_with_cps(label, "-") {
            return Err(syntax(fill(end_descr, "hyphen")));
        }
        if starts_with_cps(label, "-") {
            return Err(syntax(fill(start_descr, "hyphen")));
        }
        if cps_find(label, ".-") or cps_find(label, "-.") {
            return Err(syntax("An email address cannot have a period and a hyphen next to each other.".to_string()));
        }
    }
    Ok(())
}

fn plain_opts() -> Opts {
    Opts { strict: false, uts46: false, std3: false, display: false }
}

// Returns (ascii_domain, domain).
fn validate_domain_name(domain0: ref Vec[i64], test_environment: bool, globally_deliverable: bool, t: ref Tables) -> Result[(Vec[i64], Vec[i64]), EvError] {
    let mut bad: Vec[bool] = Vec.new();
    for c in domain0.iter() {
        bad.push(not hostname_intl(*c));
    }
    if any_bad(bad) {
        return Err(syntax(f"The part after the @-sign contains invalid characters: {bad_list(domain0, bad, t)}."));
    }
    check_unsafe_chars(domain0, false, t)?;
    let domain = match uts46_remap(domain0, false, t) {
        Ok(d) => d,
        Err(e) => return Err(syntax(f"The part after the @-sign contains invalid characters ({e.msg}).")),
    };
    let mut bad2: Vec[bool] = Vec.new();
    for c in domain.iter() {
        bad2.push(not hostname_intl(*c));
    }
    if any_bad(bad2) {
        return Err(syntax(f"The part after the @-sign contains invalid characters after Unicode normalization: {bad_list(domain, bad2, t)}."));
    }
    check_dot_atom(domain, "An email address cannot have a {} immediately after the @-sign.", "An email address cannot end with a {}.", true)?;
    // re.match(r"(?!xn)..--", label, re.I)
    for label in split_on_cp(domain, 46).iter() {
        if label.len() >= 4 and label[2] == 45 and label[3] == 45 and label[0] != 10 and label[1] != 10 {
            let low = ascii_lower_cps(sub(label, 0, 2));
            if not cps_eq(low, cps_of("xn")) {
                return Err(syntax("An email address cannot have two letters followed by two dashes immediately after the @-sign or after a period, except Punycode.".to_string()));
            }
        }
    }
    let ascii_domain = if dot_atom_hostname(domain) {
        domain.clone()
    } else {
        let mut parts: Vec[Vec[i64]] = Vec.new();
        for label in split_on_cp(domain, 46).iter() {
            match alabel(label, t) {
                Ok(a) => parts.push(a),
                Err(e) => return Err(syntax(f"The part after the @-sign is invalid ({e.msg}).")),
            }
        }
        let joined = join_labels(parts);
        if not dot_atom_hostname(joined) {
            return Err(syntax("The email address contains invalid characters after the @-sign after IDNA encoding.".to_string()));
        }
        joined
    };
    if ascii_domain.len() > DOMAIN_MAX_LENGTH {
        if cps_eq(ascii_domain, domain0) {
            let reason = length_reason(ascii_domain.len(), DOMAIN_MAX_LENGTH);
            return Err(syntax(f"The email address is too long after the @-sign {reason}."));
        }
        let diff = ascii_domain.len() - DOMAIN_MAX_LENGTH;
        let s = if diff == 1 { "" } else { "s" };
        return Err(syntax(f"The email address is too long after the @-sign ({diff} byte{s} too many after IDNA encoding)."));
    }
    for label in split_on_cp(ascii_domain, 46).iter() {
        if label.len() > DNS_LABEL_LENGTH_LIMIT {
            let reason = length_reason(label.len(), DNS_LABEL_LENGTH_LIMIT);
            return Err(syntax(f"After the @-sign, periods cannot be separated by so many characters {reason}."));
        }
    }
    if globally_deliverable {
        if not cps_has(ascii_domain, 46) and not (cps_eq(ascii_domain, cps_of("test")) and test_environment) {
            return Err(syntax("The part after the @-sign is not valid. It should have a period.".to_string()));
        }
        let last = if ascii_domain.len() > 0 { ascii_domain[ascii_domain.len() - 1] } else { 0 };
        if not ((last >= 65 and last <= 90) or (last >= 97 and last <= 122)) {
            return Err(syntax("The part after the @-sign is not valid. It is not within a valid top-level domain.".to_string()));
        }
    }
    for d in SPECIAL_USE.iter() {
        if *d == "test" and test_environment {
            continue;
        }
        if cps_eq(ascii_domain, cps_of(*d)) or ends_with_cps(ascii_domain, f".{d}") {
            return Err(syntax("The part after the @-sign is a special-use or reserved name that cannot be used with email.".to_string()));
        }
    }
    let domain_i18n = match decode(ascii_domain, plain_opts(), t) {
        Ok(d) => d,
        Err(e) => return Err(syntax(f"The part after the @-sign is not valid IDNA ({e.msg}).")),
    };
    let mut bad3: Vec[bool] = Vec.new();
    for c in domain.iter() {
        bad3.push(not hostname_intl(*c));
    }
    if any_bad(bad3) {
        return Err(syntax(f"The part after the @-sign contains invalid characters: {bad_list(domain, bad3, t)}."));
    }
    check_unsafe_chars(domain, false, t)?;
    if let Err(e) = encode(domain_i18n, plain_opts(), t) {
        return Err(syntax(f"The part after the @-sign became invalid after normalizing to international characters ({e.msg})."));
    }
    Ok((ascii_domain, domain_i18n))
}

// Returns (domain, repr of domain_address).
fn validate_domain_literal(lit: ref Vec[i64], t: ref Tables) -> Result[(Vec[i64], String), EvError] {
    // re.match(r"^[0-9\.]+$", lit): $ also matches before a final newline
    let body = if lit.len() > 0 and lit[lit.len() - 1] == 10 { sub(lit, 0, lit.len() - 1) } else { lit.clone() };
    let mut digits_dots = body.len() > 0;
    for c in body.iter() {
        if not ((*c >= 48 and *c <= 57) or *c == 46) {
            digits_dots = false;
        }
    }
    if digits_dots {
        return match v4_addr(cps_str(lit)) {
            Ok(a) => Ok((cps_of(f"[{addr_str(a)}]"), addr_repr(a))),
            Err(e) => Err(syntax(f"The address in brackets after the @-sign is not valid: It is not an IPv4 address ({e.msg}) or is missing an address literal tag.")),
        };
    }
    if starts_with_cps(lit, "IPv6:") {
        return match v6_addr(cps_str(sub(lit, 5, lit.len()))) {
            Ok(a) => Ok((cps_of(f"[IPv6:{addr_str(a)}]"), addr_repr(a))),
            Err(e) => Err(syntax(f"The IPv6 address in brackets after the @-sign is not valid ({e.msg}).")),
        };
    }
    if not cps_has(lit, 58) {
        return Err(syntax("The part after the @-sign in brackets is not an IPv4 address and has no address literal tag.".to_string()));
    }
    let mut bad: Vec[bool] = Vec.new();
    for c in lit.iter() {
        bad.push(not domain_literal_char(*c));
    }
    if any_bad(bad) {
        return Err(syntax(f"The part after the @-sign contains invalid characters in brackets: {bad_list(lit, bad, t)}."));
    }
    Err(syntax("The part after the @-sign contains an invalid address literal tag in brackets.".to_string()))
}

// ------------------------------------------------------------ validate_email

struct Options {
    allow_smtputf8: bool,
    allow_empty_local: bool,
    allow_quoted_local: bool,
    allow_domain_literal: bool,
    allow_display_name: bool,
    check_deliverability: bool,
    test_environment: bool,
    globally_deliverable: bool,
    timeout: Option[i64],
    resolver: bool,
    // A keyword validate_email does not take, as a TypeError names it.
    unknown_keyword: String,
}

fn default_options() -> Options {
    Options {
        allow_smtputf8: true,
        allow_empty_local: false,
        allow_quoted_local: false,
        allow_domain_literal: false,
        allow_display_name: false,
        check_deliverability: true,
        test_environment: false,
        globally_deliverable: true,
        timeout: None,
        resolver: false,
        unknown_keyword: String.new(),
    }
}

// ValidatedEmail. mx and mx_fallback_type exist only once a
// deliverability check has set them.
struct Validated {
    original: Vec[i64],
    normalized: Vec[i64],
    local_part: Vec[i64],
    domain: Vec[i64],
    ascii_email: Option[Vec[i64]],
    ascii_local_part: Option[Vec[i64]],
    ascii_domain: Vec[i64],
    smtputf8: bool,
    display_name: Option[Vec[i64]],
    domain_address: Option[String],
    mx: Option[Vec[(i64, String)]],
    has_fallback: bool,
    mx_fallback_type: Option[String],
}

// The input: a str, or bytes (Some) that must be ASCII.
fn validate_email(text: ref Vec[i64], raw: ref Option[Vec[i64]], o: ref Options, dns: ref Dns, t: ref Tables) -> Result[Validated, EvError] {
    if o.unknown_keyword.len() > 0 {
        return Err(EvError { kind: "TypeError".to_string(), msg: f"validate_email() got an unexpected keyword argument '{o.unknown_keyword}'" });
    }
    let email = match raw {
        Some(b) => {
            if not is_ascii(b) {
                return Err(syntax("The email address is not valid ASCII.".to_string()));
            }
            b.clone()
        }
        None => text.clone(),
    };
    let sp = split_email(email, t)?;
    let mut original: Vec[i64] = Vec.new();
    if sp.quoted {
        original.push(34);
    }
    for c in sp.local_part.iter() {
        original.push(*c);
    }
    if sp.quoted {
        original.push(34);
    }
    original.push(64);
    for c in sp.domain_part.iter() {
        original.push(*c);
    }
    let info = validate_local_part(sp.local_part, o.allow_smtputf8, o.allow_empty_local, sp.quoted, t)?;
    let mut local_part = info.local_part.clone();
    let mut ascii_local_part = info.ascii_local_part.clone();
    let smtputf8 = info.smtputf8;
    let normalized_local = t.nfc(local_part);
    if not cps_eq(normalized_local, local_part) {
        if let Err(e) = validate_local_part(normalized_local, o.allow_smtputf8, o.allow_empty_local, sp.quoted, t) {
            return Err(syntax(f"After Unicode normalization: {e.msg}"));
        }
        local_part = normalized_local;
    }
    if sp.quoted and not o.allow_quoted_local {
        return Err(syntax("Quoting the part before the @-sign is not allowed here.".to_string()));
    }
    if let Some(a) = ascii_local_part.clone() {
        let low = cps_str(ascii_lower_cps(a));
        let mut listed = false;
        for n in RFC2142.iter() {
            if low == *n {
                listed = true;
            }
        }
        if listed {
            ascii_local_part = Some(ascii_lower_cps(a));
            local_part = ascii_lower_cps(local_part);
        }
    }
    let mut is_literal = false;
    let mut domain_address: Option[String] = None;
    let dp = ref sp.domain_part;
    let (domain, ascii_domain) = if dp.len() == 0 {
        return Err(syntax("There must be something after the @-sign.".to_string()));
    } else if dp[0] == 91 and dp[dp.len() - 1] == 93 {
        let (d, addr) = validate_domain_literal(sub(dp, 1, dp.len() - 1), t)?;
        if not o.allow_domain_literal {
            return Err(syntax("A bracketed IP address after the @-sign is not allowed here.".to_string()));
        }
        domain_address = Some(addr);
        is_literal = true;
        (d.clone(), d)
    } else {
        let (a, d) = validate_domain_name(dp, o.test_environment, o.globally_deliverable, t)?;
        (d, a)
    };
    let mut normalized = local_part.clone();
    normalized.push(64);
    for c in domain.iter() {
        normalized.push(*c);
    }
    let ascii_email = if not smtputf8 {
        let mut e = match ascii_local_part.clone() {
            Some(a) => a,
            None => Vec.new(),
        };
        e.push(64);
        for c in ascii_domain.iter() {
            e.push(*c);
        }
        Some(e)
    } else {
        None
    };
    let mut v = Validated {
        original: original,
        normalized: normalized,
        local_part: local_part,
        domain: domain,
        ascii_email: ascii_email,
        ascii_local_part: ascii_local_part,
        ascii_domain: ascii_domain,
        smtputf8: smtputf8,
        display_name: sp.display_name.clone(),
        domain_address: domain_address,
        mx: None,
        has_fallback: false,
        mx_fallback_type: None,
    };
    validate_email_length(v)?;
    if sp.display_name.is_some() and not o.allow_display_name {
        return Err(syntax("A display name and angle brackets around the email address are not permitted here.".to_string()));
    }
    if o.check_deliverability and not o.test_environment {
        if is_literal {
            return Ok(v);
        }
        let d = validate_deliverability(v.ascii_domain, v.domain, o, dns)?;
        v.mx = d.mx;
        v.has_fallback = true;
        v.mx_fallback_type = d.fallback;
    }
    Ok(v)
}

fn validate_email_length(v: ref Validated) -> Result[(), EvError] {
    let mut third: Vec[i64] = match v.ascii_local_part.clone() {
        Some(a) => if a.len() > 0 { a } else { v.local_part.clone() },
        None => v.local_part.clone(),
    };
    third.push(64);
    for c in v.ascii_domain.iter() {
        third.push(*c);
    }
    let checks: Vec[(Vec[i64], Str)] = vec![(v.original.clone(), ""), (v.normalized.clone(), "after normalization"),
        (third, "when the part after the @-sign is converted to IDNA ASCII")];
    for (addr, why) in checks.iter() {
        let addr_len = addr.len();
        let addr_utf8_len = utf8_total(addr);
        let diff = addr_utf8_len - EMAIL_MAX_LENGTH;
        if diff > 0 {
            let suffix = if diff > 1 { "s" } else { "" };
            let reason = if why.len() == 0 and addr_len == addr_utf8_len {
                length_reason(addr_len, EMAIL_MAX_LENGTH)
            } else if why.len() == 0 {
                let mut mbpc = 0;
                for c in addr.iter() {
                    if utf8_len(*c) > mbpc {
                        mbpc = utf8_len(*c);
                    }
                }
                let mut mchars = diff / mbpc;
                if mchars < 1 {
                    mchars = 1;
                }
                if mchars == diff {
                    f"({diff} character{suffix} too many)"
                } else {
                    f"({mchars}-{diff} character{suffix} too many)"
                }
            } else {
                f"{why} ({diff} byte{suffix} too many)"
            };
            return Err(syntax(f"The email address is too long {reason}."));
        }
    }
    Ok(())
}

// ------------------------------------------------------------ the DNS

enum DnsFail {
    NxDomain,
    NoAnswer,
    Timeout,
    NoNameservers,
    YxDomain,
}

struct DnsRecord {
    name: String,
    rtype: String,
    value: String,
}

// Answers resolve(name, type) from data/dns.tsv: a name with no records
// does not exist, a name without records of the type has no answer, and
// NXDOMAIN, TIMEOUT, NONAMESERVERS and YXDOMAIN rows make every query for
// the name fail that way.
struct Dns {
    records: Vec[DnsRecord],
}

fn load_dns(text: ref String) -> Dns {
    let mut d = Dns { records: Vec.new() };
    for line in text.lines() {
        if line.len() == 0 or line.starts_with("#") {
            continue;
        }
        let f: Vec[Str] = line.split("\t").collect();
        d.records.push(DnsRecord { name: cps_str(ascii_lower_cps(cps_of(f[0]))), rtype: f[1].to_string(), value: f[2].to_string() });
    }
    d
}

fn resolve(d: ref Dns, qname: ref Vec[i64], rtype: Str) -> Result[Vec[String], DnsFail] {
    let name = cps_str(ascii_lower_cps(qname));
    let mut found = false;
    let mut out: Vec[String] = Vec.new();
    for r in d.records.iter() {
        if r.name != name {
            continue;
        }
        found = true;
        if r.rtype == "NXDOMAIN" {
            return Err(DnsFail.NxDomain);
        }
        if r.rtype == "TIMEOUT" {
            return Err(DnsFail.Timeout);
        }
        if r.rtype == "NONAMESERVERS" {
            return Err(DnsFail.NoNameservers);
        }
        if r.rtype == "YXDOMAIN" {
            return Err(DnsFail.YxDomain);
        }
    }
    if not found {
        return Err(DnsFail.NxDomain);
    }
    for r in d.records.iter() {
        if r.name == name and r.rtype == rtype {
            out.push(r.value.clone());
        }
    }
    if out.len() == 0 {
        return Err(DnsFail.NoAnswer);
    }
    Ok(out)
}

// The strings of a TXT record's text form, joined.
fn txt_value(text: ref String) -> String {
    let mut out = String.new();
    let mut inside = false;
    let mut escaped = false;
    for c in text.chars() {
        if escaped {
            out.push(c);
            escaped = false;
        } else if inside and c == '\\' {
            escaped = true;
        } else if c == '"' {
            inside = not inside;
        } else if inside {
            out.push(c);
        }
    }
    out
}

fn is_global_addr(s: ref String) -> bool {
    match ip_address(s) {
        Ok(a) => addr_flag(a, "global"),
        Err(_) => false,
    }
}

struct Deliverability {
    mx: Option[Vec[(i64, String)]],
    fallback: Option[String],
}

fn mx_lt(a: ref (i64, String), b: ref (i64, String)) -> bool {
    if a.0 != b.0 {
        return a.0 < b.0;
    }
    a.1 < b.1
}

// A fallback lookup: Ok(true) when a globally reachable address answered.
fn fallback(d: ref Dns, domain: ref Vec[i64], rtype: Str) -> Result[bool, DnsFail] {
    match resolve(d, domain, rtype) {
        Ok(addrs) => {
            for a in addrs.iter() {
                if is_global_addr(a) {
                    return Ok(true);
                }
            }
            Ok(false)
        }
        Err(DnsFail.NoAnswer) => Ok(false),
        Err(e) => Err(e),
    }
}

fn fail_info(e: DnsFail, domain_i18n: ref Vec[i64]) -> Result[Deliverability, EvError] {
    let d = cps_str(domain_i18n);
    match e {
        DnsFail.NxDomain => Err(undeliverable(f"The domain name {d} does not exist.")),
        DnsFail.NoNameservers => Ok(Deliverability { mx: None, fallback: None }),
        DnsFail.Timeout => Ok(Deliverability { mx: None, fallback: None }),
        DnsFail.YxDomain => Err(undeliverable("There was an error while checking if the domain name in the email address is deliverable: The DNS query name is too long after DNAME substitution.".to_string())),
        DnsFail.NoAnswer => Err(undeliverable(f"The domain name {d} does not accept email.")),
    }
}

fn validate_deliverability(domain: ref Vec[i64], domain_i18n: ref Vec[i64], o: ref Options, dns: ref Dns) -> Result[Deliverability, EvError] {
    if o.timeout.is_some() {
        return Err(EvError { kind: "ValueError".to_string(), msg: "It's not valid to pass both timeout and dns_resolver.".to_string() });
    }
    let d = cps_str(domain_i18n);
    match resolve(dns, domain, "MX") {
        Ok(rows) => {
            let mut mtas: Vec[(i64, String)] = Vec.new();
            for r in rows.iter() {
                let parts: Vec[Str] = r.split(" ").collect();
                let exchange = cps_str(rstrip_cp(cps_of(parts[1]), 46));
                if exchange.len() > 0 {
                    mtas.push((dec_parse(parts[0]), exchange));
                }
            }
            if mtas.len() == 0 {
                return Err(undeliverable(f"The domain name {d} does not accept email."));
            }
            let mut i = 1;
            while i < mtas.len() {
                let mut j = i;
                while j > 0 and mx_lt(mtas[j], mtas[j - 1]) {
                    let x = mtas[j].clone();
                    mtas[j] = mtas[j - 1].clone();
                    mtas[j - 1] = x;
                    j -= 1;
                }
                i += 1;
            }
            Ok(Deliverability { mx: Some(mtas), fallback: None })
        }
        Err(DnsFail.NoAnswer) => {
            let kind = match fallback(dns, domain, "A") {
                Ok(true) => "A",
                Ok(false) => match fallback(dns, domain, "AAAA") {
                    Ok(true) => "AAAA",
                    Ok(false) => return Err(undeliverable(f"The domain name {d} does not accept email.")),
                    Err(e) => return fail_info(e, domain_i18n),
                },
                Err(e) => return fail_info(e, domain_i18n),
            };
            match resolve(dns, domain, "TXT") {
                Ok(rows) => {
                    for r in rows.iter() {
                        let value = txt_value(r);
                        if value.starts_with("v=spf1 ") and value == "v=spf1 -all" {
                            return Err(undeliverable(f"The domain name {d} does not send email."));
                        }
                    }
                }
                Err(DnsFail.NoAnswer) => {}
                Err(e) => return fail_info(e, domain_i18n),
            }
            let mut mx: Vec[(i64, String)] = Vec.new();
            mx.push((0, cps_str(domain)));
            Ok(Deliverability { mx: Some(mx), fallback: Some(kind.to_string()) })
        }
        Err(e) => fail_info(e, domain_i18n),
    }
}

// ------------------------------------------------------------ showing results

fn mx_repr(mx: ref Vec[(i64, String)], t: ref Tables) -> String {
    let mut parts: Vec[String] = Vec.new();
    for (p, e) in mx.iter() {
        parts.push(f"({p}, {t.repr(cps_of(e))})");
    }
    f"[{join_strs(parts, ", ")}]"
}

fn str_opt_repr(o: ref Option[String], t: ref Tables) -> String {
    match o {
        Some(s) => t.repr(cps_of(s)),
        None => "None".to_string(),
    }
}

fn compact(v: ref Validated, t: ref Tables) -> String {
    let mut out = f"ok normalized={t.repr(v.normalized)} ascii_email={opt_repr(v.ascii_email, t)} smtputf8={py_bool(v.smtputf8)}";
    if let Some(dn) = v.display_name.clone() {
        out.push_str(f" display_name={t.repr(dn)}");
    }
    if let Some(a) = v.domain_address.clone() {
        out.push_str(f" address={a}");
    }
    if let Some(mx) = v.mx.clone() {
        out.push_str(f" mx={mx_repr(mx, t)}");
    }
    if v.has_fallback {
        out.push_str(f" fallback={str_opt_repr(v.mx_fallback_type, t)}");
    }
    out
}

// ValidatedEmail.as_constructor
fn as_constructor(v: ref Validated, t: ref Tables) -> String {
    let mut fields: Vec[String] = Vec.new();
    fields.push(f"\n  normalized={t.repr(v.normalized)}");
    fields.push(f"\n  local_part={t.repr(v.local_part)}");
    fields.push(f"\n  domain={t.repr(v.domain)}");
    fields.push(f"\n  ascii_email={opt_repr(v.ascii_email, t)}");
    fields.push(f"\n  ascii_local_part={opt_repr(v.ascii_local_part, t)}");
    fields.push(f"\n  ascii_domain={t.repr(v.ascii_domain)}");
    fields.push(f"\n  smtputf8={py_bool(v.smtputf8)}");
    if let Some(mx) = v.mx.clone() {
        fields.push(f"\n  mx={mx_repr(mx, t)}");
    }
    if v.has_fallback {
        fields.push(f"\n  mx_fallback_type={str_opt_repr(v.mx_fallback_type, t)}");
    }
    fields.push(f"\n  display_name={opt_repr(v.display_name, t)}");
    f"ValidatedEmail({join_strs(fields, ",")})"
}

// json.dumps(..., ensure_ascii=False) of a str.
fn json_str(s: ref String) -> String {
    let mut out = "\"".to_string();
    for c in s.chars() {
        let x = (c as u32) as i64;
        if c == '"' {
            out.push_str("\\\"");
        } else if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if x == 8 {
            out.push_str("\\b");
        } else if x == 12 {
            out.push_str("\\f");
        } else if x < 32 {
            out.push_str(f"\\u{hex_lower(x, 4)}");
        } else {
            out.push(c);
        }
    }
    out.push('"');
    out
}

fn json_opt(o: ref Option[Vec[i64]]) -> String {
    match o {
        Some(v) => json_str(cps_str(v)),
        None => "null".to_string(),
    }
}

// json.dumps(result.as_dict(), indent=2, sort_keys=True, ensure_ascii=False)
fn as_dict_json(v: ref Validated) -> Vec[String] {
    let mut members: Vec[(String, String)] = Vec.new();
    members.push(("ascii_domain".to_string(), json_str(cps_str(v.ascii_domain))));
    members.push(("ascii_email".to_string(), json_opt(v.ascii_email)));
    members.push(("ascii_local_part".to_string(), json_opt(v.ascii_local_part)));
    members.push(("display_name".to_string(), json_opt(v.display_name)));
    members.push(("domain".to_string(), json_str(cps_str(v.domain))));
    if let Some(a) = v.domain_address.clone() {
        members.push(("domain_address".to_string(), json_str(a)));
    }
    members.push(("local_part".to_string(), json_str(cps_str(v.local_part))));
    if let Some(mx) = v.mx.clone() {
        let mut items: Vec[String] = Vec.new();
        for (p, e) in mx.iter() {
            items.push(f"    [\n      {p},\n      {json_str(e)}\n    ]");
        }
        members.push(("mx".to_string(), f"[\n{join_strs(items, ",\n")}\n  ]"));
    }
    if v.has_fallback {
        let fb = match v.mx_fallback_type.clone() {
            Some(s) => json_str(s),
            None => "null".to_string(),
        };
        members.push(("mx_fallback_type".to_string(), fb));
    }
    members.push(("normalized".to_string(), json_str(cps_str(v.normalized))));
    members.push(("original".to_string(), json_str(cps_str(v.original))));
    members.push(("smtputf8".to_string(), if v.smtputf8 { "true".to_string() } else { "false".to_string() }));
    let mut parts: Vec[String] = Vec.new();
    for (k, val) in members.iter() {
        parts.push(f"  \"{k}\": {val}");
    }
    let text = f"{{\n{join_strs(parts, ",\n")}\n}}";
    let mut lines: Vec[String] = Vec.new();
    for l in text.split("\n") {
        lines.push(l.to_string());
    }
    lines
}

// ------------------------------------------------------------ the jobs

fn opts_of(j: ref J) -> (Options, String) {
    let mut o = default_options();
    let mut shown: Vec[String] = Vec.new();
    if let J.O(members) = j {
        for (k, v) in members.iter() {
            let b = match v {
                J.B(b) => *b,
                _ => false,
            };
            match v {
                J.B(b) => shown.push(f"{k}={py_bool(*b)}"),
                J.N(n) => shown.push(f"{k}={n}"),
                _ => {}
            }
            if k == "allow_smtputf8" {
                o.allow_smtputf8 = b;
            } else if k == "allow_empty_local" {
                o.allow_empty_local = b;
            } else if k == "allow_quoted_local" {
                o.allow_quoted_local = b;
            } else if k == "allow_domain_literal" {
                o.allow_domain_literal = b;
            } else if k == "allow_display_name" {
                o.allow_display_name = b;
            } else if k == "check_deliverability" {
                o.check_deliverability = b;
            } else if k == "test_environment" {
                o.test_environment = b;
            } else if k == "globally_deliverable" {
                o.globally_deliverable = b;
            } else if k == "timeout" {
                if let J.N(n) = v {
                    o.timeout = Some(dec_parse(n));
                }
            }
        }
    }
    o.resolver = o.check_deliverability;
    let text = if shown.len() == 0 { "(defaults)".to_string() } else { join_strs(shown, ", ") };
    (o, text)
}

fn unhex_cps(s: ref String) -> Vec[i64] {
    let b: Vec[char] = s.chars().collect();
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push(hex_parse(f"{b[i]}{b[i + 1]}") as i64);
        i += 2;
    }
    out
}

fn op_validate(op: ref J, last: mut ref String, dns: ref Dns, t: ref Tables) {
    let (o, text) = opts_of(j_get(op, "opts"));
    if *last != text {
        println(f"-- opts: {text}");
        *last = text;
    }
    let (email, raw) = if j_present(op, "bytes") {
        let b = unhex_cps(j_str(op, "bytes"));
        println(t.bytes_repr(b));
        (Vec.new(), Some(b))
    } else {
        let e = cps_of(j_str(op, "email"));
        println(t.repr(e));
        (e, None)
    };
    match validate_email(email, raw, o, dns, t) {
        Ok(v) => println(f"  => {compact(v, t)}"),
        Err(e) => println(f"  {failure(e)}"),
    }
}

fn op_show(op: ref J, dns: ref Dns, t: ref Tables) {
    let (o, text) = opts_of(j_get(op, "opts"));
    let email = cps_of(j_str(op, "email"));
    println(f"show {t.repr(email)} with {text}");
    match validate_email(email, None, o, dns, t) {
        Ok(v) => println(as_constructor(v, t)),
        Err(e) => println(failure(e)),
    }
}

fn list_repr(items: ref Vec[String], t: ref Tables) -> String {
    let mut parts: Vec[String] = Vec.new();
    for s in items.iter() {
        parts.push(t.repr(cps_of(s)));
    }
    f"[{join_strs(parts, ", ")}]"
}

// python -m email_validator, with main(dns_resolver=...)
fn op_cli(op: ref J, dns: ref Dns, t: ref Tables) {
    let args = j_strs(op, "args");
    let stdin = j_strs(op, "stdin");
    let env = j_get(op, "env");
    let mut env_parts: Vec[String] = Vec.new();
    let mut o = default_options();
    o.resolver = true;
    if let J.O(ref members) = env {
        for (k, v) in members.iter() {
            if let J.S(s) = v {
                env_parts.push(f"{t.repr(cps_of(k))}: {t.repr(cps_of(s))}");
            }
        }
    }
    println(f"$ args {list_repr(args, t)} env {{{join_strs(env_parts, ", ")}}} stdin {list_repr(stdin, t)}");
    // bool(os.environ[varname]) for the six names main reads
    for name in ["ALLOW_SMTPUTF8", "ALLOW_QUOTED_LOCAL", "ALLOW_DOMAIN_LITERAL", "GLOBALLY_DELIVERABLE", "CHECK_DELIVERABILITY", "TEST_ENVIRONMENT"] {
        if j_present(env, name) {
            let b = j_str(env, name).len() > 0;
            if name == "ALLOW_SMTPUTF8" {
                o.allow_smtputf8 = b;
            } else if name == "ALLOW_QUOTED_LOCAL" {
                o.allow_quoted_local = b;
            } else if name == "ALLOW_DOMAIN_LITERAL" {
                o.allow_domain_literal = b;
            } else if name == "GLOBALLY_DELIVERABLE" {
                o.globally_deliverable = b;
            } else if name == "CHECK_DELIVERABILITY" {
                o.check_deliverability = b;
            } else {
                o.test_environment = b;
            }
        }
    }
    if j_present(env, "DEFAULT_TIMEOUT") {
        o.unknown_keyword = "default_timeout".to_string();
    }
    if args.len() == 0 {
        for line in stdin.iter() {
            let email = strip_space(cps_of(line));
            match validate_email(email, None, o, dns, t) {
                Ok(_) => {}
                Err(e) => {
                    if e.kind == "EmailSyntaxError" or e.kind == "EmailUndeliverableError" {
                        println(f"| {cps_str(email)} {e.msg}");
                    } else {
                        println(failure(e));
                        return;
                    }
                }
            }
        }
    } else {
        match validate_email(cps_of(args[0]), None, o, dns, t) {
            Ok(v) => {
                for l in as_dict_json(v).iter() {
                    println(f"| {l}");
                }
            }
            Err(e) => {
                if e.kind == "EmailSyntaxError" or e.kind == "EmailUndeliverableError" {
                    println(f"| {e.msg}");
                } else {
                    println(failure(e));
                }
            }
        }
    }
}

// ------------------------------------------------------------ the sign-up log

struct Account {
    name: String,
    v: Validated,
}

fn form_options(form: Str) -> Options {
    let mut o = default_options();
    if form == "mime" {
        o.allow_display_name = true;
    } else if form == "legacy" {
        o.allow_quoted_local = true;
        o.allow_domain_literal = true;
        o.globally_deliverable = false;
        o.check_deliverability = false;
    }
    o.resolver = o.check_deliverability;
    o
}

fn pad_right(s: Str, n: i64) -> String {
    let mut out = s.to_string();
    let mut k = s.chars().count();
    while k < n {
        out.push(' ');
        k += 1;
    }
    out
}

fn op_signups(text: ref String, dns: ref Dns, t: ref Tables) {
    let mut accounts: Vec[Account] = Vec.new();
    let mut unknown = 0;
    for line in text.lines() {
        if line.len() == 0 or line.starts_with("#") {
            continue;
        }
        let f: Vec[Str] = line.split("\t").collect();
        let when = f[0];
        let form = f[1];
        let name = f[2];
        let addr = cps_of(f[3]);
        let head = f"{when} {pad_right(form, 6)} {t.repr(addr)}";
        let v = match validate_email(addr, None, form_options(form), dns, t) {
            Ok(v) => v,
            Err(e) => {
                if e.kind == "EmailUndeliverableError" {
                    println(f"{head}: undeliverable: {e.msg}");
                } else {
                    println(f"{head}: invalid: {e.msg}");
                }
                continue;
            }
        };
        let mut dup = -1;
        for i in 0..accounts.len() {
            if cps_eq(accounts[i].v.normalized, v.normalized) {
                dup = i;
            }
        }
        if dup >= 0 {
            println(f"{head}: duplicate of #{dup + 1} ({accounts[dup].name})");
            continue;
        }
        let n = accounts.len() + 1;
        let who = if name.len() > 0 {
            name.to_string()
        } else {
            match v.display_name.clone() {
                Some(dn) => if dn.len() > 0 { cps_str(dn) } else { cps_str(v.local_part) },
                None => cps_str(v.local_part),
            }
        };
        let mut out = f"{head}: #{n} {t.repr(v.normalized)} name={t.repr(cps_of(who))}";
        let has_mx = match v.mx.clone() {
            Some(mx) => mx.len() > 0,
            None => false,
        };
        if has_mx {
            let mx = v.mx.clone().unwrap();
            let (_, host) = mx[0].clone();
            out.push_str(f" via {host}");
            if let Some(fb) = v.mx_fallback_type.clone() {
                out.push_str(f" ({fb} fallback)");
            }
        } else if v.has_fallback {
            out.push_str(" deliverability unknown");
            unknown += 1;
        } else {
            out.push_str(" not checked");
        }
        if v.smtputf8 {
            out.push_str(" needs SMTPUTF8");
        } else {
            let a = v.ascii_email.clone().unwrap();
            if not cps_eq(a, v.normalized) {
                out.push_str(f" ascii={t.repr(a)}");
            }
        }
        println(out);
        accounts.push(Account { name: who, v: v });
    }
    let mut needing = 0;
    for a in accounts.iter() {
        if a.v.smtputf8 {
            needing += 1;
        }
    }
    println(f"accounts: {accounts.len()}, needing SMTPUTF8: {needing}, deliverability unknown: {unknown}");
    let mut domains: Vec[String] = Vec.new();
    for a in accounts.iter() {
        let d = cps_str(a.v.domain);
        let mut seen = false;
        for x in domains.iter() {
            if *x == d {
                seen = true;
            }
        }
        if not seen {
            domains.push(d);
        }
    }
    domains.sort();
    for d in domains.iter() {
        let mut locals: Vec[String] = Vec.new();
        for a in accounts.iter() {
            if cps_str(a.v.domain) == *d {
                locals.push(cps_str(a.v.local_part));
            }
        }
        locals.sort();
        println(f"  {d}: {join_strs(locals, ", ")}");
    }
}

// ------------------------------------------------------------ main

fn read_data(path: Str) -> Result[String, String] {
    match fs.read_to_string(path.to_string()) {
        Ok(s) => Ok(s),
        Err(e) => Err(f"{path}: {e}"),
    }
}

fn run() -> Result[(), String] {
    let t = load_tables(read_data("data/unicode.txt")?, read_data("data/uts46.txt")?, read_data("data/idnadata.txt")?);
    let dns = load_dns(read_data("data/dns.tsv")?);
    let signups = read_data("data/signups.tsv")?;
    let jobs = read_data("data/jobs.jsonl")?;
    for line in jobs.lines() {
        if line.len() == 0 {
            continue;
        }
        let j = json_line(line.to_string())?;
        println(f"== {j_str(j, "name")}");
        let mut last = String.new();
        if let J.A(ops) = j_get(j, "ops") {
            for op in ops.iter() {
                let kind = j_str(op, "op");
                if kind == "validate" {
                    op_validate(op, mut last, dns, t);
                } else {
                    last = String.new();
                    if kind == "show" {
                        op_show(op, dns, t);
                    } else if kind == "cli" {
                        op_cli(op, dns, t);
                    } else if kind == "signups" {
                        op_signups(signups, dns, t);
                    }
                }
            }
        }
    }
    Ok(())
}

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    if let Err(e) = run() {
        eprintln(e);
    }
}


// ------------------------------------------------------------ data

// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    data_part_3(mut v);
    data_part_4(mut v);
    v
}

