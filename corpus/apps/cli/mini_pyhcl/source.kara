    t.push_str("identifier1 = identifier2 ? identifier3 : element(identifier4, identifier5)\n");
    t.push_str("// objectitem : objectkey EQUAL objectkey QMARK number COLON objectkey\n");
    t.push_str("identifier1 = identifier2 ? 1 : identifier3\n");
    t.push_str("// objectitem : objectkey EQUAL objectkey QMARK BOOL COLON objectkey\n");
    t.push_str("identifier1 = identifier2 ? True : identifier3\n");
    t.push_str("// objectitem : objectkey EQUAL objectkey QMARK function COLON objectkey\n");
    t.push_str("identifier1 = identifier2 ? element(identifier3, identifier4) : identifier5\n");
    t.push_str("// objectitem : objectkey EQUAL objectkey QMARK number COLON number\n");
    t.push_str("identifier1 = identifier2 ? 1 : 2\n");
    t.push_str("// objectitem : objectkey EQUAL objectkey QMARK number COLON BOOL\n");
    t.push_str("identifier1 = identifier2 ? 1 : True\n");
    t.push_str("// objectitem : objectkey EQUAL objectkey QMARK number COLON function\n");
    t.push_str("identifier1 = identifier2 ? 1 : element(identifier3, identifier4)\n");
    t.push_str("// objectitem : objectkey EQUAL objectkey QMARK BOOL COLON number\n");
    t.push_str("identifier1 = identifier2 ? True : 1\n");
    t.push_str("// objectitem : objectkey EQUAL objectkey QMARK BOOL COLON function\n");
    t.push_str("identifier1 = identifier2 ? True : element(identifier3, identifier4)\n");
    t.push_str("// objectitem : objectkey EQUAL objectkey QMARK BOOL COLON BOOL\n");
    t.push_str("identifier1 = identifier2 ? True : False\n");
    t.push_str("\n");
    t.push_str("// objectitem : objectkey EQUAL booleanexp QMARK objectkey COLON objectkey\n");
    t.push_str("identifier1 = identifier2 == identifier3 ? identifier4 : identifier5\n");
    t.push_str("// objectitem : objectkey EQUAL booleanexp QMARK objectkey COLON number\n");
    t.push_str("identifier1 = identifier2 == identifier3 ? identifier4 : 1\n");
    t.push_str("// objectitem : objectkey EQUAL booleanexp QMARK objectkey COLON BOOL\n");
    t.push_str("identifier1 = identifier2 == identifier3 ? identifier4 : True\n");
    t.push_str("// objectitem : objectkey EQUAL booleanexp QMARK objectkey COLON function\n");
    t.push_str("identifier1 = identifier2 == identifier3 ? identifier4 : element(identifier5, identifier6)\n");
    t.push_str("// objectitem : objectkey EQUAL booleanexp QMARK number COLON objectkey\n");
    t.push_str("identifier1 = identifier2 == identifier3 ? 1 : identifier4\n");
    t.push_str("// objectitem : objectkey EQUAL booleanexp QMARK BOOL COLON objectkey\n");
    t.push_str("identifier1 = identifier2 == identifier3 ? True : identifier4\n");
    t.push_str("// objectitem : objectkey EQUAL booleanexp QMARK function COLON objectkey\n");
    t.push_str("identifier1 = identifier2 == identifier3 ? element(identifier4, identifier5) : identifier6\n");
    t.push_str("// objectitem : objectkey EQUAL booleanexp QMARK number COLON number\n");
    t.push_str("identifier1 = identifier2 == identifier3 ? 1 : 2\n");
    t.push_str("// objectitem : objectkey EQUAL booleanexp QMARK number COLON BOOL\n");
    t.push_str("identifier1 = identifier2 == identifier3 ? 1 : True\n");
    t.push_str("// objectitem : objectkey EQUAL booleanexp QMARK number COLON function\n");
    t.push_str("identifier1 = identifier2 == identifier3 ? 1 : element(identifier4, identifier5)\n");
    t.push_str("// objectitem : objectkey EQUAL booleanexp QMARK BOOL COLON number\n");
    t.push_str("identifier1 = identifier2 == identifier3 ? True : 1\n");
    t.push_str("// objectitem : objectkey EQUAL booleanexp QMARK BOOL COLON function\n");
    t.push_str("identifier1 = identifier2 == identifier3 ? True : element(identifier4, identifier5)\n");
    t.push_str("// objectitem : objectkey EQUAL booleanexp QMARK BOOL COLON BOOL\n");
    t.push_str("identifier1 = identifier2 == identifier3 ? True : False");
}

