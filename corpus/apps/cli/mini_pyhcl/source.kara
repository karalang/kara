    t.push_str("      resources {\n");
    t.push_str("        cpu    = 1000\n");
    t.push_str("        memory = 512\n");
    t.push_str("      }\n");
    t.push_str("    }\n");
    t.push_str("  }\n");
    t.push_str("}\n");
}

fn file_infra_packer_base_pkr_hcl_0(t: mut ref String) {
    t.push_str("variable \"aws_region\" {\n");
    t.push_str("  type    = \"string\"\n");
    t.push_str("  default = \"eu-west-1\"\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("source \"amazon-ebs\" \"base\" {\n");
    t.push_str("  region        = \"${var.aws_region}\"\n");
    t.push_str("  instance_type = \"t3.micro\"\n");
    t.push_str("  ssh_username  = \"ubuntu\"\n");
    t.push_str("  ami_name      = \"shop-base-{{timestamp}}\"\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("build {\n");
    t.push_str("  sources = [\"source.amazon-ebs.base\"]\n");
    t.push_str("\n");
    t.push_str("  provisioner \"shell\" {\n");
    t.push_str("    inline = [\n");
    t.push_str("      \"sudo apt-get update\",\n");
    t.push_str("      \"sudo apt-get install -y unattended-upgrades\",\n");
    t.push_str("    ]\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  provisioner \"file\" {\n");
    t.push_str("    source      = \"files/motd\"\n");
    t.push_str("    destination = \"/tmp/motd\"\n");
    t.push_str("  }\n");
    t.push_str("}\n");
}

fn file_infra_terraform_main_tf_0(t: mut ref String) {
    t.push_str("# The shop's web tier: instances behind a load balancer, one database.\n");
    t.push_str("terraform {\n");
    t.push_str("  required_version = \">= 0.11.0\"\n");
    t.push_str("  backend \"s3\" {\n");
    t.push_str("    bucket = \"shop-terraform-state\"\n");
    t.push_str("    key    = \"web/terraform.tfstate\"\n");
    t.push_str("    region = \"eu-west-1\"\n");
    t.push_str("  }\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("provider \"aws\" {\n");
    t.push_str("  region  = \"${var.region}\"\n");
    t.push_str("  version = \"~> 2.70\"\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("provider \"aws\" {\n");
    t.push_str("  alias  = \"us\"\n");
    t.push_str("  region = \"us-east-1\"\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("data \"aws_ami\" \"ubuntu\" {\n");
    t.push_str("  most_recent = true\n");
    t.push_str("  owners      = [\"099720109477\"]\n");
    t.push_str("\n");
    t.push_str("  filter {\n");
    t.push_str("    name   = \"name\"\n");
    t.push_str("    values = [\"ubuntu/images/hvm-ssd/ubuntu-focal-20.04-amd64-server-*\"]\n");
    t.push_str("  }\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("resource \"aws_instance\" \"web\" {\n");
    t.push_str("  count         = \"${var.instance_count}\"\n");
    t.push_str("  ami           = \"${data.aws_ami.ubuntu.id}\"\n");
    t.push_str("  instance_type = \"${var.instance_type}\"\n");
    t.push_str("  subnet_id     = \"${element(module.vpc.public_subnets, count.index)}\"\n");
    t.push_str("\n");
    t.push_str("  root_block_device {\n");
    t.push_str("    volume_size = 20\n");
    t.push_str("    volume_type = \"gp2\"\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  tags = \"${merge(var.tags, map(\"Name\", \"web-${count.index + 1}\"))}\"\n");
    t.push_str("\n");
    t.push_str("  user_data = <<EOF\n");
    t.push_str("#!/bin/sh\n");
    t.push_str("apt-get update\n");
    t.push_str("apt-get install -y nginx\n");
    t.push_str("echo \"web ${count.index}\" > /var/www/html/index.html\n");
    t.push_str("EOF\n");
    t.push_str("\n");
    t.push_str("  lifecycle {\n");
    t.push_str("    create_before_destroy = true\n");
    t.push_str("  }\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("resource \"aws_lb\" \"web\" {\n");
    t.push_str("  name               = \"shop-web\"\n");
    t.push_str("  load_balancer_type = \"application\"\n");
    t.push_str("  subnets            = [\"${module.vpc.public_subnets}\"]\n");
    t.push_str("  idle_timeout       = 60\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("resource \"aws_lb_target_group\" \"web\" {\n");
    t.push_str("  name     = \"shop-web\"\n");
    t.push_str("  port     = 80\n");
    t.push_str("  protocol = \"HTTP\"\n");
    t.push_str("  vpc_id   = \"${module.vpc.vpc_id}\"\n");
    t.push_str("\n");
    t.push_str("  health_check {\n");
    t.push_str("    path                = \"/healthz\"\n");
    t.push_str("    interval            = 15\n");
    t.push_str("    healthy_threshold   = 2\n");
    t.push_str("    unhealthy_threshold = 3\n");
    t.push_str("  }\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("resource \"aws_security_group\" \"web\" {\n");
    t.push_str("  name = \"shop-web\"\n");
    t.push_str("\n");
    t.push_str("  ingress {\n");
    t.push_str("    from_port   = 443\n");
    t.push_str("    to_port     = 443\n");
    t.push_str("    protocol    = \"tcp\"\n");
    t.push_str("    cidr_blocks = [\"0.0.0.0/0\"]\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  ingress {\n");
    t.push_str("    from_port   = 80\n");
    t.push_str("    to_port     = 80\n");
    t.push_str("    protocol    = \"tcp\"\n");
    t.push_str("    cidr_blocks = [\"0.0.0.0/0\"]\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  egress {\n");
    t.push_str("    from_port   = 0\n");
    t.push_str("    to_port     = 0\n");
    t.push_str("    protocol    = \"-1\"\n");
    t.push_str("    cidr_blocks = [\"0.0.0.0/0\"]\n");
    t.push_str("  }\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("resource \"aws_db_instance\" \"orders\" {\n");
    t.push_str("  allocated_storage       = 50\n");
    t.push_str("  engine                  = \"postgres\"\n");
    t.push_str("  engine_version          = \"11.9\"\n");
    t.push_str("  instance_class          = \"db.t3.medium\"\n");
    t.push_str("  name                    = \"orders\"\n");
    t.push_str("  username                = \"shop\"\n");
    t.push_str("  password                = \"${var.db_password}\"\n");
    t.push_str("  backup_retention_period = 7\n");
    t.push_str("  multi_az                = false\n");
    t.push_str("  max_allocated_storage   = 50 * 4\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("module \"vpc\" {\n");
    t.push_str("  source = \"terraform-aws-modules/vpc/aws\"\n");
    t.push_str("  version = \"2.78.0\"\n");
    t.push_str("  name   = \"shop\"\n");
    t.push_str("  cidr   = \"10.0.0.0/16\"\n");
    t.push_str("  azs    = [\"eu-west-1a\", \"eu-west-1b\"]\n");
    t.push_str("  public_subnets = [\"10.0.1.0/24\", \"10.0.2.0/24\"]\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("module \"dns\" {\n");
    t.push_str("  source = \"./modules/dns\"\n");
    t.push_str("  zone   = \"shop.example\"\n");
    t.push_str("}\n");
}

fn file_infra_terraform_main_tf_json_0(t: mut ref String) {
    t.push_str("{\n");
    t.push_str("  \"resource\": {\n");
    t.push_str("    \"aws_s3_bucket\": {\n");
    t.push_str("      \"assets\": {\n");
    t.push_str("        \"bucket\": \"shop-assets\",\n");
    t.push_str("        \"acl\": \"private\",\n");
    t.push_str("        \"versioning\": {\"enabled\": true},\n");
    t.push_str("        \"lifecycle_rule\": [\n");
    t.push_str("          {\"id\": \"old\", \"enabled\": true, \"expiration\": {\"days\": 90}}\n");
    t.push_str("        ]\n");
    t.push_str("      }\n");
    t.push_str("    }\n");
    t.push_str("  },\n");
    t.push_str("  \"output\": {\n");
    t.push_str("    \"assets_bucket\": {\"value\": \"${aws_s3_bucket.assets.id}\"}\n");
    t.push_str("  },\n");
    t.push_str("  \"variable\": {\n");
    t.push_str("    \"cdn_ttl\": {\"default\": 3600.5, \"description\": \"seconds \\u00e0 la carte\"}\n");
    t.push_str("  }\n");
    t.push_str("}\n");
}

fn file_infra_terraform_outputs_tf_0(t: mut ref String) {
    t.push_str("output \"lb_dns_name\" {\n");
    t.push_str("  value = \"${aws_lb.web.dns_name}\"\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("output \"instance_ips\" {\n");
    t.push_str("  value     = [\"${aws_instance.web.*.private_ip}\"]\n");
    t.push_str("  sensitive = false\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("output \"db_endpoint\" {\n");
    t.push_str("  value       = \"${aws_db_instance.orders.endpoint}\"\n");
    t.push_str("  description = \"where the order service connects\"\n");
    t.push_str("  sensitive   = true\n");
    t.push_str("}\n");
}

fn file_infra_terraform_variables_tf_0(t: mut ref String) {
    t.push_str("variable \"region\" {\n");
    t.push_str("  description = \"AWS region for every resource\"\n");
    t.push_str("  default     = \"eu-west-1\"\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("variable \"instance_count\" {\n");
    t.push_str("  default = 3\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("variable \"instance_type\" {\n");
    t.push_str("  type    = \"string\"\n");
    t.push_str("  default = \"t3.small\"\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("variable \"allowed_cidrs\" {\n");
    t.push_str("  type    = \"list\"\n");
    t.push_str("  default = [\"10.0.0.0/16\", \"192.168.10.0/24\"]\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("variable \"tags\" {\n");
    t.push_str("  type = \"map\"\n");
    t.push_str("  default = {\n");
    t.push_str("    team    = \"platform\"\n");
    t.push_str("    billing = \"shop-42\"\n");
    t.push_str("  }\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("variable \"db_password\" {\n");
    t.push_str("  description = \"set from the CI secret store\"\n");
    t.push_str("}\n");
}

fn file_infra_vault_admin_hcl_0(t: mut ref String) {
    t.push_str("# Operators manage everything but the root token.\n");
    t.push_str("path \"sys/*\" {\n");
    t.push_str("  capabilities = [\"create\", \"read\", \"update\", \"delete\", \"list\", \"sudo\"]\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("path \"auth/token/root\" {\n");
    t.push_str("  capabilities = [\"deny\"]\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("path \"secret/*\" {\n");
    t.push_str("  capabilities = [\"create\", \"read\", \"update\", \"delete\", \"list\"]\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("path \"secret/data/payments/*\" {\n");
    t.push_str("  capabilities = [\"read\", \"list\"]\n");
    t.push_str("}\n");
}

fn file_infra_vault_ci_hcl_0(t: mut ref String) {
    t.push_str("// The CI runners read deploy keys and nothing else.\n");
    t.push_str("path \"secret/data/ci/*\" {\n");
    t.push_str("  capabilities = [\"read\"]\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("path \"secret/metadata/ci/*\" {\n");
    t.push_str("  capabilities = [\"list\"]\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("path \"secret/data/ci/prod-signing\" {\n");
    t.push_str("  capabilities = [\"deny\"]\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("path \"auth/token/renew-self\" {\n");
    t.push_str("  capabilities = [\"update\"]\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("path \"transit/encrypt/ci\" {\n");
    t.push_str("  capabilities = [\"update\"]\n");
    t.push_str("}\n");
}

