fn lex_tables_part_0(t: mut ref String) {
    t.push_str("S\tINITIAL\t40\t \\t\\r\\x0c\\x0b\tt_error\t-\n");
    t.push_str("X\t(?P<t_BOOL>(true)|(false))|(?P<t_EMINUS>(?<=\\d|\\.)[eE]-)|(?P<t_EPLUS>(?<=\\d)[eE]\\+?|(?<=\\d\\.)[eE]\\+?)|(?P<t_FLOAT>-?((\\d+\\.\\d*)|(\\d*\\.\\d+)))|(?P<t_hexnumber>-?0[xX][0-9a-fA-F]+)|(?P<t_intnumber>-?\\d+)|(?P<t_PERIOD>\\.)|(?P<t_COMMA>,)|(?P<t_QMARK>\\?)|(?P<t_COLON>:)|(?P<t_ASTERISK_PERIOD>\\*\\.)|(?P<t_GT>(?<!>)>(?!>|=))|(?P<t_LT>(?<!<)<(?!<|=))|(?P<t_EQ>==)|(?P<t_NE>!=)|(?P<t_LE><=)|(?P<t_GE>>=)|(?P<t_IDENTIFIER>[^\\W\\d][\\w.-]*)|(?P<t_string>\\\")|(?P<t_tabbedheredoc><<-\\S+\\r?\\n)|(?P<t_heredoc><<\\S+\\r?\\n)|(?P<t_COMMENT>(\\#|(//)).*)|(?P<t_MULTICOMMENT>/\\*(.|\\n)*?(\\*/))|(?P<t_newline>\\n+)|(?P<t_EQUAL>(?<!=)=(?!=))|(?P<t_ADD>\\+)|(?P<t_LEFTBRACE>\\{)|(?P<t_LEFTBRACKET>\\[)|(?P<t_LEFTPAREN>\\()|(?P<t_MULTIPLY>\\*)|(?P<t_RIGHTBRACE>\\})|(?P<t_RIGHTBRACKET>\\])|(?P<t_RIGHTPAREN>\\))|(?P<t_DIVIDE>/)|(?P<t_MINUS>-)\n");
    t.push_str("I\t1\tt_BOOL\tBOOL\n");
    t.push_str("I\t4\tt_EMINUS\tEMINUS\n");
    t.push_str("I\t5\tt_EPLUS\tEPLUS\n");
    t.push_str("I\t6\tt_FLOAT\tFLOAT\n");
    t.push_str("I\t10\tt_hexnumber\thexnumber\n");
    t.push_str("I\t11\tt_intnumber\tintnumber\n");
    t.push_str("I\t12\tt_PERIOD\tPERIOD\n");
    t.push_str("I\t13\tt_COMMA\tCOMMA\n");
    t.push_str("I\t14\tt_QMARK\tQMARK\n");
    t.push_str("I\t15\tt_COLON\tCOLON\n");
    t.push_str("I\t16\tt_ASTERISK_PERIOD\tASTERISK_PERIOD\n");
    t.push_str("I\t17\tt_GT\tGT\n");
    t.push_str("I\t18\tt_LT\tLT\n");
    t.push_str("I\t19\tt_EQ\tEQ\n");
    t.push_str("I\t20\tt_NE\tNE\n");
    t.push_str("I\t21\tt_LE\tLE\n");
    t.push_str("I\t22\tt_GE\tGE\n");
    t.push_str("I\t23\tt_IDENTIFIER\tIDENTIFIER\n");
    t.push_str("I\t24\tt_string\tstring\n");
    t.push_str("I\t25\tt_tabbedheredoc\ttabbedheredoc\n");
    t.push_str("I\t26\tt_heredoc\theredoc\n");
    t.push_str("I\t27\tt_COMMENT\tCOMMENT\n");
    t.push_str("I\t30\tt_MULTICOMMENT\tMULTICOMMENT\n");
    t.push_str("I\t33\tt_newline\tnewline\n");
    t.push_str("I\t34\t-\tEQUAL\n");
    t.push_str("I\t35\t-\tADD\n");
    t.push_str("I\t36\t-\tLEFTBRACE\n");
    t.push_str("I\t37\t-\tLEFTBRACKET\n");
    t.push_str("I\t38\t-\tLEFTPAREN\n");
    t.push_str("I\t39\t-\tMULTIPLY\n");
    t.push_str("I\t40\t-\tRIGHTBRACE\n");
    t.push_str("I\t41\t-\tRIGHTBRACKET\n");
    t.push_str("I\t42\t-\tRIGHTPAREN\n");
    t.push_str("I\t43\t-\tDIVIDE\n");
    t.push_str("I\t44\t-\tMINUS\n");
    t.push_str("S\tstringdollar\t40\t\t-\tt_stringdollar_eof\n");
    t.push_str("X\t(?P<t_stringdollar_dontcare>[^\\{\\}])|(?P<t_stringdollar_lbrace>\\{)|(?P<t_stringdollar_rbrace>\\})\n");
    t.push_str("I\t1\tt_stringdollar_dontcare\tdontcare\n");
    t.push_str("I\t2\tt_stringdollar_lbrace\tlbrace\n");
    t.push_str("I\t3\tt_stringdollar_rbrace\trbrace\n");
    t.push_str("S\tstring\t40\t\t-\tt_string_eof\n");
    t.push_str("X\t(?P<t_string_escapedchar>(?<=\\\\)(\\\"|\\\\))|(?P<t_string_stringdollar>(?<=\\$)\\{)|(?P<t_string_ignoring>[^\\\"])|(?P<t_string_STRING>\\\")\n");
    t.push_str("I\t1\tt_string_escapedchar\tescapedchar\n");
    t.push_str("I\t3\tt_string_stringdollar\tstringdollar\n");
    t.push_str("I\t4\tt_string_ignoring\tignoring\n");
    t.push_str("I\t5\tt_string_STRING\tSTRING\n");
    t.push_str("S\theredoc\t40\t\t-\tt_heredoc_eof\n");
    t.push_str("X\t(?P<t_heredoc_STRING>^.+?(?=\\r?$))|(?P<t_heredoc_ignoring>.+|\\n)\n");
    t.push_str("I\t1\tt_heredoc_STRING\tSTRING\n");
    t.push_str("I\t2\tt_heredoc_ignoring\tignoring\n");
    t.push_str("S\ttabbedheredoc\t40\t\t-\tt_heredoc_eof\n");
    t.push_str("X\t(?P<t_tabbedheredoc_STRING>^\\t*.+?(?=\\r?$))|(?P<t_tabbedheredoc_ignoring>.+|\\n)\n");
    t.push_str("I\t1\tt_tabbedheredoc_STRING\tSTRING\n");
    t.push_str("I\t2\tt_heredoc_ignoring\tignoring\n");
}

fn parse_tables_part_0(t: mut ref String) {
    t.push_str("P S' 1 - top\n");
    t.push_str("P top 1 p_top empty\n");
    t.push_str("P top 1 p_top objectlist\n");
    t.push_str("P empty 0 p_empty_0\n");
    t.push_str("P objectlist 1 p_objectlist_0 objectitem\n");
    t.push_str("P objectlist 2 p_objectlist_1 objectlist objectitem\n");
    t.push_str("P objectlist 3 p_objectlist_2 objectlist COMMA objectitem\n");
    t.push_str("P object 3 p_object_0 LEFTBRACE objectlist RIGHTBRACE\n");
    t.push_str("P object 4 p_object_1 LEFTBRACE objectlist COMMA RIGHTBRACE\n");
    t.push_str("P object 2 p_object_2 LEFTBRACE RIGHTBRACE\n");
    t.push_str("P objectkey 1 p_objectkey_0 IDENTIFIER\n");
    t.push_str("P objectkey 1 p_objectkey_0 STRING\n");
    t.push_str("P objectkey 3 p_objectkey_1 IDENTIFIER ADD number\n");
    t.push_str("P objectkey 3 p_objectkey_1 number ADD IDENTIFIER\n");
    t.push_str("P objectkey 3 p_objectkey_1 IDENTIFIER MINUS number\n");
    t.push_str("P objectkey 3 p_objectkey_1 number MINUS IDENTIFIER\n");
    t.push_str("P objectkey 3 p_objectkey_1 IDENTIFIER MULTIPLY number\n");
    t.push_str("P objectkey 3 p_objectkey_1 number MULTIPLY IDENTIFIER\n");
    t.push_str("P objectkey 3 p_objectkey_1 IDENTIFIER DIVIDE number\n");
    t.push_str("P objectkey 3 p_objectkey_1 number DIVIDE IDENTIFIER\n");
    t.push_str("P objectbrackets 4 p_objectbrackets_0 IDENTIFIER LEFTBRACKET objectkey RIGHTBRACKET\n");
    t.push_str("P objectbrackets 6 p_objectbrackets_1 IDENTIFIER LEFTBRACKET objectkey RIGHTBRACKET PERIOD IDENTIFIER\n");
    t.push_str("P objectbrackets 6 p_objectbrackets_1 IDENTIFIER LEFTBRACKET NUMBER RIGHTBRACKET PERIOD IDENTIFIER\n");
    t.push_str("P objectitem 3 p_objectitem_0 objectkey EQUAL number\n");
    t.push_str("P objectitem 3 p_objectitem_0 objectkey EQUAL BOOL\n");
    t.push_str("P objectitem 3 p_objectitem_0 objectkey EQUAL STRING\n");
    t.push_str("P objectitem 3 p_objectitem_0 objectkey EQUAL IDENTIFIER\n");
