// mini_pyhcl: pyhcl 0.4.5, the HCL parser hcltool runs (its PLY lexer and
// LALR parser, and the json module for the files that are JSON), over a
// small infrastructure repository: Terraform, Vault policies, a Nomad job,
// a Consul agent and Packer, plus pyhcl's own test fixtures. See README.md.

// ------------------------------------------------------------ errors

struct ReErr {
    kind: String,
    msg: String,
    pos: i64,
}

fn re_error(msg: own String, pos: i64) -> ReErr {
    ReErr { kind: "error".to_string(), msg: msg, pos: pos }
}

fn other_error(kind: Str, msg: own String) -> ReErr {
    ReErr { kind: kind.to_string(), msg: msg, pos: -1 }
}

fn err_text(e: ref ReErr) -> String {
    if e.kind == "error" {
        if e.pos >= 0 {
            return f"error: {e.msg} at position {e.pos}";
        }
        return f"error: {e.msg}";
    }
    f"{e.kind}: {e.msg}"
}

// -------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for cp in s {
        if cp < 0x80 {
            out.push(cp as u8);
        } else if cp < 0x800 {
            out.push((0xC0 | (cp >> 6)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else if cp < 0x10000 {
            out.push((0xE0 | (cp >> 12)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (cp >> 18)) as u8);
            out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

// s[start:end], clamped to the string the way Python clamps a slice
fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = if start < 0 { 0 } else { start };
    let stop = if end > s.len() { s.len() } else { end };
    while i < stop {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

fn str_repr(s: ref Vec[i64], out: mut ref Vec[i64]) {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
}

fn repr_of(s: ref Vec[i64]) -> String {
    let mut out: Vec[i64] = Vec.new();
    str_repr(s, mut out);
    to_string(out)
}

// ----------------------------------------------------- character kinds

fn is_decimal(c: i64) -> bool {
    if c < 0x80 {
        return c >= 48 and c <= 57;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return true;
        }
    }
    false
}

fn is_space(c: i64, ascii: bool) -> bool {
    if c == 32 or (c >= 9 and c <= 13) {
        return true;
    }
    if ascii {
        return false;
    }
    (c >= 0x1C and c <= 0x1F) or c == 0x85 or c == 0xA0 or c == 0x1680 or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F or c == 0x3000
}

fn as_char(c: i64) -> Option[char] {
    if c < 0 or (c >= 0xD800 and c <= 0xDFFF) or c > 0x10FFFF {
        return None;
    }
    char.try_from(c as u32).ok()
}

fn is_word(c: i64, ascii: bool) -> bool {
    if c < 0x80 {
        return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
    }
    if ascii {
        return false;
    }
    match as_char(c) {
        Some(ch) => ch.is_alphanumeric(),
        None => false,
    }
}

fn lower(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 65 and c <= 90 { c + 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_lowercase() as u32 as i64,
        None => c,
    }
}

fn upper(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 97 and c <= 122 { c - 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_uppercase() as u32 as i64,
        None => c,
    }
}

// ------------------------------------------------------- parsed form

// The categories of \d \D \s \S \w \W.
fn cat_digit() -> i64 { 0 }
fn cat_not_digit() -> i64 { 1 }
fn cat_space() -> i64 { 2 }
fn cat_not_space() -> i64 { 3 }
fn cat_word() -> i64 { 4 }
fn cat_not_word() -> i64 { 5 }

// The positions ^ $ \A \Z \b \B and the forms the compiler turns them
// into under MULTILINE.
fn at_beginning() -> i64 { 0 }
fn at_beginning_line() -> i64 { 1 }
fn at_beginning_string() -> i64 { 2 }
fn at_end() -> i64 { 3 }
fn at_end_line() -> i64 { 4 }
fn at_end_string() -> i64 { 5 }
fn at_boundary() -> i64 { 6 }
fn at_non_boundary() -> i64 { 7 }

#[derive(Clone)]
enum Item {
    Lit(i64),
    Range(i64, i64),
    Cat(i64),
}

enum Node {
    Lit(i64),
    NotLit(i64),
    Any,
    In(Vec[Item], bool),
    At(i64),
    Branch(Vec[Vec[Node]]),
    // group (0: none), flags turned on, flags turned off, contents
    Group(i64, i64, i64, Vec[Node]),
    // 0 greedy, 1 lazy, 2 possessive; min; max; the item repeated
    Repeat(i64, i64, i64, Vec[Node]),
    Atomic(Vec[Node]),
    // direction (1 ahead, -1 behind), negative, contents
    Assert(i64, bool, Vec[Node]),
    GroupRef(i64),
    // group, yes branch, no branch
    Exists(i64, Vec[Node], Vec[Node]),
    Failure,
}

fn is_repeat(n: ref Node) -> bool {
    match n {
        Node.Repeat(_, _, _, _) => true,
        _ => false,
    }
}

fn is_at(n: ref Node) -> bool {
    match n {
        Node.At(_) => true,
        _ => false,
    }
}

fn flag_i() -> i64 { 2 }
fn flag_l() -> i64 { 4 }
fn flag_m() -> i64 { 8 }
fn flag_s() -> i64 { 16 }
fn flag_u() -> i64 { 32 }
fn flag_x() -> i64 { 64 }
fn flag_a() -> i64 { 256 }
fn type_flags() -> i64 { 4 | 32 | 256 }
fn maxrepeat() -> i64 { 4294967295 }
fn maxgroups() -> i64 { 1073741823 }
fn maxwidth() -> i64 { 1 << 62 }

fn flag_value(c: i64) -> i64 {
    match c {
        105 => 2,
        76 => 4,
        109 => 8,
        115 => 16,
        120 => 64,
        97 => 256,
        117 => 32,
        _ => 0,
    }
}

// ------------------------------------------------------------ tokens

// One token: nothing at the end of the pattern (n 0), a character (n 1),
// or a backslash and the character after it (n 2).
#[derive(Copy, Clone)]
struct T {
    n: i64,
    a: i64,
    b: i64,
}

fn tok_none() -> T {
    T { n: 0, a: 0, b: 0 }
}

fn tok_is(t: T, c: i64) -> bool {
    t.n == 1 and t.a == c
}

fn tok_text(t: T) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    if t.n >= 1 {
        v.push(t.a);
    }
    if t.n == 2 {
        v.push(t.b);
    }
    v
}

fn is_ascii_letter(c: i64) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

fn is_hex(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

fn is_oct(c: i64) -> bool {
    c >= 48 and c <= 55
}

fn is_dec(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn digits_value(s: ref Vec[i64], start: i64, base: i64) -> i64 {
    let mut v = 0;
    let mut i = start;
    while i < s.len() {
        let c = s[i];
        let d = if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 };
        v = v * base + d;
        i += 1;
    }
    v
}

// str.isidentifier, near enough: a letter or underscore, then letters,
// digits and underscores.
fn is_identifier(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    let mut i = 0;
    while i < name.len() {
        let c = name[i];
        let ok = if c == 95 {
            true
        } else if i == 0 {
            match as_char(c) {
                Some(ch) => ch.is_alphabetic(),
                None => false,
            }
        } else {
            is_word(c, false)
        };
        if not ok {
            return false;
        }
        i += 1;
    }
    true
}

fn is_ascii_decimal(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    for c in name {
        if not is_dec(c) {
            return false;
        }
    }
    true
}

struct Tokenizer {
    s: Vec[i64],
    index: i64,
    next: T,
}

impl Tokenizer {
    fn advance(mut ref self) -> Result[(), ReErr] {
        let index = self.index;
        if index >= self.s.len() {
            self.next = tok_none();
            return Ok(());
        }
        let c = self.s[index];
        if c == 92 {
            if index + 1 >= self.s.len() {
                return Err(re_error("bad escape (end of pattern)".to_string(), self.s.len() - 1));
            }
            self.next = T { n: 2, a: 92, b: self.s[index + 1] };
            self.index = index + 2;
        } else {
            self.next = T { n: 1, a: c, b: 0 };
            self.index = index + 1;
        }
        Ok(())
    }

    fn get(mut ref self) -> Result[T, ReErr] {
        let t = self.next;
        self.advance()?;
        Ok(t)
    }

    fn take(mut ref self, c: i64) -> Result[bool, ReErr] {
        if tok_is(self.next, c) {
            self.advance()?;
            return Ok(true);
        }
        Ok(false)
    }

    fn tell(ref self) -> i64 {
        self.index - self.next.n
    }

    fn seek(mut ref self, index: i64) -> Result[(), ReErr] {
        self.index = index;
        self.advance()
    }

    fn error(ref self, msg: own String, offset: i64) -> ReErr {
        re_error(msg, self.tell() - offset)
    }

    // getwhile: up to n characters of a kind (0 octal, 1 decimal, 2 hex).
    fn getwhile(mut ref self, n: i64, kind: i64, out: mut ref Vec[i64]) -> Result[(), ReErr] {
        let mut k = 0;
        while k < n {
            let t = self.next;
            if t.n != 1 {
                break;
            }
            let ok = if kind == 0 { is_oct(t.a) } else if kind == 1 { is_dec(t.a) } else { is_hex(t.a) };
            if not ok {
                break;
            }
            out.push(t.a);
            self.advance()?;
            k += 1;
        }
        Ok(())
    }

    fn getuntil(mut ref self, terminator: i64, name: Str) -> Result[Vec[i64], ReErr] {
        let mut result: Vec[i64] = Vec.new();
        loop {
            let c = self.next;
            self.advance()?;
            if c.n == 0 {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 0));
                }
                let term = to_string(vec_of(terminator));
                return Err(self.error(f"missing {term}, unterminated name", result.len()));
            }
            if tok_is(c, terminator) {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 1));
                }
                break;
            }
            push_all(mut result, tok_text(c));
        }
        Ok(result)
    }

    fn checkgroupname(ref self, name: ref Vec[i64], offset: i64) -> Result[(), ReErr] {
        if not is_identifier(name) {
            return Err(self.error(f"bad character in group name {repr_of(name)}", name.len() + offset));
        }
        Ok(())
    }
}

fn vec_of(c: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(c);
    v
}

fn new_tokenizer(s: ref Vec[i64]) -> Result[Tokenizer, ReErr] {
    let mut t = Tokenizer { s: s.clone(), index: 0, next: tok_none() };
    t.advance()?;
    Ok(t)
}

// ------------------------------------------------------------ parser

#[derive(Clone)]
struct Width {
    lo: i64,
    hi: i64,
}

struct ParseState {
    flags: i64,
    names: Vec[(Vec[i64], i64)],
    // per group: whether it is closed, and its width
    closed: Vec[bool],
    widths: Vec[Width],
    lookbehind_groups: i64,
    // conditional references by number, in order: (group, position)
    refpos: Vec[(i64, i64)],
}

impl ParseState {
    fn groups(ref self) -> i64 {
        self.closed.len()
    }

    fn group_of(ref self, name: ref Vec[i64]) -> i64 {
        for (n, g) in self.names.iter() {
            if same(n, name) {
                return *g;
            }
        }
        -1
    }

    fn checkgroup(ref self, gid: i64) -> bool {
        gid < self.groups() and self.closed[gid]
    }

    fn checklookbehindgroup(ref self, gid: i64, src: ref Tokenizer) -> Result[(), ReErr] {
        if self.lookbehind_groups >= 0 {
            if not self.checkgroup(gid) {
                return Err(src.error("cannot refer to an open group".to_string(), 0));
            }
            if gid >= self.lookbehind_groups {
                return Err(src.error("cannot refer to group defined in the same lookbehind subpattern".to_string(), 0));
            }
        }
        Ok(())
    }
}

fn add_width(a: i64, b: i64) -> i64 {
    if a >= maxwidth() - b { maxwidth() } else { a + b }
}

fn mul_width(a: i64, n: i64) -> i64 {
    if a == 0 or n == 0 {
        0
    } else if a >= maxwidth() / n {
        maxwidth()
    } else {
        a * n
    }
}

// SubPattern.getwidth.
fn width_of(widths: ref Vec[Width], p: ref Vec[Node]) -> Width {
    let mut lo = 0;
    let mut hi = 0;
    for n in p.iter() {
        match n {
            Node.Branch(items) => {
                let mut i = maxwidth();
                let mut j = 0;
                for item in items.iter() {
                    let w = width_of(widths, item);
                    if w.lo < i {
                        i = w.lo;
                    }
                    if w.hi > j {
                        j = w.hi;
                    }
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Atomic(body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Group(_, _, _, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Repeat(_, min, max, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, mul_width(w.lo, *min));
                if *max == maxrepeat() and w.hi > 0 {
                    hi = maxwidth();
                } else {
                    hi = add_width(hi, mul_width(w.hi, *max));
                }
            }
            Node.GroupRef(g) => {
                let w = ref widths[*g];
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Exists(_, yes, no) => {
                let wy = width_of(widths, yes);
                let mut i = wy.lo;
                let mut j = wy.hi;
                if no.len() > 0 {
                    let wn = width_of(widths, no);
                    if wn.lo < i {
                        i = wn.lo;
                    }
                    if wn.hi > j {
                        j = wn.hi;
                    }
                } else {
                    i = 0;
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Lit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.NotLit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.Any => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.In(_, _) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            _ => {}
        }
    }
    Width { lo: lo, hi: hi }
}

fn category_of(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        100 => 0,
        68 => 1,
        115 => 2,
        83 => 3,
        119 => 4,
        87 => 5,
        _ => -1,
    }
}

fn escape_value(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        97 => 7,
        98 => 8,
        102 => 12,
        110 => 10,
        114 => 13,
        116 => 9,
        118 => 11,
        92 => 92,
        _ => -1,
    }
}

// \x, \u and \U: the escape text so far, and the code point.
fn hex_escape(src: mut ref Tokenizer, t: T, esc: mut ref Vec[i64]) -> Result[i64, ReErr] {
    let n = if t.b == 120 { 2 } else if t.b == 117 { 4 } else { 8 };
    src.getwhile(n, 2, mut esc)?;
    if esc.len() != n + 2 {
        return Err(src.error(f"incomplete escape {to_string(esc)}", esc.len()));
    }
    let c = digits_value(esc, 2, 16);
    if c > 0x10FFFF {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(c)
}

// _class_escape: an escape inside [...], a literal or a category.
fn class_escape(src: mut ref Tokenizer, t: T) -> Result[Item, ReErr] {
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Item.Lit(e));
    }
    let cat = category_of(t);
    if cat >= 0 {
        return Ok(Item.Cat(cat));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Item.Lit(v));
    }
    if is_oct(c) {
        src.getwhile(2, 0, mut esc)?;
        let v = digits_value(esc, 1, 8);
        if v > 0o377 {
            return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
        }
        return Ok(Item.Lit(v));
    }
    if is_dec(c) or is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Item.Lit(c))
}

// _escape: an escape outside a set.
fn escape(src: mut ref Tokenizer, t: T, st: ref ParseState) -> Result[Node, ReErr] {
    let cat = category_of(t);
    if cat >= 0 {
        let mut items: Vec[Item] = Vec.new();
        items.push(Item.Cat(cat));
        return Ok(Node.In(items, false));
    }
    match t.b {
        65 => return Ok(Node.At(at_beginning_string())),
        98 => return Ok(Node.At(at_boundary())),
        66 => return Ok(Node.At(at_non_boundary())),
        90 => return Ok(Node.At(at_end_string())),
        _ => {}
    }
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Node.Lit(e));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Node.Lit(v));
    }
    if c == 48 {
        src.getwhile(2, 0, mut esc)?;
        return Ok(Node.Lit(digits_value(esc, 1, 8)));
    }
    if is_dec(c) {
        // an octal escape or a group reference
        let nt = src.next;
        if nt.n == 1 and is_dec(nt.a) {
            esc.push(nt.a);
            src.advance()?;
            let nt2 = src.next;
            if is_oct(esc[1]) and is_oct(esc[2]) and nt2.n == 1 and is_oct(nt2.a) {
                esc.push(nt2.a);
                src.advance()?;
                let v = digits_value(esc, 1, 8);
                if v > 0o377 {
                    return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
                }
                return Ok(Node.Lit(v));
            }
        }
        let group = digits_value(esc, 1, 10);
        if group < st.groups() {
            if not st.checkgroup(group) {
                return Err(src.error("cannot refer to an open group".to_string(), esc.len()));
            }
            st.checklookbehindgroup(group, src)?;
            return Ok(Node.GroupRef(group));
        }
        return Err(src.error(f"invalid group reference {group}", esc.len() - 1));
    }
    if is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Node.Lit(c))
}

fn parse_sub(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64) -> Result[Vec[Node], ReErr] {
    let mut items: Vec[Vec[Node]] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let first = nested == 0 and items.len() == 0;
        let item = parse_seq(mut src, mut st, verbose, nested + 1, first)?;
        items.push(item);
        if not src.take(124)? {
            break;
        }
        if nested == 0 {
            verbose = (st.flags & flag_x()) != 0;
        }
    }
    if items.len() == 1 {
        return Ok(items.pop().unwrap());
    }
    let mut out: Vec[Node] = Vec.new();
    out.push(Node.Branch(items));
    Ok(out)
}

// _parse_flags: None (as Err-free Ok(None)) for global flags, else the
// flags turned on and off.
fn parse_flags(src: mut ref Tokenizer, st: mut ref ParseState, first_char: T) -> Result[Option[(i64, i64)], ReErr] {
    let mut ch = first_char;
    let mut add = 0;
    let mut del = 0;
    if not tok_is(ch, 45) {
        loop {
            let flag = flag_value(ch.a);
            if ch.a == 76 {
                return Err(src.error("bad inline flags: cannot use 'L' flag with a str pattern".to_string(), 0));
            }
            add = add | flag;
            if (flag & type_flags()) != 0 and (add & type_flags()) != flag {
                return Err(src.error("bad inline flags: flags 'a', 'u' and 'L' are incompatible".to_string(), 0));
            }
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing -, : or )".to_string(), 0));
            }
            if tok_is(ch, 41) or tok_is(ch, 45) or tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing -, : or )" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if tok_is(ch, 41) {
        st.flags = st.flags | add;
        return Ok(None);
    }
    if tok_is(ch, 45) {
        ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("missing flag".to_string(), 0));
        }
        if ch.n != 1 or flag_value(ch.a) == 0 {
            let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing flag" };
            return Err(src.error(msg.to_string(), ch.n));
        }
        loop {
            let flag = flag_value(ch.a);
            if (flag & type_flags()) != 0 {
                return Err(src.error("bad inline flags: cannot turn off flags 'a', 'u' and 'L'".to_string(), 0));
            }
            del = del | flag;
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing :".to_string(), 0));
            }
            if tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing :" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if (add & del) != 0 {
        return Err(src.error("bad inline flags: flag turned on and off".to_string(), 1));
    }
    Ok(Some((add, del)))
}

fn is_alpha(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

fn parse_set(src: mut ref Tokenizer, out: mut ref Vec[Node]) -> Result[(), ReErr] {
    let here = src.tell() - 1;
    let mut set: Vec[Item] = Vec.new();
    let negate = src.take(94)?;
    loop {
        let this = src.get()?;
        if this.n == 0 {
            return Err(src.error("unterminated character set".to_string(), src.tell() - here));
        }
        if tok_is(this, 93) and set.len() > 0 {
            break;
        }
        let code1 = if this.n == 2 { class_escape(mut src, this)? } else { Item.Lit(this.a) };
        if src.take(45)? {
            let that = src.get()?;
            if that.n == 0 {
                return Err(src.error("unterminated character set".to_string(), src.tell() - here));
            }
            if tok_is(that, 93) {
                set.push(code1);
                set.push(Item.Lit(45));
                break;
            }
            let code2 = if that.n == 2 { class_escape(mut src, that)? } else { Item.Lit(that.a) };
            let text = f"{to_string(tok_text(this))}-{to_string(tok_text(that))}";
            let offset = this.n + 1 + that.n;
            let lo = match code1 {
                Item.Lit(c) => c,
                _ => -1,
            };
            let hi = match code2 {
                Item.Lit(c) => c,
                _ => -1,
            };
            if lo < 0 or hi < 0 or hi < lo {
                return Err(src.error(f"bad character range {text}", offset));
            }
            set.push(Item.Range(lo, hi));
        } else {
            set.push(code1);
        }
    }
    if set.len() == 1 {
        let only = ref set[0];
        if let Item.Lit(c) = only {
            if negate {
                out.push(Node.NotLit(*c));
            } else {
                out.push(Node.Lit(*c));
            }
            return Ok(());
        }
    }
    out.push(Node.In(set, negate));
    Ok(())
}

// The quantifier just read (its first character is `this`), applied to
// the last item. Returns false when `{` turned out to be a literal.
fn parse_repeat(src: mut ref Tokenizer, this: T, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let here = src.tell();
    let mut min = 0;
    let mut max = maxrepeat();
    if tok_is(this, 63) {
        max = 1;
    } else if tok_is(this, 43) {
        min = 1;
    } else if tok_is(this, 123) {
        if tok_is(src.next, 125) {
            out.push(Node.Lit(123));
            return Ok(false);
        }
        let mut lo: Vec[i64] = Vec.new();
        let mut hi: Vec[i64] = Vec.new();
        while src.next.n == 1 and is_dec(src.next.a) {
            lo.push(src.get()?.a);
        }
        if src.take(44)? {
            while src.next.n == 1 and is_dec(src.next.a) {
                hi.push(src.get()?.a);
            }
        } else {
            hi = lo.clone();
        }
        if not src.take(125)? {
            out.push(Node.Lit(123));
            src.seek(here)?;
            return Ok(false);
        }
        if lo.len() > 0 {
            if lo.len() > 10 or digits_value(lo, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            min = digits_value(lo, 0, 10);
        }
        if hi.len() > 0 {
            if hi.len() > 10 or digits_value(hi, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            max = digits_value(hi, 0, 10);
            if max < min {
                return Err(src.error("min repeat greater than max repeat".to_string(), src.tell() - here));
            }
        }
    }
    if out.len() == 0 or is_at(out[out.len() - 1]) {
        return Err(src.error("nothing to repeat".to_string(), src.tell() - here + 1));
    }
    if is_repeat(out[out.len() - 1]) {
        return Err(src.error("multiple repeat".to_string(), src.tell() - here + 1));
    }
    let last = out.pop().unwrap();
    let mut body: Vec[Node] = Vec.new();
    match last {
        Node.Group(0, 0, 0, p) => body = p,
        other => body.push(other),
    }
    let kind = if src.take(63)? { 1 } else if src.take(43)? { 2 } else { 0 };
    out.push(Node.Repeat(kind, min, max, body));
    Ok(true)
}

fn parse_seq(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64, first: bool) -> Result[Vec[Node], ReErr] {
    let mut out: Vec[Node] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let this = src.next;
        if this.n == 0 or tok_is(this, 124) or tok_is(this, 41) {
            break;
        }
        src.advance()?;
        if verbose {
            if this.n == 1 and (this.a == 32 or (this.a >= 9 and this.a <= 13)) {
                continue;
            }
            if tok_is(this, 35) {
                loop {
                    let t = src.get()?;
                    if t.n == 0 or tok_is(t, 10) {
                        break;
                    }
                }
                continue;
            }
        }
        if this.n == 2 {
            let node = escape(mut src, this, st)?;
            out.push(node);
            continue;
        }
        let c = this.a;
        if c == 91 {
            parse_set(mut src, mut out)?;
        } else if c == 42 or c == 43 or c == 63 or c == 123 {
            parse_repeat(mut src, this, mut out)?;
        } else if c == 46 {
            out.push(Node.Any);
        } else if c == 94 {
            out.push(Node.At(at_beginning()));
        } else if c == 36 {
            out.push(Node.At(at_end()));
        } else if c == 40 {
            if parse_group(mut src, mut st, mut verbose, nested, first, mut out)? {
                continue;
            }
        } else {
            out.push(Node.Lit(c));
        }
    }
    Ok(out)
}

// `(` and what follows. Returns true for a construct that adds nothing
// (a comment, global flags).
fn parse_group(src: mut ref Tokenizer, st: mut ref ParseState, verbose: mut ref bool, nested: i64, first: bool, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let start = src.tell() - 1;
    let mut capture = true;
    let mut atomic = false;
    let mut name: Vec[i64] = Vec.new();
    let mut named = false;
    let mut add = 0;
    let mut del = 0;
    if src.take(63)? {
        let ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("unexpected end of pattern".to_string(), 0));
        }
        if tok_is(ch, 80) {
            if src.take(60)? {
                name = src.getuntil(62, "group name")?;
                src.checkgroupname(name, 1)?;
                named = true;
            } else if src.take(61)? {
                let ref_name = src.getuntil(41, "group name")?;
                src.checkgroupname(ref_name, 1)?;
                let gid = st.group_of(ref_name);
                if gid < 0 {
                    return Err(src.error(f"unknown group name {repr_of(ref_name)}", ref_name.len() + 1));
                }
                if not st.checkgroup(gid) {
                    return Err(src.error("cannot refer to an open group".to_string(), ref_name.len() + 1));
                }
                st.checklookbehindgroup(gid, src)?;
                out.push(Node.GroupRef(gid));
                return Ok(true);
            } else {
                let c2 = src.get()?;
                if c2.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                return Err(src.error(f"unknown extension ?P{to_string(tok_text(c2))}", c2.n + 2));
            }
        } else if tok_is(ch, 58) {
            capture = false;
        } else if tok_is(ch, 35) {
            loop {
                if src.next.n == 0 {
                    return Err(src.error("missing ), unterminated comment".to_string(), src.tell() - start));
                }
                if tok_is(src.get()?, 41) {
                    break;
                }
            }
            return Ok(true);
        } else if tok_is(ch, 61) or tok_is(ch, 33) or tok_is(ch, 60) {
            let mut kind = ch;
            let mut dir = 1;
            let mut outer_lookbehind = 0;
            if tok_is(ch, 60) {
                kind = src.get()?;
                if kind.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                if not (tok_is(kind, 61) or tok_is(kind, 33)) {
                    return Err(src.error(f"unknown extension ?<{to_string(tok_text(kind))}", kind.n + 2));
                }
                dir = -1;
                outer_lookbehind = st.lookbehind_groups;
                if outer_lookbehind < 0 {
                    st.lookbehind_groups = st.groups();
                }
            }
            let p = parse_sub(mut src, mut st, *verbose, nested + 1)?;
            if dir < 0 and outer_lookbehind < 0 {
                st.lookbehind_groups = -1;
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            if tok_is(kind, 61) {
                out.push(Node.Assert(dir, false, p));
            } else if p.len() > 0 {
                out.push(Node.Assert(dir, true, p));
            } else {
                out.push(Node.Failure);
            }
            return Ok(true);
        } else if tok_is(ch, 40) {
            let condname = src.getuntil(41, "group name")?;
            let mut condgroup = 0;
            if not is_ascii_decimal(condname) {
                src.checkgroupname(condname, 1)?;
                condgroup = st.group_of(condname);
                if condgroup < 0 {
                    return Err(src.error(f"unknown group name {repr_of(condname)}", condname.len() + 1));
                }
            } else {
                if condname.len() > 10 {
                    return Err(src.error(f"invalid group reference {to_string(condname)}", condname.len() + 1));
                }
                condgroup = digits_value(condname, 0, 10);
                if condgroup == 0 {
                    return Err(src.error("bad group number".to_string(), condname.len() + 1));
                }
                if condgroup >= maxgroups() {
                    return Err(src.error(f"invalid group reference {condgroup}", condname.len() + 1));
                }
                let mut seen = false;
                for (g, _) in st.refpos.iter() {
                    if *g == condgroup {
                        seen = true;
                    }
                }
                if not seen {
                    st.refpos.push((condgroup, src.tell() - condname.len() - 1));
                }
            }
            st.checklookbehindgroup(condgroup, src)?;
            let yes = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
            let mut no: Vec[Node] = Vec.new();
            if src.take(124)? {
                no = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
                if tok_is(src.next, 124) {
                    return Err(src.error("conditional backref with more than two branches".to_string(), 0));
                }
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            out.push(Node.Exists(condgroup, yes, no));
            return Ok(true);
        } else if tok_is(ch, 62) {
            capture = false;
            atomic = true;
        } else if (ch.n == 1 and flag_value(ch.a) != 0) or tok_is(ch, 45) {
            match parse_flags(mut src, mut st, ch)? {
                None => {
                    if not first or out.len() > 0 {
                        return Err(src.error("global flags not at the start of the expression".to_string(), src.tell() - start));
                    }
                    *verbose = (st.flags & flag_x()) != 0;
                    return Ok(true);
                }
                Some((a, d)) => {
                    add = a;
                    del = d;
                    capture = false;
                }
            }
        } else {
            return Err(src.error(f"unknown extension ?{to_string(tok_text(ch))}", ch.n + 1));
        }
    }
    let mut group = 0;
    if capture {
        group = st.groups();
        st.closed.push(false);
        st.widths.push(Width { lo: 0, hi: 0 });
        if named {
            let was = st.group_of(name);
            if was >= 0 {
                return Err(src.error(f"redefinition of group name {repr_of(name)} as group {group}; was group {was}", name.len() + 1));
            }
            st.names.push((name.clone(), group));
        }
    }
    let sub_verbose = (*verbose or (add & flag_x()) != 0) and (del & flag_x()) == 0;
    let p = parse_sub(mut src, mut st, sub_verbose, nested + 1)?;
    if not src.take(41)? {
        return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
    }
    if group > 0 {
        let w = width_of(st.widths, p);
        st.widths[group] = w;
        st.closed[group] = true;
    }
    if atomic {
        out.push(Node.Atomic(p));
    } else {
        out.push(Node.Group(group, add, del, p));
    }
    Ok(false)
}

struct Parsed {
    nodes: Vec[Node],
    flags: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
    widths: Vec[Width],
}

fn parse(pattern: ref Vec[i64], flags: i64) -> Result[Parsed, ReErr] {
    let mut src = new_tokenizer(pattern)?;
    let mut st = ParseState {
        flags: flags,
        names: Vec.new(),
        closed: Vec.new(),
        widths: Vec.new(),
        lookbehind_groups: -1,
        refpos: Vec.new(),
    };
    // group 0 is the whole match
    st.closed.push(true);
    st.widths.push(Width { lo: 0, hi: 0 });
    let nodes = parse_sub(mut src, mut st, (flags & flag_x()) != 0, 0)?;
    if (st.flags & flag_a()) != 0 and (st.flags & flag_u()) != 0 {
        return Err(other_error("ValueError", "ASCII and UNICODE flags are incompatible".to_string()));
    }
    if src.next.n != 0 {
        return Err(src.error("unbalanced parenthesis".to_string(), 0));
    }
    for (g, pos) in st.refpos.iter() {
        if *g >= st.groups() {
            return Err(re_error(f"invalid group reference {*g}", *pos));
        }
    }
    let groups = st.groups() - 1;
    Ok(Parsed { nodes: nodes, flags: st.flags, groups: groups, names: st.names, widths: st.widths })
}

// ---------------------------------------------------------- compiler

enum Op {
    // character (lowered when case-insensitive), case-insensitive, ASCII
    Lit(i64, bool, bool),
    NotLit(i64, bool, bool),
    Any,
    AnyAll,
    // set, case-insensitive, ASCII-only categories
    In(i64, bool, bool),
    // anchor kind, ASCII-only word boundary
    At(i64, bool),
    Mark(i64),
    Split(i64, i64),
    Jmp(i64),
    // repeat register, the Until it starts at
    RepInit(i64, i64),
    // register, min, max, greedy, body, exit
    Until(i64, i64, i64, bool, i64, i64),
    Ref(i64, bool, bool),
    // lookbehind width (-1 for lookahead), negative, sub-program, next
    Look(i64, bool, i64, i64),
    Atomic(i64, i64),
    Exists(i64, i64),
    Fail,
    Succeed,
    Match,
}

#[derive(Clone)]
struct Program {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
    // a literal every match contains, lowered (see required_runs)
    // the subject (lowered) can only match if it holds one of these
    // (no strings: no such test)
    needs: Vec[Vec[i64]],
    // the characters a match can start with, lowered; empty for any
    firsts: Vec[i64],
    // for each ASCII character, whether its lowered form is in firsts
    first_tab: Vec[bool],
}

struct CharSet {
    items: Vec[Item],
    negate: bool,
}

fn combine(flags: i64, add: i64, del: i64) -> i64 {
    let mut f = flags;
    if (add & type_flags()) != 0 {
        f = f & (0x7FFFFFFF ^ type_flags());
    }
    (f | add) & (0x7FFFFFFF ^ del)
}

struct Compiler {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
}

impl Compiler {
    fn emit(mut ref self, op: own Op) -> i64 {
        self.ops.push(op);
        self.ops.len() - 1
    }

    fn here(ref self) -> i64 {
        self.ops.len()
    }

    fn compile(mut ref self, p: ref Parsed, nodes: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let icase = (flags & flag_i()) != 0;
        let ascii = (flags & flag_a()) != 0;
        for n in nodes.iter() {
            match n {
                Node.Lit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.Lit(v, icase, ascii));
                }
                Node.NotLit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.NotLit(v, icase, ascii));
                }
                Node.Any => {
                    if (flags & flag_s()) != 0 {
                        self.emit(Op.AnyAll);
                    } else {
                        self.emit(Op.Any);
                    }
                }
                Node.In(items, negate) => {
                    self.sets.push(CharSet { items: items.clone(), negate: *negate });
                    let idx = self.sets.len() - 1;
                    self.emit(Op.In(idx, icase, ascii));
                }
                Node.At(kind) => {
                    let mut k = *kind;
                    if (flags & flag_m()) != 0 {
                        if k == at_beginning() {
                            k = at_beginning_line();
                        } else if k == at_end() {
                            k = at_end_line();
                        }
                    }
                    self.emit(Op.At(k, ascii));
                }
                Node.Branch(items) => {
                    let mut ends: Vec[i64] = Vec.new();
                    let mut i = 0;
                    while i < items.len() {
                        if i + 1 < items.len() {
                            let split = self.emit(Op.Fail);
                            self.compile(p, items[i], flags)?;
                            ends.push(self.emit(Op.Fail));
                            let next = self.here();
                            self.ops[split] = Op.Split(split + 1, next);
                        } else {
                            self.compile(p, items[i], flags)?;
                        }
                        i += 1;
                    }
                    let end = self.here();
                    for at in ends {
                        self.ops[at] = Op.Jmp(end);
                    }
                }
                Node.Group(g, add, off, body) => {
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g));
                    }
                    self.compile(p, body, combine(flags, *add, *off))?;
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g + 1));
                    }
                }
                Node.Repeat(kind, min, max, body) => {
                    if *kind == 2 {
                        let at = self.emit(Op.Fail);
                        self.compile_repeat(p, *min, *max, true, body, flags)?;
                        self.emit(Op.Succeed);
                        let next = self.here();
                        self.ops[at] = Op.Atomic(at + 1, next);
                    } else {
                        self.compile_repeat(p, *min, *max, *kind == 0, body, flags)?;
                    }
                }
                Node.Atomic(body) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Atomic(at + 1, next);
                }
                Node.Assert(dir, negative, body) => {
                    let mut width = -1;
                    if *dir < 0 {
                        let w = width_of(p.widths, body);
                        if w.lo != w.hi {
                            return Err(other_error("error", "look-behind requires fixed-width pattern".to_string()));
                        }
                        width = w.lo;
                    }
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Look(width, *negative, at + 1, next);
                }
                Node.GroupRef(g) => {
                    self.emit(Op.Ref(*g, icase, ascii));
                }
                Node.Exists(g, yes, no) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, yes, flags)?;
                    if no.len() > 0 {
                        let jump = self.emit(Op.Fail);
                        let no_pc = self.here();
                        self.compile(p, no, flags)?;
                        let end = self.here();
                        self.ops[jump] = Op.Jmp(end);
                        self.ops[at] = Op.Exists(*g, no_pc);
                    } else {
                        let end = self.here();
                        self.ops[at] = Op.Exists(*g, end);
                    }
                }
                Node.Failure => {
                    self.emit(Op.Fail);
                }
            }
        }
        Ok(())
    }

    fn compile_repeat(mut ref self, p: ref Parsed, min: i64, max: i64, greedy: bool, body: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let r = self.repeats;
        self.repeats += 1;
        let init = self.emit(Op.Fail);
        self.compile(p, body, flags)?;
        let until = self.emit(Op.Fail);
        self.ops[init] = Op.RepInit(r, until);
        self.ops[until] = Op.Until(r, min, max, greedy, init + 1, until + 1);
        Ok(())
    }
}

fn compile(pattern: ref Vec[i64], flags: i64) -> Result[Program, ReErr] {
    let p = parse(pattern, flags)?;
    let mut c = Compiler { ops: Vec.new(), sets: Vec.new(), repeats: 0 };
    c.compile(p, p.nodes, p.flags)?;
    c.emit(Op.Match);
    let needs = need_set(p.nodes);
    let firsts = first_set(p.nodes, 0, (p.flags & flag_i()) != 0).unwrap_or(Vec.new());
    let mut first_tab: Vec[bool] = Vec.new();
    let mut ch = 0;
    while ch < 128 {
        first_tab.push(in_firsts(firsts, lower(ch, false)));
        ch += 1;
    }
    Ok(Program { ops: c.ops, sets: c.sets, repeats: c.repeats, groups: p.groups, names: p.names, needs: needs, firsts: firsts, first_tab: first_tab })
}

// The characters a match can start with, lowered, when the pattern
// opens with literals or a set of them (sre's INFO charset): None when
// it can start with anything, or with nothing.
fn first_set(nodes: ref Vec[Node], from: i64, icase: bool) -> Option[Vec[i64]] {
    let mut i = from;
    while i < nodes.len() {
        match nodes[i] {
            Node.At(_) => {}
            Node.Assert(_, _, _) => {}
            Node.Lit(c) => return Some(vec![lower(c, false)]),
            Node.In(items, negate) => {
                if negate or icase {
                    return None;
                }
                let mut out: Vec[i64] = Vec.new();
                for it in items.iter() {
                    match it {
                        Item.Lit(c) => out.push(lower(c, false)),
                        _ => return None,
                    }
                }
                return Some(out);
            }
            Node.Group(_, on, _, inner) => {
                return first_set(inner, 0, icase or (on & flag_i()) != 0);
            }
            Node.Repeat(_, min, _, inner) => {
                if min < 1 {
                    return None;
                }
                return first_set(inner, 0, icase);
            }
            Node.Branch(alts) => {
                let mut out: Vec[i64] = Vec.new();
                for alt in alts.iter() {
                    let f = first_set(alt, 0, icase)?;
                    for c in f {
                        out.push(c);
                    }
                }
                return Some(out);
            }
            _ => return None,
        }
        i += 1;
    }
    None
}

// Runs of literal characters every match must contain, lowered (so a
// test against the lowered subject is necessary whatever the flags):
// a search can skip a subject that lacks the longest of them.
fn required_runs(nodes: ref Vec[Node], runs: mut ref Vec[Vec[i64]], cur: mut ref Vec[i64]) {
    for n in nodes.iter() {
        match n {
            Node.Lit(c) => cur.push(lower(c, false)),
            Node.In(items, false) => match one_char(items) {
                Some(c) => cur.push(c),
                None => {
                    runs.push(cur.clone());
                    cur.clear();
                }
            },
            Node.Group(_, _, _, inner) => required_runs(inner, mut runs, mut cur),
            Node.At(_) => {}
            Node.Assert(_, _, _) => {}
            Node.Repeat(_, min, _, inner) => {
                runs.push(cur.clone());
                cur.clear();
                if min >= 1 {
                    required_runs(inner, mut runs, mut cur);
                    runs.push(cur.clone());
                    cur.clear();
                }
            }
            _ => {
                runs.push(cur.clone());
                cur.clear();
            }
        }
    }
}

// A set like [Ss] whose members all lower to one character.
fn one_char(items: ref Vec[Item]) -> Option[i64] {
    let mut c = -1;
    for it in items.iter() {
        match it {
            Item.Lit(x) => {
                let l = lower(x, false);
                if c >= 0 and l != c {
                    return None;
                }
                c = l;
            }
            _ => return None,
        }
    }
    if c >= 0 { Some(c) } else { None }
}

// The longest run of characters every match holds.
fn longest_run(nodes: ref Vec[Node]) -> Vec[i64] {
    let mut runs: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    required_runs(nodes, mut runs, mut cur);
    runs.push(cur);
    let mut need: Vec[i64] = Vec.new();
    for r in runs {
        if r.len() > need.len() {
            need = r.clone();
        }
    }
    need
}

fn shortest(set: ref Vec[Vec[i64]]) -> i64 {
    let mut n = -1;
    for r in set.iter() {
        if n < 0 or r.len() < n {
            n = r.len();
        }
    }
    n
}

// Strings one of which every match holds (lowered): the longest
// required run, or, when an alternation every match passes through gives
// longer ones, one run for each of its branches. Empty when there is
// nothing to test.
fn need_set(nodes: ref Vec[Node]) -> Vec[Vec[i64]] {
    let mut best: Vec[Vec[i64]] = Vec.new();
    let run = longest_run(nodes);
    if run.len() > 0 {
        best.push(run);
    }
    for n in nodes.iter() {
        let cand = match n {
            Node.Group(_, _, _, inner) => need_set(inner),
            Node.Atomic(inner) => need_set(inner),
            Node.Repeat(_, min, _, inner) => if min >= 1 { need_set(inner) } else { Vec.new() },
            Node.Branch(alts) => {
                let mut set: Vec[Vec[i64]] = Vec.new();
                let mut ok = true;
                for a in alts.iter() {
                    let sub = need_set(a);
                    if sub.len() == 0 {
                        ok = false;
                        break;
                    }
                    for r in sub.iter() {
                        set.push(r.clone());
                    }
                }
                if ok { set } else { Vec.new() }
            }
            _ => Vec.new(),
        };
        if cand.len() > 0 and (best.len() == 0 or shortest(cand) > shortest(best)) {
            best = cand;
        }
    }
    best
}

// ----------------------------------------------------------- matcher

struct Undo {
    kind: i64,
    idx: i64,
    old: i64,
}

struct Choice {
    pc: i64,
    pos: i64,
    trail: i64,
    // 0: resume at pc; 1: a lazy repeat's Until, after its tail failed
    mode: i64,
}

struct Matcher {
    s: Vec[i64],
    marks: Vec[i64],
    counts: Vec[i64],
    lasts: Vec[i64],
    lastindex: i64,
    trail: Vec[Undo],
    start: i64,
    must_advance: bool,
    match_all: bool,
}

impl Matcher {
    fn set_mark(mut ref self, slot: i64, v: i64) {
        self.trail.push(Undo { kind: 0, idx: slot, old: self.marks[slot] });
        self.marks[slot] = v;
    }

    fn set_count(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 1, idx: r, old: self.counts[r] });
        self.counts[r] = v;
    }

    fn set_last(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 2, idx: r, old: self.lasts[r] });
        self.lasts[r] = v;
    }

    fn set_lastindex(mut ref self, v: i64) {
        self.trail.push(Undo { kind: 3, idx: 0, old: self.lastindex });
        self.lastindex = v;
    }

    fn undo_to(mut ref self, len: i64) {
        while self.trail.len() > len {
            let u = self.trail.pop().unwrap();
            if u.kind == 0 {
                self.marks[u.idx] = u.old;
            } else if u.kind == 1 {
                self.counts[u.idx] = u.old;
            } else if u.kind == 2 {
                self.lasts[u.idx] = u.old;
            } else {
                self.lastindex = u.old;
            }
        }
    }

    // A group that has both marks, the end not before the start.
    fn group_span(ref self, g: i64) -> (i64, i64) {
        let a = self.marks[2 * g];
        let b = self.marks[2 * g + 1];
        if a < 0 or b < 0 or b < a {
            return (-1, -1);
        }
        (a, b)
    }

    fn at(ref self, kind: i64, ascii: bool, pos: i64) -> bool {
        let n = self.s.len();
        if kind == 0 or kind == 2 {
            return pos == 0;
        }
        if kind == 1 {
            return pos == 0 or self.s[pos - 1] == 10;
        }
        if kind == 3 {
            return pos == n or (pos == n - 1 and self.s[pos] == 10);
        }
        if kind == 4 {
            return pos == n or self.s[pos] == 10;
        }
        if kind == 5 {
            return pos == n;
        }
        if n == 0 {
            return false;
        }
        let before = pos > 0 and is_word(self.s[pos - 1], ascii);
        let after = pos < n and is_word(self.s[pos], ascii);
        if kind == 6 { before != after } else { before == after }
    }

    // Runs the program from pc at pos, backtracking through its own
    // choices only. Returns where it succeeded, or -1.
    fn run(mut ref self, prog: ref Program, pc0: i64, pos0: i64, top: bool) -> i64 {
        let base = self.trail.len();
        let mut choices: Vec[Choice] = Vec.new();
        let mut pc = pc0;
        let mut pos = pos0;
        let mut mode = 0;
        loop {
            let mut ok = true;
            let op = ref prog.ops[pc];
            if mode == 1 {
                // a lazy repeat whose tail failed: try one more item
                mode = 0;
                ok = false;
                if let Op.Until(r, _, max, _, body, _) = op {
                    let count = self.counts[*r] + 1;
                    if not ((count >= *max and *max != maxrepeat()) or pos == self.lasts[*r]) {
                        self.set_count(*r, count);
                        self.set_last(*r, pos);
                        pc = *body;
                        ok = true;
                    }
                }
                if ok {
                    continue;
                }
            } else {
                match op {
                    Op.Lit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) == *c } else { self.s[pos] == *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.NotLit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) != *c } else { self.s[pos] != *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Any => {
                        if pos < self.s.len() and self.s[pos] != 10 {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.AnyAll => {
                        if pos < self.s.len() {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.In(set, icase, ascii) => {
                        if pos < self.s.len() and in_set(prog.sets[*set], self.s[pos], *icase, *ascii) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.At(kind, ascii) => {
                        if self.at(*kind, *ascii, pos) {
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Mark(slot) => {
                        self.set_mark(*slot, pos);
                        if (*slot & 1) == 1 {
                            self.set_lastindex(*slot / 2);
                        }
                        pc += 1;
                    }
                    Op.Split(a, b) => {
                        choices.push(Choice { pc: *b, pos: pos, trail: self.trail.len(), mode: 0 });
                        pc = *a;
                    }
                    Op.Jmp(a) => pc = *a,
                    Op.RepInit(r, until) => {
                        self.set_count(*r, -1);
                        self.set_last(*r, -1);
                        pc = *until;
                    }
                    Op.Until(r, min, max, greedy, body, exit) => {
                        let count = self.counts[*r] + 1;
                        if count < *min {
                            self.set_count(*r, count);
                            pc = *body;
                        } else if *greedy {
                            if (count < *max or *max == maxrepeat()) and pos != self.lasts[*r] {
                                choices.push(Choice { pc: *exit, pos: pos, trail: self.trail.len(), mode: 0 });
                                self.set_count(*r, count);
                                self.set_last(*r, pos);
                                pc = *body;
                            } else {
                                pc = *exit;
                            }
                        } else {
                            choices.push(Choice { pc: pc, pos: pos, trail: self.trail.len(), mode: 1 });
                            pc = *exit;
                        }
                    }
                    Op.Ref(g, icase, ascii) => {
                        let (a, b) = self.group_span(*g);
                        if a < 0 {
                            ok = false;
                        } else {
                            let len = b - a;
                            if pos + len > self.s.len() {
                                ok = false;
                            } else {
                                let mut k = 0;
                                while k < len {
                                    let x = self.s[a + k];
                                    let y = self.s[pos + k];
                                    let eq = if *icase { lower(x, *ascii) == lower(y, *ascii) } else { x == y };
                                    if not eq {
                                        ok = false;
                                        break;
                                    }
                                    k += 1;
                                }
                                if ok {
                                    pos += len;
                                    pc += 1;
                                }
                            }
                        }
                    }
                    Op.Look(width, negative, sub, next) => {
                        let mark = self.trail.len();
                        let from = if *width < 0 { pos } else { pos - *width };
                        let found = from >= 0 and self.run(prog, *sub, from, false) >= 0;
                        if *negative {
                            self.undo_to(mark);
                            if found {
                                ok = false;
                            } else {
                                pc = *next;
                            }
                        } else if found {
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Atomic(sub, next) => {
                        let end = self.run(prog, *sub, pos, false);
                        if end >= 0 {
                            pos = end;
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Exists(g, no) => {
                        let (a, _) = self.group_span(*g);
                        if a >= 0 {
                            pc += 1;
                        } else {
                            pc = *no;
                        }
                    }
                    Op.Fail => ok = false,
                    Op.Succeed => return pos,
                    Op.Match => {
                        if top and ((self.match_all and pos != self.s.len()) or (self.must_advance and pos == self.start)) {
                            ok = false;
                        } else {
                            return pos;
                        }
                    }
                }
            }
            if not ok {
                match choices.pop() {
                    Some(ch) => {
                        self.undo_to(ch.trail);
                        pc = ch.pc;
                        pos = ch.pos;
                        mode = ch.mode;
                    }
                    None => {
                        self.undo_to(base);
                        return -1;
                    }
                }
            }
        }
    }
}

fn in_items(set: ref CharSet, c: i64, ascii: bool) -> bool {
    for item in set.items.iter() {
        let hit = match item {
            Item.Lit(l) => c == *l,
            Item.Range(lo, hi) => c >= *lo and c <= *hi,
            Item.Cat(k) => {
                let kind = *k;
                if kind == 0 {
                    if ascii { c >= 48 and c <= 57 } else { is_decimal(c) }
                } else if kind == 1 {
                    if ascii { not (c >= 48 and c <= 57) } else { not is_decimal(c) }
                } else if kind == 2 {
                    is_space(c, ascii)
                } else if kind == 3 {
                    not is_space(c, ascii)
                } else if kind == 4 {
                    is_word(c, ascii)
                } else {
                    not is_word(c, ascii)
                }
            }
        };
        if hit {
            return true;
        }
    }
    false
}

// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = lower(c, ascii);
        if lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program, s: ref Vec[i64]) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        s: s.clone(),
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// Whether a match can start at c: the first-character prefilter.
fn can_start(prog: ref Program, c: i64) -> bool {
    if c >= 0 and c < 128 {
        return prog.first_tab[c];
    }
    in_firsts(prog.firsts, lower(c, false))
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn find(m: mut ref Matcher, prog: ref Program, from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= m.s.len() {
        if mode == 0 and prog.firsts.len() > 0 {
            while start < m.s.len() and not can_start(prog, m.s[start]) {
                start += 1;
            }
            if start >= m.s.len() {
                return None;
            }
        }
        let mut k = 0;
        while k < m.marks.len() {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}

// All the matches finditer gives: each search starts where the last
// match ended, and must move on past an empty one.
fn all_matches(prog: ref Program, s: ref Vec[i64], limit: i64) -> Vec[Found] {
    let mut m = new_matcher(prog, s);
    let mut out: Vec[Found] = Vec.new();
    let mut pos = 0;
    let mut must_advance = false;
    while pos <= s.len() and (limit == 0 or out.len() < limit) {
        match find(mut m, prog, pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    out
}


enum J {
    Null,
    Bool(bool),
    Int(String),
    Float(f64),
    Str(Vec[i64]),
    Arr(Vec[J]),
    Obj(Vec[Member]),
}

struct Member {
    key: Vec[i64],
    val: J,
}

fn is_surrogate(cp: i64) -> bool {
    cp >= 0xD800 and cp <= 0xDFFF
}

fn hex4(cp: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = 12;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}


fn cmp_cps(a: ref Vec[i64], b: ref Vec[i64]) -> i64 {
    let mut i = 0;
    while i < a.len() and i < b.len() {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 };
        }
        i += 1;
    }
    a.len() - b.len()
}

// ---------------------------------------------------------- decoding

// The C scanner in Modules/_json.c, over code points.
struct Scanner {
    s: Vec[i64],
}

fn is_digit(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn hex_value(c: i64) -> i64 {
    if c >= 48 and c <= 57 {
        c - 48
    } else if c >= 97 and c <= 102 {
        c - 87
    } else if c >= 65 and c <= 70 {
        c - 55
    } else {
        -1
    }
}

impl Scanner {
    fn at(ref self, i: i64) -> i64 {
        if i >= 0 and i < self.s.len() { self.s[i] } else { -1 }
    }

    // JSONDecodeError's message: the line and column are counted from the
    // newlines before the position.
    fn fail(ref self, msg: Str, pos: i64) -> Exc {
        let mut line = 1;
        let mut last = -1;
        let mut i = 0;
        while i < pos {
            if self.s[i] == 10 {
                line += 1;
                last = i;
            }
            i += 1;
        }
        exc("JSONDecodeError", f"{msg}: line {line} column {pos - last} (char {pos})")
    }

    fn skip_ws(ref self, start: i64) -> i64 {
        let mut i = start;
        while i < self.s.len() {
            let c = self.s[i];
            if c != 32 and c != 9 and c != 10 and c != 13 {
                break;
            }
            i += 1;
        }
        i
    }

    fn matches(ref self, i: i64, word: Str) -> bool {
        let w = word.bytes();
        if i + w.len() > self.s.len() {
            return false;
        }
        let mut k = 0;
        while k < w.len() {
            if self.s[i + k] != w[k] as i64 {
                return false;
            }
            k += 1;
        }
        true
    }

    fn scan_once(ref self, idx: i64) -> Result[(J, i64), Exc] {
        let c = self.at(idx);
        if c == 34 {
            let (text, end) = self.scan_string(idx + 1)?;
            return Ok((J.Str(text), end));
        }
        if c == 123 {
            return self.parse_object(idx + 1);
        }
        if c == 91 {
            return self.parse_array(idx + 1);
        }
        if c == 110 and self.matches(idx, "null") {
            return Ok((J.Null, idx + 4));
        }
        if c == 116 and self.matches(idx, "true") {
            return Ok((J.Bool(true), idx + 4));
        }
        if c == 102 and self.matches(idx, "false") {
            return Ok((J.Bool(false), idx + 5));
        }
        if c == 78 and self.matches(idx, "NaN") {
            return Ok((J.Float(0.0 / 0.0), idx + 3));
        }
        if c == 73 and self.matches(idx, "Infinity") {
            return Ok((J.Float(1.0 / 0.0), idx + 8));
        }
        if c == 45 and self.matches(idx, "-Infinity") {
            return Ok((J.Float(-1.0 / 0.0), idx + 9));
        }
        self.match_number(idx)
    }

    // -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][-+]?[0-9]+)?, then int() or float()
    // of the text. Anything else at a value's place is "Expecting value".
    fn match_number(ref self, start: i64) -> Result[(J, i64), Exc] {
        let end_idx = self.s.len() - 1;
        let mut idx = start;
        if self.at(idx) == 45 {
            idx += 1;
            if idx > end_idx {
                return Err(self.fail("Expecting value", start));
            }
        }
        let c = self.at(idx);
        if c >= 49 and c <= 57 {
            idx += 1;
            while idx <= end_idx and is_digit(self.s[idx]) {
                idx += 1;
            }
        } else if c == 48 {
            idx += 1;
        } else {
            return Err(self.fail("Expecting value", start));
        }
        let mut is_float = false;
        if idx < end_idx and self.s[idx] == 46 and is_digit(self.s[idx + 1]) {
            is_float = true;
            idx += 2;
            while idx <= end_idx and is_digit(self.s[idx]) {
                idx += 1;
            }
        }
        if idx < end_idx and (self.s[idx] == 101 or self.s[idx] == 69) {
            let e_start = idx;
            idx += 1;
            if idx < end_idx and (self.s[idx] == 45 or self.s[idx] == 43) {
                idx += 1;
            }
            while idx <= end_idx and is_digit(self.s[idx]) {
                idx += 1;
            }
            if is_digit(self.s[idx - 1]) {
                is_float = true;
            } else {
                idx = e_start;
            }
        }
        let text = ascii_string(self.s, start, idx);
        if is_float {
            return match f64.parse(text) {
                Ok(x) => Ok((J.Float(x), idx)),
                Err(_) => Err(exc("ValueError", f"could not convert string to float: '{text}'")),
            };
        }
        let digits = if self.s[start] == 45 { idx - start - 1 } else { idx - start };
        if digits > 4300 {
            return Err(exc("ValueError", f"Exceeds the limit (4300 digits) for integer string conversion: value has {digits} digits; use sys.set_int_max_str_digits() to increase the limit"));
        }
        if text == "-0" {
            return Ok((J.Int("0".to_string()), idx));
        }
        Ok((J.Int(text), idx))
    }

    fn hex_escape(ref self, at: i64) -> Option[i64] {
        let mut v = 0;
        let mut k = 0;
        while k < 4 {
            let d = hex_value(self.at(at + k));
            if d < 0 {
                return None;
            }
            v = v * 16 + d;
            k += 1;
        }
        Some(v)
    }

    // scanstring: `start` is just past the opening quote.
    fn scan_string(ref self, start: i64) -> Result[(Vec[i64], i64), Exc] {
        let len = self.s.len();
        let begin = start - 1;
        let mut out: Vec[i64] = Vec.new();
        let mut end = start;
        loop {
            let mut next = end;
            let mut c = 0;
            while next < len {
                c = self.s[next];
                if c == 34 or c == 92 {
                    break;
                }
                if c <= 0x1F {
                    return Err(self.fail("Invalid control character at", next));
                }
                out.push(c);
                next += 1;
            }
            if next == len {
                return Err(self.fail("Unterminated string starting at", begin));
            }
            next += 1;
            if c == 34 {
                return Ok((out, next));
            }
            if next == len {
                return Err(self.fail("Unterminated string starting at", begin));
            }
            let e = self.s[next];
            if e != 117 {
                end = next + 1;
                let ch = match e {
                    34 => 34,
                    92 => 92,
                    47 => 47,
                    98 => 8,
                    102 => 12,
                    110 => 10,
                    114 => 13,
                    116 => 9,
                    _ => 0,
                };
                if ch == 0 {
                    return Err(self.fail("Invalid \\escape", end - 2));
                }
                out.push(ch);
            } else {
                next += 1;
                end = next + 4;
                if end >= len {
                    return Err(self.fail("Invalid \\uXXXX escape", next - 1));
                }
                let mut cp = match self.hex_escape(next) {
                    Some(v) => v,
                    None => return Err(self.fail("Invalid \\uXXXX escape", end - 5)),
                };
                // A high surrogate followed by an escaped low one is a pair;
                // followed by anything else it stays on its own.
                if cp >= 0xD800 and cp <= 0xDBFF and end + 6 < len and self.s[end] == 92 and self.s[end + 1] == 117 {
                    let low = match self.hex_escape(end + 2) {
                        Some(v) => v,
                        None => return Err(self.fail("Invalid \\uXXXX escape", end + 1)),
                    };
                    if low >= 0xDC00 and low <= 0xDFFF {
                        cp = 0x10000 + (((cp - 0xD800) << 10) | (low - 0xDC00));
                        end += 6;
                    }
                }
                out.push(cp);
            }
        }
    }

    fn parse_object(ref self, start: i64) -> Result[(J, i64), Exc] {
        let mut members: Vec[Member] = Vec.new();
        let mut idx = self.skip_ws(start);
        if self.at(idx) != 125 {
            loop {
                if self.at(idx) != 34 {
                    return Err(self.fail("Expecting property name enclosed in double quotes", idx));
                }
                let (key, after_key) = self.scan_string(idx + 1)?;
                idx = self.skip_ws(after_key);
                if self.at(idx) != 58 {
                    return Err(self.fail("Expecting ':' delimiter", idx));
                }
                idx = self.skip_ws(idx + 1);
                let (val, after_val) = self.scan_once(idx)?;
                put_member(mut members, key, val);
                idx = self.skip_ws(after_val);
                if self.at(idx) == 125 {
                    break;
                }
                if self.at(idx) != 44 {
                    return Err(self.fail("Expecting ',' delimiter", idx));
                }
                let comma = idx;
                idx = self.skip_ws(idx + 1);
                if self.at(idx) == 125 {
                    return Err(self.fail("Illegal trailing comma before end of object", comma));
                }
            }
        }
        Ok((J.Obj(members), idx + 1))
    }

    fn parse_array(ref self, start: i64) -> Result[(J, i64), Exc] {
        let mut items: Vec[J] = Vec.new();
        let mut idx = self.skip_ws(start);
        if self.at(idx) != 93 {
            loop {
                let (val, after) = self.scan_once(idx)?;
                items.push(val);
                idx = self.skip_ws(after);
                if self.at(idx) == 93 {
                    break;
                }
                if self.at(idx) != 44 {
                    return Err(self.fail("Expecting ',' delimiter", idx));
                }
                let comma = idx;
                idx = self.skip_ws(idx + 1);
                if self.at(idx) == 93 {
                    return Err(self.fail("Illegal trailing comma before end of array", comma));
                }
            }
        }
        Ok((J.Arr(items), idx + 1))
    }
}

// dict(pairs): a key seen again keeps its place and takes the new value.
fn put_member(members: mut ref Vec[Member], key: own Vec[i64], val: own J) {
    let mut j = 0;
    while j < members.len() {
        if cmp_cps(members[j].key, key) == 0 {
            members[j].val = val;
            return;
        }
        j += 1;
    }
    members.push(Member { key: key, val: val });
}

// json.loads on a str.
fn json_loads(text: ref Vec[i64]) -> Result[J, Exc] {
    let sc = Scanner { s: text.clone() };
    if sc.at(0) == 0xFEFF {
        return Err(sc.fail("Unexpected UTF-8 BOM (decode using utf-8-sig)", 0));
    }
    let start = sc.skip_ws(0);
    let (value, end) = sc.scan_once(start)?;
    let stop = sc.skip_ws(end);
    if stop != sc.s.len() {
        return Err(sc.fail("Extra data", stop));
    }
    Ok(value)
}


// ------------------------------------------------------------ values

// A Python value. Lists and dicts live in the heap and are named by their
// slot there, so two places can hold the same one and see each other's
// changes, as they do in Python (pyhcl's merges rely on that).
#[derive(Clone)]
enum V {
    Nil,
    Bool(bool),
    Int(i64),
    Float(f64),
    Str(Vec[i64]),
    Tuple(Vec[V]),
    List(i64),
    Dict(i64),
}

#[derive(Clone)]
struct Pair {
    key: V,
    val: V,
}

struct Heap {
    lists: Vec[Vec[V]],
    dicts: Vec[Vec[Pair]],
}

fn new_heap() -> Heap {
    Heap { lists: Vec.new(), dicts: Vec.new() }
}

fn s(text: Str) -> V {
    let mut out: Vec[i64] = Vec.new();
    push_ascii(mut out, text);
    V.Str(out)
}

fn one(a: own V) -> Vec[V] {
    let mut v: Vec[V] = Vec.new();
    v.push(a);
    v
}

fn two(a: own V, b: own V) -> Vec[V] {
    let mut v: Vec[V] = Vec.new();
    v.push(a);
    v.push(b);
    v
}

impl Heap {
    fn list_of(mut ref self, items: own Vec[V]) -> V {
        self.lists.push(items);
        V.List(self.lists.len() - 1)
    }

    fn new_dict(mut ref self) -> i64 {
        self.dicts.push(Vec.new());
        self.dicts.len() - 1
    }

    fn find(ref self, d: i64, key: ref V) -> i64 {
        let items = ref self.dicts[d];
        let mut i = 0;
        while i < items.len() {
            if key_eq(items[i].key, key) {
                return i;
            }
            i += 1;
        }
        -1
    }

    // d[key] = val: a key already there keeps its place.
    fn set(mut ref self, d: i64, key: own V, val: own V) {
        let i = self.find(d, key);
        if i >= 0 {
            self.dicts[d][i].val = val;
        } else {
            self.dicts[d].push(Pair { key: key, val: val });
        }
    }

    fn dict_with(mut ref self, key: own V, val: own V) -> V {
        let d = self.new_dict();
        self.dicts[d].push(Pair { key: key, val: val });
        V.Dict(d)
    }
}

fn key_eq(a: ref V, b: ref V) -> bool {
    match a {
        V.Nil => match b {
            V.Nil => true,
            _ => false,
        },
        V.Str(x) => match b {
            V.Str(y) => same(x, y),
            _ => false,
        },
        V.Tuple(x) => match b {
            V.Tuple(y) => {
                if x.len() != y.len() {
                    return false;
                }
                let mut i = 0;
                while i < x.len() {
                    if not key_eq(x[i], y[i]) {
                        return false;
                    }
                    i += 1;
                }
                true
            }
            _ => false,
        },
        _ => match num_of(a) {
            Some(x) => match num_of(b) {
                Some(y) => x == y,
                None => false,
            },
            None => false,
        },
    }
}

// The value of a number (or bool) as a float, for comparing.
fn num_of(v: ref V) -> Option[f64] {
    match v {
        V.Bool(b) => Some(if b { 1.0 } else { 0.0 }),
        V.Int(n) => Some(n as f64),
        V.Float(x) => Some(x),
        _ => None,
    }
}

fn type_name(v: ref V) -> Str {
    match v {
        V.Nil => "NoneType",
        V.Bool(_) => "bool",
        V.Int(_) => "int",
        V.Float(_) => "float",
        V.Str(_) => "str",
        V.Tuple(_) => "tuple",
        V.List(_) => "list",
        V.Dict(_) => "dict",
    }
}

struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: own String) -> Exc {
    Exc { kind: kind.to_string(), msg: msg }
}

fn type_error(msg: own String) -> Exc {
    exc("TypeError", msg)
}

fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    f"{x}"
}

fn push_int(out: mut ref Vec[i64], n: i64) {
    push_ascii(mut out, f"{n}");
}

// repr(v), or str(v) when `as_str` (which differs only for a str itself).
fn show(h: ref Heap, v: ref V, as_str: bool, out: mut ref Vec[i64]) {
    match v {
        V.Nil => push_ascii(mut out, "None"),
        V.Bool(b) => push_ascii(mut out, if b { "True" } else { "False" }),
        V.Int(n) => push_int(mut out, n),
        V.Float(x) => push_ascii(mut out, float_repr(x)),
        V.Str(t) => {
            if as_str {
                push_all(mut out, t);
            } else {
                str_repr(t, mut out);
            }
        }
        V.Tuple(items) => {
            out.push(40);
            let mut i = 0;
            while i < items.len() {
                if i > 0 {
                    push_ascii(mut out, ", ");
                }
                show(h, items[i], false, mut out);
                i += 1;
            }
            if items.len() == 1 {
                out.push(44);
            }
            out.push(41);
        }
        V.List(id) => {
            out.push(91);
            let items = ref h.lists[id];
            let mut i = 0;
            while i < items.len() {
                if i > 0 {
                    push_ascii(mut out, ", ");
                }
                show(h, items[i], false, mut out);
                i += 1;
            }
            out.push(93);
        }
        V.Dict(id) => {
            out.push(123);
            let items = ref h.dicts[id];
            let mut i = 0;
            while i < items.len() {
                if i > 0 {
                    push_ascii(mut out, ", ");
                }
                show(h, items[i].key, false, mut out);
                push_ascii(mut out, ": ");
                show(h, items[i].val, false, mut out);
                i += 1;
            }
            out.push(125);
        }
    }
}

fn py_str(h: ref Heap, v: ref V) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    show(h, v, true, mut out);
    out
}

fn py_repr(h: ref Heap, v: ref V) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    show(h, v, false, mut out);
    out
}

fn str_of(h: ref Heap, v: ref V) -> V {
    V.Str(py_str(h, v))
}

// a + b, for the sequences pyhcl's actions join.
fn py_add(h: mut ref Heap, a: ref V, b: ref V) -> Result[V, Exc] {
    match a {
        V.Str(x) => {
            if let V.Str(y) = b {
                let mut out = x.clone();
                push_all(mut out, y);
                return Ok(V.Str(out));
            }
        }
        V.Tuple(x) => {
            if let V.Tuple(y) = b {
                let mut out = x.clone();
                for e in y {
                    out.push(e.clone());
                }
                return Ok(V.Tuple(out));
            }
        }
        V.List(x) => {
            if let V.List(y) = b {
                let mut out = h.lists[x].clone();
                let more = h.lists[y].clone();
                for e in more {
                    out.push(e.clone());
                }
                return Ok(h.list_of(out));
            }
        }
        _ => {
            if num_of(a).is_some() and num_of(b).is_some() {
                return arith(43, a, b);
            }
            return Err(type_error(f"unsupported operand type(s) for +: '{type_name(a)}' and '{type_name(b)}'"));
        }
    }
    let ta = type_name(a);
    Err(type_error(f"can only concatenate {ta} (not \"{type_name(b)}\") to {ta}"))
}

fn add_all(h: mut ref Heap, parts: ref Vec[V]) -> Result[V, Exc] {
    let mut acc = parts[0].clone();
    let mut i = 1;
    while i < parts.len() {
        acc = py_add(mut h, acc, parts[i])?;
        i += 1;
    }
    Ok(acc)
}

fn as_int(v: ref V) -> Option[i64] {
    match v {
        V.Int(n) => Some(n),
        V.Bool(b) => Some(if b { 1 } else { 0 }),
        _ => None,
    }
}

// The four operators on numbers, as Python computes them: int with int
// stays int, except for /; anything with a float is a float.
fn arith(op: i64, a: ref V, b: ref V) -> Result[V, Exc] {
    let name = if op == 43 { "+" } else if op == 45 { "-" } else if op == 42 { "*" } else { "/" };
    let (x, y) = match num_of(a) {
        Some(x) => match num_of(b) {
            Some(y) => (x, y),
            None => return Err(type_error(f"unsupported operand type(s) for {name}: '{type_name(a)}' and '{type_name(b)}'")),
        },
        None => return Err(type_error(f"unsupported operand type(s) for {name}: '{type_name(a)}' and '{type_name(b)}'")),
    };
    if let Some(i) = as_int(a) {
        if let Some(j) = as_int(b) {
            if op == 43 {
                return Ok(V.Int(i + j));
            }
            if op == 45 {
                return Ok(V.Int(i - j));
            }
            if op == 42 {
                return Ok(V.Int(i * j));
            }
            if j == 0 {
                return Err(exc("ZeroDivisionError", "division by zero".to_string()));
            }
            return Ok(V.Float(x / y));
        }
    }
    if op == 43 {
        Ok(V.Float(x + y))
    } else if op == 45 {
        Ok(V.Float(x - y))
    } else if op == 42 {
        Ok(V.Float(x * y))
    } else if y == 0.0 {
        Err(exc("ZeroDivisionError", "float division by zero".to_string()))
    } else {
        Ok(V.Float(x / y))
    }
}

fn negate(v: ref V) -> Result[V, Exc] {
    match v {
        V.Int(n) => Ok(V.Int(-n)),
        V.Bool(b) => Ok(V.Int(if b { -1 } else { 0 })),
        V.Float(x) => Ok(V.Float(-x)),
        _ => Err(type_error(f"bad operand type for unary -: '{type_name(v)}'")),
    }
}

fn digits_at(t: ref Vec[i64], from: i64) -> i64 {
    let mut i = from;
    while i < t.len() and t[i] >= 48 and t[i] <= 57 {
        i += 1;
    }
    i - from
}

// float(text): the forms str() of a number makes, with an exponent.
fn py_float(text: ref Vec[i64]) -> Result[f64, Exc] {
    let mut lo = 0;
    let mut hi = text.len();
    while lo < hi and is_space(text[lo], false) {
        lo += 1;
    }
    while hi > lo and is_space(text[hi - 1], false) {
        hi -= 1;
    }
    let t = slice(text, lo, hi);
    let mut i = 0;
    if i < t.len() and (t[i] == 43 or t[i] == 45) {
        i += 1;
    }
    let lead = digits_at(t, i);
    i += lead;
    let mut frac = 0;
    if i < t.len() and t[i] == 46 {
        i += 1;
        frac = digits_at(t, i);
        i += frac;
    }
    let mut ok = lead + frac > 0;
    if ok and i < t.len() and (t[i] == 101 or t[i] == 69) {
        i += 1;
        if i < t.len() and (t[i] == 43 or t[i] == 45) {
            i += 1;
        }
        let e = digits_at(t, i);
        ok = e > 0;
        i += e;
    }
    if ok and i == t.len() {
        let parsed: Option[f64] = to_string(t).parse();
        if let Some(x) = parsed {
            return Ok(x);
        }
    }
    Err(exc("ValueError", f"could not convert string to float: {repr_of(text)}"))
}

// ------------------------------------------------------- PLY's lexer

struct LexState {
    name: String,
    ignore: Vec[i64],
    errorf: bool,
    eof: bool,
    prog: Program,
    funcs: Vec[i64],
    types: Vec[String],
}

// What each rule function does, by number.
fn func_code(name: ref String) -> i64 {
    let table = [
        "-", "t_BOOL", "t_PLAIN", "t_FLOAT", "t_hexnumber", "t_intnumber", "t_string",
        "t_tabbedheredoc", "t_heredoc", "t_COMMENT", "t_MULTICOMMENT", "t_newline",
        "t_IGNORE", "t_stringdollar_lbrace", "t_stringdollar_rbrace",
        "t_string_escapedchar", "t_string_stringdollar", "t_string_STRING", "t_heredoc_STRING",
    ];
    let mut k = 0;
    while k < table.len() {
        if name == table[k] {
            return k;
        }
        k += 1;
    }
    if name == "t_tabbedheredoc_STRING" {
        return 18;
    }
    if name == "t_stringdollar_dontcare" or name == "t_string_ignoring" or name == "t_heredoc_ignoring" {
        return 12;
    }
    // the rules that return their token as it is
    2
}

// The ignore string as gen_kara.py wrote it (unicode_escape).
fn unescape(text: ref String) -> Vec[i64] {
    let t = codepoints(text.bytes());
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < t.len() {
        if t[i] == 92 and i + 1 < t.len() {
            let c = t[i + 1];
            if c == 116 {
                out.push(9);
                i += 2;
            } else if c == 114 {
                out.push(13);
                i += 2;
            } else if c == 110 {
                out.push(10);
                i += 2;
            } else if c == 120 {
                out.push(digits_value(t, i + 2, 16) & 0xFF);
                i += 4;
            } else {
                out.push(c);
                i += 2;
            }
        } else {
            out.push(t[i]);
            i += 1;
        }
    }
    out
}

fn read_lex(text: ref String) -> Vec[LexState] {
    let mut states: Vec[LexState] = Vec.new();
    for line in text.split("\n") {
        let parts: Vec[String] = line.split("\t").map(|p| p.to_string()).collect();
        if parts.len() < 2 {
            continue;
        }
        if parts[0] == "S" {
            let empty = match compile(Vec.new(), 0) {
                Ok(p) => p,
                Err(_) => return states,
            };
            states.push(LexState {
                name: parts[1].clone(),
                ignore: unescape(parts[3]),
                errorf: parts[4] != "-",
                eof: parts[5] != "-",
                prog: empty,
                funcs: Vec.new(),
                types: Vec.new(),
            });
        } else if parts[0] == "X" {
            let start = 2;
            let pattern = slice(codepoints(line.bytes()), start, codepoints(line.bytes()).len());
            let k = states.len() - 1;
            match compile(pattern, 8 | 32) {
                Ok(p) => {
                    let mut funcs: Vec[i64] = Vec.new();
                    let mut types: Vec[String] = Vec.new();
                    let mut g = 0;
                    while g <= p.groups {
                        funcs.push(-1);
                        types.push(String.new());
                        g += 1;
                    }
                    states[k].prog = p;
                    states[k].funcs = funcs;
                    states[k].types = types;
                }
                Err(e) => eprintln(f"cannot compile the {states[k].name} rules: {err_text(e)}"),
            }
        } else if parts[0] == "I" {
            let k = states.len() - 1;
            let g = int_of(parts[1]);
            states[k].funcs[g] = func_code(parts[2]);
            states[k].types[g] = parts[3].clone();
        }
    }
    states
}

fn int_of(text: ref String) -> i64 {
    let n: Option[i64] = text.parse();
    n.unwrap_or(0)
}

fn state_index(states: ref Vec[LexState], name: Str) -> i64 {
    let mut k = 0;
    while k < states.len() {
        if states[k].name == name {
            return k;
        }
        k += 1;
    }
    0
}

#[derive(Clone)]
struct Tok {
    ty: String,
    value: V,
    lineno: i64,
    lexpos: i64,
}

struct Lexer {
    data: Vec[i64],
    pos: i64,
    lineno: i64,
    state: i64,
    abs_start: i64,
    rel_pos: i64,
    string_value: Vec[i64],
    braces: i64,
    here_start: i64,
    newline_chars: i64,
    here_identifier: Vec[i64],
    is_tabbed: bool,
    line_comments: bool,
    multi_comments: bool,
    matchers: Vec[Matcher],
}

// Lexer(export_comments=mode): the mode is "" for None.
fn new_lexer(states: ref Vec[LexState], data: ref Vec[i64], mode: ref String) -> Result[Lexer, Exc] {
    let mut line_comments = false;
    let mut multi_comments = false;
    if mode == "LINE" {
        line_comments = true;
    } else if mode == "MULTILINE" {
        multi_comments = true;
    } else if mode == "ALL" {
        line_comments = true;
        multi_comments = true;
    } else if mode != "" {
        return Err(exc("ValueError", f"Only `LINE`, `MULTILINE` and `ALL` value are allowed for `export_comments`. given: `{mode}`."));
    }
    let mut matchers: Vec[Matcher] = Vec.new();
    for st in states {
        matchers.push(new_matcher(st.prog, data));
    }
    Ok(Lexer {
        data: data.clone(),
        pos: 0,
        lineno: 1,
        state: 0,
        abs_start: 0,
        rel_pos: 0,
        string_value: Vec.new(),
        braces: 0,
        here_start: 0,
        newline_chars: 1,
        here_identifier: Vec.new(),
        is_tabbed: false,
        line_comments: line_comments,
        multi_comments: multi_comments,
        matchers: matchers,
    })
}

// s[a:b], with Python's clamping.
fn pyslice(t: ref Vec[i64], a0: i64, b0: i64) -> Vec[i64] {
    let n = t.len();
    let mut a = a0;
    let mut b = b0;
    if a < 0 {
        a += n;
        if a < 0 {
            a = 0;
        }
    }
    if b < 0 {
        b += n;
        if b < 0 {
            b = 0;
        }
    }
    if a > n {
        a = n;
    }
    if b > n {
        b = n;
    }
    if b <= a {
        return Vec.new();
    }
    slice(t, a, b)
}

fn count_of(t: ref Vec[i64], x: i64) -> i64 {
    let mut n = 0;
    for c in t {
        if c == x {
            n += 1;
        }
    }
    n
}

fn count_nl(t: ref Vec[i64]) -> i64 {
    count_of(t, 10)
}

fn starts_with(t: ref Vec[i64], prefix: Str) -> bool {
    let p = codepoints(prefix.bytes());
    if p.len() > t.len() {
        return false;
    }
    let mut i = 0;
    while i < p.len() {
        if t[i] != p[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn ends_with(t: ref Vec[i64], suffix: ref Vec[i64]) -> bool {
    if suffix.len() > t.len() {
        return false;
    }
    let off = t.len() - suffix.len();
    let mut i = 0;
    while i < suffix.len() {
        if t[off + i] != suffix[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn strip(t: ref Vec[i64]) -> Vec[i64] {
    let mut lo = 0;
    let mut hi = t.len();
    while lo < hi and is_space(t[lo], false) {
        lo += 1;
    }
    while hi > lo and is_space(t[hi - 1], false) {
        hi -= 1;
    }
    slice(t, lo, hi)
}

fn lstrip_char(t: ref Vec[i64], c: i64) -> Vec[i64] {
    let mut lo = 0;
    while lo < t.len() and t[lo] == c {
        lo += 1;
    }
    slice(t, lo, t.len())
}

fn lstrip(t: ref Vec[i64]) -> Vec[i64] {
    let mut lo = 0;
    while lo < t.len() and is_space(t[lo], false) {
        lo += 1;
    }
    slice(t, lo, t.len())
}

fn hex_int(t: ref Vec[i64]) -> i64 {
    let neg = t.len() > 0 and t[0] == 45;
    let from = if neg { 3 } else { 2 };
    let n = digits_value(t, from, 16);
    if neg { -n } else { n }
}

fn dec_int(t: ref Vec[i64]) -> i64 {
    let neg = t.len() > 0 and t[0] == 45;
    let n = digits_value(t, if neg { 1 } else { 0 }, 10);
    if neg { -n } else { n }
}

impl Lexer {
    fn begin(mut ref self, states: ref Vec[LexState], name: Str) {
        self.state = state_index(states, name);
    }

    // _raise_error: the column is counted from the token, the index is
    // the lexer's position.
    fn raise_error(ref self, tokpos: i64, message: own String) -> Exc {
        let mut last_cr = tokpos - 1;
        while last_cr >= 0 and self.data[last_cr] != 10 {
            last_cr -= 1;
        }
        let column = tokpos - last_cr - 1;
        exc("ValueError", f"Line {self.lineno}, column {column}, index {self.pos}: {message}")
    }

    fn t_error(ref self) -> Exc {
        let value = pyslice(self.data, self.pos, self.data.len());
        if starts_with(value, "/*") {
            return self.raise_error(self.pos, "EOF before closing multiline comment".to_string());
        }
        if starts_with(value, "*/") {
            return self.raise_error(self.pos, "Found '*/' before start of multiline comment".to_string());
        }
        if starts_with(value, "/") or (starts_with(value, "<") and not starts_with(value, "<<")) {
            if value.len() < 2 {
                return exc("IndexError", "string index out of range".to_string());
            }
            let c = to_string(slice(value, 1, 2));
            if value[0] == 47 {
                return self.raise_error(self.pos, f"Expected '//' for comment, got '/{c}'");
            }
            return self.raise_error(self.pos, f"Heredoc must start with '<<', got '<{c}'");
        }
        if starts_with(value, "<<") {
            return self.raise_error(self.pos, "Heredoc must have a marker, e.g. '<<FOO'".to_string());
        }
        let c = to_string(slice(value, 0, 1));
        self.raise_error(self.pos, f"Illegal character '{c}'")
    }

    // The eof rules of the string and heredoc states: all of them raise.
    fn eof_error(mut ref self, states: ref Vec[LexState]) -> Exc {
        let name = states[self.state].name.clone();
        if name == "heredoc" or name == "tabbedheredoc" {
            self.lineno += count_nl(pyslice(self.data, self.here_start, self.pos));
            return self.raise_error(self.pos, "EOF before closing heredoc".to_string());
        }
        self.lineno += count_nl(pyslice(self.data, self.abs_start, self.pos));
        if name == "string" {
            return self.raise_error(self.pos, "EOF before closing string quote".to_string());
        }
        self.raise_error(self.pos, "EOF before closing '${}' expression".to_string())
    }

    fn init_heredoc(mut ref self, text: ref Vec[i64]) {
        self.here_start = self.pos;
        let n = text.len();
        self.newline_chars = if n >= 2 and text[n - 2] == 13 and text[n - 1] == 10 { 2 } else { 1 };
        let chop = if self.is_tabbed { 3 } else { 2 };
        self.here_identifier = pyslice(text, chop, n - self.newline_chars);
        self.lineno += 1;
    }

    fn end_heredoc(mut ref self, states: ref Vec[LexState], tok: mut ref Tok) -> bool {
        let text = match tok.value {
            V.Str(t) => t.clone(),
            _ => Vec.new(),
        };
        let value = if self.is_tabbed { strip(text) } else { text.clone() };
        let mut endpos = 0;
        if same(value, self.here_identifier) {
            endpos = self.pos - (self.newline_chars + text.len());
        } else if ends_with(value, self.here_identifier) {
            endpos = self.pos - self.here_identifier.len();
        } else {
            return false;
        }
        let entire = pyslice(self.data, self.here_start, endpos);
        if self.is_tabbed {
            let mut out: Vec[i64] = Vec.new();
            let mut i = 0;
            while i < entire.len() and entire[i] == 9 {
                i += 1;
            }
            while i < entire.len() {
                out.push(entire[i]);
                if entire[i] == 10 {
                    i += 1;
                    while i < entire.len() and entire[i] == 9 {
                        i += 1;
                    }
                } else {
                    i += 1;
                }
            }
            tok.value = V.Str(out);
        } else {
            tok.value = V.Str(entire);
        }
        self.lineno += count_nl(pyslice(self.data, self.here_start, self.pos));
        self.begin(states, "INITIAL");
        true
    }

    // Runs a rule function on its token: whether the token is returned.
    fn rule(mut ref self, states: ref Vec[LexState], f: i64, tok: mut ref Tok) -> Result[bool, Exc] {
        let text = match tok.value {
            V.Str(t) => t.clone(),
            _ => Vec.new(),
        };
        if f == 1 {
            tok.value = V.Bool(starts_with(text, "true") and text.len() == 4);
            return Ok(true);
        }
        if f == 2 {
            return Ok(true);
        }
        if f == 3 {
            tok.value = V.Float(py_float(text)?);
            return Ok(true);
        }
        if f == 4 {
            tok.value = V.Int(hex_int(text));
            tok.ty = "NUMBER".to_string();
            return Ok(true);
        }
        if f == 5 {
            tok.value = V.Int(dec_int(text));
            tok.ty = "NUMBER".to_string();
            return Ok(true);
        }
        if f == 6 {
            self.abs_start = self.pos;
            self.rel_pos = self.pos;
            self.string_value = Vec.new();
            self.begin(states, "string");
            return Ok(false);
        }
        if f == 7 or f == 8 {
            self.is_tabbed = f == 7;
            self.init_heredoc(text);
            self.begin(states, if f == 7 { "tabbedheredoc" } else { "heredoc" });
            return Ok(false);
        }
        if f == 9 {
            if self.line_comments {
                tok.value = V.Str(lstrip(lstrip_char(lstrip_char(text, 35), 47)));
                return Ok(true);
            }
            return Ok(false);
        }
        if f == 10 {
            self.lineno += count_nl(text);
            return Ok(self.multi_comments);
        }
        if f == 11 {
            self.lineno += text.len();
            return Ok(false);
        }
        if f == 13 {
            self.braces += 1;
            return Ok(false);
        }
        if f == 14 {
            self.braces -= 1;
            if self.braces == 0 {
                self.begin(states, "string");
            }
            return Ok(false);
        }
        if f == 15 {
            let part = pyslice(self.data, self.rel_pos, self.pos - 2);
            push_all(mut self.string_value, part);
            push_all(mut self.string_value, text);
            self.rel_pos = self.pos;
            return Ok(false);
        }
        if f == 16 {
            self.braces = 1;
            self.begin(states, "stringdollar");
            return Ok(false);
        }
        if f == 17 {
            let mut value = self.string_value.clone();
            push_all(mut value, pyslice(self.data, self.rel_pos, self.pos - 1));
            tok.value = V.Str(value);
            self.lineno += count_nl(pyslice(self.data, self.abs_start, self.pos - 1));
            self.begin(states, "INITIAL");
            return Ok(true);
        }
        if f == 18 {
            return Ok(self.end_heredoc(states, mut tok));
        }
        Ok(false)
    }

    // lex.token(): None at the end of the input.
    fn token(mut ref self, states: ref Vec[LexState]) -> Result[Option[Tok], Exc] {
        while self.pos < self.data.len() {
            let st = self.state;
            let c = self.data[self.pos];
            let mut ignored = false;
            for x in states[st].ignore.iter() {
                if *x == c {
                    ignored = true;
                }
            }
            if ignored {
                self.pos += 1;
                continue;
            }
            let found = find(mut self.matchers[st], states[st].prog, self.pos, false, 1);
            match found {
                Some(m) => {
                    let g = m.lastindex;
                    let mut tok = Tok {
                        ty: states[st].types[g].clone(),
                        value: V.Str(slice(self.data, m.start, m.end)),
                        lineno: self.lineno,
                        lexpos: self.pos,
                    };
                    let f = states[st].funcs[g];
                    self.pos = m.end;
                    if f == 0 {
                        return Ok(Some(tok));
                    }
                    if self.rule(states, f, mut tok)? {
                        return Ok(Some(tok));
                    }
                }
                None => {
                    if states[st].errorf {
                        return Err(self.t_error());
                    }
                    let c = to_string(slice(self.data, self.pos, self.pos + 1));
                    return Err(exc("LexError", f"Illegal character '{c}' at index {self.pos}"));
                }
            }
        }
        if states[self.state].eof {
            return Err(self.eof_error(states));
        }
        self.pos = self.data.len() + 1;
        Ok(None)
    }
}

// ------------------------------------------------------ PLY's parser

struct Prod {
    name: String,
    len: i64,
    code: i64,
}

struct Tables {
    prods: Vec[Prod],
    actions: Vec[Vec[(String, i64)]],
    gotos: Vec[Vec[(String, i64)]],
    defaulted: Vec[i64],
    has_default: Vec[bool],
}

fn ensure_row(rows: mut ref Vec[Vec[(String, i64)]], st: i64) {
    while rows.len() <= st {
        rows.push(Vec.new());
    }
}

// Which of pyhcl's actions a production runs: its function, and for the
// functions that cover several forms, which form.
fn action_code(func: ref String, rhs: ref Vec[String]) -> i64 {
    let names = [
        "-", "p_top", "p_empty_0", "p_objectlist_0", "p_objectlist_1", "p_objectlist_2",
        "p_object_0", "p_object_2", "p_objectkey_0", "p_objectkey_1", "p_objectbrackets_0",
        "p_objectbrackets_1", "p_objectitem_0", "p_objectitem_2", "p_booleanexp_0",
        "p_block_0", "p_block_1", "p_list_0", "p_list_2", "p_list_of_lists_0",
        "p_list_of_lists_1", "p_function_0", "p_function_1", "p_function_2", "p_function_3",
        "p_listitems_2", "p_listitems_3", "p_listitems_4", "p_listitem_1", "p_number_1",
        "p_number_2", "p_number_4", "p_number_5", "p_number_6", "p_number_7", "p_int_0",
        "p_float_0", "p_exp_0", "p_exp_1", "p_comment_0",
    ];
    let mut k = 0;
    while k < names.len() {
        if func == names[k] {
            return k;
        }
        k += 1;
    }
    if func == "p_object_1" {
        return 6;
    }
    if func == "p_list_1" {
        return 2;
    }
    if func == "p_listitems_0" {
        return 3;
    }
    if func == "p_listitems_1" {
        return 5;
    }
    if func == "p_number_3" {
        return 30;
    }
    // p[0] = p[1]: objectitem_1, operator_0, listitems_5, listitem_0,
    // number_0, int_1, float_1
    let _ = rhs.len();
    8
}

fn read_tables(text: ref String) -> Tables {
    let mut t = Tables { prods: Vec.new(), actions: Vec.new(), gotos: Vec.new(), defaulted: Vec.new(), has_default: Vec.new() };
    for line in text.split("\n") {
        let parts: Vec[String] = line.split(" ").map(|p| p.to_string()).collect();
        if parts.len() < 2 {
            continue;
        }
        if parts[0] == "P" {
            let mut rhs: Vec[String] = Vec.new();
            let mut k = 4;
            while k < parts.len() {
                rhs.push(parts[k].clone());
                k += 1;
            }
            t.prods.push(Prod { name: parts[1].clone(), len: int_of(parts[2]), code: action_code(parts[3], rhs) });
            continue;
        }
        let st = int_of(parts[1]);
        if parts[0] == "D" {
            while t.defaulted.len() <= st {
                t.defaulted.push(0);
                t.has_default.push(false);
            }
            t.defaulted[st] = int_of(parts[2]);
            t.has_default[st] = true;
            continue;
        }
        let mut row: Vec[(String, i64)] = Vec.new();
        let mut k = 2;
        while k < parts.len() {
            let item = codepoints(parts[k].bytes());
            let mut eq = item.len() - 1;
            while eq > 0 and item[eq] != 61 {
                eq -= 1;
            }
            let name = to_string(slice(item, 0, eq));
            let n = int_of(to_string(slice(item, eq + 1, item.len())));
            row.push((name, n));
            k += 1;
        }
        if parts[0] == "A" {
            ensure_row(mut t.actions, st);
            t.actions[st] = row;
        } else {
            ensure_row(mut t.gotos, st);
            t.gotos[st] = row;
        }
    }
    while t.has_default.len() < t.actions.len() {
        t.defaulted.push(0);
        t.has_default.push(false);
    }
    t
}

fn lookup(row: ref Vec[(String, i64)], name: ref String) -> Option[i64] {
    for (k, v) in row.iter() {
        if k == name {
            return Some(*v);
        }
    }
    None
}

fn tuple_at(v: ref V, i: i64) -> Result[V, Exc] {
    match v {
        V.Tuple(items) => {
            if i < items.len() {
                Ok(items[i].clone())
            } else {
                Err(exc("IndexError", "tuple index out of range".to_string()))
            }
        }
        _ => Err(type_error(f"'{type_name(v)}' object is not subscriptable")),
    }
}

fn pad3(n: i64) -> String {
    if n < 10 {
        f"00{n}"
    } else if n < 100 {
        f"0{n}"
    } else {
        f"{n}"
    }
}

// HclParser's p_* functions; p[0] is unused, p[1].. are the symbols.
fn act(h: mut ref Heap, code: i64, p: ref Vec[V], line1: i64) -> Result[V, Exc] {
    if code == 1 {
        return objectlist_flat(mut h, p[1], true);
    }
    if code == 2 {
        return Ok(h.list_of(Vec.new()));
    }
    if code == 3 {
        return Ok(h.list_of(one(p[1].clone())));
    }
    if code == 4 {
        let tail = h.list_of(one(p[2].clone()));
        return py_add(mut h, p[1], tail);
    }
    if code == 5 {
        let tail = h.list_of(one(p[3].clone()));
        return py_add(mut h, p[1], tail);
    }
    if code == 6 {
        return objectlist_flat(mut h, p[2], false);
    }
    if code == 7 {
        let d = h.new_dict();
        return Ok(V.Dict(d));
    }
    if code == 8 {
        return Ok(p[1].clone());
    }
    if code == 9 {
        let mut parts: Vec[V] = Vec.new();
        parts.push(str_of(h, p[1]));
        parts.push(str_of(h, p[2]));
        parts.push(str_of(h, p[3]));
        return Ok(V.Tuple(parts));
    }
    if code == 10 {
        let mut parts: Vec[V] = Vec.new();
        for i in 1..5 {
            parts.push(p[i].clone());
        }
        return add_all(mut h, parts);
    }
    if code == 11 {
        let mut parts = two(p[1].clone(), p[2].clone());
        parts.push(str_of(h, p[3]));
        for i in 4..7 {
            parts.push(p[i].clone());
        }
        return add_all(mut h, parts);
    }
    if code == 12 or code == 15 or code == 19 {
        let second = if code == 15 { p[2].clone() } else { p[3].clone() };
        return Ok(V.Tuple(two(p[1].clone(), second)));
    }
    if code == 13 {
        let mut acc = py_add(mut h, p[3], p[4])?;
        acc = py_add(mut h, acc, str_of(h, p[5]))?;
        acc = py_add(mut h, acc, p[6])?;
        acc = py_add(mut h, acc, str_of(h, p[7]))?;
        return Ok(V.Tuple(two(p[1].clone(), acc)));
    }
    if code == 14 {
        let mut acc = py_add(mut h, str_of(h, p[1]), p[2])?;
        acc = py_add(mut h, acc, str_of(h, p[3]))?;
        return Ok(acc);
    }
    if code == 16 {
        let key = tuple_at(p[2], 0)?;
        let val = tuple_at(p[2], 1)?;
        let inner = h.dict_with(key, val);
        return Ok(V.Tuple(two(p[1].clone(), inner)));
    }
    if code == 17 {
        return Ok(p[2].clone());
    }
    if code == 18 {
        let first = h.list_of(one(p[3].clone()));
        let mut parts: Vec[V] = Vec.new();
        for i in 5..8 {
            parts.push(p[i].clone());
        }
        let dots = add_all(mut h, parts)?;
        let second = h.list_of(one(dots));
        return py_add(mut h, first, second);
    }
    if code == 20 {
        return py_add(mut h, p[1], V.Tuple(one(p[3].clone())));
    }
    if code >= 21 and code <= 24 {
        // the arguments are flattened where they fall in the sum
        let at = if code == 24 { 4 } else { 3 };
        let last = if code == 21 { 4 } else if code == 22 { 5 } else if code == 23 { 7 } else { 9 };
        let mut acc = p[1].clone();
        let mut i = 2;
        while i <= last {
            if code == 22 and i == 4 {
                i += 1;
                continue;
            }
            let part = if i == at { V.Str(flatten(mut h, p[i])?) } else { p[i].clone() };
            acc = py_add(mut h, acc, part)?;
            i += 1;
        }
        return Ok(acc);
    }
    if code == 25 {
        return Ok(h.list_of(two(p[1].clone(), p[3].clone())));
    }
    if code == 26 {
        let mut parts: Vec[V] = Vec.new();
        for i in 3..6 {
            parts.push(p[i].clone());
        }
        let joined = add_all(mut h, parts)?;
        return Ok(h.list_of(two(p[1].clone(), joined)));
    }
    if code == 27 {
        if let V.List(id) = p[2] {
            h.lists[id].insert(0, p[1].clone());
            return Ok(p[2].clone());
        }
        return Err(exc("AttributeError", f"'{type_name(p[2])}' object has no attribute 'insert'"));
    }
    if code == 28 {
        let mut parts: Vec[V] = Vec.new();
        for i in 1..4 {
            parts.push(p[i].clone());
        }
        return add_all(mut h, parts);
    }
    if code == 29 {
        return match num_of(p[1]) {
            Some(x) => Ok(V.Float(x)),
            None => Err(type_error(f"float() argument must be a string or a real number, not '{type_name(p[1])}'")),
        };
    }
    if code == 30 {
        let mut text = py_str(h, p[1]);
        push_all(mut text, py_str(h, p[2]));
        return Ok(V.Float(py_float(text)?));
    }
    if code >= 31 and code <= 34 {
        let op = if code == 31 { 43 } else if code == 32 { 45 } else if code == 33 { 42 } else { 47 };
        return arith(op, p[1], p[3]);
    }
    if code == 35 {
        return negate(p[2]);
    }
    if code == 36 {
        return arith(42, p[2], V.Int(-1));
    }
    if code == 37 or code == 38 {
        let mut text: Vec[i64] = Vec.new();
        push_ascii(mut text, if code == 37 { "e" } else { "e-" });
        push_all(mut text, py_str(h, p[2]));
        return Ok(V.Str(text));
    }
    if code == 39 {
        let mut key: Vec[i64] = Vec.new();
        push_ascii(mut key, f"comment-L{pad3(line1)}");
        return Ok(V.Tuple(two(V.Str(key), p[1].clone())));
    }
    Ok(V.Nil)
}

// p_error, with the hack that reads the state's expected tokens.
fn p_error(tables: ref Tables, state: ref i64, look: ref Tok) -> Exc {
    let mut names: Vec[String] = Vec.new();
    for (k, _) in tables.actions[*state].iter() {
        names.push(k.clone());
    }
    let expected = f"; expected {names.join(", ")}";
    if look.ty == "$end" {
        return exc("ValueError", f"Unexpected end of file{expected}");
    }
    exc("ValueError", f"Line {look.lineno}, column {look.lexpos}: unexpected {look.ty}{expected}")
}

// yacc's parse loop, reading tokens only when it needs a lookahead.
fn parse_hcl(h: mut ref Heap, tables: ref Tables, states: ref Vec[LexState], data: ref Vec[i64], mode: ref String) -> Result[V, Exc] {
    let mut lx = new_lexer(states, data, mode)?;
    let mut stack: Vec[i64] = Vec.new();
    stack.push(0);
    let mut vals: Vec[V] = Vec.new();
    vals.push(V.Nil);
    let mut lines: Vec[i64] = Vec.new();
    lines.push(0);
    let mut look = Tok { ty: "$end".to_string(), value: V.Nil, lineno: 0, lexpos: 0 };
    let mut have_look = false;
    let mut state = 0;
    loop {
        let mut t = 0;
        let mut found = false;
        if tables.has_default[state] {
            t = tables.defaulted[state];
            found = true;
        } else {
            if not have_look {
                look = match lx.token(states)? {
                    Some(tok) => tok,
                    None => Tok { ty: "$end".to_string(), value: V.Nil, lineno: 0, lexpos: 0 },
                };
                have_look = true;
            }
            if let Some(a) = lookup(tables.actions[state], look.ty) {
                t = a;
                found = true;
            }
        }
        if not found {
            return Err(p_error(tables, state, look));
        }
        if t > 0 {
            stack.push(t);
            state = t;
            vals.push(look.value.clone());
            lines.push(look.lineno);
            have_look = false;
            continue;
        }
        if t == 0 {
            return Ok(vals[vals.len() - 1].clone());
        }
        let prod = ref tables.prods[-t];
        let n = prod.len;
        let base = vals.len() - n;
        let mut args: Vec[V] = Vec.new();
        args.push(V.Nil);
        let mut i = base;
        while i < vals.len() {
            args.push(vals[i].clone());
            i += 1;
        }
        let line1 = if n > 0 { lines[base] } else { 0 };
        vals.truncate(base);
        lines.truncate(base);
        let result = act(mut h, prod.code, args, line1)?;
        stack.truncate(stack.len() - n);
        let top = stack[stack.len() - 1];
        state = lookup(tables.gotos[top], prod.name).unwrap_or(0);
        stack.push(state);
        vals.push(result);
        lines.push(0);
    }
}

// ------------------------------------------------------ objectlist_flat

fn setitem(h: mut ref Heap, target: ref V, key: own V, val: own V) -> Result[(), Exc] {
    match target {
        V.Dict(id) => {
            h.set(id, key, val);
            Ok(())
        }
        V.List(_) => Err(type_error(f"list indices must be integers or slices, not {type_name(key)}")),
        _ => Err(type_error(f"'{type_name(target)}' object does not support item assignment")),
    }
}

fn pair_of(item: ref V) -> Result[(V, V), Exc] {
    match item {
        V.Tuple(xs) => {
            if xs.len() == 2 {
                return Ok((xs[0].clone(), xs[1].clone()));
            }
            if xs.len() > 2 {
                return Err(exc("ValueError", "too many values to unpack (expected 2)".to_string()));
            }
            Err(exc("ValueError", f"not enough values to unpack (expected 2, got {xs.len()})"))
        }
        _ => Err(type_error(f"cannot unpack non-iterable {type_name(item)} object")),
    }
}

// HclParser.objectlist_flat: dict(lt), with pyhcl's own rules for a key
// seen again.
fn objectlist_flat(h: mut ref Heap, lt: ref V, replace: bool) -> Result[V, Exc] {
    let d = h.new_dict();
    let items = match lt {
        V.List(id) => h.lists[id].clone(),
        _ => Vec.new(),
    };
    for item in items {
        let (k, v) = pair_of(item)?;
        let at = h.find(d, k);
        if at >= 0 and not replace {
            let cur = h.dicts[d][at].val.clone();
            if let V.List(id) = cur {
                h.lists[id].push(v);
            } else {
                let both = h.list_of(two(cur, v));
                h.dicts[d][at].val = both;
            }
            continue;
        }
        let vid = match v {
            V.Dict(id) => id,
            _ => {
                h.set(d, k, v);
                continue;
            }
        };
        // dd = d.setdefault(k, {})
        let dd = if at >= 0 {
            h.dicts[d][at].val.clone()
        } else {
            let nd = V.Dict(h.new_dict());
            h.set(d, k.clone(), nd.clone());
            nd
        };
        let inner = h.dicts[vid].clone();
        for e in inner {
            if let V.List(lid) = dd {
                let one_item = h.dict_with(e.key.clone(), e.val.clone());
                h.lists[lid].push(one_item);
                continue;
            }
            let ddid = match dd {
                V.Dict(id) => id,
                _ => return Err(exc("AttributeError", f"'{type_name(dd)}' object has no attribute 'keys'")),
            };
            let at2 = h.find(ddid, e.key);
            if at2 < 0 {
                h.set(ddid, e.key.clone(), e.val.clone());
                continue;
            }
            if let V.Dict(vvid) = e.val {
                let more = h.dicts[vvid].clone();
                for e2 in more {
                    let target = h.dicts[ddid][h.find(ddid, e.key)].val.clone();
                    setitem(mut h, target, e2.key.clone(), e2.val.clone())?;
                }
            } else {
                let pair = h.dict_with(e.key.clone(), e.val.clone());
                let both = h.list_of(two(dd.clone(), pair));
                h.set(d, k.clone(), both);
            }
        }
    }
    Ok(V.Dict(d))
}

// ------------------------------------------------------------- flatten

fn is_numeric_str(t: ref Vec[i64]) -> bool {
    if t.len() == 0 {
        return false;
    }
    for c in t {
        let ok = match as_char(c) {
            Some(ch) => ch.is_numeric(),
            None => false,
        };
        if not ok {
            return false;
        }
    }
    true
}

fn join_flat(h: mut ref Heap, items: ref Vec[V], sep: i64) -> Result[Vec[i64], Exc] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < items.len() {
        if i > 0 {
            out.push(sep);
        }
        let part = flatten(mut h, items[i])?;
        push_all(mut out, part);
        i += 1;
    }
    Ok(out)
}

// HclParser.flatten: a function's arguments back as text.
fn flatten(h: mut ref Heap, value: ref V) -> Result[Vec[i64], Exc] {
    match value {
        V.Dict(id) => {
            let items = h.dicts[id].clone();
            let mut out: Vec[i64] = Vec.new();
            out.push(123);
            let mut i = 0;
            while i < items.len() {
                if i > 0 {
                    out.push(44);
                }
                let head = py_add(mut h, items[i].key, s(":"))?;
                let rest = flatten(mut h, items[i].val)?;
                if let V.Str(t) = head {
                    push_all(mut out, t);
                }
                push_all(mut out, rest);
                i += 1;
            }
            out.push(125);
            Ok(out)
        }
        V.List(id) => {
            let items = h.lists[id].clone();
            join_flat(mut h, items, 44)
        }
        V.Tuple(items) => join_flat(mut h, items, 32),
        V.Str(t) => {
            if is_numeric_str(t) {
                return Ok(t.clone());
            }
            let sign = t.len() == 1 and (t[0] == 43 or t[0] == 45);
            let mut dotted = false;
            for c in t {
                if c == 46 {
                    dotted = true;
                }
            }
            if sign or dotted {
                return Ok(t.clone());
            }
            let mut out: Vec[i64] = Vec.new();
            out.push(34);
            push_all(mut out, t);
            out.push(34);
            Ok(out)
        }
        _ => {
            let shown = repr_of(py_str(h, value));
            Err(type_error(f"('%s is of type %s; expected type of dict, list, tuple, or str', {shown}, <class '{type_name(value)}'>)"))
        }
    }
}

// ---------------------------------------------------------------- json

fn from_json(h: mut ref Heap, j: ref J) -> V {
    match j {
        J.Null => V.Nil,
        J.Bool(b) => V.Bool(b),
        J.Int(digits) => V.Int(int_of(digits)),
        J.Float(x) => V.Float(x),
        J.Str(t) => V.Str(t.clone()),
        J.Arr(items) => {
            let mut out: Vec[V] = Vec.new();
            for x in items {
                out.push(from_json(mut h, x));
            }
            h.list_of(out)
        }
        J.Obj(members) => {
            let d = h.new_dict();
            for m in members {
                let val = from_json(mut h, m.val);
                h.set(d, V.Str(m.key.clone()), val);
            }
            V.Dict(d)
        }
    }
}

fn push_u_escape(out: mut ref Vec[i64], cp: i64) {
    push_ascii(mut out, "\\u");
    push_ascii(mut out, hex4(cp));
}

// encode_basestring_ascii.
fn encode_str(t: ref Vec[i64], out: mut ref Vec[i64]) {
    out.push(34);
    for c in t {
        if c == 34 {
            push_ascii(mut out, "\\\"");
        } else if c == 92 {
            push_ascii(mut out, "\\\\");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 8 {
            push_ascii(mut out, "\\b");
        } else if c == 12 {
            push_ascii(mut out, "\\f");
        } else if c < 0x20 {
            push_u_escape(mut out, c);
        } else if c <= 0x7E {
            out.push(c);
        } else if c >= 0x10000 {
            let n = c - 0x10000;
            push_u_escape(mut out, 0xD800 | ((n >> 10) & 0x3FF));
            push_u_escape(mut out, 0xDC00 | (n & 0x3FF));
        } else {
            push_u_escape(mut out, c);
        }
    }
    out.push(34);
}

fn float_json(x: f64) -> String {
    if x != x {
        "NaN".to_string()
    } else if x == 1.0 / 0.0 {
        "Infinity".to_string()
    } else if x == -1.0 / 0.0 {
        "-Infinity".to_string()
    } else {
        f"{x}"
    }
}

// a < b for dict keys, as sorted() compares them: a TypeError between
// kinds that do not order.
fn key_lt(a: ref V, b: ref V) -> Result[bool, Exc] {
    match a {
        V.Str(x) => {
            if let V.Str(y) = b {
                return Ok(cmp_cps(x, y) < 0);
            }
        }
        V.Tuple(x) => {
            if let V.Tuple(y) = b {
                let mut i = 0;
                while i < x.len() and i < y.len() {
                    if not key_eq(x[i], y[i]) {
                        return key_lt(x[i], y[i]);
                    }
                    i += 1;
                }
                return Ok(x.len() < y.len());
            }
        }
        _ => {
            if let Some(x) = num_of(a) {
                if let Some(y) = num_of(b) {
                    return Ok(x < y);
                }
            }
        }
    }
    Err(type_error(f"'<' not supported between instances of '{type_name(a)}' and '{type_name(b)}'"))
}

// sorted(items): the binary insertion sort CPython runs on a short list.
fn sorted_items(items: ref Vec[Pair]) -> Result[Vec[Pair], Exc] {
    let mut out: Vec[Pair] = Vec.new();
    for it in items {
        let mut lo = 0;
        let mut hi = out.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if key_lt(it.key, out[mid].key)? {
                hi = mid;
            } else {
                lo = mid + 1;
            }
        }
        out.insert(lo, it.clone());
    }
    Ok(out)
}

fn sorted_keys(items: ref Vec[Pair]) -> Result[Vec[V], Exc] {
    let mut out: Vec[V] = Vec.new();
    for it in sorted_items(items)? {
        out.push(it.key.clone());
    }
    Ok(out)
}

fn newline_indent(pretty: bool, level: i64, out: mut ref Vec[i64]) {
    if pretty {
        out.push(10);
        let mut k = 0;
        while k < level * 4 {
            out.push(32);
            k += 1;
        }
    }
}

fn encode_seq(h: ref Heap, items: ref Vec[V], pretty: bool, level: i64, out: mut ref Vec[i64]) -> Result[(), Exc] {
    if items.len() == 0 {
        push_ascii(mut out, "[]");
        return Ok(());
    }
    out.push(91);
    newline_indent(pretty, level + 1, mut out);
    let mut i = 0;
    while i < items.len() {
        if i > 0 {
            push_ascii(mut out, if pretty { "," } else { ", " });
            newline_indent(pretty, level + 1, mut out);
        }
        encode(h, items[i], pretty, level + 1, mut out)?;
        i += 1;
    }
    newline_indent(pretty, level, mut out);
    out.push(93);
    Ok(())
}

// json.dumps(v, sort_keys=True), with hcltool's indent when `pretty`.
fn encode(h: ref Heap, v: ref V, pretty: bool, level: i64, out: mut ref Vec[i64]) -> Result[(), Exc] {
    match v {
        V.Nil => push_ascii(mut out, "null"),
        V.Bool(b) => push_ascii(mut out, if b { "true" } else { "false" }),
        V.Int(n) => push_int(mut out, n),
        V.Float(x) => push_ascii(mut out, float_json(x)),
        V.Str(t) => encode_str(t, mut out),
        V.Tuple(items) => encode_seq(h, items, pretty, level, mut out)?,
        V.List(id) => encode_seq(h, h.lists[id], pretty, level, mut out)?,
        V.Dict(id) => {
            if h.dicts[id].len() == 0 {
                push_ascii(mut out, "{}");
                return Ok(());
            }
            let items = sorted_items(h.dicts[id])?;
            out.push(123);
            newline_indent(pretty, level + 1, mut out);
            let mut i = 0;
            while i < items.len() {
                if i > 0 {
                    push_ascii(mut out, if pretty { "," } else { ", " });
                    newline_indent(pretty, level + 1, mut out);
                }
                match items[i].key {
                    V.Str(t) => encode_str(t, mut out),
                    V.Tuple(_) | V.List(_) | V.Dict(_) => return Err(type_error(f"keys must be str, int, float, bool or None, not {type_name(items[i].key)}")),
                    V.Nil => encode_str(codepoints("null".bytes()), mut out),
                    V.Bool(b) => encode_str(codepoints((if b { "true" } else { "false" }).bytes()), mut out),
                    V.Int(n) => encode_str(codepoints(f"{n}".bytes()), mut out),
                    V.Float(x) => encode_str(codepoints(float_json(x).bytes()), mut out),
                }
                push_ascii(mut out, ": ");
                encode(h, items[i].val, pretty, level + 1, mut out)?;
                i += 1;
            }
            newline_indent(pretty, level, mut out);
            out.push(125);
        }
    }
    Ok(())
}

fn dumps(h: ref Heap, v: ref V, pretty: bool) -> Result[String, Exc] {
    let mut out: Vec[i64] = Vec.new();
    encode(h, v, pretty, 0, mut out)?;
    Ok(to_string(out))
}

// ------------------------------------------------------------- loads

struct Hcl {
    lex: Vec[LexState],
    tables: Tables,
}

// hcl.loads: JSON when the first character that is not space is '{'.
fn loads(h: mut ref Heap, hcl: ref Hcl, text: ref Vec[i64], mode: ref String) -> Result[V, Exc] {
    let mut first = -1;
    for c in text {
        if not is_space(c, false) {
            first = c;
            break;
        }
    }
    if text.len() > 0 and first == -1 {
        return Err(exc("ValueError", "No HCL object could be decoded".to_string()));
    }
    if first == 123 {
        let j = json_loads(text)?;
        return Ok(from_json(mut h, j));
    }
    parse_hcl(mut h, hcl.tables, hcl.lex, text, mode)
}

// ------------------------------------------------------------- reports

fn get(h: ref Heap, v: ref V, key: Str) -> Option[V] {
    if let V.Dict(id) = v {
        let k = s(key);
        let at = h.find(id, k);
        if at >= 0 {
            return Some(h.dicts[id][at].val.clone());
        }
    }
    None
}

fn get_or(h: ref Heap, v: ref V, key: Str, default: own V) -> V {
    match get(h, v, key) {
        Some(x) => x,
        None => default,
    }
}

// The oracle's entries(): a block HCL repeated decodes to a list of dicts.
fn entries(h: ref Heap, v: ref V, out: mut ref Vec[Pair]) {
    match v {
        V.Dict(id) => {
            for it in h.dicts[id].iter() {
                out.push(it.clone());
            }
        }
        V.List(id) => {
            for x in h.lists[id].iter() {
                entries(h, x, mut out);
            }
        }
        _ => {}
    }
}

fn entries_of(h: ref Heap, v: ref Option[V]) -> Vec[Pair] {
    let mut out: Vec[Pair] = Vec.new();
    if let Some(x) = v {
        entries(h, x, mut out);
    }
    out
}

fn text_of(h: ref Heap, v: ref V) -> String {
    to_string(py_str(h, v))
}

fn opt_text(h: ref Heap, v: ref Option[V]) -> String {
    match v {
        Some(x) => text_of(h, x),
        None => "None".to_string(),
    }
}

fn compact(h: ref Heap, v: ref Option[V]) -> Result[String, Exc] {
    match v {
        Some(x) => dumps(h, x, false),
        None => Ok("null".to_string()),
    }
}

// "%d" % v
fn fmt_d(v: ref V) -> Result[i64, Exc] {
    match v {
        V.Int(n) => Ok(n),
        V.Bool(b) => Ok(if b { 1 } else { 0 }),
        V.Float(x) => Ok(x as i64),
        _ => Err(type_error(f"%d format: a real number is required, not {type_name(v)}")),
    }
}

// sep.join(v), for a list of str (or a str, joined by character).
fn join_strs(h: ref Heap, v: ref V, sep: Str) -> Result[String, Exc] {
    let mut parts: Vec[String] = Vec.new();
    match v {
        V.List(id) => {
            let mut i = 0;
            for x in h.lists[id].iter() {
                match x {
                    V.Str(t) => parts.push(to_string(t)),
                    _ => return Err(type_error(f"sequence item {i}: expected str instance, {type_name(x)} found")),
                }
                i += 1;
            }
        }
        V.Tuple(items) => {
            let mut i = 0;
            for x in items {
                match x {
                    V.Str(t) => parts.push(to_string(t)),
                    _ => return Err(type_error(f"sequence item {i}: expected str instance, {type_name(x)} found")),
                }
                i += 1;
            }
        }
        V.Str(t) => {
            for c in t {
                parts.push(to_string(one_cp(c)));
            }
        }
        _ => return Err(type_error(f"can only join an iterable")),
    }
    Ok(parts.join(sep))
}

fn one_cp(c: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(c);
    v
}

struct DataFile {
    path: String,
    body: String,
}

fn read_cps(name: ref String) -> Result[Vec[i64], Exc] {
    match fs.read_to_string(f"data/{name}") {
        Ok(t) => Ok(codepoints(t.bytes())),
        Err(e) => Err(exc("FileNotFoundError", f"{e}")),
    }
}

fn terraform(hcl: ref Hcl, dir: ref String, names: ref Vec[String], out: mut ref String) -> Result[(), Exc] {
    let mut h = new_heap();
    for name in names {
        out.push_str(f"  {name}:\n");
        let cfg = match loads(mut h, hcl, read_cps(f"{dir}/{name}")?, "") {
            Ok(v) => v,
            Err(e) => {
                out.push_str(f"    ! {e.kind}: {e.msg}\n");
                continue;
            }
        };
        if let Some(tf) = get(h, cfg, "terraform") {
            out.push_str(f"    terraform {dumps(h, tf, false)?}\n");
        }
        for e in entries_of(h, get(h, cfg, "provider")) {
            out.push_str(f"    provider {text_of(h, e.key)} {dumps(h, e.val, false)?}\n");
        }
        for e in entries_of(h, get(h, cfg, "variable")) {
            let default = get(h, e.val, "default");
            let shown = match default {
                Some(x) => dumps(h, x, false)?,
                None => "-".to_string(),
            };
            let mut line = f"    variable {text_of(h, e.key)} default={shown}";
            if let Some(t) = get(h, e.val, "type") {
                line.push_str(f" type={text_of(h, t)}");
            }
            if let Some(d) = get(h, e.val, "description") {
                line.push_str(f" ({text_of(h, d)})");
            }
            out.push_str(f"{line}\n");
        }
        for section in ["data", "resource"] {
            for e in entries_of(h, get(h, cfg, section)) {
                for r in entries_of(h, Some(e.val.clone())) {
                    let keys = match r.val {
                        V.Dict(id) => sorted_keys(h.dicts[id])?,
                        _ => Vec.new(),
                    };
                    let shown = join_strs(h, V.Tuple(keys), ", ")?;
                    out.push_str(f"    {section} {text_of(h, e.key)}.{text_of(h, r.key)}: {shown}\n");
                }
            }
        }
        for e in entries_of(h, get(h, cfg, "module")) {
            let version = get_or(h, e.val, "version", s("-"));
            out.push_str(f"    module {text_of(h, e.key)} source={opt_text(h, get(h, e.val, "source"))} version={text_of(h, version)}\n");
        }
        for e in entries_of(h, get(h, cfg, "output")) {
            let sensitive = get_or(h, e.val, "sensitive", V.Bool(false));
            out.push_str(f"    output {text_of(h, e.key)} sensitive={text_of(h, sensitive)} value={compact(h, get(h, e.val, "value"))?}\n");
        }
    }
    Ok(())
}

// `x in container`, for the capabilities of a rule.
fn contains(h: ref Heap, container: ref V, x: ref Vec[i64]) -> Result[bool, Exc] {
    match container {
        V.List(id) => {
            for e in h.lists[id].iter() {
                if let V.Str(t) = e {
                    if same(t, x) {
                        return Ok(true);
                    }
                }
            }
            Ok(false)
        }
        V.Tuple(items) => {
            for e in items {
                if let V.Str(t) = e {
                    if same(t, x) {
                        return Ok(true);
                    }
                }
            }
            Ok(false)
        }
        V.Str(t) => {
            if x.len() > t.len() {
                return Ok(false);
            }
            let mut i = 0;
            while i + x.len() <= t.len() {
                if same(slice(t, i, i + x.len()), x) {
                    return Ok(true);
                }
                i += 1;
            }
            Ok(false)
        }
        V.Dict(id) => Ok(h.find(id, V.Str(x.clone())) >= 0),
        _ => Err(type_error(f"argument of type '{type_name(container)}' is not iterable")),
    }
}

fn vault(hcl: ref Hcl, name: ref String, checks: ref Vec[String], out: mut ref String) -> Result[(), Exc] {
    let mut h = new_heap();
    let policy = loads(mut h, hcl, read_cps(name)?, "")?;
    if let V.Dict(_) = policy {
    } else {
        return Err(exc("AttributeError", f"'{type_name(policy)}' object has no attribute 'get'"));
    }
    // dict(entries(...)): a path given again keeps its place, takes the last rule
    let rd = h.new_dict();
    for e in entries_of(h, get(h, policy, "path")) {
        h.set(rd, e.key.clone(), e.val.clone());
    }
    let rules = h.dicts[rd].clone();
    for check in checks {
        let c = codepoints(check.bytes());
        let mut colon = 0;
        while colon < c.len() and c[colon] != 58 {
            colon += 1;
        }
        let op = to_string(slice(c, 0, colon));
        let path = pyslice(c, colon + 1, c.len());
        let mut rule = -1;
        let mut i = 0;
        while i < rules.len() {
            if let V.Str(p) = rules[i].key {
                if same(p, path) {
                    rule = i;
                }
            }
            i += 1;
        }
        if rule < 0 {
            let mut best = -1;
            i = 0;
            while i < rules.len() {
                let p = match rules[i].key {
                    V.Str(t) => t.clone(),
                    _ => return Err(exc("AttributeError", f"'{type_name(rules[i].key)}' object has no attribute 'endswith'")),
                };
                if p.len() > 0 and p[p.len() - 1] == 42 {
                    let stem = slice(p, 0, p.len() - 1);
                    if stem.len() <= path.len() and same(slice(path, 0, stem.len()), stem) {
                        if best < 0 or p.len() > best {
                            rule = i;
                            best = p.len();
                        }
                    }
                }
                i += 1;
            }
        }
        if rule < 0 {
            out.push_str(f"  {op} {to_string(path)}: denied (no rule)\n");
            continue;
        }
        let caps = get_or(h, rules[rule].val, "capabilities", V.Tuple(Vec.new()));
        let denied = contains(h, caps, codepoints("deny".bytes()))? or not contains(h, caps, codepoints(op.bytes()))?;
        let verdict = if denied { "denied" } else { "allowed" };
        let mut shown: Vec[i64] = Vec.new();
        if let V.Str(t) = rules[rule].key {
            encode_str(t, mut shown);
        }
        out.push_str(f"  {op} {to_string(path)}: {verdict} by {to_string(shown)}\n");
    }
    Ok(())
}

fn nomad(hcl: ref Hcl, name: ref String, out: mut ref String) -> Result[(), Exc] {
    let mut h = new_heap();
    let spec = loads(mut h, hcl, read_cps(name)?, "")?;
    for j in entries_of(h, get(h, spec, "job")) {
        let dcs = get_or(h, j.val, "datacenters", V.Tuple(Vec.new()));
        out.push_str(f"  job {text_of(h, j.key)} type={opt_text(h, get(h, j.val, "type"))} priority={opt_text(h, get(h, j.val, "priority"))} datacenters={join_strs(h, dcs, ",")?}\n");
        let mut total_cpu = V.Int(0);
        let mut total_mem = V.Int(0);
        for g in entries_of(h, get(h, j.val, "group")) {
            let count = get_or(h, g.val, "count", V.Int(1));
            out.push_str(f"    group {text_of(h, g.key)} count={fmt_d(count)?}\n");
            for t in entries_of(h, get(h, g.val, "task")) {
                let res = get_or(h, t.val, "resources", V.Nil);
                let cpu = get_or(h, res, "cpu", V.Int(100));
                let mem = get_or(h, res, "memory", V.Int(300));
                total_cpu = py_add(mut h, total_cpu, arith(42, cpu, count)?)?;
                total_mem = py_add(mut h, total_mem, arith(42, mem, count)?)?;
                out.push_str(f"      task {text_of(h, t.key)} driver={opt_text(h, get(h, t.val, "driver"))} cpu={fmt_d(cpu)?} memory={fmt_d(mem)?} config={compact(h, get(h, t.val, "config"))?}\n");
                if let Some(env) = get(h, t.val, "env") {
                    out.push_str(f"        env {dumps(h, env, false)?}\n");
                }
            }
        }
        out.push_str(f"    total cpu={fmt_d(total_cpu)?} memory={fmt_d(total_mem)?}\n");
    }
    Ok(())
}

fn consul(hcl: ref Hcl, name: ref String, out: mut ref String) -> Result[(), Exc] {
    let mut h = new_heap();
    let cfg = loads(mut h, hcl, read_cps(name)?, "")?;
    let id = match cfg {
        V.Dict(id) => id,
        _ => return Ok(()),
    };
    let items = sorted_items(h.dicts[id])?;
    for it in items {
        out.push_str(f"  {text_of(h, it.key)}: {type_name(it.val)} {dumps(h, it.val, false)?}\n");
    }
    Ok(())
}

fn tokens(hcl: ref Hcl, name: ref String, mode: ref String, out: mut ref String) -> Result[(), Exc] {
    let h = new_heap();
    let text = read_cps(name)?;
    let mut lx = new_lexer(hcl.lex, text, mode)?;
    loop {
        match lx.token(hcl.lex)? {
            Some(tok) => out.push_str(f"  {tok.ty} {to_string(py_repr(h, tok.value))} line {tok.lineno} at {tok.lexpos}\n"),
            None => break,
        }
    }
    Ok(())
}

fn run(hcl: ref Hcl, files: ref Vec[DataFile], job: ref Vec[String], out: mut ref String) -> Result[(), Exc] {
    let kind = job[0].clone();
    let mode = if job.len() > 2 { job[2].clone() } else { String.new() };
    if kind == "load" {
        let mut h = new_heap();
        let v = loads(mut h, hcl, read_cps(job[1])?, mode)?;
        out.push_str(dumps(h, v, true)?);
        out.push_str("\n");
    } else if kind == "tokens" {
        tokens(hcl, job[1], mode, mut out)?;
    } else if kind == "terraform" {
        // os.listdir, sorted, keeping the Terraform files
        let mut prefix = codepoints(job[1].bytes());
        prefix.push(47);
        let mut names: Vec[String] = Vec.new();
        for f in files {
            let path = codepoints(f.path.bytes());
            if path.len() > prefix.len() and same(slice(path, 0, prefix.len()), prefix) {
                let rest = slice(path, prefix.len(), path.len());
                let nested = count_of(rest, 47) > 0;
                let tf = ends_with(rest, codepoints(".tf".bytes())) or ends_with(rest, codepoints(".tf.json".bytes()));
                if not nested and tf {
                    names.push(to_string(rest));
                }
            }
        }
        terraform(hcl, job[1], names, mut out)?;
    } else if kind == "vault" {
        let mut checks: Vec[String] = Vec.new();
        let mut k = 2;
        while k < job.len() {
            checks.push(job[k].clone());
            k += 1;
        }
        vault(hcl, job[1], checks, mut out)?;
    } else if kind == "nomad" {
        nomad(hcl, job[1], mut out)?;
    } else if kind == "consul" {
        consul(hcl, job[1], mut out)?;
    }
    Ok(())
}

// -------------------------------------------------------------- files

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn main() {
    let files = data_files();
    for file in files.iter() {
        if let Err(e) = make_parent(file.path) {
            eprintln(e);
            return;
        }
        if let Err(e) = fs.write(f"data/{file.path}", file.body.clone()) {
            eprintln(f"cannot write {file.path}: {e}");
            return;
        }
    }
    let hcl = Hcl { lex: read_lex(lex_tables()), tables: read_tables(parse_tables()) };
    let jobs = match fs.read_to_string("data/jobs.tsv".to_string()) {
        Ok(t) => t,
        Err(e) => {
            eprintln(f"cannot read jobs.tsv: {e}");
            return;
        }
    };
    for line in jobs.split("\n") {
        if line.len() == 0 {
            continue;
        }
        let job: Vec[String] = line.split("\t").map(|p| p.to_string()).collect();
        println(f"-- {job.join(" ")}");
        let mut out = String.new();
        let result = run(hcl, files, job, mut out);
        print(out);
        if let Err(e) = result {
            println(f"! {e.kind}: {e.msg}");
        }
    }
}

fn in_firsts(set: ref Vec[i64], c: i64) -> bool {
    for x in set {
        if x == c {
            return true;
        }
    }
    false
}

fn ascii_string(t: ref Vec[i64], start: i64, end: i64) -> String {
    to_string(slice(t, start, end))
}

// ------------------------------------------------------------ generated

// PLY's lexer for each state: S name, flags, ignored characters, error
// and eof functions; X the master regex; I a group and its rule.
fn lex_tables() -> String {
    let mut t = String.new();
    lex_tables_part_0(mut t);
    t
}

// PLY's LALR tables: productions, actions, gotos, defaulted states.
fn parse_tables() -> String {
    let mut t = String.new();
    parse_tables_part_0(mut t);
    parse_tables_part_1(mut t);
    parse_tables_part_2(mut t);
    t
}

