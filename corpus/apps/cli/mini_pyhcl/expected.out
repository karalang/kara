-- load infra/consul/agent.hcl
{
    "acl": {
        "default_policy": "deny",
        "enabled": true,
        "tokens": {
            "agent": "00000000-0000-0000-0000-000000000000"
        }
    },
    "bootstrap_expect": 3,
    "data_dir": "/opt/consul",
    "datacenter": "eu-west-1",
    "limits": {
        "http_max_conns_per_client": 200,
        "rpc_max_burst": 1500.0,
        "rpc_rate": 1000.0
    },
    "log_level": "INFO",
    "performance": {
        "raft_multiplier": 1
    },
    "ports": {
        "grpc": 8502,
        "https": -1
    },
    "retry_join": [
        "provider=aws tag_key=consul tag_value=server"
    ],
    "server": true,
    "telemetry": {
        "disable_hostname": true,
        "prometheus_retention_time": "24h"
    },
    "ui_config": {
        "enabled": true
    }
}
-- load infra/nomad/web.nomad
{
    "job": {
        "web": {
            "datacenters": [
                "eu-west-1a",
                "eu-west-1b"
            ],
            "group": [
                {
                    "frontend": {
                        "count": 3,
                        "task": [
                            {
                                "nginx": {
                                    "config": {
                                        "image": "nginx:1.25",
                                        "port_map": {
                                            "http": 80
                                        }
                                    },
                                    "driver": "docker",
                                    "resources": {
                                        "cpu": 500,
                                        "memory": 256
                                    }
                                }
                            },
                            {
                                "log-shipper": {
                                    "config": {
                                        "image": "timberio/vector:0.34.1-alpine"
                                    },
                                    "driver": "docker",
                                    "resources": {
                                        "cpu": 100,
                                        "memory": 64
                                    }
                                }
                            }
                        ]
                    }
                },
                {
                    "api": {
                        "count": 2,
                        "task": {
                            "orders": {
                                "config": {
                                    "args": [
                                        "--port",
                                        "${NOMAD_PORT_http}",
                                        "--db",
                                        "orders.service.consul"
                                    ],
                                    "command": "/usr/local/bin/orders"
                                },
                                "driver": "exec",
                                "env": {
                                    "RUST_LOG": "info",
                                    "WORKERS": 4
                                },
                                "resources": {
                                    "cpu": 1000,
                                    "memory": 512
                                }
                            }
                        }
                    }
                }
            ],
            "priority": 60,
            "type": "service",
            "update": {
                "healthy_deadline": "3m",
                "max_parallel": 1,
                "min_healthy_time": "10s"
            }
        }
    }
}
-- load infra/packer/base.pkr.hcl
{
    "build": {
        "provisioner": [
            {
                "shell": {
                    "inline": [
                        "sudo apt-get update",
                        "sudo apt-get install -y unattended-upgrades"
                    ]
                }
            },
            {
                "file": {
                    "destination": "/tmp/motd",
                    "source": "files/motd"
                }
            }
        ],
        "sources": [
            "source.amazon-ebs.base"
        ]
    },
    "source": {
        "amazon-ebs": {
            "base": {
                "ami_name": "shop-base-{{timestamp}}",
                "instance_type": "t3.micro",
                "region": "${var.aws_region}",
                "ssh_username": "ubuntu"
            }
        }
    },
    "variable": {
        "aws_region": {
            "default": "eu-west-1",
            "type": "string"
        }
    }
}
-- load infra/terraform/main.tf
{
    "data": {
        "aws_ami": {
            "ubuntu": {
                "filter": {
                    "name": "name",
                    "values": [
                        "ubuntu/images/hvm-ssd/ubuntu-focal-20.04-amd64-server-*"
                    ]
                },
                "most_recent": true,
                "owners": [
                    "099720109477"
                ]
            }
        }
    },
    "module": {
        "dns": {
            "source": "./modules/dns",
            "zone": "shop.example"
        },
        "vpc": {
            "azs": [
                "eu-west-1a",
                "eu-west-1b"
            ],
            "cidr": "10.0.0.0/16",
            "name": "shop",
            "public_subnets": [
                "10.0.1.0/24",
                "10.0.2.0/24"
            ],
            "source": "terraform-aws-modules/vpc/aws",
            "version": "2.78.0"
        }
    },
    "provider": {
        "aws": {
            "alias": "us",
            "region": "us-east-1",
            "version": "~> 2.70"
        }
    },
    "resource": {
        "aws_db_instance": {
            "orders": {
                "allocated_storage": 50,
                "backup_retention_period": 7,
                "engine": "postgres",
                "engine_version": "11.9",
                "instance_class": "db.t3.medium",
                "max_allocated_storage": 200,
                "multi_az": false,
                "name": "orders",
                "password": "${var.db_password}",
                "username": "shop"
            }
        },
        "aws_instance": {
            "web": {
                "ami": "${data.aws_ami.ubuntu.id}",
                "count": "${var.instance_count}",
                "instance_type": "${var.instance_type}",
                "lifecycle": {
                    "create_before_destroy": true
                },
                "root_block_device": {
                    "volume_size": 20,
                    "volume_type": "gp2"
                },
                "subnet_id": "${element(module.vpc.public_subnets, count.index)}",
                "tags": "${merge(var.tags, map(\"Name\", \"web-${count.index + 1}\"))}",
                "user_data": "#!/bin/sh\napt-get update\napt-get install -y nginx\necho \"web ${count.index}\" > /var/www/html/index.html"
            }
        },
        "aws_lb": {
            "web": {
                "idle_timeout": 60,
                "load_balancer_type": "application",
                "name": "shop-web",
                "subnets": [
                    "${module.vpc.public_subnets}"
                ]
            }
        },
        "aws_lb_target_group": {
            "web": {
                "health_check": {
                    "healthy_threshold": 2,
                    "interval": 15,
                    "path": "/healthz",
                    "unhealthy_threshold": 3
                },
                "name": "shop-web",
                "port": 80,
                "protocol": "HTTP",
                "vpc_id": "${module.vpc.vpc_id}"
            }
        },
        "aws_security_group": {
            "web": {
                "egress": {
                    "cidr_blocks": [
                        "0.0.0.0/0"
                    ],
                    "from_port": 0,
                    "protocol": "-1",
                    "to_port": 0
                },
                "ingress": [
                    {
                        "cidr_blocks": [
                            "0.0.0.0/0"
                        ],
                        "from_port": 443,
                        "protocol": "tcp",
                        "to_port": 443
                    },
                    {
                        "cidr_blocks": [
                            "0.0.0.0/0"
                        ],
                        "from_port": 80,
                        "protocol": "tcp",
                        "to_port": 80
                    }
                ],
                "name": "shop-web"
            }
        }
    },
    "terraform": {
        "backend": {
            "s3": {
                "bucket": "shop-terraform-state",
                "key": "web/terraform.tfstate",
                "region": "eu-west-1"
            }
        },
        "required_version": ">= 0.11.0"
    }
}
-- load infra/terraform/main.tf.json
{
    "output": {
        "assets_bucket": {
            "value": "${aws_s3_bucket.assets.id}"
        }
    },
    "resource": {
        "aws_s3_bucket": {
            "assets": {
