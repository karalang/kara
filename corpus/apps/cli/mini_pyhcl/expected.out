-- terraform infra/terraform
  main.tf:
    terraform {"backend": {"s3": {"bucket": "shop-terraform-state", "key": "web/terraform.tfstate", "region": "eu-west-1"}}, "required_version": ">= 0.11.0"}
    provider aws {"alias": "us", "region": "us-east-1", "version": "~> 2.70"}
    data aws_ami.ubuntu: filter, most_recent, owners
    resource aws_instance.web: ami, count, instance_type, lifecycle, root_block_device, subnet_id, tags, user_data
    resource aws_lb.web: idle_timeout, load_balancer_type, name, subnets
    resource aws_lb_target_group.web: health_check, name, port, protocol, vpc_id
    resource aws_security_group.web: egress, ingress, name
    resource aws_db_instance.orders: allocated_storage, backup_retention_period, engine, engine_version, instance_class, max_allocated_storage, multi_az, name, password, username
    module vpc source=terraform-aws-modules/vpc/aws version=2.78.0
    module dns source=./modules/dns version=-
  main.tf.json:
    variable cdn_ttl default=3600.5 (seconds à la carte)
    resource aws_s3_bucket.assets: acl, bucket, lifecycle_rule, versioning
    output assets_bucket sensitive=False value="${aws_s3_bucket.assets.id}"
  outputs.tf:
    output lb_dns_name sensitive=False value="${aws_lb.web.dns_name}"
    output instance_ips sensitive=False value=["${aws_instance.web.*.private_ip}"]
    output db_endpoint sensitive=True value="${aws_db_instance.orders.endpoint}"
  variables.tf:
    variable region default="eu-west-1" (AWS region for every resource)
    variable instance_count default=3
    variable instance_type default="t3.small" type=string
    variable allowed_cidrs default=["10.0.0.0/16", "192.168.10.0/24"] type=list
    variable tags default={"billing": "shop-42", "team": "platform"} type=map
    variable db_password default=- (set from the CI secret store)
-- vault infra/vault/admin.hcl read:sys/health sudo:sys/rotate read:auth/token/root read:secret/data/payments/stripe update:secret/data/payments/stripe delete:secret/app/config read:other/path list:secret/
  read sys/health: allowed by "sys/*"
  sudo sys/rotate: allowed by "sys/*"
  read auth/token/root: denied by "auth/token/root"
  read secret/data/payments/stripe: allowed by "secret/data/payments/*"
  update secret/data/payments/stripe: denied by "secret/data/payments/*"
  delete secret/app/config: allowed by "secret/*"
  read other/path: denied (no rule)
  list secret/: allowed by "secret/*"
-- vault infra/vault/ci.hcl read:secret/data/ci/deploy-key read:secret/data/ci/prod-signing list:secret/metadata/ci/ update:auth/token/renew-self update:transit/encrypt/ci update:transit/encrypt/prod read:secret/data/cia
  read secret/data/ci/deploy-key: allowed by "secret/data/ci/*"
  read secret/data/ci/prod-signing: denied by "secret/data/ci/prod-signing"
  list secret/metadata/ci/: allowed by "secret/metadata/ci/*"
  update auth/token/renew-self: allowed by "auth/token/renew-self"
  update transit/encrypt/ci: allowed by "transit/encrypt/ci"
  update transit/encrypt/prod: denied (no rule)
  read secret/data/cia: denied (no rule)
-- nomad infra/nomad/web.nomad
  job web type=service priority=60 datacenters=eu-west-1a,eu-west-1b
    group frontend count=3
      task nginx driver=docker cpu=500 memory=256 config={"image": "nginx:1.25", "port_map": {"http": 80}}
      task log-shipper driver=docker cpu=100 memory=64 config={"image": "timberio/vector:0.34.1-alpine"}
    group api count=2
      task orders driver=exec cpu=1000 memory=512 config={"args": ["--port", "${NOMAD_PORT_http}", "--db", "orders.service.consul"], "command": "/usr/local/bin/orders"}
        env {"RUST_LOG": "info", "WORKERS": 4}
    total cpu=3800 memory=1984
-- consul infra/consul/agent.hcl
  acl: dict {"default_policy": "deny", "enabled": true, "tokens": {"agent": "00000000-0000-0000-0000-000000000000"}}
  bootstrap_expect: int 3
  data_dir: str "/opt/consul"
  datacenter: str "eu-west-1"
  limits: dict {"http_max_conns_per_client": 200, "rpc_max_burst": 1500.0, "rpc_rate": 1000.0}
  log_level: str "INFO"
  performance: dict {"raft_multiplier": 1}
  ports: dict {"grpc": 8502, "https": -1}
  retry_join: list ["provider=aws tag_key=consul tag_value=server"]
  server: bool true
  telemetry: dict {"disable_hostname": true, "prometheus_retention_time": "24h"}
  ui_config: dict {"enabled": true}
