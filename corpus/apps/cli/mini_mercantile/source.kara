    s.push_str("tile\t179.9\t-85.0\t6\n");
    s.push_str("quadkey\t486\t332\t10\n");
    s.push_str("quadkey\t0\t0\t1\n");
    s.push_str("quadkey\t1\t1\t1\n");
    s.push_str("quadkey\t8191\t8191\t14\n");
    s.push_str("quadkey\t0\t0\t0\n");
    s.push_str("quadkey\t35210\t21493\t16\n");
    s.push_str("qk2tile\t0313102310\n");
    s.push_str("qk2tile\t\n");
    s.push_str("qk2tile\t0\n");
    s.push_str("qk2tile\t3\n");
    s.push_str("qk2tile\t123\n");
    s.push_str("qk2tile\t0313102310300\n");
    s.push_str("qk2tile\t0312a\n");
    s.push_str("parent\t486\t332\t10\t-\n");
    s.push_str("parent\t0\t0\t2\t-\n");
