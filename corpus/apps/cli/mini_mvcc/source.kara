// mini_mvcc: a multi-version key-value store with transactions, the
// concurrency control under PostgreSQL, CockroachDB, Badger and etcd.
// Every commit adds a new version of each key it wrote, stamped with the
// commit time; a transaction reads the versions its snapshot can see, and
// at commit it is checked against what committed since its snapshot, by
// its isolation level: read committed, snapshot isolation or
// serializable. Commits go to a write-ahead log first, so a crash loses
// only the open transactions; recovery replays the log, drops a torn
// record at its end, and starts from the last checkpoint. Each session
// file is a script of interleaved transactions and runs as its own task.

// ------------------------------------------------------------ text

fn is_digits(s: Str) -> bool {
    s.len() > 0 and s.bytes().iter().all(|c| c >= b'0' and c <= b'9')
}

fn is_int(s: Str) -> bool {
    if s.starts_with("-") { is_digits(s.substring(1, s.len())) } else { is_digits(s) }
}

fn number(s: Str) -> i64 {
    i64.parse(s).unwrap_or(0)
}

fn plural(n: i64, word: Str) -> String {
    if n == 1 { f"1 {word}" } else { f"{n} {word}s" }
}

// FNV-1a, 32 bits: the checksum at the end of every log record.
fn fnv(b: Slice[u8]) -> i64 {
    let mut h: i64 = 0x811c9dc5;
    for c in b.iter() {
        h = h ^ (c as i64);
        h = (h * 0x01000193) % 4294967296;
    }
    h
}

// A log record: a header line, its body lines, and an end line with the
// checksum of everything before it.
fn record(header: Str, body: ref Vec[String]) -> String {
    let mut text = f"{header}\n";
    for l in body.iter() {
        text.push_str(l);
        text.push_str("\n");
    }
    let sum = fnv(text.bytes());
    text + f"end {sum:08x}\n"
}

fn show(v: ref Option[String]) -> String {
    match v {
        Some(s) => s.clone(),
        None => "-".to_string(),
    }
}

// ------------------------------------------------------------ the store

#[derive(Clone)]
struct Version {
    ts: i64,
    // The transaction that committed it.
    txn: String,
    // None is a delete.
    value: Option[String],
}

#[derive(Clone, PartialEq)]
enum Level {
    ReadCommitted,
    Snapshot,
    Serializable,
}

fn level_name(l: ref Level) -> Str {
    match l {
        Level.ReadCommitted => "rc",
        Level.Snapshot => "si",
        Level.Serializable => "ser",
    }
}

struct Txn {
    name: String,
    level: Level,
    read_ts: i64,
    // Buffered writes, applied at commit.
    writes: SortedMap[String, Option[String]],
    // Keys read from the store, and the prefixes scanned.
    reads: SortedSet[String],
    prefixes: SortedSet[String],
}

enum Record {
    Commit { ts: i64, txn: String, writes: Vec[(String, Option[String])] },
    Vacuum(i64),
}

struct Store {
    wal: String,
    snap: String,
    versions: Map[String, Vec[Version]],
    clock: i64,
    // Open transactions, in the order they began.
    txns: Vec[Txn],
    down: bool,
    commits: i64,
    aborts: i64,
    out: Vec[String],
}

fn file_size(path: Str) -> i64 {
    match fs.metadata(path) {
        Ok(m) => m.len,
        Err(_) => 0,
    }
}

impl Store {
    fn new(stem: Str) -> Result[Store, String] {
        let wal = f"data/run/{stem}.wal";
        let snap = f"data/run/{stem}.snap";
        for p in [wal.clone(), snap.clone(), snap + ".tmp"] {
            if fs.exists(p) and fs.remove_file(p).is_err() {
                return Err(f"cannot remove {p}");
            }
        }
        if fs.write_bytes(wal.clone(), Vec.new()).is_err() {
            return Err(f"cannot create {wal}");
        }
        Ok(Store {
            wal,
            snap,
            versions: Map.new(),
            clock: 0,
            txns: Vec.new(),
            down: false,
            commits: 0,
            aborts: 0,
            out: Vec.new(),
        })
    }

    fn sorted_keys(self) -> Vec[String] {
        let mut keys: Vec[String] = self.versions.keys().cloned().collect();
        keys.sort();
        keys
    }

    fn version_count(self) -> i64 {
        self.versions.values().map(|vs| vs.len()).sum()
    }

    // ---------------------------------------------------------- reading

    fn newest(self, key: Str) -> Option[Version] {
        match self.versions.get(key) {
            Some(vs) => vs.last().cloned(),
            None => None,
        }
    }

    // The value the newest version at or before ts holds.
    fn visible(self, key: Str, ts: i64) -> Option[String] {
        let vs = self.versions.get(key)?;
        for v in vs.iter().rev() {
            if v.ts <= ts {
                return v.value.clone();
            }
        }
        None
    }

    fn find(self, name: Str) -> Option[i64] {
        self.txns.iter().position(|t| t.name == name)
    }

    // A read committed transaction reads the latest commit at every
    // statement; the others read at their snapshot.
    fn snap_ts(self, i: i64) -> i64 {
        if self.txns[i].level == Level.ReadCommitted { self.clock } else { self.txns[i].read_ts }
    }

    fn read(mut ref self, i: i64, key: Str) -> Option[String] {
        if let Some(v) = self.txns[i].writes.get(key) {
            return v.clone();
        }
        let ts = self.snap_ts(i);
        self.txns[i].reads.insert(key.to_string());
        self.visible(key, ts)
    }

    fn range(mut ref self, i: i64, p: Str) -> Vec[(String, String)] {
        let ts = self.snap_ts(i);
        self.txns[i].prefixes.insert(p.to_string());
        let mut seen: SortedMap[String, String] = SortedMap.new();
        for k in self.versions.keys() {
            if k.starts_with(p) {
                if let Some(v) = self.visible(k, ts) {
                    seen.insert(k.clone(), v);
                }
            }
        }
        for (k, v) in self.txns[i].writes.iter() {
            if k.starts_with(p) {
                match v {
                    Some(s) => {
                        seen.insert(k.clone(), s.clone());
                    }
                    None => {
                        seen.remove(k);
                    }
                }
            }
        }
        seen.into_iter().collect()
    }

    // ---------------------------------------------------------- the log

    fn append(self, text: Str) -> Result[(), String] {
        let appended = match File.append(self.wal) {
            Ok(f) => f.write(text.bytes()),
            Err(e) => Err(e),
        };
        if appended.is_err() {
            return Err(f"cannot append to {self.wal}");
        }
        Ok(())
    }

    fn install(mut ref self, ts: i64, txn: Str, writes: ref Vec[(String, Option[String])]) {
        for (k, v) in writes.iter() {
            let version = Version { ts, txn: txn.to_string(), value: v.clone() };
            match self.versions.get_mut(k) {
                Some(vs) => vs.push(version),
                None => {
                    self.versions.insert(k.clone(), vec![version]);
                }
            }
        }
    }

    // Drops every version no snapshot at h or later can see: all but the
    // newest at or before h, and that one too when it is a delete.
    fn vacuum_at(mut ref self, h: i64) -> (i64, i64) {
        let mut removed = 0;
        let mut gone = 0;
        for k in self.sorted_keys() {
            let vs = self.versions.remove(k) ?? Vec.new();
            let n = vs.len();
            let mut (old, keep): (Vec[Version], Vec[Version]) = vs.into_iter().partition(|v| v.ts <= h);
            if let Some(last) = old.last() {
                if last.value.is_some() {
                    keep.insert(0, last.clone());
                }
            }
            removed += n - keep.len();
            if keep.is_empty() {
                gone += 1;
            } else {
                self.versions.insert(k.clone(), keep);
            }
        }
        (removed, gone)
    }

    // ---------------------------------------------------------- commands

    fn run(mut ref self, w: ref Vec[String]) -> Result[(), String] {
        let cmd = w[0].as_str();
        if cmd == "tear" {
            return self.tear(number(w[1]));
        }
        if cmd == "recover" {
            if not self.down {
                return Err("the store is up".to_string());
            }
            return self.recover();
        }
        if self.down {
            return Err("the store is down".to_string());
        }
        match cmd {
            "begin" => self.begin(w),
            "dump" => {
                self.dump();
                Ok(())
            }
            "vacuum" => self.vacuum(),
            "crash" => {
                self.crash();
                Ok(())
            }
            "checkpoint" => self.checkpoint(),
            _ => self.txn_command(w),
        }
    }

    fn begin(mut ref self, w: ref Vec[String]) -> Result[(), String] {
        let name = w[1].clone();
        if self.find(name).is_some() {
            return Err(f"{name} is already active");
        }
        let level = if w.len() == 3 { w[2].as_str() } else { "si" };
        let level = match level {
            "rc" => Level.ReadCommitted,
            "ser" => Level.Serializable,
            _ => Level.Snapshot,
        };
        if level == Level.ReadCommitted {
            self.out.push(f"{name} begin rc");
        } else {
            self.out.push(f"{name} begin {level_name(level)} at {self.clock}");
        }
        self.txns.push(Txn {
            name,
            level,
            read_ts: self.clock,
            writes: SortedMap.new(),
            reads: SortedSet.new(),
            prefixes: SortedSet.new(),
        });
        Ok(())
    }

    fn dump(mut ref self) {
        self.out.push(f"dump at clock {self.clock}:");
        if self.versions.is_empty() {
            self.out.push("  (empty)".to_string());
        }
        for k in self.sorted_keys() {
            let vs: Vec[String] = self.versions[k].iter().map(|v| f"@{v.ts} {show(v.value)}").collect();
            self.out.push(f"  {k} {vs.join(" ")}");
        }
    }

    fn vacuum(mut ref self) -> Result[(), String] {
        let mut h = self.clock;
        for t in self.txns.iter() {
            if t.level != Level.ReadCommitted and t.read_ts < h {
                h = t.read_ts;
            }
        }
        let (removed, gone) = self.vacuum_at(h);
        self.append(record(f"vacuum {h}", Vec.new()))?;
        self.out.push(f"vacuum at horizon {h}: removed {plural(removed, "version")}, {plural(gone, "key")} gone");
        Ok(())
    }

    fn crash(mut ref self) {
        if self.txns.is_empty() {
            self.out.push("crash: no open transactions".to_string());
        } else {
            let lost: Vec[String] = self.txns.iter().map(|t| t.name.clone()).collect();
            self.out.push(f"crash: lost {lost.join(" ")}");
        }
        self.versions = Map.new();
        self.clock = 0;
        self.txns = Vec.new();
        self.down = true;
    }

    // Cuts the last n bytes off the log: a write the disk never finished.
    fn tear(mut ref self, n: i64) -> Result[(), String] {
        if not self.down {
            return Err("tear needs a crashed store".to_string());
        }
        let b = match fs.read_bytes(self.wal) {
            Ok(b) => b,
            Err(_) => return Err(f"cannot read {self.wal}"),
        };
        let keep = if b.len() > n { b.len() - n } else { 0 };
        if fs.write_bytes(self.wal.clone(), b[0..keep].to_vec()).is_err() {
            return Err(f"cannot write {self.wal}");
        }
        self.out.push(f"tear {n}: wal {b.len()} -> {keep} bytes");
        Ok(())
    }

    fn checkpoint(mut ref self) -> Result[(), String] {
        let n = self.version_count();
        let mut text = f"snapshot {self.clock} {n}\n";
        for k in self.sorted_keys() {
            for v in self.versions[k].iter() {
                text.push_str(f"v {k} {v.ts} {v.txn} {show(v.value)}\n");
            }
        }
        let tmp = self.snap + ".tmp";
        if fs.write(tmp, text).is_err() {
            return Err(f"cannot write {tmp}");
        }
        if fs.rename(tmp, self.snap).is_err() {
            return Err(f"cannot rename {tmp}");
        }
        let size = file_size(self.wal);
        if fs.write_bytes(self.wal.clone(), Vec.new()).is_err() {
            return Err(f"cannot empty {self.wal}");
        }
        self.out.push(f"checkpoint at clock {self.clock}: {plural(n, "version")}, wal {size} -> 0 bytes");
        Ok(())
    }

    // ---------------------------------------------------------- transactions

    fn kill(mut ref self, i: i64) {
        self.txns.remove(i);
        self.aborts += 1;
    }

    fn txn_command(mut ref self, w: ref Vec[String]) -> Result[(), String] {
        let name = w[0].clone();
        let i = match self.find(name) {
            Some(i) => i,
            None => return Err(f"{name} is not active"),
        };
        let act = w[1].as_str();
        match act {
            "get" => {
                let v = self.read(i, w[2]);
                self.out.push(f"{name} get {w[2]} = {v ?? "(none)".to_string()}");
            }
            "put" => {
                self.txns[i].writes.insert(w[2].clone(), Some(w[3].clone()));
                self.out.push(f"{name} put {w[2]} {w[3]}");
            }
            "del" => {
                self.txns[i].writes.insert(w[2].clone(), None);
                self.out.push(f"{name} del {w[2]}");
            }
            "add" => {
                let v = self.read(i, w[2]);
                let cur = match v {
                    Some(s) => {
                        if not is_int(s) {
                            self.kill(i);
                            return Err(f"{name} add {w[2]}: \"{s}\" is not a number; {name} aborted");
                        }
                        number(s)
                    }
                    None => 0,
                };
                let new = cur + number(w[3]);
                self.txns[i].writes.insert(w[2].clone(), Some(new.to_string()));
                self.out.push(f"{name} add {w[2]} {w[3]}: {cur} -> {new}");
            }
            "scan" => {
                let items = self.range(i, w[2]);
                let pairs: Vec[String] = items.iter().map(|(k, v)| f"{k}={v}").collect();
                let shown = if items.is_empty() { "(none)".to_string() } else { pairs.join(" ") };
                self.out.push(f"{name} scan {w[2]} -> {shown}");
            }
            "sum" => {
                let items = self.range(i, w[2]);
                let mut total = 0;
                for (k, v) in items.iter() {
                    if not is_int(v) {
                        self.kill(i);
                        return Err(f"{name} sum {w[2]}: {k} is \"{v}\", not a number; {name} aborted");
                    }
                    total += number(v);
                }
                self.out.push(f"{name} sum {w[2]} = {total} over {plural(items.len(), "key")}");
            }
            "abort" => {
                self.kill(i);
                self.out.push(f"{name} abort");
            }
            _ => self.commit(i)?,
        }
        Ok(())
    }

    // Why a transaction cannot commit, if it cannot: a key it wrote, or
    // under serializable a key it read or a range it scanned, changed
    // after its snapshot.
    fn conflict(self, t: ref Txn) -> Option[String] {
        if t.level == Level.ReadCommitted {
            return None;
        }
        for k in t.writes.keys() {
            if let Some(v) = self.newest(k) {
                if v.ts > t.read_ts {
                    return Some(f"write-write conflict on {k} ({v.txn} committed it at {v.ts})");
                }
            }
        }
        if t.level != Level.Serializable {
            return None;
        }
        for k in t.reads.iter() {
            if let Some(v) = self.newest(k) {
                if v.ts > t.read_ts {
                    return Some(f"read-write conflict on {k} ({v.txn} committed it at {v.ts})");
                }
            }
        }
        let keys = self.sorted_keys();
        for p in t.prefixes.iter() {
            for k in keys.iter() {
                if k.starts_with(p) {
                    let v = self.newest(k)?;
                    if v.ts > t.read_ts {
                        return Some(f"phantom under {p} ({v.txn} committed {k} at {v.ts})");
                    }
                }
            }
        }
        None
    }

    fn commit(mut ref self, i: i64) -> Result[(), String] {
        let t = self.txns.remove(i);
        if t.writes.is_empty() {
            self.commits += 1;
            self.out.push(f"{t.name} commit (read-only)");
            return Ok(());
        }
        if let Some(why) = self.conflict(t) {
            self.aborts += 1;
            self.out.push(f"{t.name} abort: {why}");
            return Ok(());
        }
        self.clock += 1;
        let writes: Vec[(String, Option[String])] = t.writes.into_iter().collect();
        let body: Vec[String] = writes.iter().map(|(k, v)| match v {
            Some(s) => f"put {k} {s}",
            None => f"del {k}",
        }).collect();
        self.append(record(f"commit {self.clock} {t.name} {body.len()}", body))?;
        self.install(self.clock, t.name, writes);
        self.commits += 1;
        self.out.push(f"{t.name} commit at {self.clock} ({plural(body.len(), "write")})");
        Ok(())
    }

    // ---------------------------------------------------------- recovery

    fn load_snapshot(mut ref self) -> Result[(), String] {
        let text = match fs.read_to_string(self.snap) {
            Ok(t) => t,
            Err(_) => return Err(f"cannot read {self.snap}"),
        };
        let mut lines = text.split("\n");
        let head: Vec[Str] = (lines.next() ?? "").split(" ").collect();
        if head.len() != 3 or head[0] != "snapshot" {
            return Err(f"{self.snap} is not a snapshot");
        }
        self.clock = number(head[1]);
        for l in lines {
            let w: Vec[Str] = l.split(" ").collect();
            if w.len() != 5 {
                continue;
            }
            let value = if w[4] == "-" { None } else { Some(w[4].to_string()) };
            self.install(number(w[2]), w[3], vec![(w[1].to_string(), value)]);
        }
        self.out.push(f"recover: snapshot at clock {self.clock}, {plural(number(head[2]), "version")}");
        Ok(())
    }

    fn recover(mut ref self) -> Result[(), String] {
        if fs.exists(self.snap) {
            self.load_snapshot()?;
        }
        let data = match fs.read_bytes(self.wal) {
            Ok(d) => d,
            Err(_) => return Err(f"cannot read {self.wal}"),
        };
        let mut pos = 0;
        let mut commits = 0;
        let mut vacuums = 0;
        while pos < data.len() {
            let (next, rec) = match parse_record(data, pos) {
                Some(r) => r,
                None => break,
            };
            pos = next;
            match rec {
                Record.Commit { ts, txn, writes } => {
                    self.clock = ts;
                    self.install(ts, txn, writes);
                    commits += 1;
                }
                Record.Vacuum(h) => {
                    self.vacuum_at(h);
                    vacuums += 1;
                }
            }
        }
        self.out.push(f"recover: replayed {plural(commits, "commit")} and {plural(vacuums, "vacuum")}, clock {self.clock}");
        if pos < data.len() {
            self.out.push(f"recover: dropped a torn record at byte {pos} ({plural(data.len() - pos, "byte")})");
            if fs.write_bytes(self.wal.clone(), data[0..pos].to_vec()).is_err() {
                return Err(f"cannot truncate {self.wal}");
            }
        }
        self.down = false;
        Ok(())
    }

    fn summary(self) -> Vec[String] {
        let mut out: Vec[String] = Vec.new();
        if not self.txns.is_empty() {
            let open: Vec[String] = self.txns.iter().map(|t| t.name.clone()).collect();
            out.push(f"open at end: {open.join(" ")}");
        }
        out.push(
            f"stats: {plural(self.commits, "commit")}, {plural(self.aborts, "abort")}, clock {self.clock}, {plural(self.versions.len(), "key")}, {plural(self.version_count(), "version")}, wal {file_size(self.wal)} bytes",
        );
        out
    }
}

// The line that starts at byte p, and the byte after its newline; None
// when the data ends before a newline.
fn line_at(data: ref Vec[u8], p: i64) -> Option[(String, i64)] {
    let mut i = p;
    while i < data.len() {
        if data[i] == b'\n' {
            let text = String.from_utf8(data[p..i].to_vec()).ok()?;
            return Some((text, i + 1));
        }
        i += 1;
    }
    None
}

// One whole record starting at pos, and the byte after it; None for a
// record cut short or damaged.
fn parse_record(data: ref Vec[u8], pos: i64) -> Option[(i64, Record)] {
    let mut (head, p) = line_at(data, pos)?;
    let w: Vec[Str] = head.split(" ").collect();
    let rec = if w[0] == "commit" and w.len() == 4 and is_digits(w[1]) and is_digits(w[3]) {
        let mut writes: Vec[(String, Option[String])] = Vec.new();
        for _ in 0..number(w[3]) {
            let (b, next) = line_at(data, p)?;
            p = next;
            let bw: Vec[Str] = b.split(" ").collect();
            if bw[0] == "put" and bw.len() == 3 {
                writes.push((bw[1].to_string(), Some(bw[2].to_string())));
            } else if bw[0] == "del" and bw.len() == 2 {
                writes.push((bw[1].to_string(), None));
            } else {
                return None;
            }
        }
        Record.Commit { ts: number(w[1]), txn: w[2].to_string(), writes }
    } else if w[0] == "vacuum" and w.len() == 2 and is_digits(w[1]) {
        Record.Vacuum(number(w[1]))
    } else {
        return None;
    };
    let (end, q) = line_at(data, p)?;
    let sum = fnv(data[pos..p]);
    if end != f"end {sum:08x}" {
        return None;
    }
    Some((q, rec))
}

// ------------------------------------------------------------ the scripts

fn session_command(cmd: Str) -> bool {
    match cmd {
        "dump" | "vacuum" | "crash" | "recover" | "checkpoint" => true,
        _ => false,
    }
}

// How many arguments an action takes, and what to say when it gets some
// other number.
fn action(act: Str) -> Option[(i64, Str)] {
    match act {
        "get" => Some((1, "get takes a key")),
        "del" => Some((1, "del takes a key")),
        "put" => Some((2, "put takes a key and a value")),
        "add" => Some((2, "add takes a key and a whole number")),
        "scan" => Some((1, "scan takes a prefix")),
        "sum" => Some((1, "sum takes a prefix")),
        "commit" => Some((0, "commit takes no arguments")),
        "abort" => Some((0, "abort takes no arguments")),
        _ => None,
    }
}

fn check_line(w: ref Vec[String], begun: mut ref Set[String]) -> Result[(), String] {
    let cmd = w[0].as_str();
    if cmd == "begin" {
        if w.len() != 2 and w.len() != 3 {
            return Err("begin takes a name and an optional level".to_string());
        }
        begun.insert(w[1].clone());
        if w.len() == 3 and not ["rc", "si", "ser"].contains(w[2]) {
            return Err(f"unknown level {w[2]}");
        }
        return Ok(());
    }
    if session_command(cmd) {
        if w.len() != 1 {
            return Err(f"{cmd} takes no arguments");
        }
        return Ok(());
    }
    if cmd == "tear" {
        if w.len() != 2 or not is_digits(w[1]) {
            return Err("tear needs a byte count".to_string());
        }
        return Ok(());
    }
    if w.len() == 1 {
        return Err(f"unknown command {cmd}");
    }
    if not begun.contains(w[0]) {
        return Err(f"{cmd} has no begin before this line");
    }
    let (n, msg) = match action(w[1]) {
        Some(a) => a,
        None => return Err(f"unknown action {w[1]}"),
    };
    if w.len() != n + 2 {
        return Err(msg.to_string());
    }
    if w[1] == "put" and w[3] == "-" {
        return Err("a value cannot be -".to_string());
    }
    if w[1] == "add" and not is_int(w[3]) {
        return Err("add needs a whole number".to_string());
    }
    Ok(())
}

fn run(name: String, text: String) -> Vec[String] {
    let mut out: Vec[String] = vec![f"== {name}"];
    let mut lines: Vec[Vec[String]] = Vec.new();
    let mut errs: Vec[String] = Vec.new();
    let mut begun: Set[String] = Set.new();
    let mut no = 0;
    for line in text.split("\n") {
        no += 1;
        if line.len() == 0 or line.starts_with("#") {
            continue;
        }
        let w: Vec[String] = line.split(" ").map(|s| s.to_string()).collect();
        match check_line(w, mut begun) {
            Ok(()) => lines.push(w),
            Err(e) => errs.push(f"! {name} line {no}: {e}"),
        }
    }
    if not errs.is_empty() {
        out.extend(errs);
        return out;
    }
    let stem = name.split(".").next() ?? "";
    let mut s = match Store.new(stem) {
        Ok(s) => s,
        Err(e) => {
            out.push(f"! {e}");
            return out;
        }
    };
    for w in lines.iter() {
        if let Err(e) = s.run(w) {
            s.out.push(f"! {e}");
        }
    }
    out.extend(mem.take(mut s.out));
    out.extend(s.summary());
    out
}

// ------------------------------------------------------------ files

fn is_hexd(c: u8) -> bool {
    (c >= b'0' and c <= b'9') or (c >= b'a' and c <= b'f') or (c >= b'A' and c <= b'F')
}

fn hex_val(c: u8) -> u8 {
    if c >= b'0' and c <= b'9' {
        c - b'0'
    } else if c >= b'a' and c <= b'f' {
        c - b'a' + 10
    } else {
        c - b'A' + 10
    }
}

fn unhex(s: Str) -> Vec[u8] {
    let mut digits: Vec[u8] = Vec.new();
    for c in s.bytes() {
        if is_hexd(c) {
            digits.push(hex_val(c));
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < digits.len() {
        out.push(digits[i] * 16 + digits[i + 1]);
        i += 2;
    }
    out
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn main() {
    if let Err(e) = fs.create_dir_all("data/run".to_string()) {
        eprintln(f"cannot create data/run: {e}");
        return;
    }
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    let mut names: Vec[String] = match fs.read_dir("data".to_string()) {
        Ok(n) => n.into_iter().filter(|n| n.ends_with(".mvcc")).collect(),
        Err(e) => {
            eprintln(f"cannot list data: {e}");
            return;
        }
    };
    names.sort();
    // One task per session, each with its own store and log; the reports
    // print in file name order.
    let group = TaskGroup.new();
    let mut handles = Vec.new();
    for name in names.iter() {
        let text = match fs.read_to_string(f"data/{name}") {
            Ok(t) => t,
            Err(e) => {
                eprintln(f"cannot read {name}: {e}");
                return;
            }
        };
        let owned = name.clone();
        handles.push(group.spawn(|| run(owned, text)));
    }
    let mut out: Vec[String] = Vec.new();
    for h in handles.into_iter() {
        out.extend(h.join());
    }
    println(out.join("\n"));
}

// ============================================================ data

// The files under data/, in name order.
fn write_data() -> Result[(), String] {
    put_bytes("data/1_bank.mvcc", unhex(file_0()))?;
    put_bytes("data/2_oncall.mvcc", unhex(file_1()))?;
    put_bytes("data/3_reads.mvcc", unhex(file_2()))?;
    put_bytes("data/4_vacuum.mvcc", unhex(file_3()))?;
    put_bytes("data/5_crash.mvcc", unhex(file_4()))?;
    put_bytes("data/6_load.mvcc", unhex(file_5()))?;
    put_bytes("data/7_bad.mvcc", unhex(file_6()))?;
    Ok(())
}

