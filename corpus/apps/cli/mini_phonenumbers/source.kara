// mini_phonenumbers: phonenumbers 8.13.52, the Python port of Google's
// libphonenumber, ported to Kāra with the metadata of the regions its jobs
// reach. It runs a list of jobs through the library's API (parse,
// format_number in its four formats, the out-of-country, original-format,
// carrier-code and mobile-dialing formatters, number_type and validity,
// region_code_for_number, the possible-length checks, truncation,
// is_number_match, example numbers and the AsYouTypeFormatter), and then
// two small tools built on it: an address book cleaner and a call log
// dialer. The output matches oracle.py, which runs the same jobs through
// the real library.
//
// The library is regular expressions over metadata, so its patterns go
// through a port of Python's re (from mini_arrow).


// ------------------------------------------------------------ JSON in

// The jobs file holds strings, numbers, booleans, arrays and objects.
#[derive(Clone)]
enum J {
    S(String),
    N(i64),
    // a number with a fraction or an exponent, and its text
    F(f64, String),
    A(Vec[J]),
    O(Vec[(String, J)]),
    B(bool),
    Null,
}

fn json_space(c: char) -> bool {
    c == ' ' or c == '\n' or c == '\r' or c == '\t'
}

struct JsonIn {
    cs: Vec[char],
    pos: i64,
}

impl JsonIn {
    fn ws(mut ref self) {
        while self.pos < self.cs.len() and json_space(self.cs[self.pos]) {
            self.pos += 1;
        }
    }

    fn word(mut ref self, w: Str) -> bool {
        let wc: Vec[char] = w.chars().collect();
        if self.pos + wc.len() > self.cs.len() {
            return false;
        }
        let mut k = 0;
        while k < wc.len() {
            if self.cs[self.pos + k] != wc[k] {
                return false;
            }
            k += 1;
        }
        self.pos += wc.len();
        true
    }

    fn hex4(mut ref self) -> u32 {
        let mut n: u32 = 0;
        let mut k = 0;
        while k < 4 {
            let c = self.cs[self.pos];
            let d = if c >= '0' and c <= '9' {
                (c as u32) - ('0' as u32)
            } else if c >= 'a' and c <= 'f' {
                (c as u32) - ('a' as u32) + 10
            } else {
                (c as u32) - ('A' as u32) + 10
            };
            n = n * 16 + d;
            self.pos += 1;
            k += 1;
        }
        n
    }

    fn value(mut ref self) -> Result[J, String] {
        self.ws();
        if self.pos >= self.cs.len() {
            return Err("unexpected end of JSON".to_string());
        }
        let c = self.cs[self.pos];
        if c == '[' {
            self.pos += 1;
            let mut items: Vec[J] = Vec.new();
            self.ws();
            if self.pos < self.cs.len() and self.cs[self.pos] == ']' {
                self.pos += 1;
                return Ok(J.A(items));
            }
            loop {
                items.push(self.value()?);
                self.ws();
                if self.pos >= self.cs.len() {
                    return Err("unterminated JSON array".to_string());
                }
                let d = self.cs[self.pos];
                self.pos += 1;
                if d == ']' {
                    return Ok(J.A(items));
                }
                if d != ',' {
                    return Err(f"bad JSON array separator {d}");
                }
            }
        }
        if c == '{' {
            self.pos += 1;
            let mut members: Vec[(String, J)] = Vec.new();
            self.ws();
            if self.pos < self.cs.len() and self.cs[self.pos] == '}' {
                self.pos += 1;
                return Ok(J.O(members));
            }
            loop {
                let key = match self.value()? {
                    J.S(k) => k,
                    _ => return Err("JSON object key is not a string".to_string()),
                };
                self.ws();
                if self.pos >= self.cs.len() or self.cs[self.pos] != ':' {
                    return Err("missing ':' in JSON object".to_string());
                }
                self.pos += 1;
                let v = self.value()?;
                members.push((key, v));
                self.ws();
                if self.pos >= self.cs.len() {
                    return Err("unterminated JSON object".to_string());
                }
                let d = self.cs[self.pos];
                self.pos += 1;
                if d == '}' {
                    return Ok(J.O(members));
                }
                if d != ',' {
                    return Err(f"bad JSON object separator {d}");
                }
            }
        }
        if self.word("true") {
            return Ok(J.B(true));
        }
        if self.word("false") {
            return Ok(J.B(false));
        }
        if self.word("null") {
            return Ok(J.Null);
        }
        if c == '-' or (c >= '0' and c <= '9') {
            let start = self.pos;
            let mut neg = false;
            if c == '-' {
                neg = true;
                self.pos += 1;
            }
            let mut n: i64 = 0;
            while self.pos < self.cs.len() and self.cs[self.pos] >= '0' and self.cs[self.pos] <= '9' {
                n = n * 10 + ((self.cs[self.pos] as u32) - ('0' as u32)) as i64;
                self.pos += 1;
            }
            if self.pos < self.cs.len() and (self.cs[self.pos] == '.' or self.cs[self.pos] == 'e' or self.cs[self.pos] == 'E') {
                while self.pos < self.cs.len() and (self.cs[self.pos] == '.' or self.cs[self.pos] == 'e' or self.cs[self.pos] == 'E' or self.cs[self.pos] == '+' or self.cs[self.pos] == '-' or (self.cs[self.pos] >= '0' and self.cs[self.pos] <= '9')) {
                    self.pos += 1;
                }
                let mut text = String.new();
                let mut k = start;
                while k < self.pos {
                    text.push(self.cs[k]);
                    k += 1;
                }
                return match f64.parse(text.as_str()) {
                    Ok(x) => Ok(J.F(x, text)),
                    Err(_) => Err(f"bad JSON number {text}"),
                };
            }
            return Ok(J.N(if neg { -n } else { n }));
        }
        if c != '"' {
            return Err(f"unexpected JSON character {c}");
        }
        self.pos += 1;
        let mut s = String.new();
        while self.pos < self.cs.len() {
            let d = self.cs[self.pos];
            self.pos += 1;
            if d == '"' {
                return Ok(J.S(s));
            }
            if d != '\\' {
                s.push(d);
                continue;
            }
            let e = self.cs[self.pos];
            self.pos += 1;
            if e == 'n' {
                s.push('\n');
            } else if e == 't' {
                s.push('\t');
            } else if e == 'r' {
                s.push('\r');
            } else if e == 'b' {
                s.push('\u{8}');
            } else if e == 'f' {
                s.push('\u{c}');
            } else if e == 'u' {
                let mut n = self.hex4();
                if n >= 0xD800 and n < 0xDC00 {
                    self.pos += 2;
                    let lo = self.hex4();
                    n = 0x10000 + ((n - 0xD800) << 10) + (lo - 0xDC00);
                }
                s.push(char.try_from(n).unwrap_or('?'));
            } else {
                s.push(e);
            }
        }
        Err("unterminated JSON string".to_string())
    }
}

fn json_line(l: ref String) -> Result[J, String] {
    let mut p = JsonIn { cs: l.chars().collect(), pos: 0 };
    p.value()
}

fn j_get(j: ref J, key: Str) -> J {
    match j {
        J.O(members) => {
            for (k, v) in members.iter() {
                if k == key {
                    return v.clone();
                }
            }
            J.Null
        }
        _ => J.Null,
    }
}

fn j_has(j: ref J, key: Str) -> bool {
    match j_get(j, key) {
        J.Null => false,
        _ => true,
    }
}

fn j_str(j: ref J, key: Str) -> String {
    match j_get(j, key) {
        J.S(s) => s,
        _ => String.new(),
    }
}

fn j_int(j: ref J, key: Str, default: i64) -> i64 {
    match j_get(j, key) {
        J.N(n) => n,
        _ => default,
    }
}

fn j_bool(j: ref J, key: Str) -> bool {
    match j_get(j, key) {
        J.B(b) => b,
        _ => false,
    }
}

fn j_strs(j: ref J, key: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    if let J.A(items) = j_get(j, key) {
        for it in items.iter() {
            if let J.S(s) = it {
                out.push(s.clone());
            }
        }
    }
    out
}

// ------------------------------------------------------------ text as code points

fn cps(s: Str) -> Vec[i64] {
    codepoints(s.bytes())
}

fn cps_of(s: ref String) -> Vec[i64] {
    codepoints(s.bytes())
}

fn cat(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut out = a.clone();
    push_all(mut out, b);
    out
}

fn cat_ascii(a: ref Vec[i64], s: Str) -> Vec[i64] {
    let mut out = a.clone();
    push_ascii(mut out, s);
    out
}

fn index_of(s: ref Vec[i64], c: i64) -> i64 {
    let mut i = 0;
    while i < s.len() {
        if s[i] == c {
            return i;
        }
        i += 1;
    }
    -1
}

fn has(s: ref Vec[i64], c: i64) -> bool {
    index_of(s, c) >= 0
}

// `needle in s` for str
fn contains_seq(s: ref Vec[i64], needle: ref Vec[i64]) -> bool {
    find_seq(s, needle, 0) >= 0
}

fn find_seq(s: ref Vec[i64], needle: ref Vec[i64], from: i64) -> i64 {
    let mut i = from;
    while i + needle.len() <= s.len() {
        let mut k = 0;
        while k < needle.len() and s[i + k] == needle[k] {
            k += 1;
        }
        if k == needle.len() {
            return i;
        }
        i += 1;
    }
    -1
}

fn starts_with_seq(s: ref Vec[i64], p: Str) -> bool {
    let n = cps(p);
    if n.len() > s.len() {
        return false;
    }
    let mut k = 0;
    while k < n.len() {
        if s[k] != n[k] {
            return false;
        }
        k += 1;
    }
    true
}

fn eq_ascii(s: ref Vec[i64], p: Str) -> bool {
    same(s, cps(p))
}

// One character in a str of ASCII choices.
fn in_ascii(c: i64, set: Str) -> bool {
    for b in set.bytes() {
        if (b as i64) == c {
            return true;
        }
    }
    false
}

// str.replace
fn replace_seq(s: ref Vec[i64], old: ref Vec[i64], new: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < s.len() {
        if old.len() > 0 and i + old.len() <= s.len() {
            let mut k = 0;
            while k < old.len() and s[i + k] == old[k] {
                k += 1;
            }
            if k == old.len() {
                push_all(mut out, new);
                i += old.len();
                continue;
            }
        }
        out.push(s[i]);
        i += 1;
    }
    out
}

fn replace_char(s: ref Vec[i64], old: i64, new: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s {
        if c == old {
            push_all(mut out, new);
        } else {
            out.push(c);
        }
    }
    out
}

fn repeat(c: i64, n: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < n {
        out.push(c);
        k += 1;
    }
    out
}

// str.split(sep) for a one-character separator
fn split_on(s: ref Vec[i64], sep: i64) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    for c in s {
        if c == sep {
            out.push(cur);
            cur = Vec.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn strip(s: ref Vec[i64]) -> Vec[i64] {
    let mut a = 0;
    let mut b = s.len();
    while a < b and is_space(s[a], false) {
        a += 1;
    }
    while b > a and is_space(s[b - 1], false) {
        b -= 1;
    }
    slice(s, a, b)
}

fn lower_all(s: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s {
        out.push(lower(c, false));
    }
    out
}

fn upper_all(s: ref Vec[i64]) -> Vec[i64] {
    cps_of(to_string(s).to_uppercase())
}

fn is_alpha_cp(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

// str.isupper
fn is_upper_str(s: ref Vec[i64]) -> bool {
    let mut cased = false;
    for c in s {
        if lower(c, false) != c {
            cased = true;
        } else if upper(c, false) != c {
            return false;
        }
    }
    cased
}

// The value of a decimal digit: the decimal digits come in runs of ten.
fn digit_value(c: i64) -> i64 {
    if c < 0x80 {
        return c - 48;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return c - s;
        }
    }
    0
}

// str.isdigit, for the strings date_convert looks at
fn all_decimal(s: ref Vec[i64]) -> bool {
    if s.len() == 0 {
        return false;
    }
    for c in s {
        if not is_decimal(c) {
            return false;
        }
    }
    true
}

fn pad_n(n: i64, width: i64) -> String {
    let mut s = f"{n}";
    while s.len() < width {
        s = f"0{s}";
    }
    s
}

fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

fn floor_mod(a: i64, b: i64) -> i64 {
    a - floor_div(a, b) * b
}
// ------------------------------------------------------------ errors

struct ReErr {
    kind: String,
    msg: String,
    pos: i64,
}

fn re_error(msg: own String, pos: i64) -> ReErr {
    ReErr { kind: "error".to_string(), msg: msg, pos: pos }
}

fn other_error(kind: Str, msg: own String) -> ReErr {
    ReErr { kind: kind.to_string(), msg: msg, pos: -1 }
}

fn err_text(e: ref ReErr) -> String {
    if e.kind == "error" {
        if e.pos >= 0 {
            return f"error: {e.msg} at position {e.pos}";
        }
        return f"error: {e.msg}";
    }
    f"{e.kind}: {e.msg}"
}

// -------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for cp in s {
        if cp < 0x80 {
            out.push(cp as u8);
        } else if cp < 0x800 {
            out.push((0xC0 | (cp >> 6)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else if cp < 0x10000 {
            out.push((0xE0 | (cp >> 12)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (cp >> 18)) as u8);
            out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

fn str_repr(s: ref Vec[i64], out: mut ref Vec[i64]) {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
}

fn repr_of(s: ref Vec[i64]) -> String {
    let mut out: Vec[i64] = Vec.new();
    str_repr(s, mut out);
    to_string(out)
}

// ----------------------------------------------------- character kinds

fn is_decimal(c: i64) -> bool {
    if c < 0x80 {
        return c >= 48 and c <= 57;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return true;
        }
    }
    false
}

fn is_space(c: i64, ascii: bool) -> bool {
    if c == 32 or (c >= 9 and c <= 13) {
        return true;
    }
    if ascii {
        return false;
    }
    (c >= 0x1C and c <= 0x1F) or c == 0x85 or c == 0xA0 or c == 0x1680 or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F or c == 0x3000
}

fn as_char(c: i64) -> Option[char] {
    if c < 0 or (c >= 0xD800 and c <= 0xDFFF) or c > 0x10FFFF {
        return None;
    }
    char.try_from(c as u32).ok()
}

fn is_word(c: i64, ascii: bool) -> bool {
    if c < 0x80 {
        return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
    }
    if ascii {
        return false;
    }
    match as_char(c) {
        Some(ch) => ch.is_alphanumeric(),
        None => false,
    }
}

fn lower(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 65 and c <= 90 { c + 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_lowercase() as u32 as i64,
        None => c,
    }
}

fn upper(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 97 and c <= 122 { c - 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_uppercase() as u32 as i64,
        None => c,
    }
}

// ------------------------------------------------------- parsed form

// The categories of \d \D \s \S \w \W.
fn cat_digit() -> i64 { 0 }
fn cat_not_digit() -> i64 { 1 }
fn cat_space() -> i64 { 2 }
fn cat_not_space() -> i64 { 3 }
fn cat_word() -> i64 { 4 }
fn cat_not_word() -> i64 { 5 }

// The positions ^ $ \A \Z \b \B and the forms the compiler turns them
// into under MULTILINE.
fn at_beginning() -> i64 { 0 }
fn at_beginning_line() -> i64 { 1 }
fn at_beginning_string() -> i64 { 2 }
fn at_end() -> i64 { 3 }
fn at_end_line() -> i64 { 4 }
fn at_end_string() -> i64 { 5 }
fn at_boundary() -> i64 { 6 }
fn at_non_boundary() -> i64 { 7 }

#[derive(Clone)]
enum Item {
    Lit(i64),
    Range(i64, i64),
    Cat(i64),
}

enum Node {
    Lit(i64),
    NotLit(i64),
    Any,
    In(Vec[Item], bool),
    At(i64),
    Branch(Vec[Vec[Node]]),
    // group (0: none), flags turned on, flags turned off, contents
    Group(i64, i64, i64, Vec[Node]),
    // 0 greedy, 1 lazy, 2 possessive; min; max; the item repeated
    Repeat(i64, i64, i64, Vec[Node]),
    Atomic(Vec[Node]),
    // direction (1 ahead, -1 behind), negative, contents
    Assert(i64, bool, Vec[Node]),
    GroupRef(i64),
    // group, yes branch, no branch
    Exists(i64, Vec[Node], Vec[Node]),
    Failure,
}

fn is_repeat(n: ref Node) -> bool {
    match n {
        Node.Repeat(_, _, _, _) => true,
        _ => false,
    }
}

fn is_at(n: ref Node) -> bool {
    match n {
        Node.At(_) => true,
        _ => false,
    }
}

fn flag_i() -> i64 { 2 }
fn flag_l() -> i64 { 4 }
fn flag_m() -> i64 { 8 }
fn flag_s() -> i64 { 16 }
fn flag_u() -> i64 { 32 }
fn flag_x() -> i64 { 64 }
fn flag_a() -> i64 { 256 }
fn type_flags() -> i64 { 4 | 32 | 256 }
fn maxrepeat() -> i64 { 4294967295 }
fn maxgroups() -> i64 { 1073741823 }
fn maxwidth() -> i64 { 1 << 62 }

fn flag_value(c: i64) -> i64 {
    match c {
        105 => 2,
        76 => 4,
        109 => 8,
        115 => 16,
        120 => 64,
        97 => 256,
        117 => 32,
        _ => 0,
    }
}

// ------------------------------------------------------------ tokens

// One token: nothing at the end of the pattern (n 0), a character (n 1),
// or a backslash and the character after it (n 2).
#[derive(Copy, Clone)]
struct T {
    n: i64,
    a: i64,
    b: i64,
}

fn tok_none() -> T {
    T { n: 0, a: 0, b: 0 }
}

fn tok_is(t: T, c: i64) -> bool {
    t.n == 1 and t.a == c
}

fn tok_text(t: T) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    if t.n >= 1 {
        v.push(t.a);
    }
    if t.n == 2 {
        v.push(t.b);
    }
    v
}

fn is_ascii_letter(c: i64) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

fn is_hex(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

fn is_oct(c: i64) -> bool {
    c >= 48 and c <= 55
}

fn is_dec(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn digits_value(s: ref Vec[i64], start: i64, base: i64) -> i64 {
    let mut v = 0;
    let mut i = start;
    while i < s.len() {
        let c = s[i];
        let d = if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 };
        v = v * base + d;
        i += 1;
    }
    v
}

// str.isidentifier, near enough: a letter or underscore, then letters,
// digits and underscores.
fn is_identifier(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    let mut i = 0;
    while i < name.len() {
        let c = name[i];
        let ok = if c == 95 {
            true
        } else if i == 0 {
            match as_char(c) {
                Some(ch) => ch.is_alphabetic(),
                None => false,
            }
        } else {
            is_word(c, false)
        };
        if not ok {
            return false;
        }
        i += 1;
    }
    true
}

fn is_ascii_decimal(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    for c in name {
        if not is_dec(c) {
            return false;
        }
    }
    true
}

struct Tokenizer {
    s: Vec[i64],
    index: i64,
    next: T,
}

impl Tokenizer {
    fn advance(mut ref self) -> Result[(), ReErr] {
        let index = self.index;
        if index >= self.s.len() {
            self.next = tok_none();
            return Ok(());
        }
        let c = self.s[index];
        if c == 92 {
            if index + 1 >= self.s.len() {
                return Err(re_error("bad escape (end of pattern)".to_string(), self.s.len() - 1));
            }
            self.next = T { n: 2, a: 92, b: self.s[index + 1] };
            self.index = index + 2;
        } else {
            self.next = T { n: 1, a: c, b: 0 };
            self.index = index + 1;
        }
        Ok(())
    }

    fn get(mut ref self) -> Result[T, ReErr] {
        let t = self.next;
        self.advance()?;
        Ok(t)
    }

    fn take(mut ref self, c: i64) -> Result[bool, ReErr] {
        if tok_is(self.next, c) {
            self.advance()?;
            return Ok(true);
        }
        Ok(false)
    }

    fn tell(ref self) -> i64 {
        self.index - self.next.n
    }

    fn seek(mut ref self, index: i64) -> Result[(), ReErr] {
        self.index = index;
        self.advance()
    }

    fn error(ref self, msg: own String, offset: i64) -> ReErr {
        re_error(msg, self.tell() - offset)
    }

    // getwhile: up to n characters of a kind (0 octal, 1 decimal, 2 hex).
    fn getwhile(mut ref self, n: i64, kind: i64, out: mut ref Vec[i64]) -> Result[(), ReErr] {
        let mut k = 0;
        while k < n {
            let t = self.next;
            if t.n != 1 {
                break;
            }
            let ok = if kind == 0 { is_oct(t.a) } else if kind == 1 { is_dec(t.a) } else { is_hex(t.a) };
            if not ok {
                break;
            }
            out.push(t.a);
            self.advance()?;
            k += 1;
        }
        Ok(())
    }

    fn getuntil(mut ref self, terminator: i64, name: Str) -> Result[Vec[i64], ReErr] {
        let mut result: Vec[i64] = Vec.new();
        loop {
            let c = self.next;
            self.advance()?;
            if c.n == 0 {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 0));
                }
                let term = to_string(vec_of(terminator));
                return Err(self.error(f"missing {term}, unterminated name", result.len()));
            }
            if tok_is(c, terminator) {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 1));
                }
                break;
            }
            push_all(mut result, tok_text(c));
        }
        Ok(result)
    }

    fn checkgroupname(ref self, name: ref Vec[i64], offset: i64) -> Result[(), ReErr] {
        if not is_identifier(name) {
            return Err(self.error(f"bad character in group name {repr_of(name)}", name.len() + offset));
        }
        Ok(())
    }
}

fn vec_of(c: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(c);
    v
}

fn new_tokenizer(s: ref Vec[i64]) -> Result[Tokenizer, ReErr] {
    let mut t = Tokenizer { s: s.clone(), index: 0, next: tok_none() };
    t.advance()?;
    Ok(t)
}

// ------------------------------------------------------------ parser

#[derive(Clone)]
struct Width {
    lo: i64,
    hi: i64,
}

struct ParseState {
    flags: i64,
    names: Vec[(Vec[i64], i64)],
    // per group: whether it is closed, and its width
    closed: Vec[bool],
    widths: Vec[Width],
    lookbehind_groups: i64,
    // conditional references by number, in order: (group, position)
    refpos: Vec[(i64, i64)],
}

impl ParseState {
    fn groups(ref self) -> i64 {
        self.closed.len()
    }

    fn group_of(ref self, name: ref Vec[i64]) -> i64 {
        for (n, g) in self.names.iter() {
            if same(n, name) {
                return *g;
            }
        }
        -1
    }

    fn checkgroup(ref self, gid: i64) -> bool {
        gid < self.groups() and self.closed[gid]
    }

    fn checklookbehindgroup(ref self, gid: i64, src: ref Tokenizer) -> Result[(), ReErr] {
        if self.lookbehind_groups >= 0 {
            if not self.checkgroup(gid) {
                return Err(src.error("cannot refer to an open group".to_string(), 0));
            }
            if gid >= self.lookbehind_groups {
                return Err(src.error("cannot refer to group defined in the same lookbehind subpattern".to_string(), 0));
            }
        }
        Ok(())
    }
}

fn add_width(a: i64, b: i64) -> i64 {
    if a >= maxwidth() - b { maxwidth() } else { a + b }
}

fn mul_width(a: i64, n: i64) -> i64 {
    if a == 0 or n == 0 {
        0
    } else if a >= maxwidth() / n {
        maxwidth()
    } else {
        a * n
    }
}

// SubPattern.getwidth.
fn width_of(widths: ref Vec[Width], p: ref Vec[Node]) -> Width {
    let mut lo = 0;
    let mut hi = 0;
    for n in p.iter() {
        match n {
            Node.Branch(items) => {
                let mut i = maxwidth();
                let mut j = 0;
                for item in items.iter() {
                    let w = width_of(widths, item);
                    if w.lo < i {
                        i = w.lo;
                    }
                    if w.hi > j {
                        j = w.hi;
                    }
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Atomic(body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Group(_, _, _, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Repeat(_, min, max, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, mul_width(w.lo, *min));
                if *max == maxrepeat() and w.hi > 0 {
                    hi = maxwidth();
                } else {
                    hi = add_width(hi, mul_width(w.hi, *max));
                }
            }
            Node.GroupRef(g) => {
                let w = ref widths[*g];
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Exists(_, yes, no) => {
                let wy = width_of(widths, yes);
                let mut i = wy.lo;
                let mut j = wy.hi;
                if no.len() > 0 {
                    let wn = width_of(widths, no);
                    if wn.lo < i {
                        i = wn.lo;
                    }
                    if wn.hi > j {
                        j = wn.hi;
                    }
                } else {
                    i = 0;
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Lit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.NotLit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.Any => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.In(_, _) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            _ => {}
        }
    }
    Width { lo: lo, hi: hi }
}

fn category_of(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        100 => 0,
        68 => 1,
        115 => 2,
        83 => 3,
        119 => 4,
        87 => 5,
        _ => -1,
    }
}

fn escape_value(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        97 => 7,
        98 => 8,
        102 => 12,
        110 => 10,
        114 => 13,
        116 => 9,
        118 => 11,
        92 => 92,
        _ => -1,
    }
}

// \x, \u and \U: the escape text so far, and the code point.
fn hex_escape(src: mut ref Tokenizer, t: T, esc: mut ref Vec[i64]) -> Result[i64, ReErr] {
    let n = if t.b == 120 { 2 } else if t.b == 117 { 4 } else { 8 };
    src.getwhile(n, 2, mut esc)?;
    if esc.len() != n + 2 {
        return Err(src.error(f"incomplete escape {to_string(esc)}", esc.len()));
    }
    let c = digits_value(esc, 2, 16);
    if c > 0x10FFFF {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(c)
}

// _class_escape: an escape inside [...], a literal or a category.
fn class_escape(src: mut ref Tokenizer, t: T) -> Result[Item, ReErr] {
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Item.Lit(e));
    }
    let cat = category_of(t);
    if cat >= 0 {
        return Ok(Item.Cat(cat));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Item.Lit(v));
    }
    if is_oct(c) {
        src.getwhile(2, 0, mut esc)?;
        let v = digits_value(esc, 1, 8);
        if v > 0o377 {
            return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
        }
        return Ok(Item.Lit(v));
    }
    if is_dec(c) or is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Item.Lit(c))
}

// _escape: an escape outside a set.
fn escape(src: mut ref Tokenizer, t: T, st: ref ParseState) -> Result[Node, ReErr] {
    let cat = category_of(t);
    if cat >= 0 {
        let mut items: Vec[Item] = Vec.new();
        items.push(Item.Cat(cat));
        return Ok(Node.In(items, false));
    }
    match t.b {
        65 => return Ok(Node.At(at_beginning_string())),
        98 => return Ok(Node.At(at_boundary())),
        66 => return Ok(Node.At(at_non_boundary())),
        90 => return Ok(Node.At(at_end_string())),
        _ => {}
    }
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Node.Lit(e));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Node.Lit(v));
    }
    if c == 48 {
        src.getwhile(2, 0, mut esc)?;
        return Ok(Node.Lit(digits_value(esc, 1, 8)));
    }
    if is_dec(c) {
        // an octal escape or a group reference
        let nt = src.next;
        if nt.n == 1 and is_dec(nt.a) {
            esc.push(nt.a);
            src.advance()?;
            let nt2 = src.next;
            if is_oct(esc[1]) and is_oct(esc[2]) and nt2.n == 1 and is_oct(nt2.a) {
                esc.push(nt2.a);
                src.advance()?;
                let v = digits_value(esc, 1, 8);
                if v > 0o377 {
                    return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
                }
                return Ok(Node.Lit(v));
            }
        }
        let group = digits_value(esc, 1, 10);
        if group < st.groups() {
            if not st.checkgroup(group) {
                return Err(src.error("cannot refer to an open group".to_string(), esc.len()));
            }
            st.checklookbehindgroup(group, src)?;
            return Ok(Node.GroupRef(group));
        }
        return Err(src.error(f"invalid group reference {group}", esc.len() - 1));
    }
    if is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Node.Lit(c))
}

fn parse_sub(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64) -> Result[Vec[Node], ReErr] {
    let mut items: Vec[Vec[Node]] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let first = nested == 0 and items.len() == 0;
        let item = parse_seq(mut src, mut st, verbose, nested + 1, first)?;
        items.push(item);
        if not src.take(124)? {
            break;
        }
        if nested == 0 {
            verbose = (st.flags & flag_x()) != 0;
        }
    }
    if items.len() == 1 {
        return Ok(items.pop().unwrap());
    }
    let mut out: Vec[Node] = Vec.new();
    out.push(Node.Branch(items));
    Ok(out)
}

// _parse_flags: None (as Err-free Ok(None)) for global flags, else the
// flags turned on and off.
fn parse_flags(src: mut ref Tokenizer, st: mut ref ParseState, first_char: T) -> Result[Option[(i64, i64)], ReErr] {
    let mut ch = first_char;
    let mut add = 0;
    let mut del = 0;
    if not tok_is(ch, 45) {
        loop {
            let flag = flag_value(ch.a);
            if ch.a == 76 {
                return Err(src.error("bad inline flags: cannot use 'L' flag with a str pattern".to_string(), 0));
            }
            add = add | flag;
            if (flag & type_flags()) != 0 and (add & type_flags()) != flag {
                return Err(src.error("bad inline flags: flags 'a', 'u' and 'L' are incompatible".to_string(), 0));
            }
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing -, : or )".to_string(), 0));
            }
            if tok_is(ch, 41) or tok_is(ch, 45) or tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing -, : or )" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if tok_is(ch, 41) {
        st.flags = st.flags | add;
        return Ok(None);
    }
    if tok_is(ch, 45) {
        ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("missing flag".to_string(), 0));
        }
        if ch.n != 1 or flag_value(ch.a) == 0 {
            let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing flag" };
            return Err(src.error(msg.to_string(), ch.n));
        }
        loop {
            let flag = flag_value(ch.a);
            if (flag & type_flags()) != 0 {
                return Err(src.error("bad inline flags: cannot turn off flags 'a', 'u' and 'L'".to_string(), 0));
            }
            del = del | flag;
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing :".to_string(), 0));
            }
            if tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing :" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if (add & del) != 0 {
        return Err(src.error("bad inline flags: flag turned on and off".to_string(), 1));
    }
    Ok(Some((add, del)))
}

fn is_alpha(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

fn parse_set(src: mut ref Tokenizer, out: mut ref Vec[Node]) -> Result[(), ReErr] {
    let here = src.tell() - 1;
    let mut set: Vec[Item] = Vec.new();
    let negate = src.take(94)?;
    loop {
        let this = src.get()?;
        if this.n == 0 {
            return Err(src.error("unterminated character set".to_string(), src.tell() - here));
        }
        if tok_is(this, 93) and set.len() > 0 {
            break;
        }
        let code1 = if this.n == 2 { class_escape(mut src, this)? } else { Item.Lit(this.a) };
        if src.take(45)? {
            let that = src.get()?;
            if that.n == 0 {
                return Err(src.error("unterminated character set".to_string(), src.tell() - here));
            }
            if tok_is(that, 93) {
                set.push(code1);
                set.push(Item.Lit(45));
                break;
            }
            let code2 = if that.n == 2 { class_escape(mut src, that)? } else { Item.Lit(that.a) };
            let text = f"{to_string(tok_text(this))}-{to_string(tok_text(that))}";
            let offset = this.n + 1 + that.n;
            let lo = match code1 {
                Item.Lit(c) => c,
                _ => -1,
            };
            let hi = match code2 {
                Item.Lit(c) => c,
                _ => -1,
            };
            if lo < 0 or hi < 0 or hi < lo {
                return Err(src.error(f"bad character range {text}", offset));
            }
            set.push(Item.Range(lo, hi));
        } else {
            set.push(code1);
        }
    }
    if set.len() == 1 {
        let only = ref set[0];
        if let Item.Lit(c) = only {
            if negate {
                out.push(Node.NotLit(*c));
            } else {
                out.push(Node.Lit(*c));
            }
            return Ok(());
        }
    }
    out.push(Node.In(set, negate));
    Ok(())
}

// The quantifier just read (its first character is `this`), applied to
// the last item. Returns false when `{` turned out to be a literal.
fn parse_repeat(src: mut ref Tokenizer, this: T, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let here = src.tell();
    let mut min = 0;
    let mut max = maxrepeat();
    if tok_is(this, 63) {
        max = 1;
    } else if tok_is(this, 43) {
        min = 1;
    } else if tok_is(this, 123) {
        if tok_is(src.next, 125) {
            out.push(Node.Lit(123));
            return Ok(false);
        }
        let mut lo: Vec[i64] = Vec.new();
        let mut hi: Vec[i64] = Vec.new();
        while src.next.n == 1 and is_dec(src.next.a) {
            lo.push(src.get()?.a);
        }
        if src.take(44)? {
            while src.next.n == 1 and is_dec(src.next.a) {
                hi.push(src.get()?.a);
            }
        } else {
            hi = lo.clone();
        }
        if not src.take(125)? {
            out.push(Node.Lit(123));
            src.seek(here)?;
            return Ok(false);
        }
        if lo.len() > 0 {
            if lo.len() > 10 or digits_value(lo, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            min = digits_value(lo, 0, 10);
        }
        if hi.len() > 0 {
            if hi.len() > 10 or digits_value(hi, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            max = digits_value(hi, 0, 10);
            if max < min {
                return Err(src.error("min repeat greater than max repeat".to_string(), src.tell() - here));
            }
        }
    }
    if out.len() == 0 or is_at(out[out.len() - 1]) {
        return Err(src.error("nothing to repeat".to_string(), src.tell() - here + 1));
    }
    if is_repeat(out[out.len() - 1]) {
        return Err(src.error("multiple repeat".to_string(), src.tell() - here + 1));
    }
    let last = out.pop().unwrap();
    let mut body: Vec[Node] = Vec.new();
    match last {
        Node.Group(0, 0, 0, p) => body = p,
        other => body.push(other),
    }
    let kind = if src.take(63)? { 1 } else if src.take(43)? { 2 } else { 0 };
    out.push(Node.Repeat(kind, min, max, body));
    Ok(true)
}

fn parse_seq(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64, first: bool) -> Result[Vec[Node], ReErr] {
    let mut out: Vec[Node] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let this = src.next;
        if this.n == 0 or tok_is(this, 124) or tok_is(this, 41) {
            break;
        }
        src.advance()?;
        if verbose {
            if this.n == 1 and (this.a == 32 or (this.a >= 9 and this.a <= 13)) {
                continue;
            }
            if tok_is(this, 35) {
                loop {
                    let t = src.get()?;
                    if t.n == 0 or tok_is(t, 10) {
                        break;
                    }
                }
                continue;
            }
        }
        if this.n == 2 {
            let node = escape(mut src, this, st)?;
            out.push(node);
            continue;
        }
        let c = this.a;
        if c == 91 {
            parse_set(mut src, mut out)?;
        } else if c == 42 or c == 43 or c == 63 or c == 123 {
            parse_repeat(mut src, this, mut out)?;
        } else if c == 46 {
            out.push(Node.Any);
        } else if c == 94 {
            out.push(Node.At(at_beginning()));
        } else if c == 36 {
            out.push(Node.At(at_end()));
        } else if c == 40 {
            if parse_group(mut src, mut st, mut verbose, nested, first, mut out)? {
                continue;
            }
        } else {
            out.push(Node.Lit(c));
        }
    }
    Ok(out)
}

// `(` and what follows. Returns true for a construct that adds nothing
// (a comment, global flags).
fn parse_group(src: mut ref Tokenizer, st: mut ref ParseState, verbose: mut ref bool, nested: i64, first: bool, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let start = src.tell() - 1;
    let mut capture = true;
    let mut atomic = false;
    let mut name: Vec[i64] = Vec.new();
    let mut named = false;
    let mut add = 0;
    let mut del = 0;
    if src.take(63)? {
        let ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("unexpected end of pattern".to_string(), 0));
        }
        if tok_is(ch, 80) {
            if src.take(60)? {
                name = src.getuntil(62, "group name")?;
                src.checkgroupname(name, 1)?;
                named = true;
            } else if src.take(61)? {
                let ref_name = src.getuntil(41, "group name")?;
                src.checkgroupname(ref_name, 1)?;
                let gid = st.group_of(ref_name);
                if gid < 0 {
                    return Err(src.error(f"unknown group name {repr_of(ref_name)}", ref_name.len() + 1));
                }
                if not st.checkgroup(gid) {
                    return Err(src.error("cannot refer to an open group".to_string(), ref_name.len() + 1));
                }
                st.checklookbehindgroup(gid, src)?;
                out.push(Node.GroupRef(gid));
                return Ok(true);
            } else {
                let c2 = src.get()?;
                if c2.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                return Err(src.error(f"unknown extension ?P{to_string(tok_text(c2))}", c2.n + 2));
            }
        } else if tok_is(ch, 58) {
            capture = false;
        } else if tok_is(ch, 35) {
            loop {
                if src.next.n == 0 {
                    return Err(src.error("missing ), unterminated comment".to_string(), src.tell() - start));
                }
                if tok_is(src.get()?, 41) {
                    break;
                }
            }
            return Ok(true);
        } else if tok_is(ch, 61) or tok_is(ch, 33) or tok_is(ch, 60) {
            let mut kind = ch;
            let mut dir = 1;
            let mut outer_lookbehind = 0;
            if tok_is(ch, 60) {
                kind = src.get()?;
                if kind.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                if not (tok_is(kind, 61) or tok_is(kind, 33)) {
                    return Err(src.error(f"unknown extension ?<{to_string(tok_text(kind))}", kind.n + 2));
                }
                dir = -1;
                outer_lookbehind = st.lookbehind_groups;
                if outer_lookbehind < 0 {
                    st.lookbehind_groups = st.groups();
                }
            }
            let p = parse_sub(mut src, mut st, *verbose, nested + 1)?;
            if dir < 0 and outer_lookbehind < 0 {
                st.lookbehind_groups = -1;
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            if tok_is(kind, 61) {
                out.push(Node.Assert(dir, false, p));
            } else if p.len() > 0 {
                out.push(Node.Assert(dir, true, p));
            } else {
                out.push(Node.Failure);
            }
            return Ok(true);
        } else if tok_is(ch, 40) {
            let condname = src.getuntil(41, "group name")?;
            let mut condgroup = 0;
            if not is_ascii_decimal(condname) {
                src.checkgroupname(condname, 1)?;
                condgroup = st.group_of(condname);
                if condgroup < 0 {
                    return Err(src.error(f"unknown group name {repr_of(condname)}", condname.len() + 1));
                }
            } else {
                if condname.len() > 10 {
                    return Err(src.error(f"invalid group reference {to_string(condname)}", condname.len() + 1));
                }
                condgroup = digits_value(condname, 0, 10);
                if condgroup == 0 {
                    return Err(src.error("bad group number".to_string(), condname.len() + 1));
                }
                if condgroup >= maxgroups() {
                    return Err(src.error(f"invalid group reference {condgroup}", condname.len() + 1));
                }
                let mut seen = false;
                for (g, _) in st.refpos.iter() {
                    if *g == condgroup {
                        seen = true;
                    }
                }
                if not seen {
                    st.refpos.push((condgroup, src.tell() - condname.len() - 1));
                }
            }
            st.checklookbehindgroup(condgroup, src)?;
            let yes = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
            let mut no: Vec[Node] = Vec.new();
            if src.take(124)? {
                no = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
                if tok_is(src.next, 124) {
                    return Err(src.error("conditional backref with more than two branches".to_string(), 0));
                }
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            out.push(Node.Exists(condgroup, yes, no));
            return Ok(true);
        } else if tok_is(ch, 62) {
            capture = false;
            atomic = true;
        } else if (ch.n == 1 and flag_value(ch.a) != 0) or tok_is(ch, 45) {
            match parse_flags(mut src, mut st, ch)? {
                None => {
                    if not first or out.len() > 0 {
                        return Err(src.error("global flags not at the start of the expression".to_string(), src.tell() - start));
                    }
                    *verbose = (st.flags & flag_x()) != 0;
                    return Ok(true);
                }
                Some((a, d)) => {
                    add = a;
                    del = d;
                    capture = false;
                }
            }
        } else {
            return Err(src.error(f"unknown extension ?{to_string(tok_text(ch))}", ch.n + 1));
        }
    }
    let mut group = 0;
    if capture {
        group = st.groups();
        st.closed.push(false);
        st.widths.push(Width { lo: 0, hi: 0 });
        if named {
            let was = st.group_of(name);
            if was >= 0 {
                return Err(src.error(f"redefinition of group name {repr_of(name)} as group {group}; was group {was}", name.len() + 1));
            }
            st.names.push((name.clone(), group));
        }
    }
    let sub_verbose = (*verbose or (add & flag_x()) != 0) and (del & flag_x()) == 0;
    let p = parse_sub(mut src, mut st, sub_verbose, nested + 1)?;
    if not src.take(41)? {
        return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
    }
    if group > 0 {
        let w = width_of(st.widths, p);
        st.widths[group] = w;
        st.closed[group] = true;
    }
    if atomic {
        out.push(Node.Atomic(p));
    } else {
        out.push(Node.Group(group, add, del, p));
    }
    Ok(false)
}

struct Parsed {
    nodes: Vec[Node],
    flags: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
    widths: Vec[Width],
}

fn parse(pattern: ref Vec[i64], flags: i64) -> Result[Parsed, ReErr] {
    let mut src = new_tokenizer(pattern)?;
    let mut st = ParseState {
        flags: flags,
        names: Vec.new(),
        closed: Vec.new(),
        widths: Vec.new(),
        lookbehind_groups: -1,
        refpos: Vec.new(),
    };
    // group 0 is the whole match
    st.closed.push(true);
    st.widths.push(Width { lo: 0, hi: 0 });
    let nodes = parse_sub(mut src, mut st, (flags & flag_x()) != 0, 0)?;
    if (st.flags & flag_a()) != 0 and (st.flags & flag_u()) != 0 {
        return Err(other_error("ValueError", "ASCII and UNICODE flags are incompatible".to_string()));
    }
    if src.next.n != 0 {
        return Err(src.error("unbalanced parenthesis".to_string(), 0));
    }
    for (g, pos) in st.refpos.iter() {
        if *g >= st.groups() {
            return Err(re_error(f"invalid group reference {*g}", *pos));
        }
    }
    let groups = st.groups() - 1;
    Ok(Parsed { nodes: nodes, flags: st.flags, groups: groups, names: st.names, widths: st.widths })
}

// ---------------------------------------------------------- compiler

enum Op {
    // character (lowered when case-insensitive), case-insensitive, ASCII
    Lit(i64, bool, bool),
    NotLit(i64, bool, bool),
    Any,
    AnyAll,
    // set, case-insensitive, ASCII-only categories
    In(i64, bool, bool),
    // anchor kind, ASCII-only word boundary
    At(i64, bool),
    Mark(i64),
    Split(i64, i64),
    Jmp(i64),
    // repeat register, the Until it starts at
    RepInit(i64, i64),
    // register, min, max, greedy, body, exit
    Until(i64, i64, i64, bool, i64, i64),
    Ref(i64, bool, bool),
    // lookbehind width (-1 for lookahead), negative, sub-program, next
    Look(i64, bool, i64, i64),
    Atomic(i64, i64),
    Exists(i64, i64),
    Fail,
    Succeed,
    Match,
}

struct Program {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
}

struct CharSet {
    items: Vec[Item],
    negate: bool,
}

fn combine(flags: i64, add: i64, del: i64) -> i64 {
    let mut f = flags;
    if (add & type_flags()) != 0 {
        f = f & (0x7FFFFFFF ^ type_flags());
    }
    (f | add) & (0x7FFFFFFF ^ del)
}

struct Compiler {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
}

impl Compiler {
    fn emit(mut ref self, op: own Op) -> i64 {
        self.ops.push(op);
        self.ops.len() - 1
    }

    fn here(ref self) -> i64 {
        self.ops.len()
    }

    fn compile(mut ref self, p: ref Parsed, nodes: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let icase = (flags & flag_i()) != 0;
        let ascii = (flags & flag_a()) != 0;
        for n in nodes.iter() {
            match n {
                Node.Lit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.Lit(v, icase, ascii));
                }
                Node.NotLit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.NotLit(v, icase, ascii));
                }
                Node.Any => {
                    if (flags & flag_s()) != 0 {
                        self.emit(Op.AnyAll);
                    } else {
                        self.emit(Op.Any);
                    }
                }
                Node.In(items, negate) => {
                    self.sets.push(CharSet { items: items.clone(), negate: *negate });
                    let idx = self.sets.len() - 1;
                    self.emit(Op.In(idx, icase, ascii));
                }
                Node.At(kind) => {
                    let mut k = *kind;
                    if (flags & flag_m()) != 0 {
                        if k == at_beginning() {
                            k = at_beginning_line();
                        } else if k == at_end() {
                            k = at_end_line();
                        }
                    }
                    self.emit(Op.At(k, ascii));
                }
                Node.Branch(items) => {
                    let mut ends: Vec[i64] = Vec.new();
                    let mut i = 0;
                    while i < items.len() {
                        if i + 1 < items.len() {
                            let split = self.emit(Op.Fail);
                            self.compile(p, items[i], flags)?;
                            ends.push(self.emit(Op.Fail));
                            let next = self.here();
                            self.ops[split] = Op.Split(split + 1, next);
                        } else {
                            self.compile(p, items[i], flags)?;
                        }
                        i += 1;
                    }
                    let end = self.here();
                    for at in ends {
                        self.ops[at] = Op.Jmp(end);
                    }
                }
                Node.Group(g, add, off, body) => {
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g));
                    }
                    self.compile(p, body, combine(flags, *add, *off))?;
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g + 1));
                    }
                }
                Node.Repeat(kind, min, max, body) => {
                    if *kind == 2 {
                        let at = self.emit(Op.Fail);
                        self.compile_repeat(p, *min, *max, true, body, flags)?;
                        self.emit(Op.Succeed);
                        let next = self.here();
                        self.ops[at] = Op.Atomic(at + 1, next);
                    } else {
                        self.compile_repeat(p, *min, *max, *kind == 0, body, flags)?;
                    }
                }
                Node.Atomic(body) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Atomic(at + 1, next);
                }
                Node.Assert(dir, negative, body) => {
                    let mut width = -1;
                    if *dir < 0 {
                        let w = width_of(p.widths, body);
                        if w.lo != w.hi {
                            return Err(other_error("error", "look-behind requires fixed-width pattern".to_string()));
                        }
                        width = w.lo;
                    }
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Look(width, *negative, at + 1, next);
                }
                Node.GroupRef(g) => {
                    self.emit(Op.Ref(*g, icase, ascii));
                }
                Node.Exists(g, yes, no) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, yes, flags)?;
                    if no.len() > 0 {
                        let jump = self.emit(Op.Fail);
                        let no_pc = self.here();
                        self.compile(p, no, flags)?;
                        let end = self.here();
                        self.ops[jump] = Op.Jmp(end);
                        self.ops[at] = Op.Exists(*g, no_pc);
                    } else {
                        let end = self.here();
                        self.ops[at] = Op.Exists(*g, end);
                    }
                }
                Node.Failure => {
                    self.emit(Op.Fail);
                }
            }
        }
        Ok(())
    }

    fn compile_repeat(mut ref self, p: ref Parsed, min: i64, max: i64, greedy: bool, body: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let r = self.repeats;
        self.repeats += 1;
        let init = self.emit(Op.Fail);
        self.compile(p, body, flags)?;
        let until = self.emit(Op.Fail);
        self.ops[init] = Op.RepInit(r, until);
        self.ops[until] = Op.Until(r, min, max, greedy, init + 1, until + 1);
        Ok(())
    }
}

fn compile(pattern: ref Vec[i64], flags: i64) -> Result[Program, ReErr] {
    let p = parse(pattern, flags)?;
    let mut c = Compiler { ops: Vec.new(), sets: Vec.new(), repeats: 0 };
    c.compile(p, p.nodes, p.flags)?;
    c.emit(Op.Match);
    Ok(Program { ops: c.ops, sets: c.sets, repeats: c.repeats, groups: p.groups, names: p.names })
}

// ----------------------------------------------------------- matcher

struct Undo {
    kind: i64,
    idx: i64,
    old: i64,
}

struct Choice {
    pc: i64,
    pos: i64,
    trail: i64,
    // 0: resume at pc; 1: a lazy repeat's Until, after its tail failed
    mode: i64,
}

struct Matcher {
    s: Vec[i64],
    marks: Vec[i64],
    counts: Vec[i64],
    lasts: Vec[i64],
    lastindex: i64,
    trail: Vec[Undo],
    start: i64,
    must_advance: bool,
    match_all: bool,
}

impl Matcher {
    fn set_mark(mut ref self, slot: i64, v: i64) {
        self.trail.push(Undo { kind: 0, idx: slot, old: self.marks[slot] });
        self.marks[slot] = v;
    }

    fn set_count(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 1, idx: r, old: self.counts[r] });
        self.counts[r] = v;
    }

    fn set_last(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 2, idx: r, old: self.lasts[r] });
        self.lasts[r] = v;
    }

    fn set_lastindex(mut ref self, v: i64) {
        self.trail.push(Undo { kind: 3, idx: 0, old: self.lastindex });
        self.lastindex = v;
    }

    fn undo_to(mut ref self, len: i64) {
        while self.trail.len() > len {
            let u = self.trail.pop().unwrap();
            if u.kind == 0 {
                self.marks[u.idx] = u.old;
            } else if u.kind == 1 {
                self.counts[u.idx] = u.old;
            } else if u.kind == 2 {
                self.lasts[u.idx] = u.old;
            } else {
                self.lastindex = u.old;
            }
        }
    }

    // A group that has both marks, the end not before the start.
    fn group_span(ref self, g: i64) -> (i64, i64) {
        let a = self.marks[2 * g];
        let b = self.marks[2 * g + 1];
        if a < 0 or b < 0 or b < a {
            return (-1, -1);
        }
        (a, b)
    }

    fn at(ref self, kind: i64, ascii: bool, pos: i64) -> bool {
        let n = self.s.len();
        if kind == 0 or kind == 2 {
            return pos == 0;
        }
        if kind == 1 {
            return pos == 0 or self.s[pos - 1] == 10;
        }
        if kind == 3 {
            return pos == n or (pos == n - 1 and self.s[pos] == 10);
        }
        if kind == 4 {
            return pos == n or self.s[pos] == 10;
        }
        if kind == 5 {
            return pos == n;
        }
        if n == 0 {
            return false;
        }
        let before = pos > 0 and is_word(self.s[pos - 1], ascii);
        let after = pos < n and is_word(self.s[pos], ascii);
        if kind == 6 { before != after } else { before == after }
    }

    // Runs the program from pc at pos, backtracking through its own
    // choices only. Returns where it succeeded, or -1.
    fn run(mut ref self, prog: ref Program, pc0: i64, pos0: i64, top: bool) -> i64 {
        let base = self.trail.len();
        let mut choices: Vec[Choice] = Vec.new();
        let mut pc = pc0;
        let mut pos = pos0;
        let mut mode = 0;
        loop {
            let mut ok = true;
            let op = ref prog.ops[pc];
            if mode == 1 {
                // a lazy repeat whose tail failed: try one more item
                mode = 0;
                ok = false;
                if let Op.Until(r, _, max, _, body, _) = op {
                    let count = self.counts[*r] + 1;
                    if not ((count >= *max and *max != maxrepeat()) or pos == self.lasts[*r]) {
                        self.set_count(*r, count);
                        self.set_last(*r, pos);
                        pc = *body;
                        ok = true;
                    }
                }
                if ok {
                    continue;
                }
            } else {
                match op {
                    Op.Lit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) == *c } else { self.s[pos] == *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.NotLit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) != *c } else { self.s[pos] != *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Any => {
                        if pos < self.s.len() and self.s[pos] != 10 {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.AnyAll => {
                        if pos < self.s.len() {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.In(set, icase, ascii) => {
                        if pos < self.s.len() and in_set(prog.sets[*set], self.s[pos], *icase, *ascii) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.At(kind, ascii) => {
                        if self.at(*kind, *ascii, pos) {
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Mark(slot) => {
                        self.set_mark(*slot, pos);
                        if (*slot & 1) == 1 {
                            self.set_lastindex(*slot / 2);
                        }
                        pc += 1;
                    }
                    Op.Split(a, b) => {
                        choices.push(Choice { pc: *b, pos: pos, trail: self.trail.len(), mode: 0 });
                        pc = *a;
                    }
                    Op.Jmp(a) => pc = *a,
                    Op.RepInit(r, until) => {
                        self.set_count(*r, -1);
                        self.set_last(*r, -1);
                        pc = *until;
                    }
                    Op.Until(r, min, max, greedy, body, exit) => {
                        let count = self.counts[*r] + 1;
                        if count < *min {
                            self.set_count(*r, count);
                            pc = *body;
                        } else if *greedy {
                            if (count < *max or *max == maxrepeat()) and pos != self.lasts[*r] {
                                choices.push(Choice { pc: *exit, pos: pos, trail: self.trail.len(), mode: 0 });
                                self.set_count(*r, count);
                                self.set_last(*r, pos);
                                pc = *body;
                            } else {
                                pc = *exit;
                            }
                        } else {
                            choices.push(Choice { pc: pc, pos: pos, trail: self.trail.len(), mode: 1 });
                            pc = *exit;
                        }
                    }
                    Op.Ref(g, icase, ascii) => {
                        let (a, b) = self.group_span(*g);
                        if a < 0 {
                            ok = false;
                        } else {
                            let len = b - a;
                            if pos + len > self.s.len() {
                                ok = false;
                            } else {
                                let mut k = 0;
                                while k < len {
                                    let x = self.s[a + k];
                                    let y = self.s[pos + k];
                                    let eq = if *icase { lower(x, *ascii) == lower(y, *ascii) } else { x == y };
                                    if not eq {
                                        ok = false;
                                        break;
                                    }
                                    k += 1;
                                }
                                if ok {
                                    pos += len;
                                    pc += 1;
                                }
                            }
                        }
                    }
                    Op.Look(width, negative, sub, next) => {
                        let mark = self.trail.len();
                        let from = if *width < 0 { pos } else { pos - *width };
                        let found = from >= 0 and self.run(prog, *sub, from, false) >= 0;
                        if *negative {
                            self.undo_to(mark);
                            if found {
                                ok = false;
                            } else {
                                pc = *next;
                            }
                        } else if found {
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Atomic(sub, next) => {
                        let end = self.run(prog, *sub, pos, false);
                        if end >= 0 {
                            pos = end;
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Exists(g, no) => {
                        let (a, _) = self.group_span(*g);
                        if a >= 0 {
                            pc += 1;
                        } else {
                            pc = *no;
                        }
                    }
                    Op.Fail => ok = false,
                    Op.Succeed => return pos,
                    Op.Match => {
                        if top and ((self.match_all and pos != self.s.len()) or (self.must_advance and pos == self.start)) {
                            ok = false;
                        } else {
                            return pos;
                        }
                    }
                }
            }
            if not ok {
                match choices.pop() {
                    Some(ch) => {
                        self.undo_to(ch.trail);
                        pc = ch.pc;
                        pos = ch.pos;
                        mode = ch.mode;
                    }
                    None => {
                        self.undo_to(base);
                        return -1;
                    }
                }
            }
        }
    }
}

fn in_items(set: ref CharSet, c: i64, ascii: bool) -> bool {
    for item in set.items.iter() {
        let hit = match item {
            Item.Lit(l) => c == *l,
            Item.Range(lo, hi) => c >= *lo and c <= *hi,
            Item.Cat(k) => {
                let kind = *k;
                if kind == 0 {
                    if ascii { c >= 48 and c <= 57 } else { is_decimal(c) }
                } else if kind == 1 {
                    if ascii { not (c >= 48 and c <= 57) } else { not is_decimal(c) }
                } else if kind == 2 {
                    is_space(c, ascii)
                } else if kind == 3 {
                    not is_space(c, ascii)
                } else if kind == 4 {
                    is_word(c, ascii)
                } else {
                    not is_word(c, ascii)
                }
            }
        };
        if hit {
            return true;
        }
    }
    false
}

// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = lower(c, ascii);
        if lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program, s: ref Vec[i64]) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        s: s.clone(),
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn find(m: mut ref Matcher, prog: ref Program, from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= m.s.len() {
        let mut k = 0;
        while k < m.marks.len() {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}

// All the matches finditer gives: each search starts where the last
// match ended, and must move on past an empty one.
fn all_matches(prog: ref Program, s: ref Vec[i64], limit: i64) -> Vec[Found] {
    let mut m = new_matcher(prog, s);
    let mut out: Vec[Found] = Vec.new();
    let mut pos = 0;
    let mut must_advance = false;
    while pos <= s.len() and (limit == 0 or out.len() < limit) {
        match find(mut m, prog, pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    out
}

// ------------------------------------------------------------ compiled patterns

// Every pattern the library uses (its own and the metadata's) has a slot
// in a table, and is compiled the first time it is matched. A pattern
// that does not compile is reported on stderr at the end and matches
// nothing: program 0 is (?!).
struct Rx {
    texts: Vec[Vec[i64]],
    flags: Vec[i64],
    prog_of: Vec[i64],
    index: Map[String, i64],
    progs: Vec[Program],
    errors: Vec[String],
}

fn new_rx() -> Rx {
    let mut progs: Vec[Program] = Vec.new();
    if let Ok(p) = compile(cps("(?!)"), 0) {
        progs.push(p);
    }
    Rx { texts: Vec.new(), flags: Vec.new(), prog_of: Vec.new(), index: Map.new(), progs: progs, errors: Vec.new() }
}

// The slot of a pattern, made the first time it is asked for.
fn intern(rx: mut ref Rx, text: ref Vec[i64], flags: i64) -> i64 {
    let key = f"{flags}:{to_string(text)}";
    if let Some(i) = rx.index.get(key) {
        return i;
    }
    rx.texts.push(text.clone());
    rx.flags.push(flags);
    rx.prog_of.push(-1);
    let i = rx.texts.len() - 1;
    rx.index.insert(key, i);
    i
}

fn prog(rx: mut ref Rx, slot: i64) -> i64 {
    if rx.prog_of[slot] >= 0 {
        return rx.prog_of[slot];
    }
    let id = match compile(rx.texts[slot], rx.flags[slot]) {
        Ok(p) => {
            rx.progs.push(p);
            rx.progs.len() - 1
        }
        Err(e) => {
            rx.errors.push(f"{to_string(rx.texts[slot])}: {err_text(e)}");
            0
        }
    };
    rx.prog_of[slot] = id;
    id
}

// pattern.search(s, from), .match(s) (mode 1) or fullmatch (mode 2)
fn rx_find(rx: mut ref Rx, slot: i64, s: ref Vec[i64], from: i64, mode: i64) -> Option[Found] {
    let id = prog(mut rx, slot);
    let p = ref rx.progs[id];
    let mut m = new_matcher(p, s);
    find(mut m, p, from, false, mode)
}

fn rx_search(rx: mut ref Rx, slot: i64, s: ref Vec[i64]) -> Option[Found] {
    rx_find(mut rx, slot, s, 0, 0)
}

fn rx_match(rx: mut ref Rx, slot: i64, s: ref Vec[i64]) -> Option[Found] {
    rx_find(mut rx, slot, s, 0, 1)
}

fn rx_full(rx: mut ref Rx, slot: i64, s: ref Vec[i64]) -> bool {
    rx_find(mut rx, slot, s, 0, 2).is_some()
}

fn rx_groups(rx: mut ref Rx, slot: i64) -> i64 {
    let id = prog(mut rx, slot);
    rx.progs[id].groups
}

fn group_of(s: ref Vec[i64], m: ref Found, g: i64) -> Option[Vec[i64]] {
    let (a, b) = m.spans[g - 1];
    if a < 0 { None } else { Some(slice(s, a, b)) }
}

// A replacement template: the library's only use \1 to \9 (gen_kara.py
// checks the metadata's), and a group that did not take part is empty.
fn expand(template: ref Vec[i64], s: ref Vec[i64], m: ref Found) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < template.len() {
        let c = template[k];
        if c == 92 and k + 1 < template.len() and template[k + 1] >= 49 and template[k + 1] <= 57 {
            let g = template[k + 1] - 48;
            if g <= m.spans.len() {
                if let Some(text) = group_of(s, m, g) {
                    push_all(mut out, text);
                }
            }
            k += 2;
        } else {
            out.push(c);
            k += 1;
        }
    }
    out
}

// re.sub(pattern, template, s, count), count 0 for all
fn rx_sub(rx: mut ref Rx, slot: i64, template: ref Vec[i64], s: ref Vec[i64], count: i64) -> Vec[i64] {
    let id = prog(mut rx, slot);
    let mut out: Vec[i64] = Vec.new();
    let mut last = 0;
    for m in all_matches(rx.progs[id], s, count) {
        push_all(mut out, slice(s, last, m.start));
        push_all(mut out, expand(template, s, m));
        last = m.end;
    }
    push_all(mut out, slice(s, last, s.len()));
    out
}

// re.split(pattern, s) for a pattern with no groups
fn rx_split(rx: mut ref Rx, slot: i64, s: ref Vec[i64]) -> Vec[Vec[i64]] {
    let id = prog(mut rx, slot);
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut last = 0;
    for m in all_matches(rx.progs[id], s, 0) {
        out.push(slice(s, last, m.start));
        last = m.end;
    }
    out.push(slice(s, last, s.len()));
    out
}

// ------------------------------------------------------------ the library's own patterns

fn valid_punctuation() -> Str {
    "-x\\u2010-\\u2015\\u2212\\u30FC\\uFF0D-\\uFF0F \\u00A0\\u00AD\\u200B\\u2060\\u3000()\\uFF08\\uFF09\\uFF3B\\uFF3D.\\[\\]/~\\u2053\\u223C\\uFF5E"
}

fn valid_alpha() -> Str {
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
}

fn extn_digits(max: i64) -> String {
    f"(\\d{{1,{max}}})"
}

// _create_extn_pattern(True)
fn extn_patterns_for_parsing() -> String {
    let seps = "[ \\u00A0\\t,]*";
    let after = "[:\\.\\uFF0E]?[ \\u00A0\\t,-]*";
    let suffix = "#?";
    let explicit_labels = "(?:e?xt(?:ensi(?:o\\u0301?|\\u00F3))?n?|\\uFF45?\\uFF58\\uFF54\\uFF4E?|\\u0434\\u043E\\u0431|anexo)";
    let ambiguous_labels = "(?:[x\\uFF58#\\uFF03~\\uFF5E]|int|\\uFF49\\uFF4E\\uFF54)";
    let ambiguous_sep = "[- ]+";
    let rfc = f";ext={extn_digits(20)}";
    let explicit = f"{seps}{explicit_labels}{after}{extn_digits(20)}{suffix}";
    let ambiguous = f"{seps}{ambiguous_labels}{after}{extn_digits(9)}{suffix}";
    let american = f"{ambiguous_sep}{extn_digits(6)}#";
    let seps_no_comma = "[ \\u00A0\\t]*";
    let auto = f"{seps_no_comma}(?:,{{2}}|;){after}{extn_digits(15)}{suffix}";
    let commas = f"{seps_no_comma}(?:,)+{after}{extn_digits(9)}{suffix}";
    f"{rfc}|{explicit}|{ambiguous}|{american}|{auto}|{commas}"
}

// The slots of the library's own patterns.
struct Pats {
    valid_start: i64,
    unwanted_end: i64,
    second_number: i64,
    valid_phone: i64,
    extn: i64,
    alpha_phone: i64,
    plus_chars: i64,
    separator: i64,
    capturing_digit: i64,
    single_intl_prefix: i64,
    non_digits: i64,
    first_group: i64,
    first_group_only: i64,
    rfc3966_global: i64,
    rfc3966_domain: i64,
    eligible_format: i64,
    np_separators: i64,
    digits_then_rest: i64,
}

fn flags_ui() -> i64 { 34 }

fn library_patterns(rx: mut ref Rx) -> Pats {
    let p = valid_punctuation();
    let alpha = valid_alpha();
    let plus = "+\\uFF0B";
    let valid_phone = f"\\d{{2}}|[{plus}]*(?:[{p}*]*\\d){{3,}}[{p}*{alpha}\\d]*";
    let extn = extn_patterns_for_parsing();
    let phone_digit = "(\\d|[\\-\\.\\(\\)]?)";
    let alnum = f"{alpha}\\d";
    let label = f"[{alnum}]+((\\-)*[{alnum}])*";
    let top = f"[{alpha}]+((\\-)*[{alnum}])*";
    Pats {
        valid_start: intern(mut rx, cps_of(f"[{plus}\\d]"), flag_u()),
        unwanted_end: intern(mut rx, cps("(?u)(?:_|[^#\\w])+$"), 0),
        second_number: intern(mut rx, cps("[\\\\/] *x"), 0),
        valid_phone: intern(mut rx, cps_of(f"{valid_phone}(?:{extn})?"), flags_ui()),
        extn: intern(mut rx, cps_of(f"(?:{extn})$"), flags_ui()),
        alpha_phone: intern(mut rx, cps("(?:.*?[A-Za-z]){3}.*"), 0),
        plus_chars: intern(mut rx, cps_of(f"[{plus}]+"), 0),
        separator: intern(mut rx, cps_of(f"[{p}]+"), 0),
        capturing_digit: intern(mut rx, cps("(\\d)"), flag_u()),
        single_intl_prefix: intern(mut rx, cps("[\\d]+(?:[~\\u2053\\u223C\\uFF5E][\\d]+)?"), 0),
        non_digits: intern(mut rx, cps("(?:\\D+)"), 0),
        first_group: intern(mut rx, cps("(\\\\\\d)"), 0),
        first_group_only: intern(mut rx, cps("\\(?\\\\1\\)?"), 0),
        rfc3966_global: intern(mut rx, cps_of(f"^\\+{phone_digit}*\\d{phone_digit}*$"), 0),
        rfc3966_domain: intern(mut rx, cps_of(f"^({label}\\.)*{top}\\.?$"), 0),
        eligible_format: intern(mut rx, cps_of(f"[{p}]*\\\\1[{p}]*(\\\\\\d[{p}]*)*"), 0),
        np_separators: intern(mut rx, cps("[- ]"), 0),
        digits_then_rest: intern(mut rx, cps("(\\d+)(.*)"), 0),
    }
}

// ------------------------------------------------------------ metadata

// The number types, PhoneNumberType's values.
fn t_fixed_line() -> i64 { 0 }
fn t_mobile() -> i64 { 1 }
fn t_fixed_line_or_mobile() -> i64 { 2 }
fn t_toll_free() -> i64 { 3 }
fn t_premium_rate() -> i64 { 4 }
fn t_shared_cost() -> i64 { 5 }
fn t_voip() -> i64 { 6 }
fn t_personal_number() -> i64 { 7 }
fn t_pager() -> i64 { 8 }
fn t_uan() -> i64 { 9 }
fn t_voicemail() -> i64 { 10 }
fn t_unknown() -> i64 { 99 }

fn type_name(t: i64) -> String {
    let names = ["FIXED_LINE", "MOBILE", "FIXED_LINE_OR_MOBILE", "TOLL_FREE", "PREMIUM_RATE", "SHARED_COST", "VOIP", "PERSONAL_NUMBER", "PAGER", "UAN", "VOICEMAIL"];
    if t >= 0 and t < 11 {
        return names[t].to_string();
    }
    if t == 99 { "UNKNOWN".to_string() } else { f"INVALID ({t})" }
}

// The metadata's descriptions, in this order in Meta.descs.
fn desc_names() -> Array[Str, 12] {
    ["general_desc", "fixed_line", "mobile", "toll_free", "premium_rate", "shared_cost", "personal_number", "voip", "pager", "uan", "voicemail", "no_international_dialling"]
}

fn d_general() -> i64 { 0 }
fn d_fixed_line() -> i64 { 1 }
fn d_mobile() -> i64 { 2 }
fn d_no_international() -> i64 { 11 }

// PhoneNumberDesc. pattern is a pattern slot, -1 for None.
#[derive(Clone)]
struct Desc {
    pattern: i64,
    pattern_text: Option[Vec[i64]],
    example: Option[Vec[i64]],
    lengths: Vec[i64],
    local: Vec[i64],
}

// NumberFormat
#[derive(Clone)]
struct Fmt {
    pattern: i64,
    format: Vec[i64],
    leading: Vec[i64],
    np_rule: Option[Vec[i64]],
    np_optional: Option[bool],
    cc_rule: Option[Vec[i64]],
}

// PhoneMetadata
#[derive(Clone)]
struct Meta {
    id: String,
    cc: Option[i64],
    ip: Option[Vec[i64]],
    pip: Option[Vec[i64]],
    np: Option[Vec[i64]],
    extn_prefix: Option[Vec[i64]],
    npp: Option[Vec[i64]],
    npp_pattern: i64,
    transform: Option[Vec[i64]],
    formats: Vec[Fmt],
    intl: Vec[Fmt],
    leading: i64,
    portable: bool,
    descs: Vec[Option[Desc]],
    same_mobile_and_fixed: bool,
}

fn j_opt_cps(j: ref J, key: Str) -> Option[Vec[i64]] {
    match j_get(j, key) {
        J.S(s) => Some(cps_of(s)),
        _ => None,
    }
}

fn j_ints(j: ref J, key: Str) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    if let J.A(items) = j_get(j, key) {
        for it in items.iter() {
            if let J.N(n) = it {
                out.push(*n);
            }
        }
    }
    out
}

fn opt_slot(rx: mut ref Rx, text: ref Option[Vec[i64]]) -> i64 {
    match text {
        Some(t) => intern(mut rx, t, 0),
        None => -1,
    }
}

fn read_desc(rx: mut ref Rx, j: ref J) -> Desc {
    let text = j_opt_cps(j, "p");
    Desc {
        pattern: opt_slot(mut rx, text),
        pattern_text: text,
        example: j_opt_cps(j, "ex"),
        lengths: j_ints(j, "pl"),
        local: j_ints(j, "plo"),
    }
}

fn read_formats(rx: mut ref Rx, j: ref J, key: Str) -> Vec[Fmt] {
    let mut out: Vec[Fmt] = Vec.new();
    if let J.A(items) = j_get(j, key) {
        for f in items.iter() {
            let mut leading: Vec[i64] = Vec.new();
            for p in j_strs(f, "ld").iter() {
                leading.push(intern(mut rx, cps_of(p), 0));
            }
            let np_optional = match j_get(f, "npo") {
                J.B(b) => Some(b),
                _ => None,
            };
            out.push(Fmt {
                pattern: intern(mut rx, cps_of(j_str(f, "p")), 0),
                format: cps_of(j_str(f, "f")),
                leading: leading,
                np_rule: j_opt_cps(f, "npr"),
                np_optional: np_optional,
                cc_rule: j_opt_cps(f, "dcr"),
            });
        }
    }
    out
}

fn read_meta(rx: mut ref Rx, j: ref J) -> Meta {
    let mut descs: Vec[Option[Desc]] = Vec.new();
    for name in desc_names() {
        if j_has(j, name) {
            descs.push(Some(read_desc(mut rx, j_get(j, name))));
        } else {
            descs.push(None);
        }
    }
    // _same_pattern(mobile, fixed_line)
    let same = match (descs[d_mobile()].clone(), descs[d_fixed_line()].clone()) {
        (None, None) => true,
        (Some(a), Some(b)) => a.pattern_text == b.pattern_text,
        _ => false,
    };
    let npp = j_opt_cps(j, "national_prefix_for_parsing");
    let leading = j_opt_cps(j, "leading_digits");
    let cc = match j_get(j, "country_code") {
        J.N(n) => Some(n),
        _ => None,
    };
    Meta {
        id: j_str(j, "id"),
        cc: cc,
        ip: j_opt_cps(j, "international_prefix"),
        pip: j_opt_cps(j, "preferred_international_prefix"),
        np: j_opt_cps(j, "national_prefix"),
        extn_prefix: j_opt_cps(j, "preferred_extn_prefix"),
        npp_pattern: opt_slot(mut rx, npp),
        npp: npp,
        transform: j_opt_cps(j, "national_prefix_transform_rule"),
        formats: read_formats(mut rx, j, "number_format"),
        intl: read_formats(mut rx, j, "intl_number_format"),
        leading: opt_slot(mut rx, leading),
        portable: j_bool(j, "mobile_number_portable_region"),
        descs: descs,
        same_mobile_and_fixed: same,
    }
}

// asyoutypeformatter's _EMPTY_METADATA
fn empty_meta() -> Meta {
    let mut descs: Vec[Option[Desc]] = Vec.new();
    for _ in 0..12 {
        descs.push(None);
    }
    Meta {
        id: String.new(),
        cc: None,
        ip: Some(cps("NA")),
        pip: None,
        np: None,
        extn_prefix: None,
        npp: None,
        npp_pattern: -1,
        transform: None,
        formats: Vec.new(),
        intl: Vec.new(),
        leading: -1,
        portable: false,
        descs: descs,
        same_mobile_and_fixed: true,
    }
}

// ------------------------------------------------------------ the library's state

struct Ctx {
    rx: Rx,
    pats: Pats,
    metas: Vec[Meta],
    by_region: Map[String, i64],
    by_code: Map[i64, i64],
    // COUNTRY_CODE_TO_REGION_CODE, and its keys in order
    codes: Map[i64, Vec[String]],
    supported: Set[String],
    empty: i64,
}

// int(s) for a string of ASCII digits
fn decimal(s: ref String) -> Option[i64] {
    if s.len() == 0 {
        return None;
    }
    let mut v = 0;
    for b in s.bytes() {
        if b < 48 or b > 57 {
            return None;
        }
        v = v * 10 + (b as i64 - 48);
    }
    Some(v)
}

fn non_geo() -> Str { "001" }
fn nanpa_code() -> i64 { 1 }

fn load_ctx(codes_text: ref String, meta_text: ref String) -> Result[Ctx, String] {
    let mut rx = new_rx();
    let pats = library_patterns(mut rx);
    let mut codes: Map[i64, Vec[String]] = Map.new();
    let mut supported: Set[String] = Set.new();
    for line in codes_text.split("\n") {
        if line.len() == 0 {
            continue;
        }
        let parts: Vec[String] = line.split(" ").map(|p| p.to_string()).collect();
        let cc = match decimal(parts[0]) {
            Some(n) => n,
            None => return Err(f"bad calling code line: {line}"),
        };
        let mut regions: Vec[String] = Vec.new();
        let mut k = 1;
        while k < parts.len() {
            regions.push(parts[k].clone());
            k += 1;
        }
        if not (regions.len() == 1 and regions[0] == non_geo()) {
            for r in regions.iter() {
                if r != non_geo() {
                    supported.insert(r.clone());
                }
            }
        }
        codes.insert(cc, regions);
    }
    let mut metas: Vec[Meta] = Vec.new();
    let mut by_region: Map[String, i64] = Map.new();
    let mut by_code: Map[i64, i64] = Map.new();
    for line in meta_text.split("\n") {
        if line.len() == 0 {
            continue;
        }
        let j = json_line(line.to_string())?;
        let m = read_meta(mut rx, j);
        let i = metas.len();
        if m.id == non_geo() {
            by_code.insert(m.cc.clone().unwrap_or(0), i);
        } else {
            by_region.insert(m.id.clone(), i);
        }
        metas.push(m);
    }
    metas.push(empty_meta());
    let empty = metas.len() - 1;
    Ok(Ctx { rx: rx, pats: pats, metas: metas, by_region: by_region, by_code: by_code, codes: codes, supported: supported, empty: empty })
}

// PhoneMetadata.metadata_for_region, -1 for None
fn meta_for_region(ctx: ref Ctx, region: ref String) -> i64 {
    let up = region.to_uppercase();
    if let Some(i) = ctx.by_region.get(up) {
        return i;
    }
    -1
}

fn meta_for_opt_region(ctx: ref Ctx, region: ref Option[String]) -> i64 {
    match region {
        Some(r) => meta_for_region(ctx, r),
        None => -1,
    }
}

fn meta_for_nongeo(ctx: ref Ctx, cc: i64) -> i64 {
    if let Some(i) = ctx.by_code.get(cc) {
        return i;
    }
    -1
}

fn meta_for_region_or_code(ctx: ref Ctx, cc: i64, region: ref String) -> i64 {
    if region == non_geo() {
        return meta_for_nongeo(ctx, cc);
    }
    meta_for_region(ctx, region)
}

// A metadata index Python would dereference: the jobs only reach vendored
// metadata (oracle.py checks), and an absent one reads as the empty one.
fn mref(ctx: ref Ctx, mi: i64) -> i64 {
    if mi < 0 { ctx.empty } else { mi }
}

fn desc_of(ctx: ref Ctx, mi: i64, slot: i64) -> Option[Desc] {
    ctx.metas[mi].descs[slot].clone()
}

// ------------------------------------------------------------ PhoneNumber

fn src_unspecified() -> i64 { 0 }
fn src_plus() -> i64 { 1 }
fn src_idd() -> i64 { 5 }
fn src_without_plus() -> i64 { 10 }
fn src_default() -> i64 { 20 }

#[derive(Clone)]
struct Num {
    cc: Option[i64],
    nn: Option[i64],
    ext: Option[Vec[i64]],
    ilz: Option[bool],
    nlz: Option[i64],
    raw: Option[Vec[i64]],
    source: i64,
    carrier: Option[Vec[i64]],
}

fn new_num() -> Num {
    Num { cc: None, nn: None, ext: None, ilz: None, nlz: None, raw: None, source: src_unspecified(), carrier: None }
}

// PhoneNumber.__eq__: the leading-zero flag compares as a bool.
fn num_eq(a: ref Num, b: ref Num) -> bool {
    a.cc == b.cc and a.nn == b.nn and a.ext == b.ext and a.ilz.unwrap_or(false) == b.ilz.unwrap_or(false) and a.nlz == b.nlz and a.raw == b.raw and a.source == b.source and a.carrier == b.carrier
}

fn opt_int(x: Option[i64]) -> String {
    match x {
        Some(n) => f"{n}",
        None => "None".to_string(),
    }
}

fn py_bool(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

// str(PhoneNumber)
fn num_str(n: ref Num) -> String {
    let mut s = f"Country Code: {opt_int(n.cc)} National Number: {opt_int(n.nn)}";
    if let Some(z) = n.ilz {
        s.push_str(f" Leading Zero(s): {py_bool(z)}");
    }
    if let Some(k) = n.nlz {
        s.push_str(f" Number of leading zeros: {k}");
    }
    if let Some(e) = n.ext {
        s.push_str(f" Extension: {to_string(e)}");
    }
    if n.source != src_unspecified() {
        s.push_str(f" Country Code Source: {n.source}");
    }
    if let Some(c) = n.carrier {
        s.push_str(f" Preferred Domestic Carrier Code: {to_string(c)}");
    }
    s
}

// NumberParseException, printed "(type) message"
struct PErr {
    kind: i64,
    msg: String,
}

fn e_invalid_country_code() -> i64 { 0 }
fn e_not_a_number() -> i64 { 1 }
fn e_too_short_after_idd() -> i64 { 2 }
fn e_too_short_nsn() -> i64 { 3 }
fn e_too_long() -> i64 { 4 }

fn perr(kind: i64, msg: Str) -> PErr {
    PErr { kind: kind, msg: msg.to_string() }
}

fn perr_text(e: ref PErr) -> String {
    f"({e.kind}) {e.msg}"
}

// ------------------------------------------------------------ small string pieces

fn vstr(n: i64) -> Vec[i64] {
    cps_of(f"{n}")
}

fn starts_with_v(s: ref Vec[i64], p: ref Vec[i64]) -> bool {
    if p.len() > s.len() {
        return false;
    }
    let mut k = 0;
    while k < p.len() {
        if s[k] != p[k] {
            return false;
        }
        k += 1;
    }
    true
}

fn ends_with_v(s: ref Vec[i64], p: ref Vec[i64]) -> bool {
    if p.len() > s.len() {
        return false;
    }
    let off = s.len() - p.len();
    let mut k = 0;
    while k < p.len() {
        if s[off + k] != p[k] {
            return false;
        }
        k += 1;
    }
    true
}

fn rfind_seq(s: ref Vec[i64], needle: ref Vec[i64]) -> i64 {
    let mut i = s.len() - needle.len();
    while i >= 0 {
        let mut k = 0;
        while k < needle.len() and s[i + k] == needle[k] {
            k += 1;
        }
        if k == needle.len() {
            return i;
        }
        i -= 1;
    }
    -1
}

fn opt_text(x: ref Option[Vec[i64]]) -> Vec[i64] {
    match x {
        Some(t) => t.clone(),
        None => Vec.new(),
    }
}

fn opt_nonempty(x: ref Option[Vec[i64]]) -> bool {
    match x {
        Some(t) => t.len() > 0,
        None => false,
    }
}

fn region_text(r: ref Option[String]) -> String {
    match r {
        Some(s) => s.clone(),
        None => "None".to_string(),
    }
}

// ------------------------------------------------------------ normalizing

// c.upper(), for the characters the library's maps can hold
fn map_upper(c: i64) -> i64 {
    if c >= 97 and c <= 122 {
        return c - 32;
    }
    if c == 0x131 {
        return 73;
    }
    if c == 0x17F {
        return 83;
    }
    c
}

fn letter_digit(u: i64) -> i64 {
    let k = u - 65;
    if k < 15 { 2 + k / 3 } else if k < 19 { 7 } else if k < 22 { 8 } else { 9 }
}

fn map_alpha_phone() -> i64 { 0 }
fn map_diallable() -> i64 { 1 }
fn map_grouping() -> i64 { 2 }

// The value one of the library's maps gives a character (looked up as
// c.upper()), -1 when the map has none: _ALPHA_PHONE_MAPPINGS (letters to
// keypad digits, ASCII digits), _DIALLABLE_CHAR_MAPPINGS (ASCII digits,
// + * #) and _ALL_PLUS_NUMBER_GROUPING_SYMBOLS (letters upper-cased,
// digits, dashes, slashes, spaces and dots).
fn map_char(which: i64, c: i64) -> i64 {
    let u = map_upper(c);
    if u >= 48 and u <= 57 {
        return u;
    }
    if which == map_alpha_phone() {
        if u >= 65 and u <= 90 {
            return 48 + letter_digit(u);
        }
        return -1;
    }
    if which == map_diallable() {
        if u == 43 or u == 42 or u == 35 {
            return u;
        }
        return -1;
    }
    if u >= 65 and u <= 90 {
        return u;
    }
    if u == 45 or u == 0xFF0D or (u >= 0x2010 and u <= 0x2015) or u == 0x2212 {
        return 45;
    }
    if u == 47 or u == 0xFF0F {
        return 47;
    }
    if u == 32 or u == 0x3000 or u == 0x2060 {
        return 32;
    }
    if u == 46 or u == 0xFF0E {
        return 46;
    }
    -1
}

fn normalize_helper(s: ref Vec[i64], which: i64, remove_non_matches: bool) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s {
        let d = map_char(which, c);
        if d >= 0 {
            out.push(d);
        } else if not remove_non_matches {
            out.push(c);
        }
    }
    out
}

// unicode_util.digit(c, -1), for the decimal digits
fn unicode_digit(c: i64) -> i64 {
    if is_decimal(c) { digit_value(c) } else { -1 }
}

fn normalize_digits_only(s: ref Vec[i64], keep_non_digits: bool) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s {
        let d = unicode_digit(c);
        if d != -1 {
            out.push(48 + d);
        } else if keep_non_digits {
            out.push(c);
        }
    }
    out
}

fn normalize_diallable_chars_only(s: ref Vec[i64]) -> Vec[i64] {
    normalize_helper(s, map_diallable(), true)
}

fn convert_alpha_characters_in_number(s: ref Vec[i64]) -> Vec[i64] {
    normalize_helper(s, map_alpha_phone(), false)
}

fn normalize(ctx: mut ref Ctx, s: ref Vec[i64]) -> Vec[i64] {
    if rx_full(mut ctx.rx, ctx.pats.alpha_phone, s) {
        return normalize_helper(s, map_alpha_phone(), true);
    }
    normalize_digits_only(s, false)
}

// ------------------------------------------------------------ regions and codes

fn is_valid_region(ctx: ref Ctx, r: ref Option[String]) -> bool {
    match r {
        Some(s) => ctx.supported.contains(s),
        None => false,
    }
}

fn has_valid_cc(ctx: ref Ctx, cc: i64) -> bool {
    ctx.codes.get(cc).is_some()
}

fn regions_for_cc(ctx: ref Ctx, cc: i64) -> Vec[String] {
    match ctx.codes.get(cc) {
        Some(rs) => rs.clone(),
        None => Vec.new(),
    }
}

fn region_for_cc(ctx: ref Ctx, cc: i64) -> String {
    let rs = regions_for_cc(ctx, cc);
    if rs.len() == 0 { "ZZ".to_string() } else { rs[0].clone() }
}

fn cc_for_valid_region(ctx: ref Ctx, r: ref String) -> i64 {
    let mi = meta_for_region(ctx, r);
    if mi < 0 {
        return 0;
    }
    ctx.metas[mi].cc.unwrap_or(0)
}

fn cc_for_region(ctx: ref Ctx, r: ref Option[String]) -> i64 {
    if not is_valid_region(ctx, r) {
        return 0;
    }
    cc_for_valid_region(ctx, r.clone().unwrap_or(String.new()))
}

fn is_nanpa_country(ctx: ref Ctx, r: ref Option[String]) -> bool {
    match r {
        Some(s) => regions_for_cc(ctx, nanpa_code()).contains(s),
        None => false,
    }
}

// ndd_prefix_for_region
fn ndd_prefix_for_region(ctx: ref Ctx, r: ref Option[String], strip_non_digits: bool) -> Option[Vec[i64]] {
    let mi = meta_for_opt_region(ctx, r);
    if mi < 0 {
        return None;
    }
    let np = opt_text(ctx.metas[mi].np);
    if np.len() == 0 {
        return None;
    }
    if strip_non_digits {
        return Some(replace_char(np, 126, Vec.new()));
    }
    Some(np)
}

fn country_mobile_token(cc: i64) -> Vec[i64] {
    if cc == 54 { cps("9") } else { Vec.new() }
}

fn geo_mobile_country(cc: i64) -> bool {
    cc == 86 or cc == 52 or cc == 54 or cc == 55 or cc == 62
}

fn is_number_type_geographical(t: i64, cc: i64) -> bool {
    t == t_fixed_line() or t == t_fixed_line_or_mobile() or (geo_mobile_country(cc) and t == t_mobile())
}

// ------------------------------------------------------------ matching against the metadata

fn desc_slot_for_type(t: i64) -> i64 {
    if t == t_premium_rate() { return 4; }
    if t == t_toll_free() { return 3; }
    if t == t_mobile() { return 2; }
    if t == t_fixed_line() or t == t_fixed_line_or_mobile() { return 1; }
    if t == t_shared_cost() { return 5; }
    if t == t_voip() { return 7; }
    if t == t_personal_number() { return 6; }
    if t == t_pager() { return 8; }
    if t == t_uan() { return 9; }
    if t == t_voicemail() { return 10; }
    0
}

// _match_national_number(number, desc, False). _match is
// pattern.match(n) and fullmatch(pattern, n), or the match alone when a
// prefix match is allowed; a full match implies a match, so without the
// prefix allowance the full match decides.
fn match_national_number(ctx: mut ref Ctx, number: ref Vec[i64], desc: ref Option[Desc]) -> bool {
    match desc {
        Some(d) => {
            if d.pattern < 0 or opt_text(d.pattern_text).len() == 0 {
                return false;
            }
            rx_full(mut ctx.rx, d.pattern, number)
        }
        None => false,
    }
}

fn is_number_matching_desc(ctx: mut ref Ctx, number: ref Vec[i64], desc: ref Option[Desc]) -> bool {
    match desc {
        Some(d) => {
            if d.lengths.len() > 0 and not d.lengths.contains(number.len()) {
                return false;
            }
            match_national_number(mut ctx, number, desc)
        }
        None => false,
    }
}

fn number_type_helper(ctx: mut ref Ctx, number: ref Vec[i64], mi: i64) -> i64 {
    if not is_number_matching_desc(mut ctx, number, desc_of(ctx, mi, d_general())) {
        return t_unknown();
    }
    let order = [t_premium_rate(), t_toll_free(), t_shared_cost(), t_voip(), t_personal_number(), t_pager(), t_uan(), t_voicemail()];
    for t in order {
        if is_number_matching_desc(mut ctx, number, desc_of(ctx, mi, desc_slot_for_type(t))) {
            return t;
        }
    }
    let same = ctx.metas[mi].same_mobile_and_fixed;
    if is_number_matching_desc(mut ctx, number, desc_of(ctx, mi, d_fixed_line())) {
        if same {
            return t_fixed_line_or_mobile();
        }
        if is_number_matching_desc(mut ctx, number, desc_of(ctx, mi, d_mobile())) {
            return t_fixed_line_or_mobile();
        }
        return t_fixed_line();
    }
    if not same and is_number_matching_desc(mut ctx, number, desc_of(ctx, mi, d_mobile())) {
        return t_mobile();
    }
    t_unknown()
}

fn has_possible_number_data(desc: ref Option[Desc]) -> bool {
    match desc {
        Some(d) => d.lengths.len() != 1 or d.lengths[0] != -1,
        None => false,
    }
}

fn desc_has_data(desc: ref Option[Desc]) -> bool {
    match desc {
        Some(d) => d.example.is_some() or has_possible_number_data(desc) or d.pattern >= 0,
        None => false,
    }
}

fn v_res_possible() -> i64 { 0 }
fn v_res_local_only() -> i64 { 4 }
fn v_res_invalid_cc() -> i64 { 1 }
fn v_res_too_short() -> i64 { 2 }
fn v_res_invalid_length() -> i64 { 5 }
fn v_res_too_long() -> i64 { 3 }

fn validation_name(v: i64) -> String {
    if v == 0 { return "IS_POSSIBLE".to_string(); }
    if v == 4 { return "IS_POSSIBLE_LOCAL_ONLY".to_string(); }
    if v == 1 { return "INVALID_COUNTRY_CODE".to_string(); }
    if v == 2 { return "TOO_SHORT".to_string(); }
    if v == 5 { return "INVALID_LENGTH".to_string(); }
    if v == 3 { return "TOO_LONG".to_string(); }
    f"INVALID ({v})"
}

fn sorted_ints(v: own Vec[i64]) -> Vec[i64] {
    let mut out = v;
    out.sort();
    out
}

fn test_number_length(ctx: mut ref Ctx, number: ref Vec[i64], mi: i64, t: i64) -> i64 {
    let desc = desc_of(ctx, mi, desc_slot_for_type(t));
    let general = desc_of(ctx, mi, d_general());
    let general_lengths = match general {
        Some(g) => g.lengths.clone(),
        None => Vec.new(),
    };
    let mut lengths: Vec[i64] = general_lengths.clone();
    let mut local: Vec[i64] = Vec.new();
    if let Some(ref d) = desc {
        lengths = if d.lengths.len() == 0 { general_lengths.clone() } else { d.lengths.clone() };
        local = d.local.clone();
    }
    if t == t_fixed_line_or_mobile() {
        if not has_possible_number_data(desc_of(ctx, mi, d_fixed_line())) {
            return test_number_length(mut ctx, number, mi, t_mobile());
        }
        let mobile = desc_of(ctx, mi, d_mobile());
        if has_possible_number_data(mobile) {
            if let Some(md) = mobile {
                if md.lengths.len() == 0 {
                    push_all(mut lengths, general_lengths);
                } else {
                    push_all(mut lengths, md.lengths);
                }
                lengths = sorted_ints(lengths);
                if local.len() == 0 {
                    local = md.local.clone();
                } else {
                    push_all(mut local, md.local);
                    local = sorted_ints(local);
                }
            }
        }
    }
    if desc.is_none() {
        return v_res_invalid_length();
    }
    let n = number.len();
    if local.contains(n) {
        return v_res_local_only();
    }
    let minimum = lengths[0];
    if minimum == n {
        return v_res_possible();
    }
    if minimum > n {
        return v_res_too_short();
    }
    if lengths[lengths.len() - 1] < n {
        return v_res_too_long();
    }
    let mut k = 1;
    while k < lengths.len() {
        if lengths[k] == n {
            return v_res_possible();
        }
        k += 1;
    }
    v_res_invalid_length()
}

// ------------------------------------------------------------ the number's parts

fn national_significant_number(n: ref Num) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    if n.ilz == Some(true) {
        let zeros = n.nlz.unwrap_or(1);
        let mut k = 0;
        while k < zeros {
            out.push(48);
            k += 1;
        }
    }
    push_all(mut out, cps_of(opt_int(n.nn)));
    out
}

fn num_cc(n: ref Num) -> i64 {
    n.cc.unwrap_or(0)
}

fn region_code_for_number_from_list(ctx: mut ref Ctx, n: ref Num, regions: ref Vec[String]) -> Option[String] {
    let nsn = national_significant_number(n);
    for r in regions.iter() {
        let mi = meta_for_region(ctx, r);
        if mi < 0 {
            continue;
        }
        let leading = ctx.metas[mi].leading;
        if leading >= 0 {
            if rx_match(mut ctx.rx, leading, nsn).is_some() {
                return Some(r.clone());
            }
        } else if number_type_helper(mut ctx, nsn, mi) != t_unknown() {
            return Some(r.clone());
        }
    }
    None
}

fn region_code_for_number(ctx: mut ref Ctx, n: ref Num) -> Option[String] {
    let regions = match ctx.codes.get(num_cc(n)) {
        Some(rs) => rs.clone(),
        None => return None,
    };
    if regions.len() == 1 {
        return Some(regions[0].clone());
    }
    region_code_for_number_from_list(mut ctx, n, regions)
}

fn meta_for_number_region(ctx: ref Ctx, n: ref Num, region: ref Option[String]) -> i64 {
    match region {
        Some(r) => meta_for_region_or_code(ctx, num_cc(n), r),
        None => -1,
    }
}

fn number_type(ctx: mut ref Ctx, n: ref Num) -> i64 {
    let region = region_code_for_number(mut ctx, n);
    let mi = meta_for_number_region(ctx, n, region);
    if mi < 0 {
        return t_unknown();
    }
    number_type_helper(mut ctx, national_significant_number(n), mi)
}

fn is_valid_number_for_region(ctx: mut ref Ctx, n: ref Num, region: ref Option[String]) -> bool {
    let r = match region {
        Some(r) => r.clone(),
        None => return false,
    };
    let mi = meta_for_region_or_code(ctx, num_cc(n), r.to_uppercase());
    if mi < 0 {
        return false;
    }
    if r != non_geo() and num_cc(n) != cc_for_valid_region(ctx, r) {
        return false;
    }
    number_type_helper(mut ctx, national_significant_number(n), mi) != t_unknown()
}

fn is_valid_number(ctx: mut ref Ctx, n: ref Num) -> bool {
    let region = region_code_for_number(mut ctx, n);
    is_valid_number_for_region(mut ctx, n, region)
}

fn is_possible_number_with_reason(ctx: mut ref Ctx, n: ref Num) -> i64 {
    let nsn = national_significant_number(n);
    let cc = num_cc(n);
    if not has_valid_cc(ctx, cc) {
        return v_res_invalid_cc();
    }
    let region = region_for_cc(ctx, cc);
    let mi = mref(ctx, meta_for_region_or_code(ctx, cc, region));
    test_number_length(mut ctx, nsn, mi, t_unknown())
}

fn is_number_geographical(ctx: mut ref Ctx, n: ref Num) -> bool {
    let t = number_type(mut ctx, n);
    is_number_type_geographical(t, num_cc(n))
}

fn can_be_internationally_dialled(ctx: mut ref Ctx, n: ref Num) -> bool {
    let region = region_code_for_number(mut ctx, n);
    let mi = meta_for_opt_region(ctx, region);
    if mi < 0 {
        return true;
    }
    let nsn = national_significant_number(n);
    not is_number_matching_desc(mut ctx, nsn, desc_of(ctx, mi, d_no_international()))
}

fn is_mobile_number_portable_region(ctx: ref Ctx, r: ref String) -> bool {
    let mi = meta_for_region(ctx, r);
    if mi < 0 {
        return false;
    }
    ctx.metas[mi].portable
}

fn supported_types_for_region(ctx: ref Ctx, r: ref String) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    if not is_valid_region(ctx, Some(r.clone())) {
        return out;
    }
    let mi = meta_for_region(ctx, r);
    if mi < 0 {
        return out;
    }
    let mut t = 0;
    while t <= t_voicemail() {
        if t != t_fixed_line_or_mobile() and desc_has_data(desc_of(ctx, mi, desc_slot_for_type(t))) {
            out.push(t);
        }
        t += 1;
    }
    out
}

// ------------------------------------------------------------ parse

fn is_viable_phone_number(ctx: mut ref Ctx, s: ref Vec[i64]) -> bool {
    if s.len() < 2 {
        return false;
    }
    rx_full(mut ctx.rx, ctx.pats.valid_phone, s)
}

fn extract_possible_number(ctx: mut ref Ctx, s: ref Vec[i64]) -> Vec[i64] {
    let start = match rx_search(mut ctx.rx, ctx.pats.valid_start, s) {
        Some(m) => m.start,
        None => return Vec.new(),
    };
    let mut number = slice(s, start, s.len());
    if let Some(m) = rx_search(mut ctx.rx, ctx.pats.unwanted_end, number) {
        number = slice(number, 0, m.start);
    }
    if let Some(m) = rx_search(mut ctx.rx, ctx.pats.second_number, number) {
        number = slice(number, 0, m.start);
    }
    number
}

fn extract_phone_context(s: ref Vec[i64], at: i64) -> Option[Vec[i64]] {
    if at == -1 {
        return None;
    }
    let start = at + 15;
    if start >= s.len() {
        return Some(Vec.new());
    }
    let mut end = start;
    while end < s.len() and s[end] != 59 {
        end += 1;
    }
    Some(slice(s, start, end))
}

fn build_national_number_for_parsing(ctx: mut ref Ctx, s: ref Vec[i64]) -> Result[Vec[i64], PErr] {
    let at = find_seq(s, cps(";phone-context="), 0);
    let context = extract_phone_context(s, at);
    if let Some(ref c) = context {
        let ok = c.len() > 0 and (rx_full(mut ctx.rx, ctx.pats.rfc3966_global, c) or rx_full(mut ctx.rx, ctx.pats.rfc3966_domain, c));
        if not ok {
            return Err(perr(e_not_a_number(), "The phone-context value is invalid"));
        }
    }
    let mut number: Vec[i64] = Vec.new();
    match context {
        Some(c) => {
            if c[0] == 43 {
                number = c.clone();
            }
            let tel = find_seq(s, cps("tel:"), 0);
            let from = if tel >= 0 { tel + 4 } else { 0 };
            push_all(mut number, slice(s, from, at));
        }
        None => {
            number = extract_possible_number(mut ctx, s);
        }
    }
    let isdn = find_seq(number, cps(";isub="), 0);
    if isdn > 0 {
        number = slice(number, 0, isdn);
    }
    Ok(number)
}

// _maybe_strip_extension: (extension, number without it)
fn maybe_strip_extension(ctx: mut ref Ctx, s: ref Vec[i64]) -> (Vec[i64], Vec[i64]) {
    if let Some(m) = rx_search(mut ctx.rx, ctx.pats.extn, s) {
        let head = slice(s, 0, m.start);
        if is_viable_phone_number(mut ctx, head) {
            let mut g = 1;
            while g <= m.spans.len() {
                if let Some(text) = group_of(s, m, g) {
                    return (text, head);
                }
                g += 1;
            }
        }
    }
    (Vec.new(), s.clone())
}

fn extract_country_code(ctx: ref Ctx, s: ref Vec[i64]) -> (i64, Vec[i64]) {
    if s.len() == 0 or s[0] == 48 {
        return (0, s.clone());
    }
    let mut k = 1;
    let mut value = 0;
    while k <= s.len() and k <= 3 {
        // int() of the first k characters, which may be any decimal digits
        let d = unicode_digit(s[k - 1]);
        if d < 0 {
            return (0, s.clone());
        }
        value = value * 10 + d;
        if has_valid_cc(ctx, value) {
            return (value, slice(s, k, s.len()));
        }
        k += 1;
    }
    (0, s.clone())
}

fn parse_prefix_as_idd(ctx: mut ref Ctx, idd: i64, s: ref Vec[i64]) -> (bool, Vec[i64]) {
    if let Some(m) = rx_match(mut ctx.rx, idd, s) {
        let rest = slice(s, m.end, s.len());
        if let Some(dm) = rx_search(mut ctx.rx, ctx.pats.capturing_digit, rest) {
            let digit = group_of(rest, dm, 1).unwrap_or(Vec.new());
            if eq_ascii(normalize_digits_only(digit, false), "0") {
                return (false, s.clone());
            }
        }
        return (true, rest);
    }
    (false, s.clone())
}

fn maybe_strip_i18n_prefix_and_normalize(ctx: mut ref Ctx, s: ref Vec[i64], idd_text: ref Vec[i64]) -> (i64, Vec[i64]) {
    if s.len() == 0 {
        return (src_default(), s.clone());
    }
    if let Some(m) = rx_match(mut ctx.rx, ctx.pats.plus_chars, s) {
        let rest = slice(s, m.end, s.len());
        return (src_plus(), normalize(mut ctx, rest));
    }
    let idd = intern(mut ctx.rx, idd_text, 0);
    let number = normalize(mut ctx, s);
    let (stripped, rest) = parse_prefix_as_idd(mut ctx, idd, number);
    if stripped {
        return (src_idd(), rest);
    }
    (src_default(), rest)
}

// _maybe_strip_national_prefix_carrier_code: (carrier code, which is None
// when the carrier group did not take part, the number, stripped)
fn maybe_strip_national_prefix_carrier_code(ctx: mut ref Ctx, s: ref Vec[i64], mi: i64) -> (Option[Vec[i64]], Vec[i64], bool) {
    let npp = ctx.metas[mi].npp_pattern;
    if s.len() == 0 or not opt_nonempty(ctx.metas[mi].npp) {
        return (Some(Vec.new()), s.clone(), false);
    }
    let m = match rx_match(mut ctx.rx, npp, s) {
        Some(m) => m,
        None => return (Some(Vec.new()), s.clone(), false),
    };
    let general = desc_of(ctx, mi, d_general());
    let viable_original = match_national_number(mut ctx, s, general);
    let groups = rx_groups(mut ctx.rx, npp);
    let transform = opt_text(ctx.metas[mi].transform);
    let last_missing = groups == 0 or group_of(s, m, groups).is_none();
    if transform.len() == 0 or last_missing {
        let rest = slice(s, m.end, s.len());
        if viable_original and not match_national_number(mut ctx, rest, general) {
            return (Some(Vec.new()), s.clone(), false);
        }
        let mut carrier = Some(Vec.new());
        if groups > 0 {
            carrier = group_of(s, m, 1);
        }
        return (carrier, rest, true);
    }
    let transformed = rx_sub(mut ctx.rx, npp, transform, s, 1);
    if viable_original and not match_national_number(mut ctx, transformed, general) {
        return (Some(Vec.new()), s.clone(), false);
    }
    let mut carrier = Some(Vec.new());
    if groups > 1 {
        carrier = group_of(s, m, 1);
    }
    (carrier, transformed, true)
}

fn maybe_extract_country_code(ctx: mut ref Ctx, s: ref Vec[i64], mi: i64, keep_raw: bool, n: mut ref Num) -> Result[(i64, Vec[i64]), PErr] {
    if s.len() == 0 {
        return Ok((0, Vec.new()));
    }
    let mut idd_text = cps("NonMatch");
    if mi >= 0 {
        if let Some(ip) = ctx.metas[mi].ip {
            idd_text = ip.clone();
        }
    }
    let (source, full) = maybe_strip_i18n_prefix_and_normalize(mut ctx, s, idd_text);
    if keep_raw {
        n.source = source;
    }
    if source != src_default() {
        if full.len() <= 2 {
            return Err(perr(e_too_short_after_idd(), "Phone number had an IDD, but after this was not long enough to be a viable phone number."));
        }
        let (cc, rest) = extract_country_code(ctx, full);
        if cc != 0 {
            n.cc = Some(cc);
            return Ok((cc, rest));
        }
        return Err(perr(e_invalid_country_code(), "Country calling code supplied was not recognised."));
    }
    if mi >= 0 {
        let default_cc = ctx.metas[mi].cc.unwrap_or(0);
        let cc_text = vstr(default_cc);
        if starts_with_v(full, cc_text) {
            let potential = slice(full, cc_text.len(), full.len());
            let general = desc_of(ctx, mi, d_general());
            let (_, potential, _) = maybe_strip_national_prefix_carrier_code(mut ctx, potential, mi);
            let take = (not match_national_number(mut ctx, full, general) and match_national_number(mut ctx, potential, general)) or test_number_length(mut ctx, full, mi, t_unknown()) == v_res_too_long();
            if take {
                if keep_raw {
                    n.source = src_without_plus();
                }
                n.cc = Some(default_cc);
                return Ok((default_cc, potential));
            }
        }
    }
    n.cc = Some(0);
    Ok((0, Vec.new()))
}

fn set_italian_leading_zeros(s: ref Vec[i64], n: mut ref Num) {
    if s.len() > 1 and s[0] == 48 {
        n.ilz = Some(true);
        let mut zeros = 1;
        while zeros < s.len() - 1 and s[zeros] == 48 {
            zeros += 1;
        }
        if zeros != 1 {
            n.nlz = Some(zeros);
        }
    }
}

// int() of a string of ASCII digits; the national number is at most 17
fn to_long(s: ref Vec[i64]) -> i64 {
    let mut v = 0;
    for c in s {
        v = v * 10 + (c - 48);
    }
    v
}

fn parse_full(ctx: mut ref Ctx, s: ref Vec[i64], region: ref Option[String], keep_raw: bool, check_region: bool) -> Result[Num, PErr] {
    let mut n = new_num();
    if s.len() > 250 {
        return Err(perr(e_too_long(), "The string supplied was too long to parse."));
    }
    let national = build_national_number_for_parsing(mut ctx, s)?;
    if not is_viable_phone_number(mut ctx, national) {
        return Err(perr(e_not_a_number(), "The string supplied did not seem to be a phone number."));
    }
    if check_region and not is_valid_region(ctx, region) {
        if national.len() == 0 or rx_match(mut ctx.rx, ctx.pats.plus_chars, national).is_none() {
            return Err(perr(e_invalid_country_code(), "Missing or invalid default region."));
        }
    }
    if keep_raw {
        n.raw = Some(s.clone());
    }
    let (extension, national) = maybe_strip_extension(mut ctx, national);
    if extension.len() > 0 {
        n.ext = Some(extension);
    }
    let mut mi = meta_for_opt_region(ctx, region);
    let mut cc = 0;
    let mut normalized: Vec[i64] = Vec.new();
    match maybe_extract_country_code(mut ctx, national, mi, keep_raw, mut n) {
        Ok((c, rest)) => {
            cc = c;
            normalized = rest;
        }
        Err(e) => {
            let plus = rx_match(mut ctx.rx, ctx.pats.plus_chars, national);
            match plus {
                Some(pm) if e.kind == e_invalid_country_code() => {
                    let rest = slice(national, pm.end, national.len());
                    let (c, r) = maybe_extract_country_code(mut ctx, rest, mi, keep_raw, mut n)?;
                    if c == 0 {
                        return Err(perr(e_invalid_country_code(), "Could not interpret numbers after plus-sign."));
                    }
                    cc = c;
                    normalized = r;
                }
                _ => return Err(e),
            }
        }
    }
    if cc != 0 {
        let number_region = region_for_cc(ctx, cc);
        if region.clone() != Some(number_region.clone()) {
            mi = meta_for_region_or_code(ctx, cc, number_region);
        }
    } else {
        push_all(mut normalized, normalize(mut ctx, national));
        if region.is_some() {
            cc = if mi >= 0 { ctx.metas[mi].cc.unwrap_or(0) } else { 0 };
            n.cc = Some(cc);
        } else if keep_raw {
            n.source = src_unspecified();
        }
    }
    if normalized.len() < 2 {
        return Err(perr(e_too_short_nsn(), "The string supplied is too short to be a phone number."));
    }
    if mi >= 0 {
        let (carrier, potential, _) = maybe_strip_national_prefix_carrier_code(mut ctx, normalized, mi);
        let result = test_number_length(mut ctx, potential, mi, t_unknown());
        if result != v_res_too_short() and result != v_res_local_only() and result != v_res_invalid_length() {
            normalized = potential;
            if keep_raw and opt_nonempty(carrier) {
                n.carrier = carrier;
            }
        }
    }
    if normalized.len() < 2 {
        return Err(perr(e_too_short_nsn(), "The string supplied is too short to be a phone number."));
    }
    if normalized.len() > 17 {
        return Err(perr(e_too_long(), "The string supplied is too long to be a phone number."));
    }
    set_italian_leading_zeros(normalized, mut n);
    n.nn = Some(to_long(normalized));
    Ok(n)
}

fn parse_number(ctx: mut ref Ctx, s: ref Vec[i64], region: ref Option[String], keep_raw: bool) -> Result[Num, PErr] {
    parse_full(mut ctx, s, region, keep_raw, true)
}

// ------------------------------------------------------------ format

fn f_e164() -> i64 { 0 }
fn f_international() -> i64 { 1 }
fn f_national() -> i64 { 2 }
fn f_rfc3966() -> i64 { 3 }

fn prefix_with_cc(cc: i64, fmt: i64, formatted: ref Vec[i64]) -> Vec[i64] {
    if fmt == f_e164() {
        return cat(cps_of(f"+{cc}"), formatted);
    }
    if fmt == f_international() {
        return cat(cps_of(f"+{cc} "), formatted);
    }
    if fmt == f_rfc3966() {
        return cat(cps_of(f"tel:+{cc}-"), formatted);
    }
    formatted.clone()
}

fn choose_formatting_pattern(ctx: mut ref Ctx, formats: ref Vec[Fmt], nn: ref Vec[i64]) -> Option[Fmt] {
    for f in formats.iter() {
        let size = f.leading.len();
        let leading_ok = size == 0 or rx_match(mut ctx.rx, f.leading[size - 1], nn).is_some();
        if leading_ok and rx_full(mut ctx.rx, f.pattern, nn) {
            return Some(f.clone());
        }
    }
    None
}

fn format_nsn_using_pattern(ctx: mut ref Ctx, nn: ref Vec[i64], f: ref Fmt, fmt: i64, carrier: ref Vec[i64]) -> Vec[i64] {
    let mut rule = f.format.clone();
    let mut out: Vec[i64] = Vec.new();
    if fmt == f_national() and carrier.len() > 0 and opt_nonempty(f.cc_rule) {
        let cc_rule = replace_seq(opt_text(f.cc_rule), cps("$CC"), carrier);
        rule = rx_sub(mut ctx.rx, ctx.pats.first_group, cc_rule, rule, 1);
        out = rx_sub(mut ctx.rx, f.pattern, rule, nn, 0);
    } else {
        let np_rule = opt_text(f.np_rule);
        if fmt == f_national() and np_rule.len() > 0 {
            let first = rx_sub(mut ctx.rx, ctx.pats.first_group, np_rule, rule, 1);
            out = rx_sub(mut ctx.rx, f.pattern, first, nn, 0);
        } else {
            out = rx_sub(mut ctx.rx, f.pattern, rule, nn, 0);
        }
    }
    if fmt == f_rfc3966() {
        if rx_match(mut ctx.rx, ctx.pats.separator, out).is_some() {
            out = rx_sub(mut ctx.rx, ctx.pats.separator, Vec.new(), out, 1);
        }
        out = rx_sub(mut ctx.rx, ctx.pats.separator, cps("-"), out, 0);
    }
    out
}

fn format_nsn(ctx: mut ref Ctx, nn: ref Vec[i64], mi0: i64, fmt: i64, carrier: ref Vec[i64]) -> Vec[i64] {
    let mi = mref(ctx, mi0);
    let formats = if ctx.metas[mi].intl.len() == 0 or fmt == f_national() { ctx.metas[mi].formats.clone() } else { ctx.metas[mi].intl.clone() };
    match choose_formatting_pattern(mut ctx, formats, nn) {
        Some(f) => format_nsn_using_pattern(mut ctx, nn, f, fmt, carrier),
        None => nn.clone(),
    }
}

fn maybe_append_formatted_extension(ctx: ref Ctx, n: ref Num, mi0: i64, fmt: i64, number: ref Vec[i64]) -> Vec[i64] {
    let mi = mref(ctx, mi0);
    let ext = opt_text(n.ext);
    if ext.len() == 0 {
        return number.clone();
    }
    if fmt == f_rfc3966() {
        return cat(cat(number, cps(";ext=")), ext);
    }
    if let Some(p) = ctx.metas[mi].extn_prefix {
        return cat(cat(number, p), ext);
    }
    cat(cat(number, cps(" ext. ")), ext)
}

fn format_number(ctx: mut ref Ctx, n: ref Num, fmt: i64) -> Vec[i64] {
    if n.nn == Some(0) {
        let raw = opt_text(n.raw);
        if raw.len() > 0 or n.cc.is_none() {
            return raw;
        }
    }
    let cc = num_cc(n);
    let nsn = national_significant_number(n);
    if fmt == f_e164() {
        return prefix_with_cc(cc, fmt, nsn);
    }
    if not has_valid_cc(ctx, cc) {
        return nsn;
    }
    let region = region_for_cc(ctx, cc);
    let mi = meta_for_region_or_code(ctx, cc, region);
    let formatted = format_nsn(mut ctx, nsn, mi, fmt, Vec.new());
    let formatted = maybe_append_formatted_extension(ctx, n, mi, fmt, formatted);
    prefix_with_cc(cc, fmt, formatted)
}

fn format_by_pattern(ctx: mut ref Ctx, n: ref Num, fmt: i64, formats: ref Vec[Fmt]) -> Vec[i64] {
    let cc = num_cc(n);
    let nsn = national_significant_number(n);
    if not has_valid_cc(ctx, cc) {
        return nsn;
    }
    let region = region_for_cc(ctx, cc);
    let mi = meta_for_region_or_code(ctx, cc, region);
    let formatted = match choose_formatting_pattern(mut ctx, formats, nsn) {
        None => nsn.clone(),
        Some(f) => {
            let mut copy = f.clone();
            let np_rule = opt_text(f.np_rule);
            if np_rule.len() > 0 {
                let np = opt_text(ctx.metas[mi].np);
                if np.len() > 0 {
                    let rule = replace_seq(replace_seq(np_rule, cps("$NP"), np), cps("$FG"), cps("\\1"));
                    copy.np_rule = Some(rule);
                } else {
                    copy.np_rule = None;
                }
            }
            format_nsn_using_pattern(mut ctx, nsn, copy, fmt, Vec.new())
        }
    };
    let formatted = maybe_append_formatted_extension(ctx, n, mi, fmt, formatted);
    prefix_with_cc(cc, fmt, formatted)
}

fn format_national_number_with_carrier_code(ctx: mut ref Ctx, n: ref Num, carrier: ref Vec[i64]) -> Vec[i64] {
    let cc = num_cc(n);
    let nsn = national_significant_number(n);
    if not has_valid_cc(ctx, cc) {
        return nsn;
    }
    let region = region_for_cc(ctx, cc);
    let mi = meta_for_region_or_code(ctx, cc, region);
    let formatted = format_nsn(mut ctx, nsn, mi, f_national(), carrier);
    let formatted = maybe_append_formatted_extension(ctx, n, mi, f_national(), formatted);
    prefix_with_cc(cc, f_national(), formatted)
}

fn format_national_number_with_preferred_carrier_code(ctx: mut ref Ctx, n: ref Num, fallback: ref Vec[i64]) -> Vec[i64] {
    let carrier = if opt_nonempty(n.carrier) { opt_text(n.carrier) } else { fallback.clone() };
    format_national_number_with_carrier_code(mut ctx, n, carrier)
}

fn without_extension(n: ref Num) -> Num {
    let mut copy = n.clone();
    copy.ext = None;
    copy
}

fn format_number_for_mobile_dialing(ctx: mut ref Ctx, n: ref Num, from: ref String, with_formatting: bool) -> Vec[i64] {
    let cc = num_cc(n);
    if not has_valid_cc(ctx, cc) {
        return opt_text(n.raw);
    }
    let mut formatted: Vec[i64] = Vec.new();
    let plain = without_extension(n);
    let region = region_for_cc(ctx, cc);
    let t = number_type(mut ctx, plain);
    let valid = t != t_unknown();
    if *from == region {
        let fixed_or_mobile = t == t_fixed_line() or t == t_mobile() or t == t_fixed_line_or_mobile();
        if region == "BR" and fixed_or_mobile {
            if opt_nonempty(plain.carrier) {
                formatted = format_national_number_with_preferred_carrier_code(mut ctx, plain, Vec.new());
            }
        } else if cc == nanpa_code() {
            let mi = mref(ctx, meta_for_region(ctx, from));
            let nsn = national_significant_number(plain);
            if can_be_internationally_dialled(mut ctx, plain) and test_number_length(mut ctx, nsn, mi, t_unknown()) != v_res_too_short() {
                formatted = format_number(mut ctx, plain, f_international());
            } else {
                formatted = format_number(mut ctx, plain, f_national());
            }
        } else if (region == non_geo() or ((region == "MX" or region == "CL" or region == "UZ") and fixed_or_mobile)) and can_be_internationally_dialled(mut ctx, plain) {
            formatted = format_number(mut ctx, plain, f_international());
        } else {
            formatted = format_number(mut ctx, plain, f_national());
        }
    } else if valid and can_be_internationally_dialled(mut ctx, plain) {
        if with_formatting {
            return format_number(mut ctx, plain, f_international());
        }
        return format_number(mut ctx, plain, f_e164());
    }
    if with_formatting {
        return formatted;
    }
    normalize_diallable_chars_only(formatted)
}

fn format_out_of_country_calling_number(ctx: mut ref Ctx, n: ref Num, from: ref Option[String]) -> Vec[i64] {
    if not is_valid_region(ctx, from) {
        return format_number(mut ctx, n, f_international());
    }
    let from_r = from.clone().unwrap_or(String.new());
    let cc = num_cc(n);
    let nsn = national_significant_number(n);
    if not has_valid_cc(ctx, cc) {
        return nsn;
    }
    if cc == nanpa_code() {
        if is_nanpa_country(ctx, from) {
            return cat(cps_of(f"{cc} "), format_number(mut ctx, n, f_national()));
        }
    } else if cc == cc_for_valid_region(ctx, from_r) {
        return format_number(mut ctx, n, f_national());
    }
    let from_mi = mref(ctx, meta_for_region_or_code(ctx, cc, from_r.to_uppercase()));
    let ip = opt_text(ctx.metas[from_mi].ip);
    let mut prefix: Vec[i64] = Vec.new();
    if let Some(p) = ctx.metas[from_mi].pip {
        prefix = p.clone();
    } else if rx_full(mut ctx.rx, ctx.pats.single_intl_prefix, ip) {
        prefix = ip.clone();
    }
    let region = region_for_cc(ctx, cc);
    let mi = meta_for_region_or_code(ctx, cc, region.to_uppercase());
    let formatted = format_nsn(mut ctx, nsn, mi, f_international(), Vec.new());
    let formatted = maybe_append_formatted_extension(ctx, n, mi, f_international(), formatted);
    if prefix.len() > 0 {
        return cat(cat(prefix, cps_of(f" {cc} ")), formatted);
    }
    prefix_with_cc(cc, f_international(), formatted)
}

fn has_formatting_pattern_for_number(ctx: mut ref Ctx, n: ref Num) -> bool {
    let cc = num_cc(n);
    let region = region_for_cc(ctx, cc);
    let mi = meta_for_region_or_code(ctx, cc, region);
    if mi < 0 {
        return false;
    }
    let nsn = national_significant_number(n);
    let formats = ctx.metas[mi].formats.clone();
    choose_formatting_pattern(mut ctx, formats, nsn).is_some()
}

fn raw_input_contains_national_prefix(ctx: mut ref Ctx, raw: ref Vec[i64], np: ref Vec[i64], region: ref String) -> bool {
    let digits = normalize_digits_only(raw, false);
    if starts_with_v(digits, np) {
        let rest = slice(digits, np.len(), digits.len());
        return match parse_number(mut ctx, rest, Some(region.clone()), false) {
            Ok(m) => is_valid_number(mut ctx, m),
            Err(_) => false,
        };
    }
    false
}

fn format_original_allow_mods(ctx: mut ref Ctx, n: ref Num, from: ref Option[String]) -> Vec[i64] {
    if n.source == src_plus() {
        return format_number(mut ctx, n, f_international());
    }
    if n.source == src_idd() {
        return format_out_of_country_calling_number(mut ctx, n, from);
    }
    if n.source == src_without_plus() {
        let intl = format_number(mut ctx, n, f_international());
        return slice(intl, 1, intl.len());
    }
    let region = region_for_cc(ctx, num_cc(n));
    let np = ndd_prefix_for_region(ctx, Some(region.clone()), true);
    let national = format_number(mut ctx, n, f_national());
    let np = match np {
        Some(p) => p,
        None => return national,
    };
    if raw_input_contains_national_prefix(mut ctx, opt_text(n.raw), np, region) {
        return national;
    }
    let mi = mref(ctx, meta_for_region(ctx, region));
    let nsn = national_significant_number(n);
    let formats = ctx.metas[mi].formats.clone();
    let rule = match choose_formatting_pattern(mut ctx, formats, nsn) {
        Some(f) => f,
        None => return national,
    };
    let candidate = match rule.np_rule.clone() {
        Some(r) => r.clone(),
        None => return national,
    };
    let first = find_seq(candidate, cps("\\1"), 0);
    if first <= 0 {
        return national;
    }
    let candidate = normalize_digits_only(slice(candidate, 0, first), false);
    if candidate.len() == 0 {
        return national;
    }
    let mut copy = rule.clone();
    copy.np_rule = None;
    format_by_pattern(mut ctx, n, f_national(), vec_of_fmt(copy))
}

fn vec_of_fmt(f: own Fmt) -> Vec[Fmt] {
    let mut out: Vec[Fmt] = Vec.new();
    out.push(f);
    out
}

fn format_in_original_format(ctx: mut ref Ctx, n: ref Num, from: ref Option[String]) -> Vec[i64] {
    if n.raw.is_some() and not has_formatting_pattern_for_number(mut ctx, n) {
        return opt_text(n.raw);
    }
    if n.source == src_unspecified() {
        return format_number(mut ctx, n, f_national());
    }
    let mut formatted = format_original_allow_mods(mut ctx, n, from);
    let raw = opt_text(n.raw);
    if raw.len() > 0 {
        if normalize_diallable_chars_only(formatted) != normalize_diallable_chars_only(raw) {
            formatted = raw;
        }
    }
    formatted
}

fn format_out_of_country_keeping_alpha_chars(ctx: mut ref Ctx, n: ref Num, from: ref String) -> Vec[i64] {
    let raw0 = opt_text(n.raw);
    if raw0.len() == 0 {
        return format_out_of_country_calling_number(mut ctx, n, Some(from.clone()));
    }
    let cc = num_cc(n);
    if not has_valid_cc(ctx, cc) {
        return raw0;
    }
    let mut raw = normalize_helper(raw0, map_grouping(), true);
    let nsn = national_significant_number(n);
    if nsn.len() > 3 {
        let at = find_seq(raw, slice(nsn, 0, 3), 0);
        if at != -1 {
            raw = slice(raw, at, raw.len());
        }
    }
    let from_mi = meta_for_region(ctx, from);
    let from_opt = Some(from.clone());
    if cc == nanpa_code() {
        if is_nanpa_country(ctx, from_opt) {
            return cat(cps_of(f"{cc} "), raw);
        }
    } else if from_mi >= 0 and cc == cc_for_region(ctx, from_opt) {
        let formats = ctx.metas[from_mi].formats.clone();
        let chosen = match choose_formatting_pattern(mut ctx, formats, nsn) {
            Some(f) => f,
            None => return raw,
        };
        let mut copy = chosen.clone();
        copy.pattern = ctx.pats.digits_then_rest;
        copy.format = cps("\\1\\2");
        return format_nsn_using_pattern(mut ctx, raw, copy, f_national(), Vec.new());
    }
    let mut prefix: Vec[i64] = Vec.new();
    if from_mi >= 0 {
        let ip = opt_text(ctx.metas[from_mi].ip);
        if rx_full(mut ctx.rx, ctx.pats.single_intl_prefix, ip) {
            prefix = ip;
        } else {
            prefix = opt_text(ctx.metas[from_mi].pip);
        }
    }
    let region = region_for_cc(ctx, cc);
    let mi = meta_for_region_or_code(ctx, cc, region);
    let formatted = maybe_append_formatted_extension(ctx, n, mi, f_international(), raw);
    if prefix.len() > 0 {
        return cat(cat(prefix, cps_of(f" {cc} ")), formatted);
    }
    prefix_with_cc(cc, f_international(), formatted)
}

// ------------------------------------------------------------ the rest of the API

fn length_of_national_destination_code(ctx: mut ref Ctx, n: ref Num) -> i64 {
    let plain = if n.ext.is_some() { without_extension(n) } else { n.clone() };
    let intl = format_number(mut ctx, plain, f_international());
    let groups = rx_split(mut ctx.rx, ctx.pats.non_digits, intl);
    if groups.len() <= 3 {
        return 0;
    }
    if number_type(mut ctx, n) == t_mobile() {
        if country_mobile_token(num_cc(n)).len() > 0 {
            return groups[2].len() + groups[3].len();
        }
    }
    groups[2].len()
}

fn length_of_geographical_area_code(ctx: mut ref Ctx, n: ref Num) -> i64 {
    let region = region_code_for_number(mut ctx, n);
    let mi = meta_for_opt_region(ctx, region);
    if mi < 0 {
        return 0;
    }
    let t = number_type(mut ctx, n);
    let cc = num_cc(n);
    if ctx.metas[mi].np.is_none() and not n.ilz.unwrap_or(false) and cc != 52 {
        return 0;
    }
    if t == t_mobile() and cc == 86 {
        return 0;
    }
    if not is_number_type_geographical(t, cc) {
        return 0;
    }
    length_of_national_destination_code(mut ctx, n)
}

// truncate_too_long_number: the number loses digits from the end until it
// is valid, and is left alone when it never becomes valid
fn truncate_too_long_number(ctx: mut ref Ctx, n: mut ref Num) -> bool {
    if is_valid_number(mut ctx, n) {
        return true;
    }
    let mut copy = n.clone();
    let mut nn = n.nn.unwrap_or(0);
    while not is_valid_number(mut ctx, copy) {
        nn = nn / 10;
        copy.nn = Some(nn);
        let result = is_possible_number_with_reason(mut ctx, copy);
        if result == v_res_too_short() or nn == 0 {
            return false;
        }
    }
    n.nn = Some(nn);
    true
}

fn m_not_a_number() -> i64 { 0 }
fn m_no_match() -> i64 { 1 }
fn m_short_nsn_match() -> i64 { 2 }
fn m_nsn_match() -> i64 { 3 }
fn m_exact_match() -> i64 { 4 }

fn match_name(m: i64) -> String {
    let names = ["NOT_A_NUMBER", "NO_MATCH", "SHORT_NSN_MATCH", "NSN_MATCH", "EXACT_MATCH"];
    if m >= 0 and m < 5 { names[m].to_string() } else { f"INVALID ({m})" }
}

fn copy_core_fields_only(n: ref Num) -> Num {
    let mut out = new_num();
    out.cc = n.cc;
    out.nn = n.nn;
    if opt_nonempty(n.ext) {
        out.ext = n.ext.clone();
    }
    if n.ilz == Some(true) {
        out.ilz = Some(true);
        out.nlz = Some(n.nlz.unwrap_or(1));
    }
    out
}

fn is_national_number_suffix_of_other(a: ref Num, b: ref Num) -> bool {
    let x = cps_of(opt_int(a.nn));
    let y = cps_of(opt_int(b.nn));
    ends_with_v(x, y) or ends_with_v(y, x)
}

fn is_number_match_oo(a0: ref Num, b0: ref Num) -> i64 {
    let mut a = copy_core_fields_only(a0);
    let b = copy_core_fields_only(b0);
    if a.ext.is_some() and b.ext.is_some() and a.ext != b.ext {
        return m_no_match();
    }
    let cc1 = num_cc(a);
    let cc2 = num_cc(b);
    if cc1 != 0 and cc2 != 0 {
        if num_eq(a, b) {
            return m_exact_match();
        }
        if cc1 == cc2 and is_national_number_suffix_of_other(a, b) {
            return m_short_nsn_match();
        }
        return m_no_match();
    }
    a.cc = b.cc;
    if num_eq(a, b) {
        return m_nsn_match();
    }
    if is_national_number_suffix_of_other(a, b) {
        return m_short_nsn_match();
    }
    m_no_match()
}

fn zz() -> Option[String] {
    Some("ZZ".to_string())
}

fn is_number_match_os(ctx: mut ref Ctx, a: ref Num, s: ref Vec[i64]) -> i64 {
    match parse_number(mut ctx, s, zz(), false) {
        Ok(b) => is_number_match_oo(a, b),
        Err(e) => {
            if e.kind != e_invalid_country_code() {
                return m_not_a_number();
            }
            let region = region_for_cc(ctx, num_cc(a));
            if region != "ZZ" {
                return match parse_number(mut ctx, s, Some(region), false) {
                    Ok(b) => {
                        let m = is_number_match_oo(a, b);
                        if m == m_exact_match() { m_nsn_match() } else { m }
                    }
                    Err(_) => m_not_a_number(),
                };
            }
            match parse_full(mut ctx, s, None, false, false) {
                Ok(b) => is_number_match_oo(a, b),
                Err(_) => m_not_a_number(),
            }
        }
    }
}

fn is_number_match_ss(ctx: mut ref Ctx, s1: ref Vec[i64], s2: ref Vec[i64]) -> i64 {
    match parse_number(mut ctx, s1, zz(), false) {
        Ok(a) => is_number_match_os(mut ctx, a, s2),
        Err(e) => {
            if e.kind != e_invalid_country_code() {
                return m_not_a_number();
            }
            match parse_number(mut ctx, s2, zz(), false) {
                Ok(b) => is_number_match_os(mut ctx, b, s1),
                Err(e2) => {
                    if e2.kind != e_invalid_country_code() {
                        return m_not_a_number();
                    }
                    let a = match parse_full(mut ctx, s1, None, false, false) {
                        Ok(a) => a,
                        Err(_) => return m_not_a_number(),
                    };
                    match parse_full(mut ctx, s2, None, false, false) {
                        Ok(b) => is_number_match_oo(a, b),
                        Err(_) => m_not_a_number(),
                    }
                }
            }
        }
    }
}

fn is_alpha_number(ctx: mut ref Ctx, s: ref Vec[i64]) -> bool {
    if not is_viable_phone_number(mut ctx, s) {
        return false;
    }
    let (_, stripped) = maybe_strip_extension(mut ctx, s);
    rx_full(mut ctx.rx, ctx.pats.alpha_phone, stripped)
}

fn example_number_for_type(ctx: mut ref Ctx, r: ref String, t: i64) -> Option[Num] {
    if not is_valid_region(ctx, Some(r.clone())) {
        return None;
    }
    let mi = meta_for_region(ctx, r);
    if mi < 0 {
        return None;
    }
    let desc = desc_of(ctx, mi, desc_slot_for_type(t));
    if let Some(d) = desc {
        if let Some(ex) = d.example {
            return parse_number(mut ctx, ex, Some(r.clone()), false).ok();
        }
    }
    None
}

// ------------------------------------------------------------ AsYouTypeFormatter

// The formatter's state, field for field. A formatting pattern is a
// pattern slot, -1 for the empty string, and a metadata an index.
struct Aytf {
    current_output: Vec[i64],
    accrued_input: Vec[i64],
    accrued_input_without_formatting: Vec[i64],
    formatting_template: Vec[i64],
    last_match_position: i64,
    current_formatting_pattern: i64,
    prefix_before_national_number: Vec[i64],
    should_add_space_after_national_prefix: bool,
    extracted_national_prefix: Vec[i64],
    national_number: Vec[i64],
    able_to_format: bool,
    input_has_formatting: bool,
    position_to_remember: i64,
    original_position: i64,
    is_complete_number: bool,
    is_expecting_country_calling_code: bool,
    possible_formats: Vec[Fmt],
    default_country: String,
    current_metadata: i64,
    default_metadata: i64,
}

fn digit_placeholder() -> i64 { 0x2008 }

fn aytf_metadata_for_region(ctx: ref Ctx, region: ref String) -> i64 {
    let cc = cc_for_region(ctx, Some(region.clone()));
    let main = region_for_cc(ctx, cc);
    let mi = meta_for_region(ctx, main);
    if mi < 0 { ctx.empty } else { mi }
}

fn new_aytf(ctx: ref Ctx, region: ref String) -> Aytf {
    let country = region.to_uppercase();
    let mi = aytf_metadata_for_region(ctx, country);
    let mut f = Aytf {
        current_output: Vec.new(),
        accrued_input: Vec.new(),
        accrued_input_without_formatting: Vec.new(),
        formatting_template: Vec.new(),
        last_match_position: 0,
        current_formatting_pattern: -1,
        prefix_before_national_number: Vec.new(),
        should_add_space_after_national_prefix: false,
        extracted_national_prefix: Vec.new(),
        national_number: Vec.new(),
        able_to_format: true,
        input_has_formatting: false,
        position_to_remember: 0,
        original_position: 0,
        is_complete_number: false,
        is_expecting_country_calling_code: false,
        possible_formats: Vec.new(),
        default_country: country,
        current_metadata: mi,
        default_metadata: mi,
    };
    f.reset();
    f
}

// A Python index, which counts from the end when it is negative.
fn py_index(i: i64, n: i64) -> i64 {
    if i < 0 { i + n } else { i }
}

fn formatting_rule_has_first_group_only(ctx: mut ref Ctx, rule: ref Option[Vec[i64]]) -> bool {
    match rule {
        Some(r) => rx_full(mut ctx.rx, ctx.pats.first_group_only, r),
        None => true,
    }
}

impl Aytf {
    fn reset(mut ref self) {
        self.current_output = Vec.new();
        self.accrued_input = Vec.new();
        self.accrued_input_without_formatting = Vec.new();
        self.formatting_template = Vec.new();
        self.last_match_position = 0;
        self.current_formatting_pattern = -1;
        self.prefix_before_national_number = Vec.new();
        self.should_add_space_after_national_prefix = false;
        self.extracted_national_prefix = Vec.new();
        self.national_number = Vec.new();
        self.able_to_format = true;
        self.input_has_formatting = false;
        self.position_to_remember = 0;
        self.original_position = 0;
        self.is_complete_number = false;
        self.is_expecting_country_calling_code = false;
        self.possible_formats = Vec.new();
    }

    fn clear(mut ref self, ctx: ref Ctx) {
        self.reset();
        if self.current_metadata != self.default_metadata {
            self.current_metadata = aytf_metadata_for_region(ctx, self.default_country);
        }
    }

    fn space_after_rule(mut ref self, ctx: mut ref Ctx, rule: ref Option[Vec[i64]]) {
        self.should_add_space_after_national_prefix = match rule {
            Some(r) => rx_search(mut ctx.rx, ctx.pats.np_separators, r).is_some(),
            None => false,
        };
    }

    fn maybe_create_new_template(mut ref self, ctx: mut ref Ctx) -> bool {
        let mut ii = 0;
        while ii < self.possible_formats.len() {
            let f = self.possible_formats[ii].clone();
            if self.current_formatting_pattern == f.pattern {
                return false;
            }
            if self.create_formatting_template(mut ctx, f) {
                self.current_formatting_pattern = f.pattern;
                self.space_after_rule(mut ctx, f.np_rule);
                self.last_match_position = 0;
                return true;
            }
            self.possible_formats.remove(ii);
            ii -= 1;
            ii += 1;
        }
        self.able_to_format = false;
        false
    }

    fn get_available_formats(mut ref self, ctx: mut ref Ctx, leading: ref Vec[i64]) {
        let mi = self.current_metadata;
        let is_international = self.is_complete_number and self.extracted_national_prefix.len() == 0;
        let list = if is_international and ctx.metas[mi].intl.len() > 0 { ctx.metas[mi].intl.clone() } else { ctx.metas[mi].formats.clone() };
        for f in list.iter() {
            let first_only = formatting_rule_has_first_group_only(mut ctx, f.np_rule);
            let optional = f.np_optional.unwrap_or(false);
            if self.extracted_national_prefix.len() > 0 and first_only and not optional and f.cc_rule.is_none() {
                continue;
            }
            if self.extracted_national_prefix.len() == 0 and not self.is_complete_number and not first_only and not optional {
                continue;
            }
            if rx_full(mut ctx.rx, ctx.pats.eligible_format, f.format) {
                self.possible_formats.push(f.clone());
            }
        }
        self.narrow_down_possible_formats(mut ctx, leading);
    }

    fn narrow_down_possible_formats(mut ref self, ctx: mut ref Ctx, leading: ref Vec[i64]) {
        let index = leading.len() - 3;
        let mut ii = 0;
        while ii < self.possible_formats.len() {
            let f = self.possible_formats[ii].clone();
            ii += 1;
            if f.leading.len() == 0 {
                continue;
            }
            let last = py_index(if index < f.leading.len() - 1 { index } else { f.leading.len() - 1 }, f.leading.len());
            if rx_match(mut ctx.rx, f.leading[last], leading).is_none() {
                ii -= 1;
                self.possible_formats.remove(ii);
            }
        }
    }

    fn create_formatting_template(mut ref self, ctx: mut ref Ctx, f: ref Fmt) -> bool {
        let template = self.get_formatting_template(mut ctx, f.pattern, f.format);
        if template.len() > 0 {
            self.formatting_template = template;
            return true;
        }
        false
    }

    fn get_formatting_template(mut ref self, ctx: mut ref Ctx, pattern: i64, format: ref Vec[i64]) -> Vec[i64] {
        let longest = cps("999999999999999");
        let a_phone_number = match rx_search(mut ctx.rx, pattern, longest) {
            Some(m) => slice(longest, m.start, m.end),
            None => return Vec.new(),
        };
        if a_phone_number.len() < self.national_number.len() {
            return Vec.new();
        }
        let template = rx_sub(mut ctx.rx, pattern, format, a_phone_number, 0);
        replace_char(template, 57, vec_of(digit_placeholder()))
    }

    fn input_digit(mut ref self, ctx: mut ref Ctx, c0: i64, remember: bool) -> Vec[i64] {
        self.accrued_input.push(c0);
        if remember {
            self.original_position = self.accrued_input.len();
        }
        let mut c = c0;
        if not self.is_digit_or_leading_plus_sign(mut ctx, c) {
            self.able_to_format = false;
            self.input_has_formatting = true;
        } else {
            c = self.normalize_and_accrue_digits_and_plus_sign(c, remember);
        }
        if not self.able_to_format {
            if self.input_has_formatting {
                self.current_output = self.accrued_input.clone();
                return self.current_output.clone();
            } else if self.attempt_to_extract_idd(mut ctx) {
                if self.attempt_to_extract_ccc(ctx) {
                    self.current_output = self.attempt_to_choose_pattern_with_prefix_extracted(mut ctx);
                    return self.current_output.clone();
                }
            } else if self.able_to_extract_longer_ndd(mut ctx) {
                self.prefix_before_national_number.push(32);
                self.current_output = self.attempt_to_choose_pattern_with_prefix_extracted(mut ctx);
                return self.current_output.clone();
            }
            self.current_output = self.accrued_input.clone();
            return self.current_output.clone();
        }
        let len_input = self.accrued_input_without_formatting.len();
        if len_input <= 2 {
            self.current_output = self.accrued_input.clone();
            return self.current_output.clone();
        }
        if len_input == 3 {
            if self.attempt_to_extract_idd(mut ctx) {
                self.is_expecting_country_calling_code = true;
            } else {
                self.extracted_national_prefix = self.remove_national_prefix_from_national_number(mut ctx);
                self.current_output = self.attempt_to_choose_formatting_pattern(mut ctx);
                return self.current_output.clone();
            }
        }
        if self.is_expecting_country_calling_code {
            if self.attempt_to_extract_ccc(ctx) {
                self.is_expecting_country_calling_code = false;
            }
            self.current_output = cat(self.prefix_before_national_number, self.national_number);
            return self.current_output.clone();
        }
        if self.possible_formats.len() > 0 {
            let temp = self.input_digit_helper(c);
            let formatted = self.attempt_to_format_accrued_digits(mut ctx);
            if formatted.len() > 0 {
                self.current_output = formatted;
                return self.current_output.clone();
            }
            let nn = self.national_number.clone();
            self.narrow_down_possible_formats(mut ctx, nn);
            if self.maybe_create_new_template(mut ctx) {
                self.current_output = self.input_accrued_national_number();
                return self.current_output.clone();
            }
            if self.able_to_format {
                self.current_output = self.append_national_number(temp);
            } else {
                self.current_output = self.accrued_input.clone();
            }
            return self.current_output.clone();
        }
        self.current_output = self.attempt_to_choose_formatting_pattern(mut ctx);
        self.current_output.clone()
    }

    fn attempt_to_choose_pattern_with_prefix_extracted(mut ref self, ctx: mut ref Ctx) -> Vec[i64] {
        self.able_to_format = true;
        self.is_expecting_country_calling_code = false;
        self.possible_formats = Vec.new();
        self.last_match_position = 0;
        self.formatting_template = Vec.new();
        self.current_formatting_pattern = -1;
        self.attempt_to_choose_formatting_pattern(mut ctx)
    }

    fn able_to_extract_longer_ndd(mut ref self, ctx: mut ref Ctx) -> bool {
        if self.extracted_national_prefix.len() > 0 {
            self.national_number = cat(self.extracted_national_prefix, self.national_number);
            let at = rfind_seq(self.prefix_before_national_number, self.extracted_national_prefix);
            let n = self.prefix_before_national_number.len();
            self.prefix_before_national_number = slice(self.prefix_before_national_number, 0, py_index(at, n));
        }
        let old = self.extracted_national_prefix.clone();
        old != self.remove_national_prefix_from_national_number(mut ctx)
    }

    // next_char.isdigit(), for the decimal digits, or a plus sign first
    fn is_digit_or_leading_plus_sign(mut ref self, ctx: mut ref Ctx, c: i64) -> bool {
        is_decimal(c) or (self.accrued_input.len() == 1 and rx_full(mut ctx.rx, ctx.pats.plus_chars, vec_of(c)))
    }

    fn attempt_to_format_accrued_digits(mut ref self, ctx: mut ref Ctx) -> Vec[i64] {
        let formats = self.possible_formats.clone();
        for f in formats.iter() {
            if rx_full(mut ctx.rx, f.pattern, self.national_number) {
                self.space_after_rule(mut ctx, f.np_rule);
                let formatted = rx_sub(mut ctx.rx, f.pattern, f.format, self.national_number, 0);
                let full = self.append_national_number(formatted);
                if normalize_diallable_chars_only(full) == self.accrued_input_without_formatting {
                    return full;
                }
            }
        }
        Vec.new()
    }

    fn get_remembered_position(ref self) -> i64 {
        if not self.able_to_format {
            return self.original_position;
        }
        let mut ai = 0;
        let mut oi = 0;
        while ai < self.position_to_remember and oi < self.current_output.len() {
            if self.accrued_input_without_formatting[ai] == self.current_output[oi] {
                ai += 1;
            }
            oi += 1;
        }
        oi
    }

    fn append_national_number(ref self, nn: ref Vec[i64]) -> Vec[i64] {
        let p = ref self.prefix_before_national_number;
        if self.should_add_space_after_national_prefix and p.len() > 0 and p[p.len() - 1] != 32 {
            return cat(cat(p, vec_of(32)), nn);
        }
        cat(p, nn)
    }

    fn attempt_to_choose_formatting_pattern(mut ref self, ctx: mut ref Ctx) -> Vec[i64] {
        if self.national_number.len() >= 3 {
            let nn = self.national_number.clone();
            self.get_available_formats(mut ctx, nn);
            let formatted = self.attempt_to_format_accrued_digits(mut ctx);
            if formatted.len() > 0 {
                return formatted;
            }
            if self.maybe_create_new_template(mut ctx) {
                return self.input_accrued_national_number();
            }
            return self.accrued_input.clone();
        }
        self.append_national_number(self.national_number)
    }

    fn input_accrued_national_number(mut ref self) -> Vec[i64] {
        let n = self.national_number.len();
        if n > 0 {
            let mut temp: Vec[i64] = Vec.new();
            let mut ii = 0;
            while ii < n {
                let c = self.national_number[ii];
                temp = self.input_digit_helper(c);
                ii += 1;
            }
            if self.able_to_format {
                return self.append_national_number(temp);
            }
            return self.accrued_input.clone();
        }
        self.prefix_before_national_number.clone()
    }

    fn is_nanpa_number_with_national_prefix(ref self, ctx: ref Ctx) -> bool {
        let nn = ref self.national_number;
        ctx.metas[self.current_metadata].cc == Some(1) and nn.len() >= 2 and nn[0] == 49 and nn[1] != 48 and nn[1] != 49
    }

    fn remove_national_prefix_from_national_number(mut ref self, ctx: mut ref Ctx) -> Vec[i64] {
        let mut start = 0;
        let mi = self.current_metadata;
        if self.is_nanpa_number_with_national_prefix(ctx) {
            start = 1;
            push_ascii(mut self.prefix_before_national_number, "1 ");
            self.is_complete_number = true;
        } else if ctx.metas[mi].npp.is_some() {
            let npp = ctx.metas[mi].npp_pattern;
            if let Some(m) = rx_match(mut ctx.rx, npp, self.national_number) {
                if m.end > 0 {
                    self.is_complete_number = true;
                    start = m.end;
                    push_all(mut self.prefix_before_national_number, slice(self.national_number, 0, start));
                }
            }
        }
        let np = slice(self.national_number, 0, start);
        self.national_number = slice(self.national_number, start, self.national_number.len());
        np
    }

    fn attempt_to_extract_idd(mut ref self, ctx: mut ref Ctx) -> bool {
        let mut text = cps("\\+|");
        push_all(mut text, opt_text(ctx.metas[self.current_metadata].ip));
        let idd = intern(mut ctx.rx, text, 0);
        if let Some(m) = rx_match(mut ctx.rx, idd, self.accrued_input_without_formatting) {
            self.is_complete_number = true;
            let awf = self.accrued_input_without_formatting.clone();
            self.national_number = slice(awf, m.end, awf.len());
            self.prefix_before_national_number = slice(awf, 0, m.end);
            if awf[0] != 43 {
                self.prefix_before_national_number.push(32);
            }
            return true;
        }
        false
    }

    fn attempt_to_extract_ccc(mut ref self, ctx: ref Ctx) -> bool {
        if self.national_number.len() == 0 {
            return false;
        }
        let (cc, rest) = extract_country_code(ctx, self.national_number);
        if cc == 0 {
            return false;
        }
        self.national_number = rest;
        let region = region_for_cc(ctx, cc);
        if region == non_geo() {
            self.current_metadata = mref(ctx, meta_for_nongeo(ctx, cc));
        } else if region != self.default_country {
            self.current_metadata = aytf_metadata_for_region(ctx, region);
        }
        push_all(mut self.prefix_before_national_number, vstr(cc));
        self.prefix_before_national_number.push(32);
        self.extracted_national_prefix = Vec.new();
        true
    }

    fn normalize_and_accrue_digits_and_plus_sign(mut ref self, c: i64, remember: bool) -> i64 {
        let mut normalized = c;
        if c == 43 {
            self.accrued_input_without_formatting.push(c);
        } else {
            let d = unicode_digit(c);
            if d != -1 {
                normalized = 48 + d;
            }
            self.accrued_input_without_formatting.push(normalized);
            self.national_number.push(normalized);
        }
        if remember {
            self.position_to_remember = self.accrued_input_without_formatting.len();
        }
        normalized
    }

    fn input_digit_helper(mut ref self, c: i64) -> Vec[i64] {
        let mut found = -1;
        let mut k = self.last_match_position;
        while k < self.formatting_template.len() {
            if self.formatting_template[k] == digit_placeholder() {
                found = k;
                break;
            }
            k += 1;
        }
        if found >= 0 {
            // the first placeholder of the template takes the digit
            let first = index_of(self.formatting_template, digit_placeholder());
            self.formatting_template[first] = c;
            self.last_match_position = first;
            return slice(self.formatting_template, 0, first + 1);
        }
        if self.possible_formats.len() == 1 {
            self.able_to_format = false;
        }
        self.current_formatting_pattern = -1;
        self.accrued_input.clone()
    }
}

// ------------------------------------------------------------ the jobs

fn q(s: ref Vec[i64]) -> String {
    f"'{to_string(s)}'"
}

fn q_opt(s: ref Option[Vec[i64]]) -> String {
    match s {
        Some(t) => q(t),
        None => "None".to_string(),
    }
}

fn j_region(j: ref J, key: Str) -> Option[String] {
    match j_get(j, key) {
        J.S(s) => Some(s),
        _ => None,
    }
}

fn j_cps(j: ref J, key: Str) -> Vec[i64] {
    cps_of(j_str(j, key))
}

fn e164(ctx: mut ref Ctx, n: ref Num) -> String {
    to_string(format_number(mut ctx, n, f_e164()))
}

fn describe(ctx: mut ref Ctx, n: ref Num, r: ref Option[String], raw: bool) {
    let intl = to_string(format_number(mut ctx, n, f_international()));
    let national = to_string(format_number(mut ctx, n, f_national()));
    let rfc = to_string(format_number(mut ctx, n, f_rfc3966()));
    println(f"  e164 {e164(mut ctx, n)} | intl {intl} | national {national} | rfc3966 {rfc}");
    let t = number_type(mut ctx, n);
    let valid = is_valid_number(mut ctx, n);
    let region = region_text(region_code_for_number(mut ctx, n));
    let possible = validation_name(is_possible_number_with_reason(mut ctx, n));
    let geo = is_number_geographical(mut ctx, n);
    println(f"  type {type_name(t)}, valid {py_bool(valid)}, region {region}, possible {possible}, geographical {py_bool(geo)}");
    let area = length_of_geographical_area_code(mut ctx, n);
    let ndc = length_of_national_destination_code(mut ctx, n);
    let dialable = can_be_internationally_dialled(mut ctx, n);
    let mut line = f"  area code {area}, ndc {ndc}, dialable from abroad {py_bool(dialable)}";
    if let Some(rr) = r {
        let ok = is_valid_number_for_region(mut ctx, n, r);
        line.push_str(f", valid for {rr} {py_bool(ok)}");
    }
    println(line);
    if raw {
        println(f"  original {to_string(format_in_original_format(mut ctx, n, r))}");
    }
}

fn job_num(ctx: mut ref Ctx, j: ref J) {
    let s = j_cps(j, "s");
    let r = j_region(j, "r");
    let raw = j_bool(j, "raw");
    let head = f"parse {q(s)} {region_text(r)}:";
    match parse_number(mut ctx, s, r, raw) {
        Err(e) => println(f"{head} {perr_text(e)}"),
        Ok(n) => {
            println(f"{head} {num_str(n)}");
            describe(mut ctx, n, r, raw);
        }
    }
}

fn job_oocf(ctx: mut ref Ctx, j: ref J) {
    let s = j_cps(j, "s");
    let r = j_region(j, "r");
    let head = f"dial {q(s)} {region_text(r)}:";
    let n = match parse_number(mut ctx, s, r, false) {
        Err(e) => {
            println(f"{head} {perr_text(e)}");
            return;
        }
        Ok(n) => n,
    };
    println(f"{head} {e164(mut ctx, n)}");
    for frm in j_strs(j, "from").iter() {
        let from = Some(frm.clone());
        let oocf = to_string(format_out_of_country_calling_number(mut ctx, n, from));
        let mobile = format_number_for_mobile_dialing(mut ctx, n, frm, true);
        let digits = format_number_for_mobile_dialing(mut ctx, n, frm, false);
        println(f"  from {frm}: {oocf} | mobile {q(mobile)} | {q(digits)}");
    }
}

fn job_alpha(ctx: mut ref Ctx, j: ref J) {
    let s = j_cps(j, "s");
    let r = j_region(j, "r");
    let alpha = is_alpha_number(mut ctx, s);
    let converted = convert_alpha_characters_in_number(s);
    println(f"alpha {q(s)} {region_text(r)}: alpha {py_bool(alpha)}, converted {q(converted)}");
    let n = match parse_number(mut ctx, s, r, true) {
        Err(e) => {
            println(f"  {perr_text(e)}");
            return;
        }
        Ok(n) => n,
    };
    for frm in j_strs(j, "from").iter() {
        println(f"  from {frm}: {to_string(format_out_of_country_keeping_alpha_chars(mut ctx, n, frm))}");
    }
}

fn job_carrier(ctx: mut ref Ctx, j: ref J) {
    let s = j_cps(j, "s");
    let r = j_region(j, "r");
    let cc = j_cps(j, "cc");
    let head = f"carrier {q(s)} {region_text(r)} {q(cc)}:";
    match parse_number(mut ctx, s, r, true) {
        Err(e) => println(f"{head} {perr_text(e)}"),
        Ok(n) => {
            let with = to_string(format_national_number_with_carrier_code(mut ctx, n, cc));
            let preferred = to_string(format_national_number_with_preferred_carrier_code(mut ctx, n, cc));
            println(f"{head} {with} | preferred {preferred}");
        }
    }
}

fn job_match(ctx: mut ref Ctx, j: ref J) {
    let a = j_cps(j, "a");
    let b = j_cps(j, "b");
    let m = is_number_match_ss(mut ctx, a, b);
    println(f"match {q(a)} {q(b)}: {match_name(m)}");
}

fn job_trunc(ctx: mut ref Ctx, j: ref J) {
    let s = j_cps(j, "s");
    let r = j_region(j, "r");
    let head = f"truncate {q(s)}:";
    let mut n = match parse_number(mut ctx, s, r, false) {
        Err(e) => {
            println(f"{head} {perr_text(e)}");
            return;
        }
        Ok(n) => n,
    };
    let before = e164(mut ctx, n);
    let ok = truncate_too_long_number(mut ctx, mut n);
    println(f"{head} {before} -> {py_bool(ok)} {e164(mut ctx, n)}");
}

fn join_outputs(outs: ref Vec[Vec[i64]]) -> String {
    let parts: Vec[String] = outs.iter().map(|o| to_string(o)).collect();
    parts.join(" | ")
}

fn job_aytf(ctx: mut ref Ctx, j: ref J) {
    let r = j_str(j, "r");
    let keys = j_cps(j, "keys");
    let remember = j_int(j, "remember", -1);
    let mut f = new_aytf(ctx, r);
    let mut outs: Vec[Vec[i64]] = Vec.new();
    let mut k = 0;
    while k < keys.len() {
        outs.push(f.input_digit(mut ctx, keys[k], k == remember));
        k += 1;
    }
    println(f"type {r} {q(keys)}: {join_outputs(outs)}");
    if remember >= 0 {
        println(f"  remembered position {f.get_remembered_position()}");
    }
    f.clear(ctx);
    let mut again: Vec[Vec[i64]] = Vec.new();
    k = 0;
    while k < keys.len() and k < 4 {
        again.push(f.input_digit(mut ctx, keys[k], false));
        k += 1;
    }
    println(f"  after clear: {join_outputs(again)}");
}

fn job_region(ctx: mut ref Ctx, j: ref J) {
    let r = j_str(j, "r");
    let ro = Some(r.clone());
    let cc = cc_for_region(ctx, ro);
    let stripped = q_opt(ndd_prefix_for_region(ctx, ro, true));
    let plain = q_opt(ndd_prefix_for_region(ctx, ro, false));
    let nanpa = py_bool(is_nanpa_country(ctx, ro));
    let portable = py_bool(is_mobile_number_portable_region(ctx, r));
    println(f"region {r}: code {cc}, national prefix {stripped} / {plain}, nanpa {nanpa}, portable {portable}");
    let mut names: Vec[String] = supported_types_for_region(ctx, r).iter().map(|t| type_name(t)).collect();
    names.sort();
    println(f"  types {names.join(", ")}");
    println(f"  sharing {cc}: {regions_for_cc(ctx, cc).join(" ")}");
}

fn job_example(ctx: mut ref Ctx, j: ref J) {
    let r = j_str(j, "r");
    let t = j_int(j, "t", 0);
    let head = f"example {r} {type_name(t)}:";
    match example_number_for_type(mut ctx, r, t) {
        None => println(f"{head} None"),
        Some(n) => {
            let intl = to_string(format_number(mut ctx, n, f_international()));
            let nt = number_type(mut ctx, n);
            println(f"{head} {intl}, which is {type_name(nt)}");
        }
    }
}

fn run_job(ctx: mut ref Ctx, j: ref J) {
    let op = j_str(j, "op");
    if op == "num" {
        job_num(mut ctx, j);
    } else if op == "oocf" {
        job_oocf(mut ctx, j);
    } else if op == "alpha" {
        job_alpha(mut ctx, j);
    } else if op == "carrier" {
        job_carrier(mut ctx, j);
    } else if op == "match" {
        job_match(mut ctx, j);
    } else if op == "trunc" {
        job_trunc(mut ctx, j);
    } else if op == "aytf" {
        job_aytf(mut ctx, j);
    } else if op == "region" {
        job_region(mut ctx, j);
    } else if op == "example" {
        job_example(mut ctx, j);
    } else {
        eprintln(f"unknown job {op}");
    }
}

// ------------------------------------------------------------ the tools

fn cents_text(c: i64) -> String {
    let rest = c % 100;
    let pad = if rest < 10 { "0" } else { "" };
    f"{c / 100}.{pad}{rest}"
}

fn counts_text(m: ref SortedMap[String, i64]) -> String {
    let parts: Vec[String] = m.iter().map(|(k, v)| f"{k} {v}").collect();
    parts.join(", ")
}

fn bump(m: mut ref SortedMap[String, i64], key: ref String, by: i64) {
    let now = match m.get(key) {
        Some(v) => v,
        None => 0,
    };
    m.insert(key.clone(), now + by);
}

// An address book: every contact's number in E.164 with its region and
// type, or why it was rejected, then the numbers that are the same.
fn contacts_tool(ctx: mut ref Ctx) {
    println("== contacts");
    let text = fs.read_to_string("data/contacts.csv").unwrap_or(String.new());
    let mut kept: Vec[(String, Num)] = Vec.new();
    let mut by_region: SortedMap[String, i64] = SortedMap.new();
    let mut by_type: SortedMap[String, i64] = SortedMap.new();
    let mut bad = 0;
    let mut first = true;
    for line in text.split("\n") {
        if first {
            first = false;
            continue;
        }
        if line.len() == 0 {
            continue;
        }
        let f: Vec[String] = line.split(",").map(|p| p.to_string()).collect();
        let name = f[0].clone();
        let country = f[1].clone();
        let phone = cps_of(f[2]);
        let region = if country.len() == 0 { None } else { Some(country.clone()) };
        let n = match parse_number(mut ctx, phone, region, true) {
            Err(e) => {
                println(f"{name}: {to_string(phone)} ({perr_text(e)})");
                bad += 1;
                continue;
            }
            Ok(n) => n,
        };
        if not is_valid_number(mut ctx, n) {
            let reason = validation_name(is_possible_number_with_reason(mut ctx, n));
            println(f"{name}: {to_string(phone)} is not valid ({reason}, {e164(mut ctx, n)})");
            bad += 1;
            continue;
        }
        let r = region_text(region_code_for_number(mut ctx, n));
        let t = type_name(number_type(mut ctx, n));
        let from = if country.len() == 0 { Some("US".to_string()) } else { Some(country.clone()) };
        let original = to_string(format_in_original_format(mut ctx, n, from));
        println(f"{name}: {e164(mut ctx, n)} ({r} {t}) {original}");
        bump(mut by_region, r, 1);
        bump(mut by_type, t, 1);
        kept.push((name, n));
    }
    let mut a = 0;
    while a < kept.len() {
        let mut b = a + 1;
        while b < kept.len() {
            let m = is_number_match_oo(kept[a].1, kept[b].1);
            if m != m_no_match() {
                println(f"same number: {kept[a].0} and {kept[b].0} ({match_name(m)})");
            }
            b += 1;
        }
        a += 1;
    }
    println(f"valid {kept.len()}, rejected {bad}");
    println(f"by region: {counts_text(by_region)}");
    println(f"by type: {counts_text(by_type)}");
}

// cents a minute
fn rate(home_cc: i64, n: ref Num, t: ref String) -> i64 {
    if t == "TOLL_FREE" {
        return 0;
    }
    if t == "PREMIUM_RATE" {
        return 150;
    }
    let cc = num_cc(n);
    if cc == home_cc {
        return if t == "MOBILE" { 3 } else { 1 };
    }
    if cc == 1 and home_cc == 1 {
        return 2;
    }
    if cc == 1 or cc == 44 or cc == 49 or cc == 33 or cc == 39 or cc == 34 or cc == 41 or cc == 31 { 9 } else { 24 }
}

// line.split(" ", 3)
fn split4(line: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut rest = line.clone();
    while out.len() < 3 {
        match rest.find(" ") {
            Some(k) => {
                out.push(rest[..k].to_string());
                rest = rest[k + 1..].to_string();
            }
            None => break,
        }
    }
    out.push(rest);
    out
}

// A call log: how each call is dialled from the caller's region, and
// what it costs.
fn calls_tool(ctx: mut ref Ctx) {
    println("== calls");
    let text = fs.read_to_string("data/calls.txt").unwrap_or(String.new());
    let mut total = 0;
    let mut minutes_total = 0;
    let mut per_home: SortedMap[String, i64] = SortedMap.new();
    for line in text.split("\n") {
        if line.len() == 0 {
            continue;
        }
        let f = split4(line.to_string());
        let home = f[0].clone();
        let minutes = decimal(f[1]).unwrap_or(0);
        let country = f[2].clone();
        let phone = cps_of(f[3]);
        let region = if country == "-" { Some(home.clone()) } else { Some(country.clone()) };
        let n = match parse_number(mut ctx, phone, region, false) {
            Err(e) => {
                println(f"{home} {to_string(phone)}: {perr_text(e)}");
                continue;
            }
            Ok(n) => n,
        };
        if not is_valid_number(mut ctx, n) {
            println(f"{home} {to_string(phone)}: not a valid number");
            continue;
        }
        let t = type_name(number_type(mut ctx, n));
        let dial = format_number_for_mobile_dialing(mut ctx, n, home, true);
        if dial.len() == 0 {
            println(f"{home} {to_string(phone)}: {t} cannot be dialled from {home}");
            continue;
        }
        let cents = rate(cc_for_region(ctx, Some(home.clone())), n, t) * minutes;
        total += cents;
        minutes_total += minutes;
        bump(mut per_home, home, cents);
        println(f"{home} {to_string(phone)}: dial {to_string(dial)}, {t}, {minutes} min, {cents_text(cents)}");
    }
    println(f"{minutes_total} minutes, {cents_text(total)}");
    let parts: Vec[String] = per_home.iter().map(|(k, v)| f"{k} {cents_text(v)}").collect();
    println(f"by caller: {parts.join(", ")}");
}

// ------------------------------------------------------------ main

fn hex_val(c: u8) -> i64 {
    let n = c as i64;
    if n >= 48 and n <= 57 {
        return n - 48;
    }
    n - 87
}

fn unhex(s: Str) -> Vec[u8] {
    let b = s.bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut k = 0;
    while k + 1 < b.len() {
        out.push((hex_val(b[k]) * 16 + hex_val(b[k + 1])) as u8);
        k += 2;
    }
    out
}

// The data files, from inputs_text(), written under data/ the way mk.py
// and gen_kara.py write them, so the program reads only what it wrote.
fn write_inputs() -> Result[(), String] {
    if fs.exists("data") {
        if fs.remove_dir_all("data").is_err() {
            return Err("cannot remove data".to_string());
        }
    }
    if let Err(e) = fs.create_dir_all("data") {
        return Err(f"cannot create data: {e}");
    }
    for line in inputs_text().split("\n") {
        if line.len() == 0 {
            continue;
        }
        let (name, body) = match line.find(" ") {
            Some(k) => (line[..k].to_string(), line[k + 1..].to_string()),
            None => (line.to_string(), String.new()),
        };
        if let Err(e) = fs.write_bytes(name.clone(), unhex(body)) {
            return Err(f"cannot write {name}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_inputs() {
        eprintln(e);
        return;
    }
    let codes = fs.read_to_string("data/codes.txt").unwrap_or(String.new());
    let meta = fs.read_to_string("data/metadata.jsonl").unwrap_or(String.new());
    let mut ctx = match load_ctx(codes, meta) {
        Ok(c) => c,
        Err(e) => {
            eprintln(e);
            return;
        }
    };
    let jobs = fs.read_to_string("data/jobs.jsonl").unwrap_or(String.new());
    for line in jobs.split("\n") {
        if line.len() == 0 {
            continue;
        }
        match json_line(line.to_string()) {
            Ok(j) => run_job(mut ctx, j),
            Err(e) => eprintln(f"bad job: {e}"),
        }
    }
    contacts_tool(mut ctx);
    calls_tool(mut ctx);
    for e in ctx.rx.errors.iter() {
        eprintln(f"pattern did not compile: {e}");
    }
    if fs.remove_dir_all("data").is_err() {
        eprintln("cannot remove data");
    }
}

// Generated by gen_kara.py from data/.

fn inputs_text() -> String {
    let mut s = String.new();
    s.push_str("data/calls.txt \n");
    s.push_str("data/codes.txt \n");
    s.push_str("data/contacts.csv \n");
    s.push_str("data/jobs.jsonl \n");
    s.push_str("data/metadata.jsonl \n");
    s
}
