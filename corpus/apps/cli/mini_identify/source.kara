// mini_identify — a port of identify 2.6.20 (MIT, Chris Kuehl & Anthony
// Sottile): the library pre-commit uses to tag a file by what it is (python,
// shell, json, binary, ...) from its name and shebang, so hooks can decide
// which files to run on.
//
// This port covers the name/shebang path (no filesystem stat): tags_from_filename,
// tags_from_interpreter and parse_shebang. The library's four lookup tables —
// EXTENSIONS (343), EXTENSIONS_NEED_BINARY_CHECK (5), NAMES (96) and
// INTERPRETERS (25) — are embedded verbatim by gen_kara.py as a text block
// (tables_text), parsed once at startup into parallel arrays, rather than a
// giant compile-time constructor. The algorithms match the library: splitext's
// leading-dot rule, the "Dockerfile.xenial matches Dockerfile" dot-split
// fallback in NAMES, the python3.5.2 -> python3.5 -> python3 interpreter
// narrowing, and parse_shebang's `/usr/bin/env` and `/usr/bin/env -S` rewrites.
// tags_from_filename returns a set, so its union of the NAMES and EXTENSIONS
// matches is de-duplicated and sorted for a stable line.
//
// Scope: shebang tokenization is whitespace splitting (the library best-guesses
// with shlex first for the rare quoted shebang; unquoted ASCII, which every
// real shebang is, tokenizes identically). The nix-shell multi-line `-i` form
// and the filesystem/stat and license-detection paths are out of scope.
//
// tables_text() and jobs_text() (both appended by gen_kara.py) carry the
// library tables and data/jobs.tsv verbatim.

struct Tables {
    ext_keys: Vec[String], ext_tags: Vec[String],
    bin_keys: Vec[String], bin_tags: Vec[String],
    name_keys: Vec[String], name_tags: Vec[String],
    interp_keys: Vec[String], interp_tags: Vec[String],
}

fn bytes_of(s: ref String) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for b in s.bytes() { v.push(b as i64); }
    v
}

fn byte_to_char(b: i64) -> String {
    let printable = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
    printable.substring(b - 32, b - 31)
}

fn str_eq(a: ref String, b: ref String) -> bool {
    let x = bytes_of(a);
    let y = bytes_of(b);
    let nx = x.len();
    let ny = y.len();
    if nx != ny { return false; }
    let mut i = 0;
    while i < nx { if x[i] != y[i] { return false; } i = i + 1; }
    true
}

fn str_lt(a: ref String, b: ref String) -> bool {
    let x = bytes_of(a);
    let y = bytes_of(b);
    let nx = x.len();
    let ny = y.len();
    let mut i = 0;
    while i < nx and i < ny {
        if x[i] < y[i] { return true; }
        if x[i] > y[i] { return false; }
        i = i + 1;
    }
    nx < ny
}

fn lower(s: ref String) -> String {
    let v = bytes_of(s);
    let mut out = String.new();
    for b in v {
        let c = if b >= 65 and b <= 90 { b + 32 } else { b };
        out.push_str(byte_to_char(c));
    }
    out
}

// Split on `sep`, keeping empty pieces (like Python str.split(sep)).
fn split_on(s: ref String, sep: i64) -> Vec[String] {
    let v = bytes_of(s);
    let n = v.len();
    let mut out: Vec[String] = Vec.new();
    let mut start = 0;
    let mut i = 0;
    while i <= n {
        if i == n or v[i] == sep {
            out.push(s.substring(start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    out
}

// Split on space, dropping empty pieces (tags are space-joined).
fn split_sp(s: ref String) -> Vec[String] {
    let v = bytes_of(s);
    let n = v.len();
    let mut out: Vec[String] = Vec.new();
    let mut start = 0 - 1;
    let mut i = 0;
    while i <= n {
        let sp = if i < n { v[i] == 32 } else { true };
        if sp {
            if start >= 0 { out.push(s.substring(start, i)); start = 0 - 1; }
        } else {
            if start < 0 { start = i; }
        }
        i = i + 1;
    }
    out
}

// Whitespace split (space or tab), dropping empties (shebang tokenization).
fn ws_split(s: ref String) -> Vec[String] {
    let v = bytes_of(s);
    let n = v.len();
    let mut out: Vec[String] = Vec.new();
    let mut start = 0 - 1;
    let mut i = 0;
    while i <= n {
        let ws = if i < n { v[i] == 32 or v[i] == 9 } else { true };
        if ws {
            if start >= 0 { out.push(s.substring(start, i)); start = 0 - 1; }
        } else {
            if start < 0 { start = i; }
        }
        i = i + 1;
    }
    out
}

fn join_sp(v: ref Vec[String]) -> String {
    let mut s = String.new();
    let n = v.len();
    let mut i = 0;
    while i < n {
        if i > 0 { s.push_str(" "); }
        s.push_str(v[i].clone());
        i = i + 1;
    }
    s
}

fn drop_front(v: ref Vec[String], k: i64) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let n = v.len();
    let mut i = k;
    while i < n { out.push(v[i].clone()); i = i + 1; }
    out
}

fn after_last(s: ref String, sep: i64) -> String {
    let v = bytes_of(s);
    let n = v.len();
    let mut idx = 0 - 1;
    let mut i = 0;
    while i < n { if v[i] == sep { idx = i; } i = i + 1; }
    if idx < 0 { return s.clone(); }
    s.substring(idx + 1, n)
}

fn before_last(s: ref String, sep: i64) -> String {
    let v = bytes_of(s);
    let n = v.len();
    let mut idx = 0 - 1;
    let mut i = 0;
    while i < n { if v[i] == sep { idx = i; } i = i + 1; }
    if idx < 0 { return String.new(); }
    s.substring(0, idx)
}

fn basename(name: ref String) -> String {
    after_last(name, 47) // '/'
}

// os.path.splitext on a basename: the extension (no dot, lower-cased) or "".
// A name whose only dots are leading has no extension (".bashrc" -> "").
fn ext_of(base: ref String) -> String {
    let v = bytes_of(base);
    let n = v.len();
    let mut dot = 0 - 1;
    let mut i = 0;
    while i < n { if v[i] == 46 { dot = i; } i = i + 1; }
    if dot < 0 { return String.new(); }
    let mut has_nondot = false;
    let mut j = 0;
    while j < dot {
        if v[j] != 46 { has_nondot = true; }
        j = j + 1;
    }
    if not has_nondot { return String.new(); }
    let raw = base.substring(dot + 1, n);
    lower(raw)
}

fn find(keys: ref Vec[String], tags: ref Vec[String], key: ref String) -> String {
    let n = keys.len();
    let mut i = 0;
    while i < n {
        let k = keys[i].clone();
        if str_eq(k, key) { return tags[i].clone(); }
        i = i + 1;
    }
    String.new()
}

fn dedup_sort(toks: ref Vec[String]) -> Vec[String] {
    let n = toks.len();
    let mut used: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n { used.push(0); i = i + 1; }
    let mut out: Vec[String] = Vec.new();
    let mut count = 0;
    while count < n {
        let mut best = 0 - 1;
        let mut j = 0;
        while j < n {
            if used[j] == 0 {
                if best < 0 { best = j; }
                else {
                    let bj = toks[j].clone();
                    let bb = toks[best].clone();
                    if str_lt(bj, bb) { best = j; }
                }
            }
            j = j + 1;
        }
        used[best] = 1;
        count = count + 1;
        let cur = toks[best].clone();
        if out.len() == 0 {
            out.push(cur);
        } else {
            let last = out[out.len() - 1].clone();
            if not str_eq(last, cur) { out.push(cur); }
        }
    }
    out
}

fn union_sort(a: ref String, b: ref String) -> String {
    let ta = split_sp(a);
    let tb = split_sp(b);
    let mut toks: Vec[String] = Vec.new();
    let mut i = 0;
    let na = ta.len();
    while i < na { toks.push(ta[i].clone()); i = i + 1; }
    i = 0;
    let nb = tb.len();
    while i < nb { toks.push(tb[i].clone()); i = i + 1; }
    let uniq = dedup_sort(toks);
    join_sp(uniq)
}

fn filename_tags(tables: ref Tables, name: ref String) -> String {
    let base = basename(name);
    // NAMES: the full name first, then each dot-split piece; first match wins.
    let mut names_t = find(tables.name_keys, tables.name_tags, base);
    if names_t.len() == 0 {
        let pieces = split_on(base, 46); // '.'
        let np = pieces.len();
        let mut i = 0;
        while i < np {
            let p = pieces[i].clone();
            let r = find(tables.name_keys, tables.name_tags, p);
            if r.len() > 0 { names_t = r; i = np; }
            else { i = i + 1; }
        }
    }
    // Extension: EXTENSIONS, then EXTENSIONS_NEED_BINARY_CHECK.
    let ext = ext_of(base);
    let mut ext_t = String.new();
    if ext.len() > 0 {
        ext_t = find(tables.ext_keys, tables.ext_tags, ext);
        if ext_t.len() == 0 {
            ext_t = find(tables.bin_keys, tables.bin_tags, ext);
        }
    }
    union_sort(names_t, ext_t)
}

fn interp_tags(tables: ref Tables, interp0: ref String) -> String {
    let mut cur = after_last(interp0, 47); // '/'
    let mut result = String.new();
    let mut go = true;
    while go and cur.len() > 0 {
        let t = find(tables.interp_keys, tables.interp_tags, cur);
        if t.len() > 0 { result = t; go = false; }
        else { cur = before_last(cur, 46); } // rpartition('.')[0]
    }
    result
}

fn parse_shebang(line: ref String) -> Vec[String] {
    let v = bytes_of(line);
    let n = v.len();
    let mut empty: Vec[String] = Vec.new();
    if n < 2 or v[0] != 35 or v[1] != 33 { return empty; } // '#','!'
    let rest = line.substring(2, n);
    let rv = bytes_of(rest);
    let m = rv.len();
    let mut i = 0;
    while i < m {
        let b = rv[i];
        let pr = (b >= 32 and b <= 126) or (b >= 9 and b <= 13);
        if not pr { return empty; }
        i = i + 1;
    }
    let toks = ws_split(rest);
    let nt = toks.len();
    if nt == 0 { return toks; }
    let t0 = toks[0].clone();
    if str_eq(t0, "/usr/bin/env") {
        if nt >= 2 {
            let t1 = toks[1].clone();
            if str_eq(t1, "-S") { return drop_front(toks, 2); }
        }
        return drop_front(toks, 1);
    }
    toks
}

fn run_job(tables: ref Tables, op: ref String, arg: ref String) -> String {
    if op == "filename" {
        let t = filename_tags(tables, arg);
        if t.len() == 0 { return "(none)"; }
        return t;
    }
    if op == "interpreter" {
        let t = interp_tags(tables, arg);
        if t.len() == 0 { return "(none)"; }
        return t;
    }
    if op == "shebang" {
        let cmd = parse_shebang(arg);
        if cmd.len() == 0 { return "(none)"; }
        return join_sp(cmd);
    }
    if op == "shebang_tags" {
        let cmd = parse_shebang(arg);
        if cmd.len() == 0 { return "(none)"; }
        let first = cmd[0].clone();
        let t = interp_tags(tables, first);
        if t.len() == 0 { return "(none)"; }
        return t;
    }
    "unknown op"
}

fn build_tables() -> Tables {
    let tt = tables_text();
    let lines = split_on(tt, 10);
    let mut tables = Tables {
        ext_keys: Vec.new(), ext_tags: Vec.new(),
        bin_keys: Vec.new(), bin_tags: Vec.new(),
        name_keys: Vec.new(), name_tags: Vec.new(),
        interp_keys: Vec.new(), interp_tags: Vec.new(),
    };
    let nl = lines.len();
    let mut i = 0;
    while i < nl {
        let line = lines[i].clone();
        i = i + 1;
        if line.len() == 0 { continue; }
        let f = split_on(line, 9); // tab
        if f.len() < 3 { continue; }
        let kind = f[0].clone();
        let key = f[1].clone();
        let tags = f[2].clone();
        if str_eq(kind, "E") { tables.ext_keys.push(key); tables.ext_tags.push(tags); }
        else if str_eq(kind, "B") { tables.bin_keys.push(key); tables.bin_tags.push(tags); }
        else if str_eq(kind, "N") { tables.name_keys.push(key); tables.name_tags.push(tags); }
        else if str_eq(kind, "I") { tables.interp_keys.push(key); tables.interp_tags.push(tags); }
    }
    tables
}

fn main_run() -> String {
    let tables = build_tables();
    let data = jobs_text();
    let jlines = split_on(data, 10);
    let mut out = String.new();
    let nj = jlines.len();
    let mut i = 0;
    while i < nj {
        let line = jlines[i].clone();
        i = i + 1;
        if line.len() == 0 { continue; }
        let f = split_on(line, 9);
        if f.len() < 2 { continue; }
        let op = f[0].clone();
        let arg = f[1].clone();
        out.push_str("== ");
        out.push_str(op.clone());
        out.push_str(" | ");
        out.push_str(arg.clone());
        out.push_str("\n  ");
        out.push_str(run_job(tables, op, arg));
        out.push_str("\n");
    }
    out
}

fn main() {
    print(main_run());
}
