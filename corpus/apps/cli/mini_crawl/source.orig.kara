}

// ------------------------------------------------------------ the URL cases

fn unesc(a: Str) -> String {
    let b = to_bytes(a);
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        if b[i] == b'\\' and i + 1 < b.len() {
            let c = b[i + 1];
            out.push(if c == b't' { b'\t' } else if c == b'n' { b'\n' } else { c });
            i += 2;
        } else {
            out.push(b[i]);
            i += 1;
        }
    }
    from_bytes(out)
}

fn url_cases(text: Str, s: ref Schemes) {
    println("== URL library");
    let lines = lines_of(text);
    for li in 0..lines.len() {
        let raw = split_on(lines[li], b'\t');
        let mut args: Vec[String] = Vec.new();
        for i in 1..raw.len() {
            args.push(unesc(raw[i]));
        }
        let op = raw[0].clone();
        if op == "join" {
            let r = urljoin(args[0], args[1], s);
            println(f"urljoin({esc(args[0])}, {esc(args[1])}) = {esc(r)}");
        } else if op == "split" {
            let p = urlsplit(args[0], "");
            println(f"urlsplit({esc(args[0])})");
            println(f"  scheme={esc(p.scheme)} netloc={esc(p.netloc)} path={esc(p.path)} query={esc(p.query)} fragment={esc(p.fragment)}");
            let port = match port_of(p.netloc) {
                Ok(Some(n)) => f"{n}",
                Ok(None) => "None".to_string(),
                Err(e) => f"ValueError({esc(e)})",
            };
            let user = esc_opt(username(p.netloc));
            let pass = esc_opt(password(p.netloc));
            let host = esc_opt(hostname(p.netloc));
            println(f"  username={user} password={pass} hostname={host} port={port}");
            let back = urlunsplit(p.scheme, p.netloc, p.path, p.query, p.fragment, s);
            println(f"  unsplit={esc(back)}");
        } else if op == "quote" {
            println(f"quote({esc(args[0])}, safe={esc(args[1])}) = {esc(quote(args[0], args[1]))}");
        } else if op == "quote_plus" {
            println(f"quote_plus({esc(args[0])}) = {esc(quote_plus(args[0]))}");
        } else if op == "unquote" {
            println(f"unquote({esc(args[0])}) = {esc(unquote(args[0]))}");
        } else if op == "unquote_plus" {
            println(f"unquote_plus({esc(args[0])}) = {esc(unquote_plus(args[0]))}");
        } else if op == "qsl" {
            let pairs = parse_qsl(args[0]);
            let mut shown = String.new();
            for i in 0..pairs.len() {
                let (k, v) = pairs[i].clone();
                if i > 0 {
                    shown.push_str(", ");
                }
                shown.push_str(f"({esc(k)}, {esc(v)})");
            }
            println(f"parse_qsl({esc(args[0])}) = [{shown}]");
        } else if op == "encode" {
            let mut pairs: Vec[(String, String)] = Vec.new();
            let mut i: i64 = 0;
            while i + 1 < args.len() {
                pairs.push((args[i].clone(), args[i + 1].clone()));
                i += 2;
            }
            let n = pairs.len();
            println(f"urlencode({n} pairs) = {esc(urlencode(pairs))}");
        }
    }
}

// ------------------------------------------------------------ the crawl

// A crawl target: its normalized URL, or why it has none.
fn normalize(url: Str, s: ref Schemes) -> Result[String, String] {
    let defrag = urldefrag(url, s);
    let p = urlsplit(defrag, "");
    if p.scheme != "http" and p.scheme != "https" {
        let what = if p.scheme.len() > 0 { p.scheme.clone() } else { "no scheme".to_string() };
        return Err(f"not http: {what}");
    }
    let host = hostname(p.netloc).unwrap_or(String.new());
    let port = match port_of(p.netloc) {
        Ok(v) => v,
        Err(e) => return Err(f"bad port: {e}"),
    };
    let default_port: i64 = if p.scheme == "http" { 80 } else { 443 };
    let netloc = match port {
        Some(n) => if n == default_port { host } else { f"{host}:{n}" },
        None => host,
    };
    let mut path = quote(unquote(p.path), "/:@!$&'()*+,;=");
    if path.len() == 0 {
        path = "/".to_string();
    }
    let all = parse_qsl(p.query);
    let mut kept: Vec[(String, String)] = Vec.new();
    for i in 0..all.len() {
        let (k, v) = all[i].clone();
        if not k.starts_with("utm_") {
            kept.push((k, v));
        }
    }
    Ok(urlunsplit(p.scheme, netloc, path, urlencode(kept), "", s))
}

struct Fetch {
    status: i64,
    body: String,
    location: String,
}

fn fetch(url: Str, s: ref Schemes) -> Fetch {
    let p = urlsplit(url, "");
    let path = unquote(p.path);
    let file = if path.ends_with("/") { f"data/site{path}index.html" } else { f"data/site{path}" };
    if let Ok(body) = fs.read_to_string(file) {
        return Fetch { status: 200, body: body, location: String.new() };
    }
    if not path.ends_with("/") {
        if let Ok(_) = fs.read_to_string(f"data/site{path}/index.html") {
            let loc = urlunsplit(p.scheme, p.netloc, f"{p.path}/", p.query, "", s);
            return Fetch { status: 301, body: String.new(), location: loc };
        }
    }
    Fetch { status: 404, body: String.new(), location: String.new() }
}

fn netloc_of(url: Str) -> String {
    urlsplit(url, "").netloc
}

fn title_text(t: ref Option[String]) -> String {
    let raw = match t {
        Some(v) => v.clone(),
        None => String.new(),
    };
    let b = to_bytes(raw);
    let mut out: Vec[u8] = Vec.new();
    let mut gap = false;
    for i in 0..b.len() {
        if is_html_space(b[i]) {
            gap = true;
        } else {
            if gap and out.len() > 0 {
                out.push(b' ');
            }
            gap = false;
            out.push(b[i]);
        }
    }
    from_bytes(out)
}

fn sort_strings(v: ref Vec[String]) -> Vec[String] {
    let mut out = v.clone();
    for i in 1..out.len() {
        let mut j = i;
        while j > 0 and cmp_str(out[j - 1], out[j]) > 0 {
            let t = out[j - 1].clone();
            out[j - 1] = out[j].clone();
            out[j] = t;
            j -= 1;
        }
    }
    out
}

fn index_of(v: ref Vec[String], s: Str) -> i64 {
    for i in 0..v.len() {
        if v[i] == s {
            return i;
        }
    }
    -1
}

fn xml_escape(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        if b[i] == b'&' {
            push_bytes(mut out, "&amp;");
        } else if b[i] == b'<' {
            push_bytes(mut out, "&lt;");
        } else if b[i] == b'>' {
            push_bytes(mut out, "&gt;");
        } else {
            out.push(b[i]);
        }
    }
    from_bytes(out)
}

const SITE: Str = "https://docs.example.com";
const AGENT: Str = "kara-crawler/1.0";
const MAX_DEPTH: i64 = 3;

fn robots_section(r: ref Robots, s: ref Schemes) {
    println("");
    println("== robots.txt");
    let mut maps = String.new();
    for i in 0..r.sitemaps.len() {
        if i > 0 {
            maps.push_str(", ");
        }
        maps.push_str(r.sitemaps[i]);
    }
    println(f"sitemaps: {maps}");
    let agents: Array[Str, 4] = [AGENT, "Googlebot/2.1", "BadBot/3.0", "friendly-bot"];
    let probes = words("/ /drafts/x.html /drafts/public-roadmap.html /internal/admin.html /internal/status.html /guide/setup.html?print=1 /guide/setup.html?lang=en&print= /tmp /tmpfiles/x /old/page.html /docs.pdf /docs.pdf?x=1 /search?q=1 /search/help /robots.txt /%7Euser/ /~user/x /archive/2024/old /archive/2024/old/x /caf%C3%A9.html /a$b");
    for a in 0..4 {
        let agent = agents[a];
        let k = find_entry(r, agent);
        let delay = if k < 0 or r.groups[k].delay < 0 { "None".to_string() } else { f"{r.groups[k].delay}" };
        let rate = if k < 0 or r.groups[k].rate_n < 0 { "None".to_string() } else { f"{r.groups[k].rate_n}/{r.groups[k].rate_s}" };
        let mut verdicts = String.new();
        for p in 0..probes.len() {
            let url = f"{SITE}{probes[p]}";
            verdicts.push_str(if can_fetch(r, agent, url, s) { "+" } else { "-" });
        }
        println(f"{agent}: crawl-delay={delay} request-rate={rate} {verdicts}");
    }
    let mut all = String.new();
    for p in 0..probes.len() {
        if p > 0 {
            all.push_str(" ");
        }
        all.push_str(probes[p]);
    }
    println(f"probes: {all}");
}

fn crawl(r: ref Robots, s: ref Schemes) -> Result[(), String] {
    println("");
    println("== crawl");
    let start = normalize(f"{SITE}/", s).unwrap_or(String.new());
    let site_netloc = netloc_of(start);
    let mut q_url: Vec[String] = vec![start.clone()];
    let mut q_depth: Vec[i64] = vec![0];
    let mut q_ref: Vec[String] = vec!["(start)".to_string()];
    let mut head: i64 = 0;
    let mut seen: Vec[String] = vec![start.clone()];
    let mut res_url: Vec[String] = Vec.new();
    let mut res_status: Vec[i64] = Vec.new();
    let mut ref_keys: Vec[String] = Vec.new();
    let mut ref_lists: Vec[Vec[String]] = Vec.new();
    let mut ext_hosts: Vec[String] = Vec.new();
    let mut ext_counts: Vec[i64] = Vec.new();
    let mut blocked: i64 = 0;
    let mut sitemap: Vec[String] = Vec.new();
    while head < q_url.len() {
        let url = q_url[head].clone();
        let depth = q_depth[head];
        let from = q_ref[head].clone();
        head += 1;
        if not can_fetch(r, AGENT, url, s) {
            println(f"[robots] {url} (from {from})");
            blocked += 1;
            continue;
        }
        let f = fetch(url, s);
        if f.status == 301 {
            let loc = f.location.clone();
            println(f"[301] {url} -> {loc}");
            if index_of(seen, loc) < 0 {
                seen.push(loc.clone());
                q_url.push(loc);
                q_depth.push(depth);
                q_ref.push(url.clone());
            }
            continue;
        }
        if f.status == 404 {
            println(f"[404] {url} (from {from})");
            res_url.push(url.clone());
            res_status.push(404);
            continue;
        }
        let bare = split_on(url, b'?')[0].clone();
        if not url.ends_with("/") and not bare.ends_with(".html") {
            let size = f.body.len();
            println(f"[200] {url} asset, {size} bytes");
            res_url.push(url.clone());
            res_status.push(200);
            continue;
        }
        let pg = parse_html(f.body);
        let title = title_text(pg.title);
        let mut flags: Vec[String] = Vec.new();
        for i in 0..pg.robots.len() {
            if pg.robots[i].len() > 0 {
                flags.push(pg.robots[i].clone());
            }
        }
        let flags = sort_strings(flags);
        let mut line = f"[200] {url} depth {depth} {esc(title)}";
        if flags.len() > 0 {
            line.push_str(" robots=");
            for i in 0..flags.len() {
                if i > 0 {
                    line.push_str(",");
                }
                line.push_str(flags[i]);
            }
        }
        println(line);
        res_url.push(url.clone());
        res_status.push(200);
        let base = match pg.base.clone() {
            Some(b) => {
                let joined = urljoin(url, strip_ws(b), s);
                println(f"  base {joined}");
                joined
            }
            None => url.clone(),
        };
        let noindex = in_list("noindex", pg.robots) or in_list("none", pg.robots);
        if not noindex {
            let mut canon = url.clone();
            if let Some(c) = pg.canonical.clone() {
                if let Ok(cn) = normalize(urljoin(base, strip_ws(c), s), s) {
                    if netloc_of(cn) == site_netloc {
                        println(f"  canonical {cn}");
                        canon = cn;
                    }
                }
            }
            if not in_list(canon, sitemap) {
                sitemap.push(canon);
            }
        }
        let nofollow_page = in_list("nofollow", pg.robots) or in_list("none", pg.robots);
        for li in 0..pg.tags.len() {
            let tag = pg.tags[li].clone();
            let raw = match pg.raws[li].clone() {
                Some(v) => v,
                None => {
                    println(f"  {tag} (no value)");
                    continue;
                }
            };
            let head_text = f"  {tag} {esc(raw)}";
            let target = match normalize(urljoin(base, strip_ws(raw), s), s) {
                Ok(t) => t,
                Err(why) => {
                    println(f"{head_text} skipped, {why}");
                    continue;
                }
            };
            if netloc_of(target) != site_netloc {
                let host = hostname(netloc_of(target)).unwrap_or(String.new());
                let k = index_of(ext_hosts, host);
                if k < 0 {
                    ext_hosts.push(host);
                    ext_counts.push(1);
                } else {
                    ext_counts[k] += 1;
                }
                println(f"{head_text} -> {target} external");
                continue;
            }
            let rk = index_of(ref_keys, target);
            if rk < 0 {
                ref_keys.push(target.clone());
                ref_lists.push(vec![url.clone()]);
            } else if not in_list(url, ref_lists[rk]) {
                ref_lists[rk].push(url.clone());
            }
            if pg.nofollows[li] or nofollow_page {
                println(f"{head_text} -> {target} nofollow");
            } else if index_of(seen, target) >= 0 {
                println(f"{head_text} -> {target} seen");
            } else if depth + 1 > MAX_DEPTH {
                println(f"{head_text} -> {target} too deep");
            } else {
                seen.push(target.clone());
                q_url.push(target.clone());
                q_depth.push(depth + 1);
                q_ref.push(url.clone());
                println(f"{head_text} -> {target} queued");
            }
        }
    }
    println("");
    println("== summary");
    let mut ok: i64 = 0;
    for i in 0..res_status.len() {
        if res_status[i] == 200 {
            ok += 1;
        }
    }
    let total = res_url.len();
    let broken = total - ok;
    println(f"fetched {total} urls: {ok} ok, {broken} broken; {blocked} blocked by robots.txt");
    for i in 0..res_url.len() {
        if res_status[i] == 404 {
            let u = res_url[i].clone();
            let k = index_of(ref_keys, u);
            let mut froms = String.new();
            if k < 0 {
                froms.push_str("(start)");
            } else {
                for j in 0..ref_lists[k].len() {
                    if j > 0 {
                        froms.push_str(", ");
                    }
                    froms.push_str(ref_lists[k][j]);
                }
            }
            println(f"broken {u} <- {froms}");
        }
    }
    let hosts = sort_strings(ext_hosts);
    for i in 0..hosts.len() {
        let k = index_of(ext_hosts, hosts[i]);
        let h = hosts[i].clone();
        let c = ext_counts[k];
        println(f"external {h} x{c}");
    }
    if let Err(e) = fs.create_dir_all("data/out".to_string()) {
        return Err(f"cannot create data/out: {e}");
    }
    let mut xml = String.new();
    xml.push_str("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n");
    xml.push_str("<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n");
    let urls = sort_strings(sitemap);
    for i in 0..urls.len() {
        xml.push_str(f"  <url><loc>{xml_escape(urls[i])}</loc></url>\n");
    }
    xml.push_str("</urlset>\n");
    put("data/out/sitemap.xml", xml)?;
    let sorted = sort_strings(res_url);
    let mut report = "url\tstatus\n".to_string();
    for i in 0..sorted.len() {
        let k = index_of(res_url, sorted[i]);
        let u = sorted[i].clone();
        let st = res_status[k];
        report.push_str(f"{u}\t{st}\n");
    }
    put("data/out/report.tsv", report)?;
    println("");
    println("== data/out/sitemap.xml");
    match fs.read_to_string("data/out/sitemap.xml".to_string()) {
        Ok(t) => print(t),
        Err(e) => return Err(f"cannot read data/out/sitemap.xml: {e}"),
    }
    Ok(())
}

fn run() -> Result[(), String] {
    write_data()?;
    let s = schemes();
    let tests = match fs.read_to_string("data/url-tests.tsv".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/url-tests.tsv: {e}"),
    };
    url_cases(tests, s);
    let text = match fs.read_to_string("data/site/robots.txt".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/site/robots.txt: {e}"),
    };
    let r = parse_robots(text);
    robots_section(r, s);
    crawl(r, s)
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_crawl: {e}");
    }
}
