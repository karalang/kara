  -> b'Zm8='
b64encode | foo
  -> b'Zm9v'
b64encode | foobar
  -> b'Zm9vYmFy'
b64encode | \x00\xff\xfe\xfd\xfc?>
  -> b'AP/+/fw/Pg=='
b64encode alt=-_ | \xfb\xff\xbf
  -> b'-_-_'
