fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data")?;
    put("data/cases.txt", file_0())?;
    make_dir("data/inbox")?;
    put("data/inbox/01-phone.eml", file_1())?;
    put("data/inbox/02-invoice.eml", file_2())?;
    put("data/inbox/03-export.eml", file_3())?;
    make_dir("data/outbox")?;
    put("data/outbox/note.txt", file_4())?;
    put("data/outbox/report.csv", file_5())?;
    Ok(())
}

// ------------------------------------------------------------ the cases

fn read(path: Str) -> Result[String, String] {
    match fs.read_to_string(path.to_string()) {
        Ok(t) => Ok(t),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

fn write_file(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

// The options of a case: `name` or `name=value` words.
struct Opts {
    keys: Vec[String],
    vals: Vec[String],
}

impl Opts {
    fn has(ref self, k: Str) -> bool {
        contains_str(self.keys, k)
    }

    fn get(ref self, k: Str, default: Str) -> String {
        for i in 0..self.keys.len() {
            if self.keys[i] == k {
                return self.vals[i].clone();
            }
        }
        default.to_string()
    }

    fn int(ref self, k: Str) -> i64 {
        let b = to_bytes(self.get(k, "0"));
        let neg = b.len() > 0 and b[0] == b'-';
        let mut n: i64 = 0;
        for i in 0..b.len() {
            if is_digit(b[i]) {
                n = n * 10 + (b[i] - b'0') as i64;
            }
        }
        if neg { -n } else { n }
    }
}

fn shown(r: own Result[Vec[u8], String]) -> Result[String, String] {
    match r {
        Ok(b) => Ok(bytes_repr(b)),
        Err(e) => Err(e),
    }
}

fn run_case(name: Str, o: ref Opts, d: ref Vec[u8]) -> Result[String, String] {
    if name == "b64encode" {
        return Ok(bytes_repr(b64encode(d, o.get("alt", ""))));
    }
    if name == "urlsafe_b64encode" {
        return Ok(bytes_repr(translate(b64encode(d, ""), "+/", "-_")));
    }
    if name == "b64decode" {
        return shown(b64decode(d, o.get("alt", ""), o.has("validate")));
    }
    if name == "urlsafe_b64decode" {
        return shown(b64decode(translate(d, "-_", "+/"), "", false));
    }
    if name == "encodebytes" {
        return Ok(bytes_repr(encodebytes(d)));
    }
    if name == "decodebytes" {
        return shown(a2b_base64(d, false));
    }
    if name == "b32encode" {
        return Ok(bytes_repr(b32encode(B32_ALPHABET, d)));
    }
    if name == "b32hexencode" {
        return Ok(bytes_repr(b32encode(B32HEX_ALPHABET, d)));
    }
    if name == "b32decode" {
        return shown(b32decode(B32_ALPHABET, d, o.has("casefold"), o.get("map01", "")));
    }
    if name == "b32hexdecode" {
        return shown(b32decode(B32HEX_ALPHABET, d, o.has("casefold"), ""));
    }
    if name == "b16encode" {
        return Ok(bytes_repr(b16encode(d)));
    }
    if name == "b16decode" {
        return shown(b16decode(d, o.has("casefold")));
    }
    if name == "a85encode" {
        return Ok(bytes_repr(a85encode(d, o.has("foldspaces"), o.int("wrapcol"), o.has("pad"), o.has("adobe"))));
    }
    if name == "a85decode" {
        return shown(a85decode(d, o.has("foldspaces"), o.has("adobe")));
    }
    if name == "b85encode" {
        return Ok(bytes_repr(b85encode(d, o.has("pad"))));
    }
    if name == "b85decode" {
        return shown(b85decode(d));
    }
    if name == "z85encode" {
        return Ok(bytes_repr(z85encode(d)));
    }
    if name == "z85decode" {
        return shown(z85decode(d));
    }
    if name == "hexlify" {
        let per = if o.has("n") { o.int("n") } else { 1 };
        return Ok(bytes_repr(hexlify(d, o.get("sep", ""), per)));
    }
    if name == "unhexlify" {
        return shown(unhexlify(d));
    }
    if name == "crc32" {
        return Ok(f"{crc32(d, o.int("value"))}");
    }
    if name == "crc_hqx" {
        return Ok(f"{crc_hqx(d, o.int("value"))}");
    }
    if name == "qp_encode" {
        return Ok(bytes_repr(qp_encode(d, o.has("quotetabs"), o.has("header"))));
    }
    if name == "qp_decode" {
        return Ok(bytes_repr(qp_decode(d, o.has("header"))));
    }
    Err(f"unknown case {name}")
}

fn show_codecs() -> Result[(), String] {
    println("== codecs");
    let lines = lines_of(read("data/cases.txt")?);
    for i in 0..lines.len() {
        let line = lines[i].clone();
        let at = find_str(line, " | ");
        let spec = if at >= 0 { slice(line, 0, at) } else { line.clone() };
        let raw = if at >= 0 { slice_from(line, at + 3) } else { String.new() };
        let words = split_ws(spec);
        let mut o = Opts { keys: Vec.new(), vals: Vec.new() };
        for k in 1..words.len() {
            let (key, _, val) = partition(words[k], b'=');
            o.keys.push(key);
            o.vals.push(val);
        }
        println(line);
        match run_case(words[0], o, unescape_bytes(raw)) {
            Ok(s) => println(f"  -> {s}"),
            Err(e) => println(f"  Error: {e}"),
        }
    }
    Ok(())
}

fn run() -> Result[(), String] {
    write_data()?;
    show_codecs()?;
    show_mail()?;
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_mime: {e}");
    }
}
