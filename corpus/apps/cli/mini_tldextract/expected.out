   registered_domain='contoso.gov.uk' fqdn='contoso.gov.uk' ipv4='' ipv6=''
-- extract('dev.m.x-y.foo.co.jp/a/b?c=d')
   ExtractResult(subdomain='dev.m.x-y', domain='foo', suffix='co.jp', is_private=False)
   registered_domain='foo.co.jp' fqdn='dev.m.x-y.foo.co.jp' ipv4='' ipv6=''
-- extract('https://example.xn--fiqs8s#top')
   ExtractResult(subdomain='', domain='example', suffix='xn--fiqs8s', is_private=False)
   registered_domain='example.xn--fiqs8s' fqdn='example.xn--fiqs8s' ipv4='' ipv6=''
-- extract('EXAMPLE.GOV.UK:8080#top', include_psl_private_domains=False)
   ExtractResult(subdomain='', domain='EXAMPLE', suffix='GOV.UK', is_private=False)
   registered_domain='EXAMPLE.GOV.UK' fqdn='EXAMPLE.GOV.UK' ipv4='' ipv6=''
-- extract('http://foo.appspot.com/', include_psl_private_domains=True)
   ExtractResult(subdomain='', domain='foo', suffix='appspot.com', is_private=True)
   registered_domain='foo.appspot.com' fqdn='foo.appspot.com' ipv4='' ipv6=''
-- extract('//shop.api.x-y.acme.appspot.com:8080/')
   ExtractResult(subdomain='shop.api.x-y.acme', domain='appspot', suffix='com', is_private=False)
   registered_domain='appspot.com' fqdn='shop.api.x-y.acme.appspot.com' ipv4='' ipv6=''
-- extract('http://CDN.DATA.公司.CN:8080', include_psl_private_domains=False)
   ExtractResult(subdomain='CDN', domain='DATA', suffix='公司.CN', is_private=False)
   registered_domain='DATA.公司.CN' fqdn='CDN.DATA.公司.CN' ipv4='' ipv6=''
== the tldextract command
-- tldextract forums.bbc.co.uk
   forums bbc co.uk
   exit 0
-- tldextract -j http://user.github.io/x 例子.中国
   {"subdomain": "user", "domain": "github", "suffix": "io", "is_private": false, "fqdn": "user.github.io", "ipv4": "", "ipv6": "", "registered_domain": "github.io"}
   {"subdomain": "", "domain": "\u4f8b\u5b50", "suffix": "\u4e2d\u56fd", "is_private": false, "fqdn": "\u4f8b\u5b50.\u4e2d\u56fd", "ipv4": "", "ipv6": "", "registered_domain": "\u4f8b\u5b50.\u4e2d\u56fd"}
   exit 0
-- tldextract -p user.github.io
    user github.io
   exit 0
-- tldextract --private_domains --json s3.amazonaws.com
   {"subdomain": "", "domain": "", "suffix": "s3.amazonaws.com", "is_private": true, "fqdn": "s3.amazonaws.com", "ipv4": "", "ipv6": "", "registered_domain": ""}
   exit 0
-- tldextract --include_psl_private_domains a.b.c
   a.b c 
   exit 0
-- tldextract [::1] 127.0.0.1
    [::1] 
    127.0.0.1 
   exit 0
-- tldextract -j [2001:db8::1] 1.2.3.4
   {"subdomain": "", "domain": "[2001:db8::1]", "suffix": "", "is_private": false, "fqdn": "", "ipv4": "", "ipv6": "2001:db8::1", "registered_domain": ""}
   {"subdomain": "", "domain": "1.2.3.4", "suffix": "", "is_private": false, "fqdn": "", "ipv4": "1.2.3.4", "ipv6": "", "registered_domain": ""}
   exit 0
-- tldextract 
   usage: tldextract [-h] [--version] [-j] [-u]
                     [--suffix_list_url SUFFIX_LIST_URL] [-c CACHE_DIR] [-p]
                     [--no_fallback_to_snapshot]
                     [fqdn|url ...]
   exit 1
