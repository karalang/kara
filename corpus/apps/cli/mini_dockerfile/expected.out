== labels python.Dockerfile description=Order service team=payments com.example.vendor=ACME Inc.
FROM python:3.12-slim

LABEL description="Order service"
LABEL "com.example.vendor"="ACME Inc."

ENV PYTHONDONTWRITEBYTECODE 1
ENV PIP_NO_CACHE_DIR=off \
    APP_DIR=/app
ENV GREETING hello world from $APP_DIR

WORKDIR $APP_DIR
COPY requirements.txt .
RUN pip install -r requirements.txt \
    # pinned in requirements.txt
    && rm -rf /root/.cache

COPY . .
EXPOSE 8000
ENTRYPOINT ["gunicorn"]
CMD ["-b", "0.0.0.0:8000", "app:wsgi"]
LABEL team=payments
