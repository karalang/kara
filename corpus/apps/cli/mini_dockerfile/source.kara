fn data_part_1(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("from ubuntu:22.04\n");
    t.push_str("maintainer Jane Doe <jane@example.com>\n");
    t.push_str("run apt-get update && \\\n");
    t.push_str("    apt-get install -y curl\n");
    t.push_str("\n");
    t.push_str("env DEBIAN_FRONTEND noninteractive\n");
    t.push_str("label release=\"2019.10\" stage=old\n");
    t.push_str("Expose 22\n");
    t.push_str("cmd /usr/sbin/sshd -D\n");
    v.push(DataFile { path: "legacy.Dockerfile".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("# just notes\n");
    t.push_str("RUN echo hi\n");
    v.push(DataFile { path: "nofrom.Dockerfile".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("FROM python:3.12-slim\n");
    t.push_str("\n");
    t.push_str("LABEL description=\"Order service\" version=\"2.1.0\"\n");
    t.push_str("LABEL \"com.example.vendor\"=\"ACME Inc.\" owner='Data Team'\n");
    t.push_str("\n");
    t.push_str("ENV PYTHONDONTWRITEBYTECODE 1\n");
    t.push_str("ENV PIP_NO_CACHE_DIR=off \\\n");
    t.push_str("    APP_DIR=/app\n");
    t.push_str("ENV GREETING hello world from $APP_DIR\n");
    t.push_str("\n");
    t.push_str("WORKDIR $APP_DIR\n");
    t.push_str("COPY requirements.txt .\n");
    t.push_str("RUN pip install -r requirements.txt \\\n");
    t.push_str("    # pinned in requirements.txt\n");
    t.push_str("    && rm -rf /root/.cache\n");
    t.push_str("\n");
    t.push_str("COPY . .\n");
    t.push_str("EXPOSE 8000\n");
    t.push_str("ENTRYPOINT [\"gunicorn\"]\n");
    t.push_str("CMD [\"-b\", \"0.0.0.0:8000\", \"app:wsgi\"]\n");
    v.push(DataFile { path: "python.Dockerfile".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("ARG PYTHON=3.11\n");
    t.push_str("ARG REGISTRY=registry.example.com\n");
    t.push_str("FROM $REGISTRY/python:$PYTHON AS deps\n");
    t.push_str("ENV PIP_DISABLE_PIP_VERSION_CHECK=1\n");
    t.push_str("ARG PYTHON\n");
    t.push_str("RUN pip wheel -r requirements.txt -w /wheels\n");
    t.push_str("CMD [\"deps\"]\n");
    t.push_str("\n");
    t.push_str("FROM scratch AS assets\n");
    t.push_str("COPY static /static\n");
    t.push_str("\n");
    t.push_str("FROM $REGISTRY/python:$PYTHON-slim\n");
    t.push_str("ARG PYTHON\n");
    t.push_str("ARG EXTRA\n");
    t.push_str("LABEL python=$PYTHON extra=${EXTRA}\n");
    t.push_str("COPY --from=deps /wheels /wheels\n");
    t.push_str("COPY --from=assets /static /srv/static\n");
    t.push_str("CMD python -m app\n");
    v.push(DataFile { path: "stages.Dockerfile".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("FROM alpine\n");
    t.push_str("LABEL title=\"café ☕\" author=Zoë\n");
    t.push_str("ENV GREETING=héllo\n");
    v.push(DataFile { path: "unicode.Dockerfile".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("# escape=`\n");
    t.push_str("FROM mcr.microsoft.com/windows/servercore:ltsc2022\n");
    t.push_str("SHELL [\"powershell\", \"-Command\"]\n");
    t.push_str("ENV TOOLS_DIR C:\\tools\n");
    t.push_str("RUN New-Item -ItemType Directory -Path $env:TOOLS_DIR ; `\n");
    t.push_str("    Invoke-WebRequest https://example.com/tool.zip -OutFile tool.zip\n");
    t.push_str("COPY app\\ C:\\app\\\n");
    t.push_str("WORKDIR C:\\app\n");
    t.push_str("CMD [\"C:\\\\app\\\\server.exe\"]\n");
    v.push(DataFile { path: "windows.Dockerfile".to_string(), hex: false, body: t });
}
