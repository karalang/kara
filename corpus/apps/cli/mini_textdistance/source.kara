// mini_textdistance — a port of the integer edit- and sequence-distance
// algorithms of the `textdistance` library (4.6.3, MIT, @orsinium): Hamming,
// Levenshtein, the restricted (optimal string alignment) Damerau-Levenshtein,
// the longest-common-subsequence length and the longest-common-substring
// length. These are textdistance's own pure-Python implementations run with
// external=False, so each result is the library's deterministic integer.
//
// Strings are compared as byte sequences (ASCII inputs, so one byte is one
// character, exactly as textdistance compares str by code point for ASCII).
// Every matrix is a flat Vec[i64] indexed i*cols + j, so no float and no
// nested vector is formed.

fn bytes_of(s: String) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for b in s.bytes() { v.push(b as i64); }
    v
}

// Split on a single separator byte, keeping trailing empties (like Python's
// str.split(sep)). Self-contained so the port does not lean on the stdlib
// split/lines iterator surface.
fn split_on(s: String, sep: i64) -> Vec[String] {
    let b = bytes_of(s);
    let mut parts: Vec[String] = Vec.new();
    let mut start = 0;
    let mut i = 0;
    while i < b.len() {
        if b[i] == sep {
            parts.push(s.substring(start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    parts.push(s.substring(start, b.len()));
    parts
}

fn int_to_str(n: i64) -> String {
    if n == 0 { return "0"; }
    let mut neg = false;
    let mut v = n;
    if v < 0 { neg = true; v = 0 - v; }
    let mut rev: Vec[i64] = Vec.new();
    while v > 0 { rev.push(v % 10); v = v / 10; }
    let digits = "0123456789";
    let mut out = String.new();
    if neg { out = out + "-"; }
    let mut i = 0;
    while i < rev.len() {
        let d = rev[rev.len() - 1 - i];
        out = out + digits.substring(d, d + 1);
        i = i + 1;
    }
    out
}

fn min3(x: i64, y: i64, z: i64) -> i64 {
    let mut m = x;
    if y < m { m = y; }
    if z < m { m = z; }
    m
}

// Hamming distance: differing positions over the longer length, counting a
// position past the shorter string as a difference (textdistance pads the
// shorter sequence with a fill value under zip_longest).
fn hamming(a: Vec[i64], b: Vec[i64]) -> i64 {
    let n = a.len();
    let m = b.len();
    let big = if n > m { n } else { m };
    let mut diff = 0;
    let mut i = 0;
    while i < big {
        if i >= n or i >= m {
            diff = diff + 1;
        } else if a[i] != b[i] {
            diff = diff + 1;
        }
        i = i + 1;
    }
    diff
}

fn levenshtein(a: Vec[i64], b: Vec[i64]) -> i64 {
    let n = a.len();
    let m = b.len();
    let cols = m + 1;
    let mut d: Vec[i64] = Vec.new();
    let total = (n + 1) * cols;
    let mut t = 0;
    while t < total { d.push(0); t = t + 1; }
    let mut i = 0;
    while i <= n { d[i * cols + 0] = i; i = i + 1; }
    let mut j = 0;
    while j <= m { d[0 * cols + j] = j; j = j + 1; }
    i = 1;
    while i <= n {
        j = 1;
        while j <= m {
            let cost = if a[i - 1] == b[j - 1] { 0 } else { 1 };
            let del = d[(i - 1) * cols + j] + 1;
            let ins = d[i * cols + (j - 1)] + 1;
            let sub = d[(i - 1) * cols + (j - 1)] + cost;
            d[i * cols + j] = min3(del, ins, sub);
            j = j + 1;
        }
        i = i + 1;
    }
    d[n * cols + m]
}

// Restricted (optimal string alignment) Damerau-Levenshtein, matching
// textdistance's _pure_python_restricted.
fn damerau(a: Vec[i64], b: Vec[i64]) -> i64 {
    let n = a.len();
    let m = b.len();
    let cols = m + 1;
    let mut d: Vec[i64] = Vec.new();
    let total = (n + 1) * cols;
    let mut t = 0;
    while t < total { d.push(0); t = t + 1; }
    let mut i = 0;
    while i <= n { d[i * cols + 0] = i; i = i + 1; }
    let mut j = 0;
    while j <= m { d[0 * cols + j] = j; j = j + 1; }
    i = 1;
    while i <= n {
        j = 1;
        while j <= m {
            let cost = if a[i - 1] == b[j - 1] { 0 } else { 1 };
            let del = d[(i - 1) * cols + j] + 1;
            let ins = d[i * cols + (j - 1)] + 1;
            let sub = d[(i - 1) * cols + (j - 1)] + cost;
            let mut best = min3(del, ins, sub);
            if i > 1 and j > 1 and a[i - 1] == b[j - 2] and a[i - 2] == b[j - 1] {
                let tr = d[(i - 2) * cols + (j - 2)] + cost;
                if tr < best { best = tr; }
            }
            d[i * cols + j] = best;
            j = j + 1;
        }
        i = i + 1;
    }
    d[n * cols + m]
}

// Longest-common-subsequence length.
fn lcsseq(a: Vec[i64], b: Vec[i64]) -> i64 {
    let n = a.len();
    let m = b.len();
    let cols = m + 1;
    let mut d: Vec[i64] = Vec.new();
    let total = (n + 1) * cols;
    let mut t = 0;
    while t < total { d.push(0); t = t + 1; }
    let mut i = 1;
    while i <= n {
        let mut j = 1;
        while j <= m {
            if a[i - 1] == b[j - 1] {
                d[i * cols + j] = d[(i - 1) * cols + (j - 1)] + 1;
            } else {
                let left = d[i * cols + (j - 1)];
                let up = d[(i - 1) * cols + j];
                d[i * cols + j] = if left > up { left } else { up };
            }
            j = j + 1;
        }
        i = i + 1;
    }
    d[n * cols + m]
}

// Longest-common-substring length.
fn lcsstr(a: Vec[i64], b: Vec[i64]) -> i64 {
    let n = a.len();
    let m = b.len();
    let cols = m + 1;
    let mut d: Vec[i64] = Vec.new();
    let total = (n + 1) * cols;
    let mut t = 0;
    while t < total { d.push(0); t = t + 1; }
    let mut best = 0;
    let mut i = 1;
    while i <= n {
        let mut j = 1;
        while j <= m {
            if a[i - 1] == b[j - 1] {
                let v = d[(i - 1) * cols + (j - 1)] + 1;
                d[i * cols + j] = v;
                if v > best { best = v; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    best
}

fn run(op: String, arg: String) -> String {
    let sides: Vec[String] = split_on(arg, 124);
    let a = bytes_of(sides[0].clone());
    let b = bytes_of(sides[1].clone());
    "ham=" + int_to_str(hamming(a.clone(), b.clone()))
        + " lev=" + int_to_str(levenshtein(a.clone(), b.clone()))
        + " dam=" + int_to_str(damerau(a.clone(), b.clone()))
        + " lcsseq=" + int_to_str(lcsseq(a.clone(), b.clone()))
        + " lcsstr=" + int_to_str(lcsstr(a.clone(), b.clone()))
}

fn main() {
    let _ = fs.create_dir_all("data");
    let _ = fs.write("data/jobs.tsv", jobs_text());
    let jobs = fs.read_to_string("data/jobs.tsv").unwrap_or(String.new());
    let mut out = String.new();
    let lines = split_on(jobs, 10);
    let mut li = 0;
    while li < lines.len() {
        let line = lines[li].clone();
        li = li + 1;
        if line.len() == 0 { continue; }
        let fields: Vec[String] = split_on(line, 9);
        let op = fields[0].clone();
        let arg = if fields.len() > 1 { fields[1].clone() } else { String.new() };
        out.push_str("== " + op.clone() + " | " + arg.clone() + "\n");
        out.push_str("  " + run(op.clone(), arg.clone()) + "\n");
    }
    print(out);
}
// data/jobs.tsv, as mk.py writes it.
fn jobs_text() -> String {
    let mut s = String.new();
    s.push_str("pair\tkitten|sitting\n");
    s.push_str("pair\tSaturday|Sunday\n");
    s.push_str("pair\tflaw|lawn\n");
    s.push_str("pair\tabc|abc\n");
    s.push_str("pair\t|abc\n");
    s.push_str("pair\tabc|\n");
    s.push_str("pair\t|\n");
    s.push_str("pair\tba|ab\n");
    s.push_str("pair\tca|abc\n");
    s.push_str("pair\tCA|ABC\n");
    s.push_str("pair\tkarolin|kathrin\n");
    s.push_str("pair\t1011101|1001001\n");
    s.push_str("pair\thello|world\n");
    s.push_str("pair\tabcdef|zabcf\n");
    s.push_str("pair\tAGCAT|GAC\n");
    s.push_str("pair\tABCDEF|ABDDEF\n");
    s.push_str("pair\ta quick fox|a quik fox\n");
    s.push_str("pair\tabcdxyz|xyzabcd\n");
    s.push_str("pair\tGeeksforGeeks|GeeksQuiz\n");
    s.push_str("pair\t12345|135\n");
    s
}
