== roundtrip
-- percent_roundtrip
   256 of 256 come back
-- name_roundtrip 'html4'
   16 names, 16 come back as themselves
-- name_roundtrip 'css2'
   16 names, 16 come back as themselves
-- name_roundtrip 'css21'
   17 names, 17 come back as themselves
-- name_roundtrip 'css3'
   aqua -> #00ffff -> 0% 100% 100% -> #00ffff -> cyan
   darkgrey -> #a9a9a9 -> 66.27% 66.27% 66.27% -> #a9a9a9 -> darkgray
   darkslategrey -> #2f4f4f -> 18.43% 30.98% 30.98% -> #2f4f4f -> darkslategray
   dimgrey -> #696969 -> 41.18% 41.18% 41.18% -> #696969 -> dimgray
   fuchsia -> #ff00ff -> 100% 0% 100% -> #ff00ff -> magenta
   grey -> #808080 -> 50% 50% 50% -> #808080 -> gray
   lightgrey -> #d3d3d3 -> 82.75% 82.75% 82.75% -> #d3d3d3 -> lightgray
   lightslategrey -> #778899 -> 46.67% 53.33% 60.00% -> #778899 -> lightslategray
   slategrey -> #708090 -> 43.92% 50% 56.47% -> #708090 -> slategray
   147 names, 138 come back as themselves
