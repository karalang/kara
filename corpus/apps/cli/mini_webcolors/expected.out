== audit
-- audit 'site.css'
   :root
     --brand: #3366CC -> #3366cc - rgb(51, 102, 204) rgb(20.00%, 40.00%, 80.00%) hsl(220, 60.0%, 50.0%)
     --accent: rgb(255, 102, 0) -> #ff6600 - rgb(255, 102, 0) rgb(100%, 40.00%, 0%) hsl(24, 100.0%, 50.0%)
   body
     color: #333 -> #333333 - rgb(51, 51, 51) rgb(20.00%, 20.00%, 20.00%) hsl(0, 0.0%, 20.0%)
     background-color: White -> #ffffff white rgb(255, 255, 255) rgb(100%, 100%, 100%) hsl(0, 0.0%, 100.0%)
     contrast 12.63:1 (L 0.0331 on 1.0000) AAA
   header, .masthead
     color: rgb(255, 255, 255) -> #ffffff white rgb(255, 255, 255) rgb(100%, 100%, 100%) hsl(0, 0.0%, 100.0%)
     background-color: var(--brand) -> #3366cc - rgb(51, 102, 204) rgb(20.00%, 40.00%, 80.00%) hsl(220, 60.0%, 50.0%)
     background: #3366cc -> #3366cc - rgb(51, 102, 204) rgb(20.00%, 40.00%, 80.00%) hsl(220, 60.0%, 50.0%)
     border-bottom: #224488 -> #224488 - rgb(34, 68, 136) rgb(13.33%, 26.67%, 53.33%) hsl(220, 60.0%, 33.3%)
     contrast 5.37:1 (L 1.0000 on 0.1457) AA
   nav a
     color: navy -> #000080 navy rgb(0, 0, 128) rgb(0%, 0%, 50%) hsl(240, 100.0%, 25.1%)
     background-color: #f0f0f0 -> #f0f0f0 - rgb(240, 240, 240) rgb(94.12%, 94.12%, 94.12%) hsl(0, 0.0%, 94.1%)
     contrast 14.05:1 (L 0.0156 on 0.8714) AAA
   nav a:hover
     color: rgb(100%, 40%, 0%) -> #ff6600 - rgb(255, 102, 0) rgb(100%, 40.00%, 0%) hsl(24, 100.0%, 50.0%)
     background-color: #FFFFF0 -> #fffff0 ivory rgb(255, 255, 240) rgb(100%, 100%, 94.12%) hsl(60, 100.0%, 97.1%)
     contrast 2.91:1 (L 0.3076 on 0.9907) fails
   .button-primary
     color: #fff -> #ffffff white rgb(255, 255, 255) rgb(100%, 100%, 100%) hsl(0, 0.0%, 100.0%)
     background-color: rgb(51, 102, 204) -> #3366cc - rgb(51, 102, 204) rgb(20.00%, 40.00%, 80.00%) hsl(220, 60.0%, 50.0%)
     border: DarkSlateGrey -> #2f4f4f darkslategray rgb(47, 79, 79) rgb(18.43%, 30.98%, 30.98%) hsl(180, 25.4%, 24.7%)
     contrast 5.37:1 (L 1.0000 on 0.1457) AA
   .button-muted
     color: silver -> #c0c0c0 silver rgb(192, 192, 192) rgb(75.29%, 75.29%, 75.29%) hsl(0, 0.0%, 75.3%)
     background-color: whitesmoke -> #f5f5f5 whitesmoke rgb(245, 245, 245) rgb(96.08%, 96.08%, 96.08%) hsl(0, 0.0%, 96.1%)
     contrast 1.67:1 (L 0.5271 on 0.9131) fails
