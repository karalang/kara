// ---------------------------------------------------------------- webcolors

struct IntegerRgb {
    red: i64,
    green: i64,
    blue: i64,
}

struct PercentRgb {
    red: String,
    green: String,
    blue: String,
}

fn rgb_repr(kind: ref String, c: ref IntegerRgb) -> String {
    f"{kind}(red={c.red}, green={c.green}, blue={c.blue})"
}

fn pct_repr(c: ref PercentRgb) -> String {
    f"PercentRGB(red={py_repr(c.red)}, green={py_repr(c.green)}, blue={py_repr(c.blue)})"
}

// One specification's names: name to hex, hex to name, and the names in
// alphabetical order.
struct Spec {
    name: String,
    to_hex: Map[String, String],
    to_name: Map[String, String],
    names: Vec[String],
}

struct Colors {
    specs: Vec[Spec],
}

// _reversedict: for a value two names share, the later name wins.
fn make_spec(name: ref String, list: ref Vec[(String, String)]) -> Spec {
    let mut to_hex: Map[String, String] = Map.new();
    let mut to_name: Map[String, String] = Map.new();
    let mut names: Vec[String] = Vec.new();
    for (n, h) in list {
        to_hex.insert(n.clone(), h.clone());
        to_name.insert(h.clone(), n.clone());
        names.push(n.clone());
    }
    names.sort();
    Spec { name: name.clone(), to_hex: to_hex, to_name: to_name, names: names }
}

fn colors() -> Colors {
    let html4 = html4_names_to_hex();
    let mut css21: Vec[(String, String)] = Vec.new();
    css21.push(("orange".to_string(), "#ffa500".to_string()));
    for (n, h) in html4 {
        css21.push((n.clone(), h.clone()));
    }
    let mut css3 = make_spec("css3".to_string(), css3_names_to_hex());
    // "gray" was the only spelling in HTML 4, CSS1 and CSS2.
    css3.to_name.insert("#a9a9a9".to_string(), "darkgray".to_string());
    css3.to_name.insert("#2f4f4f".to_string(), "darkslategray".to_string());
    css3.to_name.insert("#696969".to_string(), "dimgray".to_string());
    css3.to_name.insert("#808080".to_string(), "gray".to_string());
    css3.to_name.insert("#d3d3d3".to_string(), "lightgray".to_string());
    css3.to_name.insert("#778899".to_string(), "lightslategray".to_string());
    css3.to_name.insert("#708090".to_string(), "slategray".to_string());
    let mut specs: Vec[Spec] = Vec.new();
    specs.push(make_spec("html4".to_string(), html4));
    specs.push(make_spec("css2".to_string(), html4));
    specs.push(make_spec("css21".to_string(), css21));
    specs.push(css3);
    Colors { specs: specs }
}

impl Colors {
    // The index of the named specification.
    fn spec(ref self, spec: ref String) -> Result[i64, String] {
        for k in 0..self.specs.len() {
            if self.specs[k].name == spec {
                return Ok(k);
            }
        }
        Err(f"{spec} is not a supported specification for color name lookups; supported specifications are: ('html4', 'css2', 'css21', 'css3').")
    }

    fn names(ref self, spec: ref String) -> Result[Vec[String], String] {
        let k = self.spec(spec)?;
        Ok(self.specs[k].names.clone())
    }

    fn name_to_hex(ref self, name: ref String, spec: ref String) -> Result[String, String] {
        let k = self.spec(spec)?;
        match self.specs[k].to_hex.get(name.to_lowercase()) {
            Some(h) => Ok(h.clone()),
            None => Err(f"\"{name}\" is not defined as a named color in {spec}"),
        }
    }

    fn name_to_rgb(ref self, name: ref String, spec: ref String) -> Result[IntegerRgb, String] {
        hex_to_rgb(self.name_to_hex(name, spec)?)
    }

    fn name_to_rgb_percent(ref self, name: ref String, spec: ref String) -> Result[PercentRgb, String] {
        Ok(rgb_to_rgb_percent(self.name_to_rgb(name, spec)?))
    }

    fn hex_to_name(ref self, hex_value: ref String, spec: ref String) -> Result[String, String] {
        let k = self.spec(spec)?;
        match self.specs[k].to_name.get(normalize_hex(hex_value)?) {
            Some(n) => Ok(n.clone()),
            None => Err(f"\"{hex_value}\" has no defined color name in {spec}."),
        }
    }

    fn rgb_to_name(ref self, c: ref IntegerRgb, spec: ref String) -> Result[String, String] {
        self.hex_to_name(rgb_to_hex(normalize_integer_triplet(c)), spec)
    }

    fn rgb_percent_to_name(ref self, c: ref PercentRgb, spec: ref String) -> Result[String, String] {
        let rgb = rgb_percent_to_rgb(normalize_percent_triplet(c)?)?;
        self.rgb_to_name(rgb, spec)
    }
}

// _HEX_COLOR_RE.match: "#" and three or six ASCII hex digits, then the
// end, where `$` also matches before a final newline.
fn normalize_hex(hex_value: ref String) -> Result[String, String] {
    let mut cs = to_chars(hex_value);
    if cs.len() > 0 and cs[cs.len() - 1] == '\n' {
        cs.pop();
    }
    let n = cs.len() - 1;
    let mut ok = cs.len() > 0 and cs[0] == '#' and (n == 3 or n == 6);
    if ok {
        for k in 1..cs.len() {
            if not is_hex(cs[k]) {
                ok = false;
            }
        }
    }
    if not ok {
        return Err(f"\"{hex_value}\" is not a valid hexadecimal color value.");
    }
    let mut out = "#".to_string();
    for k in 1..cs.len() {
        let c = ascii_lower(cs[k]);
        out.push(c);
        if n == 3 {
            out.push(c);
        }
    }
    Ok(out)
}

fn hex_digit(c: char) -> i64 {
    let l = ascii_lower(c);
    if l >= 'a' { l as i64 - 87 } else { l as i64 - 48 }
}

// int(s, 16) for ASCII hex digits.
fn hex_int(s: ref String) -> i64 {
    let mut v = 0;
    for c in s.chars() {
        v = v * 16 + hex_digit(c);
    }
    v
}

fn clip_int(v: i64) -> i64 {
    if v < 0 { 0 } else if v > 255 { 255 } else { v }
}

fn normalize_integer_triplet(c: ref IntegerRgb) -> IntegerRgb {
    IntegerRgb { red: clip_int(c.red), green: clip_int(c.green), blue: clip_int(c.blue) }
}

fn normalize_percent(value: ref String) -> Result[String, String] {
    let v = before(value, '%');
    if v.contains(".") {
        let p = py_float(v)?;
        if p < 0.0 {
            Ok("0%".to_string())
        } else if p > 100.0 {
            Ok("100%".to_string())
        } else {
            Ok(f"{float_repr(p)}%")
        }
    } else {
        let p = py_int(v)?;
        if p < 0 {
            Ok("0%".to_string())
        } else if p > 100 {
            Ok("100%".to_string())
        } else {
            Ok(f"{p}%")
        }
    }
}

fn normalize_percent_triplet(c: ref PercentRgb) -> Result[PercentRgb, String] {
    let red = normalize_percent(c.red)?;
    let green = normalize_percent(c.green)?;
    let blue = normalize_percent(c.blue)?;
    Ok(PercentRgb { red: red, green: green, blue: blue })
}

fn percent_to_integer(percent: ref String) -> Result[i64, String] {
    let p = py_float(before(percent, '%'))?;
    py_round(p / 100.0 * 255.0)
}

fn hex_to_rgb(hex_value: ref String) -> Result[IntegerRgb, String] {
    let h = normalize_hex(hex_value)?;
    let cs = to_chars(h);
    let v = hex_int(text(cs, 1, cs.len()));
    Ok(IntegerRgb { red: v >> 16, green: (v >> 8) & 0xff, blue: v & 0xff })
}

fn hex_to_rgb_percent(hex_value: ref String) -> Result[PercentRgb, String] {
    Ok(rgb_to_rgb_percent(hex_to_rgb(hex_value)?))
}

fn rgb_to_hex(c: ref IntegerRgb) -> String {
    let n = normalize_integer_triplet(c);
    f"#{hex(n.red, 2)}{hex(n.green, 2)}{hex(n.blue, 2)}"
}

fn channel_percent(d: i64) -> String {
    if d == 255 {
        "100%".to_string()
    } else if d == 128 {
        "50%".to_string()
    } else if d == 64 {
        "25%".to_string()
    } else if d == 32 {
        "12.5%".to_string()
    } else if d == 16 {
        "6.25%".to_string()
    } else if d == 0 {
        "0%".to_string()
    } else {
        f"{fixed(d as f64 / 255.0 * 100.0, 2)}%"
    }
}

fn rgb_to_rgb_percent(c: ref IntegerRgb) -> PercentRgb {
    let n = normalize_integer_triplet(c);
    PercentRgb { red: channel_percent(n.red), green: channel_percent(n.green), blue: channel_percent(n.blue) }
}

fn rgb_percent_to_rgb(c: ref PercentRgb) -> Result[IntegerRgb, String] {
    let n = normalize_percent_triplet(c)?;
    let red = percent_to_integer(n.red)?;
    let green = percent_to_integer(n.green)?;
    let blue = percent_to_integer(n.blue)?;
    Ok(IntegerRgb { red: red, green: green, blue: blue })
}

fn rgb_percent_to_hex(c: ref PercentRgb) -> Result[String, String] {
    Ok(rgb_to_hex(rgb_percent_to_rgb(normalize_percent_triplet(c)?)?))
}

// ---------------------------------------------------------------- HTML5

fn all_hex(cs: ref Vec[char], lo: i64) -> bool {
    for k in lo..cs.len() {
        if not is_hex(cs[k]) {
            return false;
        }
    }
    true
}

fn html5_parse_simple_color(value: ref String) -> Result[IntegerRgb, String] {
    let cs = to_chars(value);
    if cs.len() != 7 {
        return Err("An HTML5 simple color must be a Unicode string seven characters long.".to_string());
    }
    if cs[0] != '#' {
        return Err("An HTML5 simple color must begin with the character '#' (U+0023).".to_string());
    }
    if not all_hex(cs, 1) {
        return Err("An HTML5 simple color must contain exactly six ASCII hex digits.".to_string());
    }
    Ok(IntegerRgb { red: hex_int(text(cs, 1, 3)), green: hex_int(text(cs, 3, 5)), blue: hex_int(text(cs, 5, 7)) })
}

fn html5_serialize_simple_color(c: ref IntegerRgb) -> String {
    let mut result = "#".to_string();
    result.push_str(hex(c.red, 2));
    result.push_str(hex(c.green, 2));
    result.push_str(hex(c.blue, 2));
    result
}

fn html5_parse_legacy_color(colors: ref Colors, raw: ref String) -> Result[IntegerRgb, String] {
    if raw == "" {
        return Err("HTML5 legacy color parsing forbids empty string as a value.".to_string());
    }
    let value = py_strip(raw);
    if value.to_lowercase() == "transparent" {
        return Err("HTML5 legacy color parsing forbids \"transparent\" as a value.".to_string());
    }
    if let Ok(keyword_hex) = colors.name_to_hex(value, "css3".to_string()) {
        return html5_parse_simple_color(keyword_hex);
    }
    let cs = to_chars(value);
    if cs.len() == 4 and cs[0] == '#' and all_hex(cs, 1) {
        return Ok(IntegerRgb { red: hex_digit(cs[1]) * 17, green: hex_digit(cs[2]) * 17, blue: hex_digit(cs[3]) * 17 });
    }
    // Characters outside the BMP become "00".
    let mut v: Vec[char] = Vec.new();
    for c in cs {
        if (c as i64) > 0xffff {
            v.push('0');
            v.push('0');
        } else {
            v.push(c);
        }
    }
    if v.len() > 128 {
        v.truncate(128);
    }
    let start = if v.len() > 0 and v[0] == '#' { 1 } else { 0 };
    let mut d: Vec[char] = Vec.new();
    for k in start..v.len() {
        d.push(if is_hex(v[k]) { v[k] } else { '0' });
    }
    while d.len() == 0 or d.len() % 3 != 0 {
        d.push('0');
    }
    let mut length = d.len() / 3;
    let mut red = text(d, 0, length);
    let mut green = text(d, length, length * 2);
    let mut blue = text(d, length * 2, d.len());
    if length > 8 {
        red = tail_chars(red, length - 8);
        green = tail_chars(green, length - 8);
        blue = tail_chars(blue, length - 8);
        length = 8;
    }
    while length > 2 and red.starts_with("0") and green.starts_with("0") and blue.starts_with("0") {
        red = tail_chars(red, 1);
        green = tail_chars(green, 1);
        blue = tail_chars(blue, 1);
        length -= 1;
    }
    if length > 2 {
        red = head_chars(red, 2);
        green = head_chars(green, 2);
        blue = head_chars(blue, 2);
    }
    Ok(IntegerRgb { red: hex_int(red), green: hex_int(green), blue: hex_int(blue) })
}

// s[k:]
fn tail_chars(s: ref String, k: i64) -> String {
    let cs = to_chars(s);
    text(cs, k, cs.len())
}

// s[:k]
fn head_chars(s: ref String, k: i64) -> String {
    let cs = to_chars(s);
    text(cs, 0, k)
}

// ---------------------------------------------------------------- the audit

fn is_color_prop(p: ref String) -> bool {
    p == "color" or p == "background-color" or p == "background" or p == "border"
        or p == "border-color" or p == "border-top" or p == "border-bottom"
        or p == "outline" or p == "fill" or p == "stroke"
}

fn strip_comments(css: ref Vec[char]) -> Vec[char] {
    let mut out: Vec[char] = Vec.new();
    let mut i = 0;
    while i < css.len() {
        if css[i] == '/' and i + 1 < css.len() and css[i + 1] == '*' {
            let mut j = i + 2;
            while j + 1 < css.len() and not (css[j] == '*' and css[j + 1] == '/') {
                j += 1;
            }
            i = if j + 1 < css.len() { j + 2 } else { css.len() };
        } else {
            out.push(css[i]);
            i += 1;
        }
    }
    out
}

fn find_char(cs: ref Vec[char], c: char, from: i64) -> i64 {
    let mut k = from;
    while k < cs.len() {
        if cs[k] == c {
            return k;
        }
        k += 1;
    }
    -1
}

struct Rule {
    selector: String,
    decls: Vec[(String, String)],
}

fn rules(css: ref String) -> Vec[Rule] {
    let cs = strip_comments(to_chars(css));
    let mut out: Vec[Rule] = Vec.new();
    let mut i = 0;
    loop {
        let a = find_char(cs, '{', i);
        if a < 0 {
            return out;
        }
        let b = find_char(cs, '}', a);
        let selector = py_strip(text(cs, i, a));
        let mut decls: Vec[(String, String)] = Vec.new();
        for d in text(cs, a + 1, b).split(";") {
            let dc = to_chars(d.to_string());
            let colon = find_char(dc, ':', 0);
            if colon < 0 {
                continue;
            }
            let prop = py_strip(text(dc, 0, colon)).to_lowercase();
            let value = py_strip(text(dc, colon + 1, dc.len()));
            decls.push((prop, value));
        }
        out.push(Rule { selector: selector, decls: decls });
        i = b + 1;
    }
}

fn tokens(value: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    let mut depth = 0;
    for c in value.chars() {
        if depth == 0 and (c == ' ' or c == '\t' or c == '\n' or c == ',') {
            if cur.len() > 0 {
                out.push(cur.clone());
            }
            cur = String.new();
            continue;
        }
        if c == '(' {
            depth += 1;
        } else if c == ')' {
            depth -= 1;
        }
        cur.push(c);
    }
    if cur.len() > 0 {
        out.push(cur);
    }
    out
}

// A token's color as a normalized hex, None when the token is not meant
// as a color, or the error when it is a broken one.
fn parse_color(colors: ref Colors, tok: ref String, custom: ref Map[String, String]) -> Result[Option[String], String] {
    let low = tok.to_lowercase();
    let cs = to_chars(tok);
    if tok.starts_with("#") {
        return Ok(Some(normalize_hex(tok)?));
    }
    if low.starts_with("rgb(") and tok.ends_with(")") {
        let mut args: Vec[String] = Vec.new();
        for a in text(cs, 4, cs.len() - 1).split(",") {
            args.push(py_strip(a.to_string()));
        }
        if args.len() != 3 {
            return Err(f"rgb() takes three values, not {args.len()}");
        }
        if args[0].ends_with("%") and args[1].ends_with("%") and args[2].ends_with("%") {
            let p = PercentRgb { red: args[0].clone(), green: args[1].clone(), blue: args[2].clone() };
            return Ok(Some(rgb_percent_to_hex(p)?));
        }
        let c = IntegerRgb { red: py_int(args[0])?, green: py_int(args[1])?, blue: py_int(args[2])? };
        return Ok(Some(rgb_to_hex(c)));
    }
    if low.starts_with("var(") and tok.ends_with(")") {
        let name = py_strip(text(cs, 4, cs.len() - 1));
        return match custom.get(name) {
            Some(h) => Ok(Some(h.clone())),
            None => Err(f"{name} is not defined"),
        };
    }
    match colors.name_to_hex(tok, "css3".to_string()) {
        Ok(h) => Ok(Some(h)),
        Err(_) => Ok(None),
    }
}

fn chan(v: i64) -> f64 {
    let c = v as f64 / 255.0;
    if c <= 0.03928 { c / 12.92 } else { ((c + 0.055) / 1.055).pow(2.4) }
}

fn luminance(c: ref IntegerRgb) -> f64 {
    0.2126 * chan(c.red) + 0.7152 * chan(c.green) + 0.0722 * chan(c.blue)
}

fn fmax(a: f64, b: f64) -> f64 {
    if a >= b { a } else { b }
}

fn fmin(a: f64, b: f64) -> f64 {
    if a <= b { a } else { b }
}

// colorsys.rgb_to_hls.
fn rgb_to_hls(r: f64, g: f64, b: f64) -> (f64, f64, f64) {
    let maxc = fmax(fmax(r, g), b);
    let minc = fmin(fmin(r, g), b);
    let sumc = maxc + minc;
    let rangec = maxc - minc;
    let l = sumc / 2.0;
    if minc == maxc {
        return (0.0, l, 0.0);
    }
    let s = if l <= 0.5 { rangec / sumc } else { rangec / (2.0 - maxc - minc) };
    let rc = (maxc - r) / rangec;
    let gc = (maxc - g) / rangec;
    let bc = (maxc - b) / rangec;
    let h = if r == maxc { bc - gc } else if g == maxc { 2.0 + rc - bc } else { 4.0 + gc - rc };
    (py_fmod(h / 6.0, 1.0), l, s)
}

fn describe(colors: ref Colors, h: ref String) -> Result[String, String] {
    let rgb = hex_to_rgb(h)?;
    let name = match colors.hex_to_name(h, "css3".to_string()) {
        Ok(n) => n,
        Err(_) => "-".to_string(),
    };
    let pct = rgb_to_rgb_percent(rgb);
    let (hh, ll, ss) = rgb_to_hls(rgb.red as f64 / 255.0, rgb.green as f64 / 255.0, rgb.blue as f64 / 255.0);
    Ok(f"{h} {name} rgb({rgb.red}, {rgb.green}, {rgb.blue}) rgb({pct.red}, {pct.green}, {pct.blue}) hsl({fixed(hh * 360.0, 0)}, {fixed(ss * 100.0, 1)}%, {fixed(ll * 100.0, 1)}%)")
}

fn nearest(colors: ref Colors, h: ref String) -> Result[(String, i64), String] {
    let rgb = hex_to_rgb(h)?;
    let mut best = String.new();
    let mut best_d = -1;
    let css3 = "css3".to_string();
    for n in colors.names(css3)? {
        let o = colors.name_to_rgb(n, css3)?;
        let dr = o.red - rgb.red;
        let dg = o.green - rgb.green;
        let db = o.blue - rgb.blue;
        let d = dr * dr + dg * dg + db * db;
        if best_d < 0 or d < best_d {
            best = n.clone();
            best_d = d;
        }
    }
    Ok((best, best_d))
}

fn audit(colors: ref Colors, path: ref String) -> Result[(), String] {
    let css = match fs.read_to_string(path.clone()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read {path}: {e}"),
    };
    let mut custom: Map[String, String] = Map.new();
    let mut uses: Map[String, i64] = Map.new();
    let mut n_rules = 0;
    let mut n_decls = 0;
    let mut n_bad = 0;
    let mut n_pairs = 0;
    let mut n_fail = 0;
    for rule in rules(css) {
        n_rules += 1;
        println(f"   {rule.selector}");
        let mut resolved: Map[String, String] = Map.new();
        for (prop, value) in rule.decls {
            if not (is_color_prop(prop) or prop.starts_with("--")) {
                continue;
            }
            n_decls += 1;
            let mut found: Vec[(String, String)] = Vec.new();
            let mut bad: Option[String] = None;
            for tok in tokens(value) {
                match parse_color(colors, tok, custom) {
                    Ok(Some(h)) => found.push((tok.clone(), h)),
                    Ok(None) => {}
                    Err(e) => {
                        bad = Some(e);
                        break;
                    }
                }
            }
            if let Some(e) = bad {
                n_bad += 1;
                println(f"     {prop}: {value} -> invalid: {e}");
                continue;
            }
            if found.len() == 0 {
                if prop == "color" or prop == "background-color" {
                    n_bad += 1;
                    println(f"     {prop}: {value} -> not a color");
                }
                continue;
            }
            for (tok, h) in found {
                println(f"     {prop}: {tok} -> {describe(colors, h)?}");
                let n = match uses.get(h) {
                    Some(k) => *k,
                    None => 0,
                };
                uses.insert(h.clone(), n + 1);
            }
            let first = found[0].1.clone();
            if prop.starts_with("--") {
                custom.insert(prop.clone(), first.clone());
            }
            if prop == "background" and not resolved.contains_key("background-color".to_string()) {
                resolved.insert("background-color".to_string(), first.clone());
            }
            resolved.insert(prop.clone(), first);
        }
        if let (Some(fg_hex), Some(bg_hex)) = (resolved.get("color".to_string()), resolved.get("background-color".to_string())) {
            n_pairs += 1;
            let fg = luminance(hex_to_rgb(fg_hex)?);
            let bg = luminance(hex_to_rgb(bg_hex)?);
            let ratio = (fmax(fg, bg) + 0.05) / (fmin(fg, bg) + 0.05);
            let grade = if ratio >= 7.0 {
                "AAA"
            } else if ratio >= 4.5 {
                "AA"
            } else if ratio >= 3.0 {
                "AA large text only"
            } else {
                n_fail += 1;
                "fails"
            };
            println(f"     contrast {fixed(ratio, 2)}:1 (L {fixed(fg, 4)} on {fixed(bg, 4)}) {grade}");
        }
    }
    println("   palette:");
    let mut hexes: Vec[String] = Vec.new();
    for (h, _n) in uses {
        hexes.push(h.clone());
    }
    hexes.sort();
    for h in hexes {
        let name = match colors.hex_to_name(h, "css3".to_string()) {
            Ok(n) => n,
            Err(_) => {
                let (n, d) = nearest(colors, h)?;
                f"~{n} (distance^2 {d})"
            }
        };
        let count = match uses.get(h) {
            Some(k) => *k,
            None => 0,
        };
        println(f"     {h} x{count} {name}");
    }
    println(f"   {n_rules} rules, {n_decls} color declarations, {n_bad} invalid, {uses.len()} distinct colors, {n_pairs} contrast pairs, {n_fail} failing");
    Ok(())
}

// ---------------------------------------------------------------- jobs

fn unesc(s: ref String) -> String {
    let cs = to_chars(s);
    let mut out = String.new();
    let mut i = 0;
    while i < cs.len() {
        if cs[i] == '\\' and i + 1 < cs.len() {
            let n = cs[i + 1];
            out.push(if n == 't' { '\t' } else if n == 'n' { '\n' } else { '\\' });
            i += 2;
        } else {
            out.push(cs[i]);
            i += 1;
        }
    }
    out
}

fn triple(args: ref Vec[String]) -> Result[IntegerRgb, String] {
    Ok(IntegerRgb { red: py_int(args[0])?, green: py_int(args[1])?, blue: py_int(args[2])? })
}

fn ptriple(args: ref Vec[String]) -> PercentRgb {
    PercentRgb { red: args[0].clone(), green: args[1].clone(), blue: args[2].clone() }
}

fn percent_roundtrip(colors: ref Colors) -> Result[(), String] {
    let mut same = 0;
    for d in 0..256 {
        let p = rgb_to_rgb_percent(IntegerRgb { red: d, green: d, blue: d });
        let back = rgb_percent_to_rgb(p)?;
        if back.red == d {
            same += 1;
        } else {
            println(f"   {d} -> {p.red} -> {back.red}");
        }
    }
    println(f"   {same} of 256 come back");
    Ok(())
}

fn name_roundtrip(colors: ref Colors, spec: ref String) -> Result[(), String] {
    let all_names = colors.names(spec)?;
    let mut same = 0;
    for n in all_names {
        let h = colors.name_to_hex(n, spec)?;
        let p = rgb_to_rgb_percent(hex_to_rgb(h)?);
        let h2 = rgb_percent_to_hex(p)?;
        let n2 = colors.hex_to_name(h2, spec)?;
        if n2 == n {
            same += 1;
        } else {
            println(f"   {n} -> {h} -> {p.red} {p.green} {p.blue} -> {h2} -> {n2}");
        }
    }
    println(f"   {all_names.len()} names, {same} come back as themselves");
    Ok(())
}

fn str_ok(r: own Result[String, String]) -> Result[String, String] {
    Ok(py_repr(r?))
}

// The operation's result as repr() shows it, or ValueError's message.
fn eval_op(colors: ref Colors, op: ref String, args: ref Vec[String]) -> Result[String, String] {
    let rgb_kind = "IntegerRGB".to_string();
    if op == "names" {
        Ok(py_list_repr(colors.names(args[0])?))
    } else if op == "name_to_hex" {
        str_ok(colors.name_to_hex(args[0], args[1]))
    } else if op == "name_to_rgb" {
        Ok(rgb_repr(rgb_kind, colors.name_to_rgb(args[0], args[1])?))
    } else if op == "name_to_rgb_percent" {
        Ok(pct_repr(colors.name_to_rgb_percent(args[0], args[1])?))
    } else if op == "normalize_hex" {
        str_ok(normalize_hex(args[0]))
    } else if op == "hex_to_name" {
        str_ok(colors.hex_to_name(args[0], args[1]))
    } else if op == "hex_to_rgb" {
        Ok(rgb_repr(rgb_kind, hex_to_rgb(args[0])?))
    } else if op == "hex_to_rgb_percent" {
        Ok(pct_repr(hex_to_rgb_percent(args[0])?))
    } else if op == "normalize_integer_triplet" {
        Ok(rgb_repr(rgb_kind, normalize_integer_triplet(triple(args)?)))
    } else if op == "rgb_to_hex" {
        Ok(py_repr(rgb_to_hex(triple(args)?)))
    } else if op == "rgb_to_rgb_percent" {
        Ok(pct_repr(rgb_to_rgb_percent(triple(args)?)))
    } else if op == "rgb_to_name" {
        str_ok(colors.rgb_to_name(triple(args)?, args[3]))
    } else if op == "html5_serialize_simple_color" {
        Ok(py_repr(html5_serialize_simple_color(triple(args)?)))
    } else if op == "normalize_percent_triplet" {
        Ok(pct_repr(normalize_percent_triplet(ptriple(args))?))
    } else if op == "rgb_percent_to_rgb" {
        Ok(rgb_repr(rgb_kind, rgb_percent_to_rgb(ptriple(args))?))
    } else if op == "rgb_percent_to_hex" {
        str_ok(rgb_percent_to_hex(ptriple(args)))
    } else if op == "rgb_percent_to_name" {
        str_ok(colors.rgb_percent_to_name(ptriple(args), args[3]))
    } else if op == "html5_parse_simple_color" {
        Ok(rgb_repr("HTML5SimpleColor".to_string(), html5_parse_simple_color(args[0])?))
    } else if op == "html5_parse_legacy_color" {
        Ok(rgb_repr("HTML5SimpleColor".to_string(), html5_parse_legacy_color(colors, args[0])?))
    } else {
        Err(f"unknown op {op}")
    }
}

fn run_op(colors: ref Colors, fields: ref Vec[String]) -> Result[(), String] {
    let op = fields[0].clone();
    let mut args: Vec[String] = Vec.new();
    for k in 1..fields.len() {
        args.push(fields[k].clone());
    }
    if op == "audit" {
        println(f"-- audit {py_repr(args[0])}");
        return audit(colors, f"data/{args[0]}");
    }
    let mut head = f"-- {op}";
    for a in args {
        head.push(' ');
        head.push_str(py_repr(a));
    }
    println(head);
    if op == "percent_roundtrip" {
        return percent_roundtrip(colors);
    }
    if op == "name_roundtrip" {
        return name_roundtrip(colors, args[0]);
    }
    match eval_op(colors, op, args) {
        Ok(r) => println(f"   {r}"),
        Err(e) => println(f"   error: ValueError: {e}"),
    }
    Ok(())
}

fn run() -> Result[(), String] {
    let colors = colors();
    let jobs = match fs.read_to_string("data/jobs.tsv") {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/jobs.tsv: {e}"),
    };
    for line in jobs.lines() {
        if line.starts_with("== ") {
            println(line);
            continue;
        }
        let mut fields: Vec[String] = Vec.new();
        for f in line.split("\t") {
            fields.push(unesc(f.to_string()));
        }
        run_op(colors, fields)?;
    }
    Ok(())
}

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn hex_val(c: u8) -> u8 {
    if c >= b'a' { c - b'a' + 10 } else { c - b'0' }
}

fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    if let Err(e) = run() {
        eprintln(e);
    }
}

// ------------------------------------------------------------ data

// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    v
}

