fn data_part_1(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("/* Main stylesheet for the shop front. */\n");
    t.push_str(":root {\n");
    t.push_str("  --brand: #3366CC;\n");
    t.push_str("  --accent: rgb(255, 102, 0);\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("body {\n");
    t.push_str("  color: #333;\n");
    t.push_str("  background-color: White;\n");
    t.push_str("  font-family: Georgia, serif;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("header, .masthead {\n");
    t.push_str("  color: rgb(255, 255, 255);\n");
    t.push_str("  background-color: var(--brand);\n");
    t.push_str("  background: #3366cc url(header.png) no-repeat;\n");
    t.push_str("  border-bottom: 3px solid #224488;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("nav a {\n");
    t.push_str("  color: navy;\n");
    t.push_str("  background-color: #f0f0f0;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("nav a:hover {\n");
    t.push_str("  color: rgb(100%, 40%, 0%);\n");
    t.push_str("  background-color: #FFFFF0;\n");
    t.push_str("  text-decoration: underline;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str(".button-primary {\n");
    t.push_str("  color: #fff;\n");
    t.push_str("  background-color: rgb(51, 102, 204);\n");
    t.push_str("  border: 1px solid DarkSlateGrey;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str(".button-muted {\n");
    t.push_str("  color: silver;\n");
    t.push_str("  background-color: whitesmoke;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str(".alert-warning {\n");
    t.push_str("  color: #8a6d3b;\n");
    t.push_str("  background-color: #FCF8E3;\n");
    t.push_str("  border-color: #faebcc;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str(".alert-danger {\n");
    t.push_str("  color: rgb(169,68,66);\n");
    t.push_str("  background-color: rgb(242, 222, 222);\n");
    t.push_str("  outline: 2px dashed crimson;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str(".price {\n");
    t.push_str("  color: rgb(85.49%, 64.71%, 12.5%);\n");
    t.push_str("  background-color: black;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str(".sale-banner {\n");
    t.push_str("  color: yellow;\n");
    t.push_str("  background-color: #ff0;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("footer {\n");
    t.push_str("  color: GRAY;\n");
    t.push_str("  background-color: #222;\n");
    t.push_str("  border-top: 1px solid rgb(300, -20, 128);\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str(".legal {\n");
    t.push_str("  color: #777777;\n");
    t.push_str("  background-color: #333333;\n");
    t.push_str("  font-size: 0.75em;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str(".badge {\n");
    t.push_str("  color: Teal;\n");
    t.push_str("  background-color: #e0f2f1;\n");
    t.push_str("  border: thin dotted #0099cc;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str(".code {\n");
    t.push_str("  color: rebeccapurple;\n");
    t.push_str("  background-color: oldlace;\n");
    t.push_str("  fill: #ABCDEF;\n");
    t.push_str("  stroke: rgb(18, 52, 86);\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str(".oops {\n");
    t.push_str("  color: #ggg;\n");
    t.push_str("  background-color: notacolor;\n");
    t.push_str("  border-color: #12345;\n");
    t.push_str("}\n");
    v.push(DataFile { path: "site.css".to_string(), hex: false, body: t });
}
