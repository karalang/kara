    t.push_str("      {\n");
    t.push_str("        \"expression\": \"emptylist < one\",\n");
    t.push_str("        \"result\": null\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"emptylist < nullvalue\",\n");
    t.push_str("        \"result\": null\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"emptylist < boolvalue\",\n");
    t.push_str("        \"result\": null\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"one < boolvalue\",\n");
    t.push_str("        \"result\": null\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"one < two && three > one\",\n");
    t.push_str("        \"result\": true\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"one < two || three > one\",\n");
    t.push_str("        \"result\": true\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"one < two || three < one\",\n");
    t.push_str("        \"result\": true\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"two < one || three < one\",\n");
    t.push_str("        \"result\": false\n");
    t.push_str("      }\n");
    t.push_str("    ]\n");
    t.push_str("  }\n");
    t.push_str("]\n");
    v.push(DataFile { path: "suite/boolean.json".to_string(), hex: false, body: t });
}

fn data_part_11(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("[\n");
