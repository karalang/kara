    t.push_str("        \"foo.bar\": \"dot\",\n");
    t.push_str("        \"foo bar\": \"space\",\n");
    t.push_str("        \"foo\\nbar\": \"newline\",\n");
    t.push_str("        \"foo\\\"bar\": \"doublequote\",\n");
