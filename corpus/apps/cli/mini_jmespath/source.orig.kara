    t.push_str("    \"cases\": [\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"reservations[].instances[?bar==`1`]\",\n");
    t.push_str("        \"result\": [[{\"foo\": 2, \"bar\": 1}]]\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"reservations[*].instances[?bar==`1`]\",\n");
    t.push_str("        \"result\": [[{\"foo\": 2, \"bar\": 1}]]\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"reservations[].instances[?bar==`1`][]\",\n");
