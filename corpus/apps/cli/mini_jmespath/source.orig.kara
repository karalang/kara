    t.push_str("                \"expression\": \"`6`\",\n");
    t.push_str("                \"result\": 6\n");
    t.push_str("            },\n");
    t.push_str("            {\n");
    t.push_str("                \"expression\": \"`7`\",\n");
    t.push_str("                \"result\": 7\n");
