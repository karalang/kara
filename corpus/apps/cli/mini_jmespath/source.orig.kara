    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Valid multi-select of a hash\",\n");
    t.push_str("        \"expression\": \"foo.[abc, def]\",\n");
    t.push_str("        \"result\": null\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Multi-select of a hash using a numeric index\",\n");
    t.push_str("        \"expression\": \"foo.[abc, 1]\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Multi-select of a hash with a trailing comma\",\n");
    t.push_str("        \"expression\": \"foo.[abc, ]\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Multi-select of a hash with extra commas\",\n");
    t.push_str("        \"expression\": \"foo.[abc,, def]\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Multi-select of a hash using number indices\",\n");
    t.push_str("        \"expression\": \"foo.[0, 1]\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      }\n");
    t.push_str("    ]\n");
    t.push_str("  },\n");
    t.push_str("  {\n");
    t.push_str("    \"comment\": \"Multi-select hash syntax\",\n");
    t.push_str("    \"given\": {\"type\": \"object\"},\n");
    t.push_str("    \"cases\": [\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"No key or value\",\n");
    t.push_str("        \"expression\": \"a{}\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"No closing token\",\n");
    t.push_str("        \"expression\": \"a{\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Not a key value pair\",\n");
    t.push_str("        \"expression\": \"a{foo}\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Missing value and closing character\",\n");
    t.push_str("        \"expression\": \"a{foo:\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Missing closing character\",\n");
    t.push_str("        \"expression\": \"a{foo: 0\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Missing value\",\n");
    t.push_str("        \"expression\": \"a{foo:}\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Trailing comma and no closing character\",\n");
    t.push_str("        \"expression\": \"a{foo: 0, \",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Missing value with trailing comma\",\n");
    t.push_str("        \"expression\": \"a{foo: ,}\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Accessing Array using an identifier\",\n");
    t.push_str("        \"expression\": \"a{foo: bar}\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"a{foo: 0}\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Missing key-value pair\",\n");
    t.push_str("        \"expression\": \"a.{}\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Not a key-value pair\",\n");
    t.push_str("        \"expression\": \"a.{foo}\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Missing value\",\n");
    t.push_str("        \"expression\": \"a.{foo:}\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Missing value with trailing comma\",\n");
    t.push_str("        \"expression\": \"a.{foo: ,}\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Valid multi-select hash extraction\",\n");
    t.push_str("        \"expression\": \"a.{foo: bar}\",\n");
    t.push_str("        \"result\": null\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Valid multi-select hash extraction\",\n");
    t.push_str("        \"expression\": \"a.{foo: bar, baz: bam}\",\n");
    t.push_str("        \"result\": null\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Trailing comma\",\n");
    t.push_str("        \"expression\": \"a.{foo: bar, }\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Missing key in second key-value pair\",\n");
    t.push_str("        \"expression\": \"a.{foo: bar, baz}\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Missing value in second key-value pair\",\n");
    t.push_str("        \"expression\": \"a.{foo: bar, baz:}\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Trailing comma\",\n");
    t.push_str("        \"expression\": \"a.{foo: bar, baz: bam, }\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Nested multi select\",\n");
    t.push_str("        \"expression\": \"{\\\"\\\\\\\\\\\":{\\\" \\\":*}}\",\n");
    t.push_str("        \"result\": {\"\\\\\": {\" \": [\"object\"]}}\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Missing closing } after a valid nud\",\n");
    t.push_str("        \"expression\": \"{a: @\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      }\n");
    t.push_str("    ]\n");
    t.push_str("  },\n");
    t.push_str("  {\n");
    t.push_str("    \"comment\": \"Or expressions\",\n");
    t.push_str("    \"given\": {\"type\": \"object\"},\n");
    t.push_str("    \"cases\": [\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"foo || bar\",\n");
    t.push_str("        \"result\": null\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"foo ||\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"foo.|| bar\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \" || foo\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"foo || || foo\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"foo.[a || b]\",\n");
    t.push_str("        \"result\": null\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"foo.[a ||]\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"\\\"foo\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      }\n");
    t.push_str("    ]\n");
    t.push_str("  },\n");
    t.push_str("  {\n");
    t.push_str("    \"comment\": \"Filter expressions\",\n");
    t.push_str("    \"given\": {\"type\": \"object\"},\n");
    t.push_str("    \"cases\": [\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"foo[?bar==`\\\"baz\\\"`]\",\n");
    t.push_str("        \"result\": null\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"foo[? bar == `\\\"baz\\\"` ]\",\n");
    t.push_str("        \"result\": null\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"foo[ ?bar==`\\\"baz\\\"`]\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"foo[?bar==]\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"foo[?==]\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"foo[?==bar]\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"foo[?bar==baz?]\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"foo[?a.b.c==d.e.f]\",\n");
    t.push_str("        \"result\": null\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"foo[?bar==`[0, 1, 2]`]\",\n");
    t.push_str("        \"result\": null\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"foo[?bar==`[\\\"a\\\", \\\"b\\\", \\\"c\\\"]`]\",\n");
    t.push_str("        \"result\": null\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Literal char not escaped\",\n");
    t.push_str("        \"expression\": \"foo[?bar==`[\\\"foo`bar\\\"]`]\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Literal char escaped\",\n");
    t.push_str("        \"expression\": \"foo[?bar==`[\\\"foo\\\\`bar\\\"]`]\",\n");
    t.push_str("        \"result\": null\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Unknown comparator\",\n");
    t.push_str("        \"expression\": \"foo[?bar<>baz]\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Unknown comparator\",\n");
    t.push_str("        \"expression\": \"foo[?bar^baz]\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"foo[bar==baz]\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Quoted identifier in filter expression no spaces\",\n");
    t.push_str("        \"expression\": \"[?\\\"\\\\\\\\\\\">`\\\"foo\\\"`]\",\n");
    t.push_str("        \"result\": null\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Quoted identifier in filter expression with spaces\",\n");
    t.push_str("        \"expression\": \"[?\\\"\\\\\\\\\\\" > `\\\"foo\\\"`]\",\n");
    t.push_str("        \"result\": null\n");
    t.push_str("      }\n");
    t.push_str("    ]\n");
    t.push_str("  },\n");
    t.push_str("  {\n");
    t.push_str("    \"comment\": \"Filter expression errors\",\n");
    t.push_str("    \"given\": {\"type\": \"object\"},\n");
    t.push_str("    \"cases\": [\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"bar.`\\\"anything\\\"`\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"bar.baz.noexists.`\\\"literal\\\"`\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Literal wildcard projection\",\n");
    t.push_str("        \"expression\": \"foo[*].`\\\"literal\\\"`\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"foo[*].name.`\\\"literal\\\"`\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"foo[].name.`\\\"literal\\\"`\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"foo[].name.`\\\"literal\\\"`.`\\\"subliteral\\\"`\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Projecting a literal onto an empty list\",\n");
    t.push_str("        \"expression\": \"foo[*].name.noexist.`\\\"literal\\\"`\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"foo[].name.noexist.`\\\"literal\\\"`\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"twolen[*].`\\\"foo\\\"`\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Two level projection of a literal\",\n");
    t.push_str("        \"expression\": \"twolen[*].threelen[*].`\\\"bar\\\"`\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"Two level flattened projection of a literal\",\n");
    t.push_str("        \"expression\": \"twolen[].threelen[].`\\\"bar\\\"`\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"comment\": \"expects closing ]\",\n");
    t.push_str("        \"expression\": \"foo[? @ | @\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      }\n");
    t.push_str("    ]\n");
    t.push_str("  },\n");
    t.push_str("  {\n");
    t.push_str("    \"comment\": \"Identifiers\",\n");
    t.push_str("    \"given\": {\"type\": \"object\"},\n");
    t.push_str("    \"cases\": [\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"foo\",\n");
    t.push_str("        \"result\": null\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"\\\"foo\\\"\",\n");
    t.push_str("        \"result\": null\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"\\\"\\\\\\\\\\\"\",\n");
    t.push_str("        \"result\": null\n");
    t.push_str("      },\n");
    t.push_str("      {\n");
    t.push_str("        \"expression\": \"\\\"\\\\u\\\"\",\n");
    t.push_str("        \"error\": \"syntax\"\n");
    t.push_str("      }\n");
    t.push_str("    ]\n");
    t.push_str("  },\n");
    t.push_str("  {\n");
    t.push_str("    \"comment\": \"Combined syntax\",\n");
    t.push_str("    \"given\": [],\n");
    t.push_str("    \"cases\": [\n");
    t.push_str("        {\n");
    t.push_str("          \"expression\": \"*||*|*|*\",\n");
    t.push_str("          \"result\": null\n");
    t.push_str("        },\n");
    t.push_str("        {\n");
    t.push_str("          \"expression\": \"*[]||[*]\",\n");
    t.push_str("          \"result\": []\n");
    t.push_str("        },\n");
    t.push_str("        {\n");
    t.push_str("          \"expression\": \"[*.*]\",\n");
    t.push_str("          \"result\": [null]\n");
    t.push_str("        }\n");
    t.push_str("    ]\n");
    t.push_str("  }\n");
    t.push_str("]\n");
    v.push(DataFile { path: "suite/syntax.json".to_string(), hex: false, body: t });
}

fn data_part_21(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("[\n");
    t.push_str("    {\n");
    t.push_str("        \"given\": {\"foo\": [{\"✓\": \"✓\"}, {\"✓\": \"✗\"}]},\n");
    t.push_str("        \"cases\": [\n");
    t.push_str("            {\n");
    t.push_str("                \"expression\": \"foo[].\\\"✓\\\"\",\n");
    t.push_str("                \"result\": [\"✓\", \"✗\"]\n");
    t.push_str("            }\n");
    t.push_str("        ]\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("        \"given\": {\"☯\": true},\n");
    t.push_str("        \"cases\": [\n");
    t.push_str("            {\n");
    t.push_str("                \"expression\": \"\\\"☯\\\"\",\n");
    t.push_str("                \"result\": true\n");
    t.push_str("            }\n");
    t.push_str("        ]\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("        \"given\": {\"♪♫•*¨*•.¸¸❤¸¸.•*¨*•♫♪\": true},\n");
    t.push_str("        \"cases\": [\n");
    t.push_str("            {\n");
    t.push_str("                \"expression\": \"\\\"♪♫•*¨*•.¸¸❤¸¸.•*¨*•♫♪\\\"\",\n");
    t.push_str("                \"result\": true\n");
    t.push_str("            }\n");
    t.push_str("        ]\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("        \"given\": {\"☃\": true},\n");
    t.push_str("        \"cases\": [\n");
    t.push_str("            {\n");
    t.push_str("                \"expression\": \"\\\"☃\\\"\",\n");
    t.push_str("                \"result\": true\n");
    t.push_str("            }\n");
