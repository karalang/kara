    t.push_str("      \"result\": [9, 8, 7, 6]\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"foo[8:2:-2]\",\n");
    t.push_str("      \"result\": [8, 6, 4]\n");
