    t.push_str("      }\n");
    t.push_str("    }\n");
    t.push_str("  },\n");
    t.push_str("  \"cases\": [\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"foo.*.baz | [0]\",\n");
    t.push_str("      \"result\": \"subkey\"\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"foo.*.baz | [1]\",\n");
    t.push_str("      \"result\": \"subkey\"\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"foo.*.baz | [2]\",\n");
    t.push_str("      \"result\": \"subkey\"\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"foo.bar.* | [0]\",\n");
    t.push_str("      \"result\": \"subkey\"\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"foo.*.notbaz | [*]\",\n");
    t.push_str("      \"result\": [[\"a\", \"b\", \"c\"], [\"a\", \"b\", \"c\"]]\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"{\\\"a\\\": foo.bar, \\\"b\\\": foo.other} | *.baz\",\n");
    t.push_str("      \"result\": [\"subkey\", \"subkey\"]\n");
    t.push_str("    }\n");
    t.push_str("  ]\n");
    t.push_str("}, {\n");
    t.push_str("  \"given\": {\n");
    t.push_str("    \"foo\": {\n");
    t.push_str("      \"bar\": {\n");
    t.push_str("        \"baz\": \"one\"\n");
    t.push_str("      },\n");
    t.push_str("      \"other\": {\n");
    t.push_str("        \"baz\": \"two\"\n");
    t.push_str("      },\n");
    t.push_str("      \"other2\": {\n");
    t.push_str("        \"baz\": \"three\"\n");
    t.push_str("      },\n");
    t.push_str("      \"other3\": {\n");
    t.push_str("        \"notbaz\": [\"a\", \"b\", \"c\"]\n");
    t.push_str("      },\n");
    t.push_str("      \"other4\": {\n");
    t.push_str("        \"notbaz\": [\"d\", \"e\", \"f\"]\n");
    t.push_str("      }\n");
    t.push_str("    }\n");
    t.push_str("  },\n");
    t.push_str("  \"cases\": [\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"foo | bar\",\n");
    t.push_str("      \"result\": {\"baz\": \"one\"}\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"foo | bar | baz\",\n");
    t.push_str("      \"result\": \"one\"\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"foo|bar| baz\",\n");
    t.push_str("      \"result\": \"one\"\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"not_there | [0]\",\n");
    t.push_str("      \"result\": null\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"not_there | [0]\",\n");
    t.push_str("      \"result\": null\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"[foo.bar, foo.other] | [0]\",\n");
    t.push_str("      \"result\": {\"baz\": \"one\"}\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"{\\\"a\\\": foo.bar, \\\"b\\\": foo.other} | a\",\n");
    t.push_str("      \"result\": {\"baz\": \"one\"}\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"{\\\"a\\\": foo.bar, \\\"b\\\": foo.other} | b\",\n");
    t.push_str("      \"result\": {\"baz\": \"two\"}\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"foo.bam || foo.bar | baz\",\n");
    t.push_str("      \"result\": \"one\"\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"foo | not_there || bar\",\n");
    t.push_str("      \"result\": {\"baz\": \"one\"}\n");
    t.push_str("    }\n");
    t.push_str("  ]\n");
    t.push_str("}, {\n");
    t.push_str("  \"given\": {\n");
    t.push_str("    \"foo\": [{\n");
    t.push_str("      \"bar\": [{\n");
    t.push_str("        \"baz\": \"one\"\n");
    t.push_str("      }, {\n");
    t.push_str("        \"baz\": \"two\"\n");
    t.push_str("      }]\n");
    t.push_str("    }, {\n");
    t.push_str("      \"bar\": [{\n");
    t.push_str("        \"baz\": \"three\"\n");
    t.push_str("      }, {\n");
    t.push_str("        \"baz\": \"four\"\n");
    t.push_str("      }]\n");
    t.push_str("    }]\n");
    t.push_str("  },\n");
    t.push_str("  \"cases\": [\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"foo[*].bar[*] | [0][0]\",\n");
    t.push_str("      \"result\": {\"baz\": \"one\"}\n");
    t.push_str("    }\n");
    t.push_str("  ]\n");
    t.push_str("}]\n");
    v.push(DataFile { path: "suite/pipe.json".to_string(), hex: false, body: t });
}

