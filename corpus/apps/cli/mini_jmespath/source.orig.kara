    t.push_str("      \"result\": [9, 8, 7, 6]\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"foo[8:2:0]\",\n");
    t.push_str("      \"error\": \"invalid-value\"\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"foo[8:2:0:1]\",\n");
    t.push_str("      \"error\": \"syntax\"\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"foo[8:2&]\",\n");
    t.push_str("      \"error\": \"syntax\"\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"foo[2:a:3]\",\n");
    t.push_str("      \"error\": \"syntax\"\n");
    t.push_str("    }\n");
    t.push_str("  ]\n");
    t.push_str("}, {\n");
    t.push_str("  \"given\": {\n");
    t.push_str("    \"foo\": [{\"a\": 1}, {\"a\": 2}, {\"a\": 3}],\n");
    t.push_str("    \"bar\": [{\"a\": {\"b\": 1}}, {\"a\": {\"b\": 2}},\n");
    t.push_str("\t    {\"a\": {\"b\": 3}}],\n");
    t.push_str("    \"baz\": 50\n");
    t.push_str("  },\n");
    t.push_str("  \"cases\": [\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"foo[:2].a\",\n");
    t.push_str("      \"result\": [1, 2]\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"foo[:2].b\",\n");
    t.push_str("      \"result\": []\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"foo[:2].a.b\",\n");
    t.push_str("      \"result\": []\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"bar[::-1].a.b\",\n");
    t.push_str("      \"result\": [3, 2, 1]\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"bar[:2].a.b\",\n");
    t.push_str("      \"result\": [1, 2]\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"baz[:2].a\",\n");
    t.push_str("      \"result\": null\n");
    t.push_str("    }\n");
    t.push_str("  ]\n");
    t.push_str("}, {\n");
    t.push_str("  \"given\": [{\"a\": 1}, {\"a\": 2}, {\"a\": 3}],\n");
    t.push_str("  \"cases\": [\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"[:]\",\n");
    t.push_str("      \"result\": [{\"a\": 1}, {\"a\": 2}, {\"a\": 3}]\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"[:2].a\",\n");
    t.push_str("      \"result\": [1, 2]\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"[::-1].a\",\n");
    t.push_str("      \"result\": [3, 2, 1]\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"[:2].b\",\n");
    t.push_str("      \"result\": []\n");
    t.push_str("    }\n");
    t.push_str("  ]\n");
    t.push_str("}]\n");
    v.push(DataFile { path: "suite/slice.json".to_string(), hex: false, body: t });
}

