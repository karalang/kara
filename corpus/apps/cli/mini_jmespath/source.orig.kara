    t.push_str("        \"bar\": {\"baz\": \"qux\"}\n");
    t.push_str("     },\n");
    t.push_str("     \"cases\": [\n");
    t.push_str("         {\n");
    t.push_str("            \"expression\": \"\\\"foo.bar\\\"\",\n");
    t.push_str("            \"result\": \"dot\"\n");
    t.push_str("         },\n");
    t.push_str("         {\n");
    t.push_str("            \"expression\": \"\\\"foo bar\\\"\",\n");
    t.push_str("            \"result\": \"space\"\n");
    t.push_str("         },\n");
    t.push_str("         {\n");
    t.push_str("            \"expression\": \"\\\"foo\\\\nbar\\\"\",\n");
    t.push_str("            \"result\": \"newline\"\n");
    t.push_str("         },\n");
    t.push_str("         {\n");
    t.push_str("            \"expression\": \"\\\"foo\\\\\\\"bar\\\"\",\n");
    t.push_str("            \"result\": \"doublequote\"\n");
    t.push_str("         },\n");
    t.push_str("         {\n");
    t.push_str("            \"expression\": \"\\\"c:\\\\\\\\\\\\\\\\windows\\\\\\\\path\\\"\",\n");
    t.push_str("            \"result\": \"windows\"\n");
    t.push_str("         },\n");
    t.push_str("         {\n");
    t.push_str("            \"expression\": \"\\\"/unix/path\\\"\",\n");
    t.push_str("            \"result\": \"unix\"\n");
    t.push_str("         },\n");
    t.push_str("         {\n");
    t.push_str("            \"expression\": \"\\\"\\\\\\\"\\\\\\\"\\\\\\\"\\\"\",\n");
    t.push_str("            \"result\": \"threequotes\"\n");
    t.push_str("         },\n");
    t.push_str("         {\n");
    t.push_str("            \"expression\": \"\\\"bar\\\".\\\"baz\\\"\",\n");
    t.push_str("            \"result\": \"qux\"\n");
    t.push_str("         }\n");
    t.push_str("     ]\n");
    t.push_str("}]\n");
    v.push(DataFile { path: "suite/escape.json".to_string(), hex: false, body: t });
}

