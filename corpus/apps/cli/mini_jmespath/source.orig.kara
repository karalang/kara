    t.push_str("                    \"foo\": [{\"name\": \"a\"}, {\"name\": \"b\"}],\n");
    t.push_str("                    \"bar\": {\"baz\": \"qux\"}\n");
    t.push_str("                }\n");
    t.push_str("            },\n");
    t.push_str("            {\n");
