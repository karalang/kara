    t.push_str("                \"result\": \"c\"\n");
    t.push_str("            },\n");
    t.push_str("            {\n");
    t.push_str("                \"comment\": \"literal . identifier bracket-expr\",\n");
    t.push_str("                \"expression\": \"`[0, 1, 2]`[1]\",\n");
    t.push_str("                \"result\": 1\n");
    t.push_str("            }\n");
    t.push_str("        ]\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"comment\": \"Literals\",\n");
    t.push_str("      \"given\": {\"type\": \"object\"},\n");
    t.push_str("      \"cases\": [\n");
    t.push_str("        {\n");
