    t.push_str("    {\n");
    t.push_str("      \"expression\": \"foo[::2]\",\n");
    t.push_str("      \"result\": [0, 2, 4, 6, 8]\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"foo[::-1]\",\n");
    t.push_str("      \"result\": [9, 8, 7, 6, 5, 4, 3, 2, 1, 0]\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"foo[1::2]\",\n");
    t.push_str("      \"result\": [1, 3, 5, 7, 9]\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
    t.push_str("      \"expression\": \"foo[10:0:-1]\",\n");
    t.push_str("      \"result\": [9, 8, 7, 6, 5, 4, 3, 2, 1]\n");
    t.push_str("    },\n");
    t.push_str("    {\n");
