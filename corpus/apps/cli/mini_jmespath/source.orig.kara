    t.push_str("          \"result\": \"foo\"\n");
    t.push_str("        },\n");
    t.push_str("        {\n");
    t.push_str("          \"expression\": \"'  foo  '\",\n");
    t.push_str("          \"result\": \"  foo  \"\n");
    t.push_str("        },\n");
    t.push_str("        {\n");
    t.push_str("          \"expression\": \"'0'\",\n");
    t.push_str("          \"result\": \"0\"\n");
    t.push_str("        },\n");
    t.push_str("        {\n");
    t.push_str("          \"expression\": \"'newline\\n'\",\n");
    t.push_str("          \"result\": \"newline\\n\"\n");
    t.push_str("        },\n");
    t.push_str("        {\n");
    t.push_str("          \"expression\": \"'\\n'\",\n");
    t.push_str("          \"result\": \"\\n\"\n");
    t.push_str("        },\n");
    t.push_str("        {\n");
    t.push_str("          \"expression\": \"'✓'\",\n");
    t.push_str("\t  \"result\": \"✓\"\n");
    t.push_str("        },\n");
    t.push_str("        {\n");
    t.push_str("          \"expression\": \"'𝄞'\",\n");
    t.push_str("\t  \"result\": \"𝄞\"\n");
    t.push_str("        },\n");
    t.push_str("        {\n");
    t.push_str("          \"expression\": \"'  [foo]  '\",\n");
    t.push_str("          \"result\": \"  [foo]  \"\n");
    t.push_str("        },\n");
    t.push_str("        {\n");
    t.push_str("          \"expression\": \"'[foo]'\",\n");
    t.push_str("          \"result\": \"[foo]\"\n");
    t.push_str("        },\n");
    t.push_str("        {\n");
    t.push_str("          \"comment\": \"Do not interpret escaped unicode.\",\n");
    t.push_str("          \"expression\": \"'\\\\u03a6'\",\n");
    t.push_str("          \"result\": \"\\\\u03a6\"\n");
    t.push_str("        },\n");
    t.push_str("        {\n");
    t.push_str("          \"comment\": \"Can escape the single quote\",\n");
    t.push_str("          \"expression\": \"'foo\\\\'bar'\",\n");
    t.push_str("          \"result\": \"foo'bar\"\n");
    t.push_str("        },\n");
    t.push_str("        {\n");
    t.push_str("          \"comment\": \"Backslash not followed by single quote is treated as any other character\",\n");
    t.push_str("          \"expression\": \"'\\\\z'\",\n");
    t.push_str("          \"result\": \"\\\\z\"\n");
    t.push_str("        },\n");
    t.push_str("        {\n");
    t.push_str("          \"comment\": \"Backslash not followed by single quote is treated as any other character\",\n");
    t.push_str("          \"expression\": \"'\\\\\\\\'\",\n");
    t.push_str("          \"result\": \"\\\\\\\\\"\n");
    t.push_str("        }\n");
    t.push_str("      ]\n");
    t.push_str("    }\n");
    t.push_str("]\n");
