// mini_jmespath: the JMESPath query language as jmespath 1.0.1 runs it on
// Python 3.13, the library behind `aws --query`, Ansible's json_query and
// the `jp` tool. It ports the lexer, the Pratt parser with its binding
// powers and error messages, the tree interpreter, and the 26 built-in
// functions with their argument type checks. Python's value model comes
// along: 1 == 1.0 == True, dict keys keep insertion order, sum() adds
// floats with Neumaier compensation, and the errors that leak out of the
// library are Python's own.
//
// The jobs in data/jobs.jsonl run the JMESPath compliance suite, `jp`
// queries over EC2, S3, CloudWatch and IAM output, a kubectl pod list and
// GitHub issues, and three hundred random expressions, some broken on
// purpose, through the parser and interpreter.

// ------------------------------------------------------------ values

// A Python value as json.loads makes it. Expr is a jmespath expression
// reference (`&expr`); each one evaluated is a new object, numbered by the
// interpreter, and equals only itself.
#[derive(Clone)]
enum V {
    Null,
    Bool(bool),
    Int(i64),
    Float(f64),
    Str(String),
    Arr(Vec[V]),
    Obj(Vec[(String, V)]),
    Expr(i64),
}

// A Python exception: its class name and str().
struct JErr {
    cls: String,
    msg: String,
}

fn jerr(cls: Str, msg: own String) -> JErr {
    JErr { cls: cls.to_string(), msg: msg }
}

fn chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn text(v: ref Vec[char]) -> String {
    v.iter().collect()
}

fn char_count(s: ref String) -> i64 {
    s.chars().count()
}

// type(v).__name__
fn type_name(v: ref V) -> String {
    let n = match v {
        V.Null => "NoneType",
        V.Bool(_) => "bool",
        V.Int(_) => "int",
        V.Float(_) => "float",
        V.Str(_) => "str",
        V.Arr(_) => "list",
        V.Obj(_) => "dict",
        V.Expr(_) => "_Expression",
    };
    n.to_string()
}

// The JMESPath name of a Python type name, as TYPES_MAP has it.
fn jmes_type(py: ref String) -> String {
    let n = if py == "bool" {
        "boolean"
    } else if py == "list" {
        "array"
    } else if py == "dict" {
        "object"
    } else if py == "NoneType" {
        "null"
    } else if py == "str" {
        "string"
    } else if py == "float" or py == "int" {
        "number"
    } else if py == "_Expression" {
        "expref"
    } else {
        "unknown"
    };
    n.to_string()
}

fn obj_get(m: ref Vec[(String, V)], key: ref String) -> Option[V] {
    for (k, v) in m.iter() {
        if k == key {
            return Some(v.clone());
        }
    }
    None
}

// d[key] = value: a new key goes last, an old one keeps its place.
fn obj_set(m: mut ref Vec[(String, V)], key: ref String, value: own V) {
    let mut i = 0;
    while i < m.len() {
        if m[i].0 == key {
            m[i].1 = value;
            return;
        }
        i += 1;
    }
    m.push((key.clone(), value));
}

// ------------------------------------------------------------ JSON in

fn push_utf8(out: mut ref Vec[u8], c: u32) {
    if c < 0x80 {
        out.push(c as u8);
    } else if c < 0x800 {
        out.push((0xC0 | (c >> 6)) as u8);
        out.push((0x80 | (c & 0x3F)) as u8);
    } else if c < 0x10000 {
        out.push((0xE0 | (c >> 12)) as u8);
        out.push((0x80 | ((c >> 6) & 0x3F)) as u8);
        out.push((0x80 | (c & 0x3F)) as u8);
    } else {
        out.push((0xF0 | (c >> 18)) as u8);
        out.push((0x80 | ((c >> 12) & 0x3F)) as u8);
        out.push((0x80 | ((c >> 6) & 0x3F)) as u8);
        out.push((0x80 | (c & 0x3F)) as u8);
    }
}

fn hex_digit(c: u8) -> i64 {
    if c >= b'0' and c <= b'9' {
        (c - b'0') as i64
    } else if c >= b'a' and c <= b'f' {
        (c - b'a') as i64 + 10
    } else if c >= b'A' and c <= b'F' {
        (c - b'A') as i64 + 10
    } else {
        -1
    }
}

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

// json.loads as Python's decoder runs it, strict: NaN and Infinity are
// accepted, a raw control character in a string is not, and an error
// carries the decoder's message (without its position).
struct JsonReader {
    b: Vec[u8],
    at: i64,
}

impl JsonReader {
    fn ws(mut ref self) {
        while self.at < self.b.len() {
            let c = self.b[self.at];
            if c == b' ' or c == b'\n' or c == b'\r' or c == b'\t' {
                self.at += 1;
            } else {
                break;
            }
        }
    }

    fn peek(ref self) -> i64 {
        if self.at < self.b.len() { self.b[self.at] as i64 } else { -1 }
    }

    fn eat(mut ref self, word: Str) -> bool {
        let w = word.bytes();
        if self.at + w.len() > self.b.len() {
            return false;
        }
        for k in 0..w.len() {
            if self.b[self.at + k] != w[k] {
                return false;
            }
        }
        self.at += w.len();
        true
    }

    fn document(mut ref self) -> Result[V, String] {
        self.ws();
        let v = self.value()?;
        self.ws();
        if self.at != self.b.len() {
            return Err("Extra data".to_string());
        }
        Ok(v)
    }

    fn value(mut ref self) -> Result[V, String] {
        let c = self.peek();
        if c == b'"' as i64 {
            self.at += 1;
            return Ok(V.Str(self.string()?));
        }
        if c == b'{' as i64 {
            self.at += 1;
            let mut m: Vec[(String, V)] = Vec.new();
            self.ws();
            if self.eat("}") {
                return Ok(V.Obj(m));
            }
            loop {
                if self.peek() != b'"' as i64 {
                    return Err("Expecting property name enclosed in double quotes".to_string());
                }
                self.at += 1;
                let k = self.string()?;
                self.ws();
                if not self.eat(":") {
                    return Err("Expecting ':' delimiter".to_string());
                }
                self.ws();
                let v = self.value()?;
                obj_set(mut m, k, v);
                self.ws();
                if self.eat("}") {
                    return Ok(V.Obj(m));
                }
                if not self.eat(",") {
                    return Err("Expecting ',' delimiter".to_string());
                }
                self.ws();
                if self.peek() == b'}' as i64 {
                    return Err("Illegal trailing comma before end of object".to_string());
                }
            }
        }
        if c == b'[' as i64 {
            self.at += 1;
            let mut items: Vec[V] = Vec.new();
            self.ws();
            if self.eat("]") {
                return Ok(V.Arr(items));
            }
            loop {
                items.push(self.value()?);
                self.ws();
                if self.eat("]") {
                    return Ok(V.Arr(items));
                }
                if not self.eat(",") {
                    return Err("Expecting ',' delimiter".to_string());
                }
                self.ws();
                if self.peek() == b']' as i64 {
                    return Err("Illegal trailing comma before end of array".to_string());
                }
            }
        }
        if self.eat("true") {
            return Ok(V.Bool(true));
        }
        if self.eat("false") {
            return Ok(V.Bool(false));
        }
        if self.eat("null") {
            return Ok(V.Null);
        }
        if self.eat("NaN") {
            return Ok(V.Float(0.0 / 0.0));
        }
        if self.eat("Infinity") {
            return Ok(V.Float(1.0 / 0.0));
        }
        if self.eat("-Infinity") {
            return Ok(V.Float(-1.0 / 0.0));
        }
        self.number()
    }

    fn hex4(mut ref self) -> i64 {
        if self.at + 4 > self.b.len() {
            return -1;
        }
        let mut v = 0;
        for k in 0..4 {
            let d = hex_digit(self.b[self.at + k]);
            if d < 0 {
                return -1;
            }
            v = v * 16 + d;
        }
        self.at += 4;
        v
    }

    // The body of a string whose opening quote has been read.
    fn string(mut ref self) -> Result[String, String] {
        let mut out: Vec[u8] = Vec.new();
        loop {
            if self.at >= self.b.len() {
                return Err("Unterminated string starting at".to_string());
            }
            let c = self.b[self.at];
            self.at += 1;
            if c == b'"' {
                break;
            }
            if c < 0x20 {
                return Err("Invalid control character at".to_string());
            }
            if c != b'\\' {
                out.push(c);
                continue;
            }
            if self.at >= self.b.len() {
                return Err("Unterminated string starting at".to_string());
            }
            let e = self.b[self.at];
            self.at += 1;
            if e == b'n' {
                out.push(10);
            } else if e == b't' {
                out.push(9);
            } else if e == b'r' {
                out.push(13);
            } else if e == b'b' {
                out.push(8);
            } else if e == b'f' {
                out.push(12);
            } else if e == b'"' or e == b'\\' or e == b'/' {
                out.push(e);
            } else if e == b'u' {
                let mut cp = self.hex4();
                if cp < 0 {
                    return Err("Invalid \\uXXXX escape".to_string());
                }
                if cp >= 0xD800 and cp < 0xDC00 and self.at + 1 < self.b.len() and self.b[self.at] == b'\\' and self.b[self.at + 1] == b'u' {
                    let save = self.at;
                    self.at += 2;
                    let lo = self.hex4();
                    if lo < 0 {
                        return Err("Invalid \\uXXXX escape".to_string());
                    }
                    if lo >= 0xDC00 and lo < 0xE000 {
                        cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
                    } else {
                        self.at = save;
                    }
                }
                push_utf8(mut out, cp as u32);
            } else {
                return Err("Invalid \\escape".to_string());
            }
        }
        Ok(String.from_utf8(out).unwrap_or("?".to_string()))
    }

    // -?(0|[1-9]\d*)(\.\d+)?([eE][-+]?\d+)?
    fn number(mut ref self) -> Result[V, String] {
        let start = self.at;
        let n = self.b.len();
        let mut i = self.at;
        if i < n and self.b[i] == b'-' {
            i += 1;
        }
        if i < n and self.b[i] == b'0' {
            i += 1;
        } else if i < n and self.b[i] >= b'1' and self.b[i] <= b'9' {
            while i < n and is_digit(self.b[i]) {
                i += 1;
            }
        } else {
            return Err("Expecting value".to_string());
        }
        let mut float = false;
        if i + 1 < n and self.b[i] == b'.' and is_digit(self.b[i + 1]) {
            i += 1;
            while i < n and is_digit(self.b[i]) {
                i += 1;
            }
            float = true;
        }
        if i < n and (self.b[i] == b'e' or self.b[i] == b'E') {
            let mut j = i + 1;
            if j < n and (self.b[j] == b'+' or self.b[j] == b'-') {
                j += 1;
            }
            if j < n and is_digit(self.b[j]) {
                while j < n and is_digit(self.b[j]) {
                    j += 1;
                }
                i = j;
                float = true;
            }
        }
        self.at = i;
        let t = String.from_utf8(self.b[start..i].to_vec()).unwrap_or(String.new());
        if float {
            return Ok(V.Float(f64.parse(t).unwrap_or(0.0)));
        }
        Ok(V.Int(i64.parse(t).unwrap_or(0)))
    }
}

fn loads(t: ref String) -> Result[V, String] {
    let mut r = JsonReader { b: t.bytes().to_vec(), at: 0 };
    r.document()
}

// ------------------------------------------------------------ JSON out

fn hex_digits(v: i64, n: i64) -> String {
    let mut s = f"{v:x}";
    while s.len() < n {
        s = f"0{s}";
    }
    s
}

fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    if x == 1.0 / 0.0 {
        return "inf".to_string();
    }
    if x == -1.0 / 0.0 {
        return "-inf".to_string();
    }
    f"{x}"
}

fn json_str(s: ref String, ascii: bool, out: mut ref String) {
    out.push('"');
    for c in s.chars() {
        let o = c as i64;
        if c == '"' {
            out.push_str("\\\"");
        } else if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if o == 8 {
            out.push_str("\\b");
        } else if o == 12 {
            out.push_str("\\f");
        } else if o < 0x20 {
            out.push_str(f"\\u{hex_digits(o, 4)}");
        } else if not ascii or o < 0x7F {
            out.push(c);
        } else if o < 0x10000 {
            out.push_str(f"\\u{hex_digits(o, 4)}");
        } else {
            let n = o - 0x10000;
            out.push_str(f"\\u{hex_digits(0xD800 | (n >> 10), 4)}\\u{hex_digits(0xDC00 | (n & 0x3FF), 4)}");
        }
    }
    out.push('"');
}

// The options of one json.dumps call. indent < 0 is indent=None; item and
// key are the separators.
struct Dump {
    indent: i64,
    ascii: bool,
    item: String,
    key: String,
}

fn newline_indent(indent: i64, level: i64, out: mut ref String) {
    out.push('\n');
    for _ in 0..indent * level {
        out.push(' ');
    }
}

fn dump_into(v: ref V, o: ref Dump, level: i64, out: mut ref String) -> Result[(), JErr] {
    match v {
        V.Null => out.push_str("null"),
        V.Bool(b) => out.push_str(if b { "true" } else { "false" }),
        V.Int(d) => out.push_str(f"{d}"),
        V.Float(x) => {
            if x != x {
                out.push_str("NaN");
            } else if x == 1.0 / 0.0 {
                out.push_str("Infinity");
            } else if x == -1.0 / 0.0 {
                out.push_str("-Infinity");
            } else {
                out.push_str(float_repr(x));
            }
        }
        V.Str(s) => json_str(s, o.ascii, mut out),
        V.Arr(items) => {
            if items.is_empty() {
                out.push_str("[]");
                return Ok(());
            }
            out.push('[');
            let mut i = 0;
            while i < items.len() {
                if i > 0 {
                    out.push_str(o.item);
                }
                if o.indent >= 0 {
                    newline_indent(o.indent, level + 1, mut out);
                }
                dump_into(items[i], o, level + 1, mut out)?;
                i += 1;
            }
            if o.indent >= 0 {
                newline_indent(o.indent, level, mut out);
            }
            out.push(']');
        }
        V.Obj(m) => {
            if m.is_empty() {
                out.push_str("{}");
                return Ok(());
            }
            out.push('{');
            let mut i = 0;
            while i < m.len() {
                if i > 0 {
                    out.push_str(o.item);
                }
                if o.indent >= 0 {
                    newline_indent(o.indent, level + 1, mut out);
                }
                json_str(m[i].0, o.ascii, mut out);
                out.push_str(o.key);
                dump_into(m[i].1, o, level + 1, mut out)?;
                i += 1;
            }
            if o.indent >= 0 {
                newline_indent(o.indent, level, mut out);
            }
            out.push('}');
        }
        V.Expr(_) => return Err(jerr("TypeError", "Object of type _Expression is not JSON serializable".to_string())),
    }
    Ok(())
}

// json.dumps(v, ensure_ascii=False)
fn dumps_line(v: ref V) -> Result[String, JErr] {
    let o = Dump { indent: -1, ascii: false, item: ", ".to_string(), key: ": ".to_string() };
    let mut out = String.new();
    dump_into(v, o, 0, mut out)?;
    Ok(out)
}

// json.dumps(v, indent=4, ensure_ascii=False), as jp.py prints a result.
fn dumps_jp(v: ref V) -> Result[String, JErr] {
    let o = Dump { indent: 4, ascii: false, item: ",".to_string(), key: ": ".to_string() };
    let mut out = String.new();
    dump_into(v, o, 0, mut out)?;
    Ok(out)
}

// json.dumps(v, separators=(',', ':'), default=str), as to_string() makes it.
fn dumps_compact(v: ref V) -> Result[String, JErr] {
    let o = Dump { indent: -1, ascii: true, item: ",".to_string(), key: ":".to_string() };
    let mut out = String.new();
    dump_into(v, o, 0, mut out)?;
    Ok(out)
}

fn quote(s: ref String) -> String {
    let mut out = String.new();
    json_str(s, false, mut out);
    out
}

// ------------------------------------------------------------ repr

fn printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

// repr(str)
fn repr_str(s: ref String) -> String {
    let single = s.contains("'");
    let double = s.contains("\"");
    let q = if single and not double { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        let o = c as i64;
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if printable(o) {
            out.push(c);
        } else if o < 0x100 {
            out.push_str(f"\\x{hex_digits(o, 2)}");
        } else if o < 0x10000 {
            out.push_str(f"\\u{hex_digits(o, 4)}");
        } else {
            out.push_str(f"\\U{hex_digits(o, 8)}");
        }
    }
    out.push(q);
    out
}

fn repr_into(v: ref V, out: mut ref String) {
    match v {
        V.Null => out.push_str("None"),
        V.Bool(b) => out.push_str(if b { "True" } else { "False" }),
        V.Int(d) => out.push_str(f"{d}"),
        V.Float(x) => out.push_str(float_repr(x)),
        V.Str(s) => out.push_str(repr_str(s)),
        V.Arr(items) => {
            out.push('[');
            let mut i = 0;
            while i < items.len() {
                if i > 0 {
                    out.push_str(", ");
                }
                repr_into(items[i], mut out);
                i += 1;
            }
            out.push(']');
        }
        V.Obj(m) => {
            out.push('{');
            let mut i = 0;
            while i < m.len() {
                if i > 0 {
                    out.push_str(", ");
                }
                out.push_str(repr_str(m[i].0));
                out.push_str(": ");
                repr_into(m[i].1, mut out);
                i += 1;
            }
            out.push('}');
        }
        V.Expr(_) => out.push_str("<jmespath.visitor._Expression object>"),
    }
}

fn repr(v: ref V) -> String {
    let mut out = String.new();
    repr_into(v, mut out);
    out
}

// str(): a string is its own text, anything else its repr.
fn py_str(v: ref V) -> String {
    match v {
        V.Str(s) => s.clone(),
        _ => repr(v),
    }
}

fn repr_list(v: ref Vec[String]) -> String {
    let mut out = String.new();
    out.push('[');
    let mut i = 0;
    while i < v.len() {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(repr_str(v[i]));
        i += 1;
    }
    out.push(']');
    out
}

// ------------------------------------------------------------ equality and order

// The value of a number for ==, with bool counting as 0 or 1.
fn num_of(v: ref V) -> Option[f64] {
    match v {
        V.Bool(b) => Some(if b { 1.0 } else { 0.0 }),
        V.Int(d) => Some(d as f64),
        V.Float(x) => Some(x),
        _ => None,
    }
}

// Python's ==: 1 == 1.0 == True, and dicts ignore order.
fn py_eq(a: ref V, b: ref V) -> bool {
    match (a, b) {
        (V.Int(x), V.Int(y)) => return x == y,
        (V.Null, V.Null) => return true,
        (V.Str(x), V.Str(y)) => return x == y,
        (V.Expr(x), V.Expr(y)) => return x == y,
        (V.Arr(x), V.Arr(y)) => {
            if x.len() != y.len() {
                return false;
            }
            let mut i = 0;
            while i < x.len() {
                if not py_eq(x[i], y[i]) {
                    return false;
                }
                i += 1;
            }
            return true;
        }
        (V.Obj(x), V.Obj(y)) => {
            if x.len() != y.len() {
                return false;
            }
            for (k, v) in x.iter() {
                match obj_get(y, k) {
                    Some(w) => {
                        if not py_eq(v, w) {
                            return false;
                        }
                    }
                    None => return false,
                }
            }
            return true;
        }
        _ => {}
    }
    match (num_of(a), num_of(b)) {
        (Some(x), Some(y)) => x == y,
        _ => false,
    }
}

// An int or a float, but not a bool.
fn is_number(v: ref V) -> bool {
    match v {
        V.Int(_) => true,
        V.Float(_) => true,
        _ => false,
    }
}

fn is_str(v: ref V) -> bool {
    match v {
        V.Str(_) => true,
        _ => false,
    }
}

fn str_cmp(a: ref String, b: ref String) -> i64 {
    let x = a.bytes().to_vec();
    let y = b.bytes().to_vec();
    let mut i = 0;
    while i < x.len() and i < y.len() {
        if x[i] != y[i] {
            return if x[i] < y[i] { -1 } else { 1 };
        }
        i += 1;
    }
    if x.len() < y.len() {
        -1
    } else if x.len() > y.len() {
        1
    } else {
        0
    }
}

// The comparison `a <op> b` between two numbers or two strings, as -1, 0
// or 1; a number against a string is Python's TypeError.
fn py_cmp(a: ref V, b: ref V, op: Str) -> Result[i64, JErr] {
    match (a, b) {
        (V.Str(x), V.Str(y)) => return Ok(str_cmp(x, y)),
        (V.Int(x), V.Int(y)) => return Ok(if x < y { -1 } else if x > y { 1 } else { 0 }),
        _ => {}
    }
    match (num_of(a), num_of(b)) {
        (Some(x), Some(y)) => {
            if is_number(a) and is_number(b) {
                return Ok(if x < y { -1 } else if x > y { 1 } else { 0 });
            }
        }
        _ => {}
    }
    Err(jerr("TypeError", f"'{op}' not supported between instances of '{type_name(a)}' and '{type_name(b)}'"))
}

// ------------------------------------------------------------ lexer

// A token: its type as the parser names it, its value (an identifier's
// name, a number, a literal's parsed JSON), and where it starts.
#[derive(Clone)]
struct Tok {
    ty: String,
    value: V,
    start: i64,
}

// A ParseError or one of its subclasses before the parser fills in the
// expression: the class, the column, the offending token's value and
// type, and the reason.
struct PErr {
    cls: String,
    pos: i64,
    tval: String,
    ttype: String,
    msg: String,
}

fn lex_err(pos: i64, value: own String, msg: own String) -> PErr {
    PErr { cls: "LexerError".to_string(), pos: pos, tval: value, ttype: String.new(), msg: msg }
}

fn tok(ty: Str, value: own V, start: i64) -> Tok {
    Tok { ty: ty.to_string(), value: value, start: start }
}

fn is_ascii_letter(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')
}

fn is_ascii_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn ident_start(c: Option[char]) -> bool {
    match c {
        Some(x) => is_ascii_letter(x) or x == '_',
        None => false,
    }
}

fn ident_char(c: Option[char]) -> bool {
    match c {
        Some(x) => is_ascii_letter(x) or is_ascii_digit(x) or x == '_',
        None => false,
    }
}

fn digit_char(c: Option[char]) -> bool {
    match c {
        Some(x) => is_ascii_digit(x),
        None => false,
    }
}

// str.isspace()
fn py_space(c: char) -> bool {
    let o = c as i64;
    (o >= 9 and o <= 13) or (o >= 0x1C and o <= 0x20) or o == 0x85 or o == 0xA0 or o == 0x1680
        or (o >= 0x2000 and o <= 0x200A) or o == 0x2028 or o == 0x2029 or o == 0x202F or o == 0x205F or o == 0x3000
}

fn lstrip(s: ref String) -> String {
    let cs = chars(s);
    let mut i = 0;
    while i < cs.len() and py_space(cs[i]) {
        i += 1;
    }
    text(cs[i..cs.len()].to_vec())
}

fn replace_all(s: ref String, from: Str, to: Str) -> String {
    let parts: Vec[Str] = s.split(from).collect();
    let mut out = String.new();
    let mut i = 0;
    while i < parts.len() {
        if i > 0 {
            out.push_str(to);
        }
        out.push_str(parts[i]);
        i += 1;
    }
    out
}

struct Lexer {
    cs: Vec[char],
    pos: i64,
    cur: Option[char],
    len: i64,
}

impl Lexer {
    fn step(mut ref self) {
        if self.pos == self.len - 1 {
            self.cur = None;
        } else {
            self.pos += 1;
            self.cur = Some(self.cs[self.pos]);
        }
    }

    // _next(): step and return the new current character.
    fn next(mut ref self) -> Option[char] {
        self.step();
        self.cur
    }

    fn rest(ref self, start: i64) -> String {
        text(self.cs[start..self.len].to_vec())
    }

    fn consume_number(mut ref self) -> String {
        let mut buff = String.new();
        if let Some(c) = self.cur {
            buff.push(c);
        }
        while digit_char(self.next()) {
            if let Some(c) = self.cur {
                buff.push(c);
            }
        }
        buff
    }

    // Everything up to the next unescaped delimiter; a backslash and the
    // character after it are kept as they are.
    fn consume_until(mut ref self, delim: char) -> Result[String, PErr] {
        let start = self.pos;
        let mut buff = String.new();
        self.step();
        while self.cur != Some(delim) {
            if self.cur == Some('\\') {
                buff.push('\\');
                self.step();
            }
            match self.cur {
                None => return Err(lex_err(start, self.rest(start), f"Unclosed {delim} delimiter")),
                Some(c) => buff.push(c),
            }
            self.step();
        }
        self.step();
        Ok(buff)
    }

    fn literal(mut ref self) -> Result[Tok, PErr] {
        let start = self.pos;
        let lexeme = replace_all(self.consume_until('`')?, "\\`", "`");
        let value = match loads(lexeme) {
            Ok(v) => v,
            Err(_) => match loads(f"\"{lstrip(lexeme)}\"") {
                Ok(v) => v,
                Err(_) => return Err(lex_err(start, self.rest(start), f"Bad token {lexeme}")),
            },
        };
        Ok(tok("literal", value, start))
    }

    fn quoted_identifier(mut ref self) -> Result[Tok, PErr] {
        let start = self.pos;
        let lexeme = f"\"{self.consume_until('"')?}\"";
        match loads(lexeme) {
            Ok(v) => Ok(tok("quoted_identifier", v, start)),
            Err(e) => Err(lex_err(start, lexeme, e)),
        }
    }

    fn raw_string(mut ref self) -> Result[Tok, PErr] {
        let start = self.pos;
        let lexeme = replace_all(self.consume_until('\'')?, "\\'", "'");
        Ok(tok("literal", V.Str(lexeme), start))
    }

    fn match_or_else(mut ref self, expected: char, match_type: Str, else_type: Str) -> Tok {
        let start = self.pos;
        let current = self.cur.unwrap_or(' ');
        let next = self.next();
        if next == Some(expected) {
            self.step();
            return tok(match_type, V.Str(f"{current}{expected}"), start);
        }
        tok(else_type, V.Str(f"{current}"), start)
    }

    fn tokenize(mut ref self) -> Result[Vec[Tok], PErr] {
        let mut out: Vec[Tok] = Vec.new();
        while self.cur.is_some() {
            let c = self.cur.unwrap_or(' ');
            let simple = if c == '.' {
                "dot"
            } else if c == '*' {
                "star"
            } else if c == ']' {
                "rbracket"
            } else if c == ',' {
                "comma"
            } else if c == ':' {
                "colon"
            } else if c == '@' {
                "current"
            } else if c == '(' {
                "lparen"
            } else if c == ')' {
                "rparen"
            } else if c == '{' {
                "lbrace"
            } else if c == '}' {
                "rbrace"
            } else {
                ""
            };
            if simple != "" {
                out.push(tok(simple, V.Str(f"{c}"), self.pos));
                self.step();
            } else if ident_start(self.cur) {
                let start = self.pos;
                let mut buff = String.new();
                buff.push(c);
                while ident_char(self.next()) {
                    buff.push(self.cur.unwrap_or(' '));
                }
                out.push(tok("unquoted_identifier", V.Str(buff), start));
            } else if c == ' ' or c == '\t' or c == '\n' or c == '\r' {
                self.step();
            } else if c == '[' {
                let start = self.pos;
                let next = self.next();
                if next == Some(']') {
                    self.step();
                    out.push(tok("flatten", V.Str("[]".to_string()), start));
                } else if next == Some('?') {
                    self.step();
                    out.push(tok("filter", V.Str("[?".to_string()), start));
                } else {
                    out.push(tok("lbracket", V.Str("[".to_string()), start));
                }
            } else if c == '\'' {
                out.push(self.raw_string()?);
            } else if c == '|' {
                out.push(self.match_or_else('|', "or", "pipe"));
            } else if c == '&' {
                out.push(self.match_or_else('&', "and", "expref"));
            } else if c == '`' {
                out.push(self.literal()?);
            } else if is_ascii_digit(c) {
                let start = self.pos;
                let buff = self.consume_number();
                out.push(tok("number", V.Int(i64.parse(buff).unwrap_or(0)), start));
            } else if c == '-' {
                let start = self.pos;
                let buff = self.consume_number();
                if char_count(buff) > 1 {
                    out.push(tok("number", V.Int(i64.parse(buff).unwrap_or(0)), start));
                } else {
                    let msg = f"Unknown token '{buff}'";
                    return Err(lex_err(start, buff, msg));
                }
            } else if c == '"' {
                out.push(self.quoted_identifier()?);
            } else if c == '<' {
                out.push(self.match_or_else('=', "lte", "lt"));
            } else if c == '>' {
                out.push(self.match_or_else('=', "gte", "gt"));
            } else if c == '!' {
                out.push(self.match_or_else('=', "ne", "not"));
            } else if c == '=' {
                if self.next() == Some('=') {
                    out.push(tok("eq", V.Str("==".to_string()), self.pos - 1));
                    self.step();
                } else {
                    let position = if self.cur.is_none() { self.pos } else { self.pos - 1 };
                    return Err(lex_err(position, "=".to_string(), "Unknown token '='".to_string()));
                }
            } else {
                return Err(lex_err(self.pos, f"{c}", f"Unknown token {c}"));
            }
        }
        out.push(tok("eof", V.Str(String.new()), self.len));
        Ok(out)
    }
}

// Lexer().tokenize(expression), all of it, as the parser takes it.
fn tokenize(expression: ref String) -> Result[Vec[Tok], PErr] {
    let cs = chars(expression);
    if cs.is_empty() {
        return Err(PErr { cls: "EmptyExpressionError".to_string(), pos: 0, tval: String.new(), ttype: String.new(),
                          msg: "Invalid JMESPath expression: cannot be empty.".to_string() });
    }
    let first = cs[0];
    let n = cs.len();
    let mut lx = Lexer { cs: cs, pos: 0, cur: Some(first), len: n };
    lx.tokenize()
}

// ------------------------------------------------------------ AST

// The nodes jmespath/ast.py builds. Slice parts that were left out are
// None; Cmp carries the comparator's name (eq, ne, lt, lte, gt, gte);
// Filter's children are the left side, the right side and the condition.
#[derive(Clone)]
enum Node {
    Field(String),
    Identity,
    Current,
    Literal(V),
    Index(i64),
    Slice(Option[i64], Option[i64], Option[i64]),
    Sub(Vec[Node]),
    IndexExpr(Vec[Node]),
    Pipe(Vec[Node]),
    Cmp(String, Vec[Node]),
    Or(Vec[Node]),
    And(Vec[Node]),
    Not(Vec[Node]),
    Flatten(Vec[Node]),
    Proj(Vec[Node]),
    ValueProj(Vec[Node]),
    Filter(Vec[Node]),
    MultiList(Vec[Node]),
    MultiDict(Vec[(String, Node)]),
    Call(String, Vec[Node]),
    Expref(Vec[Node]),
}

fn is_slice(n: ref Node) -> bool {
    match n {
        Node.Slice(_, _, _) => true,
        _ => false,
    }
}

// ------------------------------------------------------------ parser

fn binding_power(ty: ref String) -> i64 {
    if ty == "pipe" {
        1
    } else if ty == "or" {
        2
    } else if ty == "and" {
        3
    } else if ty == "eq" or ty == "gt" or ty == "lt" or ty == "gte" or ty == "lte" or ty == "ne" {
        5
    } else if ty == "flatten" {
        9
    } else if ty == "star" {
        20
    } else if ty == "filter" {
        21
    } else if ty == "dot" {
        40
    } else if ty == "not" {
        45
    } else if ty == "lbrace" {
        50
    } else if ty == "lbracket" {
        55
    } else if ty == "lparen" {
        60
    } else {
        0
    }
}

fn has_led(ty: ref String) -> bool {
    ty == "dot" or ty == "pipe" or ty == "or" or ty == "and" or ty == "lparen" or ty == "filter" or ty == "eq"
        or ty == "ne" or ty == "gt" or ty == "gte" or ty == "lt" or ty == "lte" or ty == "flatten" or ty == "lbracket"
}

// Below this a token stops a projection.
fn projection_stop() -> i64 {
    10
}

fn parse_err(t: ref Tok, reason: own String) -> PErr {
    PErr { cls: "ParseError".to_string(), pos: t.start, tval: py_str(t.value), ttype: t.ty.clone(), msg: reason }
}

fn incomplete() -> PErr {
    PErr { cls: "IncompleteExpressionError".to_string(), pos: 0, tval: String.new(), ttype: String.new(), msg: String.new() }
}

// _raise_parse_error_maybe_eof: an incomplete expression at eof,
// otherwise "Expecting: ..., got: ...".
fn expect_err(expected: own String, t: ref Tok) -> PErr {
    if t.ty == "eof" {
        return incomplete();
    }
    parse_err(t, f"Expecting: {expected}, got: {t.ty}")
}

struct Pratt {
    toks: Vec[Tok],
    idx: i64,
}

impl Pratt {
    // self._tokens[self._index + n], negative indexes counting from the end.
    fn tok_at(ref self, n: i64) -> Result[Tok, PErr] {
        let mut i = self.idx + n;
        if i < 0 {
            i += self.toks.len();
        }
        if i < 0 or i >= self.toks.len() {
            return Err(PErr { cls: "IndexError".to_string(), pos: 0, tval: String.new(), ttype: String.new(),
                              msg: "list index out of range".to_string() });
        }
        Ok(self.toks[i].clone())
    }

    fn current(ref self) -> String {
        self.toks[self.idx].ty.clone()
    }

    fn lookahead(ref self, n: i64) -> Result[String, PErr] {
        Ok(self.tok_at(n)?.ty)
    }

    fn advance(mut ref self) {
        self.idx += 1;
    }

    fn match_tok(mut ref self, ty: Str) -> Result[(), PErr] {
        if self.current() == ty {
            self.advance();
            return Ok(());
        }
        Err(expect_err(ty.to_string(), self.tok_at(0)?))
    }

    fn expression(mut ref self, bp: i64) -> Result[Node, PErr] {
        let left_token = self.tok_at(0)?;
        self.advance();
        let mut left = self.nud(left_token)?;
        let mut cur = self.current();
        while bp < binding_power(cur) {
            if not has_led(cur) {
                return Err(parse_err(self.tok_at(0)?, "invalid token".to_string()));
            }
            self.advance();
            left = self.led(cur, left)?;
            cur = self.current();
        }
        Ok(left)
    }

    fn nud(mut ref self, t: own Tok) -> Result[Node, PErr] {
        let ty = t.ty.clone();
        if ty == "literal" {
            return Ok(Node.Literal(t.value));
        }
        if ty == "unquoted_identifier" {
            return Ok(Node.Field(py_str(t.value)));
        }
        if ty == "quoted_identifier" {
            if self.current() == "lparen" {
                let n = self.tok_at(0)?;
                let mut e = parse_err(n, "Quoted identifier not allowed for function names.".to_string());
                e.pos = 0;
                return Err(e);
            }
            return Ok(Node.Field(py_str(t.value)));
        }
        if ty == "star" {
            let right = if self.current() == "rbracket" {
                Node.Identity
            } else {
                self.projection_rhs(binding_power("star".to_string()))?
            };
            return Ok(Node.ValueProj(vec![Node.Identity, right]));
        }
        if ty == "filter" {
            return self.led_filter(Node.Identity);
        }
        if ty == "lbrace" {
            return self.multi_select_hash();
        }
        if ty == "lparen" {
            let e = self.expression(0)?;
            self.match_tok("rparen")?;
            return Ok(e);
        }
        if ty == "flatten" {
            let right = self.projection_rhs(binding_power("flatten".to_string()))?;
            return Ok(Node.Proj(vec![Node.Flatten(vec![Node.Identity]), right]));
        }
        if ty == "not" {
            let e = self.expression(binding_power("not".to_string()))?;
            return Ok(Node.Not(vec![e]));
        }
        if ty == "lbracket" {
            let cur = self.current();
            if cur == "number" or cur == "colon" {
                let right = self.index_expression()?;
                return self.project_if_slice(Node.Identity, right);
            }
            if cur == "star" and self.lookahead(1)? == "rbracket" {
                self.advance();
                self.advance();
                let right = self.projection_rhs(binding_power("star".to_string()))?;
                return Ok(Node.Proj(vec![Node.Identity, right]));
            }
            return self.multi_select_list();
        }
        if ty == "current" {
            return Ok(Node.Current);
        }
        if ty == "expref" {
            let e = self.expression(binding_power("expref".to_string()))?;
            return Ok(Node.Expref(vec![e]));
        }
        if ty == "eof" {
            return Err(incomplete());
        }
        Err(parse_err(t, "invalid token".to_string()))
    }

    fn led(mut ref self, ty: ref String, left: own Node) -> Result[Node, PErr] {
        if ty == "dot" {
            if self.current() != "star" {
                let right = self.dot_rhs(binding_power("dot".to_string()))?;
                return match left {
                    Node.Sub(ch) => {
                        let mut c = ch;
                        c.push(right);
                        Ok(Node.Sub(c))
                    }
                    other => Ok(Node.Sub(vec![other, right])),
                };
            }
            self.advance();
            let right = self.projection_rhs(binding_power("dot".to_string()))?;
            return Ok(Node.ValueProj(vec![left, right]));
        }
        if ty == "pipe" {
            let right = self.expression(binding_power("pipe".to_string()))?;
            return Ok(Node.Pipe(vec![left, right]));
        }
        if ty == "or" {
            let right = self.expression(binding_power("or".to_string()))?;
            return Ok(Node.Or(vec![left, right]));
        }
        if ty == "and" {
            let right = self.expression(binding_power("and".to_string()))?;
            return Ok(Node.And(vec![left, right]));
        }
        if ty == "lparen" {
            let name = match left {
                Node.Field(n) => n,
                _ => {
                    let prev = self.tok_at(-2)?;
                    let msg = f"Invalid function name '{py_str(prev.value)}'";
                    return Err(parse_err(prev, msg));
                }
            };
            let mut args: Vec[Node] = Vec.new();
            while self.current() != "rparen" {
                let e = self.expression(0)?;
                if self.current() == "comma" {
                    self.match_tok("comma")?;
                }
                args.push(e);
            }
            self.match_tok("rparen")?;
            return Ok(Node.Call(name, args));
        }
        if ty == "filter" {
            return self.led_filter(left);
        }
        if ty == "flatten" {
            let right = self.projection_rhs(binding_power("flatten".to_string()))?;
            return Ok(Node.Proj(vec![Node.Flatten(vec![left]), right]));
        }
        if ty == "lbracket" {
            let t = self.tok_at(0)?;
            if t.ty == "number" or t.ty == "colon" {
                let right = self.index_expression()?;
                return match left {
                    Node.IndexExpr(ch) => {
                        let mut c = ch;
                        c.push(right);
                        Ok(Node.IndexExpr(c))
                    }
                    other => self.project_if_slice(other, right),
                };
            }
            self.match_tok("star")?;
            self.match_tok("rbracket")?;
            let right = self.projection_rhs(binding_power("star".to_string()))?;
            return Ok(Node.Proj(vec![left, right]));
        }
        // eq, ne, gt, gte, lt, lte
        let right = self.expression(binding_power(ty))?;
        Ok(Node.Cmp(ty.clone(), vec![left, right]))
    }

    fn led_filter(mut ref self, left: own Node) -> Result[Node, PErr] {
        let condition = self.expression(0)?;
        self.match_tok("rbracket")?;
        let right = if self.current() == "flatten" {
            Node.Identity
        } else {
            self.projection_rhs(binding_power("filter".to_string()))?
        };
        Ok(Node.Filter(vec![left, right, condition]))
    }

    fn index_expression(mut ref self) -> Result[Node, PErr] {
        if self.lookahead(0)? == "colon" or self.lookahead(1)? == "colon" {
            return self.slice_expression();
        }
        let t = self.tok_at(0)?;
        let i = match t.value {
            V.Int(n) => n,
            _ => 0,
        };
        self.advance();
        self.match_tok("rbracket")?;
        Ok(Node.Index(i))
    }

    fn slice_expression(mut ref self) -> Result[Node, PErr] {
        let mut parts: Vec[Option[i64]] = vec![None, None, None];
        let mut index = 0;
        let mut cur = self.current();
        while cur != "rbracket" and index < 3 {
            if cur == "colon" {
                index += 1;
                if index == 3 {
                    return Err(parse_err(self.tok_at(0)?, "syntax error".to_string()));
                }
                self.advance();
            } else if cur == "number" {
                let t = self.tok_at(0)?;
                if let V.Int(n) = t.value {
                    parts[index] = Some(n);
                }
                self.advance();
            } else {
                return Err(parse_err(self.tok_at(0)?, "syntax error".to_string()));
            }
            cur = self.current();
        }
        self.match_tok("rbracket")?;
        Ok(Node.Slice(parts[0], parts[1], parts[2]))
    }

    fn project_if_slice(mut ref self, left: own Node, right: own Node) -> Result[Node, PErr] {
        let slice = is_slice(right);
        let index_expr = Node.IndexExpr(vec![left, right]);
        if slice {
            let rhs = self.projection_rhs(binding_power("star".to_string()))?;
            return Ok(Node.Proj(vec![index_expr, rhs]));
        }
        Ok(index_expr)
    }

    fn multi_select_list(mut ref self) -> Result[Node, PErr] {
        let mut exprs: Vec[Node] = Vec.new();
        loop {
            exprs.push(self.expression(0)?);
            if self.current() == "rbracket" {
                break;
            }
            self.match_tok("comma")?;
        }
        self.match_tok("rbracket")?;
        Ok(Node.MultiList(exprs))
    }

    fn multi_select_hash(mut ref self) -> Result[Node, PErr] {
        let mut pairs: Vec[(String, Node)] = Vec.new();
        loop {
            let key_token = self.tok_at(0)?;
            let cur = self.current();
            if cur != "quoted_identifier" and cur != "unquoted_identifier" {
                return Err(expect_err("['quoted_identifier', 'unquoted_identifier']".to_string(), key_token));
            }
            self.advance();
            let key = py_str(key_token.value);
            self.match_tok("colon")?;
            let value = self.expression(0)?;
            pairs.push((key, value));
            if self.current() == "comma" {
                self.match_tok("comma")?;
            } else if self.current() == "rbrace" {
                self.match_tok("rbrace")?;
                break;
            }
        }
        Ok(Node.MultiDict(pairs))
    }

    fn projection_rhs(mut ref self, bp: i64) -> Result[Node, PErr] {
        let cur = self.current();
        if binding_power(cur) < projection_stop() {
            return Ok(Node.Identity);
        }
        if cur == "lbracket" or cur == "filter" {
            return self.expression(bp);
        }
        if cur == "dot" {
            self.match_tok("dot")?;
            return self.dot_rhs(bp);
        }
        Err(parse_err(self.tok_at(0)?, "syntax error".to_string()))
    }

    fn dot_rhs(mut ref self, bp: i64) -> Result[Node, PErr] {
        let cur = self.current();
        if cur == "quoted_identifier" or cur == "unquoted_identifier" or cur == "star" {
            return self.expression(bp);
        }
        if cur == "lbracket" {
            self.match_tok("lbracket")?;
            return self.multi_select_list();
        }
        if cur == "lbrace" {
            self.match_tok("lbrace")?;
            return self.multi_select_hash();
        }
        let t = self.tok_at(0)?;
        let msg = f"Expecting: ['quoted_identifier', 'unquoted_identifier', 'lbracket', 'lbrace'], got: {t.ty}";
        Err(parse_err(t, msg))
    }
}

// The str() of a parse error once the parser has filled in the expression.
fn parse_message(e: ref PErr, expression: ref String) -> String {
    if e.cls == "LexerError" {
        let mut under = String.new();
        for _ in 0..e.pos {
            under.push(' ');
        }
        return f"Bad jmespath expression: {e.msg}:\n{expression}\n{under}^";
    }
    if e.cls == "IncompleteExpressionError" {
        let mut under = String.new();
        for _ in 0..char_count(expression) + 1 {
            under.push(' ');
        }
        return f"Invalid jmespath expression: Incomplete expression:\n\"{expression}\"\n{under}^";
    }
    if e.cls == "ParseError" {
        let mut under = String.new();
        for _ in 0..e.pos + 1 {
            under.push(' ');
        }
        return f"{e.msg}: Parse error at column {e.pos}, token \"{e.tval}\" ({e.ttype.to_uppercase()}), for expression:\n\"{expression}\"\n{under}^";
    }
    e.msg.clone()
}

// jmespath.compile(expression)
fn compile(expression: ref String) -> Result[Node, JErr] {
    let toks = match tokenize(expression) {
        Ok(t) => t,
        Err(e) => return Err(JErr { cls: e.cls.clone(), msg: parse_message(e, expression) }),
    };
    let mut p = Pratt { toks: toks, idx: 0 };
    let parsed = match p.expression(0) {
        Ok(n) => n,
        Err(e) => return Err(JErr { cls: e.cls.clone(), msg: parse_message(e, expression) }),
    };
    if p.current() != "eof" {
        let t = p.toks[p.idx].clone();
        let msg = f"Unexpected token: {py_str(t.value)}";
        let e = parse_err(t, msg);
        return Err(JErr { cls: e.cls.clone(), msg: parse_message(e, expression) });
    }
    Ok(parsed)
}

// ------------------------------------------------------------ interpreter

// _is_false: '', [], {}, None and False are false; 0 is true.
fn is_false(v: ref V) -> bool {
    match v {
        V.Null => true,
        V.Bool(b) => not b,
        V.Str(s) => s.is_empty(),
        V.Arr(a) => a.is_empty(),
        V.Obj(m) => m.is_empty(),
        _ => false,
    }
}

// Python's truth value.
fn truthy(v: ref V) -> bool {
    match v {
        V.Null => false,
        V.Bool(b) => b,
        V.Int(n) => n != 0,
        V.Float(x) => x != 0.0,
        V.Str(s) => not s.is_empty(),
        V.Arr(a) => not a.is_empty(),
        V.Obj(m) => not m.is_empty(),
        V.Expr(_) => true,
    }
}

fn is_bool(v: ref V) -> bool {
    match v {
        V.Bool(_) => true,
        _ => false,
    }
}

fn zero_or_one(v: ref V) -> bool {
    match num_of(v) {
        Some(x) => is_number(v) and (x == 0.0 or x == 1.0),
        None => false,
    }
}

// _equals: 0 and 1 are not equal to False and True at the top level, but
// Python's == decides everything else.
fn jmes_equals(x: ref V, y: ref V) -> bool {
    if zero_or_one(x) {
        if is_bool(y) {
            return false;
        }
    } else if zero_or_one(y) {
        if is_bool(x) {
            return false;
        }
    }
    py_eq(x, y)
}

// value[start:stop:step] for a list.
fn py_slice(items: ref Vec[V], start: Option[i64], stop: Option[i64], step: Option[i64]) -> Result[V, JErr] {
    let st = step.unwrap_or(1);
    if st == 0 {
        return Err(jerr("ValueError", "slice step cannot be zero".to_string()));
    }
    let n = items.len();
    let lo = if st < 0 { -1 } else { 0 };
    let hi = if st < 0 { n - 1 } else { n };
    let a = match start {
        None => if st < 0 { n - 1 } else { 0 },
        Some(s) => {
            if s < 0 {
                if s + n < 0 { lo } else { s + n }
            } else if s >= n {
                hi
            } else {
                s
            }
        }
    };
    let b = match stop {
        None => if st < 0 { -1 } else { n },
        Some(s) => {
            if s < 0 {
                if s + n < 0 { lo } else { s + n }
            } else if s >= n {
                hi
            } else {
                s
            }
        }
    };
    let mut out: Vec[V] = Vec.new();
    let mut i = a;
    if st > 0 {
        while i < b {
            out.push(items[i].clone());
            i += st;
        }
    } else {
        while i > b {
            out.push(items[i].clone());
            i += st;
        }
    }
    Ok(V.Arr(out))
}

fn cmp_symbol(op: ref String) -> Str {
    if op == "lt" {
        "<"
    } else if op == "gt" {
        ">"
    } else if op == "lte" {
        "<="
    } else {
        ">="
    }
}

struct Interp {
    exprs: Vec[Node],
}

impl Interp {
    fn visit(mut ref self, node: ref Node, value: ref V) -> Result[V, JErr] {
        match node {
            Node.Field(name) => {
                if let V.Obj(m) = value {
                    return Ok(obj_get(m, name).unwrap_or(V.Null));
                }
                Ok(V.Null)
            }
            Node.Identity => Ok(value.clone()),
            Node.Current => Ok(value.clone()),
            Node.Literal(v) => Ok(v.clone()),
            Node.Index(i) => {
                if let V.Arr(items) = value {
                    let n = items.len();
                    let k = if i < 0 { i + n } else { i };
                    if k >= 0 and k < n {
                        return Ok(items[k].clone());
                    }
                }
                Ok(V.Null)
            }
            Node.Slice(a, b, c) => {
                if let V.Arr(items) = value {
                    return py_slice(items, a, b, c);
                }
                Ok(V.Null)
            }
            Node.Sub(ch) => self.chain(ch, value),
            Node.IndexExpr(ch) => self.chain(ch, value),
            Node.Pipe(ch) => self.chain(ch, value),
            Node.Cmp(op, ch) => {
                let left = self.visit(ch[0], value)?;
                let right = self.visit(ch[1], value)?;
                if op == "eq" {
                    return Ok(V.Bool(jmes_equals(left, right)));
                }
                if op == "ne" {
                    return Ok(V.Bool(not jmes_equals(left, right)));
                }
                if not ((is_number(left) or is_str(left)) and (is_number(right) or is_str(right))) {
                    return Ok(V.Null);
                }
                let c = py_cmp(left, right, cmp_symbol(op))?;
                let r = if op == "lt" {
                    c < 0
                } else if op == "gt" {
                    c > 0
                } else if op == "lte" {
                    c <= 0
                } else {
                    c >= 0
                };
                Ok(V.Bool(r))
            }
            Node.Or(ch) => {
                let matched = self.visit(ch[0], value)?;
                if is_false(matched) {
                    return self.visit(ch[1], value);
                }
                Ok(matched)
            }
            Node.And(ch) => {
                let matched = self.visit(ch[0], value)?;
                if is_false(matched) {
                    return Ok(matched);
                }
                self.visit(ch[1], value)
            }
            Node.Not(ch) => {
                let r = self.visit(ch[0], value)?;
                if is_number(r) and not truthy(r) {
                    return Ok(V.Bool(false));
                }
                Ok(V.Bool(not truthy(r)))
            }
            Node.Flatten(ch) => {
                let base = self.visit(ch[0], value)?;
                if let V.Arr(items) = base {
                    let mut merged: Vec[V] = Vec.new();
                    for e in items.into_iter() {
                        match e {
                            V.Arr(inner) => {
                                for x in inner.into_iter() {
                                    merged.push(x);
                                }
                            }
                            other => merged.push(other),
                        }
                    }
                    return Ok(V.Arr(merged));
                }
                Ok(V.Null)
            }
            Node.Proj(ch) => {
                let base = self.visit(ch[0], value)?;
                if let V.Arr(items) = base {
                    return self.project(ch[1], items);
                }
                Ok(V.Null)
            }
            Node.ValueProj(ch) => {
                let base = self.visit(ch[0], value)?;
                if let V.Obj(m) = base {
                    let mut items: Vec[V] = Vec.new();
                    for (_, v) in m.into_iter() {
                        items.push(v);
                    }
                    return self.project(ch[1], items);
                }
                Ok(V.Null)
            }
            Node.Filter(ch) => {
                let base = self.visit(ch[0], value)?;
                if let V.Arr(items) = base {
                    let mut collected: Vec[V] = Vec.new();
                    for e in items.iter() {
                        let cond = self.visit(ch[2], e)?;
                        if not is_false(cond) {
                            let cur = self.visit(ch[1], e)?;
                            if let V.Null = cur {
                                continue;
                            }
                            collected.push(cur);
                        }
                    }
                    return Ok(V.Arr(collected));
                }
                Ok(V.Null)
            }
            Node.MultiList(ch) => {
                if let V.Null = value {
                    return Ok(V.Null);
                }
                let mut out: Vec[V] = Vec.new();
                for c in ch.iter() {
                    out.push(self.visit(c, value)?);
                }
                Ok(V.Arr(out))
            }
            Node.MultiDict(pairs) => {
                if let V.Null = value {
                    return Ok(V.Null);
                }
                let mut m: Vec[(String, V)] = Vec.new();
                for (k, c) in pairs.iter() {
                    let v = self.visit(c, value)?;
                    obj_set(mut m, k, v);
                }
                Ok(V.Obj(m))
            }
            Node.Call(name, ch) => {
                let mut args: Vec[V] = Vec.new();
                for c in ch.iter() {
                    args.push(self.visit(c, value)?);
                }
                self.call(name, args)
            }
            Node.Expref(ch) => {
                self.exprs.push(ch[0].clone());
                Ok(V.Expr(self.exprs.len() - 1))
            }
        }
    }

    fn chain(mut ref self, ch: ref Vec[Node], value: ref V) -> Result[V, JErr] {
        let mut result = value.clone();
        for c in ch.iter() {
            result = self.visit(c, result)?;
        }
        Ok(result)
    }

    // A projection's right side over each element, dropping None.
    fn project(mut ref self, right: ref Node, items: own Vec[V]) -> Result[V, JErr] {
        let mut collected: Vec[V] = Vec.new();
        for e in items.iter() {
            let cur = self.visit(right, e)?;
            if let V.Null = cur {
                continue;
            }
            collected.push(cur);
        }
        Ok(V.Arr(collected))
    }

    // expref.visit(expref.expression, value)
    fn apply(mut ref self, e: ref V, value: ref V) -> Result[V, JErr] {
        let node = match e {
            V.Expr(id) => self.exprs[id].clone(),
            _ => Node.Identity,
        };
        self.visit(node, value)
    }
}

// jmespath.search(expression, data)
fn search(expression: ref String, data: ref V) -> Result[V, JErr] {
    let node = compile(expression)?;
    let mut it = Interp { exprs: Vec.new() };
    it.visit(node, data)
}

// ------------------------------------------------------------ functions

// A function's signature: one entry per argument, each the space-separated
// types it accepts ("" accepts anything), and whether the last one repeats.
struct Sig {
    args: Vec[String],
    variadic: bool,
}

fn sig(name: ref String) -> Option[Sig] {
    let (a, variadic): (Str, bool) = if name == "abs" or name == "ceil" or name == "floor" {
        ("number", false)
    } else if name == "avg" or name == "sum" {
        ("array-number", false)
    } else if name == "not_null" {
        ("", true)
    } else if name == "to_array" or name == "to_string" or name == "to_number" or name == "type" {
        ("", false)
    } else if name == "contains" {
        ("array string;", false)
    } else if name == "length" {
        ("string array object", false)
    } else if name == "ends_with" or name == "starts_with" {
        ("string;string", false)
    } else if name == "reverse" {
        ("array string", false)
    } else if name == "join" {
        ("string;array-string", false)
    } else if name == "map" {
        ("expref;array", false)
    } else if name == "max" or name == "min" {
        ("array-number array-string", false)
    } else if name == "merge" {
        ("object", true)
    } else if name == "sort" {
        ("array-string array-number", false)
    } else if name == "keys" or name == "values" {
        ("object", false)
    } else if name == "sort_by" or name == "min_by" or name == "max_by" {
        ("array;expref", false)
    } else {
        return None;
    };
    let mut args: Vec[String] = Vec.new();
    for p in a.split(";") {
        args.push(p.to_string());
    }
    Some(Sig { args: args, variadic: variadic })
}

// REVERSE_TYPES_MAP
fn py_types(t: ref String) -> Vec[String] {
    let names: Vec[Str] = if t == "boolean" {
        vec!["bool"]
    } else if t == "array" {
        vec!["list", "_Projection"]
    } else if t == "object" {
        vec!["dict", "OrderedDict"]
    } else if t == "null" {
        vec!["NoneType"]
    } else if t == "string" {
        vec!["unicode", "str"]
    } else if t == "number" {
        vec!["float", "int", "long"]
    } else {
        vec!["_Expression"]
    };
    let mut out: Vec[String] = Vec.new();
    for n in names.iter() {
        out.push(n.to_string());
    }
    out
}

fn has(v: ref Vec[String], s: ref String) -> bool {
    for x in v.iter() {
        if x == s {
            return true;
        }
    }
    false
}

fn type_error(fname: ref String, value: ref V, actual: ref String, types: ref Vec[String]) -> JErr {
    jerr("JMESPathTypeError", f"In function {fname}(), invalid type for value: {py_str(value)}, expected one of: {repr_list(types)}, received: \"{actual}\"")
}

fn arity_error(cls: Str, expected: i64, actual: i64, name: ref String) -> JErr {
    let word = if expected == 1 { "argument" } else { "arguments" };
    let least = if cls == "VariadictArityError" { "at least " } else { "" };
    jerr(cls, f"Expected {least}{expected} {word} for function {name}(), received {actual}")
}

fn type_check_single(current: ref V, spec: ref String, fname: ref String) -> Result[(), JErr] {
    let mut types: Vec[String] = Vec.new();
    for t in spec.split(" ") {
        types.push(t.to_string());
    }
    let mut allowed: Vec[String] = Vec.new();
    let mut subtypes: Vec[Vec[String]] = Vec.new();
    for t in types.iter() {
        let parts: Vec[Str] = t.split("-").collect();
        if parts.len() == 2 {
            subtypes.push(py_types(parts[1].to_string()));
        }
        for p in py_types(parts[0].to_string()).into_iter() {
            allowed.push(p);
        }
    }
    let actual = type_name(current);
    if not has(allowed, actual) {
        return Err(type_error(fname, current, jmes_type(actual), types));
    }
    if subtypes.is_empty() {
        return Ok(());
    }
    let items = match current {
        V.Arr(a) => a.clone(),
        _ => Vec.new(),
    };
    if subtypes.len() == 1 {
        for e in items.iter() {
            let t = type_name(e);
            if not has(subtypes[0], t) {
                return Err(type_error(fname, e, t, types));
            }
        }
        return Ok(());
    }
    if items.is_empty() {
        return Ok(());
    }
    let first = type_name(items[0]);
    let mut pick: i64 = -1;
    let mut k = 0;
    while k < subtypes.len() {
        if has(subtypes[k], first) {
            pick = k;
            break;
        }
        k += 1;
    }
    if pick < 0 {
        return Err(type_error(fname, items[0], first, types));
    }
    for e in items.iter() {
        let t = type_name(e);
        if not has(subtypes[pick], t) {
            return Err(type_error(fname, e, t, types));
        }
    }
    Ok(())
}

// sum() as CPython adds: ints exactly until the first float, then floats
// with Neumaier's compensation, ints met after that added as doubles.
fn py_sum(items: ref Vec[V]) -> V {
    let mut i_result: i64 = 0;
    let mut k = 0;
    while k < items.len() {
        match items[k] {
            V.Int(b) => i_result += b,
            _ => break,
        }
        k += 1;
    }
    if k == items.len() {
        return V.Int(i_result);
    }
    let mut f = match items[k] {
        V.Float(x) => (i_result as f64) + x,
        _ => i_result as f64,
    };
    let mut c = 0.0;
    k += 1;
    while k < items.len() {
        match items[k] {
            V.Float(x) => {
                let t = f + x;
                if f.abs() >= x.abs() {
                    c += (f - t) + x;
                } else {
                    c += (x - t) + f;
                }
                f = t;
            }
            V.Int(v) => f += v as f64,
            _ => {}
        }
        k += 1;
    }
    if c != 0.0 and c - c == 0.0 {
        f += c;
    }
    V.Float(f)
}

fn digits_ok(s: ref Vec[char], lo: i64, hi: i64) -> bool {
    // ASCII digits with single underscores between them.
    if lo >= hi {
        return false;
    }
    let mut i = lo;
    while i < hi {
        let c = s[i];
        if c == '_' {
            if i == lo or i + 1 == hi or not is_ascii_digit(s[i - 1]) or not is_ascii_digit(s[i + 1]) {
                return false;
            }
        } else if not is_ascii_digit(c) {
            return false;
        }
        i += 1;
    }
    true
}

fn strip_py(s: ref String) -> Vec[char] {
    let cs = chars(s);
    let mut a = 0;
    let mut b = cs.len();
    while a < b and py_space(cs[a]) {
        a += 1;
    }
    while b > a and py_space(cs[b - 1]) {
        b -= 1;
    }
    cs[a..b].to_vec()
}

fn no_underscores(cs: ref Vec[char]) -> String {
    let mut out = String.new();
    for c in cs.iter() {
        if c != '_' {
            out.push(c);
        }
    }
    out
}

// int(s) for a str
fn py_int(s: ref String) -> Option[i64] {
    let cs = strip_py(s);
    let mut i = 0;
    if i < cs.len() and (cs[i] == '+' or cs[i] == '-') {
        i += 1;
    }
    if not digits_ok(cs, i, cs.len()) {
        return None;
    }
    i64.parse(no_underscores(cs)).ok()
}

// float(s) for a str
fn py_float(s: ref String) -> Option[f64] {
    let cs = strip_py(s);
    let mut i = 0;
    let mut neg = false;
    if i < cs.len() and (cs[i] == '+' or cs[i] == '-') {
        neg = cs[i] == '-';
        i += 1;
    }
    let word = text(cs[i..cs.len()].to_vec()).to_lowercase();
    if word == "inf" or word == "infinity" {
        return Some(if neg { -1.0 / 0.0 } else { 1.0 / 0.0 });
    }
    if word == "nan" {
        return Some(0.0 / 0.0);
    }
    let n = cs.len();
    let mut j = i;
    while j < n and (is_ascii_digit(cs[j]) or cs[j] == '_') {
        j += 1;
    }
    let int_end = j;
    let mut frac_lo = j;
    let mut frac_hi = j;
    if j < n and cs[j] == '.' {
        j += 1;
        frac_lo = j;
        while j < n and (is_ascii_digit(cs[j]) or cs[j] == '_') {
            j += 1;
        }
        frac_hi = j;
    }
    let has_int = int_end > i;
    let has_frac = frac_hi > frac_lo;
    if not has_int and not has_frac {
        return None;
    }
    if has_int and not digits_ok(cs, i, int_end) {
        return None;
    }
    if has_frac and not digits_ok(cs, frac_lo, frac_hi) {
        return None;
    }
    if j < n and (cs[j] == 'e' or cs[j] == 'E') {
        j += 1;
        if j < n and (cs[j] == '+' or cs[j] == '-') {
            j += 1;
        }
        let e_lo = j;
        while j < n and (is_ascii_digit(cs[j]) or cs[j] == '_') {
            j += 1;
        }
        if not digits_ok(cs, e_lo, j) {
            return None;
        }
    }
    if j != n {
        return None;
    }
    f64.parse(no_underscores(cs)).ok()
}

// Stable merge sort of indexes by their keys.
fn sort_indexes(keys: ref Vec[V]) -> Result[Vec[i64], JErr] {
    let mut idx: Vec[i64] = Vec.new();
    for k in 0..keys.len() {
        idx.push(k);
    }
    let mut width = 1;
    let n = idx.len();
    while width < n {
        let mut out: Vec[i64] = Vec.new();
        let mut lo = 0;
        while lo < n {
            let mid = if lo + width < n { lo + width } else { n };
            let hi = if lo + 2 * width < n { lo + 2 * width } else { n };
            let mut a = lo;
            let mut b = mid;
            while a < mid and b < hi {
                if py_cmp(keys[idx[b]], keys[idx[a]], "<")? < 0 {
                    out.push(idx[b]);
                    b += 1;
                } else {
                    out.push(idx[a]);
                    a += 1;
                }
            }
            while a < mid {
                out.push(idx[a]);
                a += 1;
            }
            while b < hi {
                out.push(idx[b]);
                b += 1;
            }
            lo = hi;
        }
        idx = out;
        width *= 2;
    }
    Ok(idx)
}

fn arg_items(v: ref V) -> Vec[V] {
    match v {
        V.Arr(a) => a.clone(),
        _ => Vec.new(),
    }
}

fn arg_str(v: ref V) -> String {
    match v {
        V.Str(s) => s.clone(),
        _ => String.new(),
    }
}

impl Interp {
    fn call(mut ref self, name: ref String, args: own Vec[V]) -> Result[V, JErr] {
        let spec = match sig(name) {
            Some(s) => s,
            None => return Err(jerr("UnknownFunctionError", f"Unknown function: {name}()")),
        };
        if spec.variadic {
            if args.len() < spec.args.len() {
                return Err(arity_error("VariadictArityError", spec.args.len(), args.len(), name));
            }
        } else if args.len() != spec.args.len() {
            return Err(arity_error("ArityError", spec.args.len(), args.len(), name));
        }
        let mut i = 0;
        while i < spec.args.len() {
            if not spec.args[i].is_empty() {
                type_check_single(args[i], spec.args[i], name)?;
            }
            i += 1;
        }
        self.run_function(name, args)
    }

    fn run_function(mut ref self, name: ref String, args: own Vec[V]) -> Result[V, JErr] {
        if name == "abs" {
            return match args[0] {
                V.Int(n) => Ok(V.Int(if n < 0 { -n } else { n })),
                V.Float(x) => Ok(V.Float(x.abs())),
                _ => Ok(V.Null),
            };
        }
        if name == "avg" {
            let items = arg_items(args[0]);
            if items.is_empty() {
                return Ok(V.Null);
            }
            let total = match py_sum(items) {
                V.Int(n) => n as f64,
                V.Float(x) => x,
                _ => 0.0,
            };
            return Ok(V.Float(total / (items.len() as f64)));
        }
        if name == "not_null" {
            for a in args.iter() {
                if let V.Null = a {
                    continue;
                }
                return Ok(a.clone());
            }
            return Ok(V.Null);
        }
        if name == "to_array" {
            return match args[0] {
                V.Arr(_) => Ok(args[0].clone()),
                _ => Ok(V.Arr(vec![args[0].clone()])),
            };
        }
        if name == "to_string" {
            return match args[0] {
                V.Str(_) => Ok(args[0].clone()),
                _ => Ok(V.Str(dumps_compact(args[0])?)),
            };
        }
        if name == "to_number" {
            return match args[0] {
                V.Int(_) => Ok(args[0].clone()),
                V.Float(_) => Ok(args[0].clone()),
                V.Str(s) => {
                    if let Some(n) = py_int(s) {
                        return Ok(V.Int(n));
                    }
                    if let Some(x) = py_float(s) {
                        return Ok(V.Float(x));
                    }
                    Ok(V.Null)
                }
                _ => Ok(V.Null),
            };
        }
        if name == "contains" {
            return match args[0] {
                V.Arr(items) => {
                    for e in items.iter() {
                        if py_eq(args[1], e) {
                            return Ok(V.Bool(true));
                        }
                    }
                    Ok(V.Bool(false))
                }
                V.Str(s) => match args[1] {
                    V.Str(t) => Ok(V.Bool(s.contains(t.as_str()))),
                    _ => Err(jerr("TypeError", f"'in <string>' requires string as left operand, not {type_name(args[1])}")),
                },
                _ => Ok(V.Null),
            };
        }
        if name == "length" {
            return match args[0] {
                V.Str(s) => Ok(V.Int(char_count(s))),
                V.Arr(a) => Ok(V.Int(a.len())),
                V.Obj(m) => Ok(V.Int(m.len())),
                _ => Ok(V.Null),
            };
        }
        if name == "ends_with" {
            return Ok(V.Bool(arg_str(args[0]).ends_with(arg_str(args[1]).as_str())));
        }
        if name == "starts_with" {
            return Ok(V.Bool(arg_str(args[0]).starts_with(arg_str(args[1]).as_str())));
        }
        if name == "reverse" {
            return match args[0] {
                V.Str(s) => {
                    let mut cs = chars(s);
                    cs.reverse();
                    Ok(V.Str(text(cs)))
                }
                _ => {
                    let mut items = arg_items(args[0]);
                    items.reverse();
                    Ok(V.Arr(items))
                }
            };
        }
        if name == "ceil" or name == "floor" {
            return match args[0] {
                V.Float(x) => {
                    if x != x {
                        return Err(jerr("ValueError", "cannot convert float NaN to integer".to_string()));
                    }
                    if x - x != 0.0 {
                        return Err(jerr("OverflowError", "cannot convert float infinity to integer".to_string()));
                    }
                    let r = if name == "ceil" { x.ceil() } else { x.floor() };
                    Ok(V.Int(r as i64))
                }
                _ => Ok(args[0].clone()),
            };
        }
        if name == "join" {
            let sep = arg_str(args[0]);
            let mut out = String.new();
            let mut first = true;
            for e in arg_items(args[1]).iter() {
                if not first {
                    out.push_str(sep);
                }
                first = false;
                out.push_str(arg_str(e));
            }
            return Ok(V.Str(out));
        }
        if name == "map" {
            let mut out: Vec[V] = Vec.new();
            for e in arg_items(args[1]).iter() {
                out.push(self.apply(args[0], e)?);
            }
            return Ok(V.Arr(out));
        }
        if name == "max" or name == "min" {
            let items = arg_items(args[0]);
            if items.is_empty() {
                return Ok(V.Null);
            }
            let mut best = items[0].clone();
            let mut k = 1;
            while k < items.len() {
                let c = py_cmp(items[k], best, if name == "max" { ">" } else { "<" })?;
                if (name == "max" and c > 0) or (name == "min" and c < 0) {
                    best = items[k].clone();
                }
                k += 1;
            }
            return Ok(best);
        }
        if name == "merge" {
            let mut merged: Vec[(String, V)] = Vec.new();
            for a in args.into_iter() {
                match a {
                    V.Obj(m) => {
                        for (k, v) in m.into_iter() {
                            obj_set(mut merged, k, v);
                        }
                    }
                    other => return Err(jerr("TypeError", f"'{type_name(other)}' object is not iterable")),
                }
            }
            return Ok(V.Obj(merged));
        }
        if name == "sort" {
            let items = arg_items(args[0]);
            let order = sort_indexes(items)?;
            let mut out: Vec[V] = Vec.new();
            for k in order.iter() {
                out.push(items[k].clone());
            }
            return Ok(V.Arr(out));
        }
        if name == "sum" {
            return Ok(py_sum(arg_items(args[0])));
        }
        if name == "keys" or name == "values" {
            let mut out: Vec[V] = Vec.new();
            if let V.Obj(m) = args[0] {
                for (k, v) in m.iter() {
                    if name == "keys" {
                        out.push(V.Str(k.clone()));
                    } else {
                        out.push(v.clone());
                    }
                }
            }
            return Ok(V.Arr(out));
        }
        if name == "type" {
            let t = match args[0] {
                V.Str(_) => "string",
                V.Bool(_) => "boolean",
                V.Arr(_) => "array",
                V.Obj(_) => "object",
                V.Int(_) => "number",
                V.Float(_) => "number",
                V.Null => "null",
                V.Expr(_) => return Ok(V.Null),
            };
            return Ok(V.Str(t.to_string()));
        }
        if name == "sort_by" {
            let items = arg_items(args[0]);
            if items.is_empty() {
                return Ok(args[0].clone());
            }
            let required = jmes_type(type_name(self.apply(args[1], items[0])?));
            if required != "number" and required != "string" {
                return Err(type_error("sort_by".to_string(), items[0], required, vec!["string".to_string(), "number".to_string()]));
            }
            let mut keys: Vec[V] = Vec.new();
            for e in items.iter() {
                keys.push(self.key_of(args[1], e, vec![required.clone()], "sort_by")?);
            }
            let order = sort_indexes(keys)?;
            let mut out: Vec[V] = Vec.new();
            for k in order.iter() {
                out.push(items[k].clone());
            }
            return Ok(V.Arr(out));
        }
        // min_by, max_by
        let items = arg_items(args[0]);
        let allowed = vec!["number".to_string(), "string".to_string()];
        if items.is_empty() {
            return Ok(V.Null);
        }
        let is_max = name == "max_by";
        let fname = if is_max { "max_by" } else { "min_by" };
        let mut best = items[0].clone();
        let mut best_key = self.key_of(args[1], items[0], allowed.clone(), fname)?;
        let mut k = 1;
        while k < items.len() {
            let key = self.key_of(args[1], items[k], allowed.clone(), fname)?;
            let c = py_cmp(key, best_key, if is_max { ">" } else { "<" })?;
            if (is_max and c > 0) or (not is_max and c < 0) {
                best = items[k].clone();
                best_key = key;
            }
            k += 1;
        }
        Ok(best)
    }

    // The key function sort_by, min_by and max_by build: the expref's
    // value, which must have one of the allowed types.
    fn key_of(mut ref self, e: ref V, x: ref V, allowed: own Vec[String], fname: Str) -> Result[V, JErr] {
        let result = self.apply(e, x)?;
        let t = jmes_type(type_name(result));
        if not has(allowed, t) {
            return Err(type_error(fname.to_string(), result, t, allowed));
        }
        Ok(result)
    }
}

// ------------------------------------------------------------ jobs

fn err_text(e: ref JErr) -> String {
    f"{e.cls}: {e.msg}"
}

fn say(out: mut ref Vec[String], line: own String) {
    out.push(line);
}

fn read_file(name: ref String) -> Result[String, String] {
    match fs.read_to_string(f"data/{name}") {
        Ok(t) => Ok(t),
        Err(e) => Err(f"cannot read {name}: {e}"),
    }
}

fn load(name: ref String) -> Result[V, String] {
    match loads(read_file(name)?) {
        Ok(v) => Ok(v),
        Err(e) => Err(f"{name}: {e}"),
    }
}

fn field(v: ref V, key: Str) -> V {
    match v {
        V.Obj(m) => obj_get(m, key.to_string()).unwrap_or(V.Null),
        _ => V.Null,
    }
}

fn has_field(v: ref V, key: Str) -> bool {
    match v {
        V.Obj(m) => obj_get(m, key.to_string()).is_some(),
        _ => false,
    }
}

// The compliance suite's name for an exception class.
fn error_kind(cls: ref String) -> String {
    let k = if cls == "ParseError" or cls == "LexerError" or cls == "IncompleteExpressionError" or cls == "EmptyExpressionError" {
        "syntax"
    } else if cls == "ArityError" or cls == "VariadictArityError" {
        "invalid-arity"
    } else if cls == "JMESPathTypeError" {
        "invalid-type"
    } else if cls == "UnknownFunctionError" {
        "unknown-function"
    } else if cls == "ValueError" {
        "invalid-value"
    } else {
        ""
    };
    k.to_string()
}

// The search and the line that prints its result, as one try block.
fn search_line(expression: ref String, data: ref V) -> Result[String, JErr] {
    let r = search(expression, data)?;
    dumps_line(r)
}

fn suite(path: ref String, out: mut ref Vec[String]) -> Result[(), String] {
    let groups = arg_items(load(path)?);
    let mut total = 0;
    for g in groups.iter() {
        total += arg_items(field(g, "cases")).len();
    }
    say(mut out, f"== suite {path} ({total} cases)");
    let mut passed = 0;
    let mut gi = 0;
    while gi < groups.len() {
        let given = field(groups[gi], "given");
        let cases = arg_items(field(groups[gi], "cases"));
        let mut ci = 0;
        while ci < cases.len() {
            let c = cases[ci].clone();
            let expression = arg_str(field(c, "expression"));
            say(mut out, f"[{gi}.{ci}] {quote(expression)}");
            let expects_error = has_field(c, "error");
            let ok = match search(expression, given) {
                Ok(r) => match dumps_line(r) {
                    Ok(line) => {
                        say(mut out, f"  result: {line}");
                        not expects_error and py_eq(r, field(c, "result"))
                    }
                    Err(e) => {
                        say(mut out, f"  error: {err_text(e)}");
                        expects_error and error_kind(e.cls) == arg_str(field(c, "error"))
                    }
                },
                Err(e) => {
                    say(mut out, f"  error: {err_text(e)}");
                    expects_error and error_kind(e.cls) == arg_str(field(c, "error"))
                }
            };
            if ok {
                passed += 1;
            } else if expects_error {
                let kind = arg_str(field(c, "error"));
                say(mut out, f"  suite expects: error {kind}");
            } else {
                match dumps_line(field(c, "result")) {
                    Ok(line) => say(mut out, f"  suite expects: {line}"),
                    Err(e) => say(mut out, f"  suite expects: {err_text(e)}"),
                }
            }
            ci += 1;
        }
        gi += 1;
    }
    say(mut out, f"passed {passed} of {total}");
    Ok(())
}

// jp.py -f <path> <expression>
fn job_jp(path: ref String, expression: ref String, out: mut ref Vec[String]) -> Result[(), String] {
    say(mut out, f"== jp -f {path} {quote(expression)}");
    let data = load(path)?;
    let result = match search(expression, data) {
        Ok(r) => dumps_jp(r),
        Err(e) => Err(e),
    };
    match result {
        Ok(t) => {
            say(mut out, t);
            return Ok(());
        }
        Err(e) => {
            let c = e.cls.clone();
            let kind = if c == "ArityError" or c == "VariadictArityError" {
                "invalid-arity"
            } else if c == "JMESPathTypeError" {
                "invalid-type"
            } else if c == "UnknownFunctionError" {
                "unknown-function"
            } else if c == "ParseError" or c == "LexerError" or c == "IncompleteExpressionError" {
                "syntax-error"
            } else {
                ""
            };
            if kind == "" {
                say(mut out, f"stderr: uncaught {err_text(e)}");
            } else {
                say(mut out, f"stderr: {kind}: {e.msg}");
            }
        }
    }
    say(mut out, "exit 1".to_string());
    Ok(())
}

fn job_fuzz(path: ref String, exprs: ref String, out: mut ref Vec[String]) -> Result[(), String] {
    let data = load(path)?;
    let mut lines: Vec[String] = Vec.new();
    for l in read_file(exprs)?.lines() {
        if l.trim().is_empty() {
            continue;
        }
        match loads(l.to_string()) {
            Ok(V.Str(s)) => lines.push(s),
            _ => return Err(f"{exprs}: bad line"),
        }
    }
    say(mut out, f"== fuzz {path} {exprs} ({lines.len()} expressions)");
    let mut tally: Vec[(String, i64)] = Vec.new();
    let mut i = 0;
    while i < lines.len() {
        say(mut out, f"[{i}] {quote(lines[i])}");
        let k = match search_line(lines[i], data) {
            Ok(line) => {
                say(mut out, f"  -> {line}");
                "value".to_string()
            }
            Err(e) => {
                say(mut out, f"  !! {err_text(e)}");
                e.cls.clone()
            }
        };
        let mut found = false;
        let mut j = 0;
        while j < tally.len() {
            if tally[j].0 == k {
                tally[j].1 += 1;
                found = true;
            }
            j += 1;
        }
        if not found {
            tally.push((k, 1));
        }
        i += 1;
    }
    // sorted(tally)
    let mut a = 1;
    while a < tally.len() {
        let mut b = a;
        while b > 0 and str_cmp(tally[b].0, tally[b - 1].0) < 0 {
            let t = tally[b].clone();
            tally[b] = tally[b - 1].clone();
            tally[b - 1] = t;
            b -= 1;
        }
        a += 1;
    }
    let mut parts: Vec[String] = Vec.new();
    for (k, n) in tally.iter() {
        parts.push(f"{k} {n}");
    }
    let joined = parts.join(", ");
    say(mut out, f"outcomes: {joined}");
    Ok(())
}

fn run() -> Result[(), String] {
    let mut out: Vec[String] = Vec.new();
    for l in read_file("jobs.jsonl".to_string())?.lines() {
        if l.trim().is_empty() {
            continue;
        }
        let job: Vec[String] = match loads(l.to_string()) {
            Ok(V.Arr(items)) => items.iter().map(|x| arg_str(x)).collect(),
            _ => return Err(f"bad job line: {l}"),
        };
        if job[0] == "suite" {
            suite(job[1], mut out)?;
        } else if job[0] == "jp" {
            job_jp(job[1], job[2], mut out)?;
        } else if job[0] == "fuzz" {
            job_fuzz(job[1], job[2], mut out)?;
        }
    }
    let mut text = out.join("\n");
    text.push('\n');
    print(text);
    Ok(())
}

// ------------------------------------------------------------ data

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn hex_val(c: u8) -> u8 {
    if c >= b'a' { c - b'a' + 10 } else { c - b'0' }
}

fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    if let Err(e) = run() {
        eprintln(e);
    }
}
// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    data_part_3(mut v);
    data_part_4(mut v);
    data_part_5(mut v);
    data_part_6(mut v);
    data_part_7(mut v);
    data_part_8(mut v);
    data_part_9(mut v);
    data_part_10(mut v);
    data_part_11(mut v);
    data_part_12(mut v);
    data_part_13(mut v);
    data_part_14(mut v);
    data_part_15(mut v);
    data_part_16(mut v);
    data_part_17(mut v);
    data_part_18(mut v);
    data_part_19(mut v);
    data_part_20(mut v);
    data_part_21(mut v);
    data_part_22(mut v);
    v
}

