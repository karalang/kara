    t.push_str("            {\n");
    t.push_str("                \"expression\": \"@.foo[0]\",\n");
    t.push_str("                \"result\": {\"name\": \"a\"}\n");
    t.push_str("            }\n");
    t.push_str("        ]\n");
    t.push_str("    }\n");
    t.push_str("]\n");
    v.push(DataFile { path: "suite/current.json".to_string(), hex: false, body: t });
    let mut t = String.new();
