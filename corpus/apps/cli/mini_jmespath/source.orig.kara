}

fn data_part_22(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("[{\n");
    t.push_str("    \"given\": {\n");
    t.push_str("        \"foo\": {\n");
    t.push_str("            \"bar\": {\n");
    t.push_str("                \"baz\": \"val\"\n");
    t.push_str("            },\n");
    t.push_str("            \"other\": {\n");
    t.push_str("                \"baz\": \"val\"\n");
    t.push_str("            },\n");
    t.push_str("            \"other2\": {\n");
    t.push_str("                \"baz\": \"val\"\n");
    t.push_str("            },\n");
    t.push_str("            \"other3\": {\n");
    t.push_str("                \"notbaz\": [\"a\", \"b\", \"c\"]\n");
    t.push_str("            },\n");
    t.push_str("            \"other4\": {\n");
    t.push_str("                \"notbaz\": [\"a\", \"b\", \"c\"]\n");
    t.push_str("            },\n");
    t.push_str("            \"other5\": {\n");
    t.push_str("                \"other\": {\n");
    t.push_str("                    \"a\": 1,\n");
    t.push_str("                    \"b\": 1,\n");
    t.push_str("                    \"c\": 1\n");
    t.push_str("                }\n");
    t.push_str("            }\n");
    t.push_str("        }\n");
    t.push_str("    },\n");
    t.push_str("    \"cases\": [\n");
    t.push_str("         {\n");
    t.push_str("            \"expression\": \"foo.*.baz\",\n");
    t.push_str("            \"result\": [\"val\", \"val\", \"val\"]\n");
    t.push_str("         },\n");
    t.push_str("         {\n");
    t.push_str("            \"expression\": \"foo.bar.*\",\n");
    t.push_str("            \"result\": [\"val\"]\n");
    t.push_str("         },\n");
    t.push_str("         {\n");
    t.push_str("            \"expression\": \"foo.*.notbaz\",\n");
    t.push_str("            \"result\": [[\"a\", \"b\", \"c\"], [\"a\", \"b\", \"c\"]]\n");
    t.push_str("         },\n");
    t.push_str("         {\n");
    t.push_str("            \"expression\": \"foo.*.notbaz[0]\",\n");
    t.push_str("            \"result\": [\"a\", \"a\"]\n");
    t.push_str("         },\n");
