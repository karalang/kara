fn data_part_18(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("[{\n");
    t.push_str("  \"given\": {\n");
    t.push_str("    \"foo\": {\n");
    t.push_str("      \"bar\": {\n");
    t.push_str("        \"baz\": \"subkey\"\n");
    t.push_str("      },\n");
    t.push_str("      \"other\": {\n");
    t.push_str("        \"baz\": \"subkey\"\n");
    t.push_str("      },\n");
    t.push_str("      \"other2\": {\n");
    t.push_str("        \"baz\": \"subkey\"\n");
    t.push_str("      },\n");
    t.push_str("      \"other3\": {\n");
