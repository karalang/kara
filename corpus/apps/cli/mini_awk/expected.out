        for (j = i - 1; j >= 1 && vals[keys[j]] < vals[k]; j--) keys[j + 1] = keys[j]
        keys[j + 1] = k
    }
}
{ if (!($1 in hits)) ips[++n] = $1; hits[$1]++ }
