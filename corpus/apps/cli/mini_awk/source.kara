fn jobs_tsv() -> String {
    """
{ print $1 }	access.log
-F:	$3 >= 1000 && $7 !~ /nologin/ { print $1, $6 }	passwd
END { print NR, "requests" }	access.log
{ s += $10 } END { print s, "bytes,", s / NR, "average" }	access.log
$9 >= 500	access.log
-F:	-v	OFS=:	$7 == "/bin/bash" { $7 = "/bin/zsh"; print }	passwd
{ print NR ": " $NF "s " $(NF-2) }	access.log
NR % 3 == 1	passwd
NR == 2, NR == 4 { print FNR, FILENAME, $1 }	passwd
/ERROR/, /^$/	app.log
length($0) > 100 { print NR, length($0) }	access.log
{ print length }	a.txt	b.txt
FNR == 1 { print "--", FILENAME } { print FNR, NR, $0 }	a.txt	b.txt
{ c[$1]++ } END { for (ip in c) n++; print n, "distinct clients" }	access.log
!seen[$9]++ { print $9 }	access.log
-f	report.awk	access.log
{ t[$1] += $NF } END { for (k in t) if (t[k] > 1) print k, t[k] }	access.log
-F\\t	NR == FNR { name[$1] = $2; next } { print $1, ($2 in name ? name[$2] : "unknown(" $2 ")"), $3 }	users.tsv	orders.tsv
-F\\t	-v	OFS=\\t	NR == FNR { role[$1] = $3; next } $2 in role { sum[role[$2]] += $3 } END { print "dev", sum["dev"]; print "admin", sum["admin"]; print "ops", sum["ops"] + 0 }	users.tsv	orders.tsv
BEGIN { a[1,2] = "x"; a["k"] = 1; if ((1,2) in a) print "pair"; for (k in a) if (index(k, SUBSEP)) { split(k, p, SUBSEP); print p[1], p[2] }; delete a[1,2]; print length(a); delete a; print length(a) }
function isort(keys, vals, n,   i, j, k) {\u{0b}    for (i = 2; i <= n; i++) {\u{0b}        k = keys[i]\u{0b}        for (j = i - 1; j >= 1 && vals[keys[j]] < vals[k]; j--) keys[j + 1] = keys[j]\u{0b}        keys[j + 1] = k\u{0b}    }\u{0b}}\u{0b}{ if (!($1 in hits)) ips[++n] = $1; hits[$1]++ }\u{0b}END { isort(ips, hits, n); for (i = 1; i <= n && i <= 3; i++) printf "%-14s %d\\n", ips[i], hits[ips[i]] }	access.log
-F,	NR > 1 { rev[$2] += $4 * $5; if (!($2 in seen)) { seen[$2]; r[++n] = $2 } } END { for (i = 1; i <= n; i++) printf "%-6s %9.2f\\n", r[i], rev[r[i]]; }	sales.csv
-F,	NR > 1 && $3 == "" { print "line " NR ": no product" }	sales.csv
-F,	NR > 1 { printf "%s %-9s %5.1f%%\\n", $1, $3, 100 * $4 / 169 }	sales.csv
NR > 1 && $3 > 10 { printf "%-8s %5d %5.1f%% ", $1, $2, $3; for (i = 11; i <= NF; i++) printf "%s%s", $i, (i < NF ? " " : "\\n") }	ps.txt
NR > 1 { mem[$1] += $6 } END { print "postgres", mem["postgres"] " KiB"; print "www-data", mem["www-data"] / 1024 " MiB" }	ps.txt
NR > 1 { sub(/%/, "", $5); if ($5 + 0 >= 90) print "ALERT", $6, $5 "%", int($4 / 1024) " MiB free" }	df.txt
NR > 1 { u += $3; t += $2 } END { printf "%.1f%% of %.2f GiB used\\n", 100 * u / t, t / 1048576 }	df.txt
BEGIN { RS = ""; FS = "\\n" } { printf "%s <%s> %d lines\\n", $1, $2, NF }	contacts.txt
BEGIN { RS = ";" } { split($0, kv, "="); printf "%-8s %s\\n", kv[1], kv[2] }	env.conf
-F[:,]	NR <= 4 { print NF, $5, $6 }	passwd
{ n = split($4, t, /[\\/:\\[]/); print n, t[2], t[3], t[4] ":" t[5] }	access.log
{ $3 = ""; print; print NF }	a.txt
{ NF = 2; print } END { $0 = "p   q  r"; print NF, $3; $5 = "e"; print; print NF }	nums.txt
-v	OFS=-	{ $1 = $1; print }	nums.txt
BEGIN { FS = "," } { print NF ": " $2 "|" $3 }	sales.csv
{ gsub(/[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/, "x.x.x.x"); print $1, $NF }	access.log
match($0, /took [0-9]+ms/) { print substr($0, RSTART + 5, RLENGTH - 7), "ms at", substr($1, 12, 8) }	app.log
BEGIN { s = "aaa"; n = gsub(/a*/, "-", s); print n, s; t = "hello"; gsub(//, "-", t); print t; u = "banana"; gsub(/ana/, "[&]", u); print u; v = "a.b.c"; sub(/\\./, "\\\\&", v); print v; w = "x"; print gsub(/y/, "z", w), w }
BEGIN { print index("hello", "ll"), index("hello", "z"), toupper("mixed Case 1"), tolower("ABC"); print substr("hello", 0), substr("hello", 5, 1), substr("hello", 2, 100), substr("hello", 3), "[" substr("hello", 9) substr("hello", 2, 0) "]" }
BEGIN { n = split("a b  c", p); print n, p[3]; n = split("a,,b", q, ","); print n, "[" q[2] "]"; n = split("", r); print n; n = split("2026-10-14", d, "-"); print d[1] + 0, d[2] * 2 }
