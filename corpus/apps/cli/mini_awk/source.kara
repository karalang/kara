fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        return Err(f"cannot create data: {e}");
    }
    put("data/a.txt", file_a_txt())?;
    put("data/access.log", file_access_log())?;
    put("data/app.log", file_app_log())?;
    put("data/b.txt", file_b_txt())?;
    put("data/contacts.txt", file_contacts_txt())?;
    put("data/df.txt", file_df_txt())?;
    put("data/env.conf", file_env_conf())?;
    put("data/nums.txt", file_nums_txt())?;
    put("data/orders.tsv", file_orders_tsv())?;
    put("data/passwd", file_passwd())?;
    put("data/ps.txt", file_ps_txt())?;
    put("data/report.awk", file_report_awk())?;
    put("data/sales.csv", file_sales_csv())?;
    put("data/users.tsv", file_users_tsv())?;
    put("jobs.tsv", jobs_tsv())?;
    Ok(())
}

// ------------------------------------------------------------ the command line

// What one awk run printed, and its exit status.
struct RunResult {
    out: String,
    err: String,
    status: i64,
}

fn usage_error(msg: Str) -> RunResult {
    RunResult { out: String.new(), err: f"mawk: {msg}\n", status: 2 }
}

// Runs `awk ARGS` with `dir` as the working directory.
fn run_awk(args: ref Vec[String], dir: Str) -> RunResult {
    let mut i: i64 = 0;
    let mut fs_opt: Vec[String] = Vec.new();
    let mut assigns: Vec[String] = Vec.new();
    let mut prog_file = String.new();
    while i < args.len() {
        let a = args[i].clone();
        let b = to_bytes(a);
        if a == "--" {
            i += 1;
            break;
        }
        if b.len() < 2 or b[0] != b'-' {
            break;
        }
        let rest = byte_str(b, 2, b.len());
        let opt = b[1];
        if opt != b'F' and opt != b'v' and opt != b'f' {
            return usage_error(f"not an option: {a}");
        }
        let value = if rest.len() > 0 {
            rest
        } else {
            i += 1;
            if i >= args.len() {
                return usage_error(f"option requires an argument -- {a}");
            }
            args[i].clone()
        };
        if opt == b'F' {
            fs_opt.push(value);
        } else if opt == b'v' {
            assigns.push(value);
        } else {
            prog_file = value;
        }
        i += 1;
    }
    let text = if prog_file.len() > 0 {
        match fs.read_to_string(f"{dir}/{prog_file}") {
            Ok(t) => t,
            Err(_) => return usage_error(f"couldn't open file {prog_file}"),
        }
    } else {
        if i >= args.len() {
            return usage_error("no program");
        }
        i += 1;
        args[i - 1].clone()
    };
    let prog = match parse_program(text) {
        Ok(p) => p,
        Err(e) => {
            let line = e.line;
            let msg = e.msg.clone();
            return RunResult { out: String.new(), err: f"mawk: line {line}: {msg}\n", status: 2 };
        }
    };
    let nglobals = prog.global_names.len();
    let nitems = prog.items.len();
    let mut it = Interp {
        prog: prog,
        dir: dir.to_string(),
        globals: Vec.new(),
        garr: Vec.new(),
        stack: Vec.new(),
        sarr: Vec.new(),
        fb: 0,
        arrays: Vec.new(),
        rec: String.new(),
        fields: Vec.new(),
        out: String.new(),
        err: String.new(),
        files: Vec.new(),
        readers: Vec.new(),
        argi: 1,
        in_text: Vec.new(),
        in_pos: 0,
        in_open: false,
        used_file: false,
        range_on: Vec.new(),
        exit_code: 0,
        ret: uninit(),
        unwinding: false,
        fatal: false,
        dyn_regex: Map.new(),
    };
    for _ in 0..nglobals {
        it.globals.push(uninit());
        it.garr.push(-1);
    }
    for _ in 0..nitems {
        it.range_on.push(false);
    }
    it.globals[V_NR] = num_cell(0.0);
    it.globals[V_NF] = num_cell(0.0);
    it.globals[V_FNR] = num_cell(0.0);
    it.globals[V_FS] = str_cell(" ".to_string());
    it.globals[V_OFS] = str_cell(" ".to_string());
    it.globals[V_ORS] = str_cell("\n".to_string());
    it.globals[V_RS] = str_cell("\n".to_string());
    it.globals[V_FILENAME] = str_cell(String.new());
    it.globals[V_SUBSEP] = str_cell(from_bytes(vec![28]));
    it.globals[V_RSTART] = num_cell(0.0);
    it.globals[V_RLENGTH] = num_cell(-1.0);
    it.globals[V_CONVFMT] = str_cell("%.6g".to_string());
    it.globals[V_OFMT] = str_cell("%.6g".to_string());
    let operands = args.len() - i;
    it.globals[V_ARGC] = num_cell((operands + 1) as f64);
    let argv = it.arr_id(V_ARGV, false);
    let s0 = it.arrays[argv].slot("0");
    it.arrays[argv].vals[s0] = str_cell("mawk".to_string());
    for k in 0..operands {
        let key = f"{k + 1}";
        let slot = it.arrays[argv].slot(key);
        it.arrays[argv].vals[slot] = input_cell(args[i + k].clone());
    }
    if fs_opt.len() > 0 {
        let v = unescape(to_bytes(fs_opt[fs_opt.len() - 1]));
        it.globals[V_FS] = str_cell(v);
    }
    for k in 0..assigns.len() {
        match assignment_name(assigns[k]) {
            Some((name, value)) => {
                let (v, _) = it.global_of(name);
                it.set_var(v, false, input_cell(unescape(to_bytes(value))));
            }
            None => {
                let bad = assigns[k].clone();
                return usage_error(f"improper assignment: -v {bad}");
            }
        }
    }
    it.run();
    let status = if it.fatal { 2 } else { it.exit_code };
    RunResult { out: it.out, err: it.err, status: status }
}

// ------------------------------------------------------------ the jobs

// An argument as a shell would need it written.
fn quote(a: Str) -> String {
    let b = a.bytes();
    let mut plain = b.len() > 0;
    for i in 0..b.len() {
        let c = b[i];
        let ok = is_alpha(c) or is_digit(c) or c == b'_' or c == b'.' or c == b'/' or c == b'=' or c == b'+' or c == b':' or c == b',' or c == b'%' or c == b'@' or c == b'-';
        if not ok {
            plain = false;
        }
    }
    if plain {
        return a.to_string();
    }
    let mut out: Vec[u8] = Vec.new();
    out.push(b'\'');
    for i in 0..b.len() {
        if b[i] == b'\'' {
            push_str_bytes(mut out, "'\\''");
        } else {
            out.push(b[i]);
        }
    }
    out.push(b'\'');
    from_bytes(out)
}

// Prints text, marking a missing final newline.
fn show(text: Str) {
    print(text);
    if text.len() > 0 and not text.ends_with("\n") {
        println("[no newline at end]");
    }
}

// The lines of a file that ends in a newline.
fn file_lines(text: Str) -> Vec[String] {
    let b = to_bytes(text);
    let mut out: Vec[String] = Vec.new();
    let mut st: i64 = 0;
    for i in 0..b.len() {
        if b[i] == b'\n' {
            out.push(byte_str(b, st, i));
            st = i + 1;
        }
    }
    out
}

// A job line's arguments: tab-separated, a vertical tab standing for a
// newline.
fn job_args(line: Str) -> Vec[String] {
    let b = to_bytes(line);
    let mut out: Vec[String] = Vec.new();
    let mut cur: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        if b[i] == b'\t' {
            out.push(from_bytes(cur));
            cur = Vec.new();
        } else if b[i] == 11 {
            cur.push(b'\n');
        } else {
            cur.push(b[i]);
        }
    }
    out.push(from_bytes(cur));
    out
}

fn run() -> Result[(), String] {
    write_data()?;
    let jobs = match fs.read_to_string("jobs.tsv".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read jobs.tsv: {e}"),
    };
    let lines = file_lines(jobs);
    for j in 0..lines.len() {
        let args = job_args(lines[j]);
        if args[0] == "@cat" {
            let name = args[1].clone();
            println(f"$ cat {name}");
            match fs.read_to_string(f"data/{name}") {
                Ok(t) => show(t),
                Err(e) => println(f"cat: {name}: {e}"),
            }
            continue;
        }
        let mut shown = String.new();
        for k in 0..args.len() {
            shown.push_str(" ");
            shown.push_str(quote(args[k]));
        }
        println(f"$ awk{shown}");
        let res = run_awk(args, "data");
        show(res.out);
        show(res.err);
        if res.status != 0 {
            let st = res.status;
            println(f"[exit {st}]");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_awk: {e}");
    }
}
