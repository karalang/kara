  |#: larkfield/views/loans.py:102
  |#: larkfield/views/loans.py:147
  |#: larkfield/emails/reminders.py:33
  |#: larkfield/emails/reminders.py:71
  |#: templates/loans/overdue-notice.html:9
  |#: templates/loans/overdue-notice.txt:4
  |#: static/js/loan-calendar.js:210
  |#, python-format
  |msgid "Return by %(date)s"
  |msgstr "À rendre avant le %(date)s"
  |
  |#. This is shown on the account page
  |#. under the loan list, and is the one
  |#. place where the fine schedule is
  |#. explained, so keep the amounts and
  |#. the
  |#. grace period exactly as written in
  |#. the source text.
  |#: templates/members/fines.html:14
  |msgid ""
  |"Fines are charged at 25 cents a day "
  |"after a grace period of three days, up"
  |" to the replacement cost of the item. "
  |"Fines under one dollar are waived at "
  |"checkout."
  |msgstr ""
  |"Les pénalités sont de 25 centimes par "
  |"jour après un délai de grâce de trois "
  |"jours, dans la limite du coût de "
  |"remplacement du document. Les "
  |"pénalités inférieures à un dollar sont"
  |" annulées au moment de l'emprunt."
  |
  |#: larkfield/forms.py:22
  |msgid "Library card number"
  |msgstr "Numéro de carte"
  |
  |#: larkfield/forms.py:23
  |msgid "PIN"
  |msgstr "Code"
  |
  |#: templates/base.html:5
  |msgid "Larkfield - your library, online"
  |msgstr ""
  |"Larkfield - votre bibliothèque en "
  |"ligne"
  |
  |#: templates/base.html:17
  |msgid "Sign out"
  |msgstr "Se déconnecter"
  |
  |#: templates/base.html:18
  |#: templates/base.html:44
  |msgid "My account"
  |msgstr "Mon compte"
  |
  |#: templates/catalog/detail.html:12
  |#, fuzzy
  |msgid "Available"
  |msgstr "Libre"
  |
  |#: templates/catalog/detail.html:13
  |msgid "On loan"
  |msgstr "Emprunté"
