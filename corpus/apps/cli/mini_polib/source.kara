// mini_polib: polib 1.2.0 (David Jean Louis, MIT), the gettext catalog
// library: PO and POT files parsed by its state machine, written back
// with its wrapping, searched, merged against a template as msgmerge
// does, compiled to MO files and read back from them, with its encoding
// detection, escaping and natural sort.
//
// The run writes the catalogs of its data section into data/, then runs
// every command in data/jobs.txt. polib wraps with Python's textwrap, so
// the TextWrapper port of mini_textwrap comes first; text is handled as
// Vec[char] wherever polib counts code points.

// ------------------------------------------------------------ characters
// textwrap's _whitespace: the only characters its regexes treat as space.
fn is_ws(c: char) -> bool {
    c == ' ' or c == '\t' or c == '\n' or c == '\u{b}' or c == '\u{c}' or c == '\r'
}

// str.isspace, which str.strip and str.split use: Unicode White_Space plus
// the four ASCII separators U+001C..U+001F.
fn py_space(c: char) -> bool {
    c.is_whitespace() or (c >= '\u{1c}' and c <= '\u{1f}')
}

// The regex class \w.
fn is_word(c: char) -> bool {
    c.is_alphanumeric() or c == '_'
}

// textwrap's `letter`, [^\d\W]: a word character that is not a digit.
fn is_letter(c: char) -> bool {
    is_word(c) and not c.is_ascii_digit()
}

// textwrap's `word_punct`, [\w!"'&.,?].
fn is_word_punct(c: char) -> bool {
    is_word(c) or c == '!' or c == '"' or c == '\'' or c == '&' or c == '.' or c == ',' or c == '?'
}

fn chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn text(v: ref Vec[char]) -> String {
    v.iter().collect()
}

fn is_blank(v: ref Vec[char]) -> bool {
    v.iter().all(|c| py_space(*c))
}

fn lstrip(v: ref Vec[char]) -> Vec[char] {
    let mut i = 0;
    while i < v.len() and py_space(v[i]) {
        i += 1;
    }
    v[i..].to_vec()
}

fn rstrip(v: ref Vec[char]) -> Vec[char] {
    let mut n = v.len();
    while n > 0 and py_space(v[n - 1]) {
        n -= 1;
    }
    v[0..n].to_vec()
}

fn concat(parts: ref Vec[Vec[char]]) -> Vec[char] {
    let mut out: Vec[char] = Vec.new();
    for p in parts.iter() {
        for c in p.iter() {
            out.push(*c);
        }
    }
    out
}

fn total_len(parts: ref Vec[Vec[char]]) -> i64 {
    let mut n = 0;
    for p in parts.iter() {
        n += p.len();
    }
    n
}

// str.split() with no argument: runs of whitespace separate the words.
fn py_split(v: ref Vec[char]) -> Vec[Vec[char]] {
    let mut words: Vec[Vec[char]] = Vec.new();
    let mut cur: Vec[char] = Vec.new();
    for c in v.iter() {
        if py_space(*c) {
            if not cur.is_empty() {
                words.push(cur);
                cur = Vec.new();
            }
        } else {
            cur.push(*c);
        }
    }
    if not cur.is_empty() {
        words.push(cur);
    }
    words
}

// str.split(sep) for a one-character separator: always at least one piece.
fn split_on(v: ref Vec[char], sep: char) -> Vec[Vec[char]] {
    let mut pieces: Vec[Vec[char]] = Vec.new();
    let mut cur: Vec[char] = Vec.new();
    for c in v.iter() {
        if *c == sep {
            pieces.push(cur);
            cur = Vec.new();
        } else {
            cur.push(*c);
        }
    }
    pieces.push(cur);
    pieces
}

fn join_on(pieces: ref Vec[Vec[char]], sep: char) -> Vec[char] {
    let mut out: Vec[char] = Vec.new();
    for i in 0..pieces.len() {
        if i > 0 {
            out.push(sep);
        }
        for c in pieces[i].iter() {
            out.push(*c);
        }
    }
    out
}

fn starts_with(v: ref Vec[char], prefix: ref Vec[char]) -> bool {
    if prefix.len() > v.len() {
        return false;
    }
    for i in 0..prefix.len() {
        if v[i] != prefix[i] {
            return false;
        }
    }
    true
}

// ------------------------------------------------------------ TextWrapper

struct Wrapper {
    width: i64,
    initial_indent: Vec[char],
    subsequent_indent: Vec[char],
    expand_tabs: bool,
    tabsize: i64,
    replace_whitespace: bool,
    fix_sentence_endings: bool,
    break_long_words: bool,
    break_on_hyphens: bool,
    drop_whitespace: bool,
    max_lines: Option[i64],
    placeholder: Vec[char],
}

impl Wrapper {
    fn new(width: i64) -> Wrapper {
        Wrapper {
            width: width,
            initial_indent: Vec.new(),
            subsequent_indent: Vec.new(),
            expand_tabs: true,
            tabsize: 8,
            replace_whitespace: true,
            fix_sentence_endings: false,
            break_long_words: true,
            break_on_hyphens: true,
            drop_whitespace: true,
            max_lines: None,
            placeholder: chars(" [...]"),
        }
    }

    // _munge_whitespace: str.expandtabs, then every _whitespace character
    // becomes a space.
    fn munge(ref self, t: ref Vec[char]) -> Vec[char] {
        let mut out: Vec[char] = Vec.new();
        if self.expand_tabs {
            let mut col = 0;
            for c in t.iter() {
                if *c == '\t' {
                    if self.tabsize > 0 {
                        let incr = self.tabsize - col % self.tabsize;
                        for _ in 0..incr {
                            out.push(' ');
                        }
                        col += incr;
                    }
                } else if *c == '\n' or *c == '\r' {
                    out.push(*c);
                    col = 0;
                } else {
                    out.push(*c);
                    col += 1;
                }
            }
        } else {
            out = t.clone();
        }
        if self.replace_whitespace {
            for i in 0..out.len() {
                if is_ws(out[i]) {
                    out[i] = ' ';
                }
            }
        }
        out
    }

    // _split: wordsep_re (or wordsep_simple_re) splits the text into
    // chunks that tile it.
    fn split(ref self, t: ref Vec[char]) -> Vec[Vec[char]] {
        let n = t.len();
        let mut chunks: Vec[Vec[char]] = Vec.new();
        let mut i = 0;
        while i < n {
            let mut end = i;
            if is_ws(t[i]) {
                while end < n and is_ws(t[end]) {
                    end += 1;
                }
            } else if not self.break_on_hyphens {
                while end < n and not is_ws(t[end]) {
                    end += 1;
                }
            } else {
                end = match em_dash_at(t, i) {
                    Some(e) => e,
                    None => word_end(t, i),
                };
            }
            chunks.push(t[i..end].to_vec());
            i = end;
        }
        chunks
    }

    // _fix_sentence_endings
    fn fix_endings(ref self, chunks: mut ref Vec[Vec[char]]) {
        let mut i = 0;
        while i + 1 < chunks.len() {
            if chunks[i + 1] == vec![' '] and sentence_end(chunks[i]) {
                chunks[i + 1] = vec![' ', ' '];
                i += 2;
            } else {
                i += 1;
            }
        }
    }

    // _handle_long_word
    fn handle_long_word(ref self, rev: mut ref Vec[Vec[char]], cur_line: mut ref Vec[Vec[char]], cur_len: i64, width: i64) {
        let space_left = if width < 1 { 1 } else { width - cur_len };
        if self.break_long_words {
            let mut end = space_left;
            let last = rev.len() - 1;
            let chunk = rev[last].clone();
            if self.break_on_hyphens and chunk.len() > space_left {
                // chunk.rfind('-', 0, space_left)
                let mut hyphen = -1;
                let mut k = space_left;
                while k > 0 {
                    k -= 1;
                    if chunk[k] == '-' {
                        hyphen = k;
                        break;
                    }
                }
                if hyphen > 0 and chunk[0..hyphen].iter().any(|c| *c != '-') {
                    end = hyphen + 1;
                }
            }
            if end > chunk.len() {
                end = chunk.len();
            }
            cur_line.push(chunk[0..end].to_vec());
            rev[last] = chunk[end..].to_vec();
        } else if cur_line.is_empty() {
            cur_line.push(rev.pop().unwrap());
        }
    }

    // _wrap_chunks
    fn wrap_chunks(ref self, chunks: own Vec[Vec[char]]) -> Result[Vec[Vec[char]], String] {
        let mut lines: Vec[Vec[char]] = Vec.new();
        if self.width <= 0 {
            return Err(f"invalid width {self.width} (must be > 0)");
        }
        if let Some(ml) = self.max_lines {
            let indent = if ml > 1 { self.subsequent_indent.clone() } else { self.initial_indent.clone() };
            if indent.len() + lstrip(self.placeholder).len() > self.width {
                return Err("placeholder too large for max width".to_string());
            }
        }
        let mut rev = chunks;
        rev.reverse();
        while not rev.is_empty() {
            let mut cur_line: Vec[Vec[char]] = Vec.new();
            let mut cur_len = 0;
            let indent = if lines.is_empty() { self.initial_indent.clone() } else { self.subsequent_indent.clone() };
            let width = self.width - indent.len();
            if self.drop_whitespace and is_blank(rev[rev.len() - 1]) and not lines.is_empty() {
                rev.pop();
            }
            while not rev.is_empty() {
                let l = rev[rev.len() - 1].len();
                if cur_len + l <= width {
                    cur_line.push(rev.pop().unwrap());
                    cur_len += l;
                } else {
                    break;
                }
            }
            if not rev.is_empty() and rev[rev.len() - 1].len() > width {
                self.handle_long_word(mut rev, mut cur_line, cur_len, width);
                cur_len = total_len(cur_line);
            }
            if self.drop_whitespace and not cur_line.is_empty() and is_blank(cur_line[cur_line.len() - 1]) {
                cur_len -= cur_line[cur_line.len() - 1].len();
                cur_line.pop();
            }
            if cur_line.is_empty() {
                continue;
            }
            let fits = match self.max_lines {
                None => true,
                Some(ml) => {
                    lines.len() + 1 < ml
                        or ((rev.is_empty() or (self.drop_whitespace and rev.len() == 1 and is_blank(rev[0]))) and cur_len <= width)
                }
            };
            if fits {
                let mut line = indent.clone();
                for c in concat(cur_line).iter() {
                    line.push(*c);
                }
                lines.push(line);
                continue;
            }
            // Truncate with the placeholder, and stop.
            let mut placed = false;
            while not cur_line.is_empty() {
                if not is_blank(cur_line[cur_line.len() - 1]) and cur_len + self.placeholder.len() <= width {
                    cur_line.push(self.placeholder.clone());
                    let mut line = indent.clone();
                    for c in concat(cur_line).iter() {
                        line.push(*c);
                    }
                    lines.push(line);
                    placed = true;
                    break;
                }
                cur_len -= cur_line[cur_line.len() - 1].len();
                cur_line.pop();
            }
            if not placed {
                let mut done = false;
                if not lines.is_empty() {
                    let last = lines.len() - 1;
                    let prev_line = rstrip(lines[last]);
                    if prev_line.len() + self.placeholder.len() <= self.width {
                        let mut line = prev_line;
                        for c in self.placeholder.iter() {
                            line.push(*c);
                        }
                        lines[last] = line;
                        done = true;
                    }
                }
                if not done {
                    let mut line = indent.clone();
                    for c in lstrip(self.placeholder).iter() {
                        line.push(*c);
                    }
                    lines.push(line);
                }
            }
            break;
        }
        Ok(lines)
    }

    fn wrap(ref self, t: ref Vec[char]) -> Result[Vec[Vec[char]], String] {
        let mut chunks = self.split(self.munge(t));
        if self.fix_sentence_endings {
            self.fix_endings(mut chunks);
        }
        self.wrap_chunks(chunks)
    }

    fn fill(ref self, t: ref Vec[char]) -> Result[Vec[char], String] {
        match self.wrap(t) {
            Ok(lines) => Ok(join_on(lines, '\n')),
            Err(e) => Err(e),
        }
    }
}

// The em-dash alternative of wordsep_re, (?<=word_punct) -{2,} (?=\w),
// tried at i: the end of the dash run.
fn em_dash_at(t: ref Vec[char], i: i64) -> Option[i64] {
    if i == 0 or not is_word_punct(t[i - 1]) {
        return None;
    }
    let mut k = i;
    while k < t.len() and t[k] == '-' {
        k += 1;
    }
    if k - i >= 2 and k < t.len() and is_word(t[k]) {
        Some(k)
    } else {
        None
    }
}

// (?=-{2,}\w) at j.
fn dashes_then_word(t: ref Vec[char], j: i64) -> bool {
    let mut k = j;
    while k < t.len() and t[k] == '-' {
        k += 1;
    }
    k - j >= 2 and k < t.len() and is_word(t[k])
}

// The word alternative of wordsep_re, tried at i (a non-space): the lazy
// \S+? grows one character at a time until one of its three endings
// matches.
fn word_end(t: ref Vec[char], i: i64) -> i64 {
    let n = t.len();
    let mut j = i + 1;
    loop {
        // A hyphen inside a compound word: -(?:(?<=lt{2}-)|(?<=lt-lt-))(?=lt-?lt)
        if j < n and t[j] == '-' {
            let behind = (j >= 2 and is_letter(t[j - 2]) and is_letter(t[j - 1]))
                or (j >= 3 and is_letter(t[j - 3]) and t[j - 2] == '-' and is_letter(t[j - 1]));
            let ahead = j + 1 < n and is_letter(t[j + 1])
                and ((j + 2 < n and is_letter(t[j + 2])) or (j + 3 < n and t[j + 2] == '-' and is_letter(t[j + 3])));
            if behind and ahead {
                return j + 1;
            }
        }
        // The end of the word: (?=ws|\Z)
        if j == n or is_ws(t[j]) {
            return j;
        }
        // An em-dash follows: (?<=word_punct)(?=-{2,}\w)
        if is_word_punct(t[j - 1]) and dashes_then_word(t, j) {
            return j;
        }
        j += 1;
    }
}

// sentence_end_re, [a-z][\.\!\?][\"\']?\Z, searched in a chunk.
fn sentence_end(c: ref Vec[char]) -> bool {
    let mut n = c.len();
    if n > 0 and (c[n - 1] == '"' or c[n - 1] == '\'') {
        n -= 1;
    }
    n >= 2 and c[n - 2] >= 'a' and c[n - 2] <= 'z' and (c[n - 1] == '.' or c[n - 1] == '!' or c[n - 1] == '?')
}

// ------------------------------------------------------------ Python's str

struct PoErr {
    kind: String,
    msg: String,
}

fn err(kind: ref String, msg: ref String) -> PoErr {
    PoErr { kind: kind.clone(), msg: msg.clone() }
}

fn clen(s: ref String) -> i64 {
    s.chars().count() as i64
}

// s[a:b] counted in code points, with Python's clamping for a and b in
// 0..len (callers resolve negative indexes).
fn cslice(s: ref String, a: i64, b: i64) -> String {
    let v = chars(s);
    let n = v.len() as i64;
    let lo = if a < 0 { 0 } else if a > n { n } else { a };
    let hi = if b < lo { lo } else if b > n { n } else { b };
    text(v[lo..hi].to_vec())
}

// s[a:], in code points.
fn cfrom(s: ref String, a: i64) -> String {
    cslice(s, a, clen(s))
}

// s[1:-1], in code points.
fn inner(s: ref String) -> String {
    cslice(s, 1, clen(s) - 1)
}

fn py_strip(s: ref String) -> String {
    text(rstrip(lstrip(chars(s))))
}

fn py_lstrip(s: ref String) -> String {
    text(lstrip(chars(s)))
}

// str.split(None, maxsplit) on a string that has no surrounding space.
fn split_ws(s: ref String, maxsplit: i64) -> Vec[String] {
    let v = chars(s);
    let n = v.len() as i64;
    let mut out: Vec[String] = Vec.new();
    let mut i = 0;
    while i < n {
        while i < n and py_space(v[i]) {
            i += 1;
        }
        if i >= n {
            break;
        }
        if maxsplit >= 0 and out.len() as i64 == maxsplit {
            out.push(text(v[i..n].to_vec()));
            break;
        }
        let start = i;
        while i < n and not py_space(v[i]) {
            i += 1;
        }
        out.push(text(v[start..i].to_vec()));
    }
    out
}

fn is_ascii_digits(s: ref String) -> bool {
    s.len() > 0 and s.chars().all(|c| c.is_ascii_digit())
}

// str.splitlines(keepends): the line boundaries of str, ASCII and the
// three Unicode ones.
fn splitlines(s: ref String, keep: bool) -> Vec[String] {
    let v = chars(s);
    let n = v.len() as i64;
    let mut out: Vec[String] = Vec.new();
    let mut start = 0;
    let mut i = 0;
    while i < n {
        let c = v[i];
        let is_break = c == '\n' or c == '\r' or c == '\u{b}' or c == '\u{c}' or c == '\u{1c}' or c == '\u{1d}' or c == '\u{1e}' or c == '\u{85}' or c == '\u{2028}' or c == '\u{2029}';
        if is_break {
            let mut end = i + 1;
            if c == '\r' and i + 1 < n and v[i + 1] == '\n' {
                end = i + 2;
            }
            if keep {
                out.push(text(v[start..end].to_vec()));
            } else {
                out.push(text(v[start..i].to_vec()));
            }
            start = end;
            i = end;
        } else {
            i += 1;
        }
    }
    if start < n {
        out.push(text(v[start..n].to_vec()));
    }
    out
}

fn split_str(s: ref String, sep: ref String) -> Vec[String] {
    s.split(sep).map(|x| x.to_string()).collect()
}

// str.isprintable for the characters this port can meet: controls,
// the C1 block, the separators and the format characters are not.
fn printable(c: char) -> bool {
    let u = c as u32;
    if u < 32 or u == 127 {
        return false;
    }
    if u < 128 {
        return true;
    }
    not ((u >= 0x80 and u <= 0xa0) or u == 0xad or (u >= 0x2000 and u <= 0x200f) or (u >= 0x2028 and u <= 0x202f) or (u >= 0x205f and u <= 0x206f) or u == 0x3000 or u == 0xfeff)
}

fn hex_digits(u: i64, width: i64) -> String {
    let digits = "0123456789abcdef".to_string();
    let mut out = String.new();
    let mut k = width - 1;
    while k >= 0 {
        let d = (u >> (4 * k)) & 15;
        out.push_str(digits.substring(d, d + 1));
        k -= 1;
    }
    out
}

// repr() of a str.
fn py_repr(s: ref String) -> String {
    let has_single = s.contains("'");
    let has_double = s.contains("\"");
    let q = if has_single and not has_double { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if printable(c) {
            out.push(c);
        } else {
            let u = c as u32 as i64;
            if u < 256 {
                out.push_str(f"\\x{hex_digits(u, 2)}");
            } else if u < 65536 {
                out.push_str(f"\\u{hex_digits(u, 4)}");
            } else {
                out.push_str(f"\\U{hex_digits(u, 8)}");
            }
        }
    }
    out.push(q);
    out
}

fn repr_list(v: ref Vec[String]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for s in v {
        parts.push(py_repr(s));
    }
    f"[{parts.join(", ")}]"
}

fn py_bool(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

// ------------------------------------------------------------ polib's helpers

// polib.escape: backslash, the five control escapes and the double quote.
fn escape(st: ref String) -> String {
    let mut out = String.new();
    for c in st.chars() {
        if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\u{b}' {
            out.push_str("\\v");
        } else if c == '\u{8}' {
            out.push_str("\\b");
        } else if c == '\u{c}' {
            out.push_str("\\f");
        } else if c == '"' {
            out.push_str("\\\"");
        } else {
            out.push(c);
        }
    }
    out
}

// polib.unescape: re.sub(r'\\(\\|n|t|r|v|b|f|")', ...), left to right.
fn unescape(st: ref String) -> String {
    let v = chars(st);
    let n = v.len() as i64;
    let mut out = String.new();
    let mut i = 0;
    while i < n {
        if v[i] == '\\' and i + 1 < n {
            let m = v[i + 1];
            let rep = if m == 'n' {
                Some('\n')
            } else if m == 't' {
                Some('\t')
            } else if m == 'r' {
                Some('\r')
            } else if m == 'v' {
                Some('\u{b}')
            } else if m == 'b' {
                Some('\u{8}')
            } else if m == 'f' {
                Some('\u{c}')
            } else if m == '\\' {
                Some('\\')
            } else if m == '"' {
                Some('"')
            } else {
                None
            };
            match rep {
                Some(r) => {
                    out.push(r);
                    i += 2;
                    continue;
                }
                None => {}
            }
        }
        out.push(v[i]);
        i += 1;
    }
    out
}

// The parser's check, re.search(r'([^\\]|^)"', s): a quote at the start
// or after anything but a backslash.
fn unescaped_quote(s: ref String) -> bool {
    let v = chars(s);
    for i in 0..v.len() as i64 {
        if v[i] == '"' and (i == 0 or v[i - 1] != '\\') {
            return true;
        }
    }
    false
}

// natural_sort's key, [int(t) if t.isdigit() else t.lower() for t in
// re.split('([0-9]+)', key)]: text and numbers alternate, text first.
struct NatPart {
    num: bool,
    n: i64,
    t: String,
}

fn nat_key(s: ref String) -> Vec[NatPart] {
    let v = chars(s);
    let n = v.len() as i64;
    let mut out: Vec[NatPart] = Vec.new();
    let mut i = 0;
    let mut cur = String.new();
    while i < n {
        if v[i].is_ascii_digit() {
            out.push(NatPart { num: false, n: 0, t: cur.to_lowercase() });
            cur = String.new();
            let start = i;
            while i < n and v[i].is_ascii_digit() {
                i += 1;
            }
            let digits = text(v[start..i].to_vec());
            let value = match i64.parse(digits) {
                Ok(x) => x,
                Err(_) => 0,
            };
            out.push(NatPart { num: true, n: value, t: String.new() });
        } else {
            cur.push(v[i]);
            i += 1;
        }
    }
    out.push(NatPart { num: false, n: 0, t: cur.to_lowercase() });
    out
}

fn nat_cmp(a: ref Vec[NatPart], b: ref Vec[NatPart]) -> i64 {
    let n = if a.len() < b.len() { a.len() } else { b.len() };
    for i in 0..n as i64 {
        let x = ref a[i];
        let y = ref b[i];
        if x.num {
            if x.n != y.n {
                return if x.n < y.n { -1 } else { 1 };
            }
        } else if x.t != y.t {
            return if x.t < y.t { -1 } else { 1 };
        }
    }
    if a.len() < b.len() {
        -1
    } else if a.len() > b.len() {
        1
    } else {
        0
    }
}

// polib.natural_sort (sorted() is stable).
fn natural_sort(lst: ref Vec[String]) -> Vec[String] {
    let mut keyed: Vec[(Vec[NatPart], i64)] = Vec.new();
    for i in 0..lst.len() as i64 {
        keyed.push((nat_key(lst[i]), i));
    }
    keyed.sort_by(|a, b| {
        let c = nat_cmp(a.0, b.0);
        if c != 0 { c.cmp(0) } else { a.1.cmp(b.1) }
    });
    let mut out: Vec[String] = Vec.new();
    for k in keyed {
        out.push(lst[k.1].clone());
    }
    out
}

// textwrap.wrap with break_long_words=False, as polib calls it.
fn tw_wrap(t: ref String, width: i64, initial: ref String, subsequent: ref String, drop_ws: bool) -> Result[Vec[String], PoErr] {
    let mut w = Wrapper.new(width);
    w.break_long_words = false;
    w.drop_whitespace = drop_ws;
    w.initial_indent = chars(initial);
    w.subsequent_indent = chars(subsequent);
    match w.wrap(chars(t)) {
        Ok(lines) => {
            let mut out: Vec[String] = Vec.new();
            for l in lines {
                out.push(text(l));
            }
            Ok(out)
        }
        Err(e) => Err(err("ValueError", e)),
    }
}

// ------------------------------------------------------------ entries

// A POEntry (or an MOEntry, whose comments, occurrences, flags and
// previous fields stay empty and which has no line number).
#[derive(Clone)]
struct PoEntry {
    msgid: String,
    msgstr: String,
    msgid_plural: String,
    // msgstr_plural, a dict: kept in insertion order
    plural: Vec[(i64, String)],
    msgctxt: Option[String],
    obsolete: bool,
    comment: String,
    tcomment: String,
    occurrences: Vec[(String, String)],
    flags: Vec[String],
    prev_ctxt: Option[String],
    prev_id: Option[String],
    prev_plural: Option[String],
    linenum: Option[i64],
}

fn new_entry(linenum: Option[i64]) -> PoEntry {
    PoEntry {
        msgid: String.new(),
        msgstr: String.new(),
        msgid_plural: String.new(),
        plural: Vec.new(),
        msgctxt: None,
        obsolete: false,
        comment: String.new(),
        tcomment: String.new(),
        occurrences: Vec.new(),
        flags: Vec.new(),
        prev_ctxt: None,
        prev_id: None,
        prev_plural: None,
        linenum: linenum,
    }
}

fn plural_pos(e: ref PoEntry, k: i64) -> i64 {
    for i in 0..e.plural.len() as i64 {
        if e.plural[i].0 == k {
            return i;
        }
    }
    -1
}

fn plural_set(e: mut ref PoEntry, k: i64, v: ref String) {
    let p = plural_pos(e, k);
    if p >= 0 {
        e.plural[p].1 = v.clone();
    } else {
        e.plural.push((k, v.clone()));
    }
}

fn plural_keys(e: ref PoEntry) -> Vec[i64] {
    let mut ks: Vec[i64] = Vec.new();
    for p in e.plural {
        ks.push(p.0);
    }
    ks.sort();
    ks
}

fn plural_at(e: ref PoEntry, k: i64) -> String {
    let p = plural_pos(e, k);
    e.plural[p].1.clone()
}

fn has_flag(e: ref PoEntry, f: ref String) -> bool {
    for x in e.flags {
        if x == f {
            return true;
        }
    }
    false
}

fn is_fuzzy(e: ref PoEntry) -> bool {
    has_flag(e, "fuzzy")
}

// The fuzzy property's setter.
fn set_fuzzy(e: mut ref PoEntry, value: bool) {
    if value and not is_fuzzy(e) {
        e.flags.insert(0, "fuzzy".to_string());
    } else if not value and is_fuzzy(e) {
        let mut at = 0;
        while e.flags[at] != "fuzzy" {
            at += 1;
        }
        e.flags.remove(at);
    }
}

fn translated(e: ref PoEntry) -> bool {
    if e.obsolete or is_fuzzy(e) {
        return false;
    }
    if e.msgstr != "" {
        return true;
    }
    if e.plural.len() > 0 {
        for p in e.plural {
            if p.1 == "" {
                return false;
            }
        }
        return true;
    }
    false
}

fn ctx_truthy(c: ref Option[String]) -> bool {
    match c {
        Some(s) => s.len() > 0,
        None => false,
    }
}

fn ctx_text(c: ref Option[String]) -> String {
    match c {
        Some(s) => s.clone(),
        None => String.new(),
    }
}

// msgid_with_context
fn ctx_key(e: ref PoEntry) -> String {
    if ctx_truthy(e.msgctxt) {
        f"{ctx_text(e.msgctxt)}\u{4}{e.msgid}"
    } else {
        e.msgid.clone()
    }
}

fn cmp_str(a: ref String, b: ref String) -> i64 {
    if a < b {
        -1
    } else if a > b {
        1
    } else {
        0
    }
}

fn cmp_occ(a: ref (String, String), b: ref (String, String)) -> i64 {
    let c = cmp_str(a.0, b.0);
    if c != 0 { c } else { cmp_str(a.1, b.1) }
}

fn sorted_occ(e: ref PoEntry) -> Vec[(String, String)] {
    let mut v = e.occurrences.clone();
    v.sort_by(|a, b| cmp_occ(a, b).cmp(0));
    v
}

fn cmp_list(a: ref Vec[String], b: ref Vec[String]) -> i64 {
    let n = if a.len() < b.len() { a.len() } else { b.len() };
    for i in 0..n as i64 {
        let c = cmp_str(a[i], b[i]);
        if c != 0 {
            return c;
        }
    }
    if a.len() < b.len() {
        -1
    } else if a.len() > b.len() {
        1
    } else {
        0
    }
}

fn or_zero(c: ref Option[String]) -> String {
    if ctx_truthy(c) { ctx_text(c) } else { "0".to_string() }
}

fn plural_values(e: ref PoEntry) -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    for p in e.plural {
        v.push(p.1.clone());
    }
    v
}

// POEntry.__cmp__
fn entry_cmp(a: ref PoEntry, b: ref PoEntry) -> i64 {
    if a.obsolete != b.obsolete {
        return if a.obsolete { -1 } else { 1 };
    }
    let o1 = sorted_occ(a);
    let o2 = sorted_occ(b);
    let n = if o1.len() < o2.len() { o1.len() } else { o2.len() };
    for i in 0..n as i64 {
        let c = cmp_occ(o1[i], o2[i]);
        if c != 0 {
            return c;
        }
    }
    if o1.len() != o2.len() {
        return if o1.len() < o2.len() { -1 } else { 1 };
    }
    let c = cmp_str(or_zero(a.msgctxt), or_zero(b.msgctxt));
    if c != 0 {
        return c;
    }
    let pa = if a.msgid_plural.len() > 0 { a.msgid_plural.clone() } else { "0".to_string() };
    let pb = if b.msgid_plural.len() > 0 { b.msgid_plural.clone() } else { "0".to_string() };
    let c = cmp_str(pa, pb);
    if c != 0 {
        return c;
    }
    let c = cmp_list(plural_values(a), plural_values(b));
    if c != 0 {
        return c;
    }
    let c = cmp_str(a.msgid, b.msgid);
    if c != 0 {
        return c;
    }
    cmp_str(a.msgstr, b.msgstr)
}

// _BaseEntry._str_field
fn str_field(fieldname: ref String, delflag: ref String, plural_index: ref String, field: ref String, wrapwidth: i64) -> Result[Vec[String], PoErr] {
    let mut lines = splitlines(field, true);
    if lines.len() > 1 {
        lines.insert(0, String.new());
    } else {
        let escaped = escape(field);
        let mut specials = 0;
        for c in field.chars() {
            if c == '\\' or c == '\n' or c == '\r' or c == '\t' or c == '\u{b}' or c == '\u{8}' or c == '\u{c}' or c == '"' {
                specials += 1;
            }
        }
        let mut flength = clen(fieldname) + 3;
        if plural_index.len() > 0 {
            flength += clen(plural_index);
        }
        let real = wrapwidth - flength + specials;
        if wrapwidth > 0 and clen(field) > real {
            lines = [String.new()].to_vec();
            for item in tw_wrap(escaped, wrapwidth - 2, String.new(), String.new(), false)? {
                lines.push(unescape(item));
            }
        } else {
            lines = [field.clone()].to_vec();
        }
    }
    let name = if fieldname.starts_with("previous_") { cfrom(fieldname, 9) } else { fieldname.clone() };
    let mut ret: Vec[String] = Vec.new();
    ret.push(f"{delflag}{name}{plural_index} \"{escape(lines[0])}\"");
    for i in 1..lines.len() as i64 {
        ret.push(f"{delflag}\"{escape(lines[i])}\"");
    }
    Ok(ret)
}

// _BaseEntry.__unicode__
fn base_unicode(e: ref PoEntry, wrapwidth: i64) -> Result[String, PoErr] {
    let delflag = if e.obsolete { "#~ ".to_string() } else { String.new() };
    let mut ret: Vec[String] = Vec.new();
    match e.msgctxt {
        Some(c) => {
            for l in str_field("msgctxt", delflag, "", c, wrapwidth)?.into_iter() {
                ret.push(l);
            }
        }
        None => {}
    }
    for l in str_field("msgid", delflag, "", e.msgid, wrapwidth)?.into_iter() {
        ret.push(l);
    }
    if e.msgid_plural.len() > 0 {
        for l in str_field("msgid_plural", delflag, "", e.msgid_plural, wrapwidth)?.into_iter() {
            ret.push(l);
        }
    }
    if e.plural.len() > 0 {
        for k in plural_keys(e) {
            for l in str_field("msgstr", delflag, f"[{k}]", plural_at(e, k), wrapwidth)?.into_iter() {
                ret.push(l);
            }
        }
    } else {
        for l in str_field("msgstr", delflag, "", e.msgstr, wrapwidth)?.into_iter() {
            ret.push(l);
        }
    }
    ret.push(String.new());
    Ok(ret.join("\n"))
}

fn push_comments(ret: mut ref Vec[String], val: ref String, prefix: ref String, wrapwidth: i64) -> Result[(), PoErr] {
    if val.len() == 0 {
        return Ok(());
    }
    for comment in split_str(val, "\n") {
        if wrapwidth > 0 and clen(comment) + clen(prefix) > wrapwidth {
            for l in tw_wrap(comment, wrapwidth, prefix, prefix, true)?.into_iter() {
                ret.push(l);
            }
        } else {
            ret.push(f"{prefix}{comment}");
        }
    }
    Ok(())
}

// POEntry.__unicode__
fn entry_unicode(e: ref PoEntry, wrapwidth: i64) -> Result[String, PoErr] {
    let mut ret: Vec[String] = Vec.new();
    push_comments(mut ret, e.tcomment, "# ", wrapwidth)?;
    if not e.obsolete {
        push_comments(mut ret, e.comment, "#. ", wrapwidth)?;
    }
    if not e.obsolete and e.occurrences.len() > 0 {
        let mut files: Vec[String] = Vec.new();
        for o in e.occurrences {
            if o.1.len() > 0 {
                files.push(f"{o.0}:{o.1}");
            } else {
                files.push(o.0.clone());
            }
        }
        let filestr = files.join(" ");
        if wrapwidth > 0 and clen(filestr) + 3 > wrapwidth {
            // textwrap would break at the hyphens of a file name, so they
            // are swapped for a character a file name cannot hold.
            for l in tw_wrap(filestr.replace("-", "*"), wrapwidth, "#: ", "#: ", true)? {
                ret.push(l.replace("*", "-"));
            }
        } else {
            ret.push(f"#: {filestr}");
        }
    }
    if e.flags.len() > 0 {
        ret.push(f"#, {e.flags.join(", ")}");
    }
    let prefix = if e.obsolete { "#~| ".to_string() } else { "#| ".to_string() };
    match e.prev_ctxt {
        Some(v) => {
            for l in str_field("previous_msgctxt", prefix, "", v, wrapwidth)?.into_iter() {
                ret.push(l);
            }
        }
        None => {}
    }
    match e.prev_id {
        Some(v) => {
            for l in str_field("previous_msgid", prefix, "", v, wrapwidth)?.into_iter() {
                ret.push(l);
            }
        }
        None => {}
    }
    match e.prev_plural {
        Some(v) => {
            for l in str_field("previous_msgid_plural", prefix, "", v, wrapwidth)?.into_iter() {
                ret.push(l);
            }
        }
        None => {}
    }
    ret.push(base_unicode(e, wrapwidth)?);
    Ok(ret.join("\n"))
}

// POEntry.merge: take the template entry's ids, comments, occurrences and
// flags, keep the translation, the translator comment and a fuzzy flag.
fn entry_merge(e: mut ref PoEntry, other: ref PoEntry) {
    e.msgid = other.msgid.clone();
    e.msgctxt = other.msgctxt.clone();
    e.occurrences = other.occurrences.clone();
    e.comment = other.comment.clone();
    let fuzzy = is_fuzzy(e);
    e.flags = other.flags.clone();
    if fuzzy {
        e.flags.push("fuzzy".to_string());
    }
    e.msgid_plural = other.msgid_plural.clone();
    e.obsolete = other.obsolete;
    e.prev_ctxt = other.prev_ctxt.clone();
    e.prev_id = other.prev_id.clone();
    e.prev_plural = other.prev_plural.clone();
    for p in other.plural {
        if plural_pos(e, p.0) < 0 {
            e.plural.push((p.0, String.new()));
        }
    }
}

// ------------------------------------------------------------ catalogs

// A POFile or an MOFile.
struct Catalog {
    entries: Vec[PoEntry],
    header: String,
    // a dict: kept in insertion order
    metadata: Vec[(String, String)],
    // metadata_is_fuzzy: 0 until a header entry is found, then its flags
    meta_flags: Option[Vec[String]],
    fpath: Option[String],
    wrapwidth: i64,
    encoding: String,
    is_mo: bool,
    magic: i64,
    version: i64,
}

fn new_catalog(fpath: own Option[String], encoding: ref String, is_mo: bool) -> Catalog {
    Catalog {
        entries: Vec.new(),
        header: String.new(),
        metadata: Vec.new(),
        meta_flags: None,
        fpath: fpath,
        wrapwidth: 78,
        encoding: encoding.clone(),
        is_mo: is_mo,
        magic: -1,
        version: 0,
    }
}

fn meta_pos(cat: ref Catalog, k: ref String) -> i64 {
    for i in 0..cat.metadata.len() as i64 {
        if cat.metadata[i].0 == k {
            return i;
        }
    }
    -1
}

fn meta_set(cat: mut ref Catalog, k: ref String, v: ref String) {
    let p = meta_pos(cat, k);
    if p >= 0 {
        cat.metadata[p].1 = v.clone();
    } else {
        cat.metadata.push((k.clone(), v.clone()));
    }
}

fn meta_flags_repr(cat: ref Catalog) -> String {
    match cat.meta_flags {
        Some(f) => repr_list(f),
        None => "0".to_string(),
    }
}

fn meta_fuzzy(cat: ref Catalog) -> bool {
    match cat.meta_flags {
        Some(f) => f.len() > 0,
        None => false,
    }
}

const DATA_ORDER: Array[Str, 11] = [
    "Project-Id-Version",
    "Report-Msgid-Bugs-To",
    "POT-Creation-Date",
    "PO-Revision-Date",
    "Last-Translator",
    "Language-Team",
    "Language",
    "MIME-Version",
    "Content-Type",
    "Content-Transfer-Encoding",
    "Plural-Forms",
];

fn in_data_order(k: ref String) -> bool {
    for i in 0..11 {
        if k == DATA_ORDER[i] {
            return true;
        }
    }
    false
}

// The known fields in their order, then the rest naturally sorted.
fn ordered_metadata(cat: ref Catalog) -> Vec[(String, String)] {
    let mut out: Vec[(String, String)] = Vec.new();
    for i in 0..11 {
        let name = DATA_ORDER[i].to_string();
        let p = meta_pos(cat, name);
        if p >= 0 {
            out.push((name, cat.metadata[p].1.clone()));
        }
    }
    let mut rest: Vec[String] = Vec.new();
    for m in cat.metadata {
        if not in_data_order(m.0) {
            rest.push(m.0.clone());
        }
    }
    for k in natural_sort(rest).into_iter() {
        let p = meta_pos(cat, k);
        out.push((k, cat.metadata[p].1.clone()));
    }
    out
}

fn metadata_as_entry(cat: ref Catalog) -> PoEntry {
    let mut e = new_entry(None);
    let md = ordered_metadata(cat);
    if md.len() > 0 {
        let mut strs: Vec[String] = Vec.new();
        for m in md {
            strs.push(f"{m.0}: {m.1}");
        }
        e.msgstr = f"{strs.join("\n")}\n";
    }
    if meta_fuzzy(cat) {
        e.flags.push("fuzzy".to_string());
    }
    e
}

// _BaseFile.__unicode__, after POFile's header comment.
fn cat_unicode(cat: ref Catalog) -> Result[String, PoErr] {
    let mut ret = String.new();
    if not cat.is_mo {
        for h in split_str(cat.header, "\n") {
            if h.len() == 0 {
                ret.push_str("#\n");
            } else if h.starts_with(",") or h.starts_with(":") {
                ret.push_str(f"#{h}\n");
            } else {
                ret.push_str(f"# {h}\n");
            }
        }
    }
    let mut parts: Vec[String] = Vec.new();
    parts.push(entry_unicode(metadata_as_entry(cat), cat.wrapwidth)?);
    for e in cat.entries {
        if not e.obsolete {
            parts.push(entry_unicode(e, cat.wrapwidth)?);
        }
    }
    for e in cat.entries {
        if e.obsolete {
            parts.push(entry_unicode(e, cat.wrapwidth)?);
        }
    }
    ret.push_str(parts.join("\n"));
    Ok(ret)
}

// find()'s msgctxt argument: not given, None, or a context.
enum Ctx {
    Any,
    NoCtx,
    Is(String),
}

fn field_of(e: ref PoEntry, by: ref String) -> Option[String] {
    if by == "msgid" {
        Some(e.msgid.clone())
    } else if by == "msgstr" {
        Some(e.msgstr.clone())
    } else if by == "msgid_plural" {
        Some(e.msgid_plural.clone())
    } else if by == "msgctxt" {
        e.msgctxt.clone()
    } else {
        None
    }
}

fn ctx_matches(e: ref PoEntry, ctx: ref Ctx) -> bool {
    match ctx {
        Ctx.Any => true,
        Ctx.NoCtx => e.msgctxt.is_none(),
        Ctx.Is(c) => match e.msgctxt {
            Some(x) => x == c,
            None => false,
        },
    }
}

fn ctx_given_truthy(ctx: ref Ctx) -> bool {
    match ctx {
        Ctx.Is(c) => c.len() > 0,
        _ => false,
    }
}

// _BaseFile.find: the index of the entry, or -1.
fn find(cat: ref Catalog, st: ref String, by: ref String, include_obsolete: bool, ctx: ref Ctx) -> i64 {
    let mut matches: Vec[i64] = Vec.new();
    for i in 0..cat.entries.len() as i64 {
        let e = ref cat.entries[i];
        if e.obsolete and not include_obsolete {
            continue;
        }
        let hit = match field_of(e, by) {
            Some(v) => v == st,
            None => false,
        };
        if hit and ctx_matches(e, ctx) {
            matches.push(i);
        }
    }
    if matches.len() == 1 {
        return matches[0];
    }
    if matches.len() > 1 and not ctx_given_truthy(ctx) {
        // the entry with no context, else the first one
        let mut found = -1;
        for m in matches {
            if not ctx_truthy(cat.entries[m].msgctxt) {
                found = m;
            }
        }
        if found >= 0 {
            return found;
        }
        return matches[0];
    }
    -1
}

fn count_translated(cat: ref Catalog) -> i64 {
    if cat.is_mo {
        return cat.entries.len() as i64;
    }
    let mut n = 0;
    for e in cat.entries {
        if translated(e) {
            n += 1;
        }
    }
    n
}

fn count_untranslated(cat: ref Catalog) -> i64 {
    if cat.is_mo {
        return 0;
    }
    let mut n = 0;
    for e in cat.entries {
        if not translated(e) and not e.obsolete and not is_fuzzy(e) {
            n += 1;
        }
    }
    n
}

fn count_fuzzy(cat: ref Catalog) -> i64 {
    if cat.is_mo {
        return 0;
    }
    let mut n = 0;
    for e in cat.entries {
        if is_fuzzy(e) and not e.obsolete {
            n += 1;
        }
    }
    n
}

fn count_obsolete(cat: ref Catalog) -> i64 {
    if cat.is_mo {
        return 0;
    }
    let mut n = 0;
    for e in cat.entries {
        if e.obsolete {
            n += 1;
        }
    }
    n
}

fn percent_translated(cat: ref Catalog) -> i64 {
    if cat.is_mo {
        return 100;
    }
    let total = cat.entries.len() as i64 - count_obsolete(cat);
    if total == 0 {
        return 100;
    }
    count_translated(cat) * 100 / total
}

// POFile.merge, as msgmerge does it: every template entry updates its
// match (or a new entry at the end), and what the template lacks becomes
// obsolete.
fn merge(cat: mut ref Catalog, refpot: ref Catalog) {
    let mut index: Map[String, i64] = Map.new();
    for i in 0..cat.entries.len() as i64 {
        index.insert(ctx_key(cat.entries[i]), i);
    }
    let mut keys: Map[String, bool] = Map.new();
    for e in refpot.entries {
        keys.insert(ctx_key(e), true);
    }
    for e in refpot.entries {
        let at = match index.get(ctx_key(e)) {
            Some(i) => *i,
            None => {
                cat.entries.push(new_entry(None));
                cat.entries.len() as i64 - 1
            }
        };
        entry_merge(mut cat.entries[at], e);
    }
    for i in 0..cat.entries.len() as i64 {
        if not keys.contains_key(ctx_key(cat.entries[i])) {
            cat.entries[i].obsolete = true;
        }
    }
}

// ------------------------------------------------------------ encodings

const ENC_UTF8: i64 = 0;
const ENC_LATIN1: i64 = 1;
const ENC_ASCII: i64 = 2;

// encodings.normalize_encoding after codecs.lookup's lower-casing.
fn normalize_encoding(name: ref String) -> String {
    let mut out = String.new();
    let mut punct = false;
    for c in name.to_lowercase().chars() {
        if c.is_alphanumeric() or c == '.' {
            if punct and out.len() > 0 {
                out.push('_');
            }
            if (c as u32) < 128 {
                out.push(c);
            }
            punct = false;
        } else {
            punct = true;
        }
    }
    out
}

// The codec behind a name codecs.lookup knows, or -1: the UTF-8, Latin-1
// and ASCII families with their aliases.
fn codec_of(name: ref String) -> i64 {
    let n = normalize_encoding(name);
    let utf8 = ["utf_8", "utf8", "u8", "utf", "utf8_ucs2", "utf8_ucs4", "cp65001"];
    let latin1 = ["latin_1", "latin1", "latin", "l1", "iso_8859_1", "iso8859_1", "iso_8859_1_1987", "iso_ir_100", "8859", "cp819", "ibm819", "csisolatin1"];
    let ascii = ["ascii", "us_ascii", "646", "us", "ansi_x3.4_1968", "ansi_x3_4_1968", "ansi_x3.4_1986", "cp367", "csascii", "ibm367", "iso646_us", "iso_646.irv_1991", "iso_ir_6"];
    for a in utf8 {
        if n == a {
            return ENC_UTF8;
        }
    }
    for a in latin1 {
        if n == a {
            return ENC_LATIN1;
        }
    }
    for a in ascii {
        if n == a {
            return ENC_ASCII;
        }
    }
    -1
}

fn push_utf8(out: mut ref Vec[u8], u: i64) {
    if u < 128 {
        out.push(u as u8);
    } else if u < 2048 {
        out.push((0xC0 | (u >> 6)) as u8);
        out.push((0x80 | (u & 0x3F)) as u8);
    } else if u < 65536 {
        out.push((0xE0 | (u >> 12)) as u8);
        out.push((0x80 | ((u >> 6) & 0x3F)) as u8);
        out.push((0x80 | (u & 0x3F)) as u8);
    } else {
        out.push((0xF0 | (u >> 18)) as u8);
        out.push((0x80 | ((u >> 12) & 0x3F)) as u8);
        out.push((0x80 | ((u >> 6) & 0x3F)) as u8);
        out.push((0x80 | (u & 0x3F)) as u8);
    }
}

fn decode(enc: ref String, b: ref Vec[u8]) -> Result[String, PoErr] {
    let codec = codec_of(enc);
    if codec == ENC_UTF8 {
        return match String.from_utf8(b.clone()) {
            Ok(s) => Ok(s),
            Err(_) => Err(err("UnicodeDecodeError", f"'utf-8' codec can't decode the data")),
        };
    }
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() as i64 {
        let x = b[i] as i64;
        if codec == ENC_ASCII and x >= 128 {
            return Err(err("UnicodeDecodeError", f"'ascii' codec can't decode byte 0x{hex_digits(x, 2)} in position {i}: ordinal not in range(128)"));
        }
        push_utf8(mut out, x);
    }
    Ok(String.from_utf8(out).unwrap())
}

fn encode(enc: ref String, s: ref String) -> Result[Vec[u8], PoErr] {
    let codec = codec_of(enc);
    if codec == ENC_UTF8 {
        return Ok(s.bytes().to_vec());
    }
    let limit = if codec == ENC_ASCII { 128 } else { 256 };
    let name = if codec == ENC_ASCII { "ascii" } else { "latin-1" };
    let mut out: Vec[u8] = Vec.new();
    let mut pos = 0;
    for c in s.chars() {
        let u = c as u32 as i64;
        if u >= limit {
            return Err(err("UnicodeEncodeError", f"'{name}' codec can't encode character {py_repr(c.to_string())} in position {pos}: ordinal not in range({limit})"));
        }
        out.push(u as u8);
        pos += 1;
    }
    Ok(out)
}

fn is_file(path: ref String) -> bool {
    fs.exists(path)
}

fn read_file(path: ref String) -> Result[Vec[u8], PoErr] {
    match fs.read_bytes(path.clone()) {
        Ok(b) => Ok(b),
        Err(_) => Err(err("FileNotFoundError", f"[Errno 2] No such file or directory: {py_repr(path)}")),
    }
}

fn write_file(path: ref String, b: ref Vec[u8]) -> Result[(), PoErr] {
    match fs.write_bytes(path.clone(), b.clone()) {
        Ok(_) => Ok(()),
        Err(_) => Err(err("OSError", f"could not write {path}")),
    }
}

fn is_charset_byte(x: u8) -> bool {
    (x >= b'a' and x <= b'z') or (x >= b'A' and x <= b'Z') or (x >= b'0' and x <= b'9') or x == b'_' or x == b'-' or x == b':' or x == b'.'
}

fn bytes_at(b: ref Vec[u8], at: i64, lit: ref String) -> bool {
    let l: Vec[u8] = lit.bytes().to_vec();
    if at + l.len() as i64 > b.len() as i64 {
        return false;
    }
    for k in 0..l.len() as i64 {
        if b[at + k] != l[k] {
            return false;
        }
    }
    true
}

// The first match of '"?Content-Type:.+? charset=([\w_\-:\.]+)' in
// b[lo..hi]: the captured charset.
fn charset_match(b: ref Vec[u8], lo: i64, hi: i64) -> Option[String] {
    let mut p = lo;
    while p < hi {
        if bytes_at(b, p, "Content-Type:") {
            // .+? : at least one character that is not a newline, as few
            // as can be.
            let mut q = p + 14;
            while q <= hi and b[q - 1] != b'\n' {
                if q + 9 < hi and bytes_at(b, q, " charset=") and is_charset_byte(b[q + 9]) {
                    let mut r = q + 9;
                    while r < hi and is_charset_byte(b[r]) {
                        r += 1;
                    }
                    return Some(String.from_utf8(b[q + 9..r].to_vec()).unwrap());
                }
                q += 1;
            }
        }
        p += 1;
    }
    None
}

// polib.detect_encoding for a path (read line by line, as bytes) or for
// the contents themselves.
fn detect_encoding(arg: ref String) -> String {
    if not is_file(arg) {
        let b: Vec[u8] = arg.bytes().to_vec();
        match charset_match(b, 0, b.len() as i64) {
            Some(c) => {
                let enc = py_strip(c);
                if codec_of(enc) >= 0 {
                    return enc;
                }
            }
            None => {}
        }
        return "utf-8".to_string();
    }
    let b = match read_file(arg) {
        Ok(b) => b,
        Err(_) => return "utf-8".to_string(),
    };
    let n = b.len() as i64;
    let mut start = 0;
    while start < n {
        let mut end = start;
        while end < n and b[end] != b'\n' {
            end += 1;
        }
        if end < n {
            end += 1;
        }
        match charset_match(b, start, end) {
            Some(c) => {
                let enc = py_strip(c);
                if codec_of(enc) >= 0 {
                    return enc;
                }
            }
            None => {}
        }
        start = end;
    }
    "utf-8".to_string()
}

// ------------------------------------------------------------ the PO parser

// The state machine's transitions: the next state for a symbol read in a
// state, or "" for none.
fn transition(sym: ref String, st: ref String) -> String {
    let all = ["st", "he", "gc", "oc", "fl", "ct", "pc", "pm", "pp", "tc", "ms", "mp", "mx", "mi"].to_vec();
    let mut from: Vec[String] = Vec.new();
    let mut next = sym.clone();
    if sym == "tc" {
        if st == "st" or st == "he" {
            return "he".to_string();
        }
        from = ["gc", "oc", "fl", "tc", "pc", "pm", "pp", "ms", "mp", "mx", "mi"].to_vec();
    } else if sym == "gc" or sym == "oc" or sym == "fl" or sym == "pc" or sym == "pm" or sym == "pp" {
        from = all;
    } else if sym == "ct" {
        from = ["st", "he", "gc", "oc", "fl", "tc", "pc", "pm", "pp", "ms", "mx"].to_vec();
    } else if sym == "mi" {
        from = ["st", "he", "gc", "oc", "fl", "ct", "tc", "pc", "pm", "pp", "ms", "mx"].to_vec();
    } else if sym == "mp" {
        from = ["tc", "gc", "pc", "pm", "pp", "mi"].to_vec();
    } else if sym == "ms" {
        from = ["mi", "mp", "tc"].to_vec();
    } else if sym == "mx" {
        from = ["mi", "mx", "mp", "tc"].to_vec();
    } else if sym == "mc" {
        from = ["ct", "mi", "mp", "ms", "mx", "pm", "pp", "pc"].to_vec();
    } else {
        next = String.new();
    }
    for s in from {
        if st == s {
            return next;
        }
    }
    String.new()
}

struct PoParser {
    cat: Catalog,
    cur: PoEntry,
    state: String,
    token: String,
    msgstr_index: i64,
    entry_obsolete: bool,
    line: i64,
}

impl PoParser {
    fn fpath_prefix(ref self) -> String {
        match self.cat.fpath {
            Some(p) => f"{p} ",
            None => String.new(),
        }
    }

    fn syntax(ref self, what: ref String) -> PoErr {
        err("OSError", f"Syntax error in po file {self.fpath_prefix()}(line {self.line}){what}")
    }

    // Starts a new entry when the last one is complete.
    fn close_entry(mut ref self) {
        if self.state == "mc" or self.state == "ms" or self.state == "mx" {
            self.cat.entries.push(self.cur.clone());
            self.cur = new_entry(Some(self.line));
        }
    }

    // The handler of the state the transition goes to: Ok(true) moves the
    // machine there, Err is any exception, which process() reports as a
    // syntax error.
    fn handle(mut ref self, next: ref String) -> Result[bool, ()] {
        let token = self.token.clone();
        if next == "he" {
            if self.cat.header != "" {
                self.cat.header.push_str("\n");
            }
            self.cat.header.push_str(cfrom(token, 2));
            return Ok(true);
        }
        if next == "mp" {
            self.cur.msgid_plural = unescape(inner(token));
            return Ok(true);
        }
        if next == "ms" {
            self.cur.msgstr = unescape(inner(token));
            return Ok(true);
        }
        if next == "mx" {
            let v = chars(token);
            if v.len() <= 7 or not v[7].is_ascii_digit() {
                return Err(());
            }
            let index = (v[7] as u32 as i64) - 48;
            let q = match token.find("\"") {
                Some(i) => clen(token.substring(0, i)) + 1,
                None => 0,
            };
            let value = cslice(token, q, clen(token) - 1);
            plural_set(mut self.cur, index, unescape(value));
            self.msgstr_index = index;
            return Ok(true);
        }
        if next == "mc" {
            let t = unescape(inner(token));
            let st = self.state.clone();
            if st == "ct" {
                self.cur.msgctxt = Some(f"{ctx_text(self.cur.msgctxt)}{t}");
            } else if st == "mi" {
                self.cur.msgid.push_str(t);
            } else if st == "mp" {
                self.cur.msgid_plural.push_str(t);
            } else if st == "ms" {
                self.cur.msgstr.push_str(t);
            } else if st == "mx" {
                let k = self.msgstr_index;
                let p = plural_pos(self.cur, k);
                if p < 0 {
                    return Err(());
                }
                self.cur.plural[p].1.push_str(t);
            } else if st == "pp" {
                self.cur.prev_plural = Some(f"{ctx_text(self.cur.prev_plural)}{t}");
            } else if st == "pm" {
                self.cur.prev_id = Some(f"{ctx_text(self.cur.prev_id)}{t}");
            } else if st == "pc" {
                self.cur.prev_ctxt = Some(f"{ctx_text(self.cur.prev_ctxt)}{t}");
            }
            return Ok(false);
        }
        self.close_entry();
        if next == "tc" {
            if self.cur.tcomment != "" {
                self.cur.tcomment.push_str("\n");
            }
            let mut v = chars(token);
            let mut k = 0;
            while k < v.len() and v[k] == '#' {
                k += 1;
            }
            if k < v.len() and v[k] == ' ' {
                k += 1;
            }
            v = v[k..].to_vec();
            self.cur.tcomment.push_str(text(v));
        } else if next == "gc" {
            if self.cur.comment != "" {
                self.cur.comment.push_str("\n");
            }
            self.cur.comment.push_str(cfrom(token, 3));
        } else if next == "oc" {
            for occ in split_ws(cfrom(token, 3), -1) {
                match occ.rfind(":") {
                    Some(i) => {
                        let fil = occ.substring(0, i);
                        let line = occ.substring(i + 1, occ.len());
                        if is_ascii_digits(line) {
                            self.cur.occurrences.push((fil, line));
                        } else {
                            self.cur.occurrences.push((occ.clone(), String.new()));
                        }
                    }
                    None => self.cur.occurrences.push((occ.clone(), String.new())),
                }
            }
        } else if next == "fl" {
            for c in split_str(cfrom(token, 3), ",") {
                self.cur.flags.push(py_strip(c));
            }
        } else if next == "pp" {
            self.cur.prev_plural = Some(unescape(inner(token)));
        } else if next == "pm" {
            self.cur.prev_id = Some(unescape(inner(token)));
        } else if next == "pc" {
            self.cur.prev_ctxt = Some(unescape(inner(token)));
        } else if next == "ct" {
            self.cur.msgctxt = Some(unescape(inner(token)));
        } else if next == "mi" {
            self.cur.obsolete = self.entry_obsolete;
            self.cur.msgid = unescape(inner(token));
        }
        Ok(true)
    }

    fn process(mut ref self, sym: ref String) -> Result[(), PoErr] {
        let next = transition(sym, self.state);
        if next == "" {
            return Err(self.syntax(""));
        }
        match self.handle(next) {
            Ok(true) => {
                self.state = next;
                Ok(())
            }
            Ok(false) => Ok(()),
            Err(_) => Err(self.syntax("")),
        }
    }
}

fn keyword_symbol(t: ref String) -> String {
    if t == "msgctxt" {
        "ct".to_string()
    } else if t == "msgid" {
        "mi".to_string()
    } else if t == "msgstr" {
        "ms".to_string()
    } else if t == "msgid_plural" {
        "mp".to_string()
    } else {
        String.new()
    }
}

fn prev_symbol(t: ref String) -> String {
    if t == "msgid_plural" {
        "pp".to_string()
    } else if t == "msgid" {
        "pm".to_string()
    } else if t == "msgctxt" {
        "pc".to_string()
    } else {
        String.new()
    }
}

// Python's text-mode newline translation.
fn universal_newlines(s: ref String) -> String {
    s.replace("\r\n", "\n").replace("\r", "\n")
}

// polib.pofile: a path, or the contents of a PO file.
fn pofile(arg: ref String, wrapwidth: i64) -> Result[Catalog, PoErr] {
    let enc = detect_encoding(arg);
    let mut lines: Vec[String] = Vec.new();
    let mut fpath: Option[String] = None;
    if is_file(arg) {
        let t = universal_newlines(decode(enc, read_file(arg)?)?);
        lines = split_str(t, "\n");
        if lines.len() > 0 and lines[lines.len() - 1] == "" {
            lines.pop();
        }
        fpath = Some(arg.clone());
    } else {
        lines = splitlines(arg, false);
    }
    let mut p = PoParser {
        cat: new_catalog(fpath, enc, false),
        cur: new_entry(Some(0)),
        state: "st".to_string(),
        token: String.new(),
        msgstr_index: 0,
        entry_obsolete: false,
        line: 0,
    };
    let mut tokens: Vec[String] = Vec.new();
    for raw in lines {
        p.line += 1;
        let mut line = raw.clone();
        if p.line == 1 and line.starts_with("\u{feff}") {
            line = cfrom(line, 1);
        }
        line = py_strip(line);
        if line == "" {
            continue;
        }
        tokens = split_ws(line, 2);
        if tokens[0] == "#~|" {
            continue;
        }
        if tokens[0] == "#~" and tokens.len() > 1 {
            line = py_strip(cfrom(line, 3));
            tokens.remove(0);
            p.entry_obsolete = true;
        } else {
            p.entry_obsolete = false;
        }
        let nb = tokens.len();
        let kw = keyword_symbol(tokens[0]);
        if kw != "" and nb > 1 {
            line = py_lstrip(cfrom(line, clen(tokens[0])));
            if unescaped_quote(inner(line)) {
                return Err(p.syntax(": unescaped double quote found"));
            }
            p.token = line.clone();
            p.process(kw)?;
            continue;
        }
        p.token = line.clone();
        if tokens[0] == "#:" {
            if nb <= 1 {
                continue;
            }
            p.process("oc")?;
        } else if line.starts_with("\"") {
            if unescaped_quote(inner(line)) {
                return Err(p.syntax(": unescaped double quote found"));
            }
            p.process("mc")?;
        } else if line.starts_with("msgstr[") {
            p.process("mx")?;
        } else if tokens[0] == "#," {
            if nb <= 1 {
                continue;
            }
            p.process("fl")?;
        } else if tokens[0] == "#" or tokens[0].starts_with("##") {
            if line == "#" {
                p.token = "# ".to_string();
            }
            p.process("tc")?;
        } else if tokens[0] == "#." {
            if nb <= 1 {
                continue;
            }
            p.process("gc")?;
        } else if tokens[0] == "#|" {
            if nb <= 1 {
                return Err(p.syntax(""));
            }
            line = py_lstrip(cfrom(line, 2));
            p.token = line.clone();
            if tokens[1].starts_with("\"") {
                p.process("mc")?;
                continue;
            }
            if nb == 2 {
                return Err(p.syntax(": invalid continuation line"));
            }
            let ps = prev_symbol(tokens[1]);
            if ps == "" {
                return Err(p.syntax(f": unknown keyword {tokens[1]}"));
            }
            line = py_lstrip(cfrom(line, clen(tokens[1])));
            p.token = line.clone();
            p.process(ps)?;
        } else {
            return Err(p.syntax(""));
        }
    }
    if tokens.len() > 0 and not tokens[0].starts_with("#") {
        p.cat.entries.push(p.cur.clone());
    }
    let mut cat = p.cat;
    // The header entry becomes the metadata.
    let m = find(cat, "", "msgid", false, Ctx.Any);
    if m >= 0 {
        let meta = cat.entries[m].clone();
        let mut at = 0;
        while entry_cmp(cat.entries[at], meta) != 0 {
            at += 1;
        }
        cat.entries.remove(at);
        cat.meta_flags = Some(meta.flags.clone());
        let mut key: Option[String] = None;
        for msg in splitlines(meta.msgstr, false) {
            match msg.find(":") {
                Some(i) => {
                    let k = msg.substring(0, i);
                    meta_set(mut cat, k, py_strip(msg.substring(i + 1, msg.len())));
                    key = Some(k);
                }
                None => {
                    match key {
                        Some(ref k) => {
                            let p = meta_pos(cat, k);
                            cat.metadata[p].1.push_str(f"\n{py_strip(msg)}");
                        }
                        None => {}
                    }
                }
            }
        }
    }
    cat.wrapwidth = wrapwidth;
    Ok(cat)
}

// ------------------------------------------------------------ MO files

const MO_MAGIC: i64 = 2500072158;
const MO_MAGIC_SWAPPED: i64 = 3725722773;

fn push_u32(out: mut ref Vec[u8], v: i64) {
    out.push((v & 255) as u8);
    out.push(((v >> 8) & 255) as u8);
    out.push(((v >> 16) & 255) as u8);
    out.push(((v >> 24) & 255) as u8);
}

fn append(out: mut ref Vec[u8], b: ref Vec[u8]) {
    for x in b {
        out.push(*x);
    }
}

fn cmp_bytes(a: ref Vec[u8], b: ref Vec[u8]) -> i64 {
    let n = if a.len() < b.len() { a.len() } else { b.len() };
    for i in 0..n as i64 {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 };
        }
    }
    if a.len() < b.len() {
        -1
    } else if a.len() > b.len() {
        1
    } else {
        0
    }
}

// _BaseFile.to_binary: the translated entries sorted by their UTF-8
// msgid_with_context, after the header entry, with no hash table. An
// MOFile's translated entries are the file itself, so it is sorted in
// place.
fn to_binary(cat: mut ref Catalog) -> Result[Vec[u8], PoErr] {
    let mut list: Vec[PoEntry] = Vec.new();
    for e in cat.entries {
        if cat.is_mo or translated(e) {
            list.push(e.clone());
        }
    }
    let mut keyed: Vec[(Vec[u8], i64)] = Vec.new();
    for i in 0..list.len() as i64 {
        let k: Vec[u8] = ctx_key(list[i]).bytes().to_vec();
        keyed.push((k, i));
    }
    keyed.sort_by(|a, b| {
        let c = cmp_bytes(a.0, b.0);
        if c != 0 { c.cmp(0) } else { a.1.cmp(b.1) }
    });
    let mut sorted: Vec[PoEntry] = Vec.new();
    for k in keyed {
        sorted.push(list[k.1].clone());
    }
    if cat.is_mo {
        cat.entries = sorted.clone();
    }
    let mut entries: Vec[PoEntry] = Vec.new();
    entries.push(metadata_as_entry(cat));
    for e in sorted.into_iter() {
        entries.push(e);
    }
    let n = entries.len() as i64;
    let mut ids: Vec[u8] = Vec.new();
    let mut strs: Vec[u8] = Vec.new();
    let mut offsets: Vec[(i64, i64, i64, i64)] = Vec.new();
    for e in entries {
        let mut msgid: Vec[u8] = Vec.new();
        if ctx_truthy(e.msgctxt) {
            msgid = encode(cat.encoding, f"{ctx_text(e.msgctxt)}\u{4}")?;
        }
        let mut msgstr: Vec[u8] = Vec.new();
        if e.msgid_plural.len() > 0 {
            let mut parts: Vec[String] = Vec.new();
            for k in plural_keys(e) {
                parts.push(plural_at(e, k));
            }
            append(mut msgid, encode(cat.encoding, f"{e.msgid}\u{0}{e.msgid_plural}")?);
            msgstr = encode(cat.encoding, parts.join("\u{0}"))?;
        } else {
            append(mut msgid, encode(cat.encoding, e.msgid)?);
            msgstr = encode(cat.encoding, e.msgstr)?;
        }
        offsets.push((ids.len() as i64, msgid.len() as i64, strs.len() as i64, msgstr.len() as i64));
        append(mut ids, msgid);
        ids.push(0);
        append(mut strs, msgstr);
        strs.push(0);
    }
    let keystart = 7 * 4 + 16 * n;
    let valuestart = keystart + ids.len() as i64;
    let mut out: Vec[u8] = Vec.new();
    push_u32(mut out, MO_MAGIC);
    push_u32(mut out, 0);
    push_u32(mut out, n);
    push_u32(mut out, 7 * 4);
    push_u32(mut out, 7 * 4 + n * 8);
    push_u32(mut out, 0);
    push_u32(mut out, keystart);
    for o in offsets {
        push_u32(mut out, o.1);
        push_u32(mut out, o.0 + keystart);
    }
    for o in offsets {
        push_u32(mut out, o.3);
        push_u32(mut out, o.2 + valuestart);
    }
    append(mut out, ids);
    append(mut out, strs);
    Ok(out)
}

// _BaseFile.save: the text in the file's encoding.
fn save(cat: ref Catalog, path: ref String) -> Result[(), PoErr] {
    let t = cat_unicode(cat)?;
    write_file(path, encode(cat.encoding, t)?)
}

fn save_binary(cat: mut ref Catalog, path: ref String) -> Result[(), PoErr] {
    let b = to_binary(mut cat)?;
    write_file(path, b)
}

fn short_read(n: i64) -> PoErr {
    err("error", f"unpack requires a buffer of {n} bytes")
}

fn u32_at(b: ref Vec[u8], at: i64, big: bool) -> Result[i64, PoErr] {
    if at < 0 or at + 4 > b.len() as i64 {
        return Err(short_read(4));
    }
    let x0 = b[at] as i64;
    let x1 = b[at + 1] as i64;
    let x2 = b[at + 2] as i64;
    let x3 = b[at + 3] as i64;
    if big {
        Ok((x0 << 24) | (x1 << 16) | (x2 << 8) | x3)
    } else {
        Ok((x3 << 24) | (x2 << 16) | (x1 << 8) | x0)
    }
}

// file.read(n) after a seek: what is there, up to n bytes.
fn read_at(b: ref Vec[u8], at: i64, n: i64) -> Vec[u8] {
    let len = b.len() as i64;
    if at >= len {
        return Vec.new();
    }
    let end = if at + n > len { len } else { at + n };
    b[at..end].to_vec()
}

fn split_byte(b: ref Vec[u8], sep: u8) -> Vec[Vec[u8]] {
    let mut out: Vec[Vec[u8]] = Vec.new();
    let mut cur: Vec[u8] = Vec.new();
    for x in b {
        if *x == sep {
            out.push(cur);
            cur = Vec.new();
        } else {
            cur.push(*x);
        }
    }
    out.push(cur);
    out
}

// _MOFileParser._build_entry
fn build_mo_entry(enc: ref String, msgid: ref Vec[u8], msgstr: ref Vec[u8], msgid_plural: ref Vec[u8], plurals: ref Vec[Vec[u8]]) -> Result[PoEntry, PoErr] {
    let mut e = new_entry(None);
    let parts = split_byte(msgid, 4);
    if parts.len() > 1 {
        e.msgctxt = Some(decode(enc, parts[0])?);
        e.msgid = decode(enc, parts[1])?;
    } else {
        e.msgid = decode(enc, msgid)?;
    }
    if msgstr.len() > 0 {
        e.msgstr = decode(enc, msgstr)?;
    }
    if msgid_plural.len() > 0 {
        e.msgid_plural = decode(enc, msgid_plural)?;
    }
    for k in 0..plurals.len() as i64 {
        e.plural.push((k, decode(enc, plurals[k])?));
    }
    Ok(e)
}

// polib.mofile
fn mofile(path: ref String) -> Result[Catalog, PoErr] {
    let enc = detect_encoding(path);
    let b = read_file(path)?;
    let mut cat = new_catalog(Some(path.clone()), enc, true);
    let magic = u32_at(b, 0, false)?;
    let big = if magic == MO_MAGIC {
        false
    } else if magic == MO_MAGIC_SWAPPED {
        true
    } else {
        return Err(err("OSError", "Invalid mo file, magic number is incorrect !"));
    };
    cat.magic = magic;
    let version = u32_at(b, 4, big)?;
    let count = u32_at(b, 8, big)?;
    let major = version >> 16;
    if major != 0 and major != 1 {
        return Err(err("OSError", "Invalid mo file, unexpected major revision number"));
    }
    cat.version = version;
    let ids_at = u32_at(b, 12, big)?;
    let strs_at = u32_at(b, 16, big)?;
    for i in 0..count {
        let id_len = u32_at(b, ids_at + 8 * i, big)?;
        let id_off = u32_at(b, ids_at + 8 * i + 4, big)?;
        let str_len = u32_at(b, strs_at + 8 * i, big)?;
        let str_off = u32_at(b, strs_at + 8 * i + 4, big)?;
        let msgid = read_at(b, id_off, id_len);
        let msgstr = read_at(b, str_off, str_len);
        if i == 0 and msgid.len() == 0 {
            // the header entry
            let mut md: Vec[(String, String)] = Vec.new();
            for line in split_byte(msgstr, b'\n') {
                let tokens = split_byte_once(line, b':');
                if tokens[0].len() > 0 {
                    let k = decode(enc, tokens[0])?;
                    let v = if tokens.len() > 1 { py_strip(decode(enc, tokens[1])?) } else { String.new() };
                    let mut found = false;
                    for j in 0..md.len() as i64 {
                        if md[j].0 == k {
                            md[j].1 = v.clone();
                            found = true;
                        }
                    }
                    if not found {
                        md.push((k, v));
                    }
                }
            }
            cat.metadata = md;
            continue;
        }
        let id_parts = split_byte(msgid, 0);
        let e = if id_parts.len() > 1 {
            build_mo_entry(enc, id_parts[0], Vec.new(), id_parts[1], split_byte(msgstr, 0))?
        } else {
            build_mo_entry(enc, msgid, msgstr, Vec.new(), Vec.new())?
        };
        cat.entries.push(e);
    }
    Ok(cat)
}

// bytes.split(sep, 1)
fn split_byte_once(b: ref Vec[u8], sep: u8) -> Vec[Vec[u8]] {
    for i in 0..b.len() as i64 {
        if b[i] == sep {
            return [b[0..i].to_vec(), b[i + 1..].to_vec()].to_vec();
        }
    }
    [b.clone()].to_vec()
}

// ------------------------------------------------------------ the jobs

const MASK32: i64 = 4294967295;

fn fnv(b: ref Vec[u8]) -> i64 {
    let mut h = 2166136261;
    for x in b {
        h = ((h ^ (*x as i64)) * 16777619) & MASK32;
    }
    h
}

fn markers(s: ref String) -> String {
    s.replace("⏎", "\n").replace("⇥", "\t")
}

fn opt_repr(o: ref Option[String]) -> String {
    match o {
        Some(s) => py_repr(s),
        None => "None".to_string(),
    }
}

fn entry_line(e: ref PoEntry) -> String {
    let mut parts: Vec[String] = Vec.new();
    match e.msgctxt {
        Some(c) => parts.push(f"ctx={py_repr(c)}"),
        None => {}
    }
    parts.push(f"id={py_repr(e.msgid)}");
    if e.msgid_plural.len() > 0 {
        parts.push(f"plural={py_repr(e.msgid_plural)}");
    }
    if e.plural.len() > 0 {
        for k in plural_keys(e) {
            parts.push(f"[{k}]={py_repr(plural_at(e, k))}");
        }
    } else {
        parts.push(f"str={py_repr(e.msgstr)}");
    }
    if e.flags.len() > 0 {
        parts.push(f"flags={repr_list(e.flags)}");
    }
    if e.occurrences.len() > 0 {
        let o = ref e.occurrences[0];
        parts.push(f"occ={e.occurrences.len()} first=({py_repr(o.0)}, {py_repr(o.1)})");
    }
    if e.tcomment.len() > 0 {
        parts.push(f"tc={py_repr(e.tcomment)}");
    }
    if e.comment.len() > 0 {
        parts.push(f"gc={py_repr(e.comment)}");
    }
    if e.prev_ctxt.is_some() {
        parts.push(f"prev_ctx={opt_repr(e.prev_ctxt)}");
    }
    if e.prev_id.is_some() {
        parts.push(f"prev_id={opt_repr(e.prev_id)}");
    }
    if e.prev_plural.is_some() {
        parts.push(f"prev_plural={opt_repr(e.prev_plural)}");
    }
    if e.obsolete {
        parts.push("obsolete".to_string());
    }
    match e.linenum {
        Some(n) => parts.push(f"line {n}"),
        None => {}
    }
    parts.join(" ")
}

fn stats(cat: ref Catalog) -> String {
    f"{percent_translated(cat)}% translated; translated {count_translated(cat)}, untranslated {count_untranslated(cat)}, fuzzy {count_fuzzy(cat)}, obsolete {count_obsolete(cat)}; {cat.entries.len()} entries; header flags {meta_flags_repr(cat)}, encoding {cat.encoding}"
}

fn show_text(out: mut ref String, t: ref String) {
    for line in split_str(t, "\n") {
        out.push_str(f"  |{line}\n");
    }
}

fn mo_header(b: ref Vec[u8]) -> String {
    if b.len() < 28 {
        return "short".to_string();
    }
    let mut vals: Vec[String] = Vec.new();
    for k in 0..7 {
        vals.push(f"{u32_at(b, 4 * k, false) ?? 0}");
    }
    vals.join(" ")
}

fn field(f: ref Vec[String], i: i64) -> String {
    if i < f.len() as i64 { f[i].clone() } else { String.new() }
}

fn to_width(s: ref String) -> i64 {
    match i64.parse(s) {
        Ok(v) => v,
        Err(_) => 78,
    }
}

fn job(f: ref Vec[String], out: mut ref String) -> Result[(), PoErr] {
    let cmd = f[0].clone();
    let a = field(f, 1);
    if cmd == "detect" {
        out.push_str(f"{detect_encoding(a)}\n");
    } else if cmd == "stats" {
        out.push_str(f"{stats(pofile(a, 78)?)}\n");
    } else if cmd == "metadata" {
        let po = pofile(a, 78)?;
        for m in ordered_metadata(po) {
            out.push_str(f"  {m.0}: {py_repr(m.1)}\n");
        }
    } else if cmd == "entries" {
        let po = pofile(a, 78)?;
        for e in po.entries {
            out.push_str(f"  {entry_line(e)}\n");
        }
    } else if cmd == "find" or cmd == "find-all" {
        let po = pofile(a, 78)?;
        let ctx = if f.len() > 4 { Ctx.Is(f[4].clone()) } else { Ctx.Any };
        let i = find(po, f[3], f[2], cmd == "find-all", ctx);
        if i >= 0 {
            out.push_str(f"{entry_line(po.entries[i])}\n");
        } else {
            out.push_str("None\n");
        }
    } else if cmd == "contains" {
        let po = pofile(a, 78)?;
        let ctx = if f.len() > 3 { Ctx.Is(f[3].clone()) } else { Ctx.NoCtx };
        out.push_str(f"{py_bool(find(po, f[2], "msgid", false, ctx) >= 0)}\n");
    } else if cmd == "roundtrip" {
        let po = pofile(a, 78)?;
        let mut t = decode(po.encoding, read_file(a)?)?;
        if t.starts_with("\u{feff}") {
            t = cfrom(t, 1);
        }
        let w = cat_unicode(po)?;
        if w == t {
            out.push_str("same\n");
        } else {
            let x = split_str(w, "\n");
            let y = split_str(t, "\n");
            let mut k = 0;
            while k < x.len() and k < y.len() and x[k] == y[k] {
                k += 1;
            }
            let nx = if k < x.len() { py_repr(x[k]) } else { "None".to_string() };
            let ny = if k < y.len() { py_repr(y[k]) } else { "None".to_string() };
            out.push_str(f"differs: {x.len()} lines written, {y.len()} read; first at line {k + 1}: {nx} for {ny}\n");
        }
    } else if cmd == "print" {
        let po = pofile(a, to_width(f[2]))?;
        show_text(mut out, cat_unicode(po)?);
    } else if cmd == "fuzzy" {
        let mut po = pofile(a, 78)?;
        let i = find(po, f[2], "msgid", false, Ctx.Any);
        if i < 0 {
            return Err(err("AttributeError", "'NoneType' object has no attribute 'fuzzy'"));
        }
        set_fuzzy(mut po.entries[i], f[3] == "on");
        let e = ref po.entries[i];
        out.push_str(f"flags {repr_list(e.flags)}; translated {py_bool(translated(e))}; {percent_translated(po)}% translated\n");
        show_text(mut out, entry_unicode(e, 78)?);
    } else if cmd == "merge" {
        let mut po = pofile(a, 78)?;
        let pot = pofile(f[2], 78)?;
        merge(mut po, pot);
        save(po, f[3])?;
        out.push_str(f"{stats(po)}\n");
        let b = read_file(f[3])?;
        out.push_str(f"wrote {f[3]}: {b.len()} bytes, fnv {fnv(b):08x}\n");
        if a.ends_with("pt_BR.po") {
            show_text(mut out, decode("utf-8", b)?);
        }
        for e in po.entries {
            if e.obsolete {
                out.push_str(f"  obsolete {entry_line(e)}\n");
            }
        }
    } else if cmd == "sort" {
        let po = pofile(a, 78)?;
        let mut idx: Vec[i64] = Vec.new();
        for i in 0..po.entries.len() as i64 {
            idx.push(i);
        }
        idx.sort_by(|x, y| {
            let c = entry_cmp(po.entries[x], po.entries[y]);
            if c != 0 { c.cmp(0) } else { x.cmp(y) }
        });
        for i in idx {
            let e = ref po.entries[i];
            let ctx = if ctx_truthy(e.msgctxt) { f"{ctx_text(e.msgctxt)}|" } else { String.new() };
            let mut occ: Vec[String] = Vec.new();
            for o in sorted_occ(e) {
                if occ.len() < 2 {
                    occ.push(f"{o.0}:{o.1}");
                }
            }
            let mark = if e.obsolete { "~" } else { " " };
            out.push_str(f"  {mark} {ctx}{py_repr(e.msgid)} {repr_list(occ)}\n");
        }
    } else if cmd == "compile" {
        let mut po = pofile(a, 78)?;
        save_binary(mut po, f[2])?;
        let b = read_file(f[2])?;
        out.push_str(f"wrote {f[2]}: {b.len()} bytes, fnv {fnv(b):08x}, header {mo_header(b)}\n");
        let mo = mofile(f[2])?;
        out.push_str(f"  read back: {mo.entries.len()} entries, {mo.metadata.len()} metadata fields, encoding {mo.encoding}\n");
    } else if cmd == "mo" {
        let mo = mofile(a)?;
        out.push_str(f"magic {hex_digits(mo.magic, 8)}, version {mo.version}, {mo.entries.len()} entries, encoding {mo.encoding}\n");
        for m in ordered_metadata(mo) {
            out.push_str(f"  {m.0}: {py_repr(m.1)}\n");
        }
        for e in mo.entries {
            out.push_str(f"  {entry_line(e)}\n");
        }
    } else if cmd == "mo-to-po" {
        let mo = mofile(a)?;
        save(mo, f[2])?;
        show_text(mut out, decode("utf-8", read_file(f[2])?)?);
    } else if cmd == "mo-save" {
        let mut mo = mofile(a)?;
        save_binary(mut mo, f[2])?;
        let b = read_file(f[2])?;
        out.push_str(f"wrote {f[2]}: {b.len()} bytes, fnv {fnv(b):08x}, header {mo_header(b)}\n");
        for e in mofile(f[2])?.entries {
            out.push_str(f"  {entry_line(e)}\n");
        }
    } else if cmd == "po" {
        let po = pofile(a, 78)?;
        out.push_str(f"{po.entries.len()} entries; {stats(po)}\n");
    } else if cmd == "escape" {
        out.push_str(f"{py_repr(escape(markers(a)))}\n");
    } else if cmd == "unescape" {
        out.push_str(f"{py_repr(unescape(markers(a)))}\n");
    } else if cmd == "natural-sort" {
        out.push_str(f"{repr_list(natural_sort(split_str(a, " ")))}\n");
    }
    Ok(())
}

// ------------------------------------------------------------ the run

fn hex_val(c: char) -> i64 {
    if c >= '0' and c <= '9' {
        (c as u32 as i64) - 48
    } else if c >= 'a' and c <= 'f' {
        (c as u32 as i64) - 87
    } else {
        -1
    }
}

fn unhex(s: ref String) -> Vec[u8] {
    let v = chars(s);
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < v.len() {
        out.push((hex_val(v[i]) * 16 + hex_val(v[i + 1])) as u8);
        i += 2;
    }
    out
}

fn main() {
    if fs.create_dir_all("data/out").is_err() {
        println("could not create data/out");
        return;
    }
    for d in data_files() {
        if fs.write_bytes(f"data/{d.0}", unhex(d.1)).is_err() {
            println(f"could not write data/{d.0}");
            return;
        }
    }
    let jobs = match fs.read_to_string("data/jobs.txt") {
        Ok(t) => t,
        Err(_) => {
            println("could not read data/jobs.txt");
            return;
        }
    };
    let mut out = String.new();
    for line in split_str(jobs, "\n") {
        if line == "" {
            continue;
        }
        let f = split_str(line, "\t");
        out.push_str(f"== {f.join(" | ")}\n");
        match job(f, mut out) {
            Ok(_) => {}
            Err(e) => out.push_str(f"{e.kind}: {e.msg}\n"),
        }
    }
    print(out);
}

