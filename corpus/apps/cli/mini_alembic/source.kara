// mini_alembic: database schema migrations in the shape of Alembic.
// Migration scripts name their parent revisions, so they form a graph with
// branches, labels and merge points. The tool upgrades and downgrades a
// schema along that graph, one transaction per migration, keeps the
// current revisions and the schema in a state file, prints the SQL an
// upgrade would run, stamps a version without running anything, checks the
// schema against a replay of its history, and generates new revision and
// merge scripts on disk.
// README.md is the spec; oracle.py is the reference.

import std.encoding.hex_decode;

const STATE: Str = "data/out/state.txt";

// ------------------------------------------------------------ tokens

fn is_lower(c: u8) -> bool {
    c >= b'a' and c <= b'z'
}

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn is_name(s: Str) -> bool {
    let b = s.bytes();
    b.len() > 0 and b.len() <= 30 and (is_lower(b[0]) or b[0] == b'_')
        and b.iter().all(|c| is_lower(c) or is_digit(c) or c == b'_')
}

fn need_name(s: Str) -> Result[String, String] {
    if is_name(s) { Ok(s.to_string()) } else { Err(f"bad name '{s}'") }
}

fn is_hex(s: Str) -> bool {
    s.bytes().iter().all(|c| is_digit(c) or (c >= b'a' and c <= b'f'))
}

fn is_rev(s: Str) -> bool {
    s.len() >= 6 and s.len() <= 12 and is_hex(s)
}

fn is_label(s: Str) -> bool {
    let b = s.bytes();
    b.len() > 0 and b.len() <= 24 and is_lower(b[0])
        and b.iter().all(|c| is_lower(c) or is_digit(c) or c == b'_')
        and s != "head" and s != "heads" and s != "base"
}

fn digits(s: Str) -> bool {
    s.len() > 0 and s.bytes().iter().all(|c| is_digit(c))
}

fn words(s: Str) -> Vec[String] {
    s.split_whitespace().map(|w| w.to_string()).collect()
}

fn sql_type(t: Str) -> Option[Str] {
    match t {
        "int" => Some("INTEGER"),
        "text" => Some("TEXT"),
        "real" => Some("REAL"),
        "bool" => Some("BOOLEAN"),
        "date" => Some("DATE"),
        _ => None,
    }
}

fn hex8(v: u32) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out = String.new();
    for i in 0..8 {
        let d = (v >> ((7 - i) * 4) as u32) & 15;
        out.push(digits[d as i64] as char);
    }
    out
}

// FNV-1a, 32 bits: the id of a generated revision.
fn fnv1a(data: Slice[u8]) -> u32 {
    let mut h: u32 = 0x811c9dc5;
    for b in data.iter() {
        h ^= b as u32;
        h = h.wrapping_mul(0x01000193);
    }
    h
}

// ------------------------------------------------------------ migration scripts

#[derive(Clone, PartialEq)]
struct Column {
    name: String,
    ty: String,
    pk: bool,
    notnull: bool,
    default: Option[String],
}

#[derive(Clone)]
enum Change {
    Type(String),
    NotNull,
    Null,
}

#[derive(Clone)]
enum Op {
    CreateTable { table: String, cols: Vec[Column] },
    DropTable { table: String },
    AddColumn { table: String, col: Column },
    DropColumn { table: String, column: String },
    RenameTable { table: String, new: String },
    RenameColumn { table: String, column: String, new: String },
    AlterColumn { table: String, column: String, changes: Vec[Change] },
    CreateIndex { index: String, table: String, cols: Vec[String], unique: bool },
    DropIndex { index: String },
    Execute { sql: String },
}

// One line of an upgrade or downgrade section, as written and as parsed.
#[derive(Clone)]
struct Step {
    op: Op,
    text: String,
}

#[derive(Clone)]
struct Rev {
    id: String,
    down: Vec[String],
    label: Option[String],
    message: String,
    path: String,
    up: Vec[Step],
    dn: Vec[Step],
}

fn usage(op: Str) -> Option[Str] {
    match op {
        "create_table" => Some("create_table <table> <column>..."),
        "drop_table" => Some("drop_table <table>"),
        "add_column" => Some("add_column <table> <column>"),
        "drop_column" => Some("drop_column <table> <column>"),
        "rename_table" => Some("rename_table <old> <new>"),
        "rename_column" => Some("rename_column <table> <old> <new>"),
        "alter_column" => Some("alter_column <table> <column> <change>..."),
        "create_index" => Some("create_index <index> <table> <columns> [unique]"),
        "drop_index" => Some("drop_index <index>"),
        "execute" => Some("execute <sql>"),
        _ => None,
    }
}

fn op_name(o: Op) -> Str {
    match o {
        Op.CreateTable { .. } => "create_table",
        Op.DropTable { .. } => "drop_table",
        Op.AddColumn { .. } => "add_column",
        Op.DropColumn { .. } => "drop_column",
        Op.RenameTable { .. } => "rename_table",
        Op.RenameColumn { .. } => "rename_column",
        Op.AlterColumn { .. } => "alter_column",
        Op.CreateIndex { .. } => "create_index",
        Op.DropIndex { .. } => "drop_index",
        Op.Execute { .. } => "execute",
    }
}

// `name:type[:pk][:notnull][:default=v]`
fn parse_column(spec: Str, allow_pk: bool) -> Result[Column, String] {
    let parts: Vec[String] = spec.split(":").map(|p| p.to_string()).collect();
    if parts.len() < 2 {
        return Err(f"bad column '{spec}'");
    }
    let name = need_name(parts[0])?;
    if sql_type(parts[1]).is_none() {
        return Err(f"unknown type '{parts[1]}'");
    }
    let mut col = Column { name, ty: parts[1].clone(), pk: false, notnull: false, default: None };
    let mut seen: Vec[String] = Vec.new();
    for f in parts[2..].iter() {
        let key = if f.starts_with("default=") { "default".to_string() } else { f.clone() };
        if seen.contains(key) {
            return Err(f"duplicate flag '{key}'");
        }
        seen.push(key.clone());
        if f == "pk" {
            if not allow_pk {
                return Err("add_column cannot add a primary key".to_string());
            }
            col.pk = true;
        } else if f == "notnull" {
            col.notnull = true;
        } else if key == "default" {
            let v = f.substring(8, f.len());
            if v.is_empty() {
                return Err(f"bad default in '{spec}'");
            }
            col.default = Some(v.to_string());
        } else {
            return Err(f"unknown flag '{f}'");
        }
    }
    Ok(col)
}

fn parse_op(text: Str) -> Result[Step, String] {
    let w = words(text);
    let op = w[0].clone();
    let Some(how) = usage(op) else {
        return Err(f"unknown operation '{op}'");
    };
    let n = w.len() - 1;
    let fits = match op.as_str() {
        "create_table" => n >= 2,
        "drop_table" | "drop_index" => n == 1,
        "add_column" | "drop_column" | "rename_table" => n == 2,
        "rename_column" => n == 3,
        "alter_column" => n >= 3,
        "create_index" => n == 3 or n == 4,
        _ => n >= 1,
    };
    if not fits {
        return Err(f"usage: {how}");
    }
    let parsed = match op.as_str() {
        "create_table" => {
            let table = need_name(w[1])?;
            let mut cols: Vec[Column] = Vec.new();
            for spec in w[2..].iter() {
                let c = parse_column(spec, true)?;
                if cols.iter().any(|x| x.name == c.name) {
                    return Err(f"duplicate column '{c.name}'");
                }
                cols.push(c);
            }
            Op.CreateTable { table, cols }
        }
        "drop_table" => Op.DropTable { table: need_name(w[1])? },
        "add_column" => {
            let table = need_name(w[1])?;
            Op.AddColumn { table, col: parse_column(w[2], false)? }
        }
        "drop_column" => {
            let table = need_name(w[1])?;
            Op.DropColumn { table, column: need_name(w[2])? }
        }
        "rename_table" => {
            let table = need_name(w[1])?;
            Op.RenameTable { table, new: need_name(w[2])? }
        }
        "rename_column" => {
            let table = need_name(w[1])?;
            let column = need_name(w[2])?;
            Op.RenameColumn { table, column, new: need_name(w[3])? }
        }
        "alter_column" => {
            let table = need_name(w[1])?;
            let column = need_name(w[2])?;
            let mut changes: Vec[Change] = Vec.new();
            for c in w[3..].iter() {
                if c.starts_with("type=") {
                    let t = c.substring(5, c.len());
                    if sql_type(t).is_none() {
                        return Err(f"unknown type '{t}'");
                    }
                    changes.push(Change.Type(t.to_string()));
                } else if c == "notnull" {
                    changes.push(Change.NotNull);
                } else if c == "null" {
                    changes.push(Change.Null);
                } else {
                    return Err(f"unknown change '{c}'");
                }
            }
            Op.AlterColumn { table, column, changes }
        }
        "create_index" => {
            let index = need_name(w[1])?;
            let table = need_name(w[2])?;
            let mut cols: Vec[String] = Vec.new();
            for c in w[3].split(",") {
                need_name(c)?;
                if cols.contains(c.to_string()) {
                    return Err(f"column '{c}' listed twice");
                }
                cols.push(c.to_string());
            }
            if n == 4 and w[4] != "unique" {
                return Err(f"expected 'unique', found '{w[4]}'");
            }
            Op.CreateIndex { index, table, cols, unique: n == 4 }
        }
        "drop_index" => Op.DropIndex { index: need_name(w[1])? },
        _ => Op.Execute { sql: text.substring(7, text.len()).trim().to_string() },
    };
    Ok(Step { op: parsed, text: text.to_string() })
}

// The parts of a script read so far.
struct Draft {
    revision: Option[String],
    down: Option[Vec[String]],
    label: Option[String],
    message: Option[String],
    section: Option[String],
    sections: Vec[String],
    up: Vec[Step],
    dn: Vec[Step],
}

// One `key: value` line before the sections.
fn header_line(d: mut ref Draft, s: Str) -> Result[(), String] {
    let at = s.find(":").unwrap_or(0);
    let key = s.substring(0, at);
    let tail_ok = at + 1 == s.len() or s.substring(at + 1, at + 2) == " ";
    if at == 0 or not key.bytes().iter().all(|c| is_lower(c) or c == b'_') or not tail_ok {
        return Err("expected key: value".to_string());
    }
    let value = s.substring(at + 1, s.len()).trim().to_string();
    let taken = match key {
        "revision" => d.revision.is_some(),
        "down" => d.down.is_some(),
        "label" => d.label.is_some(),
        "message" => d.message.is_some(),
        _ => return Err(f"unknown key '{key}'"),
    };
    if taken {
        return Err(f"duplicate key '{key}'");
    }
    match key {
        "revision" => {
            if not is_rev(value) {
                return Err(f"bad revision id '{value}'");
            }
            d.revision = Some(value);
        }
        "down" => {
            let mut ds: Vec[String] = Vec.new();
            if value != "none" {
                for part in value.split(",") {
                    let p = part.trim();
                    if not is_rev(p) {
                        return Err(f"bad revision id '{p}'");
                    }
                    if ds.contains(p.to_string()) {
                        return Err(f"down lists {p} twice");
                    }
                    ds.push(p.to_string());
                }
            }
            d.down = Some(ds);
        }
        "label" => {
            if not is_label(value) {
                return Err(f"bad label '{value}'");
            }
            d.label = Some(value);
        }
        _ => {
            if value.is_empty() {
                return Err("empty message".to_string());
            }
            d.message = Some(value);
        }
    }
    Ok(())
}

fn script_line(d: mut ref Draft, line: Str) -> Result[(), String] {
    let s = line.trim();
    if line.starts_with(" ") or line.starts_with("\t") {
        let step = match d.section.clone() {
            None => return Err("operation outside upgrade/downgrade".to_string()),
            Some(sec) => (sec, parse_op(s)?),
        };
        if step.0 == "upgrade" {
            d.up.push(step.1);
        } else {
            d.dn.push(step.1);
        }
        return Ok(());
    }
    if s == "upgrade:" or s == "downgrade:" {
        let sec = s.substring(0, s.len() - 1).to_string();
        if d.sections.contains(sec) {
            return Err(f"duplicate section '{sec}'");
        }
        d.sections.push(sec.clone());
        d.section = Some(sec);
        return Ok(());
    }
    let first = words(s)[0].clone();
    if usage(first).is_some() {
        return Err(if d.section.is_none() {
            "operation outside upgrade/downgrade".to_string()
        } else {
            "operation must be indented".to_string()
        });
    }
    if d.section.is_some() {
        return Err("key after the upgrade/downgrade sections".to_string());
    }
    header_line(mut d, s)
}

// A revision, or the line that reports why the script is skipped.
fn parse_mig(path: Str, text: Str) -> Result[Rev, String] {
    let mut d = Draft {
        revision: None,
        down: None,
        label: None,
        message: None,
        section: None,
        sections: Vec.new(),
        up: Vec.new(),
        dn: Vec.new(),
    };
    let mut lines: Vec[String] = text.split("\n").map(|l| l.to_string()).collect();
    if lines.len() > 0 and lines[lines.len() - 1].is_empty() {
        lines.pop();
    }
    for (i, raw) in lines.iter().enumerate() {
        let line = raw.trim_end();
        let s = line.trim();
        if s.is_empty() or s.starts_with("#") {
            continue;
        }
        if let Err(e) = script_line(mut d, line) {
            return Err(f"{path}:{i + 1}: {e}");
        }
    }
    let Some(id) = d.revision else {
        return Err(f"{path}: missing revision");
    };
    let Some(down) = d.down else {
        return Err(f"{path}: missing down");
    };
    let Some(message) = d.message else {
        return Err(f"{path}: missing message");
    };
    for sec in ["upgrade", "downgrade"].iter() {
        if not d.sections.contains(sec.to_string()) {
            return Err(f"{path}: missing {sec}");
        }
    }
    let name = match path.rsplit_once("/") {
        Some((_, n)) => n.to_string(),
        None => path.to_string(),
    };
    if not name.starts_with(f"{id}_") {
        return Err(f"{path}: file name does not start with revision {id}");
    }
    Ok(Rev { id, down, label: d.label, message, path: path.to_string(), up: d.up, dn: d.dn })
}

// ------------------------------------------------------------ the revision graph

struct Graph {
    revs: SortedMap[String, Rev],
    children: SortedMap[String, Vec[String]],
    order: Vec[String],
    pos: Map[String, i64],
    heads: Vec[String],
    labels: SortedMap[String, String],
}

// Topological order: of the revisions whose parents are all placed, the
// smallest id goes next.
fn graph(revs: own Vec[Rev]) -> Graph {
    let mut g = Graph {
        revs: SortedMap.new(),
        children: SortedMap.new(),
        order: Vec.new(),
        pos: Map.new(),
        heads: Vec.new(),
        labels: SortedMap.new(),
    };
    for r in revs.into_iter() {
        g.children.insert(r.id.clone(), Vec.new());
        if let Some(l) = r.label.clone() {
            g.labels.insert(l, r.id.clone());
        }
        g.revs.insert(r.id.clone(), r);
    }
    let mut edges: Vec[(String, String)] = Vec.new();
    for (id, r) in g.revs.iter() {
        for d in r.down.iter() {
            edges.push((d.clone(), id.clone()));
        }
    }
    for (parent, child) in edges.into_iter() {
        if let Some(cs) = g.children.get_mut(parent) {
            cs.push(child);
        }
    }
    let mut placed: SortedSet[String] = SortedSet.new();
    let mut ready: SortedSet[String] = SortedSet.new();
    for (id, r) in g.revs.iter() {
        if r.down.is_empty() {
            ready.insert(id.clone());
        }
    }
    while let Some(r) = ready.pop_first() {
        placed.insert(r.clone());
        g.pos.insert(r.clone(), g.order.len());
        g.order.push(r.clone());
        for c in g.kids(r).iter() {
            if g.rev(c).down.iter().all(|d| placed.contains(d)) {
                ready.insert(c.clone());
            }
        }
    }
    let heads: Vec[String] = g.order.iter().filter(|r| g.kids(r).is_empty()).cloned().collect();
    g.heads = heads;
    g
}

impl Graph {
    fn rev(self, id: Str) -> Rev {
        self.revs.get(id).cloned().unwrap()
    }

    fn kids(self, id: Str) -> Vec[String] {
        self.children.get(id).cloned().unwrap_or(Vec.new())
    }

    fn is_head(self, id: Str) -> bool {
        self.heads.contains(id.to_string())
    }

    fn ancestors(self, targets: Slice[String]) -> SortedSet[String] {
        let mut out: SortedSet[String] = SortedSet.new();
        let mut stack: Vec[String] = targets.to_vec();
        while let Some(r) = stack.pop() {
            if out.insert(r.clone()) {
                stack.extend(self.rev(r).down);
            }
        }
        out
    }

    fn descendants(self, id: Str) -> SortedSet[String] {
        let mut out: SortedSet[String] = SortedSet.new();
        let mut stack = self.kids(id);
        while let Some(r) = stack.pop() {
            if out.insert(r.clone()) {
                stack.extend(self.kids(r));
            }
        }
        out
    }

    // The members of `s`, in graph order.
    fn in_order(self, s: SortedSet[String]) -> Vec[String] {
        self.order.iter().filter(|r| s.contains(r)).cloned().collect()
    }

    // The applied revisions with no applied child.
    fn current(self, applied: SortedSet[String]) -> Vec[String] {
        self.order
            .iter()
            .filter(|r| applied.contains(r) and not self.kids(r).iter().any(|c| applied.contains(c)))
            .cloned()
            .collect()
    }

    // A revision id, or None for base.
    fn resolve(self, spec: Str) -> Result[Option[String], String] {
        if spec == "base" {
            return Ok(None);
        }
        if spec == "head" {
            if self.heads.len() != 1 {
                return Err(f"multiple heads ({self.heads.join(", ")}); name one or use heads");
            }
            return Ok(Some(self.heads[0].clone()));
        }
        if let Some((label, rest)) = spec.split_once("@") {
            if rest != "head" {
                return Err(f"bad revision '{spec}'");
            }
            let Some(r) = self.labels.get(label).cloned() else {
                return Err(f"no label '{label}'");
            };
            let below = self.descendants(r);
            let hs: Vec[String] = self.heads.iter().filter(|h| h == r or below.contains(h)).cloned().collect();
            if hs.len() != 1 {
                return Err(f"label {label} has {hs.len()} heads ({hs.join(", ")})");
            }
            return Ok(Some(hs[0].clone()));
        }
        if let Some(r) = self.labels.get(spec) {
            return Ok(Some(r.clone()));
        }
        if spec.is_empty() or not is_hex(spec) {
            return Err(f"no revision '{spec}'");
        }
        if self.revs.contains_key(spec) {
            return Ok(Some(spec.to_string()));
        }
        if spec.len() < 3 {
            return Err(f"revision prefix '{spec}' is too short");
        }
        let m: Vec[String] = self.revs.keys().filter(|r| r.starts_with(spec)).cloned().collect();
        if m.is_empty() {
            return Err(f"no revision '{spec}'");
        }
        if m.len() > 1 {
            return Err(f"ambiguous revision '{spec}' ({m.join(", ")})");
        }
        Ok(Some(m[0].clone()))
    }

    fn from_text(self, id: Str) -> String {
        let d = self.rev(id).down;
        if d.is_empty() { "base".to_string() } else { d.join(", ") }
    }
}

// ------------------------------------------------------------ loading

fn read(path: Str) -> Result[String, String] {
    fs.read_to_string(path).map_err(|e| f"cannot read {path}: {e}")
}

// Every script under data/versions and data/out/versions, each parsed in a
// task of its own; the ones that do not fit the graph are reported and
// skipped.
fn load_revisions(verbose: bool) -> Result[Graph, String] {
    let mut files: Vec[(String, String)] = Vec.new();
    for (dir, shown) in [("data/out/versions", "out/versions"), ("data/versions", "versions")].iter() {
        if fs.exists(dir) {
            let names = fs.read_dir(dir).map_err(|e| f"cannot list {dir}: {e}")?;
            for n in names.iter().filter(|n| n.ends_with(".mig")) {
                files.push((f"{shown}/{n}", f"{dir}/{n}"));
            }
        }
    }
    files.sort();
    let group = TaskGroup.new();
    let mut handles = Vec.new();
    for (shown, real) in files.iter() {
        let shown = shown.clone();
        let real = real.clone();
        handles.push(group.spawn(|| match fs.read_to_string(real) {
            Ok(text) => parse_mig(shown, text),
            Err(e) => Err(f"{shown}: cannot read: {e}"),
        }));
    }
    let mut errors: Vec[(String, String)] = Vec.new();
    let mut parsed: Vec[Rev] = Vec.new();
    for (h, (shown, _)) in handles.into_iter().zip(files.iter()) {
        match h.join() {
            Ok(r) => parsed.push(r),
            Err(e) => errors.push((shown.clone(), e)),
        }
    }
    // The first script to define a revision keeps it.
    let mut first: Map[String, String] = Map.new();
    let mut keep: Vec[Rev] = Vec.new();
    for r in parsed.into_iter() {
        match first.get(r.id).cloned() {
            Some(p) => errors.push((r.path.clone(), f"{r.path}: revision {r.id} already defined in {p}")),
            None => {
                first.insert(r.id.clone(), r.path.clone());
                keep.push(r);
            }
        }
    }
    // And the first to claim a label.
    let mut labels: Map[String, String] = Map.new();
    let mut claimed: Vec[Rev] = Vec.new();
    for r in keep.into_iter() {
        if let Some(l) = r.label.clone() {
            if let Some(owner) = labels.get(l).cloned() {
                errors.push((r.path.clone(), f"{r.path}: label {l} already used by {owner}"));
                continue;
            }
            labels.insert(l, r.id.clone());
        }
        claimed.push(r);
    }
    // A script whose parent is missing goes, which can orphan its children.
    let mut keep = claimed;
    loop {
        let have: SortedSet[String] = keep.iter().map(|r| r.id.clone()).collect();
        let mut next: Vec[Rev] = Vec.new();
        for r in keep.iter() {
            match r.down.iter().find(|d| not have.contains(d)) {
                Some(d) => errors.push((r.path.clone(), f"{r.path}: down revision {d} not found")),
                None => next.push(r.clone()),
            }
        }
        if next.len() == keep.len() {
            break;
        }
        keep = next;
    }
    // What is left must lead back to a revision with no parent.
    let mut grounded: SortedSet[String] = SortedSet.new();
    let mut changed = true;
    while changed {
        changed = false;
        for r in keep.iter() {
            if not grounded.contains(r.id) and r.down.iter().all(|d| grounded.contains(d)) {
                grounded.insert(r.id.clone());
                changed = true;
            }
        }
    }
    let mut good: Vec[Rev] = Vec.new();
    for r in keep.into_iter() {
        if grounded.contains(r.id) {
            good.push(r);
        } else {
            errors.push((r.path.clone(), f"{r.path}: revision {r.id} does not lead back to a base"));
        }
    }
    errors.sort();
    if verbose {
        for (_, e) in errors.iter() {
            println(e);
        }
    }
    let lead = if verbose { "" } else { "  " };
    println(f"{lead}loaded {good.len()} revisions from {files.len()} files, {errors.len()} skipped");
    Ok(graph(good))
}

// ------------------------------------------------------------ the schema

#[derive(Clone, PartialEq)]
struct Index {
    table: String,
    cols: Vec[String],
    unique: bool,
}

#[derive(Clone)]
struct Schema {
    tables: SortedMap[String, Vec[Column]],
    indexes: SortedMap[String, Index],
}

fn empty_schema() -> Schema {
    Schema { tables: SortedMap.new(), indexes: SortedMap.new() }
}

fn col_text(c: Column) -> String {
    let mut s = f"{c.name} {c.ty}";
    if c.pk {
        s.push_str(" pk");
    }
    if c.notnull {
        s.push_str(" notnull");
    }
    if let Some(v) = c.default {
        s.push_str(f" default={v}");
    }
    s
}

fn schema_lines(sc: Schema) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for (t, cols) in sc.tables.iter() {
        let cs: Vec[String] = cols.iter().map(|c| col_text(c)).collect();
        out.push(f"table {t} ({cs.join(", ")})");
    }
    for (name, ix) in sc.indexes.iter() {
        let u = if ix.unique { " unique" } else { "" };
        out.push(f"index {name} on {ix.table} ({ix.cols.join(", ")}){u}");
    }
    out
}

fn find_col(sc: Schema, t: Str, c: Str) -> Result[i64, String] {
    let Some(cols) = sc.tables.get(t) else {
        return Err(f"no table {t}");
    };
    cols.iter().position(|x| x.name == c).ok_or(f"no column {t}.{c}")
}

fn no_table(sc: Schema, t: Str) -> Result[(), String] {
    if sc.tables.contains_key(t) { Ok(()) } else { Err(f"no table {t}") }
}

fn apply_op(sc: mut ref Schema, o: Op) -> Result[(), String] {
    match o {
        Op.CreateTable { table, cols } => {
            if sc.tables.contains_key(table) {
                return Err(f"table {table} already exists");
            }
            sc.tables.insert(table.clone(), cols.clone());
        }
        Op.DropTable { table } => {
            no_table(sc, table)?;
            for (name, ix) in sc.indexes.iter() {
                if ix.table == table {
                    return Err(f"table {table} still has index {name}");
                }
            }
            sc.tables.remove(table);
        }
        Op.AddColumn { table, col } => {
            no_table(sc, table)?;
            if find_col(sc, table, col.name).is_ok() {
                return Err(f"column {table}.{col.name} already exists");
            }
            if col.notnull and col.default.is_none() {
                return Err(f"column {table}.{col.name} is not null and has no default");
            }
            if let Some(cols) = sc.tables.get_mut(table) {
                cols.push(col.clone());
            }
        }
        Op.DropColumn { table, column } => {
            let i = find_col(sc, table, column)?;
            let cols = sc.tables.get(table).cloned().unwrap();
            if cols[i].pk {
                return Err(f"cannot drop primary key column {table}.{column}");
            }
            for (name, ix) in sc.indexes.iter() {
                if ix.table == table and ix.cols.contains(column) {
                    return Err(f"column {table}.{column} is used by index {name}");
                }
            }
            if cols.len() == 1 {
                return Err(f"cannot drop the last column of {table}");
            }
            if let Some(cols) = sc.tables.get_mut(table) {
                cols.remove(i);
            }
        }
        Op.RenameTable { table, new } => {
            no_table(sc, table)?;
            if sc.tables.contains_key(new) {
                return Err(f"table {new} already exists");
            }
            let cols = sc.tables.remove(table).unwrap();
            sc.tables.insert(new.clone(), cols);
            for ix in sc.indexes.values_mut() {
                if ix.table == table {
                    ix.table = new.clone();
                }
            }
        }
        Op.RenameColumn { table, column, new } => {
            let i = find_col(sc, table, column)?;
            if find_col(sc, table, new).is_ok() {
                return Err(f"column {table}.{new} already exists");
            }
            if let Some(cols) = sc.tables.get_mut(table) {
                cols[i].name = new.clone();
            }
            for ix in sc.indexes.values_mut() {
                if ix.table == table {
                    for c in ix.cols.iter_mut() {
                        if c == column {
                            *c = new.clone();
                        }
                    }
                }
            }
        }
        Op.AlterColumn { table, column, changes } => {
            let i = find_col(sc, table, column)?;
            let Some(cols) = sc.tables.get_mut(table) else {
                return Err(f"no table {table}");
            };
            for ch in changes.iter() {
                match ch {
                    Change.Type(t) => cols[i].ty = t.clone(),
                    Change.NotNull => cols[i].notnull = true,
                    Change.Null => {
                        if cols[i].pk {
                            return Err("a primary key column cannot be null".to_string());
                        }
                        cols[i].notnull = false;
                    }
                }
            }
        }
        Op.CreateIndex { index, table, cols, unique } => {
            if sc.indexes.contains_key(index) {
                return Err(f"index {index} already exists");
            }
            no_table(sc, table)?;
            for c in cols.iter() {
                find_col(sc, table, c)?;
            }
            sc.indexes.insert(index.clone(), Index { table: table.clone(), cols: cols.clone(), unique: unique });
        }
        Op.DropIndex { index } => {
            if sc.indexes.remove(index).is_none() {
                return Err(f"no index {index}");
            }
        }
        Op.Execute { .. } => {}
    }
    Ok(())
}

// Why a migration stopped: its step (from 1), the operation and the error.
struct Failure {
    step: i64,
    op: String,
    why: String,
}

// The schema after every step, or the first step that fails, leaving the
// schema as it was: each migration is one transaction.
fn run_steps(sc: Schema, steps: Slice[Step]) -> Result[Schema, Failure] {
    let mut work = sc.clone();
    for (k, s) in steps.iter().enumerate() {
        if let Err(why) = apply_op(mut work, s.op) {
            return Err(Failure { step: k + 1, op: op_name(s.op).to_string(), why });
        }
    }
    Ok(work)
}

// ------------------------------------------------------------ SQL

fn sql_value(v: Str) -> String {
    let numeric = v.bytes().iter().all(|c| is_digit(c) or c == b'.') and v.bytes().iter().any(|c| is_digit(c));
    if v == "true" or v == "false" or numeric { v.to_string() } else { f"'{v}'" }
}

fn col_sql(c: Column) -> String {
    let mut s = f"{c.name} {sql_type(c.ty).unwrap_or("TEXT")}";
    if c.notnull or c.pk {
        s.push_str(" NOT NULL");
    }
    if let Some(v) = c.default {
        s.push_str(f" DEFAULT {sql_value(v)}");
    }
    s
}

fn op_sql(o: Op) -> Vec[String] {
    match o {
        Op.CreateTable { table, cols } => {
            let mut parts: Vec[String] = cols.iter().map(|c| col_sql(c)).collect();
            let pk: Vec[String] = cols.iter().filter(|c| c.pk).map(|c| c.name.clone()).collect();
            if not pk.is_empty() {
                parts.push(f"PRIMARY KEY ({pk.join(", ")})");
            }
            [f"CREATE TABLE {table} ({parts.join(", ")});"]
        }
        Op.DropTable { table } => [f"DROP TABLE {table};"],
        Op.AddColumn { table, col } => [f"ALTER TABLE {table} ADD COLUMN {col_sql(col)};"],
        Op.DropColumn { table, column } => [f"ALTER TABLE {table} DROP COLUMN {column};"],
        Op.RenameTable { table, new } => [f"ALTER TABLE {table} RENAME TO {new};"],
        Op.RenameColumn { table, column, new } => [f"ALTER TABLE {table} RENAME COLUMN {column} TO {new};"],
        Op.AlterColumn { table, column, changes } => {
            let head = f"ALTER TABLE {table} ALTER COLUMN {column}";
            changes
                .iter()
                .map(|ch| match ch {
                    Change.Type(t) => f"{head} TYPE {sql_type(t).unwrap_or("TEXT")};",
                    Change.NotNull => f"{head} SET NOT NULL;",
                    Change.Null => f"{head} DROP NOT NULL;",
                })
                .collect()
        }
        Op.CreateIndex { index, table, cols, unique } => {
            let u = if unique { "UNIQUE " } else { "" };
            [f"CREATE {u}INDEX {index} ON {table} ({cols.join(", ")});"]
        }
        Op.DropIndex { index } => [f"DROP INDEX {index};"],
        Op.Execute { sql } => [if sql.ends_with(";") { sql.clone() } else { f"{sql};" }],
    }
}

// ------------------------------------------------------------ the environment

struct Env {
    g: Graph,
    applied: SortedSet[String],
    schema: Schema,
}

fn one_arg(cmd: Str, args: Slice[String]) -> Result[String, String] {
    if args.is_empty() {
        return Err(f"{cmd} needs a target");
    }
    if args.len() > 1 {
        return Err(f"{cmd} takes one target");
    }
    Ok(args[0].clone())
}

// `+N` or `-N` with N > 0, as N.
fn relative(spec: Str, sign: Str) -> Option[i64] {
    if not spec.starts_with(sign) {
        return None;
    }
    let rest = spec.substring(1, spec.len());
    if not digits(rest) or rest.len() > 9 {
        return None;
    }
    let n = i64.parse(rest).ok()?;
    if n > 0 { Some(n) } else { None }
}

fn slug(message: Str) -> String {
    let mut out = String.new();
    for c in message.to_lowercase().chars() {
        let keep = (c >= 'a' and c <= 'z') or (c >= '0' and c <= '9');
        if keep {
            out.push(c);
        } else if not out.is_empty() and not out.ends_with("_") {
            out.push('_');
        }
    }
    let mut cut = if out.len() > 24 { out.substring(0, 24) } else { out };
    while let Some(t) = cut.strip_suffix("_") {
        cut = t.to_string();
    }
    cut
}

impl Env {
    fn cur_text(self) -> String {
        let cur = self.g.current(self.applied);
        if cur.is_empty() {
            return "base".to_string();
        }
        let shown: Vec[String] = cur
            .iter()
            .map(|r| if self.g.is_head(r) { f"{r} (head)" } else { r.clone() })
            .collect();
        shown.join(", ")
    }

    fn save(self) -> Result[(), String] {
        let mut text = String.new();
        for r in self.g.current(self.applied).iter() {
            text.push_str(f"version {r}\n");
        }
        for (t, cols) in self.schema.tables.iter() {
            text.push_str(f"table {t}\n");
            for c in cols.iter() {
                text.push_str(f"column {col_text(c)}\n");
            }
        }
        for (name, ix) in self.schema.indexes.iter() {
            let u = if ix.unique { " unique" } else { "" };
            text.push_str(f"index {name} {ix.table} {ix.cols.join(",")}{u}\n");
        }
        fs.write(STATE, text).map_err(|e| f"cannot write {STATE}: {e}")
    }

    // The revisions an upgrade-like command aims at.
    fn targets(self, spec: Str, what: Str) -> Result[Vec[String], String] {
        if spec == "heads" {
            return Ok(self.g.heads.clone());
        }
        if let Some(n) = relative(spec, "+") {
            let cur = self.g.current(self.applied);
            if cur.len() > 1 {
                return Err("multiple current heads; name a target".to_string());
            }
            let mut at: Option[String] = cur.first().cloned();
            for _ in 0..n {
                let cand: Vec[String] = match at {
                    Some(ref r) => self.g.kids(r),
                    None => self.g.order.iter().filter(|r| self.g.rev(r).down.is_empty()).cloned().collect(),
                };
                if cand.is_empty() {
                    return Err(f"relative revision {spec} goes past the head");
                }
                if cand.len() > 1 {
                    let from = at.unwrap_or("base".to_string());
                    return Err(f"{from} branches to {cand.join(", ")}; name one");
                }
                at = Some(cand[0].clone());
            }
            return Ok([at.unwrap()]);
        }
        match self.g.resolve(spec)? {
            Some(r) => Ok([r]),
            None => Err(f"cannot {what} to base"),
        }
    }

    // What an upgrade to `spec` would apply, in graph order.
    fn pending(self, spec: Str) -> Result[Vec[String], String] {
        let want = self.g.ancestors(self.targets(spec, "upgrade")?);
        let missing: SortedSet[String] = want.iter().filter(|r| not self.applied.contains(r)).cloned().collect();
        Ok(self.g.in_order(missing))
    }

    fn upgrade(mut ref self, spec: Str) -> Result[(), String] {
        let need = self.pending(spec)?;
        if need.is_empty() {
            println("  nothing to upgrade");
            return Ok(());
        }
        for r in need.iter() {
            let x = self.g.rev(r);
            match run_steps(self.schema, x.up) {
                Err(f) => {
                    println(f"  failed {r} at step {f.step} ({f.op}): {f.why}; rolled back");
                    return Ok(());
                }
                Ok(sc) => self.schema = sc,
            }
            self.applied.insert(r.clone());
            println(f"  upgrade {self.g.from_text(r)} -> {r}, {x.message}");
        }
        Ok(())
    }

    fn downgrade(mut ref self, spec: Str) -> Result[(), String] {
        let gone: SortedSet[String] = if spec == "base" {
            self.applied.clone()
        } else if let Some(n) = relative(spec, "-") {
            let mut left = self.applied.clone();
            for _ in 0..n {
                let cur = self.g.current(left);
                if cur.is_empty() {
                    return Err(f"relative revision {spec} goes past base");
                }
                if cur.len() > 1 {
                    return Err("multiple current heads; name a target".to_string());
                }
                left.remove(cur[0]);
            }
            self.applied.iter().filter(|r| not left.contains(r)).cloned().collect()
        } else {
            match self.g.resolve(spec)? {
                None => self.applied.clone(),
                Some(r) => {
                    if not self.applied.contains(r) {
                        return Err(f"revision {r} is not applied");
                    }
                    self.g.descendants(r).iter().filter(|x| self.applied.contains(x)).cloned().collect()
                }
            }
        };
        if gone.is_empty() {
            println("  nothing to downgrade");
            return Ok(());
        }
        for r in self.g.in_order(gone).iter().rev() {
            let x = self.g.rev(r);
            match run_steps(self.schema, x.dn) {
                Err(f) => {
                    println(f"  failed {r} at step {f.step} ({f.op}): {f.why}; rolled back");
                    return Ok(());
                }
                Ok(sc) => self.schema = sc,
            }
            self.applied.remove(r);
            println(f"  downgrade {r} -> {self.g.from_text(r)}, {x.message}");
        }
        Ok(())
    }

    // The SQL an upgrade to `spec` would run, without running it.
    fn sql(self, spec: Str) -> Result[(), String] {
        let need = self.pending(spec)?;
        if need.is_empty() {
            println("  nothing to upgrade");
            return Ok(());
        }
        let mut sc = self.schema.clone();
        let mut applied = self.applied.clone();
        println("  BEGIN;");
        if applied.is_empty() {
            println("  CREATE TABLE alembic_version (version_num VARCHAR(32) NOT NULL, PRIMARY KEY (version_num));");
        }
        for r in need.iter() {
            let x = self.g.rev(r);
            println(f"  -- upgrade {self.g.from_text(r)} -> {r}, {x.message}");
            match run_steps(sc, x.up) {
                Err(f) => {
                    println(f"  -- failed {r} at step {f.step} ({f.op}): {f.why}");
                    println("  ROLLBACK;");
                    return Ok(());
                }
                Ok(next) => sc = next,
            }
            for s in x.up.iter() {
                for line in op_sql(s.op).iter() {
                    println(f"  {line}");
                }
            }
            let cur = self.g.current(applied);
            let ps: Vec[String] = cur.iter().filter(|p| x.down.contains(p)).cloned().collect();
            if ps.is_empty() {
                println(f"  INSERT INTO alembic_version (version_num) VALUES ('{r}');");
            } else {
                println(f"  UPDATE alembic_version SET version_num='{r}' WHERE version_num = '{ps[0]}';");
                for p in ps[1..].iter() {
                    println(f"  DELETE FROM alembic_version WHERE version_num = '{p}';");
                }
            }
            applied.insert(r.clone());
        }
        println("  COMMIT;");
        Ok(())
    }

    fn stamp(mut ref self, spec: Str) -> Result[(), String] {
        let ts: Vec[String] = if spec == "heads" {
            self.g.heads.clone()
        } else {
            match self.g.resolve(spec)? {
                Some(r) => [r],
                None => Vec.new(),
            }
        };
        self.applied = self.g.ancestors(ts);
        println(f"  stamped {self.cur_text()}");
        Ok(())
    }

    // Replays the applied revisions on an empty schema and compares.
    fn check(self) {
        let mut sc = empty_schema();
        for r in self.g.in_order(self.applied).iter() {
            match run_steps(sc, self.g.rev(r).up) {
                Err(f) => {
                    println(f"  replay fails at {r} step {f.step} ({f.op}): {f.why}");
                    return;
                }
                Ok(next) => sc = next,
            }
        }
        let want = schema_lines(sc);
        let have = schema_lines(self.schema);
        if want == have {
            println("  schema matches");
            return;
        }
        println("  schema differs");
        let mut missing: Vec[String] = want.iter().filter(|l| not have.contains(l)).cloned().collect();
        missing.sort();
        for l in missing.iter() {
            println(f"    missing: {l}");
        }
        let mut extra: Vec[String] = have.iter().filter(|l| not want.contains(l)).cloned().collect();
        extra.sort();
        for l in extra.iter() {
            println(f"    extra: {l}");
        }
    }

    // Writes a new, empty revision script, reads it back and adds it.
    fn generate(mut ref self, label: Option[String], parents: Vec[String], message: Str) -> Result[(), String] {
        let id = hex8(fnv1a(f"{message}|{parents.join(",")}".bytes()));
        if self.g.revs.contains_key(id) {
            return Err(f"revision {id} already exists");
        }
        let name = f"{id}_{slug(message)}.mig";
        let down = if parents.is_empty() { "none".to_string() } else { parents.join(", ") };
        let mut text = f"# generated by mini_alembic\nrevision: {id}\ndown: {down}\n";
        if let Some(l) = label {
            text.push_str(f"label: {l}\n");
        }
        text.push_str(f"message: {message}\n\nupgrade:\ndowngrade:\n");
        fs.create_dir_all("data/out/versions").map_err(|e| f"cannot create data/out/versions: {e}")?;
        let path = f"data/out/versions/{name}";
        fs.write(path, text).map_err(|e| f"cannot write {path}: {e}")?;
        let back = read(path)?;
        let r = parse_mig(f"out/versions/{name}", back)?;
        let mut revs: Vec[Rev] = self.g.revs.values().cloned().collect();
        revs.push(r);
        self.g = graph(revs);
        println(f"  generated out/versions/{name}");
        Ok(())
    }

    fn show(self, spec: Str) -> Result[(), String] {
        let Some(r) = self.g.resolve(spec)? else {
            return Err("base is not a revision".to_string());
        };
        let x = self.g.rev(r);
        let head = if self.g.is_head(r) { " (head)" } else { "" };
        println(f"  revision: {r}{head}");
        println(f"  file: {x.path}");
        if let Some(l) = x.label {
            println(f"  label: {l}");
        }
        println(f"  message: {x.message}");
        println(f"  down: {self.g.from_text(r)}");
        let ch = self.g.kids(r);
        let ch = if ch.is_empty() { "none".to_string() } else { ch.join(", ") };
        println(f"  children: {ch}");
        for (name, steps) in [("upgrade", x.up), ("downgrade", x.dn)].iter() {
            let n = steps.len();
            let count = if n == 0 {
                "no steps".to_string()
            } else if n == 1 {
                "1 step".to_string()
            } else {
                f"{n} steps"
            };
            println(f"  {name}: {count}");
            for s in steps.iter() {
                println(f"    {s.text}");
            }
        }
        Ok(())
    }

    fn history(self) {
        let cur = self.g.current(self.applied);
        for r in self.g.order.iter().rev() {
            let x = self.g.rev(r);
            let mut tags = String.new();
            if let Some(l) = x.label {
                tags.push_str(f" ({l})");
            }
            if self.g.is_head(r) {
                tags.push_str(" (head)");
            }
            if self.g.kids(r).len() > 1 {
                tags.push_str(" (branchpoint)");
            }
            if x.down.len() > 1 {
                tags.push_str(" (mergepoint)");
            }
            if cur.contains(r) {
                tags.push_str(" (current)");
            }
            println(f"  {self.g.from_text(r)} -> {r}{tags}, {x.message}");
        }
    }

    fn command(mut ref self, w: Slice[String]) -> Result[(), String] {
        let args = w[1..].to_vec();
        match w[0].as_str() {
            "current" => println(f"  current: {self.cur_text()}"),
            "heads" => {
                let shown: Vec[String] = self
                    .g
                    .heads
                    .iter()
                    .map(|h| match self.g.rev(h).label {
                        Some(l) => f"{h} ({l})",
                        None => h.clone(),
                    })
                    .collect();
                println(f"  heads: {shown.join(", ")}");
            }
            "history" => self.history(),
            "upgrade" => self.upgrade(one_arg("upgrade", args)?)?,
            "downgrade" => self.downgrade(one_arg("downgrade", args)?)?,
            "sql" => self.sql(one_arg("sql", args)?)?,
            "stamp" => self.stamp(one_arg("stamp", args)?)?,
            "check" => self.check(),
            "schema" => {
                let lines = schema_lines(self.schema);
                if lines.is_empty() {
                    println("  (no tables)");
                }
                for l in lines.iter() {
                    println(f"  {l}");
                }
            }
            "show" => self.show(one_arg("show", args)?)?,
            "revision" => {
                if args.len() < 3 {
                    return Err("usage: revision <label|-> <parent> <message>".to_string());
                }
                let label = if args[0] == "-" { None } else { Some(args[0].clone()) };
                if let Some(l) = label.clone() {
                    if not is_label(l) {
                        return Err(f"bad label '{l}'");
                    }
                    if let Some(owner) = self.g.labels.get(l) {
                        return Err(f"label {l} already used by {owner}");
                    }
                }
                let parents = match self.g.resolve(args[1])? {
                    Some(p) => [p],
                    None => Vec.new(),
                };
                self.generate(label, parents, args[2..].join(" "))?;
            }
            "merge" => {
                if args.is_empty() {
                    return Err("merge needs a message".to_string());
                }
                if self.g.heads.len() < 2 {
                    return Err("nothing to merge: one head".to_string());
                }
                let heads = self.g.heads.clone();
                self.generate(None, heads, args.join(" "))?;
            }
            other => return Err(f"unknown command '{other}'"),
        }
        Ok(())
    }
}

// The environment a restart reads back from the state file.
fn restore(g: own Graph) -> Result[Env, String] {
    let text = read(STATE)?;
    let mut heads: Vec[String] = Vec.new();
    let mut sc = empty_schema();
    let mut table = String.new();
    for line in text.split("\n") {
        let w = words(line);
        if w.is_empty() {
            continue;
        }
        match w[0].as_str() {
            "version" => {
                if not g.revs.contains_key(w[1]) {
                    return Err(f"state: version {w[1]} not found");
                }
                heads.push(w[1].clone());
            }
            "table" => {
                table = w[1].clone();
                sc.tables.insert(table.clone(), Vec.new());
            }
            "column" => {
                let mut c = Column { name: w[1].clone(), ty: w[2].clone(), pk: false, notnull: false, default: None };
                for f in w[3..].iter() {
                    if f == "pk" {
                        c.pk = true;
                    } else if f == "notnull" {
                        c.notnull = true;
                    } else {
                        c.default = Some(f.substring(8, f.len()).to_string());
                    }
                }
                if let Some(cols) = sc.tables.get_mut(table) {
                    cols.push(c);
                }
            }
            _ => {
                let cols: Vec[String] = w[3].split(",").map(|c| c.to_string()).collect();
                sc.indexes.insert(w[1].clone(), Index { table: w[2].clone(), cols, unique: w.len() == 5 });
            }
        }
    }
    let applied = g.ancestors(heads);
    Ok(Env { g, applied, schema: sc })
}

// ------------------------------------------------------------ main

fn run() -> Result[(), String] {
    if fs.exists("data/out") {
        fs.remove_dir_all("data/out").map_err(|e| f"cannot clear data/out: {e}")?;
    }
    fs.create_dir_all("data/versions").map_err(|e| f"cannot create data/versions: {e}")?;
    write_data()?;
    fs.create_dir_all("data/out").map_err(|e| f"cannot create data/out: {e}")?;
    let mut env = Env { g: load_revisions(true)?, applied: SortedSet.new(), schema: empty_schema() };
    let script = read("data/script.txt")?;
    let mut count = 0;
    for line in script.split("\n") {
        let s = line.trim();
        if s.is_empty() or s.starts_with("#") {
            continue;
        }
        count += 1;
        println(f"> {s}");
        let w = words(s);
        if w[0] == "restart" {
            env.save()?;
            let g = load_revisions(false)?;
            match restore(g) {
                Ok(e) => {
                    env = e;
                    println(f"  restarted at {env.cur_text()}, {env.schema.tables.len()} tables, {env.schema.indexes.len()} indexes");
                }
                Err(e) => println(f"  error: {e}"),
            }
        } else if let Err(e) = env.command(w) {
            println(f"  error: {e}");
        }
        env.save()?;
    }
    println(f"ran {count} commands");
    Ok(())
}

fn put_bytes(path: Str, hex: Str) -> Result[(), String] {
    let digits: String = hex.chars().filter(|c| not c.is_whitespace()).collect();
    let bytes = hex_decode(digits).map_err(|e| f"bad data for {path}: {e}")?;
    fs.write_bytes(path, bytes).map_err(|e| f"cannot write {path}: {e}")
}

fn main() {
    if let Err(e) = run() {
        eprintln(e);
    }
}

