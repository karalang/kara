// mini_sgp4 — sgp4 2.27 (Brandon Rhodes), the Python SGP4 satellite
// propagator: the code behind Skyfield and most Python tools that turn a
// two-line element set (TLE) into a position and velocity. It ports the
// library's pure-Python path: the TLE reader (Satrec.twoline2rv and the 1.x
// io.twoline2rv with its epoch datetime), Satrec.sgp4init, propagation by
// minutes since epoch and by Julian date, the near-Earth and deep-space
// (resonant) theories in both operation modes, the three gravity models,
// export_tle, the TLE checksum routines, Alpha-5 satellite numbers, the Julian
// date helpers, gstime, rv2coe and newtonnu.
//
// The propagation core between the BEGIN/END markers is translated statement
// for statement from vendor/sgp4/propagation.py by translate.py, so every
// float rounds the way the Python code rounds it. Python's float `%`, `//`,
// divmod() and round() are ported (fmod moved onto the divisor's sign, the
// CPython divmod, and round half to even on the exact value), as are its int()
// and float() parsers, which decide which malformed TLEs raise and with what
// message. Exceptions are Result errors carrying "Type: repr(message)", the
// way oracle.py prints them. jobs_text() holds data/jobs.tsv.

const PI: f64 = 3.141592653589793;
const TWOPI: f64 = 6.283185307179586;
const DEG2RAD: f64 = 0.017453292519943295;
const XPDOTP: f64 = 229.1831180523293;
const NAN_F: f64 = f64.NAN;

// ---------------------------------------------------------- Python numbers

fn is_nan(x: f64) -> bool {
    x != x
}

fn nan3() -> (f64, f64, f64) {
    (NAN_F, NAN_F, NAN_F)
}

fn copysign0(b: f64) -> f64 {
    let z = 0.0;
    z.copysign(b)
}

// Python's float %: fmod, then moved onto the divisor's sign. Every divisor
// here is a nonzero constant.
fn pmod(a: f64, b: f64) -> f64 {
    let m = a % b;
    if m != 0.0 {
        if (b < 0.0) != (m < 0.0) {
            return m + b;
        }
        return m;
    }
    copysign0(b)
}

// CPython's float divmod(a, b), b nonzero
fn py_divmod(a: f64, b: f64) -> (f64, f64) {
    let mut m = a % b;
    let mut div = (a - m) / b;
    if m != 0.0 {
        if (b < 0.0) != (m < 0.0) {
            m = m + b;
            div = div - 1.0;
        }
    } else {
        m = copysign0(b);
    }
    let mut fl = 0.0;
    if div != 0.0 {
        fl = div.floor();
        if div - fl > 0.5 {
            fl = fl + 1.0;
        }
    } else {
        fl = copysign0(a / b);
    }
    (fl, m)
}

fn floordiv(a: f64, b: f64) -> f64 {
    let (q, _) = py_divmod(a, b);
    q
}

// int // and % (floor division)
fn idiv(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) {
        q - 1
    } else {
        q
    }
}

fn imod(a: i64, b: i64) -> i64 {
    a - b * idiv(a, b)
}

// round(x, nd), half to even on the exact binary value
fn py_round(x: f64, nd: i64) -> f64 {
    if x == 0.0 or is_nan(x) {
        return x;
    }
    let neg = x < 0.0;
    let a = if neg { -x } else { x };
    let mut k = 0;
    let mut y = a;
    while y != y.floor() {
        y = y * 2.0;
        k += 1;
    }
    let m = (y as i64) as i128;
    let mut q: i128 = 0;
    if k < 101 {
        let mut num = m;
        let mut i = 0;
        while i < nd {
            num = num * 10;
            i += 1;
        }
        let mut den: i128 = 1;
        i = 0;
        while i < k {
            den = den * 2;
            i += 1;
        }
        q = num / den;
        let r = num - q * den;
        if 2 * r > den or (2 * r == den and q % 2 == 1) {
            q += 1;
        }
    }
    let mut s = f"{q}";
    while s.len() <= nd {
        s = f"0{s}";
    }
    let text = f"{s.substring(0, s.len() - nd)}.{s.substring(s.len() - nd, s.len())}";
    let v = to_f64(text);
    if neg { -v } else { v }
}

fn to_f64(s: String) -> f64 {
    match f64.parse(s.clone()) {
        Ok(v) => v,
        Err(_) => NAN_F,
    }
}

fn to_i64(s: ref String) -> i64 {
    match i64.parse(s.clone()) {
        Ok(v) => v,
        Err(_) => 0,
    }
}

// repr() of a float
fn fmt(x: f64) -> String {
    if is_nan(x) {
        return "nan".to_string();
    }
    f"{x}"
}

// '{0:f}'.format(x)
fn ffmt(x: f64) -> String {
    if is_nan(x) {
        return "nan".to_string();
    }
    f"{x:.6}"
}

fn lpad(s: String, w: i64) -> String {
    let mut t = s.clone();
    while t.len() < w {
        t = f" {t}";
    }
    t
}

fn rpad(s: String, w: i64) -> String {
    let mut t = s.clone();
    while t.len() < w {
        t.push_str(" ");
    }
    t
}

// '%<w>.<p>f' % x for the precisions tests.py prints
fn fx(x: f64, w: i64, p: i64) -> String {
    let s = if is_nan(x) {
        "nan".to_string()
    } else if p == 5 {
        f"{x:.5}"
    } else if p == 6 {
        f"{x:.6}"
    } else if p == 8 {
        f"{x:.8}"
    } else {
        f"{x:.9}"
    };
    lpad(s, w)
}

fn ix(n: i64, w: i64) -> String {
    lpad(f"{n}", w)
}

// '{0: .4e}'.format(x): a sign or a space, five significant digits rounded
// half to even, and an exponent of at least two digits
fn fmt_e4(x: f64) -> String {
    let sign = if x < 0.0 or (x == 0.0 and copysign0(x) < 0.0) { "-" } else { " " };
    let a = x.abs();
    if a == 0.0 {
        return f"{sign}0.0000e+00";
    }
    let full = f"{a:.60}";
    let fb = full.bytes().to_vec();
    let mut digits: Vec[u8] = Vec.new();
    let mut intlen = 0;
    let mut seen_dot = false;
    for c in fb {
        if c == b'.' {
            seen_dot = true;
        } else {
            digits.push(c - b'0');
            if not seen_dot {
                intlen += 1;
            }
        }
    }
    let mut first = 0;
    while digits[first] == 0 {
        first += 1;
    }
    let mut exp = intlen - 1 - first;
    let mut sig: Vec[i64] = Vec.new();
    let mut i = first;
    while i < first + 5 {
        sig.push(digits[i] as i64);
        i += 1;
    }
    let next = digits[first + 5];
    let mut rest_zero = true;
    let mut j = first + 6;
    while j < digits.len() {
        if digits[j] != 0 {
            rest_zero = false;
        }
        j += 1;
    }
    let up = next > 5 or (next == 5 and (not rest_zero or sig[4] % 2 == 1));
    if up {
        let mut k = 4;
        let mut carry = true;
        while carry and k >= 0 {
            sig[k] += 1;
            if sig[k] == 10 {
                sig[k] = 0;
                k -= 1;
            } else {
                carry = false;
            }
        }
        if carry {
            sig[0] = 1;
            exp += 1;
        }
    }
    let esign = if exp < 0 { "-" } else { "+" };
    let ea = if exp < 0 { -exp } else { exp };
    let es = if ea < 10 { f"0{ea}" } else { f"{ea}" };
    f"{sign}{sig[0]}.{sig[1]}{sig[2]}{sig[3]}{sig[4]}e{esign}{es}"
}

// ---------------------------------------------------------- Python strings

fn is_py_space(c: char) -> bool {
    let o = c as i64;
    (o >= 9 and o <= 13) or (o >= 0x1C and o <= 0x20) or o == 0x85 or o == 0xA0 or o == 0x1680
        or (o >= 0x2000 and o <= 0x200A) or o == 0x2028 or o == 0x2029 or o == 0x202F or o == 0x205F or o == 0x3000
}

fn slice_chars(cs: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut s = String.new();
    let mut i = if lo < 0 { 0 } else { lo };
    let top = if hi > cs.len() { cs.len() } else { hi };
    while i < top {
        s.push(cs[i]);
        i += 1;
    }
    s
}

// s[lo:hi]
fn sl(s: ref String, lo: i64, hi: i64) -> String {
    let cs: Vec[char] = s.chars().collect();
    slice_chars(cs, lo, hi)
}

// s[i] == c, with False past the end
fn at_is(cs: ref Vec[char], i: i64, c: char) -> bool {
    i < cs.len() and cs[i] == c
}

fn py_strip(s: ref String) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut a = 0;
    let mut b = cs.len();
    while a < b and is_py_space(cs[a]) {
        a += 1;
    }
    while b > a and is_py_space(cs[b - 1]) {
        b -= 1;
    }
    slice_chars(cs, a, b)
}

fn py_rstrip(s: ref String) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut b = cs.len();
    while b > 0 and is_py_space(cs[b - 1]) {
        b -= 1;
    }
    slice_chars(cs, 0, b)
}

fn hex_digits(v: i64, n: i64) -> String {
    let ds: Vec[char] = "0123456789abcdef".chars().collect();
    let mut s = String.new();
    let mut k = (n - 1) * 4;
    while k >= 0 {
        s.push(ds[(v >> k) & 15]);
        k -= 4;
    }
    s
}

// str.isprintable() for one character of the text this program sees
fn is_printable(c: char) -> bool {
    let o = c as i64;
    if o < 0x20 or (o >= 0x7F and o <= 0xA0) or o == 0xAD {
        return false;
    }
    if o == 0x1680 or (o >= 0x2000 and o <= 0x200F) or (o >= 0x2028 and o <= 0x202F) or (o >= 0x205F and o <= 0x2064) {
        return false;
    }
    not (o == 0x3000 or o == 0xFEFF or (o >= 0xD800 and o <= 0xDFFF) or (o >= 0xE000 and o <= 0xF8FF))
}

// repr() of a str
fn py_repr_str(s: ref String) -> String {
    let has_single = s.contains("'");
    let has_double = s.contains("\"");
    let q = if has_single and not has_double { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        let o = c as i64;
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if is_printable(c) {
            out.push(c);
        } else if o < 0x100 {
            out.push_str("\\x");
            out.push_str(hex_digits(o, 2));
        } else if o < 0x10000 {
            out.push_str("\\u");
            out.push_str(hex_digits(o, 4));
        } else {
            out.push_str("\\U");
            out.push_str(hex_digits(o, 8));
        }
    }
    out.push(q);
    out
}

fn val_err(msg: ref String) -> String {
    f"ValueError: {py_repr_str(msg)}"
}

fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn is_alpha(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')
}

// Digits with single underscores between them, from cs[i]; the index past
// them, or -1 when an underscore is misplaced. `out` gets the digits.
fn digit_run(cs: ref Vec[char], from: i64, out: mut ref String) -> i64 {
    let mut i = from;
    while i < cs.len() {
        if is_digit(cs[i]) {
            out.push(cs[i]);
        } else if cs[i] == '_' {
            if i == from or not is_digit(cs[i - 1]) or i + 1 >= cs.len() or not is_digit(cs[i + 1]) {
                return -1;
            }
        } else {
            return i;
        }
        i += 1;
    }
    i
}

// int(s)
fn py_int(s: ref String) -> Result[i64, String] {
    let bad = val_err(f"invalid literal for int() with base 10: {py_repr_str(s)}");
    let t = py_strip(s);
    let cs: Vec[char] = t.chars().collect();
    let mut i = 0;
    let mut neg = false;
    if i < cs.len() and (cs[i] == '+' or cs[i] == '-') {
        neg = cs[i] == '-';
        i += 1;
    }
    let mut digits = String.new();
    let end = digit_run(cs, i, mut digits);
    if end != cs.len() or digits.len() == 0 {
        return Err(bad);
    }
    let v = to_i64(digits);
    Ok(if neg { -v } else { v })
}

fn lower_ascii(s: ref String) -> String {
    let lower: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut out = String.new();
    for c in s.chars() {
        if c >= 'A' and c <= 'Z' {
            out.push(lower[(c as i64) - 65]);
        } else {
            out.push(c);
        }
    }
    out
}

// float(s)
fn py_float(s: ref String) -> Result[f64, String] {
    let bad = val_err(f"could not convert string to float: {py_repr_str(s)}");
    let t = py_strip(s);
    let cs: Vec[char] = t.chars().collect();
    let mut i = 0;
    let mut neg = false;
    if i < cs.len() and (cs[i] == '+' or cs[i] == '-') {
        neg = cs[i] == '-';
        i += 1;
    }
    let word = lower_ascii(slice_chars(cs, i, cs.len()));
    if word == "inf" or word == "infinity" {
        return Ok(if neg { -f64.INFINITY } else { f64.INFINITY });
    }
    if word == "nan" {
        return Ok(NAN_F);
    }
    let mut text = String.new();
    let mut ip = String.new();
    let mut e = digit_run(cs, i, mut ip);
    if e < 0 {
        return Err(bad);
    }
    let mut fp = String.new();
    if e < cs.len() and cs[e] == '.' {
        e = digit_run(cs, e + 1, mut fp);
        if e < 0 {
            return Err(bad);
        }
    }
    if ip.len() == 0 and fp.len() == 0 {
        return Err(bad);
    }
    text.push_str(if ip.len() == 0 { "0" } else { ip });
    text.push_str(".");
    text.push_str(if fp.len() == 0 { "0" } else { fp });
    if e < cs.len() and (cs[e] == 'e' or cs[e] == 'E') {
        let mut k = e + 1;
        let mut esign = "";
        if k < cs.len() and (cs[k] == '+' or cs[k] == '-') {
            esign = if cs[k] == '-' { "-" } else { "+" };
            k += 1;
        }
        let mut ed = String.new();
        let e2 = digit_run(cs, k, mut ed);
        if e2 < 0 or ed.len() == 0 {
            return Err(bad);
        }
        text.push_str(f"e{esign}{ed}");
        e = e2;
    }
    if e != cs.len() {
        return Err(bad);
    }
    let v = to_f64(text);
    Ok(if neg { -v } else { v })
}

// ------------------------------------------------------ gravity, Alpha-5

struct Grav {
    tumin: f64,
    mu: f64,
    radiusearthkm: f64,
    xke: f64,
    j2: f64,
    j3: f64,
    j4: f64,
    j3oj2: f64,
}

fn getgravconst(name: ref String) -> Grav {
    let mut mu = 398600.5;
    let mut radiusearthkm = 6378.137;
    let mut j2 = 0.00108262998905;
    let mut j3 = -2.53215306e-06;
    let mut j4 = -1.61098761e-06;
    let mut xke = 0.0;
    if name == "wgs72old" {
        mu = 398600.79964;
        radiusearthkm = 6378.135;
        xke = 0.0743669161;
        j2 = 0.001082616;
        j3 = -2.53881e-06;
        j4 = -1.65597e-06;
    } else if name == "wgs72" {
        mu = 398600.8;
        radiusearthkm = 6378.135;
        xke = 60.0 / (radiusearthkm * radiusearthkm * radiusearthkm / mu).sqrt();
        j2 = 0.001082616;
        j3 = -2.53881e-06;
        j4 = -1.65597e-06;
    } else {
        xke = 60.0 / (radiusearthkm * radiusearthkm * radiusearthkm / mu).sqrt();
    }
    Grav { tumin: 1.0 / xke, mu: mu, radiusearthkm: radiusearthkm, xke: xke, j2: j2, j3: j3, j4: j4, j3oj2: j3 / j2 }
}

fn zfill(n: i64, w: i64) -> String {
    let mut s = f"{n}";
    while s.len() < w {
        s = f"0{s}";
    }
    s
}

fn to_alpha5(n: i64) -> Result[String, String] {
    if n < 100000 {
        return Ok(zfill(n, 5));
    }
    if n > 339999 {
        return Err(val_err("satellite number cannot exceed 339999, whose Alpha 5 encoding is 'Z9999'"));
    }
    let mut i = idiv(n, 10000) + 65 - 10;
    let r = imod(n, 10000);
    if i >= 73 {
        i += 1;
    }
    if i >= 79 {
        i += 1;
    }
    let upper: Vec[char] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".chars().collect();
    Ok(f"{upper[i - 65]}{zfill(r, 4)}")
}

fn from_alpha5(s: ref String) -> Result[i64, String] {
    let cs: Vec[char] = s.chars().collect();
    if cs.len() == 0 {
        return Err("IndexError: 'string index out of range'".to_string());
    }
    if not is_alpha(cs[0]) {
        return py_int(s);
    }
    let c = cs[0];
    let mut n = (c as i64) - 65 + 10;
    if c > 'I' {
        n -= 1;
    }
    if c > 'O' {
        n -= 1;
    }
    let rest = py_int(slice_chars(cs, 1, cs.len()))?;
    Ok(n * 10000 + rest)
}

// ------------------------------------------------------------ dates

// functions.jday: the date and the fraction of the day, as two floats
fn jday2(year: i64, mon: i64, day: i64, hr: i64, minute: i64, sec: f64) -> (f64, f64) {
    let y = year as f64;
    let m = mon as f64;
    let jd = 367.0 * y - floordiv(7.0 * (y + floordiv(m + 9.0, 12.0)) * 0.25, 1.0)
        + floordiv(275.0 * m / 9.0, 1.0) + (day as f64) + 1721013.5;
    let fr = (sec + (minute as f64) * 60.0 + (hr as f64) * 3600.0) / 86400.0;
    (jd, fr)
}

// ext.jday: one float
fn jday1(year: i64, mon: i64, day: i64, hr: i64, minute: i64, sec: f64) -> f64 {
    let y = year as f64;
    let m = mon as f64;
    367.0 * y - floordiv(7.0 * (y + floordiv(m + 9.0, 12.0)) * 0.25, 1.0) + floordiv(275.0 * m, 9.0)
        + (day as f64) + 1721013.5 + ((sec / 60.0 + (minute as f64)) / 60.0 + (hr as f64)) / 24.0
}

fn day_of_year_to_month_day(day_of_year: i64, is_leap: bool) -> (i64, i64) {
    let lp = if is_leap { 1 } else { 0 };
    let february_bump = (2 - lp) * (if day_of_year >= 60 + lp { 1 } else { 0 });
    let august = if day_of_year >= 215 { 1 } else { 0 };
    let v = 2 * (day_of_year - 1 + 30 * august + february_bump);
    let mut month = idiv(v, 61);
    let mut day = imod(v, 61);
    month += 1 - august;
    day = idiv(day, 2);
    day += 1;
    (month, day)
}

// days2mdhms(year, days, round_to_microsecond): (month, day, hour, minute,
// second); rnd is 6, or 0 for the None that invjday passes
fn days2mdhms(year: i64, days: f64, rnd: i64) -> (i64, i64, i64, i64, f64) {
    let mut second = days * 86400.0;
    if rnd != 0 {
        second = py_round(second, rnd);
    }
    let (mf, s2) = py_divmod(second, 60.0);
    second = s2;
    if rnd != 0 {
        second = py_round(second, rnd);
    }
    let mut minute = mf as i64;
    let mut hour = idiv(minute, 60);
    minute = imod(minute, 60);
    let day_of_year = idiv(hour, 24);
    hour = imod(hour, 24);
    let is_leap = imod(year, 400) == 0 or (imod(year, 4) == 0 and imod(year, 100) != 0);
    let mut (month, day) = day_of_year_to_month_day(day_of_year, is_leap);
    if month == 13 {
        month = 12;
        day += 31;
    }
    (month, day, hour, minute, second)
}

fn invjday(jd: f64) -> (i64, i64, i64, i64, i64, f64) {
    let temp = jd - 2415019.5;
    let tu = temp / 365.25;
    let mut year = 1900 + (floordiv(tu, 1.0) as i64);
    let mut leapyrs = floordiv(((year - 1901) as f64) * 0.25, 1.0) as i64;
    let mut days = temp - (((year - 1900) as f64) * 365.0 + (leapyrs as f64)) + 1e-11;
    if days < 1.0 {
        year = year - 1;
        leapyrs = floordiv(((year - 1901) as f64) * 0.25, 1.0) as i64;
        days = temp - (((year - 1900) as f64) * 365.0 + (leapyrs as f64));
    }
    let (mon, day, hr, minute, sec) = days2mdhms(year, days, 0);
    (year, mon, day, hr, minute, sec - 8.64e-07)
}

// ------------------------------------------------- ext: orbital elements

fn mag(x: (f64, f64, f64)) -> f64 {
    (x.0 * x.0 + x.1 * x.1 + x.2 * x.2).sqrt()
}

fn dot(x: (f64, f64, f64), y: (f64, f64, f64)) -> f64 {
    x.0 * y.0 + x.1 * y.1 + x.2 * y.2
}

fn cross(a: (f64, f64, f64), b: (f64, f64, f64)) -> (f64, f64, f64) {
    (a.1 * b.2 - a.2 * b.1, a.2 * b.0 - a.0 * b.2, a.0 * b.1 - a.1 * b.0)
}

fn angle(v1: (f64, f64, f64), v2: (f64, f64, f64)) -> f64 {
    let small = 1e-08;
    let magv1 = mag(v1);
    let magv2 = mag(v2);
    if magv1 * magv2 > small * small {
        let mut temp = dot(v1, v2) / (magv1 * magv2);
        if temp.abs() > 1.0 {
            let one = 1.0;
            temp = one.copysign(temp);
        }
        temp.acos()
    } else {
        999999.1
    }
}

fn clip1(t: f64) -> f64 {
    if t.abs() > 1.0 {
        let one = 1.0;
        one.copysign(t)
    } else {
        t
    }
}

fn newtonnu(ecc: f64, nu: f64) -> (f64, f64) {
    let mut e0 = 999999.9;
    let mut m = 999999.9;
    let small = 1e-08;
    if ecc.abs() < small {
        m = nu;
        e0 = nu;
    } else if ecc < 1.0 - small {
        let sine = (1.0 - ecc * ecc).sqrt() * nu.sin() / (1.0 + ecc * nu.cos());
        let cose = (ecc + nu.cos()) / (1.0 + ecc * nu.cos());
        e0 = sine.atan2(cose);
        m = e0 - ecc * e0.sin();
    } else if ecc > 1.0 + small {
        if ecc > 1.0 and nu.abs() + 1e-05 < PI - (1.0 / ecc).acos() {
            let sine = (ecc * ecc - 1.0).sqrt() * nu.sin() / (1.0 + ecc * nu.cos());
            e0 = sine.asinh();
            m = ecc * e0.sinh() - e0;
        }
    } else if nu.abs() < 168.0 * PI / 180.0 {
        e0 = (nu * 0.5).tan();
        m = e0 + e0 * e0 * e0 / 3.0;
    }
    if ecc < 1.0 {
        m = m % (2.0 * PI);
        if m < 0.0 {
            m = m + 2.0 * PI;
        }
        e0 = e0 % (2.0 * PI);
    }
    (e0, m)
}

struct Coe {
    p: f64,
    a: f64,
    ecc: f64,
    incl: f64,
    omega: f64,
    argp: f64,
    nu: f64,
    m: f64,
    arglat: f64,
    truelon: f64,
    lonper: f64,
}

fn rv2coe(r: (f64, f64, f64), v: (f64, f64, f64), mu: f64) -> Coe {
    let twopi = 2.0 * PI;
    let halfpi = 0.5 * PI;
    let small = 1e-08;
    let undefined = 999999.1;
    let infinite = 999999.9;
    let magr = mag(r);
    let magv = mag(v);
    let hbar = cross(r, v);
    let magh = mag(hbar);
    let mut c = Coe { p: undefined, a: undefined, ecc: undefined, incl: undefined, omega: undefined,
                      argp: undefined, nu: undefined, m: undefined, arglat: undefined,
                      truelon: undefined, lonper: undefined };
    if magh > small {
        let nbar = (-hbar.1, hbar.0, 0.0);
        let magn = mag(nbar);
        let c1 = magv * magv - mu / magr;
        let rdotv = dot(r, v);
        let ebar = ((c1 * r.0 - rdotv * v.0) / mu, (c1 * r.1 - rdotv * v.1) / mu, (c1 * r.2 - rdotv * v.2) / mu);
        let ecc = mag(ebar);
        c.ecc = ecc;
        let sme = magv * magv * 0.5 - mu / magr;
        c.a = if sme.abs() > small { -mu / (2.0 * sme) } else { infinite };
        c.p = magh * magh / mu;
        let hk = hbar.2 / magh;
        let incl = hk.acos();
        c.incl = incl;
        let mut typeorbit = "ei";
        if ecc < small {
            if incl < small or (incl - PI).abs() < small {
                typeorbit = "ce";
            } else {
                typeorbit = "ci";
            }
        } else if incl < small or (incl - PI).abs() < small {
            typeorbit = "ee";
        }
        if magn > small {
            let temp = clip1(nbar.0 / magn);
            c.omega = temp.acos();
            if nbar.1 < 0.0 {
                c.omega = twopi - c.omega;
            }
        }
        if typeorbit == "ei" {
            c.argp = angle(nbar, ebar);
            if ebar.2 < 0.0 {
                c.argp = twopi - c.argp;
            }
        }
        let elliptic = typeorbit == "ei" or typeorbit == "ee";
        if elliptic {
            c.nu = angle(ebar, r);
            if rdotv < 0.0 {
                c.nu = twopi - c.nu;
            }
        }
        if typeorbit == "ci" {
            c.arglat = angle(nbar, r);
            if r.2 < 0.0 {
                c.arglat = twopi - c.arglat;
            }
            c.m = c.arglat;
        }
        if ecc > small and typeorbit == "ee" {
            let temp = clip1(ebar.0 / ecc);
            c.lonper = temp.acos();
            if ebar.1 < 0.0 {
                c.lonper = twopi - c.lonper;
            }
            if incl > halfpi {
                c.lonper = twopi - c.lonper;
            }
        }
        if magr > small and typeorbit == "ce" {
            let temp = clip1(r.0 / magr);
            c.truelon = temp.acos();
            if r.1 < 0.0 {
                c.truelon = twopi - c.truelon;
            }
            if incl > halfpi {
                c.truelon = twopi - c.truelon;
            }
            c.m = c.truelon;
        }
        if elliptic {
            let (_, mm) = newtonnu(ecc, c.nu);
            c.m = mm;
        }
    }
    c
}

