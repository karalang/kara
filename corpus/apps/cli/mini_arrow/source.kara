// mini_arrow: arrow 1.3.0, the Python date and time library, ported to
// Kāra with the parts of python-dateutil 2.9.0.post0 it stands on (tz,
// relativedelta). It runs a list of jobs through arrow's API (construction,
// get() and its parsers, format(), to(), shift(), replace(), span(),
// range(), humanize(), dehumanize(), comparisons) and then four small
// tools built on it: a log normalizer, a meeting planner, a billing period
// splitter and an activity feed. The output matches oracle.py, which runs
// the same jobs through the real library.
//
// Patterns go through a port of Python's re (from mini_parse), since
// arrow builds its parsers and its formatter out of regular expressions.

// ------------------------------------------------------------ JSON in

// The jobs file holds strings, numbers, booleans, arrays and objects.
#[derive(Clone)]
enum J {
    S(String),
    N(i64),
    // a number with a fraction or an exponent, and its text
    F(f64, String),
    A(Vec[J]),
    O(Vec[(String, J)]),
    B(bool),
    Null,
}

fn json_space(c: char) -> bool {
    c == ' ' or c == '\n' or c == '\r' or c == '\t'
}

struct JsonIn {
    cs: Vec[char],
    pos: i64,
}

impl JsonIn {
    fn ws(mut ref self) {
        while self.pos < self.cs.len() and json_space(self.cs[self.pos]) {
            self.pos += 1;
        }
    }

    fn word(mut ref self, w: Str) -> bool {
        let wc: Vec[char] = w.chars().collect();
        if self.pos + wc.len() > self.cs.len() {
            return false;
        }
        let mut k = 0;
        while k < wc.len() {
            if self.cs[self.pos + k] != wc[k] {
                return false;
            }
            k += 1;
        }
        self.pos += wc.len();
        true
    }

    fn hex4(mut ref self) -> u32 {
        let mut n: u32 = 0;
        let mut k = 0;
        while k < 4 {
            let c = self.cs[self.pos];
            let d = if c >= '0' and c <= '9' {
                (c as u32) - ('0' as u32)
            } else if c >= 'a' and c <= 'f' {
                (c as u32) - ('a' as u32) + 10
            } else {
                (c as u32) - ('A' as u32) + 10
            };
            n = n * 16 + d;
            self.pos += 1;
            k += 1;
        }
        n
    }

    fn value(mut ref self) -> Result[J, String] {
        self.ws();
        if self.pos >= self.cs.len() {
            return Err("unexpected end of JSON".to_string());
        }
        let c = self.cs[self.pos];
        if c == '[' {
            self.pos += 1;
            let mut items: Vec[J] = Vec.new();
            self.ws();
            if self.pos < self.cs.len() and self.cs[self.pos] == ']' {
                self.pos += 1;
                return Ok(J.A(items));
            }
            loop {
                items.push(self.value()?);
                self.ws();
                if self.pos >= self.cs.len() {
                    return Err("unterminated JSON array".to_string());
                }
                let d = self.cs[self.pos];
                self.pos += 1;
                if d == ']' {
                    return Ok(J.A(items));
                }
                if d != ',' {
                    return Err(f"bad JSON array separator {d}");
                }
            }
        }
        if c == '{' {
            self.pos += 1;
            let mut members: Vec[(String, J)] = Vec.new();
            self.ws();
            if self.pos < self.cs.len() and self.cs[self.pos] == '}' {
                self.pos += 1;
                return Ok(J.O(members));
            }
            loop {
                let key = match self.value()? {
                    J.S(k) => k,
                    _ => return Err("JSON object key is not a string".to_string()),
                };
                self.ws();
                if self.pos >= self.cs.len() or self.cs[self.pos] != ':' {
                    return Err("missing ':' in JSON object".to_string());
                }
                self.pos += 1;
                let v = self.value()?;
                members.push((key, v));
                self.ws();
                if self.pos >= self.cs.len() {
                    return Err("unterminated JSON object".to_string());
                }
                let d = self.cs[self.pos];
                self.pos += 1;
                if d == '}' {
                    return Ok(J.O(members));
                }
                if d != ',' {
                    return Err(f"bad JSON object separator {d}");
                }
            }
        }
        if self.word("true") {
            return Ok(J.B(true));
        }
        if self.word("false") {
            return Ok(J.B(false));
        }
        if self.word("null") {
            return Ok(J.Null);
        }
        if c == '-' or (c >= '0' and c <= '9') {
            let start = self.pos;
            let mut neg = false;
            if c == '-' {
                neg = true;
                self.pos += 1;
            }
            let mut n: i64 = 0;
            while self.pos < self.cs.len() and self.cs[self.pos] >= '0' and self.cs[self.pos] <= '9' {
                n = n * 10 + ((self.cs[self.pos] as u32) - ('0' as u32)) as i64;
                self.pos += 1;
            }
            if self.pos < self.cs.len() and (self.cs[self.pos] == '.' or self.cs[self.pos] == 'e' or self.cs[self.pos] == 'E') {
                while self.pos < self.cs.len() and (self.cs[self.pos] == '.' or self.cs[self.pos] == 'e' or self.cs[self.pos] == 'E' or self.cs[self.pos] == '+' or self.cs[self.pos] == '-' or (self.cs[self.pos] >= '0' and self.cs[self.pos] <= '9')) {
                    self.pos += 1;
                }
                let mut text = String.new();
                let mut k = start;
                while k < self.pos {
                    text.push(self.cs[k]);
                    k += 1;
                }
                return match f64.parse(text.as_str()) {
                    Ok(x) => Ok(J.F(x, text)),
                    Err(_) => Err(f"bad JSON number {text}"),
                };
            }
            return Ok(J.N(if neg { -n } else { n }));
        }
        if c != '"' {
            return Err(f"unexpected JSON character {c}");
        }
        self.pos += 1;
        let mut s = String.new();
        while self.pos < self.cs.len() {
            let d = self.cs[self.pos];
            self.pos += 1;
            if d == '"' {
                return Ok(J.S(s));
            }
            if d != '\\' {
                s.push(d);
                continue;
            }
            let e = self.cs[self.pos];
            self.pos += 1;
            if e == 'n' {
                s.push('\n');
            } else if e == 't' {
                s.push('\t');
            } else if e == 'r' {
                s.push('\r');
            } else if e == 'b' {
                s.push('\u{8}');
            } else if e == 'f' {
                s.push('\u{c}');
            } else if e == 'u' {
                let mut n = self.hex4();
                if n >= 0xD800 and n < 0xDC00 {
                    self.pos += 2;
                    let lo = self.hex4();
                    n = 0x10000 + ((n - 0xD800) << 10) + (lo - 0xDC00);
                }
                s.push(char.try_from(n).unwrap_or('?'));
            } else {
                s.push(e);
            }
        }
        Err("unterminated JSON string".to_string())
    }
}

fn json_line(l: ref String) -> Result[J, String] {
    let mut p = JsonIn { cs: l.chars().collect(), pos: 0 };
    p.value()
}

fn j_get(j: ref J, key: Str) -> J {
    match j {
        J.O(members) => {
            for (k, v) in members.iter() {
                if k == key {
                    return v.clone();
                }
            }
            J.Null
        }
        _ => J.Null,
    }
}

fn j_has(j: ref J, key: Str) -> bool {
    match j_get(j, key) {
        J.Null => false,
        _ => true,
    }
}

fn j_str(j: ref J, key: Str) -> String {
    match j_get(j, key) {
        J.S(s) => s,
        _ => String.new(),
    }
}

fn j_int(j: ref J, key: Str, default: i64) -> i64 {
    match j_get(j, key) {
        J.N(n) => n,
        _ => default,
    }
}

fn j_bool(j: ref J, key: Str) -> bool {
    match j_get(j, key) {
        J.B(b) => b,
        _ => false,
    }
}

fn j_strs(j: ref J, key: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    if let J.A(items) = j_get(j, key) {
        for it in items.iter() {
            if let J.S(s) = it {
                out.push(s.clone());
            }
        }
    }
    out
}

// ------------------------------------------------------------ text as code points

fn cps(s: Str) -> Vec[i64] {
    codepoints(s.bytes())
}

fn cps_of(s: ref String) -> Vec[i64] {
    codepoints(s.bytes())
}

fn cat(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut out = a.clone();
    push_all(mut out, b);
    out
}

fn cat_ascii(a: ref Vec[i64], s: Str) -> Vec[i64] {
    let mut out = a.clone();
    push_ascii(mut out, s);
    out
}

fn index_of(s: ref Vec[i64], c: i64) -> i64 {
    let mut i = 0;
    while i < s.len() {
        if s[i] == c {
            return i;
        }
        i += 1;
    }
    -1
}

fn has(s: ref Vec[i64], c: i64) -> bool {
    index_of(s, c) >= 0
}

// `needle in s` for str
fn contains_seq(s: ref Vec[i64], needle: ref Vec[i64]) -> bool {
    find_seq(s, needle, 0) >= 0
}

fn find_seq(s: ref Vec[i64], needle: ref Vec[i64], from: i64) -> i64 {
    let mut i = from;
    while i + needle.len() <= s.len() {
        let mut k = 0;
        while k < needle.len() and s[i + k] == needle[k] {
            k += 1;
        }
        if k == needle.len() {
            return i;
        }
        i += 1;
    }
    -1
}

fn starts_with_seq(s: ref Vec[i64], p: Str) -> bool {
    let n = cps(p);
    if n.len() > s.len() {
        return false;
    }
    let mut k = 0;
    while k < n.len() {
        if s[k] != n[k] {
            return false;
        }
        k += 1;
    }
    true
}

fn eq_ascii(s: ref Vec[i64], p: Str) -> bool {
    same(s, cps(p))
}

// One character in a str of ASCII choices.
fn in_ascii(c: i64, set: Str) -> bool {
    for b in set.bytes() {
        if (b as i64) == c {
            return true;
        }
    }
    false
}

// str.replace
fn replace_seq(s: ref Vec[i64], old: ref Vec[i64], new: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < s.len() {
        if old.len() > 0 and i + old.len() <= s.len() {
            let mut k = 0;
            while k < old.len() and s[i + k] == old[k] {
                k += 1;
            }
            if k == old.len() {
                push_all(mut out, new);
                i += old.len();
                continue;
            }
        }
        out.push(s[i]);
        i += 1;
    }
    out
}

fn replace_char(s: ref Vec[i64], old: i64, new: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s {
        if c == old {
            push_all(mut out, new);
        } else {
            out.push(c);
        }
    }
    out
}

fn repeat(c: i64, n: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < n {
        out.push(c);
        k += 1;
    }
    out
}

// str.split(sep) for a one-character separator
fn split_on(s: ref Vec[i64], sep: i64) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    for c in s {
        if c == sep {
            out.push(cur);
            cur = Vec.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn strip(s: ref Vec[i64]) -> Vec[i64] {
    let mut a = 0;
    let mut b = s.len();
    while a < b and is_space(s[a], false) {
        a += 1;
    }
    while b > a and is_space(s[b - 1], false) {
        b -= 1;
    }
    slice(s, a, b)
}

fn lower_all(s: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s {
        out.push(lower(c, false));
    }
    out
}

fn upper_all(s: ref Vec[i64]) -> Vec[i64] {
    cps_of(to_string(s).to_uppercase())
}

fn is_alpha_cp(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

// str.isupper
fn is_upper_str(s: ref Vec[i64]) -> bool {
    let mut cased = false;
    for c in s {
        if lower(c, false) != c {
            cased = true;
        } else if upper(c, false) != c {
            return false;
        }
    }
    cased
}

// The value of a decimal digit: the decimal digits come in runs of ten.
fn digit_value(c: i64) -> i64 {
    if c < 0x80 {
        return c - 48;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return c - s;
        }
    }
    0
}

// str.isdigit, for the strings date_convert looks at
fn all_decimal(s: ref Vec[i64]) -> bool {
    if s.len() == 0 {
        return false;
    }
    for c in s {
        if not is_decimal(c) {
            return false;
        }
    }
    true
}

fn pad_n(n: i64, width: i64) -> String {
    let mut s = f"{n}";
    while s.len() < width {
        s = f"0{s}";
    }
    s
}

fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

fn floor_mod(a: i64, b: i64) -> i64 {
    a - floor_div(a, b) * b
}
// ------------------------------------------------------------ errors

struct ReErr {
    kind: String,
    msg: String,
    pos: i64,
}

fn re_error(msg: own String, pos: i64) -> ReErr {
    ReErr { kind: "error".to_string(), msg: msg, pos: pos }
}

fn other_error(kind: Str, msg: own String) -> ReErr {
    ReErr { kind: kind.to_string(), msg: msg, pos: -1 }
}

fn err_text(e: ref ReErr) -> String {
    if e.kind == "error" {
        if e.pos >= 0 {
            return f"error: {e.msg} at position {e.pos}";
        }
        return f"error: {e.msg}";
    }
    f"{e.kind}: {e.msg}"
}

// -------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for cp in s {
        if cp < 0x80 {
            out.push(cp as u8);
        } else if cp < 0x800 {
            out.push((0xC0 | (cp >> 6)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else if cp < 0x10000 {
            out.push((0xE0 | (cp >> 12)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (cp >> 18)) as u8);
            out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

fn str_repr(s: ref Vec[i64], out: mut ref Vec[i64]) {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
}

fn repr_of(s: ref Vec[i64]) -> String {
    let mut out: Vec[i64] = Vec.new();
    str_repr(s, mut out);
    to_string(out)
}

// ----------------------------------------------------- character kinds

fn is_decimal(c: i64) -> bool {
    if c < 0x80 {
        return c >= 48 and c <= 57;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return true;
        }
    }
    false
}

fn is_space(c: i64, ascii: bool) -> bool {
    if c == 32 or (c >= 9 and c <= 13) {
        return true;
    }
    if ascii {
        return false;
    }
    (c >= 0x1C and c <= 0x1F) or c == 0x85 or c == 0xA0 or c == 0x1680 or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F or c == 0x3000
}

fn as_char(c: i64) -> Option[char] {
    if c < 0 or (c >= 0xD800 and c <= 0xDFFF) or c > 0x10FFFF {
        return None;
    }
    char.try_from(c as u32).ok()
}

fn is_word(c: i64, ascii: bool) -> bool {
    if c < 0x80 {
        return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
    }
    if ascii {
        return false;
    }
    match as_char(c) {
        Some(ch) => ch.is_alphanumeric(),
        None => false,
    }
}

fn lower(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 65 and c <= 90 { c + 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_lowercase() as u32 as i64,
        None => c,
    }
}

fn upper(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 97 and c <= 122 { c - 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_uppercase() as u32 as i64,
        None => c,
    }
}

// ------------------------------------------------------- parsed form

// The categories of \d \D \s \S \w \W.
fn cat_digit() -> i64 { 0 }
fn cat_not_digit() -> i64 { 1 }
fn cat_space() -> i64 { 2 }
fn cat_not_space() -> i64 { 3 }
fn cat_word() -> i64 { 4 }
fn cat_not_word() -> i64 { 5 }

// The positions ^ $ \A \Z \b \B and the forms the compiler turns them
// into under MULTILINE.
fn at_beginning() -> i64 { 0 }
fn at_beginning_line() -> i64 { 1 }
fn at_beginning_string() -> i64 { 2 }
fn at_end() -> i64 { 3 }
fn at_end_line() -> i64 { 4 }
fn at_end_string() -> i64 { 5 }
fn at_boundary() -> i64 { 6 }
fn at_non_boundary() -> i64 { 7 }

#[derive(Clone)]
enum Item {
    Lit(i64),
    Range(i64, i64),
    Cat(i64),
}

enum Node {
    Lit(i64),
    NotLit(i64),
    Any,
    In(Vec[Item], bool),
    At(i64),
    Branch(Vec[Vec[Node]]),
    // group (0: none), flags turned on, flags turned off, contents
    Group(i64, i64, i64, Vec[Node]),
    // 0 greedy, 1 lazy, 2 possessive; min; max; the item repeated
    Repeat(i64, i64, i64, Vec[Node]),
    Atomic(Vec[Node]),
    // direction (1 ahead, -1 behind), negative, contents
    Assert(i64, bool, Vec[Node]),
    GroupRef(i64),
    // group, yes branch, no branch
    Exists(i64, Vec[Node], Vec[Node]),
    Failure,
}

fn is_repeat(n: ref Node) -> bool {
    match n {
        Node.Repeat(_, _, _, _) => true,
        _ => false,
    }
}

fn is_at(n: ref Node) -> bool {
    match n {
        Node.At(_) => true,
        _ => false,
    }
}

fn flag_i() -> i64 { 2 }
fn flag_l() -> i64 { 4 }
fn flag_m() -> i64 { 8 }
fn flag_s() -> i64 { 16 }
fn flag_u() -> i64 { 32 }
fn flag_x() -> i64 { 64 }
fn flag_a() -> i64 { 256 }
fn type_flags() -> i64 { 4 | 32 | 256 }
fn maxrepeat() -> i64 { 4294967295 }
fn maxgroups() -> i64 { 1073741823 }
fn maxwidth() -> i64 { 1 << 62 }

fn flag_value(c: i64) -> i64 {
    match c {
        105 => 2,
        76 => 4,
        109 => 8,
        115 => 16,
        120 => 64,
        97 => 256,
        117 => 32,
        _ => 0,
    }
}

// ------------------------------------------------------------ tokens

// One token: nothing at the end of the pattern (n 0), a character (n 1),
// or a backslash and the character after it (n 2).
#[derive(Copy, Clone)]
struct T {
    n: i64,
    a: i64,
    b: i64,
}

fn tok_none() -> T {
    T { n: 0, a: 0, b: 0 }
}

fn tok_is(t: T, c: i64) -> bool {
    t.n == 1 and t.a == c
}

fn tok_text(t: T) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    if t.n >= 1 {
        v.push(t.a);
    }
    if t.n == 2 {
        v.push(t.b);
    }
    v
}

fn is_ascii_letter(c: i64) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

fn is_hex(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

fn is_oct(c: i64) -> bool {
    c >= 48 and c <= 55
}

fn is_dec(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn digits_value(s: ref Vec[i64], start: i64, base: i64) -> i64 {
    let mut v = 0;
    let mut i = start;
    while i < s.len() {
        let c = s[i];
        let d = if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 };
        v = v * base + d;
        i += 1;
    }
    v
}

// str.isidentifier, near enough: a letter or underscore, then letters,
// digits and underscores.
fn is_identifier(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    let mut i = 0;
    while i < name.len() {
        let c = name[i];
        let ok = if c == 95 {
            true
        } else if i == 0 {
            match as_char(c) {
                Some(ch) => ch.is_alphabetic(),
                None => false,
            }
        } else {
            is_word(c, false)
        };
        if not ok {
            return false;
        }
        i += 1;
    }
    true
}

fn is_ascii_decimal(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    for c in name {
        if not is_dec(c) {
            return false;
        }
    }
    true
}

struct Tokenizer {
    s: Vec[i64],
    index: i64,
    next: T,
}

impl Tokenizer {
    fn advance(mut ref self) -> Result[(), ReErr] {
        let index = self.index;
        if index >= self.s.len() {
            self.next = tok_none();
            return Ok(());
        }
        let c = self.s[index];
        if c == 92 {
            if index + 1 >= self.s.len() {
                return Err(re_error("bad escape (end of pattern)".to_string(), self.s.len() - 1));
            }
            self.next = T { n: 2, a: 92, b: self.s[index + 1] };
            self.index = index + 2;
        } else {
            self.next = T { n: 1, a: c, b: 0 };
            self.index = index + 1;
        }
        Ok(())
    }

    fn get(mut ref self) -> Result[T, ReErr] {
        let t = self.next;
        self.advance()?;
        Ok(t)
    }

    fn take(mut ref self, c: i64) -> Result[bool, ReErr] {
        if tok_is(self.next, c) {
            self.advance()?;
            return Ok(true);
        }
        Ok(false)
    }

    fn tell(ref self) -> i64 {
        self.index - self.next.n
    }

    fn seek(mut ref self, index: i64) -> Result[(), ReErr] {
        self.index = index;
        self.advance()
    }

    fn error(ref self, msg: own String, offset: i64) -> ReErr {
        re_error(msg, self.tell() - offset)
    }

    // getwhile: up to n characters of a kind (0 octal, 1 decimal, 2 hex).
    fn getwhile(mut ref self, n: i64, kind: i64, out: mut ref Vec[i64]) -> Result[(), ReErr] {
        let mut k = 0;
        while k < n {
            let t = self.next;
            if t.n != 1 {
                break;
            }
            let ok = if kind == 0 { is_oct(t.a) } else if kind == 1 { is_dec(t.a) } else { is_hex(t.a) };
            if not ok {
                break;
            }
            out.push(t.a);
            self.advance()?;
            k += 1;
        }
        Ok(())
    }

    fn getuntil(mut ref self, terminator: i64, name: Str) -> Result[Vec[i64], ReErr] {
        let mut result: Vec[i64] = Vec.new();
        loop {
            let c = self.next;
            self.advance()?;
            if c.n == 0 {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 0));
                }
                let term = to_string(vec_of(terminator));
                return Err(self.error(f"missing {term}, unterminated name", result.len()));
            }
            if tok_is(c, terminator) {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 1));
                }
                break;
            }
            push_all(mut result, tok_text(c));
        }
        Ok(result)
    }

    fn checkgroupname(ref self, name: ref Vec[i64], offset: i64) -> Result[(), ReErr] {
        if not is_identifier(name) {
            return Err(self.error(f"bad character in group name {repr_of(name)}", name.len() + offset));
        }
        Ok(())
    }
}

fn vec_of(c: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(c);
    v
}

fn new_tokenizer(s: ref Vec[i64]) -> Result[Tokenizer, ReErr] {
    let mut t = Tokenizer { s: s.clone(), index: 0, next: tok_none() };
    t.advance()?;
    Ok(t)
}

// ------------------------------------------------------------ parser

#[derive(Clone)]
struct Width {
    lo: i64,
    hi: i64,
}

struct ParseState {
    flags: i64,
    names: Vec[(Vec[i64], i64)],
    // per group: whether it is closed, and its width
    closed: Vec[bool],
    widths: Vec[Width],
    lookbehind_groups: i64,
    // conditional references by number, in order: (group, position)
    refpos: Vec[(i64, i64)],
}

impl ParseState {
    fn groups(ref self) -> i64 {
        self.closed.len()
    }

    fn group_of(ref self, name: ref Vec[i64]) -> i64 {
        for (n, g) in self.names.iter() {
            if same(n, name) {
                return g;
            }
        }
        -1
    }

    fn checkgroup(ref self, gid: i64) -> bool {
        gid < self.groups() and self.closed[gid]
    }

    fn checklookbehindgroup(ref self, gid: i64, src: ref Tokenizer) -> Result[(), ReErr] {
        if self.lookbehind_groups >= 0 {
            if not self.checkgroup(gid) {
                return Err(src.error("cannot refer to an open group".to_string(), 0));
            }
            if gid >= self.lookbehind_groups {
                return Err(src.error("cannot refer to group defined in the same lookbehind subpattern".to_string(), 0));
            }
        }
        Ok(())
    }
}

fn add_width(a: i64, b: i64) -> i64 {
    if a >= maxwidth() - b { maxwidth() } else { a + b }
}

fn mul_width(a: i64, n: i64) -> i64 {
    if a == 0 or n == 0 {
        0
    } else if a >= maxwidth() / n {
        maxwidth()
    } else {
        a * n
    }
}

// SubPattern.getwidth.
fn width_of(widths: ref Vec[Width], p: ref Vec[Node]) -> Width {
    let mut lo = 0;
    let mut hi = 0;
    for n in p.iter() {
        match n {
            Node.Branch(items) => {
                let mut i = maxwidth();
                let mut j = 0;
                for item in items.iter() {
                    let w = width_of(widths, item);
                    if w.lo < i {
                        i = w.lo;
                    }
                    if w.hi > j {
                        j = w.hi;
                    }
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Atomic(body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Group(_, _, _, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Repeat(_, min, max, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, mul_width(w.lo, min));
                if max == maxrepeat() and w.hi > 0 {
                    hi = maxwidth();
                } else {
                    hi = add_width(hi, mul_width(w.hi, max));
                }
            }
            Node.GroupRef(g) => {
                let w = ref widths[g];
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Exists(_, yes, no) => {
                let wy = width_of(widths, yes);
                let mut i = wy.lo;
                let mut j = wy.hi;
                if no.len() > 0 {
                    let wn = width_of(widths, no);
                    if wn.lo < i {
                        i = wn.lo;
                    }
                    if wn.hi > j {
                        j = wn.hi;
                    }
                } else {
                    i = 0;
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Lit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.NotLit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.Any => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.In(_, _) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            _ => {}
        }
    }
    Width { lo: lo, hi: hi }
}

fn category_of(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        100 => 0,
        68 => 1,
        115 => 2,
        83 => 3,
        119 => 4,
        87 => 5,
        _ => -1,
    }
}

fn escape_value(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        97 => 7,
        98 => 8,
        102 => 12,
        110 => 10,
        114 => 13,
        116 => 9,
        118 => 11,
        92 => 92,
        _ => -1,
    }
}

// \x, \u and \U: the escape text so far, and the code point.
fn hex_escape(src: mut ref Tokenizer, t: T, esc: mut ref Vec[i64]) -> Result[i64, ReErr] {
    let n = if t.b == 120 { 2 } else if t.b == 117 { 4 } else { 8 };
    src.getwhile(n, 2, mut esc)?;
    if esc.len() != n + 2 {
        return Err(src.error(f"incomplete escape {to_string(esc)}", esc.len()));
    }
    let c = digits_value(esc, 2, 16);
    if c > 0x10FFFF {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(c)
}

// _class_escape: an escape inside [...], a literal or a category.
fn class_escape(src: mut ref Tokenizer, t: T) -> Result[Item, ReErr] {
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Item.Lit(e));
    }
    let cat = category_of(t);
    if cat >= 0 {
        return Ok(Item.Cat(cat));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Item.Lit(v));
    }
    if is_oct(c) {
        src.getwhile(2, 0, mut esc)?;
        let v = digits_value(esc, 1, 8);
        if v > 0o377 {
            return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
        }
        return Ok(Item.Lit(v));
    }
    if is_dec(c) or is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Item.Lit(c))
}

// _escape: an escape outside a set.
fn escape(src: mut ref Tokenizer, t: T, st: ref ParseState) -> Result[Node, ReErr] {
    let cat = category_of(t);
    if cat >= 0 {
        let mut items: Vec[Item] = Vec.new();
        items.push(Item.Cat(cat));
        return Ok(Node.In(items, false));
    }
    match t.b {
        65 => return Ok(Node.At(at_beginning_string())),
        98 => return Ok(Node.At(at_boundary())),
        66 => return Ok(Node.At(at_non_boundary())),
        90 => return Ok(Node.At(at_end_string())),
        _ => {}
    }
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Node.Lit(e));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Node.Lit(v));
    }
    if c == 48 {
        src.getwhile(2, 0, mut esc)?;
        return Ok(Node.Lit(digits_value(esc, 1, 8)));
    }
    if is_dec(c) {
        // an octal escape or a group reference
        let nt = src.next;
        if nt.n == 1 and is_dec(nt.a) {
            esc.push(nt.a);
            src.advance()?;
            let nt2 = src.next;
            if is_oct(esc[1]) and is_oct(esc[2]) and nt2.n == 1 and is_oct(nt2.a) {
                esc.push(nt2.a);
                src.advance()?;
                let v = digits_value(esc, 1, 8);
                if v > 0o377 {
                    return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
                }
                return Ok(Node.Lit(v));
            }
        }
        let group = digits_value(esc, 1, 10);
        if group < st.groups() {
            if not st.checkgroup(group) {
                return Err(src.error("cannot refer to an open group".to_string(), esc.len()));
            }
            st.checklookbehindgroup(group, src)?;
            return Ok(Node.GroupRef(group));
        }
        return Err(src.error(f"invalid group reference {group}", esc.len() - 1));
    }
    if is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Node.Lit(c))
}

fn parse_sub(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64) -> Result[Vec[Node], ReErr] {
    let mut items: Vec[Vec[Node]] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let first = nested == 0 and items.len() == 0;
        let item = parse_seq(mut src, mut st, verbose, nested + 1, first)?;
        items.push(item);
        if not src.take(124)? {
            break;
        }
        if nested == 0 {
            verbose = (st.flags & flag_x()) != 0;
        }
    }
    if items.len() == 1 {
        return Ok(items.pop().unwrap());
    }
    let mut out: Vec[Node] = Vec.new();
    out.push(Node.Branch(items));
    Ok(out)
}

// _parse_flags: None (as Err-free Ok(None)) for global flags, else the
// flags turned on and off.
fn parse_flags(src: mut ref Tokenizer, st: mut ref ParseState, first_char: T) -> Result[Option[(i64, i64)], ReErr] {
    let mut ch = first_char;
    let mut add = 0;
    let mut del = 0;
    if not tok_is(ch, 45) {
        loop {
            let flag = flag_value(ch.a);
            if ch.a == 76 {
                return Err(src.error("bad inline flags: cannot use 'L' flag with a str pattern".to_string(), 0));
            }
            add = add | flag;
            if (flag & type_flags()) != 0 and (add & type_flags()) != flag {
                return Err(src.error("bad inline flags: flags 'a', 'u' and 'L' are incompatible".to_string(), 0));
            }
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing -, : or )".to_string(), 0));
            }
            if tok_is(ch, 41) or tok_is(ch, 45) or tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing -, : or )" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if tok_is(ch, 41) {
        st.flags = st.flags | add;
        return Ok(None);
    }
    if tok_is(ch, 45) {
        ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("missing flag".to_string(), 0));
        }
        if ch.n != 1 or flag_value(ch.a) == 0 {
            let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing flag" };
            return Err(src.error(msg.to_string(), ch.n));
        }
        loop {
            let flag = flag_value(ch.a);
            if (flag & type_flags()) != 0 {
                return Err(src.error("bad inline flags: cannot turn off flags 'a', 'u' and 'L'".to_string(), 0));
            }
            del = del | flag;
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing :".to_string(), 0));
            }
            if tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing :" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if (add & del) != 0 {
        return Err(src.error("bad inline flags: flag turned on and off".to_string(), 1));
    }
    Ok(Some((add, del)))
}

fn is_alpha(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

fn parse_set(src: mut ref Tokenizer, out: mut ref Vec[Node]) -> Result[(), ReErr] {
    let here = src.tell() - 1;
    let mut set: Vec[Item] = Vec.new();
    let negate = src.take(94)?;
    loop {
        let this = src.get()?;
        if this.n == 0 {
            return Err(src.error("unterminated character set".to_string(), src.tell() - here));
        }
        if tok_is(this, 93) and set.len() > 0 {
            break;
        }
        let code1 = if this.n == 2 { class_escape(mut src, this)? } else { Item.Lit(this.a) };
        if src.take(45)? {
            let that = src.get()?;
            if that.n == 0 {
                return Err(src.error("unterminated character set".to_string(), src.tell() - here));
            }
            if tok_is(that, 93) {
                set.push(code1);
                set.push(Item.Lit(45));
                break;
            }
            let code2 = if that.n == 2 { class_escape(mut src, that)? } else { Item.Lit(that.a) };
            let text = f"{to_string(tok_text(this))}-{to_string(tok_text(that))}";
            let offset = this.n + 1 + that.n;
            let lo = match code1 {
                Item.Lit(c) => c,
                _ => -1,
            };
            let hi = match code2 {
                Item.Lit(c) => c,
                _ => -1,
            };
            if lo < 0 or hi < 0 or hi < lo {
                return Err(src.error(f"bad character range {text}", offset));
            }
            set.push(Item.Range(lo, hi));
        } else {
            set.push(code1);
        }
    }
    if set.len() == 1 {
        let only = ref set[0];
        if let Item.Lit(c) = only {
            if negate {
                out.push(Node.NotLit(c));
            } else {
                out.push(Node.Lit(c));
            }
            return Ok(());
        }
    }
    out.push(Node.In(set, negate));
    Ok(())
}

// The quantifier just read (its first character is `this`), applied to
// the last item. Returns false when `{` turned out to be a literal.
fn parse_repeat(src: mut ref Tokenizer, this: T, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let here = src.tell();
    let mut min = 0;
    let mut max = maxrepeat();
    if tok_is(this, 63) {
        max = 1;
    } else if tok_is(this, 43) {
        min = 1;
    } else if tok_is(this, 123) {
        if tok_is(src.next, 125) {
            out.push(Node.Lit(123));
            return Ok(false);
        }
        let mut lo: Vec[i64] = Vec.new();
        let mut hi: Vec[i64] = Vec.new();
        while src.next.n == 1 and is_dec(src.next.a) {
            lo.push(src.get()?.a);
        }
        if src.take(44)? {
            while src.next.n == 1 and is_dec(src.next.a) {
                hi.push(src.get()?.a);
            }
        } else {
            hi = lo.clone();
        }
        if not src.take(125)? {
            out.push(Node.Lit(123));
            src.seek(here)?;
            return Ok(false);
        }
        if lo.len() > 0 {
            if lo.len() > 10 or digits_value(lo, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            min = digits_value(lo, 0, 10);
        }
        if hi.len() > 0 {
            if hi.len() > 10 or digits_value(hi, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            max = digits_value(hi, 0, 10);
            if max < min {
                return Err(src.error("min repeat greater than max repeat".to_string(), src.tell() - here));
            }
        }
    }
    if out.len() == 0 or is_at(out[out.len() - 1]) {
        return Err(src.error("nothing to repeat".to_string(), src.tell() - here + 1));
    }
    if is_repeat(out[out.len() - 1]) {
        return Err(src.error("multiple repeat".to_string(), src.tell() - here + 1));
    }
    let last = out.pop().unwrap();
    let mut body: Vec[Node] = Vec.new();
    match last {
        Node.Group(0, 0, 0, p) => body = p,
        other => body.push(other),
    }
    let kind = if src.take(63)? { 1 } else if src.take(43)? { 2 } else { 0 };
    out.push(Node.Repeat(kind, min, max, body));
    Ok(true)
}

fn parse_seq(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64, first: bool) -> Result[Vec[Node], ReErr] {
    let mut out: Vec[Node] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let this = src.next;
        if this.n == 0 or tok_is(this, 124) or tok_is(this, 41) {
            break;
        }
        src.advance()?;
        if verbose {
            if this.n == 1 and (this.a == 32 or (this.a >= 9 and this.a <= 13)) {
                continue;
            }
            if tok_is(this, 35) {
                loop {
                    let t = src.get()?;
                    if t.n == 0 or tok_is(t, 10) {
                        break;
                    }
                }
                continue;
            }
        }
        if this.n == 2 {
            let node = escape(mut src, this, st)?;
            out.push(node);
            continue;
        }
        let c = this.a;
        if c == 91 {
            parse_set(mut src, mut out)?;
        } else if c == 42 or c == 43 or c == 63 or c == 123 {
            parse_repeat(mut src, this, mut out)?;
        } else if c == 46 {
            out.push(Node.Any);
        } else if c == 94 {
            out.push(Node.At(at_beginning()));
        } else if c == 36 {
            out.push(Node.At(at_end()));
        } else if c == 40 {
            if parse_group(mut src, mut st, mut verbose, nested, first, mut out)? {
                continue;
            }
        } else {
            out.push(Node.Lit(c));
        }
    }
    Ok(out)
}

// `(` and what follows. Returns true for a construct that adds nothing
// (a comment, global flags).
fn parse_group(src: mut ref Tokenizer, st: mut ref ParseState, verbose: mut ref bool, nested: i64, first: bool, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let start = src.tell() - 1;
    let mut capture = true;
    let mut atomic = false;
    let mut name: Vec[i64] = Vec.new();
    let mut named = false;
    let mut add = 0;
    let mut del = 0;
    if src.take(63)? {
        let ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("unexpected end of pattern".to_string(), 0));
        }
        if tok_is(ch, 80) {
            if src.take(60)? {
                name = src.getuntil(62, "group name")?;
                src.checkgroupname(name, 1)?;
                named = true;
            } else if src.take(61)? {
                let ref_name = src.getuntil(41, "group name")?;
                src.checkgroupname(ref_name, 1)?;
                let gid = st.group_of(ref_name);
                if gid < 0 {
                    return Err(src.error(f"unknown group name {repr_of(ref_name)}", ref_name.len() + 1));
                }
                if not st.checkgroup(gid) {
                    return Err(src.error("cannot refer to an open group".to_string(), ref_name.len() + 1));
                }
                st.checklookbehindgroup(gid, src)?;
                out.push(Node.GroupRef(gid));
                return Ok(true);
            } else {
                let c2 = src.get()?;
                if c2.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                return Err(src.error(f"unknown extension ?P{to_string(tok_text(c2))}", c2.n + 2));
            }
        } else if tok_is(ch, 58) {
            capture = false;
        } else if tok_is(ch, 35) {
            loop {
                if src.next.n == 0 {
                    return Err(src.error("missing ), unterminated comment".to_string(), src.tell() - start));
                }
                if tok_is(src.get()?, 41) {
                    break;
                }
            }
            return Ok(true);
        } else if tok_is(ch, 61) or tok_is(ch, 33) or tok_is(ch, 60) {
            let mut kind = ch;
            let mut dir = 1;
            let mut outer_lookbehind = 0;
            if tok_is(ch, 60) {
                kind = src.get()?;
                if kind.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                if not (tok_is(kind, 61) or tok_is(kind, 33)) {
                    return Err(src.error(f"unknown extension ?<{to_string(tok_text(kind))}", kind.n + 2));
                }
                dir = -1;
                outer_lookbehind = st.lookbehind_groups;
                if outer_lookbehind < 0 {
                    st.lookbehind_groups = st.groups();
                }
            }
            let p = parse_sub(mut src, mut st, *verbose, nested + 1)?;
            if dir < 0 and outer_lookbehind < 0 {
                st.lookbehind_groups = -1;
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            if tok_is(kind, 61) {
                out.push(Node.Assert(dir, false, p));
            } else if p.len() > 0 {
                out.push(Node.Assert(dir, true, p));
            } else {
                out.push(Node.Failure);
            }
            return Ok(true);
        } else if tok_is(ch, 40) {
            let condname = src.getuntil(41, "group name")?;
            let mut condgroup = 0;
            if not is_ascii_decimal(condname) {
                src.checkgroupname(condname, 1)?;
                condgroup = st.group_of(condname);
                if condgroup < 0 {
                    return Err(src.error(f"unknown group name {repr_of(condname)}", condname.len() + 1));
                }
            } else {
                if condname.len() > 10 {
                    return Err(src.error(f"invalid group reference {to_string(condname)}", condname.len() + 1));
                }
                condgroup = digits_value(condname, 0, 10);
                if condgroup == 0 {
                    return Err(src.error("bad group number".to_string(), condname.len() + 1));
                }
                if condgroup >= maxgroups() {
                    return Err(src.error(f"invalid group reference {condgroup}", condname.len() + 1));
                }
                let mut seen = false;
                for (g, _) in st.refpos.iter() {
                    if g == condgroup {
                        seen = true;
                    }
                }
                if not seen {
                    st.refpos.push((condgroup, src.tell() - condname.len() - 1));
                }
            }
            st.checklookbehindgroup(condgroup, src)?;
            let yes = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
            let mut no: Vec[Node] = Vec.new();
            if src.take(124)? {
                no = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
                if tok_is(src.next, 124) {
                    return Err(src.error("conditional backref with more than two branches".to_string(), 0));
                }
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            out.push(Node.Exists(condgroup, yes, no));
            return Ok(true);
        } else if tok_is(ch, 62) {
            capture = false;
            atomic = true;
        } else if (ch.n == 1 and flag_value(ch.a) != 0) or tok_is(ch, 45) {
            match parse_flags(mut src, mut st, ch)? {
                None => {
                    if not first or out.len() > 0 {
                        return Err(src.error("global flags not at the start of the expression".to_string(), src.tell() - start));
                    }
                    *verbose = (st.flags & flag_x()) != 0;
                    return Ok(true);
                }
                Some((a, d)) => {
                    add = a;
                    del = d;
                    capture = false;
                }
            }
        } else {
            return Err(src.error(f"unknown extension ?{to_string(tok_text(ch))}", ch.n + 1));
        }
    }
    let mut group = 0;
    if capture {
        group = st.groups();
        st.closed.push(false);
        st.widths.push(Width { lo: 0, hi: 0 });
        if named {
            let was = st.group_of(name);
            if was >= 0 {
                return Err(src.error(f"redefinition of group name {repr_of(name)} as group {group}; was group {was}", name.len() + 1));
            }
            st.names.push((name.clone(), group));
        }
    }
    let sub_verbose = (*verbose or (add & flag_x()) != 0) and (del & flag_x()) == 0;
    let p = parse_sub(mut src, mut st, sub_verbose, nested + 1)?;
    if not src.take(41)? {
        return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
    }
    if group > 0 {
        let w = width_of(st.widths, p);
        st.widths[group] = w;
        st.closed[group] = true;
    }
    if atomic {
        out.push(Node.Atomic(p));
    } else {
        out.push(Node.Group(group, add, del, p));
    }
    Ok(false)
}

struct Parsed {
    nodes: Vec[Node],
    flags: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
    widths: Vec[Width],
}

fn parse(pattern: ref Vec[i64], flags: i64) -> Result[Parsed, ReErr] {
    let mut src = new_tokenizer(pattern)?;
    let mut st = ParseState {
        flags: flags,
        names: Vec.new(),
        closed: Vec.new(),
        widths: Vec.new(),
        lookbehind_groups: -1,
        refpos: Vec.new(),
    };
    // group 0 is the whole match
    st.closed.push(true);
    st.widths.push(Width { lo: 0, hi: 0 });
    let nodes = parse_sub(mut src, mut st, (flags & flag_x()) != 0, 0)?;
    if (st.flags & flag_a()) != 0 and (st.flags & flag_u()) != 0 {
        return Err(other_error("ValueError", "ASCII and UNICODE flags are incompatible".to_string()));
    }
    if src.next.n != 0 {
        return Err(src.error("unbalanced parenthesis".to_string(), 0));
    }
    for (g, pos) in st.refpos.iter() {
        if g >= st.groups() {
            return Err(re_error(f"invalid group reference {g}", pos));
        }
    }
    let groups = st.groups() - 1;
    Ok(Parsed { nodes: nodes, flags: st.flags, groups: groups, names: st.names, widths: st.widths })
}

// ---------------------------------------------------------- compiler

enum Op {
    // character (lowered when case-insensitive), case-insensitive, ASCII
    Lit(i64, bool, bool),
    NotLit(i64, bool, bool),
    Any,
    AnyAll,
    // set, case-insensitive, ASCII-only categories
    In(i64, bool, bool),
    // anchor kind, ASCII-only word boundary
    At(i64, bool),
    Mark(i64),
    Split(i64, i64),
    Jmp(i64),
    // repeat register, the Until it starts at
    RepInit(i64, i64),
    // register, min, max, greedy, body, exit
    Until(i64, i64, i64, bool, i64, i64),
    Ref(i64, bool, bool),
    // lookbehind width (-1 for lookahead), negative, sub-program, next
    Look(i64, bool, i64, i64),
    Atomic(i64, i64),
    Exists(i64, i64),
    Fail,
    Succeed,
    Match,
}

struct Program {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
}

struct CharSet {
    items: Vec[Item],
    negate: bool,
}

fn combine(flags: i64, add: i64, del: i64) -> i64 {
    let mut f = flags;
    if (add & type_flags()) != 0 {
        f = f & (0x7FFFFFFF ^ type_flags());
    }
    (f | add) & (0x7FFFFFFF ^ del)
}

struct Compiler {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
}

impl Compiler {
    fn emit(mut ref self, op: own Op) -> i64 {
        self.ops.push(op);
        self.ops.len() - 1
    }

    fn here(ref self) -> i64 {
        self.ops.len()
    }

    fn compile(mut ref self, p: ref Parsed, nodes: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let icase = (flags & flag_i()) != 0;
        let ascii = (flags & flag_a()) != 0;
        for n in nodes.iter() {
            match n {
                Node.Lit(c) => {
                    let v = if icase { lower(c, ascii) } else { c };
                    self.emit(Op.Lit(v, icase, ascii));
                }
                Node.NotLit(c) => {
                    let v = if icase { lower(c, ascii) } else { c };
                    self.emit(Op.NotLit(v, icase, ascii));
                }
                Node.Any => {
                    if (flags & flag_s()) != 0 {
                        self.emit(Op.AnyAll);
                    } else {
                        self.emit(Op.Any);
                    }
                }
                Node.In(items, negate) => {
                    self.sets.push(CharSet { items: items.clone(), negate: negate });
                    let idx = self.sets.len() - 1;
                    self.emit(Op.In(idx, icase, ascii));
                }
                Node.At(kind) => {
                    let mut k = kind;
                    if (flags & flag_m()) != 0 {
                        if k == at_beginning() {
                            k = at_beginning_line();
                        } else if k == at_end() {
                            k = at_end_line();
                        }
                    }
                    self.emit(Op.At(k, ascii));
                }
                Node.Branch(items) => {
                    let mut ends: Vec[i64] = Vec.new();
                    let mut i = 0;
                    while i < items.len() {
                        if i + 1 < items.len() {
                            let split = self.emit(Op.Fail);
                            self.compile(p, items[i], flags)?;
                            ends.push(self.emit(Op.Fail));
                            let next = self.here();
                            self.ops[split] = Op.Split(split + 1, next);
                        } else {
                            self.compile(p, items[i], flags)?;
                        }
                        i += 1;
                    }
                    let end = self.here();
                    for at in ends {
                        self.ops[at] = Op.Jmp(end);
                    }
                }
                Node.Group(g, add, off, body) => {
                    if g > 0 {
                        self.emit(Op.Mark(2 * g));
                    }
                    self.compile(p, body, combine(flags, add, off))?;
                    if g > 0 {
                        self.emit(Op.Mark(2 * g + 1));
                    }
                }
                Node.Repeat(kind, min, max, body) => {
                    if kind == 2 {
                        let at = self.emit(Op.Fail);
                        self.compile_repeat(p, min, max, true, body, flags)?;
                        self.emit(Op.Succeed);
                        let next = self.here();
                        self.ops[at] = Op.Atomic(at + 1, next);
                    } else {
                        self.compile_repeat(p, min, max, kind == 0, body, flags)?;
                    }
                }
                Node.Atomic(body) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Atomic(at + 1, next);
                }
                Node.Assert(dir, negative, body) => {
                    let mut width = -1;
                    if dir < 0 {
                        let w = width_of(p.widths, body);
                        if w.lo != w.hi {
                            return Err(other_error("error", "look-behind requires fixed-width pattern".to_string()));
                        }
                        width = w.lo;
                    }
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Look(width, negative, at + 1, next);
                }
                Node.GroupRef(g) => {
                    self.emit(Op.Ref(g, icase, ascii));
                }
                Node.Exists(g, yes, no) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, yes, flags)?;
                    if no.len() > 0 {
                        let jump = self.emit(Op.Fail);
                        let no_pc = self.here();
                        self.compile(p, no, flags)?;
                        let end = self.here();
                        self.ops[jump] = Op.Jmp(end);
                        self.ops[at] = Op.Exists(g, no_pc);
                    } else {
                        let end = self.here();
                        self.ops[at] = Op.Exists(g, end);
                    }
                }
                Node.Failure => {
                    self.emit(Op.Fail);
                }
            }
        }
        Ok(())
    }

    fn compile_repeat(mut ref self, p: ref Parsed, min: i64, max: i64, greedy: bool, body: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let r = self.repeats;
        self.repeats += 1;
        let init = self.emit(Op.Fail);
        self.compile(p, body, flags)?;
        let until = self.emit(Op.Fail);
        self.ops[init] = Op.RepInit(r, until);
        self.ops[until] = Op.Until(r, min, max, greedy, init + 1, until + 1);
        Ok(())
    }
}

fn compile(pattern: ref Vec[i64], flags: i64) -> Result[Program, ReErr] {
    let p = parse(pattern, flags)?;
    let mut c = Compiler { ops: Vec.new(), sets: Vec.new(), repeats: 0 };
    c.compile(p, p.nodes, p.flags)?;
    c.emit(Op.Match);
    Ok(Program { ops: c.ops, sets: c.sets, repeats: c.repeats, groups: p.groups, names: p.names })
}

// ----------------------------------------------------------- matcher

struct Undo {
    kind: i64,
    idx: i64,
    old: i64,
}

struct Choice {
    pc: i64,
    pos: i64,
    trail: i64,
    // 0: resume at pc; 1: a lazy repeat's Until, after its tail failed
    mode: i64,
}

struct Matcher {
    s: Vec[i64],
    marks: Vec[i64],
    counts: Vec[i64],
    lasts: Vec[i64],
    lastindex: i64,
    trail: Vec[Undo],
    start: i64,
    must_advance: bool,
    match_all: bool,
}

impl Matcher {
    fn set_mark(mut ref self, slot: i64, v: i64) {
        self.trail.push(Undo { kind: 0, idx: slot, old: self.marks[slot] });
        self.marks[slot] = v;
    }

    fn set_count(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 1, idx: r, old: self.counts[r] });
        self.counts[r] = v;
    }

    fn set_last(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 2, idx: r, old: self.lasts[r] });
        self.lasts[r] = v;
    }

    fn set_lastindex(mut ref self, v: i64) {
        self.trail.push(Undo { kind: 3, idx: 0, old: self.lastindex });
        self.lastindex = v;
    }

    fn undo_to(mut ref self, len: i64) {
        while self.trail.len() > len {
            let u = self.trail.pop().unwrap();
            if u.kind == 0 {
                self.marks[u.idx] = u.old;
            } else if u.kind == 1 {
                self.counts[u.idx] = u.old;
            } else if u.kind == 2 {
                self.lasts[u.idx] = u.old;
            } else {
                self.lastindex = u.old;
            }
        }
    }

    // A group that has both marks, the end not before the start.
    fn group_span(ref self, g: i64) -> (i64, i64) {
        let a = self.marks[2 * g];
        let b = self.marks[2 * g + 1];
        if a < 0 or b < 0 or b < a {
            return (-1, -1);
        }
        (a, b)
    }

    fn at(ref self, kind: i64, ascii: bool, pos: i64) -> bool {
        let n = self.s.len();
        if kind == 0 or kind == 2 {
            return pos == 0;
        }
        if kind == 1 {
            return pos == 0 or self.s[pos - 1] == 10;
        }
        if kind == 3 {
            return pos == n or (pos == n - 1 and self.s[pos] == 10);
        }
        if kind == 4 {
            return pos == n or self.s[pos] == 10;
        }
        if kind == 5 {
            return pos == n;
        }
        if n == 0 {
            return false;
        }
        let before = pos > 0 and is_word(self.s[pos - 1], ascii);
        let after = pos < n and is_word(self.s[pos], ascii);
        if kind == 6 { before != after } else { before == after }
    }

    // Runs the program from pc at pos, backtracking through its own
    // choices only. Returns where it succeeded, or -1.
    fn run(mut ref self, prog: ref Program, pc0: i64, pos0: i64, top: bool) -> i64 {
        let base = self.trail.len();
        let mut choices: Vec[Choice] = Vec.new();
        let mut pc = pc0;
        let mut pos = pos0;
        let mut mode = 0;
        loop {
            let mut ok = true;
            let op = ref prog.ops[pc];
            if mode == 1 {
                // a lazy repeat whose tail failed: try one more item
                mode = 0;
                ok = false;
                if let Op.Until(r, _, max, _, body, _) = op {
                    let count = self.counts[r] + 1;
                    if not ((count >= max and max != maxrepeat()) or pos == self.lasts[r]) {
                        self.set_count(r, count);
                        self.set_last(r, pos);
                        pc = body;
                        ok = true;
                    }
                }
                if ok {
                    continue;
                }
            } else {
                match op {
                    Op.Lit(c, icase, ascii) => {
                        if pos < self.s.len() and (if icase { lower(self.s[pos], ascii) == c } else { self.s[pos] == c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.NotLit(c, icase, ascii) => {
                        if pos < self.s.len() and (if icase { lower(self.s[pos], ascii) != c } else { self.s[pos] != c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Any => {
                        if pos < self.s.len() and self.s[pos] != 10 {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.AnyAll => {
                        if pos < self.s.len() {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.In(set, icase, ascii) => {
                        if pos < self.s.len() and in_set(prog.sets[set], self.s[pos], icase, ascii) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.At(kind, ascii) => {
                        if self.at(kind, ascii, pos) {
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Mark(slot) => {
                        self.set_mark(slot, pos);
                        if (slot & 1) == 1 {
                            self.set_lastindex(slot / 2);
                        }
                        pc += 1;
                    }
                    Op.Split(a, b) => {
                        choices.push(Choice { pc: b, pos: pos, trail: self.trail.len(), mode: 0 });
                        pc = a;
                    }
                    Op.Jmp(a) => pc = a,
                    Op.RepInit(r, until) => {
                        self.set_count(r, -1);
                        self.set_last(r, -1);
                        pc = until;
                    }
                    Op.Until(r, min, max, greedy, body, exit) => {
                        let count = self.counts[r] + 1;
                        if count < min {
                            self.set_count(r, count);
                            pc = body;
                        } else if greedy {
                            if (count < max or max == maxrepeat()) and pos != self.lasts[r] {
                                choices.push(Choice { pc: exit, pos: pos, trail: self.trail.len(), mode: 0 });
                                self.set_count(r, count);
                                self.set_last(r, pos);
                                pc = body;
                            } else {
                                pc = exit;
                            }
                        } else {
                            choices.push(Choice { pc: pc, pos: pos, trail: self.trail.len(), mode: 1 });
                            pc = exit;
                        }
                    }
                    Op.Ref(g, icase, ascii) => {
                        let (a, b) = self.group_span(g);
                        if a < 0 {
                            ok = false;
                        } else {
                            let len = b - a;
                            if pos + len > self.s.len() {
                                ok = false;
                            } else {
                                let mut k = 0;
                                while k < len {
                                    let x = self.s[a + k];
                                    let y = self.s[pos + k];
                                    let eq = if icase { lower(x, ascii) == lower(y, ascii) } else { x == y };
                                    if not eq {
                                        ok = false;
                                        break;
                                    }
                                    k += 1;
                                }
                                if ok {
                                    pos += len;
                                    pc += 1;
                                }
                            }
                        }
                    }
                    Op.Look(width, negative, sub, next) => {
                        let mark = self.trail.len();
                        let from = if width < 0 { pos } else { pos - width };
                        let found = from >= 0 and self.run(prog, sub, from, false) >= 0;
                        if negative {
                            self.undo_to(mark);
                            if found {
                                ok = false;
                            } else {
                                pc = next;
                            }
                        } else if found {
                            pc = next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Atomic(sub, next) => {
                        let end = self.run(prog, sub, pos, false);
                        if end >= 0 {
                            pos = end;
                            pc = next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Exists(g, no) => {
                        let (a, _) = self.group_span(g);
                        if a >= 0 {
                            pc += 1;
                        } else {
                            pc = no;
                        }
                    }
                    Op.Fail => ok = false,
                    Op.Succeed => return pos,
                    Op.Match => {
                        if top and ((self.match_all and pos != self.s.len()) or (self.must_advance and pos == self.start)) {
                            ok = false;
                        } else {
                            return pos;
                        }
                    }
                }
            }
            if not ok {
                match choices.pop() {
                    Some(ch) => {
                        self.undo_to(ch.trail);
                        pc = ch.pc;
                        pos = ch.pos;
                        mode = ch.mode;
                    }
                    None => {
                        self.undo_to(base);
                        return -1;
                    }
                }
            }
        }
    }
}

fn in_items(set: ref CharSet, c: i64, ascii: bool) -> bool {
    for item in set.items.iter() {
        let hit = match item {
            Item.Lit(l) => c == l,
            Item.Range(lo, hi) => c >= lo and c <= hi,
            Item.Cat(k) => {
                let kind = k;
                if kind == 0 {
                    if ascii { c >= 48 and c <= 57 } else { is_decimal(c) }
                } else if kind == 1 {
                    if ascii { not (c >= 48 and c <= 57) } else { not is_decimal(c) }
                } else if kind == 2 {
                    is_space(c, ascii)
                } else if kind == 3 {
                    not is_space(c, ascii)
                } else if kind == 4 {
                    is_word(c, ascii)
                } else {
                    not is_word(c, ascii)
                }
            }
        };
        if hit {
            return true;
        }
    }
    false
}

// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = lower(c, ascii);
        if lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program, s: ref Vec[i64]) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        s: s.clone(),
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn find(m: mut ref Matcher, prog: ref Program, from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= m.s.len() {
        let mut k = 0;
        while k < m.marks.len() {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}

// All the matches finditer gives: each search starts where the last
// match ended, and must move on past an empty one.
fn all_matches(prog: ref Program, s: ref Vec[i64], limit: i64) -> Vec[Found] {
    let mut m = new_matcher(prog, s);
    let mut out: Vec[Found] = Vec.new();
    let mut pos = 0;
    let mut must_advance = false;
    while pos <= s.len() and (limit == 0 or out.len() < limit) {
        match find(mut m, prog, pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    out
}

// ------------------------------------------------------------ Python values

// An exception as Python prints it: "ValueError: ...".
struct PyErr {
    kind: String,
    msg: String,
}

fn py_err(kind: Str, msg: own String) -> PyErr {
    PyErr { kind: kind.to_string(), msg: msg }
}

fn value_error(msg: own String) -> PyErr {
    py_err("ValueError", msg)
}

fn err_line(e: ref PyErr) -> String {
    f"{e.kind}: {e.msg}"
}

fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    if x == 1.0 / 0.0 {
        return "inf".to_string();
    }
    if x == -1.0 / 0.0 {
        return "-inf".to_string();
    }
    if x == 0.0 {
        return if x.to_bits() >> 63 == 1 { "-0.0".to_string() } else { "0.0".to_string() };
    }
    f"{x}"
}

// str(timedelta(microseconds=us))
fn td_str(us: i64) -> String {
    let days = floor_div(us, 86400000000);
    let rest = us - days * 86400000000;
    let secs = rest / 1000000;
    let micro = rest % 1000000;
    let mut s = f"{secs / 3600}:{pad_n((secs / 60) % 60, 2)}:{pad_n(secs % 60, 2)}";
    if micro != 0 {
        s = f"{s}.{pad_n(micro, 6)}";
    }
    if days != 0 {
        let plural = if days == 1 or days == -1 { "" } else { "s" };
        s = f"{days} day{plural}, {s}";
    }
    s
}

// repr(timedelta(microseconds=us))
fn td_repr(us: i64) -> String {
    let days = floor_div(us, 86400000000);
    let rest = us - days * 86400000000;
    let secs = rest / 1000000;
    let micro = rest % 1000000;
    let mut parts: Vec[String] = Vec.new();
    if days != 0 {
        parts.push(f"days={days}");
    }
    if secs != 0 {
        parts.push(f"seconds={secs}");
    }
    if micro != 0 {
        parts.push(f"microseconds={micro}");
    }
    if parts.len() == 0 {
        return "datetime.timedelta(0)".to_string();
    }
    f"datetime.timedelta({parts.join(", ")})"
}

// ------------------------------------------------------------ the calendar

fn is_leap(y: i64) -> bool {
    y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)
}

fn days_in_month(y: i64, m: i64) -> i64 {
    let dim = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    if m == 2 and is_leap(y) { 29 } else { dim[m] }
}

fn days_before_month(y: i64, m: i64) -> i64 {
    let dbm = [0, 0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
    dbm[m] + if m > 2 and is_leap(y) { 1 } else { 0 }
}

fn to_ordinal(y: i64, m: i64, d: i64) -> i64 {
    let y1 = y - 1;
    y1 * 365 + y1 / 4 - y1 / 100 + y1 / 400 + days_before_month(y, m) + d
}

// date.fromordinal
fn from_ordinal(ord: i64) -> (i64, i64, i64) {
    let mut n = ord - 1;
    let n400 = n / 146097;
    n = n % 146097;
    let mut year = n400 * 400 + 1;
    let n100 = n / 36524;
    n = n % 36524;
    let n4 = n / 1461;
    n = n % 1461;
    let n1 = n / 365;
    n = n % 365;
    year += n100 * 100 + n4 * 4 + n1;
    if n1 == 4 or n100 == 4 {
        return (year - 1, 12, 31);
    }
    let leap = n1 == 3 and (n4 != 24 or n100 == 3);
    let dbm = [0, 0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
    let dim = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    let mut month = (n + 50) >> 5;
    let mut preceding = dbm[month] + if month > 2 and leap { 1 } else { 0 };
    if preceding > n {
        month -= 1;
        preceding -= dim[month] + if month == 2 and leap { 1 } else { 0 };
    }
    n -= preceding;
    (year, month, n + 1)
}

fn weekday(y: i64, m: i64, d: i64) -> i64 {
    (to_ordinal(y, m, d) + 6) % 7
}

// The checks date() makes, in its order.
fn check_date(y: i64, m: i64, d: i64) -> Result[(), PyErr] {
    if y < 1 or y > 9999 {
        return Err(value_error(f"year {y} is out of range"));
    }
    if m < 1 or m > 12 {
        return Err(value_error("month must be in 1..12".to_string()));
    }
    if d < 1 or d > days_in_month(y, m) {
        return Err(value_error("day is out of range for month".to_string()));
    }
    Ok(())
}

// And the ones time() makes.
fn check_time(h: i64, mi: i64, s: i64, us: i64) -> Result[(), PyErr] {
    if h < 0 or h > 23 {
        return Err(value_error("hour must be in 0..23".to_string()));
    }
    if mi < 0 or mi > 59 {
        return Err(value_error("minute must be in 0..59".to_string()));
    }
    if s < 0 or s > 59 {
        return Err(value_error("second must be in 0..59".to_string()));
    }
    if us < 0 or us > 999999 {
        return Err(value_error("microsecond must be in 0..999999".to_string()));
    }
    Ok(())
}


fn date_iso(y: i64, m: i64, d: i64) -> String {
    f"{pad_n(y, 4)}-{pad_n(m, 2)}-{pad_n(d, 2)}"
}
// ------------------------------------------------------------ compiled patterns

// Every expression is compiled once; the jobs build many parsers from the
// same few templates.
struct Rx {
    progs: Vec[Program],
    index: Map[String, i64],
}

fn new_rx() -> Rx {
    Rx { progs: Vec.new(), index: Map.new() }
}

fn rx_compile(rx: mut ref Rx, pattern: ref Vec[i64], flags: i64) -> Result[i64, ReErr] {
    let key = f"{flags}:{to_string(pattern)}";
    if let Some(i) = rx.index.get(key) {
        return Ok(i);
    }
    let prog = compile(pattern, flags)?;
    rx.progs.push(prog);
    let i = rx.progs.len() - 1;
    rx.index.insert(key, i);
    Ok(i)
}

fn re_message(e: ref ReErr) -> String {
    if e.pos >= 0 { f"{e.msg} at position {e.pos}" } else { e.msg.clone() }
}

// re.error reaches the caller as re.PatternError, its name since 3.13.
fn pattern_error(e: ref ReErr) -> PyErr {
    if e.kind == "error" {
        return py_err("PatternError", re_message(e));
    }
    py_err(e.kind.as_str(), e.msg.clone())
}

fn flag_ignorecase() -> i64 { 2 }
fn flag_dotall() -> i64 { 16 }

fn group_of(s: ref Vec[i64], m: ref Found, g: i64) -> Option[Vec[i64]] {
    let (a, b) = m.spans[g - 1];
    if a < 0 { None } else { Some(slice(s, a, b)) }
}

fn named_group(prog: ref Program, name: ref Vec[i64]) -> i64 {
    for (n, g) in prog.names.iter() {
        if same(n, name) {
            return g;
        }
    }
    -1
}
// ------------------------------------------------------------ zones

// One _ttinfo of a tzfile. dstoffset is assigned while the transitions
// are read, and dateutil shares one object among all the transitions of a
// type, so the last assignment is the one that stays.
#[derive(Clone)]
struct TtInfo {
    offset: i64,
    isdst: bool,
    abbr: String,
    dstoffset: i64,
}

// dateutil's tzfile, which reads only the version 1 data of a TZif file:
// 32-bit transitions, and no POSIX rule for the years after them.
shared struct TzFile {
    filename: String,
    trans_list_utc: Vec[i64],
    trans_list: Vec[i64],
    // the ttinfo of each transition, as an index into ttinfo_list
    trans_idx: Vec[i64],
    ttinfo_list: Vec[TtInfo],
    // indexes into ttinfo_list, -1 for None
    ttinfo_std: i64,
    ttinfo_dst: i64,
    ttinfo_before: i64,
}

// A tzinfo. gettz caches every tzfile it opens, so two datetimes in one
// zone hold the same object; two tzoffsets with the same name and offset
// come out of one factory cache too. Equal values here are the same
// object there.
#[derive(Clone)]
enum Tz {
    Utc,
    // tzoffset(name, seconds)
    Offset(Option[String], i64),
    // tzlocal(), which is UTC: the run pins TZ=UTC
    Local,
    File(TzFile),
}

fn same_tz(a: ref Tz, b: ref Tz) -> bool {
    match (a, b) {
        (Tz.Utc, Tz.Utc) => true,
        (Tz.Local, Tz.Local) => true,
        (Tz.Offset(n1, s1), Tz.Offset(n2, s2)) => n1 == n2 and s1 == s2,
        (Tz.File(f1), Tz.File(f2)) => f1.filename == f2.filename,
        _ => false,
    }
}

fn be32(b: ref Vec[u8], at: i64) -> i64 {
    let v = ((b[at] as i64) << 24) | ((b[at + 1] as i64) << 16) | ((b[at + 2] as i64) << 8) | (b[at + 3] as i64);
    if v >= 0x80000000 { v - 0x100000000 } else { v }
}

fn signed8(x: u8) -> i64 {
    let v = x as i64;
    if v >= 128 { v - 256 } else { v }
}

// tzfile._read_tzfile
fn read_tzfile(path: ref String, b: ref Vec[u8]) -> Result[TzFile, PyErr] {
    if b.len() < 44 or b[0] != 84 or b[1] != 90 or b[2] != 105 or b[3] != 102 {
        return Err(value_error("magic not found".to_string()));
    }
    let ttisgmtcnt = be32(b, 20);
    let ttisstdcnt = be32(b, 24);
    let leapcnt = be32(b, 28);
    let timecnt = be32(b, 32);
    let typecnt = be32(b, 36);
    let charcnt = be32(b, 40);
    let _ = ttisgmtcnt;
    let _ = ttisstdcnt;
    let _ = leapcnt;
    let mut at = 44;
    let mut trans_list_utc: Vec[i64] = Vec.new();
    for _ in 0..timecnt {
        trans_list_utc.push(be32(b, at));
        at += 4;
    }
    let mut idx: Vec[i64] = Vec.new();
    for _ in 0..timecnt {
        idx.push(b[at] as i64);
        at += 1;
    }
    let mut raw: Vec[(i64, i64, i64)] = Vec.new();
    for _ in 0..typecnt {
        raw.push((be32(b, at), signed8(b[at + 4]), signed8(b[at + 5])));
        at += 6;
    }
    let abbr_bytes: Vec[u8] = b[at..at + charcnt].to_vec();
    let mut ttinfo_list: Vec[TtInfo] = Vec.new();
    for (gmtoff, isdst, abbrind) in raw {
        let mut end = abbrind;
        while end < abbr_bytes.len() and abbr_bytes[end] != 0 {
            end += 1;
        }
        let abbr = String.from_utf8(abbr_bytes[abbrind..end].to_vec()).unwrap_or(String.new());
        ttinfo_list.push(TtInfo { offset: gmtoff, isdst: isdst != 0, abbr: abbr, dstoffset: 0 });
    }
    let mut ttinfo_std = -1;
    let mut ttinfo_dst = -1;
    let mut ttinfo_before = -1;
    if ttinfo_list.len() > 0 {
        if trans_list_utc.len() == 0 {
            ttinfo_std = 0;
        } else {
            let mut i = timecnt - 1;
            while i >= 0 {
                let t = idx[i];
                if ttinfo_std < 0 and not ttinfo_list[t].isdst {
                    ttinfo_std = t;
                } else if ttinfo_dst < 0 and ttinfo_list[t].isdst {
                    ttinfo_dst = t;
                }
                if ttinfo_std >= 0 and ttinfo_dst >= 0 {
                    break;
                }
                i -= 1;
            }
            if i < 0 and ttinfo_dst >= 0 and ttinfo_std < 0 {
                ttinfo_std = ttinfo_dst;
            }
            let mut k = 0;
            while k < ttinfo_list.len() {
                if not ttinfo_list[k].isdst {
                    ttinfo_before = k;
                    break;
                }
                k += 1;
            }
            if ttinfo_before < 0 {
                ttinfo_before = 0;
            }
        }
    }
    // The wall-clock time of each transition, in standard time on its
    // way into DST and in the old base offset across a change of base.
    let mut lastdst: Option[bool] = None;
    let mut lastoffset = 0;
    let mut lastdstoffset = 0;
    let mut lastbaseoffset: Option[i64] = None;
    let mut trans_list: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < idx.len() {
        let t = idx[i];
        let offset = ttinfo_list[t].offset;
        let isdst = ttinfo_list[t].isdst;
        let mut dstoffset = 0;
        if let Some(ld) = lastdst {
            if isdst {
                if not ld {
                    dstoffset = offset - lastoffset;
                }
                if dstoffset == 0 and lastdstoffset != 0 {
                    dstoffset = lastdstoffset;
                }
                ttinfo_list[t].dstoffset = dstoffset;
                lastdstoffset = dstoffset;
            }
        }
        let baseoffset = offset - dstoffset;
        let mut adjustment = baseoffset;
        if let Some(lb) = lastbaseoffset {
            if baseoffset != lb and Some(isdst) != lastdst {
                adjustment = lb;
            }
        }
        lastdst = Some(isdst);
        lastoffset = offset;
        lastbaseoffset = Some(baseoffset);
        trans_list.push(trans_list_utc[i] + adjustment);
        i += 1;
    }
    Ok(TzFile {
        filename: path.clone(),
        trans_list_utc: trans_list_utc,
        trans_list: trans_list,
        trans_idx: idx,
        ttinfo_list: ttinfo_list,
        ttinfo_std: ttinfo_std,
        ttinfo_dst: ttinfo_dst,
        ttinfo_before: ttinfo_before,
    })
}

// The zone directory: dateutil's TZPATHS, pinned to it by the oracle.
fn zone_dir() -> Str { "data/zones" }

// gettz(name) for a name that is not empty: a file under the zone
// directory, trying the name with its spaces as underscores too. Not
// found, it is UTC for "GMT" and "UTC" and tzlocal() for the local
// zone's names, which are UTC's here; the names the jobs use have no
// digits, so the tzstr fallback never comes up.
fn gettz(name: ref String) -> Option[Tz] {
    let mut n = name.clone();
    if n.starts_with(":") {
        n = n[1..].to_string();
    }
    if n.starts_with("/") {
        return None;
    }
    let mut paths: Vec[String] = Vec.new();
    paths.push(f"{zone_dir()}/{n}");
    paths.push(f"{zone_dir()}/{n.replace(" ", "_")}");
    for p in paths {
        if let Ok(b) = fs.read_bytes(p.clone()) {
            if let Ok(f) = read_tzfile(p, b) {
                return Some(Tz.File(f));
            }
        }
    }
    if n == "GMT" or n == "UTC" {
        return Some(Tz.Utc);
    }
    None
}

// bisect.bisect_right(trans_list, timestamp) - 1, in microseconds
fn last_transition(list: ref Vec[i64], ts_us: i64) -> i64 {
    let mut lo = 0;
    let mut hi = list.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if ts_us < list[mid] * 1000000 {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    lo - 1
}

impl TzFile {
    // _find_last_transition; None when the file has no transitions
    fn find_last(ref self, t: ref DateTime, in_utc: bool) -> Option[i64] {
        if self.trans_list.len() == 0 {
            return None;
        }
        let ts = naive_us(t) - epoch_us();
        Some(if in_utc { last_transition(self.trans_list_utc, ts) } else { last_transition(self.trans_list, ts) })
    }

    // _get_ttinfo: an index into ttinfo_list. The last transition reads
    // as standard time, like every time after it.
    fn get_ttinfo(ref self, idx: Option[i64]) -> i64 {
        match idx {
            None => self.ttinfo_std,
            Some(i) => {
                if i + 1 >= self.trans_list.len() {
                    self.ttinfo_std
                } else if i < 0 {
                    self.ttinfo_before
                } else {
                    self.trans_idx[i]
                }
            }
        }
    }

    fn is_ambiguous_at(ref self, t: ref DateTime, idx0: Option[i64]) -> bool {
        let idx = match idx0 {
            Some(i) => Some(i),
            None => self.find_last(t, false),
        };
        let ts = naive_us(t) - epoch_us();
        let tti = self.get_ttinfo(idx);
        match idx {
            None => false,
            Some(i) => {
                if i <= 0 {
                    return false;
                }
                let od = self.ttinfo_list[self.get_ttinfo(Some(i - 1))].offset - self.ttinfo_list[tti].offset;
                let tt = self.trans_list[i];
                ts < (tt + od) * 1000000
            }
        }
    }

    // _resolve_ambiguous_time, then _get_ttinfo
    fn find_ttinfo(ref self, t: ref DateTime) -> i64 {
        let idx = self.find_last(t, false);
        let resolved = match idx {
            None => None,
            Some(0) => Some(0),
            Some(i) => {
                if t.fold == 0 and self.is_ambiguous_at(t, Some(i)) { Some(i - 1) } else { Some(i) }
            }
        };
        self.get_ttinfo(resolved)
    }

    fn utcoffset(ref self, t: ref DateTime) -> i64 {
        if self.ttinfo_std < 0 {
            return 0;
        }
        self.ttinfo_list[self.find_ttinfo(t)].offset
    }

    fn dst(ref self, t: ref DateTime) -> i64 {
        if self.ttinfo_dst < 0 {
            return 0;
        }
        let tti = ref self.ttinfo_list[self.find_ttinfo(t)];
        if not tti.isdst { 0 } else { tti.dstoffset }
    }

    fn tzname(ref self, t: ref DateTime) -> Option[String] {
        if self.ttinfo_std < 0 {
            return None;
        }
        Some(self.ttinfo_list[self.find_ttinfo(t)].abbr.clone())
    }

    // tzfile.fromutc: t holds UTC's wall time and this zone
    fn fromutc(ref self, t: ref DateTime) -> Result[DateTime, PyErr] {
        let idx = self.find_last(t, true);
        let tti = self.get_ttinfo(idx);
        let mut out = add_us(t, self.ttinfo_list[tti].offset * 1000000)?;
        out.fold = if self.is_ambiguous_at(out, idx) { 1 } else { 0 };
        Ok(out)
    }
}

fn tz_repr(z: ref Tz) -> String {
    match z {
        Tz.Utc => "tzutc()".to_string(),
        Tz.Local => "tzlocal()".to_string(),
        Tz.Offset(name, secs) => {
            let n = match name {
                Some(s) => repr_of(cps_of(s)),
                None => "None".to_string(),
            };
            f"tzoffset({n}, {secs})"
        }
        Tz.File(f) => f"tzfile({repr_of(cps_of(f.filename))})",
    }
}

// ------------------------------------------------------------ datetime

#[derive(Clone)]
struct DateTime {
    y: i64,
    mo: i64,
    d: i64,
    h: i64,
    mi: i64,
    s: i64,
    us: i64,
    tz: Option[Tz],
    fold: i64,
}

fn overflow() -> PyErr {
    py_err("OverflowError", "date value out of range".to_string())
}

fn epoch_us() -> i64 {
    to_ordinal(1970, 1, 1) * 86400000000
}

// The wall time as microseconds from 0001-01-01 less one day.
fn naive_us(t: ref DateTime) -> i64 {
    (((to_ordinal(t.y, t.mo, t.d) * 24 + t.h) * 60 + t.mi) * 60 + t.s) * 1000000 + t.us
}

fn from_naive_us(n: i64, tz: ref Option[Tz], fold: i64) -> Result[DateTime, PyErr] {
    let days = floor_div(n, 86400000000);
    let rest = n - days * 86400000000;
    if days < 1 or days > 3652059 {
        return Err(overflow());
    }
    let (y, mo, d) = from_ordinal(days);
    let secs = rest / 1000000;
    Ok(DateTime {
        y: y,
        mo: mo,
        d: d,
        h: secs / 3600,
        mi: (secs / 60) % 60,
        s: secs % 60,
        us: rest % 1000000,
        tz: tz.clone(),
        fold: fold,
    })
}

// datetime + timedelta(microseconds=delta): the wall time moves, the
// tzinfo stays and fold goes back to 0.
fn add_us(t: ref DateTime, delta: i64) -> Result[DateTime, PyErr] {
    from_naive_us(naive_us(t) + delta, t.tz, 0)
}

// datetime(...): the checks the constructor makes, in its order.
fn make_dt(y: i64, mo: i64, d: i64, h: i64, mi: i64, s: i64, us: i64, tz: ref Option[Tz], fold: i64) -> Result[DateTime, PyErr] {
    check_date(y, mo, d)?;
    check_time(h, mi, s, us)?;
    if fold != 0 and fold != 1 {
        return Err(value_error("fold must be either 0 or 1".to_string()));
    }
    Ok(DateTime { y: y, mo: mo, d: d, h: h, mi: mi, s: s, us: us, tz: tz.clone(), fold: fold })
}

fn with_tz(t: ref DateTime, tz: ref Option[Tz]) -> DateTime {
    let mut out = t.clone();
    out.tz = tz.clone();
    out
}

fn with_fold(t: ref DateTime, fold: i64) -> DateTime {
    let mut out = t.clone();
    out.fold = fold;
    out
}

// utcoffset() in seconds; None for a naive datetime
fn utcoffset(t: ref DateTime) -> Option[i64] {
    match t.tz {
        None => None,
        Some(Tz.Utc) => Some(0),
        Some(Tz.Local) => Some(0),
        Some(Tz.Offset(_, secs)) => Some(secs),
        Some(Tz.File(f)) => Some(f.utcoffset(t)),
    }
}

fn dst_of(t: ref DateTime) -> Option[i64] {
    match t.tz {
        None => None,
        Some(Tz.File(f)) => Some(f.dst(t)),
        Some(_) => Some(0),
    }
}

fn tzname_of(t: ref DateTime) -> Option[String] {
    match t.tz {
        None => None,
        Some(Tz.Utc) => Some("UTC".to_string()),
        Some(Tz.Local) => Some("UTC".to_string()),
        Some(Tz.Offset(name, _)) => name.clone(),
        Some(Tz.File(f)) => f.tzname(t),
    }
}

// tz.fromutc(t), where t holds a UTC wall time and the zone
fn fromutc(t: ref DateTime) -> Result[DateTime, PyErr] {
    match t.tz {
        Some(Tz.File(f)) => f.fromutc(t),
        Some(Tz.Offset(_, secs)) => add_us(t, secs * 1000000),
        _ => Ok(with_fold(t, 0)),
    }
}

// datetime.astimezone(tz)
fn astimezone(t: ref DateTime, tz: ref Tz) -> Result[DateTime, PyErr] {
    if let Some(mine) = t.tz {
        if same_tz(mine, tz) {
            return Ok(t.clone());
        }
    }
    let off = utcoffset(t).unwrap_or(0);
    let utc = add_us(t, -off * 1000000)?;
    fromutc(with_tz(utc, Some(tz.clone())))
}

// a - b for two aware datetimes, in microseconds: wall times alone when
// they share the tzinfo object, else each less its offset.
fn sub_us(a: ref DateTime, b: ref DateTime) -> i64 {
    let mut diff = naive_us(a) - naive_us(b);
    let same = match (a.tz.clone(), b.tz.clone()) {
        (Some(x), Some(y)) => same_tz(x, y),
        (None, None) => true,
        _ => false,
    };
    if not same {
        diff -= (utcoffset(a).unwrap_or(0) - utcoffset(b).unwrap_or(0)) * 1000000;
    }
    diff
}

fn naive_cmp(a: ref DateTime, b: ref DateTime) -> i64 {
    let x = naive_us(a);
    let y = naive_us(b);
    if x < y { -1 } else if x > y { 1 } else { 0 }
}

// The PEP 495 rule: across tzinfos, a time whose offset depends on its
// fold is equal to nothing.
fn flip_fold_differs(t: ref DateTime) -> bool {
    utcoffset(with_fold(t, 1 - t.fold)) != utcoffset(t)
}

// The rich comparison of two aware datetimes, as -1, 0 or 1, and
// whether == must still say False.
fn dt_compare(a: ref DateTime, b: ref DateTime) -> (i64, bool) {
    let same = match (a.tz.clone(), b.tz.clone()) {
        (Some(x), Some(y)) => same_tz(x, y),
        _ => false,
    };
    if same {
        return (naive_cmp(a, b), false);
    }
    let oa = utcoffset(a);
    let ob = utcoffset(b);
    let diff = if oa == ob {
        naive_cmp(a, b)
    } else {
        let d = sub_us(a, b);
        if d < 0 { -1 } else if d > 0 { 1 } else { 0 }
    };
    let exc = diff == 0 and (flip_fold_differs(a) or flip_fold_differs(b));
    (diff, exc)
}

fn dt_eq(a: ref DateTime, b: ref DateTime) -> bool {
    let (c, exc) = dt_compare(a, b);
    c == 0 and not exc
}

fn dt_lt(a: ref DateTime, b: ref DateTime) -> bool {
    dt_compare(a, b).0 < 0
}

fn dt_le(a: ref DateTime, b: ref DateTime) -> bool {
    dt_compare(a, b).0 <= 0
}

// timestamp() of an aware datetime: the microseconds since the epoch
// over a million, which is the true division Python does.
fn timestamp_us(t: ref DateTime) -> i64 {
    naive_us(t) - epoch_us() - utcoffset(t).unwrap_or(0) * 1000000
}

fn timestamp(t: ref DateTime) -> f64 {
    (timestamp_us(t) as f64) / 1000000.0
}

// _PyTime_RoundHalfEven
fn round_half_even(x: f64) -> f64 {
    let r = x.round();
    if (x - r).abs() == 0.5 { 2.0 * (x / 2.0).round() } else { r }
}

// The seconds and microseconds of a float timestamp, as
// _PyTime_ObjectToTimeval splits it.
fn split_timestamp(ts: f64) -> (i64, i64) {
    let mut intpart = ts.trunc();
    let mut frac = round_half_even((ts - intpart) * 1000000.0);
    if frac >= 1000000.0 {
        frac -= 1000000.0;
        intpart += 1.0;
    } else if frac < 0.0 {
        frac += 1000000.0;
        intpart -= 1.0;
    }
    (intpart as i64, frac as i64)
}

// datetime.utcfromtimestamp(ts) as a naive datetime
fn utc_from_timestamp(ts: f64) -> Result[DateTime, PyErr] {
    let (secs, us) = split_timestamp(ts);
    let n = epoch_us() + secs * 1000000 + us;
    if n < 86400000000 or n >= 3652060 * 86400000000 {
        return Err(value_error(f"year is out of range"));
    }
    from_naive_us(n, None, 0)
}

// datetime.fromtimestamp(ts, tz)
fn from_timestamp(ts: f64, tz: ref Tz) -> Result[DateTime, PyErr] {
    let utc = utc_from_timestamp(ts)?;
    fromutc(with_tz(utc, Some(tz.clone())))
}

fn offset_text(off: i64, sep: Str) -> String {
    let mut o = off;
    let mut sign = "+";
    if o < 0 {
        sign = "-";
        o = -o;
    }
    let mut s = f"{sign}{pad_n(o / 3600, 2)}{sep}{pad_n((o / 60) % 60, 2)}";
    if o % 60 != 0 {
        s = f"{s}{sep}{pad_n(o % 60, 2)}";
    }
    s
}

// datetime.isoformat(sep, timespec)
fn isoformat(t: ref DateTime, sep: ref String, timespec: Str) -> Result[String, PyErr] {
    let date = date_iso(t.y, t.mo, t.d);
    let hh = pad_n(t.h, 2);
    let mm = pad_n(t.mi, 2);
    let ss = pad_n(t.s, 2);
    let time = if timespec == "auto" {
        if t.us != 0 { f"{hh}:{mm}:{ss}.{pad_n(t.us, 6)}" } else { f"{hh}:{mm}:{ss}" }
    } else if timespec == "hours" {
        hh
    } else if timespec == "minutes" {
        f"{hh}:{mm}"
    } else if timespec == "seconds" {
        f"{hh}:{mm}:{ss}"
    } else if timespec == "milliseconds" {
        f"{hh}:{mm}:{ss}.{pad_n(t.us / 1000, 3)}"
    } else if timespec == "microseconds" {
        f"{hh}:{mm}:{ss}.{pad_n(t.us, 6)}"
    } else {
        return Err(value_error("Unknown timespec value".to_string()));
    };
    let mut s = f"{date}{sep}{time}";
    if let Some(off) = utcoffset(t) {
        s = f"{s}{offset_text(off, ":")}";
    }
    Ok(s)
}

fn iso(t: ref DateTime) -> String {
    isoformat(t, "T".to_string(), "auto").unwrap_or(String.new())
}

fn isoweekday(t: ref DateTime) -> i64 {
    weekday(t.y, t.mo, t.d) + 1
}

fn days_before_year(y: i64) -> i64 {
    let y1 = y - 1;
    y1 * 365 + floor_div(y1, 4) - floor_div(y1, 100) + floor_div(y1, 400)
}

fn iso_week1_monday(y: i64) -> i64 {
    let firstday = days_before_year(y) + 1;
    let firstweekday = floor_mod(firstday + 6, 7);
    let mut monday = firstday - firstweekday;
    if firstweekday > 3 {
        monday += 7;
    }
    monday
}

// date.isocalendar()
fn isocalendar(y0: i64, m: i64, d: i64) -> (i64, i64, i64) {
    let mut y = y0;
    let today = to_ordinal(y, m, d);
    let mut monday = iso_week1_monday(y);
    let mut week = floor_div(today - monday, 7);
    let mut day = floor_mod(today - monday, 7);
    if week < 0 {
        y -= 1;
        monday = iso_week1_monday(y);
        week = floor_div(today - monday, 7);
        day = floor_mod(today - monday, 7);
    } else if week >= 52 {
        if today >= iso_week1_monday(y + 1) {
            y += 1;
            week = 0;
        }
    }
    (y, week + 1, day + 1)
}

fn yday(t: ref DateTime) -> i64 {
    days_before_month(t.y, t.mo) + t.d
}

// dateutil.tz.datetime_exists
fn datetime_exists(t: ref DateTime) -> Result[bool, PyErr] {
    let tz = match t.tz {
        Some(z) => z.clone(),
        None => return Err(value_error("Datetime is naive and no time zone provided.".to_string())),
    };
    let utc = astimezone(t, Tz.Utc)?;
    let back = astimezone(utc, tz)?;
    Ok(naive_cmp(back, t) == 0)
}

// dateutil.tz.datetime_ambiguous: each tzinfo here has is_ambiguous.
fn datetime_ambiguous(t: ref DateTime) -> bool {
    match t.tz {
        Some(Tz.File(f)) => f.is_ambiguous_at(t, None),
        _ => false,
    }
}

// dateutil.tz.resolve_imaginary
fn resolve_imaginary(t: ref DateTime) -> Result[DateTime, PyErr] {
    if t.tz.is_some() and not datetime_exists(t)? {
        let day = 86400000000;
        let curr = utcoffset(add_us(t, day)?).unwrap_or(0);
        let old = utcoffset(add_us(t, -day)?).unwrap_or(0);
        return add_us(t, (curr - old) * 1000000);
    }
    Ok(t.clone())
}
// ------------------------------------------------------------ the context

// What the library keeps between calls: the compiled expressions, the
// locales, and the parsers already generated from a format.
struct Ctx {
    rx: Rx,
    locales: Vec[Locale],
    by_name: Map[String, i64],
    // DateTimeParser._generate_pattern_re, per locale and format
    pats: Vec[Pat],
    pat_index: Map[String, i64],
}

struct Pat {
    tokens: Vec[String],
    prog: i64,
}

fn re_id(ctx: mut ref Ctx, pattern: ref Vec[i64], flags: i64) -> Result[i64, PyErr] {
    match rx_compile(mut ctx.rx, pattern, flags) {
        Ok(i) => Ok(i),
        Err(e) => Err(pattern_error(e)),
    }
}

fn re_id_s(ctx: mut ref Ctx, pattern: Str, flags: i64) -> i64 {
    re_id(mut ctx, cps(pattern), flags).unwrap_or(-1)
}

// pattern.search(s), or .match(s) with mode 1
fn re_find(ctx: ref Ctx, id: i64, s: ref Vec[i64], mode: i64) -> Option[Found] {
    let prog = ref ctx.rx.progs[id];
    let mut m = new_matcher(prog, s);
    find(mut m, prog, 0, false, mode)
}

fn re_all(ctx: ref Ctx, id: i64, s: ref Vec[i64]) -> Vec[Found] {
    all_matches(ctx.rx.progs[id], s, 0)
}

// re.sub(pattern, repl, s) with a plain replacement
fn re_sub(ctx: ref Ctx, id: i64, s: ref Vec[i64], repl: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut last = 0;
    for m in re_all(ctx, id, s) {
        push_all(mut out, slice(s, last, m.start));
        push_all(mut out, repl);
        last = m.end;
    }
    push_all(mut out, slice(s, last, s.len()));
    out
}

// match.group(name), None when the group did not take part; Err when
// the pattern has no such group
fn group_named(ctx: ref Ctx, id: i64, s: ref Vec[i64], m: ref Found, name: Str) -> Result[Option[Vec[i64]], PyErr] {
    let g = named_group(ctx.rx.progs[id], cps(name));
    if g < 0 {
        return Err(py_err("IndexError", "no such group".to_string()));
    }
    Ok(group_of(s, m, g))
}

// ------------------------------------------------------------ small Python pieces

fn parser_error(msg: own String) -> PyErr {
    py_err("ParserError", msg)
}

fn parser_match_error(msg: own String) -> PyErr {
    py_err("ParserMatchError", msg)
}

fn type_error(msg: own String) -> PyErr {
    py_err("TypeError", msg)
}

// int() of a run of decimal digits, with a sign in front maybe
fn int_of(s: ref Vec[i64]) -> i64 {
    let mut n = 0;
    let mut neg = false;
    for c in s {
        if c == 45 {
            neg = true;
        } else if c != 43 {
            n = n * 10 + digit_value(c);
        }
    }
    if neg { -n } else { n }
}

fn srepr(s: ref String) -> String {
    repr_of(cps_of(s))
}

// float(s) for a string; None where Python raises ValueError
fn float_of(s: ref String) -> Option[f64] {
    let t = to_string(strip(cps_of(s))).replace("_", "");
    if t.len() == 0 {
        return None;
    }
    let low = t.to_lowercase();
    if low == "nan" or low == "inf" or low == "infinity" or low == "+inf" or low == "-inf" {
        return None;
    }
    match f64.parse(t.as_str()) {
        Ok(x) => Some(x),
        Err(_) => None,
    }
}

// ------------------------------------------------------------ tzinfo expressions

// A tzinfo argument: an object, or a string for TzinfoParser.
#[derive(Clone)]
enum TzArg {
    Obj(Tz),
    Name(String),
}

// TzinfoParser.parse
fn parse_tz(ctx: mut ref Ctx, s: ref String) -> Result[Tz, PyErr] {
    if s == "local" {
        return Ok(Tz.Local);
    }
    if s == "utc" or s == "UTC" or s == "Z" {
        return Ok(Tz.Utc);
    }
    let id = re_id_s(mut ctx, "^(?:\\(UTC)*([\\+\\-])?(\\d{2})(?:\\:?(\\d{2}))?", 0);
    let cs = cps_of(s);
    if let Some(m) = re_find(ctx, id, cs, 1) {
        let hours = int_of(group_of(cs, m, 2).unwrap_or(Vec.new()));
        let minutes = match group_of(cs, m, 3) {
            Some(g) => int_of(g),
            None => 0,
        };
        let mut seconds = hours * 3600 + minutes * 60;
        if let Some(sign) = group_of(cs, m, 1) {
            if eq_ascii(sign, "-") {
                seconds = -seconds;
            }
        }
        return Ok(Tz.Offset(None, seconds));
    }
    match gettz(s) {
        Some(z) => Ok(z),
        None => Err(parser_error(f"Could not parse timezone expression {srepr(s)}.")),
    }
}

fn resolve_tz(ctx: mut ref Ctx, arg: ref Option[TzArg]) -> Result[Tz, PyErr] {
    match arg {
        None => Ok(Tz.Utc),
        Some(TzArg.Obj(z)) => Ok(z.clone()),
        Some(TzArg.Name(n)) => parse_tz(mut ctx, n),
    }
}

// Arrow._get_tzinfo
fn get_tzinfo(ctx: mut ref Ctx, arg: ref Option[TzArg]) -> Result[Tz, PyErr] {
    match arg {
        Some(TzArg.Name(n)) => match parse_tz(mut ctx, n) {
            Ok(z) => Ok(z),
            Err(e) => {
                if e.kind == "ParserError" {
                    Err(value_error(f"{srepr(n)} not recognized as a timezone."))
                } else {
                    Err(e)
                }
            }
        },
        _ => resolve_tz(mut ctx, arg),
    }
}

fn tz_type_repr(z: ref Tz) -> String {
    let name = match z {
        Tz.Utc => "tzutc",
        Tz.Local => "tzlocal",
        Tz.Offset(_, _) => "tzoffset",
        Tz.File(_) => "tzfile",
    };
    f"<class 'dateutil.tz.tz.{name}'>"
}

// ------------------------------------------------------------ relativedelta

// dateutil's relativedelta for the relative fields arrow uses, once
// _fix has carried each one into the next.
struct RelDelta {
    years: i64,
    months: i64,
    days: i64,
    hours: i64,
    minutes: i64,
    seconds: i64,
    microseconds: i64,
    // MO..SU as 0..6, -1 for none
    weekday: i64,
}

fn sign_of(x: i64) -> i64 {
    if x < 0 { -1 } else { 1 }
}

fn carry(v: mut ref i64, next: mut ref i64, limit: i64, base: i64) {
    if v.abs() > limit {
        let s = sign_of(*v);
        let a = *v * s;
        *v = (a % base) * s;
        *next += (a / base) * s;
    }
}

fn rel_delta(years: i64, months: i64, days: i64, hours: i64, minutes: i64, seconds: i64, microseconds: i64, weekday: i64) -> RelDelta {
    let mut rd = RelDelta {
        years: years,
        months: months,
        days: days,
        hours: hours,
        minutes: minutes,
        seconds: seconds,
        microseconds: microseconds,
        weekday: weekday,
    };
    carry(mut rd.microseconds, mut rd.seconds, 999999, 1000000);
    carry(mut rd.seconds, mut rd.minutes, 59, 60);
    carry(mut rd.minutes, mut rd.hours, 59, 60);
    carry(mut rd.hours, mut rd.days, 23, 24);
    carry(mut rd.months, mut rd.years, 11, 12);
    rd
}

// datetime + relativedelta
fn rd_add(t: ref DateTime, rd: ref RelDelta) -> Result[DateTime, PyErr] {
    let mut year = t.y + rd.years;
    let mut month = t.mo;
    if rd.months != 0 {
        month += rd.months;
        if month > 12 {
            year += 1;
            month -= 12;
        } else if month < 1 {
            year -= 1;
            month += 12;
        }
    }
    let dim = days_in_month(year, month);
    let day = if t.d < dim { t.d } else { dim };
    let replaced = make_dt(year, month, day, t.h, t.mi, t.s, t.us, t.tz, t.fold)?;
    let delta = (((rd.days * 24 + rd.hours) * 60 + rd.minutes) * 60 + rd.seconds) * 1000000 + rd.microseconds;
    let mut ret = add_us(replaced, delta)?;
    if rd.weekday >= 0 {
        let jump = (7 - weekday(ret.y, ret.mo, ret.d) + rd.weekday) % 7;
        ret = add_us(ret, jump * 86400000000)?;
    }
    Ok(ret)
}

// ------------------------------------------------------------ Arrow constructors

// Arrow(year, ..., tzinfo, fold=fold): an Arrow is its aware datetime.
fn arrow_new(ctx: mut ref Ctx, y: i64, mo: i64, d: i64, h: i64, mi: i64, s: i64, us: i64, tz: ref Option[TzArg], fold: i64) -> Result[DateTime, PyErr] {
    let z = resolve_tz(mut ctx, tz)?;
    make_dt(y, mo, d, h, mi, s, us, Some(z), fold)
}

// Arrow.fromdatetime(dt, tzinfo)
fn from_datetime(ctx: mut ref Ctx, t: ref DateTime, tz: ref Option[TzArg]) -> Result[DateTime, PyErr] {
    let arg = match tz {
        Some(a) => Some(a.clone()),
        None => match t.tz {
            Some(z) => Some(TzArg.Obj(z.clone())),
            None => None,
        },
    };
    arrow_new(mut ctx, t.y, t.mo, t.d, t.h, t.mi, t.s, t.us, arg, t.fold)
}

fn from_date(ctx: mut ref Ctx, y: i64, m: i64, d: i64, tz: ref Option[TzArg]) -> Result[DateTime, PyErr] {
    arrow_new(mut ctx, y, m, d, 0, 0, 0, 0, tz, 0)
}

fn max_timestamp() -> f64 {
    253402300799.0 + 0.999999
}

// util.normalize_timestamp
fn normalize_timestamp(ts: f64) -> Result[f64, PyErr] {
    let max = max_timestamp();
    if ts > max {
        if ts < max * 1000.0 {
            return Ok(ts / 1000.0);
        }
        if ts < max * 1000000.0 {
            return Ok(ts / 1000000.0);
        }
        return Err(value_error(f"The specified timestamp {float_repr(ts)} is too large."));
    }
    Ok(ts)
}

// A Python value a job hands to arrow.
#[derive(Clone)]
enum PyVal {
    Int(i64),
    Float(f64),
    Str(String),
    Bool(bool),
    NoneV,
    Tuple(Vec[i64]),
    TzObj(Tz),
    Dt(DateTime),
    Date(i64, i64, i64),
    List(Vec[String]),
}

fn py_repr(v: ref PyVal) -> String {
    match v {
        PyVal.Int(n) => f"{n}",
        PyVal.Float(x) => float_repr(x),
        PyVal.Str(s) => srepr(s),
        PyVal.Bool(b) => if b { "True".to_string() } else { "False".to_string() },
        PyVal.NoneV => "None".to_string(),
        _ => "?".to_string(),
    }
}

fn py_type(v: ref PyVal) -> String {
    match v {
        PyVal.Int(_) => "<class 'int'>".to_string(),
        PyVal.Float(_) => "<class 'float'>".to_string(),
        PyVal.Str(_) => "<class 'str'>".to_string(),
        PyVal.Bool(_) => "<class 'bool'>".to_string(),
        PyVal.NoneV => "<class 'NoneType'>".to_string(),
        PyVal.Tuple(_) => "<class 'tuple'>".to_string(),
        PyVal.TzObj(z) => tz_type_repr(z),
        PyVal.Dt(_) => "<class 'datetime.datetime'>".to_string(),
        PyVal.Date(_, _, _) => "<class 'datetime.date'>".to_string(),
        PyVal.List(_) => "<class 'list'>".to_string(),
    }
}

// util.is_timestamp and float(value) together
fn timestamp_value(v: ref PyVal) -> Option[f64] {
    match v {
        PyVal.Int(n) => Some(n as f64),
        PyVal.Float(x) => Some(x),
        PyVal.Str(s) => float_of(s),
        _ => None,
    }
}

fn tz_arg_of(v: ref Option[PyVal]) -> Option[TzArg] {
    match v {
        Some(PyVal.Str(s)) => Some(TzArg.Name(s.clone())),
        Some(PyVal.TzObj(z)) => Some(TzArg.Obj(z.clone())),
        _ => None,
    }
}

// Arrow.fromtimestamp(timestamp, tzinfo)
fn arrow_fromtimestamp(ctx: mut ref Ctx, ts: ref PyVal, tz: ref Option[TzArg]) -> Result[DateTime, PyErr] {
    let z = match tz {
        None => Tz.Local,
        Some(a) => resolve_tz(mut ctx, Some(a.clone()))?,
    };
    let x = match timestamp_value(ts) {
        Some(x) => x,
        None => return Err(value_error(f"The provided timestamp {py_repr(ts)} is invalid.")),
    };
    let t = from_timestamp(normalize_timestamp(x)?, z)?;
    Ok(t)
}

fn arrow_utcfromtimestamp(ts: ref PyVal) -> Result[DateTime, PyErr] {
    let x = match timestamp_value(ts) {
        Some(x) => x,
        None => return Err(value_error(f"The provided timestamp {py_repr(ts)} is invalid.")),
    };
    let t = utc_from_timestamp(normalize_timestamp(x)?)?;
    Ok(with_tz(t, Some(Tz.Utc)))
}

fn arrow_fromordinal(v: ref PyVal) -> Result[DateTime, PyErr] {
    let n = match v {
        PyVal.Int(n) => n,
        _ => return Err(type_error(f"Ordinal must be an integer (got type {py_type(v)}).")),
    };
    if n < 1 or n > 3652059 {
        return Err(value_error(f"Ordinal {n} is out of range."));
    }
    let (y, m, d) = from_ordinal(n);
    make_dt(y, m, d, 0, 0, 0, 0, Some(Tz.Utc), 0)
}

fn arrow_min() -> DateTime {
    DateTime { y: 1, mo: 1, d: 1, h: 0, mi: 0, s: 0, us: 0, tz: Some(Tz.Utc), fold: 0 }
}

fn arrow_max() -> DateTime {
    DateTime { y: 9999, mo: 12, d: 31, h: 23, mi: 59, s: 59, us: 999999, tz: Some(Tz.Utc), fold: 0 }
}

// util.iso_to_gregorian
fn iso_to_gregorian(y: i64, week: i64, day: i64) -> Result[(i64, i64, i64), PyErr] {
    if week < 1 or week > 53 {
        return Err(value_error("ISO Calendar week value must be between 1-53.".to_string()));
    }
    if day < 1 or day > 7 {
        return Err(value_error("ISO Calendar day value must be between 1-7".to_string()));
    }
    check_date(y, 1, 4)?;
    let fourth = to_ordinal(y, 1, 4);
    let start = fourth - weekday(y, 1, 4);
    let ord = start + day - 1 + (week - 1) * 7;
    if ord < 1 or ord > 3652059 {
        return Err(overflow());
    }
    Ok(from_ordinal(ord))
}

// date.fromisocalendar
fn from_isocalendar(y: i64, week: i64, day: i64) -> Result[(i64, i64, i64), PyErr] {
    if y < 1 or y > 9999 {
        return Err(value_error(f"Year is out of range: {y}"));
    }
    if week <= 0 or week >= 53 {
        let mut out = true;
        if week == 53 {
            let first = to_ordinal(y, 1, 1) % 7;
            if first == 4 or (first == 3 and is_leap(y)) {
                out = false;
            }
        }
        if out {
            return Err(value_error(f"Invalid week: {week}"));
        }
    }
    if day <= 0 or day >= 8 {
        return Err(value_error(f"Invalid weekday: {day} (range is [1, 7])"));
    }
    Ok(from_ordinal(iso_week1_monday(y) + (week - 1) * 7 + day - 1))
}

// ------------------------------------------------------------ Arrow properties

fn arrow_repr(a: ref DateTime) -> String {
    f"<Arrow [{iso(a)}]>"
}

fn bool_text(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

fn opt_str_repr(s: ref Option[String]) -> String {
    match s {
        Some(x) => srepr(x),
        None => "None".to_string(),
    }
}

fn imaginary(a: ref DateTime) -> bool {
    not datetime_exists(a).unwrap_or(true)
}

fn quarter_of(a: ref DateTime) -> i64 {
    (a.mo - 1) / 3 + 1
}

fn int_timestamp(a: ref DateTime) -> i64 {
    timestamp(a).trunc() as i64
}
// ------------------------------------------------------------ locales

// One timeframe of a locale: a plain string, or a mapping of forms
// (past and future, or singular, dual and plural, ...), in dict order.
struct TimeFrame {
    key: String,
    plain: bool,
    forms: Vec[(String, String)],
}

// A locale class with its inherited attributes resolved. The data is
// read from data/locales.txt, which gen_kara.py extracts from arrow's
// locales.py; what each class's methods do is keyed on its name below.
struct Locale {
    cls: String,
    names: Vec[String],
    past: String,
    future: String,
    and_word: String,
    tf: Vec[TimeFrame],
    tf_dist: Vec[(String, String)],
    meridians: Vec[(String, String)],
    month_names: Vec[String],
    month_abbreviations: Vec[String],
    day_names: Vec[String],
    day_abbreviations: Vec[String],
    ordinal_day_re: String,
    special_day: Vec[(i64, String)],
    special_year: Vec[(i64, String)],
}

fn new_locale(cls: ref String) -> Locale {
    Locale {
        cls: cls.clone(),
        names: Vec.new(),
        past: String.new(),
        future: String.new(),
        and_word: String.new(),
        tf: Vec.new(),
        tf_dist: Vec.new(),
        meridians: Vec.new(),
        month_names: Vec.new(),
        month_abbreviations: Vec.new(),
        day_names: Vec.new(),
        day_abbreviations: Vec.new(),
        ordinal_day_re: "(\\d+)".to_string(),
        special_day: Vec.new(),
        special_year: Vec.new(),
    }
}

fn fields_tab(line: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for f in split_on(cps_of(line), 9) {
        out.push(to_string(f));
    }
    out
}

fn add_form(l: mut ref Locale, key: ref String, sub: ref String, text: ref String, plain: bool) {
    let mut k = 0;
    while k < l.tf.len() {
        if l.tf[k].key == *key {
            l.tf[k].forms.push((sub.clone(), text.clone()));
            return;
        }
        k += 1;
    }
    let mut forms: Vec[(String, String)] = Vec.new();
    forms.push((sub.clone(), text.clone()));
    l.tf.push(TimeFrame { key: key.clone(), plain: plain, forms: forms });
}

fn rest_of(f: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut k = 1;
    while k < f.len() {
        out.push(f[k].clone());
        k += 1;
    }
    out
}

fn load_locales(text: ref String) -> Vec[Locale] {
    let mut out: Vec[Locale] = Vec.new();
    for line in text.split("\n") {
        if line.len() == 0 {
            continue;
        }
        let f = fields_tab(line.to_string());
        let tag = f[0].clone();
        if tag == "locale" {
            out.push(new_locale(f[1]));
            continue;
        }
        let n = out.len() - 1;
        let l = mut ref out[n];
        if tag == "names" {
            l.names = rest_of(f);
        } else if tag == "past" {
            l.past = f[1].clone();
        } else if tag == "future" {
            l.future = f[1].clone();
        } else if tag == "and" {
            l.and_word = f[1].clone();
        } else if tag == "tf" {
            add_form(mut l, f[1], f[1], f[2], true);
        } else if tag == "tfm" {
            add_form(mut l, f[1], f[2], f[3], false);
        } else if tag == "tfd" {
            l.tf_dist.push((f[1].clone(), f[2].clone()));
        } else if tag == "mer" {
            l.meridians.push((f[1].clone(), f[2].clone()));
        } else if tag == "month_names" {
            l.month_names = rest_of(f);
        } else if tag == "month_abbreviations" {
            l.month_abbreviations = rest_of(f);
        } else if tag == "day_names" {
            l.day_names = rest_of(f);
        } else if tag == "day_abbreviations" {
            l.day_abbreviations = rest_of(f);
        } else if tag == "ordinal_day_re" {
            l.ordinal_day_re = f[1].clone();
        } else if tag == "special_dayframes" {
            l.special_day.push((int_of(cps_of(f[1])), f[2].clone()));
        } else if tag == "special_yearframes" {
            l.special_year.push((int_of(cps_of(f[1])), f[2].clone()));
        }
    }
    out
}

fn normalize_locale(name: ref String) -> String {
    to_string(lower_all(cps_of(name))).replace("_", "-")
}

// locales.get_locale
fn get_locale(ctx: ref Ctx, name: ref String) -> Result[i64, PyErr] {
    let norm = normalize_locale(name);
    match ctx.by_name.get(norm.clone()) {
        Some(i) => Ok(i),
        None => Err(value_error(f"Unsupported locale {srepr(norm)}.")),
    }
}

fn key_error(key: ref String) -> PyErr {
    py_err("KeyError", srepr(key))
}

fn lookup(pairs: ref Vec[(String, String)], key: Str) -> Option[String] {
    for (k, v) in pairs.iter() {
        if k == key {
            return Some(v.clone());
        }
    }
    None
}

fn meridian(l: ref Locale, key: Str) -> String {
    lookup(l.meridians, key).unwrap_or(String.new())
}

fn fmt0(template: ref String, value: ref String) -> String {
    template.replace("{0}", value.as_str())
}

fn is_cls(l: ref Locale, names: Str) -> bool {
    for n in names.split(" ") {
        if l.cls == n {
            return true;
        }
    }
    false
}

// Locale.ordinal_number
fn ordinal_number(l: ref Locale, n: i64) -> String {
    if is_cls(l, "EnglishLocale") {
        let m = floor_mod(n, 100);
        if m != 11 and m != 12 and m != 13 {
            let r = n.abs() % 10;
            if r == 1 {
                return f"{n}st";
            }
            if r == 2 {
                return f"{n}nd";
            }
            if r == 3 {
                return f"{n}rd";
            }
        }
        return f"{n}th";
    }
    if is_cls(l, "ItalianLocale SpanishLocale") {
        return f"{n}º";
    }
    if is_cls(l, "FrenchLocale FrenchCanadianLocale") {
        return if n.abs() == 1 { f"{n}er" } else { f"{n}e" };
    }
    if is_cls(l, "GermanLocale AustrianLocale FinnishLocale") {
        return f"{n}.";
    }
    if is_cls(l, "KoreanLocale") {
        let ordinals = ["0", "첫", "두", "세", "네", "다섯", "여섯", "일곱", "여덟", "아홉", "열"];
        if n < 11 {
            // a negative n indexes from the end, as Python lists do
            let i = if n < 0 { n + 11 } else { n };
            return f"{ordinals[i]}번째";
        }
        return f"{n}번째";
    }
    f"{n}"
}

fn find_frame(l: ref Locale, key: ref String) -> i64 {
    let mut k = 0;
    while k < l.tf.len() {
        if l.tf[k].key == *key {
            return k;
        }
        k += 1;
    }
    -1
}

fn form_of(frame: ref TimeFrame, sub: Str) -> Result[String, PyErr] {
    match lookup(frame.forms, sub) {
        Some(s) => Ok(s),
        None => Err(key_error(sub.to_string())),
    }
}

// Locale._format_timeframe, with each override
fn format_timeframe(l: ref Locale, tf: ref String, delta: i64) -> Result[String, PyErr] {
    let k = find_frame(l, tf);
    if k < 0 {
        return Err(key_error(tf));
    }
    let frame = ref l.tf[k];
    let d = delta.abs();
    let ds = f"{d}";
    if frame.plain {
        return Ok(fmt0(frame.forms[0].1, ds));
    }
    if is_cls(l, "FinnishLocale") {
        let form = if delta < 0 { form_of(frame, "past")? } else { form_of(frame, "future")? };
        return Ok(fmt0(form, ds));
    }
    if is_cls(l, "PolishLocale RussianLocale") {
        let form = if d % 10 == 1 and d % 100 != 11 {
            form_of(frame, "singular")?
        } else if d % 10 >= 2 and d % 10 <= 4 and (d % 100 < 10 or d % 100 >= 20) {
            form_of(frame, "dual")?
        } else {
            form_of(frame, "plural")?
        };
        return Ok(fmt0(form, ds));
    }
    // CzechLocale
    let key = if delta == 0 {
        "zero"
    } else if delta < 0 {
        "past"
    } else if lookup(frame.forms, "future-singular").is_none() {
        "future"
    } else if d % 10 >= 2 and d % 10 <= 4 and (d % 100 < 10 or d % 100 >= 20) {
        "future-singular"
    } else {
        "future-paucal"
    };
    Ok(fmt0(form_of(frame, key)?, ds))
}

fn special(pairs: ref Vec[(i64, String)], n: i64) -> Option[String] {
    for (k, v) in pairs.iter() {
        if k == n and v.len() > 0 {
            return Some(v.clone());
        }
    }
    None
}

// Locale._format_relative
fn format_relative(l: ref Locale, humanized: ref String, tf: ref String, delta: f64) -> String {
    if is_cls(l, "KoreanLocale") {
        if tf == "day" or tf == "days" {
            if let Some(s) = special(l.special_day, delta.trunc() as i64) {
                return s;
            }
        } else if tf == "year" or tf == "years" {
            if let Some(s) = special(l.special_year, delta.trunc() as i64) {
                return s;
            }
        }
    }
    if tf == "now" {
        return humanized.clone();
    }
    let direction = if delta < 0.0 { l.past.clone() } else { l.future.clone() };
    fmt0(direction, humanized)
}

// Locale.describe
fn describe(l: ref Locale, tf: Str, delta: f64, only_distance: bool) -> Result[String, PyErr] {
    let key = tf.to_string();
    if only_distance and is_cls(l, "GermanLocale AustrianLocale") {
        return match lookup(l.tf_dist, tf) {
            Some(form) => Ok(fmt0(form, f"{delta.abs().trunc() as i64}")),
            None => Err(key_error(key)),
        };
    }
    let mut humanized = format_timeframe(l, key, delta.trunc() as i64)?;
    if not only_distance {
        humanized = format_relative(l, humanized, key, delta);
    }
    if is_cls(l, "EnglishLocale") and only_distance and tf == "now" {
        humanized = "instantly".to_string();
    }
    Ok(humanized)
}

// Locale.describe_multi
fn describe_multi(l: ref Locale, frames: ref Vec[(String, f64)], only_distance: bool) -> Result[String, PyErr] {
    let mut parts: Vec[String] = Vec.new();
    for (tf, delta) in frames.iter() {
        parts.push(format_timeframe(l, tf, delta.trunc() as i64)?);
    }
    if l.and_word.len() > 0 {
        let at = if parts.len() > 0 { parts.len() - 1 } else { 0 };
        parts.insert(at, l.and_word.clone());
    }
    let mut humanized = parts.join(" ");
    if not only_distance {
        let mut value = 0;
        for (_, delta) in frames.iter() {
            let t = delta.trunc() as i64;
            if t != 0 {
                value = t;
                break;
            }
        }
        humanized = format_relative(l, humanized, "seconds".to_string(), value as f64);
    }
    Ok(humanized)
}

// Locale.month_number: a dict of the lower-cased names, updated with
// the abbreviations, so a later entry wins over an earlier one
fn month_number(l: ref Locale, name: ref Vec[i64]) -> Option[i64] {
    let mut hit: Option[i64] = None;
    let mut k = 1;
    while k < l.month_abbreviations.len() {
        if same(lower_all(cps_of(l.month_abbreviations[k])), name) {
            hit = Some(k);
        }
        k += 1;
    }
    if hit.is_some() {
        return hit;
    }
    k = 1;
    while k < l.month_names.len() {
        if same(lower_all(cps_of(l.month_names[k])), name) {
            hit = Some(k);
        }
        k += 1;
    }
    hit
}

// [x.lower() for x in names].index(value.lower()): the first hit
fn index_lower(names: ref Vec[String], value: ref Vec[i64]) -> Result[i64, PyErr] {
    let v = lower_all(value);
    let mut k = 0;
    while k < names.len() {
        if same(lower_all(cps_of(names[k])), v) {
            return Ok(k);
        }
        k += 1;
    }
    Err(value_error(f"{repr_of(v)} is not in list"))
}

fn choice_re(items: ref Vec[String], from: i64) -> String {
    let mut parts: Vec[String] = Vec.new();
    let mut k = from;
    while k < items.len() {
        parts.push(items[k].clone());
        k += 1;
    }
    f"({parts.join("|")})"
}
// ------------------------------------------------------------ DateTimeParser

// The values _parse_token collects.
struct Parts {
    year: Option[i64],
    month: Option[i64],
    // month_number found nothing, so parts['month'] is None
    month_none: bool,
    day_of_year: Option[i64],
    day: Option[i64],
    hour: Option[i64],
    minute: Option[i64],
    second: Option[i64],
    microsecond: Option[i64],
    timestamp: Option[f64],
    expanded_timestamp: Option[i64],
    tzinfo: Option[Tz],
    // 1 am, 2 pm
    am_pm: i64,
    day_of_week: Option[i64],
    // year, week and day of a W token
    weekdate: Option[(i64, i64, Option[i64])],
}

fn new_parts() -> Parts {
    Parts {
        year: None,
        month: None,
        month_none: false,
        day_of_year: None,
        day: None,
        hour: None,
        minute: None,
        second: None,
        microsecond: None,
        timestamp: None,
        expanded_timestamp: None,
        tzinfo: None,
        am_pm: 0,
        day_of_week: None,
        weekdate: None,
    }
}

// _input_re_map[token].pattern
fn token_pattern(l: ref Locale, tok: ref String) -> Option[String] {
    let t = tok.as_str();
    let fixed = if t == "YYYY" {
        "\\d{4}"
    } else if t == "YY" or t == "MM" or t == "DD" or t == "HH" or t == "hh" or t == "mm" or t == "ss" {
        "\\d{2}"
    } else if t == "M" or t == "D" or t == "H" or t == "h" or t == "m" or t == "s" {
        "\\d{1,2}"
    } else if t == "DDDD" {
        "\\d{3}"
    } else if t == "DDD" {
        "\\d{1,3}"
    } else if t == "X" {
        "^\\-?\\d+\\.?\\d+$"
    } else if t == "x" {
        "^\\-?\\d+$"
    } else if t == "ZZZ" {
        "\\w[\\w+\\-/]+"
    } else if t == "ZZ" {
        "([\\+\\-])(\\d{2})(?:\\:(\\d{2}))?|Z"
    } else if t == "Z" {
        "([\\+\\-])(\\d{2})(?:(\\d{2}))?|Z"
    } else if t == "S" {
        "\\d+"
    } else if t == "W" {
        "(?P<year>\\d{4})[\\-]?W(?P<week>\\d{2})[\\-]?(?P<day>\\d)?"
    } else if t == "d" {
        "[1-7]"
    } else {
        ""
    };
    if fixed.len() > 0 {
        return Some(fixed.to_string());
    }
    if t == "MMMM" {
        return Some(choice_re(l.month_names, 1));
    }
    if t == "MMM" {
        return Some(choice_re(l.month_abbreviations, 1));
    }
    if t == "Do" {
        return Some(l.ordinal_day_re.clone());
    }
    if t == "dddd" {
        return Some(choice_re(l.day_names, 1));
    }
    if t == "ddd" {
        return Some(choice_re(l.day_abbreviations, 1));
    }
    if t == "a" {
        let mut two: Vec[String] = Vec.new();
        two.push(meridian(l, "am"));
        two.push(meridian(l, "pm"));
        return Some(choice_re(two, 0));
    }
    if t == "A" {
        let mut all: Vec[String] = Vec.new();
        for (_, v) in l.meridians.iter() {
            all.push(v.clone());
        }
        return Some(choice_re(all, 0));
    }
    None
}

// re.escape
fn re_escape(s: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s {
        if in_ascii(c, "()[]{}?*+-|^$\\.&~# \t\n\r\u{b}\u{c}") {
            out.push(92);
        }
        out.push(c);
    }
    out
}

fn escape_re_id(ctx: mut ref Ctx) -> i64 {
    re_id_s(mut ctx, "\\[[^\\[\\]]*\\]", 0)
}

// _generate_pattern_re: the tokens of a format and its compiled pattern
fn generate_pattern(ctx: mut ref Ctx, li: i64, fmt: ref String) -> Result[i64, PyErr] {
    let key = f"{li}\u{1}{fmt}";
    if let Some(i) = ctx.pat_index.get(key.clone()) {
        return Ok(i);
    }
    let f = cps_of(fmt);
    let esc = escape_re_id(mut ctx);
    let s_run = re_id_s(mut ctx, "S+", 0);
    let fmt_re = re_id_s(mut ctx, "(YYY?Y?|MM?M?M?|Do|DD?D?D?|d?d?d?d|HH?|hh?|mm?|ss?|S+|ZZ?Z?|a|A|x|X|W)", 0);
    let mut escaped = re_escape(f);
    escaped = re_sub(ctx, esc, escaped, cps("#"));
    escaped = re_sub(ctx, s_run, escaped, cps("S"));
    let mut escaped_data: Vec[Vec[i64]] = Vec.new();
    for m in re_all(ctx, esc, f) {
        escaped_data.push(slice(f, m.start, m.end));
    }
    let mut tokens: Vec[String] = Vec.new();
    let mut pattern: Vec[i64] = Vec.new();
    let mut last = 0;
    for m in re_all(ctx, fmt_re, escaped) {
        let tok = to_string(slice(escaped, m.start, m.end));
        let input = match token_pattern(ctx.locales[li], tok) {
            Some(p) => p,
            None => return Err(parser_error(f"Unrecognized token {srepr(tok)}.")),
        };
        push_all(mut pattern, slice(escaped, last, m.start));
        push_all(mut pattern, cps_of(f"(?P<{tok}>{input})"));
        tokens.push(tok);
        last = m.end;
    }
    push_all(mut pattern, slice(escaped, last, escaped.len()));
    // split on "\#" and put each bracketed text back in, unescaped
    let mut joined: Vec[i64] = Vec.new();
    let mut i = 0;
    let mut piece = 0;
    let mut start = 0;
    while i <= pattern.len() {
        let at_split = i + 1 < pattern.len() and pattern[i] == 92 and pattern[i + 1] == 35;
        if at_split or i == pattern.len() {
            push_all(mut joined, slice(pattern, start, i));
            if piece < escaped_data.len() {
                let d = ref escaped_data[piece];
                push_all(mut joined, slice(d, 1, d.len() - 1));
            }
            piece += 1;
            if i == pattern.len() {
                break;
            }
            i += 2;
            start = i;
            continue;
        }
        i += 1;
    }
    let mut bounded = cps("(?<!\\S\\S)(?<![^\\,\\.\\;\\:\\?\\!\\\"\\'\\`\\[\\]\\{\\}\\(\\)<>\\s])(\\b|^)");
    push_all(mut bounded, joined);
    push_all(mut bounded, cps("(?=[\\,\\.\\;\\:\\?\\!\\\"\\'\\`\\[\\]\\{\\}\\(\\)\\<\\>]?(?!\\S))"));
    let prog = match rx_compile(mut ctx.rx, bounded, flag_ignorecase()) {
        Ok(p) => p,
        Err(e) => return Err(parser_match_error(f"Failed to generate regular expression pattern: {re_message(e)}.")),
    };
    ctx.pats.push(Pat { tokens: tokens, prog: prog });
    let idx = ctx.pats.len() - 1;
    ctx.pat_index.insert(key, idx);
    Ok(idx)
}

fn need(v: ref Option[Vec[i64]], tok: ref String) -> Result[Vec[i64], PyErr] {
    match v {
        Some(x) => Ok(x.clone()),
        None => Err(parser_match_error(f"Unable to find a match group for the specified token {srepr(tok)}.")),
    }
}

// DateTimeParser.parse with a single format
fn parse_fmt(ctx: mut ref Ctx, li: i64, s: ref Vec[i64], fmt: ref String) -> Result[DateTime, PyErr] {
    let pi = generate_pattern(mut ctx, li, fmt)?;
    let prog = ctx.pats[pi].prog;
    let tokens = ctx.pats[pi].tokens.clone();
    let m = match re_find(ctx, prog, s, 0) {
        Some(m) => m,
        None => return Err(parser_match_error(f"Failed to match {srepr(fmt)} when parsing {repr_of(s)}.")),
    };
    let mut parts = new_parts();
    for tok in tokens.iter() {
        if tok == "W" {
            let y = group_named(ctx, prog, s, m, "year")?;
            let w = group_named(ctx, prog, s, m, "week")?;
            let d = group_named(ctx, prog, s, m, "day")?;
            let day = match d {
                Some(x) => Some(int_of(x)),
                None => None,
            };
            parts.weekdate = Some((int_of(y.unwrap_or(Vec.new())), int_of(w.unwrap_or(Vec.new())), day));
            continue;
        }
        let name = if tok == "Do" { "value".to_string() } else { tok.clone() };
        let value = need(group_named(ctx, prog, s, m, name.as_str())?, tok)?;
        parse_token(mut ctx, li, tok, value, mut parts)?;
    }
    build_datetime(mut parts)
}

fn parse_token(ctx: mut ref Ctx, li: i64, tok: ref String, value: ref Vec[i64], parts: mut ref Parts) -> Result[(), PyErr] {
    let t = tok.as_str();
    if t == "YYYY" {
        parts.year = Some(int_of(value));
    } else if t == "YY" {
        let v = int_of(value);
        parts.year = Some(if v > 68 { 1900 + v } else { 2000 + v });
    } else if t == "MMMM" or t == "MMM" {
        parts.month = month_number(ctx.locales[li], lower_all(value));
        parts.month_none = parts.month.is_none();
    } else if t == "MM" or t == "M" {
        parts.month = Some(int_of(value));
        parts.month_none = false;
    } else if t == "DDDD" or t == "DDD" {
        parts.day_of_year = Some(int_of(value));
    } else if t == "DD" or t == "D" or t == "Do" {
        parts.day = Some(int_of(value));
    } else if t == "dddd" {
        parts.day_of_week = Some(index_lower(ctx.locales[li].day_names, value)? - 1);
    } else if t == "ddd" {
        parts.day_of_week = Some(index_lower(ctx.locales[li].day_abbreviations, value)? - 1);
    } else if t == "HH" or t == "H" or t == "hh" or t == "h" {
        parts.hour = Some(int_of(value));
    } else if t == "mm" or t == "m" {
        parts.minute = Some(int_of(value));
    } else if t == "ss" or t == "s" {
        parts.second = Some(int_of(value));
    } else if t == "S" {
        let mut v = value.clone();
        while v.len() < 7 {
            v.push(48);
        }
        let seventh = digit_value(v[6]);
        let rounding = if seventh == 5 {
            digit_value(v[5]) % 2
        } else if seventh > 5 {
            1
        } else {
            0
        };
        parts.microsecond = Some(int_of(slice(v, 0, 6)) + rounding);
    } else if t == "X" {
        parts.timestamp = float_of(to_string(value));
    } else if t == "x" {
        parts.expanded_timestamp = Some(int_of(value));
    } else if t == "ZZZ" or t == "ZZ" or t == "Z" {
        parts.tzinfo = Some(parse_tz(mut ctx, to_string(value))?);
    } else if t == "a" or t == "A" {
        let v = to_string(value);
        let l = ref ctx.locales[li];
        if v == meridian(l, "am") or v == meridian(l, "AM") {
            parts.am_pm = 1;
            if let Some(h) = parts.hour {
                if h < 0 or h > 12 {
                    return Err(parser_match_error(f"Hour token value must be between 0 and 12 inclusive for token {srepr(tok)}."));
                }
            }
        } else if v == meridian(l, "pm") or v == meridian(l, "PM") {
            parts.am_pm = 2;
        }
    }
    Ok(())
}

fn strptime_error(ds: ref String, fmt: Str) -> PyErr {
    value_error(f"time data {srepr(ds)} does not match format '{fmt}'")
}

// datetime.strptime(f"{year}-{week}-{day}", "%G-%V-%u")
fn strptime_isoweek(year: i64, week: i64, day: i64) -> Result[(i64, i64, i64), PyErr] {
    let ds = f"{year}-{week}-{day}";
    if year < 1000 or year > 9999 or week < 0 or week > 53 or day < 1 or day > 7 {
        return Err(strptime_error(ds, "%G-%V-%u"));
    }
    from_isocalendar(year, week, day)
}

// datetime.strptime(f"{year}-{day_of_year}", "%Y-%j"), None where it
// raises ValueError
fn strptime_yday(year: i64, doy: i64) -> Option[(i64, i64, i64)] {
    if year < 1000 or year > 9999 or doy < 1 or doy > 366 {
        return None;
    }
    let ord = to_ordinal(year, 1, 1) + doy - 1;
    if ord > 3652059 {
        return None;
    }
    Some(from_ordinal(ord))
}

// DateTimeParser._build_datetime
fn build_datetime(parts: mut ref Parts) -> Result[DateTime, PyErr] {
    if let Some((y, w, d)) = parts.weekdate {
        let (yy, mm, dd) = strptime_isoweek(y, w, d.unwrap_or(1))?;
        parts.year = Some(yy);
        parts.month = Some(mm);
        parts.month_none = false;
        parts.day = Some(dd);
    }
    if let Some(ts) = parts.timestamp {
        return from_timestamp(ts, Tz.Utc);
    }
    if let Some(n) = parts.expanded_timestamp {
        return from_timestamp(normalize_timestamp(n as f64)?, Tz.Utc);
    }
    if let Some(doy) = parts.day_of_year {
        let year = match parts.year {
            Some(y) => y,
            None => return Err(parser_error("Year component is required with the DDD and DDDD tokens.".to_string())),
        };
        if parts.month.is_some() {
            return Err(parser_error("Month component is not allowed with the DDD and DDDD tokens.".to_string()));
        }
        match strptime_yday(year, doy) {
            Some((yy, mm, dd)) => {
                parts.year = Some(yy);
                parts.month = Some(mm);
                parts.day = Some(dd);
            }
            None => return Err(parser_error(f"The provided day of year {doy} is invalid.")),
        }
    }
    if let Some(dow) = parts.day_of_week {
        if parts.day.is_none() {
            let year = parts.year.unwrap_or(1970);
            let month = parts.month.unwrap_or(1);
            check_date(year, month, 1)?;
            let ahead = floor_mod(dow - weekday(year, month, 1), 7);
            let (yy, mm, dd) = from_ordinal(to_ordinal(year, month, 1) + ahead);
            parts.year = Some(yy);
            parts.month = Some(mm);
            parts.day = Some(dd);
        }
    }
    let mut hour = parts.hour.unwrap_or(0);
    if parts.am_pm == 2 and hour < 12 {
        hour += 12;
    } else if parts.am_pm == 1 and hour == 12 {
        hour = 0;
    }
    let mut day_increment = 0;
    if hour == 24 {
        if parts.minute.unwrap_or(0) != 0 {
            return Err(parser_error("Midnight at the end of day must not contain minutes".to_string()));
        }
        if parts.second.unwrap_or(0) != 0 {
            return Err(parser_error("Midnight at the end of day must not contain seconds".to_string()));
        }
        if parts.microsecond.unwrap_or(0) != 0 {
            return Err(parser_error("Midnight at the end of day must not contain microseconds".to_string()));
        }
        hour = 0;
        day_increment = 1;
    }
    let mut microsecond = parts.microsecond.unwrap_or(0);
    let mut second_increment = 0;
    if microsecond == 1000000 {
        microsecond = 0;
        second_increment = 1;
    }
    if parts.month_none {
        return Err(type_error("'NoneType' object cannot be interpreted as an integer".to_string()));
    }
    let t = make_dt(parts.year.unwrap_or(1), parts.month.unwrap_or(1), parts.day.unwrap_or(1), hour, parts.minute.unwrap_or(0), parts.second.unwrap_or(0), microsecond, parts.tzinfo, 0)?;
    add_us(t, day_increment * 86400000000 + second_increment * 1000000)
}

// _parse_multiformat
fn parse_multi(ctx: mut ref Ctx, li: i64, s: ref Vec[i64], formats: ref Vec[String]) -> Result[DateTime, PyErr] {
    for f in formats.iter() {
        match parse_fmt(mut ctx, li, s, f) {
            Ok(t) => return Ok(t),
            Err(e) => {
                if e.kind != "ParserMatchError" {
                    return Err(e);
                }
            }
        }
    }
    Err(parser_error(f"Could not match input {repr_of(s)} to any of the following formats: {formats.join(", ")}."))
}

// re.sub(r"\s+", " ", s)
fn squeeze_spaces(s: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut in_run = false;
    for c in s {
        if is_space(c, false) {
            if not in_run {
                out.push(32);
            }
            in_run = true;
        } else {
            out.push(c);
            in_run = false;
        }
    }
    out
}

fn count_of(s: ref Vec[i64], c: i64) -> i64 {
    let mut n = 0;
    for x in s {
        if x == c {
            n += 1;
        }
    }
    n
}

// DateTimeParser.parse(string, fmt or [fmt, ...])
fn parse_with(ctx: mut ref Ctx, li: i64, s0: ref String, fmts: ref Vec[String], one: bool, normalize: bool) -> Result[DateTime, PyErr] {
    let mut s = cps_of(s0);
    if normalize {
        s = squeeze_spaces(s);
    }
    if one {
        return parse_fmt(mut ctx, li, s, fmts[0]);
    }
    parse_multi(mut ctx, li, s, fmts)
}

// DateTimeParser.parse_iso
fn parse_iso(ctx: mut ref Ctx, li: i64, s0: ref String, normalize: bool) -> Result[DateTime, PyErr] {
    let mut s = cps_of(s0);
    if normalize {
        s = squeeze_spaces(strip(s));
    }
    let has_space = has(s, 32);
    let has_t = has(s, 84);
    let spaces = count_of(s, 32);
    if (has_space and spaces != 1) or (has_t and spaces > 0) {
        return Err(parser_error(f"Expected an ISO 8601-like string, but was given {repr_of(s)}. Try passing in a format string to resolve this."));
    }
    let has_time = has_space or has_t;
    let mut has_tz = false;
    let mut formats: Vec[String] = Vec.new();
    for f in "YYYY-MM-DD YYYY-M-DD YYYY-M-D YYYY/MM/DD YYYY/M/DD YYYY/M/D YYYY.MM.DD YYYY.M.DD YYYY.M.D YYYYMMDD YYYY-DDDD YYYYDDDD YYYY-MM YYYY/MM YYYY.MM YYYY W".split(" ") {
        formats.push(f.to_string());
    }
    let mut tz_format = "Z";
    if has_time {
        let div = index_of(s, if has_space { 32 } else { 84 });
        let time_string = slice(s, div + 1, s.len());
        let mut cut = -1;
        let mut k = 0;
        while k < time_string.len() {
            let c = time_string[k];
            if c == 43 or c == 45 or c == 90 or c == 122 {
                cut = k;
                break;
            }
            k += 1;
        }
        let first = if cut >= 0 { slice(time_string, 0, cut) } else { time_string.clone() };
        let time_re = re_id_s(mut ctx, "^(\\d{2})(?:\\:?(\\d{2}))?(?:\\:?(\\d{2}))?(?:([\\.\\,])(\\d+))?$", 0);
        let tm = match re_find(ctx, time_re, first, 1) {
            Some(m) => m,
            None => return Err(parser_error("Invalid time component provided. Please specify a format or provide a valid time component in the basic or extended ISO 8601 time format.".to_string())),
        };
        has_tz = cut >= 0;
        let has_minutes = group_of(first, tm, 2).is_some();
        let has_seconds = group_of(first, tm, 3).is_some();
        let subseconds_sep = group_of(first, tm, 4);
        if has_tz and has(slice(time_string, cut + 1, time_string.len()), 58) {
            tz_format = "ZZ";
        }
        let sep = if has(first, 58) { ":" } else { "" };
        let time_fmt = match subseconds_sep {
            Some(ss) => f"HH{sep}mm{sep}ss{to_string(ss)}S",
            None => {
                if has_seconds {
                    f"HH{sep}mm{sep}ss"
                } else if has_minutes {
                    f"HH{sep}mm"
                } else {
                    "HH".to_string()
                }
            }
        };
        let divider = if has_space { " " } else { "T" };
        let mut with_time: Vec[String] = Vec.new();
        for f in formats.iter() {
            with_time.push(f"{f}{divider}{time_fmt}");
        }
        formats = with_time;
    }
    if has_time and has_tz {
        let mut with_tz: Vec[String] = Vec.new();
        for f in formats.iter() {
            with_tz.push(f"{f}{tz_format}");
        }
        formats = with_tz;
    }
    parse_multi(mut ctx, li, s, formats)
}
// ------------------------------------------------------------ DateTimeFormatter

// DateTimeFormatter._format_token; None for a token with no branch,
// which re.sub then drops.
fn format_token(l: ref Locale, t: ref DateTime, tok: ref Vec[i64]) -> Option[String] {
    let n = tok.len();
    if n >= 2 and tok[0] == 91 and tok[n - 1] == 93 {
        return Some(to_string(slice(tok, 1, n - 1)));
    }
    let k = to_string(tok);
    let s = k.as_str();
    let hour12 = if t.h > 0 and t.h < 13 { t.h } else { (t.h - 12).abs() };
    if s == "YYYY" {
        return Some(pad_n(t.y, 4));
    }
    if s == "YY" {
        return Some(pad_n(t.y, 4)[2..].to_string());
    }
    if s == "MMMM" {
        return Some(l.month_names[t.mo].clone());
    }
    if s == "MMM" {
        return Some(l.month_abbreviations[t.mo].clone());
    }
    if s == "MM" {
        return Some(pad_n(t.mo, 2));
    }
    if s == "M" {
        return Some(f"{t.mo}");
    }
    if s == "DDDD" {
        return Some(pad_n(yday(t), 3));
    }
    if s == "DDD" {
        return Some(f"{yday(t)}");
    }
    if s == "DD" {
        return Some(pad_n(t.d, 2));
    }
    if s == "D" {
        return Some(f"{t.d}");
    }
    if s == "Do" {
        return Some(ordinal_number(l, t.d));
    }
    if s == "dddd" {
        return Some(l.day_names[isoweekday(t)].clone());
    }
    if s == "ddd" {
        return Some(l.day_abbreviations[isoweekday(t)].clone());
    }
    if s == "d" {
        return Some(f"{isoweekday(t)}");
    }
    if s == "HH" {
        return Some(pad_n(t.h, 2));
    }
    if s == "H" {
        return Some(f"{t.h}");
    }
    if s == "hh" {
        return Some(pad_n(hour12, 2));
    }
    if s == "h" {
        return Some(f"{hour12}");
    }
    if s == "mm" {
        return Some(pad_n(t.mi, 2));
    }
    if s == "m" {
        return Some(f"{t.mi}");
    }
    if s == "ss" {
        return Some(pad_n(t.s, 2));
    }
    if s == "s" {
        return Some(f"{t.s}");
    }
    if s == "SSSSSS" {
        return Some(pad_n(t.us, 6));
    }
    if s == "SSSSS" {
        return Some(pad_n(t.us / 10, 5));
    }
    if s == "SSSS" {
        return Some(pad_n(t.us / 100, 4));
    }
    if s == "SSS" {
        return Some(pad_n(t.us / 1000, 3));
    }
    if s == "SS" {
        return Some(pad_n(t.us / 10000, 2));
    }
    if s == "S" {
        return Some(f"{t.us / 100000}");
    }
    if s == "X" {
        return Some(float_repr(timestamp(t)));
    }
    if s == "x" {
        let v = round_half_even(timestamp(t) * 1000000.0) as i64;
        return Some(f"{v}");
    }
    if s == "ZZZ" {
        return tzname_of(t);
    }
    if s == "ZZ" or s == "Z" {
        let sep = if s == "ZZ" { ":" } else { "" };
        let total = utcoffset(t).unwrap_or(0) / 60;
        let sign = if total >= 0 { "+" } else { "-" };
        let a = total.abs();
        return Some(f"{sign}{pad_n(a / 60, 2)}{sep}{pad_n(a % 60, 2)}");
    }
    if s == "a" {
        return Some(if t.h < 12 { meridian(l, "am") } else { meridian(l, "pm") });
    }
    if s == "A" {
        return Some(if t.h < 12 { meridian(l, "AM") } else { meridian(l, "PM") });
    }
    if s == "W" {
        let (y, w, d) = isocalendar(t.y, t.mo, t.d);
        return Some(f"{y}-W{pad_n(w, 2)}-{d}");
    }
    None
}

// Arrow.format(fmt, locale)
fn format_with(ctx: mut ref Ctx, t: ref DateTime, fmt: ref String, locale: ref String) -> Result[String, PyErr] {
    let li = get_locale(ctx, locale)?;
    let id = re_id_s(mut ctx, "(\\[(?:(?=(?P<literal>[^]]))(?P=literal))*\\]|YYY?Y?|MM?M?M?|Do|DD?D?D?|d?dd?d?|HH?|hh?|mm?|ss?|SS?S?S?S?S?|ZZ?Z?|a|A|X|x|W)", 0);
    let f = cps_of(fmt);
    let mut out = String.new();
    let mut last = 0;
    for m in re_all(ctx, id, f) {
        out.push_str(to_string(slice(f, last, m.start)).as_str());
        if let Some(s) = format_token(ctx.locales[li], t, slice(f, m.start, m.end)) {
            out.push_str(s.as_str());
        }
        last = m.end;
    }
    out.push_str(to_string(slice(f, last, f.len())).as_str());
    Ok(out)
}

fn format_en(ctx: mut ref Ctx, t: ref DateTime, fmt: Str) -> String {
    format_with(mut ctx, t, fmt.to_string(), "en-us".to_string()).unwrap_or(String.new())
}
// ------------------------------------------------------------ Arrow methods

// Arrow.shift with the relative fields already gathered: relativedelta,
// then resolve_imaginary when the wall time does not exist.
fn shift_by(a: ref DateTime, years: i64, months: i64, weeks: i64, days: i64, hours: i64, minutes: i64, seconds: i64, us: i64, wd: i64) -> Result[DateTime, PyErr] {
    let rd = rel_delta(years, months, days + weeks * 7, hours, minutes, seconds, us, wd);
    let mut cur = rd_add(a, rd)?;
    if not datetime_exists(cur)? {
        cur = resolve_imaginary(cur)?;
    }
    Ok(cur)
}

// a.shift(**{name: n}) for one plural frame name
fn shift_one(a: ref DateTime, name: ref String, n: i64) -> Result[DateTime, PyErr] {
    let k = name.as_str();
    if k == "years" {
        return shift_by(a, n, 0, 0, 0, 0, 0, 0, 0, -1);
    }
    if k == "months" {
        return shift_by(a, 0, n, 0, 0, 0, 0, 0, 0, -1);
    }
    if k == "weeks" {
        return shift_by(a, 0, 0, n, 0, 0, 0, 0, 0, -1);
    }
    if k == "days" {
        return shift_by(a, 0, 0, 0, n, 0, 0, 0, 0, -1);
    }
    if k == "hours" {
        return shift_by(a, 0, 0, 0, 0, n, 0, 0, 0, -1);
    }
    if k == "minutes" {
        return shift_by(a, 0, 0, 0, 0, 0, n, 0, 0, -1);
    }
    if k == "seconds" {
        return shift_by(a, 0, 0, 0, 0, 0, 0, n, 0, -1);
    }
    shift_by(a, 0, 0, 0, 0, 0, 0, 0, n, -1)
}

fn shift_names() -> Str {
    "years months days hours minutes seconds microseconds weeks quarters weekday"
}

fn is_word_in(w: ref String, list: Str) -> bool {
    for x in list.split(" ") {
        if w == x {
            return true;
        }
    }
    false
}

// A shift amount: an int, or a float, which only years and months
// refuse.
#[derive(Clone)]
enum Num {
    I(i64),
    F(f64),
}

// Arrow.shift(**kwargs)
fn shift_kw(a: ref DateTime, kw: ref Vec[(String, Num)]) -> Result[DateTime, PyErr] {
    let mut vals: Vec[(String, Num)] = Vec.new();
    for (k, v) in kw.iter() {
        if not is_word_in(k, shift_names()) {
            return Err(value_error(f"Invalid shift time frame. Please select one of the following: {shift_names().replace(" ", ", ")}."));
        }
        vals.push((k.clone(), v.clone()));
    }
    let mut years = Num.I(0);
    let mut months = Num.I(0);
    let mut quarters = 0;
    let mut weeks = 0;
    let mut days = 0;
    let mut hours = 0;
    let mut minutes = 0;
    let mut seconds = 0;
    let mut us = 0;
    let mut wd = -1;
    for (k, v) in vals.iter() {
        let n = match v {
            Num.I(i) => i,
            Num.F(x) => x.trunc() as i64,
        };
        let key = k.as_str();
        if key == "years" {
            years = v.clone();
        } else if key == "months" {
            months = v.clone();
        } else if key == "quarters" {
            quarters = n;
        } else if key == "weeks" {
            weeks = n;
        } else if key == "days" {
            days = n;
        } else if key == "hours" {
            hours = n;
        } else if key == "minutes" {
            minutes = n;
        } else if key == "seconds" {
            seconds = n;
        } else if key == "microseconds" {
            us = n;
        } else {
            wd = n;
        }
    }
    let y = match years {
        Num.I(i) => i,
        Num.F(x) => {
            if x != x.trunc() {
                return Err(value_error("Non-integer years and months are ambiguous and not currently supported.".to_string()));
            }
            x as i64
        }
    };
    let m = match months {
        Num.I(i) => i + quarters * 3,
        Num.F(x) => {
            let total = x + (quarters * 3) as f64;
            if total != total.trunc() {
                return Err(value_error("Non-integer years and months are ambiguous and not currently supported.".to_string()));
            }
            total as i64
        }
    };
    shift_by(a, y, m, weeks, days, hours, minutes, seconds, us, wd)
}

fn attrs() -> Str {
    "year month day hour minute second microsecond"
}

// Arrow._get_frames: the absolute frame, the relative one, and its step
fn get_frames(name: ref String) -> Result[(String, String, i64), PyErr] {
    if is_word_in(name, attrs()) {
        return Ok((name.clone(), f"{name}s", 1));
    }
    if name.ends_with("s") {
        let base = name[0..name.len() - 1].to_string();
        if is_word_in(base, attrs()) {
            return Ok((base, name.clone(), 1));
        }
    }
    if name == "week" or name == "weeks" {
        return Ok(("week".to_string(), "weeks".to_string(), 1));
    }
    if name == "quarter" or name == "quarters" {
        return Ok(("quarter".to_string(), "months".to_string(), 3));
    }
    Err(value_error(f"Range or span over frame {name} not supported. Supported frames: year(s), month(s), day(s), hour(s), minute(s), second(s), microsecond(s), week(s), quarter(s)."))
}

fn validate_bounds(b: ref String) -> Result[(), PyErr] {
    if b != "()" and b != "(]" and b != "[)" and b != "[]" {
        return Err(value_error("Invalid bounds. Please select between '()', '(]', '[)', or '[]'.".to_string()));
    }
    Ok(())
}

// Arrow.span
fn span(a: ref DateTime, frame: ref String, count: i64, bounds: ref String, exact: bool, week_start: i64) -> Result[(DateTime, DateTime), PyErr] {
    if week_start < 1 or week_start > 7 {
        return Err(value_error("week_start argument must be between 1 and 7.".to_string()));
    }
    validate_bounds(bounds)?;
    let (absolute, relative, steps) = get_frames(frame)?;
    let attr = if absolute == "week" {
        "day".to_string()
    } else if absolute == "quarter" {
        "month".to_string()
    } else {
        absolute.clone()
    };
    let mut floor = a.clone();
    if not exact {
        let mut index = 0;
        for (i, n) in attrs().split(" ").enumerate() {
            if n == attr {
                index = i;
            }
        }
        let all = [a.y, a.mo, a.d, a.h, a.mi, a.s, a.us];
        let mut v = [1, 1, 1, 0, 0, 0, 0];
        let mut k = 0;
        while k <= index {
            v[k] = all[k];
            k += 1;
        }
        floor = make_dt(v[0], v[1], v[2], v[3], v[4], v[5], v[6], a.tz, 0)?;
        if absolute == "week" {
            let iso = isoweekday(a);
            let delta = if week_start > iso { 7 } else { 0 };
            floor = shift_one(floor, "days".to_string(), -(iso - week_start) - delta)?;
        } else if absolute == "quarter" {
            floor = shift_one(floor, "months".to_string(), -((a.mo - 1) % 3))?;
        }
    }
    let mut ceil = shift_one(floor, relative, count * steps)?;
    if bounds.starts_with("(") {
        floor = shift_one(floor, "microseconds".to_string(), 1)?;
    }
    if bounds.ends_with(")") {
        ceil = shift_one(ceil, "microseconds".to_string(), -1)?;
    }
    Ok((floor, ceil))
}

fn span_plain(a: ref DateTime, frame: ref String) -> Result[(DateTime, DateTime), PyErr] {
    span(a, frame, 1, "[)".to_string(), false, 1)
}

fn is_last_day(t: ref DateTime) -> bool {
    t.d == days_in_month(t.y, t.mo)
}

fn tz_arg_or(tz: ref Option[TzArg], t: ref DateTime) -> Option[TzArg] {
    match tz {
        Some(a) => Some(a.clone()),
        None => match t.tz {
            Some(z) => Some(TzArg.Obj(z.clone())),
            None => None,
        },
    }
}

// Arrow.range: what it yields, and the error that stopped it, if any
fn arrow_range(ctx: mut ref Ctx, frame: ref String, start: ref DateTime, end: ref Option[DateTime], tz: ref Option[TzArg], limit: Option[i64]) -> (Vec[DateTime], Option[PyErr]) {
    let mut out: Vec[DateTime] = Vec.new();
    let relative = match get_frames(frame) {
        Ok((_, r, steps)) => (r, steps),
        Err(e) => return (out, Some(e)),
    };
    let tzinfo = match get_tzinfo(mut ctx, tz_arg_or(tz, start)) {
        Ok(z) => Some(z),
        Err(e) => return (out, Some(e)),
    };
    let first = with_tz(start, tzinfo);
    let (last0, lim) = match end {
        None => match limit {
            None => return (out, Some(value_error("One of 'end' or 'limit' is required.".to_string()))),
            Some(n) => (arrow_max(), n),
        },
        Some(e) => (e.clone(), limit.unwrap_or(9223372036854775807)),
    };
    let last = with_tz(last0, tzinfo);
    let mut current = first.clone();
    let original_day = first.d;
    let mut clipped = false;
    let mut i = 0;
    while dt_le(current, last) and i < lim {
        i += 1;
        out.push(current.clone());
        let base = with_fold(current, 0);
        current = match shift_one(base, relative.0, relative.1) {
            Ok(c) => c,
            Err(e) => return (out, Some(e)),
        };
        if (frame == "month" or frame == "quarter" or frame == "year") and current.d < original_day {
            clipped = true;
        }
        if clipped and not is_last_day(current) {
            current = match make_dt(current.y, current.mo, original_day, current.h, current.mi, current.s, current.us, current.tz, current.fold) {
                Ok(c) => c,
                Err(e) => return (out, Some(e)),
            };
        }
    }
    (out, None)
}

// Arrow.span_range
fn span_range(ctx: mut ref Ctx, frame: ref String, start: ref DateTime, end: ref DateTime, tz: ref Option[TzArg], limit: Option[i64], bounds: ref String, exact: bool) -> (Vec[(DateTime, DateTime)], Option[PyErr]) {
    let mut out: Vec[(DateTime, DateTime)] = Vec.new();
    let tzinfo = match get_tzinfo(mut ctx, tz_arg_or(tz, start)) {
        Ok(z) => Some(z),
        Err(e) => return (out, Some(e)),
    };
    let first = match span(with_tz(start, tzinfo), frame, 1, "[)".to_string(), exact, 1) {
        Ok((f, _)) => f,
        Err(e) => return (out, Some(e)),
    };
    let last = with_tz(end, tzinfo);
    let (items, err) = arrow_range(mut ctx, frame, first, Some(last.clone()), tz, limit);
    for r in items.iter() {
        let (floor, ceil0) = match span(r, frame, 1, bounds, exact, 1) {
            Ok(p) => p,
            Err(e) => return (out, Some(e)),
        };
        if not exact {
            out.push((floor, ceil0));
            continue;
        }
        let mut ceil = ceil0;
        if dt_lt(last, ceil) {
            ceil = last.clone();
            if bounds.ends_with(")") {
                ceil = match add_us(ceil, -1) {
                    Ok(c) => c,
                    Err(e) => return (out, Some(e)),
                };
            }
        }
        if dt_eq(floor, last) {
            break;
        }
        match add_us(floor, -1) {
            Ok(before) => {
                if dt_eq(before, last) {
                    break;
                }
            }
            Err(e) => return (out, Some(e)),
        }
        out.push((floor, ceil));
    }
    (out, err)
}

// Arrow.interval
fn interval(ctx: mut ref Ctx, frame: ref String, start: ref DateTime, end: ref DateTime, every: i64, tz: ref Option[TzArg], bounds: ref String, exact: bool) -> (Vec[(DateTime, DateTime)], Option[PyErr]) {
    let mut out: Vec[(DateTime, DateTime)] = Vec.new();
    if every < 1 {
        return (out, Some(value_error("interval has to be a positive integer".to_string())));
    }
    let (spans, err) = span_range(mut ctx, frame, start, end, tz, None, bounds, exact);
    let mut i = 0;
    while i < spans.len() {
        let j = if i + every - 1 < spans.len() { i + every - 1 } else { spans.len() - 1 };
        out.push((spans[i].0.clone(), spans[j].1.clone()));
        i += every;
    }
    (out, err)
}

// What humanize compares against.
#[derive(Clone)]
enum Other {
    Arw(DateTime),
    Naive(DateTime),
    Aware(DateTime),
    Text(String),
}

#[derive(Clone)]
enum Gran {
    Auto,
    One(String),
    Many(Vec[String]),
}

fn secs_map(frame: Str) -> f64 {
    if frame == "second" {
        1.0
    } else if frame == "minute" {
        60.0
    } else if frame == "hour" {
        3600.0
    } else if frame == "day" {
        86400.0
    } else if frame == "week" {
        604800.0
    } else if frame == "month" {
        2635200.0
    } else if frame == "quarter" {
        7905600.0
    } else {
        31536000.0
    }
}

fn invalid_granularity() -> PyErr {
    value_error("Invalid level of granularity. Please select between 'second', 'minute', 'hour', 'day', 'week', 'month', 'quarter' or 'year'.".to_string())
}

fn max2(a: i64) -> i64 {
    if a > 2 { a } else { 2 }
}

// Arrow.humanize
fn humanize(ctx: mut ref Ctx, a: ref DateTime, other: ref Other, locale: ref String, only_distance: bool, granularity: ref Gran) -> Result[String, PyErr] {
    let li = get_locale(ctx, locale)?;
    let tz = a.tz.clone().unwrap_or(Tz.Utc);
    let dt = match other {
        Other.Arw(o) => o.clone(),
        Other.Naive(o) => with_tz(o, Some(tz)),
        Other.Aware(o) => astimezone(o, tz)?,
        Other.Text(_) => return Err(type_error("Invalid 'other' argument of type 'str'. Argument must be of type None, Arrow, or datetime.".to_string())),
    };
    let gran = match granularity {
        Gran.Many(list) => {
            if list.len() == 1 { Gran.One(list[0].clone()) } else { Gran.Many(list.clone()) }
        }
        g => g.clone(),
    };
    let delta = round_half_even((sub_us(a, dt) as f64) / 1000000.0) as i64;
    let sign = if delta < 0 { -1 } else { 1 };
    let diff = delta.abs();
    let l = ref ctx.locales[li];
    let result = match gran {
        Gran.Auto => {
            let fd = diff as f64;
            if diff < 10 {
                describe(l, "now", 0.0, only_distance)
            } else if diff < 60 {
                describe(l, "seconds", (sign * diff) as f64, only_distance)
            } else if diff < 120 {
                describe(l, "minute", sign as f64, only_distance)
            } else if diff < 3600 {
                describe(l, "minutes", (sign * max2(diff / 60)) as f64, only_distance)
            } else if diff < 7200 {
                describe(l, "hour", sign as f64, only_distance)
            } else if diff < 86400 {
                describe(l, "hours", (sign * max2(diff / 3600)) as f64, only_distance)
            } else if diff < 172800 {
                describe(l, "day", sign as f64, only_distance)
            } else if diff < 604800 {
                describe(l, "days", (sign * max2(diff / 86400)) as f64, only_distance)
            } else if diff < 1209600 {
                describe(l, "week", sign as f64, only_distance)
            } else if fd < 2635200.0 {
                describe(l, "weeks", (sign * max2(diff / 604800)) as f64, only_distance)
            } else if fd < 2635200.0 * 2.0 {
                describe(l, "month", sign as f64, only_distance)
            } else if diff < 31536000 {
                let self_months = a.y * 12 + a.mo;
                let other_months = dt.y * 12 + dt.mo;
                describe(l, "months", (sign * max2((other_months - self_months).abs())) as f64, only_distance)
            } else if diff < 63072000 {
                describe(l, "year", sign as f64, only_distance)
            } else {
                describe(l, "years", (sign * max2(diff / 31536000)) as f64, only_distance)
            }
        }
        Gran.One(g) => {
            let frames = "second minute hour day week month quarter year";
            if not is_word_in(g, frames) {
                return Err(invalid_granularity());
            }
            let d = if g == "second" {
                (sign as f64) * (diff as f64)
            } else {
                ((sign * diff) as f64) / secs_map(g.as_str())
            };
            if g == "second" and d.abs() < 2.0 {
                describe(l, "now", 0.0, only_distance)
            } else {
                let name = if d.abs().trunc() != 1.0 { f"{g}s" } else { g.clone() };
                describe(l, name.as_str(), d, only_distance)
            }
        }
        Gran.Many(list) => {
            if list.len() == 0 {
                return Err(value_error("Empty granularity list provided. Please select one or more from 'second', 'minute', 'hour', 'day', 'week', 'month', 'quarter', 'year'.".to_string()));
            }
            let mut frames: Vec[(String, f64)] = Vec.new();
            let mut rest = diff as f64;
            for f in "year quarter month week day hour minute second".split(" ") {
                let mut wanted = false;
                for g in list.iter() {
                    if g == f {
                        wanted = true;
                    }
                }
                if wanted {
                    let value = (sign as f64) * rest / secs_map(f);
                    rest = rest % secs_map(f);
                    if value.abs().trunc() != 1.0 {
                        frames.push((f"{f}s", value));
                    } else {
                        frames.push((f.to_string(), value));
                    }
                }
            }
            if frames.len() < list.len() {
                return Err(invalid_granularity());
            }
            describe_multi(l, frames, only_distance)
        }
    };
    match result {
        Ok(s) => Ok(s),
        Err(e) => {
            if e.kind == "KeyError" {
                Err(value_error(f"Humanization of the {e.msg} granularity is not currently translated in the {srepr(locale)} locale. Please consider making a contribution to this locale."))
            } else {
                Err(e)
            }
        }
    }
}

fn dehumanize_locales() -> Str {
    "en en-us en-gb en-au en-be en-jp en-za en-ca en-ph fr fr-fr fr-ca it it-it es es-es el el-gr ja ja-jp se se-fi se-no se-se sv sv-se fi fi-fi zh zh-cn zh-tw zh-hk nl nl-nl be be-by pl pl-pl ru ru-ru af bg bg-bg ua uk uk-ua mk mk-mk de de-de de-ch de-at nb nb-no nn nn-no pt pt-pt pt-br tl tl-ph vi vi-vn tr tr-tr az az-az da da-dk ml hi cs cs-cz sk sk-sk fa fa-ir mr ca ca-es ca-ad ca-fr ca-it eo eo-xx bn bn-bd bn-in rm rm-ch ro ro-ro sl sl-si id id-id ne ne-np ee et sw sw-ke sw-tz la la-va lt lt-lt ms ms-my ms-bn or or-in lb lb-lu zu zu-za sq sq-al ta ta-in ta-lk ur ur-pk ka ka-ge kk kk-kz am am-et hy-am hy uz uz-uz"
}

fn is_numeric_text(s: ref String) -> bool {
    let cs = cps_of(s);
    if cs.len() == 0 {
        return false;
    }
    for c in cs {
        if not is_decimal(c) {
            return false;
        }
    }
    true
}

// Arrow.dehumanize
fn dehumanize(ctx: mut ref Ctx, a: ref DateTime, input: ref String, locale: ref String) -> Result[DateTime, PyErr] {
    let li = get_locale(ctx, locale)?;
    if not is_word_in(normalize_locale(locale), dehumanize_locales()) {
        return Err(value_error(f"Dehumanize does not currently support the {locale} locale, please consider making a contribution to add support for this locale."));
    }
    let s = cps_of(input);
    let mut units: Vec[(String, i64, bool)] = Vec.new();
    for u in "seconds minutes hours days weeks months years".split(" ") {
        units.push((u.to_string(), 0, false));
    }
    let mut now_visited = false;
    let num = re_id_s(mut ctx, "\\d+", 0);
    let mut searches: Vec[(String, String, String)] = Vec.new();
    for frame in ctx.locales[li].tf.iter() {
        for (sub, text) in frame.forms.iter() {
            searches.push((frame.key.clone(), sub.clone(), text.clone()));
        }
    }
    for (unit, sub, text) in searches.iter() {
        let pattern = f"(^|\\b|\\d){text.replace("{0}", "\\d+")}";
        let id = re_id(mut ctx, cps_of(pattern), 0)?;
        let m = match re_find(ctx, id, s, 0) {
            Some(m) => m,
            None => continue,
        };
        let whole = slice(s, m.start, m.end);
        let change = match re_find(ctx, num, whole, 0) {
            Some(n) => int_of(slice(whole, n.start, n.end)),
            None => if is_numeric_text(sub) { int_of(cps_of(sub)).abs() } else { 1 },
        };
        if unit == "now" {
            now_visited = true;
            continue;
        }
        let name = if unit.ends_with("s") { unit.clone() } else { f"{unit}s" };
        let mut found = false;
        let mut k = 0;
        while k < units.len() {
            if units[k].0 == name {
                units[k].1 = change;
                units[k].2 = true;
                found = true;
            }
            k += 1;
        }
        if not found {
            units.push((name, change, true));
        }
    }
    let mut any = now_visited;
    for (_, _, v) in units.iter() {
        if v {
            any = true;
        }
    }
    if not any {
        return Err(value_error("Input string not valid. Note: Some locales do not support the week granularity in Arrow. If you are attempting to use the week granularity on an unsupported locale, this could be the cause of this error.".to_string()));
    }
    let future = ctx.locales[li].future.replace("{0}", ".*");
    let past = ctx.locales[li].past.replace("{0}", ".*");
    let fid = re_id(mut ctx, cps_of(f"^{future}$"), 0)?;
    let pid = re_id(mut ctx, cps_of(f"^{past}$"), 0)?;
    let sign = if re_find(ctx, pid, s, 0).is_some() {
        -1
    } else if re_find(ctx, fid, s, 0).is_some() {
        1
    } else if now_visited {
        0
    } else {
        return Err(value_error("Invalid input String. String does not contain any relative time information. String should either represent a time in the future or a time in the past. Ex: 'in 5 seconds' or '5 seconds ago'.".to_string()));
    };
    let mut kw: Vec[(String, Num)] = Vec.new();
    for (name, v, _) in units.iter() {
        kw.push((name.clone(), Num.I(sign * v)));
    }
    shift_kw(a, kw)
}

// Arrow.is_between
fn is_between(a: ref DateTime, start: ref DateTime, end: ref DateTime, bounds: ref String) -> Result[bool, PyErr] {
    validate_bounds(bounds)?;
    let inc_start = bounds.starts_with("[");
    let inc_end = bounds.ends_with("]");
    let t = timestamp(a);
    let s = timestamp(start);
    let e = timestamp(end);
    Ok(s <= t and t <= e and (inc_start or s < t) and (inc_end or t < e))
}

// Arrow.replace(**kwargs)
fn replace_kw(ctx: mut ref Ctx, a: ref DateTime, kw: ref Vec[(String, J)]) -> Result[DateTime, PyErr] {
    let mut v = [a.y, a.mo, a.d, a.h, a.mi, a.s, a.us];
    let names = ["year", "month", "day", "hour", "minute", "second", "microsecond"];
    let mut tz: Option[String] = None;
    let mut fold: Option[i64] = None;
    for (k, val) in kw.iter() {
        let mut hit = false;
        let mut i = 0;
        while i < 7 {
            if k == names[i] {
                v[i] = match val {
                    J.N(n) => n,
                    _ => 0,
                };
                hit = true;
            }
            i += 1;
        }
        if hit {
            continue;
        }
        if k == "week" or k == "quarter" {
            return Err(value_error(f"Setting absolute {k} is not supported."));
        }
        if k == "tzinfo" {
            if let J.S(s) = val {
                tz = Some(s.clone());
            }
        } else if k == "fold" {
            if let J.N(n) = val {
                fold = Some(n);
            }
        } else {
            return Err(value_error(f"Unknown attribute: {srepr(k)}."));
        }
    }
    let mut cur = make_dt(v[0], v[1], v[2], v[3], v[4], v[5], v[6], a.tz, a.fold)?;
    if let Some(name) = tz {
        let z = get_tzinfo(mut ctx, Some(TzArg.Name(name)))?;
        cur = with_tz(cur, Some(z));
    }
    if let Some(f) = fold {
        cur = make_dt(cur.y, cur.mo, cur.d, cur.h, cur.mi, cur.s, cur.us, cur.tz, f)?;
    }
    Ok(cur)
}

// Arrow.to(tz)
fn arrow_to(ctx: mut ref Ctx, a: ref DateTime, tz: ref String) -> Result[DateTime, PyErr] {
    let z = parse_tz(mut ctx, tz)?;
    astimezone(a, z)
}
// ------------------------------------------------------------ arrow.get

fn kw_get(kw: ref Vec[(String, PyVal)], key: Str) -> Option[PyVal] {
    for (k, v) in kw.iter() {
        if k == key {
            return Some(v.clone());
        }
    }
    None
}

fn tz_of_val(v: ref PyVal) -> Option[TzArg] {
    match v {
        PyVal.Str(s) => Some(TzArg.Name(s.clone())),
        PyVal.TzObj(z) => Some(TzArg.Obj(z.clone())),
        _ => None,
    }
}

fn int_arg(v: ref PyVal) -> i64 {
    match v {
        PyVal.Int(n) => n,
        PyVal.Bool(b) => if b { 1 } else { 0 },
        _ => 0,
    }
}

// Arrow(*args, **kwargs)
fn arrow_call(ctx: mut ref Ctx, args: ref Vec[PyVal], kw: ref Vec[(String, PyVal)]) -> Result[DateTime, PyErr] {
    let mut v = [0, 0, 0, 0, 0, 0, 0];
    let mut k = 0;
    while k < args.len() and k < 7 {
        v[k] = int_arg(args[k]);
        k += 1;
    }
    if args.len() < 3 {
        let names = ["year", "month", "day"];
        return Err(type_error(f"Arrow.__init__() missing required positional argument: '{names[args.len()]}'"));
    }
    let tz = match kw_get(kw, "tzinfo") {
        Some(t) => tz_of_val(t),
        None => None,
    };
    let fold = match kw_get(kw, "fold") {
        Some(f) => int_arg(f),
        None => 0,
    };
    arrow_new(mut ctx, v[0], v[1], v[2], v[3], v[4], v[5], v[6], tz, fold)
}

// ArrowFactory.get(*args, **kwargs)
fn arrow_get(ctx: mut ref Ctx, args: ref Vec[PyVal], kw0: ref Vec[(String, PyVal)]) -> Result[DateTime, PyErr] {
    let mut count = args.len();
    let locale = match kw_get(kw0, "locale") {
        Some(PyVal.Str(s)) => s,
        _ => "en-us".to_string(),
    };
    let tz = kw_get(kw0, "tzinfo");
    let normalize = match kw_get(kw0, "normalize_whitespace") {
        Some(PyVal.Bool(b)) => b,
        _ => false,
    };
    let mut kw: Vec[(String, PyVal)] = Vec.new();
    for (k, v) in kw0.iter() {
        if k != "locale" and k != "normalize_whitespace" {
            kw.push((k.clone(), v.clone()));
        }
    }
    if kw.len() > 1 {
        count = 3;
    }
    if kw.len() == 1 and tz.is_none() {
        count = 3;
    }
    let tz_arg = match tz {
        Some(t) => tz_of_val(t),
        None => None,
    };
    if count == 1 {
        let a = ref args[0];
        return match a {
            PyVal.NoneV => Err(type_error("Cannot parse argument of type None.".to_string())),
            PyVal.Int(_) => arrow_fromtimestamp(mut ctx, a, Some(tz_arg.unwrap_or(TzArg.Obj(Tz.Utc)))),
            PyVal.Float(_) => arrow_fromtimestamp(mut ctx, a, Some(tz_arg.unwrap_or(TzArg.Obj(Tz.Utc)))),
            PyVal.Dt(t) => from_datetime(mut ctx, t, tz_arg),
            PyVal.Date(y, m, d) => from_date(mut ctx, y, m, d, tz_arg),
            PyVal.Str(s) => {
                let li = get_locale(ctx, locale)?;
                let t = parse_iso(mut ctx, li, s, normalize)?;
                from_datetime(mut ctx, t, tz_arg)
            }
            PyVal.Tuple(xs) => {
                if xs.len() == 3 {
                    let (y, m, d) = iso_to_gregorian(xs[0], xs[1], xs[2])?;
                    from_date(mut ctx, y, m, d, tz_arg)
                } else {
                    Err(type_error(f"Cannot parse single argument of type {py_type(a)}."))
                }
            }
            _ => Err(type_error(f"Cannot parse single argument of type {py_type(a)}.")),
        };
    }
    if count == 2 {
        let a1 = ref args[0];
        let a2 = ref args[1];
        let tz2 = tz_of_val(a2);
        return match a1 {
            PyVal.Dt(t) => match tz2 {
                Some(z) => from_datetime(mut ctx, t, Some(z)),
                None => Err(type_error(f"Cannot parse two arguments of types 'datetime', {py_type(a2)}.")),
            },
            PyVal.Date(y, m, d) => match tz2 {
                Some(z) => from_date(mut ctx, y, m, d, Some(z)),
                None => Err(type_error(f"Cannot parse two arguments of types 'date', {py_type(a2)}.")),
            },
            PyVal.Str(s) => {
                let (fmts, one) = match a2 {
                    PyVal.Str(f) => {
                        let mut v: Vec[String] = Vec.new();
                        v.push(f.clone());
                        (v, true)
                    }
                    PyVal.List(fs) => (fs.clone(), false),
                    _ => return Err(type_error(f"Cannot parse two arguments of types {py_type(a1)} and {py_type(a2)}.")),
                };
                let li = get_locale(ctx, locale)?;
                let t = parse_with(mut ctx, li, s, fmts, one, normalize)?;
                from_datetime(mut ctx, t, tz_arg)
            }
            _ => Err(type_error(f"Cannot parse two arguments of types {py_type(a1)} and {py_type(a2)}.")),
        };
    }
    arrow_call(mut ctx, args, kw)
}

// ------------------------------------------------------------ the jobs

// conv(): a job argument as the Python value it stands for
fn conv(ctx: mut ref Ctx, v: ref J) -> Result[PyVal, PyErr] {
    match v {
        J.N(n) => Ok(PyVal.Int(n)),
        J.F(x, _) => Ok(PyVal.Float(x)),
        J.S(s) => Ok(PyVal.Str(s.clone())),
        J.B(b) => Ok(PyVal.Bool(b)),
        J.Null => Ok(PyVal.NoneV),
        J.A(items) => {
            let mut out: Vec[String] = Vec.new();
            for it in items.iter() {
                if let J.S(s) = it {
                    out.push(s.clone());
                }
            }
            Ok(PyVal.List(out))
        }
        J.O(members) => {
            if j_has(v, "tuple") {
                return Ok(PyVal.Tuple(ints_of(j_get(v, "tuple"))));
            }
            if j_has(v, "tz") and members.len() == 1 {
                return Ok(PyVal.TzObj(parse_tz(mut ctx, j_str(v, "tz"))?));
            }
            if j_has(v, "dt") {
                let tz = if j_has(v, "tz") { Some(parse_tz(mut ctx, j_str(v, "tz"))?) } else { None };
                let t = dt_of(ints_of(j_get(v, "dt")), tz)?;
                return Ok(PyVal.Dt(t));
            }
            if j_has(v, "date") {
                let d = ints_of(j_get(v, "date"));
                check_date(d[0], d[1], d[2])?;
                return Ok(PyVal.Date(d[0], d[1], d[2]));
            }
            Ok(PyVal.NoneV)
        }
    }
}

fn ints_of(j: ref J) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    if let J.A(items) = j {
        for it in items.iter() {
            if let J.N(n) = it {
                out.push(n);
            }
        }
    }
    out
}

// datetime.datetime(*vals, tzinfo=tz)
fn dt_of(vals: ref Vec[i64], tz: own Option[Tz]) -> Result[DateTime, PyErr] {
    let mut v = [0, 0, 0, 0, 0, 0, 0];
    let mut k = 0;
    while k < vals.len() and k < 7 {
        v[k] = vals[k];
        k += 1;
    }
    make_dt(v[0], v[1], v[2], v[3], v[4], v[5], v[6], tz, 0)
}

fn members_of(j: ref J) -> Vec[(String, J)] {
    match j {
        J.O(m) => m.clone(),
        _ => Vec.new(),
    }
}

fn items_of(j: ref J) -> Vec[J] {
    match j {
        J.A(m) => m.clone(),
        _ => Vec.new(),
    }
}

// build(spec): the Arrow a job starts from
fn build(ctx: mut ref Ctx, spec: ref J) -> Result[DateTime, PyErr] {
    if j_has(spec, "get") {
        let mut args: Vec[PyVal] = Vec.new();
        for a in items_of(j_get(spec, "get")).iter() {
            args.push(conv(mut ctx, a)?);
        }
        let mut kw: Vec[(String, PyVal)] = Vec.new();
        for (k, v) in members_of(j_get(spec, "kw")).iter() {
            kw.push((k.clone(), conv(mut ctx, v)?));
        }
        return arrow_get(mut ctx, args, kw);
    }
    if j_has(spec, "new") {
        let mut args: Vec[PyVal] = Vec.new();
        for n in ints_of(j_get(spec, "new")) {
            args.push(PyVal.Int(n));
        }
        let mut kw: Vec[(String, PyVal)] = Vec.new();
        if j_has(spec, "tz") {
            kw.push(("tzinfo".to_string(), PyVal.Str(j_str(spec, "tz"))));
        }
        if j_has(spec, "fold") {
            kw.push(("fold".to_string(), PyVal.Int(j_int(spec, "fold", 0))));
        }
        return arrow_call(mut ctx, args, kw);
    }
    if j_has(spec, "ts") {
        let ts = conv(mut ctx, j_get(spec, "ts"))?;
        let tz = if j_has(spec, "tz") { Some(TzArg.Name(j_str(spec, "tz"))) } else { None };
        return arrow_fromtimestamp(mut ctx, ts, tz);
    }
    if j_has(spec, "uts") {
        return arrow_utcfromtimestamp(conv(mut ctx, j_get(spec, "uts"))?);
    }
    if j_has(spec, "ord") {
        return arrow_fromordinal(conv(mut ctx, j_get(spec, "ord"))?);
    }
    if j_has(spec, "min") {
        return Ok(arrow_min());
    }
    Ok(arrow_max())
}

fn other_of(ctx: mut ref Ctx, spec: ref J) -> Result[Other, PyErr] {
    if let J.S(s) = spec {
        return Ok(Other.Text(s.clone()));
    }
    if j_has(spec, "naive") {
        return Ok(Other.Naive(dt_of(ints_of(j_get(spec, "naive")), None)?));
    }
    if j_has(spec, "aware") {
        let z = parse_tz(mut ctx, j_str(spec, "tz"))?;
        return Ok(Other.Aware(dt_of(ints_of(j_get(spec, "aware")), Some(z))?));
    }
    Ok(Other.Arw(build(mut ctx, spec)?))
}

fn num_of(j: ref J) -> Num {
    match j {
        J.F(x, _) => Num.F(x),
        J.N(n) => Num.I(n),
        J.B(b) => Num.I(if b { 1 } else { 0 }),
        _ => Num.I(0),
    }
}

fn shift_args(j: ref J) -> Vec[(String, Num)] {
    let mut out: Vec[(String, Num)] = Vec.new();
    for (k, v) in members_of(j).iter() {
        out.push((k.clone(), num_of(v)));
    }
    out
}

fn kw_str(j: ref J, key: Str, default: Str) -> String {
    match j_get(j, key) {
        J.S(s) => s,
        _ => default.to_string(),
    }
}

fn kw_tz(j: ref J) -> Option[TzArg] {
    match j_get(j, "tz") {
        J.S(s) => Some(TzArg.Name(s)),
        _ => None,
    }
}

fn kw_limit(j: ref J) -> Option[i64] {
    match j_get(j, "limit") {
        J.N(n) => Some(n),
        _ => None,
    }
}

fn granularity_of(j: ref J) -> Gran {
    match j_get(j, "granularity") {
        J.S(s) => {
            if s == "auto" { Gran.Auto } else { Gran.One(s) }
        }
        J.A(items) => {
            let mut out: Vec[String] = Vec.new();
            for it in items.iter() {
                if let J.S(s) = it {
                    out.push(s.clone());
                }
            }
            Gran.Many(out)
        }
        _ => Gran.Auto,
    }
}

fn show_pair(p: ref (DateTime, DateTime)) -> String {
    f"({arrow_repr(p.0)}, {arrow_repr(p.1)})"
}

fn info_line(a: ref DateTime) -> String {
    let (iy, iw, id) = isocalendar(a.y, a.mo, a.d);
    let off = utcoffset(a).unwrap_or(0);
    let dst = dst_of(a).unwrap_or(0);
    let ord = to_ordinal(a.y, a.mo, a.d);
    let cal = f"datetime.IsoCalendarDate(year={iy}, week={iw}, weekday={id})";
    f"weekday={weekday(a.y, a.mo, a.d)} isoweekday={isoweekday(a)} {cal} week={iw} quarter={quarter_of(a)} ts={float_repr(timestamp(a))} int_ts={int_timestamp(a)} utcoffset={td_repr(off * 1000000)} dst={td_repr(dst * 1000000)} tzname={opt_str_repr(tzname_of(a))} fold={a.fold} ambiguous={bool_text(datetime_ambiguous(a))} imaginary={bool_text(imaginary(a))} ordinal={ord}"
}

// timedelta(**kw) in microseconds
fn timedelta_us(j: ref J) -> i64 {
    let mut us = 0;
    for (k, v) in members_of(j).iter() {
        let n = match v {
            J.N(n) => n,
            _ => 0,
        };
        let unit = if k == "weeks" {
            604800000000
        } else if k == "days" {
            86400000000
        } else if k == "hours" {
            3600000000
        } else if k == "minutes" {
            60000000
        } else if k == "seconds" {
            1000000
        } else if k == "milliseconds" {
            1000
        } else {
            1
        };
        us += n * unit;
    }
    us
}

fn print_items(lines: ref Vec[String], err: own Option[PyErr]) -> Result[(), PyErr] {
    for l in lines.iter() {
        println(f"  {l}");
    }
    println(f"  {lines.len()} items");
    match err {
        Some(e) => Err(e),
        None => Ok(()),
    }
}

fn ords_line(ctx: ref Ctx, loc: Str) -> String {
    let li = get_locale(ctx, loc.to_string()).unwrap_or(0);
    let mut parts: Vec[String] = Vec.new();
    for n in [1, 2, 3, 4, 10, 11, 12, 13, 21, 22, 23, 31, 101, 111, 112, -1, -2, -11] {
        parts.push(ordinal_number(ctx.locales[li], n));
    }
    f"{loc} {parts.join(" ")}"
}

fn op_arg(op: ref Vec[J], k: i64) -> J {
    if k < op.len() { op[k].clone() } else { J.Null }
}

// run_op: one operation; returns the Arrow the next operation works on
fn run_op(ctx: mut ref Ctx, a: ref DateTime, op: ref Vec[J]) -> Result[DateTime, PyErr] {
    let name = match op[0] {
        J.S(s) => s.clone(),
        _ => String.new(),
    };
    let n = name.as_str();
    if n == "repr" {
        println(arrow_repr(a));
    } else if n == "info" {
        println(info_line(a));
    } else if n == "tzrepr" {
        println(tz_repr(a.tz.clone().unwrap_or(Tz.Utc)));
    } else if n == "fmt" {
        let fmt = match op_arg(op, 1) {
            J.S(s) => s,
            _ => "YYYY-MM-DD HH:mm:ssZZ".to_string(),
        };
        let loc = match op_arg(op, 2) {
            J.S(s) => s,
            _ => "en-us".to_string(),
        };
        println(format_with(mut ctx, a, fmt, loc)?);
    } else if n == "ords" {
        for loc in ["en", "fr", "es", "it", "de", "fi", "ko", "nl", "pl"] {
            println(ords_line(ctx, loc));
        }
    } else if n == "to" {
        let b = arrow_to(mut ctx, a, j_text(op_arg(op, 1)))?;
        println(arrow_repr(b));
        return Ok(b);
    } else if n == "shift" {
        let b = shift_kw(a, shift_args(op_arg(op, 1)))?;
        println(arrow_repr(b));
        return Ok(b);
    } else if n == "replace" {
        let b = replace_kw(mut ctx, a, members_of(op_arg(op, 1)))?;
        println(arrow_repr(b));
        return Ok(b);
    } else if n == "add" {
        let b = add_us(a, timedelta_us(op_arg(op, 1)))?;
        println(arrow_repr(b));
        return Ok(b);
    } else if n == "span" {
        let kw = op_arg(op, 2);
        let p = span(a, j_text(op_arg(op, 1)), j_int(kw, "count", 1), kw_str(kw, "bounds", "[)"), j_bool(kw, "exact"), j_int(kw, "week_start", 1))?;
        println(show_pair(p));
    } else if n == "floor" {
        println(arrow_repr(span_plain(a, j_text(op_arg(op, 1)))?.0));
    } else if n == "ceil" {
        println(arrow_repr(span_plain(a, j_text(op_arg(op, 1)))?.1));
    } else if n == "range" or n == "span_range" or n == "interval" {
        let end = match op_arg(op, 2) {
            J.Null => None,
            spec => Some(build(mut ctx, spec)?),
        };
        let kw = op_arg(op, 3);
        let frame = j_text(op_arg(op, 1));
        let mut lines: Vec[String] = Vec.new();
        let err = if n == "range" {
            let (items, err) = arrow_range(mut ctx, frame, a, end, kw_tz(kw), kw_limit(kw));
            for x in items.iter() {
                lines.push(arrow_repr(x));
            }
            err
        } else {
            let last = end.unwrap_or(arrow_max());
            let (items, err) = if n == "span_range" {
                span_range(mut ctx, frame, a, last, kw_tz(kw), kw_limit(kw), kw_str(kw, "bounds", "[)"), j_bool(kw, "exact"))
            } else {
                interval(mut ctx, frame, a, last, j_int(kw, "interval", 1), kw_tz(kw), kw_str(kw, "bounds", "[)"), j_bool(kw, "exact"))
            };
            for x in items.iter() {
                lines.push(show_pair(x));
            }
            err
        };
        print_items(lines, err)?;
    } else if n == "humanize" {
        let other = other_of(mut ctx, op_arg(op, 1))?;
        let kw = op_arg(op, 2);
        println(humanize(mut ctx, a, other, kw_str(kw, "locale", "en-us"), j_bool(kw, "only_distance"), granularity_of(kw))?);
    } else if n == "humanize_shift" {
        let b = shift_kw(a, shift_args(op_arg(op, 1)))?;
        let kw = op_arg(op, 2);
        println(humanize(mut ctx, b, Other.Arw(a.clone()), kw_str(kw, "locale", "en-us"), j_bool(kw, "only_distance"), granularity_of(kw))?);
    } else if n == "dehumanize" {
        println(arrow_repr(dehumanize(mut ctx, a, j_text(op_arg(op, 1)), j_text(op_arg(op, 2)))?));
    } else if n == "cmp" {
        let b = build(mut ctx, op_arg(op, 1))?;
        let eq = dt_eq(a, b);
        let lt = dt_lt(a, b);
        let le = dt_le(a, b);
        let gt = dt_lt(b, a);
        let ge = dt_le(b, a);
        println(f"== {bool_text(eq)} != {bool_text(not eq)} < {bool_text(lt)} <= {bool_text(le)} > {bool_text(gt)} >= {bool_text(ge)} a-b {td_repr(sub_us(a, b))} b-a {td_repr(sub_us(b, a))}");
    } else if n == "between" {
        let s = build(mut ctx, op_arg(op, 1))?;
        let e = build(mut ctx, op_arg(op, 2))?;
        println(bool_text(is_between(a, s, e, j_text(op_arg(op, 3)))?));
    } else if n == "iso" {
        let spec = j_text(op_arg(op, 2));
        println(isoformat(a, j_text(op_arg(op, 1)), spec.as_str())?);
    }
    Ok(a.clone())
}

fn j_text(j: ref J) -> String {
    match j {
        J.S(s) => s.clone(),
        _ => String.new(),
    }
}

fn run_ops(ctx: mut ref Ctx, job: ref J) {
    let mut a = match build(mut ctx, j_get(job, "a")) {
        Ok(a) => a,
        Err(e) => {
            println(err_line(e));
            return;
        }
    };
    for op in items_of(j_get(job, "ops")).iter() {
        match run_op(mut ctx, a, items_of(op)) {
            Ok(b) => a = b,
            Err(e) => println(err_line(e)),
        }
    }
}
// ------------------------------------------------------------ the four tools

fn fields_bar(line: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for f in line.split("|") {
        out.push(to_string(strip(cps_of(f.to_string()))));
    }
    out
}

fn data_lines(name: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let text = fs.read_to_string(f"data/{name}").unwrap_or(String.new());
    for line in text.split("\n") {
        if line.len() > 0 and not line.starts_with("#") {
            out.push(line.to_string());
        }
    }
    out
}

fn ljust(s: ref String, w: i64) -> String {
    let mut out = s.clone();
    let mut n = cps_of(s).len();
    while n < w {
        out.push_str(" ");
        n += 1;
    }
    out
}

fn rjust(s: ref String, w: i64) -> String {
    let mut pad = String.new();
    let mut n = cps_of(s).len();
    while n < w {
        pad.push_str(" ");
        n += 1;
    }
    f"{pad}{s}"
}

// "%.2f" % (cents / 100) for a whole number of cents
fn money(cents: i64) -> String {
    let sign = if cents < 0 { "-" } else { "" };
    let c = cents.abs();
    f"{sign}{c / 100}.{pad_n(c % 100, 2)}"
}

// whitespace split, as str.split() does it
fn words(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    for c in cps_of(s) {
        if is_space(c, false) {
            if cur.len() > 0 {
                out.push(to_string(cur));
                cur = Vec.new();
            }
        } else {
            cur.push(c);
        }
    }
    if cur.len() > 0 {
        out.push(to_string(cur));
    }
    out
}

fn get_kw(ctx: mut ref Ctx, args: own Vec[PyVal], kw: own Vec[(String, PyVal)]) -> Result[DateTime, PyErr] {
    arrow_get(mut ctx, args, kw)
}

fn one_str(s: ref String) -> Vec[PyVal] {
    let mut v: Vec[PyVal] = Vec.new();
    v.push(PyVal.Str(s.clone()));
    v
}

fn tz_kw(zone: ref String) -> Vec[(String, PyVal)] {
    let mut kw: Vec[(String, PyVal)] = Vec.new();
    kw.push(("tzinfo".to_string(), PyVal.Str(zone.clone())));
    kw
}

fn utc_iso(ctx: mut ref Ctx, a: ref DateTime) -> String {
    match arrow_to(mut ctx, a, "UTC".to_string()) {
        Ok(u) => iso(u),
        Err(e) => err_line(e),
    }
}

fn replace_one(ctx: mut ref Ctx, a: ref DateTime, key: Str, v: own J) -> Result[DateTime, PyErr] {
    let mut kw: Vec[(String, J)] = Vec.new();
    kw.push((key.to_string(), v));
    replace_kw(mut ctx, a, kw)
}

// a stable sort of Arrows by their comparison
fn sort_arrows(xs: ref Vec[DateTime]) -> Vec[DateTime] {
    let mut out = xs.clone();
    let mut i = 1;
    while i < out.len() {
        let mut j = i;
        while j > 0 and dt_lt(out[j], out[j - 1]) {
            let x = out[j].clone();
            out[j] = out[j - 1].clone();
            out[j - 1] = x;
            j -= 1;
        }
        i += 1;
    }
    out
}

fn log_stamp(ctx: mut ref Ctx, svc: ref String, rest: ref String, zone: ref String, tried: ref Vec[String]) -> Result[DateTime, PyErr] {
    let text = if svc == "audit" {
        words(rest)[0].clone()
    } else if svc == "api" {
        let mut ts = String.new();
        for w in words(rest).iter() {
            if w.starts_with("ts=") {
                ts = w[3..].to_string();
            }
        }
        ts
    } else {
        rest.clone()
    };
    let mut args: Vec[PyVal] = Vec.new();
    args.push(PyVal.Str(text));
    args.push(PyVal.List(tried.clone()));
    let mut kw: Vec[(String, PyVal)] = Vec.new();
    kw.push(("normalize_whitespace".to_string(), PyVal.Bool(true)));
    let mut a = arrow_get(mut ctx, args, kw)?;
    if zone != "-" {
        a = replace_one(mut ctx, a, "tzinfo", J.S(zone.clone()))?;
    }
    if a.y == 1 {
        a = replace_one(mut ctx, a, "year", J.N(2024))?;
    } else if a.y == 1970 and svc != "audit" {
        // a weekday and a time: that day in the week the log covers
        let week = arrow_get(mut ctx, one_str("2024-03-04".to_string()), tz_kw(zone))?;
        let wd = weekday(a.y, a.mo, a.d);
        let mut kw: Vec[(String, Num)] = Vec.new();
        kw.push(("weekday".to_string(), Num.I(wd)));
        let shifted = shift_kw(week, kw)?;
        let mut rk: Vec[(String, J)] = Vec.new();
        rk.push(("hour".to_string(), J.N(a.h)));
        rk.push(("minute".to_string(), J.N(a.mi)));
        a = replace_kw(mut ctx, shifted, rk)?;
    }
    Ok(a)
}

fn run_logs(ctx: mut ref Ctx) {
    let mut fmts: Vec[(String, String, Vec[String])] = Vec.new();
    for line in data_lines("formats.txt").iter() {
        let f = fields_bar(line);
        let mut tried: Vec[String] = Vec.new();
        let mut k = 2;
        while k < f.len() {
            tried.push(f[k].clone());
            k += 1;
        }
        fmts.push((f[0].clone(), f[1].clone(), tried));
    }
    let mut hours: Vec[(DateTime, i64)] = Vec.new();
    let mut per: Vec[(String, Vec[DateTime])] = Vec.new();
    let mut stamps: Vec[DateTime] = Vec.new();
    for line in data_lines("app.log").iter() {
        let (svc, rest) = match line.find(" ") {
            Some(k) => (line[..k].to_string(), line[k + 1..].to_string()),
            None => (line.clone(), String.new()),
        };
        let mut found: Option[(String, Vec[String])] = None;
        for (name, zone, tried) in fmts.iter() {
            if *name == svc {
                found = Some((zone.clone(), tried.clone()));
            }
        }
        let (zone, tried) = match found {
            Some(f) => f,
            None => {
                println(f"{ljust(svc, 7)} no format for this service");
                continue;
            }
        };
        let a = match log_stamp(mut ctx, svc, rest, zone, tried) {
            Ok(a) => a,
            Err(e) => {
                println(f"{ljust(svc, 7)} {err_line(e)}");
                continue;
            }
        };
        let flag = if imaginary(a) {
            " (no such local time)"
        } else if datetime_ambiguous(a) {
            " (ambiguous)"
        } else {
            ""
        };
        println(f"{ljust(svc, 7)} {utc_iso(mut ctx, a)}  local {format_en(mut ctx, a, "ddd HH:mm:ss ZZ")}{flag}");
        let h = match arrow_to(mut ctx, a, "UTC".to_string()) {
            Ok(u) => span_plain(u, "hour".to_string()).unwrap_or((u.clone(), u.clone())).0,
            Err(_) => a.clone(),
        };
        let mut hit = false;
        let mut k = 0;
        while k < hours.len() {
            if dt_eq(hours[k].0, h) {
                hours[k].1 += 1;
                hit = true;
            }
            k += 1;
        }
        if not hit {
            hours.push((h, 1));
        }
        let mut placed = false;
        k = 0;
        while k < per.len() {
            if per[k].0 == svc {
                per[k].1.push(a.clone());
                placed = true;
            }
            k += 1;
        }
        if not placed {
            let mut v: Vec[DateTime] = Vec.new();
            v.push(a.clone());
            per.push((svc.clone(), v));
        }
        stamps.push(a);
    }
    println("by hour (UTC):");
    let mut keys: Vec[DateTime] = Vec.new();
    for (h, _) in hours.iter() {
        keys.push(h.clone());
    }
    for h in sort_arrows(keys).iter() {
        let mut n = 0;
        for (k, c) in hours.iter() {
            if dt_eq(k, h) {
                n = c;
            }
        }
        let mut bar = String.new();
        for _ in 0..n {
            bar.push_str("#");
        }
        println(f"  {format_en(mut ctx, h, "YYYY-MM-DD HH:mm")}  {bar} {n}");
    }
    println("by service:");
    let mut names: Vec[String] = Vec.new();
    for (s, _) in per.iter() {
        names.push(s.clone());
    }
    names.sort();
    for name in names.iter() {
        let mut xs: Vec[DateTime] = Vec.new();
        for (s, v) in per.iter() {
            if s == name {
                xs = sort_arrows(v);
            }
        }
        let first = utc_iso(mut ctx, xs[0]);
        let last = utc_iso(mut ctx, xs[xs.len() - 1]);
        println(f"  {ljust(name, 7)} {xs.len()} lines, {first} .. {last}");
    }
    let mut lo = stamps[0].clone();
    let mut hi = stamps[0].clone();
    for s in stamps.iter() {
        if dt_lt(s, lo) {
            lo = s.clone();
        }
        if dt_lt(hi, s) {
            hi = s.clone();
        }
    }
    let mut g: Vec[String] = Vec.new();
    g.push("hour".to_string());
    g.push("minute".to_string());
    g.push("second".to_string());
    let span_text = match humanize(mut ctx, hi, Other.Arw(lo.clone()), "en-us".to_string(), true, Gran.Many(g)) {
        Ok(s) => s,
        Err(e) => err_line(e),
    };
    let rel = match humanize(mut ctx, lo, Other.Arw(hi.clone()), "en-us".to_string(), false, Gran.Auto) {
        Ok(s) => s,
        Err(e) => err_line(e),
    };
    println(f"window: {span_text} ({rel})");
}

fn same_date(a: ref DateTime, b: ref DateTime) -> bool {
    a.y == b.y and a.mo == b.mo and a.d == b.d
}

fn meeting_line(ctx: mut ref Ctx, s: ref DateTime, minutes: i64, zones: ref Vec[String]) -> Result[String, PyErr] {
    let end = shift_one(s, "minutes".to_string(), minutes)?;
    let mut parts: Vec[String] = Vec.new();
    for z in zones.iter() {
        let ls = arrow_to(mut ctx, s, z)?;
        let le = arrow_to(mut ctx, end, z)?;
        let mark = if ls.h < 8 or le.h > 18 or (le.h == 18 and le.mi > 0) { "*" } else { "" };
        let day = if not same_date(ls, s) { f" ({format_en(mut ctx, ls, "ddd")})" } else { String.new() };
        let city = match z.rfind("/") {
            Some(k) => z[k + 1..].to_string(),
            None => z.clone(),
        };
        parts.push(f"{city} {format_en(mut ctx, ls, "HH:mm")}-{format_en(mut ctx, le, "HH:mm")}{day}{mark}");
    }
    Ok(f"  {format_en(mut ctx, s, "YYYY-MM-DD HH:mm ZZ")}  {parts.join(" | ")}")
}

fn run_meetings(ctx: mut ref Ctx) {
    let now = match arrow_get(mut ctx, one_str("2024-03-01T12:00:00+00:00".to_string()), Vec.new()) {
        Ok(n) => n,
        Err(_) => return,
    };
    for line in data_lines("meetings.txt").iter() {
        let f = fields_bar(line);
        let title = f[0].clone();
        let zone = f[1].clone();
        let mut args: Vec[PyVal] = Vec.new();
        args.push(PyVal.Str(f[2].clone()));
        args.push(PyVal.Str("YYYY-MM-DD HH:mm".to_string()));
        let start = match arrow_get(mut ctx, args, tz_kw(zone)) {
            Ok(s) => s,
            Err(e) => {
                println(f"{title}: {err_line(e)}");
                continue;
            }
        };
        let minutes = int_of(cps_of(f[3]));
        let mut notes = String.new();
        if imaginary(start) {
            notes.push_str("; does not exist on the organizer's clock");
        }
        if datetime_ambiguous(start) {
            notes.push_str("; happens twice on the organizer's clock");
        }
        let when = format_en(mut ctx, start, "dddd D MMMM YYYY HH:mm ZZZ");
        let rel = match humanize(mut ctx, start, Other.Arw(now.clone()), "en-us".to_string(), false, Gran.Auto) {
            Ok(s) => s,
            Err(e) => err_line(e),
        };
        println(f"{title}, {when}, {rel} ({utc_iso(mut ctx, start)}){notes}");
        let starts = if f[4] == "once" {
            let mut v: Vec[DateTime] = Vec.new();
            v.push(start.clone());
            v
        } else {
            arrow_range(mut ctx, "week".to_string(), start, None, None, Some(4)).0
        };
        let mut zones: Vec[String] = Vec.new();
        for z in f[5].split(",") {
            zones.push(to_string(strip(cps_of(z.to_string()))));
        }
        for s in starts.iter() {
            match meeting_line(mut ctx, s, minutes, zones) {
                Ok(l) => println(l),
                Err(e) => println(err_line(e)),
            }
        }
    }
}

fn whole_seconds(us: i64) -> i64 {
    floor_div(us, 1000000)
}

fn run_billing(ctx: mut ref Ctx) {
    for line in data_lines("subscriptions.txt").iter() {
        let f = fields_bar(line);
        let sid = f[0].clone();
        let plan = int_of(cps_of(f[1]));
        let zone = f[4].clone();
        let open = f[3] == "-";
        let s = match arrow_get(mut ctx, one_str(f[2]), tz_kw(zone)) {
            Ok(s) => s,
            Err(e) => {
                println(f"{sid}: {err_line(e)}");
                continue;
            }
        };
        let e = if open {
            shift_one(s, "months".to_string(), 4)
        } else {
            arrow_get(mut ctx, one_str(f[3]), tz_kw(zone))
        };
        let e = match e {
            Ok(e) => e,
            Err(err) => {
                println(f"{sid}: {err_line(err)}");
                continue;
            }
        };
        let tail = if open { " (open, four months shown)" } else { "" };
        println(f"{sid} {zone}, {format_en(mut ctx, s, "MMM D, YYYY HH:mm")} to {format_en(mut ctx, e, "MMM D, YYYY HH:mm")}{tail}");
        let mut total = 0;
        let (months, _) = span_range(mut ctx, "month".to_string(), s, e, Some(TzArg.Name(zone.clone())), None, "[)".to_string(), false);
        for (lo, hi) in months.iter() {
            let a = if dt_lt(lo, s) { s.clone() } else { lo.clone() };
            let b = if dt_lt(e, hi) { e.clone() } else { hi.clone() };
            let us = whole_seconds(sub_us(b, a));
            let fs = whole_seconds(sub_us(hi, lo));
            let cents = floor_div(plan * us, fs);
            total += cents;
            println(f"  {format_en(mut ctx, lo, "YYYY-MM")}  {rjust(f"{us}", 8)} of {rjust(f"{fs}", 8)} s  {rjust(money(cents), 6)}");
        }
        println(f"  total {money(total)}");
        let (renewals, _) = arrow_range(mut ctx, "month".to_string(), s, None, None, Some(5));
        let mut r: Vec[String] = Vec.new();
        for x in renewals.iter() {
            r.push(format_en(mut ctx, x, "ddd MMM D"));
        }
        println(f"  renewals: {r.join(", ")}");
    }
}

fn feed_group(ctx: mut ref Ctx, t: ref DateTime, now: ref DateTime, zone: ref String) -> Result[String, PyErr] {
    let local_now = arrow_to(mut ctx, now, zone)?;
    if dt_lt(local_now, t) {
        return Ok("upcoming".to_string());
    }
    let closed = "[]".to_string();
    let (a, b) = span_plain(local_now, "day".to_string())?;
    if is_between(t, a, b, closed)? {
        return Ok("today".to_string());
    }
    let yesterday = shift_one(local_now, "days".to_string(), -1)?;
    let (a, b) = span_plain(yesterday, "day".to_string())?;
    if is_between(t, a, b, closed)? {
        return Ok("yesterday".to_string());
    }
    let (a, b) = span_plain(local_now, "week".to_string())?;
    if is_between(t, a, b, closed)? {
        return Ok("this week".to_string());
    }
    Ok("earlier".to_string())
}

fn run_feed(ctx: mut ref Ctx) {
    let now = match arrow_get(mut ctx, one_str("2024-05-15T12:00:00+00:00".to_string()), Vec.new()) {
        Ok(n) => n,
        Err(_) => return,
    };
    let order = ["upcoming", "today", "yesterday", "this week", "earlier"];
    let mut counts = [0, 0, 0, 0, 0];
    for line in data_lines("feed.txt").iter() {
        let f = fields_bar(line);
        let user = f[0].clone();
        let loc = f[1].clone();
        let zone = f[2].clone();
        let step = match arrow_get(mut ctx, one_str(f[3]), Vec.new()) {
            Ok(x) => arrow_to(mut ctx, x, zone),
            Err(e) => Err(e),
        };
        let t = match step {
            Ok(t) => t,
            Err(e) => {
                println(f"{user}: {err_line(e)}");
                continue;
            }
        };
        let ago = match humanize(mut ctx, t, Other.Arw(now.clone()), loc, false, Gran.Auto) {
            Ok(s) => s,
            Err(e) => {
                println(f"{user}: {err_line(e)}");
                continue;
            }
        };
        let group = match feed_group(mut ctx, t, now, zone) {
            Ok(g) => g,
            Err(e) => err_line(e),
        };
        let mut k = 0;
        while k < 5 {
            if group == order[k] {
                counts[k] += 1;
            }
            k += 1;
        }
        let rt = match dehumanize(mut ctx, now, ago, loc) {
            Ok(back) => f"back to {format_en(mut ctx, back, "YYYY-MM-DD HH:mm")}",
            Err(e) => err_line(e),
        };
        let shown = match format_with(mut ctx, t, "ddd D MMM HH:mm".to_string(), loc) {
            Ok(s) => s,
            Err(e) => err_line(e),
        };
        println(f"{user} [{group}] {f[4]}, {ago}, {shown}; {rt}");
    }
    let mut parts: Vec[String] = Vec.new();
    let mut k = 0;
    while k < 5 {
        if counts[k] > 0 {
            parts.push(f"{order[k]} {counts[k]}");
        }
        k += 1;
    }
    println(f"groups: {parts.join(", ")}");
}
// ------------------------------------------------------------ main

fn hex_val(c: char) -> i64 {
    let n = c as i64;
    if n >= 48 and n <= 57 {
        return n - 48;
    }
    if n >= 97 and n <= 102 {
        return n - 87;
    }
    -1
}

// The hex of a file, with each run of eight or more zero bytes written
// as z<count>.
fn unrle(s: Str) -> Vec[u8] {
    let cs: Vec[char] = s.chars().collect();
    let n = cs.len();
    let mut out: Vec[u8] = Vec.new();
    let mut k = 0;
    while k < n {
        if cs[k] == 'z' {
            let mut j = k + 1;
            let mut count = 0;
            while cs[j] != '.' {
                count = count * 10 + (cs[j] as i64 - 48);
                j += 1;
            }
            for _ in 0..count {
                out.push(0);
            }
            k = j + 1;
        } else {
            out.push((hex_val(cs[k]) * 16 + hex_val(cs[k + 1])) as u8);
            k += 2;
        }
    }
    out
}

// The data files, from inputs_text(), written under data/ the way
// mk.py writes them, so the program reads only what it wrote.
fn write_inputs() -> Result[(), String] {
    if fs.exists("data") {
        if fs.remove_dir_all("data").is_err() {
            return Err("cannot remove data".to_string());
        }
    }
    for line in inputs_text().split("\n") {
        if line.len() == 0 {
            continue;
        }
        let (name, body) = match line.find(" ") {
            Some(k) => (line[..k].to_string(), line[k + 1..].to_string()),
            None => (line.to_string(), String.new()),
        };
        if let Some(k) = name.rfind("/") {
            if let Err(e) = fs.create_dir_all(name[..k].to_string()) {
                return Err(f"cannot create the directory of {name}: {e}");
            }
        }
        if let Err(e) = fs.write_bytes(name.clone(), unrle(body)) {
            return Err(f"cannot write {name}: {e}");
        }
    }
    Ok(())
}

fn new_ctx() -> Ctx {
    let text = fs.read_to_string("data/locales.txt").unwrap_or(String.new());
    let locales = load_locales(text);
    let mut by_name: Map[String, i64] = Map.new();
    let mut i = 0;
    while i < locales.len() {
        for n in locales[i].names.iter() {
            by_name.insert(normalize_locale(n), i);
        }
        i += 1;
    }
    Ctx { rx: new_rx(), locales: locales, by_name: by_name, pats: Vec.new(), pat_index: Map.new() }
}

fn main() {
    if let Err(e) = write_inputs() {
        eprintln(e);
        return;
    }
    let mut ctx = new_ctx();
    let text = fs.read_to_string("data/jobs.jsonl").unwrap_or(String.new());
    let mut n = 0;
    for line in text.split("\n") {
        if line.len() == 0 {
            continue;
        }
        n += 1;
        let job = match json_line(line.to_string()) {
            Ok(j) => j,
            Err(e) => {
                eprintln(e);
                return;
            }
        };
        println(f"== {n} {j_str(job, "n")}");
        let kind = j_str(job, "kind");
        if kind == "ops" {
            run_ops(mut ctx, job);
        } else if kind == "logs" {
            run_logs(mut ctx);
        } else if kind == "meetings" {
            run_meetings(mut ctx);
        } else if kind == "billing" {
            run_billing(mut ctx);
        } else if kind == "feed" {
            run_feed(mut ctx);
        }
    }
    let _ = fs.remove_dir_all("data");
}

// Generated by gen_kara.py from data/.

fn inputs_text() -> String {
    let mut s = String.new();
    s.push_str("data/app.log \n");
    s.push_str("data/feed.txt \n");
    s.push_str("data/formats.txt \ndata/jobs.jsonl \n");
    s.push_str("data/locales.txt \n");
    s.push_str("data/meetings.txt \ndata/subscriptions.txt \n");
    s.push_str("data/zones/America/Los_Angeles 545a696632z18..\n");
    s.push_str("data/zones/America/New_York 545a696632z18..\n");
    s.push_str("data/zones/America/Sao_Paulo 545a696632z30..\n");
    s.push_str("data/zones/Asia/Kolkata 545a696632z30.06000000040000001280000000879dbcbacadb8c28cc057118cc9532a8d2741298010203020302000052d8000000004b46000400004d58000800005b68010c4c4d54004d4d5400495354002b3036333000545a696632z30.070000000500000016ffffffff26ba1828ffffffff43e7eb30ffffffff879dbcbaffffffffcadb8c28ffffffffcc057118ffffffffcc9532a8ffffffffd274129801020304030403000052d80000000052d0000400004b46000800004d58000c00005b6801104c4d5400484d54004d4d5400495354002b30363330000a4953542d353a33300a\ndata/zones/Asia/Tokyo 545a696632z18.04000000040000000000000009000000040000000c80000000d73e0270d7ed59f0d8f8fa70d9cd3bf0db0700f0dbad1df0dce6e2f0dd8cfff003010201020102010200008303000000008ca0010400007e90000800007e9000084c4d54004a4454004a5354000000000100000001545a696632z18.\ndata/zones/Australia/Sydney 545a696632z22..\n");
    s.push_str("data/zones/Europe/Berlin 545a696632z18..\n");
    s.push_str("data/zones/Europe/London 545a696632z18..\n");
    s
}
