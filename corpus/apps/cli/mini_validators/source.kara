// Characters whose NFKC form holds one of / ? # @ :, which urlsplit refuses in a netloc.
fn nfkc_netloc_ranges() -> Vec[(i64, i64)] {
    let mut v: Vec[(i64, i64)] = Vec.new();
    nfkc_netloc_ranges_0(mut v);
    v
}

fn nfkc_netloc_ranges_0(v: mut ref Vec[(i64, i64)]) {
    v.push((0x2047, 0x2049)); v.push((0x2100, 0x2101)); v.push((0x2105, 0x2106)); v.push((0x2A74, 0x2A74)); v.push((0xFE13, 0xFE13)); v.push((0xFE16, 0xFE16));
    v.push((0xFE55, 0xFE56)); v.push((0xFE5F, 0xFE5F)); v.push((0xFE6B, 0xFE6B)); v.push((0xFF03, 0xFF03)); v.push((0xFF0F, 0xFF0F)); v.push((0xFF1A, 0xFF1A));
    v.push((0xFF1F, 0xFF20));
}

