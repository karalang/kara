// mini_validators: python-validators 0.36.0, the library web services use
// to check what users type into forms and APIs: email addresses, domains
// and host names, IPv4 and IPv6 addresses and networks, URLs and URIs, MAC
// addresses, UUIDs, slugs, hashes and encodings, card numbers and their
// brands, IBANs, CUSIP, ISIN and SEDOL codes, Bitcoin, Tron and BSC
// addresses, ranges and lengths, cron expressions, country, calling and
// currency codes, and national ids for Spain, Finland, France, India and
// Russia. Each returns True or a ValidationError carrying its arguments,
// and the reason when a ValueError, TypeError or UnicodeError stopped it.
//
// Underneath are the parts of Python they lean on: the re module (the
// regular-expression engine of mini_re, with IGNORECASE and VERBOSE),
// urllib.parse's urlsplit, parse_qs and unquote, ipaddress's address and
// network parsing, int() over every kind of decimal digit, str.isdigit,
// isdecimal and isalpha, the idna codec's ASCII path, uuid.UUID, SHA-256
// and Python's comparison rules and their TypeErrors.
//
// On top are two reports: a signup form whose fields are checked one by
// one, and a webhook registry that refuses callback URLs pointing at
// private, loopback or multicast addresses. expected.out is the output of
// oracle.py, which runs the same jobs through validators itself.

// ------------------------------------------------------------ errors

struct ReErr {
    kind: String,
    msg: String,
    pos: i64,
}

fn re_error(msg: own String, pos: i64) -> ReErr {
    ReErr { kind: "error".to_string(), msg: msg, pos: pos }
}

fn other_error(kind: Str, msg: own String) -> ReErr {
    ReErr { kind: kind.to_string(), msg: msg, pos: -1 }
}

fn err_text(e: ref ReErr) -> String {
    if e.kind == "error" {
        if e.pos >= 0 {
            return f"error: {e.msg} at position {e.pos}";
        }
        return f"error: {e.msg}";
    }
    f"{e.kind}: {e.msg}"
}

// -------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for cp in s {
        if cp < 0x80 {
            out.push(cp as u8);
        } else if cp < 0x800 {
            out.push((0xC0 | (cp >> 6)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else if cp < 0x10000 {
            out.push((0xE0 | (cp >> 12)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (cp >> 18)) as u8);
            out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

fn str_repr(s: ref Vec[i64], out: mut ref Vec[i64]) {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
}

fn repr_of(s: ref Vec[i64]) -> String {
    let mut out: Vec[i64] = Vec.new();
    str_repr(s, mut out);
    to_string(out)
}

// ----------------------------------------------------- character kinds

fn is_decimal(c: i64) -> bool {
    if c < 0x80 {
        return c >= 48 and c <= 57;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return true;
        }
    }
    false
}

fn is_space(c: i64, ascii: bool) -> bool {
    if c == 32 or (c >= 9 and c <= 13) {
        return true;
    }
    if ascii {
        return false;
    }
    (c >= 0x1C and c <= 0x1F) or c == 0x85 or c == 0xA0 or c == 0x1680 or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F or c == 0x3000
}

fn as_char(c: i64) -> Option[char] {
    if c < 0 or (c >= 0xD800 and c <= 0xDFFF) or c > 0x10FFFF {
        return None;
    }
    char.try_from(c as u32).ok()
}

fn is_word(c: i64, ascii: bool) -> bool {
    if c < 0x80 {
        return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
    }
    if ascii {
        return false;
    }
    match as_char(c) {
        Some(ch) => ch.is_alphanumeric(),
        None => false,
    }
}

fn lower(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 65 and c <= 90 { c + 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_lowercase() as u32 as i64,
        None => c,
    }
}

fn upper(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 97 and c <= 122 { c - 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_uppercase() as u32 as i64,
        None => c,
    }
}

// ------------------------------------------------------- parsed form

// The categories of \d \D \s \S \w \W.
fn cat_digit() -> i64 { 0 }
fn cat_not_digit() -> i64 { 1 }
fn cat_space() -> i64 { 2 }
fn cat_not_space() -> i64 { 3 }
fn cat_word() -> i64 { 4 }
fn cat_not_word() -> i64 { 5 }

// The positions ^ $ \A \Z \b \B and the forms the compiler turns them
// into under MULTILINE.
fn at_beginning() -> i64 { 0 }
fn at_beginning_line() -> i64 { 1 }
fn at_beginning_string() -> i64 { 2 }
fn at_end() -> i64 { 3 }
fn at_end_line() -> i64 { 4 }
fn at_end_string() -> i64 { 5 }
fn at_boundary() -> i64 { 6 }
fn at_non_boundary() -> i64 { 7 }

#[derive(Clone)]
enum Item {
    Lit(i64),
    Range(i64, i64),
    Cat(i64),
}

enum Node {
    Lit(i64),
    NotLit(i64),
    Any,
    In(Vec[Item], bool),
    At(i64),
    Branch(Vec[Vec[Node]]),
    // group (0: none), flags turned on, flags turned off, contents
    Group(i64, i64, i64, Vec[Node]),
    // 0 greedy, 1 lazy, 2 possessive; min; max; the item repeated
    Repeat(i64, i64, i64, Vec[Node]),
    Atomic(Vec[Node]),
    // direction (1 ahead, -1 behind), negative, contents
    Assert(i64, bool, Vec[Node]),
    GroupRef(i64),
    // group, yes branch, no branch
    Exists(i64, Vec[Node], Vec[Node]),
    Failure,
}

fn is_repeat(n: ref Node) -> bool {
    match n {
        Node.Repeat(_, _, _, _) => true,
        _ => false,
    }
}

fn is_at(n: ref Node) -> bool {
    match n {
        Node.At(_) => true,
        _ => false,
    }
}

fn flag_i() -> i64 { 2 }
fn flag_l() -> i64 { 4 }
fn flag_m() -> i64 { 8 }
fn flag_s() -> i64 { 16 }
fn flag_u() -> i64 { 32 }
fn flag_x() -> i64 { 64 }
fn flag_a() -> i64 { 256 }
fn type_flags() -> i64 { 4 | 32 | 256 }
fn maxrepeat() -> i64 { 4294967295 }
fn maxgroups() -> i64 { 1073741823 }
fn maxwidth() -> i64 { 1 << 62 }

fn flag_value(c: i64) -> i64 {
    match c {
        105 => 2,
        76 => 4,
        109 => 8,
        115 => 16,
        120 => 64,
        97 => 256,
        117 => 32,
        _ => 0,
    }
}

// ------------------------------------------------------------ tokens

// One token: nothing at the end of the pattern (n 0), a character (n 1),
// or a backslash and the character after it (n 2).
#[derive(Copy, Clone)]
struct T {
    n: i64,
    a: i64,
    b: i64,
}

fn tok_none() -> T {
    T { n: 0, a: 0, b: 0 }
}

fn tok_is(t: T, c: i64) -> bool {
    t.n == 1 and t.a == c
}

fn tok_text(t: T) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    if t.n >= 1 {
        v.push(t.a);
    }
    if t.n == 2 {
        v.push(t.b);
    }
    v
}

fn is_ascii_letter(c: i64) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

fn is_hex(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

fn is_oct(c: i64) -> bool {
    c >= 48 and c <= 55
}

fn is_dec(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn digits_value(s: ref Vec[i64], start: i64, base: i64) -> i64 {
    let mut v = 0;
    let mut i = start;
    while i < s.len() {
        let c = s[i];
        let d = if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 };
        v = v * base + d;
        i += 1;
    }
    v
}

// str.isidentifier, near enough: a letter or underscore, then letters,
// digits and underscores.
fn is_identifier(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    let mut i = 0;
    while i < name.len() {
        let c = name[i];
        let ok = if c == 95 {
            true
        } else if i == 0 {
            match as_char(c) {
                Some(ch) => ch.is_alphabetic(),
                None => false,
            }
        } else {
            is_word(c, false)
        };
        if not ok {
            return false;
        }
        i += 1;
    }
    true
}

fn is_ascii_decimal(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    for c in name {
        if not is_dec(c) {
            return false;
        }
    }
    true
}

struct Tokenizer {
    s: Vec[i64],
    index: i64,
    next: T,
}

impl Tokenizer {
    fn advance(mut ref self) -> Result[(), ReErr] {
        let index = self.index;
        if index >= self.s.len() {
            self.next = tok_none();
            return Ok(());
        }
        let c = self.s[index];
        if c == 92 {
            if index + 1 >= self.s.len() {
                return Err(re_error("bad escape (end of pattern)".to_string(), self.s.len() - 1));
            }
            self.next = T { n: 2, a: 92, b: self.s[index + 1] };
            self.index = index + 2;
        } else {
            self.next = T { n: 1, a: c, b: 0 };
            self.index = index + 1;
        }
        Ok(())
    }

    fn get(mut ref self) -> Result[T, ReErr] {
        let t = self.next;
        self.advance()?;
        Ok(t)
    }

    fn take(mut ref self, c: i64) -> Result[bool, ReErr] {
        if tok_is(self.next, c) {
            self.advance()?;
            return Ok(true);
        }
        Ok(false)
    }

    fn tell(ref self) -> i64 {
        self.index - self.next.n
    }

    fn seek(mut ref self, index: i64) -> Result[(), ReErr] {
        self.index = index;
        self.advance()
    }

    fn error(ref self, msg: own String, offset: i64) -> ReErr {
        re_error(msg, self.tell() - offset)
    }

    // getwhile: up to n characters of a kind (0 octal, 1 decimal, 2 hex).
    fn getwhile(mut ref self, n: i64, kind: i64, out: mut ref Vec[i64]) -> Result[(), ReErr] {
        let mut k = 0;
        while k < n {
            let t = self.next;
            if t.n != 1 {
                break;
            }
            let ok = if kind == 0 { is_oct(t.a) } else if kind == 1 { is_dec(t.a) } else { is_hex(t.a) };
            if not ok {
                break;
            }
            out.push(t.a);
            self.advance()?;
            k += 1;
        }
        Ok(())
    }

    fn getuntil(mut ref self, terminator: i64, name: Str) -> Result[Vec[i64], ReErr] {
        let mut result: Vec[i64] = Vec.new();
        loop {
            let c = self.next;
            self.advance()?;
            if c.n == 0 {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 0));
                }
                let term = to_string(vec_of(terminator));
                return Err(self.error(f"missing {term}, unterminated name", result.len()));
            }
            if tok_is(c, terminator) {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 1));
                }
                break;
            }
            push_all(mut result, tok_text(c));
        }
        Ok(result)
    }

    fn checkgroupname(ref self, name: ref Vec[i64], offset: i64) -> Result[(), ReErr] {
        if not is_identifier(name) {
            return Err(self.error(f"bad character in group name {repr_of(name)}", name.len() + offset));
        }
        Ok(())
    }
}

fn vec_of(c: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(c);
    v
}

fn new_tokenizer(s: ref Vec[i64]) -> Result[Tokenizer, ReErr] {
    let mut t = Tokenizer { s: s.clone(), index: 0, next: tok_none() };
    t.advance()?;
    Ok(t)
}

// ------------------------------------------------------------ parser

#[derive(Clone)]
struct Width {
    lo: i64,
    hi: i64,
}

struct ParseState {
    flags: i64,
    names: Vec[(Vec[i64], i64)],
    // per group: whether it is closed, and its width
    closed: Vec[bool],
    widths: Vec[Width],
    lookbehind_groups: i64,
    // conditional references by number, in order: (group, position)
    refpos: Vec[(i64, i64)],
}

impl ParseState {
    fn groups(ref self) -> i64 {
        self.closed.len()
    }

    fn group_of(ref self, name: ref Vec[i64]) -> i64 {
        for (n, g) in self.names.iter() {
            if same(n, name) {
                return g;
            }
        }
        -1
    }

    fn checkgroup(ref self, gid: i64) -> bool {
        gid < self.groups() and self.closed[gid]
    }

    fn checklookbehindgroup(ref self, gid: i64, src: ref Tokenizer) -> Result[(), ReErr] {
        if self.lookbehind_groups >= 0 {
            if not self.checkgroup(gid) {
                return Err(src.error("cannot refer to an open group".to_string(), 0));
            }
            if gid >= self.lookbehind_groups {
                return Err(src.error("cannot refer to group defined in the same lookbehind subpattern".to_string(), 0));
            }
        }
        Ok(())
    }
}

fn add_width(a: i64, b: i64) -> i64 {
    if a >= maxwidth() - b { maxwidth() } else { a + b }
}

fn mul_width(a: i64, n: i64) -> i64 {
    if a == 0 or n == 0 {
        0
    } else if a >= maxwidth() / n {
        maxwidth()
    } else {
        a * n
    }
}

// SubPattern.getwidth.
fn width_of(widths: ref Vec[Width], p: ref Vec[Node]) -> Width {
    let mut lo = 0;
    let mut hi = 0;
    for n in p.iter() {
        match n {
            Node.Branch(items) => {
                let mut i = maxwidth();
                let mut j = 0;
                for item in items.iter() {
                    let w = width_of(widths, item);
                    if w.lo < i {
                        i = w.lo;
                    }
                    if w.hi > j {
                        j = w.hi;
                    }
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Atomic(body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Group(_, _, _, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Repeat(_, min, max, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, mul_width(w.lo, min));
                if max == maxrepeat() and w.hi > 0 {
                    hi = maxwidth();
                } else {
                    hi = add_width(hi, mul_width(w.hi, max));
                }
            }
            Node.GroupRef(g) => {
                let w = ref widths[g];
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Exists(_, yes, no) => {
                let wy = width_of(widths, yes);
                let mut i = wy.lo;
                let mut j = wy.hi;
                if no.len() > 0 {
                    let wn = width_of(widths, no);
                    if wn.lo < i {
                        i = wn.lo;
                    }
                    if wn.hi > j {
                        j = wn.hi;
                    }
                } else {
                    i = 0;
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Lit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.NotLit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.Any => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.In(_, _) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            _ => {}
        }
    }
    Width { lo: lo, hi: hi }
}

fn category_of(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        100 => 0,
        68 => 1,
        115 => 2,
        83 => 3,
        119 => 4,
        87 => 5,
        _ => -1,
    }
}

fn escape_value(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        97 => 7,
        98 => 8,
        102 => 12,
        110 => 10,
        114 => 13,
        116 => 9,
        118 => 11,
        92 => 92,
        _ => -1,
    }
}

// \x, \u and \U: the escape text so far, and the code point.
fn hex_escape(src: mut ref Tokenizer, t: T, esc: mut ref Vec[i64]) -> Result[i64, ReErr] {
    let n = if t.b == 120 { 2 } else if t.b == 117 { 4 } else { 8 };
    src.getwhile(n, 2, mut esc)?;
    if esc.len() != n + 2 {
        return Err(src.error(f"incomplete escape {to_string(esc)}", esc.len()));
    }
    let c = digits_value(esc, 2, 16);
    if c > 0x10FFFF {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(c)
}

// _class_escape: an escape inside [...], a literal or a category.
fn class_escape(src: mut ref Tokenizer, t: T) -> Result[Item, ReErr] {
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Item.Lit(e));
    }
    let cat = category_of(t);
    if cat >= 0 {
        return Ok(Item.Cat(cat));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Item.Lit(v));
    }
    if is_oct(c) {
        src.getwhile(2, 0, mut esc)?;
        let v = digits_value(esc, 1, 8);
        if v > 0o377 {
            return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
        }
        return Ok(Item.Lit(v));
    }
    if is_dec(c) or is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Item.Lit(c))
}

// _escape: an escape outside a set.
fn escape(src: mut ref Tokenizer, t: T, st: ref ParseState) -> Result[Node, ReErr] {
    let cat = category_of(t);
    if cat >= 0 {
        let mut items: Vec[Item] = Vec.new();
        items.push(Item.Cat(cat));
        return Ok(Node.In(items, false));
    }
    match t.b {
        65 => return Ok(Node.At(at_beginning_string())),
        98 => return Ok(Node.At(at_boundary())),
        66 => return Ok(Node.At(at_non_boundary())),
        90 => return Ok(Node.At(at_end_string())),
        _ => {}
    }
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Node.Lit(e));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Node.Lit(v));
    }
    if c == 48 {
        src.getwhile(2, 0, mut esc)?;
        return Ok(Node.Lit(digits_value(esc, 1, 8)));
    }
    if is_dec(c) {
        // an octal escape or a group reference
        let nt = src.next;
        if nt.n == 1 and is_dec(nt.a) {
            esc.push(nt.a);
            src.advance()?;
            let nt2 = src.next;
            if is_oct(esc[1]) and is_oct(esc[2]) and nt2.n == 1 and is_oct(nt2.a) {
                esc.push(nt2.a);
                src.advance()?;
                let v = digits_value(esc, 1, 8);
                if v > 0o377 {
                    return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
                }
                return Ok(Node.Lit(v));
            }
        }
        let group = digits_value(esc, 1, 10);
        if group < st.groups() {
            if not st.checkgroup(group) {
                return Err(src.error("cannot refer to an open group".to_string(), esc.len()));
            }
            st.checklookbehindgroup(group, src)?;
            return Ok(Node.GroupRef(group));
        }
        return Err(src.error(f"invalid group reference {group}", esc.len() - 1));
    }
    if is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Node.Lit(c))
}

fn parse_sub(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64) -> Result[Vec[Node], ReErr] {
    let mut items: Vec[Vec[Node]] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let first = nested == 0 and items.len() == 0;
        let item = parse_seq(mut src, mut st, verbose, nested + 1, first)?;
        items.push(item);
        if not src.take(124)? {
            break;
        }
        if nested == 0 {
            verbose = (st.flags & flag_x()) != 0;
        }
    }
    if items.len() == 1 {
        return Ok(items.pop().unwrap());
    }
    let mut out: Vec[Node] = Vec.new();
    out.push(Node.Branch(items));
    Ok(out)
}

// _parse_flags: None (as Err-free Ok(None)) for global flags, else the
// flags turned on and off.
fn parse_flags(src: mut ref Tokenizer, st: mut ref ParseState, first_char: T) -> Result[Option[(i64, i64)], ReErr] {
    let mut ch = first_char;
    let mut add = 0;
    let mut del = 0;
    if not tok_is(ch, 45) {
        loop {
            let flag = flag_value(ch.a);
            if ch.a == 76 {
                return Err(src.error("bad inline flags: cannot use 'L' flag with a str pattern".to_string(), 0));
            }
            add = add | flag;
            if (flag & type_flags()) != 0 and (add & type_flags()) != flag {
                return Err(src.error("bad inline flags: flags 'a', 'u' and 'L' are incompatible".to_string(), 0));
            }
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing -, : or )".to_string(), 0));
            }
            if tok_is(ch, 41) or tok_is(ch, 45) or tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing -, : or )" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if tok_is(ch, 41) {
        st.flags = st.flags | add;
        return Ok(None);
    }
    if tok_is(ch, 45) {
        ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("missing flag".to_string(), 0));
        }
        if ch.n != 1 or flag_value(ch.a) == 0 {
            let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing flag" };
            return Err(src.error(msg.to_string(), ch.n));
        }
        loop {
            let flag = flag_value(ch.a);
            if (flag & type_flags()) != 0 {
                return Err(src.error("bad inline flags: cannot turn off flags 'a', 'u' and 'L'".to_string(), 0));
            }
            del = del | flag;
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing :".to_string(), 0));
            }
            if tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing :" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if (add & del) != 0 {
        return Err(src.error("bad inline flags: flag turned on and off".to_string(), 1));
    }
    Ok(Some((add, del)))
}

fn is_alpha(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

fn parse_set(src: mut ref Tokenizer, out: mut ref Vec[Node]) -> Result[(), ReErr] {
    let here = src.tell() - 1;
    let mut set: Vec[Item] = Vec.new();
    let negate = src.take(94)?;
    loop {
        let this = src.get()?;
        if this.n == 0 {
            return Err(src.error("unterminated character set".to_string(), src.tell() - here));
        }
        if tok_is(this, 93) and set.len() > 0 {
            break;
        }
        let code1 = if this.n == 2 { class_escape(mut src, this)? } else { Item.Lit(this.a) };
        if src.take(45)? {
            let that = src.get()?;
            if that.n == 0 {
                return Err(src.error("unterminated character set".to_string(), src.tell() - here));
            }
            if tok_is(that, 93) {
                set.push(code1);
                set.push(Item.Lit(45));
                break;
            }
            let code2 = if that.n == 2 { class_escape(mut src, that)? } else { Item.Lit(that.a) };
            let text = f"{to_string(tok_text(this))}-{to_string(tok_text(that))}";
            let offset = this.n + 1 + that.n;
            let lo = match code1 {
                Item.Lit(c) => c,
                _ => -1,
            };
            let hi = match code2 {
                Item.Lit(c) => c,
                _ => -1,
            };
            if lo < 0 or hi < 0 or hi < lo {
                return Err(src.error(f"bad character range {text}", offset));
            }
            set.push(Item.Range(lo, hi));
        } else {
            set.push(code1);
        }
    }
    if set.len() == 1 {
        let only = ref set[0];
        if let Item.Lit(c) = only {
            if negate {
                out.push(Node.NotLit(c));
            } else {
                out.push(Node.Lit(c));
            }
            return Ok(());
        }
    }
    out.push(Node.In(set, negate));
    Ok(())
}

// The quantifier just read (its first character is `this`), applied to
// the last item. Returns false when `{` turned out to be a literal.
fn parse_repeat(src: mut ref Tokenizer, this: T, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let here = src.tell();
    let mut min = 0;
    let mut max = maxrepeat();
    if tok_is(this, 63) {
        max = 1;
    } else if tok_is(this, 43) {
        min = 1;
    } else if tok_is(this, 123) {
        if tok_is(src.next, 125) {
            out.push(Node.Lit(123));
            return Ok(false);
        }
        let mut lo: Vec[i64] = Vec.new();
        let mut hi: Vec[i64] = Vec.new();
        while src.next.n == 1 and is_dec(src.next.a) {
            lo.push(src.get()?.a);
        }
        if src.take(44)? {
            while src.next.n == 1 and is_dec(src.next.a) {
                hi.push(src.get()?.a);
            }
        } else {
            hi = lo.clone();
        }
        if not src.take(125)? {
            out.push(Node.Lit(123));
            src.seek(here)?;
            return Ok(false);
        }
        if lo.len() > 0 {
            if lo.len() > 10 or digits_value(lo, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            min = digits_value(lo, 0, 10);
        }
        if hi.len() > 0 {
            if hi.len() > 10 or digits_value(hi, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            max = digits_value(hi, 0, 10);
            if max < min {
                return Err(src.error("min repeat greater than max repeat".to_string(), src.tell() - here));
            }
        }
    }
    if out.len() == 0 or is_at(out[out.len() - 1]) {
        return Err(src.error("nothing to repeat".to_string(), src.tell() - here + 1));
    }
    if is_repeat(out[out.len() - 1]) {
        return Err(src.error("multiple repeat".to_string(), src.tell() - here + 1));
    }
    let last = out.pop().unwrap();
    let mut body: Vec[Node] = Vec.new();
    match last {
        Node.Group(0, 0, 0, p) => body = p,
        other => body.push(other),
    }
    let kind = if src.take(63)? { 1 } else if src.take(43)? { 2 } else { 0 };
    out.push(Node.Repeat(kind, min, max, body));
    Ok(true)
}

fn parse_seq(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64, first: bool) -> Result[Vec[Node], ReErr] {
    let mut out: Vec[Node] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let this = src.next;
        if this.n == 0 or tok_is(this, 124) or tok_is(this, 41) {
            break;
        }
        src.advance()?;
        if verbose {
            if this.n == 1 and (this.a == 32 or (this.a >= 9 and this.a <= 13)) {
                continue;
            }
            if tok_is(this, 35) {
                loop {
                    let t = src.get()?;
                    if t.n == 0 or tok_is(t, 10) {
                        break;
                    }
                }
                continue;
            }
        }
        if this.n == 2 {
            let node = escape(mut src, this, st)?;
            out.push(node);
            continue;
        }
        let c = this.a;
        if c == 91 {
            parse_set(mut src, mut out)?;
        } else if c == 42 or c == 43 or c == 63 or c == 123 {
            parse_repeat(mut src, this, mut out)?;
        } else if c == 46 {
            out.push(Node.Any);
        } else if c == 94 {
            out.push(Node.At(at_beginning()));
        } else if c == 36 {
            out.push(Node.At(at_end()));
        } else if c == 40 {
            if parse_group(mut src, mut st, mut verbose, nested, first, mut out)? {
                continue;
            }
        } else {
            out.push(Node.Lit(c));
        }
    }
    Ok(out)
}

// `(` and what follows. Returns true for a construct that adds nothing
// (a comment, global flags).
fn parse_group(src: mut ref Tokenizer, st: mut ref ParseState, verbose: mut ref bool, nested: i64, first: bool, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let start = src.tell() - 1;
    let mut capture = true;
    let mut atomic = false;
    let mut name: Vec[i64] = Vec.new();
    let mut named = false;
    let mut add = 0;
    let mut del = 0;
    if src.take(63)? {
        let ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("unexpected end of pattern".to_string(), 0));
        }
        if tok_is(ch, 80) {
            if src.take(60)? {
                name = src.getuntil(62, "group name")?;
                src.checkgroupname(name, 1)?;
                named = true;
            } else if src.take(61)? {
                let ref_name = src.getuntil(41, "group name")?;
                src.checkgroupname(ref_name, 1)?;
                let gid = st.group_of(ref_name);
                if gid < 0 {
                    return Err(src.error(f"unknown group name {repr_of(ref_name)}", ref_name.len() + 1));
                }
                if not st.checkgroup(gid) {
                    return Err(src.error("cannot refer to an open group".to_string(), ref_name.len() + 1));
                }
                st.checklookbehindgroup(gid, src)?;
                out.push(Node.GroupRef(gid));
                return Ok(true);
            } else {
                let c2 = src.get()?;
                if c2.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                return Err(src.error(f"unknown extension ?P{to_string(tok_text(c2))}", c2.n + 2));
            }
        } else if tok_is(ch, 58) {
            capture = false;
        } else if tok_is(ch, 35) {
            loop {
                if src.next.n == 0 {
                    return Err(src.error("missing ), unterminated comment".to_string(), src.tell() - start));
                }
                if tok_is(src.get()?, 41) {
                    break;
                }
            }
            return Ok(true);
        } else if tok_is(ch, 61) or tok_is(ch, 33) or tok_is(ch, 60) {
            let mut kind = ch;
            let mut dir = 1;
            let mut outer_lookbehind = 0;
            if tok_is(ch, 60) {
                kind = src.get()?;
                if kind.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                if not (tok_is(kind, 61) or tok_is(kind, 33)) {
                    return Err(src.error(f"unknown extension ?<{to_string(tok_text(kind))}", kind.n + 2));
                }
                dir = -1;
                outer_lookbehind = st.lookbehind_groups;
                if outer_lookbehind < 0 {
                    st.lookbehind_groups = st.groups();
                }
            }
            let p = parse_sub(mut src, mut st, *verbose, nested + 1)?;
            if dir < 0 and outer_lookbehind < 0 {
                st.lookbehind_groups = -1;
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            if tok_is(kind, 61) {
                out.push(Node.Assert(dir, false, p));
            } else if p.len() > 0 {
                out.push(Node.Assert(dir, true, p));
            } else {
                out.push(Node.Failure);
            }
            return Ok(true);
        } else if tok_is(ch, 40) {
            let condname = src.getuntil(41, "group name")?;
            let mut condgroup = 0;
            if not is_ascii_decimal(condname) {
                src.checkgroupname(condname, 1)?;
                condgroup = st.group_of(condname);
                if condgroup < 0 {
                    return Err(src.error(f"unknown group name {repr_of(condname)}", condname.len() + 1));
                }
            } else {
                if condname.len() > 10 {
                    return Err(src.error(f"invalid group reference {to_string(condname)}", condname.len() + 1));
                }
                condgroup = digits_value(condname, 0, 10);
                if condgroup == 0 {
                    return Err(src.error("bad group number".to_string(), condname.len() + 1));
                }
                if condgroup >= maxgroups() {
                    return Err(src.error(f"invalid group reference {condgroup}", condname.len() + 1));
                }
                let mut seen = false;
                for (g, _) in st.refpos.iter() {
                    if g == condgroup {
                        seen = true;
                    }
                }
                if not seen {
                    st.refpos.push((condgroup, src.tell() - condname.len() - 1));
                }
            }
            st.checklookbehindgroup(condgroup, src)?;
            let yes = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
            let mut no: Vec[Node] = Vec.new();
            if src.take(124)? {
                no = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
                if tok_is(src.next, 124) {
                    return Err(src.error("conditional backref with more than two branches".to_string(), 0));
                }
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            out.push(Node.Exists(condgroup, yes, no));
            return Ok(true);
        } else if tok_is(ch, 62) {
            capture = false;
            atomic = true;
        } else if (ch.n == 1 and flag_value(ch.a) != 0) or tok_is(ch, 45) {
            match parse_flags(mut src, mut st, ch)? {
                None => {
                    if not first or out.len() > 0 {
                        return Err(src.error("global flags not at the start of the expression".to_string(), src.tell() - start));
                    }
                    *verbose = (st.flags & flag_x()) != 0;
                    return Ok(true);
                }
                Some((a, d)) => {
                    add = a;
                    del = d;
                    capture = false;
                }
            }
        } else {
            return Err(src.error(f"unknown extension ?{to_string(tok_text(ch))}", ch.n + 1));
        }
    }
    let mut group = 0;
    if capture {
        group = st.groups();
        st.closed.push(false);
        st.widths.push(Width { lo: 0, hi: 0 });
        if named {
            let was = st.group_of(name);
            if was >= 0 {
                return Err(src.error(f"redefinition of group name {repr_of(name)} as group {group}; was group {was}", name.len() + 1));
            }
            st.names.push((name.clone(), group));
        }
    }
    let sub_verbose = (*verbose or (add & flag_x()) != 0) and (del & flag_x()) == 0;
    let p = parse_sub(mut src, mut st, sub_verbose, nested + 1)?;
    if not src.take(41)? {
        return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
    }
    if group > 0 {
        let w = width_of(st.widths, p);
        st.widths[group] = w;
        st.closed[group] = true;
    }
    if atomic {
        out.push(Node.Atomic(p));
    } else {
        out.push(Node.Group(group, add, del, p));
    }
    Ok(false)
}

struct Parsed {
    nodes: Vec[Node],
    flags: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
    widths: Vec[Width],
}

fn parse(pattern: ref Vec[i64], flags: i64) -> Result[Parsed, ReErr] {
    let mut src = new_tokenizer(pattern)?;
    let mut st = ParseState {
        flags: flags,
        names: Vec.new(),
        closed: Vec.new(),
        widths: Vec.new(),
        lookbehind_groups: -1,
        refpos: Vec.new(),
    };
    // group 0 is the whole match
    st.closed.push(true);
    st.widths.push(Width { lo: 0, hi: 0 });
    let nodes = parse_sub(mut src, mut st, (flags & flag_x()) != 0, 0)?;
    if (st.flags & flag_a()) != 0 and (st.flags & flag_u()) != 0 {
        return Err(other_error("ValueError", "ASCII and UNICODE flags are incompatible".to_string()));
    }
    if src.next.n != 0 {
        return Err(src.error("unbalanced parenthesis".to_string(), 0));
    }
    for (g, pos) in st.refpos.iter() {
        if g >= st.groups() {
            return Err(re_error(f"invalid group reference {g}", pos));
        }
    }
    let groups = st.groups() - 1;
    Ok(Parsed { nodes: nodes, flags: st.flags, groups: groups, names: st.names, widths: st.widths })
}

// ---------------------------------------------------------- compiler

enum Op {
    // character (lowered when case-insensitive), case-insensitive, ASCII
    Lit(i64, bool, bool),
    NotLit(i64, bool, bool),
    Any,
    AnyAll,
    // set, case-insensitive, ASCII-only categories
    In(i64, bool, bool),
    // anchor kind, ASCII-only word boundary
    At(i64, bool),
    Mark(i64),
    Split(i64, i64),
    Jmp(i64),
    // repeat register, the Until it starts at
    RepInit(i64, i64),
    // register, min, max, greedy, body, exit
    Until(i64, i64, i64, bool, i64, i64),
    Ref(i64, bool, bool),
    // lookbehind width (-1 for lookahead), negative, sub-program, next
    Look(i64, bool, i64, i64),
    Atomic(i64, i64),
    Exists(i64, i64),
    Fail,
    Succeed,
    Match,
}

struct Program {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
}

struct CharSet {
    items: Vec[Item],
    negate: bool,
}

fn combine(flags: i64, add: i64, del: i64) -> i64 {
    let mut f = flags;
    if (add & type_flags()) != 0 {
        f = f & (0x7FFFFFFF ^ type_flags());
    }
    (f | add) & (0x7FFFFFFF ^ del)
}

struct Compiler {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
}

impl Compiler {
    fn emit(mut ref self, op: own Op) -> i64 {
        self.ops.push(op);
        self.ops.len() - 1
    }

    fn here(ref self) -> i64 {
        self.ops.len()
    }

    fn compile(mut ref self, p: ref Parsed, nodes: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let icase = (flags & flag_i()) != 0;
        let ascii = (flags & flag_a()) != 0;
        for n in nodes.iter() {
            match n {
                Node.Lit(c) => {
                    let v = if icase { lower(c, ascii) } else { c };
                    self.emit(Op.Lit(v, icase, ascii));
                }
                Node.NotLit(c) => {
                    let v = if icase { lower(c, ascii) } else { c };
                    self.emit(Op.NotLit(v, icase, ascii));
                }
                Node.Any => {
                    if (flags & flag_s()) != 0 {
                        self.emit(Op.AnyAll);
                    } else {
                        self.emit(Op.Any);
                    }
                }
                Node.In(items, negate) => {
                    self.sets.push(CharSet { items: items.clone(), negate: negate });
                    let idx = self.sets.len() - 1;
                    self.emit(Op.In(idx, icase, ascii));
                }
                Node.At(kind) => {
                    let mut k = kind;
                    if (flags & flag_m()) != 0 {
                        if k == at_beginning() {
                            k = at_beginning_line();
                        } else if k == at_end() {
                            k = at_end_line();
                        }
                    }
                    self.emit(Op.At(k, ascii));
                }
                Node.Branch(items) => {
                    let mut ends: Vec[i64] = Vec.new();
                    let mut i = 0;
                    while i < items.len() {
                        if i + 1 < items.len() {
                            let split = self.emit(Op.Fail);
                            self.compile(p, items[i], flags)?;
                            ends.push(self.emit(Op.Fail));
                            let next = self.here();
                            self.ops[split] = Op.Split(split + 1, next);
                        } else {
                            self.compile(p, items[i], flags)?;
                        }
                        i += 1;
                    }
                    let end = self.here();
                    for at in ends {
                        self.ops[at] = Op.Jmp(end);
                    }
                }
                Node.Group(g, add, off, body) => {
                    if g > 0 {
                        self.emit(Op.Mark(2 * g));
                    }
                    self.compile(p, body, combine(flags, add, off))?;
                    if g > 0 {
                        self.emit(Op.Mark(2 * g + 1));
                    }
                }
                Node.Repeat(kind, min, max, body) => {
                    if kind == 2 {
                        let at = self.emit(Op.Fail);
                        self.compile_repeat(p, min, max, true, body, flags)?;
                        self.emit(Op.Succeed);
                        let next = self.here();
                        self.ops[at] = Op.Atomic(at + 1, next);
                    } else {
                        self.compile_repeat(p, min, max, kind == 0, body, flags)?;
                    }
                }
                Node.Atomic(body) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Atomic(at + 1, next);
                }
                Node.Assert(dir, negative, body) => {
                    let mut width = -1;
                    if dir < 0 {
                        let w = width_of(p.widths, body);
                        if w.lo != w.hi {
                            return Err(other_error("error", "look-behind requires fixed-width pattern".to_string()));
                        }
                        width = w.lo;
                    }
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Look(width, negative, at + 1, next);
                }
                Node.GroupRef(g) => {
                    self.emit(Op.Ref(g, icase, ascii));
                }
                Node.Exists(g, yes, no) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, yes, flags)?;
                    if no.len() > 0 {
                        let jump = self.emit(Op.Fail);
                        let no_pc = self.here();
                        self.compile(p, no, flags)?;
                        let end = self.here();
                        self.ops[jump] = Op.Jmp(end);
                        self.ops[at] = Op.Exists(g, no_pc);
                    } else {
                        let end = self.here();
                        self.ops[at] = Op.Exists(g, end);
                    }
                }
                Node.Failure => {
                    self.emit(Op.Fail);
                }
            }
        }
        Ok(())
    }

    fn compile_repeat(mut ref self, p: ref Parsed, min: i64, max: i64, greedy: bool, body: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let r = self.repeats;
        self.repeats += 1;
        let init = self.emit(Op.Fail);
        self.compile(p, body, flags)?;
        let until = self.emit(Op.Fail);
        self.ops[init] = Op.RepInit(r, until);
        self.ops[until] = Op.Until(r, min, max, greedy, init + 1, until + 1);
        Ok(())
    }
}

fn compile(pattern: ref Vec[i64], flags: i64) -> Result[Program, ReErr] {
    let p = parse(pattern, flags)?;
    let mut c = Compiler { ops: Vec.new(), sets: Vec.new(), repeats: 0 };
    c.compile(p, p.nodes, p.flags)?;
    c.emit(Op.Match);
    Ok(Program { ops: c.ops, sets: c.sets, repeats: c.repeats, groups: p.groups, names: p.names })
}

// ----------------------------------------------------------- matcher

struct Undo {
    kind: i64,
    idx: i64,
    old: i64,
}

struct Choice {
    pc: i64,
    pos: i64,
    trail: i64,
    // 0: resume at pc; 1: a lazy repeat's Until, after its tail failed
    mode: i64,
}

struct Matcher {
    s: Vec[i64],
    marks: Vec[i64],
    counts: Vec[i64],
    lasts: Vec[i64],
    lastindex: i64,
    trail: Vec[Undo],
    start: i64,
    must_advance: bool,
    match_all: bool,
}

impl Matcher {
    fn set_mark(mut ref self, slot: i64, v: i64) {
        self.trail.push(Undo { kind: 0, idx: slot, old: self.marks[slot] });
        self.marks[slot] = v;
    }

    fn set_count(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 1, idx: r, old: self.counts[r] });
        self.counts[r] = v;
    }

    fn set_last(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 2, idx: r, old: self.lasts[r] });
        self.lasts[r] = v;
    }

    fn set_lastindex(mut ref self, v: i64) {
        self.trail.push(Undo { kind: 3, idx: 0, old: self.lastindex });
        self.lastindex = v;
    }

    fn undo_to(mut ref self, len: i64) {
        while self.trail.len() > len {
            let u = self.trail.pop().unwrap();
            if u.kind == 0 {
                self.marks[u.idx] = u.old;
            } else if u.kind == 1 {
                self.counts[u.idx] = u.old;
            } else if u.kind == 2 {
                self.lasts[u.idx] = u.old;
            } else {
                self.lastindex = u.old;
            }
        }
    }

    // A group that has both marks, the end not before the start.
    fn group_span(ref self, g: i64) -> (i64, i64) {
        let a = self.marks[2 * g];
        let b = self.marks[2 * g + 1];
        if a < 0 or b < 0 or b < a {
            return (-1, -1);
        }
        (a, b)
    }

    fn at(ref self, kind: i64, ascii: bool, pos: i64) -> bool {
        let n = self.s.len();
        if kind == 0 or kind == 2 {
            return pos == 0;
        }
        if kind == 1 {
            return pos == 0 or self.s[pos - 1] == 10;
        }
        if kind == 3 {
            return pos == n or (pos == n - 1 and self.s[pos] == 10);
        }
        if kind == 4 {
            return pos == n or self.s[pos] == 10;
        }
        if kind == 5 {
            return pos == n;
        }
        if n == 0 {
            return false;
        }
        let before = pos > 0 and is_word(self.s[pos - 1], ascii);
        let after = pos < n and is_word(self.s[pos], ascii);
        if kind == 6 { before != after } else { before == after }
    }

    // Runs the program from pc at pos, backtracking through its own
    // choices only. Returns where it succeeded, or -1.
    fn run(mut ref self, prog: ref Program, pc0: i64, pos0: i64, top: bool) -> i64 {
        let base = self.trail.len();
        let mut choices: Vec[Choice] = Vec.new();
        let mut pc = pc0;
        let mut pos = pos0;
        let mut mode = 0;
        loop {
            let mut ok = true;
            let op = ref prog.ops[pc];
            if mode == 1 {
                // a lazy repeat whose tail failed: try one more item
                mode = 0;
                ok = false;
                if let Op.Until(r, _, max, _, body, _) = op {
                    let count = self.counts[r] + 1;
                    if not ((count >= max and max != maxrepeat()) or pos == self.lasts[r]) {
                        self.set_count(r, count);
                        self.set_last(r, pos);
                        pc = body;
                        ok = true;
                    }
                }
                if ok {
                    continue;
                }
            } else {
                match op {
                    Op.Lit(c, icase, ascii) => {
                        if pos < self.s.len() and (if icase { lower(self.s[pos], ascii) == c } else { self.s[pos] == c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.NotLit(c, icase, ascii) => {
                        if pos < self.s.len() and (if icase { lower(self.s[pos], ascii) != c } else { self.s[pos] != c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Any => {
                        if pos < self.s.len() and self.s[pos] != 10 {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.AnyAll => {
                        if pos < self.s.len() {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.In(set, icase, ascii) => {
                        if pos < self.s.len() and in_set(prog.sets[set], self.s[pos], icase, ascii) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.At(kind, ascii) => {
                        if self.at(kind, ascii, pos) {
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Mark(slot) => {
                        self.set_mark(slot, pos);
                        if (slot & 1) == 1 {
                            self.set_lastindex(slot / 2);
                        }
                        pc += 1;
                    }
                    Op.Split(a, b) => {
                        choices.push(Choice { pc: b, pos: pos, trail: self.trail.len(), mode: 0 });
                        pc = a;
                    }
                    Op.Jmp(a) => pc = a,
                    Op.RepInit(r, until) => {
                        self.set_count(r, -1);
                        self.set_last(r, -1);
                        pc = until;
                    }
                    Op.Until(r, min, max, greedy, body, exit) => {
                        let count = self.counts[r] + 1;
                        if count < min {
                            self.set_count(r, count);
                            pc = body;
                        } else if greedy {
                            if (count < max or max == maxrepeat()) and pos != self.lasts[r] {
                                choices.push(Choice { pc: exit, pos: pos, trail: self.trail.len(), mode: 0 });
                                self.set_count(r, count);
                                self.set_last(r, pos);
                                pc = body;
                            } else {
                                pc = exit;
                            }
                        } else {
                            choices.push(Choice { pc: pc, pos: pos, trail: self.trail.len(), mode: 1 });
                            pc = exit;
                        }
                    }
                    Op.Ref(g, icase, ascii) => {
                        let (a, b) = self.group_span(g);
                        if a < 0 {
                            ok = false;
                        } else {
                            let len = b - a;
                            if pos + len > self.s.len() {
                                ok = false;
                            } else {
                                let mut k = 0;
                                while k < len {
                                    let x = self.s[a + k];
                                    let y = self.s[pos + k];
                                    let eq = if icase { lower(x, ascii) == lower(y, ascii) } else { x == y };
                                    if not eq {
                                        ok = false;
                                        break;
                                    }
                                    k += 1;
                                }
                                if ok {
                                    pos += len;
                                    pc += 1;
                                }
                            }
                        }
                    }
                    Op.Look(width, negative, sub, next) => {
                        let mark = self.trail.len();
                        let from = if width < 0 { pos } else { pos - width };
                        let found = from >= 0 and self.run(prog, sub, from, false) >= 0;
                        if negative {
                            self.undo_to(mark);
                            if found {
                                ok = false;
                            } else {
                                pc = next;
                            }
                        } else if found {
                            pc = next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Atomic(sub, next) => {
                        let end = self.run(prog, sub, pos, false);
                        if end >= 0 {
                            pos = end;
                            pc = next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Exists(g, no) => {
                        let (a, _) = self.group_span(g);
                        if a >= 0 {
                            pc += 1;
                        } else {
                            pc = no;
                        }
                    }
                    Op.Fail => ok = false,
                    Op.Succeed => return pos,
                    Op.Match => {
                        if top and ((self.match_all and pos != self.s.len()) or (self.must_advance and pos == self.start)) {
                            ok = false;
                        } else {
                            return pos;
                        }
                    }
                }
            }
            if not ok {
                match choices.pop() {
                    Some(ch) => {
                        self.undo_to(ch.trail);
                        pc = ch.pc;
                        pos = ch.pos;
                        mode = ch.mode;
                    }
                    None => {
                        self.undo_to(base);
                        return -1;
                    }
                }
            }
        }
    }
}

fn in_items(set: ref CharSet, c: i64, ascii: bool) -> bool {
    for item in set.items.iter() {
        let hit = match item {
            Item.Lit(l) => c == l,
            Item.Range(lo, hi) => c >= lo and c <= hi,
            Item.Cat(k) => {
                let kind = k;
                if kind == 0 {
                    if ascii { c >= 48 and c <= 57 } else { is_decimal(c) }
                } else if kind == 1 {
                    if ascii { not (c >= 48 and c <= 57) } else { not is_decimal(c) }
                } else if kind == 2 {
                    is_space(c, ascii)
                } else if kind == 3 {
                    not is_space(c, ascii)
                } else if kind == 4 {
                    is_word(c, ascii)
                } else {
                    not is_word(c, ascii)
                }
            }
        };
        if hit {
            return true;
        }
    }
    false
}

// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = lower(c, ascii);
        if lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program, s: ref Vec[i64]) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        s: s.clone(),
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn find(m: mut ref Matcher, prog: ref Program, from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= m.s.len() {
        let mut k = 0;
        while k < m.marks.len() {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}

// All the matches finditer gives: each search starts where the last
// match ended, and must move on past an empty one.
fn all_matches(prog: ref Program, s: ref Vec[i64], limit: i64) -> Vec[Found] {
    let mut m = new_matcher(prog, s);
    let mut out: Vec[Found] = Vec.new();
    let mut pos = 0;
    let mut must_advance = false;
    while pos <= s.len() and (limit == 0 or out.len() < limit) {
        match find(mut m, prog, pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    out
}

fn group_text(s: ref Vec[i64], span: (i64, i64), out: mut ref Vec[i64]) {
    let (a, b) = span;
    if a < 0 {
        push_ascii(mut out, "None");
    } else {
        str_repr(slice(s, a, b), mut out);
    }
}

fn span_text(span: (i64, i64)) -> String {
    let (a, b) = span;
    f"({a}, {b})"
}

fn show_match(prog: ref Program, s: ref Vec[i64], found: ref Option[Found], out: mut ref Vec[i64]) {
    let m = match found {
        Some(m) => m,
        None => {
            push_ascii(mut out, "  None\n");
            return;
        }
    };
    push_ascii(mut out, f"  span={span_text((m.start, m.end))} match=");
    str_repr(slice(s, m.start, m.end), mut out);
    out.push(10);
    if prog.groups > 0 {
        push_ascii(mut out, "  groups=(");
        let mut g = 0;
        while g < m.spans.len() {
            if g > 0 {
                push_ascii(mut out, ", ");
            }
            group_text(s, m.spans[g], mut out);
            g += 1;
        }
        if m.spans.len() == 1 {
            push_ascii(mut out, ",");
        }
        push_ascii(mut out, ")\n  spans=[");
        g = 0;
        while g < m.spans.len() {
            if g > 0 {
                push_ascii(mut out, ", ");
            }
            push_ascii(mut out, span_text(m.spans[g]));
            g += 1;
        }
        push_ascii(mut out, "]\n");
    }
    if prog.names.len() > 0 {
        push_ascii(mut out, "  named=");
        group_dict(prog, s, m, mut out);
        out.push(10);
    }
}

fn group_dict(prog: ref Program, s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    out.push(123);
    let mut k = 0;
    while k < prog.names.len() {
        if k > 0 {
            push_ascii(mut out, ", ");
        }
        let (name, g) = ref prog.names[k];
        str_repr(name, mut out);
        push_ascii(mut out, ": ");
        group_text(s, m.spans[g - 1], mut out);
        k += 1;
    }
    out.push(125);
}

// findall's item: the match, the one group, or a tuple of the groups,
// with '' for a group that did not take part.
fn findall_item(prog: ref Program, s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    if prog.groups == 0 {
        str_repr(slice(s, m.start, m.end), mut out);
        return;
    }
    if prog.groups > 1 {
        out.push(40);
    }
    let mut g = 0;
    while g < m.spans.len() {
        if g > 0 {
            push_ascii(mut out, ", ");
        }
        let (a, b) = m.spans[g];
        if a < 0 {
            push_ascii(mut out, "''");
        } else {
            str_repr(slice(s, a, b), mut out);
        }
        g += 1;
    }
    if prog.groups > 1 {
        out.push(41);
    }
}

// A replacement template: literal text and group numbers.
enum Piece {
    Text(Vec[i64]),
    Group(i64),
}

// _parser.parse_template.
fn parse_template(repl: ref Vec[i64], prog: ref Program) -> Result[Vec[Piece], ReErr] {
    let mut s = new_tokenizer(repl)?;
    let mut pieces: Vec[Piece] = Vec.new();
    let mut literal: Vec[i64] = Vec.new();
    loop {
        let this = s.get()?;
        if this.n == 0 {
            break;
        }
        if this.n == 1 {
            literal.push(this.a);
            continue;
        }
        let c = this.b;
        let mut index = -1;
        let mut offset = 0;
        if c == 103 {
            if not s.take(60)? {
                return Err(s.error("missing <".to_string(), 0));
            }
            let name = s.getuntil(62, "group name")?;
            if not is_ascii_decimal(name) {
                s.checkgroupname(name, 1)?;
                let mut found = -1;
                for (n, g) in prog.names.iter() {
                    if same(n, name) {
                        found = g;
                    }
                }
                if found < 0 {
                    return Err(other_error("IndexError", f"unknown group name {repr_of(name)}"));
                }
                index = found;
            } else {
                if name.len() > 10 or digits_value(name, 0, 10) >= maxgroups() {
                    return Err(s.error(f"invalid group reference {to_string(name)}", name.len() + 1));
                }
                index = digits_value(name, 0, 10);
            }
            offset = name.len() + 1;
        } else if c == 48 {
            let mut text = tok_text(this);
            if s.next.n == 1 and is_oct(s.next.a) {
                text.push(s.get()?.a);
                if s.next.n == 1 and is_oct(s.next.a) {
                    text.push(s.get()?.a);
                }
            }
            literal.push(digits_value(text, 1, 8) & 0xFF);
            continue;
        } else if is_dec(c) {
            let mut text = tok_text(this);
            if s.next.n == 1 and is_dec(s.next.a) {
                text.push(s.get()?.a);
                if is_oct(c) and is_oct(text[2]) and s.next.n == 1 and is_oct(s.next.a) {
                    text.push(s.get()?.a);
                    let v = digits_value(text, 1, 8);
                    if v > 0o377 {
                        return Err(s.error(f"octal escape value {to_string(text)} outside of range 0-0o377", text.len()));
                    }
                    literal.push(v);
                    continue;
                }
            }
            index = digits_value(text, 1, 10);
            offset = text.len() - 1;
        } else {
            let e = escape_value(this);
            if e >= 0 {
                literal.push(e);
            } else if is_ascii_letter(c) {
                return Err(s.error(f"bad escape {to_string(tok_text(this))}", 2));
            } else {
                literal.push(92);
                literal.push(c);
            }
            continue;
        }
        if index > prog.groups {
            return Err(s.error(f"invalid group reference {index}", offset));
        }
        pieces.push(Piece.Text(literal));
        literal = Vec.new();
        pieces.push(Piece.Group(index));
    }
    pieces.push(Piece.Text(literal));
    Ok(pieces)
}

fn expand(pieces: ref Vec[Piece], s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    for piece in pieces.iter() {
        match piece {
            Piece.Text(t) => push_all(mut out, t),
            Piece.Group(g) => {
                let (a, b) = if g == 0 { (m.start, m.end) } else { m.spans[g - 1] };
                if a >= 0 {
                    push_all(mut out, slice(s, a, b));
                }
            }
        }
    }
}


// ---------------------------------------------------------------- chars

fn to_chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn text(raw: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut s = String.new();
    let mut k = lo;
    while k < hi {
        s.push(raw[k]);
        k += 1;
    }
    s
}

fn char_count(s: ref String) -> i64 {
    let mut n = 0;
    for _c in s.chars() {
        n += 1;
    }
    n
}

fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn is_ident_start(c: char) -> bool {
    c == '_' or (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')
}

fn is_ident(c: char) -> bool {
    is_ident_start(c) or is_digit(c)
}

fn chr(n: i64) -> char {
    match char.try_from(n) {
        Ok(c) => c,
        Err(_) => '?',
    }
}

fn repeat(c: char, n: i64) -> String {
    let mut s = String.new();
    let mut k = 0;
    while k < n {
        s.push(c);
        k += 1;
    }
    s
}

// n >= 0 in the given base, with lower- or upper-case letters.
fn to_base(n: i64, base: i64, upper: bool) -> String {
    if n == 0 {
        return "0".to_string();
    }
    let mut rev: Vec[char] = Vec.new();
    let mut m = n;
    while m > 0 {
        let d = m % base;
        if d < 10 {
            rev.push(chr(48 + d));
        } else if upper {
            rev.push(chr(55 + d));
        } else {
            rev.push(chr(87 + d));
        }
        m = m / base;
    }
    let mut s = String.new();
    let mut k = rev.len() - 1;
    while k >= 0 {
        s.push(rev[k]);
        k -= 1;
    }
    s
}

// Lower-case hex, zero-padded to at least width digits.
fn hex(n: i64, width: i64) -> String {
    let h = to_base(n, 16, false);
    let n_digits = char_count(h);
    if n_digits >= width {
        h
    } else {
        f"{repeat('0', width - n_digits)}{h}"
    }
}

fn is_hex_char(c: char) -> bool {
    is_digit(c) or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F')
}

fn ascii_lower(c: char) -> char {
    if c >= 'A' and c <= 'Z' { chr(c as i64 + 32) } else { c }
}


// ------------------------------------------------------------ big integers

// Magnitudes as 32-bit limbs, least significant first, with no high
// zero limbs (zero is the empty vector).
fn big_trim(a: mut ref Vec[u32]) {
    while a.len() > 0 and a[a.len() - 1] == 0 {
        a.pop();
    }
}

fn big_mul_add(a: mut ref Vec[u32], m: u64, add: u64) {
    let mut carry = add;
    for i in 0..a.len() {
        let t = (a[i] as u64) * m + carry;
        a[i] = (t & 4294967295) as u32;
        carry = t >> 32;
    }
    while carry > 0 {
        a.push((carry & 4294967295) as u32);
        carry = carry >> 32;
    }
}

fn big_from_digits(ds: ref Vec[u8]) -> Vec[u32] {
    let mut a: Vec[u32] = Vec.new();
    for d in ds.iter() {
        big_mul_add(mut a, 10, *d as u64);
    }
    big_trim(mut a);
    a
}

fn big_pow10(n: i64) -> Vec[u32] {
    let mut a: Vec[u32] = [1];
    let mut k = n;
    while k >= 9 {
        big_mul_add(mut a, 1000000000, 0);
        k -= 9;
    }
    while k > 0 {
        big_mul_add(mut a, 10, 0);
        k -= 1;
    }
    a
}

fn big_mul(a: ref Vec[u32], b: ref Vec[u32]) -> Vec[u32] {
    let mut out: Vec[u32] = Vec.new();
    for _ in 0..(a.len() + b.len()) {
        out.push(0);
    }
    for i in 0..a.len() {
        let mut carry: u64 = 0;
        for j in 0..b.len() {
            let t = (a[i] as u64) * (b[j] as u64) + (out[i + j] as u64) + carry;
            out[i + j] = (t & 4294967295) as u32;
            carry = t >> 32;
        }
        let mut k = i + b.len();
        while carry > 0 {
            let t = (out[k] as u64) + carry;
            out[k] = (t & 4294967295) as u32;
            carry = t >> 32;
            k += 1;
        }
    }
    big_trim(mut out);
    out
}

fn big_bitlen(a: ref Vec[u32]) -> i64 {
    if a.len() == 0 {
        return 0;
    }
    let mut top = a[a.len() - 1];
    let mut n: i64 = 0;
    while top > 0 {
        n += 1;
        top = top >> 1;
    }
    (a.len() - 1) * 32 + n
}

fn big_shl(a: ref Vec[u32], bits: i64) -> Vec[u32] {
    let mut out: Vec[u32] = Vec.new();
    for _ in 0..(bits / 32) {
        out.push(0);
    }
    let s = bits % 32;
    let mut carry: u64 = 0;
    for i in 0..a.len() {
        let t = ((a[i] as u64) << s) | carry;
        out.push((t & 4294967295) as u32);
        carry = t >> 32;
    }
    if carry > 0 {
        out.push(carry as u32);
    }
    big_trim(mut out);
    out
}

fn big_shr1(a: mut ref Vec[u32]) {
    let mut i = 0;
    while i < a.len() {
        let hi: u32 = if i + 1 < a.len() { a[i + 1] & 1 } else { 0 };
        a[i] = (a[i] >> 1) | (hi << 31);
        i += 1;
    }
    big_trim(mut a);
}

fn big_cmp(a: ref Vec[u32], b: ref Vec[u32]) -> i64 {
    if a.len() != b.len() {
        return if a.len() < b.len() { -1 } else { 1 };
    }
    let mut i = a.len() - 1;
    while i >= 0 {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 };
        }
        i -= 1;
    }
    0
}

// a -= b, where a >= b.
fn big_sub(a: mut ref Vec[u32], b: ref Vec[u32]) {
    let mut borrow: i64 = 0;
    for i in 0..a.len() {
        let bv: i64 = if i < b.len() { b[i] as i64 } else { 0 };
        let mut t = (a[i] as i64) - bv - borrow;
        if t < 0 {
            t += 4294967296;
            borrow = 1;
        } else {
            borrow = 0;
        }
        a[i] = t as u32;
    }
    big_trim(mut a);
}

// ------------------------------------------------------------ decimal to float

// The f64 nearest to digits * 10**exp10, ties to even, as CPython's
// float() gives it. digits holds the digit values without leading zeros.
fn decimal_to_f64(digits: ref Vec[u8], exp10: i64, neg: bool) -> f64 {
    let mut ds = digits.clone();
    let mut e10 = exp10;
    while ds.len() > 0 and ds[ds.len() - 1] == 0 {
        ds.pop();
        e10 += 1;
    }
    let sign: f64 = if neg { -1.0 } else { 1.0 };
    if ds.len() == 0 {
        return sign * 0.0;
    }
    let n = ds.len();
    if n + e10 > 310 {
        return sign * f64.INFINITY;
    }
    if n + e10 < -330 {
        return sign * 0.0;
    }
    // The digits and the power of ten are exact, so one operation
    // rounds correctly.
    if n <= 15 and e10 >= -22 and e10 <= 22 {
        let mut m: f64 = 0.0;
        for d in ds.iter() {
            m = m * 10.0 + (*d as f64);
        }
        let mut p: f64 = 1.0;
        let mut k = if e10 < 0 { -e10 } else { e10 };
        while k > 0 {
            p *= 10.0;
            k -= 1;
        }
        return sign * (if e10 < 0 { m / p } else { m * p });
    }
    let mut num = big_from_digits(ds);
    let mut den: Vec[u32] = [1];
    if e10 >= 0 {
        num = big_mul(num, big_pow10(e10));
    } else {
        den = big_pow10(-e10);
    }
    // q = floor(num * 2**s / den) with 54 bits: the 53 of the result
    // and one to round on.
    let mut s = 54 - (big_bitlen(num) - big_bitlen(den));
    if s > 1075 {
        s = 1075;
    }
    let mut q: u64 = 0;
    let mut rem: Vec[u32] = Vec.new();
    let mut tries = 0;
    while tries < 2 {
        let mut n2 = if s > 0 { big_shl(num, s) } else { num.clone() };
        let d2 = if s < 0 { big_shl(den, -s) } else { den.clone() };
        let mut dd = big_shl(d2, 55);
        q = 0;
        let mut bit = 55;
        while bit >= 0 {
            if big_cmp(n2, dd) >= 0 {
                big_sub(mut n2, dd);
                q = q | ((1 as u64) << bit);
            }
            big_shr1(mut dd);
            bit -= 1;
        }
        rem = n2;
        if q >= ((1 as u64) << 54) and s < 1075 {
            s -= 1;
            tries += 1;
            continue;
        }
        if q < ((1 as u64) << 53) and s < 1075 {
            s += 1;
            tries += 1;
            continue;
        }
        break;
    }
    let mut mant = q >> 1;
    let round = (q & 1) == 1;
    let sticky = rem.len() > 0;
    if round and (sticky or (mant & 1) == 1) {
        mant += 1;
    }
    // The value is mant * 2**(1 - s).
    let mut e2 = 1 - s;
    if mant == ((1 as u64) << 53) {
        mant = mant >> 1;
        e2 += 1;
    }
    let bits: u64 = if mant < ((1 as u64) << 52) {
        // Subnormal: s is 1075 and the exponent field is zero.
        mant
    } else {
        let biased = e2 + 1075;
        if biased >= 2047 {
            return sign * f64.INFINITY;
        }
        ((biased as u64) << 52) | (mant & (((1 as u64) << 52) - 1))
    };
    sign * bits.bits_as_f64()
}

// ------------------------------------------------------------ float to decimal

fn big_to_digits(a: ref Vec[u32]) -> Vec[char] {
    if a.len() == 0 {
        return ['0'];
    }
    let mut x = a.clone();
    let mut chunks: Vec[u64] = Vec.new();
    while x.len() > 0 {
        let mut rem: u64 = 0;
        let mut i = x.len() - 1;
        while i >= 0 {
            let cur = (rem << 32) | (x[i] as u64);
            x[i] = (cur / 1000000000) as u32;
            rem = cur % 1000000000;
            i -= 1;
        }
        big_trim(mut x);
        chunks.push(rem);
    }
    let mut out: Vec[char] = Vec.new();
    let mut k = chunks.len() - 1;
    while k >= 0 {
        let s = chunks[k].to_string();
        if k < chunks.len() - 1 {
            for _ in 0..(9 - s.len()) {
                out.push('0');
            }
        }
        for c in s.chars() {
            out.push(c);
        }
        k -= 1;
    }
    out
}

// The exact decimal value of a finite, non-negative x: its digits with no
// leading zeros (none for zero) and the decimal exponent of the first.
fn exact_digits(x: f64) -> (Vec[char], i64) {
    let bits = x.to_bits();
    let biased = ((bits >> 52) & 2047) as i64;
    let frac = bits & ((1 as u64 << 52) - 1);
    let m: u64 = if biased == 0 { frac } else { frac | (1 as u64 << 52) };
    let q = if biased == 0 { -1074 } else { biased - 1075 };
    if m == 0 {
        return (Vec.new(), 0);
    }
    let mut a: Vec[u32] = Vec.new();
    big_mul_add(mut a, 1, m);
    let mut e10 = 0;
    if q >= 0 {
        a = big_shl(a, q);
    } else {
        // m * 2**q == m * 5**-q * 10**q
        let mut k = 0;
        while k < -q {
            big_mul_add(mut a, 5, 0);
            k += 1;
        }
        e10 = q;
    }
    let mut d = big_to_digits(a);
    while d.len() > 1 and d[d.len() - 1] == '0' {
        d.pop();
        e10 += 1;
    }
    let n = d.len();
    (d, e10 + n - 1)
}

// The exact digits (d, e) rounded half-to-even to keep the digits whose
// place is at least 10**place: the kept digits (possibly empty when all
// round away) and the exponent of the first.
fn round_place(d: ref Vec[char], e: i64, place: i64) -> (Vec[char], i64) {
    let n = e - place + 1;
    if n >= d.len() {
        return (d.clone(), e);
    }
    if n < 0 {
        return (Vec.new(), place);
    }
    let mut keep: Vec[char] = Vec.new();
    for k in 0..n {
        keep.push(d[k]);
    }
    let first = d[n];
    let mut rest = false;
    for k in (n + 1)..d.len() {
        if d[k] != '0' {
            rest = true;
        }
    }
    let odd = n > 0 and (d[n - 1] as i64 - 48) % 2 == 1;
    let up = first > '5' or (first == '5' and (rest or odd));
    if not up {
        while keep.len() > 0 and keep[keep.len() - 1] == '0' {
            keep.pop();
        }
        if keep.len() == 0 {
            return (Vec.new(), place);
        }
        return (keep, e);
    }
    let mut j = keep.len() - 1;
    while j >= 0 and keep[j] == '9' {
        keep.pop();
        j -= 1;
    }
    if j < 0 {
        return (['1'], e + 1);
    }
    keep[j] = chr(keep[j] as i64 + 1);
    (keep, e)
}

fn digit_vals(d: ref Vec[char]) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for c in d.iter() {
        v.push((*c as i64 - 48) as u8);
    }
    v
}

// The shortest digits that read back as x (x finite and non-negative).
// A rounding that reads back keeps reading back with more digits, so the
// count is found by bisection.
fn shortest_digits(x: f64) -> (Vec[char], i64) {
    let (d, e) = exact_digits(x);
    if d.len() == 0 {
        return (['0'], 0);
    }
    let mut lo = 1;
    let mut hi = 17;
    while lo < hi {
        let p = (lo + hi) / 2;
        let (r, re) = round_place(d, e, e - p + 1);
        if r.len() > 0 and decimal_to_f64(digit_vals(r), re - r.len() + 1, false) == x {
            hi = p;
        } else {
            lo = p + 1;
        }
    }
    round_place(d, e, e - lo + 1)
}

fn exp_text(e: i64, upper: bool) -> String {
    let mark = if upper { 'E' } else { 'e' };
    let sign = if e < 0 { '-' } else { '+' };
    let a = if e < 0 { -e } else { e };
    if a < 10 {
        f"{mark}{sign}0{a}"
    } else {
        f"{mark}{sign}{a}"
    }
}

fn is_neg(x: f64) -> bool {
    (x.to_bits() >> 63) == 1
}

// repr(float).
fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    let sign = if is_neg(x) { "-" } else { "" };
    let a = if is_neg(x) { -x } else { x };
    if a == f64.INFINITY {
        return f"{sign}inf";
    }
    let (d, e) = shortest_digits(a);
    let decpt = e + 1;
    let mut s = sign.to_string();
    if decpt <= -4 or decpt > 16 {
        s.push(d[0]);
        if d.len() > 1 {
            s.push('.');
            s.push_str(text(d, 1, d.len()));
        }
        s.push_str(exp_text(e, false));
    } else if decpt <= 0 {
        s.push_str("0.");
        s.push_str(repeat('0', -decpt));
        s.push_str(text(d, 0, d.len()));
    } else if decpt >= d.len() {
        s.push_str(text(d, 0, d.len()));
        s.push_str(repeat('0', decpt - d.len()));
        s.push_str(".0");
    } else {
        s.push_str(text(d, 0, decpt));
        s.push('.');
        s.push_str(text(d, decpt, d.len()));
    }
    s
}

// x (finite, non-negative) with `precision` digits after the point, as
// '%.Nf' writes it: the integer digits and the fraction (with its point).
fn fixed_text(x: f64, precision: i64, alt: bool) -> (String, String) {
    let (d, e) = exact_digits(x);
    let (r, re) = if d.len() == 0 { (Vec.new(), 0) } else { round_place(d, e, -precision) };
    // the digit at place p (0 when outside r)
    let mut int_part = String.new();
    if r.len() == 0 or re < 0 {
        int_part.push('0');
    } else {
        for i in 0..(re + 1) {
            int_part.push(if i < r.len() { r[i] } else { '0' });
        }
    }
    let mut frac = String.new();
    if precision > 0 or alt {
        frac.push('.');
    }
    for p in 1..(precision + 1) {
        let k = re + p;
        frac.push(if r.len() > 0 and k >= 0 and k < r.len() { r[k] } else { '0' });
    }
    (int_part, frac)
}

// x (finite, non-negative) as '%.Ne' writes it.
fn sci_text(x: f64, precision: i64, alt: bool, upper: bool) -> (String, String) {
    let (d, e) = exact_digits(x);
    let (r, re) = if d.len() == 0 { (['0'], 0) } else { round_place(d, e, e - precision) };
    let mut frac = String.new();
    if precision > 0 or alt {
        frac.push('.');
    }
    for k in 1..(precision + 1) {
        frac.push(if k < r.len() { r[k] } else { '0' });
    }
    frac.push_str(exp_text(re, upper));
    (r[0].to_string(), frac)
}

// ------------------------------------------------------------ float() and int() of a str

// A float literal's text (digits, a point, an exponent) to the nearest
// f64.
fn parse_float_text(t: ref Vec[char], neg: bool) -> f64 {
    let mut digits: Vec[u8] = Vec.new();
    let mut exp10: i64 = 0;
    let mut i = 0;
    let mut point = false;
    while i < t.len() {
        let c = t[i];
        if is_digit(c) {
            let d = (c as i64 - 48) as u8;
            if digits.len() > 0 or d != 0 {
                digits.push(d);
            }
            if point {
                exp10 -= 1;
            }
        } else if c == '.' {
            point = true;
        } else if c == 'e' or c == 'E' {
            let mut j = i + 1;
            let mut eneg = false;
            if j < t.len() and (t[j] == '+' or t[j] == '-') {
                eneg = t[j] == '-';
                j += 1;
            }
            let mut ev = 0;
            while j < t.len() {
                ev = ev * 10 + (t[j] as i64 - 48);
                if ev > 100000 {
                    ev = 100000;
                }
                j += 1;
            }
            exp10 += if eneg { -ev } else { ev };
            break;
        }
        i += 1;
    }
    decimal_to_f64(digits, exp10, neg)
}

fn strip_py_space(s: ref String) -> Vec[char] {
    let cs = to_chars(s);
    let mut a = 0;
    let mut b = cs.len();
    while a < b and is_py_space(cs[a]) {
        a += 1;
    }
    while b > a and is_py_space(cs[b - 1]) {
        b -= 1;
    }
    let mut out: Vec[char] = Vec.new();
    for k in a..b {
        out.push(cs[k]);
    }
    out
}

// int(s): whitespace, a sign, digits with single underscores between.
fn py_int_str(s: ref String) -> Option[i64] {
    let t = strip_py_space(s);
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == '+' or t[i] == '-') {
        neg = t[i] == '-';
        i += 1;
    }
    if i >= t.len() {
        return None;
    }
    let mut v = 0;
    let mut prev_digit = false;
    while i < t.len() {
        let c = t[i];
        if c == '_' {
            if not prev_digit or i + 1 == t.len() {
                return None;
            }
            prev_digit = false;
        } else if is_digit(c) {
            v = v * 10 + (c as i64 - 48);
            prev_digit = true;
        } else {
            return None;
        }
        i += 1;
    }
    Some(if neg { -v } else { v })
}

// float(s): whitespace, a sign, then inf, infinity, nan, or a decimal
// number with single underscores between digits.
fn py_float_str(s: ref String) -> Option[f64] {
    let t = strip_py_space(s);
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == '+' or t[i] == '-') {
        neg = t[i] == '-';
        i += 1;
    }
    let mut word = String.new();
    for k in i..t.len() {
        word.push(ascii_lower(t[k]));
    }
    let sign: f64 = if neg { -1.0 } else { 1.0 };
    if word == "inf" or word == "infinity" {
        return Some(sign * f64.INFINITY);
    }
    if word == "nan" {
        return Some(f64.INFINITY - f64.INFINITY);
    }
    let mut body: Vec[char] = Vec.new();
    let mut seen = false;
    let mut point = false;
    let mut exp = false;
    let mut exp_digit = false;
    while i < t.len() {
        let c = t[i];
        if is_digit(c) {
            if exp {
                exp_digit = true;
            } else {
                seen = true;
            }
        } else if c == '.' and not point and not exp {
            point = true;
        } else if (c == 'e' or c == 'E') and seen and not exp {
            exp = true;
        } else if (c == '+' or c == '-') and exp and (t[i - 1] == 'e' or t[i - 1] == 'E') {
        } else if c == '_' and i > 0 and i + 1 < t.len() and is_digit(t[i - 1]) and is_digit(t[i + 1]) {
            i += 1;
            continue;
        } else {
            return None;
        }
        body.push(c);
        i += 1;
    }
    if not seen or (exp and not exp_digit) {
        return None;
    }
    Some(parse_float_text(body, neg))
}

// ---------------------------------------------------------------- Python's str

// str.isspace, the set str.strip(), int() and float() skip.
fn is_py_space(c: char) -> bool {
    let n = c as i64;
    (n >= 9 and n <= 13) or (n >= 28 and n <= 32) or n == 0x85 or n == 0xa0
        or n == 0x1680 or (n >= 0x2000 and n <= 0x200a) or n == 0x2028
        or n == 0x2029 or n == 0x202f or n == 0x205f or n == 0x3000
}

// str.isprintable, for repr: everything but controls, separators other
// than the space, and format characters.
fn is_py_printable(c: char) -> bool {
    let n = c as i64;
    if n < 32 or (n >= 0x7f and n <= 0xa0) or n == 0xad {
        return false;
    }
    if n == 0x1680 or (n >= 0x2000 and n <= 0x200f) or (n >= 0x2028 and n <= 0x202f) {
        return false;
    }
    if (n >= 0x205f and n <= 0x2064) or n == 0x3000 or n == 0xfeff {
        return false;
    }
    true
}

fn py_strip(s: ref String) -> String {
    let cs = to_chars(s);
    let mut a = 0;
    let mut b = cs.len();
    while a < b and is_py_space(cs[a]) {
        a += 1;
    }
    while b > a and is_py_space(cs[b - 1]) {
        b -= 1;
    }
    text(cs, a, b)
}

// repr(s).
fn py_repr(s: ref String) -> String {
    let has_single = s.contains("'");
    let has_double = s.contains("\"");
    let quote = if has_single and not has_double { '"' } else { '\'' };
    let mut out = String.new();
    out.push(quote);
    for c in s.chars() {
        if c == quote or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if is_py_printable(c) {
            out.push(c);
        } else if (c as i64) < 0x100 {
            out.push_str(f"\\x{hex(c as i64, 2)}");
        } else if (c as i64) < 0x10000 {
            out.push_str(f"\\u{hex(c as i64, 4)}");
        } else {
            out.push_str(f"\\U{hex(c as i64, 8)}");
        }
    }
    out.push(quote);
    out
}

fn py_list_repr(items: ref Vec[String]) -> String {
    let mut out = "[".to_string();
    for k in 0..items.len() {
        if k > 0 {
            out.push_str(", ");
        }
        out.push_str(py_repr(items[k]));
    }
    out.push(']');
    out
}

// int(s), with ValueError's message.
fn py_int(s: ref String) -> Result[i64, String] {
    match py_int_str(s) {
        Some(v) => Ok(v),
        None => Err(f"invalid literal for int() with base 10: {py_repr(s)}"),
    }
}

// float(s), with ValueError's message.
fn py_float(s: ref String) -> Result[f64, String] {
    match py_float_str(s) {
        Some(v) => Ok(v),
        None => Err(f"could not convert string to float: {py_repr(s)}"),
    }
}

// round(x) for a float: to the nearest integer, ties to even.
fn py_round(x: f64) -> Result[i64, String] {
    if x != x {
        return Err("cannot convert float NaN to integer".to_string());
    }
    if x == f64.INFINITY or x == -f64.INFINITY {
        return Err("cannot convert float infinity to integer".to_string());
    }
    let fl = x.floor();
    let diff = x - fl;
    let base = fl as i64;
    if diff > 0.5 {
        Ok(base + 1)
    } else if diff < 0.5 {
        Ok(base)
    } else if base % 2 == 0 {
        Ok(base)
    } else {
        Ok(base + 1)
    }
}

// a % b for floats, with the sign of b.
fn py_fmod(a: f64, b: f64) -> f64 {
    let r = a % b;
    if r != 0.0 and ((r < 0.0) != (b < 0.0)) { r + b } else { r }
}

// f"{x:.Nf}" for x >= 0.
fn fixed(x: f64, places: i64) -> String {
    let (i, f) = fixed_text(x, places, false);
    f"{i}{f}"
}

// The text of s before the first `sep`, as s.split(sep)[0].
fn before(s: ref String, sep: char) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c == sep {
            break;
        }
        out.push(c);
    }
    out
}

// ---------------------------------------------------------------- JSON values

// A value as json.loads gives it to uritemplate. Pairs is a list of
// (key, value) tuples, which JSON cannot spell: the jobs write it as an
// object whose only key is "__pairs__".
#[derive(Clone)]
enum Val {
    Null,
    Bool(bool),
    Int(i64),
    Float(f64),
    Str(String),
    List(Vec[Val]),
    Dict(Vec[Member]),
    Pairs(Vec[Member]),
}

#[derive(Clone)]
struct Member {
    key: String,
    val: Val,
}

struct JsonReader {
    cs: Vec[char],
    i: i64,
}

fn json_parse(s: ref String) -> Result[Val, String] {
    let mut p = JsonReader { cs: to_chars(s), i: 0 };
    let v = json_value(mut p)?;
    json_ws(mut p);
    if p.i != p.cs.len() {
        return Err(f"extra data at {p.i}");
    }
    Ok(v)
}

fn json_ws(p: mut ref JsonReader) {
    while p.i < p.cs.len() {
        let c = p.cs[p.i];
        if c == ' ' or c == '\n' or c == '\t' or c == '\r' {
            p.i += 1;
        } else {
            break;
        }
    }
}

fn json_word(p: mut ref JsonReader, w: ref String) -> bool {
    let ws = to_chars(w);
    for k in 0..ws.len() {
        if p.i + k >= p.cs.len() or p.cs[p.i + k] != ws[k] {
            return false;
        }
    }
    p.i += ws.len();
    true
}

fn json_value(p: mut ref JsonReader) -> Result[Val, String] {
    json_ws(mut p);
    if p.i >= p.cs.len() {
        return Err("unexpected end".to_string());
    }
    let c = p.cs[p.i];
    if c == '{' {
        p.i += 1;
        let mut members: Vec[Member] = Vec.new();
        json_ws(mut p);
        if p.i < p.cs.len() and p.cs[p.i] == '}' {
            p.i += 1;
            return Ok(Val.Dict(members));
        }
        loop {
            json_ws(mut p);
            let key = json_string(mut p)?;
            json_ws(mut p);
            if p.i >= p.cs.len() or p.cs[p.i] != ':' {
                return Err(f"expected ':' at {p.i}");
            }
            p.i += 1;
            let val = json_value(mut p)?;
            members.push(Member { key: key, val: val });
            json_ws(mut p);
            if p.i < p.cs.len() and p.cs[p.i] == ',' {
                p.i += 1;
            } else if p.i < p.cs.len() and p.cs[p.i] == '}' {
                p.i += 1;
                break;
            } else {
                return Err(f"expected ',' or '}}' at {p.i}");
            }
        }
        return Ok(object_val(members));
    }
    if c == '[' {
        p.i += 1;
        let mut items: Vec[Val] = Vec.new();
        json_ws(mut p);
        if p.i < p.cs.len() and p.cs[p.i] == ']' {
            p.i += 1;
            return Ok(Val.List(items));
        }
        loop {
            items.push(json_value(mut p)?);
            json_ws(mut p);
            if p.i < p.cs.len() and p.cs[p.i] == ',' {
                p.i += 1;
            } else if p.i < p.cs.len() and p.cs[p.i] == ']' {
                p.i += 1;
                break;
            } else {
                return Err(f"expected ',' or ']' at {p.i}");
            }
        }
        return Ok(Val.List(items));
    }
    if c == '"' {
        return Ok(Val.Str(json_string(mut p)?));
    }
    if json_word(mut p, "true") {
        return Ok(Val.Bool(true));
    }
    if json_word(mut p, "false") {
        return Ok(Val.Bool(false));
    }
    if json_word(mut p, "null") {
        return Ok(Val.Null);
    }
    let start = p.i;
    let mut is_float = false;
    while p.i < p.cs.len() {
        let d = p.cs[p.i];
        if is_digit(d) or d == '-' or d == '+' {
            p.i += 1;
        } else if d == '.' or d == 'e' or d == 'E' {
            is_float = true;
            p.i += 1;
        } else {
            break;
        }
    }
    let t = text(p.cs, start, p.i);
    if t.len() == 0 {
        return Err(f"unexpected {py_repr(c.to_string())} at {start}");
    }
    if is_float {
        match py_float_str(t) {
            Some(f) => Ok(Val.Float(f)),
            None => Err(f"bad number {t}"),
        }
    } else {
        match py_int_str(t) {
            Some(n) => Ok(Val.Int(n)),
            None => Err(f"bad number {t}"),
        }
    }
}

// An object, or the list of tuples spelled {"__pairs__": [[k, v], ...]}.
fn object_val(members: own Vec[Member]) -> Val {
    if members.len() == 1 and members[0].key == "__pairs__" {
        let mut out: Vec[Member] = Vec.new();
        if let Val.List(items) = members[0].val.clone() {
            for item in items {
                if let Val.List(kv) = item {
                    let key = match kv[0].clone() {
                        Val.Str(k) => k,
                        _ => String.new(),
                    };
                    out.push(Member { key: key, val: kv[1].clone() });
                }
            }
        }
        if out.len() == 0 {
            return Val.List(Vec.new());
        }
        return Val.Pairs(out);
    }
    Val.Dict(members)
}

fn hex_digit(c: char) -> i64 {
    let n = c as i64;
    if n >= 97 {
        n - 87
    } else if n >= 65 {
        n - 55
    } else {
        n - 48
    }
}

fn json_hex4(p: mut ref JsonReader) -> i64 {
    let mut v = 0;
    for k in 0..4 {
        v = v * 16 + hex_digit(p.cs[p.i + k]);
    }
    p.i += 4;
    v
}

fn json_string(p: mut ref JsonReader) -> Result[String, String] {
    if p.i >= p.cs.len() or p.cs[p.i] != '"' {
        return Err(f"expected a string at {p.i}");
    }
    p.i += 1;
    let mut out = String.new();
    loop {
        if p.i >= p.cs.len() {
            return Err("unterminated string".to_string());
        }
        let c = p.cs[p.i];
        if c == '"' {
            p.i += 1;
            return Ok(out);
        }
        if c != '\\' {
            out.push(c);
            p.i += 1;
            continue;
        }
        let e = p.cs[p.i + 1];
        p.i += 2;
        if e == 'n' {
            out.push('\n');
        } else if e == 't' {
            out.push('\t');
        } else if e == 'r' {
            out.push('\r');
        } else if e == 'b' {
            out.push(chr(8));
        } else if e == 'f' {
            out.push(chr(12));
        } else if e == 'u' {
            let mut v = json_hex4(mut p);
            if v >= 0xd800 and v < 0xdc00 and p.i + 1 < p.cs.len() and p.cs[p.i] == '\\' and p.cs[p.i + 1] == 'u' {
                p.i += 2;
                let lo = json_hex4(mut p);
                v = 0x10000 + (v - 0xd800) * 1024 + (lo - 0xdc00);
            }
            out.push(chr(v));
        } else {
            out.push(e);
        }
    }
}

// The member named `key`, the last one if a name repeats, as a dict keeps it.
fn member(ms: ref Vec[Member], key: ref String) -> Option[Val] {
    let mut found: Option[Val] = None;
    for m in ms {
        if m.key == key {
            found = Some(m.val.clone());
        }
    }
    found
}

fn json_text(v: ref Val) -> String {
    match v {
        Val.Str(s) => s.clone(),
        _ => String.new(),
    }
}

// ---------------------------------------------------------------- Python's str

fn cp_text(cs: ref Vec[i64]) -> String {
    to_string(cs)
}

fn in_ranges(rs: ref Vec[(i64, i64)], c: i64) -> bool {
    let mut lo = 0;
    let mut hi = rs.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        let (a, b) = rs[mid];
        if c < a {
            hi = mid;
        } else if c > b {
            lo = mid + 1;
        } else {
            return true;
        }
    }
    false
}

// The tables str's predicates need, read once.
struct UniTables {
    digit_only: Vec[(i64, i64)],
    alpha: Vec[(i64, i64)],
    nfkc_netloc: Vec[(i64, i64)],
}

fn uni_tables() -> UniTables {
    UniTables { digit_only: digit_only_ranges(), alpha: alpha_ranges(), nfkc_netloc: nfkc_netloc_ranges() }
}

// The value of a decimal digit, any script's: its distance from the zero
// that starts its run of ten.
fn decimal_value(c: i64) -> i64 {
    if c < 0x80 {
        return c - 48;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return c - s;
        }
    }
    0
}

fn str_isdecimal(s: ref String) -> bool {
    if s.len() == 0 {
        return false;
    }
    for c in s.chars() {
        if not is_decimal(c as i64) {
            return false;
        }
    }
    true
}

fn str_isdigit(u: ref UniTables, s: ref String) -> bool {
    if s.len() == 0 {
        return false;
    }
    for c in s.chars() {
        let n = c as i64;
        if not is_decimal(n) and not in_ranges(u.digit_only, n) {
            return false;
        }
    }
    true
}

fn str_isalpha(u: ref UniTables, s: ref String) -> bool {
    if s.len() == 0 {
        return false;
    }
    for c in s.chars() {
        if not in_ranges(u.alpha, c as i64) {
            return false;
        }
    }
    true
}

fn str_isascii(s: ref String) -> bool {
    for b in s.bytes() {
        if b >= 0x80 {
            return false;
        }
    }
    true
}

fn str_isspace_char(c: char) -> bool {
    is_space(c as i64, false)
}

fn clen(s: ref String) -> i64 {
    char_count(s)
}

// s[a:b] by characters, with Python's clamping and negative indices.
fn cslice(s: ref String, a: i64, b: i64) -> String {
    let cs = to_chars(s);
    let n = cs.len();
    let mut lo = if a < 0 { n + a } else { a };
    let mut hi = if b < 0 { n + b } else { b };
    if lo < 0 {
        lo = 0;
    }
    if hi > n {
        hi = n;
    }
    if lo >= hi {
        return String.new();
    }
    text(cs, lo, hi)
}

fn char_at(s: ref String, k: i64) -> char {
    let cs = to_chars(s);
    if k < 0 { cs[cs.len() + k] } else { cs[k] }
}

// s.count(sub), non-overlapping.
fn count_sub(s: ref String, sub: ref String) -> i64 {
    let a = to_chars(s);
    let b = to_chars(sub);
    let mut n = 0;
    let mut i = 0;
    while i + b.len() <= a.len() {
        let mut same = true;
        for k in 0..b.len() {
            if a[i + k] != b[k] {
                same = false;
                break;
            }
        }
        if same {
            n += 1;
            i += b.len();
        } else {
            i += 1;
        }
    }
    n
}

fn find_char(cs: ref Vec[char], c: char) -> i64 {
    for k in 0..cs.len() {
        if cs[k] == c {
            return k;
        }
    }
    -1
}

fn rfind_char(cs: ref Vec[char], c: char) -> i64 {
    let mut k = cs.len() - 1;
    while k >= 0 {
        if cs[k] == c {
            return k;
        }
        k -= 1;
    }
    -1
}

// s.rsplit(sep, 1) for a sep that is there: the text before and after its last one.
fn rsplit_once(s: ref String, sep: char) -> (String, String) {
    let cs = to_chars(s);
    let k = rfind_char(cs, sep);
    (text(cs, 0, k), text(cs, k + 1, cs.len()))
}

// s.partition(sep): before, whether sep was there, after.
fn partition(s: ref String, sep: char) -> (String, bool, String) {
    let cs = to_chars(s);
    let k = find_char(cs, sep);
    if k < 0 {
        return (s.clone(), false, String.new());
    }
    (text(cs, 0, k), true, text(cs, k + 1, cs.len()))
}

fn rpartition(s: ref String, sep: char) -> (String, bool, String) {
    let cs = to_chars(s);
    let k = rfind_char(cs, sep);
    if k < 0 {
        return (String.new(), false, s.clone());
    }
    (text(cs, 0, k), true, text(cs, k + 1, cs.len()))
}

// s.lstrip(c) and s.rstrip(c) for one character.
fn lstrip_char(s: ref String, c: char) -> String {
    let cs = to_chars(s);
    let mut a = 0;
    while a < cs.len() and cs[a] == c {
        a += 1;
    }
    text(cs, a, cs.len())
}

fn rstrip_char(s: ref String, c: char) -> String {
    let cs = to_chars(s);
    let mut b = cs.len();
    while b > 0 and cs[b - 1] == c {
        b -= 1;
    }
    text(cs, 0, b)
}

// s.replace(old, new, 1) for one character.
fn replace_first(s: ref String, old: char, new: ref String) -> String {
    let mut out = String.new();
    let mut done = false;
    for c in s.chars() {
        if c == old and not done {
            out.push_str(new);
            done = true;
        } else {
            out.push(c);
        }
    }
    out
}

// s.replace(old, new) for text.
fn replace_all(s: ref String, old: ref String, new: ref String) -> String {
    let a = to_chars(s);
    let b = to_chars(old);
    let mut out = String.new();
    let mut i = 0;
    while i < a.len() {
        let mut same = i + b.len() <= a.len() and b.len() > 0;
        if same {
            for k in 0..b.len() {
                if a[i + k] != b[k] {
                    same = false;
                    break;
                }
            }
        }
        if same {
            out.push_str(new);
            i += b.len();
        } else {
            out.push(a[i]);
            i += 1;
        }
    }
    out
}

// s.strip() and s.split() with str.isspace's whitespace.
fn py_strip_ws(s: ref String) -> String {
    let cs = to_chars(s);
    let mut a = 0;
    let mut b = cs.len();
    while a < b and str_isspace_char(cs[a]) {
        a += 1;
    }
    while b > a and str_isspace_char(cs[b - 1]) {
        b -= 1;
    }
    text(cs, a, b)
}

fn py_split_ws(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    let mut inword = false;
    for c in s.chars() {
        if str_isspace_char(c) {
            if inword {
                out.push(cur.clone());
                cur = String.new();
                inword = false;
            }
        } else {
            cur.push(c);
            inword = true;
        }
    }
    if inword {
        out.push(cur);
    }
    out
}

fn split_on(s: ref String, sep: char) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            out.push(cur.clone());
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn has_char(s: ref String, c: char) -> bool {
    for x in s.chars() {
        if x == c {
            return true;
        }
    }
    false
}

// int(s) for a str: white space, a sign, then decimal digits of any
// script with single underscores between them.
fn py_int_any(s: ref String) -> Option[i64] {
    let t = to_chars(py_strip_ws(s));
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == '+' or t[i] == '-') {
        neg = t[i] == '-';
        i += 1;
    }
    if i >= t.len() {
        return None;
    }
    let mut v = 0;
    let mut prev_digit = false;
    while i < t.len() {
        let c = t[i] as i64;
        if t[i] == '_' {
            if not prev_digit or i + 1 == t.len() {
                return None;
            }
            prev_digit = false;
        } else if is_decimal(c) {
            v = v * 10 + decimal_value(c);
            prev_digit = true;
        } else {
            return None;
        }
        i += 1;
    }
    Some(if neg { -v } else { v })
}

fn int_error(s: ref String) -> String {
    f"invalid literal for int() with base 10: {py_repr(s)}"
}

// int(s, 16) over a 32-digit hex string, as uuid.UUID calls it: whether it
// parses, and whether the number is negative.
fn py_hex_ok(s: ref String) -> (bool, bool) {
    let t = to_chars(py_strip_ws(s));
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == '+' or t[i] == '-') {
        neg = t[i] == '-';
        i += 1;
    }
    let mut prev_digit = false;
    if i + 1 < t.len() and t[i] == '0' and (t[i + 1] == 'x' or t[i + 1] == 'X') {
        i += 2;
        // an underscore may follow the prefix
        prev_digit = true;
    }
    let mut digits = 0;
    let mut nonzero = false;
    while i < t.len() {
        let c = t[i];
        let n = c as i64;
        if c == '_' {
            if not prev_digit or i + 1 == t.len() {
                return (false, false);
            }
            prev_digit = false;
        } else if is_decimal(n) or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F') {
            digits += 1;
            if not (is_decimal(n) and decimal_value(n) == 0) {
                nonzero = true;
            }
            prev_digit = true;
        } else {
            return (false, false);
        }
        i += 1;
    }
    if digits == 0 {
        return (false, false);
    }
    (true, neg and nonzero)
}

// ---------------------------------------------------------------- ipaddress

fn all_ascii_digits(s: ref String) -> bool {
    if s.len() == 0 {
        return false;
    }
    for b in s.bytes() {
        if b < b'0' or b > b'9' {
            return false;
        }
    }
    true
}

// _BaseV4._parse_octet: ASCII digits, at most three, no leading zero,
// at most 255.
fn parse_octet(s: ref String) -> Option[u128] {
    if not all_ascii_digits(s) or s.len() > 3 {
        return None;
    }
    if s != "0" and s.starts_with("0") {
        return None;
    }
    let mut v: u128 = 0;
    for b in s.bytes() {
        v = v * 10 + ((b - b'0') as u128);
    }
    if v > 255 {
        return None;
    }
    Some(v)
}

// _BaseV4._ip_int_from_string.
fn v4_int(s: ref String) -> Option[u128] {
    if s.len() == 0 {
        return None;
    }
    let octets = split_on(s, '.');
    if octets.len() != 4 {
        return None;
    }
    let mut v: u128 = 0;
    for o in octets {
        v = v * 256 + parse_octet(o)?;
    }
    Some(v)
}

fn v4_addr(s: ref String) -> Option[u128] {
    if has_char(s, '/') {
        return None;
    }
    v4_int(s)
}

// _BaseV6._parse_hextet.
fn parse_hextet(s: ref String) -> Option[u128] {
    if s.len() == 0 or s.len() > 4 {
        return None;
    }
    let mut v: u128 = 0;
    for b in s.bytes() {
        let d = if b >= b'0' and b <= b'9' {
            b - b'0'
        } else if b >= b'a' and b <= b'f' {
            b - b'a' + 10
        } else if b >= b'A' and b <= b'F' {
            b - b'A' + 10
        } else {
            return None;
        };
        v = v * 16 + (d as u128);
    }
    Some(v)
}

// s.split(':', maxsplit=n).
fn split_max(s: ref String, sep: char, n: i64) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep and out.len() < n {
            out.push(cur.clone());
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

// _BaseV6._ip_int_from_string.
fn v6_int(s: ref String) -> Option[u128] {
    if s.len() == 0 or clen(s) > 45 {
        return None;
    }
    let mut parts = split_max(s, ':', 9);
    if parts.len() < 3 {
        return None;
    }
    if has_char(parts[parts.len() - 1], '.') {
        let last = parts.pop().unwrap();
        let v4 = v4_addr(last)?;
        parts.push(hex_text((v4 >> 16) & 0xFFFF));
        parts.push(hex_text(v4 & 0xFFFF));
    }
    if parts.len() > 9 {
        return None;
    }
    let mut skip: i64 = -1;
    for i in 1..(parts.len() - 1) {
        if parts[i].len() == 0 {
            if skip >= 0 {
                return None;
            }
            skip = i;
        }
    }
    let mut hi: i64 = 0;
    let mut lo: i64 = 0;
    let mut skipped: i64 = 0;
    if skip >= 0 {
        hi = skip;
        lo = parts.len() - skip - 1;
        if parts[0].len() == 0 {
            hi -= 1;
            if hi != 0 {
                return None;
            }
        }
        if parts[parts.len() - 1].len() == 0 {
            lo -= 1;
            if lo != 0 {
                return None;
            }
        }
        skipped = 8 - (hi + lo);
        if skipped < 1 {
            return None;
        }
    } else {
        if parts.len() != 8 {
            return None;
        }
        if parts[0].len() == 0 or parts[parts.len() - 1].len() == 0 {
            return None;
        }
        hi = parts.len();
    }
    let mut v: u128 = 0;
    for i in 0..hi {
        v = (v << 16) | parse_hextet(parts[i])?;
    }
    for _ in 0..skipped {
        v = v << 16;
    }
    let n = parts.len();
    for i in (n - lo)..n {
        v = (v << 16) | parse_hextet(parts[i])?;
    }
    Some(v)
}

fn hex_text(v: u128) -> String {
    let d = "0123456789abcdef".bytes().to_vec();
    if v == 0 {
        return "0".to_string();
    }
    let mut out: Vec[u8] = Vec.new();
    let mut x = v;
    while x > 0 {
        out.push(d[(x % 16) as i64]);
        x = x / 16;
    }
    out.reverse();
    String.from_utf8(out).unwrap()
}

// IPv6Address(s): no '/', an optional %scope that is not empty and has
// no second '%'.
fn v6_addr(s: ref String) -> Option[u128] {
    if has_char(s, '/') {
        return None;
    }
    let (addr, sep, scope) = partition(s, '%');
    if sep and (scope.len() == 0 or has_char(scope, '%')) {
        return None;
    }
    v6_int(addr)
}

fn mask_of(bits: i64, plen: i64) -> u128 {
    if plen == 0 {
        return 0;
    }
    let all: u128 = if bits == 128 { (((1 as u128) << 127) - 1) * 2 + 1 } else { ((1 as u128) << bits) - 1 };
    if plen >= bits {
        return all;
    }
    all ^ (all >> plen)
}

// _prefix_from_prefix_string.
fn prefix_from_string(s: ref String, bits: i64) -> Option[i64] {
    if not all_ascii_digits(s) {
        return None;
    }
    let mut v = 0;
    for b in s.bytes() {
        v = v * 10 + ((b - b'0') as i64);
        if v > 1000 {
            return None;
        }
    }
    if v > bits {
        return None;
    }
    Some(v)
}

// _prefix_from_ip_int for IPv4.
fn v4_prefix_from_int(ip: u128) -> Option[i64] {
    let mut tz = 0;
    while tz < 32 and ((ip >> tz) & 1) == 0 {
        tz += 1;
    }
    let plen = 32 - tz;
    let leading = if tz >= 32 { 0 } else { ip >> tz };
    let ones: u128 = ((1 as u128) << plen) - 1;
    if leading != ones {
        return None;
    }
    Some(plen)
}

// IPv4's _make_netmask for a string: a prefix length, else a netmask or
// hostmask in dotted form.
fn v4_mask(s: ref String) -> Option[i64] {
    if let Some(p) = prefix_from_string(s, 32) {
        return Some(p);
    }
    let ip = v4_int(s)?;
    if let Some(p) = v4_prefix_from_int(ip) {
        return Some(p);
    }
    v4_prefix_from_int(ip ^ 0xFFFFFFFF)
}

// IPv4Network(s, strict) / IPv6Network(s, strict) succeed.
fn v4_network(s: ref String, strict: bool) -> bool {
    let parts = split_on(s, '/');
    if parts.len() > 2 {
        return false;
    }
    let ip = match v4_addr(parts[0]) {
        Some(v) => v,
        None => return false,
    };
    let plen = if parts.len() == 2 {
        match v4_mask(parts[1]) {
            Some(p) => p,
            None => return false,
        }
    } else {
        32
    };
    let mask = mask_of(32, plen);
    not (strict and (ip & mask) != ip)
}

fn v6_network(s: ref String, strict: bool) -> bool {
    let parts = split_on(s, '/');
    if parts.len() > 2 {
        return false;
    }
    let ip = match v6_addr(parts[0]) {
        Some(v) => v,
        None => return false,
    };
    let plen = if parts.len() == 2 {
        match prefix_from_string(parts[1], 128) {
            Some(p) => p,
            None => return false,
        }
    } else {
        128
    };
    let mask = mask_of(128, plen);
    not (strict and (ip & mask) != ip)
}

// ---------------------------------------------------------------- urllib.parse

struct SplitUrl {
    scheme: String,
    netloc: String,
    path: String,
    query: String,
    fragment: String,
}

fn is_scheme_char(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '+' or c == '-' or c == '.'
}

// urlsplit(url), with the ValueErrors it raises.
fn urlsplit(re: ref Res, raw: ref String) -> Result[SplitUrl, String] {
    let mut cs: Vec[char] = Vec.new();
    let mut leading = true;
    for c in raw.chars() {
        if leading and (c as i64) <= 0x20 {
            continue;
        }
        leading = false;
        if c != '\t' and c != '\r' and c != '\n' {
            cs.push(c);
        }
    }
    let mut url = text(cs, 0, cs.len());
    let mut scheme = String.new();
    let i = find_char(cs, ':');
    if i > 0 and (cs[0] as i64) < 0x80 and ((cs[0] >= 'a' and cs[0] <= 'z') or (cs[0] >= 'A' and cs[0] <= 'Z')) {
        let mut all = true;
        for k in 0..i {
            if not is_scheme_char(cs[k]) {
                all = false;
                break;
            }
        }
        if all {
            scheme = text(cs, 0, i).to_lowercase();
            url = text(cs, i + 1, cs.len());
        }
    }
    let mut netloc = String.new();
    if url.starts_with("//") {
        let us = to_chars(url);
        let mut delim = us.len();
        for k in 2..us.len() {
            if us[k] == '/' or us[k] == '?' or us[k] == '#' {
                delim = k;
                break;
            }
        }
        netloc = text(us, 2, delim);
        url = text(us, delim, us.len());
        let open = has_char(netloc, '[');
        let close = has_char(netloc, ']');
        if open != close {
            return Err("Invalid IPv6 URL".to_string());
        }
        if open and close {
            check_bracketed_netloc(re, netloc)?;
        }
    }
    let mut fragment = String.new();
    if has_char(url, '#') {
        let (a, _, b) = partition(url, '#');
        url = a;
        fragment = b;
    }
    let mut query = String.new();
    if has_char(url, '?') {
        let (a, _, b) = partition(url, '?');
        url = a;
        query = b;
    }
    check_netloc(re, netloc)?;
    Ok(SplitUrl { scheme: scheme, netloc: netloc, path: url, query: query, fragment: fragment })
}

fn check_bracketed_netloc(re: ref Res, netloc: ref String) -> Result[(), String] {
    let (_, _, host_port) = rpartition(netloc, '@');
    let (before, have_open, bracketed) = partition(host_port, '[');
    let mut hostname = String.new();
    if have_open {
        if before.len() > 0 {
            return Err("Invalid IPv6 URL".to_string());
        }
        let (h, _, port) = partition(bracketed, ']');
        if port.len() > 0 and not port.starts_with(":") {
            return Err("Invalid IPv6 URL".to_string());
        }
        hostname = h;
    } else {
        let (h, _, _) = partition(host_port, ':');
        hostname = h;
    }
    if hostname.starts_with("v") or hostname.starts_with("V") {
        if not rx_match(re.ipvfuture, hostname) {
            return Err("IPvFuture address is invalid".to_string());
        }
        return Ok(());
    }
    if v4_addr(hostname).is_some() {
        return Err("An IPv4 address cannot be in brackets".to_string());
    }
    if v6_addr(hostname).is_none() {
        return Err(f"{py_repr(hostname)} does not appear to be an IPv4 or IPv6 address");
    }
    Ok(())
}

// _checknetloc: a non-ASCII netloc may not hold a character whose NFKC
// form brings in one of / ? # @ :.
fn check_netloc(re: ref Res, netloc: ref String) -> Result[(), String] {
    if netloc.len() == 0 or str_isascii(netloc) {
        return Ok(());
    }
    for c in netloc.chars() {
        if c != '@' and c != ':' and c != '#' and c != '?' and in_ranges(re.uni.nfkc_netloc, c as i64) {
            return Err(f"netloc '{netloc}' contains invalid characters under NFKC normalization");
        }
    }
    Ok(())
}

fn hex_digit_val(c: char) -> i64 {
    if c >= '0' and c <= '9' {
        c as i64 - 48
    } else if c >= 'a' and c <= 'f' {
        c as i64 - 87
    } else if c >= 'A' and c <= 'F' {
        c as i64 - 55
    } else {
        -1
    }
}

// bytes.decode('utf-8', 'replace'): each maximal invalid subpart becomes
// one U+FFFD.
fn utf8_replace(b: ref Vec[u8]) -> String {
    let mut out = String.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        let mut need = 0;
        let mut lo = 0x80;
        let mut hi = 0xBF;
        let mut cp = 0;
        if c < 0x80 {
            out.push(chr(c));
            i += 1;
            continue;
        } else if c >= 0xC2 and c <= 0xDF {
            need = 1;
            cp = c & 0x1F;
        } else if c >= 0xE0 and c <= 0xEF {
            need = 2;
            cp = c & 0x0F;
            if c == 0xE0 {
                lo = 0xA0;
            }
            if c == 0xED {
                hi = 0x9F;
            }
        } else if c >= 0xF0 and c <= 0xF4 {
            need = 3;
            cp = c & 0x07;
            if c == 0xF0 {
                lo = 0x90;
            }
            if c == 0xF4 {
                hi = 0x8F;
            }
        } else {
            out.push(chr(0xFFFD));
            i += 1;
            continue;
        }
        let mut j = i + 1;
        let mut ok = true;
        let mut k = 0;
        while k < need {
            if j >= b.len() {
                ok = false;
                break;
            }
            let d = b[j] as i64;
            let (a, z) = if k == 0 { (lo, hi) } else { (0x80, 0xBF) };
            if d < a or d > z {
                ok = false;
                break;
            }
            cp = (cp << 6) | (d & 0x3F);
            j += 1;
            k += 1;
        }
        if ok {
            out.push(chr(cp));
        } else {
            out.push(chr(0xFFFD));
        }
        i = j;
    }
    out
}

// unquote(s): %XX in each ASCII run decoded as UTF-8, with replacement.
fn unquote(s: ref String) -> String {
    if not has_char(s, '%') {
        return s.clone();
    }
    let cs = to_chars(s);
    let mut out = String.new();
    let mut i = 0;
    while i < cs.len() {
        if (cs[i] as i64) >= 0x80 {
            out.push(cs[i]);
            i += 1;
            continue;
        }
        let mut run: Vec[u8] = Vec.new();
        while i < cs.len() and (cs[i] as i64) < 0x80 {
            if cs[i] == '%' and i + 2 < cs.len() + 0 and hex_digit_val(cs[i + 1]) >= 0 and hex_digit_val(cs[i + 2]) >= 0 and (cs[i + 1] as i64) < 0x80 and (cs[i + 2] as i64) < 0x80 {
                run.push((hex_digit_val(cs[i + 1]) * 16 + hex_digit_val(cs[i + 2])) as u8);
                i += 3;
            } else {
                run.push(cs[i] as i64 as u8);
                i += 1;
            }
        }
        out.push_str(utf8_replace(run));
    }
    out
}

// parse_qs(qs, strict_parsing=strict, separator=sep): whether the result
// is non-empty, or the ValueError strict parsing raises.
fn parse_qs_nonempty(qs: ref String, strict: bool, sep: char) -> Result[bool, String] {
    if qs.len() == 0 {
        return Ok(false);
    }
    let mut any = false;
    for nv in split_on(qs, sep) {
        if nv.len() > 0 or strict {
            let (_, has_eq, value) = partition(nv, '=');
            if not has_eq and strict {
                return Err(f"bad query field: {py_repr(nv)}");
            }
            if value.len() > 0 {
                any = true;
            }
        }
    }
    Ok(any)
}

// ---------------------------------------------------------------- SHA-256 and base58

fn rotr(x: u32, n: u32) -> u32 {
    (x >> n) | (x << (32 - n))
}

fn sha256_k() -> Vec[u32] {
    [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
     0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
     0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
     0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
     0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
     0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
     0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
     0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]
}

fn sha256(data: ref Vec[u8]) -> Vec[u8] {
    let k = sha256_k();
    let mut h: Vec[u32] = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
    let mut msg = data.clone();
    let bitlen = (data.len() as u64) * 8;
    msg.push(0x80);
    while msg.len() % 64 != 56 {
        msg.push(0);
    }
    for s in 0..8 {
        msg.push(((bitlen >> (56 - 8 * s)) & 0xff) as u8);
    }
    let mut off = 0;
    while off < msg.len() {
        let mut w: Vec[u32] = Vec.new();
        for t in 0..16 {
            let p = off + 4 * t;
            w.push(((msg[p] as u32) << 24) | ((msg[p + 1] as u32) << 16) | ((msg[p + 2] as u32) << 8) | (msg[p + 3] as u32));
        }
        for t in 16..64 {
            let s0 = rotr(w[t - 15], 7) ^ rotr(w[t - 15], 18) ^ (w[t - 15] >> 3);
            let s1 = rotr(w[t - 2], 17) ^ rotr(w[t - 2], 19) ^ (w[t - 2] >> 10);
            w.push(w[t - 16].wrapping_add(s0).wrapping_add(w[t - 7]).wrapping_add(s1));
        }
        let mut a = h[0];
        let mut b = h[1];
        let mut c = h[2];
        let mut d = h[3];
        let mut e = h[4];
        let mut f = h[5];
        let mut g = h[6];
        let mut hh = h[7];
        for t in 0..64 {
            let s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
            let ch = (e & f) ^ ((e ^ 0xFFFFFFFFu32) & g);
            let t1 = hh.wrapping_add(s1).wrapping_add(ch).wrapping_add(k[t]).wrapping_add(w[t]);
            let s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
            let maj = (a & b) ^ (a & c) ^ (b & c);
            let t2 = s0.wrapping_add(maj);
            hh = g;
            g = f;
            f = e;
            e = d.wrapping_add(t1);
            d = c;
            c = b;
            b = a;
            a = t1.wrapping_add(t2);
        }
        h[0] = h[0].wrapping_add(a);
        h[1] = h[1].wrapping_add(b);
        h[2] = h[2].wrapping_add(c);
        h[3] = h[3].wrapping_add(d);
        h[4] = h[4].wrapping_add(e);
        h[5] = h[5].wrapping_add(f);
        h[6] = h[6].wrapping_add(g);
        h[7] = h[7].wrapping_add(hh);
        off += 64;
    }
    let mut out: Vec[u8] = Vec.new();
    for x in h {
        out.push((x >> 24) as u8);
        out.push(((x >> 16) & 0xff) as u8);
        out.push(((x >> 8) & 0xff) as u8);
        out.push((x & 0xff) as u8);
    }
    out
}

fn b58_alphabet() -> Vec[char] {
    to_chars("123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz")
}

// The base58 number of addr as 25 big-endian bytes, or the ValueError
// alphabet.index raises on a character outside it. Addresses are at most
// 34 characters, so the number fits.
fn b58_decode25(addr: ref String) -> Result[Vec[u8], String] {
    let alpha = b58_alphabet();
    let mut out: Vec[u8] = Vec.new();
    for _ in 0..25 {
        out.push(0);
    }
    for c in addr.chars() {
        let d = find_char(alpha, c);
        if d < 0 {
            return Err("substring not found".to_string());
        }
        let mut carry = d;
        let mut k = 24;
        while k >= 0 {
            let x = (out[k] as i64) * 58 + carry;
            out[k] = (x % 256) as u8;
            carry = x / 256;
            k -= 1;
        }
    }
    Ok(out)
}

// A 21-byte payload's double SHA-256 checksum matches its last four bytes.
fn b58_checksum_ok(raw: ref Vec[u8]) -> bool {
    let mut head: Vec[u8] = Vec.new();
    for k in 0..21 {
        head.push(raw[k]);
    }
    let sum = sha256(sha256(head));
    for k in 0..4 {
        if sum[k] != raw[21 + k] {
            return false;
        }
    }
    true
}

// ---------------------------------------------------------------- re

fn cps(s: ref String) -> Vec[i64] {
    codepoints(s.bytes())
}

struct Rx {
    prog: Program,
}

fn rx(p: ref String, flags: i64) -> Rx {
    match compile(cps(p), flags) {
        Ok(prog) => Rx { prog: prog },
        Err(e) => {
            eprintln(f"bad pattern {p}: {e.msg}");
            Rx { prog: compile(cps("x".to_string()), 0).unwrap() }
        }
    }
}

// mode 0 is re.search, 1 re.match, 2 re.fullmatch
fn rx_find(r: ref Rx, s: ref String, mode: i64) -> Option[Found] {
    let mut m = new_matcher(r.prog, cps(s));
    find(mut m, r.prog, 0, false, mode)
}

fn rx_search(r: ref Rx, s: ref String) -> bool {
    rx_find(r, s, 0).is_some()
}

fn rx_match(r: ref Rx, s: ref String) -> bool {
    rx_find(r, s, 1).is_some()
}

fn rx_full(r: ref Rx, s: ref String) -> bool {
    rx_find(r, s, 2).is_some()
}

// match.groups() of re.match, or None when it does not match.
fn rx_groups(r: ref Rx, s: ref String) -> Option[Vec[Option[String]]] {
    let text = cps(s);
    let mut m = new_matcher(r.prog, text);
    let found = match find(mut m, r.prog, 0, false, 1) {
        Some(f) => f,
        None => return None,
    };
    let mut out: Vec[Option[String]] = Vec.new();
    for (a, b) in found.spans {
        if a < 0 {
            out.push(None);
        } else {
            out.push(Some(to_string(slice(text, a, b))));
        }
    }
    Some(out)
}

// Everything validators compiles, compiled once, and the tables it reads.
struct Res {
    email: Rx,
    domain_bad: Rx,
    port: Rx,
    simple_host: Rx,
    private_172: Rx,
    broadcast: Rx,
    url_user: Rx,
    url_path: Rx,
    whitespace: Rx,
    url_fragment: Rx,
    ipvfuture: Rx,
    mac: Rx,
    slug: Rx,
    base16: Rx,
    base32: Rx,
    base58: Rx,
    base64: Rx,
    visa: Rx,
    mastercard: Rx,
    amex: Rx,
    unionpay: Rx,
    diners: Rx,
    jcb: Rx,
    discover: Rx,
    mir: Rx,
    iban: Rx,
    btc_segwit: Rx,
    trx: Rx,
    bsc: Rx,
    fi_business_id: Rx,
    fi_ssn: Rx,
    fr_ssn: Rx,
    aadhar: Rx,
    pan: Rx,
    domain: Rx,
    domain_dot: Rx,
    domain_srv: Rx,
    domain_srv_dot: Rx,
    hash32: Rx,
    hash40: Rx,
    hash56: Rx,
    hash64: Rx,
    hash96: Rx,
    hash128: Rx,
    uni: UniTables,
    tlds: Vec[String],
    alpha2: Vec[String],
    alpha3: Vec[String],
    numeric: Vec[String],
    calling: Vec[String],
    currencies: Vec[String],
    symbols: Vec[String],
}

fn read_tlds() -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let body = match fs.read_to_string("data/tld.txt".to_string()) {
        Ok(b) => b,
        Err(e) => {
            eprintln(f"cannot read data/tld.txt: {e}");
            return out;
        }
    };
    let lines = split_on(body, '\n');
    let mut k = 1;
    while k < lines.len() {
        // a trailing newline leaves one empty line, which strip() keeps
        if k + 1 < lines.len() or lines[k].len() > 0 {
            out.push(py_strip_ws(lines[k]));
        }
        k += 1;
    }
    out
}

fn res() -> Res {
    let i = flag_i();
    Res {
        email: rx(pat_email(), i),
        domain_bad: rx(pat_domain_bad(), 0),
        port: rx(pat_port(), 0),
        simple_host: rx(pat_simple_host(), i),
        private_172: rx(pat_private_172(), 0),
        broadcast: rx(pat_broadcast(), 0),
        url_user: rx(pat_url_user(), i),
        url_path: rx(pat_url_path(), i),
        whitespace: rx(pat_whitespace(), 0),
        url_fragment: rx(pat_url_fragment(), i),
        ipvfuture: rx(pat_ipvfuture(), 0),
        mac: rx(pat_mac(), 0),
        slug: rx(pat_slug(), 0),
        base16: rx(pat_base16(), 0),
        base32: rx(pat_base32(), 0),
        base58: rx(pat_base58(), 0),
        base64: rx(pat_base64(), 0),
        visa: rx(pat_visa(), 0),
        mastercard: rx(pat_mastercard(), 0),
        amex: rx(pat_amex(), 0),
        unionpay: rx(pat_unionpay(), 0),
        diners: rx(pat_diners(), 0),
        jcb: rx(pat_jcb(), 0),
        discover: rx(pat_discover(), 0),
        mir: rx(pat_mir(), 0),
        iban: rx(pat_iban(), i),
        btc_segwit: rx(pat_btc_segwit(), 0),
        trx: rx(pat_trx(), 0),
        bsc: rx(pat_bsc(), 0),
        fi_business_id: rx(pat_fi_business_id(), 0),
        fi_ssn: rx(pat_fi_ssn(), flag_x()),
        fr_ssn: rx(pat_fr_ssn(), flag_x()),
        aadhar: rx(pat_aadhar(), 0),
        pan: rx(pat_pan(), 0),
        domain: rx(pat_domain(), i),
        domain_dot: rx(pat_domain_dot(), i),
        domain_srv: rx(pat_domain_srv(), i),
        domain_srv_dot: rx(pat_domain_srv_dot(), i),
        hash32: rx(pat_hash32(), i),
        hash40: rx(pat_hash40(), i),
        hash56: rx(pat_hash56(), i),
        hash64: rx(pat_hash64(), i),
        hash96: rx(pat_hash96(), i),
