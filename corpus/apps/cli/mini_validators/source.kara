// Characters str.isdigit() accepts that are not decimal digits.
fn digit_only_ranges() -> Vec[(i64, i64)] {
    let mut v: Vec[(i64, i64)] = Vec.new();
    digit_only_ranges_0(mut v);
    v
}

fn digit_only_ranges_0(v: mut ref Vec[(i64, i64)]) {
    v.push((0xB2, 0xB3)); v.push((0xB9, 0xB9)); v.push((0x1369, 0x1371)); v.push((0x19DA, 0x19DA)); v.push((0x2070, 0x2070)); v.push((0x2074, 0x2079));
    v.push((0x2080, 0x2089)); v.push((0x2460, 0x2468)); v.push((0x2474, 0x247C)); v.push((0x2488, 0x2490)); v.push((0x24EA, 0x24EA)); v.push((0x24F5, 0x24FD));
    v.push((0x24FF, 0x24FF)); v.push((0x2776, 0x277E)); v.push((0x2780, 0x2788)); v.push((0x278A, 0x2792)); v.push((0x10A40, 0x10A43)); v.push((0x10E60, 0x10E68));
    v.push((0x11052, 0x1105A)); v.push((0x1F100, 0x1F10A));
}

// Characters str.isalpha() accepts.
fn alpha_ranges() -> Vec[(i64, i64)] {
    let mut v: Vec[(i64, i64)] = Vec.new();
    alpha_ranges_0(mut v);
    v
}

fn alpha_ranges_0(v: mut ref Vec[(i64, i64)]) {
    v.push((0x41, 0x5A)); v.push((0x61, 0x7A)); v.push((0xAA, 0xAA)); v.push((0xB5, 0xB5)); v.push((0xBA, 0xBA)); v.push((0xC0, 0xD6));
    v.push((0xD8, 0xF6)); v.push((0xF8, 0x2C1)); v.push((0x2C6, 0x2D1)); v.push((0x2E0, 0x2E4)); v.push((0x2EC, 0x2EC)); v.push((0x2EE, 0x2EE));
    v.push((0x370, 0x374)); v.push((0x376, 0x377)); v.push((0x37A, 0x37D)); v.push((0x37F, 0x37F)); v.push((0x386, 0x386)); v.push((0x388, 0x38A));
