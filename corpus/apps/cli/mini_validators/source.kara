        alpha3: alpha3_codes(),
        numeric: numeric_codes(),
        calling: calling_codes(),
        currencies: currency_codes(),
        symbols: currency_symbols(),
    }
}

fn in_sorted(v: ref Vec[String], s: ref String) -> bool {
    let mut lo = 0;
    let mut hi = v.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if v[mid] == s {
            return true;
        }
        if v[mid] < s {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    false
}

// ---------------------------------------------------------------- validators

// What a validator's body gives the @validator wrapper: Ok with its truth,
// or Err with the message of the ValueError, TypeError or UnicodeError that
// stopped it. Called from another validator, the ValidationError it gets
// back is simply false.
fn truthy(r: own Result[bool, String]) -> bool {
    match r {
        Ok(b) => b,
        Err(_) => false,
    }
}

fn count_char(s: ref String, c: char) -> i64 {
    let mut n = 0;
    for x in s.chars() {
        if x == c {
            n += 1;
        }
    }
    n
}

fn has_text(s: ref String, sub: ref String) -> bool {
    count_sub(s, sub) > 0
}

// hostname()'s keyword arguments, which url() and email() pass along.
#[derive(Clone)]
struct HostOpts {
    skip6: bool,
    skip4: bool,
    may_have_port: bool,
    maybe_simple: bool,
    consider_tld: bool,
    want_private: Option[bool],
    rfc_1034: bool,
    rfc_2782: bool,
}

fn host_defaults() -> HostOpts {
    HostOpts {
        skip6: false,
        skip4: false,
        may_have_port: true,
        maybe_simple: true,
        consider_tld: false,
        want_private: None,
        rfc_1034: false,
        rfc_2782: false,
    }
}

// ------------------------------------------------- email, domain, hostname

fn v_email(re: ref Res, value: ref String, ipv6: bool, ipv4: bool, simple: bool, rfc_1034: bool, rfc_2782: bool) -> Result[bool, String] {
    if value.len() == 0 or count_char(value, '@') != 1 {
        return Ok(false);
    }
    let (user, dom0) = rsplit_once(value, '@');
    if clen(user) > 64 or clen(dom0) > 253 {
        return Ok(false);
    }
    let mut dom = dom0;
    if ipv6 or ipv4 {
        if dom.starts_with("[") and dom.ends_with("]") {
            dom = rstrip_char(lstrip_char(dom, '['), ']');
        } else {
            return Ok(false);
        }
    }
    if not rx_match(re.email, user) {
        return Ok(false);
    }
    let o = HostOpts {
        skip6: not ipv6,
        skip4: not ipv4,
        may_have_port: false,
        maybe_simple: simple,
        consider_tld: false,
        want_private: None,
        rfc_1034: rfc_1034,
        rfc_2782: rfc_2782,
    };
    Ok(truthy(v_hostname(re, dom, o)))
}

fn tld_ok(re: ref Res, tld: ref String) -> bool {
    for p in ["COM", "ORG", "RU", "DE", "NET", "BR", "UK", "JP", "FR", "IT", "ONION"] {
        if tld == p {
            return true;
        }
    }
    for t in re.tlds {
        if t == tld {
            return true;
        }
    }
    false
}

// value.encode('idna') on its ASCII path: every label but the last must be
// 1 to 63 characters, and the last at most 63.
fn idna_ok(value: ref String) -> bool {
    if not str_isascii(value) {
        return false;
    }
    let labels = split_on(value, '.');
    let last = labels.len() - 1;
    for k in 0..labels.len() {
        let n = labels[k].len();
        if n >= 64 or (k < last and n == 0) {
            return false;
        }
    }
    true
}

fn v_domain(re: ref Res, value: ref String, consider_tld: bool, rfc_1034: bool, rfc_2782: bool) -> Result[bool, String] {
    if value.len() == 0 {
        return Ok(false);
    }
    if consider_tld {
        let (_, _, last) = rpartition(rstrip_char(value, '.'), '.');
        if not tld_ok(re, last.to_uppercase()) {
            return Ok(false);
        }
    }
    if not idna_ok(value) {
        return Err(f"Unable to encode/decode {value}");
    }
    if clen(rstrip_char(value, '.')) > 253 {
        return Ok(false);
    }
    if rx_search(re.domain_bad, value) {
        return Ok(false);
    }
    if rfc_2782 {
        if rfc_1034 {
            return Ok(rx_match(re.domain_srv_dot, value));
        }
        return Ok(rx_match(re.domain_srv, value));
    }
    if rfc_1034 {
        return Ok(rx_match(re.domain_dot, value));
    }
    Ok(rx_match(re.domain, value))
}

fn port_ok(re: ref Res, port: ref String) -> bool {
    let p = f":{port}";
    rx_match(re.port, p)
}

fn port_validator(re: ref Res, value: ref String) -> Option[String] {
    if count_sub(value, "]:") == 1 {
        let (host, port) = rsplit_once(value, ':');
        if port_ok(re, port) {
            return Some(rstrip_char(lstrip_char(host, '['), ']'));
        }
    }
    if count_char(value, ':') == 1 {
        let (host, port) = rsplit_once(value, ':');
        if port_ok(re, port) {
            return Some(host);
        }
    }
    None
}

fn matches_simple(re: ref Res, host: ref String, o: ref HostOpts) -> bool {
    if not o.maybe_simple {
        return false;
    }
    if o.rfc_1034 and host.ends_with(".") {
        return rx_match(re.simple_host, cslice(host, 0, -1));
    }
    rx_match(re.simple_host, host)
}

fn host_check(re: ref Res, h: ref String, o: ref HostOpts) -> bool {
    if matches_simple(re, h, o) {
        return true;
    }
    if truthy(v_domain(re, h, o.consider_tld, o.rfc_1034, o.rfc_2782)) {
        return true;
    }
    if not o.skip4 and truthy(v_ipv4(re, h, false, false, o.want_private, true)) {
        return true;
    }
    not o.skip6 and truthy(v_ipv6(h, false, false, true))
}

fn v_hostname(re: ref Res, value: ref String, o: ref HostOpts) -> Result[bool, String] {
    if value.len() == 0 {
        return Ok(false);
    }
    if o.may_have_port {
        if let Some(h) = port_validator(re, value) {
            if h.len() > 0 {
                return Ok(host_check(re, h, o));
            }
        }
    }
    Ok(host_check(re, value, o))
}

// ------------------------------------------------------------ ip addresses

fn check_private(re: ref Res, value: ref String, want_private: Option[bool]) -> bool {
    let want = match want_private {
        Some(p) => p,
        None => return true,
    };
    let mut hit = false;
    for p in ["10.", "192.168.", "169.254.", "127.", "0.0.0.0"] {
        if value.starts_with(p) {
            hit = true;
        }
    }
    if hit or rx_match(re.private_172, value) or rx_match(re.broadcast, value) {
        want
    } else {
        not want
    }
}

fn v_ipv4(re: ref Res, value: ref String, cidr: bool, strict: bool, want_private: Option[bool], host_bit: bool) -> Result[bool, String] {
    if value.len() == 0 {
        return Ok(false);
    }
    if cidr {
        if strict and count_char(value, '/') != 1 {
            return Ok(false);
        }
        return Ok(v4_network(value, not host_bit) and check_private(re, value, want_private));
    }
    Ok(v4_addr(value).is_some() and check_private(re, value, want_private))
}

fn v_ipv6(value: ref String, cidr: bool, strict: bool, host_bit: bool) -> Result[bool, String] {
    if value.len() == 0 {
        return Ok(false);
    }
    if cidr {
        if strict and count_char(value, '/') != 1 {
            return Ok(false);
        }
        return Ok(v6_network(value, not host_bit));
    }
    Ok(v6_addr(value).is_some())
}

// ------------------------------------------------------------- url and uri

fn scheme_ok(s: ref String) -> bool {
    for p in ["file", "ftp", "ftps", "git", "http", "https", "irc", "rtmp", "rtmps", "rtsp", "sftp", "ssh", "telnet"] {
        if s == p {
            return true;
        }
    }
    false
}

fn confirm_skip(value: ref String, skip6: bool) -> bool {
    skip6 or count_char(value, ':') < 2 or not value.starts_with("[")
}

fn auth_ok(re: ref Res, value: ref String) -> bool {
    if value.len() == 0 {
        return true;
    }
    let colons = count_char(value, ':');
    if colons > 1 {
        return rx_match(re.url_user, unquote(value));
    }
    if colons < 1 {
        return rx_match(re.url_user, value);
    }
    let (user, pw) = rsplit_once(value, ':');
    rx_match(re.url_user, user) and not has_char(pw, '/') and not has_char(pw, '?') and not has_char(pw, '#') and not has_char(pw, '@')
}

fn netloc_ok(re: ref Res, value: ref String, o: ref HostOpts) -> bool {
    let ats = count_char(value, '@');
    if value.len() == 0 or ats > 1 {
        return false;
    }
    let (auth, host) = if ats < 1 { (String.new(), value.clone()) } else { rsplit_once(value, '@') };
    let skip = confirm_skip(host, o.skip6);
    let h = if skip or has_text(value, "]:") { host.clone() } else { replace_first(lstrip_char(host, '['), ']', "") };
    let mut o2 = o.clone();
    o2.skip6 = skip;
    let ok = truthy(v_hostname(re, h, o2));
    if ats < 1 {
        ok
    } else {
        ok and auth_ok(re, auth)
    }
}

fn optionals_ok(re: ref Res, sp: ref SplitUrl, strict: bool) -> Result[bool, String] {
    let mut ok = true;
    if sp.path.len() > 0 and not rx_match(re.url_path, sp.path) {
        ok = false;
    }
    if sp.query.len() > 0 {
        if parse_qs_nonempty(sp.query, strict, '&')? {
            parse_qs_nonempty(sp.query, strict, ';')?;
        }
    }
    if sp.fragment.len() > 0 and not rx_full(re.url_fragment, sp.fragment) {
        ok = false;
    }
    Ok(ok)
}

fn v_url(re: ref Res, value: ref String, o: ref HostOpts, strict_query: bool) -> Result[bool, String] {
    if value.len() == 0 or rx_search(re.whitespace, value) {
        return Ok(false);
    }
    let sp = match urlsplit(re, value) {
        Ok(s) => s,
        Err(_) => return Ok(false),
    };
    let local = sp.scheme == "file" and (sp.netloc.len() == 0 or sp.netloc == "localhost");
    if not scheme_ok(sp.scheme) {
        return Ok(false);
    }
    if not local and not netloc_ok(re, sp.netloc, o) {
        return Ok(false);
    }
    optionals_ok(re, sp, strict_query)
}

// url()'s defaults, as HostOpts: simple_host is off.
fn url_defaults() -> HostOpts {
    let mut o = host_defaults();
    o.maybe_simple = false;
    o
}

fn telnet_ok(re: ref Res, value: ref String) -> bool {
    for c in value.chars() {
        if str_isspace_char(c) or not is_printable(c as i64) {
            return false;
        }
    }
    let sp = match urlsplit(re, value) {
        Ok(s) => s,
        Err(_) => return false,
    };
    if sp.scheme != "telnet" or sp.netloc.len() == 0 or sp.query.len() > 0 or sp.fragment.len() > 0 {
        return false;
    }
    if sp.path.len() > 0 and sp.path != "/" {
        return false;
    }
    let netloc = if has_char(sp.netloc, '@') {
        let (_, h) = rsplit_once(sp.netloc, '@');
        h
    } else {
        sp.netloc.clone()
    };
    truthy(v_hostname(re, netloc, host_defaults()))
}

fn v_uri(re: ref Res, value: ref String) -> Result[bool, String] {
    if value.len() == 0 {
        return Ok(false);
    }
    for p in ["ftp", "ftps", "git", "http", "https", "irc", "rtmp", "rtmps", "rtsp", "sftp", "ssh"] {
        if value.starts_with(p) {
            return Ok(truthy(v_url(re, value, url_defaults(), true)));
        }
    }
    if value.starts_with("mailto:") {
        return Ok(truthy(v_email(re, cslice(value, 7, clen(value)), false, false, false, false, false)));
    }
    if value.starts_with("file:") {
        return Ok(value.starts_with("file:///"));
    }
    if value.starts_with("ipfs:") {
        return Ok(value.starts_with("ipfs://"));
    }
    for p in ["magnet:?", "tel:", "data:", "urn:", "urc:"] {
        if value.starts_with(p) {
            return Ok(true);
        }
    }
    if value.starts_with("telnet:") {
        return Ok(telnet_ok(re, value));
    }
    Ok(false)
}

// ----------------------------------------------------------------- formats

fn v_mac(re: ref Res, value: ref String) -> bool {
    if has_char(value, ':') and has_char(value, '-') {
        return false;
    }
    value.len() > 0 and rx_match(re.mac, value)
}

// str.strip(chars) for a set of characters.
fn strip_set(s: ref String, set: ref String) -> String {
    let cs = to_chars(s);
    let mut a = 0;
    let mut b = cs.len();
    while a < b and has_char(set, cs[a]) {
        a += 1;
    }
    while b > a and has_char(set, cs[b - 1]) {
        b -= 1;
    }
    text(cs, a, b)
}

// uuid.UUID(value) succeeds.
fn v_uuid(value: ref String) -> bool {
    if value.len() == 0 {
        return false;
    }
    let h = replace_all(replace_all(value, "urn:", ""), "uuid:", "");
    let h = replace_all(strip_set(h, "{}"), "-", "");
    if clen(h) != 32 {
        return false;
    }
    let (parses, negative) = py_hex_ok(h);
    parses and not negative
}

fn full_or_false(r: ref Rx, value: ref String) -> bool {
    value.len() > 0 and rx_full(r, value)
}

// ---------------------------------------------------------------- payments

fn card_ok(value: ref String) -> bool {
    if value.len() == 0 {
        return false;
    }
    let mut ds: Vec[i64] = Vec.new();
    for c in value.chars() {
        let n = c as i64;
        if not is_decimal(n) {
            return false;
        }
        ds.push(decimal_value(n));
    }
    let mut total = 0;
    let mut k = ds.len() - 1;
    let mut odd = true;
    while k >= 0 {
        if odd {
            total += ds[k];
        } else {
            let d = 2 * ds[k];
            total += d / 10 + d % 10;
        }
        odd = not odd;
        k -= 1;
    }
    total % 10 == 0
}

fn brand_ok(r: ref Rx, value: ref String, lens: ref Vec[i64]) -> bool {
    if not card_ok(value) {
        return false;
    }
    let n = clen(value);
    let mut fits = false;
    for l in lens {
        if l == n {
            fits = true;
        }
    }
    fits and rx_match(r, value)
}

fn upper_char(c: char) -> char {
    let u = to_chars(c.to_string().to_uppercase());
    if u.len() == 1 { u[0] } else { c }
}

fn v_iban(re: ref Res, u: ref UniTables, value: ref String) -> bool {
    if value.len() == 0 or not rx_match(re.iban, value) {
        return false;
    }
    let n = clen(value);
    let moved = f"{cslice(value, 4, n)}{cslice(value, 0, 4)}";
    let mut digits = String.new();
    for c in moved.chars() {
        if str_isdigit(u, c.to_string()) {
            digits.push(c);
        } else {
            let v = 10 + upper_char(c) as i64 - 65;
            digits.push_str(f"{v}");
        }
    }
    let mut m = 0;
    for c in digits.chars() {
        m = (m * 10 + decimal_value(c as i64)) % 97;
    }
    m == 1
}

fn cusip_ok(value: ref String) -> bool {
    let cs = to_chars(value);
    if cs.len() != 9 or cs[8] < '0' or cs[8] > '9' {
        return false;
    }
    let mut check = 0;
    for idx in 0..9 {
        let c = cs[idx];
        let mut v = 0;
        if c >= '0' and c <= '9' {
            v = c as i64 - 48;
        } else if c >= 'A' and c <= 'Z' {
            v = 10 + c as i64 - 65;
        } else if c >= 'a' and c <= 'z' {
            v = 10 + c as i64 - 97;
        } else if c == '*' {
            v = 36;
        } else if c == '@' {
            v = 37;
        } else if c == '#' {
            v = 38;
        } else {
            return false;
        }
        if idx % 2 == 1 {
            v += v;
        }
        check = check + v / 10 + v % 10;
    }
    check % 10 == 0
}

fn isin_ok(value: ref String) -> bool {
    let cs = to_chars(value);
    if cs.len() != 12 or not is_decimal(cs[11] as i64) {
        return false;
    }
    let mut digits = String.new();
    for idx in 0..12 {
        let c = cs[idx];
        if c >= '0' and c <= '9' and idx > 1 {
            digits.push(c);
        } else if c >= 'A' and c <= 'Z' {
            digits.push_str(f"{10 + c as i64 - 65}");
        } else if c >= 'a' and c <= 'z' {
            digits.push_str(f"{10 + c as i64 - 97}");
        } else {
            return false;
        }
    }
    let ds = to_chars(digits);
    let mut check = 0;
    let mut idx = 0;
    let mut k = ds.len() - 1;
    while k >= 0 {
        let mut v = ds[k] as i64 - 48;
        if idx % 2 == 1 {
            v += v;
        }
        check += v / 10 + v % 10;
        idx += 1;
        k -= 1;
    }
    check % 10 == 0
}

fn sedol_ok(value: ref String) -> bool {
    let cs = to_chars(value);
    if cs.len() != 7 or cs[6] < '0' or cs[6] > '9' {
        return false;
    }
    let weights = [1, 3, 1, 7, 3, 9, 1];
    let mut check = 0;
    for idx in 0..7 {
        let c = cs[idx];
        if c == 'A' or c == 'E' or c == 'I' or c == 'O' or c == 'U' {
            return false;
        }
        let mut v = 0;
        if c >= '0' and c <= '9' {
            v = c as i64 - 48;
        } else if c >= 'A' and c <= 'Z' {
            v = 10 + c as i64 - 65;
        } else {
            return false;
        }
        check += v * weights[idx];
    }
    check % 10 == 0
}

// ------------------------------------------------------- crypto addresses

fn v_btc(re: ref Res, value: ref String) -> Result[bool, String] {
    if value.len() == 0 {
        return Ok(false);
    }
    let head = cslice(value, 0, 2);
    if head == "bc" or head == "tb" {
        return Ok(rx_match(re.btc_segwit, value));
    }
    let n = clen(value);
    if n < 25 or n > 34 {
        return Ok(false);
    }
    let raw = b58_decode25(value)?;
    Ok(b58_checksum_ok(raw))
}

fn v_trx(re: ref Res, value: ref String) -> bool {
    if value.len() == 0 or not rx_match(re.trx, value) or clen(value) != 34 {
        return false;
    }
    let raw = match b58_decode25(value) {
        Ok(r) => r,
        Err(_) => return false,
    };
    raw[0] == 65 and b58_checksum_ok(raw)
}

// ------------------------------------------------------ ranges and lengths

// A bound of between(): AbsMin, AbsMax, or a value.
enum Bound {
    Lo,
    Hi,
    V(Val),
}

fn type_name(v: ref Val) -> String {
    match v {
        Val.Null => "NoneType".to_string(),
        Val.Bool(_) => "bool".to_string(),
        Val.Int(_) => "int".to_string(),
        Val.Float(_) => "float".to_string(),
        Val.Str(_) => "str".to_string(),
        Val.List(_) => "list".to_string(),
        _ => "dict".to_string(),
    }
}

fn num_of(v: ref Val) -> Option[f64] {
    match v {
        Val.Bool(b) => Some(if b { 1.0 } else { 0.0 }),
        Val.Int(n) => Some(n as f64),
        Val.Float(x) => Some(x),
        _ => None,
    }
}

// a OP b for two plain values: -1, 0 or 1, or None when Python would raise
// a TypeError.
fn compare(a: ref Val, b: ref Val) -> Option[i64] {
    if let (Some(x), Some(y)) = (num_of(a), num_of(b)) {
        return Some(if x < y { -1 } else if x > y { 1 } else { 0 });
    }
    if let (Val.Str(x), Val.Str(y)) = (a, b) {
        return Some(if x < y { -1 } else if x > y { 1 } else { 0 });
    }
    None
}

// a <= b, with AbsMin below and AbsMax above everything.
fn bound_le(a: ref Bound, b: ref Bound) -> Result[bool, String] {
    match (a, b) {
        (Bound.Lo, _) => Ok(true),
        (_, Bound.Hi) => Ok(true),
        (Bound.V(x), Bound.V(y)) => match compare(x, y) {
            Some(c) => Ok(c <= 0),
            None => Err(f"'<=' not supported between instances of '{type_name(x)}' and '{type_name(y)}'"),
        },
        _ => Ok(false),
    }
}

// min_val > max_val raises; AbsMin and AbsMax are never greater.
fn bound_order(lo: ref Bound, hi: ref Bound) -> Result[(), String] {
    match (lo, hi) {
        (Bound.V(x), Bound.V(y)) => match compare(x, y) {
            Some(c) => {
                if c > 0 {
                    return Err("`min_val` cannot be greater than `max_val`".to_string());
                }
                Ok(())
            }
            None => Err("Comparison type mismatch".to_string()),
        },
        _ => Ok(()),
    }
}

fn bound_of(v: ref Option[Val], missing: own Bound) -> Bound {
    match v {
        Some(Val.Null) => missing,
        Some(x) => Bound.V(x.clone()),
        None => missing,
    }
}

fn v_between(value: ref Val, min_val: ref Option[Val], max_val: ref Option[Val]) -> Result[bool, String] {
    if let Val.Null = value {
        return Ok(false);
    }
    let lo = bound_of(min_val, Bound.Lo);
    let hi = bound_of(max_val, Bound.Hi);
    bound_order(lo, hi)?;
    let v = Bound.V(value.clone());
    if not bound_le(lo, v)? {
        return Ok(false);
    }
    bound_le(v, hi)
}

fn negative(v: ref Option[Val]) -> bool {
    match v {
        Some(Val.Int(n)) => n < 0,
        Some(Val.Float(x)) => x < 0.0,
        _ => false,
    }
}

fn v_length(value: ref Val, min_val: ref Option[Val], max_val: ref Option[Val]) -> Result[bool, String] {
    if negative(min_val) {
        return Err("Length cannot be negative. `min_val` is less than zero.".to_string());
    }
    if negative(max_val) {
        return Err("Length cannot be negative. `max_val` is less than zero.".to_string());
    }
    let n = match value {
        Val.Str(s) => clen(s),
        other => return Err(f"object of type '{type_name(other)}' has no len()"),
    };
    Ok(truthy(v_between(Val.Int(n), min_val, max_val)))
}

// ---------------------------------------------------------------------- cron

fn cron_item(item: ref String, lo: i64, hi: i64) -> bool {
    let mut base = item.clone();
    if has_char(item, '/') {
        let (b, _, step) = partition(item, '/');
        if not str_isdecimal(step) or py_int_any(step).unwrap_or(0) < 1 {
            return false;
        }
        base = b;
    }
    if base == "*" {
        return true;
    }
    if has_char(base, '-') {
        let parts = split_on(base, '-');
        if parts.len() != 2 or not str_isdecimal(parts[0]) or not str_isdecimal(parts[1]) {
            return false;
        }
        let start = py_int_any(parts[0]).unwrap_or(-1);
        let end = py_int_any(parts[1]).unwrap_or(-1);
        return lo <= start and start <= hi and lo <= end and end <= hi and start <= end;
    }
    if str_isdecimal(base) {
        let n = py_int_any(base).unwrap_or(-1);
        return lo <= n and n <= hi;
    }
    false
}

fn cron_component(c: ref String, lo: i64, hi: i64) -> bool {
    for item in split_on(c, ',') {
        if not cron_item(item, lo, hi) {
            return false;
        }
    }
    true
}

fn v_cron(value: ref String) -> Result[bool, String] {
    if value.len() == 0 {
        return Ok(false);
    }
    let parts = py_split_ws(py_strip_ws(value));
    if parts.len() != 5 {
        return Err("Badly formatted cron string".to_string());
    }
    let limits = [(0, 59), (0, 23), (1, 31), (1, 12), (0, 7)];
    for k in 0..5 {
        let (lo, hi) = limits[k];
        if not cron_component(parts[k], lo, hi) {
            return Ok(false);
        }
    }
    Ok(true)
}

// ------------------------------------------------- countries and currencies

fn code_type(u: ref UniTables, value: ref String) -> String {
    if str_isdecimal(value) {
        return "numeric".to_string();
    }
    if str_isalpha(u, value) {
        let n = clen(value);
        if n == 2 {
            return "alpha2".to_string();
        }
        if n == 3 {
            return "alpha3".to_string();
        }
    }
    "invalid".to_string()
}

fn v_country(re: ref Res, value: ref String, iso_format: ref String, ignore_case: bool) -> bool {
    if value.len() == 0 {
        return false;
    }
    let n = clen(value);
    if n < 2 or n > 3 {
        return false;
    }
    let mut fmt = iso_format.clone();
    if fmt == "auto" {
        fmt = code_type(re.uni, value);
        if fmt == "invalid" {
            return false;
        }
    }
    let key = if ignore_case { value.to_uppercase() } else { value.clone() };
    if fmt == "alpha2" {
        return in_sorted(re.alpha2, key);
    }
    if fmt == "alpha3" {
        return in_sorted(re.alpha3, key);
    }
    fmt == "numeric" and in_sorted(re.numeric, value)
}

fn v_currency(re: ref Res, value: ref String, skip_symbols: bool, ignore_case: bool) -> bool {
    if value.len() == 0 {
        return false;
    }
    if not skip_symbols and in_sorted(re.symbols, value) {
        return true;
    }
    if clen(value) != 3 {
        return false;
    }
    let key = if ignore_case { value.to_uppercase() } else { value.clone() };
    in_sorted(re.currencies, key)
}

// ------------------------------------------------------------ national ids

fn nif_nie(u: ref UniTables, value: ref String, nie: bool) -> Result[bool, String] {
    if clen(value) != 9 {
        return Ok(false);
    }
    let cs = to_chars(value.to_uppercase());
    if cs.len() < 9 {
        return Ok(false);
    }
    let table = to_chars("TRWAGMYFPDXBNJZSQVHLCKE");
    let first = cs[0];
    let lead = if nie {
        if first == 'X' { "0".to_string() } else if first == 'Y' { "1".to_string() } else if first == 'Z' { "2".to_string() } else { first.to_string() }
    } else {
        if first == 'L' or first == 'M' or first == 'K' { "0".to_string() } else { first.to_string() }
    };
    let numbers = f"{lead}{text(cs, 1, 8)}";
    if not str_isdigit(u, numbers) {
        return Ok(false);
    }
    let n = match py_int_any(numbers) {
        Some(n) => n,
        None => return Err(int_error(numbers)),
    };
    Ok(cs[8] == table[n % 23])
}

fn v_es_nif(u: ref UniTables, value: ref String) -> Result[bool, String] {
    nif_nie(u, value, false)
}

fn v_es_nie(u: ref UniTables, value: ref String) -> Result[bool, String] {
    if value.len() > 0 {
        let c = char_at(value, 0);
        if c == 'X' or c == 'Y' or c == 'Z' {
            return nif_nie(u, value, true);
        }
    }
    Ok(false)
}

fn v_es_cif(u: ref UniTables, value: ref String) -> Result[bool, String] {
    if value.len() == 0 or clen(value) != 9 {
        return Ok(false);
    }
    let cs = to_chars(value.to_uppercase());
    if cs.len() < 9 {
        return Ok(false);
    }
    let table = to_chars("JABCDEFGHI");
    let first = cs[0];
    let body = text(cs, 1, 8);
    let control = cs[8];
    if not str_isdigit(u, body) {
        return Ok(false);
    }
    let mut total = 0;
    let mut index = 0;
    for c in body.chars() {
        let one = c.to_string();
        let n = match py_int_any(one) {
            Some(n) => n,
            None => return Err(int_error(one)),
        };
        if index % 2 == 0 {
            let d = n * 2;
            total += d / 10 + d % 10;
        } else {
            total += n;
        }
        index += 1;
    }
    let res = (10 - total % 10) % 10;
    let digit = chr(48 + res);
    if has_char("ABEH", first) {
        return Ok(digit == control);
    }
    if has_char("PSQW", first) {
        return Ok(table[res] == control);
    }
    Ok(has_char("CDFGJNRUV", first) and (control == digit or control == table[res]))
}

fn v_es_doi(u: ref UniTables, value: ref String) -> bool {
    truthy(v_es_nie(u, value)) or truthy(v_es_nif(u, value)) or truthy(v_es_cif(u, value))
}

fn v_fi_business_id(re: ref Res, value: ref String) -> bool {
    if value.len() == 0 or not rx_match(re.fi_business_id, value) {
        return false;
    }
    let cs = to_chars(value);
    let factors = [7, 9, 10, 5, 8, 4, 2];
    let mut total = 0;
    for k in 0..7 {
        total += factors[k] * (cs[k] as i64 - 48);
    }
    let checksum = cs[8] as i64 - 48;
    let modulo = total % 11;
    11 - modulo == checksum or (modulo == checksum and checksum == 0)
}

fn grp_text(g: ref Vec[Option[String]], k: i64) -> String {
    match g[k] {
        Some(s) => s.clone(),
        None => String.new(),
    }
}

fn v_fi_ssn(re: ref Res, value: ref String, allow_temporal: bool) -> bool {
    if value.len() == 0 {
        return false;
    }
    let g = match rx_groups(re.fi_ssn, value) {
        Some(g) => g,
        None => return false,
    };
    let marks = to_chars("0123456789ABCDEFHJKLMNPRSTUVWXY");
    let date = grp_text(g, 0);
    let serial = grp_text(g, 4);
    let mark = grp_text(g, 6);
    let checksum = py_int_any(f"{date}{serial}").unwrap_or(0);
    let s = py_int_any(serial).unwrap_or(0);
    s >= 2 and (allow_temporal or s <= 899) and marks[checksum % 31].to_string() == mark
}

fn fr_department_ok(value: ref Val) -> bool {
    let n = match value {
        Val.Str(s) => {
            if s.len() == 0 {
                return false;
            }
            if s == "2A" or s == "2B" {
                return true;
            }
            match py_int_any(s) {
                Some(n) => n,
                None => return false,
            }
        }
        Val.Int(n) => n,
        Val.Bool(b) => if b { 1 } else { 0 },
        _ => return false,
    };
    if n == 0 {
        return false;
    }
    (1 <= n and n <= 19) or (21 <= n and n <= 95) or (971 <= n and n <= 976)
}

fn v_fr_ssn(re: ref Res, value: ref String) -> bool {
    if value.len() == 0 {
        return false;
    }
    let g = match rx_groups(re.fr_ssn, value) {
        Some(g) => g,
        None => return false,
    };
    let dept = grp_text(g, 3);
    if dept != "99" and not fr_department_ok(Val.Str(dept.clone())) {
        return false;
    }
    let key = match g[6] {
        Some(k) => k.clone(),
        None => return true,
    };
    if clen(dept) == clen(grp_text(g, 4)) {
        return false;
    }
    let mut joined = String.new();
    for k in 0..6 {
        if k == 3 and dept == "2A" {
            joined.push_str("19");
        } else if k == 3 and dept == "2B" {
            joined.push_str("18");
        } else {
            joined.push_str(grp_text(g, k));
        }
    }
    let digits = py_int_any(joined).unwrap_or(0);
    py_int_any(key).unwrap_or(-1) == 97 - digits % 97
}

fn v_ru_inn(value: ref String) -> bool {
    if value.len() == 0 {
        return false;
    }
    let mut d: Vec[i64] = Vec.new();
    for c in value.chars() {
        let n = c as i64;
        if not is_decimal(n) {
            return false;
        }
        d.push(decimal_value(n));
    }
    if d.len() == 10 {
        let w = [2, 4, 10, 3, 5, 9, 4, 6, 8, 0];
        let mut s = 0;
        for k in 0..10 {
            s += d[k] * w[k];
        }
        let c = s % 11;
        return if c > 9 { c % 10 == d[9] } else { c == d[9] };
    }
    if d.len() == 12 {
        let w1 = [7, 2, 4, 10, 3, 5, 9, 4, 6, 8, 0, 0];
        let w2 = [3, 7, 2, 4, 10, 3, 5, 9, 4, 6, 8, 0];
        let mut s1 = 0;
        let mut s2 = 0;
        for k in 0..12 {
            s1 += d[k] * w1[k];
            s2 += d[k] * w2[k];
        }
        let c1 = s1 % 11;
        let c2 = s2 % 11;
        if c1 > 9 {
            return c1 % 10 == d[10];
        }
        if c2 > 9 {
            return c1 == d[10] and c2 % 10 == d[11];
        }
        return c2 == d[11];
    }
    false
}

// ---------------------------------------------------------------- the jobs

fn val_repr(v: ref Val) -> String {
    match v {
        Val.Null => "None".to_string(),
        Val.Bool(b) => if b { "True".to_string() } else { "False".to_string() },
        Val.Int(n) => f"{n}",
        Val.Float(x) => float_repr(x),
        Val.Str(s) => py_repr(s),
        _ => "?".to_string(),
    }
}

fn kw_get(kw: ref Vec[Member], name: Str) -> Option[Val] {
    member(kw, name.to_string())
}

fn kw_bool(kw: ref Vec[Member], name: Str, default: bool) -> bool {
    match kw_get(kw, name) {
        Some(Val.Bool(b)) => b,
        _ => default,
    }
}

fn kw_opt_bool(kw: ref Vec[Member], name: Str) -> Option[bool] {
    match kw_get(kw, name) {
        Some(Val.Bool(b)) => Some(b),
        _ => None,
    }
}

fn kw_str(kw: ref Vec[Member], name: Str, default: Str) -> String {
    match kw_get(kw, name) {
        Some(Val.Str(s)) => s,
        _ => default.to_string(),
    }
}

// hostname()'s and url()'s keywords over their defaults.
fn host_opts_of(kw: ref Vec[Member], base: own HostOpts, simple_key: Str) -> HostOpts {
    HostOpts {
        skip6: kw_bool(kw, "skip_ipv6_addr", base.skip6),
        skip4: kw_bool(kw, "skip_ipv4_addr", base.skip4),
        may_have_port: kw_bool(kw, "may_have_port", base.may_have_port),
        maybe_simple: kw_bool(kw, simple_key, base.maybe_simple),
        consider_tld: kw_bool(kw, "consider_tld", base.consider_tld),
        want_private: kw_opt_bool(kw, "private"),
        rfc_1034: kw_bool(kw, "rfc_1034", base.rfc_1034),
        rfc_2782: kw_bool(kw, "rfc_2782", base.rfc_2782),
    }
}

// One validator over the job's arguments, as the wrapper sees it.
fn dispatch(re: ref Res, name: ref String, args: ref Vec[Val], kw: ref Vec[Member]) -> Result[bool, String] {
    let v0 = args[0].clone();
    let s = json_text(v0);
    if name == "email" {
        return v_email(re, s, kw_bool(kw, "ipv6_address", false), kw_bool(kw, "ipv4_address", false), kw_bool(kw, "simple_host", false), kw_bool(kw, "rfc_1034", false), kw_bool(kw, "rfc_2782", false));
    }
    if name == "domain" {
        return v_domain(re, s, kw_bool(kw, "consider_tld", false), kw_bool(kw, "rfc_1034", false), kw_bool(kw, "rfc_2782", false));
    }
    if name == "hostname" {
        return v_hostname(re, s, host_opts_of(kw, host_defaults(), "maybe_simple"));
    }
    if name == "ipv4" {
        return v_ipv4(re, s, kw_bool(kw, "cidr", true), kw_bool(kw, "strict", false), kw_opt_bool(kw, "private"), kw_bool(kw, "host_bit", true));
    }
    if name == "ipv6" {
        return v_ipv6(s, kw_bool(kw, "cidr", true), kw_bool(kw, "strict", false), kw_bool(kw, "host_bit", true));
    }
    if name == "url" {
        return v_url(re, s, host_opts_of(kw, url_defaults(), "simple_host"), kw_bool(kw, "strict_query", true));
    }
    if name == "uri" {
        return v_uri(re, s);
    }
    if name == "mac_address" {
        return Ok(v_mac(re, s));
    }
    if name == "uuid" {
        return Ok(v_uuid(s));
    }
    if name == "slug" {
        return Ok(rx_full(re.slug, s));
    }
    if name == "md5" {
        return Ok(full_or_false(re.hash32, s));
    }
    if name == "sha1" {
        return Ok(full_or_false(re.hash40, s));
    }
    if name == "sha224" {
        return Ok(full_or_false(re.hash56, s));
    }
    if name == "sha256" {
        return Ok(full_or_false(re.hash64, s));
    }
    if name == "sha384" {
        return Ok(full_or_false(re.hash96, s));
    }
    if name == "sha512" {
        return Ok(full_or_false(re.hash128, s));
    }
    if name == "base16" {
        return Ok(full_or_false(re.base16, s));
    }
    if name == "base32" {
        return Ok(full_or_false(re.base32, s));
    }
    if name == "base58" {
        return Ok(full_or_false(re.base58, s));
    }
    if name == "base64" {
        return Ok(full_or_false(re.base64, s));
    }
    if name == "card_number" {
        return Ok(card_ok(s));
    }
    if name == "visa" {
        return Ok(brand_ok(re.visa, s, [16]));
    }
    if name == "mastercard" {
        return Ok(brand_ok(re.mastercard, s, [16]));
    }
    if name == "amex" {
        return Ok(brand_ok(re.amex, s, [15]));
    }
    if name == "unionpay" {
        return Ok(brand_ok(re.unionpay, s, [16]));
    }
    if name == "diners" {
        return Ok(brand_ok(re.diners, s, [14, 16]));
    }
    if name == "jcb" {
        return Ok(brand_ok(re.jcb, s, [16]));
    }
    if name == "discover" {
        return Ok(brand_ok(re.discover, s, [16]));
    }
    if name == "mir" {
        return Ok(brand_ok(re.mir, s, [16]));
    }
    if name == "iban" {
        return Ok(v_iban(re, re.uni, s));
    }
    if name == "cusip" {
        return Ok(cusip_ok(s));
    }
    if name == "isin" {
        return Ok(isin_ok(s));
    }
    if name == "sedol" {
        return Ok(sedol_ok(s));
    }
    if name == "btc_address" {
        return v_btc(re, s);
    }
    if name == "trx_address" {
        return Ok(v_trx(re, s));
    }
    if name == "bsc_address" {
        return Ok(full_or_false(re.bsc, s));
    }
    if name == "between" {
        return v_between(v0, kw_get(kw, "min_val"), kw_get(kw, "max_val"));
    }
    if name == "length" {
        return v_length(v0, kw_get(kw, "min_val"), kw_get(kw, "max_val"));
    }
    if name == "cron" {
        return v_cron(s);
    }
    if name == "country_code" {
        return Ok(v_country(re, s, kw_str(kw, "iso_format", "auto"), kw_bool(kw, "ignore_case", false)));
    }
    if name == "calling_code" {
        return Ok(s.len() > 0 and in_sorted(re.calling, s));
    }
    if name == "currency" {
        return Ok(v_currency(re, s, kw_bool(kw, "skip_symbols", true), kw_bool(kw, "ignore_case", false)));
    }
    if name == "es_cif" {
        return v_es_cif(re.uni, s);
    }
    if name == "es_nif" {
        return v_es_nif(re.uni, s);
    }
    if name == "es_nie" {
        return v_es_nie(re.uni, s);
    }
    if name == "es_doi" {
        return Ok(v_es_doi(re.uni, s));
    }
    if name == "fi_business_id" {
        return Ok(v_fi_business_id(re, s));
    }
    if name == "fi_ssn" {
        return Ok(v_fi_ssn(re, s, kw_bool(kw, "allow_temporal_ssn", true)));
    }
    if name == "fr_department" {
        return Ok(fr_department_ok(v0));
    }
    if name == "fr_ssn" {
        return Ok(v_fr_ssn(re, s));
    }
    if name == "ind_aadhar" {
        return Ok(rx_match(re.aadhar, s));
    }
    if name == "ind_pan" {
        return Ok(rx_full(re.pan, s));
    }
    if name == "ru_inn" {
        return Ok(v_ru_inn(s));
    }
    Err(f"no validator {name}")
}

fn call_text(name: ref String, args: ref Vec[Val], kw: ref Vec[Member]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for a in args {
        parts.push(val_repr(a));
    }
    for m in kw {
        parts.push(f"{m.key}={val_repr(m.val)}");
    }
    f"{name}({parts.join(", ")})"
}

// True, or the ValidationError's repr.
fn outcome(name: ref String, args: ref Vec[Val], kw: ref Vec[Member], r: ref Result[bool, String]) -> String {
    let mut fields: Vec[String] = Vec.new();
    match r {
        Ok(true) => return "True".to_string(),
        Ok(false) => {}
        Err(msg) => fields.push(f"'reason': {py_repr(msg)}"),
    }
    for a in args {
        fields.push(f"'value': {val_repr(a)}");
    }
    for m in kw {
        fields.push(f"{py_repr(m.key)}: {val_repr(m.val)}");
    }
    f"ValidationError(func={name}, args={{{fields.join(", ")}}})"
}

fn list_of(v: own Val) -> Vec[Val] {
    match v {
        Val.List(items) => items,
        _ => Vec.new(),
    }
}

fn members_of(v: own Val) -> Vec[Member] {
    match v {
        Val.Dict(ms) => ms,
        _ => Vec.new(),
    }
}

fn read_rows(path: ref String) -> Result[Vec[Vec[String]], String] {
    let body = match fs.read_to_string(path.clone()) {
        Ok(b) => b,
        Err(e) => return Err(f"cannot read {path}: {e}"),
    };
    let mut rows: Vec[Vec[String]] = Vec.new();
    for line in split_on(body, '\n') {
        if line.len() == 0 or line.starts_with("#") {
            continue;
        }
        rows.push(split_on(line, '\t'));
    }
    Ok(rows)
}

// The k-th brand of the signup form's list.
fn brand_k(re: ref Res, k: i64, s: ref String) -> bool {
    if k == 0 {
        brand_ok(re.visa, s, [16])
    } else if k == 1 {
        brand_ok(re.mastercard, s, [16])
    } else if k == 2 {
        brand_ok(re.amex, s, [15])
    } else if k == 3 {
        brand_ok(re.discover, s, [16])
    } else if k == 4 {
        brand_ok(re.jcb, s, [16])
    } else if k == 5 {
        brand_ok(re.diners, s, [14, 16])
    } else if k == 6 {
        brand_ok(re.unionpay, s, [16])
    } else {
        brand_ok(re.mir, s, [16])
    }
}

fn signups(re: ref Res, path: ref String) -> Result[(), String] {
    let rows = read_rows(path)?;
    let fields = ["username", "email", "website", "country", "card", "iban", "ip"];
    let mut rejected: Vec[i64] = [0, 0, 0, 0, 0, 0, 0];
    let brand_names = ["visa", "mastercard", "amex", "discover", "jcb", "diners", "unionpay", "mir"];
    let mut brand_counts: Vec[i64] = [0, 0, 0, 0, 0, 0, 0, 0];
    let mut accepted = 0;
    for r in rows {
        let (uid, user, mail, site, cc, cardno, acct, ip) = (r[0].clone(), r[1].clone(), r[2].clone(), r[3].clone(), r[4].clone(), r[5].clone(), r[6].clone(), r[7].clone());
        let mut bad: Vec[i64] = Vec.new();
        if not rx_full(re.slug, user) {
            bad.push(0);
        }
        if not truthy(v_email(re, mail, false, false, false, false, false)) {
            bad.push(1);
        }
        if site.len() > 0 and not truthy(v_url(re, site, url_defaults(), true)) {
            bad.push(2);
        }
        if not v_country(re, cc, "alpha2", false) {
            bad.push(3);
        }
        let mut brand: i64 = -1;
        if card_ok(cardno) {
            for k in 0..8 {
                if brand_k(re, k, cardno) {
                    brand = k;
                    break;
                }
            }
        }
        if brand < 0 {
            bad.push(4);
        }
        if acct.len() > 0 and not v_iban(re, re.uni, acct) {
            bad.push(5);
        }
        if not truthy(v_ipv4(re, ip, false, false, None, true)) and not truthy(v_ipv6(ip, false, false, true)) {
            bad.push(6);
        }
        let public = truthy(v_ipv4(re, ip, false, false, Some(false), true));
        for b in bad {
            rejected[b] += 1;
        }
        if bad.len() > 0 {
            let mut names: Vec[String] = Vec.new();
            for b in bad {
                names.push(fields[b].to_string());
            }
            println(f"   {uid} {user}: rejected {names.join(", ")}");
        } else {
            accepted += 1;
            brand_counts[brand] += 1;
            let place = if public { "public ipv4" } else { "not a public ipv4" };
            println(f"   {uid} {user}: ok, {brand_names[brand]} card, {place}");
        }
    }
    println(f"   {accepted} of {rows.len()} accepted");
    for k in 0..7 {
        println(f"     {fields[k]} rejected {rejected[k]} times");
    }
    let mut order: Vec[String] = Vec.new();
    for k in 0..8 {
        if brand_counts[k] > 0 {
            order.push(brand_names[k].to_string());
        }
    }
    order.sort();
    for b in order {
        for k in 0..8 {
            if brand_names[k] == b {
                println(f"     {b} cards accepted: {brand_counts[k]}");
            }
        }
    }
    Ok(())
}

fn webhooks(re: ref Res, path: ref String) -> Result[(), String] {
    let rows = read_rows(path)?;
    let mut verdicts: Vec[String] = Vec.new();
    let mut guarded = url_defaults();
    guarded.want_private = Some(false);
    for r in rows {
        let tenant = r[0].clone();
        let hook = r[1].clone();
        let plain = v_url(re, hook, url_defaults(), true);
        let safe = truthy(v_url(re, hook, guarded, true));
        let mut head = "accepted".to_string();
        let mut note = String.new();
        if not safe {
            match plain {
                Ok(true) => head = "rejected: private, loopback or multicast address".to_string(),
                Ok(false) => head = "rejected: not a valid URL".to_string(),
                Err(msg) => {
                    head = "rejected: not a valid URL".to_string();
                    note = f" ({msg})";
                }
            }
        }
        println(f"   {tenant} {hook}: {head}{note}");
        verdicts.push(head);
    }
    verdicts.sort();
    let mut k = 0;
    while k < verdicts.len() {
        let mut j = k;
        while j < verdicts.len() and verdicts[j] == verdicts[k] {
            j += 1;
        }
        println(f"     {verdicts[k]}: {j - k}");
        k = j;
    }
    Ok(())
}

fn run() -> Result[(), String] {
    let re = res();
    let body = match fs.read_to_string("data/jobs.tsv".to_string()) {
        Ok(b) => b,
        Err(e) => return Err(f"cannot read data/jobs.tsv: {e}"),
    };
    for line in split_on(body, '\n') {
        if line.starts_with("== ") {
            println(line);
            continue;
        }
        let f = split_on(line, '\t');
        if f[0] == "call" {
            let args = list_of(json_parse(f[2])?);
            let kw = members_of(json_parse(f[3])?);
            println(f"-- {call_text(f[1], args, kw)}");
            let r = dispatch(re, f[1], args, kw);
            println(f"   {outcome(f[1], args, kw, r)}");
        } else if f[0] == "signups" {
            signups(re, f"data/{f[1]}")?;
        } else if f[0] == "webhooks" {
            webhooks(re, f"data/{f[1]}")?;
        }
    }
    Ok(())
}

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn hex_val(c: u8) -> u8 {
    if c >= b'a' { c - b'a' + 10 } else { c - b'0' }
}

fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    if let Err(e) = run() {
        eprintln(e);
    }
}

// ------------------------------------------------------------ data

// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    let mut t0 = String.new();
    data_file_0_0(mut t0);
    data_file_0_1(mut t0);
    data_file_0_2(mut t0);
    data_file_0_3(mut t0);
    data_file_0_4(mut t0);
    v.push(DataFile { path: "jobs.tsv".to_string(), hex: false, body: t0 });
    let mut t1 = String.new();
    data_file_1_0(mut t1);
    v.push(DataFile { path: "signups.tsv".to_string(), hex: false, body: t1 });
    let mut t2 = String.new();
    data_file_2_0(mut t2);
    data_file_2_1(mut t2);
    data_file_2_2(mut t2);
    data_file_2_3(mut t2);
    data_file_2_4(mut t2);
    data_file_2_5(mut t2);
    data_file_2_6(mut t2);
    data_file_2_7(mut t2);
    data_file_2_8(mut t2);
    v.push(DataFile { path: "tld.txt".to_string(), hex: false, body: t2 });
    let mut t3 = String.new();
    data_file_3_0(mut t3);
    v.push(DataFile { path: "webhooks.tsv".to_string(), hex: false, body: t3 });
    v
}

