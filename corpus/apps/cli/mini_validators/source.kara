// The patterns validators compiles, one function each.
fn pat_email() -> String {
    "(^[Ā-ſƀ-ɏ -ÿ]|[Ā-ſƀ-ɏ -ÿ0-9a-z!#$%&'*+/=?^_`{}|~\\-]+(\\.[Ā-ſƀ-ɏ -ÿ0-9a-z!#$%&'*+/=?^_`{}|~\\-]+)*$|^\"([Ā-ſƀ-ɏ -ÿ\\001-\\010\\013\\014\\016-\\037!#-\\[\\]-\\177]|\\\\[\\011.])*\")$".to_string()
}
fn pat_domain_bad() -> String {
    "\\s|__+".to_string()
}
fn pat_port() -> String {
    "^\\:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3})$".to_string()
}
fn pat_simple_host() -> String {
    "^(?!-)[a-z0-9](?:[a-z0-9-]{0,59}[a-z0-9])?(?<!-)$".to_string()
}
fn pat_private_172() -> String {
    "^172\\.(?:1[6-9]|2\\d|3[0-1])\\.".to_string()
}
fn pat_broadcast() -> String {
    "^(?:22[4-9]|23[0-9]|24[0-9]|25[0-5])\\.".to_string()
}
fn pat_url_user() -> String {
    "(^[Ā-ſƀ-ɏ]|[-!#$%&'*+/=?^_`{}|~0-9a-z]+(\\.[-!#$%&'*+/=?^_`{}|~0-9a-z]+)*$|^([\\001-\\010\\013\\014\\016-\\037!#-\\[\\]-\\177]|\\\\[\\011.])*$)".to_string()
}
fn pat_url_path() -> String {
    "^[\\/a-z0-9\\-\\.\\_\\~\\!\\$\\&\\'\\(\\)\\*\\+\\,\\;\\=\\:\\@\\%\\U0001F300-\\U0001F5FF\\U0001F600-\\U0001F64F -퟿豈-﷏ﷰ-￯]+$".to_string()
}
fn pat_whitespace() -> String {
    "\\s".to_string()
}
fn pat_url_fragment() -> String {
    "[0-9a-z?/:@\\-._~%!$&'()*+,;=#]*".to_string()
}
fn pat_ipvfuture() -> String {
    "\\A[vV][a-fA-F0-9]+\\..+\\Z".to_string()
}
fn pat_mac() -> String {
    "^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$".to_string()
}
fn pat_slug() -> String {
    "^[a-z0-9]+(?:-[a-z0-9]+)*$".to_string()
}
fn pat_base16() -> String {
    "^[0-9A-Fa-f]+$".to_string()
}
fn pat_base32() -> String {
    "^[A-Z2-7]+=*$".to_string()
}
fn pat_base58() -> String {
    "^[1-9A-HJ-NP-Za-km-z]+$".to_string()
}
fn pat_base64() -> String {
    "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$".to_string()
}
fn pat_visa() -> String {
    "^4".to_string()
}
fn pat_mastercard() -> String {
    "^(5[1-5]|222[1-9]|22[3-9][0-9]|2[3-6][0-9]{2}|27[01][0-9]|2720)".to_string()
}
fn pat_amex() -> String {
    "^(34|37)".to_string()
}
fn pat_unionpay() -> String {
    "^62".to_string()
}
fn pat_diners() -> String {
    "^(30|36|38|39)".to_string()
}
fn pat_jcb() -> String {
    "^35".to_string()
}
fn pat_discover() -> String {
    "^(60|64|65)".to_string()
}
fn pat_mir() -> String {
    "^(220[0-4])".to_string()
}
fn pat_iban() -> String {
    "^[a-z]{2}[0-9]{2}[a-z0-9]{11,30}$".to_string()
}
fn pat_btc_segwit() -> String {
    "^(bc|tb)[0-3][02-9ac-hj-np-z]{14,74}$".to_string()
}
fn pat_trx() -> String {
    "^[T][a-km-zA-HJ-NP-Z1-9]{33}$".to_string()
}
fn pat_bsc() -> String {
    "0x[a-fA-F0-9]{40}".to_string()
}
fn pat_fi_business_id() -> String {
    "^[0-9]{7}-[0-9]$".to_string()
}
fn pat_fi_ssn() -> String {
    "^\n        (?P<date>(0[1-9]|[1-2]\\d|3[01])\n        (0[1-9]|1[012])\n        (\\d{2}))\n        [ABCDEFYXWVU+-]\n        (?P<serial>(\\d{3}))\n        (?P<checksum>[0123456789ABCDEFHJKLMNPRSTUVWXY])$".to_string()
}
fn pat_fr_ssn() -> String {
    "^([12])\\s(\\d{2})\\s(0[1-9]|1[0-2])\\s(\\d{2,3}|2[AB])\\s(\\d{2,3})\\s(\\d{3})(?:\\s(\\d{2}))?$".to_string()
}
fn pat_aadhar() -> String {
    "^[2-9]{1}\\d{3}\\s\\d{4}\\s\\d{4}$".to_string()
}
fn pat_pan() -> String {
    "[A-Z]{5}\\d{4}[A-Z]{1}".to_string()
}
fn pat_domain() -> String {
    "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9][a-z0-9-]{0,61}[a-z]$".to_string()
}
fn pat_domain_dot() -> String {
    "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9][a-z0-9-]{0,61}[a-z]\\.?$".to_string()
}
fn pat_domain_srv() -> String {
    "^(?:[a-z0-9_](?:[a-z0-9-_]{0,61}[a-z0-9_])?\\.)+[a-z0-9][a-z0-9-]{0,61}[a-z]$".to_string()
}
fn pat_domain_srv_dot() -> String {
    "^(?:[a-z0-9_](?:[a-z0-9-_]{0,61}[a-z0-9_])?\\.)+[a-z0-9][a-z0-9-]{0,61}[a-z]\\.?$".to_string()
}
fn pat_hash32() -> String {
    "^[0-9a-f]{32}$".to_string()
}
fn pat_hash40() -> String {
    "^[0-9a-f]{40}$".to_string()
}
fn pat_hash56() -> String {
    "^[0-9a-f]{56}$".to_string()
}
fn pat_hash64() -> String {
    "^[0-9a-f]{64}$".to_string()
}
fn pat_hash96() -> String {
    "^[0-9a-f]{96}$".to_string()
}
fn pat_hash128() -> String {
    "^[0-9a-f]{128}$".to_string()
}
