    t.push_str("customer,start,plan\n");
    t.push_str("acme,2024-01-31,monthly\n");
    t.push_str("globex,2024-02-29,yearly\n");
    t.push_str("initech,2023-08-31,quarterly\n");
    t.push_str("umbrella,2024-03-15 09:30,monthly\n");
    t.push_str("hooli,2024-05-31,weekly\n");
    v.push(DataFile { path: "files/subs.csv".to_string(), body: t });
}

