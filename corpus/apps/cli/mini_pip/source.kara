fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data")?;
    put("data/envs.txt", file_0())?;
    put("data/index.json", file_1())?;
    put("data/jobs.txt", file_2())?;
    put("data/markers.txt", file_3())?;
    make_dir("data/reqs")?;
    put("data/reqs/api.txt", file_4())?;
    put("data/reqs/aws.txt", file_5())?;
    put("data/reqs/bad.txt", file_6())?;
    put("data/reqs/base.txt", file_7())?;
    put("data/reqs/conflict.txt", file_8())?;
    put("data/reqs/constraints.txt", file_9())?;
    put("data/reqs/data.txt", file_10())?;
    put("data/reqs/missing.txt", file_11())?;
    put("data/reqs/pre.txt", file_12())?;
    put("data/reqs/web.txt", file_13())?;
    put("data/reqs/yanked.txt", file_14())?;
    put("data/reqs/yanked2.txt", file_15())?;
    put("data/requirement-tests.txt", file_16())?;
    put("data/specifiers.txt", file_17())?;
    put("data/versions.txt", file_18())?;
    Ok(())
}

// ------------------------------------------------------------ the report

fn yn(b: bool) -> String {
    if b { "y".to_string() } else { "n".to_string() }
}

fn opt_int(n: i64) -> String {
    if n == NONE { "-".to_string() } else { f"{n}" }
}

fn read(path: Str) -> Result[String, String] {
    match fs.read_to_string(path.to_string()) {
        Ok(t) => Ok(t),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

fn show_versions() -> Result[(), String] {
    println("== versions");
    let ls = lines_of(read("data/versions.txt")?);
    let mut valid: Vec[Ver] = Vec.new();
    for i in 0..ls.len() {
        let raw = ls[i].clone();
        let v = match parse_version(raw) {
            Some(v) => v,
            None => {
                println(f"{py_repr(raw)} -> Invalid version: {py_repr(raw)}");
                continue;
            }
        };
        let pre = if v.pre_kind == NONE { "-".to_string() } else { f"{pre_letters(v.pre_kind)}{v.pre_n}" };
        let local = if v.has_local() { join(v.local, ".") } else { "-".to_string() };
        let mut flags: Vec[String] = Vec.new();
        if v.is_prerelease() {
            flags.push("pre-release".to_string());
        }
        if v.post != NONE {
            flags.push("post-release".to_string());
        }
        if v.dev != NONE {
            flags.push("dev-release".to_string());
        }
        let tail = if flags.len() == 0 { String.new() } else { f", {join(flags, ", ")}" };
        println(f"{py_repr(raw)} -> {v.to_str()}  [epoch {v.epoch}, release {join_ints(v.release)}, pre {pre}, post {opt_int(v.post)}, dev {opt_int(v.dev)}, local {local}, public {v.public()}, base {v.base_version()}{tail}]");
        valid.push(v);
    }
    println("sorted:");
    let sorted = sort_versions(valid);
    let mut out: Vec[String] = Vec.new();
    for i in 0..sorted.len() {
        if i > 0 and sorted[i] == sorted[i - 1] {
            let last = out.len() - 1;
            out[last].push_str(f" = {sorted[i].to_str()}");
        } else {
            out.push(sorted[i].to_str());
        }
    }
    for i in 0..out.len() {
        println(f"  {out[i]}");
    }
    Ok(())
}

fn show_specifiers() -> Result[(), String] {
    println("");
    println("== specifiers");
    let ls = lines_of(read("data/specifiers.txt")?);
    for i in 0..ls.len() {
        let b = to_bytes(ls[i]);
        let mut bar = b.len();
        for k in 0..b.len() {
            if b[k] == b'|' {
                bar = k;
                break;
            }
        }
        let spec = strip(byte_str(b, 0, bar));
        let items = if bar < b.len() { split_ws(byte_str(b, bar + 1, b.len())) } else { Vec.new() };
        let s = match parse_spec_set(spec) {
            Ok(s) => s,
            Err(e) => {
                println(f"{py_repr(spec)}: {e}");
                continue;
            }
        };
        let pre = if s.prereleases() == 1 { "True" } else { "None" };
        println(f"{py_repr(spec)}: {py_repr(s.to_str())} prereleases={pre} unsatisfiable={yn(s.is_unsatisfiable())}");
        let mut cells: Vec[String] = Vec.new();
        for k in 0..items.len() {
            let it = items[k].clone();
            cells.push(f"{it}:{yn(s.contains(it, NONE))}{yn(s.contains(it, 1))}{yn(s.contains(it, 0))}");
        }
        println(f"  contains {join(cells, " ")}");
        println(f"  filter {join(s.filter(items, NONE), " ")}");
        println(f"  filter pre {join(s.filter(items, 1), " ")}");
        println(f"  filter final {join(s.filter(items, 0), " ")}");
    }
    Ok(())
}

fn show_lines(text: Str) {
    let ls = split_on(text, b'\n');
    for i in 0..ls.len() {
        println(f"  | {ls[i]}");
    }
}

fn show_markers(names: ref Vec[String], envs: ref Vec[Env]) -> Result[(), String] {
    println("");
    println("== markers");
    let ls = lines_of(read("data/markers.txt")?);
    for i in 0..ls.len() {
        let raw = ls[i].clone();
        let m = match parse_full_marker(raw) {
            Ok(m) => m,
            Err(e) => {
                println(f"{py_repr(raw)}: InvalidMarker");
                show_lines(e);
                continue;
            }
        };
        println(f"{py_repr(raw)}: {format_marker(m, true)}");
        for k in 0..names.len() {
            let r = match evaluate(m, envs[k], "") {
                Ok(true) => "true".to_string(),
                Ok(false) => "false".to_string(),
                Err(e) => e,
            };
            println(f"  {names[k]}: {r}");
        }
    }
    Ok(())
}

fn show_requirements() -> Result[(), String] {
    println("");
    println("== requirements");
    let ls = lines_of(read("data/requirement-tests.txt")?);
    for i in 0..ls.len() {
        let raw = ls[i].clone();
        let r = match parse_requirement(raw) {
            Ok(r) => r,
            Err(e) => {
                println(f"{py_repr(raw)}: InvalidRequirement");
                show_lines(e);
                continue;
            }
        };
        println(f"{py_repr(raw)}: {r.to_str()}");
        let extras = if r.extras.len() > 0 { join(r.extras, ",") } else { "-".to_string() };
        let spec = r.spec.to_str();
        let spec = if spec.len() > 0 { spec } else { "-".to_string() };
        let url = if r.url.len() > 0 { r.url.clone() } else { "-".to_string() };
        let marker = match ref r.marker {
            Some(m) => format_marker(m, true),
            None => "-".to_string(),
        };
        println(f"  name {r.name} ({r.key()}), extras {extras}, specifier {spec}, url {url}, marker {marker}");
    }
    Ok(())
}

fn resolve(index: ref Vec[Project], file: Str, env_name: Str, env: ref Env) {
    println(f"== resolve {file} ({env_name})");
    let mut roots: Vec[Requirement] = Vec.new();
    let mut cons: Vec[Requirement] = Vec.new();
    if let Err(e) = read_reqs(f"data/reqs/{file}", mut roots, mut cons, false) {
        println(f"error: {e}");
        return;
    }
    let mut reqs: Vec[Requirement] = Vec.new();
    let mut parents: Vec[String] = Vec.new();
    for i in 0..roots.len() {
        if not roots[i].applies(env) {
            println(f"skipped {roots[i].to_str()} (marker is false)");
            continue;
        }
        reqs.push(roots[i].clone());
        parents.push("the user".to_string());
    }
    let mut kept: Vec[Requirement] = Vec.new();
    for i in 0..cons.len() {
        if cons[i].applies(env) {
            kept.push(cons[i].clone());
        }
    }
    let mut r = Resolver {
        index: index.clone(),
        env: env.clone(),
        reqs: reqs,
        parents: parents,
        cons: kept,
        pin_names: Vec.new(),
        pin_versions: Vec.new(),
        pin_extras: Vec.new(),
        backtracks: 0,
        conflict: String.new(),
    };
    if not r.solve(0) {
        println(f"error: {r.conflict}");
        println(f"backtracks: {r.backtracks}");
        return;
    }
    let names = sort_strings(r.pin_names.clone());
    for i in 0..names.len() {
        let p = index_of(r.pin_names, names[i]);
        let ex = sort_strings(r.pin_extras[p].clone());
        let shown = if ex.len() > 0 { f"[{join(ex, ",")}]" } else { String.new() };
        println(f"{names[i]}{shown}=={r.pin_versions[p]}");
    }
    println(f"backtracks: {r.backtracks}");
    // what each pinned project needs, from the final edges
    let mut needs: Vec[Vec[String]] = Vec.new();
    for _ in 0..names.len() {
        needs.push(Vec.new());
    }
    for i in 0..r.reqs.len() {
        if r.parents[i] == "the user" {
            continue;
        }
        let parent = split_on(r.parents[i], b'=')[0].clone();
        let p = index_of(names, parent);
        let d = r.reqs[i].key();
        if not contains_str(needs[p], d) {
            needs[p].push(d);
        }
    }
    let mut order: Vec[String] = Vec.new();
    let mut left = names.clone();
    while left.len() > 0 {
        let mut pick: i64 = 0;
        for k in 0..left.len() {
            let n = index_of(names, left[k]);
            let mut ready = true;
            for d in 0..needs[n].len() {
                if needs[n][d] != left[k] and not contains_str(order, needs[n][d]) {
                    ready = false;
                    break;
                }
            }
            if ready {
                pick = k;
                break;
            }
        }
        order.push(left[pick].clone());
        left.remove(pick);
    }
    println(f"install order: {join(order, " ")}");
}

fn run() -> Result[(), String] {
    write_data()?;
    show_versions()?;
    show_specifiers()?;
    let (names, envs) = read_envs(read("data/envs.txt")?);
    show_markers(names, envs)?;
    show_requirements()?;
    let index = read_index(read("data/index.json")?)?;
    println("");
    let jobs = lines_of(read("data/jobs.txt")?);
    for i in 0..jobs.len() {
        let parts = split_ws(jobs[i]);
        let e = index_of(names, parts[1]);
        resolve(index, parts[0], parts[1], envs[e]);
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_pip: {e}");
    }
}
