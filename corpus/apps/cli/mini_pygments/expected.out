# lexers
Python: aliases=python,py,sage,python3,py3,bazel,starlark filenames=*.py,*.pyw,*.pyi,*.jy,*.sage,*.sc,SConstruct,SConscript,*.bzl,BUCK,BUILD,BUILD.bazel,WORKSPACE,*.tac mimetypes=text/x-python,application/x-python,text/x-python3,application/x-python3
Bash: aliases=bash,sh,ksh,zsh,shell filenames=*.sh,*.ksh,*.bash,*.ebuild,*.eclass,*.exheres-0,*.exlib,*.zsh,.bashrc,bashrc,.bash_*,bash_*,zshrc,.zshrc,.kshrc,kshrc,PKGBUILD mimetypes=application/x-sh,application/x-shellscript,text/x-shellscript
INI: aliases=ini,cfg,dosini filenames=*.ini,*.cfg,*.inf,.editorconfig mimetypes=text/x-ini,text/inf
Diff: aliases=diff,udiff filenames=*.diff,*.patch mimetypes=text/x-diff,text/x-patch
TOML: aliases=toml filenames=*.toml,Pipfile,poetry.lock mimetypes=application/toml
Nginx configuration file: aliases=nginx filenames=nginx.conf mimetypes=text/x-nginx-conf
CSS: aliases=css filenames=*.css mimetypes=text/css
SQL: aliases=sql filenames=*.sql mimetypes=text/x-sql
Docker: aliases=docker,dockerfile filenames=Dockerfile,*.docker mimetypes=text/x-dockerfile-config
Go: aliases=go,golang filenames=*.go mimetypes=text/x-gosrc
Rust: aliases=rust,rs filenames=*.rs,*.rs.in mimetypes=text/rust,text/x-rust
JavaScript: aliases=javascript,js filenames=*.js,*.jsm,*.mjs,*.cjs mimetypes=application/javascript,application/x-javascript,text/x-javascript,text/javascript
Systemd: aliases=systemd filenames=*.service,*.socket,*.device,*.mount,*.automount,*.swap,*.target,*.path,*.timer,*.slice,*.scope mimetypes=
Properties: aliases=properties,jproperties filenames=*.properties mimetypes=text/x-java-properties
XML: aliases=xml filenames=*.xml,*.xsl,*.rss,*.xslt,*.xsd,*.wsdl,*.wsf mimetypes=text/xml,application/xml,image/svg+xml,application/rss+xml,application/atom+xml
HTML: aliases=html filenames=*.html,*.htm,*.xhtml,*.xslt mimetypes=text/html,application/xhtml+xml
Python Traceback: aliases=pytb,py3tb filenames=*.pytb,*.py3tb mimetypes=text/x-python-traceback,text/x-python3-traceback
C: aliases=c filenames=*.c,*.h,*.idc,*.x[bp]m mimetypes=text/x-chdr,text/x-csrc,image/x-xbitmap,image/x-xpixmap
JSON: aliases=json,json-object filenames=*.json,*.jsonl,*.ndjson,Pipfile.lock mimetypes=application/json,application/json-object,application/x-ndjson,application/jsonl,application/json-seq
Text only: aliases=text filenames=*.txt mimetypes=text/plain
# find_lexer_class_for_filename
x.py -> python
x.pyw -> python
SConstruct -> python
x.sh -> bash
.bashrc -> bash
PKGBUILD -> bash
x.ini -> ini
x.cfg -> ini
x.patch -> diff
Pipfile -> toml
x.toml -> toml
nginx.conf -> nginx
x.css -> css
x.sql -> tsql
Dockerfile -> docker
x.go -> go
x.rs -> rust
x.js -> javascript
x.mjs -> javascript
x.service -> systemd
x.properties -> properties
x.xml -> xml
x.html -> html
x.xhtml -> html
x.pytb -> pytb
x.c -> c
x.h -> c
x.json -> json
x.txt -> text
x.unknown -> text
dir/sub/x.rs -> rust
X.PY -> text
x.tar.gz -> text
