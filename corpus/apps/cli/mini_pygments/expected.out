== site/api.html
<!doctype html>
<link rel="stylesheet" href="pygments.css">
<h1>API</h1>
<p>Each item comes back as JSON:</p>
<!-- JSON -->
<div class="highlight"><pre><span></span><span class="p">{</span><span class="nt">&quot;sku&quot;</span><span class="p">:</span><span class="w"> </span><span class="s2">&quot;ABC-1&quot;</span><span class="p">,</span><span class="w"> </span><span class="nt">&quot;qty&quot;</span><span class="p">:</span><span class="w"> </span><span class="mi">12</span><span class="p">}</span>
</pre></div>
<p>Unknown fences fall back to plain text:</p>
<!-- Text only -->
<div class="highlight"><pre><span></span>DISPLAY &#39;HI&#39;.
</pre></div>
<!-- Text only -->
<div class="highlight"><pre><span></span>no language at all &lt;b&gt;
</pre></div>
<p>And SQL, numbered from 5:</p>
<!-- SQL -->
<div class="highlight"><table class="highlighttable"><tr><td class="linenos"><div class="linenodiv"><pre><span class="normal">5</span></pre></div></td><td class="code"><div><pre><span></span><span class="k">SELECT</span><span class="w"> </span><span class="n">sku</span><span class="w"> </span><span class="k">FROM</span><span class="w"> </span><span class="n">items</span><span class="w"> </span><span class="k">WHERE</span><span class="w"> </span><span class="n">qty</span><span class="w"> </span><span class="o">&lt;</span><span class="w"> </span><span class="mi">3</span><span class="p">;</span>
</pre></div></td></tr></table></div>
== site/index.html
<!doctype html>
<link rel="stylesheet" href="pygments.css">
<h1>Inventory docs</h1>
<p>Install the service, then point a client at it.</p>
<!-- Bash -->
<div class="highlight"><pre><span></span>pip<span class="w"> </span>install<span class="w"> </span>inventory<span class="w"> </span><span class="o">&amp;&amp;</span><span class="w"> </span>inventory<span class="w"> </span>--port<span class="w"> </span><span class="m">8080</span>
</pre></div>
<p>A request from Python:</p>
<!-- Python -->
<div class="highlight"><table class="highlighttable"><tr><td class="linenos"><div class="linenodiv"><pre><span class="normal">1</span>
<span class="normal">2</span>
<span class="normal">3</span></pre></div></td><td class="code"><div><pre><span></span><span class="kn">import</span> <span class="nn">httpx</span>
<span class="hll"><span class="n">r</span> <span class="o">=</span> <span class="n">httpx</span><span class="o">.</span><span class="n">get</span><span class="p">(</span><span class="s2">&quot;http://localhost:8080/items&quot;</span><span class="p">)</span>
</span><span class="nb">print</span><span class="p">(</span><span class="n">r</span><span class="o">.</span><span class="n">json</span><span class="p">()[</span><span class="s2">&quot;count&quot;</span><span class="p">])</span>
</pre></div></td></tr></table></div>
<p>The config file:</p>
<!-- INI -->
<div class="highlight"><pre><span></span><span class="k">[server]</span>
<span class="na">port</span><span class="w"> </span><span class="o">=</span><span class="w"> </span><span class="s">8080</span>
</pre></div>
