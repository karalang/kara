// mini_pygments: Pygments 2.17.2, the syntax highlighter behind Sphinx,
// MkDocs, Jupyter, GitLab and most static site generators, ported with
// its lexing machinery whole:
// - RegexLexerMeta's processing of a lexer's `tokens` (include, inherit,
//   default, combined, words through regexopt, bygroups and using) and
//   RegexLexer's state machine, with its fallback to Error tokens and the
//   reset to 'root' at a newline it cannot match;
// - JsonLexer's hand-written character scanner and CFamilyLexer's type
//   highlighting switches;
// - the lexer options (stripnl, stripall, ensurenl, tabsize) and the
//   codetagify, keywordcase, highlight, raiseonerror, whitespace, gobble
//   and tokenmerge filters;
// - StyleMeta's style inheritance, and the HTML (classes and inline
//   styles, line numbers in a table or inline, highlighted lines,
//   anchors and spans, full documents, get_style_defs), terminal, raw
//   token, null and testcase formatters;
// - lexer lookup by alias, mimetype and file name over the whole lexer
//   map, with its priority and class-name tie-break.
//
// The token tables of the lexers it runs (Python, Bash, INI, Diff, TOML,
// nginx, CSS, SQL, Docker, Go, Rust, JavaScript, systemd, Properties,
// XML, HTML, Python tracebacks and C), the lexer map and the six styles
// are data printed from Pygments' own classes by gen_tables.py. Regexes
// run on the Python `re` engine of mini_re.
//
// The run writes data/, runs data/jobs.txt (lexers, options, filters and
// formatters over the sources in data/src), prints the style sheets in
// data/styles.txt, and builds an HTML docs site from data/docs into
// data/site, printing every page.

// ------------------------------------------------------------ errors

struct ReErr {
    kind: String,
    msg: String,
    pos: i64,
}

fn re_error(msg: own String, pos: i64) -> ReErr {
    ReErr { kind: "error".to_string(), msg: msg, pos: pos }
}

fn other_error(kind: Str, msg: own String) -> ReErr {
    ReErr { kind: kind.to_string(), msg: msg, pos: -1 }
}

fn err_text(e: ref ReErr) -> String {
    if e.kind == "error" {
        if e.pos >= 0 {
            return f"error: {e.msg} at position {e.pos}";
        }
        return f"error: {e.msg}";
    }
    f"{e.kind}: {e.msg}"
}

// -------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for cp in s {
        if cp < 0x80 {
            out.push(cp as u8);
        } else if cp < 0x800 {
            out.push((0xC0 | (cp >> 6)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else if cp < 0x10000 {
            out.push((0xE0 | (cp >> 12)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (cp >> 18)) as u8);
            out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

fn str_repr(s: ref Vec[i64], out: mut ref Vec[i64]) {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
}

fn repr_of(s: ref Vec[i64]) -> String {
    let mut out: Vec[i64] = Vec.new();
    str_repr(s, mut out);
    to_string(out)
}

// ----------------------------------------------------- character kinds

fn is_decimal(c: i64) -> bool {
    if c < 0x80 {
        return c >= 48 and c <= 57;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return true;
        }
    }
    false
}

fn is_space(c: i64, ascii: bool) -> bool {
    if c == 32 or (c >= 9 and c <= 13) {
        return true;
    }
    if ascii {
        return false;
    }
    (c >= 0x1C and c <= 0x1F) or c == 0x85 or c == 0xA0 or c == 0x1680 or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F or c == 0x3000
}

fn as_char(c: i64) -> Option[char] {
    if c < 0 or (c >= 0xD800 and c <= 0xDFFF) or c > 0x10FFFF {
        return None;
    }
    char.try_from(c as u32).ok()
}

fn is_word(c: i64, ascii: bool) -> bool {
    if c < 0x80 {
        return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
    }
    if ascii {
        return false;
    }
    match as_char(c) {
        Some(ch) => ch.is_alphanumeric(),
        None => false,
    }
}

fn lower(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 65 and c <= 90 { c + 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_lowercase() as u32 as i64,
        None => c,
    }
}

fn upper(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 97 and c <= 122 { c - 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_uppercase() as u32 as i64,
        None => c,
    }
}

// ------------------------------------------------------- parsed form

// The categories of \d \D \s \S \w \W.
fn cat_digit() -> i64 { 0 }
fn cat_not_digit() -> i64 { 1 }
fn cat_space() -> i64 { 2 }
fn cat_not_space() -> i64 { 3 }
fn cat_word() -> i64 { 4 }
fn cat_not_word() -> i64 { 5 }

// The positions ^ $ \A \Z \b \B and the forms the compiler turns them
// into under MULTILINE.
fn at_beginning() -> i64 { 0 }
fn at_beginning_line() -> i64 { 1 }
fn at_beginning_string() -> i64 { 2 }
fn at_end() -> i64 { 3 }
fn at_end_line() -> i64 { 4 }
fn at_end_string() -> i64 { 5 }
fn at_boundary() -> i64 { 6 }
fn at_non_boundary() -> i64 { 7 }

#[derive(Clone)]
enum Item {
    Lit(i64),
    Range(i64, i64),
    Cat(i64),
}

enum Node {
    Lit(i64),
    NotLit(i64),
    Any,
    In(Vec[Item], bool),
    At(i64),
    Branch(Vec[Vec[Node]]),
    // group (0: none), flags turned on, flags turned off, contents
    Group(i64, i64, i64, Vec[Node]),
    // 0 greedy, 1 lazy, 2 possessive; min; max; the item repeated
    Repeat(i64, i64, i64, Vec[Node]),
    Atomic(Vec[Node]),
    // direction (1 ahead, -1 behind), negative, contents
    Assert(i64, bool, Vec[Node]),
    GroupRef(i64),
    // group, yes branch, no branch
    Exists(i64, Vec[Node], Vec[Node]),
    Failure,
}

fn is_repeat(n: ref Node) -> bool {
    match n {
        Node.Repeat(_, _, _, _) => true,
        _ => false,
    }
}

fn is_at(n: ref Node) -> bool {
    match n {
        Node.At(_) => true,
        _ => false,
    }
}

fn flag_i() -> i64 { 2 }
fn flag_l() -> i64 { 4 }
fn flag_m() -> i64 { 8 }
fn flag_s() -> i64 { 16 }
fn flag_u() -> i64 { 32 }
fn flag_x() -> i64 { 64 }
fn flag_a() -> i64 { 256 }
fn type_flags() -> i64 { 4 | 32 | 256 }
fn maxrepeat() -> i64 { 4294967295 }
fn maxgroups() -> i64 { 1073741823 }
fn maxwidth() -> i64 { 1 << 62 }

fn flag_value(c: i64) -> i64 {
    match c {
        105 => 2,
        76 => 4,
        109 => 8,
        115 => 16,
        120 => 64,
        97 => 256,
        117 => 32,
        _ => 0,
    }
}

// ------------------------------------------------------------ tokens

// One token: nothing at the end of the pattern (n 0), a character (n 1),
// or a backslash and the character after it (n 2).
#[derive(Copy, Clone)]
struct T {
    n: i64,
    a: i64,
    b: i64,
}

fn tok_none() -> T {
    T { n: 0, a: 0, b: 0 }
}

fn tok_is(t: T, c: i64) -> bool {
    t.n == 1 and t.a == c
}

fn tok_text(t: T) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    if t.n >= 1 {
        v.push(t.a);
    }
    if t.n == 2 {
        v.push(t.b);
    }
    v
}

fn is_ascii_letter(c: i64) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

fn is_hex(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

fn is_oct(c: i64) -> bool {
    c >= 48 and c <= 55
}

fn is_dec(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn digits_value(s: ref Vec[i64], start: i64, base: i64) -> i64 {
    let mut v = 0;
    let mut i = start;
    while i < s.len() {
        let c = s[i];
        let d = if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 };
        v = v * base + d;
        i += 1;
    }
    v
}

// str.isidentifier, near enough: a letter or underscore, then letters,
// digits and underscores.
fn is_identifier(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    let mut i = 0;
    while i < name.len() {
        let c = name[i];
        let ok = if c == 95 {
            true
        } else if i == 0 {
            match as_char(c) {
                Some(ch) => ch.is_alphabetic(),
                None => false,
            }
        } else {
            is_word(c, false)
        };
        if not ok {
            return false;
        }
        i += 1;
    }
    true
}

fn is_ascii_decimal(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    for c in name {
        if not is_dec(c) {
            return false;
        }
    }
    true
}

struct Tokenizer {
    s: Vec[i64],
    index: i64,
    next: T,
}

impl Tokenizer {
    fn advance(mut ref self) -> Result[(), ReErr] {
        let index = self.index;
        if index >= self.s.len() {
            self.next = tok_none();
            return Ok(());
        }
        let c = self.s[index];
        if c == 92 {
            if index + 1 >= self.s.len() {
                return Err(re_error("bad escape (end of pattern)".to_string(), self.s.len() - 1));
            }
            self.next = T { n: 2, a: 92, b: self.s[index + 1] };
            self.index = index + 2;
        } else {
            self.next = T { n: 1, a: c, b: 0 };
            self.index = index + 1;
        }
        Ok(())
    }

    fn get(mut ref self) -> Result[T, ReErr] {
        let t = self.next;
        self.advance()?;
        Ok(t)
    }

    fn take(mut ref self, c: i64) -> Result[bool, ReErr] {
        if tok_is(self.next, c) {
            self.advance()?;
            return Ok(true);
        }
        Ok(false)
    }

    fn tell(ref self) -> i64 {
        self.index - self.next.n
    }

    fn seek(mut ref self, index: i64) -> Result[(), ReErr] {
        self.index = index;
        self.advance()
    }

    fn error(ref self, msg: own String, offset: i64) -> ReErr {
        re_error(msg, self.tell() - offset)
    }

    // getwhile: up to n characters of a kind (0 octal, 1 decimal, 2 hex).
    fn getwhile(mut ref self, n: i64, kind: i64, out: mut ref Vec[i64]) -> Result[(), ReErr] {
        let mut k = 0;
        while k < n {
            let t = self.next;
            if t.n != 1 {
                break;
            }
            let ok = if kind == 0 { is_oct(t.a) } else if kind == 1 { is_dec(t.a) } else { is_hex(t.a) };
            if not ok {
                break;
            }
            out.push(t.a);
            self.advance()?;
            k += 1;
        }
        Ok(())
    }

    fn getuntil(mut ref self, terminator: i64, name: Str) -> Result[Vec[i64], ReErr] {
        let mut result: Vec[i64] = Vec.new();
        loop {
            let c = self.next;
            self.advance()?;
            if c.n == 0 {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 0));
                }
                let term = to_string(vec_of(terminator));
                return Err(self.error(f"missing {term}, unterminated name", result.len()));
            }
            if tok_is(c, terminator) {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 1));
                }
                break;
            }
            push_all(mut result, tok_text(c));
        }
        Ok(result)
    }

    fn checkgroupname(ref self, name: ref Vec[i64], offset: i64) -> Result[(), ReErr] {
        if not is_identifier(name) {
            return Err(self.error(f"bad character in group name {repr_of(name)}", name.len() + offset));
        }
        Ok(())
    }
}

fn vec_of(c: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(c);
    v
}

fn new_tokenizer(s: ref Vec[i64]) -> Result[Tokenizer, ReErr] {
    let mut t = Tokenizer { s: s.clone(), index: 0, next: tok_none() };
    t.advance()?;
    Ok(t)
}

// ------------------------------------------------------------ parser

#[derive(Clone)]
struct Width {
    lo: i64,
    hi: i64,
}

struct ParseState {
    flags: i64,
    names: Vec[(Vec[i64], i64)],
    // per group: whether it is closed, and its width
    closed: Vec[bool],
    widths: Vec[Width],
    lookbehind_groups: i64,
    // conditional references by number, in order: (group, position)
    refpos: Vec[(i64, i64)],
}

impl ParseState {
    fn groups(ref self) -> i64 {
        self.closed.len()
    }

    fn group_of(ref self, name: ref Vec[i64]) -> i64 {
        for (n, g) in self.names.iter() {
            if same(n, name) {
                return *g;
            }
        }
        -1
    }

    fn checkgroup(ref self, gid: i64) -> bool {
        gid < self.groups() and self.closed[gid]
    }

    fn checklookbehindgroup(ref self, gid: i64, src: ref Tokenizer) -> Result[(), ReErr] {
        if self.lookbehind_groups >= 0 {
            if not self.checkgroup(gid) {
                return Err(src.error("cannot refer to an open group".to_string(), 0));
            }
            if gid >= self.lookbehind_groups {
                return Err(src.error("cannot refer to group defined in the same lookbehind subpattern".to_string(), 0));
            }
        }
        Ok(())
    }
}

fn add_width(a: i64, b: i64) -> i64 {
    if a >= maxwidth() - b { maxwidth() } else { a + b }
}

fn mul_width(a: i64, n: i64) -> i64 {
    if a == 0 or n == 0 {
        0
    } else if a >= maxwidth() / n {
        maxwidth()
    } else {
        a * n
    }
}

// SubPattern.getwidth.
fn width_of(widths: ref Vec[Width], p: ref Vec[Node]) -> Width {
    let mut lo = 0;
    let mut hi = 0;
    for n in p.iter() {
        match n {
            Node.Branch(items) => {
                let mut i = maxwidth();
                let mut j = 0;
                for item in items.iter() {
                    let w = width_of(widths, item);
                    if w.lo < i {
                        i = w.lo;
                    }
                    if w.hi > j {
                        j = w.hi;
                    }
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Atomic(body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Group(_, _, _, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Repeat(_, min, max, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, mul_width(w.lo, *min));
                if *max == maxrepeat() and w.hi > 0 {
                    hi = maxwidth();
                } else {
                    hi = add_width(hi, mul_width(w.hi, *max));
                }
            }
            Node.GroupRef(g) => {
                let w = ref widths[*g];
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Exists(_, yes, no) => {
                let wy = width_of(widths, yes);
                let mut i = wy.lo;
                let mut j = wy.hi;
                if no.len() > 0 {
                    let wn = width_of(widths, no);
                    if wn.lo < i {
                        i = wn.lo;
                    }
                    if wn.hi > j {
                        j = wn.hi;
                    }
                } else {
                    i = 0;
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Lit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.NotLit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.Any => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.In(_, _) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            _ => {}
        }
    }
    Width { lo: lo, hi: hi }
}

fn category_of(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        100 => 0,
        68 => 1,
        115 => 2,
        83 => 3,
        119 => 4,
        87 => 5,
        _ => -1,
    }
}

fn escape_value(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        97 => 7,
        98 => 8,
        102 => 12,
        110 => 10,
        114 => 13,
        116 => 9,
        118 => 11,
        92 => 92,
        _ => -1,
    }
}

// \x, \u and \U: the escape text so far, and the code point.
fn hex_escape(src: mut ref Tokenizer, t: T, esc: mut ref Vec[i64]) -> Result[i64, ReErr] {
    let n = if t.b == 120 { 2 } else if t.b == 117 { 4 } else { 8 };
    src.getwhile(n, 2, mut esc)?;
    if esc.len() != n + 2 {
        return Err(src.error(f"incomplete escape {to_string(esc)}", esc.len()));
    }
    let c = digits_value(esc, 2, 16);
    if c > 0x10FFFF {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(c)
}

// _class_escape: an escape inside [...], a literal or a category.
fn class_escape(src: mut ref Tokenizer, t: T) -> Result[Item, ReErr] {
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Item.Lit(e));
    }
    let cat = category_of(t);
    if cat >= 0 {
        return Ok(Item.Cat(cat));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Item.Lit(v));
    }
    if is_oct(c) {
        src.getwhile(2, 0, mut esc)?;
        let v = digits_value(esc, 1, 8);
        if v > 0o377 {
            return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
        }
        return Ok(Item.Lit(v));
    }
    if is_dec(c) or is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Item.Lit(c))
}

// _escape: an escape outside a set.
fn escape(src: mut ref Tokenizer, t: T, st: ref ParseState) -> Result[Node, ReErr] {
    let cat = category_of(t);
    if cat >= 0 {
        let mut items: Vec[Item] = Vec.new();
        items.push(Item.Cat(cat));
        return Ok(Node.In(items, false));
    }
    match t.b {
        65 => return Ok(Node.At(at_beginning_string())),
        98 => return Ok(Node.At(at_boundary())),
        66 => return Ok(Node.At(at_non_boundary())),
        90 => return Ok(Node.At(at_end_string())),
        _ => {}
    }
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Node.Lit(e));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Node.Lit(v));
    }
    if c == 48 {
        src.getwhile(2, 0, mut esc)?;
        return Ok(Node.Lit(digits_value(esc, 1, 8)));
    }
    if is_dec(c) {
        // an octal escape or a group reference
        let nt = src.next;
        if nt.n == 1 and is_dec(nt.a) {
            esc.push(nt.a);
            src.advance()?;
            let nt2 = src.next;
            if is_oct(esc[1]) and is_oct(esc[2]) and nt2.n == 1 and is_oct(nt2.a) {
                esc.push(nt2.a);
                src.advance()?;
                let v = digits_value(esc, 1, 8);
                if v > 0o377 {
                    return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
                }
                return Ok(Node.Lit(v));
            }
        }
        let group = digits_value(esc, 1, 10);
        if group < st.groups() {
            if not st.checkgroup(group) {
                return Err(src.error("cannot refer to an open group".to_string(), esc.len()));
            }
            st.checklookbehindgroup(group, src)?;
            return Ok(Node.GroupRef(group));
        }
        return Err(src.error(f"invalid group reference {group}", esc.len() - 1));
    }
    if is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Node.Lit(c))
}

fn parse_sub(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64) -> Result[Vec[Node], ReErr] {
    let mut items: Vec[Vec[Node]] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let first = nested == 0 and items.len() == 0;
        let item = parse_seq(mut src, mut st, verbose, nested + 1, first)?;
        items.push(item);
        if not src.take(124)? {
            break;
        }
        if nested == 0 {
            verbose = (st.flags & flag_x()) != 0;
        }
    }
    if items.len() == 1 {
        return Ok(items.pop().unwrap());
    }
    let mut out: Vec[Node] = Vec.new();
    out.push(Node.Branch(items));
    Ok(out)
}

// _parse_flags: None (as Err-free Ok(None)) for global flags, else the
// flags turned on and off.
fn parse_flags(src: mut ref Tokenizer, st: mut ref ParseState, first_char: T) -> Result[Option[(i64, i64)], ReErr] {
    let mut ch = first_char;
    let mut add = 0;
    let mut del = 0;
    if not tok_is(ch, 45) {
        loop {
            let flag = flag_value(ch.a);
            if ch.a == 76 {
                return Err(src.error("bad inline flags: cannot use 'L' flag with a str pattern".to_string(), 0));
            }
            add = add | flag;
            if (flag & type_flags()) != 0 and (add & type_flags()) != flag {
                return Err(src.error("bad inline flags: flags 'a', 'u' and 'L' are incompatible".to_string(), 0));
            }
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing -, : or )".to_string(), 0));
            }
            if tok_is(ch, 41) or tok_is(ch, 45) or tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing -, : or )" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if tok_is(ch, 41) {
        st.flags = st.flags | add;
        return Ok(None);
    }
    if tok_is(ch, 45) {
        ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("missing flag".to_string(), 0));
        }
        if ch.n != 1 or flag_value(ch.a) == 0 {
            let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing flag" };
            return Err(src.error(msg.to_string(), ch.n));
        }
        loop {
            let flag = flag_value(ch.a);
            if (flag & type_flags()) != 0 {
                return Err(src.error("bad inline flags: cannot turn off flags 'a', 'u' and 'L'".to_string(), 0));
            }
            del = del | flag;
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing :".to_string(), 0));
            }
            if tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing :" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if (add & del) != 0 {
        return Err(src.error("bad inline flags: flag turned on and off".to_string(), 1));
    }
    Ok(Some((add, del)))
}

fn is_alpha(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

fn parse_set(src: mut ref Tokenizer, out: mut ref Vec[Node]) -> Result[(), ReErr] {
    let here = src.tell() - 1;
    let mut set: Vec[Item] = Vec.new();
    let negate = src.take(94)?;
    loop {
        let this = src.get()?;
        if this.n == 0 {
            return Err(src.error("unterminated character set".to_string(), src.tell() - here));
        }
        if tok_is(this, 93) and set.len() > 0 {
            break;
        }
        let code1 = if this.n == 2 { class_escape(mut src, this)? } else { Item.Lit(this.a) };
        if src.take(45)? {
            let that = src.get()?;
            if that.n == 0 {
                return Err(src.error("unterminated character set".to_string(), src.tell() - here));
            }
            if tok_is(that, 93) {
                set.push(code1);
                set.push(Item.Lit(45));
                break;
            }
            let code2 = if that.n == 2 { class_escape(mut src, that)? } else { Item.Lit(that.a) };
            let text = f"{to_string(tok_text(this))}-{to_string(tok_text(that))}";
            let offset = this.n + 1 + that.n;
            let lo = match code1 {
                Item.Lit(c) => c,
                _ => -1,
            };
            let hi = match code2 {
                Item.Lit(c) => c,
                _ => -1,
            };
            if lo < 0 or hi < 0 or hi < lo {
                return Err(src.error(f"bad character range {text}", offset));
            }
            set.push(Item.Range(lo, hi));
        } else {
            set.push(code1);
        }
    }
    if set.len() == 1 {
        let only = ref set[0];
        if let Item.Lit(c) = only {
            if negate {
                out.push(Node.NotLit(*c));
            } else {
                out.push(Node.Lit(*c));
            }
            return Ok(());
        }
    }
    out.push(Node.In(set, negate));
    Ok(())
}

// The quantifier just read (its first character is `this`), applied to
// the last item. Returns false when `{` turned out to be a literal.
fn parse_repeat(src: mut ref Tokenizer, this: T, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let here = src.tell();
    let mut min = 0;
    let mut max = maxrepeat();
    if tok_is(this, 63) {
        max = 1;
    } else if tok_is(this, 43) {
        min = 1;
    } else if tok_is(this, 123) {
        if tok_is(src.next, 125) {
            out.push(Node.Lit(123));
            return Ok(false);
        }
        let mut lo: Vec[i64] = Vec.new();
        let mut hi: Vec[i64] = Vec.new();
        while src.next.n == 1 and is_dec(src.next.a) {
            lo.push(src.get()?.a);
        }
        if src.take(44)? {
            while src.next.n == 1 and is_dec(src.next.a) {
                hi.push(src.get()?.a);
            }
        } else {
            hi = lo.clone();
        }
        if not src.take(125)? {
            out.push(Node.Lit(123));
            src.seek(here)?;
            return Ok(false);
        }
        if lo.len() > 0 {
            if lo.len() > 10 or digits_value(lo, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            min = digits_value(lo, 0, 10);
        }
        if hi.len() > 0 {
            if hi.len() > 10 or digits_value(hi, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            max = digits_value(hi, 0, 10);
            if max < min {
                return Err(src.error("min repeat greater than max repeat".to_string(), src.tell() - here));
            }
        }
    }
    if out.len() == 0 or is_at(out[out.len() - 1]) {
        return Err(src.error("nothing to repeat".to_string(), src.tell() - here + 1));
    }
    if is_repeat(out[out.len() - 1]) {
        return Err(src.error("multiple repeat".to_string(), src.tell() - here + 1));
    }
    let last = out.pop().unwrap();
    let mut body: Vec[Node] = Vec.new();
    match last {
        Node.Group(0, 0, 0, p) => body = p,
        other => body.push(other),
    }
    let kind = if src.take(63)? { 1 } else if src.take(43)? { 2 } else { 0 };
    out.push(Node.Repeat(kind, min, max, body));
    Ok(true)
}

fn parse_seq(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64, first: bool) -> Result[Vec[Node], ReErr] {
    let mut out: Vec[Node] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let this = src.next;
        if this.n == 0 or tok_is(this, 124) or tok_is(this, 41) {
            break;
        }
        src.advance()?;
        if verbose {
            if this.n == 1 and (this.a == 32 or (this.a >= 9 and this.a <= 13)) {
                continue;
            }
            if tok_is(this, 35) {
                loop {
                    let t = src.get()?;
                    if t.n == 0 or tok_is(t, 10) {
                        break;
                    }
                }
                continue;
            }
        }
        if this.n == 2 {
            let node = escape(mut src, this, st)?;
            out.push(node);
            continue;
        }
        let c = this.a;
        if c == 91 {
            parse_set(mut src, mut out)?;
        } else if c == 42 or c == 43 or c == 63 or c == 123 {
            parse_repeat(mut src, this, mut out)?;
        } else if c == 46 {
            out.push(Node.Any);
        } else if c == 94 {
            out.push(Node.At(at_beginning()));
        } else if c == 36 {
            out.push(Node.At(at_end()));
        } else if c == 40 {
            if parse_group(mut src, mut st, mut verbose, nested, first, mut out)? {
                continue;
            }
        } else {
            out.push(Node.Lit(c));
        }
    }
    Ok(out)
}

// `(` and what follows. Returns true for a construct that adds nothing
// (a comment, global flags).
fn parse_group(src: mut ref Tokenizer, st: mut ref ParseState, verbose: mut ref bool, nested: i64, first: bool, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let start = src.tell() - 1;
    let mut capture = true;
    let mut atomic = false;
    let mut name: Vec[i64] = Vec.new();
    let mut named = false;
    let mut add = 0;
    let mut del = 0;
    if src.take(63)? {
        let ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("unexpected end of pattern".to_string(), 0));
        }
        if tok_is(ch, 80) {
            if src.take(60)? {
                name = src.getuntil(62, "group name")?;
                src.checkgroupname(name, 1)?;
                named = true;
            } else if src.take(61)? {
                let ref_name = src.getuntil(41, "group name")?;
                src.checkgroupname(ref_name, 1)?;
                let gid = st.group_of(ref_name);
                if gid < 0 {
                    return Err(src.error(f"unknown group name {repr_of(ref_name)}", ref_name.len() + 1));
                }
                if not st.checkgroup(gid) {
                    return Err(src.error("cannot refer to an open group".to_string(), ref_name.len() + 1));
                }
                st.checklookbehindgroup(gid, src)?;
                out.push(Node.GroupRef(gid));
                return Ok(true);
            } else {
                let c2 = src.get()?;
                if c2.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                return Err(src.error(f"unknown extension ?P{to_string(tok_text(c2))}", c2.n + 2));
            }
        } else if tok_is(ch, 58) {
            capture = false;
        } else if tok_is(ch, 35) {
            loop {
                if src.next.n == 0 {
                    return Err(src.error("missing ), unterminated comment".to_string(), src.tell() - start));
                }
                if tok_is(src.get()?, 41) {
                    break;
                }
            }
            return Ok(true);
        } else if tok_is(ch, 61) or tok_is(ch, 33) or tok_is(ch, 60) {
            let mut kind = ch;
            let mut dir = 1;
            let mut outer_lookbehind = 0;
            if tok_is(ch, 60) {
                kind = src.get()?;
                if kind.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                if not (tok_is(kind, 61) or tok_is(kind, 33)) {
                    return Err(src.error(f"unknown extension ?<{to_string(tok_text(kind))}", kind.n + 2));
                }
                dir = -1;
                outer_lookbehind = st.lookbehind_groups;
                if outer_lookbehind < 0 {
                    st.lookbehind_groups = st.groups();
                }
            }
            let p = parse_sub(mut src, mut st, *verbose, nested + 1)?;
            if dir < 0 and outer_lookbehind < 0 {
                st.lookbehind_groups = -1;
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            if tok_is(kind, 61) {
                out.push(Node.Assert(dir, false, p));
            } else if p.len() > 0 {
                out.push(Node.Assert(dir, true, p));
            } else {
                out.push(Node.Failure);
            }
            return Ok(true);
        } else if tok_is(ch, 40) {
            let condname = src.getuntil(41, "group name")?;
            let mut condgroup = 0;
            if not is_ascii_decimal(condname) {
                src.checkgroupname(condname, 1)?;
                condgroup = st.group_of(condname);
                if condgroup < 0 {
                    return Err(src.error(f"unknown group name {repr_of(condname)}", condname.len() + 1));
                }
            } else {
                if condname.len() > 10 {
                    return Err(src.error(f"invalid group reference {to_string(condname)}", condname.len() + 1));
                }
                condgroup = digits_value(condname, 0, 10);
                if condgroup == 0 {
                    return Err(src.error("bad group number".to_string(), condname.len() + 1));
                }
                if condgroup >= maxgroups() {
                    return Err(src.error(f"invalid group reference {condgroup}", condname.len() + 1));
                }
                let mut seen = false;
                for (g, _) in st.refpos.iter() {
                    if *g == condgroup {
                        seen = true;
                    }
                }
                if not seen {
                    st.refpos.push((condgroup, src.tell() - condname.len() - 1));
                }
            }
            st.checklookbehindgroup(condgroup, src)?;
            let yes = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
            let mut no: Vec[Node] = Vec.new();
            if src.take(124)? {
                no = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
                if tok_is(src.next, 124) {
                    return Err(src.error("conditional backref with more than two branches".to_string(), 0));
                }
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            out.push(Node.Exists(condgroup, yes, no));
            return Ok(true);
        } else if tok_is(ch, 62) {
            capture = false;
            atomic = true;
        } else if (ch.n == 1 and flag_value(ch.a) != 0) or tok_is(ch, 45) {
            match parse_flags(mut src, mut st, ch)? {
                None => {
                    if not first or out.len() > 0 {
                        return Err(src.error("global flags not at the start of the expression".to_string(), src.tell() - start));
                    }
                    *verbose = (st.flags & flag_x()) != 0;
                    return Ok(true);
                }
                Some((a, d)) => {
                    add = a;
                    del = d;
                    capture = false;
                }
            }
        } else {
            return Err(src.error(f"unknown extension ?{to_string(tok_text(ch))}", ch.n + 1));
        }
    }
    let mut group = 0;
    if capture {
        group = st.groups();
        st.closed.push(false);
        st.widths.push(Width { lo: 0, hi: 0 });
        if named {
            let was = st.group_of(name);
            if was >= 0 {
                return Err(src.error(f"redefinition of group name {repr_of(name)} as group {group}; was group {was}", name.len() + 1));
            }
            st.names.push((name.clone(), group));
        }
    }
    let sub_verbose = (*verbose or (add & flag_x()) != 0) and (del & flag_x()) == 0;
    let p = parse_sub(mut src, mut st, sub_verbose, nested + 1)?;
    if not src.take(41)? {
        return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
    }
    if group > 0 {
        let w = width_of(st.widths, p);
        st.widths[group] = w;
        st.closed[group] = true;
    }
    if atomic {
        out.push(Node.Atomic(p));
    } else {
        out.push(Node.Group(group, add, del, p));
    }
    Ok(false)
}

struct Parsed {
    nodes: Vec[Node],
    flags: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
    widths: Vec[Width],
}

fn parse(pattern: ref Vec[i64], flags: i64) -> Result[Parsed, ReErr] {
    let mut src = new_tokenizer(pattern)?;
    let mut st = ParseState {
        flags: flags,
        names: Vec.new(),
        closed: Vec.new(),
        widths: Vec.new(),
        lookbehind_groups: -1,
        refpos: Vec.new(),
    };
    // group 0 is the whole match
    st.closed.push(true);
    st.widths.push(Width { lo: 0, hi: 0 });
    let nodes = parse_sub(mut src, mut st, (flags & flag_x()) != 0, 0)?;
    if (st.flags & flag_a()) != 0 and (st.flags & flag_u()) != 0 {
        return Err(other_error("ValueError", "ASCII and UNICODE flags are incompatible".to_string()));
    }
    if src.next.n != 0 {
        return Err(src.error("unbalanced parenthesis".to_string(), 0));
    }
    for (g, pos) in st.refpos.iter() {
        if *g >= st.groups() {
            return Err(re_error(f"invalid group reference {*g}", *pos));
        }
    }
    let groups = st.groups() - 1;
    Ok(Parsed { nodes: nodes, flags: st.flags, groups: groups, names: st.names, widths: st.widths })
}

// ---------------------------------------------------------- compiler

enum Op {
    // character (lowered when case-insensitive), case-insensitive, ASCII
    Lit(i64, bool, bool),
    NotLit(i64, bool, bool),
    Any,
    AnyAll,
    // set, case-insensitive, ASCII-only categories
    In(i64, bool, bool),
    // anchor kind, ASCII-only word boundary
    At(i64, bool),
    Mark(i64),
    Split(i64, i64),
    Jmp(i64),
    // repeat register, the Until it starts at
    RepInit(i64, i64),
    // register, min, max, greedy, body, exit
    Until(i64, i64, i64, bool, i64, i64),
    Ref(i64, bool, bool),
    // lookbehind width (-1 for lookahead), negative, sub-program, next
    Look(i64, bool, i64, i64),
    Atomic(i64, i64),
    Exists(i64, i64),
    Fail,
    Succeed,
    Match,
}

struct Program {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
}

struct CharSet {
    items: Vec[Item],
    negate: bool,
}

fn combine(flags: i64, add: i64, del: i64) -> i64 {
    let mut f = flags;
    if (add & type_flags()) != 0 {
        f = f & (0x7FFFFFFF ^ type_flags());
    }
    (f | add) & (0x7FFFFFFF ^ del)
}

struct Compiler {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
}

impl Compiler {
    fn emit(mut ref self, op: own Op) -> i64 {
        self.ops.push(op);
        self.ops.len() - 1
    }

    fn here(ref self) -> i64 {
        self.ops.len()
    }

    fn compile(mut ref self, p: ref Parsed, nodes: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let icase = (flags & flag_i()) != 0;
        let ascii = (flags & flag_a()) != 0;
        for n in nodes.iter() {
            match n {
                Node.Lit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.Lit(v, icase, ascii));
                }
                Node.NotLit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.NotLit(v, icase, ascii));
                }
                Node.Any => {
                    if (flags & flag_s()) != 0 {
                        self.emit(Op.AnyAll);
                    } else {
                        self.emit(Op.Any);
                    }
                }
                Node.In(items, negate) => {
                    self.sets.push(CharSet { items: items.clone(), negate: *negate });
                    let idx = self.sets.len() - 1;
                    self.emit(Op.In(idx, icase, ascii));
                }
                Node.At(kind) => {
                    let mut k = *kind;
                    if (flags & flag_m()) != 0 {
                        if k == at_beginning() {
                            k = at_beginning_line();
                        } else if k == at_end() {
                            k = at_end_line();
                        }
                    }
                    self.emit(Op.At(k, ascii));
                }
                Node.Branch(items) => {
                    let mut ends: Vec[i64] = Vec.new();
                    let mut i = 0;
                    while i < items.len() {
                        if i + 1 < items.len() {
                            let split = self.emit(Op.Fail);
                            self.compile(p, items[i], flags)?;
                            ends.push(self.emit(Op.Fail));
                            let next = self.here();
                            self.ops[split] = Op.Split(split + 1, next);
                        } else {
                            self.compile(p, items[i], flags)?;
                        }
                        i += 1;
                    }
                    let end = self.here();
                    for at in ends {
                        self.ops[at] = Op.Jmp(end);
                    }
                }
                Node.Group(g, add, off, body) => {
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g));
                    }
                    self.compile(p, body, combine(flags, *add, *off))?;
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g + 1));
                    }
                }
                Node.Repeat(kind, min, max, body) => {
                    if *kind == 2 {
                        let at = self.emit(Op.Fail);
                        self.compile_repeat(p, *min, *max, true, body, flags)?;
                        self.emit(Op.Succeed);
                        let next = self.here();
                        self.ops[at] = Op.Atomic(at + 1, next);
                    } else {
                        self.compile_repeat(p, *min, *max, *kind == 0, body, flags)?;
                    }
                }
                Node.Atomic(body) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Atomic(at + 1, next);
                }
                Node.Assert(dir, negative, body) => {
                    let mut width = -1;
                    if *dir < 0 {
                        let w = width_of(p.widths, body);
                        if w.lo != w.hi {
                            return Err(other_error("error", "look-behind requires fixed-width pattern".to_string()));
                        }
                        width = w.lo;
                    }
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Look(width, *negative, at + 1, next);
                }
                Node.GroupRef(g) => {
                    self.emit(Op.Ref(*g, icase, ascii));
                }
                Node.Exists(g, yes, no) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, yes, flags)?;
                    if no.len() > 0 {
                        let jump = self.emit(Op.Fail);
                        let no_pc = self.here();
                        self.compile(p, no, flags)?;
                        let end = self.here();
                        self.ops[jump] = Op.Jmp(end);
                        self.ops[at] = Op.Exists(*g, no_pc);
                    } else {
                        let end = self.here();
                        self.ops[at] = Op.Exists(*g, end);
                    }
                }
                Node.Failure => {
                    self.emit(Op.Fail);
                }
            }
        }
        Ok(())
    }

    fn compile_repeat(mut ref self, p: ref Parsed, min: i64, max: i64, greedy: bool, body: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let r = self.repeats;
        self.repeats += 1;
        let init = self.emit(Op.Fail);
        self.compile(p, body, flags)?;
        let until = self.emit(Op.Fail);
        self.ops[init] = Op.RepInit(r, until);
        self.ops[until] = Op.Until(r, min, max, greedy, init + 1, until + 1);
        Ok(())
    }
}

fn compile(pattern: ref Vec[i64], flags: i64) -> Result[Program, ReErr] {
    let p = parse(pattern, flags)?;
    let mut c = Compiler { ops: Vec.new(), sets: Vec.new(), repeats: 0 };
    c.compile(p, p.nodes, p.flags)?;
    c.emit(Op.Match);
    Ok(Program { ops: c.ops, sets: c.sets, repeats: c.repeats, groups: p.groups, names: p.names })
}

// ----------------------------------------------------------- matcher

struct Undo {
    kind: i64,
    idx: i64,
    old: i64,
}

struct Choice {
    pc: i64,
    pos: i64,
    trail: i64,
    // 0: resume at pc; 1: a lazy repeat's Until, after its tail failed
    mode: i64,
}

struct Matcher {
    s: Vec[i64],
    marks: Vec[i64],
    counts: Vec[i64],
    lasts: Vec[i64],
    lastindex: i64,
    trail: Vec[Undo],
    start: i64,
    must_advance: bool,
    match_all: bool,
}

impl Matcher {
    fn set_mark(mut ref self, slot: i64, v: i64) {
        self.trail.push(Undo { kind: 0, idx: slot, old: self.marks[slot] });
        self.marks[slot] = v;
    }

    fn set_count(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 1, idx: r, old: self.counts[r] });
        self.counts[r] = v;
    }

    fn set_last(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 2, idx: r, old: self.lasts[r] });
        self.lasts[r] = v;
    }

    fn set_lastindex(mut ref self, v: i64) {
        self.trail.push(Undo { kind: 3, idx: 0, old: self.lastindex });
        self.lastindex = v;
    }

    fn undo_to(mut ref self, len: i64) {
        while self.trail.len() > len {
            let u = self.trail.pop().unwrap();
            if u.kind == 0 {
                self.marks[u.idx] = u.old;
            } else if u.kind == 1 {
                self.counts[u.idx] = u.old;
            } else if u.kind == 2 {
                self.lasts[u.idx] = u.old;
            } else {
                self.lastindex = u.old;
            }
        }
    }

    // A group that has both marks, the end not before the start.
    fn group_span(ref self, g: i64) -> (i64, i64) {
        let a = self.marks[2 * g];
        let b = self.marks[2 * g + 1];
        if a < 0 or b < 0 or b < a {
            return (-1, -1);
        }
        (a, b)
    }

    fn at(ref self, kind: i64, ascii: bool, pos: i64) -> bool {
        let n = self.s.len();
        if kind == 0 or kind == 2 {
            return pos == 0;
        }
        if kind == 1 {
            return pos == 0 or self.s[pos - 1] == 10;
        }
        if kind == 3 {
            return pos == n or (pos == n - 1 and self.s[pos] == 10);
        }
        if kind == 4 {
            return pos == n or self.s[pos] == 10;
        }
        if kind == 5 {
            return pos == n;
        }
        if n == 0 {
            return false;
        }
        let before = pos > 0 and is_word(self.s[pos - 1], ascii);
        let after = pos < n and is_word(self.s[pos], ascii);
        if kind == 6 { before != after } else { before == after }
    }

    // Runs the program from pc at pos, backtracking through its own
    // choices only. Returns where it succeeded, or -1.
    fn run(mut ref self, prog: ref Program, pc0: i64, pos0: i64, top: bool) -> i64 {
        let base = self.trail.len();
        let mut choices: Vec[Choice] = Vec.new();
        let mut pc = pc0;
        let mut pos = pos0;
        let mut mode = 0;
        loop {
            let mut ok = true;
            let op = ref prog.ops[pc];
            if mode == 1 {
                // a lazy repeat whose tail failed: try one more item
                mode = 0;
                ok = false;
                if let Op.Until(r, _, max, _, body, _) = op {
                    let count = self.counts[*r] + 1;
                    if not ((count >= *max and *max != maxrepeat()) or pos == self.lasts[*r]) {
                        self.set_count(*r, count);
                        self.set_last(*r, pos);
                        pc = *body;
                        ok = true;
                    }
                }
                if ok {
                    continue;
                }
            } else {
                match op {
                    Op.Lit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) == *c } else { self.s[pos] == *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.NotLit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) != *c } else { self.s[pos] != *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Any => {
                        if pos < self.s.len() and self.s[pos] != 10 {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.AnyAll => {
                        if pos < self.s.len() {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.In(set, icase, ascii) => {
                        if pos < self.s.len() and in_set(prog.sets[*set], self.s[pos], *icase, *ascii) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.At(kind, ascii) => {
                        if self.at(*kind, *ascii, pos) {
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Mark(slot) => {
                        self.set_mark(*slot, pos);
                        if (*slot & 1) == 1 {
                            self.set_lastindex(*slot / 2);
                        }
                        pc += 1;
                    }
                    Op.Split(a, b) => {
                        choices.push(Choice { pc: *b, pos: pos, trail: self.trail.len(), mode: 0 });
                        pc = *a;
                    }
                    Op.Jmp(a) => pc = *a,
                    Op.RepInit(r, until) => {
                        self.set_count(*r, -1);
                        self.set_last(*r, -1);
                        pc = *until;
                    }
                    Op.Until(r, min, max, greedy, body, exit) => {
                        let count = self.counts[*r] + 1;
                        if count < *min {
                            self.set_count(*r, count);
                            pc = *body;
                        } else if *greedy {
                            if (count < *max or *max == maxrepeat()) and pos != self.lasts[*r] {
                                choices.push(Choice { pc: *exit, pos: pos, trail: self.trail.len(), mode: 0 });
                                self.set_count(*r, count);
                                self.set_last(*r, pos);
                                pc = *body;
                            } else {
                                pc = *exit;
                            }
                        } else {
                            choices.push(Choice { pc: pc, pos: pos, trail: self.trail.len(), mode: 1 });
                            pc = *exit;
                        }
                    }
                    Op.Ref(g, icase, ascii) => {
                        let (a, b) = self.group_span(*g);
                        if a < 0 {
                            ok = false;
                        } else {
                            let len = b - a;
                            if pos + len > self.s.len() {
                                ok = false;
                            } else {
                                let mut k = 0;
                                while k < len {
                                    let x = self.s[a + k];
                                    let y = self.s[pos + k];
                                    let eq = if *icase { lower(x, *ascii) == lower(y, *ascii) } else { x == y };
                                    if not eq {
                                        ok = false;
                                        break;
                                    }
                                    k += 1;
                                }
                                if ok {
                                    pos += len;
                                    pc += 1;
                                }
                            }
                        }
                    }
                    Op.Look(width, negative, sub, next) => {
                        let mark = self.trail.len();
                        let from = if *width < 0 { pos } else { pos - *width };
                        let found = from >= 0 and self.run(prog, *sub, from, false) >= 0;
                        if *negative {
                            self.undo_to(mark);
                            if found {
                                ok = false;
                            } else {
                                pc = *next;
                            }
                        } else if found {
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Atomic(sub, next) => {
                        let end = self.run(prog, *sub, pos, false);
                        if end >= 0 {
                            pos = end;
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Exists(g, no) => {
                        let (a, _) = self.group_span(*g);
                        if a >= 0 {
                            pc += 1;
                        } else {
                            pc = *no;
                        }
                    }
                    Op.Fail => ok = false,
                    Op.Succeed => return pos,
                    Op.Match => {
                        if top and ((self.match_all and pos != self.s.len()) or (self.must_advance and pos == self.start)) {
                            ok = false;
                        } else {
                            return pos;
                        }
                    }
                }
            }
            if not ok {
                match choices.pop() {
                    Some(ch) => {
                        self.undo_to(ch.trail);
                        pc = ch.pc;
                        pos = ch.pos;
                        mode = ch.mode;
                    }
                    None => {
                        self.undo_to(base);
                        return -1;
                    }
                }
            }
        }
    }
}

fn in_items(set: ref CharSet, c: i64, ascii: bool) -> bool {
    for item in set.items.iter() {
        let hit = match item {
            Item.Lit(l) => c == *l,
            Item.Range(lo, hi) => c >= *lo and c <= *hi,
            Item.Cat(k) => {
                let kind = *k;
                if kind == 0 {
                    if ascii { c >= 48 and c <= 57 } else { is_decimal(c) }
                } else if kind == 1 {
                    if ascii { not (c >= 48 and c <= 57) } else { not is_decimal(c) }
                } else if kind == 2 {
                    is_space(c, ascii)
                } else if kind == 3 {
                    not is_space(c, ascii)
                } else if kind == 4 {
                    is_word(c, ascii)
                } else {
                    not is_word(c, ascii)
                }
            }
        };
        if hit {
            return true;
        }
    }
    false
}

// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = lower(c, ascii);
        if lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program, s: ref Vec[i64]) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        s: s.clone(),
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn find(m: mut ref Matcher, prog: ref Program, from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= m.s.len() {
        let mut k = 0;
        let nmarks = 2 * (prog.groups + 1);
        while k < nmarks {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}

// All the matches finditer gives: each search starts where the last
// match ended, and must move on past an empty one.
fn all_matches(prog: ref Program, s: ref Vec[i64], limit: i64) -> Vec[Found] {
    let mut m = new_matcher(prog, s);
    let mut out: Vec[Found] = Vec.new();
    let mut pos = 0;
    let mut must_advance = false;
    while pos <= s.len() and (limit == 0 or out.len() < limit) {
        match find(mut m, prog, pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    out
}

// ------------------------------------------------------- text helpers

fn to_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn cps(s: Str) -> Vec[i64] {
    codepoints(to_bytes(s))
}

fn cp_text(s: ref Vec[i64], a: i64, b: i64) -> String {
    to_string(slice(s, a, b))
}

fn sv(v: Vec[Str]) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for s in v.iter() {
        out.push(s.to_string());
    }
    out
}

fn has(v: ref Vec[String], s: Str) -> bool {
    for x in v.iter() {
        if x == s {
            return true;
        }
    }
    false
}

fn join(v: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    let mut first = true;
    for x in v.iter() {
        if not first {
            out.push_str(sep);
        }
        out.push_str(x);
        first = false;
    }
    out
}

fn ends_with_nl(s: Str) -> bool {
    s.len() > 0 and to_bytes(s)[s.len() - 1] == b'\n'
}

// Python's repr of a str: str_repr from the re port.
fn py_repr(s: Str) -> String {
    repr_of(cps(s))
}

// ascii(): repr with every non-ASCII character escaped, as the raw
// token formatter's b"%r" writes it.
fn py_ascii(s: Str) -> String {
    let v = cps(s);
    let mut has_single = false;
    let mut has_double = false;
    for c in v.iter() {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    let mut out: Vec[i64] = Vec.new();
    out.push(quote);
    for c in v.iter() {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c >= 0x20 and c < 0x7F {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
    to_string(out)
}

fn is_py_space(c: i64) -> bool {
    is_space(c, false)
}

// str.strip() and str.strip('\n')
fn py_strip(s: Str) -> String {
    let v = cps(s);
    let mut a = 0;
    let mut b = v.len();
    while a < b and is_py_space(v[a]) {
        a += 1;
    }
    while b > a and is_py_space(v[b - 1]) {
        b -= 1;
    }
    cp_text(v, a, b)
}

fn strip_nl(s: Str) -> String {
    let b = to_bytes(s);
    let mut i = 0;
    let mut j = b.len();
    while i < j and b[i] == b'\n' {
        i += 1;
    }
    while j > i and b[j - 1] == b'\n' {
        j -= 1;
    }
    slice_str(s, i, j)
}

fn slice_str(s: Str, a: i64, b: i64) -> String {
    let bytes = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    let mut i = a;
    while i < b {
        out.push(bytes[i]);
        i += 1;
    }
    String.from_utf8(out).unwrap()
}

// str.expandtabs(n): columns restart after \n and \r.
fn expand_tabs(s: Str, n: i64) -> String {
    let v = cps(s);
    let mut out: Vec[i64] = Vec.new();
    let mut col = 0;
    for c in v.iter() {
        if c == 9 {
            if n > 0 {
                let k = n - col % n;
                for _ in 0..k {
                    out.push(32);
                }
                col += k;
            }
        } else if c == 10 or c == 13 {
            out.push(c);
            col = 0;
        } else {
            out.push(c);
            col += 1;
        }
    }
    to_string(out)
}

fn replace_all(s: Str, from: Str, to: Str) -> String {
    let b = to_bytes(s);
    let f = to_bytes(from);
    let mut out = String.new();
    let mut i = 0;
    let mut start = 0;
    while i + f.len() <= b.len() {
        let mut ok = true;
        let mut k = 0;
        while k < f.len() {
            if b[i + k] != f[k] {
                ok = false;
                break;
            }
            k += 1;
        }
        if ok {
            out.push_str(slice_str(s, start, i));
            out.push_str(to);
            i += f.len();
            start = i;
        } else {
            i += 1;
        }
    }
    out.push_str(slice_str(s, start, b.len()));
    out
}

// str.split(sep) for a one-byte separator, keeping empty pieces.
fn split_char(s: Str, sep: u8) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut start = 0;
    let mut i = 0;
    while i < b.len() {
        if b[i] == sep {
            out.push(slice_str(s, start, i));
            start = i + 1;
        }
        i += 1;
    }
    out.push(slice_str(s, start, b.len()));
    out
}

// str.split() with no argument
fn split_ws(s: Str) -> Vec[String] {
    let v = cps(s);
    let mut out: Vec[String] = Vec.new();
    let mut i = 0;
    while i < v.len() {
        while i < v.len() and is_py_space(v[i]) {
            i += 1;
        }
        if i >= v.len() {
            break;
        }
        let a = i;
        while i < v.len() and not is_py_space(v[i]) {
            i += 1;
        }
        out.push(cp_text(v, a, i));
    }
    out
}

// The first `sep` splits s in two, or None.
fn split_once(s: Str, sep: u8) -> Option[(String, String)] {
    let b = to_bytes(s);
    let mut i = 0;
    while i < b.len() {
        if b[i] == sep {
            return Some((slice_str(s, 0, i), slice_str(s, i + 1, b.len())));
        }
        i += 1;
    }
    None
}

// str.splitlines(True)
fn is_line_break(c: i64) -> bool {
    c == 10 or c == 13 or c == 11 or c == 12 or c == 0x1C or c == 0x1D or c == 0x1E or c == 0x85 or c == 0x2028 or c == 0x2029
}

fn splitlines_keep(s: Str) -> Vec[String] {
    let v = cps(s);
    let mut out: Vec[String] = Vec.new();
    let mut i = 0;
    let mut start = 0;
    while i < v.len() {
        if is_line_break(v[i]) {
            let mut end = i + 1;
            if v[i] == 13 and i + 1 < v.len() and v[i + 1] == 10 {
                end = i + 2;
            }
            out.push(cp_text(v, start, end));
            start = end;
            i = end;
        } else {
            i += 1;
        }
    }
    if start < v.len() {
        out.push(cp_text(v, start, v.len()));
    }
    out
}

fn rstrip_nl(s: Str) -> String {
    let b = to_bytes(s);
    let mut j = b.len();
    while j > 0 and b[j - 1] == b'\n' {
        j -= 1;
    }
    slice_str(s, 0, j)
}

fn escape_html(s: Str) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c == '&' {
            out.push_str("&amp;");
        } else if c == '<' {
            out.push_str("&lt;");
        } else if c == '>' {
            out.push_str("&gt;");
        } else if c == '"' {
            out.push_str("&quot;");
        } else if c == '\'' {
            out.push_str("&#39;");
        } else {
            out.push(c);
        }
    }
    out
}

fn case_upper(s: Str) -> String {
    let mut v = cps(s);
    for i in 0..v.len() {
        v[i] = upper(v[i], false);
    }
    to_string(v)
}

fn case_lower(s: Str) -> String {
    let mut v = cps(s);
    for i in 0..v.len() {
        v[i] = lower(v[i], false);
    }
    to_string(v)
}

fn case_capitalize(s: Str) -> String {
    let mut v = cps(s);
    for i in 0..v.len() {
        v[i] = if i == 0 { upper(v[i], false) } else { lower(v[i], false) };
    }
    to_string(v)
}

// int() of a str: optional sign, digits with single underscores, and
// surrounding whitespace.
fn py_int(s: Str) -> Option[i64] {
    let v = cps(s);
    let mut a = 0;
    let mut b = v.len();
    while a < b and is_py_space(v[a]) {
        a += 1;
    }
    while b > a and is_py_space(v[b - 1]) {
        b -= 1;
    }
    let mut neg = false;
    if a < b and (v[a] == 43 or v[a] == 45) {
        neg = v[a] == 45;
        a += 1;
    }
    if a >= b {
        return None;
    }
    let mut n = 0;
    let mut prev_us = true;
    let mut i = a;
    while i < b {
        let c = v[i];
        if c == 95 {
            if prev_us {
                return None;
            }
            prev_us = true;
        } else if is_decimal(c) and c >= 48 and c <= 57 {
            n = n * 10 + (c - 48);
            prev_us = false;
        } else {
            return None;
        }
        i += 1;
    }
    if prev_us {
        return None;
    }
    Some(if neg { -n } else { n })
}

fn pad_left(s: Str, width: i64, fill: Str) -> String {
    let mut out = String.new();
    let mut n = s.chars().count();
    while n < width {
        out.push_str(fill);
        n += 1;
    }
    out.push_str(s);
    out
}

fn spaces(n: i64) -> String {
    let mut out = String.new();
    for _ in 0..n {
        out.push(' ');
    }
    out
}

// ------------------------------------------------- errors and options

#[derive(Clone)]
struct PgErr {
    kind: String,
    msg: String,
}

fn class_not_found(msg: own String) -> PgErr {
    PgErr { kind: "ClassNotFound".to_string(), msg: msg }
}

fn option_error(msg: own String) -> PgErr {
    PgErr { kind: "OptionError".to_string(), msg: msg }
}

// An option value as pygmentize hands it on: a string, or True for a
// bare name.
#[derive(Clone)]
enum Opt {
    S(String),
    T,
}

fn opt_repr(o: ref Opt) -> String {
    match o {
        Opt.S(s) => py_repr(s),
        Opt.T => "True".to_string(),
    }
}

fn opt_get(opts: ref Vec[(String, Opt)], name: Str) -> Option[Opt] {
    for (k, v) in opts.iter() {
        if k == name {
            return Some(v.clone());
        }
    }
    None
}

fn opt_set(opts: mut ref Vec[(String, Opt)], name: Str, v: own Opt) {
    for i in 0..opts.len() {
        if opts[i].0 == name {
            opts[i].1 = v;
            return;
        }
    }
    opts.push((name.to_string(), v));
}

// pygmentize's _parse_options for one -O string
fn parse_opts(text: Str) -> Vec[(String, Opt)] {
    let mut opts: Vec[(String, Opt)] = Vec.new();
    if py_strip(text).len() == 0 {
        return opts;
    }
    for piece in split_char(text, b',').iter() {
        let arg = py_strip(piece);
        match split_once(arg, b'=') {
            Some((k, v)) => opt_set(mut opts, py_strip(k), Opt.S(py_strip(v))),
            None => opt_set(mut opts, arg, Opt.T),
        }
    }
    opts
}

fn opts_repr(opts: ref Vec[(String, Opt)]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for (k, v) in opts.iter() {
        parts.push(f"{py_repr(k)}: {opt_repr(v)}");
    }
    "{" + join(parts, ", ") + "}"
}

fn get_bool_opt(opts: ref Vec[(String, Opt)], name: Str, default: bool) -> Result[bool, PgErr] {
    match opt_get(opts, name) {
        None => Ok(default),
        Some(Opt.T) => Ok(true),
        Some(Opt.S(s)) => {
            let l = case_lower(s);
            if l == "1" or l == "yes" or l == "true" or l == "on" {
                Ok(true)
            } else if l == "0" or l == "no" or l == "false" or l == "off" {
                Ok(false)
            } else {
                Err(option_error(f"Invalid value {py_repr(s)} for option {name}; use 1/0, yes/no, true/false, on/off"))
            }
        }
    }
}

fn get_int_opt(opts: ref Vec[(String, Opt)], name: Str, default: i64) -> Result[i64, PgErr] {
    match opt_get(opts, name) {
        None => Ok(default),
        Some(Opt.T) => Ok(1),
        Some(Opt.S(s)) => match py_int(s) {
            Some(n) => Ok(n),
            None => Err(option_error(f"Invalid value {py_repr(s)} for option {name}; you must give an integer value")),
        },
    }
}

fn get_list_opt(opts: ref Vec[(String, Opt)], name: Str, default: ref Vec[String]) -> Result[Vec[String], PgErr] {
    match opt_get(opts, name) {
        None => Ok(default.clone()),
        Some(Opt.T) => Err(option_error(f"Invalid type True for option {name}; you must give a list value")),
        Some(Opt.S(s)) => Ok(split_ws(s)),
    }
}

fn get_choice_opt(opts: ref Vec[(String, Opt)], name: Str, allowed: ref Vec[String], default: Str) -> Result[String, PgErr] {
    let v = match opt_get(opts, name) {
        None => Some(default.to_string()),
        Some(Opt.T) => None,
        Some(Opt.S(s)) => Some(s),
    };
    if let Some(s) = v {
        if has(allowed, s) {
            return Ok(s);
        }
    }
    Err(option_error(f"Value for option {name} must be one of {join(allowed, ", ")}"))
}

// options.get(name, default) where the value is used as text
fn get_str_opt(opts: ref Vec[(String, Opt)], name: Str, default: Str) -> String {
    match opt_get(opts, name) {
        None => default.to_string(),
        Some(Opt.T) => "True".to_string(),
        Some(Opt.S(s)) => s,
    }
}

// options.get(name, False) used as a truth value
fn get_truthy(opts: ref Vec[(String, Opt)], name: Str) -> bool {
    match opt_get(opts, name) {
        None => false,
        Some(Opt.T) => true,
        Some(Opt.S(s)) => s.len() > 0,
    }
}

// ------------------------------------------------------- token types
// A token type is its dotted path below Token: "" is Token itself,
// "Name.Builtin" is Token.Name.Builtin.

fn tok_repr(t: Str) -> String {
    if t.len() == 0 { "Token".to_string() } else { f"Token.{t}" }
}

fn tok_parent(t: Str) -> Option[String] {
    if t.len() == 0 {
        return None;
    }
    let b = to_bytes(t);
    let mut i = b.len() - 1;
    while i >= 0 {
        if b[i] == b'.' {
            return Some(slice_str(t, 0, i));
        }
        i -= 1;
    }
    Some(String.new())
}

fn tok_last(t: Str) -> String {
    let b = to_bytes(t);
    let mut i = b.len() - 1;
    while i >= 0 {
        if b[i] == b'.' {
            return slice_str(t, i + 1, b.len());
        }
        i -= 1;
    }
    t.to_string()
}

fn tok_len(t: Str) -> i64 {
    if t.len() == 0 {
        return 0;
    }
    let mut n = 1;
    for b in t.bytes() {
        if b == b'.' {
            n += 1;
        }
    }
    n
}

// `t in base`
fn tok_in(t: Str, base: Str) -> bool {
    if base.len() == 0 {
        return true;
    }
    if t == base {
        return true;
    }
    t.len() > base.len() and t.starts_with(base) and to_bytes(t)[base.len()] == b'.'
}

// ttype.split(): Token, then each ancestor down to ttype
fn tok_split(t: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    out.push(String.new());
    if t.len() == 0 {
        return out;
    }
    let b = to_bytes(t);
    let mut i = 0;
    while i < b.len() {
        if b[i] == b'.' {
            out.push(slice_str(t, 0, i));
        }
        i += 1;
    }
    out.push(t.to_string());
    out
}

fn string_to_tokentype(s: Str) -> String {
    s.to_string()
}

struct Std {
    order: Vec[String],
    short: Map[String, String],
}

fn new_std() -> Std {
    let mut order: Vec[String] = Vec.new();
    let mut short: Map[String, String] = Map.new();
    for (t, s) in standard_types().iter() {
        order.push(t.clone());
        short.insert(t.clone(), s.clone());
    }
    Std { order: order, short: short }
}

// a token and its text
#[derive(Clone)]
struct Tk {
    t: String,
    v: String,
}

// ------------------------------------------------- lexer definitions
// What a RegexLexer class writes in its `tokens` dict, before
// RegexLexerMeta processes it.

struct LexInfo {
    cls: String,
    name: String,
    aliases: Vec[String],
    filenames: Vec[String],
    mimetypes: Vec[String],
    priority: f64,
}

enum Pat {
    Re(String),
    Words(Vec[String], String, String),
}

#[derive(Clone)]
enum Act {
    Skip,
    Tok(String),
    Groups(Vec[Act]),
    // using(other or "this", state stack)
    Using(String, Vec[String]),
}

enum RawNew {
    NoNew,
    Name(String),
    Combined(Vec[String]),
    Tuple(Vec[String]),
}

enum RawRule {
    Include(String),
    Inherit,
    Default(RawNew),
    Rule(Pat, Act, RawNew),
}

struct ClassDef {
    name: String,
    // the classes of its MRO that have their own `tokens`, itself first
    mro: Vec[String],
    flags: i64,
    states: Vec[(String, Vec[RawRule])],
}

// ------------------------------------------------------------ regexopt

fn re_escape(s: Str) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c == '(' or c == ')' or c == '[' or c == ']' or c == '{' or c == '}' or c == '?' or c == '*' or c == '+' or c == '-' or c == '|' or c == '^' or c == '$' or c == '\\' or c == '.' or c == '&' or c == '~' or c == '#' or c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == '\u{b}' or c == '\u{c}' {
            out.push('\\');
        }
        out.push(c);
    }
    out
}

fn make_charset(letters: ref Vec[String]) -> String {
    let mut out = "[".to_string();
    for l in letters.iter() {
        if l == "[" or l == "^" or l == "\\" or l == "-" or l == "]" {
            out.push('\\');
        }
        out.push_str(l);
    }
    out.push(']');
    out
}

fn common_prefix(v: ref Vec[Vec[i64]]) -> Vec[i64] {
    let mut p = v[0].clone();
    for s in v.iter() {
        let mut k = 0;
        while k < p.len() and k < s.len() and p[k] == s[k] {
            k += 1;
        }
        p = slice(p, 0, k);
    }
    p
}

fn sort_cps(v: mut ref Vec[Vec[i64]]) {
    // insertion sort keeps it simple; the lists are short
    let mut i = 1;
    while i < v.len() {
        let mut j = i;
        while j > 0 and cp_less(v[j], v[j - 1]) {
            let t = v[j].clone();
            v[j] = v[j - 1].clone();
            v[j - 1] = t;
            j -= 1;
        }
        i += 1;
    }
}

fn cp_less(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    let mut k = 0;
    while k < a.len() and k < b.len() {
        if a[k] != b[k] {
            return a[k] < b[k];
        }
        k += 1;
    }
    a.len() < b.len()
}

fn reversed(s: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = s.len() - 1;
    while i >= 0 {
        out.push(s[i]);
        i -= 1;
    }
    out
}

fn regex_opt_inner(strings: ref Vec[Vec[i64]], open_paren: Str) -> String {
    let close_paren = if open_paren.len() > 0 { ")" } else { "" };
    if strings.len() == 0 {
        return String.new();
    }
    let first = strings[0].clone();
    if strings.len() == 1 {
        return f"{open_paren}{re_escape(to_string(first))}{close_paren}";
    }
    if first.len() == 0 {
        let rest = slice_vecs(strings, 1, strings.len());
        return f"{open_paren}{regex_opt_inner(rest, "(?:")}?{close_paren}";
    }
    if first.len() == 1 {
        let mut oneletter: Vec[String] = Vec.new();
        let mut rest: Vec[Vec[i64]] = Vec.new();
        for s in strings.iter() {
            if s.len() == 1 {
                oneletter.push(to_string(s));
            } else {
                rest.push(s.clone());
            }
        }
        if oneletter.len() > 1 {
            if rest.len() > 0 {
                return f"{open_paren}{regex_opt_inner(rest, "")}|{make_charset(oneletter)}{close_paren}";
            }
            return f"{open_paren}{make_charset(oneletter)}{close_paren}";
        }
    }
    let prefix = common_prefix(strings);
    if prefix.len() > 0 {
        let plen = prefix.len();
        let mut rest: Vec[Vec[i64]] = Vec.new();
        for s in strings.iter() {
            rest.push(slice(s, plen, s.len()));
        }
        return f"{open_paren}{re_escape(to_string(prefix))}{regex_opt_inner(rest, "(?:")}{close_paren}";
    }
    let mut revs: Vec[Vec[i64]] = Vec.new();
    for s in strings.iter() {
        revs.push(reversed(s));
    }
    let suffix = common_prefix(revs);
    if suffix.len() > 0 {
        let slen = suffix.len();
        let mut rest: Vec[Vec[i64]] = Vec.new();
        for s in strings.iter() {
            rest.push(slice(s, 0, s.len() - slen));
        }
        sort_cps(mut rest);
        return f"{open_paren}{regex_opt_inner(rest, "(?:")}{re_escape(to_string(reversed(suffix)))}{close_paren}";
    }
    // groupby on whether the first letter is first's first letter
    let mut parts: Vec[String] = Vec.new();
    let mut i = 0;
    while i < strings.len() {
        let key = strings[i][0] == first[0];
        let mut group: Vec[Vec[i64]] = Vec.new();
        while i < strings.len() and (strings[i][0] == first[0]) == key {
            group.push(strings[i].clone());
            i += 1;
        }
        parts.push(regex_opt_inner(group, ""));
    }
    f"{open_paren}{join(parts, "|")}{close_paren}"
}

fn slice_vecs(v: ref Vec[Vec[i64]], a: i64, b: i64) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut i = a;
    while i < b {
        out.push(v[i].clone());
        i += 1;
    }
    out
}

fn regex_opt(words: ref Vec[String], prefix: Str, suffix: Str) -> String {
    let mut strings: Vec[Vec[i64]] = Vec.new();
    for w in words.iter() {
        strings.push(cps(w));
    }
    sort_cps(mut strings);
    f"{prefix}{regex_opt_inner(strings, "(")}{suffix}"
}

// ------------------------------------------- processed token tables

#[derive(Clone)]
enum NewSt {
    NoNew,
    // an int: pop that many, keeping at least one
    Pop(i64),
    // the string '#push'
    PushStr,
    // a tuple of states; -1 is '#pop' and -2 is '#push'
    Tuple(Vec[i64]),
}

#[derive(Clone)]
struct PRule {
    // a compiled program, or -1 for default's empty pattern
    prog: i64,
    act: Act,
    new: NewSt,
}

struct LexClass {
    name: String,
    states: Vec[String],
    rules: Vec[Vec[PRule]],
    started: Vec[bool],
}

fn state_index(c: ref LexClass, name: Str) -> i64 {
    for i in 0..c.states.len() {
        if c.states[i] == name {
            return i;
        }
    }
    -1
}

struct Engine {
    defs: Vec[ClassDef],
    classes: Vec[LexClass],
    progs: Vec[Program],
    // the character a match must start with, or -1
    firsts: Vec[i64],
    cache: Map[String, i64],
    lexmap: Vec[LexInfo],
    std: Std,
    c_types: Vec[Vec[String]],
}

fn new_engine() -> Engine {
    Engine {
        defs: class_defs(),
        classes: Vec.new(),
        progs: Vec.new(),
        firsts: Vec.new(),
        cache: Map.new(),
        lexmap: lexer_map(),
        std: new_std(),
        c_types: vec![c_stdlib_types(), c_c99_types(), c_c11_atomic_types(), c_linux_types()],
    }
}

fn def_index(e: ref Engine, name: Str) -> i64 {
    for i in 0..e.defs.len() {
        if e.defs[i].name == name {
            return i;
        }
    }
    -1
}

fn compile_pat(e: mut ref Engine, pattern: ref String, flags: i64) -> i64 {
    let key = f"{flags}:{pattern}";
    if let Some(k) = e.cache.get(key) {
        return k;
    }
    let prog = match compile(cps(pattern), flags) {
        Ok(p) => p,
        Err(err) => panic(f"uncompilable regex {py_repr(pattern)}: {err_text(err)}"),
    };
    e.firsts.push(first_lit(prog));
    e.progs.push(prog);
    let k = e.progs.len() - 1;
    e.cache.insert(key, k);
    k
}

// A prefilter for the lexer loop: when the program can only match
// starting with one case-sensitive character, that character.
fn first_lit(prog: ref Program) -> i64 {
    for op in prog.ops.iter() {
        match op {
            Op.Mark(_) => {}
            Op.Lit(c, false, _) => return *c,
            _ => return -1,
        }
    }
    -1
}

// RegexLexerMeta.get_tokendefs: merge the MRO's tokens, splicing a
// superclass state in where a subclass wrote `inherit`.
enum TDef {
    Inc(String),
    Inh,
    Def(i64),
    Rul(i64),
}

fn rule_ref(r: ref RawRule, cls: i64, state: i64, k: i64) -> (i64, i64, i64) {
    (cls, state, k)
}

// A state's items, as references (class, state, rule) into defs.
fn get_tokendefs(e: ref Engine, cls: i64) -> Vec[(String, Vec[(i64, i64, i64)])] {
    let mut tokens: Vec[(String, Vec[(i64, i64, i64)])] = Vec.new();
    let mut inheritable: Vec[(String, i64)] = Vec.new();
    for cname in e.defs[cls].mro.iter() {
        let ci = def_index(e, cname);
        let d = ref e.defs[ci];
        for si in 0..d.states.len() {
            let st = d.states[si].0.clone();
            let mut items: Vec[(i64, i64, i64)] = Vec.new();
            for k in 0..d.states[si].1.len() {
                items.push((ci, si, k));
            }
            let mut found = -1;
            for t in 0..tokens.len() {
                if tokens[t].0 == st {
                    found = t;
                }
            }
            if found < 0 {
                let ix = inherit_index(e, items);
                tokens.push((st.clone(), items));
                if ix >= 0 {
                    inheritable.push((st, ix));
                }
                continue;
            }
            let mut inh = -1;
            let mut keep: Vec[(String, i64)] = Vec.new();
            for (n, ix) in inheritable.iter() {
                if n == st and inh < 0 {
                    inh = ix;
                } else {
                    keep.push((n.clone(), ix));
                }
            }
            inheritable = keep;
            if inh < 0 {
                continue;
            }
            let cur = tokens[found].1.clone();
            let mut merged: Vec[(i64, i64, i64)] = Vec.new();
            for q in 0..inh {
                merged.push(cur[q]);
            }
            for it in items.iter() {
                merged.push(it);
            }
            for q in (inh + 1)..cur.len() {
                merged.push(cur[q]);
            }
            tokens[found].1 = merged;
            let nix = inherit_index(e, items);
            if nix >= 0 {
                inheritable.push((st, inh + nix));
            }
        }
    }
    tokens
}

fn inherit_index(e: ref Engine, items: ref Vec[(i64, i64, i64)]) -> i64 {
    for i in 0..items.len() {
        let (c, s, k) = items[i];
        if let RawRule.Inherit = e.defs[c].states[s].1[k] {
            return i;
        }
    }
    -1
}

struct Proc {
    defs: Vec[(String, Vec[(i64, i64, i64)])],
    flags: i64,
    tmp: i64,
}

fn proc_def(p: ref Proc, name: Str) -> i64 {
    for i in 0..p.defs.len() {
        if p.defs[i].0 == name {
            return i;
        }
    }
    -1
}

fn new_state_of(e: mut ref Engine, c: mut ref LexClass, p: mut ref Proc, ns: ref RawNew) -> NewSt {
    match ns {
        RawNew.NoNew => NewSt.NoNew,
        RawNew.Name(s) => {
            if s == "#pop" {
                NewSt.Pop(1)
            } else if proc_def(p, s) >= 0 {
                NewSt.Tuple(vec![state_ref(mut c, s)])
            } else if s == "#push" {
                NewSt.PushStr
            } else if s.starts_with("#pop:") {
                NewSt.Pop(py_int(slice_str(s, 5, s.len())).unwrap())
            } else {
                panic(f"unknown new state {py_repr(s)}")
            }
        }
        RawNew.Combined(parts) => {
            let name = f"_tmp_{p.tmp}";
            p.tmp += 1;
            let mut itokens: Vec[PRule] = Vec.new();
            for istate in parts.iter() {
                let ix = process_state(mut e, mut c, mut p, istate);
                for r in c.rules[ix].iter() {
                    itokens.push(r.clone());
                }
            }
            c.states.push(name);
            c.rules.push(itokens);
            c.started.push(true);
            NewSt.Tuple(vec![c.states.len() - 1])
        }
        RawNew.Tuple(parts) => {
            let mut out: Vec[i64] = Vec.new();
            for s in parts.iter() {
                if s == "#pop" {
                    out.push(-1);
                } else if s == "#push" {
                    out.push(-2);
                } else {
                    out.push(state_ref(mut c, s));
                }
            }
            NewSt.Tuple(out)
        }
    }
}

// _process_state: the processed list is registered before its rules are
// added, so a state reached again while it is being built sees the rules
// it has so far, as in Python.
fn process_state(e: mut ref Engine, c: mut ref LexClass, p: mut ref Proc, state: Str) -> i64 {
    let me = state_ref(mut c, state);
    if c.started[me] {
        return me;
    }
    c.started[me] = true;
    let di = proc_def(p, state);
    let items = p.defs[di].1.clone();
    for (ci, si, k) in items.iter() {
        match ref e.defs[ci].states[si].1[k] {
            RawRule.Include(name) => {
                let name2 = name.clone();
                let sub = process_state(mut e, mut c, mut p, name2);
                let copy = c.rules[sub].clone();
                for r in copy.iter() {
                    c.rules[me].push(r.clone());
                }
            }
            RawRule.Inherit => {}
            RawRule.Default(ns) => {
                let n2 = clone_rawnew(ns);
                let new = new_state_of(mut e, mut c, mut p, n2);
                c.rules[me].push(PRule { prog: -1, act: Act.Skip, new: new });
            }
            RawRule.Rule(pat, act, ns) => {
                let pattern = match pat {
                    Pat.Re(s) => s.clone(),
                    Pat.Words(ws, pre, suf) => regex_opt(ws, pre, suf),
                };
                let a2 = act.clone();
                let n2 = clone_rawnew(ns);
                let flags = p.flags;
                let prog = compile_pat(mut e, pattern, flags);
                let new = new_state_of(mut e, mut c, mut p, n2);
                c.rules[me].push(PRule { prog: prog, act: a2, new: new });
            }
        }
    }
    me
}

// A state's index, registering the name (unprocessed) on first sight.
fn state_ref(c: mut ref LexClass, name: Str) -> i64 {
    let ix = state_index(c, name);
    if ix >= 0 {
        return ix;
    }
    c.states.push(name.to_string());
    c.rules.push(Vec.new());
    c.started.push(false);
    c.states.len() - 1
}

fn clone_rawnew(ns: ref RawNew) -> RawNew {
    match ns {
        RawNew.NoNew => RawNew.NoNew,
        RawNew.Name(s) => RawNew.Name(s.clone()),
        RawNew.Combined(v) => RawNew.Combined(v.clone()),
        RawNew.Tuple(v) => RawNew.Tuple(v.clone()),
    }
}

// The processed tables of a RegexLexer class, built on first use.
fn lex_class(e: mut ref Engine, name: Str) -> i64 {
    for i in 0..e.classes.len() {
        if e.classes[i].name == name {
            return i;
        }
    }
    let di = def_index(e, name);
    let defs = get_tokendefs(e, di);
    let mut p = Proc { defs: defs, flags: e.defs[di].flags, tmp: 0 };
    let mut c = LexClass { name: name.to_string(), states: Vec.new(), rules: Vec.new(), started: Vec.new() };
    let mut names: Vec[String] = Vec.new();
    for d in p.defs.iter() {
        names.push(d.0.clone());
    }
    for st in names.iter() {
        process_state(mut e, mut c, mut p, st);
    }
    e.classes.push(c);
    e.classes.len() - 1
}

// ---------------------------------------------------------- lexers

#[derive(Clone)]
enum Filt {
    CodeTag(String),
    KeywordCase(i64),
    Highlight(Vec[String], String),
    RaiseOnError,
    Whitespace(String, String, String, bool),
    Gobble(i64),
    TokenMerge,
}

#[derive(Clone)]
struct Lexer {
    cls: String,
    name: String,
    aliases: Vec[String],
    options: Vec[(String, Opt)],
    stripnl: bool,
    stripall: bool,
    ensurenl: bool,
    tabsize: i64,
    filters: Vec[Filt],
    // CFamilyLexer's stdlib, c99, c11 and platform switches
    c_hl: Vec[bool],
}

fn info_of(e: ref Engine, cls: Str) -> i64 {
    for i in 0..e.lexmap.len() {
        if e.lexmap[i].cls == cls {
            return i;
        }
    }
    -1
}

fn is_cfamily(e: ref Engine, cls: Str) -> bool {
    let d = def_index(e, cls);
    d >= 0 and has(e.defs[d].mro, "CFamilyLexer")
}

fn implemented(e: ref Engine, cls: Str) -> bool {
    cls == "JsonLexer" or cls == "TextLexer" or def_index(e, cls) >= 0
}

fn make_lexer(e: ref Engine, cls: Str, opts: ref Vec[(String, Opt)]) -> Result[Lexer, PgErr] {
    if not implemented(e, cls) {
        panic(f"lexer {cls} is not ported");
    }
    let mut c_hl: Vec[bool] = Vec.new();
    if is_cfamily(e, cls) {
        c_hl.push(get_bool_opt(opts, "stdlibhighlighting", true)?);
        c_hl.push(get_bool_opt(opts, "c99highlighting", true)?);
        c_hl.push(get_bool_opt(opts, "c11highlighting", true)?);
        c_hl.push(get_bool_opt(opts, "platformhighlighting", true)?);
    }
    let stripnl = get_bool_opt(opts, "stripnl", true)?;
    let stripall = get_bool_opt(opts, "stripall", false)?;
    let ensurenl = get_bool_opt(opts, "ensurenl", true)?;
    let tabsize = get_int_opt(opts, "tabsize", 0)?;
    let info = ref e.lexmap[info_of(e, cls)];
    Ok(Lexer {
        cls: cls.to_string(),
        name: info.name.clone(),
        aliases: info.aliases.clone(),
        options: opts.clone(),
        stripnl: stripnl,
        stripall: stripall,
        ensurenl: ensurenl,
        tabsize: tabsize,
        filters: Vec.new(),
        c_hl: c_hl,
    })
}

fn lexer_repr(l: ref Lexer) -> String {
    if l.options.len() > 0 {
        f"<pygments.lexers.{l.cls} with {opts_repr(l.options)}>"
    } else {
        f"<pygments.lexers.{l.cls}>"
    }
}

// Lexer._preprocess_lexer_input for a str
fn preprocess(l: ref Lexer, text_in: Str) -> String {
    let mut text = text_in.to_string();
    if text.starts_with("\u{feff}") {
        text = slice_str(text, 3, text.len());
    }
    text = replace_all(text, "\r\n", "\n");
    text = replace_all(text, "\r", "\n");
    if l.stripall {
        text = py_strip(text);
    } else if l.stripnl {
        text = strip_nl(text);
    }
    if l.tabsize > 0 {
        text = expand_tabs(text, l.tabsize);
    }
    if l.ensurenl and not ends_with_nl(text) {
        text.push('\n');
    }
    text
}

fn get_tokens(e: mut ref Engine, l: ref Lexer, text: Str) -> Result[Vec[Tk], PgErr] {
    let t = preprocess(l, text);
    let mut toks = tokens_unprocessed(mut e, l, cps(t), vec!["root".to_string()]);
    for f in l.filters.iter() {
        toks = apply_filter(mut e, f, toks)?;
    }
    Ok(toks)
}

fn tokens_unprocessed(e: mut ref Engine, l: ref Lexer, text: ref Vec[i64], stack: Vec[String]) -> Vec[Tk] {
    if l.cls == "TextLexer" {
        return vec![Tk { t: "Text".to_string(), v: to_string(text) }];
    }
    if l.cls == "JsonLexer" {
        return json_tokens(text);
    }
    let mut out: Vec[Tk] = Vec.new();
    regex_lex(mut e, l, text, stack, mut out);
    if is_cfamily(e, l.cls) {
        for i in 0..out.len() {
            if out[i].t == "Name" {
                for k in 0..4 {
                    if l.c_hl[k] and has(e.c_types[k], out[i].v) {
                        out[i].t = "Keyword.Type".to_string();
                        break;
                    }
                }
            }
        }
    }
    out
}

fn prepare(m: mut ref Matcher, prog: ref Program) {
    while m.marks.len() < 2 * (prog.groups + 1) {
        m.marks.push(-1);
    }
    while m.counts.len() < prog.repeats {
        m.counts.push(-1);
        m.lasts.push(-1);
    }
}

// RegexLexer.get_tokens_unprocessed
fn regex_lex(e: mut ref Engine, l: ref Lexer, text: ref Vec[i64], stack: Vec[String], out: mut ref Vec[Tk]) {
    let ci = lex_class(mut e, l.cls);
    let mut m = new_matcher(e.progs[0], text);
    let mut pos = 0;
    let mut statestack: Vec[i64] = Vec.new();
    for s in stack.iter() {
        statestack.push(state_index(e.classes[ci], s));
    }
    let root = state_index(e.classes[ci], "root");
    let mut cur = statestack[statestack.len() - 1];
    loop {
        let mut matched = false;
        let nrules = e.classes[ci].rules[cur].len();
        let mut k = 0;
        while k < nrules {
            let rp = e.classes[ci].rules[cur][k].prog;
            k += 1;
            let found: Option[Found] = if rp < 0 {
                Some(Found { start: pos, end: pos, spans: Vec.new(), lastindex: -1 })
            } else if e.firsts[rp] >= 0 and (pos >= text.len() or text[pos] != e.firsts[rp]) {
                None
            } else {
                let prog = ref e.progs[rp];
                prepare(mut m, prog);
                find(mut m, prog, pos, false, 1)
            };
            let f = match found {
                Some(f) => f,
                None => continue,
            };
            let rule = e.classes[ci].rules[cur][k - 1].clone();
            run_action(mut e, l, text, rule.act, f.start, f.end, f.spans, mut out);
            pos = f.end;
            match ref rule.new {
                NewSt.NoNew => {}
                NewSt.Tuple(states) => {
                    for s in states.iter() {
                        if s == -1 {
                            if statestack.len() > 1 {
                                statestack.pop();
                            }
                        } else if s == -2 {
                            let top = statestack[statestack.len() - 1];
                            statestack.push(top);
                        } else {
                            statestack.push(s);
                        }
                    }
                }
                NewSt.Pop(n) => {
                    if *n >= statestack.len() {
                        statestack.truncate(1);
                    } else {
                        let keep = statestack.len() - *n;
                        statestack.truncate(keep);
                    }
                }
                NewSt.PushStr => {
                    let top = statestack[statestack.len() - 1];
                    statestack.push(top);
                }
            }
            cur = statestack[statestack.len() - 1];
            matched = true;
            break;
        }
        if matched {
            continue;
        }
        if pos >= text.len() {
            break;
        }
        if text[pos] == 10 {
            statestack = vec![root];
            cur = root;
            out.push(Tk { t: "Text.Whitespace".to_string(), v: "\n".to_string() });
            pos += 1;
            continue;
        }
        out.push(Tk { t: "Error".to_string(), v: cp_text(text, pos, pos + 1) });
        pos += 1;
    }
}

// A rule's action on its match (or on one group, for bygroups).
fn run_action(e: mut ref Engine, l: ref Lexer, text: ref Vec[i64], act: ref Act, start: i64, end: i64, spans: ref Vec[(i64, i64)], out: mut ref Vec[Tk]) {
    match act {
        Act.Skip => {}
        Act.Tok(t) => out.push(Tk { t: t.clone(), v: cp_text(text, start, end) }),
        Act.Groups(acts) => {
            for i in 0..acts.len() {
                let (a, b) = if i < spans.len() { spans[i] } else { (-1, -1) };
                match ref acts[i] {
                    Act.Skip => {}
                    Act.Tok(t) => {
                        if a >= 0 and b > a {
                            out.push(Tk { t: t.clone(), v: cp_text(text, a, b) });
                        }
                    }
                    other => {
                        if a >= 0 {
                            let none: Vec[(i64, i64)] = Vec.new();
                            run_action(mut e, l, text, other, a, b, none, mut out);
                        }
                    }
                }
            }
        }
        Act.Using(other, stack) => {
            let sub = slice(text, start, end);
            let st = if stack.len() > 0 { stack.clone() } else { vec!["root".to_string()] };
            if other == "this" {
                let toks = tokens_unprocessed(mut e, l, sub, st);
                for t in toks.iter() {
                    out.push(t.clone());
                }
            } else {
                let lx = make_lexer(e, other, l.options).unwrap();
                let toks = tokens_unprocessed(mut e, lx, sub, st);
                for t in toks.iter() {
                    out.push(t.clone());
                }
            }
        }
    }
}

// ------------------------------------------------------------- JSON
// JsonLexer.get_tokens_unprocessed: a character state machine.

fn json_tokens(text: ref Vec[i64]) -> Vec[Tk] {
    let mut out: Vec[Tk] = Vec.new();
    let mut queue: Vec[Tk] = Vec.new();
    let mut in_string = false;
    let mut in_escape = false;
    let mut in_unicode_escape = 0;
    let mut in_whitespace = false;
    let mut in_constant = false;
    let mut in_number = false;
    let mut in_float = false;
    let mut in_punctuation = false;
    let mut in_comment_single = false;
    let mut in_comment_multiline = false;
    let mut expect_open = false;
    let mut expect_close = false;
    let mut start = 0;
    let mut stop = 0;
    while stop < text.len() {
        let c = text[stop];
        let mut skip = false;
        if in_string {
            if in_unicode_escape > 0 {
                if is_hex(c) {
                    in_unicode_escape -= 1;
                    if in_unicode_escape == 0 {
                        in_escape = false;
                    }
                } else {
                    in_unicode_escape = 0;
                    in_escape = false;
                }
            } else if in_escape {
                if c == 117 {
                    in_unicode_escape = 4;
                } else {
                    in_escape = false;
                }
            } else if c == 92 {
                in_escape = true;
            } else if c == 34 {
                queue.push(Tk { t: "Literal.String.Double".to_string(), v: cp_text(text, start, stop + 1) });
                in_string = false;
                in_escape = false;
                in_unicode_escape = 0;
            }
            stop += 1;
            continue;
        } else if in_whitespace {
            if json_ws(c) {
                stop += 1;
                continue;
            }
            let tk = Tk { t: "Text.Whitespace".to_string(), v: cp_text(text, start, stop) };
            if queue.len() > 0 { queue.push(tk); } else { out.push(tk); }
            in_whitespace = false;
        } else if in_constant {
            if json_const(c) {
                stop += 1;
                continue;
            }
            out.push(Tk { t: "Keyword.Constant".to_string(), v: cp_text(text, start, stop) });
            in_constant = false;
        } else if in_number {
            if json_int(c) {
                stop += 1;
                continue;
            } else if c == 46 or c == 101 or c == 69 or c == 43 {
                in_float = true;
                stop += 1;
                continue;
            }
            let t = if in_float { "Literal.Number.Float" } else { "Literal.Number.Integer" };
            out.push(Tk { t: t.to_string(), v: cp_text(text, start, stop) });
            in_number = false;
            in_float = false;
        } else if in_punctuation {
            if json_punct(c) {
                stop += 1;
                continue;
            }
            out.push(Tk { t: "Punctuation".to_string(), v: cp_text(text, start, stop) });
            in_punctuation = false;
        } else if in_comment_single {
            if c != 10 {
                stop += 1;
                continue;
            }
            let tk = Tk { t: "Comment.Single".to_string(), v: cp_text(text, start, stop) };
            if queue.len() > 0 { queue.push(tk); } else { out.push(tk); }
            in_comment_single = false;
        } else if in_comment_multiline {
            if c == 42 {
                expect_close = true;
            } else if expect_close {
                expect_close = false;
                if c == 47 {
                    let tk = Tk { t: "Comment.Multiline".to_string(), v: cp_text(text, start, stop + 1) };
                    if queue.len() > 0 { queue.push(tk); } else { out.push(tk); }
                    in_comment_multiline = false;
                }
            }
            stop += 1;
            continue;
        } else if expect_open {
            expect_open = false;
            if c == 47 {
                in_comment_single = true;
                skip = true;
            } else if c == 42 {
                in_comment_multiline = true;
                skip = true;
            } else {
                flush_queue(mut queue, mut out);
                out.push(Tk { t: "Error".to_string(), v: cp_text(text, start, stop) });
            }
        }
        if skip {
            stop += 1;
            continue;
        }
        start = stop;
        if c == 34 {
            in_string = true;
        } else if json_ws(c) {
            in_whitespace = true;
        } else if c == 102 or c == 110 or c == 116 {
            flush_queue(mut queue, mut out);
            in_constant = true;
        } else if json_int(c) {
            flush_queue(mut queue, mut out);
            in_number = true;
        } else if c == 58 {
            for q in queue.iter() {
                if q.t == "Literal.String.Double" {
                    out.push(Tk { t: "Name.Tag".to_string(), v: q.v.clone() });
                } else {
                    out.push(q.clone());
                }
            }
            queue.clear();
            in_punctuation = true;
        } else if json_punct(c) {
            flush_queue(mut queue, mut out);
            in_punctuation = true;
        } else if c == 47 {
            expect_open = true;
        } else {
            flush_queue(mut queue, mut out);
            out.push(Tk { t: "Error".to_string(), v: cp_text(text, stop, stop + 1) });
        }
        stop += 1;
    }
    flush_queue(mut queue, mut out);
    let rest = cp_text(text, start, text.len());
    if in_string {
        out.push(Tk { t: "Error".to_string(), v: rest });
    } else if in_float {
        out.push(Tk { t: "Literal.Number.Float".to_string(), v: rest });
    } else if in_number {
        out.push(Tk { t: "Literal.Number.Integer".to_string(), v: rest });
    } else if in_constant {
        out.push(Tk { t: "Keyword.Constant".to_string(), v: rest });
    } else if in_whitespace {
        out.push(Tk { t: "Text.Whitespace".to_string(), v: rest });
    } else if in_punctuation {
        out.push(Tk { t: "Punctuation".to_string(), v: rest });
    } else if in_comment_single {
        out.push(Tk { t: "Comment.Single".to_string(), v: rest });
    } else if in_comment_multiline or expect_open {
        out.push(Tk { t: "Error".to_string(), v: rest });
    }
    out
}

fn flush_queue(queue: mut ref Vec[Tk], out: mut ref Vec[Tk]) {
    for q in queue.iter() {
        out.push(q.clone());
    }
    queue.clear();
}

fn json_ws(c: i64) -> bool {
    c == 32 or c == 10 or c == 13 or c == 9
}

fn json_int(c: i64) -> bool {
    c == 45 or (c >= 48 and c <= 57)
}

fn json_punct(c: i64) -> bool {
    c == 123 or c == 125 or c == 91 or c == 93 or c == 44
}

// set('truefalsenull')
fn json_const(c: i64) -> bool {
    c == 116 or c == 114 or c == 117 or c == 101 or c == 102 or c == 97 or c == 108 or c == 115 or c == 110
}

// ----------------------------------------------------------- filters

fn filter_names() -> Vec[String] {
    sv(vec!["codetagify", "keywordcase", "highlight", "raiseonerror", "whitespace", "gobble", "tokenmerge", "symbols"])
}

// get_filter_by_name(name, **options)
fn make_filter(name: Str, opts: ref Vec[(String, Opt)]) -> Result[Filt, PgErr] {
    if name == "codetagify" {
        let tags = get_list_opt(opts, "codetags", sv(vec!["XXX", "TODO", "FIXME", "BUG", "NOTE"]))?;
        let mut alts: Vec[String] = Vec.new();
        for t in tags.iter() {
            if t.len() > 0 {
                alts.push(re_escape(t));
            }
        }
        return Ok(Filt.CodeTag("\\b(" + join(alts, "|") + ")\\b"));
    }
    if name == "keywordcase" {
        let case = get_choice_opt(opts, "case", sv(vec!["lower", "upper", "capitalize"]), "lower")?;
        let k = if case == "lower" { 0 } else if case == "upper" { 1 } else { 2 };
        return Ok(Filt.KeywordCase(k));
    }
    if name == "highlight" {
        let names = get_list_opt(opts, "names", Vec.new())?;
        let tt = get_str_opt(opts, "tokentype", "");
        let t = if tt.len() > 0 { string_to_tokentype(tt) } else { "Name.Function".to_string() };
        return Ok(Filt.Highlight(names, t));
    }
    if name == "raiseonerror" {
        return Ok(Filt.RaiseOnError);
    }
    if name == "whitespace" {
        let defaults = sv(vec!["\u{b7}", "\u{bb}", "\u{b6}"]);
        let keys = sv(vec!["spaces", "tabs", "newlines"]);
        let mut vals: Vec[String] = Vec.new();
        for i in 0..3 {
            let v = match opt_get(opts, keys[i]) {
                None => String.new(),
                Some(Opt.T) => defaults[i].clone(),
                Some(Opt.S(s)) => {
                    if cps(s).len() == 1 {
                        s
                    } else if s.len() > 0 {
                        defaults[i].clone()
                    } else {
                        String.new()
                    }
                }
            };
            vals.push(v);
        }
        let tabsize = get_int_opt(opts, "tabsize", 8)?;
        if vals[1].len() > 0 {
            vals[1] = vals[1].clone() + spaces(tabsize - 1);
        }
        if vals[2].len() > 0 {
            vals[2] = vals[2].clone() + "\n";
        }
        let wstt = get_bool_opt(opts, "wstokentype", true)?;
        return Ok(Filt.Whitespace(vals[0].clone(), vals[1].clone(), vals[2].clone(), wstt));
    }
    if name == "gobble" {
        return Ok(Filt.Gobble(get_int_opt(opts, "n", 0)?));
    }
    if name == "tokenmerge" {
        return Ok(Filt.TokenMerge);
    }
    if name == "symbols" {
        panic("the symbols filter is not ported");
    }
    Err(class_not_found(f"filter {py_repr(name)} not found"))
}

// _replace_special over the regex's matches
fn replace_special(e: mut ref Engine, t: Str, value: Str, pattern: ref String, special: Str, out: mut ref Vec[Tk]) {
    let prog_ix = compile_pat(mut e, pattern, 0);
    let v = cps(value);
    let ms = all_matches(e.progs[prog_ix], v, 0);
    let mut last = 0;
    for m in ms.iter() {
        if m.start != last {
            out.push(Tk { t: t.to_string(), v: cp_text(v, last, m.start) });
        }
        out.push(Tk { t: special.to_string(), v: cp_text(v, m.start, m.end) });
        last = m.end;
    }
    if last != v.len() {
        out.push(Tk { t: t.to_string(), v: cp_text(v, last, v.len()) });
    }
}

fn gobble_part(value: ref Vec[i64], left: i64) -> (Vec[i64], i64) {
    if left < value.len() {
        (slice(value, left, value.len()), 0)
    } else {
        (Vec.new(), left - value.len())
    }
}

fn apply_filter(e: mut ref Engine, f: ref Filt, toks: Vec[Tk]) -> Result[Vec[Tk], PgErr] {
    let mut out: Vec[Tk] = Vec.new();
    match f {
        Filt.CodeTag(pattern) => {
            for tk in toks.iter() {
                if tok_in(tk.t, "Literal.String.Doc") or (tok_in(tk.t, "Comment") and not tok_in(tk.t, "Comment.Preproc")) {
                    replace_special(mut e, tk.t, tk.v, pattern, "Comment.Special", mut out);
                } else {
                    out.push(tk.clone());
                }
            }
        }
        Filt.KeywordCase(k) => {
            for tk in toks.iter() {
                if tok_in(tk.t, "Keyword") {
                    let v = if *k == 0 { case_lower(tk.v) } else if *k == 1 { case_upper(tk.v) } else { case_capitalize(tk.v) };
                    out.push(Tk { t: tk.t.clone(), v: v });
                } else {
                    out.push(tk.clone());
                }
            }
        }
        Filt.Highlight(names, t) => {
            for tk in toks.iter() {
                if tok_in(tk.t, "Name") and has(names, tk.v) {
                    out.push(Tk { t: t.clone(), v: tk.v.clone() });
                } else {
                    out.push(tk.clone());
                }
            }
        }
        Filt.RaiseOnError => {
            for tk in toks.iter() {
                if tk.t == "Error" {
                    return Err(PgErr { kind: "ErrorToken".to_string(), msg: tk.v.clone() });
                }
                out.push(tk.clone());
            }
        }
        Filt.Whitespace(sp, tb, nl, wstt) => {
            if *wstt {
                let spc = if sp.len() > 0 { sp.clone() } else { " ".to_string() };
                let tabs = if tb.len() > 0 { tb.clone() } else { "\t".to_string() };
                let nls = if nl.len() > 0 { nl.clone() } else { "\n".to_string() };
                for tk in toks.iter() {
                    let v = cps(tk.v);
                    let mut last = 0;
                    for i in 0..v.len() {
                        if is_py_space(v[i]) {
                            if i != last {
                                out.push(Tk { t: tk.t.clone(), v: cp_text(v, last, i) });
                            }
                            let r = if v[i] == 32 { spc.clone() } else if v[i] == 9 { tabs.clone() } else if v[i] == 10 { nls.clone() } else { cp_text(v, i, i + 1) };
                            out.push(Tk { t: "Text.Whitespace".to_string(), v: r });
                            last = i + 1;
                        }
                    }
                    if last != v.len() {
                        out.push(Tk { t: tk.t.clone(), v: cp_text(v, last, v.len()) });
                    }
                }
            } else {
                for tk in toks.iter() {
                    let mut v = tk.v.clone();
                    if sp.len() > 0 {
                        v = replace_all(v, " ", sp);
                    }
                    if tb.len() > 0 {
                        v = replace_all(v, "\t", tb);
                    }
                    if nl.len() > 0 {
                        v = replace_all(v, "\n", nl);
                    }
                    out.push(Tk { t: tk.t.clone(), v: v });
                }
            }
        }
        Filt.Gobble(n) => {
            let mut left = *n;
            for tk in toks.iter() {
                let parts = split_char(tk.v, b'\n');
                let mut pieces: Vec[String] = Vec.new();
                for i in 0..parts.len() {
                    let (p, l2) = gobble_part(cps(parts[i]), if i == 0 { left } else { *n });
                    left = l2;
                    pieces.push(to_string(p));
                }
                let value = join(pieces, "\n");
                if value.len() > 0 {
                    out.push(Tk { t: tk.t.clone(), v: value });
                }
            }
        }
        Filt.TokenMerge => {
            let mut have = false;
            let mut cur_t = String.new();
            let mut cur_v = String.new();
            for tk in toks.iter() {
                if have and cur_t == tk.t {
                    cur_v.push_str(tk.v);
                } else {
                    if have {
                        out.push(Tk { t: cur_t.clone(), v: cur_v.clone() });
                    }
                    have = true;
                    cur_t = tk.t.clone();
                    cur_v = tk.v.clone();
                }
            }
            if have {
                out.push(Tk { t: cur_t, v: cur_v });
            }
        }
    }
    Ok(out)
}

// ------------------------------------------------------------ styles

struct StyleDef {
    name: String,
    background: Option[String],
    highlight: Option[String],
    lineno: Option[String],
    lineno_bg: Option[String],
    lineno_special: Option[String],
    lineno_special_bg: Option[String],
    styles: Vec[(String, String)],
}

#[derive(Clone)]
struct NDef {
    color: String,
    bold: bool,
    italic: bool,
    underline: bool,
    bgcolor: String,
    border: String,
    roman: bool,
    sans: bool,
    mono: bool,
}

struct Style {
    name: String,
    background: Option[String],
    highlight: Option[String],
    lineno: Option[String],
    lineno_bg: Option[String],
    lineno_special: Option[String],
    lineno_special_bg: Option[String],
    // _styles in insertion order
    order: Vec[String],
    nd: Map[String, NDef],
}

fn ansimap() -> Vec[(String, String)] {
    vec![
        ("ansiblack".to_string(), "000000".to_string()), ("ansired".to_string(), "7f0000".to_string()),
        ("ansigreen".to_string(), "007f00".to_string()), ("ansiyellow".to_string(), "7f7fe0".to_string()),
        ("ansiblue".to_string(), "00007f".to_string()), ("ansimagenta".to_string(), "7f007f".to_string()),
        ("ansicyan".to_string(), "007f7f".to_string()), ("ansigray".to_string(), "e5e5e5".to_string()),
        ("ansibrightblack".to_string(), "555555".to_string()), ("ansibrightred".to_string(), "ff0000".to_string()),
        ("ansibrightgreen".to_string(), "00ff00".to_string()), ("ansibrightyellow".to_string(), "ffff00".to_string()),
        ("ansibrightblue".to_string(), "0000ff".to_string()), ("ansibrightmagenta".to_string(), "ff00ff".to_string()),
        ("ansibrightcyan".to_string(), "00ffff".to_string()), ("ansiwhite".to_string(), "ffffff".to_string()),
    ]
}

fn deprecated_ansi() -> Vec[(String, String)] {
    vec![
        ("#ansiblack".to_string(), "ansiblack".to_string()), ("#ansidarkred".to_string(), "ansired".to_string()),
        ("#ansidarkgreen".to_string(), "ansigreen".to_string()), ("#ansibrown".to_string(), "ansiyellow".to_string()),
        ("#ansidarkblue".to_string(), "ansiblue".to_string()), ("#ansipurple".to_string(), "ansimagenta".to_string()),
        ("#ansiteal".to_string(), "ansicyan".to_string()), ("#ansilightgray".to_string(), "ansigray".to_string()),
        ("#ansidarkgray".to_string(), "ansibrightblack".to_string()), ("#ansired".to_string(), "ansibrightred".to_string()),
        ("#ansigreen".to_string(), "ansibrightgreen".to_string()), ("#ansiyellow".to_string(), "ansibrightyellow".to_string()),
        ("#ansiblue".to_string(), "ansibrightblue".to_string()), ("#ansifuchsia".to_string(), "ansibrightmagenta".to_string()),
        ("#ansiturquoise".to_string(), "ansibrightcyan".to_string()), ("#ansiwhite".to_string(), "ansiwhite".to_string()),
    ]
}

fn lookup_pair(v: ref Vec[(String, String)], k: Str) -> Option[String] {
    for (a, b) in v.iter() {
        if a == k {
            return Some(b.clone());
        }
    }
    None
}

fn colorformat(text: Str) -> String {
    if lookup_pair(ansimap(), text).is_some() {
        return text.to_string();
    }
    if text.starts_with("#") {
        let col = slice_str(text, 1, text.len());
        if col.len() == 6 {
            return col;
        }
        if col.len() == 3 {
            let b = to_bytes(col);
            let mut out = String.new();
            for i in 0..3 {
                out.push(b[i] as char);
                out.push(b[i] as char);
            }
            return out;
        }
    } else if text.len() == 0 {
        return String.new();
    } else if text.starts_with("var") or text.starts_with("calc") {
        return text.to_string();
    }
    panic(f"wrong color format {py_repr(text)}")
}

fn fresh_ndef() -> NDef {
    NDef { color: String.new(), bold: false, italic: false, underline: false, bgcolor: String.new(), border: String.new(), roman: false, sans: false, mono: false }
}

// StyleMeta.__new__
fn build_style(d: ref StyleDef, std: ref Std) -> Style {
    let mut styles = d.styles.clone();
    for t in std.order.iter() {
        if lookup_pair(styles, t).is_none() {
            styles.push((t.clone(), String.new()));
        }
    }
    let mut order: Vec[String] = Vec.new();
    let mut nd: Map[String, NDef] = Map.new();
    for (ttype, _) in styles.iter() {
        for token in tok_split(ttype).iter() {
            if nd.contains_key(token) {
                continue;
            }
            let parent = match tok_parent(token) {
                Some(p) => nd.get(p),
                None => None,
            };
            let defs = split_ws(lookup_pair(styles, token).unwrap_or(String.new()));
            let mut n = match parent {
                None => fresh_ndef(),
                Some(p) => {
                    if has(defs, "noinherit") and token.len() > 0 {
                        nd.get("").unwrap().clone()
                    } else {
                        p.clone()
                    }
                }
            };
            for sd in defs.iter() {
                if sd == "noinherit" {
                } else if sd == "bold" {
                    n.bold = true;
                } else if sd == "nobold" {
                    n.bold = false;
                } else if sd == "italic" {
                    n.italic = true;
                } else if sd == "noitalic" {
                    n.italic = false;
                } else if sd == "underline" {
                    n.underline = true;
                } else if sd == "nounderline" {
                    n.underline = false;
                } else if sd.starts_with("bg:") {
                    n.bgcolor = colorformat(slice_str(sd, 3, sd.len()));
                } else if sd.starts_with("border:") {
                    n.border = colorformat(slice_str(sd, 7, sd.len()));
                } else if sd == "roman" {
                    n.roman = true;
                } else if sd == "sans" {
                    n.sans = true;
                } else if sd == "mono" {
                    n.mono = true;
                } else {
                    n.color = colorformat(sd);
                }
            }
            nd.insert(token.clone(), n);
            order.push(token.clone());
        }
    }
    Style {
        name: d.name.clone(),
        background: d.background.clone(),
        highlight: d.highlight.clone(),
        lineno: d.lineno.clone(),
        lineno_bg: d.lineno_bg.clone(),
        lineno_special: d.lineno_special.clone(),
        lineno_special_bg: d.lineno_special_bg.clone(),
        order: order,
        nd: nd,
    }
}

// style_for_token: the colors with ansi names mapped to RGB
struct Sft {
    color: String,
    bold: bool,
    italic: bool,
    underline: bool,
    bgcolor: String,
    border: String,
}

fn style_for_token(s: ref Style, t: Str) -> Sft {
    let n = s.nd.get(t).unwrap();
    let mut color = n.color.clone();
    if let Some(c) = lookup_pair(deprecated_ansi(), color) {
        color = c;
    }
    if let Some(rgb) = lookup_pair(ansimap(), color) {
        color = rgb;
    }
    let mut bg = n.bgcolor.clone();
    if let Some(c) = lookup_pair(deprecated_ansi(), bg) {
        bg = c;
    }
    if let Some(rgb) = lookup_pair(ansimap(), bg) {
        bg = rgb;
    }
    Sft { color: color, bold: n.bold, italic: n.italic, underline: n.underline, bgcolor: bg, border: n.border.clone() }
}

// get_style_by_name
fn get_style(name: Str, std: ref Std) -> Result[Style, PgErr] {
    if not has(style_names(), name) {
        return Err(class_not_found(f"Could not find style module {py_repr(f"pygments.styles.{name}")}."));
    }
    for d in style_defs().iter() {
        if d.name == name {
            return Ok(build_style(d, std));
        }
    }
    panic(f"style {name} is not ported")
}

// -------------------------------------------------------- formatters

struct Html {
    style: Style,
    options: Vec[(String, Opt)],
    full: bool,
    title: String,
    encoding: String,
    nowrap: bool,
    noclasses: bool,
    classprefix: String,
    cssclass: String,
    cssstyles: String,
    prestyles: String,
    filename: String,
    wrapcode: bool,
    debug_token_types: bool,
    linenos: i64,
    linenostart: i64,
    linenostep: i64,
    linenospecial: i64,
    nobackground: bool,
    lineseparator: String,
    lineanchors: String,
    linespans: String,
    anchorlinenos: bool,
    hl_lines: Vec[i64],
    t2c: Map[String, String],
    // css class -> (style, ttype, level)
    c2s: Map[String, (String, String, i64)],
    c2s_order: Vec[String],
}

struct Term {
    darkbg: bool,
    linenos: bool,
}

enum Fmt {
    H(Html),
    T(Term),
    Raw,
    Null,
    Testcase,
}

struct Base {
    style: Style,
    full: bool,
    title: String,
    encoding: String,
}

// Formatter.__init__
fn base_init(opts: ref Vec[(String, Opt)], std: ref Std) -> Result[Base, PgErr] {
    let style = get_style(get_str_opt(opts, "style", "default"), std)?;
    let full = get_bool_opt(opts, "full", false)?;
    let title = get_str_opt(opts, "title", "");
    let mut enc = get_str_opt(opts, "encoding", "");
    if enc == "guess" or enc == "chardet" {
        enc = "utf-8".to_string();
    }
    let oenc = get_str_opt(opts, "outencoding", "");
    if oenc.len() > 0 {
        enc = oenc;
    }
    Ok(Base { style: style, full: full, title: title, encoding: enc })
}

fn abs(n: i64) -> i64 {
    if n < 0 { -n } else { n }
}

fn get_formatter(name: Str, opts: ref Vec[(String, Opt)], std: ref Std) -> Result[Fmt, PgErr] {
    let kind = if name == "html" {
        0
    } else if name == "terminal" or name == "console" {
        1
    } else if name == "raw" or name == "tokens" {
        2
    } else if name == "text" or name == "null" {
        3
    } else if name == "testcase" {
        4
    } else {
        return Err(class_not_found(f"no formatter found for name {py_repr(name)}"));
    };
    let base = base_init(opts, std)?;
    if kind == 1 {
        let bg = get_choice_opt(opts, "bg", sv(vec!["light", "dark"]), "light")?;
        return Ok(Fmt.T(Term { darkbg: bg == "dark", linenos: get_truthy(opts, "linenos") }));
    }
    if kind == 2 {
        get_choice_opt(opts, "compress", sv(vec!["", "none", "gz", "bz2"]), "")?;
        return Ok(Fmt.Raw);
    }
    if kind == 3 {
        return Ok(Fmt.Null);
    }
    if kind == 4 {
        return Ok(Fmt.Testcase);
    }
    let nowrap = get_bool_opt(opts, "nowrap", false)?;
    let noclasses = get_bool_opt(opts, "noclasses", false)?;
    let classprefix = get_str_opt(opts, "classprefix", "");
    let cssclass = get_str_opt(opts, "cssclass", "highlight");
    let cssstyles = get_str_opt(opts, "cssstyles", "");
    let prestyles = get_str_opt(opts, "prestyles", "");
    get_bool_opt(opts, "noclobber_cssfile", false)?;
    let filename = get_str_opt(opts, "filename", "");
    let wrapcode = get_bool_opt(opts, "wrapcode", false)?;
    let debug = get_bool_opt(opts, "debug_token_types", false)?;
    let linenos = match opt_get(opts, "linenos") {
        Some(Opt.S(s)) => if s == "inline" { 2 } else if s.len() > 0 { 1 } else { 0 },
        Some(Opt.T) => 1,
        None => 0,
    };
    let linenostart = abs(get_int_opt(opts, "linenostart", 1)?);
    let linenostep = abs(get_int_opt(opts, "linenostep", 1)?);
    let linenospecial = abs(get_int_opt(opts, "linenospecial", 0)?);
    let nobackground = get_bool_opt(opts, "nobackground", false)?;
    let lineseparator = get_str_opt(opts, "lineseparator", "\n");
    let lineanchors = get_str_opt(opts, "lineanchors", "");
    let linespans = get_str_opt(opts, "linespans", "");
    let anchorlinenos = get_bool_opt(opts, "anchorlinenos", false)?;
    let mut hl: Vec[i64] = Vec.new();
    for s in get_list_opt(opts, "hl_lines", Vec.new())?.iter() {
        if let Some(n) = py_int(s) {
            hl.push(n);
        }
    }
    let mut h = Html {
        style: base.style,
        options: opts.clone(),
        full: base.full,
        title: base.title,
        encoding: if base.encoding.len() > 0 { base.encoding } else { "None".to_string() },
        nowrap: nowrap,
        noclasses: noclasses,
        classprefix: classprefix,
        cssclass: cssclass,
        cssstyles: cssstyles,
        prestyles: prestyles,
        filename: filename,
        wrapcode: wrapcode,
        debug_token_types: debug,
        linenos: linenos,
        linenostart: linenostart,
        linenostep: linenostep,
        linenospecial: linenospecial,
        nobackground: nobackground,
        lineseparator: lineseparator,
        lineanchors: lineanchors,
        linespans: linespans,
        anchorlinenos: anchorlinenos,
        hl_lines: hl,
        t2c: Map.new(),
        c2s: Map.new(),
        c2s_order: Vec.new(),
    };
    create_stylesheet(mut h, std);
    Ok(Fmt.H(h))
}

fn ttype_class(t: Str, std: ref Std) -> String {
    match std.short.get(t) {
        Some(f) => return f.clone(),
        None => {}
    }
    let mut aname = String.new();
    let mut cur = t.to_string();
    loop {
        aname = "-" + tok_last(cur) + aname;
        cur = tok_parent(cur).unwrap();
        if let Some(f) = std.short.get(cur) {
            return f + aname;
        }
    }
}

fn css_class(h: ref Html, t: Str, std: ref Std) -> String {
    let c = ttype_class(t, std);
    if c.len() > 0 { h.classprefix.clone() + c } else { String.new() }
}

fn css_classes(h: ref Html, t: Str, std: ref Std) -> String {
    let mut cls = css_class(h, t, std);
    let mut cur = t.to_string();
    while not std.short.contains_key(cur) {
        cur = tok_parent(cur).unwrap();
        cls = css_class(h, cur, std) + " " + cls;
    }
    cls
}

fn css_inline_styles(h: ref Html, t: Str) -> String {
    let mut cur = t.to_string();
    loop {
        if let Some(c) = h.t2c.get(cur) {
            return c.clone();
        }
        cur = tok_parent(cur).unwrap();
    }
}

fn webify(c: Str) -> String {
    if c.starts_with("calc") or c.starts_with("var") { c.to_string() } else { f"#{c}" }
}

fn create_stylesheet(h: mut ref Html, std: ref Std) {
    h.t2c.insert(String.new(), String.new());
    let order = h.style.order.clone();
    for t in order.iter() {
        let nd = style_for_token(h.style, t);
        let name = css_class(h, t, std);
        let mut style = String.new();
        if nd.color.len() > 0 {
            style.push_str(f"color: {webify(nd.color)}; ");
        }
        if nd.bold {
            style.push_str("font-weight: bold; ");
        }
        if nd.italic {
            style.push_str("font-style: italic; ");
        }
        if nd.underline {
            style.push_str("text-decoration: underline; ");
        }
        if nd.bgcolor.len() > 0 {
            style.push_str(f"background-color: {webify(nd.bgcolor)}; ");
        }
        if nd.border.len() > 0 {
            style.push_str(f"border: 1px solid {webify(nd.border)}; ");
        }
        if style.len() > 0 {
            h.t2c.insert(t.clone(), name.clone());
            if not h.c2s.contains_key(name) {
                h.c2s_order.push(name.clone());
            }
            h.c2s.insert(name, (slice_str(style, 0, style.len() - 2), t.clone(), tok_len(t)));
        }
    }
}

fn opt_text(o: ref Option[String]) -> String {
    match o {
        Some(s) => s.clone(),
        None => "None".to_string(),
    }
}

fn linenos_style(h: ref Html) -> String {
    f"color: {opt_text(h.style.lineno)}; background-color: {opt_text(h.style.lineno_bg)}; padding-left: 5px; padding-right: 5px;"
}

fn linenos_special_style(h: ref Html) -> String {
    f"color: {opt_text(h.style.lineno_special)}; background-color: {opt_text(h.style.lineno_special_bg)}; padding-left: 5px; padding-right: 5px;"
}

fn css_prefix(args: ref Vec[String], cls: Str) -> String {
    let c = if cls.len() > 0 { f".{cls}" } else { String.new() };
    let mut tmp: Vec[String] = Vec.new();
    for a in args.iter() {
        tmp.push(if a.len() > 0 { a.clone() + " " + c } else { c.clone() });
    }
    join(tmp, ", ")
}

// get_style_defs(arg); None is spelled as an absent Option
fn get_style_defs(h: ref Html, arg_in: Option[String]) -> String {
    let arg = match arg_in {
        Some(a) => a.clone(),
        None => if opt_get(h.options, "cssclass").is_some() { "." + h.cssclass } else { String.new() },
    };
    let args = vec![arg.clone()];
    let mut lines: Vec[String] = Vec.new();
    lines.push("pre { line-height: 125%; }".to_string());
    lines.push(f"td.linenos .normal {{ {linenos_style(h)} }}");
    lines.push(f"span.linenos {{ {linenos_style(h)} }}");
    lines.push(f"td.linenos .special {{ {linenos_special_style(h)} }}");
    lines.push(f"span.linenos.special {{ {linenos_special_style(h)} }}");
    // background
    let mut bg: Vec[String] = Vec.new();
    if arg.len() > 0 and not h.nobackground and h.style.background.is_some() {
        let mut text_style = String.new();
        if let Some(c) = h.t2c.get("Text") {
            text_style = " " + h.c2s.get(c).unwrap().0;
        }
        bg.insert(0, f"{css_prefix(args, "")}{{ background: {h.style.background.clone().unwrap()};{text_style} }}");
    }
    if let Some(hc) = ref h.style.highlight {
        bg.insert(0, f"{css_prefix(args, "hll")} {{ background-color: {hc} }}");
    }
    for l in bg.iter() {
        lines.push(l.clone());
    }
    // token classes, ordered by level, then type
    let mut styles: Vec[(i64, String, String, String)] = Vec.new();
    for cls in h.c2s_order.iter() {
        let (style, t, level) = h.c2s.get(cls).unwrap();
        if cls.len() > 0 and style.len() > 0 {
            styles.push((level, t.clone(), cls.clone(), style.clone()));
        }
    }
    let mut i = 1;
    while i < styles.len() {
        let mut j = i;
        while j > 0 and style_less(styles[j], styles[j - 1]) {
            let t = styles[j].clone();
            styles[j] = styles[j - 1].clone();
            styles[j - 1] = t;
            j -= 1;
        }
        i += 1;
    }
    for (_, t, cls, style) in styles.iter() {
        lines.push(f"{css_prefix(args, cls)} {{ {style} }} /* {t} */");
    }
    join(lines, "\n")
}

fn style_less(a: ref (i64, String, String, String), b: ref (i64, String, String, String)) -> bool {
    if a.0 != b.0 {
        return a.0 < b.0;
    }
    if a.1 != b.1 {
        return a.1 < b.1;
    }
    if a.2 != b.2 {
        return a.2 < b.2;
    }
    a.3 < b.3
}

fn span_opener(h: ref Html, t: Str, std: ref Std) -> String {
    let title = if h.debug_token_types { f" title=\"{t}\"" } else { String.new() };
    if h.noclasses {
        let cs = css_inline_styles(h, t);
        if cs.len() > 0 {
            return f"<span style=\"{h.c2s.get(cs).unwrap().0}\"{title}>";
        }
        return String.new();
    }
    let cc = css_classes(h, t, std);
    if cc.len() > 0 {
        return f"<span class=\"{cc}\"{title}>";
    }
    String.new()
}

fn close_if(s: ref String) -> String {
    if s.len() > 0 { "</span>".to_string() } else { String.new() }
}

// _format_lines
fn format_lines(h: ref Html, toks: ref Vec[Tk], std: ref Std) -> Vec[(i64, String)] {
    let mut out: Vec[(i64, String)] = Vec.new();
    let lsep = h.lineseparator.clone();
    let mut lspan = String.new();
    let mut line: Vec[String] = Vec.new();
    let mut openers: Map[String, String] = Map.new();
    for tk in toks.iter() {
        let cspan = match openers.get(tk.t) {
            Some(c) => c.clone(),
            None => {
                let c = span_opener(h, tk.t, std);
                openers.insert(tk.t.clone(), c.clone());
                c
            }
        };
        let parts = split_char(escape_html(tk.v), b'\n');
        let n = parts.len();
        for k in 0..(n - 1) {
            let part = parts[k].clone();
            if line.len() > 0 {
                if lspan != cspan and part.len() > 0 {
                    line.push(close_if(lspan));
                    line.push(cspan.clone());
                    line.push(part);
                    line.push(close_if(cspan));
                    line.push(lsep.clone());
                } else {
                    line.push(part);
                    line.push(close_if(lspan));
                    line.push(lsep.clone());
                }
                out.push((1, join(line, "")));
                line = Vec.new();
            } else if part.len() > 0 {
                out.push((1, cspan.clone() + part + close_if(cspan) + lsep));
            } else {
                out.push((1, lsep.clone()));
            }
        }
        let last = parts[n - 1].clone();
        if line.len() > 0 and last.len() > 0 {
            if lspan != cspan {
                line.push(close_if(lspan));
                line.push(cspan.clone());
                line.push(last);
                lspan = cspan;
            } else {
                line.push(last);
            }
        } else if last.len() > 0 {
            line = vec![cspan.clone(), last];
            lspan = cspan;
        }
    }
    if line.len() > 0 {
        line.push(close_if(lspan));
        line.push(lsep);
        out.push((1, join(line, "")));
    }
    out
}

fn num_width(n: i64) -> i64 {
    f"{n}".len()
}

fn inline_linenos(h: ref Html, inner: Vec[(i64, String)]) -> Vec[(i64, String)] {
    let mut out: Vec[(i64, String)] = Vec.new();
    let sp = h.linenospecial;
    let st = h.linenostep;
    let mut num = h.linenostart;
    let mw = num_width(inner.len() + num - 1);
    let anchor = if h.lineanchors.len() > 0 { h.lineanchors.clone() } else { h.linespans.clone() };
    for (_, inner_line) in inner.iter() {
        let print_line = num % st == 0;
        let special = sp != 0 and num % sp == 0;
        let line = if print_line { pad_left(f"{num}", mw, " ") } else { spaces(mw) };
        let style = if h.noclasses {
            if special { f" style=\"{linenos_special_style(h)}\"" } else { f" style=\"{linenos_style(h)}\"" }
        } else {
            if special { " class=\"linenos special\"".to_string() } else { " class=\"linenos\"".to_string() }
        };
        let linenos = f"<span{style}>{line}</span>";
        if h.anchorlinenos {
            out.push((1, f"<a href=\"#{anchor}-{num}\">{linenos}</a>" + inner_line));
        } else {
            out.push((1, linenos + inner_line));
        }
        num += 1;
    }
    out
}

fn highlight_lines(h: ref Html, inner: Vec[(i64, String)]) -> Vec[(i64, String)] {
    let mut out: Vec[(i64, String)] = Vec.new();
    for i in 0..inner.len() {
        let (t, value) = inner[i].clone();
        if t != 1 {
            out.push((t, value.clone()));
        }
        let mut hit = false;
        for n in h.hl_lines.iter() {
            if n == i + 1 {
                hit = true;
            }
        }
        if hit {
            if h.noclasses {
                let style = match ref h.style.highlight {
                    Some(c) => f" style=\"background-color: {c}\"",
                    None => String.new(),
                };
                out.push((1, f"<span{style}>{value}</span>"));
            } else {
                out.push((1, f"<span class=\"hll\">{value}</span>"));
            }
        } else {
            out.push((1, value));
        }
    }
    out
}

fn wrap_lineanchors(h: ref Html, inner: Vec[(i64, String)]) -> Vec[(i64, String)] {
    let mut out: Vec[(i64, String)] = Vec.new();
    let s = h.lineanchors.clone();
    let mut i = h.linenostart - 1;
    for (t, line) in inner.iter() {
        if t != 0 {
            i += 1;
            let href = if h.linenos != 0 { String.new() } else { f" href=\"#{s}-{i}\"" };
            out.push((1, f"<a id=\"{s}-{i}\" name=\"{s}-{i}\"{href}></a>" + line));
        } else {
            out.push((0, line.clone()));
        }
    }
    out
}

fn wrap_linespans(h: ref Html, inner: Vec[(i64, String)]) -> Vec[(i64, String)] {
    let mut out: Vec[(i64, String)] = Vec.new();
    let s = h.linespans.clone();
    let mut i = h.linenostart - 1;
    for (t, line) in inner.iter() {
        if t != 0 {
            i += 1;
            out.push((1, f"<span id=\"{s}-{i}\">{line}</span>"));
        } else {
            out.push((0, line.clone()));
        }
    }
    out
}

fn wrap_pre(h: ref Html, inner: Vec[(i64, String)]) -> Vec[(i64, String)] {
    let mut out: Vec[(i64, String)] = Vec.new();
    let mut style: Vec[String] = Vec.new();
    if h.prestyles.len() > 0 {
        style.push(h.prestyles.clone());
    }
    if h.noclasses {
        style.push("line-height: 125%;".to_string());
    }
    let st = join(style, "; ");
    if h.filename.len() > 0 and h.linenos != 1 {
        out.push((0, f"<span class=\"filename\">{h.filename}</span>"));
    }
    let attr = if st.len() > 0 { f" style=\"{st}\"" } else { String.new() };
    out.push((0, f"<pre{attr}><span></span>"));
    for x in inner.iter() {
        out.push(x.clone());
    }
    out.push((0, "</pre>".to_string()));
    out
}

fn wrap_code(inner: Vec[(i64, String)]) -> Vec[(i64, String)] {
    let mut out: Vec[(i64, String)] = Vec.new();
    out.push((0, "<code>".to_string()));
    for x in inner.iter() {
        out.push(x.clone());
    }
    out.push((0, "</code>".to_string()));
    out
}

fn wrap_tablelinenos(h: ref Html, inner: Vec[(i64, String)]) -> Vec[(i64, String)] {
    let mut dummy = String.new();
    let mut lncount = 0;
    for (t, line) in inner.iter() {
        if t != 0 {
            lncount += 1;
        }
        dummy.push_str(line);
    }
    let fl = h.linenostart;
    let mw = num_width(lncount + fl - 1);
    let sp = h.linenospecial;
    let st = h.linenostep;
    let anchor = if h.lineanchors.len() > 0 { h.lineanchors.clone() } else { h.linespans.clone() };
    let mut lines: Vec[String] = Vec.new();
    for i in fl..(fl + lncount) {
        let print_line = i % st == 0;
        let special = sp != 0 and i % sp == 0;
        let mut line = if print_line { pad_left(f"{i}", mw, " ") } else { spaces(mw) };
        if print_line and h.anchorlinenos {
            line = f"<a href=\"#{anchor}-{i}\">{line}</a>";
        }
        let style = if h.noclasses {
            if special { f" style=\"{linenos_special_style(h)}\"" } else { f" style=\"{linenos_style(h)}\"" }
        } else {
            if special { " class=\"special\"".to_string() } else { " class=\"normal\"".to_string() }
        };
        lines.push(f"<span{style}>{line}</span>");
    }
    let ls = join(lines, "\n");
    let filename_tr = if h.filename.len() > 0 {
        f"<tr><th colspan=\"2\" class=\"filename\"><span class=\"filename\">{h.filename}</span></th></tr>"
    } else {
        String.new()
    };
    let mut out: Vec[(i64, String)] = Vec.new();
    out.push((0, f"<table class=\"{h.cssclass}table\">" + filename_tr + "<tr><td class=\"linenos\"><div class=\"linenodiv\"><pre>" + ls + "</pre></div></td><td class=\"code\">"));
    out.push((0, "<div>".to_string()));
    out.push((0, dummy));
    out.push((0, "</div>".to_string()));
    out.push((0, "</td></tr></table>".to_string()));
    out
}

fn wrap_div(h: ref Html, inner: Vec[(i64, String)]) -> Vec[(i64, String)] {
    let mut style: Vec[String] = Vec.new();
    if h.noclasses and not h.nobackground {
        if let Some(bg) = ref h.style.background {
            style.push(f"background: {bg}");
        }
    }
    if h.cssstyles.len() > 0 {
        style.push(h.cssstyles.clone());
    }
    let st = join(style, "; ");
    let cls = if h.cssclass.len() > 0 { f" class=\"{h.cssclass}\"" } else { String.new() };
    let sty = if st.len() > 0 { f" style=\"{st}\"" } else { String.new() };
    let mut out: Vec[(i64, String)] = Vec.new();
    out.push((0, f"<div{cls}{sty}>"));
    for x in inner.iter() {
        out.push(x.clone());
    }
    out.push((0, "</div>\n".to_string()));
    out
}

fn cssfile_template() -> String {
    "/*\ngenerated by Pygments <https://pygments.org/>\nCopyright 2006-2023 by the Pygments team.\nLicensed under the BSD license, see LICENSE for details.\n*/\n".to_string()
}

fn wrap_full(h: ref Html, inner: Vec[(i64, String)]) -> Vec[(i64, String)] {
    let mut head = "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\"\n   \"http://www.w3.org/TR/html4/strict.dtd\">\n<!--\ngenerated by Pygments <https://pygments.org/>\nCopyright 2006-2023 by the Pygments team.\nLicensed under the BSD license, see LICENSE for details.\n-->\n<html>\n<head>\n".to_string();
    head.push_str(f"  <title>{h.title}</title>\n");
    head.push_str(f"  <meta http-equiv=\"content-type\" content=\"text/html; charset={h.encoding}\">\n");
    head.push_str("  <style type=\"text/css\">\n");
    head.push_str(cssfile_template());
    head.push_str(get_style_defs(h, Some("body".to_string())));
    head.push_str("\n\n  </style>\n</head>\n<body>\n");
    head.push_str(f"<h2>{h.title}</h2>\n\n");
    let mut out: Vec[(i64, String)] = Vec.new();
    out.push((0, head));
    for x in inner.iter() {
        out.push(x.clone());
    }
    out.push((0, "</body>\n</html>\n".to_string()));
    out
}

fn format_html(h: ref Html, toks: ref Vec[Tk], std: ref Std) -> String {
    let mut source = format_lines(h, toks, std);
    if not h.nowrap and h.linenos == 2 {
        source = inline_linenos(h, source);
    }
    if h.hl_lines.len() > 0 {
        source = highlight_lines(h, source);
    }
    if not h.nowrap {
        if h.lineanchors.len() > 0 {
            source = wrap_lineanchors(h, source);
        }
        if h.linespans.len() > 0 {
            source = wrap_linespans(h, source);
        }
        if h.wrapcode {
            source = wrap_code(source);
        }
        source = wrap_pre(h, source);
        if h.linenos == 1 {
            source = wrap_tablelinenos(h, source);
        }
        source = wrap_div(h, source);
        if h.full {
            source = wrap_full(h, source);
        }
    }
    let mut out = String.new();
    for (_, piece) in source.iter() {
        out.push_str(piece);
    }
    out
}

// --------------------------------------------------------- terminal

fn term_code(name: Str) -> String {
    let esc = "\u{1b}[";
    if name == "" {
        return String.new();
    }
    if name == "reset" {
        return esc + "39;49;00m";
    }
    if name == "bold" or name == "white" {
        return esc + "01m";
    }
    if name == "underline" {
        return esc + "04m";
    }
    if name == "blink" {
        return esc + "05m";
    }
    let dark = sv(vec!["black", "red", "green", "yellow", "blue", "magenta", "cyan", "gray"]);
    let light = sv(vec!["brightblack", "brightred", "brightgreen", "brightyellow", "brightblue", "brightmagenta", "brightcyan", "white"]);
    for i in 0..8 {
        if dark[i] == name {
            return esc + f"{30 + i}m";
        }
        if light[i] == name {
            return esc + f"{90 + i}m";
        }
    }
    panic(f"no console code {name}")
}

fn ansiformat(attr_in: Str, text: Str) -> String {
    let mut attr = attr_in.to_string();
    let mut out = String.new();
    if attr.len() >= 1 and attr.starts_with("+") and attr.ends_with("+") {
        out.push_str(term_code("blink"));
        attr = slice_str(attr, 1, attr.len() - 1);
    }
    if attr.len() >= 1 and attr.starts_with("*") and attr.ends_with("*") {
        out.push_str(term_code("bold"));
        attr = slice_str(attr, 1, attr.len() - 1);
    }
    if attr.len() >= 1 and attr.starts_with("_") and attr.ends_with("_") {
        out.push_str(term_code("underline"));
        attr = slice_str(attr, 1, attr.len() - 1);
    }
    out.push_str(term_code(attr));
    out.push_str(text);
    out.push_str(term_code("reset"));
    out
}

fn terminal_colors() -> Vec[(String, String, String)] {
    let v: Vec[(Str, Str, Str)] = vec![
        ("", "", ""),
        ("Text.Whitespace", "gray", "brightblack"),
        ("Comment", "gray", "brightblack"),
        ("Comment.Preproc", "cyan", "brightcyan"),
        ("Keyword", "blue", "brightblue"),
        ("Keyword.Type", "cyan", "brightcyan"),
        ("Operator.Word", "magenta", "brightmagenta"),
        ("Name.Builtin", "cyan", "brightcyan"),
        ("Name.Function", "green", "brightgreen"),
        ("Name.Namespace", "_cyan_", "_brightcyan_"),
        ("Name.Class", "_green_", "_brightgreen_"),
        ("Name.Exception", "cyan", "brightcyan"),
        ("Name.Decorator", "brightblack", "gray"),
        ("Name.Variable", "red", "brightred"),
        ("Name.Constant", "red", "brightred"),
        ("Name.Attribute", "cyan", "brightcyan"),
        ("Name.Tag", "brightblue", "brightblue"),
        ("Literal.String", "yellow", "yellow"),
        ("Literal.Number", "blue", "brightblue"),
        ("Generic.Deleted", "brightred", "brightred"),
        ("Generic.Inserted", "green", "brightgreen"),
        ("Generic.Heading", "**", "**"),
        ("Generic.Subheading", "*magenta*", "*brightmagenta*"),
        ("Generic.Prompt", "**", "**"),
        ("Generic.Error", "brightred", "brightred"),
        ("Error", "_brightred_", "_brightred_"),
    ];
    let mut out: Vec[(String, String, String)] = Vec.new();
    for (a, b, c) in v.iter() {
        out.push((a.to_string(), b.to_string(), c.to_string()));
    }
    out
}

fn term_color(scheme: ref Vec[(String, String, String)], t: Str, dark: bool) -> String {
    let mut cur = t.to_string();
    loop {
        for (k, l, d) in scheme.iter() {
            if k == cur {
                return if dark { d.clone() } else { l.clone() };
            }
        }
        cur = tok_parent(cur).unwrap();
    }
}

fn format_terminal(f: ref Term, toks: ref Vec[Tk]) -> String {
    let scheme = terminal_colors();
    let mut out = String.new();
    let mut lineno = 0;
    if f.linenos {
        lineno += 1;
        out.push_str(f"{pad_left(f"{lineno}", 4, "0")}: ");
    }
    for tk in toks.iter() {
        let color = term_color(scheme, tk.t, f.darkbg);
        for line in splitlines_keep(tk.v).iter() {
            let body = rstrip_nl(line);
            if color.len() > 0 {
                out.push_str(ansiformat(color, body));
            } else {
                out.push_str(body);
            }
            if ends_with_nl(line) {
                if f.linenos {
                    lineno += 1;
                    out.push_str(f"\n{pad_left(f"{lineno}", 4, "0")}: ");
                } else {
                    out.push('\n');
                }
            }
        }
    }
    if f.linenos {
        out.push('\n');
    }
    out
}

// ------------------------------------------------- raw, null, testcase

fn format_raw(toks: ref Vec[Tk]) -> String {
    let mut out = String.new();
    for tk in toks.iter() {
        out.push_str(f"{tok_repr(tk.t)}\t{py_ascii(tk.v)}\n");
    }
    out
}

fn format_null(toks: ref Vec[Tk]) -> String {
    let mut out = String.new();
    for tk in toks.iter() {
        out.push_str(tk.v);
    }
    out
}

fn format_testcase(toks: ref Vec[Tk]) -> String {
    let mut raw = String.new();
    let mut body = String.new();
    for tk in toks.iter() {
        raw.push_str(tk.v);
        body.push_str(f"            ({tok_repr(tk.t)}, {py_repr(tk.v)}),\n");
    }
    let before = f"    def testNeedsName(lexer):\n        fragment = {py_repr(raw)}\n        tokens = [\n";
    let after = "        ]\n        assert list(lexer.get_tokens(fragment)) == tokens\n";
    before + body + after
}

fn format_tokens(f: ref Fmt, toks: ref Vec[Tk], std: ref Std) -> String {
    match f {
        Fmt.H(h) => format_html(h, toks, std),
        Fmt.T(t) => format_terminal(t, toks),
        Fmt.Raw => format_raw(toks),
        Fmt.Null => format_null(toks),
        Fmt.Testcase => format_testcase(toks),
    }
}

// ---------------------------------------------- finding lexers by name

// fnmatch.translate's pattern, matched against the whole name
fn glob_match(p: ref Vec[i64], pi: i64, s: ref Vec[i64], si: i64) -> bool {
    if pi == p.len() {
        return si == s.len();
    }
    let c = p[pi];
    if c == 42 {
        let mut k = si;
        while k <= s.len() {
            if glob_match(p, pi + 1, s, k) {
                return true;
            }
            k += 1;
        }
        return false;
    }
    if c == 63 {
        return si < s.len() and glob_match(p, pi + 1, s, si + 1);
    }
    if c == 91 {
        let mut j = pi + 1;
        if j < p.len() and p[j] == 33 {
            j += 1;
        }
        if j < p.len() and p[j] == 93 {
            j += 1;
        }
        while j < p.len() and p[j] != 93 {
            j += 1;
        }
        if j < p.len() {
            if si >= s.len() {
                return false;
            }
            let mut a = pi + 1;
            let neg = p[a] == 33;
            if neg {
                a += 1;
            }
            let mut hit = false;
            let mut k = a;
            while k < j {
                if k + 2 < j and p[k + 1] == 45 {
                    if s[si] >= p[k] and s[si] <= p[k + 2] {
                        hit = true;
                    }
                    k += 3;
                } else {
                    if s[si] == p[k] {
                        hit = true;
                    }
                    k += 1;
                }
            }
            if hit == neg {
                return false;
            }
            return glob_match(p, j + 1, s, si + 1);
        }
    }
    si < s.len() and s[si] == c and glob_match(p, pi + 1, s, si + 1)
}

fn basename(path: Str) -> String {
    let b = to_bytes(path);
    let mut i = b.len() - 1;
    while i >= 0 {
        if b[i] == b'/' {
            return slice_str(path, i + 1, b.len());
        }
        i -= 1;
    }
    path.to_string()
}

// find_lexer_class_for_filename(fn) without code: the highest priority,
// with a bonus for a pattern without '*', then the class name.
fn find_class_for_filename(e: ref Engine, path: Str) -> Option[i64] {
    let name = cps(basename(path));
    let mut best: Option[(f64, String, i64)] = None;
    for i in 0..e.lexmap.len() {
        let info = ref e.lexmap[i];
        for pat in info.filenames.iter() {
            if glob_match(cps(pat), 0, name, 0) {
                let bonus = if pat.contains("*") { 0.0 } else { 0.5 };
                let r = info.priority + bonus;
                let better = match ref best {
                    None => true,
                    Some((br, bn, _)) => r > *br or (r == *br and info.cls >= *bn),
                };
                if better {
                    best = Some((r, info.cls.clone(), i));
                }
            }
        }
    }
    match best {
        Some((_, _, i)) => Some(i),
        None => None,
    }
}

fn lexer_by_alias(e: ref Engine, alias: Str, opts: ref Vec[(String, Opt)]) -> Result[Lexer, PgErr] {
    if alias.len() > 0 {
        let a = case_lower(alias);
        for info in e.lexmap.iter() {
            if has(info.aliases, a) {
                return make_lexer(e, info.cls, opts);
            }
        }
    }
    Err(class_not_found(f"no lexer for alias {py_repr(alias)} found"))
}

fn lexer_by_mimetype(e: ref Engine, mime: Str, opts: ref Vec[(String, Opt)]) -> Result[Lexer, PgErr] {
    for info in e.lexmap.iter() {
        if has(info.mimetypes, mime) {
            return make_lexer(e, info.cls, opts);
        }
    }
    Err(class_not_found(f"no lexer for mimetype {py_repr(mime)} found"))
}

fn lexer_by_filename(e: ref Engine, path: Str, opts: ref Vec[(String, Opt)]) -> Result[Lexer, PgErr] {
    match find_class_for_filename(e, path) {
        Some(i) => make_lexer(e, e.lexmap[i].cls, opts),
        None => Err(class_not_found(f"no lexer for filename {py_repr(path)} found")),
    }
}

fn text_lexer(e: ref Engine) -> Lexer {
    make_lexer(e, "TextLexer", Vec.new()).unwrap()
}

// highlight(code, lexer, formatter)
fn highlight(e: mut ref Engine, l: ref Lexer, f: ref Fmt, code: Str) -> Result[String, PgErr] {
    let toks = get_tokens(mut e, l, code)?;
    Ok(format_tokens(f, toks, e.std))
}

// ------------------------------------------------------------ jobs

fn emit(text: Str) {
    let shown = replace_all(text, "\u{1b}", "^[");
    print(shown);
    if not ends_with_nl(shown) {
        print("\n<no newline>\n");
    }
}

fn implemented_aliases() -> Vec[String] {
    sv(vec!["python", "bash", "ini", "diff", "toml", "nginx", "css", "sql", "docker", "go", "rust", "javascript", "systemd", "properties", "xml", "html", "pytb", "c", "json", "text"])
}

fn catalog(e: ref Engine) {
    println("# lexers");
    for alias in implemented_aliases().iter() {
        let l = lexer_by_alias(e, alias, Vec.new()).unwrap();
        let info = ref e.lexmap[info_of(e, l.cls)];
        println(f"{info.name}: aliases={join(info.aliases, ",")} filenames={join(info.filenames, ",")} mimetypes={join(info.mimetypes, ",")}");
    }
    println("# find_lexer_class_for_filename");
    let names = sv(vec!["x.py", "x.pyw", "SConstruct", "x.sh", ".bashrc", "PKGBUILD", "x.ini", "x.cfg",
        "x.patch", "Pipfile", "x.toml", "nginx.conf", "x.css", "x.sql", "Dockerfile",
        "x.go", "x.rs", "x.js", "x.mjs", "x.service", "x.properties", "x.xml",
        "x.html", "x.xhtml", "x.pytb", "x.c", "x.h", "x.json", "x.txt", "x.unknown",
        "dir/sub/x.rs", "X.PY", "x.tar.gz"]);
    for n in names.iter() {
        let alias = match find_class_for_filename(e, n) {
            Some(i) => e.lexmap[i].aliases[0].clone(),
            None => "text".to_string(),
        };
        println(f"{n} -> {alias}");
    }
}

fn run_job(e: mut ref Engine, n: i64, line: Str) {
    let f = split_char(line, b'|');
    let mut shown: Vec[String] = Vec.new();
    for x in f.iter() {
        if x.len() > 0 {
            shown.push(x.clone());
        }
    }
    println(f"== job {n}: {join(shown, " ")}");
    let code = match fs.read_to_string(f"data/src/{f[6]}") {
        Ok(t) => t,
        Err(err) => {
            println(f"cannot read {f[6]}: {err}");
            return;
        }
    };
    let lo = parse_opts(f[2]);
    let made = if f[0] == "lex" {
        lexer_by_alias(e, f[1], lo)
    } else if f[0] == "file" {
        lexer_by_filename(e, f[1], lo)
    } else {
        lexer_by_mimetype(e, f[1], lo)
    };
    let mut lexer = match made {
        Ok(l) => l,
        Err(err) => {
            println(f"Error: {err.msg}");
            return;
        }
    };
    println(f"lexer: {lexer_repr(lexer)}");
    for fs_ in split_char(f[3], b';').iter() {
        if fs_.len() == 0 {
            continue;
        }
        let (name, fo) = match split_once(fs_, b':') {
            Some((a, b)) => (a, parse_opts(b)),
            None => (fs_.clone(), Vec.new()),
        };
        match make_filter(name, fo) {
            Ok(flt) => lexer.filters.push(flt),
            Err(err) => {
                println(f"Error: {err.msg}");
                return;
            }
        }
    }
    if f[4] == "-" {
        return;
    }
    let fmt = match get_formatter(f[4], parse_opts(f[5]), e.std) {
        Ok(x) => x,
        Err(err) => {
            println(f"Error: {err.msg}");
            return;
        }
    };
    match highlight(mut e, lexer, fmt, code) {
        Ok(out) => emit(out),
        Err(err) => println(f"raised {err.kind}: {err.msg}"),
    }
}

fn run_styles(e: ref Engine) {
    let text = fs.read_to_string("data/styles.txt".to_string()).unwrap();
    let mut n = 0;
    for line in split_char(text, b'\n').iter() {
        if line.len() == 0 {
            continue;
        }
        n += 1;
        let f = split_char(line, b'|');
        let mut shown: Vec[String] = Vec.new();
        for x in f.iter() {
            if x.len() > 0 {
                shown.push(x.clone());
            }
        }
        println(f"== style {n}: {join(shown, " ")}");
        let mut o = parse_opts(f[2]);
        opt_set(mut o, "style", Opt.S(f[0].clone()));
        match get_formatter("html", o, e.std) {
            Ok(Fmt.H(h)) => println(get_style_defs(h, Some(f[1].clone()))),
            Ok(_) => {}
            Err(err) => println(err.msg),
        }
    }
}

// ------------------------------------------------------- the docs site

fn esc_text(s: Str) -> String {
    replace_all(replace_all(replace_all(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
}

fn group_of(text: ref Vec[i64], m: ref Found, g: i64) -> Option[String] {
    let (a, b) = m.spans[g - 1];
    if a < 0 { None } else { Some(cp_text(text, a, b)) }
}

fn flush_para(para: mut ref Vec[String], out: mut ref Vec[String]) {
    if para.len() > 0 {
        out.push(f"<p>{esc_text(join(para, " "))}</p>");
        para.clear();
    }
}

fn build_page(e: mut ref Engine, src: Str) -> String {
    let fence = compile(cps("^```(\\w[\\w+-]*)?(?:\\s*\\{([^}]*)\\})?\\s*$"), 0).unwrap();
    let attr = compile(cps("(\\w+)(?:=\"([^\"]*)\")?"), 0).unwrap();
    let lines = split_char(src, b'\n');
    let mut out: Vec[String] = Vec.new();
    out.push("<!doctype html>".to_string());
    out.push("<link rel=\"stylesheet\" href=\"pygments.css\">".to_string());
    let mut para: Vec[String] = Vec.new();
    let mut i = 0;
    while i < lines.len() {
        let line = lines[i].clone();
        let lc = cps(line);
        let mut mm = new_matcher(fence, lc);
        if let Some(m) = find(mut mm, fence, 0, false, 1) {
            flush_para(mut para, mut out);
            let lang = group_of(lc, m, 1);
            let attrs = group_of(lc, m, 2).unwrap_or(String.new());
            let mut body: Vec[String] = Vec.new();
            i += 1;
            while i < lines.len() and lines[i] != "```" {
                body.push(lines[i].clone());
                i += 1;
            }
            i += 1;
            let mut opts: Vec[(String, Opt)] = Vec.new();
            let ac = cps(attrs);
            for am in all_matches(attr, ac, 0).iter() {
                let k = group_of(ac, am, 1).unwrap();
                let v = group_of(ac, am, 2);
                match v {
                    Some(val) => opt_set(mut opts, k, Opt.S(val)),
                    None => {
                        if k == "linenos" {
                            opt_set(mut opts, k, Opt.S("table".to_string()));
                        } else {
                            opt_set(mut opts, k, Opt.T);
                        }
                    }
                }
            }
            let lexer = match lang {
                Some(l) => match lexer_by_alias(e, l, Vec.new()) {
                    Ok(x) => x,
                    Err(_) => text_lexer(e),
                },
                None => text_lexer(e),
            };
            let fmt = get_formatter("html", opts, e.std).unwrap();
            out.push(f"<!-- {lexer.name} -->");
            let html = highlight(mut e, lexer, fmt, join(body, "\n") + "\n").unwrap();
            out.push(rstrip_nl(html));
            continue;
        }
        if line.starts_with("# ") {
            flush_para(mut para, mut out);
            out.push(f"<h1>{esc_text(slice_str(line, 2, line.len()))}</h1>");
        } else if py_strip(line).len() == 0 {
            flush_para(mut para, mut out);
        } else {
            para.push(py_strip(line));
        }
        i += 1;
    }
    flush_para(mut para, mut out);
    join(out, "\n") + "\n"
}

fn build_site(e: mut ref Engine) -> Result[(), String] {
    if fs.create_dir_all("data/site".to_string()).is_err() {
        return Err("cannot create data/site".to_string());
    }
    let mut pages = match fs.read_dir("data/docs".to_string()) {
        Ok(v) => v,
        Err(err) => return Err(f"cannot list data/docs: {err}"),
    };
    pages.sort();
    for page in pages.iter() {
        if not page.ends_with(".md") {
            continue;
        }
        let src = match fs.read_to_string(f"data/docs/{page}") {
            Ok(t) => t,
            Err(err) => return Err(f"cannot read {page}: {err}"),
        };
        let html = build_page(mut e, src);
        let name = slice_str(page, 0, page.len() - 3) + ".html";
        if fs.write(f"data/site/{name}", html).is_err() {
            return Err(f"cannot write {name}");
        }
    }
    let css = match get_formatter("html", Vec.new(), e.std) {
        Ok(Fmt.H(h)) => get_style_defs(h, Some(".highlight".to_string())),
        _ => String.new(),
    };
    if fs.write("data/site/pygments.css".to_string(), css + "\n").is_err() {
        return Err("cannot write pygments.css".to_string());
    }
    let mut names = match fs.read_dir("data/site".to_string()) {
        Ok(v) => v,
        Err(err) => return Err(f"cannot list data/site: {err}"),
    };
    names.sort();
    for name in names.iter() {
        println(f"== site/{name}");
        match fs.read_to_string(f"data/site/{name}") {
            Ok(t) => emit(t),
            Err(err) => return Err(f"cannot read {name}: {err}"),
        }
    }
    Ok(())
}

// ------------------------------------------------------------ data/

struct DataFile {
    path: String,
    body: String,
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts = split_char(path, b'/');
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(err) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {err}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    for file in data_files().iter() {
        make_parent(file.path)?;
        let p = f"data/{file.path}";
        if fs.write(p.clone(), file.body.clone()).is_err() {
            return Err(f"cannot write {p}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(err) = write_data() {
        println(err);
        return;
    }
    let mut e = new_engine();
    catalog(e);
    let jobs = fs.read_to_string("data/jobs.txt".to_string()).unwrap();
    let mut n = 0;
    for line in split_char(jobs, b'\n').iter() {
        if line.len() == 0 {
            continue;
        }
        n += 1;
        run_job(mut e, n, line);
    }
    run_styles(e);
    if let Err(err) = build_site(mut e) {
        println(err);
    }
}
// ------------------------------------------------- generated tables
// Printed by gen_tables.py from Pygments 2.17.2's own classes.

fn lexer_map() -> Vec[LexInfo] {
    let mut v: Vec[LexInfo] = Vec.new();
    lexer_map_0(mut v);
    lexer_map_1(mut v);
    lexer_map_2(mut v);
    lexer_map_3(mut v);
    v
}

