    t.push_str("lex|python|||html||svc.py\n");
    t.push_str("lex|python|||html|linenos=table,hl_lines=3 5 99,linenostart=10,linenostep=2,linenospecial=4|tabs.py\n");
    t.push_str("lex|bash|||html|linenos=inline,anchorlinenos=true,lineanchors=ln,cssclass=code|deploy.sh\n");
    t.push_str("lex|c|||html|nowrap=true|stock.c\n");
    t.push_str("lex|json|||html|noclasses=true,style=monokai,hl_lines=2|items.json\n");
    t.push_str("lex|css|||html|wrapcode=true,linespans=L,classprefix=pg-,filename=site.css|site.css\n");
    t.push_str("lex|diff|||html|full=true,title=The fix,style=friendly|fix.diff\n");
    t.push_str("lex|html|||html|noclasses=yes,nobackground=1,prestyles=margin: 0,cssstyles=border: 1px|index.html\n");
    t.push_str("lex|python|||html|linenos=1,filename=bad.py,noclasses=true|bad.py\n");
    t.push_str("lex|python|||html|debug_token_types=true|tabs.py\n");
    t.push_str("lex|python|||terminal||svc.py\n");
    t.push_str("lex|rust|||terminal|bg=dark,linenos=true|lib.rs\n");
    t.push_str("lex|diff|||console||fix.diff\n");
    t.push_str("lex|python|||terminal|bg=sepia|tabs.py\n");
    t.push_str("lex|go|||testcase||main.go\n");
    t.push_str("lex|python|||tokens||tabs.py\n");
    t.push_str("lex|python|||text||tabs.py\n");
    t.push_str("lex|python|||nosuchfmt||tabs.py\n");
    t.push_str("lex|python|||html|style=nosuchstyle|tabs.py\n");
    t.push_str("lex|python|||html|linenostart=x|tabs.py\n");
    t.push_str("lex|python|||raw|compress=zip|tabs.py\n");
    v.push(DataFile { path: "jobs.txt".to_string(), body: t });
    let mut t = String.new();
    t.push_str("<!doctype html>\n");
    t.push_str("<link rel=\"stylesheet\" href=\"pygments.css\">\n");
    t.push_str("<h1>API</h1>\n");
    t.push_str("<p>Each item comes back as JSON:</p>\n");
    t.push_str("<!-- JSON -->\n");
    t.push_str("<div class=\"highlight\"><pre><span></span><span class=\"p\">{</span><span class=\"nt\">&quot;sku&quot;</span><span class=\"p\">:</span><span class=\"w\"> </span><span class=\"s2\">&quot;ABC-1&quot;</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"nt\">&quot;qty&quot;</span><span class=\"p\">:</span><span class=\"w\"> </span><span class=\"mi\">12</span><span class=\"p\">}</span>\n");
    t.push_str("</pre></div>\n");
    t.push_str("<p>Unknown fences fall back to plain text:</p>\n");
    t.push_str("<!-- Text only -->\n");
    t.push_str("<div class=\"highlight\"><pre><span></span>DISPLAY &#39;HI&#39;.\n");
    t.push_str("</pre></div>\n");
    t.push_str("<!-- Text only -->\n");
    t.push_str("<div class=\"highlight\"><pre><span></span>no language at all &lt;b&gt;\n");
    t.push_str("</pre></div>\n");
    t.push_str("<p>And SQL, numbered from 5:</p>\n");
    t.push_str("<!-- SQL -->\n");
    t.push_str("<div class=\"highlight\"><table class=\"highlighttable\"><tr><td class=\"linenos\"><div class=\"linenodiv\"><pre><span class=\"normal\">5</span></pre></div></td><td class=\"code\"><div><pre><span></span><span class=\"k\">SELECT</span><span class=\"w\"> </span><span class=\"n\">sku</span><span class=\"w\"> </span><span class=\"k\">FROM</span><span class=\"w\"> </span><span class=\"n\">items</span><span class=\"w\"> </span><span class=\"k\">WHERE</span><span class=\"w\"> </span><span class=\"n\">qty</span><span class=\"w\"> </span><span class=\"o\">&lt;</span><span class=\"w\"> </span><span class=\"mi\">3</span><span class=\"p\">;</span>\n");
    t.push_str("</pre></div></td></tr></table></div>\n");
    v.push(DataFile { path: "site/api.html".to_string(), body: t });
    let mut t = String.new();
    t.push_str("<!doctype html>\n");
    t.push_str("<link rel=\"stylesheet\" href=\"pygments.css\">\n");
    t.push_str("<h1>Inventory docs</h1>\n");
    t.push_str("<p>Install the service, then point a client at it.</p>\n");
    t.push_str("<!-- Bash -->\n");
    t.push_str("<div class=\"highlight\"><pre><span></span>pip<span class=\"w\"> </span>install<span class=\"w\"> </span>inventory<span class=\"w\"> </span><span class=\"o\">&amp;&amp;</span><span class=\"w\"> </span>inventory<span class=\"w\"> </span>--port<span class=\"w\"> </span><span class=\"m\">8080</span>\n");
    t.push_str("</pre></div>\n");
    t.push_str("<p>A request from Python:</p>\n");
    t.push_str("<!-- Python -->\n");
    t.push_str("<div class=\"highlight\"><table class=\"highlighttable\"><tr><td class=\"linenos\"><div class=\"linenodiv\"><pre><span class=\"normal\">1</span>\n");
    t.push_str("<span class=\"normal\">2</span>\n");
    t.push_str("<span class=\"normal\">3</span></pre></div></td><td class=\"code\"><div><pre><span></span><span class=\"kn\">import</span> <span class=\"nn\">httpx</span>\n");
    t.push_str("<span class=\"hll\"><span class=\"n\">r</span> <span class=\"o\">=</span> <span class=\"n\">httpx</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s2\">&quot;http://localhost:8080/items&quot;</span><span class=\"p\">)</span>\n");
    t.push_str("</span><span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"n\">r</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()[</span><span class=\"s2\">&quot;count&quot;</span><span class=\"p\">])</span>\n");
    t.push_str("</pre></div></td></tr></table></div>\n");
    t.push_str("<p>The config file:</p>\n");
    t.push_str("<!-- INI -->\n");
    t.push_str("<div class=\"highlight\"><pre><span></span><span class=\"k\">[server]</span>\n");
    t.push_str("<span class=\"na\">port</span><span class=\"w\"> </span><span class=\"o\">=</span><span class=\"w\"> </span><span class=\"s\">8080</span>\n");
    t.push_str("</pre></div>\n");
    v.push(DataFile { path: "site/index.html".to_string(), body: t });
}

fn data_part_1(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("pre { line-height: 125%; }\n");
    t.push_str("td.linenos .normal { color: inherit; background-color: transparent; padding-left: 5px; padding-right: 5px; }\n");
    t.push_str("span.linenos { color: inherit; background-color: transparent; padding-left: 5px; padding-right: 5px; }\n");
    t.push_str("td.linenos .special { color: #000000; background-color: #ffffc0; padding-left: 5px; padding-right: 5px; }\n");
    t.push_str("span.linenos.special { color: #000000; background-color: #ffffc0; padding-left: 5px; padding-right: 5px; }\n");
    t.push_str(".highlight .hll { background-color: #ffffcc }\n");
    t.push_str(".highlight { background: #f8f8f8; }\n");
    t.push_str(".highlight .c { color: #3D7B7B; font-style: italic } /* Comment */\n");
    t.push_str(".highlight .err { border: 1px solid #FF0000 } /* Error */\n");
    t.push_str(".highlight .k { color: #008000; font-weight: bold } /* Keyword */\n");
    t.push_str(".highlight .o { color: #666666 } /* Operator */\n");
    t.push_str(".highlight .ch { color: #3D7B7B; font-style: italic } /* Comment.Hashbang */\n");
