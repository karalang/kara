// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    data_part_3(mut v);
    data_part_4(mut v);
    v
}

fn data_part_0(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("# API\n");
    t.push_str("\n");
    t.push_str("Each item comes back as JSON:\n");
    t.push_str("\n");
    t.push_str("```json\n");
    t.push_str("{\"sku\": \"ABC-1\", \"qty\": 12}\n");
    t.push_str("```\n");
    t.push_str("\n");
    t.push_str("Unknown fences fall back to plain text:\n");
    t.push_str("\n");
    t.push_str("```klingon\n");
    t.push_str("DISPLAY 'HI'.\n");
    t.push_str("```\n");
    t.push_str("\n");
    t.push_str("```\n");
    t.push_str("no language at all <b>\n");
    t.push_str("```\n");
    t.push_str("\n");
    t.push_str("And SQL, numbered from 5:\n");
    t.push_str("\n");
    t.push_str("```sql {linenos linenostart=\"5\"}\n");
    t.push_str("SELECT sku FROM items WHERE qty < 3;\n");
    t.push_str("```\n");
    v.push(DataFile { path: "docs/api.md".to_string(), body: t });
    let mut t = String.new();
    t.push_str("# Inventory docs\n");
    t.push_str("\n");
    t.push_str("Install the service, then point a client at it.\n");
    t.push_str("\n");
    t.push_str("```bash\n");
    t.push_str("pip install inventory && inventory --port 8080\n");
    t.push_str("```\n");
    t.push_str("\n");
    t.push_str("A request from Python:\n");
    t.push_str("\n");
    t.push_str("```python {linenos hl_lines=\"2\"}\n");
    t.push_str("import httpx\n");
    t.push_str("r = httpx.get(\"http://localhost:8080/items\")\n");
    t.push_str("print(r.json()[\"count\"])\n");
    t.push_str("```\n");
    t.push_str("\n");
    t.push_str("The config file:\n");
    t.push_str("\n");
    t.push_str("```ini\n");
    t.push_str("[server]\n");
    t.push_str("port = 8080\n");
    t.push_str("```\n");
    v.push(DataFile { path: "docs/index.md".to_string(), body: t });
    let mut t = String.new();
