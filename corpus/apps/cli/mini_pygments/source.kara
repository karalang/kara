        RawRule.Rule(Pat.Re("[^\\s;#]+".to_string()), Act.Tok("Keyword".to_string()), RawNew.Name("stmt".to_string())),
        RawRule.Include("base".to_string()),
    ]));
    s.push(("block".to_string(), vec![
        RawRule.Rule(Pat.Re("\\}".to_string()), Act.Tok("Punctuation".to_string()), RawNew.Name("#pop:2".to_string())),
        RawRule.Rule(Pat.Re("[^\\s;#]+".to_string()), Act.Tok("Keyword.Namespace".to_string()), RawNew.Name("stmt".to_string())),
        RawRule.Include("base".to_string()),
    ]));
    s.push(("stmt".to_string(), vec![
        RawRule.Rule(Pat.Re("\\{".to_string()), Act.Tok("Punctuation".to_string()), RawNew.Name("block".to_string())),
        RawRule.Rule(Pat.Re(";".to_string()), Act.Tok("Punctuation".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Include("base".to_string()),
    ]));
    s.push(("base".to_string(), vec![
        RawRule.Rule(Pat.Re("#.*\\n".to_string()), Act.Tok("Comment.Single".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("on|off".to_string()), Act.Tok("Name.Constant".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\\$[^\\s;#()]+".to_string()), Act.Tok("Name.Variable".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("([a-z0-9.-]+)(:)([0-9]+)".to_string()), Act.Groups(vec![Act.Tok("Name".to_string()), Act.Tok("Punctuation".to_string()), Act.Tok("Literal.Number.Integer".to_string())]), RawNew.NoNew),
