fn data_part_3(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("//! Inventory core.\n");
    t.push_str("use std::collections::HashMap;\n");
    t.push_str("\n");
    t.push_str("/// A stock-keeping unit.\n");
    t.push_str("#[derive(Debug, Clone, PartialEq)]\n");
    t.push_str("pub struct Item<'a> {\n");
    t.push_str("    pub sku: &'a str,\n");
    t.push_str("    qty: u32,\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("pub enum Event { Added(u32), Removed { qty: u32 }, Reset }\n");
    t.push_str("\n");
    t.push_str("impl<'a> Item<'a> {\n");
    t.push_str("    pub const MAX: u32 = 1_000;\n");
    t.push_str("\n");
    t.push_str("    pub fn new(sku: &'a str) -> Self {\n");
    t.push_str("        Item { sku, qty: 0 }\n");
    t.push_str("    }\n");
    t.push_str("\n");
    t.push_str("    pub fn apply(&mut self, e: &Event) -> Result<u32, String> {\n");
    t.push_str("        match *e {\n");
    t.push_str("            Event::Added(n) if n > 0 => self.qty += n,\n");
    t.push_str("            Event::Removed { qty } => self.qty = self.qty.checked_sub(qty).ok_or(\"underflow\")?,\n");
    t.push_str("            _ => return Err(format!(\"bad event {:?}\", e)),\n");
    t.push_str("        }\n");
    t.push_str("        let c = b'x'; let s = r#\"raw \"str\"\"#; let f = 2.5e-3_f64;\n");
    t.push_str("        println!(\"{} {} {}\", c, s, f);\n");
    t.push_str("        Ok(self.qty)\n");
    t.push_str("    }\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("/* block /* nested */ comment */\n");
    t.push_str("fn count(m: &HashMap<String, Vec<i64>>) -> usize { m.values().map(|v| v.len()).sum() }\n");
    v.push(DataFile { path: "src/lib.rs".to_string(), body: t });
    let mut t = String.new();
    t.push_str("// Package main serves the inventory API.\n");
    t.push_str("package main\n");
    t.push_str("\n");
    t.push_str("import (\n");
    t.push_str("\t\"fmt\"\n");
    t.push_str("\t\"net/http\"\n");
    t.push_str(")\n");
    t.push_str("\n");
    t.push_str("type Item struct {\n");
    t.push_str("\tSKU string `json:\"sku\"`\n");
    t.push_str("\tQty int    `json:\"qty\"`\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("const maxItems = 1 << 10\n");
    t.push_str("\n");
    t.push_str("func (i *Item) String() string {\n");
    t.push_str("\treturn fmt.Sprintf(\"%s:%d\", i.SKU, i.Qty)\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("func main() {\n");
    t.push_str("\titems := map[string]*Item{}\n");
    t.push_str("\tvar count uint64 = 0x10\n");
    t.push_str("\tr := 'x'\n");
    t.push_str("\tgo func() { count++ }()\n");
    t.push_str("\thttp.HandleFunc(\"/items\", func(w http.ResponseWriter, req *http.Request) {\n");
    t.push_str("\t\tfor k, v := range items {\n");
    t.push_str("\t\t\tfmt.Fprintln(w, k, v, r, 3.14e2, 1i)\n");
    t.push_str("\t\t}\n");
    t.push_str("\t})\n");
    t.push_str("\tdefer fmt.Println(`raw\n");
    t.push_str("string`)\n");
    t.push_str("\tif err := http.ListenAndServe(\":8080\", nil); err != nil {\n");
    t.push_str("\t\tpanic(err)\n");
    t.push_str("\t}\n");
    t.push_str("}\n");
    v.push(DataFile { path: "src/main.go".to_string(), body: t });
    let mut t = String.new();
    t.push_str("# Messages\n");
    t.push_str("! bang comment\n");
    t.push_str("greeting = Hello, {0}!\n");
    t.push_str("farewell: Goodbye\n");
    t.push_str("key\\ with\\ spaces = value\n");
    t.push_str("multi = first \\\n");
    t.push_str("        second\n");
    t.push_str("empty=\n");
    t.push_str("unicode=caf\\u00e9\n");
    v.push(DataFile { path: "src/messages.properties".to_string(), body: t });
    let mut t = String.new();
    t.push_str("user www-data;\n");
    t.push_str("worker_processes auto;\n");
    t.push_str("\n");
    t.push_str("http {\n");
    t.push_str("    include       mime.types;\n");
    t.push_str("    # upstream pool\n");
    t.push_str("    upstream app {\n");
    t.push_str("        server 127.0.0.1:8080 weight=3;\n");
    t.push_str("        server unix:/run/app.sock backup;\n");
    t.push_str("    }\n");
    t.push_str("    server {\n");
    t.push_str("        listen 443 ssl http2;\n");
    t.push_str("        server_name example.com *.example.com;\n");
    t.push_str("        location ~* \\.(png|jpg)$ {\n");
    t.push_str("            expires 30d;\n");
    t.push_str("            add_header Cache-Control \"public\";\n");
    t.push_str("        }\n");
    t.push_str("        location / {\n");
    t.push_str("            proxy_pass http://app;\n");
    t.push_str("            proxy_set_header Host $host;\n");
    t.push_str("            return 301 https://$host$request_uri;\n");
    t.push_str("        }\n");
    t.push_str("    }\n");
    t.push_str("}\n");
    v.push(DataFile { path: "src/nginx.conf".to_string(), body: t });
    let mut t = String.new();
    t.push_str("Plain text notes.\n");
    t.push_str("\tTabbed line with <angle> & \"quotes\".\n");
    v.push(DataFile { path: "src/notes.txt".to_string(), body: t });
    let mut t = String.new();
    t.push_str("-- Monthly stock report\n");
    t.push_str("WITH moves AS (\n");
    t.push_str("    SELECT sku, SUM(qty) AS total, COUNT(*) n\n");
    t.push_str("    FROM stock_moves\n");
    t.push_str("    WHERE moved_at >= DATE '2024-01-01' AND note NOT LIKE '%test%'\n");
    t.push_str("    GROUP BY sku\n");
    t.push_str(")\n");
    t.push_str("select i.sku, i.name, coalesce(m.total, 0) as total\n");
    t.push_str("from items i left outer join moves m on m.sku = i.sku\n");
    t.push_str("where i.price between 1.5 and 1e3 or i.name = 'O''Brien'\n");
    t.push_str("order by total desc limit 10;\n");
