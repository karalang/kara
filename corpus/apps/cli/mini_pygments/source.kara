fn data_part_2(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("#!/bin/bash\n");
    t.push_str("# Deploy the service to every host in $HOSTS.\n");
    t.push_str("set -euo pipefail\n");
    t.push_str("\n");
    t.push_str("readonly APP=\"inventory\"\n");
    t.push_str("declare -a HOSTS=(web1 web2 \"web 3\")\n");
    t.push_str("LOG_DIR=${LOG_DIR:-/var/log/$APP}\n");
    t.push_str("\n");
    t.push_str("log() {\n");
    t.push_str("    local level=$1; shift\n");
    t.push_str("    echo \"[$(date +%H:%M:%S)] ${level}: $*\" >&2\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("for host in \"${HOSTS[@]}\"; do\n");
    t.push_str("    if ! ssh -o ConnectTimeout=5 \"$host\" true; then\n");
    t.push_str("        log WARN \"skipping $host\"\n");
    t.push_str("        continue\n");
    t.push_str("    fi\n");
    t.push_str("    count=$(( count + 1 ))\n");
    t.push_str("    scp ./build/${APP}.tar.gz \"$host\":/tmp/ && \\\n");
    t.push_str("        ssh \"$host\" 'tar -xzf /tmp/inventory.tar.gz -C /opt'\n");
    t.push_str("done\n");
    t.push_str("\n");
    t.push_str("case \"$1\" in\n");
    t.push_str("    start|restart) systemctl \"$1\" \"$APP\" ;;\n");
    t.push_str("    stop) systemctl stop \"$APP\" ;;\n");
    t.push_str("    *) echo \"usage: $0 {start|stop}\" ; exit 2 ;;\n");
    t.push_str("esac\n");
    t.push_str("\n");
    t.push_str("cat <<EOF > /etc/motd\n");
    t.push_str("Deployed $APP at `date`\n");
    t.push_str("EOF\n");
    t.push_str("echo $((16#ff)) $? $# ~/bin\n");
    v.push(DataFile { path: "src/deploy.sh".to_string(), body: t });
    let mut t = String.new();
    t.push_str("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n");
    t.push_str("<!DOCTYPE feed>\n");
    t.push_str("<!-- Atom feed for the changelog -->\n");
    t.push_str("<feed xmlns=\"http://www.w3.org/2005/Atom\" xml:lang=\"en\">\n");
    t.push_str("  <title type=\"text\">Inventory &amp; Stock</title>\n");
    t.push_str("  <entry id='1'>\n");
    t.push_str("    <summary><![CDATA[<b>bold</b> & raw]]></summary>\n");
    t.push_str("    <link href=\"https://example.com/1\"/>\n");
    t.push_str("  </entry>\n");
    t.push_str("</feed>\n");
    v.push(DataFile { path: "src/feed.xml".to_string(), body: t });
    let mut t = String.new();
    t.push_str("diff --git a/inventory.py b/inventory.py\n");
    t.push_str("index 3b18e51..a9c2f7d 100644\n");
    t.push_str("--- a/inventory.py\n");
    t.push_str("+++ b/inventory.py\n");
    t.push_str("@@ -10,7 +10,8 @@ class Inventory(dict):\n");
    t.push_str("     def restock(self, sku, n=1):\n");
    t.push_str("-        self[sku] = self.get(sku, 0) + n\n");
    t.push_str("+        if n <= 0:\n");
    t.push_str("+            raise ValueError(n)\n");
    t.push_str("+        self[sku] = self.get(sku, 0) + n\n");
    t.push_str("         return self[sku]\n");
    t.push_str("Only in b: NEWS\n");
    t.push_str("! changed line\n");
    v.push(DataFile { path: "src/fix.diff".to_string(), body: t });
    let mut t = String.new();
    t.push_str("<!DOCTYPE html>\n");
    t.push_str("<html lang=\"en\">\n");
    t.push_str("<head>\n");
    t.push_str("  <meta charset=\"utf-8\">\n");
    t.push_str("  <title>Inventory</title>\n");
    t.push_str("  <style>\n");
    t.push_str("    body { margin: 0; color: #333; }\n");
    t.push_str("  </style>\n");
    t.push_str("  <script type=\"text/javascript\">\n");
    t.push_str("    const n = 1; if (n < 2) { console.log(\"ok\"); }\n");
    t.push_str("  </script>\n");
    t.push_str("</head>\n");
    t.push_str("<body class=\"main\" data-x=3>\n");
    t.push_str("  <!-- the app root -->\n");
    t.push_str("  <div id=\"app\">Loading&hellip;</div>\n");
    t.push_str("  <input disabled>\n");
    t.push_str("</body>\n");
    t.push_str("</html>\n");
    v.push(DataFile { path: "src/index.html".to_string(), body: t });
    let mut t = String.new();
    t.push_str("#!/usr/bin/env python3\n");
    t.push_str("\"\"\"Inventory service: stock levels and reorder rules.\"\"\"\n");
    t.push_str("from __future__ import annotations\n");
    t.push_str("\n");
    t.push_str("import dataclasses as dc\n");
    t.push_str("from collections import defaultdict\n");
    t.push_str("from typing import Iterator, Optional\n");
    t.push_str("\n");
    t.push_str("MAX_ITEMS = 1_000\n");
    t.push_str("RATE = 0x1F + 0o17 + 0b1010\n");
    t.push_str("SCALE = 1.5e-3 + 2j\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("@dc.dataclass(frozen=True)\n");
    t.push_str("class Item:\n");
    t.push_str("    sku: str\n");
    t.push_str("    qty: int = 0\n");
    t.push_str("    café: float = 0.0  # unicode name\n");
    t.push_str("\n");
    t.push_str("    def __repr__(self) -> str:\n");
    t.push_str("        return f\"Item({self.sku!r}, qty={self.qty:>4d}, {{literal}})\"\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("class Inventory(dict):\n");
    t.push_str("    def restock(self, sku, n=1, *args, **kw):\n");
    t.push_str("        # TODO: validate n; FIXME negative stock\n");
    t.push_str("        if (old := self.get(sku)) is None and n > 0:\n");
    t.push_str("            self[sku] = n\n");
    t.push_str("        elif not isinstance(n, int):\n");
    t.push_str("            raise TypeError(\"n must be an int, not %s\" % type(n).__name__)\n");
    t.push_str("        else:\n");
    t.push_str("            self[sku] = old + n\n");
    t.push_str("        return self[sku]\n");
    t.push_str("\n");
    t.push_str("    async def watch(self) -> Iterator[str]:\n");
    t.push_str("        async for event in self.events():\n");
    t.push_str("            await event.ack()\n");
    t.push_str("            yield event.sku\n");
    t.push_str("\n");
    t.push_str("    def summary(self):\n");
    t.push_str("        match self.status:\n");
    t.push_str("            case {\"state\": \"ok\", **rest}:\n");
    t.push_str("                return rb\"raw\\bytes\" + b'\\x00'\n");
    t.push_str("            case [first, *_] if first > 0:\n");
    t.push_str("                return lambda x: x ** 2\n");
    t.push_str("            case _:\n");
    t.push_str("                pass\n");
    t.push_str("        print(len(self), sorted(self), sep=\"\\t\", end='')\n");
    t.push_str("        return u'''multi\n");
    t.push_str("line'''\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("def _private(a, /, b, *, c): return a @ b if c else NotImplemented\n");
    v.push(DataFile { path: "src/inventory.py".to_string(), body: t });
    let mut t = String.new();
    t.push_str("[Unit]\n");
    t.push_str("Description=Inventory API\n");
    t.push_str("After=network-online.target\n");
    t.push_str("Wants=network-online.target\n");
    t.push_str("\n");
    t.push_str("# runtime\n");
    t.push_str("[Service]\n");
    t.push_str("Type=simple\n");
    t.push_str("ExecStart=/usr/bin/inventory --port 8080 \\\n");
    t.push_str("    --workers 4\n");
    t.push_str("Restart=on-failure\n");
    t.push_str("Environment=\"MODE=prod\" LANG=C.UTF-8\n");
    t.push_str("; legacy comment\n");
    t.push_str("\n");
    t.push_str("[Install]\n");
    t.push_str("WantedBy=multi-user.target\n");
    v.push(DataFile { path: "src/inventory.service".to_string(), body: t });
    let mut t = String.new();
    t.push_str("{\n");
    t.push_str("  \"items\": [\n");
    t.push_str("    {\"sku\": \"ABC-1\", \"qty\": 12, \"price\": 9.95, \"tags\": [\"new\", \"sale\"]},\n");
    t.push_str("    {\"sku\": \"XYZ-\\u00e9\", \"qty\": -3, \"price\": 1.2e3, \"active\": true},\n");
    t.push_str("    {\"sku\": \"Q\\\"T\", \"qty\": 0, \"note\": null, \"ok\": false}\n");
    t.push_str("  ],\n");
    t.push_str("  // comments are allowed\n");
    t.push_str("  /* block\n");
