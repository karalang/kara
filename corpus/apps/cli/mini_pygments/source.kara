fn tokens_pythonlexer() -> ClassDef {
    let mut s: Vec[(String, Vec[RawRule])] = Vec.new();
    s.push(("root".to_string(), vec![
        RawRule.Rule(Pat.Re("\\n".to_string()), Act.Tok("Text.Whitespace".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("^(\\s*)([rRuUbB]{,2})(\"\"\"(?:.|\\n)*?\"\"\")".to_string()), Act.Groups(vec![Act.Tok("Text.Whitespace".to_string()), Act.Tok("Literal.String.Affix".to_string()), Act.Tok("Literal.String.Doc".to_string())]), RawNew.NoNew),
        RawRule.Rule(Pat.Re("^(\\s*)([rRuUbB]{,2})('''(?:.|\\n)*?''')".to_string()), Act.Groups(vec![Act.Tok("Text.Whitespace".to_string()), Act.Tok("Literal.String.Affix".to_string()), Act.Tok("Literal.String.Doc".to_string())]), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\\A#!.+$".to_string()), Act.Tok("Comment.Hashbang".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("#.*$".to_string()), Act.Tok("Comment.Single".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\\\\\\n".to_string()), Act.Tok("Text".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\\\\".to_string()), Act.Tok("Text".to_string()), RawNew.NoNew),
