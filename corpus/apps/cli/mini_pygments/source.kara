    t.push_str("    \"\"\"One shelf of stock.\"\"\"\n");
    t.push_str("\n");
    t.push_str("    def take(self, sku, n=1):\n");
    t.push_str("        # TODO: lock the shelf first\n");
    t.push_str("        left = self.qty.get(sku, 0) - n\n");
    t.push_str("        if left < 0:  # FIXME: raise instead\n");
    t.push_str("            print(f\"short on {sku!r}\")\n");
    t.push_str("        return max(left, 0)  # NOTE: never negative\n");
