        RawRule.Rule(Pat.Re("(ONBUILD)(\\s+)((?:\\s*\\\\?\\s*))".to_string()), Act.Groups(vec![Act.Tok("Keyword".to_string()), Act.Tok("Text.Whitespace".to_string()), Act.Using("BashLexer".to_string(), sv(vec![]))]), RawNew.NoNew),
        RawRule.Rule(Pat.Re("(HEALTHCHECK)(\\s+)(((?:\\s*\\\\?\\s*)--\\w+=\\w+(?:\\s*\\\\?\\s*))*)".to_string()), Act.Groups(vec![Act.Tok("Keyword".to_string()), Act.Tok("Text.Whitespace".to_string()), Act.Using("BashLexer".to_string(), sv(vec![]))]), RawNew.NoNew),
        RawRule.Rule(Pat.Re("(VOLUME|ENTRYPOINT|CMD|SHELL)(\\s+)((?:\\s*\\\\?\\s*))(\\[.*?\\])".to_string()), Act.Groups(vec![Act.Tok("Keyword".to_string()), Act.Tok("Text.Whitespace".to_string()), Act.Using("BashLexer".to_string(), sv(vec![])), Act.Using("JsonLexer".to_string(), sv(vec![]))]), RawNew.NoNew),
        RawRule.Rule(Pat.Re("(LABEL|ENV|ARG)(\\s+)(((?:\\s*\\\\?\\s*)\\w+=\\w+(?:\\s*\\\\?\\s*))*)".to_string()), Act.Groups(vec![Act.Tok("Keyword".to_string()), Act.Tok("Text.Whitespace".to_string()), Act.Using("BashLexer".to_string(), sv(vec![]))]), RawNew.NoNew),
        RawRule.Rule(Pat.Re("((?:MAINTAINER|EXPOSE|WORKDIR|USER|STOPSIGNAL)|VOLUME)\\b(\\s+)(.*)".to_string()), Act.Groups(vec![Act.Tok("Keyword".to_string()), Act.Tok("Text.Whitespace".to_string()), Act.Tok("Literal.String".to_string())]), RawNew.NoNew),
        RawRule.Rule(Pat.Re("((?:RUN|CMD|ENTRYPOINT|ENV|ARG|LABEL|ADD|COPY))(\\s+)".to_string()), Act.Groups(vec![Act.Tok("Keyword".to_string()), Act.Tok("Text.Whitespace".to_string())]), RawNew.NoNew),
        RawRule.Rule(Pat.Re("(.*\\\\\\n)*.+".to_string()), Act.Using("BashLexer".to_string(), sv(vec![])), RawNew.NoNew),
    ]));
    ClassDef { name: "DockerLexer".to_string(), mro: sv(vec!["DockerLexer"]), flags: 10, states: s }
}

