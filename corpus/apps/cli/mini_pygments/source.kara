    s.push(("tdqf".to_string(), vec![
        RawRule.Rule(Pat.Re("\"\"\"".to_string()), Act.Tok("Literal.String.Double".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Include("fstrings-double".to_string()),
        RawRule.Rule(Pat.Re("\\n".to_string()), Act.Tok("Literal.String.Double".to_string()), RawNew.NoNew),
    ]));
    s.push(("tsqf".to_string(), vec![
        RawRule.Rule(Pat.Re("'''".to_string()), Act.Tok("Literal.String.Single".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Include("fstrings-single".to_string()),
        RawRule.Rule(Pat.Re("\\n".to_string()), Act.Tok("Literal.String.Single".to_string()), RawNew.NoNew),
    ]));
    s.push(("tdqs".to_string(), vec![
        RawRule.Rule(Pat.Re("\"\"\"".to_string()), Act.Tok("Literal.String.Double".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Include("strings-double".to_string()),
        RawRule.Rule(Pat.Re("\\n".to_string()), Act.Tok("Literal.String.Double".to_string()), RawNew.NoNew),
    ]));
    s.push(("tsqs".to_string(), vec![
        RawRule.Rule(Pat.Re("'''".to_string()), Act.Tok("Literal.String.Single".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Include("strings-single".to_string()),
        RawRule.Rule(Pat.Re("\\n".to_string()), Act.Tok("Literal.String.Single".to_string()), RawNew.NoNew),
    ]));
    ClassDef { name: "PythonLexer".to_string(), mro: sv(vec!["PythonLexer"]), flags: 8, states: s }
}

fn tokens_bashlexer() -> ClassDef {
    let mut s: Vec[(String, Vec[RawRule])] = Vec.new();
    s.push(("root".to_string(), vec![
        RawRule.Include("basic".to_string()),
        RawRule.Rule(Pat.Re("`".to_string()), Act.Tok("Literal.String.Backtick".to_string()), RawNew.Name("backticks".to_string())),
        RawRule.Include("data".to_string()),
        RawRule.Include("interp".to_string()),
    ]));
    s.push(("interp".to_string(), vec![
        RawRule.Rule(Pat.Re("\\$\\(\\(".to_string()), Act.Tok("Keyword".to_string()), RawNew.Name("math".to_string())),
        RawRule.Rule(Pat.Re("\\$\\(".to_string()), Act.Tok("Keyword".to_string()), RawNew.Name("paren".to_string())),
        RawRule.Rule(Pat.Re("\\$\\{#?".to_string()), Act.Tok("Literal.String.Interpol".to_string()), RawNew.Name("curly".to_string())),
        RawRule.Rule(Pat.Re("\\$[a-zA-Z_]\\w*".to_string()), Act.Tok("Name.Variable".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\\$(?:\\d+|[#$?!_*@-])".to_string()), Act.Tok("Name.Variable".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\\$".to_string()), Act.Tok("Text".to_string()), RawNew.NoNew),
    ]));
    s.push(("basic".to_string(), vec![
        RawRule.Rule(Pat.Re("\\b(if|fi|else|while|in|do|done|for|then|return|function|case|select|break|continue|until|esac|elif)(\\s*)\\b".to_string()), Act.Groups(vec![Act.Tok("Keyword".to_string()), Act.Tok("Text.Whitespace".to_string())]), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\\b(alias|bg|bind|builtin|caller|cd|command|compgen|complete|declare|dirs|disown|echo|enable|eval|exec|exit|export|false|fc|fg|getopts|hash|help|history|jobs|kill|let|local|logout|popd|printf|pushd|pwd|read|readonly|set|shift|shopt|source|suspend|test|time|times|trap|true|type|typeset|ulimit|umask|unalias|unset|wait)(?=[\\s)`])".to_string()), Act.Tok("Name.Builtin".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\\A#!.+\\n".to_string()), Act.Tok("Comment.Hashbang".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("#.*\\n".to_string()), Act.Tok("Comment.Single".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\\\\[\\w\\W]".to_string()), Act.Tok("Literal.String.Escape".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("(\\b\\w+)(\\s*)(\\+?=)".to_string()), Act.Groups(vec![Act.Tok("Name.Variable".to_string()), Act.Tok("Text.Whitespace".to_string()), Act.Tok("Operator".to_string())]), RawNew.NoNew),
        RawRule.Rule(Pat.Re("[\\[\\]{}()=]".to_string()), Act.Tok("Operator".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("<<<".to_string()), Act.Tok("Operator".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("<<-?\\s*(\\'?)\\\\?(\\w+)[\\w\\W]+?\\2".to_string()), Act.Tok("Literal.String".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("&&|\\|\\|".to_string()), Act.Tok("Operator".to_string()), RawNew.NoNew),
    ]));
    s.push(("data".to_string(), vec![
        RawRule.Rule(Pat.Re("(?s)\\$?\"(\\\\.|[^\"\\\\$])*\"".to_string()), Act.Tok("Literal.String.Double".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\"".to_string()), Act.Tok("Literal.String.Double".to_string()), RawNew.Name("string".to_string())),
        RawRule.Rule(Pat.Re("(?s)\\$'(\\\\\\\\|\\\\[0-7]+|\\\\.|[^'\\\\])*'".to_string()), Act.Tok("Literal.String.Single".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("(?s)'.*?'".to_string()), Act.Tok("Literal.String.Single".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re(";".to_string()), Act.Tok("Punctuation".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("&".to_string()), Act.Tok("Punctuation".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\\|".to_string()), Act.Tok("Punctuation".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\\s+".to_string()), Act.Tok("Text.Whitespace".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\\d+\\b".to_string()), Act.Tok("Literal.Number".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("[^=\\s\\[\\]{}()$\"\\'`\\\\<&|;]+".to_string()), Act.Tok("Text".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("<".to_string()), Act.Tok("Text".to_string()), RawNew.NoNew),
    ]));
    s.push(("string".to_string(), vec![
        RawRule.Rule(Pat.Re("\"".to_string()), Act.Tok("Literal.String.Double".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Rule(Pat.Re("(?s)(\\\\\\\\|\\\\[0-7]+|\\\\.|[^\"\\\\$])+".to_string()), Act.Tok("Literal.String.Double".to_string()), RawNew.NoNew),
        RawRule.Include("interp".to_string()),
    ]));
    s.push(("curly".to_string(), vec![
        RawRule.Rule(Pat.Re("\\}".to_string()), Act.Tok("Literal.String.Interpol".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Rule(Pat.Re(":-".to_string()), Act.Tok("Keyword".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\\w+".to_string()), Act.Tok("Name.Variable".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("[^}:\"\\'`$\\\\]+".to_string()), Act.Tok("Punctuation".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re(":".to_string()), Act.Tok("Punctuation".to_string()), RawNew.NoNew),
        RawRule.Include("root".to_string()),
    ]));
    s.push(("paren".to_string(), vec![
        RawRule.Rule(Pat.Re("\\)".to_string()), Act.Tok("Keyword".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Include("root".to_string()),
    ]));
    s.push(("math".to_string(), vec![
        RawRule.Rule(Pat.Re("\\)\\)".to_string()), Act.Tok("Keyword".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Rule(Pat.Re("\\*\\*|\\|\\||<<|>>|[-+*/%^|&<>]".to_string()), Act.Tok("Operator".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\\d+#[\\da-zA-Z]+".to_string()), Act.Tok("Literal.Number".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\\d+#(?! )".to_string()), Act.Tok("Literal.Number".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("0[xX][\\da-fA-F]+".to_string()), Act.Tok("Literal.Number".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\\d+".to_string()), Act.Tok("Literal.Number".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("[a-zA-Z_]\\w*".to_string()), Act.Tok("Name.Variable".to_string()), RawNew.NoNew),
        RawRule.Include("root".to_string()),
    ]));
    s.push(("backticks".to_string(), vec![
        RawRule.Rule(Pat.Re("`".to_string()), Act.Tok("Literal.String.Backtick".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Include("root".to_string()),
    ]));
    ClassDef { name: "BashLexer".to_string(), mro: sv(vec!["BashLexer"]), flags: 8, states: s }
}

fn tokens_inilexer() -> ClassDef {
    let mut s: Vec[(String, Vec[RawRule])] = Vec.new();
    s.push(("root".to_string(), vec![
        RawRule.Rule(Pat.Re("\\s+".to_string()), Act.Tok("Text.Whitespace".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("[;#].*".to_string()), Act.Tok("Comment.Single".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("(\\[.*?\\])([ \\t]*)$".to_string()), Act.Groups(vec![Act.Tok("Keyword".to_string()), Act.Tok("Text.Whitespace".to_string())]), RawNew.NoNew),
        RawRule.Rule(Pat.Re("(.*?)([ \u{a0}\\t]*)([=:])([ \\t]*)([^;#\\n]*)(\\\\)(\\s+)".to_string()), Act.Groups(vec![Act.Tok("Name.Attribute".to_string()), Act.Tok("Text.Whitespace".to_string()), Act.Tok("Operator".to_string()), Act.Tok("Text.Whitespace".to_string()), Act.Tok("Literal.String".to_string()), Act.Tok("Text".to_string()), Act.Tok("Text.Whitespace".to_string())]), RawNew.Name("value".to_string())),
        RawRule.Rule(Pat.Re("(.*?)([ \\t]*)([=:])([ \u{a0}\\t]*)([^ ;#\\n]*(?: +[^ ;#\\n]+)*)".to_string()), Act.Groups(vec![Act.Tok("Name.Attribute".to_string()), Act.Tok("Text.Whitespace".to_string()), Act.Tok("Operator".to_string()), Act.Tok("Text.Whitespace".to_string()), Act.Tok("Literal.String".to_string())]), RawNew.NoNew),
        RawRule.Rule(Pat.Re("(.+?)$".to_string()), Act.Tok("Name.Attribute".to_string()), RawNew.NoNew),
    ]));
    s.push(("value".to_string(), vec![
        RawRule.Rule(Pat.Re("\\s+".to_string()), Act.Tok("Text.Whitespace".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("(\\s*)(.*)(\\\\)([ \\t]*)".to_string()), Act.Groups(vec![Act.Tok("Text.Whitespace".to_string()), Act.Tok("Literal.String".to_string()), Act.Tok("Text".to_string()), Act.Tok("Text.Whitespace".to_string())]), RawNew.NoNew),
        RawRule.Rule(Pat.Re(".*$".to_string()), Act.Tok("Literal.String".to_string()), RawNew.Name("#pop".to_string())),
    ]));
    ClassDef { name: "IniLexer".to_string(), mro: sv(vec!["IniLexer"]), flags: 8, states: s }
}

fn tokens_difflexer() -> ClassDef {
    let mut s: Vec[(String, Vec[RawRule])] = Vec.new();
    s.push(("root".to_string(), vec![
        RawRule.Rule(Pat.Re("( )(.*)(\\n)".to_string()), Act.Groups(vec![Act.Tok("Text.Whitespace".to_string()), Act.Tok("Text".to_string()), Act.Tok("Text.Whitespace".to_string())]), RawNew.NoNew),
        RawRule.Rule(Pat.Re("(!.*|---)(\\n)".to_string()), Act.Groups(vec![Act.Tok("Generic.Strong".to_string()), Act.Tok("Text.Whitespace".to_string())]), RawNew.NoNew),
        RawRule.Rule(Pat.Re("((?:< |-).*)(\\n)".to_string()), Act.Groups(vec![Act.Tok("Generic.Deleted".to_string()), Act.Tok("Text.Whitespace".to_string())]), RawNew.NoNew),
        RawRule.Rule(Pat.Re("((?:> |\\+).*)(\\n)".to_string()), Act.Groups(vec![Act.Tok("Generic.Inserted".to_string()), Act.Tok("Text.Whitespace".to_string())]), RawNew.NoNew),
        RawRule.Rule(Pat.Re("(@.*|\\d(?:,\\d+)?(?:a|c|d)\\d+(?:,\\d+)?)(\\n)".to_string()), Act.Groups(vec![Act.Tok("Generic.Subheading".to_string()), Act.Tok("Text.Whitespace".to_string())]), RawNew.NoNew),
        RawRule.Rule(Pat.Re("((?:[Ii]ndex|diff).*)(\\n)".to_string()), Act.Groups(vec![Act.Tok("Generic.Heading".to_string()), Act.Tok("Text.Whitespace".to_string())]), RawNew.NoNew),
        RawRule.Rule(Pat.Re("(=.*)(\\n)".to_string()), Act.Groups(vec![Act.Tok("Generic.Heading".to_string()), Act.Tok("Text.Whitespace".to_string())]), RawNew.NoNew),
        RawRule.Rule(Pat.Re("(.*)(\\n)".to_string()), Act.Groups(vec![Act.Tok("Text".to_string()), Act.Tok("Text.Whitespace".to_string())]), RawNew.NoNew),
    ]));
    ClassDef { name: "DiffLexer".to_string(), mro: sv(vec!["DiffLexer"]), flags: 8, states: s }
}

fn tokens_tomllexer() -> ClassDef {
    let mut s: Vec[(String, Vec[RawRule])] = Vec.new();
    s.push(("root".to_string(), vec![
        RawRule.Rule(Pat.Re("\\s+".to_string()), Act.Tok("Text.Whitespace".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("#.*".to_string()), Act.Tok("Comment.Single".to_string()), RawNew.NoNew),
        RawRule.Include("key".to_string()),
        RawRule.Rule(Pat.Re("(=)(\\s*)".to_string()), Act.Groups(vec![Act.Tok("Operator".to_string()), Act.Tok("Text.Whitespace".to_string())]), RawNew.Name("value".to_string())),
        RawRule.Rule(Pat.Re("\\[\\[?".to_string()), Act.Tok("Keyword".to_string()), RawNew.Name("table-key".to_string())),
    ]));
    s.push(("key".to_string(), vec![
        RawRule.Rule(Pat.Re("[A-Za-z0-9_-]+".to_string()), Act.Tok("Name".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\"".to_string()), Act.Tok("Literal.String.Double".to_string()), RawNew.Name("basic-string".to_string())),
        RawRule.Rule(Pat.Re("'".to_string()), Act.Tok("Literal.String.Single".to_string()), RawNew.Name("literal-string".to_string())),
        RawRule.Rule(Pat.Re("\\.".to_string()), Act.Tok("Punctuation".to_string()), RawNew.NoNew),
    ]));
    s.push(("table-key".to_string(), vec![
        RawRule.Rule(Pat.Re("[A-Za-z0-9_-]+".to_string()), Act.Tok("Keyword".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\"".to_string()), Act.Tok("Literal.String.Double".to_string()), RawNew.Name("basic-string".to_string())),
        RawRule.Rule(Pat.Re("'".to_string()), Act.Tok("Literal.String.Single".to_string()), RawNew.Name("literal-string".to_string())),
        RawRule.Rule(Pat.Re("\\.".to_string()), Act.Tok("Keyword".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\\]\\]?".to_string()), Act.Tok("Keyword".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Rule(Pat.Re("[ \\t]+".to_string()), Act.Tok("Text.Whitespace".to_string()), RawNew.NoNew),
    ]));
    s.push(("value".to_string(), vec![
        RawRule.Rule(Pat.Re("(?x)\n                  \\d\\d\\d\\d-\\d\\d-\\d\\d # date, e.g., 1988-10-27\n                (\n                  [Tt ] \\d\\d:\\d\\d:\\d\\d(\\.\\d+)? # optional time\n                  (\n                    [Zz]|[+-]\\d\\d:\\d\\d # optional time offset\n                  )?\n                )?\n              ".to_string()), Act.Tok("Literal.Date".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Rule(Pat.Re("\\d\\d:\\d\\d:\\d\\d(\\.\\d+)?".to_string()), Act.Tok("Literal.Date".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Rule(Pat.Re("[+-]?\\d[0-9_]*[eE][+-]?\\d[0-9_]*".to_string()), Act.Tok("Literal.Number.Float".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Rule(Pat.Re("[+-]?\\d[0-9_]*\\.\\d[0-9_]*([eE][+-]?\\d[0-9_]*)?".to_string()), Act.Tok("Literal.Number.Float".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Rule(Pat.Re("[+-]?(inf|nan)".to_string()), Act.Tok("Literal.Number.Float".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Rule(Pat.Re("-?0b[01_]+".to_string()), Act.Tok("Literal.Number.Bin".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Rule(Pat.Re("-?0o[0-7_]+".to_string()), Act.Tok("Literal.Number.Oct".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Rule(Pat.Re("-?0x[0-9a-fA-F_]+".to_string()), Act.Tok("Literal.Number.Hex".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Rule(Pat.Re("[+-]?[0-9_]+".to_string()), Act.Tok("Literal.Number.Integer".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Rule(Pat.Re("\"\"\"".to_string()), Act.Tok("Literal.String.Double".to_string()), RawNew.Tuple(sv(vec!["#pop", "multiline-basic-string"]))),
        RawRule.Rule(Pat.Re("\"".to_string()), Act.Tok("Literal.String.Double".to_string()), RawNew.Tuple(sv(vec!["#pop", "basic-string"]))),
        RawRule.Rule(Pat.Re("'''".to_string()), Act.Tok("Literal.String.Single".to_string()), RawNew.Tuple(sv(vec!["#pop", "multiline-literal-string"]))),
        RawRule.Rule(Pat.Re("'".to_string()), Act.Tok("Literal.String.Single".to_string()), RawNew.Tuple(sv(vec!["#pop", "literal-string"]))),
        RawRule.Rule(Pat.Re("true|false".to_string()), Act.Tok("Keyword.Constant".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Rule(Pat.Re("\\[".to_string()), Act.Tok("Punctuation".to_string()), RawNew.Tuple(sv(vec!["#pop", "array"]))),
        RawRule.Rule(Pat.Re("\\{".to_string()), Act.Tok("Punctuation".to_string()), RawNew.Tuple(sv(vec!["#pop", "inline-table"]))),
    ]));
    s.push(("array".to_string(), vec![
        RawRule.Rule(Pat.Re("\\s+".to_string()), Act.Tok("Text.Whitespace".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("#.*".to_string()), Act.Tok("Comment.Single".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re(",".to_string()), Act.Tok("Punctuation".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\\]".to_string()), Act.Tok("Punctuation".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Default(RawNew.Name("value".to_string())),
    ]));
    s.push(("inline-table".to_string(), vec![
        RawRule.Rule(Pat.Re("[ \\t]+".to_string()), Act.Tok("Text.Whitespace".to_string()), RawNew.NoNew),
        RawRule.Include("key".to_string()),
        RawRule.Rule(Pat.Re("(=)(\\s*)".to_string()), Act.Groups(vec![Act.Tok("Punctuation".to_string()), Act.Tok("Text.Whitespace".to_string())]), RawNew.Name("value".to_string())),
        RawRule.Rule(Pat.Re(",".to_string()), Act.Tok("Punctuation".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\\}".to_string()), Act.Tok("Punctuation".to_string()), RawNew.Name("#pop".to_string())),
    ]));
    s.push(("basic-string".to_string(), vec![
        RawRule.Rule(Pat.Re("\"".to_string()), Act.Tok("Literal.String.Double".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Include("escapes".to_string()),
        RawRule.Rule(Pat.Re("[^\"\\\\]+".to_string()), Act.Tok("Literal.String.Double".to_string()), RawNew.NoNew),
    ]));
    s.push(("literal-string".to_string(), vec![
        RawRule.Rule(Pat.Re(".*?'".to_string()), Act.Tok("Literal.String.Single".to_string()), RawNew.Name("#pop".to_string())),
    ]));
    s.push(("multiline-basic-string".to_string(), vec![
        RawRule.Rule(Pat.Re("\"\"\"".to_string()), Act.Tok("Literal.String.Double".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Rule(Pat.Re("(\\\\)(\\n)".to_string()), Act.Groups(vec![Act.Tok("Literal.String.Escape".to_string()), Act.Tok("Text.Whitespace".to_string())]), RawNew.NoNew),
        RawRule.Include("escapes".to_string()),
        RawRule.Rule(Pat.Re("[^\"\\\\]+".to_string()), Act.Tok("Literal.String.Double".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\"".to_string()), Act.Tok("Literal.String.Double".to_string()), RawNew.NoNew),
    ]));
    s.push(("multiline-literal-string".to_string(), vec![
        RawRule.Rule(Pat.Re("'''".to_string()), Act.Tok("Literal.String.Single".to_string()), RawNew.Name("#pop".to_string())),
        RawRule.Rule(Pat.Re("[^']+".to_string()), Act.Tok("Literal.String.Single".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("'".to_string()), Act.Tok("Literal.String.Single".to_string()), RawNew.NoNew),
    ]));
    s.push(("escapes".to_string(), vec![
        RawRule.Rule(Pat.Re("\\\\u[0-9a-fA-F]{4}|\\\\U[0-9a-fA-F]{8}".to_string()), Act.Tok("Literal.String.Escape".to_string()), RawNew.NoNew),
        RawRule.Rule(Pat.Re("\\\\.".to_string()), Act.Tok("Literal.String.Escape".to_string()), RawNew.NoNew),
    ]));
    ClassDef { name: "TOMLLexer".to_string(), mro: sv(vec!["TOMLLexer"]), flags: 8, states: s }
}

fn tokens_nginxconflexer() -> ClassDef {
