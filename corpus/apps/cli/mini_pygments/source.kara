fn tokens_dockerlexer() -> ClassDef {
    let mut s: Vec[(String, Vec[RawRule])] = Vec.new();
    s.push(("root".to_string(), vec![
        RawRule.Rule(Pat.Re("#.*".to_string()), Act.Tok("Comment".to_string()), RawNew.NoNew),
