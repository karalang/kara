    t.push_str("\n");
    t.push_str("int restock(stock_t *s, int n) {\n");
    t.push_str("    if (s == NULL || n <= 0) return -1;\n");
    t.push_str("    s->qty += (uint32_t)n; // add\n");
    t.push_str("    switch (n) {\n");
    t.push_str("    case 1: break;\n");
    t.push_str("    default: goto out;\n");
    t.push_str("    }\n");
