// mini_read_table: a Kāra port of pandas 3.0.5's read_csv and read_table
// with engine="python" (BSD-3-Clause, the pandas development team), over
// a port of CPython's csv reader and csv.Sniffer (PSF licence): the
// three ways _make_reader reads a file (a one-character separator through
// the csv module, sep=None through the Sniffer on the first line, and a
// longer separator as a regular expression), dialects with pandas'
// conflicting-value warnings, quotechar, escapechar, doublequote,
// skipinitialspace and quoting with csv's validation errors,
// on_bad_lines error, warn and skip, the length warning with
// index_col=False, true_values and false_values, encoding_errors, and
// the PythonParser it shares with read_fwf: header rows and names,
// usecols, index_col with the implicit index, skiprows, skipfooter,
// nrows, chunksize, comment, skip_blank_lines, thousands and decimal,
// na_values, keep_default_na, na_filter, dtype and dtype_backend, type
// inference for each column, and to_csv. The file is decoded as Python
// opens it (UTF-8 with Python's error messages and handlers, UTF-8 with
// a signature, ISO-8859-1, windows-1252 or ASCII).
//
// It reads data/jobs.txt, one job per line, runs each in a task of its
// own, and prints, in job order, `$ <job>` and what the oracle prints:
// each warning as `warn: <message>`, then the frame's shape, its dtypes
// and to_csv, for each chunk with chunksize. An error prints as
// `! <exception>: <message>`.

import std.sync.{TaskGroup};

// ------------------------------------------------------------ bytes and text

fn byte_str(b: ref Vec[u8], from: i64, to: i64) -> String {
    let mut v: Vec[u8] = Vec.new();
    for i in from..to {
        v.push(b[i]);
    }
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn bytes_of(b: ref Vec[u8], from: i64, to: i64) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for i in from..to {
        v.push(b[i]);
    }
    v
}

fn to_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn from_bytes(v: Vec[u8]) -> String {
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn is_letter(c: u8) -> bool {
    (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z')
}

fn is_alnum(c: u8) -> bool {
    is_digit(c) or is_letter(c)
}

fn is_hex_digit(c: u8) -> bool {
    is_digit(c) or ((c | 32) >= b'a' and (c | 32) <= b'f')
}

// IS_WS_HTML: space, tab, line feed, form feed and carriage return.
fn is_ws_html(c: u8) -> bool {
    c == 32 or (c >= 9 and c <= 13 and c != 11)
}

fn lower_ascii(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for c in b {
        out.push(if c >= b'A' and c <= b'Z' { c + 32 } else { c });
    }
    from_bytes(out)
}

fn split_on(s: Str, sep: u8) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut st: i64 = 0;
    for i in 0..b.len() {
        if b[i] == sep {
            out.push(byte_str(b, st, i));
            st = i + 1;
        }
    }
    out.push(byte_str(b, st, b.len()));
    out
}

fn split_spaces(s: Str) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        while i < b.len() and (b[i] == b' ' or b[i] == b'\n') {
            i += 1;
        }
        let st = i;
        while i < b.len() and b[i] != b' ' and b[i] != b'\n' {
            i += 1;
        }
        if i > st {
            out.push(byte_str(b, st, i));
        }
    }
    out
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

fn lines_of(text: Str) -> Vec[String] {
    let mut v = split_on(text, b'\n');
    if v.len() > 0 and v[v.len() - 1].len() == 0 {
        v.pop();
    }
    v
}

fn has_byte(s: Str, c: u8) -> bool {
    for x in s.bytes() {
        if x == c {
            return true;
        }
    }
    false
}

fn replace_all(s: Str, from: Str, to: Str) -> String {
    let b = to_bytes(s);
    let f = to_bytes(from);
    let mut out = String.new();
    let mut i: i64 = 0;
    let mut st: i64 = 0;
    while i + f.len() <= b.len() {
        let mut hit = f.len() > 0;
        for k in 0..f.len() {
            if hit and b[i + k] != f[k] {
                hit = false;
            }
        }
        if hit {
            out.push_str(byte_str(b, st, i));
            out.push_str(to);
            i += f.len();
            st = i;
        } else {
            i += 1;
        }
    }
    out.push_str(byte_str(b, st, b.len()));
    out
}

// The position of `pat` in `b` at or after `from`, ignoring ASCII case;
// -1 when it is not there (xmlStrcasestr).

fn hex_val(c: u8) -> u8 {
    if is_digit(c) { c - b'0' } else { (c | 32) - b'a' + 10 }
}

// The bytes a run of hex digits spells; anything else is skipped.
fn unhex(s: Str) -> Vec[u8] {
    let mut digits: Vec[u8] = Vec.new();
    for c in s.bytes() {
        if is_hex_digit(c) {
            digits.push(hex_val(c));
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < digits.len() {
        out.push(digits[i] * 16 + digits[i + 1]);
        i += 2;
    }
    out
}


// ------------------------------------------------------------ code points (from mini_re)

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for cp in s {
        if cp < 0x80 {
            out.push(cp as u8);
        } else if cp < 0x800 {
            out.push((0xC0 | (cp >> 6)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else if cp < 0x10000 {
            out.push((0xE0 | (cp >> 12)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (cp >> 18)) as u8);
            out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

fn str_repr(s: ref Vec[i64], out: mut ref Vec[i64]) {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
}

fn repr_of(s: ref Vec[i64]) -> String {
    let mut out: Vec[i64] = Vec.new();
    str_repr(s, mut out);
    to_string(out)
}

fn is_space(c: i64, ascii: bool) -> bool {
    if c == 32 or (c >= 9 and c <= 13) {
        return true;
    }
    if ascii {
        return false;
    }
    (c >= 0x1C and c <= 0x1F) or c == 0x85 or c == 0xA0 or c == 0x1680 or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F or c == 0x3000
}


// ------------------------------------------------------------ Python values

struct PyErr {
    kind: String,
    msg: String,
}

fn py_err(kind: Str, msg: Str) -> PyErr {
    PyErr { kind: kind.to_string(), msg: msg.to_string() }
}

fn nan() -> f64 {
    0.0 / 0.0
}

fn inf() -> f64 {
    1.0 / 0.0
}

fn is_nan(x: f64) -> bool {
    x != x
}

fn cps_of(s: Str) -> Vec[i64] {
    codepoints(s.bytes())
}

// repr() of a str.
fn py_repr(s: Str) -> String {
    repr_of(cps_of(s))
}

// str.strip(): Python's white space off both ends.
fn py_strip(s: Str) -> String {
    let c = cps_of(s);
    let mut a: i64 = 0;
    let mut b = c.len();
    while a < b and is_space(c[a], false) {
        a += 1;
    }
    while b > a and is_space(c[b - 1], false) {
        b -= 1;
    }
    to_string(slice(c, a, b))
}

// repr() of a float.
fn float_repr(x: f64) -> String {
    if is_nan(x) {
        "nan".to_string()
    } else if x == inf() {
        "inf".to_string()
    } else if x == -inf() {
        "-inf".to_string()
    } else {
        x.to_string()
    }
}

// int(s) for a str: an optional sign and decimal digits, with
// surrounding white space and single underscores between digits.
fn py_int(s: Str) -> Option[i64] {
    let b = to_bytes(py_strip(s));
    let mut i: i64 = 0;
    let mut neg = false;
    if i < b.len() and (b[i] == b'+' or b[i] == b'-') {
        neg = b[i] == b'-';
        i += 1;
    }
    if i >= b.len() {
        return None;
    }
    let mut v: i64 = 0;
    let mut last_digit = false;
    while i < b.len() {
        let c = b[i];
        if is_digit(c) {
            if v > 922337203685477580 {
                return None;
            }
            v = v * 10 + (c - b'0') as i64;
            last_digit = true;
        } else if c == b'_' and last_digit and i + 1 < b.len() and is_digit(b[i + 1]) {
            last_digit = false;
        } else {
            return None;
        }
        i += 1;
    }
    Some(if neg { -v } else { v })
}

// float(s) for a str: what Python's float() accepts, including inf,
// infinity and nan in any case.
fn py_float(s: Str) -> Option[f64] {
    let t = py_strip(s);
    let low = lower_ascii(t);
    let (sign, body) = if low.starts_with("-") {
        (-1.0, low[1..].to_string())
    } else if low.starts_with("+") {
        (1.0, low[1..].to_string())
    } else {
        (1.0, low.clone())
    };
    if body == "inf" or body == "infinity" {
        return Some(sign * inf());
    }
    if body == "nan" {
        return Some(nan());
    }
    let b = to_bytes(body);
    if b.len() == 0 {
        return None;
    }
    let mut i: i64 = 0;
    let mut digits = 0;
    while i < b.len() and is_digit(b[i]) {
        i += 1;
        digits += 1;
    }
    if i < b.len() and b[i] == b'.' {
        i += 1;
        while i < b.len() and is_digit(b[i]) {
            i += 1;
            digits += 1;
        }
    }
    if digits == 0 {
        return None;
    }
    if i < b.len() and b[i] == b'e' {
        i += 1;
        if i < b.len() and (b[i] == b'+' or b[i] == b'-') {
            i += 1;
        }
        let st = i;
        while i < b.len() and is_digit(b[i]) {
            i += 1;
        }
        if i == st {
            return None;
        }
    }
    if i != b.len() {
        return None;
    }
    match f64.parse(t) {
        Ok(x) => Some(x),
        Err(_) => None,
    }
}


// The index of a code-point string inside another, or -1.
fn find_cps(s: ref Vec[i64], pat: ref Vec[i64]) -> i64 {
    if pat.len() == 0 {
        return 0;
    }
    let mut i: i64 = 0;
    while i + pat.len() <= s.len() {
        let mut ok = true;
        for j in 0..pat.len() {
            if s[i + j] != pat[j] {
                ok = false;
                break;
            }
        }
        if ok {
            return i;
        }
        i += 1;
    }
    -1
}

// ------------------------------------------------------------ cells and labels

// A value in an object column: a string, a bool, or NaN.
#[derive(Clone)]
enum Val {
    Na,
    S(String),
    B(bool),
}

// One element of a column or index label.
#[derive(Clone)]
enum Lab {
    Nil,
    I(i64),
    S(String),
}

// A column picked by position or by name (usecols, index_col).
#[derive(Clone)]
enum Ic {
    I(i64),
    S(String),
}

fn val_text(v: ref Val) -> String {
    match v {
        Val.Na => "".to_string(),
        Val.S(s) => s.clone(),
        Val.B(b) => if b { "True".to_string() } else { "False".to_string() },
    }
}

fn lab_eq(a: ref Lab, b: ref Lab) -> bool {
    match (a, b) {
        (Lab.Nil, Lab.Nil) => true,
        (Lab.I(x), Lab.I(y)) => x == y,
        (Lab.S(x), Lab.S(y)) => x == y,
        _ => false,
    }
}

fn key_eq(a: ref Vec[Lab], b: ref Vec[Lab]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if not lab_eq(a[i], b[i]) {
            return false;
        }
    }
    true
}

fn lab_repr(l: ref Lab) -> String {
    match l {
        Lab.Nil => "None".to_string(),
        Lab.I(n) => n.to_string(),
        Lab.S(s) => py_repr(s),
    }
}

// str() of a label, as an f-string writes it.
fn lab_fstr(l: ref Lab) -> String {
    match l {
        Lab.Nil => "None".to_string(),
        Lab.I(n) => n.to_string(),
        Lab.S(s) => s.clone(),
    }
}

// A label as the csv writer writes it: None is empty.
fn lab_csv(l: ref Lab) -> String {
    match l {
        Lab.Nil => "".to_string(),
        _ => lab_fstr(l),
    }
}

// A column label is a key: one label, or the tuple of a MultiIndex.
fn key_repr(k: ref Vec[Lab]) -> String {
    if k.len() == 1 {
        return lab_repr(k[0]);
    }
    let mut parts: Vec[String] = Vec.new();
    for l in k {
        parts.push(lab_repr(l));
    }
    f"({join(parts, ", ")})"
}

fn key_csv(k: ref Vec[Lab]) -> String {
    if k.len() == 1 {
        return lab_csv(k[0]);
    }
    key_repr(k)
}

fn key_fstr(k: ref Vec[Lab]) -> String {
    if k.len() == 1 {
        return lab_fstr(k[0]);
    }
    key_repr(k)
}

fn key_of(s: Str) -> Vec[Lab] {
    vec![Lab.S(s.to_string())]
}

// The key a dtype or na_values entry names: only a plain string label.
fn key_name(k: ref Vec[Lab]) -> Option[String] {
    if k.len() != 1 {
        return None;
    }
    match k[0] {
        Lab.S(s) => Some(s.clone()),
        _ => None,
    }
}

fn int_in(v: ref Vec[i64], x: i64) -> bool {
    for y in v {
        if y == x {
            return true;
        }
    }
    false
}

fn str_in(v: ref Vec[String], s: Str) -> bool {
    for x in v {
        if x == s {
            return true;
        }
    }
    false
}

fn sorted_ints(v: ref Vec[i64]) -> Vec[i64] {
    let mut out = v.clone();
    let n = out.len();
    for i in 0..n {
        for j in 0..n - 1 - i {
            if out[j] > out[j + 1] {
                let t = out[j];
                out[j] = out[j + 1];
                out[j + 1] = t;
            }
        }
    }
    out
}

fn ic_eq(a: ref Ic, b: ref Ic) -> bool {
    match (a, b) {
        (Ic.I(x), Ic.I(y)) => x == y,
        (Ic.S(x), Ic.S(y)) => x == y,
        _ => false,
    }
}

fn ic_lab(ic: ref Ic, l: ref Lab) -> bool {
    match (ic, l) {
        (Ic.I(a), Lab.I(b)) => a == b,
        (Ic.S(a), Lab.S(b)) => a == b,
        _ => false,
    }
}

fn ic_matches(ic: ref Ic, k: ref Vec[Lab]) -> bool {
    k.len() == 1 and ic_lab(ic, k[0])
}

// is_potential_multi_index: every label outside the index is a tuple.
fn potential_mi(cols: ref Vec[Vec[Lab]], index_col: ref Option[Vec[Ic]]) -> bool {
    if cols.len() == 0 {
        return false;
    }
    let ic = match index_col {
        Some(ref v) => v.clone(),
        None => Vec.new(),
    };
    for k in cols {
        let mut in_index = false;
        for c in ic {
            if ic_matches(c, k) {
                in_index = true;
            }
        }
        if not in_index and k.len() < 2 {
            return false;
        }
    }
    true
}

fn key_count(seen: ref Vec[(Vec[Lab], i64)], k: ref Vec[Lab]) -> i64 {
    for (s, n) in seen {
        if key_eq(s, k) {
            return n;
        }
    }
    0
}

fn set_key_count(seen: mut ref Vec[(Vec[Lab], i64)], k: ref Vec[Lab], n: i64) {
    for i in 0..seen.len() {
        if key_eq(seen[i].0, k) {
            seen[i].1 = n;
            return;
        }
    }
    seen.push((k.clone(), n));
}

// The label dedup_names makes of a repeat: `x.1`, or the tuple with
// its last element so marked.
fn renamed(col: ref Vec[Lab], n: i64, mi: bool) -> Vec[Lab] {
    if mi and col.len() > 1 {
        let mut c = col.clone();
        let last = c.len() - 1;
        c[last] = Lab.S(f"{lab_fstr(col[last])}.{n}");
        return c;
    }
    vec![Lab.S(f"{key_fstr(col)}.{n}")]
}

// pandas.io.common.dedup_names.
fn dedup_names(names: ref Vec[Vec[Lab]], mi: bool) -> Vec[Vec[Lab]] {
    let mut out = names.clone();
    let mut counts: Vec[(Vec[Lab], i64)] = Vec.new();
    for i in 0..out.len() {
        let mut col = out[i].clone();
        let mut cur = key_count(counts, col);
        while cur > 0 {
            set_key_count(mut counts, col, cur + 1);
            col = renamed(col, cur, mi);
            cur = key_count(counts, col);
        }
        out[i] = col.clone();
        set_key_count(mut counts, col, cur + 1);
    }
    out
}

// A Python list as repr prints it.
fn list_repr(items: ref Vec[String]) -> String {
    f"[{join(items, ", ")}]"
}

// ------------------------------------------------------------ missing values

fn str_na_values() -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    for c in ["", "#N/A", "#N/A N/A", "#NA", "-1.#IND", "-1.#QNAN", "-NaN", "-nan", "1.#IND", "1.#QNAN", "<NA>", "N/A", "NA", "NULL", "NaN", "None", "n/a", "nan", "null"] {
        v.push(c.to_string());
    }
    v
}

// The values a column reads as missing: strings, and the numbers equal
// to them.
#[derive(Clone)]
struct NaSet {
    strs: Vec[String],
    nums: Vec[f64],
}

impl NaSet {
    fn has(ref self, v: ref Val) -> bool {
        match v {
            Val.S(s) => str_in(self.strs, s),
            _ => false,
        }
    }

    fn has_num(ref self, x: f64) -> bool {
        for n in self.nums {
            if n == x {
                return true;
            }
        }
        false
    }
}

fn empty_na() -> NaSet {
    NaSet { strs: Vec.new(), nums: Vec.new() }
}

// _stringify_na_values and _floatify_na_values of the values given,
// with the default ones when keep_default_na.
fn na_set(given: ref Vec[String], keep_default_na: bool) -> NaSet {
    let mut strs: Vec[String] = Vec.new();
    let mut nums: Vec[f64] = Vec.new();
    let mut all = given.clone();
    if keep_default_na {
        for s in str_na_values() {
            all.push(s.clone());
        }
    }
    for x in all {
        strs.push(x.clone());
        if let Some(v) = py_float(x) {
            if not is_nan(v) and v != inf() and v != -inf() {
                if v == v.floor() {
                    let iv = v as i64;
                    strs.push(f"{iv}.0");
                    strs.push(iv.to_string());
                }
                nums.push(v);
            }
        }
    }
    NaSet { strs: strs, nums: nums }
}

// na_values after _clean_na_values: one set for every column, or one
// per named column with the defaults (or nothing) for the rest.
#[derive(Clone)]
struct NaSpec {
    filter: bool,
    keep_default_na: bool,
    all: NaSet,
    by_col: Option[Vec[(String, NaSet)]],
}

impl NaSpec {
    // get_na_values for a data column.
    fn for_col(ref self, k: ref Vec[Lab]) -> NaSet {
        if not self.filter {
            return empty_na();
        }
        match self.by_col {
            None => self.all.clone(),
            Some(ref m) => {
                if let Some(name) = key_name(k) {
                    for (c, s) in m {
                        if c == name {
                            return s.clone();
                        }
                    }
                }
                if self.keep_default_na { na_set(Vec.new(), true) } else { empty_na() }
            }
        }
    }

    // The set _agg_index uses for an index level.
    fn for_index(ref self, name: ref Vec[Lab]) -> NaSet {
        if not self.filter {
            return empty_na();
        }
        match self.by_col {
            None => self.all.clone(),
            Some(_) => {
                if name.len() == 1 and lab_eq(name[0], Lab.Nil) {
                    return empty_na();
                }
                self.for_col(name)
            }
        }
    }

    // `x in self.na_values` in _check_comments: a value of the set, or a
    // key of the dict.
    fn holds(ref self, x: Str) -> bool {
        match self.by_col {
            None => str_in(self.all.strs, x),
            Some(ref m) => {
                for (c, _) in m {
                    if c == x {
                        return true;
                    }
                }
                false
            }
        }
    }
}

// ------------------------------------------------------------ columns

// A column as numpy and pandas hold it: numpy int64, float64 and bool,
// an object array (Val.Na is NaN), a Categorical, pandas 3's str, and
// the masked arrays of the nullable dtypes, where None is <NA>.
#[derive(Clone)]
enum Col {
    Int(Vec[i64]),
    Float(Vec[f64]),
    Bool(Vec[bool]),
    Obj(Vec[Val]),
    Cat(Vec[Val]),
    Str(Vec[Option[String]]),
    NInt(Vec[Option[i64]]),
    NFloat(Vec[Option[f64]]),
    NBool(Vec[Option[bool]]),
    NStr(Vec[Option[String]]),
}

// The dtype a DataFrame gives the column: an object array of strings
// and NaN becomes pandas 3's str.
fn dtype_name(c: ref Col) -> String {
    match c {
        Col.Int(_) => "int64".to_string(),
        Col.Float(_) => "float64".to_string(),
        Col.Bool(_) => "bool".to_string(),
        Col.Obj(v) => {
            let mut strs = 0;
            for x in v {
                match x {
                    Val.S(_) => strs += 1,
                    Val.Na => {}
                    _ => return "object".to_string(),
                }
            }
            if strs == 0 { "object".to_string() } else { "str".to_string() }
        }
        Col.Cat(_) => "category".to_string(),
        Col.Str(_) => "str".to_string(),
        Col.NInt(_) => "Int64".to_string(),
        Col.NFloat(_) => "Float64".to_string(),
        Col.NBool(_) => "boolean".to_string(),
        Col.NStr(_) => "string".to_string(),
    }
}

fn bool_word(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

// One value as to_csv writes it: missing values are empty.
fn cell_text(c: ref Col, i: i64) -> String {
    match c {
        Col.Int(v) => v[i].to_string(),
        Col.Float(v) => if is_nan(v[i]) { "".to_string() } else { float_repr(v[i]) },
        Col.Bool(v) => bool_word(v[i]),
        Col.Obj(v) => val_text(v[i]),
        Col.Cat(v) => val_text(v[i]),
        Col.Str(v) => match v[i] {
            Some(s) => s.clone(),
            None => "".to_string(),
        },
        Col.NInt(v) => match v[i] {
            Some(n) => n.to_string(),
            None => "".to_string(),
        },
        Col.NFloat(v) => match v[i] {
            Some(x) => float_repr(x),
            None => "".to_string(),
        },
        Col.NBool(v) => match v[i] {
            Some(b) => bool_word(b),
            None => "".to_string(),
        },
        Col.NStr(v) => match v[i] {
            Some(s) => s.clone(),
            None => "".to_string(),
        },
    }
}

// floatify: the number a string spells, and whether it could be an int.
fn floatify(s: Str) -> Option[(f64, bool)] {
    let t = py_strip(s);
    let low = lower_ascii(t);
    let body = if low.starts_with("-") or low.starts_with("+") { low[1..].to_string() } else { low.clone() };
    if body == "inf" or body == "infinity" or body == "nan" {
        return match py_float(t) {
            Some(x) => Some((x, false)),
            None => None,
        };
    }
    if has_byte(t, b'_') {
        return None;
    }
    match py_float(t) {
        Some(x) => Some((x, not (has_byte(t, b'.') or has_byte(t, b'e') or has_byte(t, b'E')))),
        None => None,
    }
}

// maybe_convert_numeric over strings; None where it raises. With
// `masked` a missing value goes in the mask instead of making the
// column float.
fn convert_numeric(vals: ref Vec[Val], na: ref NaSet, masked: bool) -> Option[Col] {
    let mut floats: Vec[f64] = Vec.new();
    let mut ints: Vec[i64] = Vec.new();
    let mut mask: Vec[bool] = Vec.new();
    let mut seen_float = false;
    for v in vals {
        let mut null = false;
        match v {
            Val.S(s) => {
                if na.has(v) {
                    null = true;
                } else {
                    if s.len() == 0 {
                        return None;
                    }
                    let (x, maybe) = floatify(s)?;
                    if na.has_num(x) {
                        null = true;
                    } else {
                        floats.push(x);
                        mask.push(false);
                        if maybe {
                            ints.push(py_int(s)?);
                        } else {
                            ints.push(0);
                            seen_float = true;
                        }
                    }
                }
            }
            Val.Na => null = true,
            _ => return None,
        }
        if null {
            floats.push(nan());
            ints.push(0);
            mask.push(true);
            if not masked {
                seen_float = true;
            }
        }
    }
    if masked {
        let mut all = true;
        for m in mask {
            if not m {
                all = false;
            }
        }
        if all or not seen_float {
            let mut out: Vec[Option[i64]] = Vec.new();
            for i in 0..ints.len() {
                out.push(if mask[i] { None } else { Some(ints[i]) });
            }
            return Some(Col.NInt(out));
        }
        let mut out: Vec[Option[f64]] = Vec.new();
        for i in 0..floats.len() {
            out.push(if mask[i] { None } else { Some(floats[i]) });
        }
        return Some(Col.NFloat(out));
    }
    if seen_float {
        Some(Col.Float(floats))
    } else {
        Some(Col.Int(ints))
    }
}

// sanitize_objects: the missing values become NaN; the count of them.
fn sanitize(vals: own Vec[Val], na: ref NaSet) -> (Vec[Val], i64) {
    let mut out: Vec[Val] = Vec.new();
    let mut n: i64 = 0;
    for v in vals.into_iter() {
        if na.has(v) {
            out.push(Val.Na);
            n += 1;
        } else {
            out.push(v);
        }
    }
    (out, n)
}

// maybe_convert_bool; None where it hands the values back.
// The strings true_values and false_values add to pandas' own.
#[derive(Clone)]
struct BoolVals {
    trues: Vec[String],
    falses: Vec[String],
}

fn convert_bool(vals: ref Vec[Val], masked: bool, bv: ref BoolVals) -> Option[Col] {
    let mut out: Vec[Option[bool]] = Vec.new();
    let mut has_na = false;
    for v in vals {
        match v {
            Val.B(b) => out.push(Some(b)),
            Val.S(s) => {
                if s == "True" or s == "TRUE" or s == "true" or str_in(bv.trues, s) {
                    out.push(Some(true));
                } else if s == "False" or s == "FALSE" or s == "false" or str_in(bv.falses, s) {
                    out.push(Some(false));
                } else {
                    return None;
                }
            }
            Val.Na => {
                out.push(None);
                has_na = true;
            }
        }
    }
    if masked {
        return Some(Col.NBool(out));
    }
    if has_na {
        let mut objs: Vec[Val] = Vec.new();
        for b in out {
            objs.push(match b {
                Some(x) => Val.B(x),
                None => Val.Na,
            });
        }
        return Some(Col.Obj(objs));
    }
    let mut bools: Vec[bool] = Vec.new();
    for b in out {
        bools.push(b.unwrap_or(false));
    }
    Some(Col.Bool(bools))
}

fn nan_count(c: ref Col) -> i64 {
    let mut n: i64 = 0;
    match c {
        Col.Float(v) => {
            for x in v {
                if is_nan(x) {
                    n += 1;
                }
            }
        }
        Col.NInt(v) => {
            for x in v {
                if x.is_none() {
                    n += 1;
                }
            }
        }
        Col.NFloat(v) => {
            for x in v {
                if x.is_none() {
                    n += 1;
                }
            }
        }
        _ => {}
    }
    n
}

// _infer_types for an object column of cells: the column and the
// number of missing values in it.
fn infer_types(vals: own Vec[Val], na: ref NaSet, masked: bool, try_num_bool: bool, bv: ref BoolVals) -> (Col, i64) {
    if try_num_bool {
        if let Some(c) = convert_numeric(vals, na, masked) {
            let n = nan_count(c);
            return (c, n);
        }
    }
    let (v, count) = sanitize(vals, na);
    if try_num_bool {
        if let Some(c) = convert_bool(v, masked, bv) {
            return (c, count);
        }
        if masked {
            let mut out: Vec[Option[String]] = Vec.new();
            for x in v {
                out.push(match x {
                    Val.Na => None,
                    _ => Some(val_text(x)),
                });
            }
            return (Col.NStr(out), count);
        }
    }
    (Col.Obj(v), count)
}

// ------------------------------------------------------------ dtypes

// pandas_dtype of a dtype argument, by the names the jobs use.
fn known_dtype(kind: Str) -> bool {
    kind == "str" or kind == "object" or kind == "string" or kind == "category" or kind == "int64" or kind == "float64" or kind == "bool" or kind == "Int64" or kind == "Float64" or kind == "boolean"
}

fn is_ea_dtype(kind: Str) -> bool {
    kind == "str" or kind == "string" or kind == "category" or kind == "Int64" or kind == "Float64" or kind == "boolean"
}

fn is_string_dtype(kind: Str) -> bool {
    kind == "str" or kind == "object" or kind == "string"
}

fn is_numeric_dtype(kind: Str) -> bool {
    kind == "int64" or kind == "float64" or kind == "bool" or kind == "Int64" or kind == "Float64" or kind == "boolean"
}

fn is_bool_dtype(kind: Str) -> bool {
    kind == "bool" or kind == "boolean"
}

fn dtype_error(kind: Str) -> PyErr {
    py_err("TypeError", f"data type {py_repr(kind)} not understood")
}

// The values of a column as Python objects: a string, a number, NaN.
fn as_vals(c: ref Col) -> Vec[Val] {
    let mut out: Vec[Val] = Vec.new();
    match c {
        Col.Obj(v) => return v.clone(),
        Col.Cat(v) => return v.clone(),
        Col.Int(v) => {
            for x in v {
                out.push(Val.S(x.to_string()));
            }
        }
        Col.Float(v) => {
            for x in v {
                out.push(if is_nan(x) { Val.Na } else { Val.S(float_repr(x)) });
            }
        }
        Col.Bool(v) => {
            for x in v {
                out.push(Val.B(x));
            }
        }
        _ => {
            for i in 0..col_len(c) {
                let t = cell_text(c, i);
                out.push(if t.len() == 0 { Val.Na } else { Val.S(t) });
            }
        }
    }
    out
}

fn col_len(c: ref Col) -> i64 {
    match c {
        Col.Int(v) => v.len(),
        Col.Float(v) => v.len(),
        Col.Bool(v) => v.len(),
        Col.Obj(v) => v.len(),
        Col.Cat(v) => v.len(),
        Col.Str(v) => v.len(),
        Col.NInt(v) => v.len(),
        Col.NFloat(v) => v.len(),
        Col.NBool(v) => v.len(),
        Col.NStr(v) => v.len(),
    }
}

// float(x) and int(x) on an object array's element, as astype calls them.
fn obj_float(v: ref Val) -> Option[f64] {
    match v {
        Val.Na => Some(nan()),
        Val.S(s) => py_float(s),
        Val.B(b) => Some(if b { 1.0 } else { 0.0 }),
    }
}

fn obj_int(v: ref Val) -> Option[i64] {
    match v {
        Val.Na => None,
        Val.S(s) => py_int(s),
        Val.B(b) => Some(if b { 1 } else { 0 }),
    }
}

// _cast_types for the dtypes the jobs name; `column` is the name an
// error carries.
fn cast_col(c: own Col, kind: Str, column: Str) -> Result[Col, PyErr] {
    let fail = py_err("ValueError", f"Unable to convert column {column} to type {kind}");
    if kind == "category" {
        return Ok(Col.Cat(as_vals(c)));
    }
    if kind == "str" or kind == "string" {
        let mut out: Vec[Option[String]] = Vec.new();
        for v in as_vals(c) {
            out.push(match v {
                Val.Na => None,
                _ => Some(val_text(v)),
            });
        }
        return Ok(if kind == "str" { Col.Str(out) } else { Col.NStr(out) });
    }
    if kind == "Int64" or kind == "Float64" {
        let mut ints: Vec[Option[i64]] = Vec.new();
        let mut floats: Vec[Option[f64]] = Vec.new();
        for v in as_vals(c) {
            match v {
                Val.Na => {
                    ints.push(None);
                    floats.push(None);
                }
                _ => {
                    let t = val_text(v);
                    match floatify(t) {
                        Some((x, maybe)) => {
                            floats.push(Some(x));
                            if kind == "Int64" {
                                if not maybe {
                                    return Err(py_err("TypeError", "cannot safely cast non-equivalent float64 to int64"));
                                }
                                ints.push(py_int(t));
                            }
                        }
                        None => return Err(py_err("ValueError", f"Unable to parse string \"{t}\"")),
                    }
                }
            }
        }
        return Ok(if kind == "Int64" { Col.NInt(ints) } else { Col.NFloat(floats) });
    }
    if kind == "object" {
        return Ok(Col.Obj(as_vals(c)));
    }
    if kind == "float64" {
        let mut out: Vec[f64] = Vec.new();
        match c {
            Col.Int(v) => {
                for x in v {
                    out.push(x as f64);
                }
            }
            Col.Bool(v) => {
                for x in v {
                    out.push(if x { 1.0 } else { 0.0 });
                }
            }
            Col.Float(v) => return Ok(Col.Float(v)),
            _ => {
                for v in as_vals(c) {
                    match obj_float(v) {
                        Some(x) => out.push(x),
                        None => return Err(fail),
                    }
                }
            }
        }
        return Ok(Col.Float(out));
    }
    if kind == "int64" {
        let mut out: Vec[i64] = Vec.new();
        match c {
            Col.Float(v) => {
                for x in v {
                    if is_nan(x) or x == inf() or x == -inf() {
                        return Err(fail);
                    }
                    out.push(x as i64);
                }
            }
            Col.Bool(v) => {
                for x in v {
                    out.push(if x { 1 } else { 0 });
                }
            }
            Col.Int(v) => return Ok(Col.Int(v)),
            _ => {
                for v in as_vals(c) {
                    match obj_int(v) {
                        Some(x) => out.push(x),
                        None => return Err(fail),
                    }
                }
            }
        }
        return Ok(Col.Int(out));
    }
    if kind == "bool" {
        let mut out: Vec[bool] = Vec.new();
        match c {
            Col.Int(v) => {
                for x in v {
                    out.push(x != 0);
                }
            }
            Col.Float(v) => {
                for x in v {
                    out.push(x != 0.0);
                }
            }
            Col.Bool(v) => return Ok(Col.Bool(v)),
            _ => {
                // numpy's object-to-bool is each value's truth: a string
                // is True unless empty, NaN is True.
                for v in as_vals(c) {
                    out.push(match v {
                        Val.Na => true,
                        Val.S(s) => s.len() > 0,
                        Val.B(b) => b,
                    });
                }
            }
        }
        return Ok(Col.Bool(out));
    }
    Err(dtype_error(kind))
}

// Whether a column already has the dtype a cast asks for.
fn has_dtype(c: ref Col, kind: Str) -> bool {
    match c {
        Col.Int(_) => kind == "int64",
        Col.Float(_) => kind == "float64",
        Col.Bool(_) => kind == "bool",
        Col.Obj(_) => kind == "object",
        _ => false,
    }
}

// One data column through _convert_to_ndarrays: inference, then the
// dtype asked for.
fn convert_col(vals: own Vec[Val], na: ref NaSet, cast: ref Option[String], backend: bool, column: Str, bv: ref BoolVals) -> Result[Col, PyErr] {
    let (is_ea, try_num_bool) = match cast {
        Some(k) => {
            if not known_dtype(k) {
                return Err(dtype_error(k));
            }
            (is_ea_dtype(k), not (is_ea_dtype(k) or is_string_dtype(k)))
        }
        None => (false, true),
    };
    let (cvals, na_count) = infer_types(vals, na, cast.is_none() and backend, try_num_bool, bv);
    match cast {
        Some(k) => {
            if not has_dtype(cvals, k) or is_ea {
                if not is_ea and na_count > 0 and k == "bool" {
                    return Err(py_err("ValueError", f"Bool column has NA values in column {column}"));
                }
                return cast_col(cvals, k, column);
            }
            Ok(cvals)
        }
        None => Ok(cvals),
    }
}
// ------------------------------------------------------------ codecs

// codecs.lookup: encodings.normalize_encoding, then the aliases of the
// codecs this port carries. 0 is unknown; 1 utf-8, 2 utf-8-sig,
// 3 latin-1, 4 cp1252, 5 ascii.
fn normalize_encoding(name: Str) -> String {
    let mut out: Vec[u8] = Vec.new();
    let mut punct = false;
    for ch in lower_ascii(name).chars() {
        if ch.is_alphanumeric() or ch == '.' {
            if punct and out.len() > 0 {
                out.push(b'_');
            }
            if (ch as u32) < 128 {
                out.push(ch as u32 as u8);
            }
            punct = false;
        } else {
            punct = true;
        }
    }
    from_bytes(out)
}

fn codec_id(name: Str) -> i64 {
    let n = normalize_encoding(name);
    let groups = [
        (1, "utf_8 utf8 u8 utf utf8_ucs2 utf8_ucs4 cp65001"),
        (2, "utf_8_sig"),
        (3, "latin_1 latin1 latin l1 iso_8859_1 iso8859_1 8859 cp819 iso_ir_100 csisolatin1 ibm819 iso8859 iso_8859_1_1987"),
        (4, "cp1252 windows_1252 1252"),
        (5, "ascii us_ascii 646 ansi_x3.4_1968 ansi_x3_4_1968 ansi_x3.4_1986 cp367 csascii ibm367 iso646_us iso_646.irv_1991 iso_ir_6 us"),
    ];
    for (id, names) in groups {
        for a in split_spaces(names) {
            if a == n or a == replace_all(n, ".", "_") {
                return id;
            }
        }
    }
    0
}

// The code points windows-1252 gives 0x80..0x9F; 0 where it has none.
fn cp1252_high(b: i64) -> i64 {
    let t = [0x20AC, 0, 0x201A, 0x0192, 0x201E, 0x2026, 0x2020, 0x2021, 0x02C6, 0x2030, 0x0160, 0x2039, 0x0152, 0, 0x017D, 0, 0, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014, 0x02DC, 0x2122, 0x0161, 0x203A, 0x0153, 0, 0x017E, 0x0178];
    t[b - 0x80]
}

// The error handlers codecs.lookup_error knows; the decoder here
// carries strict, ignore, replace and backslashreplace.
fn handler_known(name: Str) -> bool {
    for h in ["strict", "ignore", "replace", "backslashreplace", "surrogateescape", "surrogatepass", "xmlcharrefreplace", "namereplace"] {
        if h == name {
            return true;
        }
    }
    false
}

fn decode_error(codec: Str, b: ref Vec[u8], start: i64, end: i64, reason: Str) -> PyErr {
    let what = if end - start == 1 {
        f"byte 0x{hex_n(b[start] as i64, 2)} in position {start}"
    } else {
        f"bytes in position {start}-{end - 1}"
    };
    py_err("UnicodeDecodeError", f"'{codec}' codec can't decode {what}: {reason}")
}

// What the error handler puts in place of b[start..end], or the error.
fn on_decode_error(errors: Str, codec: Str, b: ref Vec[u8], start: i64, end: i64, reason: Str, out: mut ref Vec[i64]) -> Result[(), PyErr] {
    if errors == "ignore" {
        return Ok(());
    }
    if errors == "replace" {
        out.push(0xFFFD);
        return Ok(());
    }
    if errors == "backslashreplace" {
        for k in start..end {
            push_ascii(mut out, f"\\x{hex_n(b[k] as i64, 2)}");
        }
        return Ok(());
    }
    if errors == "strict" {
        return Err(decode_error(codec, b, start, end, reason));
    }
    Err(py_err("TypeError", "don't know how to handle UnicodeDecodeError in error callback"))
}

// Python's UTF-8 decoder, with its error ranges and reasons.
fn decode_utf8(b: ref Vec[u8], from: i64, errors: Str) -> Result[Vec[i64], PyErr] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = from;
    let n = b.len();
    while i < n {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
            continue;
        }
        let (len, lo, hi) = if c >= 0xC2 and c <= 0xDF {
            (2, 0x80, 0xBF)
        } else if c == 0xE0 {
            (3, 0xA0, 0xBF)
        } else if c == 0xED {
            (3, 0x80, 0x9F)
        } else if c >= 0xE1 and c <= 0xEF {
            (3, 0x80, 0xBF)
        } else if c == 0xF0 {
            (4, 0x90, 0xBF)
        } else if c == 0xF4 {
            (4, 0x80, 0x8F)
        } else if c >= 0xF1 and c <= 0xF3 {
            (4, 0x80, 0xBF)
        } else {
            on_decode_error(errors, "utf-8", b, i, i + 1, "invalid start byte", mut out)?;
            i += 1;
            continue;
        };
        let mut cp = if len == 2 { c & 0x1F } else if len == 3 { c & 0x0F } else { c & 0x07 };
        let mut k: i64 = 1;
        let mut bad = false;
        while k < len {
            if i + k >= n {
                on_decode_error(errors, "utf-8", b, i, n, "unexpected end of data", mut out)?;
                return Ok(out);
            }
            let d = b[i + k] as i64;
            let (l, h) = if k == 1 { (lo, hi) } else { (0x80, 0xBF) };
            if d < l or d > h {
                on_decode_error(errors, "utf-8", b, i, i + k, "invalid continuation byte", mut out)?;
                bad = true;
                break;
            }
            cp = (cp << 6) | (d & 0x3F);
            k += 1;
        }
        if bad {
            i += k;
            continue;
        }
        out.push(cp);
        i += len;
    }
    Ok(out)
}

// The file's bytes as text, as open(..., encoding=..., errors=...)
// reads them.
fn decode(b: ref Vec[u8], codec: i64, errors: Str) -> Result[Vec[i64], PyErr] {
    if codec == 1 {
        return decode_utf8(b, 0, errors);
    }
    if codec == 2 {
        let from = if b.len() >= 3 and b[0] == 0xEF and b[1] == 0xBB and b[2] == 0xBF { 3 } else { 0 };
        return decode_utf8(b, from, errors);
    }
    let mut out: Vec[i64] = Vec.new();
    for i in 0..b.len() {
        let c = b[i] as i64;
        if codec == 5 and c >= 0x80 {
            on_decode_error(errors, "ascii", b, i, i + 1, "ordinal not in range(128)", mut out)?;
        } else if codec == 4 and c >= 0x80 and c < 0xA0 {
            let h = cp1252_high(c);
            if h == 0 {
                on_decode_error(errors, "charmap", b, i, i + 1, "character maps to <undefined>", mut out)?;
            } else {
                out.push(h);
            }
        } else {
            out.push(c);
        }
    }
    Ok(out)
}
// The lines of the text as a file opened with newline="" yields them:
// split after \n, \r\n or \r, with the line end kept.
fn text_lines(t: ref Vec[i64]) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    let mut i: i64 = 0;
    while i < t.len() {
        let c = t[i];
        cur.push(c);
        if c == 10 {
            out.push(cur);
            cur = Vec.new();
        } else if c == 13 {
            if i + 1 < t.len() and t[i + 1] == 10 {
                cur.push(10);
                i += 1;
            }
            out.push(cur);
            cur = Vec.new();
        }
        i += 1;
    }
    if cur.len() > 0 {
        out.push(cur);
    }
    out
}

// ============================================================ regular expressions (from mini_re)

// ------------------------------------------------------------ errors

struct ReErr {
    kind: String,
    msg: String,
    pos: i64,
}

fn re_error(msg: own String, pos: i64) -> ReErr {
    ReErr { kind: "error".to_string(), msg: msg, pos: pos }
}

fn other_error(kind: Str, msg: own String) -> ReErr {
    ReErr { kind: kind.to_string(), msg: msg, pos: -1 }
}

fn err_text(e: ref ReErr) -> String {
    if e.kind == "error" {
        if e.pos >= 0 {
            return f"error: {e.msg} at position {e.pos}";
        }
        return f"error: {e.msg}";
    }
    f"{e.kind}: {e.msg}"
}

// ----------------------------------------------------- character kinds

fn is_decimal(c: i64) -> bool {
    if c < 0x80 {
        return c >= 48 and c <= 57;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return true;
        }
    }
    false
}

fn as_char(c: i64) -> Option[char] {
    if c < 0 or (c >= 0xD800 and c <= 0xDFFF) or c > 0x10FFFF {
        return None;
    }
    char.try_from(c as u32).ok()
}

fn is_word(c: i64, ascii: bool) -> bool {
    if c < 0x80 {
        return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
    }
    if ascii {
        return false;
    }
    match as_char(c) {
        Some(ch) => ch.is_alphanumeric(),
        None => false,
    }
}

fn lower(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 65 and c <= 90 { c + 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_lowercase() as u32 as i64,
        None => c,
    }
}

fn upper(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 97 and c <= 122 { c - 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_uppercase() as u32 as i64,
        None => c,
    }
}

// ------------------------------------------------------- parsed form

// The categories of \d \D \s \S \w \W.
fn cat_digit() -> i64 { 0 }
fn cat_not_digit() -> i64 { 1 }
fn cat_space() -> i64 { 2 }
fn cat_not_space() -> i64 { 3 }
fn cat_word() -> i64 { 4 }
fn cat_not_word() -> i64 { 5 }

// The positions ^ $ \A \Z \b \B and the forms the compiler turns them
// into under MULTILINE.
fn at_beginning() -> i64 { 0 }
fn at_beginning_line() -> i64 { 1 }
fn at_beginning_string() -> i64 { 2 }
fn at_end() -> i64 { 3 }
fn at_end_line() -> i64 { 4 }
fn at_end_string() -> i64 { 5 }
fn at_boundary() -> i64 { 6 }
fn at_non_boundary() -> i64 { 7 }

#[derive(Clone)]
enum Item {
    Lit(i64),
    Range(i64, i64),
    Cat(i64),
}

enum Node {
    Lit(i64),
    NotLit(i64),
    Any,
    In(Vec[Item], bool),
    At(i64),
    Branch(Vec[Vec[Node]]),
    // group (0: none), flags turned on, flags turned off, contents
    Group(i64, i64, i64, Vec[Node]),
    // 0 greedy, 1 lazy, 2 possessive; min; max; the item repeated
    Repeat(i64, i64, i64, Vec[Node]),
    Atomic(Vec[Node]),
    // direction (1 ahead, -1 behind), negative, contents
    Assert(i64, bool, Vec[Node]),
    GroupRef(i64),
    // group, yes branch, no branch
    Exists(i64, Vec[Node], Vec[Node]),
    Failure,
}

fn is_repeat(n: ref Node) -> bool {
    match n {
        Node.Repeat(_, _, _, _) => true,
        _ => false,
    }
}

fn is_at(n: ref Node) -> bool {
    match n {
        Node.At(_) => true,
        _ => false,
    }
}

fn flag_i() -> i64 { 2 }
fn flag_l() -> i64 { 4 }
fn flag_m() -> i64 { 8 }
fn flag_s() -> i64 { 16 }
fn flag_u() -> i64 { 32 }
fn flag_x() -> i64 { 64 }
fn flag_a() -> i64 { 256 }
fn type_flags() -> i64 { 4 | 32 | 256 }
fn maxrepeat() -> i64 { 4294967295 }
fn maxgroups() -> i64 { 1073741823 }
fn maxwidth() -> i64 { 1 << 62 }

fn flag_value(c: i64) -> i64 {
    match c {
        105 => 2,
        76 => 4,
        109 => 8,
        115 => 16,
        120 => 64,
        97 => 256,
        117 => 32,
        _ => 0,
    }
}

// ------------------------------------------------------------ tokens

// One token: nothing at the end of the pattern (n 0), a character (n 1),
// or a backslash and the character after it (n 2).
#[derive(Copy, Clone)]
struct T {
    n: i64,
    a: i64,
    b: i64,
}

fn tok_none() -> T {
    T { n: 0, a: 0, b: 0 }
}

fn tok_is(t: T, c: i64) -> bool {
    t.n == 1 and t.a == c
}

fn tok_text(t: T) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    if t.n >= 1 {
        v.push(t.a);
    }
    if t.n == 2 {
        v.push(t.b);
    }
    v
}

fn is_ascii_letter(c: i64) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

fn is_hex(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

fn is_oct(c: i64) -> bool {
    c >= 48 and c <= 55
}

fn is_dec(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn digits_value(s: ref Vec[i64], start: i64, base: i64) -> i64 {
    let mut v = 0;
    let mut i = start;
    while i < s.len() {
        let c = s[i];
        let d = if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 };
        v = v * base + d;
        i += 1;
    }
    v
}

// str.isidentifier, near enough: a letter or underscore, then letters,
// digits and underscores.
fn is_identifier(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    let mut i = 0;
    while i < name.len() {
        let c = name[i];
        let ok = if c == 95 {
            true
        } else if i == 0 {
            match as_char(c) {
                Some(ch) => ch.is_alphabetic(),
                None => false,
            }
        } else {
            is_word(c, false)
        };
        if not ok {
            return false;
        }
        i += 1;
    }
    true
}

fn is_ascii_decimal(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    for c in name {
        if not is_dec(c) {
            return false;
        }
    }
    true
}

struct Tokenizer {
    s: Vec[i64],
    index: i64,
    next: T,
}

impl Tokenizer {
    fn advance(mut ref self) -> Result[(), ReErr] {
        let index = self.index;
        if index >= self.s.len() {
            self.next = tok_none();
            return Ok(());
        }
        let c = self.s[index];
        if c == 92 {
            if index + 1 >= self.s.len() {
                return Err(re_error("bad escape (end of pattern)".to_string(), self.s.len() - 1));
            }
            self.next = T { n: 2, a: 92, b: self.s[index + 1] };
            self.index = index + 2;
        } else {
            self.next = T { n: 1, a: c, b: 0 };
            self.index = index + 1;
        }
        Ok(())
    }

    fn get(mut ref self) -> Result[T, ReErr] {
        let t = self.next;
        self.advance()?;
        Ok(t)
    }

    fn take(mut ref self, c: i64) -> Result[bool, ReErr] {
        if tok_is(self.next, c) {
            self.advance()?;
            return Ok(true);
        }
        Ok(false)
    }

    fn tell(ref self) -> i64 {
        self.index - self.next.n
    }

    fn seek(mut ref self, index: i64) -> Result[(), ReErr] {
        self.index = index;
        self.advance()
    }

    fn error(ref self, msg: own String, offset: i64) -> ReErr {
        re_error(msg, self.tell() - offset)
    }

    // getwhile: up to n characters of a kind (0 octal, 1 decimal, 2 hex).
    fn getwhile(mut ref self, n: i64, kind: i64, out: mut ref Vec[i64]) -> Result[(), ReErr] {
        let mut k = 0;
        while k < n {
            let t = self.next;
            if t.n != 1 {
                break;
            }
            let ok = if kind == 0 { is_oct(t.a) } else if kind == 1 { is_dec(t.a) } else { is_hex(t.a) };
            if not ok {
                break;
            }
            out.push(t.a);
            self.advance()?;
            k += 1;
        }
        Ok(())
    }

    fn getuntil(mut ref self, terminator: i64, name: Str) -> Result[Vec[i64], ReErr] {
        let mut result: Vec[i64] = Vec.new();
        loop {
            let c = self.next;
            self.advance()?;
            if c.n == 0 {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 0));
                }
                let term = to_string(vec_of(terminator));
                return Err(self.error(f"missing {term}, unterminated name", result.len()));
            }
            if tok_is(c, terminator) {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 1));
                }
                break;
            }
            push_all(mut result, tok_text(c));
        }
        Ok(result)
    }

    fn checkgroupname(ref self, name: ref Vec[i64], offset: i64) -> Result[(), ReErr] {
        if not is_identifier(name) {
            return Err(self.error(f"bad character in group name {repr_of(name)}", name.len() + offset));
        }
        Ok(())
    }
}

fn vec_of(c: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(c);
    v
}

fn new_tokenizer(s: ref Vec[i64]) -> Result[Tokenizer, ReErr] {
    let mut t = Tokenizer { s: s.clone(), index: 0, next: tok_none() };
    t.advance()?;
    Ok(t)
}

// ------------------------------------------------------------ parser

#[derive(Clone)]
struct Width {
    lo: i64,
    hi: i64,
}

struct ParseState {
    flags: i64,
    names: Vec[(Vec[i64], i64)],
    // per group: whether it is closed, and its width
    closed: Vec[bool],
    widths: Vec[Width],
    lookbehind_groups: i64,
    // conditional references by number, in order: (group, position)
    refpos: Vec[(i64, i64)],
}

impl ParseState {
    fn groups(ref self) -> i64 {
        self.closed.len()
    }

    fn group_of(ref self, name: ref Vec[i64]) -> i64 {
        for (n, g) in self.names.iter() {
            if same(n, name) {
                return g;
            }
        }
        -1
    }

    fn checkgroup(ref self, gid: i64) -> bool {
        gid < self.groups() and self.closed[gid]
    }

    fn checklookbehindgroup(ref self, gid: i64, src: ref Tokenizer) -> Result[(), ReErr] {
        if self.lookbehind_groups >= 0 {
            if not self.checkgroup(gid) {
                return Err(src.error("cannot refer to an open group".to_string(), 0));
            }
            if gid >= self.lookbehind_groups {
                return Err(src.error("cannot refer to group defined in the same lookbehind subpattern".to_string(), 0));
            }
        }
        Ok(())
    }
}

fn add_width(a: i64, b: i64) -> i64 {
    if a >= maxwidth() - b { maxwidth() } else { a + b }
}

fn mul_width(a: i64, n: i64) -> i64 {
    if a == 0 or n == 0 {
        0
    } else if a >= maxwidth() / n {
        maxwidth()
    } else {
        a * n
    }
}

// SubPattern.getwidth.
fn width_of(widths: ref Vec[Width], p: ref Vec[Node]) -> Width {
    let mut lo = 0;
    let mut hi = 0;
    for n in p.iter() {
        match n {
            Node.Branch(items) => {
                let mut i = maxwidth();
                let mut j = 0;
                for item in items.iter() {
                    let w = width_of(widths, item);
                    if w.lo < i {
                        i = w.lo;
                    }
                    if w.hi > j {
                        j = w.hi;
                    }
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Atomic(body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Group(_, _, _, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Repeat(_, min, max, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, mul_width(w.lo, min));
                if max == maxrepeat() and w.hi > 0 {
                    hi = maxwidth();
                } else {
                    hi = add_width(hi, mul_width(w.hi, max));
                }
            }
            Node.GroupRef(g) => {
                let w = ref widths[g];
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Exists(_, yes, no) => {
                let wy = width_of(widths, yes);
                let mut i = wy.lo;
                let mut j = wy.hi;
                if no.len() > 0 {
                    let wn = width_of(widths, no);
                    if wn.lo < i {
                        i = wn.lo;
                    }
                    if wn.hi > j {
                        j = wn.hi;
                    }
                } else {
                    i = 0;
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Lit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.NotLit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.Any => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.In(_, _) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            _ => {}
        }
    }
    Width { lo: lo, hi: hi }
}

fn category_of(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        100 => 0,
        68 => 1,
        115 => 2,
        83 => 3,
        119 => 4,
        87 => 5,
        _ => -1,
    }
}

fn escape_value(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        97 => 7,
        98 => 8,
        102 => 12,
        110 => 10,
        114 => 13,
        116 => 9,
        118 => 11,
        92 => 92,
        _ => -1,
    }
}

// \x, \u and \U: the escape text so far, and the code point.
fn hex_escape(src: mut ref Tokenizer, t: T, esc: mut ref Vec[i64]) -> Result[i64, ReErr] {
    let n = if t.b == 120 { 2 } else if t.b == 117 { 4 } else { 8 };
    src.getwhile(n, 2, mut esc)?;
    if esc.len() != n + 2 {
        return Err(src.error(f"incomplete escape {to_string(esc)}", esc.len()));
    }
    let c = digits_value(esc, 2, 16);
    if c > 0x10FFFF {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(c)
}

// _class_escape: an escape inside [...], a literal or a category.
fn class_escape(src: mut ref Tokenizer, t: T) -> Result[Item, ReErr] {
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Item.Lit(e));
    }
    let cat = category_of(t);
    if cat >= 0 {
        return Ok(Item.Cat(cat));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Item.Lit(v));
    }
    if is_oct(c) {
        src.getwhile(2, 0, mut esc)?;
        let v = digits_value(esc, 1, 8);
        if v > 0o377 {
            return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
        }
        return Ok(Item.Lit(v));
    }
    if is_dec(c) or is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Item.Lit(c))
}

// _escape: an escape outside a set.
fn escape(src: mut ref Tokenizer, t: T, st: ref ParseState) -> Result[Node, ReErr] {
    let cat = category_of(t);
    if cat >= 0 {
        let mut items: Vec[Item] = Vec.new();
        items.push(Item.Cat(cat));
        return Ok(Node.In(items, false));
    }
    match t.b {
        65 => return Ok(Node.At(at_beginning_string())),
        98 => return Ok(Node.At(at_boundary())),
        66 => return Ok(Node.At(at_non_boundary())),
        90 => return Ok(Node.At(at_end_string())),
        _ => {}
    }
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Node.Lit(e));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Node.Lit(v));
    }
    if c == 48 {
        src.getwhile(2, 0, mut esc)?;
        return Ok(Node.Lit(digits_value(esc, 1, 8)));
    }
    if is_dec(c) {
        // an octal escape or a group reference
        let nt = src.next;
        if nt.n == 1 and is_dec(nt.a) {
            esc.push(nt.a);
            src.advance()?;
            let nt2 = src.next;
            if is_oct(esc[1]) and is_oct(esc[2]) and nt2.n == 1 and is_oct(nt2.a) {
                esc.push(nt2.a);
                src.advance()?;
                let v = digits_value(esc, 1, 8);
                if v > 0o377 {
                    return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
                }
                return Ok(Node.Lit(v));
            }
        }
        let group = digits_value(esc, 1, 10);
        if group < st.groups() {
            if not st.checkgroup(group) {
                return Err(src.error("cannot refer to an open group".to_string(), esc.len()));
            }
            st.checklookbehindgroup(group, src)?;
            return Ok(Node.GroupRef(group));
        }
        return Err(src.error(f"invalid group reference {group}", esc.len() - 1));
    }
    if is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Node.Lit(c))
}

fn parse_sub(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64) -> Result[Vec[Node], ReErr] {
    let mut items: Vec[Vec[Node]] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let first = nested == 0 and items.len() == 0;
        let item = parse_seq(mut src, mut st, verbose, nested + 1, first)?;
        items.push(item);
        if not src.take(124)? {
            break;
        }
        if nested == 0 {
            verbose = (st.flags & flag_x()) != 0;
        }
    }
    if items.len() == 1 {
        return Ok(items.pop().unwrap());
    }
    let mut out: Vec[Node] = Vec.new();
    out.push(Node.Branch(items));
    Ok(out)
}

// _parse_flags: None (as Err-free Ok(None)) for global flags, else the
// flags turned on and off.
fn parse_flags(src: mut ref Tokenizer, st: mut ref ParseState, first_char: T) -> Result[Option[(i64, i64)], ReErr] {
    let mut ch = first_char;
    let mut add = 0;
    let mut del = 0;
    if not tok_is(ch, 45) {
        loop {
            let flag = flag_value(ch.a);
            if ch.a == 76 {
                return Err(src.error("bad inline flags: cannot use 'L' flag with a str pattern".to_string(), 0));
            }
            add = add | flag;
            if (flag & type_flags()) != 0 and (add & type_flags()) != flag {
                return Err(src.error("bad inline flags: flags 'a', 'u' and 'L' are incompatible".to_string(), 0));
            }
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing -, : or )".to_string(), 0));
            }
            if tok_is(ch, 41) or tok_is(ch, 45) or tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing -, : or )" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if tok_is(ch, 41) {
        st.flags = st.flags | add;
        return Ok(None);
    }
    if tok_is(ch, 45) {
        ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("missing flag".to_string(), 0));
        }
        if ch.n != 1 or flag_value(ch.a) == 0 {
            let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing flag" };
            return Err(src.error(msg.to_string(), ch.n));
        }
        loop {
            let flag = flag_value(ch.a);
            if (flag & type_flags()) != 0 {
                return Err(src.error("bad inline flags: cannot turn off flags 'a', 'u' and 'L'".to_string(), 0));
            }
            del = del | flag;
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing :".to_string(), 0));
            }
            if tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing :" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if (add & del) != 0 {
        return Err(src.error("bad inline flags: flag turned on and off".to_string(), 1));
    }
    Ok(Some((add, del)))
}

fn is_alpha(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

fn parse_set(src: mut ref Tokenizer, out: mut ref Vec[Node]) -> Result[(), ReErr] {
    let here = src.tell() - 1;
    let mut set: Vec[Item] = Vec.new();
    let negate = src.take(94)?;
    loop {
        let this = src.get()?;
        if this.n == 0 {
            return Err(src.error("unterminated character set".to_string(), src.tell() - here));
        }
        if tok_is(this, 93) and set.len() > 0 {
            break;
        }
        let code1 = if this.n == 2 { class_escape(mut src, this)? } else { Item.Lit(this.a) };
        if src.take(45)? {
            let that = src.get()?;
            if that.n == 0 {
                return Err(src.error("unterminated character set".to_string(), src.tell() - here));
            }
            if tok_is(that, 93) {
                set.push(code1);
                set.push(Item.Lit(45));
                break;
            }
            let code2 = if that.n == 2 { class_escape(mut src, that)? } else { Item.Lit(that.a) };
            let text = f"{to_string(tok_text(this))}-{to_string(tok_text(that))}";
            let offset = this.n + 1 + that.n;
            let lo = match code1 {
                Item.Lit(c) => c,
                _ => -1,
            };
            let hi = match code2 {
                Item.Lit(c) => c,
                _ => -1,
            };
            if lo < 0 or hi < 0 or hi < lo {
                return Err(src.error(f"bad character range {text}", offset));
            }
            set.push(Item.Range(lo, hi));
        } else {
            set.push(code1);
        }
    }
    if set.len() == 1 {
        let only = ref set[0];
        if let Item.Lit(c) = only {
            if negate {
                out.push(Node.NotLit(c));
            } else {
                out.push(Node.Lit(c));
            }
            return Ok(());
        }
    }
    out.push(Node.In(set, negate));
    Ok(())
}

// The quantifier just read (its first character is `this`), applied to
// the last item. Returns false when `{` turned out to be a literal.
fn parse_repeat(src: mut ref Tokenizer, this: T, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let here = src.tell();
    let mut min = 0;
    let mut max = maxrepeat();
    if tok_is(this, 63) {
        max = 1;
    } else if tok_is(this, 43) {
        min = 1;
    } else if tok_is(this, 123) {
        if tok_is(src.next, 125) {
            out.push(Node.Lit(123));
            return Ok(false);
        }
        let mut lo: Vec[i64] = Vec.new();
        let mut hi: Vec[i64] = Vec.new();
        while src.next.n == 1 and is_dec(src.next.a) {
            lo.push(src.get()?.a);
        }
        if src.take(44)? {
            while src.next.n == 1 and is_dec(src.next.a) {
                hi.push(src.get()?.a);
            }
        } else {
            hi = lo.clone();
        }
        if not src.take(125)? {
            out.push(Node.Lit(123));
            src.seek(here)?;
            return Ok(false);
        }
        if lo.len() > 0 {
            if lo.len() > 10 or digits_value(lo, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            min = digits_value(lo, 0, 10);
        }
        if hi.len() > 0 {
            if hi.len() > 10 or digits_value(hi, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            max = digits_value(hi, 0, 10);
            if max < min {
                return Err(src.error("min repeat greater than max repeat".to_string(), src.tell() - here));
            }
        }
    }
    if out.len() == 0 or is_at(out[out.len() - 1]) {
        return Err(src.error("nothing to repeat".to_string(), src.tell() - here + 1));
    }
    if is_repeat(out[out.len() - 1]) {
        return Err(src.error("multiple repeat".to_string(), src.tell() - here + 1));
    }
    let last = out.pop().unwrap();
    let mut body: Vec[Node] = Vec.new();
    match last {
        Node.Group(0, 0, 0, p) => body = p,
        other => body.push(other),
    }
    let kind = if src.take(63)? { 1 } else if src.take(43)? { 2 } else { 0 };
    out.push(Node.Repeat(kind, min, max, body));
    Ok(true)
}

fn parse_seq(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64, first: bool) -> Result[Vec[Node], ReErr] {
    let mut out: Vec[Node] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let this = src.next;
        if this.n == 0 or tok_is(this, 124) or tok_is(this, 41) {
            break;
        }
        src.advance()?;
        if verbose {
            if this.n == 1 and (this.a == 32 or (this.a >= 9 and this.a <= 13)) {
                continue;
            }
            if tok_is(this, 35) {
                loop {
                    let t = src.get()?;
                    if t.n == 0 or tok_is(t, 10) {
                        break;
                    }
                }
                continue;
            }
        }
        if this.n == 2 {
            let node = escape(mut src, this, st)?;
            out.push(node);
            continue;
        }
        let c = this.a;
        if c == 91 {
            parse_set(mut src, mut out)?;
        } else if c == 42 or c == 43 or c == 63 or c == 123 {
            parse_repeat(mut src, this, mut out)?;
        } else if c == 46 {
            out.push(Node.Any);
        } else if c == 94 {
            out.push(Node.At(at_beginning()));
        } else if c == 36 {
            out.push(Node.At(at_end()));
        } else if c == 40 {
            if parse_group(mut src, mut st, mut verbose, nested, first, mut out)? {
                continue;
            }
        } else {
            out.push(Node.Lit(c));
        }
    }
    Ok(out)
}

// `(` and what follows. Returns true for a construct that adds nothing
// (a comment, global flags).
fn parse_group(src: mut ref Tokenizer, st: mut ref ParseState, verbose: mut ref bool, nested: i64, first: bool, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let start = src.tell() - 1;
    let mut capture = true;
    let mut atomic = false;
    let mut name: Vec[i64] = Vec.new();
    let mut named = false;
    let mut add = 0;
    let mut del = 0;
    if src.take(63)? {
        let ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("unexpected end of pattern".to_string(), 0));
        }
        if tok_is(ch, 80) {
            if src.take(60)? {
                name = src.getuntil(62, "group name")?;
                src.checkgroupname(name, 1)?;
                named = true;
            } else if src.take(61)? {
                let ref_name = src.getuntil(41, "group name")?;
                src.checkgroupname(ref_name, 1)?;
                let gid = st.group_of(ref_name);
                if gid < 0 {
                    return Err(src.error(f"unknown group name {repr_of(ref_name)}", ref_name.len() + 1));
                }
                if not st.checkgroup(gid) {
                    return Err(src.error("cannot refer to an open group".to_string(), ref_name.len() + 1));
                }
                st.checklookbehindgroup(gid, src)?;
                out.push(Node.GroupRef(gid));
                return Ok(true);
            } else {
                let c2 = src.get()?;
                if c2.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                return Err(src.error(f"unknown extension ?P{to_string(tok_text(c2))}", c2.n + 2));
            }
        } else if tok_is(ch, 58) {
            capture = false;
        } else if tok_is(ch, 35) {
            loop {
                if src.next.n == 0 {
                    return Err(src.error("missing ), unterminated comment".to_string(), src.tell() - start));
                }
                if tok_is(src.get()?, 41) {
                    break;
                }
            }
            return Ok(true);
        } else if tok_is(ch, 61) or tok_is(ch, 33) or tok_is(ch, 60) {
            let mut kind = ch;
            let mut dir = 1;
            let mut outer_lookbehind = 0;
            if tok_is(ch, 60) {
                kind = src.get()?;
                if kind.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                if not (tok_is(kind, 61) or tok_is(kind, 33)) {
                    return Err(src.error(f"unknown extension ?<{to_string(tok_text(kind))}", kind.n + 2));
                }
                dir = -1;
                outer_lookbehind = st.lookbehind_groups;
                if outer_lookbehind < 0 {
                    st.lookbehind_groups = st.groups();
                }
            }
            let p = parse_sub(mut src, mut st, *verbose, nested + 1)?;
            if dir < 0 and outer_lookbehind < 0 {
                st.lookbehind_groups = -1;
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            if tok_is(kind, 61) {
                out.push(Node.Assert(dir, false, p));
            } else if p.len() > 0 {
                out.push(Node.Assert(dir, true, p));
            } else {
                out.push(Node.Failure);
            }
            return Ok(true);
        } else if tok_is(ch, 40) {
            let condname = src.getuntil(41, "group name")?;
            let mut condgroup = 0;
            if not is_ascii_decimal(condname) {
                src.checkgroupname(condname, 1)?;
                condgroup = st.group_of(condname);
                if condgroup < 0 {
                    return Err(src.error(f"unknown group name {repr_of(condname)}", condname.len() + 1));
                }
            } else {
                if condname.len() > 10 {
                    return Err(src.error(f"invalid group reference {to_string(condname)}", condname.len() + 1));
                }
                condgroup = digits_value(condname, 0, 10);
                if condgroup == 0 {
                    return Err(src.error("bad group number".to_string(), condname.len() + 1));
                }
                if condgroup >= maxgroups() {
                    return Err(src.error(f"invalid group reference {condgroup}", condname.len() + 1));
                }
                let mut seen = false;
                for (g, _) in st.refpos.iter() {
                    if g == condgroup {
                        seen = true;
                    }
                }
                if not seen {
                    st.refpos.push((condgroup, src.tell() - condname.len() - 1));
                }
            }
            st.checklookbehindgroup(condgroup, src)?;
            let yes = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
            let mut no: Vec[Node] = Vec.new();
            if src.take(124)? {
                no = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
                if tok_is(src.next, 124) {
                    return Err(src.error("conditional backref with more than two branches".to_string(), 0));
                }
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            out.push(Node.Exists(condgroup, yes, no));
            return Ok(true);
        } else if tok_is(ch, 62) {
            capture = false;
            atomic = true;
        } else if (ch.n == 1 and flag_value(ch.a) != 0) or tok_is(ch, 45) {
            match parse_flags(mut src, mut st, ch)? {
                None => {
                    if not first or out.len() > 0 {
                        return Err(src.error("global flags not at the start of the expression".to_string(), src.tell() - start));
                    }
                    *verbose = (st.flags & flag_x()) != 0;
                    return Ok(true);
                }
                Some((a, d)) => {
                    add = a;
                    del = d;
                    capture = false;
                }
            }
        } else {
            return Err(src.error(f"unknown extension ?{to_string(tok_text(ch))}", ch.n + 1));
        }
    }
    let mut group = 0;
    if capture {
        group = st.groups();
        st.closed.push(false);
        st.widths.push(Width { lo: 0, hi: 0 });
        if named {
            let was = st.group_of(name);
            if was >= 0 {
                return Err(src.error(f"redefinition of group name {repr_of(name)} as group {group}; was group {was}", name.len() + 1));
            }
            st.names.push((name.clone(), group));
        }
    }
    let sub_verbose = (*verbose or (add & flag_x()) != 0) and (del & flag_x()) == 0;
    let p = parse_sub(mut src, mut st, sub_verbose, nested + 1)?;
    if not src.take(41)? {
        return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
    }
    if group > 0 {
        let w = width_of(st.widths, p);
        st.widths[group] = w;
        st.closed[group] = true;
    }
    if atomic {
        out.push(Node.Atomic(p));
    } else {
        out.push(Node.Group(group, add, del, p));
    }
    Ok(false)
}

struct Parsed {
    nodes: Vec[Node],
    flags: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
    widths: Vec[Width],
}

fn parse(pattern: ref Vec[i64], flags: i64) -> Result[Parsed, ReErr] {
    let mut src = new_tokenizer(pattern)?;
    let mut st = ParseState {
        flags: flags,
        names: Vec.new(),
        closed: Vec.new(),
        widths: Vec.new(),
        lookbehind_groups: -1,
        refpos: Vec.new(),
    };
    // group 0 is the whole match
    st.closed.push(true);
    st.widths.push(Width { lo: 0, hi: 0 });
    let nodes = parse_sub(mut src, mut st, (flags & flag_x()) != 0, 0)?;
    if (st.flags & flag_a()) != 0 and (st.flags & flag_u()) != 0 {
        return Err(other_error("ValueError", "ASCII and UNICODE flags are incompatible".to_string()));
    }
    if src.next.n != 0 {
        return Err(src.error("unbalanced parenthesis".to_string(), 0));
    }
    for (g, pos) in st.refpos.iter() {
        if g >= st.groups() {
            return Err(re_error(f"invalid group reference {g}", pos));
        }
    }
    let groups = st.groups() - 1;
    Ok(Parsed { nodes: nodes, flags: st.flags, groups: groups, names: st.names, widths: st.widths })
}

// ---------------------------------------------------------- compiler

enum Op {
    // character (lowered when case-insensitive), case-insensitive, ASCII
    Lit(i64, bool, bool),
    NotLit(i64, bool, bool),
    Any,
    AnyAll,
    // set, case-insensitive, ASCII-only categories
    In(i64, bool, bool),
    // anchor kind, ASCII-only word boundary
    At(i64, bool),
    Mark(i64),
    Split(i64, i64),
    Jmp(i64),
    // repeat register, the Until it starts at
    RepInit(i64, i64),
    // register, min, max, greedy, body, exit
    Until(i64, i64, i64, bool, i64, i64),
    Ref(i64, bool, bool),
    // lookbehind width (-1 for lookahead), negative, sub-program, next
    Look(i64, bool, i64, i64),
    Atomic(i64, i64),
    Exists(i64, i64),
    Fail,
    Succeed,
    Match,
}

struct Program {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
}

struct CharSet {
    items: Vec[Item],
    negate: bool,
}

fn combine(flags: i64, add: i64, del: i64) -> i64 {
    let mut f = flags;
    if (add & type_flags()) != 0 {
        f = f & (0x7FFFFFFF ^ type_flags());
    }
    (f | add) & (0x7FFFFFFF ^ del)
}

struct Compiler {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
}

impl Compiler {
    fn emit(mut ref self, op: own Op) -> i64 {
        self.ops.push(op);
        self.ops.len() - 1
    }

    fn here(ref self) -> i64 {
        self.ops.len()
    }

    fn compile(mut ref self, p: ref Parsed, nodes: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let icase = (flags & flag_i()) != 0;
        let ascii = (flags & flag_a()) != 0;
        for n in nodes.iter() {
            match n {
                Node.Lit(c) => {
                    let v = if icase { lower(c, ascii) } else { c };
                    self.emit(Op.Lit(v, icase, ascii));
                }
                Node.NotLit(c) => {
                    let v = if icase { lower(c, ascii) } else { c };
                    self.emit(Op.NotLit(v, icase, ascii));
                }
                Node.Any => {
                    if (flags & flag_s()) != 0 {
                        self.emit(Op.AnyAll);
                    } else {
                        self.emit(Op.Any);
                    }
                }
                Node.In(items, negate) => {
                    self.sets.push(CharSet { items: items.clone(), negate: negate });
                    let idx = self.sets.len() - 1;
                    self.emit(Op.In(idx, icase, ascii));
                }
                Node.At(kind) => {
                    let mut k = kind;
                    if (flags & flag_m()) != 0 {
                        if k == at_beginning() {
                            k = at_beginning_line();
                        } else if k == at_end() {
                            k = at_end_line();
                        }
                    }
                    self.emit(Op.At(k, ascii));
                }
                Node.Branch(items) => {
                    let mut ends: Vec[i64] = Vec.new();
                    let mut i = 0;
                    while i < items.len() {
                        if i + 1 < items.len() {
                            let split = self.emit(Op.Fail);
                            self.compile(p, items[i], flags)?;
                            ends.push(self.emit(Op.Fail));
                            let next = self.here();
                            self.ops[split] = Op.Split(split + 1, next);
                        } else {
                            self.compile(p, items[i], flags)?;
                        }
                        i += 1;
                    }
                    let end = self.here();
                    for at in ends {
                        self.ops[at] = Op.Jmp(end);
                    }
                }
                Node.Group(g, add, off, body) => {
                    if g > 0 {
                        self.emit(Op.Mark(2 * g));
                    }
                    self.compile(p, body, combine(flags, add, off))?;
                    if g > 0 {
                        self.emit(Op.Mark(2 * g + 1));
                    }
                }
                Node.Repeat(kind, min, max, body) => {
                    if kind == 2 {
                        let at = self.emit(Op.Fail);
                        self.compile_repeat(p, min, max, true, body, flags)?;
                        self.emit(Op.Succeed);
                        let next = self.here();
                        self.ops[at] = Op.Atomic(at + 1, next);
                    } else {
                        self.compile_repeat(p, min, max, kind == 0, body, flags)?;
                    }
                }
                Node.Atomic(body) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Atomic(at + 1, next);
                }
                Node.Assert(dir, negative, body) => {
                    let mut width = -1;
                    if dir < 0 {
                        let w = width_of(p.widths, body);
                        if w.lo != w.hi {
                            return Err(other_error("error", "look-behind requires fixed-width pattern".to_string()));
                        }
                        width = w.lo;
                    }
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Look(width, negative, at + 1, next);
                }
                Node.GroupRef(g) => {
                    self.emit(Op.Ref(g, icase, ascii));
                }
                Node.Exists(g, yes, no) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, yes, flags)?;
                    if no.len() > 0 {
                        let jump = self.emit(Op.Fail);
                        let no_pc = self.here();
                        self.compile(p, no, flags)?;
                        let end = self.here();
                        self.ops[jump] = Op.Jmp(end);
                        self.ops[at] = Op.Exists(g, no_pc);
                    } else {
                        let end = self.here();
                        self.ops[at] = Op.Exists(g, end);
                    }
                }
                Node.Failure => {
                    self.emit(Op.Fail);
                }
            }
        }
        Ok(())
    }

    fn compile_repeat(mut ref self, p: ref Parsed, min: i64, max: i64, greedy: bool, body: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let r = self.repeats;
        self.repeats += 1;
        let init = self.emit(Op.Fail);
        self.compile(p, body, flags)?;
        let until = self.emit(Op.Fail);
        self.ops[init] = Op.RepInit(r, until);
        self.ops[until] = Op.Until(r, min, max, greedy, init + 1, until + 1);
        Ok(())
    }
}

fn compile(pattern: ref Vec[i64], flags: i64) -> Result[Program, ReErr] {
    let p = parse(pattern, flags)?;
    let mut c = Compiler { ops: Vec.new(), sets: Vec.new(), repeats: 0 };
    c.compile(p, p.nodes, p.flags)?;
    c.emit(Op.Match);
    Ok(Program { ops: c.ops, sets: c.sets, repeats: c.repeats, groups: p.groups, names: p.names })
}

// ----------------------------------------------------------- matcher

struct Undo {
    kind: i64,
    idx: i64,
    old: i64,
}

struct Choice {
    pc: i64,
    pos: i64,
    trail: i64,
    // 0: resume at pc; 1: a lazy repeat's Until, after its tail failed
    mode: i64,
}

struct Matcher {
    s: Vec[i64],
    marks: Vec[i64],
    counts: Vec[i64],
    lasts: Vec[i64],
    lastindex: i64,
    trail: Vec[Undo],
    start: i64,
    must_advance: bool,
    match_all: bool,
}

impl Matcher {
    fn set_mark(mut ref self, slot: i64, v: i64) {
        self.trail.push(Undo { kind: 0, idx: slot, old: self.marks[slot] });
        self.marks[slot] = v;
    }

    fn set_count(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 1, idx: r, old: self.counts[r] });
        self.counts[r] = v;
    }

    fn set_last(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 2, idx: r, old: self.lasts[r] });
        self.lasts[r] = v;
    }

    fn set_lastindex(mut ref self, v: i64) {
        self.trail.push(Undo { kind: 3, idx: 0, old: self.lastindex });
        self.lastindex = v;
    }

    fn undo_to(mut ref self, len: i64) {
        while self.trail.len() > len {
            let u = self.trail.pop().unwrap();
            if u.kind == 0 {
                self.marks[u.idx] = u.old;
            } else if u.kind == 1 {
                self.counts[u.idx] = u.old;
            } else if u.kind == 2 {
                self.lasts[u.idx] = u.old;
            } else {
                self.lastindex = u.old;
            }
        }
    }

    // A group that has both marks, the end not before the start.
    fn group_span(ref self, g: i64) -> (i64, i64) {
        let a = self.marks[2 * g];
        let b = self.marks[2 * g + 1];
        if a < 0 or b < 0 or b < a {
            return (-1, -1);
        }
        (a, b)
    }

    fn at(ref self, kind: i64, ascii: bool, pos: i64) -> bool {
        let n = self.s.len();
        if kind == 0 or kind == 2 {
            return pos == 0;
        }
        if kind == 1 {
            return pos == 0 or self.s[pos - 1] == 10;
        }
        if kind == 3 {
            return pos == n or (pos == n - 1 and self.s[pos] == 10);
        }
        if kind == 4 {
            return pos == n or self.s[pos] == 10;
        }
        if kind == 5 {
            return pos == n;
        }
        if n == 0 {
            return false;
        }
        let before = pos > 0 and is_word(self.s[pos - 1], ascii);
        let after = pos < n and is_word(self.s[pos], ascii);
        if kind == 6 { before != after } else { before == after }
    }

    // Runs the program from pc at pos, backtracking through its own
    // choices only. Returns where it succeeded, or -1.
    fn run(mut ref self, prog: ref Program, pc0: i64, pos0: i64, top: bool) -> i64 {
        let base = self.trail.len();
        let mut choices: Vec[Choice] = Vec.new();
        let mut pc = pc0;
        let mut pos = pos0;
        let mut mode = 0;
        loop {
            let mut ok = true;
            let op = ref prog.ops[pc];
            if mode == 1 {
                // a lazy repeat whose tail failed: try one more item
                mode = 0;
                ok = false;
                if let Op.Until(r, _, max, _, body, _) = op {
                    let count = self.counts[r] + 1;
                    if not ((count >= max and max != maxrepeat()) or pos == self.lasts[r]) {
                        self.set_count(r, count);
                        self.set_last(r, pos);
                        pc = body;
                        ok = true;
                    }
                }
                if ok {
                    continue;
                }
            } else {
                match op {
                    Op.Lit(c, icase, ascii) => {
                        if pos < self.s.len() and (if icase { lower(self.s[pos], ascii) == c } else { self.s[pos] == c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.NotLit(c, icase, ascii) => {
                        if pos < self.s.len() and (if icase { lower(self.s[pos], ascii) != c } else { self.s[pos] != c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Any => {
                        if pos < self.s.len() and self.s[pos] != 10 {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.AnyAll => {
                        if pos < self.s.len() {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.In(set, icase, ascii) => {
                        if pos < self.s.len() and in_set(prog.sets[set], self.s[pos], icase, ascii) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.At(kind, ascii) => {
                        if self.at(kind, ascii, pos) {
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Mark(slot) => {
                        self.set_mark(slot, pos);
                        if (slot & 1) == 1 {
                            self.set_lastindex(slot / 2);
                        }
                        pc += 1;
                    }
                    Op.Split(a, b) => {
                        choices.push(Choice { pc: b, pos: pos, trail: self.trail.len(), mode: 0 });
                        pc = a;
                    }
                    Op.Jmp(a) => pc = a,
                    Op.RepInit(r, until) => {
                        self.set_count(r, -1);
                        self.set_last(r, -1);
                        pc = until;
                    }
                    Op.Until(r, min, max, greedy, body, exit) => {
                        let count = self.counts[r] + 1;
                        if count < min {
                            self.set_count(r, count);
                            pc = body;
                        } else if greedy {
                            if (count < max or max == maxrepeat()) and pos != self.lasts[r] {
                                choices.push(Choice { pc: exit, pos: pos, trail: self.trail.len(), mode: 0 });
                                self.set_count(r, count);
                                self.set_last(r, pos);
                                pc = body;
                            } else {
                                pc = exit;
                            }
                        } else {
                            choices.push(Choice { pc: pc, pos: pos, trail: self.trail.len(), mode: 1 });
                            pc = exit;
                        }
                    }
                    Op.Ref(g, icase, ascii) => {
                        let (a, b) = self.group_span(g);
                        if a < 0 {
                            ok = false;
                        } else {
                            let len = b - a;
                            if pos + len > self.s.len() {
                                ok = false;
                            } else {
                                let mut k = 0;
                                while k < len {
                                    let x = self.s[a + k];
                                    let y = self.s[pos + k];
                                    let eq = if icase { lower(x, ascii) == lower(y, ascii) } else { x == y };
                                    if not eq {
                                        ok = false;
                                        break;
                                    }
                                    k += 1;
                                }
                                if ok {
                                    pos += len;
                                    pc += 1;
                                }
                            }
                        }
                    }
                    Op.Look(width, negative, sub, next) => {
                        let mark = self.trail.len();
                        let from = if width < 0 { pos } else { pos - width };
                        let found = from >= 0 and self.run(prog, sub, from, false) >= 0;
                        if negative {
                            self.undo_to(mark);
                            if found {
                                ok = false;
                            } else {
                                pc = next;
                            }
                        } else if found {
                            pc = next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Atomic(sub, next) => {
                        let end = self.run(prog, sub, pos, false);
                        if end >= 0 {
                            pos = end;
                            pc = next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Exists(g, no) => {
                        let (a, _) = self.group_span(g);
                        if a >= 0 {
                            pc += 1;
                        } else {
                            pc = no;
                        }
                    }
                    Op.Fail => ok = false,
                    Op.Succeed => return pos,
                    Op.Match => {
                        if top and ((self.match_all and pos != self.s.len()) or (self.must_advance and pos == self.start)) {
                            ok = false;
                        } else {
                            return pos;
                        }
                    }
                }
            }
            if not ok {
                match choices.pop() {
                    Some(ch) => {
                        self.undo_to(ch.trail);
                        pc = ch.pc;
                        pos = ch.pos;
                        mode = ch.mode;
                    }
                    None => {
                        self.undo_to(base);
                        return -1;
                    }
                }
            }
        }
    }
}

fn in_items(set: ref CharSet, c: i64, ascii: bool) -> bool {
    for item in set.items.iter() {
        let hit = match item {
            Item.Lit(l) => c == l,
            Item.Range(lo, hi) => c >= lo and c <= hi,
            Item.Cat(k) => {
                let kind = k;
                if kind == 0 {
                    if ascii { c >= 48 and c <= 57 } else { is_decimal(c) }
                } else if kind == 1 {
                    if ascii { not (c >= 48 and c <= 57) } else { not is_decimal(c) }
                } else if kind == 2 {
                    is_space(c, ascii)
                } else if kind == 3 {
                    not is_space(c, ascii)
                } else if kind == 4 {
                    is_word(c, ascii)
                } else {
                    not is_word(c, ascii)
                }
            }
        };
        if hit {
            return true;
        }
    }
    false
}

// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = lower(c, ascii);
        if lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program, s: ref Vec[i64]) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        s: s.clone(),
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn find(m: mut ref Matcher, prog: ref Program, from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= m.s.len() {
        let mut k = 0;
        while k < m.marks.len() {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}

// All the matches finditer gives: each search starts where the last
// match ended, and must move on past an empty one.
fn all_matches(prog: ref Program, s: ref Vec[i64], limit: i64) -> Vec[Found] {
    let mut m = new_matcher(prog, s);
    let mut out: Vec[Found] = Vec.new();
    let mut pos = 0;
    let mut must_advance = false;
    while pos <= s.len() and (limit == 0 or out.len() < limit) {
        match find(mut m, prog, pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    out
}


// ------------------------------------------------------------ _csv's reader

// A character the dialect does not set.
const UNSET: i64 = -2;
// The end of a line, fed to the state machine after its characters.
const EOL: i64 = -1;

const QUOTE_MINIMAL: i64 = 0;
const QUOTE_NONE: i64 = 3;

// The dialect PythonParser builds for csv.reader: lineterminator "\n"
// and strict, the rest from the options.
#[derive(Clone)]
struct Dialect {
    delimiter: i64,
    quotechar: i64,
    escapechar: i64,
    doublequote: bool,
    skipinitialspace: bool,
    quoting: i64,
}

fn csv_char(name: Str, v: ref Option[String]) -> Result[i64, PyErr] {
    match v {
        None => Ok(UNSET),
        Some(s) => {
            let c = cps_of(s);
            if c.len() != 1 {
                return Err(py_err("TypeError", f"\"{name}\" must be a 1-character string"));
            }
            Ok(c[0])
        }
    }
}

// The "bad X value" check: no line end, and no space where
// skipinitialspace would eat it.
fn bad_char(name: Str, c: i64, allow_space: bool) -> Result[(), PyErr] {
    if c == UNSET {
        return Ok(());
    }
    if c == 13 or c == 10 or (c == 32 and not allow_space) {
        return Err(py_err("ValueError", f"bad {name} value"));
    }
    Ok(())
}

fn bad_pair(a: Str, b: Str, x: i64, y: i64) -> Result[(), PyErr] {
    if x != UNSET and x == y {
        return Err(py_err("ValueError", f"bad {a} or {b} value"));
    }
    Ok(())
}

// csv.reader(f, dialect=MyDialect, strict=True): _csv's argument
// conversion and its checks, in its order.
fn make_dialect(delimiter: i64, quotechar: ref Option[String], escapechar: ref Option[String], doublequote: bool, skipinitialspace: bool, quoting: i64) -> Result[Dialect, PyErr] {
    let esc = csv_char("escapechar", escapechar)?;
    let quo = csv_char("quotechar", quotechar)?;
    if quoting < 0 or quoting > 5 {
        return Err(py_err("TypeError", "bad \"quoting\" value"));
    }
    if quoting != QUOTE_NONE and quo == UNSET {
        return Err(py_err("TypeError", "quotechar must be set if quoting enabled"));
    }
    bad_char("delimiter", delimiter, true)?;
    bad_char("escapechar", esc, not skipinitialspace)?;
    bad_char("quotechar", quo, not skipinitialspace)?;
    bad_pair("delimiter", "escapechar", delimiter, esc)?;
    bad_pair("delimiter", "quotechar", delimiter, quo)?;
    bad_pair("escapechar", "quotechar", esc, quo)?;
    Ok(Dialect { delimiter: delimiter, quotechar: quo, escapechar: esc, doublequote: doublequote, skipinitialspace: skipinitialspace, quoting: quoting })
}

fn csv_error(msg: Str) -> PyErr {
    py_err("Error", msg)
}

fn cp_text(c: i64) -> String {
    to_string(vec![c])
}

const START_RECORD: i64 = 0;
const START_FIELD: i64 = 1;
const ESCAPED_CHAR: i64 = 2;
const IN_FIELD: i64 = 3;
const IN_QUOTED_FIELD: i64 = 4;
const ESCAPE_IN_QUOTED_FIELD: i64 = 5;
const QUOTE_IN_QUOTED_FIELD: i64 = 6;
const EAT_CRNL: i64 = 7;
const AFTER_ESCAPED_CRNL: i64 = 8;

const FIELD_LIMIT: i64 = 131072;

// _csv.c's reader over the lines of the file, from `at` on.
struct CsvRd {
    d: Dialect,
    lines: Vec[Vec[i64]],
    at: i64,
    state: i64,
    fields: Vec[String],
    field: Vec[i64],
}

impl CsvRd {
    fn save_field(mut ref self) {
        self.fields.push(to_string(self.field));
        self.field.clear();
    }

    fn add_char(mut ref self, c: i64) -> Result[(), PyErr] {
        if self.field.len() >= FIELD_LIMIT {
            return Err(csv_error(f"field larger than field limit ({FIELD_LIMIT})"));
        }
        self.field.push(c);
        Ok(())
    }

    fn end_line(mut ref self, c: i64) {
        self.save_field();
        self.state = if c == EOL { START_RECORD } else { EAT_CRNL };
    }

    // parse_process_char.
    fn process(mut ref self, c0: i64) -> Result[(), PyErr] {
        let mut c = c0;
        let d = self.d.clone();
        let nl = c == 10 or c == 13;
        let quote = c == d.quotechar and d.quoting != QUOTE_NONE;
        if self.state == START_RECORD {
            if c == EOL {
                return Ok(());
            }
            if nl {
                self.state = EAT_CRNL;
                return Ok(());
            }
            self.state = START_FIELD;
        }
        if self.state == START_FIELD {
            if nl or c == EOL {
                self.end_line(c);
            } else if quote {
                self.state = IN_QUOTED_FIELD;
            } else if c == d.escapechar {
                self.state = ESCAPED_CHAR;
            } else if c == 32 and d.skipinitialspace {
                // a space at the start of a field goes
            } else if c == d.delimiter {
                self.save_field();
            } else {
                self.add_char(c)?;
                self.state = IN_FIELD;
            }
            return Ok(());
        }
        if self.state == ESCAPED_CHAR {
            if nl {
                self.add_char(c)?;
                self.state = AFTER_ESCAPED_CRNL;
                return Ok(());
            }
            if c == EOL {
                c = 10;
            }
            self.add_char(c)?;
            self.state = IN_FIELD;
            return Ok(());
        }
        if self.state == AFTER_ESCAPED_CRNL {
            if c == EOL {
                return Ok(());
            }
            self.state = IN_FIELD;
        }
        if self.state == IN_FIELD {
            if nl or c == EOL {
                self.end_line(c);
            } else if c == d.escapechar {
                self.state = ESCAPED_CHAR;
            } else if c == d.delimiter {
                self.save_field();
                self.state = START_FIELD;
            } else {
                self.add_char(c)?;
            }
            return Ok(());
        }
        if self.state == IN_QUOTED_FIELD {
            if c == EOL {
                return Ok(());
            }
            if c == d.escapechar {
                self.state = ESCAPE_IN_QUOTED_FIELD;
            } else if quote {
                self.state = if d.doublequote { QUOTE_IN_QUOTED_FIELD } else { IN_FIELD };
            } else {
                self.add_char(c)?;
            }
            return Ok(());
        }
        if self.state == ESCAPE_IN_QUOTED_FIELD {
            if c == EOL {
                c = 10;
            }
            self.add_char(c)?;
            self.state = IN_QUOTED_FIELD;
            return Ok(());
        }
        if self.state == QUOTE_IN_QUOTED_FIELD {
            if quote {
                self.add_char(c)?;
                self.state = IN_QUOTED_FIELD;
            } else if c == d.delimiter {
                self.save_field();
                self.state = START_FIELD;
            } else if nl or c == EOL {
                self.end_line(c);
            } else {
                return Err(csv_error(f"'{cp_text(d.delimiter)}' expected after '{cp_text(d.quotechar)}'"));
            }
            return Ok(());
        }
        // EAT_CRNL
        if nl {
            return Ok(());
        }
        if c == EOL {
            self.state = START_RECORD;
            return Ok(());
        }
        Err(csv_error("new-line character seen in unquoted field - do you need to open the file with newline=''?"))
    }

    // Reader_iternext: the next record, None at the end of the file.
    // After an error the reader goes on at the next line.
    fn next(mut ref self) -> Result[Option[Vec[String]], PyErr] {
        self.fields = Vec.new();
        self.field.clear();
        self.state = START_RECORD;
        loop {
            if self.at >= self.lines.len() {
                if self.field.len() != 0 or self.state == IN_QUOTED_FIELD {
                    self.state = START_RECORD;
                    return Err(csv_error("unexpected end of data"));
                }
                return Ok(None);
            }
            let line = self.lines[self.at].clone();
            self.at += 1;
            for c in line {
                if let Err(e) = self.process(c) {
                    self.state = START_RECORD;
                    return Err(e);
                }
            }
            self.process(EOL)?;
            if self.state == START_RECORD {
                break;
            }
        }
        let row = self.fields.clone();
        self.fields = Vec.new();
        Ok(Some(row))
    }
}

// ------------------------------------------------------------ csv.Sniffer

fn sniff_delim_class(c: i64) -> bool {
    not (is_word(c, false) or c == 10 or c == 34 or c == 39)
}

fn quoted_body_end(d: ref Vec[i64], from: i64, q: i64) -> i64 {
    let mut p = from;
    loop {
        if p + 1 < d.len() and d[p] == q and d[p + 1] == q {
            p += 2;
        } else if p < d.len() and d[p] != q {
            p += 1;
        } else {
            return p;
        }
    }
}

// A match of one of _guess_quote_and_delimiter's patterns: its quote,
// its delimiter (0 for none), whether a space followed the delimiter,
// and where it ends.
struct QMatch {
    quote: i64,
    delim: i64,
    space: bool,
    end: i64,
}

// `(?P<delim>D)(?P<space> ?)(?P<quote>Q)BODY(?P=quote)` then, for form 1,
// `(?P=delim)`, and for form 3, `(?:$|\n)`.
fn match_delim_first(d: ref Vec[i64], s: i64, form: i64) -> Option[QMatch] {
    if s >= d.len() or not sniff_delim_class(d[s]) {
        return None;
    }
    let delim = d[s];
    let mut p = s + 1;
    let space = p < d.len() and d[p] == 32;
    if space {
        p += 1;
    }
    if p >= d.len() or not (d[p] == 34 or d[p] == 39) {
        return None;
    }
    let q = d[p];
    p = quoted_body_end(d, p + 1, q);
    if p >= d.len() or d[p] != q {
        return None;
    }
    p += 1;
    if form == 1 {
        if p >= d.len() or d[p] != delim {
            return None;
        }
        p += 1;
    } else if p < d.len() and d[p] != 10 {
        return None;
    }
    Some(QMatch { quote: q, delim: delim, space: space, end: p })
}

// `(?:^|\n)(?P<quote>Q)BODY(?P=quote)` then, for form 2,
// `(?P<delim>D)(?P<space> ?)`, and for form 4, `(?:$|\n)`.
fn match_line_first(d: ref Vec[i64], s: i64, form: i64) -> Option[QMatch] {
    let mut starts: Vec[i64] = Vec.new();
    if s == 0 or d[s - 1] == 10 {
        starts.push(s);
    }
    if s < d.len() and d[s] == 10 {
        starts.push(s + 1);
    }
    for st in starts {
        let mut p = st;
        if p >= d.len() or not (d[p] == 34 or d[p] == 39) {
            continue;
        }
        let q = d[p];
        p = quoted_body_end(d, p + 1, q);
        if p >= d.len() or d[p] != q {
            continue;
        }
        p += 1;
        if form == 2 {
            if p >= d.len() or not sniff_delim_class(d[p]) {
                continue;
            }
            let delim = d[p];
            p += 1;
            let space = p < d.len() and d[p] == 32;
            if space {
                p += 1;
            }
            return Some(QMatch { quote: q, delim: delim, space: space, end: p });
        }
        if p < d.len() and d[p] != 10 {
            continue;
        }
        return Some(QMatch { quote: q, delim: 0, space: false, end: p });
    }
    None
}

fn find_all_form(d: ref Vec[i64], form: i64) -> Vec[QMatch] {
    let mut out: Vec[QMatch] = Vec.new();
    let mut s: i64 = 0;
    while s <= d.len() {
        let m = if form == 1 or form == 3 { match_delim_first(d, s, form) } else { match_line_first(d, s, form) };
        match m {
            Some(m) => {
                s = m.end;
                out.push(m);
            }
            None => s += 1,
        }
    }
    out
}

// A count per character, in the order the characters were first counted,
// as a Python dict keeps them.
struct Counts {
    keys: Vec[i64],
    counts: Vec[i64],
}

impl Counts {
    fn add(mut ref self, c: i64) {
        for i in 0..self.keys.len() {
            if self.keys[i] == c {
                self.counts[i] += 1;
                return;
            }
        }
        self.keys.push(c);
        self.counts.push(1);
    }

    // max(d, key=d.get): the first key with the largest count.
    fn best(ref self) -> i64 {
        let mut b: i64 = 0;
        for i in 1..self.keys.len() {
            if self.counts[i] > self.counts[b] {
                b = i;
            }
        }
        b
    }
}

// _guess_quote_and_delimiter's delimiter and skipinitialspace (0 when
// it finds none).
fn guess_quote_and_delimiter(d: ref Vec[i64]) -> (i64, bool) {
    let mut matches: Vec[QMatch] = Vec.new();
    let mut form: i64 = 1;
    while form <= 4 {
        matches = find_all_form(d, form);
        if matches.len() > 0 {
            break;
        }
        form += 1;
    }
    if matches.len() == 0 or form == 4 {
        return (0, false);
    }
    let mut delims = Counts { keys: Vec.new(), counts: Vec.new() };
    let mut spaces: i64 = 0;
    for m in matches {
        delims.add(m.delim);
        if m.space {
            spaces += 1;
        }
    }
    let b = delims.best();
    let delim = delims.keys[b];
    if delim == 10 {
        return (0, false);
    }
    (delim, delims.counts[b] == spaces)
}

fn count_cp(line: ref Vec[i64], c: i64) -> i64 {
    let mut n: i64 = 0;
    for x in line {
        if x == c {
            n += 1;
        }
    }
    n
}

// data[0].count(d) == data[0].count(d + " ")
fn spaces_after(line: ref Vec[i64], c: i64) -> bool {
    let mut pairs: i64 = 0;
    let mut i: i64 = 0;
    while i < line.len() {
        if i + 1 < line.len() and line[i] == c and line[i + 1] == 32 {
            pairs += 1;
            i += 2;
        } else {
            i += 1;
        }
    }
    count_cp(line, c) == pairs
}

// One character's mode: the frequency, and how many lines show it less
// the lines that show any other frequency.
#[derive(Clone)]
struct Mode {
    c: i64,
    freq: i64,
    count: i64,
}

// _guess_delimiter: the character whose count per line is most
// consistent, over chunks of ten lines.
fn guess_delimiter(text: ref Vec[i64]) -> (i64, bool) {
    let mut data: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    for c in text {
        if c == 10 {
            if cur.len() > 0 {
                data.push(cur);
            }
            cur = Vec.new();
        } else {
            cur.push(c);
        }
    }
    if cur.len() > 0 {
        data.push(cur);
    }
    let chunk = if data.len() < 10 { data.len() } else { 10 };
    let mut iteration: i64 = 0;
    let mut freqs: Vec[Vec[i64]] = Vec.new();
    let mut lines: Vec[Vec[i64]] = Vec.new();
    for _ in 0..127 {
        freqs.push(Vec.new());
        lines.push(Vec.new());
    }
    let mut modes: Vec[Mode] = Vec.new();
    let mut delims: Vec[Mode] = Vec.new();
    let mut start: i64 = 0;
    let mut end = chunk;
    while start < data.len() {
        iteration += 1;
        let stop = if end < data.len() { end } else { data.len() };
        for li in start..stop {
            for c in 0..127 {
                let f = count_cp(data[li], c);
                let mut found = false;
                for k in 0..freqs[c].len() {
                    if freqs[c][k] == f {
                        lines[c][k] += 1;
                        found = true;
                    }
                }
                if not found {
                    freqs[c].push(f);
                    lines[c].push(1);
                }
            }
        }
        for c in 0..127 {
            if freqs[c].len() == 0 or (freqs[c].len() == 1 and freqs[c][0] == 0) {
                continue;
            }
            let mut m = Mode { c: c, freq: freqs[c][0], count: lines[c][0] };
            if freqs[c].len() > 1 {
                let mut b: i64 = 0;
                for k in 1..freqs[c].len() {
                    if lines[c][k] > lines[c][b] {
                        b = k;
                    }
                }
                let mut others: i64 = 0;
                for k in 0..freqs[c].len() {
                    if k != b {
                        others += lines[c][k];
                    }
                }
                m = Mode { c: c, freq: freqs[c][b], count: lines[c][b] - others };
            }
            let mut placed = false;
            for k in 0..modes.len() {
                if modes[k].c == c {
                    modes[k] = m.clone();
                    placed = true;
                }
            }
            if not placed {
                modes.push(m);
            }
        }
        let seen = chunk * iteration;
        let total = (if seen < data.len() { seen } else { data.len() }) as f64;
        let mut consistency: f64 = 1.0;
        let threshold: f64 = 0.9;
        while delims.len() == 0 and consistency >= threshold {
            for v in modes {
                if v.freq > 0 and v.count > 0 and (v.count as f64) / total >= consistency {
                    delims.push(v.clone());
                }
            }
            consistency -= 0.01;
        }
        if delims.len() == 1 {
            let dl = delims[0].c;
            return (dl, spaces_after(data[0], dl));
        }
        start = end;
        end += chunk;
    }
    if delims.len() == 0 {
        return (0, false);
    }
    for p in [44, 9, 59, 32, 58] {
        for v in delims {
            if v.c == p {
                return (p, spaces_after(data[0], p));
            }
        }
    }
    // the largest (mode, character) pair
    let mut b: i64 = 0;
    for k in 1..delims.len() {
        let x = delims[k].clone();
        let y = delims[b].clone();
        if x.freq > y.freq or (x.freq == y.freq and (x.count > y.count or (x.count == y.count and x.c > y.c))) {
            b = k;
        }
    }
    let dl = delims[b].c;
    (dl, spaces_after(data[0], dl))
}

// Sniffer().sniff(sample).delimiter, the one thing PythonParser takes.
fn sniff_delimiter(sample: ref Vec[i64]) -> Result[i64, PyErr] {
    let mut d: Vec[i64] = Vec.new();
    let mut i: i64 = 0;
    while i < sample.len() {
        let c = sample[i];
        if c == 13 {
            d.push(10);
            if i + 1 < sample.len() and sample[i + 1] == 10 {
                i += 1;
            }
        } else {
            d.push(c);
        }
        i += 1;
    }
    let mut (delim, _) = guess_quote_and_delimiter(d);
    if delim == 0 {
        let (dl, _) = guess_delimiter(d);
        delim = dl;
    }
    if delim == 0 {
        return Err(csv_error("Could not determine delimiter"));
    }
    Ok(delim)
}

// ------------------------------------------------------------ the row sources

// The lines of a regular-expression separator: each one stripped and
// split with re.split. The pattern compiles when the first line is
// read, as the generator PythonParser makes does it.
struct ReRd {
    lines: Vec[Vec[i64]],
    at: i64,
    pattern: Vec[i64],
    prog: Option[Program],
}

fn strip_ws(s: ref Vec[i64]) -> Vec[i64] {
    let mut a: i64 = 0;
    let mut b = s.len();
    while a < b and is_space(s[a], false) {
        a += 1;
    }
    while b > a and is_space(s[b - 1], false) {
        b -= 1;
    }
    slice(s, a, b)
}

// re.split(pattern, s): the pieces between the matches, with each
// match's groups between them.
fn re_split(prog: ref Program, s: ref Vec[i64]) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut last: i64 = 0;
    for m in all_matches(prog, s, 0) {
        out.push(to_string(slice(s, last, m.start)));
        for (a, b) in m.spans {
            out.push(if a < 0 { String.new() } else { to_string(slice(s, a, b)) });
        }
        last = m.end;
    }
    out.push(to_string(slice(s, last, s.len())));
    out
}

impl ReRd {
    fn next(mut ref self) -> Result[Option[Vec[String]], PyErr] {
        if self.prog.is_none() {
            match compile(self.pattern, 0) {
                Ok(p) => self.prog = Some(p),
                Err(e) => {
                    let msg = if e.pos >= 0 { f"{e.msg} at position {e.pos}" } else { e.msg.clone() };
                    return Err(py_err("PatternError", msg));
                }
            }
            if self.lines.len() == 0 {
                self.at = 1;
                return Ok(Some(vec![String.new()]));
            }
        }
        if self.at >= self.lines.len() {
            return Ok(None);
        }
        let line = strip_ws(self.lines[self.at]);
        self.at += 1;
        match self.prog {
            Some(ref p) => Ok(Some(re_split(p, line))),
            None => Ok(None),
        }
    }
}

// What PythonParser reads its rows from.
enum Src {
    Csv(CsvRd),
    Re(ReRd),
}

impl Src {
    fn next(mut ref self) -> Result[Option[Vec[String]], PyErr] {
        match self {
            Src.Csv(mut ref r) => r.next(),
            Src.Re(mut ref r) => r.next(),
        }
    }
}
// ------------------------------------------------------------ the options

#[derive(Clone)]
enum Hdr {
    Infer,
    NoHeader,
    One(i64),
    Many(Vec[i64]),
}

// sep: left out, None (sniff it), or given.
#[derive(Clone)]
enum Sep {
    Default,
    Sniff,
    Given(String),
}

#[derive(Clone)]
enum NaArg {
    Default,
    List(Vec[String]),
    Map(Vec[(String, Vec[String])]),
}

#[derive(Clone)]
enum Dt {
    NoDt,
    All(String),
    Map(Vec[(String, String)]),
}

// The keyword arguments of one read_csv call.
#[derive(Clone)]
struct Opts {
    table: bool,
    sep: Sep,
    delimiter: Option[String],
    dialect: Option[String],
    quotechar: Option[String],
    escapechar: Option[String],
    doublequote: bool,
    skipinitialspace: bool,
    quoting: i64,
    header: Hdr,
    names: Option[Vec[String]],
    usecols: Option[Vec[Ic]],
    index_col: Option[Vec[Ic]],
    index_col_list: bool,
    index_false: bool,
    index_true: bool,
    skiprows: Vec[i64],
    skipfooter: i64,
    nrows: Option[i64],
    chunksize: Option[i64],
    comment: Option[String],
    thousands: Option[String],
    decimal: String,
    true_values: Vec[String],
    false_values: Vec[String],
    encoding: Option[String],
    encoding_errors: String,
    on_bad_lines: String,
    na_values: NaArg,
    keep_default_na: bool,
    na_filter: bool,
    skip_blank_lines: bool,
    dtype: Dt,
    backend: Option[String],
    head: Option[i64],
}

fn dtype_of(dt: ref Dt, k: ref Vec[Lab]) -> Option[String] {
    match dt {
        Dt.NoDt => None,
        Dt.All(t) => Some(t.clone()),
        Dt.Map(m) => {
            let name = key_name(k)?;
            for (c, t) in m {
                if c == name {
                    return Some(t.clone());
                }
            }
            None
        }
    }
}

// ------------------------------------------------------------ the number pattern

fn is_dcp(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn at_cps(s: ref Vec[i64], i: i64, pat: ref Vec[i64]) -> bool {
    if pat.len() == 0 or i + pat.len() > s.len() {
        return false;
    }
    for j in 0..pat.len() {
        if s[i + j] != pat[j] {
            return false;
        }
    }
    true
}

// PythonParser.num.search on a stripped cell:
// ^[\-\+]?([0-9]+T|[0-9])*(D[0-9]*)?([0-9]?(E|e)\-?[0-9]+)?$ with T the
// thousands separator, or ^[\-\+]?[0-9]*(D[0-9]*)?(...)?$ without one.
// The language is matched with sets of reachable positions.
fn num_match(s: ref Vec[i64], thousands: ref Option[Vec[i64]], dec: i64) -> bool {
    let n = s.len();
    let mut p: i64 = 0;
    if p < n and (s[p] == 45 or s[p] == 43) {
        p = 1;
    }
    let mut r1: Vec[bool] = Vec.new();
    for _ in 0..n + 1 {
        r1.push(false);
    }
    r1[p] = true;
    match thousands {
        None => {
            let mut q = p;
            while q < n and is_dcp(s[q]) {
                q += 1;
                r1[q] = true;
            }
        }
        Some(t) => {
            for q in p..n {
                if not r1[q] {
                    continue;
                }
                if is_dcp(s[q]) {
                    r1[q + 1] = true;
                    let mut k = q;
                    while k < n and is_dcp(s[k]) {
                        k += 1;
                        if at_cps(s, k, t) {
                            r1[k + t.len()] = true;
                        }
                    }
                }
            }
        }
    }
    let mut r2 = r1.clone();
    for q in 0..n {
        if r1[q] and s[q] == dec {
            r2[q + 1] = true;
            let mut k = q + 1;
            while k < n and is_dcp(s[k]) {
                k += 1;
                r2[k] = true;
            }
        }
    }
    let mut r3 = r2.clone();
    for q in 0..n + 1 {
        if not r2[q] {
            continue;
        }
        let mut starts = vec![q];
        if q < n and is_dcp(s[q]) {
            starts.push(q + 1);
        }
        for e in starts {
            if e < n and (s[e] == 69 or s[e] == 101) {
                let mut k = e + 1;
                if k < n and s[k] == 45 {
                    k += 1;
                }
                while k < n and is_dcp(s[k]) {
                    k += 1;
                    r3[k] = true;
                }
            }
        }
    }
    r3[n]
}

// ------------------------------------------------------------ the python engine

// PythonParser as read_csv drives it: the reader's rows, the buffer of
// rows read ahead, and what __init__ works out about the columns.
struct Engine {
    rd: Src,
    buf: Vec[Vec[String]],
    pos: i64,
    line_pos: i64,
    skip: Vec[i64],
    skipfooter: i64,
    comment: Option[String],
    skip_blank: bool,
    names: Option[Vec[String]],
    header: Option[Vec[i64]],
    have_mi: bool,
    index_col: Option[Vec[Ic]],
    usecols: Option[Vec[Ic]],
    usecols_str: bool,
    col_indices: Option[Vec[i64]],
    implicit_index: bool,
    num_orig: i64,
    unnamed: Vec[String],
    header_line: Option[Vec[String]],
    na: NaSpec,
    dtype: Dt,
    backend: bool,
    thousands: Option[Vec[i64]],
    decimal: Vec[i64],
    no_thousands: Vec[i64],
    orig_names: Vec[Vec[Lab]],
    columns: Vec[Vec[Lab]],
    index_names: Option[Vec[Vec[Lab]]],
    col_names: Option[Vec[Lab]],
    first_chunk: bool,
    delimiter: Option[String],
    quotechar: i64,
    quoting: i64,
    index_false: bool,
    // on_bad_lines: 0 error, 1 warn, 2 skip
    on_bad: i64,
    bools: BoolVals,
    // the warnings so far, as the oracle prints them
    log: String,
}

fn strs_to_labs(v: ref Vec[String]) -> Vec[Lab] {
    let mut out: Vec[Lab] = Vec.new();
    for s in v {
        out.push(Lab.S(s.clone()));
    }
    out
}

fn ic_repr(c: ref Ic) -> String {
    match c {
        Ic.I(n) => n.to_string(),
        Ic.S(s) => py_repr(s),
    }
}

fn index_error() -> PyErr {
    py_err("IndexError", "list index out of range")
}

// A Python list index, negative ones from the end.
fn py_index(i: i64, n: i64) -> Result[i64, PyErr] {
    let k = if i < 0 { i + n } else { i };
    if k < 0 or k >= n {
        return Err(index_error());
    }
    Ok(k)
}

impl Engine {
    fn skipped(ref self, i: i64) -> bool {
        int_in(self.skip, i)
    }

    // _check_comments on one row: the first field holding the comment
    // character is cut there, and the fields after it go.
    fn check_comments(ref self, line: own Vec[String]) -> Vec[String] {
        let c = match self.comment {
            Some(ref c) => cps_of(c),
            None => return line,
        };
        let mut rl: Vec[String] = Vec.new();
        for x in line.into_iter() {
            let xc = cps_of(x);
            let at = find_cps(xc, c);
            if at < 0 or self.na.holds(x) {
                rl.push(x);
            } else {
                if at > 0 {
                    rl.push(to_string(slice(xc, 0, at)));
                }
                break;
            }
        }
        rl
    }

    // _alert_malformed: a ParserError, or a warning, or nothing.
    fn alert(mut ref self, msg: Str, row_num: i64) -> Result[(), PyErr] {
        if self.on_bad == 0 {
            return Err(py_err("ParserError", msg));
        }
        if self.on_bad == 1 {
            self.log.push_str(f"warn: Skipping line {row_num}: {msg}\n");
        }
        Ok(())
    }

    // _next_iter_line: the next row; Some(None) for a row csv could not
    // parse, which on_bad_lines decides about; None at the end.
    fn next_iter_line(mut ref self, row_num: i64) -> Result[Option[Option[Vec[String]]], PyErr] {
        match self.rd.next() {
            Ok(Some(r)) => Ok(Some(Some(r))),
            Ok(None) => Ok(None),
            Err(e) => {
                if e.kind != "Error" {
                    return Err(e);
                }
                if self.on_bad != 2 {
                    let mut msg = e.msg.clone();
                    if self.skipfooter > 0 {
                        msg.push_str(". Error could possibly be due to parsing errors in the skipped footer rows (the skipfooter keyword is only applied after Python's csv library has parsed all rows).");
                    }
                    self.alert(msg, row_num)?;
                }
                Ok(Some(None))
            }
        }
    }

    // _next_line: skips the rows skiprows names (only before the first
    // read), then the rows csv could not parse, the comment rows and the
    // blank ones.
    fn next_line(mut ref self) -> Result[Option[Vec[String]], PyErr] {
        while self.skipped(self.pos) {
            self.pos += 1;
            if self.rd.next()?.is_none() {
                return Ok(None);
            }
        }
        let mut line: Vec[String] = Vec.new();
        loop {
            let got = match self.next_iter_line(self.pos + 1)? {
                Some(g) => g,
                None => return Ok(None),
            };
            self.pos += 1;
            if let Some(orig) = got {
                let l = self.check_comments(orig.clone());
                if self.skip_blank {
                    if py_keep(l) {
                        line = l;
                        break;
                    }
                } else if is_line_empty(orig) or l.len() > 0 {
                    line = l;
                    break;
                }
            }
        }
        if self.pos == 1 {
            line = check_for_bom(line, self.quotechar)?;
        }
        self.line_pos += 1;
        self.buf.push(line.clone());
        Ok(Some(line))
    }

    fn buffered_line(mut ref self) -> Result[Option[Vec[String]], PyErr] {
        if self.buf.len() > 0 {
            return Ok(Some(self.buf[0].clone()));
        }
        self.next_line()
    }

    // The _header_line property (header=None): the first row, kept.
    fn get_header_line(mut ref self) -> Result[Vec[String], PyErr] {
        if let Some(ref l) = self.header_line {
            return Ok(l.clone());
        }
        let line = match self.buffered_line()? {
            Some(l) => l,
            None => match self.names {
                Some(ref n) => {
                    if n.len() == 0 {
                        return Err(no_columns());
                    }
                    n.clone()
                }
                None => return Err(no_columns()),
            },
        };
        self.header_line = Some(line.clone());
        Ok(line)
    }

    // _handle_usecols: sets col_indices and keeps those columns of each
    // header row.
    fn handle_usecols(mut ref self, columns: own Vec[Vec[Lab]], key: ref Vec[Lab], num_orig: i64) -> Result[Vec[Vec[Lab]], PyErr] {
        let uc = match self.usecols {
            Some(ref u) => u.clone(),
            None => return Ok(columns),
        };
        let mut picked: Vec[i64] = Vec.new();
        if self.usecols_str {
            if columns.len() > 1 {
                return Err(py_err("ValueError", "If using multiple headers, usecols must be integers."));
            }
            for c in uc {
                match c {
                    Ic.S(name) => {
                        let mut found: i64 = -1;
                        for j in 0..key.len() {
                            if found < 0 and lab_eq(key[j], Lab.S(name.clone())) {
                                found = j;
                            }
                        }
                        if found < 0 {
                            let mut missing: Vec[String] = Vec.new();
                            for d in uc {
                                if let Ic.S(m) = d {
                                    let mut there = false;
                                    for l in key {
                                        if lab_eq(l, Lab.S(m.clone())) {
                                            there = true;
                                        }
                                    }
                                    if not there {
                                        missing.push(py_repr(m));
                                    }
                                }
                            }
                            return Err(py_err("ValueError", f"Usecols do not match columns, columns expected but not found: {list_repr(missing)}"));
                        }
                        picked.push(found);
                    }
                    Ic.I(n) => picked.push(n),
                }
            }
        } else {
            let mut missing: Vec[String] = Vec.new();
            let mut ints: Vec[i64] = Vec.new();
            for c in uc {
                if let Ic.I(n) = c {
                    ints.push(n);
                }
            }
            for n in sorted_ints(ints) {
                if n >= num_orig {
                    missing.push(n.to_string());
                }
            }
            if missing.len() > 0 {
                return Err(py_err("ParserError", f"Defining usecols with out-of-bounds indices is not allowed. {list_repr(missing)} are out-of-bounds."));
            }
            picked = ints;
        }
        let mut out: Vec[Vec[Lab]] = Vec.new();
        for col in columns {
            let mut row: Vec[Lab] = Vec.new();
            for i in 0..col.len() {
                if int_in(picked, i) {
                    row.push(col[i].clone());
                }
            }
            out.push(row);
        }
        let mut uniq: Vec[i64] = Vec.new();
        for p in picked {
            if not int_in(uniq, p) {
                uniq.push(p);
            }
        }
        self.col_indices = Some(sorted_ints(uniq));
        Ok(out)
    }

    // The dtype dict follows a renamed duplicate column.
    fn carry_dtype(mut ref self, old: ref Vec[Lab], new: ref Vec[Lab]) {
        let (o, n) = match (key_name(old), key_name(new)) {
            (Some(a), Some(b)) => (a, b),
            _ => return,
        };
        let mut m = match self.dtype {
            Dt.Map(ref m) => m.clone(),
            _ => return,
        };
        let mut have_old: Option[String] = None;
        let mut have_new = false;
        for (c, t) in m {
            if c == o {
                have_old = Some(t.clone());
            }
            if c == n {
                have_new = true;
            }
        }
        if let Some(t) = have_old {
            if not have_new {
                m.push((n, t));
                self.dtype = Dt.Map(m);
            }
        }
    }

    // _infer_columns: the header rows (or names, or positions), and the
    // number of columns in the file.
    fn infer_columns(mut ref self) -> Result[Vec[Vec[Lab]], PyErr] {
        let names = self.names.clone();
        let mut num_orig: i64 = 0;
        let mut clear_buffer = true;
        let mut columns: Vec[Vec[Lab]] = Vec.new();
        match self.header.clone() {
            Some(h0) => {
                let have_mi = self.have_mi;
                let mut hs = h0.clone();
                if have_mi {
                    hs.push(h0[h0.len() - 1] + 1);
                }
                let last = hs[hs.len() - 1];
                let mut level: i64 = 0;
                for hr in hs {
                    let mut got = self.buffered_line()?;
                    let mut stopped = got.is_none();
                    while not stopped and self.line_pos <= hr {
                        got = self.next_line()?;
                        stopped = got.is_none();
                    }
                    let line: Vec[String] = if stopped {
                        if 0 < self.line_pos and self.line_pos <= hr and (not have_mi or hr != last) {
                            let mut joi: Vec[String] = Vec.new();
                            let n = if have_mi { hs.len() - 1 } else { hs.len() };
                            for i in 0..n {
                                joi.push(hs[i].to_string());
                            }
                            return Err(py_err("ValueError", f"Passed header=[{join(joi, ",")}], len of {joi.len()}, but only {self.line_pos} lines in file"));
                        }
                        if have_mi and hr > 0 {
                            if clear_buffer {
                                self.buf.clear();
                            }
                            let mut nils: Vec[Lab] = Vec.new();
                            for _ in 0..columns[columns.len() - 1].len() {
                                nils.push(Lab.Nil);
                            }
                            columns.push(nils);
                            self.num_orig = num_orig;
                            return Ok(columns);
                        }
                        match names {
                            Some(ref n) => {
                                if n.len() == 0 {
                                    return Err(no_columns());
                                }
                                n.clone()
                            }
                            None => return Err(no_columns()),
                        }
                    } else {
                        got.unwrap()
                    };
                    let mut this: Vec[Lab] = Vec.new();
                    let mut this_unnamed: Vec[i64] = Vec.new();
                    for i in 0..line.len() {
                        if line[i].len() == 0 {
                            this.push(Lab.S(if have_mi { f"Unnamed: {i}_level_{level}" } else { f"Unnamed: {i}" }));
                            this_unnamed.push(i);
                        } else {
                            this.push(Lab.S(line[i].clone()));
                        }
                    }
                    if not have_mi {
                        let mut order: Vec[i64] = Vec.new();
                        for i in 0..this.len() {
                            if not int_in(this_unnamed, i) {
                                order.push(i);
                            }
                        }
                        for i in this_unnamed {
                            order.push(i);
                        }
                        let mut counts: Vec[(Vec[Lab], i64)] = Vec.new();
                        for i in order {
                            let old = vec![this[i].clone()];
                            let mut col = old.clone();
                            let mut cur = key_count(counts, col);
                            if cur > 0 {
                                while cur > 0 {
                                    set_key_count(mut counts, old, cur + 1);
                                    col = vec![Lab.S(f"{key_fstr(old)}.{cur}")];
                                    let mut present = false;
                                    for t in this {
                                        if lab_eq(t, col[0]) {
                                            present = true;
                                        }
                                    }
                                    if present {
                                        cur += 1;
                                    } else {
                                        cur = key_count(counts, col);
                                    }
                                }
                                self.carry_dtype(old, col);
                            }
                            this[i] = col[0].clone();
                            set_key_count(mut counts, col, cur + 1);
                        }
                    } else if hr == last {
                        let lc = this.len();
                        let ic = match self.index_col {
                            Some(ref v) => v.len(),
                            None => 0,
                        };
                        let uc = this_unnamed.len();
                        if (lc != uc and lc - ic > uc) or ic == 0 {
                            clear_buffer = false;
                            let mut nils: Vec[Lab] = Vec.new();
                            for _ in 0..lc {
                                nils.push(Lab.Nil);
                            }
                            this = nils;
                            let keep = self.buf[self.buf.len() - 1].clone();
                            self.buf = vec![keep];
                        }
                    }
                    for i in this_unnamed {
                        if let Lab.S(s) = this[i] {
                            self.unnamed.push(s.clone());
                        }
                    }
                    columns.push(this);
                    if columns.len() == 1 {
                        num_orig = columns[0].len();
                    }
                    level += 1;
                }
                if clear_buffer {
                    self.buf.clear();
                }
                match names {
                    Some(ref nm) => {
                        let first_line = self.next_line()?;
                        let len_first = match first_line {
                            Some(ref l) => l.len(),
                            None => 0,
                        };
                        if nm.len() > columns[0].len() and nm.len() > len_first {
                            return Err(names_mismatch());
                        }
                        if columns.len() > 1 {
                            return Err(py_err("TypeError", "Cannot pass names with multi-index columns"));
                        }
                        let labs = strs_to_labs(nm);
                        if self.usecols.is_some() {
                            let _ = self.handle_usecols(columns.clone(), labs, num_orig)?;
                        } else {
                            num_orig = nm.len();
                        }
                        let mut done = false;
                        if let Some(ref ci) = self.col_indices {
                            if nm.len() != ci.len() {
                                let mut row: Vec[Lab] = Vec.new();
                                for i in sorted_ints(ci) {
                                    if i >= labs.len() {
                                        return Err(index_error());
                                    }
                                    row.push(labs[i].clone());
                                }
                                columns = vec![row];
                                done = true;
                            }
                        }
                        if not done {
                            columns = vec![labs];
                        }
                    }
                    None => {
                        let key = columns[0].clone();
                        columns = self.handle_usecols(columns, key, num_orig)?;
                    }
                }
            }
            None => {
                let line = self.get_header_line()?;
                let ncols = line.len();
                num_orig = ncols;
                let empty_names = match names {
                    Some(ref n) => n.len() == 0,
                    None => true,
                };
                if empty_names {
                    let mut labs: Vec[Lab] = Vec.new();
                    for i in 0..ncols {
                        labs.push(Lab.I(i));
                    }
                    let key = labs.clone();
                    columns = self.handle_usecols(vec![labs], key, ncols)?;
                } else {
                    let nm = names.clone().unwrap();
                    let labs = strs_to_labs(nm);
                    let uc_len = match self.usecols {
                        Some(ref u) => Some(u.len()),
                        None => None,
                    };
                    match uc_len {
                        None => {
                            columns = self.handle_usecols(vec![labs.clone()], labs, ncols)?;
                            num_orig = nm.len();
                        }
                        Some(ul) => {
                            if nm.len() >= ncols {
                                columns = self.handle_usecols(vec![labs.clone()], labs, ncols)?;
                                num_orig = nm.len();
                            } else if nm.len() != ul {
                                return Err(names_mismatch());
                            } else {
                                columns = vec![labs.clone()];
                                let _ = self.handle_usecols(columns.clone(), labs, ncols)?;
                            }
                        }
                    }
                }
            }
        }
        self.num_orig = num_orig;
        Ok(columns)
    }

    // _clean_index_names: the names of the index columns and the index
    // columns as positions (a name not found stays a name).
    fn clean_index_names(ref self, cols: ref Vec[Vec[Lab]], index_col: ref Option[Vec[Ic]]) -> Result[(Option[Vec[Vec[Lab]]], Vec[Vec[Lab]], Option[Vec[Ic]]), PyErr] {
        let ic = match index_col {
            Some(ref v) => v.clone(),
            None => return Ok((None, cols.clone(), None)),
        };
        if cols.len() == 0 {
            let mut names: Vec[Vec[Lab]] = Vec.new();
            for _ in ic {
                names.push(vec![Lab.Nil]);
            }
            return Ok((Some(names), Vec.new(), Some(ic)));
        }
        let mut columns = cols.clone();
        let mut names: Vec[Vec[Lab]] = Vec.new();
        let mut out_ic = ic.clone();
        for i in 0..ic.len() {
            match ic[i] {
                Ic.S(ref c) => {
                    names.push(key_of(c));
                    let mut j: i64 = 0;
                    while j < cols.len() {
                        if key_eq(cols[j], key_of(c)) {
                            out_ic[i] = Ic.I(j);
                            let mut k: i64 = 0;
                            while k < columns.len() and not key_eq(columns[k], key_of(c)) {
                                k += 1;
                            }
                            if k < columns.len() {
                                let _ = columns.remove(k);
                            }
                            break;
                        }
                        j += 1;
                    }
                }
                Ic.I(c) => {
                    let at = py_index(c, cols.len())?;
                    let name = cols[at].clone();
                    let mut k: i64 = 0;
                    while k < columns.len() and not key_eq(columns[k], name) {
                        k += 1;
                    }
                    if k >= columns.len() {
                        return Err(py_err("ValueError", "list.remove(x): x not in list"));
                    }
                    let _ = columns.remove(k);
                    names.push(name);
                }
            }
        }
        for i in 0..names.len() {
            if names[i].len() == 1 {
                if let Lab.S(ref s) = names[i][0] {
                    if str_in(self.unnamed, s) {
                        names[i] = vec![Lab.Nil];
                    }
                }
            }
        }
        Ok((Some(names), columns, Some(out_ic)))
    }

    // _extract_multi_indexer_columns: with several header rows, the
    // tuples, the index names from the last row, and the level names.
    fn extract_mi(mut ref self, header0: own Vec[Vec[Lab]]) -> Result[Vec[Vec[Lab]], PyErr] {
        let mut header = header0;
        if header.len() < 2 {
            let mut names: Vec[Vec[Lab]] = Vec.new();
            for l in header[0] {
                names.push(vec![l.clone()]);
            }
            return Ok(names);
        }
        let mut ic: Vec[i64] = Vec.new();
        if let Some(ref v) = self.index_col {
            for c in v {
                if let Ic.I(n) = c {
                    ic.push(n);
                }
            }
        }
        let idx_row = header.pop().unwrap();
        let mut idx_keys: Vec[Vec[Lab]] = Vec.new();
        for l in idx_row {
            idx_keys.push(vec![l.clone()]);
        }
        let (n0, _, _) = self.clean_index_names(idx_keys, self.index_col)?;
        self.index_names = n0;
        let field_count = header[0].len();
        for r in header {
            if r.len() != field_count {
                return Err(py_err("ParserError", "Header rows must have an equal number of columns."));
            }
        }
        let mut names: Vec[Vec[Lab]] = Vec.new();
        for i in 0..field_count {
            if not int_in(ic, i) {
                let mut t: Vec[Lab] = Vec.new();
                for r in header {
                    t.push(r[i].clone());
                }
                names.push(t);
            }
        }
        for c in sorted_ints(ic) {
            let at = if c > names.len() { names.len() } else { c };
            names.insert(at, vec![Lab.I(c)]);
        }
        let mut col_names: Vec[Lab] = Vec.new();
        for r in header {
            if ic.len() > 0 {
                let l = r[ic[0]].clone();
                let keep = match l {
                    Lab.Nil => false,
                    Lab.S(ref s) => not str_in(self.unnamed, s),
                    _ => true,
                };
                col_names.push(if keep { l } else { Lab.Nil });
            } else {
                col_names.push(Lab.Nil);
            }
        }
        self.col_names = Some(col_names);
        Ok(names)
    }

    // _get_index_name: an index named on its own row, an implicit index
    // (more fields than names), or the index columns asked for.
    fn get_index_name(mut ref self) -> Result[Option[Vec[Vec[Lab]]], PyErr] {
        let mut columns = self.orig_names.clone();
        let line = if self.header.is_none() {
            Some(self.get_header_line()?)
        } else {
            self.next_line()?
        };
        let next = self.next_line()?;
        let mut implicit: i64 = 0;
        if let Some(ref l) = line {
            if not self.index_false {
                implicit = l.len() - self.num_orig;
            }
            if let Some(ref nl) = next {
                if self.header.is_some() and not self.index_false and nl.len() == l.len() + self.num_orig {
                    let mut ic: Vec[Ic] = Vec.new();
                    for i in 0..l.len() {
                        ic.push(Ic.I(i));
                    }
                    self.index_col = Some(ic);
                    let rest: Vec[Vec[String]] = self.buf[1..].to_vec();
                    self.buf = rest;
                    let mut k = l.len();
                    while k > 0 {
                        k -= 1;
                        columns.insert(0, key_of(l[k]));
                    }
                    self.orig_names = columns.clone();
                    self.columns = columns.clone();
                    self.num_orig = columns.len();
                    return Ok(Some(strs_to_keys(l)));
                }
            }
        }
        self.columns = columns.clone();
        if implicit > 0 {
            self.implicit_index = true;
            if self.index_col.is_none() {
                let mut ic: Vec[Ic] = Vec.new();
                for i in 0..implicit {
                    ic.push(Ic.I(i));
                }
                self.index_col = Some(ic);
            }
            return Ok(None);
        }
        let (names, _, ic) = self.clean_index_names(columns, self.index_col)?;
        self.index_col = ic;
        Ok(names)
    }

    // _set_no_thousand_columns: the columns a non-numeric dtype keeps
    // out of the thousands and decimal replacement.
    fn set_no_thousands(mut ref self) -> Result[(), PyErr] {
        let ci = self.col_indices.clone().unwrap();
        let any = match self.dtype {
            Dt.NoDt => false,
            Dt.All(_) => true,
            Dt.Map(ref m) => m.len() > 0,
        };
        if self.columns.len() == 0 or not any {
            return Ok(());
        }
        if ci.len() != self.columns.len() {
            let how = if self.columns.len() < ci.len() { "shorter" } else { "longer" };
            return Err(py_err("ValueError", f"zip() argument 2 is {how} than argument 1"));
        }
        for k in 0..ci.len() {
            match self.dtype {
                Dt.All(ref t) => {
                    if not is_numeric_dtype(t) {
                        self.no_thousands.push(ci[k]);
                    }
                }
                Dt.Map(_) => {
                    if let Some(t) = dtype_of(self.dtype, self.columns[k]) {
                        if not is_numeric_dtype(t) or is_bool_dtype(t) {
                            self.no_thousands.push(ci[k]);
                        }
                    }
                }
                Dt.NoDt => {}
            }
        }
        Ok(())
    }

    fn remove_skipped(ref self, rows: own Vec[Vec[String]]) -> Vec[Vec[String]] {
        if self.skip.len() == 0 {
            return rows;
        }
        let mut out: Vec[Vec[String]] = Vec.new();
        let mut i: i64 = 0;
        for r in rows.into_iter() {
            if not self.skipped(i + self.pos) {
                out.push(r);
            }
            i += 1;
        }
        out
    }

    // _search_replace_num_columns.
    fn replace_num(ref self, lines: own Vec[Vec[String]], search: ref Vec[i64], replace: Str) -> Vec[Vec[String]] {
        let srch = to_string(search);
        let mut out: Vec[Vec[String]] = Vec.new();
        for line in lines.into_iter() {
            let mut rl: Vec[String] = Vec.new();
            let mut i: i64 = 0;
            for x in line.into_iter() {
                let hit = find_cps(cps_of(x), search) >= 0 and not int_in(self.no_thousands, i) and num_match(cps_of(py_strip(x)), self.thousands, self.decimal[0]);
                if hit {
                    rl.push(replace_all(x, srch, replace));
                } else {
                    rl.push(x);
                }
                i += 1;
            }
            out.push(rl);
        }
        out
    }

    // _get_lines: the buffer and then `rows` more rows (all of them
    // without a count) that skiprows keeps; None where it raises
    // StopIteration.
    fn get_lines(mut ref self, rows0: Option[i64]) -> Result[Option[Vec[Vec[String]]], PyErr] {
        let mut lines: Vec[Vec[String]] = self.buf.clone();
        let mut from_buf: Option[Vec[Vec[String]]] = None;
        let mut rows = rows0;
        if let Some(r) = rows0 {
            if self.buf.len() >= r {
                let head: Vec[Vec[String]] = self.buf[..r].to_vec();
                let tail: Vec[Vec[String]] = self.buf[r..].to_vec();
                from_buf = Some(head);
                self.buf = tail;
            } else {
                rows = Some(r - self.buf.len());
            }
        }
        match from_buf {
            Some(h) => lines = h,
            None => {
                let mut new_rows: Vec[Vec[String]] = Vec.new();
                let mut stopped = false;
                let mut len_new: i64 = 0;
                match rows {
                    Some(r) => {
                        let mut row_index: i64 = 0;
                        let mut row_ct: i64 = 0;
                        let offset = self.pos;
                        while row_ct < r {
                            let row = match self.rd.next()? {
                                Some(x) => x,
                                None => {
                                    stopped = true;
                                    break;
                                }
                            };
                            if not self.skipped(offset + row_index) {
                                row_ct += 1;
                            }
                            row_index += 1;
                            new_rows.push(row);
                        }
                        len_new = new_rows.len();
                    }
                    None => {
                        let mut n: i64 = 0;
                        loop {
                            let got = self.next_iter_line(self.pos + n + 1)?;
                            n += 1;
                            match got {
                                Some(Some(x)) => new_rows.push(x),
                                Some(None) => {}
                                None => break,
                            }
                        }
                        len_new = new_rows.len();
                        stopped = true;
                    }
                }
                let kept = self.remove_skipped(new_rows);
                for r in kept.into_iter() {
                    lines.push(r);
                }
                if stopped and lines.len() == 0 {
                    return Ok(None);
                }
                self.pos += len_new;
                self.buf.clear();
            }
        }
        if self.skipfooter > 0 {
            let keep = if lines.len() > self.skipfooter { lines.len() - self.skipfooter } else { 0 };
            let cut: Vec[Vec[String]] = lines[..keep].to_vec();
            lines = cut;
        }
        let mut out: Vec[Vec[String]] = Vec.new();
        for l in lines.into_iter() {
            let c = self.check_comments(l);
            if not self.skip_blank or py_keep(c) {
                out.push(c);
            }
        }
        if let Some(t) = self.thousands.clone() {
            out = self.replace_num(out, t, "");
        }
        if to_string(self.decimal) != "." {
            let d = self.decimal.clone();
            out = self.replace_num(out, d, ".");
        }
        Ok(Some(out))
    }
}

fn no_columns() -> PyErr {
    py_err("EmptyDataError", "No columns to parse from file")
}

fn names_mismatch() -> PyErr {
    py_err("ValueError", "Number of passed names did not match number of header fields in the file")
}

fn strs_to_keys(v: ref Vec[String]) -> Vec[Vec[Lab]] {
    let mut out: Vec[Vec[Lab]] = Vec.new();
    for s in v {
        out.push(key_of(s));
    }
    out
}

// PythonParser._remove_empty_lines keeps a row of two fields or more,
// or of one that is not blank.
fn py_keep(line: ref Vec[String]) -> bool {
    line.len() > 1 or (line.len() == 1 and py_strip(line[0]).len() > 0)
}

fn is_line_empty(line: ref Vec[String]) -> bool {
    for x in line {
        if x.len() > 0 {
            return false;
        }
    }
    true
}

// _check_for_bom: a byte-order mark at the start of the first field
// goes, with the quotes after it.
fn check_for_bom(line: own Vec[String], quotechar: i64) -> Result[Vec[String], PyErr] {
    if line.len() == 0 {
        return Ok(line);
    }
    let f = cps_of(line[0]);
    if f.len() == 0 or f[0] != 0xFEFF {
        return Ok(line);
    }
    let mut new: Vec[i64] = Vec.new();
    if f.len() > 1 and f[1] == quotechar {
        let mut end: i64 = -1;
        for k in 2..f.len() {
            if end < 0 and f[k] == quotechar {
                end = k;
            }
        }
        if end < 0 {
            return Err(py_err("ValueError", "substring not found"));
        }
        new = slice(f, 2, end);
        if f.len() > end + 1 {
            push_all(mut new, slice(f, end + 1, f.len()));
        }
    } else {
        new = slice(f, 1, f.len());
    }
    let mut out = line;
    out[0] = to_string(new);
    Ok(out)
}
// ------------------------------------------------------------ reading a chunk

// A DataFrame as to_csv needs it.
struct Frame {
    cols: Vec[Vec[Lab]],
    mi: bool,
    col_names: Vec[Lab],
    data: Vec[Col],
    index: Vec[Col],
    index_names: Vec[Vec[Lab]],
    nrows: i64,
    start: i64,
}

// An empty column of a dtype, as Series([], dtype=...) makes it.
fn empty_col(kind: ref Option[String]) -> Col {
    match kind {
        None => Col.Obj(Vec.new()),
        Some(k) => {
            if k == "int64" {
                Col.Int(Vec.new())
            } else if k == "float64" {
                Col.Float(Vec.new())
            } else if k == "bool" {
                Col.Bool(Vec.new())
            } else if k == "category" {
                Col.Cat(Vec.new())
            } else if k == "str" {
                Col.Str(Vec.new())
            } else if k == "string" {
                Col.NStr(Vec.new())
            } else if k == "Int64" {
                Col.NInt(Vec.new())
            } else if k == "Float64" {
                Col.NFloat(Vec.new())
            } else if k == "boolean" {
                Col.NBool(Vec.new())
            } else {
                Col.Obj(Vec.new())
            }
        }
    }
}

fn nas(n: i64) -> Vec[Val] {
    let mut v: Vec[Val] = Vec.new();
    for _ in 0..n {
        v.push(Val.Na);
    }
    v
}

impl Engine {
    // _rows_to_cols: the rows as columns, short rows padded with NaN; a
    // row with too many fields is an error, a warning or dropped, as
    // on_bad_lines says. Also the number of rows kept.
    fn rows_to_cols(mut ref self, content0: own Vec[Vec[String]]) -> Result[(Vec[Vec[Val]], i64), PyErr] {
        let mut col_len = self.num_orig;
        let nidx = match self.index_col {
            Some(ref v) => v.len(),
            None => 0,
        };
        if self.implicit_index {
            col_len += nidx;
        }
        let mut max_len: i64 = 0;
        for r in content0 {
            if r.len() > max_len {
                max_len = r.len();
            }
        }
        let mut content = content0;
        if max_len > col_len and not self.index_false and self.usecols.is_none() {
            let n = content.len();
            let mut bad: Vec[(i64, i64)] = Vec.new();
            let mut kept: Vec[Vec[String]] = Vec.new();
            let mut i: i64 = 0;
            for r in content.into_iter() {
                if r.len() > col_len {
                    if self.on_bad != 2 {
                        bad.push((self.pos - (n - i + self.skipfooter), r.len()));
                        if self.on_bad == 0 {
                            break;
                        }
                    }
                } else {
                    kept.push(r);
                }
                i += 1;
            }
            content = kept;
            let multi = match self.delimiter {
                Some(ref d) => cps_of(d).len() > 1 and self.quoting != QUOTE_NONE,
                None => false,
            };
            for (row_num, actual) in bad {
                let mut msg = f"Expected {col_len} fields in line {row_num + 1}, saw {actual}";
                if multi {
                    msg.push_str(". Error could possibly be due to quotes being ignored when a multi-char delimiter is used.");
                }
                self.alert(msg, row_num + 1)?;
            }
            max_len = 0;
            for r in content {
                if r.len() > max_len {
                    max_len = r.len();
                }
            }
        }
        let width = if max_len > col_len { max_len } else { col_len };
        let mut cols: Vec[Vec[Val]] = Vec.new();
        for j in 0..width {
            let mut c: Vec[Val] = Vec.new();
            for r in content {
                c.push(if j < r.len() { Val.S(r[j].clone()) } else { Val.Na });
            }
            cols.push(c);
        }
        let picked = match self.usecols {
            Some(ref u) => u.len() > 0,
            None => false,
        };
        if picked {
            let ci = self.col_indices.clone().unwrap();
            let mut out: Vec[Vec[Val]] = Vec.new();
            let mut i: i64 = 0;
            for c in cols.into_iter() {
                let keep = if self.implicit_index { i < nidx or int_in(ci, i - nidx) } else { int_in(ci, i) };
                if keep {
                    out.push(c);
                }
                i += 1;
            }
            return Ok((out, content.len()));
        }
        Ok((cols, content.len()))
    }

    // _get_empty_meta: the columns and index levels of a frame with no
    // rows, typed by dtype.
    fn empty_meta(ref self, names: own Vec[Vec[Lab]], start: i64) -> Result[Frame, PyErr] {
        let mut columns = names;
        let mut index: Vec[Col] = Vec.new();
        let mut inames: Vec[Vec[Lab]] = Vec.new();
        if let (Some(ic), Some(ns)) = (self.index_col.clone(), self.index_names.clone()) {
            for n in ns {
                index.push(empty_col(dtype_of(self.dtype, n)));
                inames.push(n.clone());
            }
            let mut pos: Vec[i64] = Vec.new();
            for c in ic {
                match c {
                    Ic.I(n) => pos.push(n),
                    Ic.S(_) => return Err(py_err("TypeError", "'<' not supported between instances of 'str' and 'int'")),
                }
            }
            let s = sorted_ints(pos);
            for i in 0..s.len() {
                let at = py_index(s[i] - i, columns.len())?;
                let _ = columns.remove(at);
            }
        }
        let mut data: Vec[Col] = Vec.new();
        for c in columns {
            data.push(empty_col(dtype_of(self.dtype, c)));
        }
        let mi = potential_mi(columns, None);
        let cn = self.level_names(columns);
        Ok(Frame { cols: columns, mi: mi, col_names: cn, data: data, index: index, index_names: inames, nrows: 0, start: start })
    }

    fn level_names(ref self, columns: ref Vec[Vec[Lab]]) -> Vec[Lab] {
        match self.col_names {
            Some(ref c) => c.clone(),
            None => {
                let levels = if columns.len() > 0 { columns[0].len() } else { 0 };
                let mut v: Vec[Lab] = Vec.new();
                for _ in 0..levels {
                    v.push(Lab.Nil);
                }
                v
            }
        }
    }

    // _agg_index: the index columns, each through _infer_types and the
    // dtype its name is given.
    fn agg_index(ref self, arrays: own Vec[Vec[Val]]) -> Result[(Vec[Col], Vec[Vec[Lab]]), PyErr] {
        let mut out: Vec[Col] = Vec.new();
        let mut names: Vec[Vec[Lab]] = Vec.new();
        if let Some(ref ns) = self.index_names {
            if ns.len() != arrays.len() {
                let how = if ns.len() < arrays.len() { "shorter" } else { "longer" };
                return Err(py_err("ValueError", f"zip() argument 2 is {how} than argument 1"));
            }
        }
        let mut i: i64 = 0;
        for arr in arrays.into_iter() {
            let name = match self.index_names {
                Some(ref ns) => ns[i].clone(),
                None => vec![Lab.Nil],
            };
            let na = self.na.for_index(name);
            let cast = match self.index_names {
                Some(_) => match self.dtype {
                    Dt.Map(_) => dtype_of(self.dtype, name),
                    _ => None,
                },
                None => None,
            };
            let try_num_bool = match cast {
                Some(ref k) => not is_string_dtype(k),
                None => true,
            };
            let (c, _) = infer_types(arr, na, cast.is_none() and self.backend, try_num_bool, self.bools);
            let c2 = match cast {
                Some(ref k) => {
                    if has_dtype(c, k) { c } else { cast_col(c, k, key_fstr(name))? }
                }
                None => c,
            };
            out.push(c2);
            names.push(name);
            i += 1;
        }
        Ok((out, names))
    }

    // read(rows): the next `rows` rows as a frame; None where the reader
    // is done (StopIteration).
    fn read(mut ref self, rows: Option[i64], start: i64) -> Result[Option[Frame], PyErr] {
        let content = match self.get_lines(rows)? {
            Some(c) => c,
            None => {
                if self.first_chunk {
                    Vec.new()
                } else {
                    return Ok(None);
                }
            }
        };
        self.first_chunk = false;
        let names = dedup_names(self.orig_names, potential_mi(self.orig_names, self.index_col));
        if content.len() == 0 {
            return Ok(Some(self.empty_meta(names, start)?));
        }
        let mut (alldata, nrows) = self.rows_to_cols(content)?;
        // _check_data_length
        let no_index = match self.index_col {
            Some(ref v) => v.len() == 0,
            None => true,
        };
        if no_index and names.len() != alldata.len() and names.len() > 0 {
            let mut fine = false;
            if names.len() + 1 == alldata.len() {
                fine = true;
                for v in alldata[alldata.len() - 1] {
                    match v {
                        Val.Na => {}
                        Val.S(ref s) => {
                            if s.len() > 0 {
                                fine = false;
                            }
                        }
                        _ => fine = false,
                    }
                }
            }
            if not fine {
                self.log.push_str("warn: Length of header or names does not match length of data. This leads to a loss of data with index_col=False.\n");
            }
        }
        // _exclude_implicit_index and _convert_data
        let offset = if self.implicit_index {
            match self.index_col {
                Some(ref v) => v.len(),
                None => 0,
            }
        } else {
            0
        };
        let mut conv: Vec[(Vec[Lab], Col)] = Vec.new();
        for i in 0..names.len() {
            if i < alldata.len() {
                if i + offset >= alldata.len() {
                    return Err(index_error());
                }
                let na = self.na.for_col(names[i]);
                let cast = dtype_of(self.dtype, names[i]);
                let c = convert_col(alldata[i + offset].clone(), na, cast, self.backend, key_fstr(names[i]), self.bools)?;
                conv.push((names[i].clone(), c));
            }
        }
        // _make_index
        let mut columns = names.clone();
        let mut index: Vec[Col] = Vec.new();
        let mut inames: Vec[Vec[Lab]] = Vec.new();
        if let Some(ic) = self.index_col.clone() {
            if ic.len() > 0 {
                let mut to_remove: Vec[i64] = Vec.new();
                let mut arrays: Vec[Vec[Val]] = Vec.new();
                for c in ic {
                    match c {
                        Ic.S(s) => return Err(py_err("ValueError", f"Index {s} invalid")),
                        Ic.I(n) => {
                            let at = py_index(n, alldata.len())?;
                            to_remove.push(n);
                            arrays.push(alldata[at].clone());
                        }
                    }
                }
                let s = sorted_ints(to_remove);
                let mut k = s.len();
                while k > 0 {
                    k -= 1;
                    let at = py_index(s[k], alldata.len())?;
                    let _ = alldata.remove(at);
                    if not self.implicit_index {
                        let ct = py_index(s[k], columns.len())?;
                        let _ = columns.remove(ct);
                    }
                }
                let (cols, ns) = self.agg_index(arrays)?;
                index = cols;
                inames = ns;
            }
        }
        let mut data: Vec[Col] = Vec.new();
        for k in columns {
            let mut found: Option[Col] = None;
            for (n, c) in conv {
                if found.is_none() and key_eq(n, k) {
                    found = Some(c.clone());
                }
            }
            data.push(match found {
                Some(c) => c,
                None => Col.Obj(nas(nrows)),
            });
        }
        let mi = potential_mi(columns, None);
        let cn = self.level_names(columns);
        Ok(Some(Frame { cols: columns, mi: mi, col_names: cn, data: data, index: index, index_names: inames, nrows: nrows, start: start }))
    }
}

// ------------------------------------------------------------ to_csv

fn csv_field(s: Str) -> String {
    if has_byte(s, b',') or has_byte(s, b'"') or has_byte(s, b'\n') or has_byte(s, b'\r') {
        f"\"{replace_all(s, "\"", "\"\"")}\""
    } else {
        s.to_string()
    }
}

fn csv_row(fields: ref Vec[String]) -> String {
    if fields.len() == 1 and fields[0].len() == 0 {
        return "\"\"\n".to_string();
    }
    let mut parts: Vec[String] = Vec.new();
    for f in fields {
        parts.push(csv_field(f));
    }
    f"{join(parts, ",")}\n"
}

fn is_falsy(k: ref Vec[Lab]) -> bool {
    if k.len() != 1 {
        return false;
    }
    match k[0] {
        Lab.Nil => true,
        Lab.I(n) => n == 0,
        Lab.S(s) => s.len() == 0,
    }
}

// shape, dtypes and df.head(n).to_csv(lineterminator="\n").
fn frame_text(f: ref Frame, head: ref Option[i64]) -> String {
    let mut out = f"shape ({f.nrows}, {f.cols.len()})\n";
    for i in 0..f.cols.len() {
        out.push_str(f"  {key_repr(f.cols[i])}: {dtype_name(f.data[i])}\n");
    }
    let mut labels: Vec[String] = Vec.new();
    if f.index.len() == 0 {
        labels.push("".to_string());
    } else if f.index.len() == 1 {
        labels.push(key_csv(f.index_names[0]));
    } else {
        for n in f.index_names {
            labels.push(if is_falsy(n) { "".to_string() } else { key_csv(n) });
        }
    }
    if not f.mi {
        let mut row = labels.clone();
        for k in f.cols {
            row.push(key_csv(k));
        }
        out.push_str(csv_row(row));
    } else {
        let levels = if f.cols.len() > 0 { f.cols[0].len() } else { f.col_names.len() };
        for lv in 0..levels {
            let mut row: Vec[String] = Vec.new();
            row.push(if lv < f.col_names.len() { lab_csv(f.col_names[lv]) } else { "".to_string() });
            for _ in 1..labels.len() {
                row.push("".to_string());
            }
            for k in f.cols {
                row.push(lab_csv(k[lv]));
            }
            out.push_str(csv_row(row));
        }
        let mut any = false;
        for l in labels {
            if l.len() > 0 {
                any = true;
            }
        }
        if any {
            let mut row = labels.clone();
            for _ in f.cols {
                row.push("".to_string());
            }
            out.push_str(csv_row(row));
        }
    }
    let n = match head {
        Some(h) => if h < f.nrows { h } else { f.nrows },
        None => f.nrows,
    };
    for r in 0..n {
        let mut row: Vec[String] = Vec.new();
        if f.index.len() == 0 {
            row.push((f.start + r).to_string());
        } else {
            for c in f.index {
                row.push(cell_text(c, r));
            }
        }
        for c in f.data {
            row.push(cell_text(c, r));
        }
        out.push_str(csv_row(row));
    }
    out
}
// ------------------------------------------------------------ the job's arguments

fn int_arg(v: Str) -> Result[i64, PyErr] {
    match py_int(v) {
        Some(n) => Ok(n),
        None => Err(py_err("ValueError", f"invalid literal for int() with base 10: {py_repr(v)}")),
    }
}

fn ints_arg(v: Str) -> Result[Vec[i64], PyErr] {
    let mut out: Vec[i64] = Vec.new();
    for x in split_on(v, b',') {
        out.push(int_arg(x)?);
    }
    Ok(out)
}

fn all_digits(s: Str) -> bool {
    if s.len() == 0 {
        return false;
    }
    for b in s.bytes() {
        if not is_digit(b) {
            return false;
        }
    }
    true
}

// name_or_int in the oracle: digits are a position.
fn ic_arg(s: Str) -> Ic {
    if all_digits(s) {
        Ic.I(int_arg(s).unwrap_or(0))
    } else {
        Ic.S(s.to_string())
    }
}

fn bound_arg(s: Str) -> Result[Option[i64], PyErr] {
    if s.len() == 0 {
        return Ok(None);
    }
    Ok(Some(int_arg(s)?))
}

// The first `:` splits a `k:v` pair.
fn split_pair(s: Str) -> (String, String) {
    let b = to_bytes(s);
    let mut c: i64 = 0;
    while c < b.len() and b[c] != b':' {
        c += 1;
    }
    (byte_str(b, 0, c), byte_str(b, c + 1, b.len()))
}

fn default_opts() -> Opts {
    Opts {
        table: false,
        sep: Sep.Default,
        delimiter: None,
        dialect: None,
        quotechar: Some("\"".to_string()),
        escapechar: None,
        doublequote: true,
        skipinitialspace: false,
        quoting: QUOTE_MINIMAL,
        header: Hdr.Infer,
        names: None,
        usecols: None,
        index_col: None,
        index_col_list: false,
        index_false: false,
        index_true: false,
        skiprows: Vec.new(),
        skipfooter: 0,
        nrows: None,
        chunksize: None,
        comment: None,
        thousands: None,
        decimal: ".".to_string(),
        true_values: Vec.new(),
        false_values: Vec.new(),
        encoding: None,
        encoding_errors: "strict".to_string(),
        on_bad_lines: "error".to_string(),
        na_values: NaArg.Default,
        keep_default_na: true,
        na_filter: true,
        skip_blank_lines: true,
        dtype: Dt.NoDt,
        backend: None,
        head: None,
    }
}

// The keyword arguments the oracle builds from a job's `k=v` words.
fn parse_opts(words: ref Vec[String]) -> Result[Opts, PyErr] {
    let mut o = default_opts();
    for w in words {
        let b = to_bytes(w);
        let mut eq: i64 = 0;
        while eq < b.len() and b[eq] != b'=' {
            eq += 1;
        }
        let k = byte_str(b, 0, eq);
        let v = replace_all(replace_all(byte_str(b, eq + 1, b.len()), "{sp}", " "), "{tab}", "\t");
        if k == "fn" {
            o.table = v == "table";
        } else if k == "sep" {
            o.sep = if v == "None" { Sep.Sniff } else { Sep.Given(v.clone()) };
        } else if k == "delimiter" {
            o.delimiter = Some(v.clone());
        } else if k == "dialect" {
            o.dialect = Some(v.clone());
        } else if k == "quotechar" {
            o.quotechar = Some(v.clone());
        } else if k == "escapechar" {
            o.escapechar = Some(v.clone());
        } else if k == "doublequote" {
            o.doublequote = v == "True";
        } else if k == "skipinitialspace" {
            o.skipinitialspace = v == "True";
        } else if k == "quoting" {
            o.quoting = int_arg(v)?;
        } else if k == "nrows" {
            o.nrows = Some(int_arg(v)?);
        } else if k == "chunksize" {
            o.chunksize = Some(int_arg(v)?);
        } else if k == "skipfooter" {
            o.skipfooter = int_arg(v)?;
        } else if k == "header" {
            o.header = if v == "None" {
                Hdr.NoHeader
            } else if has_byte(v, b',') {
                Hdr.Many(ints_arg(v)?)
            } else {
                Hdr.One(int_arg(v)?)
            };
        } else if k == "names" {
            o.names = Some(split_on(v, b','));
        } else if k == "true_values" {
            o.true_values = split_on(v, b',');
        } else if k == "false_values" {
            o.false_values = split_on(v, b',');
        } else if k == "usecols" {
            let mut u: Vec[Ic] = Vec.new();
            for x in split_on(v, b',') {
                let c = ic_arg(x);
                let mut dup = false;
                for d in u {
                    if ic_eq(d, c) {
                        dup = true;
                    }
                }
                if not dup {
                    u.push(c);
                }
            }
            o.usecols = Some(u);
        } else if k == "index_col" {
            if v == "False" {
                o.index_false = true;
            } else if v == "True" {
                o.index_true = true;
            } else {
                let mut ic: Vec[Ic] = Vec.new();
                for x in split_on(v, b',') {
                    ic.push(ic_arg(x));
                }
                o.index_col_list = has_byte(v, b',');
                o.index_col = Some(ic);
            }
        } else if k == "skiprows" {
            if v.starts_with("[") {
                o.skiprows = ints_arg(v[1..v.len() - 1])?;
            } else if has_byte(v, b',') {
                o.skiprows = ints_arg(v)?;
            } else {
                let n = int_arg(v)?;
                o.skiprows = Vec.new();
                for i in 0..n {
                    o.skiprows.push(i);
                }
            }
        } else if k == "dtype" {
            if has_byte(v, b':') {
                let mut m: Vec[(String, String)] = Vec.new();
                for p in split_on(v, b',') {
                    let (c, t) = split_pair(p);
                    let mut set = false;
                    for i in 0..m.len() {
                        if m[i].0 == c {
                            m[i].1 = t.clone();
                            set = true;
                        }
                    }
                    if not set {
                        m.push((c, t));
                    }
                }
                o.dtype = Dt.Map(m);
            } else {
                o.dtype = Dt.All(v.clone());
            }
        } else if k == "na_values" {
            o.na_values = NaArg.List(split_on(v, b','));
        } else if k == "keep_default_na" {
            o.keep_default_na = v == "True";
        } else if k == "na_filter" {
            o.na_filter = v == "True";
        } else if k == "skip_blank_lines" {
            o.skip_blank_lines = v == "True";
        } else if k == "head" {
            o.head = Some(int_arg(v)?);
        } else if k == "comment" {
            o.comment = Some(v.clone());
        } else if k == "thousands" {
            o.thousands = Some(v.clone());
        } else if k == "decimal" {
            o.decimal = v.clone();
        } else if k == "encoding" {
            o.encoding = Some(v.clone());
        } else if k == "encoding_errors" {
            o.encoding_errors = v.clone();
        } else if k == "on_bad_lines" {
            o.on_bad_lines = v.clone();
        } else if k == "dtype_backend" {
            o.backend = Some(v.clone());
        } else {
            return Err(py_err("TypeError", f"read_csv() got an unexpected keyword argument '{k}'"));
        }
    }
    Ok(o)
}

// ------------------------------------------------------------ read_fwf

fn na_spec(o: ref Opts) -> NaSpec {
    match o.na_values {
        NaArg.Default => NaSpec { filter: o.na_filter, keep_default_na: o.keep_default_na, all: na_set(Vec.new(), o.keep_default_na), by_col: None },
        NaArg.List(ref v) => NaSpec { filter: o.na_filter, keep_default_na: o.keep_default_na, all: na_set(v, o.keep_default_na), by_col: None },
        NaArg.Map(ref m) => {
            let mut by: Vec[(String, NaSet)] = Vec.new();
            for (c, v) in m {
                by.push((c.clone(), na_set(v, o.keep_default_na)));
            }
            NaSpec { filter: o.na_filter, keep_default_na: o.keep_default_na, all: empty_na(), by_col: Some(by) }
        }
    }
}

fn opt_text(v: ref Option[String]) -> String {
    match v {
        Some(s) => s.clone(),
        None => "None".to_string(),
    }
}

fn bool_text(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

fn conflict(param: Str, provided: Str, dialect_val: Str) -> String {
    f"warn: Conflicting values for '{param}': '{provided}' was provided, but the dialect specifies '{dialect_val}'. Using the dialect-specified value.\n"
}

// The text of the file, decoded on its first read.
struct Text {
    bytes: Vec[u8],
    codec: i64,
    errors: String,
    lines: Option[Vec[Vec[i64]]],
}

impl Text {
    fn lines(mut ref self) -> Result[Vec[Vec[i64]], PyErr] {
        if let Some(ref l) = self.lines {
            return Ok(l.clone());
        }
        let t = decode(self.bytes, self.codec, self.errors)?;
        let l = text_lines(t);
        self.lines = Some(l.clone());
        Ok(l)
    }
}

// The lines of a string as StringIO iterates them: split after \n only.
fn lf_lines(s: ref Vec[i64]) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    for c in s {
        cur.push(c);
        if c == 10 {
            out.push(cur);
            cur = Vec.new();
        }
    }
    if cur.len() > 0 {
        out.push(cur);
    }
    out
}

// pd.read_csv(path, engine="python", ...) or pd.read_table: its own
// checks, TextFileReader's, the file, the parser's __init__, then read()
// once or a chunk at a time. What it prints goes to `out`, warnings
// included, so the output before an error stays.
fn read_csv(path: Str, o: ref Opts, out: mut ref String) -> Result[(), PyErr] {
    // _refine_defaults_read
    let delim_default = if o.table { "\t" } else { "," };
    let sep_given = match o.sep {
        Sep.Default => false,
        _ => true,
    };
    let sep_override = o.dialect.is_some() and o.delimiter.is_none() and match o.sep {
        Sep.Default => true,
        Sep.Given(ref s) => s == delim_default,
        Sep.Sniff => false,
    };
    if let Some(ref d) = o.delimiter {
        if d.len() > 0 and sep_given {
            return Err(py_err("ValueError", "Specified a sep and a delimiter; you can only specify one."));
        }
    }
    let mut delimiter: Option[String] = match o.delimiter {
        Some(ref d) => Some(d.clone()),
        None => match o.sep {
            Sep.Default => Some(delim_default.to_string()),
            Sep.Sniff => None,
            Sep.Given(ref s) => Some(s.clone()),
        },
    };
    if let Some(ref d) = delimiter {
        if d == "\n" {
            return Err(py_err("ValueError", "Specified \\n as separator or delimiter. This forces the python engine which does not accept a line terminator. Hence it is not allowed to use the line terminator as separator."));
        }
    }
    let on_bad = if o.on_bad_lines == "error" {
        0
    } else if o.on_bad_lines == "warn" {
        1
    } else if o.on_bad_lines == "skip" {
        2
    } else {
        return Err(py_err("ValueError", f"Argument {o.on_bad_lines} is invalid for on_bad_lines"));
    };
    let backend = match o.backend {
        Some(ref b) => {
            if b != "numpy_nullable" and b != "pyarrow" {
                return Err(py_err("ValueError", f"dtype_backend {b} is invalid, only 'numpy_nullable' and 'pyarrow' are allowed."));
            }
            true
        }
        None => false,
    };
    // _read
    if let Some(c) = o.chunksize {
        if c < 1 {
            return Err(py_err("ValueError", "'chunksize' must be an integer >=1"));
        }
    }
    if let Some(n) = o.nrows {
        if n < 0 {
            return Err(py_err("ValueError", "'nrows' must be an integer >=0"));
        }
    }
    if let Some(ref names) = o.names {
        for i in 0..names.len() {
            for j in 0..i {
                if names[i] == names[j] {
                    return Err(py_err("ValueError", "Duplicate names are not allowed."));
                }
            }
        }
    }
    // TextFileReader
    if o.skipfooter != 0 {
        if o.chunksize.is_some() {
            return Err(py_err("ValueError", "'skipfooter' not supported for iteration"));
        }
        if let Some(n) = o.nrows {
            if n != 0 {
                return Err(py_err("ValueError", "'skipfooter' not supported with 'nrows'"));
            }
        }
    }
    let mut quotechar = o.quotechar.clone();
    let mut escapechar = o.escapechar.clone();
    let mut doublequote = o.doublequote;
    let mut skipinitialspace = o.skipinitialspace;
    let mut quoting = o.quoting;
    if let Some(ref name) = o.dialect {
        // _extract_dialect, then _merge_with_dialect_properties
        let (dd, dq) = if name == "excel" {
            (",", QUOTE_MINIMAL)
        } else if name == "excel-tab" {
            ("\t", QUOTE_MINIMAL)
        } else if name == "unix" {
            (",", 1)
        } else {
            return Err(py_err("ValueError", f"Invalid dialect {name} provided"));
        };
        let dt = delimiter.clone();
        if let Some(ref p) = dt {
            if p != dd and not sep_override {
                out.push_str(conflict("delimiter", p, dd));
            }
        }
        if not doublequote {
            out.push_str(conflict("doublequote", "False", "True"));
        }
        if escapechar.is_some() {
            out.push_str(conflict("escapechar", opt_text(escapechar), "None"));
        }
        if skipinitialspace {
            out.push_str(conflict("skipinitialspace", "True", "False"));
        }
        let qt = opt_text(quotechar);
        if qt != "\"" {
            out.push_str(conflict("quotechar", qt, "\""));
        }
        if quoting != QUOTE_MINIMAL and quoting != dq {
            out.push_str(conflict("quoting", quoting.to_string(), dq.to_string()));
        }
        delimiter = Some(dd.to_string());
        doublequote = true;
        escapechar = None;
        skipinitialspace = false;
        quotechar = Some("\"".to_string());
        quoting = dq;
    }
    let header: Option[Vec[i64]] = match o.header {
        Hdr.Infer => if o.names.is_some() { None } else { Some(vec![0]) },
        Hdr.NoHeader => None,
        Hdr.One(n) => Some(vec![n]),
        Hdr.Many(ref v) => Some(v.clone()),
    };
    let header_list = match o.header {
        Hdr.Many(_) => true,
        _ => false,
    };
    // _clean_options
    if o.index_true {
        return Err(py_err("ValueError", "The value of index_col couldn't be 'True'"));
    }
    match o.header {
        Hdr.One(n) => {
            if n < 0 {
                return Err(py_err("ValueError", "Passing negative integer to header is invalid. For no header, use header=None instead"));
            }
        }
        Hdr.Many(ref v) => {
            for x in v {
                if x < 0 {
                    return Err(py_err("ValueError", "cannot specify multi-index header with negative integers"));
                }
            }
        }
        _ => {}
    }
    // get_handle
    let enc = match o.encoding {
        Some(ref e) => e.clone(),
        None => "utf-8".to_string(),
    };
    let codec = codec_id(enc);
    if codec == 0 {
        return Err(py_err("LookupError", f"unknown encoding: {enc}"));
    }
    if not handler_known(o.encoding_errors) {
        return Err(py_err("LookupError", f"unknown error handler name {py_repr(o.encoding_errors)}"));
    }
    let bytes = match fs.read_bytes(path.to_string()) {
        Ok(b) => b,
        Err(_) => return Err(py_err("FileNotFoundError", f"[Errno 2] No such file or directory: {py_repr(path)}")),
    };
    let mut text = Text { bytes: bytes, codec: codec, errors: o.encoding_errors.clone(), lines: None };
    // ParserBase.__init__
    if header_list {
        let usecols_given = match o.usecols {
            Some(ref u) => u.len() > 0,
            None => false,
        };
        if usecols_given {
            return Err(py_err("ValueError", "cannot specify usecols when specifying a multi-index header"));
        }
        let names_given = match o.names {
            Some(ref n) => n.len() > 0,
            None => false,
        };
        if names_given {
            return Err(py_err("ValueError", "cannot specify names when specifying a multi-index header"));
        }
        if let Some(ref ic) = o.index_col {
            for c in ic {
                if let Ic.S(_) = c {
                    return Err(py_err("ValueError", "index_col must only contain integers of column positions when specifying a multi-index header"));
                }
            }
        }
    }
    let mut usecols_str = false;
    if let Some(ref u) = o.usecols {
        let mut strs = 0;
        for c in u {
            if let Ic.S(_) = c {
                strs += 1;
            }
        }
        if strs > 0 and strs < u.len() {
            return Err(py_err("ValueError", "'usecols' must either be list-like of all strings, all unicode, all integers or a callable."));
        }
        usecols_str = strs > 0;
    }
    if o.skipfooter < 0 {
        return Err(py_err("ValueError", "skipfooter cannot be negative"));
    }
    let thousands = match o.thousands {
        Some(ref t) => Some(cps_of(t)),
        None => None,
    };
    let qc = match quotechar {
        Some(ref q) => {
            let c = cps_of(q);
            if c.len() == 1 { c[0] } else { UNSET }
        }
        None => UNSET,
    };
    let mut p = Engine {
        rd: Src.Re(ReRd { lines: Vec.new(), at: 0, pattern: Vec.new(), prog: None }),
        buf: Vec.new(),
        pos: 0,
        line_pos: 0,
        skip: o.skiprows.clone(),
        skipfooter: o.skipfooter,
        comment: o.comment.clone(),
        skip_blank: o.skip_blank_lines,
        names: o.names.clone(),
        header: header.clone(),
        have_mi: header_list and match header {
            Some(ref h) => h.len() > 1,
            None => false,
        },
        index_col: o.index_col.clone(),
        usecols: o.usecols.clone(),
        usecols_str: usecols_str,
        col_indices: None,
        implicit_index: false,
        num_orig: 0,
        unnamed: Vec.new(),
        header_line: None,
        na: na_spec(o),
        dtype: o.dtype.clone(),
        backend: backend,
        thousands: thousands,
        decimal: cps_of(o.decimal),
        no_thousands: Vec.new(),
        orig_names: Vec.new(),
        columns: Vec.new(),
        index_names: None,
        col_names: None,
        first_chunk: true,
        delimiter: delimiter.clone(),
        quotechar: qc,
        quoting: quoting,
        index_false: o.index_false,
        on_bad: on_bad,
        bools: BoolVals { trues: o.true_values.clone(), falses: o.false_values.clone() },
        log: String.new(),
    };
    let r = run_parser(mut p, mut text, o, delimiter, quotechar, escapechar, doublequote, skipinitialspace, quoting, mut out);
    r
}

// PythonParser.__init__ from _make_reader on, then the reads. The
// warnings go to `out` as they come.
fn run_parser(p: mut ref Engine, text: mut ref Text, o: ref Opts, delimiter: ref Option[String], quotechar: ref Option[String], escapechar: ref Option[String], doublequote: bool, skipinitialspace: bool, quoting: i64, out: mut ref String) -> Result[(), PyErr] {
    let r = parse_file(mut p, mut text, o, delimiter, quotechar, escapechar, doublequote, skipinitialspace, quoting, mut out);
    out.push_str(p.log);
    p.log = String.new();
    r
}

fn flush(p: mut ref Engine, out: mut ref String) {
    out.push_str(p.log);
    p.log = String.new();
}

fn parse_file(p: mut ref Engine, text: mut ref Text, o: ref Opts, delimiter: ref Option[String], quotechar: ref Option[String], escapechar: ref Option[String], doublequote: bool, skipinitialspace: bool, quoting: i64, out: mut ref String) -> Result[(), PyErr] {
    // _make_reader
    let one = match delimiter {
        Some(d) => cps_of(d).len() == 1,
        None => true,
    };
    if one {
        match delimiter {
            Some(d) => {
                let mut at: i64 = 0;
                if p.skipped(p.pos) {
                    let lines = text.lines()?;
                    while p.skipped(p.pos) {
                        if at >= lines.len() {
                            break;
                        }
                        at += 1;
                        p.pos += 1;
                    }
                }
                let dia = make_dialect(cps_of(d)[0], quotechar, escapechar, doublequote, skipinitialspace, quoting)?;
                let lines = text.lines()?;
                p.rd = Src.Csv(CsvRd { d: dia, lines: lines, at: at, state: START_RECORD, fields: Vec.new(), field: Vec.new() });
            }
            None => {
                let lines = text.lines()?;
                let mut at: i64 = 0;
                let mut line: Vec[i64] = if lines.len() > 0 { lines[0].clone() } else { Vec.new() };
                at = 1;
                let mut kept = p.check_comments(vec![to_string(line)]);
                while p.skipped(p.pos) or kept.len() == 0 {
                    p.pos += 1;
                    line = if at < lines.len() { lines[at].clone() } else { Vec.new() };
                    at += 1;
                    kept = p.check_comments(vec![to_string(line)]);
                }
                let first = cps_of(kept[0]);
                p.pos += 1;
                p.line_pos += 1;
                let dl = sniff_delimiter(first)?;
                let dia = make_dialect(dl, quotechar, escapechar, doublequote, skipinitialspace, quoting)?;
                let mut one_rd = CsvRd { d: dia.clone(), lines: lf_lines(first), at: 0, state: START_RECORD, fields: Vec.new(), field: Vec.new() };
                loop {
                    match one_rd.next()? {
                        Some(r) => p.buf.push(r),
                        None => break,
                    }
                }
                let start = if at < lines.len() { at } else { lines.len() };
                p.rd = Src.Csv(CsvRd { d: dia, lines: lines, at: start, state: START_RECORD, fields: Vec.new(), field: Vec.new() });
            }
        }
    } else {
        let lines = text.lines()?;
        let pat = match delimiter {
            Some(d) => cps_of(d),
            None => Vec.new(),
        };
        p.rd = Src.Re(ReRd { lines: lines, at: 0, pattern: pat, prog: None });
    }
    // _infer_columns and the rest of __init__
    let columns = p.infer_columns()?;
    let names = p.extract_mi(columns)?;
    p.orig_names = names.clone();
    p.columns = names;
    let index_names = p.get_index_name()?;
    if p.index_names.is_none() {
        p.index_names = index_names;
    }
    if p.col_indices.is_none() {
        let mut ci: Vec[i64] = Vec.new();
        for i in 0..p.columns.len() {
            ci.push(i);
        }
        p.col_indices = Some(ci);
    }
    p.set_no_thousands()?;
    if p.decimal.len() != 1 {
        return Err(py_err("ValueError", "Only length-1 decimal markers supported"));
    }
    // TextFileReader.read / get_chunk
    match o.chunksize {
        None => {
            let f = match p.read(o.nrows, 0)? {
                Some(f) => f,
                None => return Err(py_err("StopIteration", "")),
            };
            flush(mut p, mut out);
            out.push_str(frame_text(f, o.head));
        }
        Some(size) => {
            let mut currow: i64 = 0;
            let mut k: i64 = 0;
            loop {
                let mut n = size;
                if let Some(limit) = o.nrows {
                    if currow >= limit {
                        break;
                    }
                    if limit - currow < n {
                        n = limit - currow;
                    }
                }
                let f = match p.read(Some(n), currow)? {
                    Some(f) => f,
                    None => break,
                };
                flush(mut p, mut out);
                currow += f.nrows;
                out.push_str(f"chunk {k}\n");
                out.push_str(frame_text(f, o.head));
                k += 1;
            }
            out.push_str("done\n");
        }
    }
    Ok(())
}

fn run_job(line: Str, out: mut ref String) -> Result[(), PyErr] {
    let w = split_on(line, b' ');
    if w.len() < 2 or w[0] != "read" {
        return Err(py_err("ValueError", f"unknown job {py_repr(line)}"));
    }
    let mut rest: Vec[String] = Vec.new();
    for i in 2..w.len() {
        rest.push(w[i].clone());
    }
    let o = parse_opts(rest)?;
    read_csv(f"data/{w[1]}", o, mut out)
}

// The transcript of one job.
fn transcript(line: Str) -> String {
    let mut t = f"$ {line}\n";
    let mut body = String.new();
    let r = run_job(line, mut body);
    t.push_str(body);
    if let Err(e) = r {
        t.push_str(f"! {e.kind}: {e.msg}\n");
    }
    t
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn main() {
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        eprintln(f"cannot create data: {e}");
        return;
    }
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    let jobs = match fs.read_to_string("data/jobs.txt".to_string()) {
        Ok(t) => t,
        Err(e) => {
            eprintln(f"cannot read jobs.txt: {e}");
            return;
        }
    };
    let mut lines: Vec[String] = Vec.new();
    for l in lines_of(jobs) {
        if l.len() > 0 {
            lines.push(l.clone());
        }
    }
    // Every job in a task of its own; the transcript prints in job order.
    let group = TaskGroup.new();
    let mut handles = Vec.new();
    for line in lines {
        handles.push(group.spawn(|| transcript(line)));
    }
    for h in handles.into_iter() {
        print(h.join());
    }
}


// ============================================================ data

// The files under data/, in name order.
fn write_data() -> Result[(), String] {
    put_bytes("data/blank.csv", unhex(file_0()))?;
    put_bytes("data/bom.csv", unhex(file_1()))?;
    put_bytes("data/cities.tsv", unhex(file_2()))?;
    put_bytes("data/claims.txt", unhex(file_3()))?;
    put_bytes("data/cr.csv", unhex(file_4()))?;
    put_bytes("data/empty.csv", unhex(file_5()))?;
    put_bytes("data/eof.csv", unhex(file_6()))?;
    put_bytes("data/feedback.csv", unhex(file_7()))?;
    put_bytes("data/feedback2.csv", unhex(file_8()))?;
    put_bytes("data/jobs.txt", unhex(file_9()))?;
    put_bytes("data/ls.txt", unhex(file_10()))?;
    put_bytes("data/mixed.csv", unhex(file_11()))?;
    put_bytes("data/movies.dat", unhex(file_12()))?;
    put_bytes("data/mysql.tsv", unhex(file_13()))?;
    put_bytes("data/nul.csv", unhex(file_14()))?;
    put_bytes("data/onecol.txt", unhex(file_15()))?;
    put_bytes("data/orders.csv", unhex(file_16()))?;
    put_bytes("data/psql.txt", unhex(file_17()))?;
    put_bytes("data/quoted.csv", unhex(file_18()))?;
    put_bytes("data/ratings.dat", unhex(file_19()))?;
    put_bytes("data/roles.csv", unhex(file_20()))?;
    put_bytes("data/services.md", unhex(file_21()))?;
    put_bytes("data/single.csv", unhex(file_22()))?;
    put_bytes("data/survey.csv", unhex(file_23()))?;
    put_bytes("data/trailing.csv", unhex(file_24()))?;
    put_bytes("data/umsatz.csv", unhex(file_25()))?;
    put_bytes("data/vmstat.txt", unhex(file_26()))?;
    put_bytes("data/win.csv", unhex(file_27()))?;
    Ok(())
}

