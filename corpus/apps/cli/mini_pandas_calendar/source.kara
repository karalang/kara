// mini_pandas_calendar: a Kāra port of the calendar half of pandas 3.0.5
// (BSD-3-Clause, the pandas development team): the date offsets in
// pandas/_libs/tslibs/offsets.pyx and to_offset, the holiday calendars
// in pandas/tseries/holiday.py, Period and period_range
// (tslibs/period.pyx, core/arrays/period.py), Timedelta's parser,
// formatting and rounding (tslibs/timedeltas.pyx), date_range and
// bdate_range (core/arrays/datetimes.py), with the pieces of numpy
// (BSD-3) they stand on: busdaycalendar, busday_offset, busday_count and
// is_busday, and dateutil's relativedelta and easter (Apache-2.0 or
// BSD-3) under DateOffset and the holiday rules.
//
// It reads data/jobs.txt, one job per line, runs each in a task of its
// own, and prints, in job order, `$ <job>` and what the oracle prints:
//
//   off <ts> <Offset(...)>   repr, freqstr, ts + offset, ts - offset,
//                            rollforward, rollback, is_on_offset
//   freq <alias>             to_offset(alias): repr and freqstr
//   range / brange k=v ...   date_range / bdate_range
//   hol <cal> <start> <end>  a holiday calendar's holidays with names
//   per, pasfreq, padd, pfmt, pdiff, prange
//                            Period, asfreq, + n, strftime, Period -
//                            Period, period_range
//   td, tdround, tsadd       Timedelta parsing and display, floor / ceil
//                            / round, Timestamp + Timedelta
//   busday count|offset|is   numpy's business-day functions
//   due <file> <col> <op> <Offset(...)>
//                            a column of dates op the offset, to_csv
//   bucket <file> <col> <freq> <val>
//                            a groupby on dt.to_period, count and sum
//
// Each distinct warning prints once, after the job's output, as
// `warn: <Category>: <message>`; an error prints as
// `! <exception>: <message>`.

import std.sync.{TaskGroup};

const NS_US: i64 = 1000;
const NS_MS: i64 = 1000000;
const NS_S: i64 = 1000000000;
const NS_MIN: i64 = 60000000000;
const NS_H: i64 = 3600000000000;
const NS_D: i64 = 86400000000000;

// ============================================================ errors

// A Python exception: its class name and message.
#[derive(Clone)]
struct PyErr {
    kind: String,
    msg: String,
}

fn py_err(kind: Str, msg: Str) -> PyErr {
    PyErr { kind: kind.to_string(), msg: msg.to_string() }
}

fn value_error(msg: Str) -> PyErr {
    py_err("ValueError", msg)
}

// repr() of a str: single quotes unless the text holds a single quote
// and no double quote. The messages here are ASCII and hold no
// backslash.
fn py_repr(s: Str) -> String {
    if s.contains("'") and not s.contains("\"") {
        f"\"{s}\""
    } else {
        let t = s.replace("'", "\\'");
        f"'{t}'"
    }
}

// repr() of an exception: `ValueError('...')`.
// A KeyError's message is already the repr of its key.
fn exc_repr(e: ref PyErr) -> String {
    if e.kind == "KeyError" {
        return f"{e.kind}({e.msg})";
    }
    f"{e.kind}({py_repr(e.msg)})"
}

// ============================================================ integers and text

fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b;
    if a % b != 0 and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

fn floor_mod(a: i64, b: i64) -> i64 {
    a - floor_div(a, b) * b
}

fn pad(n: i64, width: i64) -> String {
    let mut t = n.abs().to_string();
    while t.len() < width {
        t = "0".to_string() + t;
    }
    if n < 0 { "-".to_string() + t } else { t }
}

fn all_digits(s: Str) -> bool {
    s.len() > 0 and s.bytes().iter().all(|b| *b >= b'0' and *b <= b'9')
}

// int(s) for a run of ASCII digits with an optional sign.
fn int_of(s: Str) -> Option[i64] {
    let body = if s.starts_with("-") or s.starts_with("+") { s.substring(1) } else { s.to_string() };
    if not all_digits(body) or body.len() > 18 {
        return None;
    }
    let v = i64.parse(body).ok()?;
    Some(if s.starts_with("-") { -v } else { v })
}

fn split_on(s: Str, sep: Str) -> Vec[String] {
    s.split(sep).map(|p| p.to_string()).collect()
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for (i, p) in parts.iter().enumerate() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(p);
    }
    out
}

// ============================================================ the proleptic Gregorian calendar

// Days since 1970-01-01 (Howard Hinnant's days_from_civil).
fn days_from_civil(y0: i64, m: i64, d: i64) -> i64 {
    let y = if m <= 2 { y0 - 1 } else { y0 };
    let era = floor_div(y, 400);
    let yoe = y - era * 400;
    let mp = if m > 2 { m - 3 } else { m + 9 };
    let doy = (153 * mp + 2) / 5 + d - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

fn civil_from_days(z0: i64) -> (i64, i64, i64) {
    let z = z0 + 719468;
    let era = floor_div(z, 146097);
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = if mp < 10 { mp + 3 } else { mp - 9 };
    let y = yoe + era * 400 + if m <= 2 { 1 } else { 0 };
    (y, m, d)
}

fn is_leap(y: i64) -> bool {
    (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
}

fn days_in_month(y: i64, m: i64) -> i64 {
    match m {
        2 => if is_leap(y) { 29 } else { 28 },
        4 | 6 | 9 | 11 => 30,
        _ => 31,
    }
}

// The weekday of a day number, Monday = 0.
fn weekday_of(u: i64) -> i64 {
    floor_mod(u + 3, 7)
}

fn day_of_year(y: i64, m: i64, d: i64) -> i64 {
    days_from_civil(y, m, d) - days_from_civil(y, 1, 1) + 1
}

// ccalendar.get_iso_calendar's week number.
fn iso_week(y: i64, m: i64, d: i64) -> i64 {
    let doy = day_of_year(y, m, d);
    let dow = weekday_of(days_from_civil(y, m, d));
    let mut w = (doy - 1) - dow + 3;
    if w >= 0 {
        w = w / 7 + 1;
    }
    if w < 0 {
        if w > -2 or (w == -2 and is_leap(y - 1)) {
            w = 53;
        } else {
            w = 52;
        }
    } else if w == 53 {
        if 31 - d + dow < 3 {
            w = 1;
        }
    }
    w
}

// ccalendar's first and last business day of a month.
fn first_bday(y: i64, m: i64) -> i64 {
    match weekday_of(days_from_civil(y, m, 1)) {
        5 => 3,
        6 => 2,
        _ => 1,
    }
}

fn last_bday(y: i64, m: i64) -> i64 {
    let wd = weekday_of(days_from_civil(y, m, 1));
    let dim = days_in_month(y, m);
    let over = (wd + dim - 1) % 7 - 4;
    dim - if over > 0 { over } else { 0 }
}

const DAY_ABBR: Array[Str, 7] = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
const DAY_FULL: Array[Str, 7] = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
const DAY_CODE: Array[Str, 7] = ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"];
const MONTH_CODE: Array[Str, 12] = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
const MONTH_FULL: Array[Str, 12] = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

fn month_number(code: Str) -> Option[i64] {
    for i in 0..12 {
        if MONTH_CODE[i] == code {
            return Some(i + 1);
        }
    }
    None
}

fn weekday_number(code: Str) -> Option[i64] {
    for i in 0..7 {
        if DAY_CODE[i] == code {
            return Some(i);
        }
    }
    None
}

// ============================================================ wall-clock times

// A wall-clock time in nanoseconds since 1970-01-01 00:00, broken into
// fields; `ns` is the part of the second.
#[derive(Copy, Clone)]
struct Dt {
    y: i64,
    mo: i64,
    d: i64,
    h: i64,
    mi: i64,
    s: i64,
    ns: i64,
}

fn day_of(w: i64) -> i64 {
    floor_div(w, NS_D)
}

fn time_of(w: i64) -> i64 {
    w - day_of(w) * NS_D
}

fn dt_of(w: i64) -> Dt {
    let (y, mo, d) = civil_from_days(day_of(w));
    let t = time_of(w);
    Dt { y: y, mo: mo, d: d, h: t / NS_H, mi: t % NS_H / NS_MIN, s: t % NS_MIN / NS_S, ns: t % NS_S }
}

fn wall(y: i64, mo: i64, d: i64, h: i64, mi: i64, s: i64, ns: i64) -> i64 {
    days_from_civil(y, mo, d) * NS_D + h * NS_H + mi * NS_MIN + s * NS_S + ns
}

// The same time of day on another date.
fn with_date(w: i64, y: i64, mo: i64, d: i64) -> i64 {
    days_from_civil(y, mo, d) * NS_D + time_of(w)
}

fn date_text(u: i64) -> String {
    let (y, m, d) = civil_from_days(u);
    f"{pad(y, 4)}-{pad(m, 2)}-{pad(d, 2)}"
}

fn clock_text(w: i64) -> String {
    let t = dt_of(w);
    let mut s = f"{pad(t.h, 2)}:{pad(t.mi, 2)}:{pad(t.s, 2)}";
    if t.ns % 1000 != 0 {
        s.push_str(f".{pad(t.ns, 9)}");
    } else if t.ns != 0 {
        s.push_str(f".{pad(t.ns / 1000, 6)}");
    }
    s
}

// ============================================================ time zones

// UTC, and America/New_York under the US rules in force since 2007
// (daylight time from 02:00 on the second Sunday of March to 02:00 on
// the first Sunday of November).
fn known_zone(zone: Str) -> bool {
    zone == "UTC" or zone == "America/New_York"
}

fn nth_sunday(y: i64, m: i64, n: i64) -> i64 {
    let first_dow = weekday_of(days_from_civil(y, m, 1));
    1 + floor_mod(6 - first_dow, 7) + 7 * (n - 1)
}

// The zone's offset from UTC at an instant.
fn zone_offset(zone: Str, utc: i64) -> i64 {
    if zone != "America/New_York" {
        return 0;
    }
    let y = dt_of(utc - 5 * NS_H).y;
    let start = wall(y, 3, nth_sunday(y, 3, 2), 7, 0, 0, 0);
    let end = wall(y, 11, nth_sunday(y, 11, 1), 6, 0, 0, 0);
    if utc >= start and utc < end { -4 * NS_H } else { -5 * NS_H }
}

// tz_localize: the instant a wall-clock time names. The jobs never name
// a time the clocks skip or repeat.
fn localize(zone: Str, w: i64) -> i64 {
    if zone != "America/New_York" {
        return w;
    }
    let standard = w + 5 * NS_H;
    if zone_offset(zone, standard) == -5 * NS_H { standard } else { w + 4 * NS_H }
}

// ============================================================ Timestamp

// A Timestamp: wall-clock nanoseconds when naive, the UTC instant when
// it has a zone.
#[derive(Clone)]
struct Ts {
    v: i64,
    tz: Option[String],
}

fn naive(w: i64) -> Ts {
    Ts { v: w, tz: None }
}

fn ts_wall(t: ref Ts) -> i64 {
    match t.tz {
        Some(ref z) => t.v + zone_offset(z, t.v),
        None => t.v,
    }
}

// The Timestamp that shows wall-clock time w in t's zone.
fn ts_at(t: ref Ts, w: i64) -> Ts {
    match t.tz {
        Some(ref z) => Ts { v: localize(z, w), tz: Some(z.clone()) },
        None => naive(w),
    }
}

fn offset_text(off: i64) -> String {
    let sign = if off < 0 { "-" } else { "+" };
    let a = off.abs() / NS_MIN;
    f"{sign}{pad(a / 60, 2)}:{pad(a % 60, 2)}"
}

// str(Timestamp).
fn ts_str(t: ref Ts) -> String {
    let w = ts_wall(t);
    let mut s = f"{date_text(day_of(w))} {clock_text(w)}";
    if let Some(ref z) = t.tz {
        s.push_str(offset_text(zone_offset(z, t.v)));
    }
    s
}

fn is_midnight(w: i64) -> bool {
    time_of(w) == 0
}

// The number the ASCII digits s[from..from + len] spell.
fn num_at(s: Str, from: i64, len: i64) -> Option[i64] {
    let b = s.bytes();
    if from + len > b.len() or len <= 0 {
        return None;
    }
    let mut v = 0;
    for i in from..from + len {
        if b[i] < b'0' or b[i] > b'9' {
            return None;
        }
        v = v * 10 + (b[i] - b'0') as i64;
    }
    Some(v)
}

// An ISO 8601 date or date-time, `T` or a space between: what
// Timestamp(str) reads for the jobs' values. Wall-clock nanoseconds.
fn parse_iso(s: Str) -> Option[i64] {
    let b = s.bytes();
    let n = b.len();
    let y = num_at(s, 0, 4)?;
    if n == 4 {
        return Some(wall(y, 1, 1, 0, 0, 0, 0));
    }
    if n < 7 or b[4] != b'-' {
        return None;
    }
    let mo = num_at(s, 5, 2)?;
    if mo < 1 or mo > 12 {
        return None;
    }
    if n == 7 {
        return Some(wall(y, mo, 1, 0, 0, 0, 0));
    }
    if n < 10 or b[7] != b'-' {
        return None;
    }
    let d = num_at(s, 8, 2)?;
    if d < 1 or d > days_in_month(y, mo) {
        return None;
    }
    if n == 10 {
        return Some(wall(y, mo, d, 0, 0, 0, 0));
    }
    if (b[10] != b'T' and b[10] != b' ') or n < 16 or b[13] != b':' {
        return None;
    }
    let h = num_at(s, 11, 2)?;
    let mi = num_at(s, 14, 2)?;
    if h > 23 or mi > 59 {
        return None;
    }
    let mut sec = 0;
    let mut frac = 0;
    let mut at = 16;
    if n > 16 {
        if b[16] != b':' {
            return None;
        }
        sec = num_at(s, 17, 2)?;
        if sec > 59 {
            return None;
        }
        at = 19;
        if n > 19 {
            if b[19] != b'.' or n == 20 or n > 29 {
                return None;
            }
            let digits = n - 20;
            frac = num_at(s, 20, digits)?;
            for _ in digits..9 {
                frac *= 10;
            }
            at = n;
        }
    }
    if at != n {
        return None;
    }
    Some(wall(y, mo, d, h, mi, sec, frac))
}

// Timestamp(s) for a job's value, `@zone` naming a time zone.
fn stamp(s: Str) -> Result[Ts, PyErr] {
    let (text, tz) = match s.split_once("@") {
        Some((a, z)) => (a.to_string(), Some(z.to_string())),
        None => (s.to_string(), None),
    };
    let w = match parse_iso(text) {
        Some(w) => w,
        None => return Err(value_error(f"could not convert string to Timestamp")),
    };
    match tz {
        Some(z) => {
            if not known_zone(z) {
                return Err(py_err("UnknownTimeZoneError", py_repr(z)));
            }
            Ok(Ts { v: localize(z, w), tz: Some(z) })
        }
        None => Ok(naive(w)),
    }
}

// ============================================================ Python's round(x, ndigits)

// round(x, p) as CPython rounds a float: the decimal nearest x's exact
// binary value, ties to even, read back as the nearest double. Only for
// |x| < 1 and 0 <= p <= 15, which is all cast_from_unit asks.
fn py_round(x: f64, p: i64) -> f64 {
    if x == 0.0 or p < 0 {
        return x;
    }
    let bits = x.to_bits();
    let neg = (bits >> 63) == 1u64;
    let exp = ((bits >> 52) & 2047u64) as i64;
    let frac_bits = (bits & 4503599627370495u64) as i64;
    let (mant, e) = if exp == 0 { (frac_bits, -1074) } else { (frac_bits + 4503599627370496, exp - 1075) };
    let mut ten: i128 = 1;
    for _ in 0..p {
        ten = ten * 10;
    }
    let num = (mant as i128) * ten;
    let k = -e;
    let q: i128 = if k <= 0 {
        num << (e as i128)
    } else if k > 120 {
        0
    } else {
        let q0 = num >> (k as i128);
        let r = num - (q0 << (k as i128));
        let half: i128 = (1 as i128) << ((k - 1) as i128);
        if r > half or (r == half and q0 % 2 == 1) { q0 + 1 } else { q0 }
    };
    let v = (q as i64) as f64 / (ten as i64) as f64;
    if neg { -v } else { v }
}

// ============================================================ Timedelta

// A Timedelta's components, as pandas_timedelta_to_timedeltastruct
// splits them: whole days rounded down, the rest non-negative.
#[derive(Copy, Clone)]
struct Comp {
    d: i64,
    h: i64,
    m: i64,
    s: i64,
    ms: i64,
    us: i64,
    ns: i64,
}

fn td_comp(v: i64) -> Comp {
    let d = floor_div(v, NS_D);
    let r = v - d * NS_D;
    Comp { d: d, h: r / NS_H, m: r % NS_H / NS_MIN, s: r % NS_MIN / NS_S, ms: r % NS_S / NS_MS, us: r % NS_MS / NS_US, ns: r % NS_US }
}

// _repr_base(format="long").
fn td_str(v: i64) -> String {
    let c = td_comp(v);
    let sign = if c.d < 0 { " +" } else { " " };
    let mut secs = pad(c.s, 2);
    if c.ms != 0 or c.us != 0 or c.ns != 0 {
        secs.push_str(f".{pad(c.ms, 3)}{pad(c.us, 3)}");
        if c.ns != 0 {
            secs.push_str(pad(c.ns, 3));
        }
    }
    f"{c.d} days{sign}{pad(c.h, 2)}:{pad(c.m, 2)}:{secs}"
}

fn td_repr(v: i64) -> String {
    f"Timedelta('{td_str(v)}')"
}

fn td_isoformat(v: i64) -> String {
    let c = td_comp(v);
    let mut secs = f"{c.s}.{pad(c.ms, 3)}{pad(c.us, 3)}{pad(c.ns, 3)}";
    while secs.ends_with("0") {
        secs.pop();
    }
    if secs.ends_with(".") {
        secs.pop();
    }
    f"P{c.d}DT{c.h}H{c.m}M{secs}S"
}

// days * 24 * 3600 + seconds + microseconds / 1_000_000, as Python
// evaluates it.
fn td_total_seconds(v: i64) -> f64 {
    let c = td_comp(v);
    let whole = c.d * 86400 + c.h * 3600 + c.m * 60 + c.s;
    let micros = c.ms * 1000 + c.us;
    whole as f64 + micros as f64 / 1000000.0
}

fn td_components(v: i64) -> String {
    let c = td_comp(v);
    f"Components(days={c.d}, hours={c.h}, minutes={c.m}, seconds={c.s}, milliseconds={c.ms}, microseconds={c.us}, nanoseconds={c.ns})"
}

// timedelta_abbrevs: a unit's canonical abbreviation.
fn td_abbrev(unit: Str) -> Option[String] {
    let a = match unit {
        "y" => "Y",
        "m" | "minute" | "min" | "minutes" => "m",
        "w" => "W",
        "d" | "days" | "day" => "D",
        "hours" | "hour" | "hr" | "h" => "h",
        "s" | "seconds" | "sec" | "second" => "s",
        "ms" | "milliseconds" | "millisecond" | "milli" | "millis" => "ms",
        "us" | "microseconds" | "microsecond" | "µs" | "micro" | "micros" => "us",
        "ns" | "nanoseconds" | "nano" | "nanos" | "nanosecond" => "ns",
        _ => return None,
    };
    Some(a.to_string())
}

// parse_timedelta_unit, with c_DEPR_UNITS' warnings.
fn parse_td_unit(unit: Str, warns: mut ref Vec[String]) -> Result[String, PyErr] {
    if unit == "M" {
        return Ok("M".to_string());
    }
    let depr = match unit {
        "w" => Some("W"),
        "d" => Some("D"),
        "H" => Some("h"),
        "MIN" => Some("min"),
        "S" => Some("s"),
        "MS" => Some("ms"),
        "US" => Some("us"),
        "NS" => Some("ns"),
        _ => None,
    };
    let mut u = unit.to_string();
    if let Some(new) = depr {
        add_warning(mut warns, "Pandas4Warning", f"'{unit}' is deprecated and will be removed in a future version. Please use '{new}' instead of '{unit}'.");
        u = new.to_string();
    }
    let low = u.to_lowercase();
    match td_abbrev(low) {
        Some(a) => Ok(a),
        None => Err(value_error(f"invalid unit abbreviation: {u}")),
    }
}

// Nanoseconds in one of a unit (an abbreviation from td_abbrev).
fn unit_ns(abbrev: Str) -> i64 {
    match abbrev {
        "W" => 7 * NS_D,
        "D" => NS_D,
        "h" => NS_H,
        "m" => NS_MIN,
        "s" => NS_S,
        "ms" => NS_MS,
        "us" => NS_US,
        _ => 1,
    }
}

// cast_from_unit(float(n), unit): the whole part times the unit, plus
// the fraction rounded to the unit's digits.
fn cast_from_unit(ts: f64, unit: Str) -> Result[i64, PyErr] {
    let m = unit_ns(unit);
    let p = (m as f64).log10().floor() as i64;
    let oob = py_err("OutOfBoundsDatetime", f"cannot convert input {ts} with the unit '{unit}'");
    if ts.abs() >= 9.2e18 {
        return Err(oob);
    }
    let base = ts.trunc() as i64;
    let mut frac = ts - base as f64;
    if p > 0 {
        frac = py_round(frac, p);
    }
    let whole = (base as i128) * (m as i128);
    if whole > 9223372036854775807 or whole < -9223372036854775807 {
        return Err(oob);
    }
    Ok(whole as i64 + (frac * m as f64).trunc() as i64)
}

// timedelta_from_spec.
fn td_from_spec(number: Str, frac: Str, unit: Str, warns: mut ref Vec[String]) -> Result[i64, PyErr] {
    if unit == "M" or unit == "Y" or unit == "y" {
        return Err(value_error("Units 'M', 'Y' and 'y' do not represent unambiguous timedelta values and are not supported."));
    }
    let u = parse_td_unit(unit, mut warns)?;
    let text = f"{number}.{frac}";
    let x = match f64.parse(text) {
        Ok(x) => x,
        Err(_) => return Err(value_error(f"could not convert string to float: {py_repr(text)}")),
    };
    cast_from_unit(x, u)
}

fn as_neg(v: i64, neg: bool) -> i64 {
    if neg { -v } else { v }
}

// parse_timedelta_string: day/unit words and hh:mm:ss[.fff] mixed.
fn parse_td_string(ts: Str, warns: mut ref Vec[String]) -> Result[i64, PyErr] {
    let mut neg = false;
    let mut have_dot = false;
    let mut have_value = false;
    let mut have_hhmmss = false;
    let mut current_unit = "";
    let mut result: i64 = 0;
    let mut number = String.new();
    let mut frac = String.new();
    let mut unit = String.new();
    for c in ts.chars() {
        if c == ' ' or c == ',' or c == '+' {
            continue;
        }
        if c == '-' {
            if neg or have_value or have_hhmmss {
                return Err(value_error("only leading negative signs are allowed"));
            }
            neg = true;
        } else if c >= '0' and c <= '9' {
            if have_dot {
                if unit.len() > 0 {
                    number.push(c);
                    have_dot = false;
                } else {
                    frac.push(c);
                }
            } else if unit.len() == 0 {
                number.push(c);
            } else {
                let r = td_from_spec(number, frac, unit, mut warns)?;
                unit = String.new();
                number = String.new();
                number.push(c);
                frac = String.new();
                result += as_neg(r, neg);
            }
        } else if c == ':' {
            if have_value {
                neg = false;
            }
            if number.len() > 0 {
                let m = if current_unit == "" {
                    current_unit = "h";
                    NS_H
                } else if current_unit == "h" {
                    current_unit = "m";
                    NS_MIN
                } else {
                    current_unit = "s";
                    NS_S
                };
                let r = (int_of(number) ?? 0) * m;
                result += as_neg(r, neg);
                have_hhmmss = true;
            } else {
                return Err(value_error(f"expecting hh:mm:ss format, received: {ts}"));
            }
            unit = String.new();
            number = String.new();
        } else if c == '.' {
            if number.len() > 0 and current_unit != "" {
                if current_unit != "m" {
                    return Err(value_error("expected hh:mm:ss format before ."));
                }
                let r = (int_of(number) ?? 0) * NS_S;
                result += as_neg(r, neg);
                have_value = true;
                unit = String.new();
                number = String.new();
                frac = String.new();
            }
            have_dot = true;
        } else {
            unit.push(c);
            have_value = true;
            have_dot = false;
        }
    }
    if have_dot and unit.len() > 0 {
        let r = td_from_spec(number, frac, unit, mut warns)?;
        result += as_neg(r, neg);
    } else if have_dot {
        if (number.len() > 0 or frac.len() > 0) and unit.len() == 0 and current_unit == "" {
            return Err(value_error("no units specified"));
        }
        let f = frac.chars().count();
        let mut digits = frac.clone();
        let m = if f > 0 and f <= 3 {
            pow10(3 - f) * NS_MS
        } else if f > 3 and f <= 6 {
            pow10(6 - f) * NS_US
        } else if f > 6 and f <= 9 {
            pow10(9 - f)
        } else {
            digits = digits.substring(0, 9);
            1
        };
        let r = (int_of(digits) ?? 0) * m;
        result += as_neg(r, neg);
    } else if current_unit != "" {
        if current_unit != "m" {
            return Err(value_error("expected hh:mm:ss format"));
        }
        let r = (int_of(number) ?? 0) * NS_S;
        result += as_neg(r, neg);
    } else if unit.len() > 0 {
        if number.len() > 0 {
            let r = td_from_spec(number, frac, unit, mut warns)?;
            result += as_neg(r, neg);
        } else {
            return Err(value_error("unit abbreviation w/o a number"));
        }
    } else if number.len() == 0 {
        return Err(value_error("symbols w/o a number"));
    } else {
        if have_value {
            return Err(value_error("have leftover units"));
        }
        let r = td_from_spec(number, frac, "ns", mut warns)?;
        result += as_neg(r, neg);
    }
    Ok(result)
}

fn pow10(k: i64) -> i64 {
    let mut v = 1;
    for _ in 0..k {
        v *= 10;
    }
    v
}

// parse_iso_format_string: P[n]Dt[n]H[n]M[n][.f]S.
fn parse_td_iso(ts0: Str, warns: mut ref Vec[String]) -> Result[i64, PyErr] {
    let err_msg = f"Invalid ISO 8601 Duration format - {ts0}";
    let mut ts = ts0.to_string();
    let mut sign = 1;
    if ts.starts_with("-") {
        sign = -1;
        ts = ts.substring(1);
    }
    let mut result: i64 = 0;
    let mut p = 0;
    let mut dec_unit = "ms";
    let mut have_dot = false;
    let mut have_value = false;
    let mut neg = false;
    let mut number = String.new();
    let mut unit = String.new();
    for c in ts.chars() {
        if c >= '0' and c <= '9' {
            have_value = true;
            if have_dot {
                if p == 3 and dec_unit != "ns" {
                    unit.push_str(dec_unit);
                    if dec_unit == "ms" {
                        dec_unit = "us";
                    } else if dec_unit == "us" {
                        dec_unit = "ns";
                    }
                    p = 0;
                }
                p += 1;
            }
            if unit.len() == 0 {
                number.push(c);
            } else {
                let r = td_from_spec(number, "0", unit, mut warns)?;
                result += as_neg(r, neg);
                neg = false;
                unit = String.new();
                number = String.new();
                number.push(c);
            }
        } else if c == 'P' or c == 'T' or c == '+' {
            continue;
        } else if c == '-' {
            if neg or have_value {
                return Err(value_error(err_msg));
            }
            neg = true;
        } else if c == 'W' or c == 'D' or c == 'H' or c == 'M' {
            if (c == 'H' or c == 'M') and number.len() > 2 {
                return Err(value_error(err_msg));
            }
            let u = match c {
                'M' => "min",
                'H' => "h",
                'W' => "W",
                _ => "D",
            };
            unit.push_str(u);
            let r = td_from_spec(number, "0", unit, mut warns)?;
            result += as_neg(r, neg);
            neg = false;
            unit = String.new();
            number = String.new();
        } else if c == '.' {
            if number.len() > 0 {
                let r = td_from_spec(number, "0", "s", mut warns)?;
                result += as_neg(r, neg);
                unit = String.new();
                number = String.new();
            }
            have_dot = true;
        } else if c == 'S' {
            if have_dot {
                if number.len() == 0 or p > 3 {
                    return Err(value_error(err_msg));
                }
                for _ in 0..3 - p {
                    number.push('0');
                }
                let r = td_from_spec(number, "0", dec_unit, mut warns)?;
                result += as_neg(r, neg);
            } else {
                let r = td_from_spec(number, "0", "s", mut warns)?;
                result += as_neg(r, neg);
            }
        } else {
            return Err(value_error(err_msg));
        }
    }
    if not have_value {
        return Err(value_error(err_msg));
    }
    Ok(sign * result)
}

// Timedelta(str), in nanoseconds.
fn parse_timedelta(s: Str, warns: mut ref Vec[String]) -> Result[i64, PyErr] {
    if s.starts_with("P") or s.starts_with("-P") {
        parse_td_iso(s, mut warns)
    } else {
        parse_td_string(s, mut warns)
    }
}

// round_nsint64: floor, ceil or round half to even to a multiple.
fn round_to(v: i64, unit: i64, how: Str) -> i64 {
    match how {
        "floor" => v - floor_mod(v, unit),
        "ceil" => v + floor_mod(-v, unit),
        _ => {
            let mut q = floor_div(v, unit);
            let r = v - q * unit;
            if r > unit / 2 or (r == unit / 2 and floor_mod(q, 2) == 1) {
                q += 1;
            }
            q * unit
        }
    }
}

// ============================================================ numpy's business-day calendar

// np.busdaycalendar: a weekmask (Monday first) and the sorted, distinct
// holidays that fall on a day the mask keeps, as day numbers.
#[derive(Clone)]
struct BusCal {
    mask: Vec[bool],
    holidays: Vec[i64],
}

fn bus_cal(mask: own Vec[bool], hols: ref Vec[i64]) -> BusCal {
    let mut hs: Vec[i64] = hols.iter().filter(|u| mask[weekday_of(*u)]).map(|u| *u).collect();
    hs.sort();
    hs.dedup();
    BusCal { mask: mask, holidays: hs }
}

fn default_mask() -> Vec[bool] {
    vec![true, true, true, true, true, false, false]
}

fn plain_cal() -> BusCal {
    BusCal { mask: default_mask(), holidays: Vec.new() }
}

// A weekmask as numpy reads one: seven 0/1 characters, or weekday
// names (Mon, Tue, ...) separated by white space.
fn parse_weekmask(s: Str) -> Result[Vec[bool], PyErr] {
    let cs: Vec[char] = s.chars().collect();
    if cs.len() == 7 and cs.iter().all(|c| *c == '0' or *c == '1') {
        return Ok(cs.iter().map(|c| *c == '1').collect());
    }
    let mut mask = vec![false, false, false, false, false, false, false];
    for word in s.split_whitespace() {
        let mut found = false;
        for i in 0..7 {
            if DAY_ABBR[i] == word {
                mask[i] = true;
                found = true;
            }
        }
        if not found {
            return Err(value_error(f"Invalid business day weekmask string \"{s}\""));
        }
    }
    Ok(mask)
}

fn has_holiday(cal: ref BusCal, u: i64) -> bool {
    let hs = cal.holidays.clone();
    let mut lo = 0;
    let mut hi = hs.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if hs[mid] < u {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo < hs.len() and hs[lo] == u
}

fn is_bus(cal: ref BusCal, u: i64) -> bool {
    cal.mask[weekday_of(u)] and not has_holiday(cal, u)
}

fn known_roll(roll: Str) -> bool {
    match roll {
        "raise" | "nat" | "forward" | "following" | "backward" | "preceding" | "modifiedfollowing" | "modifiedpreceding" => true,
        _ => false,
    }
}

fn roll_forward_day(cal: ref BusCal, u0: i64) -> i64 {
    let mut u = u0;
    while not is_bus(cal, u) {
        u += 1;
    }
    u
}

fn roll_backward_day(cal: ref BusCal, u0: i64) -> i64 {
    let mut u = u0;
    while not is_bus(cal, u) {
        u -= 1;
    }
    u
}

fn month_of_day(u: i64) -> i64 {
    let (_, m, _) = civil_from_days(u);
    m
}

// np.busday_offset(date, n, roll): roll a day that is not a business
// day, then move n business days. None is NaT.
fn busday_offset(cal: ref BusCal, u0: i64, n: i64, roll: Str) -> Result[Option[i64], PyErr] {
    if not known_roll(roll) {
        return Err(value_error(f"Invalid business day roll parameter \"{roll}\""));
    }
    if not cal.mask.iter().any(|b| *b) {
        return Err(value_error("Cannot construct a numpy busdaycal with a weekmask of all zeros"));
    }
    let mut u = u0;
    if not is_bus(cal, u) {
        u = match roll {
            "raise" => return Err(value_error("Non-business day date in busday_offset")),
            "nat" => return Ok(None),
            "forward" | "following" => roll_forward_day(cal, u),
            "backward" | "preceding" => roll_backward_day(cal, u),
            "modifiedfollowing" => {
                let f = roll_forward_day(cal, u);
                if month_of_day(f) != month_of_day(u) { roll_backward_day(cal, u) } else { f }
            }
            _ => {
                let b = roll_backward_day(cal, u);
                if month_of_day(b) != month_of_day(u) { roll_forward_day(cal, u) } else { b }
            }
        };
    }
    let mut k = n;
    while k > 0 {
        u += 1;
        if is_bus(cal, u) {
            k -= 1;
        }
    }
    while k < 0 {
        u -= 1;
        if is_bus(cal, u) {
            k += 1;
        }
    }
    Ok(Some(u))
}

// np.busday_count(begin, end): business days in [begin, end), or minus
// those in (end, begin] when end comes first.
fn busday_count(cal: ref BusCal, a: i64, b: i64) -> i64 {
    let (lo, hi, sign) = if a > b { (b + 1, a + 1, -1) } else { (a, b, 1) };
    let mut c = 0;
    for u in lo..hi {
        if is_bus(cal, u) {
            c += 1;
        }
    }
    sign * c
}

// ============================================================ dateutil

// dateutil.easter.easter(year, method=3): the Western (Gregorian)
// Easter, as a day number.
fn easter_day(y: i64) -> i64 {
    let g = y % 19;
    let c = y / 100;
    let h = (c - c / 4 - (8 * c + 13) / 25 + 19 * g + 15) % 30;
    let i = h - (h / 28) * (1 - (h / 28) * (29 / (h + 1)) * ((21 - g) / 11));
    let j = (y + y / 4 + i + 2 - c + c / 4) % 7;
    let p = i - j;
    let d = 1 + (p + 27 + (p + 6) / 40) % 31;
    let m = 3 + (p + 26) / 30;
    days_from_civil(y, m, d)
}

fn sign_of(x: i64) -> i64 {
    if x < 0 { -1 } else { 1 }
}

// A relativedelta: relative fields (after _fix), absolute fields (-1 or
// None when unset) and a weekday with its nth (0 for none).
#[derive(Clone)]
struct RelDelta {
    years: i64,
    months: i64,
    days: i64,
    hours: i64,
    minutes: i64,
    seconds: i64,
    micros: i64,
    year: i64,
    month: i64,
    day: i64,
    hour: i64,
    minute: i64,
    second: i64,
    micro: i64,
    weekday: i64,
    nth: i64,
}

// relativedelta._fix: carry each relative field past its range into the
// next, keeping its sign.
fn rd_fix(r: mut ref RelDelta) {
    if r.micros.abs() > 999999 {
        let s = sign_of(r.micros);
        let a = r.micros * s;
        r.micros = a % 1000000 * s;
        r.seconds += a / 1000000 * s;
    }
    if r.seconds.abs() > 59 {
        let s = sign_of(r.seconds);
        let a = r.seconds * s;
        r.seconds = a % 60 * s;
        r.minutes += a / 60 * s;
    }
    if r.minutes.abs() > 59 {
        let s = sign_of(r.minutes);
        let a = r.minutes * s;
        r.minutes = a % 60 * s;
        r.hours += a / 60 * s;
    }
    if r.hours.abs() > 23 {
        let s = sign_of(r.hours);
        let a = r.hours * s;
        r.hours = a % 24 * s;
        r.days += a / 24 * s;
    }
    if r.months.abs() > 11 {
        let s = sign_of(r.months);
        let a = r.months * s;
        r.months = a % 12 * s;
        r.years += a / 12 * s;
    }
}

// relativedelta * n: the relative fields scaled, then fixed again.
fn rd_times(r: ref RelDelta, n: i64) -> RelDelta {
    let mut m = r.clone();
    m.years = r.years * n;
    m.months = r.months * n;
    m.days = r.days * n;
    m.hours = r.hours * n;
    m.minutes = r.minutes * n;
    m.seconds = r.seconds * n;
    m.micros = r.micros * n;
    rd_fix(mut m);
    m
}

// datetime + relativedelta, on wall-clock nanoseconds (the part below a
// microsecond rides along, as pandas adds it back).
fn rd_add(r: ref RelDelta, w: i64) -> Result[i64, PyErr] {
    let t = dt_of(w);
    let mut year = (if r.year > 0 { r.year } else { t.y }) + r.years;
    let mut month = if r.month > 0 { r.month } else { t.mo };
    if r.months != 0 {
        month += r.months;
        if month > 12 {
            year += 1;
            month -= 12;
        } else if month < 1 {
            year -= 1;
            month += 12;
        }
    }
    if month < 1 or month > 12 {
        return Err(py_err("IllegalMonthError", f"bad month number {month}; must be 1-12"));
    }
    let dim = days_in_month(year, month);
    let want = if r.day > 0 { r.day } else { t.d };
    let day = if want < dim { want } else { dim };
    let h = if r.hour >= 0 { r.hour } else { t.h };
    let mi = if r.minute >= 0 { r.minute } else { t.mi };
    let s = if r.second >= 0 { r.second } else { t.s };
    let us = if r.micro >= 0 { r.micro } else { t.ns / 1000 };
    let mut out = wall(year, month, day, h, mi, s, us * 1000 + t.ns % 1000);
    out += r.days * NS_D + r.hours * NS_H + r.minutes * NS_MIN + r.seconds * NS_S + r.micros * NS_US;
    if r.weekday >= 0 {
        let nth = if r.nth == 0 { 1 } else { r.nth };
        let wd = weekday_of(day_of(out));
        let mut jump = (nth.abs() - 1) * 7;
        if nth > 0 {
            jump += floor_mod(7 - wd + r.weekday, 7);
        } else {
            jump += floor_mod(wd - r.weekday, 7);
            jump = -jump;
        }
        out += jump * NS_D;
    }
    Ok(out)
}

fn weekday_repr(wd: i64, nth: i64) -> String {
    let names = ["MO", "TU", "WE", "TH", "FR", "SA", "SU"];
    if nth == 0 {
        names[wd].to_string()
    } else if nth > 0 {
        f"{names[wd]}(+{nth})"
    } else {
        f"{names[wd]}({nth})"
    }
}

// ============================================================ date offsets

#[derive(Copy, Clone, PartialEq, Eq)]
enum K {
    BDay,
    CBDay,
    Bh,
    Cbh,
    MonthEnd,
    MonthBegin,
    BMonthEnd,
    BMonthBegin,
    CBMonthEnd,
    CBMonthBegin,
    SemiMonthEnd,
    SemiMonthBegin,
    Week,
    Wom,
    Lwom,
    QuarterEnd,
    QuarterBegin,
    BQuarterEnd,
    BQuarterBegin,
    HalfYearEnd,
    HalfYearBegin,
    BHalfYearEnd,
    BHalfYearBegin,
    YearEnd,
    YearBegin,
    BYearEnd,
    BYearBegin,
    Fy5253,
    Fy5253q,
    Easter,
    DateOffset,
    Day,
    Hour,
    Minute,
    Second,
    Milli,
    Micro,
    Nano,
}

// The day of the month a month-anchored offset lands on, or a fixed day:
// shift_month's day_opt.
const OPT_NONE: i64 = -1;
const OPT_START: i64 = -2;
const OPT_END: i64 = -3;
const OPT_BSTART: i64 = -4;
const OPT_BEND: i64 = -5;

// One offset object. Each kind reads the fields it has: `offset` is
// the BusinessMixin timedelta (ns), `weekday` -1 for Week's None,
// `month` YearOffset's month or the startingMonth of the quarter,
// half-year and FY5253 kinds, `starts` / `ends` BusinessHour's opening
// hours in seconds of the day, `rd` / `td` / `kw` DateOffset's
// relativedelta or timedelta and its keywords as repr shows them.
#[derive(Clone)]
struct Off {
    k: K,
    n: i64,
    normalize: bool,
    offset: i64,
    weekday: i64,
    week: i64,
    month: i64,
    dom: i64,
    last: bool,
    qtr: i64,
    method: i64,
    starts: Vec[i64],
    ends: Vec[i64],
    cal: BusCal,
    rd: RelDelta,
    use_rd: bool,
    td: i64,
    nanos: i64,
    kw: Vec[(String, String)],
}

fn empty_rd() -> RelDelta {
    RelDelta {
        years: 0,
        months: 0,
        days: 0,
        hours: 0,
        minutes: 0,
        seconds: 0,
        micros: 0,
        year: -1,
        month: -1,
        day: -1,
        hour: -1,
        minute: -1,
        second: -1,
        micro: -1,
        weekday: -1,
        nth: 0,
    }
}

fn new_off(k: K, n: i64) -> Off {
    Off {
        k: k,
        n: n,
        normalize: false,
        offset: 0,
        weekday: -1,
        week: 0,
        month: 0,
        dom: 0,
        last: false,
        qtr: 1,
        method: 3,
        starts: vec![9 * 3600],
        ends: vec![17 * 3600],
        cal: plain_cal(),
        rd: empty_rd(),
        use_rd: false,
        td: 0,
        nanos: 0,
        kw: Vec.new(),
    }
}

fn is_tick(k: K) -> bool {
    match k {
        K.Hour | K.Minute | K.Second | K.Milli | K.Micro | K.Nano => true,
        _ => false,
    }
}

fn tick_ns(k: K) -> i64 {
    match k {
        K.Hour => NS_H,
        K.Minute => NS_MIN,
        K.Second => NS_S,
        K.Milli => NS_MS,
        K.Micro => NS_US,
        _ => 1,
    }
}

fn is_custom(k: K) -> bool {
    k == K.CBDay or k == K.Cbh or k == K.CBMonthEnd or k == K.CBMonthBegin
}

fn is_bh(k: K) -> bool {
    k == K.Bh or k == K.Cbh
}

// The class name repr shows (_output_name where pandas sets one).
fn off_name(k: K) -> Str {
    match k {
        K.BDay => "BusinessDay",
        K.CBDay => "CustomBusinessDay",
        K.Bh => "BusinessHour",
        K.Cbh => "CustomBusinessHour",
        K.MonthEnd => "MonthEnd",
        K.MonthBegin => "MonthBegin",
        K.BMonthEnd => "BusinessMonthEnd",
        K.BMonthBegin => "BusinessMonthBegin",
        K.CBMonthEnd => "CustomBusinessMonthEnd",
        K.CBMonthBegin => "CustomBusinessMonthBegin",
        K.SemiMonthEnd => "SemiMonthEnd",
        K.SemiMonthBegin => "SemiMonthBegin",
        K.Week => "Week",
        K.Wom => "WeekOfMonth",
        K.Lwom => "LastWeekOfMonth",
        K.QuarterEnd => "QuarterEnd",
        K.QuarterBegin => "QuarterBegin",
        K.BQuarterEnd => "BusinessQuarterEnd",
        K.BQuarterBegin => "BusinessQuarterBegin",
        K.HalfYearEnd => "HalfYearEnd",
        K.HalfYearBegin => "HalfYearBegin",
        K.BHalfYearEnd => "BusinessHalfYearEnd",
        K.BHalfYearBegin => "BusinessHalfYearBegin",
        K.YearEnd => "YearEnd",
        K.YearBegin => "YearBegin",
        K.BYearEnd => "BYearEnd",
        K.BYearBegin => "BYearBegin",
        K.Fy5253 => "FY5253",
        K.Fy5253q => "FY5253Quarter",
        K.Easter => "Easter",
        K.DateOffset => "DateOffset",
        K.Day => "Day",
        K.Hour => "Hour",
        K.Minute => "Minute",
        K.Second => "Second",
        K.Milli => "Milli",
        K.Micro => "Micro",
        K.Nano => "Nano",
    }
}

// The kind a class name in a job's spec names (the aliases BDay, CDay,
// BMonthEnd and the rest included).
fn kind_of(name: Str) -> Option[K] {
    let k = match name {
        "BusinessDay" | "BDay" => K.BDay,
        "CustomBusinessDay" | "CDay" => K.CBDay,
        "BusinessHour" => K.Bh,
        "CustomBusinessHour" => K.Cbh,
        "MonthEnd" => K.MonthEnd,
        "MonthBegin" => K.MonthBegin,
        "BusinessMonthEnd" | "BMonthEnd" => K.BMonthEnd,
        "BusinessMonthBegin" | "BMonthBegin" => K.BMonthBegin,
        "CustomBusinessMonthEnd" | "CBMonthEnd" => K.CBMonthEnd,
        "CustomBusinessMonthBegin" | "CBMonthBegin" => K.CBMonthBegin,
        "SemiMonthEnd" => K.SemiMonthEnd,
        "SemiMonthBegin" => K.SemiMonthBegin,
        "Week" => K.Week,
        "WeekOfMonth" => K.Wom,
        "LastWeekOfMonth" => K.Lwom,
        "QuarterEnd" => K.QuarterEnd,
        "QuarterBegin" => K.QuarterBegin,
        "BQuarterEnd" => K.BQuarterEnd,
        "BQuarterBegin" => K.BQuarterBegin,
        "HalfYearEnd" => K.HalfYearEnd,
        "HalfYearBegin" => K.HalfYearBegin,
        "BHalfYearEnd" => K.BHalfYearEnd,
        "BHalfYearBegin" => K.BHalfYearBegin,
        "YearEnd" => K.YearEnd,
        "YearBegin" => K.YearBegin,
        "BYearEnd" => K.BYearEnd,
        "BYearBegin" => K.BYearBegin,
        "FY5253" => K.Fy5253,
        "FY5253Quarter" => K.Fy5253q,
        "Easter" => K.Easter,
        "DateOffset" => K.DateOffset,
        "Day" => K.Day,
        "Hour" => K.Hour,
        "Minute" => K.Minute,
        "Second" => K.Second,
        "Milli" => K.Milli,
        "Micro" => K.Micro,
        "Nano" => K.Nano,
        _ => return None,
    };
    Some(k)
}

// The day_opt of the month-, quarter-, half- and year-anchored kinds.
fn day_opt(k: K) -> i64 {
    match k {
        K.MonthEnd | K.QuarterEnd | K.HalfYearEnd | K.YearEnd => OPT_END,
        K.MonthBegin | K.QuarterBegin | K.HalfYearBegin | K.YearBegin => OPT_START,
        K.BMonthEnd | K.BQuarterEnd | K.BHalfYearEnd | K.BYearEnd => OPT_BEND,
        K.BMonthBegin | K.BQuarterBegin | K.BHalfYearBegin | K.BYearBegin => OPT_BSTART,
        _ => OPT_NONE,
    }
}

fn is_quarter(k: K) -> bool {
    k == K.QuarterEnd or k == K.QuarterBegin or k == K.BQuarterEnd or k == K.BQuarterBegin
}

fn is_half(k: K) -> bool {
    k == K.HalfYearEnd or k == K.HalfYearBegin or k == K.BHalfYearEnd or k == K.BHalfYearBegin
}

fn is_year(k: K) -> bool {
    k == K.YearEnd or k == K.YearBegin or k == K.BYearEnd or k == K.BYearBegin
}

fn is_month(k: K) -> bool {
    k == K.MonthEnd or k == K.MonthBegin or k == K.BMonthEnd or k == K.BMonthBegin
}

// The defaults each constructor fills in.
fn default_off(k: K, n: i64) -> Off {
    let mut o = new_off(k, n);
    if k == K.YearEnd or k == K.BYearEnd {
        o.month = 12;
    } else if k == K.YearBegin or k == K.BYearBegin {
        o.month = 1;
    } else if is_quarter(k) {
        o.month = 3;
    } else if k == K.HalfYearEnd or k == K.BHalfYearEnd {
        o.month = 6;
    } else if is_half(k) {
        o.month = 1;
    } else if k == K.Fy5253 or k == K.Fy5253q {
        o.month = 1;
        o.weekday = 0;
    } else if k == K.SemiMonthEnd or k == K.SemiMonthBegin {
        o.dom = 15;
    } else if k == K.Wom or k == K.Lwom {
        o.weekday = 0;
    }
    if k == K.Lwom {
        o.week = -1;
    }
    o
}

// ------------------------------------------------------------ repr and freqstr

fn hhmm(secs: i64) -> String {
    f"{pad(secs / 3600, 2)}:{pad(secs % 3600 / 60, 2)}"
}

fn repr_attrs(o: ref Off) -> String {
    let mut attrs: Vec[String] = Vec.new();
    let k = o.k;
    if k == K.BDay or k == K.CBDay or is_bh(k) or k == K.CBMonthEnd or k == K.CBMonthBegin {
        if o.offset != 0 {
            attrs.push(f"offset={td_repr(o.offset)}");
        }
    } else if k == K.SemiMonthEnd or k == K.SemiMonthBegin {
        attrs.push(f"day_of_month={o.dom}");
    } else if k == K.Week {
        if o.weekday < 0 {
            attrs.push("weekday=None".to_string());
        } else {
            attrs.push(f"weekday={o.weekday}");
        }
    } else if k == K.Wom {
        attrs.push(f"week={o.week}");
        attrs.push(f"weekday={o.weekday}");
    } else if k == K.Lwom {
        attrs.push(f"weekday={o.weekday}");
    } else if is_quarter(k) or is_half(k) {
        attrs.push(f"startingMonth={o.month}");
    } else if is_year(k) {
        attrs.push(f"month={o.month}");
    } else if k == K.Fy5253 or k == K.Fy5253q {
        if k == K.Fy5253q {
            attrs.push(f"qtr_with_extra_week={o.qtr}");
        }
        attrs.push(f"startingMonth={o.month}");
        let v = if o.last { "last" } else { "nearest" };
        attrs.push(f"variation={v}");
        attrs.push(f"weekday={o.weekday}");
    } else if k == K.Easter {
        attrs.push(f"method={o.method}");
    } else if k == K.DateOffset {
        for (name, v) in o.kw.iter() {
            attrs.push(f"{name}={v}");
        }
    }
    let mut out = String.new();
    if attrs.len() > 0 {
        out.push_str(": ");
        out.push_str(join(attrs, ", "));
    }
    if is_bh(k) {
        let mut hours: Vec[String] = Vec.new();
        for i in 0..o.starts.len() {
            hours.push(f"{hhmm(o.starts[i])}-{hhmm(o.ends[i])}");
        }
        let p = if k == K.Bh { "bh" } else { "cbh" };
        out.push_str(f": {p}={join(hours, ",")}");
    }
    out
}

fn off_repr(o: ref Off) -> String {
    let plural = if o.n.abs() != 1 { "s" } else { "" };
    let n_str = if o.n != 1 { f"{o.n} * " } else { String.new() };
    f"<{n_str}{off_name(o.k)}{plural}{repr_attrs(o)}>"
}

fn month_code(m: i64) -> Str {
    MONTH_CODE[m - 1]
}

// rule_code, or None where pandas has no prefix (Easter, DateOffset).
fn rule_code(o: ref Off) -> Option[String] {
    let k = o.k;
    let s = match k {
        K.BDay => "B".to_string(),
        K.CBDay => "C".to_string(),
        K.Bh => "bh".to_string(),
        K.Cbh => "cbh".to_string(),
        K.MonthEnd => "ME".to_string(),
        K.MonthBegin => "MS".to_string(),
        K.BMonthEnd => "BME".to_string(),
        K.BMonthBegin => "BMS".to_string(),
        K.CBMonthEnd => "CBME".to_string(),
        K.CBMonthBegin => "CBMS".to_string(),
        K.SemiMonthEnd => f"SME-{o.dom}",
        K.SemiMonthBegin => f"SMS-{o.dom}",
        K.Week => if o.weekday < 0 { "W".to_string() } else { f"W-{DAY_CODE[o.weekday]}" },
        K.Wom => f"WOM-{o.week + 1}{DAY_CODE[o.weekday]}",
        K.Lwom => f"LWOM-{DAY_CODE[o.weekday]}",
        K.QuarterEnd => f"QE-{month_code(o.month)}",
        K.QuarterBegin => f"QS-{month_code(o.month)}",
        K.BQuarterEnd => f"BQE-{month_code(o.month)}",
        K.BQuarterBegin => f"BQS-{month_code(o.month)}",
        K.HalfYearEnd => f"HYE-{month_code(o.month)}",
        K.HalfYearBegin => f"HYS-{month_code(o.month)}",
        K.BHalfYearEnd => f"BHYE-{month_code(o.month)}",
        K.BHalfYearBegin => f"BHYS-{month_code(o.month)}",
        K.YearEnd => f"YE-{month_code(o.month)}",
        K.YearBegin => f"YS-{month_code(o.month)}",
        K.BYearEnd => f"BYE-{month_code(o.month)}",
        K.BYearBegin => f"BYS-{month_code(o.month)}",
        K.Fy5253 | K.Fy5253q => {
            let v = if o.last { "L" } else { "N" };
            let p = if k == K.Fy5253 { "RE" } else { "REQ" };
            let base = f"{p}-{v}-{month_code(o.month)}-{DAY_CODE[o.weekday]}";
            if k == K.Fy5253q { f"{base}-{o.qtr}" } else { base }
        }
        K.Easter | K.DateOffset => return None,
        K.Day => "D".to_string(),
        K.Hour => "h".to_string(),
        K.Minute => "min".to_string(),
        K.Second => "s".to_string(),
        K.Milli => "ms".to_string(),
        K.Micro => "us".to_string(),
        K.Nano => "ns".to_string(),
    };
    Some(s)
}

// BusinessDay._offset_str: "+2h", "+1D3h30Min" and so on.
fn offset_str(v: i64) -> String {
    let sign = if v >= 0 { "+" } else { "-" };
    let a = v.abs();
    let days = a / NS_D;
    let secs = a % NS_D / NS_S;
    let micros = a % NS_S / NS_US;
    let mut out = sign.to_string();
    if days > 0 {
        out.push_str(f"{days}D");
    }
    if secs > 0 {
        let mut s = secs;
        let hrs = s / 3600;
        if hrs != 0 {
            out.push_str(f"{hrs}h");
            s -= hrs * 3600;
        }
        let mts = s / 60;
        if mts != 0 {
            out.push_str(f"{mts}Min");
            s -= mts * 60;
        }
        if s != 0 {
            out.push_str(f"{s}s");
        }
    }
    if micros > 0 {
        out.push_str(f"{micros}us");
    }
    out
}

fn freqstr(o: ref Off) -> String {
    let code = match rule_code(o) {
        Some(c) => c,
        None => return off_repr(o),
    };
    let mut f = if o.n != 1 { f"{o.n}{code}" } else { code };
    if (o.k == K.BDay or o.k == K.CBDay) and o.offset != 0 {
        f.push_str(offset_str(o.offset));
    }
    f
}

// ------------------------------------------------------------ month arithmetic

fn opt_day(y: i64, m: i64, opt: i64) -> i64 {
    if opt == OPT_START {
        1
    } else if opt == OPT_END {
        days_in_month(y, m)
    } else if opt == OPT_BSTART {
        first_bday(y, m)
    } else {
        last_bday(y, m)
    }
}

// shift_month: the same time of day `months` months on, on the day the
// option names (OPT_NONE keeps the day, clipped; a positive option is a
// day of the month, clipped).
fn shift_month(w: i64, months: i64, opt: i64) -> i64 {
    let t = dt_of(w);
    let mut dy = floor_div(t.mo + months, 12);
    let mut month = floor_mod(t.mo + months, 12);
    if month == 0 {
        month = 12;
        dy -= 1;
    }
    let year = t.y + dy;
    let dim = days_in_month(year, month);
    let day = if opt == OPT_NONE {
        if t.d < dim { t.d } else { dim }
    } else if opt > 0 {
        if opt < dim { opt } else { dim }
    } else {
        opt_day(year, month, opt)
    };
    with_date(w, year, month, day)
}

fn roll_convention(other: i64, n0: i64, compare: i64) -> i64 {
    let mut n = n0;
    if n > 0 and other < compare {
        n -= 1;
    } else if n <= 0 and other > compare {
        n += 1;
    }
    n
}

fn roll_qtrday(w: i64, n0: i64, month: i64, opt: i64, modby: i64) -> i64 {
    let t = dt_of(w);
    let months_since = if modby == 12 { t.mo - month } else { t.mo % modby - month % modby };
    let mut n = n0;
    let dom = opt_day(t.y, t.mo, opt);
    if n > 0 {
        if months_since < 0 or (months_since == 0 and t.d < dom) {
            n -= 1;
        }
    } else if months_since > 0 or (months_since == 0 and t.d > dom) {
        n += 1;
    }
    n
}

// ------------------------------------------------------------ business days

fn bday_adjust(n0: i64, wday: i64, weeks: i64) -> i64 {
    let mut n = n0;
    if n <= 0 and wday > 4 {
        n += 1;
    }
    n -= 5 * weeks;
    if n == 0 and wday > 4 {
        4 - wday
    } else if wday > 4 {
        (7 - wday) + (n - 1)
    } else if wday + n <= 4 {
        n
    } else {
        n + 2
    }
}

// BusinessDay(n)._apply, without the offset.
fn bday_step(n: i64, w: i64) -> i64 {
    let wday = weekday_of(day_of(w));
    let weeks = floor_div(n, 5);
    let days = bday_adjust(n, wday, weeks);
    w + (7 * weeks + days) * NS_D
}

// CustomBusinessDay(n)._apply, without the offset.
fn cbday_step(cal: ref BusCal, n: i64, w: i64) -> i64 {
    let roll = if n <= 0 { "forward" } else { "backward" };
    match busday_offset(cal, day_of(w), n, roll) {
        Ok(Some(u)) => u * NS_D + time_of(w),
        _ => w,
    }
}

// The next business day on or after (forward) or on or before a date,
// keeping the time: CustomBusinessDay(1)'s rollforward / rollback.
fn cbday_roll(cal: ref BusCal, w: i64, forward: bool) -> i64 {
    let u = day_of(w);
    if is_bus(cal, u) {
        return w;
    }
    let to = if forward { roll_forward_day(cal, u) } else { roll_backward_day(cal, u) };
    to * NS_D + time_of(w)
}

// ------------------------------------------------------------ business hours

fn bh_secs(st: i64, en: i64) -> i64 {
    if st < en { en - st } else { en + 86400 - st }
}

fn nb_is_on(o: ref Off, w: i64) -> bool {
    if o.k == K.Cbh {
        is_bus(o.cal, day_of(w))
    } else {
        weekday_of(day_of(w)) < 5
    }
}

fn nb_step(o: ref Off, n: i64, w: i64) -> i64 {
    if o.k == K.Cbh { cbday_step(o.cal, n, w) } else { bday_step(n, w) }
}

fn next_opening(o: ref Off, n: i64, w0: i64, sign: i64) -> i64 {
    let earliest = o.starts[0];
    let latest = o.starts[o.starts.len() - 1];
    let same = if n == 0 { sign > 0 } else { n * sign >= 0 };
    let nb = if n >= 0 { 1 } else { -1 };
    let mut w = w0;
    let t = time_of(w);
    let mut hm = earliest;
    if not nb_is_on(o, w) {
        w = nb_step(o, sign * nb, w);
        hm = if same { earliest } else { latest };
    } else if same {
        if latest * NS_S < t {
            w = nb_step(o, sign * nb, w);
            hm = earliest;
        } else {
            for st in o.starts.iter() {
                if t <= *st * NS_S {
                    hm = *st;
                    break;
                }
            }
        }
    } else if t < earliest * NS_S {
        w = nb_step(o, sign * nb, w);
        hm = latest;
    } else {
        let mut i = o.starts.len();
        while i > 0 {
            i -= 1;
            if t >= o.starts[i] * NS_S {
                hm = o.starts[i];
                break;
            }
        }
    }
    day_of(w) * NS_D + hm * NS_S
}

fn prev_opening(o: ref Off, n: i64, w: i64) -> i64 {
    next_opening(o, n, w, -1)
}

fn closing(o: ref Off, w: i64) -> i64 {
    let t = time_of(w);
    for i in 0..o.starts.len() {
        if o.starts[i] * NS_S == t {
            return w + bh_secs(o.starts[i], o.ends[i]) * NS_S;
        }
    }
    w
}

fn bh_on(o: ref Off, n: i64, w: i64) -> bool {
    let op = if n >= 0 { prev_opening(o, n, w) } else { next_opening(o, n, w, 1) };
    let span = w - op;
    let mut hours = 0;
    let t = time_of(op);
    for i in 0..o.starts.len() {
        if o.starts[i] * NS_S == t {
            hours = bh_secs(o.starts[i], o.ends[i]);
        }
    }
    span <= hours * NS_S
}

fn bh_apply(o: ref Off, n: i64, w0: i64) -> i64 {
    let nano = floor_mod(w0, 1000);
    let mut w = w0 - nano;
    if n >= 0 {
        let t = time_of(w);
        if o.ends.iter().any(|e| *e * NS_S == t) or not bh_on(o, n, w) {
            w = next_opening(o, n, w, 1);
        }
    } else {
        let t = time_of(w);
        if o.starts.iter().any(|s| *s * NS_S == t) {
            w -= NS_S;
        }
        if not bh_on(o, n, w) {
            w = next_opening(o, n, w, 1);
            w = closing(o, w);
        }
    }
    let mut total = 0;
    for i in 0..o.starts.len() {
        total += bh_secs(o.starts[i], o.ends[i]);
    }
    let per_day = total / 60;
    let mut bd = (n * 60).abs() / per_day;
    let mut r = (n * 60).abs() % per_day;
    if n < 0 {
        bd = -bd;
        r = -r;
    }
    if bd != 0 {
        if not nb_is_on(o, w) {
            let prev_open = prev_opening(o, n, w);
            let remain = w - prev_open;
            w = nb_step(o, bd, prev_open) + remain;
        } else {
            w = nb_step(o, bd, w);
        }
    }
    let mut rem = r * NS_MIN;
    if n >= 0 {
        while rem != 0 {
            let bhour = closing(o, prev_opening(o, n, w)) - w;
            if rem < bhour {
                w += rem;
                rem = 0;
            } else {
                rem -= bhour;
                w = next_opening(o, n, w + bhour, 1);
            }
        }
    } else {
        while rem != 0 {
            let bhour = next_opening(o, n, w, 1) - w;
            if rem > bhour or (rem == bhour and nano != 0) {
                w += rem;
                rem = 0;
            } else {
                rem -= bhour;
                w = closing(o, next_opening(o, n, w + bhour - NS_S, 1));
            }
        }
    }
    w
}

// ------------------------------------------------------------ the anchored kinds

fn wom_day(o: ref Off, w: i64) -> i64 {
    let t = dt_of(w);
    if o.k == K.Wom {
        let wday = weekday_of(days_from_civil(t.y, t.mo, 1));
        1 + floor_mod(o.weekday - wday, 7) + o.week * 7
    } else {
        let dim = days_in_month(t.y, t.mo);
        let wday = weekday_of(days_from_civil(t.y, t.mo, dim));
        dim - floor_mod(wday - o.weekday, 7)
    }
}

// FY5253.get_year_end for a year, as a day number.
fn fy_year_end(o: ref Off, y: i64) -> i64 {
    let target = days_from_civil(y, o.month, days_in_month(y, o.month));
    let diff = o.weekday - weekday_of(target);
    if diff == 0 {
        return target;
    }
    if o.last {
        target + floor_mod(diff, 7) - 7
    } else {
        let fwd = floor_mod(diff, 7);
        if fwd <= 3 { target + fwd } else { target + fwd - 7 }
    }
}

fn year_of_day(u: i64) -> i64 {
    let (y, _, _) = civil_from_days(u);
    y
}

fn fy_apply(o: ref Off, n0: i64, w: i64) -> i64 {
    let y = dt_of(w).y;
    let norm = day_of(w);
    let mut n = n0;
    let prev = fy_year_end(o, y - 1);
    let cur = fy_year_end(o, y);
    let next = fy_year_end(o, y + 1);
    if norm == prev {
        n -= 1;
    } else if norm == cur {
    } else if n > 0 {
        if norm < prev {
            n -= 2;
        } else if prev < norm and norm < cur {
            n -= 1;
        }
    } else if cur < norm and norm < next {
        n += 1;
    } else if prev < norm and norm < cur {
    } else if year_of_day(norm) == year_of_day(prev) and norm < prev and prev - norm <= 6 {
        n -= 1;
    }
    fy_year_end(o, y + n) * NS_D + time_of(w)
}

fn fy_is_on(o: ref Off, w: i64) -> bool {
    let u = day_of(w);
    let ye = fy_year_end(o, year_of_day(u));
    if o.last {
        ye == u
    } else {
        ye == u or fy_year_end(o, dt_of(shift_month(w, -1, OPT_NONE)).y) == u
    }
}

fn fy_rollback(o: ref Off, w: i64) -> i64 {
    if fy_is_on(o, w) { w } else { fy_apply(o, -1, w) }
}

fn fy_rollforward(o: ref Off, w: i64) -> i64 {
    if fy_is_on(o, w) { w } else { fy_apply(o, 1, w) }
}

fn fyq_weeks(o: ref Off, w: i64) -> Vec[i64] {
    let norm = day_of(w) * NS_D;
    let next_ye = fy_rollforward(o, norm);
    let prev_ye = fy_apply(o, -1, norm);
    let weeks = (next_ye - prev_ye) / NS_D / 7;
    let mut ret = vec![13, 13, 13, 13];
    if weeks == 53 {
        ret[o.qtr - 1] = 14;
    }
    ret
}

fn fyq_apply(o: ref Off, n0: i64, w: i64) -> i64 {
    let start = fy_rollback(o, w);
    let mut num_qtrs = 0;
    let mut tdelta = 0;
    if start < w {
        let lens = fyq_weeks(o, w);
        tdelta = w - start;
        for q in lens.iter() {
            if *q * 7 <= floor_div(tdelta, NS_D) {
                num_qtrs += 1;
                tdelta -= *q * 7 * NS_D;
            } else {
                break;
            }
        }
    }
    let mut res = start;
    let mut n = n0 + num_qtrs;
    if n0 <= 0 and tdelta > 0 {
        n += 1;
    }
    let years = floor_div(n, 4);
    if years != 0 {
        res = fy_apply(o, years, res);
        n -= years * 4;
    }
    let lens = fyq_weeks(o, res + NS_D);
    let mut weeks = 0;
    for i in 0..n {
        weeks += lens[i];
    }
    res + weeks * 7 * NS_D
}

fn fyq_is_on(o: ref Off, w: i64) -> bool {
    if fy_is_on(o, w) {
        return true;
    }
    let mut current = fy_apply(o, -1, w);
    for q in fyq_weeks(o, w).iter() {
        current += *q * 7 * NS_D;
        if current == w {
            return true;
        }
    }
    false
}

fn easter_apply(n0: i64, w: i64) -> i64 {
    let y = dt_of(w).y;
    let cur = easter_day(y) * NS_D;
    let mut n = n0;
    if n >= 0 and w < cur {
        n -= 1;
    } else if n < 0 and w > cur {
        n += 1;
    }
    easter_day(y + n) * NS_D + time_of(w)
}

// ------------------------------------------------------------ apply

// The wall-clock result of an offset with this n applied to wall-clock
// time w (the kinds apply_wraps runs on naive time).
fn apply_wall(o: ref Off, n: i64, w: i64) -> Result[i64, PyErr] {
    let k = o.k;
    let t = dt_of(w);
    let r = if k == K.BDay {
        bday_step(n, w) + o.offset
    } else if k == K.CBDay {
        cbday_step(o.cal, n, w) + o.offset
    } else if is_bh(k) {
        bh_apply(o, n, w)
    } else if is_month(k) {
        let opt = day_opt(k);
        let n2 = roll_convention(t.d, n, opt_day(t.y, t.mo, opt));
        shift_month(w, n2, opt)
    } else if k == K.CBMonthEnd or k == K.CBMonthBegin {
        let begin = k == K.CBMonthBegin;
        let cur = if begin { with_date(w, t.y, t.mo, 1) } else { with_date(w, t.y, t.mo, days_in_month(t.y, t.mo)) };
        let compare = cbday_roll(o.cal, cur, begin);
        let n2 = roll_convention(t.d, n, dt_of(compare).d);
        let new = shift_month(cur, n2, if begin { OPT_START } else { OPT_END });
        cbday_roll(o.cal, new, begin) + o.offset
    } else if k == K.SemiMonthEnd or k == K.SemiMonthBegin {
        let start = k == K.SemiMonthBegin;
        let mut n2 = roll_convention(t.d, n, o.dom);
        let dim = days_in_month(t.y, t.mo);
        if start and n <= 0 and t.d == 1 {
            n2 -= 1;
        } else if not start and n > 0 and t.d == dim {
            n2 += 1;
        }
        let odd = floor_mod(n2, 2) != 0;
        if start {
            let months = floor_div(n2, 2) + floor_mod(n2, 2);
            shift_month(w, months, if odd { 1 } else { o.dom })
        } else {
            shift_month(w, floor_div(n2, 2), if odd { 31 } else { o.dom })
        }
    } else if k == K.Week {
        if o.weekday < 0 {
            w + n * 7 * NS_D
        } else {
            let mut kk = n;
            let mut x = w;
            let od = weekday_of(day_of(w));
            if od != o.weekday {
                x += floor_mod(o.weekday - od, 7) * NS_D;
                if kk > 0 {
                    kk -= 1;
                }
            }
            x + kk * 7 * NS_D
        }
    } else if k == K.Wom or k == K.Lwom {
        let months = roll_convention(t.d, n, wom_day(o, w));
        let shifted = shift_month(w, months, OPT_START);
        shifted + (wom_day(o, shifted) - 1) * NS_D
    } else if is_quarter(k) or is_half(k) {
        let modby = if is_quarter(k) { 3 } else { 6 };
        let opt = day_opt(k);
        let since = t.mo % modby - o.month % modby;
        let q = roll_qtrday(w, n, o.month, opt, modby);
        shift_month(w, q * modby - since, opt)
    } else if is_year(k) {
        let opt = day_opt(k);
        let years = roll_qtrday(w, n, o.month, opt, 12);
        shift_month(w, years * 12 + (o.month - t.mo), opt)
    } else if k == K.Fy5253 {
        fy_apply(o, n, w)
    } else if k == K.Fy5253q {
        fyq_apply(o, n, w)
    } else if k == K.Easter {
        easter_apply(n, w)
    } else if k == K.DateOffset {
        if o.use_rd {
            rd_add(rd_times(o.rd, n), w)?
        } else if o.kw.len() == 0 {
            w + n * NS_D
        } else {
            w + n * (o.td + o.nanos)
        }
    } else {
        w + n * NS_D
    };
    Ok(r)
}

// ts + offset with this n: apply_wraps around apply_wall, or a tick's
// absolute step.
fn off_apply(o: ref Off, n: i64, ts: ref Ts) -> Result[Ts, PyErr] {
    if is_tick(o.k) {
        return Ok(Ts { v: ts.v + n * tick_ns(o.k), tz: ts.tz.clone() });
    }
    if o.k == K.DateOffset and not o.use_rd and o.kw.len() > 0 {
        let mut r = Ts { v: ts.v + n * (o.td + o.nanos), tz: ts.tz.clone() };
        if o.normalize {
            r = ts_at(r, day_of(ts_wall(r)) * NS_D);
        }
        return Ok(r);
    }
    let w = ts_wall(ts);
    let nano = floor_mod(w, 1000);
    let rw = apply_wall(o, n, w)?;
    let mut res = ts_at(ts, rw);
    if o.normalize {
        res = ts_at(res, day_of(ts_wall(res)) * NS_D);
    } else if nano != 0 and not (o.k == K.DateOffset and o.nanos != 0) {
        let x = ts_wall(res);
        if floor_mod(x, 1000) != nano {
            res = ts_at(res, x + nano);
        }
    }
    Ok(res)
}

// is_on_offset for an offset with this n.
fn off_is_on(o: ref Off, n: i64, ts: ref Ts) -> Result[bool, PyErr] {
    let w = ts_wall(ts);
    if is_tick(o.k) or o.k == K.Day {
        return Ok(true);
    }
    if o.normalize and not is_midnight(w) {
        return Ok(false);
    }
    let t = dt_of(w);
    let k = o.k;
    let on = if k == K.BDay {
        weekday_of(day_of(w)) < 5
    } else if k == K.CBDay {
        is_bus(o.cal, day_of(w))
    } else if is_bh(k) {
        bh_on(o, n, w)
    } else if is_month(k) {
        t.d == opt_day(t.y, t.mo, day_opt(k))
    } else if k == K.SemiMonthEnd {
        t.d == o.dom or t.d == days_in_month(t.y, t.mo)
    } else if k == K.SemiMonthBegin {
        t.d == 1 or t.d == o.dom
    } else if k == K.Week {
        o.weekday < 0 or weekday_of(day_of(w)) == o.weekday
    } else if k == K.Wom or k == K.Lwom {
        t.d == wom_day(o, w)
    } else if is_quarter(k) {
        floor_mod(t.mo - o.month, 3) == 0 and t.d == opt_day(t.y, t.mo, day_opt(k))
    } else if is_half(k) {
        floor_mod(t.mo - o.month, 6) == 0 and t.d == opt_day(t.y, t.mo, day_opt(k))
    } else if is_year(k) {
        t.mo == o.month and t.d == opt_day(t.y, o.month, day_opt(k))
    } else if k == K.Fy5253 {
        fy_is_on(o, w)
    } else if k == K.Fy5253q {
        fyq_is_on(o, w)
    } else if k == K.Easter {
        day_of(w) == easter_day(t.y)
    } else if k == K.DateOffset {
        true
    } else {
        let a = off_apply(o, n, ts)?;
        let b = off_apply(o, -n, a)?;
        b.v == ts.v
    };
    Ok(on)
}

fn normalized(ts: ref Ts) -> Ts {
    ts_at(ts, day_of(ts_wall(ts)) * NS_D)
}

fn off_rollforward(o: ref Off, ts: ref Ts) -> Result[Ts, PyErr] {
    if is_bh(o.k) {
        let w = ts_wall(ts);
        let r = if off_is_on(o, o.n, ts)? {
            w
        } else if o.n >= 0 {
            next_opening(o, o.n, w, 1)
        } else {
            prev_opening(o, o.n, w)
        };
        let mut res = ts_at(ts, r);
        if o.normalize {
            res = normalized(res);
        }
        return Ok(res);
    }
    if off_is_on(o, o.n, ts)? {
        Ok(ts.clone())
    } else {
        off_apply(o, 1, ts)
    }
}

fn off_rollback(o: ref Off, ts: ref Ts) -> Result[Ts, PyErr] {
    if is_bh(o.k) {
        let w = ts_wall(ts);
        let r = if off_is_on(o, o.n, ts)? {
            w
        } else {
            let op = if o.n >= 0 { prev_opening(o, o.n, w) } else { next_opening(o, o.n, w, 1) };
            closing(o, op)
        };
        let mut res = ts_at(ts, r);
        if o.normalize {
            res = normalized(res);
        }
        return Ok(res);
    }
    let mut t = ts.clone();
    if o.normalize and not is_midnight(ts_wall(ts)) {
        t = normalized(t);
    }
    if off_is_on(o, o.n, t)? {
        Ok(t)
    } else {
        off_apply(o, -1, t)
    }
}

// ============================================================ holiday calendars

const OBS_NONE: i64 = 0;
const OBS_NEAREST: i64 = 1;
const OBS_NEXT_MONDAY: i64 = 2;
const OBS_NEXT_MONDAY_OR_TUESDAY: i64 = 3;

// One step of a Holiday's offset list: DateOffset(weekday=XX(nth)),
// Easter(), or Day(n).
#[derive(Copy, Clone)]
enum Step {
    Wd(i64, i64),
    EasterSunday,
    Days(i64),
}

#[derive(Clone)]
struct Rule {
    name: String,
    month: i64,
    day: i64,
    start: Option[i64],
    observance: i64,
    steps: Vec[Step],
}

fn rule(name: Str, month: i64, day: i64, observance: i64) -> Rule {
    Rule { name: name.to_string(), month: month, day: day, start: None, observance: observance, steps: Vec.new() }
}

fn rule_wd(name: Str, month: i64, day: i64, wd: i64, nth: i64) -> Rule {
    let mut r = rule(name, month, day, OBS_NONE);
    r.steps.push(Step.Wd(wd, nth));
    r
}

fn rule_from(r0: own Rule, y: i64, m: i64, d: i64) -> Rule {
    let mut r = r0;
    r.start = Some(days_from_civil(y, m, d));
    r
}

fn good_friday() -> Rule {
    let mut r = rule("Good Friday", 1, 1, OBS_NONE);
    r.steps.push(Step.EasterSunday);
    r.steps.push(Step.Days(-2));
    r
}

fn easter_monday() -> Rule {
    let mut r = rule("Easter Monday", 1, 1, OBS_NONE);
    r.steps.push(Step.EasterSunday);
    r.steps.push(Step.Days(1));
    r
}

fn us_mlk() -> Rule {
    rule_from(rule_wd("Birthday of Martin Luther King, Jr.", 1, 1, 0, 3), 1986, 1, 1)
}

fn known_calendar(name: Str) -> bool {
    name == "us" or name == "nyse" or name == "uk"
}

// USFederalHolidayCalendar, and the NYSE and UK calendars the oracle
// defines from pandas' rules.
fn calendar_rules(name: Str) -> Vec[Rule] {
    let mut rs: Vec[Rule] = Vec.new();
    if name == "us" {
        rs.push(rule("New Year's Day", 1, 1, OBS_NEAREST));
        rs.push(us_mlk());
        rs.push(rule_wd("Washington's Birthday", 2, 1, 0, 3));
        rs.push(rule_wd("Memorial Day", 5, 31, 0, -1));
        rs.push(rule_from(rule("Juneteenth National Independence Day", 6, 19, OBS_NEAREST), 2021, 6, 18));
        rs.push(rule("Independence Day", 7, 4, OBS_NEAREST));
        rs.push(rule_wd("Labor Day", 9, 1, 0, 1));
        rs.push(rule_wd("Columbus Day", 10, 1, 0, 2));
        rs.push(rule("Veterans Day", 11, 11, OBS_NEAREST));
        rs.push(rule_wd("Thanksgiving Day", 11, 1, 3, 4));
        rs.push(rule("Christmas Day", 12, 25, OBS_NEAREST));
    } else if name == "nyse" {
        rs.push(rule("New Year's Day", 1, 1, OBS_NEAREST));
        rs.push(us_mlk());
        rs.push(rule_wd("Washington's Birthday", 2, 1, 0, 3));
        rs.push(good_friday());
        rs.push(rule_wd("Memorial Day", 5, 31, 0, -1));
        rs.push(rule_from(rule("Juneteenth", 6, 19, OBS_NEAREST), 2022, 1, 1));
        rs.push(rule("Independence Day", 7, 4, OBS_NEAREST));
        rs.push(rule_wd("Labor Day", 9, 1, 0, 1));
        rs.push(rule_wd("Thanksgiving Day", 11, 1, 3, 4));
        rs.push(rule("Christmas", 12, 25, OBS_NEAREST));
    } else {
        rs.push(rule("New Year's Day", 1, 1, OBS_NEXT_MONDAY));
        rs.push(good_friday());
        rs.push(easter_monday());
        rs.push(rule_wd("Early May bank holiday", 5, 1, 0, 1));
        rs.push(rule_wd("Spring bank holiday", 5, 31, 0, -1));
        rs.push(rule_wd("Summer bank holiday", 8, 31, 0, -1));
        rs.push(rule("Christmas Day", 12, 25, OBS_NEXT_MONDAY));
        rs.push(rule("Boxing Day", 12, 26, OBS_NEXT_MONDAY_OR_TUESDAY));
    }
    rs
}

fn observe(obs: i64, u: i64) -> i64 {
    let wd = weekday_of(u);
    if obs == OBS_NEAREST {
        if wd == 5 { u - 1 } else if wd == 6 { u + 1 } else { u }
    } else if obs == OBS_NEXT_MONDAY {
        if wd == 5 { u + 2 } else if wd == 6 { u + 1 } else { u }
    } else if obs == OBS_NEXT_MONDAY_OR_TUESDAY {
        if wd == 5 or wd == 6 { u + 2 } else if wd == 0 { u + 1 } else { u }
    } else {
        u
    }
}

fn step_day(s: Step, u: i64) -> i64 {
    match s {
        Step.Wd(wd, nth) => {
            let cur = weekday_of(u);
            if nth > 0 {
                u + (nth - 1) * 7 + floor_mod(wd - cur, 7)
            } else {
                u - ((-nth - 1) * 7 + floor_mod(cur - wd, 7))
            }
        }
        Step.EasterSunday => day_of(easter_apply(1, u * NS_D)),
        Step.Days(k) => u + k,
    }
}

// Holiday.dates(start, end): the rule's day in each year from the year
// before to the year after, observed or offset, kept inside the window.
fn rule_dates(r: ref Rule, start: i64, end: i64) -> Vec[i64] {
    let from = match r.start {
        Some(s) => s,
        None => start,
    };
    let mut out: Vec[i64] = Vec.new();
    let lo = if from > start { from } else { start };
    for y in year_of_day(from) - 1..year_of_day(end) + 2 {
        let mut u = days_from_civil(y, r.month, r.day);
        if r.observance != OBS_NONE {
            u = observe(r.observance, u);
        } else {
            for s in r.steps.iter() {
                u = step_day(*s, u);
            }
        }
        if u >= lo and u <= end {
            out.push(u);
        }
    }
    out
}

// AbstractHolidayCalendar.holidays(start, end, return_name=True), in
// date order.
fn calendar_holidays(name: Str, start: i64, end: i64) -> Vec[(i64, String)] {
    let mut all: Vec[(i64, String)] = Vec.new();
    for r in calendar_rules(name).iter() {
        for u in rule_dates(r, start, end).iter() {
            all.push((*u, r.name.clone()));
        }
    }
    all.sort_by(|a, b| a.0.cmp(b.0));
    all
}

// calendar.holidays() over the default window, 1970-01-01 to 2200-12-31.
fn calendar_days(name: Str) -> Vec[i64] {
    let hs = calendar_holidays(name, days_from_civil(1970, 1, 1), days_from_civil(2200, 12, 31));
    hs.iter().map(|h| h.0).collect()
}

// ============================================================ job values

// A value in a job's k=v or an offset's argument, as the oracle's
// value() reads it.
#[derive(Clone)]
enum V {
    I(i64),
    B(bool),
    L(Vec[String]),
    W(i64, i64),
    T(i64),
    S(String),
}

fn weekday_spec(v: Str) -> Option[(i64, i64)] {
    let names = ["MO", "TU", "WE", "TH", "FR", "SA", "SU"];
    if v.len() < 5 or not v.ends_with(")") {
        return None;
    }
    let head = v.substring(0, 2);
    let rest = v.substring(2);
    if not rest.starts_with("(") {
        return None;
    }
    let inner = rest.substring(1, rest.len() - 1);
    let nth = int_of(inner)?;
    if inner.starts_with("+") {
        return None;
    }
    for i in 0..7 {
        if names[i] == head {
            return Some((i, nth));
        }
    }
    None
}

fn value(v: Str, key: Str, warns: mut ref Vec[String]) -> Result[V, PyErr] {
    if (key == "weekmask" or key == "start" or key == "end") and not v.starts_with("[") {
        return Ok(V.S(v.to_string()));
    }
    if v.starts_with("td:") {
        return Ok(V.T(parse_timedelta(v.substring(3), mut warns)?));
    }
    if not v.starts_with("+") {
        if let Some(i) = int_of(v) {
            return Ok(V.I(i));
        }
    }
    if v == "True" or v == "False" {
        return Ok(V.B(v == "True"));
    }
    if v.starts_with("[") and v.ends_with("]") {
        let inner = v.substring(1, v.len() - 1);
        let items: Vec[String] = inner.split(";").filter(|x| x.len() > 0).map(|x| x.to_string()).collect();
        return Ok(V.L(items));
    }
    if let Some((wd, nth)) = weekday_spec(v) {
        return Ok(V.W(wd, nth));
    }
    Ok(V.S(v.to_string()))
}

fn v_text(v: ref V) -> String {
    match v {
        V.I(i) => i.to_string(),
        V.B(b) => if b { "True".to_string() } else { "False".to_string() },
        V.L(items) => {
            let quoted: Vec[String] = items.iter().map(|x| py_repr(x)).collect();
            f"[{join(quoted, ", ")}]"
        }
        V.W(wd, nth) => weekday_repr(wd, nth),
        V.T(t) => td_repr(t),
        V.S(s) => s.clone(),
    }
}

fn type_error(msg: Str) -> PyErr {
    py_err("TypeError", msg)
}

fn want_int(v: ref V, what: Str) -> Result[i64, PyErr] {
    match v {
        V.I(i) => Ok(i),
        V.B(b) => Ok(if b { 1 } else { 0 }),
        _ => Err(type_error(f"{what} must be an integer, got {v_text(v)}")),
    }
}

// time.strptime(s, "%H:%M") as seconds of the day.
fn business_time(s: Str) -> Result[i64, PyErr] {
    let bad = value_error("time data must match '%H:%M' format");
    let (h, m) = match s.split_once(":") {
        Some((a, b)) => (a.to_string(), b.to_string()),
        None => return Err(bad),
    };
    if h.len() < 1 or h.len() > 2 or m.len() < 1 or m.len() > 2 or not all_digits(h) or not all_digits(m) {
        return Err(bad);
    }
    let hv = i64.parse(h).ok() ?? 0;
    let mv = i64.parse(m).ok() ?? 0;
    if hv > 23 or mv > 59 {
        return Err(bad);
    }
    Ok(hv * 3600 + mv * 60)
}

fn time_list(v: ref V) -> Result[Vec[i64], PyErr] {
    let mut out: Vec[i64] = Vec.new();
    match v {
        V.S(s) => out.push(business_time(s)?),
        V.L(items) => {
            for x in items.iter() {
                out.push(business_time(x)?);
            }
        }
        _ => return Err(value_error("time data must be string or datetime.time")),
    }
    Ok(out)
}

fn holiday_days(items: ref Vec[String]) -> Result[Vec[i64], PyErr] {
    let mut out: Vec[i64] = Vec.new();
    for x in items.iter() {
        match parse_iso(x) {
            Some(w) => out.push(day_of(w)),
            None => return Err(value_error(f"Error parsing datetime string \"{x}\"")),
        }
    }
    Ok(out)
}

// A business calendar from weekmask, holidays and calendar= arguments.
fn make_cal(weekmask: Str, hols: ref Vec[i64], cal: Option[String]) -> Result[BusCal, PyErr] {
    let mask = parse_weekmask(weekmask)?;
    let mut all = hols.clone();
    if let Some(name) = cal {
        for u in calendar_days(name).iter() {
            all.push(*u);
        }
    }
    Ok(bus_cal(mask, all))
}

const RD_KWDS: Array[Str, 16] = ["year", "month", "day", "hour", "minute", "second", "microsecond", "weekday", "years", "months", "weeks", "days", "hours", "minutes", "seconds", "microseconds"];
const TD_KWDS: Array[Str, 5] = ["seconds", "microseconds", "milliseconds", "minutes", "hours"];

fn in_list(name: Str, list: ref Vec[Str]) -> bool {
    list.iter().any(|x| *x == name)
}

// DateOffset's keywords: _determine_offset, then the relativedelta or
// timedelta they build.
fn date_offset_kwds(o: mut ref Off, kw: ref Vec[(String, V)]) -> Result[(), PyErr] {
    let rd_set: Vec[Str] = RD_KWDS.iter().map(|x| *x).collect();
    let td_set: Vec[Str] = TD_KWDS.iter().map(|x| *x).collect();
    let mut names: Vec[String] = kw.iter().map(|p| p.0.clone()).collect();
    for (name, v) in kw.iter() {
        o.kw.push((name.clone(), v_text(v)));
    }
    o.kw.sort_by(|a, b| a.0.cmp(b.0));
    if kw.len() == 0 {
        return Ok(());
    }
    if names.iter().any(|n| n == "millisecond") {
        return Err(py_err("NotImplementedError", "Using DateOffset to replace `millisecond` component in datetime object is not supported. Use `microsecond=timestamp.microsecond % 1000 + ms * 1000` instead."));
    }
    let mut ns = 0;
    let mut rest: Vec[(String, V)] = Vec.new();
    for (name, v) in kw.iter() {
        if name == "nanosecond" or name == "nanoseconds" {
            if name == "nanoseconds" {
                ns = want_int(v, name)?;
            }
        } else {
            rest.push((name.clone(), v.clone()));
        }
    }
    o.nanos = ns;
    if rest.iter().all(|p| in_list(p.0, td_set)) {
        let mut td = 0;
        for (name, v) in rest.iter() {
            let x = want_int(v, name)?;
            td += x * match name.as_str() {
                "seconds" => NS_S,
                "microseconds" => NS_US,
                "milliseconds" => NS_MS,
                "minutes" => NS_MIN,
                _ => NS_H,
            };
        }
        o.td = td;
        return Ok(());
    }
    let mut r = empty_rd();
    let mut extra_micros = 0;
    for (name, v) in rest.iter() {
        if name == "milliseconds" {
            extra_micros += want_int(v, name)? * 1000;
            continue;
        }
        if not in_list(name, rd_set) {
            let quoted: Vec[String] = names.iter().map(|x| py_repr(x)).collect();
            return Err(value_error(f"Invalid argument/s or bad combination of arguments: [{join(quoted, ", ")}]"));
        }
        if name == "weekday" {
            match v {
                V.W(wd, nth) => {
                    r.weekday = wd;
                    r.nth = nth;
                }
                V.I(i) => r.weekday = i,
                _ => return Err(type_error("weekday must be a weekday")),
            }
            continue;
        }
        let x = want_int(v, name)?;
        match name.as_str() {
            "years" => r.years = x,
            "months" => r.months = x,
            "weeks" => r.days += 7 * x,
            "days" => r.days += x,
            "hours" => r.hours = x,
            "minutes" => r.minutes = x,
            "seconds" => r.seconds = x,
            "microseconds" => r.micros = x,
            "year" => r.year = x,
            "month" => r.month = x,
            "day" => r.day = x,
            "hour" => r.hour = x,
            "minute" => r.minute = x,
            "second" => r.second = x,
            _ => r.micro = x,
        }
    }
    r.micros += extra_micros;
    rd_fix(mut r);
    o.rd = r;
    o.use_rd = true;
    names.clear();
    Ok(())
}

// The offset a job spells `Name(args)`: a bare integer is n, k=v a
// keyword, cal=us|nyse|uk a holiday calendar.
fn build_offset(spec: Str, warns: mut ref Vec[String]) -> Result[Off, PyErr] {
    let open = match spec.find("(") {
        Some(i) => i,
        None => return Err(value_error(f"bad offset spec {spec}")),
    };
    if not spec.ends_with(")") {
        return Err(value_error(f"bad offset spec {spec}"));
    }
    let name = spec.substring(0, open);
    let args = spec.substring(open + 1, spec.len() - 1);
    let k = match kind_of(name) {
        Some(k) => k,
        None => return Err(py_err("AttributeError", f"module 'pandas.tseries.offsets' has no attribute {py_repr(name)}")),
    };
    let mut pos: Vec[V] = Vec.new();
    let mut kw: Vec[(String, V)] = Vec.new();
    let mut cal: Option[String] = None;
    if args.len() > 0 {
        for a in args.split(",") {
            match a.split_once("=") {
                Some((key, v)) => {
                    if key == "cal" {
                        cal = Some(v.to_string());
                    } else {
                        kw.push((key.to_string(), value(v, key, mut warns)?));
                    }
                }
                None => pos.push(value(a, "", mut warns)?),
            }
        }
    }
    let n = if pos.len() > 0 { want_int(pos[0], "`n` argument")? } else { 1 };
    let mut o = default_off(k, n);
    let mut weekmask = "Mon Tue Wed Thu Fri".to_string();
    let mut hols: Vec[i64] = Vec.new();
    let mut dkw: Vec[(String, V)] = Vec.new();
    let mut starts: Vec[i64] = vec![9 * 3600];
    let mut ends: Vec[i64] = vec![17 * 3600];
    for (key, v) in kw.iter() {
        let key_s = key.as_str();
        if key_s == "normalize" {
            o.normalize = match v {
                V.B(b) => b,
                V.I(i) => i != 0,
                _ => true,
            };
            continue;
        }
        if key_s == "n" {
            o.n = want_int(v, "`n` argument")?;
            continue;
        }
        if k == K.DateOffset {
            dkw.push((key.clone(), v.clone()));
            continue;
        }
        let ok = match key_s {
            "offset" => {
                if k == K.BDay or k == K.CBDay or is_bh(k) or k == K.CBMonthEnd or k == K.CBMonthBegin {
                    o.offset = match v {
                        V.T(t) => t,
                        _ => return Err(type_error("offset must be a timedelta")),
                    };
                    true
                } else {
                    false
                }
            }
            "weekmask" => {
                if is_custom(k) {
                    weekmask = v_text(v);
                    true
                } else {
                    false
                }
            }
            "holidays" => {
                if is_custom(k) {
                    match v {
                        V.L(items) => {
                            for u in holiday_days(items)?.iter() {
                                hols.push(*u);
                            }
                        }
                        V.S(s) => {
                            let one = vec![s.clone()];
                            for u in holiday_days(one)?.iter() {
                                hols.push(*u);
                            }
                        }
                        _ => return Err(type_error("holidays must be a list of dates")),
                    }
                    true
                } else {
                    false
                }
            }
            "start" | "end" => {
                if is_bh(k) {
                    let ts = time_list(v)?;
                    if key_s == "start" {
                        starts = ts;
                    } else {
                        ends = ts;
                    }
                    true
                } else {
                    false
                }
            }
            "day_of_month" => {
                if k == K.SemiMonthEnd or k == K.SemiMonthBegin {
                    o.dom = want_int(v, "day_of_month")?;
                    true
                } else {
                    false
                }
            }
            "weekday" => {
                if k == K.Week or k == K.Wom or k == K.Lwom or k == K.Fy5253 or k == K.Fy5253q {
                    o.weekday = want_int(v, "weekday")?;
                    true
                } else {
                    false
                }
            }
            "week" => {
                if k == K.Wom {
                    o.week = want_int(v, "week")?;
                    true
                } else {
                    false
                }
            }
            "startingMonth" => {
                if is_quarter(k) or is_half(k) or k == K.Fy5253 or k == K.Fy5253q {
                    o.month = want_int(v, "startingMonth")?;
                    true
                } else {
                    false
                }
            }
            "month" => {
                if is_year(k) {
                    o.month = want_int(v, "month")?;
                    true
                } else {
                    false
                }
            }
            "variation" => {
                if k == K.Fy5253 or k == K.Fy5253q {
                    let t = v_text(v);
                    if t != "nearest" and t != "last" {
                        return Err(value_error(f"{t} is not a valid variation"));
                    }
                    o.last = t == "last";
                    true
                } else {
                    false
                }
            }
            "qtr_with_extra_week" => {
                if k == K.Fy5253q {
                    o.qtr = want_int(v, "qtr_with_extra_week")?;
                    true
                } else {
                    false
                }
            }
            "method" => {
                if k == K.Easter {
                    o.method = want_int(v, "method")?;
                    true
                } else {
                    false
                }
            }
            _ => false,
        };
        if not ok {
            return Err(type_error(f"__init__() got an unexpected keyword argument {py_repr(key)}"));
        }
    }
    if let Some(ref c) = cal {
        if not is_custom(k) {
            return Err(type_error("__init__() got an unexpected keyword argument 'calendar'"));
        }
        if not known_calendar(c) {
            return Err(py_err("KeyError", py_repr(c)));
        }
    }
    if is_custom(k) {
        o.cal = make_cal(weekmask, hols, cal)?;
    }
    if is_bh(k) {
        if starts.len() != ends.len() {
            return Err(value_error("number of starting time and ending time must be the same"));
        }
        let mut pairs: Vec[(i64, i64)] = Vec.new();
        for i in 0..starts.len() {
            pairs.push((starts[i], ends[i]));
        }
        pairs.sort_by(|a, b| a.0.cmp(b.0));
        o.starts = pairs.iter().map(|p| p.0).collect();
        o.ends = pairs.iter().map(|p| p.1).collect();
        let mut total = 0;
        let m = pairs.len();
        for i in 0..m {
            total += bh_secs(o.starts[i], o.ends[i]);
            total += bh_secs(o.ends[i], o.starts[(i + 1) % m]);
        }
        if total != 86400 {
            return Err(value_error("invalid starting and ending time(s): opening hours should not touch or overlap with one another"));
        }
    }
    if k == K.DateOffset {
        date_offset_kwds(mut o, dkw)?;
    }
    validate_off(o)?;
    Ok(o)
}

// The checks the constructors make.
fn validate_off(o: ref Off) -> Result[(), PyErr] {
    let k = o.k;
    if (is_tick(k) or k == K.Day) and o.normalize {
        let what = if k == K.Day { "Day" } else { "Tick" };
        return Err(value_error(f"{what} offset with `normalize=True` are not allowed."));
    }
    if (k == K.Lwom or k == K.Fy5253 or k == K.Fy5253q) and o.n == 0 {
        return Err(value_error("N cannot be 0"));
    }
    if (k == K.Week and o.weekday >= 0 or k == K.Wom or k == K.Lwom) and o.weekday > 6 {
        return Err(value_error(f"Day must be 0<=day<=6, got {o.weekday}"));
    }
    if k == K.Wom and (o.week < 0 or o.week > 3) {
        return Err(value_error(f"Week must be 0<=week<=3, got {o.week}"));
    }
    if k == K.SemiMonthEnd or k == K.SemiMonthBegin {
        let lo = if k == K.SemiMonthEnd { 1 } else { 2 };
        if o.dom < lo or o.dom > 27 {
            return Err(value_error(f"day_of_month must be {lo}<=day_of_month<=27, got {o.dom}"));
        }
    }
    if is_year(k) and (o.month < 1 or o.month > 12) {
        return Err(value_error("Month must go from 1 to 12"));
    }
    if k == K.Easter and (o.method < 1 or o.method > 3) {
        return Err(value_error(f"Method must be 1<=method<=3, got {o.method}"));
    }
    Ok(())
}

// ============================================================ to_offset

fn add_warning(warns: mut ref Vec[String], cat: Str, msg: Str) {
    let line = f"warn: {cat}: {msg}";
    if not warns.iter().any(|w| *w == line) {
        warns.push(line.clone());
    }
}

fn months_upper() -> Vec[String] {
    MONTH_CODE.iter().map(|m| m.to_string()).collect()
}

// c_OFFSET_RENAMED_FREQSTR.
fn renamed_freq(alias: Str) -> Option[String] {
    let (head, tail) = match alias.split_once("-") {
        Some((a, b)) => (a.to_string(), Some(b.to_string())),
        None => (alias.to_string(), None),
    };
    let to = match head.as_str() {
        "M" => "ME",
        "Q" => "QE",
        "Y" => "YE",
        "BY" => "BYE",
        "BQ" => "BQE",
        "BM" => "BME",
        "CBM" => "CBME",
        "SM" => "SME",
        _ => return None,
    };
    match tail {
        None => Some(to.to_string()),
        Some(t) => {
            let monthly = head == "Q" or head == "Y" or head == "BY" or head == "BQ";
            if monthly and months_upper().iter().any(|m| *m == t) {
                Some(f"{to}-{t}")
            } else {
                None
            }
        }
    }
}

// c_OFFSET_TO_PERIOD_FREQSTR.
fn offset_to_period(alias: Str) -> Option[String] {
    let fixed = match alias {
        "WEEKDAY" => "D",
        "EOM" | "BME" | "SME" | "BMS" | "CBME" | "CBMS" | "SMS" | "MS" | "ME" => "M",
        "BQS" | "QS" | "BQE" | "QE" => "Q",
        "D" => "D",
        "B" => "B",
        "min" => "min",
        "s" => "s",
        "ms" => "ms",
        "us" => "us",
        "ns" => "ns",
        "h" => "h",
        "YE" | "BYE" | "YS" | "BYS" => "Y",
        "W" => "W",
        _ => "",
    };
    if fixed.len() > 0 {
        return Some(fixed.to_string());
    }
    let (head, tail) = alias.split_once("-")?;
    if not months_upper().iter().any(|m| *m == tail) {
        return None;
    }
    match head {
        "BQE" | "QE" => Some(f"Q-{tail}"),
        "YE" | "BYE" => Some(f"Y-{tail}"),
        _ => None,
    }
}

// c_PERIOD_TO_OFFSET_FREQSTR.
fn period_to_offset(alias: Str) -> Option[String] {
    match alias {
        "M" => return Some("ME".to_string()),
        "Q" => return Some("QE".to_string()),
        "Y" => return Some("YE".to_string()),
        _ => {}
    }
    let (head, tail) = alias.split_once("-")?;
    if not months_upper().iter().any(|m| *m == tail) {
        return None;
    }
    match head {
        "Q" => Some(f"QE-{tail}"),
        "Y" => Some(f"YE-{tail}"),
        _ => None,
    }
}

// c_PERIOD_AND_OFFSET_DEPR_FREQSTR.
fn depr_alias(name: Str) -> Option[String] {
    let to = match name {
        "w" => "W",
        "w-mon" => "W-MON",
        "w-tue" => "W-TUE",
        "w-wed" => "W-WED",
        "w-thu" => "W-THU",
        "w-fri" => "W-FRI",
        "w-sat" => "W-SAT",
        "w-sun" => "W-SUN",
        "d" => "D",
        "b" => "B",
        "c" => "C",
        "MIN" => "min",
        "US" => "us",
        "NS" => "ns",
        _ => return None,
    };
    Some(to.to_string())
}

fn is_depr_value(name: Str) -> bool {
    match name {
        "W" | "W-MON" | "W-TUE" | "W-WED" | "W-THU" | "W-FRI" | "W-SAT" | "W-SUN" | "D" | "B" | "C" | "min" | "us" | "ns" => true,
        _ => false,
    }
}

fn lite_alias(name: Str) -> String {
    let to = match name {
        "W" => "W-SUN",
        "QE" => "QE-DEC",
        "YE" => "YE-DEC",
        "YS" => "YS-JAN",
        "BYE" => "BYE-DEC",
        "BYS" => "BYS-JAN",
        "Min" => "min",
        _ => name,
    };
    to.to_string()
}

fn deprec_to_valid(freq: Str) -> Option[String] {
    let to = match freq {
        "H" => "h",
        "BH" => "bh",
        "CBH" => "cbh",
        "T" => "min",
        "S" => "s",
        "L" => "ms",
        "U" => "us",
        "N" => "ns",
        "AS" => "YS",
        "A" => "Y",
        _ => "",
    };
    if to.len() > 0 {
        return Some(to.to_string());
    }
    let (head, tail) = freq.split_once("-")?;
    if not months_upper().iter().any(|m| *m == tail) {
        return None;
    }
    match head {
        "AS" => Some(f"YS-{tail}"),
        "A" => Some(f"Y-{tail}"),
        _ => None,
    }
}

fn invalid_freq(freq: Str, extra: Option[String]) -> PyErr {
    let mut msg = f"Invalid frequency: {freq}.";
    if let Some(e) = extra {
        msg.push_str(f" {e}");
    }
    if let Some(d) = deprec_to_valid(freq) {
        msg.push_str(f" Did you mean {d}?");
    }
    value_error(msg)
}

fn warn_deprecated_alias(name: Str, warns: mut ref Vec[String]) -> String {
    match name {
        "W" | "QE" | "YE" | "YS" | "BYE" | "BYS" | "Min" => return name.to_string(),
        _ => {}
    }
    if let Some(to) = depr_alias(name) {
        add_warning(mut warns, "Pandas4Warning", f"'{name}' is deprecated and will be removed in a future version, please use '{to}' instead.");
        return to;
    }
    for cand in [name.to_lowercase(), name.to_uppercase()].iter() {
        if *cand == name {
            continue;
        }
        if is_depr_value(cand) {
            add_warning(mut warns, "Pandas4Warning", f"'{name}' is deprecated and will be removed in a future version, please use '{cand}' instead.");
            return cand.clone();
        }
    }
    name.to_string()
}

fn validate_alias(alias: Str, is_period: bool) -> Result[(), PyErr] {
    if not is_period {
        let up = alias.to_uppercase();
        if let Some(to) = renamed_freq(up) {
            return Err(value_error(f"'{alias}' is no longer supported for offsets. Please use '{to}' instead."));
        }
        let low = alias.to_lowercase();
        let head = match up.split_once("-") {
            Some((h, _)) => h.to_string(),
            None => up.clone(),
        };
        if up != alias and low != "s" and low != "ms" and low != "us" and low != "ns" and (head.ends_with("S") or head.ends_with("E")) {
            return Err(invalid_freq(alias, None));
        }
    }
    if is_period {
        if let Some(to) = offset_to_period(alias) {
            if to != alias {
                return Err(value_error(f"for Period, please use '{to}' instead of '{alias}'"));
            }
        }
    }
    Ok(())
}

fn key_error(k: Str) -> PyErr {
    py_err("KeyError", py_repr(k))
}

fn month_of_code(code: Str) -> Result[i64, PyErr] {
    match month_number(code) {
        Some(m) => Ok(m),
        None => Err(key_error(code)),
    }
}

fn weekday_of_code(code: Str) -> Result[i64, PyErr] {
    for i in 0..7 {
        if DAY_CODE[i] == code {
            return Ok(i);
        }
    }
    Err(key_error(code))
}

fn prefix_kind(prefix: Str) -> Option[K] {
    let k = match prefix {
        "YS" => K.YearBegin,
        "YE" => K.YearEnd,
        "BYS" => K.BYearBegin,
        "BYE" => K.BYearEnd,
        "B" => K.BDay,
        "BMS" => K.BMonthBegin,
        "BME" => K.BMonthEnd,
        "BQE" => K.BQuarterEnd,
        "BQS" => K.BQuarterBegin,
        "BHYE" => K.BHalfYearEnd,
        "BHYS" => K.BHalfYearBegin,
        "bh" => K.Bh,
        "C" => K.CBDay,
        "CBME" => K.CBMonthEnd,
        "CBMS" => K.CBMonthBegin,
        "cbh" => K.Cbh,
        "ME" => K.MonthEnd,
        "MS" => K.MonthBegin,
        "ns" => K.Nano,
        "SME" => K.SemiMonthEnd,
        "SMS" => K.SemiMonthBegin,
        "W" => K.Week,
        "s" => K.Second,
        "min" => K.Minute,
        "us" => K.Micro,
        "QE" => K.QuarterEnd,
        "QS" => K.QuarterBegin,
        "HYE" => K.HalfYearEnd,
        "HYS" => K.HalfYearBegin,
        "ms" => K.Milli,
        "h" => K.Hour,
        "D" => K.Day,
        "WOM" => K.Wom,
        "LWOM" => K.Lwom,
        "RE" => K.Fy5253,
        "REQ" => K.Fy5253q,
        _ => return None,
    };
    Some(k)
}

// int(s) as Python reads it, with its error.
fn py_int(s: Str) -> Result[i64, PyErr] {
    let t = s.trim();
    match int_of(t) {
        Some(v) => Ok(v),
        None => Err(value_error(f"invalid literal for int() with base 10: {py_repr(s)}")),
    }
}

// klass._from_name(*suffixes).
fn from_name(k: K, parts: ref Vec[String]) -> Result[Off, PyErr] {
    let mut o = default_off(k, 1);
    let nsuf = parts.len();
    if is_year(k) {
        if nsuf > 0 and parts[0].len() > 0 {
            o.month = month_of_code(parts[0])?;
        }
    } else if is_quarter(k) or is_half(k) {
        if nsuf > 0 and parts[0].len() > 0 {
            o.month = month_of_code(parts[0])?;
        } else if k == K.BQuarterEnd or k == K.HalfYearEnd or k == K.BHalfYearEnd {
            o.month = 12;
        } else {
            o.month = 1;
        }
    } else if k == K.SemiMonthEnd or k == K.SemiMonthBegin {
        if nsuf > 0 {
            o.dom = py_int(parts[0])?;
        }
    } else if k == K.Week {
        if nsuf > 0 and parts[0].len() > 0 {
            o.weekday = weekday_of_code(parts[0])?;
        }
    } else if k == K.Wom {
        if nsuf == 0 or parts[0].len() == 0 {
            return Err(value_error("Prefix 'WOM' requires a suffix."));
        }
        let s = parts[0].clone();
        o.week = py_int(s.substring(0, 1))? - 1;
        o.weekday = weekday_of_code(s.substring(1))?;
    } else if k == K.Lwom {
        if nsuf == 0 or parts[0].len() == 0 {
            return Err(value_error("Prefix 'LWOM' requires a suffix."));
        }
        o.weekday = weekday_of_code(parts[0])?;
    } else if k == K.Fy5253 or k == K.Fy5253q {
        let want = if k == K.Fy5253 { 3 } else { 4 };
        if nsuf != want {
            return Err(type_error(f"FY5253._parse_suffix() takes 4 positional arguments but {nsuf + 1} were given"));
        }
        if parts[0] == "N" {
            o.last = false;
        } else if parts[0] == "L" {
            o.last = true;
        } else {
            return Err(value_error(f"Unable to parse varion_code: {parts[0]}"));
        }
        o.month = month_of_code(parts[1])?;
        o.weekday = weekday_of_code(parts[2])?;
        if k == K.Fy5253q {
            o.qtr = py_int(parts[3])?;
        }
    } else if nsuf > 0 and parts[0].len() > 0 {
        return Err(value_error(f"Bad freq suffix {parts[0]}"));
    }
    validate_off(o)?;
    Ok(o)
}

fn get_offset(name: Str) -> Result[Off, PyErr] {
    let parts: Vec[String] = name.split("-").map(|p| p.to_string()).collect();
    let rest: Vec[String] = parts.iter().skip(1).map(|p| p.clone()).collect();
    let r = match prefix_kind(parts[0]) {
        Some(k) => from_name(k, rest),
        None => Err(key_error(parts[0])),
    };
    match r {
        Ok(o) => Ok(o),
        Err(e) => Err(invalid_freq(name, Some(f"Failed to parse with error message: {exc_repr(e)}."))),
    }
}

// One opattern match: (separator before it, stride, name), scanning as
// re.split does.
fn freq_tokens(freq: Str) -> (Vec[(String, String, String)], String) {
    let b = freq.bytes();
    let n = b.len();
    let mut out: Vec[(String, String, String)] = Vec.new();
    let mut sep_from = 0;
    let mut i = 0;
    while i < n {
        let mut j = i;
        if b[j] == b'+' or b[j] == b'-' {
            j += 1;
        }
        while j < n and b[j] >= b'0' and b[j] <= b'9' {
            j += 1;
        }
        if j < n and b[j] == b'.' {
            j += 1;
            while j < n and b[j] >= b'0' and b[j] <= b'9' {
                j += 1;
            }
        }
        let stride_end = j;
        while j < n and (b[j] == b' ' or b[j] == b'\t') {
            j += 1;
        }
        let name_from = j;
        while j < n and ((b[j] >= b'A' and b[j] <= b'Z') or (b[j] >= b'a' and b[j] <= b'z')) {
            j += 1;
        }
        if j == name_from {
            i += 1;
            continue;
        }
        if j + 1 < n and b[j] == b'-' {
            let mut k = j + 1;
            while k < n and ((b[k] >= b'A' and b[k] <= b'Z') or (b[k] >= b'a' and b[k] <= b'z') or (b[k] >= b'0' and b[k] <= b'9') or b[k] == b'-') {
                k += 1;
            }
            if k > j + 1 {
                j = k;
            }
        }
        out.push((freq[sep_from..i].to_string(), freq[i..stride_end].to_string(), freq[name_from..j].to_string()));
        i = j;
        sep_from = j;
    }
    (out, freq[sep_from..n].to_string())
}

// Python's float(s) for a stride.
fn py_float(s: Str) -> Result[f64, PyErr] {
    match f64.parse(s) {
        Ok(x) => Ok(x),
        Err(_) => Err(value_error(f"could not convert string to float: {py_repr(s)}")),
    }
}

fn next_res(k: K) -> Option[K] {
    match k {
        K.Hour => Some(K.Minute),
        K.Minute => Some(K.Second),
        K.Second => Some(K.Milli),
        K.Milli => Some(K.Micro),
        K.Micro => Some(K.Nano),
        _ => None,
    }
}

fn res_factor(k: K) -> i64 {
    if k == K.Second or k == K.Milli or k == K.Micro { 1000 } else { 60 }
}

// Tick * float.
fn tick_times(k0: K, n0: i64, f: f64) -> Result[Off, PyErr] {
    let mut k = k0;
    let mut n = n0;
    loop {
        let x = f * n as f64;
        let frac = x - x.floor();
        if frac.abs() <= 1e-8 {
            return Ok(new_off(k, x.trunc() as i64));
        }
        match next_res(k) {
            Some(nk) => {
                n = n * res_factor(k);
                k = nk;
            }
            None => return Err(value_error("Could not convert to integer offset at any resolution")),
        }
    }
}

// delta_to_tick.
fn delta_tick(ns: i64) -> Off {
    if ns % NS_S == 0 {
        let secs = ns / NS_S;
        if secs % 3600 == 0 {
            new_off(K.Hour, secs / 3600)
        } else if secs % 60 == 0 {
            new_off(K.Minute, secs / 60)
        } else {
            new_off(K.Second, secs)
        }
    } else if ns % NS_MS == 0 {
        new_off(K.Milli, ns / NS_MS)
    } else if ns % NS_US == 0 {
        new_off(K.Micro, ns / NS_US)
    } else {
        new_off(K.Nano, ns)
    }
}

fn tick_name_kind(name: Str) -> Option[K] {
    match name {
        "D" => Some(K.Hour),
        "h" => Some(K.Hour),
        "min" => Some(K.Minute),
        "s" => Some(K.Second),
        "ms" => Some(K.Milli),
        "us" => Some(K.Micro),
        "ns" => Some(K.Nano),
        _ => None,
    }
}

fn to_offset_inner(freq: Str, is_period: bool, warns: mut ref Vec[String]) -> Result[Option[Off], PyErr] {
    let (toks, last) = freq_tokens(freq);
    if last.trim().len() > 0 {
        return Err(value_error("last element must be blank"));
    }
    let mut result: Option[Off] = None;
    let mut stride_sign = 0;
    for (idx, (sep, stride0, name0)) in toks.iter().enumerate() {
        let mut name = warn_deprecated_alias(name0, mut warns);
        validate_alias(name, is_period)?;
        if is_period {
            let up = name.to_uppercase();
            if let Some(to) = period_to_offset(up) {
                if up != name {
                    return Err(value_error(f"'{name}' is no longer supported, please use '{up}' instead."));
                }
                name = to;
            }
        }
        name = lite_alias(name);
        if sep.trim().len() > 0 {
            return Err(value_error("separator must be spaces"));
        }
        if stride_sign == 0 {
            stride_sign = if stride0.starts_with("-") { -1 } else { 1 };
        }
        let stride = if stride0.len() == 0 { "1".to_string() } else { stride0.clone() };
        let off = match tick_name_kind(name) {
            Some(tk) => {
                let base_n = if name == "D" { 24 } else { 1 };
                let mut o = tick_times(tk, base_n, py_float(stride)?)?;
                if idx != 0 {
                    o.n *= stride_sign;
                }
                o
            }
            None => {
                let s = py_int(stride)?;
                let mut o = get_offset(name)?;
                o.n = s.abs() * stride_sign;
                validate_off(o)?;
                o
            }
        };
        result = match result {
            None => Some(off),
            Some(prev) => {
                if is_tick(prev.k) and is_tick(off.k) {
                    if prev.k == off.k {
                        Some(new_off(prev.k, prev.n + off.n))
                    } else {
                        Some(delta_tick(prev.n * tick_ns(prev.k) + off.n * tick_ns(off.k)))
                    }
                } else {
                    return Err(type_error(f"unsupported operand type(s) for +: '{off_name(prev.k)}' and '{off_name(off.k)}'"));
                }
            }
        };
    }
    Ok(result)
}

fn has_period_code(o: ref Off) -> bool {
    match o.k {
        K.MonthEnd | K.QuarterEnd | K.YearEnd | K.Week | K.BDay | K.Day => true,
        _ => is_tick(o.k),
    }
}

// to_offset(freq, is_period).
fn to_offset(freq: Str, is_period: bool, warns: mut ref Vec[String]) -> Result[Off, PyErr] {
    let mut result = match to_offset_inner(freq, is_period, mut warns) {
        Ok(r) => r,
        Err(e) => {
            if e.kind == "ValueError" or e.kind == "TypeError" {
                return Err(invalid_freq(freq, Some(f"Failed to parse with error message: {exc_repr(e)}")));
            }
            return Err(e);
        }
    };
    if let Some(ref r) = result {
        if r.k == K.Hour and r.n % 24 == 0 and (freq.contains("d") or freq.contains("D")) {
            result = Some(new_off(K.Day, r.n / 24));
        }
    }
    let o = match result {
        Some(o) => o,
        None => return Err(invalid_freq(freq, None)),
    };
    if is_period and not has_period_code(o) {
        let code = rule_code(o) ?? off_repr(o);
        return Err(value_error(f"{code} is not supported as period frequency"));
    }
    Ok(o)
}

// ============================================================ Period

// A Period's frequency: the offset, its PeriodDtypeCode and n.
#[derive(Clone)]
struct Per {
    off: Off,
    code: i64,
    n: i64,
}

fn period_code(o: ref Off) -> i64 {
    match o.k {
        K.YearEnd => 1000 + o.month % 12,
        K.QuarterEnd => 2000 + o.month % 12,
        K.MonthEnd => 3000,
        K.Week => if o.weekday < 0 { 4000 } else { 4000 + (o.weekday + 1) % 7 },
        K.BDay => 5000,
        K.Day => 6000,
        K.Hour => 7000,
        K.Minute => 8000,
        K.Second => 9000,
        K.Milli => 10000,
        K.Micro => 11000,
        _ => 12000,
    }
}

fn group_of(code: i64) -> i64 {
    code / 1000 * 1000
}

// _period_code_to_abbrev.
fn code_abbrev(code: i64) -> String {
    let g = group_of(code);
    let sub = code - g;
    let month_end = if sub == 0 { 12 } else { sub };
    if g == 1000 {
        f"Y-{month_code(month_end)}"
    } else if g == 2000 {
        f"Q-{month_code(month_end)}"
    } else if g == 3000 {
        "M".to_string()
    } else if g == 4000 {
        let names = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"];
        f"W-{names[sub]}"
    } else {
        let s = match g {
            5000 => "B",
            6000 => "D",
            7000 => "h",
            8000 => "min",
            9000 => "s",
            10000 => "ms",
            11000 => "us",
            _ => "ns",
        };
        s.to_string()
    }
}

fn per_freqstr(p: ref Per) -> String {
    let a = code_abbrev(p.code);
    if p.n == 1 { a } else { f"{p.n}{a}" }
}

fn bday_warning(warns: mut ref Vec[String]) {
    add_warning(mut warns, "FutureWarning", "Period with BDay freq is deprecated and will be removed in a future version. Use a DatetimeIndex with BDay freq instead.");
}

// Period._maybe_convert_freq.
fn period_freq(freq: Str, warns: mut ref Vec[String]) -> Result[Per, PyErr] {
    let off = to_offset(freq, true, mut warns)?;
    if off.n <= 0 {
        return Err(value_error(f"Frequency must be positive, because it represents span: {freqstr(off)}"));
    }
    let code = period_code(off);
    let n = off.n;
    Ok(Per { off: off, code: code, n: n })
}

fn unit_by_index(i: i64) -> i64 {
    match i {
        6 => NS_D,
        7 => NS_H,
        8 => NS_MIN,
        9 => NS_S,
        10 => NS_MS,
        11 => NS_US,
        _ => 1,
    }
}

fn calc_end(code: i64) -> i64 {
    let g = group_of(code);
    if g == 4000 {
        code - g
    } else if g == 1000 or g == 2000 {
        let r = (code - g) % 12;
        if r == 0 { 12 } else { r }
    } else {
        0
    }
}

// asfreq_info.
#[derive(Copy, Clone)]
struct Af {
    is_end: i64,
    from_end: i64,
    to_end: i64,
    factor: i64,
}

fn upsample(af: Af, x: i64) -> i64 {
    if af.is_end == 1 { (x + 1) * af.factor - 1 } else { x * af.factor }
}

fn downsample(af: Af, x: i64) -> i64 {
    floor_div(x, af.factor)
}

fn adjust_month(y: i64, m: i64, from_end: i64) -> (i64, i64) {
    if from_end == 12 {
        return (y, m);
    }
    let mm = m + from_end;
    if mm > 12 { (y, mm - 12) } else { (y - 1, mm) }
}

fn adjust_qtr(y: i64, m: i64, to_end: i64) -> (i64, i64) {
    if to_end == 12 {
        return (y, m);
    }
    let mm = m - to_end;
    if mm <= 0 { (y, mm + 12) } else { (y + 1, mm) }
}

fn dtob(u0: i64, roll_back: i64) -> i64 {
    let dow = weekday_of(u0);
    let mut u = u0;
    if roll_back == 1 {
        if dow > 4 {
            u -= dow - 4;
        }
    } else if dow > 4 {
        u += 7 - dow;
    }
    floor_div(u + 4, 7) * 5 + floor_mod(u + 4, 7) - 4
}

// The A / Q / M / W to day (or finer) conversions.
fn coarse_to_dt(af: Af, g: i64, o: i64) -> i64 {
    if g == 4000 {
        return upsample(af, o * 7 + af.from_end - 4 + 6 * (af.is_end - 1));
    }
    let x = o + af.is_end;
    let (y, m) = if g == 1000 {
        adjust_month(x + 1970, 1, af.from_end)
    } else if g == 2000 {
        adjust_month(floor_div(x, 4) + 1970, floor_mod(x, 4) * 3 + 1, af.from_end)
    } else {
        (floor_div(x, 12) + 1970, floor_mod(x, 12) + 1)
    };
    upsample(af, days_from_civil(y, m, 1) - af.is_end)
}

// The day (or finer) to A / Q / M / W conversions.
fn dt_to_coarse(af: Af, g: i64, o: i64) -> i64 {
    let u = downsample(af, o);
    if g == 4000 {
        return floor_div(u + 3 - af.to_end, 7) + 1;
    }
    let (y, m, _) = civil_from_days(u);
    if g == 1000 {
        y - 1970 + if m > af.to_end { 1 } else { 0 }
    } else if g == 2000 {
        let (fy, fm) = adjust_qtr(y, m, af.to_end);
        (fy - 1970) * 4 + (fm - 1) / 3
    } else {
        (y - 1970) * 12 + m - 1
    }
}

fn b_to_dt(af: Af, o: i64) -> i64 {
    upsample(af, floor_div(o + 3, 5) * 7 + floor_mod(o + 3, 5) - 3)
}

// period_asfreq(ordinal, freq1, freq2, end).
fn p_asfreq(o: i64, f1: i64, f2: i64, end: bool) -> i64 {
    let g1 = group_of(f1);
    let g2 = group_of(f2);
    let i1 = (if g1 > 6000 { g1 } else { 6000 }) / 1000;
    let i2 = (if g2 > 6000 { g2 } else { 6000 }) / 1000;
    let lo = if i1 < i2 { i1 } else { i2 };
    let hi = if i1 < i2 { i2 } else { i1 };
    let af = Af { is_end: if end { 1 } else { 0 }, from_end: calc_end(f1), to_end: calc_end(f2), factor: unit_by_index(lo) / unit_by_index(hi) };
    let coarse1 = g1 <= 4000;
    let coarse2 = g2 <= 4000;
    if g1 == 5000 {
        if g2 == 5000 {
            o
        } else if coarse2 {
            dt_to_coarse(af, g2, b_to_dt(af, o))
        } else {
            b_to_dt(af, o)
        }
    } else if g2 == 5000 {
        if coarse1 {
            dtob(coarse_to_dt(af, g1, o), af.is_end)
        } else {
            dtob(downsample(af, o), 1 - af.is_end)
        }
    } else if coarse1 {
        if g1 == 3000 and g2 == 3000 {
            o
        } else if coarse2 {
            dt_to_coarse(af, g2, coarse_to_dt(af, g1, o))
        } else {
            coarse_to_dt(af, g1, o)
        }
    } else if coarse2 {
        dt_to_coarse(af, g2, o)
    } else if g1 > g2 {
        downsample(af, o)
    } else {
        upsample(af, o)
    }
}

// get_period_ordinal for a wall-clock time.
fn p_ordinal(w: i64, code: i64) -> i64 {
    let g = group_of(code);
    let t = dt_of(w);
    let u = day_of(w);
    if g == 1000 {
        t.y - 1970 + if t.mo > calc_end(code) { 1 } else { 0 }
    } else if g == 2000 {
        let (fy, fm) = adjust_qtr(t.y, t.mo, calc_end(code));
        (fy - 1970) * 4 + (fm - 1) / 3
    } else if g == 3000 {
        (t.y - 1970) * 12 + t.mo - 1
    } else if g == 4000 {
        floor_div(u + 3 - (code - 4000), 7) + 1
    } else if g == 5000 {
        dtob(u, 0)
    } else if g == 6000 {
        u
    } else {
        floor_div(w, unit_by_index(g / 1000))
    }
}

fn unix_date(o: i64, code: i64) -> i64 {
    if code == 6000 { o } else { p_asfreq(o, code, 6000, true) }
}

// get_date_info: the period's end day with its time of day, as wall ns.
fn date_info(o: i64, code: i64) -> i64 {
    let u = unix_date(o, code);
    let g = group_of(code);
    if g <= 6000 {
        return u * NS_D;
    }
    let f = unit_by_index(g / 1000);
    let sub = o - u * (NS_D / f);
    u * NS_D + sub * f
}

// get_yq: the fiscal year and quarter.
fn p_yq(o: i64, code: i64) -> (i64, i64) {
    let u = unix_date(o, code);
    let qcode = if group_of(code) == 2000 { code } else { 2000 };
    let (y, m, _) = civil_from_days(u);
    let (fy, fm) = adjust_qtr(y, m, calc_end(qcode));
    (fy, (fm - 1) / 3 + 1)
}

fn p_format(o: i64, code: i64) -> String {
    let g = group_of(code);
    let t = dt_of(date_info(o, code));
    if g == 1000 {
        t.y.to_string()
    } else if g == 2000 {
        let (fy, q) = p_yq(o, code);
        f"{fy}Q{q}"
    } else if g == 3000 {
        f"{t.y}-{pad(t.mo, 2)}"
    } else if g == 4000 {
        let left = p_asfreq(o, code, 6000, false);
        let right = p_asfreq(o, code, 6000, true);
        f"{date_text(left)}/{date_text(right)}"
    } else if g == 5000 or g == 6000 {
        date_text(day_of(date_info(o, code)))
    } else {
        let base = f"{t.y}-{pad(t.mo, 2)}-{pad(t.d, 2)} {pad(t.h, 2)}";
        if g == 7000 {
            f"{base}:00"
        } else if g == 8000 {
            f"{base}:{pad(t.mi, 2)}"
        } else if g == 9000 {
            f"{base}:{pad(t.mi, 2)}:{pad(t.s, 2)}"
        } else if g == 10000 {
            f"{base}:{pad(t.mi, 2)}:{pad(t.s, 2)}.{pad(t.ns / 1000000, 3)}"
        } else if g == 11000 {
            f"{base}:{pad(t.mi, 2)}:{pad(t.s, 2)}.{pad(t.ns / 1000, 6)}"
        } else {
            f"{base}:{pad(t.mi, 2)}:{pad(t.s, 2)}.{pad(t.ns, 9)}"
        }
    }
}

// The format period_format treats as its default for a group.
fn default_fmt(code: i64) -> Str {
    match group_of(code) {
        1000 => "%Y",
        2000 => "%FQ%q",
        3000 => "%Y-%m",
        5000 | 6000 => "%Y-%m-%d",
        7000 => "%Y-%m-%d %H:00",
        8000 => "%Y-%m-%d %H:%M",
        9000 => "%Y-%m-%d %H:%M:%S",
        10000 => "%Y-%m-%d %H:%M:%S.%l",
        11000 => "%Y-%m-%d %H:%M:%S.%u",
        12000 => "%Y-%m-%d %H:%M:%S.%n",
        _ => "",
    }
}

// Period.strftime: C strftime on the period's end, with pandas' %q,
// %f, %F, %l, %u and %n.
fn p_strftime(o: i64, code: i64, fmt: Str) -> String {
    if fmt == default_fmt(code) {
        return p_format(o, code);
    }
    let w = date_info(o, code);
    let t = dt_of(w);
    let u = day_of(w);
    let (fy, q) = p_yq(o, code);
    let dow = weekday_of(u);
    let yday = day_of_year(t.y, t.mo, t.d);
    let cs: Vec[char] = fmt.chars().collect();
    let mut out = String.new();
    let mut i = 0;
    while i < cs.len() {
        if cs[i] != '%' or i + 1 >= cs.len() {
            out.push(cs[i]);
            i += 1;
            continue;
        }
        let c = cs[i + 1];
        let piece = match c {
            'q' => q.to_string(),
            'f' => pad(floor_mod(fy, 100), 2),
            'F' => fy.to_string(),
            'l' => pad(t.ns / 1000000, 3),
            'u' => pad(t.ns / 1000, 6),
            'n' => pad(t.ns, 9),
            'Y' => t.y.to_string(),
            'y' => pad(floor_mod(t.y, 100), 2),
            'm' => pad(t.mo, 2),
            'd' => pad(t.d, 2),
            'H' => pad(t.h, 2),
            'M' => pad(t.mi, 2),
            'S' => pad(t.s, 2),
            'j' => pad(yday, 3),
            'a' => DAY_ABBR[dow].to_string(),
            'A' => DAY_FULL[dow].to_string(),
            'b' => MONTH_FULL[t.mo - 1].substring(0, 3),
            'B' => MONTH_FULL[t.mo - 1].to_string(),
            'W' => pad((yday - 1 + 7 - dow) / 7, 2),
            '%' => "%".to_string(),
            _ => {
                let mut s = String.new();
                s.push('%');
                s.push(c);
                s
            }
        };
        out.push_str(piece);
        i += 2;
    }
    out
}

fn p_repr(o: i64, p: ref Per) -> String {
    f"Period('{p_format(o, p.code)}', '{per_freqstr(p)}')"
}

// Period(value, freq) for a job's string value: an ISO date or time, a
// quarter like 2026Q1, or a week like 2026-11-23/2026-11-29.
fn period_value(value: Str, p: ref Per, warns: mut ref Vec[String]) -> Result[i64, PyErr] {
    let v = value.to_uppercase();
    let o = if let Some(w) = parse_iso(v) {
        p_ordinal(w, p.code)
    } else if let Some((y, q)) = quarter_string(v) {
        if q < 1 or q > 4 {
            return Err(py_err("DateParseError", f"Incorrect quarterly string is given, quarter must be between 1 and 4: {v}"));
        }
        let rc = rule_code(p.off) ?? "".to_string();
        let mon = match rc.split_once("-") {
            Some((_, m)) => m.split("-").next() ?? "DEC",
            None => "DEC",
        };
        let mnum = month_number(mon) ?? 12;
        let mut yy = y;
        let month = (mnum + (q - 1) * 3) % 12 + 1;
        if month > mnum {
            yy -= 1;
        }
        p_ordinal(wall(yy, month, 1, 0, 0, 0, 0), p.code)
    } else if let Some((a, b)) = v.split_once("/") {
        match (parse_iso(a), parse_iso(b)) {
            (Some(s), Some(e)) => {
                if day_of(e) - day_of(s) != 6 {
                    return Err(value_error("Could not parse as weekly-freq Period"));
                }
                p_ordinal(e, p.code)
            }
            _ => return Err(py_err("DateParseError", f"Unable to parse {v}")),
        }
    } else {
        return Err(py_err("DateParseError", f"Unable to parse {v}"));
    };
    if p.code == 5000 {
        bday_warning(mut warns);
    }
    Ok(o)
}

// YYYYQn, YYYY-Qn, nQYYYY, YYQn: (year, quarter).
fn quarter_string(v: Str) -> Option[(i64, i64)] {
    let n = v.len();
    if n < 4 or n > 7 {
        return None;
    }
    let qi = v.find("Q")?;
    if qi == 4 and n == 6 {
        return Some((num_at(v, 0, 4)?, num_at(v, 5, 1)?));
    }
    if qi == 5 and n == 7 and v.substring(4, 5) == "-" {
        return Some((num_at(v, 0, 4)?, num_at(v, 6, 1)?));
    }
    if qi == 1 and n == 6 {
        return Some((num_at(v, 2, 4)?, num_at(v, 0, 1)?));
    }
    if qi == 2 and n == 4 {
        return Some((2000 + num_at(v, 0, 2)?, num_at(v, 3, 1)?));
    }
    None
}

fn period_ts_start(o: i64, code: i64) -> i64 {
    let base = if code < 5000 {
        6000
    } else if code >= 7000 and code <= 9000 {
        9000
    } else {
        code
    };
    let val = p_asfreq(o, code, base, false);
    if base == 12000 {
        return val;
    }
    let w = date_info(val, base);
    w - floor_mod(w, 1000)
}

fn period_ts_end(o: i64, p: ref Per) -> i64 {
    if p.code == 5000 {
        return period_ts_start(o, p.code) + NS_D - NS_US;
    }
    period_ts_start(o + p.n, p.code) - NS_US
}

fn validate_how(how: Str) -> Result[bool, PyErr] {
    match how.to_uppercase().as_str() {
        "S" | "START" | "BEGIN" => Ok(false),
        "E" | "FINISH" | "END" => Ok(true),
        _ => Err(value_error("How must be one of S or E")),
    }
}

fn bool_text(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

fn job_per(w: ref Vec[String], warns: mut ref Vec[String]) -> Result[String, PyErr] {
    let p = period_freq(w[2], mut warns)?;
    let o = period_value(w[1], p, mut warns)?;
    let mut out = String.new();
    out.push_str(f"repr: {p_repr(o, p)}\n");
    out.push_str(f"start_time: {ts_str(naive(period_ts_start(o, p.code)))}\n");
    out.push_str(f"end_time: {ts_str(naive(period_ts_end(o, p)))}\n");
    let t = dt_of(date_info(o, p.code));
    let (qy, q) = p_yq(o, p.code);
    let u = days_from_civil(t.y, t.mo, t.d);
    out.push_str(f"year={t.y} quarter={q} qyear={qy} month={t.mo} day={t.d} dayofweek={weekday_of(u)} dayofyear={day_of_year(t.y, t.mo, t.d)} week={iso_week(t.y, t.mo, t.d)} days_in_month={days_in_month(t.y, t.mo)} is_leap_year={bool_text(is_leap(t.y))} ordinal={o}\n");
    Ok(out)
}

fn job_pasfreq(w: ref Vec[String], warns: mut ref Vec[String]) -> Result[String, PyErr] {
    let p = period_freq(w[2], mut warns)?;
    let o = period_value(w[1], p, mut warns)?;
    let p2 = period_freq(w[3], mut warns)?;
    let end = validate_how(w[4])?;
    let start = if end { o + p.n - 1 } else { o };
    let o2 = p_asfreq(start, p.code, p2.code, end);
    if p2.code == 5000 {
        bday_warning(mut warns);
    }
    Ok(f"{p_repr(o2, p2)}\n")
}

fn job_padd(w: ref Vec[String], warns: mut ref Vec[String]) -> Result[String, PyErr] {
    let p = period_freq(w[2], mut warns)?;
    let o = period_value(w[1], p, mut warns)?;
    let k = py_int(w[3])?;
    let o2 = o + k * p.n;
    if p.code == 5000 {
        bday_warning(mut warns);
    }
    Ok(f"{p_repr(o2, p)}\n")
}

fn job_pfmt(w: ref Vec[String], warns: mut ref Vec[String]) -> Result[String, PyErr] {
    let p = period_freq(w[2], mut warns)?;
    let o = period_value(w[1], p, mut warns)?;
    let rest: Vec[String] = w.iter().skip(3).map(|x| x.clone()).collect();
    let fmt = join(rest, " ").replace("_", " ");
    Ok(f"{p_strftime(o, p.code, fmt)}\n")
}

fn job_pdiff(w: ref Vec[String], warns: mut ref Vec[String]) -> Result[String, PyErr] {
    let p = period_freq(w[3], mut warns)?;
    let b = period_value(w[2], p, mut warns)?;
    let a = period_value(w[1], p, mut warns)?;
    let mut d = p.off.clone();
    d.n = b - a;
    Ok(f"{off_repr(d)}\n")
}

fn job_prange(kw: ref Vec[(String, String)], warns: mut ref Vec[String]) -> Result[String, PyErr] {
    let mut start: Option[String] = None;
    let mut end: Option[String] = None;
    let mut periods: Option[i64] = None;
    let mut freq = "D".to_string();
    for (k, v) in kw.iter() {
        if k == "start" {
            start = Some(v.clone());
        } else if k == "end" {
            end = Some(v.clone());
        } else if k == "periods" {
            periods = Some(py_int(v)?);
        } else if k == "freq" {
            freq = v.clone();
        } else {
            return Err(type_error(f"period_range() got an unexpected keyword argument {py_repr(k)}"));
        }
    }
    let given = (if start.is_some() { 1 } else { 0 }) + (if end.is_some() { 1 } else { 0 }) + (if periods.is_some() { 1 } else { 0 });
    if given != 2 {
        return Err(value_error("Of the three parameters: start, end, and periods, exactly two must be specified"));
    }
    let p = period_freq(freq, mut warns)?;
    let mult = p.n;
    let so = match start {
        Some(ref s) => Some(period_value(s, p, mut warns)?),
        None => None,
    };
    let eo = match end {
        Some(ref e) => Some(period_value(e, p, mut warns)?),
        None => None,
    };
    let mut data: Vec[i64] = Vec.new();
    match periods {
        Some(np) => {
            let total = np * mult;
            match so {
                Some(s) => {
                    let mut x = s;
                    while x < s + total {
                        data.push(x);
                        x += mult;
                    }
                }
                None => {
                    let e = eo ?? 0;
                    let mut x = e - total + mult;
                    while x < e + 1 {
                        data.push(x);
                        x += mult;
                    }
                }
            }
        }
        None => {
            let s = so ?? 0;
            let e = eo ?? 0;
            let mut x = s;
            while x < e + 1 {
                data.push(x);
                x += mult;
            }
        }
    }
    if p.code == 5000 {
        add_warning(mut warns, "FutureWarning", "PeriodDtype[B] is deprecated and will be removed in a future version. Use a DatetimeIndex with freq='B' instead");
    }
    let fs = per_freqstr(p);
    let mut out = f"n={data.len()} freq={fs} dtype=period[{fs}]\n";
    if data.len() > 0 {
        let items: Vec[String] = data.iter().map(|x| p_format(*x, p.code)).collect();
        out.push_str(f"  {join(items, " ")}\n");
    }
    Ok(out)
}

// ============================================================ date_range and bdate_range

fn ts_lt(a: ref Ts, b: ref Ts) -> bool {
    a.v < b.v
}

// _generate_range for the offsets that are not ticks.
fn offset_range(o: ref Off, start0: Option[Ts], end0: Option[Ts], periods0: Option[i64]) -> Result[Vec[Ts], PyErr] {
    let mut start = start0.clone();
    let mut end = end0.clone();
    let mut periods = periods0;
    if let Some(ref e) = end {
        if periods.is_some() and not off_is_on(o, o.n, e)? {
            end = Some(if o.n >= 0 { off_rollback(o, e)? } else { off_rollforward(o, e)? });
        }
    }
    if let Some(ref s) = start {
        if not off_is_on(o, o.n, s)? {
            start = Some(if o.n >= 0 { off_rollforward(o, s)? } else { off_rollback(o, s)? });
        }
    }
    if periods.is_none() and o.n >= 0 {
        let flip = match start {
            Some(ref s) => match end {
                Some(ref e) => ts_lt(e, s),
                None => false,
            },
            None => false,
        };
        if flip {
            end = None;
            periods = Some(0);
        }
    }
    if end.is_none() {
        let s = start.clone().unwrap();
        let k = periods.unwrap() - 1;
        let mut m = o.clone();
        m.n = o.n * k;
        validate_off(m)?;
        end = Some(off_apply(m, m.n, s)?);
    }
    if start.is_none() {
        let e = end.clone().unwrap();
        let k = periods.unwrap() - 1;
        let mut m = o.clone();
        m.n = o.n * k;
        validate_off(m)?;
        start = Some(off_apply(m, -m.n, e)?);
    }
    let s = start.clone().unwrap();
    let e = end.clone().unwrap();
    let mut out: Vec[Ts] = Vec.new();
    let mut cur = s;
    if o.n >= 0 {
        while cur.v <= e.v {
            out.push(cur.clone());
            if cur.v == e.v {
                break;
            }
            let next = off_apply(o, o.n, cur)?;
            if next.v <= cur.v {
                return Err(value_error(f"Offset {off_repr(o)} did not increment date"));
            }
            cur = next;
        }
    } else {
        while cur.v >= e.v {
            out.push(cur.clone());
            if cur.v == e.v {
                break;
            }
            let next = off_apply(o, o.n, cur)?;
            if next.v >= cur.v {
                return Err(value_error(f"Offset {off_repr(o)} did not decrement date"));
            }
            cur = next;
        }
    }
    Ok(out)
}

// generate_regular_range for a tick or Day.
fn regular_range(istart: Option[i64], iend: Option[i64], periods: Option[i64], stride: i64) -> Vec[i64] {
    let (b, e) = match (istart, iend, periods) {
        (Some(b), Some(e), None) => (b, b + floor_div(e - b, stride) * stride + floor_div(stride, 2) + 1),
        (Some(b), _, Some(p)) => (b, b + p * stride),
        (None, Some(e), Some(p)) => (e + stride - p * stride, e + stride),
        _ => (0, 0),
    };
    let mut out: Vec[i64] = Vec.new();
    let mut x = b;
    if stride > 0 {
        while x < e {
            out.push(x);
            x += stride;
        }
    } else if stride < 0 {
        while x > e {
            out.push(x);
            x += stride;
        }
    }
    out
}

// np.linspace(0, span, n, dtype=int64), in microseconds.
fn linspace_us(span: i64, n: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    if n <= 0 {
        return out;
    }
    if n == 1 {
        out.push(0);
        return out;
    }
    let step = span as f64 / (n - 1) as f64;
    for i in 0..n - 1 {
        out.push((i as f64 * step).trunc() as i64);
    }
    out.push(span);
    out
}

// The k=v arguments of a range job.
#[derive(Clone)]
struct RangeArgs {
    start: Option[String],
    end: Option[String],
    periods: Option[i64],
    freq: Option[String],
    inclusive: String,
    normalize: Option[bool],
    tz: Option[String],
    holidays: Vec[i64],
    has_holidays: bool,
    weekmask: Option[String],
}

fn range_args(kw: ref Vec[(String, String)], warns: mut ref Vec[String]) -> Result[RangeArgs, PyErr] {
    let mut a = RangeArgs {
        start: None,
        end: None,
        periods: None,
        freq: None,
        inclusive: "both".to_string(),
        normalize: None,
        tz: None,
        holidays: Vec.new(),
        has_holidays: false,
        weekmask: None,
    };
    for (k, v) in kw.iter() {
        if k == "cal" {
            if not known_calendar(v) {
                return Err(key_error(v));
            }
            for u in calendar_days(v).iter() {
                a.holidays.push(*u);
            }
            a.has_holidays = true;
            continue;
        }
        let val = value(v, k, mut warns)?;
        if k == "start" {
            a.start = Some(v.clone());
        } else if k == "end" {
            a.end = Some(v.clone());
        } else if k == "periods" {
            a.periods = Some(want_int(val, "periods")?);
        } else if k == "freq" {
            a.freq = Some(v.clone());
        } else if k == "inclusive" {
            a.inclusive = v.clone();
        } else if k == "normalize" {
            a.normalize = Some(match val {
                V.B(b) => b,
                _ => true,
            });
        } else if k == "tz" {
            a.tz = Some(v.clone());
        } else if k == "holidays" {
            match val {
                V.L(items) => {
                    for u in holiday_days(items)?.iter() {
                        a.holidays.push(*u);
                    }
                }
                _ => return Err(type_error("holidays must be a list")),
            }
            a.has_holidays = true;
        } else if k == "weekmask" {
            a.weekmask = Some(v.clone());
        } else {
            return Err(type_error(f"date_range() got an unexpected keyword argument {py_repr(k)}"));
        }
    }
    Ok(a)
}

fn show_index(vals: ref Vec[Ts], freq: Str, tz: ref Option[String]) -> String {
    let dtype = match tz {
        Some(z) => f"datetime64[us, {z}]",
        None => "datetime64[us]".to_string(),
    };
    let mut out = f"n={vals.len()} freq={freq} dtype={dtype}\n";
    for t in vals.iter() {
        out.push_str(f"  {ts_str(t)}\n");
    }
    out
}

// pd.date_range, with an offset already built for bdate_range's
// custom frequencies.
fn date_range(a: ref RangeArgs, prebuilt: Option[Off], warns: mut ref Vec[String]) -> Result[String, PyErr] {
    let mut freq_s = a.freq.clone();
    if prebuilt.is_none() and freq_s.is_none() and (a.periods.is_none() or a.start.is_none() or a.end.is_none()) {
        freq_s = Some("D".to_string());
    }
    let have_freq = prebuilt.is_some() or freq_s.is_some();
    let given = (if a.start.is_some() { 1 } else { 0 }) + (if a.end.is_some() { 1 } else { 0 }) + (if a.periods.is_some() { 1 } else { 0 }) + (if have_freq { 1 } else { 0 });
    if given != 3 {
        return Err(value_error("Of the four parameters: start, end, periods, and freq, exactly three must be specified"));
    }
    if let Some(p) = a.periods {
        if p < 0 {
            return Err(value_error(f"periods must be a non-negative integer, got {p}"));
        }
    }
    let off: Option[Off] = match prebuilt {
        Some(o) => Some(o.clone()),
        None => match freq_s {
            Some(ref f) => Some(to_offset(f, false, mut warns)?),
            None => None,
        },
    };
    let mut start: Option[Ts] = match a.start {
        Some(ref s) => Some(stamp(s)?),
        None => None,
    };
    let mut end: Option[Ts] = match a.end {
        Some(ref e) => Some(stamp(e)?),
        None => None,
    };
    let (left_inc, right_inc) = match a.inclusive.as_str() {
        "both" => (true, true),
        "neither" => (false, false),
        "left" => (true, false),
        "right" => (false, true),
        _ => return Err(value_error("Inclusive has to be either 'both', 'neither', 'left' or 'right'")),
    };
    if a.normalize ?? false {
        start = start.map(|t| normalized(t));
        end = end.map(|t| normalized(t));
    }
    let tz = a.tz.clone();
    if let Some(ref z) = tz {
        if not known_zone(z) {
            return Err(py_err("UnknownTimeZoneError", py_repr(z)));
        }
    }
    let tick_like = match off {
        Some(ref o) => is_tick(o.k),
        None => true,
    };
    if let Some(ref z) = tz {
        if tick_like {
            start = start.map(|t| Ts { v: localize(z, t.v), tz: Some(z.clone()) });
            end = end.map(|t| Ts { v: localize(z, t.v), tz: Some(z.clone()) });
        }
    }
    let mut vals: Vec[Ts] = Vec.new();
    match off {
        Some(ref o) => {
            if is_tick(o.k) or o.k == K.Day {
                let stride = if o.k == K.Day { o.n * NS_D } else { o.n * tick_ns(o.k) };
                let st_tz = match start {
                    Some(ref s) => s.tz.clone(),
                    None => end.clone().unwrap().tz,
                };
                for x in regular_range(start.clone().map(|t| t.v), end.clone().map(|t| t.v), a.periods, stride).iter() {
                    vals.push(Ts { v: *x, tz: st_tz.clone() });
                }
            } else {
                vals = offset_range(o, start.clone(), end.clone(), a.periods)?;
            }
            if let Some(ref z) = tz {
                if not tick_like {
                    vals = vals.iter().map(|t| Ts { v: localize(z, t.v), tz: Some(z.clone()) }).collect();
                    start = start.map(|t| Ts { v: localize(z, t.v), tz: Some(z.clone()) });
                    end = end.map(|t| Ts { v: localize(z, t.v), tz: Some(z.clone()) });
                }
            }
        }
        None => {
            let s = start.clone().unwrap();
            let e = end.clone().unwrap();
            let su = floor_div(s.v, NS_US);
            for x in linspace_us(floor_div(e.v, NS_US) - su, a.periods ?? 0).iter() {
                vals.push(Ts { v: (su + *x) * NS_US, tz: s.tz.clone() });
            }
        }
    }
    let same = match (start.clone(), end.clone()) {
        (Some(ref s), Some(ref e)) => s.v == e.v,
        _ => false,
    };
    if same {
        if not left_inc and not right_inc and vals.len() >= 1 {
            let n = vals.len();
            vals = vals.iter().skip(1).take(if n >= 2 { n - 2 } else { 0 }).map(|t| t.clone()).collect();
        }
    } else {
        if not left_inc and vals.len() > 0 {
            if let Some(ref s) = start {
                if vals[0].v == s.v {
                    vals.remove(0);
                }
            }
        }
        if not right_inc and vals.len() > 0 {
            if let Some(ref e) = end {
                if vals[vals.len() - 1].v == e.v {
                    vals.pop();
                }
            }
        }
    }
    let fs = match off {
        Some(ref o) => freqstr(o),
        None => "None".to_string(),
    };
    Ok(show_index(vals, fs, tz))
}

fn job_range(kw: ref Vec[(String, String)], warns: mut ref Vec[String]) -> Result[String, PyErr] {
    let a = range_args(kw, mut warns)?;
    date_range(a, None, mut warns)
}

fn job_brange(kw: ref Vec[(String, String)], warns: mut ref Vec[String]) -> Result[String, PyErr] {
    let mut a = range_args(kw, mut warns)?;
    if a.normalize.is_none() {
        a.normalize = Some(true);
    }
    let freq = a.freq.clone() ?? "B".to_string();
    if freq.to_uppercase().starts_with("C") {
        let msg = f"invalid custom frequency string: {freq}";
        if freq == "CBH" {
            return Err(value_error(f"{msg}, did you mean cbh?"));
        }
        let k = match prefix_kind(freq) {
            Some(k) => k,
            None => return Err(value_error(msg)),
        };
        if not is_custom(k) {
            return Err(value_error(msg));
        }
        let mut o = default_off(k, 1);
        let wm = a.weekmask.clone() ?? "Mon Tue Wed Thu Fri".to_string();
        o.cal = make_cal(wm, a.holidays, None)?;
        a.freq = Some(freq);
        return date_range(a, Some(o), mut warns);
    }
    if a.has_holidays or a.weekmask.is_some() {
        return Err(value_error(f"a custom frequency string is required when holidays or weekmask are passed, got frequency {freq}"));
    }
    a.freq = Some(freq);
    date_range(a, None, mut warns)
}

// ============================================================ the Timedelta and numpy jobs

fn job_td(w: ref Vec[String], warns: mut ref Vec[String]) -> Result[String, PyErr] {
    let v = parse_timedelta(w[1].replace("_", " "), mut warns)?;
    let mut out = String.new();
    out.push_str(f"repr: {td_repr(v)}\n");
    out.push_str(f"str: {td_str(v)}\n");
    out.push_str(f"isoformat: {td_isoformat(v)}\n");
    out.push_str(f"total_seconds: {td_total_seconds(v)}\n");
    out.push_str(f"components: {td_components(v)}\n");
    Ok(out)
}

fn job_tdround(w: ref Vec[String], warns: mut ref Vec[String]) -> Result[String, PyErr] {
    let v = parse_timedelta(w[1].replace("_", " "), mut warns)?;
    let o = to_offset(w[2], false, mut warns)?;
    let unit = if is_tick(o.k) {
        o.n * tick_ns(o.k)
    } else if o.k == K.Day {
        o.n * NS_D
    } else {
        return Err(value_error(f"{off_repr(o)} is a non-fixed frequency"));
    };
    let how = w[3].as_str();
    if how != "floor" and how != "ceil" and how != "round" {
        return Err(py_err("AttributeError", f"'Timedelta' object has no attribute {py_repr(how)}"));
    }
    if unit <= 0 {
        return Err(value_error("Division by zero in rounding"));
    }
    Ok(f"{td_repr(round_to(v, unit, how))}\n")
}

fn job_tsadd(w: ref Vec[String], warns: mut ref Vec[String]) -> Result[String, PyErr] {
    let t = stamp(w[1])?;
    let v = parse_timedelta(w[2].replace("_", " "), mut warns)?;
    Ok(f"{ts_str(Ts { v: t.v + v, tz: t.tz.clone() })}\n")
}

fn job_busday(w: ref Vec[String], warns: mut ref Vec[String]) -> Result[String, PyErr] {
    let mut pos: Vec[String] = Vec.new();
    let mut weekmask = "1111100".to_string();
    let mut hols: Vec[i64] = Vec.new();
    let mut roll = "raise".to_string();
    for o in w.iter().skip(2) {
        match o.split_once("=") {
            Some((k, v)) => {
                if k == "cal" {
                    if not known_calendar(v) {
                        return Err(key_error(v));
                    }
                    for u in calendar_days(v).iter() {
                        hols.push(*u);
                    }
                } else if k == "weekmask" {
                    weekmask = v.to_string();
                } else if k == "roll" {
                    roll = v.to_string();
                } else if k == "holidays" {
                    match value(v, k, mut warns)? {
                        V.L(items) => {
                            for u in holiday_days(items)?.iter() {
                                hols.push(*u);
                            }
                        }
                        _ => return Err(type_error("holidays must be a list")),
                    }
                } else {
                    return Err(type_error(f"got an unexpected keyword argument {py_repr(k)}"));
                }
            }
            None => pos.push(o.clone()),
        }
    }
    let cal = bus_cal(parse_weekmask(weekmask)?, hols);
    let day = |s: Str| {
        match parse_iso(s) {
            Some(x) => Ok(day_of(x)),
            None => Err(value_error(f"Error parsing datetime string \"{s}\" at position 0")),
        }
    };
    let sub = w[1].as_str();
    if sub == "count" {
        let a = day(pos[0].clone())?;
        let b = day(pos[1].clone())?;
        Ok(f"{busday_count(cal, a, b)}\n")
    } else if sub == "offset" {
        let a = day(pos[0].clone())?;
        let n = py_int(pos[1])?;
        match busday_offset(cal, a, n, roll)? {
            Some(u) => Ok(f"{date_text(u)}\n"),
            None => Ok("NaT\n".to_string()),
        }
    } else {
        let a = day(pos[0].clone())?;
        Ok(f"{bool_text(is_bus(cal, a))}\n")
    }
}

// ============================================================ the offset jobs

fn op_line(name: Str, r: Result[String, PyErr]) -> String {
    match r {
        Ok(s) => f"{name}: {s}\n",
        Err(e) => f"{name}: ! {e.kind}: {e.msg}\n",
    }
}

fn job_off(w: ref Vec[String], warns: mut ref Vec[String]) -> Result[String, PyErr] {
    let ts = stamp(w[1])?;
    let o = build_offset(w[2], mut warns)?;
    let mut out = String.new();
    out.push_str(f"repr: {off_repr(o)}\n");
    out.push_str(f"freqstr: {freqstr(o)}\n");
    out.push_str(op_line("+", off_apply(o, o.n, ts).map(|t| ts_str(t))));
    out.push_str(op_line("-", off_apply(o, -o.n, ts).map(|t| ts_str(t))));
    out.push_str(op_line("rollforward", off_rollforward(o, ts).map(|t| ts_str(t))));
    out.push_str(op_line("rollback", off_rollback(o, ts).map(|t| ts_str(t))));
    out.push_str(op_line("is_on_offset", off_is_on(o, o.n, ts).map(|b| bool_text(b))));
    Ok(out)
}

fn job_freq(w: ref Vec[String], warns: mut ref Vec[String]) -> Result[String, PyErr] {
    let o = to_offset(w[1], false, mut warns)?;
    Ok(f"repr: {off_repr(o)}\nfreqstr: {freqstr(o)}\n")
}

fn job_hol(w: ref Vec[String]) -> Result[String, PyErr] {
    let name = w[1].as_str();
    if not known_calendar(name) {
        return Err(key_error(name));
    }
    let start = match parse_iso(w[2]) {
        Some(x) => day_of(x),
        None => return Err(value_error(f"could not convert string to Timestamp")),
    };
    let end = match parse_iso(w[3]) {
        Some(x) => day_of(x),
        None => return Err(value_error(f"could not convert string to Timestamp")),
    };
    let mut out = String.new();
    for (u, n) in calendar_holidays(name, start, end).iter() {
        out.push_str(f"{date_text(u)} {DAY_ABBR[weekday_of(u)]} {n}\n");
    }
    Ok(out)
}

// ============================================================ read_csv and to_csv

#[derive(Copy, Clone, PartialEq, Eq)]
enum Ct {
    Int,
    Float,
    Text,
}

#[derive(Clone)]
struct Csv {
    names: Vec[String],
    rows: Vec[Vec[String]],
    types: Vec[Ct],
}

fn is_float_text(s: Str) -> bool {
    s.len() > 0 and f64.parse(s).is_ok()
}

fn read_csv(path: Str) -> Result[Csv, PyErr] {
    let text = match fs.read_to_string(path.to_string()) {
        Ok(t) => t,
        Err(_) => return Err(py_err("FileNotFoundError", f"[Errno 2] No such file or directory: {py_repr(path)}")),
    };
    let mut lines: Vec[String] = Vec.new();
    for l in text.split("\n") {
        let t = l.strip_suffix("\r") ?? l;
        if t.len() > 0 {
            lines.push(t.to_string());
        }
    }
    if lines.len() == 0 {
        return Err(py_err("EmptyDataError", "No columns to parse from file"));
    }
    let names = split_on(lines[0], ",");
    let mut rows: Vec[Vec[String]] = Vec.new();
    for l in lines.iter().skip(1) {
        rows.push(split_on(l, ","));
    }
    let mut types: Vec[Ct] = Vec.new();
    for c in 0..names.len() {
        let all_int = rows.iter().all(|r| int_of(r[c]).is_some());
        let all_float = rows.iter().all(|r| is_float_text(r[c]));
        types.push(if all_int { Ct.Int } else if all_float { Ct.Float } else { Ct.Text });
    }
    Ok(Csv { names: names, rows: rows, types: types })
}

fn cell_text(t: Ct, s: Str) -> String {
    match t {
        Ct.Float => f64.parse(s).unwrap().to_string(),
        Ct.Int => (int_of(s) ?? 0).to_string(),
        Ct.Text => s.to_string(),
    }
}

// A datetime64 column as to_csv writes it: dates alone when every value
// is a midnight.
fn dt_cells(vals: ref Vec[Ts]) -> Vec[String] {
    let dates_only = vals.iter().all(|t| is_midnight(ts_wall(t)));
    vals.iter().map(|t| {
        let w = ts_wall(t);
        if dates_only { date_text(day_of(w)) } else { f"{date_text(day_of(w))} {clock_text(w)}" }
    }).collect()
}

fn col_index(c: ref Csv, name: Str) -> Result[i64, PyErr] {
    for i in 0..c.names.len() {
        if c.names[i] == name {
            return Ok(i);
        }
    }
    Err(key_error(name))
}

fn date_col(c: ref Csv, i: i64) -> Result[Vec[Ts], PyErr] {
    let mut out: Vec[Ts] = Vec.new();
    for r in c.rows.iter() {
        match parse_iso(r[i]) {
            Some(w) => out.push(naive(w)),
            None => return Err(py_err("DateParseError", f"Unknown datetime string format, unable to parse: {r[i]}, at position 0")),
        }
    }
    Ok(out)
}

// The kinds whose _apply_array is vectorized; the rest warn when a
// column meets them.
fn vectorized(o: ref Off) -> bool {
    let k = o.k;
    if k == K.DateOffset {
        if not o.use_rd {
            return true;
        }
        let fast = ["years", "months", "weeks", "days", "hours", "minutes", "seconds", "microseconds", "milliseconds"];
        return o.kw.iter().all(|p| fast.iter().any(|f| *f == p.0));
    }
    is_tick(k) or k == K.Day or k == K.BDay or is_month(k) or is_quarter(k) or is_half(k) or is_year(k) or k == K.SemiMonthEnd or k == K.SemiMonthBegin or k == K.Week
}

fn job_due(w: ref Vec[String], warns: mut ref Vec[String]) -> Result[String, PyErr] {
    let c = read_csv(f"data/{w[1]}")?;
    let ci = col_index(c, w[2])?;
    let col = date_col(c, ci)?;
    let o = build_offset(w[4], mut warns)?;
    let op = w[3].as_str();
    let mut res_dates: Vec[Ts] = Vec.new();
    let mut res_bools: Vec[bool] = Vec.new();
    if op == "add" or op == "sub" {
        if not vectorized(o) {
            add_warning(mut warns, "PerformanceWarning", "Non-vectorized DateOffset being applied to Series or DatetimeIndex.");
        }
        let n = if op == "add" { o.n } else { -o.n };
        for t in col.iter() {
            res_dates.push(off_apply(o, n, t)?);
        }
    } else if op == "on" {
        for t in col.iter() {
            res_bools.push(off_is_on(o, o.n, t)?);
        }
    } else if op == "rollforward" {
        for t in col.iter() {
            res_dates.push(off_rollforward(o, t)?);
        }
    } else if op == "rollback" {
        for t in col.iter() {
            res_dates.push(off_rollback(o, t)?);
        }
    } else {
        return Err(py_err("AttributeError", f"{py_repr(off_name(o.k))} object has no attribute {py_repr(op)}"));
    }
    let dcells = dt_cells(col);
    let rcells: Vec[String] = if op == "on" { res_bools.iter().map(|b| bool_text(*b)).collect() } else { dt_cells(res_dates) };
    let mut out = join(c.names, ",");
    out.push_str(",result\n");
    for (ri, r) in c.rows.iter().enumerate() {
        let mut cells: Vec[String] = Vec.new();
        for (i, s) in r.iter().enumerate() {
            if i == ci {
                cells.push(dcells[ri].clone());
            } else {
                cells.push(cell_text(c.types[i], s));
            }
        }
        cells.push(rcells[ri].clone());
        out.push_str(join(cells, ","));
        out.push_str("\n");
    }
    Ok(out)
}

// Kahan summation as pandas' groupby sum runs it.
struct Kahan {
    sum: f64,
    comp: f64,
}

impl Kahan {
    fn add(mut ref self, val: f64) {
        let y = val - self.comp;
        let t = self.sum + y;
        self.comp = t - self.sum - y;
        self.sum = t;
    }
}

// numpy's rint: round half to even.
fn rint(x: f64) -> f64 {
    if x.abs() >= 4503599627370496.0 {
        return x;
    }
    let f = x.floor();
    let d = x - f;
    if d < 0.5 {
        f
    } else if d > 0.5 {
        f + 1.0
    } else if (f / 2.0).floor() * 2.0 == f {
        f
    } else {
        f + 1.0
    }
}

fn np_round2(x: f64) -> f64 {
    rint(x * 100.0) / 100.0
}

fn job_bucket(w: ref Vec[String], warns: mut ref Vec[String]) -> Result[String, PyErr] {
    let c = read_csv(f"data/{w[1]}")?;
    let ci = col_index(c, w[2])?;
    let col = date_col(c, ci)?;
    let vi = col_index(c, w[4])?;
    let p = period_freq(w[3], mut warns)?;
    // (ordinal, row) pairs, sorted by ordinal and then by row.
    let mut keyed: Vec[(i64, i64)] = Vec.new();
    for (ri, t) in col.iter().enumerate() {
        keyed.push((p_ordinal(ts_wall(t), p.code), ri));
    }
    keyed.sort();
    let is_int = c.types[vi] == Ct.Int;
    let mut out = f"{w[2]},count,sum\n";
    let mut i = 0;
    while i < keyed.len() {
        let key = keyed[i].0;
        let mut count = 0;
        let mut isum: i64 = 0;
        let mut k = Kahan { sum: 0.0, comp: 0.0 };
        while i < keyed.len() and keyed[i].0 == key {
            let s = c.rows[keyed[i].1][vi].clone();
            count += 1;
            if is_int {
                isum += int_of(s) ?? 0;
            } else {
                k.add(f64.parse(s).unwrap_or(0.0));
            }
            i += 1;
        }
        let total = if is_int { isum.to_string() } else { np_round2(k.sum).to_string() };
        out.push_str(f"{p_format(key, p.code)},{count},{total}\n");
    }
    Ok(out)
}

// ============================================================ jobs

fn kv_args(w: ref Vec[String]) -> Vec[(String, String)] {
    let mut out: Vec[(String, String)] = Vec.new();
    for o in w.iter().skip(1) {
        if let Some((k, v)) = o.split_once("=") {
            out.push((k.to_string(), v.to_string()));
        }
    }
    out
}

fn run_job(line: Str, warns: mut ref Vec[String]) -> Result[String, PyErr] {
    let w: Vec[String] = line.split_whitespace().map(|x| x.to_string()).collect();
    let cmd = w[0].as_str();
    match cmd {
        "off" => job_off(w, mut warns),
        "freq" => job_freq(w, mut warns),
        "range" => job_range(kv_args(w), mut warns),
        "brange" => job_brange(kv_args(w), mut warns),
        "hol" => job_hol(w),
        "per" => job_per(w, mut warns),
        "pasfreq" => job_pasfreq(w, mut warns),
        "padd" => job_padd(w, mut warns),
        "pfmt" => job_pfmt(w, mut warns),
        "pdiff" => job_pdiff(w, mut warns),
        "prange" => job_prange(kv_args(w), mut warns),
        "td" => job_td(w, mut warns),
        "tdround" => job_tdround(w, mut warns),
        "tsadd" => job_tsadd(w, mut warns),
        "busday" => job_busday(w, mut warns),
        "due" => job_due(w, mut warns),
        "bucket" => job_bucket(w, mut warns),
        _ => Err(value_error(f"unknown job {cmd}")),
    }
}

// The transcript of one job: its output, its warnings, then its error.
fn transcript(line: Str) -> String {
    let mut t = f"$ {line}\n";
    let mut warns: Vec[String] = Vec.new();
    let r = run_job(line, mut warns);
    let mut body = String.new();
    let mut err = String.new();
    match r {
        Ok(s) => body = s,
        Err(e) => err = f"! {e.kind}: {e.msg}\n",
    }
    t.push_str(body);
    for w in warns.iter() {
        t.push_str(w);
        t.push_str("\n");
    }
    t.push_str(err);
    t
}

fn hex_val(c: u8) -> u8 {
    if c >= b'0' and c <= b'9' { c - b'0' } else { (c | 32) - b'a' + 10 }
}

fn is_hex(c: u8) -> bool {
    (c >= b'0' and c <= b'9') or (c >= b'a' and c <= b'f') or (c >= b'A' and c <= b'F')
}

// The bytes a run of hex digits spells; anything else is skipped.
fn unhex(s: Str) -> Vec[u8] {
    let mut digits: Vec[u8] = Vec.new();
    for c in s.bytes() {
        if is_hex(c) {
            digits.push(hex_val(c));
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < digits.len() {
        out.push(digits[i] * 16 + digits[i + 1]);
        i += 2;
    }
    out
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn main() {
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        eprintln(f"cannot create data: {e}");
        return;
    }
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    let jobs = match fs.read_to_string("data/jobs.txt".to_string()) {
        Ok(t) => t,
        Err(e) => {
            eprintln(f"cannot read jobs.txt: {e}");
            return;
        }
    };
    let mut lines: Vec[String] = Vec.new();
    for l in jobs.split("\n") {
        let t = l.strip_suffix("\r") ?? l;
        if t.trim().len() > 0 {
            lines.push(t.to_string());
        }
    }
    // Every job in a task of its own; the transcript prints in job order.
    let group = TaskGroup.new();
    let mut handles = Vec.new();
    for line in lines {
        handles.push(group.spawn(|| transcript(line)));
    }
    for h in handles.into_iter() {
        print(h.join());
    }
}

// ============================================================ data

// The files under data/, in name order.
fn write_data() -> Result[(), String] {
    put_bytes("data/invoices.csv", unhex(file_0()))?;
    put_bytes("data/jobs.txt", unhex(file_1()))?;
    put_bytes("data/pay.csv", unhex(file_2()))?;
    put_bytes("data/sales.csv", unhex(file_3()))?;
    put_bytes("data/tickets.csv", unhex(file_4()))?;
    put_bytes("data/trades.csv", unhex(file_5()))?;
    Ok(())
}

