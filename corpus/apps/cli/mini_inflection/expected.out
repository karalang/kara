== scaffold
-- scaffold 'BlogPost title:string body:text author_id:integer published_at:datetime'
   model BlogPost
   table blog_posts
   singular blog_post
   route /blog-posts
   controller BlogPostsController
   human Blog post
   heading Blog Posts
   column title string label='Title' header='Title'
   column body text label='Body' header='Body'
   column author_id integer label='Author' header='Author' belongs_to=author class=Author inverse=blog_posts
   column published_at datetime label='Published at' header='Published At'
-- scaffold 'Person first_name:string last_name:string company_id:integer'
   model Person
   table people
   singular person
   route /people
   controller PeopleController
   human Person
   heading People
   column first_name string label='First name' header='First Name'
   column last_name string label='Last name' header='Last Name'
   column company_id integer label='Company' header='Company' belongs_to=company class=Company inverse=people
-- scaffold 'Category name:string parent_id:integer position:integer'
   model Category
   table categories
   singular category
   route /categories
   controller CategoriesController
   human Category
   heading Categories
   column name string label='Name' header='Name'
   column parent_id integer label='Parent' header='Parent' belongs_to=parent class=Parent inverse=categories
   column position integer label='Position' header='Position'
-- scaffold 'OrderLineItem order_id:integer product_id:integer unit_price_cents:integer'
   model OrderLineItem
   table order_line_items
   singular order_line_item
   route /order-line-items
   controller OrderLineItemsController
   human Order line item
   heading Order Line Items
   column order_id integer label='Order' header='Order' belongs_to=order class=Order inverse=order_line_items
   column product_id integer label='Product' header='Product' belongs_to=product class=Product inverse=order_line_items
   column unit_price_cents integer label='Unit price cents' header='Unit Price Cents'
-- scaffold 'HTTPRequestLog status:integer remote_ip:string user_agent:string'
   model HTTPRequestLog
   table http_request_logs
   singular http_request_log
   route /http-request-logs
   controller HttpRequestLogsController
   human Http request log
   heading Http Request Logs
   column status integer label='Status' header='Status'
   column remote_ip string label='Remote ip' header='Remote Ip'
   column user_agent string label='User agent' header='User Agent'
-- scaffold 'Address street:string city:string postal_code:string country_code:string'
   model Address
   table addresses
   singular address
   route /addresses
   controller AddressesController
   human Address
   heading Addresses
   column street string label='Street' header='Street'
   column city string label='City' header='City'
   column postal_code string label='Postal code' header='Postal Code'
   column country_code string label='Country code' header='Country Code'
-- scaffold 'Mouse wheel_count:integer dpi:integer'
   model Mouse
   table mice
   singular mouse
   route /mice
   controller MiceController
   human Mouse
   heading Mice
   column wheel_count integer label='Wheel count' header='Wheel Count'
   column dpi integer label='Dpi' header='Dpi'
-- scaffold 'Analysis dataset_id:integer criteria:json'
   model Analysis
   table analyses
   singular analysis
   route /analyses
   controller AnalysesController
   human Analysis
   heading Analyses
   column dataset_id integer label='Dataset' header='Dataset' belongs_to=dataset class=Dataset inverse=analyses
   column criteria json label='Criteria' header='Criteria'
-- scaffold 'Child guardian_id:integer birthday:date'
   model Child
   table children
   singular child
   route /children
   controller ChildrenController
   human Child
   heading Children
   column guardian_id integer label='Guardian' header='Guardian' belongs_to=guardian class=Guardian inverse=children
   column birthday date label='Birthday' header='Birthday'
-- scaffold 'Octopus arm_count:integer habitat:string'
   model Octopus
   table octopi
   singular octopus
   route /octopi
   controller OctopiController
   human Octopus
   heading Octopi
   column arm_count integer label='Arm count' header='Arm Count'
   column habitat string label='Habitat' header='Habitat'
-- scaffold 'Datum value:float source_id:integer'
   model Datum
   table data
   singular datum
   route /data
   controller DataController
   human Datum
   heading Data
   column value float label='Value' header='Value'
   column source_id integer label='Source' header='Source' belongs_to=source class=Source inverse=data
-- scaffold 'Status code:string label:string'
   model Status
   table statuses
   singular status
   route /statuses
   controller StatusesController
   human Status
   heading Statuses
   column code string label='Code' header='Code'
   column label string label='Label' header='Label'
-- scaffold 'AdminUser email:string role_ids:json'
   model AdminUser
   table admin_users
   singular admin_user
   route /admin-users
   controller AdminUsersController
   human Admin user
   heading Admin Users
   column email string label='Email' header='Email'
   column role_ids json label='Role ids' header='Role Ids' has_many=roles class=Role
-- scaffold 'Ox name:string yoke_id:integer'
   model Ox
   table oxen
   singular ox
   route /oxen
   controller OxenController
   human Ox
   heading Oxen
   column name string label='Name' header='Name'
   column yoke_id integer label='Yoke' header='Yoke' belongs_to=yoke class=Yoke inverse=oxen
