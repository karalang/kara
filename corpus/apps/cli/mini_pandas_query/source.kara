    t.push_str("read readings.csv | query floor(temp_c) == ceil(temp_c)\n");
    t.push_str("read readings.csv | eval round(temp_c)\n");
    t.push_str("read readings.csv | eval sqrt(x=temp_c)\n");
    t.push_str("read readings.csv | eval hypot(temp_c, wind_ms)\n");
