// mini_netrc: Python's `netrc` module, the reader of the `.netrc` files
// that ftp, curl, git and pip take their credentials from. Machines with a
// login, account and password, a `default` entry, `macdef` macros, and the
// module's own lexer with its quoting and comment rules.
// README.md is the spec; oracle.py is the reference.

import std.encoding.hex_decode;

// ------------------------------------------------------------ text

/// Python's `repr` of a string, for the characters the files use.
fn py_repr(s: Str) -> String {
    let q = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        if c == '\\' {
            out.push_str("\\\\");
        } else if c == q {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\t' {
            out.push_str("\\t");
        } else {
            out.push(c);
        }
    }
    out.push(q);
    out
}

// ------------------------------------------------------------ the lexer

/// The module's `_netrclex`: a character at a time, counting the newlines
/// it reads that way.
struct Lexer {
    chars: Vec[char],
    pos: i64,
    lineno: i64,
    pushback: Vec[Option[String]],
}

fn is_space(c: char) -> bool {
    c == '\n' or c == '\t' or c == '\r' or c == ' '
}

impl Lexer {
    fn new(text: Str) -> Lexer {
        // Python reads the file with universal newlines.
        let text = text.replace("\r\n", "\n").replace("\r", "\n");
        Lexer { chars: text.chars().collect(), pos: 0, lineno: 1, pushback: Vec.new() }
    }

    fn read_char(mut ref self) -> Option[char] {
        if self.pos >= self.chars.len() {
            return None;
        }
        let c = self.chars[self.pos];
        self.pos += 1;
        if c == '\n' {
            self.lineno += 1;
        }
        Some(c)
    }

    /// The rest of the current line, its newline included, read whole: the
    /// line number does not move.
    fn readline(mut ref self) -> String {
        let mut line = String.new();
        while self.pos < self.chars.len() {
            let c = self.chars[self.pos];
            self.pos += 1;
            line.push(c);
            if c == '\n' {
                break;
            }
        }
        line
    }

    /// A backslash takes the next character as it is (nothing at the end).
    fn escaped(mut ref self, c: char) -> Option[char] {
        if c == '\\' { self.read_char() } else { Some(c) }
    }

    fn get_token(mut ref self) -> Option[String] {
        if not self.pushback.is_empty() {
            return self.pushback.remove(0);
        }
        while let Some(ch) = self.read_char() {
            if is_space(ch) {
                continue;
            }
            let mut token = String.new();
            if ch == '"' {
                while let Some(c) = self.read_char() {
                    if c == '"' {
                        return Some(token);
                    }
                    if let Some(x) = self.escaped(c) {
                        token.push(x);
                    }
                }
                return Some(token);
            }
            if let Some(x) = self.escaped(ch) {
                token.push(x);
            }
            while let Some(c) = self.read_char() {
                if is_space(c) {
                    return Some(token);
                }
                if let Some(x) = self.escaped(c) {
                    token.push(x);
                }
            }
            return Some(token);
        }
        None
    }

    fn push_token(mut ref self, token: own Option[String]) {
        self.pushback.push(token);
    }
}

// ------------------------------------------------------------ the parser

/// An entry's login, account and password.
#[derive(Clone)]
struct Auth {
    login: String,
    account: String,
    password: String,
}

impl Auth {
    fn repr(ref self) -> String {
        f"({py_repr(self.login)}, {py_repr(self.account)}, {py_repr(self.password)})"
    }
}

/// A parsed file: its entries and macros, in the order first seen.
struct Netrc {
    hosts: Vec[(String, Auth)],
    macros: Vec[(String, Vec[String])],
}

fn parse_error(msg: Str, path: Str, lineno: i64) -> String {
    f"NetrcParseError: {msg} ({path}, line {lineno})"
}

fn is_follower_end(tt: ref Option[String]) -> bool {
    match tt {
        None => true,
        Some(t) => t == "machine" or t == "default" or t == "macdef",
    }
}

impl Netrc {
    fn host(ref self, name: Str) -> Option[Auth] {
        self.hosts.iter().find(|(h, _)| h == name).map(|(_, a)| a.clone())
    }

    fn macro(ref self, name: Str) -> Option[Vec[String]] {
        self.macros.iter().find(|(m, _)| m == name).map(|(_, lines)| lines.clone())
    }

    fn set_host(mut ref self, name: Str, auth: own Auth) {
        match self.hosts.iter().position(|(h, _)| h == name) {
            Some(i) => self.hosts[i].1 = auth,
            None => self.hosts.push((name.to_string(), auth)),
        }
    }

    fn set_macro(mut ref self, name: Str, lines: own Vec[String]) {
        match self.macros.iter().position(|(m, _)| m == name) {
            Some(i) => self.macros[i].1 = lines,
            None => self.macros.push((name.to_string(), lines)),
        }
    }

    fn parse(path: Str, text: Str) -> Result[Netrc, String] {
        let mut n = Netrc { hosts: Vec.new(), macros: Vec.new() };
        let mut lexer = Lexer.new(text);
        loop {
            let saved_lineno = lexer.lineno;
            let Some(tt) = lexer.get_token() else {
                break;
            };
            let entryname: Option[String] = if tt.starts_with("#") {
                if lexer.lineno == saved_lineno and tt.len() == 1 {
                    lexer.readline();
                }
                continue;
            } else if tt == "machine" {
                lexer.get_token()
            } else if tt == "default" {
                Some("default".to_string())
            } else if tt == "macdef" {
                let name = lexer.get_token().unwrap_or(String.new());
                let mut lines: Vec[String] = Vec.new();
                loop {
                    let line = lexer.readline();
                    if line.is_empty() {
                        return Err(parse_error("Macro definition missing null line terminator.", path, lexer.lineno));
                    }
                    if line == "\n" {
                        break;
                    }
                    lines.push(line);
                }
                n.set_macro(name, lines);
                continue;
            } else {
                return Err(parse_error(f"bad toplevel token {py_repr(tt)}", path, lexer.lineno));
            };
            let name = match entryname {
                Some(e) if not e.is_empty() => e,
                _ => return Err(parse_error(f"missing {py_repr(tt)} name", path, lexer.lineno)),
            };
            let mut auth = Auth { login: String.new(), account: String.new(), password: String.new() };
            n.set_host(name, auth.clone());
            loop {
                let prev_lineno = lexer.lineno;
                let tt = lexer.get_token();
                if let Some(ref t) = tt {
                    if t.starts_with("#") {
                        if lexer.lineno == prev_lineno {
                            lexer.readline();
                        }
                        continue;
                    }
                }
                if is_follower_end(tt) {
                    n.set_host(name, auth.clone());
                    lexer.push_token(tt);
                    break;
                }
                let t = tt.unwrap_or(String.new());
                if t == "login" or t == "user" {
                    auth.login = lexer.get_token().unwrap_or(String.new());
                } else if t == "account" {
                    auth.account = lexer.get_token().unwrap_or(String.new());
                } else if t == "password" {
                    auth.password = lexer.get_token().unwrap_or(String.new());
                } else {
                    return Err(parse_error(f"bad follower token {py_repr(t)}", path, lexer.lineno));
                }
            }
        }
        Ok(n)
    }

    /// `authenticators(host)`: the host's entry, else `default`'s.
    fn authenticators(ref self, host: Str) -> Option[Auth] {
        self.host(host).or_else(|| self.host("default"))
    }

    /// The module's `repr`, in the format of a `.netrc` file.
    fn repr(ref self) -> String {
        let mut rep = String.new();
        for (host, a) in self.hosts.iter() {
            rep.push_str(f"machine {host}\n\tlogin {a.login}\n");
            if not a.account.is_empty() {
                rep.push_str(f"\taccount {a.account}\n");
            }
            rep.push_str(f"\tpassword {a.password}\n");
        }
        for (name, lines) in self.macros.iter() {
            rep.push_str(f"macdef {name}\n");
            for line in lines.iter() {
                rep.push_str(line);
            }
            rep.push_str("\n");
        }
        rep
    }
}

// ------------------------------------------------------------ the player

struct Player {
    parsed: Map[String, Netrc],
}

fn usage(cmd: Str) -> Option[String] {
    match cmd {
        "parse" => Some("usage: parse NAME"),
        "dump" => Some("usage: dump NAME"),
        "auth" => Some("usage: auth NAME HOST"),
        "macro" => Some("usage: macro NAME MACRO"),
        _ => None,
    }
}

impl Player {
    fn run(mut ref self, words: Slice[String]) -> Result[Vec[String], String] {
        let cmd = words[0].as_str();
        let Some(text) = usage(cmd) else {
            return Err(f"unknown command {cmd}");
        };
        if words.len() != text.split_whitespace().count() - 1 {
            return Err(text);
        }
        if cmd == "parse" {
            let path = f"data/{words[1]}.netrc";
            self.parsed.remove(words[1]);
            let Ok(body) = fs.read_to_string(path) else {
                return Err(f"no file {path}");
            };
            let n = Netrc.parse(path, body)?;
            let line = f"parsed {path}: {n.hosts.len()} hosts, {n.macros.len()} macros";
            self.parsed.insert(words[1].clone(), n);
            return Ok([line]);
        }
        let Some(n) = self.parsed.get(words[1]) else {
            return Err(f"{words[1]} is not parsed");
        };
        match cmd {
            "dump" => {
                let rep = n.repr();
                let mut lines: Vec[String] = rep.split("\n").map(|l| f"| {l}").collect();
                lines.pop();
                Ok(lines)
            }
            "auth" => match n.authenticators(words[2]) {
                Some(a) => Ok([a.repr()]),
                None => Ok(["None".to_string()]),
            },
            _ => {
                let Some(lines) = n.macro(words[2]) else {
                    return Err(f"no macro {words[2]}");
                };
                let parts: Vec[String] = lines.iter().map(|l| py_repr(l)).collect();
                Ok([f"[{parts.join(", ")}]"])
            }
        }
    }
}

fn play(script: Str) {
    let mut player = Player { parsed: Map.new() };
    println("== mini_netrc");
    for (i, line) in script.split("\n").enumerate() {
        let words: Vec[String] = line.split_whitespace().map(|w| w.to_string()).collect();
        if words.is_empty() or words[0].starts_with("#") {
            continue;
        }
        println(f"> {words.join(" ")}");
        match player.run(words) {
            Ok(lines) => {
                for l in lines.iter() {
                    println(f"  {l}");
                }
            }
            Err(e) => println(f"  error: script.txt:{i + 1}: {e}"),
        }
    }
    println("== end");
    println(f"  {player.parsed.len()} files parsed");
}

fn run() -> Result[(), String] {
    fs.create_dir_all("data").map_err(|e| f"cannot create data: {e}")?;
    write_data()?;
    let text = fs.read_to_string("data/script.txt").map_err(|e| f"cannot read data/script.txt: {e}")?;
    play(text);
    Ok(())
}

fn put_bytes(path: Str, hex: Str) -> Result[(), String] {
    let digits: String = hex.chars().filter(|c| not c.is_whitespace()).collect();
    let bytes = hex_decode(digits).map_err(|e| f"bad data for {path}: {e}")?;
    fs.write_bytes(path, bytes).map_err(|e| f"cannot write {path}: {e}")
}

fn main() {
    if let Err(e) = run() {
        eprintln(e);
    }
}

// ============================================================ data

// The files under data/, in name order.
fn write_data() -> Result[(), String] {
    put_bytes("data/after_macro.netrc", file_0())?;
    put_bytes("data/bad_follower.netrc", file_1())?;
    put_bytes("data/bad_toplevel.netrc", file_2())?;
    put_bytes("data/comments.netrc", file_3())?;
    put_bytes("data/crlf.netrc", file_4())?;
    put_bytes("data/dangling.netrc", file_5())?;
    put_bytes("data/deploy.netrc", file_6())?;
    put_bytes("data/empty.netrc", file_7())?;
    put_bytes("data/empty_name.netrc", file_8())?;
    put_bytes("data/gap_comment.netrc", file_9())?;
    put_bytes("data/late_login.netrc", file_10())?;
    put_bytes("data/lone_hash_entry.netrc", file_11())?;
    put_bytes("data/macros.netrc", file_12())?;
    put_bytes("data/missing_name.netrc", file_13())?;
    put_bytes("data/only_comments.netrc", file_14())?;
    put_bytes("data/open_macro.netrc", file_15())?;
    put_bytes("data/open_quote.netrc", file_16())?;
    put_bytes("data/quoting.netrc", file_17())?;
    put_bytes("data/script.txt", file_18())?;
    Ok(())
}

