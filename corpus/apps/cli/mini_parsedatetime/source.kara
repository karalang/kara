// mini_parsedatetime: a port of parsedatetime 2.6 (Apache-2.0; Mike Taylor
// and contributors), the library that turns "tomorrow at 5pm", "3 days
// ago" or "next friday" into a date, as reminder bots, to-do tools and
// schedulers use it. It replays data/jobs.tsv (see mk.py): calls on the
// Calendar's parse(), parseDT(), nlp() and evalRanges() and its helpers
// under several clocks, constants and locales, and a small reminders
// tool that reads an inbox and a to-do list under data/ and writes an
// agenda for each.
//
// Text is held as a Vec of code points. The library's regular
// expressions are read off the vendored module (regex_text()) and
// compiled here for a backtracking matcher that tries alternatives in
// order, as Python's re does. The clock is the job's (time.localtime()
// in UTC), and a datetime is a count of microseconds from 0001-01-01.

// ------------------------------------------------------------ code points

fn chr_of(n: i64) -> char {
    match char.try_from(n) {
        Ok(c) => c,
        Err(_) => '?',
    }
}

fn cps_of(s: ref String) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s.chars() {
        out.push(c as i64);
    }
    out
}

fn cps_str(cs: ref Vec[i64]) -> String {
    let mut s = String.new();
    for c in cs {
        s.push(chr_of(*c));
    }
    s
}

fn lit(s: Str) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s.chars() {
        out.push(c as i64);
    }
    out
}

fn sub(cs: ref Vec[i64], lo: i64, hi: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let end = if hi > cs.len() { cs.len() } else { hi };
    let mut k = if lo < 0 { 0 } else { lo };
    while k < end {
        out.push(cs[k]);
        k += 1;
    }
    out
}

fn push_all(out: mut ref Vec[i64], xs: ref Vec[i64]) {
    for x in xs {
        out.push(*x);
    }
}

fn cat(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut out = a.clone();
    push_all(mut out, b);
    out
}

// '%s %s' % (a, b)
fn spaced(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut out = a.clone();
    out.push(32);
    push_all(mut out, b);
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut k = 0;
    while k < a.len() {
        if a[k] != b[k] {
            return false;
        }
        k += 1;
    }
    true
}

fn is(a: ref Vec[i64], s: Str) -> bool {
    same(a, lit(s))
}

fn starts_with(cs: ref Vec[i64], at: i64, p: ref Vec[i64]) -> bool {
    if at + p.len() > cs.len() {
        return false;
    }
    let mut k = 0;
    while k < p.len() {
        if cs[at + k] != p[k] {
            return false;
        }
        k += 1;
    }
    true
}

// str.replace(old, new): non-overlapping, left to right.
fn replace_all(cs: ref Vec[i64], old: ref Vec[i64], new: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < cs.len() {
        if old.len() > 0 and starts_with(cs, k, old) {
            push_all(mut out, new);
            k += old.len();
        } else {
            out.push(cs[k]);
            k += 1;
        }
    }
    out
}

// `x in s` for a substring.
fn contains(cs: ref Vec[i64], p: ref Vec[i64]) -> bool {
    let mut k = 0;
    while k + p.len() <= cs.len() {
        if starts_with(cs, k, p) {
            return true;
        }
        k += 1;
    }
    false
}

// `x in list`
fn in_list(xs: ref Vec[Vec[i64]], x: ref Vec[i64]) -> bool {
    for y in xs.iter() {
        if same(y, x) {
            return true;
        }
    }
    false
}

fn hex_val(c: char) -> i64 {
    if c >= '0' and c <= '9' {
        c as i64 - 48
    } else if c >= 'a' and c <= 'f' {
        c as i64 - 87
    } else if c >= 'A' and c <= 'F' {
        c as i64 - 55
    } else {
        -1
    }
}

fn hex_num(s: ref String) -> i64 {
    let mut v = 0;
    for c in s.chars() {
        v = v * 16 + hex_val(c);
    }
    v
}

fn hex_bytes(s: ref String) -> Vec[u8] {
    let cs: Vec[char] = s.chars().collect();
    let mut bytes: Vec[u8] = Vec.new();
    let mut k = 0;
    while k + 1 < cs.len() {
        bytes.push((hex_val(cs[k]) * 16 + hex_val(cs[k + 1])) as u8);
        k += 2;
    }
    bytes
}

// The text a run of hex digit pairs spells in UTF-8, as code points ("-"
// is the empty string).
fn hex_text(s: ref String) -> Vec[i64] {
    utf8_cps(hex_bytes(s))
}

fn utf8_cps(bytes: own Vec[u8]) -> Vec[i64] {
    match String.from_utf8(bytes) {
        Ok(s) => cps_of(s),
        Err(_) => Vec.new(),
    }
}

fn split_on(s: ref String, sep: char) -> Vec[String] {
    let mut pieces: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            pieces.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    pieces.push(cur);
    pieces
}

fn split_cps(cs: ref Vec[i64], sep: i64) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    for c in cs {
        if *c == sep {
            out.push(cur);
            cur = Vec.new();
        } else {
            cur.push(*c);
        }
    }
    out.push(cur);
    out
}

// str.lower()
fn lower(cs: ref Vec[i64]) -> Vec[i64] {
    cps_of(cps_str(cs).to_lowercase())
}

// ------------------------------------------------------------ Unicode data

// Sorted, non-overlapping [lo, hi] runs, flattened.
fn in_runs(rs: ref Vec[i64], cp: i64) -> bool {
    let mut lo = 0;
    let mut hi = rs.len() / 2;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if rs[2 * mid + 1] < cp {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo < rs.len() / 2 and rs[2 * lo] <= cp
}

// str.isalnum(), isdecimal() and isspace() as runs (see unicode_text()).
struct Uni {
    alnum: Vec[i64],
    decimal: Vec[i64],
    space: Vec[i64],
}

fn load_uni() -> Uni {
    let mut u = Uni { alnum: Vec.new(), decimal: Vec.new(), space: Vec.new() };
    for line in split_on(unicode_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let tag = line.substring(0, 1);
        let f = split_on(line.substring(1, line.len()), ' ');
        let lo = hex_num(f[0]);
        let hi = hex_num(f[1]);
        if tag == "W" {
            u.alnum.push(lo);
            u.alnum.push(hi);
        } else if tag == "9" {
            u.decimal.push(lo);
            u.decimal.push(hi);
        } else {
            u.space.push(lo);
            u.space.push(hi);
        }
    }
    u
}

// str.strip()
fn strip(u: ref Uni, cs: ref Vec[i64]) -> Vec[i64] {
    let mut a = 0;
    let mut b = cs.len();
    while a < b and in_runs(u.space, cs[a]) {
        a += 1;
    }
    while b > a and in_runs(u.space, cs[b - 1]) {
        b -= 1;
    }
    sub(cs, a, b)
}

// ------------------------------------------------------------ repr()

fn hex2(n: i64) -> String {
    let d: Vec[char] = "0123456789abcdef".chars().collect();
    let mut s = String.new();
    s.push(d[(n / 16) % 16]);
    s.push(d[n % 16]);
    s
}

fn has(cs: ref Vec[i64], x: i64) -> bool {
    for c in cs {
        if *c == x {
            return true;
        }
    }
    false
}

// repr() of a str; the texts here are printable ASCII and a few controls.
fn str_repr(cs: ref Vec[i64]) -> String {
    let q: i64 = if has(cs, 39) and not has(cs, 34) { 34 } else { 39 };
    let mut out = String.new();
    out.push(chr_of(q));
    for c in cs {
        let n = *c;
        if n == q or n == 92 {
            out.push('\\');
            out.push(chr_of(n));
        } else if n == 10 {
            out.push_str("\\n");
        } else if n == 13 {
            out.push_str("\\r");
        } else if n == 9 {
            out.push_str("\\t");
        } else if n < 0x20 or n == 0x7f {
            out.push_str(f"\\x{hex2(n)}");
        } else {
            out.push(chr_of(n));
        }
    }
    out.push(chr_of(q));
    out
}

// repr() of a float, which str() and '%s' also give.
fn float_repr(x: f64) -> String {
    f"{x}"
}

// ------------------------------------------------------------ errors

// A Python exception: its class and message.
struct Exc {
    cls: String,
    msg: String,
}

fn exc(cls: Str, msg: own String) -> Exc {
    Exc { cls: cls.to_string(), msg: msg }
}

// int(s) for a str of ASCII digits, as the library's int() calls see them.
fn py_int(u: ref Uni, s: ref Vec[i64]) -> Result[i64, Exc] {
    let t = strip(u, s);
    let mut k = 0;
    let mut neg = false;
    if k < t.len() and (t[k] == 43 or t[k] == 45) {
        neg = t[k] == 45;
        k += 1;
    }
    if k >= t.len() {
        return Err(exc("ValueError", f"invalid literal for int() with base 10: {str_repr(s)}"));
    }
    let mut v = 0;
    while k < t.len() {
        let c = t[k];
        if c < 48 or c > 57 {
            return Err(exc("ValueError", f"invalid literal for int() with base 10: {str_repr(s)}"));
        }
        v = v * 10 + c - 48;
        k += 1;
    }
    Ok(if neg { -v } else { v })
}

// float(s) for the decimal forms the library hands it: an optional sign,
// digits with an optional fraction, and an optional exponent. None is
// the ValueError. A value with at most 15 digits and a small exponent is
// one exact quotient, so it rounds as Python's correctly rounded parse
// does.
fn py_float(u: ref Uni, s: ref Vec[i64]) -> Option[f64] {
    let t = strip(u, s);
    let mut k = 0;
    let mut neg = false;
    if k < t.len() and (t[k] == 43 or t[k] == 45) {
        neg = t[k] == 45;
        k += 1;
    }
    let mut mant = 0;
    let mut nd = 0;
    let mut e10 = 0;
    let mut seen = false;
    while k < t.len() and t[k] >= 48 and t[k] <= 57 {
        if nd < 18 {
            mant = mant * 10 + t[k] - 48;
            if mant > 0 {
                nd += 1;
            }
        } else {
            e10 += 1;
        }
        seen = true;
        k += 1;
    }
    if k < t.len() and t[k] == 46 {
        k += 1;
        while k < t.len() and t[k] >= 48 and t[k] <= 57 {
            if nd < 18 {
                mant = mant * 10 + t[k] - 48;
                if mant > 0 {
                    nd += 1;
                }
                e10 -= 1;
            }
            seen = true;
            k += 1;
        }
    }
    if not seen {
        return None;
    }
    if k < t.len() and (t[k] == 101 or t[k] == 69) {
        k += 1;
        let mut eneg = false;
        if k < t.len() and (t[k] == 43 or t[k] == 45) {
            eneg = t[k] == 45;
            k += 1;
        }
        let mut ev = 0;
        let mut ed = false;
        while k < t.len() and t[k] >= 48 and t[k] <= 57 {
            if ev < 100000 {
                ev = ev * 10 + t[k] - 48;
            }
            ed = true;
            k += 1;
        }
        if not ed {
            return None;
        }
        e10 += if eneg { -ev } else { ev };
    }
    if k != t.len() {
        return None;
    }
    let mut v = mant as f64;
    if mant != 0 {
        let mut p = 1.0;
        let mut a = if e10 < 0 { -e10 } else { e10 };
        while a > 0 {
            p = p * 10.0;
            a -= 1;
        }
        v = if e10 < 0 { v / p } else { v * p };
    }
    Some(if neg { -v } else { v })
}

// ------------------------------------------------------------ regular expressions
//
// A backtracking matcher for the part of Python's re these patterns use:
// literals and escapes, classes with ranges and \s \w \d, ".", "^" and
// "$", \b and \B, capturing (also named) and non-capturing groups, named
// backreferences, the group-exists conditional, the four lookaround
// assertions, alternation, the * + ? {m} {m,n} quantifiers (greedy or
// lazy), and the IGNORECASE and VERBOSE flags. Classes are Unicode's, as
// for a str pattern.

// One instruction. Jump targets are offsets from the instruction itself,
// so a compiled piece can be copied (a quantifier repeats it) unchanged.
#[derive(Clone)]
struct Inst {
    op: i64,
    x: i64,
    y: i64,
    z: i64,
}

const OP_CHAR: i64 = 0;
const OP_ANY: i64 = 1;
const OP_CLASS: i64 = 2;
const OP_SPLIT: i64 = 3;
const OP_JMP: i64 = 4;
const OP_BOL: i64 = 5;
const OP_EOL: i64 = 6;
const OP_LOOK: i64 = 7;
const OP_MATCH: i64 = 8;
const OP_SAVE: i64 = 9;
const OP_WORDB: i64 = 10;
// A one-character atom repeated x..y times (z: lazy); the atom is the
// next instruction and the rest of the program follows it.
const OP_REP: i64 = 11;
// (?P=name): the text group x matched.
const OP_BACKREF: i64 = 12;
// (?(name)yes|no): on to the yes branch if group x matched, else jump y.
const OP_COND: i64 = 13;
// For a loop whose body can match empty: MARK x keeps where an iteration
// began in slot x; LOOPCHK x leaves the loop after an empty iteration
// (as sre does) and otherwise jumps y back to the loop's head.
const OP_MARK: i64 = 14;
const OP_LOOPCHK: i64 = 15;

fn inst(op: i64, x: i64, y: i64, z: i64) -> Inst {
    Inst { op: op, x: x, y: y, z: z }
}

// A character class: [lo, hi] runs, and the categories it includes
// (1 \s, 2 \w, 3 \d; negative for \S \W \D).
#[derive(Clone)]
struct Cls {
    neg: bool,
    runs: Vec[i64],
    cats: Vec[i64],
}

// A compiled piece of a pattern and the range of lengths it matches.
struct Frag {
    code: Vec[Inst],
    minw: i64,
    maxw: i64,
}

const INF: i64 = 1000000000;

fn frag(code: own Vec[Inst], minw: i64, maxw: i64) -> Frag {
    Frag { code: code, minw: minw, maxw: maxw }
}

const IGNORECASE: i64 = 2;
const VERBOSE: i64 = 64;

struct Regex {
    prog: Vec[Inst],
    classes: Vec[Cls],
    groups: i64,
    slots: i64,
    names: Vec[String],
    name_groups: Vec[i64],
    icase: bool,
    // The one-character instructions a match can begin with, so search()
    // tries only the positions one of them accepts (any_start: a match
    // can begin anywhere, or be empty).
    firsts: Vec[i64],
    any_start: bool,
}

struct ReParser {
    src: Vec[i64],
    pos: i64,
    verbose: bool,
    classes: Vec[Cls],
    groups: i64,
    slots: i64,
    names: Vec[String],
    name_groups: Vec[i64],
}

fn is_hex(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)
}

impl ReParser {
    fn more(ref self) -> bool {
        self.pos < self.src.len()
    }

    fn peek(ref self) -> i64 {
        if self.pos < self.src.len() { self.src[self.pos] } else { -1 }
    }

    // VERBOSE: whitespace and comments outside a class are ignored.
    fn skip_ws(mut ref self) {
        if not self.verbose {
            return;
        }
        while self.more() {
            let c = self.peek();
            if c == 32 or c == 9 or c == 10 or c == 13 or c == 11 or c == 12 {
                self.pos += 1;
            } else if c == 35 {
                while self.more() and self.peek() != 10 {
                    self.pos += 1;
                }
            } else {
                return;
            }
        }
    }

    fn add_class(mut ref self, c: Cls) -> i64 {
        self.classes.push(c.clone());
        self.classes.len() - 1
    }

    // The escape after a backslash: a code point, or a category as a
    // negative number (-1 \s, -2 \w, -3 \d, -11 \S, -12 \W, -13 \D).
    fn escape(mut ref self) -> i64 {
        let c = self.peek();
        self.pos += 1;
        let cats = lit("swdSWD");
        let mut k = 0;
        while k < 6 {
            if c == cats[k] {
                return if k < 3 { -(k + 1) } else { -(k + 8) };
            }
            k += 1;
        }
        let digits = if c == 120 { 2 } else if c == 117 { 4 } else if c == 85 { 8 } else { 0 };
        if digits > 0 {
            let mut v = 0;
            let mut n = 0;
            while n < digits and is_hex(self.peek()) {
                v = v * 16 + hex_val(chr_of(self.peek()));
                self.pos += 1;
                n += 1;
            }
            return v;
        }
        if c == 110 {
            return 10;
        }
        if c == 116 {
            return 9;
        }
        if c == 114 {
            return 13;
        }
        if c == 102 {
            return 12;
        }
        if c == 118 {
            return 11;
        }
        if c == 97 {
            return 7;
        }
        c
    }

    fn class_cat(mut ref self, e: i64) -> i64 {
        let cat = if e > -10 { -e } else { -(-e - 10) };
        let c = Cls { neg: false, runs: Vec.new(), cats: vec![cat] };
        self.add_class(c)
    }

    fn parse_class(mut ref self) -> i64 {
        let mut c = Cls { neg: false, runs: Vec.new(), cats: Vec.new() };
        if self.peek() == 94 {
            c.neg = true;
            self.pos += 1;
        }
        let mut first = true;
        while self.more() {
            let ch = self.peek();
            if ch == 93 and not first {
                self.pos += 1;
                break;
            }
            first = false;
            self.pos += 1;
            let lo = if ch == 92 { self.escape() } else { ch };
            if lo < 0 {
                c.cats.push(if lo > -10 { -lo } else { -(-lo - 10) });
                continue;
            }
            if self.peek() == 45 and self.pos + 1 < self.src.len() and self.src[self.pos + 1] != 93 {
                self.pos += 1;
                let h = self.peek();
                self.pos += 1;
                let hi = if h == 92 { self.escape() } else { h };
                c.runs.push(lo);
                c.runs.push(hi);
            } else {
                c.runs.push(lo);
                c.runs.push(lo);
            }
        }
        c.runs = merge_runs(c.runs);
        self.add_class(c)
    }

    // A group name up to (and past) the given closing character.
    fn name_to(mut ref self, close: i64) -> String {
        let mut s = String.new();
        while self.more() and self.peek() != close {
            s.push(chr_of(self.peek()));
            self.pos += 1;
        }
        self.pos += 1;
        s
    }

    fn group_of(ref self, name: ref String) -> i64 {
        let mut k = 0;
        while k < self.names.len() {
            if self.names[k] == *name {
                return self.name_groups[k];
            }
            k += 1;
        }
        0
    }

    fn parse_alt(mut ref self) -> Frag {
        let mut branches: Vec[Frag] = Vec.new();
        branches.push(self.parse_seq());
        while self.peek() == 124 {
            self.pos += 1;
            branches.push(self.parse_seq());
        }
        if branches.len() == 1 {
            return branches.pop().unwrap();
        }
        let mut minw = INF;
        let mut maxw = 0;
        let mut total = 0;
        for b in branches.iter() {
            total += b.code.len() + 2;
            if b.minw < minw {
                minw = b.minw;
            }
            if b.maxw > maxw {
                maxw = b.maxw;
            }
        }
        total -= 2;
        let mut code: Vec[Inst] = Vec.new();
        let n = branches.len();
        let mut k = 0;
        for b in branches.iter() {
            if k < n - 1 {
                code.push(inst(OP_SPLIT, 1, b.code.len() + 2, 0));
            }
            for i in b.code.iter() {
                code.push(i.clone());
            }
            if k < n - 1 {
                code.push(inst(OP_JMP, total - code.len(), 0, 0));
            }
            k += 1;
        }
        frag(code, minw, maxw)
    }

    fn parse_seq(mut ref self) -> Frag {
        let mut code: Vec[Inst] = Vec.new();
        let mut minw = 0;
        let mut maxw = 0;
        loop {
            self.skip_ws();
            let c = self.peek();
            if c < 0 or c == 124 or c == 41 {
                break;
            }
            let atom = self.parse_atom();
            let piece = self.parse_quant(atom);
            for i in piece.code.iter() {
                code.push(i.clone());
            }
            minw += piece.minw;
            maxw = if maxw >= INF or piece.maxw >= INF { INF } else { maxw + piece.maxw };
        }
        frag(code, minw, maxw)
    }

    fn parse_atom(mut ref self) -> Frag {
        let c = self.peek();
        self.pos += 1;
        if c == 40 {
            // -2: capturing, -1: (?:...), 0..3: lookahead, negative
            // lookahead, lookbehind, negative lookbehind
            let mut look = -2;
            let mut name = String.new();
            if self.peek() == 63 {
                self.pos += 1;
                let k = self.peek();
                self.pos += 1;
                if k == 80 {
                    let k2 = self.peek();
                    self.pos += 1;
                    if k2 == 61 {
                        // (?P=name)
                        let n = self.name_to(41);
                        let g = self.group_of(n);
                        return frag(vec![inst(OP_BACKREF, g, 0, 0)], 0, INF);
                    }
                    name = self.name_to(62);
                } else if k == 40 {
                    // (?(name)yes|no)
                    let n = self.name_to(41);
                    let g = self.group_of(n);
                    let yes = self.parse_seq();
                    let mut no = frag(Vec.new(), 0, 0);
                    if self.peek() == 124 {
                        self.pos += 1;
                        no = self.parse_seq();
                    }
                    self.pos += 1;
                    let mut code: Vec[Inst] = Vec.new();
                    code.push(inst(OP_COND, g, yes.code.len() + 2, 0));
                    copy_code(mut code, yes.code);
                    code.push(inst(OP_JMP, no.code.len() + 1, 0, 0));
                    copy_code(mut code, no.code);
                    let minw = if yes.minw < no.minw { yes.minw } else { no.minw };
                    let maxw = if yes.maxw > no.maxw { yes.maxw } else { no.maxw };
                    return frag(code, minw, maxw);
                } else if k == 60 {
                    let k2 = self.peek();
                    self.pos += 1;
                    look = if k2 == 33 { 3 } else { 2 };
                } else if k == 33 {
                    look = 1;
                } else if k == 61 {
                    look = 0;
                } else {
                    look = -1;
                }
            }
            let mut group = 0;
            if look == -2 {
                self.groups += 1;
                group = self.groups;
                if name.len() > 0 {
                    self.names.push(name);
                    self.name_groups.push(group);
                }
            }
            let inner = self.parse_alt();
            self.pos += 1;
            if look == -1 {
                return inner;
            }
            let mut code: Vec[Inst] = Vec.new();
            if look == -2 {
                code.push(inst(OP_SAVE, 2 * group, 0, 0));
                for i in inner.code.iter() {
                    code.push(i.clone());
                }
                code.push(inst(OP_SAVE, 2 * group + 1, 0, 0));
                return frag(code, inner.minw, inner.maxw);
            }
            let z = if look >= 2 { look + 4 * inner.minw } else { look };
            code.push(inst(OP_LOOK, 1, inner.code.len() + 2, z));
            for i in inner.code.iter() {
                code.push(i.clone());
            }
            code.push(inst(OP_MATCH, 0, 0, 0));
            return frag(code, 0, 0);
        }
        if c == 91 {
            let k = self.parse_class();
            return frag(vec![inst(OP_CLASS, k, 0, 0)], 1, 1);
        }
        if c == 46 {
            return frag(vec![inst(OP_ANY, 0, 0, 0)], 1, 1);
        }
        if c == 94 {
            return frag(vec![inst(OP_BOL, 0, 0, 0)], 0, 0);
        }
        if c == 36 {
            return frag(vec![inst(OP_EOL, 0, 0, 0)], 0, 0);
        }
        if c == 92 {
            let n = self.peek();
            if n == 98 or n == 66 {
                self.pos += 1;
                return frag(vec![inst(OP_WORDB, if n == 98 { 1 } else { 0 }, 0, 0)], 0, 0);
            }
            let e = self.escape();
            if e < 0 {
                let k = self.class_cat(e);
                return frag(vec![inst(OP_CLASS, k, 0, 0)], 1, 1);
            }
            return frag(vec![inst(OP_CHAR, e, 0, 0)], 1, 1);
        }
        frag(vec![inst(OP_CHAR, c, 0, 0)], 1, 1)
    }

    // A number at the parser's position, or -1 if there is none.
    fn number(mut ref self) -> i64 {
        let start = self.pos;
        let mut v = 0;
        while self.peek() >= 48 and self.peek() <= 57 {
            v = v * 10 + self.peek() - 48;
            self.pos += 1;
        }
        if self.pos == start { -1 } else { v }
    }

    fn parse_quant(mut ref self, atom: own Frag) -> Frag {
        self.skip_ws();
        let c = self.peek();
        let mut lo = -1;
        let mut hi = -1;
        if c == 42 {
            lo = 0;
            hi = INF;
            self.pos += 1;
        } else if c == 43 {
            lo = 1;
            hi = INF;
            self.pos += 1;
        } else if c == 63 {
            lo = 0;
            hi = 1;
            self.pos += 1;
        } else if c == 123 {
            let save = self.pos;
            self.pos += 1;
            let a = self.number();
            let mut b = a;
            if self.peek() == 44 {
                self.pos += 1;
                b = self.number();
                if b < 0 {
                    b = INF;
                }
            }
            if self.peek() == 125 and (a >= 0 or b >= 0) {
                self.pos += 1;
                lo = if a < 0 { 0 } else { a };
                hi = b;
            } else {
                self.pos = save;
                return atom;
            }
        } else {
            return atom;
        }
        let mut lazy = false;
        if self.peek() == 63 {
            lazy = true;
            self.pos += 1;
        }
        let mut slot = -1;
        if hi >= INF and atom.minw == 0 {
            slot = self.slots;
            self.slots += 1;
        }
        repeat(atom, lo, hi, lazy, slot)
    }
}

fn merge_runs(rs: Vec[i64]) -> Vec[i64] {
    let n = rs.len() / 2;
    let mut idx: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < n {
        let mut j = idx.len();
        idx.push(k);
        while j > 0 and rs[2 * idx[j - 1]] > rs[2 * k] {
            idx[j] = idx[j - 1];
            j -= 1;
        }
        idx[j] = k;
        k += 1;
    }
    let mut out: Vec[i64] = Vec.new();
    for i in idx {
        let lo = rs[2 * i];
        let hi = rs[2 * i + 1];
        let m = out.len();
        if m > 0 and lo <= out[m - 1] + 1 {
            if hi > out[m - 1] {
                out[m - 1] = hi;
            }
        } else {
            out.push(lo);
            out.push(hi);
        }
    }
    out
}

fn copy_code(dst: mut ref Vec[Inst], src: ref Vec[Inst]) {
    for i in src.iter() {
        dst.push(i.clone());
    }
}

// atom{lo,hi}; slot >= 0 for an unbounded loop whose body can match empty.
fn repeat(atom: Frag, lo: i64, hi: i64, lazy: bool, slot: i64) -> Frag {
    let n = atom.code.len();
    let minw = atom.minw * lo;
    let maxw = if hi >= INF or atom.maxw >= INF { INF } else { atom.maxw * hi };
    let mut code: Vec[Inst] = Vec.new();
    if n == 1 {
        let op = atom.code[0].op;
        if op == OP_CHAR or op == OP_ANY or op == OP_CLASS {
            code.push(inst(OP_REP, lo, hi, if lazy { 1 } else { 0 }));
            code.push(atom.code[0].clone());
            return frag(code, minw, maxw);
        }
    }
    let mut k = 0;
    while k < lo {
        copy_code(mut code, atom.code);
        k += 1;
    }
    if hi >= INF {
        if slot >= 0 {
            // L: split body, out; mark; body; loopchk (out, or back to L)
            if lazy {
                code.push(inst(OP_SPLIT, n + 3, 1, 0));
            } else {
                code.push(inst(OP_SPLIT, 1, n + 3, 0));
            }
            code.push(inst(OP_MARK, slot, 0, 0));
            copy_code(mut code, atom.code);
            code.push(inst(OP_LOOPCHK, slot, -(n + 2), 0));
        } else {
            // L: split body, out; body; jmp L
            if lazy {
                code.push(inst(OP_SPLIT, n + 2, 1, 0));
            } else {
                code.push(inst(OP_SPLIT, 1, n + 2, 0));
            }
            copy_code(mut code, atom.code);
            code.push(inst(OP_JMP, -(n + 1), 0, 0));
        }
    } else {
        // Each optional copy: split body, end; body. Nested, so they
        // are taken in order.
        let opt = hi - lo;
        let mut j = 0;
        while j < opt {
            let rest = (opt - j) * (n + 1) - 1;
            if lazy {
                code.push(inst(OP_SPLIT, rest + 1, 1, 0));
            } else {
                code.push(inst(OP_SPLIT, 1, rest + 1, 0));
            }
            copy_code(mut code, atom.code);
            j += 1;
        }
    }
    frag(code, minw, maxw)
}

fn compile(src: ref Vec[i64], flags: i64) -> Regex {
    let mut p = ReParser {
        src: src.clone(),
        pos: 0,
        verbose: (flags & VERBOSE) != 0,
        classes: Vec.new(),
        groups: 0,
        slots: 0,
        names: Vec.new(),
        name_groups: Vec.new(),
    };
    let f = p.parse_alt();
    let mut prog = f.code;
    prog.push(inst(OP_MATCH, 0, 0, 0));
    let mut firsts: Vec[i64] = Vec.new();
    let mut seen: Vec[bool] = Vec.new();
    for _ in 0..prog.len() {
        seen.push(false);
    }
    let any_start = first_atoms(prog, 0, mut seen, mut firsts);
    Regex {
        prog: prog,
        classes: p.classes,
        groups: p.groups,
        slots: p.slots,
        names: p.names,
        name_groups: p.name_groups,
        icase: (flags & IGNORECASE) != 0,
        firsts: firsts,
        any_start: any_start,
    }
}

// Collects into firsts the atoms a match from pc can consume first;
// true if it can match without consuming anything (or past $ or a
// backreference), when search() must try every position. A path through
// ^ only matches at 0, which search() always tries.
fn first_atoms(prog: ref Vec[Inst], pc: i64, seen: mut ref Vec[bool], firsts: mut ref Vec[i64]) -> bool {
    if seen[pc] {
        return false;
    }
    seen[pc] = true;
    let i = ref prog[pc];
    let op = i.op;
    if op == OP_CHAR or op == OP_CLASS {
        firsts.push(pc);
        false
    } else if op == OP_ANY or op == OP_MATCH or op == OP_EOL or op == OP_BACKREF {
        true
    } else if op == OP_REP {
        if prog[pc + 1].op == OP_ANY {
            return true;
        }
        firsts.push(pc + 1);
        if i.x == 0 { first_atoms(prog, pc + 2, mut seen, mut firsts) } else { false }
    } else if op == OP_SPLIT or op == OP_COND {
        let a = first_atoms(prog, pc + (if op == OP_COND { 1 } else { i.x }), mut seen, mut firsts);
        let b = first_atoms(prog, pc + i.y, mut seen, mut firsts);
        a or b
    } else if op == OP_JMP {
        first_atoms(prog, pc + i.x, mut seen, mut firsts)
    } else if op == OP_LOOPCHK {
        let a = first_atoms(prog, pc + 1, mut seen, mut firsts);
        let b = first_atoms(prog, pc + i.y, mut seen, mut firsts);
        a or b
    } else if op == OP_BOL {
        false
    } else if op == OP_LOOK {
        first_atoms(prog, pc + i.y, mut seen, mut firsts)
    } else {
        first_atoms(prog, pc + 1, mut seen, mut firsts)
    }
}

fn word_char(u: ref Uni, c: i64) -> bool {
    c == 95 or in_runs(u.alnum, c)
}

fn cat_has(u: ref Uni, cat: i64, c: i64) -> bool {
    let a = if cat < 0 { -cat } else { cat };
    let r = if a == 1 {
        in_runs(u.space, c)
    } else if a == 2 {
        word_char(u, c)
    } else {
        in_runs(u.decimal, c)
    };
    if cat < 0 { not r } else { r }
}

fn ascii_lower(c: i64) -> i64 {
    if c >= 65 and c <= 90 { c + 32 } else { c }
}

fn ascii_upper(c: i64) -> i64 {
    if c >= 97 and c <= 122 { c - 32 } else { c }
}

// A match: where it ends, and each group's (start, end), -1 if unset.
struct Match {
    end: i64,
    caps: Vec[i64],
}

impl Regex {
    fn in_class(ref self, u: ref Uni, k: i64, c: i64) -> bool {
        let cl = ref self.classes[k];
        let mut r = in_runs(cl.runs, c);
        if not r {
            for cat in cl.cats.iter() {
                if cat_has(u, *cat, c) {
                    r = true;
                }
            }
        }
        if cl.neg { not r } else { r }
    }

    fn class_hit(ref self, u: ref Uni, k: i64, c: i64) -> bool {
        let cl = ref self.classes[k];
        let mut r = in_runs(cl.runs, c);
        for cat in cl.cats.iter() {
            if cat_has(u, *cat, c) {
                r = true;
            }
        }
        r
    }

    fn atom_ok(ref self, u: ref Uni, i: ref Inst, c: i64) -> bool {
        if i.op == OP_CHAR {
            if self.icase { ascii_lower(c) == ascii_lower(i.x) } else { c == i.x }
        } else if i.op == OP_ANY {
            c != 10
        } else if self.icase {
            let r = self.class_hit(u, i.x, c) or self.class_hit(u, i.x, ascii_lower(c))
                or self.class_hit(u, i.x, ascii_upper(c));
            if self.classes[i.x].neg { not r } else { r }
        } else {
            self.in_class(u, i.x, c)
        }
    }

    // Runs the program from pc at pos: the end of the first match the
    // backtracking order finds, or -1. Groups set on the way are written
    // to caps only along the path that matches.
    fn run(ref self, u: ref Uni, pc0: i64, pos0: i64, t: ref Vec[i64], caps: mut ref Vec[i64]) -> i64 {
        let mut pc = pc0;
        let mut pos = pos0;
        let n = t.len();
        loop {
            let i = ref self.prog[pc];
            let op = i.op;
            if op == OP_CHAR or op == OP_ANY or op == OP_CLASS {
                if pos < n and self.atom_ok(u, i, t[pos]) {
                    pos += 1;
                    pc += 1;
                } else {
                    return -1;
                }
            } else if op == OP_REP {
                let atom = ref self.prog[pc + 1];
                let mut most = 0;
                while most < i.y and pos + most < n and self.atom_ok(u, atom, t[pos + most]) {
                    most += 1;
                }
                if most < i.x {
                    return -1;
                }
                let lazy = i.z == 1;
                let mut j = if lazy { i.x } else { most };
                loop {
                    let mut c2 = caps.clone();
                    let r = self.run(u, pc + 2, pos + j, t, mut c2);
                    if r >= 0 {
                        copy_caps(mut caps, c2);
                        return r;
                    }
                    if lazy {
                        if j >= most {
                            return -1;
                        }
                        j += 1;
                    } else {
                        if j <= i.x {
                            return -1;
                        }
                        j -= 1;
                    }
                }
            } else if op == OP_SPLIT {
                let mut c2 = caps.clone();
                let r = self.run(u, pc + i.x, pos, t, mut c2);
                if r >= 0 {
                    copy_caps(mut caps, c2);
                    return r;
                }
                pc += i.y;
            } else if op == OP_JMP {
                pc += i.x;
            } else if op == OP_SAVE {
                caps[i.x] = pos;
                pc += 1;
            } else if op == OP_MARK {
                caps[2 * (self.groups + 1) + i.x] = pos;
                pc += 1;
            } else if op == OP_LOOPCHK {
                if caps[2 * (self.groups + 1) + i.x] == pos {
                    pc += 1;
                } else {
                    pc += i.y;
                }
            } else if op == OP_BACKREF {
                let g = i.x;
                let a = caps[2 * g];
                let b = caps[2 * g + 1];
                if a < 0 or b < 0 or pos + (b - a) > n {
                    return -1;
                }
                let mut k = 0;
                while k < b - a {
                    let x = t[a + k];
                    let y = t[pos + k];
                    let ok = if self.icase { ascii_lower(x) == ascii_lower(y) } else { x == y };
                    if not ok {
                        return -1;
                    }
                    k += 1;
                }
                pos += b - a;
                pc += 1;
            } else if op == OP_COND {
                if caps[2 * i.x] >= 0 and caps[2 * i.x + 1] >= 0 {
                    pc += 1;
                } else {
                    pc += i.y;
                }
            } else if op == OP_BOL {
                if pos != 0 {
                    return -1;
                }
                pc += 1;
            } else if op == OP_EOL {
                if not (pos == n or (pos == n - 1 and t[pos] == 10)) {
                    return -1;
                }
                pc += 1;
            } else if op == OP_WORDB {
                let before = pos > 0 and word_char(u, t[pos - 1]);
                let after = pos < n and word_char(u, t[pos]);
                if (before != after) != (i.x == 1) {
                    return -1;
                }
                pc += 1;
            } else if op == OP_LOOK {
                let kind = i.z % 4;
                let width = i.z / 4;
                let mut ok = false;
                let mut scratch = caps.clone();
                if kind >= 2 {
                    let start = pos - width;
                    if start >= 0 {
                        ok = self.run(u, pc + i.x, start, t, mut scratch) == pos;
                    }
                } else {
                    ok = self.run(u, pc + i.x, pos, t, mut scratch) >= 0;
                }
                if kind == 1 or kind == 3 {
                    ok = not ok;
                }
                if not ok {
                    return -1;
                }
                pc += i.y;
            } else {
                return pos;
            }
        }
    }

    fn fresh_caps(ref self) -> Vec[i64] {
        let mut caps: Vec[i64] = Vec.new();
        for _ in 0..2 * (self.groups + 1) + self.slots {
            caps.push(-1);
        }
        caps
    }

    // match(): anchored at pos.
    fn match_at(ref self, u: ref Uni, t: ref Vec[i64], pos: i64) -> Option[Match] {
        let mut caps = self.fresh_caps();
        let e = self.run(u, 0, pos, t, mut caps);
        if e < 0 {
            return None;
        }
        caps[0] = pos;
        caps[1] = e;
        Some(Match { end: e, caps: caps })
    }

    // search() from pos.
    fn search_from(ref self, u: ref Uni, t: ref Vec[i64], pos: i64) -> Option[Match] {
        let mut s = pos;
        while s <= t.len() {
            if s > 0 and not self.any_start {
                let mut ok = false;
                if s < t.len() {
                    for f in self.firsts.iter() {
                        if not ok and self.atom_ok(u, self.prog[*f], t[s]) {
                            ok = true;
                        }
                    }
                }
                if not ok {
                    s += 1;
                    continue;
                }
            }
            match self.match_at(u, t, s) {
                Some(m) => {
                    return Some(m);
                }
                None => {}
            }
            s += 1;
        }
        None
    }

    fn search(ref self, u: ref Uni, t: ref Vec[i64]) -> Option[Match] {
        self.search_from(u, t, 0)
    }

    // finditer(): each non-overlapping match, left to right.
    fn find_all(ref self, u: ref Uni, t: ref Vec[i64]) -> Vec[Match] {
        let mut out: Vec[Match] = Vec.new();
        let mut pos = 0;
        while pos <= t.len() {
            let m = match self.search_from(u, t, pos) {
                Some(m) => m,
                None => {
                    break;
                }
            };
            let s = m.caps[0];
            pos = if m.end > s { m.end } else { m.end + 1 };
            out.push(m);
        }
        out
    }

    // sub(): each match replaced by the template, where \1 to \9 are
    // groups (an unmatched one is empty).
    fn sub(ref self, u: ref Uni, t: ref Vec[i64], template: Str) -> Vec[i64] {
        let tm = lit(template);
        let mut out: Vec[i64] = Vec.new();
        let mut last = 0;
        for m in self.find_all(u, t).iter() {
            push_all(mut out, sub(t, last, m.caps[0]));
            let mut k = 0;
            while k < tm.len() {
                if tm[k] == 92 and k + 1 < tm.len() and tm[k + 1] >= 48 and tm[k + 1] <= 57 {
                    let g = tm[k + 1] - 48;
                    k += 2;
                    if m.caps[2 * g] >= 0 and m.caps[2 * g + 1] >= 0 {
                        push_all(mut out, sub(t, m.caps[2 * g], m.caps[2 * g + 1]));
                    }
                } else {
                    out.push(tm[k]);
                    k += 1;
                }
            }
            last = m.end;
        }
        push_all(mut out, sub(t, last, t.len()));
        out
    }

    // re.split() with a pattern that has no groups.
    fn split(ref self, u: ref Uni, t: ref Vec[i64]) -> Vec[Vec[i64]] {
        let mut out: Vec[Vec[i64]] = Vec.new();
        let mut last = 0;
        for m in self.find_all(u, t).iter() {
            out.push(sub(t, last, m.caps[0]));
            last = m.end;
        }
        out.push(sub(t, last, t.len()));
        out
    }

    fn gi(ref self, name: Str) -> i64 {
        let mut k = 0;
        while k < self.names.len() {
            if self.names[k] == name {
                return self.name_groups[k];
            }
            k += 1;
        }
        0
    }
}

fn copy_caps(dst: mut ref Vec[i64], src: ref Vec[i64]) {
    let mut k = 0;
    while k < src.len() {
        dst[k] = src[k];
        k += 1;
    }
}

// m.start(name), m.end(name) and m.group(name) (a name "" is group 0).
fn m_start(rx: ref Regex, m: ref Match, name: Str) -> i64 {
    let g = if name == "" { 0 } else { rx.gi(name) };
    m.caps[2 * g]
}

fn m_end(rx: ref Regex, m: ref Match, name: Str) -> i64 {
    let g = if name == "" { 0 } else { rx.gi(name) };
    m.caps[2 * g + 1]
}

fn m_group(rx: ref Regex, m: ref Match, t: ref Vec[i64], name: Str) -> Option[Vec[i64]] {
    let g = if name == "" { 0 } else { rx.gi(name) };
    if m.caps[2 * g] < 0 or m.caps[2 * g + 1] < 0 {
        None
    } else {
        Some(sub(t, m.caps[2 * g], m.caps[2 * g + 1]))
    }
}

fn m_text(m: ref Match, t: ref Vec[i64]) -> Vec[i64] {
    sub(t, m.caps[0], m.caps[1])
}

// ------------------------------------------------------------ the locales

// A str -> int dict, in its insertion order.
struct Dict {
    keys: Vec[Vec[i64]],
    vals: Vec[i64],
}

impl Dict {
    fn get(ref self, k: ref Vec[i64]) -> Option[i64] {
        let mut i = 0;
        while i < self.keys.len() {
            if same(self.keys[i], k) {
                return Some(self.vals[i]);
            }
            i += 1;
        }
        None
    }
}

// The Constants object's compiled expressions (the ones the Calendar
// uses), each from its cre_source.
struct Rx {
    date: Regex,
    date2: Regex,
    date3: Regex,
    daterng1: Regex,
    daterng2: Regex,
    daterng3: Regex,
    day: Regex,
    day2: Regex,
    modifier: Regex,
    nlp_prefix: Regex,
    number: Regex,
    qunits: Regex,
    remaining: Regex,
    time: Regex,
    timehms: Regex,
    timehms2: Regex,
    timerng1: Regex,
    timerng2: Regex,
    timerng3: Regex,
    timerng4: Regex,
    units: Regex,
    units_only: Regex,
    weekday: Regex,
}

// What a pdt_locales module holds once Constants() has filled it in.
struct Loc {
    id: String,
    months: Vec[Vec[i64]],
    short_months: Vec[Vec[i64]],
    weekdays: Vec[Vec[i64]],
    dp_order: Vec[Vec[i64]],
    meridian: Vec[Vec[i64]],
    am: Vec[Vec[i64]],
    pm: Vec[Vec[i64]],
    now: Vec[Vec[i64]],
    ignore: Vec[Vec[i64]],
    uses_meridian: bool,
    numbers: Dict,
    small: Dict,
    magnitude: Dict,
    modifiers: Dict,
    day_offsets: Dict,
    weekday_offsets: Dict,
    month_offsets: Dict,
    unit_keys: Vec[String],
    unit_vals: Vec[Vec[Vec[i64]]],
    src_keys: Vec[Vec[i64]],
    src_vals: Vec[Vec[i64]],
    rx: Rx,
}

// The patterns the Calendar hands to re.sub(), re.search() and
// re.split() itself.
struct Mod {
    parse0: Regex,
    parse1: Regex,
    parse2: Regex,
    nlp0: Regex,
    nlp1: Regex,
    nlp2: Regex,
    range_sep: Regex,
    am0: Regex,
    split_words: Regex,
}

struct World {
    u: Uni,
    locs: Vec[Loc],
    m: Mod,
}

struct Pats {
    names: Vec[String],
    flags: Vec[i64],
    srcs: Vec[Vec[i64]],
}

fn load_pats() -> Pats {
    let mut p = Pats { names: Vec.new(), flags: Vec.new(), srcs: Vec.new() };
    for line in split_on(regex_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, ' ');
        p.names.push(f[0].clone());
        p.flags.push(hex_or_int(f[1]));
        p.srcs.push(hex_text(f[2]));
    }
    p
}

fn hex_or_int(s: ref String) -> i64 {
    let mut v = 0;
    for c in s.chars() {
        v = v * 10 + (c as i64 - 48);
    }
    v
}

fn pat(p: ref Pats, name: ref String) -> Regex {
    let mut k = 0;
    while k < p.names.len() {
        if p.names[k] == *name {
            return compile(p.srcs[k], p.flags[k]);
        }
        k += 1;
    }
    compile(Vec.new(), 0)
}

fn cre(p: ref Pats, loc: Str, name: Str) -> Regex {
    pat(p, f"{loc}.CRE_{name}")
}

fn load_rx(p: ref Pats, loc: Str) -> Rx {
    Rx {
        date: cre(p, loc, "DATE"),
        date2: cre(p, loc, "DATE2"),
        date3: cre(p, loc, "DATE3"),
        daterng1: cre(p, loc, "DATERNG1"),
        daterng2: cre(p, loc, "DATERNG2"),
        daterng3: cre(p, loc, "DATERNG3"),
        day: cre(p, loc, "DAY"),
        day2: cre(p, loc, "DAY2"),
        modifier: cre(p, loc, "MODIFIER"),
        nlp_prefix: cre(p, loc, "NLP_PREFIX"),
        number: cre(p, loc, "NUMBER"),
        qunits: cre(p, loc, "QUNITS"),
        remaining: cre(p, loc, "REMAINING"),
        time: cre(p, loc, "TIME"),
        timehms: cre(p, loc, "TIMEHMS"),
        timehms2: cre(p, loc, "TIMEHMS2"),
        timerng1: cre(p, loc, "TIMERNG1"),
        timerng2: cre(p, loc, "TIMERNG2"),
        timerng3: cre(p, loc, "TIMERNG3"),
        timerng4: cre(p, loc, "TIMERNG4"),
        units: cre(p, loc, "UNITS"),
        units_only: cre(p, loc, "UNITS_ONLY"),
        weekday: cre(p, loc, "WEEKDAY"),
    }
}

fn hex_list(s: ref String) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    if s == "-" {
        return out;
    }
    for item in split_on(s, ',') {
        out.push(hex_text(item));
    }
    out
}

fn hex_dict(s: ref String) -> Dict {
    let mut d = Dict { keys: Vec.new(), vals: Vec.new() };
    for item in split_on(s, ',') {
        let kv = split_on(item, ':');
        d.keys.push(hex_text(kv[0]));
        d.vals.push(int_of(kv[1]));
    }
    d
}

fn int_of(s: ref String) -> i64 {
    let mut neg = false;
    let mut v = 0;
    for c in s.chars() {
        if c == '-' {
            neg = true;
        } else {
            v = v * 10 + (c as i64 - 48);
        }
    }
    if neg { -v } else { v }
}

// The line of locale_text() for a locale and key: its kind and items.
fn loc_field(id: Str, key: Str) -> Vec[String] {
    for line in split_on(locale_text(), '\n') {
        let f = split_on(line, ' ');
        if f.len() >= 4 and f[0] == id and f[1] == key {
            return f;
        }
    }
    Vec.new()
}

fn loc_list(id: Str, key: Str) -> Vec[Vec[i64]] {
    let f = loc_field(id, key);
    hex_list(f[3])
}

fn loc_dict(id: Str, key: Str) -> Dict {
    let f = loc_field(id, key);
    hex_dict(f[3])
}

fn load_loc(p: ref Pats, id: Str) -> Loc {
    let mut unit_keys: Vec[String] = Vec.new();
    let mut unit_vals: Vec[Vec[Vec[i64]]] = Vec.new();
    let mut src_keys: Vec[Vec[i64]] = Vec.new();
    let mut src_vals: Vec[Vec[i64]] = Vec.new();
    for line in split_on(locale_text(), '\n') {
        let f = split_on(line, ' ');
        if f.len() < 4 or f[0] != id {
            continue;
        }
        if f[1].starts_with("units.") {
            unit_keys.push(f[1].substring(6, f[1].len()));
            unit_vals.push(hex_list(f[3]));
        } else if f[1] == "re_sources" {
            for item in split_on(f[3], ',') {
                let kv = split_on(item, ':');
                src_keys.push(hex_text(kv[0]));
                src_vals.push(vec![int_of(kv[1]), int_of(kv[2]), int_of(kv[3])]);
            }
        }
    }
    let um = loc_field(id, "usesMeridian");
    Loc {
        id: id.to_string(),
        months: loc_list(id, "Months"),
        short_months: loc_list(id, "shortMonths"),
        weekdays: loc_list(id, "Weekdays"),
        dp_order: loc_list(id, "dp_order"),
        meridian: loc_list(id, "meridian"),
        am: loc_list(id, "am"),
        pm: loc_list(id, "pm"),
        now: loc_list(id, "now"),
        ignore: loc_list(id, "ignore"),
        uses_meridian: um[3] == "1",
        numbers: loc_dict(id, "numbers"),
        small: loc_dict(id, "small"),
        magnitude: loc_dict(id, "magnitude"),
        modifiers: loc_dict(id, "Modifiers"),
        day_offsets: loc_dict(id, "dayOffsets"),
        weekday_offsets: loc_dict(id, "WeekdayOffsets"),
        month_offsets: loc_dict(id, "MonthOffsets"),
        unit_keys: unit_keys,
        unit_vals: unit_vals,
        src_keys: src_keys,
        src_vals: src_vals,
        rx: load_rx(p, id),
    }
}

fn load_world() -> World {
    let p = load_pats();
    let locs = vec![load_loc(p, "en_US"), load_loc(p, "en_AU")];
    let m = Mod {
        parse0: pat(p, "parse.0".to_string()),
        parse1: pat(p, "parse.1".to_string()),
        parse2: pat(p, "parse.2".to_string()),
        nlp0: pat(p, "nlp.0".to_string()),
        nlp1: pat(p, "nlp.1".to_string()),
        nlp2: pat(p, "nlp.2".to_string()),
        range_sep: pat(p, "evalRanges.0".to_string()),
        am0: pat(p, "evalRanges.1".to_string()),
        split_words: pat(p, "_convertUnitAsWords.0".to_string()),
    };
    World { u: load_uni(), locs: locs, m: m }
}

// ------------------------------------------------------------ time and datetime

// A time.struct_time, or the 9-tuple the library builds in its place.
#[derive(Clone)]
struct TimeTup {
    yr: i64,
    mth: i64,
    dy: i64,
    hr: i64,
    mn: i64,
    sec: i64,
    wd: i64,
    yd: i64,
    dst: i64,
}

fn tt(yr: i64, mth: i64, dy: i64, hr: i64, mn: i64, sec: i64, wd: i64, yd: i64, dst: i64) -> TimeTup {
    TimeTup { yr: yr, mth: mth, dy: dy, hr: hr, mn: mn, sec: sec, wd: wd, yd: yd, dst: dst }
}

fn tt_repr(t: ref TimeTup) -> String {
    f"({t.yr}, {t.mth}, {t.dy}, {t.hr}, {t.mn}, {t.sec}, {t.wd}, {t.yd}, {t.dst})"
}

const US_SEC: i64 = 1000000;
const US_DAY: i64 = 86400000000;
const MAX_ORD: i64 = 3652059;

fn is_leap(y: i64) -> bool {
    y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)
}

fn days_in(y: i64, m: i64) -> i64 {
    let dim = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    if m == 2 and is_leap(y) { 29 } else { dim[m - 1] }
}

fn days_before_year(y: i64) -> i64 {
    let n = y - 1;
    n * 365 + n / 4 - n / 100 + n / 400
}

fn days_before_month(y: i64, m: i64) -> i64 {
    let mut d = 0;
    let mut k = 1;
    while k < m {
        d += days_in(y, k);
        k += 1;
    }
    d
}

// 0001-01-01 is ordinal 1.
fn ymd_to_ord(y: i64, m: i64, d: i64) -> i64 {
    days_before_year(y) + days_before_month(y, m) + d
}

fn ord_to_ymd(n: i64) -> (i64, i64, i64) {
    let mut y = (n - 1) / 366 + 1;
    while days_before_year(y + 1) < n {
        y += 1;
    }
    let mut rest = n - days_before_year(y);
    let mut m = 1;
    while rest > days_in(y, m) {
        rest -= days_in(y, m);
        m += 1;
    }
    (y, m, rest)
}

// datetime.datetime(y, m, d, H, M, S), with its checks in its order.
fn dt_new(y: i64, m: i64, d: i64, hh: i64, mm: i64, ss: i64) -> Result[i64, Exc] {
    if y < 1 or y > 9999 {
        return Err(exc("ValueError", f"year {y} is out of range"));
    }
    if m < 1 or m > 12 {
        return Err(exc("ValueError", "month must be in 1..12".to_string()));
    }
    if d < 1 or d > days_in(y, m) {
        return Err(exc("ValueError", "day is out of range for month".to_string()));
    }
    if hh < 0 or hh > 23 {
        return Err(exc("ValueError", "hour must be in 0..23".to_string()));
    }
    if mm < 0 or mm > 59 {
        return Err(exc("ValueError", "minute must be in 0..59".to_string()));
    }
    if ss < 0 or ss > 59 {
        return Err(exc("ValueError", "second must be in 0..59".to_string()));
    }
    Ok((ymd_to_ord(y, m, d) - 1) * US_DAY + ((hh * 60 + mm) * 60 + ss) * US_SEC)
}

fn overflow() -> Exc {
    exc("OverflowError", "date value out of range".to_string())
}

// datetime + timedelta
fn dt_add(us: i64, delta: i64) -> Result[i64, Exc] {
    let r = us + delta;
    if r < 0 or r >= MAX_ORD * US_DAY {
        return Err(overflow());
    }
    Ok(r)
}

// [year, month, day, hour, minute, second, microsecond, ordinal]
fn dt_fields(us: i64) -> Vec[i64] {
    let days = us / US_DAY;
    let rest = us % US_DAY;
    let (y, m, d) = ord_to_ymd(days + 1);
    let secs = rest / US_SEC;
    vec![y, m, d, secs / 3600, (secs / 60) % 60, secs % 60, rest % US_SEC, days + 1]
}

// datetime.timetuple()
fn timetuple(us: i64) -> TimeTup {
    let f = dt_fields(us);
    tt(f[0], f[1], f[2], f[3], f[4], f[5], (f[7] + 6) % 7, days_before_month(f[0], f[1]) + f[2], -1)
}

// datetime.replace(year=, month=, day=), keeping the time of day.
fn dt_replace(us: i64, y: i64, m: i64, d: i64) -> Result[i64, Exc] {
    let f = dt_fields(us);
    let base = dt_new(y, m, d, f[3], f[4], f[5])?;
    Ok(base + f[6])
}

fn dt_repr(us: i64) -> String {
    let f = dt_fields(us);
    let mut s = f"datetime.datetime({f[0]}, {f[1]}, {f[2]}, {f[3]}, {f[4]}";
    if f[6] != 0 {
        s.push_str(f", {f[5]}, {f[6]}");
    } else if f[5] != 0 {
        s.push_str(f", {f[5]}");
    }
    s.push_str(")");
    s
}

fn pad(n: i64, w: i64) -> String {
    let mut s = f"{n}";
    while s.len() < w {
        s = f"0{s}";
    }
    s
}

// datetime.isoformat(" ")
fn dt_iso(us: i64) -> String {
    let f = dt_fields(us);
    let mut s = f"{pad(f[0], 4)}-{pad(f[1], 2)}-{pad(f[2], 2)} {pad(f[3], 2)}:{pad(f[4], 2)}:{pad(f[5], 2)}";
    if f[6] != 0 {
        s.push_str(f".{pad(f[6], 6)}");
    }
    s
}

// timedelta(<unit>=q) for one float argument, in microseconds, as
// delta_new() rounds it: the whole part times the unit, then the
// fraction's whole microseconds, then what is left rounded half to even.
fn td_float(q: f64, unit: i64) -> Result[i64, Exc] {
    let mag = if q < 0.0 { -q } else { q };
    if q != q or mag * (unit as f64) / (US_DAY as f64) > 999999999.0 {
        return Err(overflow());
    }
    let ip = q.trunc();
    let fp = q - ip;
    let mut sum = (ip as i64) * unit;
    let mut left = 0.0;
    if fp != 0.0 {
        let dn = (unit as f64) * fp;
        let ip2 = dn.trunc();
        sum += ip2 as i64;
        left += dn - ip2;
    }
    if left != 0.0 {
        let mut whole = left.round();
        let diff = whole - left;
        if diff == 0.5 or diff == -0.5 {
            let odd = if sum % 2 != 0 { 1.0 } else { 0.0 };
            whole = 2.0 * ((left + odd) * 0.5).round() - odd;
        }
        sum += whole as i64;
    }
    Ok(sum)
}

fn td_days(n: i64) -> i64 {
    n * US_DAY
}

// time.mktime() in UTC: seconds since 1970 for the tuple's first six
// fields.
fn mktime(t: ref TimeTup) -> f64 {
    let m0 = t.mth - 1;
    let y = t.yr + (if m0 >= 0 { m0 / 12 } else { (m0 - 11) / 12 });
    let m = m0 - (y - t.yr) * 12 + 1;
    let days = ymd_to_ord(y, m, 1) + t.dy - 1 - 719163;
    (days * 86400 + t.hr * 3600 + t.mn * 60 + t.sec) as f64
}

// ------------------------------------------------------------ pdtContext

const ACU_YEAR: i64 = 1;
const ACU_MONTH: i64 = 2;
const ACU_WEEK: i64 = 4;
const ACU_DAY: i64 = 8;
const ACU_HALFDAY: i64 = 16;
const ACU_HOUR: i64 = 32;
const ACU_MIN: i64 = 64;
const ACU_SEC: i64 = 128;
const ACU_NOW: i64 = 256;
const ACU_DATE: i64 = 15;
const ACU_TIME: i64 = 496;

// _ACCURACY_REVERSE_MAPPING for a unit name
fn acc_of(name: ref String) -> i64 {
    if name == "years" {
        ACU_YEAR
    } else if name == "months" {
        ACU_MONTH
    } else if name == "weeks" {
        ACU_WEEK
    } else if name == "days" {
        ACU_DAY
    } else if name == "hours" {
        ACU_HOUR
    } else if name == "minutes" {
        ACU_MIN
    } else {
        ACU_SEC
    }
}

fn ctx_repr(acc: i64) -> String {
    let names = ["YEAR", "MONTH", "WEEK", "DAY", "HALFDAY", "HOUR", "MIN", "SEC", "NOW"];
    let mut parts: Vec[String] = Vec.new();
    let mut k = 0;
    let mut bit = 1;
    while k < 9 {
        if (acc & bit) != 0 {
            parts.push(f"pdtContext.ACU_{names[k]}");
        }
        bit = bit * 2;
        k += 1;
    }
    if parts.len() == 0 {
        return "pdtContext()".to_string();
    }
    let mut s = "pdtContext(accuracy=".to_string();
    let mut j = 0;
    while j < parts.len() {
        if j > 0 {
            s.push_str(" | ");
        }
        s.push_str(parts[j]);
        j += 1;
    }
    s.push_str(")");
    s
}

// dateTimeFlag
fn dt_flag(acc: i64) -> i64 {
    (if (acc & ACU_DATE) != 0 { 1 } else { 0 }) + (if (acc & ACU_TIME) != 0 { 2 } else { 0 })
}

// ------------------------------------------------------------ Calendar

const VERSION_FLAG_STYLE: i64 = 1;
const VERSION_CONTEXT_STYLE: i64 = 2;

// The Constants settings a program may change.
struct Ptc {
    loc: i64,
    start_from_source: bool,
    start_hour: i64,
    year_parse_style: i64,
    dow_parse_style: i64,
    current_dow_parse_style: i64,
    birthday_epoch: i64,
}

struct Cal {
    ptc: Ptc,
    version: i64,
    // the pdtContext stack, each entry its accuracy
    stack: Vec[i64],
    // what time.localtime() returns
    clock: TimeTup,
}

// A partial parser's (remaining text, time, matched).
struct PRes {
    s: Vec[i64],
    t: TimeTup,
    ok: bool,
}

fn pr(s: own Vec[i64], t: own TimeTup, ok: bool) -> PRes {
    PRes { s: s, t: t, ok: ok }
}

impl Cal {
    fn push_ctx(mut ref self) {
        self.stack.push(0);
    }

    // Leaving `with self.context()`: the context's accuracy, which is
    // also added to the one around it.
    fn pop_ctx(mut ref self) -> i64 {
        let acc = match self.stack.pop() {
            Some(a) => a,
            None => 0,
        };
        let n = self.stack.len();
        if n > 0 {
            self.stack[n - 1] = self.stack[n - 1] | acc;
        }
        acc
    }

    fn acc(mut ref self, flag: i64) {
        let n = self.stack.len();
        if n > 0 {
            self.stack[n - 1] = self.stack[n - 1] | flag;
        }
    }

    fn cur(ref self) -> i64 {
        let n = self.stack.len();
        if n > 0 { self.stack[n - 1] } else { 0 }
    }

    fn start_time(ref self, src: ref TimeTup) -> (i64, i64, i64) {
        if self.ptc.start_from_source { (src.hr, src.mn, src.sec) } else { (self.ptc.start_hour, 0, 0) }
    }
}

fn loc(w: ref World, c: ref Cal) -> ref Loc {
    ref w.locs[c.ptc.loc]
}

// Constants.daysInMonth(month, year): None (-1) outside 1..12.
fn days_in_month(m: i64, y: i64) -> i64 {
    if m > 0 and m <= 12 { days_in(y, m) } else { -1 }
}

// Constants.getSource(sourceKey, sourceTime)
fn get_source(w: ref World, c: ref Cal, key: ref Vec[i64], t: ref TimeTup) -> Option[TimeTup] {
    let l = ref w.locs[c.ptc.loc];
    let mut k = 0;
    while k < l.src_keys.len() {
        if same(l.src_keys[k], key) {
            let v = ref l.src_vals[k];
            return Some(tt(t.yr, t.mth, t.dy, v[0], v[1], v[2], t.wd, t.yd, t.dst));
        }
        k += 1;
    }
    None
}

// _convertUnitAsWords(unitText)
fn convert_unit_as_words(w: ref World, c: ref Cal, text: ref Vec[i64]) -> Result[i64, Exc] {
    let l = ref w.locs[c.ptc.loc];
    let mut a = 0;
    let mut b = 0;
    for word in w.m.split_words.split(w.u, text).iter() {
        match l.small.get(word) {
            Some(x) => {
                a += x;
            }
            None => {
                if is(word, "hundred") {
                    a *= 100;
                } else {
                    match l.magnitude.get(word) {
                        Some(x) => {
                            if x < 0 {
                                return Err(exc("OverflowError", "magnitude past 10**18 is out of scope".to_string()));
                            }
                            b += a * x;
                            a = 0;
                        }
                        None => {
                            if not in_list(l.ignore, word) {
                                return Err(exc("Exception", f"Unknown number: {cps_str(word)}"));
                            }
                        }
                    }
                }
            }
        }
    }
    Ok(a + b)
}

// _quantityToReal(quantity)
fn quantity_to_real(w: ref World, c: ref Cal, q: ref Vec[i64]) -> f64 {
    if q.len() == 0 {
        return 1.0;
    }
    match py_float(w.u, replace_all(q, lit(","), lit("."))) {
        Some(v) => {
            return v;
        }
        None => {}
    }
    match loc(w, c).numbers.get(q) {
        Some(n) => n as f64,
        None => 0.0,
    }
}

// _CalculateDOWDelta(wd, wkdy, offset, style, currentDayStyle)
fn calculate_dow_delta(wd: i64, wkdy: i64, offset0: i64, style: i64, current: i64) -> i64 {
    let diff_base = wkdy - wd;
    let mut offset = offset0;
    if offset == 2 {
        if wkdy * style > wd * style or (current != 0 and wkdy == wd) {
            offset = 0;
        } else if style == -1 or style == 1 {
            offset = style;
        } else {
            offset = 0;
        }
    }
    let mut diff = diff_base + 7 * offset;
    if style == 1 and diff < -7 {
        diff += 7;
    } else if style == -1 and diff > 7 {
        diff -= 7;
    }
    diff
}

// Calendar.inc(source, month=None, year=None): month and year as floats
// (None, or a value float() refuses, is 0).
fn inc(w: ref World, c: ref Cal, source: i64, month: Option[f64], year: Option[f64]) -> Result[i64, Exc] {
    let f = dt_fields(source);
    let mut yr = f[0];
    let mut mth = f[1];
    let mut dy = f[2];
    let mut mo = match month {
        Some(v) => v,
        None => 0.0,
    };
    let ye = match year {
        Some(v) => v,
        None => 0.0,
    };
    mo += ye * 12.0;
    let mut sub_mi = 0.0;
    let mut max_day = 0;
    if mo != 0.0 {
        let mi = mo.trunc() as i64;
        sub_mi = mo - (mi as f64);
        let mut y = ((mi as f64) / 12.0).trunc() as i64;
        let m = mi - y * 12;
        mth = mth + m;
        if mth < 1 {
            y -= 1;
            mth += 12;
        } else if mth > 12 {
            y += 1;
            mth -= 12;
        }
        yr += y;
        max_day = days_in_month(mth, yr);
        if dy > max_day {
            dy = max_day;
        }
    }
    if yr > 9999 or yr < 1 {
        return Err(exc("OverflowError", "year is out of range".to_string()));
    }
    let mut d = dt_replace(source, yr, mth, dy)?;
    if sub_mi != 0.0 {
        d = dt_add(d, td_float(sub_mi * (max_day as f64), US_DAY)?)?;
    }
    let _ = w;
    let _ = c;
    Ok(d)
}

// _buildTime(source, quantity, modifier, units)
fn build_time(w: ref World, c: mut ref Cal, source: ref TimeTup, quantity: Option[Vec[i64]], modifier: ref Vec[i64], units0: ref Vec[i64]) -> Result[TimeTup, Exc] {
    let quantity = match quantity {
        Some(q) => strip(w.u, q),
        None => Vec.new(),
    };
    let mut qty = quantity_to_real(w, c, quantity);
    let mut units = units0.clone();
    match loc(w, c).modifiers.get(modifier) {
        Some(m) => {
            qty = qty * (m as f64);
            if units.len() == 0 {
                units = lit("dy");
            }
        }
        None => {}
    }
    let start = dt_new(source.yr, source.mth, source.dy, source.hr, source.mn, source.sec)?;
    let l = ref w.locs[c.ptc.loc];
    let mut realunit = cps_str(units);
    let mut k = 0;
    while k < l.unit_keys.len() {
        if in_list(l.unit_vals[k], units) {
            realunit = l.unit_keys[k].clone();
            break;
        }
        k += 1;
    }
    let mut target = start;
    let mut res: Result[i64, Exc] = Ok(start);
    if realunit == "years" {
        res = inc(w, c, start, None, Some(qty));
    } else if realunit == "months" {
        res = inc(w, c, start, Some(qty), None);
    } else if realunit == "days" or realunit == "hours" or realunit == "minutes" or realunit == "seconds" or realunit == "weeks" {
        let unit = if realunit == "days" {
            US_DAY
        } else if realunit == "hours" {
            3600 * US_SEC
        } else if realunit == "minutes" {
            60 * US_SEC
        } else if realunit == "seconds" {
            US_SEC
        } else {
            7 * US_DAY
        };
        res = match td_float(qty, unit) {
            Ok(d) => dt_add(start, d),
            Err(e) => Err(e),
        };
    }
    match res {
        Ok(t) => {
            target = t;
            c.acc(acc_of(realunit));
        }
        Err(e) => {
            // OverflowError is raised when target.year is past 9999
            if e.cls != "OverflowError" {
                return Err(e);
            }
        }
    }
    Ok(timetuple(target))
}

// parseDate(dateString, sourceTime)
fn parse_date(w: ref World, c: mut ref Cal, date_string: ref Vec[i64], source: Option[TimeTup]) -> Result[TimeTup, Exc] {
    let st = match source {
        Some(t) => t.clone(),
        None => c.clock.clone(),
    };
    let mut v1 = -1;
    let mut v2 = -1;
    let mut v3 = -1;
    let mut accuracy: Vec[i64] = Vec.new();
    let mut s = date_string.clone();
    let l = ref w.locs[c.ptc.loc];
    let rx = ref l.rx;
    match rx.date2.search(w.u, s) {
        Some(m) => {
            let index = m.caps[0];
            v1 = py_int(w.u, sub(s, 0, index))?;
            s = sub(s, index + 1, s.len());
        }
        None => {}
    }
    match rx.date2.search(w.u, s) {
        Some(m) => {
            let index = m.caps[0];
            v2 = py_int(w.u, sub(s, 0, index))?;
            v3 = py_int(w.u, sub(s, index + 1, s.len()))?;
        }
        None => {
            v2 = py_int(w.u, strip(w.u, s))?;
        }
    }
    let v = [v1, v2, v3];
    // d['m'], d['d'], d['y']
    let mut dm = st.mth;
    let mut dd = st.dy;
    let mut dyr = st.yr;
    let order: Vec[Vec[i64]] = if v1 <= 31 { loc(w, c).dp_order.clone() } else { vec![lit("y"), lit("m"), lit("d")] };
    let mut i = 0;
    while i < 3 {
        let n = v[i];
        let key = order[i][0];
        if n >= 0 {
            if key == 109 {
                dm = n;
                accuracy.push(ACU_MONTH);
            } else if key == 100 {
                dd = n;
                accuracy.push(ACU_DAY);
            } else {
                dyr = n;
                accuracy.push(ACU_YEAR);
            }
        }
        i += 1;
    }
    let mut yr = if v3 == -1 and ((st.mth > dm) or (st.mth == dm and st.dy > dd)) {
        dyr + c.ptc.year_parse_style
    } else {
        dyr
    };
    let mth = dm;
    let dy = dd;
    if yr < c.ptc.birthday_epoch {
        yr += 2000;
    } else if yr < 100 {
        yr += 1900;
    }
    let dim = days_in_month(mth, yr);
    c.push_ctx();
    let result = if mth > 0 and mth <= 12 and dy > 0 and dy <= dim {
        for a in accuracy.iter() {
            c.acc(*a);
        }
        tt(yr, mth, dy, st.hr, st.mn, st.sec, st.wd, st.yd, st.dst)
    } else {
        // return current time if date string is invalid
        c.clock.clone()
    };
    c.pop_ctx();
    Ok(result)
}

// parseDateText(dateString, sourceTime)
fn parse_date_text(w: ref World, c: mut ref Cal, date_string: ref Vec[i64], source: Option[TimeTup]) -> Result[TimeTup, Exc] {
    let st = match source {
        Some(t) => t.clone(),
        None => c.clock.clone(),
    };
    let current_mth = st.mth;
    let current_dy = st.dy;
    let mut yr = st.yr;
    let mut dy = st.dy;
    let mut accuracy: Vec[i64] = Vec.new();
    let s = lower(date_string);
    let l = ref w.locs[c.ptc.loc];
    let rx = ref l.rx.date3;
    let m = match rx.search(w.u, s) {
        Some(m) => m,
        None => {
            return Err(exc("AttributeError", "'NoneType' object has no attribute 'group'".to_string()));
        }
    };
    let name = match m_group(rx, m, s, "mthname") {
        Some(g) => g,
        None => Vec.new(),
    };
    let mth = match loc(w, c).month_offsets.get(name) {
        Some(n) => n,
        None => {
            return Err(exc("KeyError", str_repr(name)));
        }
    };
    accuracy.push(ACU_MONTH);
    match m_group(rx, m, s, "day") {
        Some(g) => {
            dy = py_int(w.u, g)?;
            accuracy.push(ACU_DAY);
        }
        None => {
            dy = 1;
        }
    }
    match m_group(rx, m, s, "year") {
        Some(g) => {
            yr = py_int(w.u, g)?;
            accuracy.push(ACU_YEAR);
            if yr < c.ptc.birthday_epoch {
                yr += 2000;
            } else if yr < 100 {
                yr += 1900;
            }
        }
        None => {
            if (mth < current_mth) or (mth == current_mth and dy < current_dy) {
                // if that day and month have already passed in this year,
                // then increment the year by 1
                yr += c.ptc.year_parse_style;
            }
        }
    }
    c.push_ctx();
    let result = if dy > 0 and dy <= days_in_month(mth, yr) {
        for a in accuracy.iter() {
            c.acc(*a);
        }
        tt(yr, mth, dy, st.hr, st.mn, st.sec, st.wd, st.yd, st.dst)
    } else {
        c.clock.clone()
    };
    c.pop_ctx();
    Ok(result)
}

// evalRanges(datetimeString, sourceTime): start, end and the flag.
fn eval_ranges(w: ref World, c: mut ref Cal, text: ref Vec[i64], source0: Option[TimeTup]) -> Result[(TimeTup, TimeTup, i64), Exc] {
    let u = ref w.u;
    let l = ref w.locs[c.ptc.loc];
    let mut range_flag = 0;
    let mut ret_flag = 0;
    let mut start_str: Vec[i64] = Vec.new();
    let mut end_str: Vec[i64] = Vec.new();
    let mut source = source0.clone();
    let mut s = lower(strip(u, text));
    if has(s, 45) {
        s = replace_all(s, lit("-"), lit(" - "));
        s = replace_all(s, lit("  "), lit(" "));
    }
    let mut parse_str: Vec[i64] = Vec.new();
    let mut found: Option[Match] = None;
    let order = [1, 2, 7, 3, 4, 5, 6];
    for flag in order {
        let rx = if flag == 1 {
            ref l.rx.timerng1
        } else if flag == 2 {
            ref l.rx.timerng2
        } else if flag == 7 {
            ref l.rx.timerng4
        } else if flag == 3 {
            ref l.rx.timerng3
        } else if flag == 4 {
            ref l.rx.daterng1
        } else if flag == 5 {
            ref l.rx.daterng2
        } else {
            ref l.rx.daterng3
        };
        match rx.search(u, s) {
            Some(m) => {
                range_flag = flag;
                found = Some(m);
                break;
            }
            None => {}
        }
    }
    match found {
        Some(m) => {
            let whole = m_text(m, s);
            if not same(whole, s) {
                // capture remaining string
                parse_str = whole;
                let chunk1 = sub(s, 0, m.caps[0]);
                let chunk2 = sub(s, m.caps[1], s.len());
                s = spaced(chunk1, chunk2);
                let (t, acc) = parse(w, mut c, s, source.clone(), VERSION_CONTEXT_STYLE)?;
                source = if acc == 0 { None } else { Some(t) };
            } else {
                parse_str = s.clone();
            }
        }
        None => {}
    }
    let sep_at = |ps: ref Vec[i64]| {
        match w.m.range_sep.search(u, ps) {
            Some(m) => m.caps[0],
            None => -1,
        }
    };
    let none_group = exc("AttributeError", "'NoneType' object has no attribute 'start'".to_string());
    if range_flag == 1 or range_flag == 2 or range_flag == 4 {
        let at = sep_at(parse_str);
        if at < 0 {
            return Err(none_group);
        }
        start_str = sub(parse_str, 0, at);
        end_str = sub(parse_str, at + 1, parse_str.len());
        ret_flag = if range_flag == 4 { 1 } else { 2 };
    } else if range_flag == 3 or range_flag == 7 {
        let at = sep_at(parse_str);
        if at < 0 {
            return Err(none_group);
        }
        // capturing the meridian from the end time
        if l.uses_meridian {
            let ampm = w.m.am0.search(u, parse_str);
            // appending the meridian to the start time
            start_str = cat(sub(parse_str, 0, at), if ampm.is_some() { l.meridian[0].clone() } else { l.meridian[1].clone() });
        } else {
            start_str = sub(parse_str, 0, at);
        }
        end_str = sub(parse_str, at + 1, parse_str.len());
        ret_flag = 2;
    } else if range_flag == 5 {
        let at = sep_at(parse_str);
        if at < 0 {
            return Err(none_group);
        }
        end_str = sub(parse_str, at + 1, parse_str.len());
        // capturing the year from the end date
        let rx = ref l.rx.date3;
        let end_year = match rx.search(u, end_str) {
            Some(d) => m_group(rx, d, end_str, "year"),
            None => {
                return Err(exc("AttributeError", "'NoneType' object has no attribute 'group'".to_string()));
            }
        };
        match end_year {
            Some(ey) => {
                // appending the year to the start date if the start date
                // does not have year information and the end date does.
                start_str = strip(u, sub(parse_str, 0, at));
                let start_year = match rx.search(u, start_str) {
                    Some(d) => m_group(rx, d, start_str, "year"),
                    None => {
                        return Err(exc("AttributeError", "'NoneType' object has no attribute 'group'".to_string()));
                    }
                };
                if start_year.is_none() {
                    start_str = cat(cat(start_str, lit(", ")), ey);
                }
            }
            None => {
                start_str = sub(parse_str, 0, at);
            }
        }
        ret_flag = 1;
    } else if range_flag == 6 {
        let at = sep_at(parse_str);
        if at < 0 {
            return Err(none_group);
        }
        start_str = sub(parse_str, 0, at);
        // capturing the month from the start date
        let rx = ref l.rx.date3;
        let mth = match rx.search(u, start_str) {
            Some(d) => m_group(rx, d, start_str, "mthname"),
            None => {
                return Err(exc("AttributeError", "'NoneType' object has no attribute 'group'".to_string()));
            }
        };
        let mth = match mth {
            Some(x) => x,
            None => {
                return Err(exc("TypeError", "unsupported operand type(s) for +: 'NoneType' and 'str'".to_string()));
            }
        };
        // appending the month name to the end date
        end_str = cat(mth, sub(parse_str, at + 1, parse_str.len()));
        ret_flag = 1;
    }
    if ret_flag == 0 {
        // if range is not found
        return Ok((c.clock.clone(), c.clock.clone(), 0));
    }
    let (start_dt, sacc) = parse(w, mut c, start_str, source.clone(), VERSION_CONTEXT_STYLE)?;
    let (end_dt, eacc) = parse(w, mut c, end_str, source.clone(), VERSION_CONTEXT_STYLE)?;
    if sacc == 0 or eacc == 0 {
        ret_flag = 0;
    }
    Ok((start_dt, end_dt, ret_flag))
}

// _evalModifier(modifier, chunk1, chunk2, sourceTime)
fn eval_modifier(w: ref World, c: mut ref Cal, modifier: ref Vec[i64], chunk1_0: ref Vec[i64], chunk2_0: ref Vec[i64], source: ref TimeTup) -> Result[(Vec[i64], TimeTup), Exc] {
    let u = ref w.u;
    let l = ref w.locs[c.ptc.loc];
    let offset = match l.modifiers.get(modifier) {
        Some(o) => o,
        None => {
            return Err(exc("KeyError", str_repr(modifier)));
        }
    };
    let mut chunk1 = chunk1_0.clone();
    let mut chunk2 = chunk2_0.clone();
    let mut st = source.clone();
    let (yr, mth, dy, hr, mn, sec, wd, yd, dst) = (st.yr, st.mth, st.dy, st.hr, st.mn, st.sec, st.wd, st.yd, st.dst);
    let (sh, sm, ss) = c.start_time(st);
    // capture the units after the modifier and the remaining string
    // after the unit
    let mut unit: Vec[i64] = Vec.new();
    match l.rx.remaining.search(u, chunk2) {
        Some(m) => {
            let index = m.caps[0] + 1;
            unit = sub(chunk2, 0, m.caps[0]);
            chunk2 = sub(chunk2, index, chunk2.len());
        }
        None => {
            unit = chunk2.clone();
            chunk2 = Vec.new();
        }
    }
    let in_units = |name: Str| {
        let mut k = 0;
        while k < l.unit_keys.len() {
            if l.unit_keys[k] == name {
                return in_list(l.unit_vals[k], unit);
            }
            k += 1;
        }
        false
    };
    if in_units("months") {
        let cdim = days_in_month(mth, yr);
        if offset == 0 {
            st = tt(yr, mth, cdim, sh, sm, ss, wd, yd, dst);
        } else if offset == 2 {
            // if day is the last day of the month, calculate the last
            // day of the next month
            let mut d2 = dy;
            if dy == cdim {
                d2 = days_in_month(mth + 1, yr);
                if d2 < 0 {
                    return Err(exc("TypeError", "'NoneType' object cannot be interpreted as an integer".to_string()));
                }
            }
            let start = dt_new(yr, mth, d2, sh, sm, ss)?;
            st = timetuple(inc(w, c, start, Some(1.0), None)?);
        } else {
            let start = dt_new(yr, mth, 1, sh, sm, ss)?;
            st = timetuple(inc(w, c, start, Some(offset as f64), None)?);
        }
        c.acc(ACU_MONTH);
    } else if in_units("weeks") {
        if offset == 0 {
            let start = dt_new(yr, mth, dy, 17, 0, 0)?;
            st = timetuple(dt_add(start, td_days(4 - wd))?);
        } else if offset == 2 {
            let start = dt_new(yr, mth, dy, sh, sm, ss)?;
            st = timetuple(dt_add(start, td_days(7))?);
        } else {
            let start = dt_new(yr, mth, dy, sh, sm, ss)?;
            st = timetuple(dt_add(start, td_days(7 * offset))?);
        }
        c.acc(ACU_WEEK);
    } else if in_units("days") {
        if offset == 0 {
            st = tt(yr, mth, dy, 17, 0, 0, wd, yd, dst);
            c.acc(ACU_HALFDAY);
        } else if offset == 2 {
            let start = dt_new(yr, mth, dy, hr, mn, sec)?;
            st = timetuple(dt_add(start, td_days(1))?);
        } else {
            let start = dt_new(yr, mth, dy, sh, sm, ss)?;
            st = timetuple(dt_add(start, td_days(offset))?);
        }
        c.acc(ACU_DAY);
    } else if in_units("hours") {
        if offset == 0 {
            st = tt(yr, mth, dy, hr, 0, 0, wd, yd, dst);
        } else {
            let start = dt_new(yr, mth, dy, hr, 0, 0)?;
            st = timetuple(dt_add(start, offset * 3600 * US_SEC)?);
        }
        c.acc(ACU_HOUR);
    } else if in_units("years") {
        if offset == 0 {
            st = tt(yr, 12, 31, hr, mn, sec, wd, yd, dst);
        } else if offset == 2 {
            st = tt(yr + 1, mth, dy, hr, mn, sec, wd, yd, dst);
        } else {
            st = tt(yr + offset, 1, 1, sh, sm, ss, wd, yd, dst);
        }
        c.acc(ACU_YEAR);
    } else if is(modifier, "eom") {
        st = tt(yr, mth, days_in_month(mth, yr), sh, sm, ss, wd, yd, dst);
        c.acc(ACU_DAY);
    } else if is(modifier, "eoy") {
        st = tt(yr, 12, days_in_month(12, yr), sh, sm, ss, wd, yd, dst);
        c.acc(ACU_MONTH);
    } else if l.rx.weekday.match_at(u, unit, 0).is_some() {
        let wm = l.rx.weekday.match_at(u, unit, 0).unwrap();
        let wkdy_text = m_text(wm, unit);
        if is(modifier, "eod") {
            c.acc(ACU_HOUR);
            // Calculate the upcoming weekday
            let (t, _) = parse(w, mut c, wkdy_text, Some(st.clone()), VERSION_CONTEXT_STYLE)?;
            st = t;
            match get_source(w, c, modifier, st) {
                Some(s2) => {
                    st = s2;
                    c.acc(ACU_HALFDAY);
                }
                None => {}
            }
        } else {
            // unless one of these modifiers is being applied to the
            // day-of-week, we want to start with target as the day in
            // the current week.
            let mut dow_offset = offset;
            let relative = not (is(modifier, "this") or is(modifier, "next") or is(modifier, "last")
                or is(modifier, "prior") or is(modifier, "previous"));
            if relative {
                dow_offset = 0;
            }
            let wkdy = match l.weekday_offsets.get(wkdy_text) {
                Some(n) => n,
                None => {
                    return Err(exc("KeyError", str_repr(wkdy_text)));
                }
            };
            let diff = calculate_dow_delta(wd, wkdy, dow_offset, c.ptc.dow_parse_style, c.ptc.current_dow_parse_style);
            let start = dt_new(yr, mth, dy, sh, sm, ss)?;
            let mut target = dt_add(start, td_days(diff))?;
            if chunk1.len() > 0 and relative {
                // consider "one day before thursday": we need to parse
                // chunk1 ("one day") and apply according to the offset
                // ("before"), rather than allowing the remaining parse
                // step to apply "one day" without the offset direction.
                let (t, sub_acc) = parse(w, mut c, chunk1, Some(st.clone()), VERSION_CONTEXT_STYLE)?;
                if sub_acc != 0 {
                    let delta = mktime(t) - mktime(st);
                    target = dt_add(dt_add(start, td_days(diff))?, td_float(delta * (offset as f64), US_SEC)?)?;
                    chunk1 = Vec.new();
                }
            }
            st = timetuple(target);
        }
        c.acc(ACU_DAY);
    } else if chunk1.len() == 0 and chunk2.len() == 0 and l.rx.time.match_at(u, unit, 0).is_some() {
        let (t, _) = parse(w, mut c, unit, None, VERSION_CONTEXT_STYLE)?;
        let start = dt_new(t.yr, t.mth, t.dy, t.hr, t.mn, t.sec)?;
        st = timetuple(dt_add(start, td_days(offset))?);
    } else {
        // check if the remaining text is parsable and if so, use it as
        // the base time for the modifier source time
        unit = strip(u, unit);
        if unit.len() > 0 {
            let s = spaced(unit, chunk2);
            let mut (t, sub_acc) = parse(w, mut c, s, Some(st.clone()), VERSION_CONTEXT_STYLE)?;
            if (sub_acc & ACU_DATE) != 0 {
                let lu = lower(unit);
                if in_list(l.months, lu) or in_list(l.short_months, lu) {
                    let start = dt_new(t.yr, t.mth, t.dy, t.hr, t.mn, t.sec)?;
                    t = timetuple(inc(w, c, start, None, Some(offset as f64))?);
                } else if in_list(l.weekdays, lu) {
                    return Err(exc("TypeError", "unsupported operand type(s) for +: 'time.struct_time' and 'datetime.timedelta'".to_string()));
                }
            }
            if sub_acc != 0 {
                st = t;
                chunk2 = Vec.new();
            }
        }
        chunk1 = strip(u, chunk1);
        // if the word after next is a number, the string is more than
        // likely to be "next 4 hrs" which we will have to combine the
        // units with the rest of the string
        if chunk1.len() > 0 {
            let found = l.rx.number.find_all(u, chunk1);
            if found.len() > 0 {
                let m = ref found[found.len() - 1];
                let qty = quantity_to_real(w, c, m_text(m, chunk1)) * (offset as f64);
                let mut rebuilt = sub(chunk1, 0, m.caps[0]);
                push_all(mut rebuilt, lit(float_repr(qty)));
                push_all(mut rebuilt, sub(chunk1, m.caps[1], chunk1.len()));
                chunk1 = rebuilt;
            }
            let (t, sub_acc) = parse(w, mut c, chunk1, Some(st.clone()), VERSION_CONTEXT_STYLE)?;
            chunk1 = Vec.new();
            if sub_acc != 0 {
                st = t;
            }
        }
        match get_source(w, c, modifier, st) {
            Some(s2) => {
                st = s2;
                c.acc(ACU_HALFDAY);
            }
            None => {}
        }
    }
    Ok((spaced(chunk1, chunk2), st))
}

// _extract_time(m): hours, minutes and seconds of a time match.
fn extract_time(w: ref World, rx: ref Regex, m: ref Match, s: ref Vec[i64]) -> Result[(i64, i64, i64), Exc] {
    let hours = match m_group(rx, m, s, "hours") {
        Some(h) => h,
        None => {
            return Ok((0, 0, 0));
        }
    };
    if hours.len() == 0 {
        return Ok((0, 0, 0));
    }
    let h = py_int(w.u, hours)?;
    let mn = match m_group(rx, m, s, "minutes") {
        Some(x) => py_int(w.u, x)?,
        None => {
            return Err(exc("TypeError", "int() argument must be a string, a bytes-like object or a real number, not 'NoneType'".to_string()));
        }
    };
    let sec = match m_group(rx, m, s, "seconds") {
        Some(x) => {
            if x.len() == 0 {
                0
            } else {
                let t = replace_all(x, lit(","), lit("."));
                let parts = split_cps(t, 46);
                py_int(w.u, parts[0])?
            }
        }
        None => 0,
    };
    Ok((h, mn, sec))
}

// _pop_time_accuracy(m, ctx)
fn pop_time_accuracy(c: mut ref Cal, rx: ref Regex, m: ref Match, s: ref Vec[i64]) {
    let filled = |name: Str| {
        match m_group(rx, m, s, name) {
            Some(g) => g.len() > 0,
            None => false,
        }
    };
    if filled("hours") {
        c.acc(ACU_HOUR);
    }
    if filled("minutes") {
        c.acc(ACU_MIN);
    }
    if filled("seconds") {
        c.acc(ACU_SEC);
    }
}

// _evalUnits / _evalQUnits: "5 hrs 30 min", "5 h 30 m"
fn eval_units(w: ref World, c: mut ref Cal, text: ref Vec[i64], source: ref TimeTup, quick: bool) -> Result[TimeTup, Exc] {
    let s = strip(w.u, text);
    let l = ref w.locs[c.ptc.loc];
    let rx = if quick { ref l.rx.qunits } else { ref l.rx.units };
    let key = if quick { "qunits" } else { "units" };
    let (quantity, units) = match rx.search(w.u, s) {
        Some(m) => (sub(s, 0, m_start(rx, m, key)), m_group(rx, m, s, key).unwrap()),
        None => {
            return Err(exc("UnboundLocalError", "cannot access local variable 'quantity' where it is not associated with a value".to_string()));
        }
    };
    build_time(w, mut c, source, Some(quantity), Vec.new(), units)
}

// _evalDayStr: today, tomorrow, yesterday
fn eval_day_str(w: ref World, c: mut ref Cal, text: ref Vec[i64], st: ref TimeTup) -> Result[TimeTup, Exc] {
    let s = strip(w.u, text);
    let offset = match loc(w, c).day_offsets.get(s) {
        Some(o) => o,
        None => 0,
    };
    let (sh, sm, ss) = c.start_time(st);
    c.acc(ACU_DAY);
    let start = dt_new(st.yr, st.mth, st.dy, sh, sm, ss)?;
    Ok(timetuple(dt_add(start, td_days(offset))?))
}

// _evalWeekday
fn eval_weekday(w: ref World, c: mut ref Cal, text: ref Vec[i64], st: ref TimeTup) -> Result[TimeTup, Exc] {
    let s = strip(w.u, text);
    let start = dt_new(st.yr, st.mth, st.dy, st.hr, st.mn, st.sec)?;
    let wkdy = match loc(w, c).weekday_offsets.get(s) {
        Some(n) => n,
        None => {
            return Err(exc("KeyError", str_repr(s)));
        }
    };
    let qty = calculate_dow_delta(st.wd, wkdy, 2, c.ptc.dow_parse_style, c.ptc.current_dow_parse_style);
    c.acc(ACU_DAY);
    Ok(timetuple(dt_add(start, td_days(qty))?))
}

// _evalTimeStr: now, noon, lunch, tonight ...
fn eval_time_str(w: ref World, c: mut ref Cal, text: ref Vec[i64], st: ref TimeTup) -> Result[TimeTup, Exc] {
    let s = strip(w.u, text);
    let mut out = st.clone();
    if in_list(loc(w, c).now, s) {
        c.acc(ACU_NOW);
    } else {
        // Given string is a natural language time string like lunch,
        // midnight, etc
        match get_source(w, c, s, st) {
            Some(t) => {
                out = t;
            }
            None => {}
        }
        c.acc(ACU_HALFDAY);
    }
    Ok(out)
}

// _evalMeridian: HH:MM(:SS)(am/pm)
fn eval_meridian(w: ref World, c: mut ref Cal, text: ref Vec[i64], st: ref TimeTup) -> Result[TimeTup, Exc] {
    let s = strip(w.u, text);
    let l = ref w.locs[c.ptc.loc];
    let rx = ref l.rx.timehms2;
    let mut hr = st.hr;
    let mut mn = st.mn;
    let mut sec = st.sec;
    let found = rx.search(w.u, s);
    match found {
        Some(ref m) => {
            let dt = strip(w.u, sub(s, 0, m_start(rx, m, "meridian")));
            if dt.len() <= 2 {
                hr = py_int(w.u, dt)?;
                mn = 0;
                sec = 0;
            } else {
                let (h, mi, se) = extract_time(w, rx, m, s)?;
                hr = h;
                mn = mi;
                sec = se;
            }
            if hr == 24 {
                hr = 0;
            }
            let meridian = lower(m_group(rx, m, s, "meridian").unwrap());
            // if 'am' found and hour is 12 - force hour to 0 (midnight)
            if in_list(loc(w, c).am, meridian) and hr == 12 {
                hr = 0;
            }
            // if 'pm' found and hour < 12, add 12 to shift to evening
            if in_list(loc(w, c).pm, meridian) and hr < 12 {
                hr += 12;
            }
        }
        None => {}
    }
    // time validation
    if hr < 24 and mn < 60 and sec < 60 {
        let out = tt(st.yr, st.mth, st.dy, hr, mn, sec, st.wd, st.yd, st.dst);
        match found {
            Some(m) => pop_time_accuracy(mut c, rx, m, s),
            None => {}
        }
        return Ok(out);
    }
    Ok(st.clone())
}

// _evalTimeStd: HH:MM(:SS)
fn eval_time_std(w: ref World, c: mut ref Cal, text: ref Vec[i64], st: ref TimeTup) -> Result[TimeTup, Exc] {
    let s = strip(w.u, text);
    let l = ref w.locs[c.ptc.loc];
    let rx = ref l.rx.timehms;
    let mut hr = st.hr;
    let mut mn = st.mn;
    let mut sec = st.sec;
    let found = rx.search(w.u, s);
    match found {
        Some(ref m) => {
            let (h, mi, se) = extract_time(w, rx, m, s)?;
            hr = h;
            mn = mi;
            sec = se;
        }
        None => {}
    }
    if hr == 24 {
        hr = 0;
    }
    if hr < 24 and mn < 60 and sec < 60 {
        let out = tt(st.yr, st.mth, st.dy, hr, mn, sec, st.wd, st.yd, st.dst);
        match found {
            Some(m) => pop_time_accuracy(mut c, rx, m, s),
            None => {}
        }
        return Ok(out);
    }
    Ok(st.clone())
}

// _UnitsTrapped(s, m, key): a day suffix taken for a unit, as "31st"
// read as 31 seconds.
fn units_trapped(w: ref World, c: ref Cal, s: ref Vec[i64], rx: ref Regex, m: ref Match, key: Str) -> bool {
    let l = ref w.locs[c.ptc.loc];
    let day2 = ref l.rx.day2;
    match day2.search(w.u, s) {
        Some(m2) => {
            let mut t = m_group(day2, m2, s, "day").unwrap();
            push_all(mut t, m_group(rx, m, s, key).unwrap());
            let qty = m_group(rx, m, s, "qty").unwrap();
            m_start(rx, m, key) == m_start(day2, m2, "suffix") and m_start(rx, m, "qty") == m_start(day2, m2, "day")
                and same(qty, t)
        }
        None => false,
    }
}

fn partial_modifier(w: ref World, c: mut ref Cal, s: ref Vec[i64], st: ref TimeTup) -> Result[PRes, Exc] {
    let l = ref w.locs[c.ptc.loc];
    let rx = ref l.rx.modifier;
    match rx.search(w.u, s) {
        Some(m) => {
            let whole = m_text(m, s);
            let mut chunk1: Vec[i64] = Vec.new();
            let mut chunk2: Vec[i64] = Vec.new();
            if not same(whole, s) {
                chunk1 = strip(w.u, sub(s, 0, m.caps[0]));
                chunk2 = strip(w.u, sub(s, m.caps[1], s.len()));
            }
            let (rest, t) = eval_modifier(w, mut c, whole, chunk1, chunk2, st)?;
            Ok(pr(rest, t, true))
        }
        None => Ok(pr(s.clone(), st.clone(), false)),
    }
}

fn partial_units(w: ref World, c: mut ref Cal, s: ref Vec[i64], st: ref TimeTup, quick: bool) -> Result[PRes, Exc] {
    let l = ref w.locs[c.ptc.loc];
    let rx = if quick { ref l.rx.qunits } else { ref l.rx.units };
    let key = if quick { "qunits" } else { "units" };
    let m = match rx.search(w.u, s) {
        Some(m) => m,
        None => {
            return Ok(pr(s.clone(), st.clone(), false));
        }
    };
    if units_trapped(w, c, s, rx, m, key) {
        return Ok(pr(s.clone(), st.clone(), false));
    }
    let qty = m_group(rx, m, s, "qty").unwrap();
    let mut rest: Vec[i64] = Vec.new();
    let mut parse_str = s.clone();
    if not same(qty, s) {
        // capture remaining string
        parse_str = qty;
        let mut chunk1 = strip(w.u, sub(s, 0, m_start(rx, m, "qty")));
        let chunk2 = strip(w.u, sub(s, m_end(rx, m, "qty"), s.len()));
        if chunk1.len() > 0 and chunk1[chunk1.len() - 1] == 45 {
            let mut p = lit("-");
            push_all(mut p, parse_str);
            parse_str = p;
            chunk1 = sub(chunk1, 0, chunk1.len() - 1);
        }
        rest = spaced(chunk1, chunk2);
    }
    if parse_str.len() == 0 {
        return Ok(pr(rest, st.clone(), false));
    }
    let t = eval_units(w, mut c, parse_str, st, quick)?;
    Ok(pr(rest, t, true))
}

fn partial_date_str(w: ref World, c: mut ref Cal, s: ref Vec[i64], st: ref TimeTup) -> Result[PRes, Exc] {
    let l = ref w.locs[c.ptc.loc];
    let rx = ref l.rx.date3;
    let m = match rx.search(w.u, s) {
        Some(m) => m,
        None => {
            return Ok(pr(s.clone(), st.clone(), false));
        }
    };
    let date = m_group(rx, m, s, "date").unwrap();
    let mut parse_str = s.clone();
    let mut rest: Vec[i64] = Vec.new();
    if not same(date, s) {
        // capture remaining string
        let m_start_ = m_start(rx, m, "date");
        let mut m_end_ = m_end(rx, m, "date");
        // we need to check that anything following the parsed date is a
        // time expression because it is often picked up as a valid year
        // if the hour is 2 digits
        let mut f_time = false;
        let mut hours_start = -1;
        let m_year = m_group(rx, m, s, "year");
        let rx2 = ref l.rx.timehms2;
        match rx2.search(w.u, s) {
            Some(mm) => {
                if m_year.is_some() {
                    f_time = true;
                    hours_start = m_start(rx2, mm, "hours");
                }
            }
            None => {}
        }
        if not f_time {
            // "February 24th 12:00"
            let rx1 = ref l.rx.timehms;
            match rx1.search(w.u, s) {
                Some(mm) => {
                    if m_year.is_none() {
                        f_time = true;
                        hours_start = m_start(rx1, mm, "hours");
                    }
                }
                None => {}
            }
        }
        if f_time {
            if hours_start < m_end(rx, m, "year") {
                m_end_ = hours_start;
            }
        }
        parse_str = sub(s, m_start_, m_end_);
        let chunk1 = sub(s, 0, m_start_);
        let chunk2 = sub(s, m_end_, s.len());
        rest = spaced(chunk1, chunk2);
    }
    if parse_str.len() == 0 {
        return Ok(pr(rest, st.clone(), false));
    }
    let t = parse_date_text(w, mut c, strip(w.u, parse_str), Some(st.clone()))?;
    Ok(pr(rest, t, true))
}

// The date-like partial parsers that split off one match: CRE_DATE
// (kind 0), CRE_DAY (1) and CRE_TIME (2).
fn partial_simple(w: ref World, c: mut ref Cal, s: ref Vec[i64], st: ref TimeTup, kind: i64) -> Result[PRes, Exc] {
    let l = ref w.locs[c.ptc.loc];
    let rx = if kind == 0 { ref l.rx.date } else if kind == 1 { ref l.rx.day } else { ref l.rx.time };
    let found = rx.search(w.u, s);
    if found.is_none() and not (kind == 2 and in_list(l.now, s)) {
        return Ok(pr(s.clone(), st.clone(), false));
    }
    let mut parse_str = s.clone();
    let mut rest: Vec[i64] = Vec.new();
    match found {
        Some(m) => {
            let g = if kind == 0 { "date" } else { "" };
            let text = m_group(rx, m, s, g).unwrap();
            if not same(text, s) {
                parse_str = text;
                let chunk1 = sub(s, 0, m_start(rx, m, g));
                let chunk2 = sub(s, m_end(rx, m, g), s.len());
                rest = spaced(chunk1, chunk2);
            }
        }
        None => {}
    }
    if parse_str.len() == 0 {
        return Ok(pr(rest, st.clone(), false));
    }
    let t = if kind == 0 {
        parse_date(w, mut c, strip(w.u, parse_str), Some(st.clone()))?
    } else if kind == 1 {
        eval_day_str(w, mut c, parse_str, st)?
    } else {
        eval_time_str(w, mut c, parse_str, st)?
    };
    Ok(pr(rest, t, true))
}

fn partial_weekday(w: ref World, c: mut ref Cal, s: ref Vec[i64], st: ref TimeTup) -> Result[PRes, Exc] {
    let l = ref w.locs[c.ptc.loc];
    let rx = ref l.rx.weekday;
    let has_date = (c.cur() & ACU_DATE) != 0;
    let m = match rx.search(w.u, s) {
        Some(m) => m,
        None => {
            return Ok(pr(s.clone(), st.clone(), false));
        }
    };
    if l.day_offsets.get(s).is_some() {
        return Ok(pr(s.clone(), st.clone(), false));
    }
    let gv = m_text(m, s);
    let mut parse_str = s.clone();
    let mut rest: Vec[i64] = Vec.new();
    if not same(gv, s) {
        parse_str = gv;
        rest = spaced(sub(s, 0, m.caps[0]), sub(s, m.caps[1], s.len()));
    }
    if parse_str.len() == 0 {
        return Ok(pr(rest, st.clone(), false));
    }
    let mut t = st.clone();
    if not has_date {
        t = eval_weekday(w, mut c, parse_str, st)?;
    }
    Ok(pr(rest, t, true))
}

fn partial_meridian(w: ref World, c: mut ref Cal, s: ref Vec[i64], st: ref TimeTup) -> Result[PRes, Exc] {
    let l = ref w.locs[c.ptc.loc];
    let rx = ref l.rx.timehms2;
    let m = match rx.search(w.u, s) {
        Some(m) => m,
        None => {
            return Ok(pr(s.clone(), st.clone(), false));
        }
    };
    let mut parse_str = m_group(rx, m, s, "hours").unwrap();
    match m_group(rx, m, s, "minutes") {
        Some(mi) => {
            parse_str.push(58);
            push_all(mut parse_str, mi);
            match m_group(rx, m, s, "seconds") {
                Some(se) => {
                    parse_str.push(58);
                    push_all(mut parse_str, se);
                }
                None => {}
            }
        }
        None => {}
    }
    parse_str.push(32);
    push_all(mut parse_str, m_group(rx, m, s, "meridian").unwrap());
    let rest = spaced(sub(s, 0, m.caps[0]), sub(s, m.caps[1], s.len()));
    let t = eval_meridian(w, mut c, parse_str, st)?;
    Ok(pr(rest, t, true))
}

fn partial_time_std(w: ref World, c: mut ref Cal, s: ref Vec[i64], st: ref TimeTup) -> Result[PRes, Exc] {
    let l = ref w.locs[c.ptc.loc];
    let rx = ref l.rx.timehms;
    let m = match rx.search(w.u, s) {
        Some(m) => m,
        None => {
            return Ok(pr(s.clone(), st.clone(), false));
        }
    };
    let mut parse_str = m_group(rx, m, s, "hours").unwrap();
    parse_str.push(58);
    push_all(mut parse_str, m_group(rx, m, s, "minutes").unwrap());
    let chunk1 = sub(s, 0, m_start(rx, m, "hours"));
    let mut chunk2: Vec[i64] = Vec.new();
    match m_group(rx, m, s, "seconds") {
        Some(se) => {
            parse_str.push(58);
            push_all(mut parse_str, se);
            chunk2 = sub(s, m_end(rx, m, "seconds"), s.len());
        }
        None => {
            chunk2 = sub(s, m_end(rx, m, "minutes"), s.len());
        }
    }
    let rest = spaced(chunk1, chunk2);
    let t = eval_time_std(w, mut c, parse_str, st)?;
    Ok(pr(rest, t, true))
}

// parse(datetimeString, sourceTime, version): the time and the
// accuracy of the context it was parsed in.
fn parse(w: ref World, c: mut ref Cal, text: ref Vec[i64], source: Option[TimeTup], version: i64) -> Result[(TimeTup, i64), Exc] {
    let u = ref w.u;
    let mut s0 = w.m.parse0.sub(u, text, "\\1\\2");
    s0 = w.m.parse1.sub(u, s0, "\\1 \\2");
    s0 = w.m.parse2.sub(u, s0, "\\1 \\2");
    let mut st = match source {
        Some(t) => t.clone(),
        None => c.clock.clone(),
    };
    c.push_ctx();
    let mut s = strip(u, lower(s0));
    while s.len() > 0 {
        let mut matched = false;
        let mut k = 0;
        while k < 10 and not matched {
            let r = if k == 0 {
                partial_modifier(w, mut c, s, st)?
            } else if k == 1 {
                partial_units(w, mut c, s, st, false)?
            } else if k == 2 {
                partial_units(w, mut c, s, st, true)?
            } else if k == 3 {
                partial_date_str(w, mut c, s, st)?
            } else if k == 4 {
                partial_simple(w, mut c, s, st, 0)?
            } else if k == 5 {
                partial_simple(w, mut c, s, st, 1)?
            } else if k == 6 {
                partial_weekday(w, mut c, s, st)?
            } else if k == 7 {
                partial_simple(w, mut c, s, st, 2)?
            } else if k == 8 {
                partial_meridian(w, mut c, s, st)?
            } else {
                partial_time_std(w, mut c, s, st)?
            };
            if r.ok {
                s = strip(u, r.s);
                st = r.t;
                matched = true;
            }
            k += 1;
        }
        if not matched {
            // nothing matched
            s = Vec.new();
        }
    }
    let acc = c.pop_ctx();
    let _ = version;
    Ok((st, acc))
}

// What parse() returns second, as repr() shows it in this version.
fn flag_repr(c: ref Cal, version: i64, acc: i64) -> String {
    let v = if version == 0 { c.version } else { version };
    if v == VERSION_CONTEXT_STYLE { ctx_repr(acc) } else { f"{dt_flag(acc)}" }
}

// One nlp() result: (datetime, flags, start, end, matched text).
struct Found {
    dt: i64,
    flags: String,
    start: i64,
    end: i64,
    text: Vec[i64],
}

// A candidate: [start, end, text, flag, kind]
#[derive(Clone)]
struct Cand {
    start: i64,
    end: i64,
    text: Vec[i64],
    flag: i64,
}

// nlp(inputString, sourceTime, version)
fn nlp(w: ref World, c: mut ref Cal, input: ref Vec[i64], source: Option[TimeTup]) -> Result[Option[Vec[Found]], Exc] {
    let u = ref w.u;
    let l = ref w.locs[c.ptc.loc];
    let rx = ref l.rx;
    let orig = input.clone();
    // replace periods at the end of sentences w/ spaces opposed to
    // removing them altogether in order to retain relative positions
    let mut s = lower(w.m.nlp0.sub(u, input, "\\1 \\3"));
    s = w.m.nlp1.sub(u, s, "\\1 \\3");
    s = w.m.nlp2.sub(u, s, "\\1 \\3");
    let mut startpos = 0;
    let mut matches: Vec[Cand] = Vec.new();
    while startpos < s.len() {
        // empty match
        let mut lm = Cand { start: 0, end: 0, text: Vec.new(), flag: 0 };
        let rest = sub(s, startpos, s.len());
        let better = |lm: ref Cand, at: i64| { lm.end == 0 or lm.start > at + startpos };
        // Modifier like next\prev..
        match rx.modifier.search(u, rest) {
            Some(m) => {
                if better(lm, m.caps[0]) {
                    lm = Cand { start: m.caps[0] + startpos, end: m.caps[1] + startpos, text: m_text(m, rest), flag: 0 };
                }
            }
            None => {}
        }
        // Quantity + Units
        let mut q = 0;
        while q < 2 {
            let urx = if q == 0 { ref rx.units } else { ref rx.qunits };
            let key = if q == 0 { "units" } else { "qunits" };
            match urx.search(u, rest) {
                Some(m) => {
                    if not units_trapped(w, c, rest, urx, m, key) {
                        let qs = m_start(urx, m, "qty");
                        if better(lm, qs) {
                            lm = Cand { start: qs + startpos, end: m_end(urx, m, "qty") + startpos, text: m_group(urx, m, rest, "qty").unwrap(), flag: 3 };
                            if qs > 0 and s[qs - 1] == 45 {
                                lm.start = lm.start - 1;
                                let mut t = lit("-");
                                push_all(mut t, lm.text);
                                lm.text = t;
                            }
                        }
                    }
                }
                None => {}
            }
            q += 1;
        }
        // String date format, standard date format
        let mut d = 0;
        while d < 2 {
            let drx = if d == 0 { ref rx.date3 } else { ref rx.date };
            match drx.search(u, rest) {
                Some(m) => {
                    let ds = m_start(drx, m, "date");
                    if better(lm, ds) {
                        lm = Cand { start: ds + startpos, end: m_end(drx, m, "date") + startpos, text: m_group(drx, m, rest, "date").unwrap(), flag: 1 };
                    }
                }
                None => {}
            }
            d += 1;
        }
        // Natural language day strings
        match rx.day.search(u, rest) {
            Some(m) => {
                if better(lm, m.caps[0]) {
                    lm = Cand { start: m.caps[0] + startpos, end: m.caps[1] + startpos, text: m_text(m, rest), flag: 1 };
                }
            }
            None => {}
        }
        // Weekday
        match rx.weekday.search(u, rest) {
            Some(m) => {
                if l.day_offsets.get(rest).is_none() {
                    if better(lm, m.caps[0]) {
                        lm = Cand { start: m.caps[0] + startpos, end: m.caps[1] + startpos, text: m_text(m, rest), flag: 1 };
                    }
                }
            }
            None => {}
        }
        // Natural language time strings
        match rx.time.search(u, rest) {
            Some(m) => {
                if better(lm, m.caps[0]) {
                    lm = Cand { start: m.caps[0] + startpos, end: m.caps[1] + startpos, text: m_text(m, rest), flag: 2 };
                }
            }
            None => {}
        }
        // HH:MM(:SS) am/pm time strings
        match rx.timehms2.search(u, rest) {
            Some(m) => {
                let hs = m_start(rx.timehms2, m, "hours");
                if better(lm, hs) {
                    let a = hs + startpos;
                    let b = m_end(rx.timehms2, m, "meridian") + startpos;
                    lm = Cand { start: a, end: b, text: sub(s, a, b), flag: 2 };
                }
            }
            None => {}
        }
        // HH:MM(:SS) time strings
        match rx.timehms.search(u, rest) {
            Some(m) => {
                let hs = m_start(rx.timehms, m, "hours");
                if better(lm, hs) {
                    let a = hs + startpos;
                    let b = if m_start(rx.timehms, m, "seconds") >= 0 {
                        m_end(rx.timehms, m, "seconds") + startpos
                    } else {
                        m_end(rx.timehms, m, "minutes") + startpos
                    };
                    lm = Cand { start: a, end: b, text: sub(s, a, b), flag: 2 };
                }
            }
            None => {}
        }
        // Units only; must be preceded by a modifier
        if matches.len() > 0 and matches[matches.len() - 1].flag == 0 {
            match rx.units_only.search(u, rest) {
                Some(m) => {
                    // Ensure that any match is immediately proceded by the
                    // modifier. "Next is the word 'month'" should not parse
                    // as a date while "next month" should
                    if strip(u, sub(s, startpos, startpos + m.caps[0])).len() == 0 {
                        if better(lm, m.caps[0]) {
                            lm = Cand { start: m.caps[0] + startpos, end: m.caps[1] + startpos, text: m_text(m, rest), flag: 3 };
                        }
                    }
                }
                None => {}
            }
        }
        // set the start position to the end pos of the leftmost match
        startpos = lm.end;
        // nothing was detected so break out of the loop
        if startpos == 0 {
            startpos = s.len();
        } else {
            if lm.flag > 0 {
                let mut probe = sub(s, 0, lm.start);
                probe.push(32);
                push_all(mut probe, lit(f"{lm.flag}"));
                match rx.nlp_prefix.search(u, probe) {
                    Some(m) => {
                        lm.start = m_start(rx.nlp_prefix, m, "nlp_prefix");
                        lm.text = sub(s, lm.start, lm.end);
                    }
                    None => {}
                }
            }
            matches.push(lm);
        }
    }
    // find matches in proximity with one another and return all the
    // parsed values
    let mut out: Vec[Found] = Vec.new();
    if matches.len() > 1 {
        let mut from = 0;
        let mut date = matches[0].flag == 1;
        let mut time = matches[0].flag == 2;
        let mut units = matches[0].flag == 3;
        let mut i = 1;
        while i < matches.len() {
            // test proximity (are there characters between matches?)
            let endofprevious = matches[i - 1].end;
            let begofcurrent = matches[i].start;
            if strip(u, lower(sub(orig, endofprevious, begofcurrent))).len() > 0 {
                // this one isn't in proximity, but maybe we have enough
                // to make a datetime
                if date or time or units {
                    let a = matches[from].start;
                    let b = matches[i - 1].end;
                    let combined = sub(orig, a, b);
                    let (t, acc) = parse(w, mut c, combined, source.clone(), VERSION_CONTEXT_STYLE)?;
                    let dt = dt_new(t.yr, t.mth, t.dy, t.hr, t.mn, t.sec)?;
                    out.push(Found { dt: dt, flags: flag_repr(c, 0, acc), start: a, end: b, text: combined });
                }
                // not in proximity, reset starting from current
                from = i;
                date = matches[i].flag == 1;
                time = matches[i].flag == 2;
                units = matches[i].flag == 3;
            } else {
                if matches[i].flag == 1 {
                    date = true;
                }
                if matches[i].flag == 2 {
                    time = true;
                }
                if matches[i].flag == 3 {
                    units = true;
                }
            }
            i += 1;
        }
        // check last; we have enough to make a datetime
        if date or time or units {
            let a = matches[from].start;
            let b = matches[matches.len() - 1].end;
            let combined = sub(orig, a, b);
            let (t, acc) = parse(w, mut c, combined, source.clone(), VERSION_CONTEXT_STYLE)?;
            let dt = dt_new(t.yr, t.mth, t.dy, t.hr, t.mn, t.sec)?;
            out.push(Found { dt: dt, flags: flag_repr(c, 0, acc), start: a, end: b, text: combined });
        }
    } else if matches.len() == 0 {
        return Ok(None);
    } else {
        if matches[0].flag == 0 {
            // not enough info to parse
            return Ok(None);
        }
        let a = matches[0].start;
        let b = matches[0].end;
        let combined = sub(orig, a, b);
        let (t, acc) = parse(w, mut c, matches[0].text, source.clone(), VERSION_CONTEXT_STYLE)?;
        let dt = dt_new(t.yr, t.mth, t.dy, t.hr, t.mn, t.sec)?;
        out.push(Found { dt: dt, flags: flag_repr(c, 0, acc), start: a, end: b, text: combined });
    }
    Ok(Some(out))
}

// ------------------------------------------------------------ the reminders tool

fn read_file(path: Str) -> Result[Vec[i64], Exc] {
    match fs.read_bytes(path.to_string()) {
        Ok(b) => Ok(utf8_cps(b)),
        Err(e) => Err(exc("FileNotFoundError", f"{e}")),
    }
}

fn write_inputs() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data/inbox".to_string()) {
        return Err(f"cannot create data/inbox: {e}");
    }
    if let Err(e) = fs.create_dir_all("data/out".to_string()) {
        return Err(f"cannot create data/out: {e}");
    }
    for line in split_on(inbox_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, ' ');
        let bytes = if f[1] == "-" { Vec.new() } else { hex_bytes(f[1]) };
        if let Err(e) = fs.write_bytes(f"data/{f[0]}", bytes) {
            return Err(f"cannot write {f[0]}: {e}");
        }
    }
    Ok(())
}

// Each line of data/inbox/<src>, with every date nlp() finds in it.
fn agenda(w: ref World, c: mut ref Cal, src: ref String) -> Result[Vec[String], Exc] {
    let text = read_file(f"data/inbox/{src}")?;
    let mut out: Vec[String] = Vec.new();
    let mut no = 0;
    for line in split_cps(text, 10).iter() {
        no += 1;
        if strip(w.u, line).len() == 0 {
            continue;
        }
        match nlp(w, mut c, line, None)? {
            None => {
                out.push(f"{no}\t-\t{cps_str(line)}\n");
            }
            Some(found) => {
                for f in found.iter() {
                    out.push(f"{no}\t{f.start}-{f.end}\t{cps_str(f.text)}\t{dt_iso(f.dt)}\t{f.flags}\n");
                }
            }
        }
    }
    Ok(out)
}

// data/todo.txt's tasks by due time (a stable sort), then the ones with
// no time. Named todo_tool, not todo: a top-level `fn todo` is never
// called, the builtin todo() is (kara B-2026-10-23-10).
fn todo_tool(w: ref World, c: mut ref Cal) -> Result[Vec[String], Exc] {
    let text = read_file("data/todo.txt")?;
    let mut due: Vec[(i64, String)] = Vec.new();
    let mut later: Vec[String] = Vec.new();
    for line in split_cps(text, 10).iter() {
        if strip(w.u, line).len() == 0 or (line.len() > 0 and line[0] == 35) {
            continue;
        }
        let mut bar = 0;
        while bar < line.len() and line[bar] != 124 {
            bar += 1;
        }
        let task = strip(w.u, sub(line, 0, bar));
        let when = strip(w.u, sub(line, bar + 1, line.len()));
        let (t, acc) = parse(w, mut c, when, None, VERSION_CONTEXT_STYLE)?;
        if acc != 0 {
            let d = dt_new(t.yr, t.mth, t.dy, t.hr, t.mn, t.sec)?;
            let row = f"{dt_iso(d)}\t{cps_str(task)}\t{cps_str(when)}\t{ctx_repr(acc)}\n";
            let mut j = due.len();
            due.push((d, row.clone()));
            while j > 0 and due[j - 1].0 > d {
                due[j] = due[j - 1].clone();
                j -= 1;
            }
            due[j] = (d, row);
        } else {
            later.push(f"someday\t{cps_str(task)}\t{cps_str(when)}\n");
        }
    }
    let mut out: Vec[String] = Vec.new();
    for e in due.iter() {
        out.push(e.1.clone());
    }
    for e in later.iter() {
        out.push(e.clone());
    }
    Ok(out)
}

// Writes data/out/<name>, then prints it back from the file.
fn write_out(name: ref String, lines: ref Vec[String]) -> Result[(), Exc] {
    let mut text = String.new();
    for l in lines.iter() {
        text.push_str(l);
    }
    let path = f"data/out/{name}";
    if let Err(e) = fs.write(path.clone(), text.clone()) {
        return Err(exc("OSError", f"{e}"));
    }
    let back = read_file(path)?;
    println(f"  wrote out/{name} ({lines.len()} lines)");
    let parts = split_cps(back, 10);
    let mut k = 0;
    while k + 1 < parts.len() {
        println(f"  | {cps_str(parts[k])}");
        k += 1;
    }
    Ok(())
}

// ------------------------------------------------------------ the jobs

fn unesc(t: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < t.len() {
        let c = t[k];
        if c == 92 and k + 1 < t.len() {
            let n = t[k + 1];
            if n == 92 {
                out.push(92);
            } else if n == 116 {
                out.push(9);
            } else if n == 110 {
                out.push(10);
            } else {
                out.push(92);
                out.push(n);
            }
            k += 2;
        } else {
            out.push(c);
            k += 1;
        }
    }
    out
}

fn new_cal(w: ref World, locale: ref String, version: i64, clock: ref TimeTup) -> Cal {
    let li = if locale == "en_AU" { 1 } else { 0 };
    let _ = w;
    Cal {
        ptc: Ptc {
            loc: li,
            start_from_source: false,
            start_hour: 9,
            year_parse_style: 1,
            dow_parse_style: 1,
            current_dow_parse_style: 0,
            birthday_epoch: 50,
        },
        version: version,
        stack: Vec.new(),
        clock: clock.clone(),
    }
}

// month= / year= for inc(): (repr, the float float() makes of it).
fn num_arg(f: ref Vec[i64]) -> (String, Option[f64]) {
    let s = cps_str(f);
    if s == "-" {
        return ("None".to_string(), None);
    }
    let mut digits = true;
    let mut k = 0;
    while k < f.len() {
        if not ((f[k] >= 48 and f[k] <= 57) or (k == 0 and f[k] == 45)) {
            digits = false;
        }
        k += 1;
    }
    let mut v: f64 = 0.0;
    let mut ok = false;
    let mut neg = false;
    let mut whole = 0;
    let mut frac = 0.0;
    let mut scale = 1.0;
    let mut seen_point = false;
    k = 0;
    while k < f.len() {
        let ch = f[k];
        if ch == 45 and k == 0 {
            neg = true;
        } else if ch == 46 and not seen_point {
            seen_point = true;
        } else if ch >= 48 and ch <= 57 {
            ok = true;
            if seen_point {
                scale = scale * 10.0;
                frac = frac * 10.0 + ((ch - 48) as f64);
            } else {
                whole = whole * 10 + ch - 48;
            }
        } else {
            ok = false;
            break;
        }
        k += 1;
    }
    if not ok {
        return (str_repr(f), None);
    }
    v = (whole as f64) + frac / scale;
    if neg {
        v = -v;
    }
    if digits { (s, Some(v)) } else { (float_repr(v), Some(v)) }
}

fn run(w: ref World, c: mut ref Cal, f: ref Vec[Vec[i64]]) -> Result[(), Exc] {
    let op = cps_str(f[0]);
    let u = ref w.u;
    if op == "parse" {
        let text = unesc(f[1]);
        let mut version = c.version;
        if f.len() > 2 {
            version = py_int(u, f[2])?;
            println(f"> parse {str_repr(text)} version={version}");
        } else {
            println(f"> parse {str_repr(text)}");
        }
        let (t, acc) = parse(w, mut c, text, None, version)?;
        println(f"  -> {tt_repr(t)} {flag_repr(c, version, acc)}");
    } else if op == "src" {
        let text = unesc(f[1]);
        let mut v: Vec[i64] = Vec.new();
        let mut k = 2;
        while k < 11 {
            v.push(py_int(u, f[k])?);
            k += 1;
        }
        let src = tt(v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8]);
        println(f"> parse {str_repr(text)} sourceTime={tt_repr(src)}");
        let (t, acc) = parse(w, mut c, text, Some(src), c.version)?;
        println(f"  -> {tt_repr(t)} {flag_repr(c, c.version, acc)}");
    } else if op == "dt" {
        let text = unesc(f[1]);
        println(f"> parseDT {str_repr(text)}");
        let (t, acc) = parse(w, mut c, text, None, c.version)?;
        let d = dt_new(t.yr, t.mth, t.dy, t.hr, t.mn, t.sec)?;
        println(f"  -> {dt_repr(d)} {flag_repr(c, c.version, acc)}");
    } else if op == "nlp" {
        let text = unesc(f[1]);
        println(f"> nlp {str_repr(text)}");
        match nlp(w, mut c, text, None)? {
            None => println("  -> None"),
            Some(found) => {
                for x in found.iter() {
                    println(f"  - {dt_repr(x.dt)} {x.flags} {x.start} {x.end} {str_repr(x.text)}");
                }
            }
        }
    } else if op == "range" {
        let text = unesc(f[1]);
        println(f"> evalRanges {str_repr(text)}");
        let (a, b, flag) = eval_ranges(w, mut c, text, None)?;
        println(f"  -> {tt_repr(a)} {tt_repr(b)} {flag}");
    } else if op == "inc" {
        let mut v: Vec[i64] = Vec.new();
        let mut k = 1;
        while k < 7 {
            v.push(py_int(u, f[k])?);
            k += 1;
        }
        let d = dt_new(v[0], v[1], v[2], v[3], v[4], v[5])?;
        let (mr, mv) = num_arg(f[7]);
        let (yr, yv) = num_arg(f[8]);
        println(f"> inc {dt_repr(d)} month={mr} year={yr}");
        println(f"  -> {dt_repr(inc(w, c, d, mv, yv)?)}");
    } else if op == "words" {
        let text = unesc(f[1]);
        println(f"> _convertUnitAsWords {str_repr(text)}");
        println(f"  -> {convert_unit_as_words(w, c, text)?}");
    } else if op == "qty" {
        let text = unesc(f[1]);
        println(f"> _quantityToReal {str_repr(text)}");
        println(f"  -> {float_repr(quantity_to_real(w, c, text))}");
    } else if op == "dow" {
        let mut v: Vec[i64] = Vec.new();
        let mut k = 1;
        while k < 6 {
            v.push(py_int(u, f[k])?);
            k += 1;
        }
        println(f"> _CalculateDOWDelta({v[0]}, {v[1]}, {v[2]}, {v[3]}, {v[4]})");
        println(f"  -> {calculate_dow_delta(v[0], v[1], v[2], v[3], v[4])}");
    } else if op == "pdate" {
        let text = unesc(f[1]);
        println(f"> parseDate {str_repr(text)}");
        println(f"  -> {tt_repr(parse_date(w, mut c, text, None)?)}");
    } else if op == "pdtext" {
        let text = unesc(f[1]);
        println(f"> parseDateText {str_repr(text)}");
        println(f"  -> {tt_repr(parse_date_text(w, mut c, text, None)?)}");
    } else if op == "agenda" {
        let src = cps_str(f[1]);
        println(f"> agenda inbox/{src}");
        let lines = agenda(w, mut c, src)?;
        write_out(cps_str(f[2]), lines)?;
    } else if op == "todo" {
        println("> todo todo.txt");
        let lines = todo_tool(w, mut c)?;
        write_out(cps_str(f[1]), lines)?;
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_inputs() {
        eprintln(e);
        return;
    }
    let w = load_world();
    let mut clock = tt(2026, 1, 1, 0, 0, 0, 3, 1, 0);
    let mut cal = new_cal(w, "-".to_string(), 1, clock);
    for hex in split_on(jobs_text(), '\n') {
        if hex.len() == 0 {
            continue;
        }
        let f = split_cps(hex_text(hex), 9);
        let op = cps_str(f[0]);
        if op == "job" {
            println(f"== {cps_str(f[1])}");
        } else if op == "now" {
            let mut v: Vec[i64] = Vec.new();
            let mut k = 1;
            while k < 7 {
                v.push(int_of(cps_str(f[k])));
                k += 1;
            }
            let d = match dt_new(v[0], v[1], v[2], v[3], v[4], v[5]) {
                Ok(d) => d,
                Err(_) => 0,
            };
            let t = timetuple(d);
            clock = tt(v[0], v[1], v[2], v[3], v[4], v[5], t.wd, t.yd, 0);
            cal.clock = clock.clone();
            println(f"> now {tt_repr(clock)}");
        } else if op == "cal" {
            let locale = cps_str(f[1]);
            let version = int_of(cps_str(f[2]));
            cal = new_cal(w, locale, version, clock);
            let shown = if locale == "-" { "None".to_string() } else { str_repr(f[1]) };
            println(f"> Calendar(Constants({shown}), version={version})");
        } else if op == "set" {
            let name = cps_str(f[1]);
            let value = cps_str(f[2]);
            let n = if value == "True" { 1 } else if value == "False" { 0 } else { int_of(value) };
            if name == "StartHour" {
                cal.ptc.start_hour = n;
            } else if name == "StartTimeFromSourceTime" {
                cal.ptc.start_from_source = n != 0;
            } else if name == "YearParseStyle" {
                cal.ptc.year_parse_style = n;
            } else if name == "DOWParseStyle" {
                cal.ptc.dow_parse_style = n;
            } else if name == "CurrentDOWParseStyle" {
                cal.ptc.current_dow_parse_style = n;
            } else if name == "BirthdayEpoch" {
                cal.ptc.birthday_epoch = n;
            }
            println(f"> ptc.{name} = {value}");
        } else {
            // a context left open by an exception is never read again
            cal.stack = Vec.new();
            if let Err(e) = run(w, mut cal, f) {
                println(f"  error {e.cls}: {e.msg}");
            }
        }
    }
}

// Generated by gen_kara.py from data/jobs.tsv.

fn regex_text() -> String {
    let mut s = String.new();
    s.push_str("en_US.CRE_DATE 66 \nen_US.CRE_DATE2 66 5b2f5c2e5c2d5c2e5d\nen_US.CRE_DATE3 66 \n");
    s.push_str("en_US.CRE_DATE4 66 \nen_US.CRE_DATERNG1 66 285c642b285b2f5c2e5c2d5c2e5d5c642b292b295c732a2d5c732a285c642b285b2f5c2e5c2d5c2e5d5c642b292b29\nen_US.CRE_DATERNG2 66 \n");
    s.push_str("en_US.CRE_DATERNG3 66 \nen_US.CRE_DAY 66 5c620a2020202020202020202020202020202020202020202020202020283f3a0a202020202020202020202020202020202020202020202020202020202020746f6d6f72726f777c746f6461797c7965737465726461790a2020202020202020202020202020202020202020202020202020290a20202020202020202020202020202020202020202020202020205c62\nen_US.CRE_DAY2 66 283f503c6461793e5c645c643f290a202020202020202020202020202020202020202020202020202020283f503c7375666669783e72647c73747c6e647c7468293f0a2020202020202020202020202020202020202020202020\nen_US.CRE_MODIFIER 66 \n");
    s.push_str("en_US.CRE_MONTH 66 \nen_US.CRE_NLP_PREFIX 66 \nen_US.CRE_NUMBER 66 \n");
    s.push_str("en_US.CRE_QUNITS 66 \nen_US.CRE_RDATE 66 285c642b285b2f5c2e5c2d5c2e5d5c642b292b29\nen_US.CRE_RDATE3 66 \nen_US.CRE_REMAINING 66 5c732b\nen_US.CRE_RTIMEHMS 66 \n");
    s.push_str("en_US.CRE_RTIMEHMS2 66 \nen_US.CRE_SPECIAL 66 283f503c7370656369616c3e5e5b696e7c6f6e7c6f667c61745d2b295c732b\nen_US.CRE_TIME 66 \nen_US.CRE_TIMEHMS 66 \nen_US.CRE_TIMEHMS2 66 \n");
    s.push_str("en_US.CRE_TIMERNG1 66 \nen_US.CRE_TIMERNG2 66 \nen_US.CRE_TIMERNG3 66 \nen_US.CRE_TIMERNG4 66 \n");
    s.push_str("en_US.CRE_UNITS 66 \nen_US.CRE_UNITS_ONLY 66 5c62287365636f6e64737c6d696e757465737c7365636f6e647c6d696e7574657c6d6f6e7468737c686f7572737c7765656b737c6d6f6e74687c79656172737c736563737c6d696e737c686f75727c646179737c7765656b7c796561727c7365637c6d696e7c6461797c6d74687c68727c64797c776b7c79727c737c6d7c687c647c777c79295c62\nen_US.CRE_WEEKDAY 66 \nen_AU.CRE_DATE 66 \n");
