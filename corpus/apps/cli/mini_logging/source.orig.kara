fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn unhex(s: String) -> Vec[u8] {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data/config")?;
    put("data/config/base.json", file_0())?;
    make_dir("data/config/broken")?;
    put("data/config/broken/bad_class.json", file_1())?;
    put("data/config/broken/bad_flush_level.json", file_2())?;
    put("data/config/broken/bad_formatter_ref.json", file_3())?;
    put("data/config/broken/bad_kwarg.json", file_4())?;
    put("data/config/broken/bad_level.json", file_5())?;
    put("data/config/broken/bad_ref.json", file_6())?;
    put("data/config/broken/bad_style.json", file_7())?;
    put("data/config/broken/bad_target.json", file_8())?;
    put("data/config/broken/bare_dollar.json", file_9())?;
    put("data/config/broken/brace_conversion.json", file_10())?;
    put("data/config/broken/brace_spec.json", file_11())?;
    put("data/config/broken/dollar_no_fields.json", file_12())?;
    put("data/config/broken/no_version.json", file_13())?;
    put("data/config/broken/percent_brace.json", file_14())?;
    put("data/config/broken/version_two.json", file_15())?;
    put("data/config/final.json", file_16())?;
    put("data/config/verbose.json", file_17())?;
    make_dir("data/logs")?;
    put("data/logs/access.log", file_18())?;
    put("data/logs/access.log.1", file_19())?;
    put("data/logs/access.log.2", file_20())?;
    put("data/logs/audit.log", file_21())?;
    put("data/logs/db.log", file_22())?;
    make_dir("data")?;
    put("data/run.txt", file_23())?;
    Ok(())
}

// ------------------------------------------------------------ the service script

fn read(path: Str) -> Result[String, String] {
    match fs.read_to_string(path.to_string()) {
        Ok(t) => Ok(t),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

fn level_of(st: ref St, s: Str) -> i64 {
    match py_int(s) {
        Some(n) => n,
        None => st.level_by_name(s).unwrap_or(0),
    }
}

fn show_error(chain: ref Vec[String]) {
    for i in 0..chain.len() {
        if i == 0 {
            println(f"  {chain[i]}");
        } else {
            println(f"    from {chain[i]}");
        }
    }
}

fn describe(st: ref St, h: i64) -> String {
    let hd = st.hds[h].clone();
    let name = if hd.name.len() > 0 { hd.name.clone() } else { "-".to_string() };
    let detail = if hd.kind == FILE or hd.kind == ROTATING {
        hd.path.clone()
    } else if hd.kind == MEMORY {
        let t = if hd.target >= 0 { st.hds[hd.target].name.clone() } else { "none".to_string() };
        f"{hd.buffer.len()}/{hd.capacity} to {t}"
    } else if hd.kind == STREAM {
        if hd.stream == STDERR { "stderr".to_string() } else { "stdout".to_string() }
    } else {
        String.new()
    };
    let mut s = f"{name} ({kind_name(hd.kind)}";
    if detail.len() > 0 {
        s.push_str(f" {detail}");
    }
    if hd.level != NOTSET {
        s.push_str(f" at {st.level_name(hd.level)}");
    }
    if hd.closed {
        s.push_str(", closed");
    }
    s.push_str(")");
    s
}

fn show_logger(st: ref St, i: i64) {
    let lg = st.lgs[i].clone();
    if lg.placeholder {
        println(f"  {lg.name}: placeholder");
        return;
    }
    let mut parts: Vec[String] = Vec.new();
    let mut first = f"level {st.level_name(lg.level)}";
    if lg.level == NOTSET {
        first.push_str(f" (effective {st.level_name(st.effective(i))})");
    }
    parts.push(first);
    if not lg.propagate {
        parts.push("no propagate".to_string());
    }
    if lg.disabled {
        parts.push("disabled".to_string());
    }
    if lg.handlers.len() > 0 {
        let mut hs: Vec[String] = Vec.new();
        for h in lg.handlers {
            hs.push(describe(st, h));
        }
        parts.push(f"handlers {join(hs, ", ")}");
    }
    if lg.filters.len() > 0 {
        let mut fs: Vec[String] = Vec.new();
        for f in lg.filters {
            fs.push(py_repr(st.filters[f]));
        }
        parts.push(f"filters {join(fs, ", ")}");
    }
    println(f"  {lg.name}: {join(parts, "; ")}");
}

fn show_tree(st: ref St) {
    show_logger(st, 0);
    let mut names: Vec[String] = Vec.new();
    for i in 1..st.lgs.len() {
        names.push(st.lgs[i].name.clone());
    }
    sort_strings(mut names);
    for n in names {
        show_logger(st, st.find(n));
    }
}

fn show_files() -> Result[(), String] {
    let mut names = match fs.read_dir("data/logs".to_string()) {
        Ok(v) => v,
        Err(e) => return Err(f"cannot list data/logs: {e}"),
    };
    sort_strings(mut names);
    for name in names {
        let text = read(f"data/logs/{name}")?;
        println(f"  {name}: {text.len()} bytes");
        for l in lines_of(text) {
            println(f"    {l}");
        }
    }
    Ok(())
}

fn run_line(st: mut ref St, line: Str) -> Result[(), String] {
    if starts_with(line, "tick ") {
        st.now += py_int(slice_from(line, 5)).unwrap_or(0) * 1000000;
        return Ok(());
    }
    println(f"> {line}");
    let mut fields: Vec[String] = Vec.new();
    let b = to_bytes(line);
    let mut st0: i64 = 0;
    let mut i: i64 = 0;
    while i < b.len() {
        if starts_at(b, i, " | ") {
            fields.push(byte_str(b, st0, i));
            i += 3;
            st0 = i;
        } else {
            i += 1;
        }
    }
    fields.push(byte_str(b, st0, b.len()));
    let (cmd, _, arg) = partition(fields[0], b' ');
    if cmd == "log" {
        let level = level_of(st, fields[1]);
        let mut args: Vec[Val] = Vec.new();
        let mut ek: Vec[String] = Vec.new();
        let mut ev: Vec[Val] = Vec.new();
        for k in 3..fields.len() {
            let f = fields[k].clone();
            let kind = first_byte(f);
            let v = slice_from(f, 2);
            if kind == b's' {
                args.push(Val.S(v));
            } else if kind == b'i' {
                args.push(Val.I(py_int(v).unwrap_or(0)));
            } else if kind == b'f' {
                args.push(Val.F(v));
            } else {
                let (key, _, val) = partition(v, b'=');
                ek.push(key);
                ev.push(Val.S(val));
            }
        }
        let lg = st.get_logger(arg);
        if let Err(e) = st.log(lg, level, fields[2], args, ek, ev, st.now) {
            println(f"  {e}");
        }
    } else if cmd == "basic" {
        let mut opts: Vec[String] = Vec.new();
        for k in 1..fields.len() {
            opts.push(fields[k].clone());
        }
        if let Err(e) = basic_config(st, opts) {
            println(f"  {e}");
        }
    } else if cmd == "getlogger" {
        let _ = st.get_logger(arg);
    } else if cmd == "config" {
        let cfg = parse_json(read(fields[1])?)?;
        if let Err(chain) = dict_config(st, cfg) {
            show_error(chain);
        }
    } else if cmd == "tree" {
        show_tree(st);
    } else if cmd == "enabled" {
        let lg = st.get_logger(arg);
        let mut parts: Vec[String] = Vec.new();
        for n in ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"] {
            let yes = if st.is_enabled(lg, level_of(st, n)) { "yes" } else { "no" };
            parts.push(f"{n}={yes}");
        }
        println(f"  {arg}: {join(parts, " ")}");
    } else if cmd == "level" {
        let lg = st.get_logger(arg);
        st.lgs[lg].level = level_of(st, fields[1]);
    } else if cmd == "disable" {
        st.disable = level_of(st, fields[1]);
    } else if cmd == "addlevel" {
        st.add_level_name(py_int(fields[1]).unwrap_or(0), fields[2]);
    } else if cmd == "shutdown" {
        st.shutdown();
    } else if cmd == "files" {
        show_files()?;
    }
    Ok(())
}

fn run() -> Result[(), String] {
    write_data()?;
    let mut st = new_state();
    for line in lines_of(read("data/run.txt")?) {
        if line.len() > 0 and first_byte(line) != b'#' {
            run_line(mut st, line)?;
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_logging: {e}");
    }
}
