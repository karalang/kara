== hjson multiline.hjson
{
  text:
    '''
    first line
      indented line

    after a blank line
    '''
  oneline: just one line
  quoted: has 'single' quotes
  nested:
  {
    poem:
      '''
      Roses are red,
      Violets are blue.
      '''
    inlist:
    [
      
        '''
        alpha
        beta
        '''
      plain
    ]
  }
}
