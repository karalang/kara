    tls: false
  }
  motd:
    '''
    Scheduled maintenance on Sunday.
      Payments may be delayed.
    '''
  name: billing-api
  owner: payments-team@example.com
  path: C:\billing\data
  "quoted key with spaces": yes
  rate: 1/3 of traffic
  retry:
  {
    attempts: 5
    backoff: 150
    jitter: 0.25
  }
  version: 2.4.1
}
