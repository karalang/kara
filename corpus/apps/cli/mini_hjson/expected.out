== hjson service.hjson
{
  name: billing-api
  version: 2.4.1
  owner: payments-team@example.com
  listen:
  {
    host: 0.0.0.0
    port: 8443
    tls: false
  }
  database:
  {
    url: postgres://billing@db.internal:5432/billing
    pool: 20
    timeout: 2.50
    replicas:
    [
      db-replica-1.internal
      db-replica-2.internal
    ]
  }
  retry:
  {
    attempts: 5
    backoff: 150
    jitter: 0.25
  }
  features:
  {
    new-checkout: true
    legacy-invoices: false
    beta-users: null
  }
  motd:
    '''
    Scheduled maintenance on Sunday.
      Payments may be delayed.
    '''
  path: C:\billing\data
  greeting: hello, world # not a comment inside a quoteless string? it is
  rate: 1/3 of traffic
  "quoted key with spaces": yes
  emptyString: ""
}
== hjson -j service.hjson
{
  "name": "billing-api",
  "version": "2.4.1",
  "owner": "payments-team@example.com",
  "listen": {
    "host": "0.0.0.0",
    "port": 8443,
    "tls": false
  },
  "database": {
    "url": "postgres://billing@db.internal:5432/billing",
    "pool": 20,
    "timeout": 2.50,
    "replicas": [
      "db-replica-1.internal",
      "db-replica-2.internal"
    ]
  },
  "retry": {
    "attempts": 5,
    "backoff": 150,
    "jitter": 0.25
  },
  "features": {
    "new-checkout": true,
    "legacy-invoices": false,
    "beta-users": null
  },
  "motd": "Scheduled maintenance on Sunday.\n  Payments may be delayed.",
  "path": "C:\\billing\\data",
  "greeting": "hello, world # not a comment inside a quoteless string? it is",
  "rate": "1/3 of traffic",
  "quoted key with spaces": "yes",
  "emptyString": ""
}
