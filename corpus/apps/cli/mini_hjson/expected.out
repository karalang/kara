{"stages":["build","test","deploy"],"build":{"image":"rust:1.80","script":["cargo build --release","cargo test -- --nocapture"],"cache":{"key":"cargo-$CI_COMMIT_REF_SLUG","paths":["target/"]}},"deploy":{"only":["main"],"when":"manual","environment":"production","retries":0,"timeout":3600}}
