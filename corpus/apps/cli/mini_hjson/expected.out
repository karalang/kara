== hjson strings.hjson
{
  plain: hello world
  quoted: hello world
  single: it's
  singleq: say "hi"
  doubleq: it's
  escapes:
    '''
    tab	new
    line "quote" back\slash /slash
    '''
  unicode: café ☺
  pair: 😀 grin
  raw: grüße aus köln
  hashlike: "#not a comment"
  slashy: "// nor this"
  colon: a:b:c
  bracey: "{braces}"
  leading: "  padded  "
  trailingspace: "tail "
  keyword: "true"
  keywordish: true story
  numberish: "42"
  numberish2: 42 apples
  nullish: null pointer
  empty: ""
  quotes: '''"quoted"'''
  ctrl: "bell\u0007"
  ls: "line\u2028sep"
  bom: "﻿mark"
  apos: don't
  url: https://example.com/a?b=c#frag
  comma: a, b
  "": empty key
  "a b": spaced key
  "x:y": colon key
  "it's": apostrophe key
}
