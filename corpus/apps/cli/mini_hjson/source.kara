    let mut t = String.new();
    t.push_str("{\n");
    t.push_str("  // UI strings for the checkout page\n");
    t.push_str("  \"en\": {\n");
    t.push_str("    title: Checkout\n");
    t.push_str("    total: Total: {amount}\n");
    t.push_str("    note: '''\n");
    t.push_str("      Prices include VAT.\n");
    t.push_str("      Shipping is calculated at the next step.\n");
    t.push_str("      '''\n");
    t.push_str("  },\n");
    t.push_str("  \"de\": {\n");
    t.push_str("    title: Kasse\n");
    t.push_str("    total: \"Summe: {amount}\"\n");
    t.push_str("    note: Preise inkl. MwSt.\n");
    t.push_str("  },\n");
    t.push_str("  \"ja\": {\n");
    t.push_str("    title: お会計\n");
    t.push_str("    total: 合計: {amount}\n");
    t.push_str("  },\n");
    t.push_str("  \"ar\": {\n");
    t.push_str("    title: \"الدفع\"\n");
    t.push_str("  }\n");
    t.push_str("}\n");
    v.push(DataFile { path: "translations.hjson".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("   \n");
    t.push_str("\t\n");
    v.push(DataFile { path: "ws.hjson".to_string(), hex: false, body: t });
}
