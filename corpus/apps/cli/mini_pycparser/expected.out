typedef unsigned long long u64;
enum slot_state
{
  SLOT_EMPTY,
  SLOT_FULL = 1,
  SLOT_DEAD = 2
};
typedef u64 (*hash_fn)(const void *key, size_t len);
typedef int (*eq_fn)(const void *a, const void *b, size_t len);
struct slot
{
  enum slot_state state;
  u64 hash;
  union 
  {
    long i;
    double d;
    void *p;
  } value;
  const char *key;
};
struct map
{
  struct slot *slots;
  size_t mask;
  size_t len;
  hash_fn hash;
  eq_fn eq;
};
static u64 fnv1a(const void *key, size_t len)
{
  const unsigned char *p = key;
  u64 h = 14695981039346656037ULL;
  while (len--)
  {
    h ^= *(p++);
    h *= 1099511628211ULL;
  }

  return h;
}

static struct slot *probe(struct map *m, const char *key, size_t len, u64 h)
{
  size_t i = h & m->mask;
  size_t step = 1;
  for (;;)
  {
    struct slot *s = &m->slots[i];
    switch (s->state)
    {
      case SLOT_EMPTY:
        return s;

      case SLOT_DEAD:
        break;

      case SLOT_FULL:
        if (s->hash == h && m->eq(s->key, key, len))
        return s;
        break;

      default:
        return 0;

    }

    i = i + (step++) & m->mask;
  }

}

int map_put_int(struct map *m, const char *key, size_t len, long v)
{
  u64 h = (m->hash) ? (m->hash(key, len)) : (fnv1a(key, len));
  struct slot *s = probe(m, key, len, h);
  if (!s)
    return -1;
  s->state = SLOT_FULL;
  s->hash = h;
  s->key = key;
  s->value.i = v;
  m->len += s->state == SLOT_FULL;
  return 0;
}

