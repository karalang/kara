$ gen jsontok.i
typedef enum 
{
  TOK_LBRACE = '{',
  TOK_RBRACE = '}',
  TOK_LBRACKET = '[',
  TOK_RBRACKET = ']',
  TOK_COLON = ':',
  TOK_COMMA = ',',
  TOK_STRING = 256,
  TOK_NUMBER,
  TOK_TRUE,
  TOK_FALSE,
  TOK_NULL,
  TOK_EOF,
  TOK_ERROR = -1
} tok_kind;
typedef struct 
{
  const char *src;
  int pos;
  int line;
  char err[64];
} lexer;
extern int snprintf(char *buf, unsigned long n, const char *fmt, ...);
static int is_digit(int c)
{
  return (c >= '0') && (c <= '9');
}

static tok_kind fail(lexer *lx, const char *what)
{
  snprintf(lx->err, sizeof(lx->err), "line %d: unexpected %s\n", lx->line, what);
  return TOK_ERROR;
}

tok_kind next_token(lexer *lx)
{
  int c;
  again:
  c = lx->src[lx->pos++];

  switch (c)
  {
    case '\n':
      lx->line++;

    case ' ':

    case '\t':

    case '\r':
      goto again;

    case '{':

    case '}':

    case '[':

    case ']':

    case ':':

    case ',':
      return (tok_kind) c;

    case '"':
      while ((c = lx->src[lx->pos++]) != '"')
    {
      if (c == '\\')
        lx->pos++;
      else
        if (c == '\0')
        return fail(lx, "end of input in string");
    }

      return TOK_STRING;

    case '-':

    case '0':

    case '1':

    case '2':

    case '3':

    case '4':

    case '5':

    case '6':

    case '7':

    case '8':

    case '9':
      while (((is_digit(lx->src[lx->pos]) || (lx->src[lx->pos] == '.')) || (lx->src[lx->pos] == 'e')) || (lx->src[lx->pos] == 'E'))
      lx->pos++;

      return TOK_NUMBER;

    case 't':
      lx->pos += 3;
      return TOK_TRUE;

    case '\0':
      lx->pos--;
      return TOK_EOF;

    default:
      return fail(lx, "character");

  }

}
