$ gen omp.i
extern int omp_get_thread_num(void);
extern int omp_get_num_threads(void);
#pragma once
#pragma pack(push, 4)
struct work
{
  int id;
  float load;
};
#pragma pack(pop)
void run(struct work *w, int n)
{
  int i;
  #pragma omp parallel for schedule(static)
  for (i = 0; i < n; i++)
    w[i].load *= 0.5f;

  #pragma omp barrier
  if (omp_get_thread_num() == 0)
  {
    #pragma omp critical
    w[0].id = omp_get_num_threads();
  }
}

int after_marker;
$ funcs omp.i
