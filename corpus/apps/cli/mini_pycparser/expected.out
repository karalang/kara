$ gen fsm.i
typedef enum 
{
  IDLE,
  RUN,
  STOP,
  N_STATES
} state_t;
typedef state_t (*handler)(int ev, void *ctx);
static state_t on_idle(int ev, void *ctx);
static state_t on_run(int ev, void *ctx);
static state_t on_stop(int ev, void *ctx);
static const handler table[N_STATES] = {.IDLE = on_idle, .RUN = on_run, .STOP = on_stop};
static state_t on_idle(int ev, void *ctx)
{
  return (ev == 1) ? (RUN) : ((ev == 2) ? (STOP) : (IDLE));
}

static state_t on_run(int ev, void *ctx)
{
  (void) ctx;
  return (ev) ? (STOP) : (RUN);
}

static state_t on_stop(int ev, void *ctx)
{
  return IDLE;
}

int step(state_t *s, const int *events, int n)
{
  int k = 0;
  int a = 1;
  int b = 2;
  int c = 3;
  do
  {
    *s = table[*s](events[k], 0);
  }
  while (((++k) < n) && ((*s) != STOP));
  a = (((a + (b * c)) - (a - b)) - (c - (a + b))) + ((a % b) * c);
  b = (((a | b) & c) ^ ((a << 2) >> 1)) || ((!a) && (b != c));
  c = (a < b) == (b > c);
  a = ((-(-a)) + (-(-b))) + (~(~c));
  b = (a = b) + (c += 2);
  c = (((*(&a)) + ((*s)++)) + table[0]) != 0;
  return k;
}
$ genr fsm.i
typedef enum 
{
  IDLE,
  RUN,
  STOP,
  N_STATES
} state_t;
typedef state_t (*handler)(int ev, void *ctx);
static state_t on_idle(int ev, void *ctx);
static state_t on_run(int ev, void *ctx);
static state_t on_stop(int ev, void *ctx);
static const handler table[N_STATES] = {.IDLE = on_idle, .RUN = on_run, .STOP = on_stop};
static state_t on_idle(int ev, void *ctx)
{
  return (ev == 1) ? (RUN) : ((ev == 2) ? (STOP) : (IDLE));
}

static state_t on_run(int ev, void *ctx)
{
  (void) ctx;
  return (ev) ? (STOP) : (RUN);
}

static state_t on_stop(int ev, void *ctx)
{
  return IDLE;
}

int step(state_t *s, const int *events, int n)
{
  int k = 0;
  int a = 1;
  int b = 2;
  int c = 3;
  do
  {
    *s = table[*s](events[k], 0);
  }
  while ((++k) < n && (*s) != STOP);
  a = a + b * c - (a - b) - (c - (a + b)) + a % b * c;
  b = (a | b) & c ^ a << 2 >> 1 || (!a) && b != c;
  c = a < b == b > c;
  a = (-(-a)) + (-(-b)) + (~(~c));
  b = (a = b) + (c += 2);
  c = (*(&a)) + ((*s)++) + table[0] != 0;
  return k;
}
