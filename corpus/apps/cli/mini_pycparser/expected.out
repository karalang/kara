$ gen ring.i
typedef unsigned char uint8_t;
typedef unsigned int uint32_t;
typedef unsigned long size_t;
typedef struct ring
{
  uint8_t *buf;
  size_t cap;
  volatile size_t head;
  volatile size_t tail;
  unsigned overflowed : 1;
  unsigned : 7;
} ring_t;
int ring_init(ring_t *r, uint8_t *storage, size_t cap);
size_t ring_put(ring_t *r, const uint8_t *src, size_t n);
size_t ring_get(ring_t *r, uint8_t *dst, size_t n);
inline static size_t ring_used(const ring_t *r)
{
  return (r->head - r->tail) & (r->cap - 1);
}

inline static size_t ring_free(const ring_t *r)
{
  return (r->cap - 1) - ring_used(r);
}

int ring_init(ring_t *r, uint8_t *storage, size_t cap)
{
  if ((cap == 0) || ((cap & (cap - 1)) != 0))
    return -1;
  r->buf = storage;
  r->cap = cap;
  r->head = (r->tail = 0);
  r->overflowed = 0;
  return 0;
}

size_t ring_put(ring_t *r, const uint8_t *src, size_t n)
{
  size_t i;
  size_t room = ring_free(r);
  if (n > room)
  {
    r->overflowed = 1;
    n = room;
  }
  for (i = 0; i < n; i++)
  {
    r->buf[r->head] = src[i];
    r->head = (r->head + 1) & (r->cap - 1);
  }

  return n;
}

size_t ring_get(ring_t *r, uint8_t *dst, size_t n)
{
  size_t got = 0;
  while ((got < n) && (r->tail != r->head))
  {
    *(dst++) = r->buf[r->tail];
    r->tail = (r->tail + 1) & (r->cap - 1);
    ++got;
  }

  return got;
}
