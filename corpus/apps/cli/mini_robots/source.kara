fn data_part_2(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("# robots.txt for shop.test\n");
    t.push_str("User-agent: *\n");
    t.push_str("Disallow: /cart\n");
    t.push_str("Disallow: /checkout/\n");
    t.push_str("Allow: /checkout/help\n");
    t.push_str("Disallow: /*?sessionid=\n");
    t.push_str("Disallow: /*.pdf$\n");
    t.push_str("Disallow: /search\n");
    t.push_str("Allow: /search/about$\n");
    t.push_str("Crawl-delay: 2\n");
    t.push_str("Request-rate: 3/10\n");
    t.push_str("\n");
    t.push_str("User-agent: KaraBot\n");
    t.push_str("User-agent: OtherBot\n");
    t.push_str("Disallow: /private\n");
    t.push_str("Allow: /private/press\n");
    t.push_str("Disallow: /tmp/*/cache\n");
    t.push_str("Crawl-delay: 1\n");
    t.push_str("\n");
    t.push_str("User-agent: BadBot\n");
    t.push_str("Disallow: /\n");
    t.push_str("\n");
    t.push_str("Sitemap: https://shop.test/sitemap.xml\n");
    t.push_str("Sitemap: https://shop.test/sitemap-products.xml\n");
    t.push_str("\n");
    t.push_str("user-agent: karabot\n");
    t.push_str("Disallow: /drafts\n");
    v.push(DataFile { path: "web/shop.test/robots.txt".to_string(), hex: false, body: t });
}
