// mini_robots: Python 3.13's urllib.robotparser, the robots.txt reader
// that RFC 9309 describes and most Python crawlers use, ported from
// robotparser.py with the parts of urllib.parse it stands on (urlsplit,
// urlunsplit, quote and unquote), plus a polite crawler built on it.
//
// The run writes the test sites of the data section into data/web/
// (each host's robots.txt, an HTTP status for it if it has one, and its
// pages) and runs every job of data/jobs.jsonl. A load job reads a
// robots.txt through a fake urlopen that serves data/web/, a parse job
// parses a file from data/robots/, show and check jobs print what the
// parser answers, and a crawl job walks the sites as one user agent:
// robots.txt first, then only the pages it may fetch, waiting out each
// host's Crawl-delay on a virtual clock.

import std.time.{SystemTime};

// ------------------------------------------------------------ characters

fn chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn text(v: ref Vec[char]) -> String {
    v.iter().collect()
}

fn slice(v: ref Vec[char], lo: i64, hi: i64) -> Vec[char] {
    let mut a = lo;
    let mut b = hi;
    if a < 0 {
        a = 0;
    }
    if b > v.len() {
        b = v.len();
    }
    if a >= b {
        return Vec.new();
    }
    v[a..b].to_vec()
}

fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

// str.isspace, which str.strip, str.split and float() use.
fn py_space(c: char) -> bool {
    c.is_whitespace() or (c >= '\u{1c}' and c <= '\u{1f}')
}

fn py_strip(s: ref String) -> String {
    let v = chars(s);
    let mut lo = 0;
    let mut hi = v.len();
    while lo < hi and py_space(v[lo]) {
        lo += 1;
    }
    while hi > lo and py_space(v[hi - 1]) {
        hi -= 1;
    }
    text(slice(v, lo, hi))
}

// str.splitlines()
fn line_break(c: char) -> bool {
    c == '\n' or c == '\r' or c == '\u{b}' or c == '\u{c}' or c == '\u{1c}' or c == '\u{1d}' or c == '\u{1e}'
        or c == '\u{85}' or c == '\u{2028}' or c == '\u{2029}'
}

fn splitlines(s: ref String) -> Vec[String] {
    let v = chars(s);
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    let mut i = 0;
    while i < v.len() {
        let c = v[i];
        if line_break(c) {
            out.push(cur);
            cur = String.new();
            if c == '\r' and i + 1 < v.len() and v[i + 1] == '\n' {
                i += 1;
            }
        } else {
            cur.push(c);
        }
        i += 1;
    }
    if not cur.is_empty() {
        out.push(cur);
    }
    out
}

fn hex_digits(v: i64, n: i64) -> String {
    let mut s = f"{v:x}";
    while s.len() < n {
        s = f"0{s}";
    }
    s
}

fn printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) or (c >= 0x205F and c <= 0x206F) {
        return false;
    }
    if c == 0x3000 or c == 0xFEFF or (c >= 0xE000 and c <= 0xF8FF) {
        return false;
    }
    true
}

// repr(str)
fn repr_str(s: ref String) -> String {
    let single = s.contains("'");
    let double = s.contains("\"");
    let q = if single and not double { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        let o = c as i64;
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if escaped_byte(c) >= 0 {
            out.push_str(f"\\udc{hex_digits(escaped_byte(c), 2)}");
        } else if printable(o) {
            out.push(c);
        } else if o < 0x100 {
            out.push_str(f"\\x{hex_digits(o, 2)}");
        } else if o < 0x10000 {
            out.push_str(f"\\u{hex_digits(o, 4)}");
        } else {
            out.push_str(f"\\U{hex_digits(o, 8)}");
        }
    }
    out.push(q);
    out
}

// ------------------------------------------------------------ JSON

#[derive(Clone)]
enum JValue {
    Null,
    Bool(bool),
    Int(i64),
    Float(f64),
    Str(String),
    List(Vec[JValue]),
    Obj(Vec[(String, JValue)]),
}

fn push_utf8(out: mut ref Vec[u8], c: u32) {
    if c < 0x80 {
        out.push(c as u8);
    } else if c < 0x800 {
        out.push((0xC0 | (c >> 6)) as u8);
        out.push((0x80 | (c & 0x3F)) as u8);
    } else if c < 0x10000 {
        out.push((0xE0 | (c >> 12)) as u8);
        out.push((0x80 | ((c >> 6) & 0x3F)) as u8);
        out.push((0x80 | (c & 0x3F)) as u8);
    } else {
        out.push((0xF0 | (c >> 18)) as u8);
        out.push((0x80 | ((c >> 12) & 0x3F)) as u8);
        out.push((0x80 | ((c >> 6) & 0x3F)) as u8);
        out.push((0x80 | (c & 0x3F)) as u8);
    }
}

struct JsonReader {
    b: Vec[u8],
    at: i64,
}

impl JsonReader {
    fn ws(mut ref self) {
        while self.at < self.b.len() {
            let c = self.b[self.at];
            if c == b' ' or c == b'\n' or c == b'\r' or c == b'\t' {
                self.at += 1;
            } else {
                break;
            }
        }
    }

    fn eat(mut ref self, word: Str) -> bool {
        let w = word.bytes();
        if self.at + w.len() > self.b.len() {
            return false;
        }
        for k in 0..w.len() {
            if self.b[self.at + k] != w[k] {
                return false;
            }
        }
        self.at += w.len();
        true
    }

    fn value(mut ref self) -> Result[JValue, String] {
        self.ws();
        if self.at >= self.b.len() {
            return Err("unexpected end of JSON".to_string());
        }
        let c = self.b[self.at];
        if c == b'{' {
            self.at += 1;
            let mut m: Vec[(String, JValue)] = Vec.new();
            self.ws();
            if self.eat("}") {
                return Ok(JValue.Obj(m));
            }
            loop {
                self.ws();
                let k = self.string()?;
                self.ws();
                if not self.eat(":") {
                    return Err(f"expected ':' at {self.at}");
                }
                let v = self.value()?;
                m.push((k, v));
                self.ws();
                if self.eat("}") {
                    return Ok(JValue.Obj(m));
                }
                if not self.eat(",") {
                    return Err(f"expected ',' at {self.at}");
                }
            }
        }
        if c == b'[' {
            self.at += 1;
            let mut items: Vec[JValue] = Vec.new();
            self.ws();
            if self.eat("]") {
                return Ok(JValue.List(items));
            }
            loop {
                items.push(self.value()?);
                self.ws();
                if self.eat("]") {
                    return Ok(JValue.List(items));
                }
                if not self.eat(",") {
                    return Err(f"expected ',' at {self.at}");
                }
            }
        }
        if c == b'"' {
            return Ok(JValue.Str(self.string()?));
        }
        if self.eat("true") {
            return Ok(JValue.Bool(true));
        }
        if self.eat("false") {
            return Ok(JValue.Bool(false));
        }
        if self.eat("null") {
            return Ok(JValue.Null);
        }
        self.number()
    }

    fn hex4(mut ref self) -> u32 {
        let mut v: u32 = 0;
        for _ in 0..4 {
            let c = self.b[self.at];
            self.at += 1;
            let d = if c >= b'0' and c <= b'9' {
                c - b'0'
            } else if c >= b'a' and c <= b'f' {
                c - b'a' + 10
            } else {
                c - b'A' + 10
            };
            v = v * 16 + d as u32;
        }
        v
    }

    fn string(mut ref self) -> Result[String, String] {
        if not self.eat("\"") {
            return Err(f"expected string at {self.at}");
        }
        let mut out: Vec[u8] = Vec.new();
        loop {
            if self.at >= self.b.len() {
                return Err("unterminated string".to_string());
            }
            let c = self.b[self.at];
            self.at += 1;
            if c == b'"' {
                break;
            }
            if c != b'\\' {
                out.push(c);
                continue;
            }
            let e = self.b[self.at];
            self.at += 1;
            if e == b'n' {
                out.push(10);
            } else if e == b't' {
                out.push(9);
            } else if e == b'r' {
                out.push(13);
            } else if e == b'b' {
                out.push(8);
            } else if e == b'f' {
                out.push(12);
            } else if e == b'u' {
                let mut cp = self.hex4();
                if cp >= 0xD800 and cp < 0xDC00 and self.eat("\\u") {
                    let lo = self.hex4();
                    cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
                }
                push_utf8(mut out, cp);
            } else {
                out.push(e);
            }
        }
        Ok(String.from_utf8(out).unwrap_or("?".to_string()))
    }

    fn number(mut ref self) -> Result[JValue, String] {
        let start = self.at;
        let mut float = false;
        while self.at < self.b.len() {
            let c = self.b[self.at];
            if c >= b'0' and c <= b'9' {
                self.at += 1;
            } else if c == b'-' or c == b'+' {
                self.at += 1;
            } else if c == b'.' or c == b'e' or c == b'E' {
                float = true;
                self.at += 1;
            } else {
                break;
            }
        }
        let t = String.from_utf8(self.b[start..self.at].to_vec()).unwrap_or(String.new());
        if t.is_empty() {
            return Err(f"bad value at {start}");
        }
        if float {
            return match f64.parse(t) {
                Ok(f) => Ok(JValue.Float(f)),
                Err(_) => Err(f"bad number {t}"),
            };
        }
        match i64.parse(t) {
            Ok(i) => Ok(JValue.Int(i)),
            Err(_) => Err(f"bad number {t}"),
        }
    }
}

fn parse_json(t: ref String) -> Result[JValue, String] {
    let mut r = JsonReader { b: t.bytes().to_vec(), at: 0 };
    r.value()
}

fn get(o: ref JValue, key: Str) -> Option[JValue] {
    if let JValue.Obj(items) = o {
        for (k, v) in items.iter() {
            if k == key {
                return Some(v.clone());
            }
        }
    }
    None
}


// ------------------------------------------------------------ bytes and str

// Python reads robots.txt as `raw.decode("utf-8", "surrogateescape")`: a
// byte that is not part of valid UTF-8 becomes the lone surrogate
// U+DC80..U+DCFF, and encoding with "surrogateescape" turns it back into
// the byte. A Kāra String holds only scalar values, so such a byte is
// kept as the private-use code point U+10FF00 + byte instead. None of the
// test files uses those code points for anything else.
fn escape_char(b: u8) -> char {
    char.try_from(0x10FF00 + b as i64).unwrap_or('?')
}

fn escaped_byte(c: char) -> i64 {
    let o = c as i64;
    if o >= 0x10FF00 { o - 0x10FF00 } else { -1 }
}

fn is_cont(b: ref Vec[u8], i: i64, lo: u8, hi: u8) -> bool {
    i < b.len() and b[i] >= lo and b[i] <= hi
}

// The length of the valid UTF-8 sequence at b[i], or 0.
fn utf8_len(b: ref Vec[u8], i: i64) -> i64 {
    let c = b[i];
    if c < 0x80 {
        return 1;
    }
    if c >= 0xC2 and c <= 0xDF {
        return if is_cont(b, i + 1, 0x80, 0xBF) { 2 } else { 0 };
    }
    if c >= 0xE0 and c <= 0xEF {
        let lo: u8 = if c == 0xE0 { 0xA0 } else { 0x80 };
        let hi: u8 = if c == 0xED { 0x9F } else { 0xBF };
        return if is_cont(b, i + 1, lo, hi) and is_cont(b, i + 2, 0x80, 0xBF) { 3 } else { 0 };
    }
    if c >= 0xF0 and c <= 0xF4 {
        let lo: u8 = if c == 0xF0 { 0x90 } else { 0x80 };
        let hi: u8 = if c == 0xF4 { 0x8F } else { 0xBF };
        if is_cont(b, i + 1, lo, hi) and is_cont(b, i + 2, 0x80, 0xBF) and is_cont(b, i + 3, 0x80, 0xBF) {
            return 4;
        }
    }
    0
}

// bytes.decode("utf-8", "surrogateescape")
fn decode_escaped(b: ref Vec[u8]) -> String {
    let mut out = String.new();
    let mut i = 0;
    while i < b.len() {
        let n = utf8_len(b, i);
        if n == 0 {
            out.push(escape_char(b[i]));
            i += 1;
            continue;
        }
        let mut cp = if n == 1 {
            b[i] as i64
        } else if n == 2 {
            b[i] as i64 & 0x1F
        } else if n == 3 {
            b[i] as i64 & 0x0F
        } else {
            b[i] as i64 & 0x07
        };
        for k in 1..n {
            cp = cp * 64 + (b[i + k] as i64 & 0x3F);
        }
        out.push(char.try_from(cp).unwrap_or('?'));
        i += n;
    }
    out
}

// str.encode("utf-8", "surrogateescape")
fn encode_escaped(s: ref String) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for c in s.chars() {
        let e = escaped_byte(c);
        if e >= 0 {
            out.push(e as u8);
        } else {
            push_utf8(mut out, c as u32);
        }
    }
    out
}

fn py_lower(s: ref String) -> String {
    s.to_lowercase()
}

fn has(v: ref Vec[String], s: ref String) -> bool {
    for x in v.iter() {
        if x == s {
            return true;
        }
    }
    false
}

// The zero of each run of ten decimal digits that str.isdecimal() and
// int() accept, for the scripts the test files use and their neighbours.
fn digit_value(c: char) -> i64 {
    let o = c as i64;
    let zeros = [0x30, 0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xE50,
        0xED0, 0xF20, 0x1040, 0x17E0, 0x1810, 0xFF10];
    for z in zeros.iter() {
        if o >= *z and o < *z + 10 {
            return o - *z;
        }
    }
    -1
}

// s.isdecimal(), and then int(s) as decimal text without leading zeros.
// int() may be any size, so the value stays text.
fn py_decimal(s: ref String) -> Option[String] {
    if s.is_empty() {
        return None;
    }
    let mut out = String.new();
    for c in s.chars() {
        let d = digit_value(c);
        if d < 0 {
            return None;
        }
        if not (out.is_empty() and d == 0) {
            out.push(char.try_from(48 + d).unwrap_or('?'));
        }
    }
    if out.is_empty() {
        out.push('0');
    }
    Some(out)
}

// ------------------------------------------------------------ urllib.parse

fn is_safe(b: u8) -> bool {
    (b >= b'a' and b <= b'z') or (b >= b'A' and b <= b'Z') or (b >= b'0' and b <= b'9') or b == b'_'
        or b == b'.' or b == b'-' or b == b'~' or b == b'/'
}

fn hex_nibble(b: u8) -> i64 {
    if b >= b'0' and b <= b'9' {
        (b - b'0') as i64
    } else if b >= b'a' and b <= b'f' {
        (b - b'a') as i64 + 10
    } else if b >= b'A' and b <= b'F' {
        (b - b'A') as i64 + 10
    } else {
        -1
    }
}

// quote(unquote(path, errors="surrogateescape"), errors="surrogateescape"),
// which comes out the same when done on the bytes: %XX escapes become
// bytes, then every byte outside letters, digits and "_.-~/" is escaped
// again in upper case.
fn normalize(path: ref String) -> String {
    let b = encode_escaped(path);
    let mut raw: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        if b[i] == b'%' and i + 2 < b.len() and hex_nibble(b[i + 1]) >= 0 and hex_nibble(b[i + 2]) >= 0 {
            raw.push((hex_nibble(b[i + 1]) * 16 + hex_nibble(b[i + 2])) as u8);
            i += 3;
        } else {
            raw.push(b[i]);
            i += 1;
        }
    }
    let hex = "0123456789ABCDEF".bytes();
    let mut out = String.new();
    for c in raw.iter() {
        if is_safe(*c) {
            out.push(char.try_from(*c as i64).unwrap_or('?'));
        } else {
            out.push('%');
            out.push(char.try_from(hex[(*c / 16) as i64] as i64).unwrap_or('?'));
            out.push(char.try_from(hex[(*c % 16) as i64] as i64).unwrap_or('?'));
        }
    }
    out
}

// re.sub(f"[^{stops}]+", lambda m: normalize(m[0]), s)
fn normalize_runs(s: ref String, stops: Str) -> String {
    let mut out = String.new();
    let mut run = String.new();
    for c in s.chars() {
        let mut stop = false;
        for t in stops.chars() {
            if c == t {
                stop = true;
            }
        }
        if stop {
            if not run.is_empty() {
                out.push_str(normalize(run));
                run = String.new();
            }
            out.push(c);
        } else {
            run.push(c);
        }
    }
    if not run.is_empty() {
        out.push_str(normalize(run));
    }
    out
}

fn normalize_uri(path: ref String) -> String {
    match path.split_once("?") {
        Some((p, q)) => f"{normalize(p.to_string())}?{normalize_runs(q.to_string(), "=&")}",
        None => normalize(path),
    }
}

fn normalize_pattern(path: ref String) -> String {
    match path.split_once("?") {
        Some((p, q)) => f"{normalize_runs(p.to_string(), "*$")}?{normalize_runs(q.to_string(), "=&*$")}",
        None => normalize_runs(path, "*$"),
    }
}

struct Split {
    scheme: String,
    netloc: String,
    path: String,
    query: String,
    fragment: String,
}

fn is_scheme_char(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '+' or c == '-'
        or c == '.'
}

// urlsplit(url) as Python 3.13 does it, for netlocs without brackets.
fn urlsplit(url: ref String) -> Result[Split, String] {
    let mut s = String.new();
    let mut lead = true;
    for c in url.chars() {
        if lead and (c as i64) <= 0x20 {
            continue;
        }
        lead = false;
        if c != '\t' and c != '\r' and c != '\n' {
            s.push(c);
        }
    }
    let mut scheme = String.new();
    if let Some(i) = s.find(":") {
        let first = s.chars().next().unwrap_or(' ');
        if i > 0 and ((first >= 'a' and first <= 'z') or (first >= 'A' and first <= 'Z')) {
            let mut ok = true;
            for c in s[..i].chars() {
                if not is_scheme_char(c) {
                    ok = false;
                }
            }
            if ok {
                scheme = py_lower(s[..i].to_string());
                s = s[i + 1..].to_string();
            }
        }
    }
    let mut netloc = String.new();
    if s.starts_with("//") {
        let mut delim = s.len();
        for d in ["/", "?", "#"] {
            if let Some(k) = s[2..].find(d.as_str()) {
                if k + 2 < delim {
                    delim = k + 2;
                }
            }
        }
        netloc = s[2..delim].to_string();
        s = s[delim..].to_string();
        if netloc.contains("[") != netloc.contains("]") {
            return Err("ValueError: Invalid IPv6 URL".to_string());
        }
    }
    let mut fragment = String.new();
    if let Some(k) = s.find("#") {
        fragment = s[k + 1..].to_string();
        s = s[..k].to_string();
    }
    let mut query = String.new();
    if let Some(k) = s.find("?") {
        query = s[k + 1..].to_string();
        s = s[..k].to_string();
    }
    Ok(Split { scheme: scheme, netloc: netloc, path: s, query: query, fragment: fragment })
}

// urlunsplit(("", "", path, query, fragment))
fn unsplit_path(path: ref String, query: ref String, fragment: ref String) -> String {
    let mut url = if path.starts_with("//") { f"//{path}" } else { path.clone() };
    if not query.is_empty() {
        url = f"{url}?{query}";
    }
    if not fragment.is_empty() {
        url = f"{url}#{fragment}";
    }
    url
}

// ------------------------------------------------------------ robotparser

#[derive(Clone)]
struct RuleLine {
    path: String,
    allowance: bool,
    fullmatch: bool,
}

// re.sub(r"[*]{2,}", "*", path), then re.sub(r"[$][$*]+", "$", path)
fn squeeze_marks(path: ref String) -> String {
    let mut once = String.new();
    let mut star = false;
    for c in path.chars() {
        if c == '*' {
            if not star {
                once.push(c);
            }
            star = true;
        } else {
            once.push(c);
            star = false;
        }
    }
    let mut out = String.new();
    let mut dollar = false;
    for c in once.chars() {
        if dollar and (c == '$' or c == '*') {
            continue;
        }
        dollar = c == '$';
        out.push(c);
    }
    out
}

// RuleLine(path, allowance); None where Python raises ValueError.
fn rule_line(raw: ref String, allow: bool) -> Option[RuleLine] {
    let mut allowance = allow;
    if raw.is_empty() and not allow {
        allowance = true;
    }
    let mut path = normalize_pattern(squeeze_marks(raw));
    let fullmatch = path.ends_with("$");
    while path.ends_with("$") {
        path = path[..path.len() - 1].to_string();
    }
    if path.contains("$") {
        return None;
    }
    Some(RuleLine { path: path, allowance: allowance, fullmatch: fullmatch })
}

// What re.compile(translate_pattern(path), re.DOTALL).match (or
// .fullmatch) finds: the first part must start the name; each middle
// part is `(?>.*?part)`, its first match after the last one, kept
// without backtracking; the last is `.*last`, greedy, so its last match
// (or, for fullmatch, a match ending the name). The end of the match, or
// -1.
fn wild_match(path: ref String, name: ref String, full: bool) -> i64 {
    let parts: Vec[Str] = path.split("*").collect();
    let first = parts[0];
    if not name.starts_with(first) {
        return -1;
    }
    let mut pos = first.len();
    let mut k = 1;
    while k + 1 < parts.len() {
        match name[pos..].find(parts[k]) {
            Some(at) => pos = pos + at + parts[k].len(),
            None => return -1,
        }
        k += 1;
    }
    let last = parts[parts.len() - 1];
    if full {
        if name.len() - pos >= last.len() and name.ends_with(last) {
            return name.len();
        }
        return -1;
    }
    if last.is_empty() {
        return name.len();
    }
    match name[pos..].rfind(last) {
        Some(at) => pos + at + last.len(),
        None => -1,
    }
}

// RuleLine.applies_to: the length matched plus one, or 0.
fn rule_applies(r: ref RuleLine, name: ref String) -> i64 {
    if r.path.contains("*") {
        let end = wild_match(r.path, name, r.fullmatch);
        return if end >= 0 { end + 1 } else { 0 };
    }
    if r.fullmatch {
        if name == r.path {
            return r.path.len() + 1;
        }
    } else if name.starts_with(r.path.as_str()) {
        return r.path.len() + 1;
    }
    0
}

fn rule_text(r: ref RuleLine) -> String {
    let kind = if r.allowance { "Allow" } else { "Disallow" };
    let end = if r.fullmatch { "$" } else { "" };
    f"{kind}: {r.path}{end}"
}

#[derive(Clone)]
struct RobotsEntry {
    useragents: Vec[String],
    rules: Vec[RuleLine],
    delay: Option[String],
    rate: Option[(String, String)],
}

fn new_entry() -> RobotsEntry {
    RobotsEntry { useragents: Vec.new(), rules: Vec.new(), delay: None, rate: None }
}

fn entry_text(e: ref RobotsEntry) -> String {
    if e.useragents.is_empty() {
        return String.new();
    }
    let mut lines: Vec[String] = Vec.new();
    for a in e.useragents.iter() {
        lines.push(f"User-agent: {a}");
    }
    if let Some(d) = e.delay.clone() {
        lines.push(f"Crawl-delay: {d}");
    }
    if let Some((n, s)) = e.rate.clone() {
        lines.push(f"Request-rate: {n}/{s}");
    }
    if e.rules.is_empty() {
        lines.push("Allow:".to_string());
    }
    for r in e.rules.iter() {
        lines.push(rule_text(r));
    }
    lines.join("\n")
}

// RobotsEntry.applies_to: an agent of the group is a substring of the product
// token, the part before the first "/", ignoring case.
fn entry_applies(e: ref RobotsEntry, useragent: ref String) -> bool {
    let token = match useragent.split_once("/") {
        Some((t, _)) => py_lower(t.to_string()),
        None => py_lower(useragent),
    };
    for agent in e.useragents.iter() {
        if agent != "*" and token.contains(py_lower(agent).as_str()) {
            return true;
        }
    }
    false
}

fn entry_allowance(e: ref RobotsEntry, name: ref String) -> bool {
    let mut best = -1;
    let mut allowance = true;
    for r in e.rules.iter() {
        let m = rule_applies(r, name);
        if m > 0 {
            if m > best {
                best = m;
                allowance = r.allowance;
            } else if m == best and not allowance {
                allowance = r.allowance;
            }
        }
    }
    allowance
}

// merge_entries: the agents of the first group that the second one also
// names (with the same case), and the rules of both.
fn merge_entries(e1: ref RobotsEntry, e2: ref RobotsEntry) -> RobotsEntry {
    let mut e = new_entry();
    for a in e1.useragents.iter() {
        if has(e2.useragents, a) {
            e.useragents.push(a.clone());
        }
    }
    for r in e1.rules.iter() {
        e.rules.push(r.clone());
    }
    for r in e2.rules.iter() {
        e.rules.push(r.clone());
    }
    e.delay = if e2.delay.is_none() { e1.delay.clone() } else { e2.delay.clone() };
    e.rate = if e2.rate.is_none() { e1.rate.clone() } else { e2.rate.clone() };
    e
}

#[derive(Clone)]
struct RobotFileParser {
    url: String,
    host: String,
    path: String,
    entries: Vec[RobotsEntry],
    groups: Vec[(String, RobotsEntry)],
    sitemaps: Vec[String],
    disallow_all: bool,
    allow_all: bool,
    last_checked: i64,
}

fn new_parser(url: ref String) -> Result[RobotFileParser, String] {
    let s = urlsplit(url)?;
    Ok(RobotFileParser {
        url: url.clone(),
        host: s.netloc,
        path: s.path,
        entries: Vec.new(),
        groups: Vec.new(),
        sitemaps: Vec.new(),
        disallow_all: false,
        allow_all: false,
        last_checked: 0,
    })
}

impl RobotFileParser {
    fn modified(mut ref self) {
        let now = SystemTime.now().since_epoch().as_ms();
        self.last_checked = if now > 0 { now } else { 1 };
    }

    fn add_entry(mut ref self, entry: ref RobotsEntry) {
        self.entries.push(entry.clone());
        for agent in entry.useragents.iter() {
            let key = py_lower(agent);
            let mut found = -1;
            for k in 0..self.groups.len() {
                if self.groups[k].0 == key {
                    found = k;
                }
            }
            if found < 0 {
                self.groups.push((key, entry.clone()));
            } else {
                let merged = merge_entries(self.groups[found].1, entry);
                self.groups[found] = (key, merged);
            }
        }
    }

    fn parse(mut ref self, lines: ref Vec[String]) {
        let mut state = 0;
        let mut entry = new_entry();
        self.modified();
        for raw in lines.iter() {
            let mut line = raw.clone();
            if let Some(i) = line.find("#") {
                line = line[..i].to_string();
            }
            line = py_strip(line);
            if line.is_empty() {
                continue;
            }
            let (field, value) = match line.split_once(":") {
                Some((f, v)) => (py_lower(py_strip(f.to_string())), py_strip(v.to_string())),
                None => continue,
            };
            if field == "user-agent" {
                if state == 2 {
                    self.add_entry(entry);
                    entry = new_entry();
                }
                entry.useragents.push(value);
                state = 1;
            } else if field == "disallow" or field == "allow" {
                if state != 0 {
                    state = 2;
                    if let Some(r) = rule_line(value, field == "allow") {
                        entry.rules.push(r);
                    }
                }
            } else if field == "crawl-delay" {
                if state != 0 {
                    if let Some(d) = py_decimal(py_strip(value)) {
                        entry.delay = Some(d);
                    }
                    state = 2;
                }
            } else if field == "request-rate" {
                if state != 0 {
                    let numbers: Vec[Str] = value.split("/").collect();
                    if numbers.len() == 2 {
                        let n = py_decimal(py_strip(numbers[0].to_string()));
                        let s = py_decimal(py_strip(numbers[1].to_string()));
                        if n.is_some() and s.is_some() {
                            entry.rate = Some((n.unwrap(), s.unwrap()));
                        }
                    }
                    state = 2;
                }
            } else if field == "sitemap" {
                self.sitemaps.push(value);
            }
        }
        if state != 0 {
            self.add_entry(entry);
        }
    }

    fn find_entry(ref self, useragent: ref String) -> Option[RobotsEntry] {
        let key = py_lower(useragent);
        for (k, e) in self.groups.iter() {
            if *k == key {
                return Some(e.clone());
            }
        }
        for (_, e) in self.groups.iter() {
            if entry_applies(e, useragent) {
                return Some(e.clone());
            }
        }
        for (k, e) in self.groups.iter() {
            if k == "*" {
                return Some(e.clone());
            }
        }
        None
    }

    fn can_fetch(ref self, useragent: ref String, url: ref String) -> Result[bool, String] {
        if self.disallow_all {
            return Ok(false);
        }
        if self.allow_all {
            return Ok(true);
        }
        if self.last_checked == 0 {
            return Ok(false);
        }
        let s = urlsplit(url)?;
        let mut name = normalize_uri(unsplit_path(s.path, s.query, s.fragment));
        if name.is_empty() {
            name = "/".to_string();
        }
        if name == "/robots.txt" {
            return Ok(true);
        }
        match self.find_entry(useragent) {
            Some(e) => Ok(entry_allowance(e, name)),
            None => Ok(true),
        }
    }

    fn crawl_delay(ref self, useragent: ref String) -> Option[String] {
        if self.last_checked == 0 {
            return None;
        }
        match self.find_entry(useragent) {
            Some(e) => e.delay,
            None => None,
        }
    }

    fn request_rate(ref self, useragent: ref String) -> Option[(String, String)] {
        if self.last_checked == 0 {
            return None;
        }
        match self.find_entry(useragent) {
            Some(e) => e.rate,
            None => None,
        }
    }

    fn text(ref self) -> String {
        let mut parts: Vec[String] = Vec.new();
        for e in self.entries.iter() {
            let t = entry_text(e);
            if not t.is_empty() {
                parts.push(t);
            }
        }
        parts.join("\n\n")
    }

    // read(), with urlopen replaced by the fake web of data/web/.
    fn read(mut ref self) -> Result[(), String] {
        let (status, body) = urlopen(self.url)?;
        if status == 401 or status == 403 {
            self.disallow_all = true;
        } else if status >= 400 and status < 500 {
            self.allow_all = true;
        } else if status >= 500 and status < 600 {
            self.disallow_all = true;
        } else {
            self.parse(splitlines(decode_escaped(body)));
        }
        Ok(())
    }
}

fn delay_repr(d: ref Option[String]) -> String {
    match d {
        Some(s) => s.clone(),
        None => "None".to_string(),
    }
}

fn rate_repr(r: ref Option[(String, String)]) -> String {
    match r {
        Some((n, s)) => f"RequestRate(requests={n}, seconds={s})",
        None => "None".to_string(),
    }
}

fn site_maps_repr(p: ref RobotFileParser) -> String {
    if p.sitemaps.is_empty() {
        return "None".to_string();
    }
    let items: Vec[String] = p.sitemaps.iter().map(|s| repr_str(s)).collect();
    f"[{items.join(", ")}]"
}

// ------------------------------------------------------------ the fake web

// What urlopen(url) would get from the sites under data/web/<host>/: a
// host without a directory does not resolve, /robots.txt is the host's
// robots.txt file (with the HTTP status in its status file, if there is
// one), and every other page is looked up, path and query, in
// pages.json. A missing page is a 404.
fn lookup(url: ref String) -> Result[(i64, Vec[u8]), String] {
    let parts = urlsplit(url)?;
    if parts.scheme.is_empty() {
        return Err(f"ValueError: unknown url type: {repr_str(url)}");
    }
    let dir = f"data/web/{parts.netloc}";
    if not fs.exists(dir.clone()) {
        return Err("URLError: <urlopen error [Errno -2] Name or service not known>".to_string());
    }
    let robots = f"{dir}/robots.txt";
    let status = f"{dir}/status";
    if parts.path == "/robots.txt" and (fs.exists(robots.clone()) or fs.exists(status.clone())) {
        if fs.exists(status.clone()) {
            let t = fs.read_to_string(status).unwrap_or(String.new());
            return Ok((i64.parse(py_strip(t)).unwrap_or(0), Vec.new()));
        }
        return match fs.read_bytes(robots) {
            Ok(b) => Ok((200, b)),
            Err(e) => Err(f"OSError: {e}"),
        };
    }
    let key = if parts.query.is_empty() { parts.path.clone() } else { f"{parts.path}?{parts.query}" };
    let pages = match fs.read_to_string(f"{dir}/pages.json") {
        Ok(t) => parse_json(t)?,
        Err(e) => return Err(f"OSError: {e}"),
    };
    if let JValue.List(items) = pages {
        for p in items.iter() {
            if let Some(JValue.Str(path)) = get(p, "path") {
                if path == key {
                    let code = match get(p, "status") {
                        Some(JValue.Int(n)) => n,
                        _ => 200,
                    };
                    let body = match get(p, "body") {
                        Some(JValue.Str(b)) => b.bytes().to_vec(),
                        _ => Vec.new(),
                    };
                    return Ok((code, body));
                }
            }
        }
    }
    Ok((404, "not found\n".bytes().to_vec()))
}

// urlopen() raises HTTPError for any status but 200; robotparser.read()
// catches it and looks at the code.
fn urlopen(url: ref String) -> Result[(i64, Vec[u8]), String] {
    lookup(url)
}

// ------------------------------------------------------------ the crawler

fn links_of(body: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut i = 0;
    loop {
        let at = match body[i..].find("href=\"") {
            Some(k) => i + k + 6,
            None => return out,
        };
        let end = match body[at..].find("\"") {
            Some(k) => at + k,
            None => return out,
        };
        out.push(body[at..end].to_string());
        i = end + 1;
    }
}

// Absolute links and links from the root are followed; relative ones and
// scheme-relative ones are not. The fragment is dropped.
fn resolve(base: ref String, raw: ref String) -> Option[String] {
    let link = match raw.find("#") {
        Some(k) => raw[..k].to_string(),
        None => raw.clone(),
    };
    if link.starts_with("http://") or link.starts_with("https://") {
        return Some(link);
    }
    if link.starts_with("//") or not link.starts_with("/") {
        return None;
    }
    Some(f"{base}{link}")
}

fn crawl(agent: ref String, start: ref Vec[String], limit: i64) -> Result[(), String] {
    println(f"  crawl as {repr_str(agent)}");
    let mut queue: Vec[String] = start.clone();
    let mut seen: Vec[String] = start.clone();
    let mut robots: Vec[(String, Option[RobotFileParser])] = Vec.new();
    let mut clock: Vec[(String, i64)] = Vec.new();
    let mut fetched = 0;
    let mut blocked = 0;
    let mut failed = 0;
    let mut elapsed = 0;
    let mut head = 0;
    while head < queue.len() and fetched < limit {
        let url = queue[head].clone();
        head += 1;
        let parts = urlsplit(url)?;
        let base = f"{parts.scheme}://{parts.netloc}";
        let mut known = -1;
        for k in 0..robots.len() {
            if robots[k].0 == base {
                known = k;
            }
        }
        if known < 0 {
            let mut rp = new_parser(f"{base}/robots.txt")?;
            match rp.read() {
                Ok(()) => {
                    let state = if rp.disallow_all {
                        "disallow all".to_string()
                    } else if rp.allow_all {
                        "allow all".to_string()
                    } else {
                        f"{rp.entries.len()} groups"
                    };
                    println(f"  robots {base}: {state}, delay {delay_repr(rp.crawl_delay(agent))}, rate {rate_repr(rp.request_rate(agent))}, sitemaps {site_maps_repr(rp)}");
                    robots.push((base.clone(), Some(rp)));
                }
                Err(e) => {
                    println(f"  robots {base}: {e}");
                    robots.push((base.clone(), None));
                }
            }
            known = robots.len() - 1;
        }
        let rp = match robots[known].1.clone() {
            Some(p) => p,
            None => {
                println(f"  skip {url}");
                failed += 1;
                continue;
            }
        };
        if not rp.can_fetch(agent, url)? {
            println(f"  blocked {url}");
            blocked += 1;
            continue;
        }
        let delay = match rp.crawl_delay(agent) {
            Some(d) => i64.parse(d).unwrap_or(0),
            None => 0,
        };
        let mut last = -1;
        for k in 0..clock.len() {
            if clock[k].0 == base {
                last = k;
            }
        }
        if last >= 0 and delay != 0 {
            let wait = clock[last].1 + delay - elapsed;
            if wait > 0 {
                println(f"  wait {wait}s");
                elapsed += wait;
            }
        }
        if last >= 0 {
            clock[last] = (base.clone(), elapsed);
        } else {
            clock.push((base.clone(), elapsed));
        }
        let (status, body) = lookup(url)?;
        fetched += 1;
        if status != 200 {
            println(f"  get {url}: {status}");
            continue;
        }
        let page = String.from_utf8(body).unwrap_or(String.new());
        let mut found = 0;
        for l in links_of(page) {
            if let Some(u) = resolve(base, l) {
                if not has(seen, u) {
                    seen.push(u.clone());
                    queue.push(u);
                    found += 1;
                }
            }
        }
        println(f"  get {url}: 200, {found} new links");
    }
    println(f"  {fetched} fetched, {blocked} blocked, {failed} skipped, {queue.len() - head} left, {elapsed}s waited");
    Ok(())
}

// ------------------------------------------------------------ jobs

fn strings_of(j: ref JValue, key: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    if let Some(JValue.List(items)) = get(j, key) {
        for it in items.iter() {
            if let JValue.Str(s) = it {
                out.push(s.clone());
            }
        }
    }
    out
}

fn string_of(j: ref JValue, key: Str) -> String {
    match get(j, key) {
        Some(JValue.Str(s)) => s,
        _ => String.new(),
    }
}

fn show(p: ref RobotFileParser, agents: ref Vec[String]) {
    println("  str:");
    for line in p.text().split("\n") {
        if line.is_empty() {
            println("");
        } else {
            println(f"    {line}");
        }
    }
    println(f"  site_maps: {site_maps_repr(p)}");
    let title = |b: bool| if b { "True" } else { "False" };
    println(f"  disallow_all={title(p.disallow_all)} allow_all={title(p.allow_all)} read={title(p.last_checked != 0)}");
    for a in agents.iter() {
        println(f"  {repr_str(a)}: delay {delay_repr(p.crawl_delay(a))}, rate {rate_repr(p.request_rate(a))}");
    }
}

fn check(p: ref RobotFileParser, agents: ref Vec[String], urls: ref Vec[String]) {
    for a in agents.iter() {
        let mut row = String.new();
        for u in urls.iter() {
            match p.can_fetch(a, u) {
                Ok(true) => row.push('Y'),
                Ok(false) => row.push('n'),
                Err(e) => {
                    row.push('!');
                    println(f"  {repr_str(a)} {repr_str(u)}: {e}");
                }
            }
        }
        println(f"  {repr_str(a)}: {row}");
    }
}

fn store(parsers: mut ref Vec[(String, RobotFileParser)], name: ref String, p: own RobotFileParser) {
    for k in 0..parsers.len() {
        if parsers[k].0 == *name {
            parsers[k] = (name.clone(), p);
            return;
        }
    }
    parsers.push((name.clone(), p));
}

fn find_parser(parsers: ref Vec[(String, RobotFileParser)], name: ref String) -> Result[RobotFileParser, String] {
    for (k, p) in parsers.iter() {
        if k == name {
            return Ok(p.clone());
        }
    }
    Err(f"KeyError: {repr_str(name)}")
}

fn run_job(parsers: mut ref Vec[(String, RobotFileParser)], j: ref JValue) -> Result[bool, String] {
    let kind = string_of(j, "kind");
    let name = string_of(j, "name");
    if kind == "new" {
        let p = new_parser(string_of(j, "url"))?;
        store(mut parsers, name, p);
    } else if kind == "load" {
        let mut p = new_parser(string_of(j, "url"))?;
        let r = p.read();
        store(mut parsers, name, p);
        r?;
    } else if kind == "parse" {
        let mut p = new_parser(String.new())?;
        let raw = match fs.read_bytes(f"data/{string_of(j, "file")}") {
            Ok(b) => b,
            Err(e) => return Err(f"OSError: {e}"),
        };
        p.parse(splitlines(decode_escaped(raw)));
        store(mut parsers, name, p);
    } else if kind == "show" {
        show(find_parser(parsers, name)?, strings_of(j, "agents"));
        return Ok(false);
    } else if kind == "check" {
        check(find_parser(parsers, name)?, strings_of(j, "agents"), strings_of(j, "urls"));
        return Ok(false);
    } else if kind == "crawl" {
        let limit = match get(j, "max") {
            Some(JValue.Int(n)) => n,
            _ => 0,
        };
        crawl(string_of(j, "agent"), strings_of(j, "start"), limit)?;
        return Ok(false);
    }
    Ok(true)
}

// ------------------------------------------------------------ data

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push((hex_nibble(b[i]) * 16 + hex_nibble(b[i + 1])) as u8);
        i += 2;
    }
    out
}

fn write_data() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    let jobs = match fs.read_to_string("data/jobs.jsonl".to_string()) {
        Ok(t) => t,
        Err(e) => {
            eprintln(f"cannot read jobs.jsonl: {e}");
            return;
        }
    };
    let mut parsers: Vec[(String, RobotFileParser)] = Vec.new();
    for line in jobs.lines() {
        println(f"== {line}");
        let j = match parse_json(line.to_string()) {
            Ok(v) => v,
            Err(e) => {
                println(f"  bad job: {e}");
                continue;
            }
        };
        match run_job(mut parsers, j) {
            Ok(true) => println("  ok"),
            Ok(false) => {}
            Err(e) => println(f"  {e}"),
        }
    }
}
// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    v
}

