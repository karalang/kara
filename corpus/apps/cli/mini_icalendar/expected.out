== field_journal.ics
calendars: 1
VCALENDAR
  VERSION vText '2.0'
  PRODID vText '-//Example//Field Notes 1.4//EN'
  VJOURNAL
    UID vText 'journal-2026-10-03@example.org'
    DTSTAMP vDDDTypes 2026-10-03 20:15:00 UTC
    DTSTART {'VALUE': 'DATE'} vDDDTypes 2026-10-03
    SUMMARY vText 'Site visit: Montmartre'
    DESCRIPTION vText 'Walked the route twice.\nNotes:\n1) Stairs at Rue Foyatier are steep; avoid with equipment.\n2) Café on the corner opens at 07:30.\n3) Backup route via the funicular.'
    DESCRIPTION {'LANGUAGE': 'fr'} vText 'Itinéraire parcouru deux fois.'
    GEO vGeo (48.886705, 2.343104)
    RESOURCES vText 'Camera,Tripod'
    COMMENT vText '日本語のメモ: 坂道が多いので、機材は少なめにすること。雨の日は滑りやすい。🙂 Bring a spare battery and the long lens.'
    COMMENT vText 'Second comment, a long one that keeps going so that it must be folded at least once when it is written back out to a file.'
    ATTACH vUri 'https://files.example.org/visits/montmartre/route.gpx'
    ATTACH {'FMTTYPE': 'image/jpeg'} vUri 'https://files.example.org/visits/montmartre/IMG_0412.jpg'
    RELATED-TO {'RELTYPE': 'PARENT'} vText 'project-paris-2026@example.org'
    REQUEST-STATUS vText '2.0;Success'
    URL {'VALUE': 'URI'} vUri 'https://notes.example.org/j/2026-10-03'
    X-SCORE {'VALUE': 'FLOAT'} vFloat 4.25
    X-RATING {'VALUE': 'INTEGER'} vInt 7
    X-WEATHER {'X-SOURCE': 'https://weather.example.org/api?q=paris', 'UNITS': 'metric'} vUnknown '12C\\, light rain'
    X-ESCAPED-PARAM {'X-NOTE': 'a,b;c'} vUnknown 'value'
    X-CARET {'X-TITLE': 'Line one\nLine "two" ^ok'} vUnknown 'caret escapes'
    CLASS vText 'PRIVATE'
written:
