// mini_icalendar: a port of icalendar 7.3.0 (BSD, see
// LICENSE-icalendar.rst), the Python library most tools use to read and
// write .ics files: calendar exports, meeting invitations, task lists,
// free/busy replies and CalDAV data.
//
// - content lines: unfolding (with icalendar's handling of blank lines
//   inside a fold), splitting into name, parameters and value with
//   quoting and backslash escapes, the lenient whitespace rules, RFC 6868
//   caret escapes in parameters, and every error message;
// - components: the parser's stack, which components forgive bad lines
//   and bad values (VEVENT, and X- properties anywhere), the broken
//   properties it keeps, and the second pass when a VTIMEZONE comes
//   after an event that uses it;
// - value types: text, URIs, calendar addresses, dates, date-times,
//   times, durations, periods, date lists, recurrence rules, UTC offsets,
//   integers, floats, booleans, GEO, categories and base64 binaries,
//   chosen by property name and VALUE parameter as icalendar chooses;
// - time zones: TZIDs looked up in the tz database (data/tz/zones.txt),
//   through Windows zone names, by stripping a vendor prefix, or from a
//   VTIMEZONE in an earlier calendar;
// - writing: icalendar's property order, parameter quoting, escaping
//   and folding at 75 octets.
//
// The run writes data/ (calendar files from mk.py), then reads each one,
// prints its components with each value and its type, the errors
// icalendar keeps, the file written back out, and whether reading that
// again gives the same text. expected.out is the output of oracle.py,
// which does the same through icalendar itself.

// ---------------------------------------------------------------- errors

#[derive(Clone)]
struct PyErr {
    kind: String,
    msg: String,
}

fn value_error(msg: own String) -> PyErr {
    PyErr { kind: "ValueError".to_string(), msg: msg }
}

// ---------------------------------------------------------------- text

// Texts are kept as characters, as Python indexes them.
fn chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn text(v: ref Vec[char]) -> String {
    let mut s = String.new();
    for c in v.iter() {
        s.push(*c);
    }
    s
}

fn lit(s: Str) -> Vec[char] {
    s.chars().collect()
}

// v[lo:hi], clamped the way Python clamps a slice
fn sl(v: ref Vec[char], lo: i64, hi: i64) -> Vec[char] {
    let n = v.len();
    let a = if lo < 0 { 0 } else if lo > n { n } else { lo };
    let b = if hi < 0 { 0 } else if hi > n { n } else { hi };
    let mut out: Vec[char] = Vec.new();
    let mut i = a;
    while i < b {
        out.push(v[i]);
        i += 1;
    }
    out
}

fn from_(v: ref Vec[char], lo: i64) -> Vec[char] {
    sl(v, lo, v.len())
}

fn upto(v: ref Vec[char], hi: i64) -> Vec[char] {
    sl(v, 0, hi)
}

// v[-n:] (all of v when n is 0, as in Python)
fn last_n(v: ref Vec[char], n: i64) -> Vec[char] {
    if n == 0 { v.clone() } else { sl(v, v.len() - n, v.len()) }
}

fn cat(a: ref Vec[char], b: ref Vec[char]) -> Vec[char] {
    let mut out = a.clone();
    for c in b.iter() {
        out.push(*c);
    }
    out
}

fn cat3(a: ref Vec[char], b: ref Vec[char], c: ref Vec[char]) -> Vec[char] {
    let mut out = cat(a, b);
    for x in c.iter() {
        out.push(*x);
    }
    out
}

fn same(a: ref Vec[char], b: ref Vec[char]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    true
}

fn match_at(v: ref Vec[char], i: i64, pat: ref Vec[char]) -> bool {
    if i < 0 or i + pat.len() > v.len() {
        return false;
    }
    for j in 0..pat.len() {
        if v[i + j] != pat[j] {
            return false;
        }
    }
    true
}

// str.find(sub, start)
fn find_from(v: ref Vec[char], pat: ref Vec[char], start: i64) -> i64 {
    let s = if start < 0 { 0 } else { start };
    if s > v.len() {
        return -1;
    }
    let mut i = s;
    while i + pat.len() <= v.len() {
        if match_at(v, i, pat) {
            return i;
        }
        i += 1;
    }
    -1
}

fn find(v: ref Vec[char], pat: ref Vec[char]) -> i64 {
    find_from(v, pat, 0)
}

// str.rfind(sub, start)
fn rfind_from(v: ref Vec[char], pat: ref Vec[char], start: i64) -> i64 {
    let s = if start < 0 { 0 } else { start };
    if s > v.len() {
        return -1;
    }
    let mut i = v.len() - pat.len();
    while i >= s {
        if match_at(v, i, pat) {
            return i;
        }
        i -= 1;
    }
    -1
}

fn starts_with_v(v: ref Vec[char], p: ref Vec[char]) -> bool {
    match_at(v, 0, p)
}

fn ends_with_v(v: ref Vec[char], p: ref Vec[char]) -> bool {
    match_at(v, v.len() - p.len(), p)
}

fn hex2(n: i64) -> String {
    let digits: Vec[char] = "0123456789abcdef".chars().collect();
    let mut s = String.new();
    s.push(digits[n / 16]);
    s.push(digits[n % 16]);
    s
}

fn hex_upper(n: i64) -> String {
    let digits: Vec[char] = "0123456789ABCDEF".chars().collect();
    let mut s = String.new();
    s.push(digits[n / 16]);
    s.push(digits[n % 16]);
    s
}

// repr() of a str
fn py_repr(v: ref Vec[char]) -> String {
    let mut has_sq = false;
    let mut has_dq = false;
    for c in v.iter() {
        if *c == '\'' {
            has_sq = true;
        }
        if *c == '"' {
            has_dq = true;
        }
    }
    let q = if has_sq and not has_dq { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c0 in v.iter() {
        let c = *c0;
        let o = c as i64;
        if c == '\\' {
            out.push_str("\\\\");
        } else if c == q {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if o < 32 or (o >= 127 and o <= 0xA0) or o == 0xAD {
            out.push_str("\\x");
            out.push_str(hex2(o));
        } else {
            out.push(c);
        }
    }
    out.push(q);
    out
}

fn py_bool(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

fn bool_list(v: ref Vec[bool]) -> String {
    let mut out = String.new();
    out.push('[');
    for i in 0..v.len() {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(py_bool(v[i]));
    }
    out.push(']');
    out
}

// ---------------------------------------------------------------- str methods

fn is_py_space(c: char) -> bool {
    let o = c as i64;
    (o >= 9 and o <= 13) or (o >= 0x1C and o <= 0x20) or o == 0x85 or o == 0xA0 or o == 0x1680
        or (o >= 0x2000 and o <= 0x200A) or o == 0x2028 or o == 0x2029 or o == 0x202F or o == 0x205F or o == 0x3000
}

// str.isalnum() on one character: ASCII letters and digits, and the
// letters and digits beyond ASCII, which here means everything but
// spaces, Latin-1 and general punctuation, currency signs, arrows,
// symbols and emoji.
fn is_py_alnum(c: char) -> bool {
    let o = c as i64;
    if o < 128 {
        return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9');
    }
    if is_py_space(c) {
        return false;
    }
    if o < 0xC0 {
        return o == 0xAA or o == 0xB2 or o == 0xB3 or o == 0xB5 or o == 0xB9 or o == 0xBA or (o >= 0xBC and o <= 0xBE);
    }
    if o == 0xD7 or o == 0xF7 {
        return false;
    }
    if (o >= 0x2000 and o <= 0x2BFF) or (o >= 0x3000 and o <= 0x303F) or (o >= 0x1F000 and o <= 0x1FAFF) or (o >= 0xFE00 and o <= 0xFE0F) {
        return false;
    }
    true
}


// str.strip() with no argument
fn py_strip(v: ref Vec[char]) -> Vec[char] {
    let mut a = 0;
    let mut b = v.len();
    while a < b and is_py_space(v[a]) {
        a += 1;
    }
    while b > a and is_py_space(v[b - 1]) {
        b -= 1;
    }
    sl(v, a, b)
}

fn upper_v(v: ref Vec[char]) -> Vec[char] {
    chars(text(v).to_uppercase())
}

fn upper_s(s: ref String) -> String {
    s.to_uppercase()
}

fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn all_digits(v: ref Vec[char]) -> bool {
    if v.len() == 0 {
        return false;
    }
    for c in v.iter() {
        if not is_digit(*c) {
            return false;
        }
    }
    true
}

// The digits of an int() literal: surrounding whitespace, a sign, and
// digits with single underscores between them. Big values keep their
// digits, for messages that print them.
struct PyInt {
    value: i64,
    digits: String,
    big: bool,
}

fn py_int_v(s0: ref Vec[char]) -> Option[PyInt] {
    let s = py_strip(s0);
    let mut i = 0;
    let mut neg = false;
    if i < s.len() and (s[i] == '+' or s[i] == '-') {
        neg = s[i] == '-';
        i += 1;
    }
    if i >= s.len() or not is_digit(s[i]) {
        return None;
    }
    let mut ds: Vec[char] = Vec.new();
    while i < s.len() {
        if is_digit(s[i]) {
            ds.push(s[i]);
        } else if s[i] == '_' and i + 1 < s.len() and is_digit(s[i + 1]) and is_digit(s[i - 1]) {
        } else {
            return None;
        }
        i += 1;
    }
    let mut k = 0;
    while k + 1 < ds.len() and ds[k] == '0' {
        k += 1;
    }
    let ds2 = from_(ds, k);
    let big = ds2.len() > 18;
    let mut v = 0;
    if not big {
        for c in ds2.iter() {
            v = v * 10 + ((*c as i64) - 48);
        }
    }
    let zero = ds2.len() == 1 and ds2[0] == '0';
    let sign = if neg and not zero { "-" } else { "" };
    Some(PyInt { value: if neg { 0 - v } else { v }, digits: f"{sign}{text(ds2)}", big: big })
}

fn py_int_s(s: ref String) -> Option[PyInt] {
    py_int_v(chars(s))
}

// float(): whitespace, a sign, digits with underscores, a point and an
// exponent, or inf, infinity and nan in any case
fn py_float_v(s0: ref Vec[char]) -> Option[f64] {
    let s = py_strip(s0);
    let mut i = 0;
    let mut neg = false;
    if i < s.len() and (s[i] == '+' or s[i] == '-') {
        neg = s[i] == '-';
        i += 1;
    }
    let rest = text(from_(s, i)).to_lowercase();
    if rest == "inf" or rest == "infinity" {
        return Some(if neg { -1.0 / 0.0 } else { 1.0 / 0.0 });
    }
    if rest == "nan" {
        return Some(0.0 / 0.0);
    }
    let mut int_part = String.new();
    let mut frac = String.new();
    let mut exp = String.new();
    let mut seen_digit = false;
    // digits with single underscores between them
    let mut prev_digit = false;
    while i < s.len() and (is_digit(s[i]) or s[i] == '_') {
        if s[i] == '_' {
            if not prev_digit or i + 1 >= s.len() or not is_digit(s[i + 1]) {
                return None;
            }
        } else {
            int_part.push(s[i]);
            seen_digit = true;
        }
        prev_digit = s[i] != '_';
        i += 1;
    }
    if i < s.len() and s[i] == '.' {
        i += 1;
        prev_digit = false;
        while i < s.len() and (is_digit(s[i]) or s[i] == '_') {
            if s[i] == '_' {
                if not prev_digit or i + 1 >= s.len() or not is_digit(s[i + 1]) {
                    return None;
                }
            } else {
                frac.push(s[i]);
                seen_digit = true;
            }
            prev_digit = s[i] != '_';
            i += 1;
        }
    }
    if not seen_digit {
        return None;
    }
    if i < s.len() and (s[i] == 'e' or s[i] == 'E') {
        i += 1;
        if i < s.len() and (s[i] == '+' or s[i] == '-') {
            exp.push(s[i]);
            i += 1;
        }
        let mut n = 0;
        while i < s.len() and is_digit(s[i]) {
            exp.push(s[i]);
            n += 1;
            i += 1;
        }
        if n == 0 {
            return None;
        }
    }
    if i != s.len() {
        return None;
    }
    let ip = if int_part.len() == 0 { "0".to_string() } else { int_part };
    let fp = if frac.len() == 0 { "0".to_string() } else { frac };
    let lit = if exp.len() > 0 { f"{ip}.{fp}e{exp}" } else { f"{ip}.{fp}" };
    match f64.parse(lit) {
        Ok(v) => Some(if neg { -v } else { v }),
        Err(_) => None,
    }
}

fn is_finite(x: f64) -> bool {
    x == x and x != 1.0 / 0.0 and x != -1.0 / 0.0
}

// repr() of a float
fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    if x == 1.0 / 0.0 {
        return "inf".to_string();
    }
    if x == -1.0 / 0.0 {
        return "-inf".to_string();
    }
    f"{x}"
}

// repr() of bytes
fn bytes_repr(b: ref Vec[i64]) -> String {
    let mut has_sq = false;
    let mut has_dq = false;
    for x in b.iter() {
        if *x == 39 {
            has_sq = true;
        }
        if *x == 34 {
            has_dq = true;
        }
    }
    let q = if has_sq and not has_dq { 34 } else { 39 };
    let mut out = String.new();
    out.push('b');
    out.push(char.try_from(q as u32).unwrap());
    for x0 in b.iter() {
        let x = *x0;
        if x == 92 {
            out.push_str("\\\\");
        } else if x == q {
            out.push('\\');
            out.push(char.try_from(q as u32).unwrap());
        } else if x == 10 {
            out.push_str("\\n");
        } else if x == 13 {
            out.push_str("\\r");
        } else if x == 9 {
            out.push_str("\\t");
        } else if x < 32 or x >= 127 {
            out.push_str("\\x");
            out.push_str(hex2(x));
        } else {
            out.push(char.try_from(x as u32).unwrap());
        }
    }
    out.push(char.try_from(q as u32).unwrap());
    out
}

fn utf8_bytes(v: ref Vec[char]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in v.iter() {
        let o = *c as i64;
        if o < 0x80 {
            out.push(o);
        } else if o < 0x800 {
            out.push(0xC0 + o / 64);
            out.push(0x80 + o % 64);
        } else if o < 0x10000 {
            out.push(0xE0 + o / 4096);
            out.push(0x80 + (o / 64) % 64);
            out.push(0x80 + o % 64);
        } else {
            out.push(0xF0 + o / 262144);
            out.push(0x80 + (o / 4096) % 64);
            out.push(0x80 + (o / 64) % 64);
            out.push(0x80 + o % 64);
        }
    }
    out
}

fn utf8_len(c: char) -> i64 {
    let o = c as i64;
    if o < 0x80 { 1 } else if o < 0x800 { 2 } else if o < 0x10000 { 3 } else { 4 }
}

// ---------------------------------------------------------------- base64

const BASE64_ALPHABET: Str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

fn b64_index(c: char) -> i64 {
    if c >= 'A' and c <= 'Z' {
        (c as i64) - 65
    } else if c >= 'a' and c <= 'z' {
        (c as i64) - 71
    } else if c >= '0' and c <= '9' {
        (c as i64) + 4
    } else if c == '+' {
        62
    } else if c == '/' {
        63
    } else {
        -1
    }
}

fn b64_encode(b: ref Vec[i64]) -> String {
    let tab: Vec[char] = BASE64_ALPHABET.chars().collect();
    let mut out = String.new();
    let mut i = 0;
    while i < b.len() {
        let n = if b.len() - i >= 3 { 3 } else { b.len() - i };
        let b0 = b[i];
        let b1 = if n > 1 { b[i + 1] } else { 0 };
        let b2 = if n > 2 { b[i + 2] } else { 0 };
        let v = b0 * 65536 + b1 * 256 + b2;
        out.push(tab[v / 262144]);
        out.push(tab[(v / 4096) % 64]);
        if n > 1 {
            out.push(tab[(v / 64) % 64]);
        } else {
            out.push('=');
        }
        if n > 2 {
            out.push(tab[v % 64]);
        } else {
            out.push('=');
        }
        i += 3;
    }
    out
}

// base64.b64decode(s, validate=True): only the alphabet, with the
// padding at the end and a length that is a multiple of four
fn b64_decode_strict(v: ref Vec[char]) -> Option[Vec[i64]] {
    let mut n = v.len();
    let mut pad = 0;
    while n > 0 and v[n - 1] == '=' and pad < 2 {
        n -= 1;
        pad += 1;
    }
    if v.len() % 4 != 0 {
        return None;
    }
    let mut vals: Vec[i64] = Vec.new();
    for i in 0..n {
        let k = b64_index(v[i]);
        if k < 0 {
            return None;
        }
        vals.push(k);
    }
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i + 4 <= vals.len() {
        let x = vals[i] * 262144 + vals[i + 1] * 4096 + vals[i + 2] * 64 + vals[i + 3];
        out.push(x / 65536);
        out.push((x / 256) % 256);
        out.push(x % 256);
        i += 4;
    }
    let left = vals.len() - i;
    if left == 2 {
        let x = vals[i] * 64 + vals[i + 1];
        out.push(x / 16);
    } else if left == 3 {
        let x = vals[i] * 4096 + vals[i + 1] * 64 + vals[i + 2];
        out.push(x / 1024);
        out.push((x / 4) % 256);
    } else if left == 1 {
        return None;
    }
    Some(out)
}
