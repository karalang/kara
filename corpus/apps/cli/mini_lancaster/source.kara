// mini_lancaster: NLTK's Lancaster (Paice/Husk) stemmer, the aggressive
// suffix stripper search indexes use to fold "connection", "connected" and
// "connecting" into one term, with its rule language (custom rule sets,
// intact-only rules, rules that stop or carry on), its optional prefix
// stripping, and a small inverted index over a few documents built on it.
// README.md is the spec; oracle.py is the reference.

import std.encoding.hex_decode;

// ------------------------------------------------------------ rules

/// One rule, as `^([a-z]+)(\*?)(\d)([a-z]*)([>.]?)$` takes it apart: the
/// ending (written reversed in the rule), whether the word must be intact,
/// how many characters to remove, what to append, and whether to stop.
struct Rule {
    ending: String,
    intact: bool,
    remove: i64,
    append: String,
    stop: bool,
}

fn is_rule_letter(c: char) -> bool {
    c >= 'a' and c <= 'z'
}

/// The rule `text` stands for, or `None` when it is not a rule.
fn parse_rule(text: Str) -> Option[Rule] {
    let cs: Vec[char] = text.chars().collect();
    let mut i = 0;
    let mut reversed = String.new();
    while i < cs.len() and is_rule_letter(cs[i]) {
        reversed.push(cs[i]);
        i += 1;
    }
    if reversed.is_empty() {
        return None;
    }
    let intact = i < cs.len() and cs[i] == '*';
    if intact {
        i += 1;
    }
    if i >= cs.len() or not cs[i].is_ascii_digit() {
        return None;
    }
    let remove = (cs[i] as i64) - ('0' as i64);
    i += 1;
    let mut append = String.new();
    while i < cs.len() and is_rule_letter(cs[i]) {
        append.push(cs[i]);
        i += 1;
    }
    let mut stop = false;
    if i < cs.len() and (cs[i] == '>' or cs[i] == '.') {
        stop = cs[i] == '.';
        i += 1;
    }
    if i != cs.len() {
        return None;
    }
    let ending: String = reversed.chars().rev().collect();
    Some(Rule { ending, intact, remove, append, stop })
}

/// The module's default rule tuple, in its order.
fn default_rules() -> Vec[String] {
    let text = """
ai*2. a*1. bb1. city3s. ci2> cn1t> dd1. dei3y> deec2ss. dee1. de2> dooh4>
e1> feil1v. fi2> gni3> gai3y. ga2> gg1. ht*2. hsiug5ct. hsi3> i*1. i1y>
ji1d. juf1s. ju1d. jo1d. jeh1r. jrev1t. jsim2t. jn1d. j1s. lbaifi6. lbai4y.
lba3> lbi3. lib2l> lc1. lufi4y. luf3> lu2. lai3> lau3> la2> ll1. mui3.
mu*2. msi3> mm1. nois4j> noix4ct. noi3> nai3> na2> nee0. ne2> nn1.
pihs4> pp1. re2> rae0. ra2. ro2> ru2> rr1. rt1> rei3y> sei3y> sis2. si2>
ssen4> ss0. suo3> su*2. s*1> s0. tacilp4y. ta2> tnem4> tne3> tna3>
tpir2b. tpro2b. tcud1. tpmus2. tpec2iv. tulo2v. tsis0. tsi3> tt1. uqi3.
ugo1. vis3j> vie0. vi2> ylb1> yli3y> ylp0. yl2> ygo1. yhp1. ymo1. ypo1.
yti3> yte3> ytl2. yrtsi5. yra3> yro3> yfi3. ycn2t> yca3> zi2> zy1s.
""";
    text.split_whitespace().map(|r| r.to_string()).collect()
}

// ------------------------------------------------------------ stemmer

/// The words longer than this are returned unstemmed (the module's
/// `MAX_WORD_LEN`), counted in characters.
const MAX_WORD_LEN: i64 = 1000;

const PREFIXES: Array[Str, 9] = [
    "kilo", "micro", "milli", "intra", "ultra", "mega", "nano", "pico", "pseudo",
];

struct Stemmer {
    rules: Vec[String],
    table: SortedMap[char, Vec[Rule]],
    strip_prefix: bool,
}

fn is_stem_vowel(c: char) -> bool {
    "aeiouy".contains(c.to_string())
}

fn text_of(cs: Slice[char]) -> String {
    let mut s = String.new();
    for c in cs.iter() {
        s.push(*c);
    }
    s
}

fn ends_with_chars(word: Slice[char], ending: Str) -> bool {
    let tail: Vec[char] = ending.chars().collect();
    if tail.len() > word.len() {
        return false;
    }
    let start = word.len() - tail.len();
    for k in 0..tail.len() {
        if word[start + k] != tail[k] {
            return false;
        }
    }
    true
}

/// The index of the last letter of the word's leading run of letters, or
/// -1: the rules are looked up by that letter, not by the word's last one.
fn last_letter(word: Slice[char]) -> i64 {
    let mut last = -1;
    for k in 0..word.len() {
        if word[k].is_alphabetic() {
            last = k;
        } else {
            break;
        }
    }
    last
}

/// Whether `remove` characters may come off `word`: a word that starts
/// with a vowel keeps at least two, any other at least three with a vowel
/// in the second or third place.
fn acceptable(word: Slice[char], remove: i64) -> bool {
    let left = word.len() - remove;
    if is_stem_vowel(word[0]) {
        left >= 2
    } else if left >= 3 {
        is_stem_vowel(word[1]) or is_stem_vowel(word[2])
    } else {
        false
    }
}

impl Stemmer {
    /// A stemmer over `rules` (the default tuple when there are none), or
    /// the module's `ValueError` text for the first rule that is not one.
    fn new(rules: own Vec[String], strip_prefix: bool) -> Result[Stemmer, String] {
        let rules = if rules.is_empty() { default_rules() } else { rules };
        let mut table: SortedMap[char, Vec[Rule]] = SortedMap.new();
        for text in rules.iter() {
            let Some(rule) = parse_rule(text) else {
                return Err(f"ValueError: The rule {text} is invalid");
            };
            let first = text.chars().next().unwrap();
            if let Some(list) = table.get_mut(first) {
                list.push(rule);
            } else {
                table.insert(first, [rule]);
            }
        }
        Ok(Stemmer { rules, table, strip_prefix })
    }

    fn stem(ref self, word: Str) -> String {
        let mut w: Vec[char] = word.to_lowercase().chars().collect();
        if self.strip_prefix {
            for p in PREFIXES.iter() {
                let pc: Vec[char] = p.chars().collect();
                if w.len() >= pc.len() and w[0..pc.len()] == pc[..] {
                    w = w[pc.len()..].to_vec();
                    break;
                }
            }
        }
        if w.len() > MAX_WORD_LEN {
            return text_of(w);
        }
        let intact = w.clone();
        loop {
            let last = last_letter(w);
            if last < 0 {
                break;
            }
            let Some(rules) = self.table.get(w[last]) else {
                break;
            };
            let mut applied = false;
            let mut stop = false;
            for r in rules.iter() {
                if not ends_with_chars(w, r.ending) {
                    continue;
                }
                if r.intact and w != intact {
                    continue;
                }
                if acceptable(w, r.remove) {
                    w.truncate(w.len() - r.remove);
                    w.extend(r.append.chars());
                    applied = true;
                    stop = r.stop;
                    break;
                }
            }
            if not applied or stop {
                break;
            }
        }
        text_of(w)
    }
}

// ------------------------------------------------------------ index

/// What a token loses at either end.
const PUNCT: Str = ".,;:!?\"'()[]{}\u{ab}\u{bb}#";

fn tokens(text: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for t in text.split_whitespace() {
        let cs: Vec[char] = t.chars().collect();
        let mut a = 0;
        let mut b = cs.len();
        while a < b and PUNCT.contains(cs[a].to_string()) {
            a += 1;
        }
        while b > a and PUNCT.contains(cs[b - 1].to_string()) {
            b -= 1;
        }
        if a < b {
            out.push(text_of(cs[a..b]));
        }
    }
    out
}

/// One indexed document: how often each stem occurs in it, and the
/// lower-cased tokens that stemmed to it.
struct Doc {
    counts: Map[String, i64],
    forms: Map[String, Set[String]],
}

/// A count in a script line: one to six digits.
fn count(word: Str) -> Result[i64, String] {
    if word.is_empty() or word.len() > 6 or not word.chars().all(|c| c.is_ascii_digit()) {
        return Err(f"bad count {word}");
    }
    i64.parse(word).map_err(|_| f"bad count {word}")
}

/// The last `n` characters of `s`.
fn tail(s: Str, n: i64) -> String {
    let cs: Vec[char] = s.chars().collect();
    let from = if cs.len() > n { cs.len() - n } else { 0 };
    text_of(cs[from..])
}

// ------------------------------------------------------------ script

fn usage(cmd: Str) -> Option[String] {
    match cmd {
        "stem" => Some("usage: stem WORD..."),
        "stem-repeat" => Some("usage: stem-repeat PIECE COUNT"),
        "use" => Some("usage: use RULES [prefix]"),
        "index" => Some("usage: index DOC"),
        "classes" => Some("usage: classes [MIN]"),
        "top" => Some("usage: top COUNT"),
        "query" => Some("usage: query WORD..."),
        _ => None,
    }
}

struct Player {
    stemmer: Stemmer,
    docs: SortedMap[String, Doc],
}

impl Player {
    fn run(mut ref self, words: Slice[String]) -> Result[Vec[String], String] {
        let cmd = words[0].as_str();
        let Some(text) = usage(cmd) else {
            return Err(f"unknown command {cmd}");
        };
        let args = words[1..];
        let ok = match cmd {
            "stem" | "query" => args.len() >= 1,
            "classes" => args.len() <= 1,
            "use" => args.len() == 1 or (args.len() == 2 and args[1] == "prefix"),
            _ => args.len() == text.split_whitespace().count() - 2,
        };
        if not ok {
            return Err(text);
        }
        match cmd {
            "stem" => Ok(args.iter().map(|w| f"{w} -> {self.stemmer.stem(w)}").collect()),
            "stem-repeat" => self.stem_repeat(args[0], args[1]),
            "use" => self.use_rules(args[0], args.len() == 2),
            "index" => self.index(args[0]),
            "classes" => self.classes(args),
            "top" => self.top(args[0]),
            _ => Ok(self.query(args)),
        }
    }

    fn stem_repeat(ref self, piece: Str, n: Str) -> Result[Vec[String], String] {
        let n = count(n)?;
        let mut word = String.new();
        for _ in 0..n {
            word.push_str(piece);
        }
        let s = self.stemmer.stem(word);
        let line = f"{piece} x {n}: {word.chars().count()} chars -> {s.chars().count()} chars, ending \"{tail(s, 8)}\"";
        Ok([line])
    }

    fn use_rules(mut ref self, name: Str, prefix: bool) -> Result[Vec[String], String] {
        let mut rules: Vec[String] = Vec.new();
        if name != "default" {
            let path = f"data/rules/{name}.rules";
            let Ok(body) = fs.read_to_string(path) else {
                return Err(f"no rules {path}");
            };
            for line in body.split("\n") {
                if not line.is_empty() and not line.starts_with("#") {
                    rules.push(line.to_string());
                }
            }
        }
        let st = Stemmer.new(rules, prefix)?;
        let how = if prefix { " with prefixes" } else { "" };
        let line = f"using {name}{how}: {st.rules.len()} rules under {st.table.len()} letters";
        self.stemmer = st;
        self.docs = SortedMap.new();
        Ok([line])
    }

    fn index(mut ref self, name: Str) -> Result[Vec[String], String] {
        let path = f"data/docs/{name}.txt";
        let Ok(body) = fs.read_to_string(path) else {
            return Err(f"no document {path}");
        };
        let toks = tokens(body);
        let mut doc = Doc { counts: Map.new(), forms: Map.new() };
        for t in toks.iter() {
            let s = self.stemmer.stem(t);
            let k = doc.counts.get(s) ?? 0;
            doc.counts.insert(s.clone(), k + 1);
            if let Some(set) = doc.forms.get_mut(s) {
                set.insert(t.to_lowercase());
            } else {
                let mut set: Set[String] = Set.new();
                set.insert(t.to_lowercase());
                doc.forms.insert(s, set);
            }
        }
        let line = f"indexed {name}: {toks.len()} tokens, {doc.counts.len()} stems";
        self.docs.insert(name.to_string(), doc);
        Ok([line])
    }

    fn classes(ref self, args: Slice[String]) -> Result[Vec[String], String] {
        let least = if args.is_empty() { 2 } else { count(args[0])? };
        let mut forms: SortedMap[String, SortedSet[String]] = SortedMap.new();
        for (_, doc) in self.docs.iter() {
            for (s, ws) in doc.forms.iter() {
                if not forms.contains_key(s) {
                    forms.insert(s.clone(), SortedSet.new());
                }
                let all = forms.get_mut(s).unwrap();
                for w in ws.iter() {
                    all.insert(w.clone());
                }
            }
        }
        let mut out: Vec[String] = Vec.new();
        for (s, ws) in forms.iter() {
            if ws.len() >= least {
                let list: Vec[String] = ws.iter().cloned().collect();
                out.push(f"{s}: {list.join(" ")}");
            }
        }
        if out.is_empty() {
            out.push("no classes".to_string());
        }
        Ok(out)
    }

    fn top(ref self, n: Str) -> Result[Vec[String], String] {
        let n = count(n)?;
        if self.docs.is_empty() {
            return Ok(["index is empty".to_string()]);
        }
        let mut totals: Map[String, i64] = Map.new();
        for (_, doc) in self.docs.iter() {
            for (s, k) in doc.counts.iter() {
                let t = totals.get(s) ?? 0;
                totals.insert(s.clone(), t + *k);
            }
        }
        let mut ranked: Vec[(i64, String)] = totals.iter().map(|(s, k)| (-*k, s.clone())).collect();
        ranked.sort();
        let mut out: Vec[String] = Vec.new();
        for (neg, s) in ranked.iter() {
            if out.len() >= n {
                break;
            }
            out.push(f"{s} {-neg}");
        }
        Ok(out)
    }

    fn query(ref self, args: Slice[String]) -> Vec[String] {
        let stems: Vec[String] = args.iter().map(|w| self.stemmer.stem(w)).collect();
        let mut hits: Vec[(i64, String)] = Vec.new();
        for (name, doc) in self.docs.iter() {
            if stems.iter().all(|s| doc.counts.contains_key(s)) {
                let mut score = 0;
                for s in stems.iter() {
                    score += doc.counts.get(s) ?? 0;
                }
                hits.push((-score, name.clone()));
            }
        }
        hits.sort();
        let mut out: Vec[String] = [f"stems: {stems.join(" ")}"];
        for (neg, name) in hits.iter() {
            out.push(f"{name} {-neg}");
        }
        if hits.is_empty() {
            out.push("no document matches".to_string());
        }
        out
    }
}

fn play(script: Str) -> Result[(), String] {
    let stemmer = Stemmer.new(Vec.new(), false)?;
    let mut player = Player { stemmer, docs: SortedMap.new() };
    for (i, line) in script.split("\n").enumerate() {
        let words: Vec[String] = line.split(" ").filter(|w| not w.is_empty()).map(|w| w.to_string()).collect();
        if words.is_empty() or words[0].starts_with("#") {
            continue;
        }
        println(f"> {words.join(" ")}");
        match player.run(words) {
            Ok(lines) => {
                for l in lines.iter() {
                    println(f"  {l}");
                }
            }
            Err(e) => println(f"  error: script.txt:{i + 1}: {e}"),
        }
    }
    Ok(())
}

fn run() -> Result[(), String] {
    fs.create_dir_all("data/docs").map_err(|e| f"cannot create data/docs: {e}")?;
    fs.create_dir_all("data/rules").map_err(|e| f"cannot create data/rules: {e}")?;
    write_data()?;
    let text = fs.read_to_string("data/script.txt").map_err(|e| f"cannot read data/script.txt: {e}")?;
    play(text)
}

fn put_bytes(path: Str, hex: Str) -> Result[(), String] {
    let digits: String = hex.chars().filter(|c| not c.is_whitespace()).collect();
    let bytes = hex_decode(digits).map_err(|e| f"bad data for {path}: {e}")?;
    fs.write_bytes(path, bytes).map_err(|e| f"cannot write {path}: {e}")
}

fn main() {
    if let Err(e) = run() {
        eprintln(e);
    }
}

// ============================================================ data

// The files under data/, in name order.
fn write_data() -> Result[(), String] {
    put_bytes("data/docs/bug_report.txt", file_0())?;
    put_bytes("data/docs/contract.txt", file_1())?;
    put_bytes("data/docs/french.txt", file_2())?;
    put_bytes("data/docs/mixed.txt", file_3())?;
    put_bytes("data/docs/recipe.txt", file_4())?;
    put_bytes("data/docs/release_notes.txt", file_5())?;
    put_bytes("data/rules/chain.rules", file_6())?;
    put_bytes("data/rules/empty.rules", file_7())?;
    put_bytes("data/rules/greedy.rules", file_8())?;
    put_bytes("data/rules/intact.rules", file_9())?;
    put_bytes("data/rules/nest.rules", file_10())?;
    put_bytes("data/rules/plurals.rules", file_11())?;
    put_bytes("data/rules/shouting.rules", file_12())?;
    put_bytes("data/rules/spaced.rules", file_13())?;
    put_bytes("data/script.txt", file_14())?;
    Ok(())
}

