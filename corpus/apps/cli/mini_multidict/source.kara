// mini_multidict: the `multidict` package that aiohttp and yarl keep HTTP
// headers and query strings in. A key may appear more than once and every
// pair keeps its place; a case-insensitive variant serves headers,
// read-only proxies sit over both, and the key and item views work as
// sets. README.md is the spec; oracle.py is the reference.

import std.encoding.hex_decode;

// ------------------------------------------------------------ text

/// A script word as text: `\s` is a space.
fn text(word: Str) -> String {
    word.replace("\\s", " ")
}

/// Python's `repr` of a string, for the characters the script uses.
fn py_repr(s: Str) -> String {
    let q = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        if c == '\\' {
            out.push_str("\\\\");
        } else if c == q {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else {
            out.push(c);
        }
    }
    out.push(q);
    out
}

fn repr_list(items: Slice[String]) -> String {
    let parts: Vec[String] = items.iter().map(|s| py_repr(s)).collect();
    f"[{parts.join(", ")}]"
}

fn repr_pair(k: Str, v: Str) -> String {
    f"({py_repr(k)}, {py_repr(v)})"
}

fn py_bool(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

/// `K=V` words as pairs, split at the first `=`.
fn pairs(words: Slice[String]) -> Result[Vec[(String, String)], String] {
    let mut out: Vec[(String, String)] = Vec.new();
    for w in words.iter() {
        let Some(i) = w.find("=") else {
            return Err(f"bad pair {w}");
        };
        out.push((text(w[0..i]), text(w[i + 1..])));
    }
    Ok(out)
}

/// A set as the report prints it: sorted, each member once.
fn show_set(members: own Vec[String]) -> String {
    let mut members = members;
    if members.is_empty() {
        return "set()";
    }
    members.sort();
    members.dedup();
    f"{{{members.join(", ")}}}"
}

// ------------------------------------------------------------ multidict

/// One entry: the key as written, the identity lookups compare, the value.
#[derive(Clone)]
struct Record {
    key: String,
    identity: String,
    value: String,
}

/// A `MultiDict`, or with `ci` a `CIMultiDict`: its entries in order.
#[derive(Clone)]
struct Md {
    ci: bool,
    entries: Vec[Record],
}

impl Md {
    fn new(ci: bool) -> Md {
        Md { ci, entries: Vec.new() }
    }

    fn from_pairs(ci: bool, items: Slice[(String, String)]) -> Md {
        let mut md = Md.new(ci);
        md.extend(items);
        md
    }

    fn class_name(ref self) -> String {
        if self.ci { "CIMultiDict".to_string() } else { "MultiDict".to_string() }
    }

    /// The identity of a key: itself, or lowercased in a `CIMultiDict`.
    fn identity(ref self, key: Str) -> String {
        if self.ci { key.to_lowercase() } else { key.to_string() }
    }

    fn entry(ref self, key: Str, value: Str) -> Record {
        Record { key: key.to_string(), identity: self.identity(key), value: value.to_string() }
    }

    fn pairs(ref self) -> Vec[(String, String)] {
        self.entries.iter().map(|e| (e.key.clone(), e.value.clone())).collect()
    }

    /// The positions of the entries matching a key, in order.
    fn matches(ref self, key: Str) -> Vec[i64] {
        let id = self.identity(key);
        let mut out: Vec[i64] = Vec.new();
        for (i, e) in self.entries.iter().enumerate() {
            if e.identity == id {
                out.push(i);
            }
        }
        out
    }

    fn first(ref self, key: Str) -> Option[i64] {
        let id = self.identity(key);
        self.entries.iter().position(|e| e.identity == id)
    }

    fn contains(ref self, key: Str) -> bool {
        self.first(key).is_some()
    }

    fn has_item(ref self, key: Str, value: Str) -> bool {
        let id = self.identity(key);
        self.entries.iter().any(|e| e.identity == id and e.value == value)
    }

    /// The positions of the first entry of each identity, in order.
    fn first_entries(ref self) -> Vec[i64] {
        let mut seen: Set[String] = Set.new();
        let mut out: Vec[i64] = Vec.new();
        for (i, e) in self.entries.iter().enumerate() {
            if seen.insert(e.identity.clone()) {
                out.push(i);
            }
        }
        out
    }

    fn keys(ref self) -> Vec[String] {
        self.first_entries().iter().map(|i| self.entries[i].key.clone()).collect()
    }

    fn values(ref self) -> Vec[String] {
        self.entries.iter().map(|e| e.value.clone()).collect()
    }

    fn getone(ref self, key: Str) -> Result[String, String] {
        match self.first(key) {
            Some(i) => Ok(self.entries[i].value.clone()),
            None => Err(not_found(key)),
        }
    }

    fn getall(ref self, key: Str) -> Result[Vec[String], String] {
        let found: Vec[String] = self.matches(key).iter().map(|i| self.entries[i].value.clone()).collect();
        if found.is_empty() {
            return Err(not_found(key));
        }
        Ok(found)
    }

    fn add(mut ref self, key: Str, value: Str) {
        let e = self.entry(key, value);
        self.entries.push(e);
    }

    fn extend(mut ref self, items: Slice[(String, String)]) {
        for (k, v) in items.iter() {
            self.add(k, v);
        }
    }

    /// `md[key] = value`: the first match takes the key and value, the
    /// other matches go; with none, the pair is appended.
    fn set(mut ref self, key: Str, value: Str) {
        let found = self.matches(key);
        if found.is_empty() {
            self.add(key, value);
            return;
        }
        let first = found[0];
        self.entries[first].key = key.to_string();
        self.entries[first].value = value.to_string();
        let mut k = found.len() - 1;
        while k > 0 {
            self.entries.remove(found[k]);
            k -= 1;
        }
    }

    /// Drops every match; the values, in order.
    fn take_all(mut ref self, key: Str) -> Vec[String] {
        let id = self.identity(key);
        let mut taken: Vec[String] = Vec.new();
        let mut kept: Vec[Record] = Vec.new();
        for e in self.entries.iter() {
            if e.identity == id {
                taken.push(e.value.clone());
            } else {
                kept.push(e.clone());
            }
        }
        self.entries = kept;
        taken
    }

    fn popone(mut ref self, key: Str) -> Option[String] {
        let i = self.first(key)?;
        Some(self.entries.remove(i).value)
    }

    fn setdefault(mut ref self, key: Str, value: Str) -> String {
        match self.first(key) {
            Some(i) => self.entries[i].value.clone(),
            None => {
                self.add(key, value);
                value.to_string()
            }
        }
    }

    /// `update`: each pair goes into the first match this call has not
    /// written, or is appended; at the end the matches of a written key
    /// that the call did not write are dropped.
    fn update(mut ref self, items: Slice[(String, String)]) {
        let mut written: Vec[bool] = Vec.filled(self.entries.len(), false);
        let mut doomed: Vec[bool] = Vec.filled(self.entries.len(), false);
        for (k, v) in items.iter() {
            let id = self.identity(k);
            let mut found = false;
            for i in 0..self.entries.len() {
                if self.entries[i].identity != id or written[i] {
                    continue;
                }
                if not found {
                    found = true;
                    written[i] = true;
                    doomed[i] = false;
                    self.entries[i].key = k.clone();
                    self.entries[i].value = v.clone();
                } else {
                    doomed[i] = true;
                }
            }
            if not found {
                self.add(k, v);
                written.push(true);
                doomed.push(false);
            }
        }
        let mut kept: Vec[Record] = Vec.new();
        for (i, e) in self.entries.iter().enumerate() {
            if not doomed[i] {
                kept.push(e.clone());
            }
        }
        self.entries = kept;
    }

    /// `merge`: appends each pair whose identity was not there before.
    fn merge(mut ref self, items: Slice[(String, String)]) {
        let before: Set[String] = self.entries.iter().map(|e| e.identity.clone()).collect();
        for (k, v) in items.iter() {
            if not before.contains(self.identity(k)) {
                self.add(k, v);
            }
        }
    }

    fn to_dict(ref self) -> String {
        let mut parts: Vec[String] = Vec.new();
        for i in self.first_entries().iter() {
            let key = self.entries[i].key.clone();
            let values = self.getall(key).unwrap_or(Vec.new());
            parts.push(f"{py_repr(key)}: {repr_list(values)}");
        }
        f"{{{parts.join(", ")}}}"
    }

    fn repr_items(ref self) -> String {
        let parts: Vec[String] = self.entries.iter().map(|e| f"{py_repr(e.key)}: {py_repr(e.value)}").collect();
        parts.join(", ")
    }

    /// `==`: equal lengths, and entry by entry equal identities and values.
    fn equals(ref self, other: ref Md) -> bool {
        if self.entries.len() != other.entries.len() {
            return false;
        }
        for i in 0..self.entries.len() {
            if self.entries[i].identity != other.entries[i].identity or self.entries[i].value != other.entries[i].value {
                return false;
            }
        }
        true
    }

    /// `==` against a plain dict: equal lengths, and the dict's value at
    /// each entry's key equal to the entry's value.
    fn equals_dict(ref self, dict: Map[String, String]) -> bool {
        if self.entries.len() != dict.len() {
            return false;
        }
        self.entries.iter().all(|e| dict.get(e.key) == Some(ref e.value))
    }
}

fn not_found(key: Str) -> String {
    let message = f"Key not found: {py_repr(key)}";
    f"KeyError: {py_repr(message)}"
}

fn key_error(key: Str) -> String {
    f"KeyError: {py_repr(key)}"
}

// ------------------------------------------------------------ views as sets

/// `keyset NAME OP WORDS`.
fn key_set(md: ref Md, op: Str, words: Slice[String]) -> Result[String, String] {
    let ids: Set[String] = words.iter().map(|w| md.identity(w)).collect();
    let keys = md.keys();
    let unmatched: Vec[String] = words.iter().filter(|w| not md.contains(w)).map(|w| w.clone()).collect();
    let not_named: Vec[String] = keys.iter().filter(|k| not ids.contains(md.identity(k))).map(|k| k.clone()).collect();
    let out: Vec[String] = match op {
        "and" => {
            let mut v: Vec[String] = Vec.new();
            for w in words.iter() {
                if let Some(i) = md.first(w) {
                    v.push(md.entries[i].key.clone());
                }
            }
            v
        }
        "rand" => words.iter().filter(|w| md.contains(w)).map(|w| w.clone()).collect(),
        "or" => {
            let mut v = keys.clone();
            v.extend(unmatched);
            v
        }
        "ror" => {
            let mut v = words.to_vec();
            v.extend(not_named);
            v
        }
        "sub" => not_named,
        "rsub" => unmatched,
        "xor" => {
            let mut v = not_named;
            v.extend(unmatched);
            v
        }
        "disjoint" => return Ok(py_bool(unmatched.len() == words.len())),
        _ => return Err(f"bad set operation {op}"),
    };
    Ok(show_set(out.iter().map(|s| py_repr(s)).collect()))
}

/// `itemset NAME OP PAIRS`.
fn item_set(md: ref Md, op: Str, items: Slice[(String, String)]) -> Result[String, String] {
    let named: Set[(String, String)] = items.iter().map(|(k, v)| (md.identity(k), v.clone())).collect();
    let entries: Vec[(String, String)] = md.pairs();
    let unmatched: Vec[(String, String)] = items.iter().filter(|(k, v)| not md.has_item(k, v)).map(|p| p.clone()).collect();
    let not_named: Vec[(String, String)] = md.entries.iter()
        .filter(|e| not named.contains((e.identity.clone(), e.value.clone())))
        .map(|e| (e.key.clone(), e.value.clone()))
        .collect();
    let out: Vec[(String, String)] = match op {
        "and" => {
            let mut v: Vec[(String, String)] = Vec.new();
            for (k, val) in items.iter() {
                for i in md.matches(k).iter() {
                    if md.entries[i].value == val {
                        v.push((md.entries[i].key.clone(), val.clone()));
                    }
                }
            }
            v
        }
        "rand" => items.iter().filter(|(k, v)| md.has_item(k, v)).map(|p| p.clone()).collect(),
        "or" => {
            let mut v = entries;
            v.extend(unmatched);
            v
        }
        "ror" => {
            let mut v = items.to_vec();
            v.extend(not_named);
            v
        }
        "sub" => not_named,
        "rsub" => unmatched,
        "xor" => {
            let mut v = not_named;
            v.extend(unmatched);
            v
        }
        "disjoint" => return Ok(py_bool(unmatched.len() == items.len())),
        _ => return Err(f"bad set operation {op}"),
    };
    let mut sorted = out;
    sorted.sort();
    Ok(show_set(sorted.iter().map(|(k, v)| repr_pair(k, v)).collect()))
}

// ------------------------------------------------------------ the player

/// A name's object: a multidict, or a proxy of either kind over the
/// multidict another name holds.
enum Obj {
    Dict(Md),
    Proxy(bool, String),
}

struct Player {
    objs: Map[String, Obj],
}

/// How many words a command takes after the name.
fn want(cmd: Str, rest: Slice[String], lo: i64, hi: i64) -> Result[(), String] {
    if rest.len() >= lo and rest.len() <= hi {
        return Ok(());
    }
    let n = if lo == hi { f"{lo}" } else { f"{lo} or {hi}" };
    let s = if n == "1" { "" } else { "s" };
    Err(f"{cmd} takes {n} word{s} after the name")
}

impl Player {
    fn fresh(ref self, name: Str) -> Result[String, String] {
        if self.objs.contains_key(name) {
            return Err(f"{name} exists");
        }
        Ok(name.to_string())
    }

    /// The multidict a name shows: its own, or a proxy's target.
    fn md(ref self, name: Str) -> Result[ref Md, String] {
        match self.objs.get(name) {
            Some(Obj.Dict(md)) => Ok(md),
            Some(Obj.Proxy(_, target)) => match self.objs.get(target) {
                Some(Obj.Dict(md)) => Ok(md),
                _ => Err(f"no multidict {target}"),
            },
            None => Err(f"no multidict {name}"),
        }
    }

    /// A name's class, as Python names it.
    fn class_name(ref self, name: Str) -> String {
        match self.objs.get(name) {
            Some(Obj.Dict(md)) => md.class_name(),
            Some(Obj.Proxy(ci, _)) => if ci { "CIMultiDictProxy".to_string() } else { "MultiDictProxy".to_string() },
            None => String.new(),
        }
    }

    /// `from OTHER` or `K=V` pairs, as pairs taken before anything changes.
    fn source(ref self, words: Slice[String]) -> Result[Vec[(String, String)], String] {
        if not words.is_empty() and words[0] == "from" {
            if words.len() != 2 {
                return Err("usage: ... from OTHER");
            }
            return Ok(self.md(words[1])?.pairs());
        }
        pairs(words)
    }

    fn run(mut ref self, words: Slice[String]) -> Result[Vec[String], String] {
        let cmd = words[0].as_str();
        let args = words[1..];
        let none: Vec[String] = Vec.new();
        match cmd {
            "new" => {
                if args.len() < 2 or not ["md", "ci"].contains(args[1].as_str()) {
                    return Err("usage: new NAME md|ci [K=V ...] | new NAME md|ci from OTHER");
                }
                let name = self.fresh(args[0])?;
                let items = self.source(args[2..])?;
                self.objs.insert(name, Obj.Dict(Md.from_pairs(args[1] == "ci", items)));
                return Ok(none);
            }
            "proxy" => {
                if args.len() != 3 or not ["md", "ci"].contains(args[1].as_str()) {
                    return Err("usage: proxy NAME md|ci OF");
                }
                let name = self.fresh(args[0])?;
                let target_md = self.md(args[2])?;
                let ci = args[1] == "ci";
                let of_class = self.class_name(args[2]);
                if ci and not of_class.starts_with("CI") {
                    return Err(f"TypeError: ctor requires CIMultiDict or CIMultiDictProxy instance, not <class 'multidict._multidict_py.{of_class}'>");
                }
                let _ = target_md;
                let target = match self.objs.get(args[2]) {
                    Some(Obj.Proxy(_, t)) => t.clone(),
                    _ => args[2].clone(),
                };
                self.objs.insert(name, Obj.Proxy(ci, target));
                return Ok(none);
            }
            "copy" => {
                if args.len() != 2 {
                    return Err("usage: copy NAME NEW");
                }
                let md = self.md(args[0])?;
                let ci = self.class_name(args[0]).starts_with("CI");
                let copy = Md.from_pairs(ci, md.pairs());
                let name = self.fresh(args[1])?;
                self.objs.insert(name, Obj.Dict(copy));
                return Ok(none);
            }
            _ => {}
        }
        if args.is_empty() {
            return Err(f"usage: {cmd} NAME ...");
        }
        let name = args[0].as_str();
        let rest = args[1..];
        let t: Vec[String] = rest.iter().map(|w| text(w)).collect();
        let class = self.class_name(name);
        let md = self.md(name)?;
        let out: String = match cmd {
            "show" => {
                want(cmd, rest, 0, 0)?;
                f"<{class}({md.repr_items()})>"
            }
            "len" => {
                want(cmd, rest, 0, 0)?;
                f"{md.entries.len()}"
            }
            "keys" => {
                want(cmd, rest, 0, 0)?;
                let keys: Vec[String] = md.keys().iter().map(|k| py_repr(k)).collect();
                f"<_KeysView({keys.join(", ")})> len {keys.len()}"
            }
            "values" => {
                want(cmd, rest, 0, 0)?;
                let values: Vec[String] = md.values().iter().map(|v| py_repr(v)).collect();
                f"<_ValuesView({values.join(", ")})> len {values.len()}"
            }
            "items" => {
                want(cmd, rest, 0, 0)?;
                f"<_ItemsView({md.repr_items()})> len {md.entries.len()}"
            }
            "reversed" => {
                if rest.len() != 1 or not ["keys", "values", "items"].contains(rest[0].as_str()) {
                    return Err("usage: reversed NAME keys|values|items");
                }
                let mut parts: Vec[String] = match rest[0].as_str() {
                    "keys" => md.keys().iter().map(|k| py_repr(k)).collect(),
                    "values" => md.values().iter().map(|v| py_repr(v)).collect(),
                    _ => md.entries.iter().map(|e| repr_pair(e.key, e.value)).collect(),
                };
                parts.reverse();
                f"[{parts.join(", ")}]"
            }
            "todict" => {
                want(cmd, rest, 0, 0)?;
                md.to_dict()
            }
            "has" => {
                want(cmd, rest, 1, 1)?;
                py_bool(md.contains(t[0]))
            }
            "hasitem" => {
                want(cmd, rest, 2, 2)?;
                py_bool(md.has_item(t[0], t[1]))
            }
            "hasvalue" => {
                want(cmd, rest, 1, 1)?;
                py_bool(md.entries.iter().any(|e| e.value == t[0]))
            }
            "item" => {
                want(cmd, rest, 1, 1)?;
                py_repr(md.getone(t[0])?)
            }
            "get" => {
                want(cmd, rest, 1, 2)?;
                match md.getone(t[0]) {
                    Ok(v) => py_repr(v),
                    Err(_) => if t.len() == 2 { py_repr(t[1]) } else { "None".to_string() },
                }
            }
            "getone" => {
                want(cmd, rest, 1, 2)?;
                match md.getone(t[0]) {
                    Ok(v) => py_repr(v),
                    Err(e) => if t.len() == 2 { py_repr(t[1]) } else { return Err(e) },
                }
            }
            "getall" => {
                want(cmd, rest, 1, 2)?;
                match md.getall(t[0]) {
                    Ok(vs) => repr_list(vs),
                    Err(e) => if t.len() == 2 { py_repr(t[1]) } else { return Err(e) },
                }
            }
            "eq" => {
                want(cmd, rest, 1, 1)?;
                py_bool(md.equals(self.md(rest[0])?))
            }
            "eqdict" => {
                let mut dict: Map[String, String] = Map.new();
                for (k, v) in pairs(rest)? {
                    dict.insert(k.clone(), v.clone());
                }
                py_bool(md.equals_dict(dict))
            }
            "keyset" | "itemset" => {
                if rest.is_empty() {
                    return Err(f"usage: {cmd} NAME OP [...]");
                }
                if cmd == "keyset" {
                    key_set(md, rest[0], t[1..])?
                } else {
                    item_set(md, rest[0], pairs(rest[1..])?)?
                }
            }
            _ => return self.mutate(cmd, name, rest),
        };
        Ok([out])
    }

    /// The commands that change a multidict, which a proxy does not have.
    fn mutate(mut ref self, cmd: Str, name: Str, rest: Slice[String]) -> Result[Vec[String], String] {
        let none: Vec[String] = Vec.new();
        let t: Vec[String] = rest.iter().map(|w| text(w)).collect();
        match cmd {
            "add" | "setdefault" | "set" => want(cmd, rest, 2, 2)?,
            "popone" | "popall" => want(cmd, rest, 1, 2)?,
            "del" => want(cmd, rest, 1, 1)?,
            "popitem" | "clear" => want(cmd, rest, 0, 0)?,
            "extend" | "update" | "merge" => {}
            _ => return Err(f"unknown command {cmd}"),
        }
        let items = if ["extend", "update", "merge"].contains(cmd) { self.source(rest)? } else { Vec.new() };
        let class = self.class_name(name);
        let Some(Obj.Dict(md)) = self.objs.get_mut(name) else {
            return match cmd {
                "set" => Err(f"TypeError: '{class}' object does not support item assignment"),
                "del" => Err(f"TypeError: '{class}' object does not support item deletion"),
                _ => Err(f"AttributeError: '{class}' object has no attribute '{cmd}'"),
            };
        };
        match cmd {
            "add" => md.add(t[0], t[1]),
            "set" => md.set(t[0], t[1]),
            "del" => {
                if md.take_all(t[0]).is_empty() {
                    return Err(key_error(t[0]));
                }
            }
            "setdefault" => return Ok([py_repr(md.setdefault(t[0], t[1]))]),
            "popone" => {
                return match md.popone(t[0]) {
                    Some(v) => Ok([py_repr(v)]),
                    None => if t.len() == 2 { Ok([py_repr(t[1])]) } else { Err(key_error(t[0])) },
                };
            }
            "popall" => {
                let taken = md.take_all(t[0]);
                if not taken.is_empty() {
                    return Ok([repr_list(taken)]);
                }
                return if t.len() == 2 { Ok([py_repr(t[1])]) } else { Err(key_error(t[0])) };
            }
            "popitem" => {
                let Some(e) = md.entries.pop() else {
                    return Err(key_error("empty multidict"));
                };
                return Ok([repr_pair(e.key, e.value)]);
            }
            "clear" => md.entries.clear(),
            "extend" => md.extend(items),
            "update" => md.update(items),
            _ => md.merge(items),
        }
        Ok(none)
    }
}

fn play(script: Str) {
    let mut player = Player { objs: Map.new() };
    println("== mini_multidict 7.2.1");
    for (i, line) in script.split("\n").enumerate() {
        let words: Vec[String] = line.split_whitespace().map(|w| w.to_string()).collect();
        if words.is_empty() or words[0].starts_with("#") {
            continue;
        }
        println(f"> {words.join(" ")}");
        match player.run(words) {
            Ok(lines) => {
                for l in lines.iter() {
                    println(f"  {l}");
                }
            }
            Err(e) => println(f"  error: script.txt:{i + 1}: {e}"),
        }
    }
    println("== end");
    println(f"  {player.objs.len()} multidicts");
}

fn run() -> Result[(), String] {
    fs.create_dir_all("data").map_err(|e| f"cannot create data: {e}")?;
    write_data()?;
    let text = fs.read_to_string("data/script.txt").map_err(|e| f"cannot read data/script.txt: {e}")?;
    play(text);
    Ok(())
}

fn put_bytes(path: Str, hex: Str) -> Result[(), String] {
    let digits: String = hex.chars().filter(|c| not c.is_whitespace()).collect();
    let bytes = hex_decode(digits).map_err(|e| f"bad data for {path}: {e}")?;
    fs.write_bytes(path, bytes).map_err(|e| f"cannot write {path}: {e}")
}

fn main() {
    if let Err(e) = run() {
        eprintln(e);
    }
}

// ============================================================ data

// The files under data/, in name order.
fn write_data() -> Result[(), String] {
    put_bytes("data/script.txt", file_0())?;
    Ok(())
}

