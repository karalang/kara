    t.push_str("{\"fn\": \"header\", \"args\": [], \"kw\": {\"init\": {\"s\": \"a, b\", \"continuation_ws\": \"\\t\", \"header_name\": \"To\", \"maxlinelen\": 8}, \"encode\": {}}}\n");
