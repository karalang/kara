    t.push_str("{\"fn\": \"header\", \"args\": [], \"kw\": {\"init\": {\"s\": \"\", \"charset\": \"utf-8\"}, \"encode\": {}}}\n");
    t.push_str("{\"fn\": \"header\", \"args\": [], \"kw\": {\"init\": {\"s\": \"x\", \"charset\": \"Latin_1\"}, \"encode\": {}}}\n");
    t.push_str("{\"fn\": \"header_parts\", \"args\": [[[\"Hello \", null], [\"wörld\", \"utf-8\"], [\" again\", null]]], \"kw\": {}}\n");
    t.push_str("{\"fn\": \"header_parts\", \"args\": [[[\"Price: \", \"us-ascii\"], [\"10 €\", \"iso-8859-15\"], [\"(\", null], [\"net\", \"utf-8\"], [\")\", null]]], \"kw\": {}}\n");
    t.push_str("{\"fn\": \"header_parts\", \"args\": [[[\"a\", \"utf-8\"], [\"b\", \"utf-8\"], [\"c\", \"iso-8859-1\"], [\"d\", \"iso-8859-1\"]]], \"kw\": {}}\n");
    t.push_str("{\"fn\": \"header_parts\", \"args\": [[[\"café\", \"us-ascii\"], [\"ok\", null]]], \"kw\": {}}\n");
    t.push_str("{\"fn\": \"header_parts\", \"args\": [[[\"€\", \"iso-8859-1\"]]], \"kw\": {}}\n");
    v.push(DataFile { path: "jobs.jsonl".to_string(), hex: false, body: t });
}

