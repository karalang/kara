== the paths of the SVG specification
> parse_path('M 100 100 L 300 100 L 200 300 z')
  -> Path(Move(to=(100+100j)), Line(start=(100+100j), end=(300+100j)), Line(start=(300+100j), end=(200+300j)), Close(start=(200+300j), end=(100+100j)))
  d: M 100,100 L 300,100 L 200,300 z
> boundingbox()
  -> [100.0, 100.0, 300.0, 300.0]
> parse_path('M100,200 C100,100 250,100 250,200 S400,300 400,200')
  -> Path(Move(to=(100+200j)), CubicBezier(start=(100+200j), control1=(100+100j), control2=(250+100j), end=(250+200j), smooth=False), CubicBezier(start=(250+200j), control1=(250+300j), control2=(400+300j), end=(400+200j), smooth=True))
  d: M 100,200 C 100,100 250,100 250,200 S 400,300 400,200
> boundingbox()
  -> [100.0, 125.0, 400.0, 275.0]
> parse_path('M200,300 Q400,50 600,300 T1000,300')
  -> Path(Move(to=(200+300j)), QuadraticBezier(start=(200+300j), control=(400+50j), end=(600+300j), smooth=False), QuadraticBezier(start=(600+300j), control=(800+550j), end=(1000+300j), smooth=True))
  d: M 200,300 Q 400,50 600,300 T 1000,300
> boundingbox()
  -> [200.0, 175.0, 1000.0, 425.0]
> parse_path('M300,200 h-150 a150,150 0 1,0 150,-150 z')
  -> Path(Move(to=(300+200j)), Line(start=(300+200j), end=(150+200j)), Arc(start=(150+200j), radius=(150+150j), rotation=0.0, arc=True, sweep=False, end=(300+50j)), Close(start=(300+50j), end=(300+200j)))
  d: M 300,200 h -150 a 150,150 0 1,0 150,-150 z
> boundingbox()
  -> [150.0, 50.0, 450.0, 350.0]
> parse_path('M275,175 v-150 a150,150 0 0,0 -150,150 z')
  -> Path(Move(to=(275+175j)), Line(start=(275+175j), end=(275+25j)), Arc(start=(275+25j), radius=(150+150j), rotation=0.0, arc=False, sweep=False, end=(125+175j)), Close(start=(125+175j), end=(275+175j)))
  d: M 275,175 v -150 a 150,150 0 0,0 -150,150 z
> boundingbox()
  -> [125.0, 25.0, 275.0, 175.00000000000003]
> parse_path('M600,350 l 50,-25 a25,25 -30 0,1 50,-25 l 50,-25 a25,50 -30 0,1 50,-25 l 50,-25 a25,75 -30 0,1 50,-25 l 50,-25 a25,100 -30 0,1 50,-25 l 50,-25')
  -> Path(Move(to=(600+350j)), Line(start=(600+350j), end=(650+325j)), Arc(start=(650+325j), radius=(25+25j), rotation=-30.0, arc=False, sweep=True, end=(700+300j)), Line(start=(700+300j), end=(750+275j)), Arc(start=(750+275j), radius=(25+50j), rotation=-30.0, arc=False, sweep=True, end=(800+250j)), Line(start=(800+250j), end=(850+225j)), Arc(start=(850+225j), radius=(25+75j), rotation=-30.0, arc=False, sweep=True, end=(900+200j)), Line(start=(900+200j), end=(950+175j)), Arc(start=(950+175j), radius=(25+100j), rotation=-30.0, arc=False, sweep=True, end=(1000+150j)), Line(start=(1000+150j), end=(1050+125j)))
  d: M 600,350 l 50,-25 a 25,25 -30 0,1 50,-25 l 50,-25 a 25,50 -30 0,1 50,-25 l 50,-25 a 25,75 -30 0,1 50,-25 l 50,-25 a 25,100 -30 0,1 50,-25 l 50,-25
> boundingbox()
  -> [600.0, 64.83678479616788, 1050.0, 350.0]
> parse_path('M100,200 C100,100 400,100 400,200')
  -> Path(Move(to=(100+200j)), CubicBezier(start=(100+200j), control1=(100+100j), control2=(400+100j), end=(400+200j), smooth=False))
  d: M 100,200 C 100,100 400,100 400,200
> boundingbox()
  -> [100.0, 125.0, 400.0, 200.0]
> parse_path('M100,500 C25,400 475,400 400,500')
  -> Path(Move(to=(100+500j)), CubicBezier(start=(100+500j), control1=(25+400j), control2=(475+400j), end=(400+500j), smooth=False))
  d: M 100,500 C 25,400 475,400 400,500
> boundingbox()
