== the grammar
> parse_path('m 10 10 20 20 30 0')
  -> Path(Move(to=(10+10j)), Line(start=(10+10j), end=(30+30j)), Line(start=(30+30j), end=(60+30j)))
  d: m 10,10 l 20,20 l 30,0
> parse_path('M10 10 20 20')
  -> Path(Move(to=(10+10j)), Line(start=(10+10j), end=(20+20j)))
  d: M 10,10 L 20,20
> parse_path('M 0 0 L 10 0 10 10 0 10 z m 20 0 l 10 0')
  -> Path(Move(to=0j), Line(start=0j, end=(10+0j)), Line(start=(10+0j), end=(10+10j)), Line(start=(10+10j), end=10j), Close(start=10j, end=0j), Move(to=(20+0j)), Line(start=(20+0j), end=(30+0j)))
  d: M 0,0 L 10,0 L 10,10 L 0,10 z m 20,0 l 10,0
> parse_path('M10-20L.5.5-1e2,3E-1')
  -> Path(Move(to=(10-20j)), Line(start=(10-20j), end=(0.5+0.5j)), Line(start=(0.5+0.5j), end=(-100+0.3j)))
  d: M 10,-20 L 0.5,0.5 L -100,0.3
> parse_path('M1.5.5.5.5')
  -> Path(Move(to=(1.5+0.5j)), Line(start=(1.5+0.5j), end=(0.5+0.5j)))
  d: M 1.5,0.5 L 0.5,0.5
> parse_path('M0,0l1-1-1-1z')
  -> Path(Move(to=0j), Line(start=0j, end=(1-1j)), Line(start=(1-1j), end=-2j), Close(start=-2j, end=0j))
  d: M 0,0 l 1,-1 l -1,-1 z
> parse_path('M 10 10 a20 20 0 1010 10')
  -> Path(Move(to=(10+10j)), Arc(start=(10+10j), radius=(20+20j), rotation=0.0, arc=True, sweep=False, end=(20+20j)))
  d: M 10,10 a 20,20 0 1,0 10,10
> parse_path('\tM\n10\r10 L 20,20')
  -> Path(Move(to=(10+10j)), Line(start=(10+10j), end=(20+20j)))
  d: M 10,10 L 20,20
> parse_path('M 10 10 L 10 10')
  -> Path(Move(to=(10+10j)), Line(start=(10+10j), end=(10+10j)))
  d: M 10,10 L 10,10
> parse_path('M 5 5')
  -> Path(Move(to=(5+5j)))
  d: M 5,5
> parse_path('M 0 0 M 10 10 L 20 20')
  -> Path(Move(to=0j), Move(to=(10+10j)), Line(start=(10+10j), end=(20+20j)))
  d: M 0,0 M 10,10 L 20,20
> parse_path('M 0 0 A 0 10 0 0 1 10 10')
  -> Path(Move(to=0j), Arc(start=0j, radius=10j, rotation=0.0, arc=False, sweep=True, end=(10+10j)))
  d: M 0,0 A 0,10 0 0,1 10,10
> parse_path('M 10 10 A 5 5 0 0 1 10 10')
  -> Path(Move(to=(10+10j)), Arc(start=(10+10j), radius=(5+5j), rotation=0.0, arc=False, sweep=True, end=(10+10j)))
  d: M 10,10 A 5,5 0 0,1 10,10
> parse_path('M 0 0 A 1 1 0 0 1 10 0')
  -> Path(Move(to=0j), Arc(start=0j, radius=(1+1j), rotation=0.0, arc=False, sweep=True, end=(10+0j)))
  d: M 0,0 A 1,1 0 0,1 10,0
> parse_path('M 0 0 A 5 5 30 1 1 3 4')
  -> Path(Move(to=0j), Arc(start=0j, radius=(5+5j), rotation=30.0, arc=True, sweep=True, end=(3+4j)))
  d: M 0,0 A 5,5 30 1,1 3,4
> parse_path('M 0 0 A 5 5 0 2 1 10 10')
  -> Path(Move(to=0j), Arc(start=0j, radius=(5+5j), rotation=0.0, arc=False, sweep=True, end=(10+10j)))
  d: M 0,0 A 5,5 0 0,1 10,10
> parse_path('M 0 0 A 3 9 -60 1 0 6 6')
  -> Path(Move(to=0j), Arc(start=0j, radius=(3+9j), rotation=-60.0, arc=True, sweep=False, end=(6+6j)))
  d: M 0,0 A 3,9 -60 1,0 6,6
> parse_path('L 10 10 20 0')
  -> Path(Line(start=0, end=(10+10j)), Line(start=(10+10j), end=(20+0j)))
  d: L 10,10 L 20,0
> parse_path('C 0 10 10 10 10 0')
  -> Path(CubicBezier(start=0, control1=10j, control2=(10+10j), end=(10+0j), smooth=False))
  d: C 0,10 10,10 10,0
> parse_path('Q 5 5 10 0')
  -> Path(QuadraticBezier(start=0, control=(5+5j), end=(10+0j), smooth=False))
  d: Q 5,5 10,0
> parse_path('H 10 V 10')
  -> Path(Line(start=0, end=(10+0j)), Line(start=(10+0j), end=(10+10j)))
  error AttributeError: 'NoneType' object has no attribute 'end'
> parse_path('l 10 10')
  -> Path(Line(start=0, end=(10+10j)))
  error AttributeError: 'NoneType' object has no attribute 'end'
> parse_path('A 5 5 0 0 1 10 0')
  -> Path(Arc(start=0, radius=(5+5j), rotation=0.0, arc=False, sweep=True, end=(10+0j)))
  d: A 5,5 0 0,1 10,0
> parse_path('S 10 10 20 0')
  error TypeError: 'in <string>' requires string as left operand, not NoneType
> parse_path('M 10 10 L 20 20 Z L 30 30')
  -> Path(Move(to=(10+10j)), Line(start=(10+10j), end=(20+20j)), Close(start=(20+20j), end=(10+10j)), Line(start=(10+10j), end=(30+30j)))
  d: M 10,10 L 20,20 Z L 30,30
> parse_path('M 10 10 Z Z')
  -> Path(Move(to=(10+10j)), Close(start=(10+10j), end=(10+10j)), Close(start=(10+10j), end=(10+10j)))
  d: M 10,10 Z Z
> parse_path('m 10 10 z m 5 5 z')
  -> Path(Move(to=(10+10j)), Close(start=(10+10j), end=(10+10j)), Move(to=(15+15j)), Close(start=(15+15j), end=(15+15j)))
  d: m 10,10 z m 5,5 z
> parse_path('M 0 0 S 10 10 20 0')
  -> Path(Move(to=0j), CubicBezier(start=0j, control1=0j, control2=(10+10j), end=(20+0j), smooth=True))
  d: M 0,0 S 10,10 20,0
> parse_path('M 0 0 C 0 10 10 10 10 0 S 20 -10 20 0')
  -> Path(Move(to=0j), CubicBezier(start=0j, control1=10j, control2=(10+10j), end=(10+0j), smooth=False), CubicBezier(start=(10+0j), control1=(10-10j), control2=(20-10j), end=(20+0j), smooth=True))
  d: M 0,0 C 0,10 10,10 10,0 S 20,-10 20,0
> parse_path('M 0 0 T 10 0')
  -> Path(Move(to=0j), QuadraticBezier(start=0j, control=0j, end=(10+0j), smooth=True))
  d: M 0,0 T 10,0
> parse_path('M 0 0 Q 5 10 10 0 T 20 0 T 30 0')
  -> Path(Move(to=0j), QuadraticBezier(start=0j, control=(5+10j), end=(10+0j), smooth=False), QuadraticBezier(start=(10+0j), control=(15-10j), end=(20+0j), smooth=True), QuadraticBezier(start=(20+0j), control=(25+10j), end=(30+0j), smooth=True))
  d: M 0,0 Q 5,10 10,0 T 20,0 T 30,0
> parse_path('M 0 0 C 1 1 2 2 3 3 T 10 0')
  -> Path(Move(to=0j), CubicBezier(start=0j, control1=(1+1j), control2=(2+2j), end=(3+3j), smooth=False), QuadraticBezier(start=(3+3j), control=(3+3j), end=(10+0j), smooth=True))
  d: M 0,0 C 1,1 2,2 3,3 T 10,0
> parse_path('M 0 0 Q 5 5 10 0 S 15 5 20 0')
  -> Path(Move(to=0j), QuadraticBezier(start=0j, control=(5+5j), end=(10+0j), smooth=False), CubicBezier(start=(10+0j), control1=(10+0j), control2=(15+5j), end=(20+0j), smooth=True))
  d: M 0,0 Q 5,5 10,0 S 15,5 20,0
> parse_path('M 0 0 c 0 -5 5 -5 5 0 s 5 5 5 0 s 5 -5 5 0')
  -> Path(Move(to=0j), CubicBezier(start=0j, control1=-5j, control2=(5-5j), end=(5+0j), smooth=False), CubicBezier(start=(5+0j), control1=(5+5j), control2=(10+5j), end=(10+0j), smooth=True), CubicBezier(start=(10+0j), control1=(10-5j), control2=(15-5j), end=(15+0j), smooth=True))
  d: M 0,0 c 0,-5 5,-5 5,0 s 5,5 5,0 s 5,-5 5,0
> parse_path('M 0 0 q 5 -5 10 0 t 10 0 t 10 0')
  -> Path(Move(to=0j), QuadraticBezier(start=0j, control=(5-5j), end=(10+0j), smooth=False), QuadraticBezier(start=(10+0j), control=(15+5j), end=(20+0j), smooth=True), QuadraticBezier(start=(20+0j), control=(25-5j), end=(30+0j), smooth=True))
  d: M 0,0 q 5,-5 10,0 t 10,0 t 10,0
> parse_path('M 1e2 1E2 l -1e1 .5e1')
  -> Path(Move(to=(100+100j)), Line(start=(100+100j), end=(90+105j)))
  d: M 100,100 l -10,5
> parse_path('M 0.000001 1000000 L 1234567 0.00001234')
  -> Path(Move(to=(1e-06+1000000j)), Line(start=(1e-06+1000000j), end=(1234567+1.234e-05j)))
  d: M 1E-06,1E+06 L 1.23457E+06,1.234E-05
> parse_path('M 123456.5 0 L 0.0001 -0.0')
  -> Path(Move(to=(123456.5+0j)), Line(start=(123456.5+0j), end=(0.0001-0j)))
  d: M 123456,0 L 0.0001,-0
> parse_path('M -0 -0 l -0 -0')
  -> Path(Move(to=(-0-0j)), Line(start=(-0-0j), end=(-0-0j)))
  d: M -0,-0 l 0,0
> parse_path('M 0 0 L 1e400 0')
  -> Path(Move(to=0j), Line(start=0j, end=(inf+0j)))
  d: M 0,0 L INF,0
> parse_path('M 0 0 L 1e-400 5')
  -> Path(Move(to=0j), Line(start=0j, end=5j))
  d: M 0,0 L 0,5
> parse_path('M 3 3 h 4 v 4 h -4 v -4')
  -> Path(Move(to=(3+3j)), Line(start=(3+3j), end=(7+3j)), Line(start=(7+3j), end=(7+7j)), Line(start=(7+7j), end=(3+7j)), Line(start=(3+7j), end=(3+3j)))
  d: M 3,3 h 4 v 4 h -4 v -4
> parse_path('M 0 0 V 5 H 5 v 5 h 5')
  -> Path(Move(to=0j), Line(start=0j, end=5j), Line(start=5j, end=(5+5j)), Line(start=(5+5j), end=(5+10j)), Line(start=(5+10j), end=(10+10j)))
  d: M 0,0 V 5 H 5 v 5 h 5
> parse_path('M 1 2 3 4 5 6 Z 7 8')
  error ValueError: too many values to unpack (expected 2)
== broken paths
> parse_path('')
  error TypeError: cannot unpack non-iterable NoneType object
> parse_path('   ')
  error TypeError: cannot unpack non-iterable NoneType object
> parse_path('10 10 L 20 20')
  error InvalidPathError: Path does not start with a command: 10 10 L 20 20
> parse_path('M 10')
  error InvalidPathError: Invalid path element M 10
> parse_path('M 10 10 L 20')
  error InvalidPathError: Invalid path element L 20
> parse_path('M 10 10 L 20 20 x 30 30')
  -> Path(Move(to=(10+10j)), Line(start=(10+10j), end=(20+20j)))
  d: M 10,10 L 20,20
> parse_path('M 0 0 L 10 10 L')
  error ValueError: not enough values to unpack (expected 2, got 1)
> parse_path('M 0 0 z 10 10')
  error ValueError: too many values to unpack (expected 2)
> parse_path('M 0 0 L . 5')
  error ValueError: could not convert string to float: b'.'
> parse_path('M 0 0 L - 5')
  error ValueError: could not convert string to float: b'-'
> parse_path('M 0 0 L e5 5')
  error ValueError: could not convert string to float: b'e5'
> parse_path('M 0 0 A -5 5 0 0 1 10 10')
  error InvalidPathError: Invalid path element A -5 5 0 0 1 10 10
> parse_path('M 0 0 A 5 5 0 0 1')
  error InvalidPathError: Invalid path element A 5 5 0 0 1
> parse_path('M 0 0 A 5 5 0')
  error IndexError: bytearray index out of range
> parse_path('M 0 0 L 5 é')
  error UnicodeEncodeError: 'ascii' codec can't encode character '\xe9' in position 2: ordinal not in range(128)
> parse_path('M 0 0 L 10 10 # comment')
  -> Path(Move(to=0j), Line(start=0j, end=(10+10j)))
  d: M 0,0 L 10,10
> parse_path('M,10,10')
  error InvalidPathError: Invalid path element M ,10,10
> parse_path('M 10 10 L 1.5.5')
  -> Path(Move(to=(10+10j)), Line(start=(10+10j), end=(1.5+0.5j)))
  d: M 10,10 L 1.5,0.5
> parse_path('M 0 0 C 1 2 3 4')
  error InvalidPathError: Invalid path element C 1 2 3 4
> parse_path('M 0 0 Q 1 1')
  error InvalidPathError: Invalid path element Q 1 1
> parse_path('M 0 0 L 1 1 2')
  -> Path(Move(to=0j), Line(start=0j, end=(1+1j)))
  d: M 0,0 L 1,1
> parse_path('Z')
  -> Path(Close(start=0, end=None))
  d: Z
> parse_path('z M 1 1')
  -> Path(Close(start=0, end=None), Move(to=(1+1j)))
  d: z M 1,1
> parse_path('M 0 0 L 1 1 Z L 2 2 x')
  -> Path(Move(to=0j), Line(start=0j, end=(1+1j)), Close(start=(1+1j), end=0j), Line(start=0j, end=(2+2j)))
  d: M 0,0 L 1,1 Z L 2,2
> parse_path('M 0 0 H')
  error ValueError: not enough values to unpack (expected 2, got 1)
== the tokenizer
> _tokenize_path('M 100 100 L 300 100 L 200 300 z')
  - ('M', (100+100j))
  - ('L', (300+100j))
  - ('L', (200+300j))
  - ('z',)
> _tokenize_path('M100,200 C100,100 250,100 250,200 S400,300 400,200')
  - ('M', (100+200j))
  - ('C', (100+100j), (250+100j), (250+200j))
  - ('S', (400+300j), (400+200j))
> _tokenize_path('M200,300 Q400,50 600,300 T1000,300')
  - ('M', (200+300j))
  - ('Q', (400+50j), (600+300j))
  - ('T', (1000+300j))
> _tokenize_path('m 10 10 20 20 30 0')
  - ('m', (10+10j))
  - ('l', (20+20j))
  - ('l', (30+0j))
> _tokenize_path('M10 10 20 20')
  - ('M', (10+10j))
  - ('L', (20+20j))
> _tokenize_path('M 0 0 L 10 0 10 10 0 10 z m 20 0 l 10 0')
  - ('M', 0j)
  - ('L', (10+0j))
  - ('L', (10+10j))
  - ('L', 10j)
  - ('z',)
  - ('m', (20+0j))
  - ('l', (10+0j))
> _tokenize_path('M10-20L.5.5-1e2,3E-1')
  - ('M', (10-20j))
  - ('L', (0.5+0.5j))
  - ('L', (-100+0.3j))
> _tokenize_path('M1.5.5.5.5')
  - ('M', (1.5+0.5j))
  - ('L', (0.5+0.5j))
> _tokenize_path('M0,0l1-1-1-1z')
  - ('M', 0j)
  - ('l', (1-1j))
  - ('l', (-1-1j))
  - ('z',)
> _tokenize_path('M 10 10 a20 20 0 1010 10')
  - ('M', (10+10j))
  - ('a', 20.0, 20.0, 0.0, True, False, (10+10j))
> _tokenize_path('\tM\n10\r10 L 20,20')
  - ('M', (10+10j))
  - ('L', (20+20j))
> _tokenize_path('M 10 10 L 10 10')
  - ('M', (10+10j))
  - ('L', (10+10j))
> _tokenize_path('M 5 5')
  - ('M', (5+5j))
> _tokenize_path('M 0 0 M 10 10 L 20 20')
  - ('M', 0j)
  - ('M', (10+10j))
  - ('L', (20+20j))
> _tokenize_path('M 0 0 A 0 10 0 0 1 10 10')
  - ('M', 0j)
  - ('A', 0.0, 10.0, 0.0, False, True, (10+10j))
> _tokenize_path('')
  error TypeError: cannot unpack non-iterable NoneType object
> _tokenize_path('   ')
  error TypeError: cannot unpack non-iterable NoneType object
> _tokenize_path('10 10 L 20 20')
  error InvalidPathError: Path does not start with a command: 10 10 L 20 20
> _tokenize_path('M 10')
  error InvalidPathError: Invalid path element M 10
> _tokenize_path('M 10 10 L 20')
  - ('M', (10+10j))
  error InvalidPathError: Invalid path element L 20
> _tokenize_path('M 10 10 L 20 20 x 30 30')
  - ('M', (10+10j))
  - ('L', (20+20j))
> _tokenize_path('M 0 0 L 10 10 L')
  - ('M', 0j)
  - ('L', (10+10j))
  error ValueError: not enough values to unpack (expected 2, got 1)
> _tokenize_path('M 0 0 z 10 10')
