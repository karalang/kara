    s.push_str("[url]http://example.com/path[/url]\n");
    s.push_str("@END\n");
    s.push_str("@JOB url_opt\n");
    s.push_str("[url=http://example.com]visit[/url]\n");
    s.push_str("@END\n");
    s.push_str("@JOB url_www\n");
