    s.push_str("@END\n");
    s.push_str("@JOB code\n");
    s.push_str("[code]if a < b:\n");
    s.push_str("    return &amp;[/code]\n");
    s.push_str("@END\n");
    s.push_str("@JOB code_embed\n");
    s.push_str("[code]not [b]bold[/b] here[/code]\n");
    s.push_str("@END\n");
    s.push_str("@JOB center\n");
    s.push_str("[center]middle[/center]\n");
    s.push_str("@END\n");
    s.push_str("@JOB color_name\n");
