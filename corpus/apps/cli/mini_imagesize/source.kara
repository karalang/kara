// mini_imagesize: a port of imagesize 1.4.1 (MIT; Yoshiki Shibukawa), the
// pure-Python library that reads an image's width and height, and its
// DPI, from the first bytes of the file without decoding it: PNG, GIF,
// JPEG, JPEG 2000, TIFF and BigTIFF, SVG, Netpbm and WebP.
//
// The library reads the file through a Python file object, seeking and
// reading as it walks markers, chunks, boxes and IFDs. The port reads the
// whole file and keeps the same cursor over it (`Cursor`), with Python's
// rules: a read past the end returns fewer bytes, or none, and leaves the
// position where it was; a seek past the end is allowed. The errors are
// the library's own, and the ones it lets through from `struct`, `ord`
// and `float`, with Python's messages.

struct PyErr {
    cls: String,
    msg: String,
}

fn py_err(cls: Str, msg: own String) -> PyErr {
    PyErr { cls: cls.to_string(), msg }
}

fn value_err(msg: Str) -> PyErr {
    py_err("ValueError", msg.to_string())
}

// struct.error, whose class prints as `error`.
fn struct_err(n: i64) -> PyErr {
    py_err("error", f"unpack requires a buffer of {n} bytes")
}

// ------------------------------------------------------------ the file

struct Cursor {
    data: Vec[u8],
    pos: i64,
}

fn open_file(path: ref String) -> Result[Cursor, PyErr] {
    match fs.read_bytes(f"data/{path}") {
        Ok(b) => Ok(Cursor { data: b, pos: 0 }),
        Err(_) => Err(py_err("FileNotFoundError", f"[Errno 2] No such file or directory: '{path}'")),
    }
}

fn read(f: mut ref Cursor, n: i64) -> Vec[u8] {
    let end = f.data.len() as i64;
    let mut out: Vec[u8] = Vec.new();
    while out.len() as i64 < n and f.pos < end {
        out.push(f.data[f.pos as usize]);
        f.pos += 1;
    }
    out
}

fn readline(f: mut ref Cursor) -> Vec[u8] {
    let end = f.data.len() as i64;
    let mut out: Vec[u8] = Vec.new();
    while f.pos < end {
        let b = f.data[f.pos as usize];
        out.push(b);
        f.pos += 1;
        if b == 10 {
            break;
        }
    }
    out
}

fn seek(f: mut ref Cursor, p: i64) {
    f.pos = p;
}

// A relative seek. Every one the library makes lands at or after the
// start: each follows a read of at least as many bytes as it goes back.
fn seek_rel(f: mut ref Cursor, d: i64) {
    f.pos = f.pos + d;
}

// ------------------------------------------------------------ bytes

fn sl(b: ref Vec[u8], a: i64, e: i64) -> Vec[u8] {
    let n = b.len() as i64;
    let lo = if a > n { n } else { a };
    let hi = if e > n { n } else { e };
    let mut out: Vec[u8] = Vec.new();
    let mut k = lo;
    while k < hi {
        out.push(b[k as usize]);
        k += 1;
    }
    out
}

fn is(b: ref Vec[u8], s: Str) -> bool {
    let want: Vec[u8] = s.bytes().to_vec();
    if want.len() != b.len() {
        return false;
    }
    let mut k = 0;
    while k < want.len() {
        if want[k] != b[k] {
            return false;
        }
        k += 1;
    }
    true
}

fn starts(b: ref Vec[u8], s: Str) -> bool {
    let want: Vec[u8] = s.bytes().to_vec();
    is(sl(b, 0, want.len() as i64), s)
}

fn byte(b: ref Vec[u8], k: i64) -> i64 {
    b[k as usize] as i64
}

fn be(b: ref Vec[u8], at: i64, n: i64) -> i64 {
    let mut v: i64 = 0;
    let mut k = 0;
    while k < n {
        v = v * 256 + byte(b, at + k);
        k += 1;
    }
    v
}

fn le(b: ref Vec[u8], at: i64, n: i64) -> i64 {
    let mut v: i64 = 0;
    let mut k = n - 1;
    while k >= 0 {
        v = v * 256 + byte(b, at + k);
        k -= 1;
    }
    v
}

// `struct.unpack` wants exactly the bytes its format names.
fn need(b: ref Vec[u8], n: i64) -> Result[(), PyErr] {
    if b.len() as i64 != n {
        return Err(struct_err(n));
    }
    Ok(())
}

fn is_space(c: i64) -> bool {
    c == 32 or (c >= 9 and c <= 13)
}

fn is_digit(c: i64) -> bool {
    c >= 48 and c <= 57
}

// ------------------------------------------------------------ sizes

enum Size {
    I(i64, i64),
    F(f64, f64),
}

fn size_repr(s: ref Size) -> String {
    match s {
        Size.I(w, h) => f"({w}, {h})",
        Size.F(w, h) => f"({w}, {h})",
    }
}

fn pair_repr(p: (i64, i64)) -> String {
    f"({p.0}, {p.1})"
}

// ------------------------------------------------------------ the library

fn convert_to_dpi(density: i64, unit: i64) -> i64 {
    let d = density as f64;
    if unit == -3 {
        (d * 0.0000254 + 0.5) as i64
    } else if unit == -2 {
        (d * 0.000254 + 0.5) as i64
    } else if unit == -1 {
        (d * 0.00254 + 0.5) as i64
    } else if unit == 0 {
        (d * 0.0254 + 0.5) as i64
    } else if unit == 1 {
        (d * 0.254 + 0.5) as i64
    } else if unit == 2 {
        (d * 2.54 + 0.5) as i64
    } else if unit == 3 {
        (d * 25.4 + 0.5) as i64
    } else if unit == 4 {
        density * 254
    } else if unit == 5 {
        density * 2540
    } else if unit == 6 {
        density * 25400
    } else {
        density
    }
}

// _convertToPx: re.match(r"(\d+(?:\.\d+)?)?([a-z]*)$", value).
fn convert_to_px(value: ref Vec[u8]) -> Result[f64, PyErr] {
    let text = String.from_utf8(value.clone()).unwrap_or(String.new());
    let n = value.len() as i64;
    let mut i: i64 = 0;
    while i < n and is_digit(byte(value, i)) {
        i += 1;
    }
    if i > 0 and i + 1 < n and byte(value, i) == 46 and is_digit(byte(value, i + 1)) {
        i += 1;
        while i < n and is_digit(byte(value, i)) {
            i += 1;
        }
    }
    let mut j = i;
    while j < n and byte(value, j) >= 97 and byte(value, j) <= 122 {
        j += 1;
    }
    if j != n {
        return Err(py_err("ValueError", f"unknown length value: {text}"));
    }
    let unit = String.from_utf8(sl(value, i, j)).unwrap_or(String.new());
    let known = unit == "" or unit == "cm" or unit == "mm" or unit == "in" or unit == "pc" or unit == "pt" or unit == "px";
    if not known {
        return Err(py_err("ValueError", f"unknown unit type: {unit}"));
    }
    if i == 0 {
        return Err(py_err("TypeError", "float() argument must be a string or a real number, not 'NoneType'".to_string()));
    }
    let length = String.from_utf8(sl(value, 0, i)).unwrap_or(String.new());
    let x = f64.parse(length).unwrap_or(0.0);
    if unit == "cm" {
        Ok(x * 96.0 / 2.54)
    } else if unit == "mm" {
        Ok(x * 96.0 / 2.54 / 10.0)
    } else if unit == "in" {
        Ok(x * 96.0)
    } else if unit == "pc" or unit == "pt" {
        // `pt` divides by 6 as well, as the library does.
        Ok(x * 96.0 / 6.0)
    } else {
        Ok(x)
    }
}

// re.search(r'[^-]name="(.*?)"', data).group(1): the first `name="` with a
// character before it that is not `-`, up to the next `"` on that line.
fn svg_attr(data: ref Vec[u8], name: Str) -> Option[Vec[u8]] {
    let pat: Vec[u8] = name.bytes().to_vec();
    let n = data.len() as i64;
    let p = pat.len() as i64;
    let mut i: i64 = 1;
    while i + p + 2 <= n {
        if byte(data, i - 1) != 45 and is(sl(data, i, i + p), name) and byte(data, i + p) == 61 and byte(data, i + p + 1) == 34 {
            let start = i + p + 2;
            let mut k = start;
            while k < n {
                let c = byte(data, k);
                if c == 34 {
                    return Some(sl(data, start, k));
                }
                if c == 10 {
                    break;
                }
                k += 1;
            }
        }
        i += 1;
    }
    None
}

// The loop get() walks the JPEG markers with, to the first SOFn frame
// (DHT, JPG and DAC sit in that range and are skipped). Any short read is
// "Invalid JPEG file".
fn jpeg_size(f: mut ref Cursor) -> Option[(i64, i64)] {
    seek(mut f, 0);
    let mut size: i64 = 2;
    let mut ftype: i64 = 0;
    while not (ftype >= 0xc0 and ftype <= 0xcf) or ftype == 0xc4 or ftype == 0xc8 or ftype == 0xcc {
        seek_rel(mut f, size);
        let mut b = read(mut f, 1);
        if b.len() == 0 {
            return None;
        }
        while b[0] == 0xff {
            b = read(mut f, 1);
            if b.len() == 0 {
                return None;
            }
        }
        ftype = b[0] as i64;
        let l = read(mut f, 2);
        if l.len() != 2 {
            return None;
        }
        size = be(l, 0, 2) - 2;
    }
    seek_rel(mut f, 1);
    let d = read(mut f, 4);
    if d.len() != 4 {
        return None;
    }
    Some((be(d, 2, 2), be(d, 0, 2)))
}

// A TIFF or BigTIFF IFD: the ImageWidth (256) and ImageLength (257) tags.
fn tiff_ifd(f: mut ref Cursor, big: bool, little: bool, missing: Str) -> Result[Size, PyErr] {
    let cnt_n: i64 = if big { 8 } else { 2 };
    let entry_n: i64 = if big { 20 } else { 12 };
    let c = read(mut f, cnt_n);
    need(c, cnt_n)?;
    let ifdsize = if little { le(c, 0, cnt_n) } else { be(c, 0, cnt_n) };
    let mut width: i64 = -1;
    let mut height: i64 = -1;
    let mut i: i64 = 0;
    while i < ifdsize {
        let e = read(mut f, entry_n);
        need(e, entry_n)?;
        let field_n: i64 = if big { 8 } else { 4 };
        let data_at: i64 = if big { 12 } else { 8 };
        let tag = if little { le(e, 0, 2) } else { be(e, 0, 2) };
        let datatype = if little { le(e, 2, 2) } else { be(e, 2, 2) };
        let data = if little { le(e, data_at, field_n) } else { be(e, data_at, field_n) };
        if tag == 256 {
            if little {
                width = data;
            } else if datatype == 3 {
                width = data / 65536;
            } else if datatype == 4 {
                width = data;
            } else {
                return Err(value_err("Invalid TIFF file: width column data type should be SHORT/LONG."));
            }
        } else if tag == 257 {
            if little {
                height = data;
            } else if datatype == 3 {
                height = data / 65536;
            } else if datatype == 4 {
                height = data;
            } else {
                return Err(value_err("Invalid TIFF file: height column data type should be SHORT/LONG."));
            }
        }
        if width != -1 and height != -1 {
            break;
        }
        i += 1;
    }
    if width == -1 or height == -1 {
        return Err(value_err(missing));
    }
    Ok(Size.I(width, height))
}

fn netpbm_size(f: mut ref Cursor) -> Result[Size, PyErr] {
    seek(mut f, 2);
    let mut sizes: Vec[i64] = Vec.new();
    loop {
        let c = read(mut f, 1);
        if c.len() == 1 and is_space(byte(c, 0)) {
            continue;
        }
        if c.len() == 0 {
            return Err(value_err("Invalid Netpbm file"));
        }
        if c[0] == 35 {
            let _ = readline(mut f);
            continue;
        }
        if not is_digit(byte(c, 0)) {
            return Err(value_err("Invalid character found on Netpbm file"));
        }
        let mut v = byte(c, 0) - 48;
        let mut next = read(mut f, 1);
        while next.len() == 1 and is_digit(byte(next, 0)) {
            v = v * 10 + byte(next, 0) - 48;
            next = read(mut f, 1);
        }
        sizes.push(v);
        if sizes.len() == 2 {
            break;
        }
        seek_rel(mut f, -1);
    }
    Ok(Size.I(sizes[0], sizes[1]))
}

fn webp_size(head: ref Vec[u8]) -> Result[Size, PyErr] {
    let kind = sl(head, 12, 16);
    if is(kind, "VP8 ") {
        let s = sl(head, 26, 30);
        need(s, 4)?;
        Ok(Size.I(le(s, 0, 2), le(s, 2, 2)))
    } else if is(kind, "VP8X") {
        let mut w = sl(head, 24, 27);
        w.push(0);
        need(w, 4)?;
        let mut h = sl(head, 27, 30);
        h.push(0);
        need(h, 4)?;
        Ok(Size.I(le(w, 0, 3), le(h, 0, 3)))
    } else if is(kind, "VP8L") {
        let b = sl(head, 21, 25);
        if b.len() < 4 {
            return Err(py_err("IndexError", "index out of range".to_string()));
        }
        let w = (((byte(b, 1) & 63) << 8) | byte(b, 0)) + 1;
        let h = (((byte(b, 3) & 15) << 10) | (byte(b, 2) << 2) | ((byte(b, 1) & 192) >> 6)) + 1;
        Ok(Size.I(w, h))
    } else {
        Err(value_err("Unsupported WebP file"))
    }
}

fn is_png(head: ref Vec[u8]) -> bool {
    head.len() >= 8 and be(head, 0, 4) == 0x89504e47 and be(head, 4, 4) == 0x0d0a1a0a
}

fn is_gif(head: ref Vec[u8]) -> bool {
    head.len() >= 10 and (starts(head, "GIF87a") or starts(head, "GIF89a"))
}

fn is_jp2(head: ref Vec[u8]) -> bool {
    head.len() >= 12 and be(head, 0, 4) == 12 and is(sl(head, 4, 8), "jP  ") and be(head, 8, 4) == 0x0d0a870a
}

fn signed16(v: i64) -> i64 {
    if v >= 32768 { v - 65536 } else { v }
}

// imagesize.get
fn get(path: ref String) -> Result[Size, PyErr] {
    let mut f = open_file(path)?;
    let head = read(mut f, 31);
    let size = head.len() as i64;
    if is_gif(head) {
        return Ok(Size.I(signed16(le(head, 6, 2)), signed16(le(head, 8, 2))));
    }
    if size >= 24 and is_png(head) and is(sl(head, 12, 16), "IHDR") {
        return Ok(Size.I(be(head, 16, 4), be(head, 20, 4)));
    }
    if size >= 16 and is_png(head) {
        return Ok(Size.I(be(head, 8, 4), be(head, 12, 4)));
    }
    if size >= 2 and byte(head, 0) == 0xff and byte(head, 1) == 0xd8 {
        return match jpeg_size(mut f) {
            Some((w, h)) => Ok(Size.I(w, h)),
            None => Err(value_err("Invalid JPEG file")),
        };
    }
    if is_jp2(head) {
        seek(mut f, 48);
        let d = read(mut f, 8);
        if d.len() != 8 {
            return Err(value_err("Invalid JPEG2000 file"));
        }
        return Ok(Size.I(be(d, 4, 4), be(d, 0, 4)));
    }
    if size >= 8 and starts(head, "MM") and be(head, 2, 2) == 42 {
        seek(mut f, be(head, 4, 4));
        return tiff_ifd(mut f, false, false, "Invalid TIFF file: width and/or height IDS entries are missing.");
    }
    if size >= 8 and starts(head, "II") and le(head, 2, 2) == 42 {
        seek(mut f, le(head, 4, 4));
        return tiff_ifd(mut f, false, true, "Invalid TIFF file: width and/or height IDS entries are missing.");
    }
    if size >= 8 and starts(head, "II") and le(head, 2, 2) == 43 {
        if le(head, 4, 4) != 8 {
            // The library's message formats `offset` before assigning it.
            return Err(py_err("UnboundLocalError", "cannot access local variable 'offset' where it is not associated with a value".to_string()));
        }
        let o = sl(head, 8, 16);
        need(o, 8)?;
        seek(mut f, le(o, 0, 8));
        return tiff_ifd(mut f, true, true, "Invalid BigTIFF file: width and/or height IDS entries are missing.");
    }
    if size >= 5 and (starts(head, "<?xml") or starts(head, "<svg")) {
        seek(mut f, 0);
        let data = read(mut f, 1024);
        if String.from_utf8(data.clone()).is_err() {
            return Err(value_err("Invalid SVG file"));
        }
        let w = match svg_attr(data, "width") {
            Some(v) => v,
            None => return Err(value_err("Invalid SVG file")),
        };
        let h = match svg_attr(data, "height") {
            Some(v) => v,
            None => return Err(value_err("Invalid SVG file")),
        };
        let wp = convert_to_px(w)?;
        let hp = convert_to_px(h)?;
        return Ok(Size.F(wp, hp));
    }
    // head[1:2] in b"123456" is true for an empty slice too
    if size >= 1 and byte(head, 0) == 80 and (size == 1 or (byte(head, 1) >= 49 and byte(head, 1) <= 54)) {
        return netpbm_size(mut f);
    }
    if starts(head, "RIFF") and is(sl(head, 8, 12), "WEBP") {
        return webp_size(head);
    }
    Ok(Size.I(-1, -1))
}

fn png_dpi(f: mut ref Cursor, head: ref Vec[u8]) -> Result[(i64, i64), PyErr] {
    let mut offset: i64 = 8;
    let mut chunk = sl(head, 8, head.len() as i64);
    loop {
        let kind = sl(chunk, 4, 8);
        if is(kind, "pHYs") {
            let body = sl(chunk, 8, chunk.len() as i64);
            if body.len() != 9 {
                return Err(value_err("Invalid PNG file"));
            }
            let x = be(body, 0, 4);
            let y = be(body, 4, 4);
            if byte(body, 8) != 0 {
                return Ok((convert_to_dpi(x, 0), convert_to_dpi(y, 0)));
            }
            return Ok((x, y));
        } else if is(kind, "IDAT") {
            return Ok((-1, -1));
        }
        let n = sl(chunk, 0, 4);
        if n.len() != 4 {
            return Err(value_err("Invalid PNG file"));
        }
        offset += be(n, 0, 4) + 12;
        seek(mut f, offset);
        chunk = read(mut f, 17);
    }
}

fn ord_err() -> PyErr {
    py_err("TypeError", "ord() expected a character, but string of length 0 found".to_string())
}

// getDPI's own JPEG loop: it stops at the first marker from 0xc0 to 0xcf,
// or reads the JFIF density at the APP0 segment. Only struct.error becomes
// "Invalid JPEG file"; the TypeError from ord(b"") gets out as it is.
fn jpeg_dpi(f: mut ref Cursor) -> Result[(i64, i64), PyErr] {
    seek(mut f, 0);
    let mut size: i64 = 2;
    let mut ftype: i64 = 0;
    while not (ftype >= 0xc0 and ftype <= 0xcf) {
        if ftype == 0xe0 {
            seek_rel(mut f, 7);
            let d = read(mut f, 5);
            if d.len() != 5 {
                return Err(value_err("Invalid JPEG file"));
            }
            let unit = byte(d, 0);
            let x = be(d, 1, 2);
            let y = be(d, 3, 2);
            if unit == 1 or unit == 0 {
                return Ok((x, y));
            } else if unit == 2 {
                return Ok((convert_to_dpi(x, 2), convert_to_dpi(y, 2)));
            }
            return Ok((-1, -1));
        }
        seek_rel(mut f, size);
        let mut b = read(mut f, 1);
        if b.len() == 0 {
            return Err(ord_err());
        }
        while b[0] == 0xff {
            b = read(mut f, 1);
            if b.len() == 0 {
                return Err(ord_err());
            }
        }
        ftype = b[0] as i64;
        let l = read(mut f, 2);
        if l.len() != 2 {
            return Err(value_err("Invalid JPEG file"));
        }
        size = be(l, 0, 2) - 2;
    }
    Ok((-1, -1))
}

fn jp2_dpi(f: mut ref Cursor) -> Result[(i64, i64), PyErr] {
    seek(mut f, 32);
    let hs = read(mut f, 4);
    need(hs, 4)?;
    let mut header_size = be(hs, 0, 4) - 8;
    seek_rel(mut f, 4);
    let bad = value_err("Invalid JPEG2000 file");
    let mut found = false;
    while header_size > 0 {
        let bh = read(mut f, 8);
        if is(sl(bh, 4, 8), "res ") {
            found = true;
            header_size -= 8;
            break;
        }
        let n = sl(bh, 0, 4);
        if n.len() != 4 {
            return Err(bad);
        }
        let box_size = be(n, 0, 4);
        seek_rel(mut f, box_size - 8);
        header_size -= box_size;
    }
    if found {
        while header_size > 0 {
            let bh = read(mut f, 8);
            if is(sl(bh, 4, 8), "resd") {
                // read(10) unpacked as ">HHBB": six bytes, or struct.error
                let d = read(mut f, 10);
                if d.len() != 6 {
                    return Err(bad);
                }
                let y_density = be(d, 0, 2);
                let x_density = be(d, 2, 2);
                let y_unit = byte(d, 4);
                let x_unit = byte(d, 5);
                return Ok((convert_to_dpi(x_density, x_unit), convert_to_dpi(y_density, y_unit)));
            }
            let n = sl(bh, 0, 4);
            if n.len() != 4 {
                return Err(bad);
            }
            let box_size = be(n, 0, 4);
            seek_rel(mut f, box_size - 8);
            header_size -= box_size;
        }
    }
    Ok((-1, -1))
}

// imagesize.getDPI
fn get_dpi(path: ref String) -> Result[(i64, i64), PyErr] {
    let mut f = open_file(path)?;
    let head = read(mut f, 24);
    let size = head.len() as i64;
    if is_gif(head) {
        return Ok((-1, -1));
    }
    if size >= 24 and is_png(head) {
        return png_dpi(mut f, head);
    }
    if size >= 2 and byte(head, 0) == 0xff and byte(head, 1) == 0xd8 {
        return jpeg_dpi(mut f);
    }
    if is_jp2(head) {
        return jp2_dpi(mut f);
    }
    Ok((-1, -1))
}

// ------------------------------------------------------------ programs

fn err_text(e: ref PyErr) -> String {
    f"error {e.cls}: {e.msg}"
}

fn split_on(s: ref String, sep: char) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn lines_of(path: ref String) -> Vec[String] {
    let text = fs.read_to_string(f"data/{path}").unwrap_or(String.new());
    let mut out = split_on(text, '\n');
    if out.len() > 0 and out[out.len() - 1].len() == 0 {
        let _ = out.pop();
    }
    out
}

// Python's round() on a float: halves go to the even neighbour.
fn py_round(x: f64) -> i64 {
    let fl = x.floor();
    let diff = x - fl;
    if diff > 0.5 {
        fl as i64 + 1
    } else if diff < 0.5 {
        fl as i64
    } else if (fl as i64) % 2 == 0 {
        fl as i64
    } else {
        fl as i64 + 1
    }
}

fn gallery(path: ref String) {
    for line in lines_of(path) {
        let f = split_on(line, '\t');
        let name = f[0].clone();
        let size = match get(f"images/{name}") {
            Ok(s) => s,
            Err(e) => {
                println(f"  <!-- {name}: {err_text(e)} -->");
                continue;
            }
        };
        let s = i64.parse(f[1].clone()).unwrap_or(0);
        let (tw, th) = match size {
            Size.I(w, h) => {
                if w == -1 or h == -1 {
                    println(f"  <!-- {name}: unknown size -->");
                    continue;
                }
                (((w * s) as f64 / 100.0) as i64, ((h * s) as f64 / 100.0) as i64)
            }
            Size.F(w, h) => ((w * (s as f64) / 100.0) as i64, (h * (s as f64) / 100.0) as i64),
        };
        println(f"  <img src=\"images/{name}\" width=\"{tw}\" height=\"{th}\" alt=\"{f[2]}\">");
    }
}

fn thumbs(path: ref String) {
    for name in lines_of(path) {
        let size = match get(f"images/{name}") {
            Ok(s) => s,
            Err(e) => {
                println(f"  {name}: {err_text(e)}");
                continue;
            }
        };
        let (w, h, ints) = match size {
            Size.I(w, h) => (w as f64, h as f64, true),
            Size.F(w, h) => (w, h, false),
        };
        if w <= 0.0 or h <= 0.0 {
            println(f"  {name}: no size {size_repr(size)}");
            continue;
        }
        let mut s = 320.0 / w;
        if 240.0 / h < s {
            s = 240.0 / h;
        }
        if 1.0 < s {
            s = 1.0;
        }
        let mut tw = py_round(w * s);
        if tw < 1 {
            tw = 1;
        }
        let mut th = py_round(h * s);
        if th < 1 {
            th = 1;
        }
        let shown = match size {
            Size.I(a, b) => f"{a}x{b}",
            Size.F(a, b) => f"{a}x{b}",
        };
        println(f"  {name}: {shown} -> {tw}x{th}");
        match get_dpi(f"images/{name}") {
            Err(e) => println(f"    dpi: {err_text(e)}"),
            Ok(d) => {
                if d.0 > 0 and d.1 > 0 and ints {
                    let pw = (w as i64) * 254 / d.0;
                    let ph = (h as i64) * 254 / d.1;
                    let pwc = pw % 100;
                    let phc = ph % 100;
                    let pws = if pwc < 10 { f"0{pwc}" } else { f"{pwc}" };
                    let phs = if phc < 10 { f"0{phc}" } else { f"{phc}" };
                    println(f"    print: {pw / 100}.{pws} x {ph / 100}.{phs} cm at {d.0}x{d.1} dpi");
                } else {
                    println(f"    dpi: {pair_repr(d)}");
                }
            }
        }
    }
}

fn is_word(c: char) -> bool {
    c.is_alphanumeric() or c == '_'
}

// re.findall(r"""(\w+)=("[^"]*"|'[^']*')""", body), later keys winning.
fn img_attrs(body: ref Vec[char]) -> Map[String, String] {
    let mut out: Map[String, String] = Map.new();
    let n = body.len();
    let mut i = 0;
    while i < n {
        if not is_word(body[i]) {
            i += 1;
            continue;
        }
        let mut j = i;
        while j < n and is_word(body[j]) {
            j += 1;
        }
        if j + 1 < n and body[j] == '=' and (body[j + 1] == '"' or body[j + 1] == '\'') {
            let q = body[j + 1];
            let mut k = j + 2;
            while k < n and body[k] != q {
                k += 1;
            }
            if k < n {
                let key: String = body[i..j].iter().collect();
                let val: String = body[j + 2..k].iter().collect();
                out.insert(key, val);
                i = k + 1;
                continue;
            }
        }
        i += 1;
    }
    out
}

fn size_round(s: ref Size) -> (i64, i64) {
    match s {
        Size.I(w, h) => (w, h),
        Size.F(w, h) => (py_round(w), py_round(h)),
    }
}

fn audit(path: ref String) {
    let page: Vec[char] = fs.read_to_string(f"data/{path}").unwrap_or(String.new()).chars().collect();
    let n = page.len();
    let mut i = 0;
    while i + 4 <= n {
        // <img\b([^>]*)>
        let starts_img = page[i] == '<' and page[i + 1] == 'i' and page[i + 2] == 'm' and page[i + 3] == 'g';
        if not starts_img or (i + 4 < n and is_word(page[i + 4])) {
            i += 1;
            continue;
        }
        let mut k = i + 4;
        while k < n and page[k] != '>' {
            k += 1;
        }
        if k >= n {
            i += 1;
            continue;
        }
        let body: Vec[char] = page[i + 4..k].to_vec();
        i = k + 1;
        let attrs = img_attrs(body);
        let src = match attrs.get("src") {
            Some(s) => s.clone(),
            None => String.new(),
        };
        let size = match get(src) {
            Ok(s) => s,
            Err(e) => {
                println(f"  {src}: {err_text(e)}");
                continue;
            }
        };
        if let Size.I(-1, _) = size {
            println(f"  {src}: not an image imagesize knows");
            continue;
        }
        if let Size.I(_, -1) = size {
            println(f"  {src}: not an image imagesize knows");
            continue;
        }
        let (aw, ah) = size_round(size);
        let (dws, dhs) = match (attrs.get("width"), attrs.get("height")) {
            (Some(a), Some(b)) => (a.clone(), b.clone()),
            _ => {
                println(f"  {src}: no width/height attributes, actual {aw}x{ah}");
                continue;
            }
        };
        let dw = i64.parse(dws).unwrap_or(0);
        let dh = i64.parse(dhs).unwrap_or(0);
        if dw == aw and dh == ah {
            println(f"  {src}: ok {aw}x{ah}");
        } else {
            println(f"  {src}: mismatch, declared {dw}x{dh}, actual {aw}x{ah}");
        }
    }
}

// ------------------------------------------------------------ main

fn hex_digit(c: char) -> i64 {
    if c >= '0' and c <= '9' {
        c as i64 - 48
    } else if c >= 'a' and c <= 'f' {
        c as i64 - 87
    } else {
        0
    }
}

fn hex_bytes(s: ref String) -> Vec[u8] {
    let cs: Vec[char] = s.chars().collect();
    let mut out: Vec[u8] = Vec.new();
    let mut k = 0;
    while k + 1 < cs.len() {
        out.push((hex_digit(cs[k]) * 16 + hex_digit(cs[k + 1])) as u8);
        k += 2;
    }
    out
}

fn dirname_of(p: ref String) -> String {
    let cs: Vec[char] = p.chars().collect();
    let mut cut = 0;
    let mut k = 0;
    while k < cs.len() {
        if cs[k] == '/' {
            cut = k;
        }
        k += 1;
    }
    cs[0..cut].iter().collect()
}

fn write_inputs() -> Result[(), String] {
    let _ = fs.create_dir_all("data".to_string());
    for line in split_on(inputs_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, ' ');
        let path = f"data/{f[0]}";
        let _ = fs.create_dir_all(dirname_of(path));
        let bytes = if f.len() > 1 { hex_bytes(f[1]) } else { Vec.new() };
        if let Err(e) = fs.write_bytes(path, bytes) {
            return Err(f"cannot write {f[0]}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_inputs() {
        eprintln(e);
        return;
    }
    for line in split_on(jobs_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let job = String.from_utf8(hex_bytes(line)).unwrap_or(String.new());
        if job.starts_with("#") {
            println(job);
            continue;
        }
        println(f"> {job}");
        if job.starts_with("!") {
            let f = split_on(job, ' ');
            if f[0] == "!gallery" {
                gallery(f[1]);
            } else if f[0] == "!thumbs" {
                thumbs(f[1]);
            } else {
                audit(f[1]);
            }
            continue;
        }
        match get(job) {
            Ok(s) => println(f"  get: {size_repr(s)}"),
            Err(e) => println(f"  get: {err_text(e)}"),
        }
        match get_dpi(job) {
            Ok(d) => println(f"  getDPI: {pair_repr(d)}"),
            Err(e) => println(f"  getDPI: {err_text(e)}"),
        }
    }
}

