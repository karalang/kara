// ------------------------------------------------------------ Python str helpers

fn hex_digits(n: i64, width: i64) -> String {
    let d: Vec[char] = "0123456789abcdef".chars().collect();
    let mut out = String.new();
    let mut k = width;
    while k > 0 {
        k -= 1;
        out.push(d[(n >> (4 * k)) & 15]);
    }
    out
}

// str.isprintable(), for the characters property files hold.
fn py_printable(c: char) -> bool {
    let n = c as i64;
    if n < 0x20 or (n >= 0x7f and n <= 0xa0) or n == 0xad {
        return false;
    }
    if n == 0x1680 or (n >= 0x2000 and n <= 0x200f) or (n >= 0x2028 and n <= 0x202f) {
        return false;
    }
    if (n >= 0x205f and n <= 0x206f) or n == 0x3000 or n == 0xfeff or n == 0xfffe or n == 0xffff or (n >= 0xfff9 and n <= 0xfffb) {
        return false;
    }
    not (n >= 0xe000 and n <= 0xf8ff)
}

// repr() of a str.
fn py_repr_str(s: ref String) -> String {
    let q = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if py_printable(c) {
            out.push(c);
        } else {
            let n = c as i64;
            if n < 0x100 {
                out.push_str(f"\\x{hex_digits(n, 2)}");
            } else if n < 0x10000 {
                out.push_str(f"\\u{hex_digits(n, 4)}");
            } else {
                out.push_str(f"\\U{hex_digits(n, 8)}");
            }
        }
    }
    out.push(q);
    out
}
// ------------------------------------------------------------ text helpers (from mini_urlparse)

fn byte_str(b: ref Vec[u8], from: i64, to: i64) -> String {
    let mut v: Vec[u8] = Vec.new();
    for i in from..to {
        v.push(b[i]);
    }
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn to_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn from_bytes(v: Vec[u8]) -> String {
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

// str.split(sep) for a one-byte separator
fn split_on(s: Str, sep: u8) -> Vec[String] {
    let sep_s = (sep as char).to_string();
    let mut out: Vec[String] = Vec.new();
    for part in s.split(sep_s) {
        out.push(part.to_string());
    }
    out
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

fn lines_of(text: Str) -> Vec[String] {
    let mut v = split_on(text, b'\n');
    if v.len() > 0 and v[v.len() - 1].len() == 0 {
        v.pop();
    }
    v
}

fn sort_strings(v: own Vec[String]) -> Vec[String] {
    let mut v = v;
    for i in 1..v.len() {
        let mut j = i;
        while j > 0 and v[j - 1] > v[j] {
            v.swap(j - 1, j);
            j -= 1;
        }
    }
    v
}

fn hex_val(c: u8) -> u8 {
    if is_digit(c) {
        c - b'0'
    } else if c >= b'a' and c <= b'f' {
        c - b'a' + 10
    } else {
        c - b'A' + 10
    }
}
// ------------------------------------------------------------ the jobs

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data_files() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn read_text(rel: ref String) -> String {
    match fs.read_to_string(f"data/{rel}") {
        Ok(s) => s,
        Err(_) => "".to_string(),
    }
}

// bytes.fromhex: pairs of hex digits, spaces between them allowed.
fn unhex(s: ref String) -> Vec[u8] {
    let mut digits: Vec[u8] = Vec.new();
    for c in s.bytes() {
        if c != b' ' {
            digits.push(c);
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < digits.len() {
        out.push((hex_val(digits[i]) * 16 + hex_val(digits[i + 1])) as u8);
        i += 2;
    }
    out
}
// ------------------------------------------------------------ errors

struct Exc {
    kind: String,
    msg: String,
}

fn wave_error(msg: Str) -> Exc {
    Exc { kind: "Error".to_string(), msg: msg.to_string() }
}

fn bare(kind: Str) -> Exc {
    Exc { kind: kind.to_string(), msg: String.new() }
}

fn not_found(path: ref String) -> Exc {
    Exc { kind: "FileNotFoundError".to_string(), msg: f"[Errno 2] No such file or directory: {py_repr_str(path)}" }
}

fn err_text(e: ref Exc) -> String {
    f"error: {e.kind}: {e.msg}"
}

fn hex_of(b: ref Vec[u8]) -> String {
    let mut out = String.new();
    for x in b.iter() {
        out.push_str(hex_digits(*x as i64, 2));
    }
    out
}

fn le(b: ref Vec[u8], at: i64, n: i64) -> i64 {
    let mut v: i64 = 0;
    let mut k = n;
    while k > 0 {
        k -= 1;
        v = v * 256 + b[at + k] as i64;
    }
    v
}

fn put_le(out: mut ref Vec[u8], v: i64, n: i64) {
    for k in 0..n {
        out.push(((v >> (8 * k)) & 0xFF) as u8);
    }
}

fn same(b: ref Vec[u8], s: Str) -> bool {
    *b == to_bytes(s)
}

// ------------------------------------------------------------ wave.py's _Chunk
// The file is its bytes and a position; seeking past the end is allowed
// and reads there give nothing, as with a real file. The RIFF chunk reads
// from the file and every other chunk reads from the RIFF chunk, so a
// RIFF size that is too small or too big shows through, as in wave.py.

struct RawFile {
    data: Vec[u8],
    pos: i64,
}

fn raw_read(f: mut ref RawFile, n: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut k = 0;
    while k < n and f.pos < f.data.len() {
        out.push(f.data[f.pos]);
        f.pos += 1;
        k += 1;
    }
    out
}

struct Chunk {
    name: Vec[u8],
    size: i64,
    size_read: i64,
    offset: i64,
}

fn header_of(name: own Vec[u8], size_bytes: ref Vec[u8], offset: i64) -> Result[Chunk, Exc] {
    if name.len() < 4 {
        return Err(bare("EOFError"));
    }
    if size_bytes.len() < 4 {
        return Err(bare("EOFError"));
    }
    Ok(Chunk { name: name, size: le(size_bytes, 0, 4), size_read: 0, offset: offset })
}

fn riff_open(f: mut ref RawFile) -> Result[Chunk, Exc] {
    let name = raw_read(mut f, 4);
    if name.len() < 4 {
        return Err(bare("EOFError"));
    }
    let size = raw_read(mut f, 4);
    header_of(name, size, f.pos)
}

// How many bytes a read of `size` takes from a chunk.
fn read_len(c: ref Chunk, size: i64) -> i64 {
    let left = c.size - c.size_read;
    if size < 0 or size > left { left } else { size }
}

fn riff_read(f: mut ref RawFile, riff: mut ref Chunk, size: i64) -> Vec[u8] {
    if riff.size_read >= riff.size {
        return Vec.new();
    }
    let data = raw_read(mut f, read_len(riff, size));
    riff.size_read += data.len();
    if riff.size_read == riff.size and (riff.size & 1) == 1 {
        let pad = raw_read(mut f, 1);
        riff.size_read += pad.len();
    }
    data
}

fn riff_seek(f: mut ref RawFile, riff: mut ref Chunk, pos: i64) -> Result[(), Exc] {
    if pos < 0 or pos > riff.size {
        return Err(bare("RuntimeError"));
    }
    f.pos = riff.offset + pos;
    riff.size_read = pos;
    Ok(())
}

fn inner_open(f: mut ref RawFile, riff: mut ref Chunk) -> Result[Chunk, Exc] {
    let name = riff_read(mut f, mut riff, 4);
    if name.len() < 4 {
        return Err(bare("EOFError"));
    }
    let size = riff_read(mut f, mut riff, 4);
    header_of(name, size, riff.size_read)
}

fn inner_read(f: mut ref RawFile, riff: mut ref Chunk, c: mut ref Chunk, size: i64) -> Vec[u8] {
    if c.size_read >= c.size {
        return Vec.new();
    }
    let data = riff_read(mut f, mut riff, read_len(c, size));
    c.size_read += data.len();
    if c.size_read == c.size and (c.size & 1) == 1 {
        let pad = riff_read(mut f, mut riff, 1);
        c.size_read += pad.len();
    }
    data
}

fn inner_seek(f: mut ref RawFile, riff: mut ref Chunk, c: mut ref Chunk, pos: i64) -> Result[(), Exc] {
    if pos < 0 or pos > c.size {
        return Err(bare("RuntimeError"));
    }
    riff_seek(mut f, mut riff, c.offset + pos)?;
    c.size_read = pos;
    Ok(())
}

// skip(): a relative seek of the RIFF chunk, which refuses to go past
// its end with a bare RuntimeError that skip() does not catch.
fn inner_skip(f: mut ref RawFile, riff: mut ref Chunk, c: mut ref Chunk) -> Result[(), Exc] {
    let mut n = c.size - c.size_read;
    if (c.size & 1) == 1 {
        n += 1;
    }
    let to = n + riff.size_read;
    riff_seek(mut f, mut riff, to)?;
    c.size_read += n;
    Ok(())
}

// ------------------------------------------------------------ Wave_read

struct Reader {
    file: RawFile,
    riff: Chunk,
    data: Chunk,
    nchannels: i64,
    sampwidth: i64,
    framerate: i64,
    framesize: i64,
    nframes: i64,
    soundpos: i64,
    seek_needed: bool,
}

struct Fmt {
    nchannels: i64,
    sampwidth: i64,
    framerate: i64,
}

fn uuid_le(b: ref Vec[u8]) -> String {
    let order = [3, 2, 1, 0, 5, 4, 7, 6, 8, 9, 10, 11, 12, 13, 14, 15];
    let mut out = String.new();
    for i in 0..16 {
        if i == 4 or i == 6 or i == 8 or i == 10 {
            out.push('-');
        }
        out.push_str(hex_digits(b[order[i]] as i64, 2));
    }
    out
}

fn read_fmt(f: mut ref RawFile, riff: mut ref Chunk, c: mut ref Chunk) -> Result[Fmt, Exc] {
    let head = inner_read(mut f, mut riff, mut c, 14);
    if head.len() < 14 {
        return Err(bare("EOFError"));
    }
    let tag = le(head, 0, 2);
    if tag != 1 and tag != 0xFFFE {
        return Err(Exc { kind: "Error".to_string(), msg: f"unknown format: {tag}" });
    }
    let bits_b = inner_read(mut f, mut riff, mut c, 2);
    if bits_b.len() < 2 {
        return Err(bare("EOFError"));
    }
    if tag == 0xFFFE {
        let ext = inner_read(mut f, mut riff, mut c, 8);
        if ext.len() < 8 {
            return Err(bare("EOFError"));
        }
        let sub = inner_read(mut f, mut riff, mut c, 16);
        if sub.len() < 16 {
            return Err(bare("EOFError"));
        }
        let pcm = [1u8, 0, 0, 0, 0, 0, 0x10, 0, 0x80, 0, 0, 0xaa, 0, 0x38, 0x9b, 0x71];
        if sub != pcm {
            return Err(Exc { kind: "Error".to_string(), msg: f"unknown extended format: {uuid_le(sub)}" });
        }
    }
    let sampwidth = (le(bits_b, 0, 2) + 7) / 8;
    if sampwidth == 0 {
        return Err(wave_error("bad sample width"));
    }
    let nchannels = le(head, 2, 2);
    if nchannels == 0 {
        return Err(wave_error("bad # of channels"));
    }
    Ok(Fmt { nchannels: nchannels, sampwidth: sampwidth, framerate: le(head, 4, 4) })
}

fn open_reader(path: ref String) -> Result[Reader, Exc] {
    let bytes = match fs.read_bytes(f"data/{path}") {
        Ok(b) => b,
        Err(_) => return Err(not_found(path)),
    };
    let mut file = RawFile { data: bytes, pos: 0 };
    let mut riff = riff_open(mut file)?;
    if not same(riff.name, "RIFF") {
        return Err(wave_error("file does not start with RIFF id"));
    }
    if not same(riff_read(mut file, mut riff, 4), "WAVE") {
        return Err(wave_error("not a WAVE file"));
    }
    let mut fmt: Option[Fmt] = None;
    let mut data: Option[Chunk] = None;
    loop {
        let mut chunk = match inner_open(mut file, mut riff) {
            Ok(c) => c,
            Err(_) => break,
        };
        if same(chunk.name, "fmt ") {
            fmt = Some(read_fmt(mut file, mut riff, mut chunk)?);
        } else if same(chunk.name, "data") {
            if fmt.is_none() {
                return Err(wave_error("data chunk before fmt chunk"));
            }
            data = Some(chunk);
            break;
        }
        inner_skip(mut file, mut riff, mut chunk)?;
    }
    let (fm, dc) = match (fmt, data) {
        (Some(fm), Some(dc)) => (fm, dc),
        _ => return Err(wave_error("fmt chunk and/or data chunk missing")),
    };
    let framesize = fm.nchannels * fm.sampwidth;
    let nframes = dc.size / framesize;
    Ok(Reader {
        file: file,
        riff: riff,
        data: dc,
        nchannels: fm.nchannels,
        sampwidth: fm.sampwidth,
        framerate: fm.framerate,
        framesize: framesize,
        nframes: nframes,
        soundpos: 0,
        seek_needed: false,
    })
}

impl Reader {
    fn params(ref self) -> String {
        f"_wave_params(nchannels={self.nchannels}, sampwidth={self.sampwidth}, framerate={self.framerate}, nframes={self.nframes}, comptype='NONE', compname='not compressed')"
    }

    fn setpos(mut ref self, pos: i64) -> Result[(), Exc] {
        if pos < 0 or pos > self.nframes {
            return Err(wave_error("position not in range"));
        }
        self.soundpos = pos;
        self.seek_needed = true;
        Ok(())
    }

    fn rewind(mut ref self) {
        self.seek_needed = true;
        self.soundpos = 0;
    }

    fn readframes(mut ref self, n: i64) -> Result[Vec[u8], Exc] {
        if self.seek_needed {
            inner_seek(mut self.file, mut self.riff, mut self.data, 0)?;
            let pos = self.soundpos * self.framesize;
            if pos != 0 {
                inner_seek(mut self.file, mut self.riff, mut self.data, pos)?;
            }
            self.seek_needed = false;
        }
        if n == 0 {
            return Ok(Vec.new());
        }
        let got = inner_read(mut self.file, mut self.riff, mut self.data, n * self.framesize);
        self.soundpos += got.len() / self.framesize;
        Ok(got)
    }
}

// ------------------------------------------------------------ Wave_write
// The file is created when the writer opens and holds what the writer
// wrote when it closes; seek and tell work on that buffer.

struct Writer {
    path: String,
    buf: Vec[u8],
    pos: i64,
    open: bool,
    nchannels: i64,
    sampwidth: i64,
    framerate: i64,
    nframes: i64,
    nframeswritten: i64,
    datawritten: i64,
    datalength: i64,
    headerwritten: bool,
    comptype: Option[String],
    compname: Option[String],
    form_length_pos: i64,
    data_length_pos: i64,
}

fn open_writer(path: ref String) -> Writer {
    let _ = fs.write_bytes(f"data/{path}", Vec.new());
    Writer {
        path: path.clone(),
        buf: Vec.new(),
        pos: 0,
        open: true,
        nchannels: 0,
        sampwidth: 0,
        framerate: 0,
        nframes: 0,
        nframeswritten: 0,
        datawritten: 0,
        datalength: 0,
        headerwritten: false,
        comptype: None,
        compname: None,
        form_length_pos: 0,
        data_length_pos: 0,
    }
}

// int(round(x)): round half to even.
fn py_round(x: f64) -> i64 {
    let fl = x.floor();
    let d = x - fl;
    let n = fl as i64;
    if d > 0.5 {
        n + 1
    } else if d < 0.5 {
        n
    } else if n % 2 == 0 {
        n
    } else {
        n + 1
    }
}

fn changing(w: ref Writer) -> Result[(), Exc] {
    if w.datawritten != 0 {
        return Err(wave_error("cannot change parameters after starting to write"));
    }
    Ok(())
}

fn no_attr(owner: Str, name: Str) -> Exc {
    Exc { kind: "AttributeError".to_string(), msg: f"'{owner}' object has no attribute '{name}'" }
}

impl Writer {
    fn setnchannels(mut ref self, n: i64) -> Result[(), Exc] {
        changing(self)?;
        if n < 1 {
            return Err(wave_error("bad # of channels"));
        }
        self.nchannels = n;
        Ok(())
    }

    fn setsampwidth(mut ref self, n: i64) -> Result[(), Exc] {
        changing(self)?;
        if n < 1 or n > 4 {
            return Err(wave_error("bad sample width"));
        }
        self.sampwidth = n;
        Ok(())
    }

    fn setframerate(mut ref self, rate: f64) -> Result[(), Exc] {
        changing(self)?;
        if rate <= 0.0 {
            return Err(wave_error("bad frame rate"));
        }
        self.framerate = py_round(rate);
        Ok(())
    }

    fn setnframes(mut ref self, n: i64) -> Result[(), Exc] {
        changing(self)?;
        self.nframes = n;
        Ok(())
    }

    fn setcomptype(mut ref self, kind: ref String, name: ref String) -> Result[(), Exc] {
        changing(self)?;
        if kind != "NONE" {
            return Err(wave_error("unsupported compression type"));
        }
        self.comptype = Some(kind.clone());
        self.compname = Some(name.clone());
        Ok(())
    }

    fn setparams(mut ref self, nch: i64, sw: i64, rate: i64, nframes: i64, kind: ref String, name: ref String) -> Result[(), Exc] {
        changing(self)?;
        self.setnchannels(nch)?;
        self.setsampwidth(sw)?;
        self.setframerate(rate as f64)?;
        self.setnframes(nframes)?;
        self.setcomptype(kind, name)
    }

    fn getparams(ref self) -> Result[String, Exc] {
        if self.nchannels == 0 or self.sampwidth == 0 or self.framerate == 0 {
            return Err(wave_error("not all parameters set"));
        }
        let kind = match self.comptype {
            Some(k) => k.clone(),
            None => return Err(no_attr("Wave_write", "_comptype")),
        };
        let name = match self.compname {
            Some(k) => k.clone(),
            None => return Err(no_attr("Wave_write", "_compname")),
        };
        Ok(f"_wave_params(nchannels={self.nchannels}, sampwidth={self.sampwidth}, framerate={self.framerate}, nframes={self.nframes}, comptype={py_repr_str(kind)}, compname={py_repr_str(name)})")
    }

    fn put(mut ref self, b: ref Vec[u8]) {
        for x in b.iter() {
            if self.pos < self.buf.len() {
                self.buf[self.pos] = *x;
            } else {
                self.buf.push(*x);
            }
            self.pos += 1;
        }
    }

    fn ensure_header(mut ref self, datasize: i64) -> Result[(), Exc] {
        if self.headerwritten {
            return Ok(());
        }
        if self.nchannels == 0 {
            return Err(wave_error("# channels not specified"));
        }
        if self.sampwidth == 0 {
            return Err(wave_error("sample width not specified"));
        }
        if self.framerate == 0 {
            return Err(wave_error("sampling rate not specified"));
        }
        self.put(to_bytes("RIFF"));
        if self.nframes == 0 {
            self.nframes = datasize / (self.nchannels * self.sampwidth);
        }
        self.datalength = self.nframes * self.nchannels * self.sampwidth;
        self.form_length_pos = self.pos;
        let mut h: Vec[u8] = Vec.new();
        put_le(mut h, 36 + self.datalength, 4);
        for c in to_bytes("WAVEfmt ").iter() {
            h.push(*c);
        }
        put_le(mut h, 16, 4);
        put_le(mut h, 1, 2);
        put_le(mut h, self.nchannels, 2);
        put_le(mut h, self.framerate, 4);
        put_le(mut h, self.nchannels * self.framerate * self.sampwidth, 4);
        put_le(mut h, self.nchannels * self.sampwidth, 2);
        put_le(mut h, self.sampwidth * 8, 2);
        for c in to_bytes("data").iter() {
            h.push(*c);
        }
        self.put(h);
        self.data_length_pos = self.pos;
        let mut n: Vec[u8] = Vec.new();
        put_le(mut n, self.datalength, 4);
        self.put(n);
        self.headerwritten = true;
        Ok(())
    }

    fn patch(mut ref self) {
        if self.datawritten == self.datalength {
            return;
        }
        let cur = self.pos;
        let mut a: Vec[u8] = Vec.new();
        put_le(mut a, 36 + self.datawritten, 4);
        self.pos = self.form_length_pos;
        self.put(a);
        let mut b: Vec[u8] = Vec.new();
        put_le(mut b, self.datawritten, 4);
        self.pos = self.data_length_pos;
        self.put(b);
        self.pos = cur;
        self.datalength = self.datawritten;
    }

    fn writeframesraw(mut ref self, data: ref Vec[u8]) -> Result[(), Exc] {
        self.ensure_header(data.len())?;
        let nframes = data.len() / (self.sampwidth * self.nchannels);
        if not self.open {
            return Err(no_attr("NoneType", "write"));
        }
        self.put(data);
        self.datawritten += data.len();
        self.nframeswritten += nframes;
        Ok(())
    }

    fn writeframes(mut ref self, data: ref Vec[u8]) -> Result[(), Exc] {
        self.writeframesraw(data)?;
        if self.datalength != self.datawritten {
            self.patch();
        }
        Ok(())
    }

    // close(): whatever happens, the file is closed with what was written.
    fn close(mut ref self) -> Result[(), Exc] {
        if not self.open {
            return Ok(());
        }
        let mut r = self.ensure_header(0);
        if r.is_ok() and self.datalength != self.datawritten {
            self.patch();
        }
        self.open = false;
        if let Err(e) = fs.write_bytes(f"data/{self.path}", self.buf.clone()) {
            r = Err(Exc { kind: "OSError".to_string(), msg: f"{e}" });
        }
        r
    }
}
// ------------------------------------------------------------ output

fn show(text: ref String) -> String {
    let mut out = String.new();
    for c in text.chars() {
        let n = c as i64;
        if c == '\r' {
            out.push_str("<CR>");
        } else if (n < 0x20 and c != '\t' and c != '\n') or (n >= 0x7f and n <= 0x9f) {
            out.push_str(f"<x{hex_digits(n, 2)}>");
        } else {
            out.push(c);
        }
    }
    out
}

// Every line goes out through show().
fn emit(out: mut ref String, line: ref String) {
    out.push_str(show(line));
    out.push_str("\n");
}

fn short(data: ref Vec[u8]) -> String {
    let mut head: Vec[u8] = Vec.new();
    for i in 0..data.len() {
        if i < 16 {
            head.push(data[i]);
        }
    }
    let more = if data.len() > 16 { "..." } else { "" };
    f"{data.len()} bytes {hex_of(head)}{more}"
}

fn int_of(s: ref String) -> i64 {
    i64.parse(s).unwrap_or(0)
}

// "name:arg" -> (name, arg), as str.partition(":").
fn op_parts(op: ref String) -> (String, String) {
    match op.find(":") {
        Some(i) => (op[0..i].to_string(), op[(i + 1)..].to_string()),
        None => (op.clone(), String.new()),
    }
}

// ------------------------------------------------------------ the module, op by op

fn reader_op(w: mut ref Reader, op: ref String) -> Result[String, Exc] {
    let (name, arg) = op_parts(op);
    if name == "params" {
        Ok(w.params())
    } else if name == "nframes" {
        Ok(f"{w.nframes}")
    } else if name == "read" {
        Ok(short(w.readframes(int_of(arg))?))
    } else if name == "tell" {
        Ok(f"{w.soundpos}")
    } else if name == "setpos" {
        w.setpos(int_of(arg))?;
        Ok("ok".to_string())
    } else if name == "rewind" {
        w.rewind();
        Ok("ok".to_string())
    } else {
        Ok("None".to_string())
    }
}

fn reader_job(path: ref String, ops: ref Vec[String], out: mut ref String) {
    let mut w = match open_reader(path) {
        Ok(r) => r,
        Err(e) => {
            emit(mut out, f"  open: {err_text(e)}");
            return;
        }
    };
    for op in ops.iter() {
        match reader_op(mut w, op) {
            Ok(s) => emit(mut out, f"  {op}: {s}"),
            Err(e) => emit(mut out, f"  {op}: {err_text(e)}"),
        }
    }
}

fn writer_op(w: mut ref Writer, op: ref String) -> Result[String, Exc] {
    let (name, arg) = op_parts(op);
    if name == "nch" {
        w.setnchannels(int_of(arg))?;
    } else if name == "sw" {
        w.setsampwidth(int_of(arg))?;
    } else if name == "rate" {
        w.setframerate(f64.parse(arg).unwrap_or(0.0))?;
    } else if name == "nframes" {
        w.setnframes(int_of(arg))?;
    } else if name == "comp" {
        let (kind, label) = op_parts(arg);
        w.setcomptype(kind, label)?;
    } else if name == "params" {
        let p = split_on(arg, b',');
        w.setparams(int_of(p[0]), int_of(p[1]), int_of(p[2]), int_of(p[3]), p[4], p[5])?;
    } else if name == "write" {
        w.writeframes(unhex(arg))?;
    } else if name == "raw" {
        w.writeframesraw(unhex(arg))?;
    } else if name == "getnframes" or name == "tell" {
        return Ok(f"{w.nframeswritten}");
    } else if name == "getparams" {
        return w.getparams();
    } else if name == "markers" {
        return Ok("None".to_string());
    } else {
        w.close()?;
    }
    Ok("ok".to_string())
}

fn writer_job(path: ref String, ops: ref Vec[String], out: mut ref String) {
    let mut w = open_writer(path);
    let mut all = ops.clone();
    all.push("end".to_string());
    for op in all.iter() {
        match writer_op(mut w, op) {
            Ok(s) => emit(mut out, f"  {op}: {s}"),
            Err(e) => emit(mut out, f"  {op}: {err_text(e)}"),
        }
    }
    let data = fs.read_bytes(f"data/{path}").unwrap_or(Vec.new());
    emit(mut out, f"  file {data.len()} bytes: {hex_of(data)}");
}

// ------------------------------------------------------------ programs

struct Clip {
    nchannels: i64,
    sampwidth: i64,
    framerate: i64,
    nframes: i64,
    frames: Vec[Vec[i64]],
}

fn full(sw: i64) -> i64 {
    1 << (8 * sw - 1)
}

fn decode(data: ref Vec[u8], nch: i64, sw: i64) -> Vec[Vec[i64]] {
    let mut frames: Vec[Vec[i64]] = Vec.new();
    let size = nch * sw;
    let top = full(sw);
    for i in 0..(data.len() / size) {
        let mut frame: Vec[i64] = Vec.new();
        for c in 0..nch {
            let at = i * size + c * sw;
            let s = if sw == 1 {
                data[at] as i64 - 128
            } else {
                let v = le(data, at, sw);
                if v >= top { v - 2 * top } else { v }
            };
            frame.push(s);
        }
        frames.push(frame);
    }
    frames
}

fn encode(frames: ref Vec[Vec[i64]], sw: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for frame in frames.iter() {
        for s in frame.iter() {
            if sw == 1 {
                out.push((*s + 128) as u8);
            } else {
                put_le(mut out, *s, sw);
            }
        }
    }
    out
}

fn load(path: ref String) -> Result[Clip, Exc] {
    let mut w = open_reader(path)?;
    let n = w.nframes;
    let data = w.readframes(n)?;
    Ok(Clip {
        nchannels: w.nchannels,
        sampwidth: w.sampwidth,
        framerate: w.framerate,
        nframes: n,
        frames: decode(data, w.nchannels, w.sampwidth),
    })
}

fn describe(c: ref Clip) -> String {
    f"{c.nchannels} ch, {c.sampwidth * 8}-bit, {c.framerate} Hz"
}

fn abs(x: i64) -> i64 {
    if x < 0 { -x } else { x }
}

// Indexes of the first and last frames with a sample above the
// threshold, or None.
fn loud_span(frames: ref Vec[Vec[i64]], threshold: i64) -> Option[(i64, i64)] {
    let mut first: i64 = -1;
    let mut last: i64 = -1;
    for i in 0..frames.len() {
        let mut loud = false;
        for s in frames[i].iter() {
            if abs(*s) > threshold {
                loud = true;
            }
        }
        if loud {
            if first < 0 {
                first = i;
            }
            last = i;
        }
    }
    if first < 0 { None } else { Some((first, last)) }
}

fn inspect(folder: ref String, out: mut ref String) {
    let mut names = fs.read_dir(f"data/{folder}").unwrap_or(Vec.new());
    names.sort();
    let mut ok = 0;
    let mut bad = 0;
    let mut total = 0;
    for name in names.iter() {
        let c = match load(f"{folder}/{name}") {
            Ok(c) => c,
            Err(e) => {
                emit(mut out, f"{name}: {err_text(e)}");
                bad += 1;
                continue;
            }
        };
        emit(mut out, f"{name}: {describe(c)}, {c.nframes} frames, {c.nframes * 1000 / c.framerate} ms");
        if c.frames.len() != c.nframes {
            emit(mut out, f"  header says {c.nframes} frames, the file holds {c.frames.len()}");
        }
        let top = full(c.sampwidth);
        let mut peaks: Vec[String] = Vec.new();
        for ch in 0..c.nchannels {
            let mut pk = 0;
            for f in c.frames.iter() {
                if abs(f[ch]) > pk {
                    pk = abs(f[ch]);
                }
            }
            peaks.push(f"{pk} ({pk * 100 / top}%)");
        }
        emit(mut out, f"  peak {join(peaks, " ")}");
        match loud_span(c.frames, top / 100) {
            None => emit(mut out, "  silent".to_string()),
            Some((a, b)) => {
                let tail = c.frames.len() - 1 - b;
                emit(mut out, f"  quiet {a * 1000 / c.framerate} ms in, {tail * 1000 / c.framerate} ms out");
            }
        }
        ok += 1;
        total += c.frames.len() * 1000 / c.framerate;
    }
    emit(mut out, f"{ok} files read, {bad} refused, {total} ms of audio");
}

fn crc_table() -> Vec[u32] {
    let mut table: Vec[u32] = Vec.new();
    for n in 0..256 {
        let mut c = n as u32;
        for _ in 0..8 {
            if c & 1u32 == 1u32 {
                c = 0xEDB88320u32 ^ (c >> 1);
            } else {
                c = c >> 1;
            }
        }
        table.push(c);
    }
    table
}

fn crc32(data: ref Vec[u8]) -> i64 {
    let table = crc_table();
    let mut c = 0xFFFFFFFFu32;
    for b in data.iter() {
        let idx = ((c ^ (*b as u32)) & 0xFFu32) as i64;
        c = table[idx] ^ (c >> 8);
    }
    (c ^ 0xFFFFFFFFu32) as i64
}

fn report(path: ref String, out: mut ref String) {
    let raw = fs.read_bytes(f"data/{path}").unwrap_or(Vec.new());
    match load(path) {
        Ok(c) => emit(mut out, f"  wrote {path}: {describe(c)}, {c.nframes} frames, {raw.len()} bytes, crc32 {hex_digits(crc32(raw), 8)}"),
        Err(e) => emit(mut out, f"  wrote {path}: {err_text(e)}"),
    }
}

fn opened(path: ref String) -> Writer {
    let parts = split_on(path, b'/');
    let mut dir = "data".to_string();
    for i in 0..(parts.len() - 1) {
        dir = f"{dir}/{parts[i]}";
    }
    let _ = fs.create_dir_all(dir);
    open_writer(path)
}

fn source(src: ref String, out: mut ref String) -> Option[Clip] {
    match load(src) {
        Ok(c) => Some(c),
        Err(e) => {
            emit(mut out, f"{src}: {err_text(e)}");
            None
        }
    }
}

// Python's floor division.
fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

fn finish(w: mut ref Writer, r: own Result[(), Exc], out: mut ref String) {
    let closed = w.close();
    if let Err(e) = r {
        emit(mut out, f"  {err_text(e)}");
    } else if let Err(e) = closed {
        emit(mut out, f"  {err_text(e)}");
    }
}

fn write_chunked(w: mut ref Writer, frames: ref Vec[Vec[i64]], sw: i64, step: i64, raw: bool) -> Result[(), Exc] {
    let mut i = 0;
    while i < frames.len() {
        let mut part: Vec[Vec[i64]] = Vec.new();
        let mut k = i;
        while k < i + step and k < frames.len() {
            part.push(frames[k].clone());
            k += 1;
        }
        let bytes = encode(part, sw);
        if raw {
            w.writeframesraw(bytes)?;
        } else {
            w.writeframes(bytes)?;
        }
        i += step;
    }
    Ok(())
}

fn mixdown(src: ref String, dst: ref String, out: mut ref String) {
    let c = match source(src, mut out) {
        Some(c) => c,
        None => return,
    };
    if c.nchannels == 1 {
        emit(mut out, f"{src} is already mono");
        return;
    }
    let mut mono: Vec[Vec[i64]] = Vec.new();
    for f in c.frames.iter() {
        let mut sum = 0;
        for s in f.iter() {
            sum += *s;
        }
        mono.push([floor_div(sum, c.nchannels)]);
    }
    emit(mut out, f"mixdown {src}: {mono.len()} frames");
    let mut w = opened(dst);
    let r = set_format(mut w, 1, c.sampwidth, c.framerate);
    let r2 = if r.is_ok() { write_chunked(mut w, mono, c.sampwidth, 256, false) } else { r };
    finish(mut w, r2, mut out);
    report(dst, mut out);
}

fn set_format(w: mut ref Writer, nch: i64, sw: i64, rate: i64) -> Result[(), Exc] {
    w.setnchannels(nch)?;
    w.setsampwidth(sw)?;
    w.setframerate(rate as f64)?;
    Ok(())
}

fn normalize(src: ref String, dst: ref String, pct: i64, out: mut ref String) {
    let c = match source(src, mut out) {
        Some(c) => c,
        None => return,
    };
    let mut peak = 0;
    for f in c.frames.iter() {
        for s in f.iter() {
            if abs(*s) > peak {
                peak = abs(*s);
            }
        }
    }
    if peak == 0 {
        emit(mut out, f"{src} is silent, nothing to normalize");
        return;
    }
    let top = full(c.sampwidth);
    let target = top * pct / 100;
    let mut loud: Vec[Vec[i64]] = Vec.new();
    let mut newpeak = 0;
    for f in c.frames.iter() {
        let mut nf: Vec[i64] = Vec.new();
        for s in f.iter() {
            let mut v = floor_div(*s * target, peak);
            if v > top - 1 {
                v = top - 1;
            }
            if v < -top {
                v = -top;
            }
            if abs(v) > newpeak {
                newpeak = abs(v);
            }
            nf.push(v);
        }
        loud.push(nf);
    }
    emit(mut out, f"normalize {src}: peak {peak} -> {newpeak}");
    let mut w = opened(dst);
    let kind = "NONE".to_string();
    let label = "not compressed".to_string();
    let mut r = w.setparams(c.nchannels, c.sampwidth, c.framerate, loud.len(), kind, label);
    if r.is_ok() {
        r = w.writeframes(encode(loud, c.sampwidth));
    }
    finish(mut w, r, mut out);
    report(dst, mut out);
}

fn trim(src: ref String, dst: ref String, pct: i64, out: mut ref String) {
    let c = match source(src, mut out) {
        Some(c) => c,
        None => return,
    };
    let (a, b) = match loud_span(c.frames, full(c.sampwidth) * pct / 100) {
        Some(s) => s,
        None => {
            emit(mut out, f"{src}: nothing left after trimming");
            return;
        }
    };
    let mut keep: Vec[Vec[i64]] = Vec.new();
    for i in a..(b + 1) {
        keep.push(c.frames[i].clone());
    }
    emit(mut out, f"trim {src}: {a} frames from the start, {c.frames.len() - 1 - b} from the end");
    let mut w = opened(dst);
    let r = set_format(mut w, c.nchannels, c.sampwidth, c.framerate);
    let r2 = if r.is_ok() { write_chunked(mut w, keep, c.sampwidth, 100, true) } else { r };
    finish(mut w, r2, mut out);
    report(dst, mut out);
}

fn convert(src: ref String, dst: ref String, bits: i64, out: mut ref String) {
    let c = match source(src, mut out) {
        Some(c) => c,
        None => return,
    };
    let sw = bits / 8;
    let d = 8 * (sw - c.sampwidth);
    let mut conv: Vec[Vec[i64]] = Vec.new();
    for f in c.frames.iter() {
        let mut nf: Vec[i64] = Vec.new();
        for s in f.iter() {
            nf.push(if d >= 0 { *s << d } else { *s >> (-d) });
        }
        conv.push(nf);
    }
    emit(mut out, f"convert {src}: {c.sampwidth * 8}-bit to {bits}-bit");
    let mut w = opened(dst);
    let mut r = set_format(mut w, c.nchannels, sw, c.framerate);
    if r.is_ok() {
        r = w.writeframes(encode(conv, sw));
    }
    finish(mut w, r, mut out);
    report(dst, mut out);
}

fn concat(playlist: ref String, dst: ref String, out: mut ref String) {
    let text = read_text(playlist);
    let mut want: Option[Clip] = None;
    let mut clips: Vec[Vec[u8]] = Vec.new();
    let mut total_bytes = 0;
    for name in split_on(text, b'\n').iter() {
        if name.len() == 0 or name.starts_with("#") {
            continue;
        }
        let c = match load(name) {
            Ok(c) => c,
            Err(e) => {
                emit(mut out, f"  skipping {name}: {err_text(e)}");
                continue;
            }
        };
        let matches_want = match want {
            None => true,
            Some(ref wc) => wc.nchannels == c.nchannels and wc.sampwidth == c.sampwidth and wc.framerate == c.framerate,
        };
        if not matches_want {
            let wd = match want {
                Some(ref wc) => describe(wc),
                None => String.new(),
            };
            emit(mut out, f"  skipping {name}: {describe(c)}, want {wd}");
            continue;
        }
        emit(mut out, f"  {name}: {c.frames.len()} frames");
        let bytes = encode(c.frames, c.sampwidth);
        total_bytes += bytes.len();
        clips.push(bytes);
        if want.is_none() {
            want = Some(c);
        }
    }
    let wc = match want {
        Some(wc) => wc,
        None => {
            emit(mut out, f"concat {playlist}: nothing to write");
            return;
        }
    };
    let mut w = opened(dst);
    let mut r = set_format(mut w, wc.nchannels, wc.sampwidth, wc.framerate);
    for clip in clips.iter() {
        if r.is_ok() {
            r = w.writeframes(clip);
        }
    }
    emit(mut out, f"concat {playlist}: {clips.len()} clips, {total_bytes / (wc.nchannels * wc.sampwidth)} frames");
    finish(mut w, r, mut out);
    report(dst, mut out);
}

fn main() {
    if let Err(e) = write_data_files() {
        eprintln(e);
        return;
    }
    let mut out = String.new();
    for line in lines_of(read_text("jobs.tsv".to_string())).iter() {
        let job = split_on(line, b'\t');
        emit(mut out, f"== {join(job, " ")}");
        let kind = job[0].clone();
        let mut rest: Vec[String] = Vec.new();
        for i in 2..job.len() {
            rest.push(job[i].clone());
        }
        if kind == "reader" {
            reader_job(job[1], rest, mut out);
        } else if kind == "writer" {
            writer_job(job[1], rest, mut out);
        } else if kind == "inspect" {
            inspect(job[1], mut out);
        } else if kind == "mixdown" {
            mixdown(job[1], job[2], mut out);
        } else if kind == "normalize" {
            normalize(job[1], job[2], int_of(job[3]), mut out);
        } else if kind == "trim" {
            trim(job[1], job[2], int_of(job[3]), mut out);
        } else if kind == "convert" {
            convert(job[1], job[2], int_of(job[3]), mut out);
        } else if kind == "concat" {
            concat(job[1], job[2], mut out);
        }
    }
    print(out);
}

// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    v
}

fn data_part_0(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("reader\tuploads/01-intro.wav\tparams\tnframes\tread:4\ttell\tread:2\tsetpos:2398\tread:10\ttell\trewind\tread:1\n");
    t.push_str("reader\tuploads/02-interview.wav\tparams\tread:3\tsetpos:1102\tread:5\tsetpos:1103\tsetpos:-1\ttell\n");
    t.push_str("reader\tuploads/03-phone.wav\tparams\tread:6\tread:0\ttell\n");
    t.push_str("reader\tuploads/04-music.wav\tparams\tread:2\n");
    t.push_str("reader\tuploads/05-extensible.wav\tparams\tread:2\n");
    t.push_str("reader\tuploads/10-cut-off.wav\tparams\tread:3000\ttell\tsetpos:1000\tread:4\ttell\n");
    t.push_str("reader\tuploads/14-12bit.wav\tparams\tread:3\n");
    t.push_str("reader\tuploads/21-odd.wav\tparams\tsetpos:299\tread:5\ttell\n");
    t.push_str("reader\tuploads/22-long-riff.wav\tparams\tread:40\ttell\n");
    t.push_str("reader\tuploads/24-quiet.wav\tmarkers\n");
    t.push_str("reader\tuploads/06-float.wav\tparams\n");
    t.push_str("reader\tuploads/07-ext-float.wav\tparams\n");
    t.push_str("reader\tuploads/08-episode.mp3.wav\tparams\n");
    t.push_str("reader\tuploads/09-clip.avi.wav\tparams\n");
    t.push_str("reader\tuploads/11-no-data.wav\tparams\n");
    t.push_str("reader\tuploads/12-data-first.wav\tparams\n");
    t.push_str("reader\tuploads/13-short-fmt.wav\tparams\n");
    t.push_str("reader\tuploads/15-no-channels.wav\tparams\n");
    t.push_str("reader\tuploads/16-big-list.wav\tparams\n");
    t.push_str("reader\tuploads/17-short-riff.wav\tparams\n");
    t.push_str("reader\tuploads/18-empty.wav\tparams\n");
    t.push_str("reader\tuploads/19-zero-bits.wav\tparams\n");
    t.push_str("reader\tuploads/23-fmt-only-14.wav\tparams\n");
    t.push_str("reader\tuploads/notes.txt\tparams\n");
    t.push_str("reader\tuploads/nothing-here.wav\tparams\n");
    t.push_str("writer\tw1.wav\tnch:1\tsw:2\trate:8000\twrite:0100ff7f0080\n");
    t.push_str("writer\tw2.wav\tnch:2\tsw:1\trate:22050.5\twrite:8080\tgetnframes\twrite:7f817e82\ttell\tgetparams\n");
    t.push_str("writer\tw3.wav\tparams:1,2,8000,4,NONE,not compressed\traw:01000200\ttell\n");
    t.push_str("writer\tw4.wav\tnch:1\tsw:2\trate:8000\tnframes:10\twrite:0100020003\n");
