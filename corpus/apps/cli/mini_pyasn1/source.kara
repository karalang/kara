// ------------------------------------------------------------ programs

fn oname(s: ref String) -> String {
    for (k, v) in oid_names().iter() {
        if *k == *s {
            return v.clone();
        }
    }
    s.clone()
}

fn oname_of(w: ref W, o: i64) -> String {
    oname(obj_str(w, o))
}

fn b64_val(c: u8) -> i64 {
    let x = c as i64;
    if x >= 65 and x <= 90 {
        x - 65
    } else if x >= 97 and x <= 122 {
        x - 71
    } else if x >= 48 and x <= 57 {
        x + 4
    } else if x == 43 {
        62
    } else if x == 47 {
        63
    } else {
        -1
    }
}

fn b64decode(s: ref String) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut acc = 0;
    let mut bits = 0;
    for c in s.bytes() {
        let v = b64_val(c);
        if v < 0 {
            continue;
        }
        acc = (acc << 6) | v;
        bits += 6;
        if bits >= 8 {
            bits -= 8;
            out.push(((acc >> bits) & 0xff) as u8);
        }
    }
    out
}

fn b64encode(b: ref Vec[u8]) -> String {
    let abc = chars("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/".to_string());
    let mut out = String.new();
    let mut i = 0;
    while i < b.len() {
        let b0 = b[i] as i64;
        let b1 = if i + 1 < b.len() { b[i + 1] as i64 } else { 0 };
        let b2 = if i + 2 < b.len() { b[i + 2] as i64 } else { 0 };
        let n = (b0 << 16) | (b1 << 8) | b2;
        out.push(abc[(n >> 18) & 63]);
        out.push(abc[(n >> 12) & 63]);
        out.push(if i + 1 < b.len() { abc[(n >> 6) & 63] } else { '=' });
        out.push(if i + 2 < b.len() { abc[n & 63] } else { '=' });
        i += 3;
    }
    out
}

fn pem_body(text: ref String, label: Str) -> Result[Vec[u8], Exc] {
    let lines: Vec[Str] = text.trim().lines().collect();
    let first = f"-----BEGIN {label}-----";
    let last = f"-----END {label}-----";
    if lines.len() == 0 or lines[0] != first.as_str() or lines[lines.len() - 1] != last.as_str() {
        return Err(value_error(f"not a {label} PEM block"));
    }
    let mut body = String.new();
    let mut i = 1;
    while i + 1 < lines.len() {
        body.push_str(lines[i]);
        i += 1;
    }
    Ok(b64decode(body))
}

fn pem(der: ref Vec[u8], label: Str) -> String {
    let b = chars(b64encode(der));
    let mut parts: Vec[String] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let hi = if i + 64 < b.len() { i + 64 } else { b.len() };
        parts.push(from_chars(b, i, hi));
        i += 64;
    }
    f"-----BEGIN {label}-----\n{join(parts, "\n")}\n-----END {label}-----\n"
}

fn field(w: mut ref W, o: i64, name: Str) -> Result[i64, Exc] {
    get_field(mut w, o, name)
}

// the components of a SEQUENCE OF or SET OF, as iterating it gives them
fn items_of(w: mut ref W, o: i64) -> Result[Vec[i64], Exc] {
    let n = comp_len(w, o);
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        out.push(get_component(mut w, o, i)?);
        i += 1;
    }
    Ok(out)
}

fn truthy(w: ref W, o: i64) -> Result[bool, Exc] {
    match w.objs[o].val {
        Val.Int(b) => Ok(not big_is_zero(b)),
        _ => Err(novalue_op("__bool__")),
    }
}

fn int_of(w: ref W, o: i64) -> Result[i64, Exc] {
    Ok(big_small(obj_int(w, o)?))
}

fn upper_hex(b: ref Vec[u8]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for x in b.iter() {
        parts.push(f"{*x as i64:02X}");
    }
    join(parts, ":")
}

fn der_of(w: mut ref W, o: i64) -> Result[Vec[u8], Exc] {
    enc_obj(mut w, DER, o, -1, new_eo())
}

fn ber_of(w: mut ref W, o: i64) -> Result[Vec[u8], Exc] {
    enc_obj(mut w, BER, o, -1, new_eo())
}

fn decode_as(w: mut ref W, codec: i64, b: ref Vec[u8], cname: Str, open: bool) -> Result[(i64, Vec[u8]), Exc] {
    let spec = cls_new(mut w, cls_id(w, cname))?;
    let (v, tail) = decode(mut w, codec, b, Spec.O(spec), open)?;
    Ok((dv_obj(v)?, tail))
}

fn text_of(w: mut ref W, v0: i64) -> Result[String, Exc] {
    let mut v = v0;
    if w.objs[v].tid == T_CHOICE {
        v = chosen(w, v)?;
    }
    if w.objs[v].tid == T_ANY {
        return Ok(f"#{hexs(obj_octets(w, v)?)}");
    }
    obj_str_r(w, v)
}

fn dn(w: mut ref W, name: i64) -> Result[String, Exc] {
    let seq = field(mut w, name, "rdnSequence")?;
    let mut rdns: Vec[String] = Vec.new();
    for rdn in items_of(mut w, seq)?.iter() {
        let mut parts: Vec[String] = Vec.new();
        for atv in items_of(mut w, *rdn)?.iter() {
            let t = field(mut w, *atv, "type")?;
            let v = field(mut w, *atv, "value")?;
            parts.push(f"{oname_of(w, t)}={text_of(mut w, v)?}");
        }
        rdns.push(join(parts, "+"));
    }
    Ok(join(rdns, ", "))
}

fn general_name(w: mut ref W, g: i64) -> Result[String, Exc] {
    let kind = chosen_name(w, g)?;
    let v = chosen(w, g)?;
    if kind == "directoryName" {
        return Ok(f"DirName:{dn(mut w, v)?}");
    }
    if kind == "iPAddress" {
        let mut parts: Vec[String] = Vec.new();
        for b in obj_octets(w, v)?.iter() {
            parts.push(f"{*b as i64}");
        }
        return Ok(f"IP:{join(parts, ".")}");
    }
    if kind == "registeredID" {
        return Ok(f"RID:{obj_str(w, v)}");
    }
    if kind == "otherName" {
        let t = field(mut w, v, "type-id")?;
        return Ok(f"othername:{obj_str(w, t)}");
    }
    let label = if kind == "rfc822Name" {
        "email"
    } else if kind == "dNSName" {
        "DNS"
    } else if kind == "uniformResourceIdentifier" {
        "URI"
    } else {
        return Err(exc("KeyError", str_repr(kind)));
    };
    Ok(f"{label}:{obj_str_r(w, v)?}")
}

fn ext_spec(oid: ref String) -> String {
    let specs = vec![
        ("2.5.29.19", "BasicConstraints"),
        ("2.5.29.15", "KeyUsage"),
        ("2.5.29.14", "SubjectKeyIdentifier"),
        ("2.5.29.35", "AuthorityKeyIdentifier"),
        ("2.5.29.32", "CertificatePolicies"),
        ("2.5.29.31", "CRLDistributionPoints"),
        ("1.3.6.1.5.5.7.1.1", "AuthorityInfoAccessSyntax"),
        ("2.5.29.17", "GeneralNames"),
        ("2.5.29.37", "ExtKeyUsageSyntax"),
        ("2.5.29.16", "PrivateKeyUsagePeriod"),
    ];
    for (k, v) in specs.iter() {
        if *k == oid.as_str() {
            return v.to_string();
        }
    }
    "".to_string()
}

fn decode_ext(w: mut ref W, oid: ref String, raw: ref Vec[u8]) -> Result[Vec[String], Exc] {
    let spec = ext_spec(oid);
    if spec.len() == 0 {
        return Ok(vec![f"{raw.len()} bytes"]);
    }
    let (v, _) = decode_as(mut w, DER, raw, spec.as_str(), true)?;
    let mut out: Vec[String] = Vec.new();
    if spec == "BasicConstraints" {
        let ca = field(mut w, v, "cA")?;
        let mut s = f"CA:{if truthy(w, ca)? { "TRUE" } else { "FALSE" }}";
        let pl = field(mut w, v, "pathLenConstraint")?;
        if obj_is_value(w, pl) {
            s = f"{s}, pathlen:{big_str(obj_int(w, pl)?)}";
        }
        out.push(s);
        return Ok(out);
    }
    if spec == "KeyUsage" {
        let nv = w.classes[cls_id(w, "KeyUsage")].named;
        let (b, n) = bits_val(w, v);
        let mut names: Vec[String] = Vec.new();
        let mut i = 0;
        while i < w.nvs[nv].names.len() {
            let pos = w.nvs[nv].nums[i];
            if pos < n and bit_at(b, n, pos) == 1 {
                names.push(w.nvs[nv].names[i].clone());
            }
            i += 1;
        }
        out.push(f"{join(names, ", ")} ({pp(w, v)})");
        return Ok(out);
    }
    if spec == "SubjectKeyIdentifier" {
        out.push(upper_hex(obj_octets(w, v)?));
        return Ok(out);
    }
    if spec == "AuthorityKeyIdentifier" {
        let kid = field(mut w, v, "keyIdentifier")?;
        if obj_is_value(w, kid) {
            out.push(f"keyid:{upper_hex(obj_octets(w, kid)?)}");
        }
        let iss = field(mut w, v, "authorityCertIssuer")?;
        if obj_is_value(w, iss) {
            for g in items_of(mut w, iss)?.iter() {
                out.push(general_name(mut w, *g)?);
            }
        }
        let sn = field(mut w, v, "authorityCertSerialNumber")?;
        if obj_is_value(w, sn) {
            out.push(f"serial:{hex_low(obj_int(w, sn)?)}");
        }
        return Ok(out);
    }
    if spec == "CertificatePolicies" {
        for pi in items_of(mut w, v)?.iter() {
            let pid = field(mut w, *pi, "policyIdentifier")?;
            out.push(f"Policy: {oname_of(w, pid)}");
            let qs = field(mut w, *pi, "policyQualifiers")?;
            if obj_is_value(w, qs) {
                for q in items_of(mut w, qs)?.iter() {
                    let _h1 = field(mut w, *q, "policyQualifierId")?;
                    let qid = obj_str(w, _h1);
                    let qual = field(mut w, *q, "qualifier")?;
                    let qb = obj_octets(w, qual)?;
                    if qid == "1.3.6.1.5.5.7.2.1" {
                        let (u, _) = decode_as(mut w, DER, qb, "IA5String", false)?;
                        out.push(f"  CPS: {obj_str_r(w, u)?}");
                    } else {
                        out.push(f"  {oname(qid)}: {qb.len()} bytes");
                    }
                }
            }
        }
        return Ok(out);
    }
    if spec == "CRLDistributionPoints" {
        for dp in items_of(mut w, v)?.iter() {
            let dpn = field(mut w, *dp, "distributionPoint")?;
            if obj_is_value(w, dpn) {
                if chosen_name(w, dpn)? == "fullName" {
                    let full = field(mut w, dpn, "fullName")?;
                    for g in items_of(mut w, full)?.iter() {
                        out.push(f"Full Name: {general_name(mut w, *g)?}");
                    }
                } else {
                    let rel = field(mut w, dpn, "nameRelativeToCRLIssuer")?;
                    out.push(f"Relative Name: {comp_len(w, rel)} attributes");
                }
            }
            let rs = field(mut w, *dp, "reasons")?;
            if obj_is_value(w, rs) {
                out.push(f"Reasons: {pp(w, rs)}");
            }
        }
        return Ok(out);
    }
    if spec == "AuthorityInfoAccessSyntax" {
        for ad in items_of(mut w, v)?.iter() {
            let m = field(mut w, *ad, "accessMethod")?;
            let loc = field(mut w, *ad, "accessLocation")?;
            out.push(f"{oname_of(w, m)} - {general_name(mut w, loc)?}");
        }
        return Ok(out);
    }
    if spec == "GeneralNames" {
        let mut parts: Vec[String] = Vec.new();
        for g in items_of(mut w, v)?.iter() {
            parts.push(general_name(mut w, *g)?);
        }
        out.push(join(parts, ", "));
        return Ok(out);
    }
    if spec == "ExtKeyUsageSyntax" {
        let mut parts: Vec[String] = Vec.new();
        for k in items_of(mut w, v)?.iter() {
            parts.push(oname_of(w, *k));
        }
        out.push(join(parts, ", "));
        return Ok(out);
    }
    out.push(pp(w, v));
    Ok(out)
}

fn when(w: mut ref W, t: i64) -> Result[String, Exc] {
    let c = chosen(w, t)?;
    Ok(isoformat(as_datetime(w, c)?))
}

fn key_info(w: mut ref W, spki: i64) -> Result[String, Exc] {
    let alg = field(mut w, spki, "algorithm")?;
    let bits = field(mut w, spki, "subjectPublicKey")?;
    let _h2 = field(mut w, alg, "algorithm")?;
    let name = oname_of(w, _h2);
    if name == "rsaEncryption" {
        let (rsa, _) = decode_as(mut w, DER, obj_octets(w, bits)?, "RSAPublicKey", false)?;
        let _h3 = field(mut w, rsa, "modulus")?;
        let n = obj_int(w, _h3)?;
        let _h4 = field(mut w, rsa, "publicExponent")?;
        let e = obj_int(w, _h4)?;
        let h = chars(hex_low(n));
        return Ok(f"RSA {big_bit_length(n)} bit, exponent {big_str(e)}, modulus {from_chars(h, 0, 8)}...{from_chars(h, h.len() - 8, h.len())}");
    }
    if name == "ecPublicKey" {
        let params = field(mut w, alg, "parameters")?;
        let curve = field(mut w, params, "namedCurve")?;
        let (_, n) = bits_val(w, bits);
        let oct = obj_octets(w, bits)?;
        return Ok(f"EC {oname_of(w, curve)}, point {n / 8} bytes, first byte {oct[0] as i64:02x}");
    }
    Ok(name)
}

fn listing(dir: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    match fs.read_dir(f"data/{dir}") {
        Ok(names) => {
            for n in names.iter() {
                out.push(n.clone());
            }
        }
        Err(_) => {}
    }
    out.sort();
    out
}

fn read_text(p: ref String) -> Result[String, Exc] {
    match fs.read_to_string(p.clone()) {
        Ok(t) => Ok(t),
        Err(e) => Err(exc("OSError", f"{e}")),
    }
}

fn prog_certinfo(w: mut ref W) -> Result[(), Exc] {
    let files = listing("certs");
    let mut smallest = "".to_string();
    let mut small_len = -1;
    for f in files.iter() {
        println(f"== certinfo {f}");
        let text = read_text(f"data/certs/{f}")?;
        if small_len < 0 or text.len() < small_len {
            small_len = text.len();
            smallest = f.clone();
        }
        let der = pem_body(text, "CERTIFICATE")?;
        let (cert, tail) = decode_as(mut w, DER, der, "Certificate", true)?;
        let tbs = field(mut w, cert, "tbsCertificate")?;
        let _h5 = field(mut w, tbs, "version")?;
        println(f"version: {pp(w, _h5)}");
        let _h6 = field(mut w, tbs, "serialNumber")?;
        println(f"serial: {hex_low(obj_int(w, _h6)?)}");
        let sig = field(mut w, tbs, "signature")?;
        let _h7 = field(mut w, sig, "algorithm")?;
        println(f"signature: {oname_of(w, _h7)}");
        let issuer = field(mut w, tbs, "issuer")?;
        let subject = field(mut w, tbs, "subject")?;
        println(f"issuer: {dn(mut w, issuer)?}");
        println(f"subject: {dn(mut w, subject)?}");
        let val = field(mut w, tbs, "validity")?;
        let nb = field(mut w, val, "notBefore")?;
        let na = field(mut w, val, "notAfter")?;
        println(f"valid: {when(mut w, nb)?} .. {when(mut w, na)?} ({chosen_name(w, nb)?}, {chosen_name(w, na)?})");
        let _h8 = field(mut w, tbs, "subjectPublicKeyInfo")?;
        println(f"key: {key_info(mut w, _h8)?}");
        let exts = field(mut w, tbs, "extensions")?;
        if obj_is_value(w, exts) {
            for ext in items_of(mut w, exts)?.iter() {
                let _h9 = field(mut w, *ext, "extnID")?;
                let oid = obj_str(w, _h9);
                let _h10 = field(mut w, *ext, "critical")?;
                let crit = if truthy(w, _h10)? { " critical" } else { "" };
                println(f"ext {oname(oid)}{crit}:");
                let _h11 = field(mut w, *ext, "extnValue")?;
                let raw = obj_octets(w, _h11)?;
                for line in decode_ext(mut w, oid, raw)?.iter() {
                    println(f"    {line}");
                }
            }
        }
        let sbits = field(mut w, cert, "signature")?;
        let (_, sn) = bits_val(w, sbits);
        println(f"signature bits: {sn}");
        let same = der_of(mut w, issuer)? == der_of(mut w, subject)?;
        println(f"self-signed name: {bool_str(same)}");
        let back = der_of(mut w, cert)? == der;
        println(f"DER round trip: {bool_str(back)}, {der.len()} bytes, tail {tail.len()}");
    }
    let text = read_text(f"data/certs/{smallest}")?;
    let der = pem_body(text, "CERTIFICATE")?;
    println(f"== certinfo schemaless {smallest}");
    let (v, _) = decode(mut w, BER, der, Spec.Nil, false)?;
    println(pp(w, dv_obj(v)?));
    Ok(())
}

fn bits_of(b: ref Vec[u8]) -> String {
    let mut s = String.new();
    for x in b.iter() {
        let mut k = 7;
        while k >= 0 {
            s.push(if ((*x as i64) >> k) & 1 == 1 { '1' } else { '0' });
            k -= 1;
        }
    }
    s
}

fn item(key: Str, val: own P) -> PItem {
    PItem { key: p_s(key), val: val }
}

fn mk(w: mut ref W, cname: Str, p: ref P) -> Result[i64, Exc] {
    let spec = cls_new(mut w, cls_id(w, cname))?;
    nat_dec(mut w, p, spec)
}

// the open-type map of AttributeTypeAndValue: each OID's built type
fn rdn_types(w: mut ref W) -> Result[Vec[(String, i64)], Exc] {
    let text = read_text("data/schemas.json".to_string())?;
    let j = loads_str(text)?;
    let mut out: Vec[(String, i64)] = Vec.new();
    for d in j_arr(j).iter() {
        if j_str(j_get(d, "def").unwrap()) == "AttributeTypeAndValue" {
            let fields = j_arr(j_get(d, "fields").unwrap());
            let open = j_arr(j_get(fields[1], "open").unwrap());
            for pair in j_arr(open[1]).iter() {
                let kv = j_arr(pair);
                let t = build(mut w, kv[1])?;
                let k = j_str(kv[0]);
                let mut found = false;
                for e in out.iter_mut() {
                    if e.0 == k {
                        e.1 = t;
                        found = true;
                    }
                }
                if not found {
                    out.push((k, t));
                }
            }
        }
    }
    Ok(out)
}

fn csr_build(w: mut ref W, req: ref J, types: ref Vec[(String, i64)]) -> Result[Vec[u8], Exc] {
    let mut rdns: Vec[P] = Vec.new();
    for pair in j_arr(j_get(req, "subject").unwrap()).iter() {
        let kv = j_arr(pair);
        let oid = j_str(kv[0]);
        let mut spec = -1;
        for (k, t) in types.iter() {
            if *k == oid {
                spec = *t;
            }
        }
        if spec < 0 {
            return Err(exc("KeyError", str_repr(oid)));
        }
        let mut val = pyval(kv[1]);
        if w.objs[spec].tid == T_CHOICE {
            val = P.Dict(vec![item("utf8String", val)]);
        }
        let o = nat_dec(mut w, val, spec)?;
        let enc = der_of(mut w, o)?;
        rdns.push(P.List(vec![P.Dict(vec![item("type", P.Str(oid)), item("value", P.Bytes(enc))])]));
    }
    let modulus = parse_int_text(j_str(j_get(req, "modulus").unwrap()), 16).unwrap();
    let key_obj = mk(mut w, "RSAPublicKey", P.Dict(vec![
        item("modulus", P.Int(modulus)),
        item("publicExponent", pyval(j_get(req, "exponent").unwrap())),
    ]))?;
    let key = der_of(mut w, key_obj)?;
    let mut dns: Vec[P] = Vec.new();
    for d in j_arr(j_get(req, "dns").unwrap()).iter() {
        dns.push(P.Dict(vec![item("dNSName", pyval(d))]));
    }
    let san_obj = mk(mut w, "GeneralNames", P.List(dns))?;
    let san = der_of(mut w, san_obj)?;
    let exts_obj = mk(mut w, "Extensions", P.List(vec![P.Dict(vec![
        item("extnID", p_s("2.5.29.17")),
        item("extnValue", P.Bytes(san)),
    ])]))?;
    let exts = der_of(mut w, exts_obj)?;
    let null = P.Bytes(vec![5 as u8, 0 as u8]);
    let sig = unhex_str(j_str(j_get(req, "signature").unwrap()));
    let info = P.Dict(vec![
        item("version", p_s("v1")),
        item("subject", P.Dict(vec![item("rdnSequence", P.List(rdns))])),
        item("subjectPKInfo", P.Dict(vec![
            item("algorithm", P.Dict(vec![item("algorithm", p_s("1.2.840.113549.1.1.1")), item("parameters", null.clone())])),
            item("subjectPublicKey", P.Str(bits_of(key))),
        ])),
        item("attributes", P.List(vec![P.Dict(vec![
            item("type", p_s("1.2.840.113549.1.9.14")),
            item("values", P.List(vec![P.Bytes(exts)])),
        ])])),
    ]);
    let csr = mk(mut w, "CertificationRequest", P.Dict(vec![
        item("certificationRequestInfo", info),
        item("signatureAlgorithm", P.Dict(vec![item("algorithm", p_s("1.2.840.113549.1.1.11")), item("parameters", null)])),
        item("signature", P.Str(bits_of(sig))),
    ]))?;
    der_of(mut w, csr)
}

fn prog_csr(w: mut ref W) -> Result[(), Exc] {
    if let Err(e) = fs.create_dir_all("data/out".to_string()) {
        return Err(exc("OSError", f"{e}"));
    }
    let types = rdn_types(mut w)?;
    for f in listing("csr").iter() {
        println(f"== csr {f}");
        let req = loads_str(read_text(f"data/csr/{f}")?)?;
        let der = match csr_build(mut w, req, types) {
            Ok(d) => d,
            Err(e) => {
                println(f"error: {failure(e)}");
                continue;
            }
        };
        let out = f"data/out/{f.replace(".json", ".csr")}";
        if let Err(e) = fs.write(out.clone(), pem(der, "CERTIFICATE REQUEST")) {
            return Err(exc("OSError", f"{e}"));
        }
        println(f"wrote {out}, {der.len()} bytes DER");
        let text = read_text(out)?;
        print(text);
        let (back, _) = decode_as(mut w, DER, pem_body(text, "CERTIFICATE REQUEST")?, "CertificationRequest", true)?;
        let info = field(mut w, back, "certificationRequestInfo")?;
        let _h12 = field(mut w, info, "subject")?;
        println(f"subject: {dn(mut w, _h12)?}");
        let _h13 = field(mut w, info, "subjectPKInfo")?;
        println(f"key: {key_info(mut w, _h13)?}");
        let attrs = field(mut w, info, "attributes")?;
        for attr in items_of(mut w, attrs)?.iter() {
            let t = field(mut w, *attr, "type")?;
            let vals = field(mut w, *attr, "values")?;
            println(f"attribute {oname_of(w, t)}, {comp_len(w, vals)} value(s)");
            for raw in items_of(mut w, vals)?.iter() {
                let (exts, _) = decode_as(mut w, DER, obj_octets(w, *raw)?, "Extensions", false)?;
                for ext in items_of(mut w, exts)?.iter() {
                    let _h14 = field(mut w, *ext, "extnID")?;
                    let oid = obj_str(w, _h14);
                    let _h15 = field(mut w, *ext, "extnValue")?;
                    let rawv = obj_octets(w, _h15)?;
                    let lines = decode_ext(mut w, oid, rawv)?;
                    println(f"  {oname(oid)}: {join(lines, "; ")}");
                }
            }
        }
        println(f"same DER: {bool_str(der_of(mut w, back)? == der)}");
    }
    Ok(())
}

// ------------------------------------------------------------ SNMP

#[derive(Clone)]
struct MibEntry {
    oid: String,
    kind: String,
    value: J,
    writable: bool,
}

fn oid_key(s: ref String) -> Vec[Big] {
    let mut out: Vec[Big] = Vec.new();
    for p in s.split(".") {
        out.push(parse_int_text(p.to_string(), 10).unwrap_or(big_zero()));
    }
    out
}

fn key_cmp(a: ref Vec[Big], b: ref Vec[Big]) -> i64 {
    let mut i = 0;
    while i < a.len() and i < b.len() {
        let c = big_cmp(a[i], b[i]);
        if c != 0 {
            return c;
        }
        i += 1;
    }
    if a.len() == b.len() {
        0
    } else if a.len() < b.len() {
        -1
    } else {
        1
    }
}

fn mib_find(mib: ref Vec[MibEntry], oid: ref String) -> i64 {
    let mut i = 0;
    while i < mib.len() {
        if mib[i].oid == *oid {
            return i;
        }
        i += 1;
    }
    -1
}

fn mib_value(kind: ref String, v: ref J) -> P {
    let (outer, inner) = if *kind == "string" {
        ("simple", "string-value")
    } else if *kind == "integer" {
        ("simple", "integer-value")
    } else if *kind == "oid" {
        ("simple", "objectID-value")
    } else if *kind == "timeticks" {
        ("application-wide", "timeticks-value")
    } else if *kind == "counter32" {
        ("application-wide", "counter-value")
    } else if *kind == "gauge32" {
        ("application-wide", "gauge32-value")
    } else if *kind == "counter64" {
        ("application-wide", "big-counter-value")
    } else {
        ("application-wide", "ipAddress-value")
    };
    let val = if *kind == "ipaddress" { P.Bytes(unhex_str(j_str(v))) } else { pyval(v) };
    P.Dict(vec![item(outer, P.Dict(vec![item(inner, val)]))])
}

fn mib_lookup(mib: ref Vec[MibEntry], order: ref Vec[String], oid: ref String) -> (String, P) {
    let i = mib_find(mib, oid);
    if i >= 0 {
        return (mib[i].kind.clone(), P.Str("".to_string()));
    }
    let prefix = f"{oid}.";
    for o in order.iter() {
        let cut = match o.rfind(".") {
            Some(k) => slice(o, 0, k),
            None => o.clone(),
        };
        if o.starts_with(prefix.as_str()) or oid.starts_with(f"{cut}.".as_str()) {
            return ("".to_string(), p_s("noSuchInstance"));
        }
    }
    ("".to_string(), p_s("noSuchObject"))
}

fn bind_p(mib: ref Vec[MibEntry], oid: ref String, kind: ref String, value: ref P) -> P {
    if kind.len() == 0 {
        let name = match value {
            P.Str(s) => s.clone(),
            _ => "".to_string(),
        };
        return P.Dict(vec![item("name", P.Str(oid.clone())), item("", P.Dict(vec![PItem { key: P.Str(name), val: P.None_ }]))]);
    }
    let i = mib_find(mib, oid);
    P.Dict(vec![item("name", P.Str(oid.clone())), item("", P.Dict(vec![item("value", mib_value(kind, mib[i].value))]))])
}

fn bind_get(mib: ref Vec[MibEntry], order: ref Vec[String], oid: ref String) -> P {
    let (kind, v) = mib_lookup(mib, order, oid);
    bind_p(mib, oid, kind, v)
}

fn next_bind(mib: ref Vec[MibEntry], order: ref Vec[String], oid: ref String) -> P {
    let k = oid_key(oid);
    for o in order.iter() {
        if key_cmp(oid_key(o), k) > 0 {
            let i = mib_find(mib, o);
            return bind_p(mib, o, mib[i].kind, P.None_);
        }
    }
    P.Dict(vec![item("name", P.Str(oid.clone())), item("", P.Dict(vec![item("endOfMibView", P.None_)]))])
}

fn bind_name(b: ref P) -> String {
    match dict_get(b, "name".to_string()) {
        Some(P.Str(s)) => s,
        _ => "".to_string(),
    }
}

fn is_end(b: ref P) -> bool {
    match dict_get(b, "".to_string()) {
        Some(inner) => dict_get(inner, "endOfMibView".to_string()).is_some(),
        None => false,
    }
}

// OrderedDicts from the native encoder, as the native decoder reads them
fn dictify(p: ref P) -> P {
    match p {
        P.ODict(items) => {
            let mut out: Vec[PItem] = Vec.new();
            for it in items.iter() {
                out.push(PItem { key: it.key.clone(), val: dictify(it.val) });
            }
            P.Dict(out)
        }
        P.Dict(items) => {
            let mut out: Vec[PItem] = Vec.new();
            for it in items.iter() {
                out.push(PItem { key: it.key.clone(), val: dictify(it.val) });
            }
            P.Dict(out)
        }
        P.List(xs) => {
            let mut out: Vec[P] = Vec.new();
            for x in xs.iter() {
                out.push(dictify(x));
            }
            P.List(out)
        }
        _ => p.clone(),
    }
}

fn bind_text(w: mut ref W, bv: i64) -> Result[String, Exc] {
    let kind = chosen_name(w, bv)?;
    if kind != "value" {
        return Ok(kind);
    }
    let _h16 = field(mut w, bv, "value")?;
    let syn = chosen(w, _h16)?;
    let inner = chosen(w, syn)?;
    let name = chosen_name(w, syn)?;
    if name == "string-value" {
        return Ok(f"STRING: {pp(w, inner)}");
    }
    if name == "ipAddress-value" {
        let mut parts: Vec[String] = Vec.new();
        for b in obj_octets(w, inner)?.iter() {
            parts.push(f"{*b as i64}");
        }
        return Ok(f"IpAddress: {join(parts, ".")}");
    }
    let tn = cls_name(w, inner);
    let shown = if tn == "Integer32" { "INTEGER".to_string() } else { tn };
    Ok(f"{shown}: {pp(w, inner)}")
}

fn snmp_one(w: mut ref W, mib: mut ref Vec[MibEntry], order: ref Vec[String], hex: ref String) -> Result[(), Exc] {
    let (msg, tail) = match decode_as(mut w, BER, unhex_str(hex), "Message", false) {
        Ok(x) => x,
        Err(e) => {
            println(f"dropped: {failure(e)}");
            return Ok(());
        }
    };
    if tail.len() > 0 {
        println(f"dropped: {tail.len()} trailing bytes");
        return Ok(());
    }
    let ver = field(mut w, msg, "version")?;
    if int_of(w, ver)? != 1 {
        println(f"dropped: version {pp(w, ver)}");
        return Ok(());
    }
    let _h17 = field(mut w, msg, "community")?;
    let community = obj_octets(w, _h17)?;
    let is_private = community == bytes_of("private".to_string());
    if community != bytes_of("public".to_string()) and not is_private {
        println(f"dropped: unknown community {bytes_repr(community)}");
        return Ok(());
    }
    let data = field(mut w, msg, "data")?;
    let kind = chosen_name(w, data)?;
    let pdu = chosen(w, data)?;
    let _h18 = field(mut w, pdu, "request-id")?;
    let rid = obj_int(w, _h18)?;
    let _h201 = field(mut w, pdu, "variable-bindings")?;
    let vbs = items_of(mut w, _h201)?;
    let mut names: Vec[String] = Vec.new();
    for b in vbs.iter() {
        let _h19 = field(mut w, *b, "name")?;
        names.push(obj_str(w, _h19));
    }
    let mut status = "noError".to_string();
    let mut index = 0;
    let mut binds: Vec[P] = Vec.new();
    if kind == "get-request" {
        for oid in names.iter() {
            binds.push(bind_get(mib, order, oid));
        }
    } else if kind == "get-next-request" {
        for oid in names.iter() {
            binds.push(next_bind(mib, order, oid));
        }
    } else if kind == "get-bulk-request" {
        let _h20 = field(mut w, pdu, "non-repeaters")?;
        let nr0 = int_of(w, _h20)?;
        let nr = if nr0 < names.len() { nr0 } else { names.len() };
        let mut i = 0;
        while i < nr {
            binds.push(next_bind(mib, order, names[i]));
            i += 1;
        }
        let mut cur: Vec[String] = Vec.new();
        let mut k = if nr < 0 { 0 } else { nr };
        while k < names.len() {
            cur.push(names[k].clone());
            k += 1;
        }
        let _h21 = field(mut w, pdu, "max-repetitions")?;
        let reps = int_of(w, _h21)?;
        let mut r = 0;
        while r < reps {
            let mut step: Vec[P] = Vec.new();
            for oid in cur.iter() {
                step.push(next_bind(mib, order, oid));
            }
            let mut all_end = true;
            cur = Vec.new();
            for b in step.iter() {
                cur.push(bind_name(b));
                if not is_end(b) {
                    all_end = false;
                }
                binds.push(b.clone());
            }
            if all_end {
                break;
            }
            r += 1;
        }
    } else if kind == "set-request" {
        for b in vbs.iter() {
            let _h22 = field(mut w, *b, "name")?;
            let n = obj_str(w, _h22);
            let _h23 = field(mut w, *b, "")?;
            let v = nat_enc(mut w, _h23)?;
            binds.push(P.Dict(vec![item("name", P.Str(n)), item("", dictify(v))]));
        }
        if not is_private {
            status = "noAccess".to_string();
            index = 1;
        } else {
            let mut i = 0;
            while i < vbs.len() {
                let _h24 = field(mut w, vbs[i], "name")?;
                let oid = obj_str(w, _h24);
                let mi = mib_find(mib, oid);
                if mi < 0 {
                    status = "noCreation".to_string();
                    index = i + 1;
                    break;
                }
                if not mib[mi].writable {
                    status = "notWritable".to_string();
                    index = i + 1;
                    break;
                }
                let _h202 = field(mut w, vbs[i], "")?;
                let _h101 = field(mut w, _h202, "value")?;
                let syn = chosen(w, _h101)?;
                if mib[mi].kind != "string" or chosen_name(w, syn)? != "string-value" {
                    status = "wrongType".to_string();
                    index = i + 1;
                    break;
                }
                i += 1;
            }
            if status == "noError" {
                for b in vbs.iter() {
                    let _h25 = field(mut w, *b, "name")?;
                    let oid = obj_str(w, _h25);
                    let _h203 = field(mut w, *b, "")?;
                    let _h102 = field(mut w, _h203, "value")?;
                    let syn = chosen(w, _h102)?;
                    let s = obj_str_r(w, chosen(w, syn)?)?;
                    let mi = mib_find(mib, oid);
                    mib[mi].value = J.Str(s);
                }
            }
        }
    } else {
        println(f"dropped: {kind} is not a request");
        return Ok(());
    }
    let resp = mk(mut w, "Message", P.Dict(vec![
        item("version", p_s("version-2c")),
        item("community", P.Bytes(community)),
        item("data", P.Dict(vec![item("response", P.Dict(vec![
            item("request-id", P.Int(rid)),
            item("error-status", P.Str(status)),
            item("error-index", p_int(index)),
            item("variable-bindings", P.List(binds)),
        ]))])),
    ]))?;
    let out = ber_of(mut w, resp)?;
    println(f"response {out.len()} bytes: {hexs(out)}");
    let _h204 = field(mut w, resp, "data")?;
    let rp = field(mut w, _h204, "response")?;
    let es = field(mut w, rp, "error-status")?;
    let ei = field(mut w, rp, "error-index")?;
    println(f"status {pp(w, es)} index {big_str(obj_int(w, ei)?)}");
    let _h205 = field(mut w, rp, "variable-bindings")?;
    for b in items_of(mut w, _h205)?.iter() {
        let _h26 = field(mut w, *b, "name")?;
        let n = obj_str(w, _h26);
        let _h27 = field(mut w, *b, "")?;
        let t = bind_text(mut w, _h27)?;
        println(f"  {n} = {t}");
    }
    Ok(())
}

fn prog_snmp(w: mut ref W) -> Result[(), Exc] {
    let mut mib: Vec[MibEntry] = Vec.new();
    let mj = loads_str(read_text("data/snmp/mib.json".to_string())?)?;
    for e in j_arr(mj).iter() {
        let xs = j_arr(e);
        let oid = j_str(xs[0]);
        let ent = MibEntry { oid: oid.clone(), kind: j_str(xs[1]), value: xs[2].clone(), writable: j_truthy(xs[3]) };
        let i = mib_find(mib, oid);
        if i >= 0 {
            mib[i] = ent;
        } else {
            mib.push(ent);
        }
    }
    let mut order: Vec[String] = Vec.new();
    for e in mib.iter() {
        order.push(e.oid.clone());
    }
    let mut i = 1;
    while i < order.len() {
        let mut j = i;
        while j > 0 and key_cmp(oid_key(order[j]), oid_key(order[j - 1])) < 0 {
            let t = order[j].clone();
            order[j] = order[j - 1].clone();
            order[j - 1] = t;
            j -= 1;
        }
        i += 1;
    }
    let rj = loads_str(read_text("data/snmp/requests.json".to_string())?)?;
    for r in j_arr(rj).iter() {
        println(f"== snmp {j_str(j_get(r, "name").unwrap())}");
        snmp_one(mut w, mut mib, order, j_str(j_get(r, "hex").unwrap()))?;
    }
    Ok(())
}

// ------------------------------------------------------------ LDAP

fn ldap_norm(d: ref String) -> String {
    let mut parts: Vec[String] = Vec.new();
    for p in d.split(",") {
        parts.push(p.trim().to_lowercase());
    }
    join(parts, ",")
}

fn attr_get(entry: ref J, name: ref String) -> Option[Vec[String]] {
    if let Some(J.Obj(ms)) = j_get(entry, "attrs") {
        for m in ms.iter() {
            if m.key.to_lowercase() == name.to_lowercase() {
                let mut out: Vec[String] = Vec.new();
                for x in j_arr(m.val).iter() {
                    out.push(j_str(x));
                }
                return Some(out);
            }
        }
    }
    None
}

fn ldap_match(w: mut ref W, entry: ref J, f: i64) -> Result[bool, Exc] {
    let kind = chosen_name(w, f)?;
    let v = chosen(w, f)?;
    if kind == "and" {
        for x in items_of(mut w, v)?.iter() {
            if not ldap_match(mut w, entry, *x)? {
                return Ok(false);
            }
        }
        return Ok(true);
    }
    if kind == "or" {
        for x in items_of(mut w, v)?.iter() {
            if ldap_match(mut w, entry, *x)? {
                return Ok(true);
            }
        }
        return Ok(false);
    }
    if kind == "not" {
        return Ok(not ldap_match(mut w, entry, v)?);
    }
    if kind == "present" {
        let name = obj_str_r(w, v)?;
        return Ok(name.to_lowercase() == "objectclass" or attr_get(entry, name).is_some());
    }
    if kind == "substrings" {
        let _h28 = field(mut w, v, "type")?;
        let vals = attr_get(entry, obj_str_r(w, _h28)?).unwrap_or(Vec.new());
        let _h206 = field(mut w, v, "substrings")?;
        let parts = items_of(mut w, _h206)?;
        for val in vals.iter() {
            let s = val.to_lowercase();
            let cs = chars(s);
            let mut pos = 0;
            let mut ok = true;
            for part in parts.iter() {
                let p = obj_str_r(w, chosen(w, *part)?)?.to_lowercase();
                let pc = chars(p);
                let which = chosen_name(w, *part)?;
                if which == "initial" {
                    ok = s.starts_with(p.as_str());
                    pos = pc.len();
                } else if which == "any" {
                    let i = find_from(cs, pc, pos);
                    ok = i >= 0;
                    pos = i + pc.len();
                } else {
                    ok = s.ends_with(p.as_str()) and cs.len() - pc.len() >= pos;
                }
                if not ok {
                    break;
                }
            }
            if ok {
                return Ok(true);
            }
        }
        return Ok(false);
    }
    let _h29 = field(mut w, v, "attributeDesc")?;
    let vals = attr_get(entry, obj_str_r(w, _h29)?).unwrap_or(Vec.new());
    let _h30 = field(mut w, v, "assertionValue")?;
    let want = obj_str_r(w, _h30)?.to_lowercase();
    for x in vals.iter() {
        let l = x.to_lowercase();
        let hit = if kind == "equalityMatch" {
            l == want
        } else if kind == "greaterOrEqual" {
            l >= want
        } else {
            l <= want
        };
        if hit {
            return Ok(true);
        }
    }
    Ok(false)
}

// str.find(sub, start) over characters; -1 when absent
fn find_from(s: ref Vec[char], p: ref Vec[char], start: i64) -> i64 {
    let mut i = if start < 0 { 0 } else { start };
    while i + p.len() <= s.len() {
        let mut k = 0;
        while k < p.len() and s[i + k] == p[k] {
            k += 1;
        }
        if k == p.len() {
            return i;
        }
        i += 1;
    }
    -1
}

fn ldap_reply(w: mut ref W, mid: ref Big, op: Str, body: own P) -> Result[(), Exc] {
    let m = mk(mut w, "LDAPMessage", P.Dict(vec![
        item("messageID", P.Int(mid.clone())),
        item("protocolOp", P.Dict(vec![item(op, body)])),
    ]))?;
    let out = ber_of(mut w, m)?;
    println(f"  -> {op} {hexs(out)}");
    Ok(())
}

fn result_p(code: Str, matched: ref String, msg: Str) -> P {
    P.Dict(vec![item("resultCode", p_s(code)), item("matchedDN", P.Str(matched.clone())), item("diagnosticMessage", p_s(msg))])
}

fn entry_dn(e: ref J) -> String {
    j_str(j_get(e, "dn").unwrap())
}

fn ldap_session(w: mut ref W, dir: ref Vec[J], sess: ref J) -> Result[(), Exc] {
    let mut bound: Option[String] = None;
    for raw in j_arr(j_get(sess, "msgs").unwrap()).iter() {
        let (m, _) = match decode_as(mut w, BER, unhex_str(j_str(raw)), "LDAPMessage", false) {
            Ok(x) => x,
            Err(e) => {
                println(f"<- undecodable: {e.kind}");
                println("  -> notice of disconnection");
                break;
            }
        };
        let _h31 = field(mut w, m, "messageID")?;
        let mid = obj_int(w, _h31)?;
        let po = field(mut w, m, "protocolOp")?;
        let op = chosen_name(w, po)?;
        let body = chosen(w, po)?;
        let ctl = field(mut w, m, "controls")?;
        if obj_is_value(w, ctl) {
            for c in items_of(mut w, ctl)?.iter() {
                let _h32 = field(mut w, *c, "controlType")?;
                let ct = obj_str_r(w, _h32)?;
                let _h33 = field(mut w, *c, "criticality")?;
                let cr = truthy(w, _h33)?;
                println(f"<- control {ct} critical={bool_str(cr)}");
            }
        }
        let none = "".to_string();
        if op == "bindRequest" {
            let _h34 = field(mut w, body, "name")?;
            let name = obj_str_r(w, _h34)?;
            let auth = field(mut w, body, "authentication")?;
            let an = chosen_name(w, auth)?;
            println(f"<- {big_str(mid)} bind {str_repr(name)} {an}");
            let _h35 = field(mut w, body, "version")?;
            if int_of(w, _h35)? != 3 {
                ldap_reply(mut w, mid, "bindResponse", result_p("protocolError", none, "only LDAPv3 is supported"))?;
            } else if an != "simple" {
                let _h207 = field(mut w, auth, "sasl")?;
                let _h103 = field(mut w, _h207, "mechanism")?;
                let mech = obj_str_r(w, _h103)?;
                let msg = f"SASL {mech} is not supported";
                ldap_reply(mut w, mid, "bindResponse", result_p("authMethodNotSupported", none, msg.as_str()))?;
            } else {
                let simple = field(mut w, auth, "simple")?;
                if name.len() == 0 and obj_octets(w, simple)?.len() == 0 {
                    bound = Some("".to_string());
                    ldap_reply(mut w, mid, "bindResponse", result_p("success", none, ""))?;
                } else {
                    let mut entry: Option[J] = None;
                    for e in dir.iter() {
                        if entry.is_none() and ldap_norm(entry_dn(e)) == ldap_norm(name) {
                            entry = Some(e.clone());
                        }
                    }
                    let pw = match entry.clone() {
                        Some(e) => attr_get(e, "userPassword".to_string()),
                        None => None,
                    };
                    let given = obj_str_r(w, simple)?;
                    let ok = match pw {
                        Some(xs) => xs.len() > 0 and xs.contains(given),
                        None => false,
                    };
                    if ok {
                        bound = Some(entry_dn(entry.unwrap()));
                        ldap_reply(mut w, mid, "bindResponse", result_p("success", none, ""))?;
                    } else {
                        ldap_reply(mut w, mid, "bindResponse", result_p("invalidCredentials", none, ""))?;
                    }
                }
            }
        } else if op == "searchRequest" {
            let _h36 = field(mut w, body, "baseObject")?;
            let bo = obj_str_r(w, _h36)?;
            let base = ldap_norm(bo);
            let _h37 = field(mut w, body, "scope")?;
            let scope = pp(w, _h37);
            let mut attrs: Vec[String] = Vec.new();
            let _h208 = field(mut w, body, "attributes")?;
            for a in items_of(mut w, _h208)?.iter() {
                attrs.push(obj_str_r(w, *a)?);
            }
            println(f"<- {big_str(mid)} search {str_repr(bo)} {scope} attrs={join(attrs, ",")}");
            if bound.is_none() {
                ldap_reply(mut w, mid, "searchResDone", result_p("operationsError", none, "bind first"))?;
                continue;
            }
            let mut exists = false;
            for e in dir.iter() {
                if ldap_norm(entry_dn(e)) == base {
                    exists = true;
                }
            }
            if not exists {
                let mut matched = base.clone();
                loop {
                    if matched.len() == 0 {
                        break;
                    }
                    let mut hit = false;
                    for e in dir.iter() {
                        if ldap_norm(entry_dn(e)) == matched {
                            hit = true;
                        }
                    }
                    if hit {
                        break;
                    }
                    matched = match matched.find(",") {
                        Some(k) => slice(matched, k + 1, char_len(matched)),
                        None => "".to_string(),
                    };
                }
                ldap_reply(mut w, mid, "searchResDone", result_p("noSuchObject", matched, ""))?;
                continue;
            }
            let mut sent = 0;
            let mut code = "success";
            let _h38 = field(mut w, body, "sizeLimit")?;
            let limit = int_of(w, _h38)?;
            let _h39 = field(mut w, body, "typesOnly")?;
            let types_only = truthy(w, _h39)?;
            let filt = field(mut w, body, "filter")?;
            for e in dir.iter() {
                let d = ldap_norm(entry_dn(e));
                let inside = if scope == "baseObject" {
                    d == base
                } else if scope == "singleLevel" {
                    match d.find(",") {
                        Some(k) => slice(d, k + 1, char_len(d)) == base,
                        None => false,
                    }
                } else {
                    d == base or d.ends_with(f",{base}".as_str())
                };
                if not inside or not ldap_match(mut w, e, filt)? {
                    continue;
                }
                if limit != 0 and sent == limit {
                    code = "sizeLimitExceeded";
                    break;
                }
                let mut pas: Vec[P] = Vec.new();
                if let Some(J.Obj(ms)) = j_get(e, "attrs") {
                    for mm in ms.iter() {
                        if mm.key == "userPassword" {
                            continue;
                        }
                        if attrs.len() > 0 {
                            let mut want = false;
                            for a in attrs.iter() {
                                if a.to_lowercase() == mm.key.to_lowercase() {
                                    want = true;
                                }
                            }
                            if not want {
                                continue;
                            }
                        }
                        let vals = if types_only { P.List(Vec.new()) } else { pyval(mm.val) };
                        pas.push(P.Dict(vec![item("type", P.Str(mm.key.clone())), item("vals", vals)]));
                    }
                }
                ldap_reply(mut w, mid, "searchResEntry", P.Dict(vec![item("objectName", P.Str(entry_dn(e))), item("attributes", P.List(pas))]))?;
                sent += 1;
            }
            ldap_reply(mut w, mid, "searchResDone", result_p(code, none, ""))?;
        } else if op == "unbindRequest" {
            println(f"<- {big_str(mid)} unbind");
            break;
        } else {
            println(f"<- {big_str(mid)} unexpected {op}");
            ldap_reply(mut w, mid, "searchResDone", result_p("protocolError", none, ""))?;
        }
    }
    Ok(())
}

fn prog_ldap(w: mut ref W) -> Result[(), Exc] {
    let dir = j_arr(loads_str(read_text("data/ldap/directory.json".to_string())?)?);
    let sessions = loads_str(read_text("data/ldap/sessions.json".to_string())?)?;
    for s in j_arr(sessions).iter() {
        println(f"== ldap {j_str(j_get(s, "name").unwrap())}");
        ldap_session(mut w, dir, s)?;
    }
    Ok(())
}

fn run() -> Result[(), Exc] {
    let mut w = new_world();
    let text = read_text("data/schemas.json".to_string())?;
    let j = loads_str(text)?;
    for d in j_arr(j).iter() {
        define(mut w, d)?;
    }
    run_jobs(mut w)?;
    prog_certinfo(mut w)?;
    prog_csr(mut w)?;
    prog_snmp(mut w)?;
    prog_ldap(mut w)?;
    Ok(())
}
// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    data_part_3(mut v);
    data_part_4(mut v);
    v
}

