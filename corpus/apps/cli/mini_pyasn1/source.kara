// mini_pyasn1: pyasn1 0.6.1, the pure-Python ASN.1 library behind
// pysnmp, ldap3, rsa, google-auth and many X.509 tools:
// - the type system: Integer, Boolean, BitString, OctetString, Null,
//   ObjectIdentifier, Real, Enumerated, the character strings, the
//   useful times, Sequence, Set, SequenceOf, SetOf, Choice and Any, with
//   tags, tag sets and tag maps, named types, named values, open types
//   and every constraint, their repr, prettyPrint and errors;
// - schemas built at run time from data/schemas.json, the way an ASN.1
//   module compiles to Python classes;
// - the BER, CER and DER encoders and decoders, definite and indefinite
//   lengths, chunked strings, the CER/DER Set and SetOf ordering, every
//   way a broken substrate fails, and the native (Python value) codec;
// - four programs: an X.509 certificate report, a CSR builder, an SNMP
//   agent answering get, getnext, getbulk and set, and an LDAP server
//   answering bind, search, compare and unbind.
//
// The inputs are data/jobs.json and the files beside it, made by mk.py.
// expected.out is the output of oracle.py, which runs the same jobs and
// programs through pyasn1 itself (the copy in pyasn1/).

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn hex_val(c: i64) -> i64 {
    if c >= 97 { c - 87 } else { c - 48 }
}

fn unhex(s: ref String) -> Vec[u8] {
    let d = s.bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < d.len() {
        out.push((hex_val(d[i] as i64) * 16 + hex_val(d[i + 1] as i64)) as u8);
        i += 2;
    }
    out
}

fn write_data() -> Result[(), String] {
    if fs.exists("data/out".to_string()) {
        if let Err(e) = fs.remove_dir_all("data/out".to_string()) {
            return Err(f"cannot clear data/out: {e}");
        }
    }
    for file in data_files() {
        let mut dir = "data".to_string();
        let parts: Vec[Str] = file.path.split("/").collect();
        let mut i = 0;
        while i + 1 < parts.len() {
            dir = f"{dir}/{parts[i]}";
            i += 1;
        }
        if let Err(e) = fs.create_dir_all(dir) {
            return Err(f"cannot create {dir}: {e}");
        }
        let p = f"data/{file.path}";
        let r = if file.hex { fs.write_bytes(p.clone(), unhex(file.body)) } else { fs.write(p.clone(), file.body.clone()) };
        if let Err(e) = r {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    if let Err(e) = run() {
        eprintln(failure(e));
    }
}
// ------------------------------------------------------------ integers

// A Python int: a sign and base-10000 digits, least significant first,
// with no leading zero digit (zero has no digits).
#[derive(Clone)]
struct Big {
    neg: bool,
    d: Vec[i64],
}

const BASE: i64 = 10000;

fn big_zero() -> Big {
    Big { neg: false, d: Vec.new() }
}

fn trim(d: mut ref Vec[i64]) {
    while d.len() > 0 and d[d.len() - 1] == 0 {
        d.pop();
    }
}

fn big_make(neg: bool, d: own Vec[i64]) -> Big {
    let mut v = d;
    trim(mut v);
    let n = neg and v.len() > 0;
    Big { neg: n, d: v }
}

fn big_from_u64(x: u64) -> Big {
    let mut d: Vec[i64] = Vec.new();
    let mut v = x;
    while v > 0 {
        d.push((v % 10000) as i64);
        v = v / 10000;
    }
    Big { neg: false, d: d }
}

fn big_from_i64(x: i64) -> Big {
    if x >= 0 {
        return big_from_u64(x as u64);
    }
    // -(x + 1) + 1 keeps i64::MIN in range
    let m = big_from_u64((-(x + 1)) as u64);
    let one = big_from_u64(1);
    let mut r = big_add(m, one);
    r.neg = true;
    r
}

fn big_is_zero(a: ref Big) -> bool {
    a.d.len() == 0
}

fn cmp_mag(a: ref Vec[i64], b: ref Vec[i64]) -> i64 {
    if a.len() != b.len() {
        return if a.len() < b.len() { -1 } else { 1 };
    }
    let mut i = a.len() - 1;
    while i >= 0 {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 };
        }
        i -= 1;
    }
    0
}

fn big_cmp(a: ref Big, b: ref Big) -> i64 {
    if a.neg != b.neg {
        return if a.neg { -1 } else { 1 };
    }
    let c = cmp_mag(a.d, b.d);
    if a.neg { -c } else { c }
}

fn add_mag(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut carry = 0;
    let n = if a.len() > b.len() { a.len() } else { b.len() };
    for i in 0..n {
        let x = if i < a.len() { a[i] } else { 0 };
        let y = if i < b.len() { b[i] } else { 0 };
        let s = x + y + carry;
        out.push(s % BASE);
        carry = s / BASE;
    }
    if carry > 0 {
        out.push(carry);
    }
    out
}

// a - b for |a| >= |b|
fn sub_mag(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut borrow = 0;
    for i in 0..a.len() {
        let y = if i < b.len() { b[i] } else { 0 };
        let mut s = a[i] - y - borrow;
        if s < 0 {
            s += BASE;
            borrow = 1;
        } else {
            borrow = 0;
        }
        out.push(s);
    }
    trim(mut out);
    out
}

fn big_add(a: ref Big, b: ref Big) -> Big {
    if a.neg == b.neg {
        return big_make(a.neg, add_mag(a.d, b.d));
    }
    let c = cmp_mag(a.d, b.d);
    if c == 0 {
        return big_zero();
    }
    if c > 0 {
        big_make(a.neg, sub_mag(a.d, b.d))
    } else {
        big_make(b.neg, sub_mag(b.d, a.d))
    }
}

fn big_neg(a: ref Big) -> Big {
    big_make(not a.neg, a.d.clone())
}

fn big_sub(a: ref Big, b: ref Big) -> Big {
    big_add(a, big_neg(b))
}

fn big_abs(a: ref Big) -> Big {
    big_make(false, a.d.clone())
}

fn big_mul(a: ref Big, b: ref Big) -> Big {
    if a.d.len() == 0 or b.d.len() == 0 {
        return big_zero();
    }
    let mut out: Vec[i64] = Vec.filled(a.d.len() + b.d.len() + 1, 0);
    for i in 0..a.d.len() {
        let mut carry = 0;
        for j in 0..b.d.len() {
            let t = out[i + j] + a.d[i] * b.d[j] + carry;
            out[i + j] = t % BASE;
            carry = t / BASE;
        }
        let mut k = i + b.d.len();
        while carry > 0 {
            let t = out[k] + carry;
            out[k] = t % BASE;
            carry = t / BASE;
            k += 1;
        }
    }
    big_make(a.neg != b.neg, out)
}

// |d| * m + add, for 0 <= m, add < 2**48
fn mag_mul_add(d: ref Vec[i64], m: i64, add: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut carry = add;
    for x in d.iter() {
        let t = *x * m + carry;
        out.push(t % BASE);
        carry = t / BASE;
    }
    while carry > 0 {
        out.push(carry % BASE);
        carry = carry / BASE;
    }
    trim(mut out);
    out
}

fn big_mul_small(a: ref Big, m: i64) -> Big {
    if m >= 0 and m < 281474976710656 {
        return big_make(a.neg, mag_mul_add(a.d, m, 0));
    }
    big_mul(a, big_from_i64(m))
}

// |a| divided by a small positive m: the quotient's magnitude and the remainder
fn divmod_small(a: ref Vec[i64], m: i64) -> (Vec[i64], i64) {
    let mut q: Vec[i64] = Vec.filled(a.len(), 0);
    let mut r = 0;
    let mut i = a.len() - 1;
    while i >= 0 {
        let cur = r * BASE + a[i];
        q[i] = cur / m;
        r = cur % m;
        i -= 1;
    }
    trim(mut q);
    (q, r)
}

// |a| divmod |b|, b not zero
fn divmod_mag(a: ref Vec[i64], b: ref Vec[i64]) -> (Vec[i64], Vec[i64]) {
    if cmp_mag(a, b) < 0 {
        return (Vec.new(), a.clone());
    }
    if b.len() == 1 {
        let (q, r) = divmod_small(a, b[0]);
        return (q, if r == 0 { Vec.new() } else { vec![r] });
    }
    let bb = Big { neg: false, d: b.clone() };
    let mut q: Vec[i64] = Vec.filled(a.len(), 0);
    let mut r = big_zero();
    let mut i = a.len() - 1;
    while i >= 0 {
        let mut rd: Vec[i64] = vec![a[i]];
        for x in r.d.iter() {
            rd.push(*x);
        }
        r = big_make(false, rd);
        let mut lo = 0;
        let mut hi = BASE - 1;
        while lo < hi {
            let mid = (lo + hi + 1) / 2;
            if cmp_mag(big_mul_small(bb, mid).d, r.d) <= 0 {
                lo = mid;
            } else {
                hi = mid - 1;
            }
        }
        q[i] = lo;
        r = big_sub(r, big_mul_small(bb, lo));
        i -= 1;
    }
    trim(mut q);
    (q, r.d)
}

// Python's floor division and modulo
fn big_divmod(a: ref Big, b: ref Big) -> (Big, Big) {
    let (qm, rm) = divmod_mag(a.d, b.d);
    let mut q = big_make(a.neg != b.neg, qm);
    let mut r = big_make(a.neg, rm);
    if not big_is_zero(r) and a.neg != b.neg {
        q = big_sub(q, big_from_i64(1));
        r = big_add(r, b);
    }
    (q, r)
}

fn big_gcd(a: ref Big, b: ref Big) -> Big {
    let mut x = big_abs(a);
    let mut y = big_abs(b);
    while not big_is_zero(y) {
        let (_, r) = big_divmod(x, y);
        x = y;
        y = r;
    }
    x
}

fn big_pow_small(base: i64, n: i64) -> Big {
    let mut r = big_from_i64(1);
    let mut b = big_from_i64(base);
    let mut e = n;
    while e > 0 {
        if e % 2 == 1 {
            r = big_mul(r, b);
        }
        e = e / 2;
        if e > 0 {
            b = big_mul(b, b);
        }
    }
    r
}

fn mag_digits(d: ref Vec[i64]) -> String {
    if d.len() == 0 {
        return "0".to_string();
    }
    let mut s = f"{d[d.len() - 1]}";
    let mut i = d.len() - 2;
    while i >= 0 {
        s.push_str(f"{d[i]:04}");
        i -= 1;
    }
    s
}

fn big_str(a: ref Big) -> String {
    let s = mag_digits(a.d);
    if a.neg { f"-{s}" } else { s }
}

fn big_from_digits(s: ref String) -> Big {
    let b = s.bytes().to_vec();
    let mut d: Vec[i64] = Vec.new();
    let mut end = b.len();
    while end > 0 {
        let start = if end >= 4 { end - 4 } else { 0 };
        let mut v = 0;
        for i in start..end {
            v = v * 10 + (b[i] - b'0') as i64;
        }
        d.push(v);
        end = start;
    }
    big_make(false, d)
}

// int.from_bytes(b, "big")
fn big_from_bytes(b: ref Vec[u8]) -> Big {
    let mut r = big_zero();
    for x in b.iter() {
        r = big_add(big_mul_small(r, 256), big_from_i64(*x as i64));
    }
    r
}

// a non-negative int as big-endian bytes, as short as possible
fn big_to_bytes(a: ref Big) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut d = a.d.clone();
    // six bytes at a time: r * BASE stays below 2**63 for r < 2**48
    while d.len() > 0 {
        let (q, r) = divmod_small(d, 281474976710656);
        d = q;
        let mut x = r;
        let mut k = 0;
        while k < 6 and (x > 0 or d.len() > 0) {
            out.push((x % 256) as u8);
            x = x / 256;
            k += 1;
        }
    }
    out.reverse();
    out
}

fn big_to_i64(a: ref Big) -> Option[i64] {
    if a.d.len() > 4 {
        return None;
    }
    let mut v: i64 = 0;
    let mut i = a.d.len() - 1;
    while i >= 0 {
        v = v * BASE + a.d[i];
        i -= 1;
    }
    Some(if a.neg { -v } else { v })
}

// the value as a u64, when 0 <= a < 2**64
fn big_to_u64(a: ref Big) -> Option[u64] {
    if a.neg or a.d.len() > 5 {
        return None;
    }
    let limit = big_from_u64(18446744073709551615);
    if big_cmp(a, limit) > 0 {
        return None;
    }
    let mut v: u64 = 0;
    let mut i = a.d.len() - 1;
    while i >= 0 {
        v = v * 10000 + a.d[i] as u64;
        i -= 1;
    }
    Some(v)
}

fn big_two64() -> Big {
    big_add(big_from_u64(18446744073709551615), big_from_i64(1))
}
// ------------------------------------------------------------ helpers

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    let mut i = 0;
    while i < parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
        i += 1;
    }
    out
}

// Whether str.isprintable() holds for one code point, for the ones these
// programs meet: the C0 and C1 controls, DEL, no-break space and the
// soft hyphen are not.
fn printable(cp: i64) -> bool {
    not (cp < 0x20 or (cp >= 0x7F and cp <= 0xA0) or cp == 0xAD)
}

fn str_repr(t: ref String) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for c in t.chars() {
        if c == '\'' {
            has_single = true;
        } else if c == '"' {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { '"' } else { '\'' };
    let mut out = String.new();
    out.push(quote);
    for c in t.chars() {
        let cp = c as i64;
        if c == quote or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if not printable(cp) {
            out.push_str("\\x");
            out.push_str(hex_n(cp, 2));
        } else {
            out.push(c);
        }
    }
    out.push(quote);
    out
}

// repr(bytes).
fn bytes_repr(b: ref Vec[u8]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for x in b.iter() {
        if *x == 39 {
            has_single = true;
        } else if *x == 34 {
            has_double = true;
        }
    }
    let quote: u8 = if has_single and not has_double { 34 } else { 39 };
    let mut out = String.new();
    out.push('b');
    out.push(quote as char);
    for x in b.iter() {
        let c = *x;
        if c == quote or c == 92 {
            out.push('\\');
            out.push(c as char);
        } else if c == 9 {
            out.push_str("\\t");
        } else if c == 10 {
            out.push_str("\\n");
        } else if c == 13 {
            out.push_str("\\r");
        } else if c < 32 or c >= 127 {
            out.push_str(f"\\x{c:02x}");
        } else {
            out.push(c as char);
        }
    }
    out.push(quote as char);
    out
}

fn hexs(b: ref Vec[u8]) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    for x in b.iter() {
        out.push(digits[(*x as i64) >> 4]);
        out.push(digits[(*x as i64) & 15]);
    }
    String.from_utf8(out).unwrap()
}

fn chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn from_chars(cs: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut out = String.new();
    let mut i = if lo < 0 { 0 } else { lo };
    let end = if hi > cs.len() { cs.len() } else { hi };
    while i < end {
        out.push(cs[i]);
        i += 1;
    }
    out
}

// s[lo:hi] by code points, clamped the way Python slices are.
fn slice(s: ref String, lo: i64, hi: i64) -> String {
    from_chars(chars(s), lo, hi)
}

fn char_len(s: ref String) -> i64 {
    let mut n = 0;
    for _c in s.chars() {
        n += 1;
    }
    n
}

fn is_dig(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn is_py_space(c: char) -> bool {
    let cp = c as i64;
    (cp >= 9 and cp <= 13) or (cp >= 28 and cp <= 32) or cp == 133 or cp == 160
}

fn bytes_of(s: ref String) -> Vec[u8] {
    s.bytes().to_vec()
}

fn sub_bytes(b: ref Vec[u8], lo: i64, hi: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut i = if lo < 0 { 0 } else { lo };
    let end = if hi > b.len() { b.len() } else { hi };
    while i < end {
        out.push(b[i]);
        i += 1;
    }
    out
}

fn concat(a: ref Vec[u8], b: ref Vec[u8]) -> Vec[u8] {
    let mut out = a.clone();
    for x in b.iter() {
        out.push(*x);
    }
    out
}

fn ascii_text(b: ref Vec[u8]) -> String {
    let mut out = String.new();
    for x in b.iter() {
        out.push(*x as char);
    }
    out
}

fn bool_str(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

// The digits of int(text) in base 10 or 2 or 16: surrounding whitespace,
// a sign, an optional 0b/0x prefix in that base, and single underscores
// between digits. None is a ValueError.
fn parse_int_text(t: ref String, base: i64) -> Option[Big] {
    let cs = chars(t);
    let mut lo = 0;
    let mut hi = cs.len();
    while lo < hi and is_py_space(cs[lo]) {
        lo += 1;
    }
    while hi > lo and is_py_space(cs[hi - 1]) {
        hi -= 1;
    }
    let mut neg = false;
    if lo < hi and (cs[lo] == '-' or cs[lo] == '+') {
        neg = cs[lo] == '-';
        lo += 1;
    }
    let mut after_prefix = false;
    if base != 10 and hi - lo >= 2 and cs[lo] == '0' {
        let p = cs[lo + 1];
        if (base == 2 and (p == 'b' or p == 'B')) or (base == 16 and (p == 'x' or p == 'X')) {
            lo += 2;
            after_prefix = true;
        }
    }
    if lo >= hi {
        return None;
    }
    let mut r = big_zero();
    // digits are gathered into chunk (chunk_m = base ** count) before
    // they go into r, so a long literal costs a few passes over r, not one per digit
    let mut chunk = 0;
    let mut chunk_m = 1;
    let mut prev_digit = false;
    let mut i = lo;
    while i < hi {
        let c = cs[i];
        let d = digit_value(c);
        if d >= 0 and d < base {
            chunk = chunk * base + d;
            chunk_m = chunk_m * base;
            if chunk_m >= 1099511627776 {
                r = big_make(false, mag_mul_add(r.d, chunk_m, chunk));
                chunk = 0;
                chunk_m = 1;
            }
            prev_digit = true;
        } else if c == '_' and (prev_digit or (after_prefix and i == lo)) and i + 1 < hi {
            prev_digit = false;
        } else {
            return None;
        }
        i += 1;
    }
    if not prev_digit {
        return None;
    }
    if chunk_m > 1 {
        r = big_make(false, mag_mul_add(r.d, chunk_m, chunk));
    }
    if neg {
        r = big_neg(r);
    }
    Some(r)
}

fn digit_value(c: char) -> i64 {
    if c >= '0' and c <= '9' {
        c as i64 - 48
    } else if c >= 'a' and c <= 'z' {
        c as i64 - 87
    } else if c >= 'A' and c <= 'Z' {
        c as i64 - 55
    } else {
        -1
    }
}

// float(text): whitespace around it, underscores only between digits,
// and inf / nan spelled any way.
fn py_float(t: ref String) -> Option[f64] {
    let all = chars(t);
    let mut lo = 0;
    let mut hi = all.len();
    while lo < hi and is_py_space(all[lo]) {
        lo += 1;
    }
    while hi > lo and is_py_space(all[hi - 1]) {
        hi -= 1;
    }
    let v: Vec[char] = from_chars(all, lo, hi).chars().collect();
    let mut clean = String.new();
    for i in 0..v.len() {
        if v[i] == '_' {
            if i == 0 or i + 1 >= v.len() or not is_dig(v[i - 1]) or not is_dig(v[i + 1]) {
                return None;
            }
        } else {
            clean.push(v[i]);
        }
    }
    let low = clean.to_lowercase();
    let neg = low.starts_with("-");
    let body = if low.starts_with("+") or neg { slice(low, 1, char_len(low)) } else { low.clone() };
    if body == "inf" or body == "infinity" or body == "nan" {
        let x = if body == "nan" { 0.0 / 0.0 } else { 1.0 / 0.0 };
        return Some(if neg { -x } else { x });
    }
    let b = chars(body);
    let mut i = 0;
    let mut digits = 0;
    while i < b.len() and is_dig(b[i]) {
        i += 1;
        digits += 1;
    }
    if i < b.len() and b[i] == '.' {
        i += 1;
        while i < b.len() and is_dig(b[i]) {
            i += 1;
            digits += 1;
        }
    }
    if digits == 0 {
        return None;
    }
    if i < b.len() and b[i] == 'e' {
        i += 1;
        if i < b.len() and (b[i] == '+' or b[i] == '-') {
            i += 1;
        }
        let start = i;
        while i < b.len() and is_dig(b[i]) {
            i += 1;
        }
        if i == start {
            return None;
        }
    }
    if i != b.len() {
        return None;
    }
    match f64.parse(clean) {
        Ok(x) => Some(x),
        Err(_) => None,
    }
}

fn float_repr(x: f64) -> String {
    if x.is_nan() {
        return "nan".to_string();
    }
    f"{x}"
}

// ------------------------------------------------------- more integers

fn big_i(x: i64) -> Big {
    big_from_i64(x)
}

fn big_eq(a: ref Big, b: ref Big) -> bool {
    big_cmp(a, b) == 0
}

fn big_small(a: ref Big) -> i64 {
    big_to_i64(a).unwrap_or(0)
}

fn big_fits(a: ref Big) -> bool {
    a.d.len() <= 4
}

fn big_pow2(k: i64) -> Big {
    big_shl(big_from_i64(1), k)
}

// a << k
fn big_shl(a: ref Big, k: i64) -> Big {
    if k <= 0 {
        return a.clone();
    }
    let mut d = a.d.clone();
    let mut n = k;
    while n > 0 {
        let step = if n > 20 { 20 } else { n };
        d = mag_mul_add(d, 1 << step, 0);
        n -= step;
    }
    big_make(a.neg, d)
}

// a >> k, flooring as Python does
fn big_shr(a: ref Big, k: i64) -> Big {
    if k <= 0 {
        return a.clone();
    }
    if a.neg {
        let (q, _) = big_divmod(a, big_pow2(k));
        return q;
    }
    let mut d = a.d.clone();
    let mut n = k;
    while n > 0 and d.len() > 0 {
        let step = if n > 20 { 20 } else { n };
        let (q, _) = divmod_small(d, 1 << step);
        d = q;
        n -= step;
    }
    big_make(false, d)
}

// int.bit_length()
fn big_bit_length(a: ref Big) -> i64 {
    let b = big_to_bytes(big_abs(a));
    if b.len() == 0 {
        return 0;
    }
    let mut top = b[0] as i64;
    let mut n = (b.len() - 1) * 8;
    while top > 0 {
        n += 1;
        top = top >> 1;
    }
    n
}

// a non-negative int as n big-endian bytes
fn big_to_bytes_n(a: ref Big, n: i64) -> Vec[u8] {
    let b = big_to_bytes(a);
    let mut out: Vec[u8] = Vec.new();
    let mut k = b.len();
    while k < n {
        out.push(0);
        k += 1;
    }
    for x in b.iter() {
        out.push(*x);
    }
    out
}

// int.to_bytes(n, "big", signed=True)
fn big_to_signed_bytes(a: ref Big, n: i64) -> Vec[u8] {
    if not a.neg {
        return big_to_bytes_n(a, n);
    }
    let m = big_add(a, big_pow_small(256, n));
    big_to_bytes_n(m, n)
}

// int.from_bytes(b, "big", signed=True)
fn big_from_signed_bytes(b: ref Vec[u8]) -> Big {
    let v = big_from_bytes(b);
    if b.len() > 0 and b[0] >= 0x80 {
        return big_sub(v, big_pow_small(256, b.len()));
    }
    v
}

fn big_or(a: ref Big, b: ref Big) -> Big {
    let x = big_to_bytes(a);
    let y = big_to_bytes(b);
    let n = if x.len() > y.len() { x.len() } else { y.len() };
    let xa = big_to_bytes_n(a, n);
    let ya = big_to_bytes_n(b, n);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..n {
        out.push(xa[i] | ya[i]);
    }
    big_from_bytes(out)
}

fn big_and_small(a: ref Big, m: i64) -> i64 {
    let (_, r) = big_divmod(a, big_i(m + 1));
    big_small(r)
}

// float(int); None is OverflowError
fn big_to_f64(a: ref Big) -> Option[f64] {
    match f64.parse(big_str(a)) {
        Ok(x) => if x.is_infinite() { None } else { Some(x) },
        Err(_) => None,
    }
}

// int(float), for a finite float
fn f64_to_big(x: f64) -> Big {
    exact_float_int(x.trunc())
}

// x is integral: halve it until it fits in 53 bits, which is exact
fn exact_float_int(x: f64) -> Big {
    let neg = x < 0.0;
    let mut v = if neg { -x } else { x };
    if v < 9007199254740992.0 {
        let r = big_from_i64(v as i64);
        return if neg { big_neg(r) } else { r };
    }
    let mut e = 0;
    while v >= 9007199254740992.0 {
        v = v / 2.0;
        e += 1;
    }
    let r = big_shl(big_from_i64(v as i64), e);
    if neg { big_neg(r) } else { r }
}

fn hex_low(a: ref Big) -> String {
    let b = big_to_bytes(big_abs(a));
    if b.len() == 0 {
        return "0".to_string();
    }
    let h = hexs(b);
    let mut s = if h.starts_with("0") { slice(h, 1, char_len(h)) } else { h };
    if a.neg {
        s = f"-{s}";
    }
    s
}

// bin(a)[2:]: for a negative number the slice keeps the "b"
fn bin_digits(a: ref Big) -> String {
    let b = big_to_bytes(big_abs(a));
    let mut s = String.new();
    let mut started = false;
    for x in b.iter() {
        let mut k = 7;
        while k >= 0 {
            let bit = ((*x as i64) >> k) & 1;
            if bit == 1 {
                started = true;
            }
            if started {
                s.push(if bit == 1 { '1' } else { '0' });
            }
            k -= 1;
        }
    }
    if not started {
        s.push('0');
    }
    if a.neg { f"b{s}" } else { s }
}
// ------------------------------------------------------------ Python values

// A value json.loads gives: integers keep their digits, so one past 64
// bits prints as Python prints it; objects keep their keys in order, and
// a repeated key keeps its first place and takes its last value.
#[derive(Clone)]
enum J {
    Null,
    Bool(bool),
    Int(String),
    Float(f64),
    Str(String),
    Arr(Vec[J]),
    Obj(Vec[Member]),
}

#[derive(Clone)]
struct Member {
    key: String,
    val: J,
}

// ------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn push_utf8(out: mut ref Vec[u8], cp: i64) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push((0xC0 | (cp >> 6)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else if cp < 0x10000 {
        out.push((0xE0 | (cp >> 12)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else {
        out.push((0xF0 | (cp >> 18)) as u8);
        out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    }
}

fn is_surrogate(cp: i64) -> bool {
    cp >= 0xD800 and cp <= 0xDFFF
}

fn hex4(cp: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = 12;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn ascii_string(s: ref Vec[i64], start: i64, end: i64) -> String {
    let mut out: Vec[u8] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i] as u8);
        i += 1;
    }
    String.from_utf8(out).unwrap()
}


// ---------------------------------------------------------- decoding

// The C scanner in Modules/_json.c, over code points.
struct Scanner {
    s: Vec[i64],
}

fn is_digit(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn hex_value(c: i64) -> i64 {
    if c >= 48 and c <= 57 {
        c - 48
    } else if c >= 97 and c <= 102 {
        c - 87
    } else if c >= 65 and c <= 70 {
        c - 55
    } else {
        -1
    }
}

impl Scanner {
    fn at(ref self, i: i64) -> i64 {
        if i >= 0 and i < self.s.len() { self.s[i] } else { -1 }
    }

    // JSONDecodeError's message: the line and column are counted from the
    // newlines before the position.
    fn fail(ref self, msg: Str, pos: i64) -> Exc {
        let mut line = 1;
        let mut last = -1;
        let mut i = 0;
        while i < pos {
            if self.s[i] == 10 {
                line += 1;
                last = i;
            }
            i += 1;
        }
        exc("JSONDecodeError", f"{msg}: line {line} column {pos - last} (char {pos})")
    }

    fn skip_ws(ref self, start: i64) -> i64 {
        let mut i = start;
        while i < self.s.len() {
            let c = self.s[i];
            if c != 32 and c != 9 and c != 10 and c != 13 {
                break;
            }
            i += 1;
        }
        i
    }

    fn matches(ref self, i: i64, word: Str) -> bool {
        let w = word.bytes();
        if i + w.len() > self.s.len() {
            return false;
        }
        let mut k = 0;
        while k < w.len() {
            if self.s[i + k] != w[k] as i64 {
                return false;
            }
            k += 1;
        }
        true
    }

    fn scan_once(ref self, idx: i64) -> Result[(J, i64), Exc] {
        let c = self.at(idx);
        if c == 34 {
            let (text, end) = self.scan_string(idx + 1)?;
            return Ok((J.Str(cps_string(text)), end));
        }
        if c == 123 {
            return self.parse_object(idx + 1);
        }
        if c == 91 {
            return self.parse_array(idx + 1);
        }
        if c == 110 and self.matches(idx, "null") {
            return Ok((J.Null, idx + 4));
        }
        if c == 116 and self.matches(idx, "true") {
            return Ok((J.Bool(true), idx + 4));
        }
        if c == 102 and self.matches(idx, "false") {
            return Ok((J.Bool(false), idx + 5));
        }
        if c == 78 and self.matches(idx, "NaN") {
            return Ok((J.Float(0.0 / 0.0), idx + 3));
        }
        if c == 73 and self.matches(idx, "Infinity") {
            return Ok((J.Float(1.0 / 0.0), idx + 8));
        }
        if c == 45 and self.matches(idx, "-Infinity") {
            return Ok((J.Float(-1.0 / 0.0), idx + 9));
        }
        self.match_number(idx)
    }

    // -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][-+]?[0-9]+)?, then int() or float()
    // of the text. Anything else at a value's place is "Expecting value".
    fn match_number(ref self, start: i64) -> Result[(J, i64), Exc] {
        let end_idx = self.s.len() - 1;
        let mut idx = start;
        if self.at(idx) == 45 {
            idx += 1;
            if idx > end_idx {
                return Err(self.fail("Expecting value", start));
            }
        }
        let c = self.at(idx);
        if c >= 49 and c <= 57 {
            idx += 1;
            while idx <= end_idx and is_digit(self.s[idx]) {
                idx += 1;
            }
        } else if c == 48 {
            idx += 1;
        } else {
            return Err(self.fail("Expecting value", start));
        }
        let mut is_float = false;
        if idx < end_idx and self.s[idx] == 46 and is_digit(self.s[idx + 1]) {
            is_float = true;
            idx += 2;
            while idx <= end_idx and is_digit(self.s[idx]) {
                idx += 1;
            }
        }
        if idx < end_idx and (self.s[idx] == 101 or self.s[idx] == 69) {
            let e_start = idx;
            idx += 1;
            if idx < end_idx and (self.s[idx] == 45 or self.s[idx] == 43) {
                idx += 1;
            }
            while idx <= end_idx and is_digit(self.s[idx]) {
                idx += 1;
            }
            if is_digit(self.s[idx - 1]) {
                is_float = true;
            } else {
                idx = e_start;
            }
        }
        let text = ascii_string(self.s, start, idx);
        if is_float {
            return match f64.parse(text) {
                Ok(x) => Ok((J.Float(x), idx)),
                Err(_) => Err(exc("ValueError", f"could not convert string to float: '{text}'")),
            };
        }
        let digits = if self.s[start] == 45 { idx - start - 1 } else { idx - start };
        if digits > 4300 {
            return Err(exc("ValueError", f"Exceeds the limit (4300 digits) for integer string conversion: value has {digits} digits; use sys.set_int_max_str_digits() to increase the limit"));
        }
        if text == "-0" {
            return Ok((J.Int("0".to_string()), idx));
        }
        Ok((J.Int(text), idx))
    }

    fn hex_escape(ref self, at: i64) -> Option[i64] {
        let mut v = 0;
        let mut k = 0;
        while k < 4 {
            let d = hex_value(self.at(at + k));
            if d < 0 {
                return None;
            }
            v = v * 16 + d;
            k += 1;
        }
        Some(v)
    }

    // scanstring: `start` is just past the opening quote.
    fn scan_string(ref self, start: i64) -> Result[(Vec[i64], i64), Exc] {
        let len = self.s.len();
        let begin = start - 1;
        let mut out: Vec[i64] = Vec.new();
        let mut end = start;
        loop {
            let mut next = end;
            let mut c = 0;
            while next < len {
                c = self.s[next];
                if c == 34 or c == 92 {
                    break;
                }
                if c <= 0x1F {
                    return Err(self.fail("Invalid control character at", next));
                }
                out.push(c);
                next += 1;
            }
            if next == len {
                return Err(self.fail("Unterminated string starting at", begin));
            }
            next += 1;
            if c == 34 {
                return Ok((out, next));
            }
            if next == len {
                return Err(self.fail("Unterminated string starting at", begin));
            }
            let e = self.s[next];
            if e != 117 {
                end = next + 1;
                let ch = match e {
                    34 => 34,
                    92 => 92,
                    47 => 47,
                    98 => 8,
                    102 => 12,
                    110 => 10,
                    114 => 13,
                    116 => 9,
                    _ => 0,
                };
                if ch == 0 {
                    return Err(self.fail("Invalid \\escape", end - 2));
                }
                out.push(ch);
            } else {
                next += 1;
                end = next + 4;
                if end >= len {
                    return Err(self.fail("Invalid \\uXXXX escape", next - 1));
                }
                let mut cp = match self.hex_escape(next) {
                    Some(v) => v,
                    None => return Err(self.fail("Invalid \\uXXXX escape", end - 5)),
                };
                // A high surrogate followed by an escaped low one is a pair;
                // followed by anything else it stays on its own.
                if cp >= 0xD800 and cp <= 0xDBFF and end + 6 < len and self.s[end] == 92 and self.s[end + 1] == 117 {
                    let low = match self.hex_escape(end + 2) {
                        Some(v) => v,
                        None => return Err(self.fail("Invalid \\uXXXX escape", end + 1)),
                    };
                    if low >= 0xDC00 and low <= 0xDFFF {
                        cp = 0x10000 + (((cp - 0xD800) << 10) | (low - 0xDC00));
                        end += 6;
                    }
                }
                out.push(cp);
            }
        }
    }

    fn parse_object(ref self, start: i64) -> Result[(J, i64), Exc] {
        let mut members: Vec[Member] = Vec.new();
        let mut idx = self.skip_ws(start);
        if self.at(idx) != 125 {
            loop {
                if self.at(idx) != 34 {
                    return Err(self.fail("Expecting property name enclosed in double quotes", idx));
                }
                let (key, after_key) = self.scan_string(idx + 1)?;
                idx = self.skip_ws(after_key);
                if self.at(idx) != 58 {
                    return Err(self.fail("Expecting ':' delimiter", idx));
                }
                idx = self.skip_ws(idx + 1);
                let (val, after_val) = self.scan_once(idx)?;
                put_member(mut members, cps_string(key), val);
                idx = self.skip_ws(after_val);
                if self.at(idx) == 125 {
                    break;
                }
                if self.at(idx) != 44 {
                    return Err(self.fail("Expecting ',' delimiter", idx));
                }
                let comma = idx;
                idx = self.skip_ws(idx + 1);
                if self.at(idx) == 125 {
                    return Err(self.fail("Illegal trailing comma before end of object", comma));
                }
            }
        }
        Ok((J.Obj(members), idx + 1))
    }

    fn parse_array(ref self, start: i64) -> Result[(J, i64), Exc] {
        let mut items: Vec[J] = Vec.new();
        let mut idx = self.skip_ws(start);
        if self.at(idx) != 93 {
            loop {
                let (val, after) = self.scan_once(idx)?;
                items.push(val);
                idx = self.skip_ws(after);
                if self.at(idx) == 93 {
                    break;
                }
                if self.at(idx) != 44 {
                    return Err(self.fail("Expecting ',' delimiter", idx));
                }
                let comma = idx;
                idx = self.skip_ws(idx + 1);
                if self.at(idx) == 93 {
                    return Err(self.fail("Illegal trailing comma before end of array", comma));
                }
            }
        }
        Ok((J.Arr(items), idx + 1))
    }
}

// dict(pairs): a key seen again keeps its place and takes the new value.
fn put_member(members: mut ref Vec[Member], key: own String, val: own J) {
    let mut j = 0;
    while j < members.len() {
        if members[j].key == key {
            members[j].val = val;
            return;
        }
        j += 1;
    }
    members.push(Member { key: key, val: val });
}

// A str from code points. A lone surrogate, which a str can hold but a
// Kara String cannot, becomes U+FFFD.
fn cps_string(cps: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for c in cps.iter() {
        if is_surrogate(*c) {
            push_utf8(mut out, 0xFFFD);
        } else {
            push_utf8(mut out, *c);
        }
    }
    String.from_utf8(out).unwrap()
}

fn string_cps(s: ref String) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s.chars() {
        out.push(c as i64);
    }
    out
}

// json.loads on a str.
fn loads_cps(text: ref Vec[i64]) -> Result[J, Exc] {
    let sc = Scanner { s: text.clone() };
    if sc.at(0) == 0xFEFF {
        return Err(sc.fail("Unexpected UTF-8 BOM (decode using utf-8-sig)", 0));
    }
    let start = sc.skip_ws(0);
    let (value, end) = sc.scan_once(start)?;
    let stop = sc.skip_ws(end);
    if stop != sc.s.len() {
        return Err(sc.fail("Extra data", stop));
    }
    Ok(value)
}

fn loads_str(text: ref String) -> Result[J, Exc] {
    loads_cps(string_cps(text))
}

// The error bytes.decode("utf-8") raises: the bad byte, or the bytes from
// a sequence's start up to the one that does not fit.
fn utf8_error(b: ref Vec[u8], start: i64, end: i64, reason: Str) -> Exc {
    if end - start == 1 {
        return exc("UnicodeDecodeError", f"'utf-8' codec can't decode byte 0x{b[start]:02x} in position {start}: {reason}");
    }
    exc("UnicodeDecodeError", f"'utf-8' codec can't decode bytes in position {start}-{end - 1}: {reason}")
}

fn is_cont(c: u8) -> bool {
    c >= 0x80 and c <= 0xBF
}

// bytes.decode("utf-8", "surrogatepass"), as json.loads decodes bytes.
// An encoded surrogate (ED A0..BF 80..BF) is let through.
fn utf8_decode(b: ref Vec[u8]) -> Result[Vec[i64], Exc] {
    let mut out: Vec[i64] = Vec.new();
    let n = b.len();
    let mut i = 0;
    while i < n {
        let c = b[i];
        if c < 0x80 {
            out.push(c as i64);
            i += 1;
            continue;
        }
        if c < 0xC2 or c > 0xF4 {
            return Err(utf8_error(b, i, i + 1, "invalid start byte"));
        }
        let need = if c < 0xE0 { 1 } else if c < 0xF0 { 2 } else { 3 };
        // The range the second byte must fall in.
        let mut lo: u8 = 0x80;
        let mut hi: u8 = 0xBF;
        if c == 0xE0 {
            lo = 0xA0;
        } else if c == 0xF0 {
            lo = 0x90;
        } else if c == 0xF4 {
            hi = 0x8F;
        }
        // ED A0..BF starts a surrogate, which strict UTF-8 rejects at the
        // second byte; when the third byte does not complete it, the error
        // is that one.
        let surrogate = c == 0xED and n > i + 1 and b[i + 1] >= 0xA0 and b[i + 1] <= 0xBF;
        if surrogate and (n <= i + 2 or not is_cont(b[i + 2])) {
            return Err(utf8_error(b, i, i + 1, "invalid continuation byte"));
        }
        let mut k = 1;
        while k <= need {
            if i + k >= n {
                return Err(utf8_error(b, i, n, "unexpected end of data"));
            }
            let d = b[i + k];
            let ok = if k == 1 { d >= lo and d <= hi } else { is_cont(d) };
            if not ok {
                return Err(utf8_error(b, i, i + k, "invalid continuation byte"));
            }
            k += 1;
        }
        let mut cp = if need == 1 { (c as i64) & 0x1F } else if need == 2 { (c as i64) & 0x0F } else { (c as i64) & 0x07 };
        for j in 1..(need + 1) {
            cp = (cp << 6) | ((b[i + j] as i64) & 0x3F);
        }
        out.push(cp);
        i += need + 1;
    }
    Ok(out)
}

// json.loads on bytes: the encoding is detected (only UTF-8, with or
// without its BOM, is handled here), the bytes are decoded, and the text
// is loaded. A decode error is a ValueError, as JSONDecodeError is.
fn loads_bytes(b: ref Vec[u8]) -> Result[J, Exc] {
    let mut body = b.clone();
    if b.len() >= 3 and b[0] == 0xEF and b[1] == 0xBB and b[2] == 0xBF {
        body = Vec.new();
        for i in 3..b.len() {
            body.push(b[i]);
        }
    }
    let cps = utf8_decode(body)?;
    loads_cps(cps)
}
// ------------------------------------------------------------ the model

// The pyasn1 classes a type descends from: each has its own typeId, and
// a class defined from one keeps it.
const T_INT: i64 = 1;
const T_BOOL: i64 = 2;
const T_BITS: i64 = 3;
const T_OCTETS: i64 = 4;
const T_NULL: i64 = 5;
const T_OID: i64 = 6;
const T_RELOID: i64 = 7;
const T_REAL: i64 = 8;
const T_ENUM: i64 = 9;
const T_SEQOF: i64 = 10;
const T_SETOF: i64 = 11;
const T_SEQ: i64 = 12;
const T_SET: i64 = 13;
const T_CHOICE: i64 = 14;
const T_ANY: i64 = 15;
const T_UTF8: i64 = 16;
const T_NUMERIC: i64 = 17;
const T_PRINTABLE: i64 = 18;
const T_TELETEX: i64 = 19;
const T_T61: i64 = 20;
const T_VIDEOTEX: i64 = 21;
const T_IA5: i64 = 22;
const T_GRAPHIC: i64 = 23;
const T_VISIBLE: i64 = 24;
const T_ISO646: i64 = 25;
const T_GENERAL: i64 = 26;
const T_UNIVERSAL: i64 = 27;
const T_BMP: i64 = 28;
const T_OBJDESC: i64 = 29;
const T_GENTIME: i64 = 30;
const T_UTCTIME: i64 = 31;
const T_EOO: i64 = 32;

fn is_intlike(t: i64) -> bool {
    t == T_INT or t == T_BOOL or t == T_ENUM
}

fn is_octetlike(t: i64) -> bool {
    t == T_OCTETS or t == T_NULL or t == T_ANY
}

fn is_char(t: i64) -> bool {
    t >= T_UTF8 and t <= T_UTCTIME
}

fn is_time(t: i64) -> bool {
    t == T_GENTIME or t == T_UTCTIME
}

// OctetString and everything below it
fn is_octet_family(t: i64) -> bool {
    is_octetlike(t) or is_char(t)
}

fn is_constructed(t: i64) -> bool {
    t >= T_SEQOF and t <= T_CHOICE
}

fn is_seqof(t: i64) -> bool {
    t == T_SEQOF or t == T_SETOF
}

fn is_record(t: i64) -> bool {
    t == T_SEQ or t == T_SET or t == T_CHOICE
}

// isinstance(x, univ.Set): Choice is a Set
fn is_set_like(t: i64) -> bool {
    t == T_SET or t == T_CHOICE
}

fn has_named_values(t: i64) -> bool {
    is_intlike(t) or t == T_BITS
}

// ------------------------------------------------------- Python values

// A Python value, as the jobs give them, constraints hold them and the
// native encoder returns them.
#[derive(Clone)]
enum P {
    None_,
    Bool(bool),
    Int(Big),
    Float(f64),
    Str(String),
    Bytes(Vec[u8]),
    List(Vec[P]),
    Tuple(Vec[P]),
    Dict(Vec[PItem]),
    ODict(Vec[PItem]),
    Obj(i64),
    // a SizedInteger: its value and its bit length
    Bits(Big, i64),
}

#[derive(Clone)]
struct PItem {
    key: P,
    val: P,
}

fn p_int(x: i64) -> P {
    P.Int(big_i(x))
}

fn p_s(s: Str) -> P {
    P.Str(s.to_string())
}

// A raised exception: its class, str() and the repr() of its argument.
#[derive(Clone)]
struct Exc {
    kind: String,
    msg: String,
    rep: String,
}

fn exc(kind: Str, msg: own String) -> Exc {
    let r = str_repr(msg);
    Exc { kind: kind.to_string(), msg: msg, rep: r }
}

fn perr(msg: own String) -> Exc {
    exc("PyAsn1Error", msg)
}

fn failure(e: ref Exc) -> String {
    f"{e.kind}: {e.msg}"
}

fn exc_repr(e: ref Exc) -> String {
    f"{e.kind}({e.rep})"
}

// except error.PyAsn1Error
fn is_pyasn1(e: ref Exc) -> bool {
    e.kind == "PyAsn1Error" or e.kind == "ValueConstraintError" or e.kind == "SubstrateUnderrunError"
        or e.kind == "EndOfStreamError" or e.kind == "PyAsn1UnicodeDecodeError" or e.kind == "PyAsn1UnicodeEncodeError"
}

fn is_vce(e: ref Exc) -> bool {
    e.kind == "ValueConstraintError"
}

fn novalue_op(op: Str) -> Exc {
    perr(f"Attempted \"{op}\" operation on ASN.1 schema object")
}

// ------------------------------------------------------------ tags

#[derive(Clone)]
struct Tag {
    cls: i64,
    fmt: i64,
    id: i64,
}

#[derive(Clone)]
struct TagSet {
    base: Vec[Tag],
    tags: Vec[Tag],
}

fn mk_tag(cls: i64, fmt: i64, id: i64) -> Tag {
    Tag { cls: cls, fmt: fmt, id: id }
}

fn untagged() -> TagSet {
    TagSet { base: Vec.new(), tags: Vec.new() }
}

fn init_tagset(t: ref Tag) -> TagSet {
    TagSet { base: vec![t.clone()], tags: vec![t.clone()] }
}

fn tag_str(t: ref Tag) -> String {
    f"{t.cls}:{t.fmt}:{t.id}"
}

fn ts_repr(ts: ref TagSet) -> String {
    if ts.tags.len() == 0 {
        return "<TagSet object, untagged>".to_string();
    }
    let mut parts: Vec[String] = Vec.new();
    for t in ts.tags.iter() {
        parts.push(tag_str(t));
    }
    f"<TagSet object, tags {join(parts, "-")}>"
}

fn ts_eq(a: ref TagSet, b: ref TagSet) -> bool {
    if a.tags.len() != b.tags.len() {
        return false;
    }
    let mut i = 0;
    while i < a.tags.len() {
        if a.tags[i].cls != b.tags[i].cls or a.tags[i].id != b.tags[i].id {
            return false;
        }
        i += 1;
    }
    true
}

// tuple comparison of the (class, id) pairs: -1, 0 or 1
fn ts_cmp(a: ref TagSet, b: ref TagSet) -> i64 {
    let mut i = 0;
    while i < a.tags.len() and i < b.tags.len() {
        let x = a.tags[i].clone();
        let y = b.tags[i].clone();
        if x.cls != y.cls {
            return if x.cls < y.cls { -1 } else { 1 };
        }
        if x.id != y.id {
            return if x.id < y.id { -1 } else { 1 };
        }
        i += 1;
    }
    if a.tags.len() == b.tags.len() {
        0
    } else if a.tags.len() < b.tags.len() {
        -1
    } else {
        1
    }
}

fn ts_slice(ts: ref TagSet, lo: i64, hi: i64) -> TagSet {
    let mut tags: Vec[Tag] = Vec.new();
    let n = ts.tags.len();
    let a = if lo < 0 { if n + lo < 0 { 0 } else { n + lo } } else { lo };
    let b = if hi < 0 { if n + hi < 0 { 0 } else { n + hi } } else if hi > n { n } else { hi };
    let mut i = a;
    while i < b {
        tags.push(ts.tags[i].clone());
        i += 1;
    }
    TagSet { base: ts.base.clone(), tags: tags }
}

fn ts_add(ts: ref TagSet, t: ref Tag) -> TagSet {
    let mut tags = ts.tags.clone();
    tags.push(t.clone());
    TagSet { base: ts.base.clone(), tags: tags }
}

// lastTag + tagSet: the tag goes first
fn ts_prepend(t: ref Tag, ts: ref TagSet) -> TagSet {
    let mut tags: Vec[Tag] = vec![t.clone()];
    for x in ts.tags.iter() {
        tags.push(x.clone());
    }
    TagSet { base: ts.base.clone(), tags: tags }
}

fn ts_explicit(ts: ref TagSet, t: ref Tag) -> Result[TagSet, Exc] {
    if t.cls == 0 {
        return Err(perr("Can't tag with UNIVERSAL class tag".to_string()));
    }
    let st = mk_tag(t.cls, 32, t.id);
    Ok(ts_add(ts, st))
}

fn ts_implicit(ts: ref TagSet, t: ref Tag) -> TagSet {
    let mut st = t.clone();
    if ts.tags.len() > 0 {
        st = mk_tag(t.cls, ts.tags[ts.tags.len() - 1].fmt, t.id);
    }
    ts_add(ts_slice(ts, 0, -1), st)
}

fn ts_is_super_of(a: ref TagSet, b: ref TagSet) -> bool {
    if b.tags.len() < a.tags.len() {
        return false;
    }
    ts_eq(a, ts_slice(b, 0, a.tags.len()))
}

// TagSet(tagSet.baseTag, tagSet.baseTag)
fn base_tagset(ts: ref TagSet) -> TagSet {
    TagSet { base: ts.base.clone(), tags: ts.base.clone() }
}

// ------------------------------------------------------- constraints

const C_INTER: i64 = 0;
const C_UNION: i64 = 1;
const C_EXCL: i64 = 2;
const C_SINGLE: i64 = 3;
const C_RANGE: i64 = 4;
const C_SIZE: i64 = 5;
const C_ALPHA: i64 = 6;

#[derive(Clone)]
struct Con {
    kind: i64,
    vals: Vec[P],
    subs: Vec[i64],
}

fn con_is_set(k: i64) -> bool {
    k == C_INTER or k == C_UNION or k == C_EXCL
}

fn con_name(k: i64) -> String {
    match k {
        0 => "ConstraintsIntersection".to_string(),
        1 => "ConstraintsUnion".to_string(),
        2 => "ConstraintsExclusion".to_string(),
        3 => "SingleValueConstraint".to_string(),
        4 => "ValueRangeConstraint".to_string(),
        5 => "ValueSizeConstraint".to_string(),
        _ => "PermittedAlphabetConstraint".to_string(),
    }
}

// ------------------------------------------------------ named things

#[derive(Clone)]
struct Nv {
    names: Vec[String],
    nums: Vec[i64],
}

#[derive(Clone)]
struct Nt {
    name: String,
    obj: i64,
    opt: bool,
    dflt: bool,
    open: i64,
}

#[derive(Clone)]
struct Nts {
    items: Vec[Nt],
}

// An OpenType: the governing field's name and its map of values to types.
#[derive(Clone)]
struct Ot {
    gov: String,
    keys: Vec[i64],
    vals: Vec[i64],
}

// A TagMap: present and skipped tag sets (the type each maps to), the
// default type, and the error a PostponedError holds instead.
#[derive(Clone)]
struct Tme {
    ts: TagSet,
    obj: i64,
}

#[derive(Clone)]
struct Tm {
    present: Vec[Tme],
    skip: Vec[Tme],
    dflt: i64,
    err: String,
}

// ------------------------------------------------------ values, objects

#[derive(Clone)]
enum Num {
    I(Big),
    F(f64),
}

#[derive(Clone)]
enum Val {
    NoValue,
    Int(Big),
    Bits(Big, i64),
    Octets(Vec[u8]),
    Text(String),
    Oid(Vec[Big]),
    // +inf (true) or -inf
    Inf(bool),
    Real(Num, i64, i64),
}

// A class: what pyasn1 keeps as class attributes.
#[derive(Clone)]
struct Cls {
    name: String,
    tid: i64,
    tags: TagSet,
    sub: i64,
    named: i64,
    enc: String,
    ctype: i64,
    size: i64,
}

// An instance. Simple ones never change after they are made; constructed
// ones hold their components as object ids, -1 for noValue.
#[derive(Clone)]
struct Obj {
    cls: i64,
    tid: i64,
    tags: TagSet,
    sub: i64,
    named: i64,
    enc: String,
    ctype: i64,
    size: i64,
    val: Val,
    has: bool,
    comps: Vec[i64],
    cur: i64,
}

struct W {
    objs: Vec[Obj],
    cons: Vec[Con],
    nvs: Vec[Nv],
    nts: Vec[Nts],
    ots: Vec[Ot],
    classes: Vec[Cls],
    by_name: Map[String, i64],
    eoo: i64,
}

fn new_con(w: mut ref W, kind: i64, vals: own Vec[P], subs: own Vec[i64]) -> i64 {
    w.cons.push(Con { kind: kind, vals: vals, subs: subs });
    w.cons.len() - 1
}

fn new_inter(w: mut ref W, subs: own Vec[i64]) -> i64 {
    new_con(mut w, C_INTER, Vec.new(), subs)
}

fn new_nv(w: mut ref W, names: own Vec[String], nums: own Vec[i64]) -> i64 {
    w.nvs.push(Nv { names: names, nums: nums });
    w.nvs.len() - 1
}

fn new_nts(w: mut ref W, items: own Vec[Nt]) -> i64 {
    w.nts.push(Nts { items: items });
    w.nts.len() - 1
}

fn cls_id(w: ref W, name: Str) -> i64 {
    match w.by_name.get(name.to_string()) {
        Some(i) => *i,
        None => -1,
    }
}

fn add_class(w: mut ref W, c: own Cls) -> i64 {
    let name = c.name.clone();
    w.classes.push(c);
    let id = w.classes.len() - 1;
    w.by_name.insert(name, id);
    id
}

fn tid_of(w: ref W, o: i64) -> i64 {
    w.objs[o].tid
}

fn cls_name(w: ref W, o: i64) -> String {
    w.classes[w.objs[o].cls].name.clone()
}

fn obj_tags(w: ref W, o: i64) -> TagSet {
    w.objs[o].tags.clone()
}

fn utag(id: i64) -> Tag {
    mk_tag(0, 0, id)
}

fn builtin(w: mut ref W, name: Str, tid: i64, tags: own TagSet, sub: i64, named: i64, enc: Str, ctype: i64, size: i64) -> i64 {
    add_class(mut w, Cls { name: name.to_string(), tid: tid, tags: tags, sub: sub, named: named, enc: enc.to_string(), ctype: ctype, size: size })
}

// univ, char and useful, as pyasn1 defines them.
fn new_world() -> W {
    let mut w = W {
        objs: Vec.new(),
        cons: Vec.new(),
        nvs: Vec.new(),
        nts: Vec.new(),
        ots: Vec.new(),
        classes: Vec.new(),
        by_name: Map.new(),
        eoo: -1,
    };
    let empty = new_inter(mut w, Vec.new());
    let no_names = new_nv(mut w, Vec.new(), Vec.new());
    let s01 = new_con(mut w, C_SINGLE, vec![p_int(0), p_int(1)], Vec.new());
    let bool_sub = new_inter(mut w, vec![s01]);
    let bool_names = new_nv(mut w, vec!["False".to_string(), "True".to_string()], vec![0, 1]);
    let s_empty = new_con(mut w, C_SINGLE, vec![P.Bytes(Vec.new())], Vec.new());
    let null_sub = new_inter(mut w, vec![s_empty]);
    let one = new_con(mut w, C_SIZE, vec![p_int(1), p_int(1)], Vec.new());
    let choice_sub = new_inter(mut w, vec![one]);
    let no_fields = new_nts(mut w, Vec.new());
    let latin = "iso-8859-1";
    let ascii = "us-ascii";
    builtin(mut w, "Integer", T_INT, init_tagset(utag(2)), empty, no_names, "", -1, -1);
    builtin(mut w, "Boolean", T_BOOL, init_tagset(utag(1)), bool_sub, bool_names, "", -1, -1);
    builtin(mut w, "BitString", T_BITS, init_tagset(utag(3)), empty, no_names, "", -1, -1);
    builtin(mut w, "OctetString", T_OCTETS, init_tagset(utag(4)), empty, -1, latin, -1, -1);
    builtin(mut w, "Null", T_NULL, init_tagset(utag(5)), null_sub, -1, latin, -1, -1);
    builtin(mut w, "ObjectIdentifier", T_OID, init_tagset(utag(6)), empty, -1, "", -1, -1);
    builtin(mut w, "RelativeOID", T_RELOID, init_tagset(utag(13)), empty, -1, "", -1, -1);
    builtin(mut w, "Real", T_REAL, init_tagset(utag(9)), empty, -1, "", -1, -1);
    builtin(mut w, "Enumerated", T_ENUM, init_tagset(utag(10)), empty, no_names, "", -1, -1);
    builtin(mut w, "SequenceOf", T_SEQOF, init_tagset(mk_tag(0, 32, 16)), empty, -1, "", -1, empty);
    builtin(mut w, "SetOf", T_SETOF, init_tagset(mk_tag(0, 32, 17)), empty, -1, "", -1, empty);
    builtin(mut w, "Sequence", T_SEQ, init_tagset(mk_tag(0, 32, 16)), empty, -1, "", no_fields, empty);
    builtin(mut w, "Set", T_SET, init_tagset(mk_tag(0, 32, 17)), empty, -1, "", no_fields, empty);
    builtin(mut w, "Choice", T_CHOICE, untagged(), choice_sub, -1, "", no_fields, empty);
    builtin(mut w, "Any", T_ANY, untagged(), empty, -1, latin, -1, -1);
    let octets = init_tagset(utag(4));
    builtin(mut w, "UTF8String", T_UTF8, ts_implicit(octets, utag(12)), empty, -1, "utf-8", -1, -1);
    builtin(mut w, "NumericString", T_NUMERIC, ts_implicit(octets, utag(18)), empty, -1, ascii, -1, -1);
    builtin(mut w, "PrintableString", T_PRINTABLE, ts_implicit(octets, utag(19)), empty, -1, ascii, -1, -1);
    builtin(mut w, "TeletexString", T_TELETEX, ts_implicit(octets, utag(20)), empty, -1, latin, -1, -1);
    builtin(mut w, "T61String", T_T61, ts_implicit(octets, utag(20)), empty, -1, latin, -1, -1);
    builtin(mut w, "VideotexString", T_VIDEOTEX, ts_implicit(octets, utag(21)), empty, -1, latin, -1, -1);
    builtin(mut w, "IA5String", T_IA5, ts_implicit(octets, utag(22)), empty, -1, ascii, -1, -1);
    builtin(mut w, "GraphicString", T_GRAPHIC, ts_implicit(octets, utag(25)), empty, -1, latin, -1, -1);
    builtin(mut w, "VisibleString", T_VISIBLE, ts_implicit(octets, utag(26)), empty, -1, ascii, -1, -1);
    builtin(mut w, "ISO646String", T_ISO646, ts_implicit(octets, utag(26)), empty, -1, ascii, -1, -1);
    builtin(mut w, "GeneralString", T_GENERAL, ts_implicit(octets, utag(27)), empty, -1, latin, -1, -1);
    builtin(mut w, "UniversalString", T_UNIVERSAL, ts_implicit(octets, utag(28)), empty, -1, "utf-32-be", -1, -1);
    builtin(mut w, "BMPString", T_BMP, ts_implicit(octets, utag(30)), empty, -1, "utf-16-be", -1, -1);
    builtin(mut w, "ObjectDescriptor", T_OBJDESC, ts_implicit(octets, utag(7)), empty, -1, latin, -1, -1);
    builtin(mut w, "GeneralizedTime", T_GENTIME, ts_implicit(octets, utag(24)), empty, -1, ascii, -1, -1);
    builtin(mut w, "UTCTime", T_UTCTIME, ts_implicit(octets, utag(23)), empty, -1, ascii, -1, -1);
    let eoo_cls = builtin(mut w, "EndOfOctets", T_EOO, init_tagset(utag(0)), empty, -1, "", -1, -1);
    w.objs.push(Obj {
        cls: eoo_cls,
        tid: T_EOO,
        tags: init_tagset(utag(0)),
        sub: empty,
        named: -1,
        enc: "".to_string(),
        ctype: -1,
        size: -1,
        val: Val.Int(big_zero()),
        has: false,
        comps: Vec.new(),
        cur: -1,
    });
    w.eoo = w.objs.len() - 1;
    w
}
// ------------------------------------------------- Python value helpers

fn items_repr(w: ref W, xs: ref Vec[P]) -> Vec[String] {
    let mut parts: Vec[String] = Vec.new();
    for x in xs.iter() {
        parts.push(p_repr(w, x));
    }
    parts
}

fn dict_repr(w: ref W, items: ref Vec[PItem]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for it in items.iter() {
        parts.push(f"{p_repr(w, it.key)}: {p_repr(w, it.val)}");
    }
    f"{{{join(parts, ", ")}}}"
}

fn p_repr(w: ref W, p: ref P) -> String {
    match p {
        P.None_ => "None".to_string(),
        P.Bool(b) => bool_str(*b),
        P.Int(b) => big_str(b),
        P.Float(x) => float_repr(*x),
        P.Str(s) => str_repr(s),
        P.Bytes(b) => bytes_repr(b),
        P.List(xs) => f"[{join(items_repr(w, xs), ", ")}]",
        P.Tuple(xs) => {
            if xs.len() == 1 {
                f"({p_repr(w, xs[0])},)"
            } else {
                f"({join(items_repr(w, xs), ", ")})"
            }
        }
        P.Dict(items) => dict_repr(w, items),
        P.ODict(items) => {
            if items.len() == 0 {
                "OrderedDict()".to_string()
            } else {
                f"OrderedDict({dict_repr(w, items)})"
            }
        }
        P.Obj(o) => obj_repr(w, *o),
        P.Bits(v, _) => big_str(v),
    }
}

// str(): what "%s" prints
fn p_str(w: ref W, p: ref P) -> String {
    match p {
        P.Str(s) => s.clone(),
        P.Obj(o) => obj_str(w, *o),
        _ => p_repr(w, p),
    }
}

fn p_is_num(p: ref P) -> bool {
    match p {
        P.Bool(_) => true,
        P.Int(_) => true,
        P.Float(_) => true,
        P.Bits(_, _) => true,
        _ => false,
    }
}

fn p_big(p: ref P) -> Big {
    match p {
        P.Bool(b) => big_i(if *b { 1 } else { 0 }),
        P.Int(b) => b.clone(),
        P.Bits(b, _) => b.clone(),
        _ => big_zero(),
    }
}

fn p_is_float(p: ref P) -> bool {
    match p {
        P.Float(_) => true,
        _ => false,
    }
}

fn p_float(p: ref P) -> f64 {
    match p {
        P.Float(x) => *x,
        _ => big_to_f64(p_big(p)).unwrap_or(1.0 / 0.0),
    }
}

// -1, 0 or 1 for two numbers
fn num_cmp(a: ref P, b: ref P) -> i64 {
    if p_is_float(a) or p_is_float(b) {
        let x = p_float(a);
        let y = p_float(b);
        return if x < y { -1 } else if x > y { 1 } else { 0 };
    }
    big_cmp(p_big(a), p_big(b))
}

fn p_eq(w: ref W, a: ref P, b: ref P) -> bool {
    if p_is_num(a) and p_is_num(b) {
        return num_cmp(a, b) == 0;
    }
    match (a, b) {
        (P.None_, P.None_) => true,
        (P.Str(x), P.Str(y)) => *x == *y,
        (P.Bytes(x), P.Bytes(y)) => *x == *y,
        (P.List(x), P.List(y)) => vec_eq(w, x, y),
        (P.Tuple(x), P.Tuple(y)) => vec_eq(w, x, y),
        (P.Obj(x), P.Obj(y)) => *x == *y,
        _ => false,
    }
}

fn vec_eq(w: ref W, x: ref Vec[P], y: ref Vec[P]) -> bool {
    if x.len() != y.len() {
        return false;
    }
    let mut i = 0;
    while i < x.len() {
        if not p_eq(w, x[i], y[i]) {
            return false;
        }
        i += 1;
    }
    true
}

fn p_truthy(p: ref P) -> bool {
    match p {
        P.None_ => false,
        P.Bool(b) => *b,
        P.Int(b) => not big_is_zero(b),
        P.Float(x) => *x != 0.0,
        P.Str(s) => s.len() > 0,
        P.Bytes(b) => b.len() > 0,
        P.List(xs) => xs.len() > 0,
        P.Tuple(xs) => xs.len() > 0,
        P.Dict(xs) => xs.len() > 0,
        P.ODict(xs) => xs.len() > 0,
        P.Obj(_) => true,
        P.Bits(b, _) => not big_is_zero(b),
    }
}

// len(), or None for a value without one
fn p_len(p: ref P) -> Option[i64] {
    match p {
        P.Str(s) => Some(char_len(s)),
        P.Bytes(b) => Some(b.len()),
        P.List(xs) => Some(xs.len()),
        P.Tuple(xs) => Some(xs.len()),
        P.Dict(xs) => Some(xs.len()),
        P.ODict(xs) => Some(xs.len()),
        P.Bits(_, n) => Some(*n),
        _ => None,
    }
}

fn p_type_name(p: ref P) -> String {
    match p {
        P.None_ => "NoneType".to_string(),
        P.Bool(_) => "bool".to_string(),
        P.Int(_) => "int".to_string(),
        P.Float(_) => "float".to_string(),
        P.Str(_) => "str".to_string(),
        P.Bytes(_) => "bytes".to_string(),
        P.List(_) => "list".to_string(),
        P.Tuple(_) => "tuple".to_string(),
        P.Dict(_) => "dict".to_string(),
        P.ODict(_) => "OrderedDict".to_string(),
        P.Obj(_) => "object".to_string(),
        P.Bits(_, _) => "int".to_string(),
    }
}

// --------------------------------------------------------- constraints

fn con_repr(w: ref W, c: i64) -> String {
    let k = w.cons[c].kind;
    let mut parts: Vec[String] = Vec.new();
    if con_is_set(k) {
        for s in w.cons[c].subs.iter() {
            parts.push(con_repr(w, *s));
        }
    } else {
        for v in w.cons[c].vals.iter() {
            parts.push(p_repr(w, v));
        }
    }
    if parts.len() == 0 {
        return f"<{con_name(k)} object>";
    }
    f"<{con_name(k)} object, consts {join(parts, ", ")}>"
}

fn con_truthy(w: ref W, c: i64) -> bool {
    if c < 0 {
        return false;
    }
    if con_is_set(w.cons[c].kind) {
        w.cons[c].subs.len() > 0
    } else {
        w.cons[c].vals.len() > 0
    }
}

fn con_count(w: ref W, c: i64) -> i64 {
    if con_is_set(w.cons[c].kind) { w.cons[c].subs.len() } else { w.cons[c].vals.len() }
}

// a + b for a constraint set: b becomes one more member
fn con_add(w: mut ref W, a: i64, b: i64) -> i64 {
    let k = w.cons[a].kind;
    let mut subs = w.cons[a].subs.clone();
    subs.push(b);
    new_con(mut w, k, Vec.new(), subs)
}

fn vce(msg: own String) -> Exc {
    exc("ValueConstraintError", msg)
}

// ValueConstraintError(value)
fn vce_value(w: ref W, v: ref P) -> Exc {
    Exc { kind: "ValueConstraintError".to_string(), msg: p_str(w, v), rep: p_repr(w, v) }
}

// constraint(value)
fn con_check(w: ref W, c: i64, v: ref P) -> Result[(), Exc] {
    if not con_truthy(w, c) {
        return Ok(());
    }
    match con_test(w, c, v) {
        Ok(_) => Ok(()),
        Err(e) => {
            if is_vce(e) {
                Err(vce(f"{con_repr(w, c)} failed at: {exc_repr(e)}"))
            } else {
                Err(e)
            }
        }
    }
}

fn con_test(w: ref W, c: i64, v: ref P) -> Result[(), Exc] {
    let k = w.cons[c].kind;
    if k == C_INTER {
        for s in w.cons[c].subs.iter() {
            con_check(w, *s, v)?;
        }
        return Ok(());
    }
    if k == C_UNION {
        for s in w.cons[c].subs.iter() {
            match con_check(w, *s, v) {
                Ok(_) => return Ok(()),
                Err(e) => {
                    if not is_vce(e) {
                        return Err(e);
                    }
                }
            }
        }
        let mut parts: Vec[String] = Vec.new();
        for s in w.cons[c].subs.iter() {
            parts.push(con_repr(w, *s));
        }
        let tuple = if parts.len() == 1 { f"({parts[0]},)" } else { f"({join(parts, ", ")})" };
        return Err(vce(f"all of {tuple} failed for \"{p_str(w, v)}\""));
    }
    if k == C_EXCL {
        for s in w.cons[c].subs.iter() {
            match con_check(w, *s, v) {
                Ok(_) => return Err(vce_value(w, v)),
                Err(e) => {
                    if not is_vce(e) {
                        return Err(e);
                    }
                }
            }
        }
        return Ok(());
    }
    let vals = w.cons[c].vals.clone();
    if k == C_SINGLE {
        for x in vals.iter() {
            if p_eq(w, x, v) {
                return Ok(());
            }
        }
        return Err(vce_value(w, v));
    }
    if k == C_RANGE {
        if not p_is_num(v) {
            return Err(exc("TypeError", f"'<' not supported between instances of '{p_type_name(v)}' and 'int'"));
        }
        if num_cmp(v, vals[0]) < 0 or num_cmp(v, vals[1]) > 0 {
            return Err(vce_value(w, v));
        }
        return Ok(());
    }
    if k == C_SIZE {
        let n = match p_len(v) {
            Some(n) => p_int(n),
            None => return Err(exc("TypeError", f"object of type '{p_type_name(v)}' has no len()")),
        };
        if num_cmp(n, vals[0]) < 0 or num_cmp(n, vals[1]) > 0 {
            return Err(vce_value(w, v));
        }
        return Ok(());
    }
    // the alphabet: every member of the value must be in the set
    let members: Vec[P] = match v {
        P.Str(s) => {
            let mut out: Vec[P] = Vec.new();
            for ch in s.chars() {
                out.push(P.Str(ch.to_string()));
            }
            out
        }
        P.Bytes(b) => {
            let mut out: Vec[P] = Vec.new();
            for x in b.iter() {
                out.push(p_int(*x as i64));
            }
            out
        }
        P.List(xs) => xs.clone(),
        P.Tuple(xs) => xs.clone(),
        _ => Vec.new(),
    };
    for m in members.iter() {
        let mut found = false;
        for x in vals.iter() {
            if p_eq(w, x, m) {
                found = true;
            }
        }
        if not found {
            return Err(vce_value(w, v));
        }
    }
    Ok(())
}

// a == b: the values compared, the classes not
fn con_eq(w: ref W, a: i64, b: i64) -> bool {
    if a == b {
        return true;
    }
    let ka = con_is_set(w.cons[a].kind);
    let kb = con_is_set(w.cons[b].kind);
    let na = con_count(w, a);
    let nb = con_count(w, b);
    if na != nb {
        return false;
    }
    if na == 0 {
        return true;
    }
    if ka != kb {
        return false;
    }
    let mut i = 0;
    while i < na {
        if ka {
            if not con_eq(w, w.cons[a].subs[i], w.cons[b].subs[i]) {
                return false;
            }
        } else if not p_eq(w, w.cons[a].vals[i], w.cons[b].vals[i]) {
            return false;
        }
        i += 1;
    }
    true
}

// the same constraint, class and all (what a hash lookup finds)
fn con_same(w: ref W, a: i64, b: i64) -> bool {
    if a == b {
        return true;
    }
    if w.cons[a].kind != w.cons[b].kind {
        return false;
    }
    let n = con_count(w, a);
    if n != con_count(w, b) {
        return false;
    }
    let set = con_is_set(w.cons[a].kind);
    let mut i = 0;
    while i < n {
        if set {
            if not con_same(w, w.cons[a].subs[i], w.cons[b].subs[i]) {
                return false;
            }
        } else if not p_eq(w, w.cons[a].vals[i], w.cons[b].vals[i]) {
            return false;
        }
        i += 1;
    }
    true
}

// getValueMap(): every truthy member of a constraint set, and theirs
fn con_value_map(w: ref W, c: i64, out: mut ref Vec[i64]) {
    if not con_is_set(w.cons[c].kind) {
        return;
    }
    for s in w.cons[c].subs.iter() {
        if con_truthy(w, *s) {
            out.push(*s);
            con_value_map(w, *s, mut out);
        }
    }
}

fn con_is_super(w: ref W, a: i64, b: i64) -> bool {
    if a == b or not con_truthy(w, a) or con_eq(w, a, b) {
        return true;
    }
    let mut vm: Vec[i64] = Vec.new();
    con_value_map(w, b, mut vm);
    for x in vm.iter() {
        if con_same(w, *x, a) {
            return true;
        }
    }
    false
}

// --------------------------------------------------------- named values

fn nv_repr(w: ref W, n: i64) -> String {
    let mut parts: Vec[String] = Vec.new();
    let mut i = 0;
    while i < w.nvs[n].names.len() {
        parts.push(f"{w.nvs[n].names[i]}={w.nvs[n].nums[i]}");
        i += 1;
    }
    let mut r = join(parts, ", ");
    let len = char_len(r);
    if len > 64 {
        r = f"{slice(r, 0, 32)}...{slice(r, len - 32, len)}";
    }
    f"<NamedValues object, enums {r}>"
}

fn nv_truthy(w: ref W, n: i64) -> bool {
    n >= 0 and w.nvs[n].names.len() > 0
}

fn nv_number(w: ref W, n: i64, name: ref String) -> Option[i64] {
    if n < 0 {
        return None;
    }
    let mut i = 0;
    while i < w.nvs[n].names.len() {
        if w.nvs[n].names[i] == *name {
            return Some(w.nvs[n].nums[i]);
        }
        i += 1;
    }
    None
}

fn nv_name(w: ref W, n: i64, num: ref Big) -> Option[String] {
    if n < 0 or not big_fits(num) {
        return None;
    }
    let v = big_small(num);
    let mut i = 0;
    while i < w.nvs[n].names.len() {
        if w.nvs[n].nums[i] == v {
            return Some(w.nvs[n].names[i].clone());
        }
        i += 1;
    }
    None
}

// NamedValues + NamedValues
fn nv_add(w: mut ref W, a: i64, b: i64) -> Result[i64, Exc] {
    let mut names = w.nvs[a].names.clone();
    let mut nums = w.nvs[a].nums.clone();
    let mut i = 0;
    while i < w.nvs[b].names.len() {
        let name = w.nvs[b].names[i].clone();
        let num = w.nvs[b].nums[i];
        for x in names.iter() {
            if *x == name {
                return Err(perr(f"Duplicate name {name}"));
            }
        }
        for x in nums.iter() {
            if *x == num {
                return Err(perr(f"Duplicate number  {name}={num}"));
            }
        }
        names.push(name);
        nums.push(num);
        i += 1;
    }
    Ok(new_nv(mut w, names, nums))
}

// -------------------------------------------------------------- values

fn num_p(n: ref Num) -> P {
    match n {
        Num.I(b) => P.Int(b.clone()),
        Num.F(x) => P.Float(*x),
    }
}

// The internal value as the Python object pyasn1 keeps.
fn val_p(v: ref Val) -> P {
    match v {
        Val.NoValue => P.None_,
        Val.Int(b) => P.Int(b.clone()),
        Val.Bits(b, n) => P.Bits(b.clone(), *n),
        Val.Octets(b) => P.Bytes(b.clone()),
        Val.Text(s) => P.Str(s.clone()),
        Val.Oid(arcs) => {
            let mut xs: Vec[P] = Vec.new();
            for a in arcs.iter() {
                xs.push(P.Int(a.clone()));
            }
            P.Tuple(xs)
        }
        Val.Inf(plus) => P.Float(if *plus { 1.0 / 0.0 } else { -1.0 / 0.0 }),
        Val.Real(m, b, e) => P.Tuple(vec![num_p(m), p_int(*b), p_int(*e)]),
    }
}

fn is_novalue(v: ref Val) -> bool {
    match v {
        Val.NoValue => true,
        _ => false,
    }
}

fn obj_is_value(w: ref W, o: i64) -> bool {
    let t = w.objs[o].tid;
    if not is_constructed(t) {
        return not is_novalue(w.objs[o].val);
    }
    if is_seqof(t) {
        if not w.objs[o].has {
            return false;
        }
        for c in w.objs[o].comps.iter() {
            if *c < 0 or not obj_is_value(w, *c) {
                return false;
            }
        }
        return true;
    }
    if t == T_CHOICE {
        let cur = w.objs[o].cur;
        if cur < 0 {
            return false;
        }
        let c = w.objs[o].comps[cur];
        return c >= 0 and obj_is_value(w, c);
    }
    if not w.objs[o].has {
        return false;
    }
    let nt = w.objs[o].ctype;
    let n = w.nts[nt].items.len();
    if n > 0 {
        let mut i = 0;
        while i < n {
            let item = w.nts[nt].items[i].clone();
            if not item.opt and not item.dflt {
                if w.objs[o].comps.len() == 0 {
                    return false;
                }
                let c = w.objs[o].comps[i];
                if c < 0 or not obj_is_value(w, c) {
                    return false;
                }
            }
            i += 1;
        }
        return true;
    }
    for c in w.objs[o].comps.iter() {
        if *c < 0 or not obj_is_value(w, *c) {
            return false;
        }
    }
    true
}

// ---------------------------------------------------------------- text

fn encode_text(s: ref String, enc: ref String) -> Result[Vec[u8], Exc] {
    let mut out: Vec[u8] = Vec.new();
    for c in s.chars() {
        let cp = c as i64;
        if *enc == "us-ascii" {
            if cp >= 128 {
                return Err(exc("PyAsn1UnicodeEncodeError", "".to_string()));
            }
            out.push(cp as u8);
        } else if *enc == "iso-8859-1" {
            if cp >= 256 {
                return Err(exc("PyAsn1UnicodeEncodeError", "".to_string()));
            }
            out.push(cp as u8);
        } else if *enc == "utf-8" {
            push_utf8(mut out, cp);
        } else if *enc == "utf-32-be" {
            out.push(((cp >> 24) & 255) as u8);
            out.push(((cp >> 16) & 255) as u8);
            out.push(((cp >> 8) & 255) as u8);
            out.push((cp & 255) as u8);
        } else {
            if cp >= 0x10000 {
                let v = cp - 0x10000;
                let hi = 0xD800 + (v >> 10);
                let lo = 0xDC00 + (v & 0x3FF);
                out.push((hi >> 8) as u8);
                out.push((hi & 255) as u8);
                out.push((lo >> 8) as u8);
                out.push((lo & 255) as u8);
            } else {
                out.push((cp >> 8) as u8);
                out.push((cp & 255) as u8);
            }
        }
    }
    Ok(out)
}

fn cps_text(cps: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for c in cps.iter() {
        push_utf8(mut out, *c);
    }
    String.from_utf8(out).unwrap()
}

fn decode_text(b: ref Vec[u8], enc: ref String) -> Result[String, Exc] {
    let bad = exc("PyAsn1UnicodeDecodeError", "".to_string());
    let mut cps: Vec[i64] = Vec.new();
    if *enc == "us-ascii" or *enc == "iso-8859-1" {
        for x in b.iter() {
            if *enc == "us-ascii" and *x >= 128 {
                return Err(bad);
            }
            cps.push(*x as i64);
        }
    } else if *enc == "utf-8" {
        cps = match utf8_decode(b) {
            Ok(c) => c,
            Err(_) => return Err(bad),
        };
        for c in cps.iter() {
            if is_surrogate(*c) {
                return Err(bad);
            }
        }
    } else if *enc == "utf-32-be" {
        if b.len() % 4 != 0 {
            return Err(bad);
        }
        let mut i = 0;
        while i < b.len() {
            let cp = ((b[i] as i64) << 24) | ((b[i + 1] as i64) << 16) | ((b[i + 2] as i64) << 8) | (b[i + 3] as i64);
            if cp > 0x10FFFF or is_surrogate(cp) {
                return Err(bad);
            }
            cps.push(cp);
            i += 4;
        }
    } else {
        if b.len() % 2 != 0 {
            return Err(bad);
        }
        let mut i = 0;
        while i < b.len() {
            let u = ((b[i] as i64) << 8) | (b[i + 1] as i64);
            i += 2;
            if u >= 0xD800 and u <= 0xDBFF {
                if i + 1 >= b.len() + 1 or i >= b.len() {
                    return Err(bad);
                }
                let l = ((b[i] as i64) << 8) | (b[i + 1] as i64);
                if l < 0xDC00 or l > 0xDFFF {
                    return Err(bad);
                }
                i += 2;
                cps.push(0x10000 + ((u - 0xD800) << 10) + (l - 0xDC00));
            } else if u >= 0xDC00 and u <= 0xDFFF {
                return Err(bad);
            } else {
                cps.push(u);
            }
        }
    }
    Ok(cps_text(cps))
}

// ------------------------------------------------------------- reals

// Python's float % for a positive divisor
fn fmod_py(x: f64, m: f64) -> f64 {
    let r = x - m * (x / m).floor();
    r
}

fn num_is_zero(n: ref Num) -> bool {
    match n {
        Num.I(b) => big_is_zero(b),
        Num.F(x) => *x == 0.0,
    }
}

// m / 10 while m % 10 == 0: the first division makes m a float
fn normalize10(m0: ref Num, b: i64, e0: i64) -> Val {
    let mut is_int = true;
    let mut mi = big_zero();
    let mut mf = 0.0;
    match m0 {
        Num.I(x) => mi = x.clone(),
        Num.F(x) => {
            is_int = false;
            mf = *x;
        }
    }
    let mut e = e0;
    loop {
        if is_int {
            if big_is_zero(mi) {
                break;
            }
            let (q, r) = big_divmod(mi, big_i(10));
            if not big_is_zero(r) {
                break;
            }
            mf = big_to_f64(q).unwrap_or(1.0 / 0.0);
            is_int = false;
        } else {
            if mf == 0.0 or fmod_py(mf, 10.0) != 0.0 {
                break;
            }
            mf = mf / 10.0;
        }
        e += 1;
    }
    let m = if is_int { Num.I(mi) } else { Num.F(mf) };
    Val.Real(m, b, e)
}

// float(self) of a Real; None is OverflowError
fn real_float(v: ref Val) -> Option[f64] {
    match v {
        Val.Inf(plus) => Some(if *plus { 1.0 / 0.0 } else { -1.0 / 0.0 }),
        Val.Real(m, b, e) => {
            if *e >= 0 {
                let p = big_pow_small(*b, *e);
                match m {
                    Num.I(x) => big_to_f64(big_mul(x, p)),
                    Num.F(x) => {
                        let f = big_to_f64(p)?;
                        Some(*x * f)
                    }
                }
            } else {
                let p = (*b as f64).pow(*e as f64);
                match m {
                    Num.I(x) => {
                        let f = big_to_f64(x)?;
                        Some(f * p)
                    }
                    Num.F(x) => Some(*x * p),
                }
            }
        }
        _ => Some(0.0),
    }
}
// ------------------------------------------------------------ objects

// What a constructor takes: the readOnly attributes of the new object.
#[derive(Clone)]
struct Init {
    tags: TagSet,
    sub: i64,
    named: i64,
    enc: String,
    ctype: i64,
    size: i64,
}

fn cls_init(w: ref W, c: i64) -> Init {
    let k = w.classes[c].clone();
    Init { tags: k.tags, sub: k.sub, named: k.named, enc: k.enc, ctype: k.ctype, size: k.size }
}

fn obj_init(w: ref W, o: i64) -> Init {
    Init {
        tags: w.objs[o].tags.clone(),
        sub: w.objs[o].sub,
        named: w.objs[o].named,
        enc: w.objs[o].enc.clone(),
        ctype: w.objs[o].ctype,
        size: w.objs[o].size,
    }
}

fn push_obj(w: mut ref W, cls: i64, init: ref Init, val: own Val, has: bool) -> i64 {
    let tid = w.classes[cls].tid;
    w.objs.push(Obj {
        cls: cls,
        tid: tid,
        tags: init.tags.clone(),
        sub: init.sub,
        named: init.named,
        enc: init.enc.clone(),
        ctype: init.ctype,
        size: init.size,
        val: val,
        has: has,
        comps: Vec.new(),
        cur: -1,
    });
    w.objs.len() - 1
}

fn is_simple(w: ref W, o: i64) -> bool {
    not is_constructed(w.objs[o].tid)
}

fn type_error(msg: own String) -> Exc {
    exc("TypeError", msg)
}

fn value_error(msg: own String) -> Exc {
    exc("ValueError", msg)
}

// ------------------------------------------------- Python conversions

// int(x)
fn py_int(w: ref W, v: ref P) -> Result[Big, Exc] {
    match v {
        P.Bool(b) => Ok(big_i(if *b { 1 } else { 0 })),
        P.Int(b) => Ok(b.clone()),
        P.Bits(b, _) => Ok(b.clone()),
        P.Float(x) => {
            if x.is_nan() {
                return Err(value_error("cannot convert float NaN to integer".to_string()));
            }
            if x.is_infinite() {
                return Err(exc("OverflowError", "cannot convert float infinity to integer".to_string()));
            }
            Ok(f64_to_big(*x))
        }
        P.Str(s) => match parse_int_text(s, 10) {
            Some(b) => Ok(b),
            None => Err(value_error(f"invalid literal for int() with base 10: {str_repr(s)}")),
        },
        P.Bytes(b) => match parse_int_text(ascii_text(b), 10) {
            Some(x) => Ok(x),
            None => Err(value_error(f"invalid literal for int() with base 10: {bytes_repr(b)}")),
        },
        P.Obj(o) => obj_int(w, *o),
        _ => Err(type_error(f"int() argument must be a string, a bytes-like object or a real number, not '{p_type_name(v)}'")),
    }
}

// int(obj)
fn obj_int(w: ref W, o: i64) -> Result[Big, Exc] {
    let t = w.objs[o].tid;
    let v = w.objs[o].val.clone();
    if is_novalue(v) {
        return Err(novalue_op("__int__"));
    }
    if is_intlike(t) or t == T_BITS or t == T_EOO {
        return Ok(p_big(val_p(v)));
    }
    if t == T_REAL {
        return match real_float(v) {
            Some(f) => py_int(w, P.Float(f)),
            None => Err(exc("OverflowError", "int too large to convert to float".to_string())),
        };
    }
    if is_octet_family(t) {
        return py_int(w, val_p(v));
    }
    Err(type_error(f"int() argument must be a string, a bytes-like object or a real number, not '{cls_name(w, o)}'"))
}

// bytes(x), as the OctetString initializers use it
fn py_bytes(w: ref W, v: ref P) -> Result[Vec[u8], Exc] {
    match v {
        P.Bytes(b) => Ok(b.clone()),
        P.Bool(b) => Ok(if *b { vec![0 as u8] } else { Vec.new() }),
        P.Int(n) => {
            if n.neg {
                return Err(value_error("negative count".to_string()));
            }
            Ok(Vec.filled(big_small(n), 0 as u8))
        }
        P.List(xs) => bytes_of_list(xs),
        P.Tuple(xs) => bytes_of_list(xs),
        _ => Err(type_error(f"cannot convert '{p_type_name(v)}' object to bytes")),
    }
}

fn bytes_of_list(xs: ref Vec[P]) -> Result[Vec[u8], Exc] {
    let mut out: Vec[u8] = Vec.new();
    for x in xs.iter() {
        let n = match x {
            P.Int(b) => b.clone(),
            P.Bool(b) => big_i(if *b { 1 } else { 0 }),
            _ => return Err(type_error(f"'{p_type_name(x)}' object cannot be interpreted as an integer")),
        };
        if n.neg or big_cmp(n, big_i(255)) > 0 {
            return Err(value_error("bytes must be in range(0, 256)".to_string()));
        }
        out.push(big_small(n) as u8);
    }
    Ok(out)
}

// asOctets()
fn obj_octets(w: ref W, o: i64) -> Result[Vec[u8], Exc] {
    let t = w.objs[o].tid;
    match w.objs[o].val {
        Val.NoValue => {
            if is_char(t) {
                Err(novalue_op("encode"))
            } else {
                Err(novalue_op("__index__"))
            }
        }
        Val.Octets(b) => Ok(b.clone()),
        Val.Text(s) => encode_text(s, w.objs[o].enc),
        Val.Bits(b, n) => {
            let bl = big_bit_length(b);
            let k = if *n > bl { *n } else { bl };
            Ok(big_to_bytes_n(b, (k + 7) / 8))
        }
        _ => Err(type_error("no octets".to_string())),
    }
}

// ------------------------------------------------------------ prettyIn

fn pretty_in(w: ref W, cls: i64, named: i64, enc: ref String, v: ref P) -> Result[Val, Exc] {
    let t = w.classes[cls].tid;
    let cname = w.classes[cls].name.clone();
    if is_intlike(t) {
        return match py_int(w, v) {
            Ok(b) => Ok(Val.Int(b)),
            Err(e) => {
                if e.kind != "ValueError" {
                    return Err(e);
                }
                if let P.Str(s) = v {
                    if let Some(n) = nv_number(w, named, s) {
                        return Ok(Val.Int(big_i(n)));
                    }
                }
                let r = p_repr(w, v);
                Err(perr(f"Can't coerce {r} into integer: {r}"))
            }
        };
    }
    if t == T_BITS {
        return bits_in(w, cname, named, v);
    }
    if t == T_OID or t == T_RELOID {
        return oid_in(w, cname, if t == T_OID { "Object ID" } else { "RELATIVE-OID" }, v);
    }
    if t == T_REAL {
        return real_in(w, v);
    }
    if is_char(t) {
        let text = match v {
            P.Str(s) => s.clone(),
            P.Bytes(b) => decode_text(b, enc)?,
            P.List(xs) => decode_text(bytes_of_list(xs)?, enc)?,
            P.Tuple(xs) => decode_text(bytes_of_list(xs)?, enc)?,
            P.Obj(o) => {
                if is_octet_family(w.objs[*o].tid) {
                    decode_text(obj_octets(w, *o)?, enc)?
                } else {
                    obj_str_r(w, *o)?
                }
            }
            _ => p_str(w, v),
        };
        return Ok(Val.Text(text));
    }
    if t == T_NULL {
        if p_truthy(v) {
            return Ok(Val.Octets(Vec.new()));
        }
        return Ok(Val.Octets(Vec.new()));
    }
    // OctetString and Any
    let b = match v {
        P.Bytes(b) => b.clone(),
        P.Str(s) => encode_text(s, enc)?,
        P.Obj(o) => {
            if is_octet_family(w.objs[*o].tid) {
                obj_octets(w, *o)?
            } else if is_constructed(w.objs[*o].tid) {
                return Err(type_error(f"cannot convert '{cls_name(w, *o)}' object to bytes"));
            } else {
                encode_text(obj_str_r(w, *o)?, enc)?
            }
        }
        _ => py_bytes(w, v)?,
    };
    Ok(Val.Octets(b))
}

fn bits_from_bin(cname: ref String, s: ref String) -> Result[Val, Exc] {
    let t = if s.len() == 0 { "0".to_string() } else { s.clone() };
    match parse_int_text(t, 2) {
        Some(b) => Ok(Val.Bits(b, char_len(s))),
        None => Err(perr(f"{cname}.fromBinaryString() error: invalid literal for int() with base 2: {str_repr(t)}")),
    }
}

fn bits_from_hex(cname: ref String, s: ref String) -> Result[Val, Exc] {
    match parse_int_text(s, 16) {
        Some(b) => Ok(Val.Bits(b, char_len(s) * 4)),
        None => Err(perr(f"{cname}.fromHexString() error: invalid literal for int() with base 16: {str_repr(s)}")),
    }
}

fn py_strip(s: ref String) -> String {
    let cs = chars(s);
    let mut a = 0;
    let mut b = cs.len();
    while a < b and is_py_space(cs[a]) {
        a += 1;
    }
    while b > a and is_py_space(cs[b - 1]) {
        b -= 1;
    }
    from_chars(cs, a, b)
}

fn all_digits(s: ref String) -> bool {
    if s.len() == 0 {
        return false;
    }
    for c in s.chars() {
        if not is_dig(c) {
            return false;
        }
    }
    true
}

fn bits_in(w: ref W, cname: ref String, named: i64, v: ref P) -> Result[Val, Exc] {
    match v {
        P.Bits(b, n) => Ok(Val.Bits(b.clone(), *n)),
        P.Str(s) => {
            if s.len() == 0 {
                return Ok(Val.Bits(big_zero(), 0));
            }
            let n = char_len(s);
            if s.starts_with("'") {
                if n >= 2 and s.ends_with("'B") {
                    return bits_from_bin(cname, slice(s, 1, n - 2));
                }
                if n >= 2 and s.ends_with("'H") {
                    return bits_from_hex(cname, slice(s, 1, n - 2));
                }
                return Err(perr(f"Bad BIT STRING value notation {s}"));
            }
            if nv_truthy(w, named) and not all_digits(s) {
                let mut names: Vec[String] = Vec.new();
                for part in s.split(",") {
                    names.push(py_strip(part.to_string()));
                }
                let mut positions: Vec[i64] = Vec.new();
                for name in names.iter() {
                    match nv_number(w, named, name) {
                        Some(p) => positions.push(p),
                        None => {
                            let mut reprs: Vec[String] = Vec.new();
                            for x in names.iter() {
                                reprs.push(str_repr(x));
                            }
                            return Err(perr(f"unknown bit name(s) in [{join(reprs, ", ")}]"));
                        }
                    }
                }
                let mut right = positions[0];
                for p in positions.iter() {
                    if *p > right {
                        right = *p;
                    }
                }
                let mut number = big_zero();
                for p in positions.iter() {
                    number = big_or(number, big_pow2(right - *p));
                }
                return Ok(Val.Bits(number, right + 1));
            }
            if s.starts_with("0x") {
                return bits_from_hex(cname, slice(s, 2, n));
            }
            if s.starts_with("0b") {
                return bits_from_bin(cname, slice(s, 2, n));
            }
            bits_from_bin(cname, s)
        }
        P.List(xs) => bits_from_bin(cname, truth_bits(xs)),
        P.Tuple(xs) => bits_from_bin(cname, truth_bits(xs)),
        P.Obj(o) => {
            if w.objs[*o].tid == T_BITS {
                match w.objs[*o].val {
                    Val.Bits(b, n) => Ok(Val.Bits(b.clone(), *n)),
                    _ => Err(novalue_op("__int__")),
                }
            } else {
                Err(perr(f"Bad BitString initializer type '{obj_str(w, *o)}'"))
            }
        }
        P.Int(b) => Ok(Val.Bits(b.clone(), big_bit_length(b))),
        P.Bool(b) => Ok(Val.Bits(big_i(if *b { 1 } else { 0 }), if *b { 1 } else { 0 })),
        _ => Err(perr(f"Bad BitString initializer type '{p_str(w, v)}'")),
    }
}

fn truth_bits(xs: ref Vec[P]) -> String {
    let mut s = String.new();
    for x in xs.iter() {
        s.push(if p_truthy(x) { '1' } else { '0' });
    }
    s
}

fn oid_in(w: ref W, cname: ref String, label: Str, v: ref P) -> Result[Val, Exc] {
    match v {
        P.Obj(o) => {
            if w.objs[*o].tid == T_OID or w.objs[*o].tid == T_RELOID {
                return match w.objs[*o].val {
                    Val.Oid(a) => Ok(Val.Oid(a.clone())),
                    _ => Err(novalue_op("__iter__")),
                };
            }
            Err(perr(f"Malformed {label} {obj_str(w, *o)} at {cname}: '{cls_name(w, *o)}' object is not iterable"))
        }
        P.Str(s) => {
            if s.contains("-") {
                return Err(perr(f"Malformed {label} {s} at {cname}: None"));
            }
            let mut arcs: Vec[Big] = Vec.new();
            for part in s.split(".") {
                if part.len() == 0 {
                    continue;
                }
                match parse_int_text(part.to_string(), 10) {
                    Some(b) => arcs.push(b),
                    None => return Err(perr(f"Malformed {label} {s} at {cname}: invalid literal for int() with base 10: {str_repr(part.to_string())}")),
                }
            }
            Ok(Val.Oid(arcs))
        }
        _ => {
            let items: Vec[P] = match v {
                P.List(xs) => xs.clone(),
                P.Tuple(xs) => xs.clone(),
                P.Bytes(b) => {
                    let mut out: Vec[P] = Vec.new();
                    for x in b.iter() {
                        out.push(p_int(*x as i64));
                    }
                    out
                }
                _ => return Err(perr(f"Malformed {label} {p_str(w, v)} at {cname}: '{p_type_name(v)}' object is not iterable")),
            };
            let mut arcs: Vec[Big] = Vec.new();
            for x in items.iter() {
                if not p_is_num(x) {
                    return Err(perr(f"Malformed {label} {p_str(w, v)} at {cname}: '>=' not supported between instances of '{p_type_name(x)}' and 'int'"));
                }
                if num_cmp(x, p_int(0)) >= 0 {
                    match py_int(w, x) {
                        Ok(b) => arcs.push(b),
                        Err(e) => return Err(perr(f"Malformed {label} {p_str(w, v)} at {cname}: {e.msg}")),
                    }
                }
            }
            if arcs.len() == items.len() {
                return Ok(Val.Oid(arcs));
            }
            Err(perr(f"Malformed {label} {p_str(w, v)} at {cname}"))
        }
    }
}

fn real_in(w: ref W, v: ref P) -> Result[Val, Exc] {
    match v {
        P.Tuple(xs) => {
            if xs.len() != 3 {
                return Err(perr(f"Bad real value syntax: {p_str(w, v)}"));
            }
            let mok = match xs[0] {
                P.Int(_) => true,
                P.Bool(_) => true,
                P.Float(_) => true,
                _ => false,
            };
            let bok = match xs[1] {
                P.Int(_) => true,
                P.Bool(_) => true,
                _ => false,
            };
            let eok = match xs[2] {
                P.Int(_) => true,
                P.Bool(_) => true,
                _ => false,
            };
            if not mok or not bok or not eok {
                return Err(perr(f"Lame Real value syntax: {p_str(w, v)}"));
            }
            if let P.Float(x) = xs[0] {
                if x.is_infinite() {
                    return Ok(Val.Inf(*x > 0.0));
                }
            }
            let b = p_big(xs[1]);
            if not big_eq(b, big_i(2)) and not big_eq(b, big_i(10)) {
                return Err(perr(f"Prohibited base for Real value: {p_str(w, xs[1])}"));
            }
            let m = match xs[0] {
                P.Float(x) => Num.F(*x),
                _ => Num.I(p_big(xs[0])),
            };
            let e = big_small(p_big(xs[2]));
            let base = big_small(b);
            if base == 10 {
                return Ok(normalize10(m, 10, e));
            }
            Ok(Val.Real(m, base, e))
        }
        P.Int(b) => Ok(normalize10(Num.I(b.clone()), 10, 0)),
        P.Bool(b) => Ok(normalize10(Num.I(big_i(if *b { 1 } else { 0 })), 10, 0)),
        P.Float(x) => float_real(*x),
        P.Str(s) => match py_float(s) {
            Some(x) => float_real(x),
            None => Err(perr(f"Bad real value syntax: {s}")),
        },
        P.Obj(o) => {
            if w.objs[*o].tid == T_REAL {
                return match w.objs[*o].val {
                    Val.Inf(_) => Err(perr("Invalid infinite value operation".to_string())),
                    Val.Real(m, b, e) => Ok(Val.Real(m.clone(), *b, *e)),
                    _ => Err(novalue_op("__getitem__")),
                };
            }
            Err(perr(f"Bad real value syntax: {obj_str(w, *o)}"))
        }
        _ => Err(perr(f"Bad real value syntax: {p_str(w, v)}")),
    }
}

fn float_real(x0: f64) -> Result[Val, Exc] {
    if x0.is_infinite() {
        return Ok(Val.Inf(x0 > 0.0));
    }
    if x0.is_nan() {
        return Err(value_error("cannot convert float NaN to integer".to_string()));
    }
    let mut x = x0;
    let mut e = 0;
    while x.trunc() != x {
        x = x * 10.0;
        e -= 1;
    }
    if x.is_infinite() {
        return Err(exc("OverflowError", "cannot convert float infinity to integer".to_string()));
    }
    Ok(normalize10(Num.I(exact_float_int(x)), 10, e))
}

// ------------------------------------------------------- construction

fn at_class(w: ref W, e: own Exc, cname: ref String) -> Exc {
    if is_pyasn1(e) {
        return exc(e.kind.as_str(), f"{e.msg} at {cname}");
    }
    e
}

// cls(value, **init) for a simple type; None is noValue
fn simple_new(w: mut ref W, cls: i64, init: ref Init, v: ref Option[P]) -> Result[i64, Exc] {
    let mut val = Val.NoValue;
    if let Some(p) = v {
        let cname = w.classes[cls].name.clone();
        if w.classes[cls].tid == T_NULL and p_truthy(p) {
            if let Err(e) = con_check(w, init.sub, p) {
                return Err(at_class(w, e, cname));
            }
        }
        val = pretty_in(w, cls, init.named, init.enc, p)?;
        if let Err(e) = con_check(w, init.sub, val_p(val)) {
            return Err(at_class(w, e, cname));
        }
    }
    Ok(push_obj(mut w, cls, init, val, false))
}

// clone(value): with no value the object itself
fn simple_clone(w: mut ref W, o: i64, v: ref Option[P]) -> Result[i64, Exc] {
    match v {
        None => Ok(o),
        Some(_) => {
            let init = obj_init(w, o);
            simple_new(mut w, w.objs[o].cls, init, v)
        }
    }
}

// clone(**kwargs): the value goes through prettyIn again
fn simple_clone_kw(w: mut ref W, o: i64, init: ref Init) -> Result[i64, Exc] {
    let v = if is_novalue(w.objs[o].val) { None } else { Some(val_p(w.objs[o].val)) };
    simple_new(mut w, w.objs[o].cls, init, v)
}

// a constructed object, sizeSpec moved into subtypeSpec as pyasn1 does
fn cons_new(w: mut ref W, cls: i64, tags: ref TagSet, sub: i64, ctype: i64, size_kw: i64) -> i64 {
    let mut s = sub;
    if con_truthy(w, size_kw) {
        if con_truthy(w, s) {
            s = size_kw;
        } else {
            s = con_add(mut w, s, size_kw);
        }
    }
    let tid = w.classes[cls].tid;
    let init = Init { tags: tags.clone(), sub: s, named: -1, enc: "".to_string(), ctype: ctype, size: w.classes[cls].size };
    let mut has = false;
    if is_record(tid) and ctype >= 0 and w.nts[ctype].items.len() > 0 {
        has = true;
    }
    push_obj(mut w, cls, init, Val.NoValue, has)
}

fn cls_new(w: mut ref W, cls: i64) -> Result[i64, Exc] {
    let init = cls_init(w, cls);
    if is_constructed(w.classes[cls].tid) {
        return Ok(cons_new(mut w, cls, init.tags, init.sub, init.ctype, init.size));
    }
    simple_new(mut w, cls, init, None)
}

// clone(cloneValueFlag=flag)
fn obj_clone(w: mut ref W, o: i64, flag: bool) -> Result[i64, Exc] {
    if is_simple(w, o) {
        return Ok(o);
    }
    let tags = w.objs[o].tags.clone();
    let n = cons_new(mut w, w.objs[o].cls, tags, w.objs[o].sub, w.objs[o].ctype, w.objs[o].size);
    if flag {
        clone_components(mut w, o, n)?;
    }
    Ok(n)
}

fn clone_components(w: mut ref W, o: i64, n: i64) -> Result[(), Exc] {
    let t = w.objs[o].tid;
    if not w.objs[o].has {
        return Ok(());
    }
    if t == T_CHOICE {
        let cur = w.objs[o].cur;
        if cur < 0 {
            return Ok(());
        }
        let c = w.objs[o].comps[cur];
        let cc = obj_clone(mut w, c, true)?;
        set_component(mut w, n, cur, Some(cc), false)?;
        return Ok(());
    }
    let comps = w.objs[o].comps.clone();
    let mut i = 0;
    while i < comps.len() {
        if comps[i] >= 0 {
            let cc = obj_clone(mut w, comps[i], true)?;
            set_component(mut w, n, i, Some(cc), true)?;
        }
        i += 1;
    }
    Ok(())
}

// ------------------------------------------------------- type checks

fn is_super_type(w: ref W, a: i64, b: i64) -> bool {
    ts_is_super_of(w.objs[a].tags, w.objs[b].tags) and con_is_super(w, w.objs[a].sub, w.objs[b].sub)
}

fn is_same_type(w: ref W, a: i64, b: i64) -> bool {
    a == b or (ts_eq(w.objs[a].tags, w.objs[b].tags) and con_eq(w, w.objs[a].sub, w.objs[b].sub))
}

// ------------------------------------------------------- components

fn n_fields(w: ref W, o: i64) -> i64 {
    let c = w.objs[o].ctype;
    if c < 0 { 0 } else { w.nts[c].items.len() }
}

fn comp_len(w: ref W, o: i64) -> i64 {
    if w.objs[o].tid == T_CHOICE {
        return if w.objs[o].cur >= 0 { 1 } else { 0 };
    }
    w.objs[o].comps.len()
}

// setComponentByPosition; None instantiates the component type
fn set_component(w: mut ref W, o: i64, idx: i64, value: Option[i64], checks: bool) -> Result[(), Exc] {
    let t = w.objs[o].tid;
    if is_seqof(t) {
        let ct = w.objs[o].ctype;
        let i = if idx < 0 { w.objs[o].comps.len() + idx } else { idx };
        if i < 0 {
            return Err(perr("SequenceOf/SetOf index is out of range".to_string()));
        }
        let v = match value {
            None => {
                if ct < 0 {
                    return Err(perr("Component type not defined".to_string()));
                }
                obj_clone(mut w, ct, false)?
            }
            Some(x) => {
                if checks and ct >= 0 and not is_super_type(w, ct, x) and w.objs[ct].tid != T_ANY {
                    return Err(perr(f"Component value is tag-incompatible: {obj_repr(w, x)} vs {obj_repr(w, ct)}"));
                }
                x
            }
        };
        if not w.objs[o].has {
            w.objs[o].comps = Vec.new();
            w.objs[o].has = true;
        }
        while w.objs[o].comps.len() <= i {
            w.objs[o].comps.push(-1);
        }
        w.objs[o].comps[i] = v;
        return Ok(());
    }
    let nt = w.objs[o].ctype;
    let n = n_fields(w, o);
    if not w.objs[o].has {
        w.objs[o].comps = Vec.new();
    }
    let mut current = -1;
    if idx < w.objs[o].comps.len() {
        current = w.objs[o].comps[idx];
    } else if n > 0 {
        if n < idx {
            return Err(perr("component index out of range".to_string()));
        }
        w.objs[o].comps = Vec.filled(n, -1);
    }
    let v = match value {
        None => {
            if n > 0 {
                let item = w.nts[nt].items[idx].clone();
                if is_constructed(w.objs[item.obj].tid) {
                    obj_clone(mut w, item.obj, item.dflt)?
                } else {
                    item.obj
                }
            } else if current < 0 {
                return Err(perr("Component type not defined".to_string()));
            } else {
                -1
            }
        }
        Some(x) => {
            if checks and n > 0 {
                let item = w.nts[nt].items[idx].clone();
                if not is_super_type(w, item.obj, x) and item.open < 0 {
                    return Err(perr(f"Component value is tag-incompatible: {obj_repr(w, x)} vs {nts_repr(w, nt)}"));
                }
            }
            x
        }
    };
    if n > 0 or idx < w.objs[o].comps.len() {
        w.objs[o].comps[idx] = v;
    } else if w.objs[o].comps.len() == idx {
        w.objs[o].comps.push(v);
    } else {
        return Err(perr("Component index out of range".to_string()));
    }
    w.objs[o].has = true;
    if t == T_CHOICE {
        let old = w.objs[o].cur;
        w.objs[o].cur = idx;
        if old >= 0 and old != idx {
            w.objs[o].comps[old] = -1;
        }
    }
    Ok(())
}

// getComponentByPosition: a missing component is instantiated
fn get_component(w: mut ref W, o: i64, idx: i64) -> Result[i64, Exc] {
    let t = w.objs[o].tid;
    if is_seqof(t) {
        let i = if idx < 0 { w.objs[o].comps.len() + idx } else { idx };
        if i < 0 {
            return Err(perr("SequenceOf/SetOf index is out of range".to_string()));
        }
        if w.objs[o].has and i < w.objs[o].comps.len() and w.objs[o].comps[i] >= 0 {
            return Ok(w.objs[o].comps[i]);
        }
        set_component(mut w, o, i, None, true)?;
        return Ok(w.objs[o].comps[i]);
    }
    if t == T_CHOICE and w.objs[o].cur >= 0 and w.objs[o].cur == idx {
        return Ok(w.objs[o].comps[idx]);
    }
    let mut c = -1;
    if w.objs[o].has and idx < w.objs[o].comps.len() {
        c = w.objs[o].comps[idx];
    }
    if c < 0 {
        set_component(mut w, o, idx, None, true)?;
    }
    Ok(w.objs[o].comps[idx])
}

// the component if it is there, else -1 (instantiate=False)
fn peek_component(w: ref W, o: i64, idx: i64) -> i64 {
    if w.objs[o].has and idx >= 0 and idx < w.objs[o].comps.len() {
        return w.objs[o].comps[idx];
    }
    -1
}

fn field_name(w: ref W, o: i64, idx: i64) -> String {
    let n = n_fields(w, o);
    if n > 0 {
        return w.nts[w.objs[o].ctype].items[idx].name.clone();
    }
    f"field-{idx}"
}

fn field_pos(w: ref W, o: i64, name: ref String) -> Result[i64, Exc] {
    let n = n_fields(w, o);
    if n > 0 {
        let nt = w.objs[o].ctype;
        let mut i = 0;
        while i < n {
            if w.nts[nt].items[i].name == *name {
                return Ok(i);
            }
            i += 1;
        }
        return Err(perr(f"Name {name} not found"));
    }
    let mut i = 0;
    while i < w.objs[o].comps.len() {
        if f"field-{i}" == *name {
            return Ok(i);
        }
        i += 1;
    }
    Err(perr(f"Name {name} not found"))
}

// value[name]
fn get_field(w: mut ref W, o: i64, name: Str) -> Result[i64, Exc] {
    let i = field_pos(w, o, name.to_string())?;
    get_component(mut w, o, i)
}

fn set_field(w: mut ref W, o: i64, name: Str, v: i64) -> Result[(), Exc] {
    let i = field_pos(w, o, name.to_string())?;
    set_component(mut w, o, i, Some(v), true)
}

fn append(w: mut ref W, o: i64, v: i64) -> Result[(), Exc] {
    let n = if w.objs[o].has { w.objs[o].comps.len() } else { 0 };
    set_component(mut w, o, n, Some(v), true)
}

// getComponent() of a Choice
fn chosen(w: ref W, o: i64) -> Result[i64, Exc] {
    let cur = w.objs[o].cur;
    if cur < 0 {
        return Err(perr("Component not chosen".to_string()));
    }
    Ok(w.objs[o].comps[cur])
}

fn chosen_name(w: ref W, o: i64) -> Result[String, Exc] {
    let cur = w.objs[o].cur;
    if cur < 0 {
        return Err(perr("Component not chosen".to_string()));
    }
    Ok(field_name(w, o, cur))
}

fn effective_tags(w: ref W, o: i64) -> Result[TagSet, Exc] {
    if w.objs[o].tid == T_CHOICE and w.objs[o].tags.tags.len() == 0 {
        let c = chosen(w, o)?;
        return effective_tags(w, c);
    }
    Ok(w.objs[o].tags.clone())
}

// ------------------------------------------------------------ tag maps

fn tm_find(xs: ref Vec[Tme], ts: ref TagSet) -> i64 {
    let mut i = 0;
    while i < xs.len() {
        if ts_eq(xs[i].ts, ts) {
            return i;
        }
        i += 1;
    }
    -1
}

fn tm_put(xs: mut ref Vec[Tme], ts: ref TagSet, o: i64) {
    let i = tm_find(xs, ts);
    if i >= 0 {
        xs[i].obj = o;
    } else {
        xs.push(Tme { ts: ts.clone(), obj: o });
    }
}

fn tm_err(msg: own String) -> Tm {
    Tm { present: Vec.new(), skip: Vec.new(), dflt: -1, err: msg }
}

fn obj_tagmap(w: ref W, o: i64) -> Tm {
    let t = w.objs[o].tid;
    let ts = w.objs[o].tags.clone();
    if t == T_ANY {
        return Tm {
            present: vec![Tme { ts: ts, obj: o }],
            skip: vec![Tme { ts: w.objs[w.eoo].tags.clone(), obj: w.eoo }],
            dflt: o,
            err: "".to_string(),
        };
    }
    if t == T_CHOICE and ts.tags.len() == 0 {
        let nt = w.objs[o].ctype;
        return nts_tagmap(w, nt, true, 0, w.nts[nt].items.len());
    }
    Tm { present: vec![Tme { ts: ts, obj: o }], skip: Vec.new(), dflt: -1, err: "".to_string() }
}

fn nts_tagmap(w: ref W, nt: i64, unique: bool, lo: i64, hi: i64) -> Tm {
    let mut present: Vec[Tme] = Vec.new();
    let mut skip: Vec[Tme] = Vec.new();
    let mut dflt = -1;
    let mut i = lo;
    while i < hi {
        let item = w.nts[nt].items[i].clone();
        let tm = obj_tagmap(w, item.obj);
        if tm.err.len() > 0 {
            return tm;
        }
        for e in tm.present.iter() {
            if unique and tm_find(present, e.ts) >= 0 {
                return tm_err(f"Non-unique tagSet {ts_repr(e.ts)} of {nt_repr(w, item)} at {nts_repr(w, nt)}");
            }
            tm_put(mut present, e.ts, item.obj);
        }
        for e in tm.skip.iter() {
            tm_put(mut skip, e.ts, e.obj);
        }
        if dflt < 0 {
            dflt = tm.dflt;
        } else if tm.dflt >= 0 {
            return tm_err(f"Duplicate default ASN.1 type at {nts_repr(w, nt)}");
        }
        i += 1;
    }
    Tm { present: present, skip: skip, dflt: dflt, err: "".to_string() }
}

// tagSet in tagMap
fn tm_contains(tm: ref Tm, ts: ref TagSet) -> bool {
    tm_find(tm.present, ts) >= 0 or (tm.dflt >= 0 and tm_find(tm.skip, ts) < 0)
}

// tagMap[tagSet]; Err(None) is the KeyError
fn tm_get(tm: ref Tm, ts: ref TagSet) -> Result[i64, Option[Exc]] {
    if tm.err.len() > 0 {
        return Err(Some(perr(tm.err.clone())));
    }
    let i = tm_find(tm.present, ts);
    if i >= 0 {
        return Ok(tm.present[i].obj);
    }
    if tm.dflt < 0 {
        return Err(None);
    }
    if tm_find(tm.skip, ts) >= 0 {
        return Err(Some(perr("Key in negative map".to_string())));
    }
    Ok(tm.dflt)
}

fn tm_repr(w: ref W, tm: ref Tm) -> String {
    let mut r = "TagMap object".to_string();
    if tm.present.len() > 0 {
        r = f"{r}, present {tme_repr(w, tm.present)}";
    }
    if tm.skip.len() > 0 {
        r = f"{r}, skip {tme_repr(w, tm.skip)}";
    }
    if tm.dflt >= 0 {
        r = f"{r}, default {obj_repr(w, tm.dflt)}";
    }
    f"<{r}>"
}

fn tme_repr(w: ref W, xs: ref Vec[Tme]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for e in xs.iter() {
        parts.push(f"{ts_repr(e.ts)}: {obj_repr(w, e.obj)}");
    }
    f"{{{join(parts, ", ")}}}"
}

// position of a tag among items lo..hi, relative to lo
fn nts_tag_to_pos(w: ref W, nt: i64, lo: i64, hi: i64, ts: ref TagSet) -> Result[i64, Exc] {
    let mut map: Vec[Tme] = Vec.new();
    let mut i = lo;
    while i < hi {
        let item = w.nts[nt].items[i].clone();
        let tm = obj_tagmap(w, item.obj);
        if tm.err.len() > 0 {
            return Err(perr(tm.err));
        }
        for e in tm.present.iter() {
            if tm_find(map, e.ts) >= 0 {
                return Err(perr(f"Duplicate component tag {ts_repr(e.ts)} at {nt_repr(w, item)}"));
            }
            map.push(Tme { ts: e.ts.clone(), obj: i - lo });
        }
        i += 1;
    }
    let k = tm_find(map, ts);
    if k < 0 {
        return Err(perr(f"Type {ts_repr(ts)} not found"));
    }
    Ok(map[k].obj)
}

// the end of the ambiguous run that starts at idx
fn amb_end(w: ref W, nt: i64, idx: i64) -> i64 {
    let n = w.nts[nt].items.len();
    let mut j = idx;
    while j < n {
        let it = w.nts[nt].items[j].clone();
        if not it.opt and not it.dflt {
            return j + 1;
        }
        j += 1;
    }
    n
}

fn tagmap_near(w: ref W, nt: i64, idx: i64) -> Result[Tm, Exc] {
    if idx >= w.nts[nt].items.len() {
        return Err(perr("Type position out of range".to_string()));
    }
    Ok(nts_tagmap(w, nt, false, idx, amb_end(w, nt, idx)))
}

fn pos_near(w: ref W, nt: i64, ts: ref TagSet, idx: i64) -> Result[i64, Exc] {
    if idx >= w.nts[nt].items.len() {
        return Err(perr("Type position out of range".to_string()));
    }
    let k = nts_tag_to_pos(w, nt, idx, amb_end(w, nt, idx), ts)?;
    Ok(idx + k)
}

fn nts_min_tagset(w: ref W, nt: i64) -> TagSet {
    let mut best: Option[TagSet] = None;
    for it in w.nts[nt].items.iter() {
        let ts = w.objs[it.obj].tags.clone();
        best = match best {
            None => Some(ts),
            Some(b) => if ts_cmp(ts, b) < 0 { Some(ts) } else { Some(b) },
        };
    }
    match best {
        Some(b) => b,
        None => untagged(),
    }
}

// setComponentByType of a Set or Choice
fn set_by_type(w: mut ref W, o: i64, ts: ref TagSet, v: i64) -> Result[(), Exc] {
    let nt = w.objs[o].ctype;
    let idx = nts_tag_to_pos(w, nt, 0, w.nts[nt].items.len(), ts)?;
    set_component(mut w, o, idx, Some(v), false)
}

// --------------------------------------------------------- consistency

fn is_inconsistent(w: ref W, o: i64) -> Result[bool, Exc] {
    let sub = w.objs[o].sub;
    if not con_truthy(w, sub) {
        return Ok(false);
    }
    if not w.objs[o].has {
        return Ok(true);
    }
    let t = w.objs[o].tid;
    let mut items: Vec[PItem] = Vec.new();
    let comps = w.objs[o].comps.clone();
    let mut i = 0;
    while i < comps.len() {
        if comps[i] >= 0 {
            let key = if is_seqof(t) { p_int(i) } else { P.Str(field_name(w, o, i)) };
            items.push(PItem { key: key, val: P.Obj(comps[i]) });
        }
        i += 1;
    }
    match con_check(w, sub, P.Dict(items)) {
        Ok(_) => Ok(false),
        Err(e) => if is_pyasn1(e) { Ok(true) } else { Err(e) },
    }
}

// ------------------------------------------------------------- repr

fn nt_repr(w: ref W, it: ref Nt) -> String {
    let kind = if it.opt { "OptionalNamedType" } else if it.dflt { "DefaultedNamedType" } else { "NamedType" };
    f"<{kind} object, type {it.name}={obj_repr(w, it.obj)}>"
}

fn nts_repr(w: ref W, nt: i64) -> String {
    let mut parts: Vec[String] = Vec.new();
    for it in w.nts[nt].items.iter() {
        parts.push(nt_repr(w, it));
    }
    f"<NamedTypes object, types {join(parts, ", ")}>"
}

fn obj_repr(w: ref W, o: i64) -> String {
    let t = w.objs[o].tid;
    let isv = obj_is_value(w, o);
    let mut r = f"{cls_name(w, o)} {if isv { "value" } else { "schema" }} object";
    if is_constructed(t) {
        r = f"{r}, tagSet={ts_repr(w.objs[o].tags)}, subtypeSpec={con_repr(w, w.objs[o].sub)}";
        let ct = w.objs[o].ctype;
        let cts = if is_seqof(t) {
            if ct < 0 { "None".to_string() } else { obj_repr(w, ct) }
        } else {
            nts_repr(w, ct)
        };
        r = f"{r}, componentType={cts}, sizeSpec={con_repr(w, w.objs[o].size)}";
        if isv and w.objs[o].comps.len() > 0 {
            let mut parts: Vec[String] = Vec.new();
            for c in w.objs[o].comps.iter() {
                parts.push(if *c < 0 { "<NoValue object>".to_string() } else { obj_repr(w, *c) });
            }
            r = f"{r}, payload [{join(parts, ", ")}]";
        }
        return f"<{r}>";
    }
    if w.objs[o].tags.tags.len() > 0 {
        r = f"{r}, tagSet {ts_repr(w.objs[o].tags)}";
    }
    if con_truthy(w, w.objs[o].sub) {
        r = f"{r}, subtypeSpec {con_repr(w, w.objs[o].sub)}";
    }
    if has_named_values(t) and nv_truthy(w, w.objs[o].named) {
        r = f"{r}, namedValues {nv_repr(w, w.objs[o].named)}";
    }
    if is_octet_family(t) {
        r = f"{r}, encoding {w.objs[o].enc}";
    }
    if isv {
        let v = match pretty_print(w, o, 0) {
            Ok(s) => s,
            Err(e) => failure(e),
        };
        let n = char_len(v);
        let shown = if n > 32 { f"{slice(v, 0, 16)}...{slice(v, n - 16, n)}" } else { v };
        r = f"{r}, payload [{shown}]";
    }
    f"<{r}>"
}

// ------------------------------------------------------ str and pretty

fn octets_pretty(b: ref Vec[u8], enc: ref String) -> Result[String, Exc] {
    for x in b.iter() {
        if *x < 32 or *x > 126 {
            return Ok(f"0x{hexs(b)}");
        }
    }
    decode_text(b, enc)
}

fn pretty_print(w: ref W, o: i64, scope0: i64) -> Result[String, Exc] {
    let t = w.objs[o].tid;
    if is_constructed(t) {
        return cons_pretty(w, o, scope0);
    }
    let v = w.objs[o].val.clone();
    if is_novalue(v) {
        let op = if is_intlike(t) {
            "__hash__"
        } else if t == T_BITS or is_char(t) {
            "__str__"
        } else if t == T_REAL {
            "__eq__"
        } else {
            "__iter__"
        };
        return Err(novalue_op(op));
    }
    match v {
        Val.Int(b) => {
            if is_intlike(t) {
                if let Some(n) = nv_name(w, w.objs[o].named, b) {
                    return Ok(n);
                }
            }
            Ok(big_str(b))
        }
        Val.Bits(b, _) => Ok(big_str(b)),
        Val.Octets(b) => octets_pretty(b, w.objs[o].enc),
        Val.Text(s) => Ok(s),
        Val.Oid(arcs) => {
            let mut parts: Vec[String] = Vec.new();
            for a in arcs.iter() {
                parts.push(big_str(a));
            }
            Ok(join(parts, "."))
        }
        Val.Inf(plus) => Ok(if plus { "inf".to_string() } else { "-inf".to_string() }),
        Val.Real(_, _, _) => match real_float(w.objs[o].val) {
            Some(f) => Ok(float_repr(f)),
            None => Ok("<overflow>".to_string()),
        },
        Val.NoValue => Ok("".to_string()),
    }
}

fn pp(w: ref W, o: i64) -> String {
    match pretty_print(w, o, 0) {
        Ok(s) => s,
        Err(e) => failure(e),
    }
}

fn spaces(n: i64) -> String {
    let mut s = String.new();
    let mut i = 0;
    while i < n {
        s.push(' ');
        i += 1;
    }
    s
}

fn cons_pretty(w: ref W, o: i64, scope0: i64) -> Result[String, Exc] {
    let scope = scope0 + 1;
    let t = w.objs[o].tid;
    let mut r = f"{cls_name(w, o)}:\n";
    if is_seqof(t) {
        if not obj_is_value(w, o) {
            return Ok(r);
        }
        for c in w.objs[o].comps.iter() {
            r = f"{r}{spaces(scope)}{pretty_print(w, *c, scope)?}";
        }
        return Ok(r);
    }
    if not w.objs[o].has and n_fields(w, o) == 0 {
        return Err(novalue_op("__iter__"));
    }
    let mut i = 0;
    while i < w.objs[o].comps.len() {
        let c = w.objs[o].comps[i];
        if c >= 0 and obj_is_value(w, c) {
            r = f"{r}{spaces(scope)}{field_name(w, o, i)}={pretty_print(w, c, scope)?}\n";
        }
        i += 1;
    }
    Ok(r)
}

fn pretty_type(w: ref W, o: i64, scope0: i64) -> String {
    let t = w.objs[o].tid;
    if not is_constructed(t) {
        return f"{ts_repr(w.objs[o].tags)} -> {cls_name(w, o)}";
    }
    let scope = scope0 + 1;
    let mut r = f"{ts_repr(w.objs[o].tags)} -> {cls_name(w, o)} {{\n";
    if is_seqof(t) {
        let ct = w.objs[o].ctype;
        if ct >= 0 {
            r = f"{r}{spaces(scope)}{pretty_type(w, ct, scope)}";
        }
        return f"{r}\n{spaces(scope - 1)}}}";
    }
    let n = n_fields(w, o);
    if n > 0 {
        let nt = w.objs[o].ctype;
        let mut i = 0;
        while i < n {
            let it = w.nts[nt].items[i].clone();
            r = f"{r}{spaces(scope)}\"{it.name}\" = {pretty_type(w, it.obj, scope)}\n";
            i += 1;
        }
    } else {
        let mut i = 0;
        while i < w.objs[o].comps.len() {
            let c = w.objs[o].comps[i];
            if c >= 0 {
                r = f"{r}{spaces(scope)}\"field-{i}\" = {pretty_type(w, c, scope)}\n";
            }
            i += 1;
        }
    }
    f"{r}\n{spaces(scope - 1)}}}"
}

// asBinary()
fn as_binary(b: ref Big, n: i64) -> String {
    let s = bin_digits(b);
    let k = char_len(s);
    if n > k { f"{zeros(n - k)}{s}" } else { s }
}

fn zeros(n: i64) -> String {
    let mut s = String.new();
    let mut i = 0;
    while i < n {
        s.push('0');
        i += 1;
    }
    s
}

// str(obj)
fn obj_str_r(w: ref W, o: i64) -> Result[String, Exc] {
    let t = w.objs[o].tid;
    match w.objs[o].val {
        Val.Bits(b, n) => return Ok(as_binary(b, *n)),
        Val.Octets(b) => return decode_text(b, w.objs[o].enc),
        Val.Text(s) => return Ok(s.clone()),
        Val.NoValue => {
            if t == T_BITS {
                return Err(novalue_op("__index__"));
            }
            if is_char(t) {
                return Err(novalue_op("__str__"));
            }
            if is_octet_family(t) {
                return Err(novalue_op("decode"));
            }
        }
        _ => {}
    }
    pretty_print(w, o, 0)
}

fn obj_str(w: ref W, o: i64) -> String {
    match obj_str_r(w, o) {
        Ok(s) => s,
        Err(e) => failure(e),
    }
}
// ------------------------------------------- schemas.json and jobs.json

fn j_get(j: ref J, key: Str) -> Option[J] {
    if let J.Obj(ms) = j {
        for m in ms.iter() {
            if m.key == key {
                return Some(m.val.clone());
            }
        }
    }
    None
}

fn j_has(j: ref J, key: Str) -> bool {
    match j_get(j, key) {
        Some(_) => true,
        None => false,
    }
}

fn j_str(j: ref J) -> String {
    match j {
        J.Str(s) => s.clone(),
        _ => "".to_string(),
    }
}

fn j_arr(j: ref J) -> Vec[J] {
    match j {
        J.Arr(xs) => xs.clone(),
        _ => Vec.new(),
    }
}

fn j_big(s: ref String) -> Big {
    if s.starts_with("-") {
        return big_neg(big_from_digits(slice(s, 1, char_len(s))));
    }
    big_from_digits(s)
}

fn j_int(j: ref J) -> i64 {
    match j {
        J.Int(s) => big_small(j_big(s)),
        _ => 0,
    }
}

fn j_truthy(j: ref J) -> bool {
    match j {
        J.Null => false,
        J.Bool(b) => *b,
        J.Int(s) => not big_is_zero(j_big(s)),
        J.Float(x) => *x != 0.0,
        J.Str(s) => s.len() > 0,
        J.Arr(xs) => xs.len() > 0,
        J.Obj(ms) => ms.len() > 0,
    }
}

fn unhex_str(s: ref String) -> Vec[u8] {
    let d = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < d.len() {
        out.push((hex_val(d[i] as i64) * 16 + hex_val(d[i + 1] as i64)) as u8);
        i += 2;
    }
    out
}

fn pyval(j: ref J) -> P {
    match j {
        J.Null => P.None_,
        J.Bool(b) => P.Bool(*b),
        J.Int(s) => P.Int(j_big(s)),
        J.Float(x) => P.Float(*x),
        J.Str(s) => P.Str(s.clone()),
        J.Arr(xs) => {
            let mut out: Vec[P] = Vec.new();
            for x in xs.iter() {
                out.push(pyval(x));
            }
            P.List(out)
        }
        J.Obj(ms) => {
            if let Some(h) = j_get(j, "hex") {
                return P.Bytes(unhex_str(j_str(h)));
            }
            if let Some(t) = j_get(j, "tuple") {
                let mut out: Vec[P] = Vec.new();
                for x in j_arr(t).iter() {
                    out.push(pyval(x));
                }
                return P.Tuple(out);
            }
            if let Some(f) = j_get(j, "float") {
                return match f {
                    J.Str(s) => P.Float(py_float(s).unwrap_or(0.0)),
                    J.Int(s) => P.Float(big_to_f64(j_big(s)).unwrap_or(0.0)),
                    J.Float(x) => P.Float(x),
                    _ => P.Float(0.0),
                };
            }
            let mut items: Vec[PItem] = Vec.new();
            for m in ms.iter() {
                items.push(PItem { key: P.Str(m.key.clone()), val: pyval(m.val) });
            }
            P.Dict(items)
        }
    }
}

fn bound(j: ref J) -> P {
    match j {
        J.Str(s) => {
            if *s == "MAX" {
                P.Float(1.0 / 0.0)
            } else {
                P.Float(-1.0 / 0.0)
            }
        }
        _ => pyval(j),
    }
}

fn build_con(w: mut ref W, c: ref J) -> i64 {
    if let Some(r) = j_get(c, "range") {
        let xs = j_arr(r);
        return new_con(mut w, C_RANGE, vec![bound(xs[0]), bound(xs[1])], Vec.new());
    }
    if let Some(r) = j_get(c, "size") {
        let xs = j_arr(r);
        return new_con(mut w, C_SIZE, vec![bound(xs[0]), bound(xs[1])], Vec.new());
    }
    if let Some(r) = j_get(c, "single") {
        let mut vals: Vec[P] = Vec.new();
        for x in j_arr(r).iter() {
            vals.push(pyval(x));
        }
        return new_con(mut w, C_SINGLE, vals, Vec.new());
    }
    if let Some(r) = j_get(c, "alpha") {
        let mut vals: Vec[P] = Vec.new();
        if let J.Str(s) = r.clone() {
            for ch in s.chars() {
                vals.push(P.Str(ch.to_string()));
            }
        }
        for x in j_arr(r).iter() {
            vals.push(pyval(x));
        }
        return new_con(mut w, C_ALPHA, vals, Vec.new());
    }
    let kind = if j_has(c, "union") { C_UNION } else if j_has(c, "inter") { C_INTER } else { C_EXCL };
    let key = if kind == C_UNION { "union" } else if kind == C_INTER { "inter" } else { "excl" };
    let inner = j_get(c, key).unwrap();
    let mut subs: Vec[i64] = Vec.new();
    if kind == C_EXCL {
        subs.push(build_con(mut w, inner));
    } else {
        for x in j_arr(inner).iter() {
            subs.push(build_con(mut w, x));
        }
    }
    new_con(mut w, kind, Vec.new(), subs)
}

fn tag_class(s: ref String) -> i64 {
    if *s == "universal" {
        0
    } else if *s == "application" {
        64
    } else if *s == "context" {
        128
    } else {
        192
    }
}

fn mktag(t: ref J) -> Tag {
    let xs = j_arr(t);
    mk_tag(tag_class(j_str(xs[0])), 0, j_int(xs[1]))
}

fn build_nv(w: mut ref W, named: ref J) -> i64 {
    let mut names: Vec[String] = Vec.new();
    let mut nums: Vec[i64] = Vec.new();
    for x in j_arr(named).iter() {
        let pair = j_arr(x);
        names.push(j_str(pair[0]));
        nums.push(j_int(pair[1]));
    }
    new_nv(mut w, names, nums)
}

fn named_types(w: mut ref W, fields: ref J) -> Result[i64, Exc] {
    let mut items: Vec[Nt] = Vec.new();
    for f in j_arr(fields).iter() {
        let t = build(mut w, j_get(f, "t").unwrap())?;
        let mut open = -1;
        if let Some(o) = j_get(f, "open") {
            let parts = j_arr(o);
            let mut keys: Vec[i64] = Vec.new();
            let mut vals: Vec[i64] = Vec.new();
            for kv in j_arr(parts[1]).iter() {
                let pair = j_arr(kv);
                let key = match pair[0] {
                    J.Str(s) => simple_new(mut w, cls_id(w, "ObjectIdentifier"), cls_init(w, cls_id(w, "ObjectIdentifier")), Some(P.Str(s.clone())))?,
                    _ => simple_new(mut w, cls_id(w, "Integer"), cls_init(w, cls_id(w, "Integer")), Some(pyval(pair[0])))?,
                };
                keys.push(key);
                vals.push(build(mut w, pair[1])?);
            }
            w.ots.push(Ot { gov: j_str(parts[0]), keys: keys, vals: vals });
            open = w.ots.len() - 1;
        }
        let opt = match j_get(f, "opt") {
            Some(x) => j_truthy(x),
            None => false,
        };
        let dflt = match j_get(f, "default") {
            Some(x) => j_truthy(x),
            None => false,
        };
        items.push(Nt { name: j_str(j_get(f, "n").unwrap()), obj: t, opt: opt, dflt: not opt and dflt, open: open });
    }
    Ok(new_nts(mut w, items))
}

// subtype(**kwargs)
fn subtype(w: mut ref W, o: i64, impl_tag: Option[Tag], expl_tag: Option[Tag], sub: i64, size: i64, named: i64) -> Result[i64, Exc] {
    let mut init = obj_init(w, o);
    let base = w.objs[o].tags.clone();
    if let Some(t) = impl_tag {
        init.tags = ts_implicit(base, t);
    }
    if let Some(t) = expl_tag {
        init.tags = ts_explicit(base, t)?;
    }
    if sub >= 0 {
        init.sub = con_add(mut w, init.sub, sub);
    }
    if named >= 0 {
        init.named = nv_add(mut w, init.named, named)?;
    }
    if is_constructed(w.objs[o].tid) {
        let sz = if size >= 0 { con_add(mut w, w.objs[o].size, size) } else { w.objs[o].size };
        return Ok(cons_new(mut w, w.objs[o].cls, init.tags, init.sub, init.ctype, sz));
    }
    simple_clone_kw(mut w, o, init)
}

fn build(w: mut ref W, t: ref J) -> Result[i64, Exc] {
    if let J.Str(name) = t {
        return cls_new(mut w, cls_id(w, name.as_str()));
    }
    let cls = cls_id(w, j_str(j_get(t, "t").unwrap()).as_str());
    let mut obj = -1;
    if let Some(of) = j_get(t, "of") {
        let ct = build(mut w, of)?;
        let init = cls_init(w, cls);
        obj = cons_new(mut w, cls, init.tags, init.sub, ct, init.size);
    } else if let Some(fields) = j_get(t, "fields") {
        let nt = named_types(mut w, fields)?;
        let init = cls_init(w, cls);
        obj = cons_new(mut w, cls, init.tags, init.sub, nt, init.size);
    } else {
        obj = cls_new(mut w, cls)?;
    }
    let impl_tag = match j_get(t, "impl") {
        Some(x) => Some(mktag(x)),
        None => None,
    };
    let expl_tag = match j_get(t, "expl") {
        Some(x) => Some(mktag(x)),
        None => None,
    };
    let mut sub = -1;
    if let Some(s) = j_get(t, "sub") {
        let mut subs: Vec[i64] = Vec.new();
        for x in j_arr(s).iter() {
            subs.push(build_con(mut w, x));
        }
        sub = new_inter(mut w, subs);
    }
    let mut size = -1;
    if let Some(s) = j_get(t, "size") {
        let mut subs: Vec[i64] = Vec.new();
        for x in j_arr(s).iter() {
            subs.push(build_con(mut w, x));
        }
        size = new_inter(mut w, subs);
    }
    let mut named = -1;
    if let Some(n) = j_get(t, "named") {
        named = build_nv(mut w, n);
    }
    let any_sub = impl_tag.is_some() or expl_tag.is_some() or sub >= 0 or size >= 0 or named >= 0;
    if any_sub {
        obj = subtype(mut w, obj, impl_tag, expl_tag, sub, size, named)?;
    }
    if let Some(v) = j_get(t, "value") {
        obj = simple_clone(mut w, obj, Some(pyval(v)))?;
    }
    Ok(obj)
}

fn define(w: mut ref W, d: ref J) -> Result[(), Exc] {
    let base = cls_id(w, j_str(j_get(d, "class").unwrap()).as_str());
    let mut c = w.classes[base].clone();
    c.name = j_str(j_get(d, "def").unwrap());
    if let Some(tg) = j_get(d, "tag") {
        if let Some(x) = j_get(tg, "impl") {
            c.tags = ts_implicit(c.tags, mktag(x));
        } else {
            c.tags = ts_explicit(c.tags, mktag(j_get(tg, "expl").unwrap()))?;
        }
    }
    if let Some(n) = j_get(d, "named") {
        c.named = build_nv(mut w, n);
    }
    if let Some(cs) = j_get(d, "cons") {
        let mut spec = c.sub;
        for x in j_arr(cs).iter() {
            let k = build_con(mut w, x);
            spec = con_add(mut w, spec, k);
        }
        c.sub = spec;
    }
    if let Some(of) = j_get(d, "of") {
        c.ctype = build(mut w, of)?;
    }
    if let Some(fields) = j_get(d, "fields") {
        c.ctype = named_types(mut w, fields)?;
    }
    if let Some(ss) = j_get(d, "sizeSpec") {
        for x in j_arr(ss).iter() {
            c.size = build_con(mut w, x);
        }
    }
    add_class(mut w, c);
    Ok(())
}

// ------------------------------------------------------ native decoder

fn nat_dec(w: mut ref W, p: ref P, spec: i64) -> Result[i64, Exc] {
    if spec < 0 {
        return Err(perr("asn1Spec is not valid (should be an instance of an ASN.1 Item, not NoneType)".to_string()));
    }
    let t = w.objs[spec].tid;
    if t == T_BITS {
        let text = match p {
            P.Str(s) => s.clone(),
            P.Bytes(b) => ascii_text(b),
            _ => {
                if not p_truthy(p) {
                    return Err(type_error(f"object of type '{p_type_name(p)}' has no len()"));
                }
                return Err(type_error("int() can't convert non-string with explicit base".to_string()));
            }
        };
        let v = bits_from_bin("BitString".to_string(), text)?;
        let pv = val_p(v);
        return simple_clone(mut w, spec, Some(pv));
    }
    if not is_constructed(t) {
        return simple_clone(mut w, spec, Some(p.clone()));
    }
    let v = obj_clone(mut w, spec, false)?;
    if is_seqof(t) {
        let items: Vec[P] = match p {
            P.List(xs) => xs.clone(),
            P.Tuple(xs) => xs.clone(),
            P.Dict(xs) => {
                let mut out: Vec[P] = Vec.new();
                for it in xs.iter() {
                    out.push(it.key.clone());
                }
                out
            }
            P.Str(s) => {
                let mut out: Vec[P] = Vec.new();
                for ch in s.chars() {
                    out.push(P.Str(ch.to_string()));
                }
                out
            }
            _ => return Err(type_error(f"'{p_type_name(p)}' object is not iterable")),
        };
        let ct = w.objs[spec].ctype;
        for x in items.iter() {
            let c = nat_dec(mut w, x, ct)?;
            if let Err(e) = append(mut w, v, c) {
                return Err(exc("IndexError", exc_repr(e)));
            }
        }
        return Ok(v);
    }
    let nt = w.objs[spec].ctype;
    let n = w.nts[nt].items.len();
    if t == T_CHOICE {
        let keys: Vec[P] = match p {
            P.Dict(xs) => {
                let mut out: Vec[P] = Vec.new();
                for it in xs.iter() {
                    out.push(it.key.clone());
                }
                out
            }
            P.List(xs) => xs.clone(),
            _ => return Err(type_error(f"'{p_type_name(p)}' object is not iterable")),
        };
        for k in keys.iter() {
            if let P.Str(name) = k {
                let mut i = 0;
                while i < n {
                    if w.nts[nt].items[i].name == *name {
                        let sub = w.nts[nt].items[i].obj;
                        let c = nat_dec(mut w, dict_get(p, name).unwrap(), sub)?;
                        if let Err(e) = set_component(mut w, v, i, Some(c), true) {
                            return Err(exc("KeyError", exc_repr(e)));
                        }
                        return Ok(v);
                    }
                    i += 1;
                }
            }
        }
        return Ok(v);
    }
    let mut i = 0;
    while i < n {
        let item = w.nts[nt].items[i].clone();
        match p {
            P.Dict(_) => {
                if let Some(x) = dict_get(p, item.name) {
                    let c = nat_dec(mut w, x, item.obj)?;
                    if let Err(e) = set_component(mut w, v, i, Some(c), true) {
                        return Err(exc("KeyError", exc_repr(e)));
                    }
                }
            }
            P.Str(s) => {
                if s.contains(item.name.as_str()) {
                    return Err(type_error("string indices must be integers, not 'str'".to_string()));
                }
            }
            P.List(xs) => {
                for x in xs.iter() {
                    if p_eq(w, x, P.Str(item.name.clone())) {
                        return Err(type_error("list indices must be integers or slices, not str".to_string()));
                    }
                }
            }
            _ => return Err(type_error(f"argument of type '{p_type_name(p)}' is not iterable")),
        }
        i += 1;
    }
    Ok(v)
}

fn dict_get(p: ref P, key: ref String) -> Option[P] {
    if let P.Dict(items) = p {
        for it in items.iter() {
            if let P.Str(k) = it.key {
                if *k == *key {
                    return Some(it.val.clone());
                }
            }
        }
    }
    None
}

// ------------------------------------------------------ native encoder

fn nat_enc(w: mut ref W, o: i64) -> Result[P, Exc] {
    let t = w.objs[o].tid;
    if t == T_BOOL {
        return match w.objs[o].val {
            Val.Int(b) => Ok(P.Bool(not big_is_zero(b))),
            _ => Err(novalue_op("__bool__")),
        };
    }
    if t == T_INT or t == T_ENUM {
        return Ok(P.Int(obj_int(w, o)?));
    }
    if t == T_BITS or t == T_OID or t == T_RELOID {
        if is_novalue(w.objs[o].val) {
            return Err(novalue_op(if t == T_BITS { "__index__" } else { "__iter__" }));
        }
        return Ok(P.Str(obj_str_r(w, o)?));
    }
    if t == T_NULL {
        return Ok(P.None_);
    }
    if t == T_REAL {
        return match w.objs[o].val {
            Val.NoValue => Err(novalue_op("__eq__")),
            _ => match real_float(w.objs[o].val) {
                Some(f) => Ok(P.Float(f)),
                None => Err(exc("OverflowError", "int too large to convert to float".to_string())),
            },
        };
    }
    if not is_constructed(t) {
        return Ok(P.Bytes(obj_octets(w, o)?));
    }
    if is_inconsistent(w, o)? {
        return Err(perr(f"ASN.1 object {cls_name(w, o)} is inconsistent"));
    }
    if is_seqof(t) {
        let mut out: Vec[P] = Vec.new();
        let n = if w.objs[o].has { w.objs[o].comps.len() } else { 0 };
        let mut i = 0;
        while i < n {
            let c = get_component(mut w, o, i)?;
            out.push(nat_enc(mut w, c)?);
            i += 1;
        }
        return Ok(P.List(out));
    }
    let mut items: Vec[PItem] = Vec.new();
    let nf = n_fields(w, o);
    let positions: Vec[i64] = if t == T_CHOICE {
        if w.objs[o].cur >= 0 { vec![w.objs[o].cur] } else { Vec.new() }
    } else {
        let count = if nf > 0 { nf } else { w.objs[o].comps.len() };
        let mut ps: Vec[i64] = Vec.new();
        let mut i = 0;
        while i < count {
            ps.push(i);
            i += 1;
        }
        ps
    };
    let mut k = 0;
    while k < positions.len() {
        let i = positions[k];
        let c = get_component(mut w, o, i)?;
        let key = field_name(w, o, i);
        let mut skip = false;
        if nf > 0 {
            let opt = w.nts[w.objs[o].ctype].items[k].opt;
            if opt {
                let again = get_component(mut w, o, k)?;
                if not obj_is_value(w, again) {
                    skip = true;
                }
            }
        }
        if not skip {
            let pv = nat_enc(mut w, c)?;
            items.push(PItem { key: P.Str(key), val: pv });
        }
        k += 1;
    }
    if t == T_SET {
        return Ok(P.Dict(items));
    }
    Ok(P.ODict(items))
}
// --------------------------------------------------------------- jobs

fn make(w: mut ref W, t: ref J, v: ref J) -> Result[i64, Exc] {
    let spec = build(mut w, t)?;
    if let Some(c) = j_get(v, "ctor") {
        return simple_clone(mut w, spec, Some(pyval(c)));
    }
    nat_dec(mut w, pyval(v), spec)
}

fn show(w: mut ref W, o: i64) {
    if is_simple(w, o) {
        println(f"repr: {obj_repr(w, o)}");
    }
    println(f"pretty: {pp(w, o)}");
    match nat_enc(mut w, o) {
        Ok(p) => println(f"native: {p_repr(w, p)}"),
        Err(e) => println(f"native: {failure(e)}"),
    }
}

fn job_make(w: mut ref W, j: ref J) {
    match make(mut w, j_get(j, "t").unwrap(), j_get(j, "v").unwrap()) {
        Ok(o) => show(mut w, o),
        Err(e) => println(failure(e)),
    }
}

fn job_repr(w: mut ref W, j: ref J) {
    let t = j_get(j, "t").unwrap();
    let r = match j_get(j, "v") {
        Some(v) => make(mut w, t, v),
        None => build(mut w, t),
    };
    match r {
        Ok(o) => println(obj_repr(w, o)),
        Err(e) => println(failure(e)),
    }
}

fn job_ptype(w: mut ref W, j: ref J) {
    match build(mut w, j_get(j, "t").unwrap()) {
        Ok(o) => println(pretty_type(w, o, 0)),
        Err(e) => println(failure(e)),
    }
}

fn bits_val(w: ref W, o: i64) -> (Big, i64) {
    match w.objs[o].val {
        Val.Bits(b, n) => (b.clone(), *n),
        _ => (big_zero(), 0),
    }
}

fn bits_clone(w: mut ref W, o: i64, b: own Big, n: i64) -> Result[i64, Exc] {
    simple_clone(mut w, o, Some(P.Bits(b, n)))
}

fn bit_at(b: ref Big, n: i64, i: i64) -> i64 {
    big_and_small(big_shr(b, n - 1 - i), 1)
}

// a BitString's prettyIn of a Python value
fn bits_of_p(w: ref W, o: i64, p: ref P) -> Result[(Big, i64), Exc] {
    let cname = cls_name(w, o);
    match bits_in(w, cname, w.objs[o].named, p)? {
        Val.Bits(b, n) => Ok((b, n)),
        _ => Ok((big_zero(), 0)),
    }
}

fn job_bits(w: mut ref W, j: ref J) {
    if let Err(e) = job_bits_r(mut w, j) {
        println(failure(e));
    }
}

fn job_bits_r(w: mut ref W, j: ref J) -> Result[(), Exc] {
    let t = match j_get(j, "t") {
        Some(t) => t,
        None => J.Str("BitString".to_string()),
    };
    let mut ctor: Vec[Member] = Vec.new();
    ctor.push(Member { key: "ctor".to_string(), val: j_get(j, "v").unwrap() });
    let o = make(mut w, t, J.Obj(ctor))?;
    let (b, n) = bits_val(w, o);
    let octets = obj_octets(w, o)?;
    let mut bits: Vec[String] = Vec.new();
    let mut i = 0;
    while i < n {
        bits.push(f"{bit_at(b, n, i)}");
        i += 1;
    }
    println(f"str={obj_str(w, o)} int={big_str(b)} octets={hexs(octets)} len={n} bits=[{join(bits, ", ")}]");
    if n > 2 {
        let mut part: Vec[P] = Vec.new();
        part.push(p_int(bit_at(b, n, 1)));
        part.push(p_int(bit_at(b, n, 2)));
        let s = simple_clone(mut w, o, Some(P.List(part)))?;
        println(f"b[0]={bit_at(b, n, 0)} b[-1]? {bit_at(b, n, n - 1)} b[1:3]={obj_str(w, s)}");
    }
    let l = bits_clone(mut w, o, big_shl(b, 2), n + 2)?;
    let r = bits_clone(mut w, o, big_shr(b, 1), if n - 1 < 0 { 0 } else { n - 1 })?;
    println(f"shifted: {obj_str(w, l)} {obj_str(w, r)}");
    let (pb, pn) = bits_of_p(w, o, P.Str("11".to_string()))?;
    let plus = bits_clone(mut w, o, big_or(big_shl(b, pn), pb), n + pn)?;
    println(f"plus: {obj_str(w, plus)}");
    let (eb, en) = bits_of_p(w, o, P.Str("1011001".to_string()))?;
    let eq = big_eq(b, eb) and n == en;
    let (lb, ln) = bits_of_p(w, o, P.Str("11".to_string()))?;
    let lt = n < ln or (n == ln and big_cmp(b, lb) < 0);
    println(f"cmp: {bool_str(eq)} {bool_str(lt)}");
    Ok(())
}

fn oid_arcs(w: ref W, o: i64) -> Vec[Big] {
    match w.objs[o].val {
        Val.Oid(a) => a.clone(),
        _ => Vec.new(),
    }
}

fn arcs_p(arcs: ref Vec[Big]) -> P {
    let mut xs: Vec[P] = Vec.new();
    for a in arcs.iter() {
        xs.push(P.Int(a.clone()));
    }
    P.Tuple(xs)
}

fn arcs_eq(a: ref Vec[Big], b: ref Vec[Big]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if not big_eq(a[i], b[i]) {
            return false;
        }
        i += 1;
    }
    true
}

fn vb_slice(v: ref Vec[Big], lo: i64, hi: i64) -> Vec[Big] {
    let mut out: Vec[Big] = Vec.new();
    let mut i = lo;
    while i < hi and i < v.len() {
        out.push(v[i].clone());
        i += 1;
    }
    out
}

fn new_oid(w: mut ref W, p: ref P) -> Result[i64, Exc] {
    let c = cls_id(w, "ObjectIdentifier");
    simple_new(mut w, c, cls_init(w, c), Some(p.clone()))
}

fn job_oid(w: mut ref W, j: ref J) -> Result[(), Exc] {
    let a = new_oid(mut w, pyval(j_get(j, "a").unwrap()))?;
    let b = new_oid(mut w, pyval(j_get(j, "b").unwrap()))?;
    let x = oid_arcs(w, a);
    let y = oid_arcs(w, b);
    let prefix = x.len() <= y.len() and arcs_eq(x, vb_slice(y, 0, x.len()));
    let mut sum = x.clone();
    for v in y.iter() {
        sum.push(v.clone());
    }
    let s = simple_clone(mut w, a, Some(arcs_p(sum)))?;
    let tail = simple_clone(mut w, a, Some(arcs_p(vb_slice(x, 1, x.len()))))?;
    println(f"a={obj_str(w, a)} b={obj_str(w, b)} len={x.len()} prefix={bool_str(prefix)} eq={bool_str(arcs_eq(x, y))} a+b={obj_str(w, s)} a[1:]={obj_str(w, tail)}");
    Ok(())
}

// --------------------------------------------------------- asDateTime

struct Dt {
    year: i64,
    month: i64,
    day: i64,
    hour: i64,
    minute: i64,
    second: i64,
    micro: i64,
    // None is a naive datetime
    tz: Option[i64],
}

// one strptime field: its alternatives, tried in order as the regex does
fn field_alts(f: char) -> Vec[String] {
    match f {
        'Y' => vec!["dddd".to_string()],
        'y' => vec!["dd".to_string()],
        'm' => vec!["1[0-2]".to_string(), "0[1-9]".to_string(), "[1-9]".to_string()],
        'd' => vec!["3[01]".to_string(), "[12]d".to_string(), "0[1-9]".to_string(), "[1-9]".to_string(), " [1-9]".to_string()],
        'H' => vec!["2[0-3]".to_string(), "[0-1]d".to_string(), "d".to_string()],
        'M' => vec!["[0-5]d".to_string(), "d".to_string()],
        _ => vec!["6[0-1]".to_string(), "[0-5]d".to_string(), "d".to_string()],
    }
}

// match one alternative at pos: its length, or -1
fn alt_match(alt: ref String, cs: ref Vec[char], pos: i64) -> i64 {
    let a = chars(alt);
    let mut i = 0;
    let mut k = pos;
    while i < a.len() {
        if k >= cs.len() {
            return -1;
        }
        let c = cs[k];
        if a[i] == 'd' {
            if not is_dig(c) {
                return -1;
            }
            i += 1;
        } else if a[i] == '[' {
            let lo = a[i + 1];
            let hi = a[i + 3];
            if a[i + 2] == '-' {
                if c < lo or c > hi {
                    return -1;
                }
                i += 5;
            } else {
                if c != lo and c != a[i + 2] {
                    return -1;
                }
                i += 4;
            }
        } else {
            if c != a[i] {
                return -1;
            }
            i += 1;
        }
        k += 1;
    }
    k - pos
}

fn strp_match(fields: ref Vec[char], fi: i64, cs: ref Vec[char], pos: i64, out: mut ref Vec[i64]) -> i64 {
    if fi == fields.len() {
        return pos;
    }
    for alt in field_alts(fields[fi]).iter() {
        let n = alt_match(alt, cs, pos);
        if n < 0 {
            continue;
        }
        let text = from_chars(cs, pos, pos + n);
        out.push(big_small(parse_int_text(py_strip(text), 10).unwrap_or(big_zero())));
        let end = strp_match(fields, fi + 1, cs, pos + n, mut out);
        if end >= 0 {
            return end;
        }
        out.pop();
    }
    -1
}

fn days_in(y: i64, m: i64) -> i64 {
    if m == 2 {
        let leap = (y % 4 == 0 and y % 100 != 0) or y % 400 == 0;
        return if leap { 29 } else { 28 };
    }
    if m == 4 or m == 6 or m == 9 or m == 11 { 30 } else { 31 }
}

fn strptime(text: ref String, four: bool) -> Option[Dt] {
    let fields: Vec[char] = if four { vec!['Y', 'm', 'd', 'H', 'M', 'S'] } else { vec!['y', 'm', 'd', 'H', 'M', 'S'] };
    let cs = chars(text);
    let mut vals: Vec[i64] = Vec.new();
    let end = strp_match(fields, 0, cs, 0, mut vals);
    if end != cs.len() {
        return None;
    }
    let mut year = vals[0];
    if not four {
        year = if year < 69 { 2000 + year } else { 1900 + year };
    }
    if vals[5] > 59 or vals[2] > days_in(year, vals[1]) {
        return None;
    }
    Some(Dt { year: year, month: vals[1], day: vals[2], hour: vals[3], minute: vals[4], second: vals[5], micro: 0, tz: None })
}

fn as_datetime(w: ref W, o: i64) -> Result[Dt, Exc] {
    let is_gen = w.objs[o].tid == T_GENTIME;
    let me = obj_str_r(w, o)?;
    let mut text = me.clone();
    let mut tz: Option[i64] = None;
    if text.ends_with("Z") {
        tz = Some(0);
        text = slice(text, 0, char_len(text) - 1);
    } else if text.contains("-") or text.contains("+") {
        let sep = if text.contains("+") { "+" } else { "-" };
        let at = text.find(sep).unwrap();
        let mut zone = slice(text, at + 1, char_len(text));
        text = slice(text, 0, at);
        if is_gen and char_len(zone) == 2 {
            zone = f"{zone}00";
        }
        if char_len(zone) != 4 {
            return Err(perr(f"malformed time zone offset {zone}"));
        }
        let h = parse_int_text(slice(zone, 0, 2), 10);
        let m = parse_int_text(slice(zone, 2, 4), 10);
        if h.is_none() or m.is_none() {
            return Err(perr(f"unknown time specification {me}"));
        }
        let mut minutes = big_small(h.unwrap()) * 60 + big_small(m.unwrap());
        if sep == "-" {
            minutes = -minutes;
        }
        tz = Some(minutes);
    }
    let mut micro = 0;
    if text.contains(".") or text.contains(",") {
        let sep = if text.contains(".") { "." } else { "," };
        let at = text.find(sep).unwrap();
        let ms = slice(text, at + 1, char_len(text));
        text = slice(text, 0, at);
        match parse_int_text(ms, 10) {
            Some(v) => micro = big_small(v) * 1000,
            None => return Err(perr(f"bad sub-second time specification {me}")),
        }
    }
    let years = if is_gen { 4 } else { 2 };
    if is_gen and char_len(text) - years == 6 {
        text = f"{text}0000";
    } else if char_len(text) - years == 8 {
        text = f"{text}00";
    }
    match strptime(text, is_gen) {
        Some(d) => {
            let mut dt = d;
            dt.micro = micro;
            dt.tz = tz;
            Ok(dt)
        }
        None => Err(perr(f"malformed datetime format {me}")),
    }
}

fn isoformat(d: ref Dt) -> String {
    let mut s = f"{d.year:04}-{d.month:02}-{d.day:02}T{d.hour:02}:{d.minute:02}:{d.second:02}";
    if d.micro != 0 {
        s = f"{s}.{d.micro:06}";
    }
    if let Some(m) = d.tz {
        let sign = if m < 0 { "-" } else { "+" };
        let a = if m < 0 { -m } else { m };
        s = f"{s}{sign}{a / 60:02}:{a % 60:02}";
    }
    s
}

fn job_time(w: mut ref W, j: ref J) {
    let c = cls_id(w, j_str(j_get(j, "t").unwrap()).as_str());
    let r = simple_new(mut w, c, cls_init(w, c), Some(pyval(j_get(j, "v").unwrap())));
    let out = match r {
        Ok(o) => match as_datetime(w, o) {
            Ok(d) => isoformat(d),
            Err(e) => failure(e),
        },
        Err(e) => failure(e),
    };
    println(out);
}

fn run_jobs(w: mut ref W) -> Result[(), Exc] {
    let text = fs.read_to_string("data/jobs.json".to_string()).unwrap();
    let jobs = loads_str(text)?;
    for j in j_arr(jobs).iter() {
        let op = j_str(j_get(j, "op").unwrap());
        println(f"== {op} {j_str(j_get(j, "id").unwrap())}");
        if op == "make" {
            job_make(mut w, j);
        } else if op == "repr" {
            job_repr(mut w, j);
        } else if op == "ptype" {
            job_ptype(mut w, j);
        } else if op == "bits" {
            job_bits(mut w, j);
        } else if op == "oid" {
            job_oid(mut w, j)?;
        } else if op == "time" {
            job_time(mut w, j);
        } else if op == "enc" {
            job_enc(mut w, j);
        } else if op == "dec" {
            job_dec(mut w, j);
        } else if op == "rt" {
            job_rt(mut w, j)?;
        }
    }
    Ok(())
}
// ------------------------------------------------------------ encoders

const BER: i64 = 0;
const CER: i64 = 1;
const DER: i64 = 2;

fn codec_of(s: ref String) -> i64 {
    if *s == "cer" {
        CER
    } else if *s == "der" {
        DER
    } else {
        BER
    }
}

// The encoder options that travel down with every call.
#[derive(Clone)]
struct Eo {
    def_mode: bool,
    chunk: i64,
    if_not_empty: bool,
    // omitEmptyOptionals: -1 when not given
    omit: i64,
}

fn new_eo() -> Eo {
    Eo { def_mode: true, chunk: 0, if_not_empty: false, omit: -1 }
}

fn push_all(out: mut ref Vec[u8], b: ref Vec[u8]) {
    for x in b.iter() {
        out.push(*x);
    }
}

fn reversed(b: ref Vec[u8]) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut i = b.len() - 1;
    while i >= 0 {
        out.push(b[i]);
        i -= 1;
    }
    out
}

fn enc_tag(t: ref Tag, cons: bool) -> Vec[u8] {
    let mut first = t.cls | t.fmt;
    if cons {
        first = first | 32;
    }
    if t.id < 31 {
        return vec![(first | t.id) as u8];
    }
    let mut id = t.id;
    let mut rev: Vec[u8] = vec![(id & 0x7f) as u8];
    id = id >> 7;
    while id > 0 {
        rev.push((0x80 | (id & 0x7f)) as u8);
        id = id >> 7;
    }
    rev.push((first | 0x1f) as u8);
    reversed(rev)
}

fn enc_len(n: i64, def_mode: bool, indef_ok: bool) -> Result[Vec[u8], Exc] {
    if not def_mode and indef_ok {
        return Ok(vec![0x80 as u8]);
    }
    if n < 0x80 {
        return Ok(vec![n as u8]);
    }
    let mut rev: Vec[u8] = Vec.new();
    let mut k = n;
    while k > 0 {
        rev.push((k & 0xff) as u8);
        k = k >> 8;
    }
    if rev.len() > 126 {
        return Err(perr(f"Length octets overflow ({rev.len()})"));
    }
    let mut out: Vec[u8] = vec![(0x80 | rev.len()) as u8];
    push_all(mut out, reversed(rev));
    Ok(out)
}

// compat.to_bytes(value, signed=True)
fn int_bytes(b: ref Big) -> Vec[u8] {
    let mut n = big_bit_length(b);
    if n % 8 == 0 {
        n += 1;
    }
    big_to_signed_bytes(b, (n + 7) / 8)
}

// base-128 arcs
fn arc_bytes(a: ref Big) -> Vec[u8] {
    let (q0, r0) = big_divmod(a, big_i(128));
    let mut rev: Vec[u8] = vec![big_small(r0) as u8];
    let mut q = q0;
    while not big_is_zero(q) {
        let (q2, r) = big_divmod(q, big_i(128));
        rev.push((0x80 | big_small(r)) as u8);
        q = q2;
    }
    reversed(rev)
}

// the indefinite-length capable encoders
fn indef_ok(tid: i64) -> bool {
    not (is_intlike(tid) or tid == T_NULL or tid == T_OID or tid == T_RELOID or tid == T_REAL)
}

// a value's == against another ASN.1 object, as the DEFAULT checks do
fn obj_eq(w: ref W, a: i64, b: i64) -> Result[bool, Exc] {
    if a == b {
        return Ok(true);
    }
    if not is_simple(w, a) {
        return Ok(false);
    }
    if is_novalue(w.objs[a].val) or is_novalue(w.objs[b].val) {
        return Err(novalue_op("__eq__"));
    }
    Ok(p_eq(w, val_p(w.objs[a].val), val_p(w.objs[b].val)))
}

// the encoder's entry point: SingleItemEncoder and AbstractItemEncoder.encode
fn enc_obj(w: mut ref W, c: i64, v: i64, spec: i64, o0: ref Eo) -> Result[Vec[u8], Exc] {
    let mut o = o0.clone();
    if c == CER {
        o.def_mode = false;
        o.chunk = 1000;
    } else if c == DER {
        o.def_mode = true;
        o.chunk = 0;
    }
    let tid = if spec >= 0 { w.objs[spec].tid } else { w.objs[v].tid };
    let ts = if spec >= 0 { w.objs[spec].tags.clone() } else { w.objs[v].tags.clone() };
    if ts.tags.len() == 0 {
        let (s, _) = enc_value(mut w, c, tid, v, spec, o)?;
        return Ok(s);
    }
    let ok = indef_ok(tid);
    let mut sub: Vec[u8] = Vec.new();
    let mut cons = false;
    let mut i = 0;
    while i < ts.tags.len() {
        let mut dm = o.def_mode;
        if i == 0 {
            match enc_value(mut w, c, tid, v, spec, o) {
                Ok((s, k)) => {
                    sub = s;
                    cons = k;
                }
                Err(e) => {
                    if is_pyasn1(e) {
                        return Err(perr(f"Error encoding {obj_repr(w, v)}: {e.msg}"));
                    }
                    return Err(e);
                }
            }
            if sub.len() == 0 and cons and o.if_not_empty {
                return Ok(sub);
            }
            if not cons {
                dm = true;
            }
        }
        let mut out = enc_tag(ts.tags[i], cons);
        push_all(mut out, enc_len(sub.len(), dm, ok)?);
        push_all(mut out, sub);
        if not dm {
            out.push(0);
            out.push(0);
        }
        sub = out;
        i += 1;
    }
    Ok(sub)
}

// encodeValue: (substrate, isConstructed)
fn enc_value(w: mut ref W, c: i64, tid: i64, v: i64, spec: i64, o: ref Eo) -> Result[(Vec[u8], bool), Exc] {
    if tid == T_EOO or tid == T_NULL {
        return Ok((Vec.new(), false));
    }
    if tid == T_BOOL {
        let b = match w.objs[v].val {
            Val.Int(x) => not big_is_zero(x),
            _ => return Err(novalue_op(if c == BER { "__bool__" } else { "__eq__" })),
        };
        let byte = if c == BER { if b { 1 } else { 0 } } else if b { 255 } else { 0 };
        return Ok((vec![byte as u8], false));
    }
    if is_intlike(tid) {
        return match w.objs[v].val {
            Val.Int(x) => {
                if big_is_zero(x) {
                    Ok((vec![0 as u8], false))
                } else {
                    Ok((int_bytes(x), false))
                }
            }
            _ => Err(novalue_op("__eq__")),
        };
    }
    if tid == T_BITS {
        return enc_bits(mut w, c, v, spec, o);
    }
    if tid == T_OID or tid == T_RELOID {
        return enc_oid(mut w, tid, v, spec);
    }
    if tid == T_REAL {
        return enc_real(mut w, v, spec);
    }
    if tid == T_ANY {
        let b = if spec < 0 {
            obj_octets(w, v)?
        } else {
            let x = simple_clone(mut w, spec, Some(P.Obj(v)))?;
            obj_octets(w, x)?
        };
        return Ok((b, not o.def_mode));
    }
    if is_time(tid) and c != BER {
        return enc_time(mut w, c, tid, v, spec, o);
    }
    if is_octet_family(tid) {
        return enc_octets(mut w, c, v, spec, o);
    }
    if tid == T_CHOICE {
        return enc_choice(mut w, c, v, spec, o);
    }
    if is_seqof(tid) {
        return enc_seqof(mut w, c, tid, v, spec, o);
    }
    if tid == T_SET and c != BER {
        return enc_cer_set(mut w, c, v, spec, o);
    }
    enc_seq(mut w, c, v, spec, o)
}

fn bits_len(w: ref W, o: i64) -> Result[i64, Exc] {
    match w.objs[o].val {
        Val.Bits(_, n) => Ok(*n),
        _ => Err(novalue_op("__len__")),
    }
}

fn enc_bits(w: mut ref W, c: i64, v0: i64, spec: i64, o: ref Eo) -> Result[(Vec[u8], bool), Exc] {
    let v = if spec >= 0 { simple_clone(mut w, spec, Some(P.Obj(v0)))? } else { v0 };
    let n = bits_len(w, v)?;
    let (b, _) = bits_val(w, v);
    let mut al = v;
    if n % 8 != 0 {
        let k = 8 - n % 8;
        al = bits_clone(mut w, v, big_shl(b, k), n + k)?;
    }
    let alen = bits_len(w, al)?;
    if o.chunk == 0 or alen <= o.chunk * 8 {
        let oct = obj_octets(w, al)?;
        let mut out: Vec[u8] = vec![(oct.len() * 8 - n) as u8];
        push_all(mut out, oct);
        return Ok((out, false));
    }
    let base = w.objs[v].tags.base.clone();
    let mut init = obj_init(w, al);
    init.tags = if base.len() > 0 { TagSet { base: base.clone(), tags: base } } else { untagged() };
    let al2 = simple_clone_kw(mut w, al, init)?;
    let (ab, _) = bits_val(w, al2);
    let mut out: Vec[u8] = Vec.new();
    let mut stop = 0;
    while stop < n {
        let start = stop;
        stop = if start + o.chunk * 8 < n { start + o.chunk * 8 } else { n };
        let (_, low) = big_divmod(big_shr(ab, alen - stop), big_pow2(stop - start));
        let piece = simple_clone(mut w, al2, Some(P.Bits(low, stop - start)))?;
        push_all(mut out, enc_obj(mut w, c, piece, spec, o)?);
    }
    Ok((out, true))
}

fn enc_octets(w: mut ref W, c: i64, v: i64, spec: i64, o: ref Eo) -> Result[(Vec[u8], bool), Exc] {
    let b = if spec < 0 {
        obj_octets(w, v)?
    } else {
        let x = simple_clone(mut w, spec, Some(P.Obj(v)))?;
        obj_octets(w, x)?
    };
    if o.chunk == 0 or b.len() <= o.chunk {
        return Ok((b, false));
    }
    let src = if spec < 0 { v } else { spec };
    let base = w.objs[src].tags.base.clone();
    let mut init = obj_init(w, src);
    init.tags = if base.len() > 0 { TagSet { base: base.clone(), tags: base } } else { untagged() };
    let cspec = simple_clone_kw(mut w, src, init)?;
    let mut out: Vec[u8] = Vec.new();
    let mut pos = 0;
    loop {
        let piece = match w.objs[v].val.clone() {
            Val.Text(s) => {
                let cs = chars(s);
                if pos >= cs.len() {
                    break;
                }
                let hi = if pos + o.chunk < cs.len() { pos + o.chunk } else { cs.len() };
                P.Str(from_chars(cs, pos, hi))
            }
            Val.Octets(bs) => {
                if pos >= bs.len() {
                    break;
                }
                P.Bytes(sub_bytes(bs, pos, pos + o.chunk))
            }
            _ => break,
        };
        let x = simple_clone(mut w, v, Some(piece))?;
        push_all(mut out, enc_obj(mut w, c, x, cspec, o)?);
        pos += o.chunk;
    }
    Ok((out, true))
}

// the CER and DER time encoders
fn enc_time(w: mut ref W, c: i64, tid: i64, v0: i64, spec: i64, o: ref Eo) -> Result[(Vec[u8], bool), Exc] {
    let mut v = if spec >= 0 { simple_clone(mut w, spec, Some(P.Obj(v0)))? } else { v0 };
    let mut nums = obj_octets(w, v)?;
    let plus = 43 as u8;
    let minus = 45 as u8;
    let z = 90 as u8;
    let comma = 44 as u8;
    let dot = 46 as u8;
    let zero = 48 as u8;
    if nums.contains(plus) or nums.contains(minus) {
        return Err(perr(f"Must be UTC time: {obj_repr(w, v)}"));
    }
    if nums.len() == 0 or nums[nums.len() - 1] != z {
        return Err(perr(f"Missing \"Z\" time zone specifier: {obj_repr(w, v)}"));
    }
    if nums.contains(comma) {
        return Err(perr(f"Comma in fractions disallowed: {obj_repr(w, v)}"));
    }
    if nums.contains(dot) {
        let mut modified = false;
        let mut di = 0;
        while nums[di] != dot {
            di += 1;
        }
        let mut si = if di + 4 < nums.len() - 1 { di + 4 } else { nums.len() - 1 };
        while nums[si] != dot {
            if nums[si] == zero {
                nums.remove(si);
                modified = true;
            }
            si -= 1;
        }
        si += 1;
        if si < nums.len() {
            if nums[si] == z {
                nums.remove(si - 1);
                modified = true;
            }
        }
        if modified {
            let mut xs: Vec[P] = Vec.new();
            for x in nums.iter() {
                xs.push(p_int(*x as i64));
            }
            v = simple_clone(mut w, v, Some(P.List(xs)))?;
        }
    }
    let (lo, hi) = if tid == T_GENTIME { (12, 20) } else { (10, 14) };
    if not (lo < nums.len() and nums.len() < hi) {
        return Err(perr(f"Length constraint violated: {obj_repr(w, v)}"));
    }
    let mut o2 = o.clone();
    o2.chunk = 1000;
    enc_octets(mut w, c, v, spec, o2)
}

fn enc_oid(w: mut ref W, tid: i64, v0: i64, spec: i64) -> Result[(Vec[u8], bool), Exc] {
    let v = if spec >= 0 { simple_clone(mut w, spec, Some(P.Obj(v0)))? } else { v0 };
    let arcs = match w.objs[v].val.clone() {
        Val.Oid(a) => a,
        _ => return Err(novalue_op("__getitem__")),
    };
    let mut todo: Vec[Big] = Vec.new();
    if tid == T_RELOID {
        todo = arcs;
    } else {
        if arcs.len() < 2 {
            return Err(perr(f"Short OID {obj_str(w, v)}"));
        }
        let first = arcs[0].clone();
        let second = arcs[1].clone();
        let small = not second.neg and big_cmp(second, big_i(39)) <= 0;
        let f = if big_fits(first) { big_small(first) } else { -1 };
        let lead = if small and f == 1 {
            big_add(second, big_i(40))
        } else if small and f == 0 and not first.neg and big_is_zero(first) {
            second.clone()
        } else if f == 2 {
            big_add(second, big_i(80))
        } else {
            return Err(perr(f"Impossible first/second arcs at {obj_str(w, v)}"));
        };
        todo.push(lead);
        let mut i = 2;
        while i < arcs.len() {
            todo.push(arcs[i].clone());
            i += 1;
        }
    }
    let mut out: Vec[u8] = Vec.new();
    for a in todo.iter() {
        if a.neg {
            let what = if tid == T_OID { "OID" } else { "RELATIVE-OID" };
            return Err(perr(f"Negative {what} arc {big_str(a)} at {obj_str(w, v)}"));
        }
        push_all(mut out, arc_bytes(a));
    }
    Ok((out, false))
}

// RealEncoder._dropFloatingPoint for base 2: (sign, mantissa, exponent)
fn drop_fp(m: ref Num, e0: i64) -> (i64, Big, i64) {
    let mut e = e0;
    match m {
        Num.I(b) => {
            let s = if b.neg { -1 } else { 1 };
            (s, big_abs(b), e)
        }
        Num.F(x) => {
            let s = if *x < 0.0 { -1 } else { 1 };
            let mut f = if *x < 0.0 { -*x } else { *x };
            while f.trunc() != f {
                f = f * 2.0;
                e -= 1;
            }
            (s, f64_to_big(f), e)
        }
    }
}

fn enc_real(w: mut ref W, v0: i64, spec: i64) -> Result[(Vec[u8], bool), Exc] {
    let v = if spec >= 0 { simple_clone(mut w, spec, Some(P.Obj(v0)))? } else { v0 };
    let (m, b, e0) = match w.objs[v].val.clone() {
        Val.Inf(plus) => return Ok((vec![if plus { 0x40 as u8 } else { 0x41 as u8 }], false)),
        Val.Real(m, b, e) => (m, b, e),
        _ => return Err(novalue_op("__eq__")),
    };
    if num_is_zero(m) {
        return Ok((Vec.new(), false));
    }
    if b == 10 {
        let mi = match m {
            Num.I(x) => x.clone(),
            Num.F(x) => f64_to_big(x),
        };
        let sign = if e0 == 0 { "+" } else { "" };
        let mut out: Vec[u8] = vec![3 as u8];
        push_all(mut out, bytes_of(f"{big_str(mi)}E{sign}{e0}"));
        return Ok((out, false));
    }
    if b != 2 {
        return Err(perr(f"Prohibited Real base {b}"));
    }
    let mut fo = 0x80;
    let (ms, m1, e1) = drop_fp(m, e0);
    let mut mm = m1;
    let mut e = e1;
    if ms < 0 {
        fo = fo | 0x40;
    }
    while big_and_small(mm, 1) == 0 {
        mm = big_shr(mm, 1);
        e += 1;
    }
    let mut eo: Vec[u8] = Vec.new();
    if e == 0 or e == -1 {
        eo.push((e & 0xff) as u8);
    } else {
        let mut rev: Vec[u8] = Vec.new();
        while e != 0 and e != -1 {
            rev.push((e & 0xff) as u8);
            e = e >> 8;
        }
        eo = reversed(rev);
        if e == 0 and eo.len() > 0 and (eo[0] & 0x80) != 0 {
            let mut x: Vec[u8] = vec![0 as u8];
            push_all(mut x, eo);
            eo = x;
        }
        if e == -1 and eo.len() > 0 and (eo[0] & 0x80) == 0 {
            let mut x: Vec[u8] = vec![0xff as u8];
            push_all(mut x, eo);
            eo = x;
        }
    }
    let n = eo.len();
    if n > 0xff {
        return Err(perr("Real exponent overflow".to_string()));
    }
    if n == 2 {
        fo = fo | 1;
    } else if n == 3 {
        fo = fo | 2;
    } else if n > 3 {
        fo = fo | 3;
        let mut x: Vec[u8] = vec![(n & 0xff) as u8];
        push_all(mut x, eo);
        eo = x;
    }
    let mut out: Vec[u8] = vec![fo as u8];
    push_all(mut out, eo);
    push_all(mut out, big_to_bytes(mm));
    Ok((out, false))
}

// name in value
fn obj_contains(w: ref W, o: i64, name: ref String) -> bool {
    if w.objs[o].tid == T_CHOICE {
        let cur = w.objs[o].cur;
        return cur >= 0 and field_name(w, o, cur) == *name;
    }
    match field_pos(w, o, name) {
        Ok(_) => true,
        Err(_) => false,
    }
}

// value[name] in the encoders, a KeyError turned PyAsn1Error
fn enc_field(w: mut ref W, v: i64, name: ref String) -> Result[i64, Exc] {
    match get_field(mut w, v, name.as_str()) {
        Ok(x) => Ok(x),
        Err(_) => Err(perr(f"Component name \"{name}\" not found in {obj_repr(w, v)}")),
    }
}

// values(): the component count values() walks
fn n_values(w: ref W, v: i64) -> i64 {
    let n = n_fields(w, v);
    if n > 0 {
        return n;
    }
    if w.objs[v].has { w.objs[v].comps.len() } else { 0 }
}

fn enc_seq(w: mut ref W, c: i64, v: i64, spec: i64, o0: ref Eo) -> Result[(Vec[u8], bool), Exc] {
    let mut o = o0.clone();
    let omit = if o.omit >= 0 { o.omit == 1 } else { c != BER };
    let mut out: Vec[u8] = Vec.new();
    if spec < 0 {
        if is_inconsistent(w, v)? {
            return Err(perr(f"ASN.1 object {cls_name(w, v)} is inconsistent"));
        }
        let n = n_fields(w, v);
        let nt = w.objs[v].ctype;
        let count = n_values(w, v);
        let mut idx = 0;
        while idx < count {
            let comp = get_component(mut w, v, idx)?;
            if n > 0 {
                let item = w.nts[nt].items[idx].clone();
                if item.opt and not obj_is_value(w, comp) {
                    idx += 1;
                    continue;
                }
                if item.dflt and obj_eq(w, comp, item.obj)? {
                    idx += 1;
                    continue;
                }
                if omit {
                    o.if_not_empty = item.opt;
                }
            }
            push_all(mut out, enc_obj(mut w, c, comp, -1, o)?);
            idx += 1;
        }
        return Ok((out, true));
    }
    let nt = w.objs[spec].ctype;
    let items = w.nts[nt].items.clone();
    for item in items.iter() {
        let comp = enc_field(mut w, v, item.name)?;
        if item.opt and not obj_contains(w, v, item.name) {
            continue;
        }
        if item.dflt and obj_eq(w, comp, item.obj)? {
            continue;
        }
        if omit {
            o.if_not_empty = item.opt;
        }
        push_all(mut out, enc_obj(mut w, c, comp, item.obj, o)?);
    }
    Ok((out, true))
}

#[derive(Clone)]
struct SetComp {
    comp: i64,
    ctype: i64,
    item: i64,
    key: TagSet,
}

fn enc_cer_set(w: mut ref W, c: i64, v: i64, spec: i64, o0: ref Eo) -> Result[(Vec[u8], bool), Exc] {
    let mut o = o0.clone();
    let mut comps: Vec[SetComp] = Vec.new();
    if spec < 0 {
        if is_inconsistent(w, v)? {
            return Err(perr(f"ASN.1 object {cls_name(w, v)} is inconsistent"));
        }
        let n = n_fields(w, v);
        let nt = w.objs[v].ctype;
        let count = n_values(w, v);
        let mut idx = 0;
        while idx < count {
            let comp = get_component(mut w, v, idx)?;
            let mut it = -1;
            if n > 0 {
                let item = w.nts[nt].items[idx].clone();
                if item.opt and not obj_is_value(w, comp) {
                    idx += 1;
                    continue;
                }
                if item.dflt and obj_eq(w, comp, item.obj)? {
                    idx += 1;
                    continue;
                }
                it = idx;
            }
            comps.push(SetComp { comp: comp, ctype: -1, item: it, key: untagged() });
            idx += 1;
        }
    } else {
        let nt = w.objs[spec].ctype;
        let items = w.nts[nt].items.clone();
        let mut idx = 0;
        while idx < items.len() {
            let item = items[idx].clone();
            let comp = enc_field(mut w, v, item.name)?;
            if item.opt and not obj_contains(w, v, item.name) {
                idx += 1;
                continue;
            }
            if item.dflt and obj_eq(w, comp, item.obj)? {
                idx += 1;
                continue;
            }
            let ct = get_component(mut w, spec, idx)?;
            comps.push(SetComp { comp: comp, ctype: ct, item: idx, key: untagged() });
            idx += 1;
        }
    }
    let mut k = 0;
    while k < comps.len() {
        let sc = comps[k].clone();
        comps[k].key = set_sort_key(mut w, c, sc.comp, sc.ctype)?;
        k += 1;
    }
    // a stable insertion sort, as sorted() is
    let mut i = 1;
    while i < comps.len() {
        let mut j = i;
        while j > 0 and ts_cmp(comps[j].key, comps[j - 1].key) < 0 {
            let t = comps[j].clone();
            comps[j] = comps[j - 1].clone();
            comps[j - 1] = t;
            j -= 1;
        }
        i += 1;
    }
    let ntv = if spec < 0 { w.objs[v].ctype } else { w.objs[spec].ctype };
    let mut out: Vec[u8] = Vec.new();
    for sc in comps.iter() {
        if sc.item >= 0 {
            o.if_not_empty = w.nts[ntv].items[sc.item].opt;
        }
        push_all(mut out, enc_obj(mut w, c, sc.comp, sc.ctype, o)?);
    }
    Ok((out, true))
}

fn set_sort_key(w: mut ref W, c: i64, comp: i64, ct: i64) -> Result[TagSet, Exc] {
    let st = if ct < 0 { comp } else { ct };
    if w.objs[st].tid != T_CHOICE or w.objs[st].tags.tags.len() > 0 {
        return Ok(w.objs[st].tags.clone());
    }
    if c == CER {
        return Ok(nts_min_tagset(w, w.objs[st].ctype));
    }
    if ct < 0 {
        let x = chosen(w, comp)?;
        return Ok(w.objs[x].tags.clone());
    }
    if w.objs[comp].tid != T_CHOICE or w.objs[comp].cur < 0 {
        return Err(perr(f"None components for Choice at {obj_repr(w, comp)}"));
    }
    let name = field_name(w, comp, w.objs[comp].cur);
    let x = get_field(mut w, ct, name.as_str())?;
    Ok(w.objs[x].tags.clone())
}

fn enc_seqof(w: mut ref W, c: i64, tid: i64, v: i64, spec: i64, o: ref Eo) -> Result[(Vec[u8], bool), Exc] {
    let count = if w.objs[v].has { w.objs[v].comps.len() } else { 0 };
    if c != BER and tid == T_SEQOF and o.if_not_empty and count == 0 {
        return Ok((Vec.new(), true));
    }
    if spec < 0 {
        if is_inconsistent(w, v)? {
            return Err(perr(f"ASN.1 object {cls_name(w, v)} is inconsistent"));
        }
    }
    let ct = if spec < 0 { -1 } else { w.objs[spec].ctype };
    let mut chunks: Vec[Vec[u8]] = Vec.new();
    let mut idx = 0;
    while idx < count {
        let comp = get_component(mut w, v, idx)?;
        chunks.push(enc_obj(mut w, c, comp, ct, o)?);
        idx += 1;
    }
    if c != BER and tid == T_SETOF and chunks.len() > 1 {
        let mut max = 0;
        for x in chunks.iter() {
            if x.len() > max {
                max = x.len();
            }
        }
        let mut padded: Vec[Vec[u8]] = Vec.new();
        for x in chunks.iter() {
            let mut p = x.clone();
            while p.len() < max {
                p.push(0);
            }
            padded.push(p);
        }
        let mut i = 1;
        while i < chunks.len() {
            let mut j = i;
            while j > 0 and bytes_lt(padded[j], padded[j - 1]) {
                let t = padded[j].clone();
                padded[j] = padded[j - 1].clone();
                padded[j - 1] = t;
                let u = chunks[j].clone();
                chunks[j] = chunks[j - 1].clone();
                chunks[j - 1] = u;
                j -= 1;
            }
            i += 1;
        }
    }
    let mut out: Vec[u8] = Vec.new();
    for x in chunks.iter() {
        push_all(mut out, x);
    }
    Ok((out, true))
}

fn bytes_lt(a: ref Vec[u8], b: ref Vec[u8]) -> bool {
    let mut i = 0;
    while i < a.len() and i < b.len() {
        if a[i] != b[i] {
            return a[i] < b[i];
        }
        i += 1;
    }
    a.len() < b.len()
}

fn enc_choice(w: mut ref W, c: i64, v: i64, spec: i64, o: ref Eo) -> Result[(Vec[u8], bool), Exc] {
    if spec < 0 {
        let comp = chosen(w, v)?;
        return Ok((enc_obj(mut w, c, comp, -1, o)?, true));
    }
    let nt = w.objs[spec].ctype;
    let mut names: Vec[String] = Vec.new();
    for it in w.nts[nt].items.iter() {
        if obj_contains(w, v, it.name) {
            names.push(it.name.clone());
        }
    }
    if names.len() != 1 {
        let what = if names.len() > 0 { "Multiple " } else { "None " };
        return Err(perr(f"{what}components for Choice at {obj_repr(w, v)}"));
    }
    let comp = enc_field(mut w, v, names[0])?;
    let cs = get_field(mut w, spec, names[0].as_str())?;
    Ok((enc_obj(mut w, c, comp, cs, o)?, true))
}

fn job_enc(w: mut ref W, j: ref J) {
    let t = j_get(j, "t").unwrap();
    let v = match make(mut w, t, j_get(j, "v").unwrap()) {
        Ok(v) => v,
        Err(e) => {
            println(f"make: {failure(e)}");
            return;
        }
    };
    let mut o = new_eo();
    if let Some(opts) = j_get(j, "opts") {
        if let Some(x) = j_get(opts, "defMode") {
            o.def_mode = j_truthy(x);
        }
        if let Some(x) = j_get(opts, "maxChunkSize") {
            o.chunk = j_int(x);
        }
        if let Some(x) = j_get(opts, "omitEmptyOptionals") {
            o.omit = if j_truthy(x) { 1 } else { 0 };
        }
    }
    let mut spec = -1;
    if let Some(s) = j_get(j, "spec") {
        if j_truthy(s) {
            spec = build(mut w, t).unwrap();
        }
    }
    let c = codec_of(j_str(j_get(j, "codec").unwrap()));
    match enc_obj(mut w, c, v, spec, o) {
        Ok(b) => println(hexs(b)),
        Err(e) => println(failure(e)),
    }
    println(f"after: {pp(w, v)}");
}
// ------------------------------------------------------------ decoders

// A seekable stream, with the position the last item call marked.
struct St {
    data: Vec[u8],
    pos: i64,
    mark: i64,
    codec: i64,
    open: bool,
}

// What asn1Spec can be: nothing, an ASN.1 object or a TagMap.
#[derive(Clone)]
enum Spec {
    Nil,
    O(i64),
    M(Tm),
}

// What a decoder call yields.
#[derive(Clone)]
enum Dv {
    Obj(i64),
    Raw(Vec[u8]),
    Eoo,
    Nothing,
}

fn underrun() -> Exc {
    exc("__underrun", "".to_string())
}

fn eos() -> Exc {
    exc("EndOfStreamError", "".to_string())
}

// readFromStream: an underrun is yielded (and ends the decode), an
// empty read raises EndOfStreamError
fn st_read(st: mut ref St, n: i64) -> Result[Vec[u8], Exc] {
    let avail = st.data.len() - st.pos;
    if n == 0 {
        return Ok(Vec.new());
    }
    if avail <= 0 {
        return Err(eos());
    }
    let k = if n < 0 { avail } else { n };
    if avail < k {
        return Err(underrun());
    }
    let out = sub_bytes(st.data, st.pos, st.pos + k);
    st.pos += k;
    Ok(out)
}

fn spec_repr(w: ref W, s: ref Spec) -> String {
    match s {
        Spec.Nil => "None".to_string(),
        Spec.O(o) => obj_repr(w, *o),
        Spec.M(tm) => tm_repr(w, tm),
    }
}

// the payload decoders
const K_INT: i64 = 1;
const K_BOOL: i64 = 2;
const K_BITS: i64 = 3;
const K_OCT: i64 = 4;
const K_NULL: i64 = 5;
const K_OID: i64 = 6;
const K_RELOID: i64 = 7;
const K_REAL: i64 = 8;
const K_CONS: i64 = 9;
const K_CHOICE: i64 = 10;
const K_ANY: i64 = 11;
const K_RAW: i64 = 12;

#[derive(Clone)]
struct Dk {
    kind: i64,
    // the protoComponent's class; for the guessing decoders the record one
    cls: i64,
    // the guessing decoders' SequenceOf/SetOf class, else -1
    of_cls: i64,
    cons_ok: bool,
    strict: bool,
}

fn dk(w: ref W, kind: i64, name: Str) -> Dk {
    Dk { kind: kind, cls: cls_id(w, name), of_cls: -1, cons_ok: true, strict: false }
}

// TAG_MAP, keyed by the first tag
fn by_tag(w: ref W, ts: ref TagSet, codec: i64) -> Option[Dk] {
    if ts.tags.len() == 0 {
        return None;
    }
    let t = ts.tags[0].clone();
    if t.cls != 0 {
        return None;
    }
    let d = match t.id {
        2 => dk(w, K_INT, "Integer"),
        10 => dk(w, K_INT, "Integer"),
        1 => {
            let mut d = dk(w, K_BOOL, "Boolean");
            d.strict = codec != BER;
            d
        }
        3 => {
            let mut d = dk(w, K_BITS, "BitString");
            d.cons_ok = codec != DER;
            d
        }
        4 => {
            let mut d = dk(w, K_OCT, "OctetString");
            d.cons_ok = codec != DER;
            d
        }
        5 => dk(w, K_NULL, "Null"),
        6 => dk(w, K_OID, "ObjectIdentifier"),
        13 => dk(w, K_RELOID, "RelativeOID"),
        9 => dk(w, K_REAL, "Real"),
        16 => {
            let mut d = dk(w, K_CONS, "Sequence");
            d.of_cls = cls_id(w, "SequenceOf");
            d
        }
        17 => {
            let mut d = dk(w, K_CONS, "Set");
            d.of_cls = cls_id(w, "SetOf");
            d
        }
        12 => dk(w, K_OCT, "UTF8String"),
        18 => dk(w, K_OCT, "NumericString"),
        19 => dk(w, K_OCT, "PrintableString"),
        20 => dk(w, K_OCT, "TeletexString"),
        21 => dk(w, K_OCT, "VideotexString"),
        22 => dk(w, K_OCT, "IA5String"),
        25 => dk(w, K_OCT, "GraphicString"),
        26 => dk(w, K_OCT, "VisibleString"),
        27 => dk(w, K_OCT, "GeneralString"),
        28 => dk(w, K_OCT, "UniversalString"),
        30 => dk(w, K_OCT, "BMPString"),
        7 => dk(w, K_OCT, "ObjectDescriptor"),
        24 => dk(w, K_OCT, "GeneralizedTime"),
        23 => dk(w, K_OCT, "UTCTime"),
        _ => return None,
    };
    Some(d)
}

// TYPE_MAP by typeId, else TAG_MAP by the base tag
fn by_type(w: ref W, o: i64, codec: i64) -> Option[Dk] {
    let t = w.objs[o].tid;
    let d = match t {
        13 => dk(w, K_CONS, "Set"),
        11 => dk(w, K_CONS, "SetOf"),
        12 => dk(w, K_CONS, "Sequence"),
        10 => dk(w, K_CONS, "SequenceOf"),
        14 => dk(w, K_CHOICE, "Choice"),
        15 => dk(w, K_ANY, "Any"),
        1 => dk(w, K_INT, "Integer"),
        2 => dk(w, K_BOOL, "Boolean"),
        3 => dk(w, K_BITS, "BitString"),
        4 => dk(w, K_OCT, "OctetString"),
        5 => dk(w, K_NULL, "Null"),
        6 => dk(w, K_OID, "ObjectIdentifier"),
        7 => dk(w, K_RELOID, "RelativeOID"),
        8 => dk(w, K_REAL, "Real"),
        16 => dk(w, K_OCT, "UTF8String"),
        17 => dk(w, K_OCT, "NumericString"),
        18 => dk(w, K_OCT, "PrintableString"),
        19 => dk(w, K_OCT, "TeletexString"),
        21 => dk(w, K_OCT, "VideotexString"),
        22 => dk(w, K_OCT, "IA5String"),
        23 => dk(w, K_OCT, "GraphicString"),
        24 => dk(w, K_OCT, "VisibleString"),
        26 => dk(w, K_OCT, "GeneralString"),
        27 => dk(w, K_OCT, "UniversalString"),
        28 => dk(w, K_OCT, "BMPString"),
        29 => dk(w, K_OCT, "ObjectDescriptor"),
        30 => dk(w, K_OCT, "GeneralizedTime"),
        31 => dk(w, K_OCT, "UTCTime"),
        _ => {
            let b = w.objs[o].tags.base.clone();
            return by_tag(w, TagSet { base: b.clone(), tags: b }, codec);
        }
    };
    Some(d)
}

// a decoder's protoComponent
fn proto(w: mut ref W, d: ref Dk) -> Result[i64, Exc] {
    let c = d.cls;
    let t = w.classes[c].tid;
    if is_constructed(t) {
        return cls_new(mut w, c);
    }
    let v = if t == T_BITS or t == T_OID or t == T_RELOID {
        Some(P.Tuple(Vec.new()))
    } else if t == T_INT or t == T_BOOL {
        Some(p_int(0))
    } else if t == T_OCTETS or t == T_NULL {
        Some(P.Str("".to_string()))
    } else {
        None
    };
    let init = cls_init(w, c);
    simple_new(mut w, c, init, v)
}

// _createComponent
fn create(w: mut ref W, d: ref Dk, spec: ref Spec, ts: ref TagSet, v: own P) -> Result[i64, Exc] {
    match spec {
        Spec.O(s) => simple_clone(mut w, *s, Some(v)),
        _ => {
            let mut init = cls_init(w, d.cls);
            init.tags = ts.clone();
            simple_new(mut w, d.cls, init, Some(v))
        }
    }
}

fn dv_bytes(w: ref W, v: ref Dv) -> Result[Vec[u8], Exc] {
    match v {
        Dv.Raw(b) => Ok(b.clone()),
        Dv.Obj(o) => obj_octets(w, *o),
        _ => Err(type_error("can't concat NoneType to bytes".to_string())),
    }
}

fn dv_obj(v: ref Dv) -> Result[i64, Exc] {
    match v {
        Dv.Obj(o) => Ok(*o),
        _ => Err(exc("AttributeError", "'NoneType' object has no attribute 'tagSet'".to_string())),
    }
}

// SingleItemDecoder.__call__
fn dec_item(w: mut ref W, st: mut ref St, spec: ref Spec, ts_in: ref Option[TagSet], len_in: i64, at_value: bool, sfun: bool, allow_eoo: bool) -> Result[Dv, Exc] {
    if allow_eoo and st.codec != DER {
        let b = st_read(mut st, 2)?;
        if b[0] == 0 and b[1] == 0 {
            return Ok(Dv.Eoo);
        }
        st.pos -= 2;
    }
    st.mark = st.pos;
    let mut ts = match ts_in {
        Some(t) => t.clone(),
        None => untagged(),
    };
    let mut len = len_in;
    if not at_value {
        let first = st_read(mut st, 1)?[0] as i64;
        let cls = first & 0xc0;
        let fmt = first & 0x20;
        let mut id = first & 0x1f;
        if id == 0x1f {
            id = 0;
            loop {
                let b = st_read(mut st, 1)?[0] as i64;
                id = (id << 7) | (b & 0x7f);
                if (b & 0x80) == 0 {
                    break;
                }
            }
        }
        let tag = mk_tag(cls, fmt, id);
        ts = match ts_in {
            Some(t) => ts_prepend(tag, t),
            None => TagSet { base: Vec.new(), tags: vec![tag] },
        };
        let f = st_read(mut st, 1)?[0] as i64;
        if f < 128 {
            len = f;
        } else if f > 128 {
            let size = f & 0x7f;
            let enc = st_read(mut st, size)?;
            len = 0;
            for x in enc.iter() {
                len = (len << 8) | (*x as i64);
            }
        } else {
            len = -1;
        }
        if len == -1 and st.codec == DER {
            return Err(perr("Indefinite length encoding not supported by this codec".to_string()));
        }
    }
    let mut chosen = Spec.Nil;
    let mut d: Option[Dk] = None;
    match spec {
        Spec.Nil => {
            d = by_tag(w, ts, st.codec);
        }
        Spec.O(s) => {
            let tm = obj_tagmap(w, *s);
            if tm.err.len() > 0 {
                return Err(perr(tm.err));
            }
            if ts_eq(ts, w.objs[*s].tags) or tm_contains(tm, ts) {
                d = by_type(w, *s, st.codec);
                chosen = Spec.O(*s);
            }
        }
        Spec.M(tm) => match tm_get(tm, ts) {
            Ok(o) => {
                d = by_type(w, o, st.codec);
                chosen = Spec.O(o);
            }
            Err(None) => {}
            Err(Some(e)) => return Err(e),
        },
    }
    let (dk, use_spec) = match d {
        Some(x) => (x, chosen),
        None => {
            if ts.tags.len() > 0 and ts.tags[0].fmt == 32 and ts.tags[0].cls != 0 {
                (Dk { kind: K_RAW, cls: cls_id(w, "Any"), of_cls: -1, cons_ok: true, strict: false }, spec.clone())
            } else {
                return Err(perr(f"{ts_repr(ts)} not in asn1Spec: {spec_repr(w, spec)}"));
            }
        }
    };
    let start = st.pos;
    if len == -1 {
        return dec_indef(mut w, mut st, dk, use_spec, ts, sfun);
    }
    let v = dec_value(mut w, mut st, dk, use_spec, ts, len, sfun)?;
    let got = st.pos - start;
    if not sfun and got != len {
        return Err(perr(f"Read {got} bytes instead of expected {len}."));
    }
    if sfun and got > len {
        return Err(perr(f"Read {got} bytes are more than expected {len}."));
    }
    Ok(v)
}

fn simple_fmt(ts: ref TagSet) -> Result[(), Exc] {
    if ts.tags[0].fmt != 0 {
        return Err(perr("Simple tag format expected".to_string()));
    }
    Ok(())
}

fn dec_value(w: mut ref W, st: mut ref St, d: ref Dk, spec: ref Spec, ts: ref TagSet, len: i64, sfun: bool) -> Result[Dv, Exc] {
    let k = d.kind;
    if k == K_INT or (k == K_BOOL and not d.strict) {
        simple_fmt(ts)?;
        let chunk = st_read(mut st, len)?;
        let v = big_from_signed_bytes(chunk);
        let p = if k == K_BOOL { p_int(if big_is_zero(v) { 0 } else { 1 }) } else { P.Int(v) };
        return Ok(Dv.Obj(create(mut w, d, spec, ts, p)?));
    }
    if k == K_BOOL {
        if len != 1 {
            return Err(perr("Not single-octet Boolean payload".to_string()));
        }
        let b = st_read(mut st, 1)?[0] as i64;
        let v = if b == 0xff {
            1
        } else if b == 0 {
            0
        } else {
            return Err(perr(f"Unexpected Boolean payload: {b}"));
        };
        return Ok(Dv.Obj(create(mut w, d, spec, ts, p_int(v))?));
    }
    if k == K_BITS {
        return dec_bits(mut w, mut st, d, spec, ts, len, sfun);
    }
    if k == K_OCT {
        return dec_octets(mut w, mut st, d, spec, ts, len, sfun);
    }
    if k == K_NULL {
        simple_fmt(ts)?;
        let chunk = st_read(mut st, len)?;
        let o = create(mut w, d, spec, ts, P.Str("".to_string()))?;
        if chunk.len() > 0 {
            return Err(perr(f"Unexpected {len}-octet substrate for Null"));
        }
        return Ok(Dv.Obj(o));
    }
    if k == K_OID or k == K_RELOID {
        simple_fmt(ts)?;
        let chunk = st_read(mut st, len)?;
        return Ok(Dv.Obj(dec_oid(mut w, d, spec, ts, chunk, k == K_OID)?));
    }
    if k == K_REAL {
        simple_fmt(ts)?;
        let chunk = st_read(mut st, len)?;
        let p = real_payload(chunk)?;
        return Ok(Dv.Obj(create(mut w, d, spec, ts, p)?));
    }
    if k == K_CONS {
        return dec_cons(mut w, mut st, d, spec, ts, len, sfun);
    }
    if k == K_CHOICE {
        return dec_choice(mut w, mut st, d, spec, ts, len, sfun);
    }
    if k == K_ANY {
        let untag = match spec {
            Spec.O(s) => not ts_eq(ts, w.objs[*s].tags),
            Spec.M(tm) => not tm_contains(tm, ts),
            Spec.Nil => true,
        };
        let mut n = len;
        if untag {
            let cur = st.pos;
            st.pos = st.mark;
            n += cur - st.mark;
        }
        let chunk = st_read(mut st, n)?;
        if sfun {
            return Ok(Dv.Raw(chunk));
        }
        return Ok(Dv.Obj(create(mut w, d, spec, ts, P.Bytes(chunk))?));
    }
    // the raw decoder of an explicit tag
    if sfun {
        return Ok(Dv.Raw(st_read(mut st, len)?));
    }
    dec_item(mut w, mut st, spec, Some(ts.clone()), len, false, false, false)
}

fn dec_indef(w: mut ref W, st: mut ref St, d: ref Dk, spec: ref Spec, ts: ref TagSet, sfun: bool) -> Result[Dv, Exc] {
    let k = d.kind;
    if k == K_BITS {
        if sfun {
            return Ok(Dv.Raw(st_read(mut st, -1)?));
        }
        let bp = proto(mut w, d)?;
        let mut acc = (big_zero(), 0);
        loop {
            let c = dec_item(mut w, mut st, Spec.O(bp), None, -2, false, true, true)?;
            if let Dv.Eoo = c {
                break;
            }
            let b = dv_bytes(w, c)?;
            acc = bits_append(acc, b)?;
        }
        let (v, n) = acc;
        return Ok(Dv.Obj(create(mut w, d, spec, ts, P.Bits(v, n))?));
    }
    if k == K_OCT {
        let op = proto(mut w, d)?;
        let mut header: Vec[u8] = Vec.new();
        loop {
            let c = dec_item(mut w, mut st, Spec.O(op), None, -2, false, true, true)?;
            if let Dv.Eoo = c {
                break;
            }
            push_all(mut header, dv_bytes(w, c)?);
        }
        return Ok(Dv.Obj(create(mut w, d, spec, ts, P.Bytes(header))?));
    }
    if k == K_CONS {
        return dec_cons_indef(mut w, mut st, d, spec, ts, sfun);
    }
    if k == K_CHOICE {
        return dec_choice_indef(mut w, mut st, d, spec, ts, sfun);
    }
    if k == K_ANY {
        let tagged = match spec {
            Spec.O(s) => ts_eq(ts, w.objs[*s].tags),
            Spec.M(tm) => tm_contains(tm, ts),
            Spec.Nil => false,
        };
        let mut chunk: Vec[u8] = Vec.new();
        if not tagged {
            let cur = st.pos;
            st.pos = st.mark;
            chunk = st_read(mut st, cur - st.mark)?;
        }
        let ad = dk(w, K_ANY, "Any");
        let ap = proto(mut w, ad)?;
        loop {
            let c = dec_item(mut w, mut st, Spec.O(ap), None, -2, false, true, true)?;
            if let Dv.Eoo = c {
                break;
            }
            push_all(mut chunk, dv_bytes(w, c)?);
        }
        // substrateFun is the collector by now, so the raw octets come back
        return Ok(Dv.Raw(chunk));
    }
    if k == K_RAW {
        if sfun {
            return Ok(Dv.Raw(st_read(mut st, -1)?));
        }
        let mut last = Dv.Nothing;
        loop {
            let v = dec_item(mut w, mut st, spec, Some(ts.clone()), -1, false, false, true)?;
            if let Dv.Eoo = v {
                break;
            }
            last = v;
        }
        return Ok(last);
    }
    if k == K_INT or k == K_BOOL or k == K_NULL or k == K_OID or k == K_RELOID or k == K_REAL {
        return Err(perr(f"Indefinite length mode decoder not implemented for {ts_repr(ts)}"));
    }
    Err(perr("unreachable".to_string()))
}

// fromOctetString(chunk[1:], prepend=acc, padding=chunk[0])
fn bits_append(acc: (Big, i64), b: ref Vec[u8]) -> Result[(Big, i64), Exc] {
    if b.len() == 0 {
        return Err(exc("IndexError", "index out of range".to_string()));
    }
    let tb = b[0] as i64;
    if tb > 7 {
        return Err(perr(f"Trailing bits overflow {tb}"));
    }
    let rest = sub_bytes(b, 1, b.len());
    let (pv, pn) = acc;
    let n = rest.len() * 8 - tb;
    let v = big_shr(big_from_bytes(rest), tb);
    Ok((big_add(big_shl(pv, n), v), pn + n))
}

fn dec_bits(w: mut ref W, st: mut ref St, d: ref Dk, spec: ref Spec, ts: ref TagSet, len: i64, sfun: bool) -> Result[Dv, Exc] {
    if sfun {
        return Ok(Dv.Raw(st_read(mut st, len)?));
    }
    if len == 0 or st.pos >= st.data.len() {
        return Err(perr("Empty BIT STRING substrate".to_string()));
    }
    if ts.tags[0].fmt == 0 {
        let tb = st_read(mut st, 1)?[0] as i64;
        if tb > 7 {
            return Err(perr(f"Trailing bits overflow {tb}"));
        }
        let chunk = st_read(mut st, len - 1)?;
        let n = chunk.len() * 8 - tb;
        let v = big_shr(big_from_bytes(chunk), tb);
        return Ok(Dv.Obj(create(mut w, d, spec, ts, P.Bits(v, n))?));
    }
    if not d.cons_ok {
        return Err(perr("Constructed encoding form prohibited at BitStringPayloadDecoder".to_string()));
    }
    let bp = proto(mut w, d)?;
    let mut acc = (big_zero(), 0);
    let cur = st.pos;
    while st.pos - cur < len {
        let c = dec_item(mut w, mut st, Spec.O(bp), None, -2, false, true, false)?;
        let b = dv_bytes(w, c)?;
        acc = bits_append(acc, b)?;
    }
    let (v, n) = acc;
    Ok(Dv.Obj(create(mut w, d, spec, ts, P.Bits(v, n))?))
}

fn dec_octets(w: mut ref W, st: mut ref St, d: ref Dk, spec: ref Spec, ts: ref TagSet, len: i64, sfun: bool) -> Result[Dv, Exc] {
    if sfun {
        return Ok(Dv.Raw(st_read(mut st, len)?));
    }
    if ts.tags[0].fmt == 0 {
        let chunk = st_read(mut st, len)?;
        return Ok(Dv.Obj(create(mut w, d, spec, ts, P.Bytes(chunk))?));
    }
    if not d.cons_ok {
        return Err(perr("Constructed encoding form prohibited at OctetStringPayloadDecoder".to_string()));
    }
    let op = proto(mut w, d)?;
    let mut header: Vec[u8] = Vec.new();
    let cur = st.pos;
    while st.pos - cur < len {
        let c = dec_item(mut w, mut st, Spec.O(op), None, -2, false, true, false)?;
        push_all(mut header, dv_bytes(w, c)?);
    }
    Ok(Dv.Obj(create(mut w, d, spec, ts, P.Bytes(header))?))
}

fn arcs_repr(xs: ref Vec[Big]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for x in xs.iter() {
        parts.push(big_str(x));
    }
    if parts.len() == 1 {
        return f"({parts[0]},)";
    }
    f"({join(parts, ", ")})"
}

fn dec_oid(w: mut ref W, d: ref Dk, spec: ref Spec, ts: ref TagSet, chunk: ref Vec[u8], full: bool) -> Result[i64, Exc] {
    let what = if full { "OID" } else { "RELATIVE-OID" };
    if chunk.len() == 0 {
        return Err(perr("Empty substrate".to_string()));
    }
    let mut oid: Vec[Big] = Vec.new();
    let mut i = 0;
    let n = chunk.len();
    while i < n {
        let sub = chunk[i] as i64;
        i += 1;
        if sub < 128 {
            oid.push(big_i(sub));
        } else if sub > 128 {
            let mut next = sub;
            let mut acc = big_zero();
            while next >= 128 {
                acc = big_add(big_mul_small(acc, 128), big_i(next & 0x7f));
                if i >= n {
                    return Err(exc("SubstrateUnderrunError", f"Short substrate for sub-OID past {arcs_repr(oid)}"));
                }
                next = chunk[i] as i64;
                i += 1;
            }
            oid.push(big_add(big_mul_small(acc, 128), big_i(next)));
        } else {
            return Err(perr(f"Invalid octet 0x80 in {what} encoding"));
        }
    }
    let mut arcs: Vec[Big] = Vec.new();
    if full {
        let f = oid[0].clone();
        if big_cmp(f, big_i(39)) <= 0 {
            arcs.push(big_zero());
            arcs.push(f);
        } else if big_cmp(f, big_i(79)) <= 0 {
            arcs.push(big_i(1));
            arcs.push(big_sub(f, big_i(40)));
        } else {
            arcs.push(big_i(2));
            arcs.push(big_sub(f, big_i(80)));
        }
        let mut j = 1;
        while j < oid.len() {
            arcs.push(oid[j].clone());
            j += 1;
        }
    } else {
        arcs = oid;
    }
    let mut ps: Vec[P] = Vec.new();
    for a in arcs.iter() {
        ps.push(P.Int(a.clone()));
    }
    create(mut w, d, spec, ts, P.Tuple(ps))
}

fn real_payload(chunk0: ref Vec[u8]) -> Result[P, Exc] {
    if chunk0.len() == 0 {
        return Ok(P.Float(0.0));
    }
    let fo = chunk0[0] as i64;
    let mut chunk = sub_bytes(chunk0, 1, chunk0.len());
    if (fo & 0x80) != 0 {
        if chunk.len() == 0 {
            return Err(perr("Incomplete floating-point value".to_string()));
        }
        let mut n = (fo & 3) + 1;
        if n == 4 {
            n = chunk[0] as i64;
            chunk = sub_bytes(chunk, 1, chunk.len());
        }
        let eo = sub_bytes(chunk, 0, n);
        chunk = sub_bytes(chunk, n, chunk.len());
        if eo.len() == 0 or chunk.len() == 0 {
            return Err(perr("Real exponent screwed".to_string()));
        }
        let mut e = if (eo[0] & 0x80) != 0 { -1 } else { 0 };
        for x in eo.iter() {
            e = (e << 8) | (*x as i64);
        }
        let b = (fo >> 4) & 3;
        if b > 2 {
            return Err(perr("Illegal Real base".to_string()));
        }
        if b == 1 {
            e = e * 3;
        } else if b == 2 {
            e = e * 4;
        }
        let mut p = big_from_bytes(chunk);
        if (fo & 0x40) != 0 {
            p = big_neg(p);
        }
        let sf = (fo >> 2) & 3;
        p = big_shl(p, sf);
        return Ok(P.Tuple(vec![P.Int(p), p_int(2), p_int(e)]));
    }
    if (fo & 0x40) != 0 {
        return Ok(P.Str(if (fo & 1) != 0 { "-inf".to_string() } else { "inf".to_string() }));
    }
    if chunk.len() == 0 {
        return Err(perr("Incomplete floating-point value".to_string()));
    }
    let text = ascii_text(chunk);
    let bad = exc("SubstrateUnderrunError", "Bad character Real syntax".to_string());
    let nr = fo & 3;
    if nr == 1 {
        return match parse_int_text(text, 10) {
            Some(v) => Ok(P.Tuple(vec![P.Int(v), p_int(10), p_int(0)])),
            None => Err(bad),
        };
    }
    if nr == 2 or nr == 3 {
        return match py_float(text) {
            Some(f) => Ok(P.Float(f)),
            None => Err(bad),
        };
    }
    Err(exc("SubstrateUnderrunError", f"Unknown NR (tag {fo})"))
}

// the constructed decoders without a schema: guess the container
fn schemaless(w: mut ref W, st: mut ref St, d: ref Dk, ts: ref TagSet, len: i64) -> Result[Dv, Exc] {
    let mut comps: Vec[i64] = Vec.new();
    let mut kinds: Vec[TagSet] = Vec.new();
    let mut obj = -1;
    let orig = st.pos;
    while len == -1 or st.pos < orig + len {
        let c = dec_item(mut w, mut st, Spec.Nil, None, -2, false, false, len == -1)?;
        if len == -1 {
            if let Dv.Eoo = c {
                break;
            }
        }
        let o = dv_obj(c)?;
        comps.push(o);
        let t = w.objs[o].tags.clone();
        if tm_find_ts(kinds, t) < 0 {
            kinds.push(t);
        }
        let cls = if kinds.len() > 1 { d.cls } else { d.of_cls };
        let pt = w.classes[cls].tags.clone();
        let tags = TagSet { base: pt.base.clone(), tags: ts.tags.clone() };
        let init = cls_init(w, cls);
        obj = cons_new(mut w, cls, tags, init.sub, init.ctype, init.size);
    }
    if obj < 0 {
        return Ok(Dv.Nothing);
    }
    let mut i = 0;
    while i < comps.len() {
        set_component(mut w, obj, i, Some(comps[i]), false)?;
        i += 1;
    }
    Ok(Dv.Obj(obj))
}

fn tm_find_ts(xs: ref Vec[TagSet], t: ref TagSet) -> i64 {
    let mut i = 0;
    while i < xs.len() {
        if ts_eq(xs[i], t) {
            return i;
        }
        i += 1;
    }
    -1
}

fn has_opt_or_dflt(w: ref W, nt: i64) -> bool {
    for it in w.nts[nt].items.iter() {
        if it.opt or it.dflt {
            return true;
        }
    }
    false
}

fn has_open(w: ref W, nt: i64) -> bool {
    for it in w.nts[nt].items.iter() {
        if it.open >= 0 {
            return true;
        }
    }
    false
}

// the component spec for position idx of a SEQUENCE or SET
fn comp_spec(w: ref W, s: i64, idx: i64, is_set: bool, det: bool) -> Result[Spec, Exc] {
    let nt = w.objs[s].ctype;
    let n = w.nts[nt].items.len();
    if n == 0 {
        return Ok(Spec.Nil);
    }
    if is_set {
        let tm = nts_tagmap(w, nt, true, 0, n);
        if tm.err.len() > 0 {
            return Err(perr(tm.err));
        }
        return Ok(Spec.M(tm));
    }
    if idx >= n {
        return Err(perr(f"Excessive components decoded at {obj_repr(w, s)}"));
    }
    let it = w.nts[nt].items[idx].clone();
    if not det and (it.opt or it.dflt) {
        let tm = tagmap_near(w, nt, idx)?;
        if tm.err.len() > 0 {
            return Err(perr(tm.err));
        }
        return Ok(Spec.M(tm));
    }
    Ok(Spec.O(it.obj))
}

fn place(w: mut ref W, obj: i64, comp: i64, idx0: i64, is_set: bool, det: bool) -> Result[i64, Exc] {
    let nt = w.objs[obj].ctype;
    let n = w.nts[nt].items.len();
    let mut idx = idx0;
    if not det and n > 0 {
        if is_set {
            let eff = effective_tags(w, comp)?;
            idx = nts_tag_to_pos(w, nt, 0, n, eff)?;
        } else {
            if idx >= n {
                return Err(exc("IndexError", "tuple index out of range".to_string()));
            }
            let it = w.nts[nt].items[idx].clone();
            if it.opt or it.dflt {
                let eff = effective_tags(w, comp)?;
                idx = pos_near(w, nt, eff, idx)?;
            }
        }
    }
    set_component(mut w, obj, idx, Some(comp), false)?;
    Ok(idx)
}

fn check_record(w: mut ref W, st: ref St, obj: i64, seen: ref Vec[i64], indef: bool) -> Result[(), Exc] {
    let nt = w.objs[obj].ctype;
    let n = w.nts[nt].items.len();
    if n == 0 {
        if not indef and is_inconsistent(w, obj)? {
            return Err(perr(f"ASN.1 object {cls_name(w, obj)} is inconsistent"));
        }
        return Ok(());
    }
    let mut i = 0;
    while i < n {
        let it = w.nts[nt].items[i].clone();
        if not it.opt and not it.dflt and not seen.contains(i) {
            return Err(perr(f"ASN.1 object {cls_name(w, obj)} has uninitialized components"));
        }
        i += 1;
    }
    if has_open(w, nt) {
        if st.open {
            decode_open_types(mut w, st, obj)?;
        }
    } else if indef and is_inconsistent(w, obj)? {
        return Err(perr(f"ASN.1 object {cls_name(w, obj)} is inconsistent"));
    }
    Ok(())
}

fn decode_open_types(w: mut ref W, st: ref St, obj: i64) -> Result[(), Exc] {
    let nt = w.objs[obj].ctype;
    let items = w.nts[nt].items.clone();
    let mut idx = 0;
    while idx < items.len() {
        let it = items[idx].clone();
        if it.open < 0 {
            idx += 1;
            continue;
        }
        if it.opt {
            let c = get_component(mut w, obj, idx)?;
            if not obj_is_value(w, c) {
                idx += 1;
                continue;
            }
        }
        let ot = w.ots[it.open].clone();
        let gov = get_field(mut w, obj, ot.gov.as_str())?;
        if is_novalue(w.objs[gov].val) {
            return Err(novalue_op("__hash__"));
        }
        let gp = val_p(w.objs[gov].val);
        let mut found = -1;
        let mut k = 0;
        while k < ot.keys.len() {
            if p_eq(w, val_p(w.objs[ot.keys[k]].val), gp) {
                found = ot.vals[k];
                break;
            }
            k += 1;
        }
        if found < 0 {
            idx += 1;
            continue;
        }
        let cont = get_component(mut w, obj, idx)?;
        if is_seqof(w.objs[cont].tid) {
            let m = comp_len(w, cont);
            let mut pos = 0;
            while pos < m {
                let el = get_component(mut w, cont, pos)?;
                let data = obj_octets(w, el)?;
                let mut s2 = St { data: data, pos: 0, mark: 0, codec: st.codec, open: st.open };
                let c = dec_item(mut w, mut s2, Spec.O(found), None, -2, false, false, false)?;
                let co = dv_obj(c)?;
                if let Err(e) = set_component(mut w, cont, pos, Some(co), true) {
                    return Err(exc("IndexError", e.msg));
                }
                pos += 1;
            }
        } else {
            let data = obj_octets(w, cont)?;
            let mut s2 = St { data: data, pos: 0, mark: 0, codec: st.codec, open: st.open };
            let c = dec_item(mut w, mut s2, Spec.O(found), None, -2, false, false, false)?;
            let co = dv_obj(c)?;
            set_component(mut w, obj, idx, Some(co), true)?;
        }
        idx += 1;
    }
    Ok(())
}

fn cons_clone(w: mut ref W, d: ref Dk, spec: ref Spec, ts: ref TagSet) -> Result[i64, Exc] {
    match spec {
        Spec.O(s) => obj_clone(mut w, *s, false),
        _ => {
            let init = cls_init(w, d.cls);
            Ok(cons_new(mut w, d.cls, ts, init.sub, init.ctype, init.size))
        }
    }
}

fn dec_cons(w: mut ref W, st: mut ref St, d: ref Dk, spec: ref Spec, ts: ref TagSet, len: i64, sfun: bool) -> Result[Dv, Exc] {
    if ts.tags[0].fmt != 32 {
        return Err(perr("Constructed tag format expected".to_string()));
    }
    let orig = st.pos;
    if sfun {
        return Ok(Dv.Raw(st_read(mut st, len)?));
    }
    let s = match spec {
        Spec.O(s) => *s,
        _ => return schemaless(mut w, mut st, d, ts, len),
    };
    let obj = obj_clone(mut w, s, false)?;
    let t = w.objs[s].tid;
    if t == T_SEQ or t == T_SET {
        let nt = w.objs[s].ctype;
        let is_set = t == T_SET;
        let det = not is_set and not has_opt_or_dflt(w, nt);
        let mut seen: Vec[i64] = Vec.new();
        let mut idx = 0;
        while st.pos - orig < len {
            let cs = comp_spec(w, s, idx, is_set, det)?;
            let c = dec_item(mut w, mut st, cs, None, -2, false, false, false)?;
            let co = dv_obj(c)?;
            idx = place(mut w, obj, co, idx, is_set, det)?;
            seen.push(idx);
            idx += 1;
        }
        check_record(mut w, st, obj, seen, false)?;
    } else {
        let ct = w.objs[s].ctype;
        let cs = if ct >= 0 { Spec.O(ct) } else { Spec.Nil };
        let mut idx = 0;
        while st.pos - orig < len {
            let c = dec_item(mut w, mut st, cs, None, -2, false, false, false)?;
            let co = dv_obj(c)?;
            set_component(mut w, obj, idx, Some(co), false)?;
            idx += 1;
        }
    }
    Ok(Dv.Obj(obj))
}

fn dec_cons_indef(w: mut ref W, st: mut ref St, d: ref Dk, spec: ref Spec, ts: ref TagSet, sfun: bool) -> Result[Dv, Exc] {
    if ts.tags[0].fmt != 32 {
        return Err(perr("Constructed tag format expected".to_string()));
    }
    if sfun {
        return Ok(Dv.Raw(st_read(mut st, -1)?));
    }
    let s = match spec {
        Spec.O(s) => *s,
        _ => return schemaless(mut w, mut st, d, ts, -1),
    };
    let obj = obj_clone(mut w, s, false)?;
    let t = w.objs[s].tid;
    if t == T_SEQ or t == T_SET {
        let nt = w.objs[s].ctype;
        let n = w.nts[nt].items.len();
        let is_set = t == T_SET;
        let det = not is_set and not has_opt_or_dflt(w, nt);
        let mut seen: Vec[i64] = Vec.new();
        let mut idx = 0;
        loop {
            let cs = if n <= idx { Spec.Nil } else { comp_spec(w, s, idx, is_set, det)? };
            let c = dec_item(mut w, mut st, cs, None, -2, false, false, true)?;
            if let Dv.Eoo = c {
                break;
            }
            let co = dv_obj(c)?;
            idx = place(mut w, obj, co, idx, is_set, det)?;
            seen.push(idx);
            idx += 1;
        }
        check_record(mut w, st, obj, seen, true)?;
    } else {
        let ct = w.objs[s].ctype;
        let cs = if ct >= 0 { Spec.O(ct) } else { Spec.Nil };
        let mut idx = 0;
        loop {
            let c = dec_item(mut w, mut st, cs, None, -2, false, false, true)?;
            if let Dv.Eoo = c {
                break;
            }
            let co = dv_obj(c)?;
            set_component(mut w, obj, idx, Some(co), false)?;
            idx += 1;
        }
    }
    Ok(Dv.Obj(obj))
}

fn choice_tagmap(w: ref W, obj: i64) -> Result[Tm, Exc] {
    let nt = w.objs[obj].ctype;
    let tm = nts_tagmap(w, nt, true, 0, w.nts[nt].items.len());
    if tm.err.len() > 0 {
        return Err(perr(tm.err));
    }
    Ok(tm)
}

fn dec_choice(w: mut ref W, st: mut ref St, d: ref Dk, spec: ref Spec, ts: ref TagSet, len: i64, sfun: bool) -> Result[Dv, Exc] {
    let obj = cons_clone(mut w, d, spec, ts)?;
    if sfun {
        return Ok(Dv.Raw(st_read(mut st, len)?));
    }
    let tm = choice_tagmap(w, obj)?;
    let c = if ts_eq(w.objs[obj].tags, ts) {
        dec_item(mut w, mut st, Spec.M(tm), None, -2, false, false, false)?
    } else {
        dec_item(mut w, mut st, Spec.M(tm), Some(ts.clone()), len, true, false, false)?
    };
    let co = dv_obj(c)?;
    let eff = effective_tags(w, co)?;
    set_by_type(mut w, obj, eff, co)?;
    Ok(Dv.Obj(obj))
}

fn dec_choice_indef(w: mut ref W, st: mut ref St, d: ref Dk, spec: ref Spec, ts: ref TagSet, sfun: bool) -> Result[Dv, Exc] {
    let obj = cons_clone(mut w, d, spec, ts)?;
    if sfun {
        return Ok(Dv.Raw(st_read(mut st, -1)?));
    }
    let tagged = ts_eq(w.objs[obj].tags, ts);
    loop {
        let tm = choice_tagmap(w, obj)?;
        let c = if tagged {
            dec_item(mut w, mut st, Spec.M(tm), None, -2, false, false, true)?
        } else {
            dec_item(mut w, mut st, Spec.M(tm), Some(ts.clone()), -1, true, false, true)?
        };
        if let Dv.Eoo = c {
            break;
        }
        let co = dv_obj(c)?;
        let eff = effective_tags(w, co)?;
        set_by_type(mut w, obj, eff, co)?;
        if not tagged {
            break;
        }
    }
    Ok(Dv.Obj(obj))
}

// Decoder.__call__: the object and the tail
fn decode(w: mut ref W, codec: i64, data: ref Vec[u8], spec: ref Spec, open: bool) -> Result[(Dv, Vec[u8]), Exc] {
    let mut st = St { data: data.clone(), pos: 0, mark: 0, codec: codec, open: open };
    match dec_item(mut w, mut st, spec, None, -2, false, false, false) {
        Ok(v) => {
            let tail = sub_bytes(st.data, st.pos, st.data.len());
            Ok((v, tail))
        }
        Err(e) => {
            if e.kind == "__underrun" {
                return Err(exc("SubstrateUnderrunError", "Short substrate on input".to_string()));
            }
            Err(e)
        }
    }
}

fn job_dec(w: mut ref W, j: ref J) {
    let mut open = false;
    if let Some(opts) = j_get(j, "opts") {
        if let Some(x) = j_get(opts, "decodeOpenTypes") {
            open = j_truthy(x);
        }
    }
    let mut spec = Spec.Nil;
    if let Some(t) = j_get(j, "t") {
        if j_truthy(t) {
            spec = Spec.O(build(mut w, t).unwrap());
        }
    }
    let data = unhex_str(j_str(j_get(j, "hex").unwrap()));
    let c = codec_of(j_str(j_get(j, "codec").unwrap()));
    let (v, tail) = match decode(mut w, c, data, spec, open) {
        Ok(x) => x,
        Err(e) => {
            println(failure(e));
            return;
        }
    };
    match v {
        Dv.Obj(o) => {
            println(f"{cls_name(w, o)} {ts_repr(w.objs[o].tags)}");
            show(mut w, o);
        }
        Dv.Raw(b) => println(f"bytes {hexs(b)}"),
        _ => println("None"),
    }
    if tail.len() > 0 {
        println(f"tail: {hexs(tail)}");
    }
}

fn job_rt(w: mut ref W, j: ref J) -> Result[(), Exc] {
    let t = j_get(j, "t").unwrap();
    let v = make(mut w, t, j_get(j, "v").unwrap())?;
    let spec = build(mut w, t)?;
    let names = vec!["ber", "cer", "der"];
    let mut last = -1;
    let mut c = 0;
    while c < 3 {
        let b = enc_obj(mut w, c, v, -1, new_eo())?;
        match decode(mut w, c, b, Spec.O(spec), false) {
            Ok((dv, _)) => {
                let o = dv_obj(dv)?;
                last = o;
                let x = enc_obj(mut w, DER, o, -1, new_eo())?;
                let y = enc_obj(mut w, DER, v, -1, new_eo())?;
                let same = if x == y { "same" } else { "differs" };
                println(f"{names[c]} {hexs(b)} {same}");
            }
            Err(e) => println(f"{names[c]} {hexs(b)} {failure(e)}"),
        }
        c += 1;
    }
    if last >= 0 {
        println(pp(w, last));
    }
    Ok(())
}
