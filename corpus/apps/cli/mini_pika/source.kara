// mini_pika: a port of pika 1.3.2, the AMQP 0-9-1 client (BSD-3-Clause,
// Tony Garnock-Jones, Gavin M. Roy, Pivotal Software, Inc and others).
//
// It ports the wire codec (data.py's field tables, spec.py's methods and
// BasicProperties, frame.py's marshal and decode_frame), URLParameters and
// the Parameters setters, PlainCredentials and ExternalCredentials, and
// the asynchronous core: Connection's handshake, tuning, heartbeats,
// blocking, closing and stream-loss handling, Channel's RPC queue,
// content assembly, consumers, confirms, returns and closing, and the
// CallbackManager both of them dispatch through.
//
// Two jobs. The first parses the broker URLs in urls_text() the way
// URLParameters does. The second replays the sessions in sessions_text():
// each is a client program (open a channel, set the prefetch, declare a
// queue, turn on publisher confirms, publish, consume) run against the
// bytes a broker sent it, fed at their capture times, with timers on the
// capture's clock. Every frame in either direction is printed with pika's
// own repr. oracle.py runs the same program on the vendored pika and
// wrote expected.out.

// ------------------------------------------------------------ errors

// A Python exception: its class, repr() and str(). A ConnectionClosed or
// ChannelClosed also carries its reply code and text.
#[derive(Clone)]
struct PyErr {
    cls: String,
    repr: String,
    msg: String,
    code: i64,
    text: String,
}

fn err(cls: ref String, repr: ref String, msg: ref String) -> PyErr {
    PyErr { cls: cls.clone(), repr: repr.clone(), msg: msg.clone(), code: 0, text: String.new() }
}

// AMQPConnectionError and its subclasses with one argument print
// "<name>: <args tuple>".
fn conn_err(cls: ref String, msg: ref String) -> PyErr {
    let a = args1(msg);
    err(cls, f"{cls}: {a}", msg)
}

// ("text",) as Python prints a one-element tuple of a str.
fn args1(msg: ref String) -> String {
    let r = str_repr(msg);
    f"({r},)"
}

fn closed_err(cls: ref String, code: i64, text: ref String) -> PyErr {
    let t = str_repr(text);
    let mut e = err(cls, f"{cls}: ({code}) {t}", f"({code}, {t})");
    e.code = code;
    e.text = text.clone();
    e
}

fn value_error(msg: ref String) -> PyErr {
    let r = str_repr(msg);
    err("ValueError", f"ValueError({r})", msg)
}

fn type_error(msg: ref String) -> PyErr {
    let r = str_repr(msg);
    err("TypeError", f"TypeError({r})", msg)
}

fn struct_error(msg: ref String) -> PyErr {
    let r = str_repr(msg);
    err("error", f"error({r})", msg)
}

fn invalid_frame(msg: ref String) -> PyErr {
    let r = str_repr(msg);
    err("InvalidFrameError", f"InvalidFrameError: Invalid frame received: {r}", msg)
}

fn key_error(k: i64) -> PyErr {
    err("KeyError", f"KeyError({k})", f"{k}")
}

fn attr_none(attr: ref String) -> PyErr {
    let m = f"'NoneType' object has no attribute '{attr}'";
    let r = str_repr(m);
    err("AttributeError", f"AttributeError({r})", m)
}

fn channel_wrong_state(msg: ref String) -> PyErr {
    let a = args1(msg);
    err("ChannelWrongStateError", f"ChannelWrongStateError: {a}", msg)
}

fn amqp_error(cls: ref String, msg: ref String) -> PyErr {
    let a = args1(msg);
    err(cls, f"{cls}: An unspecified AMQP error has occurred; {a}", msg)
}

// struct.unpack_from's complaint about a buffer too short.
fn need(len: i64, offset: i64, size: i64) -> Result[(), PyErr] {
    if offset + size > len {
        let at_least = offset + size;
        return Err(struct_error(f"unpack_from requires a buffer of at least {at_least} bytes for unpacking {size} bytes at offset {offset} (actual buffer size is {len})"));
    }
    Ok(())
}

// ------------------------------------------------------------ bytes

fn slice(b: ref Vec[u8], start: i64, end: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut i = if start < 0 { 0 } else { start };
    let stop = if end > b.len() { b.len() } else { end };
    while i < stop {
        out.push(b[i]);
        i += 1;
    }
    out
}

fn append(out: mut ref Vec[u8], b: ref Vec[u8]) {
    for x in b.iter() {
        out.push(*x);
    }
}

fn str_bytes(s: ref String) -> Vec[u8] {
    s.bytes().to_vec()
}

fn be_u(b: ref Vec[u8], pos: i64, n: i64) -> i64 {
    let mut v: i64 = 0;
    for i in 0..n {
        v = (v << 8) | (b[pos + i] as i64);
    }
    v
}

fn be_u64(b: ref Vec[u8], pos: i64) -> u64 {
    let mut v: u64 = 0;
    for i in 0..8 {
        v = (v << 8) | (b[pos + i] as u64);
    }
    v
}

// A signed big-endian integer of n bytes.
fn be_i(b: ref Vec[u8], pos: i64, n: i64) -> i64 {
    let v = be_u(b, pos, n);
    if n == 8 {
        return v;
    }
    let top: i64 = 1 << (n * 8 - 1);
    if v >= top { v - (top << 1) } else { v }
}

fn push_be(out: mut ref Vec[u8], v: i64, n: i64) {
    let mut k = n - 1;
    while k >= 0 {
        out.push(((v >> (k * 8)) & 0xFF) as u8);
        k -= 1;
    }
}

fn push_be_u64(out: mut ref Vec[u8], v: u64) {
    let mut k: i64 = 7;
    while k >= 0 {
        out.push(((v >> ((k * 8) as u64)) & 0xFF) as u8);
        k -= 1;
    }
}

fn hex_digit(n: u8) -> u8 {
    if n < 10 { b'0' + n } else { b'a' + n - 10 }
}

fn hex_val(c: u8) -> i64 {
    if c >= b'0' and c <= b'9' {
        (c - b'0') as i64
    } else if c >= b'a' and c <= b'f' {
        (c - b'a' + 10) as i64
    } else {
        (c - b'A' + 10) as i64
    }
}

fn is_hex(c: u8) -> bool {
    (c >= b'0' and c <= b'9') or (c >= b'a' and c <= b'f') or (c >= b'A' and c <= b'F')
}

fn from_hex(s: ref String) -> Vec[u8] {
    let b = str_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < b.len() {
        out.push((hex_val(b[i]) * 16 + hex_val(b[i + 1])) as u8);
        i += 2;
    }
    out
}

fn hex8(v: i64) -> String {
    let mut out: Vec[u8] = Vec.new();
    for i in 0..8 {
        out.push(hex_digit(((v >> ((7 - i) * 4)) & 15) as u8));
    }
    String.from_utf8(out).unwrap()
}

// zlib.crc32
fn crc_table() -> Vec[i64] {
    let mut t: Vec[i64] = Vec.new();
    for n in 0..256 {
        let mut c: i64 = n;
        for k in 0..8 {
            if (c & 1) == 1 {
                c = (c >> 1) ^ 0xEDB88320;
            } else {
                c = c >> 1;
            }
        }
        t.push(c);
    }
    t
}

fn crc32(t: ref Vec[i64], d: ref Vec[u8]) -> i64 {
    let mut c: i64 = 0xFFFFFFFF;
    for x in d.iter() {
        c = t[((c ^ (*x as i64)) & 0xFF)] ^ (c >> 8);
    }
    c ^ 0xFFFFFFFF
}

// ------------------------------------------------------------ text

fn cp_char(cp: u32) -> char {
    match char.try_from(cp) {
        Ok(c) => c,
        Err(_) => '\u{FFFD}',
    }
}

fn push_esc(out: mut ref String, c: u32) {
    out.push('\\');
    out.push('x');
    out.push(cp_char(hex_digit((c / 16) as u8) as u32));
    out.push(cp_char(hex_digit((c % 16) as u8) as u32));
}

// Python's str repr. Of the non-ASCII characters only those of Latin-1
// that Python does not print are escaped; the rest are taken as printable.
fn str_repr(s: ref String) -> String {
    let quote = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    let mut out = String.new();
    out.push(quote);
    for c in s.chars() {
        let cp = c as u32;
        if c == quote or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if cp == 9 {
            out.push_str("\\t");
        } else if cp == 10 {
            out.push_str("\\n");
        } else if cp == 13 {
            out.push_str("\\r");
        } else if cp < 32 or (cp >= 127 and cp <= 160) or cp == 173 {
            push_esc(mut out, cp);
        } else {
            out.push(c);
        }
    }
    out.push(quote);
    out
}

fn bytes_repr(b: ref Vec[u8]) -> String {
    let quote = if b.contains(b'\'') and not b.contains(b'"') { b'"' } else { b'\'' };
    let mut out = String.new();
    out.push('b');
    out.push(cp_char(quote as u32));
    for x in b.iter() {
        let c = *x;
        if c == quote or c == b'\\' {
            out.push('\\');
            out.push(cp_char(c as u32));
        } else if c == b'\t' {
            out.push_str("\\t");
        } else if c == b'\n' {
            out.push_str("\\n");
        } else if c == b'\r' {
            out.push_str("\\r");
        } else if c < 32 or c >= 127 {
            push_esc(mut out, c as u32);
        } else {
            out.push(cp_char(c as u32));
        }
    }
    out.push(cp_char(quote as u32));
    out
}

// repr() of a list of str.
fn list_repr(items: ref Vec[String]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for s in items.iter() {
        parts.push(str_repr(s));
    }
    let j = parts.join(", ");
    f"[{j}]"
}

// bytes.decode('utf8'), None when the bytes are not UTF-8.
fn utf8(b: ref Vec[u8]) -> Option[String] {
    match String.from_utf8(b.clone()) {
        Ok(s) => Some(s),
        Err(_) => None,
    }
}

// bytes.decode('utf-8', 'replace'): each maximal invalid subpart becomes
// one U+FFFD.
fn utf8_replace(b: ref Vec[u8]) -> String {
    let mut out = String.new();
    let mut i: i64 = 0;
    let n = b.len();
    while i < n {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(cp_char(c as u32));
            i += 1;
            continue;
        }
        let mut need_n: i64 = 0;
        let mut lo: i64 = 0x80;
        let mut hi: i64 = 0xBF;
        let mut cp: i64 = 0;
        if c >= 0xC2 and c <= 0xDF {
            need_n = 1;
            cp = c & 0x1F;
        } else if c >= 0xE0 and c <= 0xEF {
            need_n = 2;
            cp = c & 0x0F;
            if c == 0xE0 {
                lo = 0xA0;
            }
            if c == 0xED {
                hi = 0x9F;
            }
        } else if c >= 0xF0 and c <= 0xF4 {
            need_n = 3;
            cp = c & 0x07;
            if c == 0xF0 {
                lo = 0x90;
            }
            if c == 0xF4 {
                hi = 0x8F;
            }
        } else {
            out.push('\u{FFFD}');
            i += 1;
            continue;
        }
        let mut j = i + 1;
        let mut ok = true;
        let mut k: i64 = 0;
        while k < need_n {
            if j >= n {
                ok = false;
                break;
            }
            let d = b[j] as i64;
            let (l, h) = if k == 0 { (lo, hi) } else { (0x80, 0xBF) };
            if d < l or d > h {
                ok = false;
                break;
            }
            cp = (cp << 6) | (d & 0x3F);
            j += 1;
            k += 1;
        }
        if ok {
            out.push(cp_char(cp as u32));
        } else {
            out.push('\u{FFFD}');
        }
        i = j;
    }
    out
}

fn split_on(s: ref String, sep: char) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

// str.partition: the part before the first sep, whether sep was found,
// and the part after it.
fn partition(s: ref String, sep: ref String) -> (String, bool, String) {
    match s.find(sep) {
        Some(i) => (s.substring(0, i), true, s.substring(i + sep.len(), s.len())),
        None => (s.clone(), false, String.new()),
    }
}

fn rpartition(s: ref String, sep: ref String) -> (String, bool, String) {
    match s.rfind(sep) {
        Some(i) => (s.substring(0, i), true, s.substring(i + sep.len(), s.len())),
        None => (String.new(), false, s.clone()),
    }
}

fn lines_of(s: ref String) -> Vec[String] {
    let mut out = split_on(s, '\n');
    if out.len() > 0 and out[out.len() - 1].len() == 0 {
        out.pop();
    }
    out
}

// The ~ escapes gen_kara.py writes for the characters a string literal
// treats specially.
fn unesc(s: ref String) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut out = String.new();
    let mut i: i64 = 0;
    while i < cs.len() {
        if cs[i] == '~' and i + 1 < cs.len() {
            let c = cs[i + 1];
            out.push(if c == 't' { '~' } else if c == 'b' { '\\' } else if c == 'q' { '"' } else if c == 'o' { '{' } else { '}' });
            i += 2;
        } else {
            out.push(cs[i]);
            i += 1;
        }
    }
    out
}

fn py_bool(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

// %7d
fn pad7(n: i64) -> String {
    let mut s = f"{n}";
    while s.len() < 7 {
        s = f" {s}";
    }
    s
}

// ------------------------------------------------------------ values

// The Python values a field table holds. LongI and LongU are pika's
// compat.long, which prints with an L: what decode_value makes of the
// 64-bit, float and double kinds. Dec is a Decimal (coefficient and
// exponent), Time a naive UTC datetime in seconds since the epoch, and a
// Dict keeps its insertion order, as a Python dict does.
#[derive(Clone)]
enum Val {
    Nil,
    Bool(bool),
    Int(i64),
    LongI(i64),
    LongU(u64),
    Dec(i64, i64),
    Time(i64),
    Str(String),
    Bytes(Vec[u8]),
    List(Vec[Val]),
    Dict(Vec[(Val, Val)]),
}

fn vstr(s: ref String) -> Val {
    Val.Str(s.clone())
}

fn val_eq(a: ref Val, b: ref Val) -> bool {
    match (a, b) {
        (Val.Nil, Val.Nil) => true,
        (Val.Bool(x), Val.Bool(y)) => *x == *y,
        (Val.Int(x), Val.Int(y)) => *x == *y,
        (Val.Str(x), Val.Str(y)) => *x == *y,
        (Val.Bytes(x), Val.Bytes(y)) => *x == *y,
        _ => false,
    }
}

// dict[key] = value: a key already there keeps its place.
fn dict_set(d: mut ref Vec[(Val, Val)], k: own Val, v: own Val) {
    let mut i: i64 = 0;
    while i < d.len() {
        if val_eq(d[i].0, k) {
            d[i] = (k, v);
            return;
        }
        i += 1;
    }
    d.push((k, v));
}

fn dict_get(d: ref Val, key: ref String) -> Option[Val] {
    match d {
        Val.Dict(items) => {
            for p in items.iter() {
                match p.0 {
                    Val.Str(k) => {
                        if *k == *key {
                            return Some(p.1.clone());
                        }
                    }
                    _ => {}
                }
            }
            None
        }
        _ => None,
    }
}

fn truthy(v: ref Val) -> bool {
    match v {
        Val.Nil => false,
        Val.Bool(b) => *b,
        Val.Int(n) => *n != 0,
        Val.LongI(n) => *n != 0,
        Val.LongU(n) => *n != 0,
        Val.Dec(c, _) => *c != 0,
        Val.Time(_) => true,
        Val.Str(s) => s.len() > 0,
        Val.Bytes(b) => b.len() > 0,
        Val.List(l) => l.len() > 0,
        Val.Dict(d) => d.len() > 0,
    }
}

fn digits_of(n: i64) -> String {
    let s = f"{n}";
    if n < 0 { s.substring(1, s.len()) } else { s }
}

// str(Decimal): the to-scientific-string conversion.
fn dec_str(coef: i64, exp: i64) -> String {
    let neg = coef < 0;
    let c = digits_of(coef);
    let n = c.len();
    let adjusted = exp + n - 1;
    let mut body = String.new();
    if exp <= 0 and adjusted >= -6 {
        if exp == 0 {
            body = c.clone();
        } else if n > -exp {
            let cut = n + exp;
            body = f"{c.substring(0, cut)}.{c.substring(cut, n)}";
        } else {
            let mut zeros = String.new();
            let mut k = n;
            while k < -exp {
                zeros.push('0');
                k += 1;
            }
            body = f"0.{zeros}{c}";
        }
    } else {
        body = c.substring(0, 1);
        if n > 1 {
            body = f"{body}.{c.substring(1, n)}";
        }
        let sign = if adjusted >= 0 { "+" } else { "" };
        body = f"{body}E{sign}{adjusted}";
    }
    if neg { f"-{body}" } else { body }
}

// The civil date of a day count from 1970-01-01.
fn civil(days: i64) -> (i64, i64, i64) {
    let z = days + 719468;
    let era = (if z >= 0 { z } else { z - 146096 }) / 146097;
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let y = yoe + era * 400;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = if mp < 10 { mp + 3 } else { mp - 9 };
    (if m <= 2 { y + 1 } else { y }, m, d)
}

fn days_from_civil(y0: i64, m: i64, d: i64) -> i64 {
    let y = if m <= 2 { y0 - 1 } else { y0 };
    let era = (if y >= 0 { y } else { y - 399 }) / 400;
    let yoe = y - era * 400;
    let mp = if m > 2 { m - 3 } else { m + 9 };
    let doy = (153 * mp + 2) / 5 + d - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

// repr(datetime.datetime): the seconds only when they are not zero.
fn time_repr(t: ref i64) -> String {
    let secs = *t;
    let days = (if secs >= 0 { secs } else { secs - 86399 }) / 86400;
    let rem = secs - days * 86400;
    let (y, mo, d) = civil(days);
    let h = rem / 3600;
    let mi = rem % 3600 / 60;
    let s = rem % 60;
    if s == 0 {
        f"datetime.datetime({y}, {mo}, {d}, {h}, {mi})"
    } else {
        f"datetime.datetime({y}, {mo}, {d}, {h}, {mi}, {s})"
    }
}

fn py_repr(v: ref Val) -> String {
    match v {
        Val.Nil => "None".to_string(),
        Val.Bool(b) => py_bool(*b),
        Val.Int(n) => f"{n}",
        Val.LongI(n) => f"{n}L",
        Val.LongU(n) => f"{n}L",
        Val.Dec(c, e) => {
            let s = dec_str(*c, *e);
            f"Decimal('{s}')"
        }
        Val.Time(t) => time_repr(t),
        Val.Str(s) => str_repr(s),
        Val.Bytes(b) => bytes_repr(b),
        Val.List(items) => {
            let mut parts: Vec[String] = Vec.new();
            for x in items.iter() {
                parts.push(py_repr(x));
            }
            let j = parts.join(", ");
            f"[{j}]"
        }
        Val.Dict(items) => {
            let mut parts: Vec[String] = Vec.new();
            for p in items.iter() {
                parts.push(f"{py_repr(p.0)}: {py_repr(p.1)}");
            }
            let j = parts.join(", ");
            f"{{{j}}}"
        }
    }
}

// str() of a value, which is what "%s" prints.
fn py_str(v: ref Val) -> String {
    match v {
        Val.Str(s) => s.clone(),
        Val.LongI(n) => f"{n}",
        Val.LongU(n) => f"{n}",
        Val.Dec(c, e) => dec_str(*c, *e),
        _ => py_repr(v),
    }
}

fn as_bytes(v: ref Val) -> Vec[u8] {
    match v {
        Val.Str(s) => str_bytes(s),
        Val.Bytes(b) => b.clone(),
        _ => Vec.new(),
    }
}

// ------------------------------------------------------------ data.py

fn encode_short_string(out: mut ref Vec[u8], v: ref Val) -> Result[(), PyErr] {
    let b = as_bytes(v);
    if b.len() > 255 {
        let r = bytes_repr(b);
        let shown = if r.len() > 300 { r.substring(0, 300) } else { r.clone() };
        return Err(err("ShortStringTooLong", f"ShortStringTooLong: AMQP Short String can contain up to 255 bytes: {shown}", r));
    }
    out.push(b.len() as u8);
    append(mut out, b);
    Ok(())
}

fn decode_short_string(b: ref Vec[u8], offset: i64) -> Result[(Val, i64), PyErr] {
    need(b.len(), offset, 1)?;
    let length = b[offset] as i64;
    let raw = slice(b, offset + 1, offset + 1 + length);
    let v = match utf8(raw) {
        Some(s) => Val.Str(s),
        None => Val.Bytes(raw),
    };
    Ok((v, offset + 1 + length))
}

#[allow(mutual_recursion_note)]
fn encode_table(out: mut ref Vec[u8], table: ref Val) -> Result[(), PyErr] {
    let mut body: Vec[u8] = Vec.new();
    match table {
        Val.Dict(items) => {
            for p in items.iter() {
                encode_short_string(mut body, p.0)?;
                encode_value(mut body, p.1)?;
            }
        }
        _ => {}
    }
    push_be(mut out, body.len(), 4);
    append(mut out, body);
    Ok(())
}

fn int_range(fmt: ref String, lo: ref String, hi: ref String) -> PyErr {
    struct_error(f"'{fmt}' format requires {lo} <= number <= {hi}")
}

fn encode_value(out: mut ref Vec[u8], v: ref Val) -> Result[(), PyErr] {
    match v {
        Val.Str(s) => {
            out.push(b'S');
            push_be(mut out, s.len(), 4);
            append(mut out, str_bytes(s));
        }
        Val.Bytes(b) => {
            out.push(b'x');
            push_be(mut out, b.len(), 4);
            append(mut out, b);
        }
        Val.Bool(x) => {
            out.push(b't');
            out.push(if *x { 1 } else { 0 });
        }
        Val.LongI(n) => {
            if *n < 0 {
                out.push(b'L');
            } else {
                out.push(b'l');
            }
            push_be(mut out, *n, 8);
        }
        Val.LongU(n) => {
            out.push(b'l');
            push_be_u64(mut out, *n);
        }
        Val.Int(n) => {
            let x = *n;
            if x >= -2147483648 and x <= 2147483647 {
                out.push(b'I');
                push_be(mut out, x, 4);
            } else {
                out.push(if x < 0 { b'L' } else { b'l' });
                push_be(mut out, x, 8);
            }
        }
        Val.Dec(c, e) => {
            // value.normalize(): the trailing zeros go into the exponent
            let mut coef = *c;
            let mut exp = *e;
            if coef == 0 {
                exp = 0;
            }
            while coef != 0 and coef % 10 == 0 {
                coef = coef / 10;
                exp += 1;
            }
            let mut decimals: i64 = 0;
            let mut raw = coef;
            if exp < 0 {
                decimals = -exp;
            } else {
                for _ in 0..exp {
                    raw = raw * 10;
                }
            }
            if decimals > 255 {
                return Err(int_range("B", "0", "255"));
            }
            if raw < -2147483648 or raw > 2147483647 {
                return Err(int_range("i", "-2147483648", "2147483647"));
            }
            out.push(b'D');
            out.push(decimals as u8);
            push_be(mut out, raw, 4);
        }
        Val.Time(t) => {
            out.push(b'T');
            push_be(mut out, *t, 8);
        }
        Val.Dict(_) => {
            out.push(b'F');
            encode_table(mut out, v)?;
        }
        Val.List(items) => {
            let mut body: Vec[u8] = Vec.new();
            for x in items.iter() {
                encode_value(mut body, x)?;
            }
            out.push(b'A');
            push_be(mut out, body.len(), 4);
            append(mut out, body);
        }
        Val.Nil => {
            out.push(b'V');
        }
    }
    Ok(())
}

#[allow(mutual_recursion_note)]
fn decode_table(b: ref Vec[u8], offset0: i64) -> Result[(Val, i64), PyErr] {
    need(b.len(), offset0, 4)?;
    let size = be_u(b, offset0, 4);
    let mut offset = offset0 + 4;
    let limit = offset + size;
    let mut d: Vec[(Val, Val)] = Vec.new();
    while offset < limit {
        let (key, o1) = decode_short_string(b, offset)?;
        let (value, o2) = decode_value(b, o1)?;
        dict_set(mut d, key, value);
        offset = o2;
    }
    Ok((Val.Dict(d), offset))
}

fn long_of(x: f64) -> Val {
    Val.LongI(x as i64)
}

fn decode_value(b: ref Vec[u8], offset0: i64) -> Result[(Val, i64), PyErr] {
    let kind = slice(b, offset0, offset0 + 1);
    let mut offset = offset0 + 1;
    let n = b.len();
    if kind.len() == 0 {
        return Err(err("InvalidFieldTypeException", "InvalidFieldTypeException: Unsupported field kind b''", "b''"));
    }
    let k = kind[0];
    let v = if k == b't' {
        need(n, offset, 1)?;
        offset += 1;
        Val.Bool(b[offset - 1] != 0)
    } else if k == b'b' {
        // pika reads the "short-short int" unsigned
        need(n, offset, 1)?;
        offset += 1;
        Val.Int(b[offset - 1] as i64)
    } else if k == b'B' {
        // and the "short-short unsigned int" signed
        need(n, offset, 1)?;
        offset += 1;
        Val.Int(be_i(b, offset - 1, 1))
    } else if k == b'U' or k == b's' {
        need(n, offset, 2)?;
        offset += 2;
        Val.Int(be_i(b, offset - 2, 2))
    } else if k == b'u' {
        need(n, offset, 2)?;
        offset += 2;
        Val.Int(be_u(b, offset - 2, 2))
    } else if k == b'I' {
        need(n, offset, 4)?;
        offset += 4;
        Val.Int(be_i(b, offset - 4, 4))
    } else if k == b'i' {
        need(n, offset, 4)?;
        offset += 4;
        Val.Int(be_u(b, offset - 4, 4))
    } else if k == b'L' {
        need(n, offset, 8)?;
        offset += 8;
        Val.LongI(be_i(b, offset - 8, 8))
    } else if k == b'l' {
        need(n, offset, 8)?;
        offset += 8;
        Val.LongU(be_u64(b, offset - 8))
    } else if k == b'f' {
        need(n, offset, 4)?;
        offset += 4;
        let bits = be_u(b, offset - 4, 4) as u32;
        long_of(bits.bits_as_f32() as f64)
    } else if k == b'd' {
        need(n, offset, 8)?;
        offset += 8;
        long_of(be_u64(b, offset - 8).bits_as_f64())
    } else if k == b'D' {
        need(n, offset, 1)?;
        let decimals = b[offset] as i64;
        offset += 1;
        need(n, offset, 4)?;
        let raw = be_i(b, offset, 4);
        offset += 4;
        Val.Dec(raw, -decimals)
    } else if k == b'S' or k == b'x' {
        need(n, offset, 4)?;
        let length = be_u(b, offset, 4);
        offset += 4;
        let raw = slice(b, offset, offset + length);
        offset += length;
        if k == b'x' {
            Val.Bytes(raw)
        } else {
            match utf8(raw) {
                Some(s) => Val.Str(s),
                None => Val.Bytes(raw),
            }
        }
    } else if k == b'A' {
        need(n, offset, 4)?;
        let length = be_u(b, offset, 4);
        offset += 4;
        let end = offset + length;
        let mut items: Vec[Val] = Vec.new();
        while offset < end {
            let (x, o) = decode_value(b, offset)?;
            items.push(x);
            offset = o;
        }
        Val.List(items)
    } else if k == b'T' {
        need(n, offset, 8)?;
        offset += 8;
        Val.Time(be_u(b, offset - 8, 8))
    } else if k == b'F' {
        let (t, o) = decode_table(b, offset)?;
        offset = o;
        t
    } else if k == b'V' {
        Val.Nil
    } else {
        let kr = bytes_repr(kind);
        return Err(err("InvalidFieldTypeException", f"InvalidFieldTypeException: Unsupported field kind {kr}", kr));
    };
    Ok((v, offset))
}

// ------------------------------------------------------------ spec.py

// A method class from spec.py: its index (class id << 16 | method id), its
// name and the fields its decode() reads, in order, with their kinds:
// o octet, h short, l long, q long-long, s short string, S long string,
// F table, B a bit that starts a new octet and b one that shares it.
// spec_text() is the table gen_kara.py read off the vendored spec.py.
#[derive(Clone)]
struct MSpec {
    index: i64,
    name: String,
    fields: Vec[String],
    kinds: Vec[u8],
}

#[derive(Clone)]
struct Spec {
    methods: Vec[MSpec],
    by_index: Map[i64, i64],
    by_name: Map[String, i64],
}

fn load_spec() -> Spec {
    let mut methods: Vec[MSpec] = Vec.new();
    let mut by_index: Map[i64, i64] = Map.new();
    let mut by_name: Map[String, i64] = Map.new();
    for line in lines_of(spec_text()).iter() {
        let w = split_on(line, ' ');
        let index = parse_int(w[0]);
        let mut fields: Vec[String] = Vec.new();
        let mut kinds: Vec[u8] = Vec.new();
        let mut i: i64 = 2;
        while i < w.len() {
            if w[i].len() > 0 {
                let (f, _, k) = partition(w[i], ":");
                fields.push(f);
                kinds.push(str_bytes(k)[0]);
            }
            i += 1;
        }
        by_index.insert(index, methods.len());
        by_name.insert(w[1].clone(), methods.len());
        methods.push(MSpec { index: index, name: w[1].clone(), fields: fields, kinds: kinds });
    }
    Spec { methods: methods, by_index: by_index, by_name: by_name }
}

fn parse_int(s: ref String) -> i64 {
    let b = str_bytes(s);
    let mut i: i64 = 0;
    let mut neg = false;
    if b.len() > 0 and b[0] == b'-' {
        neg = true;
        i = 1;
    }
    let mut v: i64 = 0;
    while i < b.len() {
        v = v * 10 + (b[i] - b'0') as i64;
        i += 1;
    }
    if neg { -v } else { v }
}

// A method object: its class and the values of its fields.
#[derive(Clone)]
struct Meth {
    sp: MSpec,
    vals: Vec[Val],
}

fn mk(spec: ref Spec, name: ref String, vals: own Vec[Val]) -> Meth {
    let at = *spec.by_name.get(name).unwrap();
    Meth { sp: spec.methods[at].clone(), vals: vals }
}

fn mget(m: ref Meth, field: ref String) -> Val {
    let mut i: i64 = 0;
    while i < m.sp.fields.len() {
        if m.sp.fields[i] == *field {
            return m.vals[i].clone();
        }
        i += 1;
    }
    Val.Nil
}

fn mhas(m: ref Meth, field: ref String) -> bool {
    for f in m.sp.fields.iter() {
        if *f == *field {
            return true;
        }
    }
    false
}

fn mint(m: ref Meth, field: ref String) -> i64 {
    match mget(m, field) {
        Val.Int(n) => n,
        _ => 0,
    }
}

fn mstr(m: ref Meth, field: ref String) -> String {
    py_str(mget(m, field))
}

fn is_meth(m: ref Meth, name: ref String) -> bool {
    m.sp.name == *name
}

fn encode_method(m: ref Meth) -> Result[Vec[u8], PyErr] {
    let mut out: Vec[u8] = Vec.new();
    let mut bits: i64 = 0;
    let mut bit: i64 = 0;
    let mut in_bits = false;
    let mut i: i64 = 0;
    while i < m.sp.kinds.len() {
        let k = m.sp.kinds[i];
        let v = m.vals[i].clone();
        if k == b'B' or k == b'b' {
            if k == b'B' {
                if in_bits {
                    out.push(bits as u8);
                }
                bits = 0;
                bit = 0;
                in_bits = true;
            } else {
                bit += 1;
            }
            if truthy(v) {
                bits = bits | (1 << bit);
            }
            i += 1;
            continue;
        }
        if in_bits {
            out.push(bits as u8);
            in_bits = false;
        }
        if k == b'o' {
            push_be(mut out, val_int(v), 1);
        } else if k == b'h' {
            push_be(mut out, val_int(v), 2);
        } else if k == b'l' {
            push_be(mut out, val_int(v), 4);
        } else if k == b'q' {
            push_be(mut out, val_int(v), 8);
        } else if k == b's' {
            encode_short_string(mut out, v)?;
        } else if k == b'S' {
            let b = as_bytes(v);
            push_be(mut out, b.len(), 4);
            append(mut out, b);
        } else {
            encode_table(mut out, v)?;
        }
        i += 1;
    }
    if in_bits {
        out.push(bits as u8);
    }
    Ok(out)
}

fn val_int(v: ref Val) -> i64 {
    match v {
        Val.Int(n) => *n,
        Val.Bool(b) => if *b { 1 } else { 0 },
        _ => 0,
    }
}

fn decode_method(ms: ref MSpec, b: ref Vec[u8], offset0: i64) -> Result[Meth, PyErr] {
    let mut vals: Vec[Val] = Vec.new();
    let mut offset = offset0;
    let mut bits: i64 = 0;
    let mut bit: i64 = 0;
    let n = b.len();
    for k in ms.kinds.iter() {
        let kind = *k;
        if kind == b'o' {
            need(n, offset, 1)?;
            vals.push(Val.Int(b[offset] as i64));
            offset += 1;
        } else if kind == b'h' {
            need(n, offset, 2)?;
            vals.push(Val.Int(be_u(b, offset, 2)));
            offset += 2;
        } else if kind == b'l' {
            need(n, offset, 4)?;
            vals.push(Val.Int(be_u(b, offset, 4)));
            offset += 4;
        } else if kind == b'q' {
            need(n, offset, 8)?;
            vals.push(Val.Int(be_u(b, offset, 8)));
            offset += 8;
        } else if kind == b's' {
            let (v, o) = decode_short_string(b, offset)?;
            vals.push(v);
            offset = o;
        } else if kind == b'S' {
            // spec.py's str is bytes, so a long string stays bytes
            need(n, offset, 4)?;
            let length = be_u(b, offset, 4);
            offset += 4;
            vals.push(Val.Bytes(slice(b, offset, offset + length)));
            offset += length;
        } else if kind == b'F' {
            let (v, o) = decode_table(b, offset)?;
            vals.push(v);
            offset = o;
        } else if kind == b'B' {
            need(n, offset, 1)?;
            bits = b[offset] as i64;
            offset += 1;
            bit = 0;
            vals.push(Val.Bool((bits & 1) != 0));
        } else {
            bit += 1;
            vals.push(Val.Bool((bits & (1 << bit)) != 0));
        }
    }
    Ok(Meth { sp: ms.clone(), vals: vals })
}

// AMQPObject.__repr__: the attributes that are not None, as "k=v" with v
// formatted by %s, sorted as strings.
fn obj_repr(name: ref String, items: own Vec[String]) -> String {
    if items.len() == 0 {
        return f"<{name}>";
    }
    let mut sorted = items;
    sorted.sort();
    let l = list_repr(sorted);
    f"<{name}({l})>"
}

fn meth_repr(m: ref Meth) -> String {
    let mut items: Vec[String] = Vec.new();
    let mut i: i64 = 0;
    while i < m.sp.fields.len() {
        match m.vals[i] {
            Val.Nil => {}
            _ => {
                items.push(f"{m.sp.fields[i]}={py_str(m.vals[i])}");
            }
        }
        i += 1;
    }
    obj_repr(m.sp.name, items)
}

const PUBLISH: i64 = 3932200;
const RETURN: i64 = 3932210;
const DELIVER: i64 = 3932220;
const GET_OK: i64 = 3932231;

fn has_content(index: i64) -> bool {
    index == PUBLISH or index == RETURN or index == DELIVER or index == GET_OK
}

// BasicProperties: fourteen optional values, None (Nil) when absent.
const PROP_NAMES: Array[Str, 14] = ["content_type", "content_encoding", "headers", "delivery_mode", "priority", "correlation_id", "reply_to", "expiration", "message_id", "timestamp", "type", "user_id", "app_id", "cluster_id"];
const PROP_KINDS: Array[u8, 14] = [b's', b's', b'F', b'o', b'o', b's', b's', b's', b's', b'q', b's', b's', b's', b's'];

#[derive(Clone)]
struct Props {
    vals: Vec[Val],
}

fn no_props() -> Props {
    Props { vals: Vec.filled(14, Val.Nil) }
}

fn prop_at(name: ref String) -> i64 {
    let mut i: i64 = 0;
    while i < 14 {
        if PROP_NAMES[i] == name.as_str() {
            return i;
        }
        i += 1;
    }
    -1
}

fn props_decode(b: ref Vec[u8]) -> Result[Props, PyErr] {
    let mut flags: i64 = 0;
    let mut word: i64 = 0;
    let mut offset: i64 = 0;
    let n = b.len();
    loop {
        need(n, offset, 2)?;
        let partial = be_u(b, offset, 2);
        offset += 2;
        flags = flags | (partial << (word * 16));
        if (partial & 1) == 0 {
            break;
        }
        word += 1;
    }
    let mut p = no_props();
    for i in 0..14 {
        if (flags & (1 << (15 - i))) == 0 {
            continue;
        }
        let k = PROP_KINDS[i];
        if k == b's' {
            let (v, o) = decode_short_string(b, offset)?;
            p.vals[i] = v;
            offset = o;
        } else if k == b'F' {
            let (v, o) = decode_table(b, offset)?;
            p.vals[i] = v;
            offset = o;
        } else if k == b'o' {
            need(n, offset, 1)?;
            p.vals[i] = Val.Int(b[offset] as i64);
            offset += 1;
        } else {
            need(n, offset, 8)?;
            p.vals[i] = Val.Int(be_u(b, offset, 8));
            offset += 8;
        }
    }
    Ok(p)
}

fn props_encode(p: ref Props) -> Result[Vec[u8], PyErr] {
    let mut pieces: Vec[u8] = Vec.new();
    let mut flags: i64 = 0;
    for i in 0..14 {
        let v = p.vals[i].clone();
        match v {
            Val.Nil => {
                continue;
            }
            _ => {}
        }
        flags = flags | (1 << (15 - i));
        let k = PROP_KINDS[i];
        if k == b's' {
            encode_short_string(mut pieces, v)?;
        } else if k == b'F' {
            encode_table(mut pieces, v)?;
        } else if k == b'o' {
            push_be(mut pieces, val_int(v), 1);
        } else {
            push_be(mut pieces, val_int(v), 8);
        }
    }
    let mut out: Vec[u8] = Vec.new();
    loop {
        let rest = flags >> 16;
        let mut partial = flags & 0xFFFE;
        if rest != 0 {
            partial = partial | 1;
        }
        push_be(mut out, partial, 2);
        flags = rest;
        if flags == 0 {
            break;
        }
    }
    append(mut out, pieces);
    Ok(out)
}

fn props_repr(p: ref Props) -> String {
    let mut items: Vec[String] = Vec.new();
    for i in 0..14 {
        match p.vals[i] {
            Val.Nil => {}
            _ => {
                items.push(f"{PROP_NAMES[i]}={py_str(p.vals[i])}");
            }
        }
    }
    obj_repr("BasicProperties", items)
}

// ------------------------------------------------------------ frame.py

#[derive(Clone)]
enum Frame {
    Method(i64, Meth),
    Header(i64, i64, Props),
    Body(i64, Vec[u8]),
    Heartbeat,
    Protocol(i64, i64, i64),
}

// ProtocolHeader(major, minor, revision): a zero takes the version's own
// number (major or 0, minor or 9, revision or 1).
fn protocol_header(major: i64, minor: i64, revision: i64) -> Frame {
    Frame.Protocol(major, if minor == 0 { 9 } else { minor }, if revision == 0 { 1 } else { revision })
}

const FRAME_END: u8 = 206;

fn frame_type(f: ref Frame) -> i64 {
    match f {
        Frame.Method(_, _) => 1,
        Frame.Header(_, _, _) => 2,
        Frame.Body(_, _) => 3,
        Frame.Heartbeat => 8,
        Frame.Protocol(_, _, _) => -1,
    }
}

fn frame_channel(f: ref Frame) -> i64 {
    match f {
        Frame.Method(c, _) => *c,
        Frame.Header(c, _, _) => *c,
        Frame.Body(c, _) => *c,
        _ => 0,
    }
}

fn wrap(kind: i64, ch: i64, payload: ref Vec[u8]) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    push_be(mut out, kind, 1);
    push_be(mut out, ch, 2);
    push_be(mut out, payload.len(), 4);
    append(mut out, payload);
    out.push(FRAME_END);
    out
}

fn marshal(f: ref Frame) -> Result[Vec[u8], PyErr] {
    match f {
        Frame.Method(ch, m) => {
            let mut p: Vec[u8] = Vec.new();
            push_be(mut p, m.sp.index, 4);
            append(mut p, encode_method(m)?);
            Ok(wrap(1, *ch, p))
        }
        Frame.Header(ch, size, props) => {
            let mut p: Vec[u8] = Vec.new();
            push_be(mut p, 60, 2);
            push_be(mut p, 0, 2);
            push_be(mut p, *size, 8);
            append(mut p, props_encode(props)?);
            Ok(wrap(2, *ch, p))
        }
        Frame.Body(ch, frag) => Ok(wrap(3, *ch, frag)),
        Frame.Heartbeat => Ok(wrap(8, 0, Vec.new())),
        Frame.Protocol(major, minor, rev) => {
            let mut out = str_bytes("AMQP");
            out.push(0);
            push_be(mut out, *major, 1);
            push_be(mut out, *minor, 1);
            push_be(mut out, *rev, 1);
            Ok(out)
        }
    }
}

// decode_frame(): the bytes used and the frame, or (0, None) while the
// frame is incomplete.
fn decode_frame(spec: ref Spec, data: ref Vec[u8]) -> Result[(i64, Option[Frame]), PyErr] {
    let n = data.len();
    if n >= 4 and data[0] == b'A' and data[1] == b'M' and data[2] == b'Q' and data[3] == b'P' {
        if n < 8 {
            return Ok((0, None));
        }
        return Ok((8, Some(protocol_header(data[5] as i64, data[6] as i64, data[7] as i64))));
    }
    if n < 7 {
        return Ok((0, None));
    }
    let kind = data[0] as i64;
    let ch = be_u(data, 1, 2);
    let size = be_u(data, 3, 4);
    let end = 7 + size + 1;
    if end > n {
        return Ok((0, None));
    }
    if data[end - 1] != FRAME_END {
        return Err(invalid_frame("Invalid FRAME_END marker"));
    }
    let body = slice(data, 7, end - 1);
    if kind == 1 {
        need(body.len(), 0, 4)?;
        let id = be_u(body, 0, 4);
        let at = match spec.by_index.get(id) {
            Some(a) => *a,
            None => {
                return Err(key_error(id));
            }
        };
        let m = decode_method(spec.methods[at], body, 4)?;
        return Ok((end, Some(Frame.Method(ch, m))));
    }
    if kind == 2 {
        need(body.len(), 0, 12)?;
        let class_id = be_u(body, 0, 2);
        let body_size = be_u(body, 4, 8);
        if class_id != 60 {
            return Err(key_error(class_id));
        }
        let props = props_decode(slice(body, 12, body.len()))?;
        return Ok((end, Some(Frame.Header(ch, body_size, props))));
    }
    if kind == 3 {
        return Ok((end, Some(Frame.Body(ch, body))));
    }
    if kind == 8 {
        return Ok((end, Some(Frame.Heartbeat)));
    }
    Err(invalid_frame(f"Unknown frame type: {kind}"))
}

fn frame_repr(f: ref Frame) -> String {
    match f {
        Frame.Method(ch, m) => obj_repr("METHOD", vec![f"channel_number={ch}", "frame_type=1".to_string(), f"method={meth_repr(m)}"]),
        Frame.Header(ch, size, p) => obj_repr("Header", vec![f"body_size={size}", f"channel_number={ch}", "frame_type=2".to_string(), f"properties={props_repr(p)}"]),
        Frame.Body(ch, frag) => obj_repr("Body", vec![f"channel_number={ch}", f"fragment={bytes_repr(frag)}", "frame_type=3".to_string()]),
        Frame.Heartbeat => obj_repr("Heartbeat", vec!["channel_number=0".to_string(), "frame_type=8".to_string()]),
        Frame.Protocol(a, b, c) => obj_repr("ProtocolHeader", vec!["frame_type=-1".to_string(), f"major={a}", f"minor={b}", f"revision={c}"]),
    }
}

// ------------------------------------------------------------ URLParameters

#[derive(Clone)]
enum Cred {
    Plain(String, String),
    External,
}

// The Parameters slots this port keeps. ssl stands for ssl_options: pika
// builds an SSLContext for amqps, which only matters for a socket.
#[derive(Clone)]
struct Params {
    host: String,
    port: i64,
    vhost: String,
    cred: Cred,
    ssl: bool,
    heartbeat: Option[i64],
    frame_max: i64,
    channel_max: i64,
    locale: String,
    attempts: i64,
    retry_delay: f64,
    socket_timeout: Option[f64],
    stack_timeout: Option[f64],
    blocked_timeout: Option[f64],
    client_properties: Val,
}

const FRAME_MIN_SIZE: i64 = 4096;
const FRAME_MAX_SIZE: i64 = 131072;
const MAX_CHANNELS: i64 = 65535;

fn default_params() -> Params {
    Params {
        host: "localhost".to_string(),
        port: 5672,
        vhost: "/".to_string(),
        cred: Cred.Plain("guest".to_string(), "guest".to_string()),
        ssl: false,
        heartbeat: None,
        frame_max: FRAME_MAX_SIZE,
        channel_max: MAX_CHANNELS,
        locale: "en_US".to_string(),
        attempts: 1,
        retry_delay: 2.0,
        socket_timeout: Some(10.0),
        stack_timeout: Some(15.0),
        blocked_timeout: None,
        client_properties: Val.Nil,
    }
}

// the setters' checks
fn set_channel_max(p: mut ref Params, v: i64) -> Result[(), PyErr] {
    if v < 1 or v > MAX_CHANNELS {
        return Err(value_error(f"channel_max must be <= {MAX_CHANNELS} and > 0, but got {v}"));
    }
    p.channel_max = v;
    Ok(())
}

fn set_frame_max(p: mut ref Params, v: i64) -> Result[(), PyErr] {
    if v < FRAME_MIN_SIZE {
        return Err(value_error(f"Min AMQP 0.9.1 Frame Size is {FRAME_MIN_SIZE}, but got {v}"));
    }
    if v > FRAME_MAX_SIZE {
        return Err(value_error(f"Max AMQP 0.9.1 Frame Size is {FRAME_MAX_SIZE}, but got {v}"));
    }
    p.frame_max = v;
    Ok(())
}

fn set_heartbeat(p: mut ref Params, v: Option[i64]) -> Result[(), PyErr] {
    match v {
        Some(n) => {
            if n < 0 {
                return Err(value_error(f"heartbeat must >= 0, but got {n}"));
            }
        }
        None => {}
    }
    p.heartbeat = v;
    Ok(())
}

fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    f"{x}"
}

fn opt_float_repr(x: ref Option[f64]) -> String {
    match x {
        Some(v) => float_repr(*v),
        None => "None".to_string(),
    }
}

// The scheme, netloc, path, params, query and fragment urlparse() splits.
struct UrlParts {
    scheme: String,
    netloc: String,
    path: String,
    params: String,
    query: String,
    fragment: String,
}

fn is_scheme_char(c: char) -> bool {
    c.is_ascii_alphanumeric() or c == '+' or c == '-' or c == '.'
}

const USES_PARAMS: Array[Str, 16] = ["", "ftp", "hdl", "prospero", "http", "imap", "https", "shttp", "rtsp", "rtsps", "rtspu", "sip", "sips", "mms", "sftp", "tel"];

fn invalid_ipv6() -> PyErr {
    value_error("Invalid IPv6 URL")
}

fn ipv4_ok(s: ref String) -> bool {
    let parts = split_on(s, '.');
    if parts.len() != 4 {
        return false;
    }
    for p in parts.iter() {
        if p.len() == 0 or p.len() > 3 or (p.len() > 1 and p.starts_with("0")) {
            return false;
        }
        for c in p.chars() {
            if not c.is_ascii_digit() {
                return false;
            }
        }
        if parse_int(p) > 255 {
            return false;
        }
    }
    true
}

fn hex_group_ok(g: ref String) -> bool {
    if g.len() == 0 or g.len() > 4 {
        return false;
    }
    for c in g.chars() {
        if not c.is_ascii_hexdigit() {
            return false;
        }
    }
    true
}

// ipaddress.IPv6Address's grammar, scope id included.
fn ipv6_ok(s0: ref String) -> bool {
    let (s, _, _) = partition(s0, "%");
    let (head, has_gap, tail) = partition(s, "::");
    if has_gap and tail.contains("::") {
        return false;
    }
    let mut groups: Vec[String] = Vec.new();
    if head.len() > 0 {
        for g in split_on(head, ':').iter() {
            groups.push(g.clone());
        }
    }
    let mut after: Vec[String] = Vec.new();
    if has_gap and tail.len() > 0 {
        for g in split_on(tail, ':').iter() {
            after.push(g.clone());
        }
    }
    let mut count: i64 = 0;
    let total = groups.len() + after.len();
    let mut i: i64 = 0;
    for g in groups.iter().chain(after.iter()) {
        i += 1;
        if i == total and g.contains(".") {
            if not ipv4_ok(g) {
                return false;
            }
            count += 2;
        } else {
            if not hex_group_ok(g) {
                return false;
            }
            count += 1;
        }
    }
    if has_gap { count < 8 } else { count == 8 }
}

fn check_bracketed_netloc(netloc: ref String) -> Result[(), PyErr] {
    let (_, _, hostport) = rpartition(netloc, "@");
    let (before, have, bracketed) = partition(hostport, "[");
    let mut hostname = String.new();
    if have {
        if before.len() > 0 {
            return Err(invalid_ipv6());
        }
        let (h, _, port) = partition(bracketed, "]");
        if port.len() > 0 and not port.starts_with(":") {
            return Err(invalid_ipv6());
        }
        hostname = h;
    } else {
        let (h, _, _) = partition(hostport, ":");
        hostname = h;
    }
    if hostname.starts_with("v") {
        // \Av[a-fA-F0-9]+\..+\z
        let cs: Vec[char] = hostname.chars().collect();
        let mut i: i64 = 1;
        while i < cs.len() and cs[i].is_ascii_hexdigit() {
            i += 1;
        }
        if i == 1 or i >= cs.len() or cs[i] != '.' or i + 1 >= cs.len() {
            return Err(value_error("IPvFuture address is invalid"));
        }
        return Ok(());
    }
    if ipv4_ok(hostname) {
        return Err(value_error("An IPv4 address cannot be in brackets"));
    }
    if not ipv6_ok(hostname) {
        let r = str_repr(hostname);
        return Err(value_error(f"{r} does not appear to be an IPv4 or IPv6 address"));
    }
    Ok(())
}

// urllib.parse.urlparse
fn urlparse(url0: ref String) -> Result[UrlParts, PyErr] {
    let mut url = String.new();
    let mut leading = true;
    for c in url0.chars() {
        let cp = c as u32;
        if leading and cp <= 32 {
            continue;
        }
        leading = false;
        if c == '\t' or c == '\r' or c == '\n' {
            continue;
        }
        url.push(c);
    }
    let mut scheme = String.new();
    match url.find(":") {
        Some(i) => {
            let first = url.chars().next().unwrap();
            if i > 0 and first.is_ascii() and first.is_alphabetic() {
                let head = url.substring(0, i);
                let mut ok = true;
                for c in head.chars() {
                    if not is_scheme_char(c) {
                        ok = false;
                        break;
                    }
                }
                if ok {
                    scheme = head.to_lowercase();
                    url = url.substring(i + 1, url.len());
                }
            }
        }
        None => {}
    }
    let mut netloc = String.new();
    if url.starts_with("//") {
        let mut delim = url.len();
        for d in ["/", "?", "#"] {
            match url.substring(2, url.len()).find(d) {
                Some(w) => {
                    if w + 2 < delim {
                        delim = w + 2;
                    }
                }
                None => {}
            }
        }
        netloc = url.substring(2, delim);
        url = url.substring(delim, url.len());
        let open = netloc.contains("[");
        let close = netloc.contains("]");
        if (open and not close) or (close and not open) {
            return Err(invalid_ipv6());
        }
        if open and close {
            check_bracketed_netloc(netloc)?;
        }
    }
    let mut fragment = String.new();
    let mut query = String.new();
    match url.find("#") {
        Some(i) => {
            fragment = url.substring(i + 1, url.len());
            url = url.substring(0, i);
        }
        None => {}
    }
    match url.find("?") {
        Some(i) => {
            query = url.substring(i + 1, url.len());
            url = url.substring(0, i);
        }
        None => {}
    }
    let mut params = String.new();
    let mut uses = false;
    for s in USES_PARAMS {
        if scheme.as_str() == s {
            uses = true;
        }
    }
    if uses and url.contains(";") {
        let cut = match url.rfind("/") {
            Some(slash) => match url.substring(slash, url.len()).find(";") {
                Some(j) => slash + j,
                None => -1,
            },
            None => url.find(";").unwrap(),
        };
        if cut >= 0 {
            params = url.substring(cut + 1, url.len());
            url = url.substring(0, cut);
        }
    }
    Ok(UrlParts { scheme: scheme, netloc: netloc, path: url, params: params, query: query, fragment: fragment })
}

// ParseResult.username and .password
fn userinfo(u: ref UrlParts) -> (Option[String], Option[String]) {
    let (info, have, _) = rpartition(u.netloc, "@");
    if not have {
        return (None, None);
    }
    let (user, have_pw, pw) = partition(info, ":");
    (Some(user), if have_pw { Some(pw) } else { None })
}

// ParseResult._hostinfo
fn hostinfo(u: ref UrlParts) -> (String, Option[String]) {
    let (_, _, host) = rpartition(u.netloc, "@");
    let (_, have_open, bracketed) = partition(host, "[");
    let mut hostname = String.new();
    let mut port = String.new();
    if have_open {
        let (h, _, rest) = partition(bracketed, "]");
        let (_, _, p) = partition(rest, ":");
        hostname = h;
        port = p;
    } else {
        let (h, _, p) = partition(host, ":");
        hostname = h;
        port = p;
    }
    (hostname, if port.len() == 0 { None } else { Some(port) })
}

fn url_hostname(u: ref UrlParts) -> Option[String] {
    let (h, _) = hostinfo(u);
    if h.len() == 0 {
        return None;
    }
    let (name, pct, zone) = partition(h, "%");
    Some(if pct { f"{name.to_lowercase()}%{zone}" } else { name.to_lowercase() })
}

fn url_port(u: ref UrlParts) -> Result[Option[i64], PyErr] {
    let (_, port) = hostinfo(u);
    match port {
        Some(p) => {
            let mut digits = true;
            for c in p.chars() {
                if not c.is_ascii_digit() {
                    digits = false;
                }
            }
            if not digits {
                let r = str_repr(p);
                return Err(value_error(f"Port could not be cast to integer value as {r}"));
            }
            let mut n: i64 = 0;
            for c in p.chars() {
                n = n * 10 + ((c as u32) - 48) as i64;
                if n > 100000 {
                    n = 100000;
                }
            }
            if n > 65535 {
                return Err(value_error("Port out of range 0-65535"));
            }
            Ok(Some(n))
        }
        None => Ok(None),
    }
}

// urllib.parse.unquote: %xx escapes in each ASCII run, decoded as UTF-8
// with errors='replace'. None is the TypeError "'%' not in None" raises.
fn unquote(s: ref Option[String]) -> Result[String, PyErr] {
    let text = match s {
        Some(t) => t.clone(),
        None => {
            return Err(type_error("argument of type 'NoneType' is not iterable"));
        }
    };
    if not text.contains("%") {
        return Ok(text);
    }
    let mut out = String.new();
    let mut run = String.new();
    for c in text.chars() {
        if c.is_ascii() {
            run.push(c);
        } else {
            if run.len() > 0 {
                out.push_str(unquote_run(run));
                run = String.new();
            }
            out.push(c);
        }
    }
    if run.len() > 0 {
        out.push_str(unquote_run(run));
    }
    Ok(out)
}

fn unquote_run(s: ref String) -> String {
    let bits = split_on(s, '%');
    let mut res = str_bytes(bits[0]);
    let mut i: i64 = 1;
    while i < bits.len() {
        let item = str_bytes(bits[i]);
        if item.len() >= 2 and is_hex(item[0]) and is_hex(item[1]) {
            res.push((hex_val(item[0]) * 16 + hex_val(item[1])) as u8);
            append(mut res, slice(item, 2, item.len()));
        } else {
            res.push(b'%');
            append(mut res, item);
        }
        i += 1;
    }
    utf8_replace(res)
}

fn unquote_plus(s: ref String) -> String {
    unquote(Some(s.replace("+", " "))).unwrap()
}

// parse_qs(): the names in first-seen order, each with its values. Blank
// values and fields without "=" are dropped; only & separates.
fn parse_qs(qs: ref String) -> Vec[(String, Vec[String])] {
    let mut out: Vec[(String, Vec[String])] = Vec.new();
    if qs.len() == 0 {
        return out;
    }
    for field in split_on(qs, '&').iter() {
        if field.len() == 0 {
            continue;
        }
        let (name, _, value) = partition(field, "=");
        if value.len() == 0 {
            continue;
        }
        let n = unquote_plus(name);
        let v = unquote_plus(value);
        let mut found = false;
        let mut i: i64 = 0;
        while i < out.len() {
            if out[i].0 == n {
                out[i].1.push(v.clone());
                found = true;
                break;
            }
            i += 1;
        }
        if not found {
            out.push((n, vec![v]));
        }
    }
    out
}

fn py_strip(s: ref String) -> String {
    s.trim().to_string()
}

// digit ('_'? digit)*
fn digit_part(cs: ref Vec[char], i0: i64) -> i64 {
    let mut i = i0;
    if i >= cs.len() or not cs[i].is_ascii_digit() {
        return i0;
    }
    i += 1;
    while i < cs.len() {
        if cs[i].is_ascii_digit() {
            i += 1;
        } else if cs[i] == '_' and i + 1 < cs.len() and cs[i + 1].is_ascii_digit() {
            i += 2;
        } else {
            break;
        }
    }
    i
}

// int(s), base 10
fn py_int(s: ref String) -> Result[i64, PyErr] {
    let t = py_strip(s);
    let cs: Vec[char] = t.chars().collect();
    let mut i: i64 = 0;
    let mut neg = false;
    if cs.len() > 0 and (cs[0] == '+' or cs[0] == '-') {
        neg = cs[0] == '-';
        i = 1;
    }
    let end = digit_part(cs, i);
    if end == i or end != cs.len() {
        let r = str_repr(s);
        return Err(value_error(f"invalid literal for int() with base 10: {r}"));
    }
    let mut v: i64 = 0;
    while i < end {
        if cs[i] != '_' {
            v = v * 10 + ((cs[i] as u32) - 48) as i64;
        }
        i += 1;
    }
    Ok(if neg { -v } else { v })
}

// float(s)
fn py_float(s: ref String) -> Result[f64, PyErr] {
    let t = py_strip(s);
    let bad = value_error(f"could not convert string to float: {str_repr(s)}");
    let cs: Vec[char] = t.chars().collect();
    let mut i: i64 = 0;
    if cs.len() > 0 and (cs[0] == '+' or cs[0] == '-') {
        i = 1;
    }
    let word = t.substring(i, t.len()).to_lowercase();
    if word == "inf" or word == "infinity" or word == "nan" {
        return match f64.parse(t.as_str()) {
            Ok(v) => Ok(v),
            Err(_) => Err(bad),
        };
    }
    let a = digit_part(cs, i);
    let mut j = a;
    let mut any = a > i;
    if j < cs.len() and cs[j] == '.' {
        let b = digit_part(cs, j + 1);
        any = any or b > j + 1;
        j = b;
    }
    if not any {
        return Err(bad);
    }
    if j < cs.len() and (cs[j] == 'e' or cs[j] == 'E') {
        let mut k = j + 1;
        if k < cs.len() and (cs[k] == '+' or cs[k] == '-') {
            k += 1;
        }
        let e = digit_part(cs, k);
        if e == k {
            return Err(bad);
        }
        j = e;
    }
    if j != cs.len() {
        return Err(bad);
    }
    let clean = t.replace("_", "");
    match f64.parse(clean.as_str()) {
        Ok(v) => Ok(v),
        Err(_) => Err(bad),
    }
}

// "Invalid <name> value 'x': ValueError(...)"
fn invalid_value(name: ref String, value: ref String, e: ref PyErr) -> PyErr {
    let r = str_repr(value);
    value_error(f"Invalid {name} value {r}: {e.repr}")
}

fn url_int(name: ref String, value: ref String) -> Result[i64, PyErr] {
    match py_int(value) {
        Ok(n) => Ok(n),
        Err(e) => Err(invalid_value(name, value, e)),
    }
}

fn url_float(name: ref String, value: ref String) -> Result[f64, PyErr] {
    match py_float(value) {
        Ok(x) => Ok(x),
        Err(e) => Err(invalid_value(name, value, e)),
    }
}

// a timeout setter: None, or a number above zero, stored as a float
fn positive_timeout(name: ref String, x: f64) -> Result[f64, PyErr] {
    if x <= 0.0 {
        return Err(value_error(f"{name} must be > 0, but got {float_repr(x)}"));
    }
    Ok(x)
}

// URLParameters._set_url_<name>
fn set_url_value(p: mut ref Params, name: ref String, value: ref String) -> Result[(), PyErr] {
    if name == "blocked_connection_timeout" {
        let x = url_float(name, value)?;
        if x < 0.0 {
            return Err(value_error(f"blocked_connection_timeout must be >= 0, but got {float_repr(x)}"));
        }
        p.blocked_timeout = Some(x);
    } else if name == "channel_max" {
        let n = url_int(name, value)?;
        set_channel_max(mut p, n)?;
    } else if name == "connection_attempts" {
        let n = url_int(name, value)?;
        if n < 1 {
            return Err(value_error(f"connection_attempts must be > 0, but got {n}"));
        }
        p.attempts = n;
    } else if name == "frame_max" {
        let n = url_int(name, value)?;
        set_frame_max(mut p, n)?;
    } else if name == "heartbeat" {
        let n = url_int(name, value)?;
        set_heartbeat(mut p, Some(n))?;
    } else if name == "locale" {
        p.locale = value.clone();
    } else if name == "retry_delay" {
        p.retry_delay = url_float(name, value)?;
    } else if name == "socket_timeout" {
        let x = url_float(name, value)?;
        p.socket_timeout = Some(positive_timeout(name, x)?);
    } else if name == "stack_timeout" {
        let x = url_float(name, value)?;
        p.stack_timeout = Some(positive_timeout(name, x)?);
    } else {
        // client_properties, ssl_options and tcp_options take a Python
        // literal (ast.literal_eval), which this port does not read
        return Err(value_error(f"URL parameter {name} is not supported by this port"));
    }
    Ok(())
}

const URL_SETTERS: Array[Str, 12] = ["blocked_connection_timeout", "channel_max", "client_properties", "connection_attempts", "frame_max", "heartbeat", "locale", "retry_delay", "socket_timeout", "stack_timeout", "ssl_options", "tcp_options"];

fn url_parameters(url0: ref String) -> Result[Params, PyErr] {
    let mut p = default_params();
    let mut url = url0.clone();
    if url.substring(0, if url.len() < 4 { url.len() } else { 4 }).to_lowercase() == "amqp" {
        url = f"http{url.substring(4, url.len())}";
    }
    let parts = urlparse(url)?;
    if parts.scheme == "https" {
        p.ssl = true;
    } else if parts.scheme == "http" {
        p.ssl = false;
    } else if parts.scheme.len() > 0 {
        let r = str_repr(parts.scheme);
        return Err(value_error(f"Unexpected URL scheme {r}; supported scheme values: amqp, amqps"));
    }
    match url_hostname(parts) {
        Some(h) => {
            p.host = h;
        }
        None => {}
    }
    match url_port(parts)? {
        Some(n) => {
            p.port = n;
        }
        None => {
            p.port = if p.ssl { 5671 } else { 5672 };
        }
    }
    let (user, password) = userinfo(parts);
    match user {
        Some(_) => {
            let u = unquote(user)?;
            let pw = unquote(password)?;
            p.cred = Cred.Plain(u, pw);
        }
        None => {}
    }
    if parts.path.len() > 1 {
        let segs = split_on(parts.path, '/');
        p.vhost = unquote(Some(segs[1].clone()))?;
    }
    for (name, values) in parse_qs(parts.query).iter() {
        let mut known = false;
        for s in URL_SETTERS {
            if name.as_str() == s {
                known = true;
            }
        }
        if not known {
            let r = str_repr(name);
            return Err(value_error(f"Unknown URL parameter: {r}"));
        }
        if values.len() != 1 {
            let n = values.len();
            let l = list_repr(values);
            return Err(value_error(f"Expected exactly one value for URL parameter {name}, but got {n} values: {l}"));
        }
        set_url_value(mut p, name, values[0])?;
    }
    Ok(p)
}

fn show_params(p: ref Params) -> String {
    let who = match p.cred {
        Cred.Plain(u, pw) => f"user={str_repr(u)} password={str_repr(pw)}",
        Cred.External => "credentials=EXTERNAL".to_string(),
    };
    let hb = match p.heartbeat {
        Some(n) => f"{n}",
        None => "None".to_string(),
    };
    f"host={str_repr(p.host)} port={p.port} vhost={str_repr(p.vhost)} {who} ssl={py_bool(p.ssl)} heartbeat={hb} frame_max={p.frame_max} channel_max={p.channel_max} locale={str_repr(p.locale)} attempts={p.attempts} retry_delay={float_repr(p.retry_delay)} socket_timeout={opt_float_repr(p.socket_timeout)} stack_timeout={opt_float_repr(p.stack_timeout)} blocked_timeout={opt_float_repr(p.blocked_timeout)}"
}

fn url_job() {
    println("# URLParameters");
    for url in lines_of(urls_text()).iter() {
        let u = unesc(url);
        println(u);
        match url_parameters(u) {
            Ok(p) => println(f"  {show_params(p)}"),
            Err(e) => println(f"  {e.cls}: {e.msg}"),
        }
    }
}

// ------------------------------------------------------------ callback.py

// What a callback is. pika registers bound methods and functools.partial
// objects; two callbacks are the same when they are the same method of
// the same object, so the channel methods carry their channel's number
// and each partial its own serial.
#[derive(Clone, PartialEq)]
enum Cb {
    ConnStart,
    ConnTune,
    ConnOpenOk,
    ConnCloseOk,
    ConnCloseFromBroker,
    ConnBlocked(i64),
    ConnUnblocked(i64),
    ChannelCleanup,
    SyncComplete(i64),
    OpenOk(i64),
    GetEmpty(i64),
    Cancel(i64),
    Flow(i64),
    CloseFromBroker(i64),
    CancelOk(i64),
    EventOk(i64),
    CloseOk(i64),
    AppOpen,
    AppOpenError,
    AppClosed,
    AppBlocked(i64),
    AppUnblocked(i64),
    AppChannelClosed,
    AppReturn,
    AppCancelled,
    AppDeclared,
    AppConfirmsOn,
    AppConfirm,
}

// The arguments CallbackManager.process() passes on.
#[derive(Clone)]
enum CbArg {
    Frame(Frame),
    Conn,
    ConnErr(PyErr),
    Chan(i64),
    ChanErr(i64, PyErr),
    Returned(i64, Meth, Props, Vec[u8]),
}

// One callback dict: prefix (a channel number as a string), key (a method
// name or one of pika's event names), the callback, one_shot and its use
// count, only_caller (a channel number, or -1) and arguments (one
// attribute the method must have, with its value).
#[derive(Clone)]
struct CbEntry {
    id: i64,
    prefix: String,
    key: String,
    cb: Cb,
    one_shot: bool,
    calls: i64,
    only: i64,
    args: Option[(String, String)],
}

fn same_args(a: ref Option[(String, String)], b: ref Option[(String, String)]) -> bool {
    match (a, b) {
        (None, None) => true,
        (Some(x), Some(y)) => x.0 == y.0 and x.1 == y.1,
        _ => false,
    }
}

fn cb_add(c: mut ref Conn, prefix: i64, key: ref String, cb: own Cb, one_shot: bool, only: i64, args: own Option[(String, String)]) {
    let p = f"{prefix}";
    let mut i: i64 = 0;
    while i < c.cbs.len() {
        let e = c.cbs[i].clone();
        if e.prefix == p and e.key == *key and e.cb == cb and same_args(e.args, args) and e.only == only {
            if e.one_shot {
                c.cbs[i].calls += 1;
            }
            return;
        }
        i += 1;
    }
    c.next_cb += 1;
    c.cbs.push(CbEntry { id: c.next_cb, prefix: p, key: key.clone(), cb: cb, one_shot: one_shot, calls: 1, only: only, args: args });
}

fn cb_pending(c: ref Conn, prefix: i64, key: ref String) -> i64 {
    let p = f"{prefix}";
    let mut n: i64 = 0;
    for e in c.cbs.iter() {
        if e.prefix == p and e.key == *key {
            n += 1;
        }
    }
    n
}

// _arguments_match(): a method frame matches when its method has the
// attribute with that value; nothing else ever does.
fn args_match(e: ref CbEntry, arg: ref CbArg) -> bool {
    match e.args {
        None => true,
        Some(want) => match arg {
            CbArg.Frame(f) => match f {
                Frame.Method(_, m) => mhas(m, want.0) and val_eq(mget(m, want.0), vstr(want.1)),
                _ => false,
            },
            _ => false,
        },
    }
}

// remove(): every callback equal to cb whose arguments match the ones
// given; a callback registered without arguments matches any.
fn cb_remove(c: mut ref Conn, prefix: ref String, key: ref String, cb: ref Cb, args: ref Option[(String, String)]) {
    let mut kept: Vec[CbEntry] = Vec.new();
    for e in c.cbs.iter() {
        let mut drop = false;
        if e.prefix == *prefix and e.key == *key and e.cb == *cb {
            drop = match e.args {
                None => true,
                Some(want) => match args {
                    Some(given) => want.0 == given.0 and want.1 == given.1,
                    None => false,
                },
            };
        }
        if not drop {
            kept.push(e.clone());
        }
    }
    c.cbs = kept;
}

fn cb_cleanup(c: mut ref Conn, prefix: i64) {
    let p = f"{prefix}";
    let mut kept: Vec[CbEntry] = Vec.new();
    for e in c.cbs.iter() {
        if e.prefix != p {
            kept.push(e.clone());
        }
    }
    c.cbs = kept;
}

// process(): every callback registered for (prefix, key) whose arguments
// and caller match is called, in order; a one-shot callback is used up
// before any of them runs. False when nothing is registered there.
#[allow(mutual_recursion_note)]
fn cb_process(c: mut ref Conn, prefix: i64, key: ref String, caller: i64, arg: ref CbArg) -> Result[bool, PyErr] {
    let p = f"{prefix}";
    let mut snapshot: Vec[CbEntry] = Vec.new();
    for e in c.cbs.iter() {
        if e.prefix == p and e.key == *key {
            snapshot.push(e.clone());
        }
    }
    if snapshot.len() == 0 {
        return Ok(false);
    }
    let mut calls: Vec[Cb] = Vec.new();
    for e in snapshot.iter() {
        if not args_match(e, arg) {
            continue;
        }
        if e.only >= 0 and e.only != caller {
            continue;
        }
        calls.push(e.cb.clone());
        if e.one_shot {
            let mut left = e.calls - 1;
            let mut i: i64 = 0;
            while i < c.cbs.len() {
                if c.cbs[i].id == e.id {
                    c.cbs[i].calls -= 1;
                    left = c.cbs[i].calls;
                }
                i += 1;
            }
            if left <= 0 {
                cb_remove(mut c, p, key, e.cb, e.args);
            }
        }
    }
    for cb in calls.iter() {
        invoke(mut c, cb, arg)?;
    }
    Ok(true)
}

// ------------------------------------------------------------ the connection

const CONNECTION_CLOSED: i64 = 0;
const CONNECTION_INIT: i64 = 1;
const CONNECTION_PROTOCOL: i64 = 2;
const CONNECTION_START: i64 = 3;
const CONNECTION_TUNE: i64 = 4;
const CONNECTION_OPEN: i64 = 5;
const CONNECTION_CLOSING: i64 = 6;

const CHANNEL_CLOSED: i64 = 0;
const CHANNEL_OPENING: i64 = 1;
const CHANNEL_OPEN: i64 = 2;
const CHANNEL_CLOSING: i64 = 3;

#[derive(Clone)]
enum Tmr {
    HeartbeatSend,
    HeartbeatCheck,
    BlockedTimeout,
}

#[derive(Clone)]
struct Timer {
    due: i64,
    seq: i64,
    what: Tmr,
}

// heartbeat.HeartbeatChecker
#[derive(Clone)]
struct Hb {
    timeout: i64,
    send_ms: i64,
    check_ms: i64,
    bytes_received: i64,
    bytes_sent: i64,
    received: i64,
    sent: i64,
    idle: i64,
    send_timer: Option[i64],
    check_timer: Option[i64],
}

// A channel's _rpc() call waiting in its _blocked queue.
#[derive(Clone)]
struct Rpc {
    method: Meth,
    cb: Option[Cb],
    replies: Vec[(String, Option[(String, String)])],
}

// channel.Channel, with its ContentFrameAssembler. Every consumer here
// has the client program's on_message as its callback, so the consumers
// dict is its tags in insertion order. A channel the connection has let
// go of (live false) stays here, as the client program still holds it.
#[derive(Clone)]
struct Chan {
    n: i64,
    live: bool,
    state: i64,
    blocked: Vec[Rpc],
    blocking: Option[String],
    has_on_flow: bool,
    cancelled: Vec[String],
    consumers: Vec[String],
    noack: Vec[String],
    on_openok: bool,
    reason: Option[PyErr],
    asm_method: Option[Meth],
    asm_header: Option[(i64, Props)],
    seen: i64,
    frags: Vec[u8],
}

// A message the client program publishes.
#[derive(Clone)]
struct Pub {
    exchange: String,
    key: String,
    mandatory: bool,
    props: Props,
    body: Vec[u8],
}

// One session of the capture.
#[derive(Clone)]
struct Session {
    name: String,
    url: String,
    client: Val,
    external: bool,
    queue: String,
    prefetch: i64,
    tag: String,
    close_after: i64,
    publish: Vec[Pub],
    recv: Vec[(i64, Vec[u8])],
    end: i64,
}

// The client program's own state.
struct App {
    cfg: Session,
    channel: i64,
    next_tag: i64,
    unconfirmed: Vec[i64],
    delivered: i64,
}

// connection.Connection with the replay as its adapter: the transport is
// the capture, the clock is the capture's (milliseconds), and the tap
// counts and prints every frame each way.
struct Conn {
    spec: Spec,
    crc: Vec[i64],
    params: Params,
    state: i64,
    opened: bool,
    error: Option[PyErr],
    blocked_timer: Option[i64],
    hb: Option[Hb],
    cbs: Vec[CbEntry],
    next_cb: i64,
    partials: i64,
    server_properties: Val,
    server_capabilities: Val,
    body_max: i64,
    known_hosts: Val,
    buffer: Vec[u8],
    chans: Vec[Chan],
    bytes_sent: i64,
    bytes_received: i64,
    frames_sent: i64,
    frames_received: i64,
    now: i64,
    timers: Vec[Timer],
    timer_seq: i64,
    dropped: bool,
    tap_in_frames: i64,
    tap_in_bytes: i64,
    tap_out_frames: i64,
    tap_out_bytes: i64,
    app: App,
}

fn log(c: ref Conn, text: ref String) {
    println(f"{pad7(c.now)} {text}");
}

fn show_frame(c: ref Conn, f: ref Frame, data: ref Option[Vec[u8]]) -> String {
    match f {
        Frame.Body(ch, frag) => {
            let n = frag.len();
            return f"body ch{ch} {n} bytes crc {hex8(crc32(c.crc, frag))}";
        }
        _ => {}
    }
    let text = frame_repr(f);
    match data {
        Some(d) => {
            let n = d.len();
            f"{text} [{n} bytes crc {hex8(crc32(c.crc, d))}]"
        }
        None => text,
    }
}

// the adapter

fn call_later(c: mut ref Conn, ms: i64, what: own Tmr) -> i64 {
    c.timer_seq += 1;
    c.timers.push(Timer { due: c.now + ms, seq: c.timer_seq, what: what });
    c.timer_seq
}

fn remove_timeout(c: mut ref Conn, id: i64) {
    let mut kept: Vec[Timer] = Vec.new();
    for t in c.timers.iter() {
        if t.seq != id {
            kept.push(t.clone());
        }
    }
    c.timers = kept;
}

fn emit(c: mut ref Conn, data: ref Vec[u8]) {
    c.tap_out_frames += 1;
    c.tap_out_bytes += data.len();
    let shown = match decode_frame(c.spec, data) {
        Ok((_, Some(f))) => show_frame(c, f, Some(data.clone())),
        _ => "?".to_string(),
    };
    log(c, f"> {shown}");
}

fn output(c: mut ref Conn, frames: ref Vec[Vec[u8]]) {
    for d in frames.iter() {
        c.bytes_sent += d.len();
        c.frames_sent += 1;
        emit(mut c, d);
    }
}

fn wrong_state(msg: ref String) -> PyErr {
    conn_err("ConnectionWrongStateError", msg)
}

fn send_frame(c: mut ref Conn, f: ref Frame) -> Result[(), PyErr] {
    if c.state == CONNECTION_CLOSED {
        return Err(wrong_state("Attempted to send a frame on closed connection."));
    }
    let d = marshal(f)?;
    output(mut c, vec![d]);
    Ok(())
}

fn send_method(c: mut ref Conn, ch: i64, m: ref Meth, content: Option[(Props, Vec[u8])]) -> Result[(), PyErr] {
    match content {
        Some((props, body)) => send_message(mut c, ch, m, props, body),
        None => send_frame(mut c, Frame.Method(ch, m.clone())),
    }
}

// The method, its content header and the body in frames of at most
// frame_max - 8 bytes, all marshaled before any is sent.
fn send_message(c: mut ref Conn, ch: i64, m: ref Meth, props: ref Props, body: ref Vec[u8]) -> Result[(), PyErr] {
    let length = body.len();
    let mut frames: Vec[Vec[u8]] = Vec.new();
    frames.push(marshal(Frame.Method(ch, m.clone()))?);
    frames.push(marshal(Frame.Header(ch, length, props.clone()))?);
    if length > 0 {
        let chunks = (length + c.body_max - 1) / c.body_max;
        for k in 0..chunks {
            let start = k * c.body_max;
            let mut end = start + c.body_max;
            if end > length {
                end = length;
            }
            frames.push(marshal(Frame.Body(ch, slice(body, start, end)))?);
        }
    }
    output(mut c, frames);
    Ok(())
}

fn conn_rpc(c: mut ref Conn, ch: i64, m: ref Meth, cb: Option[Cb], replies: Vec[Str]) -> Result[(), PyErr] {
    match cb {
        Some(f) => {
            for r in replies {
                cb_add(mut c, ch, r.to_string(), f.clone(), true, -1, None);
            }
        }
        None => {}
    }
    send_method(mut c, ch, m, None)
}

fn meth(c: ref Conn, name: ref String, vals: own Vec[Val]) -> Meth {
    mk(c.spec, name, vals)
}

fn conn_new(spec: own Spec, params: own Params, cfg: own Session) -> Conn {
    let mut c = Conn {
        spec: spec,
        crc: crc_table(),
        params: params,
        state: CONNECTION_CLOSED,
        opened: false,
        error: None,
        blocked_timer: None,
        hb: None,
        cbs: Vec.new(),
        next_cb: 0,
        partials: 0,
        server_properties: Val.Nil,
        server_capabilities: Val.Nil,
        body_max: 0,
        known_hosts: Val.Nil,
        buffer: Vec.new(),
        chans: Vec.new(),
        bytes_sent: 0,
        bytes_received: 0,
        frames_sent: 0,
        frames_received: 0,
        now: 0,
        timers: Vec.new(),
        timer_seq: 0,
        dropped: false,
        tap_in_frames: 0,
        tap_in_bytes: 0,
        tap_out_frames: 0,
        tap_out_bytes: 0,
        app: App { cfg: cfg, channel: 0, next_tag: 1, unconfirmed: Vec.new(), delivered: 0 },
    };
    init_connection_state(mut c);
    cb_add(mut c, 0, "_on_connection_error", Cb.AppOpenError, false, -1, None);
    cb_add(mut c, 0, "_on_connection_open_ok", Cb.AppOpen, false, -1, None);
    cb_add(mut c, 0, "_on_connection_closed", Cb.AppClosed, false, -1, None);
    c.state = CONNECTION_INIT;
    c
}

fn init_connection_state(c: mut ref Conn) {
    c.state = CONNECTION_CLOSED;
    c.server_properties = Val.Nil;
    c.buffer = Vec.new();
    // the channels dict starts empty again
    let mut i: i64 = 0;
    while i < c.chans.len() {
        c.chans[i].live = false;
        i += 1;
    }
    c.bytes_sent = 0;
    c.bytes_received = 0;
    c.frames_sent = 0;
    c.frames_received = 0;
    c.hb = None;
    c.error = None;
    cb_add(mut c, 0, "Connection.Start", Cb.ConnStart, true, -1, None);
    cb_add(mut c, 0, "Connection.Close", Cb.ConnCloseFromBroker, true, -1, None);
    match c.params.blocked_timeout {
        Some(_) => {
            match c.blocked_timer {
                Some(t) => {
                    remove_timeout(mut c, t);
                    c.blocked_timer = None;
                }
                None => {}
            }
            c.partials += 1;
            let a = c.partials;
            cb_add(mut c, 0, "Connection.Blocked", Cb.ConnBlocked(a), false, -1, None);
            c.partials += 1;
            let b = c.partials;
            cb_add(mut c, 0, "Connection.Unblocked", Cb.ConnUnblocked(b), false, -1, None);
        }
        None => {}
    }
}

fn stream_connected(c: mut ref Conn) -> Result[(), PyErr] {
    c.state = CONNECTION_PROTOCOL;
    send_frame(mut c, protocol_header(0, 0, 0))
}

fn on_data_available(c: mut ref Conn, data: ref Vec[u8]) -> Result[(), PyErr] {
    append(mut c.buffer, data);
    while c.buffer.len() > 0 {
        let (used, f) = decode_frame(c.spec, c.buffer)?;
        let fr = match f {
            Some(x) => x,
            None => {
                return Ok(());
            }
        };
        c.buffer = slice(c.buffer, used, c.buffer.len());
        c.bytes_received += used;
        c.tap_in_bytes += used;
        process_frame(mut c, fr)?;
    }
    Ok(())
}

fn process_frame(c: mut ref Conn, f: ref Frame) -> Result[(), PyErr] {
    c.tap_in_frames += 1;
    let shown = show_frame(c, f, None);
    log(c, f"< {shown}");
    if frame_type(f) < 0 {
        return Ok(());
    }
    c.frames_received += 1;
    match f {
        Frame.Method(ch, m) => {
            if cb_pending(c, *ch, m.sp.name) > 0 {
                cb_process(mut c, *ch, m.sp.name, -1, CbArg.Frame(f.clone()))?;
                return Ok(());
            }
        }
        _ => {}
    }
    match f {
        Frame.Heartbeat => {
            match c.hb {
                Some(_) => {
                    let mut h = c.hb.clone().unwrap();
                    h.received += 1;
                    c.hb = Some(h);
                }
                None => {}
            }
        }
        _ => {
            let ch = frame_channel(f);
            if ch > 0 {
                // a frame for a channel this connection does not have is
                // only logged
                match ch_index(c, ch) {
                    Some(_) => ch_handle_content(mut c, ch, f)?,
                    None => {}
                }
            }
        }
    }
    Ok(())
}

// PlainCredentials and ExternalCredentials .response_for(): the mechanism
// and the response, when the broker offers the mechanism.
fn response_for(cred: ref Cred, mechanisms: ref Vec[u8]) -> Option[(String, Vec[u8])] {
    let words = split_ws(mechanisms);
    let kind = match cred {
        Cred.Plain(_, _) => "PLAIN",
        Cred.External => "EXTERNAL",
    };
    let mut offered = false;
    for w in words.iter() {
        if *w == str_bytes(kind) {
            offered = true;
        }
    }
    if not offered {
        return None;
    }
    match cred {
        Cred.Plain(user, pw) => {
            let mut r: Vec[u8] = vec![0];
            append(mut r, str_bytes(user));
            r.push(0);
            append(mut r, str_bytes(pw));
            Some(("PLAIN".to_string(), r))
        }
        Cred.External => Some(("EXTERNAL".to_string(), Vec.new())),
    }
}

// bytes.split(): runs of ASCII whitespace separate the words.
fn split_ws(b: ref Vec[u8]) -> Vec[Vec[u8]] {
    let mut out: Vec[Vec[u8]] = Vec.new();
    let mut cur: Vec[u8] = Vec.new();
    for x in b.iter() {
        let ch = *x;
        if ch == b' ' or ch == b'\t' or ch == b'\n' or ch == b'\r' or ch == 11 or ch == 12 {
            if cur.len() > 0 {
                out.push(cur);
                cur = Vec.new();
            }
        } else {
            cur.push(ch);
        }
    }
    if cur.len() > 0 {
        out.push(cur);
    }
    out
}

// Connection._client_properties: pika's own, then the parameters'
// client_properties over them (dict.update). pika says "Python <version>"
// for the platform; the sessions all set their own.
fn client_properties(c: ref Conn) -> Val {
    let caps = vec![(vstr("authentication_failure_close"), Val.Bool(true)), (vstr("basic.nack"), Val.Bool(true)), (vstr("connection.blocked"), Val.Bool(true)), (vstr("consumer_cancel_notify"), Val.Bool(true)), (vstr("publisher_confirms"), Val.Bool(true))];
    let mut d: Vec[(Val, Val)] = vec![(vstr("product"), vstr("Pika Python Client Library")), (vstr("platform"), vstr("Kāra")), (vstr("capabilities"), Val.Dict(caps)), (vstr("information"), vstr("See http://pika.rtfd.org")), (vstr("version"), vstr("1.3.2"))];
    match c.params.client_properties {
        Val.Dict(extra) => {
            for p in extra.iter() {
                dict_set(mut d, p.0.clone(), p.1.clone());
            }
        }
        _ => {}
    }
    Val.Dict(d)
}

fn conn_on_start(c: mut ref Conn, f: ref Frame) -> Result[(), PyErr] {
    c.state = CONNECTION_START;
    match start_steps(mut c, f) {
        Ok(()) => Ok(()),
        Err(e) => {
            terminate(mut c, Some(e));
            Ok(())
        }
    }
}

fn start_steps(c: mut ref Conn, f: ref Frame) -> Result[(), PyErr] {
    let m = match f {
        Frame.Method(_, m) => m.clone(),
        _ => {
            return Ok(());
        }
    };
    if mint(m, "version_major") != 0 or mint(m, "version_minor") != 9 {
        let a = frame_repr(protocol_header(0, 0, 0));
        let b = frame_repr(f);
        return Err(err("ProtocolVersionMismatch", f"ProtocolVersionMismatch: Protocol versions did not match: {a} vs {b}", a));
    }
    c.server_properties = mget(m, "server_properties");
    c.server_capabilities = match dict_get(c.server_properties, "capabilities") {
        Some(v) => v,
        None => Val.Dict(Vec.new()),
    };
    cb_add(mut c, 0, "Connection.Tune", Cb.ConnTune, true, -1, None);
    let mechanisms = as_bytes(mget(m, "mechanisms"));
    let (kind, response) = match response_for(c.params.cred, mechanisms) {
        Some(r) => r,
        None => {
            let t = match c.params.cred {
                Cred.Plain(_, _) => "PLAIN",
                Cred.External => "EXTERNAL",
            };
            return Err(err("AuthenticationError", f"AuthenticationError: Server and client could not negotiate use of the {t} authentication mechanism", t));
        }
    };
    let props = client_properties(c);
    let locale = vstr(c.params.locale);
    let ok = meth(c, "Connection.StartOk", vec![props, vstr(kind), Val.Bytes(response), locale]);
    send_method(mut c, 0, ok, None)
}

// Either value 0 or None leaves the other; otherwise the smaller.
fn negotiate(client: i64, server: i64) -> i64 {
    if client == 0 or server == 0 {
        if client > server { client } else { server }
    } else {
        if client < server { client } else { server }
    }
}

fn conn_on_tune(c: mut ref Conn, f: ref Frame) -> Result[(), PyErr] {
    c.state = CONNECTION_TUNE;
    let m = match f {
        Frame.Method(_, m) => m.clone(),
        _ => {
            return Ok(());
        }
    };
    let ch_max = negotiate(c.params.channel_max, mint(m, "channel_max"));
    set_channel_max(mut c.params, ch_max)?;
    let fr_max = negotiate(c.params.frame_max, mint(m, "frame_max"));
    set_frame_max(mut c.params, fr_max)?;
    let hb = match c.params.heartbeat {
        Some(n) => n,
        None => mint(m, "heartbeat"),
    };
    set_heartbeat(mut c.params, Some(hb))?;
    c.body_max = c.params.frame_max - 8;
    if hb > 0 {
        heartbeat_start(mut c, hb);
    }
    let tune_ok = meth(c, "Connection.TuneOk", vec![Val.Int(c.params.channel_max), Val.Int(c.params.frame_max), Val.Int(hb)]);
    send_method(mut c, 0, tune_ok, None)?;
    let open = meth(c, "Connection.Open", vec![vstr(c.params.vhost), vstr(""), Val.Bool(true)]);
    conn_rpc(mut c, 0, open, Some(Cb.ConnOpenOk), ["Connection.OpenOk"])
}

fn conn_on_open_ok(c: mut ref Conn, f: ref Frame) -> Result[(), PyErr] {
    c.opened = true;
    match f {
        Frame.Method(_, m) => {
            c.known_hosts = mget(m, "known_hosts");
        }
        _ => {}
    }
    c.state = CONNECTION_OPEN;
    cb_process(mut c, 0, "_on_connection_open_ok", -1, CbArg.Conn)?;
    Ok(())
}

// Connection.channel(): the lowest free number.
fn conn_channel(c: mut ref Conn) -> Result[i64, PyErr] {
    if c.state != CONNECTION_OPEN {
        return Err(wrong_state("Channel allocation requires an open connection"));
    }
    let limit = if c.params.channel_max == 0 { MAX_CHANNELS } else { c.params.channel_max };
    let count = live_count(c);
    if count >= limit {
        return Err(conn_err("NoFreeChannels", "The connection has run out of free channels"));
    }
    let mut n = count + 1;
    let mut k: i64 = 1;
    while k <= count {
        match ch_index(c, k) {
            None => {
                n = k;
                break;
            }
            Some(_) => {}
        }
        k += 1;
    }
    c.chans.push(Chan {
        n: n,
        live: true,
        state: CHANNEL_CLOSED,
        blocked: Vec.new(),
        blocking: None,
        has_on_flow: false,
        cancelled: Vec.new(),
        consumers: Vec.new(),
        noack: Vec.new(),
        on_openok: true,
        reason: None,
        asm_method: None,
        asm_header: None,
        seen: 0,
        frags: Vec.new(),
    });
    cb_add(mut c, n, "_on_channel_cleanup", Cb.ChannelCleanup, true, n, None);
    ch_open(mut c, n)?;
    Ok(n)
}

fn conn_close(c: mut ref Conn, code: i64, text: ref String) -> Result[(), PyErr] {
    if c.state == CONNECTION_CLOSING or c.state == CONNECTION_CLOSED {
        return Err(wrong_state(f"Illegal close({code}, {str_repr(text)}) request"));
    }
    if live_count(c) > 0 {
        let numbers = live_numbers(c);
        for n in numbers.iter() {
            match ch_index(c, *n) {
                Some(i) => {
                    let st = c.chans[i].state;
                    if st != CHANNEL_CLOSING and st != CHANNEL_CLOSED {
                        ch_close(mut c, *n, code, text)?;
                    }
                }
                None => {}
            }
        }
    }
    c.state = CONNECTION_CLOSING;
    if not c.opened {
        terminate(mut c, Some(conn_err("ConnectionOpenAborted", "Connection.close() called before connection finished opening")));
        return Ok(());
    }
    c.error = Some(closed_err("ConnectionClosedByClient", code, text));
    if live_count(c) == 0 {
        on_close_ready(mut c)?;
    }
    Ok(())
}

fn on_close_ready(c: mut ref Conn) -> Result[(), PyErr] {
    if c.state == CONNECTION_CLOSED {
        return Ok(());
    }
    let e = c.error.clone().unwrap();
    let close = meth(c, "Connection.Close", vec![Val.Int(e.code), vstr(e.text), Val.Int(0), Val.Int(0)]);
    conn_rpc(mut c, 0, close, Some(Cb.ConnCloseOk), ["Connection.CloseOk"])
}

fn on_channel_cleanup(c: mut ref Conn, n: i64) -> Result[(), PyErr] {
    match ch_index(c, n) {
        Some(i) => {
            c.chans[i].live = false;
        }
        None => {}
    }
    if c.state == CONNECTION_CLOSING and live_count(c) == 0 {
        on_close_ready(mut c)?;
    }
    Ok(())
}

fn on_blocked(c: mut ref Conn) {
    match c.blocked_timer {
        Some(_) => {}
        None => {
            let ms = match c.params.blocked_timeout {
                Some(x) => (x * 1000.0).round() as i64,
                None => 0,
            };
            c.blocked_timer = Some(call_later(mut c, ms, Tmr.BlockedTimeout));
        }
    }
}

fn on_unblocked(c: mut ref Conn) {
    match c.blocked_timer {
        Some(t) => {
            remove_timeout(mut c, t);
            c.blocked_timer = None;
        }
        None => {}
    }
}

// _terminate_stream(): keep the error and drop the transport; the replay
// reports the loss once the current event is over.
fn terminate(c: mut ref Conn, e: Option[PyErr]) {
    match e {
        Some(x) => {
            c.error = Some(x.clone());
        }
        None => {}
    }
    remove_heartbeat(mut c);
    c.dropped = true;
}

fn wrap_args(cls: ref String, text: ref String, inner: ref PyErr) -> PyErr {
    let a = args1(inner.repr);
    err(cls, f"{cls}: {text}: {a}", inner.repr)
}

fn stream_terminated(c: mut ref Conn, e: Option[PyErr]) -> Result[(), PyErr] {
    match e {
        Some(x) => {
            c.error = Some(x.clone());
        }
        None => {}
    }
    remove_heartbeat(mut c);
    let cur = c.error.clone().unwrap();
    if not c.opened and (cur.cls == "StreamLostError" or cur.cls == "ConnectionClosedByBroker") {
        if c.state == CONNECTION_PROTOCOL {
            c.error = Some(wrap_args("IncompatibleProtocolError", "The protocol returned by the server is not supported", cur));
        } else if c.state == CONNECTION_START {
            c.error = Some(wrap_args("ProbableAuthenticationError", "Client was disconnected at a connection stage indicating a probable authentication error", cur));
        } else if c.state == CONNECTION_TUNE {
            c.error = Some(wrap_args("ProbableAccessDeniedError", "Client was disconnected at a connection stage indicating a probable denial of access to the specified virtual host", cur));
        }
    }
    c.state = CONNECTION_CLOSED;
    let numbers = live_numbers(c);
    let reason = c.error.clone().unwrap();
    for n in numbers.iter() {
        match ch_index(c, *n) {
            Some(_) => ch_on_close_meta(mut c, *n, reason)?,
            None => {}
        }
    }
    if not c.opened {
        cb_process(mut c, 0, "_on_connection_error", -1, CbArg.ConnErr(reason))?;
    } else {
        cb_process(mut c, 0, "_on_connection_closed", -1, CbArg.ConnErr(reason))?;
    }
    init_connection_state(mut c);
    Ok(())
}

// heartbeat.HeartbeatChecker: a heartbeat sent every timeout / 2 seconds,
// and every timeout + 5 seconds a check that something arrived since
// the last one.
fn heartbeat_start(c: mut ref Conn, timeout: i64) {
    c.hb = Some(Hb { timeout: timeout, send_ms: timeout * 500, check_ms: (timeout + 5) * 1000, bytes_received: 0, bytes_sent: 0, received: 0, sent: 0, idle: 0, send_timer: None, check_timer: None });
    start_send_timer(mut c);
    start_check_timer(mut c);
}

fn start_send_timer(c: mut ref Conn) {
    let mut h = c.hb.clone().unwrap();
    h.send_timer = Some(call_later(mut c, h.send_ms, Tmr.HeartbeatSend));
    c.hb = Some(h);
}

fn start_check_timer(c: mut ref Conn) {
    let mut h = c.hb.clone().unwrap();
    h.bytes_sent = c.bytes_sent;
    h.bytes_received = c.bytes_received;
    h.check_timer = Some(call_later(mut c, h.check_ms, Tmr.HeartbeatCheck));
    c.hb = Some(h);
}

fn remove_heartbeat(c: mut ref Conn) {
    match c.hb.clone() {
        Some(h) => {
            match h.send_timer {
                Some(t) => remove_timeout(mut c, t),
                None => {}
            }
            match h.check_timer {
                Some(t) => remove_timeout(mut c, t),
                None => {}
            }
            c.hb = None;
        }
        None => {}
    }
}

fn heartbeat_send(c: mut ref Conn) -> Result[(), PyErr] {
    send_frame(mut c, Frame.Heartbeat)?;
    let mut h = c.hb.clone().unwrap();
    h.sent += 1;
    c.hb = Some(h);
    start_send_timer(mut c);
    Ok(())
}

fn heartbeat_check(c: mut ref Conn) -> Result[(), PyErr] {
    let mut h = c.hb.clone().unwrap();
    if h.bytes_received != c.bytes_received {
        h.idle = 0;
    } else {
        h.idle += 1;
    }
    c.hb = Some(h.clone());
    if h.idle > 0 {
        let t = h.timeout;
        terminate(mut c, Some(conn_err("AMQPHeartbeatTimeout", f"No activity or too many missed heartbeats in the last {t} seconds")));
        return Ok(());
    }
    start_check_timer(mut c);
    Ok(())
}

fn fire(c: mut ref Conn, what: ref Tmr) -> Result[(), PyErr] {
    match what {
        Tmr.HeartbeatSend => heartbeat_send(mut c),
        Tmr.HeartbeatCheck => heartbeat_check(mut c),
        Tmr.BlockedTimeout => {
            c.blocked_timer = None;
            terminate(mut c, Some(conn_err("ConnectionBlockedTimeout", "Blocked connection timeout expired.")));
            Ok(())
        }
    }
}

// ------------------------------------------------------------ channel.py

// The channel the connection still has under that number.
fn ch_index(c: ref Conn, n: i64) -> Option[i64] {
    let mut i: i64 = 0;
    while i < c.chans.len() {
        if c.chans[i].n == n and c.chans[i].live {
            return Some(i);
        }
        i += 1;
    }
    None
}

// The client program's channel with that number, whether or not the
// connection still has it: the newest one.
fn ch_any(c: ref Conn, n: i64) -> i64 {
    let mut at: i64 = -1;
    let mut i: i64 = 0;
    while i < c.chans.len() {
        if c.chans[i].n == n {
            at = i;
        }
        i += 1;
    }
    at
}

fn live_count(c: ref Conn) -> i64 {
    let mut k: i64 = 0;
    for ch in c.chans.iter() {
        if ch.live {
            k += 1;
        }
    }
    k
}

fn live_numbers(c: ref Conn) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for ch in c.chans.iter() {
        if ch.live {
            out.push(ch.n);
        }
    }
    out
}

fn has_tag(tags: ref Vec[String], tag: ref String) -> bool {
    for t in tags.iter() {
        if *t == *tag {
            return true;
        }
    }
    false
}

fn without_tag(tags: ref Vec[String], tag: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for t in tags.iter() {
        if *t != *tag {
            out.push(t.clone());
        }
    }
    out
}

fn ch_state(c: ref Conn, n: i64) -> i64 {
    c.chans[ch_any(c, n)].state
}

fn raise_if_not_open(c: ref Conn, n: i64) -> Result[(), PyErr] {
    let st = ch_state(c, n);
    if st == CHANNEL_OPEN {
        return Ok(());
    }
    if st == CHANNEL_OPENING {
        return Err(channel_wrong_state("Channel is opening, but is not usable yet."));
    }
    if st == CHANNEL_CLOSING {
        return Err(channel_wrong_state("Channel is closing."));
    }
    Err(channel_wrong_state("Channel is closed."))
}

fn reply(name: Str) -> (String, Option[(String, String)]) {
    (name.to_string(), None)
}

fn reply_if(name: Str, field: Str, value: ref String) -> (String, Option[(String, String)]) {
    (name.to_string(), Some((field.to_string(), value.clone())))
}

// _rpc(): a synchronous method waits behind the one the channel is
// blocking on; otherwise it is sent, and when it expects a reply the
// channel blocks until _on_synchronous_complete() runs for it.
fn ch_rpc(c: mut ref Conn, n: i64, m: ref Meth, cb: own Option[Cb], replies: own Vec[(String, Option[(String, String)])]) -> Result[(), PyErr] {
    if ch_state(c, n) == CHANNEL_CLOSED {
        raise_if_not_open(c, n)?;
    }
    let i = ch_any(c, n);
    match c.chans[i].blocking {
        Some(_) => {
            c.chans[i].blocked.push(Rpc { method: m.clone(), cb: cb, replies: replies });
            return Ok(());
        }
        None => {}
    }
    send_method(mut c, n, m, None)?;
    if replies.len() > 0 {
        c.chans[i].blocking = Some(m.sp.name.clone());
        for r in replies.iter() {
            cb_add(mut c, n, r.0, Cb.SyncComplete(n), true, -1, r.1.clone());
            match cb {
                Some(ref f) => cb_add(mut c, n, r.0, f.clone(), true, -1, r.1.clone()),
                None => {}
            }
        }
    }
    Ok(())
}

fn sync_complete(c: mut ref Conn, n: i64) -> Result[(), PyErr] {
    let i = ch_any(c, n);
    c.chans[i].blocking = None;
    loop {
        let j = ch_any(c, n);
        let waiting = c.chans[j].blocking.is_none() and c.chans[j].blocked.len() > 0;
        if not waiting {
            break;
        }
        let next = c.chans[j].blocked.remove(0);
        ch_rpc(mut c, n, next.method, next.cb, next.replies)?;
    }
    Ok(())
}

fn ch_send(c: mut ref Conn, n: i64, name: Str, vals: own Vec[Val]) -> Result[(), PyErr] {
    let m = meth(c, name.to_string(), vals);
    send_method(mut c, n, m, None)
}

fn ch_open(c: mut ref Conn, n: i64) -> Result[(), PyErr] {
    let i = ch_any(c, n);
    c.chans[i].state = CHANNEL_OPENING;
    cb_add(mut c, n, "Basic.GetEmpty", Cb.GetEmpty(n), false, -1, None);
    cb_add(mut c, n, "Basic.Cancel", Cb.Cancel(n), false, -1, None);
    cb_add(mut c, n, "Channel.Flow", Cb.Flow(n), false, -1, None);
    cb_add(mut c, n, "Channel.Close", Cb.CloseFromBroker(n), true, -1, None);
    let open = meth(c, "Channel.Open", vec![vstr("")]);
    ch_rpc(mut c, n, open, Some(Cb.OpenOk(n)), vec![reply("Channel.OpenOk")])
}

fn ch_on_openok(c: mut ref Conn, n: i64) -> Result[(), PyErr] {
    let i = ch_any(c, n);
    if c.chans[i].state == CHANNEL_CLOSING {
        return Ok(());
    }
    c.chans[i].state = CHANNEL_OPEN;
    if c.chans[i].on_openok {
        app_on_channel_open(mut c, n)?;
    }
    Ok(())
}

fn ch_close(c: mut ref Conn, n: i64, code: i64, text: ref String) -> Result[(), PyErr] {
    let st = ch_state(c, n);
    if st == CHANNEL_CLOSED or st == CHANNEL_CLOSING {
        raise_if_not_open(c, n)?;
    }
    let i = ch_any(c, n);
    c.chans[i].reason = Some(closed_err("ChannelClosedByClient", code, text));
    let tags = c.chans[i].consumers.clone();
    for tag in tags.iter() {
        let j = ch_any(c, n);
        if not has_tag(c.chans[j].cancelled, tag) {
            basic_cancel(mut c, n, tag)?;
        }
    }
    let j = ch_any(c, n);
    c.chans[j].state = CHANNEL_CLOSING;
    let close = meth(c, "Channel.Close", vec![Val.Int(code), vstr(text), Val.Int(0), Val.Int(0)]);
    ch_rpc(mut c, n, close, Some(Cb.CloseOk(n)), vec![reply("Channel.CloseOk")])
}

// basic_cancel() with no callback: nowait, so the consumer goes at once.
fn basic_cancel(c: mut ref Conn, n: i64, tag: ref String) -> Result[(), PyErr] {
    raise_if_not_open(c, n)?;
    let i = ch_any(c, n);
    if has_tag(c.chans[i].cancelled, tag) {
        return Ok(());
    }
    if not has_tag(c.chans[i].consumers, tag) {
        return Ok(());
    }
    c.chans[i].consumers = without_tag(c.chans[i].consumers, tag);
    c.chans[i].cancelled.push(tag.clone());
    let cancel = meth(c, "Basic.Cancel", vec![vstr(tag), Val.Bool(true)]);
    ch_rpc(mut c, n, cancel, None, Vec.new())
}

fn ch_reason(c: ref Conn, n: i64) -> PyErr {
    c.chans[ch_any(c, n)].reason.clone().unwrap()
}

// _transition_to_closed(): the close callbacks, then the cleanup, which
// runs even when a callback raised.
fn transition_to_closed(c: mut ref Conn, n: i64) -> Result[(), PyErr] {
    let i = ch_any(c, n);
    c.chans[i].state = CHANNEL_CLOSED;
    let reason = ch_reason(c, n);
    let r = cb_process(mut c, n, "_on_channel_close", n, CbArg.ChanErr(n, reason));
    ch_cleanup(mut c, n)?;
    r?;
    Ok(())
}

fn ch_cleanup(c: mut ref Conn, n: i64) -> Result[(), PyErr] {
    cb_process(mut c, n, "_on_channel_cleanup", n, CbArg.Chan(n))?;
    let i = ch_any(c, n);
    c.chans[i].consumers = Vec.new();
    cb_cleanup(mut c, n);
    Ok(())
}

fn ch_on_close_from_broker(c: mut ref Conn, n: i64, m: ref Meth) -> Result[(), PyErr] {
    ch_send(mut c, n, "Channel.CloseOk", Vec.new())?;
    let i = ch_any(c, n);
    c.chans[i].reason = Some(closed_err("ChannelClosedByBroker", mint(m, "reply_code"), mstr(m, "reply_text")));
    if c.chans[i].state == CHANNEL_CLOSING {
        drain(mut c, n)
    } else {
        transition_to_closed(mut c, n)
    }
}

// _drain_blocked_methods_on_remote_close(): only a waiting Channel.Close
// does anything, which is to finish closing.
fn drain(c: mut ref Conn, n: i64) -> Result[(), PyErr] {
    loop {
        let i = ch_any(c, n);
        if c.chans[i].blocked.len() == 0 {
            break;
        }
        let next = c.chans[i].blocked.remove(0);
        if is_meth(next.method, "Channel.Close") {
            let reason = ch_reason(c, n);
            ch_on_close_meta(mut c, n, reason)?;
        }
    }
    Ok(())
}

fn ch_on_close_meta(c: mut ref Conn, n: i64, reason: ref PyErr) -> Result[(), PyErr] {
    let i = ch_any(c, n);
    if c.chans[i].state != CHANNEL_CLOSED {
        c.chans[i].reason = Some(reason.clone());
        transition_to_closed(mut c, n)?;
    }
    Ok(())
}

fn cleanup_consumer_ref(c: mut ref Conn, n: i64, tag: ref String) {
    let i = ch_any(c, n);
    c.chans[i].noack = without_tag(c.chans[i].noack, tag);
    c.chans[i].consumers = without_tag(c.chans[i].consumers, tag);
    c.chans[i].cancelled = without_tag(c.chans[i].cancelled, tag);
}

fn ch_on_cancel(c: mut ref Conn, n: i64, m: ref Meth) {
    let tag = mstr(m, "consumer_tag");
    let i = ch_any(c, n);
    if has_tag(c.chans[i].cancelled, tag) {
        return;
    }
    cleanup_consumer_ref(mut c, n, tag);
}

// ContentFrameAssembler.process(): the method, its header and its body
// fragments, whole once the body is all there.
fn asm_process(ch: mut ref Chan, f: ref Frame) -> Result[Option[(Option[Meth], i64, Props, Vec[u8])], PyErr] {
    match f {
        Frame.Method(_, m) => {
            if has_content(m.sp.index) {
                ch.asm_method = Some(m.clone());
                return Ok(None);
            }
        }
        Frame.Header(_, size, props) => {
            ch.asm_header = Some((*size, props.clone()));
            if *size == 0 {
                return Ok(Some(asm_finish(mut ch)));
            }
            return Ok(None);
        }
        Frame.Body(_, frag) => {
            ch.seen += frag.len();
            append(mut ch.frags, frag);
            let size = match ch.asm_header {
                Some(h) => h.0,
                None => {
                    return Err(attr_none("body_size"));
                }
            };
            if ch.seen == size {
                return Ok(Some(asm_finish(mut ch)));
            }
            if ch.seen > size {
                let seen = ch.seen;
                return Err(err("BodyTooLongError", f"BodyTooLongError: Received too many bytes for a message delivery: Received {seen}, expected {size}", f"({seen}, {size})"));
            }
            return Ok(None);
        }
        _ => {}
    }
    Err(err("UnexpectedFrameError", "UnexpectedFrameError", ""))
}

fn asm_finish(ch: mut ref Chan) -> (Option[Meth], i64, Props, Vec[u8]) {
    let (size, props) = ch.asm_header.clone().unwrap();
    let out = (ch.asm_method.clone(), size, props, ch.frags.clone());
    ch.asm_method = None;
    ch.asm_header = None;
    ch.seen = 0;
    ch.frags = Vec.new();
    out
}

fn ch_handle_content(c: mut ref Conn, n: i64, f: ref Frame) -> Result[(), PyErr] {
    let i = ch_any(c, n);
    let response = match asm_process(mut c.chans[i], f) {
        Ok(r) => r,
        Err(e) => {
            if e.cls == "UnexpectedFrameError" {
                // only logged
                return Ok(());
            }
            return Err(e);
        }
    };
    match response {
        None => Ok(()),
        Some((method, _, props, body)) => {
            let m = match method {
                Some(x) => x,
                None => {
                    return Err(attr_none("method"));
                }
            };
            if m.sp.index == DELIVER {
                on_deliver(mut c, n, m, props, body)
            } else if m.sp.index == RETURN {
                cb_process(mut c, n, "_on_return", n, CbArg.Returned(n, m, props, body))?;
                Ok(())
            } else {
                // Basic.GetOk with no basic_get() waiting is only logged
                Ok(())
            }
        }
    }
}

fn on_deliver(c: mut ref Conn, n: i64, m: ref Meth, props: ref Props, body: ref Vec[u8]) -> Result[(), PyErr] {
    let tag = mstr(m, "consumer_tag");
    let i = ch_any(c, n);
    if has_tag(c.chans[i].cancelled, tag) {
        if c.chans[i].state == CHANNEL_OPEN and not has_tag(c.chans[i].noack, tag) {
            basic_reject(mut c, n, mint(m, "delivery_tag"), true)?;
        }
        return Ok(());
    }
    if not has_tag(c.chans[i].consumers, tag) {
        // an unexpected delivery is only logged
        return Ok(());
    }
    app_on_message(mut c, n, m, props, body)
}

fn basic_qos(c: mut ref Conn, n: i64, prefetch: i64) -> Result[(), PyErr] {
    raise_if_not_open(c, n)?;
    if prefetch < 0 {
        return Err(value_error(f"prefetch_count must be >= 0, but got {prefetch}"));
    }
    let qos = meth(c, "Basic.Qos", vec![Val.Int(0), Val.Int(prefetch), Val.Bool(false)]);
    ch_rpc(mut c, n, qos, None, vec![reply("Basic.QosOk")])
}

fn queue_declare(c: mut ref Conn, n: i64, queue: ref String) -> Result[(), PyErr] {
    raise_if_not_open(c, n)?;
    let condition = if queue.len() > 0 { reply_if("Queue.DeclareOk", "queue", queue) } else { reply("Queue.DeclareOk") };
    let declare = meth(c, "Queue.Declare", vec![Val.Int(0), vstr(queue), Val.Bool(false), Val.Bool(true), Val.Bool(false), Val.Bool(false), Val.Bool(false), Val.Dict(Vec.new())]);
    ch_rpc(mut c, n, declare, Some(Cb.AppDeclared), vec![condition])
}

fn confirm_delivery(c: mut ref Conn, n: i64) -> Result[(), PyErr] {
    raise_if_not_open(c, n)?;
    let confirms = match dict_get(c.server_capabilities, "publisher_confirms") {
        Some(v) => truthy(v),
        None => false,
    };
    let nack = match dict_get(c.server_capabilities, "basic.nack") {
        Some(v) => truthy(v),
        None => false,
    };
    if not (confirms and nack) {
        return Err(amqp_error("MethodNotImplemented", "Confirm.Select not Supported by Server"));
    }
    cb_add(mut c, n, "Basic.Ack", Cb.AppConfirm, false, -1, None);
    cb_add(mut c, n, "Basic.Nack", Cb.AppConfirm, false, -1, None);
    let select = meth(c, "Confirm.Select", vec![Val.Bool(false)]);
    ch_rpc(mut c, n, select, Some(Cb.AppConfirmsOn), vec![reply("Confirm.SelectOk")])
}

fn basic_publish(c: mut ref Conn, n: i64, p: ref Pub) -> Result[(), PyErr] {
    raise_if_not_open(c, n)?;
    let publish = meth(c, "Basic.Publish", vec![Val.Int(0), vstr(p.exchange), vstr(p.key), Val.Bool(p.mandatory), Val.Bool(false)]);
    send_method(mut c, n, publish, Some((p.props.clone(), p.body.clone())))
}

fn basic_consume(c: mut ref Conn, n: i64, queue: ref String, tag: ref String) -> Result[(), PyErr] {
    raise_if_not_open(c, n)?;
    let i = ch_any(c, n);
    if has_tag(c.chans[i].consumers, tag) or has_tag(c.chans[i].cancelled, tag) {
        return Err(err("DuplicateConsumerTag", f"DuplicateConsumerTag: The consumer tag specified already exists for this channel: {tag}", tag));
    }
    c.chans[i].consumers.push(tag.clone());
    let consume = meth(c, "Basic.Consume", vec![Val.Int(0), vstr(queue), vstr(tag), Val.Bool(false), Val.Bool(false), Val.Bool(false), Val.Bool(false), Val.Dict(Vec.new())]);
    ch_rpc(mut c, n, consume, Some(Cb.EventOk(n)), vec![reply_if("Basic.ConsumeOk", "consumer_tag", tag)])
}

fn basic_ack(c: mut ref Conn, n: i64, tag: i64) -> Result[(), PyErr] {
    raise_if_not_open(c, n)?;
    ch_send(mut c, n, "Basic.Ack", vec![Val.Int(tag), Val.Bool(false)])
}

fn basic_nack(c: mut ref Conn, n: i64, tag: i64, requeue: bool) -> Result[(), PyErr] {
    raise_if_not_open(c, n)?;
    ch_send(mut c, n, "Basic.Nack", vec![Val.Int(tag), Val.Bool(false), Val.Bool(requeue)])
}

fn basic_reject(c: mut ref Conn, n: i64, tag: i64, requeue: bool) -> Result[(), PyErr] {
    raise_if_not_open(c, n)?;
    ch_send(mut c, n, "Basic.Reject", vec![Val.Int(tag), Val.Bool(requeue)])
}

// ------------------------------------------------------------ dispatch

fn arg_meth(arg: ref CbArg) -> Meth {
    match arg {
        CbArg.Frame(f) => match f {
            Frame.Method(_, m) => m.clone(),
            _ => panic("not a method frame"),
        },
        _ => panic("not a frame"),
    }
}

fn arg_frame(arg: ref CbArg) -> Frame {
    match arg {
        CbArg.Frame(f) => f.clone(),
        _ => panic("not a frame"),
    }
}

fn arg_err(arg: ref CbArg) -> PyErr {
    match arg {
        CbArg.ConnErr(e) => e.clone(),
        CbArg.ChanErr(_, e) => e.clone(),
        _ => panic("no error"),
    }
}

fn invoke(c: mut ref Conn, cb: ref Cb, arg: ref CbArg) -> Result[(), PyErr] {
    match cb {
        Cb.ConnStart => conn_on_start(mut c, arg_frame(arg)),
        Cb.ConnTune => conn_on_tune(mut c, arg_frame(arg)),
        Cb.ConnOpenOk => conn_on_open_ok(mut c, arg_frame(arg)),
        Cb.ConnCloseOk => {
            terminate(mut c, None);
            Ok(())
        }
        Cb.ConnCloseFromBroker => {
            let m = arg_meth(arg);
            terminate(mut c, Some(closed_err("ConnectionClosedByBroker", mint(m, "reply_code"), mstr(m, "reply_text"))));
            Ok(())
        }
        Cb.ConnBlocked(_) => {
            on_blocked(mut c);
            Ok(())
        }
        Cb.ConnUnblocked(_) => {
            on_unblocked(mut c);
            Ok(())
        }
        Cb.ChannelCleanup => match arg {
            CbArg.Chan(n) => on_channel_cleanup(mut c, *n),
            _ => Ok(()),
        },
        Cb.SyncComplete(n) => sync_complete(mut c, *n),
        Cb.OpenOk(n) => ch_on_openok(mut c, *n),
        Cb.GetEmpty(_) => Ok(()),
        Cb.Cancel(n) => {
            ch_on_cancel(mut c, *n, arg_meth(arg));
            Ok(())
        }
        Cb.Flow(_) => Ok(()),
        Cb.CloseFromBroker(n) => ch_on_close_from_broker(mut c, *n, arg_meth(arg)),
        Cb.CancelOk(n) => {
            cleanup_consumer_ref(mut c, *n, mstr(arg_meth(arg), "consumer_tag"));
            Ok(())
        }
        Cb.EventOk(_) => Ok(()),
        Cb.CloseOk(n) => transition_to_closed(mut c, *n),
        Cb.AppOpen => app_on_open(mut c),
        Cb.AppOpenError => {
            let e = arg_err(arg);
            log(c, f"app: could not connect: {e.repr}");
            Ok(())
        }
        Cb.AppClosed => {
            let e = arg_err(arg);
            log(c, f"app: connection closed: {e.repr}");
            Ok(())
        }
        Cb.AppBlocked(_) => {
            let reason = mstr(arg_meth(arg), "reason");
            log(c, f"app: blocked by the broker: {reason}");
            Ok(())
        }
        Cb.AppUnblocked(_) => {
            log(c, "app: unblocked");
            Ok(())
        }
        Cb.AppChannelClosed => match arg {
            CbArg.ChanErr(n, e) => app_on_channel_closed(mut c, *n, e),
            _ => Ok(()),
        },
        Cb.AppReturn => match arg {
            CbArg.Returned(_, m, _, body) => {
                let text = f"app: returned by the broker: {mint(m, "reply_code")} {mstr(m, "reply_text")}, {mstr(m, "exchange")}/{mstr(m, "routing_key")}: {preview(c, body)}";
                log(c, text);
                Ok(())
            }
            _ => Ok(()),
        },
        Cb.AppCancelled => {
            let tag = mstr(arg_meth(arg), "consumer_tag");
            log(c, f"app: consumer {tag} cancelled by the broker");
            Ok(())
        }
        Cb.AppDeclared => app_on_declared(mut c, arg_meth(arg)),
        Cb.AppConfirmsOn => {
            log(c, "app: publisher confirms on");
            Ok(())
        }
        Cb.AppConfirm => {
            app_on_confirm(mut c, arg_meth(arg));
            Ok(())
        }
    }
}

// ------------------------------------------------------------ the client program

fn preview(c: ref Conn, body: ref Vec[u8]) -> String {
    if body.len() <= 40 {
        return bytes_repr(body);
    }
    let head = bytes_repr(slice(body, 0, 40));
    let n = body.len();
    f"{head}... ({n} bytes, crc {hex8(crc32(c.crc, body))})"
}

fn opt_str(v: ref Option[Val]) -> String {
    match v {
        Some(x) => py_str(x),
        None => "None".to_string(),
    }
}

fn app_on_open(c: mut ref Conn) -> Result[(), PyErr] {
    let product = opt_str(dict_get(c.server_properties, "product"));
    let version = opt_str(dict_get(c.server_properties, "version"));
    let hb = match c.params.heartbeat {
        Some(h) => f"{h}",
        None => "None".to_string(),
    };
    let text = f"app: connection open to {product} {version}, frame_max {c.params.frame_max}, channel_max {c.params.channel_max}, heartbeat {hb}";
    log(c, text);
    conn_channel(mut c)?;
    Ok(())
}

fn app_on_channel_open(c: mut ref Conn, n: i64) -> Result[(), PyErr] {
    c.app.channel = n;
    log(c, f"app: channel {n} open");
    cb_add(mut c, n, "_on_channel_close", Cb.AppChannelClosed, false, n, None);
    cb_add(mut c, n, "_on_return", Cb.AppReturn, false, -1, None);
    cb_add(mut c, n, "Basic.Cancel", Cb.AppCancelled, false, -1, None);
    basic_qos(mut c, n, c.app.cfg.prefetch)?;
    let queue = c.app.cfg.queue.clone();
    queue_declare(mut c, n, queue)?;
    confirm_delivery(mut c, n)
}

fn app_on_declared(c: mut ref Conn, m: ref Meth) -> Result[(), PyErr] {
    let text = f"app: queue {mstr(m, "queue")} declared: {mint(m, "message_count")} messages, {mint(m, "consumer_count")} consumers";
    log(c, text);
    let n = c.app.channel;
    let pubs = c.app.cfg.publish.clone();
    for p in pubs.iter() {
        basic_publish(mut c, n, p)?;
        let tag = c.app.next_tag;
        c.app.unconfirmed.push(tag);
        let size = p.body.len();
        log(c, f"app: published #{tag} to {str_repr(p.exchange)} with key {p.key}, {size} bytes");
        c.app.next_tag += 1;
    }
    let queue = c.app.cfg.queue.clone();
    let tag = c.app.cfg.tag.clone();
    basic_consume(mut c, n, queue, tag)
}

fn app_on_confirm(c: mut ref Conn, m: ref Meth) {
    let kind = if is_meth(m, "Basic.Ack") { "ack" } else { "nack" };
    let multiple = truthy(mget(m, "multiple"));
    let tag = mint(m, "delivery_tag");
    let mut done: Vec[i64] = Vec.new();
    let mut left: Vec[i64] = Vec.new();
    for t in c.app.unconfirmed.iter() {
        let hit = if multiple { *t <= tag } else { *t == tag };
        if hit {
            done.push(*t);
        } else {
            left.push(*t);
        }
    }
    c.app.unconfirmed = left;
    let mut names = String.new();
    for t in done.iter() {
        if names.len() > 0 {
            names.push_str(", ");
        }
        names.push_str(f"#{t}");
    }
    if names.len() == 0 {
        names = "nothing".to_string();
    }
    let count = c.app.unconfirmed.len();
    log(c, f"app: broker {kind} for {names}; {count} unconfirmed");
}

fn starts_with_bytes(b: ref Vec[u8], prefix: ref String) -> bool {
    let p = str_bytes(prefix);
    if b.len() < p.len() {
        return false;
    }
    let mut i: i64 = 0;
    while i < p.len() {
        if b[i] != p[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn app_on_message(c: mut ref Conn, n: i64, m: ref Meth, props: ref Props, body: ref Vec[u8]) -> Result[(), PyErr] {
    c.app.delivered += 1;
    let tag = mint(m, "delivery_tag");
    let again = if truthy(mget(m, "redelivered")) { " (redelivered)" } else { "" };
    let text = f"app: message {tag} from {py_repr(mget(m, "exchange"))} key {mstr(m, "routing_key")}{again}: {preview(c, body)}";
    log(c, text);
    if starts_with_bytes(body, "poison") {
        basic_nack(mut c, n, tag, false)?;
    } else {
        basic_ack(mut c, n, tag)?;
    }
    if c.app.delivered == c.app.cfg.close_after {
        let k = c.app.delivered;
        log(c, f"app: closing after {k} messages");
        conn_close(mut c, 200, "Normal shutdown")?;
    }
    let _ = props;
    Ok(())
}

fn app_on_channel_closed(c: mut ref Conn, n: i64, reason: ref PyErr) -> Result[(), PyErr] {
    log(c, f"app: channel {n} closed: {reason.repr}");
    if c.state == CONNECTION_OPEN {
        conn_close(mut c, 200, "Normal shutdown")?;
    }
    Ok(())
}

// ------------------------------------------------------------ the replay

// After each event: an exception aborts the transport with it, and a
// transport the connection dropped reports its loss. True when either
// ended the replay.
fn event_done(c: mut ref Conn, r: Result[(), PyErr]) -> Result[bool, PyErr] {
    match r {
        Err(e) => {
            c.dropped = false;
            log(c, "transport aborted");
            stream_terminated(mut c, Some(conn_err("StreamLostError", f"Stream connection lost: {e.repr}")))?;
            return Ok(true);
        }
        Ok(()) => {}
    }
    if c.dropped {
        c.dropped = false;
        log(c, "transport closed");
        stream_terminated(mut c, None)?;
        return Ok(true);
    }
    Ok(false)
}

// Every timer due by then, earliest first (ties by when it was set).
fn run_timers(c: mut ref Conn, until: i64) -> Result[bool, PyErr] {
    loop {
        let mut best: i64 = -1;
        let mut i: i64 = 0;
        while i < c.timers.len() {
            let t = c.timers[i].clone();
            if t.due <= until {
                if best < 0 or t.due < c.timers[best].due or (t.due == c.timers[best].due and t.seq < c.timers[best].seq) {
                    best = i;
                }
            }
            i += 1;
        }
        if best < 0 {
            break;
        }
        let t = c.timers.remove(best);
        c.now = t.due;
        let r = fire(mut c, t.what);
        if event_done(mut c, r)? {
            return Ok(true);
        }
    }
    c.now = until;
    Ok(false)
}

fn replay(spec: ref Spec, cfg: ref Session) -> Result[(), PyErr] {
    println("");
    println(f"== {cfg.name}: {cfg.url}");
    let mut params = url_parameters(cfg.url)?;
    params.client_properties = cfg.client.clone();
    if cfg.external {
        params.cred = Cred.External;
    }
    let mut c = conn_new(spec.clone(), params, cfg.clone());
    c.partials += 1;
    let a = c.partials;
    cb_add(mut c, 0, "Connection.Blocked", Cb.AppBlocked(a), false, -1, None);
    c.partials += 1;
    let b = c.partials;
    cb_add(mut c, 0, "Connection.Unblocked", Cb.AppUnblocked(b), false, -1, None);
    let r = stream_connected(mut c);
    let mut done = event_done(mut c, r)?;
    if not done {
        for seg in cfg.recv.iter() {
            if run_timers(mut c, seg.0)? {
                done = true;
                break;
            }
            let r = on_data_available(mut c, seg.1);
            if event_done(mut c, r)? {
                done = true;
                break;
            }
        }
    }
    if not done {
        if not run_timers(mut c, cfg.end)? {
            log(c, "end of capture");
            stream_terminated(mut c, Some(conn_err("StreamLostError", "Transport indicated EOF")))?;
        }
    }
    let mut left = String.new();
    for t in c.app.unconfirmed.iter() {
        if left.len() > 0 {
            left.push_str(" ");
        }
        left.push_str(f"#{t}");
    }
    if left.len() == 0 {
        left = "none".to_string();
    }
    println(f"  received {c.tap_in_frames} frames, {c.tap_in_bytes} bytes; sent {c.tap_out_frames} frames, {c.tap_out_bytes} bytes; delivered {c.app.delivered}, unconfirmed {left}");
    Ok(())
}

// ------------------------------------------------------------ sessions

// The value syntax of header tables and client properties:
// T F ~ 42 d1.50 @<epoch> "text" x<hex> [a,b] {k:v}.
struct Lit {
    s: Vec[char],
    i: i64,
}

fn lit_peek(p: ref Lit) -> char {
    if p.i < p.s.len() { p.s[p.i] } else { '\0' }
}

fn lit_text(p: ref Lit, start: i64, end: i64) -> String {
    let mut out = String.new();
    let mut k = start;
    while k < end {
        out.push(p.s[k]);
        k += 1;
    }
    out
}

fn lit_value(p: mut ref Lit) -> Val {
    let c = lit_peek(p);
    if c == '{' {
        p.i += 1;
        let mut out: Vec[(Val, Val)] = Vec.new();
        if lit_peek(p) == '}' {
            p.i += 1;
            return Val.Dict(out);
        }
        loop {
            let mut j = p.i;
            while p.s[j] != ':' {
                j += 1;
            }
            let key = lit_text(p, p.i, j);
            p.i = j + 1;
            let v = lit_value(mut p);
            dict_set(mut out, Val.Str(key), v);
            let d = lit_peek(p);
            p.i += 1;
            if d == '}' {
                return Val.Dict(out);
            }
        }
    }
    if c == '[' {
        p.i += 1;
        let mut out: Vec[Val] = Vec.new();
        if lit_peek(p) == ']' {
            p.i += 1;
            return Val.List(out);
        }
        loop {
            out.push(lit_value(mut p));
            let d = lit_peek(p);
            p.i += 1;
            if d == ']' {
                return Val.List(out);
            }
        }
    }
    if c == '"' {
        let mut j = p.i + 1;
        while p.s[j] != '"' {
            j += 1;
        }
        let v = lit_text(p, p.i + 1, j);
        p.i = j + 1;
        return Val.Str(v);
    }
    let mut j = p.i;
    while j < p.s.len() and p.s[j] != ',' and p.s[j] != ']' and p.s[j] != '}' {
        j += 1;
    }
    let tok = lit_text(p, p.i, j);
    p.i = j;
    if tok == "T" {
        return Val.Bool(true);
    }
    if tok == "F" {
        return Val.Bool(false);
    }
    if tok == "~" {
        return Val.Nil;
    }
    let rest = tok.substring(1, tok.len());
    if tok.starts_with("d") {
        return parse_decimal(rest);
    }
    if tok.starts_with("@") {
        return Val.Time(parse_int(rest));
    }
    if tok.starts_with("x") {
        return Val.Bytes(from_hex(rest));
    }
    Val.Int(parse_int(tok))
}

// Decimal("129.950"): coefficient 129950, exponent -3.
fn parse_decimal(s: ref String) -> Val {
    let (whole, dot, frac) = partition(s, ".");
    if not dot {
        return Val.Dec(parse_int(whole), 0);
    }
    let neg = whole.starts_with("-");
    let digits = if neg { whole.substring(1, whole.len()) } else { whole.clone() };
    let mag = parse_int(f"{digits}{frac}");
    let coef = if neg { -mag } else { mag };
    Val.Dec(coef, -frac.len())
}

fn lit(text: ref String) -> Val {
    let mut p = Lit { s: text.chars().collect(), i: 0 };
    lit_value(mut p)
}

fn body_of(spec_text: ref String) -> Vec[u8] {
    let (kind, _, rest) = partition(spec_text, " ");
    if kind == "text" {
        return str_bytes(rest);
    }
    let (count, _, word) = partition(rest, " ");
    let n = parse_int(count);
    let mut out: Vec[u8] = Vec.new();
    let mut k: i64 = 0;
    while out.len() < n {
        k += 1;
        append(mut out, str_bytes(f"{word}-{k} "));
    }
    slice(out, 0, n)
}

fn set_prop(p: mut ref Pub, name: ref String, value: ref String) {
    let at = prop_at(name);
    let v = if *name == "headers" {
        lit(value)
    } else if *name == "delivery_mode" or *name == "priority" or *name == "timestamp" {
        Val.Int(parse_int(value))
    } else {
        vstr(value)
    };
    p.props.vals[at] = v;
}

fn new_session(name: ref String) -> Session {
    Session { name: name.clone(), url: String.new(), client: Val.Nil, external: false, queue: String.new(), prefetch: 0, tag: String.new(), close_after: 0, publish: Vec.new(), recv: Vec.new(), end: 0 }
}

fn parse_sessions() -> Vec[Session] {
    let mut out: Vec[Session] = Vec.new();
    for line in lines_of(unesc(sessions_text())).iter() {
        if line.len() == 0 {
            continue;
        }
        let (word, _, rest) = partition(line, " ");
        if word == "session" {
            out.push(new_session(rest));
            continue;
        }
        let at = out.len() - 1;
        if word == "url" {
            out[at].url = rest;
        } else if word == "client" {
            out[at].client = lit(rest);
        } else if word == "credentials" {
            out[at].external = rest == "external";
        } else if word == "queue" {
            let parts = split_on(rest, ' ');
            out[at].queue = parts[0].clone();
            out[at].prefetch = parse_int(parts[2]);
            out[at].tag = parts[4].clone();
        } else if word == "close_after" {
            out[at].close_after = parse_int(rest);
        } else if word == "pub" {
            let parts = split_on(rest, ' ');
            let ex = if parts[0] == "-" { String.new() } else { parts[0].clone() };
            out[at].publish.push(Pub { exchange: ex, key: parts[1].clone(), mandatory: parts[2] == "1", props: no_props(), body: Vec.new() });
        } else if word == "prop" {
            let (name, _, value) = partition(rest, " ");
            let last = out[at].publish.len() - 1;
            set_prop(mut out[at].publish[last], name, value);
        } else if word == "body" {
            let last = out[at].publish.len() - 1;
            out[at].publish[last].body = body_of(rest);
        } else if word == "recv" {
            let (t, _, data) = partition(rest, " ");
            out[at].recv.push((parse_int(t), from_hex(data)));
        } else if word == "end" {
            out[at].end = parse_int(rest);
        }
    }
    out
}

fn main() {
    let spec = load_spec();
    url_job();
    println("");
    println("# sessions");
    for cfg in parse_sessions().iter() {
        match replay(spec, cfg) {
            Ok(()) => {}
            Err(e) => println(f"  replay failed: {e.repr}"),
        }
    }
}

// Generated by gen_kara.py from data/ and the vendored pika/spec.py.

fn urls_text() -> String {
    let mut s = String.new();
