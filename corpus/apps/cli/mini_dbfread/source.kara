// mini_dbfread: a port of dbfread 2.0.7 (MIT; Ole Martin Bjørndalen, UiT
// The Arctic University of Norway), the library that reads the DBF tables
// of dBase, FoxBASE, FoxPro and Visual FoxPro, with their memo files. It
// is how GIS shapefile attributes, old accounting and point-of-sale
// systems and government data dumps get read from Python today.
//
// It replays data/jobs.tsv (see mk.py) over the tables and memo files of
// a town archive's legacy systems: what DBF() makes of each header, every
// record under each option (encodings and decode errors, raw mode, lower-
// case names, the record factories, the FieldParser subclasses from the
// library's examples), the deleted records, load() and unload(), the
// memo file readers, the field parsers one value at a time, the
// case-insensitive file finder, and the damaged files other tools left
// behind. Then the library's dbfinfo, print_invalid_values and
// custom_field_type examples, and four programs that write data/out/: a
// CSV export, a JSON export, an SQL migration and a month-end ledger.
//
// The port reads the files the way the library does, through a position
// in the file, so a record length that disagrees with the fields, a
// missing end marker or a memo that runs past the end of its file gives
// what dbfread gives.

// ------------------------------------------------------------ text helpers

fn hex_val(c: char) -> i64 {
    if c >= '0' and c <= '9' {
        c as i64 - 48
    } else if c >= 'a' and c <= 'f' {
        c as i64 - 87
    } else if c >= 'A' and c <= 'F' {
        c as i64 - 55
    } else {
        -1
    }
}

fn hex_bytes(s: ref String) -> Vec[u8] {
    let cs: Vec[char] = s.chars().collect();
    let mut bytes: Vec[u8] = Vec.new();
    let mut k = 0;
    while k + 1 < cs.len() {
        bytes.push((hex_val(cs[k]) * 16 + hex_val(cs[k + 1])) as u8);
        k += 2;
    }
    bytes
}

fn hex_string(s: ref String) -> String {
    match String.from_utf8(hex_bytes(s)) {
        Ok(t) => t,
        Err(_) => String.new(),
    }
}

fn split_on(s: ref String, sep: char) -> Vec[String] {
    let mut pieces: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            pieces.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    pieces.push(cur);
    pieces
}

fn join_strs(xs: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    let mut first = true;
    for x in xs {
        if not first {
            out.push_str(sep);
        }
        out.push_str(x);
        first = false;
    }
    out
}

fn atoi(s: ref String) -> i64 {
    match i64.parse(s.clone()) {
        Ok(n) => n,
        Err(_) => 0,
    }
}

fn chr(n: i64) -> char {
    match char.try_from(n) {
        Ok(c) => c,
        Err(_) => '?',
    }
}

const HEX: Str = "0123456789abcdef";

fn hex2(n: i64) -> String {
    let ds: Vec[char] = HEX.chars().collect();
    let mut out = String.new();
    out.push(ds[(n / 16) % 16]);
    out.push(ds[n % 16]);
    out
}

fn hexn(n: i64, width: i64) -> String {
    let ds: Vec[char] = HEX.chars().collect();
    let mut digits: Vec[char] = Vec.new();
    let mut m = n;
    while m > 0 {
        digits.push(ds[m % 16]);
        m = m / 16;
    }
    while digits.len() < width {
        digits.push('0');
    }
    let mut out = String.new();
    let mut i = digits.len() - 1;
    while i >= 0 {
        out.push(digits[i]);
        i -= 1;
    }
    out
}

fn pad_left(s: ref String, n: i64) -> String {
    let mut out = String.new();
    let mut k = s.chars().count();
    while k < n {
        out.push(' ');
        k += 1;
    }
    out.push_str(s);
    out
}

fn pad_right(s: ref String, n: i64) -> String {
    let mut out = s.clone();
    let mut k = s.chars().count();
    while k < n {
        out.push(' ');
        k += 1;
    }
    out
}

fn zpad(n: i64, w: i64) -> String {
    let s = f"{n}";
    let mut out = String.new();
    let mut k = s.len();
    while k < w {
        out.push('0');
        k += 1;
    }
    out.push_str(s);
    out
}

// Whether str.isprintable() holds, for the characters the code pages here
// can produce: controls, the C1 range, no-break space, soft hyphen and the
// private use area are not printable.
fn printable(n: i64) -> bool {
    if n < 32 or (n >= 127 and n <= 160) or n == 173 {
        return false;
    }
    not (n >= 0xE000 and n <= 0xF8FF)
}

// repr() of a str.
fn str_repr(s: ref String) -> String {
    let q = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        let n = c as i64;
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if not printable(n) {
            if n < 256 {
                out.push_str("\\x");
                out.push_str(hex2(n));
            } else {
                out.push_str("\\u");
                out.push_str(hexn(n, 4));
            }
        } else {
            out.push(c);
        }
    }
    out.push(q);
    out
}

// ------------------------------------------------------------ bytes

fn sub(b: ref Vec[u8], from: i64, to: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let end = if to > b.len() { b.len() } else { to };
    let mut i = if from < 0 { 0 } else { from };
    while i < end {
        out.push(b[i]);
        i += 1;
    }
    out
}

fn bytes_of(s: Str) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for b in s.bytes() {
        out.push(b);
    }
    out
}

fn latin1(b: ref Vec[u8]) -> String {
    let mut out = String.new();
    for x in b {
        out.push(chr(*x as i64));
    }
    out
}

fn bytes_eq(a: ref Vec[u8], s: Str) -> bool {
    let t = bytes_of(s);
    if a.len() != t.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != t[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn has_byte(set: ref Vec[u8], x: u8) -> bool {
    for y in set {
        if *y == x {
            return true;
        }
    }
    false
}

fn is_ws(x: u8) -> bool {
    x == 32 or (x >= 9 and x <= 13)
}

// bytes.strip() with no argument: ASCII whitespace.
fn strip_ws(b: ref Vec[u8]) -> Vec[u8] {
    let mut i = 0;
    let mut j = b.len();
    while i < j and is_ws(b[i]) {
        i += 1;
    }
    while j > i and is_ws(b[j - 1]) {
        j -= 1;
    }
    sub(b, i, j)
}

// bytes.strip(chars) / rstrip(chars).
fn strip_set(b: ref Vec[u8], set: ref Vec[u8], left: bool) -> Vec[u8] {
    let mut i = 0;
    let mut j = b.len();
    if left {
        while i < j and has_byte(set, b[i]) {
            i += 1;
        }
    }
    while j > i and has_byte(set, b[j - 1]) {
        j -= 1;
    }
    sub(b, i, j)
}

fn replace_byte(b: ref Vec[u8], from: u8, to: u8) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for x in b {
        out.push(if *x == from { to } else { *x });
    }
    out
}

fn find_byte(b: ref Vec[u8], x: u8) -> i64 {
    let mut i = 0;
    while i < b.len() {
        if b[i] == x {
            return i;
        }
        i += 1;
    }
    -1
}

// `needle in haystack` for bytes: a substring test.
fn bytes_in(needle: ref Vec[u8], hay: Str) -> bool {
    let h = bytes_of(hay);
    let mut i = 0;
    while i + needle.len() <= h.len() {
        let mut ok = true;
        let mut k = 0;
        while k < needle.len() {
            if h[i + k] != needle[k] {
                ok = false;
                break;
            }
            k += 1;
        }
        if ok {
            return true;
        }
        i += 1;
    }
    false
}

// repr() of a bytes object.
fn bytes_repr(b: ref Vec[u8]) -> String {
    let mut sq = false;
    let mut dq = false;
    for x in b {
        if *x == 39 {
            sq = true;
        }
        if *x == 34 {
            dq = true;
        }
    }
    let q: u8 = if sq and not dq { 34 } else { 39 };
    let mut out = String.new();
    out.push('b');
    out.push(chr(q as i64));
    for x in b {
        let n = *x as i64;
        if *x == q or n == 92 {
            out.push('\\');
            out.push(chr(n));
        } else if n == 9 {
            out.push_str("\\t");
        } else if n == 10 {
            out.push_str("\\n");
        } else if n == 13 {
            out.push_str("\\r");
        } else if n < 32 or n >= 127 {
            out.push_str("\\x");
            out.push_str(hex2(n));
        } else {
            out.push(chr(n));
        }
    }
    out.push(chr(q as i64));
    out
}

fn hex_upper(b: ref Vec[u8]) -> String {
    let ds: Vec[char] = "0123456789ABCDEF".chars().collect();
    let mut out = String.new();
    for x in b {
        let n = *x as i64;
        out.push(ds[n / 16]);
        out.push(ds[n % 16]);
    }
    out
}

fn u16le(b: ref Vec[u8], at: i64) -> i64 {
    b[at] as i64 + b[at + 1] as i64 * 256
}

fn u32le(b: ref Vec[u8], at: i64) -> i64 {
    u16le(b, at) + u16le(b, at + 2) * 65536
}

fn u32be(b: ref Vec[u8], at: i64) -> i64 {
    ((b[at] as i64 * 256 + b[at + 1] as i64) * 256 + b[at + 2] as i64) * 256 + b[at + 3] as i64
}

fn u16be(b: ref Vec[u8], at: i64) -> i64 {
    b[at] as i64 * 256 + b[at + 1] as i64
}

fn i32le(b: ref Vec[u8], at: i64) -> i64 {
    let u = u32le(b, at);
    if u >= 2147483648 { u - 4294967296 } else { u }
}

// '<q': eight little-endian bytes, two's complement.
fn i64le(b: ref Vec[u8], at: i64) -> i64 {
    let mut v: i64 = if b[at + 7] >= 0x80 { -1 } else { 0 };
    let mut k = 7;
    while k >= 0 {
        v = (v << 8) | b[at + k] as i64;
        k -= 1;
    }
    v
}

fn f64le(b: ref Vec[u8], at: i64) -> f64 {
    i64le(b, at).bits_as_f64()
}

// ------------------------------------------------------------ exceptions

// A Python exception: its class (with its module when that is not
// builtins, as the jobs print it) and str() of it.
#[derive(Clone)]
struct Exc {
    cls: String,
    msg: String,
}

fn exc(cls: Str, msg: own String) -> Exc {
    Exc { cls: cls.to_string(), msg: msg }
}

fn value_error(msg: own String) -> Exc {
    exc("ValueError", msg)
}

fn struct_error(n: i64) -> Exc {
    exc("struct.error", f"unpack requires a buffer of {n} bytes")
}

fn not_found(path: ref String) -> Exc {
    exc("FileNotFoundError", f"[Errno 2] No such file or directory: {str_repr(path)}")
}

// ValueError and its subclass UnicodeDecodeError, which is what the
// print_invalid_values parser catches.
fn is_value_error(e: ref Exc) -> bool {
    e.cls == "ValueError" or e.cls == "UnicodeDecodeError"
}

fn err_line(e: ref Exc) -> String {
    f"error {e.cls}: {e.msg}"
}

// ------------------------------------------------------------ codecs

// Bytes 0x80..0xff of the eight-bit code pages, four hex digits a code
// point (0000 where the code page leaves the byte undefined), as CPython's
// codec tables have them; the low half of each is ASCII.
fn codec_table(name: ref String) -> Vec[i64] {
    let src = if name == "cp437" {
        CP437
    } else if name == "cp850" {
        CP850
    } else if name == "cp865" {
        CP865
    } else if name == "cp866" {
        CP866
    } else if name == "cp1251" {
        CP1251
    } else if name == "cp1252" {
        CP1252
    } else if name == "mac_roman" {
        MAC_ROMAN
    } else {
        ""
    };
    let cs: Vec[char] = src.chars().collect();
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k + 3 < cs.len() {
        out.push(((hex_val(cs[k]) * 16 + hex_val(cs[k + 1])) * 16 + hex_val(cs[k + 2])) * 16 + hex_val(cs[k + 3]));
        k += 4;
    }
    out
}

fn known_codec(name: ref String) -> bool {
    name == "ascii" or name == "latin-1" or name == "utf-8" or codec_table(name).len() == 128
}

fn decode_err(codec: Str, b: ref Vec[u8], from: i64, to: i64, why: Str) -> Exc {
    if to - from == 1 {
        exc("UnicodeDecodeError", f"'{codec}' codec can't decode byte 0x{hex2(b[from] as i64)} in position {from}: {why}")
    } else {
        exc("UnicodeDecodeError", f"'{codec}' codec can't decode bytes in position {from}-{to - 1}: {why}")
    }
}

// What an error handler puts in place of b[from..to].
fn handle(out: mut ref String, b: ref Vec[u8], from: i64, to: i64, errors: ref String, one: bool) {
    if errors == "replace" {
        if one {
            out.push(chr(0xFFFD));
        } else {
            let mut i = from;
            while i < to {
                out.push(chr(0xFFFD));
                i += 1;
            }
        }
    } else if errors == "backslashreplace" {
        let mut i = from;
        while i < to {
            out.push_str("\\x");
            out.push_str(hex2(b[i] as i64));
            i += 1;
        }
    }
}

fn is_cont(x: u8) -> bool {
    x >= 0x80 and x <= 0xBF
}

fn decode_utf8(b: ref Vec[u8], errors: ref String) -> Result[String, Exc] {
    let mut out = String.new();
    let n = b.len();
    let mut i = 0;
    while i < n {
        let x = b[i] as i64;
        if x < 0x80 {
            out.push(chr(x));
            i += 1;
            continue;
        }
        let need = if x >= 0xC2 and x <= 0xDF { 1 } else if x >= 0xE0 and x <= 0xEF { 2 } else if x >= 0xF0 and x <= 0xF4 { 3 } else { 0 };
        if need == 0 {
            if errors == "strict" {
                return Err(decode_err("utf-8", b, i, i + 1, "invalid start byte"));
            }
            handle(mut out, b, i, i + 1, errors, true);
            i += 1;
            continue;
        }
        // How many of the following bytes continue the sequence validly.
        let mut good = 0;
        let mut k = 1;
        while k <= need and i + k < n {
            let y = b[i + k];
            let ok = if k == 1 and x == 0xE0 {
                y >= 0xA0 and y <= 0xBF
            } else if k == 1 and x == 0xED {
                y >= 0x80 and y <= 0x9F
            } else if k == 1 and x == 0xF0 {
                y >= 0x90 and y <= 0xBF
            } else if k == 1 and x == 0xF4 {
                y >= 0x80 and y <= 0x8F
            } else {
                is_cont(y)
            };
            if not ok {
                break;
            }
            good += 1;
            k += 1;
        }
        if good == need {
            let mut cp = if need == 1 { x - 0xC0 } else if need == 2 { x - 0xE0 } else { x - 0xF0 };
            let mut j = 1;
            while j <= need {
                cp = cp * 64 + (b[i + j] as i64 - 0x80);
                j += 1;
            }
            out.push(chr(cp));
            i += need + 1;
            continue;
        }
        let at_end = i + 1 + good >= n;
        let why = if at_end { "unexpected end of data" } else { "invalid continuation byte" };
        let to = if at_end { n } else { i + 1 + good };
        if errors == "strict" {
            return Err(decode_err("utf-8", b, i, to, why));
        }
        handle(mut out, b, i, to, errors, true);
        i = to;
    }
    Ok(out)
}

// bytes.decode(encoding, errors) for the code pages dbfread names.
fn decode(b: ref Vec[u8], encoding: ref String, errors: ref String) -> Result[String, Exc] {
    if encoding == "utf-8" {
        return decode_utf8(b, errors);
    }
    let table = codec_table(encoding);
    let ascii = encoding == "ascii";
    let latin = encoding == "latin-1";
    let mut out = String.new();
    let mut i = 0;
    while i < b.len() {
        let x = b[i] as i64;
        if x < 128 or latin {
            out.push(chr(x));
        } else if not ascii and table[x - 128] != 0 {
            out.push(chr(table[x - 128]));
        } else if errors == "strict" {
            if ascii {
                return Err(decode_err("ascii", b, i, i + 1, "ordinal not in range(128)"));
            }
            return Err(decode_err("charmap", b, i, i + 1, "character maps to <undefined>"));
        } else {
            handle(mut out, b, i, i + 1, errors, true);
        }
        i += 1;
    }
    Ok(out)
}
// ------------------------------------------------------------ code page tables

const CP437: Str = "";

const CP850: Str = "";

const CP865: Str = "";

const CP866: Str = "";

const CP1251: Str = "";

const CP1252: Str = "";

const MAC_ROMAN: Str = "";

// ------------------------------------------------------------ values

// What a field parser gives. Bytes carries which class it is: 0 bytes,
// 1 TextMemo, 2 PictureMemo, 3 ObjectMemo, 4 BinaryMemo (the last three
// are BinaryMemo subclasses), 5 InvalidValue. A Dt is a datetime with
// microseconds; a Dec is a decimal.Decimal, coefficient and exponent.
#[derive(Clone)]
enum Val {
    Non,
    Bool(bool),
    Int(i64),
    Float(f64),
    Str(String),
    Bytes(Vec[u8], i64),
    Date(i64, i64, i64),
    Dt(i64, i64, i64, i64, i64, i64, i64),
    Dec(i64, i64),
}

const B_PLAIN: i64 = 0;
const B_TEXT: i64 = 1;
const B_PICTURE: i64 = 2;
const B_OBJECT: i64 = 3;
const B_BINARY: i64 = 4;
const B_INVALID: i64 = 5;

fn type_name(v: ref Val) -> String {
    let s = match v {
        Val.Non => "NoneType",
        Val.Bool(_) => "bool",
        Val.Int(_) => "int",
        Val.Float(_) => "float",
        Val.Str(_) => "str",
        Val.Bytes(_, k) => if *k == B_TEXT {
            "TextMemo"
        } else if *k == B_PICTURE {
            "PictureMemo"
        } else if *k == B_OBJECT {
            "ObjectMemo"
        } else if *k == B_BINARY {
            "BinaryMemo"
        } else if *k == B_INVALID {
            "InvalidValue"
        } else {
            "bytes"
        },
        Val.Date(_, _, _) => "date",
        Val.Dt(_, _, _, _, _, _, _) => "datetime",
        Val.Dec(_, _) => "Decimal",
    };
    s.to_string()
}

// The digits of |c|, also for the most negative i64.
fn abs_digits(c: i64) -> String {
    if c == 0 {
        return "0".to_string();
    }
    let mut ds: Vec[char] = Vec.new();
    let mut m = c;
    while m != 0 {
        let d = m % 10;
        ds.push(chr(48 + (if d < 0 { -d } else { d })));
        m = m / 10;
    }
    let mut out = String.new();
    let mut i = ds.len() - 1;
    while i >= 0 {
        out.push(ds[i]);
        i -= 1;
    }
    out
}

// str() of a Decimal with a non-positive exponent.
fn dec_str(c: i64, e: i64) -> String {
    let digits = abs_digits(c);
    let mut out = String.new();
    if c < 0 {
        out.push('-');
    }
    if e == 0 {
        out.push_str(digits);
        return out;
    }
    let n = digits.len();
    let point = n + e;
    if point > 0 {
        out.push_str(digits.substring(0, point));
        out.push('.');
        out.push_str(digits.substring(point, n));
    } else {
        out.push_str("0.");
        let mut k = point;
        while k < 0 {
            out.push('0');
            k += 1;
        }
        out.push_str(digits);
    }
    out
}

fn pow10(n: i64) -> i64 {
    let mut p = 1;
    let mut k = 0;
    while k < n {
        p = p * 10;
        k += 1;
    }
    p
}

// Decimal + Decimal, exact at the smaller exponent.
fn dec_add(a: ref Val, b: ref Val) -> Val {
    match (a, b) {
        (Val.Dec(c1, e1), Val.Dec(c2, e2)) => {
            if *e1 <= *e2 {
                Val.Dec(*c1 + *c2 * pow10(*e2 - *e1), *e1)
            } else {
                Val.Dec(*c1 * pow10(*e1 - *e2) + *c2, *e2)
            }
        }
        _ => a.clone(),
    }
}

fn date_str(y: i64, m: i64, d: i64) -> String {
    f"{zpad(y, 4)}-{zpad(m, 2)}-{zpad(d, 2)}"
}

fn dt_str(v: ref Val) -> String {
    match v {
        Val.Dt(y, mo, d, h, mi, s, us) => {
            let mut out = f"{date_str(*y, *mo, *d)} {zpad(*h, 2)}:{zpad(*mi, 2)}:{zpad(*s, 2)}";
            if *us != 0 {
                out.push_str(f".{zpad(*us, 6)}");
            }
            out
        }
        _ => String.new(),
    }
}

fn val_repr(v: ref Val) -> String {
    match v {
        Val.Non => "None".to_string(),
        Val.Bool(b) => if *b { "True".to_string() } else { "False".to_string() },
        Val.Int(n) => f"{n}",
        Val.Float(x) => f"{x}",
        Val.Str(s) => str_repr(s),
        Val.Bytes(b, k) => if *k == B_INVALID {
            f"InvalidValue({bytes_repr(b)})"
        } else {
            bytes_repr(b)
        },
        Val.Date(y, m, d) => f"datetime.date({y}, {m}, {d})",
        Val.Dt(y, mo, d, h, mi, s, us) => {
            let mut out = f"datetime.datetime({y}, {mo}, {d}, {h}, {mi}";
            if *s != 0 or *us != 0 {
                out.push_str(f", {s}");
            }
            if *us != 0 {
                out.push_str(f", {us}");
            }
            out.push(')');
            out
        }
        Val.Dec(c, e) => f"Decimal('{dec_str(*c, *e)}')",
    }
}

// str() of a value, as csv, the SQL literals and json's default=str use it.
fn val_str(v: ref Val) -> String {
    match v {
        Val.Str(s) => s.clone(),
        Val.Bytes(b, _) => bytes_repr(b),
        Val.Date(y, m, d) => date_str(*y, *m, *d),
        Val.Dt(_, _, _, _, _, _, _) => dt_str(v),
        Val.Dec(c, e) => dec_str(*c, *e),
        _ => val_repr(v),
    }
}

// ------------------------------------------------------------ calendar

fn is_leap(y: i64) -> bool {
    (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
}

fn days_in_month(y: i64, m: i64) -> i64 {
    if m == 2 {
        if is_leap(y) { 29 } else { 28 }
    } else if m == 4 or m == 6 or m == 9 or m == 11 {
        30
    } else {
        31
    }
}

fn valid_date(y: i64, m: i64, d: i64) -> bool {
    y >= 1 and y <= 9999 and m >= 1 and m <= 12 and d >= 1 and d <= days_in_month(y, m)
}

fn days_before_year(y: i64) -> i64 {
    let z = y - 1;
    z * 365 + z / 4 - z / 100 + z / 400
}

fn days_before_month(y: i64, m: i64) -> i64 {
    let mut n = 0;
    let mut k = 1;
    while k < m {
        n += days_in_month(y, k);
        k += 1;
    }
    n
}

fn ymd2ord(y: i64, m: i64, d: i64) -> i64 {
    days_before_year(y) + days_before_month(y, m) + d
}

// datetime's _ord2ymd: the proleptic Gregorian date of ordinal n >= 1.
fn ord2ymd(n0: i64) -> (i64, i64, i64) {
    let mut n = n0 - 1;
    let n400 = n / 146097;
    n = n % 146097;
    let n100 = n / 36524;
    n = n % 36524;
    let n4 = n / 1461;
    n = n % 1461;
    let n1 = n / 365;
    n = n % 365;
    let year = n400 * 400 + n100 * 100 + n4 * 4 + n1 + 1;
    if n1 == 4 or n100 == 4 {
        return (year - 1, 12, 31);
    }
    let mut m = 1;
    while n >= days_in_month(year, m) {
        n -= days_in_month(year, m);
        m += 1;
    }
    (year, m, n + 1)
}

const MAX_ORDINAL: i64 = 3652059;

// ------------------------------------------------------------ numbers

// int(data) for bytes: whitespace, a sign, digits with single underscores
// between them.
fn py_int(b: ref Vec[u8], base: i64) -> Option[i64] {
    let t = strip_ws(b);
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == 43 or t[i] == 45) {
        neg = t[i] == 45;
        i += 1;
    }
    if base == 16 and i + 1 < t.len() and t[i] == 48 and (t[i + 1] == 120 or t[i + 1] == 88) {
        i += 2;
        if i < t.len() and t[i] == 95 {
            i += 1;
        }
    }
    if i >= t.len() {
        return None;
    }
    let mut v = 0;
    let mut prev_digit = false;
    while i < t.len() {
        let c = t[i] as i64;
        if c == 95 {
            if not prev_digit or i + 1 >= t.len() {
                return None;
            }
            prev_digit = false;
            i += 1;
            continue;
        }
        let d = hex_val(chr(c));
        if d < 0 or d >= base {
            return None;
        }
        v = v * base + d;
        prev_digit = true;
        i += 1;
    }
    if not prev_digit {
        return None;
    }
    Some(if neg { -v } else { v })
}

// Digits with single underscores between them, from t[i]; the digits and
// where they stop.
fn digitpart(t: ref Vec[u8], at: i64) -> (String, i64) {
    let mut out = String.new();
    let mut i = at;
    while i < t.len() {
        let c = t[i];
        if c >= 48 and c <= 57 {
            out.push(chr(c as i64));
            i += 1;
        } else if c == 95 and out.len() > 0 and i + 1 < t.len() and t[i + 1] >= 48 and t[i + 1] <= 57 {
            i += 1;
        } else {
            break;
        }
    }
    (out, i)
}

// float(data) for bytes, over the decimal forms (no inf or nan).
fn py_float(b: ref Vec[u8]) -> Option[f64] {
    let t = strip_ws(b);
    let mut i = 0;
    let mut sign = String.new();
    if i < t.len() and (t[i] == 43 or t[i] == 45) {
        if t[i] == 45 {
            sign.push('-');
        }
        i += 1;
    }
    let (ip, j) = digitpart(t, i);
    i = j;
    let mut fp = String.new();
    if i < t.len() and t[i] == 46 {
        let (f, k) = digitpart(t, i + 1);
        fp = f;
        i = k;
    }
    if ip.len() == 0 and fp.len() == 0 {
        return None;
    }
    let mut ex = "0".to_string();
    if i < t.len() and (t[i] == 101 or t[i] == 69) {
        i += 1;
        let mut esign = String.new();
        if i < t.len() and (t[i] == 43 or t[i] == 45) {
            if t[i] == 45 {
                esign.push('-');
            }
            i += 1;
        }
        let (e, k) = digitpart(t, i);
        if e.len() == 0 {
            return None;
        }
        ex = f"{esign}{e}";
        i = k;
    }
    if i != t.len() {
        return None;
    }
    let ip2 = if ip.len() == 0 { "0".to_string() } else { ip };
    let fp2 = if fp.len() == 0 { "0".to_string() } else { fp };
    match f64.parse(f"{sign}{ip2}.{fp2}e{ex}") {
        Ok(x) => Some(x),
        Err(_) => None,
    }
}

fn float_error(b: ref Vec[u8]) -> Exc {
    value_error(f"could not convert string to float: {bytes_repr(b)}")
}

// ------------------------------------------------------------ memo files

// An open memo file: 0 a FakeMemoFile, 1 Visual FoxPro (.fpt), 2 dBase
// III and 3 dBase IV (.dbt).
struct Memo {
    kind: i64,
    data: Vec[u8],
    blocksize: i64,
}

fn fake_memo() -> Memo {
    Memo { kind: 0, data: Vec.new(), blocksize: 0 }
}

fn ends_with_ci(s: ref String, ext: Str) -> bool {
    s.to_lowercase().ends_with(ext)
}

// open_memofile(filename, dbversion)
fn open_memo(path: ref String, dbversion: i64) -> Result[Memo, Exc] {
    let data = match fs.read_bytes(path.clone()) {
        Ok(d) => d,
        Err(_) => return Err(not_found(path)),
    };
    if ends_with_ci(path, ".fpt") {
        if data.len() < 512 {
            return Err(struct_error(512));
        }
        let bs = u16be(data, 6);
        return Ok(Memo { kind: 1, data: data, blocksize: bs });
    }
    Ok(Memo { kind: if dbversion == 0x83 { 2 } else { 3 }, data: data, blocksize: 512 })
}

// memofile[index]
fn memo_get(m: ref Memo, index: i64) -> Result[Val, Exc] {
    if m.kind == 0 or index <= 0 {
        return Ok(Val.Non);
    }
    let n = m.data.len();
    if m.kind == 1 {
        let at = index * m.blocksize;
        if at + 8 > n {
            return Err(struct_error(8));
        }
        let t = u32be(m.data, at);
        let len = u32be(m.data, at + 4);
        if at + 8 + len > n {
            return Err(exc("OSError", "EOF reached while reading memo".to_string()));
        }
        let k = if t == 0 { B_PICTURE } else if t == 1 { B_TEXT } else if t == 2 { B_OBJECT } else { B_BINARY };
        return Ok(Val.Bytes(sub(m.data, at + 8, at + 8 + len), k));
    }
    if m.kind == 2 {
        let at = index * 512;
        let mut end = at;
        loop {
            if end >= n {
                return Ok(Val.Bytes(sub(m.data, at, n), B_PLAIN));
            }
            end = if end + 512 > n { n } else { end + 512 };
            let mut i = at;
            while i < end {
                if m.data[i] == 0x1a {
                    return Ok(Val.Bytes(sub(m.data, at, i), B_PLAIN));
                }
                i += 1;
            }
        }
    }
    let at = index * 512;
    if at + 8 > n {
        return Err(struct_error(8));
    }
    let len = u32le(m.data, at + 4);
    let body = sub(m.data, at + 8, at + 8 + len);
    let cut = find_byte(body, 0x1f);
    Ok(Val.Bytes(if cut >= 0 { sub(body, 0, cut) } else { body }, B_PLAIN))
}

// ------------------------------------------------------------ field parser

// What a FieldParser needs from its table, and which subclass it is:
// "" for FieldParser itself, or one of the three the jobs name.
struct Ctx {
    dbversion: i64,
    encoding: String,
    errors: String,
    parser: String,
}

fn supported(c: ref Ctx, t: ref String) -> bool {
    "0CDFILMNOTYBGPV+@".contains(t.as_str()) and t.len() == 1 or (c.parser == "hexx" and t == "X")
}

fn memo_index(data: ref Vec[u8]) -> Result[i64, Exc] {
    if data.len() == 4 {
        return Ok(u32le(data, 0));
    }
    match py_int(data, 10) {
        Some(n) => Ok(n),
        None => {
            if strip_set(data, bytes_of(" \x00"), true).len() == 0 {
                Ok(0)
            } else {
                Err(value_error(f"Memo index is not an integer: {bytes_repr(data)}"))
            }
        }
    }
}

fn decode_text(c: ref Ctx, b: ref Vec[u8]) -> Result[String, Exc] {
    decode(b, c.encoding, c.errors)
}

fn parse_c(c: ref Ctx, data: ref Vec[u8]) -> Result[Val, Exc] {
    Ok(Val.Str(decode_text(c, strip_set(data, bytes_of("\x00 "), false))?))
}

fn parse_d(data: ref Vec[u8]) -> Result[Val, Exc] {
    let y = py_int(sub(data, 0, 4), 10);
    let m = py_int(sub(data, 4, 6), 10);
    let d = py_int(sub(data, 6, 8), 10);
    match (y, m, d) {
        (Some(y), Some(m), Some(d)) => {
            if valid_date(y, m, d) {
                return Ok(Val.Date(y, m, d));
            }
        }
        _ => {}
    }
    if strip_set(data, bytes_of(" 0"), true).len() == 0 {
        Ok(Val.Non)
    } else {
        Err(value_error(f"invalid date {bytes_repr(data)}"))
    }
}

fn parse_t(data: ref Vec[u8]) -> Result[Val, Exc] {
    if strip_ws(data).len() == 0 {
        return Ok(Val.Non);
    }
    if data.len() != 8 {
        return Err(struct_error(8));
    }
    let day = u32le(data, 0);
    let msec = u32le(data, 4);
    if day == 0 {
        return Ok(Val.Non);
    }
    let ord = day - 1721425;
    if ord > 2147483647 {
        return Err(exc("OverflowError", "signed integer is greater than maximum".to_string()));
    }
    if ord < 1 {
        return Err(value_error("ordinal must be >= 1".to_string()));
    }
    if ord > MAX_ORDINAL {
        let (y, _, _) = ord2ymd(ord);
        return Err(value_error(f"year {y} is out of range"));
    }
    let days = ord + msec / 86400000;
    let rest = msec % 86400000;
    if days > MAX_ORDINAL {
        return Err(exc("OverflowError", "date value out of range".to_string()));
    }
    let (y, m, d) = ord2ymd(days);
    let secs = rest / 1000;
    Ok(Val.Dt(y, m, d, secs / 3600, (secs / 60) % 60, secs % 60, (rest % 1000) * 1000))
}

fn parse_l(data: ref Vec[u8]) -> Result[Val, Exc] {
    if bytes_in(data, "TtYy") {
        Ok(Val.Bool(true))
    } else if bytes_in(data, "FfNn") {
        Ok(Val.Bool(false))
    } else if bytes_in(data, "? ") {
        Ok(Val.Non)
    } else {
        Err(value_error(f"Illegal value for logical field: {bytes_repr(data)}"))
    }
}

fn parse_n(data0: ref Vec[u8]) -> Result[Val, Exc] {
    let data = strip_set(strip_ws(data0), bytes_of("*"), true);
    match py_int(data, 10) {
        Some(n) => Ok(Val.Int(n)),
        None => {
            if strip_ws(data).len() == 0 {
                return Ok(Val.Non);
            }
            let fixed = replace_byte(data, 44, 46);
            match py_float(fixed) {
                Some(x) => Ok(Val.Float(x)),
                None => Err(float_error(fixed)),
            }
        }
    }
}

fn parse_f(data0: ref Vec[u8]) -> Result[Val, Exc] {
    let data = strip_set(strip_ws(data0), bytes_of("*"), true);
    if data.len() == 0 {
        return Ok(Val.Non);
    }
    match py_float(data) {
        Some(x) => Ok(Val.Float(x)),
        None => Err(float_error(data)),
    }
}

fn parse_m(c: ref Ctx, memo: ref Memo, data: ref Vec[u8]) -> Result[Val, Exc] {
    let v = memo_get(memo, memo_index(data)?)?;
    match v {
        Val.Bytes(b, k) => {
            if k == B_PICTURE or k == B_OBJECT or k == B_BINARY {
                Ok(Val.Bytes(b, k))
            } else {
                Ok(Val.Str(decode_text(c, b)?))
            }
        }
        other => Ok(other),
    }
}

// The library's own parse(), one method a field type.
fn base_parse(c: ref Ctx, memo: ref Memo, t: ref String, data: ref Vec[u8]) -> Result[Val, Exc] {
    if t == "0" {
        Ok(Val.Bytes(data.clone(), B_PLAIN))
    } else if t == "C" {
        if c.parser == "reverse" {
            // examples/custom_field_type.py: parseC reverses the text. A
            // V field still has the library's parseC, bound before.
            let s = decode(strip_set(data, bytes_of(" 0"), false), "utf-8".to_string(), "strict".to_string())?;
            let cs: Vec[char] = s.chars().collect();
            let mut out = String.new();
            let mut i = cs.len() - 1;
            while i >= 0 {
                out.push(cs[i]);
                i -= 1;
            }
            return Ok(Val.Str(out));
        }
        parse_c(c, data)
    } else if t == "V" {
        parse_c(c, data)
    } else if t == "D" {
        parse_d(data)
    } else if t == "F" {
        parse_f(data)
    } else if t == "I" or t == "+" {
        if data.len() != 4 {
            return Err(struct_error(4));
        }
        Ok(Val.Int(i32le(data, 0)))
    } else if t == "L" {
        parse_l(data)
    } else if t == "M" {
        parse_m(c, memo, data)
    } else if t == "N" {
        parse_n(data)
    } else if t == "O" {
        if data.len() != 8 {
            return Err(struct_error(8));
        }
        Ok(Val.Float(f64le(data, 0)))
    } else if t == "T" or t == "@" {
        parse_t(data)
    } else if t == "Y" {
        if data.len() != 8 {
            return Err(struct_error(8));
        }
        let mut co = i64le(data, 0);
        let mut ex = -4;
        while ex < 0 and co % 10 == 0 {
            co = co / 10;
            ex += 1;
        }
        Ok(Val.Dec(co, ex))
    } else if t == "B" {
        if c.dbversion >= 0x30 and c.dbversion <= 0x32 {
            if data.len() != 8 {
                return Err(struct_error(8));
            }
            return Ok(Val.Float(f64le(data, 0)));
        }
        memo_get(memo, memo_index(data)?)
    } else if t == "G" or t == "P" {
        memo_get(memo, memo_index(data)?)
    } else if t == "X" and c.parser == "hexx" {
        // A vendor's 'X' field: a hexadecimal counter.
        let d = strip_ws(data);
        if d.len() == 0 {
            return Ok(Val.Non);
        }
        match py_int(d, 16) {
            Some(n) => Ok(Val.Int(n)),
            None => Err(value_error(f"invalid literal for int() with base 16: {bytes_repr(d)}")),
        }
    } else {
        Err(value_error(f"Unknown field type: {str_repr(t)}"))
    }
}

// parser.parse(field, data), with print_invalid_values.py's subclass
// turning a ValueError into an InvalidValue.
fn parse_field(c: ref Ctx, memo: ref Memo, t: ref String, data: ref Vec[u8]) -> Result[Val, Exc] {
    match base_parse(c, memo, t, data) {
        Ok(v) => Ok(v),
        Err(e) => {
            if c.parser == "lenient" and is_value_error(e) {
                Ok(Val.Bytes(data.clone(), B_INVALID))
            } else {
                Err(e)
            }
        }
    }
}

// ------------------------------------------------------------ ifiles

fn last_slash(s: ref String) -> i64 {
    let cs: Vec[char] = s.chars().collect();
    let mut i = cs.len() - 1;
    while i >= 0 {
        if cs[i] == '/' {
            return i;
        }
        i -= 1;
    }
    -1
}

// os.path.split(p), for paths without repeated slashes.
fn path_split(p: ref String) -> (String, String) {
    let cs: Vec[char] = p.chars().collect();
    let i = last_slash(p);
    if i < 0 {
        return (String.new(), p.clone());
    }
    let mut head = String.new();
    let mut tail = String.new();
    let mut k = 0;
    while k < cs.len() {
        if k < i {
            head.push(cs[k]);
        } else if k > i {
            tail.push(cs[k]);
        }
        k += 1;
    }
    if i == 0 {
        head.push('/');
    }
    (head, tail)
}

fn path_join(dir: ref String, name: ref String) -> String {
    if dir.len() == 0 {
        name.clone()
    } else if dir.ends_with("/") {
        f"{dir}{name}"
    } else {
        f"{dir}/{name}"
    }
}

// os.path.splitext(p)[0]: drops the last extension of the base name,
// unless the only dots lead it.
fn strip_ext(p: ref String) -> String {
    let (head, tail) = path_split(p);
    let cs: Vec[char] = tail.chars().collect();
    let mut first = 0;
    while first < cs.len() and cs[first] == '.' {
        first += 1;
    }
    let mut dot = -1;
    let mut i = first;
    while i < cs.len() {
        if cs[i] == '.' {
            dot = i;
        }
        i += 1;
    }
    if dot < 0 {
        return p.clone();
    }
    let mut base = String.new();
    let mut k = 0;
    while k < dot {
        base.push(cs[k]);
        k += 1;
    }
    let cut = p.len() - tail.len();
    let _ = head;
    f"{p.substring(0, cut)}{base}"
}

// ipat(): every cased character becomes [Uu], its upper and lower case.
fn ipat(pat: ref String) -> String {
    let (dirname, base) = path_split(pat);
    let mut out = String.new();
    for c in base.chars() {
        let s = c.to_string();
        let u = s.to_uppercase();
        let l = s.to_lowercase();
        if u != l {
            out.push('[');
            out.push_str(u);
            out.push_str(l);
            out.push(']');
        } else {
            out.push(c);
        }
    }
    path_join(dirname, out)
}

// fnmatch.fnmatch(name, pat) on POSIX: *, ? and [...] sets.
fn fn_match(name: ref Vec[char], i: i64, pat: ref Vec[char], j: i64) -> bool {
    if j == pat.len() {
        return i == name.len();
    }
    let p = pat[j];
    if p == '*' {
        let mut k = i;
        while k <= name.len() {
            if fn_match(name, k, pat, j + 1) {
                return true;
            }
            k += 1;
        }
        return false;
    }
    if p == '?' {
        return i < name.len() and fn_match(name, i + 1, pat, j + 1);
    }
    if p == '[' {
        // Find the closing bracket; a ']' first in the set is literal.
        let mut k = j + 1;
        if k < pat.len() and pat[k] == '!' {
            k += 1;
        }
        if k < pat.len() and pat[k] == ']' {
            k += 1;
        }
        while k < pat.len() and pat[k] != ']' {
            k += 1;
        }
        if k < pat.len() {
            if i >= name.len() {
                return false;
            }
            let mut s = j + 1;
            let negate = pat[s] == '!';
            if negate {
                s += 1;
            }
            let c = name[i];
            let mut hit = false;
            let mut q = s;
            while q < k {
                if q + 2 < k and pat[q + 1] == '-' {
                    if c >= pat[q] and c <= pat[q + 2] {
                        hit = true;
                    }
                    q += 3;
                } else {
                    if c == pat[q] {
                        hit = true;
                    }
                    q += 1;
                }
            }
            return hit != negate and fn_match(name, i + 1, pat, k + 1);
        }
        // No closing bracket: a literal '['.
    }
    i < name.len() and name[i] == p and fn_match(name, i + 1, pat, j + 1)
}

fn fnmatch(name: ref String, pat: ref String) -> bool {
    let n: Vec[char] = name.chars().collect();
    let p: Vec[char] = pat.chars().collect();
    fn_match(n, 0, p, 0)
}

fn has_magic(s: ref String) -> bool {
    s.contains("*") or s.contains("?") or s.contains("[")
}

// glob.glob(pattern) when only the base name may hold wildcards; the
// directory's entries come back sorted, and the jobs never let two match.
fn glob(pattern: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let (dirname, base) = path_split(pattern);
    if not has_magic(base) {
        if base.len() > 0 and fs.exists(pattern.clone()) {
            out.push(pattern.clone());
        }
        return out;
    }
    let dir = if dirname.len() == 0 { ".".to_string() } else { dirname.clone() };
    let names = match fs.read_dir(dir) {
        Ok(ns) => ns,
        Err(_) => return out,
    };
    for name in names {
        if name.starts_with(".") and not base.starts_with(".") {
            continue;
        }
        if fnmatch(name, base) {
            out.push(path_join(dirname, name));
        }
    }
    out
}

// ifind(pat, ext)
fn ifind(pat: ref String, ext: ref String) -> Option[String] {
    let p = if ext.len() > 0 { f"{strip_ext(pat)}{ext}" } else { pat.clone() };
    let files = glob(ipat(p));
    if files.len() > 0 { Some(files[0].clone()) } else { None }
}

// ------------------------------------------------------------ tables

const VERSIONS: Str = "02 FoxBASE|03 FoxBASE+/Dbase III plus, no memory|30 Visual FoxPro|31 Visual FoxPro, autoincrement enabled|32 Visual FoxPro with field type Varchar or Varbinary|43 dBASE IV SQL table files, no memo|63 dBASE IV SQL system files, no memo|83 FoxBASE+/dBASE III PLUS, with memo|8b dBASE IV with memo|cb dBASE IV SQL table files, with memo|f5 FoxPro 2.x (or earlier) with memo|e5 HiPer-Six format with SMT memo file|fb FoxBASE";

const CODEPAGES: Str = "00 ascii|01 cp437|02 cp850|03 cp1252|04 mac_roman|08 cp865|09 cp437|0a cp850|0b cp437|0d cp437|0e cp850|0f cp437|10 cp850|11 cp437|12 cp850|13 cp932|14 cp850|15 cp437|16 cp850|17 cp865|18 cp437|19 cp437|1a cp850|1b cp437|1c cp863|1d cp850|1f cp852|22 cp852|23 cp852|24 cp860|25 cp850|26 cp866|37 cp850|40 cp852|4d cp936|4e cp949|4f cp950|50 cp874|57 cp1252|58 cp1252|59 cp1252|64 cp852|65 cp866|66 cp865|67 cp861|6a cp737|6b cp857|78 cp950|79 cp949|7a cp936|7b cp932|7c cp874|7d cp1255|7e cp1256|c8 cp1250|c9 cp1251|ca cp1254|cb cp1253|96 mac_cyrillic|97 mac_latin2|98 mac_greek";

fn table_lookup(table: Str, key: i64) -> Option[String] {
    let k = hex2(key);
    for entry in split_on(table.to_string(), '|') {
        if entry.substring(0, 2) == k {
            return Some(entry.substring(3, entry.len()));
        }
    }
    None
}

fn dbversion_string(v: i64) -> String {
    match table_lookup(VERSIONS, v) {
        Some(s) => s,
        None => f"Unknown (0x{hex2(v)})",
    }
}

fn guess_encoding(lang: i64) -> Result[String, Exc] {
    match table_lookup(CODEPAGES, lang) {
        Some(s) => Ok(s),
        None => Err(exc("LookupError", f"Unable to guess encoding for languager driver byte 0x{hexn(lang, 1)}")),
    }
}

#[derive(Clone)]
struct Field {
    name: String,
    ftype: String,
    address: i64,
    length: i64,
    decimal_count: i64,
    raw: Vec[u8],
}

// DBF()'s keyword arguments, and the jobs' rec= and parser=.
#[derive(Clone)]
struct Opts {
    encoding: String,
    ignorecase: bool,
    lowernames: bool,
    load: bool,
    raw: bool,
    ignore_missing: bool,
    errors: String,
    rec: String,
    parser: String,
}

fn default_opts() -> Opts {
    Opts {
        encoding: String.new(),
        ignorecase: true,
        lowernames: false,
        load: false,
        raw: false,
        ignore_missing: false,
        errors: "strict".to_string(),
        rec: "ordered".to_string(),
        parser: String.new(),
    }
}

fn opts_of(parts: ref Vec[String], from: i64) -> Opts {
    let mut o = default_opts();
    let mut i = from;
    while i < parts.len() {
        let p = parts[i].clone();
        let at = match p.find("=") {
            Some(k) => k,
            None => p.len(),
        };
        let k = p.substring(0, at);
        let v = p.substring(at + 1, p.len());
        if k == "rec" {
            o.rec = v;
        } else if k == "parser" {
            o.parser = v;
        } else if k == "lowernames" {
            o.lowernames = v == "1";
        } else if k == "ignorecase" {
            o.ignorecase = v == "1";
        } else if k == "load" {
            o.load = v == "1";
        } else if k == "raw" {
            o.raw = v == "1";
        } else if k == "ignore_missing_memofile" {
            o.ignore_missing = v == "1";
        } else if k == "encoding" {
            o.encoding = v;
        } else if k == "char_decode_errors" {
            o.errors = v;
        }
        i += 1;
    }
    o
}

// A record: the field names and values in order.
#[derive(Clone)]
struct Rec {
    names: Vec[String],
    vals: Vec[Val],
}

struct Table {
    name: String,
    filename: String,
    memofilename: Option[String],
    header: Vec[u8],
    dbversion: i64,
    numrecords: i64,
    headerlen: i64,
    recordlen: i64,
    date: Val,
    encoding: String,
    fields: Vec[Field],
    o: Opts,
    loaded: bool,
    records: Vec[Rec],
    deleted: Vec[Rec],
}

fn read_file(path: ref String) -> Result[Vec[u8], Exc] {
    match fs.read_bytes(path.clone()) {
        Ok(d) => Ok(d),
        Err(_) => Err(not_found(path)),
    }
}

fn ctx_of(t: ref Table) -> Ctx {
    Ctx { dbversion: t.dbversion, encoding: t.encoding.clone(), errors: t.o.errors.clone(), parser: t.o.parser.clone() }
}

// DBF(filename, ...)
fn open_dbf(filename: ref String, o: ref Opts) -> Result[Table, Exc] {
    let (_, base) = path_split(filename);
    let name = strip_ext(base).to_lowercase();
    let found = if o.ignorecase {
        match ifind(filename, String.new()) {
            Some(f) => f,
            None => return Err(exc("dbfread.exceptions.DBFNotFound", f"could not find file {str_repr(filename)}")),
        }
    } else {
        filename.clone()
    };
    let data = read_file(found)?;
    if data.len() < 32 {
        return Err(struct_error(32));
    }
    let header = sub(data, 0, 32);
    let lang = data[29] as i64;
    let encoding = if o.encoding.len() > 0 {
        o.encoding.clone()
    } else {
        match guess_encoding(lang) {
            Ok(e) => e,
            Err(_) => "ascii".to_string(),
        }
    };
    let mut t = Table {
        name: name,
        filename: found,
        memofilename: None,
        header: header,
        dbversion: data[0] as i64,
        numrecords: u32le(data, 4),
        headerlen: u16le(data, 8),
        recordlen: u16le(data, 10),
        date: Val.Non,
        encoding: encoding,
        fields: Vec.new(),
        o: o.clone(),
        loaded: false,
        records: Vec.new(),
        deleted: Vec.new(),
    };
    // The field descriptors, up to a \r or \n, or the end of the file.
    let mut pos = 32;
    loop {
        if pos >= data.len() or data[pos] == 13 or data[pos] == 10 {
            break;
        }
        if pos + 32 > data.len() {
            return Err(struct_error(32));
        }
        let raw = sub(data, pos, pos + 32);
        pos += 32;
        let ftype = chr(raw[11] as i64).to_string();
        let mut length = raw[16] as i64;
        let mut dec = raw[17] as i64;
        if ftype == "C" {
            length = length + dec * 256;
            dec = 0;
        }
        let nul = find_byte(raw, 0);
        let nb = sub(raw, 0, if nul >= 0 and nul < 11 { nul } else { 11 });
        let mut fname = decode(nb, t.encoding, o.errors)?;
        if o.lowernames {
            fname = fname.to_lowercase();
        }
        t.fields.push(Field { name: fname, ftype: ftype, address: u32le(raw, 12), length: length, decimal_count: dec, raw: raw });
    }
    // _check_headers()
    let c = ctx_of(t);
    for f in t.fields {
        if f.ftype == "I" and f.length != 4 {
            return Err(value_error(f"Field type I must have length 4 (was {f.length})"));
        } else if f.ftype == "L" and f.length != 1 {
            return Err(value_error(f"Field type L must have length 1 (was {f.length})"));
        } else if not supported(c, f.ftype) {
            return Err(value_error(f"Unknown field type: {str_repr(f.ftype)}"));
        }
    }
    let y = data[1] as i64;
    let year = if y < 80 { 2000 + y } else { 1900 + y };
    let (m, d) = (data[2] as i64, data[3] as i64);
    if valid_date(year, m, d) {
        t.date = Val.Date(year, m, d);
    }
    // _get_memofilename()
    let mut memo = false;
    for f in t.fields {
        if "MGPB".contains(f.ftype.as_str()) {
            memo = true;
        }
    }
    if memo {
        let mut path: Option[String] = ifind(t.filename, ".fpt".to_string());
        if path.is_none() {
            path = ifind(t.filename, ".dbt".to_string());
        }
        match path {
            Some(p) => t.memofilename = Some(p),
            None => {
                if not o.ignore_missing {
                    return Err(exc("dbfread.exceptions.MissingMemoFile", f"missing memo file for {t.filename}"));
                }
            }
        }
    }
    if o.load {
        load(mut t)?;
    }
    Ok(t)
}

// _iter_records(record_type): the records go to `out` as they are read,
// so a parse error leaves the records before it there.
fn iter_records(t: ref Table, flag: u8, out: mut ref Vec[Rec]) -> Result[(), Exc] {
    let data = read_file(t.filename)?;
    let memo = match t.memofilename.clone() {
        Some(p) => if t.o.raw { fake_memo() } else { open_memo(p, t.dbversion)? },
        None => fake_memo(),
    };
    let c = ctx_of(t);
    let mut pos = t.headerlen;
    loop {
        if pos >= data.len() {
            break;
        }
        let sep = data[pos];
        pos += 1;
        if sep == flag {
            let mut r = Rec { names: Vec.new(), vals: Vec.new() };
            for f in t.fields {
                let chunk = sub(data, pos, pos + f.length);
                pos += f.length;
                r.names.push(f.name.clone());
                if t.o.raw {
                    r.vals.push(Val.Bytes(chunk, B_PLAIN));
                } else {
                    r.vals.push(parse_field(c, memo, f.ftype, chunk)?);
                }
            }
            out.push(r);
        } else if sep == 0x1a {
            break;
        } else {
            pos += t.recordlen - 1;
        }
    }
    Ok(())
}

// Every record of one kind, printing each as it comes, as the jobs that
// walk a table do; the error, if any, after the records before it.
fn walk(t: ref Table, flag: u8, show: bool) -> Result[Vec[Rec], Exc] {
    let mut got: Vec[Rec] = Vec.new();
    let r = if t.loaded {
        got = if flag == 32 { t.records.clone() } else { t.deleted.clone() };
        Ok(())
    } else {
        iter_records(t, flag, mut got)
    };
    if show {
        let mut first = true;
        for rec in got {
            if first {
                println(f"  type: {rec_type(t)}");
                first = false;
            }
            println(f"  {rec_repr(t, rec)}");
        }
    }
    r?;
    Ok(got)
}

fn count_records(t: ref Table, flag: u8) -> Result[i64, Exc] {
    if t.loaded {
        return Ok(if flag == 32 { t.records.len() } else { t.deleted.len() });
    }
    let data = read_file(t.filename)?;
    let mut pos = t.headerlen;
    let mut n = 0;
    loop {
        if pos >= data.len() {
            break;
        }
        let sep = data[pos];
        pos += 1;
        if sep == flag {
            n += 1;
            pos += t.recordlen - 1;
        } else if sep == 0x1a {
            break;
        } else {
            pos += t.recordlen - 1;
        }
    }
    Ok(n)
}

fn load(t: mut ref Table) -> Result[(), Exc] {
    if not t.loaded {
        let mut rs: Vec[Rec] = Vec.new();
        iter_records(t, 32, mut rs)?;
        let mut ds: Vec[Rec] = Vec.new();
        iter_records(t, 42, mut ds)?;
        t.records = rs;
        t.deleted = ds;
        t.loaded = true;
    }
    Ok(())
}

fn unload(t: mut ref Table) {
    t.records = Vec.new();
    t.deleted = Vec.new();
    t.loaded = false;
}

fn table_repr(t: ref Table) -> String {
    let status = if t.loaded { "loaded" } else { "unloaded" };
    f"<{status} DBF table {str_repr(t.filename)}>"
}

fn rec_type(t: ref Table) -> String {
    if t.o.rec == "dict" {
        "dict".to_string()
    } else if t.o.rec == "none" {
        "list".to_string()
    } else {
        "OrderedDict".to_string()
    }
}

// The jobs print a dict record as a plain dict, and recfactory=None's
// list of (name, value) pairs as it is.
fn rec_repr(t: ref Table, r: ref Rec) -> String {
    let mut parts: Vec[String] = Vec.new();
    let mut i = 0;
    let list = t.o.rec == "none";
    while i < r.names.len() {
        if list {
            parts.push(f"({str_repr(r.names[i])}, {val_repr(r.vals[i])})");
        } else {
            parts.push(f"{str_repr(r.names[i])}: {val_repr(r.vals[i])}");
        }
        i += 1;
    }
    if list {
        f"[{join_strs(parts, ", ")}]"
    } else {
        f"{{{join_strs(parts, ", ")}}}"
    }
}

fn get(r: ref Rec, name: Str) -> Val {
    let mut i = 0;
    while i < r.names.len() {
        if r.names[i] == name {
            return r.vals[i].clone();
        }
        i += 1;
    }
    Val.Non
}

// ------------------------------------------------------------ the programs

// examples/dbfinfo.py
fn dbfinfo(paths: ref Vec[String]) -> Result[(), Exc] {
    let mut o = default_opts();
    o.ignore_missing = true;
    for p in paths {
        println(f"{p}:");
        let t = open_dbf(p, o)?;
        println(f"  Name: {t.name}");
        let memo = match t.memofilename.clone() {
            Some(m) => m,
            None => String.new(),
        };
        println(f"  Memo File: {memo}");
        println(f"  DB Version: {dbversion_string(t.dbversion)}");
        println(f"  Records: {count_records(t, 32)?}");
        println(f"  Deleted Records: {count_records(t, 42)?}");
        println(f"  Last Updated: {val_str(t.date)}");
        println(f"  Character Encoding: {t.encoding}");
        println("  Fields:");
        for f in t.fields {
            println(f"    {f.name} ({f.ftype} {f.length})");
        }
    }
    Ok(())
}

// examples/print_invalid_values.py
fn invalid(path: ref String) -> Result[(), Exc] {
    let mut o = default_opts();
    o.parser = "lenient".to_string();
    let t = open_dbf(path, o)?;
    let mut got: Vec[Rec] = Vec.new();
    let r = iter_records(t, 32, mut got);
    let mut i = 0;
    for rec in got {
        let mut k = 0;
        while k < rec.names.len() {
            match rec.vals[k] {
                Val.Bytes(_, kind) => {
                    if kind == B_INVALID {
                        println(f"records[{i}][{str_repr(rec.names[k])}] == {val_repr(rec.vals[k])}");
                    }
                }
                _ => {}
            }
            k += 1;
        }
        i += 1;
    }
    r
}

// examples/custom_field_type.py
fn reverse(path: ref String) -> Result[(), Exc] {
    let mut o = default_opts();
    o.parser = "reverse".to_string();
    let t = open_dbf(path, o)?;
    let mut got: Vec[Rec] = Vec.new();
    let r = iter_records(t, 32, mut got);
    for rec in got {
        println(val_str(get(rec, "NAME")));
    }
    r
}

fn csv_field(v: ref Val) -> String {
    let s = match v {
        Val.Non => String.new(),
        _ => val_str(v),
    };
    if s.contains(",") or s.contains("\"") or s.contains("\n") or s.contains("\r") {
        let mut out = String.new();
        out.push('"');
        for c in s.chars() {
            if c == '"' {
                out.push('"');
            }
            out.push(c);
        }
        out.push('"');
        out
    } else {
        s
    }
}

fn csv_row(vals: ref Vec[Val]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for v in vals {
        parts.push(csv_field(v));
    }
    join_strs(parts, ",")
}

fn dirname_of(path: ref String) -> String {
    let (head, _) = path_split(path);
    head
}

fn write_text(path: ref String, text: ref String) -> Result[(), Exc] {
    let _ = fs.create_dir_all(dirname_of(path));
    match fs.write(path.clone(), text.clone()) {
        Ok(_) => Ok(()),
        Err(_) => Err(not_found(path)),
    }
}

// Exports a table as CSV: a header row of field names and a row a record,
// as the library's print_csv.py example does. A record that fails to
// parse leaves the rows before it in the file.
fn to_csv(path: ref String, dest: ref String, o: ref Opts) -> Result[(), Exc] {
    let t = open_dbf(path, o)?;
    let mut names: Vec[Val] = Vec.new();
    for f in t.fields {
        names.push(Val.Str(f.name.clone()));
    }
    let mut text = csv_row(names);
    text.push('\n');
    let mut got: Vec[Rec] = Vec.new();
    let r = if t.loaded {
        got = t.records.clone();
        Ok(())
    } else {
        iter_records(t, 32, mut got)
    };
    for rec in got {
        text.push_str(csv_row(rec.vals));
        text.push('\n');
    }
    write_text(dest, text)?;
    r?;
    println(f"  wrote {dest} ({got.len()} rows)");
    Ok(())
}

fn json_str(s: ref String) -> String {
    let mut out = String.new();
    out.push('"');
    for c in s.chars() {
        let n = c as i64;
        if c == '"' {
            out.push_str("\\\"");
        } else if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if n == 8 {
            out.push_str("\\b");
        } else if n == 12 {
            out.push_str("\\f");
        } else if n < 32 {
            out.push_str("\\u");
            out.push_str(hexn(n, 4));
        } else {
            out.push(c);
        }
    }
    out.push('"');
    out
}

fn json_val(v: ref Val) -> String {
    match v {
        Val.Non => "null".to_string(),
        Val.Bool(b) => if *b { "true".to_string() } else { "false".to_string() },
        Val.Int(n) => f"{n}",
        Val.Float(x) => f"{x}",
        _ => json_str(val_str(v)),
    }
}

// Exports a table as a JSON array of objects, indented by two; dates,
// timestamps, currency and binary memos become their str().
fn to_json(path: ref String, dest: ref String, o: ref Opts) -> Result[(), Exc] {
    let t = open_dbf(path, o)?;
    let rows = walk(t, 32, false)?;
    let mut text = String.new();
    if rows.len() == 0 {
        text.push_str("[]");
    } else {
        text.push_str("[\n");
        let mut i = 0;
        while i < rows.len() {
            text.push_str("  {\n");
            let r = rows[i].clone();
            let mut k = 0;
            while k < r.names.len() {
                text.push_str(f"    {json_str(r.names[k])}: {json_val(r.vals[k])}");
                if k + 1 < r.names.len() {
                    text.push(',');
                }
                text.push('\n');
                k += 1;
            }
            text.push_str("  }");
            if i + 1 < rows.len() {
                text.push(',');
            }
            text.push('\n');
            i += 1;
        }
        text.push(']');
    }
    text.push('\n');
    write_text(dest, text)?;
    println(f"  wrote {dest} ({rows.len()} records)");
    Ok(())
}

// Column types from the library's dbf2sqlite script, plus the ones it
// leaves to TEXT that a SQL database can hold better.
fn sql_type(t: ref String) -> String {
    let pairs = "F FLOAT|L BOOLEAN|I INTEGER|C TEXT|N REAL|M TEXT|D DATE|T DATETIME|0 INTEGER|Y NUMERIC|+ INTEGER|@ DATETIME|O FLOAT|V TEXT|G BLOB|P BLOB";
    for p in split_on(pairs.to_string(), '|') {
        if p.substring(0, 1) == t {
            return p.substring(2, p.len());
        }
    }
    "TEXT".to_string()
}

fn sql_literal(v: ref Val) -> String {
    match v {
        Val.Non => "NULL".to_string(),
        Val.Bool(b) => if *b { "1".to_string() } else { "0".to_string() },
        Val.Int(_) => val_str(v),
        Val.Float(_) => val_str(v),
        Val.Dec(_, _) => val_str(v),
        Val.Bytes(b, _) => f"X'{hex_upper(b)}'",
        Val.Date(_, _, _) => f"'{val_str(v)}'",
        Val.Dt(_, _, _, _, _, _, _) => f"'{val_str(v)}'",
        Val.Str(s) => {
            let mut out = "'".to_string();
            for c in s.chars() {
                if c == '\'' {
                    out.push('\'');
                }
                out.push(c);
            }
            out.push('\'');
            out
        }
    }
}

// Migrates tables to one SQL script, as dbf2sqlite does with its schema
// dump: a CREATE TABLE and an INSERT a record, each table in a
// transaction. A decode error stops the run before anything is written.
fn to_sql(dest: ref String, encoding: ref String, errors: ref String, paths: ref Vec[String]) -> Result[(), Exc] {
    let mut lines: Vec[String] = Vec.new();
    for p in paths {
        let mut o = default_opts();
        o.lowernames = true;
        o.encoding = if encoding == "-" { String.new() } else { encoding.clone() };
        o.errors = errors.clone();
        let got = match open_dbf(p, o) {
            Ok(t) => match walk(t, 32, false) {
                Ok(rows) => Ok((t, rows)),
                Err(e) => Err(e),
            },
            Err(e) => Err(e),
        };
        let (t, rows) = match got {
            Ok(x) => x,
            Err(e) => {
                if e.cls == "UnicodeDecodeError" {
                    println(f"  {err_line(e)}");
                    println("  Please use --encoding or --char-decode-errors.");
                    return Ok(());
                }
                return Err(e);
            }
        };
        let deleted = count_records(t, 42)?;
        lines.push(f"-- {p}: {dbversion_string(t.dbversion)}, {rows.len()} rows, {deleted} deleted records skipped");
        lines.push("BEGIN;".to_string());
        lines.push(f"DROP TABLE IF EXISTS \"{t.name}\";");
        let mut defs: Vec[String] = Vec.new();
        for f in t.fields {
            defs.push(f"\"{f.name}\" {sql_type(f.ftype)}");
        }
        lines.push(f"CREATE TABLE \"{t.name}\" ({join_strs(defs, ", ")});");
        for r in rows {
            let mut vs: Vec[String] = Vec.new();
            for v in r.vals {
                vs.push(sql_literal(v));
            }
            lines.push(f"INSERT INTO \"{t.name}\" VALUES ({join_strs(vs, ", ")});");
        }
        lines.push("COMMIT;".to_string());
    }
    let mut text = join_strs(lines, "\n");
    text.push('\n');
    write_text(dest, text)?;
    println(f"  wrote {dest} ({paths.len()} tables)");
    Ok(())
}

fn dt_key(v: ref Val) -> Vec[i64] {
    match v {
        Val.Dt(y, mo, d, h, mi, s, us) => vec![*y, *mo, *d, *h, *mi, *s, *us],
        _ => Vec.new(),
    }
}

fn key_greater(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    let mut i = 0;
    while i < a.len() and i < b.len() {
        if a[i] != b[i] {
            return a[i] > b[i];
        }
        i += 1;
    }
    a.len() > b.len()
}

#[derive(Clone)]
struct Account {
    name: String,
    orders: i64,
    total: Val,
    unpaid: Val,
    last: Val,
}

// The shop's month-end report from its order book: orders, totals, what
// is still unpaid and the last order date, a line a customer.
fn ledger(path: ref String, dest: ref String) -> Result[(), Exc] {
    let t = open_dbf(path, default_opts())?;
    let rows = walk(t, 32, false)?;
    let mut acc: Vec[Account] = Vec.new();
    for r in rows {
        let name = val_str(get(r, "CUSTOMER"));
        let mut at = -1;
        let mut i = 0;
        while i < acc.len() {
            if acc[i].name == name {
                at = i;
            }
            i += 1;
        }
        if at < 0 {
            acc.push(Account { name: name, orders: 0, total: Val.Dec(0, 0), unpaid: Val.Dec(0, 0), last: Val.Non });
            at = acc.len() - 1;
        }
        let total = get(r, "TOTAL");
        let paid = match get(r, "PAID") {
            Val.Bool(b) => b,
            _ => false,
        };
        let when = get(r, "ORDERED");
        acc[at].orders += 1;
        acc[at].total = dec_add(acc[at].total, total);
        if not paid {
            acc[at].unpaid = dec_add(acc[at].unpaid, total);
        }
        let later = match acc[at].last {
            Val.Non => true,
            _ => key_greater(dt_key(when), dt_key(acc[at].last)),
        };
        if later {
            acc[at].last = when;
        }
    }
    // sorted(by), by customer name.
    let mut order: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < acc.len() {
        let mut j = order.len();
        while j > 0 and acc[order[j - 1]].name > acc[i].name {
            j -= 1;
        }
        order.insert(j, i);
        i += 1;
    }
    let mut lines: Vec[String] = Vec.new();
    lines.push(f"{pad_right("customer", 12)} {pad_left("orders", 6)} {pad_left("total", 16)} {pad_left("unpaid", 14)}  last order");
    let mut grand = Val.Dec(0, 0);
    let mut count = 0;
    for k in order {
        let a = acc[k].clone();
        grand = dec_add(grand, a.total);
        count += a.orders;
        let last = match a.last {
            Val.Dt(y, mo, d, h, mi, _, _) => f"{date_str(y, mo, d)} {zpad(h, 2)}:{zpad(mi, 2)}",
            _ => String.new(),
        };
        lines.push(f"{pad_right(a.name, 12)} {pad_left(f"{a.orders}", 6)} {pad_left(val_str(a.total), 16)} {pad_left(val_str(a.unpaid), 14)}  {last}");
    }
    lines.push(f"{pad_right("all", 12)} {pad_left(f"{count}", 6)} {pad_left(val_str(grand), 16)}");
    let mut text = join_strs(lines, "\n");
    text.push('\n');
    write_text(dest, text)?;
    println(f"  wrote {dest}");
    Ok(())
}

fn cat(path: ref String) {
    let text = match fs.read_to_string(path.clone()) {
        Ok(s) => s,
        Err(_) => {
            println(f"  {err_line(not_found(path))}");
            return;
        }
    };
    // open() in text mode reads with universal newlines: "\r\n" and a
    // lone "\r" both come back as "\n".
    let mut norm = String.new();
    let mut after_cr = false;
    for c in text.chars() {
        if c == '\r' {
            norm.push('\n');
            after_cr = true;
        } else {
            if not (c == '\n' and after_cr) {
                norm.push(c);
            }
            after_cr = false;
        }
    }
    let mut lines = split_on(norm, '\n');
    if lines.len() > 0 and lines[lines.len() - 1].len() == 0 {
        lines.pop();
    }
    println(f"  {path} ({lines.len()} lines)");
    for ln in lines {
        println(f"  | {ln}");
    }
}

// ------------------------------------------------------------ the jobs

fn opt_repr(s: ref Option[String]) -> String {
    match s {
        Some(x) => str_repr(x),
        None => "None".to_string(),
    }
}

fn header_repr(h: ref Vec[u8]) -> String {
    f"DBFHeader(dbversion={h[0]}, year={h[1]}, month={h[2]}, day={h[3]}, numrecords={u32le(h, 4)}, headerlen={u16le(h, 8)}, recordlen={u16le(h, 10)}, reserved1={u16le(h, 12)}, incomplete_transaction={h[14]}, encryption_flag={h[15]}, free_record_thread={u32le(h, 16)}, reserved2={u32le(h, 20)}, reserved3={u32le(h, 24)}, mdx_flag={h[28]}, language_driver={h[29]}, reserved4={u16le(h, 30)})"
}

fn field_repr(f: ref Field) -> String {
    let r = f.raw.clone();
    f"DBFField(name={str_repr(f.name)}, type={str_repr(f.ftype)}, address={f.address}, length={f.length}, decimal_count={f.decimal_count}, reserved1={u16le(r, 18)}, workarea_id={r[20]}, reserved2={r[21]}, reserved3={r[22]}, set_fields_flag={r[23]}, reserved4={bytes_repr(sub(r, 24, 31))}, index_field_flag={r[31]})"
}

fn names_repr(t: ref Table) -> String {
    let mut parts: Vec[String] = Vec.new();
    for f in t.fields {
        parts.push(str_repr(f.name));
    }
    f"[{join_strs(parts, ", ")}]"
}

fn py_bool(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

fn iter_name(t: ref Table) -> String {
    if t.loaded { "list".to_string() } else { "RecordIterator".to_string() }
}

fn run(parts: ref Vec[String]) -> Result[(), Exc] {
    let verb = parts[0].clone();
    if verb == "version" {
        println("  2.0.7");
        println("  VersionInfo(major=2, minor=0, micro=7, releaselevel='', serial=0)");
    } else if verb == "dbversion" {
        println(f"  {dbversion_string(atoi(parts[1]))}");
    } else if verb == "codepage" {
        match guess_encoding(atoi(parts[1])) {
            Ok(e) => println(f"  {e}"),
            Err(e) => println(f"  {err_line(e)}"),
        }
    } else if verb == "info" {
        let t = open_dbf(parts[1], opts_of(parts, 2))?;
        println(f"  repr: {table_repr(t)}");
        println(f"  name: {str_repr(t.name)}");
        println(f"  filename: {str_repr(t.filename)}");
        println(f"  memofilename: {opt_repr(t.memofilename)}");
        println(f"  dbversion: {dbversion_string(t.dbversion)}");
        println(f"  date: {val_repr(t.date)}");
        println(f"  encoding: {t.encoding}");
        println(f"  field_names: {names_repr(t)}");
        println(f"  loaded: {py_bool(t.loaded)}");
        let n = count_records(t, 32)?;
        let d = count_records(t, 42)?;
        println(f"  len: {n} deleted: {d}");
    } else if verb == "header" {
        let t = open_dbf(parts[1], opts_of(parts, 2))?;
        println(f"  {header_repr(t.header)}");
        for f in t.fields {
            println(f"  {field_repr(f)}");
        }
    } else if verb == "records" or verb == "deleted" {
        let t = open_dbf(parts[1], opts_of(parts, 2))?;
        walk(t, if verb == "records" { 32 } else { 42 }, true)?;
    } else if verb == "load" {
        let mut t = open_dbf(parts[1], default_opts())?;
        println(f"  {table_repr(t)} {py_bool(t.loaded)} {iter_name(t)} {count_records(t, 32)?}");
        load(mut t)?;
        println(f"  {table_repr(t)} {py_bool(t.loaded)} {iter_name(t)} {t.records.len()} {t.deleted.len()}");
        println(f"  iterated: {walk(t, 32, false)?.len()}");
        load(mut t)?;
        unload(mut t);
        println(f"  {table_repr(t)} {py_bool(t.loaded)} {iter_name(t)} {count_records(t, 42)?}");
        let mut o = default_opts();
        o.load = true;
        let mut t2 = open_dbf(parts[1], o)?;
        println(f"  in with: {table_repr(t2)} {count_records(t2, 32)?}");
        unload(mut t2);
        println(f"  after with: {table_repr(t2)} {py_bool(t2.loaded)}");
    } else if verb == "memo" {
        for i in split_on(parts[3], ',') {
            let got = match open_memo(parts[1], atoi(parts[2])) {
                Ok(m) => memo_get(m, atoi(i)),
                Err(e) => Err(e),
            };
            match got {
                Ok(v) => println(f"  {i} {type_name(v)} {val_repr(v)}"),
                Err(e) => println(f"  {i} {err_line(e)}"),
            }
        }
    } else if verb == "parse" {
        let mut c = Ctx { dbversion: 2, encoding: "ascii".to_string(), errors: "strict".to_string(), parser: String.new() };
        let mut i = 3;
        while i < parts.len() {
            let kv = split_on(parts[i], '=');
            if kv[0] == "dbversion" {
                c.dbversion = atoi(kv[1]);
            } else if kv[0] == "encoding" {
                c.encoding = kv[1].clone();
            } else if kv[0] == "char_decode_errors" {
                c.errors = kv[1].clone();
            } else if kv[0] == "parser" {
                c.parser = kv[1].clone();
            }
            i += 1;
        }
        let data = if parts[2] == "-" { Vec.new() } else { hex_bytes(parts[2]) };
        let v = parse_field(c, fake_memo(), parts[1], data)?;
        println(f"  {type_name(v)} {val_repr(v)}");
    } else if verb == "ipat" {
        let p = if parts[1] == "-" { String.new() } else { parts[1].clone() };
        println(f"  {str_repr(ipat(p))}");
    } else if verb == "ifnmatch" {
        println(f"  {py_bool(fnmatch(parts[1], ipat(parts[2])))}");
    } else if verb == "ifind" {
        let ext = if parts[2] == "-" { String.new() } else { parts[2].clone() };
        println(f"  {opt_repr(ifind(parts[1], ext))}");
    } else if verb == "dbfinfo" {
        let mut ps: Vec[String] = Vec.new();
        let mut i = 1;
        while i < parts.len() {
            ps.push(parts[i].clone());
            i += 1;
        }
        dbfinfo(ps)?;
    } else if verb == "invalid" {
        invalid(parts[1])?;
    } else if verb == "reverse" {
        reverse(parts[1])?;
    } else if verb == "csv" {
        to_csv(parts[1], parts[2], opts_of(parts, 3))?;
    } else if verb == "json" {
        to_json(parts[1], parts[2], opts_of(parts, 3))?;
    } else if verb == "sql" {
        let mut ps: Vec[String] = Vec.new();
        let mut i = 4;
        while i < parts.len() {
            ps.push(parts[i].clone());
            i += 1;
        }
        to_sql(parts[1], parts[2], parts[3], ps)?;
    } else if verb == "ledger" {
        ledger(parts[1], parts[2])?;
    } else if verb == "cat" {
        cat(parts[1]);
    }
    Ok(())
}

fn write_inputs() -> Result[(), String] {
    for line in split_on(inputs_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, ' ');
        let path = f"data/{f[0]}";
        let _ = fs.create_dir_all(dirname_of(path));
        if let Err(e) = fs.write_bytes(path, hex_bytes(f[1])) {
            return Err(f"cannot write {f[0]}: {e}");
        }
    }
    let _ = fs.remove_dir_all("data/out".to_string());
    if let Err(e) = fs.create_dir_all("data/out".to_string()) {
        return Err(f"cannot create data/out: {e}");
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_inputs() {
        eprintln(e);
        return;
    }
    let mut n = 0;
    let mut nerr = 0;
    for line in split_on(jobs_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let parts = split_on(hex_string(line), '\t');
        println(f"> {join_strs(parts, " ")}");
        if let Err(e) = run(parts) {
            println(f"  {err_line(e)}");
            nerr += 1;
        }
        n += 1;
    }
    println(f"{n} jobs, {nerr} ended in an error");
}

