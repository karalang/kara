// mini_ftfy: a port of ftfy 6.3.1 (Apache-2.0, Robyn Speer), "fixes text
// for you", run as the cleanup pass a support desk puts its inboxes, web
// forms and old exports through: mojibake from the wrong codec (once or
// twice, with bytes lost or spaces altered on the way), HTML entities,
// terminal escapes, curly quotes, ligatures, fullwidth forms, line breaks,
// control characters and Unicode normalization. Every op of data/jobs.tsv
// is a call on ftfy. See README.md.
//
// Text is held as a Vec of code points, and bytes as a Vec of byte values,
// so the one regular-expression matcher below runs over both, as Python's
// re runs over str and bytes.

// ------------------------------------------------------------ code points

fn cps_of(s: ref String) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s.chars() {
        out.push(c as i64);
    }
    out
}

fn chr_of(n: i64) -> char {
    match char.try_from(n) {
        Ok(c) => c,
        Err(_) => '?',
    }
}

fn cps_str(cs: ref Vec[i64]) -> String {
    let mut s = String.new();
    for c in cs {
        s.push(chr_of(*c));
    }
    s
}

fn lit(s: Str) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s.chars() {
        out.push(c as i64);
    }
    out
}

fn sub(cs: ref Vec[i64], lo: i64, hi: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut k = lo;
    while k < hi {
        out.push(cs[k]);
        k += 1;
    }
    out
}

fn push_all(out: mut ref Vec[i64], xs: ref Vec[i64]) {
    for x in xs {
        out.push(*x);
    }
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut k = 0;
    while k < a.len() {
        if a[k] != b[k] {
            return false;
        }
        k += 1;
    }
    true
}

fn has(cs: ref Vec[i64], x: i64) -> bool {
    for c in cs {
        if *c == x {
            return true;
        }
    }
    false
}

fn starts_with(cs: ref Vec[i64], at: i64, p: ref Vec[i64]) -> bool {
    if at + p.len() > cs.len() {
        return false;
    }
    let mut k = 0;
    while k < p.len() {
        if cs[at + k] != p[k] {
            return false;
        }
        k += 1;
    }
    true
}

// str.find(x, pos): the index of the first x at or after pos, or -1.
fn find_from(cs: ref Vec[i64], x: i64, pos: i64) -> i64 {
    let mut k = pos;
    while k < cs.len() {
        if cs[k] == x {
            return k;
        }
        k += 1;
    }
    -1
}

// str.replace(old, new), all occurrences, left to right.
fn replace_all(cs: ref Vec[i64], old: ref Vec[i64], new: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < cs.len() {
        if starts_with(cs, k, old) {
            push_all(mut out, new);
            k += old.len();
        } else {
            out.push(cs[k]);
            k += 1;
        }
    }
    out
}

fn hex_digits(n: i64, width: i64) -> String {
    let d: Vec[char] = "0123456789abcdef".chars().collect();
    let mut out = String.new();
    let mut k = width;
    while k > 0 {
        k -= 1;
        out.push(d[(n >> (4 * k)) & 15]);
    }
    out
}

fn hex_val(c: char) -> i64 {
    if c >= '0' and c <= '9' {
        c as i64 - 48
    } else if c >= 'a' and c <= 'f' {
        c as i64 - 87
    } else if c >= 'A' and c <= 'F' {
        c as i64 - 55
    } else {
        -1
    }
}

fn hex_num(s: ref String) -> i64 {
    let mut v = 0;
    for c in s.chars() {
        v = v * 16 + hex_val(c);
    }
    v
}

// The bytes a run of hex digit pairs spells.
fn hex_bytes(s: ref String) -> Vec[i64] {
    let cs: Vec[char] = s.chars().collect();
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k + 1 < cs.len() {
        out.push(hex_val(cs[k]) * 16 + hex_val(cs[k + 1]));
        k += 2;
    }
    out
}

fn split_on(s: ref String, sep: char) -> Vec[String] {
    let mut pieces: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            pieces.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    pieces.push(cur);
    pieces
}

// ------------------------------------------------------------ UTF-8

fn utf8_encode(cs: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in cs {
        let n = *c;
        if n < 0x80 {
            out.push(n);
        } else if n < 0x800 {
            out.push(0xc0 | (n >> 6));
            out.push(0x80 | (n & 0x3f));
        } else if n < 0x10000 {
            out.push(0xe0 | (n >> 12));
            out.push(0x80 | ((n >> 6) & 0x3f));
            out.push(0x80 | (n & 0x3f));
        } else {
            out.push(0xf0 | (n >> 18));
            out.push(0x80 | ((n >> 12) & 0x3f));
            out.push(0x80 | ((n >> 6) & 0x3f));
            out.push(0x80 | (n & 0x3f));
        }
    }
    out
}

// The text a job's "s:<hex>" spells.
fn utf8_text(b: ref Vec[i64]) -> Vec[i64] {
    let mut v: Vec[u8] = Vec.new();
    for x in b {
        v.push(*x as u8);
    }
    match String.from_utf8(v) {
        Ok(s) => cps_of(s),
        Err(_) => Vec.new(),
    }
}

// ------------------------------------------------------------ Unicode data

// Sorted, non-overlapping [lo, hi] runs, flattened.
fn in_runs(rs: ref Vec[i64], cp: i64) -> bool {
    let mut lo = 0;
    let mut hi = rs.len() / 2;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if rs[2 * mid + 1] < cp {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo < rs.len() / 2 and rs[2 * lo] <= cp
}

// What the port needs from Python's unicodedata (see unicode_text()).
struct Uni {
    decomp: Map[i64, i64],
    dkind: Vec[i64],
    dmap: Vec[Vec[i64]],
    ccc_runs: Vec[i64],
    ccc_vals: Vec[i64],
    compose: Map[i64, i64],
    nonprint: Vec[i64],
    alnum: Vec[i64],
    decimal: Vec[i64],
}

fn load_uni() -> Uni {
    let mut u = Uni {
        decomp: Map.new(),
        dkind: Vec.new(),
        dmap: Vec.new(),
        ccc_runs: Vec.new(),
        ccc_vals: Vec.new(),
        compose: Map.new(),
        nonprint: Vec.new(),
        alnum: Vec.new(),
        decimal: Vec.new(),
    };
    for line in split_on(unicode_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let tag = line.substring(0, 1);
        let f = split_on(line.substring(1, line.len()), ' ');
        if tag == "D" {
            let cp = hex_num(f[0]);
            let kind = if f[1] == "c" { 0 } else if f[1] == "x" { 1 } else { 2 };
            let mut m: Vec[i64] = Vec.new();
            let mut k = 2;
            while k < f.len() {
                m.push(hex_num(f[k]));
                k += 1;
            }
            if kind == 0 and m.len() == 2 {
                u.compose.insert(m[0] * 0x200000 + m[1], cp);
            }
            u.decomp.insert(cp, u.dmap.len());
            u.dkind.push(kind);
            u.dmap.push(m);
        } else if tag == "Q" {
            u.ccc_runs.push(hex_num(f[0]));
            u.ccc_runs.push(hex_num(f[1]));
            u.ccc_vals.push(match i64.parse(f[2]) {
                Ok(v) => v,
                Err(_) => 0,
            });
        } else {
            let lo = hex_num(f[0]);
            let hi = hex_num(f[1]);
            if tag == "P" {
                u.nonprint.push(lo);
                u.nonprint.push(hi);
            } else if tag == "W" {
                u.alnum.push(lo);
                u.alnum.push(hi);
            } else {
                u.decimal.push(lo);
                u.decimal.push(hi);
            }
        }
    }
    u
}

impl Uni {
    fn ccc(ref self, cp: i64) -> i64 {
        let rs = ref self.ccc_runs;
        let mut lo = 0;
        let mut hi = rs.len() / 2;
        while lo < hi {
            let mid = (lo + hi) / 2;
            if rs[2 * mid + 1] < cp {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        if lo < rs.len() / 2 and rs[2 * lo] <= cp { self.ccc_vals[lo] } else { 0 }
    }

    fn printable(ref self, cp: i64) -> bool {
        not in_runs(self.nonprint, cp)
    }

    // str.isspace(): White_Space plus U+001C..U+001F.
    fn space(ref self, cp: i64) -> bool {
        (cp >= 0x1c and cp <= 0x1f) or chr_of(cp).is_whitespace()
    }

    fn decompose_into(ref self, cp: i64, compat: bool, out: mut ref Vec[i64]) {
        if cp >= 0xAC00 and cp < 0xAC00 + 11172 {
            let s = cp - 0xAC00;
            out.push(0x1100 + s / 588);
            out.push(0x1161 + (s % 588) / 28);
            if s % 28 != 0 {
                out.push(0x11A7 + s % 28);
            }
            return;
        }
        let i = match self.decomp.get(cp) {
            Some(i) => *i,
            None => -1,
        };
        if i < 0 or (self.dkind[i] == 2 and not compat) {
            out.push(cp);
            return;
        }
        for d in self.dmap[i].clone() {
            self.decompose_into(d, compat, mut out);
        }
    }

    // NFD or NFKD: full decomposition, then the canonical ordering.
    fn decompose(ref self, cs: ref Vec[i64], compat: bool) -> Vec[i64] {
        let mut out: Vec[i64] = Vec.new();
        for c in cs {
            self.decompose_into(*c, compat, mut out);
        }
        let mut i = 1;
        while i < out.len() {
            let mut j = i;
            while j > 0 and self.ccc(out[j]) != 0 and self.ccc(out[j - 1]) > self.ccc(out[j]) {
                let t = out[j];
                out[j] = out[j - 1];
                out[j - 1] = t;
                j -= 1;
            }
            i += 1;
        }
        out
    }

    fn composite(ref self, a: i64, b: i64) -> i64 {
        if a >= 0x1100 and a < 0x1113 and b >= 0x1161 and b < 0x1176 {
            return 0xAC00 + ((a - 0x1100) * 21 + (b - 0x1161)) * 28;
        }
        if a >= 0xAC00 and a < 0xAC00 + 11172 and (a - 0xAC00) % 28 == 0 and b > 0x11A7 and b < 0x11C3 {
            return a + (b - 0x11A7);
        }
        match self.compose.get(a * 0x200000 + b) {
            Some(c) => *c,
            None => -1,
        }
    }

    // NFC or NFKC: decompose, then compose each unblocked pair.
    fn composed(ref self, cs: ref Vec[i64], compat: bool) -> Vec[i64] {
        let d = self.decompose(cs, compat);
        let mut out: Vec[i64] = Vec.new();
        let mut starter: i64 = -1;
        // The class of the last character kept since the starter, or -1
        // when the starter is the last one kept.
        let mut last: i64 = -1;
        for c in d {
            let cc = self.ccc(c);
            if starter >= 0 {
                let blocked = last != -1 and (last == 0 or last >= cc);
                if not blocked {
                    let comp = self.composite(out[starter], c);
                    if comp >= 0 {
                        out[starter] = comp;
                        continue;
                    }
                }
            }
            if cc == 0 {
                starter = out.len();
                last = -1;
            } else {
                last = cc;
            }
            out.push(c);
        }
        out
    }
}

// unicodedata.normalize(form, text).
fn normalize(u: ref Uni, form: ref String, cs: ref Vec[i64]) -> Result[Vec[i64], Exc] {
    if form == "NFC" {
        Ok(u.composed(cs, false))
    } else if form == "NFKC" {
        Ok(u.composed(cs, true))
    } else if form == "NFD" {
        Ok(u.decompose(cs, false))
    } else if form == "NFKD" {
        Ok(u.decompose(cs, true))
    } else {
        Err(exc("ValueError", "invalid normalization form"))
    }
}

// ------------------------------------------------------------ errors

#[derive(Clone)]
struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: Str) -> Exc {
    Exc { kind: kind.to_string(), msg: msg.to_string() }
}

fn exc_s(kind: Str, msg: ref String) -> Exc {
    Exc { kind: kind.to_string(), msg: msg.clone() }
}

// ------------------------------------------------------------ repr()

fn char_esc(n: i64) -> String {
    if n < 0x100 {
        f"\\x{hex_digits(n, 2)}"
    } else if n < 0x10000 {
        f"\\u{hex_digits(n, 4)}"
    } else {
        f"\\U{hex_digits(n, 8)}"
    }
}

fn str_repr(u: ref Uni, cs: ref Vec[i64]) -> String {
    let q: i64 = if has(cs, 39) and not has(cs, 34) { 34 } else { 39 };
    let mut out = String.new();
    out.push(chr_of(q));
    for c in cs {
        let n = *c;
        if n == q or n == 92 {
            out.push('\\');
            out.push(chr_of(n));
        } else if n == 10 {
            out.push_str("\\n");
        } else if n == 13 {
            out.push_str("\\r");
        } else if n == 9 {
            out.push_str("\\t");
        } else if n < 0x20 or n == 0x7f {
            out.push_str(char_esc(n));
        } else if n < 0x7f or u.printable(n) {
            out.push(chr_of(n));
        } else {
            out.push_str(char_esc(n));
        }
    }
    out.push(chr_of(q));
    out
}

fn bytes_repr(b: ref Vec[i64]) -> String {
    let q: i64 = if has(b, 39) and not has(b, 34) { 34 } else { 39 };
    let mut out = "b".to_string();
    out.push(chr_of(q));
    for x in b {
        let n = *x;
        if n == q or n == 92 {
            out.push('\\');
            out.push(chr_of(n));
        } else if n == 9 {
            out.push_str("\\t");
        } else if n == 10 {
            out.push_str("\\n");
        } else if n == 13 {
            out.push_str("\\r");
        } else if n < 32 or n >= 127 {
            out.push_str(f"\\x{hex_digits(n, 2)}");
        } else {
            out.push(chr_of(n));
        }
    }
    out.push(chr_of(q));
    out
}

// repr() of a plain ASCII str, such as a codec name.
fn name_repr(s: ref String) -> String {
    f"'{s}'"
}

// ------------------------------------------------------------ regular expressions
//
// ftfy's work is done by a dozen regular expressions. The port reads each
// one's source text (regex_text(), copied off the vendored library's
// compiled patterns) and compiles the subset of Python's syntax they use
// into a program for a backtracking matcher that tries alternatives in
// order and repeats greedily, as Python's re does: literals and escapes,
// classes with ranges and \s \w \d, ".", "^" and "$", groups, the four
// lookaround assertions, alternation, and the * + ? {m} {m,n} quantifiers.
// A bytes pattern runs over byte values with ASCII classes; a str pattern
// over code points with Unicode classes.

// One instruction. Jump targets are offsets from the instruction itself,
// so a compiled piece can be copied (a quantifier repeats it) unchanged.
#[derive(Clone)]
struct Inst {
    op: i64,
    x: i64,
    y: i64,
    z: i64,
}

const OP_CHAR: i64 = 0;
const OP_ANY: i64 = 1;
const OP_CLASS: i64 = 2;
const OP_SPLIT: i64 = 3;
const OP_JMP: i64 = 4;
const OP_BOL: i64 = 5;
const OP_EOL: i64 = 6;
const OP_LOOK: i64 = 7;
const OP_MATCH: i64 = 8;

fn inst(op: i64, x: i64, y: i64, z: i64) -> Inst {
    Inst { op: op, x: x, y: y, z: z }
}

// A character class: [lo, hi] runs, and the categories it includes
// (1 \s, 2 \w, 3 \d; negative for \S \W \D).
#[derive(Clone)]
struct Cls {
    neg: bool,
    runs: Vec[i64],
    cats: Vec[i64],
}

// A compiled piece of a pattern and the range of lengths it matches.
struct Frag {
    code: Vec[Inst],
    minw: i64,
    maxw: i64,
}

const INF: i64 = 1000000000;

fn frag(code: own Vec[Inst], minw: i64, maxw: i64) -> Frag {
    Frag { code: code, minw: minw, maxw: maxw }
}

struct Regex {
    name: String,
    prog: Vec[Inst],
    classes: Vec[Cls],
    uni: bool,
}

struct ReParser {
    src: Vec[i64],
    pos: i64,
    verbose: bool,
    classes: Vec[Cls],
}

fn is_hex(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)
}

fn hexv(c: i64) -> i64 {
    hex_val(chr_of(c))
}

impl ReParser {
    fn more(ref self) -> bool {
        self.pos < self.src.len()
    }

    fn peek(ref self) -> i64 {
        if self.pos < self.src.len() { self.src[self.pos] } else { -1 }
    }

    // VERBOSE: whitespace and comments outside a class are ignored.
    fn skip_ws(mut ref self) {
        if not self.verbose {
            return;
        }
        while self.more() {
            let c = self.peek();
            if c == 32 or c == 9 or c == 10 or c == 13 or c == 11 or c == 12 {
                self.pos += 1;
            } else if c == 35 {
                while self.more() and self.peek() != 10 {
                    self.pos += 1;
                }
            } else {
                return;
            }
        }
    }

    fn add_class(mut ref self, c: Cls) -> i64 {
        self.classes.push(c.clone());
        self.classes.len() - 1
    }

    // The escape after a backslash: a code point, or a category as a
    // negative number (-1 \s, -2 \w, -3 \d, -11 \S, -12 \W, -13 \D).
    fn escape(mut ref self) -> i64 {
        let c = self.peek();
        self.pos += 1;
        let cats = lit("swdSWD");
        let mut k = 0;
        while k < 6 {
            if c == cats[k] {
                return if k < 3 { -(k + 1) } else { -(k + 8) };
            }
            k += 1;
        }
        let digits = if c == 120 { 2 } else if c == 117 { 4 } else if c == 85 { 8 } else { 0 };
        if digits > 0 {
            let mut v = 0;
            let mut n = 0;
            while n < digits and is_hex(self.peek()) {
                v = v * 16 + hexv(self.peek());
                self.pos += 1;
                n += 1;
            }
            return v;
        }
        if c == 110 {
            return 10;
        }
        if c == 116 {
            return 9;
        }
        if c == 114 {
            return 13;
        }
        if c == 102 {
            return 12;
        }
        if c == 118 {
            return 11;
        }
        if c == 97 {
            return 7;
        }
        if c >= 48 and c <= 55 {
            let mut v = c - 48;
            let mut n = 1;
            while n < 3 and self.peek() >= 48 and self.peek() <= 55 {
                v = v * 8 + self.peek() - 48;
                self.pos += 1;
                n += 1;
            }
            return v;
        }
        c
    }

    fn class_cat(mut ref self, e: i64) -> i64 {
        let cat = if e > -10 { -e } else { -(-e - 10) };
        let c = Cls { neg: false, runs: Vec.new(), cats: vec![cat] };
        self.add_class(c)
    }

    fn parse_class(mut ref self) -> i64 {
        let mut c = Cls { neg: false, runs: Vec.new(), cats: Vec.new() };
        if self.peek() == 94 {
            c.neg = true;
            self.pos += 1;
        }
        let mut first = true;
        while self.more() {
            let ch = self.peek();
            if ch == 93 and not first {
                self.pos += 1;
                break;
            }
            first = false;
            self.pos += 1;
            let lo = if ch == 92 { self.escape() } else { ch };
            if lo < 0 {
                c.cats.push(if lo > -10 { -lo } else { -(-lo - 10) });
                continue;
            }
            if self.peek() == 45 and self.pos + 1 < self.src.len() and self.src[self.pos + 1] != 93 {
                self.pos += 1;
                let h = self.peek();
                self.pos += 1;
                let hi = if h == 92 { self.escape() } else { h };
                c.runs.push(lo);
                c.runs.push(hi);
            } else {
                c.runs.push(lo);
                c.runs.push(lo);
            }
        }
        c.runs = merge_runs(c.runs);
        self.add_class(c)
    }

    fn parse_alt(mut ref self) -> Frag {
        let mut branches: Vec[Frag] = Vec.new();
        branches.push(self.parse_seq());
        while self.peek() == 124 {
            self.pos += 1;
            branches.push(self.parse_seq());
        }
        if branches.len() == 1 {
            return branches.pop().unwrap();
        }
        let mut minw = INF;
        let mut maxw = 0;
        let mut total = 0;
        for b in branches.iter() {
            total += b.code.len() + 2;
            if b.minw < minw {
                minw = b.minw;
            }
            if b.maxw > maxw {
                maxw = b.maxw;
            }
        }
        total -= 2;
        let mut code: Vec[Inst] = Vec.new();
        let n = branches.len();
        let mut k = 0;
        for b in branches.iter() {
            if k < n - 1 {
                code.push(inst(OP_SPLIT, 1, b.code.len() + 2, 0));
            }
            for i in b.code.iter() {
                code.push(i.clone());
            }
            if k < n - 1 {
                code.push(inst(OP_JMP, total - code.len(), 0, 0));
            }
            k += 1;
        }
        frag(code, minw, maxw)
    }

    fn parse_seq(mut ref self) -> Frag {
        let mut code: Vec[Inst] = Vec.new();
        let mut minw = 0;
        let mut maxw = 0;
        loop {
            self.skip_ws();
            let c = self.peek();
            if c < 0 or c == 124 or c == 41 {
                break;
            }
            let atom = self.parse_atom();
            let piece = self.parse_quant(atom);
            for i in piece.code.iter() {
                code.push(i.clone());
            }
            minw += piece.minw;
            maxw = if maxw >= INF or piece.maxw >= INF { INF } else { maxw + piece.maxw };
        }
        frag(code, minw, maxw)
    }

    fn parse_atom(mut ref self) -> Frag {
        let c = self.peek();
        self.pos += 1;
        if c == 40 {
            let mut look = -1;
            if self.peek() == 63 {
                self.pos += 1;
                let k = self.peek();
                self.pos += 1;
                if k == 60 {
                    let k2 = self.peek();
                    self.pos += 1;
                    look = if k2 == 33 { 3 } else { 2 };
                } else if k == 33 {
                    look = 1;
                } else if k == 61 {
                    look = 0;
                }
            }
            let inner = self.parse_alt();
            self.pos += 1;
            if look < 0 {
                return inner;
            }
            let mut code: Vec[Inst] = Vec.new();
            let z = if look >= 2 { look + 4 * inner.minw } else { look };
            code.push(inst(OP_LOOK, 1, inner.code.len() + 2, z));
            for i in inner.code.iter() {
                code.push(i.clone());
            }
            code.push(inst(OP_MATCH, 0, 0, 0));
            return frag(code, 0, 0);
        }
        if c == 91 {
            let k = self.parse_class();
            return frag(vec![inst(OP_CLASS, k, 0, 0)], 1, 1);
        }
        if c == 46 {
            return frag(vec![inst(OP_ANY, 0, 0, 0)], 1, 1);
        }
        if c == 94 {
            return frag(vec![inst(OP_BOL, 0, 0, 0)], 0, 0);
        }
        if c == 36 {
            return frag(vec![inst(OP_EOL, 0, 0, 0)], 0, 0);
        }
        if c == 92 {
            let e = self.escape();
            if e < 0 {
                let k = self.class_cat(e);
                return frag(vec![inst(OP_CLASS, k, 0, 0)], 1, 1);
            }
            return frag(vec![inst(OP_CHAR, e, 0, 0)], 1, 1);
        }
        frag(vec![inst(OP_CHAR, c, 0, 0)], 1, 1)
    }

    // A number at the parser's position, or -1 if there is none.
    fn number(mut ref self) -> i64 {
        let start = self.pos;
        let mut v = 0;
        while self.peek() >= 48 and self.peek() <= 57 {
            v = v * 10 + self.peek() - 48;
            self.pos += 1;
        }
        if self.pos == start { -1 } else { v }
    }

    fn parse_quant(mut ref self, atom: own Frag) -> Frag {
        self.skip_ws();
        let c = self.peek();
        let mut lo = -1;
        let mut hi = -1;
        if c == 42 {
            lo = 0;
            hi = INF;
            self.pos += 1;
        } else if c == 43 {
            lo = 1;
            hi = INF;
            self.pos += 1;
        } else if c == 63 {
            lo = 0;
            hi = 1;
            self.pos += 1;
        } else if c == 123 {
            let save = self.pos;
            self.pos += 1;
            let a = self.number();
            let mut b = a;
            if self.peek() == 44 {
                self.pos += 1;
                b = self.number();
                if b < 0 {
                    b = INF;
                }
            }
            if self.peek() == 125 and (a >= 0 or b >= 0) {
                self.pos += 1;
                lo = if a < 0 { 0 } else { a };
                hi = b;
            } else {
                self.pos = save;
                return atom;
            }
        } else {
            return atom;
        }
        let mut lazy = false;
        if self.peek() == 63 {
            lazy = true;
            self.pos += 1;
        }
        repeat(atom, lo, hi, lazy)
    }
}

fn merge_runs(rs: Vec[i64]) -> Vec[i64] {
    let n = rs.len() / 2;
    let mut idx: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < n {
        let mut j = idx.len();
        idx.push(k);
        while j > 0 and rs[2 * idx[j - 1]] > rs[2 * k] {
            idx[j] = idx[j - 1];
            j -= 1;
        }
        idx[j] = k;
        k += 1;
    }
    let mut out: Vec[i64] = Vec.new();
    for i in idx {
        let lo = rs[2 * i];
        let hi = rs[2 * i + 1];
        let m = out.len();
        if m > 0 and lo <= out[m - 1] + 1 {
            if hi > out[m - 1] {
                out[m - 1] = hi;
            }
        } else {
            out.push(lo);
            out.push(hi);
        }
    }
    out
}

fn copy_code(dst: mut ref Vec[Inst], src: ref Vec[Inst]) {
    for i in src.iter() {
        dst.push(i.clone());
    }
}

fn repeat(atom: Frag, lo: i64, hi: i64, lazy: bool) -> Frag {
    let n = atom.code.len();
    let mut code: Vec[Inst] = Vec.new();
    let mut k = 0;
    while k < lo {
        copy_code(mut code, atom.code);
        k += 1;
    }
    if hi >= INF {
        // L: split body, out; body; jmp L
        if lazy {
            code.push(inst(OP_SPLIT, n + 2, 1, 0));
        } else {
            code.push(inst(OP_SPLIT, 1, n + 2, 0));
        }
        copy_code(mut code, atom.code);
        code.push(inst(OP_JMP, -(n + 1), 0, 0));
    } else {
        // Each optional copy: split body, end; body. Nested, so they
        // are taken in order.
        let opt = hi - lo;
        let mut j = 0;
        while j < opt {
            let rest = (opt - j) * (n + 1) - 1;
            if lazy {
                code.push(inst(OP_SPLIT, rest + 1, 1, 0));
            } else {
                code.push(inst(OP_SPLIT, 1, rest + 1, 0));
            }
            copy_code(mut code, atom.code);
            j += 1;
        }
    }
    let minw = atom.minw * lo;
    let maxw = if hi >= INF or atom.maxw >= INF { INF } else { atom.maxw * hi };
    frag(code, minw, maxw)
}

fn compile_regex(name: ref String, verbose: bool, uni: bool, src: own Vec[i64]) -> Regex {
    let mut p = ReParser { src: src, pos: 0, verbose: verbose, classes: Vec.new() };
    let f = p.parse_alt();
    let mut prog = f.code;
    prog.push(inst(OP_MATCH, 0, 0, 0));
    Regex { name: name.clone(), prog: prog, classes: p.classes, uni: uni }
}

fn word_char(u: ref Uni, uni: bool, c: i64) -> bool {
    if c == 95 {
        return true;
    }
    if uni {
        in_runs(u.alnum, c)
    } else {
        (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
    }
}

fn cat_has(u: ref Uni, uni: bool, cat: i64, c: i64) -> bool {
    let a = if cat < 0 { -cat } else { cat };
    let r = if a == 1 {
        if uni { u.space(c) } else { c == 32 or (c >= 9 and c <= 13) }
    } else if a == 2 {
        word_char(u, uni, c)
    } else if uni {
        in_runs(u.decimal, c)
    } else {
        c >= 48 and c <= 57
    };
    if cat < 0 { not r } else { r }
}

impl Regex {
    fn in_class(ref self, u: ref Uni, k: i64, c: i64) -> bool {
        let cl = ref self.classes[k];
        let mut r = in_runs(cl.runs, c);
        if not r {
            for cat in cl.cats.iter() {
                if cat_has(u, self.uni, *cat, c) {
                    r = true;
                }
            }
        }
        if cl.neg { not r } else { r }
    }

    // Runs the program from pc at pos: the end of the first match the
    // backtracking order finds, or -1.
    fn run(ref self, u: ref Uni, pc0: i64, pos0: i64, t: ref Vec[i64]) -> i64 {
        let mut pc = pc0;
        let mut pos = pos0;
        let n = t.len();
        loop {
            let i = ref self.prog[pc];
            let op = i.op;
            if op == OP_CHAR {
                if pos < n and t[pos] == i.x {
                    pos += 1;
                    pc += 1;
                } else {
                    return -1;
                }
            } else if op == OP_CLASS {
                if pos < n and self.in_class(u, i.x, t[pos]) {
                    pos += 1;
                    pc += 1;
                } else {
                    return -1;
                }
            } else if op == OP_ANY {
                if pos < n and t[pos] != 10 {
                    pos += 1;
                    pc += 1;
                } else {
                    return -1;
                }
            } else if op == OP_SPLIT {
                let r = self.run(u, pc + i.x, pos, t);
                if r >= 0 {
                    return r;
                }
                pc += i.y;
            } else if op == OP_JMP {
                pc += i.x;
            } else if op == OP_BOL {
                if pos != 0 {
                    return -1;
                }
                pc += 1;
            } else if op == OP_EOL {
                if not (pos == n or (pos == n - 1 and t[pos] == 10)) {
                    return -1;
                }
                pc += 1;
            } else if op == OP_LOOK {
                let kind = i.z % 4;
                let width = i.z / 4;
                let mut ok = false;
                if kind >= 2 {
                    let start = pos - width;
                    if start >= 0 {
                        ok = self.run(u, pc + i.x, start, t) == pos;
                    }
                } else {
                    ok = self.run(u, pc + i.x, pos, t) >= 0;
                }
                if kind == 1 or kind == 3 {
                    ok = not ok;
                }
                if not ok {
                    return -1;
                }
                pc += i.y;
            } else {
                return pos;
            }
        }
    }

    // match(): anchored at pos. The end, or -1.
    fn match_at(ref self, u: ref Uni, t: ref Vec[i64], pos: i64) -> i64 {
        self.run(u, 0, pos, t)
    }

    // search() from pos: (start, end), or (-1, -1).
    fn search(ref self, u: ref Uni, t: ref Vec[i64], pos: i64) -> (i64, i64) {
        let mut s = pos;
        while s <= t.len() {
            let e = self.run(u, 0, s, t);
            if e >= 0 {
                return (s, e);
            }
            s += 1;
        }
        (-1, -1)
    }

    fn found(ref self, u: ref Uni, t: ref Vec[i64]) -> bool {
        let (s, _) = self.search(u, t, 0);
        s >= 0
    }

    // The non-overlapping matches, left to right, as (start, end) pairs.
    fn spans(ref self, u: ref Uni, t: ref Vec[i64]) -> Vec[(i64, i64)] {
        let mut out: Vec[(i64, i64)] = Vec.new();
        let mut pos = 0;
        while pos <= t.len() {
            let (s, e) = self.search(u, t, pos);
            if s < 0 {
                break;
            }
            out.push((s, e));
            pos = if e > s { e } else { e + 1 };
        }
        out
    }

    // sub() with a fixed replacement.
    fn sub_with(ref self, u: ref Uni, t: ref Vec[i64], rep: ref Vec[i64]) -> Vec[i64] {
        let mut out: Vec[i64] = Vec.new();
        let mut last = 0;
        for (s, e) in self.spans(u, t) {
            push_all(mut out, sub(t, last, s));
            push_all(mut out, rep);
            last = e;
        }
        push_all(mut out, sub(t, last, t.len()));
        out
    }
}

// Every pattern regex_text() lists, compiled.
struct Regexes {
    all: Vec[Regex],
}

fn load_regexes() -> Regexes {
    let mut all: Vec[Regex] = Vec.new();
    for line in split_on(regex_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, ' ');
        let raw = hex_bytes(f[3]);
        all.push(compile_regex(f[0], f[1] == "1", f[2] == "0", utf8_text(raw)));
    }
    Regexes { all: all }
}

impl Regexes {
    fn get(ref self, name: Str) -> ref Regex {
        let mut k = 0;
        while k < self.all.len() {
            if self.all[k].name == name {
                return ref self.all[k];
            }
            k += 1;
        }
        ref self.all[0]
    }
}

// ------------------------------------------------------------ codecs
//
// The single-byte codecs ftfy tries are tables of 256 code points
// (codec_text() holds Python's, "-" where a byte has no character).
// bad_codecs/sloppy.py makes a "sloppy" codec from a Windows one by
// letting each unassigned byte stand for the Latin-1 character instead,
// and byte 0x1A for U+FFFD; the port builds them the same way.

struct Charmap {
    name: String,
    dec: Vec[i64],
    enc: Map[i64, i64],
    // possible_encoding(): the characters a text made by this codec can
    // hold (chardata._build_regexes).
    possible: Map[i64, i64],
}

fn charmap(name: ref String, dec: own Vec[i64]) -> Charmap {
    let mut enc: Map[i64, i64] = Map.new();
    let mut k = 0;
    while k < 256 {
        if dec[k] >= 0 and not enc.contains_key(dec[k]) {
            enc.insert(dec[k], k);
        }
        k += 1;
    }
    let mut possible: Map[i64, i64] = Map.new();
    let mut c = 0;
    while c < 0x80 {
        if c != 0x1a {
            possible.insert(c, 1);
        }
        c += 1;
    }
    let mut b = 0x80;
    while b < 0x100 {
        if dec[b] >= 0 {
            possible.insert(dec[b], 1);
        }
        b += 1;
    }
    if dec[0x1a] >= 0 {
        possible.insert(dec[0x1a], 1);
    }
    Charmap { name: name.clone(), dec: dec, enc: enc, possible: possible }
}

struct Codecs {
    maps: Vec[Charmap],
}

fn make_sloppy(strict: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 256 {
        out.push(if strict[k] >= 0 { strict[k] } else { k });
        k += 1;
    }
    out[0x1a] = 0xfffd;
    out
}

fn load_codecs() -> Codecs {
    let mut maps: Vec[Charmap] = Vec.new();
    let mut latin: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 256 {
        latin.push(k);
        k += 1;
    }
    maps.push(charmap("latin-1", latin));
    for line in split_on(codec_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, ' ');
        let mut dec: Vec[i64] = Vec.new();
        let mut i = 1;
        while i < f.len() {
            dec.push(if f[i] == "-" { -1 } else { hex_num(f[i]) });
            i += 1;
        }
        let name = f[0].clone();
        if name.starts_with("windows-") {
            maps.push(charmap(f"sloppy-{name}", make_sloppy(dec)));
            if name == "windows-1252" {
                maps.push(charmap(name, dec));
            }
        } else if name == "mac-roman" {
            maps.push(charmap("macroman", dec));
        } else {
            maps.push(charmap(name, dec));
        }
    }
    Codecs { maps: maps }
}

impl Codecs {
    fn find(ref self, name: ref String) -> i64 {
        let mut k = 0;
        while k < self.maps.len() {
            if self.maps[k].name == *name {
                return k;
            }
            k += 1;
        }
        -1
    }

    fn possible(ref self, cs: ref Vec[i64], name: Str) -> bool {
        let k = self.find(name.to_string());
        let m = ref self.maps[k];
        for c in cs {
            if not m.possible.contains_key(*c) {
                return false;
            }
        }
        true
    }

    // str.encode(name) for a single-byte codec: the latin-1 encoder or the
    // charmap one, each reporting a run of unencodable characters.
    fn encode1(ref self, k: i64, cs: ref Vec[i64]) -> Result[Vec[i64], Exc] {
        let m = ref self.maps[k];
        let latin = m.name == "latin-1";
        let mut out: Vec[i64] = Vec.new();
        let mut i = 0;
        while i < cs.len() {
            let c = cs[i];
            let byte = if latin { if c < 256 { c } else { -1 } } else {
                match m.enc.get(c) {
                    Some(b) => *b,
                    None => -1,
                }
            };
            if byte >= 0 {
                out.push(byte);
                i += 1;
                continue;
            }
            let mut j = i + 1;
            while j < cs.len() {
                let ok = if latin { cs[j] < 256 } else { m.enc.contains_key(cs[j]) };
                if ok {
                    break;
                }
                j += 1;
            }
            let codec = if latin { "latin-1" } else { "charmap" };
            let reason = if latin { "ordinal not in range(256)" } else { "character maps to <undefined>" };
            let msg = if j - i == 1 {
                f"'{codec}' codec can't encode character '{char_esc(c)}' in position {i}: {reason}"
            } else {
                f"'{codec}' codec can't encode characters in position {i}-{j - 1}: {reason}"
            };
            return Err(exc_s("UnicodeEncodeError", msg));
        }
        Ok(out)
    }

    fn decode1(ref self, k: i64, b: ref Vec[i64]) -> Result[Vec[i64], Exc] {
        let m = ref self.maps[k];
        let mut out: Vec[i64] = Vec.new();
        let mut i = 0;
        while i < b.len() {
            let c = m.dec[b[i]];
            if c < 0 {
                return Err(decode_err("charmap", i, i, b, "character maps to <undefined>"));
            }
            out.push(c);
            i += 1;
        }
        Ok(out)
    }
}

fn decode_err(codec: Str, a: i64, z: i64, b: ref Vec[i64], reason: Str) -> Exc {
    let msg = if z == a {
        f"'{codec}' codec can't decode byte 0x{hex_digits(b[a], 2)} in position {a}: {reason}"
    } else {
        f"'{codec}' codec can't decode bytes in position {a}-{z}: {reason}"
    };
    exc_s("UnicodeDecodeError", msg)
}

// bytes.decode("utf-8"), strictly, with CPython's error messages.
fn utf8_decode(b: ref Vec[i64]) -> Result[Vec[i64], Exc] {
    let n = b.len();
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        let x = b[i];
        if x < 0x80 {
            out.push(x);
            i += 1;
            continue;
        }
        let (need, lo, hi) = if x >= 0xc2 and x <= 0xdf {
            (1, 0x80, 0xbf)
        } else if x == 0xe0 {
            (2, 0xa0, 0xbf)
        } else if x == 0xed {
            (2, 0x80, 0x9f)
        } else if x >= 0xe1 and x <= 0xef {
            (2, 0x80, 0xbf)
        } else if x == 0xf0 {
            (3, 0x90, 0xbf)
        } else if x == 0xf4 {
            (3, 0x80, 0x8f)
        } else if x >= 0xf1 and x <= 0xf3 {
            (3, 0x80, 0xbf)
        } else {
            return Err(decode_err("utf-8", i, i, b, "invalid start byte"));
        };
        let mut good = need + 1;
        let mut at_end = false;
        let mut k = 1;
        while k <= need {
            if i + k >= n {
                good = k;
                at_end = true;
                break;
            }
            let y = b[i + k];
            let (l, h) = if k == 1 { (lo, hi) } else { (0x80, 0xbf) };
            if y < l or y > h {
                good = k;
                break;
            }
            k += 1;
        }
        if good <= need {
            let reason = if at_end { "unexpected end of data" } else { "invalid continuation byte" };
            return Err(decode_err("utf-8", i, i + good - 1, b, reason));
        }
        let mut cp = if need == 1 { x & 0x1f } else if need == 2 { x & 0x0f } else { x & 0x07 };
        let mut j = 1;
        while j <= need {
            cp = cp * 64 + (b[i + j] & 0x3f);
            j += 1;
        }
        out.push(cp);
        i += need + 1;
    }
    Ok(out)
}

// bytes.decode("utf-8-variants"), bad_codecs/utf8_variants.py: UTF-8,
// plus Java's two-byte null and CESU-8's six-byte surrogate pairs. Each
// step decodes up to the next special sequence with the real UTF-8
// decoder, so an error's position counts from the start of that step.
fn utf8_variants_decode(u: ref Uni, rx: ref Regexes, input: ref Vec[i64]) -> Result[Vec[i64], Exc] {
    let special = rx.get("SPECIAL_BYTES_RE");
    let cesu = rx.get("CESU8_RE");
    let mut out: Vec[i64] = Vec.new();
    let mut position = 0;
    while position < input.len() {
        let rest = sub(input, position, input.len());
        let (cutoff, _) = special.search(u, rest, 0);
        if cutoff < 0 {
            push_all(mut out, utf8_decode(rest)?);
            break;
        }
        if cutoff > 0 {
            push_all(mut out, utf8_decode(sub(rest, 0, cutoff))?);
            position += cutoff;
            continue;
        }
        if rest[0] == 0xc0 {
            if rest.len() > 1 {
                out.push(0);
                position += 2;
                continue;
            }
            push_all(mut out, utf8_decode(rest)?);
            break;
        }
        if rest.len() < 6 {
            push_all(mut out, utf8_decode(rest)?);
            break;
        }
        if cesu.match_at(u, rest, 0) >= 0 {
            let cp = ((rest[1] & 0x0f) << 16) + ((rest[2] & 0x3f) << 10) + ((rest[4] & 0x0f) << 6) + (rest[5] & 0x3f) + 0x10000;
            out.push(cp);
            position += 6;
            continue;
        }
        push_all(mut out, utf8_decode(sub(rest, 0, 3))?);
        position += 3;
    }
    Ok(out)
}

// bytes.decode("utf-16") for input that starts with a byte order mark.
fn utf16_decode(b: ref Vec[i64]) -> Result[Vec[i64], Exc] {
    let big = b[0] == 0xfe;
    let codec = if big { "utf-16-be" } else { "utf-16-le" };
    let n = b.len();
    let mut out: Vec[i64] = Vec.new();
    let mut q = 2;
    while q < n {
        if n - q < 2 {
            return Err(decode_err(codec, q, n - 1, b, "truncated data"));
        }
        let ch = if big { b[q] * 256 + b[q + 1] } else { b[q + 1] * 256 + b[q] };
        q += 2;
        if ch < 0xd800 or ch > 0xdfff {
            out.push(ch);
            continue;
        }
        if ch >= 0xdc00 {
            return Err(decode_err(codec, q - 2, q - 1, b, "illegal encoding"));
        }
        if n - q < 2 {
            return Err(decode_err(codec, q - 2, n - 1, b, "unexpected end of data"));
        }
        let ch2 = if big { b[q] * 256 + b[q + 1] } else { b[q + 1] * 256 + b[q] };
        q += 2;
        if ch2 < 0xdc00 or ch2 > 0xdfff {
            return Err(decode_err(codec, q - 4, q - 3, b, "illegal UTF-16 surrogate"));
        }
        out.push(0x10000 + ((ch - 0xd800) << 10) + (ch2 - 0xdc00));
    }
    Ok(out)
}

fn unknown_encoding(name: ref String) -> Exc {
    exc_s("LookupError", f"unknown encoding: {name}")
}

// str.encode(name), for the codecs a plan can name.
fn encode_as(cd: ref Codecs, cs: ref Vec[i64], name: ref String) -> Result[Vec[i64], Exc] {
    if *name == "utf-8" or *name == "utf-8-variants" {
        return Ok(utf8_encode(cs));
    }
    let k = cd.find(name);
    if k < 0 {
        return Err(unknown_encoding(name));
    }
    cd.encode1(k, cs)
}

// bytes.decode(name).
fn decode_as(u: ref Uni, rx: ref Regexes, cd: ref Codecs, b: ref Vec[i64], name: ref String) -> Result[Vec[i64], Exc] {
    if *name == "utf-8" {
        return utf8_decode(b);
    }
    if *name == "utf-8-variants" {
        return utf8_variants_decode(u, rx, b);
    }
    let k = cd.find(name);
    if k < 0 {
        return Err(unknown_encoding(name));
    }
    cd.decode1(k, b)
}

// ------------------------------------------------------------ chardata

// chardata.CHARMAP_ENCODINGS, in the order fix_encoding tries them.
fn charmap_encodings() -> Vec[Str] {
    vec!["latin-1", "sloppy-windows-1252", "sloppy-windows-1251", "sloppy-windows-1250",
         "sloppy-windows-1253", "sloppy-windows-1254", "sloppy-windows-1257",
         "iso-8859-2", "macroman", "cp437"]
}

// chardata.LIGATURES.
fn ligatures() -> Map[i64, Vec[i64]] {
    let pairs: Vec[(i64, Str)] = vec![
        (0x132, "IJ"), (0x133, "ij"), (0x149, "\u{2bc}n"), (0x1f1, "DZ"),
        (0x1f2, "Dz"), (0x1f3, "dz"), (0x1c4, "D\u{17d}"), (0x1c5, "D\u{17e}"),
        (0x1c6, "d\u{17e}"), (0x1c7, "LJ"), (0x1c8, "Lj"), (0x1c9, "lj"),
        (0x1ca, "NJ"), (0x1cb, "Nj"), (0x1cc, "nj"), (0xfb00, "ff"),
        (0xfb01, "fi"), (0xfb02, "fl"), (0xfb03, "ffi"), (0xfb04, "ffl"),
        (0xfb05, "\u{17f}t"), (0xfb06, "st"),
    ];
    let mut m: Map[i64, Vec[i64]] = Map.new();
    for (k, v) in pairs {
        m.insert(k, lit(v));
    }
    m
}

// chardata._build_control_char_mapping(): the characters
// remove_control_chars() deletes.
fn is_control_char(c: i64) -> bool {
    (c >= 0 and c < 9) or c == 0x0b or (c >= 0x0e and c < 0x20) or c == 0x7f
        or (c >= 0x206a and c < 0x2070) or c == 0xfeff or (c >= 0xfff9 and c < 0xfffd)
}

fn ascii_lower(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        out.push(if c >= 'A' and c <= 'Z' { chr_of(c as i64 + 32) } else { c });
    }
    out
}

fn ascii_upper(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        out.push(if c >= 'a' and c <= 'z' { chr_of(c as i64 - 32) } else { c });
    }
    out
}

struct Html {
    // html.entities.html5, in its order, and indexed by name.
    names: Vec[String],
    values: Vec[Vec[i64]],
    index: Map[String, i64],
    // html's replacements for invalid character references, and the code
    // points a reference to which it drops.
    charrefs: Map[i64, Vec[i64]],
    dropped: Vec[i64],
    // chardata.HTML_ENTITIES, and its keys in the order they were added.
    entities: Map[String, Vec[i64]],
    keys: Vec[String],
}

fn load_html() -> Html {
    let mut h = Html {
        names: Vec.new(),
        values: Vec.new(),
        index: Map.new(),
        charrefs: Map.new(),
        dropped: Vec.new(),
        entities: Map.new(),
        keys: Vec.new(),
    };
    for line in split_on(html_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, ' ');
        let mut v: Vec[i64] = Vec.new();
        let mut k = 1;
        while k < f.len() {
            v.push(hex_num(f[k]));
            k += 1;
        }
        if line.starts_with("#") {
            h.charrefs.insert(hex_num(f[0].substring(1, f[0].len())), v);
        } else if line.starts_with("!") {
            h.dropped.push(hex_num(f[0].substring(1, f[0].len())));
            h.dropped.push(v[0]);
        } else {
            h.index.insert(f[0].clone(), h.names.len());
            h.names.push(f[0].clone());
            h.values.push(v);
        }
    }
    build_entities(mut h);
    h
}

impl Html {
    fn html5(ref self, name: ref String) -> i64 {
        match self.index.get(name) {
            Some(i) => *i,
            None => -1,
        }
    }

    fn add(mut ref self, key: own String, v: own Vec[i64]) {
        if not self.entities.contains_key(key) {
            self.keys.push(key.clone());
        }
        self.entities.insert(key, v);
    }

    // html.unescape(text) left this "&NAME;" unchanged: neither the name
    // nor any prefix of it of two or more characters is an html5 name.
    fn unescape_keeps(ref self, entity: ref String) -> bool {
        let name = entity.substring(1, entity.len());
        let cs = cps_of(name);
        let mut n = cs.len();
        if n > 33 {
            n = 32;
        }
        let s = cps_str(sub(cs, 0, n));
        if self.html5(s) >= 0 {
            return false;
        }
        let mut x = n - 1;
        while x > 1 {
            if self.html5(cps_str(sub(cs, 0, x))) >= 0 {
                return false;
            }
            x -= 1;
        }
        true
    }
}

// chardata._build_html_entities().
fn build_entities(h: mut ref Html) {
    let mut k = 0;
    while k < h.names.len() {
        let name = h.names[k].clone();
        if name.ends_with(";") {
            let ch = h.values[k].clone();
            h.add(f"&{name}", ch.clone());
            if name == ascii_lower(name) {
                let entity_upper = f"&{ascii_upper(name)}";
                if h.unescape_keeps(entity_upper) {
                    h.add(entity_upper, cps_of(cps_str(ch).to_uppercase()));
                }
            }
        }
        k += 1;
    }
}

// ------------------------------------------------------------ the world

#[derive(Clone)]
struct Step {
    action: String,
    param: String,
}

fn step(action: Str, param: ref String) -> Step {
    Step { action: action.to_string(), param: param.clone() }
}

fn steps_repr(steps: ref Vec[Step]) -> String {
    let mut out = "[".to_string();
    let mut k = 0;
    for s in steps.iter() {
        if k > 0 {
            out.push_str(", ");
        }
        out.push_str(f"('{s.action}', '{s.param}')");
        k += 1;
    }
    out.push_str("]");
    out
}

// TextFixerConfig. unescape_html is 0 (False), 1 (True) or 2 ("auto").
#[derive(Clone)]
struct Config {
    unescape_html: i64,
    remove_terminal_escapes: bool,
    fix_encoding: bool,
    restore_byte_a0: bool,
    replace_lossy_sequences: bool,
    decode_inconsistent_utf8: bool,
    fix_c1_controls: bool,
    fix_latin_ligatures: bool,
    fix_character_width: bool,
    uncurl_quotes: bool,
    fix_line_breaks: bool,
    fix_surrogates: bool,
    remove_control_chars: bool,
    normalization: Option[String],
    max_decode_length: i64,
    explain: bool,
}

fn default_config() -> Config {
    Config {
        unescape_html: 2,
        remove_terminal_escapes: true,
        fix_encoding: true,
        restore_byte_a0: true,
        replace_lossy_sequences: true,
        decode_inconsistent_utf8: true,
        fix_c1_controls: true,
        fix_latin_ligatures: true,
        fix_character_width: true,
        uncurl_quotes: true,
        fix_line_breaks: true,
        fix_surrogates: true,
        remove_control_chars: true,
        normalization: Some("NFC".to_string()),
        max_decode_length: 1000000,
        explain: true,
    }
}

fn quiet_config() -> Config {
    let mut c = default_config();
    c.explain = false;
    c
}

struct World {
    u: Uni,
    rx: Regexes,
    cd: Codecs,
    html: Html,
    ligatures: Map[i64, Vec[i64]],
    width_map: Map[i64, Vec[i64]],
    width_keys: Vec[i64],
}

fn load_world() -> World {
    let u = load_uni();
    // chardata._build_width_map().
    let mut width_map: Map[i64, Vec[i64]] = Map.new();
    let mut width_keys: Vec[i64] = Vec.new();
    width_map.insert(0x3000, lit(" "));
    width_keys.push(0x3000);
    let mut i = 0xff01;
    while i < 0xfff0 {
        let ch: Vec[i64] = vec![i];
        let alternate = u.composed(ch, true);
        if not same(alternate, ch) {
            width_map.insert(i, alternate);
            width_keys.push(i);
        }
        i += 1;
    }
    World {
        u: u,
        rx: load_regexes(),
        cd: load_codecs(),
        html: load_html(),
        ligatures: ligatures(),
        width_map: width_map,
        width_keys: width_keys,
    }
}

fn translate(cs: ref Vec[i64], table: ref Map[i64, Vec[i64]]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in cs {
        match table.get(*c) {
            Some(v) => push_all(mut out, v),
            None => out.push(*c),
        }
    }
    out
}

fn has_byte(b: ref Vec[i64], x: i64) -> bool {
    has(b, x)
}

// The digits of a numeric character reference, saturating past the
// largest code point (anything larger is replaced the same way).
fn charref_num(cs: ref Vec[i64], lo: i64, hi: i64, base: i64) -> i64 {
    let mut v = 0;
    let mut k = lo;
    while k < hi {
        let d = hexv(cs[k]);
        v = v * base + d;
        if v > 0x110000 {
            v = 0x110000;
        }
        k += 1;
    }
    v
}

impl World {
    // ---------------------------------------------------------- badness

    fn is_bad(ref self, cs: ref Vec[i64]) -> bool {
        self.rx.get("BADNESS_RE").found(self.u, cs)
    }

    fn badness(ref self, cs: ref Vec[i64]) -> i64 {
        self.rx.get("BADNESS_RE").spans(self.u, cs).len()
    }

    // ---------------------------------------------------------- fixes

    // html.unescape() of a "&#...;" that HTML_ENTITY_RE matched.
    fn unescape_numeric(ref self, t: ref Vec[i64]) -> Vec[i64] {
        let hex = t.len() > 2 and (t[2] == 120 or t[2] == 88);
        let start = if hex { 3 } else { 2 };
        let mut end = start;
        while end < t.len() and (if hex { is_hex(t[end]) } else { t[end] >= 48 and t[end] <= 57 }) {
            end += 1;
        }
        if end == start {
            return t.clone();
        }
        let num = charref_num(t, start, end, if hex { 16 } else { 10 });
        let mut tail = end;
        if tail < t.len() and t[tail] == 59 {
            tail += 1;
        }
        let mut out: Vec[i64] = Vec.new();
        push_all(mut out, self.charref(num));
        push_all(mut out, sub(t, tail, t.len()));
        out
    }

    fn charref(ref self, num: i64) -> Vec[i64] {
        match self.html.charrefs.get(num) {
            Some(v) => return v.clone(),
            None => {}
        }
        if (num >= 0xd800 and num <= 0xdfff) or num > 0x10ffff {
            return vec![0xfffd];
        }
        if in_runs(self.html.dropped, num) {
            return Vec.new();
        }
        vec![num]
    }

    fn unescape_fixup(ref self, t: ref Vec[i64]) -> Vec[i64] {
        let key = cps_str(t);
        match self.html.entities.get(key) {
            Some(v) => return v.clone(),
            None => {}
        }
        if t.len() > 1 and t[1] == 35 {
            let unescaped = self.unescape_numeric(t);
            if has(unescaped, 59) {
                return t.clone();
            }
            return unescaped;
        }
        t.clone()
    }

    fn unescape_html(ref self, cs: ref Vec[i64]) -> Vec[i64] {
        let rx = self.rx.get("HTML_ENTITY_RE");
        let mut out: Vec[i64] = Vec.new();
        let mut last = 0;
        for (s, e) in rx.spans(self.u, cs) {
            push_all(mut out, sub(cs, last, s));
            push_all(mut out, self.unescape_fixup(sub(cs, s, e)));
            last = e;
        }
        push_all(mut out, sub(cs, last, cs.len()));
        out
    }

    fn remove_terminal_escapes(ref self, cs: ref Vec[i64]) -> Vec[i64] {
        self.rx.get("ANSI_RE").sub_with(self.u, cs, Vec.new())
    }

    fn uncurl_quotes(ref self, cs: ref Vec[i64]) -> Vec[i64] {
        let d = self.rx.get("DOUBLE_QUOTE_RE").sub_with(self.u, cs, lit("\""));
        self.rx.get("SINGLE_QUOTE_RE").sub_with(self.u, d, lit("'"))
    }

    fn fix_latin_ligatures(ref self, cs: ref Vec[i64]) -> Vec[i64] {
        translate(cs, self.ligatures)
    }

    fn fix_character_width(ref self, cs: ref Vec[i64]) -> Vec[i64] {
        translate(cs, self.width_map)
    }

    fn fix_line_breaks(ref self, cs: ref Vec[i64]) -> Vec[i64] {
        let nl = lit("\n");
        let a = replace_all(cs, lit("\r\n"), nl);
        let b = replace_all(a, lit("\r"), nl);
        let c = replace_all(b, vec![0x2028], nl);
        let d = replace_all(c, vec![0x2029], nl);
        replace_all(d, vec![0x85], nl)
    }

    // A str here never holds a surrogate code point, so SURROGATE_RE
    // never matches and the text comes back unchanged.
    fn fix_surrogates(ref self, cs: ref Vec[i64]) -> Vec[i64] {
        cs.clone()
    }

    fn remove_control_chars(ref self, cs: ref Vec[i64]) -> Vec[i64] {
        let mut out: Vec[i64] = Vec.new();
        for c in cs {
            if not is_control_char(*c) {
                out.push(*c);
            }
        }
        out
    }

    fn remove_bom(ref self, cs: ref Vec[i64]) -> Vec[i64] {
        let mut k = 0;
        while k < cs.len() and cs[k] == 0xfeff {
            k += 1;
        }
        sub(cs, k, cs.len())
    }

    // codecs.decode(escape, "unicode-escape") for one escape
    // ESCAPE_SEQUENCE_RE matched.
    fn unicode_escape(ref self, m: ref Vec[i64]) -> Result[Vec[i64], Exc] {
        let c = m[1];
        let digits = if c == 120 { 2 } else if c == 117 { 4 } else if c == 85 { 8 } else { 0 };
        if digits > 0 {
            let mut k = 2;
            let mut v = 0;
            while k < 2 + digits and k < m.len() and is_hex(m[k]) {
                v = v * 16 + hexv(m[k]);
                k += 1;
            }
            if k < 2 + digits {
                let what = if c == 120 { "\\xXX" } else if c == 117 { "\\uXXXX" } else { "\\UXXXXXXXX" };
                return Err(exc_s("UnicodeDecodeError", f"'unicodeescape' codec can't decode bytes in position 0-{k - 1}: truncated {what} escape"));
            }
            if v > 0x10ffff {
                return Err(exc_s("UnicodeDecodeError", f"'unicodeescape' codec can't decode bytes in position 0-{k - 1}: illegal Unicode character"));
            }
            return Ok(vec![v]);
        }
        if c >= 48 and c <= 55 {
            let mut v = 0;
            let mut k = 1;
            while k < m.len() {
                v = v * 8 + m[k] - 48;
                k += 1;
            }
            return Ok(vec![v]);
        }
        if c == 78 {
            return Err(exc_s("UnicodeDecodeError", f"'unicodeescape' codec can't decode bytes in position 0-{m.len() - 1}: unknown Unicode character name"));
        }
        let v = if c == 97 { 7 } else if c == 98 { 8 } else if c == 102 { 12 } else if c == 110 { 10 }
            else if c == 114 { 13 } else if c == 116 { 9 } else if c == 118 { 11 } else { c };
        Ok(vec![v])
    }

    fn decode_escapes(ref self, cs: ref Vec[i64]) -> Result[Vec[i64], Exc] {
        let rx = self.rx.get("ESCAPE_SEQUENCE_RE");
        let mut out: Vec[i64] = Vec.new();
        let mut last = 0;
        for (s, e) in rx.spans(self.u, cs) {
            push_all(mut out, sub(cs, last, s));
            push_all(mut out, self.unicode_escape(sub(cs, s, e))?);
            last = e;
        }
        push_all(mut out, sub(cs, last, cs.len()));
        Ok(out)
    }

    fn restore_byte_a0(ref self, b: ref Vec[i64]) -> Vec[i64] {
        let a = self.rx.get("A_GRAVE_WORD_RE").sub_with(self.u, b, vec![0xc3, 0xa0, 0x20]);
        let rx = self.rx.get("ALTERED_UTF8_RE");
        let mut out: Vec[i64] = Vec.new();
        let mut last = 0;
        for (s, e) in rx.spans(self.u, a) {
            push_all(mut out, sub(a, last, s));
            let mut k = s;
            while k < e {
                out.push(if a[k] == 0x20 { 0xa0 } else { a[k] });
                k += 1;
            }
            last = e;
        }
        push_all(mut out, sub(a, last, a.len()));
        out
    }

    fn replace_lossy_sequences(ref self, b: ref Vec[i64]) -> Vec[i64] {
        self.rx.get("LOSSY_UTF8_RE").sub_with(self.u, b, vec![0xef, 0xbf, 0xbd])
    }

    fn decode_inconsistent_utf8(ref self, cs: ref Vec[i64]) -> Vec[i64] {
        let rx = self.rx.get("UTF8_DETECTOR_RE");
        let mut out: Vec[i64] = Vec.new();
        let mut last = 0;
        for (s, e) in rx.spans(self.u, cs) {
            push_all(mut out, sub(cs, last, s));
            let substr = sub(cs, s, e);
            if substr.len() < cs.len() and self.is_bad(substr) {
                push_all(mut out, self.fix_encoding(substr));
            } else {
                push_all(mut out, substr);
            }
            last = e;
        }
        push_all(mut out, sub(cs, last, cs.len()));
        out
    }

    fn fix_c1_controls(ref self, cs: ref Vec[i64]) -> Vec[i64] {
        let k = self.cd.find("sloppy-windows-1252");
        let mut out: Vec[i64] = Vec.new();
        let rx = self.rx.get("C1_CONTROL_RE");
        let mut last = 0;
        for (s, e) in rx.spans(self.u, cs) {
            push_all(mut out, sub(cs, last, s));
            let mut j = s;
            while j < e {
                out.push(self.cd.maps[k].dec[cs[j]]);
                j += 1;
            }
            last = e;
        }
        push_all(mut out, sub(cs, last, cs.len()));
        out
    }

    // A str -> str fixer by its name in FIXERS.
    fn apply_fixer(ref self, name: ref String, cs: ref Vec[i64]) -> Vec[i64] {
        if *name == "unescape_html" {
            self.unescape_html(cs)
        } else if *name == "remove_terminal_escapes" {
            self.remove_terminal_escapes(cs)
        } else if *name == "decode_inconsistent_utf8" {
            self.decode_inconsistent_utf8(cs)
        } else if *name == "fix_c1_controls" {
            self.fix_c1_controls(cs)
        } else if *name == "fix_latin_ligatures" {
            self.fix_latin_ligatures(cs)
        } else if *name == "fix_character_width" {
            self.fix_character_width(cs)
        } else if *name == "uncurl_quotes" {
            self.uncurl_quotes(cs)
        } else if *name == "fix_line_breaks" {
            self.fix_line_breaks(cs)
        } else if *name == "fix_surrogates" {
            self.fix_surrogates(cs)
        } else {
            self.remove_control_chars(cs)
        }
    }

    // ---------------------------------------------------------- fix_encoding

    fn fix_encoding_one_step(ref self, cs: ref Vec[i64], config: ref Config) -> (Vec[i64], Vec[Step]) {
        if cs.len() == 0 {
            return (cs.clone(), Vec.new());
        }
        let mut ascii = true;
        for c in cs {
            if *c > 0x7f {
                ascii = false;
            }
        }
        if ascii or not self.is_bad(cs) {
            return (cs.clone(), Vec.new());
        }
        let mut possible_1byte: Vec[String] = Vec.new();
        for encoding in charmap_encodings() {
            let enc = encoding.to_string();
            if not self.cd.possible(cs, encoding) {
                continue;
            }
            possible_1byte.push(enc.clone());
            let mut encoded = match encode_as(self.cd, cs, enc) {
                Ok(b) => b,
                Err(_) => continue,
            };
            let mut steps: Vec[Step] = Vec.new();
            steps.push(step("encode", enc));
            let mut decoding = "utf-8".to_string();
            if config.restore_byte_a0 and enc != "macroman" and self.rx.get("ALTERED_UTF8_RE").found(self.u, encoded) {
                let replaced = self.restore_byte_a0(encoded);
                if not same(replaced, encoded) {
                    steps.push(step("transcode", "restore_byte_a0".to_string()));
                    encoded = replaced;
                }
            }
            if config.replace_lossy_sequences and enc.starts_with("sloppy") {
                let replaced = self.replace_lossy_sequences(encoded);
                if not same(replaced, encoded) {
                    steps.push(step("transcode", "replace_lossy_sequences".to_string()));
                    encoded = replaced;
                }
            }
            if has_byte(encoded, 0xed) or has_byte(encoded, 0xc0) {
                decoding = "utf-8-variants".to_string();
            }
            match decode_as(self.u, self.rx, self.cd, encoded, decoding) {
                Ok(fixed) => {
                    steps.push(step("decode", decoding));
                    return (fixed, steps);
                }
                Err(_) => {}
            }
        }
        if config.decode_inconsistent_utf8 and self.rx.get("UTF8_DETECTOR_RE").found(self.u, cs) {
            let fixed = self.decode_inconsistent_utf8(cs);
            if not same(fixed, cs) {
                let mut steps: Vec[Step] = Vec.new();
                steps.push(step("apply", "decode_inconsistent_utf8".to_string()));
                return (fixed, steps);
            }
        }
        let mut latin = false;
        let mut win = false;
        for e in possible_1byte.iter() {
            if *e == "latin-1" {
                latin = true;
            }
            if *e == "windows-1252" {
                win = true;
            }
        }
        if latin {
            if win {
                return (cs.clone(), Vec.new());
            }
            let l1 = self.cd.find("latin-1");
            let w = self.cd.find("windows-1252");
            match self.cd.encode1(l1, cs) {
                Ok(b) => match self.cd.decode1(w, b) {
                    Ok(fixed) => {
                        if not same(fixed, cs) {
                            let mut steps: Vec[Step] = Vec.new();
                            steps.push(step("encode", "latin-1".to_string()));
                            steps.push(step("decode", "windows-1252".to_string()));
                            return (fixed, steps);
                        }
                    }
                    Err(_) => {}
                },
                Err(_) => {}
            }
        }
        if config.fix_c1_controls and self.rx.get("C1_CONTROL_RE").found(self.u, cs) {
            let mut steps: Vec[Step] = Vec.new();
            steps.push(step("transcode", "fix_c1_controls".to_string()));
            return (self.fix_c1_controls(cs), steps);
        }
        (cs.clone(), Vec.new())
    }

    fn fix_encoding_and_explain(ref self, cs: ref Vec[i64], config: ref Config) -> (Vec[i64], Vec[Step]) {
        if not config.fix_encoding {
            return (cs.clone(), Vec.new());
        }
        let mut text = cs.clone();
        let mut plan_so_far: Vec[Step] = Vec.new();
        loop {
            let (fixed, plan) = self.fix_encoding_one_step(text, config);
            for s in plan {
                plan_so_far.push(s.clone());
            }
            if same(fixed, text) {
                return (fixed, plan_so_far);
            }
            text = fixed;
        }
    }

    // fix_encoding(text) with no config: TextFixerConfig(explain=False).
    fn fix_encoding(ref self, cs: ref Vec[i64]) -> Vec[i64] {
        let (fixed, _) = self.fix_encoding_and_explain(cs, quiet_config());
        fixed
    }

    // ---------------------------------------------------------- fix_text

    fn try_fix(ref self, name: Str, on: bool, cs: ref Vec[i64], steps: mut ref Option[Vec[Step]]) -> Vec[i64] {
        if not on {
            return cs.clone();
        }
        let fixed = self.apply_fixer(name.to_string(), cs);
        match steps {
            Some(v) => {
                if not same(fixed, cs) {
                    v.push(step("apply", name.to_string()));
                }
            }
            None => {}
        }
        fixed
    }

    fn fix_and_explain(ref self, cs: ref Vec[i64], config0: ref Config) -> Result[(Vec[i64], Option[Vec[Step]]), Exc] {
        let mut config = config0.clone();
        if config.unescape_html == 2 and has(cs, 60) {
            config.unescape_html = 0;
        }
        let mut steps: Option[Vec[Step]] = if config.explain { Some(Vec.new()) } else { None };
        let mut text = cs.clone();
        loop {
            let origtext = text.clone();
            text = self.try_fix("unescape_html", config.unescape_html != 0, text, mut steps);
            if config.fix_encoding {
                match steps {
                    None => {
                        text = self.fix_encoding(text);
                    }
                    Some(mut ref v) => {
                        let (fixed, encoding_steps) = self.fix_encoding_and_explain(text, config);
                        for s in encoding_steps {
                            v.push(s.clone());
                        }
                        text = fixed;
                    }
                }
            }
            text = self.try_fix("fix_c1_controls", config.fix_c1_controls, text, mut steps);
            text = self.try_fix("fix_latin_ligatures", config.fix_latin_ligatures, text, mut steps);
            text = self.try_fix("fix_character_width", config.fix_character_width, text, mut steps);
            text = self.try_fix("uncurl_quotes", config.uncurl_quotes, text, mut steps);
            text = self.try_fix("fix_line_breaks", config.fix_line_breaks, text, mut steps);
            text = self.try_fix("fix_surrogates", config.fix_surrogates, text, mut steps);
            text = self.try_fix("remove_terminal_escapes", config.remove_terminal_escapes, text, mut steps);
            text = self.try_fix("remove_control_chars", config.remove_control_chars, text, mut steps);
            match config.normalization.clone() {
                Some(form) => {
                    let fixed = normalize(self.u, form, text)?;
                    match steps {
                        Some(mut ref v) => {
                            if not same(fixed, text) {
                                v.push(step("normalize", form));
                            }
                        }
                        None => {}
                    }
                    text = fixed;
                }
                None => {}
            }
            if same(text, origtext) {
                return Ok((text, steps));
            }
        }
    }

    fn fix_text(ref self, cs: ref Vec[i64], config0: ref Config) -> Result[Vec[i64], Exc] {
        let mut config = config0.clone();
        let mut out: Vec[i64] = Vec.new();
        let mut pos = 0;
        while pos < cs.len() {
            let mut textbreak = find_from(cs, 10, pos) + 1;
            if textbreak == 0 {
                textbreak = cs.len();
            }
            if textbreak - pos > config.max_decode_length {
                textbreak = pos + config.max_decode_length;
            }
            let segment = sub(cs, pos, textbreak);
            if config.unescape_html == 2 and has(segment, 60) {
                config.unescape_html = 0;
            }
            let (fixed, _) = self.fix_and_explain(segment, config)?;
            push_all(mut out, fixed);
            pos = textbreak;
        }
        Ok(out)
    }

    // ---------------------------------------------------------- guess_bytes

    fn guess_bytes(ref self, b: ref Vec[i64]) -> Result[(Vec[i64], String), Exc] {
        if b.len() >= 2 and ((b[0] == 0xfe and b[1] == 0xff) or (b[0] == 0xff and b[1] == 0xfe)) {
            return Ok((utf16_decode(b)?, "utf-16".to_string()));
        }
        let variants = has(b, 0xed) or has(b, 0xc0);
        let tried = if variants { utf8_variants_decode(self.u, self.rx, b) } else { utf8_decode(b) };
        match tried {
            Ok(t) => {
                let name = if variants { "utf-8-variants" } else { "utf-8" };
                return Ok((t, name.to_string()));
            }
            Err(_) => {}
        }
        if has(b, 0x0d) and not has(b, 0x0a) {
            let k = self.cd.find("macroman");
            return Ok((self.cd.decode1(k, b)?, "macroman".to_string()));
        }
        let k = self.cd.find("sloppy-windows-1252");
        Ok((self.cd.decode1(k, b)?, "sloppy-windows-1252".to_string()))
    }
}

// ------------------------------------------------------------ the jobs

#[derive(Clone)]
enum Val {
    Nil,
    Flag(bool),
    Int(i64),
    Text(Vec[i64]),
    Bytes(Vec[i64]),
    Plan(Vec[Step]),
}

fn decode_val(w: ref String) -> Val {
    if *w == "n" {
        return Val.Nil;
    }
    let tag = w.substring(0, 1);
    let rest = w.substring(2, w.len());
    if tag == "b" {
        Val.Flag(rest == "1")
    } else if tag == "i" {
        Val.Int(match i64.parse(rest) {
            Ok(v) => v,
            Err(_) => 0,
        })
    } else if tag == "s" {
        Val.Text(utf8_text(hex_bytes(rest)))
    } else if tag == "y" {
        Val.Bytes(hex_bytes(rest))
    } else {
        let mut plan: Vec[Step] = Vec.new();
        for part in split_on(rest, ';') {
            if part.len() == 0 {
                continue;
            }
            let ab = split_on(part, ',');
            plan.push(Step { action: ab[0].clone(), param: ab[1].clone() });
        }
        Val.Plan(plan)
    }
}

fn val_repr(u: ref Uni, v: ref Val) -> String {
    match v {
        Val.Nil => "None".to_string(),
        Val.Flag(b) => if *b { "True".to_string() } else { "False".to_string() },
        Val.Int(n) => f"{n}",
        Val.Text(t) => str_repr(u, t),
        Val.Bytes(b) => bytes_repr(b),
        Val.Plan(p) => steps_repr(p),
    }
}

// What a call returns.
enum Out {
    OText(Vec[i64]),
    OBytes(Vec[i64]),
    OExpl(Vec[i64], Option[Vec[Step]]),
    OBool(bool),
    OInt(i64),
    OPair(Vec[i64], String),
}

fn out_repr(u: ref Uni, o: ref Out) -> String {
    match o {
        Out.OText(t) => str_repr(u, t),
        Out.OBytes(b) => bytes_repr(b),
        Out.OExpl(t, steps) => {
            let e = match steps {
                Some(s) => steps_repr(s),
                None => "None".to_string(),
            };
            f"ExplainedText(text={str_repr(u, t)}, explanation={e})"
        }
        Out.OBool(b) => if *b { "True".to_string() } else { "False".to_string() },
        Out.OInt(n) => f"{n}",
        Out.OPair(t, name) => f"({str_repr(u, t)}, '{name}')",
    }
}

fn bytes_error_text() -> String {
    let mut s = "Hey wait, this isn't Unicode.\n\n".to_string();
    s.push_str("ftfy is designed to fix problems with text. Treating bytes like they're\n");
    s.push_str("interchangeable with Unicode text is usually something that introduces\n");
    s.push_str("problems with text.\n\n");
    s.push_str("You should first decode these bytes from the encoding you think they're in.\n");
    s.push_str("If you're not sure what encoding they're in:\n\n");
    s.push_str("- First, try to find out. 'utf-8' is a good assumption.\n");
    s.push_str("- If the encoding is simply unknowable, try running your bytes through\n");
    s.push_str("  ftfy.guess_bytes. As the name implies, this may not always be accurate.\n\n");
    s.push_str("For more information on the distinction between bytes and text, read the\n");
    s.push_str("Python Unicode HOWTO:\n\n");
    s.push_str("    http://docs.python.org/3/howto/unicode.html\n");
    s
}

fn flag_of(v: ref Val) -> bool {
    match v {
        Val.Flag(b) => *b,
        Val.Int(n) => *n != 0,
        Val.Text(t) => t.len() > 0,
        _ => false,
    }
}

// _config_from_kwargs(): config._replace(**kwargs).
fn with_kwargs(config: ref Config, kwargs: ref Vec[(String, Val)]) -> Result[Config, Exc] {
    let mut c = config.clone();
    let mut unknown: Vec[String] = Vec.new();
    for (name, v) in kwargs.iter() {
        let on = flag_of(v);
        if *name == "unescape_html" {
            c.unescape_html = match v {
                Val.Text(t) => if same(t, lit("auto")) { 2 } else if t.len() > 0 { 1 } else { 0 },
                _ => if on { 1 } else { 0 },
            };
        } else if *name == "remove_terminal_escapes" {
            c.remove_terminal_escapes = on;
        } else if *name == "fix_encoding" {
            c.fix_encoding = on;
        } else if *name == "restore_byte_a0" {
            c.restore_byte_a0 = on;
        } else if *name == "replace_lossy_sequences" {
            c.replace_lossy_sequences = on;
        } else if *name == "decode_inconsistent_utf8" {
            c.decode_inconsistent_utf8 = on;
        } else if *name == "fix_c1_controls" {
            c.fix_c1_controls = on;
        } else if *name == "fix_latin_ligatures" {
            c.fix_latin_ligatures = on;
        } else if *name == "fix_character_width" {
            c.fix_character_width = on;
        } else if *name == "uncurl_quotes" {
            c.uncurl_quotes = on;
        } else if *name == "fix_line_breaks" {
            c.fix_line_breaks = on;
        } else if *name == "fix_surrogates" {
            c.fix_surrogates = on;
        } else if *name == "remove_control_chars" {
            c.remove_control_chars = on;
        } else if *name == "normalization" {
            c.normalization = match v {
                Val.Text(t) => Some(cps_str(t)),
                _ => None,
            };
        } else if *name == "max_decode_length" {
            c.max_decode_length = match v {
                Val.Int(n) => *n,
                _ => 0,
            };
        } else if *name == "explain" {
            c.explain = on;
        } else {
            unknown.push(name.clone());
        }
    }
    if unknown.len() > 0 {
        let mut names = "[".to_string();
        let mut k = 0;
        for n in unknown.iter() {
            if k > 0 {
                names.push_str(", ");
            }
            names.push_str(name_repr(n));
            k += 1;
        }
        names.push_str("]");
        return Err(exc_s("TypeError", f"Got unexpected field names: {names}"));
    }
    Ok(c)
}

fn text_arg(args: ref Vec[Val], k: i64) -> Vec[i64] {
    match args[k].clone() {
        Val.Text(t) => t,
        Val.Bytes(b) => b,
        _ => Vec.new(),
    }
}

fn is_bytes(v: ref Val) -> bool {
    match v {
        Val.Bytes(_) => true,
        _ => false,
    }
}

fn bytes_err() -> Exc {
    exc_s("UnicodeError", bytes_error_text())
}

// A plan step's object: a str or bytes.
enum Obj {
    S(Vec[i64]),
    B(Vec[i64]),
}

impl World {
    // apply_plan(text, plan).
    fn apply_plan(ref self, cs: ref Vec[i64], plan: ref Vec[Step]) -> Result[Out, Exc] {
        let mut obj = Obj.S(cs.clone());
        for st in plan.iter() {
            let op = st.action.clone();
            let enc = st.param.clone();
            obj = if op == "encode" {
                match obj {
                    Obj.S(t) => Obj.B(encode_as(self.cd, t, enc)?),
                    Obj.B(_) => return Err(exc("AttributeError", "'bytes' object has no attribute 'encode'")),
                }
            } else if op == "decode" {
                match obj {
                    Obj.B(b) => Obj.S(decode_as(self.u, self.rx, self.cd, b, enc)?),
                    Obj.S(_) => return Err(exc("AttributeError", "'str' object has no attribute 'decode'")),
                }
            } else if op == "transcode" or op == "apply" {
                let known = vec!["unescape_html", "remove_terminal_escapes", "restore_byte_a0",
                    "replace_lossy_sequences", "decode_inconsistent_utf8", "fix_c1_controls",
                    "fix_latin_ligatures", "fix_character_width", "uncurl_quotes",
                    "fix_line_breaks", "fix_surrogates", "remove_control_chars"];
                let mut found = false;
                for k in known {
                    if enc == k {
                        found = true;
                    }
                }
                if not found {
                    return Err(exc_s("ValueError", f"Unknown function to apply: {enc}"));
                }
                let bytes_fixer = enc == "restore_byte_a0" or enc == "replace_lossy_sequences";
                match obj {
                    Obj.B(b) => {
                        if not bytes_fixer {
                            return Err(exc("TypeError", "cannot use a string pattern on a bytes-like object"));
                        }
                        if enc == "restore_byte_a0" { Obj.B(self.restore_byte_a0(b)) } else { Obj.B(self.replace_lossy_sequences(b)) }
                    }
                    Obj.S(t) => {
                        if bytes_fixer {
                            return Err(exc("TypeError", "cannot use a bytes pattern on a string-like object"));
                        }
                        Obj.S(self.apply_fixer(enc, t))
                    }
                }
            } else {
                return Err(exc_s("ValueError", f"Unknown plan step: {op}"));
            };
        }
        match obj {
            Obj.S(t) => Ok(Out.OText(t)),
            Obj.B(b) => Ok(Out.OBytes(b)),
        }
    }

    fn call(ref self, name: ref String, args: ref Vec[Val], kwargs: ref Vec[(String, Val)]) -> Result[Out, Exc] {
        if *name == "fix_text" {
            let config = with_kwargs(quiet_config(), kwargs)?;
            if is_bytes(args[0]) {
                return Err(bytes_err());
            }
            return Ok(Out.OText(self.fix_text(text_arg(args, 0), config)?));
        }
        if *name == "fix_and_explain" {
            if is_bytes(args[0]) {
                return Err(bytes_err());
            }
            let config = with_kwargs(default_config(), kwargs)?;
            let (t, steps) = self.fix_and_explain(text_arg(args, 0), config)?;
            return Ok(Out.OExpl(t, steps));
        }
        if *name == "fix_text_segment" {
            let config = with_kwargs(quiet_config(), kwargs)?;
            let (t, _) = self.fix_and_explain(text_arg(args, 0), config)?;
            return Ok(Out.OText(t));
        }
        if *name == "fix_encoding_and_explain" or *name == "fix_encoding" {
            let base = if *name == "fix_encoding" { quiet_config() } else { default_config() };
            let config = with_kwargs(base, kwargs)?;
            let (t, steps) = self.fix_encoding_and_explain(text_arg(args, 0), config);
            if *name == "fix_encoding" {
                return Ok(Out.OText(t));
            }
            return Ok(Out.OExpl(t, Some(steps)));
        }
        if *name == "apply_plan" {
            let plan = match args[1].clone() {
                Val.Plan(p) => p,
                _ => Vec.new(),
            };
            return self.apply_plan(text_arg(args, 0), plan);
        }
        if *name == "guess_bytes" {
            let (t, enc) = self.guess_bytes(text_arg(args, 0))?;
            return Ok(Out.OPair(t, enc));
        }
        let t = text_arg(args, 0);
        if *name == "badness.badness" {
            return Ok(Out.OInt(self.badness(t)));
        }
        if *name == "badness.is_bad" {
            return Ok(Out.OBool(self.is_bad(t)));
        }
        if *name == "fixes.restore_byte_a0" {
            return Ok(Out.OBytes(self.restore_byte_a0(t)));
        }
        if *name == "fixes.replace_lossy_sequences" {
            return Ok(Out.OBytes(self.replace_lossy_sequences(t)));
        }
        if *name == "fixes.decode_escapes" {
            return Ok(Out.OText(self.decode_escapes(t)?));
        }
        if *name == "fixes.remove_bom" {
            return Ok(Out.OText(self.remove_bom(t)));
        }
        let fixer = name.substring(6, name.len());
        Ok(Out.OText(self.apply_fixer(fixer, t)))
    }

    fn show_table(ref self, name: ref String) {
        println(f"> chardata.{name}");
        if *name == "WIDTH_MAP" {
            println(f"  -> {self.width_keys.len()} entries");
            for k in self.width_keys.iter() {
                let v = match self.width_map.get(*k) {
                    Some(v) => v.clone(),
                    None => Vec.new(),
                };
                println(f"  0x{hex_digits(*k, 4)}: {str_repr(self.u, v)}");
            }
            return;
        }
        println(f"  -> {self.html.keys.len()} entries");
        let mut keys: Vec[String] = Vec.new();
        for k in self.html.keys.iter() {
            let bare = k.substring(1, k.len());
            if self.html.html5(bare) < 0 {
                keys.push(k.clone());
            }
        }
        keys.sort();
        for k in keys.iter() {
            let v = match self.html.entities.get(k) {
                Some(v) => v.clone(),
                None => Vec.new(),
            };
            println(f"  {str_repr(self.u, cps_of(k))}: {str_repr(self.u, v)}");
        }
    }
}

fn is_kwarg(w: ref String) -> bool {
    let cs = cps_of(w);
    let eq = find_from(cs, 61, 0);
    if eq <= 0 {
        return false;
    }
    let mut k = 0;
    while k < eq {
        let c = cs[k];
        if not ((c >= 97 and c <= 122) or c == 95 or (c >= 48 and c <= 57)) {
            return false;
        }
        k += 1;
    }
    true
}

fn main() {
    let w = load_world();
    for line in split_on(jobs_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, '\t');
        if f[0] == "job" {
            println(f"== {f[1]}");
            continue;
        }
        if f[0] == "table" {
            w.show_table(f[1]);
            continue;
        }
        let mut args: Vec[Val] = Vec.new();
        let mut kwargs: Vec[(String, Val)] = Vec.new();
        let mut shown: Vec[String] = Vec.new();
        let mut k = 1;
        while k < f.len() {
            let field = f[k].clone();
            if is_kwarg(field) {
                let cs = cps_of(field);
                let eq = find_from(cs, 61, 0);
                let name = cps_str(sub(cs, 0, eq));
                let v = decode_val(cps_str(sub(cs, eq + 1, cs.len())));
                shown.push(f"{name}={val_repr(w.u, v)}");
                kwargs.push((name, v));
            } else {
                let v = decode_val(field);
                shown.push(val_repr(w.u, v));
                args.push(v);
            }
            k += 1;
        }
        let mut joined = String.new();
        let mut i = 0;
        for s in shown.iter() {
            if i > 0 {
                joined.push_str(", ");
            }
            joined.push_str(s);
            i += 1;
        }
        println(f"> {f[0]}({joined})");
        match w.call(f[0], args, kwargs) {
            Ok(o) => println(f"  -> {out_repr(w.u, o)}"),
            Err(e) => println(f"  error {e.kind}: {e.msg}"),
        }
    }
}

