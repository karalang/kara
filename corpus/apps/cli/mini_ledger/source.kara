// mini_ledger: plain-text double-entry accounting, in the shape of
// ledger-cli, hledger and Beancount. It reads journals of dated
// directives (each file parsed in a task of its own), imports a bank's
// card statement through rules, books every transaction in date order
// (balancing, stock lots held at cost and sold first in first out,
// currency conversions, balance assertions), writes the accepted journal
// back out, reads that back to check it, and runs the reports people run
// at the end of a month.

const ONE: i64 = 1000000;

// ------------------------------------------------------------ numbers

// n / d rounded half away from zero, for d > 0.
fn rdiv(n: i64, d: i64) -> i64 {
    let q = (n.abs() * 2 + d) / (2 * d);
    if n < 0 { -q } else { q }
}

fn mul(a: i64, b: i64) -> i64 {
    rdiv(a * b, ONE)
}

fn pow10(n: i64) -> i64 {
    let mut p = 1;
    for _ in 0..n {
        p *= 10;
    }
    p
}

fn round_to(x: i64, prec: i64) -> i64 {
    let u = pow10(6 - prec);
    rdiv(x, u) * u
}

// A number with `,` grouping and `prec` decimals.
fn fmt_num(x: i64, prec: i64) -> String {
    let x = round_to(x, prec);
    let neg = x < 0;
    let x = x.abs();
    let digits = f"{x / ONE}";
    let mut s = String.new();
    let n = digits.len();
    for (i, c) in digits.chars().enumerate() {
        if i > 0 and (n - i) % 3 == 0 {
            s.push(',');
        }
        s.push(c);
    }
    if prec > 0 {
        let frac = f"{x % ONE + ONE}";
        s.push('.');
        s.push_str(frac.substring(1, 1 + prec));
    }
    if neg and x != 0 {
        return f"-{s}";
    }
    s
}

fn rjust(s: Str, w: i64) -> String {
    let mut out = String.new();
    for _ in s.len()..w {
        out.push(' ');
    }
    out.push_str(s);
    out
}

// The first `w` bytes of `s`, padded with spaces to `w`.
fn cell(s: Str, w: i64) -> String {
    let mut out = if s.len() > w { s.substring(0, w) } else { s.to_string() };
    while out.len() < w {
        out.push(' ');
    }
    out
}

// ------------------------------------------------------------ dates

fn leap(y: i64) -> bool {
    y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)
}

fn mdays(y: i64, m: i64) -> i64 {
    if m == 2 {
        return if leap(y) { 29 } else { 28 };
    }
    if m == 4 or m == 6 or m == 9 or m == 11 { 30 } else { 31 }
}

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn is_upper(c: u8) -> bool {
    c >= b'A' and c <= b'Z'
}

fn is_lower(c: u8) -> bool {
    c >= b'a' and c <= b'z'
}

fn all_digits(s: Str) -> bool {
    s.bytes().iter().all(|c| is_digit(c))
}

fn date_shape(s: Str) -> bool {
    let b = s.bytes();
    s.len() == 10 and b[4] == b'-' and b[7] == b'-'
}

fn valid_date(s: Str) -> bool {
    if not date_shape(s) {
        return false;
    }
    let y = s.substring(0, 4);
    let m = s.substring(5, 7);
    let d = s.substring(8, 10);
    if not (all_digits(y) and all_digits(m) and all_digits(d)) {
        return false;
    }
    let y = i64.parse(y).unwrap_or(0);
    let m = i64.parse(m).unwrap_or(0);
    let d = i64.parse(d).unwrap_or(0);
    m >= 1 and m <= 12 and d >= 1 and d <= mdays(y, m)
}

fn two(n: i64) -> String {
    if n < 10 { f"0{n}" } else { f"{n}" }
}

fn next_day(s: Str) -> String {
    let mut y = i64.parse(s.substring(0, 4)).unwrap_or(0);
    let mut m = i64.parse(s.substring(5, 7)).unwrap_or(0);
    let mut d = i64.parse(s.substring(8, 10)).unwrap_or(0) + 1;
    if d > mdays(y, m) {
        d = 1;
        m += 1;
        if m > 12 {
            m = 1;
            y += 1;
        }
    }
    f"{y}-{two(m)}-{two(d)}"
}

// ------------------------------------------------------------ syntax

const TYPES: Array[Str, 5] = ["Assets", "Liabilities", "Equity", "Income", "Expenses"];

fn type_rank(s: Str) -> i64 {
    for (i, t) in TYPES.iter().enumerate() {
        if t == s {
            return i;
        }
    }
    TYPES.len()
}

fn valid_account(s: Str) -> bool {
    let parts: Vec[Str] = s.split(":").collect();
    if parts.len() < 2 or type_rank(parts[0]) == TYPES.len() {
        return false;
    }
    for p in parts.iter().skip(1) {
        let b = p.bytes();
        if b.len() == 0 or not (is_upper(b[0]) or is_digit(b[0])) {
            return false;
        }
        if not b.iter().all(|c| is_upper(c) or is_lower(c) or is_digit(c) or c == b'-') {
            return false;
        }
    }
    true
}

fn valid_commodity(s: Str) -> bool {
    let b = s.bytes();
    b.len() >= 2 and b.len() <= 10 and is_upper(b[0]) and b.iter().all(|c| is_upper(c) or is_digit(c))
}

// (micro, decimals written) from a number.
fn parse_number(s: Str) -> Option[(i64, i64)] {
    let neg = s.starts_with("-");
    let body = if neg { s.substring(1) } else { s.to_string() };
    let (whole, frac) = match body.split_once(".") {
        Some((w, f)) => {
            if f.len() == 0 or f.contains(".") {
                return None;
            }
            (w.to_string(), f.to_string())
        }
        None => (body.clone(), "".to_string()),
    };
    let groups: Vec[Str] = whole.split(",").collect();
    if groups.len() > 1 {
        if groups[0].len() < 1 or groups[0].len() > 3 {
            return None;
        }
        for g in groups.iter().skip(1) {
            if g.len() != 3 {
                return None;
            }
        }
    }
    let whole = groups.join("");
    if whole.len() == 0 or not all_digits(whole) {
        return None;
    }
    if not all_digits(frac) or frac.len() > 6 {
        return None;
    }
    let mut v = i64.parse(whole).ok()? * ONE;
    if frac.len() > 0 {
        v += i64.parse(frac).ok()? * pow10(6 - frac.len());
    }
    Some((if neg { -v } else { v }, frac.len()))
}

#[derive(Clone)]
struct Amount {
    qty: i64,
    comm: String,
    scale: i64,
}

// `NUMBER COMMODITY`.
fn parse_amount(s: Str) -> Option[Amount] {
    let toks: Vec[Str] = s.split_whitespace().collect();
    if toks.len() != 2 or not valid_commodity(toks[1]) {
        return None;
    }
    let (qty, scale) = parse_number(toks[0])?;
    Some(Amount { qty: qty, comm: toks[1].to_string(), scale: scale })
}

fn strip_comment(line: Str) -> String {
    match line.find(";") {
        Some(i) => line.substring(0, i),
        None => line.to_string(),
    }
}

#[derive(Clone)]
enum Cost {
    NoCost,
    AnyLot,
    At(Amount),
}

#[derive(Clone)]
enum Price {
    NoPrice,
    Unit(Amount),
    Total(Amount),
}

#[derive(Clone)]
struct Posting {
    account: String,
    amount: Option[Amount],
    cost: Cost,
    price: Price,
}

fn parse_posting(text: Str) -> Result[Posting, String] {
    let text = text.trim();
    let (account, rest) = match text.split_once(" ") {
        Some((a, r)) => (a.to_string(), r.trim().to_string()),
        None => (text.to_string(), "".to_string()),
    };
    if not valid_account(account) {
        return Err(f"bad account name \"{account}\"");
    }
    let mut p = Posting { account: account, amount: None, cost: Cost.NoCost, price: Price.NoPrice };
    if rest.len() == 0 {
        return Ok(p);
    }
    let bad = f"bad amount \"{rest}\"";
    let mut left = rest.clone();
    if let Some(i) = rest.find("@") {
        left = rest.substring(0, i).trim().to_string();
        let total = rest.substring(i + 1).starts_with("@");
        let pa = if total { parse_amount(rest.substring(i + 2)) } else { parse_amount(rest.substring(i + 1)) };
        match pa {
            Some(a) if a.qty >= 0 => {
                p.price = if total { Price.Total(a) } else { Price.Unit(a) };
            }
            _ => return Err(bad),
        }
    }
    if let Some(j) = left.find("{") {
        let k = match left.find("}") {
            Some(k) if k > j => k,
            _ => return Err(bad),
        };
        if left.substring(k + 1).trim().len() > 0 {
            return Err(bad);
        }
        let inner = left.substring(j + 1, k).trim().to_string();
        left = left.substring(0, j).trim().to_string();
        if inner.len() == 0 {
            p.cost = Cost.AnyLot;
        } else {
            match parse_amount(inner) {
                Some(c) if c.qty > 0 => p.cost = Cost.At(c),
                _ => return Err(bad),
            }
        }
    }
    let a = match parse_amount(left) {
        Some(a) => a,
        None => return Err(bad),
    };
    if a.qty > 0 and match p.cost { Cost.AnyLot => true, _ => false } {
        return Err("an added lot needs a cost".to_string());
    }
    if a.qty == 0 and match p.price { Price.Total(_) => true, _ => false } {
        return Err(bad);
    }
    p.amount = Some(a);
    Ok(p)
}

#[derive(Clone)]
enum Body {
    Open(String, Vec[String]),
    Close(String),
    Balance(String, Amount),
    PriceOf(String, Amount),
    Txn(Txn),
}

#[derive(Clone)]
struct Txn {
    flag: String,
    payee: String,
    narration: String,
    postings: Vec[Posting],
}

#[derive(Clone)]
struct Directive {
    date: String,
    file: String,
    fidx: i64,
    line: i64,
    body: Body,
}

impl Directive {
    fn rank(self) -> i64 {
        match self.body {
            Body.Open(_, _) => 0,
            Body.Balance(_, _) => 1,
            Body.Close(_) => 3,
            _ => 2,
        }
    }
}

struct Parsed {
    directives: Vec[Directive],
    errors: Vec[String],
}

// A directive line other than a transaction header.
fn parse_directive(toks: Vec[Str]) -> Result[Body, String] {
    let kind = toks[1];
    if kind == "open" {
        if toks.len() != 3 and toks.len() != 4 {
            return Err("cannot parse line".to_string());
        }
        if not valid_account(toks[2]) {
            return Err(f"bad account name \"{toks[2]}\"");
        }
        let mut comms: Vec[String] = Vec.new();
        if toks.len() == 4 {
            for c in toks[3].split(",") {
                if not valid_commodity(c) {
                    return Err(f"bad commodity \"{c}\"");
                }
                comms.push(c.to_string());
            }
        }
        return Ok(Body.Open(toks[2].to_string(), comms));
    }
    if kind == "close" {
        if toks.len() != 3 {
            return Err("cannot parse line".to_string());
        }
        if not valid_account(toks[2]) {
            return Err(f"bad account name \"{toks[2]}\"");
        }
        return Ok(Body.Close(toks[2].to_string()));
    }
    if kind == "balance" {
        if toks.len() != 5 {
            return Err("cannot parse line".to_string());
        }
        if not valid_account(toks[2]) {
            return Err(f"bad account name \"{toks[2]}\"");
        }
        let text = f"{toks[3]} {toks[4]}";
        return match parse_amount(text) {
            Some(a) => Ok(Body.Balance(toks[2].to_string(), a)),
            None => Err(f"bad amount \"{text}\""),
        };
    }
    if kind == "price" {
        if toks.len() != 5 or not valid_commodity(toks[2]) {
            return Err("cannot parse line".to_string());
        }
        let text = f"{toks[3]} {toks[4]}";
        return match parse_amount(text) {
            Some(a) if a.qty > 0 => Ok(Body.PriceOf(toks[2].to_string(), a)),
            _ => Err(f"bad amount \"{text}\""),
        };
    }
    Err(f"unknown directive \"{kind}\"")
}

struct Pending {
    date: String,
    line: i64,
    txn: Txn,
    bad: bool,
}

fn finish(path: Str, fidx: i64, cur: own Option[Pending], out: mut ref Parsed) {
    if let Some(t) = cur {
        if t.bad {
            return;
        }
        if t.txn.postings.is_empty() {
            out.errors.push(f"{path}:{t.line}: transaction has no postings");
            return;
        }
        out.directives.push(Directive {
            date: t.date,
            file: path.to_string(),
            fidx: fidx,
            line: t.line,
            body: Body.Txn(t.txn),
        });
    }
}

fn parse_journal(path: String, fidx: i64, text: String) -> Parsed {
    let mut out = Parsed { directives: Vec.new(), errors: Vec.new() };
    let mut cur: Option[Pending] = None;
    let mut skipping = false;
    let mut n = 0;
    for raw in text.split("\n") {
        n += 1;
        if raw.trim().len() == 0 {
            finish(path, fidx, cur, mut out);
            cur = None;
            skipping = false;
            continue;
        }
        if raw.starts_with("#") {
            continue;
        }
        let line = strip_comment(raw).trim_end().to_string();
        if line.trim().len() == 0 {
            continue;
        }
        if raw.starts_with(" ") or raw.starts_with("\t") {
            if skipping {
                continue;
            }
            match cur {
                None => {
                    out.errors.push(f"{path}:{n}: posting outside a transaction");
                    skipping = true;
                }
                Some(mut ref t) => {
                    if not t.bad {
                        match parse_posting(line) {
                            Ok(p) => t.txn.postings.push(p),
                            Err(e) => {
                                out.errors.push(f"{path}:{n}: {e}");
                                t.bad = true;
                            }
                        }
                    }
                }
            }
            continue;
        }
        finish(path, fidx, cur, mut out);
        cur = None;
        skipping = false;
        let toks: Vec[Str] = line.split_whitespace().collect();
        let date = toks[0];
        if not valid_date(date) {
            if date_shape(date) {
                out.errors.push(f"{path}:{n}: bad date \"{date}\"");
            } else {
                out.errors.push(f"{path}:{n}: cannot parse line");
            }
            skipping = true;
            continue;
        }
        if toks.len() < 2 {
            out.errors.push(f"{path}:{n}: cannot parse line");
            skipping = true;
            continue;
        }
        if toks[1] == "*" or toks[1] == "!" {
            let rest = line.trim().substring(10).trim().substring(1).trim().to_string();
            let (payee, narration) = match rest.split_once("|") {
                Some((p, q)) => (p.trim().to_string(), q.trim().to_string()),
                None => (rest.clone(), "".to_string()),
            };
            if payee.len() == 0 {
                out.errors.push(f"{path}:{n}: transaction needs a payee");
                skipping = true;
                continue;
            }
            cur = Some(Pending {
                date: date.to_string(),
                line: n,
                txn: Txn { flag: toks[1].to_string(), payee: payee, narration: narration, postings: Vec.new() },
                bad: false,
            });
            continue;
        }
        match parse_directive(toks) {
            Ok(body) => out.directives.push(Directive {
                date: date.to_string(),
                file: path.clone(),
                fidx: fidx,
                line: n,
                body: body,
            }),
            Err(e) => {
                out.errors.push(f"{path}:{n}: {e}");
                skipping = true;
            }
        }
    }
    finish(path, fidx, cur, mut out);
    out
}

// ------------------------------------------------------------ the bank import

fn split_csv(line: Str) -> Option[Vec[String]] {
    let mut fields: Vec[String] = Vec.new();
    let mut cur = String.new();
    let mut quoted = false;
    let chars: Vec[char] = line.chars().collect();
    let mut i = 0;
    while i < chars.len() {
        let c = chars[i];
        if quoted {
            if c == '"' {
                if i + 1 < chars.len() and chars[i + 1] == '"' {
                    cur.push('"');
                    i += 1;
                } else {
                    quoted = false;
                }
            } else {
                cur.push(c);
            }
        } else if c == '"' {
            quoted = true;
        } else if c == ',' {
            fields.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
        i += 1;
    }
    if quoted {
        return None;
    }
    fields.push(cur);
    Some(fields)
}

struct Rule {
    pattern: String,
    account: String,
    payee: Option[String],
}

struct Rules {
    account: String,
    currency: String,
    default: String,
    matches: Vec[Rule],
}

fn parse_rules(text: Str) -> Rules {
    let mut r = Rules { account: "".to_string(), currency: "".to_string(), default: "".to_string(), matches: Vec.new() };
    for raw in text.split("\n") {
        let line = raw.trim();
        if line.len() == 0 or line.starts_with("#") {
            continue;
        }
        let (word, rest) = match line.split_once(" ") {
            Some((w, x)) => (w, x.trim()),
            None => (line, ""),
        };
        if word == "match" {
            let parts: Vec[String] = rest.split("=>").map(|x| x.trim().to_string()).collect();
            let payee = if parts.len() > 2 { Some(parts[2].clone()) } else { None };
            r.matches.push(Rule { pattern: parts[0].to_uppercase(), account: parts[1].clone(), payee: payee });
        } else if word == "account" {
            r.account = rest.to_string();
        } else if word == "currency" {
            r.currency = rest.to_string();
        } else if word == "default" {
            r.default = rest.to_string();
        }
    }
    r
}

struct Row {
    date: String,
    line: i64,
    desc: String,
    amount: (i64, i64),
    balance: Option[(i64, i64)],
}

struct Imported {
    directives: Vec[Directive],
    errors: Vec[String],
    summary: String,
}

fn csv_amount(s: Str) -> Option[(i64, i64)] {
    let s = s.trim();
    let neg = s.starts_with("-");
    let s = if neg { s.substring(1) } else { s.to_string() };
    let s = s.strip_prefix("$") ?? s.as_str();
    let (v, scale) = parse_number(s)?;
    Some((if neg { -v } else { v }, scale))
}

fn import_csv(path: String, fidx: i64, text: String, rules: Rules) -> Imported {
    let mut lines: Vec[Str] = text.split("\n").collect();
    if lines.len() > 0 and lines[lines.len() - 1].len() == 0 {
        lines.pop();
    }
    let head: Vec[String] = (split_csv(lines[0]) ?? Vec.new()).iter().map(|h| h.trim().to_lowercase()).collect();
    let col = |name: Str| {
        for (i, h) in head.iter().enumerate() {
            if h == name {
                return i;
            }
        }
        0
    };
    let (cd, cdesc, camt, cbal) = (col("date"), col("description"), col("amount"), col("balance"));
    let mut rows: Vec[Row] = Vec.new();
    let mut errors: Vec[String] = Vec.new();
    for (k, line) in lines.iter().enumerate().skip(1) {
        let n = k + 1;
        let f = match split_csv(line) {
            Some(f) if f.len() == head.len() => f,
            _ => {
                errors.push(f"{path}:{n}: cannot parse row");
                continue;
            }
        };
        let ds = f[cd].trim().to_string();
        let p: Vec[Str] = ds.split("/").collect();
        let date = if p.len() == 3 and p[2].len() == 4 and p[0].len() == 2 and p[1].len() == 2 {
            f"{p[2]}-{p[0]}-{p[1]}"
        } else {
            "".to_string()
        };
        if not valid_date(date) {
            errors.push(f"{path}:{n}: bad date \"{ds}\"");
            continue;
        }
        let amount = match csv_amount(f[camt]) {
            Some(a) => a,
            None => {
                errors.push(f"{path}:{n}: bad amount \"{f[camt].trim()}\"");
                continue;
            }
        };
        let desc: Vec[Str] = f[cdesc].split_whitespace().collect();
        rows.push(Row { date: date, line: n, desc: desc.join(" "), amount: amount, balance: csv_amount(f[cbal]) });
    }
    rows.sort_by(|a, b| a.date.cmp(b.date).then(b.line.cmp(a.line)));
    let mut out: Vec[Directive] = Vec.new();
    let mut matched = 0;
    for r in rows.iter() {
        let mut account = rules.default.clone();
        let mut payee = r.desc.clone();
        let mut flag = "!";
        let upper = r.desc.to_uppercase();
        for m in rules.matches.iter() {
            if upper.contains(m.pattern) {
                account = m.account.clone();
                flag = "*";
                if let Some(p) = m.payee {
                    payee = p.clone();
                }
                break;
            }
        }
        if flag == "*" {
            matched += 1;
        }
        let card = Posting {
            account: rules.account.clone(),
            amount: Some(Amount { qty: r.amount.0, comm: rules.currency.clone(), scale: r.amount.1 }),
            cost: Cost.NoCost,
            price: Price.NoPrice,
        };
        let other = Posting { account: account, amount: None, cost: Cost.NoCost, price: Price.NoPrice };
        out.push(Directive {
            date: r.date.clone(),
            file: path.clone(),
            fidx: fidx,
            line: r.line,
            body: Body.Txn(Txn { flag: flag.to_string(), payee: payee, narration: "".to_string(), postings: vec![card, other] }),
        });
    }
    if let Some(newest) = rows.last() {
        if let Some((b, scale)) = newest.balance {
            out.push(Directive {
                date: next_day(newest.date),
                file: path.clone(),
                fidx: fidx,
                line: newest.line,
                body: Body.Balance(rules.account.clone(), Amount { qty: b, comm: rules.currency.clone(), scale: scale }),
            });
        }
    }
    let summary = f"{path}: {rows.len()} rows, {matched} matched, {rows.len() - matched} to {rules.default}";
    Imported { directives: out, errors: errors, summary: summary }
}

// ------------------------------------------------------------ checking

fn under(acc: Str, root: Str) -> bool {
    acc == root or acc.starts_with(f"{root}:")
}

// Tree order: segment by segment.
fn tree_key(acc: Str) -> String {
    acc.replace(":", "\u{1}")
}

#[derive(Clone)]
struct Lot {
    date: String,
    qty: i64,
    cost: i64,
    comm: String,
    scale: i64,
}

struct Posted {
    date: String,
    payee: String,
    account: String,
    comm: String,
    qty: i64,
}

struct PricePoint {
    date: String,
    comm: String,
    value: i64,
    target: String,
}

struct Ledger {
    dirs: Vec[Directive],
    prec: Map[String, i64],
    ever: Set[String],
    open: Map[String, Vec[String]],
    closed: Set[String],
    bal: SortedMap[String, SortedMap[String, i64]],
    lots: SortedMap[String, SortedMap[String, Vec[Lot]]],
    entries: Vec[Posted],
    prices: Vec[PricePoint],
    accepted: Vec[Directive],
    errors: Vec[String],
    txns: i64,
    refused: i64,
    asserts: i64,
    failed: i64,
}

fn see(prec: mut ref Map[String, i64], a: Amount) {
    let old = prec.get(a.comm).cloned() ?? 0;
    if a.scale > old or not prec.contains_key(a.comm) {
        prec.insert(a.comm.clone(), if a.scale > old { a.scale } else { old });
    }
}

fn precisions(dirs: Vec[Directive]) -> Map[String, i64] {
    let mut prec: Map[String, i64] = Map.new();
    for d in dirs.iter() {
        match d.body {
            Body.Txn(t) => {
                for p in t.postings.iter() {
                    if let Some(a) = p.amount {
                        see(mut prec, a);
                    }
                }
            }
            Body.Balance(_, a) => see(mut prec, a),
            _ => {}
        }
    }
    prec
}

fn add(m: mut ref SortedMap[String, i64], comm: Str, v: i64) {
    let old = m.get(comm).cloned() ?? 0;
    m.insert(comm.to_string(), old + v);
}

impl Ledger {
    fn new(dirs: own Vec[Directive]) -> Ledger {
        let mut dirs = dirs;
        dirs.sort_by(|a, b| a.date.cmp(b.date).then(a.rank().cmp(b.rank())).then(a.fidx.cmp(b.fidx)).then(a.line.cmp(b.line)));
        let prec = precisions(dirs);
        let mut ever: Set[String] = Set.new();
        for d in dirs.iter() {
            if let Body.Open(acc, _) = d.body {
                ever.insert(acc.clone());
            }
        }
        Ledger {
            dirs: dirs,
            prec: prec,
            ever: ever,
            open: Map.new(),
            closed: Set.new(),
            bal: SortedMap.new(),
            lots: SortedMap.new(),
            entries: Vec.new(),
            prices: Vec.new(),
            accepted: Vec.new(),
            errors: Vec.new(),
            txns: 0,
            refused: 0,
            asserts: 0,
            failed: 0,
        }
    }

    fn p(self, comm: Str) -> i64 {
        self.prec.get(comm).cloned() ?? 2
    }

    fn amt(self, x: i64, comm: Str) -> String {
        f"{fmt_num(x, self.p(comm))} {comm}"
    }

    fn err(mut ref self, d: Directive, msg: Str) {
        self.errors.push(f"{d.date} {d.file}:{d.line}: {msg}");
    }

    fn known(self, acc: Str) -> bool {
        self.ever.iter().any(|o| under(o, acc))
    }

    fn run(mut ref self) {
        let dirs = self.dirs.clone();
        for d in dirs.iter() {
            match d.body {
                Body.Open(acc, comms) => {
                    if self.open.contains_key(acc) {
                        self.err(d, f"account {acc} is already open");
                        continue;
                    }
                    self.open.insert(acc.clone(), comms.clone());
                    self.accepted.push(d.clone());
                }
                Body.Close(acc) => {
                    if not self.open.contains_key(acc) or self.closed.contains(acc) {
                        self.err(d, f"account {acc} is not open");
                        continue;
                    }
                    self.closed.insert(acc.clone());
                    self.accepted.push(d.clone());
                }
                Body.PriceOf(comm, a) => {
                    self.prices.push(PricePoint { date: d.date.clone(), comm: comm.clone(), value: a.qty, target: a.comm.clone() });
                    self.accepted.push(d.clone());
                }
                Body.Balance(acc, want) => {
                    self.asserts += 1;
                    if not self.known(acc) {
                        self.err(d, f"unknown account {acc}");
                        self.failed += 1;
                        continue;
                    }
                    let mut got = 0;
                    for (a, m) in self.bal.iter() {
                        if under(a, acc) {
                            got += m.get(want.comm).cloned() ?? 0;
                        }
                    }
                    self.accepted.push(d.clone());
                    if round_to(got, self.p(want.comm)) != want.qty {
                        self.failed += 1;
                        let msg = f"balance failed: {acc} expected {self.amt(want.qty, want.comm)}, got {self.amt(got, want.comm)}";
                        self.err(d, msg);
                    }
                }
                Body.Txn(t) => {
                    self.txns += 1;
                    if let Err(msg) = self.book(d, t) {
                        self.refused += 1;
                        self.err(d, msg);
                    }
                }
            }
        }
    }

    fn account_ok(self, acc: Str, comm: Option[String]) -> Result[(), String] {
        if not self.ever.contains(acc) {
            return Err(f"unknown account {acc}");
        }
        if self.closed.contains(acc) {
            return Err(f"account {acc} is closed");
        }
        let comms = match self.open.get(acc) {
            Some(c) => c,
            None => return Err(f"account {acc} is not open yet"),
        };
        if let Some(c) = comm {
            if comms.len() > 0 and not comms.contains(c) {
                return Err(f"account {acc} does not take {c}");
            }
        }
        Ok(())
    }

    fn book(mut ref self, d: Directive, t: Txn) -> Result[(), String] {
        for p in t.postings.iter() {
            let comm = match p.amount {
                Some(a) => Some(a.comm.clone()),
                None => None,
            };
            self.account_ok(p.account, comm)?;
        }
        let elided: Vec[String] = t.postings.iter().filter(|p| p.amount.is_none()).map(|p| p.account.clone()).collect();
        if elided.len() > 1 {
            return Err("more than one posting without an amount".to_string());
        }
        let mut lots: SortedMap[String, Vec[Lot]] = SortedMap.new();
        let mut weights: SortedMap[String, i64] = SortedMap.new();
        let mut new_prices: Vec[PricePoint] = Vec.new();
        for p in t.postings.iter() {
            let a = match p.amount {
                Some(a) => a,
                None => continue,
            };
            let (q, c) = (a.qty, a.comm.clone());
            match p.price {
                Price.Unit(pa) => new_prices.push(PricePoint { date: d.date.clone(), comm: c.clone(), value: pa.qty, target: pa.comm.clone() }),
                Price.Total(pa) => new_prices.push(PricePoint {
                    date: d.date.clone(),
                    comm: c.clone(),
                    value: rdiv(pa.qty * ONE, q.abs()),
                    target: pa.comm.clone(),
                }),
                Price.NoPrice => {}
            }
            let key = f"{p.account}\t{c}";
            match p.cost {
                Cost.NoCost => match p.price {
                    Price.Unit(pa) => add(mut weights, pa.comm, mul(q, pa.qty)),
                    Price.Total(pa) => add(mut weights, pa.comm, if q > 0 { pa.qty } else { -pa.qty }),
                    Price.NoPrice => add(mut weights, c, q),
                },
                _ => {
                    if not lots.contains_key(key) {
                        let held = match self.lots.get(p.account) {
                            Some(m) => m.get(c).cloned() ?? Vec.new(),
                            None => Vec.new(),
                        };
                        lots.insert(key.clone(), held);
                    }
                    let held = lots[key].clone();
                    if let Cost.At(ca) = p.cost {
                        if q > 0 {
                            let mut held = held;
                            held.push(Lot { date: d.date.clone(), qty: q, cost: ca.qty, comm: ca.comm.clone(), scale: ca.scale });
                            lots.insert(key.clone(), held);
                            add(mut weights, ca.comm, mul(q, ca.qty));
                            continue;
                        }
                    }
                    let fits = |l: Lot| {
                        match p.cost {
                            Cost.At(ca) => l.cost == ca.qty and l.comm == ca.comm,
                            _ => true,
                        }
                    };
                    let mut need = -q;
                    let mut have = 0;
                    for l in held.iter() {
                        if fits(l) {
                            have += l.qty;
                        }
                    }
                    if have < need {
                        let what = match p.cost {
                            Cost.At(ca) => f"{c} {{{fmt_num(ca.qty, ca.scale)} {ca.comm}}}",
                            _ => c.clone(),
                        };
                        return Err(f"not enough {what} in {p.account}: have {fmt_num(have, self.p(c))}, need {fmt_num(need, self.p(c))}");
                    }
                    let mut kept: Vec[Lot] = Vec.new();
                    for l in held.iter() {
                        let mut l = l.clone();
                        if need > 0 and fits(l) {
                            let take = if need < l.qty { need } else { l.qty };
                            l.qty -= take;
                            need -= take;
                            add(mut weights, l.comm, -mul(take, l.cost));
                        }
                        if l.qty > 0 {
                            kept.push(l);
                        }
                    }
                    lots.insert(key.clone(), kept);
                }
            }
        }
        let mut left: SortedMap[String, i64] = SortedMap.new();
        for (c, v) in weights.iter() {
            if round_to(v, self.p(c)) != 0 {
                left.insert(c.clone(), v);
            }
        }
        let mut filled: Vec[Amount] = Vec.new();
        if elided.len() == 1 {
            if left.is_empty() {
                return Err("nothing to fill in the posting without an amount".to_string());
            }
            for (c, v) in left.iter() {
                self.account_ok(elided[0], Some(c.clone()))?;
                filled.push(Amount { qty: round_to(-v, self.p(c)), comm: c.clone(), scale: self.p(c) });
            }
        } else if not left.is_empty() {
            let parts: Vec[String] = left.iter().map(|(c, v)| self.amt(v, c)).collect();
            return Err(f"transaction does not balance: {parts.join(", ")}");
        }
        // Commit.
        for (key, held) in lots.iter() {
            let (acc, comm) = key.split_once("\t") ?? ("", "");
            if not self.lots.contains_key(acc) {
                self.lots.insert(acc.to_string(), SortedMap.new());
            }
            self.lots[acc].insert(comm.to_string(), held.clone());
        }
        for pp in new_prices.into_iter() {
            self.prices.push(pp);
        }
        let mut out: Vec[Posting] = Vec.new();
        for p in t.postings.iter() {
            if p.amount.is_none() {
                for a in filled.iter() {
                    out.push(Posting { account: p.account.clone(), amount: Some(a.clone()), cost: Cost.NoCost, price: Price.NoPrice });
                }
            } else {
                out.push(p.clone());
            }
        }
        for p in out.iter() {
            let a = match p.amount {
                Some(a) => a,
                None => continue,
            };
            if not self.bal.contains_key(p.account) {
                self.bal.insert(p.account.clone(), SortedMap.new());
            }
            add(mut self.bal[p.account], a.comm, a.qty);
            self.entries.push(Posted { date: d.date.clone(), payee: t.payee.clone(), account: p.account.clone(), comm: a.comm.clone(), qty: a.qty });
        }
        let mut t = t.clone();
        t.postings = out;
        self.accepted.push(Directive { date: d.date.clone(), file: d.file.clone(), fidx: d.fidx, line: d.line, body: Body.Txn(t) });
        Ok(())
    }
}

// ------------------------------------------------------------ writing back

fn show_amount(a: Amount, prec: i64) -> String {
    f"{fmt_num(a.qty, prec)} {a.comm}"
}

fn canonical(d: Directive, l: Ledger) -> Vec[String] {
    match d.body {
        Body.Open(acc, comms) => {
            if comms.is_empty() {
                vec![f"{d.date} open {acc}"]
            } else {
                vec![f"{d.date} open {acc} {comms.join(",")}"]
            }
        }
        Body.Close(acc) => vec![f"{d.date} close {acc}"],
        Body.Balance(acc, a) => vec![f"{d.date} balance {acc} {show_amount(a, l.p(a.comm))}"],
        Body.PriceOf(comm, a) => vec![f"{d.date} price {comm} {show_amount(a, a.scale)}"],
        Body.Txn(t) => {
            let mut out: Vec[String] = Vec.new();
            if t.narration.len() > 0 {
                out.push(f"{d.date} {t.flag} {t.payee} | {t.narration}");
            } else {
                out.push(f"{d.date} {t.flag} {t.payee}");
            }
            for p in t.postings.iter() {
                let a = match p.amount {
                    Some(a) => a,
                    None => continue,
                };
                let mut s = f"  {p.account}  {show_amount(a, l.p(a.comm))}";
                match p.cost {
                    Cost.AnyLot => s.push_str(" {}"),
                    Cost.At(c) => s.push_str(f" {{{show_amount(c, c.scale)}}}"),
                    Cost.NoCost => {}
                }
                match p.price {
                    Price.Unit(pa) => s.push_str(f" @ {show_amount(pa, pa.scale)}"),
                    Price.Total(pa) => s.push_str(f" @@ {show_amount(pa, pa.scale)}"),
                    Price.NoPrice => {}
                }
                out.push(s);
            }
            out.push("".to_string());
            out
        }
    }
}

// ------------------------------------------------------------ reports

// (account, comm) -> qty over the entries in the period under the roots.
type Totals = SortedMap[String, SortedMap[String, i64]];

fn totals(l: Ledger, from: Option[String], to: Option[String], roots: Vec[String]) -> Totals {
    let mut t: Totals = SortedMap.new();
    for e in l.entries.iter() {
        if let Some(f) = from {
            if e.date < f {
                continue;
            }
        }
        if let Some(x) = to {
            if e.date > x {
                continue;
            }
        }
        if not roots.iter().any(|r| under(e.account, r)) {
            continue;
        }
        if not t.contains_key(e.account) {
            t.insert(e.account.clone(), SortedMap.new());
        }
        add(mut t[e.account], e.comm, e.qty);
    }
    t
}

fn nonzero(l: Ledger, m: SortedMap[String, i64]) -> SortedMap[String, i64] {
    let mut out: SortedMap[String, i64] = SortedMap.new();
    for (c, v) in m.iter() {
        if round_to(v, l.p(c)) != 0 {
            out.insert(c.clone(), v);
        }
    }
    out
}

fn sum_under(t: Totals, node: Str) -> SortedMap[String, i64] {
    let mut sums: SortedMap[String, i64] = SortedMap.new();
    for (a, m) in t.iter() {
        if under(a, node) {
            for (c, v) in m.iter() {
                add(mut sums, c, v);
            }
        }
    }
    sums
}

fn sum_all(t: Totals) -> SortedMap[String, i64] {
    let mut sums: SortedMap[String, i64] = SortedMap.new();
    for (_, m) in t.iter() {
        for (c, v) in m.iter() {
            add(mut sums, c, v);
        }
    }
    sums
}

struct TreeRow {
    name: String,
    level: i64,
    amounts: SortedMap[String, i64],
}

fn segments(s: Str) -> i64 {
    s.split(":").count()
}

fn tree_rows(l: Ledger, roots: Vec[String], t: Totals, depth: Option[i64]) -> Vec[TreeRow] {
    let mut names: Set[String] = Set.new();
    for acc in l.ever.iter().chain(l.bal.keys()) {
        let parts: Vec[Str] = acc.split(":").collect();
        for i in 1..parts.len() + 1 {
            names.insert(parts[0..i].join(":"));
        }
    }
    let mut rows: Vec[TreeRow] = Vec.new();
    for root in roots.iter() {
        let mut sub: Vec[String] = names.iter().filter(|n| under(n, root)).cloned().collect();
        sub.sort_by_key(|n| tree_key(n));
        let base = segments(root);
        for n in sub.iter() {
            let seg = segments(n);
            if let Some(d) = depth {
                if seg > d {
                    continue;
                }
            }
            let amounts = nonzero(l, sum_under(t, n));
            if not amounts.is_empty() {
                rows.push(TreeRow { name: n.clone(), level: seg - base, amounts: amounts });
            }
        }
    }
    rows
}

fn print_tree(l: Ledger, out: mut ref Vec[String], rows: Vec[TreeRow]) {
    for r in rows.iter() {
        let last = r.name.rsplit_once(":").map(|(_, x)| x.to_string()) ?? r.name.clone();
        let mut first = true;
        for (c, v) in r.amounts.iter() {
            let a = rjust(l.amt(v, c), 20);
            if first {
                let mut indent = String.new();
                for _ in 0..r.level {
                    indent.push_str("  ");
                }
                out.push(f"{a}  {indent}{last}");
            } else {
                out.push(a);
            }
            first = false;
        }
    }
}

fn price_of(l: Ledger, comm: Str, target: Str, at: Str) -> (Option[i64], Option[i64]) {
    let mut direct: Option[i64] = None;
    let mut inverse: Option[i64] = None;
    for p in l.prices.iter() {
        if p.date > at {
            continue;
        }
        if p.comm == comm and p.target == target {
            direct = Some(p.value);
        } else if p.comm == target and p.target == comm {
            inverse = Some(p.value);
        }
    }
    (direct, inverse)
}

fn check_period(pos: Vec[String]) -> Result[(String, String), String] {
    for x in pos.iter() {
        if not valid_date(x) {
            return Err(f"bad date \"{x}\"");
        }
    }
    if pos[1] < pos[0] {
        return Err("the period ends before it starts".to_string());
    }
    Ok((pos[0].clone(), pos[1].clone()))
}

fn report(l: Ledger, line: Str, out: mut ref Vec[String]) -> Result[(), String] {
    let toks: Vec[Str] = line.split_whitespace().collect();
    let cmd = toks[0];
    let mut opts: Map[String, String] = Map.new();
    let mut pos: Vec[String] = Vec.new();
    let mut i = 1;
    while i < toks.len() {
        if toks[i].starts_with("--") {
            if i + 1 >= toks.len() {
                return Err(f"{toks[i]} needs a value");
            }
            opts.insert(toks[i].substring(2), toks[i + 1].to_string());
            i += 2;
        } else {
            pos.push(toks[i].to_string());
            i += 1;
        }
    }
    for k in ["at", "from", "to"] {
        if let Some(v) = opts.get(k) {
            if not valid_date(v) {
                return Err(f"bad date \"{v}\"");
            }
        }
    }
    if cmd == "balance" {
        let mut depth: Option[i64] = None;
        if let Some(d) = opts.get("depth") {
            let n = if all_digits(d) and d.len() > 0 { i64.parse(d).unwrap_or(0) } else { 0 };
            if n == 0 {
                return Err(f"bad depth \"{d}\"");
            }
            depth = Some(n);
        }
        let roots = if pos.is_empty() {
            let mut tops: Vec[String] = Vec.new();
            for t in TYPES.iter() {
                if l.ever.iter().any(|a| under(a, t)) {
                    tops.push(t.clone());
                }
            }
            tops
        } else {
            pos.clone()
        };
        let t = totals(l, None, opts.get("at").cloned(), roots);
        print_tree(l, mut out, tree_rows(l, roots, t, depth));
        out.push("--------------------".to_string());
        let total = nonzero(l, sum_all(t));
        if total.is_empty() {
            out.push(rjust("0", 20));
        }
        for (c, v) in total.iter() {
            out.push(rjust(l.amt(v, c), 20));
        }
    } else if cmd == "register" {
        if pos.len() != 1 {
            return Err("register takes one account".to_string());
        }
        let acc = pos[0].clone();
        if not l.known(acc) {
            return Err(f"no account {acc}");
        }
        let from = opts.get("from").cloned();
        let to = opts.get("to").cloned();
        let mut run: SortedMap[String, i64] = SortedMap.new();
        for e in l.entries.iter() {
            if not under(e.account, acc) {
                continue;
            }
            if let Some(ref f) = from {
                if e.date < f {
                    continue;
                }
            }
            if let Some(ref x) = to {
                if e.date > x {
                    continue;
                }
            }
            add(mut run, e.comm, e.qty);
            let total = run.get(e.comm).cloned() ?? 0;
            out.push(f"{e.date} {cell(e.payee, 20)} {cell(e.account, 28)} {rjust(l.amt(e.qty, e.comm), 16)} {rjust(l.amt(total, e.comm), 16)}");
        }
    } else if cmd == "value" {
        if pos.len() != 1 or not valid_commodity(pos[0]) {
            return Err("value takes a commodity".to_string());
        }
        let target = pos[0].clone();
        let at = opts.get("at").cloned() ?? "9999-12-31".to_string();
        let t = totals(l, None, Some(at.clone()), vec!["Assets".to_string(), "Liabilities".to_string()]);
        let mut keys: Vec[(String, String)] = Vec.new();
        for (a, m) in t.iter() {
            for (c, _) in m.iter() {
                keys.push((a.clone(), c.clone()));
            }
        }
        keys.sort_by_key(|(a, c)| f"{tree_key(a)}\t{c}");
        let mut total = 0;
        for (acc, c) in keys.iter() {
            let q = t[acc][c];
            if round_to(q, l.p(c)) == 0 {
                continue;
            }
            let v = if c == target {
                q
            } else {
                match price_of(l, c, target, at) {
                    (Some(p), _) => mul(q, p),
                    (None, Some(p)) => rdiv(q * ONE, p),
                    (None, None) => {
                        out.push(f"{rjust(l.amt(q, c), 20)}  {acc}  (no price in {target})");
                        continue;
                    }
                }
            };
            total += v;
            if c == target {
                out.push(f"{rjust(l.amt(v, target), 20)}  {acc}");
            } else {
                out.push(f"{rjust(l.amt(v, target), 20)}  {acc}  ({l.amt(q, c)})");
            }
        }
        out.push("--------------------".to_string());
        out.push(rjust(l.amt(total, target), 20));
    } else if cmd == "income" {
        if pos.len() != 2 {
            return Err("income takes two dates".to_string());
        }
        let (from, to) = check_period(pos)?;
        let t = totals(l, Some(from), Some(to), vec!["Income".to_string(), "Expenses".to_string()]);
        print_tree(l, mut out, tree_rows(l, vec!["Income".to_string(), "Expenses".to_string()], t, None));
        out.push("--------------------".to_string());
        let mut net: SortedMap[String, i64] = SortedMap.new();
        for (c, v) in sum_all(t).iter() {
            net.insert(c.clone(), -v);
        }
        let net = nonzero(l, net);
        if net.is_empty() {
            out.push(f"{rjust("0", 20)}  net income");
        }
        for (c, v) in net.iter() {
            out.push(f"{rjust(l.amt(v, c), 20)}  net income");
        }
    } else if cmd == "lots" {
        if pos.len() != 1 {
            return Err("lots takes one account".to_string());
        }
        let acc = pos[0].clone();
        if not l.known(acc) {
            return Err(f"no account {acc}");
        }
        let mut accounts: Vec[String] = l.lots.keys().cloned().collect();
        accounts.sort_by_key(|a| tree_key(a));
        for a in accounts.iter() {
            if not under(a, acc) {
                continue;
            }
            for (c, held) in l.lots[a].iter() {
                if held.is_empty() {
                    continue;
                }
                out.push(f"{a} {c}");
                for lot in held.iter() {
                    out.push(f"  {lot.date}  {l.amt(lot.qty, c)} {{{fmt_num(lot.cost, lot.scale)} {lot.comm}}}  {l.amt(mul(lot.qty, lot.cost), lot.comm)}");
                }
            }
        }
    } else if cmd == "print" {
        if pos.len() != 2 {
            return Err("print takes two dates".to_string());
        }
        let (from, to) = check_period(pos)?;
        for d in l.accepted.iter() {
            if d.date >= from and d.date <= to {
                for s in canonical(d, l).into_iter() {
                    out.push(s);
                }
            }
        }
    } else {
        return Err(f"unknown command \"{cmd}\"");
    }
    Ok(())
}

// ------------------------------------------------------------ main

enum Loaded {
    Journal(Parsed),
    Csv(Imported),
}

fn balances(l: Ledger) -> SortedMap[String, i64] {
    let mut out: SortedMap[String, i64] = SortedMap.new();
    for (a, m) in l.bal.iter() {
        for (c, v) in m.iter() {
            if v != 0 {
                out.insert(f"{a}\t{c}", v);
            }
        }
    }
    out
}

fn read(path: Str) -> Result[String, String] {
    match fs.read_to_string(path.to_string()) {
        Ok(t) => Ok(t),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

fn run() -> Result[(), String] {
    fs.create_dir_all("data/out".to_string()).map_err(|e| f"cannot create data/out: {e}")?;
    write_data()?;
    let mut names: Vec[String] = fs.read_dir("data".to_string()).map_err(|e| f"cannot list data: {e}")?
        .into_iter()
        .filter(|n| n.ends_with(".journal") or n.ends_with(".csv"))
        .collect();
    names.sort();
    let rules_text = read("data/bank.rules")?;
    // Each input file is parsed in a task of its own.
    let group = TaskGroup.new();
    let mut handles = Vec.new();
    for (fidx, name) in names.iter().enumerate() {
        let path = f"data/{name}";
        let text = read(path)?;
        if name.ends_with(".journal") {
            handles.push(group.spawn(|| Loaded.Journal(parse_journal(path, fidx, text))));
        } else {
            let rules = parse_rules(rules_text);
            handles.push(group.spawn(|| Loaded.Csv(import_csv(path, fidx, text, rules))));
        }
    }
    let mut out: Vec[String] = vec!["== load".to_string()];
    let mut dirs: Vec[Directive] = Vec.new();
    for (name, h) in names.iter().zip(handles.into_iter()) {
        match h.join() {
            Loaded.Journal(p) => {
                out.push(f"data/{name}: {p.directives.len()} directives");
                for e in p.errors.into_iter() {
                    out.push(e);
                }
                for d in p.directives.into_iter() {
                    dirs.push(d);
                }
            }
            Loaded.Csv(c) => {
                out.push(c.summary);
                for e in c.errors.into_iter() {
                    out.push(e);
                }
                for d in c.directives.into_iter() {
                    dirs.push(d);
                }
            }
        }
    }
    let mut l = Ledger.new(dirs);
    l.run();
    out.push("== check".to_string());
    for e in l.errors.iter() {
        out.push(e.clone());
    }
    out.push(f"{l.dirs.len()} directives, {l.txns} transactions, {l.refused} refused, {l.asserts} balance assertions, {l.failed} failed");
    let mut text: Vec[String] = Vec.new();
    for d in l.accepted.iter() {
        for s in canonical(d, l).into_iter() {
            text.push(s);
        }
    }
    let body = f"{text.join("\n")}\n";
    fs.write_bytes("data/out/ledger.journal".to_string(), body.bytes().to_vec()).map_err(|e| f"cannot write data/out/ledger.journal: {e}")?;
    out.push("== write".to_string());
    out.push(f"data/out/ledger.journal: {l.accepted.len()} directives, {body.len()} bytes");
    let back = read("data/out/ledger.journal")?;
    let parsed = parse_journal("data/out/ledger.journal".to_string(), 0, back);
    let count = parsed.directives.len();
    if parsed.errors.len() > 0 {
        out.push(f"round trip: {parsed.errors.len()} parse errors");
    }
    let mut r = Ledger.new(parsed.directives);
    r.run();
    let a = balances(l);
    let b = balances(r);
    let mut keys: Vec[String] = a.keys().chain(b.keys()).cloned().collect();
    keys.sort_by_key(|k| tree_key(k));
    keys.dedup();
    let mut differs: Option[String] = None;
    for k in keys.iter() {
        if (a.get(k).cloned() ?? 0) != (b.get(k).cloned() ?? 0) {
            differs = Some(k.clone());
            break;
        }
    }
    match differs {
        Some(k) => {
            let (acc, c) = k.split_once("\t") ?? ("", "");
            out.push(f"round trip: {acc} differs in {c}");
        }
        None => out.push(f"round trip: {count} directives, {r.errors.len()} reported again, every balance matches"),
    }
    out.push("== reports".to_string());
    for raw in read("data/reports.txt")?.split("\n") {
        let line = raw.trim();
        if line.len() == 0 or line.starts_with("#") {
            continue;
        }
        out.push(f"> {line}");
        if let Err(e) = report(l, line, mut out) {
            out.push(f"error: {e}");
        }
    }
    println(out.join("\n"));
    Ok(())
}

fn is_hexd(c: u8) -> bool {
    is_digit(c) or (c >= b'a' and c <= b'f')
}

fn hex_val(c: u8) -> u8 {
    if is_digit(c) { c - b'0' } else { c - b'a' + 10 }
}

fn unhex(s: Str) -> Vec[u8] {
    let mut digits: Vec[u8] = Vec.new();
    for c in s.bytes() {
        if is_hexd(c) {
            digits.push(hex_val(c));
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < digits.len() {
        out.push(digits[i] * 16 + digits[i + 1]);
        i += 2;
    }
    out
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        eprintln(e);
    }
}

// ============================================================ data

// The files under data/, in name order.
fn write_data() -> Result[(), String] {
    put_bytes("data/2025.journal", unhex(file_0()))?;
    put_bytes("data/2026.journal", unhex(file_1()))?;
    put_bytes("data/accounts.journal", unhex(file_2()))?;
    put_bytes("data/bank.csv", unhex(file_3()))?;
    put_bytes("data/bank.rules", unhex(file_4()))?;
    put_bytes("data/prices.journal", unhex(file_5()))?;
    put_bytes("data/reports.txt", unhex(file_6()))?;
    put_bytes("data/zz_broken.journal", unhex(file_7()))?;
    Ok(())
}

