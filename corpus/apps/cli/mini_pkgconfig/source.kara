// ------------------------------------------------------------ the run

fn write_data() -> Result[(), String] {
    let files = data_files();
    for i in 0..files.len() {
        let (name, text) = files[i].clone();
        let path = f"data/{name}";
        let dir = parent_dir(path);
        if let Err(e) = fs.create_dir_all(dir.clone()) {
            return Err(f"cannot create {dir}: {e}");
        }
        if let Err(e) = fs.write(path.clone(), text) {
            return Err(f"cannot write {path}: {e}");
        }
    }
    Ok(())
}

fn is_env_assignment(a: Str) -> bool {
    let b = a.bytes();
    let mut i: i64 = 0;
    while i < b.len() and ((b[i] >= b'A' and b[i] <= b'Z') or b[i] == b'_') {
        i += 1;
    }
    i > 0 and i < b.len() and b[i] == b'='
}

// An argument as a shell would need it written.
fn quote(a: Str) -> String {
    let b = a.bytes();
    let mut plain = b.len() > 0;
    for i in 0..b.len() {
        let c = b[i];
        let ok = is_alnum(c) or c == b'_' or c == b'.' or c == b'/' or c == b'=' or c == b'+' or c == b':' or c == b',' or c == b'%' or c == b'@' or c == b'-';
        if not ok {
            plain = false;
        }
    }
    if plain {
        return a.to_string();
    }
    let mut out: Vec[u8] = Vec.new();
    out.push(b'\'');
    for i in 0..b.len() {
        if b[i] == b'\'' {
            push_bytes(mut out, "'\\''");
        } else {
            out.push(b[i]);
        }
    }
    out.push(b'\'');
    from_bytes(out)
}

// Prints text, marking a missing final newline.
fn show(text: Str) {
    print(text);
    if text.len() > 0 and not text.ends_with("\n") {
        println("[no newline at end]");
    }
}

fn run() -> Result[(), String] {
    write_data()?;
    let jobs = match fs.read_to_string("jobs.tsv".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read jobs.tsv: {e}"),
    };
    for line in lines_of(jobs) {
        let mut args: Vec[String] = Vec.new();
        for a in line.split("\t") {
            args.push(a.to_string());
        }
        let mut env: Vec[(String, String)] = Vec.new();
        env.push(("PKG_CONFIG_LIBDIR".to_string(), "pc".to_string()));
        let mut shown: Vec[String] = Vec.new();
        let mut first: i64 = 0;
        while first < args.len() and is_env_assignment(args[first]) {
            let a = args[first].clone();
            let k = a.find("=").unwrap_or(0);
            let name = a[..k].to_string();
            let value = a[k + 1..].to_string();
            for e in 0..env.len() {
                if env[e].0 == name {
                    env.remove(e);
                    break;
                }
            }
            env.push((name, value));
            shown.push(quote(a));
            first += 1;
        }
        shown.push("pkg-config".to_string());
        let mut argv: Vec[String] = Vec.new();
        for k in first..args.len() {
            shown.push(quote(args[k]));
            argv.push(args[k].clone());
        }
        let command = shown.join(" ");
        println(f"$ {command}");
        let res = pkg_config(env, argv);
        show(res.out);
        show(res.err);
        if res.status != 0 {
            println(f"[exit {res.status}]");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_pkgconfig: {e}");
    }
}
