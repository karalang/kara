fn file_42() -> String {
    let mut s = String.new();
    s.push_str("# A file written by hand, with the shapes pkgconf has to cope with.\n");
    s.push_str("prefix = /opt/quirks\n");
    s.push_str("libdir=${prefix}/lib\n");
    s.push_str("long_flags=-DONE=1 \\\n");
    s.push_str("    -DTWO=2\n");
    s.push_str("quoted='single quoted value'\n");
    s.push_str("literal=$prefix and ${undefined} and ${prefix}\n");
    s.push_str("\n");
    s.push_str("Name: Quirks\n");
    s.push_str("Description: Odd but legal syntax\n");
    s.push_str("Version: 1.0.0-rc.2\n");
    s.push_str("libs: -L${libdir} -lquirks -lquirks -L${libdir}\n");
    s.push_str("CFLAGS: ${long_flags} \"-DPATH=\\\"/opt/quirks dir\\\"\" -I${prefix}/include -I/usr/include\n");
    s
}

