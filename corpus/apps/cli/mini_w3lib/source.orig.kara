fn unicode_table() -> String {
    let mut out = String.new();
    unicode_table_0(mut out);
    out
}

fn pat_ent() -> String {
    "&((?P<named>[a-z0-9]+)|#(?P<dec>[0-9]+)|#x(?P<hex>[a-f0-9]+))(?P<semicolon>;?)".to_string()
}

fn pat_tag() -> String {
    "<[a-zA-Z/!][^<>=]*>|</?[a-zA-Z][a-zA-Z0-9]*(?![^ <>/])[^<>=]*(?:(?:=\\s*\"[^\"]*\"|=\\s*'[^']*'|=(?!\\s*[\"']))[^<>=]*)*>|<[a-zA-Z/!][^<>]*>".to_string()
}

fn pat_tag_extent() -> String {
    "<[a-zA-Z!/][^<>=]*(?:(?:=\\s*\"[^\"]*\"|=\\s*'[^']*'|=(?!\\s*[\"']))[^<>=]*)*(?:=\\s*[\"'][^\"'<>]*)?>?".to_string()
}

fn pat_base() -> String {
    "<base".to_string()
}

fn pat_base_scan() -> String {
    "\u{a}      <!--[^-]*(?:-(?!->)[^-]*)*(?:-->|$)\u{a}    | <(?P<t>script|noscript)\\b[^<>=]*(?:(?:=\\s*\"[^\"]*\"|=\\s*'[^']*'|=(?!\\s*[\"']))[^<>=]*)*>[^<]*(?:<(?!/(?P=t)>)[^<]*)*(?:</(?P=t)>|$)\u{a}    | <base\\s(?P<attrs>[^<>=]*(?:(?:=\\s*\"[^\"]*\"|=\\s*'[^']*'|=(?!\\s*[\"']))[^<>=]*)*)\u{a}    ".to_string()
}

fn pat_refresh() -> String {
    "\\s*(?P<int>([0-9]*\\.)?[0-9]+)\\s*;\\s*url=\\s*(?P<url>.*)".to_string()
}

fn pat_tags() -> String {
    "\u{a}      </?(?P<named>[a-zA-Z][a-zA-Z0-9]*(?![^ <>/]))\u{a}                    # a tag named the way an HTML element is, whose quoted\u{a}      [^<>=]*(?:(?:=\\s*\"[^\"]*\"|=\\s*'[^']*'|=(?!\\s*[\"']))[^<>=]*)*>  # attribute values are read whole\u{a}    |\u{a}    </?             # opening angle bracket, optional slash for a closing tag\u{a}    (?P<name>[^ <>/]+)\u{a}                    # tag name (captured): a run of non-space, non-bracket chars,\u{a}    (?![^ <>/])     # pinned to its maximal length by this lookahead so it can't\u{a}                    # overlap the run below and backtrack quadratically on an\u{a}                    # unterminated tag (a \"<\" with a long run and no \">\")\u{a}    [^<>]*          # the rest of the tag: attributes, whitespace, etc.\u{a}    >               # closing angle bracket\u{a}    ".to_string()
}

fn pat_meta() -> String {
    "<meta".to_string()
}

fn pat_meta_scan() -> String {
    "<!--[^-]*(?:-(?!->)[^-]*)*(?:-->|$)|<(?P<t>@@)\\b[^<>=]*(?:(?:=\\s*\"[^\"]*\"|=\\s*'[^']*'|=(?!\\s*[\"']))[^<>=]*)*>[^<]*(?:<(?!/(?P=t)[\\s/>])[^<]*)*(?:</(?P=t)[^<>=]*(?:(?:=\\s*\"[^\"]*\"|=\\s*'[^']*'|=(?!\\s*[\"']))[^<>=]*)*>?|$)|<meta\\s(?P<attrs>[^<>=]*(?:(?:=\\s*\"[^\"]*\"|=\\s*'[^']*'|=(?!\\s*[\"']))[^<>=]*)*)".to_string()
}

fn pat_meta_scan_none() -> String {
    "<!--[^-]*(?:-(?!->)[^-]*)*(?:-->|$)|<meta\\s(?P<attrs>[^<>=]*(?:(?:=\\s*\"[^\"]*\"|=\\s*'[^']*'|=(?!\\s*[\"']))[^<>=]*)*)".to_string()
}

fn pat_comments() -> String {
    "<!--.*?(?:-->|$)".to_string()
}

fn pat_remove_tags() -> String {
    "\u{a}        <(?P<tag>@@)(?=[\\s/>])(?:[^<>=]*(?:(?:=\\s*\"[^\"]*\"|=\\s*'[^']*'|=(?!\\s*[\"']))[^<>=]*)*>|[^<>]*>)\u{a}        .*?</(?P=tag)(?=[\\s/>])[^<>]*>\u{a}        |\u{a}        <(?P<tag2>@@)(?=[\\s/>])(?:[^<>=]*(?:(?:=\\s*\"[^\"]*\"|=\\s*'[^']*'|=(?!\\s*[\"']))[^<>=]*)*/>|[^<>]*/>)\u{a}    ".to_string()
}

fn pat_attr() -> String {
    "(?P<name>[^\\s<>/=]+)  # name\u{a}    (?:\\s*=\\s*(?:\"(?P<double>[^\"]*)\"|'(?P<single>[^']*)'|(?P<bare>[^\\s\"'>]*)))?".to_string()
}

fn pat_header_enc() -> String {
    "(?:^|;)[ \\t]*charset=(?:\"([\\w-]+)\"|([\\w-]+))(?![^\\s;,])".to_string()
}

fn pat_header_param() -> String {
    "(?:^|;)[ \\t]*(?P<name>[^\\s;=]+)=(?:\"(?P<quoted>[^\"\\\\]*(?:\\\\.[^\"\\\\]*)*)\"(?![^\\s;,])|(?P<token>[^;,\\s]*))".to_string()
}

fn pat_label() -> String {
    "[\\w-]+".to_string()
}

fn pat_body_scan() -> String {
    "\u{a}      <!--.*?(?:-->|$)  # comment\u{a}    | <\\s*meta(?=[\\s/])(?P<meta>(?:[^<>=]|=\\s*(?:\"[^\"]*\"|'[^']*')?)*)  # meta tag\u{a}    | <\\?xml\\s(?P<xml>[^<>]*)  # XML declaration\u{a}    | <\\s*(?P<body>body)  # start of the body tag\u{a}    ".to_string()
}

fn pat_pragma() -> String {
    "content[-_ ]?type".to_string()
}

fn pat_content_charset() -> String {
    "charset\\s*=\\s*[\"']?\\s*(?P<label>[\\w-]+)".to_string()
}

fn pat_title() -> String {
    "<title>(.*?)</title>".to_string()
}

fn pat_href() -> String {
    "<a\\s[^>]*?href\\s*=\\s*(?:\"([^\"]*)\"|'([^']*)'|([^\\s>]+))".to_string()
}

fn pat_img() -> String {
    "<img\\s[^>]*?src\\s*=\\s*\"([^\"]*)\\\"".to_string()
}

