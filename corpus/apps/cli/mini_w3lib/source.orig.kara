// mini_w3lib: w3lib 2.5.0, the web-scraping helpers Scrapy is built on,
// for URLs, HTML markup, page encodings and HTTP headers.
//
// w3lib.url: safe_url_string over w3lib's own WHATWG-flavoured urlsplit
// (IDNA hosts through nameprep and Punycode, IPv6 and IPvFuture hosts,
// percent-encoding in the page's codec), canonicalize_url with sorted
// queries and dot-segment removal, safe_download_url, the query helpers,
// data: URIs and file URIs. w3lib.html: entities, tag and comment
// removal, <base> and <meta refresh> discovery with the max_scan cut.
// w3lib.encoding: BOMs, Content-Type charsets, the in-body prescan and
// html_to_unicode over a codec registry, aliases and charmap tables
// taken from Python's. w3lib.http: header dicts and basic auth.
//
// The patterns run on mini_re (as in mini_soupsieve). The jobs were
// recorded from w3lib's own test suite, then a crawl walks a small shop
// site of raw HTTP responses. expected.out is oracle.py's output, which
// runs the same jobs and the same crawl through w3lib itself.

// ---------------------------------------------------------------- strings

fn cps(s: ref String) -> Vec[i64] {
    codepoints(s.bytes())
}

fn py_repr(s: ref String) -> String {
    repr_of(cps(s))
}

// str.isspace.
fn py_isspace(c: char) -> bool {
    c.is_whitespace() or (c >= '\u{1c}' and c <= '\u{1f}')
}

fn char_vec(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn from_chars(v: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut out = String.new();
    let mut i = lo;
    while i < hi {
        out.push(v[i]);
        i += 1;
    }
    out
}

fn in_chars(c: char, set: Str) -> bool {
    for x in set.chars() {
        if x == c {
            return true;
        }
    }
    false
}

// str.strip() / lstrip() / rstrip() with no argument (set "") or with the
// characters of `set`.
fn strip_by(s: ref String, set: Str, left: bool, right: bool) -> String {
    let v = char_vec(s);
    let mut a = 0;
    let mut b = v.len();
    if left {
        while a < b and (if set.is_empty() { py_isspace(v[a]) } else { in_chars(v[a], set) }) {
            a += 1;
        }
    }
    if right {
        while b > a and (if set.is_empty() { py_isspace(v[b - 1]) } else { in_chars(v[b - 1], set) }) {
            b -= 1;
        }
    }
    from_chars(v, a, b)
}

fn py_strip(s: ref String) -> String {
    strip_by(s, "", true, true)
}

fn py_rstrip(s: ref String) -> String {
    strip_by(s, "", false, true)
}

fn char_len(s: ref String) -> i64 {
    s.chars().count()
}

fn repeat(s: Str, n: i64) -> String {
    let mut out = String.new();
    let mut i = 0;
    while i < n {
        out.push_str(s);
        i += 1;
    }
    out
}

// The pieces of s.split("\n").
fn split_nl(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == '\n' {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn ascii_digits(s: ref String) -> bool {
    if s.is_empty() {
        return false;
    }
    for c in s.chars() {
        if c < '0' or c > '9' {
            return false;
        }
    }
    true
}

// int() of ASCII digits, saturating far past any value the callers clamp.
fn digits_int(s: ref String) -> i64 {
    let mut n = 0;
    for c in s.chars() {
        if n < 1000000000000 {
            n = n * 10 + (c as i64 - 48);
        }
    }
    n
}

fn has(v: ref Vec[String], s: Str) -> bool {
    for x in v.iter() {
        if x == s {
            return true;
        }
    }
    false
}

// ------------------------------------------------------------ errors

struct ReErr {
    kind: String,
    msg: String,
    pos: i64,
}

fn re_error(msg: own String, pos: i64) -> ReErr {
    ReErr { kind: "error".to_string(), msg: msg, pos: pos }
}

fn other_error(kind: Str, msg: own String) -> ReErr {
    ReErr { kind: kind.to_string(), msg: msg, pos: -1 }
}

fn err_text(e: ref ReErr) -> String {
    if e.kind == "error" {
        if e.pos >= 0 {
            return f"error: {e.msg} at position {e.pos}";
        }
        return f"error: {e.msg}";
    }
    f"{e.kind}: {e.msg}"
}

// -------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for cp in s {
        if cp < 0x80 {
            out.push(cp as u8);
        } else if cp < 0x800 {
            out.push((0xC0 | (cp >> 6)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else if cp < 0x10000 {
            out.push((0xE0 | (cp >> 12)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (cp >> 18)) as u8);
            out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

fn str_repr(s: ref Vec[i64], out: mut ref Vec[i64]) {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
}

fn repr_of(s: ref Vec[i64]) -> String {
    let mut out: Vec[i64] = Vec.new();
    str_repr(s, mut out);
    to_string(out)
}

// ----------------------------------------------------- character kinds

fn is_decimal(c: i64) -> bool {
    if c < 0x80 {
        return c >= 48 and c <= 57;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return true;
        }
    }
    false
}

fn is_space(c: i64, ascii: bool) -> bool {
    if c == 32 or (c >= 9 and c <= 13) {
        return true;
    }
    if ascii {
        return false;
    }
    (c >= 0x1C and c <= 0x1F) or c == 0x85 or c == 0xA0 or c == 0x1680 or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F or c == 0x3000
}

fn as_char(c: i64) -> Option[char] {
    if c < 0 or (c >= 0xD800 and c <= 0xDFFF) or c > 0x10FFFF {
        return None;
    }
    char.try_from(c as u32).ok()
}

fn is_word(c: i64, ascii: bool) -> bool {
    if c < 0x80 {
        return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
    }
    if ascii {
        return false;
    }
    match as_char(c) {
        Some(ch) => ch.is_alphanumeric(),
        None => false,
    }
}

fn lower(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 65 and c <= 90 { c + 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_lowercase() as u32 as i64,
        None => c,
    }
}

fn upper(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 97 and c <= 122 { c - 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_uppercase() as u32 as i64,
        None => c,
    }
}

// ------------------------------------------------------- parsed form

// The categories of \d \D \s \S \w \W.
fn cat_digit() -> i64 { 0 }
fn cat_not_digit() -> i64 { 1 }
fn cat_space() -> i64 { 2 }
fn cat_not_space() -> i64 { 3 }
fn cat_word() -> i64 { 4 }
fn cat_not_word() -> i64 { 5 }

// The positions ^ $ \A \Z \b \B and the forms the compiler turns them
// into under MULTILINE.
fn at_beginning() -> i64 { 0 }
fn at_beginning_line() -> i64 { 1 }
fn at_beginning_string() -> i64 { 2 }
fn at_end() -> i64 { 3 }
fn at_end_line() -> i64 { 4 }
fn at_end_string() -> i64 { 5 }
fn at_boundary() -> i64 { 6 }
fn at_non_boundary() -> i64 { 7 }

#[derive(Clone)]
enum Item {
    Lit(i64),
    Range(i64, i64),
    Cat(i64),
}

enum Node {
    Lit(i64),
    NotLit(i64),
    Any,
    In(Vec[Item], bool),
    At(i64),
    Branch(Vec[Vec[Node]]),
    // group (0: none), flags turned on, flags turned off, contents
    Group(i64, i64, i64, Vec[Node]),
    // 0 greedy, 1 lazy, 2 possessive; min; max; the item repeated
    Repeat(i64, i64, i64, Vec[Node]),
    Atomic(Vec[Node]),
    // direction (1 ahead, -1 behind), negative, contents
    Assert(i64, bool, Vec[Node]),
    GroupRef(i64),
    // group, yes branch, no branch
    Exists(i64, Vec[Node], Vec[Node]),
    Failure,
}

fn is_repeat(n: ref Node) -> bool {
    match n {
        Node.Repeat(_, _, _, _) => true,
        _ => false,
    }
}

fn is_at(n: ref Node) -> bool {
    match n {
        Node.At(_) => true,
        _ => false,
    }
}

fn flag_i() -> i64 { 2 }
fn flag_l() -> i64 { 4 }
fn flag_m() -> i64 { 8 }
fn flag_s() -> i64 { 16 }
fn flag_u() -> i64 { 32 }
fn flag_x() -> i64 { 64 }
fn flag_a() -> i64 { 256 }
fn type_flags() -> i64 { 4 | 32 | 256 }
fn maxrepeat() -> i64 { 4294967295 }
fn maxgroups() -> i64 { 1073741823 }
fn maxwidth() -> i64 { 1 << 62 }

fn flag_value(c: i64) -> i64 {
    match c {
        105 => 2,
        76 => 4,
        109 => 8,
        115 => 16,
        120 => 64,
        97 => 256,
        117 => 32,
        _ => 0,
    }
}

// ------------------------------------------------------------ tokens

// One token: nothing at the end of the pattern (n 0), a character (n 1),
// or a backslash and the character after it (n 2).
#[derive(Copy, Clone)]
struct T {
    n: i64,
    a: i64,
    b: i64,
}

fn tok_none() -> T {
    T { n: 0, a: 0, b: 0 }
}

fn tok_is(t: T, c: i64) -> bool {
    t.n == 1 and t.a == c
}

fn tok_text(t: T) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    if t.n >= 1 {
        v.push(t.a);
    }
    if t.n == 2 {
        v.push(t.b);
    }
    v
}

fn is_ascii_letter(c: i64) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

fn is_hex(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

fn is_oct(c: i64) -> bool {
    c >= 48 and c <= 55
}

fn is_dec(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn digits_value(s: ref Vec[i64], start: i64, base: i64) -> i64 {
    let mut v = 0;
    let mut i = start;
    while i < s.len() {
        let c = s[i];
        let d = if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 };
        v = v * base + d;
        i += 1;
    }
    v
}

// str.isidentifier, near enough: a letter or underscore, then letters,
// digits and underscores.
fn is_identifier(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    let mut i = 0;
    while i < name.len() {
        let c = name[i];
        let ok = if c == 95 {
            true
        } else if i == 0 {
            match as_char(c) {
                Some(ch) => ch.is_alphabetic(),
                None => false,
            }
        } else {
            is_word(c, false)
        };
        if not ok {
            return false;
        }
        i += 1;
    }
    true
}

fn is_ascii_decimal(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    for c in name {
        if not is_dec(c) {
            return false;
        }
    }
    true
}

struct Tokenizer {
    s: Vec[i64],
    index: i64,
    next: T,
}

impl Tokenizer {
    fn advance(mut ref self) -> Result[(), ReErr] {
        let index = self.index;
        if index >= self.s.len() {
            self.next = tok_none();
            return Ok(());
        }
        let c = self.s[index];
        if c == 92 {
            if index + 1 >= self.s.len() {
                return Err(re_error("bad escape (end of pattern)".to_string(), self.s.len() - 1));
            }
            self.next = T { n: 2, a: 92, b: self.s[index + 1] };
            self.index = index + 2;
        } else {
            self.next = T { n: 1, a: c, b: 0 };
            self.index = index + 1;
        }
        Ok(())
    }

    fn get(mut ref self) -> Result[T, ReErr] {
        let t = self.next;
        self.advance()?;
        Ok(t)
    }

    fn take(mut ref self, c: i64) -> Result[bool, ReErr] {
        if tok_is(self.next, c) {
            self.advance()?;
            return Ok(true);
        }
        Ok(false)
    }

    fn tell(ref self) -> i64 {
        self.index - self.next.n
    }

    fn seek(mut ref self, index: i64) -> Result[(), ReErr] {
        self.index = index;
        self.advance()
    }

    fn error(ref self, msg: own String, offset: i64) -> ReErr {
        re_error(msg, self.tell() - offset)
    }

    // getwhile: up to n characters of a kind (0 octal, 1 decimal, 2 hex).
    fn getwhile(mut ref self, n: i64, kind: i64, out: mut ref Vec[i64]) -> Result[(), ReErr] {
        let mut k = 0;
        while k < n {
            let t = self.next;
            if t.n != 1 {
                break;
            }
            let ok = if kind == 0 { is_oct(t.a) } else if kind == 1 { is_dec(t.a) } else { is_hex(t.a) };
            if not ok {
                break;
            }
            out.push(t.a);
            self.advance()?;
            k += 1;
        }
        Ok(())
    }

    fn getuntil(mut ref self, terminator: i64, name: Str) -> Result[Vec[i64], ReErr] {
        let mut result: Vec[i64] = Vec.new();
        loop {
            let c = self.next;
            self.advance()?;
            if c.n == 0 {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 0));
                }
                let term = to_string(vec_of(terminator));
                return Err(self.error(f"missing {term}, unterminated name", result.len()));
            }
            if tok_is(c, terminator) {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 1));
                }
                break;
            }
            push_all(mut result, tok_text(c));
        }
        Ok(result)
    }

    fn checkgroupname(ref self, name: ref Vec[i64], offset: i64) -> Result[(), ReErr] {
        if not is_identifier(name) {
            return Err(self.error(f"bad character in group name {repr_of(name)}", name.len() + offset));
        }
        Ok(())
    }
}

fn vec_of(c: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(c);
    v
}

fn new_tokenizer(s: ref Vec[i64]) -> Result[Tokenizer, ReErr] {
    let mut t = Tokenizer { s: s.clone(), index: 0, next: tok_none() };
    t.advance()?;
    Ok(t)
}

// ------------------------------------------------------------ parser

#[derive(Clone)]
struct Width {
    lo: i64,
    hi: i64,
}

struct ParseState {
    flags: i64,
    names: Vec[(Vec[i64], i64)],
    // per group: whether it is closed, and its width
    closed: Vec[bool],
    widths: Vec[Width],
    lookbehind_groups: i64,
    // conditional references by number, in order: (group, position)
    refpos: Vec[(i64, i64)],
}

impl ParseState {
    fn groups(ref self) -> i64 {
        self.closed.len()
    }

    fn group_of(ref self, name: ref Vec[i64]) -> i64 {
        for (n, g) in self.names.iter() {
            if same(n, name) {
                return *g;
            }
        }
        -1
    }

    fn checkgroup(ref self, gid: i64) -> bool {
        gid < self.groups() and self.closed[gid]
    }

    fn checklookbehindgroup(ref self, gid: i64, src: ref Tokenizer) -> Result[(), ReErr] {
        if self.lookbehind_groups >= 0 {
            if not self.checkgroup(gid) {
                return Err(src.error("cannot refer to an open group".to_string(), 0));
            }
            if gid >= self.lookbehind_groups {
                return Err(src.error("cannot refer to group defined in the same lookbehind subpattern".to_string(), 0));
            }
        }
        Ok(())
    }
}

fn add_width(a: i64, b: i64) -> i64 {
    if a >= maxwidth() - b { maxwidth() } else { a + b }
}

fn mul_width(a: i64, n: i64) -> i64 {
    if a == 0 or n == 0 {
        0
    } else if a >= maxwidth() / n {
        maxwidth()
    } else {
        a * n
    }
}

// SubPattern.getwidth.
fn width_of(widths: ref Vec[Width], p: ref Vec[Node]) -> Width {
    let mut lo = 0;
    let mut hi = 0;
    for n in p.iter() {
        match n {
            Node.Branch(items) => {
                let mut i = maxwidth();
                let mut j = 0;
                for item in items.iter() {
                    let w = width_of(widths, item);
                    if w.lo < i {
                        i = w.lo;
                    }
                    if w.hi > j {
                        j = w.hi;
                    }
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Atomic(body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Group(_, _, _, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Repeat(_, min, max, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, mul_width(w.lo, *min));
                if *max == maxrepeat() and w.hi > 0 {
                    hi = maxwidth();
                } else {
                    hi = add_width(hi, mul_width(w.hi, *max));
                }
            }
            Node.GroupRef(g) => {
                let w = ref widths[*g];
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Exists(_, yes, no) => {
                let wy = width_of(widths, yes);
                let mut i = wy.lo;
                let mut j = wy.hi;
                if no.len() > 0 {
                    let wn = width_of(widths, no);
                    if wn.lo < i {
                        i = wn.lo;
                    }
                    if wn.hi > j {
                        j = wn.hi;
                    }
                } else {
                    i = 0;
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Lit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.NotLit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.Any => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.In(_, _) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            _ => {}
        }
    }
    Width { lo: lo, hi: hi }
}

fn category_of(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        100 => 0,
        68 => 1,
        115 => 2,
        83 => 3,
        119 => 4,
        87 => 5,
        _ => -1,
    }
}

fn escape_value(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        97 => 7,
        98 => 8,
        102 => 12,
        110 => 10,
        114 => 13,
        116 => 9,
        118 => 11,
        92 => 92,
        _ => -1,
    }
}

// \x, \u and \U: the escape text so far, and the code point.
fn hex_escape(src: mut ref Tokenizer, t: T, esc: mut ref Vec[i64]) -> Result[i64, ReErr] {
    let n = if t.b == 120 { 2 } else if t.b == 117 { 4 } else { 8 };
    src.getwhile(n, 2, mut esc)?;
    if esc.len() != n + 2 {
        return Err(src.error(f"incomplete escape {to_string(esc)}", esc.len()));
    }
    let c = digits_value(esc, 2, 16);
    if c > 0x10FFFF {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(c)
}

// _class_escape: an escape inside [...], a literal or a category.
fn class_escape(src: mut ref Tokenizer, t: T) -> Result[Item, ReErr] {
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Item.Lit(e));
    }
    let cat = category_of(t);
    if cat >= 0 {
        return Ok(Item.Cat(cat));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Item.Lit(v));
    }
    if is_oct(c) {
        src.getwhile(2, 0, mut esc)?;
        let v = digits_value(esc, 1, 8);
        if v > 0o377 {
            return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
        }
        return Ok(Item.Lit(v));
    }
    if is_dec(c) or is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Item.Lit(c))
}

// _escape: an escape outside a set.
fn escape(src: mut ref Tokenizer, t: T, st: ref ParseState) -> Result[Node, ReErr] {
    let cat = category_of(t);
    if cat >= 0 {
        let mut items: Vec[Item] = Vec.new();
        items.push(Item.Cat(cat));
        return Ok(Node.In(items, false));
    }
    match t.b {
        65 => return Ok(Node.At(at_beginning_string())),
        98 => return Ok(Node.At(at_boundary())),
        66 => return Ok(Node.At(at_non_boundary())),
        90 => return Ok(Node.At(at_end_string())),
        _ => {}
    }
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Node.Lit(e));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Node.Lit(v));
    }
    if c == 48 {
        src.getwhile(2, 0, mut esc)?;
        return Ok(Node.Lit(digits_value(esc, 1, 8)));
    }
    if is_dec(c) {
        // an octal escape or a group reference
        let nt = src.next;
        if nt.n == 1 and is_dec(nt.a) {
            esc.push(nt.a);
            src.advance()?;
            let nt2 = src.next;
            if is_oct(esc[1]) and is_oct(esc[2]) and nt2.n == 1 and is_oct(nt2.a) {
                esc.push(nt2.a);
                src.advance()?;
                let v = digits_value(esc, 1, 8);
                if v > 0o377 {
                    return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
                }
                return Ok(Node.Lit(v));
            }
        }
        let group = digits_value(esc, 1, 10);
        if group < st.groups() {
            if not st.checkgroup(group) {
                return Err(src.error("cannot refer to an open group".to_string(), esc.len()));
            }
            st.checklookbehindgroup(group, src)?;
            return Ok(Node.GroupRef(group));
        }
        return Err(src.error(f"invalid group reference {group}", esc.len() - 1));
    }
    if is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Node.Lit(c))
}

fn parse_sub(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64) -> Result[Vec[Node], ReErr] {
    let mut items: Vec[Vec[Node]] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let first = nested == 0 and items.len() == 0;
        let item = parse_seq(mut src, mut st, verbose, nested + 1, first)?;
        items.push(item);
        if not src.take(124)? {
            break;
        }
        if nested == 0 {
            verbose = (st.flags & flag_x()) != 0;
        }
    }
    if items.len() == 1 {
        return Ok(items.pop().unwrap());
    }
    let mut out: Vec[Node] = Vec.new();
    out.push(Node.Branch(items));
    Ok(out)
}

// _parse_flags: None (as Err-free Ok(None)) for global flags, else the
// flags turned on and off.
fn parse_flags(src: mut ref Tokenizer, st: mut ref ParseState, first_char: T) -> Result[Option[(i64, i64)], ReErr] {
    let mut ch = first_char;
    let mut add = 0;
    let mut del = 0;
    if not tok_is(ch, 45) {
        loop {
            let flag = flag_value(ch.a);
            if ch.a == 76 {
                return Err(src.error("bad inline flags: cannot use 'L' flag with a str pattern".to_string(), 0));
            }
            add = add | flag;
            if (flag & type_flags()) != 0 and (add & type_flags()) != flag {
                return Err(src.error("bad inline flags: flags 'a', 'u' and 'L' are incompatible".to_string(), 0));
            }
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing -, : or )".to_string(), 0));
            }
            if tok_is(ch, 41) or tok_is(ch, 45) or tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing -, : or )" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if tok_is(ch, 41) {
        st.flags = st.flags | add;
        return Ok(None);
    }
    if tok_is(ch, 45) {
        ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("missing flag".to_string(), 0));
        }
        if ch.n != 1 or flag_value(ch.a) == 0 {
            let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing flag" };
            return Err(src.error(msg.to_string(), ch.n));
        }
        loop {
            let flag = flag_value(ch.a);
            if (flag & type_flags()) != 0 {
                return Err(src.error("bad inline flags: cannot turn off flags 'a', 'u' and 'L'".to_string(), 0));
            }
            del = del | flag;
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing :".to_string(), 0));
            }
            if tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing :" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if (add & del) != 0 {
        return Err(src.error("bad inline flags: flag turned on and off".to_string(), 1));
    }
    Ok(Some((add, del)))
}

fn is_alpha(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

fn parse_set(src: mut ref Tokenizer, out: mut ref Vec[Node]) -> Result[(), ReErr] {
    let here = src.tell() - 1;
    let mut set: Vec[Item] = Vec.new();
    let negate = src.take(94)?;
    loop {
        let this = src.get()?;
        if this.n == 0 {
            return Err(src.error("unterminated character set".to_string(), src.tell() - here));
        }
        if tok_is(this, 93) and set.len() > 0 {
            break;
        }
        let code1 = if this.n == 2 { class_escape(mut src, this)? } else { Item.Lit(this.a) };
        if src.take(45)? {
            let that = src.get()?;
            if that.n == 0 {
                return Err(src.error("unterminated character set".to_string(), src.tell() - here));
            }
            if tok_is(that, 93) {
                set.push(code1);
                set.push(Item.Lit(45));
                break;
            }
            let code2 = if that.n == 2 { class_escape(mut src, that)? } else { Item.Lit(that.a) };
            let text = f"{to_string(tok_text(this))}-{to_string(tok_text(that))}";
            let offset = this.n + 1 + that.n;
            let lo = match code1 {
                Item.Lit(c) => c,
                _ => -1,
            };
            let hi = match code2 {
                Item.Lit(c) => c,
                _ => -1,
            };
            if lo < 0 or hi < 0 or hi < lo {
                return Err(src.error(f"bad character range {text}", offset));
            }
            set.push(Item.Range(lo, hi));
        } else {
            set.push(code1);
        }
    }
    if set.len() == 1 {
        let only = ref set[0];
        if let Item.Lit(c) = only {
            if negate {
                out.push(Node.NotLit(*c));
            } else {
                out.push(Node.Lit(*c));
            }
            return Ok(());
        }
    }
    out.push(Node.In(set, negate));
    Ok(())
}

// The quantifier just read (its first character is `this`), applied to
// the last item. Returns false when `{` turned out to be a literal.
fn parse_repeat(src: mut ref Tokenizer, this: T, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let here = src.tell();
    let mut min = 0;
    let mut max = maxrepeat();
    if tok_is(this, 63) {
        max = 1;
    } else if tok_is(this, 43) {
        min = 1;
    } else if tok_is(this, 123) {
        if tok_is(src.next, 125) {
            out.push(Node.Lit(123));
            return Ok(false);
        }
        let mut lo: Vec[i64] = Vec.new();
        let mut hi: Vec[i64] = Vec.new();
        while src.next.n == 1 and is_dec(src.next.a) {
            lo.push(src.get()?.a);
        }
        if src.take(44)? {
            while src.next.n == 1 and is_dec(src.next.a) {
                hi.push(src.get()?.a);
            }
        } else {
            hi = lo.clone();
        }
        if not src.take(125)? {
            out.push(Node.Lit(123));
            src.seek(here)?;
            return Ok(false);
        }
        if lo.len() > 0 {
            if lo.len() > 10 or digits_value(lo, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            min = digits_value(lo, 0, 10);
        }
        if hi.len() > 0 {
            if hi.len() > 10 or digits_value(hi, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            max = digits_value(hi, 0, 10);
            if max < min {
                return Err(src.error("min repeat greater than max repeat".to_string(), src.tell() - here));
            }
        }
    }
    if out.len() == 0 or is_at(out[out.len() - 1]) {
        return Err(src.error("nothing to repeat".to_string(), src.tell() - here + 1));
    }
    if is_repeat(out[out.len() - 1]) {
        return Err(src.error("multiple repeat".to_string(), src.tell() - here + 1));
    }
    let last = out.pop().unwrap();
    let mut body: Vec[Node] = Vec.new();
    match last {
        Node.Group(0, 0, 0, p) => body = p,
        other => body.push(other),
    }
    let kind = if src.take(63)? { 1 } else if src.take(43)? { 2 } else { 0 };
    out.push(Node.Repeat(kind, min, max, body));
    Ok(true)
}

fn parse_seq(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64, first: bool) -> Result[Vec[Node], ReErr] {
    let mut out: Vec[Node] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let this = src.next;
        if this.n == 0 or tok_is(this, 124) or tok_is(this, 41) {
            break;
        }
        src.advance()?;
        if verbose {
            if this.n == 1 and (this.a == 32 or (this.a >= 9 and this.a <= 13)) {
                continue;
            }
            if tok_is(this, 35) {
                loop {
                    let t = src.get()?;
                    if t.n == 0 or tok_is(t, 10) {
                        break;
                    }
                }
                continue;
            }
        }
        if this.n == 2 {
            let node = escape(mut src, this, st)?;
            out.push(node);
            continue;
        }
        let c = this.a;
        if c == 91 {
            parse_set(mut src, mut out)?;
        } else if c == 42 or c == 43 or c == 63 or c == 123 {
            parse_repeat(mut src, this, mut out)?;
        } else if c == 46 {
            out.push(Node.Any);
        } else if c == 94 {
            out.push(Node.At(at_beginning()));
        } else if c == 36 {
            out.push(Node.At(at_end()));
        } else if c == 40 {
            if parse_group(mut src, mut st, mut verbose, nested, first, mut out)? {
                continue;
            }
        } else {
            out.push(Node.Lit(c));
        }
    }
    Ok(out)
}

// `(` and what follows. Returns true for a construct that adds nothing
// (a comment, global flags).
fn parse_group(src: mut ref Tokenizer, st: mut ref ParseState, verbose: mut ref bool, nested: i64, first: bool, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let start = src.tell() - 1;
    let mut capture = true;
    let mut atomic = false;
    let mut name: Vec[i64] = Vec.new();
    let mut named = false;
    let mut add = 0;
    let mut del = 0;
    if src.take(63)? {
        let ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("unexpected end of pattern".to_string(), 0));
        }
        if tok_is(ch, 80) {
            if src.take(60)? {
                name = src.getuntil(62, "group name")?;
                src.checkgroupname(name, 1)?;
                named = true;
            } else if src.take(61)? {
                let ref_name = src.getuntil(41, "group name")?;
                src.checkgroupname(ref_name, 1)?;
                let gid = st.group_of(ref_name);
                if gid < 0 {
                    return Err(src.error(f"unknown group name {repr_of(ref_name)}", ref_name.len() + 1));
                }
                if not st.checkgroup(gid) {
                    return Err(src.error("cannot refer to an open group".to_string(), ref_name.len() + 1));
                }
                st.checklookbehindgroup(gid, src)?;
                out.push(Node.GroupRef(gid));
                return Ok(true);
            } else {
                let c2 = src.get()?;
                if c2.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                return Err(src.error(f"unknown extension ?P{to_string(tok_text(c2))}", c2.n + 2));
            }
        } else if tok_is(ch, 58) {
            capture = false;
        } else if tok_is(ch, 35) {
            loop {
                if src.next.n == 0 {
                    return Err(src.error("missing ), unterminated comment".to_string(), src.tell() - start));
                }
                if tok_is(src.get()?, 41) {
                    break;
                }
            }
            return Ok(true);
        } else if tok_is(ch, 61) or tok_is(ch, 33) or tok_is(ch, 60) {
            let mut kind = ch;
            let mut dir = 1;
            let mut outer_lookbehind = 0;
            if tok_is(ch, 60) {
                kind = src.get()?;
                if kind.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                if not (tok_is(kind, 61) or tok_is(kind, 33)) {
                    return Err(src.error(f"unknown extension ?<{to_string(tok_text(kind))}", kind.n + 2));
                }
                dir = -1;
                outer_lookbehind = st.lookbehind_groups;
                if outer_lookbehind < 0 {
                    st.lookbehind_groups = st.groups();
                }
            }
            let p = parse_sub(mut src, mut st, *verbose, nested + 1)?;
            if dir < 0 and outer_lookbehind < 0 {
                st.lookbehind_groups = -1;
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            if tok_is(kind, 61) {
                out.push(Node.Assert(dir, false, p));
            } else if p.len() > 0 {
                out.push(Node.Assert(dir, true, p));
            } else {
                out.push(Node.Failure);
            }
            return Ok(true);
        } else if tok_is(ch, 40) {
            let condname = src.getuntil(41, "group name")?;
            let mut condgroup = 0;
            if not is_ascii_decimal(condname) {
                src.checkgroupname(condname, 1)?;
                condgroup = st.group_of(condname);
                if condgroup < 0 {
                    return Err(src.error(f"unknown group name {repr_of(condname)}", condname.len() + 1));
                }
            } else {
                if condname.len() > 10 {
                    return Err(src.error(f"invalid group reference {to_string(condname)}", condname.len() + 1));
                }
                condgroup = digits_value(condname, 0, 10);
                if condgroup == 0 {
                    return Err(src.error("bad group number".to_string(), condname.len() + 1));
                }
                if condgroup >= maxgroups() {
                    return Err(src.error(f"invalid group reference {condgroup}", condname.len() + 1));
                }
                let mut seen = false;
                for (g, _) in st.refpos.iter() {
                    if *g == condgroup {
                        seen = true;
                    }
                }
                if not seen {
                    st.refpos.push((condgroup, src.tell() - condname.len() - 1));
                }
            }
            st.checklookbehindgroup(condgroup, src)?;
            let yes = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
            let mut no: Vec[Node] = Vec.new();
            if src.take(124)? {
                no = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
                if tok_is(src.next, 124) {
                    return Err(src.error("conditional backref with more than two branches".to_string(), 0));
                }
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            out.push(Node.Exists(condgroup, yes, no));
            return Ok(true);
        } else if tok_is(ch, 62) {
            capture = false;
            atomic = true;
        } else if (ch.n == 1 and flag_value(ch.a) != 0) or tok_is(ch, 45) {
            match parse_flags(mut src, mut st, ch)? {
                None => {
                    if not first or out.len() > 0 {
                        return Err(src.error("global flags not at the start of the expression".to_string(), src.tell() - start));
                    }
                    *verbose = (st.flags & flag_x()) != 0;
                    return Ok(true);
                }
                Some((a, d)) => {
                    add = a;
                    del = d;
                    capture = false;
                }
            }
        } else {
            return Err(src.error(f"unknown extension ?{to_string(tok_text(ch))}", ch.n + 1));
        }
    }
    let mut group = 0;
    if capture {
        group = st.groups();
        st.closed.push(false);
        st.widths.push(Width { lo: 0, hi: 0 });
        if named {
            let was = st.group_of(name);
            if was >= 0 {
                return Err(src.error(f"redefinition of group name {repr_of(name)} as group {group}; was group {was}", name.len() + 1));
            }
            st.names.push((name.clone(), group));
        }
    }
    let sub_verbose = (*verbose or (add & flag_x()) != 0) and (del & flag_x()) == 0;
    let p = parse_sub(mut src, mut st, sub_verbose, nested + 1)?;
    if not src.take(41)? {
        return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
    }
    if group > 0 {
        let w = width_of(st.widths, p);
        st.widths[group] = w;
        st.closed[group] = true;
    }
    if atomic {
        out.push(Node.Atomic(p));
    } else {
        out.push(Node.Group(group, add, del, p));
    }
    Ok(false)
}

struct Parsed {
    nodes: Vec[Node],
    flags: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
    widths: Vec[Width],
}

fn parse(pattern: ref Vec[i64], flags: i64) -> Result[Parsed, ReErr] {
    let mut src = new_tokenizer(pattern)?;
    let mut st = ParseState {
        flags: flags,
        names: Vec.new(),
        closed: Vec.new(),
        widths: Vec.new(),
        lookbehind_groups: -1,
        refpos: Vec.new(),
    };
    // group 0 is the whole match
    st.closed.push(true);
    st.widths.push(Width { lo: 0, hi: 0 });
    let nodes = parse_sub(mut src, mut st, (flags & flag_x()) != 0, 0)?;
    if (st.flags & flag_a()) != 0 and (st.flags & flag_u()) != 0 {
        return Err(other_error("ValueError", "ASCII and UNICODE flags are incompatible".to_string()));
    }
    if src.next.n != 0 {
        return Err(src.error("unbalanced parenthesis".to_string(), 0));
    }
    for (g, pos) in st.refpos.iter() {
        if *g >= st.groups() {
            return Err(re_error(f"invalid group reference {*g}", *pos));
        }
    }
    let groups = st.groups() - 1;
    Ok(Parsed { nodes: nodes, flags: st.flags, groups: groups, names: st.names, widths: st.widths })
}

// ---------------------------------------------------------- compiler

#[derive(Clone)]
enum Op {
    // character (lowered when case-insensitive), case-insensitive, ASCII
    Lit(i64, bool, bool),
    NotLit(i64, bool, bool),
    Any,
    AnyAll,
    // set, case-insensitive, ASCII-only categories
    In(i64, bool, bool),
    // anchor kind, ASCII-only word boundary
    At(i64, bool),
    Mark(i64),
    Split(i64, i64),
    Jmp(i64),
    // repeat register, the Until it starts at
    RepInit(i64, i64),
    // register, min, max, greedy, body, exit
    Until(i64, i64, i64, bool, i64, i64),
    Ref(i64, bool, bool),
    // lookbehind width (-1 for lookahead), negative, sub-program, next
    Look(i64, bool, i64, i64),
    Atomic(i64, i64),
    Exists(i64, i64),
    Fail,
    Succeed,
    Match,
}

#[derive(Clone)]
struct Program {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
}

#[derive(Clone)]
struct CharSet {
    items: Vec[Item],
    negate: bool,
}

fn combine(flags: i64, add: i64, del: i64) -> i64 {
    let mut f = flags;
    if (add & type_flags()) != 0 {
        f = f & (0x7FFFFFFF ^ type_flags());
    }
    (f | add) & (0x7FFFFFFF ^ del)
}

struct Compiler {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
}

impl Compiler {
    fn emit(mut ref self, op: own Op) -> i64 {
        self.ops.push(op);
        self.ops.len() - 1
    }

    fn here(ref self) -> i64 {
        self.ops.len()
    }

    fn compile(mut ref self, p: ref Parsed, nodes: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let icase = (flags & flag_i()) != 0;
        let ascii = (flags & flag_a()) != 0;
        for n in nodes.iter() {
            match n {
                Node.Lit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.Lit(v, icase, ascii));
                }
                Node.NotLit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.NotLit(v, icase, ascii));
                }
                Node.Any => {
                    if (flags & flag_s()) != 0 {
                        self.emit(Op.AnyAll);
                    } else {
                        self.emit(Op.Any);
                    }
                }
                Node.In(items, negate) => {
                    self.sets.push(CharSet { items: items.clone(), negate: *negate });
                    let idx = self.sets.len() - 1;
                    self.emit(Op.In(idx, icase, ascii));
                }
                Node.At(kind) => {
                    let mut k = *kind;
                    if (flags & flag_m()) != 0 {
                        if k == at_beginning() {
                            k = at_beginning_line();
                        } else if k == at_end() {
                            k = at_end_line();
                        }
                    }
                    self.emit(Op.At(k, ascii));
                }
                Node.Branch(items) => {
                    let mut ends: Vec[i64] = Vec.new();
                    let mut i = 0;
                    while i < items.len() {
                        if i + 1 < items.len() {
                            let split = self.emit(Op.Fail);
                            self.compile(p, items[i], flags)?;
                            ends.push(self.emit(Op.Fail));
                            let next = self.here();
                            self.ops[split] = Op.Split(split + 1, next);
                        } else {
                            self.compile(p, items[i], flags)?;
                        }
                        i += 1;
                    }
                    let end = self.here();
                    for at in ends {
                        self.ops[at] = Op.Jmp(end);
                    }
                }
                Node.Group(g, add, off, body) => {
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g));
                    }
                    self.compile(p, body, combine(flags, *add, *off))?;
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g + 1));
                    }
                }
                Node.Repeat(kind, min, max, body) => {
                    if *kind == 2 {
                        let at = self.emit(Op.Fail);
                        self.compile_repeat(p, *min, *max, true, body, flags)?;
                        self.emit(Op.Succeed);
                        let next = self.here();
                        self.ops[at] = Op.Atomic(at + 1, next);
                    } else {
                        self.compile_repeat(p, *min, *max, *kind == 0, body, flags)?;
                    }
                }
                Node.Atomic(body) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Atomic(at + 1, next);
                }
                Node.Assert(dir, negative, body) => {
                    let mut width = -1;
                    if *dir < 0 {
                        let w = width_of(p.widths, body);
                        if w.lo != w.hi {
                            return Err(other_error("error", "look-behind requires fixed-width pattern".to_string()));
                        }
                        width = w.lo;
                    }
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Look(width, *negative, at + 1, next);
                }
                Node.GroupRef(g) => {
                    self.emit(Op.Ref(*g, icase, ascii));
                }
                Node.Exists(g, yes, no) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, yes, flags)?;
                    if no.len() > 0 {
                        let jump = self.emit(Op.Fail);
                        let no_pc = self.here();
                        self.compile(p, no, flags)?;
                        let end = self.here();
                        self.ops[jump] = Op.Jmp(end);
                        self.ops[at] = Op.Exists(*g, no_pc);
                    } else {
                        let end = self.here();
                        self.ops[at] = Op.Exists(*g, end);
                    }
                }
                Node.Failure => {
                    self.emit(Op.Fail);
                }
            }
        }
        Ok(())
    }

    fn compile_repeat(mut ref self, p: ref Parsed, min: i64, max: i64, greedy: bool, body: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let r = self.repeats;
        self.repeats += 1;
        let init = self.emit(Op.Fail);
        self.compile(p, body, flags)?;
        let until = self.emit(Op.Fail);
        self.ops[init] = Op.RepInit(r, until);
        self.ops[until] = Op.Until(r, min, max, greedy, init + 1, until + 1);
        Ok(())
    }
}

fn compile(pattern: ref Vec[i64], flags: i64) -> Result[Program, ReErr] {
    let p = parse(pattern, flags)?;
    let mut c = Compiler { ops: Vec.new(), sets: Vec.new(), repeats: 0 };
    c.compile(p, p.nodes, p.flags)?;
    c.emit(Op.Match);
    Ok(Program { ops: c.ops, sets: c.sets, repeats: c.repeats, groups: p.groups, names: p.names })
}

// ----------------------------------------------------------- matcher

struct Undo {
    kind: i64,
    idx: i64,
    old: i64,
}

struct Choice {
    pc: i64,
    pos: i64,
    trail: i64,
    // 0: resume at pc; 1: a lazy repeat's Until, after its tail failed
    mode: i64,
}

struct Matcher {
    s: Vec[i64],
    marks: Vec[i64],
    counts: Vec[i64],
    lasts: Vec[i64],
    lastindex: i64,
    trail: Vec[Undo],
    start: i64,
    must_advance: bool,
    match_all: bool,
}

impl Matcher {
    fn set_mark(mut ref self, slot: i64, v: i64) {
        self.trail.push(Undo { kind: 0, idx: slot, old: self.marks[slot] });
        self.marks[slot] = v;
    }

    fn set_count(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 1, idx: r, old: self.counts[r] });
        self.counts[r] = v;
    }

    fn set_last(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 2, idx: r, old: self.lasts[r] });
        self.lasts[r] = v;
    }

    fn set_lastindex(mut ref self, v: i64) {
        self.trail.push(Undo { kind: 3, idx: 0, old: self.lastindex });
        self.lastindex = v;
    }

    fn undo_to(mut ref self, len: i64) {
        while self.trail.len() > len {
            let u = self.trail.pop().unwrap();
            if u.kind == 0 {
                self.marks[u.idx] = u.old;
            } else if u.kind == 1 {
                self.counts[u.idx] = u.old;
            } else if u.kind == 2 {
                self.lasts[u.idx] = u.old;
            } else {
                self.lastindex = u.old;
            }
        }
    }

    // A group that has both marks, the end not before the start.
    fn group_span(ref self, g: i64) -> (i64, i64) {
        let a = self.marks[2 * g];
        let b = self.marks[2 * g + 1];
        if a < 0 or b < 0 or b < a {
            return (-1, -1);
        }
        (a, b)
    }

    fn at(ref self, kind: i64, ascii: bool, pos: i64) -> bool {
        let n = self.s.len();
        if kind == 0 or kind == 2 {
            return pos == 0;
        }
        if kind == 1 {
            return pos == 0 or self.s[pos - 1] == 10;
        }
        if kind == 3 {
            return pos == n or (pos == n - 1 and self.s[pos] == 10);
        }
        if kind == 4 {
            return pos == n or self.s[pos] == 10;
        }
        if kind == 5 {
            return pos == n;
        }
        if n == 0 {
            return false;
        }
        let before = pos > 0 and is_word(self.s[pos - 1], ascii);
        let after = pos < n and is_word(self.s[pos], ascii);
        if kind == 6 { before != after } else { before == after }
    }

    // Runs the program from pc at pos, backtracking through its own
    // choices only. Returns where it succeeded, or -1.
    fn run(mut ref self, prog: ref Program, pc0: i64, pos0: i64, top: bool) -> i64 {
        let base = self.trail.len();
        let mut choices: Vec[Choice] = Vec.new();
        let mut pc = pc0;
        let mut pos = pos0;
        let mut mode = 0;
        loop {
            let mut ok = true;
            let op = ref prog.ops[pc];
            if mode == 1 {
                // a lazy repeat whose tail failed: try one more item
                mode = 0;
                ok = false;
                if let Op.Until(r, _, max, _, body, _) = op {
                    let count = self.counts[*r] + 1;
                    if not ((count >= *max and *max != maxrepeat()) or pos == self.lasts[*r]) {
                        self.set_count(*r, count);
                        self.set_last(*r, pos);
                        pc = *body;
                        ok = true;
                    }
                }
                if ok {
                    continue;
                }
            } else {
                match op {
                    Op.Lit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) == *c } else { self.s[pos] == *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.NotLit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) != *c } else { self.s[pos] != *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Any => {
                        if pos < self.s.len() and self.s[pos] != 10 {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.AnyAll => {
                        if pos < self.s.len() {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.In(set, icase, ascii) => {
                        if pos < self.s.len() and in_set(prog.sets[*set], self.s[pos], *icase, *ascii) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.At(kind, ascii) => {
                        if self.at(*kind, *ascii, pos) {
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Mark(slot) => {
                        self.set_mark(*slot, pos);
                        if (*slot & 1) == 1 {
                            self.set_lastindex(*slot / 2);
                        }
                        pc += 1;
                    }
                    Op.Split(a, b) => {
                        choices.push(Choice { pc: *b, pos: pos, trail: self.trail.len(), mode: 0 });
                        pc = *a;
                    }
                    Op.Jmp(a) => pc = *a,
                    Op.RepInit(r, until) => {
                        self.set_count(*r, -1);
                        self.set_last(*r, -1);
                        pc = *until;
                    }
                    Op.Until(r, min, max, greedy, body, exit) => {
                        let count = self.counts[*r] + 1;
                        if count < *min {
                            self.set_count(*r, count);
                            pc = *body;
                        } else if *greedy {
                            if (count < *max or *max == maxrepeat()) and pos != self.lasts[*r] {
                                choices.push(Choice { pc: *exit, pos: pos, trail: self.trail.len(), mode: 0 });
                                self.set_count(*r, count);
                                self.set_last(*r, pos);
                                pc = *body;
                            } else {
                                pc = *exit;
                            }
                        } else {
                            choices.push(Choice { pc: pc, pos: pos, trail: self.trail.len(), mode: 1 });
                            pc = *exit;
                        }
                    }
                    Op.Ref(g, icase, ascii) => {
                        let (a, b) = self.group_span(*g);
                        if a < 0 {
                            ok = false;
                        } else {
                            let len = b - a;
                            if pos + len > self.s.len() {
                                ok = false;
                            } else {
                                let mut k = 0;
                                while k < len {
                                    let x = self.s[a + k];
                                    let y = self.s[pos + k];
                                    let eq = if *icase { lower(x, *ascii) == lower(y, *ascii) } else { x == y };
                                    if not eq {
                                        ok = false;
                                        break;
                                    }
                                    k += 1;
                                }
                                if ok {
                                    pos += len;
                                    pc += 1;
                                }
                            }
                        }
                    }
                    Op.Look(width, negative, sub, next) => {
                        let mark = self.trail.len();
                        let from = if *width < 0 { pos } else { pos - *width };
                        let found = from >= 0 and self.run(prog, *sub, from, false) >= 0;
                        if *negative {
                            self.undo_to(mark);
                            if found {
                                ok = false;
                            } else {
                                pc = *next;
                            }
                        } else if found {
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Atomic(sub, next) => {
                        let end = self.run(prog, *sub, pos, false);
                        if end >= 0 {
                            pos = end;
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Exists(g, no) => {
                        let (a, _) = self.group_span(*g);
                        if a >= 0 {
                            pc += 1;
                        } else {
                            pc = *no;
                        }
                    }
                    Op.Fail => ok = false,
                    Op.Succeed => return pos,
                    Op.Match => {
                        if top and ((self.match_all and pos != self.s.len()) or (self.must_advance and pos == self.start)) {
                            ok = false;
                        } else {
                            return pos;
                        }
                    }
                }
            }
            if not ok {
                match choices.pop() {
                    Some(ch) => {
                        self.undo_to(ch.trail);
                        pc = ch.pc;
                        pos = ch.pos;
                        mode = ch.mode;
                    }
                    None => {
                        self.undo_to(base);
                        return -1;
                    }
                }
            }
        }
    }
}

fn in_items(set: ref CharSet, c: i64, ascii: bool) -> bool {
    for item in set.items.iter() {
        let hit = match item {
            Item.Lit(l) => c == *l,
            Item.Range(lo, hi) => c >= *lo and c <= *hi,
            Item.Cat(k) => {
                let kind = *k;
                if kind == 0 {
                    if ascii { c >= 48 and c <= 57 } else { is_decimal(c) }
                } else if kind == 1 {
                    if ascii { not (c >= 48 and c <= 57) } else { not is_decimal(c) }
                } else if kind == 2 {
                    is_space(c, ascii)
                } else if kind == 3 {
                    not is_space(c, ascii)
                } else if kind == 4 {
                    is_word(c, ascii)
                } else {
                    not is_word(c, ascii)
                }
            }
        };
        if hit {
            return true;
        }
    }
    false
}

// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = lower(c, ascii);
        if lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program, s: ref Vec[i64]) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        s: s.clone(),
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn find(m: mut ref Matcher, prog: ref Program, from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= m.s.len() {
        let mut k = 0;
        while k < m.marks.len() {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}

// All the matches finditer gives: each search starts where the last
// match ended, and must move on past an empty one.
fn all_matches(prog: ref Program, s: ref Vec[i64], limit: i64) -> Vec[Found] {
    let mut m = new_matcher(prog, s);
    let mut out: Vec[Found] = Vec.new();
    let mut pos = 0;
    let mut must_advance = false;
    while pos <= s.len() and (limit == 0 or out.len() < limit) {
        match find(mut m, prog, pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    out
}

fn group_text(s: ref Vec[i64], span: (i64, i64), out: mut ref Vec[i64]) {
    let (a, b) = span;
    if a < 0 {
        push_ascii(mut out, "None");
    } else {
        str_repr(slice(s, a, b), mut out);
    }
}

fn span_text(span: (i64, i64)) -> String {
    let (a, b) = span;
    f"({a}, {b})"
}

fn show_match(prog: ref Program, s: ref Vec[i64], found: ref Option[Found], out: mut ref Vec[i64]) {
    let m = match found {
        Some(m) => m,
        None => {
            push_ascii(mut out, "  None\n");
            return;
        }
    };
    push_ascii(mut out, f"  span={span_text((m.start, m.end))} match=");
    str_repr(slice(s, m.start, m.end), mut out);
    out.push(10);
    if prog.groups > 0 {
        push_ascii(mut out, "  groups=(");
        let mut g = 0;
        while g < m.spans.len() {
            if g > 0 {
                push_ascii(mut out, ", ");
            }
            group_text(s, m.spans[g], mut out);
            g += 1;
        }
        if m.spans.len() == 1 {
            push_ascii(mut out, ",");
        }
        push_ascii(mut out, ")\n  spans=[");
        g = 0;
        while g < m.spans.len() {
            if g > 0 {
                push_ascii(mut out, ", ");
            }
            push_ascii(mut out, span_text(m.spans[g]));
            g += 1;
        }
        push_ascii(mut out, "]\n");
    }
    if prog.names.len() > 0 {
        push_ascii(mut out, "  named=");
        group_dict(prog, s, m, mut out);
        out.push(10);
    }
}

fn group_dict(prog: ref Program, s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    out.push(123);
    let mut k = 0;
    while k < prog.names.len() {
        if k > 0 {
            push_ascii(mut out, ", ");
        }
        let (name, g) = ref prog.names[k];
        str_repr(name, mut out);
        push_ascii(mut out, ": ");
        group_text(s, m.spans[g - 1], mut out);
        k += 1;
    }
    out.push(125);
}

// findall's item: the match, the one group, or a tuple of the groups,
// with '' for a group that did not take part.
fn findall_item(prog: ref Program, s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    if prog.groups == 0 {
        str_repr(slice(s, m.start, m.end), mut out);
        return;
    }
    if prog.groups > 1 {
        out.push(40);
    }
    let mut g = 0;
    while g < m.spans.len() {
        if g > 0 {
            push_ascii(mut out, ", ");
        }
        let (a, b) = m.spans[g];
        if a < 0 {
            push_ascii(mut out, "''");
        } else {
            str_repr(slice(s, a, b), mut out);
        }
        g += 1;
    }
    if prog.groups > 1 {
        out.push(41);
    }
}

// A replacement template: literal text and group numbers.
enum Piece {
    Text(Vec[i64]),
    Group(i64),
}

// _parser.parse_template.
fn parse_template(repl: ref Vec[i64], prog: ref Program) -> Result[Vec[Piece], ReErr] {
    let mut s = new_tokenizer(repl)?;
    let mut pieces: Vec[Piece] = Vec.new();
    let mut literal: Vec[i64] = Vec.new();
    loop {
        let this = s.get()?;
        if this.n == 0 {
            break;
        }
        if this.n == 1 {
            literal.push(this.a);
            continue;
        }
        let c = this.b;
        let mut index = -1;
        let mut offset = 0;
        if c == 103 {
            if not s.take(60)? {
                return Err(s.error("missing <".to_string(), 0));
            }
            let name = s.getuntil(62, "group name")?;
            if not is_ascii_decimal(name) {
                s.checkgroupname(name, 1)?;
                let mut found = -1;
                for (n, g) in prog.names.iter() {
                    if same(n, name) {
                        found = *g;
                    }
                }
                if found < 0 {
                    return Err(other_error("IndexError", f"unknown group name {repr_of(name)}"));
                }
                index = found;
            } else {
                if name.len() > 10 or digits_value(name, 0, 10) >= maxgroups() {
                    return Err(s.error(f"invalid group reference {to_string(name)}", name.len() + 1));
                }
                index = digits_value(name, 0, 10);
            }
            offset = name.len() + 1;
        } else if c == 48 {
            let mut text = tok_text(this);
            if s.next.n == 1 and is_oct(s.next.a) {
                text.push(s.get()?.a);
                if s.next.n == 1 and is_oct(s.next.a) {
                    text.push(s.get()?.a);
                }
            }
            literal.push(digits_value(text, 1, 8) & 0xFF);
            continue;
        } else if is_dec(c) {
            let mut text = tok_text(this);
            if s.next.n == 1 and is_dec(s.next.a) {
                text.push(s.get()?.a);
                if is_oct(c) and is_oct(text[2]) and s.next.n == 1 and is_oct(s.next.a) {
                    text.push(s.get()?.a);
                    let v = digits_value(text, 1, 8);
                    if v > 0o377 {
                        return Err(s.error(f"octal escape value {to_string(text)} outside of range 0-0o377", text.len()));
                    }
                    literal.push(v);
                    continue;
                }
            }
            index = digits_value(text, 1, 10);
            offset = text.len() - 1;
        } else {
            let e = escape_value(this);
            if e >= 0 {
                literal.push(e);
            } else if is_ascii_letter(c) {
                return Err(s.error(f"bad escape {to_string(tok_text(this))}", 2));
            } else {
                literal.push(92);
                literal.push(c);
            }
            continue;
        }
        if index > prog.groups {
            return Err(s.error(f"invalid group reference {index}", offset));
        }
        pieces.push(Piece.Text(literal));
        literal = Vec.new();
        pieces.push(Piece.Group(index));
    }
    pieces.push(Piece.Text(literal));
    Ok(pieces)
}

fn expand(pieces: ref Vec[Piece], s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    for piece in pieces.iter() {
        match piece {
            Piece.Text(t) => push_all(mut out, t),
            Piece.Group(g) => {
                let (a, b) = if *g == 0 { (m.start, m.end) } else { m.spans[*g - 1] };
                if a >= 0 {
                    push_all(mut out, slice(s, a, b));
                }
            }
        }
    }
}


// --------------------------------------------------- Unicode strings
fn cp(s: Str) -> Vec[i64] {
    codepoints(s.bytes())
}


// ---------------------------------------------------------------- errors

// A Python exception: its type name and str().
#[derive(Clone)]
struct PyErr {
    kind: String,
    msg: String,
}

fn py_err(kind: Str, msg: own String) -> PyErr {
    PyErr { kind: kind.to_string(), msg: msg }
}

fn value_error(msg: Str) -> PyErr {
    py_err("ValueError", msg.to_string())
}

// ---------------------------------------------------------------- str helpers
// Positions are byte offsets into a String unless a name says otherwise.

fn find_at(s: ref String, pat: Str, from: i64) -> i64 {
    if from > s.len() {
        return -1;
    }
    match s[from..s.len()].find(pat) {
        Some(i) => i + from,
        None => -1,
    }
}

fn rfind_in(s: ref String, pat: Str, lo: i64, hi: i64) -> i64 {
    match s[lo..hi].rfind(pat) {
        Some(i) => i + lo,
        None => -1,
    }
}

fn sub(s: ref String, a: i64, b: i64) -> String {
    s[a..b].to_string()
}

fn tail(s: ref String, a: i64) -> String {
    s[a..s.len()].to_string()
}

// str.partition(sep).
fn partition(s: ref String, sep: Str) -> (String, bool, String) {
    let i = find_at(s, sep, 0);
    if i < 0 {
        return (s.clone(), false, String.new());
    }
    (sub(s, 0, i), true, tail(s, i + sep.len()))
}

// str.rpartition(sep).
fn rpartition(s: ref String, sep: Str) -> (String, bool, String) {
    match s.rfind(sep) {
        Some(i) => (sub(s, 0, i), true, tail(s, i + sep.len())),
        None => (String.new(), false, s.clone()),
    }
}

fn is_ascii_str(s: ref String) -> bool {
    for b in s.bytes() {
        if *b >= 128 {
            return false;
        }
    }
    true
}

fn ascii_lower_str(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c >= 'A' and c <= 'Z' {
            out.push(char.try_from((c as u32) + 32).unwrap_or(c));
        } else {
            out.push(c);
        }
    }
    out
}

// str.split(sep) for a non-empty separator.
fn split_str(s: ref String, sep: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut start = 0;
    loop {
        let i = find_at(s, sep, start);
        if i < 0 {
            out.push(tail(s, start));
            return out;
        }
        out.push(sub(s, start, i));
        start = i + sep.len();
    }
}

fn join_strs(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    let mut first = true;
    for p in parts.iter() {
        if not first {
            out.push_str(sep);
        }
        first = false;
        out.push_str(p);
    }
    out
}

fn hex2(n: i64) -> String {
    let d: Vec[char] = "0123456789ABCDEF".chars().collect();
    let mut s = String.new();
    s.push(d[(n / 16) % 16]);
    s.push(d[n % 16]);
    s
}

fn hex_lower2(n: i64, width: i64) -> String {
    let d: Vec[char] = "0123456789abcdef".chars().collect();
    let mut out: Vec[char] = Vec.new();
    let mut v = n;
    while v > 0 or out.len() < width {
        out.push(d[v % 16]);
        v = v / 16;
    }
    out.reverse();
    from_chars(out, 0, out.len())
}

fn hex_value(s: Str) -> i64 {
    let mut n: i64 = 0;
    for c in s.chars() {
        let d = if c >= '0' and c <= '9' {
            c as i64 - 48
        } else if c >= 'a' and c <= 'f' {
            c as i64 - 87
        } else if c >= 'A' and c <= 'F' {
            c as i64 - 55
        } else {
            0
        };
        n = n * 16 + d;
    }
    n
}

fn char_of(cp: i64) -> char {
    char.try_from(cp as u32).unwrap_or('\u{fffd}')
}

fn str_of_cps(cs: ref Vec[i64]) -> String {
    let mut out = String.new();
    for c in cs.iter() {
        out.push(char_of(*c));
    }
    out
}

// Code point index of byte offset `b` in s.
fn cp_index(s: ref String, b: i64) -> i64 {
    s[0..b].chars().count()
}

// ---------------------------------------------------------------- bytes helpers

fn bytes_of(s: ref String) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for b in s.bytes() {
        v.push(*b);
    }
    v
}

fn bytes_lit(s: Str) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for b in s.bytes() {
        v.push(*b);
    }
    v
}

fn bslice(b: ref Vec[u8], lo: i64, hi: i64) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    let mut i = lo;
    while i < hi {
        v.push(b[i]);
        i += 1;
    }
    v
}

fn bfind(b: ref Vec[u8], pat: ref Vec[u8], from: i64) -> i64 {
    let mut i = from;
    while i + pat.len() <= b.len() {
        let mut k = 0;
        while k < pat.len() and b[i + k] == pat[k] {
            k += 1;
        }
        if k == pat.len() {
            return i;
        }
        i += 1;
    }
    -1
}

fn bfind_byte(b: ref Vec[u8], c: u8, from: i64) -> i64 {
    let mut i = from;
    while i < b.len() {
        if b[i] == c {
            return i;
        }
        i += 1;
    }
    -1
}

fn bstarts(b: ref Vec[u8], p: ref Vec[u8]) -> bool {
    if p.len() > b.len() {
        return false;
    }
    let mut i = 0;
    while i < p.len() {
        if b[i] != p[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn beq(a: ref Vec[u8], b: ref Vec[u8]) -> bool {
    a.len() == b.len() and bstarts(a, b)
}

fn bpush(out: mut ref Vec[u8], b: ref Vec[u8]) {
    for x in b.iter() {
        out.push(*x);
    }
}

fn bpush_str(out: mut ref Vec[u8], s: Str) {
    for x in s.bytes() {
        out.push(*x);
    }
}

fn blower(b: ref Vec[u8]) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for x in b.iter() {
        if *x >= 65 and *x <= 90 {
            v.push(*x + 32);
        } else {
            v.push(*x);
        }
    }
    v
}

fn is_bws(c: u8) -> bool {
    c == 32 or (c >= 9 and c <= 13)
}

// bytes.strip() with no argument.
fn bstrip(b: ref Vec[u8]) -> Vec[u8] {
    let mut lo = 0;
    let mut hi = b.len();
    while lo < hi and is_bws(b[lo]) {
        lo += 1;
    }
    while hi > lo and is_bws(b[hi - 1]) {
        hi -= 1;
    }
    bslice(b, lo, hi)
}

// Bytes as code points 0-255, for the regex engine.
fn byte_cps(b: ref Vec[u8]) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for x in b.iter() {
        v.push(*x as i64);
    }
    v
}

fn cps_bytes(c: ref Vec[i64]) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for x in c.iter() {
        v.push(*x as u8);
    }
    v
}

fn utf8_cp(out: mut ref Vec[u8], cp: i64) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push((0xC0 | (cp >> 6)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else if cp < 0x10000 {
        out.push((0xE0 | (cp >> 12)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else {
        out.push((0xF0 | (cp >> 18)) as u8);
        out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    }
}

// Valid UTF-8 bytes back to a String.
fn utf8_str(b: ref Vec[u8]) -> String {
    match String.from_utf8(b) {
        Ok(s) => s,
        Err(_) => String.new(),
    }
}

// ---------------------------------------------------------------- unicode data

struct UInfo {
    ccc: i64,
    decomp: Vec[i64],
    compat: bool,
    ccc32: i64,
    decomp32: Vec[i64],
    compat32: bool,
    printable: bool,
    b1: bool,
    prohibited: bool,
    randal: bool,
    lcat: bool,
    b2: Vec[i64],
}

struct Uni {
    index: Map[i64, i64],
    infos: Vec[UInfo],
    // Primary composites by (first << 21) | second, for Unicode 15.1 and 3.2.
    comp: Map[i64, i64],
    comp32: Map[i64, i64],
}

fn hex_list(s: Str) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for p in s.split(" ") {
        if p.len() > 0 {
            v.push(hex_value(p));
        }
    }
    v
}

fn load_uni(text: ref String) -> Uni {
    let mut u = Uni { index: Map.new(), infos: Vec.new(), comp: Map.new(), comp32: Map.new() };
    for line in text.lines() {
        if line.len() == 0 {
            continue;
        }
        let f: Vec[Str] = line.split(";").collect();
        if f[0] == "c" or f[0] == "d" {
            let key = (hex_value(f[1]) << 21) | hex_value(f[2]);
            if f[0] == "c" {
                u.comp.insert(key, hex_value(f[3]));
            } else {
                u.comp32.insert(key, hex_value(f[3]));
            }
            continue;
        }
        let compat = f[2].starts_with("k");
        let compat32 = f[4].starts_with("k");
        let d1 = if compat { hex_list(f[2][1..f[2].len()]) } else { hex_list(f[2]) };
        let d2 = if compat32 { hex_list(f[4][1..f[4].len()]) } else { hex_list(f[4]) };
        let flags = f[5];
        u.index.insert(hex_value(f[0]), u.infos.len());
        u.infos.push(UInfo {
            ccc: digits_int(f[1].to_string()),
            decomp: d1,
            compat: compat,
            ccc32: digits_int(f[3].to_string()),
            decomp32: d2,
            compat32: compat32,
            printable: flags.contains("p"),
            b1: flags.contains("b"),
            prohibited: flags.contains("x"),
            randal: flags.contains("r"),
            lcat: flags.contains("l"),
            b2: hex_list(f[6]),
        });
    }
    u
}

impl Uni {
    fn at(ref self, cp: i64) -> i64 {
        match self.index.get(cp) {
            Some(i) => *i,
            None => -1,
        }
    }

    fn printable(ref self, cp: i64) -> bool {
        let i = self.at(cp);
        if i < 0 { is_printable(cp) } else { self.infos[i].printable }
    }

    fn ccc(ref self, cp: i64, v32: bool) -> i64 {
        let i = self.at(cp);
        if i < 0 {
            0
        } else if v32 {
            self.infos[i].ccc32
        } else {
            self.infos[i].ccc
        }
    }

    fn decompose_into(ref self, cp: i64, v32: bool, out: mut ref Vec[i64]) {
        if cp >= 0xAC00 and cp < 0xAC00 + 11172 {
            let s = cp - 0xAC00;
            out.push(0x1100 + s / 588);
            out.push(0x1161 + (s % 588) / 28);
            if s % 28 != 0 {
                out.push(0x11A7 + s % 28);
            }
            return;
        }
        let i = self.at(cp);
        if i < 0 {
            out.push(cp);
            return;
        }
        let d = if v32 { self.infos[i].decomp32.clone() } else { self.infos[i].decomp.clone() };
        if d.len() == 0 {
            out.push(cp);
            return;
        }
        for x in d.iter() {
            self.decompose_into(*x, v32, mut out);
        }
    }

    fn composite(ref self, a: i64, b: i64, v32: bool) -> i64 {
        if a >= 0x1100 and a < 0x1113 and b >= 0x1161 and b < 0x1176 {
            return 0xAC00 + ((a - 0x1100) * 21 + (b - 0x1161)) * 28;
        }
        if a >= 0xAC00 and a < 0xAC00 + 11172 and (a - 0xAC00) % 28 == 0 and b > 0x11A7 and b < 0x11C3 {
            return a + (b - 0x11A7);
        }
        let key = (a << 21) | b;
        let found = if v32 { self.comp32.get(key) } else { self.comp.get(key) };
        match found {
            Some(c) => *c,
            None => -1,
        }
    }

    // unicodedata.normalize("NFKC"), with ucd_3_2_0's data when v32.
    fn nfkc(ref self, cs: ref Vec[i64], v32: bool) -> Vec[i64] {
        let mut d: Vec[i64] = Vec.new();
        for c in cs.iter() {
            self.decompose_into(*c, v32, mut d);
        }
        let mut i = 1;
        while i < d.len() {
            let mut j = i;
            while j > 0 and self.ccc(d[j], v32) != 0 and self.ccc(d[j - 1], v32) > self.ccc(d[j], v32) {
                let t = d[j];
                d[j] = d[j - 1];
                d[j - 1] = t;
                j -= 1;
            }
            i += 1;
        }
        let mut out: Vec[i64] = Vec.new();
        let mut starter: i64 = -1;
        let mut last: i64 = -1;
        for c in d.iter() {
            let cc = self.ccc(*c, v32);
            if starter >= 0 {
                let blocked = last != -1 and (last == 0 or last >= cc);
                if not blocked {
                    let comp = self.composite(out[starter], *c, v32);
                    if comp >= 0 {
                        out[starter] = comp;
                        continue;
                    }
                }
            }
            if cc == 0 {
                starter = out.len();
                last = -1;
            } else {
                last = cc;
            }
            out.push(*c);
        }
        out
    }

    fn nfkc_str(ref self, s: ref String) -> String {
        str_of_cps(self.nfkc(cps(s), false))
    }

    // repr() of a str.
    fn repr(ref self, s: ref String) -> String {
        let has_single = s.contains("'");
        let has_double = s.contains("\"");
        let q = if has_single and not has_double { '"' } else { '\'' };
        let mut out = String.new();
        out.push(q);
        for c in s.chars() {
            let x = c as i64;
            if c == q or c == '\\' {
                out.push('\\');
                out.push(c);
            } else if x == 9 {
                out.push_str("\\t");
            } else if x == 10 {
                out.push_str("\\n");
            } else if x == 13 {
                out.push_str("\\r");
            } else if x < 32 or x == 127 {
                out.push_str(f"\\x{hex_lower2(x, 2)}");
            } else if x < 128 or self.printable(x) {
                out.push(c);
            } else if x < 256 {
                out.push_str(f"\\x{hex_lower2(x, 2)}");
            } else if x < 65536 {
                out.push_str(f"\\u{hex_lower2(x, 4)}");
            } else {
                out.push_str(f"\\U{hex_lower2(x, 8)}");
            }
        }
        out.push(q);
        out
    }
}

// repr() of bytes.
fn bytes_repr(b: ref Vec[u8]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for x in b.iter() {
        if *x == 39 {
            has_single = true;
        }
        if *x == 34 {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { 34 } else { 39 };
    let mut out = String.new();
    out.push('b');
    out.push(q as char);
    for x in b.iter() {
        let c = *x;
        if c == q or c == 92 {
            out.push('\\');
            out.push(c as char);
        } else if c == 9 {
            out.push_str("\\t");
        } else if c == 10 {
            out.push_str("\\n");
        } else if c == 13 {
            out.push_str("\\r");
        } else if c < 32 or c >= 127 {
            out.push_str(f"\\x{hex_lower2(c as i64, 2)}");
        } else {
            out.push(c as char);
        }
    }
    out.push(q as char);
    out
}

fn py_bool(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

// ---------------------------------------------------------------- codecs

struct Codecs {
    aliases: Map[String, String],
    modules: Map[String, String],
    // byte -> code point, -1 where the byte is undefined
    charmaps: Map[String, Vec[i64]],
}

fn load_codecs(registry: ref String, maps: ref String) -> Codecs {
    let mut c = Codecs { aliases: Map.new(), modules: Map.new(), charmaps: Map.new() };
    for line in registry.lines() {
        let f: Vec[Str] = line.split(" ").collect();
        if f.len() != 3 {
            continue;
        }
        if f[0] == "a" {
            c.aliases.insert(f[1].to_string(), f[2].to_string());
        } else {
            c.modules.insert(f[1].to_string(), f[2].to_string());
        }
    }
    for line in maps.lines() {
        let f: Vec[Str] = line.split(" ").collect();
        if f.len() != 257 {
            continue;
        }
        let mut table: Vec[i64] = Vec.new();
        let mut i = 1;
        while i < 257 {
            table.push(if f[i] == "-" { -1 } else { hex_value(f[i]) });
            i += 1;
        }
        c.charmaps.insert(f[0].to_string(), table);
    }
    c
}

// encodings.normalize_encoding.
fn normalize_encoding(s: ref String) -> String {
    let mut out = String.new();
    let mut punct = false;
    for c in s.chars() {
        if c.is_alphanumeric() or c == '.' {
            if punct and out.len() > 0 {
                out.push('_');
            }
            if (c as u32) < 128 {
                out.push(c);
            }
            punct = false;
        } else {
            punct = true;
        }
    }
    out
}

impl Codecs {
    // codecs.lookup(label).name.
    fn lookup(ref self, label: ref String) -> Result[String, PyErr] {
        let norm = normalize_encoding(ascii_lower_str(label));
        let mut names: Vec[String] = Vec.new();
        let aliased = match self.aliases.get(norm.clone()) {
            Some(a) => Some(a.clone()),
            None => self.aliases.get(norm.replace(".", "_")).cloned(),
        };
        if let Some(a) = aliased {
            names.push(a);
        }
        names.push(norm);
        for n in names.iter() {
            if n.len() == 0 or n.contains(".") {
                continue;
            }
            if let Some(name) = self.modules.get(n.clone()) {
                return Ok(name.clone());
            }
        }
        Err(py_err("LookupError", f"unknown encoding: {label}"))
    }

    fn charmap(ref self, name: ref String) -> Vec[i64] {
        self.charmaps.get(name.clone()).cloned().unwrap_or(Vec.new())
    }

    // bytes.decode(encoding, errors), errors being strict, replace or
    // percentencode (w3lib's handler, which quotes the offending bytes).
    fn decode(ref self, data: ref Vec[u8], encoding: ref String, errors: Str) -> Result[String, PyErr] {
        let name = self.lookup(encoding)?;
        if name == "utf-8" {
            return utf8_decode(data, errors);
        }
        if name == "ascii" or name == "iso8859-1" {
            let limit: u8 = if name == "ascii" { 128 } else { 255 };
            let mut out = String.new();
            let mut i = 0;
            while i < data.len() {
                let b = data[i];
                if name == "ascii" and b >= limit {
                    if errors == "strict" {
                        return Err(decode_error("ascii", data, i, i + 1, "ordinal not in range(128)"));
                    }
                    push_bad(mut out, data, i, i + 1, errors);
                } else {
                    out.push(b as char);
                }
                i += 1;
            }
            return Ok(out);
        }
        if name.starts_with("utf-16") or name.starts_with("utf-32") {
            return utf16_32_decode(data, name, errors);
        }
        let table = self.charmap(name);
        if table.len() == 0 {
            return Err(py_err("LookupError", f"codec {name} is not ported"));
        }
        let mut out = String.new();
        let mut i = 0;
        while i < data.len() {
            let cp = table[data[i] as i64];
            if cp < 0 {
                if errors == "strict" {
                    return Err(decode_error("charmap", data, i, i + 1, "character maps to <undefined>"));
                }
                push_bad(mut out, data, i, i + 1, errors);
            } else {
                out.push(char_of(cp));
            }
            i += 1;
        }
        Ok(out)
    }

    // str.encode(encoding) (strict).
    fn encode(ref self, s: ref String, encoding: ref String) -> Result[Vec[u8], PyErr] {
        let name = self.lookup(encoding)?;
        if name == "utf-8" {
            return Ok(bytes_of(s));
        }
        let mut out: Vec[u8] = Vec.new();
        if name == "utf-16" or name == "utf-16-le" or name == "utf-16-be" {
            let be = name == "utf-16-be";
            if name == "utf-16" {
                out.push(0xFF);
                out.push(0xFE);
            }
            for c in s.chars() {
                let cp = c as i64;
                if cp >= 0x10000 {
                    let v = cp - 0x10000;
                    push_u16(mut out, 0xD800 + (v >> 10), be);
                    push_u16(mut out, 0xDC00 + (v & 0x3FF), be);
                } else {
                    push_u16(mut out, cp, be);
                }
            }
            return Ok(out);
        }
        let table = if name == "ascii" or name == "iso8859-1" { Vec.new() } else { self.charmap(name) };
        let mut pos = 0;
        for c in s.chars() {
            let cp = c as i64;
            let mut byte: i64 = -1;
            if name == "ascii" {
                if cp < 128 {
                    byte = cp;
                }
            } else if name == "iso8859-1" {
                if cp < 256 {
                    byte = cp;
                }
            } else {
                let mut b = 0;
                while b < 256 {
                    if table[b] == cp {
                        byte = b;
                        break;
                    }
                    b += 1;
                }
            }
            if byte < 0 {
                let (codec, why) = if name == "ascii" {
                    ("ascii", "ordinal not in range(128)")
                } else if name == "iso8859-1" {
                    ("latin-1", "ordinal not in range(256)")
                } else {
                    ("charmap", "character maps to <undefined>")
                };
                let shown = if cp < 256 { f"\\x{hex_lower2(cp, 2)}" } else if cp < 65536 { f"\\u{hex_lower2(cp, 4)}" } else { f"\\U{hex_lower2(cp, 8)}" };
                return Err(py_err("UnicodeEncodeError", f"'{codec}' codec can't encode character '{shown}' in position {pos}: {why}"));
            }
            out.push(byte as u8);
            pos += 1;
        }
        Ok(out)
    }
}

fn push_u16(out: mut ref Vec[u8], v: i64, be: bool) {
    if be {
        out.push((v >> 8) as u8);
        out.push((v & 0xFF) as u8);
    } else {
        out.push((v & 0xFF) as u8);
        out.push((v >> 8) as u8);
    }
}

fn decode_error(codec: Str, data: ref Vec[u8], start: i64, end: i64, why: Str) -> PyErr {
    if end - start == 1 {
        return py_err("UnicodeDecodeError", f"'{codec}' codec can't decode byte 0x{hex_lower2(data[start] as i64, 2)} in position {start}: {why}");
    }
    py_err("UnicodeDecodeError", f"'{codec}' codec can't decode bytes in position {start}-{end - 1}: {why}")
}

// What an error handler puts in place of data[start..end].
fn push_bad(out: mut ref String, data: ref Vec[u8], start: i64, end: i64, errors: Str) {
    if errors == "percentencode" {
        let mut i = start;
        while i < end {
            out.push('%');
            out.push_str(hex2(data[i] as i64));
            i += 1;
        }
    } else {
        out.push('\u{fffd}');
    }
}

fn is_cont(b: u8) -> bool {
    b >= 0x80 and b < 0xC0
}

// CPython's UTF-8 decoder: each maximal invalid subpart is one error.
fn utf8_decode(data: ref Vec[u8], errors: Str) -> Result[String, PyErr] {
    let mut out = String.new();
    let mut i = 0;
    let n = data.len();
    while i < n {
        let b = data[i];
        if b < 0x80 {
            out.push(b as char);
            i += 1;
            continue;
        }
        let mut need = 0;
        let mut lo: u8 = 0x80;
        let mut hi: u8 = 0xBF;
        if b >= 0xC2 and b <= 0xDF {
            need = 1;
        } else if b >= 0xE0 and b <= 0xEF {
            need = 2;
            if b == 0xE0 {
                lo = 0xA0;
            }
            if b == 0xED {
                hi = 0x9F;
            }
        } else if b >= 0xF0 and b <= 0xF4 {
            need = 3;
            if b == 0xF0 {
                lo = 0x90;
            }
            if b == 0xF4 {
                hi = 0x8F;
            }
        }
        if need == 0 {
            if errors == "strict" {
                return Err(decode_error("utf-8", data, i, i + 1, "invalid start byte"));
            }
            push_bad(mut out, data, i, i + 1, errors);
            i += 1;
            continue;
        }
        let mut k = 1;
        let mut bad = false;
        while k <= need {
            if i + k >= n {
                if errors == "strict" {
                    return Err(decode_error("utf-8", data, i, n, "unexpected end of data"));
                }
                push_bad(mut out, data, i, n, errors);
                return Ok(out);
            }
            let c = data[i + k];
            let ok = if k == 1 { c >= lo and c <= hi } else { is_cont(c) };
            if not ok {
                bad = true;
                break;
            }
            k += 1;
        }
        if bad {
            if errors == "strict" {
                return Err(decode_error("utf-8", data, i, i + k, "invalid continuation byte"));
            }
            push_bad(mut out, data, i, i + k, errors);
            i += k;
            continue;
        }
        let mut cp: i64 = if need == 1 { (b & 0x1F) as i64 } else if need == 2 { (b & 0x0F) as i64 } else { (b & 0x07) as i64 };
        k = 1;
        while k <= need {
            cp = (cp << 6) | ((data[i + k] & 0x3F) as i64);
            k += 1;
        }
        out.push(char_of(cp));
        i += need + 1;
    }
    Ok(out)
}

// The UTF-16 and UTF-32 decoders, with the BOM rules of the plain
// "utf-16"/"utf-32" codecs (a BOM picks the order and is dropped, little
// endian otherwise).
fn utf16_32_decode(data: ref Vec[u8], name: ref String, errors: Str) -> Result[String, PyErr] {
    let wide = name.starts_with("utf-32");
    let unit = if wide { 4 } else { 2 };
    let mut be = name.ends_with("-be");
    let mut i = 0;
    if not name.ends_with("-be") and not name.ends_with("-le") {
        if wide and data.len() >= 4 {
            if data[0] == 0xFF and data[1] == 0xFE and data[2] == 0 and data[3] == 0 {
                i = 4;
            } else if data[0] == 0 and data[1] == 0 and data[2] == 0xFE and data[3] == 0xFF {
                i = 4;
                be = true;
            }
        } else if not wide and data.len() >= 2 {
            if data[0] == 0xFF and data[1] == 0xFE {
                i = 2;
            } else if data[0] == 0xFE and data[1] == 0xFF {
                i = 2;
                be = true;
            }
        }
    }
    let codec = name.clone();
    let mut out = String.new();
    let n = data.len();
    while i < n {
        if i + unit > n {
            if errors == "strict" {
                return Err(decode_error(codec, data, i, n, "truncated data"));
            }
            push_bad(mut out, data, i, n, errors);
            break;
        }
        let mut v: i64 = 0;
        let mut k = 0;
        while k < unit {
            let byte = if be { data[i + k] } else { data[i + unit - 1 - k] };
            v = (v << 8) | (byte as i64);
            k += 1;
        }
        if wide {
            if v > 0x10FFFF or (v >= 0xD800 and v < 0xE000) {
                let why = if v > 0x10FFFF { "code point not in range(0x110000)" } else { "code point in surrogate code point range(0xd800, 0xe000)" };
                if errors == "strict" {
                    return Err(decode_error(codec, data, i, i + 4, why));
                }
                push_bad(mut out, data, i, i + 4, errors);
            } else {
                out.push(char_of(v));
            }
            i += 4;
            continue;
        }
        if v >= 0xD800 and v < 0xDC00 {
            if i + 4 > n {
                if errors == "strict" {
                    return Err(decode_error(codec, data, i, n, "unexpected end of data"));
                }
                push_bad(mut out, data, i, n, errors);
                break;
            }
            let w = if be { ((data[i + 2] as i64) << 8) | (data[i + 3] as i64) } else { ((data[i + 3] as i64) << 8) | (data[i + 2] as i64) };
            if w >= 0xDC00 and w < 0xE000 {
                out.push(char_of(0x10000 + ((v - 0xD800) << 10) + (w - 0xDC00)));
                i += 4;
                continue;
            }
            if errors == "strict" {
                return Err(decode_error(codec, data, i, i + 2, "illegal UTF-16 surrogate"));
            }
            push_bad(mut out, data, i, i + 2, errors);
            i += 2;
            continue;
        }
        if v >= 0xDC00 and v < 0xE000 {
            if errors == "strict" {
                return Err(decode_error(codec, data, i, i + 2, "illegal encoding"));
            }
            push_bad(mut out, data, i, i + 2, errors);
            i += 2;
            continue;
        }
        out.push(char_of(v));
        i += 2;
    }
    Ok(out)
}

// ---------------------------------------------------------------- job values

// A Python value from a job: the JSON form tags str, bytes, floats,
// tuples and dicts; null, booleans and ints are plain.
#[derive(Clone)]
enum V {
    None,
    Bool(bool),
    Int(i64),
    Float(f64),
    Str(String),
    Bytes(Vec[u8]),
    Tuple(Vec[V]),
    Dict(Vec[(V, V)]),
}

// Plain JSON, as read from a job line.
#[derive(Clone)]
enum J {
    Null,
    Bool(bool),
    Num(i64),
    Text(String),
    Arr(Vec[J]),
    Obj(Vec[(String, J)]),
}

struct JsonIn {
    cs: Vec[char],
    pos: i64,
}

impl JsonIn {
    fn ws(mut ref self) {
        while self.pos < self.cs.len() and (self.cs[self.pos] == ' ' or self.cs[self.pos] == '\n' or self.cs[self.pos] == '\t' or self.cs[self.pos] == '\r') {
            self.pos += 1;
        }
    }

    fn hex4(mut ref self) -> i64 {
        let mut v: i64 = 0;
        let mut k = 0;
        while k < 4 {
            let c = self.cs[self.pos];
            self.pos += 1;
            let d = if c >= '0' and c <= '9' { c as i64 - 48 } else if c >= 'a' and c <= 'f' { c as i64 - 87 } else { c as i64 - 55 };
            v = v * 16 + d;
            k += 1;
        }
        v
    }

    fn text(mut ref self) -> String {
        // at the opening quote
        self.pos += 1;
        let mut out = String.new();
        loop {
            let c = self.cs[self.pos];
            self.pos += 1;
            if c == '"' {
                return out;
            }
            if c != '\\' {
                out.push(c);
                continue;
            }
            let e = self.cs[self.pos];
            self.pos += 1;
            if e == 'n' {
                out.push('\n');
            } else if e == 't' {
                out.push('\t');
            } else if e == 'r' {
                out.push('\r');
            } else if e == 'b' {
                out.push('\u{8}');
            } else if e == 'f' {
                out.push('\u{c}');
            } else if e == 'u' {
                let mut v = self.hex4();
                if v >= 0xD800 and v < 0xDC00 and self.pos + 1 < self.cs.len() and self.cs[self.pos] == '\\' and self.cs[self.pos + 1] == 'u' {
                    self.pos += 2;
                    let w = self.hex4();
                    v = 0x10000 + ((v - 0xD800) << 10) + (w - 0xDC00);
                }
                out.push(char_of(v));
            } else {
                out.push(e);
            }
        }
    }

    fn value(mut ref self) -> J {
        self.ws();
        let c = self.cs[self.pos];
        if c == '"' {
            return J.Text(self.text());
        }
        if c == '{' {
            self.pos += 1;
            let mut items: Vec[(String, J)] = Vec.new();
            loop {
                self.ws();
                if self.cs[self.pos] == '}' {
                    self.pos += 1;
                    return J.Obj(items);
                }
                if self.cs[self.pos] == ',' {
                    self.pos += 1;
                    self.ws();
                }
                let k = self.text();
                self.ws();
                self.pos += 1;
                let v = self.value();
                items.push((k, v));
            }
        }
        if c == '[' {
            self.pos += 1;
            let mut items: Vec[J] = Vec.new();
            loop {
                self.ws();
                if self.cs[self.pos] == ']' {
                    self.pos += 1;
                    return J.Arr(items);
                }
                if self.cs[self.pos] == ',' {
                    self.pos += 1;
                }
                items.push(self.value());
            }
        }
        if c == 'n' {
            self.pos += 4;
            return J.Null;
        }
        if c == 't' {
            self.pos += 4;
            return J.Bool(true);
        }
        if c == 'f' {
            self.pos += 5;
            return J.Bool(false);
        }
        let mut neg = false;
        if c == '-' {
            neg = true;
            self.pos += 1;
        }
        let mut n: i64 = 0;
        while self.pos < self.cs.len() and self.cs[self.pos] >= '0' and self.cs[self.pos] <= '9' {
            n = n * 10 + (self.cs[self.pos] as i64 - 48);
            self.pos += 1;
        }
        J.Num(if neg { 0 - n } else { n })
    }
}

fn parse_json(line: ref String) -> J {
    let mut p = JsonIn { cs: line.chars().collect(), pos: 0 };
    p.value()
}

fn jget(j: ref J, key: Str) -> J {
    if let J.Obj(items) = j {
        for (k, v) in items.iter() {
            if k == key {
                return v.clone();
            }
        }
    }
    J.Null
}

fn unhex(s: ref String) -> Vec[u8] {
    let cs: Vec[char] = s.chars().collect();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < cs.len() {
        let mut v: i64 = 0;
        let mut k = 0;
        while k < 2 {
            let c = cs[i + k];
            let d = if c >= '0' and c <= '9' { c as i64 - 48 } else { c as i64 - 87 };
            v = v * 16 + d;
            k += 1;
        }
        out.push(v as u8);
        i += 2;
    }
    out
}

// The tagged form back to a value.
fn to_v(j: ref J) -> V {
    match j {
        J.Null => V.None,
        J.Bool(b) => V.Bool(*b),
        J.Num(n) => V.Int(*n),
        J.Text(s) => V.Str(s.clone()),
        J.Arr(_) => V.None,
        J.Obj(items) => {
            let (tag, inner) = items[0].clone();
            if tag == "s" {
                if let J.Text(s) = inner {
                    return V.Str(s);
                }
            }
            if tag == "b" {
                if let J.Text(s) = inner {
                    return V.Bytes(unhex(s));
                }
            }
            if tag == "f" {
                if let J.Text(s) = inner {
                    return V.Float(py_float(s));
                }
            }
            if tag == "l" {
                if let J.Arr(xs) = inner {
                    let mut out: Vec[V] = Vec.new();
                    for x in xs.iter() {
                        out.push(to_v(x));
                    }
                    return V.Tuple(out);
                }
            }
            if tag == "d" {
                if let J.Arr(xs) = inner {
                    let mut out: Vec[(V, V)] = Vec.new();
                    for x in xs.iter() {
                        if let J.Arr(pair) = x {
                            out.push((to_v(pair[0]), to_v(pair[1])));
                        }
                    }
                    return V.Dict(out);
                }
            }
            V.None
        }
    }
}

fn py_float(s: ref String) -> f64 {
    let t = if s.starts_with("-.") { s.replace("-.", "-0.") } else if s.starts_with(".") { f"0{s}" } else { s.clone() };
    match f64.parse(t) {
        Ok(v) => v,
        Err(_) => 0.0,
    }
}

// ---------------------------------------------------------------- ipaddress

#[derive(Clone)]
struct Addr {
    v6: bool,
    ip: u128,
    scope: String,
}

fn ascii_digit_str(s: ref String) -> bool {
    if s.len() == 0 {
        return false;
    }
    for b in s.bytes() {
        if *b < 48 or *b > 57 {
            return false;
        }
    }
    true
}

// IPv4Address(s): four decimal octets, no leading zeros.
fn parse_v4(s: ref String) -> Option[u128] {
    let parts = split_str(s, ".");
    if parts.len() != 4 {
        return None;
    }
    let mut ip: u128 = 0;
    for p in parts.iter() {
        if not ascii_digit_str(p) or p.len() > 3 or (p.len() > 1 and p.starts_with("0")) {
            return None;
        }
        let n = digits_int(p);
        if n > 255 {
            return None;
        }
        ip = (ip << 8) | (n as u128);
    }
    Some(ip)
}

fn parse_hextet(s: ref String) -> Option[u128] {
    if s.len() == 0 or s.len() > 4 {
        return None;
    }
    let mut n: u128 = 0;
    for b in s.bytes() {
        let c = *b;
        let d: u128 = if c >= 48 and c <= 57 {
            (c - 48) as u128
        } else if c >= 97 and c <= 102 {
            (c - 87) as u128
        } else if c >= 65 and c <= 70 {
            (c - 55) as u128
        } else {
            return None;
        };
        n = n * 16 + d;
    }
    Some(n)
}

// _BaseV6._ip_int_from_string.
fn parse_v6_int(s: ref String) -> Option[u128] {
    if s.len() == 0 or s.chars().count() > 45 {
        return None;
    }
    let mut parts = split_str(s, ":");
    if parts.len() < 3 {
        return None;
    }
    if parts.len() > 10 {
        return None;
    }
    let last = parts[parts.len() - 1].clone();
    if last.contains(".") {
        parts.pop();
        let v4 = parse_v4(last)?;
        parts.push(low_hex(((v4 >> 16) & 0xFFFF) as i64));
        parts.push(low_hex((v4 & 0xFFFF) as i64));
    }
    if parts.len() > 9 {
        return None;
    }
    let n = parts.len();
    let mut skip: i64 = -1;
    let mut i = 1;
    while i < n - 1 {
        if parts[i].len() == 0 {
            if skip >= 0 {
                return None;
            }
            skip = i;
        }
        i += 1;
    }
    let mut hi: i64 = 0;
    let mut lo: i64 = 0;
    let mut skipped: i64 = 0;
    if skip >= 0 {
        hi = skip;
        lo = n - skip - 1;
        if parts[0].len() == 0 {
            hi -= 1;
            if hi > 0 {
                return None;
            }
        }
        if parts[n - 1].len() == 0 {
            lo -= 1;
            if lo > 0 {
                return None;
            }
        }
        skipped = 8 - (hi + lo);
        if skipped < 1 {
            return None;
        }
    } else {
        if n != 8 or parts[0].len() == 0 or parts[n - 1].len() == 0 {
            return None;
        }
        hi = n;
    }
    let mut ip: u128 = 0;
    let mut k = 0;
    while k < hi {
        ip = (ip << 16) | parse_hextet(parts[k])?;
        k += 1;
    }
    if skipped < 8 {
        ip = ip << (16 * skipped);
    }
    k = n - lo;
    while k < n {
        ip = (ip << 16) | parse_hextet(parts[k])?;
        k += 1;
    }
    Some(ip)
}

// ipaddress.ip_address(s), or the ValueError it raises.
fn ip_address(s: ref String) -> Result[Addr, PyErr] {
    if let Some(ip) = parse_v4(s) {
        return Ok(Addr { v6: false, ip: ip, scope: String.new() });
    }
    let (a, sep, scope) = partition(s, "%");
    let ok_scope = not sep or (scope.len() > 0 and not scope.contains("%"));
    if ok_scope and not s.contains("/") {
        if let Some(ip) = parse_v6_int(a) {
            return Ok(Addr { v6: true, ip: ip, scope: scope });
        }
    }
    Err(value_error(f"{py_repr(s)} does not appear to be an IPv4 or IPv6 address"))
}

fn v4_str(ip: u128) -> String {
    f"{(ip >> 24) & 255}.{(ip >> 16) & 255}.{(ip >> 8) & 255}.{ip & 255}"
}

// _compress_hextets: the longest run of two or more zeros becomes "".
fn compress_v6(ip: u128) -> String {
    let mut h: Vec[String] = Vec.new();
    let mut k: i64 = 112;
    while k >= 0 {
        h.push(low_hex(((ip >> k) & 0xFFFF) as i64));
        k -= 16;
    }
    let mut best_start: i64 = -1;
    let mut best_len: i64 = 0;
    let mut start: i64 = -1;
    let mut len: i64 = 0;
    let mut i = 0;
    while i < h.len() {
        if h[i] == "0" {
            len += 1;
            if start == -1 {
                start = i;
            }
            if len > best_len {
                best_len = len;
                best_start = start;
            }
        } else {
            len = 0;
            start = -1;
        }
        i += 1;
    }
    if best_len > 1 {
        let end = best_start + best_len;
        let mut out: Vec[String] = Vec.new();
        if best_start == 0 {
            out.push(String.new());
        }
        i = 0;
        while i < best_start {
            out.push(h[i].clone());
            i += 1;
        }
        out.push(String.new());
        i = end;
        while i < h.len() {
            out.push(h[i].clone());
            i += 1;
        }
        if end == h.len() {
            out.push(String.new());
        }
        return join_strs(out, ":");
    }
    join_strs(h, ":")
}

// str(address).
fn addr_str(a: ref Addr) -> String {
    if not a.v6 {
        return v4_str(a.ip);
    }
    let base = if (a.ip >> 32) == 0xFFFF { f"::ffff:{v4_str(a.ip & 0xFFFFFFFF)}" } else { compress_v6(a.ip) };
    if a.scope.len() > 0 { f"{base}%{a.scope}" } else { base }
}

// ---------------------------------------------------------------- urllib.parse

fn std_uses_relative(s: ref String) -> bool {
    has(["", "ftp", "http", "gopher", "nntp", "imap", "wais", "file", "https", "shttp", "mms", "prospero", "rtsp", "rtsps", "rtspu", "sftp", "svn", "svn+ssh", "ws", "wss"], s)
}

fn std_uses_netloc(s: ref String) -> bool {
    has(["", "ftp", "http", "gopher", "nntp", "telnet", "imap", "wais", "file", "mms", "https", "shttp", "snews", "prospero", "rtsp", "rtsps", "rtspu", "rsync", "svn", "svn+ssh", "sftp", "nfs", "git", "git+ssh", "ws", "wss", "itms-services"], s)
}

fn std_uses_params(s: ref String) -> bool {
    has(["", "ftp", "hdl", "prospero", "http", "imap", "https", "shttp", "rtsp", "rtsps", "rtspu", "sip", "sips", "mms", "sftp", "tel"], s)
}

fn is_scheme_char(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '+' or c == '-' or c == '.'
}

#[derive(Clone)]
struct UrlParts {
    scheme: String,
    netloc: String,
    path: String,
    params: String,
    query: String,
    fragment: String,
}

fn parsed_repr(u: ref Uni, p: ref UrlParts) -> String {
    f"ParseResult(scheme={u.repr(p.scheme)}, netloc={u.repr(p.netloc)}, path={u.repr(p.path)}, params={u.repr(p.params)}, query={u.repr(p.query)}, fragment={u.repr(p.fragment)})"
}

// urllib.parse._checknetloc.
fn std_checknetloc(u: ref Uni, netloc: ref String) -> Result[(), PyErr] {
    if netloc.len() == 0 or is_ascii_str(netloc) {
        return Ok(());
    }
    let n = netloc.replace("@", "").replace(":", "").replace("#", "").replace("?", "");
    let n2 = u.nfkc_str(n);
    if n == n2 {
        return Ok(());
    }
    for c in "/?#@:".chars() {
        let mut t = String.new();
        t.push(c);
        if n2.contains(t) {
            return Err(value_error(f"netloc '{netloc}' contains invalid characters under NFKC normalization"));
        }
    }
    Ok(())
}

// urllib.parse.urlsplit, as five strings.
fn std_urlsplit(u: ref Uni, url_in: ref String, scheme_in: ref String) -> Result[UrlParts, PyErr] {
    let mut url = strip_by(url_in, c0_space(), true, false).replace("\t", "").replace("\r", "").replace("\n", "");
    let mut scheme = strip_by(scheme_in, c0_space(), true, true).replace("\t", "").replace("\r", "").replace("\n", "");
    let mut netloc = String.new();
    let mut query = String.new();
    let mut fragment = String.new();
    let i = find_at(url, ":", 0);
    if i > 0 {
        let first = url.chars().next().unwrap_or(' ');
        if (first as u32) < 128 and first.is_alphabetic() {
            let mut all = true;
            for c in url[0..i].chars() {
                if not is_scheme_char(c) {
                    all = false;
                    break;
                }
            }
            if all {
                scheme = ascii_lower_str(sub(url, 0, i));
                url = tail(url, i + 1);
            }
        }
    }
    if url.starts_with("//") {
        let mut delim = url.len();
        for c in "/?#".chars() {
            let mut t = String.new();
            t.push(c);
            let w = find_at(url, t, 2);
            if w >= 0 and w < delim {
                delim = w;
            }
        }
        netloc = sub(url, 2, delim);
        url = tail(url, delim);
        let open = netloc.contains("[");
        let close = netloc.contains("]");
        if open != close {
            return Err(value_error("Invalid IPv6 URL"));
        }
        if open and close {
            check_bracketed_netloc(netloc)?;
        }
    }
    if url.contains("#") {
        let (a, _, f) = partition(url, "#");
        url = a;
        fragment = f;
    }
    if url.contains("?") {
        let (a, _, q) = partition(url, "?");
        url = a;
        query = q;
    }
    std_checknetloc(u, netloc)?;
    Ok(UrlParts { scheme: scheme, netloc: netloc, path: url, params: String.new(), query: query, fragment: fragment })
}

// urllib.parse._splitparams.
fn std_splitparams(url: ref String) -> (String, String) {
    let i = if url.contains("/") {
        let last = url.rfind("/").unwrap_or(0);
        let at = find_at(url, ";", last);
        if at < 0 {
            return (url.clone(), String.new());
        }
        at
    } else {
        find_at(url, ";", 0)
    };
    (sub(url, 0, i), tail(url, i + 1))
}

fn std_urlparse(u: ref Uni, url: ref String, scheme: ref String) -> Result[UrlParts, PyErr] {
    let mut p = std_urlsplit(u, url, scheme)?;
    if std_uses_params(p.scheme) and p.path.contains(";") {
        let (a, b) = std_splitparams(p.path);
        p.path = a;
        p.params = b;
    }
    Ok(p)
}

fn std_urlunsplit(scheme: ref String, netloc: ref String, path: ref String, query: ref String, fragment: ref String) -> String {
    let mut url = path.clone();
    if netloc.len() > 0 {
        if url.len() > 0 and not url.starts_with("/") {
            url = f"/{url}";
        }
        url = f"//{netloc}{url}";
    } else if url.starts_with("//") {
        url = f"//{url}";
    } else if scheme.len() > 0 and std_uses_netloc(scheme) and (url.len() == 0 or url.starts_with("/")) {
        url = f"//{url}";
    }
    if scheme.len() > 0 {
        url = f"{scheme}:{url}";
    }
    if query.len() > 0 {
        url = f"{url}?{query}";
    }
    if fragment.len() > 0 {
        url = f"{url}#{fragment}";
    }
    url
}

fn std_urlunparse(p: ref UrlParts) -> String {
    let path = if p.params.len() > 0 { f"{p.path};{p.params}" } else { p.path.clone() };
    std_urlunsplit(p.scheme, p.netloc, path, p.query, p.fragment)
}

// urllib.parse.urljoin.
fn urljoin(u: ref Uni, base: ref String, url: ref String) -> Result[String, PyErr] {
    if base.len() == 0 {
        return Ok(url.clone());
    }
    if url.len() == 0 {
        return Ok(base.clone());
    }
    let b = std_urlparse(u, base, "".to_string())?;
    let mut p = std_urlparse(u, url, b.scheme)?;
    if p.scheme != b.scheme or not std_uses_relative(p.scheme) {
        return Ok(url.clone());
    }
    if std_uses_netloc(p.scheme) {
        if p.netloc.len() > 0 {
            return Ok(std_urlunparse(p));
        }
        p.netloc = b.netloc.clone();
    }
    if p.path.len() == 0 and p.params.len() == 0 {
        p.path = b.path.clone();
        p.params = b.params.clone();
        if p.query.len() == 0 {
            p.query = b.query.clone();
        }
        return Ok(std_urlunparse(p));
    }
    let mut base_parts = split_str(b.path, "/");
    if base_parts[base_parts.len() - 1].len() > 0 {
        base_parts.pop();
    }
    let mut segments: Vec[String] = Vec.new();
    if p.path.starts_with("/") {
        segments = split_str(p.path, "/");
    } else {
        let mut all = base_parts.clone();
        for r in split_str(p.path, "/").iter() {
            all.push(r.clone());
        }
        let mut i = 0;
        while i < all.len() {
            if i == 0 or i == all.len() - 1 or all[i].len() > 0 {
                segments.push(all[i].clone());
            }
            i += 1;
        }
    }
    let mut resolved: Vec[String] = Vec.new();
    for seg in segments.iter() {
        if seg == ".." {
            if resolved.len() > 0 {
                resolved.pop();
            }
        } else if seg != "." {
            resolved.push(seg.clone());
        }
    }
    let last = segments[segments.len() - 1].clone();
    if last == "." or last == ".." {
        resolved.push(String.new());
    }
    let joined = join_strs(resolved, "/");
    p.path = if joined.len() > 0 { joined } else { "/".to_string() };
    Ok(std_urlunparse(p))
}

// urllib.parse.quote(s, safe="/") over UTF-8.
fn std_quote(s: ref String) -> String {
    let mut out = String.new();
    for b in s.bytes() {
        let c = *b;
        let safe = (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 or c == 46 or c == 45 or c == 126 or c == 47;
        if safe {
            out.push(c as char);
        } else {
            out.push('%');
            out.push_str(hex2(c as i64));
        }
    }
    out
}

// posixpath.normpath.
fn normpath(path: ref String) -> String {
    if path.len() == 0 {
        return ".".to_string();
    }
    let mut initial = if path.starts_with("/") { 1 } else { 0 };
    if initial == 1 and path.starts_with("//") and not path.starts_with("///") {
        initial = 2;
    }
    let mut comps: Vec[String] = Vec.new();
    for comp in split_str(path, "/").iter() {
        if comp.len() == 0 or comp == "." {
            continue;
        }
        if comp != ".." or (initial == 0 and comps.len() == 0) or (comps.len() > 0 and comps[comps.len() - 1] == "..") {
            comps.push(comp.clone());
        } else if comps.len() > 0 {
            comps.pop();
        }
    }
    let mut out = String.new();
    let mut k = 0;
    while k < initial {
        out.push('/');
        k += 1;
    }
    out.push_str(join_strs(comps, "/"));
    if out.len() == 0 { ".".to_string() } else { out }
}

// ---------------------------------------------------------------- base64

fn b64_value(c: u8) -> i64 {
    if c >= 65 and c <= 90 {
        (c - 65) as i64
    } else if c >= 97 and c <= 122 {
        (c - 71) as i64
    } else if c >= 48 and c <= 57 {
        (c + 4) as i64
    } else if c == 43 {
        62
    } else if c == 47 {
        63
    } else {
        64
    }
}

// base64.b64decode(data): binascii.a2b_base64 outside strict mode.
fn b64decode(data: ref Vec[u8]) -> Result[Vec[u8], PyErr] {
    let mut out: Vec[u8] = Vec.new();
    let mut quad = 0;
    let mut left: i64 = 0;
    let mut pads = 0;
    for x in data.iter() {
        let c = *x;
        if c == 61 {
            if quad >= 2 {
                pads += 1;
                if quad + pads >= 4 {
                    return Ok(out);
                }
            }
            continue;
        }
        let v = b64_value(c);
        if v >= 64 {
            continue;
        }
        pads = 0;
        if quad == 0 {
            quad = 1;
            left = v;
        } else if quad == 1 {
            quad = 2;
            out.push((((left << 2) | (v >> 4)) & 0xFF) as u8);
            left = v & 0x0F;
        } else if quad == 2 {
            quad = 3;
            out.push((((left << 4) | (v >> 2)) & 0xFF) as u8);
            left = v & 0x03;
        } else {
            quad = 0;
            out.push((((left << 6) | v) & 0xFF) as u8);
            left = 0;
        }
    }
    if quad != 0 {
        if quad == 1 {
            let n = out.len() / 3 * 4 + 1;
            return Err(py_err("Error", f"Invalid base64-encoded string: number of data characters ({n}) cannot be 1 more than a multiple of 4"));
        }
        return Err(py_err("Error", "Incorrect padding".to_string()));
    }
    Ok(out)
}

fn b64encode(data: ref Vec[u8]) -> Vec[u8] {
    let alphabet = bytes_lit("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/");
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < data.len() {
        let b0 = data[i] as i64;
        let b1 = if i + 1 < data.len() { data[i + 1] as i64 } else { 0 };
        let b2 = if i + 2 < data.len() { data[i + 2] as i64 } else { 0 };
        out.push(alphabet[b0 >> 2]);
        out.push(alphabet[((b0 & 3) << 4) | (b1 >> 4)]);
        out.push(if i + 1 < data.len() { alphabet[((b1 & 15) << 2) | (b2 >> 6)] } else { 61 });
        out.push(if i + 2 < data.len() { alphabet[b2 & 63] } else { 61 });
        i += 3;
    }
    out
}

// ---------------------------------------------------------------- the idna codec
// Python's encodings.idna (IDNA 2003): nameprep with Unicode 3.2 data,
// then Punycode. Only success or failure matters to w3lib, which falls
// back to UTF-8 on any error.

fn nameprep(u: ref Uni, label: ref Vec[i64]) -> Option[Vec[i64]] {
    let mut mapped: Vec[i64] = Vec.new();
    for c in label.iter() {
        let i = u.at(*c);
        if i >= 0 and u.infos[i].b1 {
            continue;
        }
        if i >= 0 and u.infos[i].b2.len() > 0 {
            for x in u.infos[i].b2.iter() {
                mapped.push(*x);
            }
        } else {
            mapped.push(*c);
        }
    }
    let norm = u.nfkc(mapped, true);
    let mut any_randal = false;
    for c in norm.iter() {
        let i = u.at(*c);
        if i >= 0 and u.infos[i].prohibited {
            return None;
        }
        if i >= 0 and u.infos[i].randal {
            any_randal = true;
        }
    }
    if any_randal {
        for c in norm.iter() {
            let i = u.at(*c);
            if i >= 0 and u.infos[i].lcat {
                return None;
            }
        }
        let first = u.at(norm[0]);
        let last = u.at(norm[norm.len() - 1]);
        if first < 0 or not u.infos[first].randal or last < 0 or not u.infos[last].randal {
            return None;
        }
    }
    Some(norm)
}

fn all_ascii_cps(cs: ref Vec[i64]) -> bool {
    for c in cs.iter() {
        if *c >= 128 {
            return false;
        }
    }
    true
}

fn to_ascii(u: ref Uni, label: ref Vec[i64]) -> Option[Vec[i64]] {
    if all_ascii_cps(label) {
        if label.len() > 0 and label.len() < 64 {
            return Some(label.clone());
        }
        return None;
    }
    let prepped = nameprep(u, label)?;
    if all_ascii_cps(prepped) {
        if prepped.len() > 0 and prepped.len() < 64 {
            return Some(prepped);
        }
        return None;
    }
    if str_of_cps(prepped).to_lowercase().starts_with("xn--") {
        return None;
    }
    let mut out = cp("xn--");
    for c in punycode_encode(prepped).iter() {
        out.push(*c);
    }
    if out.len() < 64 { Some(out) } else { None }
}

fn is_idna_dot(c: i64) -> bool {
    c == 0x2E or c == 0x3002 or c == 0xFF0E or c == 0xFF61
}

// str.encode("idna") for a non-ASCII name.
fn idna_encode(u: ref Uni, s: ref String) -> Option[String] {
    let cs = cps(s);
    let mut labels: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    for c in cs.iter() {
        if is_idna_dot(*c) {
            labels.push(cur);
            cur = Vec.new();
        } else {
            cur.push(*c);
        }
    }
    labels.push(cur);
    let mut trailing = false;
    if labels.len() > 0 and labels[labels.len() - 1].len() == 0 {
        trailing = true;
        labels.pop();
    }
    let mut out = String.new();
    let mut first = true;
    for l in labels.iter() {
        if not first {
            out.push('.');
        }
        first = false;
        out.push_str(str_of_cps(to_ascii(u, l)?));
    }
    if trailing {
        out.push('.');
    }
    Some(out)
}

fn puny_t(j: i64, bias: i64) -> i64 {
    let r = 36 * (j + 1) - bias;
    if r < 1 {
        1
    } else if r > 26 {
        26
    } else {
        r
    }
}

fn puny_adapt(delta0: i64, first: bool, numchars: i64) -> i64 {
    let mut delta = if first { delta0 / 700 } else { delta0 / 2 };
    delta += delta / numchars;
    let mut divisions = 0;
    while delta > 455 {
        delta = delta / 35;
        divisions += 36;
    }
    divisions + (36 * delta / (delta + 38))
}

fn puny_digit(d: i64) -> i64 {
    if d < 26 { 97 + d } else { 48 + d - 26 }
}

// Python's punycode codec.
fn punycode_encode(text: ref Vec[i64]) -> Vec[i64] {
    let mut base: Vec[i64] = Vec.new();
    let mut extended: Vec[i64] = Vec.new();
    for c in text.iter() {
        if *c < 128 {
            base.push(*c);
        } else {
            let mut seen = false;
            for e in extended.iter() {
                if *e == *c {
                    seen = true;
                }
            }
            if not seen {
                extended.push(*c);
            }
        }
    }
    extended.sort();
    let mut deltas: Vec[i64] = Vec.new();
    let mut oldchar: i64 = 0x80;
    let mut oldindex: i64 = -1;
    for ch in extended.iter() {
        let c = *ch;
        let mut curlen: i64 = 0;
        for x in text.iter() {
            if *x < c {
                curlen += 1;
            }
        }
        let mut delta = (curlen + 1) * (c - oldchar);
        let mut index: i64 = -1;
        let mut pos: i64 = -1;
        loop {
            let mut found = false;
            loop {
                pos += 1;
                if pos == text.len() {
                    break;
                }
                let x = text[pos];
                if x == c {
                    index += 1;
                    found = true;
                    break;
                } else if x < c {
                    index += 1;
                }
            }
            if not found {
                break;
            }
            delta += index - oldindex;
            deltas.push(delta - 1);
            oldindex = index;
            delta = 0;
        }
        oldchar = c;
    }
    let mut out: Vec[i64] = Vec.new();
    let mut bias: i64 = 72;
    let mut points = 0;
    while points < deltas.len() {
        let mut n = deltas[points];
        let mut j: i64 = 0;
        loop {
            let t = puny_t(j, bias);
            if n < t {
                out.push(puny_digit(n));
                break;
            }
            out.push(puny_digit(t + (n - t) % (36 - t)));
            n = (n - t) / (36 - t);
            j += 1;
        }
        bias = puny_adapt(deltas[points], points == 0, base.len() + points + 1);
        points += 1;
    }
    if base.len() > 0 {
        let mut r = base.clone();
        r.push(45);
        for c in out.iter() {
            r.push(*c);
        }
        return r;
    }
    out
}

// ---------------------------------------------------------------- w3lib state

struct W3 {
    u: Uni,
    c: Codecs,
    ents: Map[String, i64],
    rx: Rxs,
}

fn c0_space() -> Str {
    "\u{0}\u{1}\u{2}\u{3}\u{4}\u{5}\u{6}\u{7}\u{8}\u{9}\u{a}\u{b}\u{c}\u{d}\u{e}\u{f}\u{10}\u{11}\u{12}\u{13}\u{14}\u{15}\u{16}\u{17}\u{18}\u{19}\u{1a}\u{1b}\u{1c}\u{1d}\u{1e}\u{1f} "
}

fn low_hex(n: i64) -> String {
    if n == 0 {
        return "0".to_string();
    }
    hex_lower2(n, 1)
}

// w3lib._util.to_unicode for a str or bytes argument.
fn to_unicode(w: ref W3, v: ref V, encoding: ref String, errors: Str) -> Result[String, PyErr] {
    match v {
        V.Str(s) => Ok(s.clone()),
        V.Bytes(b) => w.c.decode(b, if encoding.len() == 0 { "utf-8".to_string() } else { encoding.clone() }, errors),
        _ => Err(py_err("TypeError", "to_unicode must receive bytes or str".to_string())),
    }
}

// ---------------------------------------------------------------- w3lib._url

fn unreserved(c: u8) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 45 or c == 46 or c == 95 or c == 126
}

// The safe sets, as the bytes besides the unreserved ones.
fn userinfo_safest() -> Str {
    "!$&'()*+,"
}

fn path_safest() -> Str {
    ":/?@!$&'()*+,;=%"
}

fn special_query_safest() -> Str {
    ":/?@!$&()*+,;=%"
}

fn path_safe() -> Str {
    ":/?[]@!$&'()*+,;=|%"
}

// _quote_into / _quote.
fn quote_into(data: ref Vec[u8], out: mut ref Vec[u8], safe: Str, plus: bool) {
    let sb = safe.bytes();
    for x in data.iter() {
        let c = *x;
        let mut ok = unreserved(c);
        if not ok {
            for s in sb {
                if *s == c {
                    ok = true;
                }
            }
        }
        if ok {
            out.push(c);
        } else if plus and c == 32 {
            out.push(43);
        } else {
            out.push(37);
            bpush_str(mut out, hex2(c as i64));
        }
    }
}

fn quote(data: ref Vec[u8], safe: Str) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    quote_into(data, mut out, safe, false);
    out
}

fn nibble(c: u8) -> i64 {
    if c >= 48 and c <= 57 {
        (c - 48) as i64
    } else if c >= 65 and c <= 70 {
        (c - 55) as i64
    } else if c >= 97 and c <= 102 {
        (c - 87) as i64
    } else {
        255
    }
}

// _unquote / _unquote_plus.
fn unquote_b(data: ref Vec[u8], plus: bool) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let n = data.len();
    let mut i = 0;
    while i < n {
        let c = data[i];
        if plus and c == 43 {
            out.push(32);
            i += 1;
            continue;
        }
        if c == 37 and i + 2 < n {
            let hi = nibble(data[i + 1]);
            let lo = nibble(data[i + 2]);
            if hi != 255 and lo != 255 {
                out.push(((hi << 4) | lo) as u8);
                i += 3;
                continue;
            }
        }
        out.push(c);
        i += 1;
    }
    out
}

fn unquote_s(s: ref String) -> Vec[u8] {
    unquote_b(bytes_of(s), false)
}

// bytes.split(sep) for a non-empty separator.
fn bsplit(b: ref Vec[u8], sep: ref Vec[u8]) -> Vec[Vec[u8]] {
    let mut out: Vec[Vec[u8]] = Vec.new();
    let mut start = 0;
    loop {
        let i = bfind(b, sep, start);
        if i < 0 {
            out.push(bslice(b, start, b.len()));
            return out;
        }
        out.push(bslice(b, start, i));
        start = i + sep.len();
    }
}

// _parse_qsl, which _parse_qs groups by key.
fn parse_qsl(qs: ref Vec[u8], keep_blank: bool, sep: ref Vec[u8]) -> Vec[(Vec[u8], Vec[u8])] {
    let mut out: Vec[(Vec[u8], Vec[u8])] = Vec.new();
    if qs.len() == 0 {
        return out;
    }
    for field in bsplit(qs, sep).iter() {
        if field.len() == 0 {
            continue;
        }
        let eq = bfind_byte(field, 61, 0);
        let (key, has_sep, value) = if eq < 0 { (field.clone(), false, Vec.new()) } else { (bslice(field, 0, eq), true, bslice(field, eq + 1, field.len())) };
        if not keep_blank and (not has_sep or value.len() == 0) {
            continue;
        }
        out.push((unquote_b(key, true), unquote_b(value, true)));
    }
    out
}

fn urlencode(query: ref Vec[(Vec[u8], Vec[u8])], sep: ref Vec[u8]) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut first = true;
    for (k, v) in query.iter() {
        if not first {
            bpush(mut out, sep);
        }
        first = false;
        quote_into(k, mut out, "", true);
        out.push(61);
        quote_into(v, mut out, "", true);
    }
    out
}

fn split_params(scheme: ref String, url: ref String) -> (String, String) {
    if std_uses_params(scheme) {
        let from = match url.rfind("/") {
            Some(i) => i + 1,
            None => 0,
        };
        let semi = find_at(url, ";", from);
        if semi != -1 {
            return (sub(url, 0, semi), tail(url, semi + 1));
        }
    }
    (url.clone(), String.new())
}

fn urlunsplit(scheme: ref String, netloc: ref String, path: ref String, query: ref String, fragment: ref String) -> String {
    std_urlunsplit(scheme, netloc, path, query, fragment)
}

fn urlunparse(scheme: ref String, netloc: ref String, path: ref String, params: ref String, query: ref String, fragment: ref String) -> String {
    let p = if params.len() > 0 { f"{path};{params}" } else { path.clone() };
    urlunsplit(scheme, netloc, p, query, fragment)
}

#[derive(Clone)]
struct W3Split {
    scheme: String,
    netloc: String,
    path: String,
    query: String,
    fragment: String,
    username: Option[String],
    password: Option[String],
    hostname: Option[String],
    port: Option[i64],
}

fn is_special(scheme: ref String) -> bool {
    has(["ftp", "file", "http", "https", "ws", "wss"], scheme)
}

// _check_bracketed_host.
fn check_bracketed_host(hostname: ref String) -> Result[(), PyErr] {
    if hostname.starts_with("v") or hostname.starts_with("V") {
        // \Av[a-fA-F0-9]+\..+\Z
        let cs: Vec[char] = hostname.chars().collect();
        let mut ok = cs[0] == 'v';
        let mut i = 1;
        while ok and i < cs.len() and (cs[i].is_ascii_hexdigit()) {
            i += 1;
        }
        if i == 1 or i >= cs.len() or cs[i] != '.' or i + 1 >= cs.len() {
            ok = false;
        }
        let mut k = i + 1;
        while ok and k < cs.len() {
            if cs[k] == '\n' {
                ok = false;
            }
            k += 1;
        }
        if not ok {
            return Err(value_error("IPvFuture address is invalid"));
        }
        return Ok(());
    }
    let ip = ip_address(hostname)?;
    if not ip.v6 {
        return Err(value_error("An IPv4 address cannot be in brackets"));
    }
    Ok(())
}

// _check_bracketed_netloc.
fn check_bracketed_netloc(netloc: ref String) -> Result[(), PyErr] {
    let (_, _, host_and_port) = rpartition(netloc, "@");
    let (before, has_open, bracketed) = partition(host_and_port, "[");
    if has_open {
        if before.len() > 0 {
            return Err(value_error("Invalid IPv6 URL"));
        }
        let (host, _, port) = partition(bracketed, "]");
        if port.len() > 0 and not port.starts_with(":") {
            return Err(value_error("Invalid IPv6 URL"));
        }
        return check_bracketed_host(host);
    }
    let (host, _, _) = partition(host_and_port, ":");
    check_bracketed_host(host)
}

// _nfkc_netloc: the netloc without @ : # ?, and its NFKC form.
fn nfkc_netloc(w: ref W3, netloc: ref String) -> (String, String) {
    let cleaned = netloc.replace("@", "").replace(":", "").replace("#", "").replace("?", "");
    let normalized = w.u.nfkc_str(cleaned);
    (cleaned, normalized)
}

fn checknetloc(w: ref W3, netloc: ref String) -> Result[(), PyErr] {
    if netloc.len() == 0 or is_ascii_str(netloc) {
        return Ok(());
    }
    let (cleaned, normalized) = nfkc_netloc(w, netloc);
    if cleaned == normalized {
        return Ok(());
    }
    for c in normalized.chars() {
        if c == '/' or c == '?' or c == '#' or c == '@' or c == ':' or c == '\\' {
            return Err(value_error(f"netloc {w.u.repr(netloc)} contains invalid characters under NFKC normalization"));
        }
    }
    Ok(())
}

fn has_c0_space(s: ref String) -> bool {
    for b in s.bytes() {
        if *b <= 32 {
            return true;
        }
    }
    false
}

fn drop_tabs(s: ref String) -> String {
    s.replace("\t", "").replace("\n", "").replace("\r", "")
}

// _strip.
fn w3_strip(s: ref String) -> String {
    if s.len() == 0 or not has_c0_space(s) {
        return s.clone();
    }
    drop_tabs(strip_by(s, c0_space(), true, true))
}

fn find_or(s: ref String, pat: Str, from: i64) -> i64 {
    find_at(s, pat, from)
}

// _urlsplit.
fn w3_urlsplit(w: ref W3, url_in: ref String, scheme_in: ref String) -> Result[W3Split, PyErr] {
    if url_in.len() == 0 {
        return Ok(W3Split { scheme: scheme_in.clone(), netloc: String.new(), path: String.new(), query: String.new(), fragment: String.new(), username: None, password: None, hostname: None, port: None });
    }
    let mut url = strip_by(drop_tabs(url_in), c0_space(), true, false);
    let mut scheme = strip_by(drop_tabs(scheme_in), c0_space(), true, true);
    let mut netloc = String.new();
    let mut query = String.new();
    let mut fragment = String.new();
    // _SCHEME_RE: ^([a-zA-Z][a-zA-Z0-9+-.]*):
    let colon = find_at(url, ":", 0);
    if colon > 0 {
        let first = url.chars().next().unwrap_or(' ');
        if first.is_ascii_alphabetic() {
            let mut all = true;
            for c in url[0..colon].chars() {
                if not is_scheme_char(c) {
                    all = false;
                }
            }
            if all {
                scheme = ascii_lower_str(sub(url, 0, colon));
                url = tail(url, colon + 1);
            }
        }
    }
    if is_special(scheme) and url.contains("\\") {
        let mut cut = url.len();
        let q = find_at(url, "?", 0);
        if q != -1 {
            cut = q;
        }
        let h = find_at(url, "#", 0);
        if h != -1 and h < cut {
            cut = h;
        }
        url = sub(url, 0, cut).replace("\\", "/") + tail(url, cut);
    }
    let scan_start = if url.starts_with("//") { 2 } else { 0 };
    let slash_pos = find_or(url, "/", scan_start);
    let mut question_pos = find_or(url, "?", scan_start);
    let mut hash_pos = find_or(url, "#", scan_start);
    let mut open_br = find_or(url, "[", scan_start);
    let mut close_br = find_or(url, "]", scan_start);
    if url.starts_with("//") {
        let mut delim = url.len();
        if slash_pos > 0 and slash_pos < delim {
            delim = slash_pos;
        }
        if question_pos > 0 and question_pos < delim {
            delim = question_pos;
        }
        if hash_pos > 0 and hash_pos < delim {
            delim = hash_pos;
        }
        if not (open_br >= 2 and open_br < delim) {
            open_br = -1;
        }
        if not (close_br >= 2 and close_br < delim) {
            close_br = -1;
        }
        if (open_br != -1) != (close_br != -1) {
            return Err(value_error("Invalid IPv6 URL"));
        }
        netloc = sub(url, 2, delim);
        if open_br != -1 and close_br != -1 {
            check_bracketed_netloc(netloc)?;
        }
        url = tail(url, delim);
        if question_pos != -1 {
            question_pos -= delim;
        }
        if hash_pos != -1 {
            hash_pos -= delim;
        }
    }
    checknetloc(w, netloc)?;
    if hash_pos != -1 {
        let hp = if hash_pos > url.len() { url.len() } else { hash_pos };
        fragment = if hash_pos + 1 > url.len() { String.new() } else { tail(url, hash_pos + 1) };
        url = sub(url, 0, hp);
    }
    if question_pos != -1 {
        let qp = if question_pos > url.len() { url.len() } else { question_pos };
        query = if question_pos + 1 > url.len() { String.new() } else { tail(url, question_pos + 1) };
        url = sub(url, 0, qp);
    }
    let mut username: Option[String] = None;
    let mut password: Option[String] = None;
    let (userinfo, have_info, hostinfo) = rpartition(netloc, "@");
    if have_info {
        let (user, have_pw, pw) = partition(userinfo, ":");
        username = Some(user);
        if have_pw {
            password = Some(pw);
        }
    }
    let mut hostname = String.new();
    let mut port = String.new();
    if open_br != -1 {
        let (_, _, after) = partition(hostinfo, "[");
        let (h, _, rest) = partition(after, "]");
        let (_, _, p) = partition(rest, ":");
        hostname = h;
        port = p;
    } else {
        let (h, _, p) = partition(hostinfo, ":");
        hostname = h;
        port = p;
    }
    // __post_init__
    let (hn, delim, zone) = partition(hostname, "%");
    let host = if delim { f"{hn.to_lowercase()}%{zone}" } else { hn.to_lowercase() };
    let mut port_n: Option[i64] = None;
    if port.len() > 0 {
        if not ascii_digit_str(port) {
            return Err(value_error(f"Port could not be cast to integer value as {port}"));
        }
        let n = digits_int(port);
        if n > 65535 {
            return Err(value_error("Port out of range 0-65535"));
        }
        port_n = Some(n);
    }
    Ok(W3Split { scheme: scheme, netloc: netloc, path: url, query: query, fragment: fragment, username: username, password: password, hostname: Some(host), port: port_n })
}

fn w3_urlparse(w: ref W3, url: ref String) -> Result[UrlParts, PyErr] {
    if url.len() == 0 {
        return Ok(UrlParts { scheme: String.new(), netloc: String.new(), path: String.new(), params: String.new(), query: String.new(), fragment: String.new() });
    }
    let s = w3_urlsplit(w, url, "".to_string())?;
    let (path, params) = split_params(s.scheme, s.path);
    Ok(UrlParts { scheme: s.scheme, netloc: s.netloc, path: path, params: params, query: s.query, fragment: s.fragment })
}

// _idna: the host as bytes, through the idna codec when it is not ASCII.
fn idna_host(w: ref W3, host: ref String) -> Option[String] {
    if is_ascii_str(host) {
        return Some(host.clone());
    }
    let (_, normalized) = nfkc_netloc(w, host);
    idna_encode(w.u, normalized)
}

// _url2pathname, POSIX.
fn url2pathname(url0: ref String) -> String {
    if url0.len() == 0 {
        return String.new();
    }
    let url = if url0.starts_with("///") {
        tail(url0, 2)
    } else if url0.starts_with("//localhost/") {
        tail(url0, 11)
    } else {
        url0.clone()
    };
    if not url.contains("%") {
        return url;
    }
    utf8_str(unquote_s(url))
}

// ---------------------------------------------------------------- w3lib.url

// _safe_url_split.
fn safe_url_split(w: ref W3, url: ref V, encoding: ref String, path_encoding: ref String, quote_path: bool) -> Result[(String, String, String, String, String), PyErr] {
    let text = to_unicode(w, url, encoding, "percentencode")?;
    let parts = w3_urlsplit(w, w3_strip(text), "".to_string())?;
    let mut buf: Vec[u8] = Vec.new();
    if let Some(user) = parts.username.clone() {
        quote_into(unquote_s(user), mut buf, userinfo_safest(), false);
        if let Some(pw) = parts.password.clone() {
            buf.push(58);
            quote_into(unquote_s(pw), mut buf, userinfo_safest(), false);
        }
        buf.push(64);
    }
    if let Some(host) = parts.hostname.clone() {
        if host.contains(":") {
            buf.push(91);
            bpush_str(mut buf, host);
            buf.push(93);
        } else {
            match idna_host(w, host) {
                Some(h) => bpush_str(mut buf, h),
                None => bpush_str(mut buf, host),
            }
        }
    }
    if let Some(port) = parts.port {
        buf.push(58);
        bpush_str(mut buf, f"{port}");
    }
    let netloc = utf8_str(buf);
    let path = if quote_path {
        utf8_str(quote(w.c.encode(parts.path, path_encoding)?, path_safest()))
    } else {
        parts.path.clone()
    };
    let qsafe = if is_special(parts.scheme) { special_query_safest() } else { path_safest() };
    let query = utf8_str(quote(w.c.encode(parts.query, encoding)?, qsafe));
    let fragment = if parts.fragment.len() > 0 {
        utf8_str(quote(w.c.encode(parts.fragment, encoding)?, path_safest()))
    } else {
        parts.fragment.clone()
    };
    let final_path = if path.len() == 0 and query.len() > 0 and is_special(parts.scheme) { "/".to_string() } else { path };
    Ok((parts.scheme.clone(), netloc, final_path, query, fragment))
}

fn safe_url_string(w: ref W3, url: ref V, encoding: ref String, path_encoding: ref String, quote_path: bool) -> Result[String, PyErr] {
    let (a, b, c, d, e) = safe_url_split(w, url, encoding, path_encoding, quote_path)?;
    Ok(urlunsplit(a, b, c, d, e))
}

fn safe_url_str(w: ref W3, url: ref String) -> Result[String, PyErr] {
    safe_url_string(w, V.Str(url.clone()), "utf8".to_string(), "utf8".to_string(), true)
}

// _parent_dirs.sub("", path): /?(\.\./)+
fn drop_parent_dirs(s: ref String) -> String {
    let b = bytes_of(s);
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let mut j = i;
        if b[j] == 47 and j + 3 < b.len() + 0 and bstarts(bslice(b, j + 1, b.len()), bytes_lit("../")) {
            j += 1;
        }
        let mut k = j;
        while k + 3 <= b.len() and b[k] == 46 and b[k + 1] == 46 and b[k + 2] == 47 {
            k += 3;
        }
        if k > j {
            i = k;
            continue;
        }
        out.push(b[i]);
        i += 1;
    }
    utf8_str(out)
}

fn encoded_dot(seg: ref String) -> Option[String] {
    let l = seg.to_lowercase();
    if l == "%2e" {
        return Some(".".to_string());
    }
    if l == ".%2e" or l == "%2e." or l == "%2e%2e" {
        return Some("..".to_string());
    }
    None
}

fn safe_download_url(w: ref W3, url: ref V, encoding: ref String, path_encoding: ref String) -> Result[String, PyErr] {
    let safe = safe_url_string(w, url, encoding, path_encoding, true)?;
    let s = w3_urlsplit(w, safe, "".to_string())?;
    let mut path = s.path.clone();
    if path.len() > 0 {
        if path.contains("%") {
            let mut segs: Vec[String] = Vec.new();
            for seg in split_str(path, "/").iter() {
                segs.push(encoded_dot(seg).unwrap_or(seg.clone()));
            }
            path = join_strs(segs, "/");
        }
        let mut normalized = drop_parent_dirs(normpath(path));
        if path.ends_with("/") and not normalized.ends_with("/") {
            normalized.push('/');
        }
        path = normalized;
    } else {
        path = "/".to_string();
    }
    Ok(urlunsplit(s.scheme, s.netloc, path, s.query, "".to_string()))
}

fn is_url(text: ref String) -> bool {
    let (scheme, _, _) = partition(text, "://");
    scheme == "file" or scheme == "http" or scheme == "https"
}

fn url_query_parameter(w: ref W3, url: ref V, parameter: ref String, default: ref Option[String], keep_blank: bool, sep: ref String) -> Result[Option[String], PyErr] {
    let text = to_unicode(w, url, "utf-8".to_string(), "strict")?;
    let s = w3_urlsplit(w, text, "".to_string())?;
    let want = bytes_of(parameter);
    for (k, v) in parse_qsl(bytes_of(s.query), keep_blank, bytes_of(sep)).iter() {
        if beq(k, want) {
            return Ok(Some(utf8_decode(v, "replace")?));
        }
    }
    Ok(default.clone())
}

fn url_query_cleaner(url0: ref String, params: ref Vec[String], sep: ref String, kvsep: ref String, remove: bool, unique: bool, keep_fragments: bool) -> String {
    let (url, _, fragment) = partition(url0, "#");
    let (base, _, query) = partition(url, "?");
    if query.len() == 0 or (params.len() == 0 and not remove) {
        return if not (keep_fragments and fragment.len() > 0) { base } else { f"{base}#{fragment}" };
    }
    let mut seen: Vec[String] = Vec.new();
    let mut result: Vec[String] = Vec.new();
    for ksv in split_str(query, sep).iter() {
        if ksv.len() == 0 {
            continue;
        }
        let (k, _, _) = partition(ksv, kvsep);
        if unique {
            if has(seen, k) {
                continue;
            }
            seen.push(k.clone());
        }
        let listed = has(params, k);
        if remove {
            if listed {
                continue;
            }
        } else if not listed {
            continue;
        }
        result.push(ksv.clone());
    }
    let mut out = if result.len() == 0 { base } else { f"{base}?{join_strs(result, sep)}" };
    if keep_fragments and fragment.len() > 0 {
        out = f"{out}#{fragment}";
    }
    out
}

fn add_or_replace_parameters(w: ref W3, url: ref String, params: ref Vec[(Vec[u8], Vec[u8])], sep: ref String) -> Result[String, PyErr] {
    let parsed = w3_urlsplit(w, url, "".to_string())?;
    let current = parse_qsl(bytes_of(parsed.query), true, bytes_of(sep));
    let mut new_args: Vec[(Vec[u8], Vec[u8])] = Vec.new();
    let mut seen: Vec[Vec[u8]] = Vec.new();
    for (name, value) in current.iter() {
        let mut already = false;
        for s in seen.iter() {
            if beq(s, name) {
                already = true;
            }
        }
        if already {
            continue;
        }
        let mut replacement: Option[Vec[u8]] = None;
        for (k, v) in params.iter() {
            if beq(k, name) {
                replacement = Some(v.clone());
            }
        }
        match replacement {
            None => new_args.push((name.clone(), value.clone())),
            Some(r) => {
                new_args.push((name.clone(), r));
                seen.push(name.clone());
            }
        }
    }
    for (name, value) in params.iter() {
        let mut already = false;
        for s in seen.iter() {
            if beq(s, name) {
                already = true;
            }
        }
        if not already {
            new_args.push((name.clone(), value.clone()));
        }
    }
    let q = utf8_str(urlencode(new_args, bytes_of(sep)));
    Ok(urlunsplit(parsed.scheme, parsed.netloc, parsed.path, q, parsed.fragment))
}

// Path(path).absolute() for an absolute POSIX path.
fn pathlib_norm(path: ref String) -> String {
    let lead = if path.starts_with("//") and not path.starts_with("///") { "//" } else if path.starts_with("/") { "/" } else { "" };
    let mut parts: Vec[String] = Vec.new();
    for p in split_str(path, "/").iter() {
        if p.len() > 0 and p != "." {
            parts.push(p.clone());
        }
    }
    f"{lead}{join_strs(parts, "/")}"
}

fn path_to_file_uri(path: ref String) -> String {
    let mut p = pathlib_norm(path);
    if p.starts_with("//") {
        p = f"//{p}";
    }
    let quoted = std_quote(p);
    let b = bytes_of(quoted);
    let mut i = 0;
    while i < b.len() and b[i] == 47 {
        i += 1;
    }
    f"file:///{tail(quoted, i)}"
}

fn file_uri_to_path(w: ref W3, uri: ref String) -> Result[String, PyErr] {
    let p = w3_urlparse(w, uri)?;
    Ok(url2pathname(p.path))
}

fn any_to_uri(w: ref W3, s: ref String) -> Result[String, PyErr] {
    let p = w3_urlparse(w, s)?;
    if p.scheme.len() > 0 { Ok(s.clone()) } else { Ok(path_to_file_uri(s)) }
}

fn add_http_if_no_scheme(w: ref W3, url: ref String) -> Result[String, PyErr] {
    // ^\w+://
    let cs: Vec[char] = url.chars().collect();
    let mut i = 0;
    while i < cs.len() and (cs[i].is_alphanumeric() or cs[i] == '_') {
        i += 1;
    }
    let has_scheme = i > 0 and i + 2 < cs.len() and cs[i] == ':' and cs[i + 1] == '/' and cs[i + 2] == '/';
    if has_scheme {
        return Ok(url.clone());
    }
    let p = w3_urlparse(w, url)?;
    let scheme = if p.netloc.len() > 0 { "http:" } else { "http://" };
    Ok(f"{scheme}{url}")
}

// RFC 2045 token characters.
fn token_char(c: u8) -> bool {
    if c <= 32 or c >= 127 {
        return false;
    }
    for t in "()<>@,;:\\\"/[]?= ".bytes() {
        if t == c {
            return false;
        }
    }
    true
}

fn token_end(b: ref Vec[u8], from: i64) -> i64 {
    let mut i = from;
    while i < b.len() and token_char(b[i]) {
        i += 1;
    }
    i
}

struct DataUri {
    media_type: String,
    params: Vec[(String, String)],
    data: Vec[u8],
}

fn parse_data_uri(w: ref W3, uri: ref V) -> Result[DataUri, PyErr] {
    let raw = match uri {
        V.Bytes(b) => b.clone(),
        _ => bytes_of(safe_url_string(w, uri, "utf8".to_string(), "utf8".to_string(), true)?),
    };
    let colon = bfind_byte(raw, 58, 0);
    let scheme = if colon < 0 { raw.clone() } else { bslice(raw, 0, colon) };
    let rest0 = if colon < 0 { Vec.new() } else { bslice(raw, colon + 1, raw.len()) };
    if scheme.len() == 0 or rest0.len() == 0 {
        return Err(value_error("invalid URI"));
    }
    if not beq(blower(scheme), bytes_lit("data")) {
        return Err(value_error("not a data URI"));
    }
    let mut rest = unquote_b(rest0, false);
    let mut media_type = "text/plain".to_string();
    let mut params: Vec[(String, String)] = Vec.new();
    let t1 = token_end(rest, 0);
    let mut matched = false;
    if t1 > 0 and t1 < rest.len() and rest[t1] == 47 {
        let t2 = token_end(rest, t1 + 1);
        if t2 > t1 + 1 {
            media_type = utf8_str(bslice(rest, 0, t2));
            rest = bslice(rest, t2, rest.len());
            matched = true;
        }
    }
    if not matched {
        params.push(("charset".to_string(), "US-ASCII".to_string()));
    }
    loop {
        // ;(token)=(?:(token)|"(quoted)")
        if rest.len() == 0 or rest[0] != 59 {
            break;
        }
        let a_end = token_end(rest, 1);
        if a_end == 1 or a_end >= rest.len() or rest[a_end] != 61 {
            break;
        }
        let attribute = utf8_str(bslice(rest, 1, a_end));
        let v_start = a_end + 1;
        let v_end = token_end(rest, v_start);
        let mut value: Vec[u8] = Vec.new();
        let mut end = 0;
        if v_end > v_start {
            value = bslice(rest, v_start, v_end);
            end = v_end;
        } else if v_start < rest.len() and rest[v_start] == 34 {
            let mut i = v_start + 1;
            let mut ok = false;
            while i < rest.len() {
                let c = rest[i];
                if c == 34 {
                    ok = true;
                    break;
                }
                if c == 92 {
                    if i + 1 < rest.len() and rest[i + 1] < 127 {
                        value.push(rest[i + 1]);
                        i += 2;
                        continue;
                    }
                    break;
                }
                if c == 13 or c >= 127 {
                    break;
                }
                value.push(c);
                i += 1;
            }
            if not ok {
                break;
            }
            end = i + 1;
        } else {
            break;
        }
        let mut replaced = false;
        let mut k = 0;
        while k < params.len() {
            if params[k].0 == attribute {
                params[k] = (attribute.clone(), utf8_str(value));
                replaced = true;
            }
            k += 1;
        }
        if not replaced {
            params.push((attribute, utf8_str(value)));
        }
        rest = bslice(rest, end, rest.len());
    }
    let comma = bfind_byte(rest, 44, 0);
    let (is_b64, data) = if comma < 0 { (rest.clone(), Vec.new()) } else { (bslice(rest, 0, comma), bslice(rest, comma + 1, rest.len())) };
    let mut out = data;
    if is_b64.len() > 0 {
        if not beq(is_b64, bytes_lit(";base64")) {
            return Err(value_error("invalid data URI"));
        }
        out = b64decode(out)?;
    }
    Ok(DataUri { media_type: media_type, params: params, data: out })
}

fn data_uri_repr(w: ref W3, d: ref DataUri) -> String {
    let mut items: Vec[String] = Vec.new();
    for (k, v) in d.params.iter() {
        items.push(f"{w.u.repr(k)}: {w.u.repr(v)}");
    }
    f"ParseDataURIResult(media_type={w.u.repr(d.media_type)}, media_type_parameters={{{join_strs(items, ", ")}}}, data={bytes_repr(d.data)})"
}

// _remove_dot_segments.
fn remove_dot_segments(path: ref String) -> String {
    if not path.contains("/.") {
        return path.clone();
    }
    let segments = split_str(tail(path, 1), "/");
    let mut out: Vec[String] = Vec.new();
    let mut i = 0;
    while i + 1 < segments.len() {
        let s = segments[i].clone();
        if s == ".." {
            if out.len() > 0 {
                out.pop();
            }
        } else if s != "." {
            out.push(s);
        }
        i += 1;
    }
    let last = segments[segments.len() - 1].clone();
    if last == ".." {
        if out.len() > 0 {
            out.pop();
        }
        out.push(String.new());
    } else if last == "." {
        out.push(String.new());
    } else {
        out.push(last);
    }
    f"/{join_strs(out, "/")}"
}

fn bytes_cmp(a: ref Vec[u8], b: ref Vec[u8]) -> i64 {
    let mut i = 0;
    while i < a.len() and i < b.len() {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 };
        }
        i += 1;
    }
    if a.len() < b.len() {
        -1
    } else if a.len() > b.len() {
        1
    } else {
        0
    }
}

// list.sort() of (bytes, bytes) pairs: stable insertion sort.
fn sort_pairs(v: mut ref Vec[(Vec[u8], Vec[u8])]) {
    let mut i = 1;
    while i < v.len() {
        let mut j = i;
        while j > 0 {
            let c = bytes_cmp(v[j - 1].0, v[j].0);
            let later = c > 0 or (c == 0 and bytes_cmp(v[j - 1].1, v[j].1) > 0);
            if not later {
                break;
            }
            let t = v[j].clone();
            v[j] = v[j - 1].clone();
            v[j - 1] = t;
            j -= 1;
        }
        i += 1;
    }
}

// _unquotepath.
fn unquotepath(path: ref String) -> Vec[u8] {
    if not path.contains("%") {
        return bytes_of(path);
    }
    let p = path.replace("%25", "%2525").replace("%2f", "%252F").replace("%2F", "%252F").replace("%3b", "%253B").replace("%3B", "%253B").replace("%3f", "%253F").replace("%3F", "%253F");
    unquote_s(p)
}

// _normalize_ipv6_host.
fn normalize_ipv6_host(netloc: ref String) -> String {
    let start = find_at(netloc, "[", 0);
    if start < 0 {
        return netloc.clone();
    }
    let end = find_at(netloc, "]", start);
    if end < 0 {
        return netloc.clone();
    }
    match ip_address(sub(netloc, start + 1, end)) {
        Ok(a) => {
            if not a.v6 {
                return netloc.clone();
            }
            f"{sub(netloc, 0, start)}[{addr_str(a)}]{tail(netloc, end + 1)}"
        }
        Err(_) => netloc.clone(),
    }
}

fn canonicalize_url(w: ref W3, url: ref V, keep_blank: bool, keep_fragments: bool, encoding: ref String, sep: ref String) -> Result[String, PyErr] {
    let enc = if encoding.len() == 0 { "utf8".to_string() } else { encoding.clone() };
    let split = match safe_url_split(w, url, enc, "utf8".to_string(), true) {
        Ok(p) => p,
        Err(e) => {
            if e.kind != "UnicodeEncodeError" {
                return Err(e);
            }
            safe_url_split(w, url, "utf8".to_string(), "utf8".to_string(), true)?
        }
    };
    let (scheme, netloc0, path0, query0, fragment0) = split;
    let (path1, params) = split_params(scheme, path0);
    let mut query = query0;
    if query.len() > 0 {
        let mut kv = parse_qsl(bytes_of(query), keep_blank, bytes_of(sep));
        if kv.len() > 1 {
            sort_pairs(mut kv);
        }
        query = utf8_str(urlencode(kv, bytes_of(sep)));
    }
    let mut path = if path1.len() > 0 { utf8_str(quote(unquotepath(path1), path_safe())) } else { "/".to_string() };
    if path.starts_with("/") {
        path = remove_dot_segments(path);
    }
    let fragment = if keep_fragments { fragment0 } else { String.new() };
    let at = match netloc0.rfind("@") {
        Some(i) => i as i64,
        None => -1,
    };
    let mut host = (if at != -1 { tail(netloc0, at + 1) } else { netloc0.clone() }).to_lowercase();
    if host.ends_with(":") {
        host = sub(host, 0, host.len() - 1);
    }
    let netloc1 = if at != -1 { sub(netloc0, 0, at + 1) + host } else { host };
    let netloc = normalize_ipv6_host(netloc1);
    Ok(urlunparse(scheme, netloc, path, params, query, fragment))
}

// ---------------------------------------------------------------- regex glue

// The compiled patterns of w3lib.html, w3lib.encoding and w3lib._util,
// built once. A bytes pattern runs on the bytes as code points 0..255
// with the ASCII flag, which is how Python matches a bytes pattern, so
// one program serves a str pattern and its bytes twin.
struct Rxs {
    ent: Program,
    tag: Program,
    tag_extent: Program,
    base: Program,
    base_scan: Program,
    refresh: Program,
    tags: Program,
    meta: Program,
    meta_scan_default: Program,
    meta_scan_none: Program,
    comments: Program,
    attr: Program,
    header_enc: Program,
    header_param: Program,
    label: Program,
    body_scan: Program,
    pragma: Program,
    content_charset: Program,
    title: Program,
    href: Program,
    img: Program,
    script_style: Program,
}

fn rx(p: ref String, flags: i64) -> Program {
    match compile(cps(p), flags) {
        Ok(pr) => pr,
        Err(e) => panic(f"cannot compile {p}: {err_text(e)}"),
    }
}

// re.escape.
fn re_escape(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if in_chars(c, "()[]{}?*+-|^$\\.&~# \t\n\r\u{b}\u{c}") {
            out.push('\\');
        }
        out.push(c);
    }
    out
}

fn tag_alternation(tags: ref Vec[String]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for t in tags.iter() {
        parts.push(re_escape(t));
    }
    join_strs(parts, "|")
}

fn meta_scan_flags() -> i64 {
    flag_i() | flag_a()
}

fn remove_tags_flags() -> i64 {
    flag_i() | flag_s() | flag_x() | flag_a()
}

fn load_rxs() -> Rxs {
    let a = flag_a();
    let i = flag_i();
    let ss: Vec[String] = vec!["script".to_string(), "style".to_string()];
    let ns: Vec[String] = vec!["noscript".to_string(), "script".to_string()];
    Rxs {
        ent: rx(pat_ent(), i),
        tag: rx(pat_tag(), a),
        tag_extent: rx(pat_tag_extent(), a),
        base: rx(pat_base(), i | a),
        base_scan: rx(pat_base_scan(), i | flag_s() | flag_x() | a),
        refresh: rx(pat_refresh(), flag_s() | i | a),
        tags: rx(pat_tags(), i | flag_x() | a),
        meta: rx(pat_meta(), i | a),
        meta_scan_default: rx(pat_meta_scan().replace("@@", tag_alternation(ns)), meta_scan_flags()),
        meta_scan_none: rx(pat_meta_scan_none(), meta_scan_flags()),
        comments: rx(pat_comments(), flag_s()),
        attr: rx(pat_attr(), flag_x()),
        header_enc: rx(pat_header_enc(), i),
        header_param: rx(pat_header_param(), 0),
        label: rx(pat_label(), 0),
        body_scan: rx(pat_body_scan(), i | flag_s() | flag_x()),
        pragma: rx(pat_pragma(), i),
        content_charset: rx(pat_content_charset(), i),
        title: rx(pat_title(), flag_s() | i),
        href: rx(pat_href(), i),
        img: rx(pat_img(), i),
        script_style: rx(pat_remove_tags().replace("@@", tag_alternation(ss)), remove_tags_flags()),
    }
}

// The group number of a named group.
fn gnum(pr: ref Program, name: Str) -> i64 {
    let want = cp(name);
    for (n, g) in pr.names.iter() {
        if same(n, want) {
            return g;
        }
    }
    -1
}

fn grp(s: ref Vec[i64], m: ref Found, g: i64) -> Option[String] {
    if g == 0 {
        return Some(to_string(slice(s, m.start, m.end)));
    }
    let (a, b) = m.spans[g - 1];
    if a < 0 { None } else { Some(to_string(slice(s, a, b))) }
}

fn gname(pr: ref Program, s: ref Vec[i64], m: ref Found, name: Str) -> Option[String] {
    grp(s, m, gnum(pr, name))
}

// `m.group(x) or ""`.
fn gtext(pr: ref Program, s: ref Vec[i64], m: ref Found, name: Str) -> String {
    gname(pr, s, m, name).unwrap_or(String.new())
}

fn re_search(pr: ref Program, s: ref Vec[i64]) -> Option[Found] {
    let mut m = new_matcher(pr, s);
    find(mut m, pr, 0, false, 0)
}

fn re_match(pr: ref Program, s: ref Vec[i64], pos: i64) -> Option[Found] {
    let mut m = new_matcher(pr, s);
    find(mut m, pr, pos, false, 1)
}

fn re_fullmatch(pr: ref Program, s: ref Vec[i64]) -> bool {
    let mut m = new_matcher(pr, s);
    find(mut m, pr, 0, false, 2).is_some()
}

// pattern.sub(token, s) for a fixed replacement.
fn re_sub_text(pr: ref Program, s: ref String, token: ref String) -> String {
    let c = cps(s);
    let tok = cps(token);
    let mut out: Vec[i64] = Vec.new();
    let mut pos = 0;
    for m in all_matches(pr, c, 0).iter() {
        push_all(mut out, slice(c, pos, m.start));
        push_all(mut out, tok);
        pos = m.end;
    }
    push_all(mut out, slice(c, pos, c.len()));
    to_string(out)
}

// ---------------------------------------------------------------- w3lib._util

// iter_tag_attributes: (name, value) of every attribute with a value.
fn iter_tag_attributes(w: ref W3, attrs: ref String) -> Vec[(String, String)] {
    let pr = ref w.rx.attr;
    let s = cps(attrs);
    let mut out: Vec[(String, String)] = Vec.new();
    for m in all_matches(pr, s, 0).iter() {
        if m.lastindex == 1 {
            continue;
        }
        let name = grp(s, m, 1).unwrap_or(String.new());
        let mut value = String.new();
        let mut g = 2;
        while g <= 4 {
            let v = grp(s, m, g).unwrap_or(String.new());
            if v.len() > 0 {
                value = v;
                break;
            }
            g += 1;
        }
        out.push((name.to_lowercase(), value));
    }
    out
}

// _scannable: ASCII bytes decode to themselves, and no byte sequence is
// dropped while decoding. Every codec the port can name that passes the
// first test passes the second.
fn scannable(w: ref W3, encoding: ref String) -> bool {
    let name = match w.c.lookup(encoding) {
        Ok(n) => n,
        Err(_) => return false,
    };
    if name.starts_with("utf-16") or name.starts_with("utf-32") {
        return false;
    }
    let mut ascii: Vec[u8] = Vec.new();
    let mut b = 0;
    while b < 128 {
        ascii.push(b as u8);
        b += 1;
    }
    match w.c.decode(ascii, name, "replace") {
        Ok(text) => {
            let mut k = 0;
            for c in text.chars() {
                if c as i64 != k {
                    return false;
                }
                k += 1;
            }
            k == 128
        }
        Err(_) => false,
    }
}

// ---------------------------------------------------------------- w3lib.html

fn html5_whitespace() -> Str {
    " \t\n\r\u{c}"
}

fn int_saturating(s: ref String, base: i64) -> i64 {
    let mut v: i64 = 0;
    for c in s.chars() {
        let d = c.to_digit(base as u32).unwrap_or(0) as i64;
        v = v * base + d;
        if v > 0x7FFFFFFF {
            return 0x7FFFFFFF;
        }
    }
    v
}

fn replace_entities_str(w: ref W3, text: ref String, keep: ref Vec[String], remove_illegal: bool) -> String {
    let pr = ref w.rx.ent;
    let s = cps(text);
    let mut out: Vec[i64] = Vec.new();
    let mut pos = 0;
    let g_named = gnum(pr, "named");
    let g_dec = gnum(pr, "dec");
    let g_hex = gnum(pr, "hex");
    let g_semi = gnum(pr, "semicolon");
    for m in all_matches(pr, s, 0).iter() {
        push_all(mut out, slice(s, pos, m.start));
        pos = m.end;
        let whole = slice(s, m.start, m.end);
        let dec = grp(s, m, g_dec).unwrap_or(String.new());
        let hex = grp(s, m, g_hex).unwrap_or(String.new());
        let mut number: i64 = -1;
        if dec.len() > 0 {
            number = int_saturating(dec, 10);
        } else if hex.len() > 0 {
            number = int_saturating(hex, 16);
        } else {
            let name = grp(s, m, g_named).unwrap_or(String.new());
            let lower = name.to_lowercase();
            if has(keep, lower) {
                push_all(mut out, whole);
                continue;
            }
            number = match w.ents.get(name.clone()) {
                Some(n) => *n,
                None => w.ents.get(lower).cloned().unwrap_or(-1),
            };
        }
        if number >= 0 {
            if number == 0 or (number >= 0xD800 and number <= 0xDFFF) {
                out.push(0xFFFD);
                continue;
            }
            if number >= 0x80 and number <= 0x9F {
                let table = w.c.charmap("cp1252".to_string());
                if table[number] >= 0 {
                    out.push(table[number]);
                    continue;
                }
            } else if number <= 0x10FFFF {
                out.push(number);
                continue;
            }
        }
        let semi = grp(s, m, g_semi).unwrap_or(String.new());
        if not (remove_illegal and semi.len() > 0) {
            push_all(mut out, whole);
        }
    }
    push_all(mut out, slice(s, pos, s.len()));
    to_string(out)
}

fn replace_entities(w: ref W3, text: ref V, keep: ref Vec[String], remove_illegal: bool, encoding: ref String) -> Result[String, PyErr] {
    let t = to_unicode(w, text, encoding, "strict")?;
    Ok(replace_entities_str(w, t, keep, remove_illegal))
}

fn has_entities(w: ref W3, text: ref V, encoding: ref String) -> Result[bool, PyErr] {
    let t = to_unicode(w, text, encoding, "strict")?;
    Ok(re_search(w.rx.ent, cps(t)).is_some())
}

fn replace_tags(w: ref W3, text: ref V, token: ref String, encoding: ref String) -> Result[String, PyErr] {
    let t = to_unicode(w, text, encoding, "strict")?;
    Ok(re_sub_text(w.rx.tag, t, token))
}

fn remove_comments(w: ref W3, text: ref V, encoding: ref String) -> Result[String, PyErr] {
    let t = to_unicode(w, text, encoding, "strict")?;
    Ok(re_sub_text(w.rx.comments, t, String.new()))
}

fn lower_all(v: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for s in v.iter() {
        out.push(s.to_lowercase());
    }
    out
}

fn remove_tags_str(w: ref W3, text: ref String, which_ones: ref Vec[String], keep: ref Vec[String]) -> String {
    let pr = ref w.rx.tags;
    let s = cps(text);
    let g_named = gnum(pr, "named");
    let g_name = gnum(pr, "name");
    let mut out: Vec[i64] = Vec.new();
    let mut pos = 0;
    for m in all_matches(pr, s, 0).iter() {
        push_all(mut out, slice(s, pos, m.start));
        pos = m.end;
        let named = grp(s, m, g_named).unwrap_or(String.new());
        let tag = (if named.len() > 0 { named } else { grp(s, m, g_name).unwrap_or(String.new()) }).to_lowercase();
        let remove = if which_ones.len() > 0 { has(which_ones, tag) } else { not has(keep, tag) };
        if not remove {
            push_all(mut out, slice(s, m.start, m.end));
        }
    }
    push_all(mut out, slice(s, pos, s.len()));
    to_string(out)
}

fn remove_tags(w: ref W3, text: ref V, which_ones: ref Vec[String], keep: ref Vec[String], encoding: ref String) -> Result[String, PyErr] {
    let tags = lower_all(which_ones);
    let kept = lower_all(keep);
    if tags.len() > 0 and kept.len() > 0 {
        return Err(value_error("Cannot use both which_ones and keep"));
    }
    let t = to_unicode(w, text, encoding, "strict")?;
    Ok(remove_tags_str(w, t, tags, kept))
}

// sorted(set(which_ones)).
fn sorted_set(v: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for s in v.iter() {
        if not has(out, s) {
            out.push(s.clone());
        }
    }
    out.sort();
    out
}

fn remove_tags_with_content(w: ref W3, text: ref V, which_ones: ref Vec[String], encoding: ref String) -> Result[String, PyErr] {
    let t = to_unicode(w, text, encoding, "strict")?;
    if which_ones.len() == 0 {
        return Ok(t);
    }
    let tags = sorted_set(which_ones);
    if tags.len() == 2 and tags[0] == "script" and tags[1] == "style" {
        return Ok(re_sub_text(w.rx.script_style, t, String.new()));
    }
    let pr = rx(pat_remove_tags().replace("@@", tag_alternation(tags)), remove_tags_flags());
    Ok(re_sub_text(pr, t, String.new()))
}

fn replace_escape_chars(w: ref W3, text: ref V, which_ones: ref Vec[String], replace_by: ref V, encoding: ref String) -> Result[String, PyErr] {
    let mut t = to_unicode(w, text, encoding, "strict")?;
    for ec in which_ones.iter() {
        let by = to_unicode(w, replace_by, encoding, "strict")?;
        t = t.replace(ec, by);
    }
    Ok(t)
}

fn unquote_markup(w: ref W3, text: ref V, keep: ref Vec[String], remove_illegal: bool, encoding: ref String) -> Result[String, PyErr] {
    let t = to_unicode(w, text, encoding, "strict")?;
    let mut out = String.new();
    let mut offset = 0;
    loop {
        let start = find_at(t, "<![CDATA[", offset);
        if start == -1 {
            break;
        }
        let data_start = start + 9;
        let end = find_at(t, "]]>", data_start);
        if end == -1 {
            break;
        }
        if offset < start {
            out.push_str(replace_entities_str(w, sub(t, offset, start), keep, remove_illegal));
        }
        out.push_str(sub(t, data_start, end));
        offset = end + 3;
    }
    if offset < t.len() {
        out.push_str(replace_entities_str(w, tail(t, offset), keep, remove_illegal));
    }
    Ok(out)
}

// The text a str or bytes argument scans: its code points, or its bytes
// as code points.
fn scan_cps(v: ref V) -> Vec[i64] {
    match v {
        V.Bytes(b) => byte_cps(b),
        V.Str(s) => cps(s),
        _ => Vec.new(),
    }
}

fn v_prefix(v: ref V, c: ref Vec[i64], n: i64) -> V {
    match v {
        V.Bytes(b) => V.Bytes(bslice(b, 0, n)),
        _ => V.Str(to_string(slice(c, 0, n))),
    }
}

// _cut: the text cut to max_scan, extended to the end of a tag the cut
// splits, and whether anything was left out.
fn cut(w: ref W3, text: ref V, max_scan: ref Option[i64]) -> Result[(V, bool), PyErr] {
    let n = match max_scan {
        None => return Ok((text.clone(), false)),
        Some(n) => *n,
    };
    if n < 0 {
        return Err(value_error_s(f"max_scan must not be negative, got {n}"));
    }
    let c = scan_cps(text);
    if n >= c.len() {
        return Ok((text.clone(), false));
    }
    let pr = ref w.rx.tag_extent;
    let mut m = new_matcher(pr, c);
    let mut start = n;
    loop {
        // text.rfind("<", 0, start)
        let mut k = start - 1;
        while k >= 0 and c[k] != 60 {
            k -= 1;
        }
        if k < 0 {
            break;
        }
        start = k;
        match find(mut m, pr, start, false, 1) {
            None => continue,
            Some(tag) => {
                if tag.end > n {
                    return Ok((v_prefix(text, c, tag.end), tag.end < c.len()));
                }
                break;
            }
        }
    }
    Ok((v_prefix(text, c, n), true))
}

fn value_error_s(msg: own String) -> PyErr {
    py_err("ValueError", msg)
}

fn default_baseurl(w: ref W3, baseurl: ref V) -> Result[String, PyErr] {
    safe_url_string(w, baseurl, "utf8".to_string(), "utf8".to_string(), true)
}

fn get_base_url(w: ref W3, text0: ref V, baseurl: ref V, encoding: ref String, max_scan: ref Option[i64]) -> Result[String, PyErr] {
    let (text, was_cut) = cut(w, text0, max_scan)?;
    if let V.Bytes(ref b) = text {
        if scannable(w, encoding) and re_search(w.rx.base, byte_cps(b)).is_none() {
            return default_baseurl(w, baseurl);
        }
    }
    let utext = to_unicode(w, text, encoding, if was_cut { "replace" } else { "strict" })?;
    let s = cps(utext);
    if re_search(w.rx.base, s).is_none() {
        return default_baseurl(w, baseurl);
    }
    let pr = ref w.rx.base_scan;
    let g_attrs = gnum(pr, "attrs");
    let ap = ref w.rx.attr;
    let g_double = gnum(ap, "double");
    let g_single = gnum(ap, "single");
    let g_bare = gnum(ap, "bare");
    for m in all_matches(pr, s, 0).iter() {
        let attrs = match grp(s, m, g_attrs) {
            None => continue,
            Some(a) => cps(a),
        };
        for attr in all_matches(ap, attrs, 0).iter() {
            if grp(attrs, attr, 1).unwrap_or(String.new()).to_lowercase() != "href" {
                continue;
            }
            let mut value = grp(attrs, attr, g_double).unwrap_or(String.new());
            if value.len() == 0 {
                value = grp(attrs, attr, g_single).unwrap_or(String.new());
            }
            if value.len() == 0 {
                value = grp(attrs, attr, g_bare).unwrap_or(String.new());
            }
            let url = strip_by(value, html5_whitespace(), true, true);
            if url.len() > 0 {
                let b = default_baseurl(w, baseurl)?;
                let u = safe_url_string(w, V.Str(url), encoding, "utf8".to_string(), true)?;
                return urljoin(w.u, b, u);
            }
            return default_baseurl(w, baseurl);
        }
    }
    default_baseurl(w, baseurl)
}

// _refresh: the interval and absolute url a <meta> tag declares.
fn refresh_of(w: ref W3, attrs0: ref String, baseurl: ref String, encoding: ref String) -> Result[Option[(f64, String)], PyErr] {
    let attrs = if attrs0.contains("&") { replace_entities_str(w, attrs0, Vec.new(), true) } else { attrs0.clone() };
    let mut pragma = false;
    let mut interval: Option[f64] = None;
    let mut url = String.new();
    let pr = ref w.rx.refresh;
    for (name, value) in iter_tag_attributes(w, attrs).iter() {
        if name == "http-equiv" {
            if value.to_lowercase().contains("refresh") {
                pragma = true;
            }
        } else if name == "content" and interval.is_none() {
            let v = cps(value);
            if let Some(m) = re_match(pr, v, 0) {
                interval = Some(py_float(gtext(pr, v, m, "int")));
                url = gtext(pr, v, m, "url");
            }
        }
    }
    if not pragma {
        return Ok(None);
    }
    match interval {
        None => Ok(None),
        Some(i) => {
            let safe = safe_url_string(w, V.Str(strip_by(url, " \"'", true, true)), encoding, "utf8".to_string(), true)?;
            Ok(Some((i, urljoin(w.u, baseurl, safe)?)))
        }
    }
}

fn get_meta_refresh(w: ref W3, text0: ref V, baseurl: ref String, encoding: ref String, ignore_tags: ref Vec[String], max_scan: ref Option[i64]) -> Result[Option[(f64, String)], PyErr] {
    let ignored = sorted_set(lower_all(ignore_tags));
    if ignored.len() == 0 {
        return meta_refresh_with(w, w.rx.meta_scan_none, text0, baseurl, encoding, max_scan);
    }
    if ignored.len() == 2 and ignored[0] == "noscript" and ignored[1] == "script" {
        return meta_refresh_with(w, w.rx.meta_scan_default, text0, baseurl, encoding, max_scan);
    }
    let pr = rx(pat_meta_scan().replace("@@", tag_alternation(ignored)), meta_scan_flags());
    meta_refresh_with(w, pr, text0, baseurl, encoding, max_scan)
}

fn meta_refresh_with(w: ref W3, pr: ref Program, text0: ref V, baseurl: ref String, encoding: ref String, max_scan: ref Option[i64]) -> Result[Option[(f64, String)], PyErr] {
    let g_attrs = gnum(pr, "attrs");
    let (text, was_cut) = cut(w, text0, max_scan)?;
    if let V.Bytes(ref b) = text {
        if scannable(w, encoding) {
            let c = byte_cps(b);
            let mut any = false;
            for m in all_matches(pr, c, 0).iter() {
                if let Some(a) = grp(c, m, g_attrs) {
                    if a.len() > 0 and ascii_lower_str(a).contains("refresh") {
                        any = true;
                        break;
                    }
                }
            }
            if not any {
                return Ok(None);
            }
        }
    }
    let utext = to_unicode(w, text, encoding, if was_cut { "replace" } else { "strict" })?;
    let s = cps(utext);
    if re_search(w.rx.meta, s).is_none() {
        return Ok(None);
    }
    for m in all_matches(pr, s, 0).iter() {
        let attrs = match grp(s, m, g_attrs) {
            None => continue,
            Some(a) => a,
        };
        if not attrs.to_lowercase().contains("refresh") {
            continue;
        }
        if let Some(r) = refresh_of(w, attrs, baseurl, encoding)? {
            return Ok(Some(r));
        }
    }
    Ok(None)
}

fn strip_html5_whitespace(text: ref String) -> String {
    strip_by(text, html5_whitespace(), true, true)
}

// ---------------------------------------------------------------- w3lib.encoding

fn translate_encoding(c18n: ref String) -> String {
    let pairs: Vec[(Str, Str)] = vec![
        ("ascii", "cp1252"), ("big5", "big5hkscs"), ("euc_kr", "cp949"), ("gb2312", "gb18030"),
        ("gb_2312_80", "gb18030"), ("gbk", "gb18030"), ("iso8859_11", "cp874"), ("iso8859_9", "cp1254"),
        ("latin_1", "cp1252"), ("macintosh", "mac_roman"), ("shift_jis", "cp932"), ("tis_620", "cp874"),
        ("win_1251", "cp1251"), ("windows_31j", "cp932"), ("win_31j", "cp932"), ("windows_874", "cp874"),
        ("win_874", "cp874"), ("x_sjis", "cp932"), ("zh_cn", "gb18030"),
    ];
    for (k, v) in pairs.iter() {
        if c18n == *k {
            return v.to_string();
        }
    }
    c18n.clone()
}

fn resolve_encoding(w: ref W3, alias: ref String) -> Option[String] {
    let normed = normalize_encoding(alias).to_lowercase();
    let c18n = w.c.aliases.get(normed.clone()).cloned().unwrap_or(normed);
    match w.c.lookup(translate_encoding(c18n)) {
        Ok(name) => if name == "utf-7" { None } else { Some(name) },
        Err(_) => None,
    }
}

fn quoted_aware_charset(w: ref W3, ct: ref Vec[i64]) -> Option[String] {
    let pr = ref w.rx.header_param;
    for m in all_matches(pr, ct, 0).iter() {
        if gtext(pr, ct, m, "name").to_lowercase() != "charset" {
            continue;
        }
        let label = match gname(pr, ct, m, "quoted") {
            Some(q) => q,
            None => gtext(pr, ct, m, "token"),
        };
        if re_fullmatch(w.rx.label, cps(label)) {
            return resolve_encoding(w, label);
        }
    }
    None
}

fn http_content_type_encoding(w: ref W3, ct: ref Option[String]) -> Option[String] {
    let text = match ct {
        Some(t) => t.clone(),
        None => return None,
    };
    if text.len() == 0 {
        return None;
    }
    let c = cps(text);
    let pr = ref w.rx.header_enc;
    match re_search(pr, c) {
        None => None,
        Some(m) => {
            let mut k = 0;
            while k < m.start and c[k] != 34 {
                k += 1;
            }
            if k >= m.start {
                let g1 = grp(c, m, 1).unwrap_or(String.new());
                let label = if g1.len() > 0 { g1 } else { grp(c, m, 2).unwrap_or(String.new()) };
                return resolve_encoding(w, label);
            }
            quoted_aware_charset(w, c)
        }
    }
}

// str.lstrip() of whitespace.
fn py_lstrip(s: ref String) -> String {
    strip_by(s, "", true, false)
}

fn leading_label(w: ref W3, value: ref String) -> Option[String] {
    let c = cps(py_lstrip(value));
    match re_match(w.rx.label, c, 0) {
        Some(m) => Some(to_string(slice(c, m.start, m.end))),
        None => None,
    }
}

fn is_http_equiv(name: ref String) -> bool {
    name == "http-equiv" or name == "http_equiv" or name == "httpequiv"
}

fn meta_charset_label(w: ref W3, attrs: ref String) -> Option[String] {
    let mut has_pragma = false;
    let mut content_label: Option[String] = None;
    for (name, value) in iter_tag_attributes(w, attrs).iter() {
        if name == "charset" {
            if let Some(l) = leading_label(w, value) {
                if l.len() > 0 {
                    return Some(l);
                }
            }
        } else if name == "content" {
            if content_label.is_none() {
                let v = cps(value);
                if let Some(m) = re_search(w.rx.content_charset, v) {
                    content_label = Some(gtext(w.rx.content_charset, v, m, "label"));
                }
            }
        } else if is_http_equiv(name) and re_search(w.rx.pragma, cps(value)).is_some() {
            has_pragma = true;
        }
    }
    if has_pragma { content_label } else { None }
}

fn xml_encoding_label(w: ref W3, attrs: ref String) -> Option[String] {
    for (name, value) in iter_tag_attributes(w, attrs).iter() {
        if name == "encoding" {
            if let Some(l) = leading_label(w, value) {
                if l.len() > 0 {
                    return Some(l);
                }
            }
        }
    }
    None
}

fn html_body_declared_encoding(w: ref W3, body: ref V) -> Option[String] {
    let all = scan_cps(body);
    let chunk = slice(all, 0, if all.len() < 4096 { all.len() } else { 4096 });
    let pr = ref w.rx.body_scan;
    let g_body = gnum(pr, "body");
    let g_meta = gnum(pr, "meta");
    let g_xml = gnum(pr, "xml");
    for m in all_matches(pr, chunk, 0).iter() {
        if grp(chunk, m, g_body).is_some() {
            break;
        }
        let label = if let Some(attrs) = grp(chunk, m, g_meta) {
            if not attrs.to_lowercase().contains("charset") {
                continue;
            }
            meta_charset_label(w, attrs)
        } else if let Some(x) = grp(chunk, m, g_xml) {
            xml_encoding_label(w, x)
        } else {
            continue;
        };
        if let Some(l) = label {
            return resolve_encoding(w, l);
        }
    }
    None
}

fn read_bom(data: ref Vec[u8]) -> Option[(String, Vec[u8])] {
    let table: Vec[(Vec[u8], Str)] = vec![
        (vec![0u8, 0u8, 0xFEu8, 0xFFu8], "utf-32-be"),
        (vec![0xFFu8, 0xFEu8, 0u8, 0u8], "utf-32-le"),
        (vec![0xFEu8, 0xFFu8], "utf-16-be"),
        (vec![0xFFu8, 0xFEu8], "utf-16-le"),
        (vec![0xEFu8, 0xBBu8, 0xBFu8], "utf-8"),
    ];
    for (bom, name) in table.iter() {
        if bstarts(data, bom) {
            return Some((name.to_string(), bom.clone()));
        }
    }
    None
}

fn enc_to_unicode(w: ref W3, data: ref Vec[u8], encoding: ref String) -> Result[String, PyErr] {
    w.c.decode(data, encoding, "replace")
}

fn html_to_unicode(w: ref W3, ct: ref Option[String], body: ref Vec[u8], default: ref String) -> Result[(String, String), PyErr] {
    if let Some((enc, bom)) = read_bom(body) {
        let text = enc_to_unicode(w, bslice(body, bom.len(), body.len()), enc)?;
        return Ok((enc, text));
    }
    let mut enc = http_content_type_encoding(w, ct);
    if enc.is_none() {
        enc = html_body_declared_encoding(w, V.Bytes(body.clone()));
    }
    let name = match enc {
        None => default.clone(),
        Some(e) => if e == "utf-16" or e == "utf-32" { f"{e}-be" } else { e },
    };
    let text = enc_to_unicode(w, body, name)?;
    Ok((name, text))
}

// ---------------------------------------------------------------- w3lib.http

fn headers_raw_to_dict(raw: ref Vec[u8]) -> Vec[(Vec[u8], Vec[Vec[u8]])] {
    let mut out: Vec[(Vec[u8], Vec[Vec[u8]])] = Vec.new();
    let mut start = 0;
    while start < raw.len() {
        let nl = bfind_byte(raw, 10, start);
        let end = if nl < 0 { raw.len() } else { nl + 1 };
        let line = bslice(raw, start, end);
        start = end;
        let colon = bfind_byte(line, 58, 0);
        if colon < 0 {
            continue;
        }
        let key = bstrip(bslice(line, 0, colon));
        let value = bstrip(bslice(line, colon + 1, line.len()));
        let mut found = false;
        let mut k = 0;
        while k < out.len() {
            if beq(out[k].0, key) {
                out[k].1.push(value.clone());
                found = true;
                break;
            }
            k += 1;
        }
        if not found {
            out.push((key, vec![value]));
        }
    }
    out
}

fn headers_dict_to_raw(d: ref Vec[(V, V)]) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for (k, v) in d.iter() {
        let key = match k {
            V.Bytes(b) => b.clone(),
            _ => Vec.new(),
        };
        let mut values: Vec[Vec[u8]] = Vec.new();
        match v {
            V.Bytes(b) => values.push(b.clone()),
            V.Tuple(xs) => {
                for x in xs.iter() {
                    if let V.Bytes(b) = x {
                        values.push(b.clone());
                    }
                }
            }
            _ => {}
        }
        for val in values.iter() {
            if out.len() > 0 {
                out.push(13);
                out.push(10);
            }
            bpush(mut out, key);
            out.push(58);
            out.push(32);
            bpush(mut out, val);
        }
    }
    out
}

fn basic_auth_header(w: ref W3, user: ref V, password: ref V, encoding: ref String) -> Result[Vec[u8], PyErr] {
    let u = to_unicode(w, user, "utf-8".to_string(), "strict")?;
    let p = to_unicode(w, password, "utf-8".to_string(), "strict")?;
    let raw = w.c.encode(f"{u}:{p}", encoding)?;
    let mut out = bytes_lit("Basic ");
    bpush(mut out, b64encode(raw));
    Ok(out)
}

// ---------------------------------------------------------------- the jobs

struct JobArgs {
    pos: Vec[V],
    kw: Vec[(String, V)],
}

impl JobArgs {
    // The argument bound to a parameter, by position or by keyword.
    fn get(ref self, i: i64, name: Str) -> Option[V] {
        if i >= 0 and i < self.pos.len() {
            return Some(self.pos[i].clone());
        }
        for (k, v) in self.kw.iter() {
            if k == name {
                return Some(v.clone());
            }
        }
        None
    }

    fn v(ref self, i: i64, name: Str) -> V {
        self.get(i, name).unwrap_or(V.None)
    }

    fn s(ref self, i: i64, name: Str, default: Str) -> String {
        match self.get(i, name) {
            Some(V.Str(s)) => s,
            Some(V.Bytes(b)) => utf8_str(b),
            _ => default.to_string(),
        }
    }

    // A str parameter whose default is None.
    fn opt_s(ref self, i: i64, name: Str) -> Option[String] {
        match self.get(i, name) {
            Some(V.Str(s)) => Some(s),
            _ => None,
        }
    }

    fn b(ref self, i: i64, name: Str, default: bool) -> bool {
        match self.get(i, name) {
            Some(V.Bool(b)) => b,
            Some(V.Int(n)) => n != 0,
            Some(V.None) => false,
            Some(_) => true,
            None => default,
        }
    }

    fn opt_i(ref self, i: i64, name: Str) -> Option[i64] {
        match self.get(i, name) {
            Some(V.Int(n)) => Some(n),
            _ => None,
        }
    }

    // A sequence of str (a lone str counts as one).
    fn strs(ref self, i: i64, name: Str, default: ref Vec[String]) -> Vec[String] {
        match self.get(i, name) {
            Some(V.Tuple(xs)) => {
                let mut out: Vec[String] = Vec.new();
                for x in xs.iter() {
                    if let V.Str(s) = x {
                        out.push(s.clone());
                    }
                }
                out
            }
            Some(V.Str(s)) => if s.len() > 0 { vec![s] } else { Vec.new() },
            _ => default.clone(),
        }
    }
}

fn repr_opt(w: ref W3, s: ref Option[String]) -> String {
    match s {
        Some(t) => w.u.repr(t),
        None => "None".to_string(),
    }
}

fn str_or_bytes_repr(w: ref W3, v: ref V) -> String {
    match v {
        V.Bytes(b) => bytes_repr(b),
        V.Str(s) => w.u.repr(s),
        _ => "None".to_string(),
    }
}

fn refresh_repr(w: ref W3, r: ref Option[(f64, String)]) -> String {
    match r {
        Some((i, u)) => f"({i}, {w.u.repr(u)})",
        None => "(None, None)".to_string(),
    }
}

fn pairs_bytes(d: ref V) -> Vec[(Vec[u8], Vec[u8])] {
    let mut out: Vec[(Vec[u8], Vec[u8])] = Vec.new();
    if let V.Dict(items) = d {
        for (k, v) in items.iter() {
            if let (V.Str(a), V.Str(b)) = (k, v) {
                out.push((bytes_of(a), bytes_of(b)));
            }
        }
    }
    out
}

fn job(w: ref W3, f: ref String, a: ref JobArgs) -> Result[String, PyErr] {
    let none: Vec[String] = Vec.new();
    // w3lib.url
    if f == "safe_url_string" {
        return Ok(w.u.repr(safe_url_string(w, a.v(0, "url"), a.s(1, "encoding", "utf8"), a.s(2, "path_encoding", "utf8"), a.b(3, "quote_path", true))?));
    }
    if f == "safe_download_url" {
        return Ok(w.u.repr(safe_download_url(w, a.v(0, "url"), a.s(1, "encoding", "utf8"), a.s(2, "path_encoding", "utf8"))?));
    }
    if f == "is_url" {
        return Ok(py_bool(is_url(a.s(0, "text", ""))));
    }
    if f == "url_query_parameter" {
        let r = url_query_parameter(w, a.v(0, "url"), a.s(1, "parameter", ""), a.opt_s(2, "default"), a.b(3, "keep_blank_values", false), a.s(-1, "separator", "&"))?;
        return Ok(repr_opt(w, r));
    }
    if f == "url_query_cleaner" {
        let url = to_unicode(w, a.v(0, "url"), "utf-8".to_string(), "strict")?;
        let r = url_query_cleaner(url, a.strs(1, "parameterlist", none), a.s(2, "sep", "&"), a.s(3, "kvsep", "="), a.b(4, "remove", false), a.b(5, "unique", true), a.b(6, "keep_fragments", false));
        return Ok(w.u.repr(r));
    }
    if f == "add_or_replace_parameter" {
        let params = vec![(bytes_of(a.s(1, "name", "")), bytes_of(a.s(2, "new_value", "")))];
        return Ok(w.u.repr(add_or_replace_parameters(w, a.s(0, "url", ""), params, a.s(-1, "separator", "&"))?));
    }
    if f == "add_or_replace_parameters" {
        let params = pairs_bytes(a.v(1, "new_parameters"));
        return Ok(w.u.repr(add_or_replace_parameters(w, a.s(0, "url", ""), params, a.s(-1, "separator", "&"))?));
    }
    if f == "path_to_file_uri" {
        return Ok(w.u.repr(path_to_file_uri(a.s(0, "path", ""))));
    }
    if f == "file_uri_to_path" {
        return Ok(w.u.repr(file_uri_to_path(w, a.s(0, "uri", ""))?));
    }
    if f == "any_to_uri" {
        return Ok(w.u.repr(any_to_uri(w, a.s(0, "uri_or_path", ""))?));
    }
    if f == "add_http_if_no_scheme" {
        return Ok(w.u.repr(add_http_if_no_scheme(w, a.s(0, "url", ""))?));
    }
    if f == "parse_data_uri" {
        return Ok(data_uri_repr(w, parse_data_uri(w, a.v(0, "uri"))?));
    }
    if f == "canonicalize_url" {
        let enc = a.opt_s(3, "encoding").unwrap_or(String.new());
        return Ok(w.u.repr(canonicalize_url(w, a.v(0, "url"), a.b(1, "keep_blank_values", true), a.b(2, "keep_fragments", false), enc, a.s(-1, "query_separator", "&"))?));
    }
    if f == "parse_url" {
        let text = to_unicode(w, a.v(0, "url"), a.opt_s(1, "encoding").unwrap_or(String.new()), "strict")?;
        return Ok(parsed_repr(w.u, w3_urlparse(w, text)?));
    }
    if f == "parse_qsl_to_bytes" {
        let qs = a.s(0, "qs", "");
        let r = parse_qsl(bytes_of(qs), a.b(1, "keep_blank_values", false), bytes_of(a.s(-1, "separator", "&")));
        let mut items: Vec[String] = Vec.new();
        for (k, v) in r.iter() {
            items.push(f"({bytes_repr(k)}, {bytes_repr(v)})");
        }
        return Ok(f"[{join_strs(items, ", ")}]");
    }
    // w3lib.html
    if f == "replace_entities" {
        return Ok(w.u.repr(replace_entities(w, a.v(0, "text"), a.strs(1, "keep", none), a.b(2, "remove_illegal", true), a.s(3, "encoding", "utf-8"))?));
    }
    if f == "has_entities" {
        return Ok(py_bool(has_entities(w, a.v(0, "text"), a.s(1, "encoding", ""))?));
    }
    if f == "replace_tags" {
        return Ok(w.u.repr(replace_tags(w, a.v(0, "text"), a.s(1, "token", ""), a.s(2, "encoding", ""))?));
    }
    if f == "remove_comments" {
        return Ok(w.u.repr(remove_comments(w, a.v(0, "text"), a.s(1, "encoding", ""))?));
    }
    if f == "remove_tags" {
        return Ok(w.u.repr(remove_tags(w, a.v(0, "text"), a.strs(1, "which_ones", none), a.strs(2, "keep", none), a.s(3, "encoding", ""))?));
    }
    if f == "remove_tags_with_content" {
        return Ok(w.u.repr(remove_tags_with_content(w, a.v(0, "text"), a.strs(1, "which_ones", none), a.s(2, "encoding", ""))?));
    }
    if f == "replace_escape_chars" {
        let defaults: Vec[String] = vec!["\n".to_string(), "\t".to_string(), "\r".to_string()];
        let by = a.get(2, "replace_by").unwrap_or(V.Str(String.new()));
        return Ok(w.u.repr(replace_escape_chars(w, a.v(0, "text"), a.strs(1, "which_ones", defaults), by, a.s(3, "encoding", ""))?));
    }
    if f == "unquote_markup" {
        return Ok(w.u.repr(unquote_markup(w, a.v(0, "text"), a.strs(1, "keep", none), a.b(2, "remove_illegal", true), a.s(3, "encoding", ""))?));
    }
    if f == "get_base_url" {
        let base = a.get(1, "baseurl").unwrap_or(V.Str(String.new()));
        return Ok(w.u.repr(get_base_url(w, a.v(0, "text"), base, a.s(2, "encoding", "utf-8"), a.opt_i(-1, "max_scan"))?));
    }
    if f == "get_meta_refresh" {
        let ns: Vec[String] = vec!["script".to_string(), "noscript".to_string()];
        let r = get_meta_refresh(w, a.v(0, "text"), a.s(1, "baseurl", ""), a.s(2, "encoding", "utf-8"), a.strs(3, "ignore_tags", ns), a.opt_i(-1, "max_scan"))?;
        return Ok(refresh_repr(w, r));
    }
    if f == "strip_html5_whitespace" {
        return Ok(w.u.repr(strip_html5_whitespace(a.s(0, "text", ""))));
    }
    // w3lib.encoding
    if f == "read_bom" {
        if let V.Bytes(b) = a.v(0, "data") {
            return Ok(match read_bom(b) {
                Some((e, bom)) => f"({w.u.repr(e)}, {bytes_repr(bom)})",
                None => "(None, None)".to_string(),
            });
        }
    }
    if f == "resolve_encoding" {
        return Ok(repr_opt(w, resolve_encoding(w, a.s(0, "encoding_alias", ""))));
    }
    if f == "http_content_type_encoding" {
        return Ok(repr_opt(w, http_content_type_encoding(w, a.opt_s(0, "content_type"))));
    }
    if f == "html_body_declared_encoding" {
        return Ok(repr_opt(w, html_body_declared_encoding(w, a.v(0, "html_body_str"))));
    }
    if f == "to_unicode" {
        if let V.Bytes(b) = a.v(0, "data_str") {
            return Ok(w.u.repr(enc_to_unicode(w, b, a.s(1, "encoding", ""))?));
        }
    }
    if f == "html_to_unicode" {
        if let V.Bytes(b) = a.v(1, "html_body_str") {
            let (e, t) = html_to_unicode(w, a.opt_s(0, "content_type_header"), b, a.s(2, "default_encoding", "utf8"))?;
            return Ok(f"({w.u.repr(e)}, {w.u.repr(t)})");
        }
    }
    // w3lib.http
    if f == "headers_raw_to_dict" {
        return Ok(match a.v(0, "headers_raw") {
            V.Bytes(b) => headers_repr(headers_raw_to_dict(b)),
            _ => "None".to_string(),
        });
    }
    if f == "headers_dict_to_raw" {
        return Ok(match a.v(0, "headers_dict") {
            V.Dict(items) => bytes_repr(headers_dict_to_raw(items)),
            _ => "None".to_string(),
        });
    }
    if f == "basic_auth_header" {
        return Ok(bytes_repr(basic_auth_header(w, a.v(0, "username"), a.v(1, "password"), a.s(2, "encoding", "ISO-8859-1"))?));
    }
    Err(py_err("TypeError", f"no job {f}"))
}

fn headers_repr(d: ref Vec[(Vec[u8], Vec[Vec[u8]])]) -> String {
    let mut items: Vec[String] = Vec.new();
    for (k, vs) in d.iter() {
        let mut vals: Vec[String] = Vec.new();
        for v in vs.iter() {
            vals.push(bytes_repr(v));
        }
        items.push(f"{bytes_repr(k)}: [{join_strs(vals, ", ")}]");
    }
    f"{{{join_strs(items, ", ")}}}"
}

fn args_of(j: ref J) -> JobArgs {
    let mut pos: Vec[V] = Vec.new();
    if let J.Arr(xs) = jget(j, "a") {
        for x in xs.iter() {
            pos.push(to_v(x));
        }
    }
    let mut kw: Vec[(String, V)] = Vec.new();
    if let J.Obj(items) = jget(j, "k") {
        for (k, x) in items.iter() {
            kw.push((k.clone(), to_v(x)));
        }
    }
    JobArgs { pos: pos, kw: kw }
}

fn jtext(j: ref J, key: Str) -> String {
    match jget(j, key) {
        J.Text(s) => s,
        _ => String.new(),
    }
}

// ---------------------------------------------------------------- the crawl

fn tracking() -> Vec[String] {
    vec!["utm_source".to_string(), "utm_medium".to_string(), "utm_campaign".to_string(), "ref".to_string()]
}

fn header_first(h: ref Vec[(Vec[u8], Vec[Vec[u8]])], name: Str) -> Option[String] {
    let want = bytes_lit(name);
    for (k, vs) in h.iter() {
        if beq(k, want) {
            // .decode("latin-1")
            let mut s = String.new();
            for b in vs[0].iter() {
                s.push(b as char);
            }
            return Some(s);
        }
    }
    None
}

fn canon(w: ref W3, url: ref String) -> Result[String, PyErr] {
    canonicalize_url(w, V.Str(url.clone()), true, false, String.new(), "&".to_string())
}

fn params_repr(w: ref W3, d: ref DataUri) -> String {
    let mut items: Vec[String] = Vec.new();
    for (k, v) in d.params.iter() {
        items.push(f"{w.u.repr(k)}: {w.u.repr(v)}");
    }
    f"{{{join_strs(items, ", ")}}}"
}

fn crawl(w: ref W3) -> Result[(), PyErr] {
    let index = match fs.read_to_string("data/site/index.tsv".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(py_err("OSError", f"cannot read index.tsv: {e}")),
    };
    let mut site: Vec[(String, String)] = Vec.new();
    for line in index.lines() {
        if let Some((url, name)) = line.split_once("\t") {
            site.push((canon(w, url.to_string())?, name.to_string()));
        }
    }
    let start = "http://shop.example/".to_string();
    let mut queue: Vec[String] = vec![start.clone()];
    let mut seen: Vec[String] = vec![canon(w, start)?];
    let mut head_q = 0;
    let mut fetched = 0;
    let none: Vec[String] = Vec.new();
    let ss: Vec[String] = vec!["script".to_string(), "style".to_string()];
    let ns: Vec[String] = vec!["script".to_string(), "noscript".to_string()];
    while head_q < queue.len() {
        let url = queue[head_q].clone();
        head_q += 1;
        let key = canon(w, url)?;
        println(f"GET {url}");
        let mut file = String.new();
        for (k, n) in site.iter() {
            if k == key {
                file = n.clone();
            }
        }
        if file.len() == 0 {
            println("   404 not in the site");
            continue;
        }
        let raw = match fs.read_bytes(f"data/site/{file}") {
            Ok(b) => b,
            Err(e) => return Err(py_err("OSError", f"cannot read {file}: {e}")),
        };
        let sep = bytes_lit("\r\n\r\n");
        let hb = bfind(raw, sep, 0);
        let head = if hb < 0 { raw.clone() } else { bslice(raw, 0, hb) };
        let body = if hb < 0 { Vec.new() } else { bslice(raw, hb + 4, raw.len()) };
        let crlf = bytes_lit("\r\n");
        let sl = bfind(head, crlf, 0);
        let status_line = if sl < 0 { head.clone() } else { bslice(head, 0, sl) };
        let rest = if sl < 0 { Vec.new() } else { bslice(head, sl + 2, head.len()) };
        let headers = headers_raw_to_dict(rest);
        let status = digits_int(utf8_str(bsplit(status_line, bytes_lit(" "))[1]));
        fetched += 1;
        if status == 401 {
            let auth = basic_auth_header(w, V.Str("admin".to_string()), V.Str("pässwort".to_string()), "ISO-8859-1".to_string())?;
            println(f"   401 {header_first(headers, "WWW-Authenticate").unwrap_or(String.new())}; would retry with Authorization: {utf8_str(auth)}");
            continue;
        }
        let ct = header_first(headers, "Content-Type");
        let (enc, text) = html_to_unicode(w, ct, body, "utf8".to_string())?;
        let tc = cps(text);
        let title = match re_search(w.rx.title, tc) {
            Some(m) => {
                let inner = grp(tc, m, 1).unwrap_or(String.new());
                let plain = remove_tags_str(w, inner, none, none);
                Some(py_strip(replace_entities_str(w, plain, none, true)))
            }
            None => None,
        };
        let page = V.Str(text.clone());
        let base = get_base_url(w, page, V.Str(url.clone()), "utf-8".to_string(), None)?;
        let refresh = get_meta_refresh(w, page, url, "utf-8".to_string(), ns, None)?;
        println(f"   {status} encoding={enc} title={repr_opt(w, title)}");
        if base != url {
            println(f"   base {base}");
        }
        let mut targets: Vec[String] = Vec.new();
        if let Some((interval, to)) = refresh {
            println(f"   refresh after {interval}s to {to}");
            targets.push(to);
        }
        let visible = re_sub_text(w.rx.script_style, re_sub_text(w.rx.comments, text, String.new()), String.new());
        let vc = cps(visible);
        for m in all_matches(w.rx.href, vc, 0).iter() {
            let mut t = String.new();
            let mut g = 1;
            while g <= 3 {
                let v = grp(vc, m, g).unwrap_or(String.new());
                if v.len() > 0 {
                    t = v;
                    break;
                }
                g += 1;
            }
            targets.push(t);
        }
        for m in all_matches(w.rx.img, vc, 0).iter() {
            let src = grp(vc, m, 1).unwrap_or(String.new());
            if src.starts_with("data:") {
                let r = parse_data_uri(w, V.Str(src))?;
                println(f"   inline {r.media_type} {params_repr(w, r)} {bytes_repr(r.data)}");
            }
        }
        for t in targets.iter() {
            let href = strip_html5_whitespace(replace_entities_str(w, t, none, true));
            let (scheme, _, _) = partition(href, ":");
            let low = scheme.to_lowercase();
            if low == "mailto" or low == "javascript" or low == "data" {
                println(f"   skip {w.u.repr(href)}");
                continue;
            }
            let joined = urljoin(w.u, base, href)?;
            let mut absolute = url_query_cleaner(joined, tracking(), "&".to_string(), "=".to_string(), true, true, false);
            if absolute.contains("/files/") or absolute.contains("/etc/") {
                absolute = safe_download_url(w, V.Str(absolute), "utf8".to_string(), "utf8".to_string())?;
            }
            let c = canon(w, absolute)?;
            let host = w3_urlparse(w, c)?.netloc;
            if host != "shop.example" {
                println(f"   offsite {c}");
            } else if has(seen, c) {
                println(f"   seen {c}");
            } else {
                println(f"   new {c}");
                seen.push(c.clone());
                queue.push(c);
            }
        }
    }
    println(f"fetched {fetched} pages, {seen.len()} urls seen");
    Ok(())
}

// ---------------------------------------------------------------- main

fn write_data() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data/site".to_string()) {
        return Err(f"cannot create data/site: {e}");
    }
    for (name, text, is_hex) in data_files().into_iter() {
        let path = f"data/{name}";
        let bytes = if is_hex { unhex(text) } else { bytes_of(text) };
        if let Err(e) = fs.write_bytes(path.clone(), bytes) {
            return Err(f"cannot write {path}: {e}");
        }
    }
    Ok(())
}

fn load_entities() -> Map[String, i64] {
    let mut m: Map[String, i64] = Map.new();
    for line in entity_table().lines() {
        if let Some((name, hex)) = line.split_once(" ") {
            m.insert(name.to_string(), hex_value(hex));
        }
    }
    m
}

fn run() -> Result[(), String] {
    write_data()?;
    let w = W3 {
        u: load_uni(unicode_table()),
        c: load_codecs(codec_registry(), charmap_tables()),
        ents: load_entities(),
        rx: load_rxs(),
    };
    let jobs = match fs.read_to_string("data/jobs.jsonl".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/jobs.jsonl: {e}"),
    };
    let mut n = 0;
    for line in jobs.lines() {
        let j = parse_json(line.to_string());
        let f = jtext(j, "f");
        let a = args_of(j);
        match job(w, f, a) {
            Ok(r) => println(f"{n} {f}: {r}"),
            Err(e) => println(f"{n} {f}: raised {e.kind}: {e.msg}"),
        }
        n += 1;
    }
    if let Err(e) = crawl(w) {
        return Err(f"{e.kind}: {e.msg}");
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"error: {e}");
    }
}

