    let mut t = String.new();
    t.push_str("{\"file\": \"02.eml\", \"part\": 0, \"ops\": [[\"get_param\", \"boundary\", {}], [\"get_params\", {}], [\"set_param\", \"charset\", \"utf-8\", {}], [\"get_params\", {}], [\"set_boundary\", \"new-b\"], [\"get_boundary\"]]}\n");
