    t.push_str("{\"file\": \"03.eml\", \"part\": 4, \"ops\": [[\"get_filename\"], [\"get_param\", \"filename\", {\"header\": \"content-disposition\"}], [\"get_param\", \"filename\", {\"header\": \"content-disposition\", \"unquote\": false}], [\"get_params\", {\"header\": \"content-disposition\"}], [\"set_param\", \"filename\", \"Résumé.pdf\", {\"header\": \"Content-Disposition\"}], [\"get_filename\"], [\"set_param\", \"filename\", \"plain.pdf\", {\"header\": \"Content-Disposition\", \"charset\": \"utf-8\", \"language\": \"en\"}], [\"get_filename\"]]}\n");
