    t.push_str("{\"file\": \"15.eml\", \"part\": 2, \"ops\": [[\"get_params\", {}], [\"get_params\", {\"unquote\": false}], [\"get_content_charset\"], [\"get_param\", \"name\", {}], [\"get_filename\"]]}\n");
    t.push_str("{\"file\": \"15.eml\", \"part\": 3, \"ops\": [[\"get_params\", {}], [\"get_param\", \"flag\", {}], [\"get_param\", \"empty\", {}], [\"get_param\", \"note\", {}], [\"set_param\", \"x\", \"2\", {}], [\"del_param\", \"flag\", {}], [\"del_param\", \"missing\", {}]]}\n");
    t.push_str("{\"file\": \"15.eml\", \"part\": 4, \"ops\": [[\"get_params\", {}], [\"get_content_charset\"], [\"get_param\", \"title\", {}], [\"set_param\", \"title\", \"new\", {}]]}\n");
    t.push_str("{\"file\": \"15.eml\", \"part\": 5, \"ops\": [[\"get_filename\"], [\"get_content_disposition\"], [\"get_param\", \"name\", {}]]}\n");
    t.push_str("{\"file\": \"01.eml\", \"part\": 0, \"ops\": [[\"get_all\", \"received\"], [\"replace_header\", \"subject\", \"Short\"], [\"replace_header\", \"x-missing\", \"v\"], [\"add_header\", \"Content-Disposition\", \"attachment\", {\"filename\": \"a b.txt\"}], [\"add_header\", \"X-Flags\", null, {\"seen\": null, \"size\": \"10\"}], [\"add_header\", \"Content-Disposition\", \"inline\", {\"filename\": [\"iso-8859-1\", \"fr\", \"été.txt\"]}], [\"add_header\", \"Content-Disposition\", \"inline\", {\"filename\": \"Grüße.txt\"}], [\"set\", \"X-New\", \"Grüße\"], [\"del\", \"received\"], [\"get_all\", \"received\"], [\"get_all\", \"content-disposition\"], [\"set_param\", \"charset\", \"utf-8\", {}], [\"get_content_type\"], [\"set_type\", \"nonsense\"], [\"set_type\", \"text/x-note\"]]}\n");
    t.push_str("{\"file\": \"10.eml\", \"part\": 0, \"ops\": [[\"set_boundary\", \"x\"], [\"del_param\", \"charset\", {}], [\"set_param\", \"a\", \"b\", {\"header\": \"X-Custom\"}], [\"set_param\", \"a\", \"c\", {\"header\": \"X-Custom\"}], [\"get\", \"x-custom\"], [\"get\", \"x-empty\"], [\"get\", \"x-folded\"], [\"get_content_type\"]]}\n");
    t.push_str("{\"file\": \"12.eml\", \"part\": 0, \"ops\": [[\"get_content_charset\"], [\"set_param\", \"charset\", \"iso-8859-1\", {}], [\"get_charsets\"], [\"set\", \"Subject\", \"second\"], [\"get_all\", \"subject\"]]}\n");
