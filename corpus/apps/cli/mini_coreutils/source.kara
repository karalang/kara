    s.push_str("od\t-A\tx\t-t\tx1\tempty.txt\n");
    s.push_str("printf\t%s\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab\t\x1d\tod\t-A\td\t-c\n");
    s.push_str("printf\t%s\taaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab\t\x1d\tod\t-A\td\t-v\t-c\n");
    s.push_str("od\t-t\tx8\theader.bin\n");
    s.push_str("od\t-t\tq1\theader.bin\n");
    s.push_str("base64\tsecret.txt\n");
    s.push_str("base64\t-w\t16\tsecret.txt\n");
    s.push_str("base64\t-w\t0\tsecret.txt\n");
    s.push_str("base64\t-d\ttoken.b64\n");
    s.push_str("base64\t-d\twrapped.b64\n");
    s.push_str("printf\t%s\ta\t\x1d\tbase64\n");
    s.push_str("printf\t%s\tab\t\x1d\tbase64\t\x1d\tbase64\t-d\n");
    s.push_str("base64\t-d\tbad.b64\n");
    s.push_str("base64\tmissing.txt\n");
    s.push_str("fold\t-w\t30\tstory.txt\n");
    s.push_str("fold\t-s\t-w\t30\tstory.txt\n");
    s.push_str("fold\t-w\t20\tnotes.txt\n");
    s.push_str("fold\t-b\t-w\t20\tnotes.txt\n");
    s.push_str("fold\t-w\t0\tstory.txt\n");
    s.push_str("expand\tnotes.txt\n");
    s.push_str("expand\t-t\t4\tnotes.txt\n");
    s.push_str("expand\t-t\t8,14,20\tnotes.txt\n");
    s.push_str("expand\t-i\t-t\t2\tindent.txt\n");
    s.push_str("unexpand\tindent.txt\n");
    s.push_str("unexpand\t-a\tindent.txt\n");
    s.push_str("unexpand\t-t\t4\tindent.txt\n");
    s.push_str("expand\tnotes.txt\t\x1d\tunexpand\t-a\n");
    s.push_str("factor\t12\t97\t1\t0\t360\t1001\t65536\n");
    s.push_str("factor\t600851475143\t9999999967\t4294967297\n");
    s.push_str("printf\t%s\\n\t84 91\t  1024\x0b77\t\x1d\tfactor\n");
    s.push_str("factor\t12\tx9\t15\n");
    s.push_str("seq\t2\t12\t\x1d\tfactor\n");
    s
}

// Each input file's path under data/, and its text.
fn data_files() -> Vec[(String, String)] {
    let mut v: Vec[(String, String)] = Vec.new();
    v.push(("bad.b64".to_string(), file_0()));
    v.push(("conf.d/app.conf".to_string(), file_1()));
    v.push(("empty.txt".to_string(), file_2()));
    v.push(("header.bin".to_string(), file_3()));
    v.push(("indent.txt".to_string(), file_4()));
    v.push(("notes.txt".to_string(), file_5()));
    v.push(("ports.txt".to_string(), file_6()));
    v.push(("secret.txt".to_string(), file_7()));
    v.push(("story.txt".to_string(), file_8()));
    v.push(("token.b64".to_string(), file_9()));
    v.push(("wrapped.b64".to_string(), file_10()));
    v.push(("../jobs.tsv".to_string(), file_11()));
    v
}

// ------------------------------------------------------------ the run

fn write_data() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data/conf.d".to_string()) {
        return Err(f"cannot create data: {e}");
    }
    let files = data_files();
    for i in 0..files.len() {
        let (name, text) = files[i].clone();
        let path = f"data/{name}";
        if let Err(e) = fs.write(path.clone(), text) {
            return Err(f"cannot write {path}: {e}");
        }
    }
    Ok(())
}

// Runs one stage: `argv[0]` is the tool, `stdin` what the previous
// stage printed.
fn run_tool(argv: ref Vec[String], stdin: Str, dir: Str) -> Io {
    let tool = argv[0].clone();
    let mut args: Vec[String] = Vec.new();
    for i in 1..argv.len() {
        args.push(argv[i].clone());
    }
    if tool == "printf" {
        printf_tool(args)
    } else if tool == "expr" {
        expr_tool(args)
    } else if tool == "seq" {
        seq_tool(args)
    } else if tool == "test" {
        test_tool(args, dir)
    } else if tool == "basename" {
        basename_tool(args)
    } else if tool == "dirname" {
        dirname_tool(args)
    } else if tool == "od" {
        od_tool(args, stdin, dir)
    } else if tool == "base64" {
        base64_tool(args, stdin, dir)
    } else if tool == "fold" {
        fold_tool(args, stdin, dir)
    } else if tool == "expand" {
        expand_tool(args, stdin, dir)
    } else if tool == "unexpand" {
        unexpand_tool(args, stdin, dir)
    } else if tool == "factor" {
        factor_tool(args, stdin)
    } else if tool == "cat" {
        cat_tool(args, stdin, dir)
    } else {
        fail("sh", f"{tool}: command not found", 127)
    }
}

// An argument as a shell would need it written.
fn quote(a: Str) -> String {
    let b = a.bytes();
    let mut plain = b.len() > 0;
    for i in 0..b.len() {
        let c = b[i];
        let ok = is_alpha(c) or is_digit(c) or c == b'_' or c == b'.' or c == b'/' or c == b'=' or c == b'+' or c == b':' or c == b',' or c == b'%' or c == b'@' or c == b'-';
        if not ok {
            plain = false;
        }
    }
    if plain {
        return a.to_string();
    }
    let mut out: Vec[u8] = Vec.new();
    out.push(b'\'');
    for i in 0..b.len() {
        if b[i] == b'\'' {
            push_bytes(mut out, "'\\''");
        } else {
            out.push(b[i]);
        }
    }
    out.push(b'\'');
    from_bytes(out)
}

// Prints text, marking a missing final newline.
fn show(text: Str) {
    print(text);
    if text.len() > 0 and not text.ends_with("\n") {
        println("[no newline at end]");
    }
}

// A job line's arguments: tab-separated, a vertical tab standing for a
// tab inside one.
fn job_args(line: Str) -> Vec[String] {
    let b = to_bytes(line);
    let mut out: Vec[String] = Vec.new();
    let mut cur: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        if b[i] == b'\t' {
            out.push(from_bytes(cur));
            cur = Vec.new();
        } else if b[i] == 11 {
            cur.push(b'\t');
        } else {
            cur.push(b[i]);
        }
    }
    out.push(from_bytes(cur));
    out
}

// The stage separator in a job line.
const PIPE: u8 = 29;

fn run() -> Result[(), String] {
    write_data()?;
    let jobs = match fs.read_to_string("jobs.tsv".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read jobs.tsv: {e}"),
    };
    let lines = lines_of(jobs);
    for j in 0..lines.len() {
        let args = job_args(lines[j]);
        let mut shown = String.new();
        let mut stages: Vec[Vec[String]] = Vec.new();
        let mut cur: Vec[String] = Vec.new();
        for k in 0..args.len() {
            if k > 0 {
                shown.push_str(" ");
            }
            let b = to_bytes(args[k]);
            if b.len() == 1 and b[0] == PIPE {
                shown.push_str("|");
                stages.push(cur);
                cur = Vec.new();
            } else {
                shown.push_str(quote(args[k]));
                cur.push(args[k].clone());
            }
        }
        stages.push(cur);
        println(f"$ {shown}");
        let mut data = String.new();
        let mut errs: Vec[String] = Vec.new();
        let mut status: i64 = 0;
        for s in 0..stages.len() {
            let res = run_tool(stages[s], data, "data");
            data = res.out;
            errs.push(res.err);
            status = res.status;
        }
        show(data);
        for e in 0..errs.len() {
            show(errs[e]);
        }
        if status != 0 {
            println(f"[exit {status}]");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_coreutils: {e}");
    }
}
