== tokens | (?P<num>\d+)|(?P<word>[a-z]+)|(?P<other>.) | - | ab12+c
  1 word 'ab' lastindex=2
  1 num '12' lastindex=1
  1 other '+' lastindex=3
  1 word 'c' lastindex=2
== search | (a+)+b | - | aaaaaaaaaaaaaaaaaaaaab
  span=(0, 22) match='aaaaaaaaaaaaaaaaaaaaab'
  groups=('aaaaaaaaaaaaaaaaaaaaa',)
  spans=[(0, 21)]
== search | (x+x+)+y | - | xxxxxxxxxxy
  span=(0, 11) match='xxxxxxxxxxy'
  groups=('xxxxxxxxxx',)
  spans=[(0, 10)]
== search | ^(\w+\s?)*$ | - | a few words here
  span=(0, 16) match='a few words here'
  groups=('here',)
  spans=[(12, 16)]
== fullmatch | (?:\d+\.){3}\d+ | - | 192.168.0.1
  span=(0, 11) match='192.168.0.1'
== fullmatch | [A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,} | - | first.last+tag@sub.example.co
  span=(0, 29) match='first.last+tag@sub.example.co'
== fullmatch | (?:[01]\d|2[0-3]):[0-5]\d(?::[0-5]\d)? | - | 23:59:60
  None
== fullmatch | (?:[01]\d|2[0-3]):[0-5]\d(?::[0-5]\d)? | - | 07:05
  span=(0, 5) match='07:05'
== fullmatch | v?(\d+)\.(\d+)\.(\d+)(?:-([\w.]+))?(?:\+([\w.]+))? | - | v1.2.3-rc.1+build.5
  span=(0, 19) match='v1.2.3-rc.1+build.5'
  groups=('1', '2', '3', 'rc.1', 'build.5')
  spans=[(1, 2), (3, 4), (5, 6), (7, 11), (12, 19)]
== compile | (a)(?P<n>b)(?:c)(d) | - | 
  groups=3 groupindex={'n': 2}
== compile | *a | - | 
  error: nothing to repeat at position 0
== compile | a** | - | 
  error: multiple repeat at position 2
== compile | a{2}{3} | - | 
  error: multiple repeat at position 4
== compile | a(? | - | 
  error: unexpected end of pattern at position 3
== compile | (a | - | 
  error: missing ), unterminated subpattern at position 0
== compile | a) | - | 
  error: unbalanced parenthesis at position 1
== compile | [a | - | 
  error: unterminated character set at position 0
== compile | [z-a] | - | 
  error: bad character range z-a at position 1
== compile | a\q | - | 
  error: bad escape \q at position 1
== compile | \2(a) | - | 
  error: invalid group reference 2 at position 1
== compile | (a\1) | - | 
  error: cannot refer to an open group at position 2
== compile | (?P<1a>x) | - | 
  error: bad character in group name '1a' at position 4
== compile | (?P<a>x)(?P<a>y) | - | 
  error: redefinition of group name 'a' as group 2; was group 1 at position 12
== compile | (?P=b) | - | 
  error: unknown group name 'b' at position 4
== compile | (?P<a>x | - | 
  error: missing ), unterminated subpattern at position 0
== compile | (?<x>a) | - | 
  error: unknown extension ?<x at position 1
== compile | (?Px) | - | 
  error: unknown extension ?Px at position 1
== compile | (?<=a+)b | - | 
  error: look-behind requires fixed-width pattern
== compile | (?<=a|bc)d | - | 
  error: look-behind requires fixed-width pattern
== compile | a{3,2} | - | 
  error: min repeat greater than max repeat at position 2
== compile | x(?i)y | - | 
  error: global flags not at the start of the expression at position 1
== compile | (?z) | - | 
  error: unknown extension ?z at position 1
== compile | \x4 | - | 
  error: incomplete escape \x4 at position 0
== compile | \u12 | - | 
  error: incomplete escape \u12 at position 0
== compile | [\d-z] | - | 
  error: bad character range \d-z at position 1
== compile | (?(2)a|b)(x) | - | 
  error: invalid group reference 2 at position 3
== compile | (?(1)a|b|c)(x) | - | 
  error: conditional backref with more than two branches at position 8
== compile | \\ | - | 
  groups=0 groupindex={}
== compile | a\\ | - | 
  groups=0 groupindex={}
== compile | a\ | - | 
  error: bad escape (end of pattern) at position 1
== compile | (?P<ünï>x) | - | 
  groups=1 groupindex={'ünï': 1}
== compile | ()+ | - | 
  groups=1 groupindex={}
