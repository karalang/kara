    t.push_str("sub\t[\\w.]+@[\\w.]+\t-\t@app.log\t<email>\n");
    t.push_str("sub\t\\b(\\d{4})-\\d{4}-\\d{4}-(\\d{4})\\b\t-\t@app.log\t\\1-****-****-\\2\n");
    t.push_str("sub\t(?m)^(\\S+ \\S+) (\\w+)\\s+\t-\t@app.log\t\\2 \\1 \n");
    t.push_str("split\t,\\s*\t-\ta, b,c ,d\n");
    t.push_str("split\t(,)\\s*\t-\ta, b,c\n");
    t.push_str("split\t(,)|(;)\t-\ta,b;c\n");
    t.push_str("split\t\\s+\t-\t a b  c \n");
    t.push_str("split\t\\W+\t-\tWords, words, words.\t1\n");
    t.push_str("split\t[:=]\t-\ta=b:c\t5\n");
    t.push_str("split\tx\t-\t\n");
    t.push_str("split\tx*\t-\t\n");
    t.push_str("split\t(?m)^\t-\ta\\nb\\nc\n");
    t.push_str("split\t\\n\t-\t@hosts.conf\n");
    t.push_str("finditer\t(?P<ip>[\\d.:a-f]+) - (?P<user>\\S+) \\[(?P<ts>[^\\]]+)\\] \"(?P<method>[A-Z]+) (?P<path>\\S+) (?P<proto>[^\"]+)\" (?P<status>\\d{3}) (?P<bytes>\\d+|-)\tm\t@access.log\n");
    t.push_str("finditer\t(?m)^(?P<date>\\d{4}-\\d\\d-\\d\\d) (?P<time>[\\d:,]+) (?P<level>[A-Z]+)\\s+\\[(?P<thread>[^\\]]+)\\] (?P<msg>.*)$\t-\t@app.log\n");
    t.push_str("finditer\t(?m)^\\s*(?P<key>[\\w.]+)\\s*=\\s*(?P<value>.*?)\\s*$\t-\t@hosts.conf\n");
    t.push_str("finditer\t(?m)^\\[(?P<section>[^\\]]*)\\]$\t-\t@hosts.conf\n");
    t.push_str("findall\t(\\w[\\w.-]*):(\\d+)\t-\t@hosts.conf\n");
    t.push_str("findall\t(?P<scheme>\\w+)://(?P<host>[^:/]+)(?::(?P<port>\\d+))?\t-\t@hosts.conf\n");
    t.push_str("findall\t\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b\t-\t@access.log\n");
    t.push_str("findall\t\"[^\"\\\\]*(?:\\\\.[^\"\\\\]*)*\"\t-\tsay \"hi \\\"there\\\"\" and \"x\"\n");
    t.push_str("findall\t'(?:[^']|'')*'\t-\t@calc.txt\n");
    t.push_str("tokens\t(?P<NUMBER>\\d+(?:\\.\\d*)?)|(?P<ASSIGN>:=)|(?P<END>;)|(?P<ID>[A-Za-z_]\\w*)|(?P<OP>[+\\-*/()]|<>|>=|<=|[<>=])|(?P<STRING>'(?:[^']|'')*')|(?P<COMMENT>\\#.*)|(?P<NEWLINE>\\n)|(?P<SKIP>[ \\t]+)|(?P<MISMATCH>.)\t-\t@calc.txt\n");
    t.push_str("tokens\t(?P<num>\\d+)|(?P<word>[a-z]+)|(?P<other>.)\t-\tab12+c\n");
    t.push_str("search\t(a+)+b\t-\taaaaaaaaaaaaaaaaaaaaab\n");
    t.push_str("search\t(x+x+)+y\t-\txxxxxxxxxxy\n");
    t.push_str("search\t^(\\w+\\s?)*$\t-\ta few words here\n");
    t.push_str("fullmatch\t(?:\\d+\\.){3}\\d+\t-\t192.168.0.1\n");
    t.push_str("fullmatch\t[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\t-\tfirst.last+tag@sub.example.co\n");
    t.push_str("fullmatch\t(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d)?\t-\t23:59:60\n");
    t.push_str("fullmatch\t(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d)?\t-\t07:05\n");
    t.push_str("fullmatch\tv?(\\d+)\\.(\\d+)\\.(\\d+)(?:-([\\w.]+))?(?:\\+([\\w.]+))?\t-\tv1.2.3-rc.1+build.5\n");
    t.push_str("compile\t(a)(?P<n>b)(?:c)(d)\t-\t\n");
    t.push_str("compile\t*a\t-\t\n");
    t.push_str("compile\ta**\t-\t\n");
    t.push_str("compile\ta{2}{3}\t-\t\n");
    t.push_str("compile\ta(?\t-\t\n");
    t.push_str("compile\t(a\t-\t\n");
    t.push_str("compile\ta)\t-\t\n");
    t.push_str("compile\t[a\t-\t\n");
    t.push_str("compile\t[z-a]\t-\t\n");
    t.push_str("compile\ta\\q\t-\t\n");
    t.push_str("compile\t\\2(a)\t-\t\n");
    t.push_str("compile\t(a\\1)\t-\t\n");
    t.push_str("compile\t(?P<1a>x)\t-\t\n");
    t.push_str("compile\t(?P<a>x)(?P<a>y)\t-\t\n");
    t.push_str("compile\t(?P=b)\t-\t\n");
    t.push_str("compile\t(?P<a>x\t-\t\n");
    t.push_str("compile\t(?<x>a)\t-\t\n");
    t.push_str("compile\t(?Px)\t-\t\n");
    t.push_str("compile\t(?<=a+)b\t-\t\n");
    t.push_str("compile\t(?<=a|bc)d\t-\t\n");
    t.push_str("compile\ta{3,2}\t-\t\n");
    t.push_str("compile\tx(?i)y\t-\t\n");
    t.push_str("compile\t(?z)\t-\t\n");
    t.push_str("compile\t\\x4\t-\t\n");
    t.push_str("compile\t\\u12\t-\t\n");
    t.push_str("compile\t[\\d-z]\t-\t\n");
    t.push_str("compile\t(?(2)a|b)(x)\t-\t\n");
    t.push_str("compile\t(?(1)a|b|c)(x)\t-\t\n");
    t.push_str("compile\t\\\\\t-\t\n");
    t.push_str("compile\ta\\\\\t-\t\n");
    t.push_str("compile\ta\\\t-\t\n");
    t.push_str("compile\t(?P<ünï>x)\t-\t\n");
    t.push_str("compile\t()+\t-\t\n");
    v.push(DataFile { path: "cases.tsv".to_string(), hex: false, body: t });
}

fn data_part_2(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("# hosts and ports\n");
    t.push_str("[db]\n");
    t.push_str("primary = db-1.internal:5432\n");
    t.push_str("replica=db-2.internal:5432\n");
    t.push_str("  timeout   =  2.5s\n");
    t.push_str("[cache]\n");
    t.push_str("url = redis://cache.internal:6379/0\n");
    t.push_str("; old = memcached://cache.internal:11211\n");
    t.push_str("[empty]\n");
    v.push(DataFile { path: "hosts.conf".to_string(), hex: false, body: t });
}
