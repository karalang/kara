// mini_soupsieve: Soup Sieve 2.9.2, the CSS selector engine behind
// BeautifulSoup's select() that scrapers, crawlers and test suites use
// to pick elements out of HTML, over the parse tree Beautiful Soup 4.15
// builds with html.parser.
//
// The parser is css_parser's: its token regexes (run on mini_re's
// engine), CSS escapes, the selector structures with their reprs, nested
// and forgiving pseudo-classes, :has() relative selectors, custom
// selectors, the pseudo-classes defined as selector lists (:checked,
// :disabled, :read-write, :placeholder-shown, ...), and every
// SelectorSyntaxError with its line and caret. The matcher is
// css_match's: combinators, attributes with bs4's multi-valued values,
// :nth-* with "of S", :root, :scope, :empty, :lang() with extended
// filtering and the meta content-language fallback, :dir() through
// Unicode bidi classes, form states, :in-range/:out-of-range on dates,
// weeks, times and numbers, and :-soup-contains().
//
// The tree is bs4's, as in mini_markdownify. expected.out is the output
// of oracle.py, which runs the same jobs through soupsieve itself.

// ---------------------------------------------------------------- strings

fn cps(s: ref String) -> Vec[i64] {
    codepoints(s.bytes())
}

fn py_repr(s: ref String) -> String {
    repr_of(cps(s))
}

// str.isspace.
fn py_isspace(c: char) -> bool {
    c.is_whitespace() or (c >= '\u{1c}' and c <= '\u{1f}')
}

fn char_vec(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn from_chars(v: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut out = String.new();
    let mut i = lo;
    while i < hi {
        out.push(v[i]);
        i += 1;
    }
    out
}

fn in_chars(c: char, set: Str) -> bool {
    for x in set.chars() {
        if x == c {
            return true;
        }
    }
    false
}

// str.strip() / lstrip() / rstrip() with no argument (set "") or with the
// characters of `set`.
fn strip_by(s: ref String, set: Str, left: bool, right: bool) -> String {
    let v = char_vec(s);
    let mut a = 0;
    let mut b = v.len();
    if left {
        while a < b and (if set.is_empty() { py_isspace(v[a]) } else { in_chars(v[a], set) }) {
            a += 1;
        }
    }
    if right {
        while b > a and (if set.is_empty() { py_isspace(v[b - 1]) } else { in_chars(v[b - 1], set) }) {
            b -= 1;
        }
    }
    from_chars(v, a, b)
}

fn py_strip(s: ref String) -> String {
    strip_by(s, "", true, true)
}

fn py_rstrip(s: ref String) -> String {
    strip_by(s, "", false, true)
}

fn char_len(s: ref String) -> i64 {
    s.chars().count()
}

fn repeat(s: Str, n: i64) -> String {
    let mut out = String.new();
    let mut i = 0;
    while i < n {
        out.push_str(s);
        i += 1;
    }
    out
}

// The pieces of s.split("\n").
fn split_nl(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == '\n' {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn ascii_digits(s: ref String) -> bool {
    if s.is_empty() {
        return false;
    }
    for c in s.chars() {
        if c < '0' or c > '9' {
            return false;
        }
    }
    true
}

// int() of ASCII digits, saturating far past any value the callers clamp.
fn digits_int(s: ref String) -> i64 {
    let mut n = 0;
    for c in s.chars() {
        if n < 1000000000000 {
            n = n * 10 + (c as i64 - 48);
        }
    }
    n
}

fn has(v: ref Vec[String], s: Str) -> bool {
    for x in v.iter() {
        if x == s {
            return true;
        }
    }
    false
}

// ------------------------------------------------------------ errors

struct ReErr {
    kind: String,
    msg: String,
    pos: i64,
}

fn re_error(msg: own String, pos: i64) -> ReErr {
    ReErr { kind: "error".to_string(), msg: msg, pos: pos }
}

fn other_error(kind: Str, msg: own String) -> ReErr {
    ReErr { kind: kind.to_string(), msg: msg, pos: -1 }
}

fn err_text(e: ref ReErr) -> String {
    if e.kind == "error" {
        if e.pos >= 0 {
            return f"error: {e.msg} at position {e.pos}";
        }
        return f"error: {e.msg}";
    }
    f"{e.kind}: {e.msg}"
}

// -------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for cp in s {
        if cp < 0x80 {
            out.push(cp as u8);
        } else if cp < 0x800 {
            out.push((0xC0 | (cp >> 6)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else if cp < 0x10000 {
            out.push((0xE0 | (cp >> 12)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (cp >> 18)) as u8);
            out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

fn str_repr(s: ref Vec[i64], out: mut ref Vec[i64]) {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
}

fn repr_of(s: ref Vec[i64]) -> String {
    let mut out: Vec[i64] = Vec.new();
    str_repr(s, mut out);
    to_string(out)
}

// ----------------------------------------------------- character kinds

fn is_decimal(c: i64) -> bool {
    if c < 0x80 {
        return c >= 48 and c <= 57;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return true;
        }
    }
    false
}

fn is_space(c: i64, ascii: bool) -> bool {
    if c == 32 or (c >= 9 and c <= 13) {
        return true;
    }
    if ascii {
        return false;
    }
    (c >= 0x1C and c <= 0x1F) or c == 0x85 or c == 0xA0 or c == 0x1680 or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F or c == 0x3000
}

fn as_char(c: i64) -> Option[char] {
    if c < 0 or (c >= 0xD800 and c <= 0xDFFF) or c > 0x10FFFF {
        return None;
    }
    char.try_from(c as u32).ok()
}

fn is_word(c: i64, ascii: bool) -> bool {
    if c < 0x80 {
        return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
    }
    if ascii {
        return false;
    }
    match as_char(c) {
        Some(ch) => ch.is_alphanumeric(),
        None => false,
    }
}

fn lower(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 65 and c <= 90 { c + 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_lowercase() as u32 as i64,
        None => c,
    }
}

fn upper(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 97 and c <= 122 { c - 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_uppercase() as u32 as i64,
        None => c,
    }
}

// ------------------------------------------------------- parsed form

// The categories of \d \D \s \S \w \W.
fn cat_digit() -> i64 { 0 }
fn cat_not_digit() -> i64 { 1 }
fn cat_space() -> i64 { 2 }
fn cat_not_space() -> i64 { 3 }
fn cat_word() -> i64 { 4 }
fn cat_not_word() -> i64 { 5 }

// The positions ^ $ \A \Z \b \B and the forms the compiler turns them
// into under MULTILINE.
fn at_beginning() -> i64 { 0 }
fn at_beginning_line() -> i64 { 1 }
fn at_beginning_string() -> i64 { 2 }
fn at_end() -> i64 { 3 }
fn at_end_line() -> i64 { 4 }
fn at_end_string() -> i64 { 5 }
fn at_boundary() -> i64 { 6 }
fn at_non_boundary() -> i64 { 7 }

#[derive(Clone)]
enum Item {
    Lit(i64),
    Range(i64, i64),
    Cat(i64),
}

enum Node {
    Lit(i64),
    NotLit(i64),
    Any,
    In(Vec[Item], bool),
    At(i64),
    Branch(Vec[Vec[Node]]),
    // group (0: none), flags turned on, flags turned off, contents
    Group(i64, i64, i64, Vec[Node]),
    // 0 greedy, 1 lazy, 2 possessive; min; max; the item repeated
    Repeat(i64, i64, i64, Vec[Node]),
    Atomic(Vec[Node]),
    // direction (1 ahead, -1 behind), negative, contents
    Assert(i64, bool, Vec[Node]),
    GroupRef(i64),
    // group, yes branch, no branch
    Exists(i64, Vec[Node], Vec[Node]),
    Failure,
}

fn is_repeat(n: ref Node) -> bool {
    match n {
        Node.Repeat(_, _, _, _) => true,
        _ => false,
    }
}

fn is_at(n: ref Node) -> bool {
    match n {
        Node.At(_) => true,
        _ => false,
    }
}

fn flag_i() -> i64 { 2 }
fn flag_l() -> i64 { 4 }
fn flag_m() -> i64 { 8 }
fn flag_s() -> i64 { 16 }
fn flag_u() -> i64 { 32 }
fn flag_x() -> i64 { 64 }
fn flag_a() -> i64 { 256 }
fn type_flags() -> i64 { 4 | 32 | 256 }
fn maxrepeat() -> i64 { 4294967295 }
fn maxgroups() -> i64 { 1073741823 }
fn maxwidth() -> i64 { 1 << 62 }

fn flag_value(c: i64) -> i64 {
    match c {
        105 => 2,
        76 => 4,
        109 => 8,
        115 => 16,
        120 => 64,
        97 => 256,
        117 => 32,
        _ => 0,
    }
}

// ------------------------------------------------------------ tokens

// One token: nothing at the end of the pattern (n 0), a character (n 1),
// or a backslash and the character after it (n 2).
#[derive(Copy, Clone)]
struct T {
    n: i64,
    a: i64,
    b: i64,
}

fn tok_none() -> T {
    T { n: 0, a: 0, b: 0 }
}

fn tok_is(t: T, c: i64) -> bool {
    t.n == 1 and t.a == c
}

fn tok_text(t: T) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    if t.n >= 1 {
        v.push(t.a);
    }
    if t.n == 2 {
        v.push(t.b);
    }
    v
}

fn is_ascii_letter(c: i64) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

fn is_hex(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

fn is_oct(c: i64) -> bool {
    c >= 48 and c <= 55
}

fn is_dec(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn digits_value(s: ref Vec[i64], start: i64, base: i64) -> i64 {
    let mut v = 0;
    let mut i = start;
    while i < s.len() {
        let c = s[i];
        let d = if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 };
        v = v * base + d;
        i += 1;
    }
    v
}

// str.isidentifier, near enough: a letter or underscore, then letters,
// digits and underscores.
fn is_identifier(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    let mut i = 0;
    while i < name.len() {
        let c = name[i];
        let ok = if c == 95 {
            true
        } else if i == 0 {
            match as_char(c) {
                Some(ch) => ch.is_alphabetic(),
                None => false,
            }
        } else {
            is_word(c, false)
        };
        if not ok {
            return false;
        }
        i += 1;
    }
    true
}

fn is_ascii_decimal(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    for c in name {
        if not is_dec(c) {
            return false;
        }
    }
    true
}

struct Tokenizer {
    s: Vec[i64],
    index: i64,
    next: T,
}

impl Tokenizer {
    fn advance(mut ref self) -> Result[(), ReErr] {
        let index = self.index;
        if index >= self.s.len() {
            self.next = tok_none();
            return Ok(());
        }
        let c = self.s[index];
        if c == 92 {
            if index + 1 >= self.s.len() {
                return Err(re_error("bad escape (end of pattern)".to_string(), self.s.len() - 1));
            }
            self.next = T { n: 2, a: 92, b: self.s[index + 1] };
            self.index = index + 2;
        } else {
            self.next = T { n: 1, a: c, b: 0 };
            self.index = index + 1;
        }
        Ok(())
    }

    fn get(mut ref self) -> Result[T, ReErr] {
        let t = self.next;
        self.advance()?;
        Ok(t)
    }

    fn take(mut ref self, c: i64) -> Result[bool, ReErr] {
        if tok_is(self.next, c) {
            self.advance()?;
            return Ok(true);
        }
        Ok(false)
    }

    fn tell(ref self) -> i64 {
        self.index - self.next.n
    }

    fn seek(mut ref self, index: i64) -> Result[(), ReErr] {
        self.index = index;
        self.advance()
    }

    fn error(ref self, msg: own String, offset: i64) -> ReErr {
        re_error(msg, self.tell() - offset)
    }

    // getwhile: up to n characters of a kind (0 octal, 1 decimal, 2 hex).
    fn getwhile(mut ref self, n: i64, kind: i64, out: mut ref Vec[i64]) -> Result[(), ReErr] {
        let mut k = 0;
        while k < n {
            let t = self.next;
            if t.n != 1 {
                break;
            }
            let ok = if kind == 0 { is_oct(t.a) } else if kind == 1 { is_dec(t.a) } else { is_hex(t.a) };
            if not ok {
                break;
            }
            out.push(t.a);
            self.advance()?;
            k += 1;
        }
        Ok(())
    }

    fn getuntil(mut ref self, terminator: i64, name: Str) -> Result[Vec[i64], ReErr] {
        let mut result: Vec[i64] = Vec.new();
        loop {
            let c = self.next;
            self.advance()?;
            if c.n == 0 {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 0));
                }
                let term = to_string(vec_of(terminator));
                return Err(self.error(f"missing {term}, unterminated name", result.len()));
            }
            if tok_is(c, terminator) {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 1));
                }
                break;
            }
            push_all(mut result, tok_text(c));
        }
        Ok(result)
    }

    fn checkgroupname(ref self, name: ref Vec[i64], offset: i64) -> Result[(), ReErr] {
        if not is_identifier(name) {
            return Err(self.error(f"bad character in group name {repr_of(name)}", name.len() + offset));
        }
        Ok(())
    }
}

fn vec_of(c: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(c);
    v
}

fn new_tokenizer(s: ref Vec[i64]) -> Result[Tokenizer, ReErr] {
    let mut t = Tokenizer { s: s.clone(), index: 0, next: tok_none() };
    t.advance()?;
    Ok(t)
}

// ------------------------------------------------------------ parser

#[derive(Clone)]
struct Width {
    lo: i64,
    hi: i64,
}

struct ParseState {
    flags: i64,
    names: Vec[(Vec[i64], i64)],
    // per group: whether it is closed, and its width
    closed: Vec[bool],
    widths: Vec[Width],
    lookbehind_groups: i64,
    // conditional references by number, in order: (group, position)
    refpos: Vec[(i64, i64)],
}

impl ParseState {
    fn groups(ref self) -> i64 {
        self.closed.len()
    }

    fn group_of(ref self, name: ref Vec[i64]) -> i64 {
        for (n, g) in self.names.iter() {
            if same(n, name) {
                return *g;
            }
        }
        -1
    }

    fn checkgroup(ref self, gid: i64) -> bool {
        gid < self.groups() and self.closed[gid]
    }

    fn checklookbehindgroup(ref self, gid: i64, src: ref Tokenizer) -> Result[(), ReErr] {
        if self.lookbehind_groups >= 0 {
            if not self.checkgroup(gid) {
                return Err(src.error("cannot refer to an open group".to_string(), 0));
            }
            if gid >= self.lookbehind_groups {
                return Err(src.error("cannot refer to group defined in the same lookbehind subpattern".to_string(), 0));
            }
        }
        Ok(())
    }
}

fn add_width(a: i64, b: i64) -> i64 {
    if a >= maxwidth() - b { maxwidth() } else { a + b }
}

fn mul_width(a: i64, n: i64) -> i64 {
    if a == 0 or n == 0 {
        0
    } else if a >= maxwidth() / n {
        maxwidth()
    } else {
        a * n
    }
}

// SubPattern.getwidth.
fn width_of(widths: ref Vec[Width], p: ref Vec[Node]) -> Width {
    let mut lo = 0;
    let mut hi = 0;
    for n in p.iter() {
        match n {
            Node.Branch(items) => {
                let mut i = maxwidth();
                let mut j = 0;
                for item in items.iter() {
                    let w = width_of(widths, item);
                    if w.lo < i {
                        i = w.lo;
                    }
                    if w.hi > j {
                        j = w.hi;
                    }
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Atomic(body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Group(_, _, _, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Repeat(_, min, max, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, mul_width(w.lo, *min));
                if *max == maxrepeat() and w.hi > 0 {
                    hi = maxwidth();
                } else {
                    hi = add_width(hi, mul_width(w.hi, *max));
                }
            }
            Node.GroupRef(g) => {
                let w = ref widths[*g];
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Exists(_, yes, no) => {
                let wy = width_of(widths, yes);
                let mut i = wy.lo;
                let mut j = wy.hi;
                if no.len() > 0 {
                    let wn = width_of(widths, no);
                    if wn.lo < i {
                        i = wn.lo;
                    }
                    if wn.hi > j {
                        j = wn.hi;
                    }
                } else {
                    i = 0;
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Lit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.NotLit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.Any => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.In(_, _) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            _ => {}
        }
    }
    Width { lo: lo, hi: hi }
}

fn category_of(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        100 => 0,
        68 => 1,
        115 => 2,
        83 => 3,
        119 => 4,
        87 => 5,
        _ => -1,
    }
}

fn escape_value(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        97 => 7,
        98 => 8,
        102 => 12,
        110 => 10,
        114 => 13,
        116 => 9,
        118 => 11,
        92 => 92,
        _ => -1,
    }
}

// \x, \u and \U: the escape text so far, and the code point.
fn hex_escape(src: mut ref Tokenizer, t: T, esc: mut ref Vec[i64]) -> Result[i64, ReErr] {
    let n = if t.b == 120 { 2 } else if t.b == 117 { 4 } else { 8 };
    src.getwhile(n, 2, mut esc)?;
    if esc.len() != n + 2 {
        return Err(src.error(f"incomplete escape {to_string(esc)}", esc.len()));
    }
    let c = digits_value(esc, 2, 16);
    if c > 0x10FFFF {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(c)
}

// _class_escape: an escape inside [...], a literal or a category.
fn class_escape(src: mut ref Tokenizer, t: T) -> Result[Item, ReErr] {
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Item.Lit(e));
    }
    let cat = category_of(t);
    if cat >= 0 {
        return Ok(Item.Cat(cat));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Item.Lit(v));
    }
    if is_oct(c) {
        src.getwhile(2, 0, mut esc)?;
        let v = digits_value(esc, 1, 8);
        if v > 0o377 {
            return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
        }
        return Ok(Item.Lit(v));
    }
    if is_dec(c) or is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Item.Lit(c))
}

// _escape: an escape outside a set.
fn escape(src: mut ref Tokenizer, t: T, st: ref ParseState) -> Result[Node, ReErr] {
    let cat = category_of(t);
    if cat >= 0 {
        let mut items: Vec[Item] = Vec.new();
        items.push(Item.Cat(cat));
        return Ok(Node.In(items, false));
    }
    match t.b {
        65 => return Ok(Node.At(at_beginning_string())),
        98 => return Ok(Node.At(at_boundary())),
        66 => return Ok(Node.At(at_non_boundary())),
        90 => return Ok(Node.At(at_end_string())),
        _ => {}
    }
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Node.Lit(e));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Node.Lit(v));
    }
    if c == 48 {
        src.getwhile(2, 0, mut esc)?;
        return Ok(Node.Lit(digits_value(esc, 1, 8)));
    }
    if is_dec(c) {
        // an octal escape or a group reference
        let nt = src.next;
        if nt.n == 1 and is_dec(nt.a) {
            esc.push(nt.a);
            src.advance()?;
            let nt2 = src.next;
            if is_oct(esc[1]) and is_oct(esc[2]) and nt2.n == 1 and is_oct(nt2.a) {
                esc.push(nt2.a);
                src.advance()?;
                let v = digits_value(esc, 1, 8);
                if v > 0o377 {
                    return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
                }
                return Ok(Node.Lit(v));
            }
        }
        let group = digits_value(esc, 1, 10);
        if group < st.groups() {
            if not st.checkgroup(group) {
                return Err(src.error("cannot refer to an open group".to_string(), esc.len()));
            }
            st.checklookbehindgroup(group, src)?;
            return Ok(Node.GroupRef(group));
        }
        return Err(src.error(f"invalid group reference {group}", esc.len() - 1));
    }
    if is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Node.Lit(c))
}

fn parse_sub(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64) -> Result[Vec[Node], ReErr] {
    let mut items: Vec[Vec[Node]] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let first = nested == 0 and items.len() == 0;
        let item = parse_seq(mut src, mut st, verbose, nested + 1, first)?;
        items.push(item);
        if not src.take(124)? {
            break;
        }
        if nested == 0 {
            verbose = (st.flags & flag_x()) != 0;
        }
    }
    if items.len() == 1 {
        return Ok(items.pop().unwrap());
    }
    let mut out: Vec[Node] = Vec.new();
    out.push(Node.Branch(items));
    Ok(out)
}

// _parse_flags: None (as Err-free Ok(None)) for global flags, else the
// flags turned on and off.
fn parse_flags(src: mut ref Tokenizer, st: mut ref ParseState, first_char: T) -> Result[Option[(i64, i64)], ReErr] {
    let mut ch = first_char;
    let mut add = 0;
    let mut del = 0;
    if not tok_is(ch, 45) {
        loop {
            let flag = flag_value(ch.a);
            if ch.a == 76 {
                return Err(src.error("bad inline flags: cannot use 'L' flag with a str pattern".to_string(), 0));
            }
            add = add | flag;
            if (flag & type_flags()) != 0 and (add & type_flags()) != flag {
                return Err(src.error("bad inline flags: flags 'a', 'u' and 'L' are incompatible".to_string(), 0));
            }
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing -, : or )".to_string(), 0));
            }
            if tok_is(ch, 41) or tok_is(ch, 45) or tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing -, : or )" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if tok_is(ch, 41) {
        st.flags = st.flags | add;
        return Ok(None);
    }
    if tok_is(ch, 45) {
        ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("missing flag".to_string(), 0));
        }
        if ch.n != 1 or flag_value(ch.a) == 0 {
            let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing flag" };
            return Err(src.error(msg.to_string(), ch.n));
        }
        loop {
            let flag = flag_value(ch.a);
            if (flag & type_flags()) != 0 {
                return Err(src.error("bad inline flags: cannot turn off flags 'a', 'u' and 'L'".to_string(), 0));
            }
            del = del | flag;
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing :".to_string(), 0));
            }
            if tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing :" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if (add & del) != 0 {
        return Err(src.error("bad inline flags: flag turned on and off".to_string(), 1));
    }
    Ok(Some((add, del)))
}

fn is_alpha(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

fn parse_set(src: mut ref Tokenizer, out: mut ref Vec[Node]) -> Result[(), ReErr] {
    let here = src.tell() - 1;
    let mut set: Vec[Item] = Vec.new();
    let negate = src.take(94)?;
    loop {
        let this = src.get()?;
        if this.n == 0 {
            return Err(src.error("unterminated character set".to_string(), src.tell() - here));
        }
        if tok_is(this, 93) and set.len() > 0 {
            break;
        }
        let code1 = if this.n == 2 { class_escape(mut src, this)? } else { Item.Lit(this.a) };
        if src.take(45)? {
            let that = src.get()?;
            if that.n == 0 {
                return Err(src.error("unterminated character set".to_string(), src.tell() - here));
            }
            if tok_is(that, 93) {
                set.push(code1);
                set.push(Item.Lit(45));
                break;
            }
            let code2 = if that.n == 2 { class_escape(mut src, that)? } else { Item.Lit(that.a) };
            let text = f"{to_string(tok_text(this))}-{to_string(tok_text(that))}";
            let offset = this.n + 1 + that.n;
            let lo = match code1 {
                Item.Lit(c) => c,
                _ => -1,
            };
            let hi = match code2 {
                Item.Lit(c) => c,
                _ => -1,
            };
            if lo < 0 or hi < 0 or hi < lo {
                return Err(src.error(f"bad character range {text}", offset));
            }
            set.push(Item.Range(lo, hi));
        } else {
            set.push(code1);
        }
    }
    if set.len() == 1 {
        let only = ref set[0];
        if let Item.Lit(c) = only {
            if negate {
                out.push(Node.NotLit(*c));
            } else {
                out.push(Node.Lit(*c));
            }
            return Ok(());
        }
    }
    out.push(Node.In(set, negate));
    Ok(())
}

// The quantifier just read (its first character is `this`), applied to
// the last item. Returns false when `{` turned out to be a literal.
fn parse_repeat(src: mut ref Tokenizer, this: T, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let here = src.tell();
    let mut min = 0;
    let mut max = maxrepeat();
    if tok_is(this, 63) {
        max = 1;
    } else if tok_is(this, 43) {
        min = 1;
    } else if tok_is(this, 123) {
        if tok_is(src.next, 125) {
            out.push(Node.Lit(123));
            return Ok(false);
        }
        let mut lo: Vec[i64] = Vec.new();
        let mut hi: Vec[i64] = Vec.new();
        while src.next.n == 1 and is_dec(src.next.a) {
            lo.push(src.get()?.a);
        }
        if src.take(44)? {
            while src.next.n == 1 and is_dec(src.next.a) {
                hi.push(src.get()?.a);
            }
        } else {
            hi = lo.clone();
        }
        if not src.take(125)? {
            out.push(Node.Lit(123));
            src.seek(here)?;
            return Ok(false);
        }
        if lo.len() > 0 {
            if lo.len() > 10 or digits_value(lo, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            min = digits_value(lo, 0, 10);
        }
        if hi.len() > 0 {
            if hi.len() > 10 or digits_value(hi, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            max = digits_value(hi, 0, 10);
            if max < min {
                return Err(src.error("min repeat greater than max repeat".to_string(), src.tell() - here));
            }
        }
    }
    if out.len() == 0 or is_at(out[out.len() - 1]) {
        return Err(src.error("nothing to repeat".to_string(), src.tell() - here + 1));
    }
    if is_repeat(out[out.len() - 1]) {
        return Err(src.error("multiple repeat".to_string(), src.tell() - here + 1));
    }
    let last = out.pop().unwrap();
    let mut body: Vec[Node] = Vec.new();
    match last {
        Node.Group(0, 0, 0, p) => body = p,
        other => body.push(other),
    }
    let kind = if src.take(63)? { 1 } else if src.take(43)? { 2 } else { 0 };
    out.push(Node.Repeat(kind, min, max, body));
    Ok(true)
}

fn parse_seq(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64, first: bool) -> Result[Vec[Node], ReErr] {
    let mut out: Vec[Node] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let this = src.next;
        if this.n == 0 or tok_is(this, 124) or tok_is(this, 41) {
            break;
        }
        src.advance()?;
        if verbose {
            if this.n == 1 and (this.a == 32 or (this.a >= 9 and this.a <= 13)) {
                continue;
            }
            if tok_is(this, 35) {
                loop {
                    let t = src.get()?;
                    if t.n == 0 or tok_is(t, 10) {
                        break;
                    }
                }
                continue;
            }
        }
        if this.n == 2 {
            let node = escape(mut src, this, st)?;
            out.push(node);
            continue;
        }
        let c = this.a;
        if c == 91 {
            parse_set(mut src, mut out)?;
        } else if c == 42 or c == 43 or c == 63 or c == 123 {
            parse_repeat(mut src, this, mut out)?;
        } else if c == 46 {
            out.push(Node.Any);
        } else if c == 94 {
            out.push(Node.At(at_beginning()));
        } else if c == 36 {
            out.push(Node.At(at_end()));
        } else if c == 40 {
            if parse_group(mut src, mut st, mut verbose, nested, first, mut out)? {
                continue;
            }
        } else {
            out.push(Node.Lit(c));
        }
    }
    Ok(out)
}

// `(` and what follows. Returns true for a construct that adds nothing
// (a comment, global flags).
fn parse_group(src: mut ref Tokenizer, st: mut ref ParseState, verbose: mut ref bool, nested: i64, first: bool, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let start = src.tell() - 1;
    let mut capture = true;
    let mut atomic = false;
    let mut name: Vec[i64] = Vec.new();
    let mut named = false;
    let mut add = 0;
    let mut del = 0;
    if src.take(63)? {
        let ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("unexpected end of pattern".to_string(), 0));
        }
        if tok_is(ch, 80) {
            if src.take(60)? {
                name = src.getuntil(62, "group name")?;
                src.checkgroupname(name, 1)?;
                named = true;
            } else if src.take(61)? {
                let ref_name = src.getuntil(41, "group name")?;
                src.checkgroupname(ref_name, 1)?;
                let gid = st.group_of(ref_name);
                if gid < 0 {
                    return Err(src.error(f"unknown group name {repr_of(ref_name)}", ref_name.len() + 1));
                }
                if not st.checkgroup(gid) {
                    return Err(src.error("cannot refer to an open group".to_string(), ref_name.len() + 1));
                }
                st.checklookbehindgroup(gid, src)?;
                out.push(Node.GroupRef(gid));
                return Ok(true);
            } else {
                let c2 = src.get()?;
                if c2.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                return Err(src.error(f"unknown extension ?P{to_string(tok_text(c2))}", c2.n + 2));
            }
        } else if tok_is(ch, 58) {
            capture = false;
        } else if tok_is(ch, 35) {
            loop {
                if src.next.n == 0 {
                    return Err(src.error("missing ), unterminated comment".to_string(), src.tell() - start));
                }
                if tok_is(src.get()?, 41) {
                    break;
                }
            }
            return Ok(true);
        } else if tok_is(ch, 61) or tok_is(ch, 33) or tok_is(ch, 60) {
            let mut kind = ch;
            let mut dir = 1;
            let mut outer_lookbehind = 0;
            if tok_is(ch, 60) {
                kind = src.get()?;
                if kind.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                if not (tok_is(kind, 61) or tok_is(kind, 33)) {
                    return Err(src.error(f"unknown extension ?<{to_string(tok_text(kind))}", kind.n + 2));
                }
                dir = -1;
                outer_lookbehind = st.lookbehind_groups;
                if outer_lookbehind < 0 {
                    st.lookbehind_groups = st.groups();
                }
            }
            let p = parse_sub(mut src, mut st, *verbose, nested + 1)?;
            if dir < 0 and outer_lookbehind < 0 {
                st.lookbehind_groups = -1;
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            if tok_is(kind, 61) {
                out.push(Node.Assert(dir, false, p));
            } else if p.len() > 0 {
                out.push(Node.Assert(dir, true, p));
            } else {
                out.push(Node.Failure);
            }
            return Ok(true);
        } else if tok_is(ch, 40) {
            let condname = src.getuntil(41, "group name")?;
            let mut condgroup = 0;
            if not is_ascii_decimal(condname) {
                src.checkgroupname(condname, 1)?;
                condgroup = st.group_of(condname);
                if condgroup < 0 {
                    return Err(src.error(f"unknown group name {repr_of(condname)}", condname.len() + 1));
                }
            } else {
                if condname.len() > 10 {
                    return Err(src.error(f"invalid group reference {to_string(condname)}", condname.len() + 1));
                }
                condgroup = digits_value(condname, 0, 10);
                if condgroup == 0 {
                    return Err(src.error("bad group number".to_string(), condname.len() + 1));
                }
                if condgroup >= maxgroups() {
                    return Err(src.error(f"invalid group reference {condgroup}", condname.len() + 1));
                }
                let mut seen = false;
                for (g, _) in st.refpos.iter() {
                    if *g == condgroup {
                        seen = true;
                    }
                }
                if not seen {
                    st.refpos.push((condgroup, src.tell() - condname.len() - 1));
                }
            }
            st.checklookbehindgroup(condgroup, src)?;
            let yes = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
            let mut no: Vec[Node] = Vec.new();
            if src.take(124)? {
                no = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
                if tok_is(src.next, 124) {
                    return Err(src.error("conditional backref with more than two branches".to_string(), 0));
                }
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            out.push(Node.Exists(condgroup, yes, no));
            return Ok(true);
        } else if tok_is(ch, 62) {
            capture = false;
            atomic = true;
        } else if (ch.n == 1 and flag_value(ch.a) != 0) or tok_is(ch, 45) {
            match parse_flags(mut src, mut st, ch)? {
                None => {
                    if not first or out.len() > 0 {
                        return Err(src.error("global flags not at the start of the expression".to_string(), src.tell() - start));
                    }
                    *verbose = (st.flags & flag_x()) != 0;
                    return Ok(true);
                }
                Some((a, d)) => {
                    add = a;
                    del = d;
                    capture = false;
                }
            }
        } else {
            return Err(src.error(f"unknown extension ?{to_string(tok_text(ch))}", ch.n + 1));
        }
    }
    let mut group = 0;
    if capture {
        group = st.groups();
        st.closed.push(false);
        st.widths.push(Width { lo: 0, hi: 0 });
        if named {
            let was = st.group_of(name);
            if was >= 0 {
                return Err(src.error(f"redefinition of group name {repr_of(name)} as group {group}; was group {was}", name.len() + 1));
            }
            st.names.push((name.clone(), group));
        }
    }
    let sub_verbose = (*verbose or (add & flag_x()) != 0) and (del & flag_x()) == 0;
    let p = parse_sub(mut src, mut st, sub_verbose, nested + 1)?;
    if not src.take(41)? {
        return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
    }
    if group > 0 {
        let w = width_of(st.widths, p);
        st.widths[group] = w;
        st.closed[group] = true;
    }
    if atomic {
        out.push(Node.Atomic(p));
    } else {
        out.push(Node.Group(group, add, del, p));
    }
    Ok(false)
}

struct Parsed {
    nodes: Vec[Node],
    flags: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
    widths: Vec[Width],
}

fn parse(pattern: ref Vec[i64], flags: i64) -> Result[Parsed, ReErr] {
    let mut src = new_tokenizer(pattern)?;
    let mut st = ParseState {
        flags: flags,
        names: Vec.new(),
        closed: Vec.new(),
        widths: Vec.new(),
        lookbehind_groups: -1,
        refpos: Vec.new(),
    };
    // group 0 is the whole match
    st.closed.push(true);
    st.widths.push(Width { lo: 0, hi: 0 });
    let nodes = parse_sub(mut src, mut st, (flags & flag_x()) != 0, 0)?;
    if (st.flags & flag_a()) != 0 and (st.flags & flag_u()) != 0 {
        return Err(other_error("ValueError", "ASCII and UNICODE flags are incompatible".to_string()));
    }
    if src.next.n != 0 {
        return Err(src.error("unbalanced parenthesis".to_string(), 0));
    }
    for (g, pos) in st.refpos.iter() {
        if *g >= st.groups() {
            return Err(re_error(f"invalid group reference {*g}", *pos));
        }
    }
    let groups = st.groups() - 1;
    Ok(Parsed { nodes: nodes, flags: st.flags, groups: groups, names: st.names, widths: st.widths })
}

// ---------------------------------------------------------- compiler

#[derive(Clone)]
enum Op {
    // character (lowered when case-insensitive), case-insensitive, ASCII
    Lit(i64, bool, bool),
    NotLit(i64, bool, bool),
    Any,
    AnyAll,
    // set, case-insensitive, ASCII-only categories
    In(i64, bool, bool),
    // anchor kind, ASCII-only word boundary
    At(i64, bool),
    Mark(i64),
    Split(i64, i64),
    Jmp(i64),
    // repeat register, the Until it starts at
    RepInit(i64, i64),
    // register, min, max, greedy, body, exit
    Until(i64, i64, i64, bool, i64, i64),
    Ref(i64, bool, bool),
    // lookbehind width (-1 for lookahead), negative, sub-program, next
    Look(i64, bool, i64, i64),
    Atomic(i64, i64),
    Exists(i64, i64),
    Fail,
    Succeed,
    Match,
}

#[derive(Clone)]
struct Program {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
}

#[derive(Clone)]
struct CharSet {
    items: Vec[Item],
    negate: bool,
}

fn combine(flags: i64, add: i64, del: i64) -> i64 {
    let mut f = flags;
    if (add & type_flags()) != 0 {
        f = f & (0x7FFFFFFF ^ type_flags());
    }
    (f | add) & (0x7FFFFFFF ^ del)
}

struct Compiler {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
}

impl Compiler {
    fn emit(mut ref self, op: own Op) -> i64 {
        self.ops.push(op);
        self.ops.len() - 1
    }

    fn here(ref self) -> i64 {
        self.ops.len()
    }

    fn compile(mut ref self, p: ref Parsed, nodes: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let icase = (flags & flag_i()) != 0;
        let ascii = (flags & flag_a()) != 0;
        for n in nodes.iter() {
            match n {
                Node.Lit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.Lit(v, icase, ascii));
                }
                Node.NotLit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.NotLit(v, icase, ascii));
                }
                Node.Any => {
                    if (flags & flag_s()) != 0 {
                        self.emit(Op.AnyAll);
                    } else {
                        self.emit(Op.Any);
                    }
                }
                Node.In(items, negate) => {
                    self.sets.push(CharSet { items: items.clone(), negate: *negate });
                    let idx = self.sets.len() - 1;
                    self.emit(Op.In(idx, icase, ascii));
                }
                Node.At(kind) => {
                    let mut k = *kind;
                    if (flags & flag_m()) != 0 {
                        if k == at_beginning() {
                            k = at_beginning_line();
                        } else if k == at_end() {
                            k = at_end_line();
                        }
                    }
                    self.emit(Op.At(k, ascii));
                }
                Node.Branch(items) => {
                    let mut ends: Vec[i64] = Vec.new();
                    let mut i = 0;
                    while i < items.len() {
                        if i + 1 < items.len() {
                            let split = self.emit(Op.Fail);
                            self.compile(p, items[i], flags)?;
                            ends.push(self.emit(Op.Fail));
                            let next = self.here();
                            self.ops[split] = Op.Split(split + 1, next);
                        } else {
                            self.compile(p, items[i], flags)?;
                        }
                        i += 1;
                    }
                    let end = self.here();
                    for at in ends {
                        self.ops[at] = Op.Jmp(end);
                    }
                }
                Node.Group(g, add, off, body) => {
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g));
                    }
                    self.compile(p, body, combine(flags, *add, *off))?;
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g + 1));
                    }
                }
                Node.Repeat(kind, min, max, body) => {
                    if *kind == 2 {
                        let at = self.emit(Op.Fail);
                        self.compile_repeat(p, *min, *max, true, body, flags)?;
                        self.emit(Op.Succeed);
                        let next = self.here();
                        self.ops[at] = Op.Atomic(at + 1, next);
                    } else {
                        self.compile_repeat(p, *min, *max, *kind == 0, body, flags)?;
                    }
                }
                Node.Atomic(body) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Atomic(at + 1, next);
                }
                Node.Assert(dir, negative, body) => {
                    let mut width = -1;
                    if *dir < 0 {
                        let w = width_of(p.widths, body);
                        if w.lo != w.hi {
                            return Err(other_error("error", "look-behind requires fixed-width pattern".to_string()));
                        }
                        width = w.lo;
                    }
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Look(width, *negative, at + 1, next);
                }
                Node.GroupRef(g) => {
                    self.emit(Op.Ref(*g, icase, ascii));
                }
                Node.Exists(g, yes, no) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, yes, flags)?;
                    if no.len() > 0 {
                        let jump = self.emit(Op.Fail);
                        let no_pc = self.here();
                        self.compile(p, no, flags)?;
                        let end = self.here();
                        self.ops[jump] = Op.Jmp(end);
                        self.ops[at] = Op.Exists(*g, no_pc);
                    } else {
                        let end = self.here();
                        self.ops[at] = Op.Exists(*g, end);
                    }
                }
                Node.Failure => {
                    self.emit(Op.Fail);
                }
            }
        }
        Ok(())
    }

    fn compile_repeat(mut ref self, p: ref Parsed, min: i64, max: i64, greedy: bool, body: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let r = self.repeats;
        self.repeats += 1;
        let init = self.emit(Op.Fail);
        self.compile(p, body, flags)?;
        let until = self.emit(Op.Fail);
        self.ops[init] = Op.RepInit(r, until);
        self.ops[until] = Op.Until(r, min, max, greedy, init + 1, until + 1);
        Ok(())
    }
}

fn compile(pattern: ref Vec[i64], flags: i64) -> Result[Program, ReErr] {
    let p = parse(pattern, flags)?;
    let mut c = Compiler { ops: Vec.new(), sets: Vec.new(), repeats: 0 };
    c.compile(p, p.nodes, p.flags)?;
    c.emit(Op.Match);
    Ok(Program { ops: c.ops, sets: c.sets, repeats: c.repeats, groups: p.groups, names: p.names })
}

// ----------------------------------------------------------- matcher

struct Undo {
    kind: i64,
    idx: i64,
    old: i64,
}

struct Choice {
    pc: i64,
    pos: i64,
    trail: i64,
    // 0: resume at pc; 1: a lazy repeat's Until, after its tail failed
    mode: i64,
}

struct Matcher {
    s: Vec[i64],
    marks: Vec[i64],
    counts: Vec[i64],
    lasts: Vec[i64],
    lastindex: i64,
    trail: Vec[Undo],
    start: i64,
    must_advance: bool,
    match_all: bool,
}

impl Matcher {
    fn set_mark(mut ref self, slot: i64, v: i64) {
        self.trail.push(Undo { kind: 0, idx: slot, old: self.marks[slot] });
        self.marks[slot] = v;
    }

    fn set_count(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 1, idx: r, old: self.counts[r] });
        self.counts[r] = v;
    }

    fn set_last(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 2, idx: r, old: self.lasts[r] });
        self.lasts[r] = v;
    }

    fn set_lastindex(mut ref self, v: i64) {
        self.trail.push(Undo { kind: 3, idx: 0, old: self.lastindex });
        self.lastindex = v;
    }

    fn undo_to(mut ref self, len: i64) {
        while self.trail.len() > len {
            let u = self.trail.pop().unwrap();
            if u.kind == 0 {
                self.marks[u.idx] = u.old;
            } else if u.kind == 1 {
                self.counts[u.idx] = u.old;
            } else if u.kind == 2 {
                self.lasts[u.idx] = u.old;
            } else {
                self.lastindex = u.old;
            }
        }
    }

    // A group that has both marks, the end not before the start.
    fn group_span(ref self, g: i64) -> (i64, i64) {
        let a = self.marks[2 * g];
        let b = self.marks[2 * g + 1];
        if a < 0 or b < 0 or b < a {
            return (-1, -1);
        }
        (a, b)
    }

    fn at(ref self, kind: i64, ascii: bool, pos: i64) -> bool {
        let n = self.s.len();
        if kind == 0 or kind == 2 {
            return pos == 0;
        }
        if kind == 1 {
            return pos == 0 or self.s[pos - 1] == 10;
        }
        if kind == 3 {
            return pos == n or (pos == n - 1 and self.s[pos] == 10);
        }
        if kind == 4 {
            return pos == n or self.s[pos] == 10;
        }
        if kind == 5 {
            return pos == n;
        }
        if n == 0 {
            return false;
        }
        let before = pos > 0 and is_word(self.s[pos - 1], ascii);
        let after = pos < n and is_word(self.s[pos], ascii);
        if kind == 6 { before != after } else { before == after }
    }

    // Runs the program from pc at pos, backtracking through its own
    // choices only. Returns where it succeeded, or -1.
    fn run(mut ref self, prog: ref Program, pc0: i64, pos0: i64, top: bool) -> i64 {
        let base = self.trail.len();
        let mut choices: Vec[Choice] = Vec.new();
        let mut pc = pc0;
        let mut pos = pos0;
        let mut mode = 0;
        loop {
            let mut ok = true;
            let op = ref prog.ops[pc];
            if mode == 1 {
                // a lazy repeat whose tail failed: try one more item
                mode = 0;
                ok = false;
                if let Op.Until(r, _, max, _, body, _) = op {
                    let count = self.counts[*r] + 1;
                    if not ((count >= *max and *max != maxrepeat()) or pos == self.lasts[*r]) {
                        self.set_count(*r, count);
                        self.set_last(*r, pos);
                        pc = *body;
                        ok = true;
                    }
                }
                if ok {
                    continue;
                }
            } else {
                match op {
                    Op.Lit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) == *c } else { self.s[pos] == *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.NotLit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) != *c } else { self.s[pos] != *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Any => {
                        if pos < self.s.len() and self.s[pos] != 10 {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.AnyAll => {
                        if pos < self.s.len() {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.In(set, icase, ascii) => {
                        if pos < self.s.len() and in_set(prog.sets[*set], self.s[pos], *icase, *ascii) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.At(kind, ascii) => {
                        if self.at(*kind, *ascii, pos) {
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Mark(slot) => {
                        self.set_mark(*slot, pos);
                        if (*slot & 1) == 1 {
                            self.set_lastindex(*slot / 2);
                        }
                        pc += 1;
                    }
                    Op.Split(a, b) => {
                        choices.push(Choice { pc: *b, pos: pos, trail: self.trail.len(), mode: 0 });
                        pc = *a;
                    }
                    Op.Jmp(a) => pc = *a,
                    Op.RepInit(r, until) => {
                        self.set_count(*r, -1);
                        self.set_last(*r, -1);
                        pc = *until;
                    }
                    Op.Until(r, min, max, greedy, body, exit) => {
                        let count = self.counts[*r] + 1;
                        if count < *min {
                            self.set_count(*r, count);
                            pc = *body;
                        } else if *greedy {
                            if (count < *max or *max == maxrepeat()) and pos != self.lasts[*r] {
                                choices.push(Choice { pc: *exit, pos: pos, trail: self.trail.len(), mode: 0 });
                                self.set_count(*r, count);
                                self.set_last(*r, pos);
                                pc = *body;
                            } else {
                                pc = *exit;
                            }
                        } else {
                            choices.push(Choice { pc: pc, pos: pos, trail: self.trail.len(), mode: 1 });
                            pc = *exit;
                        }
                    }
                    Op.Ref(g, icase, ascii) => {
                        let (a, b) = self.group_span(*g);
                        if a < 0 {
                            ok = false;
                        } else {
                            let len = b - a;
                            if pos + len > self.s.len() {
                                ok = false;
                            } else {
                                let mut k = 0;
                                while k < len {
                                    let x = self.s[a + k];
                                    let y = self.s[pos + k];
                                    let eq = if *icase { lower(x, *ascii) == lower(y, *ascii) } else { x == y };
                                    if not eq {
                                        ok = false;
                                        break;
                                    }
                                    k += 1;
                                }
                                if ok {
                                    pos += len;
                                    pc += 1;
                                }
                            }
                        }
                    }
                    Op.Look(width, negative, sub, next) => {
                        let mark = self.trail.len();
                        let from = if *width < 0 { pos } else { pos - *width };
                        let found = from >= 0 and self.run(prog, *sub, from, false) >= 0;
                        if *negative {
                            self.undo_to(mark);
                            if found {
                                ok = false;
                            } else {
                                pc = *next;
                            }
                        } else if found {
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Atomic(sub, next) => {
                        let end = self.run(prog, *sub, pos, false);
                        if end >= 0 {
                            pos = end;
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Exists(g, no) => {
                        let (a, _) = self.group_span(*g);
                        if a >= 0 {
                            pc += 1;
                        } else {
                            pc = *no;
                        }
                    }
                    Op.Fail => ok = false,
                    Op.Succeed => return pos,
                    Op.Match => {
                        if top and ((self.match_all and pos != self.s.len()) or (self.must_advance and pos == self.start)) {
                            ok = false;
                        } else {
                            return pos;
                        }
                    }
                }
            }
            if not ok {
                match choices.pop() {
                    Some(ch) => {
                        self.undo_to(ch.trail);
                        pc = ch.pc;
                        pos = ch.pos;
                        mode = ch.mode;
                    }
                    None => {
                        self.undo_to(base);
                        return -1;
                    }
                }
            }
        }
    }
}

fn in_items(set: ref CharSet, c: i64, ascii: bool) -> bool {
    for item in set.items.iter() {
        let hit = match item {
            Item.Lit(l) => c == *l,
            Item.Range(lo, hi) => c >= *lo and c <= *hi,
            Item.Cat(k) => {
                let kind = *k;
                if kind == 0 {
                    if ascii { c >= 48 and c <= 57 } else { is_decimal(c) }
                } else if kind == 1 {
                    if ascii { not (c >= 48 and c <= 57) } else { not is_decimal(c) }
                } else if kind == 2 {
                    is_space(c, ascii)
                } else if kind == 3 {
                    not is_space(c, ascii)
                } else if kind == 4 {
                    is_word(c, ascii)
                } else {
                    not is_word(c, ascii)
                }
            }
        };
        if hit {
            return true;
        }
    }
    false
}

// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = lower(c, ascii);
        if lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program, s: ref Vec[i64]) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        s: s.clone(),
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn find(m: mut ref Matcher, prog: ref Program, from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= m.s.len() {
        let mut k = 0;
        while k < m.marks.len() {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}

// All the matches finditer gives: each search starts where the last
// match ended, and must move on past an empty one.
fn all_matches(prog: ref Program, s: ref Vec[i64], limit: i64) -> Vec[Found] {
    let mut m = new_matcher(prog, s);
    let mut out: Vec[Found] = Vec.new();
    let mut pos = 0;
    let mut must_advance = false;
    while pos <= s.len() and (limit == 0 or out.len() < limit) {
        match find(mut m, prog, pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    out
}

fn group_text(s: ref Vec[i64], span: (i64, i64), out: mut ref Vec[i64]) {
    let (a, b) = span;
    if a < 0 {
        push_ascii(mut out, "None");
    } else {
        str_repr(slice(s, a, b), mut out);
    }
}

fn span_text(span: (i64, i64)) -> String {
    let (a, b) = span;
    f"({a}, {b})"
}

fn show_match(prog: ref Program, s: ref Vec[i64], found: ref Option[Found], out: mut ref Vec[i64]) {
    let m = match found {
        Some(m) => m,
        None => {
            push_ascii(mut out, "  None\n");
            return;
        }
    };
    push_ascii(mut out, f"  span={span_text((m.start, m.end))} match=");
    str_repr(slice(s, m.start, m.end), mut out);
    out.push(10);
    if prog.groups > 0 {
        push_ascii(mut out, "  groups=(");
        let mut g = 0;
        while g < m.spans.len() {
            if g > 0 {
                push_ascii(mut out, ", ");
            }
            group_text(s, m.spans[g], mut out);
            g += 1;
        }
        if m.spans.len() == 1 {
            push_ascii(mut out, ",");
        }
        push_ascii(mut out, ")\n  spans=[");
        g = 0;
        while g < m.spans.len() {
            if g > 0 {
                push_ascii(mut out, ", ");
            }
            push_ascii(mut out, span_text(m.spans[g]));
            g += 1;
        }
        push_ascii(mut out, "]\n");
    }
    if prog.names.len() > 0 {
        push_ascii(mut out, "  named=");
        group_dict(prog, s, m, mut out);
        out.push(10);
    }
}

fn group_dict(prog: ref Program, s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    out.push(123);
    let mut k = 0;
    while k < prog.names.len() {
        if k > 0 {
            push_ascii(mut out, ", ");
        }
        let (name, g) = ref prog.names[k];
        str_repr(name, mut out);
        push_ascii(mut out, ": ");
        group_text(s, m.spans[g - 1], mut out);
        k += 1;
    }
    out.push(125);
}

// findall's item: the match, the one group, or a tuple of the groups,
// with '' for a group that did not take part.
fn findall_item(prog: ref Program, s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    if prog.groups == 0 {
        str_repr(slice(s, m.start, m.end), mut out);
        return;
    }
    if prog.groups > 1 {
        out.push(40);
    }
    let mut g = 0;
    while g < m.spans.len() {
        if g > 0 {
            push_ascii(mut out, ", ");
        }
        let (a, b) = m.spans[g];
        if a < 0 {
            push_ascii(mut out, "''");
        } else {
            str_repr(slice(s, a, b), mut out);
        }
        g += 1;
    }
    if prog.groups > 1 {
        out.push(41);
    }
}

// A replacement template: literal text and group numbers.
enum Piece {
    Text(Vec[i64]),
    Group(i64),
}

// _parser.parse_template.
fn parse_template(repl: ref Vec[i64], prog: ref Program) -> Result[Vec[Piece], ReErr] {
    let mut s = new_tokenizer(repl)?;
    let mut pieces: Vec[Piece] = Vec.new();
    let mut literal: Vec[i64] = Vec.new();
    loop {
        let this = s.get()?;
        if this.n == 0 {
            break;
        }
        if this.n == 1 {
            literal.push(this.a);
            continue;
        }
        let c = this.b;
        let mut index = -1;
        let mut offset = 0;
        if c == 103 {
            if not s.take(60)? {
                return Err(s.error("missing <".to_string(), 0));
            }
            let name = s.getuntil(62, "group name")?;
            if not is_ascii_decimal(name) {
                s.checkgroupname(name, 1)?;
                let mut found = -1;
                for (n, g) in prog.names.iter() {
                    if same(n, name) {
                        found = *g;
                    }
                }
                if found < 0 {
                    return Err(other_error("IndexError", f"unknown group name {repr_of(name)}"));
                }
                index = found;
            } else {
                if name.len() > 10 or digits_value(name, 0, 10) >= maxgroups() {
                    return Err(s.error(f"invalid group reference {to_string(name)}", name.len() + 1));
                }
                index = digits_value(name, 0, 10);
            }
            offset = name.len() + 1;
        } else if c == 48 {
            let mut text = tok_text(this);
            if s.next.n == 1 and is_oct(s.next.a) {
                text.push(s.get()?.a);
                if s.next.n == 1 and is_oct(s.next.a) {
                    text.push(s.get()?.a);
                }
            }
            literal.push(digits_value(text, 1, 8) & 0xFF);
            continue;
        } else if is_dec(c) {
            let mut text = tok_text(this);
            if s.next.n == 1 and is_dec(s.next.a) {
                text.push(s.get()?.a);
                if is_oct(c) and is_oct(text[2]) and s.next.n == 1 and is_oct(s.next.a) {
                    text.push(s.get()?.a);
                    let v = digits_value(text, 1, 8);
                    if v > 0o377 {
                        return Err(s.error(f"octal escape value {to_string(text)} outside of range 0-0o377", text.len()));
                    }
                    literal.push(v);
                    continue;
                }
            }
            index = digits_value(text, 1, 10);
            offset = text.len() - 1;
        } else {
            let e = escape_value(this);
            if e >= 0 {
                literal.push(e);
            } else if is_ascii_letter(c) {
                return Err(s.error(f"bad escape {to_string(tok_text(this))}", 2));
            } else {
                literal.push(92);
                literal.push(c);
            }
            continue;
        }
        if index > prog.groups {
            return Err(s.error(f"invalid group reference {index}", offset));
        }
        pieces.push(Piece.Text(literal));
        literal = Vec.new();
        pieces.push(Piece.Group(index));
    }
    pieces.push(Piece.Text(literal));
    Ok(pieces)
}

fn expand(pieces: ref Vec[Piece], s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    for piece in pieces.iter() {
        match piece {
            Piece.Text(t) => push_all(mut out, t),
            Piece.Group(g) => {
                let (a, b) = if *g == 0 { (m.start, m.end) } else { m.spans[*g - 1] };
                if a >= 0 {
                    push_all(mut out, slice(s, a, b));
                }
            }
        }
    }
}


// --------------------------------------------------- Unicode strings
fn cp(s: Str) -> Vec[i64] {
    codepoints(s.bytes())
}


// ---------------------------------------------------------------- html.parser
// (mini_htmlparser's port of Python 3.13's html/parser.py)

// ---------------------------------------------------------------- chars

fn hp_is_space(c: char) -> bool {
    c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == '\u{c}'
}

fn hp_is_alpha(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')
}

fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn hp_is_hex(c: char) -> bool {
    is_digit(c) or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F')
}

fn is_alnum(c: char) -> bool {
    hp_is_alpha(c) or is_digit(c)
}

fn ascii_lower(c: char) -> char {
    if c >= 'A' and c <= 'Z' {
        match char.try_from(c as i64 + 32) {
            Ok(l) => l,
            Err(_) => c,
        }
    } else {
        c
    }
}

fn to_chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn hp_text(raw: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut s = String.new();
    let mut k = lo;
    while k < hi {
        s.push(raw[k]);
        k += 1;
    }
    s
}

// raw[i..] starts with s.
fn at(raw: ref Vec[char], i: i64, s: ref String) -> bool {
    let mut k = i;
    for c in s.chars() {
        if k >= raw.len() or raw[k] != c {
            return false;
        }
        k += 1;
    }
    true
}

// raw[i..] starts with s, ignoring ASCII case.
fn at_nocase(raw: ref Vec[char], i: i64, s: ref String) -> bool {
    let mut k = i;
    for c in s.chars() {
        if k >= raw.len() or ascii_lower(raw[k]) != ascii_lower(c) {
            return false;
        }
        k += 1;
    }
    true
}

fn find_char(raw: ref Vec[char], c: char, from: i64) -> i64 {
    let mut k = from;
    while k < raw.len() {
        if raw[k] == c {
            return k;
        }
        k += 1;
    }
    -1
}

fn find_str(raw: ref Vec[char], s: ref String, from: i64) -> i64 {
    let mut k = from;
    while k < raw.len() {
        if at(raw, k, s) {
            return k;
        }
        k += 1;
    }
    -1
}

// ---------------------------------------------------------------- html.escape / html.unescape

fn hp_escape(s: ref String, quote: bool) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c == '&' {
            out.push_str("&amp;");
        } else if c == '<' {
            out.push_str("&lt;");
        } else if c == '>' {
            out.push_str("&gt;");
        } else if quote and c == '"' {
            out.push_str("&quot;");
        } else if quote and c == '\'' {
            out.push_str("&#x27;");
        } else {
            out.push(c);
        }
    }
    out
}

// The numeric-character-reference-end-state table of html/__init__.py.
fn invalid_charref(num: i64) -> Option[i64] {
    if num == 0 {
        return Some(0xfffd);
    }
    if num == 0x0d {
        return Some(0x0d);
    }
    if num < 0x80 or num > 0x9f {
        return None;
    }
    let table: Vec[i64] = vec![
        0x20ac, 0x81, 0x201a, 0x0192, 0x201e, 0x2026, 0x2020, 0x2021,
        0x02c6, 0x2030, 0x0160, 0x2039, 0x0152, 0x8d, 0x017d, 0x8f,
        0x90, 0x2018, 0x2019, 0x201c, 0x201d, 0x2022, 0x2013, 0x2014,
        0x02dc, 0x2122, 0x0161, 0x203a, 0x0153, 0x9d, 0x017e, 0x0178,
    ];
    Some(table[num - 0x80])
}

fn invalid_codepoint(num: i64) -> bool {
    if (num >= 0x1 and num <= 0x8) or num == 0xb or (num >= 0xe and num <= 0x1f) {
        return true;
    }
    if (num >= 0x7f and num <= 0x9f) or (num >= 0xfdd0 and num <= 0xfdef) {
        return true;
    }
    num % 0x10000 >= 0xfffe and num <= 0x10ffff
}

fn push_code(out: mut ref String, num: i64) {
    match char.try_from(num) {
        Ok(c) => out.push(c),
        Err(_) => out.push('\u{fffd}'),
    }
}

fn numeric_ref(num: i64, out: mut ref String) {
    match invalid_charref(num) {
        Some(v) => {
            push_code(mut out, v);
            return;
        }
        None => {}
    }
    if (num >= 0xd800 and num <= 0xdfff) or num > 0x10ffff {
        out.push('\u{fffd}');
        return;
    }
    if invalid_codepoint(num) {
        return;
    }
    push_code(mut out, num);
}

// The digits raw[lo..hi] in base 10 or 16, held at 0x110000 once past
// the last code point, as int() then the range check would decide.
fn ref_number(raw: ref Vec[char], lo: i64, hi: i64, base: i64) -> i64 {
    let mut n = 0;
    let mut k = lo;
    while k < hi {
        let c = raw[k];
        let d = if is_digit(c) {
            c as i64 - '0' as i64
        } else {
            ascii_lower(c) as i64 - 'a' as i64 + 10
        };
        n = n * base + d;
        if n > 0x10ffff {
            n = 0x110000;
        }
        k += 1;
    }
    n
}

// A named reference's text, the name possibly ending in ';'.
fn named_ref(name: ref Vec[char], ents: ref Map[String, String], out: mut ref String) {
    let whole = hp_text(name, 0, name.len());
    match ents.get(whole.clone()) {
        Some(v) => {
            out.push_str(v);
            return;
        }
        None => {}
    }
    // The longest name the standard allows as a prefix.
    let mut x = name.len() - 1;
    while x > 1 {
        match ents.get(hp_text(name, 0, x)) {
            Some(v) => {
                out.push_str(v);
                out.push_str(hp_text(name, x, name.len()));
                return;
            }
            None => {}
        }
        x -= 1;
    }
    out.push('&');
    out.push_str(whole);
}

fn named_class(c: char) -> bool {
    not (c == '\t' or c == '\n' or c == '\u{c}' or c == ' ' or c == '<' or c == '&' or c == '#' or c == ';')
}

// html.unescape over raw[lo..hi].
fn unescape_chars(raw: ref Vec[char], lo: i64, hi: i64, ents: ref Map[String, String]) -> String {
    let mut out = String.new();
    let mut p = lo;
    while p < hi {
        if raw[p] != '&' {
            out.push(raw[p]);
            p += 1;
            continue;
        }
        if p + 1 < hi and raw[p + 1] == '#' {
            if p + 2 < hi and is_digit(raw[p + 2]) {
                let mut q = p + 2;
                while q < hi and is_digit(raw[q]) {
                    q += 1;
                }
                numeric_ref(ref_number(raw, p + 2, q, 10), mut out);
                if q < hi and raw[q] == ';' {
                    q += 1;
                }
                p = q;
            } else if p + 3 < hi and (raw[p + 2] == 'x' or raw[p + 2] == 'X') and hp_is_hex(raw[p + 3]) {
                let mut q = p + 3;
                while q < hi and hp_is_hex(raw[q]) {
                    q += 1;
                }
                numeric_ref(ref_number(raw, p + 3, q, 16), mut out);
                if q < hi and raw[q] == ';' {
                    q += 1;
                }
                p = q;
            } else {
                out.push('&');
                p += 1;
            }
            continue;
        }
        let mut q = p + 1;
        while q < hi and q - (p + 1) < 32 and named_class(raw[q]) {
            q += 1;
        }
        if q == p + 1 {
            out.push('&');
            p += 1;
            continue;
        }
        if q < hi and raw[q] == ';' {
            q += 1;
        }
        let name: Vec[char] = raw[p + 1..q].iter().collect();
        named_ref(name, ents, mut out);
        p = q;
    }
    out
}

fn unescape(s: ref String, ents: ref Map[String, String]) -> String {
    let raw = to_chars(s);
    unescape_chars(raw, 0, raw.len(), ents)
}

// _unescape_attrvalue: numeric references always, named ones only when
// the whole name is in the table and no '=' follows.
fn unescape_attr(s: ref String, ents: ref Map[String, String]) -> String {
    let raw = to_chars(s);
    let n = raw.len();
    let mut out = String.new();
    let mut p = 0;
    while p < n {
        if raw[p] != '&' {
            out.push(raw[p]);
            p += 1;
            continue;
        }
        let mut q = p + 1;
        let mut numeric = false;
        if q < n and raw[q] == '#' {
            if q + 1 < n and is_digit(raw[q + 1]) {
                q += 1;
                while q < n and is_digit(raw[q]) {
                    q += 1;
                }
                numeric = true;
            } else if q + 2 < n and (raw[q + 1] == 'x' or raw[q + 1] == 'X') and hp_is_hex(raw[q + 2]) {
                q += 2;
                while q < n and hp_is_hex(raw[q]) {
                    q += 1;
                }
                numeric = true;
            } else {
                out.push('&');
                p += 1;
                continue;
            }
        } else if q < n and hp_is_alpha(raw[q]) {
            while q < n and is_alnum(raw[q]) {
                q += 1;
            }
        } else {
            out.push('&');
            p += 1;
            continue;
        }
        let mut eq = false;
        if q < n and (raw[q] == ';' or raw[q] == '=') {
            eq = raw[q] == '=';
            q += 1;
        }
        let r = hp_text(raw, p, q);
        if numeric {
            out.push_str(unescape_chars(raw, p, q, ents));
        } else if not eq and ents.contains_key(hp_text(raw, p + 1, q)) {
            out.push_str(unescape_chars(raw, p, q, ents));
        } else {
            out.push_str(r);
        }
        p = q;
    }
    out
}

// ---------------------------------------------------------------- the tokenizer's patterns

// The end of locatetagend's match at p (a tag name's first letter).
fn locate_tag_end(raw: ref Vec[char], p: i64) -> i64 {
    let n = raw.len();
    let mut k = p + 1;
    while k < n and not (hp_is_space(raw[k]) or raw[k] == '/' or raw[k] == '>') {
        k += 1;
    }
    while k < n and (hp_is_space(raw[k]) or raw[k] == '/') {
        k += 1;
    }
    loop {
        if k >= n or not after_attr_gap(raw[k - 1]) {
            break;
        }
        let c = raw[k];
        if hp_is_space(c) or c == '/' or c == '>' {
            break;
        }
        k = attr_name_end(raw, k);
        match value_indicator(raw, k) {
            Some(v) => k = v.2,
            None => {}
        }
        while k < n and (hp_is_space(raw[k]) or raw[k] == '/') {
            k += 1;
        }
    }
    if k < n and raw[k] == '>' {
        k += 1;
    }
    k
}

// The lookbehind before an attribute name: ['"\t\n\r\f /].
fn after_attr_gap(c: char) -> bool {
    c == '\'' or c == '"' or hp_is_space(c) or c == '/'
}

fn attr_name_end(raw: ref Vec[char], k: i64) -> i64 {
    let n = raw.len();
    let mut e = k + 1;
    while e < n and not (hp_is_space(raw[e]) or raw[e] == '/' or raw[e] == '=' or raw[e] == '>') {
        e += 1;
    }
    e
}

// A value at b: 'x', "x" or a bare run; None when a quote opens and never
// closes.
fn value_at(raw: ref Vec[char], b: i64) -> Option[i64] {
    let n = raw.len();
    if b < n and (raw[b] == '\'' or raw[b] == '"') {
        let q = find_char(raw, raw[b], b + 1);
        if q < 0 {
            return None;
        }
        return Some(q + 1);
    }
    let mut e = b;
    while e < n and not (raw[e] == '>' or hp_is_space(raw[e])) {
        e += 1;
    }
    Some(e)
}

// `[\t\n\r\f ]*=[\t\n\r\f ]*` and a value after an attribute name ending
// at k: (value start, value end, match end), backtracking the way re does
// when a quote never closes.
fn value_indicator(raw: ref Vec[char], k: i64) -> Option[(i64, i64, i64)] {
    let n = raw.len();
    let mut a = k;
    while a < n and hp_is_space(raw[a]) {
        a += 1;
    }
    if a >= n or raw[a] != '=' {
        return None;
    }
    let mut b = a + 1;
    while b < n and hp_is_space(raw[b]) {
        b += 1;
    }
    match value_at(raw, b) {
        Some(e) => Some((b, e, e)),
        None => {
            if b > a + 1 {
                // One space fewer, and the value is the empty bare run.
                Some((b - 1, b - 1, b - 1))
            } else {
                None
            }
        }
    }
}

struct Attr {
    name: String,
    value: Option[String],
}

// ---------------------------------------------------------------- events

enum Event {
    Start(String, Vec[Attr]),
    StartEnd(String, Vec[Attr]),
    End(String),
    Data(String),
    Comment(String),
    Decl(String),
    Pi(String),
    UnknownDecl(String),
    CharRef(String),
    EntityRef(String),
}

struct Ev {
    line: i64,
    col: i64,
    ev: Event,
}

// ---------------------------------------------------------------- HTMLParser

struct HtmlParser {
    convert_charrefs: bool,
    raw: Vec[char],
    lineno: i64,
    offset: i64,
    lasttag: String,
    cdata_elem: String,
    escapable: bool,
    support_cdata: bool,
    pending: Vec[char],
    pending_len: i64,
    parse_threshold: i64,
    starttag_text: Option[String],
    events: Vec[Ev],
}

fn is_cdata_content(tag: ref String) -> bool {
    tag == "script" or tag == "style" or tag == "xmp" or tag == "iframe" or tag == "noembed" or tag == "noframes"
}

impl HtmlParser {
    fn new(convert_charrefs: bool) -> HtmlParser {
        HtmlParser {
            convert_charrefs: convert_charrefs,
            raw: Vec.new(),
            lineno: 1,
            offset: 0,
            lasttag: "???".to_string(),
            cdata_elem: String.new(),
            escapable: true,
            support_cdata: true,
            pending: Vec.new(),
            pending_len: 0,
            parse_threshold: 1,
            starttag_text: None,
            events: Vec.new(),
        }
    }

    fn emit(mut ref self, ev: own Event) {
        self.events.push(Ev { line: self.lineno, col: self.offset, ev: ev });
    }

    fn feed(mut ref self, data: ref Vec[char], ents: ref Map[String, String]) {
        self.pending_len += data.len();
        if self.pending_len < self.parse_threshold {
            for c in data.iter() {
                self.pending.push(*c);
            }
            return;
        }
        for c in self.pending.iter() {
            self.raw.push(*c);
        }
        for c in data.iter() {
            self.raw.push(*c);
        }
        self.pending.clear();
        self.pending_len = 0;
        let n = self.raw.len();
        self.goahead(false, ents);
        if self.raw.len() < n {
            self.parse_threshold = 1;
        } else {
            self.parse_threshold = self.raw.len();
        }
    }

    fn close(mut ref self, ents: ref Map[String, String]) {
        if self.pending.len() > 0 {
            for c in self.pending.iter() {
                self.raw.push(*c);
            }
            self.pending.clear();
            self.pending_len = 0;
        }
        self.goahead(true, ents);
    }

    fn getpos(ref self) -> (i64, i64) {
        (self.lineno, self.offset)
    }

    fn updatepos(mut ref self, i: i64, j: i64) -> i64 {
        if i >= j {
            return j;
        }
        let mut nlines = 0;
        let mut last = -1;
        let mut k = i;
        while k < j {
            if self.raw[k] == '\n' {
                nlines += 1;
                last = k;
            }
            k += 1;
        }
        if nlines > 0 {
            self.lineno += nlines;
            self.offset = j - (last + 1);
        } else {
            self.offset += j - i;
        }
        j
    }

    fn set_cdata_mode(mut ref self, elem: ref String, escapable: bool) {
        self.cdata_elem = elem.to_lowercase();
        self.escapable = escapable;
    }

    fn clear_cdata_mode(mut ref self) {
        self.cdata_elem = String.new();
        self.escapable = true;
    }

    // self.interesting.search(rawdata, i): the start of the match, or -1.
    fn interesting(ref self, i: i64) -> i64 {
        let n = self.raw.len();
        if self.cdata_elem == "plaintext" {
            return n;
        }
        let mut p = i;
        while p < n {
            let c = self.raw[p];
            if self.cdata_elem == "" {
                if c == '<' or c == '&' {
                    return p;
                }
            } else {
                if self.escapable and not self.convert_charrefs and c == '&' {
                    return p;
                }
                if c == '<' and p + 1 < n and self.raw[p + 1] == '/' and at_nocase(self.raw, p + 2, self.cdata_elem) {
                    let after = p + 2 + self.cdata_elem.chars().count();
                    if after < n and (hp_is_space(self.raw[after]) or self.raw[after] == '/' or self.raw[after] == '>') {
                        return p;
                    }
                }
            }
            p += 1;
        }
        -1
    }

    fn data(mut ref self, lo: i64, hi: i64, ents: ref Map[String, String]) {
        let s = if self.convert_charrefs and self.escapable {
            unescape_chars(self.raw, lo, hi, ents)
        } else {
            hp_text(self.raw, lo, hi)
        };
        self.emit(Event.Data(s));
    }

    fn goahead(mut ref self, end: bool, ents: ref Map[String, String]) {
        let n = self.raw.len();
        let mut i = 0;
        while i < n {
            let mut j = n;
            if self.convert_charrefs and self.cdata_elem == "" {
                let lt = find_char(self.raw, '<', i);
                if lt < 0 {
                    // A reference may be cut in half at the end of the buffer.
                    let lo = if i > n - 34 { i } else { n - 34 };
                    let mut amppos = -1;
                    let mut k = n - 1;
                    while k >= lo {
                        if self.raw[k] == '&' {
                            amppos = k;
                            break;
                        }
                        k -= 1;
                    }
                    if amppos >= 0 {
                        let mut ended = false;
                        let mut q = amppos;
                        while q < n {
                            let c = self.raw[q];
                            if hp_is_space(c) or c == ';' {
                                ended = true;
                                break;
                            }
                            q += 1;
                        }
                        if not ended {
                            break;
                        }
                    }
                    j = n;
                } else {
                    j = lt;
                }
            } else {
                let m = self.interesting(i);
                if m >= 0 {
                    j = m;
                } else {
                    if self.cdata_elem != "" {
                        break;
                    }
                    j = n;
                }
            }
            if i < j {
                self.data(i, j, ents);
            }
            i = self.updatepos(i, j);
            if i == n {
                break;
            }
            if self.raw[i] == '<' {
                let mut k = 0;
                if i + 1 < n and hp_is_alpha(self.raw[i + 1]) {
                    k = self.parse_starttag(i, ents);
                } else if at(self.raw, i, "</") {
                    k = self.parse_endtag(i);
                } else if at(self.raw, i, "<!--") {
                    k = self.parse_comment(i);
                } else if at(self.raw, i, "<?") {
                    k = self.parse_pi(i);
                } else if at(self.raw, i, "<!") {
                    k = self.parse_html_declaration(i);
                } else if i + 1 < n or end {
                    self.emit(Event.Data("<".to_string()));
                    k = i + 1;
                } else {
                    break;
                }
                if k < 0 {
                    if not end {
                        break;
                    }
                    self.flush_unterminated(i);
                    k = n;
                }
                i = self.updatepos(i, k);
            } else if at(self.raw, i, "&#") {
                match self.match_charref(i) {
                    Some((name, e)) => {
                        self.emit(Event.CharRef(name));
                        let mut k = e;
                        if self.raw[k - 1] != ';' {
                            k -= 1;
                        }
                        i = self.updatepos(i, k);
                        continue;
                    }
                    None => {}
                }
                let incomplete = i + 2 < n and (is_digit(self.raw[i + 2])
                    or (i + 3 < n and (self.raw[i + 2] == 'x' or self.raw[i + 2] == 'X') and hp_is_hex(self.raw[i + 3])));
                if incomplete {
                    if end {
                        let name = hp_text(self.raw, i + 2, n);
                        self.emit(Event.CharRef(name));
                        i = self.updatepos(i, n);
                    }
                    break;
                } else if i + 3 < n {
                    self.emit(Event.Data("&#".to_string()));
                    i = self.updatepos(i, i + 2);
                } else {
                    break;
                }
            } else if self.raw[i] == '&' {
                match self.match_entityref(i) {
                    Some((name, e)) => {
                        self.emit(Event.EntityRef(name));
                        let mut k = e;
                        if self.raw[k - 1] != ';' {
                            k -= 1;
                        }
                        i = self.updatepos(i, k);
                        continue;
                    }
                    None => {}
                }
                let incomplete = i + 1 < n and (hp_is_alpha(self.raw[i + 1]) or self.raw[i + 1] == '#');
                if incomplete {
                    if end {
                        let name = hp_text(self.raw, i + 1, n);
                        self.emit(Event.EntityRef(name));
                        i = self.updatepos(i, n);
                    }
                    break;
                } else if i + 1 < n {
                    self.emit(Event.Data("&".to_string()));
                    i = self.updatepos(i, i + 1);
                } else {
                    break;
                }
            } else {
                panic("interesting.search() lied");
            }
        }
        if end and i < n {
            self.data(i, n, ents);
            i = self.updatepos(i, n);
        }
        self.raw = self.raw[i..].iter().collect();
    }

    // What goahead does at EOF with a construct that never ended.
    fn flush_unterminated(mut ref self, i: i64) {
        let n = self.raw.len();
        if i + 1 < n and hp_is_alpha(self.raw[i + 1]) {
            return;
        }
        if at(self.raw, i, "</") {
            if i + 2 == n {
                self.emit(Event.Data("</".to_string()));
            } else if i + 2 < n and hp_is_alpha(self.raw[i + 2]) {
                return;
            } else {
                let s = hp_text(self.raw, i + 2, n);
                self.emit(Event.Comment(s));
            }
        } else if at(self.raw, i, "<!--") {
            let mut j = n;
            let suffixes: Vec[String] = vec!["--!".to_string(), "--".to_string(), "-".to_string()];
            for suffix in suffixes.iter() {
                let len = suffix.chars().count();
                if n - (i + 4) >= len and at(self.raw, n - len, suffix) {
                    j -= len;
                    break;
                }
            }
            let s = hp_text(self.raw, i + 4, j);
            self.emit(Event.Comment(s));
        } else if at(self.raw, i, "<![CDATA[") and self.support_cdata {
            let s = hp_text(self.raw, i + 3, n);
            self.emit(Event.UnknownDecl(s));
        } else if at_nocase(self.raw, i, "<!doctype") {
            let s = hp_text(self.raw, i + 2, n);
            self.emit(Event.Decl(s));
        } else if at(self.raw, i, "<!") {
            let s = hp_text(self.raw, i + 2, n);
            self.emit(Event.Comment(s));
        } else if at(self.raw, i, "<?") {
            let s = hp_text(self.raw, i + 2, n);
            self.emit(Event.Pi(s));
        } else {
            panic("we should not get here!");
        }
    }

    // charref: &#(?:[0-9]+|[xX][0-9a-fA-F]+)[^0-9a-fA-F] at i.
    fn match_charref(ref self, i: i64) -> Option[(String, i64)] {
        let n = self.raw.len();
        let mut q = i + 2;
        if q < n and is_digit(self.raw[q]) {
            while q < n and is_digit(self.raw[q]) {
                q += 1;
            }
        } else if q + 1 < n and (self.raw[q] == 'x' or self.raw[q] == 'X') and hp_is_hex(self.raw[q + 1]) {
            q += 1;
            while q < n and hp_is_hex(self.raw[q]) {
                q += 1;
            }
        } else {
            return None;
        }
        if q >= n or hp_is_hex(self.raw[q]) {
            return None;
        }
        Some((hp_text(self.raw, i + 2, q), q + 1))
    }

    // entityref: &([a-zA-Z][-.a-zA-Z0-9]*)[^a-zA-Z0-9] at i, giving back
    // name characters when the buffer ends inside the name.
    fn match_entityref(ref self, i: i64) -> Option[(String, i64)] {
        let n = self.raw.len();
        if i + 1 >= n or not hp_is_alpha(self.raw[i + 1]) {
            return None;
        }
        let mut e = i + 2;
        while e < n and (is_alnum(self.raw[e]) or self.raw[e] == '-' or self.raw[e] == '.') {
            e += 1;
        }
        if e < n {
            return Some((hp_text(self.raw, i + 1, e), e + 1));
        }
        let mut b = e - 1;
        while b > i + 1 {
            if not is_alnum(self.raw[b]) {
                return Some((hp_text(self.raw, i + 1, b), b + 1));
            }
            b -= 1;
        }
        None
    }

    fn parse_html_declaration(mut ref self, i: i64) -> i64 {
        if at(self.raw, i, "<!--") {
            return self.parse_comment(i);
        } else if at(self.raw, i, "<![CDATA[") and self.support_cdata {
            let j = find_str(self.raw, "]]>", i + 9);
            if j < 0 {
                return -1;
            }
            let s = hp_text(self.raw, i + 3, j);
            self.emit(Event.UnknownDecl(s));
            return j + 3;
        } else if at_nocase(self.raw, i, "<!doctype") {
            let gtpos = find_char(self.raw, '>', i + 9);
            if gtpos < 0 {
                return -1;
            }
            let s = hp_text(self.raw, i + 2, gtpos);
            self.emit(Event.Decl(s));
            return gtpos + 1;
        }
        self.parse_bogus_comment(i)
    }

    fn parse_comment(mut ref self, i: i64) -> i64 {
        let n = self.raw.len();
        let mut start = -1;
        let mut stop = -1;
        // An empty comment is closed by the first ">" or "->".
        if i + 4 < n and self.raw[i + 4] == '>' {
            start = i + 4;
            stop = i + 5;
        } else if i + 5 < n and self.raw[i + 4] == '-' and self.raw[i + 5] == '>' {
            start = i + 4;
            stop = i + 6;
        } else {
            let mut p = i + 4;
            while p + 2 < n {
                if self.raw[p] == '-' and self.raw[p + 1] == '-' {
                    if self.raw[p + 2] == '>' {
                        start = p;
                        stop = p + 3;
                        break;
                    }
                    if p + 3 < n and self.raw[p + 2] == '!' and self.raw[p + 3] == '>' {
                        start = p;
                        stop = p + 4;
                        break;
                    }
                }
                p += 1;
            }
            if start < 0 {
                return -1;
            }
        }
        let s = hp_text(self.raw, i + 4, start);
        self.emit(Event.Comment(s));
        stop
    }

    fn parse_bogus_comment(mut ref self, i: i64) -> i64 {
        let pos = find_char(self.raw, '>', i + 2);
        if pos < 0 {
            return -1;
        }
        let s = hp_text(self.raw, i + 2, pos);
        self.emit(Event.Comment(s));
        pos + 1
    }

    fn parse_pi(mut ref self, i: i64) -> i64 {
        let j = find_char(self.raw, '>', i + 2);
        if j < 0 {
            return -1;
        }
        let s = hp_text(self.raw, i + 2, j);
        self.emit(Event.Pi(s));
        j + 1
    }

    fn parse_starttag(mut ref self, i: i64, ents: ref Map[String, String]) -> i64 {
        self.starttag_text = None;
        let endpos = locate_tag_end(self.raw, i + 1);
        if self.raw[endpos - 1] != '>' {
            return -1;
        }
        self.starttag_text = Some(hp_text(self.raw, i, endpos));
        let n = self.raw.len();

        // tagfind_tolerant
        let mut k = i + 2;
        while k < n and not (hp_is_space(self.raw[k]) or self.raw[k] == '/' or self.raw[k] == '>') {
            k += 1;
        }
        let tag = hp_text(self.raw, i + 1, k).to_lowercase();
        k = skip_attr_gap(self.raw, k);
        self.lasttag = tag.clone();

        let mut attrs: Vec[Attr] = Vec.new();
        while k < endpos {
            // attrfind_tolerant
            if not after_attr_gap(self.raw[k - 1]) {
                break;
            }
            let c = self.raw[k];
            if hp_is_space(c) or c == '/' or c == '>' {
                break;
            }
            let ne = attr_name_end(self.raw, k);
            let name = hp_text(self.raw, k, ne).to_lowercase();
            let mut value: Option[String] = None;
            let mut m = ne;
            match value_indicator(self.raw, ne) {
                Some((vs, ve, e)) => {
                    let mut v = hp_text(self.raw, vs, ve);
                    if ve - vs >= 2 and (self.raw[vs] == '\'' or self.raw[vs] == '"') and self.raw[ve - 1] == self.raw[vs] {
                        v = hp_text(self.raw, vs + 1, ve - 1);
                    }
                    if v.len() > 0 {
                        v = unescape_attr(v, ents);
                    }
                    value = Some(v);
                    m = e;
                }
                None => {}
            }
            attrs.push(Attr { name: name, value: value });
            k = skip_attr_gap(self.raw, m);
        }

        let tail = hp_text(self.raw, k, endpos);
        let end = tail.trim();
        if end != ">" and end != "/>" {
            let s = hp_text(self.raw, i, endpos);
            self.emit(Event.Data(s));
            return endpos;
        }
        if end == "/>" {
            self.emit(Event.StartEnd(tag, attrs));
        } else {
            self.emit(Event.Start(tag.clone(), attrs));
            if is_cdata_content(tag) or tag == "plaintext" {
                self.set_cdata_mode(tag, false);
            } else if tag == "textarea" or tag == "title" {
                self.set_cdata_mode(tag, true);
            }
        }
        endpos
    }

    fn parse_endtag(mut ref self, i: i64) -> i64 {
        let n = self.raw.len();
        if find_char(self.raw, '>', i + 2) < 0 {
            return -1;
        }
        if not (i + 2 < n and hp_is_alpha(self.raw[i + 2])) {
            if self.raw[i + 2] == '>' {
                // "</>" is ignored.
                return i + 3;
            }
            return self.parse_bogus_comment(i);
        }
        let j = locate_tag_end(self.raw, i + 2);
        if self.raw[j - 1] != '>' {
            return -1;
        }
        let mut k = i + 3;
        while k < n and not (hp_is_space(self.raw[k]) or self.raw[k] == '/' or self.raw[k] == '>') {
            k += 1;
        }
        let tag = hp_text(self.raw, i + 2, k).to_lowercase();
        self.emit(Event.End(tag));
        self.clear_cdata_mode();
        j
    }
}

// (?:[\t\n\r\f ]|/(?!>))*
fn skip_attr_gap(raw: ref Vec[char], from: i64) -> i64 {
    let n = raw.len();
    let mut k = from;
    while k < n {
        if hp_is_space(raw[k]) {
            k += 1;
        } else if raw[k] == '/' and not (k + 1 < n and raw[k + 1] == '>') {
            k += 1;
        } else {
            break;
        }
    }
    k
}

fn parse_all(src: ref String, convert: bool, chunk: i64, ents: ref Map[String, String]) -> HtmlParser {
    let mut p = HtmlParser.new(convert);
    let chars = to_chars(src);
    if chunk == 0 {
        p.feed(chars, ents);
    } else {
        let mut k = 0;
        while k < chars.len() {
            let hi = if k + chunk < chars.len() { k + chunk } else { chars.len() };
            let piece: Vec[char] = chars[k..hi].iter().collect();
            p.feed(piece, ents);
            k = hi;
        }
    }
    p.close(ents);
    p
}

// ---------------------------------------------------------------- printing



// ---------------------------------------------------------------- the tree

// What bs4 builds: Tag, NavigableString and the string subclasses
// soupsieve tells apart. Script, Stylesheet and the other container
// strings are plain text to it.
fn k_tag() -> i64 { 0 }
fn k_text() -> i64 { 1 }
fn k_comment() -> i64 { 2 }
fn k_doctype() -> i64 { 3 }
fn k_cdata() -> i64 { 4 }
fn k_pi() -> i64 { 5 }
fn k_decl() -> i64 { 6 }

struct DNode {
    kind: i64,
    name: String,
    // attribute names and values, in first-seen order
    attr_names: Vec[String],
    attr_values: Vec[String],
    // whether bs4 splits the value into a list (class, rel, ...)
    attr_multi: Vec[bool],
    text: String,
    parent: i64,
    children: Vec[i64],
    // this node's index in its parent's children
    index: i64,
}

struct Soup {
    nodes: Vec[DNode],
}

impl Soup {
    fn is_tag(ref self, n: i64) -> bool {
        n >= 0 and self.nodes[n].kind == k_tag()
    }

    // The tag name, or "" for a string (whose name is None).
    fn name(ref self, n: i64) -> String {
        if self.is_tag(n) { self.nodes[n].name.clone() } else { String.new() }
    }

    fn get(ref self, n: i64, attr: Str) -> Option[String] {
        let node = ref self.nodes[n];
        let mut i = 0;
        while i < node.attr_names.len() {
            if node.attr_names[i] == attr {
                return Some(node.attr_values[i].clone());
            }
            i += 1;
        }
        None
    }

    // attrs.get(attr) or ''
    fn attr_or_empty(ref self, n: i64, attr: Str) -> String {
        self.get(n, attr).unwrap_or(String.new())
    }

    fn parent(ref self, n: i64) -> i64 {
        self.nodes[n].parent
    }

    fn previous_sibling(ref self, n: i64) -> i64 {
        let p = self.nodes[n].parent;
        let i = self.nodes[n].index;
        if p < 0 or i == 0 { -1 } else { self.nodes[p].children[i - 1] }
    }

    fn next_sibling(ref self, n: i64) -> i64 {
        let p = self.nodes[n].parent;
        let i = self.nodes[n].index;
        if p < 0 or i + 1 >= self.nodes[p].children.len() { -1 } else { self.nodes[p].children[i + 1] }
    }

    // find_previous_sibling() with no filter: the nearest earlier Tag.
    fn previous_tag_sibling(ref self, n: i64) -> i64 {
        let mut s = self.previous_sibling(n);
        while s >= 0 and not self.is_tag(s) {
            s = self.previous_sibling(s);
        }
        s
    }

    fn previous_siblings_named(ref self, n: i64, name: Str) -> i64 {
        let mut count = 0;
        let mut s = self.previous_sibling(n);
        while s >= 0 {
            if self.is_tag(s) and self.nodes[s].name == name {
                count += 1;
            }
            s = self.previous_sibling(s);
        }
        count
    }

    fn find_parent(ref self, n: i64, name: Str) -> bool {
        let mut p = self.nodes[n].parent;
        while p >= 0 {
            if self.nodes[p].name == name {
                return true;
            }
            p = self.nodes[p].parent;
        }
        false
    }

    // find_all(names): the descendant tags with one of the names, in
    // document order.
    fn find_all(ref self, n: i64, names: ref Vec[String], out: mut ref Vec[i64]) {
        for c in self.nodes[n].children.iter() {
            if self.is_tag(c) {
                if has(names, self.nodes[c].name.as_str()) {
                    out.push(c);
                }
                self.find_all(c, names, mut out);
            }
        }
    }

    fn find_all_named(ref self, n: i64, name: Str) -> Vec[i64] {
        let names = vec![name.to_string()];
        let mut out: Vec[i64] = Vec.new();
        self.find_all(n, names, mut out);
        out
    }
}

// ---------------------------------------------------------------- building it

// HTMLTreeBuilder.DEFAULT_CDATA_LIST_ATTRIBUTES: the attributes whose
// value bs4 keeps as a whitespace-split list.
fn cdata_list_attribute(tag: ref String, attr: ref String) -> bool {
    if attr == "class" or attr == "accesskey" or attr == "dropzone" {
        return true;
    }
    let t = tag.to_lowercase();
    ((t == "a" or t == "link") and (attr == "rel" or attr == "rev")) or ((t == "td" or t == "th") and attr == "headers") or (t == "form" and attr == "accept-charset") or (t == "object" and attr == "archive") or (t == "area" and attr == "rel") or (t == "icon" and attr == "sizes") or (t == "iframe" and attr == "sandbox") or (t == "output" and attr == "for")
}

// nonwhitespace_re.findall(value): the list bs4 stores.
fn split_ws(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if py_isspace(c) {
            if not cur.is_empty() {
                out.push(cur);
                cur = String.new();
            }
        } else {
            cur.push(c);
        }
    }
    if not cur.is_empty() {
        out.push(cur);
    }
    out
}

fn void_tag(name: ref String) -> bool {
    let v = ["area", "base", "basefont", "bgsound", "br", "col", "command", "embed", "frame", "hr", "image", "img", "input", "isindex", "keygen", "link", "menuitem", "meta", "nextid", "param", "source", "spacer", "track", "wbr"];
    for x in v {
        if name == x {
            return true;
        }
    }
    false
}

// BeautifulSoup's tree construction, fed by BeautifulSoupHTMLParser.
struct Builder {
    soup: Soup,
    stack: Vec[i64],
    open_names: Vec[String],
    open_counts: Vec[i64],
    preserve_ws: Vec[i64],
    current_data: Vec[String],
    already_closed_empty: Vec[String],
}

impl Builder {
    fn new() -> Builder {
        let root = DNode {
            kind: k_tag(),
            name: "[document]".to_string(),
            attr_names: Vec.new(),
            attr_values: Vec.new(),
            attr_multi: Vec.new(),
            text: String.new(),
            parent: -1,
            children: Vec.new(),
            index: 0,
        };
        Builder {
            soup: Soup { nodes: vec![root] },
            stack: vec![0],
            open_names: Vec.new(),
            open_counts: Vec.new(),
            preserve_ws: Vec.new(),
            current_data: Vec.new(),
            already_closed_empty: Vec.new(),
        }
    }

    fn current(ref self) -> i64 {
        self.stack[self.stack.len() - 1]
    }

    fn count_index(mut ref self, name: ref String) -> i64 {
        let mut i = 0;
        while i < self.open_names.len() {
            if self.open_names[i] == name {
                return i;
            }
            i += 1;
        }
        self.open_names.push(name.clone());
        self.open_counts.push(0);
        self.open_names.len() - 1
    }

    fn append(mut ref self, node: own DNode) -> i64 {
        let id = self.soup.nodes.len();
        let parent = node.parent;
        let mut node = node;
        node.index = self.soup.nodes[parent].children.len();
        self.soup.nodes.push(node);
        self.soup.nodes[parent].children.push(id);
        id
    }

    fn end_data(mut ref self, kind: i64) {
        if self.current_data.is_empty() {
            return;
        }
        let mut data = self.current_data.join("");
        self.current_data.clear();
        if self.preserve_ws.is_empty() {
            let mut strippable = true;
            for c in data.chars() {
                if not (c == ' ' or c == '\n' or c == '\t' or c == '\u{c}' or c == '\r') {
                    strippable = false;
                    break;
                }
            }
            if strippable {
                data = if data.contains("\n") { "\n".to_string() } else { " ".to_string() };
            }
        }
        let parent = self.current();
        self.append(DNode { kind: kind, name: String.new(), attr_names: Vec.new(), attr_values: Vec.new(), attr_multi: Vec.new(), text: data, parent: parent, children: Vec.new(), index: 0 });
    }

    fn push_tag(mut ref self, name: ref String, names: own Vec[String], values: own Vec[String]) -> i64 {
        let parent = self.current();
        let mut multi: Vec[bool] = Vec.new();
        for a in names.iter() {
            multi.push(cdata_list_attribute(name, a));
        }
        let id = self.append(DNode { kind: k_tag(), name: name.clone(), attr_names: names, attr_values: values, attr_multi: multi, text: String.new(), parent: parent, children: Vec.new(), index: 0 });
        self.stack.push(id);
        let k = self.count_index(name);
        self.open_counts[k] += 1;
        if name == "pre" or name == "textarea" {
            self.preserve_ws.push(id);
        }
        id
    }

    fn pop_tag(mut ref self) {
        if self.stack.len() <= 1 {
            return;
        }
        let id = self.stack.pop().unwrap();
        let name = self.soup.nodes[id].name.clone();
        let k = self.count_index(name);
        self.open_counts[k] -= 1;
        if not self.preserve_ws.is_empty() and self.preserve_ws[self.preserve_ws.len() - 1] == id {
            self.preserve_ws.pop();
        }
    }

    // _popToTag: up to and including the most recent open tag of that
    // name, or nothing when none is open.
    fn pop_to_tag(mut ref self, name: ref String) {
        if name == "[document]" {
            return;
        }
        let mut i = self.stack.len() - 1;
        while i > 0 {
            let k = self.count_index(name);
            if self.open_counts[k] == 0 {
                break;
            }
            let t = self.stack[i];
            let is_it = self.soup.nodes[t].name == name;
            self.pop_tag();
            if is_it {
                break;
            }
            i -= 1;
        }
    }

    fn soup_endtag(mut ref self, name: ref String) {
        self.end_data(k_text());
        self.pop_to_tag(name);
    }

    fn starttag(mut ref self, tag: ref String, attrs: ref Vec[Attr], handle_empty: bool) {
        let mut names: Vec[String] = Vec.new();
        let mut values: Vec[String] = Vec.new();
        for a in attrs.iter() {
            let value = a.value.clone().unwrap_or(String.new());
            let mut found = false;
            let mut i = 0;
            while i < names.len() {
                if names[i] == a.name {
                    values[i] = value.clone();
                    found = true;
                }
                i += 1;
            }
            if not found {
                names.push(a.name.clone());
                values.push(value);
            }
        }
        self.end_data(k_text());
        self.push_tag(tag, names, values);
        if void_tag(tag) and handle_empty {
            self.soup_endtag(tag);
            self.already_closed_empty.push(tag.clone());
        }
    }

    fn endtag(mut ref self, tag: ref String, check_already_closed: bool) {
        if check_already_closed {
            let mut i = 0;
            while i < self.already_closed_empty.len() {
                if self.already_closed_empty[i] == tag {
                    self.already_closed_empty.remove(i);
                    return;
                }
                i += 1;
            }
        }
        self.soup_endtag(tag);
    }

    fn data(mut ref self, s: ref String) {
        self.current_data.push(s.clone());
    }

    fn special(mut ref self, s: ref String, kind: i64) {
        self.end_data(k_text());
        self.data(s);
        self.end_data(kind);
    }

    fn event(mut ref self, ev: ref Event, ents: ref Map[String, String]) {
        match ev {
            Event.Start(tag, attrs) => self.starttag(tag, attrs, true),
            Event.StartEnd(tag, attrs) => {
                self.starttag(tag, attrs, false);
                self.endtag(tag, false);
            }
            Event.End(tag) => self.endtag(tag, true),
            Event.Data(s) => self.data(s),
            Event.CharRef(name) => {
                let (deref, extra) = dereference(name);
                self.data(deref);
                self.data(extra);
            }
            Event.EntityRef(name) => {
                let semi = f"{name};";
                let text = match ents.get(semi) {
                    Some(t) => t.clone(),
                    None => match ents.get(name.clone()) {
                        Some(t) => t.clone(),
                        None => f"&{name}",
                    },
                };
                self.data(text);
            }
            Event.Comment(s) => self.special(s, k_comment()),
            Event.Decl(s) => {
                let v = char_vec(s);
                let rest = if v.len() > 8 { from_chars(v, 8, v.len()) } else { String.new() };
                self.special(rest, k_doctype());
            }
            Event.UnknownDecl(s) => {
                let v = char_vec(s);
                let up = s.to_uppercase();
                if up.starts_with("CDATA[") {
                    self.special(from_chars(v, 6, v.len()), k_cdata());
                } else {
                    self.special(s, k_decl());
                }
            }
            Event.Pi(s) => self.special(s, k_pi()),
        }
    }
}

fn cp1252(n: i64) -> i64 {
    let table = [0x20AC, -1, 0x201A, 0x0192, 0x201E, 0x2026, 0x2020, 0x2021, 0x02C6, 0x2030, 0x0160, 0x2039, 0x0152, -1, 0x017D, -1, -1, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014, 0x02DC, 0x2122, 0x0161, 0x203A, 0x0153, -1, 0x017E, 0x0178];
    let v = table[n - 0x80];
    if v < 0 { n } else { v }
}

// _dereference_numeric_character_reference and
// UnicodeDammit.numeric_character_reference.
fn dereference(name: ref String) -> (String, String) {
    let v = char_vec(name);
    let mut base = 10;
    let mut start = 0;
    if v.len() > 0 and (v[0] == 'x' or v[0] == 'X') {
        base = 16;
        start = 1;
    }
    let mut n = 0;
    let mut k = start;
    while k < v.len() {
        let c = v[k];
        let d = if c >= '0' and c <= '9' { c as i64 - 48 } else if base == 16 and c >= 'a' and c <= 'f' { c as i64 - 87 } else if base == 16 and c >= 'A' and c <= 'F' { c as i64 - 55 } else { -1 };
        if d < 0 {
            break;
        }
        if n <= 0x10FFFF {
            n = n * base + d;
        }
        k += 1;
    }
    if k == start {
        return (String.new(), from_chars(v, start, v.len()));
    }
    let extra = from_chars(v, k, v.len());
    let replacement = "\u{fffd}".to_string();
    if n == 0 or n > 0x10FFFF or (n >= 0xD800 and n <= 0xDFFF) {
        return (replacement, extra);
    }
    let code = if n >= 0x80 and n <= 0x9F { cp1252(n) } else { n };
    match as_char(code) {
        Some(c) => (c.to_string(), extra),
        None => (replacement, extra),
    }
}

// BeautifulSoup(html, "html.parser").
fn parse_soup(html: ref String, ents: ref Map[String, String]) -> Soup {
    let mut p = HtmlParser.new(false);
    p.feed(to_chars(html), ents);
    p.close(ents);
    let mut b = Builder.new();
    for e in p.events.iter() {
        b.event(e.ev, ents);
    }
    b.end_data(k_text());
    while b.stack.len() > 1 {
        b.pop_tag();
    }
    b.soup
}

// ---------------------------------------------------------------- css_types

fn sel_empty() -> i64 { 0x1 }
fn sel_root() -> i64 { 0x2 }
fn sel_default() -> i64 { 0x4 }
fn sel_indeterminate() -> i64 { 0x8 }
fn sel_scope() -> i64 { 0x10 }
fn sel_dir_ltr() -> i64 { 0x20 }
fn sel_dir_rtl() -> i64 { 0x40 }
fn sel_in_range() -> i64 { 0x80 }
fn sel_out_of_range() -> i64 { 0x100 }
fn sel_defined() -> i64 { 0x200 }
fn sel_placeholder_shown() -> i64 { 0x400 }

// A compiled attribute pattern, with the source and flags its repr shows.
#[derive(Clone)]
struct Pat {
    source: String,
    flags: i64,
    prog: Program,
}

#[derive(Clone)]
struct SelectorTag {
    name: String,
    prefix: Option[String],
}

#[derive(Clone)]
struct SelectorAttribute {
    attribute: String,
    prefix: String,
    pattern: Option[Pat],
    xml_type_pattern: Option[Pat],
}

#[derive(Clone)]
struct SelectorContains {
    text: Vec[String],
    own: bool,
}

#[derive(Clone)]
struct SelectorNth {
    a: i64,
    n: bool,
    b: i64,
    of_type: bool,
    last: bool,
    selectors: SelectorList,
}

#[derive(Clone)]
struct SelectorLang {
    languages: Vec[String],
}

#[derive(Clone)]
struct Selector {
    tag: Option[SelectorTag],
    ids: Vec[String],
    classes: Vec[String],
    attributes: Vec[SelectorAttribute],
    nth: Vec[SelectorNth],
    selectors: Vec[SelectorList],
    relation: SelectorList,
    rel_type: Option[String],
    contains: Vec[SelectorContains],
    lang: Vec[SelectorLang],
    flags: i64,
}

// A Selector or a SelectorNull.
#[derive(Clone)]
enum SelItem {
    Null,
    Sel(Selector),
}

#[derive(Clone)]
struct SelectorList {
    selectors: Vec[SelItem],
    is_not: bool,
    is_html: bool,
    count: i64,
}

fn empty_list() -> SelectorList {
    SelectorList { selectors: Vec.new(), is_not: false, is_html: false, count: 0 }
}

// ---------------------------------------------------------------- reprs

fn py_bool(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

fn opt_repr(s: ref Option[String]) -> String {
    match s {
        Some(ref v) => py_repr(v),
        None => "None".to_string(),
    }
}

// repr() of a tuple whose items are already repr'd.
fn tuple_repr(items: ref Vec[String]) -> String {
    if items.len() == 1 {
        return f"({items[0]},)";
    }
    f"({items.join(", ")})"
}

fn strs_repr(v: ref Vec[String]) -> String {
    let mut items: Vec[String] = Vec.new();
    for s in v.iter() {
        items.push(py_repr(s));
    }
    tuple_repr(items)
}

// repr(re.Pattern): re.compile(%.200R, flags), without re.UNICODE.
fn pat_repr(p: ref Option[Pat]) -> String {
    match p {
        None => "None".to_string(),
        Some(ref pat) => {
            let r: Vec[char] = py_repr(pat.source).chars().collect();
            let shown = from_chars(r, 0, if r.len() > 200 { 200 } else { r.len() });
            let mut names: Vec[String] = Vec.new();
            if pat.flags & flag_i() != 0 {
                names.push("re.IGNORECASE".to_string());
            }
            if pat.flags & flag_s() != 0 {
                names.push("re.DOTALL".to_string());
            }
            if names.is_empty() { f"re.compile({shown})" } else { f"re.compile({shown}, {names.join("|")})" }
        }
    }
}

fn tag_repr(t: ref Option[SelectorTag]) -> String {
    match t {
        None => "None".to_string(),
        Some(ref tag) => f"SelectorTag(name={py_repr(tag.name)}, prefix={opt_repr(tag.prefix)})",
    }
}

fn attr_repr(a: ref SelectorAttribute) -> String {
    f"SelectorAttribute(attribute={py_repr(a.attribute)}, prefix={py_repr(a.prefix)}, pattern={pat_repr(a.pattern)}, xml_type_pattern={pat_repr(a.xml_type_pattern)})"
}

fn nth_repr(n: ref SelectorNth) -> String {
    f"SelectorNth(a={n.a}, n={py_bool(n.n)}, b={n.b}, of_type={py_bool(n.of_type)}, last={py_bool(n.last)}, selectors={list_repr(n.selectors)})"
}

fn selector_repr(s: ref Selector) -> String {
    let mut attrs: Vec[String] = Vec.new();
    for a in s.attributes.iter() {
        attrs.push(attr_repr(a));
    }
    let mut nths: Vec[String] = Vec.new();
    for n in s.nth.iter() {
        nths.push(nth_repr(n));
    }
    let mut subs: Vec[String] = Vec.new();
    for l in s.selectors.iter() {
        subs.push(list_repr(l));
    }
    let mut contains: Vec[String] = Vec.new();
    for c in s.contains.iter() {
        contains.push(f"SelectorContains(text={strs_repr(c.text)}, own={py_bool(c.own)})");
    }
    let mut langs: Vec[String] = Vec.new();
    for l in s.lang.iter() {
        langs.push(f"SelectorLang(languages={strs_repr(l.languages)})");
    }
    f"Selector(tag={tag_repr(s.tag)}, ids={strs_repr(s.ids)}, classes={strs_repr(s.classes)}, attributes={tuple_repr(attrs)}, nth={tuple_repr(nths)}, selectors={tuple_repr(subs)}, relation={list_repr(s.relation)}, rel_type={opt_repr(s.rel_type)}, contains={tuple_repr(contains)}, lang={tuple_repr(langs)}, flags={s.flags})"
}

fn list_repr(l: ref SelectorList) -> String {
    let mut items: Vec[String] = Vec.new();
    for s in l.selectors.iter() {
        match s {
            SelItem.Null => items.push("SelectorNull()".to_string()),
            SelItem.Sel(ref sel) => items.push(selector_repr(sel)),
        }
    }
    f"SelectorList(selectors={tuple_repr(items)}, is_not={py_bool(l.is_not)}, is_html={py_bool(l.is_html)}, count={l.count})"
}

// ---------------------------------------------------------------- regex glue

fn prog(p: ref String, flags: i64) -> Result[Program, String] {
    match compile(cps(p), flags) {
        Ok(pr) => Ok(pr),
        Err(e) => Err(f"cannot compile {p}: {err_text(e)}"),
    }
}

// The group number of a named group.
fn gnum(pr: ref Program, name: Str) -> i64 {
    let want = cp(name);
    for (n, g) in pr.names.iter() {
        if same(n, want) {
            return g;
        }
    }
    -1
}

fn group_at(s: ref Vec[i64], m: ref Found, g: i64) -> Option[String] {
    if g == 0 {
        return Some(to_string(slice(s, m.start, m.end)));
    }
    let (a, b) = m.spans[g - 1];
    if a < 0 { None } else { Some(to_string(slice(s, a, b))) }
}

fn group_named(pr: ref Program, s: ref Vec[i64], m: ref Found, name: Str) -> Option[String] {
    group_at(s, m, gnum(pr, name))
}

// m.group(name) or "" (for the many `if m.group(x)` truthiness tests).
fn group_or_empty(pr: ref Program, s: ref Vec[i64], m: ref Found, name: Str) -> String {
    group_named(pr, s, m, name).unwrap_or(String.new())
}

fn re_match_at(pr: ref Program, s: ref Vec[i64], pos: i64) -> Option[Found] {
    let mut m = new_matcher(pr, s);
    find(mut m, pr, pos, false, 1)
}

fn re_search_at(pr: ref Program, s: ref Vec[i64], pos: i64) -> Option[Found] {
    let mut m = new_matcher(pr, s);
    find(mut m, pr, pos, false, 0)
}

fn re_matches(pr: ref Program, s: ref String) -> bool {
    re_match_at(pr, cps(s), 0).is_some()
}

fn re_search(pr: ref Program, s: ref String) -> bool {
    re_search_at(pr, cps(s), 0).is_some()
}

// re.escape.
fn re_escape(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if in_chars(c, "()[]{}?*+-|^$\\.&~# \t\n\r\u{b}\u{c}") {
            out.push('\\');
        }
        out.push(c);
    }
    out
}

// Python's floor division.
fn floordiv(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

// util.lower: ASCII-only lower-casing.
fn lower_ascii(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        out.push(ascii_lower(c));
    }
    out
}

// f"{n:x}"
fn low_hex(n: i64) -> String {
    let digits = "0123456789abcdef";
    let d: Vec[char] = digits.chars().collect();
    if n == 0 {
        return "0".to_string();
    }
    let mut out: Vec[char] = Vec.new();
    let mut v = n;
    while v > 0 {
        out.push(d[v % 16]);
        v = v / 16;
    }
    out.reverse();
    from_chars(out, 0, out.len())
}

// ---------------------------------------------------------------- css_parser

fn p_newline() -> String {
    "(?:\\r\\n|(?!\\r\\n)[\\n\\f\\r])".to_string()
}

fn p_ws() -> String {
    f"(?:[ \\t]|{p_newline()})"
}

fn p_comments() -> String {
    "(?:/\\*(?:[^*]|\\*(?!/))*\\*/)".to_string()
}

fn p_wsc() -> String {
    f"(?:{p_ws()}|{p_comments()})"
}

fn p_css_escapes() -> String {
    f"(?:\\\\(?:[a-f0-9]{{1,6}}{p_ws()}?|[^\\r\\n\\f]|$))"
}

fn p_identifier() -> String {
    let e = p_css_escapes();
    f"(?:(?:--|-?(?:[^\\x00-\\x2f\\x30-\\x40\\x5B-\\x5E\\x60\\x7B-\\x9f]|{e}))(?:[^\\x00-\\x2c\\x2e\\x2f\\x3A-\\x40\\x5B-\\x5E\\x60\\x7B-\\x9f]|{e})*)"
}

fn p_nth() -> String {
    let wsc = p_wsc();
    f"(?:[-+])?(?:[0-9]+n?|n)(?:(?<=n){wsc}*(?:[-+]){wsc}*(?:[0-9]+))?"
}

fn p_value() -> String {
    let nl = p_newline();
    let id = p_identifier();
    f"(?:\"(?:\\\\(?:.|{nl})|[^\\\\\"\\r\\n\\f])*?\"|'(?:\\\\(?:.|{nl})|[^\\\\'\\r\\n\\f])*?'|{id})"
}

fn p_attr() -> String {
    let wsc = p_wsc();
    f"(?:{wsc}*(?P<cmp>[!~^|*$]?=){wsc}*(?P<value>{p_value()})(?:{wsc}*(?P<case>[is]))?)?{wsc}*"
}

fn p_pseudo_class() -> String {
    f"(?P<name>:{p_identifier()})(?P<open>\\({p_wsc()}*)?"
}

fn p_pseudo_class_special() -> String {
    f"(?P<name>:{p_identifier()})(?P<open>\\({p_wsc()}*)"
}

fn p_pseudo_class_custom() -> String {
    f"(?P<name>:(?=--){p_identifier()})"
}

fn p_pseudo_values() -> String {
    let wsc = p_wsc();
    let v = p_value();
    f"{p_pseudo_class_special()}(?P<values>{v}(?:{wsc}*,{wsc}*{v})*){wsc}*\\)"
}

fn flg_pseudo() -> i64 { 0x01 }
fn flg_not() -> i64 { 0x02 }
fn flg_relative() -> i64 { 0x04 }
fn flg_default() -> i64 { 0x08 }
fn flg_html() -> i64 { 0x10 }
fn flg_indeterminate() -> i64 { 0x20 }
fn flg_open() -> i64 { 0x40 }
fn flg_in_range() -> i64 { 0x80 }
fn flg_out_of_range() -> i64 { 0x100 }
fn flg_placeholder_shown() -> i64 { 0x200 }
fn flg_forgive() -> i64 { 0x400 }

fn selector_limit() -> i64 { 8192 }

// The compiled patterns: CSSParser.CSS_TOKENS in order (the special
// pseudo-class patterns sit behind "special"), the module's other
// regexes, and css_match's.
struct Res {
    tokens: Vec[(String, Program)],
    special: Program,
    specials: Vec[(String, String, Program)],
    css_esc: Program,
    css_str_esc: Program,
    re_nth: Program,
    re_values: Program,
    re_ws: Program,
    re_ws_begin: Program,
    re_ws_end: Program,
    re_custom: Program,
    line_split: Program,
    not_empty: Program,
    re_num: Program,
    re_time: Program,
    re_month: Program,
    re_week: Program,
    re_date: Program,
    re_datetime: Program,
    wild_strip: Program,
    bidi: Vec[(i64, i64, i64)],
}

fn new_res() -> Result[Res, String] {
    let ixu = flag_i() | flag_x() | flag_u();
    let wsc = p_wsc();
    let ws = p_ws();
    let nl = p_newline();
    let id = p_identifier();
    let special = p_pseudo_class_special();
    let nth = p_nth();
    let mut tokens: Vec[(String, Program)] = Vec.new();
    tokens.push(("pseudo_close".to_string(), prog(f"{wsc}*\\)", ixu)?));
    tokens.push(("special".to_string(), prog("x", 0)?));
    tokens.push(("pseudo_class_custom".to_string(), prog(p_pseudo_class_custom(), ixu)?));
    tokens.push(("pseudo_class".to_string(), prog(p_pseudo_class(), ixu)?));
    tokens.push(("pseudo_element".to_string(), prog(f":{p_pseudo_class()}", ixu)?));
    tokens.push(("amp".to_string(), prog("&", ixu)?));
    tokens.push(("at_rule".to_string(), prog(f"@P{id}", ixu)?));
    tokens.push(("id".to_string(), prog(f"\\#{id}", ixu)?));
    tokens.push(("class".to_string(), prog(f"\\.{id}", ixu)?));
    tokens.push(("tag".to_string(), prog(f"(?P<tag_ns>(?:{id}|\\*)?\\|)?(?P<tag_name>{id}|\\*)", ixu)?));
    tokens.push(("attribute".to_string(), prog(f"\\[{wsc}*(?P<attr_ns>(?:{id}|\\*)?\\|)?(?P<attr_name>{id}){p_attr()}\\]", ixu)?));
    tokens.push(("combine".to_string(), prog(f"{wsc}*?(?P<relation>[,+>~]|{ws}(?![,+>~])){wsc}*", ixu)?));
    let comments = p_comments();
    let nth_child = prog(f"(?P<pseudo_nth_child>{special}(?P<nth_child>{nth}|even|odd))(?:{wsc}*\\)|(?P<of>{comments}*{ws}{wsc}*of{comments}*{ws}{wsc}*))", ixu)?;
    let nth_type = prog(f"(?P<pseudo_nth_type>{special}(?P<nth_type>{nth}|even|odd)){wsc}*\\)", ixu)?;
    let values = prog(p_pseudo_values(), ixu)?;
    let dir = prog(f"{special}(?P<dir>ltr|rtl){wsc}*\\)", ixu)?;
    let mut specials: Vec[(String, String, Program)] = Vec.new();
    specials.push((":contains".to_string(), "pseudo_contains".to_string(), values.clone()));
    specials.push((":-soup-contains".to_string(), "pseudo_contains".to_string(), values.clone()));
    specials.push((":-soup-contains-own".to_string(), "pseudo_contains".to_string(), values.clone()));
    specials.push((":nth-child".to_string(), "pseudo_nth_child".to_string(), nth_child.clone()));
    specials.push((":nth-last-child".to_string(), "pseudo_nth_child".to_string(), nth_child));
    specials.push((":nth-of-type".to_string(), "pseudo_nth_type".to_string(), nth_type.clone()));
    specials.push((":nth-last-of-type".to_string(), "pseudo_nth_type".to_string(), nth_type));
    specials.push((":lang".to_string(), "pseudo_lang".to_string(), values));
    specials.push((":dir".to_string(), "pseudo_dir".to_string(), dir));
    Ok(Res {
        tokens: tokens,
        special: prog(special, ixu)?,
        specials: specials,
        css_esc: prog(f"(?:(\\\\[a-f0-9]{{1,6}}{wsc}?)|(\\\\[^\\r\\n\\f])|(\\\\$))", flag_i())?,
        css_str_esc: prog(f"(?:(\\\\[a-f0-9]{{1,6}}{ws}?)|(\\\\[^\\r\\n\\f])|(\\\\$)|(\\\\{nl}))", flag_i())?,
        re_nth: prog(f"(?P<s1>[-+])?(?P<a>[0-9]+n?|n)(?:(?<=n){wsc}*(?P<s2>[-+]){wsc}*(?P<b>[0-9]+))?", flag_i())?,
        re_values: prog(f"(?:(?P<value>{p_value()})|(?P<split>{wsc}*,{wsc}*))", flag_x())?,
        re_ws: prog(ws, 0)?,
        re_ws_begin: prog(f"^{wsc}*", 0)?,
        re_ws_end: prog(f"^(?:[ \\t]|(?:\\n\\r|(?!\\n\\r)[\\n\\f\\r])|{comments})*", 0)?,
        re_custom: prog(f"^{p_pseudo_class_custom()}$", flag_x())?,
        line_split: prog("(?:\\r\\n|(?!\\r\\n)[\\n\\r])|$", 0)?,
        not_empty: prog("[^ \t\r\n\u{c}]", 0)?,
        re_num: prog("^(?P<value>-?(?:[0-9]{1,}(\\.[0-9]+)?|\\.[0-9]+))$", 0)?,
        re_time: prog("^(?P<hour>[0-9]{2}):(?P<minutes>[0-9]{2})$", 0)?,
        re_month: prog("^(?P<year>[0-9]{4,})-(?P<month>[0-9]{2})$", 0)?,
        re_week: prog("^(?P<year>[0-9]{4,})-W(?P<week>[0-9]{2})$", 0)?,
        re_date: prog("^(?P<year>[0-9]{4,})-(?P<month>[0-9]{2})-(?P<day>[0-9]{2})$", 0)?,
        re_datetime: prog("^(?P<year>[0-9]{4,})-(?P<month>[0-9]{2})-(?P<day>[0-9]{2})T(?P<hour>[0-9]{2}):(?P<minutes>[0-9]{2})$", 0)?,
        wild_strip: prog("(?:(?:-\\*-)(?:\\*(?:-|$))*|-\\*$)", 0)?,
        bidi: bidi_table(),
    })
}

// ---------------------------------------------------------------- errors

// util.get_pattern_context.
fn pattern_context(res: ref Res, pattern: ref String, index: i64) -> (String, i64, i64) {
    let p = cps(pattern);
    let mut last = 0;
    let mut current_line = 1;
    let mut col = 1;
    let mut text: Vec[String] = Vec.new();
    let mut line = 1;
    for m in all_matches(res.line_split, p, 0).iter() {
        let linetext = to_string(slice(p, last, m.start));
        let mut indent = "    ";
        let mut offset: Option[i64] = None;
        if m.end == m.start and text.is_empty() {
            indent = "";
            offset = Some(-1);
            col = index - last + 1;
        } else if last <= index and index < m.end {
            indent = "--> ";
            offset = Some((if index > m.start { -1 } else { 0 }) + 3);
            col = index - last + 1;
        }
        if not text.is_empty() {
            text.push("\n".to_string());
        }
        text.push(f"{indent}{linetext}");
        if let Some(o) = offset {
            text.push("\n".to_string());
            text.push(repeat(" ", col + o) + "^");
            line = current_line;
        }
        current_line += 1;
        last = m.end;
    }
    (text.join(""), line, col)
}

fn syntax_error(res: ref Res, msg: own String, pattern: ref String, index: i64) -> String {
    let (context, line, _col) = pattern_context(res, pattern, index);
    f"SelectorSyntaxError: {msg}\n  line {line}:\n{context}"
}

// int(s, 16) on what an escape matched: whitespace around it is fine,
// anything else is Python's ValueError.
fn hex_int(s: ref String) -> Result[i64, String] {
    let t = py_strip(s);
    let mut n = 0;
    if t.is_empty() {
        return Err(f"ValueError: invalid literal for int() with base 16: {py_repr(s)}");
    }
    for c in t.chars() {
        let d = if c >= '0' and c <= '9' { c as i64 - 48 } else if c >= 'a' and c <= 'f' { c as i64 - 87 } else if c >= 'A' and c <= 'F' { c as i64 - 55 } else { -1 };
        if d < 0 {
            return Err(f"ValueError: invalid literal for int() with base 16: {py_repr(s)}");
        }
        n = n * 16 + d;
    }
    Ok(n)
}

// css_unescape: CSS escapes, and in quoted values the quotes and
// escaped newlines.
fn css_unescape(res: ref Res, content: ref String) -> Result[String, String] {
    let v = char_vec(content);
    let quoted = content.starts_with("'") or content.starts_with("\"");
    let body = if quoted { from_chars(v, 1, if v.len() >= 1 { v.len() - 1 } else { 0 }) } else { content.clone() };
    let c = cps(body);
    let ms = if quoted { all_matches(res.css_str_esc, c, 0) } else { all_matches(res.css_esc, c, 0) };
    let mut out = String.new();
    let mut i = 0;
    for m in ms.iter() {
        out.push_str(to_string(slice(c, i, m.start)));
        let g1 = group_at(c, m, 1).unwrap_or(String.new());
        let g2 = group_at(c, m, 2).unwrap_or(String.new());
        let g3 = group_at(c, m, 3).unwrap_or(String.new());
        if not g1.is_empty() {
            let mut code = hex_int(from_chars(char_vec(g1), 1, char_len(g1)))?;
            if code == 0 {
                code = 0xFFFD;
            }
            if code > 0x10FFFF {
                return Err("ValueError: chr() arg not in range(0x110000)".to_string());
            }
            match as_char(code) {
                Some(ch) => out.push(ch),
                None => out.push('\u{fffd}'),
            }
        } else if not g2.is_empty() {
            out.push_str(from_chars(char_vec(g2), 1, char_len(g2)));
        } else if not g3.is_empty() {
            out.push('\u{fffd}');
        }
        i = m.end;
    }
    out.push_str(to_string(slice(c, i, c.len())));
    Ok(out)
}

// soupsieve.escape.
fn css_escape(ident: ref String) -> String {
    let v = char_vec(ident);
    let mut out = String.new();
    let start_dash = v.len() > 0 and v[0] == '-';
    if v.len() == 1 and start_dash {
        out.push_str(f"\\{ident}");
        return out;
    }
    let mut index = 0;
    while index < v.len() {
        let c = v[index];
        let code = c as i64;
        if code == 0 {
            out.push('\u{fffd}');
        } else if (code >= 0x01 and code <= 0x1F) or code == 0x7F {
            out.push_str(f"\\{low_hex(code)} ");
        } else if (index == 0 or (start_dash and index == 1)) and (code >= 0x30 and code <= 0x39) {
            out.push_str(f"\\{low_hex(code)} ");
        } else if code == 0x2D or code == 0x5F or code >= 0x80 or (code >= 0x30 and code <= 0x39) or (code >= 0x41 and code <= 0x5A) or (code >= 0x61 and code <= 0x7A) {
            out.push(c);
        } else {
            out.push('\\');
            out.push(c);
        }
        index += 1;
    }
    out
}

// ---------------------------------------------------------------- tokens

// One token from selector_iter: its name, span and named groups.
struct Tok {
    name: String,
    start: i64,
    end: i64,
    text: String,
    groups: Vec[(String, Option[String])],
}

impl Tok {
    fn g(ref self, name: Str) -> String {
        for (n, v) in self.groups.iter() {
            if n == name {
                return v.clone().unwrap_or(String.new());
            }
        }
        String.new()
    }
}

fn make_tok(name: ref String, pr: ref Program, s: ref Vec[i64], m: ref Found) -> Tok {
    let mut groups: Vec[(String, Option[String])] = Vec.new();
    for (n, g) in pr.names.iter() {
        groups.push((to_string(n), group_at(s, m, g)));
    }
    Tok { name: name.clone(), start: m.start, end: m.end, text: to_string(slice(s, m.start, m.end)), groups: groups }
}

// CSSParser.selector_iter, pulled one token at a time.
struct Lexer {
    pat: Vec[i64],
    pattern: String,
    index: i64,
    end: i64,
}

fn new_lexer(res: ref Res, pattern: ref String) -> Lexer {
    let p = cps(pattern);
    let index = match re_search_at(res.re_ws_begin, p, 0) {
        Some(m) => m.end,
        None => 0,
    };
    let mut rev = p.clone();
    rev.reverse();
    let offset = match re_search_at(res.re_ws_end, rev, 0) {
        Some(m) => m.end,
        None => 0,
    };
    let end = p.len() - (1 + offset);
    Lexer { pat: p, pattern: pattern.clone(), index: index, end: end }
}

impl Lexer {
    fn next(mut ref self, res: ref Res) -> Result[Option[Tok], String] {
        if self.index > self.end {
            return Ok(None);
        }
        for (name, pr) in res.tokens.iter() {
            if name == "special" {
                if let Some(m) = re_match_at(res.special, self.pat, self.index) {
                    let pseudo = lower_ascii(css_unescape(res, group_named(res.special, self.pat, m, "name").unwrap_or(String.new()))?);
                    for (p, tname, sp) in res.specials.iter() {
                        if p == pseudo {
                            if let Some(m2) = re_match_at(sp, self.pat, self.index) {
                                self.index = m2.end;
                                return Ok(Some(make_tok(tname, sp, self.pat, m2)));
                            }
                            break;
                        }
                    }
                }
                continue;
            }
            if let Some(m) = re_match_at(pr, self.pat, self.index) {
                self.index = m.end;
                return Ok(Some(make_tok(name, pr, self.pat, m)));
            }
        }
        let c = as_char(self.pat[self.index]).unwrap_or('?');
        let index = self.index;
        let msg = if c == '[' {
            f"Malformed attribute selector at position {index}"
        } else if c == '.' {
            f"Malformed class selector at position {index}"
        } else if c == '#' {
            f"Malformed id selector at position {index}"
        } else if c == ':' {
            f"Malformed pseudo-class selector at position {index}"
        } else {
            f"Invalid character {py_repr(c.to_string())} position {index}"
        };
        Err(syntax_error(res, msg, self.pattern, index))
    }
}

// ---------------------------------------------------------------- _Selector

#[derive(Clone)]
struct SelB {
    tag: Option[SelectorTag],
    ids: Vec[String],
    classes: Vec[String],
    attributes: Vec[SelectorAttribute],
    nth: Vec[SelectorNth],
    selectors: Vec[SelectorList],
    relations: Vec[SelB],
    rel_type: Option[String],
    contains: Vec[SelectorContains],
    lang: Vec[SelectorLang],
    flags: i64,
    no_match: bool,
}

fn new_selb() -> SelB {
    SelB {
        tag: None,
        ids: Vec.new(),
        classes: Vec.new(),
        attributes: Vec.new(),
        nth: Vec.new(),
        selectors: Vec.new(),
        relations: Vec.new(),
        rel_type: None,
        contains: Vec.new(),
        lang: Vec.new(),
        flags: 0,
        no_match: false,
    }
}

fn freeze(s: own SelB) -> SelItem {
    if s.no_match {
        return SelItem.Null;
    }
    let mut relations = s.relations;
    let relation = if relations.is_empty() {
        empty_list()
    } else {
        let mut first = relations.remove(0);
        for r in relations.into_iter() {
            first.relations.push(r);
        }
        SelectorList { selectors: vec![freeze(first)], is_not: false, is_html: false, count: 0 }
    };
    SelItem.Sel(Selector {
        tag: s.tag,
        ids: s.ids,
        classes: s.classes,
        attributes: s.attributes,
        nth: s.nth,
        selectors: s.selectors,
        relation: relation,
        rel_type: s.rel_type,
        contains: s.contains,
        lang: s.lang,
        flags: s.flags,
    })
}

fn star_tag() -> Option[SelectorTag] {
    Some(SelectorTag { name: "*".to_string(), prefix: None })
}

// ---------------------------------------------------------------- the parser

#[derive(Clone)]
enum CustomVal {
    Src(String),
    List(SelectorList),
}

// What lives longer than one CSSParser: the custom selectors of this
// compile, and the class-level PSEUDO_SELECTORS cache.
struct Ctx {
    custom: Map[String, CustomVal],
    pseudo: Map[String, SelectorList],
}

fn in_list(s: ref String, items: ref Vec[Str]) -> bool {
    for x in items.iter() {
        if s == x {
            return true;
        }
    }
    false
}

fn pseudo_simple() -> Vec[Str] {
    vec![":any-link", ":empty", ":first-child", ":first-of-type", ":in-range", ":open", ":out-of-range", ":last-child", ":last-of-type", ":link", ":only-child", ":only-of-type", ":root", ":checked", ":default", ":disabled", ":enabled", ":indeterminate", ":optional", ":placeholder-shown", ":read-only", ":read-write", ":required", ":scope", ":defined", ":muted"]
}

fn pseudo_simple_no_match() -> Vec[Str] {
    vec![":active", ":autofill", ":buffering", ":current", ":focus", ":focus-visible", ":focus-within", ":fullscreen", ":future", ":host", ":hover", ":local-link", ":past", ":paused", ":picture-in-picture", ":playing", ":popover-open", ":seeking", ":stalled", ":target", ":target-within", ":user-invalid", ":volume-locked", ":visited"]
}

fn pseudo_complex() -> Vec[Str] {
    vec![":contains", ":-soup-contains", ":-soup-contains-own", ":has", ":is", ":matches", ":not", ":where"]
}

fn pseudo_complex_no_match() -> Vec[Str] {
    vec![":current", ":host", ":host-context"]
}

fn pseudo_special() -> Vec[Str] {
    vec![":dir", ":lang", ":nth-child", ":nth-last-child", ":nth-last-of-type", ":nth-of-type"]
}

fn pseudo_supported(s: ref String) -> bool {
    in_list(s, pseudo_simple()) or in_list(s, pseudo_simple_no_match()) or in_list(s, pseudo_complex()) or in_list(s, pseudo_complex_no_match()) or in_list(s, pseudo_special())
}

fn nth_sel(a: i64, n: bool, b: i64, of_type: bool, last: bool, sels: own SelectorList) -> SelectorNth {
    SelectorNth { a: a, n: n, b: b, of_type: of_type, last: last, selectors: sels }
}

// int(s, 10) of an optional sign and ASCII digits.
fn signed_int(s: ref String) -> i64 {
    let neg = s.starts_with("-");
    let mut n = 0;
    for c in s.chars() {
        if c >= '0' and c <= '9' {
            n = n * 10 + (c as i64 - 48);
        }
    }
    if neg { -n } else { n }
}

struct CssParser {
    pattern: String,
    flags: i64,
    count: i64,
}

fn new_parser(selector: ref String, flags: i64) -> CssParser {
    CssParser { pattern: selector.replace("\u{0}", "\u{fffd}"), flags: flags, count: 0 }
}

// PSEUDO_SELECTORS[name], compiled once.
fn pseudo_selector(res: ref Res, ctx: mut ref Ctx, name: ref String) -> Result[SelectorList, String] {
    if let Some(l) = ctx.pseudo.get(name.clone()) {
        return Ok(l.clone());
    }
    let (src, flags) = match pseudo_source(name) {
        Some(p) => p,
        None => return Err(f"KeyError: {py_repr(name)}"),
    };
    let mut p = new_parser(src, 0);
    let l = p.process_selectors(res, ctx, 0, flags)?;
    ctx.pseudo.insert(name.clone(), l.clone());
    Ok(l)
}

fn is_pseudo_selector(name: ref String) -> bool {
    pseudo_source(name).is_some()
}

impl CssParser {
    fn increment_count(mut ref self, increment: i64) -> Result[(), String] {
        self.count += increment;
        if self.count > selector_limit() {
            return Err(f"ValueError: Selector exceeds pseudo-class nesting limit of {selector_limit()}");
        }
        Ok(())
    }

    fn error(ref self, res: ref Res, msg: own String, index: i64) -> String {
        syntax_error(res, msg, self.pattern, index)
    }

    fn parse_attribute_selector(mut ref self, res: ref Res, sel: mut ref SelB, m: ref Tok) -> Result[bool, String] {
        let mut inverse = false;
        let op = m.g("cmp");
        let case = lower_ascii(m.g("case"));
        let ns_g = m.g("attr_ns");
        let ns = if ns_g.is_empty() { String.new() } else { css_unescape(res, from_chars(char_vec(ns_g), 0, char_len(ns_g) - 1))? };
        let attr = css_unescape(res, m.g("attr_name"))?;
        let mut is_type = false;
        let mut value = String.new();
        let flags = if not case.is_empty() {
            (if case == "i" { flag_i() } else { 0 }) | flag_s()
        } else if lower_ascii(attr) == "type" {
            is_type = true;
            flag_i() | flag_s()
        } else {
            flag_s()
        };
        if not op.is_empty() {
            value = css_unescape(res, m.g("value"))?;
        }
        let source: Option[String] = if op.is_empty() {
            None
        } else if op.starts_with("^") {
            let v = if value.is_empty() { "(?!)".to_string() } else { re_escape(value) };
            Some(f"^{v}.*")
        } else if op.starts_with("$") {
            let v = if value.is_empty() { "(?!)".to_string() } else { re_escape(value) };
            Some(f".*?{v}$")
        } else if op.starts_with("*") {
            let v = if value.is_empty() { "(?!)".to_string() } else { re_escape(value) };
            Some(f".*?{v}.*")
        } else if op.starts_with("~") {
            let v = if value.is_empty() or re_search(res.re_ws, value) { "(?!)".to_string() } else { re_escape(value) };
            Some(f".*?(?:(?<=^)|(?<=[ \\t\\r\\n\\f])){v}(?=(?:[ \\t\\r\\n\\f]|$)).*")
        } else if op.starts_with("|") {
            Some(f"^{re_escape(value)}(?:-.*)?$")
        } else {
            if op.starts_with("!") {
                inverse = true;
            }
            Some(f"^{re_escape(value)}$")
        };
        let mut pattern: Option[Pat] = None;
        let mut pattern2: Option[Pat] = None;
        if let Some(ref src) = source {
            pattern = Some(Pat { source: src.clone(), flags: flags, prog: prog(src, flags)? });
            if is_type {
                pattern2 = Some(Pat { source: src.clone(), flags: 0, prog: prog(src, 0)? });
            }
        }
        let sel_attr = SelectorAttribute { attribute: attr, prefix: ns, pattern: pattern, xml_type_pattern: pattern2 };
        if inverse {
            let mut sub_sel = new_selb();
            sub_sel.attributes.push(sel_attr);
            let not_list = SelectorList { selectors: vec![freeze(sub_sel)], is_not: true, is_html: false, count: 0 };
            sel.selectors.push(not_list);
        } else {
            sel.attributes.push(sel_attr);
        }
        Ok(true)
    }

    fn parse_tag_pattern(mut ref self, res: ref Res, sel: mut ref SelB, m: ref Tok) -> Result[bool, String] {
        let ns_g = m.g("tag_ns");
        let prefix = if ns_g.is_empty() { None } else { Some(css_unescape(res, from_chars(char_vec(ns_g), 0, char_len(ns_g) - 1))?) };
        let tag = css_unescape(res, m.g("tag_name"))?;
        sel.tag = Some(SelectorTag { name: tag, prefix: prefix });
        Ok(true)
    }

    fn parse_pseudo_class_custom(mut ref self, res: ref Res, ctx: mut ref Ctx, sel: mut ref SelB, m: ref Tok) -> Result[bool, String] {
        let pseudo = lower_ascii(css_unescape(res, m.g("name"))?);
        let found = match ctx.custom.get(pseudo.clone()) {
            Some(v) => Some(v.clone()),
            None => None,
        };
        let selector = match found {
            None => return Err(self.error(res, f"Undefined custom selector '{pseudo}' found at position {m.end}", m.end)),
            Some(CustomVal.List(l)) => l,
            Some(CustomVal.Src(src)) => {
                ctx.custom.remove(pseudo.clone());
                let mut p = new_parser(src, self.flags);
                let l = p.process_selectors(res, ctx, 0, flg_pseudo())?;
                ctx.custom.insert(pseudo.clone(), CustomVal.List(l.clone()));
                l
            }
        };
        self.increment_count(selector.count)?;
        sel.selectors.push(selector);
        Ok(true)
    }

    fn parse_pseudo_class(mut ref self, res: ref Res, ctx: mut ref Ctx, lex: mut ref Lexer, sel: mut ref SelB, m: ref Tok, has_selector: bool, is_html: bool) -> Result[(bool, bool), String] {
        let mut has = has_selector;
        let mut html = is_html;
        let pseudo = lower_ascii(css_unescape(res, m.g("name"))?);
        let complex_pseudo = not m.g("open").is_empty();
        if complex_pseudo and in_list(pseudo, pseudo_complex()) {
            has = self.parse_pseudo_open(res, ctx, lex, sel, pseudo, m.end)?;
        } else if not complex_pseudo and in_list(pseudo, pseudo_simple()) {
            if pseudo == ":root" {
                sel.flags = sel.flags | sel_root();
            } else if pseudo == ":defined" {
                sel.flags = sel.flags | sel_defined();
                html = true;
            } else if pseudo == ":scope" {
                sel.flags = sel.flags | sel_scope();
            } else if pseudo == ":empty" {
                sel.flags = sel.flags | sel_empty();
            } else if is_pseudo_selector(pseudo) {
                let ps = pseudo_selector(res, mut ctx, pseudo)?;
                self.increment_count(ps.count)?;
                sel.selectors.push(ps);
            } else if pseudo == ":first-child" {
                sel.nth.push(nth_sel(1, false, 0, false, false, empty_list()));
            } else if pseudo == ":last-child" {
                sel.nth.push(nth_sel(1, false, 0, false, true, empty_list()));
            } else if pseudo == ":first-of-type" {
                sel.nth.push(nth_sel(1, false, 0, true, false, empty_list()));
            } else if pseudo == ":last-of-type" {
                sel.nth.push(nth_sel(1, false, 0, true, true, empty_list()));
            } else if pseudo == ":only-child" {
                sel.nth.push(nth_sel(1, false, 0, false, false, empty_list()));
                sel.nth.push(nth_sel(1, false, 0, false, true, empty_list()));
            } else if pseudo == ":only-of-type" {
                sel.nth.push(nth_sel(1, false, 0, true, false, empty_list()));
                sel.nth.push(nth_sel(1, false, 0, true, true, empty_list()));
            }
            has = true;
        } else if complex_pseudo and in_list(pseudo, pseudo_complex_no_match()) {
            self.parse_selectors(res, ctx, lex, m.end, flg_pseudo() | flg_open())?;
            sel.no_match = true;
            has = true;
        } else if not complex_pseudo and in_list(pseudo, pseudo_simple_no_match()) {
            sel.no_match = true;
            has = true;
        } else if pseudo_supported(pseudo) {
            return Err(self.error(res, f"Invalid syntax for pseudo class '{pseudo}'", m.start));
        } else {
            return Err(self.error(res, f"'{pseudo}' was detected as a pseudo-class and is either unsupported or invalid. If the syntax was not intended to be recognized as a pseudo-class, please escape the colon.", m.start));
        }
        Ok((has, html))
    }

    fn parse_pseudo_nth(mut ref self, res: ref Res, ctx: mut ref Ctx, lex: mut ref Lexer, sel: mut ref SelB, m: ref Tok) -> Result[bool, String] {
        let child = not m.g("pseudo_nth_child").is_empty();
        let name = lower_ascii(css_unescape(res, m.g("name"))?);
        let content = lower_ascii(if child { m.g("nth_child") } else { m.g("nth_type") });
        let mut s1 = 2;
        let mut s2 = 0;
        let mut var = true;
        if content == "even" {
            s1 = 2;
            s2 = 0;
        } else if content == "odd" {
            s1 = 2;
            s2 = 1;
        } else {
            let c = cps(content);
            let parts = match re_match_at(res.re_nth, c, 0) {
                Some(f) => f,
                None => return Err("TypeError: nth".to_string()),
            };
            let g_s1 = group_named(res.re_nth, c, parts, "s1").unwrap_or(String.new());
            let a = group_named(res.re_nth, c, parts, "a").unwrap_or(String.new());
            let g_s2 = group_named(res.re_nth, c, parts, "s2").unwrap_or(String.new());
            let b = group_named(res.re_nth, c, parts, "b").unwrap_or(String.new());
            let mut t1 = if g_s1 == "-" { "-".to_string() } else { String.new() };
            var = a.ends_with("n");
            if a.starts_with("n") {
                t1.push_str("1");
            } else if var {
                t1.push_str(from_chars(char_vec(a), 0, char_len(a) - 1));
            } else {
                t1.push_str(a);
            }
            let mut t2 = if g_s2 == "-" { "-".to_string() } else { String.new() };
            if not b.is_empty() {
                t2.push_str(b);
            } else {
                t2 = "0".to_string();
            }
            s1 = signed_int(t1);
            s2 = signed_int(t2);
        }
        if child {
            let nth_list = if not m.g("of").is_empty() {
                self.parse_selectors(res, ctx, lex, m.end, flg_pseudo() | flg_open())?
            } else {
                let l = pseudo_selector(res, mut ctx, "<nth-of-s>".to_string())?;
                self.increment_count(l.count)?;
                l
            };
            if name == ":nth-child" {
                sel.nth.push(nth_sel(s1, var, s2, false, false, nth_list));
            } else if name == ":nth-last-child" {
                sel.nth.push(nth_sel(s1, var, s2, false, true, nth_list));
            }
        } else {
            if name == ":nth-of-type" {
                sel.nth.push(nth_sel(s1, var, s2, true, false, empty_list()));
            } else if name == ":nth-last-of-type" {
                sel.nth.push(nth_sel(s1, var, s2, true, true, empty_list()));
            }
        }
        Ok(true)
    }

    fn parse_pseudo_open(mut ref self, res: ref Res, ctx: mut ref Ctx, lex: mut ref Lexer, sel: mut ref SelB, name: ref String, index: i64) -> Result[bool, String] {
        let mut flags = flg_pseudo() | flg_open();
        if name == ":not" {
            flags = flags | flg_not();
        } else if name == ":has" {
            flags = flags | flg_relative();
        } else if name == ":where" or name == ":is" {
            flags = flags | flg_forgive();
        }
        let l = self.parse_selectors(res, ctx, lex, index, flags)?;
        sel.selectors.push(l);
        Ok(true)
    }

    fn values_of(ref self, res: ref Res, m: ref Tok) -> Result[Vec[String], String] {
        let c = cps(m.g("values"));
        let mut out: Vec[String] = Vec.new();
        for t in all_matches(res.re_values, c, 0).iter() {
            if group_named(res.re_values, c, t, "split").unwrap_or(String.new()).is_empty() {
                out.push(css_unescape(res, group_named(res.re_values, c, t, "value").unwrap_or(String.new()))?);
            }
        }
        Ok(out)
    }

    fn parse_selectors(mut ref self, res: ref Res, ctx: mut ref Ctx, lex: mut ref Lexer, index0: i64, flags: i64) -> Result[SelectorList, String] {
        let mut index = index0;
        let mut sel = new_selb();
        let mut selectors: Vec[SelB] = Vec.new();
        let mut has_selector = false;
        let mut closed = false;
        let mut relations: Vec[SelB] = Vec.new();
        let mut rel_type = ": ".to_string();
        let count = self.count;
        let is_open = flags & flg_open() != 0;
        let is_pseudo = flags & flg_pseudo() != 0;
        let is_relative = flags & flg_relative() != 0;
        let is_not = flags & flg_not() != 0;
        let mut is_html = flags & flg_html() != 0;
        let is_default = flags & flg_default() != 0;
        let is_indeterminate = flags & flg_indeterminate() != 0;
        let is_in_range = flags & flg_in_range() != 0;
        let is_out_of_range = flags & flg_out_of_range() != 0;
        let is_placeholder_shown = flags & flg_placeholder_shown() != 0;
        let is_forgive = flags & flg_forgive() != 0;
        if is_relative {
            selectors.push(new_selb());
        }
        loop {
            let m = match lex.next(res)? {
                Some(t) => t,
                None => break,
            };
            let key = m.name.clone();
            if key != "combine" and key != "pseudo_close" {
                self.increment_count(1)?;
            }
            if key == "at_rule" {
                return Err(f"NotImplementedError: At-rules found at position {m.start}");
            } else if key == "amp" {
                sel.flags = sel.flags | sel_scope();
                has_selector = true;
            } else if key == "pseudo_class_custom" {
                has_selector = self.parse_pseudo_class_custom(res, ctx, mut sel, m)?;
            } else if key == "pseudo_class" {
                let (h, html) = self.parse_pseudo_class(res, ctx, lex, mut sel, m, has_selector, is_html)?;
                has_selector = h;
                is_html = html;
            } else if key == "pseudo_element" {
                return Err(f"NotImplementedError: Pseudo-element found at position {m.start}");
            } else if key == "pseudo_contains" {
                let pseudo = lower_ascii(css_unescape(res, m.g("name"))?);
                let own_text = pseudo == ":-soup-contains-own";
                let patterns = self.values_of(res, m)?;
                sel.contains.push(SelectorContains { text: patterns, own: own_text });
                has_selector = true;
            } else if key == "pseudo_nth_type" or key == "pseudo_nth_child" {
                has_selector = self.parse_pseudo_nth(res, ctx, lex, mut sel, m)?;
            } else if key == "pseudo_lang" {
                let patterns = self.values_of(res, m)?;
                sel.lang.push(SelectorLang { languages: patterns });
                has_selector = true;
            } else if key == "pseudo_dir" {
                let value = if lower_ascii(m.g("dir")) == "ltr" { sel_dir_ltr() } else { sel_dir_rtl() };
                sel.flags = sel.flags | value;
                has_selector = true;
                is_html = true;
            } else if key == "pseudo_close" {
                if not has_selector {
                    if not is_forgive {
                        return Err(self.error(res, f"Expected a selector at position {m.start}", m.start));
                    }
                    sel.no_match = true;
                }
                if is_open {
                    closed = true;
                    break;
                } else {
                    return Err(self.error(res, f"Unmatched pseudo-class close at position {m.start}", m.start));
                }
            } else if key == "combine" {
                let mut combinator = py_strip(m.g("relation"));
                if combinator.is_empty() {
                    combinator = " ".to_string();
                }
                if is_relative {
                    if combinator == "," {
                        if not has_selector {
                            return Err(self.error(res, f"The combinator '{combinator}' at position {index}, must have a selector before it", index));
                        }
                        sel.rel_type = Some(rel_type.clone());
                        let k = selectors.len() - 1;
                        selectors[k].relations.push(sel);
                        rel_type = ": ".to_string();
                        selectors.push(new_selb());
                    } else {
                        if has_selector {
                            sel.rel_type = Some(rel_type.clone());
                            let k = selectors.len() - 1;
                            selectors[k].relations.push(sel);
                        } else if from_chars(char_vec(rel_type), 1, char_len(rel_type)) != " " {
                            return Err(self.error(res, f"The multiple combinators at position {index}", index));
                        }
                        rel_type = f":{combinator}";
                    }
                } else {
                    if not has_selector {
                        if not is_forgive or combinator != "," {
                            return Err(self.error(res, f"The combinator '{combinator}' at position {index}, must have a selector before it", index));
                        }
                        if combinator == "," {
                            self.increment_count(1)?;
                            relations.clear();
                        }
                    } else {
                        if combinator == "," {
                            if sel.tag.is_none() and not is_pseudo {
                                sel.tag = star_tag();
                            }
                            for r in relations.into_iter() {
                                sel.relations.push(r);
                            }
                            relations = Vec.new();
                            selectors.push(sel);
                        } else {
                            for r in relations.into_iter() {
                                sel.relations.push(r);
                            }
                            relations = Vec.new();
                            sel.rel_type = Some(combinator.clone());
                            relations.push(sel);
                        }
                    }
                }
                sel = new_selb();
                has_selector = false;
            } else if key == "attribute" {
                has_selector = self.parse_attribute_selector(res, mut sel, m)?;
            } else if key == "tag" {
                if has_selector {
                    return Err(self.error(res, f"Tag name found at position {m.start} instead of at the start", m.start));
                }
                has_selector = self.parse_tag_pattern(res, mut sel, m)?;
            } else if key == "class" or key == "id" {
                let v = char_vec(m.text);
                let rest = css_unescape(res, from_chars(v, 1, v.len()))?;
                if m.text.starts_with(".") {
                    sel.classes.push(rest);
                } else {
                    sel.ids.push(rest);
                }
                has_selector = true;
            }
            index = m.end;
        }
        if is_open and not closed {
            return Err(self.error(res, f"Unclosed pseudo-class at position {index}", index));
        }
        if has_selector {
            if sel.tag.is_none() and not is_pseudo {
                sel.tag = star_tag();
            }
            if is_relative {
                sel.rel_type = Some(rel_type.clone());
                let k = selectors.len() - 1;
                selectors[k].relations.push(sel);
            } else {
                for r in relations.into_iter() {
                    sel.relations.push(r);
                }
                relations = Vec.new();
                selectors.push(sel);
            }
        } else if is_forgive and (selectors.is_empty() or relations.is_empty()) {
            self.increment_count(1)?;
            sel.no_match = true;
            relations.clear();
            selectors.push(sel);
            has_selector = true;
        }
        if not has_selector {
            return Err(self.error(res, f"Expected a selector at position {index}", index));
        }
        let last = selectors.len() - 1;
        if is_default {
            selectors[last].flags = sel_default();
        }
        if is_indeterminate {
            selectors[last].flags = sel_indeterminate();
        }
        if is_in_range {
            selectors[last].flags = sel_in_range();
        }
        if is_out_of_range {
            selectors[last].flags = sel_out_of_range();
        }
        if is_placeholder_shown {
            selectors[last].flags = sel_placeholder_shown();
        }
        let mut frozen: Vec[SelItem] = Vec.new();
        for s in selectors.into_iter() {
            frozen.push(freeze(s));
        }
        Ok(SelectorList { selectors: frozen, is_not: is_not, is_html: is_html, count: self.count - count })
    }

    fn process_selectors(mut ref self, res: ref Res, ctx: mut ref Ctx, index: i64, flags: i64) -> Result[SelectorList, String] {
        let mut lex = new_lexer(res, self.pattern);
        self.parse_selectors(res, ctx, mut lex, index, flags)
    }
}

// process_custom: the custom selectors, keyed by their unescaped names.
fn process_custom(res: ref Res, custom: ref Option[Vec[(String, String)]]) -> Result[Map[String, CustomVal], String] {
    let mut out: Map[String, CustomVal] = Map.new();
    if let Some(ref pairs) = custom {
        for (key, value) in pairs.iter() {
            let name = lower_ascii(key);
            if not re_match_at(res.re_custom, cps(name), 0).is_some() {
                return Err(f"SelectorSyntaxError: The name '{name}' is not a valid custom pseudo-class name");
            }
            if out.get(name.clone()).is_some() {
                return Err(f"KeyError: {py_repr(f"The custom selector '{name}' has already been registered")}");
            }
            out.insert(css_unescape(res, name)?, CustomVal.Src(value.clone()));
        }
    }
    Ok(out)
}

// soupsieve.compile(pattern, custom=...).selectors
fn compile_css(res: ref Res, ctx: mut ref Ctx, pattern: ref String, custom: ref Option[Vec[(String, String)]]) -> Result[SelectorList, String] {
    ctx.custom = process_custom(res, custom)?;
    let mut p = new_parser(pattern, 0);
    p.process_selectors(res, ctx, 0, 0)
}

// ---------------------------------------------------------------- css_match

fn ns_xhtml() -> String {
    "http://www.w3.org/1999/xhtml".to_string()
}

fn dir_flags() -> i64 { sel_dir_ltr() | sel_dir_rtl() }
fn ranges_flags() -> i64 { sel_in_range() | sel_out_of_range() }

// DIR_MAP.get(lower(value)): -1 for None.
fn dir_map(v: ref String) -> i64 {
    let l = lower_ascii(v);
    if l == "ltr" { sel_dir_ltr() } else if l == "rtl" { sel_dir_rtl() } else if l == "auto" { 0 } else { -1 }
}

// unicodedata.bidirectional, for the three classes soupsieve asks about:
// 1 L, 2 R, 3 AL, 0 anything else.
fn bidi_class(res: ref Res, c: char) -> i64 {
    let code = c as i64;
    let mut lo = 0;
    let mut hi = res.bidi.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        let (a, b, k) = res.bidi[mid];
        if code < a {
            hi = mid;
        } else if code > b {
            lo = mid + 1;
        } else {
            return k;
        }
    }
    0
}

fn is_leap(y: i64) -> bool {
    (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
}

// Day of the week, 0 for Monday.
fn weekday(y0: i64, m: i64, d: i64) -> i64 {
    let t = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4];
    let y = if m < 3 { y0 - 1 } else { y0 };
    let sunday0 = (y + y / 4 - y / 100 + y / 400 + t[m - 1] + d) % 7;
    (sunday0 + 6) % 7
}

// datetime(year, 12, 28).isocalendar()[1]
fn max_iso_week(year: i64) -> i64 {
    let jan1 = weekday(year, 1, 1);
    if jan1 == 3 or (jan1 == 2 and is_leap(year)) { 53 } else { 52 }
}

fn validate_day(year: i64, month: i64, day: i64) -> bool {
    let mut max_days = 31;
    if month == 2 {
        max_days = if is_leap(year) { 29 } else { 28 };
    } else if month == 4 or month == 6 or month == 9 or month == 11 {
        max_days = 30;
    }
    1 <= day and day <= max_days
}

fn py_float(s: ref String) -> f64 {
    let t = if s.starts_with("-.") { s.replace("-.", "-0.") } else if s.starts_with(".") { f"0{s}" } else { s.clone() };
    match f64.parse(t) {
        Ok(v) => v,
        Err(_) => 0.0,
    }
}

// Inputs.parse_value.
fn parse_input(res: ref Res, itype: ref String, value: ref Option[String]) -> Option[Vec[f64]] {
    let v = match value {
        Some(ref v) => v.clone(),
        None => return None,
    };
    let c = cps(v);
    if itype == "date" {
        if let Some(m) = re_match_at(res.re_date, c, 0) {
            let year = gint(res.re_date, c, m, "year");
            let month = gint(res.re_date, c, m, "month");
            let day = gint(res.re_date, c, m, "day");
            if 1 <= year and 1 <= month and month <= 12 and validate_day(year, month, day) {
                return Some(vec![year as f64, month as f64, day as f64]);
            }
        }
    } else if itype == "month" {
        if let Some(m) = re_match_at(res.re_month, c, 0) {
            let year = gint(res.re_month, c, m, "year");
            let month = gint(res.re_month, c, m, "month");
            if 1 <= year and 1 <= month and month <= 12 {
                return Some(vec![year as f64, month as f64]);
            }
        }
    } else if itype == "week" {
        if let Some(m) = re_match_at(res.re_week, c, 0) {
            let year = gint(res.re_week, c, m, "year");
            let week = gint(res.re_week, c, m, "week");
            if 1 <= year and 1 <= week and week <= max_iso_week(year) {
                return Some(vec![year as f64, week as f64]);
            }
        }
    } else if itype == "time" {
        if let Some(m) = re_match_at(res.re_time, c, 0) {
            let hour = gint(res.re_time, c, m, "hour");
            let minutes = gint(res.re_time, c, m, "minutes");
            if hour <= 23 and minutes <= 59 {
                return Some(vec![hour as f64, minutes as f64]);
            }
        }
    } else if itype == "datetime-local" {
        if let Some(m) = re_match_at(res.re_datetime, c, 0) {
            let year = gint(res.re_datetime, c, m, "year");
            let month = gint(res.re_datetime, c, m, "month");
            let day = gint(res.re_datetime, c, m, "day");
            let hour = gint(res.re_datetime, c, m, "hour");
            let minutes = gint(res.re_datetime, c, m, "minutes");
            if 1 <= year and 1 <= month and month <= 12 and validate_day(year, month, day) and hour <= 23 and minutes <= 59 {
                return Some(vec![year as f64, month as f64, day as f64, hour as f64, minutes as f64]);
            }
        }
    } else if itype == "number" or itype == "range" {
        if let Some(m) = re_match_at(res.re_num, c, 0) {
            return Some(vec![py_float(group_named(res.re_num, c, m, "value").unwrap_or(String.new()))]);
        }
    }
    None
}

fn gint(pr: ref Program, c: ref Vec[i64], m: ref Found, name: Str) -> i64 {
    digits_int(group_named(pr, c, m, name).unwrap_or(String.new()))
}

fn non_empty(o: ref Option[String]) -> bool {
    match o {
        Some(ref s) => not s.is_empty(),
        None => false,
    }
}

fn opt_eq(o: ref Option[String], v: ref String) -> bool {
    match o {
        Some(ref s) => s == v,
        None => false,
    }
}

// Tuple comparison: -1, 0 or 1.
fn cmp_tuple(a: ref Vec[f64], b: ref Vec[f64]) -> i64 {
    let mut i = 0;
    while i < a.len() and i < b.len() {
        if a[i] < b[i] {
            return -1;
        }
        if a[i] > b[i] {
            return 1;
        }
        i += 1;
    }
    if a.len() < b.len() { -1 } else if a.len() > b.len() { 1 } else { 0 }
}

// The string(s) match_contains looks in.
enum Content {
    Unset,
    Text(String),
    Own(Vec[String]),
}

// The per-call state of a CSSMatch over an html.parser tree: no
// namespaces on the tree, so it is always HTML and never XML.
struct CssMatch {
    tag: i64,
    root: i64,
    scope: i64,
    namespaces: Vec[(String, String)],
    iframe_restrict: bool,
    cached_meta_lang: Vec[(i64, String)],
}

fn new_matcher_for(d: ref Soup, scope: i64, namespaces: ref Vec[(String, String)]) -> CssMatch {
    let mut doc = scope;
    let mut parent = d.parent(doc);
    while parent >= 0 {
        doc = parent;
        parent = d.parent(doc);
    }
    let mut root = -1;
    if doc != 0 {
        root = doc;
    } else {
        for c in d.nodes[doc].children.iter() {
            if d.is_tag(c) {
                root = c;
                break;
            }
        }
    }
    CssMatch {
        tag: scope,
        root: root,
        scope: if scope != doc { scope } else { root },
        namespaces: namespaces.clone(),
        iframe_restrict: false,
        cached_meta_lang: Vec.new(),
    }
}

fn ns_get(ns: ref Vec[(String, String)], key: ref String) -> Option[String] {
    let mut found: Option[String] = None;
    for (k, v) in ns.iter() {
        if k == key {
            found = Some(v.clone());
        }
    }
    found
}

impl CssMatch {
    // ---- navigation

    fn is_iframe(ref self, d: ref Soup, el: i64) -> bool {
        el >= 0 and d.is_tag(el) and lower_ascii(d.nodes[el].name) == "iframe"
    }

    fn is_root(ref self, d: ref Soup, el: i64) -> bool {
        if self.root >= 0 and self.root == el {
            return true;
        }
        let parent = self.get_parent(d, el, false);
        parent >= 0 and self.is_iframe(d, parent)
    }

    fn get_parent(ref self, d: ref Soup, el: i64, no_iframe: bool) -> i64 {
        let parent = if el >= 0 { d.parent(el) } else { -1 };
        if no_iframe and parent >= 0 and self.is_iframe(d, parent) {
            return -1;
        }
        parent
    }

    fn contents(ref self, d: ref Soup, el: i64, no_iframe: bool) -> Vec[i64] {
        if el < 0 or (no_iframe and self.is_iframe(d, el)) {
            return Vec.new();
        }
        d.nodes[el].children.clone()
    }

    fn tag_children(ref self, d: ref Soup, el: i64, no_iframe: bool) -> Vec[i64] {
        let mut out: Vec[i64] = Vec.new();
        for c in self.contents(d, el, no_iframe).iter() {
            if d.is_tag(c) {
                out.push(c);
            }
        }
        out
    }

    fn walk(ref self, d: ref Soup, el: i64, tags: bool, no_iframe: bool, out: mut ref Vec[i64]) {
        for c in d.nodes[el].children.iter() {
            if d.is_tag(c) {
                out.push(c);
                if not (no_iframe and self.is_iframe(d, c)) {
                    self.walk(d, c, tags, no_iframe, mut out);
                }
            } else if not tags {
                out.push(c);
            }
        }
    }

    fn descendants(ref self, d: ref Soup, el: i64, tags: bool, no_iframe: bool) -> Vec[i64] {
        let mut out: Vec[i64] = Vec.new();
        if el >= 0 and not (no_iframe and self.is_iframe(d, el)) {
            self.walk(d, el, tags, no_iframe, mut out);
        }
        out
    }

    fn get_tag(ref self, d: ref Soup, el: i64) -> String {
        lower_ascii(d.nodes[el].name)
    }

    fn next_tag(ref self, d: ref Soup, el: i64) -> i64 {
        let mut s = d.next_sibling(el);
        while s >= 0 and not d.is_tag(s) {
            s = d.next_sibling(s);
        }
        s
    }

    fn previous_tag(ref self, d: ref Soup, el: i64) -> i64 {
        let mut s = d.previous_sibling(el);
        while s >= 0 and not d.is_tag(s) {
            s = d.previous_sibling(s);
        }
        s
    }

    fn is_content_string(ref self, d: ref Soup, n: i64) -> bool {
        d.nodes[n].kind == k_text()
    }

    fn is_special_string(ref self, d: ref Soup, n: i64) -> bool {
        let k = d.nodes[n].kind;
        k != k_tag() and k != k_text()
    }

    // ---- attributes

    fn value_of(ref self, d: ref Soup, el: i64, i: i64) -> String {
        let node = ref d.nodes[el];
        if node.attr_multi[i] { split_ws(node.attr_values[i]).join(" ") } else { node.attr_values[i].clone() }
    }

    fn get_attribute_by_name(ref self, d: ref Soup, el: i64, name: Str) -> Option[String] {
        let mut i = 0;
        while i < d.nodes[el].attr_names.len() {
            if lower_ascii(d.nodes[el].attr_names[i]) == name {
                return Some(self.value_of(d, el, i));
            }
            i += 1;
        }
        None
    }

    fn get_classes(ref self, d: ref Soup, el: i64) -> Vec[String] {
        let mut i = 0;
        while i < d.nodes[el].attr_names.len() {
            if lower_ascii(d.nodes[el].attr_names[i]) == "class" {
                return split_ws(d.nodes[el].attr_values[i]);
            }
            i += 1;
        }
        Vec.new()
    }

    fn get_text(ref self, d: ref Soup, el: i64, no_iframe: bool) -> String {
        let mut out = String.new();
        for n in self.descendants(d, el, false, no_iframe).iter() {
            if self.is_content_string(d, n) {
                out.push_str(d.nodes[n].text);
            }
        }
        out
    }

    fn get_own_text(ref self, d: ref Soup, el: i64, no_iframe: bool) -> Vec[String] {
        let mut out: Vec[String] = Vec.new();
        for n in self.contents(d, el, no_iframe).iter() {
            if self.is_content_string(d, n) {
                out.push(d.nodes[n].text.clone());
            }
        }
        out
    }

    // ---- the checks

    fn find_bidi(ref self, d: ref Soup, res: ref Res, el: i64) -> i64 {
        for node in d.nodes[el].children.iter() {
            if d.is_tag(node) {
                let direction = dir_map(self.get_attribute_by_name(d, node, "dir").unwrap_or(String.new()));
                let name = self.get_tag(d, node);
                if name == "bdi" or name == "script" or name == "style" or name == "textarea" or name == "iframe" or direction != -1 {
                    continue;
                }
                let value = self.find_bidi(d, res, node);
                if value >= 0 {
                    return value;
                }
                continue;
            }
            if self.is_special_string(d, node) {
                continue;
            }
            for c in d.nodes[node].text.chars() {
                let b = bidi_class(res, c);
                if b != 0 {
                    return if b == 1 { sel_dir_ltr() } else { sel_dir_rtl() };
                }
            }
        }
        -1
    }

    fn extended_language_filter(ref self, res: ref Res, lang_range0: ref String, lang_tag: ref String) -> bool {
        let mut matched = true;
        let lang_range = re_sub_text(res.wild_strip, lang_range0, "-").to_lowercase();
        let ranges: Vec[String] = lang_range.split("-").map(|p| p.to_string()).collect();
        let subtags: Vec[String] = lang_tag.to_lowercase().split("-").map(|p| p.to_string()).collect();
        let length = ranges.len();
        let slength = subtags.len();
        let mut rindex = 0;
        let mut sindex = 0;
        let r = ranges[rindex].clone();
        let s = subtags[sindex].clone();
        if length == 1 and slength == 1 and r.is_empty() and r == s {
            return true;
        }
        if (r != "*" and r != s) or (r == "*" and slength == 1 and s.is_empty()) {
            matched = false;
        }
        rindex += 1;
        sindex += 1;
        while matched and rindex < length {
            let r = ranges[rindex].clone();
            if sindex >= slength {
                matched = false;
                continue;
            }
            let s = subtags[sindex].clone();
            if r.is_empty() {
                matched = false;
                continue;
            } else if s == r {
                rindex += 1;
            } else if char_len(s) == 1 {
                matched = false;
                continue;
            }
            sindex += 1;
        }
        matched
    }

    fn match_attribute_name(ref self, d: ref Soup, el: i64, attr: ref String) -> Option[String] {
        let want = lower_ascii(attr);
        let mut i = 0;
        while i < d.nodes[el].attr_names.len() {
            if lower_ascii(d.nodes[el].attr_names[i]) == want {
                return Some(self.value_of(d, el, i));
            }
            i += 1;
        }
        None
    }

    fn match_namespace(ref self, tag: ref SelectorTag) -> bool {
        let namespace = ns_xhtml();
        let default_namespace = ns_get(self.namespaces, "".to_string());
        let tag_ns = match tag.prefix {
            None => Some(String.new()),
            Some(ref p) => ns_get(self.namespaces, p),
        };
        match tag.prefix {
            None => {
                if let Some(ref dn) = default_namespace {
                    if namespace != dn {
                        return false;
                    }
                }
                true
            }
            Some(ref p) => {
                if p.is_empty() {
                    return namespace.is_empty();
                }
                if p != "*" {
                    match tag_ns {
                        None => return false,
                        Some(ref t) => {
                            if namespace != t {
                                return false;
                            }
                        }
                    }
                }
                true
            }
        }
    }

    fn match_attributes(ref self, d: ref Soup, el: i64, attributes: ref Vec[SelectorAttribute]) -> bool {
        for a in attributes.iter() {
            let temp = self.match_attribute_name(d, el, a.attribute);
            match temp {
                None => return false,
                Some(ref value) => {
                    if let Some(ref p) = a.pattern {
                        if not re_matches(p.prog, value) {
                            return false;
                        }
                    }
                }
            }
        }
        true
    }

    fn match_tag(ref self, d: ref Soup, el: i64, tag: ref Option[SelectorTag]) -> bool {
        match tag {
            None => true,
            Some(ref t) => {
                let mut matched = true;
                if not self.match_namespace(t) {
                    matched = false;
                }
                let name = lower_ascii(t.name);
                if name != self.get_tag(d, el) and name != "*" {
                    matched = false;
                }
                matched
            }
        }
    }

    fn match_past_relations(mut ref self, d: ref Soup, res: ref Res, el: i64, relation: ref SelectorList) -> bool {
        let rel = match relation.selectors[0] {
            SelItem.Null => return false,
            SelItem.Sel(ref s) => s.rel_type.clone().unwrap_or(String.new()),
        };
        let mut found = false;
        if rel == " " {
            let mut parent = self.get_parent(d, el, self.iframe_restrict);
            while not found and parent >= 0 {
                found = self.match_selectors(d, res, parent, relation);
                parent = self.get_parent(d, parent, self.iframe_restrict);
            }
        } else if rel == ">" {
            let parent = self.get_parent(d, el, self.iframe_restrict);
            if parent >= 0 {
                found = self.match_selectors(d, res, parent, relation);
            }
        } else if rel == "~" {
            let mut sibling = self.previous_tag(d, el);
            while not found and sibling >= 0 {
                found = self.match_selectors(d, res, sibling, relation);
                sibling = self.previous_tag(d, sibling);
            }
        } else if rel == "+" {
            let sibling = self.previous_tag(d, el);
            if sibling >= 0 {
                found = self.match_selectors(d, res, sibling, relation);
            }
        }
        found
    }

    fn match_future_child(mut ref self, d: ref Soup, res: ref Res, parent: i64, relation: ref SelectorList, recursive: bool) -> bool {
        let children = if recursive { self.descendants(d, parent, true, self.iframe_restrict) } else { self.tag_children(d, parent, self.iframe_restrict) };
        for child in children.iter() {
            if self.match_selectors(d, res, child, relation) {
                return true;
            }
        }
        false
    }

    fn match_future_relations(mut ref self, d: ref Soup, res: ref Res, el: i64, relation: ref SelectorList) -> bool {
        let rel = match relation.selectors[0] {
            SelItem.Null => return false,
            SelItem.Sel(ref s) => s.rel_type.clone().unwrap_or(String.new()),
        };
        let mut found = false;
        if rel == ": " {
            found = self.match_future_child(d, res, el, relation, true);
        } else if rel == ":>" {
            found = self.match_future_child(d, res, el, relation, false);
        } else if rel == ":~" {
            let mut sibling = self.next_tag(d, el);
            while not found and sibling >= 0 {
                found = self.match_selectors(d, res, sibling, relation);
                sibling = self.next_tag(d, sibling);
            }
        } else if rel == ":+" {
            let sibling = self.next_tag(d, el);
            if sibling >= 0 {
                found = self.match_selectors(d, res, sibling, relation);
            }
        }
        found
    }

    fn match_relations(mut ref self, d: ref Soup, res: ref Res, el: i64, relation: ref SelectorList) -> bool {
        let rel = match relation.selectors[0] {
            SelItem.Null => return false,
            SelItem.Sel(ref s) => match s.rel_type {
                None => return false,
                Some(ref r) => r.clone(),
            },
        };
        if rel.starts_with(":") {
            self.match_future_relations(d, res, el, relation)
        } else {
            self.match_past_relations(d, res, el, relation)
        }
    }

    fn match_id(ref self, d: ref Soup, el: i64, ids: ref Vec[String]) -> bool {
        let id = self.get_attribute_by_name(d, el, "id").unwrap_or(String.new());
        for i in ids.iter() {
            if i != id {
                return false;
            }
        }
        true
    }

    fn match_classes(ref self, d: ref Soup, el: i64, classes: ref Vec[String]) -> bool {
        let current = self.get_classes(d, el);
        for c in classes.iter() {
            if not has(current, c.as_str()) {
                return false;
            }
        }
        true
    }

    fn blocks_root(ref self, d: ref Soup, n: i64) -> bool {
        d.is_tag(n) or (self.is_content_string(d, n) and not py_strip(d.nodes[n].text).is_empty()) or d.nodes[n].kind == k_cdata()
    }

    fn match_root(ref self, d: ref Soup, el: i64) -> bool {
        let mut is_root = self.is_root(d, el);
        if is_root {
            let mut sibling = d.previous_sibling(el);
            while is_root and sibling >= 0 {
                if self.blocks_root(d, sibling) {
                    is_root = false;
                } else {
                    sibling = d.previous_sibling(sibling);
                }
            }
        }
        if is_root {
            let mut sibling = d.next_sibling(el);
            while is_root and sibling >= 0 {
                if self.blocks_root(d, sibling) {
                    is_root = false;
                } else {
                    sibling = d.next_sibling(sibling);
                }
            }
        }
        is_root
    }

    fn match_nth_tag_type(ref self, d: ref Soup, el: i64, child: i64) -> bool {
        self.get_tag(d, child) == self.get_tag(d, el)
    }

    fn match_nth(mut ref self, d: ref Soup, res: ref Res, el: i64, nth: ref Vec[SelectorNth]) -> bool {
        let mut matched = true;
        for n in nth.iter() {
            matched = false;
            if not n.selectors.selectors.is_empty() and not self.match_selectors(d, res, el, n.selectors) {
                break;
            }
            let parent = self.get_parent(d, el, false);
            let kids: Vec[i64] = if parent < 0 { vec![el] } else { d.nodes[parent].children.clone() };
            let last = n.last;
            let last_index = kids.len() - 1;
            let mut index = if last { last_index } else { 0 };
            let mut relative_index = 0;
            let a = n.a;
            let b = n.b;
            let var = n.n;
            let mut count = 0;
            let mut count_incr = 1;
            let factor = if last { -1 } else { 1 };
            let mut idx = if var { a * count + b } else { a };
            let mut last_idx = idx;
            if var {
                if a > 0 {
                    count = if b >= 1 { 0 } else { -floordiv(-(1 - b), a) };
                } else if a < 0 {
                    count = if b >= 1 { floordiv(b - 1, -a) } else { 0 };
                    count_incr = -1;
                }
                idx = a * count + b;
                last_idx = idx;
            }
            while 1 <= idx and idx <= last_index + 1 {
                let mut child = -1;
                if index >= 0 and index <= last_index {
                    let mut k = index;
                    while k >= 0 and k <= last_index {
                        child = kids[k];
                        k += factor;
                        index += factor;
                        if not d.is_tag(child) {
                            continue;
                        }
                        if not n.selectors.selectors.is_empty() and not self.match_selectors(d, res, child, n.selectors) {
                            continue;
                        }
                        if n.of_type and not self.match_nth_tag_type(d, el, child) {
                            continue;
                        }
                        relative_index += 1;
                        if relative_index == idx {
                            if child == el {
                                matched = true;
                            } else {
                                break;
                            }
                        }
                        if child == el {
                            break;
                        }
                    }
                }
                if child == el {
                    break;
                }
                last_idx = idx;
                count += count_incr;
                if count < 0 {
                    break;
                }
                idx = if var { a * count + b } else { a };
                if last_idx == idx {
                    break;
                }
            }
            if not matched {
                break;
            }
        }
        matched
    }

    fn match_empty(ref self, d: ref Soup, res: ref Res, el: i64) -> bool {
        for c in d.nodes[el].children.iter() {
            if d.is_tag(c) {
                return false;
            }
            if self.is_content_string(d, c) and re_search(res.not_empty, d.nodes[c].text) {
                return false;
            }
        }
        true
    }

    fn match_subselectors(mut ref self, d: ref Soup, res: ref Res, el: i64, selectors: ref Vec[SelectorList]) -> bool {
        let mut matched = true;
        for sel in selectors.iter() {
            if not self.match_selectors(d, res, el, sel) {
                matched = false;
            }
        }
        matched
    }

    fn match_contains(ref self, d: ref Soup, el: i64, contains: ref Vec[SelectorContains]) -> bool {
        let mut matched = true;
        let mut content = Content.Unset;
        let mut content_set = false;
        for cl in contains.iter() {
            if not content_set {
                content_set = true;
                content = if cl.own { Content.Own(self.get_own_text(d, el, true)) } else { Content.Text(self.get_text(d, el, true)) };
            }
            let mut found = false;
            for text in cl.text.iter() {
                if cl.own {
                    match content {
                        Content.Own(ref list) => {
                            for c in list.iter() {
                                if c.contains(text.as_str()) {
                                    found = true;
                                    break;
                                }
                            }
                        }
                        Content.Text(ref s) => {
                            for c in s.chars() {
                                if c.to_string().contains(text.as_str()) {
                                    found = true;
                                    break;
                                }
                            }
                        }
                        Content.Unset => {}
                    }
                    if found {
                        break;
                    }
                } else {
                    match content {
                        Content.Text(ref s) => {
                            if s.contains(text.as_str()) {
                                found = true;
                            }
                        }
                        Content.Own(ref list) => {
                            if has(list, text.as_str()) {
                                found = true;
                            }
                        }
                        Content.Unset => {}
                    }
                    if found {
                        break;
                    }
                }
            }
            if not found {
                matched = false;
            }
        }
        matched
    }

    fn match_default(ref self, d: ref Soup, el: i64) -> bool {
        let mut form = -1;
        let mut parent = self.get_parent(d, el, true);
        while parent >= 0 and form < 0 {
            if self.get_tag(d, parent) == "form" {
                form = parent;
            } else {
                parent = self.get_parent(d, parent, true);
            }
        }
        if form < 0 {
            return false;
        }
        for child in self.descendants(d, form, true, true).iter() {
            let name = self.get_tag(d, child);
            if name == "form" {
                break;
            }
            if name == "input" or name == "button" {
                let v = self.get_attribute_by_name(d, child, "type").unwrap_or(String.new());
                if not v.is_empty() and lower_ascii(v) == "submit" {
                    return el == child;
                }
            }
        }
        false
    }

    fn parent_form(ref self, d: ref Soup, el: i64) -> i64 {
        let mut parent = self.get_parent(d, el, true);
        loop {
            if parent >= 0 and self.get_tag(d, parent) == "form" {
                return parent;
            }
            let last_parent = parent;
            parent = self.get_parent(d, parent, true);
            if parent < 0 {
                return last_parent;
            }
        }
    }

    fn match_indeterminate(ref self, d: ref Soup, el: i64) -> bool {
        let name = self.get_attribute_by_name(d, el, "name");
        let form = self.parent_form(d, el);
        if form < 0 {
            return false;
        }
        let mut checked = false;
        for child in self.descendants(d, form, true, true).iter() {
            if child == el {
                continue;
            }
            if self.get_tag(d, child) == "input" {
                let mut is_radio = false;
                let mut check = false;
                let mut has_name = false;
                let node = ref d.nodes[child];
                let mut i = 0;
                while i < node.attr_names.len() {
                    let k = lower_ascii(node.attr_names[i]);
                    let v = self.value_of(d, child, i);
                    if k == "type" and lower_ascii(v) == "radio" {
                        is_radio = true;
                    } else if k == "name" and opt_eq(name, v) {
                        has_name = true;
                    } else if k == "checked" {
                        check = true;
                    }
                    if is_radio and check and has_name and self.parent_form(d, child) == form {
                        checked = true;
                        break;
                    }
                    i += 1;
                }
            }
            if checked {
                break;
            }
        }
        not checked
    }

    fn match_lang(mut ref self, d: ref Soup, res: ref Res, el: i64, langs: ref Vec[SelectorLang]) -> bool {
        let mut matched = false;
        let mut root = self.root;
        let mut parent = el;
        let mut found_lang: Option[String] = None;
        let mut last = -1;
        while not non_empty(found_lang) {
            let node = ref d.nodes[parent];
            let mut i = 0;
            while i < node.attr_names.len() {
                if lower_ascii(node.attr_names[i]) == "lang" {
                    found_lang = Some(self.value_of(d, parent, i));
                    break;
                }
                i += 1;
            }
            last = parent;
            parent = self.get_parent(d, parent, true);
            if parent < 0 {
                root = last;
                parent = last;
                break;
            }
        }
        if found_lang.is_none() and not self.cached_meta_lang.is_empty() {
            for (r, l) in self.cached_meta_lang.iter() {
                if root >= 0 and root == r {
                    found_lang = Some(l.clone());
                }
            }
        }
        if found_lang.is_none() {
            let mut found = false;
            for tag in ["html", "head"] {
                found = false;
                for child in self.tag_children(d, parent, true).iter() {
                    if self.get_tag(d, child) == tag {
                        found = true;
                        parent = child;
                        break;
                    }
                }
                if not found {
                    break;
                }
            }
            if found and parent >= 0 {
                for child2 in d.nodes[parent].children.iter() {
                    if d.is_tag(child2) and self.get_tag(d, child2) == "meta" {
                        let mut c_lang = false;
                        let mut content: Option[String] = None;
                        let node = ref d.nodes[child2];
                        let mut i = 0;
                        while i < node.attr_names.len() {
                            let k = lower_ascii(node.attr_names[i]);
                            let v = self.value_of(d, child2, i);
                            if k == "http-equiv" and lower_ascii(v) == "content-language" {
                                c_lang = true;
                            }
                            if k == "content" {
                                content = Some(v.clone());
                            }
                            if c_lang and non_empty(content) {
                                found_lang = content.clone();
                                self.cached_meta_lang.push((root, content.clone().unwrap()));
                                break;
                            }
                            i += 1;
                        }
                    }
                    if found_lang.is_some() {
                        break;
                    }
                }
                if found_lang.is_none() {
                    self.cached_meta_lang.push((root, String.new()));
                }
            }
        }
        if let Some(ref lang) = found_lang {
            for patterns in langs.iter() {
                matched = false;
                for pattern in patterns.languages.iter() {
                    if self.extended_language_filter(res, pattern, lang) {
                        matched = true;
                    }
                }
                if not matched {
                    break;
                }
            }
        }
        matched
    }

    fn match_dir(ref self, d: ref Soup, res: ref Res, el: i64, directionality: i64) -> bool {
        if directionality & sel_dir_ltr() != 0 and directionality & sel_dir_rtl() != 0 {
            return false;
        }
        if el < 0 {
            return false;
        }
        let direction = dir_map(self.get_attribute_by_name(d, el, "dir").unwrap_or(String.new()));
        if direction != -1 and direction != 0 {
            return direction == directionality;
        }
        let is_root = self.is_root(d, el);
        if is_root and direction == -1 {
            return sel_dir_ltr() == directionality;
        }
        let name = self.get_tag(d, el);
        let is_input = name == "input";
        let is_textarea = name == "textarea";
        let is_bdi = name == "bdi";
        let itype = if is_input { lower_ascii(self.get_attribute_by_name(d, el, "type").unwrap_or(String.new())) } else { String.new() };
        if is_input and itype == "tel" and direction == -1 {
            return sel_dir_ltr() == directionality;
        }
        let text_input = itype == "text" or itype == "search" or itype == "tel" or itype == "url" or itype == "email";
        if ((is_input and text_input) or is_textarea) and direction == 0 {
            let value = if is_textarea {
                let mut v = String.new();
                for n in self.contents(d, el, true).iter() {
                    if self.is_content_string(d, n) {
                        v.push_str(d.nodes[n].text);
                    }
                }
                v
            } else {
                self.get_attribute_by_name(d, el, "value").unwrap_or(String.new())
            };
            if not value.is_empty() {
                for c in value.chars() {
                    let b = bidi_class(res, c);
                    if b != 0 {
                        let dirn = if b == 1 { sel_dir_ltr() } else { sel_dir_rtl() };
                        return dirn == directionality;
                    }
                }
                return sel_dir_ltr() == directionality;
            } else if is_root {
                return sel_dir_ltr() == directionality;
            }
            return self.match_dir(d, res, self.get_parent(d, el, true), directionality);
        }
        if (is_bdi and direction == -1) or direction == 0 {
            let found = self.find_bidi(d, res, el);
            if found >= 0 {
                return found == directionality;
            } else if is_root {
                return sel_dir_ltr() == directionality;
            }
            return self.match_dir(d, res, self.get_parent(d, el, true), directionality);
        }
        self.match_dir(d, res, self.get_parent(d, el, true), directionality)
    }

    fn match_range(ref self, d: ref Soup, res: ref Res, el: i64, condition: i64) -> bool {
        let mut out_of_range = false;
        let itype = lower_ascii(self.get_attribute_by_name(d, el, "type").unwrap_or(String.new()));
        let mn = parse_input(res, itype, self.get_attribute_by_name(d, el, "min"));
        let mx = parse_input(res, itype, self.get_attribute_by_name(d, el, "max"));
        if mn.is_none() and mx.is_none() {
            return false;
        }
        let value = parse_input(res, itype, self.get_attribute_by_name(d, el, "value"));
        if let Some(ref v) = value {
            let below = match mn {
                Some(ref lo) => cmp_tuple(v, lo) < 0,
                None => false,
            };
            let above = match mx {
                Some(ref hi) => cmp_tuple(v, hi) > 0,
                None => false,
            };
            if itype == "date" or itype == "datetime-local" or itype == "month" or itype == "week" or itype == "number" or itype == "range" {
                out_of_range = below or above;
            } else if itype == "time" {
                let reversed = match (mn, mx) {
                    (Some(ref lo), Some(ref hi)) => cmp_tuple(lo, hi) > 0,
                    _ => false,
                };
                if reversed {
                    out_of_range = below and above;
                } else {
                    out_of_range = below or above;
                }
            }
        }
        if condition & sel_in_range() != 0 { not out_of_range } else { out_of_range }
    }

    fn match_defined(ref self, d: ref Soup, el: i64) -> bool {
        let name = self.get_tag(d, el);
        not name.contains("-") or name.contains(":")
    }

    fn match_placeholder_shown(ref self, d: ref Soup, el: i64) -> bool {
        let content = self.get_text(d, el, false);
        content.is_empty() or content == "\n"
    }

    fn match_selectors(mut ref self, d: ref Soup, res: ref Res, el: i64, selectors: ref SelectorList) -> bool {
        let mut matched = false;
        let is_not = selectors.is_not;
        let is_html = selectors.is_html;
        let saved_ns = self.namespaces.clone();
        let saved_restrict = self.iframe_restrict;
        if is_html {
            self.namespaces = vec![("html".to_string(), ns_xhtml())];
            self.iframe_restrict = true;
        }
        for item in selectors.selectors.iter() {
            matched = is_not;
            let selector = match item {
                SelItem.Null => continue,
                SelItem.Sel(ref s) => s,
            };
            if not self.match_tag(d, el, selector.tag) {
                continue;
            }
            if selector.flags & sel_defined() != 0 and not self.match_defined(d, el) {
                continue;
            }
            if selector.flags & sel_root() != 0 and not self.match_root(d, el) {
                continue;
            }
            if selector.flags & sel_scope() != 0 and not (self.scope == el) {
                continue;
            }
            if selector.flags & sel_placeholder_shown() != 0 and not self.match_placeholder_shown(d, el) {
                continue;
            }
            if not self.match_nth(d, res, el, selector.nth) {
                continue;
            }
            if selector.flags & sel_empty() != 0 and not self.match_empty(d, res, el) {
                continue;
            }
            if not selector.ids.is_empty() and not self.match_id(d, el, selector.ids) {
                continue;
            }
            if not selector.classes.is_empty() and not self.match_classes(d, el, selector.classes) {
                continue;
            }
            if not self.match_attributes(d, el, selector.attributes) {
                continue;
            }
            if selector.flags & ranges_flags() != 0 and not self.match_range(d, res, el, selector.flags & ranges_flags()) {
                continue;
            }
            if not selector.lang.is_empty() and not self.match_lang(d, res, el, selector.lang) {
                continue;
            }
            if not selector.selectors.is_empty() and not self.match_subselectors(d, res, el, selector.selectors) {
                continue;
            }
            if not selector.relation.selectors.is_empty() and not self.match_relations(d, res, el, selector.relation) {
                continue;
            }
            if selector.flags & sel_default() != 0 and not self.match_default(d, el) {
                continue;
            }
            if selector.flags & sel_indeterminate() != 0 and not self.match_indeterminate(d, el) {
                continue;
            }
            if selector.flags & dir_flags() != 0 and not self.match_dir(d, res, el, selector.flags & dir_flags()) {
                continue;
            }
            if not selector.contains.is_empty() and not self.match_contains(d, el, selector.contains) {
                continue;
            }
            matched = not is_not;
            break;
        }
        if is_html {
            self.namespaces = saved_ns;
            self.iframe_restrict = saved_restrict;
        }
        matched
    }

    fn matches(mut ref self, d: ref Soup, res: ref Res, el: i64, selectors: ref SelectorList) -> bool {
        el != 0 and d.is_tag(el) and self.match_selectors(d, res, el, selectors)
    }

    fn select(mut ref self, d: ref Soup, res: ref Res, selectors: ref SelectorList, limit: i64) -> Vec[i64] {
        let mut out: Vec[i64] = Vec.new();
        let mut lim = limit;
        for child in self.descendants(d, self.tag, true, false).iter() {
            if self.matches(d, res, child, selectors) {
                out.push(child);
                if limit >= 1 {
                    lim -= 1;
                    if lim < 1 {
                        break;
                    }
                }
            }
        }
        out
    }

    fn closest(mut ref self, d: ref Soup, res: ref Res, selectors: ref SelectorList) -> i64 {
        let mut current = self.tag;
        while current >= 0 {
            if self.matches(d, res, current, selectors) {
                return current;
            }
            current = self.get_parent(d, current, false);
        }
        -1
    }

    fn filter(mut ref self, d: ref Soup, res: ref Res, selectors: ref SelectorList) -> Vec[i64] {
        let mut out: Vec[i64] = Vec.new();
        for c in self.contents(d, self.tag, false).iter() {
            if d.is_tag(c) and self.matches(d, res, c, selectors) {
                out.push(c);
            }
        }
        out
    }
}

// RE_WILD_STRIP.sub(repl, s) with a plain replacement.
fn re_sub_text(pr: ref Program, s: ref String, repl: Str) -> String {
    let c = cps(s);
    let mut out = String.new();
    let mut i = 0;
    for m in all_matches(pr, c, 0).iter() {
        out.push_str(to_string(slice(c, i, m.start)));
        out.push_str(repl);
        i = m.end;
    }
    out.push_str(to_string(slice(c, i, c.len())));
    out
}

// ---------------------------------------------------------------- the jobs

fn field(s: ref String) -> String {
    s.replace("∅", "").replace("⏎", "\n").replace("⇥", "\t").replace("␣", " ").replace("␀", "\u{0}").replace("␁", "\u{1}").replace("␉", "\t").replace("␡", "\u{7f}")
}

// "-" or name=value pairs joined by "¦".
fn pairs(s: ref String) -> Option[Vec[(String, String)]] {
    if s == "-" {
        return None;
    }
    let mut out: Vec[(String, String)] = Vec.new();
    for p in s.split("¦") {
        match p.split_once("=") {
            Some((k, v)) => out.push((field(k.to_string()), field(v.to_string()))),
            None => out.push((field(p.to_string()), String.new())),
        }
    }
    Some(out)
}

struct Page {
    name: String,
    soup: Soup,
    // the tags in document order (soup.find_all()), and each node's
    // place in that list
    tags: Vec[i64],
    order: Vec[i64],
}

fn load_page(name: ref String, ents: ref Map[String, String]) -> Result[Page, String] {
    let html = match fs.read_to_string(f"data/pages/{name}") {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read {name}: {e}"),
    };
    let soup = parse_soup(html, ents);
    let mut tags: Vec[i64] = Vec.new();
    let mut order: Vec[i64] = Vec.new();
    let mut n = 0;
    while n < soup.nodes.len() {
        if n > 0 and soup.is_tag(n) {
            order.push(tags.len());
            tags.push(n);
        } else {
            order.push(-1);
        }
        n += 1;
    }
    Ok(Page { name: name.clone(), soup: soup, tags: tags, order: order })
}

// Tag.get(name), with a list value joined by spaces.
fn attr_get(soup: ref Soup, n: i64, name: Str) -> Option[String] {
    let node = ref soup.nodes[n];
    let mut i = 0;
    while i < node.attr_names.len() {
        if node.attr_names[i] == name {
            return Some(if node.attr_multi[i] { split_ws(node.attr_values[i]).join(" ") } else { node.attr_values[i].clone() });
        }
        i += 1;
    }
    None
}

fn desc(p: ref Page, el: i64) -> String {
    if el < 0 {
        return "None".to_string();
    }
    if el == 0 {
        return "[document]".to_string();
    }
    let mut s = f"{p.order[el]}:{p.soup.nodes[el].name}";
    if let Some(id) = attr_get(p.soup, el, "id") {
        s.push_str(f"#{id}");
    }
    let mut i = 0;
    while i < p.soup.nodes[el].attr_names.len() {
        if p.soup.nodes[el].attr_names[i] == "class" {
            for c in split_ws(p.soup.nodes[el].attr_values[i]).iter() {
                s.push_str(f".{c}");
            }
        }
        i += 1;
    }
    s
}

fn descs(p: ref Page, els: ref Vec[i64]) -> String {
    let mut out: Vec[String] = Vec.new();
    for e in els.iter() {
        out.push(desc(p, e));
    }
    out.join(" ")
}

fn node_of(p: ref Page, which: ref String) -> i64 {
    if which == "-" { 0 } else { p.tags[digits_int(which)] }
}

struct Run {
    res: Res,
    ctx: Ctx,
    ents: Map[String, String],
    pages: Vec[Page],
}

impl Run {
    fn page(mut ref self, name: ref String) -> Result[i64, String] {
        let mut i = 0;
        while i < self.pages.len() {
            if self.pages[i].name == name {
                return Ok(i);
            }
            i += 1;
        }
        let p = load_page(name, self.ents)?;
        self.pages.push(p);
        Ok(self.pages.len() - 1)
    }

    fn compile(mut ref self, pattern: ref String, custom: ref String) -> Result[SelectorList, String] {
        compile_css(self.res, mut self.ctx, field(pattern), pairs(custom))
    }

    fn job(mut ref self, w: ref Vec[String]) -> Result[String, String] {
        let kind = w[0].clone();
        if kind == "parse" {
            let l = self.compile(w[1], "-".to_string())?;
            return Ok(list_repr(l));
        }
        if kind == "escape" {
            return Ok(py_repr(css_escape(field(w[1]))));
        }
        let pi = self.page(w[1])?;
        if kind == "select" {
            let sels = self.compile(w[4], w[6])?;
            let ns = pairs(w[5]).unwrap_or(Vec.new());
            let p = ref self.pages[pi];
            let mut m = new_matcher_for(p.soup, node_of(p, w[2]), ns);
            let found = m.select(p.soup, self.res, sels, digits_int(w[3]));
            return Ok(f"{found.len()}: {descs(p, found)}");
        }
        if kind == "helper" {
            // sv.select() never passes custom= through, so it is dropped here too.
            let sels = self.compile(w[3], "-".to_string())?;
            let p = ref self.pages[pi];
            let mut m = new_matcher_for(p.soup, node_of(p, w[2]), Vec.new());
            let found = m.select(p.soup, self.res, sels, 0);
            return Ok(f"{found.len()}: {descs(p, found)}");
        }
        if kind == "attr" {
            let sels = self.compile(w[2], "-".to_string())?;
            let p = ref self.pages[pi];
            let mut m = new_matcher_for(p.soup, 0, Vec.new());
            let found = m.select(p.soup, self.res, sels, 0);
            let mut out: Vec[String] = Vec.new();
            for t in found.iter() {
                let v = match attr_get(p.soup, t, w[3].as_str()) {
                    Some(v) => py_repr(v),
                    None => "None".to_string(),
                };
                out.push(f"{desc(p, t)}={v}");
            }
            return Ok(out.join(" "));
        }
        let sels = self.compile(w[3], "-".to_string())?;
        let p = ref self.pages[pi];
        let el = node_of(p, w[2]);
        let mut m = new_matcher_for(p.soup, el, Vec.new());
        if kind == "one" {
            let found = m.select(p.soup, self.res, sels, 1);
            return Ok(if found.is_empty() { "None".to_string() } else { desc(p, found[0]) });
        }
        if kind == "match" {
            let r = m.matches(p.soup, self.res, el, sels);
            return Ok(f"{desc(p, el)} {py_bool(r)}");
        }
        if kind == "closest" {
            let c = m.closest(p.soup, self.res, sels);
            return Ok(f"{desc(p, el)} -> {desc(p, c)}");
        }
        if kind == "filter" {
            let found = m.filter(p.soup, self.res, sels);
            return Ok(f"{desc(p, el)}: {found.len()}: {descs(p, found)}");
        }
        Err(f"bad job {kind}")
    }
}

fn write_data() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data/pages".to_string()) {
        return Err(f"cannot create data/pages: {e}");
    }
    for (name, text) in data_files().into_iter() {
        let path = f"data/{name}";
        if let Err(e) = fs.write(path.clone(), text) {
            return Err(f"cannot write {path}: {e}");
        }
    }
    Ok(())
}

fn lines_of(text: ref String) -> Vec[String] {
    let mut v = split_nl(text);
    if v.len() > 0 and v[v.len() - 1].is_empty() {
        v.pop();
    }
    v
}

fn run() -> Result[(), String] {
    write_data()?;
    let mut r = Run {
        res: new_res()?,
        ctx: Ctx { custom: Map.new(), pseudo: Map.new() },
        ents: html5_entities(),
        pages: Vec.new(),
    };
    let jobs = match fs.read_to_string("data/jobs.tsv".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/jobs.tsv: {e}"),
    };
    for line in lines_of(jobs).iter() {
        if line.starts_with("#") {
            println(line);
            continue;
        }
        println(f"-- {line.replace("\t", " | ")}");
        let w: Vec[String] = line.split("\t").map(|p| p.to_string()).collect();
        match r.job(w) {
            Ok(s) => println(f"   {s}"),
            Err(e) => println(f"   raised {e}"),
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"error: {e}");
    }
}

// ---------------------------------------------------------------- data

// html.entities.html5: each name (with or without its ';') and its text.
fn html5_entities() -> Map[String, String] {
    let mut m: Map[String, String] = Map.new();
    add_entities_0(mut m);
    add_entities_1(mut m);
    add_entities_2(mut m);
    add_entities_3(mut m);
    add_entities_4(mut m);
    add_entities_5(mut m);
    add_entities_6(mut m);
    add_entities_7(mut m);
    add_entities_8(mut m);
    m
}

fn add_entities_0(m: mut ref Map[String, String]) {
    m.insert("AElig".to_string(), "\u{c6}".to_string());
    m.insert("AElig;".to_string(), "\u{c6}".to_string());
    m.insert("AMP".to_string(), "&".to_string());
