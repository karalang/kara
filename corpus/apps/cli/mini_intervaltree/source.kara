// mini_intervaltree: intervaltree 3.1.0, Chaim Halbert's mutable,
// self-balancing interval tree, as genome annotation lookups, calendars,
// IP allowlists and media timelines in Python use it. It reads the job
// list from data/jobs.tsv: command traces that drive IntervalTree and
// Interval through their API, and four programs built on them.
//
// The tree is intervaltree's: AVL-balanced nodes, each holding the
// intervals that contain its center point, with a SortedDict of interval
// boundaries beside it. An IntervalTree is a set, so every set of
// intervals prints sorted, in Interval's own order.
//
// Python's exceptions are Exc values: the class name and str(exc).

#[derive(Clone)]
struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: own String) -> Exc {
    Exc { kind: kind.to_string(), msg: msg }
}

// An interval's data: None, an int or a str.
#[derive(Clone, PartialEq)]
enum Data {
    Nil,
    Int(i64),
    Text(String),
}

fn data_str(d: ref Data) -> String {
    match d {
        Data.Nil => "None".to_string(),
        Data.Int(n) => f"{n}",
        Data.Text(ref s) => s.clone(),
    }
}

fn data_repr(d: ref Data) -> String {
    match d {
        Data.Nil => "None".to_string(),
        Data.Int(n) => f"{n}",
        Data.Text(ref s) => str_repr(s),
    }
}

// Where a type's name falls among NoneType, int and str: what
// Interval.__cmp__ compares when the data themselves cannot be.
fn data_rank(d: ref Data) -> i64 {
    match d {
        Data.Nil => 0,
        Data.Int(_) => 1,
        Data.Text(_) => 2,
    }
}

#[derive(Clone, PartialEq)]
struct Interval {
    begin: i64,
    end: i64,
    data: Data,
}

fn ivl(begin: i64, end: i64, data: own Data) -> Interval {
    Interval { begin: begin, end: end, data: data }
}

impl Interval {
    fn contains_point(ref self, p: i64) -> bool {
        self.begin <= p and p < self.end
    }

    fn overlaps_range(ref self, begin: i64, end: i64) -> bool {
        begin < self.end and end > self.begin
    }

    fn is_null(ref self) -> bool {
        self.begin >= self.end
    }

    fn length(ref self) -> i64 {
        if self.is_null() { 0 } else { self.end - self.begin }
    }

    fn range_matches(ref self, other: ref Interval) -> bool {
        self.begin == other.begin and self.end == other.end
    }

    fn contains_interval(ref self, other: ref Interval) -> bool {
        self.begin <= other.begin and self.end >= other.end
    }

    fn repr(ref self) -> String {
        match self.data {
            Data.Nil => f"Interval({self.begin}, {self.end})",
            _ => f"Interval({self.begin}, {self.end}, {data_repr(self.data)})",
        }
    }
}

// Interval.__cmp__: the range, then the data, then the data's type name.
fn iv_cmp(a: ref Interval, b: ref Interval) -> i64 {
    if a.begin != b.begin {
        return if a.begin < b.begin { -1 } else { 1 };
    }
    if a.end != b.end {
        return if a.end < b.end { -1 } else { 1 };
    }
    if a.data == b.data {
        return 0;
    }
    let ra = data_rank(a.data);
    let rb = data_rank(b.data);
    if ra != rb {
        return if ra < rb { -1 } else { 1 };
    }
    match a.data {
        Data.Int(x) => match b.data {
            Data.Int(y) => if x < y { -1 } else { 1 },
            _ => 0,
        },
        Data.Text(ref x) => match b.data {
            Data.Text(ref y) => if x < y { -1 } else { 1 },
            _ => 0,
        },
        Data.Nil => 0,
    }
}

// sorted(intervals).
fn sort_ivs(v: ref Vec[Interval]) -> Vec[Interval] {
    let mut keyed: Vec[(i64, i64, i64, i64, String, i64)] = Vec.new();
    let mut i = 0;
    while i < v.len() {
        let iv = v[i].clone();
        let (n, s) = match iv.data {
            Data.Int(x) => (x, "".to_string()),
            Data.Text(ref t) => (0, t.clone()),
            Data.Nil => (0, "".to_string()),
        };
        keyed.push((iv.begin, iv.end, data_rank(iv.data), n, s, i));
        i += 1;
    }
    keyed.sort();
    let mut out: Vec[Interval] = Vec.new();
    for k in keyed {
        out.push(v[k.5].clone());
    }
    out
}

fn ivs_repr(v: ref Vec[Interval]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for iv in sort_ivs(v) {
        parts.push(iv.repr());
    }
    f"[{parts.join(", ")}]"
}

fn has_iv(v: ref Vec[Interval], iv: ref Interval) -> bool {
    for x in v {
        if x == iv {
            return true;
        }
    }
    false
}

// set.add.
fn set_add(v: mut ref Vec[Interval], iv: ref Interval) {
    if not has_iv(v, iv) {
        v.push(iv.clone());
    }
}

// set.remove: whether it was there.
fn set_remove(v: mut ref Vec[Interval], iv: ref Interval) -> bool {
    let mut i = 0;
    while i < v.len() {
        if v[i] == iv {
            v.remove(i);
            return true;
        }
        i += 1;
    }
    false
}

fn same_set(a: ref Vec[Interval], b: ref Vec[Interval]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for x in a {
        if not has_iv(b, x) {
            return false;
        }
    }
    true
}

fn null_error(iv: ref Interval) -> Exc {
    exc("ValueError", f"IntervalTree: Null Interval objects not allowed in IntervalTree: {iv.repr()}")
}

// --------------------------------------------- Interval with an argument

// The `other` of Interval's methods: a point or an interval.
#[derive(Clone)]
enum Other {
    Point(i64),
    Iv(Interval),
}

fn compare_null(a: ref Interval, b: ref Other) -> Result[(), Exc] {
    let bad = exc("ValueError", "Cannot compare null Intervals!".to_string());
    if a.is_null() {
        return Err(bad);
    }
    if let Other.Iv(ref o) = b {
        if o.is_null() {
            return Err(bad);
        }
    }
    Ok(())
}

fn arg_overlaps(a: ref Interval, b: ref Other) -> bool {
    match b {
        Other.Point(p) => a.contains_point(p),
        Other.Iv(ref o) => a.overlaps_range(o.begin, o.end),
    }
}

fn no_begin() -> Exc {
    exc("AttributeError", "'int' object has no attribute 'begin'".to_string())
}

fn max_i(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

fn min_i(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

fn iv_op(op: ref String, a: ref Interval, b: ref Option[Other]) -> Result[String, Exc] {
    if op == "length" {
        return Ok(f"{a.length()}");
    }
    if op == "is_null" {
        return Ok(bool_repr(a.is_null()));
    }
    if op == "repr" {
        return Ok(a.repr());
    }
    let other = match b {
        Some(ref x) => x.clone(),
        None => Other.Point(0),
    };
    if op == "overlaps" {
        return Ok(bool_repr(arg_overlaps(a, other)));
    }
    if op == "overlap_size" {
        if not arg_overlaps(a, other) {
            return Ok("0".to_string());
        }
        return match other {
            Other.Iv(ref o) => Ok(f"{min_i(a.end, o.end) - max_i(a.begin, o.begin)}"),
            Other.Point(_) => Err(no_begin()),
        };
    }
    if op == "distance_to" {
        if arg_overlaps(a, other) {
            return Ok("0".to_string());
        }
        let d = match other {
            Other.Iv(ref o) => if a.begin < o.begin { o.begin - a.end } else { a.begin - o.end },
            Other.Point(p) => if a.end <= p { p - a.end } else { a.begin - p },
        };
        return Ok(f"{d}");
    }
    if op == "contains_point" {
        return match other {
            Other.Point(p) => Ok(bool_repr(a.contains_point(p))),
            Other.Iv(_) => Ok(bool_repr(false)),
        };
    }
    if op == "contains_interval" or op == "range_matches" or op == "==" {
        return match other {
            Other.Iv(ref o) => {
                let r = if op == "contains_interval" {
                    a.contains_interval(o)
                } else if op == "range_matches" {
                    a.range_matches(o)
                } else {
                    a == o
                };
                Ok(bool_repr(r))
            }
            Other.Point(_) => Ok(bool_repr(false)),
        };
    }
    if op == "lt" or op == "le" or op == "gt" or op == "ge" {
        compare_null(a, other)?;
        let r = match other {
            Other.Point(p) => {
                if op == "lt" {
                    a.end <= p
                } else if op == "le" {
                    a.end <= p
                } else if op == "gt" {
                    a.begin > p
                } else {
                    a.begin >= p
                }
            }
            Other.Iv(ref o) => {
                if op == "lt" {
                    a.end <= o.begin
                } else if op == "le" {
                    a.end <= o.end
                } else if op == "gt" {
                    a.begin >= o.end
                } else {
                    a.begin >= o.begin
                }
            }
        };
        return Ok(bool_repr(r));
    }
    // < and >: __cmp__, where a point compares as the tuple (p,).
    let c = match other {
        Other.Iv(ref o) => iv_cmp(a, o),
        Other.Point(p) => if a.begin < p { -1 } else { 1 },
    };
    Ok(bool_repr(if op == "<" { c < 0 } else { c > 0 }))
}

// --------------------------------------------------------------- Node

// intervaltree.node.Node. The nodes live in the tree's `nodes`, and a
// node is its index there; -1 is None.
struct Node {
    x: i64,
    s: Vec[Interval],
    left: i64,
    right: i64,
    depth: i64,
    balance: i64,
}

struct IntervalTree {
    nodes: Vec[Node],
    top: i64,
    all: Vec[Interval],
    bounds: Vec[i64],
    counts: Map[i64, i64],
}

impl IntervalTree {
    fn child(ref self, n: i64, right: bool) -> i64 {
        if right { self.nodes[n].right } else { self.nodes[n].left }
    }

    fn set_child(mut ref self, n: i64, right: bool, c: i64) {
        if right {
            self.nodes[n].right = c;
        } else {
            self.nodes[n].left = c;
        }
    }

    // Node(x_center, s_center): a leaf, balanced as __init__ leaves it.
    fn new_node(mut ref self, x: i64, s: own Vec[Interval]) -> i64 {
        self.nodes.push(Node { x: x, s: s, left: -1, right: -1, depth: 0, balance: 0 });
        let n = self.nodes.len() - 1;
        self.refresh_balance(n);
        n
    }

    fn depth_of(ref self, n: i64) -> i64 {
        if n < 0 { 0 } else { self.nodes[n].depth }
    }

    fn refresh_balance(mut ref self, n: i64) {
        let l = self.depth_of(self.nodes[n].left);
        let r = self.depth_of(self.nodes[n].right);
        self.nodes[n].depth = 1 + max_i(l, r);
        self.nodes[n].balance = r - l;
    }

    fn center_hit(ref self, n: i64, iv: ref Interval) -> bool {
        iv.contains_point(self.nodes[n].x)
    }

    fn from_sorted(mut ref self, ivs: ref Vec[Interval]) -> i64 {
        if ivs.len() == 0 {
            return -1;
        }
        let x = ivs[ivs.len() / 2].begin;
        let mut center: Vec[Interval] = Vec.new();
        let mut left: Vec[Interval] = Vec.new();
        let mut right: Vec[Interval] = Vec.new();
        for k in ivs {
            if k.end <= x {
                left.push(k.clone());
            } else if k.begin > x {
                right.push(k.clone());
            } else {
                set_add(mut center, k);
            }
        }
        let n = self.new_node(x, center);
        let l = self.from_sorted(left);
        let r = self.from_sorted(right);
        self.nodes[n].left = l;
        self.nodes[n].right = r;
        self.rotate(n)
    }

    fn rotate(mut ref self, n: i64) -> i64 {
        self.refresh_balance(n);
        let bal = self.nodes[n].balance;
        if bal < 2 and bal > -2 {
            return n;
        }
        let my_heavy = bal > 0;
        let c = self.child(n, my_heavy);
        let child_heavy = self.nodes[c].balance > 0;
        if my_heavy == child_heavy or self.nodes[c].balance == 0 {
            self.srotate(n)
        } else {
            self.drotate(n)
        }
    }

    fn srotate(mut ref self, n: i64) -> i64 {
        let heavy = self.nodes[n].balance > 0;
        let light = not heavy;
        let save = self.child(n, heavy);
        let moved = self.child(save, light);
        self.set_child(n, heavy, moved);
        let r = self.rotate(n);
        self.set_child(save, light, r);
        let lighter = self.child(save, light);
        let mut promotees: Vec[Interval] = Vec.new();
        for iv in self.nodes[lighter].s.clone() {
            if self.center_hit(save, iv) {
                promotees.push(iv.clone());
            }
        }
        if promotees.len() > 0 {
            for iv in promotees {
                let c = self.child(save, light);
                let mut done = false;
                let next = match self.remove_helper(c, iv, mut done, true) {
                    Ok(m) => m,
                    Err(_) => c,
                };
                self.set_child(save, light, next);
            }
            for iv in promotees {
                set_add(mut self.nodes[save].s, iv);
            }
        }
        self.refresh_balance(save);
        save
    }

    fn drotate(mut ref self, n: i64) -> i64 {
        let my_heavy = self.nodes[n].balance > 0;
        let c = self.child(n, my_heavy);
        let r = self.srotate(c);
        self.set_child(n, my_heavy, r);
        self.refresh_balance(n);
        self.srotate(n)
    }

    fn node_add(mut ref self, n: i64, iv: ref Interval) -> i64 {
        if self.center_hit(n, iv) {
            set_add(mut self.nodes[n].s, iv);
            return n;
        }
        let dir = iv.begin > self.nodes[n].x;
        let c = self.child(n, dir);
        if c < 0 {
            let mut s: Vec[Interval] = Vec.new();
            s.push(iv.clone());
            let leaf = self.new_node(iv.begin, s);
            self.set_child(n, dir, leaf);
            self.refresh_balance(n);
            n
        } else {
            let r = self.node_add(c, iv);
            self.set_child(n, dir, r);
            self.rotate(n)
        }
    }

    fn remove_helper(mut ref self, n: i64, iv: ref Interval, done: mut ref bool, raise: bool) -> Result[i64, Exc] {
        if self.center_hit(n, iv) {
            if not raise and not has_iv(self.nodes[n].s, iv) {
                *done = true;
                return Ok(n);
            }
            if not set_remove(mut self.nodes[n].s, iv) {
                return Err(exc("KeyError", iv.repr()));
            }
            if self.nodes[n].s.len() > 0 {
                *done = true;
                return Ok(n);
            }
            return Ok(self.prune(n));
        }
        let dir = iv.begin > self.nodes[n].x;
        let c = self.child(n, dir);
        if c < 0 {
            if raise {
                return Err(exc("ValueError", "".to_string()));
            }
            *done = true;
            return Ok(n);
        }
        let r = self.remove_helper(c, iv, mut done, raise)?;
        self.set_child(n, dir, r);
        if not *done {
            return Ok(self.rotate(n));
        }
        Ok(n)
    }

    fn search_point(ref self, n: i64, p: i64, result: mut ref Vec[Interval]) {
        for k in self.nodes[n].s {
            if k.begin <= p and p < k.end {
                set_add(mut result, k);
            }
        }
        let x = self.nodes[n].x;
        if p < x and self.nodes[n].left >= 0 {
            self.search_point(self.nodes[n].left, p, mut result);
        } else if p > x and self.nodes[n].right >= 0 {
            self.search_point(self.nodes[n].right, p, mut result);
        }
    }

    fn prune(mut ref self, n: i64) -> i64 {
        let l = self.nodes[n].left;
        let r = self.nodes[n].right;
        if l < 0 or r < 0 {
            return if l < 0 { r } else { l };
        }
        let (heir, new_left) = self.pop_greatest_child(l);
        self.nodes[n].left = new_left;
        self.nodes[heir].left = self.nodes[n].left;
        self.nodes[heir].right = self.nodes[n].right;
        self.refresh_balance(heir);
        self.rotate(heir)
    }

    fn pop_greatest_child(mut ref self, n: i64) -> (i64, i64) {
        if self.nodes[n].right < 0 {
            let mut ends: Vec[i64] = Vec.new();
            for iv in self.nodes[n].s {
                ends.push(iv.end);
            }
            ends.sort();
            let max_end = ends[ends.len() - 1];
            let mut new_x = self.nodes[n].x;
            for e in ends {
                if e != max_end and e > new_x {
                    new_x = e;
                }
            }
            let mut moved: Vec[Interval] = Vec.new();
            let mut kept: Vec[Interval] = Vec.new();
            for iv in self.nodes[n].s.clone() {
                if iv.contains_point(new_x) {
                    moved.push(iv.clone());
                } else {
                    kept.push(iv.clone());
                }
            }
            let child = self.new_node(new_x, moved);
            let empty = kept.len() == 0;
            self.nodes[n].s = kept;
            if not empty {
                (child, n)
            } else {
                (child, self.nodes[n].left)
            }
        } else {
            let (gc, new_right) = self.pop_greatest_child(self.nodes[n].right);
            self.nodes[n].right = new_right;
            let gx = self.nodes[gc].x;
            for iv in self.nodes[n].s.clone() {
                if iv.contains_point(gx) {
                    set_remove(mut self.nodes[n].s, iv);
                    let _ = self.node_add(gc, iv);
                }
            }
            if self.nodes[n].s.len() > 0 {
                self.refresh_balance(n);
                let ns = self.rotate(n);
                (gc, ns)
            } else {
                let ns = self.prune(n);
                (gc, ns)
            }
        }
    }

    fn node_contains_point(ref self, n: i64, p: i64) -> bool {
        for iv in self.nodes[n].s {
            if iv.contains_point(p) {
                return true;
            }
        }
        let b = self.child(n, p > self.nodes[n].x);
        b >= 0 and self.node_contains_point(b, p)
    }

    fn all_children(ref self, n: i64, out: mut ref Vec[Interval]) {
        for iv in self.nodes[n].s {
            set_add(mut out, iv);
        }
        if self.nodes[n].left >= 0 {
            self.all_children(self.nodes[n].left, mut out);
        }
        if self.nodes[n].right >= 0 {
            self.all_children(self.nodes[n].right, mut out);
        }
    }

    // Node.verify, as a yes or no.
    fn node_verify(mut ref self, n: i64, parents: ref Vec[i64]) -> bool {
        let bal = self.nodes[n].balance;
        if bal >= 2 or bal <= -2 {
            return false;
        }
        self.refresh_balance(n);
        if bal != self.nodes[n].balance or self.nodes[n].s.len() == 0 {
            return false;
        }
        let x = self.nodes[n].x;
        for iv in self.nodes[n].s {
            if iv.begin >= iv.end or not iv.contains_point(x) {
                return false;
            }
            for p in parents {
                if iv.contains_point(p) {
                    return false;
                }
            }
        }
        let mut below = parents.clone();
        below.push(x);
        let l = self.nodes[n].left;
        if l >= 0 {
            if self.nodes[l].x >= x or not self.node_verify(l, below) {
                return false;
            }
        }
        let r = self.nodes[n].right;
        if r >= 0 {
            if self.nodes[r].x <= x or not self.node_verify(r, below) {
                return false;
            }
        }
        true
    }
}

// ------------------------------------------------------- IntervalTree

// How merge_overlaps and merge_equals combine data: not at all, by
// joining them with "+", or by counting them from 0.
enum Reducer {
    Plain,
    Join,
    Count,
}

fn reduce_data(r: ref Reducer, a: ref Data, b: ref Data) -> Data {
    match r {
        Reducer.Join => Data.Text(f"{data_str(a)}+{data_str(b)}"),
        Reducer.Count => match a {
            Data.Int(n) => Data.Int(n + 1),
            _ => Data.Int(1),
        },
        Reducer.Plain => Data.Nil,
    }
}

impl IntervalTree {
    fn new() -> IntervalTree {
        IntervalTree { nodes: Vec.new(), top: -1, all: Vec.new(), bounds: Vec.new(), counts: Map.new() }
    }

    // IntervalTree(intervals).
    fn of(ivs: ref Vec[Interval]) -> Result[IntervalTree, Exc] {
        let mut t = IntervalTree.new();
        t.reinit(ivs)?;
        Ok(t)
    }

    fn reinit(mut ref self, ivs: ref Vec[Interval]) -> Result[(), Exc] {
        let mut set: Vec[Interval] = Vec.new();
        for iv in ivs {
            set_add(mut set, iv);
        }
        for iv in set {
            if iv.is_null() {
                return Err(null_error(iv));
            }
        }
        self.nodes = Vec.new();
        self.bounds = Vec.new();
        self.counts = Map.new();
        let sorted = sort_ivs(set);
        self.top = self.from_sorted(sorted);
        self.all = set;
        for iv in self.all.clone() {
            self.add_boundaries(iv);
        }
        Ok(())
    }

    fn len(ref self) -> i64 {
        self.all.len()
    }

    fn contains(ref self, iv: ref Interval) -> bool {
        has_iv(self.all, iv)
    }

    fn bump(mut ref self, k: i64, by: i64) {
        let old = match self.counts.get(k) {
            Some(c) => *c,
            None => 0,
        };
        if old == 0 {
            let i = bisect_left(self.bounds, k);
            self.bounds.insert(i, k);
        }
        if old + by == 0 {
            self.counts.remove(k);
            let i = bisect_left(self.bounds, k);
            self.bounds.remove(i);
        } else {
            self.counts.insert(k, old + by);
        }
    }

    fn add_boundaries(mut ref self, iv: ref Interval) {
        self.bump(iv.begin, 1);
        self.bump(iv.end, 1);
    }

    fn remove_boundaries(mut ref self, iv: ref Interval) {
        self.bump(iv.begin, -1);
        self.bump(iv.end, -1);
    }

    fn add(mut ref self, iv: ref Interval) -> Result[(), Exc] {
        if self.contains(iv) {
            return Ok(());
        }
        if iv.is_null() {
            return Err(null_error(iv));
        }
        if self.top < 0 {
            let mut s: Vec[Interval] = Vec.new();
            s.push(iv.clone());
            self.top = self.new_node(iv.begin, s);
        } else {
            self.top = self.node_add(self.top, iv);
        }
        self.all.push(iv.clone());
        self.add_boundaries(iv);
        Ok(())
    }

    fn update(mut ref self, ivs: ref Vec[Interval]) -> Result[(), Exc] {
        for iv in ivs {
            self.add(iv)?;
        }
        Ok(())
    }

    fn remove(mut ref self, iv: ref Interval) -> Result[(), Exc] {
        if not self.contains(iv) {
            return Err(exc("ValueError", "".to_string()));
        }
        let mut done = false;
        self.top = self.remove_helper(self.top, iv, mut done, true)?;
        set_remove(mut self.all, iv);
        self.remove_boundaries(iv);
        Ok(())
    }

    fn discard(mut ref self, iv: ref Interval) {
        if not self.contains(iv) {
            return;
        }
        set_remove(mut self.all, iv);
        let mut done = false;
        self.top = match self.remove_helper(self.top, iv, mut done, false) {
            Ok(n) => n,
            Err(_) => self.top,
        };
        self.remove_boundaries(iv);
    }

    fn discard_all(mut ref self, ivs: ref Vec[Interval]) {
        for iv in ivs {
            self.discard(iv);
        }
    }

    fn remove_all(mut ref self, ivs: ref Vec[Interval]) -> Result[(), Exc] {
        for iv in ivs {
            self.remove(iv)?;
        }
        Ok(())
    }

    fn at(ref self, p: i64) -> Vec[Interval] {
        let mut out: Vec[Interval] = Vec.new();
        if self.top >= 0 {
            self.search_point(self.top, p, mut out);
        }
        out
    }

    fn overlap(ref self, begin: i64, end: i64) -> Vec[Interval] {
        let mut out: Vec[Interval] = Vec.new();
        if self.top < 0 or begin >= end {
            return out;
        }
        self.search_point(self.top, begin, mut out);
        let lo = bisect_left(self.bounds, begin);
        let hi = bisect_left(self.bounds, end);
        let mut i = lo;
        while i < hi {
            self.search_point(self.top, self.bounds[i], mut out);
            i += 1;
        }
        out
    }

    fn envelop(ref self, begin: i64, end: i64) -> Vec[Interval] {
        let mut out: Vec[Interval] = Vec.new();
        for iv in self.overlap(begin, end) {
            if iv.begin >= begin and iv.end <= end {
                out.push(iv.clone());
            }
        }
        out
    }

    fn overlaps_point(ref self, p: i64) -> bool {
        self.len() > 0 and self.node_contains_point(self.top, p)
    }

    fn overlaps_range(ref self, begin: i64, end: i64) -> bool {
        if self.len() == 0 or begin >= end {
            return false;
        }
        if self.overlaps_point(begin) {
            return true;
        }
        for b in self.bounds {
            if begin < b and b < end and self.overlaps_point(b) {
                return true;
            }
        }
        false
    }

    fn remove_overlap(mut ref self, begin: i64, end: Option[i64]) -> Result[(), Exc] {
        let hits = match end {
            None => self.at(begin),
            Some(e) => self.overlap(begin, e),
        };
        self.remove_all(hits)
    }

    fn remove_envelop(mut ref self, begin: i64, end: i64) -> Result[(), Exc] {
        let hits = self.envelop(begin, end);
        self.remove_all(hits)
    }

    // chop, with datafunc marking the two halves or not.
    fn chop(mut ref self, begin: i64, end: i64, mark: ref Fn(ref Interval, bool) -> Data) -> Result[(), Exc] {
        let mut begin_hits: Vec[Interval] = Vec.new();
        for iv in self.at(begin) {
            if iv.begin < begin {
                begin_hits.push(iv.clone());
            }
        }
        let mut end_hits: Vec[Interval] = Vec.new();
        for iv in self.at(end) {
            if iv.end > end {
                end_hits.push(iv.clone());
            }
        }
        let mut insertions: Vec[Interval] = Vec.new();
        for iv in begin_hits {
            set_add(mut insertions, ivl(iv.begin, begin, mark(iv, true)));
        }
        for iv in end_hits {
            set_add(mut insertions, ivl(end, iv.end, mark(iv, false)));
        }
        self.remove_envelop(begin, end)?;
        self.discard_all(begin_hits);
        self.discard_all(end_hits);
        self.update(insertions)
    }

    fn slice(mut ref self, point: i64, mark: ref Fn(ref Interval, bool) -> Data) -> Result[(), Exc] {
        let mut hits: Vec[Interval] = Vec.new();
        for iv in self.at(point) {
            if iv.begin < point {
                hits.push(iv.clone());
            }
        }
        let mut insertions: Vec[Interval] = Vec.new();
        for iv in hits {
            set_add(mut insertions, ivl(iv.begin, point, mark(iv, true)));
            set_add(mut insertions, ivl(point, iv.end, mark(iv, false)));
        }
        self.discard_all(hits);
        self.update(insertions)
    }

    fn split_overlaps(mut ref self) -> Result[(), Exc] {
        if self.len() == 0 or self.bounds.len() == 2 {
            return Ok(());
        }
        let bounds = self.bounds.clone();
        let mut new_ivs: Vec[Interval] = Vec.new();
        let mut i = 0;
        while i + 1 < bounds.len() {
            for iv in self.at(bounds[i]) {
                set_add(mut new_ivs, ivl(bounds[i], bounds[i + 1], iv.data.clone()));
            }
            i += 1;
        }
        self.reinit(new_ivs)
    }

    // merge_overlaps (equals: false) and merge_equals (equals: true).
    fn merge(mut ref self, r: ref Reducer, equals: bool, strict: bool) -> Result[(), Exc] {
        if self.len() == 0 {
            return Ok(());
        }
        let mut merged: Vec[Interval] = Vec.new();
        let mut current = Data.Nil;
        for higher in sort_ivs(self.all) {
            let joins = if merged.len() > 0 {
                let lower = merged[merged.len() - 1].clone();
                if equals {
                    higher.range_matches(lower)
                } else {
                    higher.begin < lower.end or (not strict and higher.begin == lower.end)
                }
            } else {
                false
            };
            if joins {
                let lower = merged[merged.len() - 1].clone();
                let upper = max_i(lower.end, higher.end);
                current = match r {
                    Reducer.Plain => Data.Nil,
                    _ => reduce_data(r, current, higher.data),
                };
                let last = merged.len() - 1;
                merged[last] = ivl(lower.begin, upper, current.clone());
            } else {
                match r {
                    Reducer.Count => {
                        current = reduce_data(r, Data.Int(0), higher.data);
                        merged.push(ivl(higher.begin, higher.end, current.clone()));
                    }
                    _ => {
                        current = higher.data.clone();
                        merged.push(higher.clone());
                    }
                }
            }
        }
        self.reinit(merged)
    }

    fn begin(ref self) -> i64 {
        if self.bounds.len() == 0 { 0 } else { self.bounds[0] }
    }

    fn end(ref self) -> i64 {
        if self.bounds.len() == 0 { 0 } else { self.bounds[self.bounds.len() - 1] }
    }

    fn span(ref self) -> i64 {
        if self.len() == 0 { 0 } else { self.end() - self.begin() }
    }

    // tree[start:stop].
    fn get_slice(ref self, start: Option[i64], stop: Option[i64]) -> Vec[Interval] {
        let s = match start {
            Some(x) => x,
            None => {
                if stop.is_none() {
                    return self.all.clone();
                }
                self.begin()
            }
        };
        let e = match stop {
            Some(x) => x,
            None => self.end(),
        };
        self.overlap(s, e)
    }

    fn copy(ref self) -> IntervalTree {
        match IntervalTree.of(self.all) {
            Ok(t) => t,
            Err(_) => IntervalTree.new(),
        }
    }

    fn repr(ref self) -> String {
        if self.len() == 0 {
            "IntervalTree()".to_string()
        } else {
            f"IntervalTree({ivs_repr(self.all)})"
        }
    }

    // IntervalTree.verify, as a yes or no.
    fn verify(mut ref self) -> bool {
        if self.len() == 0 {
            return self.bounds.len() == 0 and self.top < 0;
        }
        let mut kids: Vec[Interval] = Vec.new();
        self.all_children(self.top, mut kids);
        if not same_set(kids, self.all) {
            return false;
        }
        let mut check: Map[i64, i64] = Map.new();
        for iv in self.all {
            if iv.is_null() {
                return false;
            }
            for k in [iv.begin, iv.end] {
                let c = match check.get(k) {
                    Some(c) => *c,
                    None => 0,
                };
                check.insert(k, c + 1);
            }
        }
        if check.len() != self.bounds.len() {
            return false;
        }
        for b in self.bounds {
            let want = match check.get(b) {
                Some(c) => *c,
                None => 0,
            };
            let got = match self.counts.get(b) {
                Some(c) => *c,
                None => 0,
            };
            if want != got {
                return false;
            }
        }
        let none: Vec[i64] = Vec.new();
        self.node_verify(self.top, none)
    }
}

fn bisect_left(v: ref Vec[i64], x: i64) -> i64 {
    let mut lo = 0;
    let mut hi = v.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if v[mid] < x {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo
}

fn keep_data(iv: ref Interval, lower: bool) -> Data {
    iv.data.clone()
}

// ------------------------------------------------------------- traces

fn none_repr() -> String {
    "None".to_string()
}

fn num(s: ref String) -> i64 {
    match i64.parse(s.clone()) {
        Ok(n) => n,
        Err(_) => 0,
    }
}

fn arg(s: ref String) -> Option[i64] {
    if s == "_" { None } else { Some(num(s)) }
}

fn data_of(s: ref String) -> Data {
    if s == "_" {
        Data.Nil
    } else if s.starts_with("#") {
        Data.Int(num(s[1..].to_string()))
    } else {
        Data.Text(s.clone())
    }
}

fn iv_of(tok: ref String) -> Interval {
    let f: Vec[String] = tok.split(":").map(|p| p.to_string()).collect();
    let d = if f.len() > 2 { data_of(f[2]) } else { Data.Nil };
    ivl(num(f[0]), num(f[1]), d)
}

fn ivs_of(a: ref Vec[String]) -> Vec[Interval] {
    let mut out: Vec[Interval] = Vec.new();
    for t in a {
        out.push(iv_of(t));
    }
    out
}

fn words(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for w in s.split(" ") {
        if w.len() > 0 {
            out.push(w.to_string());
        }
    }
    out
}

fn lines_of(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for l in s.split("\n") {
        out.push(l.to_string());
    }
    if out.len() > 0 and out[out.len() - 1].len() == 0 {
        out.pop();
    }
    out
}

fn str_repr(s: ref String) -> String {
    let mut out = String.new();
    let q = if s.contains("'") and not s.contains("\"") { "\"" } else { "'" };
    out.push_str(q);
    for c in s.chars() {
        if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\'' and q == "'" {
            out.push_str("\\'");
        } else {
            out.push(c);
        }
    }
    out.push_str(q);
    out
}

fn bool_repr(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

// The trace's datafunc: the data, then < for the lower half or > for
// the upper.
fn mark_halves(iv: ref Interval, lower: bool) -> Data {
    Data.Text(f"{data_str(iv.data)}{if lower { "<" } else { ">" }}")
}

fn tree_repr(r: ref Result[IntervalTree, Exc]) -> Result[String, Exc] {
    match r {
        Ok(t) => Ok(t.repr()),
        Err(e) => Err(e.clone()),
    }
}

fn reducer_of(name: ref String) -> Reducer {
    if name.ends_with("join") {
        Reducer.Join
    } else if name.ends_with("count") {
        Reducer.Count
    } else {
        Reducer.Plain
    }
}

fn tree_cmd(t: mut ref IntervalTree, c: ref String, a: ref Vec[String]) -> Result[String, Exc] {
    if c == "add" {
        t.add(iv_of(a[0]))?;
        return Ok(none_repr());
    }
    if c == "set" {
        t.add(ivl(num(a[0]), num(a[1]), data_of(a[2])))?;
        return Ok(none_repr());
    }
    if c == "update" {
        t.update(ivs_of(a))?;
        return Ok(none_repr());
    }
    if c == "remove" {
        t.remove(iv_of(a[0]))?;
        return Ok(none_repr());
    }
    if c == "discard" {
        t.discard(iv_of(a[0]));
        return Ok(none_repr());
    }
    if c == "at" {
        return Ok(ivs_repr(t.at(num(a[0]))));
    }
    if c == "overlap" {
        return Ok(ivs_repr(t.overlap(num(a[0]), num(a[1]))));
    }
    if c == "envelop" {
        return Ok(ivs_repr(t.envelop(num(a[0]), num(a[1]))));
    }
    if c == "overlaps" {
        let r = if a.len() == 1 { t.overlaps_point(num(a[0])) } else { t.overlaps_range(num(a[0]), num(a[1])) };
        return Ok(bool_repr(r));
    }
    if c == "contains" {
        return Ok(bool_repr(t.contains(iv_of(a[0]))));
    }
    if c == "get" {
        return Ok(ivs_repr(t.get_slice(arg(a[0]), arg(a[1]))));
    }
    if c == "del" {
        t.remove_overlap(num(a[0]), None)?;
        return Ok(none_repr());
    }
    if c == "remove_overlap" {
        let end = if a.len() > 1 { Some(num(a[1])) } else { None };
        t.remove_overlap(num(a[0]), end)?;
        return Ok(none_repr());
    }
    if c == "remove_envelop" {
        t.remove_envelop(num(a[0]), num(a[1]))?;
        return Ok(none_repr());
    }
    if c == "chop" or c == "chopf" {
        if c == "chop" {
            t.chop(num(a[0]), num(a[1]), keep_data)?;
        } else {
            t.chop(num(a[0]), num(a[1]), mark_halves)?;
        }
        return Ok(none_repr());
    }
    if c == "slice" or c == "slicef" {
        if c == "slice" {
            t.slice(num(a[0]), keep_data)?;
        } else {
            t.slice(num(a[0]), mark_halves)?;
        }
        return Ok(none_repr());
    }
    if c == "split_overlaps" {
        t.split_overlaps()?;
        return Ok(none_repr());
    }
    if c.starts_with("merge_equals") {
        t.merge(reducer_of(c), true, true)?;
        return Ok(none_repr());
    }
    if c.starts_with("merge") {
        t.merge(reducer_of(c), false, a[0] == "1")?;
        return Ok(none_repr());
    }
    if c == "begin" {
        return Ok(f"{t.begin()}");
    }
    if c == "end" {
        return Ok(f"{t.end()}");
    }
    if c == "span" {
        return Ok(f"{t.span()}");
    }
    if c == "range" {
        return Ok(ivl(t.begin(), t.end(), Data.Nil).repr());
    }
    if c == "len" {
        return Ok(f"{t.len()}");
    }
    if c == "is_empty" {
        return Ok(bool_repr(t.len() == 0));
    }
    let other = ivs_of(a);
    if c == "union" {
        let mut all = t.all.clone();
        for iv in other {
            all.push(iv.clone());
        }
        return tree_repr(IntervalTree.of(all));
    }
    if c == "intersection" {
        let mut both: Vec[Interval] = Vec.new();
        for iv in t.all {
            if has_iv(other, iv) {
                both.push(iv.clone());
            }
        }
        return tree_repr(IntervalTree.of(both));
    }
    if c == "difference" {
        let mut left: Vec[Interval] = Vec.new();
        for iv in t.all {
            if not has_iv(other, iv) {
                left.push(iv.clone());
            }
        }
        return tree_repr(IntervalTree.of(left));
    }
    if c == "symmetric_difference" {
        let mut out: Vec[Interval] = Vec.new();
        for iv in t.all {
            if not has_iv(other, iv) {
                out.push(iv.clone());
            }
        }
        for iv in other {
            if not t.contains(iv) {
                out.push(iv.clone());
            }
        }
        return tree_repr(IntervalTree.of(out));
    }
    if c == "difference_update" {
        t.discard_all(other);
        return Ok(none_repr());
    }
    if c == "intersection_update" {
        for iv in t.all.clone() {
            if not has_iv(other, iv) {
                t.remove(iv)?;
            }
        }
        return Ok(none_repr());
    }
    if c == "symmetric_difference_update" {
        let mut rest: Vec[Interval] = Vec.new();
        for iv in other {
            set_add(mut rest, iv);
        }
        for iv in t.all.clone() {
            if has_iv(rest, iv) {
                t.remove(iv)?;
                set_remove(mut rest, iv);
            }
        }
        t.update(rest)?;
        return Ok(none_repr());
    }
    if c == "eq" {
        let u = IntervalTree.of(other)?;
        return Ok(bool_repr(same_set(u.all, t.all)));
    }
    if c == "copy" {
        let u = t.copy();
        return Ok(f"{bool_repr(same_set(u.all, t.all))} {u.repr()}");
    }
    if c == "clear" {
        *t = IntervalTree.new();
        return Ok(none_repr());
    }
    tree_repr(IntervalTree.of(other))
}

fn emit(out: mut ref String, s: ref String) {
    out.push_str(s);
    out.push_str("\n");
}

fn trace_job(rel: ref String, out: mut ref String) {
    let mut t = IntervalTree.new();
    for line in lines_of(read_text(rel)) {
        let f = words(line);
        let c = f[0].clone();
        let a = f[1..].to_vec();
        if c == "verify" {
            emit(mut out, if t.verify() { "verify: ok" } else { "verify: FAILED" });
            continue;
        }
        if c == "repr" {
            emit(mut out, f"repr: {t.repr()}");
            continue;
        }
        if c == "items" {
            emit(mut out, f"items: {ivs_repr(t.all)}");
            continue;
        }
        let r = if c == "iv" {
            let b = if a.len() > 2 {
                if a[2].contains(":") { Some(Other.Iv(iv_of(a[2]))) } else { Some(Other.Point(num(a[2]))) }
            } else {
                None
            };
            iv_op(a[0], iv_of(a[1]), b)
        } else {
            tree_cmd(mut t, c, a)
        };
        match r {
            Ok(s) => emit(mut out, f"{line}: {s}"),
            Err(e) => emit(mut out, f"{line}: error: {e.kind}: {e.msg}"),
        }
    }
}

// ---------------------------------------------------------- scenarios

fn text_of(d: ref Data) -> String {
    data_str(d)
}

fn names(v: ref Vec[Interval]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for iv in sort_ivs(v) {
        parts.push(text_of(iv.data));
    }
    if parts.len() == 0 { "-".to_string() } else { parts.join(" ") }
}

fn tabs(line: ref String) -> Vec[String] {
    line.split("\t").map(|p| p.to_string()).collect()
}

fn count_of(d: ref Data) -> i64 {
    match d {
        Data.Int(n) => n,
        _ => 0,
    }
}

// find_nested: each interval that contains others, with what it holds.
fn find_nested(t: ref IntervalTree) -> Vec[(Interval, Vec[Interval])] {
    let mut keyed: Vec[(i64, i64)] = Vec.new();
    let mut i = 0;
    while i < t.all.len() {
        keyed.push((-t.all[i].length(), i));
        i += 1;
    }
    keyed.sort();
    let mut long: Vec[Interval] = Vec.new();
    for k in keyed {
        long.push(t.all[k.1].clone());
    }
    let mut found: Vec[(Interval, Vec[Interval])] = Vec.new();
    let mut p = 0;
    while p < long.len() {
        let mut kids: Vec[Interval] = Vec.new();
        let mut c = p + 1;
        while c < long.len() {
            if long[p].contains_interval(long[c]) {
                set_add(mut kids, long[c]);
            }
            c += 1;
        }
        if kids.len() > 0 {
            found.push((long[p].clone(), kids));
        }
        p += 1;
    }
    found
}

fn genome_job(genes_rel: ref String, variants_rel: ref String, reads_rel: ref String, out: mut ref String) {
    let mut chroms: Vec[String] = Vec.new();
    let mut genes: Map[String, Vec[Interval]] = Map.new();
    for line in lines_of(read_text(genes_rel)) {
        let f = tabs(line);
        if not genes.contains_key(f[0]) {
            genes.insert(f[0].clone(), Vec.new());
            chroms.push(f[0].clone());
        }
        if let Some(v) = genes.get_mut(f[0]) {
            v.push(ivl(num(f[1]), num(f[2]), Data.Text(f"{f[3]}({f[4]})")));
        }
    }
    chroms.sort();
    let mut trees: Map[String, IntervalTree] = Map.new();
    for chrom in chroms {
        let ivs = match genes.get(chrom) {
            Some(v) => v.clone(),
            None => Vec.new(),
        };
        let mut t = match IntervalTree.of(ivs) {
            Ok(t) => t,
            Err(_) => IntervalTree.new(),
        };
        if not t.verify() {
            emit(mut out, "verify FAILED");
        }
        emit(mut out, f"{chrom}: {t.len()} genes, {t.begin()}..{t.end()}, span {t.span()}");
        let mut cover = t.copy();
        let _ = cover.merge(Reducer.Count, false, false);
        let mut total = 0;
        let mut multi: Vec[Interval] = Vec.new();
        for iv in cover.all {
            total += iv.length();
            if count_of(iv.data) > 1 {
                multi.push(iv.clone());
            }
        }
        let mut shown: Vec[String] = Vec.new();
        for iv in sort_ivs(multi) {
            if shown.len() < 6 {
                shown.push(f"{iv.begin}-{iv.end}({count_of(iv.data)})");
            }
        }
        let blocks = if shown.len() == 0 { "-".to_string() } else { shown.join(" ") };
        emit(mut out, f"  covered {total} bp in {cover.len()} blocks; blocks of 2 or more genes: {blocks}");
        let mut parents: Vec[Interval] = Vec.new();
        let found = find_nested(t);
        for (p, _) in found {
            parents.push(p.clone());
        }
        let mut k = 0;
        for p in sort_ivs(parents) {
            if k < 5 {
                for (q, kids) in found {
                    if q == p {
                        emit(mut out, f"  inside {text_of(p.data)}: {names(kids)}");
                    }
                }
            }
            k += 1;
        }
        trees.insert(chrom.clone(), t);
    }
    for line in lines_of(read_text(variants_rel)) {
        let f = tabs(line);
        let chrom = f[0].clone();
        let pos = num(f[1]);
        let head = f"{f[2]} {chrom}:{pos} {f[3]}";
        match trees.get(chrom) {
            None => emit(mut out, f"{head}: no annotation for {chrom}"),
            Some(t) => {
                let hits = t.at(pos);
                if hits.len() > 0 {
                    emit(mut out, f"{head}: in {names(hits)}");
                } else {
                    let mut best: Option[(i64, Interval)] = None;
                    for iv in sort_ivs(t.all) {
                        let d = if iv.end <= pos { pos - iv.end } else { iv.begin - pos };
                        let better = match best {
                            None => true,
                            Some((bd, _)) => d < bd,
                        };
                        if better {
                            best = Some((d, iv.clone()));
                        }
                    }
                    if let Some((d, iv)) = best {
                        emit(mut out, f"{head}: intergenic, nearest {text_of(iv.data)} at {d} bp");
                    }
                }
            }
        }
    }
    for line in lines_of(read_text(reads_rel)) {
        let f = tabs(line);
        let s = num(f[1]);
        let e = num(f[2]);
        if let Some(t) = trees.get(f[0]) {
            emit(mut out, f"{f[3]} {f[0]}:{s}-{e}: overlaps {names(t.overlap(s, e))}; contains {names(t.envelop(s, e))}");
        }
    }
}

// -------------------------------------------------------------- calendar

fn two(n: i64) -> String {
    if n < 10 { f"0{n}" } else { f"{n}" }
}

fn hm(m: i64) -> String {
    f"{two(m / 60)}:{two(m % 60)}"
}

fn part(iv: ref Interval, lower: bool) -> Data {
    Data.Text(f"{data_str(iv.data)} ({if lower { "before" } else { "after" }})")
}

fn slots(v: ref Vec[Interval]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for iv in sort_ivs(v) {
        parts.push(f"{hm(iv.begin)}-{hm(iv.end)} {text_of(iv.data)}");
    }
    parts.join(", ")
}

// A day's calendars: atlas, then boreal.
struct Day {
    name: String,
    rooms: Vec[IntervalTree],
}

fn day_index(days: mut ref Vec[Day], name: ref String) -> i64 {
    let mut i = 0;
    while i < days.len() {
        if days[i].name == name {
            return i;
        }
        i += 1;
    }
    let mut rooms: Vec[IntervalTree] = Vec.new();
    rooms.push(IntervalTree.new());
    rooms.push(IntervalTree.new());
    days.push(Day { name: name.clone(), rooms: rooms });
    days.len() - 1
}

fn room_index(room: ref String) -> i64 {
    if room == "atlas" { 0 } else { 1 }
}

fn calendar_job(rel: ref String, out: mut ref String) {
    let mut days: Vec[Day] = Vec.new();
    let rooms = ["atlas".to_string(), "boreal".to_string()];
    for line in lines_of(read_text(rel)) {
        let f = words(line);
        if f[0] == "block" {
            let di = day_index(mut days, f[1]);
            let s = num(f[2]);
            let e = num(f[3]);
            for room in rooms {
                let ri = room_index(room);
                let hit = days[di].rooms[ri].overlap(s, e).len();
                let _ = days[di].rooms[ri].chop(s, e, part);
                let now = slots(days[di].rooms[ri].overlap(s - 60, e + 60));
                emit(mut out, f"block {f[1]} {room} {hm(s)}-{hm(e)} {f[4]}: moved {hit}, now {if now.len() == 0 { "-".to_string() } else { now }}");
            }
        } else if f[0] == "cancel" {
            let di = day_index(mut days, f[1]);
            let s = num(f[2]);
            for room in rooms {
                let ri = room_index(room);
                let hit = slots(days[di].rooms[ri].at(s));
                let _ = days[di].rooms[ri].remove_overlap(s, None);
                emit(mut out, f"cancel {f[1]} {room} {hm(s)}: {if hit.len() == 0 { "nothing".to_string() } else { hit }}");
            }
        } else if f[0] == "free" {
            let di = day_index(mut days, f[1]);
            let need = num(f[2]);
            let mut all = days[di].rooms[0].all.clone();
            for iv in days[di].rooms[1].all {
                all.push(iv.clone());
            }
            let mut busy = match IntervalTree.of(all) {
                Ok(t) => t,
                Err(_) => IntervalTree.new(),
            };
            let _ = busy.merge(Reducer.Plain, false, false);
            let mut gaps: Vec[String] = Vec.new();
            let mut t = 480;
            for iv in sort_ivs(busy.all) {
                if iv.begin - t >= need {
                    gaps.push(f"{hm(t)}-{hm(iv.begin)}");
                }
                t = max_i(t, iv.end);
            }
            if 1080 - t >= need {
                gaps.push(f"{hm(t)}-{hm(1080)}");
            }
            let shown = if gaps.len() == 0 { "none".to_string() } else { gaps.join(" ") };
            emit(mut out, f"free {f[1]} {need} min in both rooms: {shown}");
        } else {
            let di = day_index(mut days, f[0]);
            let s = num(f[2]);
            let e = num(f[3]);
            let ri = room_index(f[1]);
            let head = f"{f[0]} {f[1]} {hm(s)}-{hm(e)} {f[4]}";
            if days[di].rooms[ri].overlaps_range(s, e) {
                emit(mut out, f"{head}: clashes with {slots(days[di].rooms[ri].get_slice(Some(s), Some(e)))}");
            } else {
                let _ = days[di].rooms[ri].add(ivl(s, e, Data.Text(f[4].clone())));
                emit(mut out, f"{head}: booked");
            }
        }
    }
    let mut order: Vec[String] = Vec.new();
    for d in days {
        order.push(d.name.clone());
    }
    order.sort();
    for name in order {
        let di = day_index(mut days, name);
        for room in rooms {
            let ri = room_index(room);
            if not days[di].rooms[ri].verify() {
                emit(mut out, "verify FAILED");
            }
            emit(mut out, f"agenda {name} {room} ({days[di].rooms[ri].len()})");
            for iv in sort_ivs(days[di].rooms[ri].all) {
                emit(mut out, f"  {hm(iv.begin)}-{hm(iv.end)} {text_of(iv.data)}");
            }
        }
    }
}

// ------------------------------------------------------------- allowlist

fn ip_num(s: ref String) -> i64 {
    let mut n = 0;
    for p in s.split(".") {
        n = n * 256 + num(p.to_string());
    }
    n
}

fn ip_str(n: i64) -> String {
    f"{n >> 24}.{(n >> 16) & 255}.{(n >> 8) & 255}.{n & 255}"
}

fn cidr(s: ref String) -> (i64, i64) {
    let f: Vec[String] = s.split("/").map(|p| p.to_string()).collect();
    let start = ip_num(f[0]);
    (start, start + (1 << (32 - num(f[1]))))
}

fn span_str(iv: ref Interval) -> String {
    f"{ip_str(iv.begin)}-{ip_str(iv.end - 1)}"
}

fn ranges(v: ref Vec[Interval]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for iv in sort_ivs(v) {
        parts.push(f"{span_str(iv)} {text_of(iv.data)}");
    }
    parts.join(", ")
}

fn allowlist_job(rel: ref String, out: mut ref String) {
    let mut t = IntervalTree.new();
    for line in lines_of(read_text(rel)) {
        let f = words(line);
        if f[0] == "allow" {
            let (s, e) = cidr(f[1]);
            let _ = t.add(ivl(s, e, Data.Text(f[2].clone())));
        } else if f[0] == "deny" {
            let (s, e) = cidr(f[1]);
            let cut = ranges(t.overlap(s, e));
            let _ = t.chop(s, e, keep_data);
            emit(mut out, f"deny {f[1]}: cut {if cut.len() == 0 { "nothing".to_string() } else { cut }}");
        } else {
            let hit = t.at(ip_num(f[1]));
            if hit.len() > 0 {
                emit(mut out, f"check {f[1]}: allowed by {ranges(hit)}");
            } else {
                emit(mut out, f"check {f[1]}: refused");
            }
        }
    }
    if not t.verify() {
        emit(mut out, "verify FAILED");
    }
    emit(mut out, f"ranges: {t.len()}, {ip_str(t.begin())} to {ip_str(t.end() - 1)}");
    let mut flat = t.copy();
    let _ = flat.split_overlaps();
    let _ = flat.merge(Reducer.Join, true, true);
    emit(mut out, f"disjoint ranges: {flat.len()}");
    for iv in sort_ivs(flat.all) {
        emit(mut out, f"  {span_str(iv)} {text_of(iv.data)}");
    }
}

// ------------------------------------------------------------- subtitles

fn pad3(n: i64) -> String {
    if n < 10 { f"00{n}" } else if n < 100 { f"0{n}" } else { f"{n}" }
}

fn ts(ms: i64) -> String {
    f"{two(ms / 60000)}:{two(ms / 1000 % 60)}.{pad3(ms % 1000)}"
}

fn cue_part(iv: ref Interval, lower: bool) -> Data {
    Data.Text(f"{data_str(iv.data)}{if lower { " [a]" } else { " [b]" }}")
}

fn subtitles_job(rel: ref String, out: mut ref String) {
    let mut t = IntervalTree.new();
    for line in lines_of(read_text(rel)) {
        if line.starts_with("cut ") {
            let p = num(words(line)[1]);
            let mut hit: Vec[String] = Vec.new();
            for iv in sort_ivs(t.at(p)) {
                hit.push(text_of(iv.data));
            }
            let _ = t.slice(p, cue_part);
            emit(mut out, f"cut at {ts(p)} splits {if hit.len() == 0 { "nothing".to_string() } else { hit.join(", ") }}");
            continue;
        }
        let f = tabs(line);
        let _ = t.add(ivl(num(f[1]), num(f[2]), Data.Text(f"{f[0]} {f[3]}")));
    }
    if not t.verify() {
        emit(mut out, "verify FAILED");
    }
    emit(mut out, f"cues: {t.len()}, {ts(t.begin())} to {ts(t.end())}");
    let mut stacked = t.copy();
    let _ = stacked.split_overlaps();
    let _ = stacked.merge(Reducer.Join, true, true);
    let mut shown = 0;
    for iv in sort_ivs(stacked.all) {
        let d = text_of(iv.data);
        if d.contains("+") {
            shown += 1;
            if shown <= 12 {
                emit(mut out, f"  {ts(iv.begin)}-{ts(iv.end)} stacked: {d}");
            }
        }
    }
    emit(mut out, f"stacked stretches: {shown}");
    let mut single = t.copy();
    let _ = single.merge(Reducer.Count, false, true);
    let mut longest = 0;
    for iv in single.all {
        longest = max_i(longest, iv.length());
    }
    emit(mut out, f"on-screen blocks: {single.len()}, longest {longest}");
}
// ------------------------------------------------------------ the jobs

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data_files() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        if let Err(e) = fs.write(f"data/{file.path}", file.body.clone()) {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn read_text(rel: ref String) -> String {
    match fs.read_to_string(f"data/{rel}") {
        Ok(s) => s,
        Err(_) => "".to_string(),
    }
}

fn main() {
    if let Err(e) = write_data_files() {
        eprintln(e);
        return;
    }
    let mut out = String.new();
    for line in lines_of(read_text("jobs.tsv".to_string())) {
        let job: Vec[String] = line.split("\t").map(|p| p.to_string()).collect();
        emit(mut out, f"== {job.join(" ")}");
        if job[0] == "trace" {
            trace_job(job[1], mut out);
        } else if job[0] == "genome" {
            genome_job(job[1], job[2], job[3], mut out);
        } else if job[0] == "calendar" {
            calendar_job(job[1], mut out);
        } else if job[0] == "allowlist" {
            allowlist_job(job[1], mut out);
        } else {
            subtitles_job(job[1], mut out);
        }
    }
    print(out);
}
// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    data_part_3(mut v);
    data_part_4(mut v);
    data_part_5(mut v);
    data_part_6(mut v);
    v
}

