== sql queries.sql
query 1
  columns: *
  from: users
  names: 
query 2
  columns: id, name as who
  from: users u
  where: ((u.age >= 18) AND (NOT banned))
  order: name DESC
  limit: 10
  names: banned, id, name, u.age
query 3 (distinct)
  columns: country, count(*) as n
  from: users
  group: country
  order: n DESC, country ASC
  names: country, n
query 4
  columns: o.id, u.name
  from: orders o
  join: LEFT users u on (o.user_id = u.id)
  where: (((o.total * 2) > 100) OR (o.status IN ['open', 'held']))
  names: o.id, o.status, o.total, o.user_id, u.id, u.name
query 5
  columns: name
  from: users
  where: (email IS NULL)
  names: email, name
