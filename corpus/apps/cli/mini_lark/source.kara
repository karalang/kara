    t.push_str("parse keywords.lark kw.txt lexer=contextual\n");
    t.push_str("parse placeholders.lark ph.txt\n");
    t.push_str("parse placeholders.lark ph.txt maybe_placeholders=false\n");
    t.push_str("lex calc.lark calc.txt\n");
    t.push_str("complete json.lark {\"a\": [1, true, {\"b\": \n");
    t.push_str("complete sql.lark SELECT a FROM t WHERE\n");
    t.push_str("badgrammars\n");
    t.push_str("meta\n");
    t.push_str("summary\n");
    v.push(DataFile { path: "jobs.txt".to_string(), body: t });
    let mut t = String.new();
    t.push_str("// Basic terminals for common use\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("//\n");
    t.push_str("// Numbers\n");
    t.push_str("//\n");
    t.push_str("\n");
    t.push_str("DIGIT: \"0\"..\"9\"\n");
    t.push_str("HEXDIGIT: \"a\"..\"f\"|\"A\"..\"F\"|DIGIT\n");
    t.push_str("\n");
    t.push_str("INT: DIGIT+\n");
    t.push_str("SIGNED_INT: [\"+\"|\"-\"] INT\n");
    t.push_str("DECIMAL: INT \".\" INT? | \".\" INT\n");
    t.push_str("\n");
    t.push_str("// float = /-?\\d+(\\.\\d+)?([eE][+-]?\\d+)?/\n");
    t.push_str("_EXP: (\"e\"|\"E\") SIGNED_INT\n");
    t.push_str("FLOAT: INT _EXP | DECIMAL _EXP?\n");
    t.push_str("SIGNED_FLOAT: [\"+\"|\"-\"] FLOAT\n");
    t.push_str("\n");
    t.push_str("NUMBER: FLOAT | INT\n");
    t.push_str("SIGNED_NUMBER: [\"+\"|\"-\"] NUMBER\n");
    t.push_str("\n");
    t.push_str("//\n");
    t.push_str("// Strings\n");
    t.push_str("//\n");
    t.push_str("_STRING_INNER: /.*?/\n");
    t.push_str("_STRING_ESC_INNER: _STRING_INNER /(?<!\\\\)(\\\\\\\\)*?/\n");
    t.push_str("\n");
    t.push_str("ESCAPED_STRING : \"\\\"\" _STRING_ESC_INNER \"\\\"\"\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("//\n");
    t.push_str("// Names (Variables)\n");
    t.push_str("//\n");
    t.push_str("LCASE_LETTER: \"a\"..\"z\"\n");
    t.push_str("UCASE_LETTER: \"A\"..\"Z\"\n");
    t.push_str("\n");
    t.push_str("LETTER: UCASE_LETTER | LCASE_LETTER\n");
    t.push_str("WORD: LETTER+\n");
    t.push_str("\n");
    t.push_str("CNAME: (\"_\"|LETTER) (\"_\"|LETTER|DIGIT)*\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("//\n");
    t.push_str("// Whitespace\n");
    t.push_str("//\n");
    t.push_str("WS_INLINE: (\" \"|/\\t/)+\n");
    t.push_str("WS: /[ \\t\\f\\r\\n]/+\n");
    t.push_str("\n");
    t.push_str("CR : /\\r/\n");
    t.push_str("LF : /\\n/\n");
    t.push_str("NEWLINE: (CR? LF)+\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("// Comments\n");
    t.push_str("SH_COMMENT: /#[^\\n]*/\n");
    t.push_str("CPP_COMMENT: /\\/\\/[^\\n]*/\n");
    t.push_str("C_COMMENT: \"/*\" /(.|\\n)*?/ \"*/\"\n");
    t.push_str("SQL_COMMENT: /--[^\\n]*/\n");
    v.push(DataFile { path: "lark_grammars/common.lark".to_string(), body: t });
}

fn data_part_3(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("# Lark grammar of Lark's syntax\n");
    t.push_str("# Note: Lark is not bootstrapped, its parser is implemented in load_grammar.py\n");
    t.push_str("\n");
    t.push_str("start: (_item? _NL)* _item?\n");
    t.push_str("\n");
    t.push_str("_item: rule\n");
    t.push_str("     | token\n");
    t.push_str("     | statement\n");
    t.push_str("\n");
    t.push_str("rule: RULE rule_params priority? \":\" expansions\n");
    t.push_str("token: TOKEN token_params priority? \":\" expansions\n");
    t.push_str("\n");
    t.push_str("rule_params: [\"{\" RULE (\",\" RULE)* \"}\"]\n");
    t.push_str("token_params: [\"{\" TOKEN (\",\" TOKEN)* \"}\"]\n");
    t.push_str("\n");
    t.push_str("priority: \".\" NUMBER\n");
    t.push_str("\n");
    t.push_str("statement: \"%ignore\" expansions                    -> ignore\n");
    t.push_str("         | \"%import\" import_path [\"->\" name]       -> import\n");
    t.push_str("         | \"%import\" import_path name_list         -> multi_import\n");
    t.push_str("         | \"%override\" rule                        -> override_rule\n");
    t.push_str("         | \"%declare\" name+                        -> declare\n");
    t.push_str("\n");
    t.push_str("!import_path: \".\"? name (\".\" name)*\n");
    t.push_str("name_list: \"(\" name (\",\" name)* \")\"\n");
    t.push_str("\n");
    t.push_str("?expansions: alias (_VBAR alias)*\n");
    t.push_str("\n");
    t.push_str("?alias: expansion [\"->\" RULE]\n");
    t.push_str("\n");
    t.push_str("?expansion: expr*\n");
    t.push_str("\n");
    t.push_str("?expr: atom [OP | \"~\" NUMBER [\"..\" NUMBER]]\n");
    t.push_str("\n");
    t.push_str("?atom: \"(\" expansions \")\"\n");
    t.push_str("     | \"[\" expansions \"]\" -> maybe\n");
    t.push_str("     | value\n");
    t.push_str("\n");
    t.push_str("?value: STRING \"..\" STRING -> literal_range\n");
    t.push_str("      | name\n");
    t.push_str("      | (REGEXP | STRING) -> literal\n");
    t.push_str("      | name \"{\" value (\",\" value)* \"}\" -> template_usage\n");
    t.push_str("\n");
    t.push_str("name: RULE\n");
    t.push_str("    | TOKEN\n");
    t.push_str("\n");
    t.push_str("_VBAR: _NL? \"|\"\n");
    t.push_str("OP: /[+*]|[?](?![a-z])/\n");
    t.push_str("RULE: /!?[_?]?[a-z][_a-z0-9]*/\n");
    t.push_str("TOKEN: /_?[A-Z][_A-Z0-9]*/\n");
    t.push_str("STRING: _STRING \"i\"?\n");
    t.push_str("REGEXP: /\\/(?!\\/)(\\\\\\/|\\\\\\\\|[^\\/])*?\\/[imslux]*/\n");
    t.push_str("_NL: /(\\r?\\n)+\\s*/\n");
    t.push_str("\n");
    t.push_str("%import common.ESCAPED_STRING -> _STRING\n");
    t.push_str("%import common.SIGNED_INT -> NUMBER\n");
    t.push_str("%import common.WS_INLINE\n");
    t.push_str("\n");
    t.push_str("COMMENT: /\\s*/ \"//\" /[^\\n]/* | /\\s*/ \"#\" /[^\\n]/*\n");
    t.push_str("\n");
    t.push_str("%ignore WS_INLINE\n");
    t.push_str("%ignore COMMENT\n");
    v.push(DataFile { path: "lark_grammars/lark.lark".to_string(), body: t });
}

fn data_part_4(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("// Python 3 grammar for Lark\n");
    t.push_str("\n");
    t.push_str("// This grammar should parse all python 3.x code successfully.\n");
    t.push_str("\n");
    t.push_str("// Adapted from: https://docs.python.org/3/reference/grammar.html\n");
    t.push_str("\n");
    t.push_str("// Start symbols for the grammar:\n");
    t.push_str("//       single_input is a single interactive statement;\n");
    t.push_str("//       file_input is a module or sequence of commands read from an input file;\n");
    t.push_str("//       eval_input is the input for the eval() functions.\n");
    t.push_str("// NB: compound_stmt in single_input is followed by extra NEWLINE!\n");
    t.push_str("//\n");
    t.push_str("\n");
    t.push_str("single_input: _NEWLINE | simple_stmt | compound_stmt _NEWLINE\n");
    t.push_str("file_input: (_NEWLINE | stmt)*\n");
    t.push_str("eval_input: testlist _NEWLINE*\n");
    t.push_str("\n");
    t.push_str("decorator: \"@\" dotted_name [ \"(\" [arguments] \")\" ] _NEWLINE\n");
    t.push_str("decorators: decorator+\n");
    t.push_str("decorated: decorators (classdef | funcdef | async_funcdef)\n");
    t.push_str("\n");
    t.push_str("async_funcdef: \"async\" funcdef\n");
    t.push_str("funcdef: \"def\" name \"(\" [parameters] \")\" [\"->\" test] \":\" suite\n");
    t.push_str("\n");
    t.push_str("parameters: paramvalue (\",\" paramvalue)* [\",\" SLASH (\",\" paramvalue)*] [\",\" [starparams | kwparams]]\n");
    t.push_str("          | starparams\n");
    t.push_str("          | kwparams\n");
    t.push_str("\n");
    t.push_str("SLASH: \"/\" // Otherwise the it will completely disappear and it will be undisguisable in the result\n");
    t.push_str("starparams: (starparam | starguard) poststarparams\n");
    t.push_str("starparam: \"*\" typedparam\n");
    t.push_str("starguard: \"*\"\n");
    t.push_str("poststarparams: (\",\" paramvalue)* [\",\" kwparams]\n");
    t.push_str("kwparams: \"**\" typedparam \",\"?\n");
    t.push_str("\n");
    t.push_str("?paramvalue: typedparam (\"=\" test)?\n");
    t.push_str("?typedparam: name (\":\" test)?\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("lambdef: \"lambda\" [lambda_params] \":\" test\n");
    t.push_str("lambdef_nocond: \"lambda\" [lambda_params] \":\" test_nocond\n");
    t.push_str("lambda_params: lambda_paramvalue (\",\" lambda_paramvalue)* [\",\" [lambda_starparams | lambda_kwparams]]\n");
    t.push_str("          | lambda_starparams\n");
    t.push_str("          | lambda_kwparams\n");
    t.push_str("?lambda_paramvalue: name (\"=\" test)?\n");
    t.push_str("lambda_starparams: \"*\" [name]  (\",\" lambda_paramvalue)* [\",\" [lambda_kwparams]]\n");
    t.push_str("lambda_kwparams: \"**\" name \",\"?\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("?stmt: simple_stmt | compound_stmt\n");
    t.push_str("?simple_stmt: small_stmt (\";\" small_stmt)* [\";\"] _NEWLINE\n");
    t.push_str("?small_stmt: (expr_stmt | assign_stmt | del_stmt | pass_stmt | flow_stmt | import_stmt | global_stmt | nonlocal_stmt | assert_stmt)\n");
    t.push_str("expr_stmt: testlist_star_expr\n");
    t.push_str("assign_stmt: annassign | augassign | assign\n");
    t.push_str("\n");
    t.push_str("annassign: testlist_star_expr \":\" test [\"=\" test]\n");
    t.push_str("assign: testlist_star_expr (\"=\" (yield_expr|testlist_star_expr))+\n");
    t.push_str("augassign: testlist_star_expr augassign_op (yield_expr|testlist)\n");
    t.push_str("!augassign_op: \"+=\" | \"-=\" | \"*=\" | \"@=\" | \"/=\" | \"%=\" | \"&=\" | \"|=\" | \"^=\" | \"<<=\" | \">>=\" | \"**=\" | \"//=\"\n");
    t.push_str("?testlist_star_expr: test_or_star_expr\n");
    t.push_str("                   | test_or_star_expr (\",\" test_or_star_expr)+ \",\"?  -> tuple\n");
    t.push_str("                   | test_or_star_expr \",\"  -> tuple\n");
    t.push_str("\n");
    t.push_str("// For normal and annotated assignments, additional restrictions enforced by the interpreter\n");
    t.push_str("del_stmt: \"del\" exprlist\n");
    t.push_str("pass_stmt: \"pass\"\n");
    t.push_str("?flow_stmt: break_stmt | continue_stmt | return_stmt | raise_stmt | yield_stmt\n");
    t.push_str("break_stmt: \"break\"\n");
    t.push_str("continue_stmt: \"continue\"\n");
    t.push_str("return_stmt: \"return\" [testlist]\n");
    t.push_str("yield_stmt: yield_expr\n");
    t.push_str("raise_stmt: \"raise\" [test [\"from\" test]]\n");
    t.push_str("import_stmt: import_name | import_from\n");
    t.push_str("import_name: \"import\" dotted_as_names\n");
    t.push_str("// note below: the (\".\" | \"...\") is necessary because \"...\" is tokenized as ELLIPSIS\n");
    t.push_str("import_from: \"from\" (dots? dotted_name | dots) \"import\" (\"*\" | \"(\" import_as_names \")\" | import_as_names)\n");
    t.push_str("!dots: \".\"+\n");
    t.push_str("import_as_name: name [\"as\" name]\n");
    t.push_str("dotted_as_name: dotted_name [\"as\" name]\n");
    t.push_str("import_as_names: import_as_name (\",\" import_as_name)* [\",\"]\n");
    t.push_str("dotted_as_names: dotted_as_name (\",\" dotted_as_name)*\n");
    t.push_str("dotted_name: name (\".\" name)*\n");
    t.push_str("global_stmt: \"global\" name (\",\" name)*\n");
    t.push_str("nonlocal_stmt: \"nonlocal\" name (\",\" name)*\n");
    t.push_str("assert_stmt: \"assert\" test [\",\" test]\n");
    t.push_str("\n");
    t.push_str("?compound_stmt: if_stmt | while_stmt | for_stmt | try_stmt | match_stmt\n");
    t.push_str("              | with_stmt | funcdef | classdef | decorated | async_stmt\n");
    t.push_str("async_stmt: \"async\" (funcdef | with_stmt | for_stmt)\n");
    t.push_str("if_stmt: \"if\" test \":\" suite elifs [\"else\" \":\" suite]\n");
    t.push_str("elifs: elif_*\n");
    t.push_str("elif_: \"elif\" test \":\" suite\n");
    t.push_str("while_stmt: \"while\" test \":\" suite [\"else\" \":\" suite]\n");
    t.push_str("for_stmt: \"for\" exprlist \"in\" testlist \":\" suite [\"else\" \":\" suite]\n");
    t.push_str("try_stmt: \"try\" \":\" suite except_clauses [\"else\" \":\" suite] [finally]\n");
    t.push_str("        | \"try\" \":\" suite finally   -> try_finally\n");
    t.push_str("finally: \"finally\" \":\" suite\n");
    t.push_str("except_clauses: except_clause+\n");
    t.push_str("except_clause: \"except\" [test [\"as\" name]] \":\" suite\n");
    t.push_str("// NB compile.c makes sure that the default except clause is last\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("with_stmt: \"with\" with_items \":\" suite\n");
    t.push_str("with_items: with_item (\",\" with_item)*\n");
    t.push_str("with_item: test [\"as\" name]\n");
    t.push_str("\n");
    t.push_str("match_stmt: \"match\" test \":\" _NEWLINE _INDENT case+ _DEDENT\n");
    t.push_str("\n");
    t.push_str("case: \"case\" pattern [\"if\" test] \":\" suite\n");
    t.push_str("\n");
    t.push_str("?pattern: sequence_item_pattern \",\" _sequence_pattern -> sequence_pattern\n");
    t.push_str("        | as_pattern\n");
    t.push_str("?as_pattern: or_pattern (\"as\" NAME)?\n");
    t.push_str("?or_pattern: closed_pattern (\"|\" closed_pattern)*\n");
    t.push_str("?closed_pattern: literal_pattern\n");
    t.push_str("               | NAME -> capture_pattern\n");
    t.push_str("               | \"_\" -> any_pattern\n");
    t.push_str("               | attr_pattern\n");
    t.push_str("               | \"(\" as_pattern \")\"\n");
    t.push_str("               | \"[\" _sequence_pattern \"]\" -> sequence_pattern\n");
    t.push_str("               | \"(\" (sequence_item_pattern \",\" _sequence_pattern)? \")\" -> sequence_pattern\n");
    t.push_str("               | \"{\" (mapping_item_pattern (\",\" mapping_item_pattern)* \",\"?)?\"}\" -> mapping_pattern\n");
    t.push_str("               | \"{\" (mapping_item_pattern (\",\" mapping_item_pattern)* \",\")? \"**\" NAME \",\"? \"}\" -> mapping_star_pattern\n");
    t.push_str("               | class_pattern\n");
    t.push_str("\n");
    t.push_str("literal_pattern: inner_literal_pattern\n");
    t.push_str("\n");
    t.push_str("?inner_literal_pattern: \"None\" -> const_none\n");
    t.push_str("                      | \"True\" -> const_true\n");
    t.push_str("                      | \"False\" -> const_false\n");
    t.push_str("                      | STRING -> string\n");
    t.push_str("                      | number\n");
    t.push_str("\n");
    t.push_str("attr_pattern: NAME (\".\" NAME)+ -> value\n");
    t.push_str("\n");
    t.push_str("name_or_attr_pattern: NAME (\".\" NAME)* -> value\n");
    t.push_str("\n");
    t.push_str("mapping_item_pattern: (literal_pattern|attr_pattern) \":\" as_pattern\n");
    t.push_str("\n");
    t.push_str("_sequence_pattern: (sequence_item_pattern (\",\" sequence_item_pattern)* \",\"?)?\n");
    t.push_str("?sequence_item_pattern: as_pattern\n");
    t.push_str("                      | \"*\" NAME -> star_pattern\n");
    t.push_str("\n");
    t.push_str("class_pattern: name_or_attr_pattern \"(\" [arguments_pattern \",\"?] \")\"\n");
    t.push_str("arguments_pattern: pos_arg_pattern [\",\" keyws_arg_pattern]\n");
    t.push_str("                 | keyws_arg_pattern -> no_pos_arguments\n");
    t.push_str("\n");
    t.push_str("pos_arg_pattern: as_pattern (\",\" as_pattern)*\n");
    t.push_str("keyws_arg_pattern: keyw_arg_pattern (\",\" keyw_arg_pattern)*\n");
    t.push_str("keyw_arg_pattern: NAME \"=\" as_pattern\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("suite: simple_stmt | _NEWLINE _INDENT stmt+ _DEDENT\n");
    t.push_str("\n");
    t.push_str("?test: or_test (\"if\" or_test \"else\" test)?\n");
    t.push_str("     | lambdef\n");
    t.push_str("     | assign_expr\n");
    t.push_str("\n");
    t.push_str("assign_expr: name \":=\" test\n");
    t.push_str("\n");
    t.push_str("?test_nocond: or_test | lambdef_nocond\n");
    t.push_str("\n");
    t.push_str("?or_test: and_test (\"or\" and_test)*\n");
    t.push_str("?and_test: not_test_ (\"and\" not_test_)*\n");
    t.push_str("?not_test_: \"not\" not_test_ -> not_test\n");
    t.push_str("         | comparison\n");
    t.push_str("?comparison: expr (comp_op expr)*\n");
    t.push_str("star_expr: \"*\" expr\n");
    t.push_str("\n");
    t.push_str("?expr: or_expr\n");
    t.push_str("?or_expr: xor_expr (\"|\" xor_expr)*\n");
    t.push_str("?xor_expr: and_expr (\"^\" and_expr)*\n");
    t.push_str("?and_expr: shift_expr (\"&\" shift_expr)*\n");
    t.push_str("?shift_expr: arith_expr (_shift_op arith_expr)*\n");
    t.push_str("?arith_expr: term (_add_op term)*\n");
    t.push_str("?term: factor (_mul_op factor)*\n");
    t.push_str("?factor: _unary_op factor | power\n");
    t.push_str("\n");
    t.push_str("!_unary_op: \"+\"|\"-\"|\"~\"\n");
    t.push_str("!_add_op: \"+\"|\"-\"\n");
    t.push_str("!_shift_op: \"<<\"|\">>\"\n");
    t.push_str("!_mul_op: \"*\"|\"@\"|\"/\"|\"%\"|\"//\"\n");
    t.push_str("// <> isn't actually a valid comparison operator in Python. It's here for the\n");
    t.push_str("// sake of a __future__ import described in PEP 401 (which really works :-)\n");
    t.push_str("!comp_op: \"<\"|\">\"|\"==\"|\">=\"|\"<=\"|\"<>\"|\"!=\"|\"in\"|\"not\" \"in\"|\"is\"|\"is\" \"not\"\n");
    t.push_str("\n");
    t.push_str("?power: await_expr (\"**\" factor)?\n");
    t.push_str("?await_expr: AWAIT? atom_expr\n");
    t.push_str("AWAIT: \"await\"\n");
    t.push_str("\n");
    t.push_str("?atom_expr: atom_expr \"(\" [arguments] \")\"      -> funccall\n");
    t.push_str("          | atom_expr \"[\" subscriptlist \"]\"  -> getitem\n");
    t.push_str("          | atom_expr \".\" name               -> getattr\n");
    t.push_str("          | atom\n");
    t.push_str("\n");
    t.push_str("?atom: \"(\" yield_expr \")\"\n");
    t.push_str("     | \"(\" _tuple_inner? \")\" -> tuple\n");
    t.push_str("     | \"(\" comprehension{test_or_star_expr} \")\" -> tuple_comprehension\n");
    t.push_str("     | \"[\" _exprlist? \"]\"  -> list\n");
    t.push_str("     | \"[\" comprehension{test_or_star_expr} \"]\"  -> list_comprehension\n");
    t.push_str("     | \"{\" _dict_exprlist? \"}\" -> dict\n");
    t.push_str("     | \"{\" comprehension{key_value} \"}\" -> dict_comprehension\n");
    t.push_str("     | \"{\" _exprlist \"}\" -> set\n");
    t.push_str("     | \"{\" comprehension{test} \"}\" -> set_comprehension\n");
    t.push_str("     | name -> var\n");
    t.push_str("     | number\n");
    t.push_str("     | string_concat\n");
    t.push_str("     | \"(\" test \")\"\n");
    t.push_str("     | \"...\" -> ellipsis\n");
    t.push_str("     | \"None\"    -> const_none\n");
    t.push_str("     | \"True\"    -> const_true\n");
    t.push_str("     | \"False\"   -> const_false\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("?string_concat: string+\n");
    t.push_str("\n");
    t.push_str("_tuple_inner: test_or_star_expr ((\",\" test_or_star_expr)+ [\",\"] | \",\")\n");
    t.push_str("\n");
    t.push_str("?test_or_star_expr: test\n");
    t.push_str("                 | star_expr\n");
    t.push_str("\n");
    t.push_str("?subscriptlist: subscript\n");
    t.push_str("              | subscript ((\",\" subscript)+ [\",\"] | \",\") -> subscript_tuple\n");
    t.push_str("?subscript: test | ([test] \":\" [test] [sliceop]) -> slice\n");
    t.push_str("sliceop: \":\" [test]\n");
    t.push_str("?exprlist: (expr|star_expr)\n");
    t.push_str("         | (expr|star_expr) ((\",\" (expr|star_expr))+ [\",\"]|\",\")\n");
    t.push_str("?testlist: test | testlist_tuple\n");
    t.push_str("testlist_tuple: test ((\",\" test)+ [\",\"] | \",\")\n");
    t.push_str("_dict_exprlist: (key_value | \"**\" expr) (\",\" (key_value | \"**\" expr))* [\",\"]\n");
    t.push_str("\n");
    t.push_str("key_value: test \":\"  test\n");
    t.push_str("\n");
    t.push_str("_exprlist: test_or_star_expr (\",\"  test_or_star_expr)* [\",\"]\n");
    t.push_str("\n");
    t.push_str("classdef: \"class\" name [\"(\" [arguments] \")\"] \":\" suite\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("arguments: argvalue (\",\" argvalue)*  (\",\" [ starargs | kwargs])?\n");
    t.push_str("         | starargs\n");
    t.push_str("         | kwargs\n");
    t.push_str("         | comprehension{test}\n");
    t.push_str("\n");
    t.push_str("starargs: stararg (\",\" stararg)* (\",\" argvalue)* [\",\" kwargs]\n");
    t.push_str("stararg: \"*\" test\n");
    t.push_str("kwargs: \"**\" test (\",\" argvalue)*\n");
    t.push_str("\n");
    t.push_str("?argvalue: test (\"=\" test)?\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("comprehension{comp_result}: comp_result comp_fors [comp_if]\n");
    t.push_str("comp_fors: comp_for+\n");
    t.push_str("comp_for: [ASYNC] \"for\" exprlist \"in\" or_test\n");
    t.push_str("ASYNC: \"async\"\n");
    t.push_str("?comp_if: \"if\" test_nocond\n");
    t.push_str("\n");
    t.push_str("// not used in grammar, but may appear in \"node\" passed from Parser to Compiler\n");
    t.push_str("encoding_decl: name\n");
    t.push_str("\n");
    t.push_str("yield_expr: \"yield\" [testlist]\n");
    t.push_str("          | \"yield\" \"from\" test -> yield_from\n");
    t.push_str("\n");
    t.push_str("number: DEC_NUMBER | HEX_NUMBER | BIN_NUMBER | OCT_NUMBER | FLOAT_NUMBER | IMAG_NUMBER\n");
    t.push_str("string: STRING | LONG_STRING\n");
    t.push_str("\n");
    t.push_str("// Other terminals\n");
    t.push_str("\n");
    t.push_str("_NEWLINE: ( /\\r?\\n[\\t ]*/ | COMMENT )+\n");
    t.push_str("\n");
    t.push_str("%ignore /[\\t \\f]+/  // WS\n");
    t.push_str("%ignore /\\\\[\\t \\f]*\\r?\\n/   // LINE_CONT\n");
    t.push_str("%ignore COMMENT\n");
    t.push_str("%declare _INDENT _DEDENT\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("// Python terminals\n");
    t.push_str("\n");
    t.push_str("!name: NAME | \"match\" | \"case\"\n");
    t.push_str("NAME: /[^\\W\\d]\\w*/\n");
    t.push_str("COMMENT: /#[^\\n]*/\n");
    t.push_str("\n");
    t.push_str("STRING: /([ubf]?r?|r[ubf])(\"(?!\"\").*?(?<!\\\\)(\\\\\\\\)*?\"|'(?!'').*?(?<!\\\\)(\\\\\\\\)*?')/i\n");
    t.push_str("LONG_STRING: /([ubf]?r?|r[ubf])(\"\"\".*?(?<!\\\\)(\\\\\\\\)*?\"\"\"|'''.*?(?<!\\\\)(\\\\\\\\)*?''')/is\n");
    t.push_str("\n");
    t.push_str("_SPECIAL_DEC: \"0\"..\"9\"        (\"_\"?  \"0\"..\"9\"                       )*\n");
    t.push_str("DEC_NUMBER:   \"1\"..\"9\"        (\"_\"?  \"0\"..\"9\"                       )*\n");
    t.push_str("          |   \"0\"             (\"_\"?  \"0\"                            )* /(?![1-9])/\n");
    t.push_str("HEX_NUMBER.2: \"0\" (\"x\" | \"X\") (\"_\"? (\"0\"..\"9\" | \"a\"..\"f\" | \"A\"..\"F\"))+\n");
    t.push_str("OCT_NUMBER.2: \"0\" (\"o\" | \"O\") (\"_\"?  \"0\"..\"7\"                       )+\n");
    t.push_str("BIN_NUMBER.2: \"0\" (\"b\" | \"B\") (\"_\"?  \"0\"..\"1\"                       )+\n");
    t.push_str("\n");
    t.push_str("_EXP: (\"e\"|\"E\") [\"+\" | \"-\"] _SPECIAL_DEC\n");
    t.push_str("DECIMAL: \".\" _SPECIAL_DEC | _SPECIAL_DEC \".\" _SPECIAL_DEC?\n");
    t.push_str("FLOAT_NUMBER.2: _SPECIAL_DEC _EXP | DECIMAL _EXP?\n");
    t.push_str("IMAG_NUMBER.2: (_SPECIAL_DEC      | FLOAT_NUMBER) (\"J\" | \"j\")\n");
    t.push_str("\n");
    t.push_str("\n");
    t.push_str("// Comma-separated list (with an optional trailing comma)\n");
    t.push_str("cs_list{item}: item (\",\" item)* \",\"?\n");
    t.push_str("_cs_list{item}: item (\",\" item)* \",\"?\n");
    v.push(DataFile { path: "lark_grammars/python.lark".to_string(), body: t });
}

fn data_part_5(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("// TODO: LETTER, WORD, etc.\n");
    t.push_str("\n");
    t.push_str("//\n");
    t.push_str("// Whitespace\n");
    t.push_str("//\n");
    t.push_str("WS_INLINE: /[ \\t\\xa0]/+\n");
    t.push_str("WS: /[ \\t\\xa0\\f\\r\\n]/+\n");
    v.push(DataFile { path: "lark_grammars/unicode.lark".to_string(), body: t });
}
