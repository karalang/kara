        }
        976 => {
            out.push(946);
        }
        977 => {
            out.push(952);
        }
        981 => {
            out.push(966);
        }
        982 => {
            out.push(960);
        }
        1008 => {
            out.push(954);
        }
        1009 => {
            out.push(961);
        }
        1013 => {
            out.push(949);
        }
        1074 => {
            out.push(7296);
        }
        1076 => {
            out.push(7297);
        }
        1086 => {
            out.push(7298);
        }
        1089 => {
            out.push(7299);
        }
        1090 => {
            out.push(7300);
            out.push(7301);
        }
        1098 => {
            out.push(7302);
        }
        1123 => {
            out.push(7303);
        }
        7296 => {
            out.push(1074);
        }
        7297 => {
            out.push(1076);
        }
        7298 => {
            out.push(1086);
        }
        7299 => {
            out.push(1089);
        }
        7300 => {
            out.push(1090);
            out.push(7301);
        }
        7301 => {
            out.push(1090);
            out.push(7300);
        }
        7302 => {
            out.push(1098);
        }
        7303 => {
            out.push(1123);
        }
        7304 => {
            out.push(42571);
        }
        7777 => {
            out.push(7835);
        }
        7835 => {
            out.push(7777);
        }
        8126 => {
            out.push(837);
            out.push(953);
        }
        8147 => {
            out.push(912);
        }
        8163 => {
            out.push(944);
        }
        42571 => {
            out.push(7304);
        }
        64261 => {
            out.push(64262);
        }
        64262 => {
            out.push(64261);
        }
        _ => {}
    }
    out
}

// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = lower(c, ascii);
        if lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
        // and the set takes in the extra cases of each letter in it
        if not hit and not ascii {
            for x in extra_cases(lo).iter() {
                let xu = upper(*x, ascii);
                if in_items(set, *x, ascii) or (lower(xu, ascii) == *x and in_items(set, xu, ascii)) {
                    hit = true;
                }
            }
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program, s: ref Vec[i64]) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        s: s.clone(),
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn re_find(m: mut ref Matcher, prog: ref Program, from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= m.s.len() {
        let mut k = 0;
        while k < m.marks.len() {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}

// All the matches finditer gives: each search starts where the last
// match ended, and must move on past an empty one.
fn all_matches(prog: ref Program, s: ref Vec[i64], limit: i64) -> Vec[Found] {
    let mut m = new_matcher(prog, s);
    let mut out: Vec[Found] = Vec.new();
    let mut pos = 0;
    let mut must_advance = false;
    while pos <= s.len() and (limit == 0 or out.len() < limit) {
        match re_find(mut m, prog, pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    out
}

fn group_text(s: ref Vec[i64], span: (i64, i64), out: mut ref Vec[i64]) {
    let (a, b) = span;
    if a < 0 {
        push_ascii(mut out, "None");
    } else {
        str_repr(slice(s, a, b), mut out);
    }
}

fn span_text(span: (i64, i64)) -> String {
    let (a, b) = span;
    f"({a}, {b})"
}

// ------------------------------------------------- re.compile's cache

// Each pattern is compiled once and keeps one matcher; a search swaps
// the subject into that matcher and back, so no call copies the text.
struct Rx {
    progs: Vec[Program],
    ms: Vec[Matcher],
    keys: Map[String, i64],
}

fn new_rx() -> Rx {
    Rx { progs: Vec.new(), ms: Vec.new(), keys: Map.new() }
}

fn rx_id_v(rx: mut ref Rx, pat: ref Vec[i64], flags: i64) -> i64 {
    let key = f"{flags}:{to_string(pat)}";
    if let Some(id) = rx.keys.get(key) {
        return *id;
    }
    let prog = match re_compile(pat, flags) {
        Ok(p) => p,
        Err(e) => {
            eprintln(f"bad pattern {to_string(pat)}: {err_text(e)}");
            re_compile(u("(?!)"), 0).unwrap()
        }
    };
    let empty: Vec[i64] = Vec.new();
    let m = new_matcher(prog, empty);
    rx.progs.push(prog);
    rx.ms.push(m);
    let id = rx.progs.len() - 1;
    rx.keys.insert(key, id);
    id
}

fn rx_id(rx: mut ref Rx, pat: Str, flags: i64) -> i64 {
    rx_id_v(mut rx, u(pat), flags)
}

// pattern.search (mode 0), match (1) or fullmatch (2) at pos.
fn rx_run(rx: mut ref Rx, id: i64, s: mut ref Vec[i64], pos0: i64, mode: i64) -> Option[Found] {
    // sre clamps the position into the string
    let pos = if pos0 > s.len() { s.len() } else if pos0 < 0 { 0 } else { pos0 };
    mem.swap(mut rx.ms[id].s, mut s);
    let r = re_find(mut rx.ms[id], rx.progs[id], pos, false, mode);
    mem.swap(mut rx.ms[id].s, mut s);
    r
}

// The same with endpos: the subject ends there.
fn rx_run_end(rx: mut ref Rx, id: i64, s: ref Vec[i64], pos: i64, endpos: i64, mode: i64) -> Option[Found] {
    let mut t = sl(s, 0, endpos);
    rx_run(mut rx, id, mut t, pos, mode)
}

fn rx_search(rx: mut ref Rx, id: i64, s: mut ref Vec[i64], pos: i64) -> Option[Found] {
    rx_run(mut rx, id, mut s, pos, 0)
}

fn rx_match(rx: mut ref Rx, id: i64, s: mut ref Vec[i64], pos: i64) -> Option[Found] {
    rx_run(mut rx, id, mut s, pos, 1)
}

// finditer.
fn rx_all(rx: mut ref Rx, id: i64, s: mut ref Vec[i64]) -> Vec[Found] {
    let mut out: Vec[Found] = Vec.new();
    mem.swap(mut rx.ms[id].s, mut s);
    let mut pos = 0;
    let mut must_advance = false;
    let n = rx.ms[id].s.len();
    while pos <= n {
        match re_find(mut rx.ms[id], rx.progs[id], pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    mem.swap(mut rx.ms[id].s, mut s);
    out
}

fn group_index(rx: ref Rx, id: i64, name: Str) -> i64 {
    let n = u(name);
    for (k, g) in rx.progs[id].names.iter() {
        if same(k, n) {
            return g;
        }
    }
    -1
}

// m.group(g) for g >= 1, None when the group did not take part.
fn group_n(s: ref Vec[i64], f: ref Found, g: i64) -> Option[Vec[i64]] {
    let (a, b) = f.spans[g - 1];
    if a < 0 {
        return None;
    }
    Some(slice(s, a, b))
}

fn group_or_empty(s: ref Vec[i64], f: ref Found, g: i64) -> Vec[i64] {
    match group_n(s, f, g) {
        Some(t) => t,
        None => Vec.new(),
    }
}

fn group_named(rx: ref Rx, id: i64, s: ref Vec[i64], f: ref Found, name: Str) -> Option[Vec[i64]] {
    group_n(s, f, group_index(rx, id, name))
}

fn gs(rx: ref Rx, id: i64, s: ref Vec[i64], f: ref Found, name: Str) -> Vec[i64] {
    match group_named(rx, id, s, f, name) {
        Some(t) => t,
        None => Vec.new(),
    }
}

fn group0(s: ref Vec[i64], f: ref Found) -> Vec[i64] {
    slice(s, f.start, f.end)
}

// m.lastgroup.
fn last_group(rx: ref Rx, id: i64, f: ref Found) -> String {
    for (k, g) in rx.progs[id].names.iter() {
        if g == f.lastindex {
            return to_string(k);
        }
    }
    String.new()
}

// pattern.sub with a literal replacement.
fn rx_sub(rx: mut ref Rx, id: i64, s: ref Vec[i64], repl: Str) -> Vec[i64] {
    let mut t = s.clone();
    let found = rx_all(mut rx, id, mut t);
    let r = u(repl);
    let mut out: Vec[i64] = Vec.new();
    let mut pos = 0;
    for f in found.iter() {
        push_all(mut out, slice(t, pos, f.start));
        push_all(mut out, r);
        pos = f.end;
    }
    push_all(mut out, slice(t, pos, t.len()));
    out
}

// pattern.sub(r'\1' + suffix).
fn rx_sub_g1(rx: mut ref Rx, id: i64, s: ref Vec[i64], suffix: ref Vec[i64]) -> Vec[i64] {
    let mut t = s.clone();
    let found = rx_all(mut rx, id, mut t);
    let mut out: Vec[i64] = Vec.new();
    let mut pos = 0;
    for f in found.iter() {
        push_all(mut out, slice(t, pos, f.start));
        push_all(mut out, group_or_empty(t, f, 1));
        push_all(mut out, suffix);
        pos = f.end;
    }
    push_all(mut out, slice(t, pos, t.len()));
    out
}

// pattern.split, for a pattern without groups.
fn rx_split(rx: mut ref Rx, id: i64, s: ref Vec[i64]) -> Vec[Vec[i64]] {
    let mut t = s.clone();
    let found = rx_all(mut rx, id, mut t);
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut pos = 0;
    for f in found.iter() {
        out.push(slice(t, pos, f.start));
        pos = f.end;
    }
    out.push(slice(t, pos, t.len()));
    out
}
// ------------------------------------------------------------ Python str

// mistune's text is a Python str; here it is its code points, and these
// are the str methods mistune calls.

fn u(s: Str) -> Vec[i64] {
    codepoints(s.bytes())
}

fn us(s: ref String) -> Vec[i64] {
    codepoints(s.bytes())
}

fn cat(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut out = a.clone();
    push_all(mut out, b);
    out
}

fn cat3(a: ref Vec[i64], b: ref Vec[i64], c: ref Vec[i64]) -> Vec[i64] {
    let mut out = a.clone();
    push_all(mut out, b);
    push_all(mut out, c);
    out
}

fn ucat(a: Str, b: ref Vec[i64]) -> Vec[i64] {
    let mut out = u(a);
    push_all(mut out, b);
    out
}

fn catu(a: ref Vec[i64], b: Str) -> Vec[i64] {
    let mut out = a.clone();
    push_ascii(mut out, b);
    out
}

fn wrap(a: Str, b: ref Vec[i64], c: Str) -> Vec[i64] {
    let mut out = u(a);
    push_all(mut out, b);
    push_all(mut out, u(c));
    out
}

fn push_str(out: mut ref Vec[i64], s: Str) {
    push_all(mut out, u(s));
}

fn eq(a: ref Vec[i64], b: Str) -> bool {
    same(a, u(b))
}

// s[a:b] with Python's clamping.
fn sl(s: ref Vec[i64], a: i64, b: i64) -> Vec[i64] {
    let n = s.len();
    let mut lo = if a < 0 { a + n } else { a };
    let mut hi = if b < 0 { b + n } else { b };
    if lo < 0 {
        lo = 0;
    }
    if hi > n {
        hi = n;
    }
    if lo >= hi {
        return Vec.new();
    }
    slice(s, lo, hi)
}

fn tail(s: ref Vec[i64], a: i64) -> Vec[i64] {
    sl(s, a, s.len())
}

fn starts_at(s: ref Vec[i64], p: ref Vec[i64], at: i64) -> bool {
    if at < 0 or at + p.len() > s.len() {
        return false;
    }
    let mut i = 0;
    while i < p.len() {
        if s[at + i] != p[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn starts(s: ref Vec[i64], p: Str) -> bool {
    starts_at(s, u(p), 0)
}

fn starts_v(s: ref Vec[i64], p: ref Vec[i64]) -> bool {
    starts_at(s, p, 0)
}

fn ends(s: ref Vec[i64], p: Str) -> bool {
    let q = u(p);
    starts_at(s, q, s.len() - q.len())
}

fn find_v(s: ref Vec[i64], p: ref Vec[i64], from: i64) -> i64 {
    let mut i = if from < 0 { 0 } else { from };
    while i + p.len() <= s.len() {
        if starts_at(s, p, i) {
            return i;
        }
        i += 1;
    }
    -1
}

fn find(s: ref Vec[i64], p: Str, from: i64) -> i64 {
    find_v(s, u(p), from)
}

fn has_char(s: ref Vec[i64], c: i64) -> bool {
    for x in s {
        if x == c {
            return true;
        }
    }
    false
}

fn contains(s: ref Vec[i64], p: Str) -> bool {
    find(s, p, 0) >= 0
}

// str.replace(old, new, count), count -1 for all.
fn replace_v(s: ref Vec[i64], old: ref Vec[i64], new: ref Vec[i64], count: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    if old.len() == 0 {
        // Python puts `new` before every character and at the end.
        let mut n = 0;
        let mut i = 0;
        while i <= s.len() {
            if count < 0 or n < count {
                push_all(mut out, new);
                n += 1;
            }
            if i < s.len() {
                out.push(s[i]);
            }
            i += 1;
        }
        return out;
    }
    let mut i = 0;
    let mut n = 0;
    while i < s.len() {
        if (count < 0 or n < count) and starts_at(s, old, i) {
            push_all(mut out, new);
            i += old.len();
            n += 1;
        } else {
            out.push(s[i]);
            i += 1;
        }
    }
    out
}

fn replace(s: ref Vec[i64], old: Str, new: Str) -> Vec[i64] {
    replace_v(s, u(old), u(new), -1)
}

fn replace1(s: ref Vec[i64], old: Str, new: Str) -> Vec[i64] {
    replace_v(s, u(old), u(new), 1)
}

fn is_ws(c: i64) -> bool {
    is_space(c, false)
}

// str.strip() and friends; `chars` empty means whitespace.
fn in_chars(c: i64, chars: ref Vec[i64]) -> bool {
    if chars.len() == 0 { is_ws(c) } else { has_char(chars, c) }
}

fn strip_chars(s: ref Vec[i64], chars: ref Vec[i64], left: bool, right: bool) -> Vec[i64] {
    let mut a = 0;
    let mut b = s.len();
    if left {
        while a < b and in_chars(s[a], chars) {
            a += 1;
        }
    }
    if right {
        while b > a and in_chars(s[b - 1], chars) {
            b -= 1;
        }
    }
    slice(s, a, b)
}

fn strip(s: ref Vec[i64]) -> Vec[i64] {
    strip_chars(s, Vec.new(), true, true)
}

fn lstrip(s: ref Vec[i64]) -> Vec[i64] {
    strip_chars(s, Vec.new(), true, false)
}

fn rstrip(s: ref Vec[i64]) -> Vec[i64] {
    strip_chars(s, Vec.new(), false, true)
}

fn strip_of(s: ref Vec[i64], chars: Str) -> Vec[i64] {
    strip_chars(s, u(chars), true, true)
}

fn rstrip_of(s: ref Vec[i64], chars: Str) -> Vec[i64] {
    strip_chars(s, u(chars), false, true)
}

fn is_blank(s: ref Vec[i64]) -> bool {
    for c in s {
        if not is_ws(c) {
            return false;
        }
    }
    true
}

// str.split() with no separator.
fn split_ws(s: ref Vec[i64]) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut i = 0;
    while i < s.len() {
        while i < s.len() and is_ws(s[i]) {
            i += 1;
        }
        if i >= s.len() {
            break;
        }
        let a = i;
        while i < s.len() and not is_ws(s[i]) {
            i += 1;
        }
        out.push(slice(s, a, i));
    }
    out
}

// str.split(sep).
fn split_on(s: ref Vec[i64], sep: Str) -> Vec[Vec[i64]] {
    let p = u(sep);
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut a = 0;
    let mut i = 0;
    while i + p.len() <= s.len() {
        if starts_at(s, p, i) {
            out.push(slice(s, a, i));
            i += p.len();
            a = i;
        } else {
            i += 1;
        }
    }
    out.push(slice(s, a, s.len()));
    out
}

fn is_line_break(c: i64) -> bool {
    c == 10 or c == 13 or c == 11 or c == 12 or c == 0x1C or c == 0x1D or c == 0x1E or c == 0x85 or c == 0x2028 or c == 0x2029
}

// str.splitlines(), keepends or not.
fn split_lines(s: ref Vec[i64], keep: bool) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut a = 0;
    let mut i = 0;
    while i < s.len() {
        if is_line_break(s[i]) {
            let mut end = i + 1;
            if s[i] == 13 and i + 1 < s.len() and s[i + 1] == 10 {
                end = i + 2;
            }
            out.push(slice(s, a, if keep { end } else { i }));
            a = end;
            i = end;
        } else {
            i += 1;
        }
    }
    if a < s.len() {
        out.push(slice(s, a, s.len()));
    }
    out
}

fn join(parts: ref Vec[Vec[i64]], sep: Str) -> Vec[i64] {
    let p = u(sep);
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < parts.len() {
        if i > 0 {
            push_all(mut out, p);
        }
        push_all(mut out, parts[i]);
        i += 1;
    }
    out
}

fn spaces(n: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        out.push(32);
        i += 1;
    }
    out
}

fn repeat(c: i64, n: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        out.push(c);
        i += 1;
    }
    out
}

// str.lower() and str.upper(), with the full case mappings.
fn py_lower(s: ref Vec[i64]) -> Vec[i64] {
    us(to_string(s).to_lowercase())
}

fn py_upper(s: ref Vec[i64]) -> Vec[i64] {
    us(to_string(s).to_uppercase())
}

fn ascii_lower(s: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s {
        out.push(if c >= 65 and c <= 90 { c + 32 } else { c });
    }
    out
}

fn num_text(n: i64) -> Vec[i64] {
    u(f"{n}")
}

fn is_digit_text(s: ref Vec[i64]) -> bool {
    if s.len() == 0 {
        return false;
    }
    for c in s {
        if c < 48 or c > 57 {
            return false;
        }
    }
    true
}

// int() of a run of ASCII digits; -1 when it is not one.
fn int_of(s: ref Vec[i64]) -> i64 {
    let t = strip(s);
    if not is_digit_text(t) or t.len() > 18 {
        return -1;
    }
    let mut v = 0;
    for c in t {
        v = v * 10 + (c - 48);
    }
    v
}

// textwrap.indent(text, prefix): every line with something other than
// whitespace in it gets the prefix.
fn indent(text: ref Vec[i64], prefix: Str) -> Vec[i64] {
    let p = u(prefix);
    let mut out: Vec[i64] = Vec.new();
    for line in split_lines(text, true) {
        if not is_blank(line) {
            push_all(mut out, p);
        }
        push_all(mut out, line);
    }
    out
}
// ------------------------------------------------------------ values

// lark's Token: a str with its type and position. The text is code
// points; -1 stands for a position Python leaves as None.
#[derive(Clone)]
struct Token {
    ttype: String,
    value: Vec[i64],
    start: i64,
    line: i64,
    col: i64,
    end_line: i64,
    end_col: i64,
    end_pos: i64,
}

fn token(ttype: Str, value: own Vec[i64]) -> Token {
    Token { ttype: ttype.to_string(), value: value, start: -1, line: -1, col: -1, end_line: -1, end_col: -1, end_pos: -1 }
}

fn token_at(ttype: Str, value: own Vec[i64], start: i64, line: i64, col: i64) -> Token {
    Token { ttype: ttype.to_string(), value: value, start: start, line: line, col: col, end_line: -1, end_col: -1, end_pos: -1 }
}

// Token.new_borrow_pos
fn borrow_pos(ttype: Str, value: own Vec[i64], t: ref Token) -> Token {
    Token {
        ttype: ttype.to_string(),
        value: value,
        start: t.start,
        line: t.line,
        col: t.col,
        end_line: t.end_line,
        end_col: t.end_col,
        end_pos: t.end_pos,
    }
}

fn token_repr(t: ref Token) -> String {
    f"Token({repr_of(u(t.ttype))}, {repr_of(t.value)})"
}

// Python's str(None) for an unset position.
fn pos_text(n: i64) -> String {
    if n < 0 {
        return "None".to_string();
    }
    f"{n}"
}

// A grammar symbol: Terminal or NonTerminal. Two symbols are equal
// when both kind and name are (filter_out does not count).
#[derive(Clone)]
struct Sym {
    term: bool,
    name: String,
    filter_out: bool,
}

fn terminal(name: Str, filter_out: bool) -> Sym {
    Sym { term: true, name: name.to_string(), filter_out: filter_out }
}

fn nonterminal(name: Str) -> Sym {
    Sym { term: false, name: name.to_string(), filter_out: false }
}

fn sym_eq(a: ref Sym, b: ref Sym) -> bool {
    a.term == b.term and a.name == b.name
}

fn sym_repr(s: ref Sym) -> String {
    if s.term {
        return f"Terminal({repr_of(u(s.name))})";
    }
    f"NonTerminal({repr_of(u(s.name))})"
}

// Symbol('__empty__'), the placeholder [x] leaves for maybe_placeholders.
fn empty_sym() -> Sym {
    Sym { term: false, name: "__empty__".to_string(), filter_out: false }
}

fn is_empty_sym(s: ref Sym) -> bool {
    s.name == "__empty__"
}

// PatternStr (re false) or PatternRE (re true). flags holds the flag
// letters in sorted order; raw is the literal as written in the grammar.
#[derive(Clone)]
struct Pattern {
    re: bool,
    value: Vec[i64],
    flags: String,
    raw: Option[Vec[i64]],
}

fn pat_str(value: own Vec[i64], flags: Str) -> Pattern {
    Pattern { re: false, value: value, flags: sorted_flags(flags), raw: None }
}

fn pat_re(value: own Vec[i64], flags: Str) -> Pattern {
    Pattern { re: true, value: value, flags: sorted_flags(flags), raw: None }
}

fn sorted_flags(flags: Str) -> String {
    let mut cs: Vec[u8] = Vec.new();
    for b in flags.bytes() {
        let mut seen = false;
        for c in cs.iter() {
            if *c == b {
                seen = true;
            }
        }
        if not seen {
            cs.push(b);
        }
    }
    cs.sort();
    String.from_utf8(cs).unwrap()
}

fn pat_eq(a: ref Pattern, b: ref Pattern) -> bool {
    a.re == b.re and same(a.value, b.value) and a.flags == b.flags
}

// re.escape
fn re_escape(s: ref Vec[i64]) -> Vec[i64] {
    let special = u("()[]{}?*+-|^$\\.&~# \t\n\r\u{b}\u{c}");
    let mut out: Vec[i64] = Vec.new();
    for c in s {
        if has_char(special, c) {
            out.push(92);
        }
        out.push(c);
    }
    out
}

// Pattern.to_regexp: the flags wrap the pattern one group each.
fn pat_regexp(p: ref Pattern) -> Vec[i64] {
    let mut v = if p.re { p.value.clone() } else { re_escape(p.value) };
    for f in p.flags.bytes() {
        let mut w = u("(?");
        w.push(f as i64);
        w.push(58);
        push_all(mut w, v);
        w.push(41);
        v = w;
    }
    v
}

fn pat_repr(p: ref Pattern) -> String {
    repr_of(pat_regexp(p))
}

// (min_width, max_width): the length of a string, or sre's getwidth.
fn pat_width(cx: mut ref Ctx, p: ref Pattern) -> (i64, i64) {
    if not p.re {
        return (p.value.len(), p.value.len());
    }
    regexp_width(mut cx, pat_regexp(p))
}

fn regexp_width(cx: mut ref Ctx, r: ref Vec[i64]) -> (i64, i64) {
    let key = to_string(r);
    if let Some(w) = cx.widths.get(key) {
        return *w;
    }
    let w = match re_parse(r, 0) {
        Ok(parsed) => {
            let wd = width_of(parsed.widths, parsed.nodes);
            (wd.lo, wd.hi)
        }
        Err(_) => (0, 0),
    };
    cx.widths.insert(to_string(r), w);
    w
}

#[derive(Clone)]
struct TermDef {
    name: String,
    pattern: Pattern,
    priority: i64,
}

// TerminalDef.user_repr: a generated terminal shows as written.
fn user_repr(t: ref TermDef) -> String {
    if t.name.starts_with("__") {
        if let Some(raw) = ref t.pattern.raw {
            return to_string(raw);
        }
    }
    t.name.clone()
}

#[derive(Clone)]
struct RuleOptions {
    keep_all: bool,
    expand1: bool,
    priority: Option[i64],
    template_source: Option[String],
    empty_indices: Vec[bool],
}

fn rule_options() -> RuleOptions {
    RuleOptions { keep_all: false, expand1: false, priority: None, template_source: None, empty_indices: Vec.new() }
}

#[derive(Clone)]
struct Rule {
    origin: String,
    expansion: Vec[Sym],
    order: i64,
    alias: Option[String],
    options: RuleOptions,
}

fn rule_eq(a: ref Rule, b: ref Rule) -> bool {
    if a.origin != b.origin or a.expansion.len() != b.expansion.len() {
        return false;
    }
    let mut i = 0;
    while i < a.expansion.len() {
        if not sym_eq(a.expansion[i], b.expansion[i]) {
            return false;
        }
        i += 1;
    }
    true
}

// str(rule)
fn rule_text(r: ref Rule) -> String {
    let mut names: Vec[String] = Vec.new();
    for s in r.expansion.iter() {
        names.push(s.name.clone());
    }
    f"<{r.origin} : {names.join(" ")}>"
}

// --------------------------------------------------------------- trees

// What a tree child can be. Trees live in Ctx.trees and are named by
// index, so two places can hold the same tree, as Python objects can.
#[derive(Clone)]
enum N {
    Tr(i64),
    Tk(Token),
    Sy(Sym),
    Pa(Pattern),
    In(i64),
    Nil,
}

struct Tree {
    data: String,
    children: Vec[N],
}

fn new_tree(cx: mut ref Ctx, data: Str, children: own Vec[N]) -> i64 {
    cx.trees.push(Tree { data: data.to_string(), children: children });
    cx.trees.len() - 1
}

fn tree_id(n: ref N) -> i64 {
    match n {
        N.Tr(t) => t,
        _ => -1,
    }
}

fn is_tree(n: ref N, data: Str, cx: ref Ctx) -> bool {
    match n {
        N.Tr(t) => cx.trees[t].data == data,
        _ => false,
    }
}

// Tree.iter_subtrees: bottom-up, each tree once.
fn iter_subtrees(cx: ref Ctx, root: i64) -> Vec[i64] {
    let mut queue: Vec[i64] = Vec.new();
    queue.push(root);
    let mut seen: Map[i64, bool] = Map.new();
    let mut order: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < queue.len() {
        let t = queue[k];
        k += 1;
        if not seen.contains_key(t) {
            seen.insert(t, true);
            order.push(t);
        }
        let ch = ref cx.trees[t].children;
        let mut i = ch.len() - 1;
        while i >= 0 {
            if let N.Tr(c) = ref ch[i] {
                if not seen.contains_key(c) {
                    queue.push(c);
                }
            }
            i -= 1;
        }
    }
    order.reverse();
    order
}

fn find_data(cx: ref Ctx, root: i64, data: Str) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for t in iter_subtrees(cx, root) {
        if cx.trees[t].data == data {
            out.push(t);
        }
    }
    out
}

// Tree.expand_kids_by_data with one data value.
fn expand_kids(cx: mut ref Ctx, t: i64, data: Str) -> bool {
    let mut changed = false;
    let mut i = cx.trees[t].children.len() - 1;
    while i >= 0 {
        let c = tree_id(cx.trees[t].children[i]);
        if c >= 0 and cx.trees[c].data == data {
            let kids = cx.trees[c].children.clone();
            let mut new_children: Vec[N] = Vec.new();
            let mut j = 0;
            while j < cx.trees[t].children.len() {
                if j == i {
                    for k in kids.iter() {
                        new_children.push(k.clone());
                    }
                } else {
                    new_children.push(cx.trees[t].children[j].clone());
                }
                j += 1;
            }
            cx.trees[t].children = new_children;
            changed = true;
        }
        i -= 1;
    }
    changed
}

// Tree equality and hashing are structural.
fn n_eq(cx: ref Ctx, a: ref N, b: ref N) -> bool {
    match (a, b) {
        (N.Tr(x), N.Tr(y)) => {
            if x == y {
                return true;
            }
            let ta = ref cx.trees[x];
            let tb = ref cx.trees[y];
            if ta.data != tb.data or ta.children.len() != tb.children.len() {
                return false;
            }
            let mut i = 0;
            while i < ta.children.len() {
                if not n_eq(cx, ta.children[i], tb.children[i]) {
                    return false;
                }
                i += 1;
            }
            true
        }
        (N.Tk(x), N.Tk(y)) => x.ttype == y.ttype and same(x.value, y.value),
        (N.Sy(x), N.Sy(y)) => sym_eq(x, y),
        (N.Pa(x), N.Pa(y)) => pat_eq(x, y),
        (N.In(x), N.In(y)) => x == y,
        (N.Nil, N.Nil) => true,
        _ => false,
    }
}

// A copy with a new tree for every tree reached (nr_deepcopy_tree).
fn copy_n(cx: mut ref Ctx, n: ref N) -> N {
    match n {
        N.Tr(t) => {
            let data = cx.trees[t].data.clone();
            let kids = cx.trees[t].children.clone();
            let mut out: Vec[N] = Vec.new();
            for k in kids.iter() {
                out.push(copy_n(mut cx, k));
            }
            N.Tr(new_tree(mut cx, data, out))
        }
        _ => n.clone(),
    }
}

fn copy_tree(cx: mut ref Ctx, t: i64) -> i64 {
    tree_id(copy_n(mut cx, N.Tr(t)))
}

// Tree.pretty
fn pretty(cx: ref Ctx, t: i64) -> String {
    let mut out = String.new();
    pretty_into(cx, t, 0, mut out);
    out
}

fn n_text(n: ref N) -> String {
    match n {
        N.Tk(t) => to_string(t.value),
        N.Nil => "None".to_string(),
        N.Sy(s) => s.name.clone(),
        N.In(i) => f"{i}",
        _ => "?".to_string(),
    }
}

fn pretty_into(cx: ref Ctx, t: i64, level: i64, out: mut ref String) {
    let tr = ref cx.trees[t];
    let mut k = 0;
    while k < level {
        out.push_str("  ");
        k += 1;
    }
    out.push_str(tr.data);
    if tr.children.len() == 1 and tree_id(tr.children[0]) < 0 {
        out.push_str("\t");
        out.push_str(n_text(tr.children[0]));
        out.push_str("\n");
        return;
    }
    out.push_str("\n");
    for c in tr.children.iter() {
        match c {
            N.Tr(s) => pretty_into(cx, s, level + 1, mut out),
            _ => {
                let mut j = 0;
                while j < level + 1 {
                    out.push_str("  ");
                    j += 1;
                }
                out.push_str(n_text(c));
                out.push_str("\n");
            }
        }
    }
}

// Tree.scan_values for tokens.
fn scan_tokens(cx: ref Ctx, t: i64, out: mut ref Vec[Token]) {
    for c in cx.trees[t].children.iter() {
        match c {
            N.Tr(s) => scan_tokens(cx, s, mut out),
            N.Tk(k) => out.push(k.clone()),
            _ => {}
        }
    }
}

// The names of the symbols under every expansion (_find_used_symbols),
// in tree order.
fn used_symbols(cx: ref Ctx, t: i64) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for e in find_data(cx, t, "expansion") {
        scan_sym_names(cx, e, mut out);
    }
    out
}

fn scan_sym_names(cx: ref Ctx, t: i64, out: mut ref Vec[String]) {
    for c in cx.trees[t].children.iter() {
        match c {
            N.Tr(s) => scan_sym_names(cx, s, mut out),
            N.Sy(s) => {
                if not has_str(out, s.name) {
                    out.push(s.name.clone());
                }
            }
            _ => {}
        }
    }
}

fn has_str(v: ref Vec[String], s: ref String) -> bool {
    for x in v.iter() {
        if x == s {
            return true;
        }
    }
    false
}

// ------------------------------------------------------------- errors

// lark's exceptions. kind: "GrammarError", "UnexpectedCharacters",
// "UnexpectedToken", "LexError", "DedentError" or "ConfigurationError".
#[derive(Clone)]
struct LErr {
    kind: String,
    msg: String,
    token: Token,
    // UnexpectedToken.expected / UnexpectedCharacters.allowed
    expected: Vec[String],
    // the interactive parser's accepts(), when it had one
    accepts: Vec[String],
    has_accepts: bool,
    // the parser state, compared by stack length and top state
    has_state: bool,
    st_len: i64,
    st_pos: i64,
    // UnexpectedCharacters
    pos: i64,
    line: i64,
    col: i64,
    ch: i64,
    history: Vec[Token],
    // which Lark raised it, for user_repr of the expected names
    lark: i64,
}

fn err(kind: Str, msg: own String) -> LErr {
    LErr {
        kind: kind.to_string(),
        msg: msg,
        token: token("", Vec.new()),
        expected: Vec.new(),
        accepts: Vec.new(),
        has_accepts: false,
        has_state: false,
        st_len: 0,
        st_pos: 0,
        pos: -1,
        line: -1,
        col: -1,
        ch: 0,
        history: Vec.new(),
        lark: -1,
    }
}

fn grammar_error(msg: own String) -> LErr {
    err("GrammarError", msg)
}

fn is_input_error(e: ref LErr) -> bool {
    e.kind == "UnexpectedToken" or e.kind == "UnexpectedCharacters"
}

// UnexpectedInput.get_context(text, span=40)
fn get_context(text: ref Vec[i64], pos: i64) -> Vec[i64] {
    let start = if pos - 40 > 0 { pos - 40 } else { 0 };
    let end = if pos + 40 < text.len() { pos + 40 } else { text.len() };
    let p = if pos < text.len() { pos } else { text.len() };
    let mut before = sl(text, start, p);
    let mut i = before.len() - 1;
    while i >= 0 {
        if before[i] == 10 {
            before = tail(before, i + 1);
            break;
        }
        i -= 1;
    }
    let mut after = sl(text, p, end);
    let nl = find(after, "\n", 0);
    if nl >= 0 {
        after = sl(after, 0, nl);
    }
    let mut out = before.clone();
    push_all(mut out, after);
    out.push(10);
    // ' ' * len(before.expandtabs())
    let mut col = 0;
    for c in before.iter() {
        if *c == 9 {
            col = (col / 8 + 1) * 8;
        } else {
            col += 1;
        }
    }
    let mut k = 0;
    while k < col {
        out.push(32);
        k += 1;
    }
    push_ascii(mut out, "^\n");
    out
}

// --------------------------------------------------------------- sorts

// A stable insertion sort of indices by a key of three integers and a
// name: what Python's sort does with these keys.
fn sort_keys(keys: ref Vec[(i64, i64, i64, String)]) -> Vec[i64] {
    let mut idx: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < keys.len() {
        idx.push(i);
        i += 1;
    }
    let mut a = 1;
    while a < idx.len() {
        let cur = idx[a];
        let mut b = a - 1;
        while b >= 0 and key_less(keys[cur], keys[idx[b]]) {
            idx[b + 1] = idx[b];
            b -= 1;
        }
        idx[b + 1] = cur;
        a += 1;
    }
    idx
}

fn key_less(x: ref (i64, i64, i64, String), y: ref (i64, i64, i64, String)) -> bool {
    if x.0 != y.0 {
        return x.0 < y.0;
    }
    if x.1 != y.1 {
        return x.1 < y.1;
    }
    if x.2 != y.2 {
        return x.2 < y.2;
    }
    x.3 < y.3
}

fn sorted_strs(v: ref Vec[String]) -> Vec[String] {
    let mut out = v.clone();
    out.sort();
    out
}

// str.isupper for an ASCII name.
fn is_upper(s: ref String) -> bool {
    let mut cased = false;
    for b in s.bytes() {
        if b >= 97 and b <= 122 {
            return false;
        }
        if b >= 65 and b <= 90 {
            cased = true;
        }
    }
    cased
}
// ------------------------------------------------------ GrammarBuilder

// One definition: a rule or a terminal. tree is -1 for one made by
// %declare. A rule's options are a RuleOptions; a terminal's are its
// priority.
#[derive(Clone)]
struct Definition {
    is_term: bool,
    tree: i64,
    params: Vec[String],
    options: RuleOptions,
    priority: i64,
}

// _get_mangle: each layer is a prefix with the aliases imported under
// it; a name goes through the innermost layer first.
#[derive(Clone)]
struct Layer {
    prefix: String,
    aliases: Vec[(String, String)],
}

fn mangle(layers: ref Vec[Layer], name: ref String) -> String {
    let mut s = name.clone();
    for l in layers.iter() {
        let mut found = false;
        for (k, v) in l.aliases.iter() {
            if *k == s {
                s = v.clone();
                found = true;
                break;
            }
        }
        if not found {
            if s.starts_with("_") {
                let rest = s.substring(1, s.len());
                s = f"_{l.prefix}__{rest}";
            } else {
                s = f"{l.prefix}__{s}";
            }
        }
    }
    s
}

struct Builder {
    defs: Vec[(String, Definition)],
    ignore_names: Vec[String],
    import_paths: Vec[String],
}

fn new_builder(import_paths: ref Vec[String]) -> Builder {
    Builder { defs: Vec.new(), ignore_names: Vec.new(), import_paths: import_paths.clone() }
}

fn def_index(b: ref Builder, name: ref String) -> i64 {
    let mut i = 0;
    while i < b.defs.len() {
        if b.defs[i].0 == *name {
            return i;
        }
        i += 1;
    }
    -1
}

fn kind_word(is_term: bool) -> String {
    if is_term { "terminal".to_string() } else { "rule".to_string() }
}

fn kind_title(is_term: bool) -> String {
    if is_term { "Terminal".to_string() } else { "Rule".to_string() }
}

// The text of a grammar file's token, as a String.
fn tok_name(n: ref N) -> String {
    match n {
        N.Tk(t) => to_string(t.value),
        N.Sy(s) => s.name.clone(),
        _ => String.new(),
    }
}

// PrepareGrammar: terminal and nonterminal trees become symbols.
fn prepare_grammar(cx: mut ref Ctx, n: ref N) -> N {
    match n {
        N.Tr(t) => {
            let data = cx.trees[t].data.clone();
            let kids = cx.trees[t].children.clone();
            if data == "terminal" {
                let name = tok_name(kids[0]);
                let f = name.starts_with("_");
                return N.Sy(terminal(name, f));
            }
            if data == "nonterminal" {
                return N.Sy(nonterminal(tok_name(kids[0])));
            }
            let mut out: Vec[N] = Vec.new();
            for k in kids.iter() {
                out.push(prepare_grammar(mut cx, k));
            }
            cx.trees[t].children = out;
            n.clone()
        }
        _ => n.clone(),
    }
}

// _parse_grammar: the grammar's own text through lark's grammar parser.
fn parse_grammar(cx: mut ref Ctx, text: ref Vec[i64], name: ref String) -> Result[i64, LErr] {
    let meta = meta_parser(mut cx)?;
    let mut input = text.clone();
    input.push(10);
    match run_parse(mut cx, meta, input, false) {
        Ok(res) => {
            let t = prepare_grammar(mut cx, res.value);
            Ok(tree_id(t))
        }
        Err(e) => {
            if e.kind == "UnexpectedCharacters" {
                let ctx = to_string(get_context(text, e.pos));
                return Err(grammar_error(f"Unexpected input at line {e.line} column {e.col} in {name}: \n\n{ctx}"));
            }
            if e.kind == "UnexpectedToken" {
                let ctx = to_string(get_context(text, e.token.start));
                let label = translate_grammar_error(mut cx, meta, e);
                if label.len() > 0 {
                    return Err(grammar_error(f"{label}, at line {pos_text(e.token.line)} column {pos_text(e.token.col)}\n\n{ctx}"));
                }
            }
            Err(e)
        }
    }
}

// _translate_parser_exception
fn translate_grammar_error(cx: mut ref Ctx, meta: i64, e: ref LErr) -> String {
    let examples = grammar_error_examples();
    if let Some(label) = match_examples(mut cx, meta, e, examples, true) {
        return label;
    }
    if has_str(e.expected, "STRING".to_string()) {
        return "Expecting a value".to_string();
    }
    String.new()
}

fn load_grammar(cx: mut ref Ctx, b: mut ref Builder, text: ref Vec[i64], name: ref String, layers: ref Option[Vec[Layer]]) -> Result[(), LErr] {
    let root = parse_grammar(mut cx, text, name)?;
    let stmts = cx.trees[root].children.clone();
    // the imports, in order, merged by path
    let mut imports: Vec[(Vec[String], String, Vec[(String, String)])] = Vec.new();
    for st in stmts.iter() {
        let t = tree_id(st);
        if cx.trees[t].data != "import" {
            continue;
        }
        let (path, base, aliases) = unpack_import(cx, t, name)?;
        let mut merged = false;
        for imp in imports.iter_mut() {
            if same_path(imp.0, path) {
                for (k, v) in aliases.iter() {
                    put_alias(mut imp.2, k, v);
                }
                merged = true;
            }
        }
        if not merged {
            imports.push((path, base, aliases));
        }
    }
    for imp in imports.iter() {
        do_import(mut cx, mut b, imp.0, imp.1, imp.2, layers)?;
    }
    for st in stmts.iter() {
        let t = tree_id(st);
        let data = cx.trees[t].data.clone();
        if data == "term" or data == "rule" {
            let d = unpack_definition(mut cx, t, layers)?;
            define(mut b, d, false)?;
        } else if data == "override" {
            let r = tree_id(cx.trees[t].children[0]);
            let d = unpack_definition(mut cx, r, layers)?;
            define(mut b, d, true)?;
        } else if data == "extend" {
            let r = tree_id(cx.trees[t].children[0]);
            let d = unpack_definition(mut cx, r, layers)?;
            extend(mut cx, mut b, d)?;
        } else if data == "ignore" {
            if layers.is_none() {
                let e = tree_id(cx.trees[t].children[0]);
                ignore(mut cx, mut b, e);
            }
        } else if data == "declare" {
            let syms = cx.trees[t].children.clone();
            for s in syms.iter() {
                if let N.Sy(sym) = s {
                    let nm = match layers {
                        Some(ls) => mangle(ls, sym.name),
                        None => sym.name.clone(),
                    };
                    let d = Definition { is_term: sym.term, tree: -1, params: Vec.new(), options: rule_options(), priority: 1 };
                    define(mut b, (nm, d), false)?;
                }
            }
        }
    }
    // resolve_term_references
    let mut terms: Vec[(String, i64)] = Vec.new();
    for (n, d) in b.defs.iter() {
        if d.is_term {
            terms.push((n.clone(), d.tree));
        }
    }
    resolve_term_references(mut cx, terms)
}

fn same_path(a: ref Vec[String], b: ref Vec[String]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn put_alias(aliases: mut ref Vec[(String, String)], k: ref String, v: ref String) {
    for a in aliases.iter_mut() {
        if a.0 == *k {
            a.1 = v.clone();
            return;
        }
    }
    aliases.push((k.clone(), v.clone()));
}

// _unpack_import: (dotted path, base path, aliases)
fn unpack_import(cx: ref Ctx, stmt: i64, grammar_name: ref String) -> Result[(Vec[String], String, Vec[(String, String)]), LErr] {
    let kids = ref cx.trees[stmt].children;
    let path_node = tree_id(kids[0]);
    let mut path: Vec[String] = Vec.new();
    for c in cx.trees[path_node].children.iter() {
        path.push(tok_name(c));
    }
    let mut aliases: Vec[(String, String)] = Vec.new();
    let mut dotted: Vec[String] = Vec.new();
    let multi = kids.len() > 1 and tree_id(kids[1]) >= 0;
    if multi {
        dotted = path.clone();
        for c in cx.trees[tree_id(kids[1])].children.iter() {
            let nm = tok_name(c);
            put_alias(mut aliases, nm, nm);
        }
    } else {
        let mut i = 0;
        while i + 1 < path.len() {
            dotted.push(path[i].clone());
            i += 1;
        }
        if dotted.len() == 0 {
            return Err(grammar_error(f"Nothing was imported from grammar `{path[0]}`"));
        }
        let nm = path[path.len() - 1].clone();
        let target = if kids.len() > 1 { tok_name(kids[1]) } else { nm.clone() };
        aliases.push((nm, target));
    }
    let mut base = String.new();
    if cx.trees[path_node].data == "import_rel" {
        if *grammar_name == "<string>" {
            base = ".".to_string();
        } else {
            base = dir_of(grammar_name);
        }
    }
    Ok((dotted, base, aliases))
}

fn dir_of(path: ref String) -> String {
    let b = path.bytes();
    let mut i = b.len() - 1;
    while i >= 0 {
        if b[i] == 47 {
            return path.substring(0, i);
        }
        i -= 1;
    }
    String.new()
}

// _unpack_definition and _make_rule_tuple: (name, definition)
fn unpack_definition(cx: mut ref Ctx, t: i64, layers: ref Option[Vec[Layer]]) -> Result[(String, Definition), LErr] {
    let kids = cx.trees[t].children.clone();
    let mut d = Definition { is_term: false, tree: -1, params: Vec.new(), options: rule_options(), priority: 0 };
    let mut name = String.new();
    if cx.trees[t].data == "rule" {
        name = tok_name(kids[1]);
        let mods = ref cx.trees[tree_id(kids[0])].children;
        if mods.len() > 0 {
            let m = tok_name(mods[0]);
            let expand1 = m.contains("?");
            if expand1 and name.starts_with("_") {
                return Err(grammar_error("Inlined rules (_rule) cannot use the ?rule modifier.".to_string()));
            }
            d.options.expand1 = expand1;
            d.options.keep_all = m.contains("!");
        }
        let prio = ref cx.trees[tree_id(kids[3])].children;
        if prio.len() > 0 {
            d.options.priority = Some(int_of(u(tok_name(prio[0]))));
        }
        for p in cx.trees[tree_id(kids[2])].children.iter() {
            d.params.push(tok_name(p));
        }
        if d.params.len() > 0 {
            d.options.template_source = Some(name.clone());
        }
        d.tree = tree_id(kids[4]);
    } else {
        d.is_term = true;
        name = tok_name(kids[0]);
        if kids.len() == 3 {
            d.priority = int_of(u(tok_name(kids[1])));
        }
        d.tree = tree_id(kids[kids.len() - 1]);
    }
    if let Some(ls) = layers {
        let mut ps: Vec[String] = Vec.new();
        for p in d.params.iter() {
            ps.push(mangle(ls, p));
        }
        d.params = ps;
        name = mangle(ls, name);
        let c = copy_tree(mut cx, d.tree);
        rename_symbols(mut cx, c, ls);
        d.tree = c;
    }
    Ok((name, d))
}

fn rename_symbols(cx: mut ref Ctx, t: i64, ls: ref Vec[Layer]) {
    for st in iter_subtrees(cx, t) {
        let mut kids = cx.trees[st].children.clone();
        for k in kids.iter_mut() {
            if let N.Sy(s) = k {
                s.name = mangle(ls, s.name);
            }
        }
        cx.trees[st].children = kids;
    }
}

fn define(b: mut ref Builder, nd: own (String, Definition), override_: bool) -> Result[(), LErr] {
    let (name, d) = nd;
    let i = def_index(b, name);
    if i >= 0 {
        if not override_ {
            return Err(grammar_error(f"{kind_title(d.is_term)} '{name}' defined more than once"));
        }
    } else if override_ {
        return Err(grammar_error(f"Cannot override a nonexisting {kind_word(d.is_term)} {name}"));
    }
    if name.starts_with("__") {
        return Err(grammar_error(f"Names starting with double-underscore are reserved (Error at {name})"));
    }
    if i >= 0 {
        b.defs[i].1 = d;
    } else {
        b.defs.push((name, d));
    }
    Ok(())
}

fn extend(cx: mut ref Ctx, b: mut ref Builder, nd: own (String, Definition)) -> Result[(), LErr] {
    let (name, d) = nd;
    let i = def_index(b, name);
    if i < 0 {
        return Err(grammar_error(f"Can't extend {kind_word(d.is_term)} {name} as it wasn't defined before"));
    }
    let base = b.defs[i].1.clone();
    if d.is_term != base.is_term {
        return Err(grammar_error(f"Cannot extend {kind_word(d.is_term)} {name} - one is a terminal, while the other is not."));
    }
    if not same_path(d.params, base.params) {
        return Err(grammar_error(f"Cannot extend {kind_word(d.is_term)} with different parameters: {name}"));
    }
    if base.tree < 0 {
        return Err(grammar_error(f"Can't extend {kind_word(d.is_term)} {name} - it is abstract."));
    }
    cx.trees[base.tree].children.insert(0, N.Tr(d.tree));
    Ok(())
}

fn ignore(cx: mut ref Ctx, b: mut ref Builder, t: i64) {
    let kids = ref cx.trees[t].children;
    if cx.trees[t].data == "expansions" and kids.len() == 1 {
        let t2 = tree_id(kids[0]);
        if t2 >= 0 and cx.trees[t2].data == "expansion" and cx.trees[t2].children.len() == 1 {
            let item = tree_id(cx.trees[t2].children[0]);
            if item >= 0 and cx.trees[item].data == "value" {
                if let N.Sy(s) = ref cx.trees[item].children[0] {
                    if s.term {
                        b.ignore_names.push(s.name.clone());
                        return;
                    }
                }
            }
        }
    }
    let name = f"__IGNORE_{b.ignore_names.len()}";
    b.ignore_names.push(name.clone());
    b.defs.push((name, Definition { is_term: true, tree: t, params: Vec.new(), options: rule_options(), priority: 0 }));
}

fn resolve_term_references(cx: mut ref Ctx, terms: ref Vec[(String, i64)]) -> Result[(), LErr] {
    loop {
        let mut changed = false;
        for (name, tree) in terms.iter() {
            if tree < 0 {
                continue;
            }
            for exp in find_data(cx, tree, "value") {
                let item = cx.trees[exp].children[0].clone();
                if let N.Sy(s) = item {
                    if not s.term {
                        return Err(grammar_error(f"Rules aren't allowed inside terminals ({sym_repr(s)} in {name})"));
                    }
                    let mut target = -2;
                    for (n2, t2) in terms.iter() {
                        if *n2 == s.name {
                            target = t2;
                        }
                    }
                    if target == -2 {
                        return Err(grammar_error(f"Terminal used but not defined: {s.name}"));
                    }
                    cx.trees[exp].children[0] = N.Tr(target);
                    changed = true;
                }
            }
        }
        if not changed {
            break;
        }
    }
    for (name, tree) in terms.iter() {
        if tree < 0 {
            continue;
        }
        for c in cx.trees[tree].children.iter() {
            if let N.Tr(ct) = c {
                for s in iter_subtrees(cx, ct) {
                    if s == tree {
                        return Err(grammar_error(f"Recursion in terminal '{name}' (recursion is only allowed in rules, not terminals)"));
                    }
                }
            }
        }
    }
    Ok(())
}

fn read_file(path: ref String) -> Option[Vec[i64]] {
    match fs.read_to_string(path.clone()) {
        Ok(s) => Some(us(s)),
        Err(_) => None,
    }
}

fn do_import(cx: mut ref Ctx, b: mut ref Builder, dotted: ref Vec[String], base: ref String, aliases: ref Vec[(String, String)], base_layers: ref Option[Vec[Layer]]) -> Result[(), LErr] {
    let mut layers: Vec[Layer] = Vec.new();
    layers.push(Layer { prefix: dotted.join("__"), aliases: aliases.clone() });
    if let Some(ls) = base_layers {
        for l in ls.iter() {
            layers.push(l.clone());
        }
    }
    let grammar_path = f"{dotted.join("/")}.lark";
    let mut to_try = b.import_paths.clone();
    if base.len() > 0 {
        to_try.push(base.clone());
    }
    to_try.push(stdlib_dir());
    for src in to_try.iter() {
        let joined = f"{src}/{grammar_path}";
        let text = match read_file(joined) {
            Some(t) => t,
            None => continue,
        };
        let mut gb = new_builder(b.import_paths);
        let some_layers = Some(layers.clone());
        load_grammar(mut cx, mut gb, text, joined, some_layers)?;
        let mut used: Vec[String] = Vec.new();
        for (k, _) in aliases.iter() {
            used.push(mangle(layers, k));
        }
        remove_unused(cx, mut gb, used);
        for (n, _) in gb.defs.iter() {
            if def_index(b, n) >= 0 {
                return Err(grammar_error(f"Cannot import '{n}' from '{grammar_path}': Symbol already defined."));
            }
        }
        for d in gb.defs.iter() {
            b.defs.push(d.clone());
        }
        return Ok(());
    }
    Err(err("FileNotFoundError", f"[Errno 2] No such file or directory: '{grammar_path}'"))
}

fn remove_unused(cx: ref Ctx, b: mut ref Builder, used: own Vec[String]) {
    let mut queue = used;
    let mut k = 0;
    while k < queue.len() {
        let sym = queue[k].clone();
        k += 1;
        let i = def_index(b, sym);
        if i < 0 {
            continue;
        }
        let d = ref b.defs[i].1;
        if d.is_term or d.tree < 0 {
            continue;
        }
        for s in used_symbols(cx, d.tree) {
            if not has_str(d.params, s) and not has_str(queue, s) {
                queue.push(s.clone());
            }
        }
    }
    let mut kept: Vec[(String, Definition)] = Vec.new();
    for d in b.defs.iter() {
        if has_str(queue, d.0) {
            kept.push(d.clone());
        }
    }
    b.defs = kept;
}

fn validate(cx: ref Ctx, b: ref Builder) -> Result[(), LErr] {
    for (name, d) in b.defs.iter() {
        let mut i = 0;
        while i < d.params.len() {
            let p = ref d.params[i];
            if def_index(b, p) >= 0 {
                return Err(grammar_error(f"Template Parameter conflicts with rule {p} (in template {name})"));
            }
            let mut j = 0;
            while j < i {
                if d.params[j] == *p {
                    return Err(grammar_error(f"Duplicate Template Parameter {p} (in template {name})"));
                }
                j += 1;
            }
            i += 1;
        }
        if d.tree < 0 {
            continue;
        }
        for temp in find_data(cx, d.tree, "template_usage") {
            let sym = tok_name(cx.trees[temp].children[0]);
            let nargs = cx.trees[temp].children.len() - 1;
            if not has_str(d.params, sym) {
                let k = def_index(b, sym);
                if k < 0 {
                    return Err(grammar_error(f"Template '{sym}' used but not defined (in {kind_word(d.is_term)} {name})"));
                }
                let expected = b.defs[k].1.params.len();
                if nargs != expected {
                    return Err(grammar_error(f"Wrong number of template arguments used for {sym} (expected {expected}, got {nargs}) (in {kind_word(d.is_term)} {name})"));
                }
            }
        }
        for sym in used_symbols(cx, d.tree) {
            if def_index(b, sym) < 0 and not has_str(d.params, sym) {
                return Err(grammar_error(f"{kind_title(d.is_term)} '{sym}' used but not defined (in {kind_word(d.is_term)} {name})"));
            }
        }
    }
    let mut missing: Vec[String] = Vec.new();
    for n in b.ignore_names.iter() {
        if def_index(b, n) < 0 and not has_str(missing, n) {
            missing.push(n.clone());
        }
    }
    if missing.len() > 0 {
        let mut parts: Vec[String] = Vec.new();
        for m in sorted_strs(missing).iter() {
            parts.push(repr_of(u(m)));
        }
        return Err(grammar_error(f"Terminals {{{parts.join(", ")}}} were marked to ignore but were not defined!"));
    }
    Ok(())
}
// ------------------------------------------------------ Grammar.compile

#[derive(Clone)]
struct RuleDef {
    name: String,
    params: Vec[String],
    tree: i64,
    options: RuleOptions,
}

struct Grammar {
    rule_defs: Vec[RuleDef],
    term_defs: Vec[(String, i64, i64)],
    ignore: Vec[String],
}

// GrammarBuilder.build
fn build_grammar(cx: ref Ctx, b: ref Builder) -> Result[Grammar, LErr] {
    validate(cx, b)?;
    let mut g = Grammar { rule_defs: Vec.new(), term_defs: Vec.new(), ignore: b.ignore_names.clone() };
    for (name, d) in b.defs.iter() {
        if d.is_term {
            g.term_defs.push((name.clone(), d.tree, d.priority));
        } else {
            g.rule_defs.push(RuleDef { name: name.clone(), params: d.params.clone(), tree: d.tree, options: d.options.clone() });
        }
    }
    Ok(g)
}

// The state the compile transformers keep between calls.
struct Comp {
    // PrepareAnonTerminals
    terminals: Vec[TermDef],
    term_set: Vec[String],
    // pattern -> terminal name; a later entry wins, as a dict's would
    term_reverse: Vec[(Pattern, String)],
    anon_i: i64,
    keep_all: bool,
    // ApplyTemplates
    rule_defs: Vec[RuleDef],
    created: Vec[String],
    names: Vec[(String, Sym)],
    // EBNF_to_BNF
    new_rules: Vec[(String, i64, Option[RuleOptions])],
    cache: Vec[(N, i64, i64, i64, N, N, Sym)],
    prefix: String,
    ebnf_i: i64,
    rule_options: Option[RuleOptions],
}

fn transformer_name(kind: i64) -> String {
    match kind {
        1 => "PrepareLiterals".to_string(),
        2 => "ValidateSymbols".to_string(),
        3 => "PrepareAnonTerminals".to_string(),
        4 => "ApplyTemplates".to_string(),
        5 => "_ReplaceSymbols".to_string(),
        _ => "EBNF_to_BNF".to_string(),
    }
}

// Transformer_InPlace.transform: every subtree, bottom up, gets its tree
// children replaced by what the transformer returns for them; then the
// root itself goes through.
fn inplace(cx: mut ref Ctx, c: mut ref Comp, kind: i64, root: ref N) -> Result[N, LErr] {
    let r = tree_id(root);
    if r < 0 {
        return Ok(root.clone());
    }
    for st in iter_subtrees(cx, r) {
        let kids = cx.trees[st].children.clone();
        let mut out: Vec[N] = Vec.new();
        for k in kids.iter() {
            match k {
                N.Tr(t) => out.push(call_user(mut cx, mut c, kind, t)?),
                _ => out.push(k.clone()),
            }
        }
        cx.trees[st].children = out;
    }
    call_user(mut cx, mut c, kind, r)
}

fn call_user(cx: mut ref Ctx, c: mut ref Comp, kind: i64, t: i64) -> Result[N, LErr] {
    let data = cx.trees[t].data.clone();
    let kids = cx.trees[t].children.clone();
    if kind == 1 {
        if data == "literal" {
            if let N.Tk(tok) = ref kids[0] {
                let p = literal_to_pattern(tok)?;
                return Ok(N.Tr(new_tree(mut cx, "pattern", vec_of_n(N.Pa(p)))));
            }
        }
        if data == "range" {
            return Ok(N.Tr(prepare_range(mut cx, kids)?));
        }
    } else if kind == 2 {
        if data == "value" {
            return Ok(kids[0].clone());
        }
    } else if kind == 3 {
        if data == "pattern" {
            if let N.Pa(p) = ref kids[0] {
                return Ok(N.Sy(anon_terminal(mut c, p)));
            }
        }
    } else if kind == 4 {
        if data == "template_usage" {
            return apply_template(mut cx, mut c, kids);
        }
    } else if kind == 5 {
        if data == "value" {
            if kids.len() == 1 {
                if let N.Sy(s) = ref kids[0] {
                    for (k, v) in c.names.iter() {
                        if *k == s.name {
                            return Ok(N.Sy(v.clone()));
                        }
                    }
                }
            }
        }
        if data == "template_usage" {
            if let N.Sy(s) = ref kids[0] {
                for (k, v) in c.names.iter() {
                    if *k == s.name {
                        let mut out: Vec[N] = Vec.new();
                        out.push(N.Sy(v.clone()));
                        let mut i = 1;
                        while i < kids.len() {
                            out.push(kids[i].clone());
                            i += 1;
                        }
                        return Ok(N.Tr(new_tree(mut cx, "template_usage", out)));
                    }
                }
            }
        }
    } else {
        if data == "expr" {
            return ebnf_expr(mut cx, mut c, kids);
        }
        if data == "maybe" {
            let keep = match c.rule_options {
                Some(o) => o.keep_all,
                None => false,
            };
            let size = rule_size(cx, kids[0], keep);
            let mut empties: Vec[N] = Vec.new();
            let mut k = 0;
            while k < size {
                empties.push(N.Sy(empty_sym()));
                k += 1;
            }
            let empty = new_tree(mut cx, "expansion", empties);
            let mut alts: Vec[N] = Vec.new();
            alts.push(kids[0].clone());
            alts.push(N.Tr(empty));
            return Ok(N.Tr(new_tree(mut cx, "expansions", alts)));
        }
    }
    // __default__: a new tree with the same children
    Ok(N.Tr(new_tree(mut cx, data, kids)))
}

fn vec_of_n(n: own N) -> Vec[N] {
    let mut v: Vec[N] = Vec.new();
    v.push(n);
    v
}

fn vec2_n(a: own N, b: own N) -> Vec[N] {
    let mut v: Vec[N] = Vec.new();
    v.push(a);
    v.push(b);
    v
}

// eval_escaping: the literal's backslashes as Python's literal_eval
// reads them, after lark doubles every one it does not know.
fn eval_escaping(s: ref Vec[i64]) -> Result[Vec[i64], LErr] {
    let mut w: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < s.len() {
        let n = s[i];
        i += 1;
        w.push(n);
        if n == 92 {
            if i >= s.len() {
                return Err(grammar_error(f"Literal ended unexpectedly (bad escaping): `{repr_of(s)}`"));
            }
            let n2 = s[i];
            i += 1;
            if n2 == 92 {
                push_ascii(mut w, "\\\\");
            } else if not has_char(u("Uuxnftr"), n2) {
                w.push(92);
            }
            w.push(n2);
        }
    }
    let w2 = replace(replace(w, "\\\"", "\""), "'", "\\'");
    py_unescape(w2)
}

// The escapes of a Python string literal, which is what literal_eval
// makes of u'''...'''.
fn py_unescape(w: ref Vec[i64]) -> Result[Vec[i64], LErr] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < w.len() {
        let c = w[i];
        if c != 92 or i + 1 >= w.len() {
            out.push(c);
            i += 1;
            continue;
        }
        let e = w[i + 1];
        i += 2;
        if e == 92 {
            out.push(92);
        } else if e == 39 {
            out.push(39);
        } else if e == 34 {
            out.push(34);
        } else if e == 110 {
            out.push(10);
        } else if e == 116 {
            out.push(9);
        } else if e == 114 {
            out.push(13);
        } else if e == 102 {
            out.push(12);
        } else if e == 10 {
            // a line continuation
        } else if e == 120 or e == 117 or e == 85 {
            let n = if e == 120 { 2 } else if e == 117 { 4 } else { 8 };
            let mut v = 0;
            let mut k = 0;
            while k < n {
                if i + k >= w.len() or not is_hex(w[i + k]) {
                    return Err(grammar_error("(unicode error) truncated escape".to_string()));
                }
                v = v * 16 + hex_value(w[i + k]);
                k += 1;
            }
            i += n;
            out.push(v);
        } else {
            out.push(92);
            out.push(e);
        }
    }
    Ok(out)
}

fn hex_value(c: i64) -> i64 {
    if c >= 48 and c <= 57 {
        return c - 48;
    }
    if c >= 97 and c <= 102 {
        return c - 87;
    }
    c - 55
}

// _literal_to_pattern
fn literal_to_pattern(lit: ref Token) -> Result[Pattern, LErr] {
    let v = lit.value.clone();
    let mut flag_start = 0;
    let mut i = v.len() - 1;
    while i >= 0 {
        if v[i] == 47 or v[i] == 34 {
            flag_start = i + 1;
            break;
        }
        i -= 1;
    }
    let flags = to_string(tail(v, flag_start));
    if lit.ttype == "STRING" and has_char(v, 10) {
        return Err(grammar_error("You cannot put newlines in string literals".to_string()));
    }
    if lit.ttype == "REGEXP" and has_char(v, 10) and not flags.contains("x") {
        return Err(grammar_error("You can only use newlines in regular expressions with the `x` (verbose) flag".to_string()));
    }
    let body = sl(v, 1, flag_start - 1);
    let s = eval_escaping(body)?;
    if s.len() == 0 {
        return Err(grammar_error(f"Empty terminals are not allowed ({to_string(lit.value)})"));
    }
    if lit.ttype == "STRING" {
        let s2 = replace(s, "\\\\", "\\");
        let mut p = pat_str(s2, flags);
        p.raw = Some(lit.value.clone());
        return Ok(p);
    }
    let mut p = pat_re(s, flags);
    p.raw = Some(lit.value.clone());
    Ok(p)
}

fn prepare_range(cx: mut ref Ctx, kids: ref Vec[N]) -> Result[i64, LErr] {
    let mut a: Vec[i64] = Vec.new();
    let mut b: Vec[i64] = Vec.new();
    if let N.Tk(t) = ref kids[0] {
        a = sl(t.value, 1, t.value.len() - 1);
    }
    if let N.Tk(t) = ref kids[1] {
        b = sl(t.value, 1, t.value.len() - 1);
    }
    let mut r = u("[");
    push_all(mut r, a);
    r.push(45);
    push_all(mut r, b);
    r.push(93);
    Ok(new_tree(mut cx, "pattern", vec_of_n(N.Pa(pat_re(r, "")))))
}

// TerminalTreeToPattern (Transformer_NonRecursive): a terminal's tree
// to one pattern.
fn tree_to_pattern(cx: mut ref Ctx, n: ref N) -> Result[N, LErr] {
    let t = tree_id(n);
    if t < 0 {
        return Ok(n.clone());
    }
    let data = cx.trees[t].data.clone();
    let kids = cx.trees[t].children.clone();
    let mut args: Vec[N] = Vec.new();
    for k in kids.iter() {
        args.push(tree_to_pattern(mut cx, k)?);
    }
    if data == "pattern" or data == "value" {
        return Ok(args[0].clone());
    }
    if data == "expansion" {
        if args.len() == 0 {
            return Ok(N.Pa(pat_str(Vec.new(), "")));
        }
        if args.len() == 1 {
            return Ok(args[0].clone());
        }
        let mut r: Vec[i64] = Vec.new();
        for a in args.iter() {
            push_all(mut r, pat_regexp(as_pattern(a)));
        }
        return Ok(N.Pa(pat_re(r, "")));
    }
    if data == "expansions" {
        if args.len() == 1 {
            return Ok(args[0].clone());
        }
        let mut pats: Vec[Pattern] = Vec.new();
        let mut keys: Vec[(i64, i64, i64, String)] = Vec.new();
        for a in args.iter() {
            let p = as_pattern(a);
            let (lo, hi) = pat_width(mut cx, p);
            keys.push((0 - hi, 0 - lo, 0 - p.value.len(), String.new()));
            pats.push(p);
        }
        let mut r = u("(?:");
        let mut first = true;
        for i in sort_keys(keys) {
            if not first {
                r.push(124);
            }
            first = false;
            push_all(mut r, pat_regexp(pats[i]));
        }
        r.push(41);
        return Ok(N.Pa(pat_re(r, "")));
    }
    if data == "expr" or data == "maybe" {
        let inner = as_pattern(args[0]);
        let mut op = "?".to_string();
        if data == "expr" {
            op = tok_name(args[1]);
            if op == "~" {
                if args.len() == 3 {
                    op = f"{{{int_of(u(tok_name(args[2])))}}}";
                } else {
                    let mn = int_of(u(tok_name(args[2])));
                    let mx = int_of(u(tok_name(args[3])));
                    if mx < mn {
                        return Err(grammar_error(f"Bad Range for {pat_repr(inner)} ({mn}..{mx} isn't allowed)"));
                    }
                    op = f"{{{mn},{mx}}}";
                }
            }
        }
        let mut r = u("(?:");
        push_all(mut r, pat_regexp(inner));
        r.push(41);
        push_ascii(mut r, op);
        return Ok(N.Pa(pat_re(r, inner.flags)));
    }
    if data == "alias" {
        return Err(grammar_error("Aliasing not allowed in terminals (You used -> in the wrong place)".to_string()));
    }
    Ok(N.Tr(new_tree(mut cx, data, args)))
}

fn as_pattern(n: ref N) -> Pattern {
    match n {
        N.Pa(p) => p.clone(),
        _ => pat_str(Vec.new(), ""),
    }
}

fn is_id_char(c: i64, start: bool) -> bool {
    if c == 95 or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) {
        return true;
    }
    not start and c >= 48 and c <= 57
}

// PrepareAnonTerminals.pattern
fn anon_terminal(c: mut ref Comp, p: ref Pattern) -> Sym {
    let mut name = String.new();
    let mut found = false;
    let mut i = c.term_reverse.len() - 1;
    while i >= 0 {
        if pat_eq(c.term_reverse[i].0, p) {
            name = c.term_reverse[i].1.clone();
            found = true;
            break;
        }
        i -= 1;
    }
    if not p.re and not found {
        let v = to_string(p.value);
        name = terminal_name_of(v);
        if name.len() == 0 {
            let mut ident = p.value.len() > 0 and is_id_char(p.value[0], true);
            for ch in p.value.iter() {
                if not is_id_char(*ch, false) {
                    ident = false;
                }
            }
            if ident and not has_str(c.term_set, v.to_uppercase()) {
                name = v.to_uppercase();
            }
        }
        if name.len() > 0 and has_str(c.term_set, name) {
            name = String.new();
        }
    }
    if name.len() == 0 {
        name = f"__ANON_{c.anon_i}";
        c.anon_i += 1;
    }
    if not has_str(c.term_set, name) {
        c.term_set.push(name.clone());
        c.term_reverse.push((p.clone(), name.clone()));
        c.terminals.push(TermDef { name: name.clone(), pattern: p.clone(), priority: 0 });
    }
    let filter_out = if c.keep_all { false } else { not p.re };
    terminal(name, filter_out)
}

fn terminal_name_of(v: ref String) -> String {
    for (k, name) in terminal_names().iter() {
        if *k == *v {
            return name.clone();
        }
    }
    String.new()
}

// ApplyTemplates.template_usage
fn apply_template(cx: mut ref Ctx, c: mut ref Comp, kids: ref Vec[N]) -> Result[N, LErr] {
    let name = tok_name(kids[0]);
    let mut arg_names: Vec[String] = Vec.new();
    let mut args: Vec[Sym] = Vec.new();
    let mut i = 1;
    while i < kids.len() {
        if let N.Sy(s) = ref kids[i] {
            arg_names.push(s.name.clone());
            args.push(s.clone());
        }
        i += 1;
    }
    let result_name = f"{name}{{{arg_names.join(",")}}}";
    if not has_str(c.created, result_name) {
        c.created.push(result_name.clone());
        let mut def = c.rule_defs[0].clone();
        for d in c.rule_defs.iter() {
            if d.name == name {
                def = d.clone();
            }
        }
        let tree = copy_tree(mut cx, def.tree);
        let mut names: Vec[(String, Sym)] = Vec.new();
        let mut k = 0;
        while k < def.params.len() and k < args.len() {
            names.push((def.params[k].clone(), args[k].clone()));
            k += 1;
        }
        c.names = names;
        let res = inplace(mut cx, mut c, 5, N.Tr(tree))?;
        c.rule_defs.push(RuleDef { name: result_name.clone(), params: Vec.new(), tree: tree_id(res), options: def.options.clone() });
    }
    Ok(N.Sy(nonterminal(result_name)))
}

// FindRuleSize
fn rule_size(cx: ref Ctx, n: ref N, keep: bool) -> i64 {
    match n {
        N.Tr(t) => {
            let tr = ref cx.trees[t];
            let mut total = 0;
            let mut best = 0;
            for k in tr.children.iter() {
                let v = rule_size(cx, k, keep);
                total += v;
                if v > best {
                    best = v;
                }
            }
            if tr.data == "expansions" { best } else { total }
        }
        N.Sy(s) => {
            if is_empty_sym(s) {
                return 0;
            }
            if not s.term {
                return if s.name.starts_with("_") { 0 } else { 1 };
            }
            if keep or not s.filter_out { 1 } else { 0 }
        }
        _ => 0,
    }
}

fn ebnf_name(c: mut ref Comp, inner: Str) -> String {
    let name = f"__{c.prefix}_{inner}_{c.ebnf_i}";
    c.ebnf_i += 1;
    name
}

fn cache_find(cx: ref Ctx, c: ref Comp, key: ref N, kind: i64, a: i64, b: i64, target: ref N, atom: ref N) -> Option[Sym] {
    for e in c.cache.iter() {
        if e.1 == kind and e.2 == a and e.3 == b and n_eq(cx, e.0, key) and n_eq(cx, e.4, target) and n_eq(cx, e.5, atom) {
            return Some(e.6.clone());
        }
    }
    None
}

fn add_rule(c: mut ref Comp, key: own N, kind: i64, a: i64, b: i64, target: own N, atom: own N, name: ref String, tree: i64) -> Sym {
    let t = nonterminal(name);
    c.new_rules.push((name.clone(), tree, c.rule_options.clone()));
    c.cache.push((key, kind, a, b, target, atom, t.clone()));
    t
}

fn add_recurse_rule(cx: mut ref Ctx, c: mut ref Comp, kind: Str, expr: ref N) -> Sym {
    if let Some(s) = cache_find(cx, c, expr, 0, 0, 0, N.Nil, N.Nil) {
        return s;
    }
    let name = ebnf_name(mut c, kind);
    let t = nonterminal(name);
    let e1 = new_tree(mut cx, "expansion", vec_of_n(expr.clone()));
    let e2 = new_tree(mut cx, "expansion", vec2_n(N.Sy(t), expr.clone()));
    let tree = new_tree(mut cx, "expansions", vec2_n(N.Tr(e1), N.Tr(e2)));
    add_rule(mut c, expr.clone(), 0, 0, 0, N.Nil, N.Nil, name, tree)
}

fn repeated(n: ref N, k: i64) -> Vec[N] {
    let mut out: Vec[N] = Vec.new();
    let mut i = 0;
    while i < k {
        out.push(n.clone());
        i += 1;
    }
    out
}

fn add_repeat_rule(cx: mut ref Ctx, c: mut ref Comp, a: i64, b: i64, target: ref N, atom: ref N) -> N {
    if let Some(s) = cache_find(cx, c, N.Nil, 1, a, b, target, atom) {
        return N.Sy(s);
    }
    let name = ebnf_name(mut c, f"repeat_a{a}_b{b}");
    let mut items = repeated(target, a);
    for x in repeated(atom, b) {
        items.push(x.clone());
    }
    let e = new_tree(mut cx, "expansion", items);
    let tree = new_tree(mut cx, "expansions", vec_of_n(N.Tr(e)));
    N.Sy(add_rule(mut c, N.Nil, 1, a, b, target.clone(), atom.clone(), name, tree))
}

fn add_repeat_opt_rule(cx: mut ref Ctx, c: mut ref Comp, a: i64, b: i64, target: ref N, target_opt: ref N, atom: ref N) -> N {
    if let Some(s) = cache_find(cx, c, target_opt, 2, a, b, target, atom) {
        return N.Sy(s);
    }
    let name = ebnf_name(mut c, f"repeat_a{a}_b{b}_opt");
    let mut alts: Vec[N] = Vec.new();
    let mut i = 0;
    while i < a {
        let mut items = repeated(target, i);
        items.push(target_opt.clone());
        alts.push(N.Tr(new_tree(mut cx, "expansion", items)));
        i += 1;
    }
    i = 0;
    while i < b {
        let mut items = repeated(target, a);
        for x in repeated(atom, i) {
            items.push(x.clone());
        }
        alts.push(N.Tr(new_tree(mut cx, "expansion", items)));
        i += 1;
    }
    let tree = new_tree(mut cx, "expansions", alts);
    N.Sy(add_rule(mut c, target_opt.clone(), 2, a, b, target.clone(), atom.clone(), name, tree))
}

fn small_factors(n: i64, max_factor: i64) -> Vec[(i64, i64)] {
    if n <= max_factor {
        let mut v: Vec[(i64, i64)] = Vec.new();
        v.push((n, 0));
        return v;
    }
    let mut a = max_factor;
    while a > 1 {
        let r = n / a;
        let b = n % a;
        if a + b <= max_factor {
            let mut v = small_factors(r, max_factor);
            v.push((a, b));
            return v;
        }
        a -= 1;
    }
    Vec.new()
}

fn generate_repeats(cx: mut ref Ctx, c: mut ref Comp, rule: ref N, mn: i64, mx: i64) -> N {
    if mx < 50 {
        let mut alts: Vec[N] = Vec.new();
        let mut n = mn;
        while n <= mx {
            alts.push(N.Tr(new_tree(mut cx, "expansion", repeated(rule, n))));
            n += 1;
        }
        return N.Tr(new_tree(mut cx, "expansions", alts));
    }
    let mut mn_target = rule.clone();
    for (a, b) in small_factors(mn, 5) {
        mn_target = add_repeat_rule(mut cx, mut c, a, b, mn_target, rule);
    }
    if mx == mn {
        return mn_target;
    }
    let diff = mx - mn + 1;
    let factors = small_factors(diff, 5);
    let mut diff_target = rule.clone();
    let mut diff_opt = N.Tr(new_tree(mut cx, "expansion", Vec.new()));
    let mut i = 0;
    while i + 1 < factors.len() {
        let (a, b) = factors[i];
        diff_opt = add_repeat_opt_rule(mut cx, mut c, a, b, diff_target, diff_opt, rule);
        diff_target = add_repeat_rule(mut cx, mut c, a, b, diff_target, rule);
        i += 1;
    }
    let (a, b) = factors[factors.len() - 1];
    diff_opt = add_repeat_opt_rule(mut cx, mut c, a, b, diff_target, diff_opt, rule);
    let e = new_tree(mut cx, "expansion", vec2_n(mn_target, diff_opt));
    N.Tr(new_tree(mut cx, "expansions", vec_of_n(N.Tr(e))))
}

fn n_repr(cx: ref Ctx, n: ref N) -> String {
    match n {
        N.Sy(s) => sym_repr(s),
        N.Tr(t) => f"Tree({repr_of(u(cx.trees[t].data))}, ...)",
        _ => n_text(n),
    }
}

// EBNF_to_BNF.expr
fn ebnf_expr(cx: mut ref Ctx, c: mut ref Comp, kids: ref Vec[N]) -> Result[N, LErr] {
    let rule = kids[0].clone();
    let op = tok_name(kids[1]);
    if op == "?" {
        let empty = new_tree(mut cx, "expansion", Vec.new());
        return Ok(N.Tr(new_tree(mut cx, "expansions", vec2_n(rule, N.Tr(empty)))));
    }
    if op == "+" {
        return Ok(N.Sy(add_recurse_rule(mut cx, mut c, "plus", rule)));
    }
    if op == "*" {
        let t = add_recurse_rule(mut cx, mut c, "star", rule);
        let empty = new_tree(mut cx, "expansion", Vec.new());
        return Ok(N.Tr(new_tree(mut cx, "expansions", vec2_n(N.Sy(t), N.Tr(empty)))));
    }
    let mut mn = int_of(u(tok_name(kids[2])));
    let mut mx = mn;
    if kids.len() > 3 {
        mx = int_of(u(tok_name(kids[3])));
        if mx < mn or mn < 0 {
            return Err(grammar_error(f"Bad Range for {n_repr(cx, rule)} ({mn}..{mx} isn't allowed)"));
        }
    }
    Ok(generate_repeats(mut cx, mut c, rule, mn, mx))
}

// ------------------------------------------------- SimplifyRule_Visitor

fn flatten(cx: mut ref Ctx, t: i64) {
    loop {
        let data = cx.trees[t].data.clone();
        if not expand_kids(mut cx, t, data) {
            break;
        }
    }
}

fn dedup_n(cx: ref Ctx, items: ref Vec[N]) -> Vec[N] {
    let mut out: Vec[N] = Vec.new();
    for x in items.iter() {
        let mut dup = false;
        for y in out.iter() {
            if n_eq(cx, x, y) {
                dup = true;
                break;
            }
        }
        if not dup {
            out.push(x.clone());
        }
    }
    out
}

fn simplify(cx: mut ref Ctx, root: i64) {
    for t in iter_subtrees(cx, root) {
        let data = cx.trees[t].data.clone();
        if data == "expansion" {
            simplify_expansion(mut cx, t);
        } else if data == "alias" {
            let rule = tree_id(cx.trees[t].children[0]);
            let alias_name = cx.trees[t].children[1].clone();
            if rule >= 0 and cx.trees[rule].data == "expansions" {
                let kids = cx.trees[rule].children.clone();
                let mut aliases: Vec[N] = Vec.new();
                for k in kids.iter() {
                    aliases.push(N.Tr(new_tree(mut cx, "alias", vec2_n(k.clone(), alias_name.clone()))));
                }
                cx.trees[t].data = "expansions".to_string();
                cx.trees[t].children = aliases;
            }
        } else if data == "expansions" {
            flatten(mut cx, t);
            let kids = cx.trees[t].children.clone();
            cx.trees[t].children = dedup_n(cx, kids);
        }
    }
}

fn simplify_expansion(cx: mut ref Ctx, t: i64) {
    flatten(mut cx, t);
    let kids = cx.trees[t].children.clone();
    let mut i = 0;
    while i < kids.len() {
        let child = tree_id(kids[i]);
        if child >= 0 and cx.trees[child].data == "expansions" {
            let options = dedup_n(cx, cx.trees[child].children);
            let mut alts: Vec[N] = Vec.new();
            for option in options.iter() {
                let mut items: Vec[N] = Vec.new();
                let mut j = 0;
                while j < kids.len() {
                    items.push(if i == j { option.clone() } else { kids[j].clone() });
                    j += 1;
                }
                let e = new_tree(mut cx, "expansion", items);
                simplify(mut cx, e);
                alts.push(N.Tr(e));
            }
            cx.trees[t].data = "expansions".to_string();
            cx.trees[t].children = alts;
            flatten(mut cx, t);
            break;
        }
        i += 1;
    }
}

// RuleTreeToText: the alternatives as (symbols, alias).
fn rule_alternatives(cx: ref Ctx, n: ref N, out: mut ref Vec[(Vec[Sym], Option[String])]) {
    let t = tree_id(n);
    if t < 0 {
        return;
    }
    let tr = ref cx.trees[t];
    if tr.data == "expansions" {
        for k in tr.children.iter() {
            rule_alternatives(cx, k, mut out);
        }
    } else if tr.data == "expansion" {
        out.push((expansion_syms(tr), None));
    } else if tr.data == "alias" {
        let mut inner: Vec[(Vec[Sym], Option[String])] = Vec.new();
        rule_alternatives(cx, tr.children[0], mut inner);
        let alias = match tr.children[1] {
            N.Sy(s) => s.name.clone(),
            _ => String.new(),
        };
        for (syms, _) in inner.iter() {
            out.push((syms.clone(), Some(alias.clone())));
        }
    }
}

fn expansion_syms(tr: ref Tree) -> Vec[Sym] {
    let mut syms: Vec[Sym] = Vec.new();
    for k in tr.children.iter() {
        if let N.Sy(s) = k {
            syms.push(s.clone());
        }
    }
    syms
}

// Grammar.compile: (terminals, rules, ignore)
fn compile_grammar(cx: mut ref Ctx, g: ref Grammar, start: ref String, keep: ref Vec[String]) -> Result[(Vec[TermDef], Vec[Rule], Vec[String]), LErr] {
    let mut terminals: Vec[TermDef] = Vec.new();
    let mut c = Comp {
        terminals: Vec.new(),
        term_set: Vec.new(),
        term_reverse: Vec.new(),
        anon_i: 0,
        keep_all: false,
        rule_defs: Vec.new(),
        created: Vec.new(),
        names: Vec.new(),
        new_rules: Vec.new(),
        cache: Vec.new(),
        prefix: "anon".to_string(),
        ebnf_i: 0,
        rule_options: None,
    };
    let mut term_trees: Vec[(String, i64, i64)] = Vec.new();
    for (name, tree, prio) in g.term_defs.iter() {
        if tree < 0 {
            continue;
        }
        term_trees.push((name.clone(), copy_tree(mut cx, tree), prio));
    }
    for (name, tree, _) in term_trees.iter() {
        let exps = find_data(cx, tree, "expansion");
        if exps.len() == 1 and cx.trees[exps[0]].children.len() == 0 {
            return Err(grammar_error(f"Terminals cannot be empty ({name})"));
        }
    }
    for (name, tree, prio) in term_trees.iter() {
        let lit = inplace(mut cx, mut c, 1, N.Tr(tree))?;
        let p = tree_to_pattern(mut cx, lit)?;
        terminals.push(TermDef { name: name.clone(), pattern: as_pattern(p), priority: prio });
    }
    for t in terminals.iter() {
        c.term_set.push(t.name.clone());
        c.term_reverse.push((t.pattern.clone(), t.name.clone()));
    }
    c.terminals = terminals;
    for d in g.rule_defs.iter() {
        let mut d2 = d.clone();
        if d.tree >= 0 {
            d2.tree = copy_tree(mut cx, d.tree);
        }
        c.rule_defs.push(d2);
    }
    let mut rules: Vec[(String, i64, Option[RuleOptions])] = Vec.new();
    let mut i = 0;
    while i < c.rule_defs.len() {
        let d = c.rule_defs[i].clone();
        i += 1;
        if d.params.len() != 0 {
            continue;
        }
        let ro = if d.options.keep_all {
            let mut o = rule_options();
            o.keep_all = true;
            Some(o)
        } else {
            None
        };
        c.rule_options = ro;
        c.prefix = d.name.clone();
        c.keep_all = d.options.keep_all;
        let mut tree = N.Tr(d.tree);
        let mut kind = 1;
        while kind <= 4 {
            tree = inplace(mut cx, mut c, kind, tree)?;
            kind += 1;
        }
        let res = inplace(mut cx, mut c, 6, tree)?;
        rules.push((d.name.clone(), tree_id(res), Some(d.options.clone())));
    }
    for r in c.new_rules.iter() {
        rules.push(r.clone());
    }
    let mut compiled: Vec[Rule] = Vec.new();
    for (name, tree, options) in rules.iter() {
        simplify(mut cx, tree);
        let mut alts: Vec[(Vec[Sym], Option[String])] = Vec.new();
        rule_alternatives(cx, N.Tr(tree), mut alts);
        let mut order = 0;
        for (expansion, alias) in alts.iter() {
            if alias.is_some() and name.starts_with("_") {
                let a = alias.clone().unwrap();
                return Err(grammar_error(f"Rule {name} is marked for expansion (it starts with an underscore) and isn't allowed to have aliases (alias={a})"));
            }
            let mut any_empty = false;
            let mut empties: Vec[bool] = Vec.new();
            let mut kept: Vec[Sym] = Vec.new();
            for s in expansion.iter() {
                let e = is_empty_sym(s);
                empties.push(e);
                if e {
                    any_empty = true;
                } else {
                    kept.push(s.clone());
                }
            }
            let mut opts = match options {
                Some(o) => o.clone(),
                None => rule_options(),
            };
            if any_empty {
                opts.empty_indices = empties;
            }
            if opts.keep_all {
                for s in kept.iter_mut() {
                    if s.term {
                        s.filter_out = false;
                    }
                }
            }
            compiled.push(Rule { origin: name.clone(), expansion: kept, order: order, alias: alias.clone(), options: opts });
            order += 1;
        }
    }
    // duplicates
    let mut uniq: Vec[Rule] = Vec.new();
    for r in compiled.iter() {
        let mut dups: Vec[Rule] = Vec.new();
        for r2 in compiled.iter() {
            if rule_eq(r, r2) {
                dups.push(r2.clone());
            }
        }
        if dups.len() > 1 and r.expansion.len() > 0 {
            let mut msg = "Rules defined twice: ".to_string();
            for d in dups.iter() {
                msg.push_str(f"\n  * {rule_text(d)}");
            }
            msg.push_str("\n\n(Might happen due to colliding expansion of optionals: [] or ?)");
            return Err(grammar_error(msg));
        }
        let mut seen = false;
        for u2 in uniq.iter() {
            if rule_eq(u2, r) {
                seen = true;
            }
        }
        if not seen {
            uniq.push(r.clone());
        }
    }
    let mut compiled = uniq;
    // unused rules
    loop {
        let n = compiled.len();
        let mut used: Vec[String] = Vec.new();
        used.push(start.clone());
        for r in compiled.iter() {
            for s in r.expansion.iter() {
                if not s.term and s.name != r.origin and not has_str(used, s.name) {
                    used.push(s.name.clone());
                }
            }
        }
        let mut kept: Vec[Rule] = Vec.new();
        for r in compiled.iter() {
            if has_str(used, r.origin) {
                kept.push(r.clone());
            }
        }
        compiled = kept;
        if compiled.len() == n {
            break;
        }
    }
    let mut used_terms: Vec[String] = Vec.new();
    for r in compiled.iter() {
        for s in r.expansion.iter() {
            if s.term and not has_str(used_terms, s.name) {
                used_terms.push(s.name.clone());
            }
        }
    }
    let mut terms: Vec[TermDef] = Vec.new();
    for t in c.terminals.iter() {
        if has_str(used_terms, t.name) or has_str(g.ignore, t.name) or has_str(keep, t.name) {
            terms.push(t.clone());
        }
    }
    Ok((terms, compiled, g.ignore.clone()))
}
// ---------------------------------------------------------------- LALR

// The parse table. A symbol is named by its index; each state has one
// action per symbol: 0 for none, s + 1 to shift to state s, -(r + 1) to
// reduce by rule r.
struct Table {
    sym_names: Vec[String],
    sym_term: Vec[bool],
    sym_ids: Map[String, i64],
    rules: Vec[Rule],
    actions: Vec[Vec[i64]],
    start_state: i64,
    end_state: i64,
}

fn sym_id(t: ref Table, name: ref String) -> i64 {
    match t.sym_ids.get(name.clone()) {
        Some(i) => *i,
        None => -1,
    }
}

struct Lr0 {
    kernel: Vec[i64],
    closure: Vec[i64],
    // (symbol, state)
    trans: Vec[(i64, i64)],
    // lookahead symbol -> rules
    la: Vec[(i64, Vec[i64])],
}

struct Analysis {
    // each rule's expansion as symbol ids
    exps: Vec[Vec[i64]],
    origins: Vec[i64],
    width: i64,
    nsyms: i64,
    is_term: Vec[bool],
    by_origin: Vec[Vec[i64]],
    nullable: Vec[bool],
    closure0: Vec[Vec[i64]],
    states: Vec[Lr0],
    // the bit sets of terminals digraph works on; a set is shared by
    // every node that holds its index, as lark's sets are
    pool: Vec[Vec[i64]],
}

fn item_rule(a: ref Analysis, item: i64) -> i64 {
    item / a.width
}

fn item_index(a: ref Analysis, item: i64) -> i64 {
    item % a.width
}

// the symbol after the dot, or -1 when the item is satisfied
fn item_next(a: ref Analysis, item: i64) -> i64 {
    let r = item / a.width;
    let i = item % a.width;
    if i < a.exps[r].len() {
        return a.exps[r][i];
    }
    -1
}

fn insert_sorted(v: mut ref Vec[i64], x: i64) {
    let mut lo = 0;
    let mut hi = v.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if v[mid] < x {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo < v.len() and v[lo] == x {
        return;
    }
    v.insert(lo, x);
}

fn push_unique(v: mut ref Vec[i64], x: i64) {
    for y in v.iter() {
        if *y == x {
            return;
        }
    }
    v.push(x);
}

fn key_of(v: ref Vec[i64]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for x in v.iter() {
        parts.push(f"{*x}");
    }
    parts.join(",")
}

// GrammarAnalyzer.expand_rule: the items at the start of every rule a
// nonterminal reaches through first symbols.
fn expand_rule(a: ref Analysis, nt: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut queue: Vec[i64] = Vec.new();
    queue.push(nt);
    let mut k = 0;
    while k < queue.len() {
        let s = queue[k];
        k += 1;
        for r in a.by_origin[s].iter() {
            insert_sorted(mut out, *r * a.width);
            if a.exps[*r].len() > 0 {
                let first = a.exps[*r][0];
                if not a.is_term[first] {
                    push_unique(mut queue, first);
                }
            }
        }
    }
    out
}

fn bits_new(a: ref Analysis) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < (a.nsyms + 63) / 64 {
        v.push(0);
        k += 1;
    }
    v
}

fn bits_add(v: mut ref Vec[i64], s: i64) {
    v[s / 64] = v[s / 64] | (1 << (s % 64));
}

fn bits_has(v: ref Vec[i64], s: i64) -> bool {
    (v[s / 64] & (1 << (s % 64))) != 0
}

// LALR_Analyzer.compute_lalr: the table, or the GrammarError lark raises.
fn build_table(rules: ref Vec[Rule], start: ref String) -> Result[Table, LErr] {
    let root_name = f"$root_{start}";
    let mut root = Rule { origin: root_name.clone(), expansion: Vec.new(), order: 0, alias: None, options: rule_options() };
    root.expansion.push(nonterminal(start));
    root.expansion.push(terminal("$END", false));
    // duplicates, then symbols nothing defines
    let mut all = rules.clone();
    all.push(root.clone());
    let mut dups: Vec[String] = Vec.new();
    let mut i = 0;
    while i < all.len() {
        let mut j = 0;
        let mut count = 0;
        let mut first = -1;
        while j < all.len() {
            if rule_eq(all[i], all[j]) {
                count += 1;
                if first < 0 {
                    first = j;
                }
            }
            j += 1;
        }
        if count > 1 and first == i {
            dups.push(rule_text(all[i]));
        }
        i += 1;
    }
    if dups.len() > 0 {
        return Err(grammar_error(f"Rules defined twice: {dups.join(", ")}"));
    }
    let mut origins_seen: Vec[String] = Vec.new();
    for r in all.iter() {
        if not has_str(origins_seen, r.origin) {
            origins_seen.push(r.origin.clone());
        }
    }
    for r in all.iter() {
        for s in r.expansion.iter() {
            if not s.term and not has_str(origins_seen, s.name) {
                return Err(grammar_error(f"Using an undefined rule: {sym_repr(s)}"));
            }
        }
    }
    // symbols: the origins, then every other symbol in rule order
    let mut t = Table {
        sym_names: Vec.new(),
        sym_term: Vec.new(),
        sym_ids: Map.new(),
        rules: rules.clone(),
        actions: Vec.new(),
        start_state: 0,
        end_state: 0,
    };
    let mut lr0_root = root.clone();
    lr0_root.expansion.pop();
    t.rules.push(lr0_root);
    let rules_all = t.rules.clone();
    for r in rules_all.iter() {
        add_sym(mut t, r.origin, false);
    }
    for r in rules_all.iter() {
        for s in r.expansion.iter() {
            add_sym(mut t, s.name, s.term);
        }
    }
    add_sym(mut t, "$END".to_string(), true);
    let nsyms = t.sym_names.len();
    let mut width = 1;
    for r in rules_all.iter() {
        if r.expansion.len() + 1 > width {
            width = r.expansion.len() + 1;
        }
    }
    let mut a = Analysis {
        exps: Vec.new(),
        origins: Vec.new(),
        width: width,
        nsyms: nsyms,
        is_term: t.sym_term.clone(),
        by_origin: Vec.new(),
        nullable: Vec.new(),
        closure0: Vec.new(),
        states: Vec.new(),
        pool: Vec.new(),
    };
    let mut k = 0;
    while k < nsyms {
        a.by_origin.push(Vec.new());
        a.nullable.push(false);
        k += 1;
    }
    let mut ri = 0;
    for r in rules_all.iter() {
        let o = sym_id(t, r.origin);
        a.origins.push(o);
        let mut e: Vec[i64] = Vec.new();
        for s in r.expansion.iter() {
            e.push(sym_id(t, s.name));
        }
        a.exps.push(e);
        a.by_origin[o].push(ri);
        ri += 1;
    }
    let nrules = rules.len();
    // NULLABLE
    let mut changed = true;
    while changed {
        changed = false;
        let mut r = 0;
        while r < nrules {
            let o = a.origins[r];
            if not a.nullable[o] {
                let mut all_null = true;
                for s in a.exps[r].iter() {
                    if not a.nullable[*s] {
                        all_null = false;
                    }
                }
                if all_null {
                    a.nullable[o] = true;
                    changed = true;
                }
            }
            r += 1;
        }
    }
    // LR(0) item sets
    let root_rule = nrules;
    let mut cache: Map[String, i64] = Map.new();
    let mut kernel0: Vec[i64] = Vec.new();
    kernel0.push(root_rule * width);
    let closure0 = expand_rule(a, a.origins[root_rule]);
    cache.insert(key_of(kernel0), 0);
    a.states.push(Lr0 { kernel: kernel0, closure: closure0, trans: Vec.new(), la: Vec.new() });
    let mut si = 0;
    while si < a.states.len() {
        let closure = a.states[si].closure.clone();
        let mut syms: Vec[i64] = Vec.new();
        let mut groups: Vec[Vec[i64]] = Vec.new();
        for it in closure.iter() {
            let nx = item_next(a, *it);
            if nx < 0 {
                continue;
            }
            let mut g = -1;
            let mut q = 0;
            while q < syms.len() {
                if syms[q] == nx {
                    g = q;
                }
                q += 1;
            }
            if g < 0 {
                syms.push(nx);
                groups.push(Vec.new());
                g = syms.len() - 1;
            }
            insert_sorted(mut groups[g], *it + 1);
        }
        let mut q = 0;
        while q < syms.len() {
            let kernel = groups[q].clone();
            let key = key_of(kernel);
            let target = match cache.get(key.clone()) {
                Some(s) => *s,
                None => {
                    let mut cl = kernel.clone();
                    for it in kernel.iter() {
                        let nx = item_next(a, *it);
                        if nx >= 0 and not a.is_term[nx] {
                            for x in expand_rule(a, nx) {
                                insert_sorted(mut cl, x);
                            }
                        }
                    }
                    a.states.push(Lr0 { kernel: kernel, closure: cl, trans: Vec.new(), la: Vec.new() });
                    let s = a.states.len() - 1;
                    cache.insert(key, s);
                    s
                }
            };
            a.states[si].trans.push((syms[q], target));
            q += 1;
        }
        si += 1;
    }
    compute_lookaheads(mut a, root_rule);
    // the LALR(1) table
    let mut rr: Vec[String] = Vec.new();
    let nstates = a.states.len();
    let mut s = 0;
    while s < nstates {
        let mut row: Vec[i64] = Vec.new();
        k = 0;
        while k < nsyms {
            row.push(0);
            k += 1;
        }
        for (sym, target) in a.states[s].trans.iter() {
            row[sym] = target + 1;
        }
        for (la, rs) in a.states[s].la.iter() {
            let mut chosen = -1;
            if rs.len() > 1 {
                let mut best = -1;
                let mut best_p = 0;
                let mut second_p = 0;
                let mut have_second = false;
                for r in rs.iter() {
                    let p = match t.rules[*r].options.priority {
                        Some(x) => x,
                        None => 0,
                    };
                    if best < 0 or p > best_p {
                        if best >= 0 {
                            second_p = best_p;
                            have_second = true;
                        }
                        best = *r;
                        best_p = p;
                    } else if not have_second or p > second_p {
                        second_p = p;
                        have_second = true;
                    }
                }
                if best_p > second_p {
                    chosen = best;
                } else {
                    let mut msg = f"Reduce/Reduce collision in {sym_repr(terminal(t.sym_names[la], false))} between the following rules: ";
                    for r in rs.iter() {
                        msg.push_str(f"\n\t- {rule_text(t.rules[*r])}");
                    }
                    rr.push(msg);
                    continue;
                }
            } else {
                chosen = rs[0];
            }
            if row[la] == 0 {
                row[la] = 0 - (chosen + 1);
            }
        }
        t.actions.push(row);
        for it in a.states[s].closure.iter() {
            if item_rule(a, *it) == root_rule and item_index(a, *it) == 1 {
                t.end_state = s;
            }
        }
        s += 1;
    }
    if rr.len() > 0 {
        return Err(grammar_error(rr.join("\n\n")));
    }
    Ok(t)
}

fn add_sym(t: mut ref Table, name: ref String, term: bool) {
    if t.sym_ids.contains_key(name.clone()) {
        return;
    }
    t.sym_names.push(name.clone());
    t.sym_term.push(term);
    t.sym_ids.insert(name.clone(), t.sym_names.len() - 1);
}

fn trans_of(a: ref Analysis, state: i64, sym: i64) -> i64 {
    for (s, target) in a.states[state].trans.iter() {
        if s == sym {
            return target;
        }
    }
    -1
}

// compute_reads_relations, compute_includes_lookback, compute_lookaheads
fn compute_lookaheads(a: mut ref Analysis, root_rule: i64) {
    let mut nts: Vec[(i64, i64)] = Vec.new();
    let mut nt_index: Map[i64, i64] = Map.new();
    let mut dr: Vec[i64] = Vec.new();
    let mut reads: Vec[Vec[i64]] = Vec.new();
    let end_id = a.nsyms - 1;
    let end_sym = find_end(a);
    let nsyms = a.nsyms;
    let mut root_start = -1;
    let k0 = a.states[0].kernel[0];
    let root_next = item_next(a, k0);
    let mut st = 0;
    while st < a.states.len() {
        let closure = a.states[st].closure.clone();
        let mut seen: Vec[i64] = Vec.new();
        for it in closure.iter() {
            let s = item_next(a, *it);
            if s < 0 or a.is_term[s] or a.by_origin[s].len() == 0 {
                continue;
            }
            if seen.contains(s) {
                continue;
            }
            seen.push(s);
            let idx = nts.len();
            nts.push((st, s));
            nt_index.insert(st * nsyms + s, idx);
            let mut set = bits_new(a);
            if st == 0 and s == root_next {
                bits_add(mut set, end_sym);
                root_start = idx;
            }
            let next_state = trans_of(a, st, s);
            let mut r: Vec[i64] = Vec.new();
            for it2 in a.states[next_state].closure.iter() {
                let s2 = item_next(a, *it2);
                if s2 < 0 {
                    continue;
                }
                if a.is_term[s2] or a.by_origin[s2].len() == 0 {
                    bits_add(mut set, s2);
                }
                if a.nullable[s2] {
                    // (next_state, s2): its index once that state is reached
                    push_unique(mut r, next_state * nsyms + s2);
                }
            }
            a.pool.push(set);
            dr.push(a.pool.len() - 1);
            reads.push(r);
        }
        st += 1;
    }
    // reads hold (state, symbol) keys; make them indices
    let mut reads_idx: Vec[Vec[i64]] = Vec.new();
    for r in reads.iter() {
        let mut v: Vec[i64] = Vec.new();
        for key in r.iter() {
            if let Some(i) = nt_index.get(*key) {
                v.push(*i);
            }
        }
        reads_idx.push(v);
    }
    let mut includes: Vec[Vec[i64]] = Vec.new();
    let mut lookback: Vec[Vec[(i64, i64)]] = Vec.new();
    let mut n = 0;
    while n < nts.len() {
        includes.push(Vec.new());
        lookback.push(Vec.new());
        n += 1;
    }
    n = 0;
    while n < nts.len() {
        let (state, nonterm) = nts[n];
        let mut inc: Vec[i64] = Vec.new();
        let closure = a.states[state].closure.clone();
        for it in closure.iter() {
            let r = item_rule(a, *it);
            if a.origins[r] != nonterm {
                continue;
            }
            let mut state2 = state;
            let exp = a.exps[r].clone();
            let mut i = item_index(a, *it);
            while i < exp.len() {
                let s = exp[i];
                let key = state2 * nsyms + s;
                state2 = trans_of(a, state2, s);
                i += 1;
                let nt2 = match nt_index.get(key) {
                    Some(x) => *x,
                    None => continue,
                };
                let mut rest_nullable = true;
                let mut j = i;
                while j < exp.len() {
                    if not a.nullable[exp[j]] {
                        rest_nullable = false;
                        break;
                    }
                    j += 1;
                }
                if rest_nullable {
                    inc.push(nt2);
                }
            }
            if item_index(a, *it) == 0 {
                for it2 in a.states[state2].closure.iter() {
                    if item_rule(a, *it2) == r and item_next(a, *it2) < 0 {
                        let pair = (state2, r);
                        let mut have = false;
                        for p in lookback[n].iter() {
                            if p.0 == pair.0 and p.1 == pair.1 {
                                have = true;
                            }
                        }
                        if not have {
                            lookback[n].push(pair);
                        }
                    }
                }
            }
        }
        for nt2 in inc.iter() {
            push_unique(mut includes[*nt2], n);
        }
        n += 1;
    }
    let read_sets = digraph(mut a, nts.len(), reads_idx, dr);
    let follow = digraph(mut a, nts.len(), includes, read_sets);
    n = 0;
    while n < nts.len() {
        let set = a.pool[follow[n]].clone();
        for (state, rule) in lookback[n].iter() {
            let mut s = 0;
            while s < nsyms {
                if bits_has(set, s) {
                    add_lookahead(mut a.states[state], s, rule);
                }
                s += 1;
            }
        }
        n += 1;
    }
    let _ = end_id;
    let _ = root_start;
    let _ = root_rule;
}

fn find_end(a: ref Analysis) -> i64 {
    // $END is the last symbol added
    a.nsyms - 1
}

fn add_lookahead(st: mut ref Lr0, sym: i64, rule: i64) {
    for e in st.la.iter_mut() {
        if e.0 == sym {
            push_unique(mut e.1, rule);
            return;
        }
    }
    let mut v: Vec[i64] = Vec.new();
    v.push(rule);
    st.la.push((sym, v));
}

// lark's digraph: F[x] starts as G[x] itself (the same set, not a
// copy), and every node of a strongly connected component ends holding
// the component root's set.
fn digraph(a: mut ref Analysis, n: i64, r: ref Vec[Vec[i64]], g: ref Vec[i64]) -> Vec[i64] {
    let mut f: Vec[i64] = Vec.new();
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < n {
        f.push(-1);
        marks.push(0);
        k += 1;
    }
    let mut stack: Vec[i64] = Vec.new();
    let mut x = 0;
    while x < n {
        if marks[x] == 0 {
            traverse(mut a, x, mut stack, mut marks, r, g, mut f);
        }
        x += 1;
    }
    f
}

fn traverse(a: mut ref Analysis, x: i64, stack: mut ref Vec[i64], marks: mut ref Vec[i64], r: ref Vec[Vec[i64]], g: ref Vec[i64], f: mut ref Vec[i64]) {
    stack.push(x);
    let d = stack.len();
    marks[x] = d;
    f[x] = g[x];
    for y in r[x].iter() {
        if marks[*y] == 0 {
            traverse(mut a, *y, mut stack, mut marks, r, g, mut f);
        }
        let n_x = marks[x];
        let n_y = marks[*y];
        if n_y > 0 and n_y < n_x {
            marks[x] = n_y;
        }
        let fy = a.pool[f[*y]].clone();
        let fx = f[x];
        let mut w = 0;
        while w < fy.len() {
            a.pool[fx][w] = a.pool[fx][w] | fy[w];
            w += 1;
        }
    }
    if marks[x] == d {
        let fx = f[x];
        loop {
            let z = stack.pop().unwrap();
            marks[z] = -1;
            f[z] = fx;
            if z == x {
                break;
            }
        }
    }
}
// --------------------------------------------------------------- lexers

// A BasicLexer: its terminals in lark's order, the regex of each, the
// keyword checks (_create_unless) and what it ignores.
struct BLexer {
    // the scanner's terminals (indices into LarkP.terminals)
    terms: Vec[i64],
    rx_ids: Vec[i64],
    // retok index -> the string terminals it may really be
    unless: Vec[(i64, Vec[i64])],
    unless_rx: Vec[(i64, Vec[i64])],
    ignore: Vec[String],
    newline: Vec[String],
    allowed: Vec[String],
}

// ParseTreeBuilder's callback for one rule.
struct RuleBuilder {
    name: String,
    expand_single: bool,
    has_filter: bool,
    // (child index, inline it, Nones before it)
    include: Vec[(i64, bool, i64)],
    append_none: i64,
}

struct LarkP {
    terminals: Vec[TermDef],
    rules: Vec[Rule],
    ignore: Vec[String],
    table: Table,
    builders: Vec[RuleBuilder],
    basic: bool,
    lexers: Vec[BLexer],
    // the lexer of each state (contextual), and the one of all terminals
    state_lexer: Vec[i64],
    root_lexer: i64,
    // 0: no postlex; 1: the outline's indenter
    postlex: i64,
}

struct LarkOpts {
    lexer_basic: bool,
    maybe_placeholders: bool,
    postlex: i64,
    start: String,
    import_paths: Vec[String],
}

fn term_index(lp: ref LarkP, name: ref String) -> i64 {
    let mut i = 0;
    while i < lp.terminals.len() {
        if lp.terminals[i].name == *name {
            return i;
        }
        i += 1;
    }
    -1
}

fn regexp_has_newline(r: ref Vec[i64]) -> bool {
    has_char(r, 10) or contains(r, "\\n") or contains(r, "\\s") or contains(r, "[^") or (contains(r, "(?s") and has_char(r, 46))
}

// BasicLexer.__init__ and _build_scanner over the given terminals.
fn make_basic_lexer(cx: mut ref Ctx, terminals: ref Vec[TermDef], which: ref Vec[i64], ignore: ref Vec[String], validate: bool) -> Result[BLexer, LErr] {
    if validate {
        for i in which.iter() {
            let t = ref terminals[*i];
            let r = pat_regexp(t.pattern);
            if re_compile(r, 0).is_err() {
                return Err(err("LexError", f"Cannot compile token {t.name}: {pat_repr(t.pattern)}"));
            }
            let (lo, _) = pat_width(mut cx, t.pattern);
            if lo == 0 {
                return Err(err("LexError", f"Lexer does not allow zero-width terminals. ({t.name}: {pat_repr(t.pattern)})"));
            }
        }
        for n in ignore.iter() {
            let mut found = false;
            for i in which.iter() {
                if terminals[*i].name == *n {
                    found = true;
                }
            }
            if not found {
                return Err(err("LexError", f"Ignore terminals are not defined: {n}"));
            }
        }
    }
    let mut newline: Vec[String] = Vec.new();
    let mut keys: Vec[(i64, i64, i64, String)] = Vec.new();
    for i in which.iter() {
        let t = ref terminals[*i];
        if regexp_has_newline(pat_regexp(t.pattern)) {
            newline.push(t.name.clone());
        }
        let (_, hi) = pat_width(mut cx, t.pattern);
        keys.push((0 - t.priority, 0 - hi, 0 - t.pattern.value.len(), t.name.clone()));
    }
    let mut sorted: Vec[i64] = Vec.new();
    for k in sort_keys(keys) {
        sorted.push(which[k]);
    }
    // _create_unless
    let mut embedded: Vec[i64] = Vec.new();
    let mut unless: Vec[(i64, Vec[i64])] = Vec.new();
    for re_i in sorted.iter() {
        let retok = ref terminals[*re_i];
        if not retok.pattern.re {
            continue;
        }
        let mut strs: Vec[i64] = Vec.new();
        for s_i in sorted.iter() {
            let strtok = ref terminals[*s_i];
            if strtok.pattern.re or strtok.priority != retok.priority {
                continue;
            }
            let s = strtok.pattern.value.clone();
            let id = rx_id_v(mut cx.rx, pat_regexp(retok.pattern), 0);
            let mut subject = s.clone();
            let whole = match rx_match(mut cx.rx, id, mut subject, 0) {
                Some(f) => f.start == 0 and f.end == s.len(),
                None => false,
            };
            if whole {
                strs.push(*s_i);
                if flags_subset(strtok.pattern.flags, retok.pattern.flags) {
                    push_unique(mut embedded, *s_i);
                }
            }
        }
        if strs.len() > 0 {
            unless.push((*re_i, strs));
        }
    }
    let mut terms: Vec[i64] = Vec.new();
    let mut rx_ids: Vec[i64] = Vec.new();
    let mut allowed: Vec[String] = Vec.new();
    for i in sorted.iter() {
        if embedded.contains(*i) {
            continue;
        }
        terms.push(*i);
        rx_ids.push(rx_id_v(mut cx.rx, pat_regexp(terminals[*i].pattern), 0));
        allowed.push(terminals[*i].name.clone());
    }
    let mut unless_rx: Vec[(i64, Vec[i64])] = Vec.new();
    for (re_i, strs) in unless.iter() {
        let mut ids: Vec[i64] = Vec.new();
        for s_i in strs.iter() {
            let mut r = pat_regexp(terminals[*s_i].pattern);
            r.push(36);
            ids.push(rx_id_v(mut cx.rx, r, 0));
        }
        unless_rx.push((re_i, ids));
    }
    Ok(BLexer { terms: terms, rx_ids: rx_ids, unless: unless, unless_rx: unless_rx, ignore: ignore.clone(), newline: newline, allowed: allowed })
}

fn flags_subset(a: ref String, b: ref String) -> bool {
    for c in a.bytes() {
        let mut found = false;
        for d in b.bytes() {
            if c == d {
                found = true;
            }
        }
        if not found {
            return false;
        }
    }
    true
}

// LexerState with its LineCounter.
struct LexState {
    text: Vec[i64],
    pos: i64,
    line: i64,
    col: i64,
    line_start: i64,
    last: Option[Token],
}

fn new_lex_state(text: own Vec[i64]) -> LexState {
    LexState { text: text, pos: 0, line: 1, col: 1, line_start: 0, last: None }
}

fn feed_line(ls: mut ref LexState, value: ref Vec[i64], test_newline: bool) {
    if test_newline {
        let mut n = 0;
        let mut last = -1;
        let mut i = 0;
        while i < value.len() {
            if value[i] == 10 {
                n += 1;
                last = i;
            }
            i += 1;
        }
        if n > 0 {
            ls.line += n;
            ls.line_start = ls.pos + last + 1;
        }
    }
    ls.pos += value.len();
    ls.col = ls.pos - ls.line_start + 1;
}

// BasicLexer.next_token: the next token, None at the end, or
// UnexpectedCharacters.
fn next_token(cx: mut ref Ctx, lp: ref LarkP, lx: i64, ls: mut ref LexState) -> Result[Option[Token], LErr] {
    let lexer = ref lp.lexers[lx];
    while ls.pos < ls.text.len() {
        let mut hit = -1;
        let mut end = 0;
        let mut k = 0;
        while k < lexer.terms.len() {
            if let Some(f) = rx_match(mut cx.rx, lexer.rx_ids[k], mut ls.text, ls.pos) {
                hit = lexer.terms[k];
                end = f.end;
                break;
            }
            k += 1;
        }
        if hit < 0 {
            let mut e = err("UnexpectedCharacters", String.new());
            for a in lexer.allowed.iter() {
                if not has_str(lexer.ignore, a) {
                    e.expected.push(a.clone());
                }
            }
            if e.expected.len() == 0 {
                e.expected.push("<END-OF-FILE>".to_string());
            }
            e.pos = ls.pos;
            e.line = ls.line;
            e.col = ls.col;
            e.ch = ls.text[ls.pos];
            if let Some(t) = ref ls.last {
                e.history.push(t.clone());
            }
            return Err(e);
        }
        let value = sl(ls.text, ls.pos, end);
        let ttype = lp.terminals[hit].name.clone();
        let ignored = has_str(lexer.ignore, ttype);
        let mut tok = token_at(ttype, value.clone(), ls.pos, ls.line, ls.col);
        let nl = has_str(lexer.newline, ttype);
        feed_line(mut ls, value, nl);
        tok.end_line = ls.line;
        tok.end_col = ls.col;
        tok.end_pos = ls.pos;
        if not ignored {
            let mut u_i = 0;
            while u_i < lexer.unless.len() {
                if lexer.unless[u_i].0 == hit {
                    let strs = ref lexer.unless[u_i].1;
                    let ids = ref lexer.unless_rx[u_i].1;
                    let mut j = 0;
                    while j < strs.len() {
                        let mut subject = tok.value.clone();
                        if rx_match(mut cx.rx, ids[j], mut subject, 0).is_some() {
                            tok.ttype = lp.terminals[strs[j]].name.clone();
                            break;
                        }
                        j += 1;
                    }
                }
                u_i += 1;
            }
            ls.last = Some(tok.clone());
            return Ok(Some(tok));
        }
    }
    Ok(None)
}

// ContextualLexer.lex for one token: the state's lexer, and on a failure
// the root lexer to name the token that does not fit.
fn next_contextual(cx: mut ref Ctx, lp: ref LarkP, ls: mut ref LexState, state: i64) -> Result[Option[Token], LErr] {
    if lp.basic {
        return next_token(mut cx, lp, lp.root_lexer, mut ls);
    }
    match next_token(mut cx, lp, lp.state_lexer[state], mut ls) {
        Ok(t) => Ok(t),
        Err(e) => {
            let last = ls.last.clone();
            match next_token(mut cx, lp, lp.root_lexer, mut ls) {
                Ok(Some(tok)) => {
                    let mut ut = err("UnexpectedToken", String.new());
                    ut.token = tok;
                    ut.expected = e.expected.clone();
                    if let Some(l) = last {
                        ut.history.push(l);
                    }
                    Err(ut)
                }
                _ => Err(e),
            }
        }
    }
}

// ------------------------------------------------------------- parsing

struct PRes {
    value: N,
    stack: Vec[i64],
    ntokens: i64,
}

// The uppercase keys of a state's actions.
fn expected_of(t: ref Table, state: i64) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut s = 0;
    while s < t.sym_names.len() {
        if t.actions[state][s] != 0 and is_upper(t.sym_names[s]) {
            out.push(t.sym_names[s].clone());
        }
        s += 1;
    }
    out
}

// InteractiveParser.accepts: the terminals the parser could take next.
fn accepts_of(t: ref Table, stack: ref Vec[i64]) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let top = stack[stack.len() - 1];
    let mut s = 0;
    while s < t.sym_names.len() {
        if t.actions[top][s] != 0 and is_upper(t.sym_names[s]) {
            if try_feed(t, stack, s) {
                out.push(t.sym_names[s].clone());
            }
        }
        s += 1;
    }
    sorted_strs(out)
}

fn try_feed(t: ref Table, stack0: ref Vec[i64], sym: i64) -> bool {
    let mut stack = stack0.clone();
    let is_end = t.sym_names[sym] == "$END";
    loop {
        let state = stack[stack.len() - 1];
        let a = t.actions[state][sym];
        if a == 0 {
            return false;
        }
        if a > 0 {
            return true;
        }
        let r = 0 - a - 1;
        let size = t.rules[r].expansion.len();
        let mut k = 0;
        while k < size {
            stack.pop();
            k += 1;
        }
        let o = sym_id(t, t.rules[r].origin);
        let g = t.actions[stack[stack.len() - 1]][o];
        stack.push(g - 1);
        if is_end and g - 1 == t.end_state {
            return true;
        }
    }
}

// ParseTreeBuilder: the node one reduction makes.
fn build_node(cx: mut ref Ctx, b: ref RuleBuilder, children: own Vec[N]) -> N {
    let mut filtered: Vec[N] = Vec.new();
    if b.has_filter {
        for (i, expand, nones) in b.include.iter() {
            let mut k = 0;
            while k < nones {
                filtered.push(N.Nil);
                k += 1;
            }
            if expand {
                let c = tree_id(children[i]);
                if c >= 0 {
                    for x in cx.trees[c].children.iter() {
                        filtered.push(x.clone());
                    }
                }
            } else {
                filtered.push(children[i].clone());
            }
        }
        let mut k = 0;
        while k < b.append_none {
            filtered.push(N.Nil);
            k += 1;
        }
    } else {
        filtered = children;
    }
    if b.expand_single and filtered.len() == 1 {
        return filtered[0].clone();
    }
    N.Tr(new_tree(mut cx, b.name, filtered))
}

// ParserState.feed_token: Some(result) once the end is reached.
fn feed(cx: mut ref Ctx, lp: ref LarkP, stack: mut ref Vec[i64], values: mut ref Vec[N], tok: ref Token, is_end: bool, build: bool) -> Result[Option[N], LErr] {
    let t = ref lp.table;
    let sym = sym_id(t, tok.ttype);
    loop {
        let state = stack[stack.len() - 1];
        let a = if sym < 0 { 0 } else { t.actions[state][sym] };
        if a == 0 {
            let mut e = err("UnexpectedToken", String.new());
            e.token = tok.clone();
            e.expected = expected_of(t, state);
            return Err(e);
        }
        if a > 0 {
            stack.push(a - 1);
            values.push(N.Tk(tok.clone()));
            return Ok(None);
        }
        let r = 0 - a - 1;
        let size = t.rules[r].expansion.len();
        let mut kids: Vec[N] = Vec.new();
        let mut k = values.len() - size;
        while k < values.len() {
            kids.push(values[k].clone());
            k += 1;
        }
        k = 0;
        while k < size {
            stack.pop();
            values.pop();
            k += 1;
        }
        let value = if build { build_node(mut cx, lp.builders[r], kids) } else { N.Nil };
        let o = sym_id(t, t.rules[r].origin);
        let g = t.actions[stack[stack.len() - 1]][o];
        stack.push(g - 1);
        values.push(value);
        if is_end and g - 1 == t.end_state {
            return Ok(Some(values[values.len() - 1].clone()));
        }
    }
}

// Indenter.handle_NL and the paren count: the tokens one lexed token
// becomes, and a DedentError after them if the indentation is wrong.
struct Indent {
    levels: Vec[i64],
    paren: i64,
}

fn indent_token(ind: mut ref Indent, tok: ref Token, out: mut ref Vec[Token]) -> Option[LErr] {
    if tok.ttype != "_NL" {
        out.push(tok.clone());
        return None;
    }
    if ind.paren > 0 {
        return None;
    }
    out.push(tok.clone());
    let mut i = tok.value.len() - 1;
    while i >= 0 and tok.value[i] != 10 {
        i -= 1;
    }
    let indent_str = tail(tok.value, i + 1);
    let mut indent = 0;
    for c in indent_str.iter() {
        if *c == 32 {
            indent += 1;
        } else if *c == 9 {
            indent += 8;
        }
    }
    let top = ind.levels[ind.levels.len() - 1];
    if indent > top {
        ind.levels.push(indent);
        out.push(borrow_pos("_INDENT", indent_str, tok));
        return None;
    }
    while indent < ind.levels[ind.levels.len() - 1] {
        ind.levels.pop();
        out.push(borrow_pos("_DEDENT", indent_str.clone(), tok));
    }
    let now = ind.levels[ind.levels.len() - 1];
    if indent != now {
        return Some(err("DedentError", f"Unexpected dedent to column {indent}. Expected dedent to {now}"));
    }
    None
}

// The error with the parser state lark compares it by, and the
// accepts() of an interactive parser at that point.
fn with_state(lp: ref LarkP, lid: i64, e: own LErr, stack: ref Vec[i64], interactive: bool) -> LErr {
    let mut e2 = e;
    e2.has_state = true;
    e2.st_len = stack.len();
    e2.st_pos = stack[stack.len() - 1];
    e2.lark = lid;
    if not interactive and e2.kind == "UnexpectedToken" {
        e2.accepts = accepts_of(lp.table, stack);
        e2.has_accepts = true;
    }
    e2
}

fn run_parse(cx: mut ref Ctx, lid: i64, text: own Vec[i64], interactive: bool) -> Result[PRes, LErr] {
    let mut skipped: Vec[LErr] = Vec.new();
    parse_with(mut cx, lid, text, interactive, false, mut skipped)
}

// _Parser.parse_from_state over the lexer (and postlex); with recover,
// an UnexpectedToken is reported in skipped and its token dropped, as
// an on_error handler that returns True does.
fn parse_with(cx: mut ref Ctx, lid: i64, text: own Vec[i64], interactive: bool, recover: bool, skipped: mut ref Vec[LErr]) -> Result[PRes, LErr] {
    let lp = cx.larks[lid].take().unwrap();
    let r = parse_inner(mut cx, lp, lid, text, interactive, recover, mut skipped);
    cx.larks[lid] = Some(lp);
    r
}

fn parse_inner(cx: mut ref Ctx, lp: ref LarkP, lid: i64, text: own Vec[i64], interactive: bool, recover: bool, skipped: mut ref Vec[LErr]) -> Result[PRes, LErr] {
    let mut ls = new_lex_state(text);
    let mut stack: Vec[i64] = Vec.new();
    stack.push(lp.table.start_state);
    let mut values: Vec[N] = Vec.new();
    let mut pending: Vec[Token] = Vec.new();
    let mut pending_err: Option[LErr] = None;
    let mut lex_done = false;
    let mut ind = Indent { levels: Vec.new(), paren: 0 };
    ind.levels.push(0);
    let mut last: Option[Token] = None;
    let mut ntokens = 0;
    loop {
        let tok = if pending.len() > 0 {
            pending.remove(0)
        } else if pending_err.is_some() {
            return Err(pending_err.unwrap());
        } else if lex_done {
            break;
        } else {
            let state = stack[stack.len() - 1];
            match next_contextual(mut cx, lp, mut ls, state) {
                Ok(Some(t)) => {
                    if lp.postlex == 1 {
                        pending_err = indent_token(mut ind, t, mut pending);
                        continue;
                    }
                    t
                }
                Ok(None) => {
                    lex_done = true;
                    if lp.postlex == 1 {
                        while ind.levels.len() > 1 {
                            ind.levels.pop();
                            pending.push(token("_DEDENT", Vec.new()));
                        }
                    }
                    continue;
                }
                Err(e) => {
                    let e2 = with_state(lp, lid, e, stack, interactive);
                    if recover and e2.kind == "UnexpectedToken" and e2.token.ttype != "$END" {
                        last = Some(e2.token.clone());
                        skipped.push(e2);
                        continue;
                    }
                    return Err(e2);
                }
            }
        };
        ntokens += 1;
        last = Some(tok.clone());
        if let Err(e) = feed(mut cx, lp, mut stack, mut values, tok, false, true) {
            let e2 = with_state(lp, lid, e, stack, interactive);
            if recover and e2.token.ttype != "$END" {
                skipped.push(e2);
                continue;
            }
            return Err(e2);
        }
    }
    if interactive {
        return Ok(PRes { value: N.Nil, stack: stack, ntokens: ntokens });
    }
    let end = match last {
        Some(t) => borrow_pos("$END", Vec.new(), t),
        None => token_at("$END", Vec.new(), 0, 1, 1),
    };
    match feed(mut cx, lp, mut stack, mut values, end, true, true) {
        Ok(Some(v)) => Ok(PRes { value: v, stack: stack, ntokens: ntokens }),
        Ok(None) => Ok(PRes { value: N.Nil, stack: stack, ntokens: ntokens }),
        Err(e) => Err(with_state(lp, lid, e, stack, false)),
    }
}

// UnexpectedInput.match_examples
fn match_examples(cx: mut ref Ctx, lid: i64, e: ref LErr, examples: ref Vec[(String, Vec[String])], use_accepts: bool) -> Option[String] {
    let mut candidate: Option[String] = None;
    for (label, exs) in examples.iter() {
        for malformed in exs.iter() {
            match run_parse(mut cx, lid, u(malformed), false) {
                Ok(_) => {}
                Err(ut) => {
                    if not is_input_error(ut) or not ut.has_state or not e.has_state {
                        continue;
                    }
                    if ut.st_len != e.st_len or ut.st_pos != e.st_pos {
                        continue;
                    }
                    let both_tok = e.kind == "UnexpectedToken" and ut.kind == "UnexpectedToken";
                    if use_accepts and both_tok and not same_strs(ut.accepts, e.accepts) {
                        continue;
                    }
                    if both_tok and ut.token.ttype == e.token.ttype and same(ut.token.value, e.token.value) {
                        return Some(label.clone());
                    }
                    if candidate.is_none() {
                        candidate = Some(label.clone());
                    }
                }
            }
        }
    }
    candidate
}

fn same_strs(a: ref Vec[String], b: ref Vec[String]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

// ------------------------------------------------------- building a Lark

fn make_builders(rules: ref Vec[Rule], placeholders: bool) -> Vec[RuleBuilder] {
    let mut out: Vec[RuleBuilder] = Vec.new();
    for r in rules.iter() {
        let o = ref r.options;
        let name = match r.alias {
            Some(a) => a.clone(),
            None => match o.template_source {
                Some(t) => t.clone(),
                None => r.origin.clone(),
            },
        };
        let use_empty = placeholders and o.empty_indices.len() > 0;
        let n = r.expansion.len();
        let mut empty_counts: Vec[i64] = Vec.new();
        if use_empty {
            let mut run = 0;
            for b in o.empty_indices.iter() {
                if *b {
                    run += 1;
                } else {
                    empty_counts.push(run);
                    run = 0;
                }
            }
            empty_counts.push(run);
        } else {
            let mut k = 0;
            while k <= n {
                empty_counts.push(0);
                k += 1;
            }
        }
        let mut include: Vec[(i64, bool, i64)] = Vec.new();
        let mut nones = 0;
        let mut any_expand = false;
        let mut i = 0;
        while i < n {
            let s = ref r.expansion[i];
            nones += empty_counts[i];
            if o.keep_all or not (s.term and s.filter_out) {
                let expand = not s.term and s.name.starts_with("_");
                if expand {
                    any_expand = true;
                }
                include.push((i, expand, nones));
                nones = 0;
            }
            i += 1;
        }
        nones += empty_counts[n];
        let has_filter = use_empty or include.len() < n or any_expand;
        out.push(RuleBuilder {
            name: name,
            expand_single: o.expand1 and r.alias.is_none(),
            has_filter: has_filter,
            include: include,
            append_none: if use_empty { nones } else { 0 },
        });
    }
    out
}

fn lexer_key(names: ref Vec[String]) -> String {
    sorted_strs(names).join(" ")
}

// Lark.__init__ after the grammar is compiled: the LALR table, the tree
// builders and the lexers.
fn make_lark(cx: mut ref Ctx, terminals: own Vec[TermDef], rules: own Vec[Rule], ignore: own Vec[String], opts: ref LarkOpts) -> Result[i64, LErr] {
    let table = build_table(rules, opts.start)?;
    let builders = make_builders(rules, opts.maybe_placeholders);
    let mut lexers: Vec[BLexer] = Vec.new();
    let mut state_lexer: Vec[i64] = Vec.new();
    let mut all: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < terminals.len() {
        all.push(i);
        i += 1;
    }
    let mut root_lexer = 0;
    if opts.lexer_basic {
        lexers.push(make_basic_lexer(mut cx, terminals, all, ignore, true)?);
    } else {
        let mut keys: Vec[String] = Vec.new();
        let mut s = 0;
        while s < table.actions.len() {
            let mut names: Vec[String] = Vec.new();
            let mut which: Vec[i64] = Vec.new();
            let mut k = 0;
            while k < table.sym_names.len() {
                if table.actions[s][k] != 0 {
                    names.push(table.sym_names[k].clone());
                }
                k += 1;
            }
            for n in ignore.iter() {
                if not has_str(names, n) {
                    names.push(n.clone());
                }
            }
            if opts.postlex == 1 and not has_str(names, "_NL".to_string()) {
                names.push("_NL".to_string());
            }
            let mut ti = 0;
            while ti < terminals.len() {
                if has_str(names, terminals[ti].name) {
                    which.push(ti);
                }
                ti += 1;
            }
            let key = lexer_key(names);
            let mut found = -1;
            let mut q = 0;
            while q < keys.len() {
                if keys[q] == key {
                    found = q;
                }
                q += 1;
            }
            if found < 0 {
                lexers.push(make_basic_lexer(mut cx, terminals, which, ignore, true)?);
                keys.push(key);
                found = lexers.len() - 1;
            }
            state_lexer.push(found);
            s += 1;
        }
        lexers.push(make_basic_lexer(mut cx, terminals, all, ignore, false)?);
        root_lexer = lexers.len() - 1;
    }
    cx.larks.push(Some(LarkP {
        terminals: terminals,
        rules: rules,
        ignore: ignore,
        table: table,
        builders: builders,
        basic: opts.lexer_basic,
        lexers: lexers,
        state_lexer: state_lexer,
        root_lexer: root_lexer,
        postlex: opts.postlex,
    }));
    Ok(cx.larks.len() - 1)
}

// Lark(grammar_text, parser='lalr', ...)
fn build_lark(cx: mut ref Ctx, text: ref Vec[i64], opts: ref LarkOpts) -> Result[i64, LErr] {
    let mut b = new_builder(opts.import_paths);
    let none: Option[Vec[Layer]] = None;
    load_grammar(mut cx, mut b, text, "<string>".to_string(), none)?;
    let g = build_grammar(cx, b)?;
    let mut keep: Vec[String] = Vec.new();
    if opts.postlex == 1 {
        keep.push("_NL".to_string());
    }
    let (terminals, rules, ignore) = compile_grammar(mut cx, g, opts.start, keep)?;
    make_lark(mut cx, terminals, rules, ignore, opts)
}

fn default_opts() -> LarkOpts {
    LarkOpts { lexer_basic: false, maybe_placeholders: true, postlex: 0, start: "start".to_string(), import_paths: Vec.new() }
}

// _get_parser: lark's own grammar parser, from load_grammar's TERMINALS
// and RULES tables.
fn meta_parser(cx: mut ref Ctx) -> Result[i64, LErr] {
    if cx.meta >= 0 {
        return Ok(cx.meta);
    }
    let mut terminals: Vec[TermDef] = Vec.new();
    for (name, value) in meta_terminals().iter() {
        terminals.push(TermDef { name: name.clone(), pattern: pat_re(u(value), ""), priority: 0 });
    }
    let mut rules: Vec[Rule] = Vec.new();
    for (name0, alts) in meta_rules().iter() {
        let expand1 = name0.starts_with("?");
        let name = if expand1 { name0.substring(1, name0.len()) } else { name0.clone() };
        let mut order = 0;
        for alt in alts.iter() {
            let mut exp: Vec[Sym] = Vec.new();
            for w in alt.split(" ") {
                if w.len() == 0 {
                    continue;
                }
                let ws = w.to_string();
                if is_upper(ws) {
                    exp.push(terminal(ws, ws.starts_with("_")));
                } else {
                    exp.push(nonterminal(ws));
                }
            }
            let mut o = rule_options();
            o.expand1 = expand1;
            rules.push(Rule { origin: name.clone(), expansion: exp, order: order, alias: None, options: o });
            order += 1;
        }
    }
    let mut ignore: Vec[String] = Vec.new();
    ignore.push("WS".to_string());
    ignore.push("COMMENT".to_string());
    ignore.push("BACKSLASH".to_string());
    let mut opts = default_opts();
    opts.lexer_basic = true;
    opts.maybe_placeholders = false;
    let id = make_lark(mut cx, terminals, rules, ignore, opts)?;
    cx.meta = id;
    Ok(id)
}
// ------------------------------------------------------------- jobs

fn emit(s: ref String) {
    if s.ends_with("\n") {
        print(s);
    } else {
        println(s);
    }
}

fn read_text(path: ref String) -> Result[Vec[i64], String] {
    match read_file(path) {
        Some(t) => Ok(t),
        None => Err(f"cannot read {path}"),
    }
}

// str(x) for a tree child: a token's text, or None.
fn tk(n: ref N) -> String {
    match n {
        N.Tk(t) => to_string(t.value),
        _ => "None".to_string(),
    }
}

fn tk_v(n: ref N) -> Vec[i64] {
    match n {
        N.Tk(t) => t.value.clone(),
        _ => u("None"),
    }
}

fn is_nil(n: ref N) -> bool {
    match n {
        N.Nil => true,
        _ => false,
    }
}

fn kid(cx: ref Ctx, n: ref N, i: i64) -> N {
    let t = tree_id(n);
    cx.trees[t].children[i].clone()
}

fn data_of(cx: ref Ctx, n: ref N) -> String {
    let t = tree_id(n);
    if t < 0 {
        return String.new();
    }
    cx.trees[t].data.clone()
}

fn kids_of(cx: ref Ctx, n: ref N) -> Vec[N] {
    let t = tree_id(n);
    if t < 0 {
        return Vec.new();
    }
    cx.trees[t].children.clone()
}

// The children that are not placeholders.
fn present(v: ref Vec[N]) -> Vec[N] {
    let mut out: Vec[N] = Vec.new();
    for c in v.iter() {
        if not is_nil(c) {
            out.push(c.clone());
        }
    }
    out
}

// s[1:-1]
fn unquote(s: ref Vec[i64]) -> String {
    if s.len() < 2 {
        return String.new();
    }
    to_string(sl(s, 1, s.len() - 1))
}

// Lark(grammar, parser='lalr', import_paths=[data/grammars]), one per
// grammar and options, as the oracle caches them.
fn load(cx: mut ref Ctx, name: ref String, basic: bool, placeholders: bool) -> Result[i64, String] {
    let key = f"{name} {basic} {placeholders}";
    for (k, id) in cx.cache.iter() {
        if *k == key {
            return Ok(id);
        }
    }
    let path = f"data/grammars/{name}";
    let text = read_text(path)?;
    let mut opts = default_opts();
    opts.lexer_basic = basic;
    opts.maybe_placeholders = placeholders;
    opts.import_paths.push("data/grammars".to_string());
    if *name == "outline.lark" {
        opts.postlex = 1;
    }
    match build_lark(mut cx, text, opts) {
        Ok(id) => {
            cx.cache.push((key, id));
            Ok(id)
        }
        Err(e) => Err(f"cannot load {name}: {e.kind}: {e.msg}"),
    }
}

fn user_names(cx: ref Ctx, lid: i64, names: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for n in names.iter() {
        let mut s = n.clone();
        if lid >= 0 {
            if let Some(lp) = ref cx.larks[lid] {
                for t in lp.terminals.iter() {
                    if t.name == *n {
                        s = user_repr(t);
                        break;
                    }
                }
            }
        }
        out.push(s);
    }
    out.sort();
    out
}

// lark's own messages, with every set sorted.
fn fmt_error(cx: mut ref Ctx, e: ref LErr, text: ref Vec[i64], lid: i64) -> String {
    cx.errors += 1;
    if e.kind == "UnexpectedCharacters" {
        let mut cv: Vec[i64] = Vec.new();
        cv.push(e.ch);
        let mut msg = f"No terminal matches '{to_string(cv)}' in the current parser context, at line {e.line} col {e.col}";
        msg.push_str("\n\n");
        msg.push_str(to_string(get_context(text, e.pos)));
        if e.expected.len() > 0 {
            msg.push_str("Expected one of: \n\t* ");
            msg.push_str(user_names(cx, lid, e.expected).join("\n\t* "));
            msg.push_str("\n");
        }
        if e.history.len() > 0 {
            let mut reprs: Vec[String] = Vec.new();
            for t in e.history.iter() {
                reprs.push(token_repr(t));
            }
            msg.push_str(f"\nPrevious tokens: {reprs.join(", ")}\n");
        }
        return f"UnexpectedCharacters: {msg}";
    }
    if e.kind == "UnexpectedToken" {
        let exp = if e.has_accepts and e.accepts.len() > 0 { e.accepts.clone() } else { e.expected.clone() };
        let mut msg = f"Unexpected token {token_repr(e.token)} at line {pos_text(e.token.line)}, column {pos_text(e.token.col)}.\n";
        msg.push_str("Expected one of: \n\t* ");
        msg.push_str(user_names(cx, lid, exp).join("\n\t* "));
        msg.push_str("\n");
        if e.token.ttype != "$END" {
            msg.push_str(to_string(get_context(text, e.token.start)));
        }
        return f"UnexpectedToken: {msg}";
    }
    f"{e.kind}: {e.msg}\n"
}

fn parse_text(cx: mut ref Ctx, lid: i64, text: ref Vec[i64]) -> Result[N, LErr] {
    let r = run_parse(mut cx, lid, text.clone(), false)?;
    Ok(r.value)
}

// ---------------------------------------------------------------- grammar

fn job_grammar(cx: mut ref Ctx, name: ref String) -> Result[(), String] {
    let lid = load(mut cx, name, false, true)?;
    let lp = cx.larks[lid].take().unwrap();
    let mut keys: Vec[(i64, i64, i64, String)] = Vec.new();
    for t in lp.terminals.iter() {
        keys.push((0, 0, 0, t.name.clone()));
    }
    println(f"terminals: {lp.terminals.len()}");
    for i in sort_keys(keys) {
        let t = ref lp.terminals[i];
        let kind = if t.pattern.re { "re" } else { "str" };
        let flags = if t.pattern.flags.len() > 0 { f" flags={t.pattern.flags}" } else { String.new() };
        let (lo, hi) = pat_width(mut cx, t.pattern);
        let hi2 = if hi < 999 { hi } else { 999 };
        println(f"  {t.name} {kind} {repr_of(t.pattern.value)}{flags} prio={t.priority} width={lo}..{hi2}");
    }
    let ign = sorted_strs(lp.ignore);
    if ign.len() > 0 {
        println(f"ignore: {ign.join(" ")}");
    } else {
        println("ignore: -");
    }
    let mut rules: Vec[String] = Vec.new();
    for r in lp.rules.iter() {
        let o = ref r.options;
        let mut names: Vec[String] = Vec.new();
        for x in r.expansion.iter() {
            names.push(x.name.clone());
        }
        let exp = if names.len() > 0 { names.join(" ") } else { "<empty>".to_string() };
        let mut s = f"{r.origin} -> {exp}";
        if let Some(a) = ref r.alias {
            s.push_str(f" as {a}");
        }
        let mut extras: Vec[String] = Vec.new();
        if o.expand1 {
            extras.push("expand1".to_string());
        }
        if o.keep_all {
            extras.push("keep".to_string());
        }
        if let Some(p) = o.priority {
            extras.push(f"prio={p}");
        }
        if let Some(t) = ref o.template_source {
            extras.push(f"from={t}");
        }
        let mut any = false;
        let mut bits = String.new();
        for b in o.empty_indices.iter() {
            if *b {
                any = true;
                bits.push_str("1");
            } else {
                bits.push_str("0");
            }
        }
        if any {
            extras.push(f"empty={bits}");
        }
        if extras.len() > 0 {
            s.push_str(f"  [{extras.join(" ")}]");
        }
        rules.push(s);
    }
    rules.sort();
    println(f"rules: {rules.len()}");
    for s in rules.iter() {
        println(f"  {s}");
    }
    println(f"states: {lp.table.actions.len()}");
    cx.larks[lid] = Some(lp);
    Ok(())
}

// ---------------------------------------------------------------- calc

fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b;
    if a % b != 0 and ((a < 0) != (b < 0)) {
        return q - 1;
    }
    q
}

fn floor_mod(a: i64, b: i64) -> i64 {
    let r = a % b;
    if r != 0 and ((r < 0) != (b < 0)) {
        return r + b;
    }
    r
}

fn calc_eval(cx: ref Ctx, n: ref N, env: ref Map[String, i64]) -> Result[i64, String] {
    let t = match n {
        N.Tr(t) => t,
        N.Tk(k) => return Err(f"unexpected token {k.ttype}"),
        _ => return Err("unknown node None".to_string()),
    };
    let d = cx.trees[t].data.clone();
    let c = cx.trees[t].children.clone();
    if d == "number" {
        return Ok(int_of(tk_v(c[0])));
    }
    if d == "var" {
        let name = tk(c[0]);
        return match env.get(name) {
            Some(v) => Ok(*v),
            None => Err(f"undefined variable {name}"),
        };
    }
    if d == "neg" {
        return Ok(0 - calc_eval(cx, c[0], env)?);
    }
    if d == "add" or d == "sub" or d == "mul" or d == "div" or d == "mod" or d == "pow" {
        let a = calc_eval(cx, c[0], env)?;
        let b = calc_eval(cx, c[1], env)?;
        if d == "add" {
            return Ok(a + b);
        }
        if d == "sub" {
            return Ok(a - b);
        }
        if d == "mul" {
            return Ok(a * b);
        }
        if d == "div" or d == "mod" {
            if b == 0 {
                return Err("division by zero".to_string());
            }
            return Ok(if d == "div" { floor_div(a, b) } else { floor_mod(a, b) });
        }
        if b < 0 {
            return Err("negative exponent".to_string());
        }
        let mut r = 1;
        let mut k = 0;
        while k < b {
            r = r * a;
            k += 1;
        }
        return Ok(r);
    }
    if d == "call" {
        let fname = tk(c[0]);
        let mut args: Vec[i64] = Vec.new();
        let mut i = 1;
        while i < c.len() {
            if not is_nil(c[i]) {
                args.push(calc_eval(cx, c[i], env)?);
            }
            i += 1;
        }
        if fname == "max" and args.len() > 0 {
            let mut m = args[0];
            for a in args.iter() {
                if *a > m {
                    m = *a;
                }
            }
            return Ok(m);
        }
        if fname == "min" and args.len() > 0 {
            let mut m = args[0];
            for a in args.iter() {
                if *a < m {
                    m = *a;
                }
            }
            return Ok(m);
        }
        if fname == "abs" and args.len() == 1 {
            return Ok(if args[0] < 0 { 0 - args[0] } else { args[0] });
        }
        return Err(f"unknown function {fname}/{args.len()}");
    }
    Err(f"unknown node {d}")
}

fn job_calc(cx: mut ref Ctx, inp: ref String) -> Result[(), String] {
    let lid = load(mut cx, "calc.lark".to_string(), false, true)?;
    let mut env: Map[String, i64] = Map.new();
    let text = to_string(read_text(f"data/inputs/{inp}")?);
    for line0 in text.split("\n") {
        let line = us(line0.to_string());
        if is_blank(line) {
            continue;
        }
        println(f"calc> {line0}");
        let t = match parse_text(mut cx, lid, line) {
            Ok(t) => t,
            Err(e) => {
                emit(fmt_error(mut cx, e, line, lid));
                continue;
            }
        };
        if data_of(cx, t) == "assign_var" {
            match calc_eval(cx, kid(cx, t, 1), env) {
                Ok(v) => {
                    let name = tk(kid(cx, t, 0));
                    env.insert(name.clone(), v);
                    println(f"{name} = {v}");
                }
                Err(m) => {
                    cx.errors += 1;
                    println(f"error: {m}");
                }
            }
        } else {
            match calc_eval(cx, t, env) {
                Ok(v) => println(f"= {v}"),
                Err(m) => {
                    cx.errors += 1;
                    println(f"error: {m}");
                }
            }
        }
    }
    let mut names: Vec[String] = Vec.new();
    for (k, _) in env.iter() {
        names.push(k.clone());
    }
    names.sort();
    let mut parts: Vec[String] = Vec.new();
    for k in names.iter() {
        parts.push(f"{k}={env.get(k).unwrap()}");
    }
    println(f"vars: {parts.join(", ")}");
    Ok(())
}

// ---------------------------------------------------------------- json

fn json_errors() -> Vec[(String, Vec[String])] {
    let mut v: Vec[(String, Vec[String])] = Vec.new();
    v.push(("missing value".to_string(), strs1("{\"foo\": }")));
    let mut a = strs1("{\"foo\": ]}");
    a.push("{\"foor\": }}".to_string());
    a.push("{\"foo\": }".to_string());
    v.push(("missing opening".to_string(), a));
    let mut b = strs1("{\"foo\": [}");
    b.push("{".to_string());
    b.push("{\"a\": 1".to_string());
    b.push("[1".to_string());
    v.push(("missing closing".to_string(), b));
    let mut c = strs1("[1 2]");
    c.push("[false 1]".to_string());
    c.push("[\"b\" 1]".to_string());
    c.push("{\"a\":true 1:4}".to_string());
    c.push("{\"a\":1 1:4}".to_string());
    c.push("{\"a\":\"b\" 1:4}".to_string());
    v.push(("missing comma".to_string(), c));
    let mut d = strs1("[,]");
    d.push("[1,]".to_string());
    d.push("[1,2,]".to_string());
    d.push("{\"foo\":1,}".to_string());
    d.push("{\"foo\":false,\"bar\":true,}".to_string());
    v.push(("trailing comma".to_string(), d));
    let mut f = strs1("[1,,]");
    f.push("{\"a\": 1, \"b\": [1, 2,, 3]}".to_string());
    v.push(("double comma".to_string(), f));
    v
}

fn strs1(s: Str) -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    v.push(s.to_string());
    v
}

fn json_walk(cx: ref Ctx, n: ref N, path: ref String, lines: mut ref Vec[String]) {
    if let N.Tk(t) = n {
        lines.push(f"{path} = {to_string(t.value)}");
        return;
    }
    let d = data_of(cx, n);
    if d == "object" {
        let pairs = present(kids_of(cx, n));
        if pairs.len() == 0 {
            lines.push(f"{path} = {{}}");
        }
        for pair in pairs.iter() {
            let key = unquote(tk_v(kid(cx, kid(cx, pair, 0), 0)));
            json_walk(cx, kid(cx, pair, 1), f"{path}.{key}", mut lines);
        }
    } else if d == "array" {
        let items = present(kids_of(cx, n));
        if items.len() == 0 {
            lines.push(f"{path} = []");
        }
        let mut i = 0;
        while i < items.len() {
            json_walk(cx, items[i], f"{path}[{i}]", mut lines);
            i += 1;
        }
    } else if d == "string" or d == "number" {
        lines.push(f"{path} = {tk(kid(cx, n, 0))}");
    } else {
        lines.push(f"{path} = {d}");
    }
}

fn job_json(cx: mut ref Ctx, inp: ref String) -> Result[(), String] {
    let lid = load(mut cx, "json.lark".to_string(), false, true)?;
    let text = read_text(f"data/inputs/{inp}")?;
    let t = match parse_text(mut cx, lid, text) {
        Ok(t) => t,
        Err(e) => {
            emit(fmt_error(mut cx, e, text, lid));
            let label = match match_examples(mut cx, lid, e, json_errors(), true) {
                Some(l) => l,
                None => "unknown".to_string(),
            };
            println(f"classified: {label}");
            return Ok(());
        }
    };
    let mut lines: Vec[String] = Vec.new();
    json_walk(cx, t, "$".to_string(), mut lines);
    for ln in lines.iter() {
        println(ln);
    }
    println(f"subtrees: {iter_subtrees(cx, tree_id(t)).len()}");
    Ok(())
}

fn job_recover(cx: mut ref Ctx, inp: ref String) -> Result[(), String] {
    let lid = load(mut cx, "json.lark".to_string(), false, true)?;
    let text = read_text(f"data/inputs/{inp}")?;
    let mut skipped: Vec[LErr] = Vec.new();
    let r = parse_with(mut cx, lid, text.clone(), false, true, mut skipped);
    for e in skipped.iter() {
        println(f"skip {token_repr(e.token)} at line {e.token.line}, column {e.token.col}");
    }
    match r {
        Ok(res) => {
            cx.errors += skipped.len();
            emit(pretty(cx, tree_id(res.value)));
        }
        Err(e) => emit(fmt_error(mut cx, e, text, lid)),
    }
    Ok(())
}

// ---------------------------------------------------------------- conf

fn unit_of(s: ref String) -> i64 {
    if *s == "ms" {
        return 1;
    }
    if *s == "s" {
        return 1000;
    }
    if *s == "m" {
        return 60000;
    }
    if *s == "h" {
        return 3600000;
    }
    if *s == "d" {
        return 86400000;
    }
    if *s == "KB" {
        return 1024;
    }
    if *s == "MB" {
        return 1024 * 1024;
    }
    1024 * 1024 * 1024
}

fn conf_value(cx: ref Ctx, n: ref N) -> String {
    let d = data_of(cx, n);
    let c = kids_of(cx, n);
    if d == "string" {
        return tk(c[0]);
    }
    if d == "int" {
        return f"{int_of(tk_v(c[0]))}";
    }
    if d == "duration" or d == "size" {
        let s = tk_v(c[0]);
        let mut i = 0;
        while i < s.len() and s[i] >= 48 and s[i] <= 57 {
            i += 1;
        }
        let num = int_of(sl(s, 0, i)) * unit_of(to_string(tail(s, i)));
        let unit = if d == "duration" { "ms" } else { "B" };
        return f"{num}{unit} ({to_string(s)})";
    }
    if d == "true" or d == "false" {
        return d;
    }
    if d == "env" {
        return f"${{{unquote(tk_v(c[0]))}}}";
    }
    if d == "list" {
        let mut parts: Vec[String] = Vec.new();
        for x in present(c).iter() {
            parts.push(conf_value(cx, x));
        }
        return f"[{parts.join(", ")}]";
    }
    f"<{d}>"
}

fn conf_items(cx: mut ref Ctx, items: ref Vec[N], prefix: ref String, entries: mut ref Map[String, String], order: mut ref Vec[String]) {
    for it in items.iter() {
        let d = data_of(cx, it);
        let c = kids_of(cx, it);
        if d == "block" {
            let name = tk(c[0]);
            let mut p = f"{prefix}{name}";
            if not is_nil(c[1]) {
                p.push_str(f"[{unquote(tk_v(c[1]))}]");
            }
            p.push_str(".");
            let mut rest: Vec[N] = Vec.new();
            let mut i = 2;
            while i < c.len() {
                rest.push(c[i].clone());
                i += 1;
            }
            conf_items(mut cx, rest, p, mut entries, mut order);
        } else {
            let mut segs: Vec[String] = Vec.new();
            for x in kids_of(cx, c[0]).iter() {
                segs.push(tk(x));
            }
            let key = f"{prefix}{segs.join(".")}";
            let val = conf_value(cx, c[1]);
            if d == "append" {
                let old = match entries.get(key) {
                    Some(o) => o.clone(),
                    None => String.new(),
                };
                if not old.starts_with("[") {
                    cx.errors += 1;
                    println(f"error: += on {key}, which is not a list");
                    continue;
                }
                let sep = if old != "[]" { ", " } else { "" };
                let head = old.substring(0, old.len() - 1);
                entries.insert(key, f"{head}{sep}{val}]");
            } else {
                if entries.contains_key(key) {
                    println(f"note: {key} redefined");
                } else {
                    order.push(key.clone());
                }
                entries.insert(key, val);
            }
        }
    }
}

fn job_conf(cx: mut ref Ctx, inp: ref String) -> Result[(), String] {
    let lid = load(mut cx, "conf.lark".to_string(), false, true)?;
    let text = read_text(f"data/inputs/{inp}")?;
    let t = match parse_text(mut cx, lid, text) {
        Ok(t) => t,
        Err(e) => {
            emit(fmt_error(mut cx, e, text, lid));
            return Ok(());
        }
    };
    let mut entries: Map[String, String] = Map.new();
    let mut order: Vec[String] = Vec.new();
    conf_items(mut cx, kids_of(cx, t), String.new(), mut entries, mut order);
    for k in order.iter() {
        println(f"{k} = {entries.get(k).unwrap()}");
    }
    Ok(())
}

// ---------------------------------------------------------------- sql

fn add_name(cols: mut ref Vec[String], s: ref String) {
    if not has_str(cols, s) {
        cols.push(s.clone());
    }
}

fn sql_expr(cx: ref Ctx, n: ref N, cols: mut ref Vec[String]) -> String {
    if let N.Tk(t) = n {
        return to_string(t.value);
    }
    let d = data_of(cx, n);
    let c = kids_of(cx, n);
    if d == "ref" {
        let s = tk(c[0]);
        add_name(mut cols, s);
        return s;
    }
    if d == "qualified" {
        let s = f"{tk(c[0])}.{tk(c[1])}";
        add_name(mut cols, s);
        return s;
    }
    if d == "int" or d == "string" {
        return tk(c[0]);
    }
    if d == "func" {
        let mut args: Vec[String] = Vec.new();
        let mut i = 1;
        while i < c.len() {
            if not is_nil(c[i]) {
                args.push(sql_expr(cx, c[i], mut cols));
            }
            i += 1;
        }
        let inner = if args.len() > 0 { args.join(", ") } else { "*".to_string() };
        return f"{to_string(ascii_lower(tk_v(c[0])))}({inner})";
    }
    if d == "or_" or d == "and_" {
        let a = sql_expr(cx, c[0], mut cols);
        let b = sql_expr(cx, c[1], mut cols);
        let op = to_string(py_upper(sl(u(d), 0, d.len() - 1)));
        return f"({a} {op} {b})";
    }
    if d == "not_" {
        return f"(NOT {sql_expr(cx, c[0], mut cols)})";
    }
    if d == "compare" or d == "binop" {
        let a = sql_expr(cx, c[0], mut cols);
        let b = sql_expr(cx, c[2], mut cols);
        return f"({a} {tk(c[1])} {b})";
    }
    if d == "is_null" {
        return f"({sql_expr(cx, c[0], mut cols)} IS NULL)";
    }
    if d == "in_list" {
        let a = sql_expr(cx, c[0], mut cols);
        let mut parts: Vec[String] = Vec.new();
        let mut i = 1;
        while i < c.len() {
            parts.push(sql_expr(cx, c[i], mut cols));
            i += 1;
        }
        return f"({a} IN [{parts.join(", ")}])";
    }
    f"<{d}>"
}

fn sql_source(cx: ref Ctx, n: ref N) -> String {
    let c = kids_of(cx, n);
    if is_nil(c[1]) {
        return tk(c[0]);
    }
    f"{tk(c[0])} {tk(c[1])}"
}

fn job_sql(cx: mut ref Ctx, inp: ref String) -> Result[(), String] {
    let lid = load(mut cx, "sql.lark".to_string(), false, true)?;
    let text = read_text(f"data/inputs/{inp}")?;
    let t = match parse_text(mut cx, lid, text) {
        Ok(t) => t,
        Err(e) => {
            emit(fmt_error(mut cx, e, text, lid));
            return Ok(());
        }
    };
    let sels = present(kids_of(cx, t));
    let mut qi = 0;
    while qi < sels.len() {
        let mut cols: Vec[String] = Vec.new();
        let c = kids_of(cx, sels[qi]);
        let distinct = if is_nil(c[0]) { "" } else { " (distinct)" };
        println(f"query {qi + 1}{distinct}");
        if data_of(cx, c[1]) == "all_columns" {
            println("  columns: *");
        } else {
            let mut parts: Vec[String] = Vec.new();
            for col in kids_of(cx, c[1]).iter() {
                let mut e = sql_expr(cx, kid(cx, col, 0), mut cols);
                let alias = kid(cx, col, 1);
                if not is_nil(alias) {
                    e.push_str(f" as {tk(alias)}");
                }
                parts.push(e);
            }
            println(f"  columns: {parts.join(", ")}");
        }
        println(f"  from: {sql_source(cx, c[2])}");
        let mut i = 3;
        while i < c.len() {
            let x = ref c[i];
            i += 1;
            if is_nil(x) {
                continue;
            }
            let d = data_of(cx, x);
            let xc = kids_of(cx, x);
            if d == "join" {
                let kind = if is_nil(xc[0]) { "INNER".to_string() } else { to_string(py_upper(tk_v(xc[0]))) };
                let on = sql_expr(cx, xc[2], mut cols);
                println(f"  join: {kind} {sql_source(cx, xc[1])} on {on}");
            } else if d == "where" {
                println(f"  where: {sql_expr(cx, xc[0], mut cols)}");
            } else if d == "group" {
                let mut parts: Vec[String] = Vec.new();
                for e in xc.iter() {
                    parts.push(sql_expr(cx, e, mut cols));
                }
                println(f"  group: {parts.join(", ")}");
            } else if d == "order" {
                let mut parts: Vec[String] = Vec.new();
                for o in xc.iter() {
                    let s = sql_expr(cx, kid(cx, o, 0), mut cols);
                    let dir = kid(cx, o, 1);
                    let ds = if is_nil(dir) { "ASC".to_string() } else { to_string(py_upper(tk_v(dir))) };
                    parts.push(f"{s} {ds}");
                }
                println(f"  order: {parts.join(", ")}");
            } else if d == "limit" {
                println(f"  limit: {tk(xc[0])}");
            }
        }
        cols.sort();
        println(f"  names: {cols.join(", ")}");
        qi += 1;
    }
    Ok(())
}

// ---------------------------------------------------------------- outline

struct OCount {
    items: i64,
    done: i64,
    tags: Map[String, i64],
}

fn outline_walk(cx: ref Ctx, item: ref N, depth: i64, oc: mut ref OCount) {
    oc.items += 1;
    let c = kids_of(cx, item);
    let mut words: Vec[String] = Vec.new();
    let mut done = false;
    for tok in kids_of(cx, c[0]).iter() {
        if let N.Tk(t) = tok {
            let s = to_string(t.value);
            if t.ttype == "DONE" {
                done = true;
            } else if t.ttype == "TAG" {
                let n = match oc.tags.get(s) {
                    Some(k) => *k,
                    None => 0,
                };
                oc.tags.insert(s.clone(), n + 1);
                words.push(s);
            } else {
                words.push(s);
            }
        }
    }
    if done {
        oc.done += 1;
    }
    let mut kids: Vec[N] = Vec.new();
    let mut i = 1;
    while i < c.len() {
        if not is_nil(c[i]) {
            kids.push(c[i].clone());
        }
        i += 1;
    }
    let mut pad = String.new();
    let mut k = 0;
    while k < depth {
        pad.push_str("  ");
        k += 1;
    }
    let mark = if done { "[x]" } else { "[ ]" };
    let count = if kids.len() > 0 { f" ({kids.len()})" } else { String.new() };
    println(f"{pad}{mark} {words.join(" ")}{count}");
    for kd in kids.iter() {
        outline_walk(cx, kd, depth + 1, mut oc);
    }
}

fn job_outline(cx: mut ref Ctx, inp: ref String) -> Result[(), String] {
    let lid = load(mut cx, "outline.lark".to_string(), false, true)?;
    let text = read_text(f"data/inputs/{inp}")?;
    let t = match parse_text(mut cx, lid, text) {
        Ok(t) => t,
        Err(e) => {
            emit(fmt_error(mut cx, e, text, lid));
            return Ok(());
        }
    };
    let mut oc = OCount { items: 0, done: 0, tags: Map.new() };
    let roots = if data_of(cx, t) == "item" {
        let mut v: Vec[N] = Vec.new();
        v.push(t.clone());
        v
    } else {
        kids_of(cx, t)
    };
    for r in roots.iter() {
        outline_walk(cx, r, 0, mut oc);
    }
    println(f"items: {oc.items}, done: {oc.done}");
    let mut names: Vec[String] = Vec.new();
    for (k, _) in oc.tags.iter() {
        names.push(k.clone());
    }
    names.sort();
    let mut parts: Vec[String] = Vec.new();
    for k in names.iter() {
        parts.push(f"{k}={oc.tags.get(k).unwrap()}");
    }
    println(f"tags: {parts.join(", ")}");
    Ok(())
}

// ---------------------------------------------------------------- generic

fn job_parse(cx: mut ref Ctx, gname: ref String, inp: ref String, opts: ref Vec[String]) -> Result[(), String] {
    let mut basic = false;
    let mut placeholders = true;
    for o in opts.iter() {
        if *o == "lexer=basic" {
            basic = true;
        } else if *o == "maybe_placeholders=false" {
            placeholders = false;
        }
    }
    let lid = load(mut cx, gname, basic, placeholders)?;
    let text = read_text(f"data/inputs/{inp}")?;
    let t = match parse_text(mut cx, lid, text) {
        Ok(t) => tree_id(t),
        Err(e) => {
            emit(fmt_error(mut cx, e, text, lid));
            return Ok(());
        }
    };
    emit(pretty(cx, t));
    let mut toks: Vec[Token] = Vec.new();
    scan_tokens(cx, t, mut toks);
    println(f"tokens: {toks.len()}, subtrees: {iter_subtrees(cx, t).len()}");
    Ok(())
}

// Lark.lex: the basic lexer over every terminal.
fn lex_all(cx: mut ref Ctx, lid: i64, text: ref Vec[i64]) -> Result[Vec[Token], LErr] {
    let lp = cx.larks[lid].take().unwrap();
    let mut ls = new_lex_state(text.clone());
    let mut toks: Vec[Token] = Vec.new();
    let mut res: Result[Vec[Token], LErr] = Ok(Vec.new());
    loop {
        match next_token(mut cx, lp, 0, mut ls) {
            Ok(Some(t)) => toks.push(t),
            Ok(None) => {
                res = Ok(toks);
                break;
            }
            Err(e) => {
                res = Err(e);
                break;
            }
        }
    }
    cx.larks[lid] = Some(lp);
    res
}

fn job_lex(cx: mut ref Ctx, gname: ref String, inp: ref String) -> Result[(), String] {
    let lid = load(mut cx, gname, true, true)?;
    let text = to_string(read_text(f"data/inputs/{inp}")?);
    for line0 in text.split("\n") {
        let line = us(line0.to_string());
        if is_blank(line) {
            continue;
        }
        match lex_all(mut cx, lid, line) {
            Ok(toks) => {
                let mut parts: Vec[String] = Vec.new();
                for t in toks.iter() {
                    parts.push(f"{t.ttype}@{t.col}={to_string(t.value)}");
                }
                println(f"{line0}: {parts.join(" ")}");
            }
            Err(e) => {
                println(f"{line0}: error");
                emit(fmt_error(mut cx, e, line, lid));
            }
        }
    }
    Ok(())
}

fn job_complete(cx: mut ref Ctx, gname: ref String, text: ref String) -> Result[(), String] {
    let lid = load(mut cx, gname, false, true)?;
    let tv = us(text);
    let r = match run_parse(mut cx, lid, tv.clone(), true) {
        Ok(r) => r,
        Err(e) => {
            emit(fmt_error(mut cx, e, tv, lid));
            return Ok(());
        }
    };
    println(f"input: {repr_of(tv)} ({r.ntokens} tokens)");
    let mut acc: Vec[String] = Vec.new();
    if let Some(lp) = ref cx.larks[lid] {
        acc = accepts_of(lp.table, r.stack);
    }
    acc.sort();
    println(f"accepts: {acc.join(" ")}");
    println(f"as written: {user_names(cx, lid, acc).join(" ")}");
    Ok(())
}

// Sorts each run of tab-dash lines: lark builds them from a set.
fn sort_dashes(msg: ref String) -> String {
    let mut res: Vec[String] = Vec.new();
    let mut run: Vec[String] = Vec.new();
    for ln in msg.split("\n") {
        if ln.starts_with("\t- ") {
            run.push(ln.to_string());
            continue;
        }
        run.sort();
        for r in run.iter() {
            res.push(r.clone());
        }
        run = Vec.new();
        res.push(ln.to_string());
    }
    run.sort();
    for r in run.iter() {
        res.push(r.clone());
    }
    res.join("\n")
}

fn job_badgrammars(cx: mut ref Ctx) -> Result[(), String] {
    let all = to_string(read_text("data/bad_grammars.txt".to_string())?);
    let blocks: Vec[String] = all.split("%%% ").map(|b| b.to_string()).collect();
    let mut bi = 1;
    while bi < blocks.len() {
        let b = ref blocks[bi];
        bi += 1;
        let (title, body) = match b.split_once("\n") {
            Some((t, r)) => (t.to_string(), r.to_string()),
            None => (b.clone(), String.new()),
        };
        println(f"-- {title}");
        let mut opts = default_opts();
        opts.import_paths.push("data/grammars".to_string());
        let bv = us(body);
        match build_lark(mut cx, bv, opts) {
            Ok(_) => println("ok"),
            Err(e) => {
                if e.kind == "GrammarError" {
                    cx.errors += 1;
                    emit(f"GrammarError: {sort_dashes(e.msg)}");
                } else {
                    emit(fmt_error(mut cx, e, bv, -1));
                }
            }
        }
    }
    Ok(())
}

fn list_sorted(dir: ref String) -> Vec[String] {
    let mut names = match fs.read_dir(dir.clone()) {
        Ok(n) => n,
        Err(_) => Vec.new(),
    };
    names.sort();
    names
}

fn job_meta(cx: mut ref Ctx) -> Result[(), String] {
    let text = read_text("data/lark_grammars/lark.lark".to_string())?;
    let meta = match build_lark(mut cx, text, default_opts()) {
        Ok(id) => id,
        Err(e) => return Err(f"cannot load lark.lark: {e.kind}: {e.msg}"),
    };
    let mut files: Vec[String] = Vec.new();
    for f in list_sorted("data/grammars".to_string()).iter() {
        files.push(f"data/grammars/{f}");
    }
    for f in list_sorted("data/lark_grammars".to_string()).iter() {
        files.push(f"data/lark_grammars/{f}");
    }
    for path in files.iter() {
        let name = match path.rsplit_once("/") {
            Some((_, n)) => n.to_string(),
            None => path.clone(),
        };
        let text = read_text(path)?;
        let t = match parse_text(mut cx, meta, text) {
            Ok(t) => t,
            Err(e) => {
                println(f"{name}: parse error");
                emit(fmt_error(mut cx, e, text, meta));
                continue;
            }
        };
        let mut kinds: Map[String, i64] = Map.new();
        for c in kids_of(cx, t).iter() {
            let d = data_of(cx, c);
            let n = match kinds.get(d) {
                Some(k) => *k,
                None => 0,
            };
            kinds.insert(d, n + 1);
        }
        let mut names: Vec[String] = Vec.new();
        for (k, _) in kinds.iter() {
            names.push(k.clone());
        }
        names.sort();
        let mut parts: Vec[String] = Vec.new();
        for k in names.iter() {
            parts.push(f"{k}={kinds.get(k).unwrap()}");
        }
        println(f"{name}: {parts.join(", ")}");
    }
    Ok(())
}

fn run(cx: mut ref Ctx) -> Result[(), String] {
    let text = to_string(read_text("data/jobs.txt".to_string())?);
    let mut jobs = 0;
    for raw in text.split("\n") {
        if raw.len() == 0 or raw.starts_with("#") {
            continue;
        }
        let parts: Vec[String] = raw.split(" ").map(|w| w.to_string()).collect();
        let cmd = parts[0].clone();
        jobs += 1;
        println(f"== {raw}");
        if cmd == "grammar" {
            job_grammar(mut cx, parts[1])?;
        } else if cmd == "calc" {
            job_calc(mut cx, parts[1])?;
        } else if cmd == "json" {
            job_json(mut cx, parts[1])?;
        } else if cmd == "recover" {
            job_recover(mut cx, parts[1])?;
        } else if cmd == "conf" {
            job_conf(mut cx, parts[1])?;
        } else if cmd == "sql" {
            job_sql(mut cx, parts[1])?;
        } else if cmd == "outline" {
            job_outline(mut cx, parts[1])?;
        } else if cmd == "parse" {
            let mut opts: Vec[String] = Vec.new();
            let mut i = 3;
            while i < parts.len() {
                opts.push(parts[i].clone());
                i += 1;
            }
            job_parse(mut cx, parts[1], parts[2], opts)?;
        } else if cmd == "lex" {
            job_lex(mut cx, parts[1], parts[2])?;
        } else if cmd == "complete" {
            // raw.split(" ", 2)[2]
            let rest = raw.substring(cmd.len() + parts[1].len() + 2, raw.len());
            job_complete(mut cx, parts[1], rest.to_string())?;
        } else if cmd == "badgrammars" {
            job_badgrammars(mut cx)?;
        } else if cmd == "meta" {
            job_meta(mut cx)?;
        } else if cmd == "summary" {
            println(f"jobs: {jobs}, errors reported: {cx.errors}");
        } else {
            println(f"unknown job {cmd}");
        }
    }
    Ok(())
}
// ------------------------------------------------------------ tables

// lark's grammar of grammars, as gen_kara.py read it from
// lark/load_grammar.py.
fn meta_terminals() -> Vec[(String, String)] {
    let mut v: Vec[(String, String)] = Vec.new();
    v.push(("_LPAR".to_string(), "\\(".to_string()));
    v.push(("_RPAR".to_string(), "\\)".to_string()));
    v.push(("_LBRA".to_string(), "\\[".to_string()));
    v.push(("_RBRA".to_string(), "\\]".to_string()));
    v.push(("_LBRACE".to_string(), "\\{".to_string()));
    v.push(("_RBRACE".to_string(), "\\}".to_string()));
    v.push(("OP".to_string(), "[+*]|[?](?![a-z_])".to_string()));
    v.push(("_COLON".to_string(), ":".to_string()));
    v.push(("_COMMA".to_string(), ",".to_string()));
    v.push(("_OR".to_string(), "\\|".to_string()));
    v.push(("_DOT".to_string(), "\\.(?!\\.)".to_string()));
    v.push(("_DOTDOT".to_string(), "\\.\\.".to_string()));
    v.push(("TILDE".to_string(), "~".to_string()));
    v.push(("RULE_MODIFIERS".to_string(), "(!|![?]?|[?]!?)(?=[_a-z])".to_string()));
    v.push(("RULE".to_string(), "_?[a-z][_a-z0-9]*".to_string()));
    v.push(("TERMINAL".to_string(), "_?[A-Z][_A-Z0-9]*".to_string()));
    v.push(("STRING".to_string(), "\"(\\\\\"|\\\\\\\\|[^\"\\n])*?\"i?".to_string()));
    v.push(("REGEXP".to_string(), "/(?!/)(\\\\/|\\\\\\\\|[^/])*?/[imslux]*".to_string()));
    v.push(("_NL".to_string(), "(\\r?\\n)+\\s*".to_string()));
    v.push(("_NL_OR".to_string(), "(\\r?\\n)+\\s*\\|".to_string()));
    v.push(("WS".to_string(), "[ \\t]+".to_string()));
    v.push(("COMMENT".to_string(), "\\s*//[^\\n]*|\\s*#[^\\n]*".to_string()));
    v.push(("BACKSLASH".to_string(), "\\\\[ ]*\\n".to_string()));
    v.push(("_TO".to_string(), "->".to_string()));
    v.push(("_IGNORE".to_string(), "%ignore".to_string()));
    v.push(("_OVERRIDE".to_string(), "%override".to_string()));
    v.push(("_DECLARE".to_string(), "%declare".to_string()));
    v.push(("_EXTEND".to_string(), "%extend".to_string()));
    v.push(("_IMPORT".to_string(), "%import".to_string()));
    v.push(("NUMBER".to_string(), "[+-]?\\d+".to_string()));
    v
}

