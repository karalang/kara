    v.push(("_name_list".to_string(), a));
    let mut a: Vec[String] = Vec.new();
    a.push("symbol".to_string());
    a.push("_declare_args symbol".to_string());
    v.push(("_declare_args".to_string(), a));
    let mut a: Vec[String] = Vec.new();
    a.push("REGEXP".to_string());
    a.push("STRING".to_string());
    v.push(("literal".to_string(), a));
    v
}

// _TERMINAL_NAMES: the names of punctuation terminals.
fn terminal_names() -> Vec[(String, String)] {
    let mut v: Vec[(String, String)] = Vec.new();
    v.push((".".to_string(), "DOT".to_string()));
    v.push((",".to_string(), "COMMA".to_string()));
    v.push((":".to_string(), "COLON".to_string()));
    v.push((";".to_string(), "SEMICOLON".to_string()));
    v.push(("+".to_string(), "PLUS".to_string()));
    v.push(("-".to_string(), "MINUS".to_string()));
    v.push(("*".to_string(), "STAR".to_string()));
    v.push(("/".to_string(), "SLASH".to_string()));
    v.push(("\\".to_string(), "BACKSLASH".to_string()));
    v.push(("|".to_string(), "VBAR".to_string()));
    v.push(("?".to_string(), "QMARK".to_string()));
    v.push(("!".to_string(), "BANG".to_string()));
    v.push(("@".to_string(), "AT".to_string()));
    v.push(("#".to_string(), "HASH".to_string()));
    v.push(("$".to_string(), "DOLLAR".to_string()));
    v.push(("%".to_string(), "PERCENT".to_string()));
    v.push(("^".to_string(), "CIRCUMFLEX".to_string()));
    v.push(("&".to_string(), "AMPERSAND".to_string()));
    v.push(("_".to_string(), "UNDERSCORE".to_string()));
    v.push(("<".to_string(), "LESSTHAN".to_string()));
    v.push((">".to_string(), "MORETHAN".to_string()));
    v.push(("=".to_string(), "EQUAL".to_string()));
    v.push(("\"".to_string(), "DBLQUOTE".to_string()));
    v.push(("'".to_string(), "QUOTE".to_string()));
    v.push(("`".to_string(), "BACKQUOTE".to_string()));
    v.push(("~".to_string(), "TILDE".to_string()));
    v.push(("(".to_string(), "LPAR".to_string()));
    v.push((")".to_string(), "RPAR".to_string()));
    v.push(("{".to_string(), "LBRACE".to_string()));
    v.push(("}".to_string(), "RBRACE".to_string()));
    v.push(("[".to_string(), "LSQB".to_string()));
    v.push(("]".to_string(), "RSQB".to_string()));
    v.push(("\n".to_string(), "NEWLINE".to_string()));
    v.push(("\r\n".to_string(), "CRLF".to_string()));
    v.push(("\t".to_string(), "TAB".to_string()));
    v.push((" ".to_string(), "SPACE".to_string()));
    v
}

fn grammar_error_examples() -> Vec[(String, Vec[String])] {
    let mut v: Vec[(String, Vec[String])] = Vec.new();
    let mut a: Vec[String] = Vec.new();
    a.push("a: 1\n".to_string());
    v.push(("Incorrect type of value".to_string(), a));
    let mut a: Vec[String] = Vec.new();
    a.push("a: (\n".to_string());
    v.push(("Unclosed parenthesis".to_string(), a));
    let mut a: Vec[String] = Vec.new();
    a.push("a: )\n".to_string());
    a.push("a: [)\n".to_string());
    a.push("a: (]\n".to_string());
    v.push(("Unmatched closing parenthesis".to_string(), a));
    let mut a: Vec[String] = Vec.new();
    a.push("a\n".to_string());
    a.push("A\n".to_string());
    a.push("a->\n".to_string());
    a.push("A->\n".to_string());
    a.push("a A\n".to_string());
    v.push(("Expecting rule or terminal definition (missing colon)".to_string(), a));
    let mut a: Vec[String] = Vec.new();
    a.push("Aa:\n".to_string());
    v.push(("Illegal name for rules or terminals".to_string(), a));
    let mut a: Vec[String] = Vec.new();
    a.push("a: -> \"a\"\n".to_string());
    v.push(("Alias expects lowercase name".to_string(), a));
    let mut a: Vec[String] = Vec.new();
    a.push("a::\n".to_string());
    a.push("a: b:\n".to_string());
    a.push("a: B:\n".to_string());
    a.push("a: \"a\":\n".to_string());
    v.push(("Unexpected colon".to_string(), a));
    let mut a: Vec[String] = Vec.new();
    a.push("a: b??".to_string());
    a.push("a: b(?)".to_string());
    a.push("a:+\n".to_string());
    a.push("a:?\n".to_string());
    a.push("a:*\n".to_string());
    a.push("a:|*\n".to_string());
    v.push(("Misplaced operator".to_string(), a));
    let mut a: Vec[String] = Vec.new();
    a.push("a:a\n()\n".to_string());
    v.push(("Expecting option (\"|\") or a new rule or terminal definition".to_string(), a));
    let mut a: Vec[String] = Vec.new();
    a.push("A.B\n".to_string());
    v.push(("Terminal names cannot contain dots".to_string(), a));
    let mut a: Vec[String] = Vec.new();
    a.push("\"a\"\n".to_string());
    v.push(("Expecting rule or terminal definition".to_string(), a));
    let mut a: Vec[String] = Vec.new();
    a.push("%import \"a\"\n".to_string());
    v.push(("%import expects a name".to_string(), a));
    let mut a: Vec[String] = Vec.new();
    a.push("%ignore %import\n".to_string());
    v.push(("%ignore expects a value".to_string(), a));
    v
}
// ------------------------------------------------------------ data

// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    data_part_3(mut v);
    data_part_4(mut v);
    data_part_5(mut v);
    v
}

fn data_part_0(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("%%% missing colon\n");
    t.push_str("a\n");
    t.push_str("%%% incorrect value type\n");
    t.push_str("a: 1\n");
    t.push_str("%%% unclosed parenthesis\n");
    t.push_str("a: (\"x\"\n");
    t.push_str("%%% unmatched paren\n");
    t.push_str("a: \"x\")\n");
    t.push_str("%%% bad rule name\n");
    t.push_str("Aa: \"x\"\n");
    t.push_str("%%% alias needs lowercase\n");
    t.push_str("a: \"x\" -> \"y\"\n");
    t.push_str("%%% unexpected colon\n");
    t.push_str("a: b:\n");
    t.push_str("%%% misplaced operator\n");
    t.push_str("a: b??\n");
    t.push_str("%%% option or new rule\n");
    t.push_str("a: \"a\"\n");
    t.push_str("()\n");
    t.push_str("%%% dotted terminal\n");
    t.push_str("A.B\n");
    t.push_str("%%% literal first\n");
    t.push_str("\"a\"\n");
    t.push_str("%%% import a string\n");
    t.push_str("%import \"a\"\n");
    t.push_str("%%% ignore an import\n");
    t.push_str("%ignore %import\n");
    t.push_str("%%% undefined rule\n");
    t.push_str("start: a b\n");
    t.push_str("a: \"x\"\n");
    t.push_str("%%% undefined terminal\n");
    t.push_str("start: X\n");
    t.push_str("%%% defined twice\n");
    t.push_str("start: \"a\"\n");
    t.push_str("start: \"b\"\n");
    t.push_str("%%% empty terminal\n");
    t.push_str("start: A\n");
    t.push_str("A: \"\"\n");
    t.push_str("%%% recursive terminal\n");
    t.push_str("start: A\n");
    t.push_str("A: \"a\" A\n");
    t.push_str("%%% rule in terminal\n");
    t.push_str("start: A\n");
    t.push_str("A: \"a\" b\n");
    t.push_str("b: \"b\"\n");
    t.push_str("%%% alias in terminal\n");
    t.push_str("start: A\n");
    t.push_str("A: \"a\" -> x\n");
    t.push_str("%%% inlined alias\n");
    t.push_str("start: _a\n");
    t.push_str("_a: \"x\" -> y\n");
    t.push_str("%%% unknown ignore\n");
    t.push_str("start: \"a\"\n");
    t.push_str("%ignore WS\n");
    t.push_str("%%% double underscore\n");
    t.push_str("start: __x\n");
    t.push_str("__x: \"a\"\n");
    t.push_str("%%% bad range\n");
    t.push_str("start: \"a\"~3..1\n");
    t.push_str("%%% override missing\n");
    t.push_str("%override start: \"a\"\n");
    t.push_str("%%% extend missing\n");
    t.push_str("%extend start: \"a\"\n");
    t.push_str("%%% template arity\n");
    t.push_str("start: t{\"a\"}\n");
    t.push_str("t{x, y}: x y\n");
    t.push_str("%%% template undefined\n");
    t.push_str("start: u{\"a\"}\n");
    t.push_str("%%% reduce reduce\n");
    t.push_str("start: a | b\n");
    t.push_str("a: \"x\"\n");
    t.push_str("b: \"x\"\n");
    t.push_str("%%% newline in string\n");
    t.push_str("start: \"a\n");
    t.push_str("b\"\n");
    t.push_str("%%% zero width\n");
    t.push_str("start: A\n");
    t.push_str("A: /a*/\n");
    t.push_str("%%% bad escape\n");
    t.push_str("start: \"\\\"\n");
    t.push_str("%%% inline expand1\n");
    t.push_str("start: _x\n");
    t.push_str("?_x: \"a\"\n");
    t.push_str("%%% nothing imported\n");
    t.push_str("%import common\n");
    t.push_str("start: \"a\"\n");
    t.push_str("%%% ok after all\n");
    t.push_str("start: \"a\"+ B?\n");
    t.push_str("B: \"b\"\n");
    v.push(DataFile { path: "bad_grammars.txt".to_string(), body: t });
    let mut t = String.new();
    t.push_str("start: expr\n");
    t.push_str("?expr: atom\n");
    t.push_str("     | expr \"+\" atom -> plus\n");
    t.push_str("atom: NUMBER\n");
    t.push_str("NUMBER: /\\d+/\n");
    t.push_str("WS: \" \"\n");
    v.push(DataFile { path: "grammars/base.lark".to_string(), body: t });
    let mut t = String.new();
    t.push_str("// a calculator with variables, after lark's calc example\n");
    t.push_str("?start: sum\n");
    t.push_str("      | NAME \"=\" sum    -> assign_var\n");
    t.push_str("\n");
    t.push_str("?sum: product\n");
    t.push_str("    | sum \"+\" product   -> add\n");
    t.push_str("    | sum \"-\" product   -> sub\n");
    t.push_str("\n");
    t.push_str("?product: power\n");
    t.push_str("    | product \"*\" power  -> mul\n");
    t.push_str("    | product \"/\" power  -> div\n");
    t.push_str("    | product \"%\" power  -> mod\n");
    t.push_str("\n");
    t.push_str("?power: atom\n");
    t.push_str("    | atom \"**\" power    -> pow\n");
    t.push_str("\n");
    t.push_str("?atom: INT              -> number\n");
    t.push_str("     | \"-\" atom         -> neg\n");
    t.push_str("     | NAME             -> var\n");
    t.push_str("     | NAME \"(\" [sum (\",\" sum)*] \")\" -> call\n");
    t.push_str("     | \"(\" sum \")\"\n");
    t.push_str("\n");
    t.push_str("%import common.CNAME -> NAME\n");
    t.push_str("%import common.INT\n");
    t.push_str("%import common.WS_INLINE\n");
    t.push_str("%ignore WS_INLINE\n");
    v.push(DataFile { path: "grammars/calc.lark".to_string(), body: t });
    let mut t = String.new();
    t.push_str("// a service configuration language: blocks, settings, lists, durations\n");
    t.push_str("start: _NL* (item _NL*)*\n");
    t.push_str("\n");
    t.push_str("?item: block\n");
    t.push_str("     | setting\n");
    t.push_str("\n");
    t.push_str("block: NAME [STRING] \"{\" _NL* (item _NL*)* \"}\" _NL\n");
    t.push_str("setting: key \"=\" value _NL\n");
    t.push_str("         | key \"+=\" value _NL -> append\n");
    t.push_str("key: NAME (\".\" NAME)*\n");
    t.push_str("\n");
    t.push_str("?value: STRING          -> string\n");
    t.push_str("      | INT             -> int\n");
    t.push_str("      | DURATION        -> duration\n");
    t.push_str("      | SIZE            -> size\n");
    t.push_str("      | \"true\"          -> true\n");
    t.push_str("      | \"false\"         -> false\n");
    t.push_str("      | \"[\" [value (\",\" value)* [\",\"]] \"]\" -> list\n");
    t.push_str("      | \"env\" \"(\" STRING \")\" -> env\n");
    t.push_str("\n");
    t.push_str("DURATION.2: INT (\"ms\" | \"s\" | \"m\" | \"h\" | \"d\")\n");
    t.push_str("SIZE.2: INT (\"KB\" | \"MB\" | \"GB\")\n");
    t.push_str("NAME: /[a-z_][a-z0-9_-]*/\n");
    t.push_str("STRING: \"\\\"\" /[^\"\\n]*/ \"\\\"\"\n");
    t.push_str("COMMENT: /#[^\\n]*/\n");
    t.push_str("_NL: /\\r?\\n/\n");
    t.push_str("\n");
    t.push_str("%import common.INT\n");
    t.push_str("%import common.WS_INLINE\n");
    t.push_str("%ignore WS_INLINE\n");
    t.push_str("%ignore COMMENT\n");
    v.push(DataFile { path: "grammars/conf.lark".to_string(), body: t });
    let mut t = String.new();
    t.push_str("// templates, overrides, extends, imports, priorities and repeats\n");
    t.push_str("%import .shared (ID, sep_list, _semi)\n");
    t.push_str("%import .shared.QUOTED -> TEXT\n");
    t.push_str("%import common.WS\n");
    t.push_str("%ignore WS\n");
    t.push_str("\n");
    t.push_str("start: stmt*\n");
    t.push_str("?stmt: decl _semi\n");
    t.push_str("     | call _semi\n");
    t.push_str("     | tagged _semi\n");
    t.push_str("     | code _semi\n");
    t.push_str("\n");
    t.push_str("decl: \"let\" ID \"=\" value\n");
    t.push_str("call: ID \"(\" [sep_list{value, \",\"}] \")\"\n");
    t.push_str("!tagged: \"#\" ID (\".\" ID)~0..2\n");
    t.push_str("code: HEX~2..4 -> hex_code\n");
    t.push_str("    | \"%\" DIGITS\n");
    t.push_str("\n");
    t.push_str("?value: TEXT | NUMBER | ID | list\n");
    t.push_str("list: \"[\" sep_list{value, \";\"}? \"]\"\n");
    t.push_str("\n");
    t.push_str("NUMBER: /-?\\d+/\n");
    t.push_str("HEX: /[0-9a-f]/\n");
    t.push_str("DIGITS: /[0-9]{3}/\n");
    v.push(DataFile { path: "grammars/features.lark".to_string(), body: t });
}

fn data_part_1(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("// JSON, after lark's json example\n");
    t.push_str("?start: value\n");
    t.push_str("\n");
    t.push_str("?value: object\n");
    t.push_str("      | array\n");
    t.push_str("      | string\n");
    t.push_str("      | SIGNED_NUMBER      -> number\n");
    t.push_str("      | \"true\"             -> true\n");
    t.push_str("      | \"false\"            -> false\n");
    t.push_str("      | \"null\"             -> null\n");
    t.push_str("\n");
    t.push_str("array  : \"[\" [value (\",\" value)*] \"]\"\n");
    t.push_str("object : \"{\" [pair (\",\" pair)*] \"}\"\n");
    t.push_str("pair   : string \":\" value\n");
    t.push_str("\n");
    t.push_str("string : ESCAPED_STRING\n");
    t.push_str("\n");
    t.push_str("%import common.ESCAPED_STRING\n");
    t.push_str("%import common.SIGNED_NUMBER\n");
    t.push_str("%import common.WS\n");
    t.push_str("%ignore WS\n");
    v.push(DataFile { path: "grammars/json.lark".to_string(), body: t });
    let mut t = String.new();
    t.push_str("// the same terminals with the basic and the contextual lexer\n");
    t.push_str("start: (assign | label)*\n");
    t.push_str("assign: NAME \"=\" VALUE \";\"\n");
    t.push_str("label: NAME \":\"\n");
    t.push_str("NAME: /[a-z]+/\n");
    t.push_str("VALUE: /[a-z0-9]+/\n");
    t.push_str("%ignore \" \"\n");
    v.push(DataFile { path: "grammars/keywords.lark".to_string(), body: t });
    let mut t = String.new();
    t.push_str("// an indented outline, after lark's indented_tree example\n");
    t.push_str("?start: _NL* item*\n");
    t.push_str("\n");
    t.push_str("item: entry _NL [_INDENT item+ _DEDENT]\n");
    t.push_str("entry: (WORD | TAG | NUMBER | DONE)+\n");
    t.push_str("\n");
    t.push_str("DONE.2: \"[x]\"\n");
    t.push_str("TAG: /@[a-z]+/\n");
    t.push_str("WORD: /[A-Za-z][A-Za-z'-]*[.,:]?/\n");
    t.push_str("NUMBER: /\\d+(\\.\\d+)?/\n");
    t.push_str("\n");
    t.push_str("%import common.WS_INLINE\n");
    t.push_str("%declare _INDENT _DEDENT\n");
    t.push_str("%ignore WS_INLINE\n");
    t.push_str("\n");
    t.push_str("_NL: /(\\r?\\n[\\t ]*)+/\n");
    v.push(DataFile { path: "grammars/outline.lark".to_string(), body: t });
    let mut t = String.new();
    t.push_str("// %override, %extend and %declare on an imported base grammar\n");
    t.push_str("%import .base (start, expr, atom, NUMBER, WS)\n");
    t.push_str("%ignore WS\n");
    t.push_str("\n");
    t.push_str("%override atom: NUMBER | NAME | \"(\" expr \")\"\n");
    t.push_str("%extend expr: expr \"^\" atom -> power\n");
    t.push_str("NAME: /[a-z]+/\n");
    v.push(DataFile { path: "grammars/override.lark".to_string(), body: t });
    let mut t = String.new();
    t.push_str("start: item+\n");
    t.push_str("item: \"<\" [NAME] [\"=\" NAME] \">\"\n");
    t.push_str("    | \"(\" NAME? \")\"           -> paren\n");
    t.push_str("    | \"{\" _opt_names \"}\"      -> brace\n");
    t.push_str("_opt_names: [NAME (\",\" NAME)*]\n");
    t.push_str("NAME: /\\w+/\n");
    t.push_str("%ignore \" \"\n");
    v.push(DataFile { path: "grammars/placeholders.lark".to_string(), body: t });
    let mut t = String.new();
    t.push_str("// definitions other grammars import\n");
    t.push_str("ID: /[a-z][a-z0-9_]*/\n");
    t.push_str("QUOTED: /'[^']*'/\n");
    t.push_str("_semi: \";\"\n");
    t.push_str("sep_list{item, sep}: item (sep item)*\n");
    t.push_str("UNUSED: \"never\"\n");
    v.push(DataFile { path: "grammars/shared.lark".to_string(), body: t });
    let mut t = String.new();
    t.push_str("// a SELECT statement with case-insensitive keywords\n");
    t.push_str("start: select (\";\" select)* [\";\"]\n");
    t.push_str("\n");
    t.push_str("select: \"SELECT\"i [DISTINCT] columns \"FROM\"i source join* [where] [group] [order] [limit]\n");
    t.push_str("\n");
    t.push_str("DISTINCT: \"DISTINCT\"i\n");
    t.push_str("columns: \"*\"                -> all_columns\n");
    t.push_str("       | column (\",\" column)*\n");
    t.push_str("column: expr [\"AS\"i NAME]\n");
    t.push_str("\n");
    t.push_str("source: NAME [NAME]\n");
    t.push_str("join: [JOIN_KIND] \"JOIN\"i source \"ON\"i expr\n");
    t.push_str("JOIN_KIND: \"LEFT\"i | \"INNER\"i\n");
    t.push_str("\n");
    t.push_str("where: \"WHERE\"i expr\n");
    t.push_str("group: \"GROUP\"i \"BY\"i expr (\",\" expr)*\n");
    t.push_str("order: \"ORDER\"i \"BY\"i ordering (\",\" ordering)*\n");
    t.push_str("ordering: expr [DIRECTION]\n");
    t.push_str("DIRECTION: \"ASC\"i | \"DESC\"i\n");
    t.push_str("limit: \"LIMIT\"i INT\n");
    t.push_str("\n");
    t.push_str("?expr: or_expr\n");
    t.push_str("?or_expr: and_expr | or_expr \"OR\"i and_expr -> or_\n");
    t.push_str("?and_expr: not_expr | and_expr \"AND\"i not_expr -> and_\n");
    t.push_str("?not_expr: comparison | \"NOT\"i not_expr -> not_\n");
    t.push_str("?comparison: sum | sum COMP_OP sum -> compare\n");
    t.push_str("           | sum \"IS\"i \"NULL\"i -> is_null\n");
    t.push_str("           | sum \"IN\"i \"(\" expr (\",\" expr)* \")\" -> in_list\n");
    t.push_str("?sum: term | sum ADD_OP term -> binop\n");
    t.push_str("?term: atom | term MUL_OP atom -> binop\n");
    t.push_str("?atom: NAME                  -> ref\n");
    t.push_str("     | NAME \".\" NAME         -> qualified\n");
    t.push_str("     | INT                   -> int\n");
    t.push_str("     | STRING                -> string\n");
    t.push_str("     | NAME \"(\" [expr (\",\" expr)* | \"*\"] \")\" -> func\n");
    t.push_str("     | \"(\" expr \")\"\n");
    t.push_str("\n");
    t.push_str("COMP_OP: \"=\" | \"<>\" | \"!=\" | \"<=\" | \">=\" | \"<\" | \">\"\n");
    t.push_str("ADD_OP: \"+\" | \"-\"\n");
    t.push_str("MUL_OP: \"*\" | \"/\"\n");
    t.push_str("NAME: /[A-Za-z_][A-Za-z0-9_]*/\n");
    t.push_str("STRING: /'[^']*'/\n");
    t.push_str("COMMENT: /--[^\\n]*/\n");
    t.push_str("\n");
    t.push_str("%import common.INT\n");
    t.push_str("%import common.WS\n");
    t.push_str("%ignore WS\n");
    t.push_str("%ignore COMMENT\n");
    v.push(DataFile { path: "grammars/sql.lark".to_string(), body: t });
    let mut t = String.new();
