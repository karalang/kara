// ------------------------------------------------------------ bytes
//
// The pieces of Python's bytes that filetype's matchers lean on.

// buf[a:b], clamped the way a slice is.
fn slice(buf: ref Vec[u8], a: i64, b: i64) -> Vec[u8] {
    let n = buf.len();
    let lo = if a > n { n } else { a };
    let hi = if b > n { n } else { b };
    let mut out: Vec[u8] = Vec.new();
    let mut i = lo;
    while i < hi {
        out.push(buf[i]);
        i += 1;
    }
    out
}

fn tail_from(buf: ref Vec[u8], a: i64) -> Vec[u8] {
    slice(buf, a, buf.len())
}

fn bytes_eq(a: ref Vec[u8], b: ref Vec[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    true
}

// buf[a:b] == want
fn slice_is(buf: ref Vec[u8], a: i64, b: i64, want: ref Vec[u8]) -> bool {
    bytes_eq(slice(buf, a, b), want)
}

// buf[:len(want)] == want
fn starts(buf: ref Vec[u8], want: ref Vec[u8]) -> bool {
    slice_is(buf, 0, want.len(), want)
}

// buf.find(sub, start, end): the first index of sub that fits in
// buf[start:end], or -1.
fn find_in(buf: ref Vec[u8], sub: ref Vec[u8], start: i64, end0: i64) -> i64 {
    let end = if end0 > buf.len() { buf.len() } else { end0 };
    let mut i = start;
    while i + sub.len() <= end {
        let mut k = 0;
        while k < sub.len() and buf[i + k] == sub[k] {
            k += 1;
        }
        if k == sub.len() {
            return i;
        }
        i += 1;
    }
    -1
}

fn contains(buf: ref Vec[u8], sub: ref Vec[u8]) -> bool {
    find_in(buf, sub, 0, buf.len()) >= 0
}

// bytes(s, "ascii")
fn ascii(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

// int.from_bytes(b, "big")
fn be_int(b: ref Vec[u8]) -> i64 {
    let mut v = 0;
    for x in b {
        v = v * 256 + (*x as i64);
    }
    v
}

// struct.unpack("<L", b)
fn le32(b: ref Vec[u8]) -> i64 {
    (b[0] as i64) | ((b[1] as i64) << 8) | ((b[2] as i64) << 16) | ((b[3] as i64) << 24)
}

// The bytes a second UTF-8 byte may take after the first.
fn second_range(b: i64) -> (i64, i64) {
    if b == 0xe0 {
        (0xa0, 0xbf)
    } else if b == 0xed {
        (0x80, 0x9f)
    } else if b == 0xf0 {
        (0x90, 0xbf)
    } else if b == 0xf4 {
        (0x80, 0x8f)
    } else {
        (0x80, 0xbf)
    }
}

// b.decode(errors="ignore"): UTF-8, each bad sequence dropped as Python
// drops it, the lead byte and the good bytes after it together.
fn decode_ignore(b: ref Vec[u8]) -> String {
    let mut out = String.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(char.try_from(c).unwrap_or('?'));
            i += 1;
            continue;
        }
        let need = if c >= 0xc2 and c <= 0xdf {
            1
        } else if c >= 0xe0 and c <= 0xef {
            2
        } else if c >= 0xf0 and c <= 0xf4 {
            3
        } else {
            0
        };
        if need == 0 {
            i += 1;
            continue;
        }
        let mut cp = c & (0x3f >> need);
        let mut k = 0;
        let mut ok = true;
        while k < need {
            if i + 1 + k >= b.len() {
                ok = false;
                break;
            }
            let d = b[i + 1 + k] as i64;
            let (lo, hi) = if k == 0 { second_range(c) } else { (0x80, 0xbf) };
            if d < lo or d > hi {
                ok = false;
                break;
            }
            cp = (cp << 6) | (d & 0x3f);
            k += 1;
        }
        if ok {
            out.push(char.try_from(cp).unwrap_or('?'));
            i += need + 1;
        } else {
            i += k + 1;
        }
    }
    out
}

// b.decode("ascii", errors="ignore")
fn ascii_ignore(b: ref Vec[u8]) -> String {
    let mut out = String.new();
    for x in b {
        if *x < 0x80 {
            out.push(char.try_from(*x as i64).unwrap_or('?'));
        }
    }
    out
}

// ------------------------------------------------------------ the matchers
//
// filetype/types/: one matcher per kind, as the package writes them, in
// the order the package tries them.

enum M {
    Dwg, Xcf, Jpeg, Jpx, Apng, Png, Gif, Webp, Tiff, Cr2, Bmp, Jxr, Psd, Ico, Heic, ImgDcm, Avif,
    Aac, Midi, Mp3, M4a, Ogg, Flac, Wav, Amr, Aiff,
    M3gp, Mp4, M4v, Mkv, Mov, Avi, Wmv, Mpeg, Webm, Flv,
    Woff, Woff2, Ttf, Otf,
    Doc, Docx, Odt, Xls, Xlsx, Ods, Ppt, Pptx, Odp,
    Br, Rpm, ArcDcm, Epub, Zip, Tar, Rar, Gz, Bz2, SevenZ, Pdf, Exe, Swf, Rtf, Nes, Crx, Cab, Eot, Ps,
    Xz, Sqlite, Deb, Ar, Z, Lzop, Lz, Elf, Lz4, Zstd,
    Wasm,
    // the matcher the jobs add with add_type
    Csv,
}

#[derive(Clone)]
struct Kind {
    // the matcher's class name
    name: String,
    mime: String,
    ext: String,
    m: M,
}

fn kind(m: own M, name: Str, ext: Str, mime: Str) -> Kind {
    Kind { name: name.to_string(), mime: mime.to_string(), ext: ext.to_string(), m: m }
}

fn image_types() -> Vec[Kind] {
    let mut v: Vec[Kind] = Vec.new();
    v.push(kind(M.Dwg, "Dwg", "dwg", "image/vnd.dwg"));
    v.push(kind(M.Xcf, "Xcf", "xcf", "image/x-xcf"));
    v.push(kind(M.Jpeg, "Jpeg", "jpg", "image/jpeg"));
    v.push(kind(M.Jpx, "Jpx", "jpx", "image/jpx"));
    v.push(kind(M.Apng, "Apng", "apng", "image/apng"));
    v.push(kind(M.Png, "Png", "png", "image/png"));
    v.push(kind(M.Gif, "Gif", "gif", "image/gif"));
    v.push(kind(M.Webp, "Webp", "webp", "image/webp"));
    v.push(kind(M.Tiff, "Tiff", "tif", "image/tiff"));
    v.push(kind(M.Cr2, "Cr2", "cr2", "image/x-canon-cr2"));
    v.push(kind(M.Bmp, "Bmp", "bmp", "image/bmp"));
    v.push(kind(M.Jxr, "Jxr", "jxr", "image/vnd.ms-photo"));
    v.push(kind(M.Psd, "Psd", "psd", "image/vnd.adobe.photoshop"));
    v.push(kind(M.Ico, "Ico", "ico", "image/x-icon"));
    v.push(kind(M.Heic, "Heic", "heic", "image/heic"));
    v.push(kind(M.ImgDcm, "Dcm", "dcm", "application/dicom"));
    v.push(kind(M.Avif, "Avif", "avif", "image/avif"));
    v
}

