    v.push(kind(M.Rtf, "Rtf", "rtf", "application/rtf"));
    v.push(kind(M.Nes, "Nes", "nes", "application/x-nintendo-nes-rom"));
    v.push(kind(M.Crx, "Crx", "crx", "application/x-google-chrome-extension"));
    v.push(kind(M.Cab, "Cab", "cab", "application/vnd.ms-cab-compressed"));
    v.push(kind(M.Eot, "Eot", "eot", "application/octet-stream"));
    v.push(kind(M.Ps, "Ps", "ps", "application/postscript"));
    v.push(kind(M.Xz, "Xz", "xz", "application/x-xz"));
    v.push(kind(M.Sqlite, "Sqlite", "sqlite", "application/x-sqlite3"));
    v.push(kind(M.Deb, "Deb", "deb", "application/x-deb"));
    v.push(kind(M.Ar, "Ar", "ar", "application/x-unix-archive"));
    v.push(kind(M.Z, "Z", "Z", "application/x-compress"));
    v.push(kind(M.Lzop, "Lzop", "lzo", "application/x-lzop"));
