fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

// The bytes a block of hex digits spells; line breaks are skipped.
fn unhex(s: String) -> Vec[u8] {
    let b = to_bytes(s);
    let mut digits: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        if is_hex(b[i]) {
            digits.push(hex_val(b[i]));
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < digits.len() {
        out.push(digits[i] * 16 + digits[i + 1]);
        i += 2;
    }
    out
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data")?;
    put_bytes("data/audio.raw.xz", unhex(file_0()))?;
    put_bytes("data/badcheck.xz", unhex(file_1()))?;
    put_bytes("data/badfooter.xz", unhex(file_2()))?;
    put_bytes("data/concat.xz", unhex(file_3()))?;
    put("data/empty.txt", file_4())?;
    put_bytes("data/empty.xz", unhex(file_5()))?;
    put_bytes("data/flip.xz", unhex(file_6()))?;
    put("data/hello.c", file_7())?;
    put_bytes("data/hello.xz", unhex(file_8()))?;
    put("data/jobs.txt", file_9())?;
    put_bytes("data/legacy.lzma", unhex(file_10()))?;
    put_bytes("data/multi.xz", unhex(file_11()))?;
    put_bytes("data/none.xz", unhex(file_12()))?;
    put_bytes("data/notes-crc32.xz", unhex(file_13()))?;
    put_bytes("data/notes-sha256.xz", unhex(file_14()))?;
    put("data/notes.txt", file_15())?;
    put_bytes("data/notes.txt.xz", unhex(file_16()))?;
    put("data/plain.xz", file_17())?;
    put_bytes("data/rand.bin.xz", unhex(file_18()))?;
    put_bytes("data/tiny.xz", unhex(file_19()))?;
    put_bytes("data/trunc.xz", unhex(file_20()))?;
    Ok(())
}

// The names of the input files.
fn data_names() -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    v.push("audio.raw.xz".to_string());
    v.push("badcheck.xz".to_string());
    v.push("badfooter.xz".to_string());
    v.push("concat.xz".to_string());
    v.push("empty.txt".to_string());
    v.push("empty.xz".to_string());
    v.push("flip.xz".to_string());
    v.push("hello.c".to_string());
    v.push("hello.xz".to_string());
    v.push("jobs.txt".to_string());
    v.push("legacy.lzma".to_string());
    v.push("multi.xz".to_string());
    v.push("none.xz".to_string());
    v.push("notes-crc32.xz".to_string());
    v.push("notes-sha256.xz".to_string());
    v.push("notes.txt".to_string());
    v.push("notes.txt.xz".to_string());
    v.push("plain.xz".to_string());
    v.push("rand.bin.xz".to_string());
    v.push("tiny.xz".to_string());
    v.push("trunc.xz".to_string());
    v
}

// ------------------------------------------------------------ the jobs

// A fresh start, as after unpacking data/: the files -d writes that are
// not inputs are removed.
fn clear_outputs(jobs: ref Vec[String]) {
    let inputs = data_names();
    for line in jobs {
        let w = split_on(line, b' ');
        if w[0] != "xz" or w.len() < 2 or not starts_with(w[1], "-d") or has_byte(w[1], b'c') {
            continue;
        }
        for a in w[2..].to_vec() {
            if let Some(on) = out_name(a) {
                if not inputs.contains(on) {
                    let _ = fs.remove_file(f"data/{on}");
                }
            }
        }
    }
}

fn run() -> Result[(), String] {
    write_data()?;
    let text = match fs.read_to_string("data/jobs.txt".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/jobs.txt: {e}"),
    };
    let jobs = lines_of(text);
    clear_outputs(jobs);
    let t = crc_tables();
    for line in jobs {
        if line.len() == 0 or starts_with(line, "#") {
            continue;
        }
        let mut job = Job { out: String.new(), err: String.new(), status: 0 };
        let w = split_on(line, b' ');
        let rest: Vec[String] = w[1..].to_vec();
        if w[0] == "xz" {
            xz(t, mut job, rest);
        } else if w[0] == "sha256sum" {
            sha256sum(mut job, rest);
        }
        let mut out = f"$ {line}\n";
        out.push_str(job.out);
        out.push_str(job.err);
        if job.status != 0 {
            out.push_str(f"[exit status {job.status}]\n");
        }
        println(out);
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"error: {e}");
    }
}
