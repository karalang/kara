xz -tv multi.xz concat.xz empty.xz legacy.lzma
xz -t trunc.xz
xz -t flip.xz
xz -t badcheck.xz
xz -t plain.xz tiny.xz
xz -t missing.xz
xz -dc concat.xz
xz -dc legacy.lzma
xz -dk hello.xz
sha256sum hello
xz -dk audio.raw.xz
sha256sum audio.raw
xz -dk rand.bin.xz
sha256sum rand.bin
xz -dk notes.txt.xz

"""
}

