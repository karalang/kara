// data/badcheck.xz
fn file_1() -> String {
    """
fd377a585a000004e6d6b4460200210116000000742fe5a3e0385b08675d00321949dc2e0ef8e18e67e609fda7ed147f
fde0ab30714cc8d7b09c73f4b59a6d2776587d081e84e1439756a8a509b62d22005dc3fd65a8d335e633a4d8c62abe1e
