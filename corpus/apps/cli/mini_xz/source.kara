// mini_xz: XZ Utils 5.4.5's xz and sha256sum, written from the .xz file
// format specification, the LZMA specification and liblzma's sources:
// - the .xz container: stream headers and footers, block headers with
//   their filter chains, block padding, the index, stream padding and
//   several streams in one file, with CRC-32, CRC-64 and SHA-256 checks;
// - the LZMA2 and LZMA decoders (range coder, literals, matches and the
//   four repeated distances), the legacy .lzma format, and the delta and
//   x86 BCJ filters;
// - xz -l, -lv and -lvv, which read a file backwards from its footers
//   the way liblzma's file-info decoder does, -t, -tv, -d, -c and -k,
//   with xz's messages and exit codes.
//
// The inputs are the files in data/, made with XZ Utils 5.4.5.
// expected.out is the output of oracle.py, the same program in Python,
// and is byte-identical to the real xz and sha256sum.

// ------------------------------------------------------------ bytes and text

fn byte_str(b: ref Vec[u8], from: i64, to: i64) -> String {
    let mut v: Vec[u8] = Vec.new();
    for i in from..to {
        v.push(b[i]);
    }
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn to_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn from_bytes(v: Vec[u8]) -> String {
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn is_alpha(c: u8) -> bool {
    (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z')
}

fn is_alnum(c: u8) -> bool {
    is_digit(c) or is_alpha(c)
}

// White space, as `\s` and str.strip see it.
fn is_ws(c: u8) -> bool {
    c == b' ' or c == b'\t' or c == b'\n' or c == b'\r' or c == 11 or c == 12
}

fn lower_byte(c: u8) -> u8 {
    if c >= b'A' and c <= b'Z' { c + 32 } else { c }
}

fn lower(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        out.push(lower_byte(b[i]));
    }
    from_bytes(out)
}

fn strip(s: Str) -> String {
    let b = to_bytes(s);
    let mut i: i64 = 0;
    let mut j = b.len();
    while i < j and is_ws(b[i]) {
        i += 1;
    }
    while j > i and is_ws(b[j - 1]) {
        j -= 1;
    }
    byte_str(b, i, j)
}

fn split_ws(s: Str) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        while i < b.len() and is_ws(b[i]) {
            i += 1;
        }
        let st = i;
        while i < b.len() and not is_ws(b[i]) {
            i += 1;
        }
        if i > st {
            out.push(byte_str(b, st, i));
        }
    }
    out
}

fn split_on(s: Str, sep: u8) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut st: i64 = 0;
    for i in 0..b.len() {
        if b[i] == sep {
            out.push(byte_str(b, st, i));
            st = i + 1;
        }
    }
    out.push(byte_str(b, st, b.len()));
    out
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

// The lines of a file, without their newlines.
fn lines_of(text: Str) -> Vec[String] {
    let mut v = split_on(text, b'\n');
    if v.len() > 0 and v[v.len() - 1].len() == 0 {
        v.pop();
    }
    v
}

// Python's repr of a str.
fn py_repr(s: Str) -> String {
    let b = to_bytes(s);
    let mut has_single = false;
    let mut has_double = false;
    for i in 0..b.len() {
        if b[i] == b'\'' {
            has_single = true;
        }
        if b[i] == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let hex = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    out.push(q);
    let mut skip = false;
    for i in 0..b.len() {
        let c = b[i];
        if skip {
            skip = false;
            continue;
        }
        // U+0080 to U+00A0 and U+00AD are not printable either
        let next: u8 = if i + 1 < b.len() { b[i + 1] } else { 0 };
        if c == 0xC2 and next >= 0x80 and (next <= 0xA0 or next == 0xAD) {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(next / 16) as i64]);
            out.push(hex[(next % 16) as i64]);
            skip = true;
        } else if c == q or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c < 32 or c == 127 {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    from_bytes(out)
}

fn upper(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        let c = b[i];
        out.push(if c >= b'a' and c <= b'z' { c - 32 } else { c });
    }
    from_bytes(out)
}

// Whether `pat` occurs in `b` at `i`.
fn starts_at(b: ref Vec[u8], i: i64, pat: Str) -> bool {
    let p = to_bytes(pat);
    if i < 0 or i + p.len() > b.len() {
        return false;
    }
    for k in 0..p.len() {
        if b[i + k] != p[k] {
            return false;
        }
    }
    true
}

fn starts_with(s: Str, pat: Str) -> bool {
    starts_at(to_bytes(s), 0, pat)
}

fn find_str(s: Str, pat: Str) -> i64 {
    let b = to_bytes(s);
    for i in 0..b.len() + 1 {
        if starts_at(b, i, pat) {
            return i;
        }
    }
    -1
}

fn first_byte(s: Str) -> u8 {
    let b = to_bytes(s);
    if b.len() > 0 { b[0] } else { 0 }
}

fn slice_from(s: Str, i: i64) -> String {
    let b = to_bytes(s);
    byte_str(b, i, b.len())
}

fn is_hex(c: u8) -> bool {
    is_digit(c) or (c >= b'a' and c <= b'f') or (c >= b'A' and c <= b'F')
}

fn hex_val(c: u8) -> u8 {
    if is_digit(c) {
        c - b'0'
    } else if c >= b'a' and c <= b'f' {
        c - b'a' + 10
    } else {
        c - b'A' + 10
    }
}

fn find_byte(s: Str, c: u8) -> i64 {
    let b = to_bytes(s);
    for i in 0..b.len() {
        if b[i] == c {
            return i;
        }
    }
    -1
}

fn rfind_byte(s: Str, c: u8) -> i64 {
    let b = to_bytes(s);
    let mut i = b.len() - 1;
    while i >= 0 {
        if b[i] == c {
            return i;
        }
        i -= 1;
    }
    -1
}

fn has_byte(s: Str, c: u8) -> bool {
    find_byte(s, c) >= 0
}

fn slice(s: Str, from: i64, to: i64) -> String {
    byte_str(to_bytes(s), from, to)
}

// str.partition and str.rpartition on one byte: (before, found, after).
fn partition(s: Str, c: u8) -> (String, bool, String) {
    let i = find_byte(s, c);
    if i < 0 {
        return (s.to_string(), false, String.new());
    }
    (slice(s, 0, i), true, slice_from(s, i + 1))
}

fn rpartition(s: Str, c: u8) -> (String, bool, String) {
    let i = rfind_byte(s, c);
    if i < 0 {
        return (String.new(), false, s.to_string());
    }
    (slice(s, 0, i), true, slice_from(s, i + 1))
}

// Python's repr of a bytes object.
fn bytes_repr(b: ref Vec[u8]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for i in 0..b.len() {
        if b[i] == b'\'' {
            has_single = true;
        }
        if b[i] == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let hex = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    out.push(b'b');
    out.push(q);
    for i in 0..b.len() {
        let c = b[i];
        if c == q or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c < 32 or c >= 127 {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    from_bytes(out)
}

fn is_ascii(s: Str) -> bool {
    let b = to_bytes(s);
    for i in 0..b.len() {
        if b[i] >= 0x80 {
            return false;
        }
    }
    true
}

fn py_int(s: Str) -> Option[i64] {
    let b = to_bytes(strip(s));
    let mut i: i64 = 0;
    let mut neg = false;
    if i < b.len() and (b[i] == b'+' or b[i] == b'-') {
        neg = b[i] == b'-';
        i += 1;
    }
    if i >= b.len() {
        return None;
    }
    let mut n: i64 = 0;
    let mut prev_digit = false;
    while i < b.len() {
        let c = b[i];
        if is_digit(c) {
            n = n * 10 + (c - b'0') as i64;
            prev_digit = true;
        } else if c == b'_' and prev_digit and i + 1 < b.len() and is_digit(b[i + 1]) {
            prev_digit = false;
        } else {
            return None;
        }
        i += 1;
    }
    if neg { Some(-n) } else { Some(n) }
}

// The code points of a string.
fn code_points(s: Str) -> Vec[i64] {
    let b = to_bytes(s);
    let mut out: Vec[i64] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | (b[i + 1] as i64 & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | ((b[i + 1] as i64 & 0x3F) << 6) | (b[i + 2] as i64 & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | ((b[i + 1] as i64 & 0x3F) << 12) | ((b[i + 2] as i64 & 0x3F) << 6) | (b[i + 3] as i64 & 0x3F));
            i += 4;
        }
    }
    out
}

fn push_code_point(out: mut ref Vec[u8], cp: i64) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push(((cp >> 6) | 0xC0) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    } else if cp < 0x10000 {
        out.push(((cp >> 12) | 0xE0) as u8);
        out.push((((cp >> 6) & 0x3F) | 0x80) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    } else {
        out.push(((cp >> 18) | 0xF0) as u8);
        out.push((((cp >> 12) & 0x3F) | 0x80) as u8);
        out.push((((cp >> 6) & 0x3F) | 0x80) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    }
}

fn ljust(s: Str, width: i64) -> String {
    let mut out = s.to_string();
    while out.len() < width {
        out.push_str(" ");
    }
    out
}

fn rjust(s: Str, width: i64) -> String {
    let mut out = String.new();
    let mut n = s.len();
    while n < width {
        out.push_str(" ");
        n += 1;
    }
    out.push_str(s);
    out
}

fn plural(n: i64, one: Str, many: Str) -> String {
    if n == 1 { one.to_string() } else { many.to_string() }
}

// ------------------------------------------------------------ SHA-256 (FIPS 180-4)

const MASK32: i64 = 0xFFFFFFFF;

fn rotr(x: i64, n: i64) -> i64 {
    ((x >> n) | (x << (32 - n))) & MASK32
}

// The message padded to whole 64-byte blocks, with its bit length.
fn md_pad(msg: ref Vec[u8]) -> Vec[u8] {
    let mut m = msg.clone();
    let bits = msg.len() * 8;
    m.push(0x80);
    while m.len() % 64 != 56 {
        m.push(0);
    }
    let mut k = 56;
    while k >= 0 {
        m.push(((bits >> k) & 0xFF) as u8);
        k -= 8;
    }
    m
}

fn be32(b: ref Vec[u8], i: i64) -> i64 {
    (b[i] as i64) << 24 | (b[i + 1] as i64) << 16 | (b[i + 2] as i64) << 8 | b[i + 3] as i64
}

fn push_be32(out: mut ref Vec[u8], x: i64) {
    out.push(((x >> 24) & 0xFF) as u8);
    out.push(((x >> 16) & 0xFF) as u8);
    out.push(((x >> 8) & 0xFF) as u8);
    out.push((x & 0xFF) as u8);
}

const SHA256_K: Array[i64, 64] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

fn sha256(msg: ref Vec[u8]) -> Vec[u8] {
    let m = md_pad(msg);
    let mut h: Vec[i64] = Vec.new();
    for x in [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19] {
        h.push(x);
    }
    let mut w: Vec[i64] = Vec.new();
    for _ in 0..64 {
        w.push(0);
    }
    let mut blk: i64 = 0;
    while blk < m.len() {
        for t in 0..16 {
            w[t] = be32(m, blk + 4 * t);
        }
        for t in 16..64 {
            let s0 = rotr(w[t - 15], 7) ^ rotr(w[t - 15], 18) ^ (w[t - 15] >> 3);
            let s1 = rotr(w[t - 2], 17) ^ rotr(w[t - 2], 19) ^ (w[t - 2] >> 10);
            w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & MASK32;
        }
        let mut a = h[0];
        let mut b = h[1];
        let mut c = h[2];
        let mut d = h[3];
        let mut e = h[4];
        let mut f = h[5];
        let mut g = h[6];
        let mut hh = h[7];
        for t in 0..64 {
            let s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
            let ch = (e & f) ^ ((e ^ MASK32) & g);
            let t1 = (hh + s1 + ch + SHA256_K[t] + w[t]) & MASK32;
            let s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
            let maj = (a & b) ^ (a & c) ^ (b & c);
            let t2 = (s0 + maj) & MASK32;
            hh = g;
            g = f;
            f = e;
            e = (d + t1) & MASK32;
            d = c;
            c = b;
            b = a;
            a = (t1 + t2) & MASK32;
        }
        h[0] = (h[0] + a) & MASK32;
        h[1] = (h[1] + b) & MASK32;
        h[2] = (h[2] + c) & MASK32;
        h[3] = (h[3] + d) & MASK32;
        h[4] = (h[4] + e) & MASK32;
        h[5] = (h[5] + f) & MASK32;
        h[6] = (h[6] + g) & MASK32;
        h[7] = (h[7] + hh) & MASK32;
        blk += 64;
    }
    let mut out: Vec[u8] = Vec.new();
    for x in h {
        push_be32(mut out, x);
    }
    out
}

fn hex_of(b: ref Vec[u8]) -> String {
    let mut s = String.new();
    for x in b {
        s.push_str(f"{x:02x}");
    }
    s
}

fn zeros(n: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for _ in 0..n {
        v.push(0);
    }
    v
}

fn filled(n: i64, x: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for _ in 0..n {
        v.push(x);
    }
    v
}

fn le_at(b: ref Vec[u8], pos: i64, n: i64) -> i64 {
    let mut v: i64 = 0;
    let mut k = n - 1;
    while k >= 0 {
        v = (v << 8) | (b[pos + k] as i64);
        k -= 1;
    }
    v
}

fn bytes_from(b: ref Vec[u8], from: i64, to: i64) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for i in from..to {
        v.push(b[i]);
    }
    v
}

// ------------------------------------------------------------ CRC-32 and CRC-64

// The tables of the reflected CRC-32 (zlib's) and CRC-64 (ECMA-182, as
// .xz uses it).
struct Crcs {
    t32: Vec[i64],
    t64: Vec[u64],
}

fn crc_tables() -> Crcs {
    let mut t32: Vec[i64] = Vec.new();
    let mut t64: Vec[u64] = Vec.new();
    for i in 0..256 {
        let mut c = i;
        let mut d = i as u64;
        for _ in 0..8 {
            if c & 1 == 1 {
                c = (c >> 1) ^ 0xEDB88320;
            } else {
                c = c >> 1;
            }
            if d & 1 == 1 {
                d = (d >> 1) ^ 0xC96C5795D7870F42u64;
            } else {
                d = d >> 1;
            }
        }
        t32.push(c);
        t64.push(d);
    }
    Crcs { t32: t32, t64: t64 }
}

fn crc32_range(t: ref Crcs, b: ref Vec[u8], from: i64, to: i64) -> i64 {
    let mut c = MASK32;
    for i in from..to {
        c = t.t32[(c ^ (b[i] as i64)) & 0xFF] ^ (c >> 8);
    }
    c ^ MASK32
}

fn crc64_of(t: ref Crcs, b: ref Vec[u8]) -> u64 {
    let mut c: u64 = 0xFFFFFFFFFFFFFFFFu64;
    for x in b {
        c = t.t64[((c ^ (x as u64)) & 0xFF) as i64] ^ (c >> 8);
    }
    c ^ 0xFFFFFFFFFFFFFFFFu64
}

fn check_size(id: i64) -> i64 {
    match id {
        0 => 0,
        1 => 4,
        4 => 8,
        10 => 32,
        _ => 0,
    }
}

fn check_name(id: i64) -> String {
    match id {
        0 => "None".to_string(),
        1 => "CRC32".to_string(),
        4 => "CRC64".to_string(),
        10 => "SHA-256".to_string(),
        _ => f"Unknown-{id}",
    }
}

fn known_check(id: i64) -> bool {
    id == 0 or id == 1 or id == 4 or id == 10
}

// The check value as it is stored: little-endian for the CRCs.
fn check_of(t: ref Crcs, id: i64, data: ref Vec[u8]) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    if id == 1 {
        let c = crc32_range(t, data, 0, data.len());
        for k in 0..4 {
            v.push(((c >> (8 * k)) & 0xFF) as u8);
        }
    } else if id == 4 {
        let c = crc64_of(t, data);
        for k in 0..8 {
            v.push(((c >> ((8 * k) as u64)) & 0xFF) as u8);
        }
    } else if id == 10 {
        v = sha256(data);
    }
    v
}

// ------------------------------------------------------------ the LZMA decoder

// Errors are "eof" (the input ended), "data" (corrupt data or a check
// that does not match), "format" (not .xz or .lzma) and "options"
// (something this decoder does not support).
fn fail[T](kind: Str) -> Result[T, String] {
    Err(kind.to_string())
}

// The range decoder reads data[pos..end]; reading past end is an error
// of the given kind ("eof" at the end of the file, "data" at the end of
// an LZMA2 chunk).
struct RangeDec {
    pos: i64,
    end: i64,
    kind: String,
    range: i64,
    code: i64,
}

fn rc_byte(rc: mut ref RangeDec, data: ref Vec[u8]) -> Result[i64, String] {
    if rc.pos >= rc.end {
        return Err(rc.kind.clone());
    }
    let b = data[rc.pos] as i64;
    rc.pos += 1;
    Ok(b)
}

fn rc_new(data: ref Vec[u8], pos: i64, end: i64, kind: Str) -> Result[RangeDec, String] {
    let mut rc = RangeDec { pos: pos, end: end, kind: kind.to_string(), range: MASK32, code: 0 };
    if rc_byte(mut rc, data)? != 0 {
        return fail("data");
    }
    for _ in 0..4 {
        rc.code = (rc.code << 8) | rc_byte(mut rc, data)?;
    }
    Ok(rc)
}

fn rc_norm(rc: mut ref RangeDec, data: ref Vec[u8]) -> Result[(), String] {
    if rc.range < 0x1000000 {
        rc.range = (rc.range << 8) & MASK32;
        rc.code = ((rc.code << 8) | rc_byte(rc, data)?) & MASK32;
    }
    Ok(())
}

fn rc_bit(rc: mut ref RangeDec, data: ref Vec[u8], p: mut ref Vec[i64], i: i64) -> Result[i64, String] {
    let pr = p[i];
    let bound = (rc.range >> 11) * pr;
    let mut b: i64 = 0;
    if rc.code < bound {
        rc.range = bound;
        p[i] = pr + ((2048 - pr) >> 5);
    } else {
        rc.range -= bound;
        rc.code -= bound;
        p[i] = pr - (pr >> 5);
        b = 1;
    }
    rc_norm(rc, data)?;
    Ok(b)
}

// A bit tree whose node m sits at p[base + m].
fn rc_tree(rc: mut ref RangeDec, data: ref Vec[u8], p: mut ref Vec[i64], base: i64, nbits: i64) -> Result[i64, String] {
    let mut m: i64 = 1;
    for _ in 0..nbits {
        m = (m << 1) | rc_bit(rc, data, p, base + m)?;
    }
    Ok(m - (1 << nbits))
}

// The same tree read with its bits in reverse order.
fn rc_rtree(rc: mut ref RangeDec, data: ref Vec[u8], p: mut ref Vec[i64], base: i64, nbits: i64) -> Result[i64, String] {
    let mut m: i64 = 1;
    let mut sym: i64 = 0;
    for i in 0..nbits {
        let b = rc_bit(rc, data, p, base + m)?;
        m = (m << 1) | b;
        sym |= b << i;
    }
    Ok(sym)
}

fn rc_direct(rc: mut ref RangeDec, data: ref Vec[u8], nbits: i64) -> Result[i64, String] {
    let mut res: i64 = 0;
    for _ in 0..nbits {
        rc.range = rc.range >> 1;
        let mut b: i64 = 0;
        if rc.code >= rc.range {
            rc.code -= rc.range;
            b = 1;
        }
        res = (res << 1) | b;
        rc_norm(rc, data)?;
    }
    Ok(res)
}

// Where each group of probabilities starts in Lzma.p. A length coder is
// a choice bit, a second choice bit, eight 3-bit trees for the low
// lengths, eight for the middle ones, and one 8-bit tree.
const IS_MATCH: i64 = 0;
const IS_REP: i64 = 192;
const IS_REP_G0: i64 = 204;
const IS_REP_G1: i64 = 216;
const IS_REP_G2: i64 = 228;
const IS_REP0_LONG: i64 = 240;
const POS_SLOT: i64 = 432;
const SPEC_POS: i64 = 688;
const ALIGN: i64 = 803;
const LEN_CODER: i64 = 819;
const REP_LEN_CODER: i64 = 1333;
const LITERAL: i64 = 1847;

struct Lzma {
    lc: i64,
    lp: i64,
    pb: i64,
    state: i64,
    reps: Vec[i64],
    p: Vec[i64],
}

fn lzma_new(lc: i64, lp: i64, pb: i64) -> Lzma {
    let mut lz = Lzma { lc: lc, lp: lp, pb: pb, state: 0, reps: zeros(4), p: Vec.new() };
    lzma_reset(mut lz);
    lz
}

fn lzma_reset(lz: mut ref Lzma) {
    lz.state = 0;
    lz.reps = zeros(4);
    lz.p = filled(LITERAL + (0x300 << (lz.lc + lz.lp)), 1024);
}

// A match length less two: 0-7, 8-15 or 16-271.
fn len_decode(rc: mut ref RangeDec, data: ref Vec[u8], p: mut ref Vec[i64], base: i64, ps: i64) -> Result[i64, String] {
    if rc_bit(rc, data, p, base)? == 0 {
        return rc_tree(rc, data, p, base + 2 + ps * 8 - 1, 3);
    }
    if rc_bit(rc, data, p, base + 1)? == 0 {
        return Ok(8 + rc_tree(rc, data, p, base + 130 + ps * 8 - 1, 3)?);
    }
    Ok(16 + rc_tree(rc, data, p, base + 258 - 1, 8)?)
}

fn next_state_lit(st: i64) -> i64 {
    if st < 4 { 0 } else if st < 10 { st - 3 } else { st - 6 }
}

// Decodes into dic, the output since the last dictionary reset, until it
// holds `until` bytes, or until the end marker when until is -1. Ok(true)
// means it stopped at the end marker.
fn lzma_run(rc: mut ref RangeDec, data: ref Vec[u8], lz: mut ref Lzma, dic: mut ref Vec[u8], until: i64, dict_size: i64) -> Result[bool, String] {
    let pbm = (1 << lz.pb) - 1;
    let lpm = (1 << lz.lp) - 1;
    while until < 0 or dic.len() < until {
        let pos = dic.len();
        let ps = pos & pbm;
        let st = lz.state;
        if rc_bit(rc, data, lz.p, IS_MATCH + st * 16 + ps)? == 0 {
            let prev = if pos > 0 { dic[pos - 1] as i64 } else { 0 };
            let base = LITERAL + 0x300 * (((pos & lpm) << lz.lc) + (prev >> (8 - lz.lc)));
            let mut sym: i64 = 1;
            if st >= 7 {
                let mut mb = dic[pos - lz.reps[0] - 1] as i64;
                while sym < 0x100 {
                    let mbit = (mb >> 7) & 1;
                    mb = mb << 1;
                    let b = rc_bit(rc, data, lz.p, base + 0x100 + (mbit << 8) + sym)?;
                    sym = (sym << 1) | b;
                    if mbit != b {
                        break;
                    }
                }
            }
            while sym < 0x100 {
                sym = (sym << 1) | rc_bit(rc, data, lz.p, base + sym)?;
            }
            dic.push((sym - 0x100) as u8);
            lz.state = next_state_lit(st);
            continue;
        }
        let mut ln: i64 = 0;
        if rc_bit(rc, data, lz.p, IS_REP + st)? == 0 {
            ln = len_decode(rc, data, lz.p, LEN_CODER, ps)?;
            lz.state = if st < 7 { 7 } else { 10 };
            lz.reps[3] = lz.reps[2];
            lz.reps[2] = lz.reps[1];
            lz.reps[1] = lz.reps[0];
            let ls = if ln < 3 { ln } else { 3 };
            let slot = rc_tree(rc, data, lz.p, POS_SLOT + ls * 64, 6)?;
            let mut dist = slot;
            if slot >= 4 {
                let nd = (slot >> 1) - 1;
                dist = (2 | (slot & 1)) << nd;
                if slot < 14 {
                    dist += rc_rtree(rc, data, lz.p, SPEC_POS + dist - slot - 1, nd)?;
                } else {
                    dist += rc_direct(rc, data, nd - 4)? << 4;
                    dist += rc_rtree(rc, data, lz.p, ALIGN - 1, 4)?;
                }
            }
            if dist == MASK32 {
                return Ok(true);
            }
            lz.reps[0] = dist;
        } else {
            if rc_bit(rc, data, lz.p, IS_REP_G0 + st)? == 0 {
                if rc_bit(rc, data, lz.p, IS_REP0_LONG + st * 16 + ps)? == 0 {
                    // a short rep: one byte from the last distance
                    lz.state = if st < 7 { 9 } else { 11 };
                    if lz.reps[0] >= pos {
                        return fail("data");
                    }
                    let b = dic[pos - lz.reps[0] - 1];
                    dic.push(b);
                    continue;
                }
            } else {
                let mut d: i64 = 0;
                if rc_bit(rc, data, lz.p, IS_REP_G1 + st)? == 0 {
                    d = lz.reps[1];
                } else {
                    if rc_bit(rc, data, lz.p, IS_REP_G2 + st)? == 0 {
                        d = lz.reps[2];
                    } else {
                        d = lz.reps[3];
                        lz.reps[3] = lz.reps[2];
                    }
                    lz.reps[2] = lz.reps[1];
                }
                lz.reps[1] = lz.reps[0];
                lz.reps[0] = d;
            }
            ln = len_decode(rc, data, lz.p, REP_LEN_CODER, ps)?;
            lz.state = if st < 7 { 8 } else { 11 };
        }
        let dist = lz.reps[0];
        if dist >= pos or dist >= dict_size {
            return fail("data");
        }
        let n = ln + 2;
        if until >= 0 and pos + n > until {
            return fail("data");
        }
        for _ in 0..n {
            let b = dic[dic.len() - dist - 1];
            dic.push(b);
        }
    }
    Ok(false)
}

// The lc/lp/pb properties byte.
fn lclppb(b: i64) -> Result[(i64, i64, i64), String] {
    if b > 224 {
        return fail("options");
    }
    Ok((b % 9, (b / 9) % 5, b / 45))
}

fn dict_of_prop(b: i64) -> Result[i64, String] {
    if b > 40 {
        return fail("options");
    }
    if b == 40 {
        return Ok(MASK32);
    }
    Ok((2 | (b & 1)) << (b / 2 + 11))
}

// LZMA2 chunks from data[pos..end], up to the end byte. Returns the
// output and the position after the end byte.
fn lzma2_decode(data: ref Vec[u8], start: i64, end: i64, dict_size: i64) -> Result[(Vec[u8], i64), String] {
    let mut pos = start;
    let mut out: Vec[u8] = Vec.new();
    let mut dic: Vec[u8] = Vec.new();
    let mut lz = lzma_new(0, 0, 0);
    let mut need_reset = true;
    let mut need_props = true;
    loop {
        if pos >= end {
            return fail("eof");
        }
        let c = data[pos] as i64;
        pos += 1;
        if c == 0 {
            out.extend(dic);
            return Ok((out, pos));
        }
        if c >= 0xE0 or c == 1 {
            need_props = true;
            need_reset = false;
            out.extend(dic);
            dic = Vec.new();
        } else if need_reset {
            return fail("data");
        }
        if c >= 0x80 {
            if pos + 4 > end {
                return fail("eof");
            }
            let usize = ((c & 0x1F) << 16) + ((data[pos] as i64) << 8) + (data[pos + 1] as i64) + 1;
            let csize = ((data[pos + 2] as i64) << 8) + (data[pos + 3] as i64) + 1;
            pos += 4;
            if c >= 0xC0 {
                if pos >= end {
                    return fail("eof");
                }
                let (lc, lp, pb) = lclppb(data[pos] as i64)?;
                pos += 1;
                if lc + lp > 4 {
                    return fail("data");
                }
                need_props = false;
                lz = lzma_new(lc, lp, pb);
            } else if need_props {
                return fail("data");
            } else if c >= 0xA0 {
                lzma_reset(mut lz);
            }
            let mut rc = if pos + csize > end { rc_new(data, pos, end, "eof")? } else { rc_new(data, pos, pos + csize, "data")? };
            let want = dic.len() + usize;
            if lzma_run(mut rc, data, mut lz, mut dic, want, dict_size)? {
                return fail("data");
            }
            if rc.code != 0 or rc.pos != pos + csize {
                return fail("data");
            }
            pos += csize;
        } else if c <= 2 {
            if pos + 2 > end {
                return fail("eof");
            }
            let size = ((data[pos] as i64) << 8) + (data[pos + 1] as i64) + 1;
            pos += 2;
            if pos + size > end {
                return fail("eof");
            }
            for i in pos..pos + size {
                dic.push(data[i]);
            }
            pos += size;
        } else {
            return fail("data");
        }
    }
}

// ------------------------------------------------------------ the BCJ and delta filters

// liblzma's x86 filter, decoding: E8/E9 calls and jumps whose operand
// was made absolute are made relative again.
fn x86_decode(buf: mut ref Vec[u8]) {
    let allowed = [true, true, true, false, true, false, false, false];
    let bitnum = [0, 1, 2, 2, 3, 3, 3, 3];
    let size = buf.len();
    if size < 5 {
        return;
    }
    let mut prev_mask: i64 = 0;
    let mut prev_pos: i64 = (-5) & MASK32;
    let mut i: i64 = 0;
    while i <= size - 5 {
        let op = buf[i];
        if op != 0xE8 and op != 0xE9 {
            i += 1;
            continue;
        }
        let off = (i - prev_pos) & MASK32;
        prev_pos = i;
        if off > 5 {
            prev_mask = 0;
        } else {
            for _ in 0..off {
                prev_mask = (prev_mask & 0x77) << 1;
            }
        }
        let mut b = buf[i + 4] as i64;
        if (b == 0 or b == 0xFF) and allowed[(prev_mask >> 1) & 7] and (prev_mask >> 1) < 0x10 {
            let mut src = (b << 24) | ((buf[i + 3] as i64) << 16) | ((buf[i + 2] as i64) << 8) | (buf[i + 1] as i64);
            let mut dest: i64 = 0;
            loop {
                dest = (src - (i + 5)) & MASK32;
                if prev_mask == 0 {
                    break;
                }
                let j = bitnum[prev_mask >> 1];
                b = (dest >> (24 - j * 8)) & 0xFF;
                if not (b == 0 or b == 0xFF) {
                    break;
                }
                src = dest ^ ((1 << (32 - j * 8)) - 1);
            }
            buf[i + 4] = if (dest >> 24) & 1 == 1 { 0xFF } else { 0 };
            buf[i + 3] = ((dest >> 16) & 0xFF) as u8;
            buf[i + 2] = ((dest >> 8) & 0xFF) as u8;
            buf[i + 1] = (dest & 0xFF) as u8;
            i += 5;
            prev_mask = 0;
        } else {
            i += 1;
            prev_mask |= 1;
            if b == 0 or b == 0xFF {
                prev_mask |= 0x10;
            }
        }
    }
}

fn delta_decode(buf: mut ref Vec[u8], dist: i64) {
    for i in dist..buf.len() {
        buf[i] = (((buf[i] as i64) + (buf[i - dist] as i64)) & 0xFF) as u8;
    }
}

// ------------------------------------------------------------ the .xz format

fn vli(data: ref Vec[u8], start: i64, end: i64) -> Result[(i64, i64), String] {
    let mut pos = start;
    let mut v: i64 = 0;
    for i in 0..9 {
        if pos >= end {
            return fail("eof");
        }
        let b = data[pos] as i64;
        pos += 1;
        v |= (b & 0x7F) << (7 * i);
        if b & 0x80 == 0 {
            if b == 0 and i > 0 {
                return fail("data");
            }
            return Ok((v, pos));
        }
    }
    fail("data")
}

fn is_xz_magic(data: ref Vec[u8], pos: i64) -> bool {
    let magic = [0xFD, 0x37, 0x7A, 0x58, 0x5A, 0x00];
    if pos + 6 > data.len() {
        return false;
    }
    for k in 0..6 {
        if data[pos + k] as i64 != magic[k] {
            return false;
        }
    }
    true
}

// A Stream Header at pos; returns its check id.
fn stream_header(t: ref Crcs, data: ref Vec[u8], pos: i64, first: bool) -> Result[i64, String] {
    if not is_xz_magic(data, pos) {
        return fail(if first { "format" } else { "data" });
    }
    if crc32_range(t, data, pos + 6, pos + 8) != le_at(data, pos + 8, 4) {
        return fail("data");
    }
    if data[pos + 6] != 0 or (data[pos + 7] & 0xF0) != 0 {
        return fail("options");
    }
    Ok(data[pos + 7] as i64)
}

// A Stream Footer at pos; returns (backward size, check id).
fn stream_footer(t: ref Crcs, data: ref Vec[u8], pos: i64) -> Result[(i64, i64), String] {
    if data[pos + 10] != b'Y' or data[pos + 11] != b'Z' {
        return fail("data");
    }
    if crc32_range(t, data, pos + 4, pos + 10) != le_at(data, pos, 4) {
        return fail("data");
    }
    if data[pos + 8] != 0 or (data[pos + 9] & 0xF0) != 0 {
        return fail("options");
    }
    Ok(((le_at(data, pos + 4, 4) + 1) * 4, data[pos + 9] as i64))
}

struct BlockHeader {
    size: i64,
    csize: i64,
    usize: i64,
    fids: Vec[i64],
    fprops: Vec[Vec[u8]],
}

fn known_filter(id: i64) -> bool {
    id == 0x21 or id == 0x03 or id == 0x04
}

// A Block Header at pos; csize and usize are -1 when not stored.
fn block_header(t: ref Crcs, data: ref Vec[u8], pos: i64, end: i64) -> Result[BlockHeader, String] {
    if pos >= end {
        return fail("eof");
    }
    let hsize = ((data[pos] as i64) + 1) * 4;
    if pos + hsize > end {
        return fail("eof");
    }
    let hend = pos + hsize - 4;
    if crc32_range(t, data, pos, hend) != le_at(data, hend, 4) {
        return fail("data");
    }
    let fl = data[pos + 1] as i64;
    if fl & 0x3C != 0 {
        return fail("options");
    }
    let mut p = pos + 2;
    let mut csize: i64 = -1;
    let mut usize: i64 = -1;
    if fl & 0x40 != 0 {
        let (v, q) = vli(data, p, hend)?;
        if v == 0 {
            return fail("data");
        }
        csize = v;
        p = q;
    }
    if fl & 0x80 != 0 {
        let (v, q) = vli(data, p, hend)?;
        usize = v;
        p = q;
    }
    let mut fids: Vec[i64] = Vec.new();
    let mut fprops: Vec[Vec[u8]] = Vec.new();
    for _ in 0..(fl & 3) + 1 {
        let (id, q) = vli(data, p, hend)?;
        let (n, r) = vli(data, q, hend)?;
        if r + n > hend {
            return fail("data");
        }
        fids.push(id);
        fprops.push(bytes_from(data, r, r + n));
        p = r + n;
    }
    for i in p..hend {
        if data[i] != 0 {
            return fail("options");
        }
    }
    for id in fids {
        if not known_filter(id) {
            return fail("options");
        }
    }
    let last = fids.len() - 1;
    for k in 0..fids.len() {
        if (fids[k] == 0x21) != (k == last) {
            return fail("options");
        }
    }
    Ok(BlockHeader { size: hsize, csize: csize, usize: usize, fids: fids, fprops: fprops })
}

// Zero padding from pos up to the next multiple of four past start.
fn skip_padding(data: ref Vec[u8], start: i64, from: i64) -> Result[i64, String] {
    let mut pos = from;
    while (pos - start) % 4 != 0 {
        if pos >= data.len() {
            return fail("eof");
        }
        if data[pos] != 0 {
            return fail("data");
        }
        pos += 1;
    }
    Ok(pos)
}

// Decodes one block at pos into sink; returns (position after it, its
// unpadded size, its uncompressed size).
fn decode_block(t: ref Crcs, data: ref Vec[u8], start: i64, cid: i64, sink: mut ref Vec[u8]) -> Result[(i64, i64, i64), String] {
    let bh = block_header(t, data, start, data.len())?;
    let pos = start + bh.size;
    let fprops = ref bh.fprops;
    let props = ref fprops[bh.fids.len() - 1];
    if props.len() != 1 {
        return fail("options");
    }
    let dsize = dict_of_prop(props[0] as i64)?;
    let limit = if bh.csize < 0 or pos + bh.csize > data.len() { data.len() } else { pos + bh.csize };
    let (dec, npos) = lzma2_decode(data, pos, limit, dsize)?;
    let mut ud = dec;
    if bh.csize >= 0 and npos - pos != bh.csize {
        return fail("data");
    }
    if bh.usize >= 0 and ud.len() != bh.usize {
        return fail("data");
    }
    let mut k = bh.fids.len() - 2;
    while k >= 0 {
        if bh.fids[k] == 0x04 {
            x86_decode(mut ud);
        } else if bh.fids[k] == 0x03 {
            let fp = ref fprops[k];
            delta_decode(mut ud, (fp[0] as i64) + 1);
        }
        k -= 1;
    }
    let mut p = skip_padding(data, start, npos)?;
    let csz = check_size(cid);
    if p + csz > data.len() {
        return fail("eof");
    }
    if known_check(cid) and bytes_from(data, p, p + csz) != check_of(t, cid, ud) {
        return fail("data");
    }
    p += csz;
    let n = ud.len();
    sink.extend(ud);
    Ok((p, npos - start + csz, n))
}

fn decode_xz(t: ref Crcs, data: ref Vec[u8], sink: mut ref Vec[u8]) -> Result[(), String] {
    let mut pos: i64 = 0;
    let mut first = true;
    loop {
        if data.len() - pos < 12 {
            return fail("eof");
        }
        let cid = stream_header(t, data, pos, first)?;
        first = false;
        pos += 12;
        let mut unpadded: Vec[i64] = Vec.new();
        let mut sizes: Vec[i64] = Vec.new();
        loop {
            if pos >= data.len() {
                return fail("eof");
            }
            if data[pos] == 0 {
                break;
            }
            let (np, a, b) = decode_block(t, data, pos, cid, sink)?;
            unpadded.push(a);
            sizes.push(b);
            pos = np;
        }
        // the index must list the blocks
        let istart = pos;
        let (n, p0) = vli(data, pos + 1, data.len())?;
        if n != unpadded.len() {
            return fail("data");
        }
        let mut p = p0;
        for k in 0..n {
            let (a, q) = vli(data, p, data.len())?;
            let (b, r) = vli(data, q, data.len())?;
            if a != unpadded[k] or b != sizes[k] {
                return fail("data");
            }
            p = r;
        }
        p = skip_padding(data, istart, p)?;
        if p + 4 > data.len() {
            return fail("eof");
        }
        if crc32_range(t, data, istart, p) != le_at(data, p, 4) {
            return fail("data");
        }
        p += 4;
        if p + 12 > data.len() {
            return fail("eof");
        }
        let (bsize, fcid) = stream_footer(t, data, p)?;
        if fcid != cid or bsize != p - istart {
            return fail("data");
        }
        pos = p + 12;
        // stream padding, then maybe another stream
        let mut pad: i64 = 0;
        while pos < data.len() and data[pos] == 0 {
            pos += 1;
            pad += 1;
        }
        if pad % 4 != 0 {
            return fail("data");
        }
        if pos >= data.len() {
            return Ok(());
        }
    }
}

// What xz checks before it takes a file for the legacy .lzma format.
fn is_lzma(data: ref Vec[u8]) -> bool {
    if data.len() < 13 or data[0] > 224 {
        return false;
    }
    let d = le_at(data, 1, 4);
    if d != MASK32 {
        let mut x = d - 1;
        x |= x >> 2;
        x |= x >> 3;
        x |= x >> 4;
        x |= x >> 8;
        x |= x >> 16;
        x += 1;
        if x != d {
            return false;
        }
    }
    let mut unknown = true;
    for k in 5..13 {
        if data[k] != 0xFF {
            unknown = false;
        }
    }
    unknown or (data[12] == 0 and data[11] == 0 and data[10] == 0 and le_at(data, 5, 5) <= (1 << 38))
}

fn decode_lzma(data: ref Vec[u8], sink: mut ref Vec[u8]) -> Result[(), String] {
    let (lc, lp, pb) = lclppb(data[0] as i64)?;
    let d = le_at(data, 1, 4);
    let mut unknown = true;
    for k in 5..13 {
        if data[k] != 0xFF {
            unknown = false;
        }
    }
    let size = if unknown { -1 } else { le_at(data, 5, 8) };
    let mut lz = lzma_new(lc, lp, pb);
    let mut rc = rc_new(data, 13, data.len(), "eof")?;
    let mut dic: Vec[u8] = Vec.new();
    let dsize = if d < 4096 { 4096 } else { d };
    lzma_run(mut rc, data, mut lz, mut dic, size, dsize)?;
    if rc.code != 0 {
        return fail("data");
    }
    sink.extend(dic);
    Ok(())
}

fn decode_file(t: ref Crcs, data: ref Vec[u8], sink: mut ref Vec[u8]) -> Result[(), String] {
    if is_xz_magic(data, 0) {
        decode_xz(t, data, sink)
    } else if is_lzma(data) {
        decode_lzma(data, sink)
    } else {
        fail("format")
    }
}

// ------------------------------------------------------------ reading a file backwards

struct StreamInfo {
    start: i64,
    size: i64,
    check: i64,
    pad: i64,
    unpadded: Vec[i64],
    usizes: Vec[i64],
    uoff: i64,
    usize: i64,
}

fn round4(x: i64) -> i64 {
    (x + 3) / 4 * 4
}

// The streams of a file, found from its end as lzma_file_info_decoder
// finds them: padding, footer, index, then the matching header.
fn file_info(t: ref Crcs, data: ref Vec[u8]) -> Result[Vec[StreamInfo], String] {
    stream_header(t, data, 0, true)?;
    let mut streams: Vec[StreamInfo] = Vec.new();
    let mut pos = data.len();
    while pos > 0 {
        let mut pad: i64 = 0;
        while pos >= 4 and data[pos - 1] == 0 and data[pos - 2] == 0 and data[pos - 3] == 0 and data[pos - 4] == 0 {
            pos -= 4;
            pad += 4;
        }
        if pos < 24 {
            return fail("data");
        }
        let (bsize, cid) = stream_footer(t, data, pos - 12)?;
        let istart = pos - 12 - bsize;
        if istart < 12 {
            return fail("data");
        }
        if data[istart] != 0 {
            return fail("data");
        }
        let iend = pos - 12;
        let (n, p0) = vli(data, istart + 1, iend)?;
        let mut p = p0;
        let mut unpadded: Vec[i64] = Vec.new();
        let mut usizes: Vec[i64] = Vec.new();
        for _ in 0..n {
            let (a, q) = vli(data, p, iend)?;
            let (b, r) = vli(data, q, iend)?;
            if a < 5 {
                return fail("data");
            }
            unpadded.push(a);
            usizes.push(b);
            p = r;
        }
        while (p - istart) % 4 != 0 {
            if p >= iend or data[p] != 0 {
                return fail("data");
            }
            p += 1;
        }
        if p + 4 != iend or crc32_range(t, data, istart, p) != le_at(data, p, 4) {
            return fail("data");
        }
        let mut blocks: i64 = 0;
        for a in unpadded {
            blocks += round4(a);
        }
        let start = istart - blocks - 12;
        if start < 0 {
            return fail("data");
        }
        let hcid = match stream_header(t, data, start, false) {
            Ok(c) => c,
            Err(e) => return Err(if e == "format" { "data".to_string() } else { e }),
        };
        if hcid != cid {
            return fail("data");
        }
        let mut usize: i64 = 0;
        for b in usizes {
            usize += b;
        }
        streams.push(StreamInfo { start: start, size: pos - start, check: cid, pad: pad, unpadded: unpadded, usizes: usizes, uoff: 0, usize: usize });
        pos = start;
    }
    streams.reverse();
    let mut uoff: i64 = 0;
    for k in 0..streams.len() {
        streams[k].uoff = uoff;
        uoff += streams[k].usize;
    }
    Ok(streams)
}

// ------------------------------------------------------------ xz's number formats

const UNITS: Array[Str, 5] = ["B", "KiB", "MiB", "GiB", "TiB"];

// uint64_to_nicestr: bytes below 10000, else one decimal in the first
// unit that keeps it under 10000, with the byte count when asked.
fn nice(v: i64, also_bytes: bool) -> String {
    if v < 10000 {
        return f"{v} B";
    }
    let mut d = v as f64;
    let mut unit: i64 = 0;
    loop {
        d = d / 1024.0;
        unit += 1;
        if not (d > 9999.9 and unit < 4) {
            break;
        }
    }
    let name = UNITS[unit];
    let mut s = f"{d:.1} {name}";
    if also_bytes {
        s.push_str(f" ({v} B)");
    }
    s
}

fn ratio(c: i64, u: i64) -> String {
    if u == 0 {
        return "---".to_string();
    }
    let r = (c as f64) / (u as f64);
    if r > 9.999 { "---".to_string() } else { f"{r:.3}" }
}

fn add_check(ids: mut ref Vec[i64], id: i64) {
    if not ids.contains(id) {
        ids.push(id);
        ids.sort();
    }
}

fn check_names(ids: ref Vec[i64], sep: Str) -> String {
    let mut parts: Vec[String] = Vec.new();
    for id in ids {
        parts.push(check_name(id));
    }
    join(parts, sep)
}

fn dict_str(d: i64) -> String {
    if d % (1 << 20) == 0 {
        f"{d >> 20}MiB"
    } else if d % 1024 == 0 {
        f"{d >> 10}KiB"
    } else {
        f"{d}"
    }
}

// The filter chain as xz's --filters options.
fn filter_str(bh: ref BlockHeader) -> String {
    let mut parts: Vec[String] = Vec.new();
    let fprops = ref bh.fprops;
    for k in 0..bh.fids.len() {
        let props = ref fprops[k];
        let id = bh.fids[k];
        if id == 0x21 {
            let d = match dict_of_prop(props[0] as i64) {
                Ok(d) => d,
                Err(_) => 0,
            };
            parts.push(f"--lzma2=dict={dict_str(d)}");
        } else if id == 0x03 {
            parts.push(f"--delta=dist={(props[0] as i64) + 1}");
        } else if id == 0x04 {
            let start = if props.len() == 4 { le_at(props, 0, 4) } else { 0 };
            if start == 0 {
                parts.push("--x86".to_string());
            } else {
                parts.push(f"--x86=start={start}");
            }
        }
    }
    join(parts, " ")
}

// The decoder's memory in MiB, rounded up: the dictionary and the
// decoder's state.
fn mem_mib(bh: ref BlockHeader) -> i64 {
    let mut m: i64 = 32768;
    let fprops = ref bh.fprops;
    for k in 0..bh.fids.len() {
        if bh.fids[k] == 0x21 {
            let props = ref fprops[k];
            m += match dict_of_prop(props[0] as i64) {
                Ok(d) => d,
                Err(_) => 0,
            } + 30000;
        } else {
            m += 1024;
        }
    }
    (m + (1 << 20) - 1) >> 20
}

fn label(name: Str, value: Str) -> String {
    f"  {ljust(name, 18)} {value}\n"
}

// ------------------------------------------------------------ the commands

struct Job {
    out: String,
    err: String,
    status: i64,
}

fn set_exit(job: mut ref Job, rc: i64) {
    if rc > job.status {
        job.status = rc;
    }
}

fn is_file_path(p: Str) -> bool {
    match fs.metadata(p.to_string()) {
        Ok(m) => m.is_file,
        Err(_) => false,
    }
}

fn exists_path(p: Str) -> bool {
    fs.metadata(p.to_string()).is_ok()
}

fn read_input(path: Str) -> Option[Vec[u8]] {
    if not is_file_path(path) {
        return None;
    }
    match fs.read_bytes(path.to_string()) {
        Ok(b) => Some(b),
        Err(_) => None,
    }
}

fn message(e: Str) -> String {
    match e.to_string() {
        "eof" => "Unexpected end of input".to_string(),
        "data" => "Compressed data is corrupt".to_string(),
        "format" => "File format not recognized".to_string(),
        _ => "Unsupported options".to_string(),
    }
}

struct Totals {
    files: i64,
    streams: i64,
    blocks: i64,
    c: i64,
    u: i64,
    pad: i64,
    checks: Vec[i64],
    mem: i64,
    sizes: bool,
}

// The block headers of every stream, for -vv.
fn read_block_headers(t: ref Crcs, data: ref Vec[u8], streams: ref Vec[StreamInfo]) -> Result[Vec[BlockHeader], String] {
    let mut out: Vec[BlockHeader] = Vec.new();
    for s in streams {
        let mut off = s.start + 12;
        for a in s.unpadded {
            out.push(block_header(t, data, off, data.len())?);
            off += round4(a);
        }
    }
    Ok(out)
}

fn list_one(t: ref Crcs, job: mut ref Job, tot: mut ref Totals, f: Str, k: i64, nfiles: i64, verbose: i64, printed: mut ref i64, shown: mut ref bool) {
    let path = f"data/{f}";
    let Some(data) = read_input(path) else {
        job.err.push_str(f"xz: {f}: No such file or directory\n");
        set_exit(job, 1);
        return;
    };
    if data.len() == 0 {
        job.err.push_str(f"xz: {f}: File is empty\n");
        set_exit(job, 1);
        return;
    }
    if data.len() < 24 {
        job.err.push_str(f"xz: {f}: Too small to be a valid .xz file\n");
        set_exit(job, 1);
        return;
    }
    let streams = match file_info(t, data) {
        Ok(s) => s,
        Err(e) => {
            job.err.push_str(f"xz: {f}: {message(e)}\n");
            set_exit(job, 1);
            return;
        }
    };
    let mut headers: Vec[BlockHeader] = Vec.new();
    if verbose >= 2 {
        match read_block_headers(t, data, streams) {
            Ok(h) => headers = h,
            Err(e) => {
                job.err.push_str(f"xz: {f}: {message(e)}\n");
                set_exit(job, 1);
                return;
            }
        }
    }
    let nstreams = streams.len();
    let mut nblocks: i64 = 0;
    let mut usize: i64 = 0;
    let mut pad: i64 = 0;
    let mut checks: Vec[i64] = Vec.new();
    let mut maxcheck: i64 = 0;
    for s in streams {
        nblocks += s.unpadded.len();
        usize += s.usize;
        pad += s.pad;
        add_check(mut checks, s.check);
        add_check(tot.checks, s.check);
        if check_size(s.check) > maxcheck {
            maxcheck = check_size(s.check);
        }
    }
    let csize = data.len();
    tot.files += 1;
    tot.streams += nstreams;
    tot.blocks += nblocks;
    tot.c += csize;
    tot.u += usize;
    tot.pad += pad;
    if verbose == 0 {
        if not shown {
            job.out.push_str("Strms  Blocks   Compressed Uncompressed  Ratio  Check   Filename\n");
            shown = true;
        }
        job.out.push_str(f"{nstreams:5}  {nblocks:6}  {rjust(nice(csize, false), 11)}  {rjust(nice(usize, false), 11)}  {rjust(ratio(csize, usize), 5)}  {ljust(check_names(checks, ","), 7)} {f}\n");
        return;
    }
    if printed > 0 {
        job.out.push_str("\n");
    }
    printed += 1;
    let mut s = f"{f} ({k + 1}/{nfiles})\n";
    s.push_str(label("Streams:", f"{nstreams}"));
    s.push_str(label("Blocks:", f"{nblocks}"));
    s.push_str(label("Compressed size:", nice(csize, true)));
    s.push_str(label("Uncompressed size:", nice(usize, true)));
    s.push_str(label("Ratio:", ratio(csize, usize)));
    s.push_str(label("Check:", check_names(checks, ", ")));
    s.push_str(label("Stream Padding:", nice(pad, true)));
    s.push_str("  Streams:\n");
    s.push_str("    Stream    Blocks      CompOffset    UncompOffset        CompSize      UncompSize  Ratio  Check      Padding\n");
    for i in 0..nstreams {
        let st = ref streams[i];
        s.push_str(f"    {i + 1:6} {st.unpadded.len():9} {st.start:15} {st.uoff:15} {st.size:15} {st.usize:15}  {rjust(ratio(st.size, st.usize), 5)}  {ljust(check_name(st.check), 10)} {st.pad:7}\n");
    }
    let cw = if 2 * maxcheck > 8 { 2 * maxcheck } else { 8 };
    if nblocks > 0 {
        s.push_str("  Blocks:\n");
        let mut head = "    Stream     Block      CompOffset    UncompOffset       TotalSize      UncompSize  Ratio  Check".to_string();
        if verbose >= 2 {
            let cvh = ljust("CheckVal", cw);
            head.push_str(f"      {cvh}  Header  Flags        CompSize    MemUsage  Filters");
        }
        s.push_str(head);
        s.push_str("\n");
        let mut bi: i64 = 0;
        for i in 0..nstreams {
            let st = ref streams[i];
            let mut off = st.start + 12;
            let mut uoff = st.uoff;
            let csz = check_size(st.check);
            for j in 0..st.unpadded.len() {
                let a = st.unpadded[j];
                let b = st.usizes[j];
                let total = round4(a);
                let mut line = f"    {i + 1:6} {j + 1:9} {off:15} {uoff:15} {total:15} {b:15}  {rjust(ratio(total, b), 5)}  ";
                if verbose >= 2 {
                    let bh = ref headers[bi];
                    let mut cv = "---".to_string();
                    if csz > 0 {
                        let mut bytes = bytes_from(data, off + total - csz, off + total);
                        if csz != 32 {
                            bytes.reverse();
                        }
                        cv = hex_of(bytes);
                    }
                    let c = if bh.csize >= 0 { "c" } else { "-" };
                    let u = if bh.usize >= 0 { "u" } else { "-" };
                    line.push_str(f"{ljust(check_name(st.check), 10)} {ljust(cv, cw)} {bh.size:7}  {c}{u}    {a - bh.size - csz:15} {mem_mib(bh):7} MiB  {filter_str(bh)}");
                } else {
                    line.push_str(check_name(st.check));
                }
                s.push_str(line);
                s.push_str("\n");
                off += total;
                uoff += b;
                bi += 1;
            }
        }
    }
    if verbose >= 2 {
        let mut mem: i64 = 0;
        let mut sizes = true;
        for bh in headers {
            let m = mem_mib(bh);
            if m > mem {
                mem = m;
            }
            if bh.csize < 0 or bh.usize < 0 {
                sizes = false;
            }
        }
        if mem > tot.mem {
            tot.mem = mem;
        }
        if not sizes {
            tot.sizes = false;
        }
        s.push_str(label("Memory needed:", f"{mem} MiB"));
        s.push_str(label("Sizes in headers:", if sizes { "Yes" } else { "No" }));
        s.push_str("  Minimum XZ Utils version: 5.0.0\n");
    }
    job.out.push_str(s);
}

fn xz_list(t: ref Crcs, job: mut ref Job, files: ref Vec[String], verbose: i64) {
    let mut tot = Totals { files: 0, streams: 0, blocks: 0, c: 0, u: 0, pad: 0, checks: Vec.new(), mem: 0, sizes: true };
    let mut printed: i64 = 0;
    let mut shown = false;
    for k in 0..files.len() {
        list_one(t, job, mut tot, files[k], k, files.len(), verbose, mut printed, mut shown);
    }
    if tot.files <= 1 {
        return;
    }
    if verbose == 0 {
        job.out.push_str("-".repeat(79));
        job.out.push_str("\n");
        job.out.push_str(f"{tot.streams:5}  {tot.blocks:6}  {rjust(nice(tot.c, false), 11)}  {rjust(nice(tot.u, false), 11)}  {rjust(ratio(tot.c, tot.u), 5)}  {ljust(check_names(tot.checks, ","), 7)} {tot.files} files\n");
        return;
    }
    let mut s = "\nTotals:\n".to_string();
    s.push_str(label("Number of files:", f"{tot.files}"));
    s.push_str(label("Streams:", f"{tot.streams}"));
    s.push_str(label("Blocks:", f"{tot.blocks}"));
    s.push_str(label("Compressed size:", nice(tot.c, true)));
    s.push_str(label("Uncompressed size:", nice(tot.u, true)));
    s.push_str(label("Ratio:", ratio(tot.c, tot.u)));
    s.push_str(label("Check:", check_names(tot.checks, ", ")));
    s.push_str(label("Stream Padding:", nice(tot.pad, true)));
    if verbose >= 2 {
        s.push_str(label("Memory needed:", f"{tot.mem} MiB"));
        s.push_str(label("Sizes in headers:", if tot.sizes { "Yes" } else { "No" }));
        s.push_str("  Minimum XZ Utils version: 5.0.0\n");
    }
    job.out.push_str(s);
}

// The name -d writes: .xz and .lzma are dropped, .txz and .tlz become .tar.
fn out_name(f: Str) -> Option[String] {
    for (suf, rep) in [(".xz", ""), (".txz", ".tar"), (".lzma", ""), (".tlz", ".tar")] {
        if f.ends_with(suf) and f.len() > suf.len() {
            return Some(f"{slice(f, 0, f.len() - suf.len())}{rep}");
        }
    }
    None
}

fn xz(t: ref Crcs, job: mut ref Job, args: ref Vec[String]) {
    let mut mode = b'z';
    let mut keep = false;
    let mut tostd = false;
    let mut force = false;
    let mut verbose: i64 = 0;
    let mut files: Vec[String] = Vec.new();
    for a in args {
        let b = to_bytes(a);
        if b.len() > 1 and b[0] == b'-' {
            for ch in b[1..].to_vec() {
                if ch == b'd' or ch == b't' or ch == b'l' {
                    mode = ch;
                } else if ch == b'k' {
                    keep = true;
                } else if ch == b'c' {
                    tostd = true;
                } else if ch == b'f' {
                    force = true;
                } else if ch == b'v' {
                    verbose += 1;
                }
            }
        } else {
            files.push(a.clone());
        }
    }
    if mode == b'l' {
        xz_list(t, job, files, verbose);
        return;
    }
    for f in files {
        let path = f"data/{f}";
        let Some(data) = read_input(path) else {
            job.err.push_str(f"xz: {f}: No such file or directory\n");
            set_exit(job, 1);
            continue;
        };
        let mut outp = String.new();
        if mode == b'd' and not tostd {
            let Some(on) = out_name(f) else {
                job.err.push_str(f"xz: {f}: Filename has an unknown suffix, skipping\n");
                set_exit(job, 2);
                continue;
            };
            outp = f"data/{on}";
            if exists_path(outp) and not force {
                job.err.push_str(f"xz: {on}: File exists\n");
                set_exit(job, 1);
                continue;
            }
        }
        let mut sink: Vec[u8] = Vec.new();
        if let Err(e) = decode_file(t, data, mut sink) {
            job.err.push_str(f"xz: {f}: {message(e)}\n");
            set_exit(job, 1);
            continue;
        }
        let n = sink.len();
        if mode == b'd' {
            if tostd {
                job.out.push_str(from_bytes(sink));
            } else {
                if let Err(e) = fs.write_bytes(outp.clone(), sink) {
                    job.err.push_str(f"xz: {outp}: {e}\n");
                    set_exit(job, 1);
                    continue;
                }
                if not keep {
                    let _ = fs.remove_file(path);
                }
            }
        }
        if verbose > 0 {
            let r = if n > 0 { (data.len() as f64) / (n as f64) } else { 16.0 };
            let rs = if r > 9.999 { " > 9.999".to_string() } else { f" = {r:.3}" };
            job.err.push_str(f"{f}: {nice(data.len(), false)} / {nice(n, false)}{rs}\n");
        }
    }
}

fn sha256sum(job: mut ref Job, args: ref Vec[String]) {
    for f in args {
        let path = f"data/{f}";
        match read_input(path) {
            Some(b) => job.out.push_str(f"{hex_of(sha256(b))}  {f}\n"),
            None => {
                job.err.push_str(f"sha256sum: {f}: No such file or directory\n");
                set_exit(job, 1);
            }
        }
    }
}

// ------------------------------------------------------------ the files

