// mini_readelf: GNU readelf 2.42 for x86-64 ELF files, written from the
// ELF and gABI specs and binutils' output formats, with a checksec
// table, the dynamic loader's version and symbol checks, and hash-table
// lookups done the way ld.so does them:
// - the file header, section headers with their flags, program headers
//   with the section-to-segment mapping, the dynamic section;
// - relocations with their x86-64 types, symbol tables with symbol
//   versions, the version sections, notes (build id, ABI tag, x86
//   properties), hex and string dumps, and the bucket histograms;
// - readelf's errors and warnings on truncated and damaged files;
// - a checksec table (RELRO, canary, NX, PIE, RPATH, RUNPATH, FORTIFY,
//   CET), a loader check that resolves each needed library, version
//   and symbol, and lookups through .gnu.hash's bloom filter and chains
//   and through the old SysV .hash.
//
// The inputs are the files in data/, compiled with gcc 13.3 and
// binutils 2.42. expected.out is the output of oracle.py, the same
// program in Python; its readelf half is byte-identical to GNU readelf.
// ------------------------------------------------------------ bytes and text

fn byte_str(b: ref Vec[u8], from: i64, to: i64) -> String {
    let mut v: Vec[u8] = Vec.new();
    for i in from..to {
        v.push(b[i]);
    }
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn to_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn from_bytes(v: Vec[u8]) -> String {
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn is_alpha(c: u8) -> bool {
    (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z')
}

fn is_alnum(c: u8) -> bool {
    is_digit(c) or is_alpha(c)
}

// White space, as `\s` and str.strip see it.
fn is_ws(c: u8) -> bool {
    c == b' ' or c == b'\t' or c == b'\n' or c == b'\r' or c == 11 or c == 12
}

fn lower_byte(c: u8) -> u8 {
    if c >= b'A' and c <= b'Z' { c + 32 } else { c }
}

fn lower(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        out.push(lower_byte(b[i]));
    }
    from_bytes(out)
}

fn strip(s: Str) -> String {
    let b = to_bytes(s);
    let mut i: i64 = 0;
    let mut j = b.len();
    while i < j and is_ws(b[i]) {
        i += 1;
    }
    while j > i and is_ws(b[j - 1]) {
        j -= 1;
    }
    byte_str(b, i, j)
}

fn split_ws(s: Str) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        while i < b.len() and is_ws(b[i]) {
            i += 1;
        }
        let st = i;
        while i < b.len() and not is_ws(b[i]) {
            i += 1;
        }
        if i > st {
            out.push(byte_str(b, st, i));
        }
    }
    out
}

fn split_on(s: Str, sep: u8) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut st: i64 = 0;
    for i in 0..b.len() {
        if b[i] == sep {
            out.push(byte_str(b, st, i));
            st = i + 1;
        }
    }
    out.push(byte_str(b, st, b.len()));
    out
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

// The lines of a file, without their newlines.
fn lines_of(text: Str) -> Vec[String] {
    let mut v = split_on(text, b'\n');
    if v.len() > 0 and v[v.len() - 1].len() == 0 {
        v.pop();
    }
    v
}

// Python's repr of a str.
fn py_repr(s: Str) -> String {
    let b = to_bytes(s);
    let mut has_single = false;
    let mut has_double = false;
    for i in 0..b.len() {
        if b[i] == b'\'' {
            has_single = true;
        }
        if b[i] == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let hex = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    out.push(q);
    let mut skip = false;
    for i in 0..b.len() {
        let c = b[i];
        if skip {
            skip = false;
            continue;
        }
        // U+0080 to U+00A0 and U+00AD are not printable either
        let next: u8 = if i + 1 < b.len() { b[i + 1] } else { 0 };
        if c == 0xC2 and next >= 0x80 and (next <= 0xA0 or next == 0xAD) {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(next / 16) as i64]);
            out.push(hex[(next % 16) as i64]);
            skip = true;
        } else if c == q or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c < 32 or c == 127 {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    from_bytes(out)
}

fn upper(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        let c = b[i];
        out.push(if c >= b'a' and c <= b'z' { c - 32 } else { c });
    }
    from_bytes(out)
}

// Whether `pat` occurs in `b` at `i`.
fn starts_at(b: ref Vec[u8], i: i64, pat: Str) -> bool {
    let p = to_bytes(pat);
    if i < 0 or i + p.len() > b.len() {
        return false;
    }
    for k in 0..p.len() {
        if b[i + k] != p[k] {
            return false;
        }
    }
    true
}

fn starts_with(s: Str, pat: Str) -> bool {
    starts_at(to_bytes(s), 0, pat)
}

fn find_str(s: Str, pat: Str) -> i64 {
    let b = to_bytes(s);
    for i in 0..b.len() + 1 {
        if starts_at(b, i, pat) {
            return i;
        }
    }
    -1
}

fn first_byte(s: Str) -> u8 {
    let b = to_bytes(s);
    if b.len() > 0 { b[0] } else { 0 }
}

fn slice_from(s: Str, i: i64) -> String {
    let b = to_bytes(s);
    byte_str(b, i, b.len())
}

fn is_hex(c: u8) -> bool {
    is_digit(c) or (c >= b'a' and c <= b'f') or (c >= b'A' and c <= b'F')
}

fn hex_val(c: u8) -> u8 {
    if is_digit(c) {
        c - b'0'
    } else if c >= b'a' and c <= b'f' {
        c - b'a' + 10
    } else {
        c - b'A' + 10
    }
}

fn find_byte(s: Str, c: u8) -> i64 {
    let b = to_bytes(s);
    for i in 0..b.len() {
        if b[i] == c {
            return i;
        }
    }
    -1
}

fn rfind_byte(s: Str, c: u8) -> i64 {
    let b = to_bytes(s);
    let mut i = b.len() - 1;
    while i >= 0 {
        if b[i] == c {
            return i;
        }
        i -= 1;
    }
    -1
}

fn has_byte(s: Str, c: u8) -> bool {
    find_byte(s, c) >= 0
}

fn slice(s: Str, from: i64, to: i64) -> String {
    byte_str(to_bytes(s), from, to)
}

// str.partition and str.rpartition on one byte: (before, found, after).
fn partition(s: Str, c: u8) -> (String, bool, String) {
    let i = find_byte(s, c);
    if i < 0 {
        return (s.to_string(), false, String.new());
    }
    (slice(s, 0, i), true, slice_from(s, i + 1))
}

fn rpartition(s: Str, c: u8) -> (String, bool, String) {
    let i = rfind_byte(s, c);
    if i < 0 {
        return (String.new(), false, s.to_string());
    }
    (slice(s, 0, i), true, slice_from(s, i + 1))
}

// Python's repr of a bytes object.
fn bytes_repr(b: ref Vec[u8]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for i in 0..b.len() {
        if b[i] == b'\'' {
            has_single = true;
        }
        if b[i] == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let hex = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    out.push(b'b');
    out.push(q);
    for i in 0..b.len() {
        let c = b[i];
        if c == q or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c < 32 or c >= 127 {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    from_bytes(out)
}

fn is_ascii(s: Str) -> bool {
    let b = to_bytes(s);
    for i in 0..b.len() {
        if b[i] >= 0x80 {
            return false;
        }
    }
    true
}

fn py_int(s: Str) -> Option[i64] {
    let b = to_bytes(strip(s));
    let mut i: i64 = 0;
    let mut neg = false;
    if i < b.len() and (b[i] == b'+' or b[i] == b'-') {
        neg = b[i] == b'-';
        i += 1;
    }
    if i >= b.len() {
        return None;
    }
    let mut n: i64 = 0;
    let mut prev_digit = false;
    while i < b.len() {
        let c = b[i];
        if is_digit(c) {
            n = n * 10 + (c - b'0') as i64;
            prev_digit = true;
        } else if c == b'_' and prev_digit and i + 1 < b.len() and is_digit(b[i + 1]) {
            prev_digit = false;
        } else {
            return None;
        }
        i += 1;
    }
    if neg { Some(-n) } else { Some(n) }
}

// The code points of a string.
fn code_points(s: Str) -> Vec[i64] {
    let b = to_bytes(s);
    let mut out: Vec[i64] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | (b[i + 1] as i64 & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | ((b[i + 1] as i64 & 0x3F) << 6) | (b[i + 2] as i64 & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | ((b[i + 1] as i64 & 0x3F) << 12) | ((b[i + 2] as i64 & 0x3F) << 6) | (b[i + 3] as i64 & 0x3F));
            i += 4;
        }
    }
    out
}

fn push_code_point(out: mut ref Vec[u8], cp: i64) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push(((cp >> 6) | 0xC0) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    } else if cp < 0x10000 {
        out.push(((cp >> 12) | 0xE0) as u8);
        out.push((((cp >> 6) & 0x3F) | 0x80) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    } else {
        out.push(((cp >> 18) | 0xF0) as u8);
        out.push((((cp >> 12) & 0x3F) | 0x80) as u8);
        out.push((((cp >> 6) & 0x3F) | 0x80) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    }
}

fn ljust(s: Str, width: i64) -> String {
    let mut out = s.to_string();
    while out.len() < width {
        out.push_str(" ");
    }
    out
}

fn rjust(s: Str, width: i64) -> String {
    let mut out = String.new();
    let mut n = s.len();
    while n < width {
        out.push_str(" ");
        n += 1;
    }
    out.push_str(s);
    out
}

fn plural(n: i64, one: Str, many: Str) -> String {
    if n == 1 { one.to_string() } else { many.to_string() }
}

// ------------------------------------------------------------ the file

// A little-endian unsigned field of n bytes. Eight-byte fields keep
// their bit pattern, so an addend of -4 reads as -4.
fn le(b: ref Vec[u8], i: i64, n: i64) -> i64 {
    let mut v: i64 = 0;
    let mut k = n - 1;
    while k >= 0 {
        v = (v << 8) | b[i + k] as i64;
        k -= 1;
    }
    v
}

#[derive(Clone)]
struct Sec {
    name: i64,
    typ: i64,
    flags: i64,
    addr: i64,
    off: i64,
    size: i64,
    link: i64,
    info: i64,
    align: i64,
    es: i64,
}

#[derive(Clone)]
struct Phdr {
    typ: i64,
    flags: i64,
    off: i64,
    va: i64,
    pa: i64,
    fs: i64,
    ms: i64,
    al: i64,
}

const SHT_SYMTAB: i64 = 2;
const SHT_RELA: i64 = 4;
const SHT_NOTE: i64 = 7;
const SHT_NOBITS: i64 = 8;
const SHT_DYNSYM: i64 = 11;
const SHT_VERDEF: i64 = 0x6ffffffd;
const SHT_VERNEED: i64 = 0x6ffffffe;
const SHT_VERSYM: i64 = 0x6fffffff;

const PT_DYNAMIC: i64 = 2;
const PT_INTERP: i64 = 3;
const PT_NOTE: i64 = 4;
const PT_PHDR: i64 = 6;
const PT_TLS: i64 = 7;
const PT_GNU_STACK: i64 = 0x6474e551;
const PT_GNU_RELRO: i64 = 0x6474e552;

const DT_NULL: i64 = 0;
const DT_NEEDED: i64 = 1;
const DT_HASH: i64 = 4;
const DT_STRTAB: i64 = 5;
const DT_SONAME: i64 = 14;
const DT_RPATH: i64 = 15;
const DT_DEBUG: i64 = 21;
const DT_BIND_NOW: i64 = 24;
const DT_RUNPATH: i64 = 29;
const DT_FLAGS: i64 = 30;
const DT_GNU_HASH: i64 = 0x6ffffef5;
const DT_FLAGS_1: i64 = 0x6ffffffb;

const SHF_ALLOC: i64 = 2;
const SHF_TLS: i64 = 0x400;

struct Elf {
    name: String,
    b: Vec[u8],
    phoff: i64,
    phnum: i64,
    shoff: i64,
    shnum: i64,
    shstrndx: i64,
    // the section headers, when they could be read
    has_secs: bool,
    secs: Vec[Sec],
    has_strings: bool,
    shdr_error: String,
    phdrs: Vec[Phdr],
    // the dynamic entries up to DT_NULL, read through PT_DYNAMIC
    has_dyn: bool,
    dyn_error: bool,
    dyn_off: i64,
    dyn: Vec[(i64, i64)],
}

fn read_elf(name: Str, data: own Vec[u8]) -> Elf {
    let mut e = Elf {
        name: name.to_string(),
        b: data,
        phoff: 0,
        phnum: 0,
        shoff: 0,
        shnum: 0,
        shstrndx: 0,
        has_secs: false,
        secs: Vec.new(),
        has_strings: false,
        shdr_error: String.new(),
        phdrs: Vec.new(),
        has_dyn: false,
        dyn_error: false,
        dyn_off: 0,
        dyn: Vec.new(),
    };
    let b = ref e.b;
    e.phoff = le(b, 0x20, 8);
    e.shoff = le(b, 0x28, 8);
    e.phnum = le(b, 0x38, 2);
    e.shnum = le(b, 0x3c, 2);
    e.shstrndx = le(b, 0x3e, 2);
    if e.shnum > 0 {
        let size = e.shnum * le(b, 0x3a, 2);
        if e.shoff + size > b.len() {
            e.shdr_error = f"readelf: Error: Reading {size} bytes extends past end of file for section headers";
        } else {
            for k in 0..e.shnum {
                let p = e.shoff + 64 * k;
                e.secs.push(Sec {
                    name: le(b, p, 4),
                    typ: le(b, p + 4, 4),
                    flags: le(b, p + 8, 8),
                    addr: le(b, p + 16, 8),
                    off: le(b, p + 24, 8),
                    size: le(b, p + 32, 8),
                    link: le(b, p + 40, 4),
                    info: le(b, p + 44, 4),
                    align: le(b, p + 48, 8),
                    es: le(b, p + 56, 8),
                });
            }
            e.has_secs = true;
        }
    }
    e.has_strings = e.has_secs and e.shstrndx < e.shnum;
    for k in 0..e.phnum {
        let p = e.phoff + 56 * k;
        e.phdrs.push(Phdr {
            typ: le(b, p, 4),
            flags: le(b, p + 4, 4),
            off: le(b, p + 8, 8),
            va: le(b, p + 16, 8),
            pa: le(b, p + 24, 8),
            fs: le(b, p + 32, 8),
            ms: le(b, p + 40, 8),
            al: le(b, p + 48, 8),
        });
    }
    for k in 0..e.phdrs.len() {
        let p = e.phdrs[k].clone();
        if p.typ == PT_DYNAMIC {
            if p.off + p.fs > b.len() {
                e.dyn_error = true;
                break;
            }
            for i in 0..p.fs / 16 {
                let t = le(b, p.off + 16 * i, 8);
                let v = le(b, p.off + 16 * i + 8, 8);
                e.dyn.push((t, v));
                if t == DT_NULL {
                    break;
                }
            }
            e.has_dyn = true;
            e.dyn_off = p.off;
            break;
        }
    }
    e
}

fn dyn_error_text() -> String {
    "readelf: Error: the dynamic segment offset + size exceeds the size of the file".to_string()
}

// A NUL-terminated string at a file offset.
fn cstr(e: ref Elf, at: i64) -> String {
    let b = ref e.b;
    let mut end = at;
    while end < b.len() and b[end] != 0 {
        end += 1;
    }
    byte_str(b, at, end)
}

fn sec_name(e: ref Elf, s: ref Sec) -> String {
    if not e.has_strings {
        return "<no-strings>".to_string();
    }
    let st = ref e.secs[e.shstrndx];
    if s.name >= st.size {
        return "<corrupt>".to_string();
    }
    cstr(e, st.off + s.name)
}

fn name_of(e: ref Elf, k: i64) -> String {
    sec_name(e, e.secs[k])
}

fn dyn_tag(e: ref Elf, tag: i64) -> Option[i64] {
    for (t, v) in e.dyn {
        if *t == tag {
            return Some(*v);
        }
    }
    None
}

fn is_pie(e: ref Elf) -> bool {
    for (t, v) in e.dyn {
        if *t == DT_FLAGS_1 {
            return (*v & 0x08000000) != 0;
        }
    }
    false
}

fn elf_type(e: ref Elf) -> i64 {
    le(e.b, 0x10, 2)
}

fn file_type(e: ref Elf) -> String {
    let t = elf_type(e);
    if t == 1 {
        "REL (Relocatable file)".to_string()
    } else if t == 2 {
        "EXEC (Executable file)".to_string()
    } else if t == 3 {
        if is_pie(e) { "DYN (Position-Independent Executable file)".to_string() } else { "DYN (Shared object file)".to_string() }
    } else if t == 4 {
        "CORE (Core file)".to_string()
    } else {
        f"<unknown>: {t:x}"
    }
}

fn vaddr_to_off(e: ref Elf, a: i64) -> Option[i64] {
    for p in e.phdrs {
        if p.typ == 1 and p.va <= a and a < p.va + p.fs {
            return Some(a - p.va + p.off);
        }
    }
    None
}

fn dyn_strtab(e: ref Elf) -> Option[i64] {
    match dyn_tag(e, DT_STRTAB) {
        Some(a) => vaddr_to_off(e, a),
        None => None,
    }
}

// ------------------------------------------------------------ -h

fn header_row(out: mut ref String, label: Str, val: Str) {
    out.push_str("  ");
    out.push_str(ljust(f"{label}:", 35));
    out.push_str(val);
    out.push_str("\n");
}

fn file_header(out: mut ref String, e: ref Elf) {
    let b = ref e.b;
    out.push_str("ELF Header:\n  Magic:   ");
    for k in 0..16 {
        let c = b[k];
        out.push_str(f"{c:02x} ");
    }
    out.push_str("\n");
    let class = if b[4] == 1 { "ELF32".to_string() } else if b[4] == 2 { "ELF64".to_string() } else if b[4] == 0 { "none".to_string() } else { f"<unknown: {b[4]:x}>" };
    header_row(mut out, "Class", class);
    let data = if b[5] == 1 { "2's complement, little endian".to_string() } else if b[5] == 2 { "2's complement, big endian".to_string() } else { f"<unknown: {b[5]:x}>" };
    header_row(mut out, "Data", data);
    let v = b[6];
    header_row(mut out, "Version", if v == 1 { f"{v} (current)" } else { f"{v} <unknown>" });
    let osabi = if b[7] == 0 { "UNIX - System V".to_string() } else if b[7] == 3 { "UNIX - GNU".to_string() } else { f"<unknown: {b[7]:x}>" };
    header_row(mut out, "OS/ABI", osabi);
    header_row(mut out, "ABI Version", f"{b[8]}");
    header_row(mut out, "Type", file_type(e));
    let mach = le(b, 0x12, 2);
    header_row(mut out, "Machine", if mach == 62 { "Advanced Micro Devices X86-64".to_string() } else { f"<unknown>: 0x{mach:x}" });
    header_row(mut out, "Version", f"0x{le(b, 0x14, 4):x}");
    header_row(mut out, "Entry point address", f"0x{le(b, 0x18, 8):x}");
    header_row(mut out, "Start of program headers", f"{e.phoff} (bytes into file)");
    header_row(mut out, "Start of section headers", f"{e.shoff} (bytes into file)");
    header_row(mut out, "Flags", f"0x{le(b, 0x30, 4):x}");
    header_row(mut out, "Size of this header", f"{le(b, 0x34, 2)} (bytes)");
    header_row(mut out, "Size of program headers", f"{le(b, 0x36, 2)} (bytes)");
    header_row(mut out, "Number of program headers", f"{e.phnum}");
    header_row(mut out, "Size of section headers", f"{le(b, 0x3a, 2)} (bytes)");
    header_row(mut out, "Number of section headers", f"{e.shnum}");
    let corrupt = if e.shstrndx >= e.shnum { " <corrupt: out of range>" } else { "" };
    header_row(mut out, "Section header string table index", f"{e.shstrndx}{corrupt}");
}

// ------------------------------------------------------------ -S

fn sec_type_name(t: i64) -> String {
    let s = match t {
        0 => "NULL",
        1 => "PROGBITS",
        2 => "SYMTAB",
        3 => "STRTAB",
        4 => "RELA",
        5 => "HASH",
        6 => "DYNAMIC",
        7 => "NOTE",
        8 => "NOBITS",
        9 => "REL",
        10 => "SHLIB",
        11 => "DYNSYM",
        14 => "INIT_ARRAY",
        15 => "FINI_ARRAY",
        16 => "PREINIT_ARRAY",
        17 => "GROUP",
        0x6ffffff6 => "GNU_HASH",
        0x6ffffffd => "VERDEF",
        0x6ffffffe => "VERNEED",
        0x6fffffff => "VERSYM",
        0x70000001 => "X86_64_UNWIND",
        _ => "",
    };
    if s.len() == 0 { f"{t:08x}: <unknown>" } else { s.to_string() }
}

fn flags_str(f: i64) -> String {
    let bits: Vec[i64] = vec![1, 2, 4, 0x10, 0x20, 0x40, 0x80, 0x100, 0x200, 0x400, 0x800, 0x10000000, 0x80000000];
    let letters = to_bytes("WAXMSILOGTClE");
    let mut out: Vec[u8] = Vec.new();
    for k in 0..bits.len() {
        if f & bits[k] != 0 {
            out.push(letters[k]);
        }
    }
    from_bytes(out)
}

fn section_headers(out: mut ref String, e: ref Elf, do_header: bool) {
    if e.shnum == 0 {
        out.push_str("\nThere are no sections in this file.\n");
        return;
    }
    if not do_header {
        out.push_str(f"There are {e.shnum} section headers, starting at offset 0x{e.shoff:x}:\n");
    }
    if not e.has_secs {
        return;
    }
    out.push_str(if e.shnum > 1 { "\nSection Headers:\n" } else { "\nSection Header:\n" });
    out.push_str("  [Nr] Name              Type            Address          Off    Size   ES Flg Lk Inf Al\n");
    for k in 0..e.secs.len() {
        let s = ref e.secs[k];
        out.push_str(f"  [{k:2}] {ljust(sec_name(e, s), 17)} {ljust(sec_type_name(s.typ), 15)} {s.addr:016x} {s.off:06x} {s.size:06x} {s.es:02x} {rjust(flags_str(s.flags), 3)} {s.link:2} {s.info:3} {s.align:2}\n");
    }
    out.push_str("Key to Flags:\n");
    out.push_str("  W (write), A (alloc), X (execute), M (merge), S (strings), I (info),\n");
    out.push_str("  L (link order), O (extra OS processing required), G (group), T (TLS),\n");
    out.push_str("  C (compressed), x (unknown), o (OS specific), E (exclude),\n");
    out.push_str("  D (mbind), l (large), p (processor specific)\n");
}

// ------------------------------------------------------------ -l

fn seg_type_name(t: i64) -> String {
    let s = match t {
        0 => "NULL",
        1 => "LOAD",
        2 => "DYNAMIC",
        3 => "INTERP",
        4 => "NOTE",
        5 => "SHLIB",
        6 => "PHDR",
        7 => "TLS",
        0x6474e550 => "GNU_EH_FRAME",
        0x6474e551 => "GNU_STACK",
        0x6474e552 => "GNU_RELRO",
        0x6474e553 => "GNU_PROPERTY",
        0x6474e554 => "GNU_SFRAME",
        _ => "",
    };
    if s.len() == 0 { f"LOPROC+{t:x}" } else { s.to_string() }
}

// x <= n - 1, as C computes it in unsigned arithmetic.
fn le_last(x: i64, n: i64) -> bool {
    n == 0 or x <= n - 1
}

// binutils' ELF_SECTION_IN_SEGMENT_STRICT.
fn in_segment(s: ref Sec, p: ref Phdr) -> bool {
    let tls = s.flags & SHF_TLS != 0;
    let alloc = s.flags & SHF_ALLOC != 0;
    let nobits = s.typ == SHT_NOBITS;
    let pt = p.typ;
    let size = if tls and nobits and pt != PT_TLS { 0 } else { s.size };
    let tls_ok = tls and (pt == PT_TLS or pt == PT_GNU_RELRO or pt == 1);
    let plain_ok = not tls and pt != PT_TLS and pt != PT_PHDR;
    if not (tls_ok or plain_ok) {
        return false;
    }
    let alloc_only = pt == 1 or pt == PT_DYNAMIC or pt == 0x6474e550 or pt == PT_GNU_STACK or pt == PT_GNU_RELRO or pt == 0x6474e554;
    if not alloc and alloc_only {
        return false;
    }
    if not nobits {
        if not (s.off >= p.off and le_last(s.off - p.off, p.fs) and s.off - p.off + size <= p.fs) {
            return false;
        }
    }
    if alloc {
        if not (s.addr >= p.va and le_last(s.addr - p.va, p.ms) and s.addr - p.va + size <= p.ms) {
            return false;
        }
    }
    if (pt == PT_DYNAMIC or pt == PT_NOTE) and s.size == 0 and p.ms != 0 {
        let ok_off = nobits or (s.off > p.off and s.off - p.off < p.fs);
        let ok_addr = not alloc or (s.addr > p.va and s.addr - p.va < p.ms);
        if not (ok_off and ok_addr) {
            return false;
        }
    }
    true
}

fn program_headers(out: mut ref String, e: ref Elf, do_header: bool) {
    if e.phnum == 0 {
        out.push_str("\nThere are no program headers in this file.\n");
        return;
    }
    if not do_header {
        out.push_str(f"\nElf file type is {file_type(e)}\n");
        out.push_str(f"Entry point 0x{le(e.b, 0x18, 8):x}\n");
        out.push_str(f"There are {e.phnum} program headers, starting at offset {e.phoff}\n");
    }
    out.push_str(if e.phnum > 1 { "\nProgram Headers:\n" } else { "\nProgram Header:\n" });
    out.push_str("  Type           Offset   VirtAddr           PhysAddr           FileSiz  MemSiz   Flg Align\n");
    for p in e.phdrs {
        let r = if p.flags & 4 != 0 { "R" } else { " " };
        let w = if p.flags & 2 != 0 { "W" } else { " " };
        let x = if p.flags & 1 != 0 { "E" } else { " " };
        let al = if p.al != 0 { f"0x{p.al:x}" } else { "0".to_string() };
        out.push_str(f"  {ljust(seg_type_name(p.typ), 14)} 0x{p.off:06x} 0x{p.va:016x} 0x{p.pa:016x} 0x{p.fs:06x} 0x{p.ms:06x} {r}{w}{x} {al}\n");
        if p.typ == PT_INTERP {
            out.push_str(f"      [Requesting program interpreter: {cstr(e, p.off)}]\n");
        }
    }
    if not e.has_secs {
        return;
    }
    out.push_str("\n Section to Segment mapping:\n  Segment Sections...\n");
    for k in 0..e.phdrs.len() {
        let p = ref e.phdrs[k];
        out.push_str(f"   {k:02}     ");
        for j in 1..e.secs.len() {
            let s = ref e.secs[j];
            let tbss = s.flags & SHF_TLS != 0 and s.typ == SHT_NOBITS and p.typ != PT_TLS;
            if not tbss and in_segment(s, p) {
                out.push_str(sec_name(e, s));
                out.push_str(" ");
            }
        }
        out.push_str("\n");
    }
}

// ------------------------------------------------------------ -d

fn dyn_type_name(t: i64) -> String {
    let s = match t {
        0 => "NULL",
        1 => "NEEDED",
        2 => "PLTRELSZ",
        3 => "PLTGOT",
        4 => "HASH",
        5 => "STRTAB",
        6 => "SYMTAB",
        7 => "RELA",
        8 => "RELASZ",
        9 => "RELAENT",
        10 => "STRSZ",
        11 => "SYMENT",
        12 => "INIT",
        13 => "FINI",
        14 => "SONAME",
        15 => "RPATH",
        16 => "SYMBOLIC",
        17 => "REL",
        18 => "RELSZ",
        19 => "RELENT",
        20 => "PLTREL",
        21 => "DEBUG",
        22 => "TEXTREL",
        23 => "JMPREL",
        24 => "BIND_NOW",
        25 => "INIT_ARRAY",
        26 => "FINI_ARRAY",
        27 => "INIT_ARRAYSZ",
        28 => "FINI_ARRAYSZ",
        29 => "RUNPATH",
        30 => "FLAGS",
        32 => "PREINIT_ARRAY",
        33 => "PREINIT_ARRAYSZ",
        0x6ffffef5 => "GNU_HASH",
        0x6ffffff0 => "VERSYM",
        0x6ffffff9 => "RELACOUNT",
        0x6ffffffa => "RELCOUNT",
        0x6ffffffb => "FLAGS_1",
        0x6ffffffc => "VERDEF",
        0x6ffffffd => "VERDEFNUM",
        0x6ffffffe => "VERNEED",
        0x6fffffff => "VERNEEDNUM",
        _ => "",
    };
    if s.len() == 0 { f"<unknown>: {t:x}" } else { s.to_string() }
}

const DF_1_NAMES: Array[Str, 31] = ["NOW", "GLOBAL", "GROUP", "NODELETE", "LOADFLTR", "INITFIRST", "NOOPEN", "ORIGIN", "DIRECT",
    "TRANS", "INTERPOSE", "NODEFLIB", "NODUMP", "CONFALT", "ENDFILTEE", "DISPRELDNE", "DISPRELPND",
    "NODIRECT", "IGNMULDEF", "NOKSYMS", "NOHDR", "EDITED", "NORELOC", "SYMINTPOSE", "GLOBAUDIT",
    "SINGLETON", "STUB", "PIE", "KMOD", "WEAKFILTER", "NOCOMMON"];

fn dyn_value(e: ref Elf, strtab: Option[i64], t: i64, v: i64) -> String {
    if t == DT_NEEDED or t == DT_SONAME or t == DT_RPATH or t == DT_RUNPATH {
        let label = if t == DT_NEEDED { "Shared library" } else if t == DT_SONAME { "Library soname" } else if t == DT_RPATH { "Library rpath" } else { "Library runpath" };
        return match strtab {
            Some(st) => f"{label}: [{cstr(e, st + v)}]",
            None => f"0x{v:x}",
        };
    }
    if t == DT_FLAGS {
        let names: Vec[Str] = vec!["ORIGIN", "SYMBOLIC", "TEXTREL", "BIND_NOW", "STATIC_TLS"];
        let mut parts: Vec[String] = Vec.new();
        for k in 0..names.len() {
            if (v >> k) & 1 != 0 {
                parts.push(names[k].to_string());
            }
        }
        return join(parts, " ");
    }
    if t == DT_FLAGS_1 {
        let mut s = "Flags:".to_string();
        for k in 0..31 {
            if (v >> k) & 1 != 0 {
                let name = DF_1_NAMES[k];
                s.push_str(" ");
                s.push_str(name);
            }
        }
        return s;
    }
    if t == 20 {
        return dyn_type_name(v);
    }
    if t == 2 or t == 8 or t == 9 or t == 10 or t == 11 or t == 18 or t == 19 or t == 27 or t == 28 or t == 33 {
        return f"{v} (bytes)";
    }
    if t == 0x6ffffffd or t == 0x6fffffff or t == 0x6ffffff9 or t == 0x6ffffffa {
        return f"{v}";
    }
    f"0x{v:x}"
}

fn dynamic_section(out: mut ref String, e: ref Elf) {
    if not e.has_dyn {
        out.push_str("\nThere is no dynamic section in this file.\n");
        return;
    }
    let n = e.dyn.len();
    out.push_str(f"\nDynamic section at offset 0x{e.dyn_off:x} contains {n} {plural(n, "entry", "entries")}:\n");
    out.push_str("  Tag        Type                         Name/Value\n");
    let st = dyn_strtab(e);
    for (t, v) in e.dyn {
        let name = dyn_type_name(*t);
        out.push_str(f" 0x{*t:016x} ({name}){rjust(" ", 19 - name.len())}{dyn_value(e, st, *t, *v)}\n");
    }
}

// ------------------------------------------------------------ symbols

#[derive(Clone)]
struct Sym {
    name: i64,
    info: i64,
    other: i64,
    shndx: i64,
    value: i64,
    size: i64,
}

struct Syms {
    sec: i64,
    typ: i64,
    str_off: i64,
    rows: Vec[Sym],
}

fn read_syms(e: ref Elf, k: i64) -> Syms {
    let s = ref e.secs[k];
    let b = ref e.b;
    let n = if s.es != 0 { s.size / 24 } else { 0 };
    let str_off = if s.link < e.shnum { e.secs[s.link].off } else { 0 };
    let mut rows: Vec[Sym] = Vec.new();
    for i in 0..n {
        let p = s.off + 24 * i;
        rows.push(Sym {
            name: le(b, p, 4),
            info: b[p + 4] as i64,
            other: b[p + 5] as i64,
            shndx: le(b, p + 6, 2),
            value: le(b, p + 8, 8),
            size: le(b, p + 16, 8),
        });
    }
    Syms { sec: k, typ: s.typ, str_off: str_off, rows: rows }
}

// The dynamic symbol table, or the static one when asked.
fn find_syms(e: ref Elf, typ: i64) -> Option[Syms] {
    if not e.has_secs {
        return None;
    }
    for k in 0..e.secs.len() {
        if e.secs[k].typ == typ {
            return Some(read_syms(e, k));
        }
    }
    None
}

fn sym_name(e: ref Elf, t: ref Syms, r: ref Sym) -> String {
    if r.info & 15 == 3 and r.name == 0 {
        if r.shndx < e.shnum and e.has_secs {
            return name_of(e, r.shndx);
        }
        return String.new();
    }
    cstr(e, t.str_off + r.name)
}

fn sym_type_name(t: i64) -> String {
    let s = match t {
        0 => "NOTYPE",
        1 => "OBJECT",
        2 => "FUNC",
        3 => "SECTION",
        4 => "FILE",
        5 => "COMMON",
        6 => "TLS",
        10 => "IFUNC",
        _ => "",
    };
    if s.len() == 0 { f"<unknown>: {t}" } else { s.to_string() }
}

fn sym_bind_name(t: i64) -> String {
    let s = match t {
        0 => "LOCAL",
        1 => "GLOBAL",
        2 => "WEAK",
        10 => "UNIQUE",
        _ => "",
    };
    if s.len() == 0 { f"<unknown>: {t}" } else { s.to_string() }
}

fn sym_vis_name(v: i64) -> String {
    let s = match v & 3 {
        0 => "DEFAULT",
        1 => "INTERNAL",
        2 => "HIDDEN",
        _ => "PROTECTED",
    };
    s.to_string()
}

// ------------------------------------------------------------ versions

struct Versions {
    has_versym: bool,
    versym: Vec[i64],
    need: Vec[(i64, String)],
    defs: Vec[(i64, String)],
}

fn read_versions(e: ref Elf) -> Versions {
    let mut v = Versions { has_versym: false, versym: Vec.new(), need: Vec.new(), defs: Vec.new() };
    if not e.has_secs {
        return v;
    }
    let b = ref e.b;
    for s in e.secs {
        let st = if s.link < e.shnum { e.secs[s.link].off } else { 0 };
        if s.typ == SHT_VERSYM {
            v.has_versym = true;
            for i in 0..s.size / 2 {
                v.versym.push(le(b, s.off + 2 * i, 2));
            }
        } else if s.typ == SHT_VERNEED {
            let mut p = s.off;
            for _ in 0..s.info {
                let cnt = le(b, p + 2, 2);
                let mut a = p + le(b, p + 8, 4);
                for _ in 0..cnt {
                    v.need.push((le(b, a + 6, 2), cstr(e, st + le(b, a + 8, 4))));
                    a += le(b, a + 12, 4);
                }
                p += le(b, p + 12, 4);
            }
        } else if s.typ == SHT_VERDEF {
            let mut p = s.off;
            for _ in 0..s.info {
                let ndx = le(b, p + 4, 2);
                let aux = le(b, p + 12, 4);
                v.defs.push((ndx, cstr(e, st + le(b, p + aux, 4))));
                p += le(b, p + 16, 4);
            }
        }
    }
    v
}

fn lookup_ver(list: ref Vec[(i64, String)], idx: i64) -> Option[String] {
    for (k, name) in list {
        if *k == idx {
            return Some(name.clone());
        }
    }
    None
}

const VER_NEEDED: i64 = 0;
const VER_HIDDEN: i64 = 1;
const VER_DEFAULT: i64 = 2;

struct VerHit {
    name: String,
    kind: i64,
    idx: i64,
}

// The version a dynamic symbol shows.
fn sym_version(v: ref Versions, i: i64, r: ref Sym, name: Str) -> Option[VerHit] {
    if not v.has_versym or i >= v.versym.len() {
        return None;
    }
    let data = v.versym[i];
    let idx = data & 0x7fff;
    if idx < 2 {
        return None;
    }
    if r.shndx == 0 {
        return match lookup_ver(v.need, idx) {
            Some(n) => Some(VerHit { name: n, kind: VER_NEEDED, idx: idx }),
            None => None,
        };
    }
    match lookup_ver(v.defs, idx) {
        Some(n) => {
            if n == name {
                None
            } else {
                Some(VerHit { name: n, kind: if data & 0x8000 != 0 { VER_HIDDEN } else { VER_DEFAULT }, idx: idx })
            }
        }
        None => None,
    }
}

fn ndx_str(e: ref Elf, n: i64) -> String {
    if n == 0 {
        "UND".to_string()
    } else if n == 0xfff1 {
        "ABS".to_string()
    } else if n == 0xfff2 {
        "COM".to_string()
    } else if not e.has_strings and n < e.shnum {
        "<no-strings>".to_string()
    } else {
        f"{n:3}"
    }
}

fn symbols(out: mut ref String, e: ref Elf) {
    if not e.has_secs {
        return;
    }
    let v = read_versions(e);
    for k in 0..e.secs.len() {
        let typ = e.secs[k].typ;
        if typ != SHT_SYMTAB and typ != SHT_DYNSYM {
            continue;
        }
        let t = read_syms(e, k);
        let n = t.rows.len();
        out.push_str(f"\nSymbol table '{name_of(e, k)}' contains {n} {plural(n, "entry", "entries")}:\n");
        out.push_str("   Num:    Value          Size Type    Bind   Vis      Ndx Name\n");
        for i in 0..n {
            let r = ref t.rows[i];
            let mut nm = sym_name(e, t, r);
            if typ == SHT_DYNSYM {
                if let Some(h) = sym_version(v, i, r, nm) {
                    if h.kind == VER_NEEDED {
                        nm.push_str(f"@{h.name} ({h.idx})");
                    } else if h.kind == VER_HIDDEN {
                        nm.push_str(f"@{h.name}");
                    } else {
                        nm.push_str(f"@@{h.name}");
                    }
                }
            }
            out.push_str(f"{i:6}: {r.value:016x} {r.size:5} {ljust(sym_type_name(r.info & 15), 7)} {ljust(sym_bind_name(r.info >> 4), 6)} {ljust(sym_vis_name(r.other), 7)} {rjust(ndx_str(e, r.shndx), 4)} {nm}\n");
        }
    }
}

// ------------------------------------------------------------ -r

fn reloc_type_name(t: i64) -> String {
    let s = match t {
        0 => "NONE",
        1 => "64",
        2 => "PC32",
        3 => "GOT32",
        4 => "PLT32",
        5 => "COPY",
        6 => "GLOB_DAT",
        7 => "JUMP_SLOT",
        8 => "RELATIVE",
        9 => "GOTPCREL",
        10 => "32",
        11 => "32S",
        12 => "16",
        13 => "PC16",
        14 => "8",
        15 => "PC8",
        16 => "DTPMOD64",
        17 => "DTPOFF64",
        18 => "TPOFF64",
        19 => "TLSGD",
        20 => "TLSLD",
        21 => "DTPOFF32",
        22 => "GOTTPOFF",
        23 => "TPOFF32",
        24 => "PC64",
        25 => "GOTOFF64",
        26 => "GOTPC32",
        37 => "IRELATIVE",
        41 => "GOTPCRELX",
        42 => "REX_GOTPCRELX",
        _ => "unknown",
    };
    f"R_X86_64_{s}"
}

fn relocs(out: mut ref String, e: ref Elf) {
    if not e.has_secs {
        out.push_str("\nThere are no relocations in this file.\n");
        return;
    }
    let v = read_versions(e);
    let b = ref e.b;
    let mut any = false;
    for k in 0..e.secs.len() {
        let s = e.secs[k].clone();
        if s.typ != SHT_RELA {
            continue;
        }
        any = true;
        let n = s.size / 24;
        let label = if e.has_strings { f"'{name_of(e, k)}'" } else { f"{s.name}" };
        out.push_str(f"\nRelocation section {label} at offset 0x{s.off:x} contains {n} {plural(n, "entry", "entries")}:\n");
        out.push_str("    Offset             Info             Type               Symbol's Value  Symbol's Name + Addend\n");
        let t = read_syms(e, s.link);
        let dynamic = e.secs[s.link].typ == SHT_DYNSYM;
        for i in 0..n {
            let p = s.off + 24 * i;
            let off = le(b, p, 8);
            let info = le(b, p + 8, 8);
            let add = le(b, p + 16, 8);
            let sym = (info >> 32) & 0xffffffff;
            let typ = info & 0xffffffff;
            out.push_str(f"{off:016x}  {info:016x} {ljust(reloc_type_name(typ), 22)}");
            if sym == 0 {
                out.push_str("                    ");
                if add >= 0 {
                    out.push_str(f"{add:x}");
                } else {
                    out.push_str(f"-{-add:x}");
                }
            } else {
                let r = ref t.rows[sym];
                let mut nm = sym_name(e, t, r);
                if dynamic {
                    if let Some(h) = sym_version(v, sym, r, nm) {
                        nm.push_str(if h.kind == VER_DEFAULT { "@@" } else { "@" });
                        nm.push_str(h.name);
                    }
                }
                let sign = if add < 0 { "-" } else { "+" };
                let mag = if add < 0 { -add } else { add };
                out.push_str(f" {r.value:016x} {nm} {sign} {mag:x}");
            }
            out.push_str("\n");
        }
    }
    if not any {
        out.push_str("\nThere are no relocations in this file.\n");
    }
}

// ------------------------------------------------------------ -V

// C's "%#06x": the 0x prefix is left off zero.
fn c_hash06(x: i64) -> String {
    if x == 0 { "000000".to_string() } else { f"0x{x:04x}" }
}

fn versym_cell(e: ref Elf, v: ref Versions, syms: ref Syms, i: i64) -> String {
    let data = v.versym[i];
    if data == 0 {
        return "   0 (*local*)    ".to_string();
    }
    if data == 1 {
        return "   1 (*global*)   ".to_string();
    }
    let idx = data & 0x7fff;
    let h = if data & 0x8000 != 0 { "h" } else { " " };
    let mut cell = f"{idx:4x}{h}";
    let r = ref syms.rows[i];
    let mut check_def = true;
    let mut check_need = true;
    if r.shndx == 0 or (r.shndx < e.shnum and e.secs[r.shndx].typ == SHT_NOBITS) {
        check_def = r.shndx != 0;
        check_need = r.shndx == 0;
    }
    let mut name: Option[String] = None;
    if check_need and data != 0x8001 {
        name = lookup_ver(v.need, idx);
    }
    if name.is_none() and check_def {
        name = lookup_ver(v.defs, idx);
    }
    if let Some(n) = name {
        cell.push_str("(");
        cell.push_str(n);
        cell.push_str(ljust(")", 12 - n.len()));
    }
    ljust(cell, 18)
}

fn ver_sections(out: mut ref String, e: ref Elf) {
    if not e.has_secs {
        return;
    }
    let b = ref e.b;
    let v = read_versions(e);
    let mut found = false;
    for k in 0..e.secs.len() {
        let s = e.secs[k].clone();
        if s.typ != SHT_VERDEF and s.typ != SHT_VERNEED and s.typ != SHT_VERSYM {
            continue;
        }
        found = true;
        let st = e.secs[s.link].off;
        let head = f" Addr: 0x{s.addr:016x}  Offset: 0x{s.off:08x}  Link: {s.link} ({name_of(e, s.link)})\n";
        if s.typ == SHT_VERSYM {
            let n = s.size / 2;
            out.push_str(f"\nVersion symbols section '{name_of(e, k)}' contains {n} {plural(n, "entry", "entries")}:\n");
            out.push_str(head);
            let syms = read_syms(e, s.link);
            let mut c: i64 = 0;
            while c < n {
                out.push_str(f"  {c:03x}:");
                for j in 0..4 {
                    if c + j >= n {
                        break;
                    }
                    out.push_str(versym_cell(e, v, syms, c + j));
                }
                out.push_str("\n");
                c += 4;
            }
        } else if s.typ == SHT_VERDEF {
            out.push_str(f"\nVersion definition section '{name_of(e, k)}' contains {s.info} {plural(s.info, "entry", "entries")}:\n");
            out.push_str(head);
            let mut p = s.off;
            for _ in 0..s.info {
                let rev = le(b, p, 2);
                let fl = le(b, p + 2, 2);
                let ndx = le(b, p + 4, 2);
                let cnt = le(b, p + 6, 2);
                let fls = if fl == 0 { "none".to_string() } else if fl == 1 { "BASE".to_string() } else if fl == 2 { "WEAK".to_string() } else { "BASE | WEAK".to_string() };
                let mut a = p + le(b, p + 12, 4);
                out.push_str(f"  {c_hash06(p - s.off)}: Rev: {rev}  Flags: {fls}  Index: {ndx}  Cnt: {cnt}  Name: {cstr(e, st + le(b, a, 4))}\n");
                for j in 1..cnt {
                    a += le(b, a + 4, 4);
                    out.push_str(f"  {c_hash06(a - s.off)}: Parent {j}: {cstr(e, st + le(b, a, 4))}\n");
                }
                p += le(b, p + 16, 4);
            }
        } else {
            out.push_str(f"\nVersion needs section '{name_of(e, k)}' contains {s.info} {plural(s.info, "entry", "entries")}:\n");
            out.push_str(head);
            let mut p = s.off;
            for _ in 0..s.info {
                let ver = le(b, p, 2);
                let cnt = le(b, p + 2, 2);
                out.push_str(f"  {c_hash06(p - s.off)}: Version: {ver}  File: {cstr(e, st + le(b, p + 4, 4))}  Cnt: {cnt}\n");
                let mut a = p + le(b, p + 8, 4);
                for _ in 0..cnt {
                    let fl = le(b, a + 4, 2);
                    let fls = if fl == 0 { "none".to_string() } else if fl == 2 { "WEAK".to_string() } else { f"{fl:x}" };
                    out.push_str(f"  {c_hash06(a - s.off)}:   Name: {cstr(e, st + le(b, a + 8, 4))}  Flags: {fls}  Version: {le(b, a + 6, 2)}\n");
                    a += le(b, a + 12, 4);
                }
                p += le(b, p + 12, 4);
            }
        }
    }
    if not found {
        out.push_str("\nNo version information found in this file.\n");
    }
}

// ------------------------------------------------------------ -n

fn property_text(e: ref Elf, from: i64, n: i64) -> String {
    let b = ref e.b;
    let mut parts: Vec[String] = Vec.new();
    let end = from + n;
    let mut p = from;
    while p + 8 <= end {
        let t = le(b, p, 4);
        let sz = le(b, p + 4, 4);
        let val = le(b, p + 8, 4);
        if t == 0xc0000002 {
            let names: Vec[Str] = vec!["IBT", "SHSTK", "LAM_U48", "LAM_U57"];
            let mut on: Vec[String] = Vec.new();
            for k in 0..4 {
                if (val >> k) & 1 != 0 {
                    on.push(names[k].to_string());
                }
            }
            parts.push(f"x86 feature: {join(on, ", ")}");
        } else if t == 0xc0008002 {
            let names: Vec[Str] = vec!["x86-64-baseline", "x86-64-v2", "x86-64-v3", "x86-64-v4"];
            let mut on: Vec[String] = Vec.new();
            for k in 0..4 {
                if (val >> k) & 1 != 0 {
                    on.push(names[k].to_string());
                }
            }
            parts.push(f"x86 ISA needed: {join(on, ", ")}");
        } else {
            parts.push(f"<unknown type 0x{t:x}>");
        }
        p += 8 + ((sz + 7) & -8);
    }
    join(parts, ", ")
}

fn notes(out: mut ref String, e: ref Elf) {
    if not e.has_secs {
        return;
    }
    let b = ref e.b;
    for k in 0..e.secs.len() {
        let s = e.secs[k].clone();
        if s.typ != SHT_NOTE {
            continue;
        }
        out.push_str(f"\nDisplaying notes found in: {name_of(e, k)}\n");
        out.push_str("  Owner                Data size \tDescription\n");
        let mut p = s.off;
        let end = s.off + s.size;
        while p + 12 <= end {
            let nsz = le(b, p, 4);
            let dsz = le(b, p + 4, 4);
            let typ = le(b, p + 8, 4);
            let owner = cstr(e, p + 12);
            let desc = p + 12 + ((nsz + 3) & -4);
            out.push_str(f"  {ljust(owner, 20)} 0x{dsz:08x}\t");
            if typ == 5 {
                out.push_str(f"NT_GNU_PROPERTY_TYPE_0\t      Properties: {property_text(e, desc, dsz)}");
            } else if typ == 3 {
                out.push_str("NT_GNU_BUILD_ID (unique build ID bitstring)\t    Build ID: ");
                for i in 0..dsz {
                    let c = b[desc + i];
                    out.push_str(f"{c:02x}");
                }
            } else if typ == 1 {
                let os = match le(b, desc, 4) {
                    0 => "Linux",
                    1 => "Hurd",
                    2 => "Solaris",
                    3 => "FreeBSD",
                    _ => "Unknown",
                };
                out.push_str(f"NT_GNU_ABI_TAG (ABI version tag)\t    OS: {os}, ABI: {le(b, desc + 4, 4)}.{le(b, desc + 8, 4)}.{le(b, desc + 12, 4)}");
            } else {
                out.push_str(f"Unknown note type: (0x{typ:08x})");
            }
            out.push_str("\n");
            let align = if s.align == 8 { 8 } else { 4 };
            p = desc + ((dsz + align - 1) & -align);
        }
    }
}

// ------------------------------------------------------------ -x and -p

fn hex_dump(out: mut ref String, e: ref Elf, s: ref Sec, name: Str) {
    out.push_str(f"\nHex dump of section '{name}':\n");
    let b = ref e.b;
    let mut addr = s.addr;
    let mut data = s.off;
    let mut n = s.size;
    while n > 0 {
        let m = if n < 16 { n } else { 16 };
        let mut text: Vec[u8] = Vec.new();
        out.push_str(f"  0x{addr:08x} ");
        for j in 0..16 {
            if j < m {
                let c = b[data + j];
                out.push_str(f"{c:02x}");
            } else {
                out.push_str("  ");
            }
            if j & 3 == 3 {
                out.push_str(" ");
            }
        }
        for j in 0..m {
            let c = b[data + j];
            text.push(if c >= 32 and c < 0x7f { c } else { b'.' });
        }
        out.push_str(from_bytes(text));
        out.push_str("\n");
        data += m;
        addr += m;
        n -= m;
    }
    out.push_str("\n");
}

fn printable(c: u8) -> bool {
    c >= 32 and c < 0x7f
}

fn str_dump(out: mut ref String, e: ref Elf, s: ref Sec, name: Str) {
    out.push_str(f"\nString dump of section '{name}':\n");
    let b = ref e.b;
    let start = s.off;
    let end = s.off + s.size;
    let mut p = start;
    let mut shown = false;
    while p < end {
        while p < end and not printable(b[p]) {
            p += 1;
        }
        if p < end {
            out.push_str(f"  [{p - start:6x}]  ");
            let mut text: Vec[u8] = Vec.new();
            while p < end {
                let c = b[p];
                p += 1;
                if c == 0 {
                    break;
                }
                if printable(c) {
                    text.push(c);
                } else if c == 10 {
                    text.push(b'\\');
                    text.push(b'n');
                } else {
                    text.push(b'\\');
                    text.push(b'0' + c / 64);
                    text.push(b'0' + c / 8 % 8);
                    text.push(b'0' + c % 8);
                }
            }
            out.push_str(from_bytes(text));
            out.push_str("\n");
            shown = true;
        }
    }
    if not shown {
        out.push_str("  No strings found in this section.");
    }
    out.push_str("\n");
}

// ------------------------------------------------------------ -I

// printf("%5.1f", num * 100.0 / den), rounding half to even.
fn pct(num: i64, den: i64) -> String {
    let mut q = num * 1000 / den;
    let r = num * 1000 % den;
    if 2 * r > den or (2 * r == den and q % 2 == 1) {
        q += 1;
    }
    rjust(f"{q / 10}.{q % 10}", 5)
}

fn hist_rows(out: mut ref String, lengths: ref Vec[i64]) {
    let n = lengths.len();
    let mut top: i64 = 0;
    let mut total: i64 = 0;
    for L in lengths {
        if *L > top {
            top = *L;
        }
        total += *L;
    }
    let mut counts: Vec[i64] = Vec.new();
    for _ in 0..top + 1 {
        counts.push(0);
    }
    for L in lengths {
        counts[*L] += 1;
    }
    out.push_str(" Length  Number     % of total  Coverage\n");
    out.push_str(f"      0  {ljust(f"{counts[0]}", 10)} ({pct(counts[0], n)}%)\n");
    let mut cov: i64 = 0;
    for i in 1..top + 1 {
        cov += counts[i] * i;
        out.push_str(f"{i:7}  {ljust(f"{counts[i]}", 10)} ({pct(counts[i], n)}%)    {pct(cov, total)}%\n");
    }
}

fn sysv_lengths(e: ref Elf, off: i64) -> Vec[i64] {
    let b = ref e.b;
    let nb = le(b, off, 4);
    let mut out: Vec[i64] = Vec.new();
    for i in 0..nb {
        let mut L: i64 = 0;
        let mut k = le(b, off + 8 + 4 * i, 4);
        while k != 0 {
            L += 1;
            k = le(b, off + 8 + 4 * nb + 4 * k, 4);
        }
        out.push(L);
    }
    out
}

struct GnuHash {
    nb: i64,
    symoff: i64,
    bloom_n: i64,
    shift: i64,
    bloom_at: i64,
    buckets_at: i64,
    chain_at: i64,
}

fn read_gnu_hash(e: ref Elf, off: i64) -> GnuHash {
    let b = ref e.b;
    let nb = le(b, off, 4);
    let bloom_n = le(b, off + 8, 4);
    let buckets_at = off + 16 + 8 * bloom_n;
    GnuHash {
        nb: nb,
        symoff: le(b, off + 4, 4),
        bloom_n: bloom_n,
        shift: le(b, off + 12, 4),
        bloom_at: off + 16,
        buckets_at: buckets_at,
        chain_at: buckets_at + 4 * nb,
    }
}

fn gh_bucket(e: ref Elf, g: ref GnuHash, i: i64) -> i64 {
    le(e.b, g.buckets_at + 4 * i, 4)
}

fn gh_chain(e: ref Elf, g: ref GnuHash, sym: i64) -> i64 {
    le(e.b, g.chain_at + 4 * (sym - g.symoff), 4)
}

fn gnu_lengths(e: ref Elf, g: ref GnuHash) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for i in 0..g.nb {
        let mut L: i64 = 0;
        let mut k = gh_bucket(e, g, i);
        if k != 0 {
            loop {
                L += 1;
                if gh_chain(e, g, k) & 1 != 0 {
                    break;
                }
                k += 1;
            }
        }
        out.push(L);
    }
    out
}

fn histogram(out: mut ref String, e: ref Elf) {
    if let Some(h) = dyn_tag(e, DT_HASH) {
        if let Some(off) = vaddr_to_off(e, h) {
            let lens = sysv_lengths(e, off);
            if lens.len() > 0 {
                out.push_str(f"\nHistogram for bucket list length (total of {lens.len()} buckets):\n");
                hist_rows(mut out, lens);
            }
        }
    }
    if let Some(h) = dyn_tag(e, DT_GNU_HASH) {
        if let Some(off) = vaddr_to_off(e, h) {
            let g = read_gnu_hash(e, off);
            let lens = gnu_lengths(e, g);
            if lens.len() > 0 {
                out.push_str(f"\nHistogram for `.gnu.hash' bucket list length (total of {lens.len()} buckets):\n");
                hist_rows(mut out, lens);
            }
        }
    }
}

// ------------------------------------------------------------ hashes

// The SysV ELF hash, which .hash and every vna_hash/vd_hash use.
fn elf_hash(name: Str) -> i64 {
    let mut h: i64 = 0;
    for c in name.bytes() {
        h = ((h << 4) + c as i64) & 0xffffffff;
        let g = h & 0xf0000000;
        if g != 0 {
            h = h ^ (g >> 24);
        }
        h = h & (0xffffffff ^ g);
    }
    h
}

// The GNU hash: Bernstein's h * 33 + c over 32 bits.
fn gnu_hash(name: Str) -> i64 {
    let mut h: i64 = 5381;
    for c in name.bytes() {
        h = (h * 33 + c as i64) & 0xffffffff;
    }
    h
}

// ------------------------------------------------------------ checksec

const NO_FILE: i64 = 0;
const SHORT_FILE: i64 = 1;
const NOT_ELF: i64 = 2;

fn open_elf(name: Str) -> Result[Elf, i64] {
    let path = f"data/{name}";
    let data = match fs.read_bytes(path) {
        Ok(d) => d,
        Err(_) => return Err(NO_FILE),
    };
    if data.len() < 64 {
        return Err(SHORT_FILE);
    }
    if data[0] != 0x7f or data[1] != b'E' or data[2] != b'L' or data[3] != b'F' {
        return Err(NOT_ELF);
    }
    Ok(read_elf(name, data))
}

fn why_text(code: i64) -> String {
    if code == NO_FILE {
        "no such file".to_string()
    } else if code == SHORT_FILE {
        "too short for an ELF header".to_string()
    } else {
        "not an ELF file".to_string()
    }
}

fn all_sym_names(e: ref Elf) -> Vec[String] {
    let mut names: Vec[String] = Vec.new();
    if not e.has_secs {
        return names;
    }
    for k in 0..e.secs.len() {
        let typ = e.secs[k].typ;
        if typ == SHT_SYMTAB or typ == SHT_DYNSYM {
            let t = read_syms(e, k);
            for r in t.rows {
                names.push(sym_name(e, t, r));
            }
        }
    }
    names
}

// A symbol name without its @version.
fn base_name(n: Str) -> String {
    let (head, _, _) = partition(n, b'@');
    head
}

// The fortified functions a file calls: __printf_chk is printf.
fn fortified(e: ref Elf) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for n in all_sym_names(e) {
        let b = base_name(n);
        if starts_with(b, "__") and b.ends_with("_chk") and b != "__stack_chk" {
            let f = slice(b, 2, b.len() - 4);
            if not out.contains(f) {
                out.push(f);
            }
        }
    }
    out.sort();
    out
}

fn cet(e: ref Elf) -> String {
    if not e.has_secs {
        return "-".to_string();
    }
    let b = ref e.b;
    let mut at: i64 = -1;
    for k in 0..e.secs.len() {
        if e.secs[k].typ == SHT_NOTE and name_of(e, k) == ".note.gnu.property" {
            at = k;
        }
    }
    if at < 0 {
        return "-".to_string();
    }
    let p = e.secs[at].off;
    let nsz = le(b, p, 4);
    let dsz = le(b, p + 4, 4);
    let mut q = p + 12 + ((nsz + 3) & -4);
    let end = q + dsz;
    while q + 8 <= end {
        let t = le(b, q, 4);
        let sz = le(b, q + 4, 4);
        if t == 0xc0000002 {
            let v = le(b, q + 8, 4);
            let mut names: Vec[String] = Vec.new();
            if v & 1 != 0 {
                names.push("IBT".to_string());
            }
            if v & 2 != 0 {
                names.push("SHSTK".to_string());
            }
            return if names.len() > 0 { join(names, ", ") } else { "-".to_string() };
        }
        q += 8 + ((sz + 7) & -8);
    }
    "-".to_string()
}

fn has_phdr(e: ref Elf, t: i64) -> bool {
    for p in e.phdrs {
        if p.typ == t {
            return true;
        }
    }
    false
}

fn tag_or_zero(e: ref Elf, t: i64) -> i64 {
    dyn_tag(e, t).unwrap_or(0)
}

fn checksec_row(e: ref Elf) -> Vec[String] {
    let etype = elf_type(e);
    let mut relro = "N/A".to_string();
    let mut nx = "N/A".to_string();
    let mut pie = "REL".to_string();
    if etype != 1 {
        let now = tag_or_zero(e, DT_FLAGS) & 8 != 0 or tag_or_zero(e, DT_FLAGS_1) & 1 != 0 or dyn_tag(e, DT_BIND_NOW).is_some();
        relro = if not has_phdr(e, PT_GNU_RELRO) { "No RELRO".to_string() } else if now { "Full RELRO".to_string() } else { "Partial RELRO".to_string() };
        nx = "NX disabled".to_string();
        for p in e.phdrs {
            if p.typ == PT_GNU_STACK {
                if p.flags & 1 == 0 {
                    nx = "NX enabled".to_string();
                }
                break;
            }
        }
        pie = if etype == 2 {
            "No PIE".to_string()
        } else if tag_or_zero(e, DT_FLAGS_1) & 0x08000000 != 0 or dyn_tag(e, DT_DEBUG).is_some() {
            "PIE enabled".to_string()
        } else {
            "DSO".to_string()
        };
    }
    let mut canary = "No canary found".to_string();
    for n in all_sym_names(e) {
        if base_name(n) == "__stack_chk_fail" {
            canary = "Canary found".to_string();
        }
    }
    let rpath = if dyn_tag(e, DT_RPATH).is_some() { "RPATH" } else { "No RPATH" };
    let runpath = if dyn_tag(e, DT_RUNPATH).is_some() { "RUNPATH" } else { "No RUNPATH" };
    let symbols = match find_syms(e, SHT_SYMTAB) {
        Some(t) => f"{t.rows.len()} Symbols",
        None => "No Symbols".to_string(),
    };
    let chk = fortified(e);
    let fort = if chk.len() > 0 { f"Yes ({chk.len()})" } else { "No".to_string() };
    vec![e.name.clone(), relro, canary, nx, pie, rpath.to_string(), runpath.to_string(), symbols, fort, cet(e)]
}

fn checksec(out: mut ref String, files: ref Vec[String]) {
    let mut rows: Vec[Vec[String]] = Vec.new();
    rows.push(vec!["File".to_string(), "RELRO".to_string(), "Stack canary".to_string(), "NX".to_string(), "PIE".to_string(),
        "RPATH".to_string(), "RUNPATH".to_string(), "Symbols".to_string(), "FORTIFY".to_string(), "CET".to_string()]);
    let mut bad: Vec[String] = Vec.new();
    let mut forts: Vec[String] = Vec.new();
    for f in files {
        match open_elf(f) {
            Ok(e) => {
                rows.push(checksec_row(e));
                let chk = fortified(e);
                if chk.len() > 0 {
                    forts.push(f"{f} fortifies: {join(chk, ", ")}");
                }
            }
            Err(code) => bad.push(f"{f}: {why_text(code)}"),
        }
    }
    let ncol = rows[0].len();
    let mut widths: Vec[i64] = Vec.new();
    for c in 0..ncol {
        let mut wd: i64 = 0;
        for r in rows {
            if r[c].len() > wd {
                wd = r[c].len();
            }
        }
        widths.push(wd);
    }
    for r in rows {
        let mut line = String.new();
        for c in 0..ncol {
            if c > 0 {
                line.push_str("  ");
            }
            line.push_str(ljust(r[c], widths[c]));
        }
        out.push_str(line.trim_end());
        out.push_str("\n");
    }
    for line in bad {
        out.push_str(line);
        out.push_str("\n");
    }
    for line in forts {
        out.push_str(line);
        out.push_str("\n");
    }
}

// ------------------------------------------------------------ the loader's view

struct Need {
    file: String,
    name: String,
    hash: i64,
    other: i64,
}

fn verneeds(e: ref Elf) -> Vec[Need] {
    let mut out: Vec[Need] = Vec.new();
    if not e.has_secs {
        return out;
    }
    let b = ref e.b;
    for s in e.secs {
        if s.typ != SHT_VERNEED {
            continue;
        }
        let st = e.secs[s.link].off;
        let mut p = s.off;
        for _ in 0..s.info {
            let cnt = le(b, p + 2, 2);
            let file = cstr(e, st + le(b, p + 4, 4));
            let mut a = p + le(b, p + 8, 4);
            for _ in 0..cnt {
                out.push(Need { file: file.clone(), name: cstr(e, st + le(b, a + 8, 4)), hash: le(b, a, 4), other: le(b, a + 6, 2) });
                a += le(b, a + 12, 4);
            }
            p += le(b, p + 12, 4);
        }
    }
    out
}

struct Def {
    ndx: i64,
    flags: i64,
    name: String,
    hash: i64,
}

fn verdefs(e: ref Elf) -> Vec[Def] {
    let mut out: Vec[Def] = Vec.new();
    if not e.has_secs {
        return out;
    }
    let b = ref e.b;
    for s in e.secs {
        if s.typ != SHT_VERDEF {
            continue;
        }
        let st = e.secs[s.link].off;
        let mut p = s.off;
        for _ in 0..s.info {
            let aux = le(b, p + 12, 4);
            out.push(Def { ndx: le(b, p + 4, 2), flags: le(b, p + 2, 2), name: cstr(e, st + le(b, p + aux, 4)), hash: le(b, p + 8, 4) });
            p += le(b, p + 16, 4);
        }
    }
    out
}

// A loaded object: the file with its dynamic symbols and versions.
struct Dso {
    e: Elf,
    syms: Syms,
    v: Versions,
}

fn load_dso(e: own Elf) -> Option[Dso] {
    let t = match find_syms(e, SHT_DYNSYM) {
        Some(t) => t,
        None => return None,
    };
    let v = read_versions(e);
    Some(Dso { e: e, syms: t, v: v })
}

fn dso_name(d: ref Dso, k: i64) -> String {
    sym_name(d.e, d.syms, d.syms.rows[k])
}

// Does symbol k define name, in the asked version or the default one?
fn defines(d: ref Dso, k: i64, name: Str, version: Str) -> bool {
    let r = ref d.syms.rows[k];
    if r.shndx == 0 or r.info >> 4 == 0 or dso_name(d, k) != name {
        return false;
    }
    if not d.v.has_versym {
        return true;
    }
    let data = d.v.versym[k];
    if version.len() == 0 {
        return data & 0x8000 == 0;
    }
    match lookup_ver(d.v.defs, data & 0x7fff) {
        Some(n) => n == version,
        None => false,
    }
}

fn compares(n: i64) -> String {
    if n == 1 { "1 name compare".to_string() } else { f"{n} name compares" }
}

// Look a name up as ld.so does: through .gnu.hash when there is one,
// else .hash. The symbol (or -1) and how it was found.
fn lookup(d: ref Dso, name: Str, version: Str) -> (i64, String) {
    let e = ref d.e;
    let b = ref e.b;
    if let Some(a) = dyn_tag(e, DT_GNU_HASH) {
        let g = read_gnu_hash(e, vaddr_to_off(e, a).unwrap_or(0));
        let h = gnu_hash(name);
        let word = le(b, g.bloom_at + 8 * ((h / 64) % g.bloom_n), 8);
        let mask = (1 << (h % 64)) | (1 << ((h >> g.shift) % 64));
        let how = f"gnu hash 0x{h:08x}";
        if word & mask != mask {
            return (-1, f"{how}, the bloom filter rules it out");
        }
        let bucket = h % g.nb;
        let mut k = gh_bucket(e, g, bucket);
        if k == 0 {
            return (-1, f"{how}, bucket {bucket} is empty");
        }
        let mut tried: i64 = 0;
        loop {
            let h2 = gh_chain(e, g, k);
            if (h | 1) == (h2 | 1) {
                tried += 1;
                if defines(d, k, name, version) {
                    return (k, f"{how}, bucket {bucket}, symbol {k} after {compares(tried)}");
                }
            }
            if h2 & 1 != 0 {
                return (-1, f"{how}, bucket {bucket}, end of chain after {compares(tried)}");
            }
            k += 1;
        }
    }
    let off = vaddr_to_off(e, dyn_tag(e, DT_HASH).unwrap_or(0)).unwrap_or(0);
    let nb = le(b, off, 4);
    let h = elf_hash(name);
    let bucket = h % nb;
    let mut k = le(b, off + 8 + 4 * bucket, 4);
    let mut seen = false;
    while k != 0 {
        if dso_name(d, k) == name {
            seen = true;
            if defines(d, k, name, version) {
                return (k, f"sysv hash 0x{h:08x}, bucket {bucket}, symbol {k}");
            }
        }
        k = le(b, off + 8 + 4 * nb + 4 * k, 4);
    }
    let only = if seen { " (only an undefined reference)" } else { "" };
    (-1, f"sysv hash 0x{h:08x}, bucket {bucket}, not defined{only}")
}

fn describe(d: ref Dso, k: i64) -> String {
    let r = ref d.syms.rows[k];
    let mut nm = dso_name(d, k);
    if let Some(h) = sym_version(d.v, k, r, nm) {
        nm.push_str(if h.kind == VER_HIDDEN { "@" } else { "@@" });
        nm.push_str(h.name);
    }
    f"{nm} = 0x{r.value:x} {sym_type_name(r.info & 15)} {sym_bind_name(r.info >> 4)}, {r.size} bytes"
}

fn do_lookup(out: mut ref String, f: Str, names: ref Vec[String]) {
    let e = match open_elf(f) {
        Ok(e) => e,
        Err(code) => {
            out.push_str(f"{f}: {why_text(code)}\n");
            return;
        }
    };
    let d = match load_dso(e) {
        Some(d) => d,
        None => {
            out.push_str(f"{f}: no dynamic symbols\n");
            return;
        }
    };
    if let Some(a) = dyn_tag(d.e, DT_GNU_HASH) {
        let g = read_gnu_hash(d.e, vaddr_to_off(d.e, a).unwrap_or(0));
        let words = if g.bloom_n == 1 { "word" } else { "words" };
        out.push_str(f"{f}: .gnu.hash with {g.nb} buckets, symbols from {g.symoff}, {g.bloom_n} bloom {words}, shift {g.shift}\n");
    } else {
        let off = vaddr_to_off(d.e, tag_or_zero(d.e, DT_HASH)).unwrap_or(0);
        out.push_str(f"{f}: .hash with {le(d.e.b, off, 4)} buckets and {le(d.e.b, off + 4, 4)} symbols\n");
    }
    for q in names {
        let (name, _, version) = partition(q, b'@');
        let (k, how) = lookup(d, name, version);
        out.push_str(f"  {q}: {how}\n");
        if k >= 0 {
            out.push_str(f"    -> {describe(d, k)}\n");
        }
    }
}

fn is_system(lib: Str) -> bool {
    lib == "libc.so.6" or lib == "ld-linux-x86-64.so.2" or lib == "libm.so.6"
}

struct Found {
    lib: String,
    dso: Dso,
}

fn found_index(found: ref Vec[Found], lib: Str) -> i64 {
    for k in 0..found.len() {
        if found[k].lib == lib {
            return k;
        }
    }
    -1
}

fn hash_check(name: Str, h: i64) -> String {
    let want = elf_hash(name);
    if h == want { "ok".to_string() } else { f"WRONG, expected 0x{want:08x}" }
}

fn ldcheck(out: mut ref String, f: Str) {
    let e = match open_elf(f) {
        Ok(e) => e,
        Err(code) => {
            out.push_str(f"{f}: {why_text(code)}\n");
            return;
        }
    };
    if not e.has_dyn {
        out.push_str(f"{f}: not dynamically linked\n");
        return;
    }
    let st = dyn_strtab(e).unwrap_or(0);
    let mut needed: Vec[String] = Vec.new();
    for (t, v) in e.dyn {
        if *t == DT_NEEDED {
            needed.push(cstr(e, st + *v));
        }
    }
    let mut kind = "";
    let mut dirs: Vec[String] = Vec.new();
    if let Some(v) = dyn_tag(e, DT_RUNPATH) {
        kind = "runpath";
        dirs = split_on(cstr(e, st + v), b':');
    } else if let Some(v) = dyn_tag(e, DT_RPATH) {
        kind = "rpath";
        dirs = split_on(cstr(e, st + v), b':');
    }
    let mut line = f"{f}: needs {join(needed, ", ")}";
    for p in e.phdrs {
        if p.typ == PT_INTERP {
            line.push_str(f"; interpreter {cstr(e, p.off)}");
            break;
        }
    }
    if kind.len() > 0 {
        line.push_str(f"; {kind} {join(dirs, ":")}");
    }
    out.push_str(line);
    out.push_str("\n");
    let mut found: Vec[Found] = Vec.new();
    for lib in needed {
        let mut through = String.new();
        for dir in dirs {
            if dir == "$ORIGIN" and fs.exists(f"data/{lib}") {
                through = dir.clone();
                break;
            }
        }
        if through.len() > 0 {
            let le_ = match open_elf(lib) {
                Ok(x) => x,
                Err(_) => continue,
            };
            let mut son = String.new();
            if let Some(v) = dyn_tag(le_, DT_SONAME) {
                son = f", soname {cstr(le_, dyn_strtab(le_).unwrap_or(0) + v)}";
            }
            out.push_str(f"  {lib}: data/{lib} through {through}{son}\n");
            if let Some(d) = load_dso(le_) {
                found.push(Found { lib: lib.clone(), dso: d });
            }
        } else if is_system(lib) {
            out.push_str(f"  {lib}: a system library, not checked\n");
        } else {
            let mut outside: Vec[String] = Vec.new();
            for dir in dirs {
                if dir != "$ORIGIN" {
                    outside.push(dir.clone());
                }
            }
            if outside.len() > 0 {
                out.push_str(f"  {lib}: not found ({join(outside, " and ")} is outside data/)\n");
            } else {
                out.push_str(f"  {lib}: not found\n");
            }
        }
    }
    // the version needs: the loader checks these before any symbol
    let needs = verneeds(e);
    let mut refused: Vec[String] = Vec.new();
    for n in needs {
        let ok = hash_check(n.name, n.hash);
        let fi = found_index(found, n.file);
        if fi >= 0 {
            let defs = verdefs(found[fi].dso.e);
            let mut hit: i64 = -1;
            for d in defs {
                if d.name == n.name {
                    hit = d.ndx;
                    break;
                }
            }
            if hit >= 0 {
                out.push_str(f"  version {n.name} (hash 0x{n.hash:08x}, {ok}) is version {hit} of {n.file}\n");
            } else {
                let mut have: Vec[String] = Vec.new();
                for d in defs {
                    if d.flags & 1 == 0 {
                        have.push(d.name.clone());
                    }
                }
                out.push_str(f"  version {n.name} (hash 0x{n.hash:08x}, {ok}) is not defined by {n.file}, which defines {join(have, ", ")}\n");
                refused.push(f"{n.file}: version `{n.name}' not found (required by ./{f})");
            }
        } else {
            out.push_str(f"  version {n.name} (hash 0x{n.hash:08x}, {ok}) from {n.file}\n");
        }
    }
    if refused.len() > 0 {
        for r in refused {
            out.push_str(f"  ld.so: ./{f}: {r}\n");
        }
        out.push_str("  result: the loader refuses to start it\n");
        return;
    }
    let defs = verdefs(e);
    let me = match load_dso(e) {
        Some(d) => d,
        None => return,
    };
    let mut bound: i64 = 0;
    let mut system: i64 = 0;
    let mut weak: i64 = 0;
    let mut missing: Vec[String] = Vec.new();
    let mut all_system = true;
    for lib in needed {
        if found_index(found, lib) >= 0 {
            all_system = false;
        }
    }
    for i in 1..me.syms.rows.len() {
        let r = me.syms.rows[i].clone();
        if r.shndx != 0 {
            continue;
        }
        let nm = dso_name(me, i);
        let mut lib = String.new();
        let mut ver = String.new();
        if let Some(h) = sym_version(me.v, i, r, nm) {
            ver = h.name.clone();
            for n in needs {
                if n.other == h.idx {
                    lib = n.file.clone();
                }
            }
        }
        let shown = if ver.len() > 0 { f"{nm}@{ver}" } else { nm.clone() };
        let mut targets: Vec[String] = Vec.new();
        if lib.len() > 0 {
            targets.push(lib.clone());
        } else {
            for l in needed {
                targets.push(l.clone());
            }
        }
        let mut hit_lib: i64 = -1;
        let mut hit_sym: i64 = -1;
        for l in targets {
            let fi = found_index(found, l);
            if fi >= 0 {
                let (k, _) = lookup(found[fi].dso, nm, ver);
                if k >= 0 {
                    hit_lib = fi;
                    hit_sym = k;
                    break;
                }
            }
        }
        let is_weak = r.info >> 4 == 2;
        if hit_lib >= 0 {
            out.push_str(f"  {shown} -> {found[hit_lib].lib}: {describe(found[hit_lib].dso, hit_sym)}\n");
            bound += 1;
        } else if is_system(lib) or (lib.len() == 0 and all_system and not is_weak) {
            system += 1;
        } else if is_weak {
            weak += 1;
        } else {
            missing.push(shown);
        }
    }
    for m in missing {
        out.push_str(f"  {m}: undefined symbol\n");
    }
    out.push_str(f"  result: {bound} bound in data/, {system} left to system libraries, {weak} weak and unresolved");
    if missing.len() > 0 {
        out.push_str(f", {missing.len()} missing\n");
    } else {
        out.push_str("\n");
    }
    for d in defs {
        let base = if d.flags & 1 != 0 { " (base)" } else { "" };
        out.push_str(f"  defines version {d.ndx} {d.name}{base}, hash 0x{d.hash:08x} {hash_check(d.name, d.hash)}\n");
    }
}

