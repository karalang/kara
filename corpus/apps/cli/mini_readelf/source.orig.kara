// data/src/app.c
fn file_12() -> String {
    """
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
extern const char *greet(const char *who);
extern char *greet_dup(const char *who);
extern int greet_score(int x);
static int counter = 3;
int shared_total;
const char banner[] = \"app 1.4\";
int add(int a, int b) { return a + b + counter; }
int main(int argc, char **argv) {
    char buf[32];
    strncpy(buf, argc > 1 ? argv[1] : \"world\", sizeof buf - 1);
    buf[31] = 0;
    char *d = greet_dup(buf);
    printf(\"%s: %s %s %d\\n\", banner, greet(buf), d, add(argc, greet_score(2)));
    free(d);
    shared_total += argc;
    return 0;
}

"""
}

// data/src/greet.c
fn file_13() -> String {
    """
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
static char last[64];
int greet_count = 0;
__thread int greet_depth;
const char *greet_old(const char *who) { snprintf(last, sizeof last, \"hi %s\", who); greet_count++; return last; }
const char *greet_new(const char *who) { snprintf(last, sizeof last, \"hello, %s!\", who); greet_count++; return last; }
char *greet_dup(const char *who) { greet_depth++; char *p = malloc(strlen(who) + 8); strcpy(p, \"dear \"); strcat(p, who); return p; }
static int helper(int x) { return x * 3; }
int greet_score(int x) { return helper(x) + greet_count; }
__asm__(\".symver greet_old,greet@GREET_1.0\");
__asm__(\".symver greet_new,greet@@GREET_2.0\");

"""
}

// data/src/greet.map
fn file_14() -> String {
    """
GREET_1.0 { global: greet; greet_count; local: *; };
GREET_2.0 { global: greet; greet_dup; greet_score; greet_depth; } GREET_1.0;

"""
}

// data/src/hello.c
fn file_15() -> String {
    """
#include <stdio.h>
#include <string.h>
static int counter = 3;
int shared_total;
extern int helper(int);
int add(int a, int b) { return a + b + counter; }
int main(int argc, char **argv) {
    char buf[32];
    strncpy(buf, argc > 1 ? argv[1] : \"world\", sizeof buf - 1);
    buf[31] = 0;
    printf(\"hello %s %d\\n\", buf, add(argc, 2));
    return 0;
}

"""
}

fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

// The bytes a block of hex digits spells; line breaks are skipped.
fn unhex(s: String) -> Vec[u8] {
    let b = to_bytes(s);
    let mut digits: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        if is_hex(b[i]) {
            digits.push(hex_val(b[i]));
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < digits.len() {
        out.push(digits[i] * 16 + digits[i + 1]);
        i += 2;
    }
    out
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data")?;
    put_bytes("data/app", unhex(file_0()))?;
    put_bytes("data/app-stripped", unhex(file_1()))?;
    put_bytes("data/app.head", unhex(file_2()))?;
    put_bytes("data/app.o", unhex(file_3()))?;
    put_bytes("data/app.trunc", unhex(file_4()))?;
    put_bytes("data/app.v3", unhex(file_5()))?;
    put_bytes("data/badshoff.o", unhex(file_6()))?;
    put_bytes("data/badstrndx.o", unhex(file_7()))?;
    put("data/build.sh", file_8())?;
    put("data/jobs.txt", file_9())?;
    put_bytes("data/legacy", unhex(file_10()))?;
    put_bytes("data/libgreet.so.2", unhex(file_11()))?;
    make_dir("data/src")?;
    put("data/src/app.c", file_12())?;
    put("data/src/greet.c", file_13())?;
    put("data/src/greet.map", file_14())?;
    put("data/src/hello.c", file_15())?;
    Ok(())
}

// ------------------------------------------------------------ the jobs

fn run_readelf(out: mut ref String, args: ref Vec[String]) -> i64 {
    let mut opts: Vec[String] = Vec.new();
    let mut dump_kind: Vec[String] = Vec.new();
    let mut dump_name: Vec[String] = Vec.new();
    let mut files: Vec[String] = Vec.new();
    let mut i: i64 = 0;
    while i < args.len() {
        let a = args[i].clone();
        if a == "-x" or a == "-p" {
            dump_kind.push(a);
            dump_name.push(args[i + 1].clone());
            i += 2;
            continue;
        }
        if starts_with(a, "-") {
            opts.push(a);
        } else {
            files.push(a);
        }
        i += 1;
    }
    let has = |o: Str| -> bool { opts.contains(o.to_string()) };
    let mut status: i64 = 0;
    for f in files {
        if files.len() > 1 {
            out.push_str(f"\nFile: {f}\n");
        }
        let data = match fs.read_bytes(f"data/{f}") {
            Ok(d) => d,
            Err(_) => {
                out.push_str(f"readelf: Error: '{f}': No such file\n");
                status = 1;
                continue;
            }
        };
        let need = if data.len() > 4 and data[4] == 2 { 64 } else { 52 };
        if data.len() < 16 or data.len() < need {
            out.push_str(f"readelf: Error: {f}: Failed to read file header\n");
            status = 1;
            continue;
        }
        if data[0] != 0x7f or data[1] != b'E' or data[2] != b'L' or data[3] != b'F' {
            out.push_str("readelf: Error: Not an ELF file - it has the wrong magic bytes at the start\n");
            status = 1;
            continue;
        }
        let e = read_elf(f, data);
        let do_header = has("-h");
        if do_header {
            file_header(mut out, e);
        }
        if has("-S") {
            section_headers(mut out, e, do_header);
        }
        if has("-l") {
            program_headers(mut out, e, do_header);
        }
        if has("-d") {
            dynamic_section(mut out, e);
        }
        if has("-r") {
            relocs(mut out, e);
        }
        if has("-s") {
            symbols(mut out, e);
        }
        if has("-V") {
            ver_sections(mut out, e);
        }
        let mut warnings: Vec[String] = Vec.new();
        if dump_name.len() > 0 and e.has_secs {
            let mut done: Vec[String] = Vec.new();
            for k in 0..e.secs.len() {
                let nm = name_of(e, k);
                for j in 0..dump_name.len() {
                    if dump_name[j] == nm and not done.contains(nm) {
                        done.push(nm.clone());
                        if dump_kind[j] == "-x" {
                            hex_dump(mut out, e, e.secs[k], nm);
                        } else {
                            str_dump(mut out, e, e.secs[k], nm);
                        }
                    }
                }
            }
            for want in dump_name {
                if not done.contains(want) {
                    warnings.push(f"readelf: Warning: Section '{want}' was not dumped because it does not exist");
                }
            }
        }
        if has("-I") {
            histogram(mut out, e);
        }
        if has("-n") {
            notes(mut out, e);
        }
        // readelf's messages go to stderr, which comes after the report
        if e.shdr_error.len() > 0 {
            out.push_str(e.shdr_error);
            out.push_str("\n");
        }
        let dyn_used = (elf_type(e) == 3 and (do_header or (has("-l") and e.phnum > 0)))
            or has("-d") or (has("-s") and not e.has_secs) or has("-I");
        if e.dyn_error and dyn_used {
            out.push_str(dyn_error_text());
            out.push_str("\n");
        }
        for w in warnings {
            out.push_str(w);
            out.push_str("\n");
        }
    }
    status
}

fn run_job(out: mut ref String, line: Str) {
    out.push_str(f"$ {line}\n");
    let words = split_ws(line);
    let rest: Vec[String] = words[1..].to_vec();
    let mut status: i64 = 0;
    if words[0] == "readelf" {
        status = run_readelf(mut out, rest);
    } else if words[0] == "checksec" {
        checksec(mut out, rest);
    } else if words[0] == "ldcheck" {
        for f in rest {
            ldcheck(mut out, f);
        }
    } else if words[0] == "lookup" {
        let names: Vec[String] = rest[1..].to_vec();
        do_lookup(mut out, rest[0], names);
    }
    if status != 0 {
        out.push_str(f"[exit status {status}]\n");
    }
    out.push_str("\n");
}

fn run() -> Result[(), String] {
    write_data()?;
    let jobs = match fs.read_to_string("data/jobs.txt".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/jobs.txt: {e}"),
    };
    for line in lines_of(jobs) {
        if line.len() == 0 or starts_with(line, "#") {
            continue;
        }
        let mut out = String.new();
        run_job(mut out, line);
        print(out);
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"error: {e}");
    }
}
