fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

// The bytes a block of hex digits spells; line breaks are skipped.
fn unhex(s: String) -> Vec[u8] {
    let b = to_bytes(s);
    let mut digits: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        if is_hex(b[i]) {
            digits.push(hex_val(b[i]));
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < digits.len() {
        out.push(digits[i] * 16 + digits[i + 1]);
        i += 2;
    }
    out
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data")?;
    put("data/B2SUMS", file_0())?;
    put("data/CHECKSUMS", file_1())?;
    put("data/LICENSE", file_2())?;
    put("data/MD5SUMS", file_3())?;
    put("data/README", file_4())?;
    put("data/SHA1SUMS", file_5())?;
    put("data/SHA256SUMS", file_6())?;
    put("data/SHA256SUMS.bad", file_7())?;
    put("data/empty.dat", file_8())?;
    put("data/jobs.txt", file_9())?;
    put("data/odd\\name.txt", file_10())?;
    make_dir("data/release")?;
    put_bytes("data/release/kara-1.4.0.tar", unhex(file_11()))?;
    put_bytes("data/release/kara.sig", unhex(file_12()))?;
    put("data/release/notes.md", file_13())?;
    Ok(())
}

// The names of the input files.
fn data_names() -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    v.push("B2SUMS".to_string());
    v.push("CHECKSUMS".to_string());
    v.push("LICENSE".to_string());
    v.push("MD5SUMS".to_string());
    v.push("README".to_string());
    v.push("SHA1SUMS".to_string());
    v.push("SHA256SUMS".to_string());
    v.push("SHA256SUMS.bad".to_string());
    v.push("empty.dat".to_string());
    v.push("jobs.txt".to_string());
    v.push("odd\\name.txt".to_string());
    v.push("release/kara-1.4.0.tar".to_string());
    v.push("release/kara.sig".to_string());
    v.push("release/notes.md".to_string());
    v
}

// ------------------------------------------------------------ the jobs

fn run() -> Result[(), String] {
    write_data()?;
    let text = match fs.read_to_string("data/jobs.txt".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/jobs.txt: {e}"),
    };
    let jobs = lines_of(text);
    let t = crc_table();
    for line in jobs {
        if line.len() == 0 or starts_with(line, "#") {
            continue;
        }
        let mut job = Job { out: String.new(), err: String.new(), status: 0 };
        let w = split_on(line, b' ');
        let rest: Vec[String] = w[1..].to_vec();
        run_tool(mut job, t, w[0], rest);
        let mut out = f"$ {line}\n";
        out.push_str(job.out);
        out.push_str(job.err);
        if job.status != 0 {
            out.push_str(f"[exit status {job.status}]\n");
        }
        println(out);
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"error: {e}");
    }
}
