fn data_part_7(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("[\n");
    t.push_str("  {\n");
    t.push_str("    \"comment\": \"4.1. add with missing object\",\n");
    t.push_str("    \"doc\": { \"q\": { \"bar\": 2 } },\n");
    t.push_str("    \"patch\": [ {\"op\": \"add\", \"path\": \"/a/b\", \"value\": 1} ],\n");
    t.push_str("    \"error\":\n");
    t.push_str("       \"path /a does not exist -- missing objects are not created recursively\"\n");
    t.push_str("  },\n");
    t.push_str("\n");
    t.push_str("  {\n");
    t.push_str("    \"comment\": \"A.1.  Adding an Object Member\",\n");
    t.push_str("    \"doc\": {\n");
    t.push_str("  \"foo\": \"bar\"\n");
    t.push_str("},\n");
    t.push_str("    \"patch\": [\n");
    t.push_str("  { \"op\": \"add\", \"path\": \"/baz\", \"value\": \"qux\" }\n");
    t.push_str("],\n");
    t.push_str("    \"expected\": {\n");
    t.push_str("  \"baz\": \"qux\",\n");
    t.push_str("  \"foo\": \"bar\"\n");
    t.push_str("}\n");
    t.push_str("  },\n");
    t.push_str("\n");
    t.push_str("  {\n");
    t.push_str("    \"comment\": \"A.2.  Adding an Array Element\",\n");
    t.push_str("    \"doc\": {\n");
    t.push_str("  \"foo\": [ \"bar\", \"baz\" ]\n");
    t.push_str("},\n");
    t.push_str("    \"patch\": [\n");
    t.push_str("  { \"op\": \"add\", \"path\": \"/foo/1\", \"value\": \"qux\" }\n");
    t.push_str("],\n");
    t.push_str("    \"expected\": {\n");
    t.push_str("  \"foo\": [ \"bar\", \"qux\", \"baz\" ]\n");
    t.push_str("}\n");
    t.push_str("  },\n");
    t.push_str("\n");
    t.push_str("  {\n");
    t.push_str("    \"comment\": \"A.3.  Removing an Object Member\",\n");
    t.push_str("    \"doc\": {\n");
    t.push_str("  \"baz\": \"qux\",\n");
    t.push_str("  \"foo\": \"bar\"\n");
    t.push_str("},\n");
    t.push_str("    \"patch\": [\n");
    t.push_str("  { \"op\": \"remove\", \"path\": \"/baz\" }\n");
    t.push_str("],\n");
    t.push_str("    \"expected\": {\n");
    t.push_str("  \"foo\": \"bar\"\n");
    t.push_str("}\n");
    t.push_str("  },\n");
    t.push_str("\n");
    t.push_str("  {\n");
    t.push_str("    \"comment\": \"A.4.  Removing an Array Element\",\n");
    t.push_str("    \"doc\": {\n");
    t.push_str("  \"foo\": [ \"bar\", \"qux\", \"baz\" ]\n");
    t.push_str("},\n");
    t.push_str("    \"patch\": [\n");
    t.push_str("  { \"op\": \"remove\", \"path\": \"/foo/1\" }\n");
    t.push_str("],\n");
    t.push_str("    \"expected\": {\n");
    t.push_str("  \"foo\": [ \"bar\", \"baz\" ]\n");
    t.push_str("}\n");
    t.push_str("  },\n");
    t.push_str("\n");
    t.push_str("  {\n");
    t.push_str("    \"comment\": \"A.5.  Replacing a Value\",\n");
    t.push_str("    \"doc\": {\n");
    t.push_str("  \"baz\": \"qux\",\n");
    t.push_str("  \"foo\": \"bar\"\n");
    t.push_str("},\n");
    t.push_str("    \"patch\": [\n");
    t.push_str("  { \"op\": \"replace\", \"path\": \"/baz\", \"value\": \"boo\" }\n");
    t.push_str("],\n");
    t.push_str("    \"expected\": {\n");
    t.push_str("  \"baz\": \"boo\",\n");
    t.push_str("  \"foo\": \"bar\"\n");
    t.push_str("}\n");
    t.push_str("  },\n");
    t.push_str("\n");
    t.push_str("  {\n");
    t.push_str("    \"comment\": \"A.6.  Moving a Value\",\n");
    t.push_str("    \"doc\": {\n");
    t.push_str("  \"foo\": {\n");
    t.push_str("    \"bar\": \"baz\",\n");
    t.push_str("    \"waldo\": \"fred\"\n");
    t.push_str("  },\n");
    t.push_str("  \"qux\": {\n");
    t.push_str("    \"corge\": \"grault\"\n");
    t.push_str("  }\n");
    t.push_str("},\n");
    t.push_str("    \"patch\": [\n");
    t.push_str("  { \"op\": \"move\", \"from\": \"/foo/waldo\", \"path\": \"/qux/thud\" }\n");
    t.push_str("],\n");
    t.push_str("    \"expected\": {\n");
    t.push_str("  \"foo\": {\n");
    t.push_str("    \"bar\": \"baz\"\n");
    t.push_str("  },\n");
    t.push_str("  \"qux\": {\n");
    t.push_str("    \"corge\": \"grault\",\n");
    t.push_str("    \"thud\": \"fred\"\n");
    t.push_str("  }\n");
    t.push_str("}\n");
    t.push_str("  },\n");
    t.push_str("\n");
    t.push_str("  {\n");
    t.push_str("    \"comment\": \"A.7.  Moving an Array Element\",\n");
    t.push_str("    \"doc\": {\n");
    t.push_str("  \"foo\": [ \"all\", \"grass\", \"cows\", \"eat\" ]\n");
    t.push_str("},\n");
    t.push_str("    \"patch\": [\n");
    t.push_str("  { \"op\": \"move\", \"from\": \"/foo/1\", \"path\": \"/foo/3\" }\n");
    t.push_str("],\n");
    t.push_str("    \"expected\": {\n");
    t.push_str("  \"foo\": [ \"all\", \"cows\", \"eat\", \"grass\" ]\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("  },\n");
    t.push_str("\n");
    t.push_str("  {\n");
    t.push_str("    \"comment\": \"A.8.  Testing a Value: Success\",\n");
    t.push_str("    \"doc\": {\n");
    t.push_str("  \"baz\": \"qux\",\n");
    t.push_str("  \"foo\": [ \"a\", 2, \"c\" ]\n");
    t.push_str("},\n");
    t.push_str("    \"patch\": [\n");
    t.push_str("  { \"op\": \"test\", \"path\": \"/baz\", \"value\": \"qux\" },\n");
    t.push_str("  { \"op\": \"test\", \"path\": \"/foo/1\", \"value\": 2 }\n");
    t.push_str("],\n");
    t.push_str("    \"expected\": {\n");
    t.push_str("     \"baz\": \"qux\",\n");
    t.push_str("     \"foo\": [ \"a\", 2, \"c\" ]\n");
    t.push_str("    }\n");
    t.push_str("  },\n");
    t.push_str("\n");
    t.push_str("  {\n");
    t.push_str("    \"comment\": \"A.9.  Testing a Value: Error\",\n");
    t.push_str("    \"doc\": {\n");
    t.push_str("  \"baz\": \"qux\"\n");
    t.push_str("},\n");
    t.push_str("    \"patch\": [\n");
    t.push_str("  { \"op\": \"test\", \"path\": \"/baz\", \"value\": \"bar\" }\n");
    t.push_str("],\n");
    t.push_str("    \"error\": \"string not equivalent\"\n");
    t.push_str("  },\n");
    t.push_str("\n");
    t.push_str("  {\n");
    t.push_str("    \"comment\": \"A.10.  Adding a nested Member Object\",\n");
    t.push_str("    \"doc\": {\n");
    t.push_str("  \"foo\": \"bar\"\n");
    t.push_str("},\n");
    t.push_str("    \"patch\": [\n");
    t.push_str("  { \"op\": \"add\", \"path\": \"/child\", \"value\": { \"grandchild\": { } } }\n");
    t.push_str("],\n");
    t.push_str("    \"expected\": {\n");
    t.push_str("  \"foo\": \"bar\",\n");
    t.push_str("  \"child\": {\n");
    t.push_str("    \"grandchild\": {\n");
    t.push_str("    }\n");
    t.push_str("  }\n");
    t.push_str("}\n");
    t.push_str("  },\n");
    t.push_str("\n");
    t.push_str("  {\n");
    t.push_str("    \"comment\": \"A.11.  Ignoring Unrecognized Elements\",\n");
    t.push_str("    \"doc\": {\n");
    t.push_str("  \"foo\":\"bar\"\n");
    t.push_str("},\n");
    t.push_str("    \"patch\": [\n");
    t.push_str("  { \"op\": \"add\", \"path\": \"/baz\", \"value\": \"qux\", \"xyz\": 123 }\n");
    t.push_str("],\n");
    t.push_str("    \"expected\": {\n");
    t.push_str("  \"foo\":\"bar\",\n");
    t.push_str("  \"baz\":\"qux\"\n");
    t.push_str("}\n");
    t.push_str("  },\n");
    t.push_str("\n");
    t.push_str(" {\n");
    t.push_str("    \"comment\": \"A.12.  Adding to a Non-existent Target\",\n");
    t.push_str("    \"doc\": {\n");
    t.push_str("  \"foo\": \"bar\"\n");
    t.push_str("},\n");
    t.push_str("    \"patch\": [\n");
    t.push_str("  { \"op\": \"add\", \"path\": \"/baz/bat\", \"value\": \"qux\" }\n");
    t.push_str("],\n");
    t.push_str("    \"error\": \"add to a non-existent target\"\n");
    t.push_str("  },\n");
    t.push_str("\n");
    t.push_str(" {\n");
    t.push_str("    \"comment\": \"A.13 Invalid JSON Patch Document\",\n");
    t.push_str("    \"doc\": {\n");
    t.push_str("     \"foo\": \"bar\"\n");
    t.push_str("    },\n");
    t.push_str("    \"patch\": [\n");
    t.push_str("  { \"op\": \"add\", \"path\": \"/baz\", \"value\": \"qux\", \"op\": \"remove\" }\n");
    t.push_str("],\n");
    t.push_str("    \"error\": \"operation has two 'op' members\",\n");
    t.push_str("    \"disabled\": true\n");
    t.push_str("  },\n");
    t.push_str("\n");
    t.push_str("  {\n");
    t.push_str("    \"comment\": \"A.14. ~ Escape Ordering\",\n");
    t.push_str("    \"doc\": {\n");
    t.push_str("       \"/\": 9,\n");
    t.push_str("       \"~1\": 10\n");
    t.push_str("    },\n");
    t.push_str("    \"patch\": [{\"op\": \"test\", \"path\": \"/~01\", \"value\": 10}],\n");
    t.push_str("    \"expected\": {\n");
    t.push_str("       \"/\": 9,\n");
    t.push_str("       \"~1\": 10\n");
    t.push_str("    }\n");
    t.push_str("  },\n");
    t.push_str("\n");
    t.push_str("  {\n");
    t.push_str("    \"comment\": \"A.15. Comparing Strings and Numbers\",\n");
    t.push_str("    \"doc\": {\n");
    t.push_str("       \"/\": 9,\n");
    t.push_str("       \"~1\": 10\n");
    t.push_str("    },\n");
    t.push_str("    \"patch\": [{\"op\": \"test\", \"path\": \"/~01\", \"value\": \"10\"}],\n");
    t.push_str("    \"error\": \"number is not equal to string\"\n");
    t.push_str("  },\n");
    t.push_str("\n");
    t.push_str("  {\n");
    t.push_str("    \"comment\": \"A.16. Adding an Array Value\",\n");
    t.push_str("    \"doc\": {\n");
    t.push_str("       \"foo\": [\"bar\"]\n");
    t.push_str("    },\n");
    t.push_str("    \"patch\": [{ \"op\": \"add\", \"path\": \"/foo/-\", \"value\": [\"abc\", \"def\"] }],\n");
    t.push_str("    \"expected\": {\n");
    t.push_str("      \"foo\": [\"bar\", [\"abc\", \"def\"]]\n");
    t.push_str("    }\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("]\n");
    v.push(DataFile { path: "suite/spec_tests.json".to_string(), hex: false, body: t });
}

