    t.push_str("    { \"doc\": [\"\"],\n");
    t.push_str("      \"patch\": [{\"op\": \"replace\", \"path\": \"/0\", \"value\": 0}],\n");
    t.push_str("      \"expected\": [0] },\n");
    t.push_str("\n");
    t.push_str("    { \"doc\": [\"\"],\n");
    t.push_str("      \"patch\": [{\"op\": \"replace\", \"path\": \"/0\", \"value\": true}],\n");
    t.push_str("      \"expected\": [true] },\n");
    t.push_str("\n");
    t.push_str("    { \"doc\": [\"\"],\n");
    t.push_str("      \"patch\": [{\"op\": \"replace\", \"path\": \"/0\", \"value\": false}],\n");
    t.push_str("      \"expected\": [false] },\n");
    t.push_str("\n");
    t.push_str("    { \"doc\": [\"\"],\n");
    t.push_str("      \"patch\": [{\"op\": \"replace\", \"path\": \"/0\", \"value\": null}],\n");
    t.push_str("      \"expected\": [null] },\n");
    t.push_str("\n");
    t.push_str("    { \"doc\": [\"foo\", \"sil\"],\n");
    t.push_str("      \"patch\": [{\"op\": \"replace\", \"path\": \"/1\", \"value\": [\"bar\", \"baz\"]}],\n");
    t.push_str("      \"expected\": [\"foo\", [\"bar\", \"baz\"]],\n");
    t.push_str("      \"comment\": \"value in array replace not flattened\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"replace whole document\",\n");
    t.push_str("      \"doc\": {\"foo\": \"bar\"},\n");
    t.push_str("      \"patch\": [{\"op\": \"replace\", \"path\": \"\", \"value\": {\"baz\": \"qux\"}}],\n");
    t.push_str("      \"expected\": {\"baz\": \"qux\"} },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"test replace with missing parent key should fail\",\n");
    t.push_str("      \"doc\": {\"bar\": \"baz\"},\n");
    t.push_str("      \"patch\": [{\"op\": \"replace\", \"path\": \"/foo/bar\", \"value\": false}],\n");
    t.push_str("      \"error\": \"replace op should fail with missing parent key\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"spurious patch properties\",\n");
    t.push_str("      \"doc\": {\"foo\": 1},\n");
    t.push_str("      \"patch\": [{\"op\": \"test\", \"path\": \"/foo\", \"value\": 1, \"spurious\": 1}],\n");
    t.push_str("      \"expected\": {\"foo\": 1} },\n");
    t.push_str("\n");
    t.push_str("    { \"doc\": {\"foo\": null},\n");
    t.push_str("      \"patch\": [{\"op\": \"test\", \"path\": \"/foo\", \"value\": null}],\n");
    t.push_str("      \"expected\": {\"foo\": null},\n");
    t.push_str("      \"comment\": \"null value should be valid obj property\" },\n");
    t.push_str("\n");
    t.push_str("    { \"doc\": {\"foo\": null},\n");
    t.push_str("      \"patch\": [{\"op\": \"replace\", \"path\": \"/foo\", \"value\": \"truthy\"}],\n");
    t.push_str("      \"expected\": {\"foo\": \"truthy\"},\n");
    t.push_str("      \"comment\": \"null value should be valid obj property to be replaced with something truthy\" },\n");
    t.push_str("\n");
    t.push_str("    { \"doc\": {\"foo\": null},\n");
    t.push_str("      \"patch\": [{\"op\": \"move\", \"from\": \"/foo\", \"path\": \"/bar\"}],\n");
    t.push_str("      \"expected\": {\"bar\": null},\n");
    t.push_str("      \"comment\": \"null value should be valid obj property to be moved\" },\n");
    t.push_str("\n");
    t.push_str("    { \"doc\": {\"foo\": null},\n");
    t.push_str("      \"patch\": [{\"op\": \"copy\", \"from\": \"/foo\", \"path\": \"/bar\"}],\n");
    t.push_str("      \"expected\": {\"foo\": null, \"bar\": null},\n");
    t.push_str("      \"comment\": \"null value should be valid obj property to be copied\" },\n");
    t.push_str("\n");
    t.push_str("    { \"doc\": {\"foo\": null},\n");
    t.push_str("      \"patch\": [{\"op\": \"remove\", \"path\": \"/foo\"}],\n");
    t.push_str("      \"expected\": {},\n");
    t.push_str("      \"comment\": \"null value should be valid obj property to be removed\" },\n");
    t.push_str("\n");
    t.push_str("    { \"doc\": {\"foo\": \"bar\"},\n");
    t.push_str("      \"patch\": [{\"op\": \"replace\", \"path\": \"/foo\", \"value\": null}],\n");
    t.push_str("      \"expected\": {\"foo\": null},\n");
    t.push_str("      \"comment\": \"null value should still be valid obj property replace other value\" },\n");
    t.push_str("\n");
    t.push_str("    { \"doc\": {\"foo\": {\"foo\": 1, \"bar\": 2}},\n");
    t.push_str("      \"patch\": [{\"op\": \"test\", \"path\": \"/foo\", \"value\": {\"bar\": 2, \"foo\": 1}}],\n");
    t.push_str("      \"expected\": {\"foo\": {\"foo\": 1, \"bar\": 2}},\n");
    t.push_str("      \"comment\": \"test should pass despite rearrangement\" },\n");
    t.push_str("\n");
    t.push_str("    { \"doc\": {\"foo\": [{\"foo\": 1, \"bar\": 2}]},\n");
    t.push_str("      \"patch\": [{\"op\": \"test\", \"path\": \"/foo\", \"value\": [{\"bar\": 2, \"foo\": 1}]}],\n");
    t.push_str("      \"expected\": {\"foo\": [{\"foo\": 1, \"bar\": 2}]},\n");
    t.push_str("      \"comment\": \"test should pass despite (nested) rearrangement\" },\n");
    t.push_str("\n");
    t.push_str("    { \"doc\": {\"foo\": {\"bar\": [1, 2, 5, 4]}},\n");
    t.push_str("      \"patch\": [{\"op\": \"test\", \"path\": \"/foo\", \"value\": {\"bar\": [1, 2, 5, 4]}}],\n");
    t.push_str("      \"expected\": {\"foo\": {\"bar\": [1, 2, 5, 4]}},\n");
    t.push_str("      \"comment\": \"test should pass - no error\" },\n");
    t.push_str("\n");
    t.push_str("    { \"doc\": {\"foo\": {\"bar\": [1, 2, 5, 4]}},\n");
    t.push_str("      \"patch\": [{\"op\": \"test\", \"path\": \"/foo\", \"value\": [1, 2]}],\n");
    t.push_str("      \"error\": \"test op should fail\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"Whole document\",\n");
    t.push_str("      \"doc\": { \"foo\": 1 },\n");
    t.push_str("      \"patch\": [{\"op\": \"test\", \"path\": \"\", \"value\": {\"foo\": 1}}],\n");
    t.push_str("      \"disabled\": true },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"Empty-string element\",\n");
    t.push_str("      \"doc\": { \"\": 1 },\n");
    t.push_str("      \"patch\": [{\"op\": \"test\", \"path\": \"/\", \"value\": 1}],\n");
    t.push_str("      \"expected\": { \"\": 1 } },\n");
    t.push_str("\n");
    t.push_str("    { \"doc\": {\n");
    t.push_str("            \"foo\": [\"bar\", \"baz\"],\n");
    t.push_str("            \"\": 0,\n");
    t.push_str("            \"a/b\": 1,\n");
    t.push_str("            \"c%d\": 2,\n");
    t.push_str("            \"e^f\": 3,\n");
    t.push_str("            \"g|h\": 4,\n");
    t.push_str("            \"i\\\\j\": 5,\n");
    t.push_str("            \"k\\\"l\": 6,\n");
    t.push_str("            \" \": 7,\n");
    t.push_str("            \"m~n\": 8\n");
    t.push_str("            },\n");
    t.push_str("      \"patch\": [{\"op\": \"test\", \"path\": \"/foo\", \"value\": [\"bar\", \"baz\"]},\n");
    t.push_str("                {\"op\": \"test\", \"path\": \"/foo/0\", \"value\": \"bar\"},\n");
    t.push_str("                {\"op\": \"test\", \"path\": \"/\", \"value\": 0},\n");
    t.push_str("                {\"op\": \"test\", \"path\": \"/a~1b\", \"value\": 1},\n");
    t.push_str("                {\"op\": \"test\", \"path\": \"/c%d\", \"value\": 2},\n");
    t.push_str("                {\"op\": \"test\", \"path\": \"/e^f\", \"value\": 3},\n");
    t.push_str("                {\"op\": \"test\", \"path\": \"/g|h\", \"value\": 4},\n");
    t.push_str("                {\"op\": \"test\", \"path\":  \"/i\\\\j\", \"value\": 5},\n");
    t.push_str("                {\"op\": \"test\", \"path\": \"/k\\\"l\", \"value\": 6},\n");
    t.push_str("                {\"op\": \"test\", \"path\": \"/ \", \"value\": 7},\n");
    t.push_str("                {\"op\": \"test\", \"path\": \"/m~0n\", \"value\": 8}],\n");
    t.push_str("      \"expected\": {\n");
    t.push_str("            \"\": 0,\n");
    t.push_str("            \" \": 7,\n");
    t.push_str("            \"a/b\": 1,\n");
    t.push_str("            \"c%d\": 2,\n");
    t.push_str("            \"e^f\": 3,\n");
    t.push_str("            \"foo\": [\n");
    t.push_str("                \"bar\",\n");
    t.push_str("                \"baz\"\n");
    t.push_str("            ],\n");
    t.push_str("            \"g|h\": 4,\n");
    t.push_str("            \"i\\\\j\": 5,\n");
    t.push_str("            \"k\\\"l\": 6,\n");
    t.push_str("            \"m~n\": 8\n");
    t.push_str("        }\n");
    t.push_str("    },\n");
    t.push_str("    { \"comment\": \"Move to same location has no effect\",\n");
    t.push_str("      \"doc\": {\"foo\": 1},\n");
    t.push_str("      \"patch\": [{\"op\": \"move\", \"from\": \"/foo\", \"path\": \"/foo\"}],\n");
    t.push_str("      \"expected\": {\"foo\": 1} },\n");
    t.push_str("\n");
    t.push_str("    { \"doc\": {\"foo\": 1, \"baz\": [{\"qux\": \"hello\"}]},\n");
    t.push_str("      \"patch\": [{\"op\": \"move\", \"from\": \"/foo\", \"path\": \"/bar\"}],\n");
    t.push_str("      \"expected\": {\"baz\": [{\"qux\": \"hello\"}], \"bar\": 1} },\n");
    t.push_str("\n");
    t.push_str("    { \"doc\": {\"baz\": [{\"qux\": \"hello\"}], \"bar\": 1},\n");
    t.push_str("      \"patch\": [{\"op\": \"move\", \"from\": \"/baz/0/qux\", \"path\": \"/baz/1\"}],\n");
    t.push_str("      \"expected\": {\"baz\": [{}, \"hello\"], \"bar\": 1} },\n");
    t.push_str("\n");
    t.push_str("    { \"doc\": {\"baz\": [{\"qux\": \"hello\"}], \"bar\": 1},\n");
    t.push_str("      \"patch\": [{\"op\": \"copy\", \"from\": \"/baz/0\", \"path\": \"/boo\"}],\n");
    t.push_str("      \"expected\": {\"baz\":[{\"qux\":\"hello\"}],\"bar\":1,\"boo\":{\"qux\":\"hello\"}} },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"replacing the root of the document is possible with add\",\n");
    t.push_str("      \"doc\": {\"foo\": \"bar\"},\n");
    t.push_str("      \"patch\": [{\"op\": \"add\", \"path\": \"\", \"value\": {\"baz\": \"qux\"}}],\n");
    t.push_str("      \"expected\": {\"baz\":\"qux\"}},\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"Adding to \\\"/-\\\" adds to the end of the array\",\n");
    t.push_str("      \"doc\": [ 1, 2 ],\n");
    t.push_str("      \"patch\": [ { \"op\": \"add\", \"path\": \"/-\", \"value\": { \"foo\": [ \"bar\", \"baz\" ] } } ],\n");
    t.push_str("      \"expected\": [ 1, 2, { \"foo\": [ \"bar\", \"baz\" ] } ]},\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"Adding to \\\"/-\\\" adds to the end of the array, even n levels down\",\n");
    t.push_str("      \"doc\": [ 1, 2, [ 3, [ 4, 5 ] ] ],\n");
    t.push_str("      \"patch\": [ { \"op\": \"add\", \"path\": \"/2/1/-\", \"value\": { \"foo\": [ \"bar\", \"baz\" ] } } ],\n");
    t.push_str("      \"expected\": [ 1, 2, [ 3, [ 4, 5, { \"foo\": [ \"bar\", \"baz\" ] } ] ] ]},\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"test remove with bad number should fail\",\n");
    t.push_str("      \"doc\": {\"foo\": 1, \"baz\": [{\"qux\": \"hello\"}]},\n");
    t.push_str("      \"patch\": [{\"op\": \"remove\", \"path\": \"/baz/1e0/qux\"}],\n");
    t.push_str("      \"error\": \"remove op shouldn't remove from array with bad number\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"test remove on array\",\n");
    t.push_str("      \"doc\": [1, 2, 3, 4],\n");
    t.push_str("      \"patch\": [{\"op\": \"remove\", \"path\": \"/0\"}],\n");
    t.push_str("      \"expected\": [2, 3, 4] },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"test repeated removes\",\n");
    t.push_str("      \"doc\": [1, 2, 3, 4],\n");
    t.push_str("      \"patch\": [{ \"op\": \"remove\", \"path\": \"/1\" },\n");
    t.push_str("                { \"op\": \"remove\", \"path\": \"/2\" }],\n");
    t.push_str("      \"expected\": [1, 3] },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"test remove with bad index should fail\",\n");
    t.push_str("      \"doc\": [1, 2, 3, 4],\n");
    t.push_str("      \"patch\": [{\"op\": \"remove\", \"path\": \"/1e0\"}],\n");
    t.push_str("      \"error\": \"remove op shouldn't remove from array with bad number\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"test replace with bad number should fail\",\n");
    t.push_str("      \"doc\": [\"\"],\n");
    t.push_str("      \"patch\": [{\"op\": \"replace\", \"path\": \"/1e0\", \"value\": false}],\n");
    t.push_str("      \"error\": \"replace op shouldn't replace in array with bad number\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"test copy with bad number should fail\",\n");
    t.push_str("      \"doc\": {\"baz\": [1,2,3], \"bar\": 1},\n");
    t.push_str("      \"patch\": [{\"op\": \"copy\", \"from\": \"/baz/1e0\", \"path\": \"/boo\"}],\n");
    t.push_str("      \"error\": \"copy op shouldn't work with bad number\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"test move with bad number should fail\",\n");
    t.push_str("      \"doc\": {\"foo\": 1, \"baz\": [1,2,3,4]},\n");
    t.push_str("      \"patch\": [{\"op\": \"move\", \"from\": \"/baz/1e0\", \"path\": \"/foo\"}],\n");
    t.push_str("      \"error\": \"move op shouldn't work with bad number\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"test add with bad number should fail\",\n");
    t.push_str("      \"doc\": [\"foo\", \"sil\"],\n");
    t.push_str("      \"patch\": [{\"op\": \"add\", \"path\": \"/1e0\", \"value\": \"bar\"}],\n");
    t.push_str("      \"error\": \"add op shouldn't add to array with bad number\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"missing 'path' parameter\",\n");
    t.push_str("      \"doc\": {},\n");
    t.push_str("      \"patch\": [ { \"op\": \"add\", \"value\": \"bar\" } ],\n");
    t.push_str("      \"error\": \"missing 'path' parameter\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"'path' parameter with null value\",\n");
    t.push_str("      \"doc\": {},\n");
    t.push_str("      \"patch\": [ { \"op\": \"add\", \"path\": null, \"value\": \"bar\" } ],\n");
    t.push_str("      \"error\": \"null is not valid value for 'path'\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"invalid JSON Pointer token\",\n");
    t.push_str("      \"doc\": {},\n");
    t.push_str("      \"patch\": [ { \"op\": \"add\", \"path\": \"foo\", \"value\": \"bar\" } ],\n");
    t.push_str("      \"error\": \"JSON Pointer should start with a slash\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"missing 'value' parameter to add\",\n");
    t.push_str("      \"doc\": [ 1 ],\n");
    t.push_str("      \"patch\": [ { \"op\": \"add\", \"path\": \"/-\" } ],\n");
    t.push_str("      \"error\": \"missing 'value' parameter\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"missing 'value' parameter to replace\",\n");
    t.push_str("      \"doc\": [ 1 ],\n");
    t.push_str("      \"patch\": [ { \"op\": \"replace\", \"path\": \"/0\" } ],\n");
    t.push_str("      \"error\": \"missing 'value' parameter\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"missing 'value' parameter to test\",\n");
    t.push_str("      \"doc\": [ null ],\n");
    t.push_str("      \"patch\": [ { \"op\": \"test\", \"path\": \"/0\" } ],\n");
    t.push_str("      \"error\": \"missing 'value' parameter\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"missing value parameter to test - where undef is falsy\",\n");
    t.push_str("      \"doc\": [ false ],\n");
    t.push_str("      \"patch\": [ { \"op\": \"test\", \"path\": \"/0\" } ],\n");
    t.push_str("      \"error\": \"missing 'value' parameter\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"missing from parameter to copy\",\n");
    t.push_str("      \"doc\": [ 1 ],\n");
    t.push_str("      \"patch\": [ { \"op\": \"copy\", \"path\": \"/-\" } ],\n");
    t.push_str("      \"error\": \"missing 'from' parameter\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"missing from location to copy\",\n");
    t.push_str("      \"doc\": { \"foo\": 1 },\n");
    t.push_str("      \"patch\": [ { \"op\": \"copy\", \"from\": \"/bar\", \"path\": \"/foo\" } ],\n");
    t.push_str("      \"error\": \"missing 'from' location\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"missing from parameter to move\",\n");
    t.push_str("      \"doc\": { \"foo\": 1 },\n");
    t.push_str("      \"patch\": [ { \"op\": \"move\", \"path\": \"\" } ],\n");
    t.push_str("      \"error\": \"missing 'from' parameter\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"missing from location to move\",\n");
    t.push_str("      \"doc\": { \"foo\": 1 },\n");
    t.push_str("      \"patch\": [ { \"op\": \"move\", \"from\": \"/bar\", \"path\": \"/foo\" } ],\n");
    t.push_str("      \"error\": \"missing 'from' location\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"duplicate ops\",\n");
    t.push_str("      \"doc\": { \"foo\": \"bar\" },\n");
    t.push_str("      \"patch\": [ { \"op\": \"add\", \"path\": \"/baz\", \"value\": \"qux\",\n");
    t.push_str("                   \"op\": \"move\", \"from\":\"/foo\" } ],\n");
    t.push_str("      \"error\": \"patch has two 'op' members\",\n");
    t.push_str("      \"disabled\": true },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"unrecognized op should fail\",\n");
    t.push_str("      \"doc\": {\"foo\": 1},\n");
    t.push_str("      \"patch\": [{\"op\": \"spam\", \"path\": \"/foo\", \"value\": 1}],\n");
    t.push_str("      \"error\": \"Unrecognized op 'spam'\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"test with bad array number that has leading zeros\",\n");
    t.push_str("      \"doc\": [\"foo\", \"bar\"],\n");
    t.push_str("      \"patch\": [{\"op\": \"test\", \"path\": \"/00\", \"value\": \"foo\"}],\n");
    t.push_str("      \"error\": \"test op should reject the array value, it has leading zeros\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"test with bad array number that has leading zeros\",\n");
    t.push_str("      \"doc\": [\"foo\", \"bar\"],\n");
    t.push_str("      \"patch\": [{\"op\": \"test\", \"path\": \"/01\", \"value\": \"bar\"}],\n");
    t.push_str("      \"error\": \"test op should reject the array value, it has leading zeros\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"Removing nonexistent field\",\n");
    t.push_str("      \"doc\": {\"foo\" : \"bar\"},\n");
    t.push_str("      \"patch\": [{\"op\": \"remove\", \"path\": \"/baz\"}],\n");
    t.push_str("      \"error\": \"removing a nonexistent field should fail\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"Removing deep nonexistent path\",\n");
    t.push_str("      \"doc\": {\"foo\" : \"bar\"},\n");
    t.push_str("      \"patch\": [{\"op\": \"remove\", \"path\": \"/missing1/missing2\"}],\n");
    t.push_str("      \"error\": \"removing a nonexistent field should fail\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"Removing nonexistent index\",\n");
    t.push_str("      \"doc\": [\"foo\", \"bar\"],\n");
    t.push_str("      \"patch\": [{\"op\": \"remove\", \"path\": \"/2\"}],\n");
    t.push_str("      \"error\": \"removing a nonexistent index should fail\" },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"Patch with different capitalisation than doc\",\n");
    t.push_str("       \"doc\": {\"foo\":\"bar\"},\n");
    t.push_str("       \"patch\": [{\"op\": \"add\", \"path\": \"/FOO\", \"value\": \"BAR\"}],\n");
    t.push_str("       \"expected\": {\"foo\": \"bar\", \"FOO\": \"BAR\"} },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"test copy object then change destination\",\n");
    t.push_str("      \"doc\": {\"foo\": {\"bar\": {\"baz\": [{\"boo\": \"net\"}]}}},\n");
    t.push_str("      \"patch\": [\n");
    t.push_str("        {\"op\": \"copy\", \"from\": \"/foo\", \"path\": \"/bak\"},\n");
    t.push_str("        {\"op\": \"replace\", \"path\": \"/bak/bar/baz/0/boo\", \"value\": \"qux\"}\n");
    t.push_str("      ],\n");
    t.push_str("      \"expected\": {\"foo\": {\"bar\": {\"baz\": [{\"boo\": \"net\"}]}}, \"bak\": {\"bar\": {\"baz\": [{\"boo\":\"qux\"}]}}} },\n");
    t.push_str("\n");
    t.push_str("    { \"comment\": \"test copy object then change source\",\n");
    t.push_str("      \"doc\": {\"foo\": {\"bar\": {\"baz\": [{\"boo\": \"net\"}]}}},\n");
    t.push_str("      \"patch\": [\n");
    t.push_str("        {\"op\": \"copy\", \"from\": \"/foo\", \"path\": \"/bak\"},\n");
    t.push_str("        {\"op\": \"replace\", \"path\": \"/foo/bar/baz/0/boo\", \"value\": \"qux\"}\n");
    t.push_str("      ],\n");
    t.push_str("      \"expected\": {\"foo\": {\"bar\": {\"baz\": [{\"boo\": \"qux\"}]}}, \"bak\": {\"bar\": {\"baz\": [{\"boo\":\"net\"}]}}}\n");
    t.push_str("    }\n");
    t.push_str("\n");
    t.push_str("]\n");
    v.push(DataFile { path: "suite/tests.json".to_string(), hex: false, body: t });
}
