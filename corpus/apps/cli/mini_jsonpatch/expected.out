== jsonpatch --indent 2 k8s/deployment.json patches/prod-overlay.json
{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "checkout",
    "namespace": "shop",
    "labels": {
      "app": "checkout",
      "tier": "backend",
      "env": "prod"
    },
    "annotations": {
      "deployment.kubernetes.io/revision": "8",
      "team~owner": "payments"
    }
  },
  "spec": {
    "replicas": 6,
    "selector": {
      "matchLabels": {
        "app": "checkout"
      }
    },
    "strategy": {
      "type": "RollingUpdate",
      "rollingUpdate": {
        "maxSurge": "25%",
        "maxUnavailable": 0
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "checkout",
          "tier": "backend"
        }
      },
      "spec": {
        "containers": [
          {
            "name": "app",
            "image": "registry.example/checkout:2.5.0",
            "args": [
              "--port=8080",
              "--log-level=info"
            ],
            "ports": [
              {
                "containerPort": 8080,
                "name": "http"
              }
            ],
            "env": [
              {
                "name": "DB_HOST",
                "value": "db.shop.svc"
              },
              {
                "name": "CACHE_TTL",
                "value": "300"
              },
              {
                "name": "REGION",
                "value": "eu-west-1"
              }
            ],
            "resources": {
              "limits": {
                "cpu": "500m",
                "memory": "256Mi"
              },
              "requests": {
                "cpu": 0.25,
                "memory": "128Mi"
              }
            },
            "readinessProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": 8080
              },
              "periodSeconds": 10
            }
          }
        ],
        "tolerations": [
          {
            "key": "dedicated",
            "operator": "Equal",
            "value": "shop",
            "effect": "NoSchedule"
          }
        ],
        "nodeSelector": {
          "kubernetes.io/os": "linux"
        }
      }
    }
  }
}
