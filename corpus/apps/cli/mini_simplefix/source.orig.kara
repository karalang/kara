    let mut s = String.new();
    s.push_str("job Building a message: append_pair, the header and the values\nnew m\npair m i:8 s:FIX.4.2\npair m i:35 s:D\npair m i:29 s:A\npair m i:11 i:12345\npair m s:55 s:IBM\npair m s:035 s:F\npair m s:~t2056 s:Y\npair m b:44 b:101.25\npair m i:49 s:SENDER h\npair m i:56 s:TARGET h\npair m - s:ignored\npair m i:58 -\npair m s:abc s:x\npair m s:1~t5f0 s:underscore\npair m s:~t2b7 s:plus\nshow m\nshow m s:,~t20\ncount m\nenc m\nenc m raw\nget m i:35\nget m s:035\nget m i:56\nget m i:1\nhas m i:44\nhas m s:44\nhas m i:45\nitem m i:0\nitem m i:2\nitem m i:40\njob append_string and append_strings\nnew m\nstr m s:8=FIX.4.4\nstr m s:35=8\nstr m s:58=a=b=c\nstrs m s:1=ACCT s:21=1 s:207=XNYS\nstr m s:no-equals\nstr m s:x=1\nstr m s:~t20~t207=Y\nstr m s:10=\nshow m\nenc m\nenc m raw\njob Repeating fields: get and remove the nth\nnew m\npair m i:8 s:FIX.4.4\npair m i:35 s:W\npair m i:268 i:3\npair m i:269 s:0\npair m i:270 s:99.50\npair m i:271 s:1200\npair m i:269 s:1\npair m i:270 s:99.75\npair m i:271 s:900\npair m i:269 s:2\npair m i:270 s:99.60\npair m i:271 s:300\nget m i:270\nget m i:270 i:2\nget m i:270 i:3\nget m i:270 i:4\nget m i:270 i:0\nrm m i:270 i:2\nget m i:270 i:2\nrm m i:270 i:9\nrm m s:269\ncount m\nshow m\nenc m\njob encode(): BodyLength, CheckSum and the field order\nnew m\npair m i:10 s:999\npair m i:9 s:999\npair m i:58 s:checksum~t20and~t20length~t20first\npair m i:35 s:0\npair m i:8 s:FIX.4.4\nenc m\nenc m raw\nnew e\nenc e\nenc e raw\nnew n35\npair n35 i:8 s:FIX.4.2\nenc n35\nnew n8\npair n8 i:35 s:D\nenc n8\nnew n9\npair n9 i:8 b:\npair n9 i:35 s:0\nenc n9\nnew big\npair big i:8 s:FIXT.1.1\npair big i:35 s:AE\npair big i:1128 s:9\npair big i:58 s:\nenc big\njob Raw data fields\n");
