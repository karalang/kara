enc n35 = ! ValueError: No message type set
enc n8 = ! ValueError: No begin string set
enc n9 = ! ValueError: No begin string set
enc big = b'8=FIXT.1.1|9=317|35=AE|1128=9||10=059|'
== Raw data fields
