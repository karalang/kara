== Building a message: append_pair, the header and the values
pair m s:abc s:x = ! ValueError: invalid literal for int() with base 10: 'abc'
show m = 49=SENDER|56=TARGET|8=FIX.4.2|35=D|29=A|11=12345|55=IBM|035=F| 56=Y|44=101.25|1_0=underscore|+7=plus
show m s:,~20 = 49=SENDER, 56=TARGET, 8=FIX.4.2, 35=D, 29=A, 11=12345, 55=IBM, 035=F,  56=Y, 44=101.25, 1_0=underscore, +7=plus
count m = 12
enc m = b'8=FIX.4.2|9=70|35=F|49=SENDER|56=TARGET|29=A|11=12345|55=IBM| 56=Y|44=101.25|+7=plus|10=033|'
enc m raw = b'49=SENDER|56=TARGET|8=FIX.4.2|35=D|29=A|11=12345|55=IBM|035=F| 56=Y|44=101.25|1_0=underscore|+7=plus|'
get m i:35 = b'D'
get m s:035 = b'F'
get m i:56 = b'TARGET'
get m i:1 = None
has m i:44 = True
has m s:44 = True
has m i:45 = False
item m i:0 = (49, b'SENDER')
item m i:2 = (8, b'FIX.4.2')
item m i:40 = ! IndexError
== append_string and append_strings
str m s:no-equals = ! ValueError: Field missing '=' separator.
str m s:x=1 = ! ValueError: Tag value must be an integer
show m = 8=FIX.4.4|35=8|58=a=b=c|1=ACCT|21=1|207=XNYS|7=Y|10=
enc m = b'8=FIX.4.4|9=39|35=8|58=a=b=c|1=ACCT|21=1|207=XNYS|7=Y|10=128|'
enc m raw = b'8=FIX.4.4|35=8|58=a=b=c|1=ACCT|21=1|207=XNYS|7=Y|10=|'
