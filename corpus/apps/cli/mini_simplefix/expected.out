get m i:270 i:2 = b'99.75'
get m i:270 i:3 = b'99.60'
get m i:270 i:4 = None
get m i:270 i:0 = None
rm m i:270 i:2 = b'99.75'
get m i:270 i:2 = b'99.60'
rm m i:270 i:9 = None
rm m s:269 = b'0'
count m = 10
show m = 8=FIX.4.4|35=W|268=3|270=99.50|271=1200|269=1|271=900|269=2|270=99.60|271=300
enc m = b'8=FIX.4.4|9=68|35=W|268=3|270=99.50|271=1200|269=1|271=900|269=2|270=99.60|271=300|10=101|'
