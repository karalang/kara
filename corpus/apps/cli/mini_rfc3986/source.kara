// mini_rfc3986: rfc3986 2.0.0, the strict RFC 3986 URI library (with
// IRIs per RFC 3987) that requests, urllib3 and many API clients lean
// on for URI handling that urllib.parse does not do.
//
// The port covers URIReference and IRIReference (parsing, the
// authority's userinfo, host and port, validity, normalization,
// equality, RFC 3986 §5 reference resolution, IRI to URI encoding with
// IDNA 2008 hosts), ParseResult and ParseResultBytes (from strings and
// from parts, copy_with, encode, unsplit with Python's IDNA 2003 codec),
// URIBuilder (with urllib's quote, urlencode and parse_qsl), the
// Validator, and the module's normalizers.
//
// The patterns of rfc3986.misc run on mini_re (as in mini_soupsieve),
// except URI_MATCHER and the percent-escape finder, which are written
// out. The jobs come from rfc3986's own test suite; a webhook registry
// is then checked against a policy. expected.out is oracle.py's output,
// which runs the same jobs through rfc3986 itself.

// ---------------------------------------------------------------- strings

fn cps(s: ref String) -> Vec[i64] {
    codepoints(s.bytes())
}

fn py_repr(s: ref String) -> String {
    repr_of(cps(s))
}

// str.isspace.
fn py_isspace(c: char) -> bool {
    c.is_whitespace() or (c >= '\u{1c}' and c <= '\u{1f}')
}

fn char_vec(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn from_chars(v: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut out = String.new();
    let mut i = lo;
    while i < hi {
        out.push(v[i]);
        i += 1;
    }
    out
}

fn in_chars(c: char, set: Str) -> bool {
    for x in set.chars() {
        if x == c {
            return true;
        }
    }
    false
}

// str.strip() / lstrip() / rstrip() with no argument (set "") or with the
// characters of `set`.
fn strip_by(s: ref String, set: Str, left: bool, right: bool) -> String {
    let v = char_vec(s);
    let mut a = 0;
    let mut b = v.len();
    if left {
        while a < b and (if set.is_empty() { py_isspace(v[a]) } else { in_chars(v[a], set) }) {
            a += 1;
        }
    }
    if right {
        while b > a and (if set.is_empty() { py_isspace(v[b - 1]) } else { in_chars(v[b - 1], set) }) {
            b -= 1;
        }
    }
    from_chars(v, a, b)
}

fn py_strip(s: ref String) -> String {
    strip_by(s, "", true, true)
}

fn py_rstrip(s: ref String) -> String {
    strip_by(s, "", false, true)
}

fn char_len(s: ref String) -> i64 {
    s.chars().count()
}

fn repeat(s: Str, n: i64) -> String {
    let mut out = String.new();
    let mut i = 0;
    while i < n {
        out.push_str(s);
        i += 1;
    }
    out
}

// The pieces of s.split("\n").
fn split_nl(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == '\n' {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn ascii_digits(s: ref String) -> bool {
    if s.is_empty() {
        return false;
    }
    for c in s.chars() {
        if c < '0' or c > '9' {
            return false;
        }
    }
    true
}

// int() of ASCII digits, saturating far past any value the callers clamp.
fn digits_int(s: ref String) -> i64 {
    let mut n = 0;
    for c in s.chars() {
        if n < 1000000000000 {
            n = n * 10 + (c as i64 - 48);
        }
    }
    n
}

fn has(v: ref Vec[String], s: Str) -> bool {
    for x in v.iter() {
        if x == s {
            return true;
        }
    }
    false
}

// ------------------------------------------------------------ errors

struct ReErr {
    kind: String,
    msg: String,
    pos: i64,
}

fn re_error(msg: own String, pos: i64) -> ReErr {
    ReErr { kind: "error".to_string(), msg: msg, pos: pos }
}

fn other_error(kind: Str, msg: own String) -> ReErr {
    ReErr { kind: kind.to_string(), msg: msg, pos: -1 }
}

fn err_text(e: ref ReErr) -> String {
    if e.kind == "error" {
        if e.pos >= 0 {
            return f"error: {e.msg} at position {e.pos}";
        }
        return f"error: {e.msg}";
    }
    f"{e.kind}: {e.msg}"
}

// -------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for cp in s {
        if cp < 0x80 {
            out.push(cp as u8);
        } else if cp < 0x800 {
            out.push((0xC0 | (cp >> 6)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else if cp < 0x10000 {
            out.push((0xE0 | (cp >> 12)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (cp >> 18)) as u8);
            out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

fn str_repr(s: ref Vec[i64], out: mut ref Vec[i64]) {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
}

fn repr_of(s: ref Vec[i64]) -> String {
    let mut out: Vec[i64] = Vec.new();
    str_repr(s, mut out);
    to_string(out)
}

// ----------------------------------------------------- character kinds

fn is_decimal(c: i64) -> bool {
    if c < 0x80 {
        return c >= 48 and c <= 57;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return true;
        }
    }
    false
}

fn is_space(c: i64, ascii: bool) -> bool {
    if c == 32 or (c >= 9 and c <= 13) {
        return true;
    }
    if ascii {
        return false;
    }
    (c >= 0x1C and c <= 0x1F) or c == 0x85 or c == 0xA0 or c == 0x1680 or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F or c == 0x3000
}

fn as_char(c: i64) -> Option[char] {
    if c < 0 or (c >= 0xD800 and c <= 0xDFFF) or c > 0x10FFFF {
        return None;
    }
    char.try_from(c as u32).ok()
}

fn is_word(c: i64, ascii: bool) -> bool {
    if c < 0x80 {
        return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
    }
    if ascii {
        return false;
    }
    match as_char(c) {
        Some(ch) => ch.is_alphanumeric(),
        None => false,
    }
}

fn lower(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 65 and c <= 90 { c + 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_lowercase() as u32 as i64,
        None => c,
    }
}

fn upper(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 97 and c <= 122 { c - 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_uppercase() as u32 as i64,
        None => c,
    }
}

// ------------------------------------------------------- parsed form

// The categories of \d \D \s \S \w \W.
fn cat_digit() -> i64 { 0 }
fn cat_not_digit() -> i64 { 1 }
fn cat_space() -> i64 { 2 }
fn cat_not_space() -> i64 { 3 }
fn cat_word() -> i64 { 4 }
fn cat_not_word() -> i64 { 5 }

// The positions ^ $ \A \Z \b \B and the forms the compiler turns them
// into under MULTILINE.
fn at_beginning() -> i64 { 0 }
fn at_beginning_line() -> i64 { 1 }
fn at_beginning_string() -> i64 { 2 }
fn at_end() -> i64 { 3 }
fn at_end_line() -> i64 { 4 }
fn at_end_string() -> i64 { 5 }
fn at_boundary() -> i64 { 6 }
fn at_non_boundary() -> i64 { 7 }

#[derive(Clone)]
enum Item {
    Lit(i64),
    Range(i64, i64),
    Cat(i64),
}

enum Node {
    Lit(i64),
    NotLit(i64),
    Any,
    In(Vec[Item], bool),
    At(i64),
    Branch(Vec[Vec[Node]]),
    // group (0: none), flags turned on, flags turned off, contents
    Group(i64, i64, i64, Vec[Node]),
    // 0 greedy, 1 lazy, 2 possessive; min; max; the item repeated
    Repeat(i64, i64, i64, Vec[Node]),
    Atomic(Vec[Node]),
    // direction (1 ahead, -1 behind), negative, contents
    Assert(i64, bool, Vec[Node]),
    GroupRef(i64),
    // group, yes branch, no branch
    Exists(i64, Vec[Node], Vec[Node]),
    Failure,
}

fn is_repeat(n: ref Node) -> bool {
    match n {
        Node.Repeat(_, _, _, _) => true,
        _ => false,
    }
}

fn is_at(n: ref Node) -> bool {
    match n {
        Node.At(_) => true,
        _ => false,
    }
}

fn flag_i() -> i64 { 2 }
fn flag_l() -> i64 { 4 }
fn flag_m() -> i64 { 8 }
fn flag_s() -> i64 { 16 }
fn flag_u() -> i64 { 32 }
fn flag_x() -> i64 { 64 }
fn flag_a() -> i64 { 256 }
fn type_flags() -> i64 { 4 | 32 | 256 }
fn maxrepeat() -> i64 { 4294967295 }
fn maxgroups() -> i64 { 1073741823 }
fn maxwidth() -> i64 { 1 << 62 }

fn flag_value(c: i64) -> i64 {
    match c {
        105 => 2,
        76 => 4,
        109 => 8,
        115 => 16,
        120 => 64,
        97 => 256,
        117 => 32,
        _ => 0,
    }
}

// ------------------------------------------------------------ tokens

// One token: nothing at the end of the pattern (n 0), a character (n 1),
// or a backslash and the character after it (n 2).
#[derive(Copy, Clone)]
struct T {
    n: i64,
    a: i64,
    b: i64,
}

fn tok_none() -> T {
    T { n: 0, a: 0, b: 0 }
}

fn tok_is(t: T, c: i64) -> bool {
    t.n == 1 and t.a == c
}

fn tok_text(t: T) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    if t.n >= 1 {
        v.push(t.a);
    }
    if t.n == 2 {
        v.push(t.b);
    }
    v
}

fn is_ascii_letter(c: i64) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

fn is_hex(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

fn is_oct(c: i64) -> bool {
    c >= 48 and c <= 55
}

fn is_dec(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn digits_value(s: ref Vec[i64], start: i64, base: i64) -> i64 {
    let mut v = 0;
    let mut i = start;
    while i < s.len() {
        let c = s[i];
        let d = if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 };
        v = v * base + d;
        i += 1;
    }
    v
}

// str.isidentifier, near enough: a letter or underscore, then letters,
// digits and underscores.
fn is_identifier(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    let mut i = 0;
    while i < name.len() {
        let c = name[i];
        let ok = if c == 95 {
            true
        } else if i == 0 {
            match as_char(c) {
                Some(ch) => ch.is_alphabetic(),
                None => false,
            }
        } else {
            is_word(c, false)
        };
        if not ok {
            return false;
        }
        i += 1;
    }
    true
}

fn is_ascii_decimal(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    for c in name {
        if not is_dec(c) {
            return false;
        }
    }
    true
}

struct Tokenizer {
    s: Vec[i64],
    index: i64,
    next: T,
}

impl Tokenizer {
    fn advance(mut ref self) -> Result[(), ReErr] {
        let index = self.index;
        if index >= self.s.len() {
            self.next = tok_none();
            return Ok(());
        }
        let c = self.s[index];
        if c == 92 {
            if index + 1 >= self.s.len() {
                return Err(re_error("bad escape (end of pattern)".to_string(), self.s.len() - 1));
            }
            self.next = T { n: 2, a: 92, b: self.s[index + 1] };
            self.index = index + 2;
        } else {
            self.next = T { n: 1, a: c, b: 0 };
            self.index = index + 1;
        }
        Ok(())
    }

    fn get(mut ref self) -> Result[T, ReErr] {
        let t = self.next;
        self.advance()?;
        Ok(t)
    }

    fn take(mut ref self, c: i64) -> Result[bool, ReErr] {
        if tok_is(self.next, c) {
            self.advance()?;
            return Ok(true);
        }
        Ok(false)
    }

    fn tell(ref self) -> i64 {
        self.index - self.next.n
    }

    fn seek(mut ref self, index: i64) -> Result[(), ReErr] {
        self.index = index;
        self.advance()
    }

    fn error(ref self, msg: own String, offset: i64) -> ReErr {
        re_error(msg, self.tell() - offset)
    }

    // getwhile: up to n characters of a kind (0 octal, 1 decimal, 2 hex).
    fn getwhile(mut ref self, n: i64, kind: i64, out: mut ref Vec[i64]) -> Result[(), ReErr] {
        let mut k = 0;
        while k < n {
            let t = self.next;
            if t.n != 1 {
                break;
            }
            let ok = if kind == 0 { is_oct(t.a) } else if kind == 1 { is_dec(t.a) } else { is_hex(t.a) };
            if not ok {
                break;
            }
            out.push(t.a);
            self.advance()?;
            k += 1;
        }
        Ok(())
    }

    fn getuntil(mut ref self, terminator: i64, name: Str) -> Result[Vec[i64], ReErr] {
        let mut result: Vec[i64] = Vec.new();
        loop {
            let c = self.next;
            self.advance()?;
            if c.n == 0 {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 0));
                }
                let term = to_string(vec_of(terminator));
                return Err(self.error(f"missing {term}, unterminated name", result.len()));
            }
            if tok_is(c, terminator) {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 1));
                }
                break;
            }
            push_all(mut result, tok_text(c));
        }
        Ok(result)
    }

    fn checkgroupname(ref self, name: ref Vec[i64], offset: i64) -> Result[(), ReErr] {
        if not is_identifier(name) {
            return Err(self.error(f"bad character in group name {repr_of(name)}", name.len() + offset));
        }
        Ok(())
    }
}

fn vec_of(c: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(c);
    v
}

fn new_tokenizer(s: ref Vec[i64]) -> Result[Tokenizer, ReErr] {
    let mut t = Tokenizer { s: s.clone(), index: 0, next: tok_none() };
    t.advance()?;
    Ok(t)
}

// ------------------------------------------------------------ parser

#[derive(Clone)]
struct Width {
    lo: i64,
    hi: i64,
}

struct ParseState {
    flags: i64,
    names: Vec[(Vec[i64], i64)],
    // per group: whether it is closed, and its width
    closed: Vec[bool],
    widths: Vec[Width],
    lookbehind_groups: i64,
    // conditional references by number, in order: (group, position)
    refpos: Vec[(i64, i64)],
}

impl ParseState {
    fn groups(ref self) -> i64 {
        self.closed.len()
    }

    fn group_of(ref self, name: ref Vec[i64]) -> i64 {
        for (n, g) in self.names.iter() {
            if same(n, name) {
                return *g;
            }
        }
        -1
    }

    fn checkgroup(ref self, gid: i64) -> bool {
        gid < self.groups() and self.closed[gid]
    }

    fn checklookbehindgroup(ref self, gid: i64, src: ref Tokenizer) -> Result[(), ReErr] {
        if self.lookbehind_groups >= 0 {
            if not self.checkgroup(gid) {
                return Err(src.error("cannot refer to an open group".to_string(), 0));
            }
            if gid >= self.lookbehind_groups {
                return Err(src.error("cannot refer to group defined in the same lookbehind subpattern".to_string(), 0));
            }
        }
        Ok(())
    }
}

fn add_width(a: i64, b: i64) -> i64 {
    if a >= maxwidth() - b { maxwidth() } else { a + b }
}

fn mul_width(a: i64, n: i64) -> i64 {
    if a == 0 or n == 0 {
        0
    } else if a >= maxwidth() / n {
        maxwidth()
    } else {
        a * n
    }
}

// SubPattern.getwidth.
fn width_of(widths: ref Vec[Width], p: ref Vec[Node]) -> Width {
    let mut lo = 0;
    let mut hi = 0;
    for n in p.iter() {
        match n {
            Node.Branch(items) => {
                let mut i = maxwidth();
                let mut j = 0;
                for item in items.iter() {
                    let w = width_of(widths, item);
                    if w.lo < i {
                        i = w.lo;
                    }
                    if w.hi > j {
                        j = w.hi;
                    }
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Atomic(body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Group(_, _, _, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Repeat(_, min, max, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, mul_width(w.lo, *min));
                if *max == maxrepeat() and w.hi > 0 {
                    hi = maxwidth();
                } else {
                    hi = add_width(hi, mul_width(w.hi, *max));
                }
            }
            Node.GroupRef(g) => {
                let w = ref widths[*g];
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Exists(_, yes, no) => {
                let wy = width_of(widths, yes);
                let mut i = wy.lo;
                let mut j = wy.hi;
                if no.len() > 0 {
                    let wn = width_of(widths, no);
                    if wn.lo < i {
                        i = wn.lo;
                    }
                    if wn.hi > j {
                        j = wn.hi;
                    }
                } else {
                    i = 0;
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Lit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.NotLit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.Any => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.In(_, _) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            _ => {}
        }
    }
    Width { lo: lo, hi: hi }
}

fn category_of(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        100 => 0,
        68 => 1,
        115 => 2,
        83 => 3,
        119 => 4,
        87 => 5,
        _ => -1,
    }
}

fn escape_value(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        97 => 7,
        98 => 8,
        102 => 12,
        110 => 10,
        114 => 13,
        116 => 9,
        118 => 11,
        92 => 92,
        _ => -1,
    }
}

// \x, \u and \U: the escape text so far, and the code point.
fn hex_escape(src: mut ref Tokenizer, t: T, esc: mut ref Vec[i64]) -> Result[i64, ReErr] {
    let n = if t.b == 120 { 2 } else if t.b == 117 { 4 } else { 8 };
    src.getwhile(n, 2, mut esc)?;
    if esc.len() != n + 2 {
        return Err(src.error(f"incomplete escape {to_string(esc)}", esc.len()));
    }
    let c = digits_value(esc, 2, 16);
    if c > 0x10FFFF {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(c)
}

// _class_escape: an escape inside [...], a literal or a category.
fn class_escape(src: mut ref Tokenizer, t: T) -> Result[Item, ReErr] {
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Item.Lit(e));
    }
    let cat = category_of(t);
    if cat >= 0 {
        return Ok(Item.Cat(cat));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Item.Lit(v));
    }
    if is_oct(c) {
        src.getwhile(2, 0, mut esc)?;
        let v = digits_value(esc, 1, 8);
        if v > 0o377 {
            return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
        }
        return Ok(Item.Lit(v));
    }
    if is_dec(c) or is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Item.Lit(c))
}

// _escape: an escape outside a set.
fn escape(src: mut ref Tokenizer, t: T, st: ref ParseState) -> Result[Node, ReErr] {
    let cat = category_of(t);
    if cat >= 0 {
        let mut items: Vec[Item] = Vec.new();
        items.push(Item.Cat(cat));
        return Ok(Node.In(items, false));
    }
    match t.b {
        65 => return Ok(Node.At(at_beginning_string())),
        98 => return Ok(Node.At(at_boundary())),
        66 => return Ok(Node.At(at_non_boundary())),
        90 => return Ok(Node.At(at_end_string())),
        _ => {}
    }
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Node.Lit(e));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Node.Lit(v));
    }
    if c == 48 {
        src.getwhile(2, 0, mut esc)?;
        return Ok(Node.Lit(digits_value(esc, 1, 8)));
    }
    if is_dec(c) {
        // an octal escape or a group reference
        let nt = src.next;
        if nt.n == 1 and is_dec(nt.a) {
            esc.push(nt.a);
            src.advance()?;
            let nt2 = src.next;
            if is_oct(esc[1]) and is_oct(esc[2]) and nt2.n == 1 and is_oct(nt2.a) {
                esc.push(nt2.a);
                src.advance()?;
                let v = digits_value(esc, 1, 8);
                if v > 0o377 {
                    return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
                }
                return Ok(Node.Lit(v));
            }
        }
        let group = digits_value(esc, 1, 10);
        if group < st.groups() {
            if not st.checkgroup(group) {
                return Err(src.error("cannot refer to an open group".to_string(), esc.len()));
            }
            st.checklookbehindgroup(group, src)?;
            return Ok(Node.GroupRef(group));
        }
        return Err(src.error(f"invalid group reference {group}", esc.len() - 1));
    }
    if is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Node.Lit(c))
}

fn parse_sub(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64) -> Result[Vec[Node], ReErr] {
    let mut items: Vec[Vec[Node]] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let first = nested == 0 and items.len() == 0;
        let item = parse_seq(mut src, mut st, verbose, nested + 1, first)?;
        items.push(item);
        if not src.take(124)? {
            break;
        }
        if nested == 0 {
            verbose = (st.flags & flag_x()) != 0;
        }
    }
    if items.len() == 1 {
        return Ok(items.pop().unwrap());
    }
    let mut out: Vec[Node] = Vec.new();
    out.push(Node.Branch(items));
    Ok(out)
}

// _parse_flags: None (as Err-free Ok(None)) for global flags, else the
// flags turned on and off.
fn parse_flags(src: mut ref Tokenizer, st: mut ref ParseState, first_char: T) -> Result[Option[(i64, i64)], ReErr] {
    let mut ch = first_char;
    let mut add = 0;
    let mut del = 0;
    if not tok_is(ch, 45) {
        loop {
            let flag = flag_value(ch.a);
            if ch.a == 76 {
                return Err(src.error("bad inline flags: cannot use 'L' flag with a str pattern".to_string(), 0));
            }
            add = add | flag;
            if (flag & type_flags()) != 0 and (add & type_flags()) != flag {
                return Err(src.error("bad inline flags: flags 'a', 'u' and 'L' are incompatible".to_string(), 0));
            }
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing -, : or )".to_string(), 0));
            }
            if tok_is(ch, 41) or tok_is(ch, 45) or tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing -, : or )" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if tok_is(ch, 41) {
        st.flags = st.flags | add;
        return Ok(None);
    }
    if tok_is(ch, 45) {
        ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("missing flag".to_string(), 0));
        }
        if ch.n != 1 or flag_value(ch.a) == 0 {
            let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing flag" };
            return Err(src.error(msg.to_string(), ch.n));
        }
        loop {
            let flag = flag_value(ch.a);
            if (flag & type_flags()) != 0 {
                return Err(src.error("bad inline flags: cannot turn off flags 'a', 'u' and 'L'".to_string(), 0));
            }
            del = del | flag;
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing :".to_string(), 0));
            }
            if tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing :" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if (add & del) != 0 {
        return Err(src.error("bad inline flags: flag turned on and off".to_string(), 1));
    }
    Ok(Some((add, del)))
}

fn is_alpha(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

fn parse_set(src: mut ref Tokenizer, out: mut ref Vec[Node]) -> Result[(), ReErr] {
    let here = src.tell() - 1;
    let mut set: Vec[Item] = Vec.new();
    let negate = src.take(94)?;
    loop {
        let this = src.get()?;
        if this.n == 0 {
            return Err(src.error("unterminated character set".to_string(), src.tell() - here));
        }
        if tok_is(this, 93) and set.len() > 0 {
            break;
        }
        let code1 = if this.n == 2 { class_escape(mut src, this)? } else { Item.Lit(this.a) };
        if src.take(45)? {
            let that = src.get()?;
            if that.n == 0 {
                return Err(src.error("unterminated character set".to_string(), src.tell() - here));
            }
            if tok_is(that, 93) {
                set.push(code1);
                set.push(Item.Lit(45));
                break;
            }
            let code2 = if that.n == 2 { class_escape(mut src, that)? } else { Item.Lit(that.a) };
            let text = f"{to_string(tok_text(this))}-{to_string(tok_text(that))}";
            let offset = this.n + 1 + that.n;
            let lo = match code1 {
                Item.Lit(c) => c,
                _ => -1,
            };
            let hi = match code2 {
                Item.Lit(c) => c,
                _ => -1,
            };
            if lo < 0 or hi < 0 or hi < lo {
                return Err(src.error(f"bad character range {text}", offset));
            }
            set.push(Item.Range(lo, hi));
        } else {
            set.push(code1);
        }
    }
    if set.len() == 1 {
        let only = ref set[0];
        if let Item.Lit(c) = only {
            if negate {
                out.push(Node.NotLit(*c));
            } else {
                out.push(Node.Lit(*c));
            }
            return Ok(());
        }
    }
    out.push(Node.In(set, negate));
    Ok(())
}

// The quantifier just read (its first character is `this`), applied to
// the last item. Returns false when `{` turned out to be a literal.
fn parse_repeat(src: mut ref Tokenizer, this: T, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let here = src.tell();
    let mut min = 0;
    let mut max = maxrepeat();
    if tok_is(this, 63) {
        max = 1;
    } else if tok_is(this, 43) {
        min = 1;
    } else if tok_is(this, 123) {
        if tok_is(src.next, 125) {
            out.push(Node.Lit(123));
            return Ok(false);
        }
        let mut lo: Vec[i64] = Vec.new();
        let mut hi: Vec[i64] = Vec.new();
        while src.next.n == 1 and is_dec(src.next.a) {
            lo.push(src.get()?.a);
        }
        if src.take(44)? {
            while src.next.n == 1 and is_dec(src.next.a) {
                hi.push(src.get()?.a);
            }
        } else {
            hi = lo.clone();
        }
        if not src.take(125)? {
            out.push(Node.Lit(123));
            src.seek(here)?;
            return Ok(false);
        }
        if lo.len() > 0 {
            if lo.len() > 10 or digits_value(lo, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            min = digits_value(lo, 0, 10);
        }
        if hi.len() > 0 {
            if hi.len() > 10 or digits_value(hi, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            max = digits_value(hi, 0, 10);
            if max < min {
                return Err(src.error("min repeat greater than max repeat".to_string(), src.tell() - here));
            }
        }
    }
    if out.len() == 0 or is_at(out[out.len() - 1]) {
        return Err(src.error("nothing to repeat".to_string(), src.tell() - here + 1));
    }
    if is_repeat(out[out.len() - 1]) {
        return Err(src.error("multiple repeat".to_string(), src.tell() - here + 1));
    }
    let last = out.pop().unwrap();
    let mut body: Vec[Node] = Vec.new();
    match last {
        Node.Group(0, 0, 0, p) => body = p,
        other => body.push(other),
    }
    let kind = if src.take(63)? { 1 } else if src.take(43)? { 2 } else { 0 };
    out.push(Node.Repeat(kind, min, max, body));
    Ok(true)
}

fn parse_seq(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64, first: bool) -> Result[Vec[Node], ReErr] {
    let mut out: Vec[Node] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let this = src.next;
        if this.n == 0 or tok_is(this, 124) or tok_is(this, 41) {
            break;
        }
        src.advance()?;
        if verbose {
            if this.n == 1 and (this.a == 32 or (this.a >= 9 and this.a <= 13)) {
                continue;
            }
            if tok_is(this, 35) {
                loop {
                    let t = src.get()?;
                    if t.n == 0 or tok_is(t, 10) {
                        break;
                    }
                }
                continue;
            }
        }
        if this.n == 2 {
            let node = escape(mut src, this, st)?;
            out.push(node);
            continue;
        }
        let c = this.a;
        if c == 91 {
            parse_set(mut src, mut out)?;
        } else if c == 42 or c == 43 or c == 63 or c == 123 {
            parse_repeat(mut src, this, mut out)?;
        } else if c == 46 {
            out.push(Node.Any);
        } else if c == 94 {
            out.push(Node.At(at_beginning()));
        } else if c == 36 {
            out.push(Node.At(at_end()));
        } else if c == 40 {
            if parse_group(mut src, mut st, mut verbose, nested, first, mut out)? {
                continue;
            }
        } else {
            out.push(Node.Lit(c));
        }
    }
    Ok(out)
}

// `(` and what follows. Returns true for a construct that adds nothing
// (a comment, global flags).
fn parse_group(src: mut ref Tokenizer, st: mut ref ParseState, verbose: mut ref bool, nested: i64, first: bool, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let start = src.tell() - 1;
    let mut capture = true;
    let mut atomic = false;
    let mut name: Vec[i64] = Vec.new();
    let mut named = false;
    let mut add = 0;
    let mut del = 0;
    if src.take(63)? {
        let ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("unexpected end of pattern".to_string(), 0));
        }
        if tok_is(ch, 80) {
            if src.take(60)? {
                name = src.getuntil(62, "group name")?;
                src.checkgroupname(name, 1)?;
                named = true;
            } else if src.take(61)? {
                let ref_name = src.getuntil(41, "group name")?;
                src.checkgroupname(ref_name, 1)?;
                let gid = st.group_of(ref_name);
                if gid < 0 {
                    return Err(src.error(f"unknown group name {repr_of(ref_name)}", ref_name.len() + 1));
                }
                if not st.checkgroup(gid) {
                    return Err(src.error("cannot refer to an open group".to_string(), ref_name.len() + 1));
                }
                st.checklookbehindgroup(gid, src)?;
                out.push(Node.GroupRef(gid));
                return Ok(true);
            } else {
                let c2 = src.get()?;
                if c2.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                return Err(src.error(f"unknown extension ?P{to_string(tok_text(c2))}", c2.n + 2));
            }
        } else if tok_is(ch, 58) {
            capture = false;
        } else if tok_is(ch, 35) {
            loop {
                if src.next.n == 0 {
                    return Err(src.error("missing ), unterminated comment".to_string(), src.tell() - start));
                }
                if tok_is(src.get()?, 41) {
                    break;
                }
            }
            return Ok(true);
        } else if tok_is(ch, 61) or tok_is(ch, 33) or tok_is(ch, 60) {
            let mut kind = ch;
            let mut dir = 1;
            let mut outer_lookbehind = 0;
            if tok_is(ch, 60) {
                kind = src.get()?;
                if kind.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                if not (tok_is(kind, 61) or tok_is(kind, 33)) {
                    return Err(src.error(f"unknown extension ?<{to_string(tok_text(kind))}", kind.n + 2));
                }
                dir = -1;
                outer_lookbehind = st.lookbehind_groups;
                if outer_lookbehind < 0 {
                    st.lookbehind_groups = st.groups();
                }
            }
            let p = parse_sub(mut src, mut st, *verbose, nested + 1)?;
            if dir < 0 and outer_lookbehind < 0 {
                st.lookbehind_groups = -1;
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            if tok_is(kind, 61) {
                out.push(Node.Assert(dir, false, p));
            } else if p.len() > 0 {
                out.push(Node.Assert(dir, true, p));
            } else {
                out.push(Node.Failure);
            }
            return Ok(true);
        } else if tok_is(ch, 40) {
            let condname = src.getuntil(41, "group name")?;
            let mut condgroup = 0;
            if not is_ascii_decimal(condname) {
                src.checkgroupname(condname, 1)?;
                condgroup = st.group_of(condname);
                if condgroup < 0 {
                    return Err(src.error(f"unknown group name {repr_of(condname)}", condname.len() + 1));
                }
            } else {
                if condname.len() > 10 {
                    return Err(src.error(f"invalid group reference {to_string(condname)}", condname.len() + 1));
                }
                condgroup = digits_value(condname, 0, 10);
                if condgroup == 0 {
                    return Err(src.error("bad group number".to_string(), condname.len() + 1));
                }
                if condgroup >= maxgroups() {
                    return Err(src.error(f"invalid group reference {condgroup}", condname.len() + 1));
                }
                let mut seen = false;
                for (g, _) in st.refpos.iter() {
                    if *g == condgroup {
                        seen = true;
                    }
                }
                if not seen {
                    st.refpos.push((condgroup, src.tell() - condname.len() - 1));
                }
            }
            st.checklookbehindgroup(condgroup, src)?;
            let yes = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
            let mut no: Vec[Node] = Vec.new();
            if src.take(124)? {
                no = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
                if tok_is(src.next, 124) {
                    return Err(src.error("conditional backref with more than two branches".to_string(), 0));
                }
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            out.push(Node.Exists(condgroup, yes, no));
            return Ok(true);
        } else if tok_is(ch, 62) {
            capture = false;
            atomic = true;
        } else if (ch.n == 1 and flag_value(ch.a) != 0) or tok_is(ch, 45) {
            match parse_flags(mut src, mut st, ch)? {
                None => {
                    if not first or out.len() > 0 {
                        return Err(src.error("global flags not at the start of the expression".to_string(), src.tell() - start));
                    }
                    *verbose = (st.flags & flag_x()) != 0;
                    return Ok(true);
                }
                Some((a, d)) => {
                    add = a;
                    del = d;
                    capture = false;
                }
            }
        } else {
            return Err(src.error(f"unknown extension ?{to_string(tok_text(ch))}", ch.n + 1));
        }
    }
    let mut group = 0;
    if capture {
        group = st.groups();
        st.closed.push(false);
        st.widths.push(Width { lo: 0, hi: 0 });
        if named {
            let was = st.group_of(name);
            if was >= 0 {
                return Err(src.error(f"redefinition of group name {repr_of(name)} as group {group}; was group {was}", name.len() + 1));
            }
            st.names.push((name.clone(), group));
        }
    }
    let sub_verbose = (*verbose or (add & flag_x()) != 0) and (del & flag_x()) == 0;
    let p = parse_sub(mut src, mut st, sub_verbose, nested + 1)?;
    if not src.take(41)? {
        return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
    }
    if group > 0 {
        let w = width_of(st.widths, p);
        st.widths[group] = w;
        st.closed[group] = true;
    }
    if atomic {
        out.push(Node.Atomic(p));
    } else {
        out.push(Node.Group(group, add, del, p));
    }
    Ok(false)
}

struct Parsed {
    nodes: Vec[Node],
    flags: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
    widths: Vec[Width],
}

fn parse(pattern: ref Vec[i64], flags: i64) -> Result[Parsed, ReErr] {
    let mut src = new_tokenizer(pattern)?;
    let mut st = ParseState {
        flags: flags,
        names: Vec.new(),
        closed: Vec.new(),
        widths: Vec.new(),
        lookbehind_groups: -1,
        refpos: Vec.new(),
    };
    // group 0 is the whole match
    st.closed.push(true);
    st.widths.push(Width { lo: 0, hi: 0 });
    let nodes = parse_sub(mut src, mut st, (flags & flag_x()) != 0, 0)?;
    if (st.flags & flag_a()) != 0 and (st.flags & flag_u()) != 0 {
        return Err(other_error("ValueError", "ASCII and UNICODE flags are incompatible".to_string()));
    }
    if src.next.n != 0 {
        return Err(src.error("unbalanced parenthesis".to_string(), 0));
    }
    for (g, pos) in st.refpos.iter() {
        if *g >= st.groups() {
            return Err(re_error(f"invalid group reference {*g}", *pos));
        }
    }
    let groups = st.groups() - 1;
    Ok(Parsed { nodes: nodes, flags: st.flags, groups: groups, names: st.names, widths: st.widths })
}

// ---------------------------------------------------------- compiler

#[derive(Clone)]
enum Op {
    // character (lowered when case-insensitive), case-insensitive, ASCII
    Lit(i64, bool, bool),
    NotLit(i64, bool, bool),
    Any,
    AnyAll,
    // set, case-insensitive, ASCII-only categories
    In(i64, bool, bool),
    // anchor kind, ASCII-only word boundary
    At(i64, bool),
    Mark(i64),
    Split(i64, i64),
    Jmp(i64),
    // repeat register, the Until it starts at
    RepInit(i64, i64),
    // register, min, max, greedy, body, exit
    Until(i64, i64, i64, bool, i64, i64),
    Ref(i64, bool, bool),
    // lookbehind width (-1 for lookahead), negative, sub-program, next
    Look(i64, bool, i64, i64),
    Atomic(i64, i64),
    Exists(i64, i64),
    Fail,
    Succeed,
    Match,
}

#[derive(Clone)]
struct Program {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
}

#[derive(Clone)]
struct CharSet {
    items: Vec[Item],
    negate: bool,
}

fn combine(flags: i64, add: i64, del: i64) -> i64 {
    let mut f = flags;
    if (add & type_flags()) != 0 {
        f = f & (0x7FFFFFFF ^ type_flags());
    }
    (f | add) & (0x7FFFFFFF ^ del)
}

struct Compiler {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
}

impl Compiler {
    fn emit(mut ref self, op: own Op) -> i64 {
        self.ops.push(op);
        self.ops.len() - 1
    }

    fn here(ref self) -> i64 {
        self.ops.len()
    }

    fn compile(mut ref self, p: ref Parsed, nodes: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let icase = (flags & flag_i()) != 0;
        let ascii = (flags & flag_a()) != 0;
        for n in nodes.iter() {
            match n {
                Node.Lit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.Lit(v, icase, ascii));
                }
                Node.NotLit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.NotLit(v, icase, ascii));
                }
                Node.Any => {
                    if (flags & flag_s()) != 0 {
                        self.emit(Op.AnyAll);
                    } else {
                        self.emit(Op.Any);
                    }
                }
                Node.In(items, negate) => {
                    self.sets.push(CharSet { items: items.clone(), negate: *negate });
                    let idx = self.sets.len() - 1;
                    self.emit(Op.In(idx, icase, ascii));
                }
                Node.At(kind) => {
                    let mut k = *kind;
                    if (flags & flag_m()) != 0 {
                        if k == at_beginning() {
                            k = at_beginning_line();
                        } else if k == at_end() {
                            k = at_end_line();
                        }
                    }
                    self.emit(Op.At(k, ascii));
                }
                Node.Branch(items) => {
                    let mut ends: Vec[i64] = Vec.new();
                    let mut i = 0;
                    while i < items.len() {
                        if i + 1 < items.len() {
                            let split = self.emit(Op.Fail);
                            self.compile(p, items[i], flags)?;
                            ends.push(self.emit(Op.Fail));
                            let next = self.here();
                            self.ops[split] = Op.Split(split + 1, next);
                        } else {
                            self.compile(p, items[i], flags)?;
                        }
                        i += 1;
                    }
                    let end = self.here();
                    for at in ends {
                        self.ops[at] = Op.Jmp(end);
                    }
                }
                Node.Group(g, add, off, body) => {
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g));
                    }
                    self.compile(p, body, combine(flags, *add, *off))?;
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g + 1));
                    }
                }
                Node.Repeat(kind, min, max, body) => {
                    if *kind == 2 {
                        let at = self.emit(Op.Fail);
                        self.compile_repeat(p, *min, *max, true, body, flags)?;
                        self.emit(Op.Succeed);
                        let next = self.here();
                        self.ops[at] = Op.Atomic(at + 1, next);
                    } else {
                        self.compile_repeat(p, *min, *max, *kind == 0, body, flags)?;
                    }
                }
                Node.Atomic(body) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Atomic(at + 1, next);
                }
                Node.Assert(dir, negative, body) => {
                    let mut width = -1;
                    if *dir < 0 {
                        let w = width_of(p.widths, body);
                        if w.lo != w.hi {
                            return Err(other_error("error", "look-behind requires fixed-width pattern".to_string()));
                        }
                        width = w.lo;
                    }
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Look(width, *negative, at + 1, next);
                }
                Node.GroupRef(g) => {
                    self.emit(Op.Ref(*g, icase, ascii));
                }
                Node.Exists(g, yes, no) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, yes, flags)?;
                    if no.len() > 0 {
                        let jump = self.emit(Op.Fail);
                        let no_pc = self.here();
                        self.compile(p, no, flags)?;
                        let end = self.here();
                        self.ops[jump] = Op.Jmp(end);
                        self.ops[at] = Op.Exists(*g, no_pc);
                    } else {
                        let end = self.here();
                        self.ops[at] = Op.Exists(*g, end);
                    }
                }
                Node.Failure => {
                    self.emit(Op.Fail);
                }
            }
        }
        Ok(())
    }

    fn compile_repeat(mut ref self, p: ref Parsed, min: i64, max: i64, greedy: bool, body: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let r = self.repeats;
        self.repeats += 1;
        let init = self.emit(Op.Fail);
        self.compile(p, body, flags)?;
        let until = self.emit(Op.Fail);
        self.ops[init] = Op.RepInit(r, until);
        self.ops[until] = Op.Until(r, min, max, greedy, init + 1, until + 1);
        Ok(())
    }
}

fn compile(pattern: ref Vec[i64], flags: i64) -> Result[Program, ReErr] {
    let p = parse(pattern, flags)?;
    let mut c = Compiler { ops: Vec.new(), sets: Vec.new(), repeats: 0 };
    c.compile(p, p.nodes, p.flags)?;
    c.emit(Op.Match);
    Ok(Program { ops: c.ops, sets: c.sets, repeats: c.repeats, groups: p.groups, names: p.names })
}

// ----------------------------------------------------------- matcher

struct Undo {
    kind: i64,
    idx: i64,
    old: i64,
}

struct Choice {
    pc: i64,
    pos: i64,
    trail: i64,
    // 0: resume at pc; 1: a lazy repeat's Until, after its tail failed
    mode: i64,
}

struct Matcher {
    s: Vec[i64],
    marks: Vec[i64],
    counts: Vec[i64],
    lasts: Vec[i64],
    lastindex: i64,
    trail: Vec[Undo],
    start: i64,
    must_advance: bool,
    match_all: bool,
}

impl Matcher {
    fn set_mark(mut ref self, slot: i64, v: i64) {
        self.trail.push(Undo { kind: 0, idx: slot, old: self.marks[slot] });
        self.marks[slot] = v;
    }

    fn set_count(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 1, idx: r, old: self.counts[r] });
        self.counts[r] = v;
    }

    fn set_last(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 2, idx: r, old: self.lasts[r] });
        self.lasts[r] = v;
    }

    fn set_lastindex(mut ref self, v: i64) {
        self.trail.push(Undo { kind: 3, idx: 0, old: self.lastindex });
        self.lastindex = v;
    }

    fn undo_to(mut ref self, len: i64) {
        while self.trail.len() > len {
            let u = self.trail.pop().unwrap();
            if u.kind == 0 {
                self.marks[u.idx] = u.old;
            } else if u.kind == 1 {
                self.counts[u.idx] = u.old;
            } else if u.kind == 2 {
                self.lasts[u.idx] = u.old;
            } else {
                self.lastindex = u.old;
            }
        }
    }

    // A group that has both marks, the end not before the start.
    fn group_span(ref self, g: i64) -> (i64, i64) {
        let a = self.marks[2 * g];
        let b = self.marks[2 * g + 1];
        if a < 0 or b < 0 or b < a {
            return (-1, -1);
        }
        (a, b)
    }

    fn at(ref self, kind: i64, ascii: bool, pos: i64) -> bool {
        let n = self.s.len();
        if kind == 0 or kind == 2 {
            return pos == 0;
        }
        if kind == 1 {
            return pos == 0 or self.s[pos - 1] == 10;
        }
        if kind == 3 {
            return pos == n or (pos == n - 1 and self.s[pos] == 10);
        }
        if kind == 4 {
            return pos == n or self.s[pos] == 10;
        }
        if kind == 5 {
            return pos == n;
        }
        if n == 0 {
            return false;
        }
        let before = pos > 0 and is_word(self.s[pos - 1], ascii);
        let after = pos < n and is_word(self.s[pos], ascii);
        if kind == 6 { before != after } else { before == after }
    }

    // Runs the program from pc at pos, backtracking through its own
    // choices only. Returns where it succeeded, or -1.
    fn run(mut ref self, prog: ref Program, pc0: i64, pos0: i64, top: bool) -> i64 {
        let base = self.trail.len();
        let mut choices: Vec[Choice] = Vec.new();
        let mut pc = pc0;
        let mut pos = pos0;
        let mut mode = 0;
        loop {
            let mut ok = true;
            let op = ref prog.ops[pc];
            if mode == 1 {
                // a lazy repeat whose tail failed: try one more item
                mode = 0;
                ok = false;
                if let Op.Until(r, _, max, _, body, _) = op {
                    let count = self.counts[*r] + 1;
                    if not ((count >= *max and *max != maxrepeat()) or pos == self.lasts[*r]) {
                        self.set_count(*r, count);
                        self.set_last(*r, pos);
                        pc = *body;
                        ok = true;
                    }
                }
                if ok {
                    continue;
                }
            } else {
                match op {
                    Op.Lit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) == *c } else { self.s[pos] == *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.NotLit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) != *c } else { self.s[pos] != *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Any => {
                        if pos < self.s.len() and self.s[pos] != 10 {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.AnyAll => {
                        if pos < self.s.len() {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.In(set, icase, ascii) => {
                        if pos < self.s.len() and in_set(prog.sets[*set], self.s[pos], *icase, *ascii) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.At(kind, ascii) => {
                        if self.at(*kind, *ascii, pos) {
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Mark(slot) => {
                        self.set_mark(*slot, pos);
                        if (*slot & 1) == 1 {
                            self.set_lastindex(*slot / 2);
                        }
                        pc += 1;
                    }
                    Op.Split(a, b) => {
                        choices.push(Choice { pc: *b, pos: pos, trail: self.trail.len(), mode: 0 });
                        pc = *a;
                    }
                    Op.Jmp(a) => pc = *a,
                    Op.RepInit(r, until) => {
                        self.set_count(*r, -1);
                        self.set_last(*r, -1);
                        pc = *until;
                    }
                    Op.Until(r, min, max, greedy, body, exit) => {
                        let count = self.counts[*r] + 1;
                        if count < *min {
                            self.set_count(*r, count);
                            pc = *body;
                        } else if *greedy {
                            if (count < *max or *max == maxrepeat()) and pos != self.lasts[*r] {
                                choices.push(Choice { pc: *exit, pos: pos, trail: self.trail.len(), mode: 0 });
                                self.set_count(*r, count);
                                self.set_last(*r, pos);
                                pc = *body;
                            } else {
                                pc = *exit;
                            }
                        } else {
                            choices.push(Choice { pc: pc, pos: pos, trail: self.trail.len(), mode: 1 });
                            pc = *exit;
                        }
                    }
                    Op.Ref(g, icase, ascii) => {
                        let (a, b) = self.group_span(*g);
                        if a < 0 {
                            ok = false;
                        } else {
                            let len = b - a;
                            if pos + len > self.s.len() {
                                ok = false;
                            } else {
                                let mut k = 0;
                                while k < len {
                                    let x = self.s[a + k];
                                    let y = self.s[pos + k];
                                    let eq = if *icase { lower(x, *ascii) == lower(y, *ascii) } else { x == y };
                                    if not eq {
                                        ok = false;
                                        break;
                                    }
                                    k += 1;
                                }
                                if ok {
                                    pos += len;
                                    pc += 1;
                                }
                            }
                        }
                    }
                    Op.Look(width, negative, sub, next) => {
                        let mark = self.trail.len();
                        let from = if *width < 0 { pos } else { pos - *width };
                        let found = from >= 0 and self.run(prog, *sub, from, false) >= 0;
                        if *negative {
                            self.undo_to(mark);
                            if found {
                                ok = false;
                            } else {
                                pc = *next;
                            }
                        } else if found {
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Atomic(sub, next) => {
                        let end = self.run(prog, *sub, pos, false);
                        if end >= 0 {
                            pos = end;
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Exists(g, no) => {
                        let (a, _) = self.group_span(*g);
                        if a >= 0 {
                            pc += 1;
                        } else {
                            pc = *no;
                        }
                    }
                    Op.Fail => ok = false,
                    Op.Succeed => return pos,
                    Op.Match => {
                        if top and ((self.match_all and pos != self.s.len()) or (self.must_advance and pos == self.start)) {
                            ok = false;
                        } else {
                            return pos;
                        }
                    }
                }
            }
            if not ok {
                match choices.pop() {
                    Some(ch) => {
                        self.undo_to(ch.trail);
                        pc = ch.pc;
                        pos = ch.pos;
                        mode = ch.mode;
                    }
                    None => {
                        self.undo_to(base);
                        return -1;
                    }
                }
            }
        }
    }
}

fn in_items(set: ref CharSet, c: i64, ascii: bool) -> bool {
    for item in set.items.iter() {
        let hit = match item {
            Item.Lit(l) => c == *l,
            Item.Range(lo, hi) => c >= *lo and c <= *hi,
            Item.Cat(k) => {
                let kind = *k;
                if kind == 0 {
                    if ascii { c >= 48 and c <= 57 } else { is_decimal(c) }
                } else if kind == 1 {
                    if ascii { not (c >= 48 and c <= 57) } else { not is_decimal(c) }
                } else if kind == 2 {
                    is_space(c, ascii)
                } else if kind == 3 {
                    not is_space(c, ascii)
                } else if kind == 4 {
                    is_word(c, ascii)
                } else {
                    not is_word(c, ascii)
                }
            }
        };
        if hit {
            return true;
        }
    }
    false
}

// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = lower(c, ascii);
        if lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program, s: ref Vec[i64]) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        s: s.clone(),
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn find(m: mut ref Matcher, prog: ref Program, from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= m.s.len() {
        let mut k = 0;
        while k < m.marks.len() {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}

// All the matches finditer gives: each search starts where the last
// match ended, and must move on past an empty one.
fn all_matches(prog: ref Program, s: ref Vec[i64], limit: i64) -> Vec[Found] {
    let mut m = new_matcher(prog, s);
    let mut out: Vec[Found] = Vec.new();
    let mut pos = 0;
    let mut must_advance = false;
    while pos <= s.len() and (limit == 0 or out.len() < limit) {
        match find(mut m, prog, pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    out
}

fn group_text(s: ref Vec[i64], span: (i64, i64), out: mut ref Vec[i64]) {
    let (a, b) = span;
    if a < 0 {
        push_ascii(mut out, "None");
    } else {
        str_repr(slice(s, a, b), mut out);
    }
}

fn span_text(span: (i64, i64)) -> String {
    let (a, b) = span;
    f"({a}, {b})"
}

fn show_match(prog: ref Program, s: ref Vec[i64], found: ref Option[Found], out: mut ref Vec[i64]) {
    let m = match found {
        Some(m) => m,
        None => {
            push_ascii(mut out, "  None\n");
            return;
        }
    };
    push_ascii(mut out, f"  span={span_text((m.start, m.end))} match=");
    str_repr(slice(s, m.start, m.end), mut out);
    out.push(10);
    if prog.groups > 0 {
        push_ascii(mut out, "  groups=(");
        let mut g = 0;
        while g < m.spans.len() {
            if g > 0 {
                push_ascii(mut out, ", ");
            }
            group_text(s, m.spans[g], mut out);
            g += 1;
        }
        if m.spans.len() == 1 {
            push_ascii(mut out, ",");
        }
        push_ascii(mut out, ")\n  spans=[");
        g = 0;
        while g < m.spans.len() {
            if g > 0 {
                push_ascii(mut out, ", ");
            }
            push_ascii(mut out, span_text(m.spans[g]));
            g += 1;
        }
        push_ascii(mut out, "]\n");
    }
    if prog.names.len() > 0 {
        push_ascii(mut out, "  named=");
        group_dict(prog, s, m, mut out);
        out.push(10);
    }
}

fn group_dict(prog: ref Program, s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    out.push(123);
    let mut k = 0;
    while k < prog.names.len() {
        if k > 0 {
            push_ascii(mut out, ", ");
        }
        let (name, g) = ref prog.names[k];
        str_repr(name, mut out);
        push_ascii(mut out, ": ");
        group_text(s, m.spans[g - 1], mut out);
        k += 1;
    }
    out.push(125);
}

// findall's item: the match, the one group, or a tuple of the groups,
// with '' for a group that did not take part.
fn findall_item(prog: ref Program, s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    if prog.groups == 0 {
        str_repr(slice(s, m.start, m.end), mut out);
        return;
    }
    if prog.groups > 1 {
        out.push(40);
    }
    let mut g = 0;
    while g < m.spans.len() {
        if g > 0 {
            push_ascii(mut out, ", ");
        }
        let (a, b) = m.spans[g];
        if a < 0 {
            push_ascii(mut out, "''");
        } else {
            str_repr(slice(s, a, b), mut out);
        }
        g += 1;
    }
    if prog.groups > 1 {
        out.push(41);
    }
}

// A replacement template: literal text and group numbers.
enum Piece {
    Text(Vec[i64]),
    Group(i64),
}

// _parser.parse_template.
fn parse_template(repl: ref Vec[i64], prog: ref Program) -> Result[Vec[Piece], ReErr] {
    let mut s = new_tokenizer(repl)?;
    let mut pieces: Vec[Piece] = Vec.new();
    let mut literal: Vec[i64] = Vec.new();
    loop {
        let this = s.get()?;
        if this.n == 0 {
            break;
        }
        if this.n == 1 {
            literal.push(this.a);
            continue;
        }
        let c = this.b;
        let mut index = -1;
        let mut offset = 0;
        if c == 103 {
            if not s.take(60)? {
                return Err(s.error("missing <".to_string(), 0));
            }
            let name = s.getuntil(62, "group name")?;
            if not is_ascii_decimal(name) {
                s.checkgroupname(name, 1)?;
                let mut found = -1;
                for (n, g) in prog.names.iter() {
                    if same(n, name) {
                        found = *g;
                    }
                }
                if found < 0 {
                    return Err(other_error("IndexError", f"unknown group name {repr_of(name)}"));
                }
                index = found;
            } else {
                if name.len() > 10 or digits_value(name, 0, 10) >= maxgroups() {
                    return Err(s.error(f"invalid group reference {to_string(name)}", name.len() + 1));
                }
                index = digits_value(name, 0, 10);
            }
            offset = name.len() + 1;
        } else if c == 48 {
            let mut text = tok_text(this);
            if s.next.n == 1 and is_oct(s.next.a) {
                text.push(s.get()?.a);
                if s.next.n == 1 and is_oct(s.next.a) {
                    text.push(s.get()?.a);
                }
            }
            literal.push(digits_value(text, 1, 8) & 0xFF);
            continue;
        } else if is_dec(c) {
            let mut text = tok_text(this);
            if s.next.n == 1 and is_dec(s.next.a) {
                text.push(s.get()?.a);
                if is_oct(c) and is_oct(text[2]) and s.next.n == 1 and is_oct(s.next.a) {
                    text.push(s.get()?.a);
                    let v = digits_value(text, 1, 8);
                    if v > 0o377 {
                        return Err(s.error(f"octal escape value {to_string(text)} outside of range 0-0o377", text.len()));
                    }
                    literal.push(v);
                    continue;
                }
            }
            index = digits_value(text, 1, 10);
            offset = text.len() - 1;
        } else {
            let e = escape_value(this);
            if e >= 0 {
                literal.push(e);
            } else if is_ascii_letter(c) {
                return Err(s.error(f"bad escape {to_string(tok_text(this))}", 2));
            } else {
                literal.push(92);
                literal.push(c);
            }
            continue;
        }
        if index > prog.groups {
            return Err(s.error(f"invalid group reference {index}", offset));
        }
        pieces.push(Piece.Text(literal));
        literal = Vec.new();
        pieces.push(Piece.Group(index));
    }
    pieces.push(Piece.Text(literal));
    Ok(pieces)
}

fn expand(pieces: ref Vec[Piece], s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    for piece in pieces.iter() {
        match piece {
            Piece.Text(t) => push_all(mut out, t),
            Piece.Group(g) => {
                let (a, b) = if *g == 0 { (m.start, m.end) } else { m.spans[*g - 1] };
                if a >= 0 {
                    push_all(mut out, slice(s, a, b));
                }
            }
        }
    }
}


// --------------------------------------------------- Unicode strings
fn cp(s: Str) -> Vec[i64] {
    codepoints(s.bytes())
}


// ---------------------------------------------------------------- errors

// A Python exception: its type name and str().
#[derive(Clone)]
struct PyErr {
    kind: String,
    msg: String,
}

fn py_err(kind: Str, msg: own String) -> PyErr {
    PyErr { kind: kind.to_string(), msg: msg }
}

fn value_error(msg: Str) -> PyErr {
    py_err("ValueError", msg.to_string())
}

// ---------------------------------------------------------------- str helpers
// Positions are byte offsets into a String unless a name says otherwise.

fn find_at(s: ref String, pat: Str, from: i64) -> i64 {
    if from > s.len() {
        return -1;
    }
    match s[from..s.len()].find(pat) {
        Some(i) => i + from,
        None => -1,
    }
}

fn rfind_in(s: ref String, pat: Str, lo: i64, hi: i64) -> i64 {
    match s[lo..hi].rfind(pat) {
        Some(i) => i + lo,
        None => -1,
    }
}

fn sub(s: ref String, a: i64, b: i64) -> String {
    s[a..b].to_string()
}

fn tail(s: ref String, a: i64) -> String {
    s[a..s.len()].to_string()
}

// str.partition(sep).
fn partition(s: ref String, sep: Str) -> (String, bool, String) {
    let i = find_at(s, sep, 0);
    if i < 0 {
        return (s.clone(), false, String.new());
    }
    (sub(s, 0, i), true, tail(s, i + sep.len()))
}

// str.rpartition(sep).
fn rpartition(s: ref String, sep: Str) -> (String, bool, String) {
    match s.rfind(sep) {
        Some(i) => (sub(s, 0, i), true, tail(s, i + sep.len())),
        None => (String.new(), false, s.clone()),
    }
}

fn is_ascii_str(s: ref String) -> bool {
    for b in s.bytes() {
        if *b >= 128 {
            return false;
        }
    }
    true
}

fn ascii_lower_str(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c >= 'A' and c <= 'Z' {
            out.push(char.try_from((c as u32) + 32).unwrap_or(c));
        } else {
            out.push(c);
        }
    }
    out
}

// str.split(sep) for a non-empty separator.
fn split_str(s: ref String, sep: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut start = 0;
    loop {
        let i = find_at(s, sep, start);
        if i < 0 {
            out.push(tail(s, start));
            return out;
        }
        out.push(sub(s, start, i));
        start = i + sep.len();
    }
}

fn join_strs(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    let mut first = true;
    for p in parts.iter() {
        if not first {
            out.push_str(sep);
        }
        first = false;
        out.push_str(p);
    }
    out
}

fn hex2(n: i64) -> String {
    let d: Vec[char] = "0123456789ABCDEF".chars().collect();
    let mut s = String.new();
    s.push(d[(n / 16) % 16]);
    s.push(d[n % 16]);
    s
}

fn hex_lower2(n: i64, width: i64) -> String {
    let d: Vec[char] = "0123456789abcdef".chars().collect();
    let mut out: Vec[char] = Vec.new();
    let mut v = n;
    while v > 0 or out.len() < width {
        out.push(d[v % 16]);
        v = v / 16;
    }
    out.reverse();
    from_chars(out, 0, out.len())
}

fn hex_value(s: Str) -> i64 {
    let mut n: i64 = 0;
    for c in s.chars() {
        let d = if c >= '0' and c <= '9' {
            c as i64 - 48
        } else if c >= 'a' and c <= 'f' {
            c as i64 - 87
        } else if c >= 'A' and c <= 'F' {
            c as i64 - 55
        } else {
            0
        };
        n = n * 16 + d;
    }
    n
}

fn char_of(cp: i64) -> char {
    char.try_from(cp as u32).unwrap_or('\u{fffd}')
}

fn str_of_cps(cs: ref Vec[i64]) -> String {
    let mut out = String.new();
    for c in cs.iter() {
        out.push(char_of(*c));
    }
    out
}

// Code point index of byte offset `b` in s.
fn cp_index(s: ref String, b: i64) -> i64 {
    s[0..b].chars().count()
}

// ---------------------------------------------------------------- bytes helpers

fn bytes_of(s: ref String) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for b in s.bytes() {
        v.push(*b);
    }
    v
}

fn bytes_lit(s: Str) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for b in s.bytes() {
        v.push(*b);
    }
    v
}

fn bslice(b: ref Vec[u8], lo: i64, hi: i64) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    let mut i = lo;
    while i < hi {
        v.push(b[i]);
        i += 1;
    }
    v
}

fn bfind(b: ref Vec[u8], pat: ref Vec[u8], from: i64) -> i64 {
    let mut i = from;
    while i + pat.len() <= b.len() {
        let mut k = 0;
        while k < pat.len() and b[i + k] == pat[k] {
            k += 1;
        }
        if k == pat.len() {
            return i;
        }
        i += 1;
    }
    -1
}

fn bfind_byte(b: ref Vec[u8], c: u8, from: i64) -> i64 {
    let mut i = from;
    while i < b.len() {
        if b[i] == c {
            return i;
        }
        i += 1;
    }
    -1
}

fn bstarts(b: ref Vec[u8], p: ref Vec[u8]) -> bool {
    if p.len() > b.len() {
        return false;
    }
    let mut i = 0;
    while i < p.len() {
        if b[i] != p[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn beq(a: ref Vec[u8], b: ref Vec[u8]) -> bool {
    a.len() == b.len() and bstarts(a, b)
}

fn bpush(out: mut ref Vec[u8], b: ref Vec[u8]) {
    for x in b.iter() {
        out.push(*x);
    }
}

fn bpush_str(out: mut ref Vec[u8], s: Str) {
    for x in s.bytes() {
        out.push(*x);
    }
}

fn blower(b: ref Vec[u8]) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for x in b.iter() {
        if *x >= 65 and *x <= 90 {
            v.push(*x + 32);
        } else {
            v.push(*x);
        }
    }
    v
}

fn is_bws(c: u8) -> bool {
    c == 32 or (c >= 9 and c <= 13)
}

// bytes.strip() with no argument.
fn bstrip(b: ref Vec[u8]) -> Vec[u8] {
    let mut lo = 0;
    let mut hi = b.len();
    while lo < hi and is_bws(b[lo]) {
        lo += 1;
    }
    while hi > lo and is_bws(b[hi - 1]) {
        hi -= 1;
    }
    bslice(b, lo, hi)
}

// Bytes as code points 0-255, for the regex engine.
fn byte_cps(b: ref Vec[u8]) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for x in b.iter() {
        v.push(*x as i64);
    }
    v
}

fn cps_bytes(c: ref Vec[i64]) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for x in c.iter() {
        v.push(*x as u8);
    }
    v
}

fn utf8_cp(out: mut ref Vec[u8], cp: i64) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push((0xC0 | (cp >> 6)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else if cp < 0x10000 {
        out.push((0xE0 | (cp >> 12)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else {
        out.push((0xF0 | (cp >> 18)) as u8);
        out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    }
}

// Valid UTF-8 bytes back to a String.
fn utf8_str(b: ref Vec[u8]) -> String {
    match String.from_utf8(b) {
        Ok(s) => s,
        Err(_) => String.new(),
    }
}

// ---------------------------------------------------------------- unicode data

struct UInfo {
    ccc: i64,
    decomp: Vec[i64],
    compat: bool,
    ccc32: i64,
    decomp32: Vec[i64],
    compat32: bool,
    printable: bool,
    b1: bool,
    prohibited: bool,
    randal: bool,
    lcat: bool,
    b2: Vec[i64],
}

struct Uni {
    index: Map[i64, i64],
    infos: Vec[UInfo],
    // Primary composites by (first << 21) | second, for Unicode 15.1 and 3.2.
    comp: Map[i64, i64],
    comp32: Map[i64, i64],
}

fn hex_list(s: Str) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for p in s.split(" ") {
        if p.len() > 0 {
            v.push(hex_value(p));
        }
    }
    v
}

fn load_uni(text: ref String) -> Uni {
    let mut u = Uni { index: Map.new(), infos: Vec.new(), comp: Map.new(), comp32: Map.new() };
    for line in text.lines() {
        if line.len() == 0 {
            continue;
        }
        let f: Vec[Str] = line.split(";").collect();
        if f[0] == "c" or f[0] == "d" {
            let key = (hex_value(f[1]) << 21) | hex_value(f[2]);
            if f[0] == "c" {
                u.comp.insert(key, hex_value(f[3]));
            } else {
                u.comp32.insert(key, hex_value(f[3]));
            }
            continue;
        }
        let compat = f[2].starts_with("k");
        let compat32 = f[4].starts_with("k");
        let d1 = if compat { hex_list(f[2][1..f[2].len()]) } else { hex_list(f[2]) };
        let d2 = if compat32 { hex_list(f[4][1..f[4].len()]) } else { hex_list(f[4]) };
        let flags = f[5];
        u.index.insert(hex_value(f[0]), u.infos.len());
        u.infos.push(UInfo {
            ccc: digits_int(f[1].to_string()),
            decomp: d1,
            compat: compat,
            ccc32: digits_int(f[3].to_string()),
            decomp32: d2,
            compat32: compat32,
            printable: flags.contains("p"),
            b1: flags.contains("b"),
            prohibited: flags.contains("x"),
            randal: flags.contains("r"),
            lcat: flags.contains("l"),
            b2: hex_list(f[6]),
        });
    }
    u
}

impl Uni {
    fn at(ref self, cp: i64) -> i64 {
        match self.index.get(cp) {
            Some(i) => *i,
            None => -1,
        }
    }

    fn printable(ref self, cp: i64) -> bool {
        let i = self.at(cp);
        if i < 0 { is_printable(cp) } else { self.infos[i].printable }
    }

    fn ccc(ref self, cp: i64, v32: bool) -> i64 {
        let i = self.at(cp);
        if i < 0 {
            0
        } else if v32 {
            self.infos[i].ccc32
        } else {
            self.infos[i].ccc
        }
    }

    fn decompose_into(ref self, cp: i64, v32: bool, out: mut ref Vec[i64]) {
        if cp >= 0xAC00 and cp < 0xAC00 + 11172 {
            let s = cp - 0xAC00;
            out.push(0x1100 + s / 588);
            out.push(0x1161 + (s % 588) / 28);
            if s % 28 != 0 {
                out.push(0x11A7 + s % 28);
            }
            return;
        }
        let i = self.at(cp);
        if i < 0 {
            out.push(cp);
            return;
        }
        let d = if v32 { self.infos[i].decomp32.clone() } else { self.infos[i].decomp.clone() };
        if d.len() == 0 {
            out.push(cp);
            return;
        }
        for x in d.iter() {
            self.decompose_into(*x, v32, mut out);
        }
    }

    fn composite(ref self, a: i64, b: i64, v32: bool) -> i64 {
        if a >= 0x1100 and a < 0x1113 and b >= 0x1161 and b < 0x1176 {
            return 0xAC00 + ((a - 0x1100) * 21 + (b - 0x1161)) * 28;
        }
        if a >= 0xAC00 and a < 0xAC00 + 11172 and (a - 0xAC00) % 28 == 0 and b > 0x11A7 and b < 0x11C3 {
            return a + (b - 0x11A7);
        }
        let key = (a << 21) | b;
        let found = if v32 { self.comp32.get(key) } else { self.comp.get(key) };
        match found {
            Some(c) => *c,
            None => -1,
        }
    }

    // unicodedata.normalize("NFKC"), with ucd_3_2_0's data when v32.
    fn nfkc(ref self, cs: ref Vec[i64], v32: bool) -> Vec[i64] {
        let mut d: Vec[i64] = Vec.new();
        for c in cs.iter() {
            self.decompose_into(*c, v32, mut d);
        }
        let mut i = 1;
        while i < d.len() {
            let mut j = i;
            while j > 0 and self.ccc(d[j], v32) != 0 and self.ccc(d[j - 1], v32) > self.ccc(d[j], v32) {
                let t = d[j];
                d[j] = d[j - 1];
                d[j - 1] = t;
                j -= 1;
            }
            i += 1;
        }
        let mut out: Vec[i64] = Vec.new();
        let mut starter: i64 = -1;
        let mut last: i64 = -1;
        for c in d.iter() {
            let cc = self.ccc(*c, v32);
            if starter >= 0 {
                let blocked = last != -1 and (last == 0 or last >= cc);
                if not blocked {
                    let comp = self.composite(out[starter], *c, v32);
                    if comp >= 0 {
                        out[starter] = comp;
                        continue;
                    }
                }
            }
            if cc == 0 {
                starter = out.len();
                last = -1;
            } else {
                last = cc;
            }
            out.push(*c);
        }
        out
    }

    fn nfkc_str(ref self, s: ref String) -> String {
        str_of_cps(self.nfkc(cps(s), false))
    }

    // repr() of a str.
    fn repr(ref self, s: ref String) -> String {
        let has_single = s.contains("'");
        let has_double = s.contains("\"");
        let q = if has_single and not has_double { '"' } else { '\'' };
        let mut out = String.new();
        out.push(q);
        for c in s.chars() {
            let x = c as i64;
            if c == q or c == '\\' {
                out.push('\\');
                out.push(c);
            } else if x == 9 {
                out.push_str("\\t");
            } else if x == 10 {
                out.push_str("\\n");
            } else if x == 13 {
                out.push_str("\\r");
            } else if x < 32 or x == 127 {
                out.push_str(f"\\x{hex_lower2(x, 2)}");
            } else if x < 128 or self.printable(x) {
                out.push(c);
            } else if x < 256 {
                out.push_str(f"\\x{hex_lower2(x, 2)}");
            } else if x < 65536 {
                out.push_str(f"\\u{hex_lower2(x, 4)}");
            } else {
                out.push_str(f"\\U{hex_lower2(x, 8)}");
            }
        }
        out.push(q);
        out
    }
}

// repr() of bytes.
fn bytes_repr(b: ref Vec[u8]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for x in b.iter() {
        if *x == 39 {
            has_single = true;
        }
        if *x == 34 {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { 34 } else { 39 };
    let mut out = String.new();
    out.push('b');
    out.push(q as char);
    for x in b.iter() {
        let c = *x;
        if c == q or c == 92 {
            out.push('\\');
            out.push(c as char);
        } else if c == 9 {
            out.push_str("\\t");
        } else if c == 10 {
            out.push_str("\\n");
        } else if c == 13 {
            out.push_str("\\r");
        } else if c < 32 or c >= 127 {
            out.push_str(f"\\x{hex_lower2(c as i64, 2)}");
        } else {
            out.push(c as char);
        }
    }
    out.push(q as char);
    out
}

fn py_bool(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}


fn decode_error(codec: Str, data: ref Vec[u8], start: i64, end: i64, why: Str) -> PyErr {
    if end - start == 1 {
        return py_err("UnicodeDecodeError", f"'{codec}' codec can't decode byte 0x{hex_lower2(data[start] as i64, 2)} in position {start}: {why}");
    }
    py_err("UnicodeDecodeError", f"'{codec}' codec can't decode bytes in position {start}-{end - 1}: {why}")
}

// What an error handler puts in place of data[start..end].
fn push_bad(out: mut ref String, data: ref Vec[u8], start: i64, end: i64, errors: Str) {
    if errors == "percentencode" {
        let mut i = start;
        while i < end {
            out.push('%');
            out.push_str(hex2(data[i] as i64));
            i += 1;
        }
    } else {
        out.push('\u{fffd}');
    }
}

fn is_cont(b: u8) -> bool {
    b >= 0x80 and b < 0xC0
}

// CPython's UTF-8 decoder: each maximal invalid subpart is one error.
fn utf8_decode(data: ref Vec[u8], errors: Str) -> Result[String, PyErr] {
    let mut out = String.new();
    let mut i = 0;
    let n = data.len();
    while i < n {
        let b = data[i];
        if b < 0x80 {
            out.push(b as char);
            i += 1;
            continue;
        }
        let mut need = 0;
        let mut lo: u8 = 0x80;
        let mut hi: u8 = 0xBF;
        if b >= 0xC2 and b <= 0xDF {
            need = 1;
        } else if b >= 0xE0 and b <= 0xEF {
            need = 2;
            if b == 0xE0 {
                lo = 0xA0;
            }
            if b == 0xED {
                hi = 0x9F;
            }
        } else if b >= 0xF0 and b <= 0xF4 {
            need = 3;
            if b == 0xF0 {
                lo = 0x90;
            }
            if b == 0xF4 {
                hi = 0x8F;
            }
        }
        if need == 0 {
            if errors == "strict" {
                return Err(decode_error("utf-8", data, i, i + 1, "invalid start byte"));
            }
            push_bad(mut out, data, i, i + 1, errors);
            i += 1;
            continue;
        }
        let mut k = 1;
        let mut bad = false;
        while k <= need {
            if i + k >= n {
                if errors == "strict" {
                    return Err(decode_error("utf-8", data, i, n, "unexpected end of data"));
                }
                push_bad(mut out, data, i, n, errors);
                return Ok(out);
            }
            let c = data[i + k];
            let ok = if k == 1 { c >= lo and c <= hi } else { is_cont(c) };
            if not ok {
                bad = true;
                break;
            }
            k += 1;
        }
        if bad {
            if errors == "strict" {
                return Err(decode_error("utf-8", data, i, i + k, "invalid continuation byte"));
            }
            push_bad(mut out, data, i, i + k, errors);
            i += k;
            continue;
        }
        let mut cp: i64 = if need == 1 { (b & 0x1F) as i64 } else if need == 2 { (b & 0x0F) as i64 } else { (b & 0x07) as i64 };
        k = 1;
        while k <= need {
            cp = (cp << 6) | ((data[i + k] & 0x3F) as i64);
            k += 1;
        }
        out.push(char_of(cp));
        i += need + 1;
    }
    Ok(out)
}

// The UTF-16 and UTF-32 decoders, with the BOM rules of the plain
// "utf-16"/"utf-32" codecs (a BOM picks the order and is dropped, little
// endian otherwise).


// Plain JSON, as read from a job line.
#[derive(Clone)]
enum J {
    Null,
    Bool(bool),
    Num(i64),
    Text(String),
    Arr(Vec[J]),
    Obj(Vec[(String, J)]),
}

struct JsonIn {
    cs: Vec[char],
    pos: i64,
}

impl JsonIn {
    fn ws(mut ref self) {
        while self.pos < self.cs.len() and (self.cs[self.pos] == ' ' or self.cs[self.pos] == '\n' or self.cs[self.pos] == '\t' or self.cs[self.pos] == '\r') {
            self.pos += 1;
        }
    }

    fn hex4(mut ref self) -> i64 {
        let mut v: i64 = 0;
        let mut k = 0;
        while k < 4 {
            let c = self.cs[self.pos];
            self.pos += 1;
            let d = if c >= '0' and c <= '9' { c as i64 - 48 } else if c >= 'a' and c <= 'f' { c as i64 - 87 } else { c as i64 - 55 };
            v = v * 16 + d;
            k += 1;
        }
        v
    }

    fn text(mut ref self) -> String {
        // at the opening quote
        self.pos += 1;
        let mut out = String.new();
        loop {
            let c = self.cs[self.pos];
            self.pos += 1;
            if c == '"' {
                return out;
            }
            if c != '\\' {
                out.push(c);
                continue;
            }
            let e = self.cs[self.pos];
            self.pos += 1;
            if e == 'n' {
                out.push('\n');
            } else if e == 't' {
                out.push('\t');
            } else if e == 'r' {
                out.push('\r');
            } else if e == 'b' {
                out.push('\u{8}');
            } else if e == 'f' {
                out.push('\u{c}');
            } else if e == 'u' {
                let mut v = self.hex4();
                if v >= 0xD800 and v < 0xDC00 and self.pos + 1 < self.cs.len() and self.cs[self.pos] == '\\' and self.cs[self.pos + 1] == 'u' {
                    self.pos += 2;
                    let w = self.hex4();
                    v = 0x10000 + ((v - 0xD800) << 10) + (w - 0xDC00);
                }
                out.push(char_of(v));
            } else {
                out.push(e);
            }
        }
    }

    fn value(mut ref self) -> J {
        self.ws();
        let c = self.cs[self.pos];
        if c == '"' {
            return J.Text(self.text());
        }
        if c == '{' {
            self.pos += 1;
            let mut items: Vec[(String, J)] = Vec.new();
            loop {
                self.ws();
                if self.cs[self.pos] == '}' {
                    self.pos += 1;
                    return J.Obj(items);
                }
                if self.cs[self.pos] == ',' {
                    self.pos += 1;
                    self.ws();
                }
                let k = self.text();
                self.ws();
                self.pos += 1;
                let v = self.value();
                items.push((k, v));
            }
        }
        if c == '[' {
            self.pos += 1;
            let mut items: Vec[J] = Vec.new();
            loop {
                self.ws();
                if self.cs[self.pos] == ']' {
                    self.pos += 1;
                    return J.Arr(items);
                }
                if self.cs[self.pos] == ',' {
                    self.pos += 1;
                }
                items.push(self.value());
            }
        }
        if c == 'n' {
            self.pos += 4;
            return J.Null;
        }
        if c == 't' {
            self.pos += 4;
            return J.Bool(true);
        }
        if c == 'f' {
            self.pos += 5;
            return J.Bool(false);
        }
        let mut neg = false;
        if c == '-' {
            neg = true;
            self.pos += 1;
        }
        let mut n: i64 = 0;
        while self.pos < self.cs.len() and self.cs[self.pos] >= '0' and self.cs[self.pos] <= '9' {
            n = n * 10 + (self.cs[self.pos] as i64 - 48);
            self.pos += 1;
        }
        J.Num(if neg { 0 - n } else { n })
    }
}

fn parse_json(line: ref String) -> J {
    let mut p = JsonIn { cs: line.chars().collect(), pos: 0 };
    p.value()
}

fn jget(j: ref J, key: Str) -> J {
    if let J.Obj(items) = j {
        for (k, v) in items.iter() {
            if k == key {
                return v.clone();
            }
        }
    }
    J.Null
}

fn unhex(s: ref String) -> Vec[u8] {
    let cs: Vec[char] = s.chars().collect();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < cs.len() {
        let mut v: i64 = 0;
        let mut k = 0;
        while k < 2 {
            let c = cs[i + k];
            let d = if c >= '0' and c <= '9' { c as i64 - 48 } else { c as i64 - 87 };
            v = v * 16 + d;
            k += 1;
        }
        out.push(v as u8);
        i += 2;
    }
    out
}


// ---------------------------------------------------------------- the idna codec
// Python's encodings.idna (IDNA 2003): nameprep with Unicode 3.2 data,
// then Punycode. Only success or failure matters to w3lib, which falls
// back to UTF-8 on any error.

fn nameprep(u: ref Uni, label: ref Vec[i64]) -> Option[Vec[i64]] {
    let mut mapped: Vec[i64] = Vec.new();
    for c in label.iter() {
        let i = u.at(*c);
        if i >= 0 and u.infos[i].b1 {
            continue;
        }
        if i >= 0 and u.infos[i].b2.len() > 0 {
            for x in u.infos[i].b2.iter() {
                mapped.push(*x);
            }
        } else {
            mapped.push(*c);
        }
    }
    let norm = u.nfkc(mapped, true);
    let mut any_randal = false;
    for c in norm.iter() {
        let i = u.at(*c);
        if i >= 0 and u.infos[i].prohibited {
            return None;
        }
        if i >= 0 and u.infos[i].randal {
            any_randal = true;
        }
    }
    if any_randal {
        for c in norm.iter() {
            let i = u.at(*c);
            if i >= 0 and u.infos[i].lcat {
                return None;
            }
        }
        let first = u.at(norm[0]);
        let last = u.at(norm[norm.len() - 1]);
        if first < 0 or not u.infos[first].randal or last < 0 or not u.infos[last].randal {
            return None;
        }
    }
    Some(norm)
}

fn all_ascii_cps(cs: ref Vec[i64]) -> bool {
    for c in cs.iter() {
        if *c >= 128 {
            return false;
        }
    }
    true
}

fn to_ascii(u: ref Uni, label: ref Vec[i64]) -> Option[Vec[i64]] {
    if all_ascii_cps(label) {
        if label.len() > 0 and label.len() < 64 {
            return Some(label.clone());
        }
        return None;
    }
    let prepped = nameprep(u, label)?;
    if all_ascii_cps(prepped) {
        if prepped.len() > 0 and prepped.len() < 64 {
            return Some(prepped);
        }
        return None;
    }
    if str_of_cps(prepped).to_lowercase().starts_with("xn--") {
        return None;
    }
    let mut out = cp("xn--");
    for c in punycode_encode(prepped).iter() {
        out.push(*c);
    }
    if out.len() < 64 { Some(out) } else { None }
}

fn is_idna_dot(c: i64) -> bool {
    c == 0x2E or c == 0x3002 or c == 0xFF0E or c == 0xFF61
}

// str.encode("idna") for a non-ASCII name.
fn idna_encode(u: ref Uni, s: ref String) -> Option[String] {
    let cs = cps(s);
    let mut labels: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    for c in cs.iter() {
        if is_idna_dot(*c) {
            labels.push(cur);
            cur = Vec.new();
        } else {
            cur.push(*c);
        }
    }
    labels.push(cur);
    let mut trailing = false;
    if labels.len() > 0 and labels[labels.len() - 1].len() == 0 {
        trailing = true;
        labels.pop();
    }
    let mut out = String.new();
    let mut first = true;
    for l in labels.iter() {
        if not first {
            out.push('.');
        }
        first = false;
        out.push_str(str_of_cps(to_ascii(u, l)?));
    }
    if trailing {
        out.push('.');
    }
    Some(out)
}

// ------------------------------------------------------------ text

fn chars_of(s: Str) -> Vec[char] {
    s.chars().collect()
}

fn str_of(cs: ref Vec[char]) -> String {
    let mut s = String.new();
    for c in cs.iter() {
        s.push(*c);
    }
    s
}

fn sub_chars(cs: ref Vec[char], from: i64, to: i64) -> Vec[char] {
    let mut v: Vec[char] = Vec.new();
    for i in from..to {
        v.push(cs[i]);
    }
    v
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

fn ascii_lower(c: char) -> char {
    if c >= 'A' and c <= 'Z' {
        char.try_from((c as u32) + 32).unwrap_or(c)
    } else {
        c
    }
}

fn hex_char(n: u32) -> char {
    let h: Vec[char] = "0123456789abcdef".chars().collect();
    h[(n & 15) as i64]
}

// n in lowercase hex, padded with zeros to width digits.
fn hex_pad(n: u32, width: i64) -> String {
    let mut ds: Vec[char] = Vec.new();
    let mut m = n;
    while m > 0 {
        ds.push(hex_char(m));
        m = m / 16;
    }
    while ds.len() < width {
        ds.push('0');
    }
    let mut s = String.new();
    let mut i = ds.len() - 1;
    while i >= 0 {
        s.push(ds[i]);
        i -= 1;
    }
    s
}

fn hex_parse(s: Str) -> u64 {
    let mut n: u64 = 0;
    for c in s.chars() {
        let d = if c >= '0' and c <= '9' {
            (c as u32) - ('0' as u32)
        } else {
            (c as u32) - ('a' as u32) + 10
        };
        n = n * 16 + (d as u64);
    }
    n
}

fn dec_parse(s: Str) -> i64 {
    let mut n: i64 = 0;
    for c in s.chars() {
        n = n * 10 + ((c as u32) - ('0' as u32)) as i64;
    }
    n
}


// ------------------------------------------------------------ code points

// Text is handled as code points, since a decoded A-label can hold lone
// surrogates, which Python's str allows and a char does not.
fn cps_of(s: Str) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s.chars() {
        out.push((c as u32) as i64);
    }
    out
}

fn ascii_cps(s: Str) -> Vec[i64] {
    cps_of(s)
}

fn cps_str(cs: ref Vec[i64]) -> String {
    let mut s = String.new();
    for c in cs.iter() {
        s.push(char.try_from(*c as u32).unwrap_or('?'));
    }
    s
}

fn isub(cs: ref Vec[i64], from: i64, to: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    let mut i = from;
    while i < to {
        v.push(cs[i]);
        i += 1;
    }
    v
}

fn concat(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut v = a.clone();
    for c in b.iter() {
        v.push(*c);
    }
    v
}

fn cps_eq(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    true
}

fn is_ascii(cs: ref Vec[i64]) -> bool {
    for c in cs.iter() {
        if *c >= 128 {
            return false;
        }
    }
    true
}

// str.lower() on ASCII.
fn ascii_lower_cps(cs: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in cs.iter() {
        out.push(if *c >= 65 and *c <= 90 { *c + 32 } else { *c });
    }
    out
}

fn starts_with_cps(cs: ref Vec[i64], p: Str) -> bool {
    let pc = cps_of(p);
    if cs.len() < pc.len() {
        return false;
    }
    for i in 0..pc.len() {
        if cs[i] != pc[i] {
            return false;
        }
    }
    true
}

fn hex_upper(n: i64, width: i64) -> String {
    let h: Vec[char] = "0123456789ABCDEF".chars().collect();
    let mut ds: Vec[char] = Vec.new();
    let mut m = n;
    while m > 0 {
        ds.push(h[m % 16]);
        m = m / 16;
    }
    while ds.len() < width {
        ds.push('0');
    }
    let mut s = String.new();
    let mut i = ds.len() - 1;
    while i >= 0 {
        s.push(ds[i]);
        i -= 1;
    }
    s
}

fn hex_lower(n: i64, width: i64) -> String {
    let mut out = String.new();
    for c in hex_upper(n, width).chars() {
        out.push(ascii_lower(c));
    }
    out
}

// idna's _unot: U+ and at least four upper-case hex digits.
fn unot(cp: i64) -> String {
    f"U+{hex_upper(cp, 4)}"
}

fn hex_cps(s: Str) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    if s.len() == 0 {
        return out;
    }
    for h in s.split(" ") {
        out.push(hex_parse(h) as i64);
    }
    out
}

// ------------------------------------------------------------ the tables

// What Python's unicodedata says about one character.
struct IdnaInfo {
    ccc: i64,
    // The canonical decomposition, one level; empty if there is none.
    decomp: Vec[i64],
    printable: bool,
    named: bool,
    bidi: String,
    category: String,
}

// One row of idna's UTS #46 table: the status from start on.
struct Uts46Row {
    start: i64,
    status: char,
    replacement: Vec[i64],
}

struct Tables {
    index: Map[i64, i64],
    infos: Vec[IdnaInfo],
    // Primary composites by (first << 21) | second.
    compose: Map[i64, i64],
    uts46: Vec[Uts46Row],
    // idna's code point classes, scripts and joining types, each a list
    // of [start, end) ranges in order.
    set_names: Vec[String],
    sets: Vec[Vec[(i64, i64)]],
}

fn load_tables(unicode: ref String, uts46: ref String, idnadata: ref String) -> Tables {
    let mut t = Tables {
        index: Map.new(),
        infos: Vec.new(),
        compose: Map.new(),
        uts46: Vec.new(),
        set_names: Vec.new(),
        sets: Vec.new(),
    };
    for line in unicode.lines() {
        if line.len() == 0 or line.starts_with("#") {
            continue;
        }
        let f: Vec[Str] = line.split(";").collect();
        let cp = hex_parse(f[0]) as i64;
        let decomp = hex_cps(f[2]);
        let flags = f[3].to_string();
        if flags.contains("c") {
            t.compose.insert((decomp[0] << 21) | decomp[1], cp);
        }
        t.index.insert(cp, t.infos.len());
        t.infos.push(IdnaInfo {
            ccc: dec_parse(f[1]),
            decomp: decomp,
            printable: not flags.contains("p"),
            named: not flags.contains("n"),
            bidi: f[4].to_string(),
            category: f[5].to_string(),
        });
    }
    for line in uts46.lines() {
        if line.len() == 0 or line.starts_with("#") {
            continue;
        }
        let f: Vec[Str] = line.split(";").collect();
        let st: Vec[char] = f[1].chars().collect();
        t.uts46.push(Uts46Row { start: hex_parse(f[0]) as i64, status: st[0], replacement: hex_cps(f[2]) });
    }
    for line in idnadata.lines() {
        if line.len() == 0 or line.starts_with("#") {
            continue;
        }
        let f: Vec[Str] = line.split(" ").collect();
        let name = f[0].to_string();
        let n = t.set_names.len();
        if n == 0 or t.set_names[n - 1] != name {
            t.set_names.push(name);
            t.sets.push(Vec.new());
        }
        let k = t.sets.len() - 1;
        t.sets[k].push((hex_parse(f[1]) as i64, hex_parse(f[2]) as i64));
    }
    t
}

impl Tables {
    fn at(ref self, cp: i64) -> i64 {
        match self.index.get(cp) {
            Some(i) => *i,
            None => -1,
        }
    }

    fn ccc(ref self, cp: i64) -> i64 {
        let i = self.at(cp);
        if i < 0 { 0 } else { self.infos[i].ccc }
    }

    fn named(ref self, cp: i64) -> bool {
        let i = self.at(cp);
        i >= 0 and self.infos[i].named
    }

    fn printable(ref self, cp: i64) -> bool {
        let i = self.at(cp);
        i >= 0 and self.infos[i].printable
    }

    // unicodedata.bidirectional: "" for a character it does not know.
    fn bidi(ref self, cp: i64) -> String {
        let i = self.at(cp);
        if i < 0 { String.new() } else { self.infos[i].bidi.clone() }
    }

    fn is_mark(ref self, cp: i64) -> bool {
        let i = self.at(cp);
        i >= 0 and self.infos[i].category.starts_with("M")
    }

    // intranges_contain on the named set.
    fn in_set(ref self, name: Str, cp: i64) -> bool {
        for k in 0..self.set_names.len() {
            if self.set_names[k] == name {
                let mut lo = 0;
                let mut hi = self.sets[k].len();
                while lo < hi {
                    let mid = (lo + hi) / 2;
                    let (a, _) = self.sets[k][mid];
                    if a <= cp {
                        lo = mid + 1;
                    } else {
                        hi = mid;
                    }
                }
                if lo == 0 {
                    return false;
                }
                let (a, b) = self.sets[k][lo - 1];
                return a <= cp and cp < b;
            }
        }
        false
    }

    fn joining_type(ref self, cp: i64) -> String {
        for jt in ["C", "D", "L", "R", "T"] {
            if self.in_set(f"joining:{jt}", cp) {
                return jt.to_string();
            }
        }
        String.new()
    }

    // The UTS #46 row for a code point: the last one starting at or
    // before it.
    fn uts46_row(ref self, cp: i64) -> i64 {
        let mut lo = 0;
        let mut hi = self.uts46.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if self.uts46[mid].start <= cp {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        lo - 1
    }

    // ---------------------------------------------------------- NFC

    fn decompose_into(ref self, cp: i64, out: mut ref Vec[i64]) {
        if cp >= 0xAC00 and cp < 0xAC00 + 11172 {
            let s = cp - 0xAC00;
            out.push(0x1100 + s / 588);
            out.push(0x1161 + (s % 588) / 28);
            if s % 28 != 0 {
                out.push(0x11A7 + s % 28);
            }
            return;
        }
        let i = self.at(cp);
        if i < 0 or self.infos[i].decomp.len() == 0 {
            out.push(cp);
            return;
        }
        for d in self.infos[i].decomp.clone().iter() {
            self.decompose_into(*d, mut out);
        }
    }

    fn nfd(ref self, cs: ref Vec[i64]) -> Vec[i64] {
        let mut out: Vec[i64] = Vec.new();
        for c in cs.iter() {
            self.decompose_into(*c, mut out);
        }
        let mut i = 1;
        while i < out.len() {
            let mut j = i;
            while j > 0 and self.ccc(out[j]) != 0 and self.ccc(out[j - 1]) > self.ccc(out[j]) {
                let t = out[j];
                out[j] = out[j - 1];
                out[j - 1] = t;
                j -= 1;
            }
            i += 1;
        }
        out
    }

    fn composite(ref self, a: i64, b: i64) -> i64 {
        if a >= 0x1100 and a < 0x1113 and b >= 0x1161 and b < 0x1176 {
            return 0xAC00 + ((a - 0x1100) * 21 + (b - 0x1161)) * 28;
        }
        if a >= 0xAC00 and a < 0xAC00 + 11172 and (a - 0xAC00) % 28 == 0 and b > 0x11A7 and b < 0x11C3 {
            return a + (b - 0x11A7);
        }
        match self.compose.get((a << 21) | b) {
            Some(c) => *c,
            None => -1,
        }
    }

    // unicodedata.normalize("NFC").
    fn nfc(ref self, cs: ref Vec[i64]) -> Vec[i64] {
        let d = self.nfd(cs);
        let mut out: Vec[i64] = Vec.new();
        let mut starter: i64 = -1;
        // The class of the last character kept since the starter, or -1
        // when the starter is the last one kept.
        let mut last: i64 = -1;
        for c in d.iter() {
            let cc = self.ccc(*c);
            if starter >= 0 {
                let blocked = last != -1 and (last == 0 or last >= cc);
                if not blocked {
                    let comp = self.composite(out[starter], *c);
                    if comp >= 0 {
                        out[starter] = comp;
                        continue;
                    }
                }
            }
            if cc == 0 {
                starter = out.len();
                last = -1;
            } else {
                last = cc;
            }
            out.push(*c);
        }
        out
    }

    // ---------------------------------------------------------- repr

    // repr() of a str.
    fn repr(ref self, cs: ref Vec[i64]) -> String {
        let mut has_single = false;
        let mut has_double = false;
        for c in cs.iter() {
            if *c == 39 {
                has_single = true;
            }
            if *c == 34 {
                has_double = true;
            }
        }
        let q: i64 = if has_single and not has_double { 34 } else { 39 };
        let mut out = String.new();
        out.push(char.try_from(q as u32).unwrap_or('?'));
        for c in cs.iter() {
            let x = *c;
            if x == q or x == 92 {
                out.push('\\');
                out.push(char.try_from(x as u32).unwrap_or('?'));
            } else if x == 9 {
                out.push_str("\\t");
            } else if x == 10 {
                out.push_str("\\n");
            } else if x == 13 {
                out.push_str("\\r");
            } else if x < 32 or x == 127 {
                out.push_str(f"\\x{hex_lower(x, 2)}");
            } else if x < 128 or self.printable(x) {
                out.push(char.try_from(x as u32).unwrap_or('?'));
            } else if x < 256 {
                out.push_str(f"\\x{hex_lower(x, 2)}");
            } else if x < 65536 {
                out.push_str(f"\\u{hex_lower(x, 4)}");
            } else {
                out.push_str(f"\\U{hex_lower(x, 8)}");
            }
        }
        out.push(char.try_from(q as u32).unwrap_or('?'));
        out
    }

    // repr() of bytes that are all ASCII.
    fn bytes_repr(ref self, cs: ref Vec[i64]) -> String {
        let mut out = "b".to_string();
        let mut has_single = false;
        let mut has_double = false;
        for c in cs.iter() {
            if *c == 39 {
                has_single = true;
            }
            if *c == 34 {
                has_double = true;
            }
        }
        let q: i64 = if has_single and not has_double { 34 } else { 39 };
        out.push(char.try_from(q as u32).unwrap_or('?'));
        for c in cs.iter() {
            let x = *c;
            if x == q or x == 92 {
                out.push('\\');
                out.push(char.try_from(x as u32).unwrap_or('?'));
            } else if x == 9 {
                out.push_str("\\t");
            } else if x == 10 {
                out.push_str("\\n");
            } else if x == 13 {
                out.push_str("\\r");
            } else if x < 32 or x >= 127 {
                out.push_str(f"\\x{hex_lower(x, 2)}");
            } else {
                out.push(char.try_from(x as u32).unwrap_or('?'));
            }
        }
        out.push(char.try_from(q as u32).unwrap_or('?'));
        out
    }
}

// ------------------------------------------------------------ errors

// An IDNAError or one of its subclasses, with idna's machine-readable
// code and the 1-based position (-1 where there is none).
#[derive(Clone)]
struct IdnaError {
    kind: String,
    code: String,
    position: i64,
    msg: String,
}

fn ierr(kind: Str, code: Str, position: i64, msg: own String) -> IdnaError {
    IdnaError { kind: kind.to_string(), code: code.to_string(), position: position, msg: msg }
}

fn plain(code: Str, msg: Str) -> IdnaError {
    ierr("IDNAError", code, -1, msg.to_string())
}

fn show_err(e: ref IdnaError) -> String {
    let at = if e.position < 0 { String.new() } else { f" at {e.position}" };
    f"{e.kind} {e.code}{at}: {e.msg}"
}

const MAX_INPUT: i64 = 1024;
const MAX_DOMAIN: i64 = 253;

// ------------------------------------------------------------ label checks

fn in_list(s: ref String, names: ref Vec[Str]) -> bool {
    for n in names.iter() {
        if s == *n {
            return true;
        }
    }
    false
}

// The Bidi Rule of RFC 5893.
fn check_bidi(label: ref Vec[i64], check_ltr: bool, t: ref Tables) -> Result[(), IdnaError] {
    if label.len() > MAX_INPUT {
        return Err(plain("input_too_long", "Label too long"));
    }
    let mut bidi_label = false;
    for i in 0..label.len() {
        let d = t.bidi(label[i]);
        if d.len() == 0 {
            let r = t.repr(label);
            return Err(ierr("IDNABidiError", "bidi_unknown_direction", i + 1, f"Unknown directionality in label {r} at position {i + 1}"));
        }
        if d == "R" or d == "AL" or d == "AN" {
            bidi_label = true;
        }
    }
    if not bidi_label and not check_ltr {
        return Ok(());
    }
    let first = t.bidi(label[0]);
    let rtl = if first == "R" or first == "AL" {
        true
    } else if first == "L" {
        false
    } else {
        let r = t.repr(label);
        return Err(ierr("IDNABidiError", "bidi_rule_1", 1, f"First codepoint in label {r} must be directionality L, R or AL"));
    };
    let rtl_allowed: Vec[Str] = ["R", "AL", "AN", "EN", "ES", "CS", "ET", "ON", "BN", "NSM"];
    let ltr_allowed: Vec[Str] = ["L", "EN", "ES", "CS", "ET", "ON", "BN", "NSM"];
    let mut valid_ending = false;
    let mut ending: i64 = 1;
    let mut number_type = String.new();
    for i in 0..label.len() {
        let idx = i + 1;
        let d = t.bidi(label[i]);
        if rtl {
            if not in_list(d, rtl_allowed) {
                return Err(ierr("IDNABidiError", "bidi_rule_2", idx, f"Invalid direction for codepoint at position {idx} in a right-to-left label"));
            }
            if d == "R" or d == "AL" or d == "EN" or d == "AN" {
                valid_ending = true;
                ending = idx;
            } else if d != "NSM" {
                valid_ending = false;
                ending = idx;
            }
            if d == "AN" or d == "EN" {
                if number_type.len() == 0 {
                    number_type = d.clone();
                } else if number_type != d {
                    return Err(ierr("IDNABidiError", "bidi_rule_4", idx, "Can not mix numeral types in a right-to-left label".to_string()));
                }
            }
        } else {
            if not in_list(d, ltr_allowed) {
                return Err(ierr("IDNABidiError", "bidi_rule_5", idx, f"Invalid direction for codepoint at position {idx} in a left-to-right label"));
            }
            if d == "L" or d == "EN" {
                valid_ending = true;
                ending = idx;
            } else if d != "NSM" {
                valid_ending = false;
                ending = idx;
            }
        }
    }
    if not valid_ending {
        let code = if rtl { "bidi_rule_3" } else { "bidi_rule_6" };
        return Err(ierr("IDNABidiError", code, ending, "Label ends with illegal codepoint directionality".to_string()));
    }
    Ok(())
}

fn check_initial_combiner(label: ref Vec[i64], t: ref Tables) -> Result[(), IdnaError] {
    if label.len() > 0 and t.is_mark(label[0]) {
        return Err(ierr("IDNAError", "leading_combiner", 1, "Label begins with an illegal combining character".to_string()));
    }
    Ok(())
}

fn check_hyphen_ok(label: ref Vec[i64]) -> Result[(), IdnaError] {
    if label.len() >= 4 and label[2] == 45 and label[3] == 45 {
        return Err(plain("hyphen_3_4", "Label has disallowed hyphens in 3rd and 4th position"));
    }
    if label.len() > 0 and (label[0] == 45 or label[label.len() - 1] == 45) {
        return Err(plain("hyphen_start_end", "Label must not start or end with a hyphen"));
    }
    Ok(())
}

fn check_nfc(label: ref Vec[i64], t: ref Tables) -> Result[(), IdnaError] {
    if label.len() > MAX_INPUT {
        return Err(plain("input_too_long", "Label too long"));
    }
    if not cps_eq(t.nfc(label), label) {
        return Err(plain("not_nfc", "Label must be in Normalization Form C"));
    }
    Ok(())
}

// idna's _combining_class: Err where Python raises ValueError, for a
// character of class 0 that has no name.
fn combining_class(cp: i64, t: ref Tables) -> Result[i64, ()] {
    let v = t.ccc(cp);
    if v == 0 and not t.named(cp) {
        return Err(());
    }
    Ok(v)
}

// RFC 5892 Appendix A.1 and A.2: ZERO WIDTH NON-JOINER and JOINER.
fn valid_contextj(label: ref Vec[i64], pos: i64, t: ref Tables) -> Result[bool, ()] {
    let cp = label[pos];
    if cp == 0x200C {
        if pos > 0 and combining_class(label[pos - 1], t)? == 9 {
            return Ok(true);
        }
        let mut ok = false;
        let mut i = pos - 1;
        while i >= 0 {
            let jt = t.joining_type(label[i]);
            if jt == "T" {
                i -= 1;
                continue;
            }
            if jt == "L" or jt == "D" {
                ok = true;
            }
            break;
        }
        if not ok {
            return Ok(false);
        }
        ok = false;
        let mut k = pos + 1;
        while k < label.len() {
            let jt = t.joining_type(label[k]);
            if jt == "T" {
                k += 1;
                continue;
            }
            if jt == "R" or jt == "D" {
                ok = true;
            }
            break;
        }
        return Ok(ok);
    }
    if cp == 0x200D {
        return Ok(pos > 0 and combining_class(label[pos - 1], t)? == 9);
    }
    Ok(false)
}

// RFC 5892 Appendix A.3 to A.9.
fn valid_contexto(label: ref Vec[i64], pos: i64, t: ref Tables) -> bool {
    let cp = label[pos];
    let n = label.len();
    if cp == 0xB7 {
        return pos > 0 and pos < n - 1 and label[pos - 1] == 0x6C and label[pos + 1] == 0x6C;
    }
    if cp == 0x375 {
        if pos < n - 1 and n > 1 {
            return t.in_set("script:Greek", label[pos + 1]);
        }
        return false;
    }
    if cp == 0x5F3 or cp == 0x5F4 {
        if pos > 0 {
            return t.in_set("script:Hebrew", label[pos - 1]);
        }
        return false;
    }
    if cp == 0x30FB {
        for c in label.iter() {
            if *c == 0x30FB {
                continue;
            }
            if t.in_set("script:Hiragana", *c) or t.in_set("script:Katakana", *c) or t.in_set("script:Han", *c) {
                return true;
            }
        }
        return false;
    }
    if cp >= 0x660 and cp <= 0x669 {
        for c in label.iter() {
            if *c >= 0x6F0 and *c <= 0x6F9 {
                return false;
            }
        }
        return true;
    }
    if cp >= 0x6F0 and cp <= 0x6F9 {
        for c in label.iter() {
            if *c >= 0x660 and *c <= 0x669 {
                return false;
            }
        }
        return true;
    }
    false
}

fn check_label(label: ref Vec[i64], t: ref Tables) -> Result[(), IdnaError] {
    if label.len() > MAX_INPUT {
        return Err(plain("input_too_long", "Label too long"));
    }
    if label.len() == 0 {
        return Err(plain("empty_label", "Empty Label"));
    }
    if label.len() > MAX_DOMAIN + 1 {
        return Err(plain("label_too_long", "Label too long"));
    }
    check_nfc(label, t)?;
    check_hyphen_ok(label)?;
    check_initial_combiner(label, t)?;
    for pos in 0..label.len() {
        let cp = label[pos];
        let at = pos + 1;
        if t.in_set("PVALID", cp) {
            continue;
        }
        if t.in_set("CONTEXTJ", cp) {
            match valid_contextj(label, pos, t) {
                Err(_) => {
                    let r = t.repr(label);
                    return Err(ierr("IDNAError", "unknown_codepoint", at, f"Unknown codepoint adjacent to joiner {unot(cp)} at position {at} in {r}"));
                }
                Ok(false) => {
                    let r = t.repr(label);
                    return Err(ierr("InvalidCodepointContext", "contextj", at, f"Joiner {unot(cp)} not allowed at position {at} in {r}"));
                }
                Ok(true) => {}
            }
        } else if t.in_set("CONTEXTO", cp) {
            if not valid_contexto(label, pos, t) {
                let r = t.repr(label);
                return Err(ierr("InvalidCodepointContext", "contexto", at, f"Codepoint {unot(cp)} not allowed at position {at} in {r}"));
            }
        } else {
            let r = t.repr(label);
            return Err(ierr("InvalidCodepoint", "disallowed_codepoint", at, f"Codepoint {unot(cp)} at position {at} of {r} not allowed"));
        }
    }
    check_bidi(label, false, t)
}

// ------------------------------------------------------------ Punycode

// RFC 3492 as Python's encodings.punycode writes and reads it.

fn puny_t(j: i64, bias: i64) -> i64 {
    let r = 36 * (j + 1) - bias;
    if r < 1 {
        1
    } else if r > 26 {
        26
    } else {
        r
    }
}

fn puny_adapt(delta0: i64, first: bool, numchars: i64) -> i64 {
    let mut delta = if first { delta0 / 700 } else { delta0 / 2 };
    delta += delta / numchars;
    let mut divisions = 0;
    while delta > 455 {
        delta = delta / 35;
        divisions += 36;
    }
    divisions + (36 * delta / (delta + 38))
}

fn puny_digit(d: i64) -> i64 {
    if d < 26 { 97 + d } else { 48 + d - 26 }
}

fn punycode_encode(text: ref Vec[i64]) -> Vec[i64] {
    let mut base: Vec[i64] = Vec.new();
    let mut extended: Vec[i64] = Vec.new();
    for c in text.iter() {
        if *c < 128 {
            base.push(*c);
        } else {
            let mut seen = false;
            for e in extended.iter() {
                if *e == *c {
                    seen = true;
                }
            }
            if not seen {
                extended.push(*c);
            }
        }
    }
    extended.sort();
    // Insertion unsort coding.
    let mut deltas: Vec[i64] = Vec.new();
    let mut oldchar: i64 = 0x80;
    let mut oldindex: i64 = -1;
    for ch in extended.iter() {
        let c = *ch;
        let mut curlen: i64 = 0;
        for x in text.iter() {
            if *x < c {
                curlen += 1;
            }
        }
        let mut delta = (curlen + 1) * (c - oldchar);
        let mut index: i64 = -1;
        let mut pos: i64 = -1;
        loop {
            // selective_find
            let mut found = false;
            loop {
                pos += 1;
                if pos == text.len() {
                    break;
                }
                let x = text[pos];
                if x == c {
                    index += 1;
                    found = true;
                    break;
                } else if x < c {
                    index += 1;
                }
            }
            if not found {
                break;
            }
            delta += index - oldindex;
            deltas.push(delta - 1);
            oldindex = index;
            delta = 0;
        }
        oldchar = c;
    }
    // Bias adaptation and the variable-length integers.
    let mut out: Vec[i64] = Vec.new();
    let mut bias: i64 = 72;
    for points in 0..deltas.len() {
        let mut n = deltas[points];
        let mut j: i64 = 0;
        loop {
            let t = puny_t(j, bias);
            if n < t {
                out.push(puny_digit(n));
                break;
            }
            out.push(puny_digit(t + (n - t) % (36 - t)));
            n = (n - t) / (36 - t);
            j += 1;
        }
        bias = puny_adapt(deltas[points], points == 0, base.len() + points + 1);
    }
    if base.len() > 0 {
        let mut r = base.clone();
        r.push(45);
        for c in out.iter() {
            r.push(*c);
        }
        return r;
    }
    out
}

const PUNY_CAP: i64 = 35184372088832;

// The text a Punycode string decodes to, or None where Python's codec
// raises. Numbers are capped well past the point where the character
// they lead to is out of range, which is an error either way.
fn punycode_decode(text: ref Vec[i64]) -> Option[Vec[i64]] {
    let mut dash: i64 = -1;
    for i in 0..text.len() {
        if text[i] == 45 {
            dash = i;
        }
    }
    let mut base: Vec[i64] = Vec.new();
    let mut ext: Vec[i64] = Vec.new();
    if dash >= 0 {
        base = isub(text, 0, dash);
    }
    for i in (dash + 1)..text.len() {
        let c = text[i];
        ext.push(if c >= 97 and c <= 122 { c - 32 } else { c });
    }
    let mut ch: i64 = 0x80;
    let mut pos: i64 = -1;
    let mut bias: i64 = 72;
    let mut extpos: i64 = 0;
    while extpos < ext.len() {
        // decode_generalized_number
        let mut p = extpos;
        let mut result: i64 = 0;
        let mut w: i64 = 1;
        let mut j: i64 = 0;
        loop {
            if p >= ext.len() {
                return None;
            }
            let c = ext[p];
            p += 1;
            let digit = if c >= 65 and c <= 90 {
                c - 65
            } else if c >= 48 and c <= 57 {
                c - 22
            } else {
                return None;
            };
            let t = puny_t(j, bias);
            result += digit * w;
            if result > PUNY_CAP {
                result = PUNY_CAP;
            }
            if digit < t {
                break;
            }
            w = w * (36 - t);
            if w > PUNY_CAP {
                w = PUNY_CAP;
            }
            j += 1;
        }
        let delta = result;
        pos += delta + 1;
        ch += pos / (base.len() + 1);
        if ch > 0x10FFFF {
            return None;
        }
        pos = pos % (base.len() + 1);
        base.insert(pos, ch);
        bias = puny_adapt(delta, extpos == 0, base.len());
        extpos = p;
    }
    Some(base)
}

// ------------------------------------------------------------ labels

fn alabel(label: ref Vec[i64], t: ref Tables) -> Result[Vec[i64], IdnaError] {
    if label.len() > MAX_INPUT {
        return Err(plain("input_too_long", "Label too long"));
    }
    if is_ascii(label) {
        ulabel(label, t)?;
        if label.len() > 63 {
            return Err(plain("label_too_long", "Label too long"));
        }
        return Ok(label.clone());
    }
    check_label(label, t)?;
    let out = concat(ascii_cps("xn--"), punycode_encode(label));
    if out.len() > 63 {
        return Err(plain("label_too_long", "Label too long"));
    }
    Ok(out)
}

fn ulabel(label: ref Vec[i64], t: ref Tables) -> Result[Vec[i64], IdnaError] {
    if label.len() > MAX_INPUT {
        return Err(plain("input_too_long", "Label too long"));
    }
    if not is_ascii(label) {
        check_label(label, t)?;
        return Ok(label.clone());
    }
    let mut lb = ascii_lower_cps(label);
    if starts_with_cps(lb, "xn--") {
        lb = isub(lb, 4, lb.len());
        if lb.len() == 0 {
            return Err(plain("invalid_alabel", "Malformed A-label, no Punycode eligible content found"));
        }
        if lb[lb.len() - 1] == 45 {
            return Err(plain("invalid_alabel", "A-label must not end with a hyphen"));
        }
    } else {
        check_label(lb, t)?;
        return Ok(lb);
    }
    let u = match punycode_decode(lb) {
        Some(u) => u,
        None => return Err(plain("invalid_alabel", "Invalid A-label")),
    };
    if not cps_eq(punycode_encode(u), lb) {
        return Err(plain("non_canonical_alabel", "A-label is not the canonical Punycode encoding of its U-label"));
    }
    check_label(u, t)?;
    Ok(u)
}

// ------------------------------------------------------------ UTS #46

// An ASCII character UseSTD3ASCIIRules rejects: anything but a lower-case
// letter, a digit, '-' and '.'.
fn std3_bad(c: i64) -> bool {
    (c >= 0 and c <= 0x2C) or c == 0x2F or (c >= 0x3A and c <= 0x60) or (c >= 0x7B and c <= 0x7F)
}

fn check_std3(text: ref Vec[i64], domain: ref Vec[i64], offset: i64, t: ref Tables) -> Result[(), IdnaError] {
    for i in 0..text.len() {
        if std3_bad(text[i]) {
            let p = offset + i + 1;
            let r = t.repr(domain);
            return Err(ierr("InvalidCodepoint", "uts46_std3", p, f"Codepoint {unot(text[i])} not allowed at position {p} in {r}"));
        }
    }
    Ok(())
}

fn uts46_remap(domain: ref Vec[i64], std3: bool, t: ref Tables) -> Result[Vec[i64], IdnaError] {
    if domain.len() > MAX_INPUT {
        return Err(plain("input_too_long", "Domain too long"));
    }
    if is_ascii(domain) {
        let result = ascii_lower_cps(domain);
        if std3 {
            check_std3(result, domain, 0, t)?;
        }
        return Ok(result);
    }
    let mut output: Vec[i64] = Vec.new();
    let mut start: i64 = 0;
    for pos in 0..domain.len() {
        let cp = domain[pos];
        let i = t.uts46_row(cp);
        let status = t.uts46[i].status;
        if status == 'V' or status == 'D' {
            continue;
        }
        let replacement = if status == 'M' {
            t.uts46[i].replacement.clone()
        } else if status == 'I' {
            Vec.new()
        } else {
            let r = t.repr(domain);
            return Err(ierr("InvalidCodepoint", "uts46_disallowed", pos + 1, f"Codepoint {unot(cp)} not allowed at position {pos + 1} in {r}"));
        };
        if start < pos {
            let run = isub(domain, start, pos);
            if std3 {
                check_std3(run, domain, start, t)?;
            }
            for c in run.iter() {
                output.push(*c);
            }
        }
        if replacement.len() > 0 {
            if std3 {
                for c in replacement.iter() {
                    if std3_bad(*c) {
                        let r = t.repr(domain);
                        return Err(ierr("InvalidCodepoint", "uts46_std3", pos + 1, f"Codepoint {unot(cp)} not allowed at position {pos + 1} in {r}"));
                    }
                }
            }
            for c in replacement.iter() {
                output.push(*c);
            }
        }
        start = pos + 1;
    }
    if start == 0 {
        if std3 {
            check_std3(domain, domain, 0, t)?;
        }
        return Ok(t.nfc(domain));
    }
    let tail = isub(domain, start, domain.len());
    if std3 {
        check_std3(tail, domain, start, t)?;
    }
    for c in tail.iter() {
        output.push(*c);
    }
    Ok(t.nfc(output))
}

// ------------------------------------------------------------ domains

fn is_dot(c: i64, strict: bool) -> bool {
    c == 0x2E or (not strict and (c == 0x3002 or c == 0xFF0E or c == 0xFF61))
}

fn split_labels(s: ref Vec[i64], strict: bool) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    for c in s.iter() {
        if is_dot(*c, strict) {
            out.push(cur.clone());
            cur = Vec.new();
        } else {
            cur.push(*c);
        }
    }
    out.push(cur);
    out
}

fn join_labels(parts: ref Vec[Vec[i64]]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push(0x2E);
        }
        for c in parts[i].iter() {
            out.push(*c);
        }
    }
    out
}

struct Opts {
    strict: bool,
    uts46: bool,
    std3: bool,
    display: bool,
}

fn encode(s0: ref Vec[i64], o: ref Opts, t: ref Tables) -> Result[Vec[i64], IdnaError] {
    if s0.len() > MAX_INPUT {
        return Err(plain("input_too_long", "Domain too long"));
    }
    let s = if o.uts46 { uts46_remap(s0, o.std3, t)? } else { s0.clone() };
    if s.len() > MAX_DOMAIN + 1 {
        return Err(plain("domain_too_long", "Domain too long"));
    }
    let mut labels = split_labels(s, o.strict);
    if labels.len() == 1 and labels[0].len() == 0 {
        return Err(plain("empty_domain", "Empty domain"));
    }
    let mut trailing = false;
    if labels[labels.len() - 1].len() == 0 {
        labels.pop();
        trailing = true;
    }
    let mut result: Vec[Vec[i64]] = Vec.new();
    for label in labels.iter() {
        let a = alabel(label, t)?;
        if a.len() == 0 {
            return Err(plain("empty_label", "Empty label"));
        }
        result.push(a);
    }
    if trailing {
        result.push(Vec.new());
    }
    let out = join_labels(result);
    if out.len() > MAX_DOMAIN + (if trailing { 1 } else { 0 }) {
        return Err(plain("domain_too_long", "Domain too long"));
    }
    Ok(out)
}

fn decode(s0: ref Vec[i64], o: ref Opts, t: ref Tables) -> Result[Vec[i64], IdnaError] {
    if s0.len() > MAX_INPUT {
        return Err(plain("input_too_long", "Domain too long"));
    }
    let s = if o.uts46 { uts46_remap(s0, o.std3, t)? } else { s0.clone() };
    if s.len() > MAX_DOMAIN + 1 {
        return Err(plain("domain_too_long", "Domain too long"));
    }
    let mut labels = split_labels(s, o.strict);
    if labels.len() == 1 and labels[0].len() == 0 {
        return Err(plain("empty_domain", "Empty domain"));
    }
    let mut trailing = false;
    if labels[labels.len() - 1].len() == 0 {
        labels.pop();
        trailing = true;
    }
    let mut result: Vec[Vec[i64]] = Vec.new();
    for label in labels.iter() {
        let u = match ulabel(label, t) {
            Ok(u) => u,
            Err(e) => {
                let low = ascii_lower_cps(isub(label, 0, if label.len() < 4 { label.len() } else { 4 }));
                if o.display and cps_eq(low, ascii_cps("xn--")) {
                    ascii_lower_cps(label)
                } else {
                    return Err(e);
                }
            }
        };
        if u.len() == 0 {
            return Err(plain("empty_label", "Empty label"));
        }
        result.push(u);
    }
    if trailing {
        result.push(Vec.new());
    }
    Ok(join_labels(result))
}

// ---------------------------------------------------------------- rfc3986: the matchers

// misc.py's compiled patterns, built once. URI_MATCHER and
// PERCENT_MATCHER are written out by hand below: the first is the
// appendix B regex, all of whose parts are optional, and the second
// finds "%" and two hex digits.
struct Rx {
    subauth: Program,
    isubauth: Program,
    host: Program,
    ipv4: Program,
    ipv6: Program,
    ipv6_plain: Program,
    path: Program,
    query: Program,
    scheme: Program,
    absolute: Program,
}

struct Ctx {
    rx: Rx,
    u: Uni,
    t: Tables,
}

fn rx(p: ref String) -> Program {
    match compile(cps(p), 0) {
        Ok(pr) => pr,
        Err(e) => panic(f"cannot compile {p}: {err_text(e)}"),
    }
}

fn load_rx() -> Rx {
    Rx {
        subauth: rx(pat_subauth()),
        isubauth: rx(pat_isubauth()),
        host: rx(pat_host()),
        ipv4: rx(pat_ipv4()),
        ipv6: rx(pat_ipv6()),
        ipv6_plain: rx(pat_ipv6_plain()),
        path: rx(pat_path()),
        query: rx(pat_query()),
        scheme: rx(pat_scheme()),
        absolute: rx(pat_absolute()),
    }
}

// matcher.match(s)
fn rmatch(pr: ref Program, s: ref String) -> Option[Found] {
    let mut m = new_matcher(pr, cps(s));
    find(mut m, pr, 0, false, 1)
}

fn matches(pr: ref Program, s: ref String) -> bool {
    rmatch(pr, s).is_some()
}

fn group_of(pr: ref Program, s: ref Vec[i64], m: ref Found, name: Str) -> Option[String] {
    let want = cp(name);
    for (n, g) in pr.names.iter() {
        if same(n, want) {
            let (a, b) = m.spans[*g - 1];
            return if a < 0 { None } else { Some(to_string(slice(s, a, b))) };
        }
    }
    None
}

// ---------------------------------------------------------------- errors

fn invalid_authority(authority: ref String) -> PyErr {
    py_err("InvalidAuthority", f"The authority ({authority}) is not valid.")
}

fn invalid_port(port: ref String) -> PyErr {
    py_err("InvalidPort", f"The port (\"{port}\") is not valid.")
}

fn verb_for(n: i64) -> Str {
    if n > 1 { "were" } else { "was" }
}

fn sorted_strs(v: ref Vec[String]) -> Vec[String] {
    let mut out = v.clone();
    out.sort();
    out
}

// ---------------------------------------------------------------- Python's int()

fn decimal_value(c: i64) -> i64 {
    if c >= 48 and c <= 57 {
        return c - 48;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return c - s;
        }
    }
    -1
}

// int(s) for a str, base 10: surrounding whitespace, a sign, any
// Unicode decimal digits, and single underscores between digits.
fn py_int(c: ref Ctx, s: ref String) -> Result[i64, PyErr] {
    let bad = py_err("ValueError", f"invalid literal for int() with base 10: {c.u.repr(s)}");
    let t = cps(py_strip(s));
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == 43 or t[i] == 45) {
        neg = t[i] == 45;
        i += 1;
    }
    if i >= t.len() {
        return Err(bad);
    }
    let mut n: i64 = 0;
    let mut prev_digit = false;
    while i < t.len() {
        if t[i] == 95 {
            if not prev_digit or i + 1 >= t.len() {
                return Err(bad);
            }
            prev_digit = false;
        } else {
            let d = decimal_value(t[i]);
            if d < 0 {
                return Err(bad);
            }
            if n < 100000000000000 {
                n = n * 10 + d;
            }
            prev_digit = true;
        }
        i += 1;
    }
    if not prev_digit {
        return Err(bad);
    }
    Ok(if neg { 0 - n } else { n })
}

// ---------------------------------------------------------------- normalizers

fn is_hex_cp(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

fn count_percent_escapes(s: ref Vec[i64]) -> i64 {
    let mut n = 0;
    let mut i = 0;
    while i < s.len() {
        if s[i] == 37 and i + 2 < s.len() + 0 and is_hex_cp(s[i + 1]) and is_hex_cp(s[i + 2]) {
            n += 1;
            i += 3;
        } else {
            i += 1;
        }
    }
    n
}

// normalize_percent_characters: every "%" and two hex digits upper-cased.
fn normalize_percent(s: ref String) -> String {
    let c = cps(s);
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < c.len() {
        if c[i] == 37 and i + 2 < c.len() and is_hex_cp(c[i + 1]) and is_hex_cp(c[i + 2]) {
            out.push(37);
            out.push(upper(c[i + 1], true));
            out.push(upper(c[i + 2], true));
            i += 3;
        } else {
            out.push(c[i]);
            i += 1;
        }
    }
    to_string(out)
}

fn normalize_scheme(s: ref String) -> String {
    s.to_lowercase()
}

fn normalize_host(c: ref Ctx, host0: ref String) -> String {
    let mut host = host0.clone();
    if matches(c.rx.ipv6, host) {
        let percent = find_at(host, "%", 0);
        if percent != -1 {
            let percent_25 = find_at(host, "%25", 0);
            if percent_25 == -1 or percent < percent_25 or (percent == percent_25 and percent_25 == host.len() - 4) {
                host = f"{sub(host, 0, percent)}%25{tail(host, percent + 1)}";
            }
            return f"{sub(host, 0, percent).to_lowercase()}{tail(host, percent)}";
        }
    }
    host.to_lowercase()
}

fn normalize_authority(c: ref Ctx, userinfo: ref Option[String], host: ref Option[String], port: ref Option[String]) -> String {
    let mut out = String.new();
    if let Some(u) = userinfo {
        if u.len() > 0 {
            out.push_str(normalize_percent(u));
            out.push('@');
        }
    }
    if let Some(h) = host {
        if h.len() > 0 {
            out.push_str(normalize_host(c, h));
        }
    }
    if let Some(p) = port {
        if p.len() > 0 {
            out.push(':');
            out.push_str(p);
        }
    }
    out
}

fn remove_dot_segments(s: ref String) -> String {
    let mut output: Vec[String] = Vec.new();
    for seg in split_str(s, "/").iter() {
        if seg == "." {
            continue;
        } else if seg != ".." {
            output.push(seg.clone());
        } else if output.len() > 0 {
            output.pop();
        }
    }
    if s.starts_with("/") and (output.len() == 0 or output[0].len() > 0) {
        output.insert(0, String.new());
    }
    if s.ends_with("/.") or s.ends_with("/..") {
        output.push(String.new());
    }
    join_strs(output, "/")
}

fn normalize_path_str(s: ref String) -> String {
    if s.len() == 0 {
        return String.new();
    }
    remove_dot_segments(normalize_percent(s))
}

fn normalize_path(p: ref Option[String]) -> Option[String] {
    match p {
        Some(s) => Some(normalize_path_str(s)),
        None => None,
    }
}

// normalize_query and normalize_fragment.
fn normalize_qf(q: ref Option[String]) -> Option[String] {
    match q {
        Some(s) => Some(if s.len() == 0 { String.new() } else { normalize_percent(s) }),
        None => None,
    }
}

fn is_non_pct_encoded(b: u8) -> bool {
    if (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) {
        return true;
    }
    in_chars(b as char, ":/?#[]@!$&'()*+,;=._-~")
}

fn encode_component_str(s: ref String) -> String {
    let escapes = count_percent_escapes(cps(s));
    let bytes = bytes_of(s);
    let mut pcts = 0;
    for b in bytes.iter() {
        if *b == 37 {
            pcts += 1;
        }
    }
    let is_percent_encoded = escapes == pcts;
    let mut out = String.new();
    for b in bytes.iter() {
        if (is_percent_encoded and *b == 37) or (*b < 128 and is_non_pct_encoded(*b)) {
            out.push(*b as char);
        } else {
            out.push('%');
            out.push_str(hex2(*b as i64));
        }
    }
    out
}

fn encode_component(s: ref Option[String]) -> Option[String] {
    match s {
        Some(x) => Some(encode_component_str(x)),
        None => None,
    }
}

// urllib.parse.quote(s, safe) with the utf-8 codec.
fn quote_with(s: ref String, safe: Str) -> String {
    let mut out = String.new();
    for b in bytes_of(s).iter() {
        let x = *b;
        let keep = (x >= 48 and x <= 57) or (x >= 65 and x <= 90) or (x >= 97 and x <= 122) or in_chars(x as char, "_.-~");
        if x < 128 and (keep or in_chars(x as char, safe)) {
            out.push(x as char);
        } else {
            out.push('%');
            out.push_str(hex2(x as i64));
        }
    }
    out
}

fn quote_plus(s: ref String) -> String {
    if s.contains(" ") {
        quote_with(s, " ").replace(" ", "+")
    } else {
        quote_with(s, "")
    }
}

fn urlencode(items: ref Vec[(String, String)]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for (k, v) in items.iter() {
        parts.push(f"{quote_plus(k)}={quote_plus(v)}");
    }
    join_strs(parts, "&")
}

// urllib.parse.unquote with errors="replace".
fn unquote(s: ref String) -> String {
    if not s.contains("%") {
        return s.clone();
    }
    let b = bytes_of(s);
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        if b[i] == 37 and i + 2 < b.len() and is_hex_cp(b[i + 1] as i64) and is_hex_cp(b[i + 2] as i64) {
            out.push((hex_value(sub(s, i + 1, i + 3)) as u8));
            i += 3;
        } else {
            out.push(b[i]);
            i += 1;
        }
    }
    match utf8_decode(out, "replace") {
        Ok(t) => t,
        Err(_) => String.new(),
    }
}

fn parse_qsl(qs: ref String) -> Vec[(String, String)] {
    let mut r: Vec[(String, String)] = Vec.new();
    if qs.len() == 0 {
        return r;
    }
    for nv in split_str(qs, "&").iter() {
        if nv.len() == 0 {
            continue;
        }
        let (name, has_eq, value) = partition(nv, "=");
        if not has_eq or value.len() == 0 {
            continue;
        }
        r.push((unquote(name.replace("+", " ")), unquote(value.replace("+", " "))));
    }
    r
}

// ---------------------------------------------------------------- references

// A URIReference or an IRIReference.
#[derive(Clone)]
struct Ref {
    scheme: Option[String],
    authority: Option[String],
    path: Option[String],
    query: Option[String],
    fragment: Option[String],
    iri: bool,
}

fn or_none(s: ref Option[String]) -> Option[String] {
    match s {
        Some(x) => if x.len() == 0 { None } else { Some(x.clone()) },
        None => None,
    }
}

// URIReference(...): an empty scheme, authority or path is None.
fn new_ref(scheme: ref Option[String], authority: ref Option[String], path: ref Option[String], query: ref Option[String], fragment: ref Option[String], iri: bool) -> Ref {
    Ref { scheme: or_none(scheme), authority: or_none(authority), path: or_none(path), query: query.clone(), fragment: fragment.clone(), iri: iri }
}

fn truthy(s: ref Option[String]) -> bool {
    match s {
        Some(x) => x.len() > 0,
        None => false,
    }
}

fn some(s: ref String) -> Option[String] {
    Some(s.clone())
}

// URI_MATCHER.match(s): appendix B's
// (?:(scheme):)?(?://(authority))?(path)(?:\?(query))?(?:#(fragment))?
fn split_uri(s: ref String) -> (Option[String], Option[String], String, Option[String], Option[String]) {
    let c = cps(s);
    let n = c.len();
    let mut pos = 0;
    let mut scheme: Option[String] = None;
    if n > 0 and is_ascii_letter(c[0]) {
        let mut j = 1;
        while j < n and (is_ascii_letter(c[j]) or is_dec(c[j]) or c[j] == 43 or c[j] == 46 or c[j] == 45) {
            j += 1;
        }
        if j < n and c[j] == 58 {
            scheme = Some(to_string(slice(c, 0, j)));
            pos = j + 1;
        }
    }
    let mut authority: Option[String] = None;
    if pos + 1 < n and c[pos] == 47 and c[pos + 1] == 47 {
        let mut j = pos + 2;
        while j < n and c[j] != 92 and c[j] != 47 and c[j] != 63 and c[j] != 35 {
            j += 1;
        }
        authority = Some(to_string(slice(c, pos + 2, j)));
        pos = j;
    }
    let mut j = pos;
    while j < n and c[j] != 63 and c[j] != 35 {
        j += 1;
    }
    let path = to_string(slice(c, pos, j));
    pos = j;
    let mut query: Option[String] = None;
    if pos < n and c[pos] == 63 {
        j = pos + 1;
        while j < n and c[j] != 35 {
            j += 1;
        }
        query = Some(to_string(slice(c, pos + 1, j)));
        pos = j;
    }
    let mut fragment: Option[String] = None;
    if pos < n and c[pos] == 35 {
        j = pos + 1;
        while j < n and c[j] != 10 {
            j += 1;
        }
        fragment = Some(to_string(slice(c, pos + 1, j)));
    }
    (scheme, authority, path, query, fragment)
}

// URIReference.from_string / IRIReference.from_string.
fn ref_from(s: ref String, iri: bool) -> Ref {
    let (scheme, authority, path, query, fragment) = split_uri(s);
    new_ref(scheme, authority, Some(encode_component_str(path)), encode_component(query), encode_component(fragment), iri)
}

struct Auth {
    userinfo: Option[String],
    host: Option[String],
    port: Option[String],
}

fn no_auth() -> Auth {
    Auth { userinfo: None, host: None, port: None }
}

fn valid_ipv4_host_address(c: ref Ctx, host: ref String) -> Result[bool, PyErr] {
    let mut ok = true;
    for b in split_str(host, ".").iter() {
        let v = py_int(c, b)?;
        if v < 0 or v > 255 {
            ok = false;
        }
    }
    Ok(ok)
}

fn authority_info(c: ref Ctx, r: ref Ref) -> Result[Auth, PyErr] {
    let authority = match r.authority {
        Some(a) => if a.len() == 0 { return Ok(no_auth()) } else { a.clone() },
        None => return Ok(no_auth()),
    };
    let pr = if r.iri { ref c.rx.isubauth } else { ref c.rx.subauth };
    let s = cps(authority);
    let mut mt = new_matcher(pr, s);
    let m = match find(mut mt, pr, 0, false, 1) {
        Some(m) => m,
        None => return Err(invalid_authority(authority)),
    };
    let a = Auth {
        userinfo: group_of(pr, s, m, "userinfo"),
        host: group_of(pr, s, m, "host"),
        port: group_of(pr, s, m, "port"),
    };
    if let Some(ref h) = a.host {
        if h.len() > 0 and matches(c.rx.ipv4, h) and not valid_ipv4_host_address(c, h)? {
            return Err(invalid_authority(authority));
        }
    }
    Ok(a)
}

// The host, port and userinfo properties: None when the authority is
// not valid.
fn ref_auth(c: ref Ctx, r: ref Ref) -> Auth {
    match authority_info(c, r) {
        Ok(a) => a,
        Err(_) => no_auth(),
    }
}

fn unsplit(r: ref Ref) -> String {
    let mut out = String.new();
    if let Some(s) = r.scheme {
        if s.len() > 0 {
            out.push_str(s);
            out.push(':');
        }
    }
    if let Some(a) = r.authority {
        if a.len() > 0 {
            out.push_str("//");
            out.push_str(a);
        }
    }
    if let Some(p) = r.path {
        out.push_str(p);
    }
    if let Some(q) = r.query {
        out.push('?');
        out.push_str(q);
    }
    if let Some(f) = r.fragment {
        out.push('#');
        out.push_str(f);
    }
    out
}

fn is_absolute(c: ref Ctx, r: ref Ref) -> bool {
    matches(c.rx.absolute, unsplit(r))
}

// validators.is_valid(value, matcher, require)
fn is_valid_with(pr: ref Program, value: ref Option[String], require: bool) -> bool {
    match value {
        Some(v) => matches(pr, v),
        None => not require,
    }
}

fn host_is_valid(c: ref Ctx, host: ref Option[String], require: bool) -> Result[bool, PyErr] {
    let validated = is_valid_with(c.rx.host, host, require);
    if let Some(h) = host {
        if validated and matches(c.rx.ipv4, h) {
            return valid_ipv4_host_address(c, h);
        }
        if validated and matches(c.rx.ipv6, h) {
            return Ok(matches(c.rx.ipv6_plain, h));
        }
    }
    Ok(validated)
}

struct Require {
    scheme: bool,
    authority: bool,
    path: bool,
    query: bool,
    fragment: bool,
}

fn no_require() -> Require {
    Require { scheme: false, authority: false, path: false, query: false, fragment: false }
}

// URIMixin.is_valid
fn ref_is_valid(c: ref Ctx, r: ref Ref, q: ref Require) -> Result[bool, PyErr] {
    if not is_valid_with(c.rx.scheme, r.scheme, q.scheme) {
        return Ok(false);
    }
    let a = match authority_info(c, r) {
        Ok(a) => a,
        Err(_) => return Ok(false),
    };
    let mut ok = is_valid_with(c.rx.subauth, r.authority, q.authority);
    if ok and a.host.is_some() {
        ok = host_is_valid(c, a.host, q.authority)?;
    }
    if not ok {
        return Ok(false);
    }
    Ok(is_valid_with(c.rx.path, r.path, q.path) and is_valid_with(c.rx.query, r.query, q.query) and is_valid_with(c.rx.query, r.fragment, q.fragment))
}

fn normalize_ref(c: ref Ctx, r: ref Ref) -> Ref {
    let a = ref_auth(c, r);
    let scheme = normalize_scheme(r.scheme.clone().unwrap_or(String.new()));
    let authority = normalize_authority(c, a.userinfo, a.host, a.port);
    let path = normalize_path_str(r.path.clone().unwrap_or(String.new()));
    new_ref(Some(scheme), Some(authority), Some(path), normalize_qf(r.query), normalize_qf(r.fragment), false)
}

fn same_ref(a: ref Ref, b: ref Ref) -> bool {
    a.scheme == b.scheme and a.authority == b.authority and a.path == b.path and a.query == b.query and a.fragment == b.fragment
}

// URIReference.__eq__ / IRIReference.__eq__ against a parsed other.
fn uri_eq(c: ref Ctx, a: ref Ref, b: ref Ref) -> bool {
    if same_ref(a, b) {
        return true;
    }
    if a.iri {
        return false;
    }
    same_ref(normalize_ref(c, a), normalize_ref(c, b))
}

fn merge_paths(base: ref Ref, rel: ref String) -> String {
    if base.path.is_none() and base.authority.is_some() {
        return f"/{rel}";
    }
    let path = base.path.clone().unwrap_or(String.new());
    let head = match path.rfind("/") {
        Some(i) => sub(path, 0, i),
        // path[:-1]
        None => {
            let cs = char_vec(path);
            from_chars(cs, 0, if cs.len() > 0 { cs.len() - 1 } else { 0 })
        }
    };
    f"{head}/{rel}"
}

fn resolve_with(c: ref Ctx, r: ref Ref, base_s: ref String, strict: bool) -> Result[Ref, PyErr] {
    let base0 = ref_from(base_s, r.iri);
    let q = Require { scheme: true, authority: false, path: false, query: false, fragment: false };
    if not ref_is_valid(c, base0, q)? {
        return Err(py_err("ResolutionError", f"{unsplit(base0)} does not meet the requirements for resolution."));
    }
    let base = normalize_ref(c, base0);
    let mut resolving = r.clone();
    if not strict and resolving.scheme == base.scheme {
        resolving.scheme = None;
    }
    let mut target = resolving.clone();
    if resolving.scheme.is_some() {
        target.path = normalize_path(resolving.path);
    } else if resolving.authority.is_some() {
        target.scheme = base.scheme.clone();
        target.path = normalize_path(resolving.path);
    } else if resolving.path.is_none() {
        target.scheme = base.scheme.clone();
        target.authority = base.authority.clone();
        target.path = base.path.clone();
        target.query = if resolving.query.is_some() { resolving.query.clone() } else { base.query.clone() };
    } else {
        let p = resolving.path.clone().unwrap();
        let path = if p.starts_with("/") { normalize_path_str(p) } else { normalize_path_str(merge_paths(base, p)) };
        target.scheme = base.scheme.clone();
        target.authority = base.authority.clone();
        target.path = Some(path);
        target.query = resolving.query.clone();
    }
    Ok(target)
}

// IRIReference.encode: the host label by label through idna (IDNA 2008,
// strict, STD3 rules), the userinfo percent-encoded.
fn iri_encode(c: ref Ctx, r: ref Ref) -> Result[Ref, PyErr] {
    let mut authority = r.authority.clone();
    if truthy(r.authority) {
        let a = ref_auth(c, r);
        let mut out = String.new();
        if let Some(h) = a.host {
            if h.len() > 0 {
                let mut parts: Vec[String] = Vec.new();
                for part in split_str(h, ".").iter() {
                    let mut wide = false;
                    for ch in part.chars() {
                        if ch as i64 > 128 {
                            wide = true;
                        }
                    }
                    if wide {
                        let o = Opts { strict: true, uts46: false, std3: true, display: false };
                        match encode(cps(part.to_lowercase()), o, c.t) {
                            Ok(x) => parts.push(to_string(x)),
                            Err(_) => return Err(invalid_authority(r.authority.clone().unwrap())),
                        }
                    } else {
                        parts.push(part.clone());
                    }
                }
                out = join_strs(parts, ".");
            }
        }
        if let Some(u) = a.userinfo {
            out = f"{encode_component_str(u)}@{out}";
        }
        if let Some(p) = a.port {
            out = f"{out}:{p}";
        }
        authority = Some(out);
    }
    Ok(new_ref(r.scheme, authority, r.path, r.query, r.fragment, false))
}

fn opt_repr(c: ref Ctx, s: ref Option[String]) -> String {
    match s {
        Some(x) => c.u.repr(x),
        None => "None".to_string(),
    }
}

fn ref_repr(c: ref Ctx, r: ref Ref) -> String {
    let name = if r.iri { "IRIReference" } else { "URIReference" };
    f"{name}(scheme={opt_repr(c, r.scheme)}, authority={opt_repr(c, r.authority)}, path={opt_repr(c, r.path)}, query={opt_repr(c, r.query)}, fragment={opt_repr(c, r.fragment)})"
}

fn auth_repr(c: ref Ctx, a: ref Auth) -> String {
    f"{{'userinfo': {opt_repr(c, a.userinfo)}, 'host': {opt_repr(c, a.host)}, 'port': {opt_repr(c, a.port)}}}"
}

// ---------------------------------------------------------------- parse results

// ParseResult and ParseResultBytes. A bytes result keeps its fields as
// the str they encode from, in `enc`.
#[derive(Clone)]
struct Pres {
    scheme: Option[String],
    userinfo: Option[String],
    host: Option[String],
    port: Option[i64],
    path: Option[String],
    query: Option[String],
    fragment: Option[String],
    reference: Ref,
    bytes: bool,
    enc: String,
    lazy: bool,
}

fn new_pr(scheme: ref Option[String], userinfo: ref Option[String], host: ref Option[String], port: ref Option[i64], path: ref Option[String], query: ref Option[String], fragment: ref Option[String], reference: ref Ref, bytes: bool, enc: ref String, lazy: bool) -> Pres {
    let p = match port {
        Some(n) => if *n == 0 { None } else { Some(*n) },
        None => None,
    };
    Pres {
        scheme: or_none(scheme),
        userinfo: or_none(userinfo),
        host: host.clone(),
        port: p,
        path: or_none(path),
        query: if bytes { or_none(query) } else { query.clone() },
        fragment: if bytes { or_none(fragment) } else { fragment.clone() },
        reference: reference.clone(),
        bytes: bytes,
        enc: enc.clone(),
        lazy: lazy,
    }
}

// parseresult.split_authority
fn split_authority(a: ref String) -> Result[Auth, PyErr] {
    let mut userinfo: Option[String] = None;
    let mut host: Option[String] = None;
    let mut port: Option[String] = None;
    let mut extra_host: Option[String] = None;
    let mut rest = a.clone();
    if a.contains("@") {
        let (u, _, r) = rpartition(a, "@");
        userinfo = Some(u);
        rest = r;
    }
    if rest.starts_with("[") {
        let (h, found, r) = partition(rest, "]");
        if not found {
            return Err(value_error("not enough values to unpack (expected 2, got 1)"));
        }
        host = Some(f"{h}]");
        rest = r;
    }
    if rest.contains(":") {
        let (e, _, p) = partition(rest, ":");
        extra_host = Some(e);
        port = Some(p);
    } else if not truthy(host) and rest.len() > 0 {
        host = Some(rest.clone());
    }
    if truthy(extra_host) and not truthy(host) {
        host = extra_host;
    }
    Ok(Auth { userinfo: userinfo, host: host, port: port })
}

fn authority_from(c: ref Ctx, r: ref Ref, strict: bool) -> Result[(Option[String], Option[String], Option[i64]), PyErr] {
    let a = match authority_info(c, r) {
        Ok(a) => a,
        Err(e) => {
            if strict or e.kind != "InvalidAuthority" {
                return Err(e);
            }
            split_authority(r.authority.clone().unwrap_or(String.new()))?
        }
    };
    let mut port: Option[i64] = None;
    if let Some(p) = a.port {
        if p.len() > 0 {
            match py_int(c, p) {
                Ok(n) => port = Some(n),
                Err(_) => return Err(invalid_port(p)),
            }
        }
    }
    Ok((a.userinfo, a.host, port))
}

fn pr_from_string(c: ref Ctx, s: ref String, strict: bool, lazy: bool, bytes: bool) -> Result[Pres, PyErr] {
    let mut reference = ref_from(s, false);
    if not lazy {
        reference = normalize_ref(c, reference);
    }
    let (userinfo, host, port) = authority_from(c, reference, strict)?;
    Ok(new_pr(reference.scheme, userinfo, host, port, reference.path, reference.query, reference.fragment, reference, bytes, "utf-8".to_string(), lazy))
}

struct Parts {
    scheme: Option[String],
    userinfo: Option[String],
    host: Option[String],
    port: Option[i64],
    path: Option[String],
    query: Option[String],
    fragment: Option[String],
    lazy: bool,
}

fn pr_from_parts(c: ref Ctx, p: ref Parts, bytes: bool) -> Result[Pres, PyErr] {
    let mut authority = String.new();
    if let Some(u) = p.userinfo {
        authority.push_str(u);
        authority.push('@');
    }
    if let Some(h) = p.host {
        authority.push_str(h);
    }
    if let Some(n) = p.port {
        authority.push_str(f":{n}");
    }
    let mut uri_ref = new_ref(p.scheme, Some(authority), p.path, p.query, p.fragment, false);
    if not bytes or not p.lazy {
        uri_ref = normalize_ref(c, uri_ref);
    }
    let (userinfo, host, port) = authority_from(c, uri_ref, true)?;
    if bytes {
        return Ok(new_pr(p.scheme, userinfo, host, port, p.path, p.query, p.fragment, uri_ref, true, "utf-8".to_string(), p.lazy));
    }
    Ok(new_pr(uri_ref.scheme, userinfo, host, port, uri_ref.path, uri_ref.query, uri_ref.fragment, uri_ref, false, "utf-8".to_string(), true))
}

// str.encode(enc) for the two codecs a parse result can carry.
fn encode_as(c: ref Ctx, s: ref String, enc: ref String) -> Result[Vec[u8], PyErr] {
    if enc == "idna" {
        if s.len() == 0 {
            return Ok(Vec.new());
        }
        return match idna_encode(c.u, s) {
            Some(x) => Ok(bytes_of(x)),
            None => Err(py_err("UnicodeError", "label empty or too long".to_string())),
        };
    }
    Ok(bytes_of(s))
}

// bytes.decode(enc) of encode_as(s, enc): the identity for utf-8; for
// idna, each label through ToUnicode.
fn roundtrip(c: ref Ctx, s: ref String, enc: ref String) -> Result[String, PyErr] {
    if enc != "idna" {
        return Ok(s.clone());
    }
    let b = utf8_str(encode_as(c, s, enc)?);
    if not b.to_lowercase().contains("xn--") {
        return Ok(b);
    }
    let mut out: Vec[String] = Vec.new();
    for label in split_str(b, ".").iter() {
        if not label.to_lowercase().starts_with("xn--") {
            out.push(label.clone());
            continue;
        }
        let tail_cps = cps(tail(label, 4));
        match punycode_decode(tail_cps) {
            Some(u) => out.push(to_string(u)),
            None => return Err(py_err("UnicodeError", "Invalid character in IDN label".to_string())),
        }
    }
    Ok(join_strs(out, "."))
}

fn opt_roundtrip(c: ref Ctx, s: ref Option[String], enc: ref String) -> Result[Option[String], PyErr] {
    match s {
        Some(x) => Ok(Some(roundtrip(c, x, enc)?)),
        None => Ok(None),
    }
}

// A copy_with argument: keep the field, or set it (to None or a str).
enum CopyArg {
    Keep,
    Set(Option[String]),
}

enum PortArg {
    Keep,
    Set(Option[i64]),
}

struct PrArgs {
    scheme: CopyArg,
    userinfo: CopyArg,
    host: CopyArg,
    port: PortArg,
    path: CopyArg,
    query: CopyArg,
    fragment: CopyArg,
    lazy: bool,
}

fn pick(a: ref CopyArg, cur: ref Option[String]) -> Option[String] {
    match a {
        CopyArg.Keep => cur.clone(),
        CopyArg.Set(v) => v.clone(),
    }
}

fn pr_copy_with(c: ref Ctx, p: ref Pres, a: ref PrArgs) -> Result[Pres, PyErr] {
    let scheme = pick(a.scheme, p.scheme);
    let userinfo = pick(a.userinfo, p.userinfo);
    let host = pick(a.host, p.host);
    let port = match a.port {
        PortArg.Keep => p.port,
        PortArg.Set(v) => *v,
    };
    let path = pick(a.path, p.path);
    let query = pick(a.query, p.query);
    let fragment = pick(a.fragment, p.fragment);
    // _generate_authority
    let authority = if p.userinfo != userinfo or p.host != host or p.port != port {
        let ps: Option[String] = match port {
            Some(n) => if n == 0 { None } else { Some(f"{n}") },
            None => None,
        };
        Some(normalize_authority(c, opt_roundtrip(c, userinfo, p.enc)?, opt_roundtrip(c, host, p.enc)?, ps))
    } else if p.bytes {
        // self.authority is the reference's, encoded; then decoded as UTF-8
        match p.reference.authority {
            Some(a) => Some(utf8_str(encode_as(c, a, p.enc)?)),
            None => return Err(py_err("AttributeError", "'NoneType' object has no attribute 'encode'".to_string())),
        }
    } else {
        p.reference.authority.clone()
    };
    let mut r = p.reference.clone();
    if p.bytes {
        r.scheme = opt_roundtrip(c, scheme, p.enc)?;
        r.authority = authority;
        r.path = opt_roundtrip(c, path, p.enc)?;
        r.query = opt_roundtrip(c, query, p.enc)?;
        r.fragment = opt_roundtrip(c, fragment, p.enc)?;
        if not a.lazy {
            r = normalize_ref(c, r);
        }
    } else {
        r.scheme = scheme.clone();
        r.authority = authority;
        r.path = path.clone();
        r.query = query.clone();
        r.fragment = fragment.clone();
    }
    Ok(new_pr(scheme, userinfo, host, Some(port.unwrap_or(0)), path, query, fragment, r, p.bytes, p.enc, if p.bytes { a.lazy } else { true }))
}

fn keep_all() -> PrArgs {
    PrArgs { scheme: CopyArg.Keep, userinfo: CopyArg.Keep, host: CopyArg.Keep, port: PortArg.Keep, path: CopyArg.Keep, query: CopyArg.Keep, fragment: CopyArg.Keep, lazy: true }
}

fn pr_unsplit(c: ref Ctx, p: ref Pres, use_idna: bool) -> Result[String, PyErr] {
    let mut pr = p.clone();
    if use_idna and truthy(p.host) {
        let h = p.host.clone().unwrap();
        let mut a = keep_all();
        a.host = CopyArg.Set(Some(utf8_str(encode_as(c, h, "idna".to_string())?)));
        pr = pr_copy_with(c, pr, a)?;
    }
    if p.bytes and p.lazy {
        let mut a = keep_all();
        a.lazy = false;
        pr = pr_copy_with(c, pr, a)?;
    }
    Ok(unsplit(pr.reference))
}

fn opt_field_repr(c: ref Ctx, p: ref Pres, s: ref Option[String]) -> Result[String, PyErr] {
    match s {
        Some(x) => if p.bytes { Ok(bytes_repr(encode_as(c, x, p.enc)?)) } else { Ok(c.u.repr(x)) },
        None => Ok("None".to_string()),
    }
}

fn pr_repr(c: ref Ctx, p: ref Pres) -> Result[String, PyErr] {
    let name = if p.bytes { "ParseResultBytes" } else { "ParseResult" };
    let port = match p.port {
        Some(n) => f"{n}",
        None => "None".to_string(),
    };
    Ok(f"{name}(scheme={opt_field_repr(c, p, p.scheme)?}, userinfo={opt_field_repr(c, p, p.userinfo)?}, host={opt_field_repr(c, p, p.host)?}, port={port}, path={opt_field_repr(c, p, p.path)?}, query={opt_field_repr(c, p, p.query)?}, fragment={opt_field_repr(c, p, p.fragment)?})")
}

// ---------------------------------------------------------------- the builder

#[derive(Clone)]
struct Builder {
    scheme: Option[String],
    userinfo: Option[String],
    host: Option[String],
    port: Option[String],
    path: Option[String],
    query: Option[String],
    fragment: Option[String],
}

fn new_builder() -> Builder {
    Builder { scheme: None, userinfo: None, host: None, port: None, path: None, query: None, fragment: None }
}

fn builder_from(c: ref Ctx, s: ref String) -> Builder {
    let r = ref_from(s, false);
    let a = ref_auth(c, r);
    Builder { scheme: r.scheme, userinfo: a.userinfo, host: a.host, port: a.port, path: r.path, query: r.query, fragment: r.fragment }
}

fn str_or_none(s: ref Option[String]) -> String {
    match s {
        Some(x) => x.clone(),
        None => "None".to_string(),
    }
}

fn builder_repr(b: ref Builder) -> String {
    f"URIBuilder(scheme={str_or_none(b.scheme)}, userinfo={str_or_none(b.userinfo)}, host={str_or_none(b.host)}, port={str_or_none(b.port)}, path={str_or_none(b.path)}, query={str_or_none(b.query)}, fragment={str_or_none(b.fragment)})"
}

fn add_path(b: ref Builder, path0: ref String) -> Builder {
    let path = if path0.starts_with("/") { path0.clone() } else { f"/{path0}" };
    let mut out = b.clone();
    out.path = Some(normalize_path_str(path));
    out
}

fn extend_path(b: ref Builder, path: ref String) -> Builder {
    let existing = b.path.clone().unwrap_or(String.new());
    add_path(b, f"{strip_by(existing, "/", false, true)}/{strip_by(path, "/", true, false)}")
}

fn add_query_from(b: ref Builder, items: ref Vec[(String, String)]) -> Builder {
    let mut out = b.clone();
    out.query = normalize_qf(Some(urlencode(items)));
    out
}

fn add_port(c: ref Ctx, b: ref Builder, n: i64) -> Result[Builder, PyErr] {
    if n < 0 {
        return Err(py_err("ValueError", f"ports are not allowed to be negative. You provided {n}"));
    }
    if n > 65535 {
        return Err(py_err("ValueError", f"ports are not allowed to be larger than 65535. You provided {n}"));
    }
    let mut out = b.clone();
    out.port = Some(f"{n}");
    Ok(out)
}

fn finalize(c: ref Ctx, b: ref Builder) -> Ref {
    new_ref(b.scheme, Some(normalize_authority(c, b.userinfo, b.host, b.port)), b.path, b.query, b.fragment, false)
}

// ---------------------------------------------------------------- the validator

fn component_names() -> Vec[Str] {
    vec!["scheme", "userinfo", "host", "port", "path", "query", "fragment"]
}

fn component_index(name: ref String) -> i64 {
    let names = component_names();
    let mut i = 0;
    while i < names.len() {
        if name == names[i] {
            return i;
        }
        i += 1;
    }
    -1
}

#[derive(Clone)]
struct Validator {
    schemes: Vec[String],
    hosts: Vec[String],
    ports: Vec[String],
    allow_password: bool,
    required: Vec[bool],
    validated: Vec[bool],
}

fn new_validator() -> Validator {
    let none = vec![false, false, false, false, false, false, false];
    Validator { schemes: Vec.new(), hosts: Vec.new(), ports: Vec.new(), allow_password: true, required: none.clone(), validated: none }
}

fn set_add(v: mut ref Vec[String], s: ref String) {
    for x in v.iter() {
        if x == s {
            return;
        }
    }
    v.push(s.clone());
}

fn set_has(v: ref Vec[String], s: ref String) -> bool {
    for x in v.iter() {
        if x == s {
            return true;
        }
    }
    false
}

// The components named for check_validity_of / require_presence_of.
fn component_flags(names: ref Vec[String]) -> Result[Vec[i64], PyErr] {
    let mut idx: Vec[i64] = Vec.new();
    let mut lowered: Vec[String] = Vec.new();
    for n in names.iter() {
        lowered.push(n.to_lowercase());
    }
    for n in lowered.iter() {
        let i = component_index(n);
        if i < 0 {
            return Err(py_err("ValueError", f"\"{n}\" is not a valid component"));
        }
        idx.push(i);
    }
    Ok(idx)
}

// getattr(uri, component)
fn component_of(c: ref Ctx, r: ref Ref, i: i64) -> Option[String] {
    if i == 0 {
        r.scheme.clone()
    } else if i == 1 {
        ref_auth(c, r).userinfo
    } else if i == 2 {
        ref_auth(c, r).host
    } else if i == 3 {
        ref_auth(c, r).port
    } else if i == 4 {
        r.path.clone()
    } else if i == 5 {
        r.query.clone()
    } else {
        r.fragment.clone()
    }
}

fn subauthority_component_is_valid(c: ref Ctx, r: ref Ref, i: i64) -> Result[bool, PyErr] {
    let a = match authority_info(c, r) {
        Ok(a) => a,
        Err(_) => return Ok(false),
    };
    if i == 2 {
        return host_is_valid(c, a.host, false);
    }
    if i != 3 {
        return Ok(true);
    }
    match a.port {
        Some(p) => {
            let n = py_int(c, p)?;
            Ok(n >= 0 and n <= 65535)
        }
        None => Ok(true),
    }
}

fn names_list(c: ref Ctx, v: ref Vec[String]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for x in sorted_strs(v).iter() {
        parts.push(c.u.repr(x));
    }
    f"[{join_strs(parts, ", ")}]"
}

fn ensure_one_of(c: ref Ctx, allowed: ref Vec[String], value: ref Option[String], name: Str) -> Result[(), PyErr] {
    if let Some(v) = value {
        if allowed.len() > 0 and not set_has(allowed, v) {
            return Err(py_err("UnpermittedComponentError", f"{name} was required to be one of {names_list(c, allowed)} but was {c.u.repr(v)}"));
        }
    }
    Ok(())
}

fn validate(c: ref Ctx, v: ref Validator, r: ref Ref) -> Result[(), PyErr] {
    let names = component_names();
    if not v.allow_password {
        if let Some(u) = ref_auth(c, r).userinfo {
            if u.contains(":") {
                return Err(py_err("PasswordForbidden", f"\"{unsplit(r)}\" contained a password when validation forbade it"));
            }
        }
    }
    let mut missing: Vec[String] = Vec.new();
    let mut i = 0;
    while i < 7 {
        if v.required[i] and component_of(c, r, i).is_none() {
            missing.push(names[i].to_string());
        }
        i += 1;
    }
    if missing.len() > 0 {
        let m = sorted_strs(missing);
        return Err(py_err("MissingComponentError", f"{join_strs(m, ", ")} {verb_for(m.len())} required but missing"));
    }
    let mut invalid: Vec[String] = Vec.new();
    i = 0;
    while i < 7 {
        if v.validated[i] {
            let ok = if i >= 1 and i <= 3 {
                subauthority_component_is_valid(c, r, i)?
            } else {
                let value = component_of(c, r, i);
                let pr = if i == 0 { ref c.rx.scheme } else if i == 4 { ref c.rx.path } else { ref c.rx.query };
                is_valid_with(pr, value, false)
            };
            if not ok {
                invalid.push(names[i].to_string());
            }
        }
        i += 1;
    }
    if invalid.len() > 0 {
        let m = sorted_strs(invalid);
        return Err(py_err("InvalidComponentsError", f"{join_strs(m, ", ")} {verb_for(m.len())} found to be invalid"));
    }
    ensure_one_of(c, v.schemes, r.scheme, "scheme")?;
    ensure_one_of(c, v.hosts, ref_auth(c, r).host, "host")?;
    ensure_one_of(c, v.ports, ref_auth(c, r).port, "port")?;
    Ok(())
}

// ---------------------------------------------------------------- the jobs

// The value a job's steps work on.
enum Cur {
    Nothing,
    R(Ref),
    P(Pres),
    B(Builder),
    V(Validator),
}

fn jtext(j: ref J) -> String {
    match j {
        J.Text(s) => s.clone(),
        _ => String.new(),
    }
}

fn jopt(j: ref J) -> Option[String] {
    match j {
        J.Text(s) => Some(s.clone()),
        _ => None,
    }
}

fn jbool(j: ref J) -> bool {
    match j {
        J.Bool(b) => *b,
        _ => false,
    }
}

fn jitems(j: ref J) -> Vec[J] {
    match j {
        J.Arr(v) => v.clone(),
        _ => Vec.new(),
    }
}

fn jhas(j: ref J, key: Str) -> bool {
    if let J.Obj(items) = j {
        for (k, _) in items.iter() {
            if k == key {
                return true;
            }
        }
    }
    false
}

fn jport(j: ref J) -> Option[i64] {
    match j {
        J.Num(n) => Some(*n),
        _ => None,
    }
}

fn parts_of(o: ref J) -> Parts {
    Parts {
        scheme: jopt(jget(o, "scheme")),
        userinfo: jopt(jget(o, "userinfo")),
        host: jopt(jget(o, "host")),
        port: jport(jget(o, "port")),
        path: jopt(jget(o, "path")),
        query: jopt(jget(o, "query")),
        fragment: jopt(jget(o, "fragment")),
        lazy: if jhas(o, "lazy") { jbool(jget(o, "lazy")) } else { true },
    }
}

fn require_of(args: ref Vec[J]) -> Require {
    let mut q = no_require();
    if args.len() > 1 {
        let o = ref args[1];
        q.scheme = jbool(jget(o, "require_scheme"));
        q.authority = jbool(jget(o, "require_authority"));
        q.path = jbool(jget(o, "require_path"));
        q.query = jbool(jget(o, "require_query"));
        q.fragment = jbool(jget(o, "require_fragment"));
    }
    q
}

fn pairs_of(j: ref J) -> Vec[(String, String)] {
    let mut out: Vec[(String, String)] = Vec.new();
    for p in jitems(j).iter() {
        let kv = jitems(p);
        out.push((jtext(kv[0]), jtext(kv[1])));
    }
    out
}

fn texts_from(args: ref Vec[J], from: i64) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut i = from;
    while i < args.len() {
        out.push(jtext(args[i]));
        i += 1;
    }
    out
}

fn show_cur(c: ref Ctx, v: ref Cur) -> Result[String, PyErr] {
    match v {
        Cur.R(r) => Ok(ref_repr(c, r)),
        Cur.P(p) => pr_repr(c, p),
        Cur.B(b) => Ok(builder_repr(b)),
        Cur.V(_) => Ok("Validator()".to_string()),
        Cur.Nothing => Ok("None".to_string()),
    }
}

fn make(c: ref Ctx, op: ref String, a: ref Vec[J]) -> Result[Cur, PyErr] {
    if op == "uri" {
        return Ok(Cur.R(ref_from(jtext(a[1]), false)));
    }
    if op == "uri_b" {
        return Ok(Cur.R(ref_from(utf8_str(unhex(jtext(a[1]))), false)));
    }
    if op == "iri" {
        return Ok(Cur.R(ref_from(jtext(a[1]), true)));
    }
    if op == "urlparse" {
        return Ok(Cur.P(pr_from_string(c, jtext(a[1]), false, true, false)?));
    }
    if op == "urlparse_b" {
        return Ok(Cur.P(pr_from_string(c, utf8_str(unhex(jtext(a[1]))), false, true, false)?));
    }
    if op == "parse" or op == "parse_bytes" {
        return Ok(Cur.P(pr_from_string(c, jtext(a[1]), jbool(a[2]), jbool(a[3]), op == "parse_bytes")?));
    }
    if op == "parts" or op == "parts_bytes" {
        return Ok(Cur.P(pr_from_parts(c, parts_of(a[1]), op == "parts_bytes")?));
    }
    if op == "builder" {
        return Ok(Cur.B(new_builder()));
    }
    if op == "builder_from" {
        return Ok(Cur.B(builder_from(c, jtext(a[1]))));
    }
    Ok(Cur.V(new_validator()))
}

fn bool_text(b: bool) -> String {
    py_bool(b)
}

fn opt_int_text(n: ref Option[i64]) -> String {
    match n {
        Some(x) => f"{x}",
        None => "None".to_string(),
    }
}

fn split_repr(c: ref Ctx, a: ref Auth) -> String {
    f"({opt_repr(c, a.userinfo)}, {opt_repr(c, a.host)}, {opt_repr(c, a.port)})"
}

fn run_fn(c: ref Ctx, a: ref Vec[J]) -> Result[String, PyErr] {
    let name = jtext(a[1]);
    let s = jtext(a[2]);
    if name == "normalize_scheme" {
        return Ok(c.u.repr(normalize_scheme(s)));
    }
    if name == "normalize_authority" {
        let t = jitems(a[2]);
        return Ok(c.u.repr(normalize_authority(c, jopt(t[0]), jopt(t[1]), jopt(t[2]))));
    }
    if name == "normalize_host" {
        return Ok(c.u.repr(normalize_host(c, s)));
    }
    if name == "normalize_path" {
        return Ok(c.u.repr(normalize_path_str(s)));
    }
    if name == "remove_dot_segments" {
        return Ok(c.u.repr(remove_dot_segments(s)));
    }
    if name == "normalize_query" or name == "normalize_fragment" {
        return Ok(opt_repr(c, normalize_qf(Some(s))));
    }
    if name == "encode_component" {
        return Ok(c.u.repr(encode_component_str(s)));
    }
    if name == "normalize_username" or name == "normalize_password" {
        return Ok(c.u.repr(quote_with(s, "/")));
    }
    if name == "valid_ipv4_host_address" {
        return Ok(bool_text(valid_ipv4_host_address(c, s)?));
    }
    if name == "split_authority" {
        return Ok(split_repr(c, split_authority(s)?));
    }
    if name == "host_is_valid" {
        return Ok(bool_text(host_is_valid(c, jopt(a[2]), false)?));
    }
    if name == "is_valid_uri" {
        let q = require_of(texts_dropped(a));
        return Ok(bool_text(ref_is_valid(c, ref_from(s, false), q)?));
    }
    // normalize_uri
    Ok(c.u.repr(unsplit(normalize_ref(c, ref_from(s, false)))))
}

// The is_valid_uri step's keyword dict sits after its URI.
fn texts_dropped(a: ref Vec[J]) -> Vec[J] {
    let mut out: Vec[J] = Vec.new();
    let mut i = 2;
    while i < a.len() {
        out.push(a[i].clone());
        i += 1;
    }
    out
}

fn ref_copy_with(r: ref Ref, o: ref J) -> Ref {
    let mut out = r.clone();
    if jhas(o, "scheme") {
        out.scheme = jopt(jget(o, "scheme"));
    }
    if jhas(o, "authority") {
        out.authority = jopt(jget(o, "authority"));
    }
    if jhas(o, "path") {
        out.path = jopt(jget(o, "path"));
    }
    if jhas(o, "query") {
        out.query = jopt(jget(o, "query"));
    }
    if jhas(o, "fragment") {
        out.fragment = jopt(jget(o, "fragment"));
    }
    out
}

fn arg_of(o: ref J, key: Str) -> CopyArg {
    if jhas(o, key) { CopyArg.Set(jopt(jget(o, key))) } else { CopyArg.Keep }
}

fn pr_args(o: ref J) -> PrArgs {
    PrArgs {
        scheme: arg_of(o, "scheme"),
        userinfo: arg_of(o, "userinfo"),
        host: arg_of(o, "host"),
        port: if jhas(o, "port") { PortArg.Set(jport(jget(o, "port"))) } else { PortArg.Keep },
        path: arg_of(o, "path"),
        query: arg_of(o, "query"),
        fragment: arg_of(o, "fragment"),
        lazy: true,
    }
}

fn attr_error(kind: Str, name: ref String) -> PyErr {
    py_err("AttributeError", f"'{kind}' object has no attribute '{name}'")
}

fn ref_attr(c: ref Ctx, r: ref Ref, name: ref String) -> Result[String, PyErr] {
    let v = if name == "host" {
        ref_auth(c, r).host
    } else if name == "port" {
        ref_auth(c, r).port
    } else if name == "userinfo" {
        ref_auth(c, r).userinfo
    } else if name == "scheme" {
        r.scheme.clone()
    } else if name == "authority" {
        r.authority.clone()
    } else if name == "path" {
        r.path.clone()
    } else if name == "query" {
        r.query.clone()
    } else if name == "fragment" {
        r.fragment.clone()
    } else {
        return Err(attr_error(if r.iri { "IRIReference" } else { "URIReference" }, name));
    };
    Ok(opt_repr(c, v))
}

fn pr_attr(c: ref Ctx, p: ref Pres, name: ref String) -> Result[String, PyErr] {
    if name == "port" {
        return Ok(opt_int_text(p.port));
    }
    if name == "netloc" or name == "authority" {
        if p.bytes {
            return match p.reference.authority {
                Some(a) => Ok(bytes_repr(encode_as(c, a, p.enc)?)),
                None => Err(attr_error("NoneType", "encode".to_string())),
            };
        }
        return Ok(opt_repr(c, p.reference.authority));
    }
    let v = if name == "host" or name == "hostname" {
        p.host.clone()
    } else if name == "userinfo" {
        p.userinfo.clone()
    } else if name == "scheme" {
        p.scheme.clone()
    } else if name == "path" {
        p.path.clone()
    } else if name == "query" or name == "params" {
        p.query.clone()
    } else if name == "fragment" {
        p.fragment.clone()
    } else {
        return Err(attr_error(if p.bytes { "ParseResultBytes" } else { "ParseResult" }, name));
    };
    opt_field_repr(c, p, v)
}

// One method step: the text it prints and, when it returns a value of
// a kind the job tracks, the new current value.
fn step(c: ref Ctx, cur: ref Cur, op: ref String, a: ref Vec[J]) -> Result[(String, Cur), PyErr] {
    if op == "fn" {
        return Ok((run_fn(c, a)?, Cur.Nothing));
    }
    match cur {
        Cur.R(r) => ref_step(c, r, op, a),
        Cur.P(p) => pr_step(c, p, op, a),
        Cur.B(b) => builder_step(c, b, op, a),
        Cur.V(v) => validator_step(c, v, op, a),
        Cur.Nothing => Err(attr_error("NoneType", op)),
    }
}

fn keep() -> Cur {
    Cur.Nothing
}

fn ref_step(c: ref Ctx, r: ref Ref, op: ref String, a: ref Vec[J]) -> Result[(String, Cur), PyErr] {
    if op == "unsplit" {
        return Ok((c.u.repr(unsplit(r)), keep()));
    }
    if op == "authority_info" {
        return Ok((auth_repr(c, authority_info(c, r)?), keep()));
    }
    if op == "is_absolute" {
        return Ok((bool_text(is_absolute(c, r)), keep()));
    }
    if op == "is_valid" {
        return Ok((bool_text(ref_is_valid(c, r, require_of(a))?), keep()));
    }
    if op == "attr" {
        return Ok((ref_attr(c, r, jtext(a[1]))?, keep()));
    }
    if op == "eq" {
        return Ok((bool_text(uri_eq(c, r, ref_from(jtext(a[1]), r.iri))), keep()));
    }
    if op == "eq_tuple" {
        let t = jitems(a[1]);
        let other = new_ref(jopt(t[0]), jopt(t[1]), jopt(t[2]), jopt(t[3]), jopt(t[4]), r.iri);
        return Ok((bool_text(uri_eq(c, r, other)), keep()));
    }
    let next = if op == "normalize" {
        if r.iri {
            return Err(attr_error("IRIReference", op));
        }
        normalize_ref(c, r)
    } else if op == "resolve" {
        resolve_with(c, r, jtext(a[1]), jbool(a[2]))?
    } else if op == "copy_with" {
        ref_copy_with(r, a[1])
    } else if op == "encode_iri" {
        iri_encode(c, r)?
    } else {
        return Err(attr_error(if r.iri { "IRIReference" } else { "URIReference" }, op));
    };
    Ok((ref_repr(c, next), Cur.R(next)))
}

fn pr_step(c: ref Ctx, p: ref Pres, op: ref String, a: ref Vec[J]) -> Result[(String, Cur), PyErr] {
    if op == "unsplit" or op == "geturl" or op == "unsplit_idna" {
        let s = pr_unsplit(c, p, op == "unsplit_idna")?;
        let shown = if p.bytes { bytes_repr(encode_as(c, s, p.enc)?) } else { c.u.repr(s) };
        return Ok((shown, keep()));
    }
    if op == "attr" {
        return Ok((pr_attr(c, p, jtext(a[1]))?, keep()));
    }
    let next = if op == "copy_with" {
        pr_copy_with(c, p, pr_args(a[1]))?
    } else if op == "encode" {
        let enc = match jopt(a[1]) {
            Some(e) => e,
            None => p.enc.clone(),
        };
        let mut q = new_pr(p.scheme, p.userinfo, p.host, p.port, p.path, p.query, p.fragment, p.reference, true, enc, true);
        // the fields must encode in the new codec
        pr_repr(c, q)?;
        q
    } else {
        return Err(attr_error(if p.bytes { "ParseResultBytes" } else { "ParseResult" }, op));
    };
    Ok((pr_repr(c, next)?, Cur.P(next)))
}

fn builder_step(c: ref Ctx, b: ref Builder, op: ref String, a: ref Vec[J]) -> Result[(String, Cur), PyErr] {
    if op == "geturl" {
        return Ok((c.u.repr(unsplit(finalize(c, b))), keep()));
    }
    if op == "finalize" {
        let r = finalize(c, b);
        return Ok((ref_repr(c, r), Cur.R(r)));
    }
    let mut next = b.clone();
    if op == "add_scheme" {
        next.scheme = Some(normalize_scheme(jtext(a[1])));
    } else if op == "add_credentials" {
        let user = match jopt(a[1]) {
            Some(u) => u,
            None => return Err(value_error("Username cannot be None")),
        };
        let mut info = quote_with(user, "/");
        if let Some(pw) = jopt(a[2]) {
            info = f"{info}:{quote_with(pw, "/")}";
        }
        next.userinfo = Some(info);
    } else if op == "add_host" {
        next.host = Some(normalize_host(c, jtext(a[1])));
    } else if op == "add_port" {
        let n = match a[1] {
            J.Num(n) => n,
            _ => py_int(c, jtext(a[1]))?,
        };
        next = add_port(c, b, n)?;
    } else if op == "add_path" {
        next = add_path(b, jtext(a[1]));
    } else if op == "extend_path" {
        next = extend_path(b, jtext(a[1]));
    } else if op == "add_query_from" {
        next = add_query_from(b, pairs_of(a[1]));
    } else if op == "extend_query_with" {
        let mut items = parse_qsl(b.query.clone().unwrap_or(String.new()));
        for kv in pairs_of(a[1]).into_iter() {
            items.push(kv);
        }
        next = add_query_from(b, items);
    } else if op == "add_query" {
        next.query = normalize_qf(jopt(a[1]));
    } else if op == "add_fragment" {
        next.fragment = normalize_qf(jopt(a[1]));
    } else {
        return Err(attr_error("URIBuilder", op));
    }
    Ok((builder_repr(next), Cur.B(next)))
}

fn validator_step(c: ref Ctx, v: ref Validator, op: ref String, a: ref Vec[J]) -> Result[(String, Cur), PyErr] {
    if op == "validate" {
        validate(c, v, ref_from(jtext(a[1]), false))?;
        return Ok(("valid".to_string(), keep()));
    }
    if op == "validate_with_path" {
        let mut r = ref_from(jtext(a[1]), false);
        r.path = Some(jtext(a[2]));
        validate(c, v, r)?;
        return Ok(("valid".to_string(), keep()));
    }
    let mut next = v.clone();
    let args = texts_from(a, 1);
    if op == "allow_schemes" {
        for s in args.iter() {
            set_add(mut next.schemes, normalize_scheme(s));
        }
    } else if op == "allow_hosts" {
        for h in args.iter() {
            set_add(mut next.hosts, normalize_host(c, h));
        }
    } else if op == "allow_ports" {
        for p in args.iter() {
            let n = py_int(c, p)?;
            if n >= 0 and n <= 65535 {
                set_add(mut next.ports, p);
            }
        }
    } else if op == "allow_use_of_password" {
        next.allow_password = true;
    } else if op == "forbid_use_of_password" {
        next.allow_password = false;
    } else if op == "check_validity_of" {
        for i in component_flags(args)?.iter() {
            next.validated[*i] = true;
        }
    } else if op == "require_presence_of" {
        for i in component_flags(args)?.iter() {
            next.required[*i] = true;
        }
    } else {
        return Err(attr_error("Validator", op));
    }
    Ok(("Validator()".to_string(), Cur.V(next)))
}

fn run_jobs(c: ref Ctx, text: ref String) {
    let mut j = 0;
    for line in text.lines() {
        if line.len() == 0 {
            continue;
        }
        j += 1;
        let steps = jitems(parse_json(line.to_string()));
        let mut cur = Cur.Nothing;
        let mut k = 0;
        for st in steps.iter() {
            k += 1;
            let a = jitems(st);
            let op = jtext(a[0]);
            let label = if op == "fn" { jtext(a[1]) } else { op.clone() };
            if k == 1 and op != "fn" {
                let made = make(c, op, a);
                match made {
                    Ok(v) => {
                        match show_cur(c, v) {
                            Ok(s) => println(f"{j}.{k} {label}: {s}"),
                            Err(e) => println(f"{j}.{k} {label}: raised {e.kind}: {e.msg}"),
                        }
                        cur = v;
                    }
                    Err(e) => {
                        println(f"{j}.{k} {label}: raised {e.kind}: {e.msg}");
                        break;
                    }
                }
                continue;
            }
            match step(c, cur, op, a) {
                Ok((s, next)) => {
                    println(f"{j}.{k} {label}: {s}");
                    if let Cur.Nothing = next {
                    } else {
                        cur = next;
                    }
                }
                Err(e) => println(f"{j}.{k} {label}: raised {e.kind}: {e.msg}"),
            }
        }
    }
    println(f"== {j} jobs");
}

// ---------------------------------------------------------------- the webhook report

fn webhook_policy() -> Validator {
    let mut v = new_validator();
    v.schemes.push("https".to_string());
    v.ports.push("443".to_string());
    v.ports.push("8443".to_string());
    v.allow_password = false;
    v.required[0] = true;
    v.required[2] = true;
    let mut i = 0;
    while i < 7 {
        v.validated[i] = true;
        i += 1;
    }
    v
}

// The registered callback, absolute against the tenant's base, without
// its fragment, normalized and validated.
fn endpoint_of(c: ref Ctx, policy: ref Validator, base: ref String, cb: ref String) -> Result[Ref, PyErr] {
    let mut r = ref_from(cb, false);
    if not is_absolute(c, r) {
        r = resolve_with(c, r, base, false)?;
    }
    r.fragment = None;
    let n = normalize_ref(c, r);
    validate(c, policy, n)?;
    Ok(n)
}

struct Endpoint {
    r: Ref,
    count: i64,
}

fn webhook_report(c: ref Ctx, text: ref String) {
    let policy = webhook_policy();
    let mut tenants: Vec[String] = Vec.new();
    let mut rows: Vec[(String, String, String)] = Vec.new();
    for line in text.lines() {
        if line.len() == 0 or line.starts_with("#") {
            continue;
        }
        let f: Vec[Str] = line.split("\t").collect();
        set_add(mut tenants, f[0].to_string());
        rows.push((f[0].to_string(), f[1].to_string(), f[2].to_string()));
    }
    println("== webhooks");
    let mut accepted = 0;
    let mut rejected = 0;
    for tenant in tenants.iter() {
        println(f"tenant {tenant}");
        let mut kept: Vec[Endpoint] = Vec.new();
        for (t, base, cb) in rows.iter() {
            if t != tenant {
                continue;
            }
            let r = match endpoint_of(c, policy, base, cb) {
                Ok(r) => r,
                Err(e) => {
                    rejected += 1;
                    println(f"  reject {c.u.repr(cb)}: {e.kind}: {e.msg}");
                    continue;
                }
            };
            let mut dup = -1;
            let mut i = 0;
            while i < kept.len() {
                if uri_eq(c, kept[i].r, r) {
                    dup = i;
                    break;
                }
                i += 1;
            }
            if dup >= 0 {
                kept[dup].count += 1;
                println(f"  dup    {c.u.repr(cb)} = {unsplit(kept[dup].r)}");
                continue;
            }
            accepted += 1;
            println(f"  accept {c.u.repr(cb)} -> {unsplit(r)}");
            kept.push(Endpoint { r: r, count: 1 });
        }
        for e in kept.iter() {
            let port = ref_auth(c, e.r).port.unwrap_or("default".to_string());
            let plural = if e.count == 1 { "" } else { "s" };
            println(f"  endpoint {unsplit(e.r)} ({e.count} registration{plural}, port {port})");
        }
    }
    println(f"== {accepted} accepted, {rejected} rejected");
}

// ---------------------------------------------------------------- main

fn write_data() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        return Err(f"cannot create data: {e}");
    }
    for (name, text) in data_files().into_iter() {
        let path = f"data/{name}";
        if let Err(e) = fs.write_bytes(path.clone(), bytes_of(text)) {
            return Err(f"cannot write {path}: {e}");
        }
    }
    Ok(())
}

fn read_data(path: Str) -> Result[String, String] {
    match fs.read_to_string(path.to_string()) {
        Ok(t) => Ok(t),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

fn run() -> Result[(), String] {
    write_data()?;
    let c = Ctx {
        rx: load_rx(),
        u: load_uni(read_data("data/ucd.txt")?),
        t: load_tables(read_data("data/unicode.txt")?, String.new(), read_data("data/idnadata.txt")?),
    };
    run_jobs(c, read_data("data/jobs.jsonl")?);
    webhook_report(c, read_data("data/webhooks.tsv")?);
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"error: {e}");
    }
}

