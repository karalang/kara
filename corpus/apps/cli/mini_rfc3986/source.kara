    out.push_str("# tenant\u{9}base\u{9}callback\u{a}acme\u{9}https://api.acme.example/v1/\u{9}hooks/orders\u{a}acme\u{9}https://api.acme.example/v1/\u{9}./hooks/orders\u{a}acme\u{9}https://api.acme.example/v1/\u{9}HTTPS://API.ACME.EXAMPLE:443/v1/hooks/%6frders\u{a}acme\u{9}https://api.acme.example/v1/\u{9}../v1/hooks/refunds?since=2026-10-01\u{a}globex\u{9}https://globex.example/\u{9}https://hooks.globex.example:8443/in#ignored\u{a}globex\u{9}https://globex.example/\u{9}http://hooks.globex.ex");
    out.push_str("ample/in\u{a}globex\u{9}https://globex.example/\u{9}https://admin:hunter2@hooks.globex.example/in\u{a}globex\u{9}https://globex.example/\u{9}https://hooks.globex.example:22/in\u{a}initech\u{9}https://initech.example/app/\u{9}//cb.initech.example/tps-reports\u{a}initech\u{9}https://initech.example/app/\u{9}https://[2001:DB8::1]:8443/cb\u{a}initech\u{9}https://initech.example/app/\u{9}https://[::1%eth0]/cb\u{a}initech\u{9}https://initech.example/app/\u{9}https://300.1.1");
    out.push_str(".1/cb\u{a}umbrella\u{9}https://umbrella.example/\u{9}https://hooks.umbrella.example/☃?x=%zz\u{a}umbrella\u{9}https://umbrella.example/\u{9}https://Bücher.example/notify\u{a}umbrella\u{9}https://umbrella.example/\u{9}mailto:ops@umbrella.example\u{a}umbrella\u{9}https://umbrella.example/\u{9}https://hooks.umbrella.example:99999/\u{a}umbrella\u{9}https://umbrella.example/\u{9}https://hooks.umbrella.example/a/b/../../c/./d\u{a}hooli\u{9}https://hooli.example/x/y\u{9}?only");
