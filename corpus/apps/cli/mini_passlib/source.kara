// mini_passlib: a port of Passlib 1.7.4 (BSD; Assurance Technologies),
// the password hashing library behind Ansible's password filters, the
// Apache htpasswd tooling of many Python web stacks, and the user tables
// of Django and Flask apps migrated between hash schemes. It hashes and
// verifies passwords in some fifty formats: the Unix crypt family (DES,
// BSDi, MD5, SHA-256/512 and SHA-1 crypt), bcrypt and bcrypt-SHA256,
// scrypt, the PBKDF2 family, the LDAP, MySQL, PostgreSQL, Windows, Cisco,
// PHP and Django formats, and the disabled-account markers. On top of
// the hashes sit CryptContext, which picks a scheme, deprecates others and
// migrates old hashes on login, with per-category policies read from INI
// files, and the Apache htpasswd and htdigest file classes.
//
// Every hash is computed here, with Passlib's own pure-Python backends as
// the model (MD4, MD5, SHA-1, SHA-2, HMAC, PBKDF2, DES with Passlib's
// tables, Blowfish's expensive key schedule and Salsa20/8). data/jobs.tsv
// (see mk.py) is a list of Python statements; each is parsed and run
// against the port, and its value, warnings and exception printed the way
// oracle.py prints them for the real library. Salts come from a seeded
// generator, as oracle.py patches one in for Passlib's random source.
//
// Passlib is built from classes: `using()` derives a configured subclass
// of a hash, mixins each check their own settings, and a parsed hash is an
// instance whose constructor normalizes the checksum, salt, rounds and
// ident in the order Python's method resolution runs them. Which check
// fires first decides which error a malformed hash gets, so that order is
// kept here hash by hash.

// ------------------------------------------------------------ text helpers

fn hex_val(c: char) -> i64 {
    if c >= '0' and c <= '9' {
        c as i64 - 48
    } else if c >= 'a' and c <= 'f' {
        c as i64 - 87
    } else if c >= 'A' and c <= 'F' {
        c as i64 - 55
    } else {
        -1
    }
}

fn hex_bytes(s: ref String) -> Vec[u8] {
    let cs: Vec[char] = s.chars().collect();
    let mut bytes: Vec[u8] = Vec.new();
    let mut k = 0;
    while k + 1 < cs.len() {
        bytes.push((hex_val(cs[k]) * 16 + hex_val(cs[k + 1])) as u8);
        k += 2;
    }
    bytes
}

fn hex_string(s: ref String) -> String {
    match String.from_utf8(hex_bytes(s)) {
        Ok(t) => t,
        Err(_) => String.new(),
    }
}

fn split_on(s: ref String, sep: char) -> Vec[String] {
    let mut pieces: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            pieces.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    pieces.push(cur);
    pieces
}

// str.split(sep) with a separator of any length.
fn split_str(s: ref String, sep: Str) -> Vec[String] {
    let cs = chars(s);
    let ps: Vec[char] = sep.chars().collect();
    let mut pieces: Vec[String] = Vec.new();
    let mut cur = String.new();
    let mut i = 0;
    while i < cs.len() {
        let mut hit = i + ps.len() <= cs.len();
        let mut j = 0;
        while hit and j < ps.len() {
            if cs[i + j] != ps[j] {
                hit = false;
            }
            j += 1;
        }
        if hit {
            pieces.push(cur);
            cur = String.new();
            i += ps.len();
        } else {
            cur.push(cs[i]);
            i += 1;
        }
    }
    pieces.push(cur);
    pieces
}

fn join_strs(xs: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    let mut first = true;
    for x in xs {
        if not first {
            out.push_str(sep);
        }
        out.push_str(x);
        first = false;
    }
    out
}

fn chr(n: i64) -> char {
    match char.try_from(n) {
        Ok(c) => c,
        Err(_) => '?',
    }
}

const HEX: Str = "0123456789abcdef";

fn hex2(n: i64) -> String {
    let ds: Vec[char] = HEX.chars().collect();
    let mut out = String.new();
    out.push(ds[(n / 16) % 16]);
    out.push(ds[n % 16]);
    out
}

fn hexn(n: i64, width: i64) -> String {
    let ds: Vec[char] = HEX.chars().collect();
    let mut digits: Vec[char] = Vec.new();
    let mut m = n;
    while m > 0 {
        digits.push(ds[m % 16]);
        m = m / 16;
    }
    while digits.len() < width {
        digits.push('0');
    }
    let mut out = String.new();
    let mut i = digits.len() - 1;
    while i >= 0 {
        out.push(digits[i]);
        i -= 1;
    }
    out
}

// "%02d"
fn zpad2(n: i64) -> String {
    if n >= 0 and n < 10 {
        f"0{n}"
    } else {
        f"{n}"
    }
}

fn chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn text(v: ref Vec[char]) -> String {
    v.iter().collect()
}

fn clen(s: ref String) -> i64 {
    s.chars().count()
}

// s[lo:hi] by code points, clamped the way Python slices clamp.
fn substr(s: ref String, lo: i64, hi: i64) -> String {
    let v = chars(s);
    let mut a = lo;
    let mut b = hi;
    if a < 0 {
        a = 0;
    }
    if b > v.len() {
        b = v.len();
    }
    let mut out = String.new();
    let mut i = a;
    while i < b {
        out.push(v[i]);
        i += 1;
    }
    out
}

fn str_from(s: ref String, at: i64) -> String {
    substr(s, at, clen(s))
}

fn sub(b: ref Vec[u8], from: i64, to: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut i = from;
    let end = if to > b.len() { b.len() } else { to };
    while i < end {
        out.push(b[i]);
        i += 1;
    }
    out
}

fn cat(a: ref Vec[u8], b: ref Vec[u8]) -> Vec[u8] {
    let mut out = a.clone();
    for x in b {
        out.push(x);
    }
    out
}

fn append(out: mut ref Vec[u8], b: ref Vec[u8]) {
    for x in b {
        out.push(x);
    }
}

fn utf8_of(s: ref String) -> Vec[u8] {
    s.bytes().to_vec()
}

fn str_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn latin1_text(b: ref Vec[u8]) -> String {
    let mut out = String.new();
    for x in b {
        out.push(chr(x as i64));
    }
    out
}

fn has_char(set: Str, c: char) -> bool {
    for x in set.chars() {
        if x == c {
            return true;
        }
    }
    false
}

fn index_of_char(set: ref String, c: char) -> i64 {
    let mut i = 0;
    for x in set.chars() {
        if x == c {
            return i;
        }
        i += 1;
    }
    -1
}

fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn is_alpha(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_'
}

fn ascii_lower(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c >= 'A' and c <= 'Z' {
            out.push(chr(c as i64 + 32));
        } else {
            out.push(c);
        }
    }
    out
}

fn ascii_upper(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c >= 'a' and c <= 'z' {
            out.push(chr(c as i64 - 32));
        } else {
            out.push(c);
        }
    }
    out
}

// str.isspace, which str.strip and int() use.
fn py_space(c: char) -> bool {
    c.is_whitespace() or (c >= '\u{1c}' and c <= '\u{1f}')
}

fn py_strip(s: ref String) -> String {
    let v = chars(s);
    let mut lo = 0;
    let mut hi = v.len();
    while lo < hi and py_space(v[lo]) {
        lo += 1;
    }
    while hi > lo and py_space(v[hi - 1]) {
        hi -= 1;
    }
    substr(s, lo, hi)
}

fn py_rstrip(s: ref String) -> String {
    let v = chars(s);
    let mut hi = v.len();
    while hi > 0 and py_space(v[hi - 1]) {
        hi -= 1;
    }
    substr(s, 0, hi)
}

fn py_lstrip(s: ref String) -> String {
    let v = chars(s);
    let mut lo = 0;
    while lo < v.len() and py_space(v[lo]) {
        lo += 1;
    }
    substr(s, lo, v.len())
}

fn dirname_of(path: ref String) -> String {
    let cs: Vec[char] = path.chars().collect();
    let mut cut = 0;
    let mut i = 0;
    while i < cs.len() {
        if cs[i] == '/' {
            cut = i;
        }
        i += 1;
    }
    substr(path, 0, cut)
}

// Whether str.isprintable() holds: the controls, the C1 range, the spaces
// other than U+0020, the line and paragraph separators, the format
// characters and the private use area are not printable.
fn printable(n: i64) -> bool {
    if n < 32 or (n >= 127 and n <= 160) or n == 173 or n == 0x1680 {
        return false;
    }
    if (n >= 0x2000 and n <= 0x200F) or (n >= 0x2028 and n <= 0x202F) or (n >= 0x205F and n <= 0x2064) {
        return false;
    }
    if n == 0x3000 or n == 0xFEFF or (n >= 0xFFF9 and n <= 0xFFFB) {
        return false;
    }
    not (n >= 0xE000 and n <= 0xF8FF)
}

// repr() of a str.
fn str_repr(s: ref String) -> String {
    let q = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        let n = c as i64;
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if not printable(n) {
            if n < 256 {
                out.push_str("\\x");
                out.push_str(hex2(n));
            } else if n < 0x10000 {
                out.push_str("\\u");
                out.push_str(hexn(n, 4));
            } else {
                out.push_str("\\U");
                out.push_str(hexn(n, 8));
            }
        } else {
            out.push(c);
        }
    }
    out.push(q);
    out
}

// repr() of a bytes.
fn bytes_repr(b: ref Vec[u8]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for x in b {
        if x == b'\'' {
            has_single = true;
        }
        if x == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let mut out = String.new();
    out.push('b');
    out.push(chr(q as i64));
    for c in b {
        if c == q or c == b'\\' {
            out.push('\\');
            out.push(chr(c as i64));
        } else if c == b'\n' {
            out.push_str("\\n");
        } else if c == b'\r' {
            out.push_str("\\r");
        } else if c == b'\t' {
            out.push_str("\\t");
        } else if c < 32 or c >= 127 {
            out.push_str("\\x");
            out.push_str(hex2(c as i64));
        } else {
            out.push(chr(c as i64));
        }
    }
    out.push(chr(q as i64));
    out
}

fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    if x == f64.INFINITY {
        return "inf".to_string();
    }
    if x == -f64.INFINITY {
        return "-inf".to_string();
    }
    if x == 0.0 {
        return if x.to_bits() >> 63 == 1 { "-0.0".to_string() } else { "0.0".to_string() };
    }
    let s = f"{x}";
    if s.contains(".") or s.contains("e") {
        s
    } else {
        f"{s}.0"
    }
}

// ------------------------------------------------------------ exceptions

// A Python exception: its class name as the job output prints it, and
// str(e).
#[derive(Clone)]
struct Exc {
    cls: String,
    msg: String,
}

fn exc(cls: Str, msg: own String) -> Exc {
    Exc { cls: cls.to_string(), msg: msg }
}

fn type_error(msg: own String) -> Exc {
    exc("TypeError", msg)
}

fn value_error(msg: own String) -> Exc {
    exc("ValueError", msg)
}

// str() of a KeyError is the repr of its argument.
fn key_error(msg: ref String) -> Exc {
    exc("KeyError", str_repr(msg))
}

fn not_found(path: ref String) -> Exc {
    exc("FileNotFoundError", f"[Errno 2] No such file or directory: {str_repr(path)}")
}

// int(s), base 10.
fn py_int(s: ref String) -> Result[i64, Exc] {
    let t = py_strip(s);
    let cs = chars(t);
    let mut i = 0;
    let mut neg = false;
    if i < cs.len() and (cs[i] == '+' or cs[i] == '-') {
        neg = cs[i] == '-';
        i += 1;
    }
    let mut n: i64 = 0;
    let mut digits = 0;
    let mut ok = i < cs.len();
    while i < cs.len() {
        if is_digit(cs[i]) {
            n = n * 10 + (cs[i] as i64 - 48);
            digits += 1;
        } else if not (cs[i] == '_' and digits > 0 and i + 1 < cs.len() and is_digit(cs[i + 1])) {
            ok = false;
        }
        i += 1;
    }
    if not ok or digits == 0 {
        return Err(value_error(f"invalid literal for int() with base 10: {str_repr(s)}"));
    }
    Ok(if neg { -n } else { n })
}

// int(s, 16)
fn py_int16(s: ref String) -> Result[i64, Exc] {
    let t = py_strip(s);
    let mut n: i64 = 0;
    let mut ok = clen(t) > 0;
    for c in t.chars() {
        let d = hex_val(c);
        if d < 0 {
            ok = false;
        } else {
            n = n * 16 + d;
        }
    }
    if not ok {
        return Err(value_error(f"invalid literal for int() with base 16: {str_repr(s)}"));
    }
    Ok(n)
}

fn py_float(s: ref String) -> Option[f64] {
    let t = py_strip(s);
    if clen(t) == 0 {
        return None;
    }
    match f64.parse(t) {
        Ok(x) => Some(x),
        Err(_) => None,
    }
}

// ------------------------------------------------------------ Python values

// A Python value: the scalars, the containers, and handles on the objects
// the port keeps in its world: a hash class (Hd), a CryptContext (Ctx), an
// htpasswd or htdigest file (File), and the callables the jobs name (Fn).
// Dict keeps its keys in insertion order, as dict does.
#[derive(Clone)]
enum Val {
    Non,
    Bool(bool),
    Int(i64),
    Float(f64),
    Str(String),
    Bytes(Vec[u8]),
    List(Vec[Val]),
    Tuple(Vec[Val]),
    Dict(Vec[Val], Vec[Val]),
    Hd(i64),
    Ctx(i64),
    File(i64),
    Fn(i64),
}

fn is_none(v: ref Val) -> bool {
    match v {
        Val.Non => true,
        _ => false,
    }
}

fn is_str(v: ref Val) -> bool {
    match v {
        Val.Str(_) => true,
        _ => false,
    }
}

fn is_bytes(v: ref Val) -> bool {
    match v {
        Val.Bytes(_) => true,
        _ => false,
    }
}

fn is_text(v: ref Val) -> bool {
    is_str(v) or is_bytes(v)
}

fn is_int(v: ref Val) -> bool {
    match v {
        Val.Int(_) => true,
        Val.Bool(_) => true,
        _ => false,
    }
}

fn int_val(v: ref Val) -> i64 {
    match v {
        Val.Int(n) => n,
        Val.Bool(b) => if b { 1 } else { 0 },
        Val.Float(x) => x as i64,
        _ => 0,
    }
}

fn str_val(v: ref Val) -> String {
    match v {
        Val.Str(s) => s.clone(),
        Val.Bytes(b) => latin1_text(b),
        _ => String.new(),
    }
}

fn bytes_val(v: ref Val) -> Vec[u8] {
    match v {
        Val.Bytes(b) => b.clone(),
        Val.Str(s) => utf8_of(s),
        _ => Vec.new(),
    }
}

fn sv(s: Str) -> Val {
    Val.Str(s.to_string())
}

fn truthy(v: ref Val) -> bool {
    match v {
        Val.Non => false,
        Val.Bool(b) => b,
        Val.Int(n) => n != 0,
        Val.Float(x) => x != 0.0,
        Val.Str(s) => s.len() > 0,
        Val.Bytes(b) => b.len() > 0,
        Val.List(xs) => xs.len() > 0,
        Val.Tuple(xs) => xs.len() > 0,
        Val.Dict(ks, _) => ks.len() > 0,
        _ => true,
    }
}

// The name type(v).__name__ gives, as passlib's type_name() prints it.
fn type_name(v: ref Val) -> String {
    let s = match v {
        Val.Non => "None",
        Val.Bool(_) => "bool",
        Val.Int(_) => "int",
        Val.Float(_) => "float",
        Val.Str(_) => "str",
        Val.Bytes(_) => "bytes",
        Val.List(_) => "list",
        Val.Tuple(_) => "tuple",
        Val.Dict(_, _) => "dict",
        Val.Hd(_) => "type",
        Val.Ctx(_) => "passlib.context.CryptContext",
        Val.File(_) => "passlib.apache.HtpasswdFile",
        Val.Fn(_) => "builtin_function_or_method",
    };
    s.to_string()
}

// ExpectedTypeError: "<param> must be <expected>, not <type>".
fn expected_type(v: ref Val, expected: Str, param: Str) -> Exc {
    type_error(f"{param} must be {expected}, not {type_name(v)}")
}

fn expected_string(v: ref Val, param: Str) -> Exc {
    expected_type(v, "unicode or bytes", param)
}

fn py_eq(a: ref Val, b: ref Val) -> bool {
    match (a, b) {
        (Val.Non, Val.Non) => true,
        (Val.Str(x), Val.Str(y)) => x == y,
        (Val.Bytes(x), Val.Bytes(y)) => x == y,
        (Val.Float(x), Val.Float(y)) => x == y,
        (Val.Float(x), Val.Int(y)) => x == (y as f64),
        (Val.Int(x), Val.Float(y)) => (x as f64) == y,
        (Val.Hd(x), Val.Hd(y)) => x == y,
        (Val.List(xs), Val.List(ys)) => seq_eq(xs, ys),
        (Val.Tuple(xs), Val.Tuple(ys)) => seq_eq(xs, ys),
        _ => {
            if is_int(a) and is_int(b) {
                int_val(a) == int_val(b)
            } else {
                false
            }
        }
    }
}

fn seq_eq(xs: ref Vec[Val], ys: ref Vec[Val]) -> bool {
    if xs.len() != ys.len() {
        return false;
    }
    let mut i = 0;
    while i < xs.len() {
        if not py_eq(xs[i], ys[i]) {
            return false;
        }
        i += 1;
    }
    true
}

fn str_list(xs: ref Vec[String]) -> Vec[Val] {
    let mut out: Vec[Val] = Vec.new();
    for x in xs {
        out.push(Val.Str(x.clone()));
    }
    out
}

fn str_tuple(xs: ref Vec[String]) -> Val {
    Val.Tuple(str_list(xs))
}

fn strs(text: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    if text.len() == 0 {
        return out;
    }
    for w in split_on(text.to_string(), ' ') {
        out.push(w.clone());
    }
    out
}

fn contains_str(xs: ref Vec[String], s: ref String) -> bool {
    for x in xs {
        if x == s {
            return true;
        }
    }
    false
}

fn pos_of(xs: ref Vec[String], s: ref String) -> i64 {
    let mut i = 0;
    while i < xs.len() {
        if xs[i] == s {
            return i;
        }
        i += 1;
    }
    -1
}

fn sort_strs(xs: ref Vec[String]) -> Vec[String] {
    let mut v = xs.clone();
    let mut i = 1;
    while i < v.len() {
        let mut j = i;
        while j > 0 and v[j - 1] > v[j] {
            let t = v[j - 1].clone();
            v[j - 1] = v[j].clone();
            v[j] = t;
            j -= 1;
        }
        i += 1;
    }
    v
}
// ------------------------------------------------------------ MD5 (RFC 1321)

const MD5_S: Array[i64, 64] = [
    7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
    5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
    4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
    6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21,
];

const MD5_K: Array[u32, 64] = [
    0xd76aa478u32, 0xe8c7b756u32, 0x242070dbu32, 0xc1bdceeeu32, 0xf57c0fafu32, 0x4787c62au32, 0xa8304613u32, 0xfd469501u32,
    0x698098d8u32, 0x8b44f7afu32, 0xffff5bb1u32, 0x895cd7beu32, 0x6b901122u32, 0xfd987193u32, 0xa679438eu32, 0x49b40821u32,
    0xf61e2562u32, 0xc040b340u32, 0x265e5a51u32, 0xe9b6c7aau32, 0xd62f105du32, 0x02441453u32, 0xd8a1e681u32, 0xe7d3fbc8u32,
    0x21e1cde6u32, 0xc33707d6u32, 0xf4d50d87u32, 0x455a14edu32, 0xa9e3e905u32, 0xfcefa3f8u32, 0x676f02d9u32, 0x8d2a4c8au32,
    0xfffa3942u32, 0x8771f681u32, 0x6d9d6122u32, 0xfde5380cu32, 0xa4beea44u32, 0x4bdecfa9u32, 0xf6bb4b60u32, 0xbebfbc70u32,
    0x289b7ec6u32, 0xeaa127fau32, 0xd4ef3085u32, 0x04881d05u32, 0xd9d4d039u32, 0xe6db99e5u32, 0x1fa27cf8u32, 0xc4ac5665u32,
    0xf4292244u32, 0x432aff97u32, 0xab9423a7u32, 0xfc93a039u32, 0x655b59c3u32, 0x8f0ccc92u32, 0xffeff47du32, 0x85845dd1u32,
    0x6fa87e4fu32, 0xfe2ce6e0u32, 0xa3014314u32, 0x4e0811a1u32, 0xf7537e82u32, 0xbd3af235u32, 0x2ad7d2bbu32, 0xeb86d391u32,
];

// The message padded to whole 64- or 128-byte blocks, with its bit
// length in `lenbytes` bytes, big- or little-endian.
fn md_pad(msg: ref Vec[u8], block: i64, lenbytes: i64, big: bool) -> Vec[u8] {
    let mut m = msg.clone();
    let bits = msg.len() * 8;
    m.push(0x80);
    while m.len() % block != block - lenbytes {
        m.push(0);
    }
    for k in 0..lenbytes {
        let shift = if big { 8 * (lenbytes - 1 - k) } else { 8 * k };
        let b = if shift >= 64 { 0 } else { (bits >> shift) & 0xFF };
        m.push(b as u8);
    }
    m
}

fn le32(b: ref Vec[u8], i: i64) -> u32 {
    (b[i] as u32) | ((b[i + 1] as u32) << 8) | ((b[i + 2] as u32) << 16) | ((b[i + 3] as u32) << 24)
}

fn be32(b: ref Vec[u8], i: i64) -> u32 {
    ((b[i] as u32) << 24) | ((b[i + 1] as u32) << 16) | ((b[i + 2] as u32) << 8) | (b[i + 3] as u32)
}

fn be64(b: ref Vec[u8], i: i64) -> u64 {
    let mut v: u64 = 0;
    for k in 0..8 {
        v = (v << 8) | (b[i + k] as u64);
    }
    v
}

fn le64(b: ref Vec[u8], i: i64) -> u64 {
    let mut v: u64 = 0;
    let mut k: i64 = 7;
    while k >= 0 {
        v = (v << 8) | (b[i + k] as u64);
        k -= 1;
    }
    v
}

fn push_le32(out: mut ref Vec[u8], x: u32) {
    for k in 0..4 {
        out.push(((x >> ((8 * k) as u32)) & 0xFFu32) as u8);
    }
}

fn push_be32(out: mut ref Vec[u8], x: u32) {
    let mut k: i64 = 3;
    while k >= 0 {
        out.push(((x >> ((8 * k) as u32)) & 0xFFu32) as u8);
        k -= 1;
    }
}

fn push_be64(out: mut ref Vec[u8], x: u64) {
    let mut k: i64 = 7;
    while k >= 0 {
        out.push(((x >> ((8 * k) as u64)) & 0xFFu64) as u8);
        k -= 1;
    }
}

fn md5(msg: ref Vec[u8]) -> Vec[u8] {
    let m = md_pad(msg, 64, 8, false);
    let mut h: Vec[u32] = Vec.new();
    for x in [0x67452301u32, 0xefcdab89u32, 0x98badcfeu32, 0x10325476u32] {
        h.push(x);
    }
    let mut blk: i64 = 0;
    while blk < m.len() {
        let mut a = h[0];
        let mut b = h[1];
        let mut c = h[2];
        let mut d = h[3];
        for i in 0..64 {
            let mut f: u32 = 0;
            let mut g: i64 = 0;
            if i < 16 {
                f = (b & c) | ((b ^ 0xFFFFFFFFu32) & d);
                g = i;
            } else if i < 32 {
                f = (d & b) | ((d ^ 0xFFFFFFFFu32) & c);
                g = (5 * i + 1) % 16;
            } else if i < 48 {
                f = b ^ c ^ d;
                g = (3 * i + 5) % 16;
            } else {
                f = c ^ (b | (d ^ 0xFFFFFFFFu32));
                g = (7 * i) % 16;
            }
            let x = a.wrapping_add(f).wrapping_add(MD5_K[i]).wrapping_add(le32(m, blk + 4 * g));
            a = d;
            d = c;
            c = b;
            b = b.wrapping_add(x.rotate_left(MD5_S[i] as u32));
        }
        h[0] = h[0].wrapping_add(a);
        h[1] = h[1].wrapping_add(b);
        h[2] = h[2].wrapping_add(c);
        h[3] = h[3].wrapping_add(d);
        blk += 64;
    }
    let mut out: Vec[u8] = Vec.new();
    for x in h {
        push_le32(mut out, x);
    }
    out
}

// ------------------------------------------------------------ SHA-1 and SHA-2 (FIPS 180-4)

fn sha1(msg: ref Vec[u8]) -> Vec[u8] {
    let m = md_pad(msg, 64, 8, true);
    let mut h: Vec[u32] = Vec.new();
    for x in [0x67452301u32, 0xEFCDAB89u32, 0x98BADCFEu32, 0x10325476u32, 0xC3D2E1F0u32] {
        h.push(x);
    }
    let mut w: Vec[u32] = Vec.new();
    for _ in 0..80 {
        w.push(0u32);
    }
    let mut blk: i64 = 0;
    while blk < m.len() {
        for t in 0..16 {
            w[t] = be32(m, blk + 4 * t);
        }
        for t in 16..80 {
            w[t] = (w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16]).rotate_left(1);
        }
        let mut a = h[0];
        let mut b = h[1];
        let mut c = h[2];
        let mut d = h[3];
        let mut e = h[4];
        for t in 0..80 {
            let mut f: u32 = 0;
            let mut k: u32 = 0;
            if t < 20 {
                f = (b & c) | ((b ^ 0xFFFFFFFFu32) & d);
                k = 0x5A827999u32;
            } else if t < 40 {
                f = b ^ c ^ d;
                k = 0x6ED9EBA1u32;
            } else if t < 60 {
                f = (b & c) | (b & d) | (c & d);
                k = 0x8F1BBCDCu32;
            } else {
                f = b ^ c ^ d;
                k = 0xCA62C1D6u32;
            }
            let tmp = a.rotate_left(5).wrapping_add(f).wrapping_add(e).wrapping_add(k).wrapping_add(w[t]);
            e = d;
            d = c;
            c = b.rotate_left(30);
            b = a;
            a = tmp;
        }
        h[0] = h[0].wrapping_add(a);
        h[1] = h[1].wrapping_add(b);
        h[2] = h[2].wrapping_add(c);
        h[3] = h[3].wrapping_add(d);
        h[4] = h[4].wrapping_add(e);
        blk += 64;
    }
    let mut out: Vec[u8] = Vec.new();
    for x in h {
        push_be32(mut out, x);
    }
    out
}

const SHA256_K: Array[u32, 64] = [
