// ------------------------------------------------------------ MD4 (RFC 1320)

fn md4(msg: ref Vec[u8]) -> Vec[u8] {
    let m = md_pad(msg, 64, 8, false);
    let mut h: Vec[u32] = Vec.new();
    for x in [0x67452301u32, 0xefcdab89u32, 0x98badcfeu32, 0x10325476u32] {
        h.push(x);
    }
    let order2: Vec[i64] = [0, 4, 8, 12, 1, 5, 9, 13, 2, 6, 10, 14, 3, 7, 11, 15].to_vec();
    let order3: Vec[i64] = [0, 8, 4, 12, 2, 10, 6, 14, 1, 9, 5, 13, 3, 11, 7, 15].to_vec();
    let s1: Vec[u32] = [3u32, 7u32, 11u32, 19u32].to_vec();
    let s2: Vec[u32] = [3u32, 5u32, 9u32, 13u32].to_vec();
    let s3: Vec[u32] = [3u32, 9u32, 11u32, 15u32].to_vec();
    let mut x: Vec[u32] = Vec.new();
    for _ in 0..16 {
        x.push(0u32);
    }
    let mut blk: i64 = 0;
    while blk < m.len() {
        for t in 0..16 {
            x[t] = le32(m, blk + 4 * t);
        }
        let mut a = h[0];
        let mut b = h[1];
        let mut c = h[2];
        let mut d = h[3];
        for i in 0..16 {
            let f = (b & c) | ((b ^ 0xFFFFFFFFu32) & d);
            let t = a.wrapping_add(f).wrapping_add(x[i]).rotate_left(s1[i % 4]);
            a = d;
            d = c;
            c = b;
            b = t;
        }
        for i in 0..16 {
            let g = (b & c) | (b & d) | (c & d);
            let t = a.wrapping_add(g).wrapping_add(x[order2[i]]).wrapping_add(0x5A827999u32).rotate_left(s2[i % 4]);
            a = d;
            d = c;
            c = b;
            b = t;
        }
        for i in 0..16 {
            let hh = b ^ c ^ d;
            let t = a.wrapping_add(hh).wrapping_add(x[order3[i]]).wrapping_add(0x6ED9EBA1u32).rotate_left(s3[i % 4]);
            a = d;
            d = c;
            c = b;
            b = t;
        }
        h[0] = h[0].wrapping_add(a);
        h[1] = h[1].wrapping_add(b);
        h[2] = h[2].wrapping_add(c);
        h[3] = h[3].wrapping_add(d);
        blk += 64;
    }
    let mut out: Vec[u8] = Vec.new();
    for v in h {
        push_le32(mut out, v);
    }
    out
}

// ------------------------------------------------------------ digests by name

const D_MD5: i64 = 0;
const D_SHA1: i64 = 1;
const D_SHA256: i64 = 2;
const D_SHA512: i64 = 3;
const D_MD4: i64 = 4;

fn digest(kind: i64, msg: ref Vec[u8]) -> Vec[u8] {
    if kind == D_MD5 {
        md5(msg)
    } else if kind == D_SHA1 {
        sha1(msg)
    } else if kind == D_SHA256 {
        sha256_family(msg, false)
    } else if kind == D_SHA512 {
        sha512_family(msg, false)
    } else {
        md4(msg)
    }
}

fn digest_size(kind: i64) -> i64 {
    if kind == D_MD5 or kind == D_MD4 {
        16
    } else if kind == D_SHA1 {
        20
    } else if kind == D_SHA256 {
        32
    } else {
        64
    }
}

fn hex_of(b: ref Vec[u8]) -> String {
    let mut out = String.new();
    for x in b {
        out.push_str(hex2(x as i64));
    }
    out
}

// An HMAC key prepared once: the inner and outer padded keys.
struct Hmac {
    kind: i64,
    ipad: Vec[u8],
    opad: Vec[u8],
}

fn hmac_key(kind: i64, key: ref Vec[u8]) -> Hmac {
    let block = if kind == D_SHA512 { 128 } else { 64 };
    let mut k = if key.len() > block { digest(kind, key) } else { key.clone() };
    while k.len() < block {
        k.push(0);
    }
    let mut ipad: Vec[u8] = Vec.new();
    let mut opad: Vec[u8] = Vec.new();
    for x in k {
        ipad.push(x ^ 0x36);
        opad.push(x ^ 0x5c);
    }
    Hmac { kind: kind, ipad: ipad, opad: opad }
}

fn hmac_run(h: ref Hmac, msg: ref Vec[u8]) -> Vec[u8] {
    let inner = digest(h.kind, cat(h.ipad, msg));
    digest(h.kind, cat(h.opad, inner))
}

fn pbkdf2_hmac(kind: i64, secret: ref Vec[u8], salt: ref Vec[u8], rounds: i64, keylen: i64) -> Vec[u8] {
    let h = hmac_key(kind, secret);
    let mut out: Vec[u8] = Vec.new();
    let mut block: u32 = 1;
    while out.len() < keylen {
        let mut msg = salt.clone();
        push_be32(mut msg, block);
        let mut u = hmac_run(h, msg);
        let mut acc = u.clone();
        let mut r = 1;
        while r < rounds {
            u = hmac_run(h, u);
            let mut i = 0;
            while i < acc.len() {
                acc[i] = acc[i] ^ u[i];
                i += 1;
            }
            r += 1;
        }
        for x in acc {
            if out.len() < keylen {
                out.push(x);
            }
        }
        block += 1u32;
    }
    out
}

// ------------------------------------------------------------ base64 engines

const BASE64_CHARS: Str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
const PADDED_BASE64_CHARS: Str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=";
const HASH64_CHARS: Str = "./0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
const BCRYPT_CHARS: Str = "./ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
const HEX_CHARS: Str = "0123456789abcdefABCDEF";
const UPPER_HEX_CHARS: Str = "0123456789ABCDEF";
const LOWER_HEX_CHARS: Str = "0123456789abcdef";

// Passlib's Base64Engine over a 64-character map, little-endian (h64)
// or big-endian (h64big, bcrypt64).
struct B64 {
    map: Vec[char],
    big: bool,
}

fn engine(map: Str, big: bool) -> B64 {
    B64 { map: map.chars().collect(), big: big }
}

fn h64() -> B64 {
    engine(HASH64_CHARS, false)
}

fn h64big() -> B64 {
    engine(HASH64_CHARS, true)
}

fn bcrypt64() -> B64 {
    engine(BCRYPT_CHARS, true)
}

fn b64_index(e: ref B64, c: char) -> i64 {
    let mut i = 0;
    while i < 64 {
        if e.map[i] == c {
            return i;
        }
        i += 1;
    }
    -1
}

fn encode_bytes(e: ref B64, src: ref Vec[u8]) -> String {
    let mut out = String.new();
    let chunks = src.len() / 3;
    let tail = src.len() % 3;
    let mut i = 0;
    let mut idx = 0;
    while idx < chunks {
        let v1 = src[i] as i64;
        let v2 = src[i + 1] as i64;
        let v3 = src[i + 2] as i64;
        if e.big {
            out.push(e.map[v1 >> 2]);
            out.push(e.map[((v1 & 3) << 4) | (v2 >> 4)]);
            out.push(e.map[((v2 & 15) << 2) | (v3 >> 6)]);
            out.push(e.map[v3 & 63]);
        } else {
            out.push(e.map[v1 & 63]);
            out.push(e.map[((v2 & 15) << 2) | (v1 >> 6)]);
            out.push(e.map[((v3 & 3) << 4) | (v2 >> 4)]);
            out.push(e.map[v3 >> 2]);
        }
        i += 3;
        idx += 1;
    }
    if tail > 0 {
        let v1 = src[i] as i64;
        if tail == 1 {
            if e.big {
                out.push(e.map[v1 >> 2]);
                out.push(e.map[(v1 & 3) << 4]);
            } else {
                out.push(e.map[v1 & 63]);
                out.push(e.map[v1 >> 6]);
            }
        } else {
            let v2 = src[i + 1] as i64;
            if e.big {
                out.push(e.map[v1 >> 2]);
                out.push(e.map[((v1 & 3) << 4) | (v2 >> 4)]);
                out.push(e.map[(v2 & 15) << 2]);
            } else {
                out.push(e.map[v1 & 63]);
                out.push(e.map[((v2 & 15) << 2) | (v1 >> 6)]);
                out.push(e.map[v2 >> 4]);
            }
        }
    }
    out
}

fn decode_values(e: ref B64, src: ref String) -> Result[Vec[i64], Exc] {
    let mut vs: Vec[i64] = Vec.new();
    for c in src.chars() {
        let v = b64_index(e, c);
        if v < 0 {
            return Err(value_error(f"invalid character: {c as i64}"));
        }
        vs.push(v);
    }
    Ok(vs)
}

fn decode_bytes(e: ref B64, src: ref String) -> Result[Vec[u8], Exc] {
    let n = clen(src);
    let chunks = n / 4;
    let tail = n % 4;
    if tail == 1 {
        return Err(value_error("input string length cannot be == 1 mod 4".to_string()));
    }
    let vs = decode_values(e, src)?;
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    let mut idx = 0;
    while idx < chunks {
        let v1 = vs[i];
        let v2 = vs[i + 1];
        let v3 = vs[i + 2];
        let v4 = vs[i + 3];
        if e.big {
            out.push(((v1 << 2) | (v2 >> 4)) as u8);
            out.push((((v2 & 15) << 4) | (v3 >> 2)) as u8);
            out.push((((v3 & 3) << 6) | v4) as u8);
        } else {
            out.push((v1 | ((v2 & 3) << 6)) as u8);
            out.push(((v2 >> 2) | ((v3 & 15) << 4)) as u8);
            out.push(((v3 >> 4) | (v4 << 2)) as u8);
        }
        i += 4;
        idx += 1;
    }
    if tail > 0 {
        let v1 = vs[i];
        let v2 = vs[i + 1];
        if e.big {
            out.push((((v1 << 2) | (v2 >> 4)) & 255) as u8);
        } else {
            out.push(((v1 | ((v2 & 3) << 6)) & 255) as u8);
        }
        if tail == 3 {
            let v3 = vs[i + 2];
            if e.big {
                out.push(((((v2 & 15) << 4) | (v3 >> 2)) & 255) as u8);
            } else {
                out.push((((v2 >> 2) | ((v3 & 15) << 4)) & 255) as u8);
            }
        }
    }
    Ok(out)
}

fn encode_transposed(e: ref B64, src: ref Vec[u8], offsets: ref Vec[i64]) -> String {
    let mut tmp: Vec[u8] = Vec.new();
    for off in offsets {
        tmp.push(src[off]);
    }
    encode_bytes(e, tmp)
}

fn encode_int(e: ref B64, value: u64, bits0: i64) -> String {
    let pad = (6 - bits0 % 6) % 6;
    let bits = bits0 + pad;
    let mut out = String.new();
    if e.big {
        let mut off = bits - 6;
        while off > -6 {
            let at = off - pad;
            let six = if at >= 0 { (value >> (at as u64)) & 63u64 } else { (value << ((0 - at) as u64)) & 63u64 };
            out.push(e.map[six as i64]);
            off -= 6;
        }
    } else {
        let mut off = 0;
        while off < bits {
            out.push(e.map[((value >> (off as u64)) & 63u64) as i64]);
            off += 6;
        }
    }
    out
}

fn encode_int6(e: ref B64, v: i64) -> String {
    let mut out = String.new();
    out.push(e.map[v]);
    out
}

fn encode_int24(e: ref B64, value: i64) -> String {
    let raw: Vec[i64] = [value & 63, (value >> 6) & 63, (value >> 12) & 63, (value >> 18) & 63].to_vec();
    let mut out = String.new();
    if e.big {
        let mut i = 3;
        while i >= 0 {
            out.push(e.map[raw[i]]);
            i -= 1;
        }
    } else {
        for v in raw {
            out.push(e.map[v]);
        }
    }
    out
}

fn decode_small(e: ref B64, src: ref String) -> Result[i64, Exc] {
    let vs = match decode_values(e, src) {
        Ok(v) => v,
        Err(_) => {
            return Err(value_error("invalid character".to_string()));
        }
    };
    let mut out = 0;
    if e.big {
        for v in vs {
            out = (out << 6) + v;
        }
    } else {
        let mut i = vs.len() - 1;
        while i >= 0 {
            out = (out << 6) + vs[i];
            i -= 1;
        }
    }
    Ok(out)
}

// Base64Engine._decode_int: a fixed-width integer.
fn decode_int(e: ref B64, src: ref String, bits: i64) -> Result[i64, Exc] {
    let pad = (6 - bits % 6) % 6;
    let n = (bits + pad) / 6;
    if clen(src) != n {
        return Err(value_error(f"source must be {n} chars"));
    }
    let mut out: i64 = 0;
    let cs = chars(src);
    let mut k = 0;
    while k < n {
        let c = if e.big { cs[k] } else { cs[n - 1 - k] };
        let v = b64_index(e, c);
        if v < 0 {
            return Err(value_error(f"invalid character in string: {str_repr(c.to_string())}"));
        }
        out = (out << 6) + v;
        k += 1;
    }
    if pad > 0 {
        if e.big {
            out = out >> pad;
        } else {
            out = out & ((1 << bits) - 1);
        }
    }
    Ok(out)
}

// check_repair_unused: whether the last character's unused bits were
// set, and the string with them cleared.
fn check_repair_unused(e: ref B64, src: ref String) -> Result[(bool, String), Exc] {
    let n = clen(src);
    let tail = n % 4;
    if tail == 0 {
        return Ok((false, src.clone()));
    }
    if tail == 1 {
        return Err(value_error("source length must != 1 mod 4".to_string()));
    }
    let bits = if tail == 2 {
        if e.big { 15 } else { 15 << 2 }
    } else {
        if e.big { 3 } else { 3 << 4 }
    };
    let cs = chars(src);
    let last = cs[n - 1];
    let idx = b64_index(e, last);
    if idx >= 0 and (idx & bits) == 0 {
        return Ok((false, src.clone()));
    }
    let fixed = e.map[idx & (bits ^ 63)];
    let mut out = substr(src, 0, n - 1);
    out.push(fixed);
    Ok((true, out))
}

// base64.b64encode, with optional altchars for '+' and '/'.
fn b64encode_alt(b: ref Vec[u8], alt: Str) -> String {
    let mut map: Vec[char] = BASE64_CHARS.chars().collect();
    let a: Vec[char] = alt.chars().collect();
    if a.len() == 2 {
        map[62] = a[0];
        map[63] = a[1];
    }
    let mut out = String.new();
    let mut i = 0;
    while i + 2 < b.len() {
        let n = ((b[i] as i64) << 16) | ((b[i + 1] as i64) << 8) | (b[i + 2] as i64);
        out.push(map[(n >> 18) & 63]);
        out.push(map[(n >> 12) & 63]);
        out.push(map[(n >> 6) & 63]);
        out.push(map[n & 63]);
        i += 3;
    }
    let rest = b.len() - i;
    if rest == 1 {
        let n = (b[i] as i64) << 16;
        out.push(map[(n >> 18) & 63]);
        out.push(map[(n >> 12) & 63]);
        out.push_str("==");
    } else if rest == 2 {
        let n = ((b[i] as i64) << 16) | ((b[i + 1] as i64) << 8);
        out.push(map[(n >> 18) & 63]);
        out.push(map[(n >> 12) & 63]);
        out.push(map[(n >> 6) & 63]);
        out.push('=');
    }
    out
}

fn b64encode(b: ref Vec[u8]) -> String {
    b64encode_alt(b, "")
}

fn std_b64_value(c: u8) -> i64 {
    if c >= b'A' and c <= b'Z' {
        (c - b'A') as i64
    } else if c >= b'a' and c <= b'z' {
        (c - b'a') as i64 + 26
    } else if c >= b'0' and c <= b'9' {
        (c - b'0') as i64 + 52
    } else if c == b'+' {
        62
    } else if c == b'/' {
        63
    } else {
        -1
    }
}

// binascii.a2b_base64 in its default, non-strict mode: characters outside
// the alphabet are skipped and a complete pad sequence ends the input.
// Its errors come out as binascii.Error, which the job output prints as
// "Error".
fn a2b_base64(data: ref Vec[u8]) -> Result[Vec[u8], Exc] {
    let mut out: Vec[u8] = Vec.new();
    let mut quad = 0;
    let mut left: i64 = 0;
    let mut pads = 0;
    let mut i = 0;
    while i < data.len() {
        let c = data[i];
        i += 1;
        if c == b'=' {
            if quad >= 2 {
                pads += 1;
                if quad + pads >= 4 {
                    return Ok(out);
                }
            }
            continue;
        }
        let v = std_b64_value(c);
        if v < 0 {
            continue;
        }
        pads = 0;
        if quad == 0 {
            quad = 1;
            left = v;
        } else if quad == 1 {
            quad = 2;
            out.push((((left << 2) | (v >> 4)) & 255) as u8);
            left = v & 15;
        } else if quad == 2 {
            quad = 3;
            out.push((((left << 4) | (v >> 2)) & 255) as u8);
            left = v & 3;
        } else {
            quad = 0;
            out.push((((left << 6) | v) & 255) as u8);
            left = 0;
        }
    }
    if quad != 0 {
        if quad == 1 {
            let n = out.len() / 3 * 4 + 1;
            return Err(exc("Error", f"Invalid base64-encoded string: number of data characters ({n}) cannot be 1 more than a multiple of 4"));
        }
        return Err(exc("Error", "Incorrect padding".to_string()));
    }
    Ok(out)
}

// base64.b64decode(s, altchars), not validating.
fn b64decode_alt(s: ref String, alt: Str) -> Result[Vec[u8], Exc] {
    let a: Vec[char] = alt.chars().collect();
    let mut data: Vec[u8] = Vec.new();
    for c in s.chars() {
        if a.len() == 2 and c == a[0] {
            data.push(b'+');
        } else if a.len() == 2 and c == a[1] {
            data.push(b'/');
        } else {
            data.push(c as u32 as u8);
        }
    }
    a2b_base64(data)
}

fn b64decode(s: ref String) -> Result[Vec[u8], Exc] {
    b64decode_alt(s, "")
}

// b64s_encode: base64 without padding.
fn b64s_encode(b: ref Vec[u8]) -> String {
    let s = b64encode(b);
    let mut out = String.new();
    for c in s.chars() {
        if c != '=' {
            out.push(c);
        }
    }
    out
}

fn b64s_decode(s: ref String) -> Result[Vec[u8], Exc] {
    let mut data: Vec[u8] = Vec.new();
    for c in s.chars() {
        if c as i64 > 127 {
            return Err(value_error("string argument should contain only ASCII characters".to_string()));
        }
        data.push(c as u32 as u8);
    }
    let off = data.len() & 3;
    if off == 2 {
        data.push(b'=');
        data.push(b'=');
    } else if off == 3 {
        data.push(b'=');
    } else if off == 1 {
        return Err(value_error("invalid base64 input".to_string()));
    }
    match a2b_base64(data) {
        Ok(b) => Ok(b),
        Err(e) => Err(type_error(e.msg)),
    }
}

fn ab64_encode(b: ref Vec[u8]) -> String {
    let mut out = String.new();
    for c in b64s_encode(b).chars() {
        out.push(if c == '+' { '.' } else { c });
    }
    out
}

fn ab64_decode(s: ref String) -> Result[Vec[u8], Exc] {
    let mut t = String.new();
    for c in s.chars() {
        t.push(if c == '.' { '+' } else { c });
    }
    b64s_decode(t)
}

// binascii.unhexlify
fn unhexlify(s: ref String) -> Result[Vec[u8], Exc] {
    let cs = chars(s);
    if cs.len() % 2 == 1 {
        return Err(exc("Error", "Odd-length string".to_string()));
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < cs.len() {
        let a = hex_val(cs[i]);
        let b = hex_val(cs[i + 1]);
        if a < 0 or b < 0 {
            return Err(exc("Error", "Non-hexadecimal digit found".to_string()));
        }
        out.push((a * 16 + b) as u8);
        i += 2;
    }
    Ok(out)
}

// ------------------------------------------------------------ DES

// Passlib's DES: the key schedule and rounds run on 64-bit integers
// through precomputed permutation tables (passlib.crypto.des builds them
// at import; gen_tables.py printed them into the consts below).
struct DesT {
    pcxrot: Vec[u64],
    ie3264: Vec[u64],
    cf6464: Vec[u64],
    spe: Vec[u64],
}

fn des_tables() -> DesT {
    let mut pc: Vec[u64] = Vec.new();
    for x in DES_PCXROT {
        pc.push(x);
    }
    let mut ie: Vec[u64] = Vec.new();
    for x in DES_IE3264 {
        ie.push(x);
    }
    let mut cf: Vec[u64] = Vec.new();
    for x in DES_CF6464 {
        cf.push(x);
    }
    let mut spe: Vec[u64] = Vec.new();
    for x in DES_SPE {
        spe.push(x);
    }
    DesT { pcxrot: pc, ie3264: ie, cf6464: cf, spe: spe }
}

// _permute: OR together one table entry per 4-bit group of c.
fn permute(t: ref Vec[u64], base: i64, n: i64, c0: u64) -> u64 {
    let mut out: u64 = 0;
    let mut c = c0;
    let mut r = 0;
    while r < n {
        out = out | t[base + r * 16 + (c & 15u64) as i64];
        c = c >> 4u64;
        r += 1;
    }
    out
}

const KS_MASK: u64 = 0xfcfcfcfcffffffffu64;

fn spe_mix(t: ref DesT, b: u64) -> u64 {
    t.spe[((b >> 58u64) & 63u64) as i64] ^ t.spe[64 + ((b >> 50u64) & 63u64) as i64] ^ t.spe[128 + ((b >> 42u64) & 63u64) as i64] ^ t.spe[192 + ((b >> 34u64) & 63u64) as i64] ^ t.spe[256 + ((b >> 26u64) & 63u64) as i64] ^ t.spe[320 + ((b >> 18u64) & 63u64) as i64] ^ t.spe[384 + ((b >> 10u64) & 63u64) as i64] ^ t.spe[448 + ((b >> 2u64) & 63u64) as i64]
}

fn des_encrypt_int_block(t: ref DesT, key: u64, input: u64, salt0: i64, rounds0: i64) -> u64 {
    let mut ks: Vec[u64] = Vec.new();
    let mut ks_odd = key;
    let mut pair = 0;
    while pair < 8 {
        let ks_even = permute(t.pcxrot, pair * 512, 16, ks_odd);
        ks_odd = permute(t.pcxrot, pair * 512 + 256, 16, ks_even);
        ks.push(ks_even & KS_MASK);
        ks.push(ks_odd & KS_MASK);
        pair += 1;
    }
    let s = salt0 as u64;
    let salt = ((s & 0x3fu64) << 26u64) | ((s & 0xfc0u64) << 12u64) | ((s & 0x3f000u64) >> 2u64) | ((s & 0xfc0000u64) >> 16u64);
    let mut l: u64 = 0;
    let mut r: u64 = 0;
    if input != 0u64 {
        l = ((input >> 31u64) & 0xaaaaaaaau64) | (input & 0x55555555u64);
        l = permute(t.ie3264, 0, 8, l);
        r = ((input >> 32u64) & 0xaaaaaaaau64) | ((input >> 1u64) & 0x55555555u64);
        r = permute(t.ie3264, 0, 8, r);
    }
    let mut rounds = rounds0;
    while rounds > 0 {
        rounds -= 1;
        let mut i = 0;
        while i < 16 {
            let k = ((r >> 32u64) ^ r) & salt;
            let b = (k << 32u64) ^ k ^ r ^ ks[i];
            l = l ^ spe_mix(t, b);
            let k2 = ((l >> 32u64) ^ l) & salt;
            let b2 = (k2 << 32u64) ^ k2 ^ l ^ ks[i + 1];
            r = r ^ spe_mix(t, b2);
            i += 2;
        }
        let tmp = l;
        l = r;
        r = tmp;
    }
    let c = ((l >> 3u64) & 0x0f0f0f0f00000000u64) | ((l << 33u64) & 0xf0f0f0f000000000u64) | ((r >> 35u64) & 0x000000000f0f0f0fu64) | ((r << 1u64) & 0x00000000f0f0f0f0u64);
    permute(t.cf6464, 0, 16, c)
}

fn crypt_secret_to_key(secret: ref Vec[u8], from: i64) -> u64 {
    let mut key: u64 = 0;
    let mut i = 0;
    while i < 8 and from + i < secret.len() {
        key = key | (((secret[from + i] & 0x7f) as u64) << ((57 - i * 8) as u64));
        i += 1;
    }
    key
}

fn be_u64(b: ref Vec[u8]) -> u64 {
    let mut v: u64 = 0;
    for x in b {
        v = (v << 8u64) | (x as u64);
    }
    v
}

fn u64_be(v: u64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    push_be64(mut out, v);
    out
}

// des_encrypt_block with a 7-byte key, expanded to 8 with parity bits.
fn des_encrypt_block7(t: ref DesT, key7: ref Vec[u8], input: ref Vec[u8]) -> Vec[u8] {
    let k56 = be_u64(key7);
    let mut kb: Vec[u8] = Vec.new();
    let mut shift: i64 = 49;
    while shift >= 0 {
        kb.push((((k56 >> (shift as u64)) & 0x7fu64) << 1u64) as u8);
        shift -= 7;
    }
    u64_be(des_encrypt_int_block(t, be_u64(kb), be_u64(input), 0, 1))
}

// ------------------------------------------------------------ Blowfish (bcrypt)

struct Bf {
    p: Vec[u32],
    s: Vec[u32],
}

fn bf_new() -> Bf {
    let mut p: Vec[u32] = Vec.new();
    for x in BF_P {
        p.push(x);
    }
    let mut s: Vec[u32] = Vec.new();
    for x in BF_S {
        s.push(x);
    }
    Bf { p: p, s: s }
}

fn bf_encipher(bf: ref Bf, l0: u32, r0: u32) -> (u32, u32) {
    let mut l = l0 ^ bf.p[0];
    let mut r = r0;
    let mut i: i64 = 1;
    while i < 17 {
        let f = ((bf.s[(l >> 24u32) as i64].wrapping_add(bf.s[256 + ((l >> 16u32) & 0xffu32) as i64])) ^ bf.s[512 + ((l >> 8u32) & 0xffu32) as i64]).wrapping_add(bf.s[768 + (l & 0xffu32) as i64]);
        let t = f ^ bf.p[i] ^ r;
        r = l;
        l = t;
        i += 1;
    }
    (r ^ bf.p[17], l)
}

fn bf_expand(bf: mut ref Bf, key: ref Vec[u32]) {
    let mut i: i64 = 0;
    while i < 18 {
        bf.p[i] = bf.p[i] ^ key[i];
        i += 1;
    }
    let mut l: u32 = 0;
    let mut r: u32 = 0;
    i = 0;
    while i < 18 {
        let (a, b) = bf_encipher(bf, l, r);
        l = a;
        r = b;
        bf.p[i] = l;
        bf.p[i + 1] = r;
        i += 2;
    }
    i = 0;
    while i < 1024 {
        let (a, b) = bf_encipher(bf, l, r);
        l = a;
        r = b;
        bf.s[i] = l;
        bf.s[i + 1] = r;
        i += 2;
    }
}

fn bf_salted_expand(bf: mut ref Bf, key: ref Vec[u32], salt: ref Vec[u32]) {
    let mut i: i64 = 0;
    while i < 18 {
        bf.p[i] = bf.p[i] ^ key[i];
        i += 1;
    }
    let n = salt.len();
    let mut s = 0;
    let mut l: u32 = 0;
    let mut r: u32 = 0;
    i = 0;
    while i < 18 {
        l = l ^ salt[s];
        r = r ^ salt[s + 1];
        s += 2;
        if s == n {
            s = 0;
        }
        let (a, b) = bf_encipher(bf, l, r);
        l = a;
        r = b;
        bf.p[i] = l;
        bf.p[i + 1] = r;
        i += 2;
    }
    i = 0;
    while i < 1024 {
        l = l ^ salt[s];
        r = r ^ salt[s + 1];
        s += 2;
        if s == n {
            s = 0;
        }
        let (a, b) = bf_encipher(bf, l, r);
        l = a;
        r = b;
        bf.s[i] = l;
        bf.s[i + 1] = r;
        i += 2;
    }
}

fn key_to_words(data: ref Vec[u8]) -> Vec[u32] {
    let mut out: Vec[u32] = Vec.new();
    if data.len() == 0 {
        for _ in 0..18 {
            out.push(0u32);
        }
        return out;
    }
    let mut rep: Vec[u8] = Vec.new();
    while rep.len() < 72 {
        rep.push(data[rep.len() % data.len()]);
    }
    let mut i = 0;
    while i < 72 {
        out.push(be32(rep, i));
        i += 4;
    }
    out
}

// passlib.crypto._blowfish.raw_bcrypt
fn raw_bcrypt(password0: ref Vec[u8], ident: ref String, salt_text: ref String, log_rounds: i64) -> Result[String, Exc] {
    let mut password = password0.clone();
    if ident == "2x" {
        return Err(value_error("crypt_blowfish's buggy '2x' hashes are not currently supported".to_string()));
    }
    if ident != "2" {
        password.push(0);
    }
    let e = bcrypt64();
    let mut salt = decode_bytes(e, salt_text)?;
    if salt.len() < 16 {
        return Err(value_error("Missing salt bytes".to_string()));
    }
    salt = sub(salt, 0, 16);
    let mut bf = bf_new();
    let pass_words = key_to_words(password);
    let salt_words = key_to_words(salt);
    let salt4 = sub_u32(salt_words, 0, 4);
    bf_salted_expand(mut bf, pass_words, salt4);
    let rounds: i64 = 1 << log_rounds;
    let mut n = 0;
    while n < rounds {
        bf_expand(mut bf, pass_words);
        bf_expand(mut bf, salt_words);
        n += 1;
    }
    let mut data: Vec[u32] = [0x4f727068u32, 0x65616e42u32, 0x65686f6cu32, 0x64657253u32, 0x63727944u32, 0x6f756274u32].to_vec();
    let mut i = 0;
    while i < 6 {
        let mut l = data[i];
        let mut r = data[i + 1];
        let mut k = 0;
        while k < 64 {
            let (a, b) = bf_encipher(bf, l, r);
            l = a;
            r = b;
            k += 1;
        }
        data[i] = l;
        data[i + 1] = r;
        i += 2;
    }
    let mut raw: Vec[u8] = Vec.new();
    for w in data {
        push_be32(mut raw, w);
    }
    Ok(encode_bytes(e, sub(raw, 0, 23)))
}

fn sub_u32(v: ref Vec[u32], from: i64, to: i64) -> Vec[u32] {
    let mut out: Vec[u32] = Vec.new();
    let mut i = from;
    while i < to {
        out.push(v[i]);
        i += 1;
    }
    out
}

// ------------------------------------------------------------ scrypt

fn salsa20_8(b: mut ref Vec[u32]) {
    let mut x = b.clone();
    let mut i = 0;
    while i < 4 {
        x[4] = x[4] ^ x[0].wrapping_add(x[12]).rotate_left(7u32);
        x[8] = x[8] ^ x[4].wrapping_add(x[0]).rotate_left(9u32);
        x[12] = x[12] ^ x[8].wrapping_add(x[4]).rotate_left(13u32);
        x[0] = x[0] ^ x[12].wrapping_add(x[8]).rotate_left(18u32);
        x[9] = x[9] ^ x[5].wrapping_add(x[1]).rotate_left(7u32);
        x[13] = x[13] ^ x[9].wrapping_add(x[5]).rotate_left(9u32);
        x[1] = x[1] ^ x[13].wrapping_add(x[9]).rotate_left(13u32);
        x[5] = x[5] ^ x[1].wrapping_add(x[13]).rotate_left(18u32);
        x[14] = x[14] ^ x[10].wrapping_add(x[6]).rotate_left(7u32);
        x[2] = x[2] ^ x[14].wrapping_add(x[10]).rotate_left(9u32);
        x[6] = x[6] ^ x[2].wrapping_add(x[14]).rotate_left(13u32);
        x[10] = x[10] ^ x[6].wrapping_add(x[2]).rotate_left(18u32);
        x[3] = x[3] ^ x[15].wrapping_add(x[11]).rotate_left(7u32);
        x[7] = x[7] ^ x[3].wrapping_add(x[15]).rotate_left(9u32);
        x[11] = x[11] ^ x[7].wrapping_add(x[3]).rotate_left(13u32);
        x[15] = x[15] ^ x[11].wrapping_add(x[7]).rotate_left(18u32);
        x[1] = x[1] ^ x[0].wrapping_add(x[3]).rotate_left(7u32);
        x[2] = x[2] ^ x[1].wrapping_add(x[0]).rotate_left(9u32);
        x[3] = x[3] ^ x[2].wrapping_add(x[1]).rotate_left(13u32);
        x[0] = x[0] ^ x[3].wrapping_add(x[2]).rotate_left(18u32);
        x[6] = x[6] ^ x[5].wrapping_add(x[4]).rotate_left(7u32);
        x[7] = x[7] ^ x[6].wrapping_add(x[5]).rotate_left(9u32);
        x[4] = x[4] ^ x[7].wrapping_add(x[6]).rotate_left(13u32);
        x[5] = x[5] ^ x[4].wrapping_add(x[7]).rotate_left(18u32);
        x[11] = x[11] ^ x[10].wrapping_add(x[9]).rotate_left(7u32);
        x[8] = x[8] ^ x[11].wrapping_add(x[10]).rotate_left(9u32);
        x[9] = x[9] ^ x[8].wrapping_add(x[11]).rotate_left(13u32);
        x[10] = x[10] ^ x[9].wrapping_add(x[8]).rotate_left(18u32);
        x[12] = x[12] ^ x[15].wrapping_add(x[14]).rotate_left(7u32);
        x[13] = x[13] ^ x[12].wrapping_add(x[15]).rotate_left(9u32);
        x[14] = x[14] ^ x[13].wrapping_add(x[12]).rotate_left(13u32);
        x[15] = x[15] ^ x[14].wrapping_add(x[13]).rotate_left(18u32);
        i += 1;
    }
    let mut k = 0;
    while k < 16 {
        b[k] = b[k].wrapping_add(x[k]);
        k += 1;
    }
}

// BlockMix over 2r 64-byte blocks of 16 words.
fn block_mix(src: ref Vec[u32], r: i64) -> Vec[u32] {
    let n = 32 * r;
    let mut x = sub_u32(src, n - 16, n);
    let mut out: Vec[u32] = Vec.new();
    for _ in 0..n {
        out.push(0u32);
    }
    let mut i = 0;
    while i < 2 * r {
        let mut k = 0;
        while k < 16 {
            x[k] = x[k] ^ src[i * 16 + k];
            k += 1;
        }
        salsa20_8(mut x);
        let dest = if i % 2 == 0 { (i / 2) * 16 } else { (r + i / 2) * 16 };
        k = 0;
        while k < 16 {
            out[dest + k] = x[k];
            k += 1;
        }
        i += 1;
    }
    out
}

fn scrypt_kdf(secret: ref Vec[u8], salt: ref Vec[u8], n: i64, r: i64, p: i64, keylen: i64) -> Vec[u8] {
    let smix_bytes = 128 * r;
    let input = pbkdf2_hmac(D_SHA256, secret, salt, 1, smix_bytes * p);
    let mut output: Vec[u8] = Vec.new();
    let mut part = 0;
    while part < p {
        let mut x: Vec[u32] = Vec.new();
        let mut i = part * smix_bytes;
        while i < (part + 1) * smix_bytes {
            x.push(le32(input, i));
            i += 4;
        }
        let mut v: Vec[Vec[u32]] = Vec.new();
        let mut k = 0;
        while k < n {
            v.push(x.clone());
            x = block_mix(x, r);
            k += 1;
        }
        k = 0;
        while k < n {
            let j = (x[32 * r - 16] as i64) & (n - 1);
            let mut y = x.clone();
            let mut w = 0;
            while w < y.len() {
                y[w] = y[w] ^ v[j][w];
                w += 1;
            }
            x = block_mix(y, r);
            k += 1;
        }
        for word in x {
            push_le32(mut output, word);
        }
        part += 1;
    }
    pbkdf2_hmac(D_SHA256, secret, output, 1, keylen)
}

// ------------------------------------------------------------ the crypt cores

const DIGEST_OFFSETS: Array[i64, 42] = [0, 3, 5, 1, 5, 3, 1, 2, 5, 1, 5, 3, 1, 3, 4, 1, 5, 3, 1, 3, 5, 0, 5, 3, 1, 3, 5, 1, 4, 3, 1, 3, 5, 1, 5, 2, 1, 3, 5, 1, 5, 3];

fn repeat_bytes(src: ref Vec[u8], size: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    if src.len() == 0 {
        return out;
    }
    while out.len() < size {
        out.push(src[out.len() % src.len()]);
    }
    out
}

fn has_nul(b: ref Vec[u8]) -> bool {
    for x in b {
        if x == 0 {
            return true;
        }
    }
    false
}

// The 21 (even, odd) digest-input pairs both MD5-crypt and SHA-crypt
// cycle through, built from the six permutations of password and salt.
fn crypt_pairs(p: ref Vec[u8], s: ref Vec[u8]) -> (Vec[Vec[u8]], Vec[Vec[u8]]) {
    let pp = cat(p, p);
    let ps = cat(p, s);
    let mut perms: Vec[Vec[u8]] = Vec.new();
    perms.push(p.clone());
    perms.push(pp.clone());
    perms.push(ps.clone());
    perms.push(cat(ps, p));
    perms.push(cat(s, p));
    perms.push(cat(s, pp));
    let mut evens: Vec[Vec[u8]] = Vec.new();
    let mut odds: Vec[Vec[u8]] = Vec.new();
    let mut i = 0;
    while i < 21 {
        evens.push(perms[DIGEST_OFFSETS[2 * i]].clone());
        odds.push(perms[DIGEST_OFFSETS[2 * i + 1]].clone());
        i += 1;
    }
    (evens, odds)
}

const MD5_TRANSPOSE: Array[i64, 16] = [12, 6, 0, 13, 7, 1, 14, 8, 2, 15, 9, 3, 5, 10, 4, 11];

fn raw_md5_crypt(pwd: ref Vec[u8], salt_text: ref String, apr: bool) -> String {
    let salt = utf8_of(salt_text);
    let magic = if apr { str_bytes("$apr1$") } else { str_bytes("$1$") };
    let db = md5(cat(cat(pwd, salt), pwd));
    let mut a = cat(cat(pwd, magic), salt);
    append(mut a, repeat_bytes(db, pwd.len()));
    let mut i = pwd.len();
    while i > 0 {
        if i & 1 == 1 {
            a.push(0);
        } else if pwd.len() > 0 {
            a.push(pwd[0]);
        }
        i = i >> 1;
    }
    let mut dc = md5(a);
    let (evens, odds) = crypt_pairs(pwd, salt);
    let mut blocks = 0;
    while blocks < 23 {
        let mut k = 0;
        while k < 21 {
            dc = md5(cat(odds[k], md5(cat(dc, evens[k]))));
            k += 1;
        }
        blocks += 1;
    }
    let mut k = 0;
    while k < 17 {
        dc = md5(cat(odds[k], md5(cat(dc, evens[k]))));
        k += 1;
    }
    let mut map: Vec[i64] = Vec.new();
    for x in MD5_TRANSPOSE {
        map.push(x);
    }
    encode_transposed(h64(), dc, map)
}

const SHA256_TRANSPOSE: Array[i64, 32] = [20, 10, 0, 11, 1, 21, 2, 22, 12, 23, 13, 3, 14, 4, 24, 5, 25, 15, 26, 16, 6, 17, 7, 27, 8, 28, 18, 29, 19, 9, 30, 31];

const SHA512_TRANSPOSE: Array[i64, 64] = [
    42, 21, 0, 1, 43, 22, 23, 2, 44, 45, 24, 3, 4, 46, 25, 26,
    5, 47, 48, 27, 6, 7, 49, 28, 29, 8, 50, 51, 30, 9, 10, 52,
    31, 32, 11, 53, 54, 33, 12, 13, 55, 34, 35, 14, 56, 57, 36, 15,
    16, 58, 37, 38, 17, 59, 60, 39, 18, 19, 61, 40, 41, 20, 62, 63,
];

fn raw_sha2_crypt(pwd: ref Vec[u8], salt_text: ref String, rounds: i64, use512: bool) -> String {
    let kind = if use512 { D_SHA512 } else { D_SHA256 };
    let salt = utf8_of(salt_text);
    let plen = pwd.len();
    let db = digest(kind, cat(cat(pwd, salt), pwd));
    let mut a = cat(pwd, salt);
    append(mut a, repeat_bytes(db, plen));
    let mut i = plen;
    while i > 0 {
        if i & 1 == 1 {
            append(mut a, db);
        } else {
            append(mut a, pwd);
        }
        i = i >> 1;
    }
    let da = digest(kind, a);
    let mut pp: Vec[u8] = Vec.new();
    let mut k = 0;
    while k < plen {
        append(mut pp, pwd);
        k += 1;
    }
    let dp = repeat_bytes(digest(kind, pp), plen);
    let mut ss: Vec[u8] = Vec.new();
    k = 0;
    while k < 16 + (da[0] as i64) {
        append(mut ss, salt);
        k += 1;
    }
    let ds = sub(digest(kind, ss), 0, salt.len());
    let (evens, odds) = crypt_pairs(dp, ds);
    let mut dc = da;
    let mut blocks = rounds / 42;
    let tail = rounds % 42;
    while blocks > 0 {
        k = 0;
        while k < 21 {
            dc = digest(kind, cat(odds[k], digest(kind, cat(dc, evens[k]))));
            k += 1;
        }
        blocks -= 1;
    }
    if tail > 0 {
        let pairs = tail >> 1;
        k = 0;
        while k < pairs {
            dc = digest(kind, cat(odds[k], digest(kind, cat(dc, evens[k]))));
            k += 1;
        }
        if tail & 1 == 1 {
            dc = digest(kind, cat(dc, evens[pairs]));
        }
    }
    let mut map: Vec[i64] = Vec.new();
    if use512 {
        for x in SHA512_TRANSPOSE {
            map.push(x);
        }
    } else {
        for x in SHA256_TRANSPOSE {
            map.push(x);
        }
    }
    encode_transposed(h64(), dc, map)
}

const SHA1_OFFSETS: Array[i64, 21] = [2, 1, 0, 5, 4, 3, 8, 7, 6, 11, 10, 9, 14, 13, 12, 17, 16, 15, 0, 19, 18];

fn raw_sha1_crypt(secret: ref Vec[u8], salt: ref String, rounds: i64) -> String {
    let mut result = utf8_of(f"{salt}$sha1${rounds}");
    let h = hmac_key(D_SHA1, secret);
    let mut i = 0;
    while i < rounds {
        result = hmac_run(h, result);
        i += 1;
    }
    let mut map: Vec[i64] = Vec.new();
    for x in SHA1_OFFSETS {
        map.push(x);
    }
    encode_transposed(h64(), result, map)
}

fn raw_des_crypt(t: ref DesT, secret: ref Vec[u8], salt: ref String) -> Result[String, Exc] {
    let salt_value = decode_small(h64(), salt)?;
    let key = crypt_secret_to_key(secret, 0);
    Ok(encode_int(h64big(), des_encrypt_int_block(t, key, 0u64, salt_value, 25), 64))
}

fn bsdi_secret_to_key(t: ref DesT, secret: ref Vec[u8]) -> u64 {
    let mut key = crypt_secret_to_key(secret, 0);
    let mut idx = 8;
    while idx < secret.len() {
        let tmp = crypt_secret_to_key(secret, idx);
        key = des_encrypt_int_block(t, key, key, 0, 1) ^ tmp;
        idx += 8;
    }
    key
}

// ------------------------------------------------------------ the salt generator

// oracle.py replaces Passlib's random source with a 31-bit linear
// congruential generator reseeded before every job, so salts and varied
// rounds are reproducible. Passlib draws salts as big integers
// (randrange(0, letters**count)), so the draws are made over a little
// big-integer type: base-256 digits, least significant first.

fn rng_byte(w: mut ref World) -> i64 {
    w.rng = (w.rng * 1103515245 + 12345) & 0x7FFFFFFF;
    (w.rng >> 16) & 0xFF
}

// getrandbits(k), as a big integer.
fn getrandbits(w: mut ref World, k: i64) -> Vec[i64] {
    let n = (k + 7) / 8;
    let mut v: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        v.push(rng_byte(mut w));
        i += 1;
    }
    let extra = k % 8;
    if extra != 0 and n > 0 {
        v[n - 1] = v[n - 1] & ((1 << extra) - 1);
    }
    v
}

fn big_small(n: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    let mut x = n;
    while x > 0 {
        v.push(x & 255);
        x = x >> 8;
    }
    v
}

fn big_to_i64(a: ref Vec[i64]) -> i64 {
    let mut v: i64 = 0;
    let mut i = a.len() - 1;
    while i >= 0 {
        v = v * 256 + a[i];
        i -= 1;
    }
    v
}

fn big_trim(a: mut ref Vec[i64]) {
    while a.len() > 0 and a[a.len() - 1] == 0 {
        let _ = a.pop();
    }
}

fn big_mul_small(a: ref Vec[i64], m: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut carry: i64 = 0;
    for d in a {
        let t = d * m + carry;
        out.push(t & 255);
        carry = t >> 8;
    }
    while carry > 0 {
        out.push(carry & 255);
        carry = carry >> 8;
    }
    out
}

fn big_bitlen(a0: ref Vec[i64]) -> i64 {
    let mut a = a0.clone();
    big_trim(mut a);
    if a.len() == 0 {
        return 0;
    }
    let mut top = a[a.len() - 1];
    let mut bits = (a.len() - 1) * 8;
    while top > 0 {
        bits += 1;
        top = top >> 1;
    }
    bits
}

fn big_lt(a0: ref Vec[i64], b0: ref Vec[i64]) -> bool {
    let mut a = a0.clone();
    let mut b = b0.clone();
    big_trim(mut a);
    big_trim(mut b);
    if a.len() != b.len() {
        return a.len() < b.len();
    }
    let mut i = a.len() - 1;
    while i >= 0 {
        if a[i] != b[i] {
            return a[i] < b[i];
        }
        i -= 1;
    }
    false
}

// (a // d, a % d) for a small divisor.
fn big_divmod(a: ref Vec[i64], d: i64) -> (Vec[i64], i64) {
    let mut q: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < a.len() {
        q.push(0);
        i += 1;
    }
    let mut r: i64 = 0;
    let mut j = a.len() - 1;
    while j >= 0 {
        let cur = r * 256 + a[j];
        q[j] = cur / d;
        r = cur % d;
        j -= 1;
    }
    (q, r)
}

fn big_shr3(a: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < a.len() {
        let hi = if i + 1 < a.len() { a[i + 1] } else { 0 };
        out.push(((a[i] >> 3) | (hi << 5)) & 255);
        i += 1;
    }
    out
}

// randrange(0, n) by rejection: draw bit_length(n) bits until below n.
fn randbelow(w: mut ref World, n: ref Vec[i64]) -> Vec[i64] {
    let k = big_bitlen(n);
    loop {
        let v = getrandbits(mut w, k);
        if big_lt(v, n) {
            return v;
        }
    }
}

fn randint(w: mut ref World, a: i64, b: i64) -> i64 {
    let v = randbelow(mut w, big_small(b + 1 - a));
    a + big_to_i64(v)
}

// passlib.utils.getrandstr
fn getrandstr(w: mut ref World, charset: ref String, count: i64) -> String {
    let cs = chars(charset);
    let letters = cs.len();
    let mut out = String.new();
    if letters == 1 {
        let mut i = 0;
        while i < count {
            out.push(cs[0]);
            i += 1;
        }
        return out;
    }
    let mut n: Vec[i64] = [1].to_vec();
    let mut i = 0;
    while i < count {
        n = big_mul_small(n, letters);
        i += 1;
    }
    let mut v = randbelow(mut w, n);
    i = 0;
    while i < count {
        let (q, r) = big_divmod(v, letters);
        out.push(cs[r]);
        v = q;
        i += 1;
    }
    out
}

// passlib.utils.getrandbytes: note the 3-bit shift between bytes, which
// is Passlib's own.
fn getrandbytes(w: mut ref World, count: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    if count == 0 {
        return out;
    }
    let mut v = getrandbits(mut w, count * 8);
    let mut i = 0;
    while i < count {
        out.push((if v.len() > 0 { v[0] } else { 0 }) as u8);
        v = big_shr3(v);
        i += 1;
    }
    out
}

// ------------------------------------------------------------ keyword arguments

// A call's keyword arguments, in the order given, with dict semantics.
#[derive(Clone)]
struct Kw {
    keys: Vec[String],
    vals: Vec[Val],
}

fn kw_new() -> Kw {
    Kw { keys: Vec.new(), vals: Vec.new() }
}

fn kw_pos(k: ref Kw, key: Str) -> i64 {
    let mut i = 0;
    while i < k.keys.len() {
        if k.keys[i] == key {
            return i;
        }
        i += 1;
    }
    -1
}

fn kw_has(k: ref Kw, key: Str) -> bool {
    kw_pos(k, key) >= 0
}

fn kw_get(k: ref Kw, key: Str) -> Val {
    let i = kw_pos(k, key);
    if i < 0 { Val.Non } else { k.vals[i].clone() }
}

fn kw_pop(k: mut ref Kw, key: Str) -> Val {
    let i = kw_pos(k, key);
    if i < 0 {
        return Val.Non;
    }
    let _ = k.keys.remove(i);
    k.vals.remove(i)
}

fn kw_set(k: mut ref Kw, key: ref String, v: own Val) {
    let i = kw_pos(k, key);
    if i < 0 {
        k.keys.push(key.clone());
        k.vals.push(v);
    } else {
        k.vals[i] = v;
    }
}

fn kw_len(k: ref Kw) -> i64 {
    k.keys.len()
}

// ------------------------------------------------------------ hash classes

const K_HEX_MD4: i64 = 0;
const K_HEX_MD5: i64 = 1;
const K_HEX_SHA1: i64 = 2;
const K_HEX_SHA256: i64 = 3;
const K_HEX_SHA512: i64 = 4;
const K_HTDIGEST: i64 = 5;
const K_LDAP_MD5: i64 = 6;
const K_LDAP_SHA1: i64 = 7;
const K_LDAP_SMD5: i64 = 8;
const K_LDAP_SSHA1: i64 = 9;
const K_LDAP_SSHA256: i64 = 10;
const K_LDAP_SSHA512: i64 = 11;
const K_LDAP_PLAIN: i64 = 12;
const K_DES: i64 = 13;
const K_BSDI: i64 = 14;
const K_BIGCRYPT: i64 = 15;
const K_CRYPT16: i64 = 16;
const K_MD5: i64 = 17;
const K_APR: i64 = 18;
const K_SHA256: i64 = 19;
const K_SHA512: i64 = 20;
const K_SHA1C: i64 = 21;
const K_BCRYPT: i64 = 22;
const K_BSHA: i64 = 23;
const K_SCRYPT: i64 = 24;
const K_PBKDF2_SHA1: i64 = 25;
const K_PBKDF2_SHA256: i64 = 26;
const K_PBKDF2_SHA512: i64 = 27;
const K_CTA: i64 = 28;
const K_DLITZ: i64 = 29;
const K_GRUB: i64 = 30;
const K_ATLASSIAN: i64 = 31;
const K_PHPASS: i64 = 32;
const K_MYSQL323: i64 = 33;
const K_MYSQL41: i64 = 34;
const K_POSTGRES: i64 = 35;
const K_NTHASH: i64 = 36;
const K_LMHASH: i64 = 37;
const K_MSDCC: i64 = 38;
const K_CISCO7: i64 = 39;
const K_PIX: i64 = 40;
const K_ASA: i64 = 41;
const K_DJ_SHA1: i64 = 42;
const K_DJ_MD5: i64 = 43;
const K_DJ_PBKDF2_SHA256: i64 = 44;
const K_DJ_PBKDF2_SHA1: i64 = 45;
const K_DJ_DISABLED: i64 = 46;
const K_PLAIN: i64 = 47;
const K_UNIX_DISABLED: i64 = 48;
const K_COUNT: i64 = 49;
const K_WRAP: i64 = 100;

const DJ_SALT_CHARS: Str = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";

// A hash class: Passlib's class attributes, flattened. `using()` copies
// one and changes its settings, as Passlib derives a subclass. A
// PrefixWrapper is a Cls of kind K_WRAP around another (`wrapped`).
// -1 stands for None in the integer fields, "" in the string ones.
#[derive(Clone)]
struct Cls {
    kind: i64,
    name: String,
    clsname: String,
    module: String,
    configured: bool,
    setting_kwds: Vec[String],
    context_kwds: Vec[String],
    ident: Val,
    default_ident: String,
    ident_values: Vec[String],
    alias_keys: Vec[String],
    alias_vals: Vec[String],
    checksum_size: i64,
    checksum_chars: String,
    checksum_bytes: bool,
    salt_kind: i64,
    min_salt: i64,
    max_salt: i64,
    default_salt_size: i64,
    salt_chars: String,
    fixed_salt: Val,
    has_rounds: bool,
    min_rounds: i64,
    max_rounds: i64,
    default_rounds: i64,
    min_desired: i64,
    max_desired: i64,
    vary_rounds: Val,
    rounds_cost: String,
    trunc_mixin: bool,
    truncate_size: i64,
    truncate_error: bool,
    block_size: i64,
    parallelism: i64,
    version: i64,
    marker: String,
    cisco_salt: i64,
    is_disabled: bool,
    default_encoding: String,
    deprecated: bool,
    orig: i64,
    wrapped: i64,
    prefix: String,
    orig_prefix: String,
    wident: Val,
}

fn base_cls(kind: i64, name: Str, module: Str) -> Cls {
    Cls {
        kind: kind,
        name: name.to_string(),
        clsname: name.to_string(),
        module: f"passlib.handlers.{module}",
        configured: false,
        setting_kwds: Vec.new(),
        context_kwds: Vec.new(),
        ident: Val.Non,
        default_ident: String.new(),
        ident_values: Vec.new(),
        alias_keys: Vec.new(),
        alias_vals: Vec.new(),
        checksum_size: 0,
        checksum_chars: String.new(),
        checksum_bytes: false,
        salt_kind: 0,
        min_salt: 0,
        max_salt: -1,
        default_salt_size: -1,
        salt_chars: String.new(),
        fixed_salt: Val.Non,
        has_rounds: false,
        min_rounds: 0,
        max_rounds: -1,
        default_rounds: -1,
        min_desired: -1,
        max_desired: -1,
        vary_rounds: Val.Non,
        rounds_cost: "linear".to_string(),
        trunc_mixin: false,
        truncate_size: -1,
        truncate_error: false,
        block_size: 0,
        parallelism: 1,
        version: 0,
        marker: String.new(),
        cisco_salt: -1,
        is_disabled: false,
        default_encoding: "utf-8".to_string(),
        deprecated: false,
        orig: -1,
        wrapped: -1,
        prefix: String.new(),
        orig_prefix: String.new(),
        wident: Val.Non,
    }
}

fn set_salt(c: mut ref Cls, kind: i64, mn: i64, mx: i64, dflt: i64, chars_: Str) {
    c.salt_kind = kind;
    c.min_salt = mn;
    c.max_salt = mx;
    c.default_salt_size = if dflt >= 0 { dflt } else { mx };
    c.salt_chars = chars_.to_string();
}

fn set_rounds(c: mut ref Cls, mn: i64, mx: i64, dflt: i64, cost: Str) {
    c.has_rounds = true;
    c.min_rounds = mn;
    c.max_rounds = mx;
    c.default_rounds = dflt;
    c.rounds_cost = cost.to_string();
}

fn set_chk(c: mut ref Cls, size: i64, chars_: Str, raw: bool) {
    c.checksum_size = size;
    c.checksum_chars = chars_.to_string();
    c.checksum_bytes = raw;
}

fn set_idents(c: mut ref Cls, dflt: Str, values: Str, aliases: Str) {
    c.default_ident = dflt.to_string();
    c.ident_values = strs(values);
    for a in strs(aliases) {
        let kv = split_on(a, '=');
        c.alias_keys.push(kv[0].clone());
        c.alias_vals.push(kv[1].clone());
    }
}

// The hash classes as Passlib defines them.
fn mk_base(kind: i64) -> Cls {
    let mut c = base_cls(kind, "", "");
    if kind <= K_HEX_SHA512 {
        let names = strs("md4 md5 sha1 sha256 sha512");
        let sizes: Vec[i64] = [32, 32, 40, 64, 128].to_vec();
        c = base_cls(kind, f"hex_{names[kind]}", "digests");
        set_chk(mut c, sizes[kind], HEX_CHARS, false);
    } else if kind == K_HTDIGEST {
        c = base_cls(kind, "htdigest", "digests");
        c.context_kwds = strs("user realm encoding");
    } else if kind == K_LDAP_MD5 or kind == K_LDAP_SHA1 {
        c = base_cls(kind, if kind == K_LDAP_MD5 { "ldap_md5" } else { "ldap_sha1" }, "ldap_digests");
        c.ident = sv(if kind == K_LDAP_MD5 { "{MD5}" } else { "{SHA}" });
        set_chk(mut c, 0, PADDED_BASE64_CHARS, false);
    } else if kind >= K_LDAP_SMD5 and kind <= K_LDAP_SSHA512 {
        let names = strs("md5 sha1 sha256 sha512");
        let idents = strs("{SMD5} {SSHA} {SSHA256} {SSHA512}");
        let sizes: Vec[i64] = [16, 20, 32, 64].to_vec();
        let i = kind - K_LDAP_SMD5;
        c = base_cls(kind, f"ldap_salted_{names[i]}", "ldap_digests");
        c.setting_kwds = strs("salt salt_size");
        c.ident = Val.Str(idents[i].clone());
        set_chk(mut c, sizes[i], PADDED_BASE64_CHARS, true);
        set_salt(mut c, 2, 4, 16, if i >= 2 { 8 } else { 4 }, "");
    } else if kind == K_LDAP_PLAIN {
        c = base_cls(kind, "ldap_plaintext", "ldap_digests");
        c.context_kwds = strs("encoding");
    } else if kind == K_DES {
        c = base_cls(kind, "des_crypt", "des_crypt");
        c.setting_kwds = strs("salt truncate_error");
        set_chk(mut c, 11, HASH64_CHARS, false);
        set_salt(mut c, 1, 2, 2, -1, HASH64_CHARS);
        c.trunc_mixin = true;
        c.truncate_size = 8;
    } else if kind == K_BSDI {
        c = base_cls(kind, "bsdi_crypt", "des_crypt");
        c.setting_kwds = strs("salt rounds");
        set_chk(mut c, 11, HASH64_CHARS, false);
        set_salt(mut c, 1, 4, 4, -1, HASH64_CHARS);
        set_rounds(mut c, 1, 16777215, 5001, "linear");
    } else if kind == K_BIGCRYPT {
        c = base_cls(kind, "bigcrypt", "des_crypt");
        c.setting_kwds = strs("salt");
        set_chk(mut c, 0, HASH64_CHARS, false);
        set_salt(mut c, 1, 2, 2, -1, HASH64_CHARS);
    } else if kind == K_CRYPT16 {
        c = base_cls(kind, "crypt16", "des_crypt");
        c.setting_kwds = strs("salt truncate_error");
        set_chk(mut c, 22, HASH64_CHARS, false);
        set_salt(mut c, 1, 2, 2, -1, HASH64_CHARS);
        c.trunc_mixin = true;
        c.truncate_size = 16;
    } else if kind == K_MD5 or kind == K_APR {
        c = base_cls(kind, if kind == K_MD5 { "md5_crypt" } else { "apr_md5_crypt" }, "md5_crypt");
        c.setting_kwds = strs("salt salt_size");
        c.ident = sv(if kind == K_MD5 { "$1$" } else { "$apr1$" });
        set_chk(mut c, 22, HASH64_CHARS, false);
        set_salt(mut c, 1, 0, 8, -1, HASH64_CHARS);
    } else if kind == K_SHA256 or kind == K_SHA512 {
        let is512 = kind == K_SHA512;
        c = base_cls(kind, if is512 { "sha512_crypt" } else { "sha256_crypt" }, "sha2_crypt");
        c.setting_kwds = strs("salt rounds implicit_rounds salt_size");
        c.ident = sv(if is512 { "$6$" } else { "$5$" });
        set_chk(mut c, if is512 { 86 } else { 43 }, HASH64_CHARS, false);
        set_salt(mut c, 1, 0, 16, -1, HASH64_CHARS);
        set_rounds(mut c, 1000, 999999999, if is512 { 656000 } else { 535000 }, "linear");
    } else if kind == K_SHA1C {
        c = base_cls(kind, "sha1_crypt", "sha1_crypt");
        c.setting_kwds = strs("salt salt_size rounds");
        c.ident = sv("$sha1$");
        set_chk(mut c, 28, HASH64_CHARS, false);
        set_salt(mut c, 1, 0, 64, 8, HASH64_CHARS);
        set_rounds(mut c, 1, 4294967295, 480000, "linear");
    } else if kind == K_BCRYPT or kind == K_BSHA {
        let sha = kind == K_BSHA;
        c = base_cls(kind, if sha { "bcrypt_sha256" } else { "bcrypt" }, "bcrypt");
        c.setting_kwds = if sha { strs("salt rounds ident") } else { strs("salt rounds ident truncate_error") };
        set_chk(mut c, 31, BCRYPT_CHARS, false);
        if sha {
            set_idents(mut c, "$2b$", "$2a$ $2b$", "2a=$2a$ 2b=$2b$");
        } else {
            set_idents(mut c, "$2b$", "$2$ $2a$ $2x$ $2y$ $2b$", "2=$2$ 2a=$2a$ 2y=$2y$ 2b=$2b$");
        }
        set_salt(mut c, 1, 22, 22, -1, BCRYPT_CHARS);
        set_rounds(mut c, 4, 31, 12, "log2");
        c.trunc_mixin = true;
        c.truncate_size = if sha { -1 } else { 72 };
        c.version = 2;
    } else if kind == K_SCRYPT {
        c = base_cls(kind, "scrypt", "scrypt");
        c.setting_kwds = strs("ident salt salt_size rounds block_size parallelism");
        set_chk(mut c, 32, "", true);
        set_idents(mut c, "$scrypt$", "$scrypt$ $7$", "");
        set_salt(mut c, 2, 0, 1024, 16, "");
        set_rounds(mut c, 1, 31, 16, "log2");
        c.block_size = 8;
    } else if kind >= K_PBKDF2_SHA1 and kind <= K_PBKDF2_SHA512 {
        let names = strs("sha1 sha256 sha512");
        let idents = strs("$pbkdf2$ $pbkdf2-sha256$ $pbkdf2-sha512$");
        let sizes: Vec[i64] = [20, 32, 64].to_vec();
        let rounds: Vec[i64] = [131000, 29000, 25000].to_vec();
        let i = kind - K_PBKDF2_SHA1;
        c = base_cls(kind, f"pbkdf2_{names[i]}", "pbkdf2");
        c.setting_kwds = strs("salt salt_size rounds");
        c.ident = Val.Str(idents[i].clone());
        set_chk(mut c, sizes[i], HASH64_CHARS, true);
        set_salt(mut c, 2, 0, 1024, 16, "");
        set_rounds(mut c, 1, 4294967295, rounds[i], "linear");
    } else if kind == K_CTA {
        c = base_cls(kind, "cta_pbkdf2_sha1", "pbkdf2");
        c.setting_kwds = strs("salt salt_size rounds");
        c.ident = sv("$p5k2$");
        set_chk(mut c, 20, "", true);
        set_salt(mut c, 2, 0, 1024, 16, "");
        set_rounds(mut c, 1, 4294967295, 131000, "linear");
    } else if kind == K_DLITZ {
        c = base_cls(kind, "dlitz_pbkdf2_sha1", "pbkdf2");
        c.setting_kwds = strs("salt salt_size rounds");
        c.ident = sv("$p5k2$");
        set_salt(mut c, 1, 0, 1024, 16, HASH64_CHARS);
        set_rounds(mut c, 1, 4294967295, 131000, "linear");
    } else if kind == K_GRUB {
        c = base_cls(kind, "grub_pbkdf2_sha512", "pbkdf2");
        c.setting_kwds = strs("salt salt_size rounds");
        c.ident = sv("grub.pbkdf2.sha512.");
        set_chk(mut c, 64, "", true);
        set_salt(mut c, 2, 0, 1024, 64, "");
        set_rounds(mut c, 1, 4294967295, 25000, "linear");
    } else if kind == K_ATLASSIAN {
        c = base_cls(kind, "atlassian_pbkdf2_sha1", "pbkdf2");
        c.setting_kwds = strs("salt");
        c.ident = sv("{PKCS5S2}");
        set_chk(mut c, 32, "", true);
        set_salt(mut c, 2, 16, 16, -1, "");
    } else if kind == K_PHPASS {
        c = base_cls(kind, "phpass", "phpass");
        c.setting_kwds = strs("salt rounds ident");
        set_chk(mut c, 0, HASH64_CHARS, false);
        set_idents(mut c, "$P$", "$P$ $H$", "P=$P$ H=$H$");
        set_salt(mut c, 1, 8, 8, -1, HASH64_CHARS);
        set_rounds(mut c, 7, 30, 19, "log2");
    } else if kind == K_MYSQL323 {
        c = base_cls(kind, "mysql323", "mysql");
        set_chk(mut c, 16, HEX_CHARS, false);
    } else if kind == K_MYSQL41 {
        c = base_cls(kind, "mysql41", "mysql");
        set_chk(mut c, 40, HEX_CHARS, false);
    } else if kind == K_POSTGRES {
        c = base_cls(kind, "postgres_md5", "postgres");
        c.context_kwds = strs("user");
        set_chk(mut c, 32, HEX_CHARS, false);
    } else if kind == K_NTHASH {
        c = base_cls(kind, "nthash", "windows");
        set_chk(mut c, 32, HEX_CHARS, false);
    } else if kind == K_LMHASH {
        c = base_cls(kind, "lmhash", "windows");
        c.setting_kwds = strs("truncate_error");
        c.context_kwds = strs("encoding");
        set_chk(mut c, 32, HEX_CHARS, false);
        c.trunc_mixin = true;
        c.truncate_size = 14;
        c.default_encoding = "cp437".to_string();
    } else if kind == K_MSDCC {
        c = base_cls(kind, "msdcc", "windows");
        c.context_kwds = strs("user");
        set_chk(mut c, 32, HEX_CHARS, false);
    } else if kind == K_CISCO7 {
        c = base_cls(kind, "cisco_type7", "cisco");
        c.setting_kwds = strs("salt");
        set_chk(mut c, 0, UPPER_HEX_CHARS, false);
    } else if kind == K_PIX or kind == K_ASA {
        c = base_cls(kind, if kind == K_PIX { "cisco_pix" } else { "cisco_asa" }, "cisco");
        c.context_kwds = strs("user");
        set_chk(mut c, 16, HASH64_CHARS, false);
        c.truncate_size = if kind == K_PIX { 16 } else { 32 };
        c.truncate_error = true;
    } else if kind == K_DJ_SHA1 or kind == K_DJ_MD5 {
        let sha = kind == K_DJ_SHA1;
        c = base_cls(kind, if sha { "django_salted_sha1" } else { "django_salted_md5" }, "django");
        c.setting_kwds = strs("salt salt_size");
        c.ident = sv(if sha { "sha1$" } else { "md5$" });
        set_chk(mut c, if sha { 40 } else { 32 }, LOWER_HEX_CHARS, false);
        set_salt(mut c, 1, 0, -1, 12, DJ_SALT_CHARS);
    } else if kind == K_DJ_PBKDF2_SHA256 or kind == K_DJ_PBKDF2_SHA1 {
        let s256 = kind == K_DJ_PBKDF2_SHA256;
        c = base_cls(kind, if s256 { "django_pbkdf2_sha256" } else { "django_pbkdf2_sha1" }, "django");
        c.setting_kwds = strs("salt salt_size rounds");
        c.ident = sv(if s256 { "pbkdf2_sha256$" } else { "pbkdf2_sha1$" });
        set_chk(mut c, if s256 { 44 } else { 28 }, PADDED_BASE64_CHARS, false);
        set_salt(mut c, 1, 1, -1, 12, DJ_SALT_CHARS);
        set_rounds(mut c, 1, 4294967295, if s256 { 29000 } else { 131000 }, "linear");
    } else if kind == K_DJ_DISABLED {
        c = base_cls(kind, "django_disabled", "django");
        c.is_disabled = true;
    } else if kind == K_PLAIN {
        c = base_cls(kind, "plaintext", "misc");
        c.context_kwds = strs("encoding");
    } else if kind == K_UNIX_DISABLED {
        c = base_cls(kind, "unix_disabled", "misc");
        c.setting_kwds = strs("marker");
        c.marker = "!".to_string();
        c.is_disabled = true;
    }
    c
}

// A PrefixWrapper: `name` over the registered class `wrapped`.
fn mk_wrapper(w: mut ref World, name: Str, wrapped: Str, prefix: Str, orig_prefix: Str, ident: Str) -> i64 {
    let inner = find_base(w, wrapped.to_string());
    let mut c = base_cls(K_WRAP, name, "");
    c.module = "passlib.utils.handlers".to_string();
    c.clsname = "PrefixWrapper".to_string();
    c.wrapped = inner;
    c.prefix = prefix.to_string();
    c.orig_prefix = orig_prefix.to_string();
    if ident.len() > 0 {
        c.wident = sv(ident);
    }
    w.cls.push(c);
    w.cls.len() - 1
}

fn find_base(w: ref World, name: ref String) -> i64 {
    let mut i = 0;
    while i < w.nbase {
        if w.cls[i].name == name {
            return i;
        }
        i += 1;
    }
    -1
}

// One parsed hash: an instance of a hash class.
#[derive(Clone)]
struct Inst {
    checksum: Val,
    salt: Val,
    rounds: i64,
    ident: String,
    implicit_rounds: bool,
    block_size: i64,
    parallelism: i64,
    version: i64,
    user: Val,
    encoding: String,
    use_defaults: bool,
}

// The constructor's keyword arguments; Val.Non where not given.
#[derive(Clone)]
struct CArgs {
    checksum: Val,
    salt: Val,
    rounds: Val,
    ident: Val,
    implicit_rounds: Val,
    block_size: Val,
    parallelism: Val,
    version: Val,
    user: Val,
    encoding: Val,
    use_defaults: bool,
}

fn cargs() -> CArgs {
    CArgs {
        checksum: Val.Non,
        salt: Val.Non,
        rounds: Val.Non,
        ident: Val.Non,
        implicit_rounds: Val.Non,
        block_size: Val.Non,
        parallelism: Val.Non,
        version: Val.Non,
        user: Val.Non,
        encoding: Val.Non,
        use_defaults: false,
    }
}

// Copy the context keywords (user, encoding) of a call into the
// constructor's arguments.
fn cargs_ctx(ctx: ref Kw) -> CArgs {
    let mut a = cargs();
    a.user = kw_get(ctx, "user");
    a.encoding = kw_get(ctx, "encoding");
    a
}

// ------------------------------------------------------------ the world

struct World {
    cls: Vec[Cls],
    nbase: i64,
    ctxs: Vec[Ctx],
    files: Vec[HtFile],
    names: Vec[String],
    vals: Vec[Val],
    warns: Vec[String],
    rng: i64,
    des: DesT,
    htctx: i64,
}

fn warn(w: mut ref World, cat: Str, msg: ref String) {
    w.warns.push(f"{cat}: {msg}");
}

fn ns_get(w: ref World, name: ref String) -> Option[Val] {
    let mut i = 0;
    while i < w.names.len() {
        if w.names[i] == name {
            return Some(w.vals[i].clone());
        }
        i += 1;
    }
    None
}

fn ns_set(w: mut ref World, name: ref String, v: own Val) {
    let mut i = 0;
    while i < w.names.len() {
        if w.names[i] == name {
            w.vals[i] = v;
            return;
        }
        i += 1;
    }
    w.names.push(name.clone());
    w.vals.push(v);
}

// ------------------------------------------------------------ handler errors

fn invalid_hash(name: ref String) -> Exc {
    value_error(f"not a valid {name} hash")
}

fn malformed(name: ref String) -> Exc {
    value_error(f"malformed {name} hash")
}

fn malformed_r(name: ref String, reason: ref String) -> Exc {
    value_error(f"malformed {name} hash ({reason})")
}

fn zero_padded(name: ref String) -> Exc {
    malformed_r(name, "zero-padded rounds")
}

fn null_pw(name: ref String) -> Exc {
    exc("PasswordValueError", f"{name} does not allow NULL bytes in password")
}

fn missing_digest(name: ref String) -> Exc {
    value_error(f"expected {name} hash, got {name} config string instead")
}

fn truncate_err(c: ref Cls) -> Exc {
    exc("PasswordTruncateError", f"Password too long ({c.name} truncates to {c.truncate_size} characters)")
}

// passlib's to_unicode(value, "ascii", param).
fn to_unicode(v: ref Val, param: Str) -> Result[String, Exc] {
    match v {
        Val.Str(s) => Ok(s.clone()),
        Val.Bytes(b) => Ok(latin1_text(b)),
        _ => Err(expected_string(v, param)),
    }
}

fn sec_len(v: ref Val) -> i64 {
    match v {
        Val.Str(s) => clen(s),
        Val.Bytes(b) => b.len(),
        _ => 0,
    }
}

fn validate_secret(v: ref Val) -> Result[bool, Exc] {
    if not is_text(v) {
        return Err(expected_string(v, "secret"));
    }
    if sec_len(v) > 4096 {
        return Err(exc("PasswordSizeError", "password exceeds maximum allowed size".to_string()));
    }
    Ok(true)
}

fn check_truncate(c: ref Cls, n: i64) -> Result[bool, Exc] {
    if c.truncate_error and n > c.truncate_size {
        return Err(truncate_err(c));
    }
    Ok(true)
}

fn is_h64(c: char) -> bool {
    has_char(HASH64_CHARS, c)
}

fn all_h64(s: ref String) -> bool {
    for c in s.chars() {
        if not is_h64(c) {
            return false;
        }
    }
    true
}

// ------------------------------------------------------------ normalising settings

fn norm_integer(w: mut ref World, name: ref String, v: ref Val, mn: i64, mx: i64, param: Str, relaxed: bool) -> Result[i64, Exc] {
    if not is_int(v) {
        return Err(expected_type(v, "integer", param));
    }
    let mut n = int_val(v);
    if n < mn {
        let msg = f"{name}: {param} ({n}) is too low, must be at least {mn}";
        if relaxed {
            warn(mut w, "PasslibHashWarning", msg);
            n = mn;
        } else {
            return Err(value_error(msg));
        }
    }
    if mx > 0 and n > mx {
        let msg = f"{name}: {param} ({n}) is too large, cannot be more than {mx}";
        if relaxed {
            warn(mut w, "PasslibHashWarning", msg);
            n = mx;
        } else {
            return Err(value_error(msg));
        }
    }
    Ok(n)
}

fn norm_rounds(w: mut ref World, c: ref Cls, v: ref Val, param: Str, relaxed: bool) -> Result[i64, Exc] {
    norm_integer(mut w, c.name, v, c.min_rounds, c.max_rounds, param, relaxed)
}

fn norm_checksum(w: mut ref World, c: ref Cls, v: ref Val) -> Result[Val, Exc] {
    let raw = c.checksum_bytes;
    if raw {
        if not is_bytes(v) {
            return Err(expected_type(v, "bytes", "checksum"));
        }
    } else if not is_str(v) {
        return Err(expected_type(v, "unicode", "checksum"));
    }
    let n = sec_len(v);
    if c.checksum_size > 0 and n != c.checksum_size {
        let unit = if raw { "bytes" } else { "chars" };
        return Err(malformed_r(c.name, f"checksum must be exactly {c.checksum_size} {unit}"));
    }
    if raw {
        return Ok(v.clone());
    }
    let mut s = str_val(v);
    if c.checksum_chars.len() > 0 {
        for ch in s.chars() {
            if index_of_char(c.checksum_chars, ch) < 0 {
                return Err(value_error(f"invalid characters in {c.name} checksum"));
            }
        }
    }
    if c.kind == K_BCRYPT or c.kind == K_BSHA {
        let (changed, fixed) = check_repair_unused(bcrypt64(), s)?;
        if changed {
            warn(mut w, "PasslibHashWarning", "encountered a bcrypt hash with incorrectly set padding bits; you may want to use bcrypt.normhash() to fix this; this will be an error under Passlib 2.0");
        }
        s = fixed;
    }
    if c.kind == K_BIGCRYPT and clen(s) % 11 != 0 {
        return Err(invalid_hash(c.name));
    }
    Ok(Val.Str(s))
}

fn norm_salt(w: mut ref World, c: ref Cls, v: ref Val, relaxed: bool) -> Result[Val, Exc] {
    let mut salt = v.clone();
    if c.salt_kind == 2 {
        if not is_bytes(v) {
            return Err(expected_type(v, "bytes", "salt"));
        }
    } else {
        if is_bytes(v) and relaxed {
            salt = Val.Str(str_val(v));
        } else if not is_str(v) {
            return Err(expected_type(v, "unicode", "salt"));
        }
        if c.salt_chars.len() > 0 {
            for ch in str_val(salt).chars() {
                if index_of_char(c.salt_chars, ch) < 0 {
                    return Err(value_error(f"invalid characters in {c.name} salt"));
                }
            }
        }
    }
    let n = sec_len(salt);
    let unit = if c.salt_kind == 2 { "bytes" } else { "chars" };
    let mn = c.min_salt;
    let mx = c.max_salt;
    if mn > 0 and n < mn {
        let q = if mn == mx { "exactly" } else { ">=" };
        return Err(value_error(f"salt too small ({c.name} requires {q} {mn} {unit})"));
    }
    if mx > 0 and n > mx {
        let q = if mx == mn { "exactly" } else { "<=" };
        let msg = f"salt too large ({c.name} requires {q} {mx} {unit})";
        if relaxed {
            warn(mut w, "PasslibHashWarning", msg);
            salt = match salt {
                Val.Str(s) => Val.Str(substr(s, 0, mx)),
                Val.Bytes(b) => Val.Bytes(sub(b, 0, mx)),
                other => other,
            };
        } else {
            return Err(value_error(msg));
        }
    }
    if c.kind == K_BCRYPT or c.kind == K_BSHA {
        let (changed, fixed) = check_repair_unused(bcrypt64(), str_val(salt))?;
        if changed {
            warn(mut w, "PasslibHashWarning", "encountered a bcrypt salt with incorrectly set padding bits; you may want to use bcrypt.normhash() to fix this; this will be an error under Passlib 2.0");
        }
        salt = Val.Str(fixed);
    }
    Ok(salt)
}

fn norm_ident(c: ref Cls, v: ref Val) -> Result[String, Exc] {
    let s = str_val(v);
    if contains_str(c.ident_values, s) {
        return Ok(s);
    }
    let i = pos_of(c.alias_keys, s);
    if i >= 0 and contains_str(c.ident_values, c.alias_vals[i]) {
        return Ok(c.alias_vals[i].clone());
    }
    Err(value_error(f"invalid ident: {str_repr(s)}"))
}

fn gen_salt(w: mut ref World, c: ref Cls, ident: ref String) -> Val {
    if not is_none(c.fixed_salt) {
        return c.fixed_salt.clone();
    }
    if c.kind == K_SCRYPT {
        let raw = getrandbytes(mut w, c.default_salt_size);
        if ident == "$7$" {
            return Val.Bytes(b64s_encode(raw).bytes().to_vec());
        }
        return Val.Bytes(raw);
    }
    if c.salt_kind == 2 {
        return Val.Bytes(getrandbytes(mut w, c.default_salt_size));
    }
    let s = getrandstr(mut w, c.salt_chars, c.default_salt_size);
    if c.kind == K_BCRYPT or c.kind == K_BSHA {
        return match check_repair_unused(bcrypt64(), s) {
            Ok((_, fixed)) => Val.Str(fixed),
            Err(_) => Val.Str(s),
        };
    }
    Val.Str(s)
}

fn clip_desired(c: ref Cls, r: i64) -> i64 {
    let mnd = if c.min_desired > 0 { c.min_desired } else { 0 };
    if r < mnd {
        return mnd;
    }
    if c.max_desired > 0 and r > c.max_desired {
        return c.max_desired;
    }
    r
}

fn floor_log2(v: i64) -> i64 {
    let mut n = 0;
    let mut x = v;
    while x > 1 {
        x = x >> 1;
        n += 1;
    }
    n
}

fn ceil_log2(v: i64) -> i64 {
    let f = floor_log2(v);
    if (1 << f) == v { f } else { f + 1 }
}

fn gen_rounds(w: mut ref World, c: ref Cls) -> Result[i64, Exc] {
    if c.default_rounds < 0 {
        return Err(type_error(f"{c.name} rounds value must be specified explicitly"));
    }
    let mut r = c.default_rounds;
    if truthy(c.vary_rounds) {
        let mut lower = r;
        let mut upper = r;
        match c.vary_rounds {
            Val.Float(f) => {
                if c.rounds_cost == "log2" {
                    let lin = 1 << r;
                    let v = ((lin as f64) * f) as i64;
                    lower = if lin - v <= 0 { 0 } else { ceil_log2(lin - v) };
                    upper = if lin + v <= 0 { 0 } else { floor_log2(lin + v) };
                } else {
                    let v = ((r as f64) * f) as i64;
                    lower = r - v;
                    upper = r + v;
                }
            }
            other => {
                let v = int_val(other);
                lower = r - v;
                upper = r + v;
            }
        }
        lower = clip_desired(c, lower);
        upper = clip_desired(c, upper);
        if lower < upper {
            r = randint(mut w, lower, upper);
        }
    }
    if c.kind == K_BSDI {
        r = r | 1;
    }
    Ok(r)
}

fn norm_version(c: ref Cls, v: ref Val) -> Result[i64, Exc] {
    if is_int(v) and (int_val(v) == 1 or int_val(v) == 2) {
        return Ok(int_val(v));
    }
    Err(value_error(f"{c.name}: unknown or unsupported version: {fmt_val(v)}"))
}

// ------------------------------------------------------------ constructing a hash

fn new_inst(c: ref Cls, a: ref CArgs) -> Inst {
    Inst {
        checksum: Val.Non,
        salt: Val.Non,
        rounds: -1,
        ident: String.new(),
        implicit_rounds: false,
        block_size: c.block_size,
        parallelism: c.parallelism,
        version: c.version,
        user: a.user.clone(),
        encoding: if truthy(a.encoding) { str_val(a.encoding) } else { c.default_encoding.clone() },
        use_defaults: a.use_defaults,
    }
}

fn has_idents(c: ref Cls) -> bool {
    c.ident_values.len() > 0
}

fn init_salt(w: mut ref World, c: ref Cls, it: mut ref Inst, v: ref Val) -> Result[bool, Exc] {
    if not is_none(v) {
        let relaxed = (c.kind == K_SHA256 or c.kind == K_SHA512) and is_none(it.checksum);
        it.salt = norm_salt(mut w, c, v, relaxed)?;
    } else if it.use_defaults {
        it.salt = gen_salt(mut w, c, it.ident);
    } else {
        return Err(type_error("no salt specified".to_string()));
    }
    Ok(true)
}

fn init_rounds(w: mut ref World, c: ref Cls, it: mut ref Inst, v: ref Val) -> Result[bool, Exc] {
    if not is_none(v) {
        let relaxed = (c.kind == K_SHA256 or c.kind == K_SHA512) and is_none(it.checksum);
        it.rounds = norm_rounds(mut w, c, v, "rounds", relaxed)?;
    } else if it.use_defaults {
        it.rounds = gen_rounds(mut w, c)?;
    } else {
        return Err(type_error("no rounds specified".to_string()));
    }
    Ok(true)
}

fn init_ident(c: ref Cls, it: mut ref Inst, v: ref Val) -> Result[bool, Exc] {
    if not is_none(v) {
        it.ident = norm_ident(c, v)?;
    } else if it.use_defaults {
        it.ident = c.default_ident.clone();
    } else {
        return Err(type_error("no ident specified".to_string()));
    }
    Ok(true)
}

// cls(**kwds): each mixin's __init__ runs after its base's, so the
// settings are checked in the reverse of the class's method order.
fn construct(w: mut ref World, ci: i64, a: ref CArgs) -> Result[Inst, Exc] {
    let c = w.cls[ci].clone();
    let mut it = new_inst(c, a);
    let k = c.kind;
    if k == K_BSHA and not is_none(a.version) {
        it.version = norm_version(c, a.version)?;
    }
    if not is_none(a.checksum) {
        it.checksum = norm_checksum(mut w, c, a.checksum)?;
    }
    if k == K_SCRYPT {
        init_ident(c, mut it, a.ident)?;
        init_salt(mut w, c, mut it, a.salt)?;
        init_rounds(mut w, c, mut it, a.rounds)?;
        if not is_none(a.parallelism) {
            it.parallelism = norm_integer(mut w, c.name, a.parallelism, 1, -1, "parallelism", false)?;
        }
        if not is_none(a.block_size) {
            it.block_size = norm_integer(mut w, c.name, a.block_size, 1, -1, "block_size", false)?;
        }
        return Ok(it);
    }
    if k == K_CISCO7 {
        if not is_none(a.salt) {
            it.salt = Val.Int(cisco_norm_salt(mut w, a.salt, false)?);
        } else if it.use_defaults {
            it.salt = if is_none(c.fixed_salt) { Val.Int(randint(mut w, 0, 15)) } else { c.fixed_salt.clone() };
        } else {
            return Err(type_error("no salt specified".to_string()));
        }
        return Ok(it);
    }
    if c.salt_kind > 0 {
        init_salt(mut w, c, mut it, a.salt)?;
    }
    if c.has_rounds {
        init_rounds(mut w, c, mut it, a.rounds)?;
    }
    if has_idents(c) {
        init_ident(c, mut it, a.ident)?;
    }
    if k == K_SHA256 or k == K_SHA512 {
        it.implicit_rounds = if is_none(a.implicit_rounds) { it.use_defaults and it.rounds == 5000 } else { truthy(a.implicit_rounds) };
    }
    Ok(it)
}

fn cisco_norm_salt(w: mut ref World, v: ref Val, relaxed: bool) -> Result[i64, Exc] {
    if not is_int(v) {
        return Err(expected_type(v, "integer", "salt"));
    }
    let mut n = int_val(v);
    if n < 0 or n > 52 {
        let msg = "salt/offset must be in 0..52 range".to_string();
        if not relaxed {
            return Err(value_error(msg));
        }
        warn(mut w, "PasslibHashWarning", msg);
        n = if n < 0 { 0 } else { 52 };
    }
    Ok(n)
}

// ------------------------------------------------------------ parsing a hash

fn split_mc(rest: ref String, sep: char) -> Vec[String] {
    split_on(rest, sep)
}

// parse_mc2: (salt, checksum or None).
fn parse_mc2(name: ref String, h: ref String, prefix: ref String, sep: char) -> Result[(Val, Val), Exc] {
    if not h.starts_with(prefix) {
        return Err(invalid_hash(name));
    }
    let parts = split_mc(str_from(h, clen(prefix)), sep);
    if parts.len() == 2 {
        let chk = if parts[1].len() > 0 { Val.Str(parts[1].clone()) } else { Val.Non };
        return Ok((Val.Str(parts[0].clone()), chk));
    }
    if parts.len() == 1 {
        return Ok((Val.Str(parts[0].clone()), Val.Non));
    }
    Err(malformed(name))
}

// parse_mc3: (rounds, salt, checksum or None).
fn parse_mc3(name: ref String, h: ref String, prefix: ref String, sep: char, base: i64, dflt: i64) -> Result[(i64, String, Val), Exc] {
    if not h.starts_with(prefix) {
        return Err(invalid_hash(name));
    }
    let parts = split_mc(str_from(h, clen(prefix)), sep);
    let mut chk = Val.Non;
    if parts.len() == 3 {
        if parts[2].len() > 0 {
            chk = Val.Str(parts[2].clone());
        }
    } else if parts.len() != 2 {
        return Err(malformed(name));
    }
    let rs = parts[0].clone();
    let mut rounds = dflt;
    if rs.starts_with("0") and rs != "0" {
        return Err(zero_padded(name));
    } else if rs.len() > 0 {
        rounds = if base == 16 { py_int16(rs)? } else { py_int(rs)? };
    } else if dflt < 0 {
        return Err(malformed_r(name, "empty rounds field"));
    }
    Ok((rounds, parts[1].clone(), chk))
}

fn render_mc2(ident: ref String, salt: ref String, chk: ref Val, sep: Str) -> String {
    if truthy(chk) {
        f"{ident}{salt}{sep}{str_val(chk)}"
    } else {
        f"{ident}{salt}"
    }
}

fn render_mc3(ident: ref String, rounds: i64, salt: ref String, chk: ref Val, sep: Str, base: i64) -> String {
    let r = if rounds < 0 { String.new() } else if base == 16 { hexn(rounds, 1) } else { f"{rounds}" };
    if truthy(chk) {
        f"{ident}{r}{sep}{salt}{sep}{str_val(chk)}"
    } else {
        f"{ident}{r}{sep}{salt}"
    }
}

fn ident_str(c: ref Cls) -> String {
    str_val(c.ident)
}

fn parse_ident(c: ref Cls, h: ref String) -> Result[(String, String), Exc] {
    for id in c.ident_values {
        if h.starts_with(id) {
            return Ok((id.clone(), str_from(h, clen(id))));
        }
    }
    Err(invalid_hash(c.name))
}

fn str_or_none(s: ref String) -> Val {
    if s.len() > 0 { Val.Str(s.clone()) } else { Val.Non }
}

fn bytes_or_none(b: ref Vec[u8]) -> Val {
    Val.Bytes(b.clone())
}

// h64's decode_int24 / int6 / int12 over a string.
fn h64_int(s: ref String) -> Result[i64, Exc] {
    decode_small(h64(), s)
}

// from_string's keyword arguments to the constructor.
fn parse_args(w: mut ref World, ci: i64, hv: ref Val) -> Result[CArgs, Exc] {
    let c = w.cls[ci].clone();
    let k = c.kind;
    let name = c.name.clone();
    let mut a = cargs();
    let h = to_unicode(hv, "hash")?;
    if k <= K_HEX_SHA512 {
        a.checksum = Val.Str(ascii_lower(h));
    } else if k == K_LDAP_MD5 or k == K_LDAP_SHA1 {
        let p = ident_str(c);
        if not h.starts_with(p) {
            return Err(invalid_hash(name));
        }
        a.checksum = Val.Str(str_from(h, clen(p)));
    } else if k >= K_LDAP_SMD5 and k <= K_LDAP_SSHA512 {
        let p = ident_str(c);
        let mins: Vec[i64] = [27, 32, 48, 91].to_vec();
        let body = str_from(h, clen(p));
        let mut ok = h.starts_with(p);
        let cs = chars(body);
        let mut n = cs.len();
        let mut pad = 0;
        while n > 0 and cs[n - 1] == '=' and pad < 2 {
            n -= 1;
            pad += 1;
        }
        if n < mins[k - K_LDAP_SMD5] {
            ok = false;
        }
        let mut i = 0;
        while i < n {
            if not (is_alpha(cs[i]) or is_digit(cs[i]) or cs[i] == '+' or cs[i] == '/') {
                ok = false;
            }
            i += 1;
        }
        if not ok {
            return Err(invalid_hash(name));
        }
        let data = b64decode(body)?;
        let size = c.checksum_size;
        a.checksum = Val.Bytes(sub(data, 0, size));
        a.salt = Val.Bytes(sub(data, size, data.len()));
    } else if k == K_DES {
        a.salt = Val.Str(substr(h, 0, 2));
        a.checksum = str_or_none(str_from(h, 2));
    } else if k == K_BSDI {
        let n = clen(h);
        if not ((n == 9 or n == 20) and h.starts_with("_") and all_h64(str_from(h, 1))) {
            return Err(invalid_hash(name));
        }
        a.rounds = Val.Int(h64_int(substr(h, 1, 5))?);
        a.salt = Val.Str(substr(h, 5, 9));
        a.checksum = str_or_none(str_from(h, 9));
    } else if k == K_BIGCRYPT or k == K_CRYPT16 {
        let n = clen(h);
        let shape = if k == K_BIGCRYPT { n >= 2 and (n - 2) % 11 == 0 } else { n == 2 or n == 24 };
        if not (shape and all_h64(h)) {
            return Err(invalid_hash(name));
        }
        a.salt = Val.Str(substr(h, 0, 2));
        a.checksum = str_or_none(str_from(h, 2));
    } else if k == K_MD5 or k == K_APR or k == K_DJ_SHA1 or k == K_DJ_MD5 {
        let (salt, chk) = parse_mc2(name, h, ident_str(c), '$')?;
        a.salt = salt;
        a.checksum = chk;
    } else if k == K_SHA256 or k == K_SHA512 {
        let p = ident_str(c);
        if not h.starts_with(p) {
            return Err(invalid_hash(name));
        }
        let mut parts = split_on(str_from(h, 3), '$');
        if parts[0].starts_with("rounds=") {
            let rs = str_from(parts.remove(0), 7);
            if rs.starts_with("0") and rs != "0" {
                return Err(zero_padded(name));
            }
            a.rounds = Val.Int(py_int(rs)?);
            a.implicit_rounds = Val.Bool(false);
        } else {
            a.rounds = Val.Int(5000);
            a.implicit_rounds = Val.Bool(true);
        }
        if parts.len() == 2 {
            a.salt = Val.Str(parts[0].clone());
            a.checksum = str_or_none(parts[1]);
        } else if parts.len() == 1 {
            a.salt = Val.Str(parts[0].clone());
        } else {
            return Err(malformed(name));
        }
    } else if k == K_SHA1C {
        let (r, salt, chk) = parse_mc3(name, h, ident_str(c), '$', 10, -1)?;
        a.rounds = Val.Int(r);
        a.salt = Val.Str(salt);
        a.checksum = chk;
    } else if k == K_BCRYPT {
        let (ident, tail) = parse_ident(c, h)?;
        if ident == "$2x$" {
            return Err(value_error("crypt_blowfish's buggy '2x' hashes are not currently supported".to_string()));
        }
        let parts = split_on(tail, '$');
        if parts.len() > 2 {
            return Err(value_error("too many values to unpack (expected 2)".to_string()));
        }
        if parts.len() < 2 {
            return Err(value_error(f"not enough values to unpack (expected 2, got {parts.len()})"));
        }
        let r = py_int(parts[0])?;
        if parts[0] != zpad2(r) {
            return Err(malformed_r(name, "malformed cost field"));
        }
        a.rounds = Val.Int(r);
        a.salt = Val.Str(substr(parts[1], 0, 22));
        a.checksum = str_or_none(str_from(parts[1], 22));
        a.ident = Val.Str(ident);
    } else if k == K_BSHA {
        bsha_parse(c, h, mut a)?;
    } else if k == K_SCRYPT {
        scrypt_parse(c, h, mut a)?;
    } else if k >= K_PBKDF2_SHA1 and k <= K_PBKDF2_SHA512 {
        let (r, salt, chk) = parse_mc3(name, h, ident_str(c), '$', 10, -1)?;
        a.rounds = Val.Int(r);
        a.salt = Val.Bytes(ab64_decode(salt)?);
        if truthy(chk) {
            a.checksum = Val.Bytes(ab64_decode(str_val(chk))?);
        }
    } else if k == K_CTA {
        let (r, salt, chk) = parse_mc3(name, h, ident_str(c), '$', 16, -1)?;
        a.rounds = Val.Int(r);
        a.salt = Val.Bytes(b64decode_alt(salt, "-_")?);
        if truthy(chk) {
            a.checksum = Val.Bytes(b64decode_alt(str_val(chk), "-_")?);
        }
    } else if k == K_DLITZ {
        let (r, salt, chk) = parse_mc3(name, h, ident_str(c), '$', 16, 400)?;
        a.rounds = Val.Int(r);
        a.salt = Val.Str(salt);
        a.checksum = chk;
    } else if k == K_GRUB {
        let (r, salt, chk) = parse_mc3(name, h, ident_str(c), '.', 10, -1)?;
        a.rounds = Val.Int(r);
        a.salt = Val.Bytes(unhexlify(salt)?);
        if truthy(chk) {
            a.checksum = Val.Bytes(unhexlify(str_val(chk))?);
        }
    } else if k == K_ATLASSIAN {
        let p = ident_str(c);
        if not h.starts_with(p) {
            return Err(invalid_hash(name));
        }
        let data = b64decode(str_from(h, clen(p)))?;
        a.salt = Val.Bytes(sub(data, 0, 16));
        a.checksum = Val.Bytes(sub(data, 16, data.len()));
    } else if k == K_PHPASS {
        let (ident, data) = parse_ident(c, h)?;
        let cs = chars(data);
        if cs.len() == 0 {
            return Err(exc("IndexError", "string index out of range".to_string()));
        }
        a.ident = Val.Str(ident);
        a.rounds = Val.Int(h64_int(substr(data, 0, 1))?);
        a.salt = Val.Str(substr(data, 1, 9));
        a.checksum = str_or_none(str_from(data, 9));
    } else if k == K_MYSQL323 {
        a.checksum = Val.Str(ascii_lower(h));
    } else if k == K_MYSQL41 {
        let up = ascii_upper(h);
        if not up.starts_with("*") {
            return Err(invalid_hash(name));
        }
        a.checksum = Val.Str(str_from(up, 1));
    } else if k == K_POSTGRES {
        if not h.starts_with("md5") {
            return Err(invalid_hash(name));
        }
        a.checksum = Val.Str(str_from(h, 3));
    } else if k == K_NTHASH or k == K_LMHASH or k == K_MSDCC {
        a.checksum = Val.Str(ascii_lower(h));
    } else if k == K_PIX or k == K_ASA {
        a.checksum = Val.Str(h);
    } else if k == K_CISCO7 {
        if clen(h) < 2 {
            return Err(invalid_hash(name));
        }
        a.salt = Val.Int(py_int(substr(h, 0, 2))?);
        a.checksum = Val.Str(ascii_upper(str_from(h, 2)));
    } else if k == K_DJ_PBKDF2_SHA256 or k == K_DJ_PBKDF2_SHA1 {
        let (r, salt, chk) = parse_mc3(name, h, ident_str(c), '$', 10, -1)?;
        a.rounds = Val.Int(r);
        a.salt = Val.Str(salt);
        a.checksum = chk;
    } else if k == K_DJ_DISABLED {
        if not h.starts_with("!") {
            return Err(invalid_hash(name));
        }
        a.checksum = Val.Str(str_from(h, 1));
    }
    Ok(a)
}

// "$bcrypt-sha256$v=2,t=2b,r=12$<salt>$<digest>" or the v1 form
// "$bcrypt-sha256$2a,12$<salt>$<digest>".
fn bsha_parse(c: ref Cls, h: ref String, a: mut ref CArgs) -> Result[bool, Exc] {
    let name = c.name.clone();
    let prefix = "$bcrypt-sha256$";
    if not h.starts_with(prefix) {
        return Err(invalid_hash(name));
    }
    let rest = str_from(h, clen(prefix));
    let parts = split_on(rest, '$');
    let tail_ok = (parts.len() == 2 or parts.len() == 3) and clen(parts[1]) == 22 and (parts.len() == 2 or clen(parts[2]) == 31);
    let head = parts[0].clone();
    let mut version: i64 = -1;
    let mut ty = String.new();
    let mut rs = String.new();
    if tail_ok and head.starts_with("v=") {
        let f = split_on(head, ',');
        if f.len() == 3 and f[1] == "t=2b" and f[2].starts_with("r=") {
            let vs = str_from(f[0], 2);
            let r = str_from(f[2], 2);
            if clen(vs) > 0 and all_digits(vs) and clen(r) >= 1 and clen(r) <= 2 and all_digits(r) {
                version = py_int(vs)?;
                if version < 2 {
                    return Err(malformed(name));
                }
                ty = "2b".to_string();
                rs = r;
            }
        }
    }
    if version < 0 and tail_ok {
        let f = split_on(head, ',');
        if f.len() == 2 and (f[0] == "2a" or f[0] == "2b") and clen(f[1]) >= 1 and clen(f[1]) <= 2 and all_digits(f[1]) {
            version = 1;
            ty = f[0].clone();
            rs = f[1].clone();
        }
    }
    if version < 0 {
        return Err(malformed(name));
    }
    if rs.starts_with("0") and rs != "0" {
        return Err(zero_padded(name));
    }
    a.version = Val.Int(version);
    a.ident = Val.Str(ty);
    a.rounds = Val.Int(py_int(rs)?);
    a.salt = Val.Str(parts[1].clone());
    if parts.len() == 3 {
        a.checksum = Val.Str(parts[2].clone());
    }
    Ok(true)
}

fn all_digits(s: ref String) -> bool {
    for c in s.chars() {
        if not is_digit(c) {
            return false;
        }
    }
    true
}

fn scrypt_parse(c: ref Cls, h: ref String, a: mut ref CArgs) -> Result[bool, Exc] {
    let name = c.name.clone();
    let (ident, suffix) = parse_ident(c, h)?;
    a.ident = Val.Str(ident.clone());
    if ident == "$scrypt$" {
        let parts = split_on(suffix, '$');
        if parts.len() != 2 and parts.len() != 3 {
            return Err(malformed_r(name, "malformed hash"));
        }
        let ps = split_on(parts[0], ',');
        if ps.len() != 3 {
            return Err(malformed_r(name, "malformed settings field"));
        }
        a.rounds = Val.Int(py_int(str_from(ps[0], 3))?);
        a.block_size = Val.Int(py_int(str_from(ps[1], 2))?);
        a.parallelism = Val.Int(py_int(str_from(ps[2], 2))?);
        a.salt = Val.Bytes(b64s_decode(parts[1])?);
        if parts.len() == 3 and parts[2].len() > 0 {
            a.checksum = Val.Bytes(b64s_decode(parts[2])?);
        }
        return Ok(true);
    }
    let parts = split_on(suffix, '$');
    if parts.len() > 2 {
        return Err(value_error("malformed <unnamed> hash".to_string()));
    }
    let params = parts[0].clone();
    if clen(params) < 11 {
        return Err(malformed_r(name, "params field too short"));
    }
    a.rounds = Val.Int(h64_int(substr(params, 0, 1))?);
    a.block_size = Val.Int(decode_int(h64(), substr(params, 1, 6), 30)?);
    a.parallelism = Val.Int(decode_int(h64(), substr(params, 6, 11), 30)?);
    a.salt = Val.Bytes(str_from(params, 11).bytes().to_vec());
    if parts.len() == 2 and parts[1].len() > 0 {
        a.checksum = Val.Bytes(decode_bytes(h64(), parts[1])?);
    }
    Ok(true)
}

fn from_string(w: mut ref World, ci: i64, hv: ref Val, ctx: ref Kw) -> Result[Inst, Exc] {
    let mut a = parse_args(mut w, ci, hv)?;
    a.user = kw_get(ctx, "user");
    a.encoding = kw_get(ctx, "encoding");
    construct(mut w, ci, a)
}

// ------------------------------------------------------------ rendering a hash

fn to_string(w: ref World, ci: i64, it: ref Inst) -> String {
    let c = w.cls[ci].clone();
    let k = c.kind;
    let chk = str_val(it.checksum);
    let salt = str_val(it.salt);
    if k <= K_HEX_SHA512 or k == K_MYSQL323 or k == K_NTHASH or k == K_LMHASH or k == K_MSDCC or k == K_PIX or k == K_ASA {
        return chk;
    }
    if k == K_LDAP_MD5 or k == K_LDAP_SHA1 {
        return f"{ident_str(c)}{chk}";
    }
    if k >= K_LDAP_SMD5 and k <= K_LDAP_SSHA512 {
        return f"{ident_str(c)}{b64encode(cat(bytes_val(it.checksum), bytes_val(it.salt)))}";
    }
    if k == K_DES or k == K_BIGCRYPT or k == K_CRYPT16 {
        return f"{salt}{py_str(it.checksum)}";
    }
    if k == K_BSDI {
        return f"_{encode_int24(h64(), it.rounds)}{salt}{py_str(it.checksum)}";
    }
    if k == K_MD5 or k == K_APR or k == K_DJ_SHA1 or k == K_DJ_MD5 {
        return render_mc2(ident_str(c), salt, it.checksum, "$");
    }
    if k == K_SHA256 or k == K_SHA512 {
        if it.rounds == 5000 and it.implicit_rounds {
            return f"{ident_str(c)}{salt}${chk}";
        }
        return f"{ident_str(c)}rounds={it.rounds}${salt}${chk}";
    }
    if k == K_SHA1C or k == K_DJ_PBKDF2_SHA256 or k == K_DJ_PBKDF2_SHA1 {
        return render_mc3(ident_str(c), it.rounds, salt, it.checksum, "$", 10);
    }
    if k == K_BCRYPT {
        return f"{it.ident}{zpad2(it.rounds)}${salt}{py_str(it.checksum)}";
    }
    if k == K_BSHA {
        let t = substr(it.ident, 1, clen(it.ident) - 1);
        if it.version == 1 {
            return f"$bcrypt-sha256${t},{it.rounds}${salt}${py_str(it.checksum)}";
        }
        return f"$bcrypt-sha256$v=2,t={t},r={it.rounds}${salt}${py_str(it.checksum)}";
    }
    if k == K_SCRYPT {
        let sb = bytes_val(it.salt);
        let cb = bytes_val(it.checksum);
        if it.ident == "$scrypt$" {
            return f"$scrypt$ln={it.rounds},r={it.block_size},p={it.parallelism}${b64s_encode(sb)}${b64s_encode(cb)}";
        }
        return f"$7${encode_int6(h64(), it.rounds)}{encode_int(h64(), it.block_size as u64, 30)}{encode_int(h64(), it.parallelism as u64, 30)}{latin1_text(sb)}${encode_bytes(h64(), cb)}";
    }
    if k >= K_PBKDF2_SHA1 and k <= K_PBKDF2_SHA512 {
        let cv = if is_none(it.checksum) { Val.Non } else { Val.Str(ab64_encode(bytes_val(it.checksum))) };
        return render_mc3(ident_str(c), it.rounds, ab64_encode(bytes_val(it.salt)), cv, "$", 10);
    }
    if k == K_CTA {
        let cv = if is_none(it.checksum) { Val.Non } else { Val.Str(b64encode_alt(bytes_val(it.checksum), "-_")) };
        return render_mc3(ident_str(c), it.rounds, b64encode_alt(bytes_val(it.salt), "-_"), cv, "$", 16);
    }
    if k == K_DLITZ {
        let r = if it.rounds == 400 { -1 } else { it.rounds };
        return render_mc3(ident_str(c), r, salt, it.checksum, "$", 16);
    }
    if k == K_GRUB {
        let cv = if is_none(it.checksum) { Val.Non } else { Val.Str(ascii_upper(hex_of(bytes_val(it.checksum)))) };
        return render_mc3(ident_str(c), it.rounds, ascii_upper(hex_of(bytes_val(it.salt))), cv, ".", 10);
    }
    if k == K_ATLASSIAN {
        return f"{ident_str(c)}{b64encode(cat(bytes_val(it.salt), bytes_val(it.checksum)))}";
    }
    if k == K_PHPASS {
        return f"{it.ident}{encode_int6(h64(), it.rounds)}{salt}{py_str(it.checksum)}";
    }
    if k == K_MYSQL41 {
        return f"*{ascii_upper(chk)}";
    }
    if k == K_POSTGRES {
        return f"md5{chk}";
    }
    if k == K_CISCO7 {
        return f"{zpad2(int_val(it.salt))}{chk}";
    }
    if k == K_DJ_DISABLED {
        return f"!{chk}";
    }
    chk
}

// str() of a str-or-None, as "%s" renders it.
fn py_str(v: ref Val) -> String {
    match v {
        Val.Non => "None".to_string(),
        other => str_val(other),
    }
}

// ------------------------------------------------------------ computing a checksum

fn utf8_secret(v: ref Val) -> Vec[u8] {
    bytes_val(v)
}

fn calc(w: mut ref World, ci: i64, it: ref Inst, secret: ref Val) -> Result[Val, Exc] {
    let c = w.cls[ci].clone();
    let k = c.kind;
    let sb = utf8_secret(secret);
    let salt = str_val(it.salt);
    if k <= K_HEX_SHA512 {
        let kinds: Vec[i64] = [D_MD4, D_MD5, D_SHA1, D_SHA256, D_SHA512].to_vec();
        return Ok(Val.Str(hex_of(digest(kinds[k], sb))));
    }
    if k == K_LDAP_MD5 or k == K_LDAP_SHA1 {
        return Ok(Val.Str(b64encode(digest(if k == K_LDAP_MD5 { D_MD5 } else { D_SHA1 }, sb))));
    }
    if k >= K_LDAP_SMD5 and k <= K_LDAP_SSHA512 {
        let kinds: Vec[i64] = [D_MD5, D_SHA1, D_SHA256, D_SHA512].to_vec();
        return Ok(Val.Bytes(digest(kinds[k - K_LDAP_SMD5], cat(sb, bytes_val(it.salt)))));
    }
    if k == K_DES {
        if it.use_defaults {
            check_truncate(c, sec_len(secret))?;
        }
        if has_nul(sb) {
            return Err(null_pw("des_crypt"));
        }
        let h = raw_des_crypt(w.des, sb, salt)?;
        return Ok(Val.Str(h));
    }
    if k == K_BSDI {
        if has_nul(sb) {
            return Err(null_pw("bsdi_crypt"));
        }
        let key = bsdi_secret_to_key(w.des, sb);
        let sv_ = h64_int(salt)?;
        let r = des_encrypt_int_block(w.des, key, 0u64, sv_, it.rounds);
        return Ok(Val.Str(encode_int(h64big(), r, 64)));
    }
    if k == K_BIGCRYPT {
        if has_nul(sb) {
            return Err(null_pw("des_crypt"));
        }
        let mut chk = raw_des_crypt(w.des, sb, salt)?;
        let mut idx = 8;
        while idx < sb.len() {
            let nx = idx + 8;
            let n = clen(chk);
            let more = raw_des_crypt(w.des, sub(sb, idx, if nx < sb.len() { nx } else { sb.len() }), substr(chk, n - 11, n - 9))?;
            chk = f"{chk}{more}";
            idx = nx;
        }
        return Ok(Val.Str(chk));
    }
    if k == K_CRYPT16 {
        if it.use_defaults {
            check_truncate(c, sb.len())?;
        }
        let sv_ = h64_int(salt)?;
        let key1 = crypt_secret_to_key(sb, 0);
        let r1 = des_encrypt_int_block(w.des, key1, 0u64, sv_, 20);
        let key2 = crypt_secret_to_key(sb, 8);
        let r2 = des_encrypt_int_block(w.des, key2, 0u64, sv_, 5);
        return Ok(Val.Str(f"{encode_int(h64big(), r1, 64)}{encode_int(h64big(), r2, 64)}"));
    }
    if k == K_MD5 or k == K_APR {
        if has_nul(sb) {
            return Err(null_pw("md5_crypt"));
        }
        return Ok(Val.Str(raw_md5_crypt(sb, salt, k == K_APR)));
    }
    if k == K_SHA256 or k == K_SHA512 {
        if has_nul(sb) {
            return Err(null_pw(c.name));
        }
        return Ok(Val.Str(raw_sha2_crypt(sb, salt, it.rounds, k == K_SHA512)));
    }
    if k == K_SHA1C {
        if has_nul(sb) {
            return Err(null_pw(c.name));
        }
        return Ok(Val.Str(raw_sha1_crypt(sb, salt, it.rounds)));
    }
    if k == K_BCRYPT or k == K_BSHA {
        let mut key = sb.clone();
        if k == K_BSHA {
            if it.version == 1 {
                key = str_bytes_of(b64encode(digest(D_SHA256, sb)));
            } else {
                let cs = chars(salt);
                if not has_char(".Oeu", cs[cs.len() - 1]) {
                    return Err(value_error("invalid salt string".to_string()));
                }
                let mac = hmac_run(hmac_key(D_SHA256, str_bytes_of(salt)), sb);
                key = str_bytes_of(b64encode(mac));
            }
        }
        validate_secret(Val.Bytes(key.clone()))?;
        if k == K_BCRYPT and it.use_defaults {
            check_truncate(c, key.len())?;
        }
        if has_nul(key) {
            return Err(null_pw(c.name));
        }
        let id = substr(it.ident, 1, clen(it.ident) - 1);
        let full = raw_bcrypt(key, id, salt, it.rounds)?;
        let n = clen(full);
        return Ok(Val.Str(substr(full, n - 31, n)));
    }
    if k == K_SCRYPT {
        return Ok(Val.Bytes(scrypt_kdf(sb, bytes_val(it.salt), 1 << it.rounds, it.block_size, it.parallelism, 32)));
    }
    if k >= K_PBKDF2_SHA1 and k <= K_PBKDF2_SHA512 {
        let kinds: Vec[i64] = [D_SHA1, D_SHA256, D_SHA512].to_vec();
        return Ok(Val.Bytes(pbkdf2_hmac(kinds[k - K_PBKDF2_SHA1], sb, bytes_val(it.salt), it.rounds, c.checksum_size)));
    }
    if k == K_CTA {
        return Ok(Val.Bytes(pbkdf2_hmac(D_SHA1, sb, bytes_val(it.salt), it.rounds, 20)));
    }
    if k == K_DLITZ {
        let r = if it.rounds == 400 { -1 } else { it.rounds };
        let config = render_mc3(ident_str(c), r, salt, Val.Non, "$", 16);
        return Ok(Val.Str(ab64_encode(pbkdf2_hmac(D_SHA1, sb, str_bytes_of(config), it.rounds, 24))));
    }
    if k == K_GRUB {
        return Ok(Val.Bytes(pbkdf2_hmac(D_SHA512, sb, bytes_val(it.salt), it.rounds, 64)));
    }
    if k == K_ATLASSIAN {
        return Ok(Val.Bytes(pbkdf2_hmac(D_SHA1, sb, bytes_val(it.salt), 10000, 32)));
    }
    if k == K_PHPASS {
        let mut r = digest(D_MD5, cat(str_bytes_of(salt), sb));
        let mut n = 1 << it.rounds;
        while n > 0 {
            r = digest(D_MD5, cat(r, sb));
            n -= 1;
        }
        return Ok(Val.Str(encode_bytes(h64(), r)));
    }
    if k == K_MYSQL323 {
        return Ok(Val.Str(mysql323(sb)));
    }
    if k == K_MYSQL41 {
        return Ok(Val.Str(ascii_upper(hex_of(digest(D_SHA1, digest(D_SHA1, sb))))));
    }
    if k == K_POSTGRES {
        if is_none(it.user) {
            return Err(expected_string(it.user, "user"));
        }
        let user = to_bytes_param(it.user, "user")?;
        return Ok(Val.Str(hex_of(digest(D_MD5, cat(sb, user)))));
    }
    if k == K_NTHASH {
        return Ok(Val.Str(hex_of(nthash_raw(secret)?)));
    }
    if k == K_LMHASH {
        if it.use_defaults {
            check_truncate(c, sec_len(secret))?;
        }
        return Ok(Val.Str(hex_of(lmhash_raw(w, secret, it.encoding)?)));
    }
    if k == K_MSDCC {
        if is_none(it.user) {
            return Err(expected_string(it.user, "user"));
        }
        let user = str_val(it.user);
        let inner = md4(utf16le(str_val_secret(secret)));
        return Ok(Val.Str(hex_of(md4(cat(inner, utf16le(lower_text(user)))))));
    }
    if k == K_PIX or k == K_ASA {
        return pix_calc(c, it, secret);
    }
    if k == K_CISCO7 {
        return Ok(Val.Str(cisco7_encode(sb, int_val(it.salt))));
    }
    if k == K_DJ_SHA1 or k == K_DJ_MD5 {
        let d = if k == K_DJ_SHA1 { D_SHA1 } else { D_MD5 };
        return Ok(Val.Str(hex_of(digest(d, cat(str_bytes_of(salt), sb)))));
    }
    if k == K_DJ_PBKDF2_SHA256 or k == K_DJ_PBKDF2_SHA1 {
        let d = if k == K_DJ_PBKDF2_SHA256 { D_SHA256 } else { D_SHA1 };
        return Ok(Val.Str(b64encode(pbkdf2_hmac(d, sb, str_bytes_of(salt), it.rounds, digest_size(d)))));
    }
    if k == K_DJ_DISABLED {
        let cs = substr(BASE64_CHARS.to_string(), 0, 62);
        return Ok(Val.Str(getrandstr(mut w, cs, 40)));
    }
    Ok(Val.Non)
}

fn str_bytes_of(s: ref String) -> Vec[u8] {
    s.bytes().to_vec()
}

fn str_val_secret(v: ref Val) -> String {
    match v {
        Val.Bytes(b) => utf8_text(b),
        other => str_val(other),
    }
}

// bytes.decode("utf-8") for well-formed input.
fn utf8_text(b: ref Vec[u8]) -> String {
    match String.from_utf8(b.clone()) {
        Ok(s) => s,
        Err(_) => latin1_text(b),
    }
}

fn lower_text(s: ref String) -> String {
    s.to_lowercase()
}

fn utf16le(s: ref String) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for c in s.chars() {
        let mut n = c as i64;
        if n >= 0x10000 {
            n -= 0x10000;
            let hi = 0xD800 + (n >> 10);
            let lo = 0xDC00 + (n & 0x3FF);
            out.push((hi & 255) as u8);
            out.push((hi >> 8) as u8);
            out.push((lo & 255) as u8);
            out.push((lo >> 8) as u8);
        } else {
            out.push((n & 255) as u8);
            out.push((n >> 8) as u8);
        }
    }
    out
}

fn to_bytes_param(v: ref Val, param: Str) -> Result[Vec[u8], Exc] {
    match v {
        Val.Str(s) => Ok(utf8_of(s)),
        Val.Bytes(b) => Ok(b.clone()),
        _ => Err(expected_string(v, param)),
    }
}

fn nthash_raw(secret: ref Val) -> Result[Vec[u8], Exc] {
    let s = match secret {
        Val.Str(s) => s.clone(),
        Val.Bytes(b) => utf8_text(b),
        _ => {
            return Err(expected_string(secret, "secret"));
        }
    };
    Ok(md4(utf16le(s)))
}

fn mysql323(sb: ref Vec[u8]) -> String {
    let mask: i64 = 0x7fffffff;
    let mut nr1: i64 = 0x50305735;
    let mut nr2: i64 = 0x12345671;
    let mut add: i64 = 7;
    for c in sb {
        if c == b' ' or c == b'\t' {
            continue;
        }
        let t = c as i64;
        nr1 = nr1 ^ ((((nr1 & 63) + add) * t + (nr1 << 8)) & 0xffffffff);
        nr2 = (nr2 + ((nr2 << 8) ^ nr1)) & 0xffffffff;
        add = (add + t) & 0xffffffff;
    }
    f"{hexn(nr1 & mask, 8)}{hexn(nr2 & mask, 8)}"
}

// cp437 for the characters a job can hand lmhash: ASCII, plus the Latin-1
// letters cp437 holds.
fn cp437_byte(c: char) -> i64 {
    let n = c as i64;
    if n < 128 {
        return n;
    }
    let table: Vec[i64] = [0xC7, 0xFC, 0xE9, 0xE2, 0xE4, 0xE0, 0xE5, 0xE7, 0xEA, 0xEB, 0xE8, 0xEF, 0xEE, 0xEC, 0xC4, 0xC5, 0xC9, 0xE6, 0xC6, 0xF4, 0xF6, 0xF2, 0xFB, 0xF9, 0xFF, 0xD6, 0xDC].to_vec();
    let mut i = 0;
    while i < table.len() {
        if table[i] == n {
            return 128 + i;
        }
        i += 1;
    }
    -1
}

fn lmhash_raw(w: ref World, secret: ref Val, encoding: ref String) -> Result[Vec[u8], Exc] {
    let mut sb: Vec[u8] = Vec.new();
    match secret {
        Val.Str(s) => {
            let up = s.to_uppercase();
            if encoding == "cp437" {
                for c in up.chars() {
                    let b = cp437_byte(c);
                    if b < 0 {
                        return Err(exc("UnicodeEncodeError", f"'charmap' codec can't encode character {char_escape(c)} in position 0: character maps to <undefined>"));
                    }
                    sb.push(b as u8);
                }
            } else {
                sb = utf8_of(up);
            }
        }
        Val.Bytes(b) => {
            for x in b {
                sb.push(if x >= b'a' and x <= b'z' { x - 32 } else { x });
            }
        }
        _ => {
            return Err(type_error("secret must be unicode or bytes".to_string()));
        }
    }
    while sb.len() < 14 {
        sb.push(0);
    }
    let key = sub(sb, 0, 14);
    let magic = str_bytes("KGS!@#$%");
    Ok(cat(des_encrypt_block7(w.des, sub(key, 0, 7), magic), des_encrypt_block7(w.des, sub(key, 7, 14), magic)))
}

fn char_escape(c: char) -> String {
    let n = c as i64;
    if n < 256 { f"'\\x{hex2(n)}'" } else if n < 0x10000 { f"'\\u{hexn(n, 4)}'" } else { f"'\\U{hexn(n, 8)}'" }
}

fn pix_calc(c: ref Cls, it: ref Inst, secret: ref Val) -> Result[Val, Exc] {
    let asa = c.kind == K_ASA;
    let mut sb = bytes_val(secret);
    let mut spoil: Vec[u8] = Vec.new();
    if sb.len() > c.truncate_size {
        if it.use_defaults {
            return Err(exc("PasswordSizeError", f"Password too long ({c.name} allows at most {c.truncate_size} bytes)"));
        }
        spoil = sb.clone();
        let mut i = 0;
        while i < 32 {
            spoil.push(0xff);
            i += 1;
        }
    }
    if truthy(it.user) {
        let user = to_bytes_param(it.user, "user")?;
        if not asa or sb.len() < 28 {
            sb = cat(sb, repeat_bytes(user, 4));
        }
    }
    let pad = if asa and sb.len() > 16 { 32 } else { 16 };
    if sb.len() < pad {
        while sb.len() < pad {
            sb.push(0);
        }
    } else {
        sb = sub(sb, 0, pad);
    }
    sb = cat(sb, spoil);
    let d = digest(D_MD5, sb);
    let mut kept: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < d.len() {
        if ((i + 1) & 3) != 0 {
            kept.push(d[i]);
        }
        i += 1;
    }
    Ok(Val.Str(encode_bytes(h64(), kept)))
}

const CISCO_KEY: Str = "dsfd;kfoA,.iyewrkldJKDHSUBsgvca69834ncxv9873254k;fg87";

fn cisco7_encode(sb: ref Vec[u8], salt: i64) -> String {
    let key = CISCO_KEY.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < sb.len() {
        out.push(sb[i] ^ key[(salt + i) % 53]);
        i += 1;
    }
    ascii_upper(hex_of(out))
}

// ------------------------------------------------------------ text encodings

fn encode_text(s: ref String, enc: ref String) -> Result[Vec[u8], Exc] {
    let e = ascii_lower(enc);
    if e == "utf-8" or e == "utf8" {
        return Ok(utf8_of(s));
    }
    let limit = if e == "ascii" { 128 } else { 256 };
    let label = if e == "ascii" { "ascii" } else { "latin-1" };
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    for c in s.chars() {
        let n = c as i64;
        if n >= limit {
            let range = if limit == 128 { "range(128)" } else { "range(256)" };
            return Err(exc("UnicodeEncodeError", f"'{label}' codec can't encode character {char_escape(c)} in position {i}: ordinal not in {range}"));
        }
        out.push(n as u8);
        i += 1;
    }
    Ok(out)
}

fn decode_text(b: ref Vec[u8], enc: ref String) -> String {
    let e = ascii_lower(enc);
    if e == "utf-8" or e == "utf8" {
        utf8_text(b)
    } else {
        latin1_text(b)
    }
}

// passlib's to_native_str(value, encoding, param).
fn to_native_str(v: ref Val, enc: ref String, param: Str) -> Result[String, Exc] {
    match v {
        Val.Str(s) => Ok(s.clone()),
        Val.Bytes(b) => Ok(decode_text(b, enc)),
        _ => Err(expected_string(v, param)),
    }
}

// to_unicode_for_identify
fn identify_text(v: ref Val) -> Result[String, Exc] {
    match v {
        Val.Str(s) => Ok(s.clone()),
        Val.Bytes(b) => Ok(utf8_text(b)),
        _ => Err(expected_string(v, "hash")),
    }
}

fn is_value_error(e: ref Exc) -> bool {
    let vs = strs("ValueError PasswordValueError PasswordSizeError PasswordTruncateError UnknownHashError Error UnicodeEncodeError UnicodeDecodeError");
    contains_str(vs, e.cls)
}

// passlib.utils.as_bool
fn as_bool(v: ref Val, param: Str) -> Result[Val, Exc] {
    match v {
        Val.Non => Ok(Val.Non),
        Val.Bool(b) => Ok(Val.Bool(b)),
        Val.Str(_) => as_bool_text(v, param),
        Val.Bytes(_) => as_bool_text(v, param),
        other => Ok(Val.Bool(truthy(other))),
    }
}

fn as_bool_text(v: ref Val, param: Str) -> Result[Val, Exc] {
    let clean = py_strip(ascii_lower(str_val(v)));
    if contains_str(strs("true t yes y on 1 enable enabled"), clean) {
        return Ok(Val.Bool(true));
    }
    if contains_str(strs("false f no n off 0 disable disabled"), clean) {
        return Ok(Val.Bool(false));
    }
    if clean.len() == 0 or clean == "none" {
        return Ok(Val.Non);
    }
    Err(value_error(f"unrecognized {param} value: {fmt_val(v)}"))
}

// ------------------------------------------------------------ PrefixWrapper

fn wrap_hash(w: ref World, ci: i64, h: ref String) -> Result[String, Exc] {
    let c = w.cls[ci].clone();
    if not h.starts_with(c.orig_prefix) {
        return Err(invalid_hash(w.cls[c.wrapped].name));
    }
    Ok(f"{c.prefix}{str_from(h, clen(c.orig_prefix))}")
}

fn unwrap_hash(w: ref World, ci: i64, h: ref String) -> Result[String, Exc] {
    let c = w.cls[ci].clone();
    if not h.starts_with(c.prefix) {
        return Err(invalid_hash(c.name));
    }
    Ok(f"{c.orig_prefix}{str_from(h, clen(c.prefix))}")
}

fn wrapper_ident(w: ref World, ci: i64) -> Val {
    let c = w.cls[ci].clone();
    if not is_none(c.wident) {
        return c.wident.clone();
    }
    if c.orig_prefix.len() == 0 {
        let inner = w.cls[c.wrapped].clone();
        if not is_none(inner.ident) {
            return match wrap_hash(w, ci, str_val(inner.ident)) {
                Ok(s) => Val.Str(s),
                Err(_) => Val.Non,
            };
        }
    }
    Val.Non
}

// ------------------------------------------------------------ the handler API

fn split_settings(c: ref Cls, kw: ref Kw) -> (Kw, Kw) {
    let mut settings = kw_new();
    let mut ctx = kw_new();
    let mut i = 0;
    while i < kw.keys.len() {
        if contains_str(c.context_kwds, kw.keys[i]) {
            kw_set(mut ctx, kw.keys[i], kw.vals[i].clone());
        } else {
            kw_set(mut settings, kw.keys[i], kw.vals[i].clone());
        }
        i += 1;
    }
    (settings, ctx)
}

fn hash_settings_warning(w: mut ref World, name: ref String) {
    warn(mut w, "DeprecationWarning", f"passing settings to {name}.hash() is deprecated, and won't be supported in Passlib 2.0; use '{name}.using(**settings).hash(secret)' instead");
}

fn h_hash(w: mut ref World, ci: i64, secret: ref Val, kw: ref Kw) -> Result[Val, Exc] {
    let c = w.cls[ci].clone();
    let k = c.kind;
    if k == K_WRAP {
        let inner = h_hash(mut w, c.wrapped, secret, kw)?;
        return Ok(Val.Str(wrap_hash(w, ci, str_val(inner))?));
    }
    if k == K_HTDIGEST {
        return htdigest_hash(secret, kw_get(kw, "user"), kw_get(kw, "realm"), kw_get(kw, "encoding"));
    }
    if k == K_PLAIN or k == K_LDAP_PLAIN {
        validate_secret(secret)?;
        let e = kw_get(kw, "encoding");
        let enc = if truthy(e) { str_val(e) } else { c.default_encoding.clone() };
        return Ok(Val.Str(to_native_str(secret, enc, "secret")?));
    }
    if k == K_UNIX_DISABLED {
        if kw_len(kw) > 0 {
            hash_settings_warning(mut w, c.name);
            let sub = h_using(mut w, ci, kw)?;
            return h_hash(mut w, sub, secret, kw_new());
        }
        validate_secret(secret)?;
        return Ok(Val.Str(c.marker.clone()));
    }
    if kw_len(kw) > 0 {
        let (settings, ctx) = split_settings(c, kw);
        if kw_len(settings) > 0 {
            hash_settings_warning(mut w, c.name);
            let sub = h_using(mut w, ci, settings)?;
            return h_hash(mut w, sub, secret, ctx);
        }
    }
    validate_secret(secret)?;
    let mut a = cargs_ctx(kw);
    a.use_defaults = true;
    let mut it = construct(mut w, ci, a)?;
    it.checksum = calc(mut w, ci, it, secret)?;
    Ok(Val.Str(to_string(w, ci, it)))
}

fn h_verify(w: mut ref World, ci: i64, secret: ref Val, hv: ref Val, ctx: ref Kw) -> Result[Val, Exc] {
    let c = w.cls[ci].clone();
    let k = c.kind;
    if k == K_WRAP {
        let h = to_unicode(hv, "hash")?;
        let inner = unwrap_hash(w, ci, h)?;
        return h_verify(mut w, c.wrapped, secret, Val.Str(inner), ctx);
    }
    if k == K_HTDIGEST {
        let h = htdigest_norm(hv)?;
        let e = kw_get(ctx, "encoding");
        let enc = if is_none(e) { sv("utf-8") } else { e };
        let other = htdigest_hash(secret, kw_get(ctx, "user"), kw_get(ctx, "realm"), enc)?;
        return Ok(Val.Bool(str_val(other) == h));
    }
    if k == K_PLAIN or k == K_LDAP_PLAIN {
        let e = kw_get(ctx, "encoding");
        let enc = if truthy(e) { str_val(e) } else { c.default_encoding.clone() };
        let h = to_native_str(hv, enc, "hash")?;
        if not truthy(h_identify(mut w, ci, Val.Str(h.clone()))?) {
            return Err(invalid_hash(c.name));
        }
        let mine = h_hash(mut w, ci, secret, ctx)?;
        return Ok(Val.Bool(str_val(mine) == h));
    }
    if k == K_UNIX_DISABLED or k == K_DJ_DISABLED {
        validate_secret(secret)?;
        if not truthy(h_identify(mut w, ci, hv)?) {
            return Err(invalid_hash(c.name));
        }
        return Ok(Val.Bool(false));
    }
    validate_secret(secret)?;
    let it = from_string(mut w, ci, hv, ctx)?;
    if is_none(it.checksum) {
        return Err(missing_digest(c.name));
    }
    let chk = calc(mut w, ci, it, secret)?;
    Ok(Val.Bool(py_eq(chk, it.checksum)))
}

fn h_identify(w: mut ref World, ci: i64, hv: ref Val) -> Result[Val, Exc] {
    let c = w.cls[ci].clone();
    let k = c.kind;
    if k == K_WRAP {
        let h = identify_text(hv)?;
        if not h.starts_with(c.prefix) {
            return Ok(Val.Bool(false));
        }
        let inner = unwrap_hash(w, ci, h)?;
        return h_identify(mut w, c.wrapped, Val.Str(inner));
    }
    if k == K_HTDIGEST {
        return match htdigest_norm(hv) {
            Ok(_) => Ok(Val.Bool(true)),
            Err(e) => if is_value_error(e) { Ok(Val.Bool(false)) } else { Err(e) },
        };
    }
    if k == K_PLAIN {
        if is_text(hv) {
            return Ok(Val.Bool(true));
        }
        return Err(expected_string(hv, "hash"));
    }
    if k == K_UNIX_DISABLED {
        if not is_text(hv) {
            return Err(expected_string(hv, "hash"));
        }
        let h = str_val(hv);
        return Ok(Val.Bool(h.len() == 0 or h.starts_with("*") or h.starts_with("!")));
    }
    let h = identify_text(hv)?;
    if k == K_LDAP_PLAIN {
        return Ok(Val.Bool(h.len() > 0 and not rfc2307_like(h)));
    }
    if k == K_DJ_DISABLED {
        return Ok(Val.Bool(h.starts_with("!")));
    }
    if h.len() == 0 {
        return Ok(Val.Bool(false));
    }
    if k == K_BSHA {
        return Ok(Val.Bool(h.starts_with("$bcrypt-sha256$")));
    }
    if not is_none(c.ident) {
        return Ok(Val.Bool(h.starts_with(str_val(c.ident))));
    }
    if has_idents(c) {
        for id in c.ident_values {
            if h.starts_with(id) {
                return Ok(Val.Bool(true));
            }
        }
        return Ok(Val.Bool(false));
    }
    let n = clen(h);
    if k == K_DES {
        return Ok(Val.Bool((n == 2 or n == 13) and all_h64(h)));
    }
    if k == K_BSDI {
        return Ok(Val.Bool((n == 9 or n == 20) and h.starts_with("_") and all_h64(str_from(h, 1))));
    }
    if k == K_BIGCRYPT {
        return Ok(Val.Bool(n >= 2 and (n - 2) % 11 == 0 and all_h64(h)));
    }
    if k == K_CRYPT16 {
        return Ok(Val.Bool((n == 2 or n == 24) and all_h64(h)));
    }
    match from_string(mut w, ci, Val.Str(h), kw_new()) {
        Ok(_) => Ok(Val.Bool(true)),
        Err(e) => if is_value_error(e) { Ok(Val.Bool(false)) } else { Err(e) },
    }
}

// ldap_plaintext's ^\{\w+\}.*$
fn rfc2307_like(h: ref String) -> bool {
    let cs = chars(h);
    if cs.len() < 3 or cs[0] != '{' {
        return false;
    }
    let mut i = 1;
    while i < cs.len() and (is_alpha(cs[i]) or is_digit(cs[i]) or cs[i] == '_' or (cs[i] as i64) > 127) {
        i += 1;
    }
    i > 1 and i < cs.len() and cs[i] == '}'
}

fn htdigest_norm(hv: ref Val) -> Result[String, Exc] {
    let h = to_native_str(hv, "utf-8", "hash")?;
    let name = "htdigest".to_string();
    if clen(h) != 32 {
        return Err(malformed_r(name, "wrong size"));
    }
    for c in h.chars() {
        if not has_char(LOWER_HEX_CHARS, c) {
            return Err(malformed_r(name, "invalid chars in hash"));
        }
    }
    Ok(h)
}

fn htdigest_hash(secret: ref Val, user: ref Val, realm: ref Val, encoding: ref Val) -> Result[Val, Exc] {
    let enc = if truthy(encoding) { str_val(encoding) } else { "utf-8".to_string() };
    validate_secret(secret)?;
    let sb = match secret {
        Val.Str(s) => encode_text(s, enc)?,
        other => bytes_val(other),
    };
    let ub = match user {
        Val.Str(s) => encode_text(s, enc)?,
        Val.Bytes(b) => b.clone(),
        other => {
            return Err(expected_string(other, "user"));
        }
    };
    let rb = match realm {
        Val.Str(s) => encode_text(s, enc)?,
        Val.Bytes(b) => b.clone(),
        other => {
            return Err(expected_string(other, "realm"));
        }
    };
    let mut data = ub.clone();
    data.push(b':');
    append(mut data, rb);
    data.push(b':');
    append(mut data, sb);
    Ok(Val.Str(hex_of(digest(D_MD5, data))))
}

fn clip_salt_size(w: mut ref World, c: ref Cls, n: i64, relaxed: bool) -> Result[i64, Exc] {
    let mn = c.min_salt;
    let mx = c.max_salt;
    if mn == mx {
        if n != mn {
            let msg = f"{c.name}: salt_size ({n}) must be exactly {mn}";
            if relaxed {
                warn(mut w, "PasslibHashWarning", msg);
            } else {
                return Err(value_error(msg));
            }
        }
        return Ok(mn);
    }
    let mut size = n;
    if size < mn {
        let msg = f"{c.name}: salt_size ({size}) below min_salt_size ({mn})";
        if relaxed {
            warn(mut w, "PasslibHashWarning", msg);
            size = mn;
        } else {
            return Err(value_error(msg));
        }
    }
    if mx > 0 and size > mx {
        let msg = f"{c.name}: salt_size ({size}) above max_salt_size ({mx})";
        if relaxed {
            warn(mut w, "PasslibHashWarning", msg);
            size = mx;
        } else {
            return Err(value_error(msg));
        }
    }
    Ok(size)
}

fn int_setting(v: ref Val) -> Result[Val, Exc] {
    match v {
        Val.Str(s) => Ok(Val.Int(py_int(s)?)),
        other => Ok(other.clone()),
    }
}

fn opt_int(n: i64) -> Val {
    if n < 0 { Val.Non } else { Val.Int(n) }
}

// using(**kwds): each mixin takes its own keywords before handing the rest
// on, and applies them after the class beneath it has been derived.
fn h_using(w: mut ref World, ci: i64, kw0: ref Kw) -> Result[i64, Exc] {
    let c = w.cls[ci].clone();
    let k = c.kind;
    if k == K_WRAP {
        let sub = h_using(mut w, c.wrapped, kw0)?;
        let mut nc = c.clone();
        nc.wrapped = sub;
        nc.wident = Val.Non;
        w.cls.push(nc);
        return Ok(w.cls.len() - 1);
    }
    let mut kw = kw0.clone();
    let version = if k == K_BSHA { kw_pop(mut kw, "version") } else { Val.Non };
    let block_size = if k == K_SCRYPT { kw_pop(mut kw, "block_size") } else { Val.Non };
    let parallelism = if k == K_SCRYPT { kw_pop(mut kw, "parallelism") } else { Val.Non };
    let marker = if k == K_UNIX_DISABLED { kw_pop(mut kw, "marker") } else { Val.Non };
    let cisco_salt = if k == K_CISCO7 { kw_pop(mut kw, "salt") } else { Val.Non };
    let truncate = if c.trunc_mixin { kw_pop(mut kw, "truncate_error") } else { Val.Non };
    let mut default_ident = Val.Non;
    if has_idents(c) {
        default_ident = kw_pop(mut kw, "default_ident");
        let ident = kw_pop(mut kw, "ident");
        if not is_none(ident) {
            if not is_none(default_ident) {
                return Err(type_error("'default_ident' and 'ident' are mutually exclusive".to_string()));
            }
            default_ident = ident;
        }
    }
    let mut min_d = Val.Non;
    let mut max_d = Val.Non;
    let mut dflt = Val.Non;
    let mut vary = Val.Non;
    if c.has_rounds {
        min_d = kw_pop(mut kw, "min_desired_rounds");
        max_d = kw_pop(mut kw, "max_desired_rounds");
        dflt = kw_pop(mut kw, "default_rounds");
        vary = kw_pop(mut kw, "vary_rounds");
        let min_r = kw_pop(mut kw, "min_rounds");
        let max_r = kw_pop(mut kw, "max_rounds");
        let rounds = kw_pop(mut kw, "rounds");
        if not is_none(min_r) {
            if not is_none(min_d) {
                return Err(type_error("'min_rounds' and 'min_desired_rounds' aliases are mutually exclusive".to_string()));
            }
            min_d = min_r;
        }
        if not is_none(max_r) {
            if not is_none(max_d) {
                return Err(type_error("'max_rounds' and 'max_desired_rounds' aliases are mutually exclusive".to_string()));
            }
            max_d = max_r;
        }
        if not is_none(rounds) {
            if is_none(min_d) {
                min_d = rounds.clone();
            }
            if is_none(max_d) {
                max_d = rounds.clone();
            }
            if is_none(dflt) {
                dflt = rounds.clone();
            }
        }
    }
    let mut salt_size = Val.Non;
    let mut salt = Val.Non;
    if c.salt_kind > 0 {
        salt_size = kw_pop(mut kw, "default_salt_size");
        let ss = kw_pop(mut kw, "salt_size");
        salt = kw_pop(mut kw, "salt");
        if not is_none(ss) {
            if not is_none(salt_size) {
                return Err(type_error("'salt_size' and 'default_salt_size' aliases are mutually exclusive".to_string()));
            }
            salt_size = ss;
        }
    }
    let relaxed = truthy(kw_pop(mut kw, "relaxed"));
    if kw_len(kw) > 0 {
        return Err(type_error(f"using() got an unexpected keyword argument {str_repr(kw.keys[0])}"));
    }
    let mut s = c.clone();
    if not c.configured {
        s.clsname = f"<customized {c.clsname} hasher>";
    }
    s.configured = true;
    s.deprecated = false;
    s.orig = -1;
    if k == K_SCRYPT {
        using_idents(mut w, ci, mut s, default_ident)?;
    }
    if not is_none(salt_size) {
        let n = int_val(int_setting(salt_size)?);
        s.default_salt_size = clip_salt_size(mut w, s, n, relaxed)?;
    }
    if not is_none(salt) {
        s.fixed_salt = norm_salt(mut w, s, salt, relaxed)?;
    }
    if c.has_rounds {
        using_rounds(mut w, c, mut s, min_d, max_d, dflt, vary, relaxed)?;
    }
    if k != K_SCRYPT {
        using_idents(mut w, ci, mut s, default_ident)?;
    }
    if not is_none(parallelism) {
        let v = int_setting(parallelism)?;
        s.parallelism = norm_integer(mut w, s.name, v, 1, -1, "parallelism", relaxed)?;
    }
    if not is_none(truncate) {
        let b = as_bool(truncate, "truncate_error")?;
        if not is_none(b) {
            s.truncate_error = truthy(b);
        }
    }
    if k == K_BSDI and (s.default_rounds & 1) == 0 {
        warn(mut w, "PasslibSecurityWarning", "bsdi_crypt rounds should be odd, as even rounds may reveal weak DES keys");
    }
    if k == K_BSHA {
        if not is_none(version) {
            s.version = norm_version(s, version)?;
        }
        if s.version > 1 and s.default_ident != "$2b$" {
            return Err(value_error(f"bcrypt {str_repr(s.default_ident)} hashes not allowed for version {s.version}"));
        }
    }
    if not is_none(block_size) {
        let v = int_setting(block_size)?;
        s.block_size = norm_integer(mut w, s.name, v, 1, -1, "block_size", relaxed)?;
    }
    if not is_none(marker) {
        let ok = match marker {
            Val.Str(ref m) => m.len() == 0 or m.starts_with("*") or m.starts_with("!"),
            _ => false,
        };
        if not ok {
            return Err(value_error(f"invalid marker: {fmt_val(marker)}"));
        }
        s.marker = str_val(marker);
    }
    if not is_none(cisco_salt) {
        s.fixed_salt = Val.Int(cisco_norm_salt(mut w, cisco_salt, relaxed)?);
    }
    w.cls.push(s);
    Ok(w.cls.len() - 1)
}

// HasManyIdents.using: the new default is checked by building a hash of
// the original class with it, which also draws a salt.
fn using_idents(w: mut ref World, ci: i64, s: mut ref Cls, default_ident: ref Val) -> Result[bool, Exc] {
    if is_none(default_ident) {
        return Ok(true);
    }
    let mut a = cargs();
    a.ident = default_ident.clone();
    a.use_defaults = true;
    let it = construct(mut w, ci, a)?;
    s.default_ident = it.ident.clone();
    Ok(true)
}

fn using_rounds(w: mut ref World, c: ref Cls, s: mut ref Cls, min0: ref Val, max0: ref Val, dflt0: ref Val, vary0: ref Val, relaxed: bool) -> Result[bool, Exc] {
    let mut explicit_min = false;
    let mut min_d = opt_int(c.min_desired);
    if not is_none(min0) {
        explicit_min = true;
        min_d = int_setting(min0)?;
        let n = norm_rounds(mut w, s, min_d, "min_desired_rounds", relaxed)?;
        s.min_desired = n;
    }
    let mut max_d = opt_int(c.max_desired);
    if not is_none(max0) {
        max_d = int_setting(max0)?;
        if truthy(min_d) and int_val(max_d) < int_val(min_d) {
            let msg = f"{s.name}: max_desired_rounds ({fmt_val(max_d)}) below min_desired_rounds ({fmt_val(min_d)})";
            if explicit_min {
                return Err(value_error(msg));
            }
            warn(mut w, "PasslibConfigWarning", msg);
            max_d = min_d.clone();
        }
        let n = norm_rounds(mut w, s, max_d, "max_desired_rounds", relaxed)?;
        s.max_desired = n;
    }
    if not is_none(dflt0) {
        let d = int_setting(dflt0)?;
        if truthy(min_d) and int_val(d) < int_val(min_d) {
            return Err(value_error(f"{s.name}: default_rounds ({fmt_val(d)}) below min_desired_rounds ({fmt_val(min_d)})"));
        } else if truthy(max_d) and int_val(d) > int_val(max_d) {
            return Err(value_error(f"{s.name}: default_rounds ({fmt_val(d)}) above max_desired_rounds ({fmt_val(max_d)})"));
        }
        s.default_rounds = norm_rounds(mut w, s, d, "default_rounds", relaxed)?;
    }
    if s.default_rounds >= 0 {
        s.default_rounds = clip_desired(s, s.default_rounds);
    }
    if not is_none(vary0) {
        let mut v = vary0.clone();
        match vary0 {
            Val.Str(t) => {
                if t.ends_with("%") {
                    let x = match py_float(substr(t, 0, clen(t) - 1)) {
                        Some(x) => x,
                        None => {
                            return Err(value_error(f"could not convert string to float: {str_repr(substr(t, 0, clen(t) - 1))}"));
                        }
                    };
                    v = Val.Float(x * 0.01);
                } else if t.contains(".") {
                    v = match py_float(t) {
                        Some(x) => Val.Float(x),
                        None => {
                            return Err(value_error(f"could not convert string to float: {str_repr(t)}"));
                        }
                    };
                } else {
                    v = Val.Int(py_int(t)?);
                }
            }
            _ => {}
        }
        let neg = match v {
            Val.Float(x) => x < 0.0,
            ref other => int_val(other) < 0,
        };
        if neg {
            return Err(value_error(f"{s.name}: vary_rounds ({fmt_val(v)}) below 0"));
        }
        match v {
            Val.Float(x) => {
                if x > 1.0 {
                    return Err(value_error(f"{s.name}: vary_rounds ({fmt_val(v)}) above 1.0"));
                }
            }
            _ => {}
        }
        if truthy(v) {
            warn(mut w, "PasslibConfigWarning", "The 'vary_rounds' option is deprecated as of Passlib 1.7, and will be removed in Passlib 2.0");
        }
        s.vary_rounds = v;
    }
    Ok(true)
}

fn mask_value(v: ref Val) -> Val {
    let text = match v {
        Val.Non => {
            return Val.Non;
        }
        Val.Str(s) => s.clone(),
        Val.Bytes(b) => ab64_encode(b),
        other => fmt_val(other),
    };
    let size = clen(text);
    let mut show = (size as f64 * 0.125) as i64;
    if show > 4 {
        show = 4;
    }
    let mut out = substr(text, 0, show);
    let mut i = show;
    while i < size {
        out.push('*');
        i += 1;
    }
    Val.Str(out)
}

fn h_parsehash(w: mut ref World, ci: i64, hv: ref Val, checksum: bool, sanitize: bool) -> Result[Val, Exc] {
    let c = w.cls[ci].clone();
    let it = from_string(mut w, ci, hv, kw_new())?;
    let mut keys: Vec[Val] = Vec.new();
    let mut vals: Vec[Val] = Vec.new();
    for key in c.setting_kwds {
        let v = if key == "salt" {
            it.salt.clone()
        } else if key == "rounds" {
            Val.Int(it.rounds)
        } else if key == "ident" {
            Val.Str(it.ident.clone())
        } else if key == "implicit_rounds" {
            if it.implicit_rounds { Val.Bool(true) } else { Val.Non }
        } else if key == "block_size" {
            if it.block_size != c.block_size { Val.Int(it.block_size) } else { Val.Non }
        } else if key == "parallelism" {
            if it.parallelism != c.parallelism { Val.Int(it.parallelism) } else { Val.Non }
        } else {
            Val.Non
        };
        if not is_none(v) {
            keys.push(Val.Str(key.clone()));
            vals.push(v);
        }
    }
    if checksum and not is_none(it.checksum) {
        keys.push(sv("checksum"));
        vals.push(it.checksum.clone());
    }
    if sanitize {
        let mut i = 0;
        while i < keys.len() {
            let key = str_val(keys[i]);
            if key == "salt" or key == "checksum" {
                vals[i] = mask_value(vals[i]);
            }
            i += 1;
        }
    }
    Ok(Val.Dict(keys, vals))
}

fn h_needs_update(w: mut ref World, ci: i64, hv: ref Val) -> Result[Val, Exc] {
    let c = w.cls[ci].clone();
    let k = c.kind;
    if k == K_WRAP {
        let inner = unwrap_hash(w, ci, str_val(hv))?;
        return h_needs_update(mut w, c.wrapped, Val.Str(inner));
    }
    if k == K_HTDIGEST or k == K_PLAIN or k == K_LDAP_PLAIN or k == K_UNIX_DISABLED {
        return Ok(Val.Bool(false));
    }
    if k == K_BCRYPT or k == K_BSHA {
        let h = str_val(hv);
        let cs = chars(h);
        if h.starts_with("$2a$") {
            if cs.len() <= 28 {
                return Err(exc("IndexError", "string index out of range".to_string()));
            }
            if not has_char(".Oeu", cs[28]) {
                return Ok(Val.Bool(true));
            }
        }
    }
    let it = from_string(mut w, ci, hv, kw_new())?;
    if k == K_BSDI and (it.rounds & 1) == 0 {
        return Ok(Val.Bool(true));
    }
    if k == K_BSHA and it.version < c.version {
        return Ok(Val.Bool(true));
    }
    if k == K_SCRYPT and (it.block_size != c.block_size or it.parallelism != c.parallelism) {
        return Ok(Val.Bool(true));
    }
    if c.has_rounds {
        if c.min_desired > 0 and it.rounds < c.min_desired {
            return Ok(Val.Bool(true));
        }
        if c.max_desired > 0 and it.rounds > c.max_desired {
            return Ok(Val.Bool(true));
        }
    }
    Ok(Val.Bool(false))
}

fn deprecated_method(w: mut ref World, ci: i64, meth: Str) {
    let c = w.cls[ci].clone();
    warn(mut w, "DeprecationWarning", f"the method {c.module}.{c.clsname}.{meth}() is deprecated as of Passlib 1.7, and will be removed in Passlib 2.0.");
}

fn stub_checksum(w: mut ref World, ci: i64, it: ref Inst) -> Result[Val, Exc] {
    let c = w.cls[ci].clone();
    if c.checksum_size > 0 {
        if c.checksum_bytes {
            let mut b: Vec[u8] = Vec.new();
            let mut i = 0;
            while i < c.checksum_size {
                b.push(0);
                i += 1;
            }
            return Ok(Val.Bytes(b));
        }
        if c.checksum_chars.len() > 0 {
            let ch = chars(c.checksum_chars)[0];
            let mut s = String.new();
            let mut i = 0;
            while i < c.checksum_size {
                s.push(ch);
                i += 1;
            }
            return Ok(Val.Str(s));
        }
    }
    let mut tmp = it.clone();
    if c.has_rounds {
        tmp.rounds = if c.min_rounds > 0 { c.min_rounds } else { 1 };
    }
    calc(mut w, ci, tmp, sv(""))
}

fn h_genconfig(w: mut ref World, ci: i64, kw: ref Kw) -> Result[Val, Exc] {
    deprecated_method(mut w, ci, "genconfig");
    let c = w.cls[ci].clone();
    let (settings, ctx) = split_settings(c, kw);
    if kw_len(settings) > 0 {
        let sub = h_using(mut w, ci, settings)?;
        return h_genconfig(mut w, sub, ctx);
    }
    let mut a = cargs_ctx(ctx);
    a.use_defaults = true;
    let mut it = construct(mut w, ci, a)?;
    it.checksum = stub_checksum(mut w, ci, it)?;
    Ok(Val.Str(to_string(w, ci, it)))
}

fn h_genhash(w: mut ref World, ci: i64, secret: ref Val, config: ref Val, ctx: ref Kw) -> Result[Val, Exc] {
    deprecated_method(mut w, ci, "genhash");
    if is_none(config) {
        return Err(type_error("config must be string".to_string()));
    }
    validate_secret(secret)?;
    let mut it = from_string(mut w, ci, config, ctx)?;
    it.checksum = calc(mut w, ci, it, secret)?;
    Ok(Val.Str(to_string(w, ci, it)))
}

fn h_normhash(w: mut ref World, ci: i64, hv: ref Val) -> Result[Val, Exc] {
    if truthy(h_identify(mut w, ci, hv)?) {
        let it = from_string(mut w, ci, hv, kw_new())?;
        return Ok(Val.Str(to_string(w, ci, it)));
    }
    Ok(hv.clone())
}

fn h_decode(w: mut ref World, ci: i64, hv: ref Val, encoding: ref Val) -> Result[Val, Exc] {
    let it = from_string(mut w, ci, hv, kw_new())?;
    let tmp = unhexlify(str_val(it.checksum))?;
    let key = CISCO_KEY.bytes().to_vec();
    let salt = int_val(it.salt);
    let mut raw: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < tmp.len() {
        raw.push(tmp[i] ^ key[(salt + i) % 53]);
        i += 1;
    }
    if truthy(encoding) {
        return Ok(Val.Str(decode_text(raw, str_val(encoding))));
    }
    Ok(Val.Bytes(raw))
}

fn h_disable(w: mut ref World, ci: i64, hv: ref Val) -> Result[Val, Exc] {
    let mut out = str_val(h_hash(mut w, ci, sv(""), kw_new())?);
    if not is_none(hv) {
        let mut h = to_native_str(hv, "utf-8", "hash")?;
        if truthy(h_identify(mut w, ci, Val.Str(h.clone()))?) {
            h = str_val(h_enable(mut w, ci, Val.Str(h))?);
        }
        if h.len() > 0 {
            out.push_str(h);
        }
    }
    Ok(Val.Str(out))
}

fn h_enable(w: mut ref World, ci: i64, hv: ref Val) -> Result[Val, Exc] {
    let h = to_native_str(hv, "utf-8", "hash")?;
    if h.starts_with("*") or h.starts_with("!") {
        let orig = str_from(h, 1);
        if orig.len() > 0 {
            return Ok(Val.Str(orig));
        }
        return Err(value_error("cannot restore original hash".to_string()));
    }
    Err(invalid_hash(w.cls[ci].name))
}

// A class attribute, as getattr(handler, name) returns it.
fn h_attr(w: ref World, ci: i64, attr: ref String) -> Result[Val, Exc] {
    let c = w.cls[ci].clone();
    if c.kind == K_WRAP {
        if attr == "name" {
            return Ok(Val.Str(c.name.clone()));
        }
        if attr == "ident" {
            return Ok(wrapper_ident(w, ci));
        }
        if attr == "deprecated" {
            return Ok(Val.Bool(c.deprecated));
        }
        let proxied = strs("setting_kwds context_kwds default_rounds min_rounds max_rounds rounds_cost min_desired_rounds max_desired_rounds vary_rounds default_salt_size min_salt_size max_salt_size salt_chars is_disabled truncate_size truncate_error");
        if contains_str(proxied, attr) {
            return h_attr(w, c.wrapped, attr);
        }
        return Err(exc("AttributeError", f"missing attribute: {str_repr(attr)}"));
    }
    let v = if attr == "name" {
        Val.Str(c.name.clone())
    } else if attr == "setting_kwds" {
        str_tuple(c.setting_kwds)
    } else if attr == "context_kwds" {
        str_tuple(c.context_kwds)
    } else if attr == "checksum_size" {
        opt_int(if c.checksum_size > 0 { c.checksum_size } else { -1 })
    } else if attr == "ident" {
        c.ident.clone()
    } else if attr == "default_ident" {
        Val.Str(c.default_ident.clone())
    } else if attr == "ident_values" {
        str_tuple(c.ident_values)
    } else if attr == "default_salt_size" {
        opt_int(c.default_salt_size)
    } else if attr == "min_salt_size" {
        Val.Int(c.min_salt)
    } else if attr == "max_salt_size" {
        opt_int(c.max_salt)
    } else if attr == "truncate_size" {
        opt_int(c.truncate_size)
    } else if attr == "truncate_error" {
        Val.Bool(c.truncate_error)
    } else if attr == "default_rounds" {
        opt_int(c.default_rounds)
    } else if attr == "min_desired_rounds" {
        opt_int(c.min_desired)
    } else if attr == "max_desired_rounds" {
        opt_int(c.max_desired)
    } else if attr == "vary_rounds" {
        c.vary_rounds.clone()
    } else if attr == "min_rounds" {
        Val.Int(c.min_rounds)
    } else if attr == "max_rounds" {
        opt_int(c.max_rounds)
    } else if attr == "rounds_cost" {
        Val.Str(c.rounds_cost.clone())
    } else if attr == "block_size" {
        Val.Int(c.block_size)
    } else if attr == "parallelism" {
        Val.Int(c.parallelism)
    } else if attr == "version" {
        Val.Int(c.version)
    } else if attr == "is_disabled" {
        Val.Bool(c.is_disabled)
    } else if attr == "deprecated" {
        Val.Bool(c.deprecated)
    } else {
        return Err(exc("AttributeError", f"type object {str_repr(c.clsname)} has no attribute {str_repr(attr)}"));
    };
    Ok(v)
}

// ------------------------------------------------------------ CryptContext

// An ordered dict keyed by (category, scheme, option); "" stands for None.
#[derive(Clone)]
struct Src {
    cats: Vec[String],
    schs: Vec[String],
    keys: Vec[String],
    vals: Vec[Val],
}

fn src_new() -> Src {
    Src { cats: Vec.new(), schs: Vec.new(), keys: Vec.new(), vals: Vec.new() }
}

fn src_pos(s: ref Src, cat: ref String, sch: ref String, key: ref String) -> i64 {
    let mut i = 0;
    while i < s.keys.len() {
        if s.keys[i] == key and s.cats[i] == cat and s.schs[i] == sch {
            return i;
        }
        i += 1;
    }
    -1
}

fn src_set(s: mut ref Src, cat: ref String, sch: ref String, key: ref String, v: own Val) {
    let i = src_pos(s, cat, sch, key);
    if i >= 0 {
        s.vals[i] = v;
    } else {
        s.cats.push(cat.clone());
        s.schs.push(sch.clone());
        s.keys.push(key.clone());
        s.vals.push(v);
    }
}

fn src_get(s: ref Src, cat: ref String, sch: ref String, key: ref String) -> Option[Val] {
    let i = src_pos(s, cat, sch, key);
    if i < 0 { None } else { Some(s.vals[i].clone()) }
}

#[derive(Clone)]
struct Ctx {
    loaded: bool,
    handlers: Vec[i64],
    schemes: Vec[String],
    categories: Vec[String],
    so: Src,
    co: Src,
    dm_cat: Vec[String],
    dm_val: Vec[String],
    rec_scheme: Vec[String],
    rec_cat: Vec[String],
    rec_cls: Vec[i64],
}

fn ctx_empty() -> Ctx {
    Ctx {
        loaded: false,
        handlers: Vec.new(),
        schemes: Vec.new(),
        categories: Vec.new(),
        so: src_new(),
        co: src_new(),
        dm_cat: Vec.new(),
        dm_val: Vec.new(),
        rec_scheme: Vec.new(),
        rec_cat: Vec.new(),
        rec_cls: Vec.new(),
    }
}

fn splitcomma(s0: ref String) -> Vec[String] {
    let mut s = py_strip(s0);
    if s.ends_with(",") {
        s = substr(s, 0, clen(s) - 1);
    }
    let mut out: Vec[String] = Vec.new();
    if s.len() == 0 {
        return out;
    }
    for e in split_on(s, ',') {
        out.push(py_strip(e));
    }
    out
}

fn str_items(v: ref Val) -> Vec[Val] {
    match v {
        Val.List(xs) => xs.clone(),
        Val.Tuple(xs) => xs.clone(),
        _ => Vec.new(),
    }
}

fn names_of(v: ref Val) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for x in str_items(v) {
        out.push(str_val(x));
    }
    out
}

// _CryptContext._parse_config_key
fn parse_config_key(ckey: ref String) -> Result[(String, String, String), Exc] {
    let parts = split_str(ckey.replace(".", "__"), "__");
    let n = parts.len();
    let mut cat = String.new();
    let mut sch = String.new();
    let mut key = String.new();
    let mut cat_none = true;
    let mut sch_none = true;
    if n == 1 {
        key = parts[0].clone();
    } else if n == 2 {
        sch = parts[0].clone();
        sch_none = false;
        key = parts[1].clone();
    } else if n == 3 {
        cat = parts[0].clone();
        cat_none = false;
        sch = parts[1].clone();
        sch_none = false;
        key = parts[2].clone();
    } else {
        return Err(type_error(f"keys must have less than 3 separators: {str_repr(ckey)}"));
    }
    if cat == "default" {
        cat = String.new();
    } else if not cat_none and cat.len() == 0 {
        return Err(type_error(f"empty category: {str_repr(ckey)}"));
    }
    if sch == "context" {
        sch = String.new();
    } else if not sch_none and sch.len() == 0 {
        return Err(type_error(f"empty scheme: {str_repr(ckey)}"));
    }
    if key.len() == 0 {
        return Err(type_error(f"empty option: {str_repr(ckey)}"));
    }
    Ok((cat, sch, key))
}

fn coerce_vary(v: ref String) -> Result[Val, Exc] {
    if v.ends_with("%") {
        let t = substr(v, 0, clen(v) - 1);
        return match py_float(t) {
            Some(x) => Ok(Val.Float(x * 0.01)),
            None => Err(value_error(f"could not convert string to float: {str_repr(t)}")),
        };
    }
    match py_int(v) {
        Ok(n) => Ok(Val.Int(n)),
        Err(_) => match py_float(v) {
            Some(x) => Ok(Val.Float(x)),
            None => Err(value_error(f"could not convert string to float: {str_repr(v)}")),
        },
    }
}

// _CryptConfig(source)
fn build_config(w: mut ref World, source: ref Src) -> Result[Ctx, Exc] {
    let mut cfg = ctx_empty();
    cfg.loaded = true;
    let none = String.new();
    let schemes_key = "schemes".to_string();
    // _init_scheme_list
    match src_get(source, none, none, schemes_key) {
        Some(data) => {
            let elems: Vec[Val] = match data {
                Val.Str(s) => {
                    let mut xs: Vec[Val] = Vec.new();
                    for e in splitcomma(s) {
                        xs.push(Val.Str(e.clone()));
                    }
                    xs
                }
                other => str_items(other),
            };
            for e in elems {
                let (hi, name) = match e {
                    Val.Hd(i) => (i, w.cls[i].name.clone()),
                    Val.Str(s) => {
                        let i = find_base(w, s);
                        if i < 0 {
                            return Err(key_error(f"no crypt handler found for algorithm: {str_repr(s)}"));
                        }
                        (i, w.cls[i].name.clone())
                    }
                    other => {
                        return Err(type_error(f"scheme must be name or CryptHandler, not {str_repr(type_name(other))}"));
                    }
                };
                if contains_str(cfg.schemes, name) {
                    return Err(key_error(f"multiple handlers with same name: {str_repr(name)}"));
                }
                cfg.handlers.push(hi);
                cfg.schemes.push(name);
            }
        }
        None => {}
    }
    // _init_options
    let mut cats: Vec[String] = Vec.new();
    let globals = strs("truncate_error vary_rounds");
    let mut i = 0;
    while i < source.keys.len() {
        let cat = source.cats[i].clone();
        let mut sch = source.schs[i].clone();
        let key = source.keys[i].clone();
        let mut value = source.vals[i].clone();
        if cat.len() > 0 and not contains_str(cats, cat) {
            cats.push(cat.clone());
        }
        let explicit = sch.clone();
        if cat.len() == 0 and sch.len() == 0 and contains_str(globals, key) {
            sch = "all".to_string();
        }
        if sch.len() > 0 {
            if key == "salt" {
                return Err(key_error(f"{str_repr(key)} option not allowed in CryptContext configuration"));
            }
            match value {
                Val.Str(ref s) => {
                    if key == "min_rounds" or key == "max_rounds" or key == "default_rounds" or key == "salt_size" {
                        value = Val.Int(py_int(s)?);
                    } else if key == "vary_rounds" {
                        value = coerce_vary(s)?;
                    }
                }
                _ => {}
            }
            if sch == "all" and not contains_str(globals, key) {
                warn(mut w, "PasslibConfigWarning", f"The '{key}' option should be configured per-algorithm, and not set globally in the context; This will be an error in Passlib 2.0");
            }
            if explicit == "all" {
                warn(mut w, "DeprecationWarning", "The 'all' scheme is deprecated as of Passlib 1.7, and will be removed in Passlib 2.0; Please configure options on a per-algorithm basis.");
            }
            src_set(mut cfg.so, cat, sch, key, value);
        } else {
            if cat.len() > 0 and key == "schemes" {
                return Err(key_error("'schemes' context option is not allowed per category"));
            }
            if key == "default" {
                value = match value {
                    Val.Hd(h) => Val.Str(w.cls[h].name.clone()),
                    Val.Str(s) => Val.Str(s.clone()),
                    other => {
                        return Err(expected_type(other, "str", "default"));
                    }
                };
                if cfg.schemes.len() > 0 and not contains_str(cfg.schemes, str_val(value)) {
                    return Err(key_error("default scheme not found in policy"));
                }
            } else if key == "deprecated" {
                value = match value {
                    Val.Str(s) => Val.List(str_list(splitcomma(s))),
                    Val.List(xs) => Val.List(xs.clone()),
                    Val.Tuple(xs) => Val.Tuple(xs.clone()),
                    other => {
                        return Err(expected_type(other, "str or seq", "deprecated"));
                    }
                };
                let names = names_of(value);
                if contains_str(names, "auto") {
                    if names.len() > 1 {
                        return Err(value_error("cannot list other schemes if ``deprecated=['auto']`` is used".to_string()));
                    }
                } else if cfg.schemes.len() > 0 {
                    for nm in names {
                        if not contains_str(cfg.schemes, nm) {
                            return Err(key_error(f"deprecated scheme not found in policy: {str_repr(nm)}"));
                        }
                    }
                }
            } else if key == "min_verify_time" {
                warn(mut w, "DeprecationWarning", "'min_verify_time' was deprecated in Passlib 1.6, is ignored in 1.7, and will be removed in 1.8");
            } else if key == "harden_verify" {
                warn(mut w, "DeprecationWarning", "'harden_verify' is deprecated & ignored as of Passlib 1.7.1,  and will be removed in 1.8");
            } else if key != "schemes" {
                return Err(key_error(f"unknown CryptContext keyword: {str_repr(key)}"));
            }
            if key != "min_verify_time" {
                src_set(mut cfg.co, cat, none, key, value);
            }
        }
        i += 1;
    }
    cfg.categories = sort_strs(cats);
    // _init_default_schemes
    let dflt_key = "default".to_string();
    let mut j = 0;
    while j < cfg.co.keys.len() {
        if cfg.co.keys[j] == dflt_key {
            cfg.dm_cat.push(cfg.co.cats[j].clone());
            cfg.dm_val.push(str_val(cfg.co.vals[j]));
        }
        j += 1;
    }
    if cfg.schemes.len() > 0 {
        let deps = dep_list(cfg, none);
        let dflt = dm_get(cfg, none);
        match dflt {
            None => {
                let mut found = false;
                for s in cfg.schemes.clone() {
                    if not contains_str(deps, s) {
                        cfg.dm_cat.push(String.new());
                        cfg.dm_val.push(s.clone());
                        found = true;
                        break;
                    }
                }
                if not found {
                    return Err(value_error("must have at least one non-deprecated scheme".to_string()));
                }
            }
            Some(ref d) => {
                if contains_str(deps, d) {
                    return Err(value_error("default scheme cannot be deprecated".to_string()));
                }
            }
        }
        for cat in cfg.categories.clone() {
            let cdeps = match src_get(cfg.co, cat, none, "deprecated".to_string()) {
                Some(v) => names_of(v),
                None => deps.clone(),
            };
            let cdefault = match dm_get(cfg, cat) {
                Some(d) => Some(d),
                None => dflt.clone(),
            };
            match cdefault {
                None => {
                    let mut found = false;
                    for s in cfg.schemes.clone() {
                        if not contains_str(cdeps, s) {
                            cfg.dm_cat.push(cat.clone());
                            cfg.dm_val.push(s.clone());
                            found = true;
                            break;
                        }
                    }
                    if not found {
                        return Err(value_error(f"must have at least one non-deprecated scheme for {str_repr(cat)} category"));
                    }
                }
                Some(d) => {
                    if contains_str(cdeps, d) {
                        return Err(value_error(f"default scheme for {str_repr(cat)} category cannot be deprecated"));
                    }
                }
            }
        }
    }
    // _init_records
    let mut cats_all: Vec[String] = [String.new()].to_vec();
    for c in cfg.categories.clone() {
        cats_all.push(c.clone());
    }
    let mut hi = 0;
    while hi < cfg.handlers.len() {
        let h = cfg.handlers[hi];
        let scheme = cfg.schemes[hi].clone();
        for cat in cats_all.clone() {
            let (kwds, has_cat) = record_options(w, cfg, h, scheme, cat)?;
            if cat.len() == 0 or has_cat {
                let rec = create_record(mut w, h, kwds)?;
                cfg.rec_scheme.push(scheme.clone());
                cfg.rec_cat.push(cat.clone());
                cfg.rec_cls.push(rec);
            }
        }
        hi += 1;
    }
    Ok(cfg)
}

fn dm_get(cfg: ref Ctx, cat: ref String) -> Option[String] {
    let mut i = 0;
    while i < cfg.dm_cat.len() {
        if cfg.dm_cat[i] == cat {
            return Some(cfg.dm_val[i].clone());
        }
        i += 1;
    }
    None
}

fn dep_list(cfg: ref Ctx, cat: ref String) -> Vec[String] {
    match src_get(cfg.co, cat, String.new(), "deprecated".to_string()) {
        Some(v) => names_of(v),
        None => Vec.new(),
    }
}

// _CryptConfig.default_scheme
fn cfg_default_scheme(cfg: ref Ctx, cat: ref String) -> Result[String, Exc] {
    match dm_get(cfg, cat) {
        Some(d) => {
            return Ok(d);
        }
        None => {}
    }
    if cfg.schemes.len() == 0 {
        return Err(key_error("no hash schemes configured for this CryptContext instance"));
    }
    match dm_get(cfg, String.new()) {
        Some(d) => Ok(d),
        None => Err(key_error("no hash schemes configured for this CryptContext instance")),
    }
}

// The options a scheme's record is built from, and whether the category
// changes them.
fn record_options(w: ref World, cfg: ref Ctx, h: i64, scheme: ref String, cat: ref String) -> Result[(Kw, bool), Exc] {
    let none = String.new();
    let all = "all".to_string();
    let mut kwds = so_map(cfg, all, none);
    let mut defkwds = kwds.clone();
    if cat.len() > 0 {
        let extra = so_map(cfg, all, cat);
        kw_update(mut kwds, extra);
    }
    let mut allowed = setting_kwds_of(w, h);
    if contains_str(allowed, "rounds") {
        for k in strs("min_desired_rounds max_desired_rounds min_rounds max_rounds default_rounds vary_rounds") {
            allowed.push(k.clone());
        }
    }
    kwds = kw_filter(kwds, allowed);
    defkwds = kw_filter(defkwds, allowed);
    let other = so_map(cfg, scheme, none);
    kw_update(mut kwds, other);
    let mut has_cat = false;
    if cat.len() > 0 {
        kw_update(mut defkwds, other);
        kw_update(mut kwds, so_map(cfg, scheme, cat));
        has_cat = not kw_eq(kwds, defkwds);
    }
    let (dep, not_inherited) = deprecated_flag(cfg, scheme, cat)?;
    if dep {
        kw_set(mut kwds, "deprecated".to_string(), Val.Bool(true));
    }
    if not_inherited {
        has_cat = true;
    }
    Ok((kwds, has_cat))
}

fn setting_kwds_of(w: ref World, h: i64) -> Vec[String] {
    let c = w.cls[h].clone();
    if c.kind == K_WRAP {
        return setting_kwds_of(w, c.wrapped);
    }
    c.setting_kwds.clone()
}

fn so_map(cfg: ref Ctx, sch: ref String, cat: ref String) -> Kw {
    let mut k = kw_new();
    let mut i = 0;
    while i < cfg.so.keys.len() {
        if cfg.so.schs[i] == sch and cfg.so.cats[i] == cat {
            kw_set(mut k, cfg.so.keys[i], cfg.so.vals[i].clone());
        }
        i += 1;
    }
    k
}

fn kw_update(k: mut ref Kw, other: ref Kw) {
    let mut i = 0;
    while i < other.keys.len() {
        kw_set(mut k, other.keys[i], other.vals[i].clone());
        i += 1;
    }
}

fn kw_filter(k: ref Kw, allowed: ref Vec[String]) -> Kw {
    let mut out = kw_new();
    let mut i = 0;
    while i < k.keys.len() {
        if contains_str(allowed, k.keys[i]) {
            kw_set(mut out, k.keys[i], k.vals[i].clone());
        }
        i += 1;
    }
    out
}

fn kw_eq(a: ref Kw, b: ref Kw) -> bool {
    if a.keys.len() != b.keys.len() {
        return false;
    }
    let mut i = 0;
    while i < a.keys.len() {
        let j = kw_pos(b, a.keys[i]);
        if j < 0 or not py_eq(a.vals[i], b.vals[j]) {
            return false;
        }
        i += 1;
    }
    true
}

fn deprecated_flag(cfg: ref Ctx, scheme: ref String, cat: ref String) -> Result[(bool, bool), Exc] {
    let none = String.new();
    let base = dep_test(cfg, scheme, none)?;
    let value = match base {
        Some(b) => b,
        None => false,
    };
    if cat.len() > 0 {
        match dep_test(cfg, scheme, cat)? {
            Some(alt) => {
                if alt != value {
                    return Ok((alt, true));
                }
            }
            None => {}
        }
    }
    Ok((value, false))
}

fn dep_test(cfg: ref Ctx, scheme: ref String, cat: ref String) -> Result[Option[bool], Exc] {
    let none = String.new();
    let dkey = "deprecated".to_string();
    let source = match src_get(cfg.co, cat, none, dkey) {
        Some(v) => v,
        None => match src_get(cfg.co, none, none, dkey) {
            Some(v) => v,
            None => {
                return Ok(None);
            }
        },
    };
    let names = names_of(source);
    if contains_str(names, "auto") {
        let d = cfg_default_scheme(cfg, cat)?;
        return Ok(Some(scheme != d));
    }
    Ok(Some(contains_str(names, scheme)))
}

fn create_record(w: mut ref World, h: i64, kwds0: ref Kw) -> Result[i64, Exc] {
    let mut kwds = kwds0.clone();
    let dep = truthy(kw_pop(mut kwds, "deprecated"));
    let mut settings = kw_new();
    kw_set(mut settings, "relaxed".to_string(), Val.Bool(true));
    kw_update(mut settings, kwds);
    let sub = match h_using(mut w, h, settings) {
        Ok(s) => s,
        Err(e) => {
            if e.cls == "TypeError" and e.msg.starts_with("using() got an unexpected keyword argument '") {
                let key = substr(e.msg, 44, clen(e.msg) - 1);
                if kw_has(kwds, key) {
                    return Err(key_error(f"keyword not supported by {w.cls[h].name} handler: {str_repr(key)}"));
                }
            }
            return Err(e);
        }
    };
    w.cls[sub].orig = h;
    w.cls[sub].deprecated = dep;
    Ok(sub)
}

fn get_record(cfg: ref Ctx, scheme: ref String, cat: ref String) -> Result[i64, Exc] {
    let mut i = 0;
    while i < cfg.rec_scheme.len() {
        if cfg.rec_scheme[i] == scheme and cfg.rec_cat[i] == cat {
            return Ok(cfg.rec_cls[i]);
        }
        i += 1;
    }
    if scheme.len() == 0 {
        let d = cfg_default_scheme(cfg, cat)?;
        return get_record(cfg, d, cat);
    }
    if cat.len() > 0 {
        let mut j = 0;
        while j < cfg.rec_scheme.len() {
            if cfg.rec_scheme[j] == scheme and cfg.rec_cat[j].len() == 0 {
                return Ok(cfg.rec_cls[j]);
            }
            j += 1;
        }
    }
    Err(key_error(f"crypt algorithm not found in policy: {str_repr(scheme)}"))
}

fn identify_record(w: mut ref World, cfg: ref Ctx, hv: ref Val, cat: ref String, required: bool) -> Result[i64, Exc] {
    if not is_text(hv) {
        return Err(expected_string(hv, "hash"));
    }
    for s in cfg.schemes.clone() {
        let rec = get_record(cfg, s, cat)?;
        if truthy(h_identify(mut w, rec, hv)?) {
            return Ok(rec);
        }
    }
    if not required {
        return Ok(-1);
    }
    if cfg.schemes.len() == 0 {
        return Err(key_error("no crypt algorithms supported"));
    }
    Err(exc("UnknownHashError", "hash could not be identified".to_string()))
}

// iter_config(resolve)
fn iter_config(w: ref World, cfg: ref Ctx, resolve: bool) -> Src {
    let mut out = src_new();
    let none = String.new();
    if cfg.schemes.len() > 0 {
        let mut xs: Vec[Val] = Vec.new();
        let mut i = 0;
        while i < cfg.schemes.len() {
            xs.push(if resolve { Val.Hd(cfg.handlers[i]) } else { Val.Str(cfg.schemes[i].clone()) });
            i += 1;
        }
        src_set(mut out, none, none, "schemes".to_string(), Val.List(xs));
    }
    let mut ckeys: Vec[String] = Vec.new();
    for k in cfg.co.keys {
        if k != "schemes" and not contains_str(ckeys, k) {
            ckeys.push(k.clone());
        }
    }
    ckeys = sort_strs(ckeys);
    let mut skeys: Vec[String] = Vec.new();
    for s in cfg.so.schs {
        if not contains_str(skeys, s) {
            skeys.push(s.clone());
        }
    }
    skeys = sort_strs(skeys);
    let mut cats_all: Vec[String] = [String.new()].to_vec();
    for c in cfg.categories {
        cats_all.push(c.clone());
    }
    for cat in cats_all {
        for key in ckeys {
            match src_get(cfg.co, cat, none, key) {
                Some(v) => src_set(mut out, cat, none, key, v),
                None => {}
            }
        }
        for sch in skeys {
            let mut opts: Vec[String] = Vec.new();
            let mut i = 0;
            while i < cfg.so.keys.len() {
                if cfg.so.schs[i] == sch and cfg.so.cats[i] == cat {
                    opts.push(cfg.so.keys[i].clone());
                }
                i += 1;
            }
            for key in sort_strs(opts) {
                match src_get(cfg.so, cat, sch, key) {
                    Some(v) => src_set(mut out, cat, sch, key, v),
                    None => {}
                }
            }
        }
    }
    out
}

fn render_config_key(cat: ref String, sch: ref String, key: ref String) -> String {
    if cat.len() > 0 {
        let s = if sch.len() > 0 { sch.clone() } else { "context".to_string() };
        f"{cat}__{s}__{key}"
    } else if sch.len() > 0 {
        f"{sch}__{key}"
    } else {
        key.clone()
    }
}

fn render_ini_value(w: ref World, key: ref String, v: ref Val) -> String {
    let s = match v {
        Val.List(xs) => ini_join(w, xs),
        Val.Tuple(xs) => ini_join(w, xs),
        Val.Float(x) => {
            if key == "vary_rounds" {
                if x == 0.0 { "0".to_string() } else { strip_zeros(fmt2(x)) }
            } else {
                float_repr(x)
            }
        }
        Val.Int(n) => f"{n}",
        Val.Bool(b) => if b { "True".to_string() } else { "False".to_string() },
        Val.Hd(h) => w.cls[h].name.clone(),
        other => str_val(other),
    };
    s.replace("%", "%%")
}

fn ini_join(w: ref World, xs: ref Vec[Val]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for x in xs {
        parts.push(match x {
            Val.Hd(h) => w.cls[h].name.clone(),
            other => str_val(other),
        });
    }
    join_strs(parts, ", ")
}

// "%.2f" % x for 0 <= x <= 1.
fn fmt2(x: f64) -> String {
    let n = (x * 100.0 + 0.5) as i64;
    let frac = n % 100;
    f"{n / 100}.{zpad2(frac)}"
}

fn strip_zeros(s: ref String) -> String {
    let mut cs = chars(s);
    while cs.len() > 0 and cs[cs.len() - 1] == '0' {
        let _ = cs.pop();
    }
    text(cs)
}

// ------------------------------------------------------------ INI parsing

// ConfigParser.items(section) for the simple files the jobs use: keys
// lower-cased, values stripped, continuation lines joined.
fn parse_ini(text_: ref String, section: ref String, filename: ref String) -> Result[Src, Exc] {
    let lines = split_on(text_, '\n');
    let mut cur = String.new();
    let mut have_section = false;
    let mut found = false;
    let mut out = src_new();
    let none = String.new();
    let mut last_key = String.new();
    let mut lineno = 0;
    for raw in lines {
        lineno += 1;
        let line = py_rstrip(raw);
        let stripped = py_strip(line);
        if stripped.len() == 0 or stripped.starts_with("#") or stripped.starts_with(";") {
            continue;
        }
        if line.starts_with("[") and line.ends_with("]") {
            cur = substr(line, 1, clen(line) - 1);
            have_section = true;
            if cur == section {
                found = true;
            }
            last_key = String.new();
            continue;
        }
        if not have_section {
            return Err(exc("MissingSectionHeaderError", f"File contains no section headers.\nfile: {str_repr(filename)}, line: {lineno}\n{str_repr(raw)}"));
        }
        let first = chars(line)[0];
        if py_space(first) and last_key.len() > 0 {
            if cur == section {
                let prev = src_get(out, none, none, last_key);
                let joined = match prev {
                    Some(v) => f"{str_val(v)}\n{stripped}",
                    None => stripped.clone(),
                };
                src_set(mut out, none, none, last_key, Val.Str(joined));
            }
            continue;
        }
        let mut at = -1;
        let cs = chars(line);
        let mut i = 0;
        while i < cs.len() {
            if cs[i] == '=' or cs[i] == ':' {
                at = i;
                break;
            }
            i += 1;
        }
        if at < 0 {
            continue;
        }
        let key = ascii_lower(py_strip(substr(line, 0, at)));
        let value = py_strip(str_from(line, at + 1));
        last_key = key.clone();
        if cur == section {
            src_set(mut out, none, none, key, Val.Str(value));
        }
    }
    if not found {
        return Err(exc("NoSectionError", f"No section: {str_repr(section)}"));
    }
    Ok(out)
}

// ------------------------------------------------------------ the CryptContext API

fn new_ctx(w: mut ref World) -> i64 {
    w.ctxs.push(ctx_empty());
    w.ctxs.len() - 1
}

// CryptContext.load(source, update)
fn ctx_load(w: mut ref World, ci: i64, source: ref Val, update: bool, section: ref String) -> Result[bool, Exc] {
    let none = String.new();
    let mut src = src_new();
    match source {
        Val.Str(_) => {
            let text_ = str_val(source);
            let items = parse_ini(text_, section, "<string passed to CryptContext.load()>".to_string())?;
            src = parse_keys(items)?;
        }
        Val.Bytes(_) => {
            let text_ = str_val(source);
            let items = parse_ini(text_, section, "<string passed to CryptContext.load()>".to_string())?;
            src = parse_keys(items)?;
        }
        Val.Ctx(other) => {
            let cfg = w.ctxs[other].clone();
            src = iter_config(w, cfg, true);
        }
        Val.Dict(ks, vs) => {
            let mut items = src_new();
            let mut i = 0;
            while i < ks.len() {
                src_set(mut items, none, none, str_val(ks[i]), vs[i].clone());
                i += 1;
            }
            src = parse_keys(items)?;
        }
        other => {
            return Err(expected_type(other, "string or dict", "source"));
        }
    }
    if update and w.ctxs[ci].loaded {
        if src.keys.len() == 0 {
            return Ok(true);
        }
        let cfg = w.ctxs[ci].clone();
        let mut merged = iter_config(w, cfg, true);
        let mut i = 0;
        while i < src.keys.len() {
            src_set(mut merged, src.cats[i], src.schs[i], src.keys[i], src.vals[i].clone());
            i += 1;
        }
        src = merged;
    }
    let cfg = build_config(mut w, src)?;
    w.ctxs[ci] = cfg;
    Ok(true)
}

fn parse_keys(items: ref Src) -> Result[Src, Exc] {
    let mut out = src_new();
    let mut i = 0;
    while i < items.keys.len() {
        let (cat, sch, key) = parse_config_key(items.keys[i])?;
        src_set(mut out, cat, sch, key, items.vals[i].clone());
        i += 1;
    }
    Ok(out)
}

fn kw_to_dict(kw: ref Kw) -> Val {
    let mut ks: Vec[Val] = Vec.new();
    for k in kw.keys {
        ks.push(Val.Str(k.clone()));
    }
    Val.Dict(ks, kw.vals.clone())
}

fn ctx_handler(w: ref World, ci: i64, scheme: ref String, cat: ref String, unconfigured: bool) -> Result[i64, Exc] {
    let cfg = w.ctxs[ci].clone();
    match get_record(cfg, scheme, cat) {
        Ok(r) => {
            if unconfigured {
                return Ok(w.cls[r].orig);
            }
            return Ok(r);
        }
        Err(e) => {
            if e.cls != "KeyError" {
                return Err(e);
            }
        }
    }
    if cfg.handlers.len() > 0 {
        let shown = if scheme.len() == 0 { "None".to_string() } else { str_repr(scheme) };
        return Err(key_error(f"crypt algorithm not found in this CryptContext instance: {shown}"));
    }
    Err(key_error("no crypt algorithms loaded in this CryptContext instance"))
}

fn ctx_record_for(w: mut ref World, ci: i64, hv: ref Val, scheme: ref String, cat: ref String) -> Result[i64, Exc] {
    let cfg = w.ctxs[ci].clone();
    if scheme.len() > 0 {
        if not is_text(hv) {
            return Err(expected_string(hv, "hash"));
        }
        return get_record(cfg, scheme, cat);
    }
    identify_record(mut w, cfg, hv, cat, true)
}

// Drop the context keywords this record's handler does not take.
fn strip_context_kwds(w: ref World, ci: i64, rec: i64, kw: ref Kw) -> Kw {
    let cfg = w.ctxs[ci].clone();
    let mut all: Vec[String] = Vec.new();
    for h in cfg.handlers {
        for k in context_kwds_of(w, h) {
            all.push(k.clone());
        }
    }
    let mine = context_kwds_of(w, rec);
    let mut out = kw_new();
    let mut i = 0;
    while i < kw.keys.len() {
        if not (contains_str(all, kw.keys[i]) and not contains_str(mine, kw.keys[i])) {
            kw_set(mut out, kw.keys[i], kw.vals[i].clone());
        }
        i += 1;
    }
    out
}

fn context_kwds_of(w: ref World, h: i64) -> Vec[String] {
    let c = w.cls[h].clone();
    if c.kind == K_WRAP {
        return context_kwds_of(w, c.wrapped);
    }
    c.context_kwds.clone()
}

fn scheme_warning(w: mut ref World, meth: Str) {
    warn(mut w, "DeprecationWarning", f"CryptContext.{meth}(): 'scheme' keyword is deprecated as of Passlib 1.7, and will be removed in Passlib 2.0");
}

fn ctx_hash(w: mut ref World, ci: i64, secret: ref Val, scheme: ref Val, cat: ref String, kw: ref Kw) -> Result[Val, Exc] {
    if not is_none(scheme) {
        scheme_warning(mut w, "hash");
    }
    let cfg = w.ctxs[ci].clone();
    let rec = get_record(cfg, str_val(scheme), cat)?;
    let clean = strip_context_kwds(w, ci, rec, kw);
    h_hash(mut w, rec, secret, clean)
}

fn ctx_verify(w: mut ref World, ci: i64, secret: ref Val, hv: ref Val, scheme: ref Val, cat: ref String, kw: ref Kw) -> Result[Val, Exc] {
    if not is_none(scheme) {
        scheme_warning(mut w, "verify");
    }
    if is_none(hv) {
        return Ok(Val.Bool(false));
    }
    let rec = ctx_record_for(mut w, ci, hv, str_val(scheme), cat)?;
    let clean = strip_context_kwds(w, ci, rec, kw);
    h_verify(mut w, rec, secret, hv, clean)
}

fn ctx_needs_update(w: mut ref World, ci: i64, hv: ref Val, scheme: ref Val, cat: ref String) -> Result[Val, Exc] {
    if not is_none(scheme) {
        warn(mut w, "DeprecationWarning", "CryptContext.needs_update(): 'scheme' keyword is deprecated as of Passlib 1.7, and will be removed in Passlib 2.0");
    }
    let rec = ctx_record_for(mut w, ci, hv, str_val(scheme), cat)?;
    if w.cls[rec].deprecated {
        return Ok(Val.Bool(true));
    }
    h_needs_update(mut w, rec, hv)
}

fn ctx_verify_and_update(w: mut ref World, ci: i64, secret: ref Val, hv: ref Val, scheme: ref Val, cat: ref String, kw: ref Kw) -> Result[Val, Exc] {
    if not is_none(scheme) {
        scheme_warning(mut w, "verify");
    }
    if is_none(hv) {
        return Ok(Val.Tuple([Val.Bool(false), Val.Non].to_vec()));
    }
    let rec = ctx_record_for(mut w, ci, hv, str_val(scheme), cat)?;
    let clean = strip_context_kwds(w, ci, rec, kw);
    if not truthy(h_verify(mut w, rec, secret, hv, clean)?) {
        return Ok(Val.Tuple([Val.Bool(false), Val.Non].to_vec()));
    }
    let stale = w.cls[rec].deprecated or truthy(h_needs_update(mut w, rec, hv)?);
    if stale {
        let fresh = ctx_hash(mut w, ci, secret, Val.Non, cat, kw)?;
        return Ok(Val.Tuple([Val.Bool(true), fresh].to_vec()));
    }
    Ok(Val.Tuple([Val.Bool(true), Val.Non].to_vec()))
}

fn ctx_identify(w: mut ref World, ci: i64, hv: ref Val, cat: ref String, resolve: bool, required: bool, unconfigured: bool) -> Result[Val, Exc] {
    let cfg = w.ctxs[ci].clone();
    let rec = identify_record(mut w, cfg, hv, cat, required)?;
    if rec < 0 {
        return Ok(Val.Non);
    }
    if resolve {
        return Ok(Val.Hd(if unconfigured { w.cls[rec].orig } else { rec }));
    }
    Ok(Val.Str(w.cls[rec].name.clone()))
}

fn ctx_to_dict(w: ref World, ci: i64, resolve: bool) -> Val {
    let cfg = w.ctxs[ci].clone();
    let src = iter_config(w, cfg, resolve);
    let mut ks: Vec[Val] = Vec.new();
    let mut i = 0;
    while i < src.keys.len() {
        ks.push(Val.Str(render_config_key(src.cats[i], src.schs[i], src.keys[i])));
        i += 1;
    }
    Val.Dict(ks, src.vals.clone())
}

fn ctx_to_string(w: ref World, ci: i64, section: ref String) -> String {
    let cfg = w.ctxs[ci].clone();
    let src = iter_config(w, cfg, false);
    let mut out = f"[{section}]\n";
    let mut i = 0;
    while i < src.keys.len() {
        let k = render_config_key(src.cats[i], src.schs[i], src.keys[i]);
        let v = render_ini_value(w, src.keys[i], src.vals[i]);
        out.push_str(f"{k} = {v.replace("\n", "\n\t")}\n");
        i += 1;
    }
    out.push_str("\n");
    out
}

fn ctx_disabled_record(w: ref World, ci: i64) -> Result[i64, Exc] {
    let cfg = w.ctxs[ci].clone();
    for s in cfg.schemes.clone() {
        let rec = get_record(cfg, s, String.new())?;
        if is_disabled(w, rec) {
            return Ok(rec);
        }
    }
    Err(exc("RuntimeError", "no disabled hasher present (perhaps add 'unix_disabled' to list of schemes?)".to_string()))
}

fn is_disabled(w: ref World, h: i64) -> bool {
    let c = w.cls[h].clone();
    if c.kind == K_WRAP {
        return is_disabled(w, c.wrapped);
    }
    c.is_disabled
}

// ------------------------------------------------------------ Apache files

fn read_file(path: ref String) -> Result[Vec[u8], Exc] {
    match fs.read_bytes(path.clone()) {
        Ok(b) => Ok(b),
        Err(_) => Err(not_found(path)),
    }
}

fn read_text(path: ref String) -> Result[String, Exc] {
    match fs.read_to_string(path.clone()) {
        Ok(s) => Ok(s),
        Err(_) => Err(not_found(path)),
    }
}

fn write_file(path: ref String, b: ref Vec[u8]) -> Result[(), Exc] {
    match fs.write_bytes(path.clone(), b.clone()) {
        Ok(_) => Ok(()),
        Err(e) => Err(exc("OSError", f"{e}")),
    }
}

// An htpasswd or htdigest file: records in dict order, plus the source
// layout (skipped runs of text and record slots) that save() replays.
#[derive(Clone)]
struct HtFile {
    digest: bool,
    path: Val,
    encoding: String,
    autosave: bool,
    ctx: i64,
    default_realm: Val,
    rk_user: Vec[Vec[u8]],
    rk_realm: Vec[Vec[u8]],
    rv: Vec[Val],
    src_rec: Vec[bool],
    src_text: Vec[Vec[u8]],
    src_user: Vec[Vec[u8]],
    src_realm: Vec[Vec[u8]],
}

fn file_name(f: ref HtFile) -> String {
    if f.digest {
        "HtdigestFile".to_string()
    } else {
        "HtpasswdFile".to_string()
    }
}

fn bytes_eq(a: ref Vec[u8], b: ref Vec[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn rec_pos(f: ref HtFile, user: ref Vec[u8], realm: ref Vec[u8]) -> i64 {
    let mut i = 0;
    while i < f.rk_user.len() {
        if bytes_eq(f.rk_user[i], user) and bytes_eq(f.rk_realm[i], realm) {
            return i;
        }
        i += 1;
    }
    -1
}

fn byte_space(c: u8) -> bool {
    c == b' ' or c == b'\t' or c == b'\n' or c == b'\r' or c == 11 or c == 12
}

fn bytes_rstrip(b: ref Vec[u8]) -> Vec[u8] {
    let mut n = b.len();
    while n > 0 and byte_space(b[n - 1]) {
        n -= 1;
    }
    sub(b, 0, n)
}

fn split_lines_keep(b: ref Vec[u8]) -> Vec[Vec[u8]] {
    let mut out: Vec[Vec[u8]] = Vec.new();
    let mut start = 0;
    let mut i = 0;
    while i < b.len() {
        if b[i] == b'\n' {
            out.push(sub(b, start, i + 1));
            start = i + 1;
        }
        i += 1;
    }
    if start < b.len() {
        out.push(sub(b, start, b.len()));
    }
    out
}

fn split_colon(b: ref Vec[u8]) -> Vec[Vec[u8]] {
    let mut out: Vec[Vec[u8]] = Vec.new();
    let mut cur: Vec[u8] = Vec.new();
    for c in b {
        if c == b':' {
            out.push(cur.clone());
            cur = Vec.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn new_file(w: mut ref World, digest: bool, ctx: i64) -> i64 {
    w.files.push(HtFile {
        digest: digest,
        path: Val.Non,
        encoding: "utf-8".to_string(),
        autosave: false,
        ctx: ctx,
        default_realm: Val.Non,
        rk_user: Vec.new(),
        rk_realm: Vec.new(),
        rv: Vec.new(),
        src_rec: Vec.new(),
        src_text: Vec.new(),
        src_user: Vec.new(),
        src_realm: Vec.new(),
    });
    w.files.len() - 1
}

// _CommonFile._load_lines
fn load_lines(w: mut ref World, fi: i64, data: ref Vec[u8]) -> Result[bool, Exc] {
    let digest = w.files[fi].digest;
    let mut f = w.files[fi].clone();
    f.rk_user = Vec.new();
    f.rk_realm = Vec.new();
    f.rv = Vec.new();
    f.src_rec = Vec.new();
    f.src_text = Vec.new();
    f.src_user = Vec.new();
    f.src_realm = Vec.new();
    let mut skipped: Vec[u8] = Vec.new();
    let lines = split_lines_keep(data);
    let want = if digest { 3 } else { 2 };
    let mut idx = 0;
    while idx < lines.len() {
        let line = lines[idx].clone();
        let mut j = 0;
        while j < line.len() and byte_space(line[j]) {
            j += 1;
        }
        if j == line.len() or line[j] == b'#' {
            append(mut skipped, line);
            idx += 1;
            continue;
        }
        let parts = split_colon(bytes_rstrip(line));
        if parts.len() != want {
            let kind = if digest { "htdigest" } else { "htpasswd" };
            return Err(value_error(f"malformed {kind} file (error reading line {idx + 1})"));
        }
        let user = parts[0].clone();
        let realm = if digest { parts[1].clone() } else { Vec.new() };
        if rec_pos(f, user, realm) >= 0 {
            let key = if digest { f"({bytes_repr(user)}, {bytes_repr(realm)})" } else { bytes_repr(user) };
            println(f"  log WARNING: username occurs multiple times in source file: {key}");
            append(mut skipped, line);
            idx += 1;
            continue;
        }
        if skipped.len() > 0 {
            f.src_rec.push(false);
            f.src_text.push(skipped.clone());
            f.src_user.push(Vec.new());
            f.src_realm.push(Vec.new());
            skipped = Vec.new();
        }
        f.rk_user.push(user.clone());
        f.rk_realm.push(realm.clone());
        f.rv.push(Val.Bytes(parts[want - 1].clone()));
        f.src_rec.push(true);
        f.src_text.push(Vec.new());
        f.src_user.push(user);
        f.src_realm.push(realm);
        idx += 1;
    }
    if bytes_rstrip(skipped).len() > 0 {
        f.src_rec.push(false);
        f.src_text.push(skipped);
        f.src_user.push(Vec.new());
        f.src_realm.push(Vec.new());
    }
    w.files[fi] = f;
    Ok(true)
}

fn file_bytes(w: ref World, fi: i64) -> Vec[u8] {
    let f = w.files[fi].clone();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < f.src_rec.len() {
        if not f.src_rec[i] {
            append(mut out, f.src_text[i]);
        } else {
            let p = rec_pos(f, f.src_user[i], f.src_realm[i]);
            if p >= 0 {
                append(mut out, f.rk_user[p]);
                out.push(b':');
                if f.digest {
                    append(mut out, f.rk_realm[p]);
                    out.push(b':');
                }
                append(mut out, bytes_val(f.rv[p]));
                out.push(b'\n');
            }
        }
        i += 1;
    }
    out
}

fn set_record(w: mut ref World, fi: i64, user: ref Vec[u8], realm: ref Vec[u8], v: own Val) -> bool {
    let p = rec_pos(w.files[fi], user, realm);
    if p >= 0 {
        w.files[fi].rv[p] = v;
        return true;
    }
    w.files[fi].rk_user.push(user.clone());
    w.files[fi].rk_realm.push(realm.clone());
    w.files[fi].rv.push(v);
    w.files[fi].src_rec.push(true);
    w.files[fi].src_text.push(Vec.new());
    w.files[fi].src_user.push(user.clone());
    w.files[fi].src_realm.push(realm.clone());
    false
}

fn remove_record(w: mut ref World, fi: i64, p: i64) {
    w.files[fi].rk_user.remove(p);
    w.files[fi].rk_realm.remove(p);
    w.files[fi].rv.remove(p);
}

fn file_save(w: mut ref World, fi: i64, path: ref Val) -> Result[Val, Exc] {
    if not is_none(path) {
        write_file(str_val(path), file_bytes(w, fi))?;
        return Ok(Val.Non);
    }
    let own_path = w.files[fi].path.clone();
    if truthy(own_path) {
        write_file(str_val(own_path), file_bytes(w, fi))?;
        return Ok(Val.Non);
    }
    let name = file_name(w.files[fi]);
    Err(exc("RuntimeError", f"{name}().path is not set, cannot autosave"))
}

fn file_load(w: mut ref World, fi: i64, path: ref Val) -> Result[Val, Exc] {
    if not is_none(path) {
        let data = read_file(str_val(path))?;
        load_lines(mut w, fi, data)?;
        return Ok(Val.Bool(true));
    }
    let own_path = w.files[fi].path.clone();
    if truthy(own_path) {
        let data = read_file(str_val(own_path))?;
        load_lines(mut w, fi, data)?;
        return Ok(Val.Bool(true));
    }
    let name = file_name(w.files[fi]);
    Err(exc("RuntimeError", f"{name}().path is not set, an explicit path is required"))
}

fn file_autosave(w: mut ref World, fi: i64) -> Result[bool, Exc] {
    if w.files[fi].autosave and truthy(w.files[fi].path) {
        file_save(mut w, fi, Val.Non)?;
    }
    Ok(true)
}

fn encode_field(w: ref World, fi: i64, v: ref Val, param: Str) -> Result[Vec[u8], Exc] {
    let b = match v {
        Val.Str(s) => encode_text(s, w.files[fi].encoding)?,
        Val.Bytes(b) => b.clone(),
        other => {
            return Err(expected_string(other, param));
        }
    };
    if b.len() > 255 {
        return Err(value_error(f"{param} must be at most 255 characters: {bytes_repr(b)}"));
    }
    for c in b {
        if c == b':' or c == b'\n' or c == b'\r' or c == b'\t' or c == 0 {
            return Err(value_error(f"{param} contains invalid characters: {bytes_repr(b)}"));
        }
    }
    Ok(b)
}

fn decode_field(w: ref World, fi: i64, b: ref Vec[u8]) -> Val {
    Val.Str(decode_text(b, w.files[fi].encoding))
}

fn require_realm(w: ref World, fi: i64, realm: ref Val) -> Result[Val, Exc] {
    if is_none(realm) {
        let d = w.files[fi].default_realm.clone();
        if is_none(d) {
            return Err(type_error("you must specify a realm explicitly, or set the default_realm attribute".to_string()));
        }
        return Ok(d);
    }
    Ok(realm.clone())
}

fn encode_realm(w: ref World, fi: i64, realm: ref Val) -> Result[Vec[u8], Exc] {
    let r = require_realm(w, fi, realm)?;
    encode_field(w, fi, r, "realm")
}

fn ascii_codec(enc: ref String) -> bool {
    let e = ascii_lower(enc).replace("_", "-");
    e == "utf-8" or e == "utf8" or e == "ascii" or e == "latin-1" or e == "latin1" or e == "iso-8859-1" or e == "cp437"
}

// The default_scheme aliases apache.py resolves (bcrypt is available).
fn htpasswd_default(name: ref String) -> String {
    if name == "portable" or name == "host" or name == "portable_apache_24" or name == "host_apache_24" or name == "linux_apache_24" {
        return "bcrypt".to_string();
    }
    if name == "portable_apache_22" or name == "host_apache_22" {
        return "apr_md5_crypt".to_string();
    }
    if name == "linux_apache_22" {
        return "sha256_crypt".to_string();
    }
    name.clone()
}

// CryptContext.copy(**kwds)
fn ctx_copy(w: mut ref World, ci: i64, kw: ref Kw) -> Result[i64, Exc] {
    let other = new_ctx(mut w);
    ctx_load(mut w, other, Val.Ctx(ci), false, "passlib".to_string())?;
    if kw_len(kw) > 0 {
        ctx_load(mut w, other, kw_to_dict(kw), true, "passlib".to_string())?;
    }
    Ok(other)
}

// _CommonFile.__init__ after the subclass has taken its own keywords.
fn common_init(w: mut ref World, fi: i64, path: ref Val, kw: mut ref Kw) -> Result[bool, Exc] {
    let new = truthy(kw_pop(mut kw, "new"));
    let autosave = truthy(kw_pop(mut kw, "autosave"));
    let enc = if kw_has(kw, "encoding") { kw_pop(mut kw, "encoding") } else { sv("utf-8") };
    if kw_len(kw) > 0 {
        return Err(type_error(f"__init__() got an unexpected keyword argument {str_repr(kw.keys[0])}"));
    }
    if not truthy(enc) {
        warn(mut w, "DeprecationWarning", "``encoding=None`` is deprecated as of Passlib 1.6, and will cause a ValueError in Passlib 1.8, use ``return_unicode=False`` instead.");
    } else if not ascii_codec(str_val(enc)) {
        return Err(value_error("encoding must be 7-bit ascii compatible".to_string()));
    } else {
        w.files[fi].encoding = str_val(enc);
    }
    w.files[fi].autosave = autosave;
    w.files[fi].path = path.clone();
    if truthy(path) and not new {
        file_load(mut w, fi, Val.Non)?;
    }
    Ok(true)
}

fn htpasswd_new(w: mut ref World, path: ref Val, kw0: ref Kw) -> Result[i64, Exc] {
    let mut kw = kw0.clone();
    let mut ds = kw_pop(mut kw, "default_scheme");
    if kw_has(kw, "default") {
        warn(mut w, "DeprecationWarning", "``default`` is deprecated as of Passlib 1.6, and will be removed in Passlib 1.8, it has been renamed to ``default_scheem``.");
        ds = kw_pop(mut kw, "default");
    }
    let mut ctx = if kw_has(kw, "context") {
        match kw_pop(mut kw, "context") {
            Val.Ctx(c) => c,
            other => {
                return Err(expected_type(other, "CryptContext", "context"));
            }
        }
    } else {
        w.htctx
    };
    if truthy(ds) {
        let name = htpasswd_default(str_val(ds));
        let mut k = kw_new();
        kw_set(mut k, "default".to_string(), Val.Str(name));
        ctx = ctx_copy(mut w, ctx, k)?;
    }
    let fi = new_file(mut w, false, ctx);
    common_init(mut w, fi, path, mut kw)?;
    Ok(fi)
}

fn htdigest_new(w: mut ref World, path: ref Val, kw0: ref Kw) -> Result[i64, Exc] {
    let mut kw = kw0.clone();
    let realm = kw_pop(mut kw, "default_realm");
    let fi = new_file(mut w, true, -1);
    w.files[fi].default_realm = realm;
    common_init(mut w, fi, path, mut kw)?;
    Ok(fi)
}

fn file_new(w: mut ref World, digest: bool, path: ref Val, kw: ref Kw) -> Result[i64, Exc] {
    if digest {
        htdigest_new(mut w, path, kw)
    } else {
        htpasswd_new(mut w, path, kw)
    }
}

// cls.from_string(data, **kwds)
fn file_from_string(w: mut ref World, digest: bool, data: ref Val, kw: ref Kw) -> Result[Val, Exc] {
    if kw_has(kw, "path") {
        return Err(type_error("'path' not accepted by from_string()".to_string()));
    }
    let fi = file_new(mut w, digest, Val.Non, kw)?;
    let b = match data {
        Val.Str(s) => encode_text(s, w.files[fi].encoding)?,
        Val.Bytes(b) => b.clone(),
        other => {
            return Err(expected_string(other, "data"));
        }
    };
    load_lines(mut w, fi, b)?;
    Ok(Val.File(fi))
}

fn file_users(w: ref World, fi: i64) -> Val {
    let mut out: Vec[Val] = Vec.new();
    for u in w.files[fi].rk_user {
        out.push(decode_field(w, fi, u));
    }
    Val.List(out)
}

fn ht_set_hash(w: mut ref World, fi: i64, user: ref Val, realm: ref Val, hash: ref Val) -> Result[Val, Exc] {
    let hb = match hash {
        Val.Str(s) => Val.Bytes(encode_text(s, w.files[fi].encoding)?),
        other => other.clone(),
    };
    let ub = encode_field(w, fi, user, "user")?;
    let rb = if w.files[fi].digest { encode_realm(w, fi, realm)? } else { Vec.new() };
    let existing = set_record(mut w, fi, ub, rb, hb);
    file_autosave(mut w, fi)?;
    Ok(Val.Bool(existing))
}

fn ht_get_hash(w: ref World, fi: i64, user: ref Val, realm: ref Val) -> Result[Val, Exc] {
    let ub = encode_field(w, fi, user, "user")?;
    let rb = if w.files[fi].digest { encode_realm(w, fi, realm)? } else { Vec.new() };
    let p = rec_pos(w.files[fi], ub, rb);
    if p < 0 {
        return Ok(Val.Non);
    }
    let v = w.files[fi].rv[p].clone();
    if w.files[fi].digest {
        return Ok(Val.Str(decode_text(bytes_val(v), w.files[fi].encoding)));
    }
    Ok(v)
}

fn ht_delete(w: mut ref World, fi: i64, user: ref Val, realm: ref Val) -> Result[Val, Exc] {
    let ub = encode_field(w, fi, user, "user")?;
    let rb = if w.files[fi].digest { encode_realm(w, fi, realm)? } else { Vec.new() };
    let p = rec_pos(w.files[fi], ub, rb);
    if p < 0 {
        return Ok(Val.Bool(false));
    }
    remove_record(mut w, fi, p);
    file_autosave(mut w, fi)?;
    Ok(Val.Bool(true))
}

fn htpasswd_check(w: mut ref World, fi: i64, user: ref Val, password: ref Val) -> Result[Val, Exc] {
    let ub = encode_field(w, fi, user, "user")?;
    let p = rec_pos(w.files[fi], ub, Vec.new());
    if p < 0 {
        return Ok(Val.Non);
    }
    let hash = w.files[fi].rv[p].clone();
    let pw = match password {
        Val.Str(s) => Val.Bytes(encode_text(s, w.files[fi].encoding)?),
        other => other.clone(),
    };
    let ci = w.files[fi].ctx;
    let res = ctx_verify_and_update(mut w, ci, pw, hash, Val.Non, String.new(), kw_new())?;
    let (ok, fresh) = match res {
        Val.Tuple(xs) => (xs[0].clone(), xs[1].clone()),
        other => (other.clone(), Val.Non),
    };
    if truthy(ok) and not is_none(fresh) {
        w.files[fi].rv[p] = fresh;
        file_autosave(mut w, fi)?;
    }
    Ok(ok)
}

fn htdigest_check(w: mut ref World, fi: i64, user: ref Val, realm: ref Val, password: ref Val) -> Result[Val, Exc] {
    let ub = encode_field(w, fi, user, "user")?;
    let rb = encode_realm(w, fi, realm)?;
    let p = rec_pos(w.files[fi], ub, rb);
    if p < 0 {
        return Ok(Val.Non);
    }
    let hash = w.files[fi].rv[p].clone();
    let mut kw = kw_new();
    kw_set(mut kw, "user".to_string(), Val.Bytes(ub));
    kw_set(mut kw, "realm".to_string(), Val.Bytes(rb));
    kw_set(mut kw, "encoding".to_string(), Val.Str(w.files[fi].encoding.clone()));
    h_verify(mut w, K_HTDIGEST, password, hash, kw)
}

fn htdigest_realms(w: ref World, fi: i64) -> Val {
    let mut seen: Vec[Vec[u8]] = Vec.new();
    for r in w.files[fi].rk_realm {
        let mut dup = false;
        for s in seen {
            if bytes_eq(s, r) {
                dup = true;
            }
        }
        if not dup {
            seen.push(r.clone());
        }
    }
    let mut out: Vec[Val] = Vec.new();
    for r in seen {
        out.push(decode_field(w, fi, r));
    }
    Val.List(out)
}

fn htdigest_users(w: ref World, fi: i64, realm: ref Val) -> Result[Val, Exc] {
    let rb = encode_realm(w, fi, realm)?;
    let mut out: Vec[Val] = Vec.new();
    let mut i = 0;
    while i < w.files[fi].rk_user.len() {
        if bytes_eq(w.files[fi].rk_realm[i], rb) {
            out.push(decode_field(w, fi, w.files[fi].rk_user[i]));
        }
        i += 1;
    }
    Ok(Val.List(out))
}

fn htdigest_delete_realm(w: mut ref World, fi: i64, realm: ref Val) -> Result[Val, Exc] {
    let rb = encode_realm(w, fi, realm)?;
    let mut n = 0;
    let mut i = 0;
    while i < w.files[fi].rk_user.len() {
        if bytes_eq(w.files[fi].rk_realm[i], rb) {
            remove_record(mut w, fi, i);
            n += 1;
        } else {
            i += 1;
        }
    }
    file_autosave(mut w, fi)?;
    Ok(Val.Int(n))
}

// ------------------------------------------------------------ the job evaluator

// Each job is one Python expression; this is just enough of Python's
// expression grammar to evaluate them: names, attributes, calls with
// keyword arguments, literals, lists, dicts, unary minus, `+` and `*`.
#[derive(Clone)]
enum Tok {
    Name(String),
    Int(i64),
    Flt(f64),
    S(String),
    B(Vec[u8]),
    Op(char),
    End,
}

fn syntax_error(msg: Str) -> Exc {
    exc("SyntaxError", msg.to_string())
}

// One string literal starting at the quote cs[i]: its code points and the
// index just past the closing quote.
fn lex_string(cs: ref Vec[char], i0: i64) -> Result[(Vec[i64], i64), Exc] {
    let q = cs[i0];
    let mut i = i0 + 1;
    let mut out: Vec[i64] = Vec.new();
    while i < cs.len() and cs[i] != q {
        let c = cs[i];
        if c == '\\' and i + 1 < cs.len() {
            let e = cs[i + 1];
            i += 2;
            if e == 'n' {
                out.push(10);
            } else if e == 't' {
                out.push(9);
            } else if e == 'r' {
                out.push(13);
            } else if e == '0' {
                out.push(0);
            } else if e == '\\' or e == '\'' or e == '"' {
                out.push(e as i64);
            } else if e == 'x' or e == 'u' {
                let n = if e == 'x' { 2 } else { 4 };
                let mut v = 0;
                let mut j = 0;
                while j < n {
                    v = v * 16 + hex_val(cs[i + j]);
                    j += 1;
                }
                out.push(v);
                i += n;
            } else {
                out.push('\\' as i64);
                out.push(e as i64);
            }
            continue;
        }
        out.push(c as i64);
        i += 1;
    }
    if i >= cs.len() {
        return Err(syntax_error("unterminated string literal"));
    }
    Ok((out, i + 1))
}

fn tokenize(src: ref String) -> Result[Vec[Tok], Exc] {
    let cs = chars(src);
    let mut out: Vec[Tok] = Vec.new();
    let mut i = 0;
    while i < cs.len() {
        let c = cs[i];
        if c == ' ' {
            i += 1;
            continue;
        }
        if c == 'b' and i + 1 < cs.len() and (cs[i + 1] == '\'' or cs[i + 1] == '"') {
            let (cps, j) = lex_string(cs, i + 1)?;
            let mut b: Vec[u8] = Vec.new();
            for cp in cps {
                b.push(cp as u8);
            }
            out.push(Tok.B(b));
            i = j;
            continue;
        }
        if is_alpha(c) or c == '_' {
            let mut name: Vec[char] = Vec.new();
            while i < cs.len() and (is_alpha(cs[i]) or is_digit(cs[i]) or cs[i] == '_') {
                name.push(cs[i]);
                i += 1;
            }
            out.push(Tok.Name(text(name)));
            continue;
        }
        if is_digit(c) {
            let mut num: Vec[char] = Vec.new();
            let mut flt = false;
            while i < cs.len() and (is_digit(cs[i]) or cs[i] == '.') {
                if cs[i] == '.' {
                    flt = true;
                }
                num.push(cs[i]);
                i += 1;
            }
            let s = text(num);
            if flt {
                match py_float(s) {
                    Some(x) => out.push(Tok.Flt(x)),
                    None => {
                        return Err(syntax_error("invalid decimal literal"));
                    }
                }
            } else {
                out.push(Tok.Int(py_int(s)?));
            }
            continue;
        }
        if c == '\'' or c == '"' {
            let (cps, j) = lex_string(cs, i)?;
            let mut s: Vec[char] = Vec.new();
            for cp in cps {
                s.push(chr(cp));
            }
            out.push(Tok.S(text(s)));
            i = j;
            continue;
        }
        out.push(Tok.Op(c));
        i += 1;
    }
    out.push(Tok.End);
    Ok(out)
}

struct P {
    toks: Vec[Tok],
    pos: i64,
}

fn is_op(p: ref P, c: char) -> bool {
    match p.toks[p.pos].clone() {
        Tok.Op(x) => x == c,
        _ => false,
    }
}

fn expect_op(p: mut ref P, c: char) -> Result[bool, Exc] {
    if not is_op(p, c) {
        return Err(syntax_error("invalid syntax"));
    }
    p.pos += 1;
    Ok(true)
}

#[derive(Clone)]
struct CallArgs {
    pos: Vec[Val],
    kw: Kw,
}

// Bind parameter `i` (or keyword `name`), consuming the keyword.
fn take(a: mut ref CallArgs, i: i64, name: Str) -> Option[Val] {
    if i >= 0 and i < a.pos.len() {
        return Some(a.pos[i].clone());
    }
    if kw_has(a.kw, name) {
        return Some(kw_pop(mut a.kw, name));
    }
    None
}

fn take_or(a: mut ref CallArgs, i: i64, name: Str, d: own Val) -> Val {
    match take(mut a, i, name) {
        Some(v) => v,
        None => d,
    }
}

fn take_cat(a: mut ref CallArgs, i: i64, name: Str) -> String {
    let v = take_or(mut a, i, name, Val.Non);
    if is_none(v) { String.new() } else { str_val(v) }
}

fn ev_expr(w: mut ref World, p: mut ref P) -> Result[Val, Exc] {
    let mut v = ev_term(mut w, mut p)?;
    while is_op(p, '+') {
        p.pos += 1;
        let r = ev_term(mut w, mut p)?;
        v = py_add(v, r)?;
    }
    Ok(v)
}

fn ev_term(w: mut ref World, p: mut ref P) -> Result[Val, Exc] {
    let mut v = ev_unary(mut w, mut p)?;
    while is_op(p, '*') {
        p.pos += 1;
        let r = ev_unary(mut w, mut p)?;
        v = py_mul(v, r)?;
    }
    Ok(v)
}

fn ev_unary(w: mut ref World, p: mut ref P) -> Result[Val, Exc] {
    if is_op(p, '-') {
        p.pos += 1;
        let v = ev_unary(mut w, mut p)?;
        return match v {
            Val.Int(n) => Ok(Val.Int(0 - n)),
            Val.Float(x) => Ok(Val.Float(0.0 - x)),
            other => Err(type_error(f"bad operand type for unary -: {str_repr(type_name(other))}")),
        };
    }
    ev_postfix(mut w, mut p)
}

fn ev_postfix(w: mut ref World, p: mut ref P) -> Result[Val, Exc] {
    let mut v = ev_atom(mut w, mut p)?;
    loop {
        if is_op(p, '.') {
            p.pos += 1;
            let name = match p.toks[p.pos].clone() {
                Tok.Name(s) => s,
                _ => {
                    return Err(syntax_error("invalid syntax"));
                }
            };
            p.pos += 1;
            if is_op(p, '(') {
                let a = ev_args(mut w, mut p)?;
                v = call_method(mut w, v, name, a)?;
            } else {
                v = get_attr(w, v, name)?;
            }
        } else if is_op(p, '(') {
            let a = ev_args(mut w, mut p)?;
            v = call_value(mut w, v, a)?;
        } else {
            break;
        }
    }
    Ok(v)
}

fn ev_args(w: mut ref World, p: mut ref P) -> Result[CallArgs, Exc] {
    expect_op(mut p, '(')?;
    let mut a = CallArgs { pos: Vec.new(), kw: kw_new() };
    while not is_op(p, ')') {
        let mut kwname = String.new();
        match p.toks[p.pos].clone() {
            Tok.Name(s) => {
                match p.toks[p.pos + 1].clone() {
                    Tok.Op(c) => {
                        if c == '=' {
                            kwname = s;
                        }
                    }
                    _ => {}
                }
            }
            _ => {}
        }
        if kwname.len() > 0 {
            p.pos += 2;
            let v = ev_expr(mut w, mut p)?;
            kw_set(mut a.kw, kwname, v);
        } else {
            let v = ev_expr(mut w, mut p)?;
            a.pos.push(v);
        }
        if is_op(p, ',') {
            p.pos += 1;
        } else if not is_op(p, ')') {
            return Err(syntax_error("invalid syntax"));
        }
    }
    p.pos += 1;
    Ok(a)
}

fn ev_atom(w: mut ref World, p: mut ref P) -> Result[Val, Exc] {
    let t = p.toks[p.pos].clone();
    p.pos += 1;
    match t {
        Tok.Name(s) => lookup(w, s),
        Tok.Int(n) => Ok(Val.Int(n)),
        Tok.Flt(x) => Ok(Val.Float(x)),
        Tok.S(s) => Ok(Val.Str(s)),
        Tok.B(b) => Ok(Val.Bytes(b)),
        Tok.Op(c) => {
            if c == '[' {
                let mut xs: Vec[Val] = Vec.new();
                while not is_op(p, ']') {
                    xs.push(ev_expr(mut w, mut p)?);
                    if is_op(p, ',') {
                        p.pos += 1;
                    }
                }
                p.pos += 1;
                return Ok(Val.List(xs));
            }
            if c == '{' {
                let mut ks: Vec[Val] = Vec.new();
                let mut vs: Vec[Val] = Vec.new();
                while not is_op(p, '}') {
                    ks.push(ev_expr(mut w, mut p)?);
                    expect_op(mut p, ':')?;
                    vs.push(ev_expr(mut w, mut p)?);
                    if is_op(p, ',') {
                        p.pos += 1;
                    }
                }
                p.pos += 1;
                return Ok(Val.Dict(ks, vs));
            }
            if c == '(' {
                let v = ev_expr(mut w, mut p)?;
                expect_op(mut p, ')')?;
                return Ok(v);
            }
            Err(syntax_error("invalid syntax"))
        }
        Tok.End => Err(syntax_error("invalid syntax")),
    }
}

fn py_add(a: ref Val, b: ref Val) -> Result[Val, Exc] {
    match (a, b) {
        (Val.Str(x), Val.Str(y)) => Ok(Val.Str(f"{x}{y}")),
        (Val.Bytes(x), Val.Bytes(y)) => Ok(Val.Bytes(cat(x, y))),
        (Val.Int(x), Val.Int(y)) => Ok(Val.Int(x + y)),
        _ => Err(type_error(f"unsupported operand type(s) for +: {str_repr(type_name(a))} and {str_repr(type_name(b))}")),
    }
}

fn py_mul(a: ref Val, b: ref Val) -> Result[Val, Exc] {
    match (a, b) {
        (Val.Str(x), Val.Int(n)) => Ok(Val.Str(repeat_str(x, n))),
        (Val.Bytes(x), Val.Int(n)) => Ok(Val.Bytes(times_bytes(x, n))),
        (Val.Int(x), Val.Int(y)) => Ok(Val.Int(x * y)),
        _ => Err(type_error(f"unsupported operand type(s) for *: {str_repr(type_name(a))} and {str_repr(type_name(b))}")),
    }
}

fn repeat_str(s: ref String, n: i64) -> String {
    let mut out = String.new();
    let mut i = 0;
    while i < n {
        out.push_str(s);
        i += 1;
    }
    out
}

fn times_bytes(b: ref Vec[u8], n: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < n {
        append(mut out, b);
        i += 1;
    }
    out
}

const F_CRYPTCONTEXT: i64 = 0;
const F_HTPASSWD: i64 = 1;
const F_HTDIGEST: i64 = 2;
const F_SORTED: i64 = 3;
const F_READ_TEXT: i64 = 4;

fn lookup(w: ref World, name: ref String) -> Result[Val, Exc] {
    if name == "True" {
        return Ok(Val.Bool(true));
    }
    if name == "False" {
        return Ok(Val.Bool(false));
    }
    if name == "None" {
        return Ok(Val.Non);
    }
    match ns_get(w, name) {
        Some(v) => {
            return Ok(v);
        }
        None => {}
    }
    let builtins = strs("CryptContext HtpasswdFile HtdigestFile sorted read_text");
    let f = pos_of(builtins, name);
    if f >= 0 {
        return Ok(Val.Fn(f));
    }
    let h = find_base(w, name);
    if h >= 0 {
        return Ok(Val.Hd(h));
    }
    Err(exc("NameError", f"name {str_repr(name)} is not defined"))
}

fn no_kwargs(a: ref CallArgs, fname: Str) -> Result[bool, Exc] {
    if kw_len(a.kw) > 0 {
        return Err(type_error(f"{fname}() got an unexpected keyword argument {str_repr(a.kw.keys[0])}"));
    }
    Ok(true)
}

fn call_value(w: mut ref World, f: ref Val, a0: ref CallArgs) -> Result[Val, Exc] {
    let mut a = a0.clone();
    let fid = match f {
        Val.Fn(i) => *i,
        other => {
            return Err(type_error(f"{str_repr(type_name(other))} object is not callable"));
        }
    };
    if fid == F_CRYPTCONTEXT {
        let schemes = take(mut a, 0, "schemes");
        let mut ks: Vec[Val] = Vec.new();
        let mut vs: Vec[Val] = Vec.new();
        let mut i = 0;
        while i < a.kw.keys.len() {
            ks.push(Val.Str(a.kw.keys[i].clone()));
            vs.push(a.kw.vals[i].clone());
            i += 1;
        }
        match schemes {
            Some(s) => {
                if not is_none(s) {
                    ks.push(sv("schemes"));
                    vs.push(s);
                }
            }
            None => {}
        }
        let ci = new_ctx(mut w);
        ctx_load(mut w, ci, Val.Dict(ks, vs), false, "passlib".to_string())?;
        return Ok(Val.Ctx(ci));
    }
    if fid == F_HTPASSWD or fid == F_HTDIGEST {
        let digest = fid == F_HTDIGEST;
        let path = take_or(mut a, 0, "path", Val.Non);
        let second = if digest { "default_realm" } else { "default_scheme" };
        if a.pos.len() > 1 {
            kw_set(mut a.kw, second.to_string(), a.pos[1].clone());
        }
        if a.pos.len() > 2 and not digest {
            kw_set(mut a.kw, "context".to_string(), a.pos[2].clone());
        }
        let fi = file_new(mut w, digest, path, a.kw)?;
        return Ok(Val.File(fi));
    }
    if fid == F_SORTED {
        let xs = match take_or(mut a, 0, "iterable", Val.Non) {
            Val.List(xs) => xs,
            Val.Tuple(xs) => xs,
            other => {
                return Err(type_error(f"{str_repr(type_name(other))} object is not iterable"));
            }
        };
        let mut names: Vec[String] = Vec.new();
        for x in xs {
            names.push(str_val(x));
        }
        return Ok(Val.List(str_list(sort_strs(names))));
    }
    let path = take_or(mut a, 0, "path", Val.Non);
    Ok(Val.Str(read_text(str_val(path))?))
}

fn get_attr(w: ref World, v: ref Val, name: ref String) -> Result[Val, Exc] {
    match v {
        Val.Hd(ci) => h_attr(w, ci, name),
        Val.File(fi) => {
            let f = w.files[fi].clone();
            if name == "path" {
                return Ok(f.path.clone());
            }
            if name == "context" and not f.digest {
                return Ok(Val.Ctx(f.ctx));
            }
            if name == "default_realm" and f.digest {
                return Ok(f.default_realm.clone());
            }
            if name == "encoding" {
                return Ok(Val.Str(f.encoding.clone()));
            }
            if name == "autosave" {
                return Ok(Val.Bool(f.autosave));
            }
            Err(exc("AttributeError", f"{str_repr(file_name(f))} object has no attribute {str_repr(name)}"))
        }
        other => Err(exc("AttributeError", f"{str_repr(type_name(other))} object has no attribute {str_repr(name)}")),
    }
}

fn call_method(w: mut ref World, recv: ref Val, name: ref String, a: ref CallArgs) -> Result[Val, Exc] {
    match recv {
        Val.Hd(ci) => handler_method(mut w, ci, name, a),
        Val.Ctx(ci) => ctx_method(mut w, ci, name, a),
        Val.File(fi) => file_method(mut w, fi, name, a),
        Val.Fn(f) => class_method(mut w, f, name, a),
        Val.Bytes(b) => {
            if name == "decode" {
                let mut a2 = a.clone();
                let enc = take_or(mut a2, 0, "encoding", sv("utf-8"));
                return Ok(Val.Str(decode_text(b, str_val(enc))));
            }
            Err(exc("AttributeError", f"'bytes' object has no attribute {str_repr(name)}"))
        }
        other => Err(exc("AttributeError", f"{str_repr(type_name(other))} object has no attribute {str_repr(name)}")),
    }
}

fn class_method(w: mut ref World, f: i64, name: ref String, a0: ref CallArgs) -> Result[Val, Exc] {
    let mut a = a0.clone();
    if f == F_CRYPTCONTEXT and name == "from_string" {
        let source = take_or(mut a, 0, "source", Val.Non);
        let section = str_val(take_or(mut a, 1, "section", sv("passlib")));
        if not is_text(source) {
            return Err(expected_type(source, "unicode or bytes", "source"));
        }
        let ci = new_ctx(mut w);
        ctx_load(mut w, ci, source, false, section)?;
        return Ok(Val.Ctx(ci));
    }
    if f == F_CRYPTCONTEXT and name == "from_path" {
        let path = str_val(take_or(mut a, 0, "path", Val.Non));
        let section = str_val(take_or(mut a, 1, "section", sv("passlib")));
        let text_ = read_text(path)?;
        let items = parse_ini(text_, section, path)?;
        let mut ks: Vec[Val] = Vec.new();
        for k in items.keys {
            ks.push(Val.Str(k.clone()));
        }
        let ci = new_ctx(mut w);
        ctx_load(mut w, ci, Val.Dict(ks, items.vals.clone()), false, section)?;
        return Ok(Val.Ctx(ci));
    }
    if (f == F_HTPASSWD or f == F_HTDIGEST) and name == "from_string" {
        let data = take_or(mut a, 0, "data", Val.Non);
        return file_from_string(mut w, f == F_HTDIGEST, data, a.kw);
    }
    if (f == F_HTPASSWD or f == F_HTDIGEST) and name == "from_path" {
        let path = take_or(mut a, 0, "path", Val.Non);
        let fi = file_new(mut w, f == F_HTDIGEST, Val.Non, a.kw)?;
        file_load(mut w, fi, path)?;
        return Ok(Val.File(fi));
    }
    Err(exc("AttributeError", f"type object has no attribute {str_repr(name)}"))
}

// Positional arguments past the fixed ones bind to the handler's context
// keywords, the way htdigest.hash(secret, user, realm) spells them.
fn ctx_args(w: ref World, ci: i64, a: ref CallArgs, fixed: i64) -> Kw {
    let mut kw = a.kw.clone();
    let names = context_kwds_of(w, ci);
    let mut i = fixed;
    while i < a.pos.len() {
        let j = i - fixed;
        if j < names.len() {
            kw_set(mut kw, names[j], a.pos[i].clone());
        }
        i += 1;
    }
    kw
}

fn handler_method(w: mut ref World, ci: i64, name: ref String, a0: ref CallArgs) -> Result[Val, Exc] {
    let mut a = a0.clone();
    if name == "hash" or name == "encrypt" {
        let secret = take_or(mut a, 0, "secret", Val.Non);
        let kw = ctx_args(w, ci, a, 1);
        return h_hash(mut w, ci, secret, kw);
    }
    if name == "verify" {
        let secret = take_or(mut a, 0, "secret", Val.Non);
        let hv = take_or(mut a, 1, "hash", Val.Non);
        let kw = ctx_args(w, ci, a, 2);
        return h_verify(mut w, ci, secret, hv, kw);
    }
    if name == "identify" {
        let hv = take_or(mut a, 0, "hash", Val.Non);
        return h_identify(mut w, ci, hv);
    }
    if name == "using" {
        let sub = h_using(mut w, ci, a.kw)?;
        return Ok(Val.Hd(sub));
    }
    if name == "parsehash" {
        let hv = take_or(mut a, 0, "hash", Val.Non);
        let checksum = truthy(take_or(mut a, 1, "checksum", Val.Bool(true)));
        let sanitize = truthy(take_or(mut a, 2, "sanitize", Val.Bool(false)));
        return h_parsehash(mut w, ci, hv, checksum, sanitize);
    }
    if name == "needs_update" {
        let hv = take_or(mut a, 0, "hash", Val.Non);
        return h_needs_update(mut w, ci, hv);
    }
    if name == "genconfig" {
        return h_genconfig(mut w, ci, a.kw);
    }
    if name == "genhash" {
        let secret = take_or(mut a, 0, "secret", Val.Non);
        let config = take_or(mut a, 1, "config", Val.Non);
        let kw = ctx_args(w, ci, a, 2);
        return h_genhash(mut w, ci, secret, config, kw);
    }
    if name == "normhash" {
        let hv = take_or(mut a, 0, "hash", Val.Non);
        return h_normhash(mut w, ci, hv);
    }
    if name == "raw" {
        let secret = take_or(mut a, 0, "secret", Val.Non);
        let k = w.cls[ci].kind;
        if k == K_NTHASH {
            return Ok(Val.Bytes(nthash_raw(secret)?));
        }
        if k == K_LMHASH {
            let e = take_or(mut a, 1, "encoding", Val.Non);
            let enc = if is_none(e) { w.cls[ci].default_encoding.clone() } else { str_val(e) };
            return Ok(Val.Bytes(lmhash_raw(w, secret, enc)?));
        }
    }
    if name == "decode" and w.cls[ci].kind == K_CISCO7 {
        let hv = take_or(mut a, 0, "hash", Val.Non);
        let enc = take_or(mut a, 1, "encoding", sv("utf-8"));
        return h_decode(mut w, ci, hv, enc);
    }
    if name == "disable" {
        let hv = take_or(mut a, 0, "hash", Val.Non);
        return h_disable(mut w, ci, hv);
    }
    if name == "enable" {
        let hv = take_or(mut a, 0, "hash", Val.Non);
        return h_enable(mut w, ci, hv);
    }
    Err(exc("AttributeError", f"type object {str_repr(w.cls[ci].clsname)} has no attribute {str_repr(name)}"))
}

fn ctx_method(w: mut ref World, ci: i64, name: ref String, a0: ref CallArgs) -> Result[Val, Exc] {
    let mut a = a0.clone();
    if name == "schemes" {
        let resolve = truthy(take_or(mut a, 0, "resolve", Val.Bool(false)));
        let cat = take_cat(mut a, 1, "category");
        let unconf = truthy(take_or(mut a, 2, "unconfigured", Val.Bool(false)));
        let names = w.ctxs[ci].schemes.clone();
        if not resolve {
            return Ok(str_tuple(names));
        }
        let mut out: Vec[Val] = Vec.new();
        for s in names {
            out.push(Val.Hd(ctx_handler(w, ci, s, cat, unconf)?));
        }
        return Ok(Val.Tuple(out));
    }
    if name == "default_scheme" {
        let cat = take_cat(mut a, 0, "category");
        let resolve = truthy(take_or(mut a, 1, "resolve", Val.Bool(false)));
        let unconf = truthy(take_or(mut a, 2, "unconfigured", Val.Bool(false)));
        let h = ctx_handler(w, ci, String.new(), cat, unconf)?;
        if resolve {
            return Ok(Val.Hd(h));
        }
        return Ok(Val.Str(w.cls[h].name.clone()));
    }
    if name == "handler" {
        let scheme = take_cat(mut a, 0, "scheme");
        let cat = take_cat(mut a, 1, "category");
        let unconf = truthy(take_or(mut a, 2, "unconfigured", Val.Bool(false)));
        return Ok(Val.Hd(ctx_handler(w, ci, scheme, cat, unconf)?));
    }
    if name == "identify" {
        let hv = take_or(mut a, 0, "hash", Val.Non);
        let cat = take_cat(mut a, 1, "category");
        let resolve = truthy(take_or(mut a, 2, "resolve", Val.Bool(false)));
        let required = truthy(take_or(mut a, 3, "required", Val.Bool(false)));
        let unconf = truthy(take_or(mut a, 4, "unconfigured", Val.Bool(false)));
        return ctx_identify(mut w, ci, hv, cat, resolve, required, unconf);
    }
    if name == "hash" {
        let secret = take_or(mut a, 0, "secret", Val.Non);
        let scheme = take_or(mut a, 1, "scheme", Val.Non);
        let cat = take_cat(mut a, 2, "category");
        return ctx_hash(mut w, ci, secret, scheme, cat, a.kw);
    }
    if name == "verify" {
        let secret = take_or(mut a, 0, "secret", Val.Non);
        let hv = take_or(mut a, 1, "hash", Val.Non);
        let scheme = take_or(mut a, 2, "scheme", Val.Non);
        let cat = take_cat(mut a, 3, "category");
        return ctx_verify(mut w, ci, secret, hv, scheme, cat, a.kw);
    }
    if name == "needs_update" {
        let hv = take_or(mut a, 0, "hash", Val.Non);
        let scheme = take_or(mut a, 1, "scheme", Val.Non);
        let cat = take_cat(mut a, 2, "category");
        return ctx_needs_update(mut w, ci, hv, scheme, cat);
    }
    if name == "verify_and_update" {
        let secret = take_or(mut a, 0, "secret", Val.Non);
        let hv = take_or(mut a, 1, "hash", Val.Non);
        let scheme = take_or(mut a, 2, "scheme", Val.Non);
        let cat = take_cat(mut a, 3, "category");
        return ctx_verify_and_update(mut w, ci, secret, hv, scheme, cat, a.kw);
    }
    if name == "to_string" {
        let section = str_val(take_or(mut a, 0, "section", sv("passlib")));
        return Ok(Val.Str(ctx_to_string(w, ci, section)));
    }
    if name == "to_dict" {
        let resolve = truthy(take_or(mut a, 0, "resolve", Val.Bool(false)));
        return Ok(ctx_to_dict(w, ci, resolve));
    }
    if name == "copy" or name == "using" {
        return Ok(Val.Ctx(ctx_copy(mut w, ci, a.kw)?));
    }
    if name == "update" {
        if a.pos.len() > 0 {
            if a.pos.len() > 1 {
                return Err(type_error("expected at most one positional argument".to_string()));
            }
            if kw_len(a.kw) > 0 {
                return Err(type_error("positional arg and keywords mutually exclusive".to_string()));
            }
            ctx_load(mut w, ci, a.pos[0], true, "passlib".to_string())?;
        } else if kw_len(a.kw) > 0 {
            ctx_load(mut w, ci, kw_to_dict(a.kw), true, "passlib".to_string())?;
        }
        return Ok(Val.Non);
    }
    if name == "load" {
        let source = take_or(mut a, 0, "source", Val.Non);
        let update = truthy(take_or(mut a, 1, "update", Val.Bool(false)));
        let section = str_val(take_or(mut a, 2, "section", sv("passlib")));
        ctx_load(mut w, ci, source, update, section)?;
        return Ok(Val.Non);
    }
    if name == "is_enabled" {
        let hv = take_or(mut a, 0, "hash", Val.Non);
        let cfg = w.ctxs[ci].clone();
        let rec = identify_record(mut w, cfg, hv, String.new(), true)?;
        return Ok(Val.Bool(not is_disabled(w, rec)));
    }
    if name == "disable" {
        let hv = take_or(mut a, 0, "hash", Val.Non);
        let rec = ctx_disabled_record(w, ci)?;
        return h_disable(mut w, rec, hv);
    }
    if name == "enable" {
        let hv = take_or(mut a, 0, "hash", Val.Non);
        let cfg = w.ctxs[ci].clone();
        let rec = identify_record(mut w, cfg, hv, String.new(), true)?;
        if is_disabled(w, rec) {
            return h_enable(mut w, rec, hv);
        }
        return Ok(hv);
    }
    Err(exc("AttributeError", f"'CryptContext' object has no attribute {str_repr(name)}"))
}

fn file_method(w: mut ref World, fi: i64, name: ref String, a0: ref CallArgs) -> Result[Val, Exc] {
    let mut a = a0.clone();
    let digest = w.files[fi].digest;
    if name == "to_string" {
        return Ok(Val.Bytes(file_bytes(w, fi)));
    }
    if name == "save" {
        let path = take_or(mut a, 0, "path", Val.Non);
        return file_save(mut w, fi, path);
    }
    if name == "load" {
        let path = take_or(mut a, 0, "path", Val.Non);
        return file_load(mut w, fi, path);
    }
    if not digest {
        if name == "users" {
            return Ok(file_users(w, fi));
        }
        if name == "check_password" {
            let user = take_or(mut a, 0, "user", Val.Non);
            let pw = take_or(mut a, 1, "password", Val.Non);
            return htpasswd_check(mut w, fi, user, pw);
        }
        if name == "get_hash" {
            let user = take_or(mut a, 0, "user", Val.Non);
            return ht_get_hash(w, fi, user, Val.Non);
        }
        if name == "set_hash" {
            let user = take_or(mut a, 0, "user", Val.Non);
            let hash = take_or(mut a, 1, "hash", Val.Non);
            return ht_set_hash(mut w, fi, user, Val.Non, hash);
        }
        if name == "set_password" {
            let user = take_or(mut a, 0, "user", Val.Non);
            let pw = take_or(mut a, 1, "password", Val.Non);
            let ci = w.files[fi].ctx;
            let hash = ctx_hash(mut w, ci, pw, Val.Non, String.new(), kw_new())?;
            return ht_set_hash(mut w, fi, user, Val.Non, hash);
        }
        if name == "delete" {
            let user = take_or(mut a, 0, "user", Val.Non);
            return ht_delete(mut w, fi, user, Val.Non);
        }
    } else {
        // set_password / check_password / set_hash take an optional realm
        // in the middle: with one fewer argument it shifts left.
        let shifted = a.pos.len() == 2 and kw_len(a.kw) == 0;
        if name == "realms" {
            return Ok(htdigest_realms(w, fi));
        }
        if name == "users" {
            let realm = take_or(mut a, 0, "realm", Val.Non);
            return htdigest_users(w, fi, realm);
        }
        if name == "check_password" or name == "set_password" or name == "set_hash" {
            let user = take_or(mut a, 0, "user", Val.Non);
            let last = if name == "set_hash" { "hash" } else { "password" };
            let (realm, third) = if shifted {
                (Val.Non, a.pos[1].clone())
            } else {
                (take_or(mut a, 1, "realm", Val.Non), take_or(mut a, 2, last, Val.Non))
            };
            if name == "check_password" {
                return htdigest_check(mut w, fi, user, realm, third);
            }
            if name == "set_hash" {
                return ht_set_hash(mut w, fi, user, realm, third);
            }
            let r = require_realm(w, fi, realm)?;
            let enc = Val.Str(w.files[fi].encoding.clone());
            let hash = htdigest_hash(third, user, r, enc)?;
            return ht_set_hash(mut w, fi, user, r, hash);
        }
        if name == "get_hash" {
            let user = take_or(mut a, 0, "user", Val.Non);
            let realm = take_or(mut a, 1, "realm", Val.Non);
            return ht_get_hash(w, fi, user, realm);
        }
        if name == "delete" {
            let user = take_or(mut a, 0, "user", Val.Non);
            let realm = take_or(mut a, 1, "realm", Val.Non);
            return ht_delete(mut w, fi, user, realm);
        }
        if name == "delete_realm" {
            let realm = take_or(mut a, 0, "realm", Val.Non);
            return htdigest_delete_realm(mut w, fi, realm);
        }
    }
    Err(exc("AttributeError", f"{str_repr(file_name(w.files[fi]))} object has no attribute {str_repr(name)}"))
}

// ------------------------------------------------------------ output

fn fmt_w(w: ref World, v: ref Val) -> String {
    match v {
        Val.Non => "None".to_string(),
        Val.Bool(b) => if b { "True".to_string() } else { "False".to_string() },
        Val.Int(n) => f"{n}",
        Val.Float(x) => float_repr(x),
        Val.Str(s) => str_repr(s),
        Val.Bytes(b) => bytes_repr(b),
        Val.Hd(ci) => f"<handler {w.cls[ci].name}>",
        Val.Ctx(_) => "<CryptContext>".to_string(),
        Val.File(fi) => f"<{file_name(w.files[fi])}>",
        Val.Fn(_) => "<built-in function>".to_string(),
        Val.Tuple(xs) => {
            if xs.len() == 1 {
                return f"({fmt_w(w, xs[0])},)";
            }
            f"({fmt_seq(w, xs)})"
        }
        Val.List(xs) => f"[{fmt_seq(w, xs)}]",
        Val.Dict(ks, vs) => {
            let mut parts: Vec[String] = Vec.new();
            let mut i = 0;
            while i < ks.len() {
                parts.push(f"{fmt_w(w, ks[i])}: {fmt_w(w, vs[i])}");
                i += 1;
            }
            brace(join_strs(parts, ", "))
        }
    }
}

fn brace(s: ref String) -> String {
    let mut out = "{".to_string();
    out.push_str(s);
    out.push_str("}");
    out
}

// repr() of a value that holds no handler, context or file.
fn fmt_val(v: ref Val) -> String {
    match v {
        Val.Non => "None".to_string(),
        Val.Bool(b) => if b { "True".to_string() } else { "False".to_string() },
        Val.Int(n) => f"{n}",
        Val.Float(x) => float_repr(x),
        Val.Str(s) => str_repr(s),
        Val.Bytes(b) => bytes_repr(b),
        Val.List(xs) => {
            let mut parts: Vec[String] = Vec.new();
            for x in xs {
                parts.push(fmt_val(x));
            }
            f"[{join_strs(parts, ", ")}]"
        }
        Val.Tuple(xs) => {
            let mut parts: Vec[String] = Vec.new();
            for x in xs {
                parts.push(fmt_val(x));
            }
            if parts.len() == 1 {
                return f"({parts[0]},)";
            }
            f"({join_strs(parts, ", ")})"
        }
        _ => "<object>".to_string(),
    }
}

fn fmt_seq(w: ref World, xs: ref Vec[Val]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for x in xs {
        parts.push(fmt_w(w, x));
    }
    join_strs(parts, ", ")
}

fn show(w: ref World, v: ref Val) {
    match v {
        Val.Str(s) => {
            for line in split_on(s, '\n') {
                if line.len() > 0 {
                    println(f"  {line}");
                } else {
                    println("  |");
                }
            }
        }
        other => println(f"  {fmt_w(w, other)}"),
    }
}

fn find_sub(s: ref String, pat: Str) -> i64 {
    let cs = chars(s);
    let ps = chars(pat.to_string());
    let mut i = 0;
    while i + ps.len() <= cs.len() {
        let mut j = 0;
        while j < ps.len() and cs[i + j] == ps[j] {
            j += 1;
        }
        if j == ps.len() {
            return i;
        }
        i += 1;
    }
    -1
}

fn is_identifier(s: ref String) -> bool {
    let cs = chars(s);
    if cs.len() == 0 {
        return false;
    }
    if not (is_alpha(cs[0]) or cs[0] == '_') {
        return false;
    }
    for c in cs {
        if not (is_alpha(c) or is_digit(c) or c == '_') {
            return false;
        }
    }
    true
}

fn eval_line(w: mut ref World, src: ref String) -> Result[Val, Exc] {
    let toks = tokenize(src)?;
    let mut p = P { toks: toks, pos: 0 };
    let v = ev_expr(mut w, mut p)?;
    match p.toks[p.pos].clone() {
        Tok.End => Ok(v),
        _ => Err(syntax_error("invalid syntax")),
    }
}

fn run_job(w: mut ref World, n: i64, line: ref String) {
    println(f"> {line}");
    w.rng = (1000 + n) & 0x7FFFFFFF;
    w.warns = Vec.new();
    let mut target = String.new();
    let mut expr = line.clone();
    let at = find_sub(line, " = ");
    if at >= 0 {
        let head = substr(line, 0, at);
        if is_identifier(head) {
            target = head;
            expr = substr(line, at + 3, clen(line));
        }
    }
    let res = eval_line(mut w, expr);
    for m in w.warns.clone() {
        println(f"  warning {m}");
    }
    match res {
        Err(e) => println(f"  error {e.cls}: {e.msg}"),
        Ok(v) => {
            if target.len() > 0 {
                ns_set(mut w, target, v);
            } else {
                show(w, v);
            }
        }
    }
}

// ------------------------------------------------------------ setup

fn world_new() -> World {
    World {
        cls: Vec.new(),
        nbase: 0,
        ctxs: Vec.new(),
        files: Vec.new(),
        names: Vec.new(),
        vals: Vec.new(),
        warns: Vec.new(),
        rng: 1,
        des: des_tables(),
        htctx: -1,
    }
}

fn world_init(w: mut ref World) -> Result[bool, Exc] {
    let mut k = 0;
    while k < K_COUNT {
        w.cls.push(mk_base(k));
        k += 1;
    }
    w.nbase = K_COUNT;
    mk_wrapper(mut w, "ldap_hex_md5", "hex_md5", "{MD5}", "", "");
    mk_wrapper(mut w, "ldap_hex_sha1", "hex_sha1", "{SHA}", "", "");
    mk_wrapper(mut w, "ldap_md5_crypt", "md5_crypt", "{CRYPT}", "", "");
    mk_wrapper(mut w, "ldap_des_crypt", "des_crypt", "{CRYPT}", "", "");
    mk_wrapper(mut w, "ldap_sha512_crypt", "sha512_crypt", "{CRYPT}", "", "");
    mk_wrapper(mut w, "ldap_pbkdf2_sha256", "pbkdf2_sha256", "{PBKDF2-SHA256}", "$pbkdf2-sha256$", "{PBKDF2-SHA256}");
    mk_wrapper(mut w, "bsd_nthash", "nthash", "$3$$", "", "$3$$");
    w.nbase = w.cls.len();
    // apache.py's htpasswd_context: CryptContext(schemes=..., default=..., bcrypt__ident="2y")
    let ks = str_list(strs("default bcrypt__ident schemes"));
    let schemes = str_list(strs("bcrypt sha256_crypt sha512_crypt apr_md5_crypt des_crypt ldap_sha1 plaintext"));
    let vs = [sv("apr_md5_crypt"), sv("2y"), Val.List(schemes)].to_vec();
    let ci = new_ctx(mut w);
    ctx_load(mut w, ci, Val.Dict(ks, vs), false, "passlib".to_string())?;
    w.htctx = ci;
    Ok(true)
}

fn write_inputs() -> Result[(), String] {
    for line in split_on(inputs_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, ' ');
        let path = f"data/{f[0]}";
        let _ = fs.create_dir_all(dirname_of(path));
        let bytes = if f.len() > 1 { hex_bytes(f[1]) } else { Vec.new() };
        if let Err(e) = fs.write_bytes(path, bytes) {
            return Err(f"cannot write {f[0]}: {e}");
        }
    }
    let _ = fs.remove_dir_all("data/out".to_string());
    if let Err(e) = fs.create_dir_all("data/out".to_string()) {
        return Err(f"cannot create data/out: {e}");
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_inputs() {
        eprintln(e);
        return;
    }
    let mut w = world_new();
    if let Err(e) = world_init(mut w) {
        eprintln(f"setup failed: {e.cls}: {e.msg}");
        return;
    }
    let mut n = 0;
    for line in split_on(jobs_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let job = hex_string(line);
        if job.starts_with("#") {
            println(job);
        } else {
            run_job(mut w, n, job);
        }
        n += 1;
    }
}

