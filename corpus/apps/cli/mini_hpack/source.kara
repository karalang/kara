    out.push_str("\u{9}public, max-age=31536000, immutable\u{a}h strict-transport-security\u{9}max-age=63072000; includeSubDomains; preload\u{a}h x-content-type-options\u{9}nosniff\u{a}h server\u{9}envoy\u{a}end\u{a}block 503 /favicon.ico\u{a}h :status\u{9}503\u{a}h date\u{9}Sat, 19 Oct 2024 09:41:11 GMT\u{a}h content-type\u{9}text/plain\u{a}h content-length\u{9}19\u{a}h cache-control\u{9}no-store\u{a}h retry-after\u{9}120\u{a}h strict-transport-security\u{9}max-age=63072000; includeSubDomains; preload\u{a}h ");
    out.push_str("x-content-type-options\u{9}nosniff\u{a}h server\u{9}envoy\u{a}end\u{a}story an API client with credentials\u{a}huffman on\u{a}block POST /v1/orders\u{a}h :method\u{9}POST\u{a}h :scheme\u{9}https\u{a}h :authority\u{9}api.example.org\u{a}h :path\u{9}/v1/orders\u{a}s authorization\u{9}Bearer demo-token-for-docs-only\u{a}h x-request-id\u{9}req-1000\u{a}h user-agent\u{9}orders-cli/2.3.1 python-httpx/0.27\u{a}h accept\u{9}application/json\u{a}h content-type\u{9}application/json\u{a}h content-length\u{9}88\u{a}s i");
    out.push_str("dempotency-key\u{9}a7c1-orders-0001\u{a}end\u{a}block GET /v1/orders/7731\u{a}h :method\u{9}GET\u{a}h :scheme\u{9}https\u{a}h :authority\u{9}api.example.org\u{a}h :path\u{9}/v1/orders/7731\u{a}s authorization\u{9}Bearer demo-token-for-docs-only\u{a}h x-request-id\u{9}req-1001\u{a}h user-agent\u{9}orders-cli/2.3.1 python-httpx/0.27\u{a}h accept\u{9}application/json\u{a}end\u{a}block GET /v1/orders/7731\u{a}h :method\u{9}GET\u{a}h :scheme\u{9}https\u{a}h :authority\u{9}api.example.org\u{a}h :path\u{9}/v1/orders/7");
    out.push_str("731\u{a}s authorization\u{9}Bearer demo-token-for-docs-only\u{a}h x-request-id\u{9}req-1002\u{a}h user-agent\u{9}orders-cli/2.3.1 python-httpx/0.27\u{a}h accept\u{9}application/json\u{a}end\u{a}block DELETE /v1/orders/7731/hold\u{a}h :method\u{9}DELETE\u{a}h :scheme\u{9}https\u{a}h :authority\u{9}api.example.org\u{a}h :path\u{9}/v1/orders/7731/hold\u{a}s authorization\u{9}Bearer demo-token-for-docs-only\u{a}h x-request-id\u{9}req-1003\u{a}h user-agent\u{9}orders-cli/2.3.1 python-httpx/0.27\u{a}h");
    out.push_str(" accept\u{9}application/json\u{a}end\u{a}block a sensitive header already in the table\u{a}h :method\u{9}GET\u{a}h :scheme\u{9}https\u{a}h :authority\u{9}api.example.org\u{a}h :path\u{9}/v1/whoami\u{a}s x-request-id\u{9}req-1003\u{a}s cookie\u{9}region=eu-west\u{a}h cookie\u{9}region=eu-west\u{a}end\u{a}story SETTINGS resize the table mid-connection\u{a}huffman off\u{a}block fill the table\u{a}h :method\u{9}GET\u{a}h :scheme\u{9}https\u{a}h :authority\u{9}cdn.example.com\u{a}h :path\u{9}/a.js\u{a}h x-cache-key\u{9}aaaa");
    out.push_str("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\u{a}h x-trace\u{9}t-0001-aaaa\u{a}end\u{a}encoder-table 128\u{a}decoder-table 128\u{a}block after shrinking to 128\u{a}h :method\u{9}GET\u{a}h :scheme\u{9}https\u{a}h :authority\u{9}cdn.example.com\u{a}h :path\u{9}/b.js\u{a}h x-trace\u{9}t-0001-aaaa\u{a}end\u{a}encoder-table 0\u{a}encoder-table 64\u{a}encoder-table 4096\u{a}block after 0, 64 and 4096 in one SETTINGS round\u{a}h :method\u{9}GET\u{a}h :scheme\u{9}https\u{a}h :authority\u{9}cdn.example.com\u{a}h :path\u{9}/c.js");
    out.push_str("\u{a}end\u{a}encoder-table 512\u{a}encoder-table 512\u{a}block a change to 512, then 512 again\u{a}h :method\u{9}GET\u{a}h :path\u{9}/d.js\u{a}end\u{a}encoder-table 1024\u{a}block then 1024\u{a}h :method\u{9}GET\u{a}h :path\u{9}/e.js\u{a}end\u{a}story big headers evict and clear the table\u{a}huffman on\u{a}encoder-table 1024\u{a}decoder-table 1024\u{a}block small headers\u{a}h :status\u{9}200\u{a}h x-a\u{9}1\u{a}h x-b\u{9}2\u{a}h x-c\u{9}3\u{a}end\u{a}block a 600-byte header evicts\u{a}h :status\u{9}200\u{a}h x-report\u{9}csp=000-001");
    out.push_str("-002-003-004-005-006-007-008-009-010-011-012-013-014-015-016-017-018-019-020-021-022-023-024-025-026-027-028-029-030-031-032-033-034-035-036-037-038-039-040-041-042-043-044-045-046-047-048-049-050-051-052-053-054-055-056-057-058-059-060-061-062-063-064-065-066-067-068-069-070-071-072-073-074-075-076-077-078-079-080-081-082-083-084-085-086-087-088-089-090-091-092-093-094-095-096-097-098-099-100-101");
    out.push_str("-102-103-104-105-106-107-108-109-110-111-112-113-114-115-116-117-118-119-120-121-122-123-124-125-126-127-128-129-130-131-132-133-134-135-136-137-138-139-140-141-142-143-144-145-146-147-148-149\u{a}end\u{a}block a header bigger than the table clears it\u{a}h :status\u{9}200\u{a}h set-cookie\u{9}prefs=zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz");
    out.push_str("");
    out.push_str("");
    out.push_str("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz\u{a}h x-a\u{9}1\u{a}end\u{a}story a dict of headers is reordered\u{a}huffman on\u{a}dict dict with :path last\u{a}h user-agent\u{9}Mozilla/5.0 (Macintosh; Intel Mac OS X 14_6) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.6 Safari/605.1.15\u{a}h accept");
    out.push_str("\u{9}*/*\u{a}h :method\u{9}GET\u{a}h x-debug\u{9}on\u{a}h :scheme\u{9}https\u{a}h :authority\u{9}status.example.com\u{a}h :path\u{9}/health\u{a}end\u{a}story non-ASCII values in Huffman\u{a}huffman on\u{a}block a download\u{a}h :status\u{9}200\u{a}h content-disposition\u{9}attachment; filename*=UTF-8''résumé.pdf\u{a}h x-display-name\u{9}Björk Guðmundsdóttir\u{a}h x-city\u{9}東京\u{a}h x-empty\u{9}\u{a}end\u{a}block the same again\u{a}h :status\u{9}200\u{a}h x-city\u{9}東京\u{a}h x-empty\u{9}\u{a}end\u{a}story a decoder that limits the hea");
    out.push_str("der list\u{a}huffman on\u{a}decoder-list-max 400\u{a}block a small request\u{a}h :method\u{9}GET\u{a}h :path\u{9}/\u{a}h x-n\u{9}1\u{a}end\u{a}block cookies over the limit\u{a}h :method\u{9}GET\u{a}h :path\u{9}/\u{a}h cookie\u{9}c0=vvvvvvvvvvvvvvvvvvvvvvvvvvvvvv\u{a}h cookie\u{9}c1=vvvvvvvvvvvvvvvvvvvvvvvvvvvvvv\u{a}h cookie\u{9}c2=vvvvvvvvvvvvvvvvvvvvvvvvvvvvvv\u{a}h cookie\u{9}c3=vvvvvvvvvvvvvvvvvvvvvvvvvvvvvv\u{a}h cookie\u{9}c4=vvvvvvvvvvvvvvvvvvvvvvvvvvvvvv\u{a}h cookie\u{9}c5=vvvvvvvvvvvvvvvvvvvvv");
    out.push_str("vvvvvvvvv\u{a}h cookie\u{9}c6=vvvvvvvvvvvvvvvvvvvvvvvvvvvvvv\u{a}h cookie\u{9}c7=vvvvvvvvvvvvvvvvvvvvvvvvvvvvvv\u{a}h cookie\u{9}c8=vvvvvvvvvvvvvvvvvvvvvvvvvvvvvv\u{a}h cookie\u{9}c9=vvvvvvvvvvvvvvvvvvvvvvvvvvvvvv\u{a}end\u{a}block never reached\u{a}h :method\u{9}GET\u{a}end\u{a}story a decoder whose SETTINGS the encoder ignores\u{a}huffman off\u{a}block first\u{a}h :method\u{9}GET\u{a}h :path\u{9}/\u{a}h x-trace\u{9}one\u{a}end\u{a}decoder-max 1024\u{a}block the encoder sent no size update\u{a}h :m");
    out.push_str("ethod\u{9}GET\u{a}h :path\u{9}/\u{a}end\u{a}story an encoder that grows past the decoder's limit\u{a}huffman off\u{a}encoder-table 8192\u{a}block first\u{a}h :method\u{9}GET\u{a}h :path\u{9}/\u{a}end\u{a}");
}

fn file_0() -> String {
    let mut out = String.new();
    file_0_0(mut out);
    out
}

fn file_1_0(out: mut ref String) {
    out.push_str("case RFC 7541 C.2.1 literal with indexing\u{a}hex 400a637573746f6d2d6b65790d637573746f6d2d686561646572\u{a}case RFC 7541 C.2.2 literal without indexing\u{a}hex 040c2f73616d706c652f70617468\u{a}case RFC 7541 C.2.3 literal never indexed\u{a}hex 100870617373776f726406736563726574\u{a}case RFC 7541 C.2.4 indexed\u{a}hex 82\u{a}case RFC 7541 C.3 requests\u{a}hex 828684410f7777772e6578616d706c652e636f6d\u{a}hex 828684be58086e6f2d6361636865\u{a}he");
    out.push_str("x 828785bf400a637573746f6d2d6b65790c637573746f6d2d76616c7565\u{a}case RFC 7541 C.4 requests with Huffman\u{a}hex 828684418cf1e3c2e5f23a6ba0ab90f4ff\u{a}hex 828684be5886a8eb10649cbf\u{a}hex 828785bf408825a849e95ba97d7f8925a849e95bb8e8b4bf\u{a}case RFC 7541 C.5 responses\u{a}decoder-table 256\u{a}hex 4803333032580770726976617465611d4d6f6e2c203231204f637420323031332032303a31333a323120474d546e1768747470733a2f2f7777772e6578616d70");
    out.push_str("6c652e636f6d\u{a}hex 4803333037c1c0bf\u{a}hex 88c1611d4d6f6e2c203231204f637420323031332032303a31333a323220474d54c05a04677a69707738666f6f3d4153444a4b48514b425a584f5157454f50495541585157454f49553b206d61782d6167653d333630303b2076657273696f6e3d31\u{a}case RFC 7541 C.6 responses with Huffman\u{a}decoder-table 256\u{a}hex 488264025885aec3771a4b6196d07abe941054d444a8200595040b8166e082a62d1bff6e919d29ad171863c78f0b97c8e9ae82");
    out.push_str("ae43d3\u{a}hex 4883640effc1c0bf\u{a}hex 88c16196d07abe941054d444a8200595040b8166e084a62d1bffc05a839bd9ab77ad94e7821dd7f2e6c7b335dfdfcd5b3960d5af27087f3672c1ab270fb5291f9587316065c003ed4ee5b1063d5007\u{a}case Apache Traffic Server response (hpack issue 110)\u{a}hex 10073a737461747573033230304006736572766572094154532f362e302e304004646174651d5475652c203331204d617220323031352030383a30393a353120474d54400c636f6e74656e7");
    out.push_str("");
    out.push_str("e6765730562797465734003616765013040197374726963742d7472616e73706f72742d73656375726974790d6d61782d6167653d383634303040037669613268747470732f312e31204154532028417061636865547261666669635365727665722f362e302e30205b6353734e66555d29\u{a}case raw bytes in a Huffman-free name\u{a}hex 400a000199301122552189140d637573746f6d2d686561646572\u{a}case an empty block\u{a}hex \u{a}case index 0\u{a}hex 80\u{a}case index 62 with an empty dyna");
    out.push_str("mic table\u{a}hex be\u{a}case an indexed name past the table\u{a}hex 8286847f0a0f7777772e6578616d706c652e636f6d\u{a}case a big index\u{a}hex ffffffffffffffff7f\u{a}case an integer cut short\u{a}hex ff\u{a}case an integer cut short inside a literal\u{a}hex 828640\u{a}case a name cut short\u{a}hex 4005616263\u{a}case a value cut short\u{a}hex 400161056162\u{a}case a value length cut short\u{a}hex 400161\u{a}case EOS inside a Huffman string\u{a}hex 4084fffffffc0161\u{a}c");
    out.push_str("ase padding longer than 7 bits\u{a}hex 40821fff0161\u{a}case padding with a zero bit\u{a}hex 4081000161\u{a}case an empty Huffman name and value\u{a}hex 408080\u{a}hex be\u{a}case never indexed with an indexed name\u{a}hex 140c2f73616d706c652f70617468\u{a}case literal without indexing, name index 58\u{a}hex 0f2b0a6375726c2f382e392e31\u{a}case table size updates at the start\u{a}hex 203fe11f82\u{a}hex 3f9a0a82\u{a}case a table size update after a header");
    out.push_str("\u{a}hex 823fe11f\u{a}case a table size update above the maximum\u{a}hex 3fe21f\u{a}case a table size update between two headers\u{a}hex 823fe11f86\u{a}case invalid UTF-8\u{a}hex 82868401107777772e07aad795d7a8d7942e636f6d\u{a}case table eviction with size 64\u{a}hex 3f21400361626303313233\u{a}hex be\u{a}hex 400364656603343536\u{a}hex bebf\u{a}case the header list limit\u{a}decoder-list-max 45\u{a}hex 82\u{a}hex 140c2f73616d706c652f70617468\u{a}case a lowered maxim");
    out.push_str("um the encoder did not follow\u{a}decoder-max 1024\u{a}hex 828684418cf1e3c2e5f23a6ba0ab90f4ff\u{a}hex 3fe10782\u{a}hex 82\u{a}case a raised table with the default maximum\u{a}decoder-table 8000\u{a}hex 82\u{a}hex 3fe11f82\u{a}");
}

fn file_1() -> String {
    let mut out = String.new();
    file_1_0(mut out);
    out
}

// (path under data/, contents)
fn data_files() -> Vec[(String, String)] {
    let mut v: Vec[(String, String)] = Vec.new();
    v.push(("stories.txt".to_string(), file_0()));
    v.push(("vectors.txt".to_string(), file_1()));
    v
}

