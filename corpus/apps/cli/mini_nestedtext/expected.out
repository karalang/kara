  {
    "service": "shop-api",
    "version": "2.14.0",
    "owner": "platform team",
    "note": "retries: 3, backoff: exponential",
    "hosts": [
      "api-1.internal.example",
      "api-2.internal.example",
      {
        "name": "api-canary.internal.example",
        "weight": "5"
      }
    ],
    "ports": [
      "80",
      "443",
      "8443"
    ],
    "limits": {
      "cpu": "500m",
      "memory": "1Gi",
      "burst": ""
    },
    "env": {
      "LOG_LEVEL": "info",
      "DATABASE_URL": "postgres://shop:not-a-real-password@db.internal.example/shop",
      "FEATURE_FLAGS": "{new_checkout: on, beta_banner: off}"
    },
    "motd": "Welcome to shop-api.\n\nMaintenance window: Sundays 02:00–04:00 UTC.",
    "health checks": {
      "GET /healthz\n(load balancer)": {
        "interval": "10s",
        "timeout": "2s"
      },
      "GET /ready": "{interval: 30s}"
    }
  }
