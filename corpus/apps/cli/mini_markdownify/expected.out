# Fragments.
-- frag | default | <p>Hello, <b>world</b>!</p>
   'Hello, **world**!'
-- frag | default | plain text with *stars* and _underscores_
   'plain text with \\*stars\\* and \\_underscores\\_'
-- frag | misc | 1. a⏎2) b⏎- c⏎-- d⏎# e⏎####### f⏎+ g⏎> h
   '1\\. a\n2\\) b\n\\- c\n\\-- d\n\\# e\n####### f\n\\+ g\n\\> h'
-- frag | misc | x-y a - b a -b- #x x# ## y ###### z 12345678901. 123456789.ok 7)
   'x-y a \\- b a -b- #x x# \\## y \\###### z 12345678901. 123456789.ok 7\\)'
-- frag | misc | [a](b) <c> `d` e=f g|h i~j k+l m&n o\p
   '\\[a\\](b)  \\`d\\` e\\=f g\\|h i\\~j k\\+l m\\&n o\\\\p'
-- frag | default | <a href="https://a.example/x_y">https://a.example/x_y</a>
   '<https://a.example/x_y>'
-- frag | links | <a href="https://a.example/">https://a.example/</a>
   '[https://a.example/](https://a.example/ "https://a.example/")'
-- frag | default | <a href="/p" title="T">text</a><a href="/q">  spaced  </a>
   '[text](/p "T") [spaced](/q) '
-- frag | default | <img src="a.png"><img alt="only alt"><img src="b.png" title='a "q"'>
   '![](a.png)![only alt]()![](b.png "a \\"q\\"")'
-- frag | default | <h3>  spaced   heading  </h3>
   '### spaced heading'
-- frag | atx | <h1>one</h1><h2>two</h2><h9>nine</h9>
   '# one\n\n## two\n\n###### nine'
-- frag | default | <ul><li></li><li>  </li><li>x</li></ul>
   '* x'
-- frag | default | <ol><li>a</li><li>b<ol><li>c</li></ol></li></ol>
   '1. a\n2. b\n   1. c'
-- frag | default | <ul><li>a</li></ul><p>after</p><ul><li>b</li></ul><ul><li>c</li></ul>
   '* a\n\nafter\n\n* b\n\n* c'
-- frag | default | <pre>⏎⏎  code⏎⏎</pre>
   '```\n  code\n```'
-- frag | keepdoc | <pre>⏎⏎  code⏎⏎</pre>
   '\n\n```\n\n\n  code\n\n\n```\n\n'
-- frag | lstrip | <pre>⏎⏎  code⏎⏎</pre>
   '```\n\n  code\n```\n\n'
-- frag | default | <pre></pre><pre> </pre>x
   '```\n\n```\n\nx'
-- frag | default | <code>``a`b```</code>
   '```` ``a`b``` ````'
-- frag | default | <b><i>bold italic</i></b> <i><b>x</b></i> <b>a<b>b</b></b>
   '***bold italic*** ***x*** **a**b****'
-- frag | default | <p>a<br>b<br><br>c</p>
   'a  \nb  \n  \nc'
-- frag | closed | <p>a<br>b</p><h1>x<br>y</h1>
   'a\\\nb\n\n# x y #'
-- frag | default | <blockquote>⏎line one⏎⏎line two⏎</blockquote>
   '> line one\n> line two'
-- frag | default | <dl><dt>term⏎one</dt><dd>first line<br>second line</dd></dl>
   'term one\n:   first line  \n    second line'
-- frag | default | <table><tr><td>a</td><td>b|c</td></tr></table>
   '|  |  |\n| --- | --- |\n| a | b|c |'
-- frag | tables | <table><tr><td>a</td></tr><tr><td>b</td></tr></table>
   '| a |\n| --- |\n| b |'
-- frag | default | <table><tr><th colspan="3">wide</th></tr><tr><td>1</td><td>2</td><td>3</td></tr></table>
   '| wide | | |\n| --- | --- | --- |\n| 1 | 2 | 3 |'
-- frag | default | text<!-- comment -->more
   'textmore'
-- frag | default | <p>&lt;script&gt; &amp;amp; &quot;q&quot; &apos;a&apos; &#x26;</p>
   '<script> &amp; "q" \'a\' &'
-- frag | default | <div>   </div><p>   </p>⏎⏎<span>  </span>
   ' '
-- frag | wrap40 | <p>The quick brown fox jumps over the lazy dog and keeps running far beyond the horizon.<br>Next line after a break that is also rather long indeed.</p>
   'The quick brown fox jumps over the lazy\ndog and keeps running far beyond the\nhorizon.  \nNext line after a break that is also\nrather long indeed.'
-- frag | wrap20 | <p>supercalifragilisticexpialidocious word-with-hyphens-that-is-long ok</p>
   'supercalifragilisticexpialidocious\nword-with-hyphens-that-is-long\nok'
-- frag | default | <q>nested <q>quotes</q></q>
   '"nested "quotes""'
-- frag | strip | <p><a href="x">link</a> and <img src="y" alt="img"></p>
   'link and'
-- frag | convert | <p><a href="x">link</a> and <b>bold</b> <i>italic</i></p>
   '\n\nlink and **bold** italic\n\n'
-- frag | default | ∅
   ''
-- frag | default | ␣␣␣
   ' '
-- frag | default | ⏎⏎
   ''
