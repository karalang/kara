fn file_5_0(s: mut ref String) {
    s.push_str("<div id=\"mw-content-text\"><p><b>Paxos</b> is a family of protocols for solving\n");
    s.push_str("<a href=\"/wiki/Consensus_(computer_science)\" title=\"Consensus (computer science)\">consensus</a>\n");
    s.push_str("in a network of unreliable processors.<sup id=\"cite_ref-1\" class=\"reference\"><a href=\"#cite_note-1\">[1]</a></sup>\n");
    s.push_str("It was first submitted in 1989.<sup class=\"reference\"><a href=\"#cite_note-2\">[2]</a></sup></p>\n");
    s.push_str("<div class=\"toc\"><h2>Contents</h2><ul><li><a href=\"#History\"><span>1</span> <span>History</span></a></li>\n");
    s.push_str("<li><a href=\"#Basic_Paxos\"><span>2</span> <span>Basic Paxos</span></a><ul><li><a href=\"#Phase_1\"><span>2.1</span> Phase 1</a></li></ul></li></ul></div>\n");
    s.push_str("<h2><span class=\"mw-headline\" id=\"History\">History</span></h2>\n");
    s.push_str("<p>The topic predates the protocol. In 1988, Lynch, Dwork and Stockmeyer had demonstrated\n");
    s.push_str("the solvability of consensus in a broad family of &quot;partially synchronous&quot; systems.</p>\n");
    s.push_str("<h2><span class=\"mw-headline\" id=\"Basic_Paxos\">Basic Paxos</span></h2>\n");
    s.push_str("<h3>Phase 1</h3>\n");
    s.push_str("<dl><dt>Prepare</dt><dd>A <i>Proposer</i> creates a message, which we call a \"Prepare\", identified with a number <i>n</i>.</dd>\n");
    s.push_str("<dt>Promise</dt><dd>An <i>Acceptor</i> waits for a <i>Prepare</i> message.</dd></dl>\n");
    s.push_str("<ol class=\"references\"><li id=\"cite_note-1\"><b><a href=\"#cite_ref-1\">^</a></b> Lamport, Leslie (1998).</li>\n");
    s.push_str("<li id=\"cite_note-2\"><b><a href=\"#cite_ref-2\">^</a></b> Lamport, Leslie (2001). <i>Paxos Made Simple</i>.</li></ol>\n");
    s.push_str("</div>\n");
}

