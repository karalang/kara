fn file_0_0(s: mut ref String) {
    s.push_str("<!DOCTYPE html>\n");
    s.push_str("<html lang=\"en\">\n");
    s.push_str("<head>\n");
    s.push_str("  <meta charset=\"utf-8\">\n");
    s.push_str("  <title>Zero-downtime Postgres migrations</title>\n");
    s.push_str("  <style>body { font-family: sans-serif; } .note { color: #555; }</style>\n");
    s.push_str("  <script>window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);}</script>\n");
    s.push_str("</head>\n");
    s.push_str("<body>\n");
    s.push_str("<!-- generated by the blog engine; do not edit -->\n");
    s.push_str("<article>\n");
    s.push_str("  <h1>Zero-downtime Postgres migrations</h1>\n");
    s.push_str("  <p class=\"byline\">By <a href=\"/authors/ana\">Ana Ruiz</a> &middot; March 3, 2024 &middot; 8&nbsp;min read</p>\n");
    s.push_str("  <p>Every team that runs <strong>Postgres</strong> in production eventually needs to change a\n");
    s.push_str("     table that is <em>too big to lock</em>. This post walks through the pattern we use at\n");
    s.push_str("     <a href=\"https://example.com\" title=\"Example Inc.\">Example</a>, step by step.</p>\n");
    s.push_str("  <h2 id=\"why\">Why <code>ALTER TABLE</code> hurts</h2>\n");
    s.push_str("  <p>Most <code>ALTER TABLE</code> forms take an <b>ACCESS EXCLUSIVE</b> lock. While it is held,\n");
    s.push_str("  even a plain <code>SELECT</code> waits &mdash; and so does every query queued behind it.</p>\n");
    s.push_str("  <blockquote>\n");
    s.push_str("    <p>A migration is only as safe as its slowest lock.</p>\n");
    s.push_str("    <p>&mdash; someone on call at 3&nbsp;a.m.</p>\n");
    s.push_str("  </blockquote>\n");
    s.push_str("  <h2 id=\"steps\">The steps</h2>\n");
    s.push_str("  <ol>\n");
    s.push_str("    <li>Add the new column as <code>NULL</code>able, with no default.</li>\n");
    s.push_str("    <li>Backfill in batches:\n");
    s.push_str("      <pre><code class=\"language-sql\">UPDATE orders\n");
    s.push_str("SET    total_cents = total * 100\n");
    s.push_str("WHERE  id BETWEEN $1 AND $2;\n");
    s.push_str("</code></pre>\n");
    s.push_str("    </li>\n");
    s.push_str("    <li>Add the constraint as <code>NOT VALID</code>, then validate it:\n");
    s.push_str("      <ul>\n");
    s.push_str("        <li><code>ALTER TABLE orders ADD CONSTRAINT &hellip; NOT VALID;</code></li>\n");
    s.push_str("        <li><code>ALTER TABLE orders VALIDATE CONSTRAINT &hellip;;</code></li>\n");
    s.push_str("      </ul>\n");
    s.push_str("    </li>\n");
    s.push_str("    <li>Switch reads, then writes, behind a <a href=\"/flags\">feature flag</a>.</li>\n");
    s.push_str("  </ol>\n");
    s.push_str("  <h3>What about <em>indexes</em>?</h3>\n");
    s.push_str("  <p>Use <code>CREATE INDEX CONCURRENTLY</code>. It cannot run inside a transaction, so most\n");
    s.push_str("  migration tools need a flag for it; ours is <code>disable_ddl_transaction!</code>.<br>\n");
    s.push_str("  Watch <code>pg_stat_progress_create_index</code> while it runs.</p>\n");
    s.push_str("  <p><img src=\"/img/lock-queue.png\" alt=\"A queue of blocked queries\" title=\"Lock queue\"></p>\n");
    s.push_str("  <hr>\n");
    s.push_str("  <p class=\"note\">Tags: <a href=\"/t/postgres\">postgres</a>, <a href=\"/t/migrations\">migrations</a>.\n");
    s.push_str("  Questions? Mail <a href=\"mailto:blog@example.com\">blog@example.com</a> or see\n");
    s.push_str("  <a href=\"https://example.com/faq\">https://example.com/faq</a>.</p>\n");
    s.push_str("</article>\n");
    s.push_str("</body>\n");
    s.push_str("</html>\n");
}

fn file_0() -> String {
    let mut s = String.new();
    file_0_0(mut s);
    s
}

fn file_1_0(s: mut ref String) {
    s.push_str("<html><body>\n");
    s.push_str("<h1>kvctl reference</h1>\n");
    s.push_str("<p>Version 2.4. See also: <a href=\"kvd.html\">kvd(8)</a>.</p>\n");
    s.push_str("<h2>Options</h2>\n");
    s.push_str("<dl>\n");
    s.push_str("  <dt><code>--endpoint</code> <var>URL</var></dt>\n");
    s.push_str("  <dd>The server to talk to. Defaults to <code>http://127.0.0.1:2379</code>.</dd>\n");
    s.push_str("  <dt><code>--timeout</code></dt>\n");
    s.push_str("  <dd><p>How long to wait for a reply.</p>\n");
    s.push_str("      <p>Accepts units: <samp>500ms</samp>, <samp>2s</samp>, <samp>1m</samp>.</p></dd>\n");
    s.push_str("  <dt>--dry-run</dt>\n");
    s.push_str("  <dd></dd>\n");
    s.push_str("</dl>\n");
    s.push_str("<h2>Exit codes</h2>\n");
    s.push_str("<table>\n");
    s.push_str("  <caption>Exit codes of kvctl</caption>\n");
    s.push_str("  <thead>\n");
    s.push_str("    <tr><th>Code</th><th>Meaning</th></tr>\n");
    s.push_str("  </thead>\n");
    s.push_str("  <tbody>\n");
    s.push_str("    <tr><td>0</td><td>Success</td></tr>\n");
    s.push_str("    <tr><td>1</td><td>Usage error; see\n");
    s.push_str("       <kbd>kvctl --help</kbd></td></tr>\n");
    s.push_str("    <tr><td>69</td><td>Server <del>down</del> <ins>unavailable</ins></td></tr>\n");
    s.push_str("  </tbody>\n");
    s.push_str("</table>\n");
    s.push_str("<h2>Limits</h2>\n");
    s.push_str("<table>\n");
    s.push_str("  <tr><td>Key size</td><td>1 KiB</td></tr>\n");
    s.push_str("  <tr><td colspan=\"2\">Values over 1 MiB are rejected with E<sub>2</sub>BIG.</td></tr>\n");
    s.push_str("  <tr><td colspan=\"x\">bad colspan</td><td colspan=\"0\">zero</td></tr>\n");
    s.push_str("</table>\n");
    s.push_str("<h2>Keyboard</h2>\n");
    s.push_str("<p>Press <kbd>Ctrl</kbd>+<kbd>C</kbd> to cancel; x<sup>2</sup> means squared;\n");
    s.push_str("H<sub>2</sub>O is water. <q>Quoted</q> text, <s>struck</s> text.</p>\n");
    s.push_str("<figure>\n");
    s.push_str("  <img src=\"arch.svg\" alt=\"Architecture\">\n");
    s.push_str("  <figcaption>Figure 1: <b>request flow</b></figcaption>\n");
    s.push_str("</figure>\n");
    s.push_str("<p>Demo: <video src=\"demo.mp4\" poster=\"demo.jpg\">the demo video</video>\n");
