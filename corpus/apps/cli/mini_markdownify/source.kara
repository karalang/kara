// mini_markdownify: markdownify 1.2.3, the HTML-to-Markdown converter
// that documentation pipelines, scrapers and LLM ingestion tools run
// pages through, on the parse tree Beautiful Soup 4.15 builds with
// html.parser. The converter covers headings in three styles, emphasis
// and strong with either symbol, links and autolinks with titles,
// images and videos, code spans with backtick fences, preformatted
// blocks, block quotes, ordered and nested lists with configurable
// bullets, definition lists, tables with header inference and colspan,
// line breaks in two styles, sub/sup symbols, Markdown escaping (with
// the escape_misc regexes), paragraph wrapping through textwrap,
// strip/convert tag lists, and its whitespace rules around blocks.
//
// The tree is bs4's: BeautifulSoupHTMLParser's handlers over mini_htmlparser's
// port of html.parser (with convert_charrefs off), bs4's own numeric and
// named character references, empty-element tags, whitespace-only
// strings folded to " " or "\n" outside <pre> and <textarea>, and
// _popToTag for end tags. The regexes run on mini_re's engine and wrapping
// on mini_textwrap's TextWrapper. expected.out is the output of oracle.py,
// which runs the same jobs through markdownify itself.

// ------------------------------------------------------------ errors

struct ReErr {
    kind: String,
    msg: String,
    pos: i64,
}

fn re_error(msg: own String, pos: i64) -> ReErr {
    ReErr { kind: "error".to_string(), msg: msg, pos: pos }
}

fn other_error(kind: Str, msg: own String) -> ReErr {
    ReErr { kind: kind.to_string(), msg: msg, pos: -1 }
}

fn err_text(e: ref ReErr) -> String {
    if e.kind == "error" {
        if e.pos >= 0 {
            return f"error: {e.msg} at position {e.pos}";
        }
        return f"error: {e.msg}";
    }
    f"{e.kind}: {e.msg}"
}

// -------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for cp in s {
        if cp < 0x80 {
            out.push(cp as u8);
        } else if cp < 0x800 {
            out.push((0xC0 | (cp >> 6)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else if cp < 0x10000 {
            out.push((0xE0 | (cp >> 12)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (cp >> 18)) as u8);
            out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

fn str_repr(s: ref Vec[i64], out: mut ref Vec[i64]) {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
}

fn repr_of(s: ref Vec[i64]) -> String {
    let mut out: Vec[i64] = Vec.new();
    str_repr(s, mut out);
    to_string(out)
}

// ----------------------------------------------------- character kinds

fn is_decimal(c: i64) -> bool {
    if c < 0x80 {
        return c >= 48 and c <= 57;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return true;
        }
    }
    false
}

fn is_space(c: i64, ascii: bool) -> bool {
    if c == 32 or (c >= 9 and c <= 13) {
        return true;
    }
    if ascii {
        return false;
    }
    (c >= 0x1C and c <= 0x1F) or c == 0x85 or c == 0xA0 or c == 0x1680 or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F or c == 0x3000
}

fn as_char(c: i64) -> Option[char] {
    if c < 0 or (c >= 0xD800 and c <= 0xDFFF) or c > 0x10FFFF {
        return None;
    }
    char.try_from(c as u32).ok()
}

fn is_word(c: i64, ascii: bool) -> bool {
    if c < 0x80 {
        return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
    }
    if ascii {
        return false;
    }
    match as_char(c) {
        Some(ch) => ch.is_alphanumeric(),
        None => false,
    }
}

fn lower(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 65 and c <= 90 { c + 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_lowercase() as u32 as i64,
        None => c,
    }
}

fn upper(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 97 and c <= 122 { c - 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_uppercase() as u32 as i64,
        None => c,
    }
}

// ------------------------------------------------------- parsed form

// The categories of \d \D \s \S \w \W.
fn cat_digit() -> i64 { 0 }
fn cat_not_digit() -> i64 { 1 }
fn cat_space() -> i64 { 2 }
fn cat_not_space() -> i64 { 3 }
fn cat_word() -> i64 { 4 }
fn cat_not_word() -> i64 { 5 }

// The positions ^ $ \A \Z \b \B and the forms the compiler turns them
// into under MULTILINE.
fn at_beginning() -> i64 { 0 }
fn at_beginning_line() -> i64 { 1 }
fn at_beginning_string() -> i64 { 2 }
fn at_end() -> i64 { 3 }
fn at_end_line() -> i64 { 4 }
fn at_end_string() -> i64 { 5 }
fn at_boundary() -> i64 { 6 }
fn at_non_boundary() -> i64 { 7 }

#[derive(Clone)]
enum Item {
    Lit(i64),
    Range(i64, i64),
    Cat(i64),
}

enum Node {
    Lit(i64),
    NotLit(i64),
    Any,
    In(Vec[Item], bool),
    At(i64),
    Branch(Vec[Vec[Node]]),
    // group (0: none), flags turned on, flags turned off, contents
    Group(i64, i64, i64, Vec[Node]),
    // 0 greedy, 1 lazy, 2 possessive; min; max; the item repeated
    Repeat(i64, i64, i64, Vec[Node]),
    Atomic(Vec[Node]),
    // direction (1 ahead, -1 behind), negative, contents
    Assert(i64, bool, Vec[Node]),
    GroupRef(i64),
    // group, yes branch, no branch
    Exists(i64, Vec[Node], Vec[Node]),
    Failure,
}

fn is_repeat(n: ref Node) -> bool {
    match n {
        Node.Repeat(_, _, _, _) => true,
        _ => false,
    }
}

fn is_at(n: ref Node) -> bool {
    match n {
        Node.At(_) => true,
        _ => false,
    }
}

fn flag_i() -> i64 { 2 }
fn flag_l() -> i64 { 4 }
fn flag_m() -> i64 { 8 }
fn flag_s() -> i64 { 16 }
fn flag_u() -> i64 { 32 }
fn flag_x() -> i64 { 64 }
fn flag_a() -> i64 { 256 }
fn type_flags() -> i64 { 4 | 32 | 256 }
fn maxrepeat() -> i64 { 4294967295 }
fn maxgroups() -> i64 { 1073741823 }
fn maxwidth() -> i64 { 1 << 62 }

fn flag_value(c: i64) -> i64 {
    match c {
        105 => 2,
        76 => 4,
        109 => 8,
        115 => 16,
        120 => 64,
        97 => 256,
        117 => 32,
        _ => 0,
    }
}

// ------------------------------------------------------------ tokens

// One token: nothing at the end of the pattern (n 0), a character (n 1),
// or a backslash and the character after it (n 2).
#[derive(Copy, Clone)]
struct T {
    n: i64,
    a: i64,
    b: i64,
}

fn tok_none() -> T {
    T { n: 0, a: 0, b: 0 }
}

fn tok_is(t: T, c: i64) -> bool {
    t.n == 1 and t.a == c
}

fn tok_text(t: T) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    if t.n >= 1 {
        v.push(t.a);
    }
    if t.n == 2 {
        v.push(t.b);
    }
    v
}

fn is_ascii_letter(c: i64) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

fn is_hex(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

fn is_oct(c: i64) -> bool {
    c >= 48 and c <= 55
}

fn is_dec(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn digits_value(s: ref Vec[i64], start: i64, base: i64) -> i64 {
    let mut v = 0;
    let mut i = start;
    while i < s.len() {
        let c = s[i];
        let d = if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 };
        v = v * base + d;
        i += 1;
    }
    v
}

// str.isidentifier, near enough: a letter or underscore, then letters,
// digits and underscores.
fn is_identifier(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    let mut i = 0;
    while i < name.len() {
        let c = name[i];
        let ok = if c == 95 {
            true
        } else if i == 0 {
            match as_char(c) {
                Some(ch) => ch.is_alphabetic(),
                None => false,
            }
        } else {
            is_word(c, false)
        };
        if not ok {
            return false;
        }
        i += 1;
    }
    true
}

fn is_ascii_decimal(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    for c in name {
        if not is_dec(c) {
            return false;
        }
    }
    true
}

struct Tokenizer {
    s: Vec[i64],
    index: i64,
    next: T,
}

impl Tokenizer {
    fn advance(mut ref self) -> Result[(), ReErr] {
        let index = self.index;
        if index >= self.s.len() {
            self.next = tok_none();
            return Ok(());
        }
        let c = self.s[index];
        if c == 92 {
            if index + 1 >= self.s.len() {
                return Err(re_error("bad escape (end of pattern)".to_string(), self.s.len() - 1));
            }
            self.next = T { n: 2, a: 92, b: self.s[index + 1] };
            self.index = index + 2;
        } else {
            self.next = T { n: 1, a: c, b: 0 };
            self.index = index + 1;
        }
        Ok(())
    }

    fn get(mut ref self) -> Result[T, ReErr] {
        let t = self.next;
        self.advance()?;
        Ok(t)
    }

    fn take(mut ref self, c: i64) -> Result[bool, ReErr] {
        if tok_is(self.next, c) {
            self.advance()?;
            return Ok(true);
        }
        Ok(false)
    }

    fn tell(ref self) -> i64 {
        self.index - self.next.n
    }

    fn seek(mut ref self, index: i64) -> Result[(), ReErr] {
        self.index = index;
        self.advance()
    }

    fn error(ref self, msg: own String, offset: i64) -> ReErr {
        re_error(msg, self.tell() - offset)
    }

    // getwhile: up to n characters of a kind (0 octal, 1 decimal, 2 hex).
    fn getwhile(mut ref self, n: i64, kind: i64, out: mut ref Vec[i64]) -> Result[(), ReErr] {
        let mut k = 0;
        while k < n {
            let t = self.next;
            if t.n != 1 {
                break;
            }
            let ok = if kind == 0 { is_oct(t.a) } else if kind == 1 { is_dec(t.a) } else { is_hex(t.a) };
            if not ok {
                break;
            }
            out.push(t.a);
            self.advance()?;
            k += 1;
        }
        Ok(())
    }

    fn getuntil(mut ref self, terminator: i64, name: Str) -> Result[Vec[i64], ReErr] {
        let mut result: Vec[i64] = Vec.new();
        loop {
            let c = self.next;
            self.advance()?;
            if c.n == 0 {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 0));
                }
                let term = to_string(vec_of(terminator));
                return Err(self.error(f"missing {term}, unterminated name", result.len()));
            }
            if tok_is(c, terminator) {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 1));
                }
                break;
            }
            push_all(mut result, tok_text(c));
        }
        Ok(result)
    }

    fn checkgroupname(ref self, name: ref Vec[i64], offset: i64) -> Result[(), ReErr] {
        if not is_identifier(name) {
            return Err(self.error(f"bad character in group name {repr_of(name)}", name.len() + offset));
        }
        Ok(())
    }
}

fn vec_of(c: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(c);
    v
}

fn new_tokenizer(s: ref Vec[i64]) -> Result[Tokenizer, ReErr] {
    let mut t = Tokenizer { s: s.clone(), index: 0, next: tok_none() };
    t.advance()?;
    Ok(t)
}

// ------------------------------------------------------------ parser

#[derive(Clone)]
struct Width {
    lo: i64,
    hi: i64,
}

struct ParseState {
    flags: i64,
    names: Vec[(Vec[i64], i64)],
    // per group: whether it is closed, and its width
    closed: Vec[bool],
    widths: Vec[Width],
    lookbehind_groups: i64,
    // conditional references by number, in order: (group, position)
    refpos: Vec[(i64, i64)],
}

impl ParseState {
    fn groups(ref self) -> i64 {
        self.closed.len()
    }

    fn group_of(ref self, name: ref Vec[i64]) -> i64 {
        for (n, g) in self.names.iter() {
            if same(n, name) {
                return g;
            }
        }
        -1
    }

    fn checkgroup(ref self, gid: i64) -> bool {
        gid < self.groups() and self.closed[gid]
    }

    fn checklookbehindgroup(ref self, gid: i64, src: ref Tokenizer) -> Result[(), ReErr] {
        if self.lookbehind_groups >= 0 {
            if not self.checkgroup(gid) {
                return Err(src.error("cannot refer to an open group".to_string(), 0));
            }
            if gid >= self.lookbehind_groups {
                return Err(src.error("cannot refer to group defined in the same lookbehind subpattern".to_string(), 0));
            }
        }
        Ok(())
    }
}

fn add_width(a: i64, b: i64) -> i64 {
    if a >= maxwidth() - b { maxwidth() } else { a + b }
}

fn mul_width(a: i64, n: i64) -> i64 {
    if a == 0 or n == 0 {
        0
    } else if a >= maxwidth() / n {
        maxwidth()
    } else {
        a * n
    }
}

// SubPattern.getwidth.
fn width_of(widths: ref Vec[Width], p: ref Vec[Node]) -> Width {
    let mut lo = 0;
    let mut hi = 0;
    for n in p.iter() {
        match n {
            Node.Branch(items) => {
                let mut i = maxwidth();
                let mut j = 0;
                for item in items.iter() {
                    let w = width_of(widths, item);
                    if w.lo < i {
                        i = w.lo;
                    }
                    if w.hi > j {
                        j = w.hi;
                    }
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Atomic(body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Group(_, _, _, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Repeat(_, min, max, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, mul_width(w.lo, min));
                if max == maxrepeat() and w.hi > 0 {
                    hi = maxwidth();
                } else {
                    hi = add_width(hi, mul_width(w.hi, max));
                }
            }
            Node.GroupRef(g) => {
                let w = ref widths[g];
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Exists(_, yes, no) => {
                let wy = width_of(widths, yes);
                let mut i = wy.lo;
                let mut j = wy.hi;
                if no.len() > 0 {
                    let wn = width_of(widths, no);
                    if wn.lo < i {
                        i = wn.lo;
                    }
                    if wn.hi > j {
                        j = wn.hi;
                    }
                } else {
                    i = 0;
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Lit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.NotLit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.Any => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.In(_, _) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            _ => {}
        }
    }
    Width { lo: lo, hi: hi }
}

fn category_of(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        100 => 0,
        68 => 1,
        115 => 2,
        83 => 3,
        119 => 4,
        87 => 5,
        _ => -1,
    }
}

fn escape_value(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        97 => 7,
        98 => 8,
        102 => 12,
        110 => 10,
        114 => 13,
        116 => 9,
        118 => 11,
        92 => 92,
        _ => -1,
    }
}

// \x, \u and \U: the escape text so far, and the code point.
fn hex_escape(src: mut ref Tokenizer, t: T, esc: mut ref Vec[i64]) -> Result[i64, ReErr] {
    let n = if t.b == 120 { 2 } else if t.b == 117 { 4 } else { 8 };
    src.getwhile(n, 2, mut esc)?;
    if esc.len() != n + 2 {
        return Err(src.error(f"incomplete escape {to_string(esc)}", esc.len()));
    }
    let c = digits_value(esc, 2, 16);
    if c > 0x10FFFF {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(c)
}

// _class_escape: an escape inside [...], a literal or a category.
fn class_escape(src: mut ref Tokenizer, t: T) -> Result[Item, ReErr] {
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Item.Lit(e));
    }
    let cat = category_of(t);
    if cat >= 0 {
        return Ok(Item.Cat(cat));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Item.Lit(v));
    }
    if is_oct(c) {
        src.getwhile(2, 0, mut esc)?;
        let v = digits_value(esc, 1, 8);
        if v > 0o377 {
            return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
        }
        return Ok(Item.Lit(v));
    }
    if is_dec(c) or is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Item.Lit(c))
}

// _escape: an escape outside a set.
fn escape(src: mut ref Tokenizer, t: T, st: ref ParseState) -> Result[Node, ReErr] {
    let cat = category_of(t);
    if cat >= 0 {
        let mut items: Vec[Item] = Vec.new();
        items.push(Item.Cat(cat));
        return Ok(Node.In(items, false));
    }
    match t.b {
        65 => return Ok(Node.At(at_beginning_string())),
        98 => return Ok(Node.At(at_boundary())),
        66 => return Ok(Node.At(at_non_boundary())),
        90 => return Ok(Node.At(at_end_string())),
        _ => {}
    }
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Node.Lit(e));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Node.Lit(v));
    }
    if c == 48 {
        src.getwhile(2, 0, mut esc)?;
        return Ok(Node.Lit(digits_value(esc, 1, 8)));
    }
    if is_dec(c) {
        // an octal escape or a group reference
        let nt = src.next;
        if nt.n == 1 and is_dec(nt.a) {
            esc.push(nt.a);
            src.advance()?;
            let nt2 = src.next;
            if is_oct(esc[1]) and is_oct(esc[2]) and nt2.n == 1 and is_oct(nt2.a) {
                esc.push(nt2.a);
                src.advance()?;
                let v = digits_value(esc, 1, 8);
                if v > 0o377 {
                    return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
                }
                return Ok(Node.Lit(v));
            }
        }
        let group = digits_value(esc, 1, 10);
        if group < st.groups() {
            if not st.checkgroup(group) {
                return Err(src.error("cannot refer to an open group".to_string(), esc.len()));
            }
            st.checklookbehindgroup(group, src)?;
            return Ok(Node.GroupRef(group));
        }
        return Err(src.error(f"invalid group reference {group}", esc.len() - 1));
    }
    if is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Node.Lit(c))
}

fn parse_sub(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64) -> Result[Vec[Node], ReErr] {
    let mut items: Vec[Vec[Node]] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let first = nested == 0 and items.len() == 0;
        let item = parse_seq(mut src, mut st, verbose, nested + 1, first)?;
        items.push(item);
        if not src.take(124)? {
            break;
        }
        if nested == 0 {
            verbose = (st.flags & flag_x()) != 0;
        }
    }
    if items.len() == 1 {
        return Ok(items.pop().unwrap());
    }
    let mut out: Vec[Node] = Vec.new();
    out.push(Node.Branch(items));
    Ok(out)
}

// _parse_flags: None (as Err-free Ok(None)) for global flags, else the
// flags turned on and off.
fn parse_flags(src: mut ref Tokenizer, st: mut ref ParseState, first_char: T) -> Result[Option[(i64, i64)], ReErr] {
    let mut ch = first_char;
    let mut add = 0;
    let mut del = 0;
    if not tok_is(ch, 45) {
        loop {
            let flag = flag_value(ch.a);
            if ch.a == 76 {
                return Err(src.error("bad inline flags: cannot use 'L' flag with a str pattern".to_string(), 0));
            }
            add = add | flag;
            if (flag & type_flags()) != 0 and (add & type_flags()) != flag {
                return Err(src.error("bad inline flags: flags 'a', 'u' and 'L' are incompatible".to_string(), 0));
            }
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing -, : or )".to_string(), 0));
            }
            if tok_is(ch, 41) or tok_is(ch, 45) or tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing -, : or )" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if tok_is(ch, 41) {
        st.flags = st.flags | add;
        return Ok(None);
    }
    if tok_is(ch, 45) {
        ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("missing flag".to_string(), 0));
        }
        if ch.n != 1 or flag_value(ch.a) == 0 {
            let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing flag" };
            return Err(src.error(msg.to_string(), ch.n));
        }
        loop {
            let flag = flag_value(ch.a);
            if (flag & type_flags()) != 0 {
                return Err(src.error("bad inline flags: cannot turn off flags 'a', 'u' and 'L'".to_string(), 0));
            }
            del = del | flag;
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing :".to_string(), 0));
            }
            if tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing :" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if (add & del) != 0 {
        return Err(src.error("bad inline flags: flag turned on and off".to_string(), 1));
    }
    Ok(Some((add, del)))
}

fn is_alpha(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

fn parse_set(src: mut ref Tokenizer, out: mut ref Vec[Node]) -> Result[(), ReErr] {
    let here = src.tell() - 1;
    let mut set: Vec[Item] = Vec.new();
    let negate = src.take(94)?;
    loop {
        let this = src.get()?;
        if this.n == 0 {
            return Err(src.error("unterminated character set".to_string(), src.tell() - here));
        }
        if tok_is(this, 93) and set.len() > 0 {
            break;
        }
        let code1 = if this.n == 2 { class_escape(mut src, this)? } else { Item.Lit(this.a) };
        if src.take(45)? {
            let that = src.get()?;
            if that.n == 0 {
                return Err(src.error("unterminated character set".to_string(), src.tell() - here));
            }
            if tok_is(that, 93) {
                set.push(code1);
                set.push(Item.Lit(45));
                break;
            }
            let code2 = if that.n == 2 { class_escape(mut src, that)? } else { Item.Lit(that.a) };
            let text = f"{to_string(tok_text(this))}-{to_string(tok_text(that))}";
            let offset = this.n + 1 + that.n;
            let lo = match code1 {
                Item.Lit(c) => c,
                _ => -1,
            };
            let hi = match code2 {
                Item.Lit(c) => c,
                _ => -1,
            };
            if lo < 0 or hi < 0 or hi < lo {
                return Err(src.error(f"bad character range {text}", offset));
            }
            set.push(Item.Range(lo, hi));
        } else {
            set.push(code1);
        }
    }
    if set.len() == 1 {
        let only = ref set[0];
        if let Item.Lit(c) = only {
            if negate {
                out.push(Node.NotLit(c));
            } else {
                out.push(Node.Lit(c));
            }
            return Ok(());
        }
    }
    out.push(Node.In(set, negate));
    Ok(())
}

// The quantifier just read (its first character is `this`), applied to
// the last item. Returns false when `{` turned out to be a literal.
fn parse_repeat(src: mut ref Tokenizer, this: T, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let here = src.tell();
    let mut min = 0;
    let mut max = maxrepeat();
    if tok_is(this, 63) {
        max = 1;
    } else if tok_is(this, 43) {
        min = 1;
    } else if tok_is(this, 123) {
        if tok_is(src.next, 125) {
            out.push(Node.Lit(123));
            return Ok(false);
        }
        let mut lo: Vec[i64] = Vec.new();
        let mut hi: Vec[i64] = Vec.new();
        while src.next.n == 1 and is_dec(src.next.a) {
            lo.push(src.get()?.a);
        }
        if src.take(44)? {
            while src.next.n == 1 and is_dec(src.next.a) {
                hi.push(src.get()?.a);
            }
        } else {
            hi = lo.clone();
        }
        if not src.take(125)? {
            out.push(Node.Lit(123));
            src.seek(here)?;
            return Ok(false);
        }
        if lo.len() > 0 {
            if lo.len() > 10 or digits_value(lo, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            min = digits_value(lo, 0, 10);
        }
        if hi.len() > 0 {
            if hi.len() > 10 or digits_value(hi, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            max = digits_value(hi, 0, 10);
            if max < min {
                return Err(src.error("min repeat greater than max repeat".to_string(), src.tell() - here));
            }
        }
    }
    if out.len() == 0 or is_at(out[out.len() - 1]) {
        return Err(src.error("nothing to repeat".to_string(), src.tell() - here + 1));
    }
    if is_repeat(out[out.len() - 1]) {
        return Err(src.error("multiple repeat".to_string(), src.tell() - here + 1));
    }
    let last = out.pop().unwrap();
    let mut body: Vec[Node] = Vec.new();
    match last {
        Node.Group(0, 0, 0, p) => body = p,
        other => body.push(other),
    }
    let kind = if src.take(63)? { 1 } else if src.take(43)? { 2 } else { 0 };
    out.push(Node.Repeat(kind, min, max, body));
    Ok(true)
}

fn parse_seq(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64, first: bool) -> Result[Vec[Node], ReErr] {
    let mut out: Vec[Node] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let this = src.next;
        if this.n == 0 or tok_is(this, 124) or tok_is(this, 41) {
            break;
        }
        src.advance()?;
        if verbose {
            if this.n == 1 and (this.a == 32 or (this.a >= 9 and this.a <= 13)) {
                continue;
            }
            if tok_is(this, 35) {
                loop {
                    let t = src.get()?;
                    if t.n == 0 or tok_is(t, 10) {
                        break;
                    }
                }
                continue;
            }
        }
        if this.n == 2 {
            let node = escape(mut src, this, st)?;
            out.push(node);
            continue;
        }
        let c = this.a;
        if c == 91 {
            parse_set(mut src, mut out)?;
        } else if c == 42 or c == 43 or c == 63 or c == 123 {
            parse_repeat(mut src, this, mut out)?;
        } else if c == 46 {
            out.push(Node.Any);
        } else if c == 94 {
            out.push(Node.At(at_beginning()));
        } else if c == 36 {
            out.push(Node.At(at_end()));
        } else if c == 40 {
            if parse_group(mut src, mut st, mut verbose, nested, first, mut out)? {
                continue;
            }
        } else {
            out.push(Node.Lit(c));
        }
    }
    Ok(out)
}

// `(` and what follows. Returns true for a construct that adds nothing
// (a comment, global flags).
fn parse_group(src: mut ref Tokenizer, st: mut ref ParseState, verbose: mut ref bool, nested: i64, first: bool, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let start = src.tell() - 1;
    let mut capture = true;
    let mut atomic = false;
    let mut name: Vec[i64] = Vec.new();
    let mut named = false;
    let mut add = 0;
    let mut del = 0;
    if src.take(63)? {
        let ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("unexpected end of pattern".to_string(), 0));
        }
        if tok_is(ch, 80) {
            if src.take(60)? {
                name = src.getuntil(62, "group name")?;
                src.checkgroupname(name, 1)?;
                named = true;
            } else if src.take(61)? {
                let ref_name = src.getuntil(41, "group name")?;
                src.checkgroupname(ref_name, 1)?;
                let gid = st.group_of(ref_name);
                if gid < 0 {
                    return Err(src.error(f"unknown group name {repr_of(ref_name)}", ref_name.len() + 1));
                }
                if not st.checkgroup(gid) {
                    return Err(src.error("cannot refer to an open group".to_string(), ref_name.len() + 1));
                }
                st.checklookbehindgroup(gid, src)?;
                out.push(Node.GroupRef(gid));
                return Ok(true);
            } else {
                let c2 = src.get()?;
                if c2.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                return Err(src.error(f"unknown extension ?P{to_string(tok_text(c2))}", c2.n + 2));
            }
        } else if tok_is(ch, 58) {
            capture = false;
        } else if tok_is(ch, 35) {
            loop {
                if src.next.n == 0 {
                    return Err(src.error("missing ), unterminated comment".to_string(), src.tell() - start));
                }
                if tok_is(src.get()?, 41) {
                    break;
                }
            }
            return Ok(true);
        } else if tok_is(ch, 61) or tok_is(ch, 33) or tok_is(ch, 60) {
            let mut kind = ch;
            let mut dir = 1;
            let mut outer_lookbehind = 0;
            if tok_is(ch, 60) {
                kind = src.get()?;
                if kind.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                if not (tok_is(kind, 61) or tok_is(kind, 33)) {
                    return Err(src.error(f"unknown extension ?<{to_string(tok_text(kind))}", kind.n + 2));
                }
                dir = -1;
                outer_lookbehind = st.lookbehind_groups;
                if outer_lookbehind < 0 {
                    st.lookbehind_groups = st.groups();
                }
            }
            let p = parse_sub(mut src, mut st, *verbose, nested + 1)?;
            if dir < 0 and outer_lookbehind < 0 {
                st.lookbehind_groups = -1;
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            if tok_is(kind, 61) {
                out.push(Node.Assert(dir, false, p));
            } else if p.len() > 0 {
                out.push(Node.Assert(dir, true, p));
            } else {
                out.push(Node.Failure);
            }
            return Ok(true);
        } else if tok_is(ch, 40) {
            let condname = src.getuntil(41, "group name")?;
            let mut condgroup = 0;
            if not is_ascii_decimal(condname) {
                src.checkgroupname(condname, 1)?;
                condgroup = st.group_of(condname);
                if condgroup < 0 {
                    return Err(src.error(f"unknown group name {repr_of(condname)}", condname.len() + 1));
                }
            } else {
                if condname.len() > 10 {
                    return Err(src.error(f"invalid group reference {to_string(condname)}", condname.len() + 1));
                }
                condgroup = digits_value(condname, 0, 10);
                if condgroup == 0 {
                    return Err(src.error("bad group number".to_string(), condname.len() + 1));
                }
                if condgroup >= maxgroups() {
                    return Err(src.error(f"invalid group reference {condgroup}", condname.len() + 1));
                }
                let mut seen = false;
                for (g, _) in st.refpos.iter() {
                    if g == condgroup {
                        seen = true;
                    }
                }
                if not seen {
                    st.refpos.push((condgroup, src.tell() - condname.len() - 1));
                }
            }
            st.checklookbehindgroup(condgroup, src)?;
            let yes = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
            let mut no: Vec[Node] = Vec.new();
            if src.take(124)? {
                no = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
                if tok_is(src.next, 124) {
                    return Err(src.error("conditional backref with more than two branches".to_string(), 0));
                }
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            out.push(Node.Exists(condgroup, yes, no));
            return Ok(true);
        } else if tok_is(ch, 62) {
            capture = false;
            atomic = true;
        } else if (ch.n == 1 and flag_value(ch.a) != 0) or tok_is(ch, 45) {
            match parse_flags(mut src, mut st, ch)? {
                None => {
                    if not first or out.len() > 0 {
                        return Err(src.error("global flags not at the start of the expression".to_string(), src.tell() - start));
                    }
                    *verbose = (st.flags & flag_x()) != 0;
                    return Ok(true);
                }
                Some((a, d)) => {
                    add = a;
                    del = d;
                    capture = false;
                }
            }
        } else {
            return Err(src.error(f"unknown extension ?{to_string(tok_text(ch))}", ch.n + 1));
        }
    }
    let mut group = 0;
    if capture {
        group = st.groups();
        st.closed.push(false);
        st.widths.push(Width { lo: 0, hi: 0 });
        if named {
            let was = st.group_of(name);
            if was >= 0 {
                return Err(src.error(f"redefinition of group name {repr_of(name)} as group {group}; was group {was}", name.len() + 1));
            }
            st.names.push((name.clone(), group));
        }
    }
    let sub_verbose = (*verbose or (add & flag_x()) != 0) and (del & flag_x()) == 0;
    let p = parse_sub(mut src, mut st, sub_verbose, nested + 1)?;
    if not src.take(41)? {
        return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
    }
    if group > 0 {
        let w = width_of(st.widths, p);
        st.widths[group] = w;
        st.closed[group] = true;
    }
    if atomic {
        out.push(Node.Atomic(p));
    } else {
        out.push(Node.Group(group, add, del, p));
    }
    Ok(false)
}

struct Parsed {
    nodes: Vec[Node],
    flags: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
    widths: Vec[Width],
}

fn parse(pattern: ref Vec[i64], flags: i64) -> Result[Parsed, ReErr] {
    let mut src = new_tokenizer(pattern)?;
    let mut st = ParseState {
        flags: flags,
        names: Vec.new(),
        closed: Vec.new(),
        widths: Vec.new(),
        lookbehind_groups: -1,
        refpos: Vec.new(),
    };
    // group 0 is the whole match
    st.closed.push(true);
    st.widths.push(Width { lo: 0, hi: 0 });
    let nodes = parse_sub(mut src, mut st, (flags & flag_x()) != 0, 0)?;
    if (st.flags & flag_a()) != 0 and (st.flags & flag_u()) != 0 {
        return Err(other_error("ValueError", "ASCII and UNICODE flags are incompatible".to_string()));
    }
    if src.next.n != 0 {
        return Err(src.error("unbalanced parenthesis".to_string(), 0));
    }
    for (g, pos) in st.refpos.iter() {
        if g >= st.groups() {
            return Err(re_error(f"invalid group reference {g}", pos));
        }
    }
    let groups = st.groups() - 1;
    Ok(Parsed { nodes: nodes, flags: st.flags, groups: groups, names: st.names, widths: st.widths })
}

// ---------------------------------------------------------- compiler

enum Op {
    // character (lowered when case-insensitive), case-insensitive, ASCII
    Lit(i64, bool, bool),
    NotLit(i64, bool, bool),
    Any,
    AnyAll,
    // set, case-insensitive, ASCII-only categories
    In(i64, bool, bool),
    // anchor kind, ASCII-only word boundary
    At(i64, bool),
    Mark(i64),
    Split(i64, i64),
    Jmp(i64),
    // repeat register, the Until it starts at
    RepInit(i64, i64),
    // register, min, max, greedy, body, exit
    Until(i64, i64, i64, bool, i64, i64),
    Ref(i64, bool, bool),
    // lookbehind width (-1 for lookahead), negative, sub-program, next
    Look(i64, bool, i64, i64),
    Atomic(i64, i64),
    Exists(i64, i64),
    Fail,
    Succeed,
    Match,
}

struct Program {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
}

struct CharSet {
    items: Vec[Item],
    negate: bool,
}

fn combine(flags: i64, add: i64, del: i64) -> i64 {
    let mut f = flags;
    if (add & type_flags()) != 0 {
        f = f & (0x7FFFFFFF ^ type_flags());
    }
    (f | add) & (0x7FFFFFFF ^ del)
}

struct Compiler {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
}

impl Compiler {
    fn emit(mut ref self, op: own Op) -> i64 {
        self.ops.push(op);
        self.ops.len() - 1
    }

    fn here(ref self) -> i64 {
        self.ops.len()
    }

    fn compile(mut ref self, p: ref Parsed, nodes: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let icase = (flags & flag_i()) != 0;
        let ascii = (flags & flag_a()) != 0;
        for n in nodes.iter() {
            match n {
                Node.Lit(c) => {
                    let v = if icase { lower(c, ascii) } else { c };
                    self.emit(Op.Lit(v, icase, ascii));
                }
                Node.NotLit(c) => {
                    let v = if icase { lower(c, ascii) } else { c };
                    self.emit(Op.NotLit(v, icase, ascii));
                }
                Node.Any => {
                    if (flags & flag_s()) != 0 {
                        self.emit(Op.AnyAll);
                    } else {
                        self.emit(Op.Any);
                    }
                }
                Node.In(items, negate) => {
                    self.sets.push(CharSet { items: items.clone(), negate: negate });
                    let idx = self.sets.len() - 1;
                    self.emit(Op.In(idx, icase, ascii));
                }
                Node.At(kind) => {
                    let mut k = kind;
                    if (flags & flag_m()) != 0 {
                        if k == at_beginning() {
                            k = at_beginning_line();
                        } else if k == at_end() {
                            k = at_end_line();
                        }
                    }
                    self.emit(Op.At(k, ascii));
                }
                Node.Branch(items) => {
                    let mut ends: Vec[i64] = Vec.new();
                    let mut i = 0;
                    while i < items.len() {
                        if i + 1 < items.len() {
                            let split = self.emit(Op.Fail);
                            self.compile(p, items[i], flags)?;
                            ends.push(self.emit(Op.Fail));
                            let next = self.here();
                            self.ops[split] = Op.Split(split + 1, next);
                        } else {
                            self.compile(p, items[i], flags)?;
                        }
                        i += 1;
                    }
                    let end = self.here();
                    for at in ends {
                        self.ops[at] = Op.Jmp(end);
                    }
                }
                Node.Group(g, add, off, body) => {
                    if g > 0 {
                        self.emit(Op.Mark(2 * g));
                    }
                    self.compile(p, body, combine(flags, add, off))?;
                    if g > 0 {
                        self.emit(Op.Mark(2 * g + 1));
                    }
                }
                Node.Repeat(kind, min, max, body) => {
                    if kind == 2 {
                        let at = self.emit(Op.Fail);
                        self.compile_repeat(p, min, max, true, body, flags)?;
                        self.emit(Op.Succeed);
                        let next = self.here();
                        self.ops[at] = Op.Atomic(at + 1, next);
                    } else {
                        self.compile_repeat(p, min, max, kind == 0, body, flags)?;
                    }
                }
                Node.Atomic(body) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Atomic(at + 1, next);
                }
                Node.Assert(dir, negative, body) => {
                    let mut width = -1;
                    if dir < 0 {
                        let w = width_of(p.widths, body);
                        if w.lo != w.hi {
                            return Err(other_error("error", "look-behind requires fixed-width pattern".to_string()));
                        }
                        width = w.lo;
                    }
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Look(width, negative, at + 1, next);
                }
                Node.GroupRef(g) => {
                    self.emit(Op.Ref(g, icase, ascii));
                }
                Node.Exists(g, yes, no) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, yes, flags)?;
                    if no.len() > 0 {
                        let jump = self.emit(Op.Fail);
                        let no_pc = self.here();
                        self.compile(p, no, flags)?;
                        let end = self.here();
                        self.ops[jump] = Op.Jmp(end);
                        self.ops[at] = Op.Exists(g, no_pc);
                    } else {
                        let end = self.here();
                        self.ops[at] = Op.Exists(g, end);
                    }
                }
                Node.Failure => {
                    self.emit(Op.Fail);
                }
            }
        }
        Ok(())
    }

    fn compile_repeat(mut ref self, p: ref Parsed, min: i64, max: i64, greedy: bool, body: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let r = self.repeats;
        self.repeats += 1;
        let init = self.emit(Op.Fail);
        self.compile(p, body, flags)?;
        let until = self.emit(Op.Fail);
        self.ops[init] = Op.RepInit(r, until);
        self.ops[until] = Op.Until(r, min, max, greedy, init + 1, until + 1);
        Ok(())
    }
}

fn compile(pattern: ref Vec[i64], flags: i64) -> Result[Program, ReErr] {
    let p = parse(pattern, flags)?;
    let mut c = Compiler { ops: Vec.new(), sets: Vec.new(), repeats: 0 };
    c.compile(p, p.nodes, p.flags)?;
    c.emit(Op.Match);
    Ok(Program { ops: c.ops, sets: c.sets, repeats: c.repeats, groups: p.groups, names: p.names })
}

// ----------------------------------------------------------- matcher

struct Undo {
    kind: i64,
    idx: i64,
    old: i64,
}

struct Choice {
    pc: i64,
    pos: i64,
    trail: i64,
    // 0: resume at pc; 1: a lazy repeat's Until, after its tail failed
    mode: i64,
}

struct Matcher {
    s: Vec[i64],
    marks: Vec[i64],
    counts: Vec[i64],
    lasts: Vec[i64],
    lastindex: i64,
    trail: Vec[Undo],
    start: i64,
    must_advance: bool,
    match_all: bool,
}

impl Matcher {
    fn set_mark(mut ref self, slot: i64, v: i64) {
        self.trail.push(Undo { kind: 0, idx: slot, old: self.marks[slot] });
        self.marks[slot] = v;
    }

    fn set_count(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 1, idx: r, old: self.counts[r] });
        self.counts[r] = v;
    }

    fn set_last(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 2, idx: r, old: self.lasts[r] });
        self.lasts[r] = v;
    }

    fn set_lastindex(mut ref self, v: i64) {
        self.trail.push(Undo { kind: 3, idx: 0, old: self.lastindex });
        self.lastindex = v;
    }

    fn undo_to(mut ref self, len: i64) {
        while self.trail.len() > len {
            let u = self.trail.pop().unwrap();
            if u.kind == 0 {
                self.marks[u.idx] = u.old;
            } else if u.kind == 1 {
                self.counts[u.idx] = u.old;
            } else if u.kind == 2 {
                self.lasts[u.idx] = u.old;
            } else {
                self.lastindex = u.old;
            }
        }
    }

    // A group that has both marks, the end not before the start.
    fn group_span(ref self, g: i64) -> (i64, i64) {
        let a = self.marks[2 * g];
        let b = self.marks[2 * g + 1];
        if a < 0 or b < 0 or b < a {
            return (-1, -1);
        }
        (a, b)
    }

    fn at(ref self, kind: i64, ascii: bool, pos: i64) -> bool {
        let n = self.s.len();
        if kind == 0 or kind == 2 {
            return pos == 0;
        }
        if kind == 1 {
            return pos == 0 or self.s[pos - 1] == 10;
        }
        if kind == 3 {
            return pos == n or (pos == n - 1 and self.s[pos] == 10);
        }
        if kind == 4 {
            return pos == n or self.s[pos] == 10;
        }
        if kind == 5 {
            return pos == n;
        }
        if n == 0 {
            return false;
        }
        let before = pos > 0 and is_word(self.s[pos - 1], ascii);
        let after = pos < n and is_word(self.s[pos], ascii);
        if kind == 6 { before != after } else { before == after }
    }

    // Runs the program from pc at pos, backtracking through its own
    // choices only. Returns where it succeeded, or -1.
    fn run(mut ref self, prog: ref Program, pc0: i64, pos0: i64, top: bool) -> i64 {
        let base = self.trail.len();
        let mut choices: Vec[Choice] = Vec.new();
        let mut pc = pc0;
        let mut pos = pos0;
        let mut mode = 0;
        loop {
            let mut ok = true;
            let op = ref prog.ops[pc];
            if mode == 1 {
                // a lazy repeat whose tail failed: try one more item
                mode = 0;
                ok = false;
                if let Op.Until(r, _, max, _, body, _) = op {
                    let count = self.counts[r] + 1;
                    if not ((count >= max and max != maxrepeat()) or pos == self.lasts[r]) {
                        self.set_count(r, count);
                        self.set_last(r, pos);
                        pc = body;
                        ok = true;
                    }
                }
                if ok {
                    continue;
                }
            } else {
                match op {
                    Op.Lit(c, icase, ascii) => {
                        if pos < self.s.len() and (if icase { lower(self.s[pos], ascii) == c } else { self.s[pos] == c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.NotLit(c, icase, ascii) => {
                        if pos < self.s.len() and (if icase { lower(self.s[pos], ascii) != c } else { self.s[pos] != c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Any => {
                        if pos < self.s.len() and self.s[pos] != 10 {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.AnyAll => {
                        if pos < self.s.len() {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.In(set, icase, ascii) => {
                        if pos < self.s.len() and in_set(prog.sets[set], self.s[pos], icase, ascii) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.At(kind, ascii) => {
                        if self.at(kind, ascii, pos) {
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Mark(slot) => {
                        self.set_mark(slot, pos);
                        if (slot & 1) == 1 {
                            self.set_lastindex(slot / 2);
                        }
                        pc += 1;
                    }
                    Op.Split(a, b) => {
                        choices.push(Choice { pc: b, pos: pos, trail: self.trail.len(), mode: 0 });
                        pc = a;
                    }
                    Op.Jmp(a) => pc = a,
                    Op.RepInit(r, until) => {
                        self.set_count(r, -1);
                        self.set_last(r, -1);
                        pc = until;
                    }
                    Op.Until(r, min, max, greedy, body, exit) => {
                        let count = self.counts[r] + 1;
                        if count < min {
                            self.set_count(r, count);
                            pc = body;
                        } else if greedy {
                            if (count < max or max == maxrepeat()) and pos != self.lasts[r] {
                                choices.push(Choice { pc: exit, pos: pos, trail: self.trail.len(), mode: 0 });
                                self.set_count(r, count);
                                self.set_last(r, pos);
                                pc = body;
                            } else {
                                pc = exit;
                            }
                        } else {
                            choices.push(Choice { pc: pc, pos: pos, trail: self.trail.len(), mode: 1 });
                            pc = exit;
                        }
                    }
                    Op.Ref(g, icase, ascii) => {
                        let (a, b) = self.group_span(g);
                        if a < 0 {
                            ok = false;
                        } else {
                            let len = b - a;
                            if pos + len > self.s.len() {
                                ok = false;
                            } else {
                                let mut k = 0;
                                while k < len {
                                    let x = self.s[a + k];
                                    let y = self.s[pos + k];
                                    let eq = if icase { lower(x, ascii) == lower(y, ascii) } else { x == y };
                                    if not eq {
                                        ok = false;
                                        break;
                                    }
                                    k += 1;
                                }
                                if ok {
                                    pos += len;
                                    pc += 1;
                                }
                            }
                        }
                    }
                    Op.Look(width, negative, sub, next) => {
                        let mark = self.trail.len();
                        let from = if width < 0 { pos } else { pos - width };
                        let found = from >= 0 and self.run(prog, sub, from, false) >= 0;
                        if negative {
                            self.undo_to(mark);
                            if found {
                                ok = false;
                            } else {
                                pc = next;
                            }
                        } else if found {
                            pc = next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Atomic(sub, next) => {
                        let end = self.run(prog, sub, pos, false);
                        if end >= 0 {
                            pos = end;
                            pc = next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Exists(g, no) => {
                        let (a, _) = self.group_span(g);
                        if a >= 0 {
                            pc += 1;
                        } else {
                            pc = no;
                        }
                    }
                    Op.Fail => ok = false,
                    Op.Succeed => return pos,
                    Op.Match => {
                        if top and ((self.match_all and pos != self.s.len()) or (self.must_advance and pos == self.start)) {
                            ok = false;
                        } else {
                            return pos;
                        }
                    }
                }
            }
            if not ok {
                match choices.pop() {
                    Some(ch) => {
                        self.undo_to(ch.trail);
                        pc = ch.pc;
                        pos = ch.pos;
                        mode = ch.mode;
                    }
                    None => {
                        self.undo_to(base);
                        return -1;
                    }
                }
            }
        }
    }
}

fn in_items(set: ref CharSet, c: i64, ascii: bool) -> bool {
    for item in set.items.iter() {
        let hit = match item {
            Item.Lit(l) => c == l,
            Item.Range(lo, hi) => c >= lo and c <= hi,
            Item.Cat(k) => {
                let kind = k;
                if kind == 0 {
                    if ascii { c >= 48 and c <= 57 } else { is_decimal(c) }
                } else if kind == 1 {
                    if ascii { not (c >= 48 and c <= 57) } else { not is_decimal(c) }
                } else if kind == 2 {
                    is_space(c, ascii)
                } else if kind == 3 {
                    not is_space(c, ascii)
                } else if kind == 4 {
                    is_word(c, ascii)
                } else {
                    not is_word(c, ascii)
                }
            }
        };
        if hit {
            return true;
        }
    }
    false
}

// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = lower(c, ascii);
        if lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program, s: ref Vec[i64]) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        s: s.clone(),
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn find(m: mut ref Matcher, prog: ref Program, from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= m.s.len() {
        let mut k = 0;
        while k < m.marks.len() {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}

// All the matches finditer gives: each search starts where the last
// match ended, and must move on past an empty one.
fn all_matches(prog: ref Program, s: ref Vec[i64], limit: i64) -> Vec[Found] {
    let mut m = new_matcher(prog, s);
    let mut out: Vec[Found] = Vec.new();
    let mut pos = 0;
    let mut must_advance = false;
    while pos <= s.len() and (limit == 0 or out.len() < limit) {
        match find(mut m, prog, pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    out
}

fn group_text(s: ref Vec[i64], span: (i64, i64), out: mut ref Vec[i64]) {
    let (a, b) = span;
    if a < 0 {
        push_ascii(mut out, "None");
    } else {
        str_repr(slice(s, a, b), mut out);
    }
}

fn span_text(span: (i64, i64)) -> String {
    let (a, b) = span;
    f"({a}, {b})"
}

fn show_match(prog: ref Program, s: ref Vec[i64], found: ref Option[Found], out: mut ref Vec[i64]) {
    let m = match found {
        Some(m) => m,
        None => {
            push_ascii(mut out, "  None\n");
            return;
        }
    };
    push_ascii(mut out, f"  span={span_text((m.start, m.end))} match=");
    str_repr(slice(s, m.start, m.end), mut out);
    out.push(10);
    if prog.groups > 0 {
        push_ascii(mut out, "  groups=(");
        let mut g = 0;
        while g < m.spans.len() {
            if g > 0 {
                push_ascii(mut out, ", ");
            }
            group_text(s, m.spans[g], mut out);
            g += 1;
        }
        if m.spans.len() == 1 {
            push_ascii(mut out, ",");
        }
        push_ascii(mut out, ")\n  spans=[");
        g = 0;
        while g < m.spans.len() {
            if g > 0 {
                push_ascii(mut out, ", ");
            }
            push_ascii(mut out, span_text(m.spans[g]));
            g += 1;
        }
        push_ascii(mut out, "]\n");
    }
    if prog.names.len() > 0 {
        push_ascii(mut out, "  named=");
        group_dict(prog, s, m, mut out);
        out.push(10);
    }
}

fn group_dict(prog: ref Program, s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    out.push(123);
    let mut k = 0;
    while k < prog.names.len() {
        if k > 0 {
            push_ascii(mut out, ", ");
        }
        let (name, g) = ref prog.names[k];
        str_repr(name, mut out);
        push_ascii(mut out, ": ");
        group_text(s, m.spans[g - 1], mut out);
        k += 1;
    }
    out.push(125);
}

// findall's item: the match, the one group, or a tuple of the groups,
// with '' for a group that did not take part.
fn findall_item(prog: ref Program, s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    if prog.groups == 0 {
        str_repr(slice(s, m.start, m.end), mut out);
        return;
    }
    if prog.groups > 1 {
        out.push(40);
    }
    let mut g = 0;
    while g < m.spans.len() {
        if g > 0 {
            push_ascii(mut out, ", ");
        }
        let (a, b) = m.spans[g];
        if a < 0 {
            push_ascii(mut out, "''");
        } else {
            str_repr(slice(s, a, b), mut out);
        }
        g += 1;
    }
    if prog.groups > 1 {
        out.push(41);
    }
}

// A replacement template: literal text and group numbers.
enum Piece {
    Text(Vec[i64]),
    Group(i64),
}

// _parser.parse_template.
fn parse_template(repl: ref Vec[i64], prog: ref Program) -> Result[Vec[Piece], ReErr] {
    let mut s = new_tokenizer(repl)?;
    let mut pieces: Vec[Piece] = Vec.new();
    let mut literal: Vec[i64] = Vec.new();
    loop {
        let this = s.get()?;
        if this.n == 0 {
            break;
        }
        if this.n == 1 {
            literal.push(this.a);
            continue;
        }
        let c = this.b;
        let mut index = -1;
        let mut offset = 0;
        if c == 103 {
            if not s.take(60)? {
                return Err(s.error("missing <".to_string(), 0));
            }
            let name = s.getuntil(62, "group name")?;
            if not is_ascii_decimal(name) {
                s.checkgroupname(name, 1)?;
                let mut found = -1;
                for (n, g) in prog.names.iter() {
                    if same(n, name) {
                        found = g;
                    }
                }
                if found < 0 {
                    return Err(other_error("IndexError", f"unknown group name {repr_of(name)}"));
                }
                index = found;
            } else {
                if name.len() > 10 or digits_value(name, 0, 10) >= maxgroups() {
                    return Err(s.error(f"invalid group reference {to_string(name)}", name.len() + 1));
                }
                index = digits_value(name, 0, 10);
            }
            offset = name.len() + 1;
        } else if c == 48 {
            let mut text = tok_text(this);
            if s.next.n == 1 and is_oct(s.next.a) {
                text.push(s.get()?.a);
                if s.next.n == 1 and is_oct(s.next.a) {
                    text.push(s.get()?.a);
                }
            }
            literal.push(digits_value(text, 1, 8) & 0xFF);
            continue;
        } else if is_dec(c) {
            let mut text = tok_text(this);
            if s.next.n == 1 and is_dec(s.next.a) {
                text.push(s.get()?.a);
                if is_oct(c) and is_oct(text[2]) and s.next.n == 1 and is_oct(s.next.a) {
                    text.push(s.get()?.a);
                    let v = digits_value(text, 1, 8);
                    if v > 0o377 {
                        return Err(s.error(f"octal escape value {to_string(text)} outside of range 0-0o377", text.len()));
                    }
                    literal.push(v);
                    continue;
                }
            }
            index = digits_value(text, 1, 10);
            offset = text.len() - 1;
        } else {
            let e = escape_value(this);
            if e >= 0 {
                literal.push(e);
            } else if is_ascii_letter(c) {
                return Err(s.error(f"bad escape {to_string(tok_text(this))}", 2));
            } else {
                literal.push(92);
                literal.push(c);
            }
            continue;
        }
        if index > prog.groups {
            return Err(s.error(f"invalid group reference {index}", offset));
        }
        pieces.push(Piece.Text(literal));
        literal = Vec.new();
        pieces.push(Piece.Group(index));
    }
    pieces.push(Piece.Text(literal));
    Ok(pieces)
}

fn expand(pieces: ref Vec[Piece], s: ref Vec[i64], m: ref Found, out: mut ref Vec[i64]) {
    for piece in pieces.iter() {
        match piece {
            Piece.Text(t) => push_all(mut out, t),
            Piece.Group(g) => {
                let (a, b) = if g == 0 { (m.start, m.end) } else { m.spans[g - 1] };
                if a >= 0 {
                    push_all(mut out, slice(s, a, b));
                }
            }
        }
    }
}


// --------------------------------------------------- Unicode strings
fn cp(s: Str) -> Vec[i64] {
    codepoints(s.bytes())
}


// ---------------------------------------------------------------- html.parser
// (mini_htmlparser's port of Python 3.13's html/parser.py)

// ---------------------------------------------------------------- chars

fn hp_is_space(c: char) -> bool {
    c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == '\u{c}'
}

fn hp_is_alpha(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')
}

fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn hp_is_hex(c: char) -> bool {
    is_digit(c) or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F')
}

fn is_alnum(c: char) -> bool {
    hp_is_alpha(c) or is_digit(c)
}

fn ascii_lower(c: char) -> char {
    if c >= 'A' and c <= 'Z' {
        match char.try_from(c as i64 + 32) {
            Ok(l) => l,
            Err(_) => c,
        }
    } else {
        c
    }
}

fn to_chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn hp_text(raw: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut s = String.new();
    let mut k = lo;
    while k < hi {
        s.push(raw[k]);
        k += 1;
    }
    s
}

// raw[i..] starts with s.
fn at(raw: ref Vec[char], i: i64, s: ref String) -> bool {
    let mut k = i;
    for c in s.chars() {
        if k >= raw.len() or raw[k] != c {
            return false;
        }
        k += 1;
    }
    true
}

// raw[i..] starts with s, ignoring ASCII case.
fn at_nocase(raw: ref Vec[char], i: i64, s: ref String) -> bool {
    let mut k = i;
    for c in s.chars() {
        if k >= raw.len() or ascii_lower(raw[k]) != ascii_lower(c) {
            return false;
        }
        k += 1;
    }
    true
}

fn find_char(raw: ref Vec[char], c: char, from: i64) -> i64 {
    let mut k = from;
    while k < raw.len() {
        if raw[k] == c {
            return k;
        }
        k += 1;
    }
    -1
}

fn find_str(raw: ref Vec[char], s: ref String, from: i64) -> i64 {
    let mut k = from;
    while k < raw.len() {
        if at(raw, k, s) {
            return k;
        }
        k += 1;
    }
    -1
}

// ---------------------------------------------------------------- html.escape / html.unescape

fn hp_escape(s: ref String, quote: bool) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c == '&' {
            out.push_str("&amp;");
        } else if c == '<' {
            out.push_str("&lt;");
        } else if c == '>' {
            out.push_str("&gt;");
        } else if quote and c == '"' {
            out.push_str("&quot;");
        } else if quote and c == '\'' {
            out.push_str("&#x27;");
        } else {
            out.push(c);
        }
    }
    out
}

// The numeric-character-reference-end-state table of html/__init__.py.
fn invalid_charref(num: i64) -> Option[i64] {
    if num == 0 {
        return Some(0xfffd);
    }
    if num == 0x0d {
        return Some(0x0d);
    }
    if num < 0x80 or num > 0x9f {
        return None;
    }
    let table: Vec[i64] = vec![
        0x20ac, 0x81, 0x201a, 0x0192, 0x201e, 0x2026, 0x2020, 0x2021,
        0x02c6, 0x2030, 0x0160, 0x2039, 0x0152, 0x8d, 0x017d, 0x8f,
        0x90, 0x2018, 0x2019, 0x201c, 0x201d, 0x2022, 0x2013, 0x2014,
        0x02dc, 0x2122, 0x0161, 0x203a, 0x0153, 0x9d, 0x017e, 0x0178,
    ];
    Some(table[num - 0x80])
}

fn invalid_codepoint(num: i64) -> bool {
    if (num >= 0x1 and num <= 0x8) or num == 0xb or (num >= 0xe and num <= 0x1f) {
        return true;
    }
    if (num >= 0x7f and num <= 0x9f) or (num >= 0xfdd0 and num <= 0xfdef) {
        return true;
    }
    num % 0x10000 >= 0xfffe and num <= 0x10ffff
}

fn push_code(out: mut ref String, num: i64) {
    match char.try_from(num) {
        Ok(c) => out.push(c),
        Err(_) => out.push('\u{fffd}'),
    }
}

fn numeric_ref(num: i64, out: mut ref String) {
    match invalid_charref(num) {
        Some(v) => {
            push_code(mut out, v);
            return;
        }
        None => {}
    }
    if (num >= 0xd800 and num <= 0xdfff) or num > 0x10ffff {
        out.push('\u{fffd}');
        return;
    }
    if invalid_codepoint(num) {
        return;
    }
    push_code(mut out, num);
}

// The digits raw[lo..hi] in base 10 or 16, held at 0x110000 once past
// the last code point, as int() then the range check would decide.
fn ref_number(raw: ref Vec[char], lo: i64, hi: i64, base: i64) -> i64 {
    let mut n = 0;
    let mut k = lo;
    while k < hi {
        let c = raw[k];
        let d = if is_digit(c) {
            c as i64 - '0' as i64
        } else {
            ascii_lower(c) as i64 - 'a' as i64 + 10
        };
        n = n * base + d;
        if n > 0x10ffff {
            n = 0x110000;
        }
        k += 1;
    }
    n
}

// A named reference's text, the name possibly ending in ';'.
fn named_ref(name: ref Vec[char], ents: ref Map[String, String], out: mut ref String) {
    let whole = hp_text(name, 0, name.len());
    match ents.get(whole.clone()) {
        Some(v) => {
            out.push_str(v);
            return;
        }
        None => {}
    }
    // The longest name the standard allows as a prefix.
    let mut x = name.len() - 1;
    while x > 1 {
        match ents.get(hp_text(name, 0, x)) {
            Some(v) => {
                out.push_str(v);
                out.push_str(hp_text(name, x, name.len()));
                return;
            }
            None => {}
        }
        x -= 1;
    }
    out.push('&');
    out.push_str(whole);
}

fn named_class(c: char) -> bool {
    not (c == '\t' or c == '\n' or c == '\u{c}' or c == ' ' or c == '<' or c == '&' or c == '#' or c == ';')
}

// html.unescape over raw[lo..hi].
fn unescape_chars(raw: ref Vec[char], lo: i64, hi: i64, ents: ref Map[String, String]) -> String {
    let mut out = String.new();
    let mut p = lo;
    while p < hi {
        if raw[p] != '&' {
            out.push(raw[p]);
            p += 1;
            continue;
        }
        if p + 1 < hi and raw[p + 1] == '#' {
            if p + 2 < hi and is_digit(raw[p + 2]) {
                let mut q = p + 2;
                while q < hi and is_digit(raw[q]) {
                    q += 1;
                }
                numeric_ref(ref_number(raw, p + 2, q, 10), mut out);
                if q < hi and raw[q] == ';' {
                    q += 1;
                }
                p = q;
            } else if p + 3 < hi and (raw[p + 2] == 'x' or raw[p + 2] == 'X') and hp_is_hex(raw[p + 3]) {
                let mut q = p + 3;
                while q < hi and hp_is_hex(raw[q]) {
                    q += 1;
                }
                numeric_ref(ref_number(raw, p + 3, q, 16), mut out);
                if q < hi and raw[q] == ';' {
                    q += 1;
                }
                p = q;
            } else {
                out.push('&');
                p += 1;
            }
            continue;
        }
        let mut q = p + 1;
        while q < hi and q - (p + 1) < 32 and named_class(raw[q]) {
            q += 1;
        }
        if q == p + 1 {
            out.push('&');
            p += 1;
            continue;
        }
        if q < hi and raw[q] == ';' {
            q += 1;
        }
        let name: Vec[char] = raw[p + 1..q].iter().collect();
        named_ref(name, ents, mut out);
        p = q;
    }
    out
}

fn unescape(s: ref String, ents: ref Map[String, String]) -> String {
    let raw = to_chars(s);
    unescape_chars(raw, 0, raw.len(), ents)
}

// _unescape_attrvalue: numeric references always, named ones only when
// the whole name is in the table and no '=' follows.
fn unescape_attr(s: ref String, ents: ref Map[String, String]) -> String {
    let raw = to_chars(s);
    let n = raw.len();
    let mut out = String.new();
    let mut p = 0;
    while p < n {
        if raw[p] != '&' {
            out.push(raw[p]);
            p += 1;
            continue;
        }
        let mut q = p + 1;
        let mut numeric = false;
        if q < n and raw[q] == '#' {
            if q + 1 < n and is_digit(raw[q + 1]) {
                q += 1;
                while q < n and is_digit(raw[q]) {
                    q += 1;
                }
                numeric = true;
            } else if q + 2 < n and (raw[q + 1] == 'x' or raw[q + 1] == 'X') and hp_is_hex(raw[q + 2]) {
                q += 2;
                while q < n and hp_is_hex(raw[q]) {
                    q += 1;
                }
                numeric = true;
            } else {
                out.push('&');
                p += 1;
                continue;
            }
        } else if q < n and hp_is_alpha(raw[q]) {
            while q < n and is_alnum(raw[q]) {
                q += 1;
            }
        } else {
            out.push('&');
            p += 1;
            continue;
        }
        let mut eq = false;
        if q < n and (raw[q] == ';' or raw[q] == '=') {
            eq = raw[q] == '=';
            q += 1;
        }
        let r = hp_text(raw, p, q);
        if numeric {
            out.push_str(unescape_chars(raw, p, q, ents));
        } else if not eq and ents.contains_key(hp_text(raw, p + 1, q)) {
            out.push_str(unescape_chars(raw, p, q, ents));
        } else {
            out.push_str(r);
        }
        p = q;
    }
    out
}

// ---------------------------------------------------------------- the tokenizer's patterns

// The end of locatetagend's match at p (a tag name's first letter).
fn locate_tag_end(raw: ref Vec[char], p: i64) -> i64 {
    let n = raw.len();
    let mut k = p + 1;
    while k < n and not (hp_is_space(raw[k]) or raw[k] == '/' or raw[k] == '>') {
        k += 1;
    }
    while k < n and (hp_is_space(raw[k]) or raw[k] == '/') {
        k += 1;
    }
    loop {
        if k >= n or not after_attr_gap(raw[k - 1]) {
            break;
        }
        let c = raw[k];
        if hp_is_space(c) or c == '/' or c == '>' {
            break;
        }
        k = attr_name_end(raw, k);
        match value_indicator(raw, k) {
            Some(v) => k = v.2,
            None => {}
        }
        while k < n and (hp_is_space(raw[k]) or raw[k] == '/') {
            k += 1;
        }
    }
    if k < n and raw[k] == '>' {
        k += 1;
    }
    k
}

// The lookbehind before an attribute name: ['"\t\n\r\f /].
fn after_attr_gap(c: char) -> bool {
    c == '\'' or c == '"' or hp_is_space(c) or c == '/'
}

fn attr_name_end(raw: ref Vec[char], k: i64) -> i64 {
    let n = raw.len();
    let mut e = k + 1;
    while e < n and not (hp_is_space(raw[e]) or raw[e] == '/' or raw[e] == '=' or raw[e] == '>') {
        e += 1;
    }
    e
}

// A value at b: 'x', "x" or a bare run; None when a quote opens and never
// closes.
fn value_at(raw: ref Vec[char], b: i64) -> Option[i64] {
    let n = raw.len();
    if b < n and (raw[b] == '\'' or raw[b] == '"') {
        let q = find_char(raw, raw[b], b + 1);
        if q < 0 {
            return None;
        }
        return Some(q + 1);
    }
    let mut e = b;
    while e < n and not (raw[e] == '>' or hp_is_space(raw[e])) {
        e += 1;
    }
    Some(e)
}

// `[\t\n\r\f ]*=[\t\n\r\f ]*` and a value after an attribute name ending
// at k: (value start, value end, match end), backtracking the way re does
// when a quote never closes.
fn value_indicator(raw: ref Vec[char], k: i64) -> Option[(i64, i64, i64)] {
    let n = raw.len();
    let mut a = k;
    while a < n and hp_is_space(raw[a]) {
        a += 1;
    }
    if a >= n or raw[a] != '=' {
        return None;
    }
    let mut b = a + 1;
    while b < n and hp_is_space(raw[b]) {
        b += 1;
    }
    match value_at(raw, b) {
        Some(e) => Some((b, e, e)),
        None => {
            if b > a + 1 {
                // One space fewer, and the value is the empty bare run.
                Some((b - 1, b - 1, b - 1))
            } else {
                None
            }
        }
    }
}

struct Attr {
    name: String,
    value: Option[String],
}

// ---------------------------------------------------------------- events

enum Event {
    Start(String, Vec[Attr]),
    StartEnd(String, Vec[Attr]),
    End(String),
    Data(String),
    Comment(String),
    Decl(String),
    Pi(String),
    UnknownDecl(String),
    CharRef(String),
    EntityRef(String),
}

struct Ev {
    line: i64,
    col: i64,
    ev: Event,
}

// ---------------------------------------------------------------- HTMLParser

struct HtmlParser {
    convert_charrefs: bool,
    raw: Vec[char],
    lineno: i64,
    offset: i64,
    lasttag: String,
    cdata_elem: String,
    escapable: bool,
    support_cdata: bool,
    pending: Vec[char],
    pending_len: i64,
    parse_threshold: i64,
    starttag_text: Option[String],
    events: Vec[Ev],
}

fn is_cdata_content(tag: ref String) -> bool {
    tag == "script" or tag == "style" or tag == "xmp" or tag == "iframe" or tag == "noembed" or tag == "noframes"
}

impl HtmlParser {
    fn new(convert_charrefs: bool) -> HtmlParser {
        HtmlParser {
            convert_charrefs: convert_charrefs,
            raw: Vec.new(),
            lineno: 1,
            offset: 0,
            lasttag: "???".to_string(),
            cdata_elem: String.new(),
            escapable: true,
            support_cdata: true,
            pending: Vec.new(),
            pending_len: 0,
            parse_threshold: 1,
            starttag_text: None,
            events: Vec.new(),
        }
    }

    fn emit(mut ref self, ev: own Event) {
        self.events.push(Ev { line: self.lineno, col: self.offset, ev: ev });
    }

    fn feed(mut ref self, data: ref Vec[char], ents: ref Map[String, String]) {
        self.pending_len += data.len();
        if self.pending_len < self.parse_threshold {
            for c in data.iter() {
                self.pending.push(*c);
            }
            return;
        }
        for c in self.pending.iter() {
            self.raw.push(*c);
        }
        for c in data.iter() {
            self.raw.push(*c);
        }
        self.pending.clear();
        self.pending_len = 0;
        let n = self.raw.len();
        self.goahead(false, ents);
        if self.raw.len() < n {
            self.parse_threshold = 1;
        } else {
            self.parse_threshold = self.raw.len();
        }
    }

    fn close(mut ref self, ents: ref Map[String, String]) {
        if self.pending.len() > 0 {
            for c in self.pending.iter() {
                self.raw.push(*c);
            }
            self.pending.clear();
            self.pending_len = 0;
        }
        self.goahead(true, ents);
    }

    fn getpos(ref self) -> (i64, i64) {
        (self.lineno, self.offset)
    }

    fn updatepos(mut ref self, i: i64, j: i64) -> i64 {
        if i >= j {
            return j;
        }
        let mut nlines = 0;
        let mut last = -1;
        let mut k = i;
        while k < j {
            if self.raw[k] == '\n' {
                nlines += 1;
                last = k;
            }
            k += 1;
        }
        if nlines > 0 {
            self.lineno += nlines;
            self.offset = j - (last + 1);
        } else {
            self.offset += j - i;
        }
        j
    }

    fn set_cdata_mode(mut ref self, elem: ref String, escapable: bool) {
        self.cdata_elem = elem.to_lowercase();
        self.escapable = escapable;
    }

    fn clear_cdata_mode(mut ref self) {
        self.cdata_elem = String.new();
        self.escapable = true;
    }

    // self.interesting.search(rawdata, i): the start of the match, or -1.
    fn interesting(ref self, i: i64) -> i64 {
        let n = self.raw.len();
        if self.cdata_elem == "plaintext" {
            return n;
        }
        let mut p = i;
        while p < n {
            let c = self.raw[p];
            if self.cdata_elem == "" {
                if c == '<' or c == '&' {
                    return p;
                }
            } else {
                if self.escapable and not self.convert_charrefs and c == '&' {
                    return p;
                }
                if c == '<' and p + 1 < n and self.raw[p + 1] == '/' and at_nocase(self.raw, p + 2, self.cdata_elem) {
                    let after = p + 2 + self.cdata_elem.chars().count();
                    if after < n and (hp_is_space(self.raw[after]) or self.raw[after] == '/' or self.raw[after] == '>') {
                        return p;
                    }
                }
            }
            p += 1;
        }
        -1
    }

    fn data(mut ref self, lo: i64, hi: i64, ents: ref Map[String, String]) {
        let s = if self.convert_charrefs and self.escapable {
            unescape_chars(self.raw, lo, hi, ents)
        } else {
            hp_text(self.raw, lo, hi)
        };
        self.emit(Event.Data(s));
    }

    fn goahead(mut ref self, end: bool, ents: ref Map[String, String]) {
        let n = self.raw.len();
        let mut i = 0;
        while i < n {
            let mut j = n;
            if self.convert_charrefs and self.cdata_elem == "" {
                let lt = find_char(self.raw, '<', i);
                if lt < 0 {
                    // A reference may be cut in half at the end of the buffer.
                    let lo = if i > n - 34 { i } else { n - 34 };
                    let mut amppos = -1;
                    let mut k = n - 1;
                    while k >= lo {
                        if self.raw[k] == '&' {
                            amppos = k;
                            break;
                        }
                        k -= 1;
                    }
                    if amppos >= 0 {
                        let mut ended = false;
                        let mut q = amppos;
                        while q < n {
                            let c = self.raw[q];
                            if hp_is_space(c) or c == ';' {
                                ended = true;
                                break;
                            }
                            q += 1;
                        }
                        if not ended {
                            break;
                        }
                    }
                    j = n;
                } else {
                    j = lt;
                }
            } else {
                let m = self.interesting(i);
                if m >= 0 {
                    j = m;
                } else {
                    if self.cdata_elem != "" {
                        break;
                    }
                    j = n;
                }
            }
            if i < j {
                self.data(i, j, ents);
            }
            i = self.updatepos(i, j);
            if i == n {
                break;
            }
            if self.raw[i] == '<' {
                let mut k = 0;
                if i + 1 < n and hp_is_alpha(self.raw[i + 1]) {
                    k = self.parse_starttag(i, ents);
                } else if at(self.raw, i, "</") {
                    k = self.parse_endtag(i);
                } else if at(self.raw, i, "<!--") {
                    k = self.parse_comment(i);
                } else if at(self.raw, i, "<?") {
                    k = self.parse_pi(i);
                } else if at(self.raw, i, "<!") {
                    k = self.parse_html_declaration(i);
                } else if i + 1 < n or end {
                    self.emit(Event.Data("<".to_string()));
                    k = i + 1;
                } else {
                    break;
                }
                if k < 0 {
                    if not end {
                        break;
                    }
                    self.flush_unterminated(i);
                    k = n;
                }
                i = self.updatepos(i, k);
            } else if at(self.raw, i, "&#") {
                match self.match_charref(i) {
                    Some((name, e)) => {
                        self.emit(Event.CharRef(name));
                        let mut k = e;
                        if self.raw[k - 1] != ';' {
                            k -= 1;
                        }
                        i = self.updatepos(i, k);
                        continue;
                    }
                    None => {}
                }
                let incomplete = i + 2 < n and (is_digit(self.raw[i + 2])
                    or (i + 3 < n and (self.raw[i + 2] == 'x' or self.raw[i + 2] == 'X') and hp_is_hex(self.raw[i + 3])));
                if incomplete {
                    if end {
                        let name = hp_text(self.raw, i + 2, n);
                        self.emit(Event.CharRef(name));
                        i = self.updatepos(i, n);
                    }
                    break;
                } else if i + 3 < n {
                    self.emit(Event.Data("&#".to_string()));
                    i = self.updatepos(i, i + 2);
                } else {
                    break;
                }
            } else if self.raw[i] == '&' {
                match self.match_entityref(i) {
                    Some((name, e)) => {
                        self.emit(Event.EntityRef(name));
                        let mut k = e;
                        if self.raw[k - 1] != ';' {
                            k -= 1;
                        }
                        i = self.updatepos(i, k);
                        continue;
                    }
                    None => {}
                }
                let incomplete = i + 1 < n and (hp_is_alpha(self.raw[i + 1]) or self.raw[i + 1] == '#');
                if incomplete {
                    if end {
                        let name = hp_text(self.raw, i + 1, n);
                        self.emit(Event.EntityRef(name));
                        i = self.updatepos(i, n);
                    }
                    break;
                } else if i + 1 < n {
                    self.emit(Event.Data("&".to_string()));
                    i = self.updatepos(i, i + 1);
                } else {
                    break;
                }
            } else {
                panic("interesting.search() lied");
            }
        }
        if end and i < n {
            self.data(i, n, ents);
            i = self.updatepos(i, n);
        }
        self.raw = self.raw[i..].iter().collect();
    }

    // What goahead does at EOF with a construct that never ended.
    fn flush_unterminated(mut ref self, i: i64) {
        let n = self.raw.len();
        if i + 1 < n and hp_is_alpha(self.raw[i + 1]) {
            return;
        }
        if at(self.raw, i, "</") {
            if i + 2 == n {
                self.emit(Event.Data("</".to_string()));
            } else if i + 2 < n and hp_is_alpha(self.raw[i + 2]) {
                return;
            } else {
                let s = hp_text(self.raw, i + 2, n);
                self.emit(Event.Comment(s));
            }
        } else if at(self.raw, i, "<!--") {
            let mut j = n;
            let suffixes: Vec[String] = vec!["--!".to_string(), "--".to_string(), "-".to_string()];
            for suffix in suffixes.iter() {
                let len = suffix.chars().count();
                if n - (i + 4) >= len and at(self.raw, n - len, suffix) {
                    j -= len;
                    break;
                }
            }
            let s = hp_text(self.raw, i + 4, j);
            self.emit(Event.Comment(s));
        } else if at(self.raw, i, "<![CDATA[") and self.support_cdata {
            let s = hp_text(self.raw, i + 3, n);
            self.emit(Event.UnknownDecl(s));
        } else if at_nocase(self.raw, i, "<!doctype") {
            let s = hp_text(self.raw, i + 2, n);
            self.emit(Event.Decl(s));
        } else if at(self.raw, i, "<!") {
            let s = hp_text(self.raw, i + 2, n);
            self.emit(Event.Comment(s));
        } else if at(self.raw, i, "<?") {
            let s = hp_text(self.raw, i + 2, n);
            self.emit(Event.Pi(s));
        } else {
            panic("we should not get here!");
        }
    }

    // charref: &#(?:[0-9]+|[xX][0-9a-fA-F]+)[^0-9a-fA-F] at i.
    fn match_charref(ref self, i: i64) -> Option[(String, i64)] {
        let n = self.raw.len();
        let mut q = i + 2;
        if q < n and is_digit(self.raw[q]) {
            while q < n and is_digit(self.raw[q]) {
                q += 1;
            }
        } else if q + 1 < n and (self.raw[q] == 'x' or self.raw[q] == 'X') and hp_is_hex(self.raw[q + 1]) {
            q += 1;
            while q < n and hp_is_hex(self.raw[q]) {
                q += 1;
            }
        } else {
            return None;
        }
        if q >= n or hp_is_hex(self.raw[q]) {
            return None;
        }
        Some((hp_text(self.raw, i + 2, q), q + 1))
    }

    // entityref: &([a-zA-Z][-.a-zA-Z0-9]*)[^a-zA-Z0-9] at i, giving back
    // name characters when the buffer ends inside the name.
    fn match_entityref(ref self, i: i64) -> Option[(String, i64)] {
        let n = self.raw.len();
        if i + 1 >= n or not hp_is_alpha(self.raw[i + 1]) {
            return None;
        }
        let mut e = i + 2;
        while e < n and (is_alnum(self.raw[e]) or self.raw[e] == '-' or self.raw[e] == '.') {
            e += 1;
        }
        if e < n {
            return Some((hp_text(self.raw, i + 1, e), e + 1));
        }
        let mut b = e - 1;
        while b > i + 1 {
            if not is_alnum(self.raw[b]) {
                return Some((hp_text(self.raw, i + 1, b), b + 1));
            }
            b -= 1;
        }
        None
    }

    fn parse_html_declaration(mut ref self, i: i64) -> i64 {
        if at(self.raw, i, "<!--") {
            return self.parse_comment(i);
        } else if at(self.raw, i, "<![CDATA[") and self.support_cdata {
            let j = find_str(self.raw, "]]>", i + 9);
            if j < 0 {
                return -1;
            }
            let s = hp_text(self.raw, i + 3, j);
            self.emit(Event.UnknownDecl(s));
            return j + 3;
        } else if at_nocase(self.raw, i, "<!doctype") {
            let gtpos = find_char(self.raw, '>', i + 9);
            if gtpos < 0 {
                return -1;
            }
            let s = hp_text(self.raw, i + 2, gtpos);
            self.emit(Event.Decl(s));
            return gtpos + 1;
        }
        self.parse_bogus_comment(i)
    }

    fn parse_comment(mut ref self, i: i64) -> i64 {
        let n = self.raw.len();
        let mut start = -1;
        let mut stop = -1;
        // An empty comment is closed by the first ">" or "->".
        if i + 4 < n and self.raw[i + 4] == '>' {
            start = i + 4;
            stop = i + 5;
        } else if i + 5 < n and self.raw[i + 4] == '-' and self.raw[i + 5] == '>' {
            start = i + 4;
            stop = i + 6;
        } else {
            let mut p = i + 4;
            while p + 2 < n {
                if self.raw[p] == '-' and self.raw[p + 1] == '-' {
                    if self.raw[p + 2] == '>' {
                        start = p;
                        stop = p + 3;
                        break;
                    }
                    if p + 3 < n and self.raw[p + 2] == '!' and self.raw[p + 3] == '>' {
                        start = p;
                        stop = p + 4;
                        break;
                    }
                }
                p += 1;
            }
            if start < 0 {
                return -1;
            }
        }
        let s = hp_text(self.raw, i + 4, start);
        self.emit(Event.Comment(s));
        stop
    }

    fn parse_bogus_comment(mut ref self, i: i64) -> i64 {
        let pos = find_char(self.raw, '>', i + 2);
        if pos < 0 {
            return -1;
        }
        let s = hp_text(self.raw, i + 2, pos);
        self.emit(Event.Comment(s));
        pos + 1
    }

    fn parse_pi(mut ref self, i: i64) -> i64 {
        let j = find_char(self.raw, '>', i + 2);
        if j < 0 {
            return -1;
        }
        let s = hp_text(self.raw, i + 2, j);
        self.emit(Event.Pi(s));
        j + 1
    }

    fn parse_starttag(mut ref self, i: i64, ents: ref Map[String, String]) -> i64 {
        self.starttag_text = None;
        let endpos = locate_tag_end(self.raw, i + 1);
        if self.raw[endpos - 1] != '>' {
            return -1;
        }
        self.starttag_text = Some(hp_text(self.raw, i, endpos));
        let n = self.raw.len();

        // tagfind_tolerant
        let mut k = i + 2;
        while k < n and not (hp_is_space(self.raw[k]) or self.raw[k] == '/' or self.raw[k] == '>') {
            k += 1;
        }
        let tag = hp_text(self.raw, i + 1, k).to_lowercase();
        k = skip_attr_gap(self.raw, k);
        self.lasttag = tag.clone();

        let mut attrs: Vec[Attr] = Vec.new();
        while k < endpos {
            // attrfind_tolerant
            if not after_attr_gap(self.raw[k - 1]) {
                break;
            }
            let c = self.raw[k];
            if hp_is_space(c) or c == '/' or c == '>' {
                break;
            }
            let ne = attr_name_end(self.raw, k);
            let name = hp_text(self.raw, k, ne).to_lowercase();
            let mut value: Option[String] = None;
            let mut m = ne;
            match value_indicator(self.raw, ne) {
                Some((vs, ve, e)) => {
                    let mut v = hp_text(self.raw, vs, ve);
                    if ve - vs >= 2 and (self.raw[vs] == '\'' or self.raw[vs] == '"') and self.raw[ve - 1] == self.raw[vs] {
                        v = hp_text(self.raw, vs + 1, ve - 1);
                    }
                    if v.len() > 0 {
                        v = unescape_attr(v, ents);
                    }
                    value = Some(v);
                    m = e;
                }
                None => {}
            }
            attrs.push(Attr { name: name, value: value });
            k = skip_attr_gap(self.raw, m);
        }

        let tail = hp_text(self.raw, k, endpos);
        let end = tail.trim();
        if end != ">" and end != "/>" {
            let s = hp_text(self.raw, i, endpos);
            self.emit(Event.Data(s));
            return endpos;
        }
        if end == "/>" {
            self.emit(Event.StartEnd(tag, attrs));
        } else {
            self.emit(Event.Start(tag.clone(), attrs));
            if is_cdata_content(tag) or tag == "plaintext" {
                self.set_cdata_mode(tag, false);
            } else if tag == "textarea" or tag == "title" {
                self.set_cdata_mode(tag, true);
            }
        }
        endpos
    }

    fn parse_endtag(mut ref self, i: i64) -> i64 {
        let n = self.raw.len();
        if find_char(self.raw, '>', i + 2) < 0 {
            return -1;
        }
        if not (i + 2 < n and hp_is_alpha(self.raw[i + 2])) {
            if self.raw[i + 2] == '>' {
                // "</>" is ignored.
                return i + 3;
            }
            return self.parse_bogus_comment(i);
        }
        let j = locate_tag_end(self.raw, i + 2);
        if self.raw[j - 1] != '>' {
            return -1;
        }
        let mut k = i + 3;
        while k < n and not (hp_is_space(self.raw[k]) or self.raw[k] == '/' or self.raw[k] == '>') {
            k += 1;
        }
        let tag = hp_text(self.raw, i + 2, k).to_lowercase();
        self.emit(Event.End(tag));
        self.clear_cdata_mode();
        j
    }
}

// (?:[\t\n\r\f ]|/(?!>))*
fn skip_attr_gap(raw: ref Vec[char], from: i64) -> i64 {
    let n = raw.len();
    let mut k = from;
    while k < n {
        if hp_is_space(raw[k]) {
            k += 1;
        } else if raw[k] == '/' and not (k + 1 < n and raw[k + 1] == '>') {
            k += 1;
        } else {
            break;
        }
    }
    k
}

fn parse_all(src: ref String, convert: bool, chunk: i64, ents: ref Map[String, String]) -> HtmlParser {
    let mut p = HtmlParser.new(convert);
    let chars = to_chars(src);
    if chunk == 0 {
        p.feed(chars, ents);
    } else {
        let mut k = 0;
        while k < chars.len() {
            let hi = if k + chunk < chars.len() { k + chunk } else { chars.len() };
            let piece: Vec[char] = chars[k..hi].iter().collect();
            p.feed(piece, ents);
            k = hi;
        }
    }
    p.close(ents);
    p
}

// ---------------------------------------------------------------- printing


// ---------------------------------------------------------------- textwrap
// (mini_textwrap's port of Python 3.13's Lib/textwrap.py)

// ------------------------------------------------------------ characters

// textwrap's _whitespace: the only characters its regexes treat as space.
fn is_ws(c: char) -> bool {
    c == ' ' or c == '\t' or c == '\n' or c == '\u{b}' or c == '\u{c}' or c == '\r'
}

// str.isspace, which str.strip and str.split use: Unicode White_Space plus
// the four ASCII separators U+001C..U+001F.
fn py_space(c: char) -> bool {
    c.is_whitespace() or (c >= '\u{1c}' and c <= '\u{1f}')
}

// The regex class \w.
fn tw_is_word(c: char) -> bool {
    c.is_alphanumeric() or c == '_'
}

// textwrap's `letter`, [^\d\W]: a word character that is not a digit.
fn is_letter(c: char) -> bool {
    tw_is_word(c) and not c.is_ascii_digit()
}

// textwrap's `word_punct`, [\w!"'&.,?].
fn is_word_punct(c: char) -> bool {
    tw_is_word(c) or c == '!' or c == '"' or c == '\'' or c == '&' or c == '.' or c == ',' or c == '?'
}

fn chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn tw_text(v: ref Vec[char]) -> String {
    v.iter().collect()
}

fn is_blank(v: ref Vec[char]) -> bool {
    v.iter().all(|c| py_space(*c))
}

fn lstrip(v: ref Vec[char]) -> Vec[char] {
    let mut i = 0;
    while i < v.len() and py_space(v[i]) {
        i += 1;
    }
    v[i..].to_vec()
}

fn rstrip(v: ref Vec[char]) -> Vec[char] {
    let mut n = v.len();
    while n > 0 and py_space(v[n - 1]) {
        n -= 1;
    }
    v[0..n].to_vec()
}

fn concat(parts: ref Vec[Vec[char]]) -> Vec[char] {
    let mut out: Vec[char] = Vec.new();
    for p in parts.iter() {
        for c in p.iter() {
            out.push(*c);
        }
    }
    out
}

fn total_len(parts: ref Vec[Vec[char]]) -> i64 {
    let mut n = 0;
    for p in parts.iter() {
        n += p.len();
    }
    n
}

// str.split() with no argument: runs of whitespace separate the words.
fn py_split(v: ref Vec[char]) -> Vec[Vec[char]] {
    let mut words: Vec[Vec[char]] = Vec.new();
    let mut cur: Vec[char] = Vec.new();
    for c in v.iter() {
        if py_space(*c) {
            if not cur.is_empty() {
                words.push(cur);
                cur = Vec.new();
            }
        } else {
            cur.push(*c);
        }
    }
    if not cur.is_empty() {
        words.push(cur);
    }
    words
}

// str.split(sep) for a one-character separator: always at least one piece.
fn split_on(v: ref Vec[char], sep: char) -> Vec[Vec[char]] {
    let mut pieces: Vec[Vec[char]] = Vec.new();
    let mut cur: Vec[char] = Vec.new();
    for c in v.iter() {
        if *c == sep {
            pieces.push(cur);
            cur = Vec.new();
        } else {
            cur.push(*c);
        }
    }
    pieces.push(cur);
    pieces
}

fn join_on(pieces: ref Vec[Vec[char]], sep: char) -> Vec[char] {
    let mut out: Vec[char] = Vec.new();
    for i in 0..pieces.len() {
        if i > 0 {
            out.push(sep);
        }
        for c in pieces[i].iter() {
            out.push(*c);
        }
    }
    out
}

fn starts_with(v: ref Vec[char], prefix: ref Vec[char]) -> bool {
    if prefix.len() > v.len() {
        return false;
    }
    for i in 0..prefix.len() {
        if v[i] != prefix[i] {
            return false;
        }
    }
    true
}

// ------------------------------------------------------------ TextWrapper

struct Wrapper {
    width: i64,
    initial_indent: Vec[char],
    subsequent_indent: Vec[char],
    expand_tabs: bool,
    tabsize: i64,
    replace_whitespace: bool,
    fix_sentence_endings: bool,
    break_long_words: bool,
    break_on_hyphens: bool,
    drop_whitespace: bool,
    max_lines: Option[i64],
    placeholder: Vec[char],
}

impl Wrapper {
    fn new(width: i64) -> Wrapper {
        Wrapper {
            width: width,
            initial_indent: Vec.new(),
            subsequent_indent: Vec.new(),
            expand_tabs: true,
            tabsize: 8,
            replace_whitespace: true,
            fix_sentence_endings: false,
            break_long_words: true,
            break_on_hyphens: true,
            drop_whitespace: true,
            max_lines: None,
            placeholder: chars(" [...]"),
        }
    }

    // _munge_whitespace: str.expandtabs, then every _whitespace character
    // becomes a space.
    fn munge(ref self, t: ref Vec[char]) -> Vec[char] {
        let mut out: Vec[char] = Vec.new();
        if self.expand_tabs {
            let mut col = 0;
            for c in t.iter() {
                if *c == '\t' {
                    if self.tabsize > 0 {
                        let incr = self.tabsize - col % self.tabsize;
                        for _ in 0..incr {
                            out.push(' ');
                        }
                        col += incr;
                    }
                } else if *c == '\n' or *c == '\r' {
                    out.push(*c);
                    col = 0;
                } else {
                    out.push(*c);
                    col += 1;
                }
            }
        } else {
            out = t.clone();
        }
        if self.replace_whitespace {
            for i in 0..out.len() {
                if is_ws(out[i]) {
                    out[i] = ' ';
                }
            }
        }
        out
    }

    // _split: wordsep_re (or wordsep_simple_re) splits the text into
    // chunks that tile it.
    fn split(ref self, t: ref Vec[char]) -> Vec[Vec[char]] {
        let n = t.len();
        let mut chunks: Vec[Vec[char]] = Vec.new();
        let mut i = 0;
        while i < n {
            let mut end = i;
            if is_ws(t[i]) {
                while end < n and is_ws(t[end]) {
                    end += 1;
                }
            } else if not self.break_on_hyphens {
                while end < n and not is_ws(t[end]) {
                    end += 1;
                }
            } else {
                end = match em_dash_at(t, i) {
                    Some(e) => e,
                    None => word_end(t, i),
                };
            }
            chunks.push(t[i..end].to_vec());
            i = end;
        }
        chunks
    }

    // _fix_sentence_endings
    fn fix_endings(ref self, chunks: mut ref Vec[Vec[char]]) {
        let mut i = 0;
        while i + 1 < chunks.len() {
            if chunks[i + 1] == vec![' '] and sentence_end(chunks[i]) {
                chunks[i + 1] = vec![' ', ' '];
                i += 2;
            } else {
                i += 1;
            }
        }
    }

    // _handle_long_word
    fn handle_long_word(ref self, rev: mut ref Vec[Vec[char]], cur_line: mut ref Vec[Vec[char]], cur_len: i64, width: i64) {
        let space_left = if width < 1 { 1 } else { width - cur_len };
        if self.break_long_words {
            let mut end = space_left;
            let last = rev.len() - 1;
            let chunk = rev[last].clone();
            if self.break_on_hyphens and chunk.len() > space_left {
                // chunk.rfind('-', 0, space_left)
                let mut hyphen = -1;
                let mut k = space_left;
                while k > 0 {
                    k -= 1;
                    if chunk[k] == '-' {
                        hyphen = k;
                        break;
                    }
                }
                if hyphen > 0 and chunk[0..hyphen].iter().any(|c| *c != '-') {
                    end = hyphen + 1;
                }
            }
            if end > chunk.len() {
                end = chunk.len();
            }
            cur_line.push(chunk[0..end].to_vec());
            rev[last] = chunk[end..].to_vec();
        } else if cur_line.is_empty() {
            cur_line.push(rev.pop().unwrap());
        }
    }

    // _wrap_chunks
    fn wrap_chunks(ref self, chunks: own Vec[Vec[char]]) -> Result[Vec[Vec[char]], String] {
        let mut lines: Vec[Vec[char]] = Vec.new();
        if self.width <= 0 {
            return Err(f"invalid width {self.width} (must be > 0)");
        }
        if let Some(ml) = self.max_lines {
            let indent = if ml > 1 { self.subsequent_indent.clone() } else { self.initial_indent.clone() };
            if indent.len() + lstrip(self.placeholder).len() > self.width {
                return Err("placeholder too large for max width".to_string());
            }
        }
        let mut rev = chunks;
        rev.reverse();
        while not rev.is_empty() {
            let mut cur_line: Vec[Vec[char]] = Vec.new();
            let mut cur_len = 0;
            let indent = if lines.is_empty() { self.initial_indent.clone() } else { self.subsequent_indent.clone() };
            let width = self.width - indent.len();
            if self.drop_whitespace and is_blank(rev[rev.len() - 1]) and not lines.is_empty() {
                rev.pop();
            }
            while not rev.is_empty() {
                let l = rev[rev.len() - 1].len();
                if cur_len + l <= width {
                    cur_line.push(rev.pop().unwrap());
                    cur_len += l;
                } else {
                    break;
                }
            }
            if not rev.is_empty() and rev[rev.len() - 1].len() > width {
                self.handle_long_word(mut rev, mut cur_line, cur_len, width);
                cur_len = total_len(cur_line);
            }
            if self.drop_whitespace and not cur_line.is_empty() and is_blank(cur_line[cur_line.len() - 1]) {
                cur_len -= cur_line[cur_line.len() - 1].len();
                cur_line.pop();
            }
            if cur_line.is_empty() {
                continue;
            }
            let fits = match self.max_lines {
                None => true,
                Some(ml) => {
                    lines.len() + 1 < ml
                        or ((rev.is_empty() or (self.drop_whitespace and rev.len() == 1 and is_blank(rev[0]))) and cur_len <= width)
                }
            };
            if fits {
                let mut line = indent.clone();
                for c in concat(cur_line).iter() {
                    line.push(*c);
                }
                lines.push(line);
                continue;
            }
            // Truncate with the placeholder, and stop.
            let mut placed = false;
            while not cur_line.is_empty() {
                if not is_blank(cur_line[cur_line.len() - 1]) and cur_len + self.placeholder.len() <= width {
                    cur_line.push(self.placeholder.clone());
                    let mut line = indent.clone();
                    for c in concat(cur_line).iter() {
                        line.push(*c);
                    }
                    lines.push(line);
                    placed = true;
                    break;
                }
                cur_len -= cur_line[cur_line.len() - 1].len();
                cur_line.pop();
            }
            if not placed {
                let mut done = false;
                if not lines.is_empty() {
                    let last = lines.len() - 1;
                    let prev_line = rstrip(lines[last]);
                    if prev_line.len() + self.placeholder.len() <= self.width {
                        let mut line = prev_line;
                        for c in self.placeholder.iter() {
                            line.push(*c);
                        }
                        lines[last] = line;
                        done = true;
                    }
                }
                if not done {
                    let mut line = indent.clone();
                    for c in lstrip(self.placeholder).iter() {
                        line.push(*c);
                    }
                    lines.push(line);
                }
            }
            break;
        }
        Ok(lines)
    }

    fn wrap(ref self, t: ref Vec[char]) -> Result[Vec[Vec[char]], String] {
        let mut chunks = self.split(self.munge(t));
        if self.fix_sentence_endings {
            self.fix_endings(mut chunks);
        }
        self.wrap_chunks(chunks)
    }

    fn fill(ref self, t: ref Vec[char]) -> Result[Vec[char], String] {
        match self.wrap(t) {
            Ok(lines) => Ok(join_on(lines, '\n')),
            Err(e) => Err(e),
        }
    }
}

// The em-dash alternative of wordsep_re, (?<=word_punct) -{2,} (?=\w),
// tried at i: the end of the dash run.
fn em_dash_at(t: ref Vec[char], i: i64) -> Option[i64] {
    if i == 0 or not is_word_punct(t[i - 1]) {
        return None;
    }
    let mut k = i;
    while k < t.len() and t[k] == '-' {
        k += 1;
    }
    if k - i >= 2 and k < t.len() and tw_is_word(t[k]) {
        Some(k)
    } else {
        None
    }
}

// (?=-{2,}\w) at j.
fn dashes_then_word(t: ref Vec[char], j: i64) -> bool {
    let mut k = j;
    while k < t.len() and t[k] == '-' {
        k += 1;
    }
    k - j >= 2 and k < t.len() and tw_is_word(t[k])
}

// The word alternative of wordsep_re, tried at i (a non-space): the lazy
// \S+? grows one character at a time until one of its three endings
// matches.
fn word_end(t: ref Vec[char], i: i64) -> i64 {
    let n = t.len();
    let mut j = i + 1;
    loop {
        // A hyphen inside a compound word: -(?:(?<=lt{2}-)|(?<=lt-lt-))(?=lt-?lt)
        if j < n and t[j] == '-' {
            let behind = (j >= 2 and is_letter(t[j - 2]) and is_letter(t[j - 1]))
                or (j >= 3 and is_letter(t[j - 3]) and t[j - 2] == '-' and is_letter(t[j - 1]));
            let ahead = j + 1 < n and is_letter(t[j + 1])
                and ((j + 2 < n and is_letter(t[j + 2])) or (j + 3 < n and t[j + 2] == '-' and is_letter(t[j + 3])));
            if behind and ahead {
                return j + 1;
            }
        }
        // The end of the word: (?=ws|\Z)
        if j == n or is_ws(t[j]) {
            return j;
        }
        // An em-dash follows: (?<=word_punct)(?=-{2,}\w)
        if is_word_punct(t[j - 1]) and dashes_then_word(t, j) {
            return j;
        }
        j += 1;
    }
}

// sentence_end_re, [a-z][\.\!\?][\"\']?\Z, searched in a chunk.
fn sentence_end(c: ref Vec[char]) -> bool {
    let mut n = c.len();
    if n > 0 and (c[n - 1] == '"' or c[n - 1] == '\'') {
        n -= 1;
    }
    n >= 2 and c[n - 2] >= 'a' and c[n - 2] <= 'z' and (c[n - 1] == '.' or c[n - 1] == '!' or c[n - 1] == '?')
}


// ---------------------------------------------------------------- strings

fn cps(s: ref String) -> Vec[i64] {
    codepoints(s.bytes())
}

fn py_repr(s: ref String) -> String {
    repr_of(cps(s))
}

// str.isspace.
fn py_isspace(c: char) -> bool {
    c.is_whitespace() or (c >= '\u{1c}' and c <= '\u{1f}')
}

fn char_vec(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn from_chars(v: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut out = String.new();
    let mut i = lo;
    while i < hi {
        out.push(v[i]);
        i += 1;
    }
    out
}

fn in_chars(c: char, set: Str) -> bool {
    for x in set.chars() {
        if x == c {
            return true;
        }
    }
    false
}

// str.strip() / lstrip() / rstrip() with no argument (set "") or with the
// characters of `set`.
fn strip_by(s: ref String, set: Str, left: bool, right: bool) -> String {
    let v = char_vec(s);
    let mut a = 0;
    let mut b = v.len();
    if left {
        while a < b and (if set.is_empty() { py_isspace(v[a]) } else { in_chars(v[a], set) }) {
            a += 1;
        }
    }
    if right {
        while b > a and (if set.is_empty() { py_isspace(v[b - 1]) } else { in_chars(v[b - 1], set) }) {
            b -= 1;
        }
    }
    from_chars(v, a, b)
}

fn py_strip(s: ref String) -> String {
    strip_by(s, "", true, true)
}

fn py_rstrip(s: ref String) -> String {
    strip_by(s, "", false, true)
}

fn char_len(s: ref String) -> i64 {
    s.chars().count()
}

fn repeat(s: Str, n: i64) -> String {
    let mut out = String.new();
    let mut i = 0;
    while i < n {
        out.push_str(s);
        i += 1;
    }
    out
}

// The pieces of s.split("\n").
fn split_nl(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == '\n' {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn ascii_digits(s: ref String) -> bool {
    if s.is_empty() {
        return false;
    }
    for c in s.chars() {
        if c < '0' or c > '9' {
            return false;
        }
    }
    true
}

// int() of ASCII digits, saturating far past any value the callers clamp.
fn digits_int(s: ref String) -> i64 {
    let mut n = 0;
    for c in s.chars() {
        if n < 1000000000000 {
            n = n * 10 + (c as i64 - 48);
        }
    }
    n
}

fn has(v: ref Vec[String], s: Str) -> bool {
    for x in v.iter() {
        if x == s {
            return true;
        }
    }
    false
}

// ---------------------------------------------------------------- the tree

// What bs4 builds: Tag, NavigableString and the string subclasses. Only
// Comment and Doctype are told apart; CData, Declaration, processing
// instructions, Script and Stylesheet strings all behave as text here.
fn k_tag() -> i64 { 0 }
fn k_text() -> i64 { 1 }
fn k_comment() -> i64 { 2 }
fn k_doctype() -> i64 { 3 }

struct DNode {
    kind: i64,
    name: String,
    // attribute names and values, in first-seen order
    attr_names: Vec[String],
    attr_values: Vec[String],
    text: String,
    parent: i64,
    children: Vec[i64],
    // this node's index in its parent's children
    index: i64,
}

struct Soup {
    nodes: Vec[DNode],
}

impl Soup {
    fn is_tag(ref self, n: i64) -> bool {
        n >= 0 and self.nodes[n].kind == k_tag()
    }

    // The tag name, or "" for a string (whose name is None).
    fn name(ref self, n: i64) -> String {
        if self.is_tag(n) { self.nodes[n].name.clone() } else { String.new() }
    }

    fn get(ref self, n: i64, attr: Str) -> Option[String] {
        let node = ref self.nodes[n];
        let mut i = 0;
        while i < node.attr_names.len() {
            if node.attr_names[i] == attr {
                return Some(node.attr_values[i].clone());
            }
            i += 1;
        }
        None
    }

    // attrs.get(attr) or ''
    fn attr_or_empty(ref self, n: i64, attr: Str) -> String {
        self.get(n, attr).unwrap_or(String.new())
    }

    fn parent(ref self, n: i64) -> i64 {
        self.nodes[n].parent
    }

    fn previous_sibling(ref self, n: i64) -> i64 {
        let p = self.nodes[n].parent;
        let i = self.nodes[n].index;
        if p < 0 or i == 0 { -1 } else { self.nodes[p].children[i - 1] }
    }

    fn next_sibling(ref self, n: i64) -> i64 {
        let p = self.nodes[n].parent;
        let i = self.nodes[n].index;
        if p < 0 or i + 1 >= self.nodes[p].children.len() { -1 } else { self.nodes[p].children[i + 1] }
    }

    // find_previous_sibling() with no filter: the nearest earlier Tag.
    fn previous_tag_sibling(ref self, n: i64) -> i64 {
        let mut s = self.previous_sibling(n);
        while s >= 0 and not self.is_tag(s) {
            s = self.previous_sibling(s);
        }
        s
    }

    fn previous_siblings_named(ref self, n: i64, name: Str) -> i64 {
        let mut count = 0;
        let mut s = self.previous_sibling(n);
        while s >= 0 {
            if self.is_tag(s) and self.nodes[s].name == name {
                count += 1;
            }
            s = self.previous_sibling(s);
        }
        count
    }

    fn find_parent(ref self, n: i64, name: Str) -> bool {
        let mut p = self.nodes[n].parent;
        while p >= 0 {
            if self.nodes[p].name == name {
                return true;
            }
            p = self.nodes[p].parent;
        }
        false
    }

    // find_all(names): the descendant tags with one of the names, in
    // document order.
    fn find_all(ref self, n: i64, names: ref Vec[String], out: mut ref Vec[i64]) {
        for c in self.nodes[n].children.iter() {
            if self.is_tag(c) {
                if has(names, self.nodes[c].name.as_str()) {
                    out.push(c);
                }
                self.find_all(c, names, mut out);
            }
        }
    }

    fn find_all_named(ref self, n: i64, name: Str) -> Vec[i64] {
        let names = vec![name.to_string()];
        let mut out: Vec[i64] = Vec.new();
        self.find_all(n, names, mut out);
        out
    }
}

// ---------------------------------------------------------------- building it

fn void_tag(name: ref String) -> bool {
    let v = ["area", "base", "basefont", "bgsound", "br", "col", "command", "embed", "frame", "hr", "image", "img", "input", "isindex", "keygen", "link", "menuitem", "meta", "nextid", "param", "source", "spacer", "track", "wbr"];
    for x in v {
        if name == x {
            return true;
        }
    }
    false
}

// BeautifulSoup's tree construction, fed by BeautifulSoupHTMLParser.
struct Builder {
    soup: Soup,
    stack: Vec[i64],
    open_names: Vec[String],
    open_counts: Vec[i64],
    preserve_ws: Vec[i64],
    current_data: Vec[String],
    already_closed_empty: Vec[String],
}

impl Builder {
    fn new() -> Builder {
        let root = DNode {
            kind: k_tag(),
            name: "[document]".to_string(),
            attr_names: Vec.new(),
            attr_values: Vec.new(),
            text: String.new(),
            parent: -1,
            children: Vec.new(),
            index: 0,
        };
        Builder {
            soup: Soup { nodes: vec![root] },
            stack: vec![0],
            open_names: Vec.new(),
            open_counts: Vec.new(),
            preserve_ws: Vec.new(),
            current_data: Vec.new(),
            already_closed_empty: Vec.new(),
        }
    }

    fn current(ref self) -> i64 {
        self.stack[self.stack.len() - 1]
    }

    fn count_index(mut ref self, name: ref String) -> i64 {
        let mut i = 0;
        while i < self.open_names.len() {
            if self.open_names[i] == name {
                return i;
            }
            i += 1;
        }
        self.open_names.push(name.clone());
        self.open_counts.push(0);
        self.open_names.len() - 1
    }

    fn append(mut ref self, node: own DNode) -> i64 {
        let id = self.soup.nodes.len();
        let parent = node.parent;
        let mut node = node;
        node.index = self.soup.nodes[parent].children.len();
        self.soup.nodes.push(node);
        self.soup.nodes[parent].children.push(id);
        id
    }

    fn end_data(mut ref self, kind: i64) {
        if self.current_data.is_empty() {
            return;
        }
        let mut data = self.current_data.join("");
        self.current_data.clear();
        if self.preserve_ws.is_empty() {
            let mut strippable = true;
            for c in data.chars() {
                if not (c == ' ' or c == '\n' or c == '\t' or c == '\u{c}' or c == '\r') {
                    strippable = false;
                    break;
                }
            }
            if strippable {
                data = if data.contains("\n") { "\n".to_string() } else { " ".to_string() };
            }
        }
        let parent = self.current();
        self.append(DNode { kind: kind, name: String.new(), attr_names: Vec.new(), attr_values: Vec.new(), text: data, parent: parent, children: Vec.new(), index: 0 });
    }

    fn push_tag(mut ref self, name: ref String, names: own Vec[String], values: own Vec[String]) -> i64 {
        let parent = self.current();
        let id = self.append(DNode { kind: k_tag(), name: name.clone(), attr_names: names, attr_values: values, text: String.new(), parent: parent, children: Vec.new(), index: 0 });
        self.stack.push(id);
        let k = self.count_index(name);
        self.open_counts[k] += 1;
        if name == "pre" or name == "textarea" {
            self.preserve_ws.push(id);
        }
        id
    }

    fn pop_tag(mut ref self) {
        if self.stack.len() <= 1 {
            return;
        }
        let id = self.stack.pop().unwrap();
        let name = self.soup.nodes[id].name.clone();
        let k = self.count_index(name);
        self.open_counts[k] -= 1;
        if not self.preserve_ws.is_empty() and self.preserve_ws[self.preserve_ws.len() - 1] == id {
            self.preserve_ws.pop();
        }
    }

    // _popToTag: up to and including the most recent open tag of that
    // name, or nothing when none is open.
    fn pop_to_tag(mut ref self, name: ref String) {
        if name == "[document]" {
            return;
        }
        let mut i = self.stack.len() - 1;
        while i > 0 {
            let k = self.count_index(name);
            if self.open_counts[k] == 0 {
                break;
            }
            let t = self.stack[i];
            let is_it = self.soup.nodes[t].name == name;
            self.pop_tag();
            if is_it {
                break;
            }
            i -= 1;
        }
    }

    fn soup_endtag(mut ref self, name: ref String) {
        self.end_data(k_text());
        self.pop_to_tag(name);
    }

    fn starttag(mut ref self, tag: ref String, attrs: ref Vec[Attr], handle_empty: bool) {
        let mut names: Vec[String] = Vec.new();
        let mut values: Vec[String] = Vec.new();
        for a in attrs.iter() {
            let value = a.value.clone().unwrap_or(String.new());
            let mut found = false;
            let mut i = 0;
            while i < names.len() {
                if names[i] == a.name {
                    values[i] = value.clone();
                    found = true;
                }
                i += 1;
            }
            if not found {
                names.push(a.name.clone());
                values.push(value);
            }
        }
        self.end_data(k_text());
        self.push_tag(tag, names, values);
        if void_tag(tag) and handle_empty {
            self.soup_endtag(tag);
            self.already_closed_empty.push(tag.clone());
        }
    }

    fn endtag(mut ref self, tag: ref String, check_already_closed: bool) {
        if check_already_closed {
            let mut i = 0;
            while i < self.already_closed_empty.len() {
                if self.already_closed_empty[i] == tag {
                    self.already_closed_empty.remove(i);
                    return;
                }
                i += 1;
            }
        }
        self.soup_endtag(tag);
    }

    fn data(mut ref self, s: ref String) {
        self.current_data.push(s.clone());
    }

    fn special(mut ref self, s: ref String, kind: i64) {
        self.end_data(k_text());
        self.data(s);
        self.end_data(kind);
    }

    fn event(mut ref self, ev: ref Event, ents: ref Map[String, String]) {
        match ev {
            Event.Start(tag, attrs) => self.starttag(tag, attrs, true),
            Event.StartEnd(tag, attrs) => {
                self.starttag(tag, attrs, false);
                self.endtag(tag, false);
            }
            Event.End(tag) => self.endtag(tag, true),
            Event.Data(s) => self.data(s),
            Event.CharRef(name) => {
                let (deref, extra) = dereference(name);
                self.data(deref);
                self.data(extra);
            }
            Event.EntityRef(name) => {
                let semi = f"{name};";
                let text = match ents.get(semi) {
                    Some(t) => t.clone(),
                    None => match ents.get(name.clone()) {
                        Some(t) => t.clone(),
                        None => f"&{name}",
                    },
                };
                self.data(text);
            }
            Event.Comment(s) => self.special(s, k_comment()),
            Event.Decl(s) => {
                let v = char_vec(s);
                let rest = if v.len() > 8 { from_chars(v, 8, v.len()) } else { String.new() };
                self.special(rest, k_doctype());
            }
            Event.UnknownDecl(s) => {
                let v = char_vec(s);
                let up = s.to_uppercase();
                let rest = if up.starts_with("CDATA[") { from_chars(v, 6, v.len()) } else { s.clone() };
                self.special(rest, k_text());
            }
            Event.Pi(s) => self.special(s, k_text()),
        }
    }
}

fn cp1252(n: i64) -> i64 {
    let table = [0x20AC, -1, 0x201A, 0x0192, 0x201E, 0x2026, 0x2020, 0x2021, 0x02C6, 0x2030, 0x0160, 0x2039, 0x0152, -1, 0x017D, -1, -1, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014, 0x02DC, 0x2122, 0x0161, 0x203A, 0x0153, -1, 0x017E, 0x0178];
    let v = table[n - 0x80];
    if v < 0 { n } else { v }
}

// _dereference_numeric_character_reference and
// UnicodeDammit.numeric_character_reference.
fn dereference(name: ref String) -> (String, String) {
    let v = char_vec(name);
    let mut base = 10;
    let mut start = 0;
    if v.len() > 0 and (v[0] == 'x' or v[0] == 'X') {
        base = 16;
        start = 1;
    }
    let mut n = 0;
    let mut k = start;
    while k < v.len() {
        let c = v[k];
        let d = if c >= '0' and c <= '9' { c as i64 - 48 } else if base == 16 and c >= 'a' and c <= 'f' { c as i64 - 87 } else if base == 16 and c >= 'A' and c <= 'F' { c as i64 - 55 } else { -1 };
        if d < 0 {
            break;
        }
        if n <= 0x10FFFF {
            n = n * base + d;
        }
        k += 1;
    }
    if k == start {
        return (String.new(), from_chars(v, start, v.len()));
    }
    let extra = from_chars(v, k, v.len());
    let replacement = "\u{fffd}".to_string();
    if n == 0 or n > 0x10FFFF or (n >= 0xD800 and n <= 0xDFFF) {
        return (replacement, extra);
    }
    let code = if n >= 0x80 and n <= 0x9F { cp1252(n) } else { n };
    match as_char(code) {
        Some(c) => (c.to_string(), extra),
        None => (replacement, extra),
    }
}

// BeautifulSoup(html, "html.parser").
fn parse_soup(html: ref String, ents: ref Map[String, String]) -> Soup {
    let mut p = HtmlParser.new(false);
    p.feed(to_chars(html), ents);
    p.close(ents);
    let mut b = Builder.new();
    for e in p.events.iter() {
        b.event(e.ev, ents);
    }
    b.end_data(k_text());
    while b.stack.len() > 1 {
        b.pop_tag();
    }
    b.soup
}

// ---------------------------------------------------------------- options

#[derive(Clone)]
struct Options {
    autolinks: bool,
    bullets: String,
    code_language: String,
    convert: Option[Vec[String]],
    default_title: bool,
    escape_asterisks: bool,
    escape_underscores: bool,
    escape_misc: bool,
    heading_style: String,
    keep_inline_images_in: Vec[String],
    newline_style: String,
    strip: Option[Vec[String]],
    strip_document: Option[String],
    strip_pre: Option[String],
    strong_em_symbol: String,
    sub_symbol: String,
    sup_symbol: String,
    table_infer_header: bool,
    wrap: bool,
    wrap_width: Option[i64],
}

// MarkdownConverter.DefaultOptions.
fn default_options() -> Options {
    Options {
        autolinks: true,
        bullets: "*+-".to_string(),
        code_language: String.new(),
        convert: None,
        default_title: false,
        escape_asterisks: true,
        escape_underscores: true,
        escape_misc: false,
        heading_style: "underlined".to_string(),
        keep_inline_images_in: Vec.new(),
        newline_style: "spaces".to_string(),
        strip: None,
        strip_document: Some("strip".to_string()),
        strip_pre: Some("strip".to_string()),
        strong_em_symbol: "*".to_string(),
        sub_symbol: String.new(),
        sup_symbol: String.new(),
        table_infer_header: false,
        wrap: false,
        wrap_width: Some(80),
    }
}

// The regexes the converter needs a real engine for.
struct Res {
    misc_chars: Program,
    misc_dashes: Program,
    misc_hashes: Program,
    misc_list_items: Program,
    pre_lstrip1: Program,
    pre_rstrip1: Program,
    pre_lstrip: Program,
    pre_rstrip: Program,
    // the replacement templates, parsed
    repl_one: Vec[Piece],
    repl_two: Vec[Piece],
    repl_none: Vec[Piece],
}

fn fixed(p: Str) -> Result[Program, String] {
    match compile(cp(p), 0) {
        Ok(prog) => Ok(prog),
        Err(e) => Err(f"cannot compile {p}: {err_text(e)}"),
    }
}

fn template(t: Str, prog: ref Program) -> Result[Vec[Piece], String] {
    match parse_template(cp(t), prog) {
        Ok(p) => Ok(p),
        Err(e) => Err(f"bad template {t}: {err_text(e)}"),
    }
}

fn new_res() -> Result[Res, String] {
    let misc_chars = fixed("([]\\\\&<`[>~=+|])")?;
    let misc_dashes = fixed("(\\s|^)(-+(?:\\s|$))")?;
    let repl_one = template("\\\\\\1", misc_chars)?;
    let repl_two = template("\\1\\\\\\2", misc_dashes)?;
    let repl_none = template("", misc_dashes)?;
    Ok(Res {
        misc_chars: misc_chars,
        misc_dashes: misc_dashes,
        misc_hashes: fixed("(\\s|^)(#{1,6}(?:\\s|$))")?,
        misc_list_items: fixed("((?:\\s|^)[0-9]{1,9})([.)](?:\\s|$))")?,
        pre_lstrip1: fixed("^ *\\n")?,
        pre_rstrip1: fixed("\\n *$")?,
        pre_lstrip: fixed("^[ \\n]*\\n")?,
        pre_rstrip: fixed("[ \\n]*$")?,
        repl_one: repl_one,
        repl_two: repl_two,
        repl_none: repl_none,
    })
}

// re.sub(prog, template, s).
fn re_sub(prog: ref Program, pieces: ref Vec[Piece], s: ref String) -> String {
    let c = cps(s);
    let ms = all_matches(prog, c, 0);
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    for m in ms.iter() {
        push_all(mut out, slice(c, i, m.start));
        expand(pieces, c, m, mut out);
        i = m.end;
    }
    push_all(mut out, slice(c, i, c.len()));
    to_string(out)
}

// ---------------------------------------------------------------- whitespace

// re_whitespace.sub(' ', ...): runs of tabs and spaces.
fn squeeze_blanks(s: ref String) -> String {
    let mut out = String.new();
    let mut in_run = false;
    for c in s.chars() {
        if c == ' ' or c == '\t' {
            if not in_run {
                out.push(' ');
            }
            in_run = true;
        } else {
            out.push(c);
            in_run = false;
        }
    }
    out
}

fn is_ws4(c: char) -> bool {
    c == ' ' or c == '\t' or c == '\r' or c == '\n'
}

// re_all_whitespace.sub(' ', ...), and re_newline_whitespace.sub('\n',
// ...) (a run of [\t \r\n] with a line break in it) when `newlines`.
fn squeeze_ws(s: ref String, newlines: bool) -> String {
    let v = char_vec(s);
    let mut out = String.new();
    let mut i = 0;
    while i < v.len() {
        if is_ws4(v[i]) {
            let mut j = i;
            let mut has_break = false;
            while j < v.len() and is_ws4(v[j]) {
                if v[j] == '\n' or v[j] == '\r' {
                    has_break = true;
                }
                j += 1;
            }
            if not newlines {
                out.push(' ');
            } else if has_break {
                out.push('\n');
            } else {
                out.push_str(from_chars(v, i, j));
            }
            i = j;
        } else {
            out.push(v[i]);
            i += 1;
        }
    }
    out
}

// re_extract_newlines: (leading newlines, content, trailing newlines).
fn extract_newlines(s: ref String) -> (String, String, String) {
    let v = char_vec(s);
    let mut a = 0;
    while a < v.len() and v[a] == '\n' {
        a += 1;
    }
    let mut b = v.len();
    while b > a and v[b - 1] == '\n' {
        b -= 1;
    }
    (from_chars(v, 0, a), from_chars(v, a, b), from_chars(v, b, v.len()))
}

// re_line_with_content.sub(fn, text): fn is applied to every line.
fn indent_lines(text: ref String, prefix: Str, empty: Str) -> String {
    let lines = split_nl(text);
    let mut out: Vec[String] = Vec.new();
    for line in lines.iter() {
        if line.is_empty() {
            out.push(empty.to_string());
        } else {
            out.push(f"{prefix}{line}");
        }
    }
    out.join("\n")
}

// strip_pre and strip1_pre: two re.sub calls each.
fn strip_pre_all(re: ref Res, text: ref String) -> String {
    re_sub(re.pre_rstrip, re.repl_none, re_sub(re.pre_lstrip, re.repl_none, text))
}

fn strip_pre_one(re: ref Res, text: ref String) -> String {
    re_sub(re.pre_rstrip1, re.repl_none, re_sub(re.pre_lstrip1, re.repl_none, text))
}

// chomp: (prefix, suffix, stripped text).
fn chomp(text: ref String) -> (String, String, String) {
    let prefix = if text.starts_with(" ") { " ".to_string() } else { String.new() };
    let suffix = if text.ends_with(" ") { " ".to_string() } else { String.new() };
    (prefix, suffix, py_strip(text))
}

// re_html_heading.match(name): the N of hN.
fn heading_level(name: ref String) -> Option[i64] {
    let v = char_vec(name);
    if v.len() < 2 or v[0] != 'h' {
        return None;
    }
    let mut k = 1;
    while k < v.len() and v[k] >= '0' and v[k] <= '9' {
        k += 1;
    }
    if k == 1 {
        return None;
    }
    Some(digits_int(from_chars(v, 1, k)))
}

fn should_remove_whitespace_inside(s: ref Soup, el: i64) -> bool {
    if el < 0 or not s.is_tag(el) {
        return false;
    }
    let name = s.name(el);
    if heading_level(name).is_some() {
        return true;
    }
    let block = ["p", "blockquote", "article", "div", "section", "ol", "ul", "li", "dl", "dt", "dd", "table", "thead", "tbody", "tfoot", "tr", "td", "th"];
    for b in block {
        if name == b {
            return true;
        }
    }
    false
}

fn should_remove_whitespace_outside(s: ref Soup, el: i64) -> bool {
    should_remove_whitespace_inside(s, el) or (s.is_tag(el) and s.name(el) == "pre")
}

fn is_block_content(s: ref Soup, el: i64) -> bool {
    if el < 0 {
        return false;
    }
    let k = s.nodes[el].kind;
    if k == k_tag() {
        true
    } else if k == k_comment() or k == k_doctype() {
        false
    } else {
        not py_strip(s.nodes[el].text).is_empty()
    }
}

fn next_block_content_sibling(s: ref Soup, el: i64) -> i64 {
    let mut e = el;
    while e >= 0 {
        e = s.next_sibling(e);
        if is_block_content(s, e) {
            return e;
        }
    }
    -1
}

// ---------------------------------------------------------------- the converter

struct Conv {
    o: Options,
    re: Res,
}

fn new_conv(o: own Options, re: own Res) -> Result[Conv, String] {
    if o.strip.is_some() and o.convert.is_some() {
        return Err("ValueError: You may specify either tags to strip or tags to convert, but not both.".to_string());
    }
    Ok(Conv { o: o, re: re })
}

impl Conv {
    fn process_element(ref self, s: ref Soup, node: i64, parent_tags: ref Vec[String]) -> Result[String, String] {
        if s.is_tag(node) {
            self.process_tag(s, node, parent_tags)
        } else {
            Ok(self.process_text(s, node, parent_tags))
        }
    }

    fn can_ignore(ref self, s: ref Soup, el: i64, remove_inside: bool) -> bool {
        let k = s.nodes[el].kind;
        if k == k_tag() {
            return false;
        }
        if k == k_comment() or k == k_doctype() {
            return true;
        }
        if not py_strip(s.nodes[el].text).is_empty() {
            return false;
        }
        let prev = s.previous_sibling(el);
        let next = s.next_sibling(el);
        if remove_inside and (prev < 0 or next < 0) {
            return true;
        }
        should_remove_whitespace_outside(s, prev) or should_remove_whitespace_outside(s, next)
    }

    fn process_tag(ref self, s: ref Soup, node: i64, parent_tags: ref Vec[String]) -> Result[String, String] {
        let remove_inside = should_remove_whitespace_inside(s, node);
        let mut children: Vec[i64] = Vec.new();
        for c in s.nodes[node].children.iter() {
            if not self.can_ignore(s, c, remove_inside) {
                children.push(c);
            }
        }
        let name = s.name(node);
        let mut tags = parent_tags.clone();
        tags.push(name.clone());
        if heading_level(name).is_some() or name == "td" or name == "th" {
            tags.push("_inline".to_string());
        }
        if name == "pre" or name == "code" or name == "kbd" or name == "samp" {
            tags.push("_noformat".to_string());
        }
        let mut child_strings: Vec[String] = Vec.new();
        for c in children.iter() {
            let t = self.process_element(s, c, tags)?;
            if not t.is_empty() {
                child_strings.push(t);
            }
        }
        if not (name == "pre" or s.find_parent(node, "pre")) {
            let mut updated: Vec[String] = vec![String.new()];
            for cs in child_strings.iter() {
                let (lead, content, trail) = extract_newlines(cs);
                let mut lead = lead;
                if not updated[updated.len() - 1].is_empty() and not lead.is_empty() {
                    let prev = updated.pop().unwrap();
                    let a = char_len(prev);
                    let b = char_len(lead);
                    let n = if a > b { a } else { b };
                    lead = repeat("\n", if n < 2 { n } else { 2 });
                }
                updated.push(lead);
                updated.push(content);
                updated.push(trail);
            }
            child_strings = updated;
        }
        let text = child_strings.join("");
        self.convert_tag(s, node, name, text, parent_tags)
    }

    fn process_text(ref self, s: ref Soup, el: i64, parent_tags: ref Vec[String]) -> String {
        let mut text = s.nodes[el].text.clone();
        if not has(parent_tags, "pre") {
            if self.o.wrap {
                text = squeeze_ws(text, false);
            } else {
                text = squeeze_ws(text, true);
                text = squeeze_blanks(text);
            }
        }
        if not has(parent_tags, "_noformat") {
            text = self.escape(text);
        }
        let prev = s.previous_sibling(el);
        let next = s.next_sibling(el);
        let parent = s.parent(el);
        if should_remove_whitespace_outside(s, prev) or (should_remove_whitespace_inside(s, parent) and prev < 0) {
            text = strip_by(text, " \t\r\n", true, false);
        }
        if should_remove_whitespace_outside(s, next) or (should_remove_whitespace_inside(s, parent) and next < 0) {
            text = py_rstrip(text);
        }
        text
    }

    fn should_convert_tag(ref self, tag: ref String) -> bool {
        match self.o.strip {
            Some(ref list) => not has(list, tag.as_str()),
            None => match self.o.convert {
                Some(ref list) => has(list, tag.as_str()),
                None => true,
            },
        }
    }

    // get_conv_fn: the convert_<name> method, or convert_hN, applied.
    fn convert_tag(ref self, s: ref Soup, el: i64, name: ref String, text: ref String, parent_tags: ref Vec[String]) -> Result[String, String] {
        let lower = name.to_lowercase();
        if not self.should_convert_tag(lower) {
            return Ok(text.clone());
        }
        let inline = has(parent_tags, "_inline");
        let noformat = has(parent_tags, "_noformat");
        let t = lower.as_str();
        if t == "[document]" {
            return self.convert_document(text);
        } else if t == "a" {
            return Ok(self.convert_a(s, el, text, noformat));
        } else if t == "b" or t == "strong" {
            let sym = f"{self.o.strong_em_symbol}{self.o.strong_em_symbol}";
            return Ok(inline_conversion(sym, text, noformat));
        } else if t == "em" or t == "i" {
            return Ok(inline_conversion(self.o.strong_em_symbol, text, noformat));
        } else if t == "del" or t == "s" {
            return Ok(inline_conversion("~~".to_string(), text, noformat));
        } else if t == "sub" {
            return Ok(inline_conversion(self.o.sub_symbol, text, noformat));
        } else if t == "sup" {
            return Ok(inline_conversion(self.o.sup_symbol, text, noformat));
        } else if t == "blockquote" {
            return Ok(convert_blockquote(text, inline));
        } else if t == "br" {
            return Ok(self.convert_br(text, inline));
        } else if t == "code" or t == "kbd" or t == "samp" {
            return Ok(convert_code(text, noformat));
        } else if t == "div" or t == "article" or t == "section" or t == "dl" {
            return Ok(convert_div(text, inline));
        } else if t == "dd" {
            return Ok(convert_dd(text, inline));
        } else if t == "dt" {
            return Ok(convert_dt(text, inline));
        } else if t == "hr" {
            return Ok("\n\n---\n\n".to_string());
        } else if t == "img" {
            return Ok(self.convert_img(s, el, inline));
        } else if t == "video" {
            return Ok(self.convert_video(s, el, text, inline));
        } else if t == "list" or t == "ul" or t == "ol" {
            return Ok(convert_list(s, el, text, parent_tags));
        } else if t == "li" {
            return Ok(self.convert_li(s, el, text));
        } else if t == "p" {
            return self.convert_p(text, inline);
        } else if t == "pre" {
            return self.convert_pre(text);
        } else if t == "q" {
            return Ok(f"\"{text}\"");
        } else if t == "script" or t == "style" {
            return Ok(String.new());
        } else if t == "table" {
            return Ok(f"\n\n{py_strip(text)}\n\n");
        } else if t == "caption" {
            return Ok(f"{py_strip(text)}\n\n");
        } else if t == "figcaption" {
            return Ok(f"\n\n{py_strip(text)}\n\n");
        } else if t == "td" or t == "th" {
            return Ok(convert_cell(s, el, text));
        } else if t == "tr" {
            return Ok(self.convert_tr(s, el, text));
        }
        match heading_level(lower) {
            Some(n) => Ok(self.convert_hn(n, text, inline)),
            None => Ok(text.clone()),
        }
    }

    fn convert_document(ref self, text: ref String) -> Result[String, String] {
        match self.o.strip_document {
            None => Ok(text.clone()),
            Some(ref mode) => {
                if mode == "lstrip" {
                    Ok(strip_by(text, "\n", true, false))
                } else if mode == "rstrip" {
                    Ok(strip_by(text, "\n", false, true))
                } else if mode == "strip" {
                    Ok(strip_by(text, "\n", true, true))
                } else {
                    Err(f"ValueError: Invalid value for strip_document: {mode}")
                }
            }
        }
    }

    fn escape(ref self, text: ref String) -> String {
        if text.is_empty() {
            return String.new();
        }
        let mut t = text.clone();
        if self.o.escape_misc {
            t = re_sub(self.re.misc_chars, self.re.repl_one, t);
            t = re_sub(self.re.misc_dashes, self.re.repl_two, t);
            t = re_sub(self.re.misc_hashes, self.re.repl_two, t);
            t = re_sub(self.re.misc_list_items, self.re.repl_two, t);
        }
        if self.o.escape_asterisks {
            t = t.replace("*", "\\*");
        }
        if self.o.escape_underscores {
            t = t.replace("_", "\\_");
        }
        t
    }

    fn convert_a(ref self, s: ref Soup, el: i64, text: ref String, noformat: bool) -> String {
        if noformat {
            return text.clone();
        }
        let (prefix, suffix, text) = chomp(text);
        if text.is_empty() {
            return String.new();
        }
        let href = s.get(el, "href");
        let mut title = s.get(el, "title");
        let title_empty = match title {
            Some(ref t) => t.is_empty(),
            None => true,
        };
        if self.o.autolinks and title_empty and not self.o.default_title {
            if let Some(ref h) = href {
                if text.replace("\\_", "_") == h {
                    return f"<{h}>";
                }
            }
        }
        if self.o.default_title and title_empty {
            title = href.clone();
        }
        let title_part = match title {
            Some(ref t) => if t.is_empty() { String.new() } else { f" \"{t.replace("\"", "\\\"")}\"" },
            None => String.new(),
        };
        match href {
            Some(ref h) => if h.is_empty() { text } else { f"{prefix}[{text}]({h}{title_part}){suffix}" },
            None => text,
        }
    }

    fn convert_br(ref self, text: ref String, inline: bool) -> String {
        if inline {
            return if text.is_empty() { " ".to_string() } else { f"{text} " };
        }
        if self.o.newline_style.to_lowercase() == "backslash" {
            f"\\\n{text}"
        } else {
            f"  \n{text}"
        }
    }

    fn convert_hn(ref self, n: i64, text: ref String, inline: bool) -> String {
        if inline {
            return text.clone();
        }
        let n = if n < 1 { 1 } else if n > 6 { 6 } else { n };
        let style = self.o.heading_style.to_lowercase();
        let text = py_strip(text);
        if style == "underlined" and n <= 2 {
            return underline(text, if n == 1 { "=" } else { "-" });
        }
        let text = squeeze_ws(text, false);
        let hashes = repeat("#", n);
        if style == "atx_closed" {
            return f"\n\n{hashes} {text} {hashes}\n\n";
        }
        f"\n\n{hashes} {text}\n\n"
    }

    fn convert_img(ref self, s: ref Soup, el: i64, inline: bool) -> String {
        let alt = s.attr_or_empty(el, "alt");
        let src = s.attr_or_empty(el, "src");
        let title = s.attr_or_empty(el, "title");
        let title_part = if title.is_empty() { String.new() } else { f" \"{title.replace("\"", "\\\"")}\"" };
        if inline and not has(self.o.keep_inline_images_in, s.name(s.parent(el)).as_str()) {
            return alt;
        }
        f"![{alt}]({src}{title_part})"
    }

    fn convert_video(ref self, s: ref Soup, el: i64, text: ref String, inline: bool) -> String {
        if inline and not has(self.o.keep_inline_images_in, s.name(s.parent(el)).as_str()) {
            return text.clone();
        }
        let mut src = s.attr_or_empty(el, "src");
        if src.is_empty() {
            for c in s.find_all_named(el, "source").iter() {
                if s.get(c, "src").is_some() {
                    src = s.attr_or_empty(c, "src");
                    break;
                }
            }
        }
        let poster = s.attr_or_empty(el, "poster");
        if not src.is_empty() and not poster.is_empty() {
            return f"[![{text}]({poster})]({src})";
        }
        if not src.is_empty() {
            return f"[{text}]({src})";
        }
        if not poster.is_empty() {
            return f"![{text}]({poster})";
        }
        text.clone()
    }

    fn convert_li(ref self, s: ref Soup, el: i64, text: ref String) -> String {
        let text = py_strip(text);
        if text.is_empty() {
            return "\n".to_string();
        }
        let parent = s.parent(el);
        let mut bullet = if parent >= 0 and s.name(parent) == "ol" {
            let start_attr = s.get(parent, "start").unwrap_or(String.new());
            let start = if ascii_digits(start_attr) { digits_int(start_attr) } else { 1 };
            f"{start + s.previous_siblings_named(el, "li")}."
        } else {
            let mut depth = -1;
            let mut e = el;
            while e >= 0 {
                if s.name(e) == "ul" {
                    depth += 1;
                }
                e = s.parent(e);
            }
            let bullets = char_vec(self.o.bullets);
            let n = bullets.len();
            let k = ((depth % n) + n) % n;
            bullets[k].to_string()
        };
        bullet.push(' ');
        let width = char_len(bullet);
        let indent = repeat(" ", width);
        let text = indent_lines(text, indent.as_str(), "");
        let v = char_vec(text);
        let rest = if width < v.len() { from_chars(v, width, v.len()) } else { String.new() };
        f"{bullet}{rest}\n"
    }

    fn convert_p(ref self, text: ref String, inline: bool) -> Result[String, String] {
        if inline {
            return Ok(f" {strip_by(text, " \t\r\n", true, true)} ");
        }
        let mut text = strip_by(text, " \t\r\n", true, true);
        if self.o.wrap {
            if let Some(width) = self.o.wrap_width {
                let mut new_lines: Vec[String] = Vec.new();
                for line in split_nl(text).iter() {
                    let line = strip_by(line, " \t\r\n", true, false);
                    let kept = py_rstrip(line);
                    let lv = char_vec(line);
                    let trailing = from_chars(lv, char_len(kept), lv.len());
                    let mut w = Wrapper.new(width);
                    w.break_long_words = false;
                    w.break_on_hyphens = false;
                    let filled = w.fill(char_vec(line))?;
                    new_lines.push(f"{tw_text(filled)}{trailing}");
                }
                text = new_lines.join("\n");
            }
        }
        Ok(if text.is_empty() { String.new() } else { f"\n\n{text}\n\n" })
    }

    fn convert_pre(ref self, text: ref String) -> Result[String, String] {
        if text.is_empty() {
            return Ok(String.new());
        }
        let body = match self.o.strip_pre {
            None => text.clone(),
            Some(ref mode) => {
                if mode == "strip" {
                    strip_pre_all(self.re, text)
                } else if mode == "strip_one" {
                    strip_pre_one(self.re, text)
                } else {
                    return Err(f"ValueError: Invalid value for strip_pre: {mode}");
                }
            }
        };
        Ok(f"\n\n```{self.o.code_language}\n{body}\n```\n\n")
    }

    fn convert_tr(ref self, s: ref Soup, el: i64, text: ref String) -> String {
        let names = vec!["td".to_string(), "th".to_string()];
        let mut cells: Vec[i64] = Vec.new();
        s.find_all(el, names, mut cells);
        let parent = s.parent(el);
        let pname = s.name(parent);
        let is_first_row = s.previous_tag_sibling(el) < 0;
        let mut all_th = true;
        for c in cells.iter() {
            if s.name(c) != "th" {
                all_th = false;
            }
        }
        let is_headrow = all_th or (pname == "thead" and s.find_all_named(parent, "tr").len() == 1);
        let missing = (is_first_row and pname != "tbody")
            or (is_first_row and pname == "tbody" and s.find_all_named(s.parent(parent), "thead").len() < 1);
        let mut full_colspan = 0;
        for c in cells.iter() {
            full_colspan += colspan_of(s, c);
        }
        let mut overline = String.new();
        let mut underline = String.new();
        if (is_headrow or (missing and self.o.table_infer_header)) and is_first_row {
            underline = f"| {repeat_join("---", full_colspan)} |\n";
        } else if (missing and not self.o.table_infer_header)
            or (is_first_row and (pname == "table" or (pname == "tbody" and s.previous_tag_sibling(parent) < 0))) {
            overline = f"| {repeat_join("", full_colspan)} |\n";
            overline.push_str(f"| {repeat_join("---", full_colspan)} |\n");
        }
        f"{overline}|{text}\n{underline}"
    }
}

// ' | '.join([s] * n)
fn repeat_join(s: Str, n: i64) -> String {
    let mut parts: Vec[String] = Vec.new();
    let mut i = 0;
    while i < n {
        parts.push(s.to_string());
        i += 1;
    }
    parts.join(" | ")
}

// abstract_inline_conversion
fn inline_conversion(markup: ref String, text: ref String, noformat: bool) -> String {
    let suffix_markup = if markup.starts_with("<") and markup.ends_with(">") {
        let v = char_vec(markup);
        f"</{from_chars(v, 1, v.len())}"
    } else {
        markup.clone()
    };
    if noformat {
        return text.clone();
    }
    let (prefix, suffix, text) = chomp(text);
    if text.is_empty() {
        return String.new();
    }
    f"{prefix}{markup}{text}{suffix_markup}{suffix}"
}

fn underline(text: ref String, pad: Str) -> String {
    let text = py_rstrip(text);
    if text.is_empty() {
        return String.new();
    }
    f"\n\n{text}\n{repeat(pad, char_len(text))}\n\n"
}

fn convert_blockquote(text: ref String, inline: bool) -> String {
    let text = strip_by(text, " \t\r\n", true, true);
    if inline {
        return f" {text} ";
    }
    if text.is_empty() {
        return "\n".to_string();
    }
    f"\n{indent_lines(text, "> ", ">")}\n\n"
}

fn convert_code(text: ref String, noformat: bool) -> String {
    if noformat {
        return text.clone();
    }
    let (prefix, suffix, text) = chomp(text);
    if text.is_empty() {
        return String.new();
    }
    let mut max = 0;
    let mut run = 0;
    for c in text.chars() {
        if c == '`' {
            run += 1;
            if run > max {
                max = run;
            }
        } else {
            run = 0;
        }
    }
    let delim = repeat("`", max + 1);
    let body = if max > 0 { f" {text} " } else { text };
    f"{prefix}{delim}{body}{delim}{suffix}"
}

fn convert_div(text: ref String, inline: bool) -> String {
    if inline {
        return f" {py_strip(text)} ";
    }
    let text = py_strip(text);
    if text.is_empty() { String.new() } else { f"\n\n{text}\n\n" }
}

fn convert_dd(text: ref String, inline: bool) -> String {
    let text = py_strip(text);
    if inline {
        return f" {text} ";
    }
    if text.is_empty() {
        return "\n".to_string();
    }
    let text = indent_lines(text, "    ", "");
    let v = char_vec(text);
    f":{from_chars(v, 1, v.len())}\n"
}

fn convert_dt(text: ref String, inline: bool) -> String {
    let text = squeeze_ws(py_strip(text), false);
    if inline {
        return f" {text} ";
    }
    if text.is_empty() {
        return "\n".to_string();
    }
    f"\n\n{text}\n"
}

fn convert_list(s: ref Soup, el: i64, text: ref String, parent_tags: ref Vec[String]) -> String {
    let next = next_block_content_sibling(s, el);
    let before_paragraph = next >= 0 and not (s.name(next) == "ul" or s.name(next) == "ol");
    if has(parent_tags, "li") {
        return f"\n{py_rstrip(text)}";
    }
    f"\n\n{text}{if before_paragraph { "\n" } else { "" }}"
}

fn colspan_of(s: ref Soup, el: i64) -> i64 {
    match s.get(el, "colspan") {
        Some(v) => {
            if ascii_digits(v) {
                let n = digits_int(v);
                if n < 1 { 1 } else if n > 1000 { 1000 } else { n }
            } else {
                1
            }
        }
        None => 1,
    }
}

fn convert_cell(s: ref Soup, el: i64, text: ref String) -> String {
    let n = colspan_of(s, el);
    f" {py_strip(text).replace("\n", " ")}{repeat(" |", n)}"
}

// markdownify(html, **options)
fn markdownify(html: ref String, o: own Options, ents: ref Map[String, String]) -> Result[String, String] {
    let re = new_res()?;
    let conv = new_conv(o, re)?;
    let soup = parse_soup(html, ents);
    let tags: Vec[String] = Vec.new();
    conv.process_tag(soup, 0, tags)
}

// ---------------------------------------------------------------- the jobs

fn field(s: ref String) -> String {
    s.replace("∅", "").replace("⏎", "\n").replace("⇥", "\t").replace("␣", " ")
}

fn list_value(v: ref String) -> Vec[String] {
    if v.is_empty() {
        return Vec.new();
    }
    v.split(",").map(|p| p.to_string()).collect()
}

// One line of data/options.tsv: a name, then key=value fields typed by
// their first letter (s, b, i, n, l).
fn parse_options(line: ref String) -> Result[(String, Options), String] {
    let fields: Vec[String] = line.split("\t").map(|p| p.to_string()).collect();
    let mut o = default_options();
    let mut k = 1;
    while k < fields.len() {
        let (key, typed) = match fields[k].split_once("=") {
            Some((a, b)) => (a.to_string(), b.to_string()),
            None => return Err(f"bad option field {fields[k]}"),
        };
        let tv: Vec[char] = typed.chars().collect();
        let kind = tv[0];
        let v = from_chars(tv, 2, tv.len());
        let b = v == "1";
        if key == "autolinks" {
            o.autolinks = b;
        } else if key == "bullets" {
            o.bullets = v;
        } else if key == "code_language" {
            o.code_language = v;
        } else if key == "convert" {
            o.convert = if kind == 'n' { None } else { Some(list_value(v)) };
        } else if key == "default_title" {
            o.default_title = b;
        } else if key == "escape_asterisks" {
            o.escape_asterisks = b;
        } else if key == "escape_underscores" {
            o.escape_underscores = b;
        } else if key == "escape_misc" {
            o.escape_misc = b;
        } else if key == "heading_style" {
            o.heading_style = v;
        } else if key == "keep_inline_images_in" {
            o.keep_inline_images_in = list_value(v);
        } else if key == "newline_style" {
            o.newline_style = v;
        } else if key == "strip" {
            o.strip = if kind == 'n' { None } else { Some(list_value(v)) };
        } else if key == "strip_document" {
            o.strip_document = if kind == 'n' { None } else { Some(v) };
        } else if key == "strip_pre" {
            o.strip_pre = if kind == 'n' { None } else { Some(v) };
        } else if key == "strong_em_symbol" {
            o.strong_em_symbol = v;
        } else if key == "sub_symbol" {
            o.sub_symbol = v;
        } else if key == "sup_symbol" {
            o.sup_symbol = v;
        } else if key == "table_infer_header" {
            o.table_infer_header = b;
        } else if key == "wrap" {
            o.wrap = b;
        } else if key == "wrap_width" {
            o.wrap_width = if kind == 'n' { None } else { Some(digits_int(v)) };
        } else {
            return Err(f"unknown option {key}");
        }
        k += 1;
    }
    Ok((fields[0].clone(), o))
}

fn find_options(sets: ref Vec[(String, Options)], name: ref String) -> Result[Options, String] {
    for (n, o) in sets.iter() {
        if n == name {
            return Ok(o.clone());
        }
    }
    Err(f"no option set {name}")
}

fn convert(html: ref String, sets: ref Vec[(String, Options)], name: ref String, ents: ref Map[String, String]) -> Result[String, String] {
    let o = find_options(sets, name)?;
    markdownify(html, o, ents)
}

fn shown(r: own Result[String, String]) -> String {
    match r {
        Ok(s) => s,
        Err(e) => f"raised {e}",
    }
}

fn write_data() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data/pages".to_string()) {
        return Err(f"cannot create data/pages: {e}");
    }
    for (name, text) in data_files().into_iter() {
        let path = f"data/{name}";
        if let Err(e) = fs.write(path.clone(), text) {
            return Err(f"cannot write {path}: {e}");
        }
    }
    Ok(())
}

fn read(path: Str) -> Result[String, String] {
    match fs.read_to_string(path.to_string()) {
        Ok(t) => Ok(t),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

fn lines_of(text: ref String) -> Vec[String] {
    let mut v = split_nl(text);
    if v.len() > 0 and v[v.len() - 1].is_empty() {
        v.pop();
    }
    v
}

fn run() -> Result[(), String] {
    write_data()?;
    let ents = html5_entities();
    let mut sets: Vec[(String, Options)] = Vec.new();
    for line in lines_of(read("data/options.tsv")?).iter() {
        sets.push(parse_options(line)?);
    }
    for line in lines_of(read("data/jobs.tsv")?).iter() {
        if line.starts_with("#") {
            println(line);
            continue;
        }
        println(f"-- {line.replace("\t", " | ")}");
        let w: Vec[String] = line.split("\t").map(|p| p.to_string()).collect();
        if w[0] == "page" {
            let html = read(f"data/pages/{w[1]}".as_str())?;
            println(shown(convert(html, sets, w[2], ents)));
            println("-- end");
        } else if w[0] == "frag" {
            let r = convert(field(w[2]), sets, w[1], ents);
            match r {
                Ok(s) => println(f"   {py_repr(s)}"),
                Err(e) => println(f"   {py_repr(f"raised {e}")}"),
            }
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"error: {e}");
    }
}

// ---------------------------------------------------------------- data

// html.entities.html5: each name (with or without its ';') and its text.
fn html5_entities() -> Map[String, String] {
    let mut m: Map[String, String] = Map.new();
    add_entities_0(mut m);
    add_entities_1(mut m);
    add_entities_2(mut m);
    add_entities_3(mut m);
    add_entities_4(mut m);
    add_entities_5(mut m);
    add_entities_6(mut m);
    add_entities_7(mut m);
    add_entities_8(mut m);
    m
}

