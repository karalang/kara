("a"+("b"-1))*2
> Parameter(':1')
:1
> Parameter(3)
3
> QmarkParameter()
?
> NumericParameter(1)
:1
> NamedParameter('name')
:name
> FormatParameter()
%s
> PyformatParameter('name')
%(name)s
> t.x == QmarkParameter()
"x"=?
> t.x == NamedParameter('v')
"x"=:v
> Parameter('$1').as_('p')
$1
> Query.from_(t).select(t.a).where(t.x == Parameter('%s')).where(t.y.isin([Parameter('%s'), Parameter('%s')]))
SELECT "a" FROM "t" WHERE "x"=%s AND "y" IN (%s,%s)
> PostgreSQLQuery.from_(t).select(Array(1, 2), Array(), Tuple(1, 2))
SELECT ARRAY[1,2],'{}',(1,2) FROM "t"
> RedshiftQuery.from_(t).select(Array(t.a, t.b), Array())
SELECT ARRAY["a","b"],'{}' FROM "t"
> Query.from_(t).select(Array(1, 2), Array())
SELECT [1,2],[] FROM "t"
> c = Case().when(t.x == 1, 'one')
> c2 = c.when(t.x == 2, 'two')
> c
CASE WHEN "x"=1 THEN 'one' WHEN "x"=2 THEN 'two' END
> c2
CASE WHEN "x"=1 THEN 'one' WHEN "x"=2 THEN 'two' END
> c3 = c.else_('other')
> c
CASE WHEN "x"=1 THEN 'one' WHEN "x"=2 THEN 'two' END
> c3
CASE WHEN "x"=1 THEN 'one' WHEN "x"=2 THEN 'two' ELSE 'other' END
