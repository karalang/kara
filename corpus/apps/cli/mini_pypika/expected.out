"x"=[1,2,3]
> f == (1, 'a')
"x"=(1,'a')
> f == []
"x"=[]
> f == Order.asc
"x"='ASC'
> f == DatePart.year
"x"='YEAR'
> f != 3
"x"<>3
> f > 3
"x">3
> f >= 3
"x">=3
> f < 3
"x"<3
> f <= 3
"x"<=3
> 3 < f
"x">3
> 3 == f
"x"=3
> 'a' != f
"x"<>'a'
