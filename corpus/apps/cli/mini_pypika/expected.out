> PostgreSQLQuery.into(t).insert(1).on_conflict('id').do_update('name').where(t.active == True)
INSERT INTO "users" VALUES (1) ON CONFLICT ("id") DO UPDATE SET "name"=EXCLUDED."name" WHERE "users"."active"=true
> PostgreSQLQuery.into(t).insert(1).on_conflict('id').where(t.active == True).do_nothing()
INSERT INTO "users" VALUES (1) ON CONFLICT ("id") WHERE "active"=true DO NOTHING
