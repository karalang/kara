
# The tutorial
> q = Query.from_('customers').select('id', 'fname', 'lname', 'phone')
> q
SELECT "id","fname","lname","phone" FROM "customers"
> q.get_sql()
SELECT "id","fname","lname","phone" FROM "customers"
> customers = Table('customers')
> Query.from_(customers).select(customers.id, customers.fname, customers.lname, customers.phone)
SELECT "id","fname","lname","phone" FROM "customers"
> customers = Table('x_view_customers').as_('customers')
> Query.from_(customers).select(customers.id, customers.phone)
SELECT "customers"."id","customers"."phone" FROM "x_view_customers" "customers"
> views = Schema('views')
> Query.from_(views.customers).select(customers.id, customers.phone)
SELECT "customers"."id","customers"."phone" FROM "views"."customers"
> my_db = Database('my_db')
> Query.from_(my_db.analytics.customers).select(customers.id, customers.phone)
SELECT "customers"."id","customers"."phone" FROM "my_db"."analytics"."customers"
> Query.from_('customers').select('id', 'fname', 'lname', 'phone').orderby('id', order=Order.desc)
SELECT "id","fname","lname","phone" FROM "customers" ORDER BY "id" DESC
> Query.from_('account').select(Field('revenue') - Field('cost'))
SELECT "revenue"-"cost" FROM "account"
> accounts = Table('accounts')
> Query.from_(accounts).select(accounts.revenue - accounts.cost)
SELECT "revenue"-"cost" FROM "accounts"
> Query.from_(accounts).select((accounts.revenue - accounts.cost).as_('profit'))
SELECT "revenue"-"cost" "profit" FROM "accounts"
> table = Table('table')
> Query.from_(table).select(table.foo + table.bar, table.foo - table.bar, table.foo * table.bar, table.foo / table.bar, (table.foo + table.bar) / table.fiz)
SELECT "foo"+"bar","foo"-"bar","foo"*"bar","foo"/"bar",("foo"+"bar")/"fiz" FROM "table"
> customers = Table('customers')
> q = Query.from_(customers).select(customers.id, customers.fname, customers.lname, customers.phone)
> q.where(customers.lname == 'Mustermann')
SELECT "id","fname","lname","phone" FROM "customers" WHERE "lname"='Mustermann'
> q.where(customers.fname == 'Max').where(customers.lname == 'Mustermann')
SELECT "id","fname","lname","phone" FROM "customers" WHERE "fname"='Max' AND "lname"='Mustermann'
> Query.from_(customers).select(customers.id, customers.fname).where(customers.age[18:65] & customers.status.isin(['new', 'active']))
SELECT "id","fname" FROM "customers" WHERE "age" BETWEEN 18 AND 65 AND "status" IN ('new','active')
> q.where((customers.age >= 18) & (customers.lname == 'Mustermann'))
SELECT "id","fname","lname","phone" FROM "customers" WHERE "age">=18 AND "lname"='Mustermann'
> q.where((customers.age >= 18) | (customers.lname == 'Mustermann'))
SELECT "id","fname","lname","phone" FROM "customers" WHERE "age">=18 OR "lname"='Mustermann'
> q.where((customers.age >= 18) ^ customers.is_registered)
SELECT "id","fname","lname","phone" FROM "customers" WHERE "age">=18 XOR "is_registered"
> Query.from_(customers).select(customers.id, customers.fname).where(Criterion.all([customers.is_registered, customers.age >= 18, customers.lname == 'Jones']))
SELECT "id","fname" FROM "customers" WHERE "is_registered" AND "age">=18 AND "lname"='Jones'
> Query.from_(customers).select(customers.id, customers.fname).where(Criterion.any([customers.is_registered, customers.age >= 18, customers.lname == 'Jones']))
SELECT "id","fname" FROM "customers" WHERE "is_registered" OR "age">=18 OR "lname"='Jones'
> Query.from_(customers).where(customers.age >= 18).groupby(customers.id).select(customers.id, fn.Sum(customers.revenue))
SELECT "id",SUM("revenue") FROM "customers" WHERE "age">=18 GROUP BY "id"
> payments = Table('payments')
> Query.from_(payments).where(payments.transacted[date(2015, 1, 1):date(2016, 1, 1)]).groupby(payments.customer_id).having(fn.Sum(payments.total) >= 1000).select(payments.customer_id, fn.Sum(payments.total))
SELECT "customer_id",SUM("total") FROM "payments" WHERE "transacted" BETWEEN '2015-01-01' AND '2016-01-01' GROUP BY "customer_id" HAVING SUM("total")>=1000
> history, customers = Tables('history', 'customers')
> Query.from_(history).join(customers).on(history.customer_id == customers.id).select(history.star).where(customers.id == 5)
SELECT "history".* FROM "history" JOIN "customers" ON "history"."customer_id"="customers"."id" WHERE "customers"."id"=5
> Query.from_(history).join(customers).on_field('customer_id', 'group').select(history.star).where(customers.group == 'A')
SELECT "history".* FROM "history" JOIN "customers" ON "history"."customer_id"="customers"."customer_id" AND "history"."group"="customers"."group" WHERE "customers"."group"='A'
> Query.from_(history).join(customers).using('customer_id').select(history.star).where(customers.id == 5)
SELECT "history".* FROM "history" JOIN "customers" USING ("customer_id") WHERE "customers"."id"=5
> last_purchase_at = Query.from_(history).select(history.purchase_at).where(history.customer_id == customers.customer_id).orderby(history.purchase_at, order=Order.desc).limit(1)
> Query.from_(customers).select(customers.id, last_purchase_at.as_('last_purchase_at'))
SELECT "id",(SELECT "history"."purchase_at" FROM "history" WHERE "history"."customer_id"="customers"."customer_id" ORDER BY "history"."purchase_at" DESC LIMIT 1) "last_purchase_at" FROM "customers"
> provider_a, provider_b = Tables('provider_a', 'provider_b')
> q = Query.from_(provider_a).select(provider_a.created_time, provider_a.foo, provider_a.bar)
> r = Query.from_(provider_b).select(provider_b.created_time, provider_b.fiz, provider_b.buz)
> q + r
(SELECT "created_time","foo","bar" FROM "provider_a") UNION (SELECT "created_time","fiz","buz" FROM "provider_b")
> q * r
(SELECT "created_time","foo","bar" FROM "provider_a") UNION ALL (SELECT "created_time","fiz","buz" FROM "provider_b")
> q.intersect(r)
(SELECT "created_time","foo","bar" FROM "provider_a") INTERSECT (SELECT "created_time","fiz","buz" FROM "provider_b")
> q.minus(r)
(SELECT "created_time","foo","bar" FROM "provider_a") MINUS (SELECT "created_time","fiz","buz" FROM "provider_b")
> q - r
(SELECT "created_time","foo","bar" FROM "provider_a") MINUS (SELECT "created_time","fiz","buz" FROM "provider_b")
> q.except_of(r)
(SELECT "created_time","foo","bar" FROM "provider_a") EXCEPT (SELECT "created_time","fiz","buz" FROM "provider_b")
> fruits = Table('fruits')
> Query.from_(fruits).select(fruits.id, fruits.name).where(fruits.harvest_date + Interval(months=1) < fn.Now())
SELECT "id","name" FROM "fruits" WHERE "harvest_date"+INTERVAL '1 MONTH'<NOW()
> abc = Table('abc')
> Query.from_(abc).select(abc.foo, abc.bar).where(Tuple(abc.foo, abc.bar) == Tuple(1, 2))
SELECT "foo","bar" FROM "abc" WHERE ("foo","bar")=(1,2)
> Query.from_(abc).select(abc.foo, abc.bar).where(Tuple(abc.foo, abc.bar) == (1, 2))
SELECT "foo","bar" FROM "abc" WHERE ("foo","bar")=(1,2)
> Query.from_(abc).select(abc.foo, abc.bar).where(Tuple(abc.foo, abc.bar).isin([(1, 1), (2, 2), (3, 3)]))
SELECT "foo","bar" FROM "abc" WHERE ("foo","bar") IN ((1,1),(2,2),(3,3))
> Query.from_(customers).select(customers.id, customers.fname, customers.lname).where(customers.lname.like('Mc%'))
SELECT "id","fname","lname" FROM "customers" WHERE "lname" LIKE 'Mc%'
> Query.from_(customers).select(customers.id, customers.fname, customers.lname).where(customers.lname.regex('^[abc][a-zA-Z]+&'))
SELECT "id","fname","lname" FROM "customers" WHERE "lname" REGEX '^[abc][a-zA-Z]+&'
> Query.from_(customers).select(customers.id, fn.Concat(customers.fname, ' ', customers.lname).as_('full_name'))
SELECT "id",CONCAT("fname",' ',"lname") "full_name" FROM "customers"
> DateDiff = CustomFunction('DATE_DIFF', ['interval', 'start_date', 'end_date'])
> Query.from_(customers).select(customers.id, customers.fname, customers.lname, DateDiff('day', customers.created_date, customers.updated_date))
SELECT "id","fname","lname",DATE_DIFF('day',"created_date","updated_date") FROM "customers"
> Query.from_(customers).select(customers.id, Case().when(customers.fname == 'Tom', 'It was Tom').when(customers.fname == 'John', 'It was John').else_('It was someone else.').as_('who_was_it'))
SELECT "id",CASE WHEN "fname"='Tom' THEN 'It was Tom' WHEN "fname"='John' THEN 'It was John' ELSE 'It was someone else.' END "who_was_it" FROM "customers"
> sub_query = Query.from_(customers).select('*')
> Query.with_(sub_query, 'an_alias').from_(AliasedQuery('an_alias')).select('*')
WITH an_alias AS (SELECT * FROM "customers") SELECT * FROM an_alias
> Query.into(customers).insert(1, 'Jane', 'Doe', 'jane@example.com')
INSERT INTO "customers" VALUES (1,'Jane','Doe','jane@example.com')
> customers.insert(1, 'Jane', 'Doe', 'jane@example.com')
INSERT INTO "customers" VALUES (1,'Jane','Doe','jane@example.com')
> Query.into(customers).insert(1, 'Jane', 'Doe', 'jane@example.com').insert(2, 'John', 'Doe', 'john@example.com')
INSERT INTO "customers" VALUES (1,'Jane','Doe','jane@example.com'),(2,'John','Doe','john@example.com')
> Query.into(customers).insert((1, 'Jane', 'Doe', 'jane@example.com'), (2, 'John', 'Doe', 'john@example.com'))
INSERT INTO "customers" VALUES (1,'Jane','Doe','jane@example.com'),(2,'John','Doe','john@example.com')
> MySQLQuery.into(customers).insert(1, 'Jane', 'Doe', 'jane@example.com').on_duplicate_key_ignore()
INSERT INTO `customers` VALUES (1,'Jane','Doe','jane@example.com') ON DUPLICATE KEY IGNORE
> MySQLQuery.into(customers).insert(1, 'Jane', 'Doe', 'jane@example.com').on_duplicate_key_update(customers.email, Values(customers.email))
INSERT INTO `customers` VALUES (1,'Jane','Doe','jane@example.com') ON DUPLICATE KEY UPDATE `email`=VALUES(`email`)
> PostgreSQLQuery.into(customers).insert(1, 'Jane', 'Doe', 'jane@example.com').on_conflict(customers.email).do_nothing()
INSERT INTO "customers" VALUES (1,'Jane','Doe','jane@example.com') ON CONFLICT ("email") DO NOTHING
> PostgreSQLQuery.into(customers).insert(1, 'Jane', 'Doe', 'jane@example.com').on_conflict(customers.email).do_update(customers.email, 'bob@example.com')
INSERT INTO "customers" VALUES (1,'Jane','Doe','jane@example.com') ON CONFLICT ("email") DO UPDATE SET "email"='bob@example.com'
> Query.into(customers).columns('id', 'fname', 'lname').insert(1, 'Jane', 'Doe')
INSERT INTO "customers" ("id","fname","lname") VALUES (1,'Jane','Doe')
> customers, customers_backup = Tables('customers', 'customers_backup')
> Query.into(customers_backup).from_(customers).select('*')
INSERT INTO "customers_backup" SELECT * FROM "customers"
> Query.into(customers_backup).columns('id', 'fname', 'lname').from_(customers).select(customers.id, customers.fname, customers.lname)
INSERT INTO "customers_backup" ("id","fname","lname") SELECT "id","fname","lname" FROM "customers"
> customers, orders, orders_backup = Tables('customers', 'orders', 'orders_backup')
> Query.into(orders_backup).columns('id', 'address', 'customer_fname', 'customer_lname').from_(customers).join(orders).on(orders.customer_id == customers.id).select(orders.id, customers.fname, customers.lname)
INSERT INTO "orders_backup" ("id","address","customer_fname","customer_lname") SELECT "orders"."id","customers"."fname","customers"."lname" FROM "customers" JOIN "orders" ON "orders"."customer_id"="customers"."id"
> Query.update(customers).set(customers.last_login, '2017-01-01 10:00:00')
UPDATE "customers" SET "last_login"='2017-01-01 10:00:00'
> Query.update(customers).set(customers.lname, 'smith').where(customers.id == 10)
UPDATE "customers" SET "lname"='smith' WHERE "id"=10
> customers, profiles = Tables('customers', 'profiles')
> Query.update(customers).join(profiles).on(profiles.customer_id == customers.id).set(customers.lname, profiles.lname)
UPDATE "customers" JOIN "profiles" ON "profiles"."customer_id"="customers"."id" SET "lname"="profiles"."lname"
> customers.update().set(customers.lname, 'smith').where(customers.id == 10)
UPDATE "customers" SET "lname"='smith' WHERE "id"=10
> customers.update().set(customers.lname, 'smith').limit(2)
UPDATE "customers" SET "lname"='smith' LIMIT 2
> Query.into(customers).columns('id', 'fname', 'lname').insert(Parameter(':1'), Parameter(':2'), Parameter(':3'))
INSERT INTO "customers" ("id","fname","lname") VALUES (:1,:2,:3)
> t = Table('abc')
> Query.from_(t.for_(SYSTEM_TIME.as_of('2020-01-01'))).select('*')
SELECT * FROM "abc" FOR SYSTEM_TIME AS OF '2020-01-01'
> Query.from_(t.for_(SYSTEM_TIME.between('2020-01-01', '2020-02-01'))).select('*')
SELECT * FROM "abc" FOR SYSTEM_TIME BETWEEN '2020-01-01' AND '2020-02-01'
> Query.from_(t.for_(SYSTEM_TIME.from_to('2020-01-01', '2020-02-01'))).select('*')
SELECT * FROM "abc" FOR SYSTEM_TIME FROM '2020-01-01' TO '2020-02-01'
> Query.from_(t.for_(SYSTEM_TIME.all_())).select('*')
SELECT * FROM "abc" FOR SYSTEM_TIME ALL
> Query.from_(t.for_(t.valid_period.between('2020-01-01', '2020-02-01'))).select('*')
SELECT * FROM "abc" FOR "valid_period" BETWEEN '2020-01-01' AND '2020-02-01'
> t0 = Table('abc').for_(SYSTEM_TIME.as_of('2020-01-01'))
> t1 = Table('efg').for_(SYSTEM_TIME.as_of('2020-01-01'))
> Query.from_(t0).join(t1).on(t0.foo == t1.bar).select('*')
SELECT * FROM "abc" FOR SYSTEM_TIME AS OF '2020-01-01' JOIN "efg" FOR SYSTEM_TIME AS OF '2020-01-01' ON "abc"."foo"="efg"."bar"
> Query.update(t.for_portion(SYSTEM_TIME.from_to('2020-01-01', '2020-02-01'))).set('foo', 'bar')
UPDATE "abc" FOR PORTION OF SYSTEM_TIME FROM '2020-01-01' TO '2020-02-01' SET "foo"='bar'
> Query.from_(t.for_portion(t.valid_period.from_to('2020-01-01', '2020-02-01'))).delete()
DELETE FROM "abc" FOR PORTION OF "valid_period" FROM '2020-01-01' TO '2020-02-01'
> t.for_(SYSTEM_TIME.all_()).for_(SYSTEM_TIME.all_())
error AttributeError: 'Query' object already has attribute for_
> t.for_portion(SYSTEM_TIME.all_()).for_(SYSTEM_TIME.all_())
error AttributeError: 'Query' object already has attribute for_portion
> Query.create_table('person').columns(Column('id', 'INT', nullable=False), Column('first_name', 'VARCHAR(100)', nullable=False), Column('last_name', 'VARCHAR(100)', nullable=False), Column('phone_number', 'VARCHAR(20)', nullable=True), Column('status', 'VARCHAR(20)', nullable=False, default=ValueWrapper('NEW')), Column('date_of_birth', 'DATETIME')).unique('last_name', 'first_name').primary_key('id')
CREATE TABLE "person" ("id" INT NOT NULL,"first_name" VARCHAR(100) NOT NULL,"last_name" VARCHAR(100) NOT NULL,"phone_number" VARCHAR(20) NULL,"status" VARCHAR(20) NOT NULL DEFAULT 'NEW',"date_of_birth" DATETIME,UNIQUE ("last_name","first_name"),PRIMARY KEY ("id"))
> Query.create_table('names').as_select(Query.from_('person').select('last_name', 'first_name'))
CREATE TABLE "names" AS (SELECT "last_name","first_name" FROM "person")

# Values, quoting and get_sql options
> t = Table('t')
