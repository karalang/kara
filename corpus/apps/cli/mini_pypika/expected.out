# Aggregates and is_aggregate
> t = Table('t')
> fn.Sum(t.x).is_aggregate
True
> fn.Count('*').is_aggregate
True
> t.x.is_aggregate
False
> (t.x + 1).is_aggregate
False
> (fn.Sum(t.x) + 1).is_aggregate
True
> (fn.Sum(t.x) + t.y).is_aggregate
False
> (fn.Sum(t.x) / fn.Count('*')).is_aggregate
True
> ValueWrapper(1).is_aggregate
None
> fn.Coalesce(fn.Sum(t.x), 0).is_aggregate
True
> fn.Coalesce(t.x, 0).is_aggregate
False
> fn.Now().is_aggregate
None
> (fn.Sum(t.x) > 3).is_aggregate
True
> (t.x > 3).is_aggregate
False
> ((fn.Sum(t.x) > 3) & (fn.Max(t.y) < 9)).is_aggregate
True
> an.Rank().is_aggregate
False
> an.Sum(t.x).is_aggregate
False
> Case().when(t.x == 1, fn.Sum(t.y)).is_aggregate
True
> Case().when(fn.Sum(t.x) > 1, 1).else_(t.y).is_aggregate
False
> Case().when(fn.Sum(t.x) > 1, 1).else_(0).is_aggregate
True
> Tuple(fn.Sum(t.x), 1).is_aggregate
True
> (-fn.Sum(t.x)).is_aggregate
True
> fn.Sum(t.x).isin([1]).is_aggregate
True
> fn.Sum(t.x)[1:2].is_aggregate
True
> fn.Sum(t.x).isnull().is_aggregate
False
> Interval(days=1).is_aggregate
None
> NULL.is_aggregate
False
> Parameter('?').is_aggregate
None
> (fn.Sum(t.x) + Parameter('?')).is_aggregate
True
> EmptyCriterion().is_aggregate
None
> Not(fn.Sum(t.x) > 1).is_aggregate
False
> Query.from_(t).select(t.x).is_aggregate
False

