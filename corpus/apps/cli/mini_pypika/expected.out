NOT "x"=1
> ~((x == 1) & (y == 2))
NOT ("x"=1 AND "y"=2)
> (x == 1) & ~(y == 2)
"x"=1 AND NOT "y"=2
> ~~(x == 1)
NOT NOT "x"=1
> ~x
NOT "x"
> x & y
"x" AND "y"
> x | ~y
"x" OR NOT "y"
