# Case, tuples, arrays, parameters and intervals
> t = Table('t')
> Case().when(t.x == 1, 'one')
CASE WHEN "x"=1 THEN 'one' END
> Case().when(t.x == 1, 'one').else_('many')
CASE WHEN "x"=1 THEN 'one' ELSE 'many' END
> Case().when(t.x == 1, 'one').when(t.x == 2, 'two').else_(None)
CASE WHEN "x"=1 THEN 'one' WHEN "x"=2 THEN 'two' ELSE NULL END
> Case().when(t.x > 0, t.x).else_(-t.x)
CASE WHEN "x">0 THEN "x" ELSE -"x" END
> Case().when(t.x > 0, 1).else_(0).as_('pos')
CASE WHEN "x">0 THEN 1 ELSE 0 END
> Case(alias='c').when(t.flag, True)
CASE WHEN "flag" THEN true END
> Case()
error CaseException: At least one 'when' case is required for a CASE statement.
> Case().else_(1)
error CaseException: At least one 'when' case is required for a CASE statement.
> Case().when(t.x == 1, 'a').get_sql(with_alias=True)
CASE WHEN "x"=1 THEN 'a' END
> Case().when(t.x == 1, 'a').as_('k').get_sql(with_alias=True)
CASE WHEN "x"=1 THEN 'a' END k
> Case().when(t.x == 1, 'a').when(t.y.isnull(), fn.Now())
CASE WHEN "x"=1 THEN 'a' WHEN "y" IS NULL THEN NOW() END
