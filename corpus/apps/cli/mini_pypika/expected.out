  | -- paid_orders
  | SELECT "o"."id","o"."customer_id","o"."total" FROM "orders" "o" WHERE "o"."status"='paid' AND "o"."total">=100 ORDER BY "o"."total" DESC,"o"."id" ASC LIMIT 20;
