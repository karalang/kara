"x" IS NULL
> x.notnull()
NOT "x" IS NULL
> x.isnotnull()
"x" IS NOT NULL
> ~x.isnull()
NOT "x" IS NULL
> x.isnull() & y.notnull()
"x" IS NULL AND NOT "y" IS NULL
