> r2
SELECT "a","b",SUM("c") FROM "sales" GROUP BY ROLLUP("a","b")

# Joins
> a, b, c = Tables('a', 'b', 'c')
> Query.from_(a).inner_join(b).on(a.id == b.aid).select(a.x, b.y)
SELECT "a"."x","b"."y" FROM "a" JOIN "b" ON "a"."id"="b"."aid"
> Query.from_(a).left_join(b).on(a.id == b.aid).select(a.x, b.y)
SELECT "a"."x","b"."y" FROM "a" LEFT JOIN "b" ON "a"."id"="b"."aid"
> Query.from_(a).left_outer_join(b).on(a.id == b.aid).select(a.x, b.y)
SELECT "a"."x","b"."y" FROM "a" LEFT OUTER JOIN "b" ON "a"."id"="b"."aid"
> Query.from_(a).right_join(b).on(a.id == b.aid).select(a.x, b.y)
SELECT "a"."x","b"."y" FROM "a" RIGHT JOIN "b" ON "a"."id"="b"."aid"
> Query.from_(a).right_outer_join(b).on(a.id == b.aid).select(a.x, b.y)
SELECT "a"."x","b"."y" FROM "a" RIGHT OUTER JOIN "b" ON "a"."id"="b"."aid"
> Query.from_(a).outer_join(b).on(a.id == b.aid).select(a.x, b.y)
SELECT "a"."x","b"."y" FROM "a" FULL OUTER JOIN "b" ON "a"."id"="b"."aid"
> Query.from_(a).full_outer_join(b).on(a.id == b.aid).select(a.x, b.y)
SELECT "a"."x","b"."y" FROM "a" FULL OUTER JOIN "b" ON "a"."id"="b"."aid"
> Query.from_(a).hash_join(b).on(a.id == b.aid).select(a.x, b.y)
SELECT "a"."x","b"."y" FROM "a" HASH JOIN "b" ON "a"."id"="b"."aid"
> Query.from_(a).join(b, JoinType.inner).on(a.id == b.aid).select('*')
SELECT * FROM "a" JOIN "b" ON "a"."id"="b"."aid"
> Query.from_(a).join(b, JoinType.left).on(a.id == b.aid).select('*')
SELECT * FROM "a" LEFT JOIN "b" ON "a"."id"="b"."aid"
> Query.from_(a).join(b, JoinType.right).on(a.id == b.aid).select('*')
SELECT * FROM "a" RIGHT JOIN "b" ON "a"."id"="b"."aid"
> Query.from_(a).join(b, JoinType.outer).on(a.id == b.aid).select('*')
SELECT * FROM "a" FULL OUTER JOIN "b" ON "a"."id"="b"."aid"
> Query.from_(a).join(b, JoinType.cross).on(a.id == b.aid).select('*')
SELECT * FROM "a" CROSS JOIN "b" ON "a"."id"="b"."aid"
> Query.from_(a).cross_join(b).cross().select(a.x, b.y)
SELECT "a"."x","b"."y" FROM "a" CROSS JOIN "b"
> Query.from_(a).join(b).cross().select('*')
SELECT * FROM "a" CROSS JOIN "b"
> Query.from_(a).join(b).on(a.id == b.aid).join(c).on(b.id == c.bid).select(a.x, c.z)
SELECT "a"."x","c"."z" FROM "a" JOIN "b" ON "a"."id"="b"."aid" JOIN "c" ON "b"."id"="c"."bid"
> Query.from_(a).join(b).on((a.id == b.aid) & (b.kind == 'x')).select(a.x)
SELECT "a"."x" FROM "a" JOIN "b" ON "a"."id"="b"."aid" AND "b"."kind"='x'
> Query.from_(a).join(b).on(a.id == b.aid, collate='utf8_general_ci').select(a.x)
SELECT "a"."x" FROM "a" JOIN "b" ON "a"."id"="b"."aid" COLLATE utf8_general_ci
> Query.from_(a).join(b).on_field('id').select(a.x)
SELECT "a"."x" FROM "a" JOIN "b" ON "a"."id"="b"."id"
