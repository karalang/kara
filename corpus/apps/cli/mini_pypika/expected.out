SELECT `id` FROM `users` WHERE `name` RLIKE '^a' AND (`n` & 2)=2
> MySQLQuery.from_(t).select(t.id).groupby(t.id).rollup(vendor='mysql')
SELECT `id` FROM `users` GROUP BY `id` WITH ROLLUP
> m1 = MySQLQuery.from_(t).select(t.id)
> m2 = m1.modifier('A')
> m1
SELECT A `id` FROM `users`
> m2
SELECT A `id` FROM `users`

# PostgreSQL
> PostgreSQLQuery.into(t).insert(1, 'a').returning('id')
