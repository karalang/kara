# Arithmetic
> t = Table('t')
> a, b, c = t.a, t.b, t.c
> a + b
"a"+"b"
> a - b
"a"-"b"
> a * b
"a"*"b"
> a / b
"a"/"b"
> a + b + c
"a"+"b"+"c"
> a - b - c
"a"-"b"-"c"
> a - (b - c)
"a"-("b"-"c")
> a - (b + c)
"a"-("b"+"c")
> a + (b - c)
"a"+"b"-"c"
> (a + b) * c
("a"+"b")*"c"
> a * (b + c)
"a"*("b"+"c")
> a * (b - c)
"a"*("b"-"c")
> (a - b) / c
("a"-"b")/"c"
> a / (b * c)
"a"/("b"*"c")
> a / b / c
"a"/"b"/"c"
> a / (b / c)
"a"/("b"/"c")
> a * b * c
"a"*"b"*"c"
> a * (b * c)
"a"*"b"*"c"
> (a * b) + c
"a"*"b"+"c"
> a + b * c
"a"+"b"*"c"
> -a
-"a"
> -(a + b)
-"a"+"b"
> +a
"a"
> a * -b
"a"*-"b"
> a << 2
"a"<<2
> a >> 1
"a">>1
> (a + 1) << 2
("a"+1)<<2
> a ** 2
POW("a",2)
> a % 3
MOD("a",3)
> (a + b) ** 2
POW("a"+"b",2)
> 1 + a
1+"a"
> 10 - a
10-"a"
> 2 * (a + 1)
2*("a"+1)
> 1.5 / a
1.5/"a"
> None + a
NULL+"a"
> a + None
"a"+NULL
> a + 'x'
"a"+'x'
> a + Interval(days=1)
"a"+INTERVAL '1 DAY'
> a - Interval(hours=2, minutes=5)
"a"-INTERVAL '2:5 HOUR_MINUTE'
> a.lshift(1)
"a"<<1
> a.rshift(1)
"a">>1
> Bracket(a + b) * c
("a"+"b")*"c"
> (a + b).as_('s')
"a"+"b"
> (a + b).as_('s').get_sql(with_alias=True)
a+b s
> (a + b).get_sql(with_namespace=True, quote_char='`')
`t`.`a`+`t`.`b`
> Query.from_(t).select((a + b).as_('s'), (a * 2).as_('d'), -a)
SELECT "a"+"b" "s","a"*2 "d",-"a" FROM "t"
> 2 * 3
6
> 7 - 10
-3
> -(-4)
4

# Criteria
> t = Table('t')
> x, y, z = t.x, t.y, t.z
> (x == 1) & (y == 2)
"x"=1 AND "y"=2
> (x == 1) | (y == 2)
"x"=1 OR "y"=2
> (x == 1) ^ (y == 2)
"x"=1 XOR "y"=2
> (x == 1) & (y == 2) & (z == 3)
"x"=1 AND "y"=2 AND "z"=3
> ((x == 1) | (y == 2)) & (z == 3)
("x"=1 OR "y"=2) AND "z"=3
> (x == 1) | ((y == 2) & (z == 3))
"x"=1 OR ("y"=2 AND "z"=3)
> ((x == 1) & (y == 2)) | ((x == 3) & (y == 4))
("x"=1 AND "y"=2) OR ("x"=3 AND "y"=4)
