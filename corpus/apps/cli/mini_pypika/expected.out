  | -- basket_lines
  | SELECT o.id,p.title,i.qty,i.unit_price FROM order_items i JOIN orders o ON i.order_id=o.id JOIN products p USING (sku) WHERE i.qty BETWEEN 2 AND 10 AND p.active=true AND NOT p.brand IS NULL ORDER BY o.id ASC,p.title ASC;
  | -- stale_carts
  | SELECT o.id,o.placed_on FROM orders o WHERE o.status='new' AND o.placed_on<'2024-01-01' AND o.total IS NULL ORDER BY o.placed_on ASC LIMIT 50 OFFSET 100;
