const D_ORACLE: i64 = 4;
const D_SNOW: i64 = 5;
const D_SQLITE: i64 = 6;
const D_CH: i64 = 7;
const D_REDSHIFT: i64 = 8;
const D_VERTICA: i64 = 9;

// Function classes, as bits.
const B_AGG: i64 = 1;
const B_DIST: i64 = 2;
const B_ANA: i64 = 4;
const B_WIN: i64 = 8;
const B_IGN: i64 = 16;
const B_CAST: i64 = 32;
const B_EXTRACT: i64 = 64;
const B_APPROX: i64 = 128;
const B_CURTS: i64 = 256;

// The Query class each dialect kind belongs to.
fn query_cls_name(dk: i64) -> String {
    let names = vec!["Query", "MySQLQuery", "PostgreSQLQuery", "MSSQLQuery", "OracleQuery", "SnowflakeQuery",
        "SQLLiteQuery", "ClickHouseQuery", "RedshiftQuery", "VerticaQuery"];
    names[dk].to_string()
}

fn dialect_kind(name: ref String) -> i64 {
    let mut k = 0;
    while k <= D_VERTICA {
        if query_cls_name(k) == *name {
            return k;
        }
        k += 1;
    }
    -1
}

// The Dialects member a builder kind carries.
fn dialect_of_kind(dk: i64) -> Val {
    let names = vec!["", "MYSQL", "POSTGRESQL", "MSSQL", "ORACLE", "SNOWFLAKE", "SQLLITE", "CLICKHOUSE",
        "REDSHIFT", "VERTICA"];
    if dk == D_BASE {
        return Val.Non;
    }
    Val.En("Dialects".to_string(), names[dk].to_string())
}

fn is_dialect(v: ref Val, member: Str) -> bool {
    match v {
        Val.En(c, m) => c == "Dialects" and m == member,
        _ => false,
    }
}

// ------------------------------------------------------------ enums

fn enum_members(cls: ref String) -> Vec[String] {
    let m = if cls == "Order" {
        "asc ASC desc DESC"
    } else if cls == "JoinType" {
        "inner ~ left LEFT right RIGHT outer FULL_OUTER left_outer LEFT_OUTER right_outer RIGHT_OUTER full_outer FULL_OUTER cross CROSS hash HASH"
    } else if cls == "ReferenceOption" {
        "cascade CASCADE no_action NO_ACTION restrict RESTRICT set_null SET_NULL set_default SET_DEFAULT"
    } else if cls == "SetOperation" {
        "union UNION union_all UNION_ALL intersect INTERSECT except_of EXCEPT minus MINUS"
    } else if cls == "DatePart" {
        "year YEAR quarter QUARTER month MONTH week WEEK day DAY hour HOUR minute MINUTE second SECOND microsecond MICROSECOND"
    } else if cls == "Dialects" {
        "VERTICA vertica CLICKHOUSE clickhouse ORACLE oracle MSSQL mssql MYSQL mysql POSTGRESQL postgressql REDSHIFT redshift SQLLITE sqllite SNOWFLAKE snowflake"
    } else if cls == "Equality" {
        "eq = ne <> gt > gte >= lt < lte <="
    } else if cls == "Matching" {
        "not_like _NOT_LIKE_ like _LIKE_ not_ilike _NOT_ILIKE_ ilike _ILIKE_ rlike _RLIKE_ regex _REGEX_ regexp _REGEXP_ bin_regex _REGEX_BINARY_ as_of _AS_OF_ glob _GLOB_"
    } else if cls == "Boolean" {
        "and_ AND or_ OR xor_ XOR true TRUE false FALSE"
    } else if cls == "Arithmetic" {
        "add + sub - mul * div / lshift << rshift >>"
    } else {
        ""
    };
    split_on(m.to_string(), ' ')
}

// The member's value; '_' stands for a space in the table above and '~'
// for the empty string.
fn enum_value(cls: ref String, member: ref String) -> Val {
    let ms = enum_members(cls);
    let mut i = 0;
    while i + 1 < ms.len() {
        if ms[i] == *member {
            let v = ms[i + 1].clone();
            if v == "~" {
                return s_("");
            }
            return Val.Str(v.replace("_", " "));
        }
        i += 2;
    }
    Val.Absent
}

fn has_member(cls: ref String, member: ref String) -> bool {
    not is_absent(enum_value(cls, member))
}

fn en(cls: Str, member: Str) -> Val {
    Val.En(cls.to_string(), member.to_string())
}

// .value of an enum member.
fn ev(v: ref Val) -> String {
    match v {
        Val.En(c, m) => str_of(enum_value(c, m)),
        _ => String.new(),
    }
}

fn is_enum(v: ref Val) -> bool {
    match v {
        Val.En(_, _) => true,
        _ => false,
    }
}

fn same_val(x: ref Val, y: ref Val) -> bool {
    match x {
        Val.En(c, m) => match y {
            Val.En(d, n) => c == d and m == n,
            _ => false,
        },
        Val.Str(s) => match y {
            Val.Str(t) => s == t,
            _ => false,
        },
        Val.Int(n) => match y {
            Val.Int(m) => n == m,
            Val.Bool(b) => n == (if b { 1 } else { 0 }),
            Val.Float(f) => (n as f64) == f,
            _ => false,
        },
        Val.Bool(b) => match y {
            Val.Bool(c) => b == c,
            Val.Int(m) => m == (if b { 1 } else { 0 }),
            _ => false,
        },
        Val.Float(f) => match y {
            Val.Float(g) => f == g,
            Val.Int(m) => f == (m as f64),
            _ => false,
        },
        Val.Non => is_none(y),
        Val.Absent => is_absent(y),
        Val.Date(d) => match y {
            Val.Date(e) => d == e,
            _ => false,
        },
        _ => identical(x, y),
    }
}

// ------------------------------------------------------------ class tests

fn is_term_cls(c: i64) -> bool {
    (c >= C_FIELD and c <= C_FUNC) or c == C_QB or c == C_SETOP
}

// isinstance(v, Node)
fn is_node(a: ref A, v: ref Val) -> bool {
    let c = cls_of(a, v);
    is_term_cls(c) or c == C_TABLE or c == C_ALIASQ or c == C_INTERVAL
}

fn is_term(a: ref A, v: ref Val) -> bool {
    is_term_cls(cls_of(a, v))
}

fn is_criterion_cls(c: i64) -> bool {
    c == C_FIELD or c == C_STAR or c == C_TUPLE or c == C_ARRAY or c == C_BRACKET or c == C_BASIC
        or c == C_COMPLEX or c == C_CONTAINS or c == C_BETWEEN or c == C_PERIOD or c == C_BITAND
        or c == C_NULLC or c == C_NOTNULLC or c == C_EMPTY or c == C_NOT or c == C_ALL or c == C_CASE
        or c == C_FUNC
}

fn is_field(a: ref A, v: ref Val) -> bool {
    let c = cls_of(a, v);
    c == C_FIELD or c == C_STAR
}

fn is_table(a: ref A, v: ref Val) -> bool {
    cls_of(a, v) == C_TABLE
}

fn is_qb(a: ref A, v: ref Val) -> bool {
    cls_of(a, v) == C_QB
}

fn is_selectable(a: ref A, v: ref Val) -> bool {
    let c = cls_of(a, v);
    c == C_TABLE or c == C_ALIASQ or c == C_QB or c == C_SETOP
}

fn is_function(a: ref A, v: ref Val) -> bool {
    cls_of(a, v) == C_FUNC
}

fn fk_of(a: ref A, v: ref Val) -> i64 {
    if not is_function(a, v) {
        return 0;
    }
    geti(a, obj_id(v), F_FK)
}

fn has_bit(n: i64, b: i64) -> bool {
    (n / b) % 2 == 1
}

fn is_tuple_obj(a: ref A, v: ref Val) -> bool {
    let c = cls_of(a, v);
    c == C_TUPLE or c == C_ARRAY or c == C_BRACKET
}

// type(v).__name__
fn py_cls(a: ref A, v: ref Val) -> String {
    match v {
        Val.Absent => "NoneType".to_string(),
        Val.Non => "NoneType".to_string(),
        Val.Bool(_) => "bool".to_string(),
        Val.Int(_) => "int".to_string(),
        Val.Float(_) => "float".to_string(),
        Val.Str(_) => "str".to_string(),
        Val.Lst(_) => "list".to_string(),
        Val.Tup(_) => "tuple".to_string(),
        Val.Slc(_) => "slice".to_string(),
        Val.Date(_) => "date".to_string(),
        Val.En(c, _) => c.clone(),
        Val.Name(n) => n.clone(),
        Val.Meth(_, _) => "method".to_string(),
        Val.Obj(i) => {
            let o = i;
            let c = a.objs[o].cls;
            if c == C_QB {
                let dk = geti(a, o, F_DK);
                let names = vec!["QueryBuilder", "MySQLQueryBuilder", "PostgreSQLQueryBuilder", "MSSQLQueryBuilder",
                    "OracleQueryBuilder", "SnowflakeQueryBuilder", "SQLLiteQueryBuilder", "ClickHouseQueryBuilder",
                    "RedShiftQueryBuilder", "VerticaQueryBuilder"];
                return names[dk].to_string();
            }
            if c == C_FUNC {
                return gets(a, o, F_KIND);
            }
            if c == C_SCHEMA {
                return if getb(a, o, F_ISDB) { "Database".to_string() } else { "Schema".to_string() };
            }
            if c == C_LIT {
                return gets(a, o, F_KIND);
            }
            if c == C_PARAM {
                return gets(a, o, F_KIND);
            }
            if c == C_VW {
                return if getb(a, o, F_SQLITEW) { "SQLLiteValueWrapper".to_string() } else { "ValueWrapper".to_string() };
            }
            if c == C_JOIN {
                return gets(a, o, F_KIND);
            }
            if c == C_EDGE {
                return if gets(a, o, F_MODIFIER) == "PRECEDING" { "Preceding".to_string() } else { "Following".to_string() };
            }
            let names = vec!["", "Table", "Schema", "AliasedQuery", "QueryBuilder", "_SetOperation", "Joiner", "Join",
                "CreateQueryBuilder", "DropQueryBuilder", "Column", "PeriodFor", "", "", "", "", "", "", "", "",
                "Field", "Star", "ValueWrapper", "LiteralValue", "Parameter", "Negative", "Values", "Index", "Tuple",
                "Array", "Bracket", "BasicCriterion", "ComplexCriterion", "ContainsCriterion", "BetweenCriterion",
                "PeriodCriterion", "BitwiseAndCriterion", "NullCriterion", "NotNullCriterion", "EmptyCriterion", "Not",
                "All", "ArithmeticExpression", "Case", "Function", "Interval", "CustomFunction", "SqlType",
                "SqlTypeLength", "Edge"];
            names[c].to_string()
        }
    }
}

// ------------------------------------------------------------ constructors

fn new_term(a: mut ref A, cls: i64, alias: ref Val) -> i64 {
    let o = new_obj(mut a, cls);
    set(mut a, o, F_ALIAS, if is_absent(alias) { Val.Non } else { alias.clone() });
    o
}

fn mk_field(a: mut ref A, name: ref Val, alias: ref Val, table: ref Val) -> Val {
    let o = new_term(mut a, C_FIELD, alias);
    set(mut a, o, F_VALUE, Val.Non);
    set(mut a, o, F_NAME, name.clone());
    set(mut a, o, F_TABLE, if is_absent(table) { Val.Non } else { table.clone() });
    Val.Obj(o)
}

fn field_of(a: mut ref A, name: ref String, table: ref Val) -> Val {
    mk_field(mut a, sv(name), Val.Non, table)
}

fn mk_star(a: mut ref A, table: ref Val) -> Val {
    let o = new_term(mut a, C_STAR, Val.Non);
    set(mut a, o, F_VALUE, Val.Non);
    set(mut a, o, F_NAME, s_("*"));
    set(mut a, o, F_TABLE, if is_absent(table) { Val.Non } else { table.clone() });
    Val.Obj(o)
}

fn mk_schema(a: mut ref A, name: ref Val, parent: ref Val, isdb: bool) -> Val {
    let o = new_obj(mut a, C_SCHEMA);
    set(mut a, o, F_NAME, name.clone());
    set(mut a, o, F_PARENT, if is_absent(parent) { Val.Non } else { parent.clone() });
    set(mut a, o, F_ISDB, Val.Bool(isdb));
    Val.Obj(o)
}

// Table._init_schema
fn init_schema(a: mut ref A, schema: ref Val) -> Val {
    if cls_of(a, schema) == C_SCHEMA {
        return schema.clone();
    }
    if is_list_or_tuple(schema) {
        let xs = items(a, schema);
        let mut s = mk_schema(mut a, xs[0], Val.Non, false);
        let mut i = 1;
        while i < xs.len() {
            s = mk_schema(mut a, xs[i], s, false);
            i += 1;
        }
        return s;
    }
    if not is_nothing(schema) {
        return mk_schema(mut a, schema, Val.Non, false);
    }
    Val.Non
}

fn mk_table(a: mut ref A, name: ref Val, schema: ref Val, alias: ref Val, qk: i64) -> Val {
    let o = new_obj(mut a, C_TABLE);
    set(mut a, o, F_ALIAS, if is_absent(alias) { Val.Non } else { alias.clone() });
    set(mut a, o, F_TNAME, name.clone());
    let sc = init_schema(mut a, schema);
    set(mut a, o, F_SCHEMA, sc);
    set(mut a, o, F_QCLS, Val.Int(qk));
    set(mut a, o, F_FOR, Val.Non);
    set(mut a, o, F_FORP, Val.Non);
    Val.Obj(o)
}

fn table_of(a: mut ref A, name: ref String) -> Val {
    mk_table(mut a, sv(name), Val.Non, Val.Non, D_BASE)
}

fn mk_vw(a: mut ref A, value: ref Val, alias: ref Val, sqlite: bool) -> Val {
    let o = new_term(mut a, C_VW, alias);
    set(mut a, o, F_VALUE, value.clone());
    set(mut a, o, F_SQLITEW, Val.Bool(sqlite));
    Val.Obj(o)
}

// LiteralValue and its NullValue and SystemTimeValue.
fn mk_lit(a: mut ref A, kind: Str, value: ref String, alias: ref Val) -> Val {
    let o = new_term(mut a, C_LIT, alias);
    set(mut a, o, F_VALUE, sv(value));
    set(mut a, o, F_KIND, s_(kind));
    Val.Obj(o)
}

fn mk_null(a: mut ref A) -> Val {
    mk_lit(mut a, "NullValue", "NULL".to_string(), Val.Non)
}

fn mk_tuple_cls(a: mut ref A, cls: i64, values: ref Vec[Val]) -> Val {
    let o = new_term(mut a, cls, Val.Non);
    let mut ws: Vec[Val] = Vec.new();
    for v in values {
        ws.push(wrap_constant(mut a, v, false));
    }
    set_list(mut a, o, F_VALUES, ws);
    Val.Obj(o)
}

// Term.wrap_constant
fn wrap_constant(a: mut ref A, v: ref Val, sqlite: bool) -> Val {
    if is_node(a, v) {
        return v.clone();
    }
    if is_nothing(v) {
        return mk_null(mut a);
    }
    match v {
        Val.Lst(_) => {
            let xs = items(a, v);
            return mk_tuple_cls(mut a, C_ARRAY, xs);
        }
        Val.Tup(_) => {
            let xs = items(a, v);
            return mk_tuple_cls(mut a, C_TUPLE, xs);
        }
        _ => {}
    }
    mk_vw(mut a, v, Val.Non, sqlite)
}

fn wrap(a: mut ref A, v: ref Val) -> Val {
    wrap_constant(mut a, v, false)
}

fn mk_basic(a: mut ref A, cls: i64, cmp: ref Val, left: ref Val, right: ref Val) -> Val {
    let o = new_term(mut a, cls, Val.Non);
    set(mut a, o, F_CMP, cmp.clone());
    set(mut a, o, F_LEFT, left.clone());
    set(mut a, o, F_RIGHT, right.clone());
    Val.Obj(o)
}

// BasicCriterion(comparator, self, wrap_constant(other))
fn crit(a: mut ref A, ecls: Str, member: Str, left: ref Val, right: ref Val) -> Val {
    let r = wrap(mut a, right);
    mk_basic(mut a, C_BASIC, en(ecls, member), left, r)
}

fn mk_complex(a: mut ref A, member: Str, left: ref Val, right: ref Val) -> Val {
    mk_basic(mut a, C_COMPLEX, en("Boolean", member), left, right)
}

fn mk_arith(a: mut ref A, member: Str, left: ref Val, right: ref Val) -> Val {
    let o = new_term(mut a, C_ARITH, Val.Non);
    set(mut a, o, F_OP, en("Arithmetic", member));
    set(mut a, o, F_LEFT, left.clone());
    set(mut a, o, F_RIGHT, right.clone());
    Val.Obj(o)
}

fn mk_unary(a: mut ref A, cls: i64, term: ref Val) -> Val {
    let o = new_term(mut a, cls, Val.Non);
    set(mut a, o, F_TERM, term.clone());
    Val.Obj(o)
}

fn mk_contains(a: mut ref A, term: ref Val, container: ref Val) -> Val {
    let o = new_term(mut a, C_CONTAINS, Val.Non);
    set(mut a, o, F_TERM, term.clone());
    set(mut a, o, F_CONTAINER, container.clone());
    set(mut a, o, F_NEGATED, Val.Bool(false));
    Val.Obj(o)
}

fn mk_range(a: mut ref A, cls: i64, term: ref Val, start: ref Val, end: ref Val) -> Val {
    let o = new_term(mut a, cls, Val.Non);
    set(mut a, o, F_TERM, term.clone());
    let s = wrap(mut a, start);
    let e = wrap(mut a, end);
    set(mut a, o, F_START, s);
    set(mut a, o, F_END, e);
    Val.Obj(o)
}

// Function(name, *args, alias=, schema=) and the subclasses' state, by
// the bits of `fk`; `pycls` is the Python class.
fn mk_func(a: mut ref A, pycls: Str, name: Str, args: ref Vec[Val], alias: ref Val, schema: ref Val, fk: i64) -> Val {
    let o = new_term(mut a, C_FUNC, alias);
    set(mut a, o, F_KIND, s_(pycls));
    set(mut a, o, F_NAME, s_(name));
    let mut ws: Vec[Val] = Vec.new();
    for v in args {
        ws.push(wrap(mut a, v));
    }
    set_list(mut a, o, F_ARGS, ws);
    set(mut a, o, F_SCHEMA, if is_absent(schema) { Val.Non } else { schema.clone() });
    set(mut a, o, F_FK, Val.Int(fk));
    if has_bit(fk, B_AGG) {
        set_list(mut a, o, F_FILTERS, Vec.new());
        set(mut a, o, F_INCF, Val.Bool(false));
    }
    if has_bit(fk, B_DIST) {
        set(mut a, o, F_DISTINCT, Val.Bool(false));
    }
    if has_bit(fk, B_ANA) {
        set_list(mut a, o, F_PART, Vec.new());
        set_list(mut a, o, F_ORDERBYS, Vec.new());
        set(mut a, o, F_INCO, Val.Bool(false));
    }
    if has_bit(fk, B_WIN) {
        set(mut a, o, F_FRAME, Val.Non);
        set(mut a, o, F_BOUND, Val.Non);
    }
    if has_bit(fk, B_IGN) {
        set(mut a, o, F_IGN, Val.Bool(false));
    }
    Val.Obj(o)
}

fn mk_column(a: mut ref A, name: ref Val, ctype: ref Val, nullable: ref Val, default: ref Val) -> Val {
    let o = new_obj(mut a, C_COLUMN);
    set(mut a, o, F_NAME, name.clone());
    set(mut a, o, F_CTYPE, if is_absent(ctype) { Val.Non } else { ctype.clone() });
    set(mut a, o, F_NULLABLE, if is_absent(nullable) { Val.Non } else { nullable.clone() });
    let d = if is_nothing(default) or is_term(a, default) { default.clone() } else { mk_vw(mut a, default, Val.Non, false) };
    set(mut a, o, F_DEFAULT, if is_absent(d) { Val.Non } else { d });
    Val.Obj(o)
}

fn column_of(a: mut ref A, name: ref Val) -> Val {
    mk_column(mut a, name, Val.Non, Val.Non, Val.Non)
}

// ------------------------------------------------------------ str() and repr()

fn float_repr(x: f64) -> String {
    f"{x}"
}

fn date_iso(d: i64) -> String {
    let y = d / 10000;
    let m = (d / 100) % 100;
    let dd = d % 100;
    let mut ys = f"{y}";
    while ys.len() < 4 {
        ys = "0" + ys;
    }
    ys + "-" + pad2(m) + "-" + pad2(dd)
}

fn pyrepr(a: mut ref A, v: ref Val) -> Result[String, Exc] {
    match v {
        Val.Str(s) => Ok(str_repr(s)),
        Val.Date(d) => {
            let y = d / 10000;
            let m = (d / 100) % 100;
            let dd = d % 100;
            Ok(f"datetime.date({y}, {m}, {dd})")
        }
        Val.En(c, m) => {
            let x = ev(v);
            let r = str_repr(x);
            Ok(f"<{c}.{m}: {r}>")
        }
        _ => pystr(mut a, v),
    }
}

fn seq_str(a: mut ref A, v: ref Val, open: Str, close: Str) -> Result[String, Exc] {
    let xs = items(a, v);
    let mut parts: Vec[String] = Vec.new();
    for x in xs.clone() {
        parts.push(pyrepr(mut a, x)?);
    }
    let mut s = join_strs(parts, ", ");
    if close == ")" and xs.len() == 1 {
        s.push(',');
    }
    Ok(f"{open}{s}{close}")
}

// str(v)
fn pystr(a: mut ref A, v: ref Val) -> Result[String, Exc] {
    match v {
        Val.Absent => Ok("None".to_string()),
        Val.Non => Ok("None".to_string()),
        Val.Bool(b) => Ok(if b { "True".to_string() } else { "False".to_string() }),
        Val.Int(n) => Ok(f"{n}"),
        Val.Float(x) => Ok(float_repr(x)),
        Val.Str(s) => Ok(s.clone()),
        Val.Lst(_) => seq_str(mut a, v, "[", "]"),
        Val.Tup(_) => seq_str(mut a, v, "(", ")"),
        Val.Slc(_) => {
            let xs = items(a, v);
            let lo = pyrepr(mut a, xs[0])?;
            let hi = pyrepr(mut a, xs[1])?;
            Ok(f"slice({lo}, {hi}, None)")
        }
        Val.Date(d) => Ok(date_iso(d)),
        Val.En(c, m) => Ok(f"{c}.{m}"),
        Val.Name(n) => Ok(f"<class '{n}'>"),
        Val.Meth(_, n) => Ok(f"<bound method {n}>"),
        Val.Obj(o) => obj_str(mut a, o),
    }
}

fn obj_str(a: mut ref A, o: i64) -> Result[String, Exc] {
    let c = a.objs[o].cls;
    let v = Val.Obj(o);
    if c == C_TABLE {
        return sql(mut a, v, kw1(W_QC, s_("\"")));
    }
    if c == C_QB {
        let d = get(a, o, F_DIALECT);
        return sql(mut a, v, kw1(W_DIA, d));
    }
    if c == C_SETOP or c == C_CREATE or c == C_DROP or c == C_INTERVAL {
        return sql(mut a, v, kw0());
    }
    if c == C_COLUMN {
        return sql(mut a, v, kw1(W_QC, s_("\"")));
    }
    if c == C_EDGE {
        let val = get(a, o, F_VALUE);
        let vs = if py_truthy(val) { pystr(mut a, val)? } else { "UNBOUNDED".to_string() };
        let m = gets(a, o, F_MODIFIER);
        return Ok(f"{vs} {m}");
    }
    if is_term_cls(c) {
        return sql(mut a, v, kw2(W_QC, s_("\""), W_SQC, s_("'")));
    }
    let n = py_cls(a, v);
    Ok(f"<pypika.{n} object>")
}

// ------------------------------------------------------------ quoting

// format_quotes(value, quote_char)
fn fq(value: ref String, qc: ref Val) -> String {
    let q = if py_truthy(qc) { str_of(qc) } else { String.new() };
    q.clone() + value + q
}

fn fqv(a: mut ref A, value: ref Val, qc: ref Val) -> Result[String, Exc] {
    let s = pystr(mut a, value)?;
    Ok(fq(s, qc))
}

// format_alias_sql(sql, alias, quote_char, alias_quote_char, as_keyword)
fn fmt_alias(a: mut ref A, sql: own String, alias: ref Val, qc: ref Val, aqc: ref Val, ask: ref Val) -> Result[String, Exc] {
    if is_nothing(alias) {
        return Ok(sql);
    }
    let q = if py_truthy(aqc) { aqc.clone() } else { qc.clone() };
    let al = fqv(mut a, alias, q)?;
    let kw = if py_truthy(ask) { " AS " } else { " " };
    Ok(sql + kw + al)
}

// format_alias_sql(sql, alias, **kwargs)
fn fmt_alias_kw(a: mut ref A, sql: own String, alias: ref Val, kw: ref Kw) -> Result[String, Exc] {
    fmt_alias(mut a, sql, alias, kw_get(kw, W_QC), kw_get(kw, W_AQC), kw_get(kw, W_ASK))
}

// format_alias_sql(sql, alias, quote_char=qc, **kwargs)
fn fmt_alias_qc(a: mut ref A, sql: own String, alias: ref Val, qc: ref Val, kw: ref Kw) -> Result[String, Exc] {
    fmt_alias(mut a, sql, alias, qc, kw_get(kw, W_AQC), kw_get(kw, W_ASK))
}

// selectable.get_table_name()
fn table_name(a: ref A, t: ref Val) -> Val {
    let o = obj_id(t);
    let al = get(a, o, F_ALIAS);
    if cls_of(a, t) == C_TABLE and not py_truthy(al) {
        return get(a, o, F_TNAME);
    }
    al
}

// ------------------------------------------------------------ rendering terms

fn no_get_sql(a: ref A, v: ref Val) -> Exc {
    let c = py_cls(a, v);
    attr_error(f"'{c}' object has no attribute 'get_sql'")
}

// x.get_sql(**kw)
fn sql(a: mut ref A, v: ref Val, kw: ref Kw) -> Result[String, Exc] {
    let o = obj_id(v);
    if o < 0 {
        return Err(no_get_sql(a, v));
    }
    let c = a.objs[o].cls;
    let alias = get(a, o, F_ALIAS);
    if c == C_FIELD {
        let wa = kw_get(kw, W_WA);
        let wn = kw_get(kw, W_WN);
        let qc = kw_or(kw, W_QC, Val.Non);
        let rest = kw_del(kw_del(kw_del(kw, W_WA), W_WN), W_QC);
        let name = get(a, o, F_NAME);
        let mut fs = fqv(mut a, name, qc)?;
        let t = get(a, o, F_TABLE);
        if py_truthy(t) and (py_truthy(wn) or py_truthy(get(a, obj_id(t), F_ALIAS))) {
            let tn = table_name(a, t);
            let ns = fqv(mut a, tn, qc)?;
            fs = ns + "." + fs;
        }
        if py_truthy(wa) {
            return fmt_alias_qc(mut a, fs, alias, qc, rest);
        }
        return Ok(fs);
    }
    if c == C_STAR {
        let wn = kw_get(kw, W_WN);
        let qc = kw_get(kw, W_QC);
        let t = get(a, o, F_TABLE);
        if py_truthy(t) {
            let tal = get(a, obj_id(t), F_ALIAS);
            if py_truthy(wn) or py_truthy(tal) {
                let ns = if py_truthy(tal) {
                    pystr(mut a, tal)?
                } else if is_table(a, t) {
                    gets(a, obj_id(t), F_TNAME)
                } else {
                    "\"_table_name\"".to_string()
                };
                return Ok(fq(ns, qc) + ".*");
            }
        }
        return Ok("*".to_string());
    }
    if c == C_VW {
        let qc = kw_or(kw, W_QC, Val.Non);
        let sqc = kw_or(kw, W_SQC, s_("'"));
        let rest = kw_del(kw_del(kw, W_QC), W_SQC);
        let inner = kw_with2(rest, W_QC, qc.clone(), W_SQC, sqc);
        let value = get(a, o, F_VALUE);
        let s = if getb(a, o, F_SQLITEW) and is_bool(value) {
            if py_truthy(value) { "1".to_string() } else { "0".to_string() }
        } else {
            formatted_value(mut a, value, inner)?
        };
        return fmt_alias_qc(mut a, s, alias, qc, rest);
    }
    if c == C_LIT {
        let s = gets(a, o, F_VALUE);
        return fmt_alias_kw(mut a, s, alias, kw);
    }
    if c == C_PARAM {
        let k = gets(a, o, F_KIND);
        if k == "QmarkParameter" {
            return Ok("?".to_string());
        }
        if k == "FormatParameter" {
            return Ok("%s".to_string());
        }
        let p = get(a, o, F_VALUE);
        let ps = pystr(mut a, p)?;
        if k == "NumericParameter" or k == "NamedParameter" {
            return Ok(":" + ps);
        }
        if k == "PyformatParameter" {
            return Ok("%(" + ps + ")s");
        }
        return Ok(ps);
    }
    if c == C_NEG {
        let t = get(a, o, F_TERM);
        let s = sql(mut a, t, kw)?;
        return Ok("-" + s);
    }
    if c == C_VALUES {
        let qc = kw_or(kw, W_QC, Val.Non);
        let rest = kw_del(kw, W_QC);
        let f = get(a, o, F_FIELD);
        let s = sql(mut a, f, kw_with(rest, W_QC, qc))?;
        return Ok("VALUES(" + s + ")");
    }
    if c == C_INDEX {
        let qc = kw_get(kw, W_QC);
        return fqv(mut a, get(a, o, F_NAME), qc);
    }
    if c == C_TUPLE or c == C_BRACKET or c == C_ARRAY {
        let mut parts: Vec[String] = Vec.new();
        for t in lget(a, o, F_VALUES) {
            parts.push(sql(mut a, t, kw)?);
        }
        let vals = join_strs(parts, ",");
        let mut s = if c == C_ARRAY { "[" + vals + "]" } else { "(" + vals + ")" };
        if c == C_ARRAY {
            let d = kw_get(kw, W_DIA);
            if is_dialect(d, "POSTGRESQL") or is_dialect(d, "REDSHIFT") {
                s = if vals.len() > 0 { "ARRAY[" + vals + "]" } else { "'{}'".to_string() };
            }
        }
        return fmt_alias_kw(mut a, s, alias, kw);
    }
    if c == C_BASIC {
        let qc = kw_or(kw, W_QC, s_("\""));
        let wa = kw_get(kw, W_WA);
        let rest = kw_del(kw_del(kw, W_QC), W_WA);
        let inner = kw_with(rest, W_QC, qc);
        let l = sql(mut a, get(a, o, F_LEFT), inner)?;
        let r = sql(mut a, get(a, o, F_RIGHT), inner)?;
        let s = l + ev(get(a, o, F_CMP)) + r;
        if py_truthy(wa) {
            return fmt_alias_kw(mut a, s, alias, rest);
        }
        return Ok(s);
    }
    if c == C_COMPLEX {
        let subc = kw_get(kw, W_SUBC);
        let rest = kw_del(kw, W_SUBC);
        let cmp = get(a, o, F_CMP);
        let left = get(a, o, F_LEFT);
        let right = get(a, o, F_RIGHT);
        let lb = needs_brackets(a, cmp, left);
        let rb = needs_brackets(a, cmp, right);
        let l = sql(mut a, left, kw_with(rest, W_SUBC, Val.Bool(lb)))?;
        let r = sql(mut a, right, kw_with(rest, W_SUBC, Val.Bool(rb)))?;
        let s = l + " " + ev(cmp) + " " + r;
        if py_truthy(subc) {
            return Ok("(" + s + ")");
        }
        return Ok(s);
    }
    if c == C_CONTAINS {
        let rest = kw_del(kw, W_SUB);
        let t = sql(mut a, get(a, o, F_TERM), rest)?;
        let ct = sql(mut a, get(a, o, F_CONTAINER), kw_with(rest, W_SUB, Val.Bool(true)))?;
        let not_ = if getb(a, o, F_NEGATED) { "NOT " } else { "" };
        let s = t + " " + not_ + "IN " + ct;
        return fmt_alias_kw(mut a, s, alias, rest);
    }
    if c == C_BETWEEN or c == C_PERIOD {
        let t = sql(mut a, get(a, o, F_TERM), kw)?;
        let st = sql(mut a, get(a, o, F_START), kw)?;
        let en_ = sql(mut a, get(a, o, F_END), kw)?;
        let s = if c == C_BETWEEN {
            t + " BETWEEN " + st + " AND " + en_
        } else {
            t + " FROM " + st + " TO " + en_
        };
        return fmt_alias_kw(mut a, s, alias, kw);
    }
    if c == C_BITAND {
        let t = sql(mut a, get(a, o, F_TERM), kw)?;
        let vs = pystr(mut a, get(a, o, F_VALUE))?;
        let s = "(" + t + " & " + vs + ")";
        return fmt_alias_kw(mut a, s, alias, kw);
    }
    if c == C_NULLC or c == C_NOTNULLC {
        let rest = kw_del(kw, W_WA);
        let t = sql(mut a, get(a, o, F_TERM), rest)?;
        let s = if c == C_NULLC { t + " IS NULL" } else { t + " IS NOT NULL" };
        return fmt_alias_kw(mut a, s, alias, rest);
    }
    if c == C_EMPTY {
        if kw.ks.len() > 0 {
            let k = kw_first(kw);
            return Err(type_error(f"Criterion.get_sql() got an unexpected keyword argument '{k}'"));
        }
        return Err(exc("NotImplementedError", String.new()));
    }
    if c == C_NOT {
        let k2 = kw_set(kw, W_SUBC, Val.Bool(true));
        let t = sql(mut a, get(a, o, F_TERM), k2)?;
        return fmt_alias_kw(mut a, "NOT " + t, alias, k2);
    }
    if c == C_ALL {
        let t = sql(mut a, get(a, o, F_TERM), kw)?;
        return fmt_alias_kw(mut a, t + " ALL", alias, kw);
    }
    if c == C_ARITH {
        let wa = kw_get(kw, W_WA);
        let rest = kw_del(kw, W_WA);
        let op = get(a, o, F_OP);
        let left = get(a, o, F_LEFT);
        let right = get(a, o, F_RIGHT);
        let lop = op_of(a, left);
        let rop = op_of(a, right);
        let addish = ev(op) == "+" or ev(op) == "-";
        let lp = if lop == "" { false } else if addish { false } else { lop == "+" or lop == "-" or lop == "?" };
        let rp = if rop == "" {
            false
        } else if ev(op) == "+" {
            false
        } else if ev(op) == "/" {
            true
        } else {
            rop == "+" or rop == "-" or rop == "?"
        };
        let mut l = sql(mut a, left, rest)?;
        let mut r = sql(mut a, right, rest)?;
        if lp {
            l = "(" + l + ")";
        }
        if rp {
            r = "(" + r + ")";
        }
        let s = l + ev(op) + r;
        if py_truthy(wa) {
            return fmt_alias_kw(mut a, s, alias, rest);
        }
        return Ok(s);
    }
    if c == C_CASE {
        let wa = kw_get(kw, W_WA);
        let rest = kw_del(kw, W_WA);
        let cases = lget(a, o, F_CASES);
        if cases.len() == 0 {
            return Err(exc("CaseException", "At least one 'when' case is required for a CASE statement.".to_string()));
        }
        let mut parts: Vec[String] = Vec.new();
        for cs in cases {
            let pair = items(a, cs);
            let w = sql(mut a, pair[0], rest)?;
            let t = sql(mut a, pair[1], rest)?;
            parts.push("WHEN " + w + " THEN " + t);
        }
        let el = get(a, o, F_ELSE);
        let es = if py_truthy(el) { " ELSE " + sql(mut a, el, rest)? } else { String.new() };
        let s = "CASE " + join_strs(parts, " ") + es + " END";
        if py_truthy(wa) {
            return fmt_alias_kw(mut a, s, alias, rest);
        }
        return Ok(s);
    }
    if c == C_FUNC {
        return func_sql(mut a, o, kw);
    }
    if c == C_INTERVAL {
        return interval_sql(mut a, o, kw);
    }
    if c == C_TABLE {
        let qc = kw_get(kw, W_QC);
        let mut ts = fqv(mut a, get(a, o, F_TNAME), qc)?;
        let sc = get(a, o, F_SCHEMA);
        if not is_nothing(sc) {
            ts = sql(mut a, sc, kw)? + "." + ts;
        }
        let f = get(a, o, F_FOR);
        let fp = get(a, o, F_FORP);
        if py_truthy(f) {
            ts = ts + " FOR " + sql(mut a, f, kw)?;
        } else if py_truthy(fp) {
            ts = ts + " FOR PORTION OF " + sql(mut a, fp, kw)?;
        }
        return fmt_alias_kw(mut a, ts, alias, kw);
    }
    if c == C_SCHEMA {
        let qc = kw_or(kw, W_QC, Val.Non);
        let rest = kw_del(kw, W_QC);
        let s = fqv(mut a, get(a, o, F_NAME), qc)?;
        let p = get(a, o, F_PARENT);
        if not is_nothing(p) {
            let ps = sql(mut a, p, kw_with(rest, W_QC, qc))?;
            return Ok(ps + "." + s);
        }
        return Ok(s);
    }
    if c == C_ALIASQ {
        let q = get(a, o, F_QUERY);
        if is_nothing(q) {
            return pystr(mut a, get(a, o, F_NAME));
        }
        return sql(mut a, q, kw);
    }
    if c == C_COLUMN {
        let n = column_name_sql(mut a, o, kw)?;
        let t = get(a, o, F_CTYPE);
        let ts = if py_truthy(t) { " " + pystr(mut a, t)? } else { String.new() };
        let nl = get(a, o, F_NULLABLE);
        let ns = if is_nothing(nl) { "" } else if py_truthy(nl) { " NULL" } else { " NOT NULL" };
        let d = get(a, o, F_DEFAULT);
        let ds = if py_truthy(d) { " DEFAULT " + sql(mut a, d, kw)? } else { String.new() };
        return Ok(n + ts + ns + ds);
    }
    if c == C_PERIODFOR {
        let qc = kw_get(kw, W_QC);
        let n = fqv(mut a, get(a, o, F_NAME), qc)?;
        let s1 = column_name_sql(mut a, obj_id(get(a, o, F_SCOL)), kw)?;
        let s2 = column_name_sql(mut a, obj_id(get(a, o, F_ECOL)), kw)?;
        return Ok("PERIOD FOR " + n + " (" + s1 + "," + s2 + ")");
    }
    if c == C_SQLTYPE {
        return pystr(mut a, get(a, o, F_NAME));
    }
    if c == C_SQLTYPELEN {
        let n = pystr(mut a, get(a, o, F_NAME))?;
        let l = pystr(mut a, get(a, o, F_LENGTH))?;
        return Ok(n + "(" + l + ")");
    }
    if c == C_QB {
        return qb_sql(mut a, o, kw);
    }
    if c == C_SETOP {
        return setop_sql(mut a, o, kw);
    }
    if c == C_JOIN {
        return join_sql(mut a, o, kw);
    }
    if c == C_CREATE {
        return create_sql(mut a, o, kw);
    }
    if c == C_DROP {
        return drop_sql(mut a, o, kw);
    }
    Err(no_get_sql(a, v))
}

fn column_name_sql(a: mut ref A, o: i64, kw: ref Kw) -> Result[String, Exc] {
    fqv(mut a, get(a, o, F_NAME), kw_get(kw, W_QC))
}

// ComplexCriterion.needs_brackets
fn needs_brackets(a: ref A, cmp: ref Val, term: ref Val) -> bool {
    if cls_of(a, term) != C_COMPLEX {
        return false;
    }
    not same_val(get(a, obj_id(term), F_CMP), cmp)
}

// getattr(side, "operator", None) as ArithmeticExpression.get_sql reads it:
// its symbol, "" for None, and "?" for the Field a Selectable's
// __getattr__ makes up, which compares equal to everything.
fn op_of(a: ref A, side: ref Val) -> String {
    let c = cls_of(a, side);
    if c == C_ARITH {
        return ev(get(a, obj_id(side), F_OP));
    }
    if c == C_TABLE or c == C_QB or c == C_SETOP or c == C_ALIASQ {
        return "?".to_string();
    }
    String.new()
}

// ValueWrapper.get_formatted_value
fn formatted_value(a: mut ref A, value: ref Val, kw: ref Kw) -> Result[String, Exc] {
    let qv = kw_get(kw, W_SQC);
    let q = if py_truthy(qv) { str_of(qv) } else { String.new() };
    if is_term(a, value) {
        return sql(mut a, value, kw);
    }
    match value {
        Val.En(_, _) => {
            let inner = enum_value_val(value);
            return formatted_value(mut a, inner, kw);
        }
        Val.Date(d) => {
            let s = sv(date_iso(d));
            return formatted_value(mut a, s, kw);
        }
        Val.Str(s) => {
            let body = if q.len() > 0 { s.replace(q.as_str(), (q.clone() + q).as_str()) } else { s.clone() };
            return Ok(q.clone() + body + q);
        }
        Val.Bool(b) => return Ok(if b { "true".to_string() } else { "false".to_string() }),
        Val.Non => return Ok("null".to_string()),
        _ => {}
    }
    pystr(mut a, value)
}

fn enum_value_val(v: ref Val) -> Val {
    match v {
        Val.En(c, m) => enum_value(c, m),
        _ => Val.Absent,
    }
}

// ------------------------------------------------------------ functions

fn func_sql(a: mut ref A, o: i64, kw: ref Kw) -> Result[String, Exc] {
    let wa = kw_get(kw, W_WA);
    let wn = kw_or(kw, W_WN, Val.Bool(false));
    let qc = kw_or(kw, W_QC, Val.Non);
    let dia = kw_or(kw, W_DIA, Val.Non);
    let rest = kw_del(kw_del(kw_del(kw_del(kw, W_WA), W_WN), W_QC), W_DIA);
    let mut fk = kw0();
    fk = kw_set(fk, W_WN, wn);
    fk = kw_set(fk, W_QC, qc.clone());
    fk = kw_set(fk, W_DIA, dia.clone());
    let mut s = function_sql(mut a, o, fk)?;
    let sc = get(a, o, F_SCHEMA);
    if not is_nothing(sc) {
        let k2 = kw_with2(rest, W_QC, qc.clone(), W_DIA, dia);
        s = sql(mut a, sc, k2)? + "." + s;
    }
    if py_truthy(wa) {
        let al = get(a, o, F_ALIAS);
        return fmt_alias_qc(mut a, s, al, qc, rest);
    }
    Ok(s)
}

// get_function_sql(**kw), with each subclass's additions.
fn function_sql(a: mut ref A, o: i64, kw: ref Kw) -> Result[String, Exc] {
    let fk = geti(a, o, F_FK);
    if has_bit(fk, B_CURTS) {
        return Ok("CURRENT_TIMESTAMP".to_string());
    }
    let special = special_params_sql(mut a, o, kw)?;
    let mut parts: Vec[String] = Vec.new();
    let ak = kw_with2(kw, W_WA, Val.Bool(false), W_SUB, Val.Bool(true));
    for p in lget(a, o, F_ARGS) {
        parts.push(sql(mut a, p, ak)?);
    }
    let name = gets(a, o, F_NAME);
    let sp = if special.len() > 0 { " " + special } else { String.new() };
    let mut s = name.clone() + "(" + join_strs(parts, ",") + sp + ")";
    if has_bit(fk, B_AGG) {
        if getb(a, o, F_INCF) {
            let filters = lget(a, o, F_FILTERS);
            let all = criterion_all(mut a, filters);
            let fs = sql(mut a, all, kw)?;
            s = s + " FILTER(WHERE " + fs + ")";
        }
    }
    if has_bit(fk, B_DIST) and getb(a, o, F_DISTINCT) {
        let n = name.len() + 1;
        s = s.substring(0, n) + "DISTINCT " + s.substring(n, s.len());
    }
    if has_bit(fk, B_ANA) and getb(a, o, F_INCO) {
        let ps = partition_sql(mut a, o, kw)?;
        s = s + " OVER(" + ps + ")";
    }
    Ok(s)
}

fn special_params_sql(a: mut ref A, o: i64, kw: ref Kw) -> Result[String, Exc] {
    let fk = geti(a, o, F_FK);
    if has_bit(fk, B_IGN) {
        return Ok(if getb(a, o, F_IGN) { "IGNORE NULLS".to_string() } else { String.new() });
    }
    if has_bit(fk, B_CAST) {
        let t = get(a, o, F_ASTYPE);
        let c = cls_of(a, t);
        let ts = if c == C_SQLTYPE or c == C_SQLTYPELEN or is_term(a, t) {
            sql(mut a, t, kw)?
        } else {
            pystr(mut a, t)?.to_uppercase()
        };
        return Ok("AS " + ts);
    }
    if has_bit(fk, B_EXTRACT) {
        let f = get(a, o, F_FIELD);
        return Ok("FROM " + sql(mut a, f, kw)?);
    }
    if has_bit(fk, B_APPROX) {
        let p = pystr(mut a, get(a, o, F_PCT))?;
        return Ok("USING PARAMETERS percentile=" + p);
    }
    Ok(String.new())
}

fn partition_sql(a: mut ref A, o: i64, kw: ref Kw) -> Result[String, Exc] {
    let mut terms: Vec[String] = Vec.new();
    let part = lget(a, o, F_PART);
    if part.len() > 0 {
        let mut ps: Vec[String] = Vec.new();
        for p in part {
            if is_node(a, p) {
                ps.push(sql(mut a, p, kw)?);
            } else {
                ps.push(pystr(mut a, p)?);
            }
        }
        terms.push("PARTITION BY " + join_strs(ps, ","));
    }
    let obs = lget(a, o, F_ORDERBYS);
    if obs.len() > 0 {
        let mut os: Vec[String] = Vec.new();
        for ob in obs {
            let pair = items(a, ob);
            let f = sql(mut a, pair[0], kw)?;
            if is_nothing(pair[1]) {
                os.push(f);
            } else {
                os.push(f + " " + ev(pair[1]));
            }
        }
        terms.push("ORDER BY " + join_strs(os, ","));
    }
    let s = join_strs(terms, " ");
    if has_bit(geti(a, o, F_FK), B_WIN) {
        let frame = get(a, o, F_FRAME);
        let bound = get(a, o, F_BOUND);
        if not py_truthy(frame) and not py_truthy(bound) {
            return Ok(s);
        }
        let fs = pystr(mut a, frame)?;
        let bs = if is_tuple_val(bound) {
            let lu = items(a, bound);
            let lo = pystr(mut a, lu[0])?;
            let hi = pystr(mut a, lu[1])?;
            fs + " BETWEEN " + lo + " AND " + hi
        } else {
            fs + " " + pystr(mut a, bound)?
        };
        return Ok(s + " " + bs);
    }
    Ok(s)
}

// Criterion.all(terms): `&` over the terms, starting from an
// EmptyCriterion.
fn criterion_all(a: mut ref A, terms: ref Vec[Val]) -> Val {
    let mut c = Val.Obj(new_term(mut a, C_EMPTY, Val.Non));
    for t in terms {
        c = and_(mut a, c, t);
    }
    c
}

fn criterion_any(a: mut ref A, terms: ref Vec[Val]) -> Val {
    let mut c = Val.Obj(new_term(mut a, C_EMPTY, Val.Non));
    for t in terms {
        c = or_(mut a, c, t);
    }
    c
}

// crit & other, for a Criterion on the left.
fn and_(a: mut ref A, x: ref Val, y: ref Val) -> Val {
    if cls_of(a, x) == C_EMPTY {
        return y.clone();
    }
    mk_complex(mut a, "and_", x, y)
}

fn or_(a: mut ref A, x: ref Val, y: ref Val) -> Val {
    if cls_of(a, x) == C_EMPTY {
        return y.clone();
    }
    mk_complex(mut a, "or_", x, y)
}

// ------------------------------------------------------------ intervals

fn interval_units() -> Vec[i64] {
    vec![F_YEARS, F_MONTHS, F_DAYS, F_HOURS, F_MINUTES, F_SECONDS, F_MICROS]
}

fn interval_labels() -> Vec[String] {
    vec!["YEAR".to_string(), "MONTH".to_string(), "DAY".to_string(), "HOUR".to_string(), "MINUTE".to_string(),
        "SECOND".to_string(), "MICROSECOND".to_string()]
}

fn mk_interval(a: mut ref A, vals: ref Vec[Val], quarters: ref Val, weeks: ref Val, dialect: ref Val) -> Val {
    let o = new_obj(mut a, C_INTERVAL);
    set(mut a, o, F_DIALECT, if is_absent(dialect) { Val.Non } else { dialect.clone() });
    set(mut a, o, F_LARGEST, Val.Non);
    set(mut a, o, F_SMALLEST, Val.Non);
    set(mut a, o, F_ISNEG, Val.Bool(false));
    if py_truthy(quarters) {
        set(mut a, o, F_QUARTERS, quarters.clone());
        return Val.Obj(o);
    }
    if py_truthy(weeks) {
        set(mut a, o, F_WEEKS, weeks.clone());
        return Val.Obj(o);
    }
    let units = interval_units();
    let labels = interval_labels();
    let mut i = 0;
    while i < 7 {
        let v = vals[i].clone();
        if py_truthy(v) {
            let n = match v {
                Val.Int(n) => n,
                Val.Float(x) => x as i64,
                Val.Bool(b) => if b { 1 } else { 0 },
                _ => 0,
            };
            set(mut a, o, units[i], Val.Int(if n < 0 { -n } else { n }));
            if is_none(get(a, o, F_LARGEST)) {
                set(mut a, o, F_LARGEST, sv(labels[i]));
                set(mut a, o, F_ISNEG, Val.Bool(n < 0));
            }
            set(mut a, o, F_SMALLEST, sv(labels[i]));
        }
        i += 1;
    }
    Val.Obj(o)
}

fn unit_int(a: ref A, o: i64, k: i64) -> String {
    match get(a, o, k) {
        Val.Int(n) => f"{n}",
        _ => "0".to_string(),
    }
}

fn s1_char(c: char) -> bool {
    c == '0' or c == '-' or c == '.' or c == ':' or c == ' '
}

// Interval.trim_pattern.sub("", expr): the pattern
// (^0+\.)|(\.0+$)|(^[0\-.: ]+[\-: ])|([\-:. ][0\-.: ]+$) on "Y-M-D h:m:s.us".
fn interval_trim(s: ref String) -> String {
    let cs: Vec[char] = s.chars().collect();
    let n = cs.len();
    let mut out = String.new();
    let mut pos = 0;
    while pos <= n {
        // The longest match at pos, trying the alternatives in order.
        let mut mlen = -1;
        if pos == 0 {
            // ^0+\.
            let mut k = 0;
            while k < n and cs[k] == '0' {
                k += 1;
            }
            if k > 0 and k < n and cs[k] == '.' {
                mlen = k + 1;
            }
        }
        if mlen < 0 and pos < n and cs[pos] == '.' {
            // \.0+$
            let mut k = pos + 1;
            while k < n and cs[k] == '0' {
                k += 1;
            }
            if k == n and k > pos + 1 {
                mlen = n - pos;
            }
        }
        if mlen < 0 and pos == 0 {
            // ^[0\-.: ]+[\-: ] — greedy, then backtrack to the last [\-: ].
            let mut k = 0;
            while k < n and s1_char(cs[k]) {
                k += 1;
            }
            let mut j = k;
            while j >= 2 {
                let c = cs[j - 1];
                if c == '-' or c == ':' or c == ' ' {
                    mlen = j;
                    break;
                }
                j -= 1;
            }
        }
        if mlen < 0 and pos < n and (cs[pos] == '-' or cs[pos] == ':' or cs[pos] == '.' or cs[pos] == ' ') {
            // [\-:. ][0\-.: ]+$
            let mut k = pos + 1;
            while k < n and s1_char(cs[k]) {
                k += 1;
            }
            if k == n and k > pos + 1 {
                mlen = n - pos;
            }
        }
        if mlen > 0 {
            pos += mlen;
        } else {
            if pos < n {
                out.push(cs[pos]);
            }
            pos += 1;
        }
    }
    out
}

fn interval_sql(a: mut ref A, o: i64, kw: ref Kw) -> Result[String, Exc] {
    let own_d = get(a, o, F_DIALECT);
    let dialect = if py_truthy(own_d) { own_d } else { kw_or(kw, W_DIA, Val.Non) };
    let largest = get(a, o, F_LARGEST);
    let mut expr = String.new();
    let mut unit = String.new();
    if str_of(largest) == "MICROSECOND" {
        expr = unit_int(a, o, F_MICROS);
        unit = "MICROSECOND".to_string();
    } else if not is_absent(get(a, o, F_QUARTERS)) {
        expr = unit_int(a, o, F_QUARTERS);
        unit = "QUARTER".to_string();
    } else if not is_absent(get(a, o, F_WEEKS)) {
        expr = unit_int(a, o, F_WEEKS);
        unit = "WEEK".to_string();
    } else {
        let e = unit_int(a, o, F_YEARS) + "-" + unit_int(a, o, F_MONTHS) + "-" + unit_int(a, o, F_DAYS) + " "
            + unit_int(a, o, F_HOURS) + ":" + unit_int(a, o, F_MINUTES) + ":" + unit_int(a, o, F_SECONDS) + "."
            + unit_int(a, o, F_MICROS);
        expr = interval_trim(e);
        if getb(a, o, F_ISNEG) {
            expr = "-" + expr;
        }
        let smallest = get(a, o, F_SMALLEST);
        if is_none(largest) {
            unit = "DAY".to_string();
        } else if str_of(largest) != str_of(smallest) {
            unit = str_of(largest) + "_" + str_of(smallest);
        } else {
            unit = str_of(largest);
        }
    }
    if is_dialect(dialect, "ORACLE") or is_dialect(dialect, "MYSQL") {
        return Ok("INTERVAL '" + expr + "' " + unit);
    }
    Ok("INTERVAL '" + expr + " " + unit + "'")
}

// ------------------------------------------------------------ rendering statements

// The builders' class constants.
fn qb_quote(dk: i64) -> Val {
    if dk == D_MYSQL {
        return s_("`");
    }
    if dk == D_SNOW or dk == D_ORACLE {
        return Val.Non;
    }
    s_("\"")
}

fn qb_alias_quote(dk: i64) -> Val {
    if dk == D_SNOW or dk == D_PG {
        return s_("\"");
    }
    Val.Non
}

fn qb_query_alias_quote(dk: i64) -> Val {
    if dk == D_SNOW {
        return s_("");
    }
    Val.Non
}

// QueryBuilder._set_kwargs_defaults
fn qb_defaults(a: ref A, o: i64, kw: ref Kw) -> Kw {
    let dk = geti(a, o, F_DK);
    let mut k = kw_setdefault(kw, W_QC, qb_quote(dk));
    k = kw_setdefault(k, W_SQC, s_("'"));
    k = kw_setdefault(k, W_AQC, qb_alias_quote(dk));
    k = kw_setdefault(k, W_ASK, get(a, o, F_ASKW));
    kw_setdefault(k, W_DIA, get(a, o, F_DIALECT))
}

fn qb_sql(a: mut ref A, o: i64, kw: ref Kw) -> Result[String, Exc] {
    let dk = geti(a, o, F_DK);
    if dk == D_MYSQL {
        let k = qb_defaults(a, o, kw);
        let mut s = base_qb_sql(mut a, o, k)?;
        if s.len() > 0 {
            if llen(a, o, F_DUPUPD) > 0 {
                s = s + " ON DUPLICATE KEY UPDATE " + updates_sql(mut a, lget(a, o, F_DUPUPD), k, false)?;
            } else if getb(a, o, F_IGNDUP) {
                s = s + " ON DUPLICATE KEY IGNORE";
            }
        }
        return Ok(s);
    }
    if dk == D_PG {
        let wa = kw_or(kw, W_WA, Val.Bool(false));
        let sub = kw_or(kw, W_SUB, Val.Bool(false));
        let rest = kw_del(kw_del(kw, W_WA), W_SUB);
        let mut k = qb_defaults(a, o, rest);
        let mut s = base_qb_sql(mut a, o, kw_with2(k, W_WA, wa, W_SUB, sub))?;
        s = s + on_conflict_sql(mut a, o, k)?;
        s = s + on_conflict_action_sql(mut a, o, k)?;
        if llen(a, o, F_RETURNS) > 0 {
            let up = get(a, o, F_UPDATE);
            k = kw_set(k, W_WN, if py_truthy(up) { Val.Bool(true) } else { up });
            let mut parts: Vec[String] = Vec.new();
            for t in lget(a, o, F_RETURNS) {
                parts.push(sql(mut a, t, kw_with(k, W_WA, Val.Bool(true)))?);
            }
            s = s + " RETURNING " + join_strs(parts, ",");
        }
        return Ok(s);
    }
    if dk == D_ORACLE or dk == D_MSSQL {
        let k = kw_set(kw, W_GBA, Val.Bool(false));
        return base_qb_sql(mut a, o, k);
    }
    if dk == D_VERTICA {
        let s = base_qb_sql(mut a, o, kw)?;
        let h = get(a, o, F_HINT);
        if not is_nothing(h) {
            let hs = pystr(mut a, h)?;
            let head = if s.len() >= 7 { s.substring(0, 7) } else { s.clone() };
            let tail = if s.len() >= 6 { s.substring(6, s.len()) } else { String.new() };
            return Ok(head + "/*+label(" + hs + ")*/" + tail);
        }
        return Ok(s);
    }
    base_qb_sql(mut a, o, kw)
}

fn sql_list(a: mut ref A, xs: ref Vec[Val], kw: ref Kw, sep: Str) -> Result[String, Exc] {
    let mut parts: Vec[String] = Vec.new();
    for x in xs {
        parts.push(sql(mut a, x, kw)?);
    }
    Ok(join_strs(parts, sep))
}

// "field=value,..." for update pairs; `no_ns` renders the field with
// with_namespace=False, as _set_sql does.
fn updates_sql(a: mut ref A, pairs: ref Vec[Val], kw: ref Kw, no_ns: bool) -> Result[String, Exc] {
    let mut parts: Vec[String] = Vec.new();
    for p in pairs {
        let fv = items(a, p);
        let fk = if no_ns { kw_set(kw, W_WN, Val.Bool(false)) } else { kw.clone() };
        let f = sql(mut a, fv[0], fk)?;
        let v = sql(mut a, fv[1], kw)?;
        parts.push(f + "=" + v);
    }
    Ok(join_strs(parts, ","))
}

fn qb_select_sql(a: mut ref A, o: i64, kw: ref Kw) -> Result[String, Exc] {
    let dk = geti(a, o, F_DK);
    let sk = kw_with2(kw, W_WA, Val.Bool(true), W_SUB, Val.Bool(true));
    let sels = sql_list(mut a, lget(a, o, F_SELECTS), sk, ",")?;
    let distinct = if getb(a, o, F_QDISTINCT) { "DISTINCT " } else { "" };
    if dk == D_MYSQL {
        let mods = lget(a, o, F_MODIFIERS);
        let mut ms = String.new();
        if mods.len() > 0 {
            let mut parts: Vec[String] = Vec.new();
            for m in mods {
                parts.push(pystr(mut a, m)?);
            }
            ms = join_strs(parts, " ") + " ";
        }
        return Ok("SELECT " + distinct + ms + sels);
    }
    if dk == D_MSSQL {
        let mut top = String.new();
        let tv = get(a, o, F_TOP);
        if py_truthy(tv) {
            let n = pystr(mut a, tv)?;
            top = "TOP (" + n + ") ";
            if getb(a, o, F_TOPPCT) {
                top = top + "PERCENT ";
            }
            if getb(a, o, F_TOPTIES) {
                top = top + "WITH TIES ";
            }
        }
        return Ok("SELECT " + distinct + top + sels);
    }
    let mut ds = distinct.to_string();
    if dk == D_PG and llen(a, o, F_DISTON) > 0 {
        let dkw = kw_with(kw, W_WA, Val.Bool(true));
        ds = "DISTINCT ON(" + sql_list(mut a, lget(a, o, F_DISTON), dkw, ",")? + ") ";
    }
    Ok("SELECT " + ds + sels)
}

fn qb_from_sql(a: mut ref A, o: i64, k: i64, word: Str, kw: ref Kw) -> Result[String, Exc] {
    let rest = kw_del(kw, W_WN);
    let fk = kw_with2(rest, W_SUB, Val.Bool(true), W_WA, Val.Bool(true));
    let s = sql_list(mut a, lget(a, o, k), fk, ",")?;
    if geti(a, o, F_DK) == D_CH and k == F_FROM {
        if getb(a, o, F_DELETE) {
            return Ok(" " + s + " DELETE");
        }
    }
    Ok(f" {word} {s}")
}

fn selected_aliases(a: ref A, sels: ref Vec[Val]) -> Vec[Val] {
    let mut out: Vec[Val] = Vec.new();
    for s in sels {
        out.push(get(a, obj_id(s), F_ALIAS));
    }
    out
}

fn alias_in(al: ref Val, aliases: ref Vec[Val]) -> bool {
    for x in aliases {
        if same_val(x, al) {
            return true;
        }
    }
    false
}

// _group_sql and _orderby_sql: a term whose alias names a selected term
// is written as the alias.
fn alias_or_sql(a: mut ref A, field: ref Val, use_alias: bool, aliases: ref Vec[Val], qc: ref Val, aqc: ref Val,
    rest: ref Kw) -> Result[String, Exc] {
    let al = get(a, obj_id(field), F_ALIAS);
    if use_alias and py_truthy(al) and alias_in(al, aliases) {
        let q = if py_truthy(aqc) { aqc.clone() } else { qc.clone() };
        return fqv(mut a, al, q);
    }
    let k = kw_with2(rest, W_QC, qc.clone(), W_AQC, aqc.clone());
    sql(mut a, field, k)
}

fn base_qb_sql(a: mut ref A, o: i64, kw0_: ref Kw) -> Result[String, Exc] {
    let wa = kw_get(kw0_, W_WA);
    let sub = kw_get(kw0_, W_SUB);
    let mut kw = qb_defaults(a, o, kw_del(kw_del(kw0_, W_WA), W_SUB));
    let dk = geti(a, o, F_DK);
    let nsel = llen(a, o, F_SELECTS);
    let ins = get(a, o, F_INSERT);
    let upd = get(a, o, F_UPDATE);
    let del = getb(a, o, F_DELETE);
    if not (nsel > 0 or py_truthy(ins) or del or py_truthy(upd)) {
        return Ok(String.new());
    }
    if py_truthy(ins) and not (nsel > 0 or llen(a, o, F_QVALUES) > 0) {
        return Ok(String.new());
    }
    if py_truthy(upd) and llen(a, o, F_UPDATES) == 0 {
        return Ok(String.new());
    }
    let froms = lget(a, o, F_FROM);
    let joins = lget(a, o, F_JOINS);
    let wn = joins.len() > 0 or froms.len() > 1 or (froms.len() > 0 and is_qb(a, froms[0])) or getb(a, o, F_FOREIGN)
        or (py_truthy(upd) and froms.len() > 0);
    kw = kw_set(kw, W_WN, Val.Bool(wn));
    let has_with = llen(a, o, F_WITH) > 0;
    let mut qs = String.new();
    if py_truthy(upd) {
        if has_with {
            qs = with_sql(mut a, o, kw)?;
        }
        let word = if dk == D_CH { "ALTER TABLE " } else { "UPDATE " };
        qs = qs + word + sql(mut a, upd, kw)?;
        if joins.len() > 0 {
            qs = qs + " " + sql_list(mut a, joins, kw, " ")?;
        }
        let set_word = if dk == D_CH { " UPDATE " } else { " SET " };
        qs = qs + set_word + updates_sql(mut a, lget(a, o, F_UPDATES), kw, true)?;
        if froms.len() > 0 {
            qs = qs + qb_from_sql(mut a, o, F_FROM, "FROM", kw)?;
        }
        let wh = get(a, o, F_WHERES);
        if py_truthy(wh) {
            qs = qs + where_sql(mut a, wh, "WHERE", kw)?;
        }
        let lim = get(a, o, F_LIMIT);
        if not is_nothing(lim) {
            qs = qs + limit_sql(mut a, o)?;
        }
        return Ok(qs);
    }
    if del {
        qs = if dk == D_CH { "ALTER TABLE".to_string() } else { "DELETE".to_string() };
    } else if not getb(a, o, F_SELINTO) and py_truthy(ins) {
        if has_with {
            qs = with_sql(mut a, o, kw)?;
        }
        if getb(a, o, F_REPLACE) {
            let prefix = if dk == D_SQLITE and getb(a, o, F_INSREPL) { "INSERT OR " } else { "" };
            qs = qs + prefix + "REPLACE INTO " + sql(mut a, ins, kw)?;
        } else {
            let ig = if getb(a, o, F_IGNORE) { "IGNORE " } else { "" };
            qs = qs + "INSERT " + ig + "INTO " + sql(mut a, ins, kw)?;
        }
        if llen(a, o, F_COLUMNS) > 0 {
            let ck = kw_with(kw, W_WN, Val.Bool(false));
            qs = qs + " (" + sql_list(mut a, lget(a, o, F_COLUMNS), ck, ",")? + ")";
        }
        let rows = lget(a, o, F_QVALUES);
        if rows.len() > 0 {
            let vk = kw_with2(kw, W_WA, Val.Bool(true), W_SUB, Val.Bool(true));
            let mut rs: Vec[String] = Vec.new();
            for r in rows {
                rs.push(sql_list(mut a, items(a, r), vk, ",")?);
            }
            qs = qs + " VALUES (" + join_strs(rs, "),(") + ")";
            return Ok(qs);
        }
        qs = qs + " " + qb_select_sql(mut a, o, kw)?;
    } else {
        if has_with {
            qs = with_sql(mut a, o, kw)?;
        }
        qs = qs + qb_select_sql(mut a, o, kw)?;
        if py_truthy(ins) {
            qs = qs + " INTO " + sql(mut a, ins, kw_with(kw, W_WA, Val.Bool(false)))?;
        }
    }
    if froms.len() > 0 {
        qs = qs + qb_from_sql(mut a, o, F_FROM, "FROM", kw)?;
    }
    if llen(a, o, F_USING) > 0 {
        qs = qs + qb_from_sql(mut a, o, F_USING, "USING", kw)?;
    }
    if llen(a, o, F_FORCEIDX) > 0 {
        qs = qs + " FORCE INDEX (" + sql_list(mut a, lget(a, o, F_FORCEIDX), kw, ",")? + ")";
    }
    if llen(a, o, F_USEIDX) > 0 {
        qs = qs + " USE INDEX (" + sql_list(mut a, lget(a, o, F_USEIDX), kw, ",")? + ")";
    }
    if joins.len() > 0 {
        qs = qs + " " + sql_list(mut a, joins, kw, " ")?;
    }
    let pw = get(a, o, F_PREWHERES);
    if py_truthy(pw) {
        qs = qs + where_sql(mut a, pw, "PREWHERE", kw)?;
    }
    let wh = get(a, o, F_WHERES);
    if py_truthy(wh) {
        qs = qs + where_sql(mut a, wh, "WHERE", kw)?;
    }
    let sels = lget(a, o, F_SELECTS);
    let aliases = selected_aliases(a, sels);
    if llen(a, o, F_GROUPBYS) > 0 {
        let qc = kw_or(kw, W_QC, Val.Non);
        let aqc = kw_or(kw, W_AQC, Val.Non);
        let gba = kw_or(kw, W_GBA, Val.Bool(true));
        let rest = kw_del(kw_del(kw_del(kw, W_QC), W_AQC), W_GBA);
        let mut cl: Vec[String] = Vec.new();
        for g in lget(a, o, F_GROUPBYS) {
            cl.push(alias_or_sql(mut a, g, py_truthy(gba), aliases, qc, aqc, rest)?);
        }
        qs = qs + " GROUP BY " + join_strs(cl, ",");
        if getb(a, o, F_WITHTOTALS) {
            qs = qs + " WITH TOTALS";
        }
        if getb(a, o, F_MYSQLROLLUP) {
            qs = qs + " WITH ROLLUP";
        }
    }
    let hv = get(a, o, F_HAVINGS);
    if py_truthy(hv) {
        let qc = kw_or(kw, W_QC, Val.Non);
        let rest = kw_del(kw, W_QC);
        qs = qs + " HAVING " + sql(mut a, hv, kw_with(rest, W_QC, qc))?;
    }
    let obs = lget(a, o, F_QORDERBYS);
    if obs.len() > 0 {
        let qc = kw_or(kw, W_QC, Val.Non);
        let aqc = kw_or(kw, W_AQC, Val.Non);
        let oba = kw_or(kw, W_OBA, Val.Bool(true));
        let rest = kw_del(kw_del(kw_del(kw, W_QC), W_AQC), W_OBA);
        let mut cl: Vec[String] = Vec.new();
        for ob in obs {
            let pair = items(a, ob);
            let t = alias_or_sql(mut a, pair[0], py_truthy(oba), aliases, qc, aqc, rest)?;
            cl.push(if is_nothing(pair[1]) { t } else { t + " " + ev(pair[1]) });
        }
        qs = qs + " ORDER BY " + join_strs(cl, ",");
    }
    qs = qs + pagination_sql(mut a, o)?;
    if getb(a, o, F_FORUPD) {
        qs = qs + for_update_sql(mut a, o, kw)?;
    }
    if py_truthy(sub) {
        qs = "(" + qs + ")";
    }
    if py_truthy(wa) {
        let qaq = qb_query_alias_quote(dk);
        kw = kw_set(kw, W_AQC, if is_none(qaq) { qb_alias_quote(dk) } else { qaq });
        let al = get(a, o, F_ALIAS);
        return fmt_alias_kw(mut a, qs, al, kw);
    }
    Ok(qs)
}

fn with_sql(a: mut ref A, o: i64, kw: ref Kw) -> Result[String, Exc] {
    let mut parts: Vec[String] = Vec.new();
    let wk = kw_with2(kw, W_SUB, Val.Bool(false), W_WA, Val.Bool(false));
    for c in lget(a, o, F_WITH) {
        let n = pystr(mut a, get(a, obj_id(c), F_NAME))?;
        parts.push(n + " AS (" + sql(mut a, c, wk)? + ") ");
    }
    Ok("WITH " + join_strs(parts, ","))
}

// _where_sql / _prewhere_sql
fn where_sql(a: mut ref A, crit: ref Val, word: Str, kw: ref Kw) -> Result[String, Exc] {
    let qc = kw_or(kw, W_QC, Val.Non);
    let rest = kw_del(kw, W_QC);
    let s = sql(mut a, crit, kw_with2(rest, W_QC, qc, W_SUB, Val.Bool(true)))?;
    Ok(f" {word} {s}")
}

fn limit_sql(a: mut ref A, o: i64) -> Result[String, Exc] {
    let l = pystr(mut a, get(a, o, F_LIMIT))?;
    if geti(a, o, F_DK) == D_MSSQL {
        return Ok(" FETCH NEXT " + l + " ROWS ONLY");
    }
    Ok(" LIMIT " + l)
}

fn pagination_sql(a: mut ref A, o: i64) -> Result[String, Exc] {
    let lim = get(a, o, F_LIMIT);
    let off = get(a, o, F_OFFSET);
    let mut s = String.new();
    if geti(a, o, F_DK) == D_MSSQL {
        if not is_nothing(lim) or py_truthy(off) {
            let os = if py_truthy(off) { pystr(mut a, off)? } else { "0".to_string() };
            s = s + " OFFSET " + os + " ROWS";
        }
        if not is_nothing(lim) {
            s = s + limit_sql(mut a, o)?;
        }
        return Ok(s);
    }
    if not is_nothing(lim) {
        s = s + limit_sql(mut a, o)?;
    }
    if py_truthy(off) {
        s = s + " OFFSET " + pystr(mut a, off)?;
    }
    Ok(s)
}

fn for_update_sql(a: mut ref A, o: i64, kw: ref Kw) -> Result[String, Exc] {
    let dk = geti(a, o, F_DK);
    let mut s = " FOR UPDATE".to_string();
    if dk == D_MYSQL or dk == D_PG {
        let of = lget(a, o, F_FUOF);
        if of.len() > 0 {
            let mut parts: Vec[String] = Vec.new();
            for item in of {
                let t = mk_table(mut a, item, Val.Non, Val.Non, D_BASE);
                parts.push(sql(mut a, t, kw)?);
            }
            s = s + " OF " + join_strs(parts, ", ");
        }
        if getb(a, o, F_FUNOWAIT) {
            s = s + " NOWAIT";
        } else if getb(a, o, F_FUSKIP) {
            s = s + " SKIP LOCKED";
        }
    }
    Ok(s)
}

fn on_conflict_sql(a: mut ref A, o: i64, kw: ref Kw) -> Result[String, Exc] {
    let fields = lget(a, o, F_ONCFIELDS);
    let nups = llen(a, o, F_ONCUPDATES);
    if not getb(a, o, F_ONCNOTHING) and nups == 0 {
        if fields.len() == 0 {
            return Ok(String.new());
        }
        return Err(query_error("No handler defined for on conflict"));
    }
    if nups > 0 and fields.len() == 0 {
        return Err(query_error("Can not have fieldless on conflict do update"));
    }
    let mut s = " ON CONFLICT".to_string();
    if fields.len() > 0 {
        s = s + " (" + sql_list(mut a, fields, kw_with(kw, W_WA, Val.Bool(true)), ", ")? + ")";
    }
    let w = get(a, o, F_ONCWHERES);
    if py_truthy(w) {
        s = s + " WHERE " + sql(mut a, w, kw_with(kw, W_SUB, Val.Bool(true)))?;
    }
    Ok(s)
}

fn on_conflict_action_sql(a: mut ref A, o: i64, kw: ref Kw) -> Result[String, Exc] {
    if getb(a, o, F_ONCNOTHING) {
        return Ok(" DO NOTHING".to_string());
    }
    let ups = lget(a, o, F_ONCUPDATES);
    if ups.len() == 0 {
        return Ok(String.new());
    }
    let mut parts: Vec[String] = Vec.new();
    for p in ups {
        let fv = items(a, p);
        let f = sql(mut a, fv[0], kw)?;
        if py_truthy(fv[1]) {
            let v = sql(mut a, fv[1], kw_with(kw, W_WN, Val.Bool(true)))?;
            parts.push(f + "=" + v);
        } else {
            let f2 = sql(mut a, fv[0], kw)?;
            parts.push(f + "=EXCLUDED." + f2);
        }
    }
    let mut s = " DO UPDATE SET " + join_strs(parts, ",");
    let w = get(a, o, F_ONCUPDWHERES);
    if py_truthy(w) {
        s = s + " WHERE " + sql(mut a, w, kw_with2(kw, W_SUB, Val.Bool(true), W_WN, Val.Bool(true)))?;
    }
    Ok(s)
}

// len(q._selects) for one side of a set operation.
fn selects_len(a: ref A, q: ref Val) -> Result[i64, Exc] {
    if is_qb(a, q) {
        return Ok(llen(a, obj_id(q), F_SELECTS));
    }
    let c = if is_selectable(a, q) { "Field".to_string() } else { py_cls(a, q) };
    Err(type_error(f"object of type '{c}' has no len()"))
}

fn setop_sql(a: mut ref A, o: i64, kw: ref Kw) -> Result[String, Exc] {
    let wa = kw_get(kw, W_WA);
    let sub = kw_get(kw, W_SUB);
    let base = get(a, o, F_BASE);
    let bo = obj_id(base);
    let mut rest = kw_del(kw_del(kw, W_WA), W_SUB);
    rest = kw_setdefault(rest, W_DIA, get(a, bo, F_DIALECT));
    rest = kw_setdefault(rest, W_QC, qb_quote(geti(a, bo, F_DK)));
    let wrap_ = get(a, bo, F_WRAPSET);
    let bk = kw_with(rest, W_SUB, wrap_);
    let base_qs = sql(mut a, base, bk)?;
    let mut qs = base_qs.clone();
    for so in lget(a, o, F_SETOPS) {
        let pair = items(a, so);
        let oqs = sql(mut a, pair[1], bk)?;
        let n1 = llen(a, bo, F_SELECTS);
        let n2 = selects_len(a, pair[1])?;
        if n1 != n2 {
            return Err(exc("SetOperationException", "Queries must have an equal number of select statements in a set operation.\n\nMain Query:\n"
                + base_qs + "\n\nSet Operations Query:\n" + oqs));
        }
        qs = qs + " " + ev(pair[0]) + " " + oqs;
    }
    let obs = lget(a, o, F_ORDERBYS);
    if obs.len() > 0 {
        let qc = kw_or(rest, W_QC, Val.Non);
        let r2 = kw_del(rest, W_QC);
        let aliases = selected_aliases(a, lget(a, bo, F_SELECTS));
        let mut cl: Vec[String] = Vec.new();
        for ob in obs {
            let pair = items(a, ob);
            let al = get(a, obj_id(pair[0]), F_ALIAS);
            let t = if py_truthy(al) and alias_in(al, aliases) {
                fqv(mut a, al, qc)?
            } else {
                sql(mut a, pair[0], kw_with(r2, W_QC, qc.clone()))?
            };
            cl.push(if is_nothing(pair[1]) { t } else { t + " " + ev(pair[1]) });
        }
        qs = qs + " ORDER BY " + join_strs(cl, ",");
    }
    let lim = get(a, o, F_LIMIT);
    if not is_nothing(lim) {
        qs = qs + " LIMIT " + pystr(mut a, lim)?;
    }
    let off = get(a, o, F_OFFSET);
    if py_truthy(off) {
        qs = qs + " OFFSET " + pystr(mut a, off)?;
    }
    if py_truthy(sub) {
        qs = "(" + qs + ")";
    }
    if py_truthy(wa) {
        let al0 = get(a, o, F_ALIAS);
        let al = if py_truthy(al0) { al0 } else { s_("\"_table_name\"") };
        return fmt_alias_kw(mut a, qs, al, rest);
    }
    Ok(qs)
}

fn join_sql(a: mut ref A, o: i64, kw: ref Kw) -> Result[String, Exc] {
    let item = get(a, o, F_ITEM);
    let ik = kw_with2(kw, W_SUB, Val.Bool(true), W_WA, Val.Bool(true));
    let mut s = "JOIN " + sql(mut a, item, ik)?;
    let how = ev(get(a, o, F_HOW));
    if how.len() > 0 {
        s = how + " " + s;
    }
    let kind = gets(a, o, F_KIND);
    if kind == "JoinOn" {
        let c = sql(mut a, get(a, o, F_CRIT), kw_with(kw, W_SUB, Val.Bool(true)))?;
        let col = get(a, o, F_COLLATE);
        let cs = if py_truthy(col) { " COLLATE " + pystr(mut a, col)? } else { String.new() };
        return Ok(s + " ON " + c + cs);
    }
    if kind == "JoinUsing" {
        let fs = sql_list(mut a, lget(a, o, F_JFIELDS), kw, ",")?;
        return Ok(s + " USING (" + fs + ")");
    }
    Ok(s)
}

// Create builders: F_DK 0 plain, D_MYSQL, D_SNOW or D_VERTICA.
fn create_sql(a: mut ref A, o: i64, kw: ref Kw) -> Result[String, Exc] {
    let ck = geti(a, o, F_DK);
    let mut k = kw_setdefault(kw, W_QC, qb_quote(ck));
    k = kw_setdefault(k, W_SQC, s_("'"));
    k = kw_setdefault(k, W_DIA, get(a, o, F_DIALECT));
    let ct = get(a, o, F_CT);
    if not py_truthy(ct) {
        return Ok(String.new());
    }
    let assel = get(a, o, F_ASSEL);
    let cols = lget(a, o, F_COLUMNS);
    if cols.len() == 0 and not py_truthy(assel) {
        return Ok(String.new());
    }
    let ts = sql(mut a, ct, k)?;
    let mut head = String.new();
    if ck == D_VERTICA {
        let local = if getb(a, o, F_LOCAL) { "LOCAL " } else { "" };
        let temp = if getb(a, o, F_TEMP) { "TEMPORARY " } else { "" };
        head = "CREATE " + local + temp + "TABLE " + ts;
    } else {
        let tt = if getb(a, o, F_TEMP) { "TEMPORARY " } else if getb(a, o, F_UNLOG) { "UNLOGGED " } else { "" };
        let ine = if getb(a, o, F_INE) { "IF NOT EXISTS " } else { "" };
        head = "CREATE " + tt + "TABLE " + ine + ts;
    }
    let preserve = if ck == D_VERTICA and getb(a, o, F_PRESERVE) { " ON COMMIT PRESERVE ROWS" } else { "" };
    if py_truthy(assel) {
        return Ok(head + preserve + " AS (" + sql(mut a, assel, k)? + ")");
    }
    let mut clauses: Vec[String] = Vec.new();
    for c in cols {
        clauses.push(sql(mut a, c, k)?);
    }
    for p in lget(a, o, F_PERIODS) {
        clauses.push(sql(mut a, p, k)?);
    }
    for u in lget(a, o, F_UNIQUES) {
        clauses.push("UNIQUE (" + names_sql(mut a, items(a, u), k)? + ")");
    }
    let pk = get(a, o, F_PK);
    if py_truthy(pk) and items(a, pk).len() > 0 {
        clauses.push("PRIMARY KEY (" + names_sql(mut a, items(a, pk), k)? + ")");
    }
    let fk = get(a, o, F_FKCOLS);
    if py_truthy(fk) and items(a, fk).len() > 0 {
        let cs = names_sql(mut a, items(a, fk), k)?;
        let rt = sql(mut a, get(a, o, F_FKTABLE), k)?;
        let rs = names_sql(mut a, lget(a, o, F_FKREF), k)?;
        let mut cl = "FOREIGN KEY (" + cs + ") REFERENCES " + rt + " (" + rs + ")";
        let d = get(a, o, F_FKDEL);
        if py_truthy(d) {
            cl = cl + " ON DELETE " + ev(d);
        }
        let u = get(a, o, F_FKUPD);
        if py_truthy(u) {
            cl = cl + " ON UPDATE " + ev(u);
        }
        clauses.push(cl);
    }
    let sv_ = if getb(a, o, F_SYSVER) { " WITH SYSTEM VERSIONING" } else { "" };
    Ok(head + " (" + join_strs(clauses, ",") + ")" + sv_ + preserve)
}

fn names_sql(a: mut ref A, cols: ref Vec[Val], kw: ref Kw) -> Result[String, Exc] {
    let mut parts: Vec[String] = Vec.new();
    for c in cols {
        parts.push(column_name_sql(mut a, obj_id(c), kw)?);
    }
    Ok(join_strs(parts, ","))
}

fn drop_sql(a: mut ref A, o: i64, kw: ref Kw) -> Result[String, Exc] {
    let dk = geti(a, o, F_DK);
    let mut k = kw_setdefault(kw, W_QC, qb_quote(dk));
    k = kw_setdefault(k, W_SQC, s_("'"));
    k = kw_setdefault(k, W_DIA, get(a, o, F_DIALECT));
    let ie = if getb(a, o, F_IFEX) { "IF EXISTS " } else { "" };
    let t = get(a, o, F_DTARGET);
    let c = cls_of(a, t);
    let name = if c == C_SCHEMA or c == C_TABLE { sql(mut a, t, k)? } else { fqv(mut a, t, qb_quote(dk))? };
    let kind = pystr(mut a, get(a, o, F_DTKIND))?;
    Ok("DROP " + kind + " " + ie + name)
}

// ------------------------------------------------------------ equality, hashing and the node tree

// `x == y` as Python decides it, read as a truth value: the library's
// classes compare by their names, and any other Term builds a
// BasicCriterion, which is always true.
fn py_eq(a: ref A, x: ref Val, y: ref Val) -> bool {
    if identical(x, y) {
        return true;
    }
    let cx = cls_of(a, x);
    let cy = cls_of(a, y);
    if cx == C_TABLE {
        if cy != C_TABLE {
            return false;
        }
        let ox = obj_id(x);
        let oy = obj_id(y);
        return same_val(get(a, ox, F_TNAME), get(a, oy, F_TNAME))
            and schema_eq(a, get(a, ox, F_SCHEMA), get(a, oy, F_SCHEMA))
            and same_val(get(a, ox, F_ALIAS), get(a, oy, F_ALIAS));
    }
    if cx == C_QB {
        return cy == C_QB and same_val(get(a, obj_id(x), F_ALIAS), get(a, obj_id(y), F_ALIAS));
    }
    if cx == C_ALIASQ {
        return cy == C_ALIASQ and same_val(get(a, obj_id(x), F_NAME), get(a, obj_id(y), F_NAME));
    }
    if cx == C_SCHEMA {
        return schema_eq(a, x, y);
    }
    if is_term_cls(cx) {
        return true;
    }
    if is_nothing(x) {
        // None.__eq__ gives way to the other side's reflected __eq__.
        if is_nothing(y) {
            return true;
        }
        return is_term_cls(cy) and cy != C_QB;
    }
    same_val(x, y)
}

fn py_ne(a: ref A, x: ref Val, y: ref Val) -> bool {
    let cx = cls_of(a, x);
    if is_term_cls(cx) and cx != C_QB {
        return true;
    }
    if is_nothing(x) {
        if is_nothing(y) {
            return false;
        }
        return true;
    }
    not py_eq(a, x, y)
}

fn schema_eq(a: ref A, x: ref Val, y: ref Val) -> bool {
    if is_nothing(x) or is_nothing(y) {
        return is_nothing(x) and is_nothing(y);
    }
    if cls_of(a, x) != C_SCHEMA or cls_of(a, y) != C_SCHEMA {
        return false;
    }
    let ox = obj_id(x);
    let oy = obj_id(y);
    same_val(get(a, ox, F_NAME), get(a, oy, F_NAME)) and schema_eq(a, get(a, ox, F_PARENT), get(a, oy, F_PARENT))
}

// A stand-in for hash(v): values with equal keys are the ones Python
// compares with == when it looks them up in a set.
fn hkey(a: mut ref A, v: ref Val) -> Result[String, Exc] {
    if is_nothing(v) {
        return Ok("None".to_string());
    }
    let c = cls_of(a, v);
    if c == C_TABLE {
        return Ok("S" + pystr(mut a, v)?);
    }
    if c == C_QB {
        let o = obj_id(v);
        let mut k = "Q" + pyrepr(mut a, get(a, o, F_ALIAS))?;
        for f in lget(a, o, F_FROM) {
            k = k + "|" + hkey(mut a, f)?;
        }
        return Ok(k);
    }
    if c == C_ALIASQ {
        return Ok("S" + pystr(mut a, get(a, obj_id(v), F_NAME))?);
    }
    if is_term_cls(c) {
        return Ok("S" + sql(mut a, v, kw2(W_WA, Val.Bool(true), W_WN, Val.Bool(true)))?);
    }
    if c >= 0 {
        return Ok(f"O{obj_id(v)}");
    }
    Ok("V" + pyrepr(mut a, v)?)
}

// x in s, for a set s held as a list.
fn set_has(a: mut ref A, s: ref Vec[Val], x: ref Val) -> Result[bool, Exc] {
    let kx = hkey(mut a, x)?;
    for e in s {
        if identical(e, x) {
            return Ok(true);
        }
        if hkey(mut a, e)? == kx and py_eq(a, e, x) {
            return Ok(true);
        }
    }
    Ok(false)
}

fn set_add(a: mut ref A, s: ref Vec[Val], x: ref Val) -> Result[Vec[Val], Exc] {
    let mut out = s.clone();
    if not set_has(mut a, s, x)? {
        out.push(x.clone());
    }
    Ok(out)
}

// x in xs, for a list.
fn list_has(a: ref A, xs: ref Vec[Val], x: ref Val) -> bool {
    for e in xs {
        if identical(e, x) or py_eq(a, e, x) {
            return true;
        }
    }
    false
}

// Node.nodes_(): the term and what it is built from, in the library's
// order.
fn nodes(a: ref A, v: ref Val, out: mut ref Vec[Val]) {
    out.push(v.clone());
    let o = obj_id(v);
    if o < 0 {
        return;
    }
    let c = a.objs[o].cls;
    if c == C_FIELD or c == C_STAR {
        let t = get(a, o, F_TABLE);
        if not is_nothing(t) {
            nodes(a, t, mut out);
        }
    } else if c == C_TUPLE or c == C_ARRAY or c == C_BRACKET {
        for x in lget(a, o, F_VALUES) {
            nodes(a, x, mut out);
        }
    } else if c == C_BASIC or c == C_COMPLEX {
        nodes(a, get(a, o, F_RIGHT), mut out);
        nodes(a, get(a, o, F_LEFT), mut out);
    } else if c == C_CONTAINS {
        nodes(a, get(a, o, F_TERM), mut out);
        nodes(a, get(a, o, F_CONTAINER), mut out);
    } else if c == C_BETWEEN or c == C_PERIOD {
        nodes(a, get(a, o, F_TERM), mut out);
        nodes(a, get(a, o, F_START), mut out);
        nodes(a, get(a, o, F_END), mut out);
    } else if c == C_BITAND {
        nodes(a, get(a, o, F_TERM), mut out);
        nodes(a, get(a, o, F_VALUE), mut out);
    } else if c == C_NULLC or c == C_NOTNULLC or c == C_NOT or c == C_ALL {
        nodes(a, get(a, o, F_TERM), mut out);
    } else if c == C_ARITH {
        nodes(a, get(a, o, F_LEFT), mut out);
        nodes(a, get(a, o, F_RIGHT), mut out);
    } else if c == C_CASE {
        for cs in lget(a, o, F_CASES) {
            let pair = items(a, cs);
            nodes(a, pair[0], mut out);
            nodes(a, pair[1], mut out);
        }
        let el = get(a, o, F_ELSE);
        if not is_nothing(el) {
            nodes(a, el, mut out);
        }
    } else if c == C_FUNC {
        for x in lget(a, o, F_ARGS) {
            nodes(a, x, mut out);
        }
    }
}

// term.fields_(): the Fields (and Stars) in the tree.
fn fields_of(a: ref A, v: ref Val) -> Vec[Val] {
    let mut out: Vec[Val] = Vec.new();
    let c = cls_of(a, v);
    if c == C_EMPTY or c == C_QB {
        return out;
    }
    let mut ns: Vec[Val] = Vec.new();
    nodes(a, v, mut ns);
    for n in ns {
        if is_field(a, n) {
            out.push(n.clone());
        }
    }
    out
}

// term.tables_
fn tables_of(a: ref A, v: ref Val) -> Vec[Val] {
    let mut out: Vec[Val] = Vec.new();
    if cls_of(a, v) == C_EMPTY {
        return out;
    }
    let mut ns: Vec[Val] = Vec.new();
    nodes(a, v, mut ns);
    for n in ns {
        if is_table(a, n) {
            out.push(n.clone());
        }
    }
    out
}

fn tri(v: ref Val) -> i64 {
    match v {
        Val.Bool(b) => if b { 1 } else { 0 },
        _ => -1,
    }
}

fn tri_val(t: i64) -> Val {
    if t < 0 { Val.Non } else { Val.Bool(t == 1) }
}

// utils.resolve_is_aggregate over votes (1 True, 0 False, -1 None).
fn resolve_agg(votes: ref Vec[i64]) -> i64 {
    let mut seen = false;
    let mut all = true;
    for v in votes {
        if *v >= 0 {
            seen = true;
            if *v == 0 {
                all = false;
            }
        }
    }
    if not seen {
        return -1;
    }
    if all { 1 } else { 0 }
}

// v.is_aggregate: 1 True, 0 False, -1 None.
fn is_agg(a: ref A, v: ref Val) -> i64 {
    let o = obj_id(v);
    if o < 0 {
        return -1;
    }
    let c = a.objs[o].cls;
    if c == C_PARAM or c == C_VW or c == C_EMPTY or c == C_INTERVAL or c == C_TABLE or c == C_ALIASQ {
        return -1;
    }
    if c == C_NEG or c == C_CONTAINS or c == C_BETWEEN or c == C_PERIOD {
        return is_agg(a, get(a, o, F_TERM));
    }
    if c == C_TUPLE or c == C_ARRAY or c == C_BRACKET {
        let mut vs: Vec[i64] = Vec.new();
        for x in lget(a, o, F_VALUES) {
            vs.push(is_agg(a, x));
        }
        return resolve_agg(vs);
    }
    if c == C_BASIC or c == C_COMPLEX or c == C_ARITH {
        let vs = vec![is_agg(a, get(a, o, F_LEFT)), is_agg(a, get(a, o, F_RIGHT))];
        return resolve_agg(vs);
    }
    if c == C_CASE {
        let mut vs: Vec[i64] = Vec.new();
        for cs in lget(a, o, F_CASES) {
            let pair = items(a, cs);
            // criterion.is_aggregate or term.is_aggregate
            let x = is_agg(a, pair[0]);
            vs.push(if x == 1 { 1 } else { is_agg(a, pair[1]) });
        }
        let el = get(a, o, F_ELSE);
        vs.push(if py_truthy(el) { is_agg(a, el) } else { -1 });
        return resolve_agg(vs);
    }
    if c == C_FUNC {
        let fk = geti(a, o, F_FK);
        if has_bit(fk, B_ANA) {
            return 0;
        }
        if has_bit(fk, B_AGG) {
            return 1;
        }
        let mut vs: Vec[i64] = Vec.new();
        for x in lget(a, o, F_ARGS) {
            vs.push(is_agg(a, x));
        }
        return resolve_agg(vs);
    }
    if is_term_cls(c) {
        return 0;
    }
    -1
}

// ------------------------------------------------------------ call arguments

// A keyword argument of a call.
#[derive(Clone)]
struct Karg {
    k: String,
    v: Val,
}

fn karg(kws: ref Vec[Karg], name: Str) -> Val {
    for kv in kws {
        if kv.k == name {
            return kv.v.clone();
        }
    }
    Val.Absent
}

// The parameter at `i`, passed by position or by `name`.
fn param(args: ref Vec[Val], kws: ref Vec[Karg], i: i64, name: Str) -> Val {
    if i < args.len() {
        return args[i].clone();
    }
    karg(kws, name)
}

fn param_or(args: ref Vec[Val], kws: ref Vec[Karg], i: i64, name: Str, d: own Val) -> Val {
    let v = param(args, kws, i, name);
    if is_absent(v) { d } else { v }
}

fn no_attr(cls: Str, name: Str) -> Exc {
    attr_error(f"'{cls}' object has no attribute '{name}'")
}

// ------------------------------------------------------------ query builders

fn mk_qb(a: mut ref A, dk: i64, immutable: bool, askw: ref Val) -> Val {
    let o = new_obj(mut a, C_QB);
    set(mut a, o, F_ALIAS, Val.Non);
    set(mut a, o, F_DK, Val.Int(dk));
    let lists = vec![F_FROM, F_WITH, F_SELECTS, F_FORCEIDX, F_USEIDX, F_COLUMNS, F_QVALUES, F_GROUPBYS, F_QORDERBYS,
        F_JOINS, F_UNIONS, F_USING, F_UPDATES, F_STARTABLES];
    for k in lists {
        set_list(mut a, o, k, Vec.new());
    }
    let falses = vec![F_DELETE, F_REPLACE, F_QDISTINCT, F_IGNORE, F_FORUPD, F_WITHTOTALS, F_SELSTAR, F_MYSQLROLLUP,
        F_SELINTO, F_FOREIGN];
    for k in falses {
        set(mut a, o, k, Val.Bool(false));
    }
    let nones = vec![F_INSERT, F_UPDATE, F_WHERES, F_PREWHERES, F_HAVINGS, F_LIMIT, F_OFFSET];
    for k in nones {
        set(mut a, o, k, Val.Non);
    }
    set(mut a, o, F_SUBQCOUNT, Val.Int(0));
    set(mut a, o, F_DIALECT, dialect_of_kind(dk));
    let ask = if is_absent(askw) { Val.Bool(dk == D_CH) } else { askw.clone() };
    set(mut a, o, F_ASKW, ask);
    set(mut a, o, F_WRAPSET, Val.Bool(dk != D_MYSQL and dk != D_CH));
    set(mut a, o, F_SQLITEW, Val.Bool(dk == D_SQLITE));
    set(mut a, o, F_IMMUT, Val.Bool(immutable));
    if dk == D_MYSQL {
        set_list(mut a, o, F_DUPUPD, Vec.new());
        set(mut a, o, F_IGNDUP, Val.Bool(false));
        set_list(mut a, o, F_MODIFIERS, Vec.new());
    }
    if dk == D_MYSQL or dk == D_PG {
        set(mut a, o, F_FUNOWAIT, Val.Bool(false));
        set(mut a, o, F_FUSKIP, Val.Bool(false));
        set_list(mut a, o, F_FUOF, Vec.new());
    }
    if dk == D_PG {
        set_list(mut a, o, F_RETURNS, Vec.new());
        set(mut a, o, F_RETSTAR, Val.Bool(false));
        set(mut a, o, F_ONCONF, Val.Bool(false));
        set_list(mut a, o, F_ONCFIELDS, Vec.new());
        set(mut a, o, F_ONCNOTHING, Val.Bool(false));
        set_list(mut a, o, F_ONCUPDATES, Vec.new());
        set(mut a, o, F_ONCWHERES, Val.Non);
        set(mut a, o, F_ONCUPDWHERES, Val.Non);
        set_list(mut a, o, F_DISTON, Vec.new());
    }
    if dk == D_MSSQL {
        set(mut a, o, F_TOP, Val.Non);
        set(mut a, o, F_TOPTIES, Val.Bool(false));
        set(mut a, o, F_TOPPCT, Val.Bool(false));
    }
    if dk == D_VERTICA {
        set(mut a, o, F_HINT, Val.Non);
    }
    if dk == D_SQLITE {
        set(mut a, o, F_INSREPL, Val.Bool(false));
    }
    Val.Obj(o)
}

// The @builder decorator on a QueryBuilder: a copy made by its __copy__,
// which copies these lists and shares everything else.
fn qb_begin(a: mut ref A, o: i64) -> i64 {
    if not getb(a, o, F_IMMUT) {
        return o;
    }
    let q = copy_obj(mut a, o);
    let lists = vec![F_STARTABLES, F_FROM, F_WITH, F_SELECTS, F_COLUMNS, F_QVALUES, F_GROUPBYS, F_QORDERBYS,
        F_JOINS, F_UNIONS, F_UPDATES, F_FORCEIDX, F_USEIDX];
    for k in lists {
        lcopy(mut a, q, k);
    }
    let dk = geti(a, o, F_DK);
    if dk == D_PG {
        lcopy(mut a, q, F_RETURNS);
        lcopy(mut a, q, F_ONCUPDATES);
    }
    if dk == D_MYSQL {
        lcopy(mut a, q, F_DUPUPD);
    }
    q
}

fn qb_no_attr(name: Str) -> Exc {
    attr_error(f"'Query' object has no attribute '{name}'")
}

fn first_from(a: ref A, o: i64) -> Result[Val, Exc] {
    let fs = lget(a, o, F_FROM);
    if fs.len() == 0 {
        return Err(exc("IndexError", "list index out of range".to_string()));
    }
    Ok(fs[0].clone())
}

fn as_table(a: mut ref A, t: ref Val) -> Val {
    if is_table(a, t) {
        return t.clone();
    }
    mk_table(mut a, t, Val.Non, Val.Non, D_BASE)
}

// Selectable.from_
fn qb_from(a: mut ref A, q: i64, sel: ref Val) {
    let item = if is_str(sel) { as_table(mut a, sel) } else { sel.clone() };
    lpush(mut a, q, F_FROM, item);
    let c = cls_of(a, sel);
    if (c == C_QB or c == C_SETOP) and is_nothing(get(a, obj_id(sel), F_ALIAS)) {
        let sc = if c == C_QB { geti(a, obj_id(sel), F_SUBQCOUNT) } else { 0 };
        let mine = geti(a, q, F_SUBQCOUNT);
        let n = if mine > sc { mine } else { sc };
        set(mut a, obj_id(sel), F_ALIAS, sv(f"sq{n}"));
        set(mut a, q, F_SUBQCOUNT, Val.Int(n + 1));
    }
}

fn qb_select_field(a: mut ref A, q: i64, term: ref Val) -> Result[(), Exc] {
    if getb(a, q, F_SELSTAR) {
        return Ok(());
    }
    let tt = get(a, obj_id(term), F_TABLE);
    if set_has(mut a, lget(a, q, F_STARTABLES), tt)? {
        return Ok(());
    }
    if cls_of(a, term) == C_STAR {
        let mut keep: Vec[Val] = Vec.new();
        for s in lget(a, q, F_SELECTS) {
            let c = cls_of(a, s);
            let has_table = c == C_FIELD or c == C_STAR or is_selectable(a, s);
            if not has_table {
                keep.push(s.clone());
                continue;
            }
            let st = if c == C_FIELD or c == C_STAR { get(a, obj_id(s), F_TABLE) } else { field_of(mut a, "table".to_string(), s) };
            if py_ne(a, tt, st) {
                keep.push(s.clone());
            }
        }
        set_list(mut a, q, F_SELECTS, keep);
        let st = set_add(mut a, lget(a, q, F_STARTABLES), tt)?;
        set_list(mut a, q, F_STARTABLES, st);
    }
    lpush(mut a, q, F_SELECTS, term.clone());
    Ok(())
}

fn qb_select(a: mut ref A, q: i64, terms: ref Vec[Val]) -> Result[(), Exc] {
    for t in terms {
        if is_field(a, t) {
            qb_select_field(mut a, q, t)?;
        } else if is_str(t) {
            let s = str_of(t);
            if llen(a, q, F_FROM) == 0 {
                return Err(exc("QueryException", f"Cannot select {s}, no FROM table specified."));
            }
            if s == "*" {
                set(mut a, q, F_SELSTAR, Val.Bool(true));
                let st = mk_star(mut a, Val.Non);
                set_list(mut a, q, F_SELECTS, vec![st]);
                continue;
            }
            let ff = first_from(a, q)?;
            let f = field_of(mut a, s, ff);
            qb_select_field(mut a, q, f)?;
        } else if is_function(a, t) or cls_of(a, t) == C_ARITH {
            lpush(mut a, q, F_SELECTS, t.clone());
        } else {
            let w = wrap_constant(mut a, t, getb(a, q, F_SQLITEW));
            lpush(mut a, q, F_SELECTS, w);
        }
    }
    Ok(())
}

fn qb_apply_terms(a: mut ref A, q: i64, terms: ref Vec[Val]) -> Result[(), Exc] {
    if is_nothing(get(a, q, F_INSERT)) {
        return Err(qb_no_attr("insert"));
    }
    if terms.len() == 0 {
        return Ok(());
    }
    let rows: Vec[Vec[Val]] = if is_list_or_tuple(terms[0]) {
        let mut rs: Vec[Vec[Val]] = Vec.new();
        for t in terms {
            rs.push(items(a, t));
        }
        rs
    } else {
        vec![terms.clone()]
    };
    for row in rows {
        let mut ws: Vec[Val] = Vec.new();
        for v in row {
            if is_term(a, v) {
                ws.push(v.clone());
            } else {
                ws.push(wrap(mut a, v));
            }
        }
        let l = lst(mut a, ws);
        lpush(mut a, q, F_QVALUES, l);
    }
    Ok(())
}

// _validate_table: false when a field names a table the query does not
// read.
fn qb_validate_table(a: ref A, q: i64, term: ref Val) -> bool {
    let mut base = lget(a, q, F_FROM);
    let upd = get(a, q, F_UPDATE);
    base.push(upd.clone());
    let mut jitems: Vec[Val] = Vec.new();
    for j in lget(a, q, F_JOINS) {
        jitems.push(get(a, obj_id(j), F_ITEM));
    }
    for f in fields_of(a, term) {
        let t = get(a, obj_id(f), F_TABLE);
        if not is_nothing(t) and not list_has(a, base, t) and not list_has(a, jitems, t) and py_ne(a, t, upd) {
            return false;
        }
    }
    true
}

fn qb_where(a: mut ref A, q: i64, k: i64, crit: ref Val, validate: bool) -> Result[(), Exc] {
    if cls_of(a, crit) == C_EMPTY and k != F_PREWHERES {
        return Ok(());
    }
    if validate and not qb_validate_table(a, q, crit) {
        set(mut a, q, F_FOREIGN, Val.Bool(true));
    }
    let cur = get(a, q, k);
    if py_truthy(cur) {
        let c = binop(mut a, "&", cur, crit)?;
        set(mut a, q, k, c);
    } else {
        set(mut a, q, k, crit.clone());
    }
    Ok(())
}

fn is_rollup(a: ref A, v: ref Val) -> bool {
    is_function(a, v) and gets(a, obj_id(v), F_KIND) == "Rollup"
}

fn qb_rollup(a: mut ref A, q: i64, terms: ref Vec[Val], kws: ref Vec[Karg]) -> Result[(), Exc] {
    let for_mysql = str_of(karg(kws, "vendor")) == "mysql" and is_str(karg(kws, "vendor"));
    if getb(a, q, F_MYSQLROLLUP) {
        return Err(qb_no_attr("rollup"));
    }
    let mut ts: Vec[Val] = Vec.new();
    for t in terms {
        if is_list_or_tuple(t) {
            let xs = items(a, t);
            ts.push(mk_tuple_cls(mut a, C_TUPLE, xs));
        } else {
            ts.push(t.clone());
        }
    }
    let gbs = lget(a, q, F_GROUPBYS);
    if for_mysql {
        if ts.len() == 0 and gbs.len() == 0 {
            return Err(exc("RollupException",
                "At least one group is required. Call Query.groupby(term) or passas parameter to rollup.".to_string()));
        }
        set(mut a, q, F_MYSQLROLLUP, Val.Bool(true));
        for t in ts {
            lpush(mut a, q, F_GROUPBYS, t.clone());
        }
    } else if gbs.len() > 0 and is_rollup(a, gbs[gbs.len() - 1]) {
        let r = obj_id(gbs[gbs.len() - 1]);
        for t in ts {
            lpush(mut a, r, F_ARGS, t.clone());
        }
    } else {
        let r = mk_func(mut a, "Rollup", "ROLLUP", ts, Val.Non, Val.Non, 0);
        lpush(mut a, q, F_GROUPBYS, r);
    }
    Ok(())
}

fn mk_joiner(a: mut ref A, q: i64, item: ref Val, how: ref Val, label: Str) -> Val {
    let o = new_obj(mut a, C_JOINER);
    set(mut a, o, F_QUERY, Val.Obj(q));
    set(mut a, o, F_ITEM, item.clone());
    set(mut a, o, F_HOW, how.clone());
    set(mut a, o, F_TLABEL, s_(label));
    Val.Obj(o)
}

fn qb_join(a: mut ref A, o: i64, item: ref Val, how: ref Val) -> Result[Val, Exc] {
    let q = qb_begin(mut a, o);
    let c = cls_of(a, item);
    if c == C_TABLE or c == C_ALIASQ {
        return Ok(mk_joiner(mut a, q, item, how, "table"));
    }
    if c == C_QB {
        if is_nothing(get(a, obj_id(item), F_ALIAS)) {
            let n = geti(a, q, F_SUBQCOUNT);
            set(mut a, obj_id(item), F_ALIAS, sv(f"sq{n}"));
            set(mut a, q, F_SUBQCOUNT, Val.Int(n + 1));
        }
        return Ok(mk_joiner(mut a, q, item, how, "subquery"));
    }
    if c == C_SETOP {
        return Ok(mk_joiner(mut a, q, item, how, "subquery"));
    }
    let tn = py_cls(a, item);
    Err(exc("ValueError", f"Cannot join on type '<class '{tn}'>'"))
}

fn mk_join(a: mut ref A, kind: Str, item: ref Val, how: ref Val) -> i64 {
    let o = new_obj(mut a, C_JOIN);
    set(mut a, o, F_KIND, s_(kind));
    set(mut a, o, F_ITEM, item.clone());
    set(mut a, o, F_HOW, how.clone());
    o
}

fn join_exc(msg: own String) -> Exc {
    exc("JoinException", msg)
}

fn qb_do_join(a: mut ref A, q: i64, j: i64) -> Result[(), Exc] {
    let mut base = lget(a, q, F_FROM);
    base.push(get(a, q, F_UPDATE));
    for w in lget(a, q, F_WITH) {
        base.push(w.clone());
    }
    let joins = lget(a, q, F_JOINS);
    let item = get(a, j, F_ITEM);
    if gets(a, j, F_KIND) == "JoinOn" {
        // JoinOn.validate
        let mut avail: Vec[Val] = Vec.new();
        for b in base.clone() {
            avail = set_add(mut a, avail, b)?;
        }
        for jj in joins.clone() {
            let it = get(a, obj_id(jj), F_ITEM);
            avail = set_add(mut a, avail, it)?;
        }
        avail = set_add(mut a, avail, item)?;
        let mut missing: Vec[Val] = Vec.new();
        for f in fields_of(a, get(a, j, F_CRIT)) {
            let t = get(a, obj_id(f), F_TABLE);
            if not set_has(mut a, avail, t)? {
                missing = set_add(mut a, missing, t)?;
            }
        }
        if missing.len() > 0 {
            let mut names: Vec[String] = Vec.new();
            for m in missing {
                names.push(pystr(mut a, m)?);
            }
            let found = join_strs(names, ", ");
            return Err(join_exc("Invalid join criterion. One field is required from the joined item and another from the selected table or an existing join.  Found [" + found + "]"));
        }
    }
    let mut any_table = false;
    for b in base.clone() {
        if is_table(a, b) {
            any_table = true;
        }
    }
    let in_query = any_table and list_has(a, base, item);
    if is_table(a, item) and is_none(get(a, obj_id(item), F_ALIAS)) and in_query {
        let n = gets(a, obj_id(item), F_TNAME);
        set(mut a, obj_id(item), F_ALIAS, sv(n + "2"));
    }
    lpush(mut a, q, F_JOINS, Val.Obj(j));
    Ok(())
}

fn joiner_method(a: mut ref A, o: i64, name: ref String, args: ref Vec[Val], kws: ref Vec[Karg]) -> Result[Val, Exc] {
    let q = obj_id(get(a, o, F_QUERY));
    let item = get(a, o, F_ITEM);
    let how = get(a, o, F_HOW);
    let label = gets(a, o, F_TLABEL);
    if name == "on" {
        let crit = param(args, kws, 0, "criterion");
        if is_nothing(crit) {
            return Err(join_exc(f"Parameter 'criterion' is required for a {label} JOIN but was not supplied."));
        }
        let j = mk_join(mut a, "JoinOn", item, how);
        set(mut a, j, F_CRIT, crit);
        let col = param(args, kws, 1, "collate");
        set(mut a, j, F_COLLATE, if is_absent(col) { Val.Non } else { col });
        qb_do_join(mut a, q, j)?;
        return Ok(Val.Obj(q));
    }
    if name == "on_field" {
        if args.len() == 0 {
            return Err(join_exc(f"Parameter 'fields' is required for a {label} JOIN but was not supplied."));
        }
        let mut crit = Val.Non;
        for f in args {
            let ff = first_from(a, q)?;
            let l = mk_field(mut a, f, Val.Non, ff);
            let r = mk_field(mut a, f, Val.Non, item);
            let c = binop(mut a, "==", l, r)?;
            crit = if is_none(crit) { c } else { binop(mut a, "&", crit, c)? };
        }
        let j = mk_join(mut a, "JoinOn", item, how);
        set(mut a, j, F_CRIT, crit);
        set(mut a, j, F_COLLATE, Val.Non);
        qb_do_join(mut a, q, j)?;
        return Ok(Val.Obj(q));
    }
    if name == "using" {
        if args.len() == 0 {
            return Err(join_exc("Parameter 'fields' is required when joining with a using clause but was not supplied.".to_string()));
        }
        let mut fs: Vec[Val] = Vec.new();
        for f in args {
            fs.push(mk_field(mut a, f, Val.Non, Val.Non));
        }
        let j = mk_join(mut a, "JoinUsing", item, how);
        set_list(mut a, j, F_JFIELDS, fs);
        qb_do_join(mut a, q, j)?;
        return Ok(Val.Obj(q));
    }
    if name == "cross" {
        let j = mk_join(mut a, "Join", item, en("JoinType", "cross"));
        qb_do_join(mut a, q, j)?;
        return Ok(Val.Obj(q));
    }
    Err(no_attr("Joiner", name.as_str()))
}

fn mk_setop(a: mut ref A, base: i64, other: ref Val, op: Str) -> Val {
    let o = new_obj(mut a, C_SETOP);
    set(mut a, o, F_ALIAS, Val.Non);
    set(mut a, o, F_BASE, Val.Obj(base));
    let pair = tup(mut a, vec![en("SetOperation", op), other.clone()]);
    set_list(mut a, o, F_SETOPS, vec![pair]);
    set_list(mut a, o, F_ORDERBYS, Vec.new());
    set(mut a, o, F_LIMIT, Val.Non);
    set(mut a, o, F_OFFSET, Val.Non);
    Val.Obj(o)
}

fn is_setop_name(name: ref String) -> bool {
    name == "union" or name == "union_all" or name == "intersect" or name == "except_of" or name == "minus"
}

fn order_kw(kws: ref Vec[Karg]) -> Val {
    let o = karg(kws, "order");
    if is_absent(o) { Val.Non } else { o }
}

fn int_of(v: ref Val) -> i64 {
    match v {
        Val.Int(n) => n,
        Val.Bool(b) => if b { 1 } else { 0 },
        Val.Float(x) => x as i64,
        _ => 0,
    }
}

// The QueryBuilder methods and their dialects' versions.
fn qb_methods() -> Vec[String] {
    split_on("from_ replace_table with_ into select delete update columns insert replace force_index use_index distinct for_update ignore prewhere where having groupby with_totals rollup orderby join inner_join left_join left_outer_join right_join right_outer_join outer_join full_outer_join cross_join hash_join limit offset union union_all intersect except_of minus set slice get_sql as_ field get_table_name is_joined".to_string(), ' ')
}

fn qb_has_method(dk: i64, name: ref String) -> bool {
    for m in qb_methods() {
        if m == *name {
            return true;
        }
    }
    if dk == D_MYSQL {
        return name == "on_duplicate_key_update" or name == "on_duplicate_key_ignore" or name == "modifier";
    }
    if dk == D_PG {
        return name == "distinct_on" or name == "on_conflict" or name == "do_nothing" or name == "do_update"
            or name == "using" or name == "returning";
    }
    if dk == D_MSSQL {
        return name == "top" or name == "fetch_next";
    }
    if dk == D_VERTICA {
        return name == "hint";
    }
    if dk == D_SQLITE {
        return name == "insert_or_replace";
    }
    false
}

fn qb_method(a: mut ref A, o: i64, name: ref String, args: ref Vec[Val], kws: ref Vec[Karg]) -> Result[Val, Exc] {
    let dk = geti(a, o, F_DK);
    let a0 = param(args, kws, 0, "");
    if name == "get_sql" {
        let kw = kw_from_args(kws);
        return Ok(sv(sql(mut a, Val.Obj(o), kw)?));
    }
    if name == "field" {
        return Ok(mk_field(mut a, a0, Val.Non, Val.Obj(o)));
    }
    if name == "get_table_name" {
        return Ok(get(a, o, F_ALIAS));
    }
    if name == "is_joined" {
        for j in lget(a, o, F_JOINS) {
            if py_eq(a, a0, get(a, obj_id(j), F_ITEM)) {
                return Ok(Val.Bool(true));
            }
        }
        return Ok(Val.Bool(false));
    }
    if name == "join" {
        let how = param_or(args, kws, 1, "how", en("JoinType", "inner"));
        return qb_join(mut a, o, a0, how);
    }
    if name.ends_with("_join") {
        let kind = name.substring(0, name.len() - 5);
        return qb_join(mut a, o, a0, Val.En("JoinType".to_string(), kind));
    }
    if is_setop_name(name) {
        let q = qb_begin(mut a, o);
        return Ok(mk_setop(mut a, q, a0, name.as_str()));
    }
    let q = qb_begin(mut a, o);
    if name == "as_" {
        set(mut a, q, F_ALIAS, a0);
    } else if name == "from_" {
        qb_from(mut a, q, a0);
    } else if name == "replace_table" {
        qb_replace_table(mut a, q, a0, param(args, kws, 1, "new_table"))?;
    } else if name == "with_" {
        let aq = mk_aliasq(mut a, param(args, kws, 1, "name"), a0);
        lpush(mut a, q, F_WITH, aq);
    } else if name == "into" {
        if not is_nothing(get(a, q, F_INSERT)) {
            return Err(qb_no_attr("into"));
        }
        if llen(a, q, F_SELECTS) > 0 {
            set(mut a, q, F_SELINTO, Val.Bool(true));
        }
        let t = as_table(mut a, a0);
        set(mut a, q, F_INSERT, t);
    } else if name == "select" {
        qb_select(mut a, q, args)?;
    } else if name == "delete" {
        if getb(a, q, F_DELETE) or llen(a, q, F_SELECTS) > 0 or py_truthy(get(a, q, F_UPDATE)) {
            return Err(qb_no_attr("delete"));
        }
        set(mut a, q, F_DELETE, Val.Bool(true));
    } else if name == "update" {
        if not is_nothing(get(a, q, F_UPDATE)) or llen(a, q, F_SELECTS) > 0 or getb(a, q, F_DELETE) {
            return Err(qb_no_attr("update"));
        }
        let t = as_table(mut a, a0);
        set(mut a, q, F_UPDATE, t);
    } else if name == "columns" {
        let ins = get(a, q, F_INSERT);
        if is_nothing(ins) {
            return Err(qb_no_attr("insert"));
        }
        let terms = if args.len() > 0 and is_list_or_tuple(args[0]) { items(a, args[0]) } else { args.clone() };
        for t in terms {
            let c = if is_str(t) { mk_field(mut a, t, Val.Non, ins) } else { t.clone() };
            lpush(mut a, q, F_COLUMNS, c);
        }
    } else if name == "insert" or name == "replace" or name == "insert_or_replace" {
        qb_apply_terms(mut a, q, args)?;
        set(mut a, q, F_REPLACE, Val.Bool(name != "insert"));
        if name == "insert_or_replace" {
            set(mut a, q, F_INSREPL, Val.Bool(true));
        }
    } else if name == "force_index" or name == "use_index" {
        let k = if name == "force_index" { F_FORCEIDX } else { F_USEIDX };
        for t in args {
            if cls_of(a, t) == C_INDEX {
                lpush(mut a, q, k, t.clone());
            } else if is_str(t) {
                let ix = mk_index(mut a, t);
                lpush(mut a, q, k, ix);
            }
        }
    } else if name == "distinct" {
        set(mut a, q, F_QDISTINCT, Val.Bool(true));
    } else if name == "for_update" {
        set(mut a, q, F_FORUPD, Val.Bool(true));
        if dk == D_MYSQL or dk == D_PG {
            set(mut a, q, F_FUSKIP, param_or(args, kws, 1, "skip_locked", Val.Bool(false)));
            set(mut a, q, F_FUNOWAIT, param_or(args, kws, 0, "nowait", Val.Bool(false)));
            let of = param(args, kws, 2, "of");
            let mut xs: Vec[Val] = Vec.new();
            for x in items(a, of) {
                if not alias_in(x, xs) {
                    xs.push(x.clone());
                }
            }
            set_list(mut a, q, F_FUOF, xs);
        }
    } else if name == "ignore" {
        set(mut a, q, F_IGNORE, Val.Bool(true));
    } else if name == "prewhere" {
        qb_where(mut a, q, F_PREWHERES, a0, true)?;
    } else if name == "where" {
        if dk == D_PG and getb(a, q, F_ONCONF) {
            pg_conflict_where(mut a, q, a0)?;
        } else {
            qb_where(mut a, q, F_WHERES, a0, true)?;
        }
    } else if name == "having" {
        qb_where(mut a, q, F_HAVINGS, a0, false)?;
    } else if name == "groupby" {
        for t in args {
            if is_str(t) {
                let ff = first_from(a, q)?;
                let f = mk_field(mut a, t, Val.Non, ff);
                lpush(mut a, q, F_GROUPBYS, f);
            } else if is_int(t) or is_bool(t) {
                first_from(a, q)?;
                let w = wrap(mut a, t);
                lpush(mut a, q, F_GROUPBYS, w);
            } else {
                lpush(mut a, q, F_GROUPBYS, t.clone());
            }
        }
    } else if name == "with_totals" {
        set(mut a, q, F_WITHTOTALS, Val.Bool(true));
    } else if name == "rollup" {
        qb_rollup(mut a, q, args, kws)?;
    } else if name == "orderby" {
        let ord = order_kw(kws);
        for t in args {
            let f = if is_str(t) {
                let ff = first_from(a, q)?;
                mk_field(mut a, t, Val.Non, ff)
            } else {
                wrap(mut a, t)
            };
            let pair = tup(mut a, vec![f, ord.clone()]);
            lpush(mut a, q, F_QORDERBYS, pair);
        }
    } else if name == "limit" or name == "fetch_next" {
        set(mut a, q, F_LIMIT, a0);
    } else if name == "offset" {
        set(mut a, q, F_OFFSET, a0);
    } else if name == "set" {
        let f = if is_field(a, a0) { a0.clone() } else { mk_field(mut a, a0, Val.Non, Val.Non) };
        let v = mk_vw(mut a, param(args, kws, 1, "value"), Val.Non, getb(a, q, F_SQLITEW));
        let pair = tup(mut a, vec![f, v]);
        lpush(mut a, q, F_UPDATES, pair);
    } else if name == "slice" {
        let lu = items(a, a0);
        set(mut a, q, F_OFFSET, lu[0].clone());
        set(mut a, q, F_LIMIT, lu[1].clone());
    } else if name == "on_duplicate_key_update" {
        if getb(a, q, F_IGNDUP) {
            return Err(query_error("Can not have two conflict handlers"));
        }
        let f = if is_field(a, a0) { a0.clone() } else { mk_field(mut a, a0, Val.Non, Val.Non) };
        let v = mk_vw(mut a, param(args, kws, 1, "value"), Val.Non, false);
        let pair = tup(mut a, vec![f, v]);
        lpush(mut a, q, F_DUPUPD, pair);
    } else if name == "on_duplicate_key_ignore" {
        if llen(a, q, F_DUPUPD) > 0 {
            return Err(query_error("Can not have two conflict handlers"));
        }
        set(mut a, q, F_IGNDUP, Val.Bool(true));
    } else if name == "modifier" {
        lpush(mut a, q, F_MODIFIERS, a0);
    } else if name == "distinct_on" {
        for t in args {
            if is_str(t) {
                let f = mk_field(mut a, t, Val.Non, Val.Non);
                lpush(mut a, q, F_DISTON, f);
            } else if is_term(a, t) {
                lpush(mut a, q, F_DISTON, t.clone());
            }
        }
    } else if name == "on_conflict" {
        let ins = get(a, q, F_INSERT);
        if not py_truthy(ins) {
            return Err(query_error("On conflict only applies to insert query"));
        }
        set(mut a, q, F_ONCONF, Val.Bool(true));
        for t in args {
            if is_str(t) {
                let f = mk_field(mut a, t, Val.Non, ins);
                lpush(mut a, q, F_ONCFIELDS, f);
            } else if is_term(a, t) {
                lpush(mut a, q, F_ONCFIELDS, t.clone());
            }
        }
    } else if name == "do_nothing" {
        if llen(a, q, F_ONCUPDATES) > 0 {
            return Err(query_error("Can not have two conflict handlers"));
        }
        set(mut a, q, F_ONCNOTHING, Val.Bool(true));
    } else if name == "do_update" {
        if getb(a, q, F_ONCNOTHING) {
            return Err(query_error("Can not have two conflict handlers"));
        }
        let f = if is_str(a0) {
            let ins = get(a, q, F_INSERT);
            if py_truthy(ins) { mk_field(mut a, a0, Val.Non, ins) } else { Val.Non }
        } else if is_field(a, a0) {
            a0.clone()
        } else {
            return Err(query_error("Unsupported update_field"));
        };
        let uv = param(args, kws, 1, "update_value");
        let v = if is_nothing(uv) { Val.Non } else { mk_vw(mut a, uv, Val.Non, false) };
        let pair = tup(mut a, vec![f, v]);
        lpush(mut a, q, F_ONCUPDATES, pair);
    } else if name == "using" {
        lpush(mut a, q, F_USING, a0);
    } else if name == "returning" {
        pg_returning(mut a, q, args)?;
    } else if name == "top" {
        let n = match a0 {
            Val.Int(n) => n,
            Val.Bool(b) => if b { 1 } else { 0 },
            Val.Float(x) => x as i64,
            Val.Str(s) => {
                let t = s.trim().to_string();
                let body = if t.starts_with("-") or t.starts_with("+") { t.substring(1, t.len()) } else { t.clone() };
                if body.len() == 0 or not all_digits(body) {
                    return Err(query_error("TOP value must be an integer"));
                }
                if t.starts_with("-") { -atoi(body) } else { atoi(body) }
            }
            _ => return Err(query_error("TOP value must be an integer")),
        };
        set(mut a, q, F_TOP, Val.Int(n));
        let pct = param_or(args, kws, 1, "percent", Val.Bool(false));
        if py_truthy(pct) and not (n >= 0 and n <= 100) {
            return Err(query_error("TOP value must be between 0 and 100 when `percent` is specified"));
        }
        set(mut a, q, F_TOPPCT, pct);
        set(mut a, q, F_TOPTIES, param_or(args, kws, 2, "with_ties", Val.Bool(false)));
    } else if name == "hint" {
        set(mut a, q, F_HINT, a0);
    } else {
        return Err(no_attr("QueryBuilder", name.as_str()));
    }
    Ok(Val.Obj(q))
}

// PostgreSQLQueryBuilder.where once on_conflict() has been called.
fn pg_conflict_where(a: mut ref A, q: i64, crit: ref Val) -> Result[(), Exc] {
    if cls_of(a, crit) == C_EMPTY {
        return Ok(());
    }
    if getb(a, q, F_ONCNOTHING) {
        return Err(query_error("DO NOTHING doest not support WHERE"));
    }
    let nf = llen(a, q, F_ONCFIELDS);
    let k = if nf > 0 and llen(a, q, F_ONCUPDATES) > 0 {
        F_ONCUPDWHERES
    } else if nf > 0 {
        F_ONCWHERES
    } else {
        return Err(query_error("Can not have fieldless ON CONFLICT WHERE"));
    };
    let cur = get(a, q, k);
    if py_truthy(cur) {
        let c = binop(mut a, "&", cur, crit)?;
        set(mut a, q, k, c);
    } else {
        set(mut a, q, k, crit.clone());
    }
    Ok(())
}

fn pg_validate_returning(a: mut ref A, q: i64, term: ref Val) -> Result[(), Exc] {
    let ins = get(a, q, F_INSERT);
    let upd = get(a, q, F_UPDATE);
    for f in fields_of(a, term) {
        if not (py_truthy(ins) or py_truthy(upd) or getb(a, q, F_DELETE)) {
            return Err(query_error("Returning can't be used in this query"));
        }
        let ft = get(a, obj_id(f), F_TABLE);
        let mut iu: Vec[Val] = Vec.new();
        iu = set_add(mut a, iu, ins)?;
        iu = set_add(mut a, iu, upd)?;
        let in_iu = set_has(mut a, iu, ft)?;
        let mut jb: Vec[Val] = Vec.new();
        for b in lget(a, q, F_FROM) {
            jb = set_add(mut a, jb, b)?;
        }
        for j in lget(a, q, F_JOINS) {
            for t in tables_of(a, get(a, obj_id(j), F_CRIT)) {
                jb = set_add(mut a, jb, t)?;
            }
        }
        let mut extra = false;
        for t in tables_of(a, term) {
            if not set_has(mut a, jb, t)? {
                extra = true;
            }
        }
        if not in_iu and extra {
            return Err(query_error("You can't return from other tables"));
        }
    }
    Ok(())
}

fn pg_return_field(a: mut ref A, q: i64, term: ref Val) -> Result[(), Exc] {
    if getb(a, q, F_RETSTAR) {
        return Ok(());
    }
    pg_validate_returning(mut a, q, term)?;
    if cls_of(a, term) == C_STAR {
        pg_returns_for_star(mut a, q);
    }
    lpush(mut a, q, F_RETURNS, term.clone());
    Ok(())
}

fn pg_returns_for_star(a: mut ref A, q: i64) {
    let mut keep: Vec[Val] = Vec.new();
    for r in lget(a, q, F_RETURNS) {
        let c = cls_of(a, r);
        if not (c == C_FIELD or c == C_STAR or is_selectable(a, r)) {
            keep.push(r.clone());
        }
    }
    set_list(mut a, q, F_RETURNS, keep);
    set(mut a, q, F_RETSTAR, Val.Bool(true));
}

fn pg_returning(a: mut ref A, q: i64, terms: ref Vec[Val]) -> Result[(), Exc] {
    for t in terms {
        if is_field(a, t) {
            pg_return_field(mut a, q, t)?;
        } else if is_str(t) {
            if str_of(t) == "*" {
                pg_returns_for_star(mut a, q);
                let st = mk_star(mut a, Val.Non);
                lpush(mut a, q, F_RETURNS, st);
                continue;
            }
            let ins = get(a, q, F_INSERT);
            let upd = get(a, q, F_UPDATE);
            let table = if py_truthy(ins) {
                ins
            } else if py_truthy(upd) {
                upd
            } else if getb(a, q, F_DELETE) {
                first_from(a, q)?
            } else {
                return Err(query_error("Returning can't be used in this query"));
            };
            let f = mk_field(mut a, t, Val.Non, table);
            pg_return_field(mut a, q, f)?;
        } else if is_function(a, t) or cls_of(a, t) == C_ARITH {
            if is_agg(a, t) == 1 {
                return Err(query_error("Aggregate functions are not allowed in returning"));
            }
            pg_validate_returning(mut a, q, t)?;
            lpush(mut a, q, F_RETURNS, t.clone());
        } else {
            let w = wrap(mut a, t);
            pg_validate_returning(mut a, q, w)?;
            lpush(mut a, q, F_RETURNS, w);
        }
    }
    Ok(())
}

fn mk_index(a: mut ref A, name: ref Val) -> Val {
    let o = new_term(mut a, C_INDEX, Val.Non);
    set(mut a, o, F_NAME, name.clone());
    Val.Obj(o)
}

fn mk_aliasq(a: mut ref A, name: ref Val, query: ref Val) -> Val {
    let o = new_obj(mut a, C_ALIASQ);
    set(mut a, o, F_ALIAS, name.clone());
    set(mut a, o, F_NAME, name.clone());
    set(mut a, o, F_QUERY, if is_absent(query) { Val.Non } else { query.clone() });
    Val.Obj(o)
}

// ------------------------------------------------------------ replace_table

fn swap_table(a: ref A, t: ref Val, cur: ref Val, new: ref Val) -> Val {
    if py_eq(a, t, cur) { new.clone() } else { t.clone() }
}

fn replace_list(a: mut ref A, xs: ref Vec[Val], cur: ref Val, new: ref Val) -> Result[Vec[Val], Exc] {
    let mut out: Vec[Val] = Vec.new();
    for x in xs {
        out.push(term_replace_table(mut a, x, cur, new)?);
    }
    Ok(out)
}

// term.replace_table(current, new) for each class that defines it; the
// rest return themselves.
fn term_replace_table(a: mut ref A, v: ref Val, cur: ref Val, new: ref Val) -> Result[Val, Exc] {
    let c = cls_of(a, v);
    if c == C_QB {
        let q = qb_begin(mut a, obj_id(v));
        qb_replace_table(mut a, q, cur, new)?;
        return Ok(Val.Obj(q));
    }
    if c == C_JOIN {
        let o = copy_obj(mut a, obj_id(v));
        let kind = gets(a, o, F_KIND);
        let item = get(a, o, F_ITEM);
        if kind == "Join" {
            let r = term_replace_table(mut a, item, cur, new)?;
            set(mut a, o, F_ITEM, r);
            return Ok(Val.Obj(o));
        }
        set(mut a, o, F_ITEM, swap_table(a, item, cur, new));
        if kind == "JoinOn" {
            let r = term_replace_table(mut a, get(a, o, F_CRIT), cur, new)?;
            set(mut a, o, F_CRIT, r);
        } else {
            let fs = replace_list(mut a, lget(a, o, F_JFIELDS), cur, new)?;
            set_list(mut a, o, F_JFIELDS, fs);
        }
        return Ok(Val.Obj(o));
    }
    if c == C_TABLE {
        return Err(no_attr("Table", "replace_table"));
    }
    if not is_term_cls(c) {
        return Ok(v.clone());
    }
    let ks: Vec[i64] = if c == C_FIELD or c == C_STAR {
        let o = copy_obj(mut a, obj_id(v));
        let t = get(a, o, F_TABLE);
        set(mut a, o, F_TABLE, swap_table(a, t, cur, new));
        return Ok(Val.Obj(o));
    } else if c == C_BASIC or c == C_COMPLEX or c == C_ARITH {
        vec![F_LEFT, F_RIGHT]
    } else if c == C_CONTAINS or c == C_BETWEEN or c == C_BITAND or c == C_NULLC or c == C_NOTNULLC or c == C_NOT {
        vec![F_TERM]
    } else if c == C_TUPLE or c == C_ARRAY or c == C_BRACKET {
        let o = copy_obj(mut a, obj_id(v));
        let vs = replace_list(mut a, lget(a, o, F_VALUES), cur, new)?;
        set_list(mut a, o, F_VALUES, vs);
        return Ok(Val.Obj(o));
    } else if c == C_FUNC {
        let o = copy_obj(mut a, obj_id(v));
        let vs = replace_list(mut a, lget(a, o, F_ARGS), cur, new)?;
        set_list(mut a, o, F_ARGS, vs);
        return Ok(Val.Obj(o));
    } else if c == C_CASE {
        let o = copy_obj(mut a, obj_id(v));
        let mut cs: Vec[Val] = Vec.new();
        for p in lget(a, o, F_CASES) {
            let pair = items(a, p);
            let w = term_replace_table(mut a, pair[0], cur, new)?;
            let t = term_replace_table(mut a, pair[1], cur, new)?;
            cs.push(lst(mut a, vec![w, t]));
        }
        set_list(mut a, o, F_CASES, cs);
        let el = get(a, o, F_ELSE);
        if py_truthy(el) {
            let r = term_replace_table(mut a, el, cur, new)?;
            set(mut a, o, F_ELSE, r);
        } else {
            set(mut a, o, F_ELSE, Val.Non);
        }
        return Ok(Val.Obj(o));
    } else {
        return Ok(v.clone());
    };
    let o = copy_obj(mut a, obj_id(v));
    for k in ks {
        let r = term_replace_table(mut a, get(a, o, k), cur, new)?;
        set(mut a, o, k, r);
    }
    Ok(Val.Obj(o))
}

fn qb_replace_table(a: mut ref A, q: i64, cur: ref Val, new: ref Val) -> Result[(), Exc] {
    let mut fs: Vec[Val] = Vec.new();
    for t in lget(a, q, F_FROM) {
        fs.push(swap_table(a, t, cur, new));
    }
    set_list(mut a, q, F_FROM, fs);
    let ins = get(a, q, F_INSERT);
    set(mut a, q, F_INSERT, swap_table(a, ins, cur, new));
    let upd = get(a, q, F_UPDATE);
    set(mut a, q, F_UPDATE, swap_table(a, upd, cur, new));
    let ws = replace_list(mut a, lget(a, q, F_WITH), cur, new)?;
    set_list(mut a, q, F_WITH, ws);
    let ss = replace_list(mut a, lget(a, q, F_SELECTS), cur, new)?;
    set_list(mut a, q, F_SELECTS, ss);
    let cs = replace_list(mut a, lget(a, q, F_COLUMNS), cur, new)?;
    set_list(mut a, q, F_COLUMNS, cs);
    let mut rows: Vec[Val] = Vec.new();
    for r in lget(a, q, F_QVALUES) {
        let vs = replace_list(mut a, items(a, r), cur, new)?;
        rows.push(lst(mut a, vs));
    }
    set_list(mut a, q, F_QVALUES, rows);
    let wh = vec![F_WHERES, F_PREWHERES];
    for k in wh {
        let w = get(a, q, k);
        let r = if py_truthy(w) { term_replace_table(mut a, w, cur, new)? } else { Val.Non };
        set(mut a, q, k, r);
    }
    let gs = replace_list(mut a, lget(a, q, F_GROUPBYS), cur, new)?;
    set_list(mut a, q, F_GROUPBYS, gs);
    let hv = get(a, q, F_HAVINGS);
    let hr = if py_truthy(hv) { term_replace_table(mut a, hv, cur, new)? } else { Val.Non };
    set(mut a, q, F_HAVINGS, hr);
    let mut obs: Vec[Val] = Vec.new();
    for p in lget(a, q, F_QORDERBYS) {
        let pair = items(a, p);
        let f = term_replace_table(mut a, pair[0], cur, new)?;
        obs.push(tup(mut a, vec![f, pair[1].clone()]));
    }
    set_list(mut a, q, F_QORDERBYS, obs);
    let js = replace_list(mut a, lget(a, q, F_JOINS), cur, new)?;
    set_list(mut a, q, F_JOINS, js);
    let st = lget(a, q, F_STARTABLES);
    if set_has(mut a, st, cur)? {
        let mut out: Vec[Val] = Vec.new();
        let kc = hkey(mut a, cur)?;
        for e in st {
            let same = identical(e, cur) or (hkey(mut a, e)? == kc and py_eq(a, e, cur));
            if not same {
                out.push(e.clone());
            }
        }
        out = set_add(mut a, out, new)?;
        set_list(mut a, q, F_STARTABLES, out);
    }
    Ok(())
}

// ------------------------------------------------------------ operators

fn is_num(v: ref Val) -> bool {
    match v {
        Val.Int(_) => true,
        Val.Float(_) => true,
        Val.Bool(_) => true,
        _ => false,
    }
}

fn num_f(v: ref Val) -> f64 {
    match v {
        Val.Int(n) => n as f64,
        Val.Float(x) => x,
        Val.Bool(b) => if b { 1.0 } else { 0.0 },
        _ => 0.0,
    }
}

fn is_float(v: ref Val) -> bool {
    match v {
        Val.Float(_) => true,
        _ => false,
    }
}

// Python arithmetic and comparison on two numbers.
fn num_op(op: Str, l: ref Val, r: ref Val) -> Result[Val, Exc] {
    if op == "/" {
        if num_f(r) == 0.0 {
            return Err(exc("ZeroDivisionError", "division by zero".to_string()));
        }
        return Ok(Val.Float(num_f(l) / num_f(r)));
    }
    if op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">=" {
        let x = num_f(l);
        let y = num_f(r);
        let b = if op == "==" {
            x == y
        } else if op == "!=" {
            x != y
        } else if op == "<" {
            x < y
        } else if op == "<=" {
            x <= y
        } else if op == ">" {
            x > y
        } else {
            x >= y
        };
        return Ok(Val.Bool(b));
    }
    if is_float(l) or is_float(r) {
        let x = num_f(l);
        let y = num_f(r);
        if op == "+" {
            return Ok(Val.Float(x + y));
        }
        if op == "-" {
            return Ok(Val.Float(x - y));
        }
        if op == "*" {
            return Ok(Val.Float(x * y));
        }
        return Err(type_error(f"unsupported operand type(s) for {op}: 'float' and 'float'"));
    }
    let x = int_of(l);
    let y = int_of(r);
    if op == "+" {
        return Ok(Val.Int(x + y));
    }
    if op == "-" {
        return Ok(Val.Int(x - y));
    }
    if op == "*" {
        return Ok(Val.Int(x * y));
    }
    if op == "%" {
        return Ok(Val.Int(((x % y) + y) % y));
    }
    if op == "<<" {
        return Ok(Val.Int(x << y));
    }
    if op == ">>" {
        return Ok(Val.Int(x >> y));
    }
    if op == "&" {
        return Ok(Val.Int(x & y));
    }
    if op == "|" {
        return Ok(Val.Int(x | y));
    }
    if op == "^" {
        return Ok(Val.Int(x ^ y));
    }
    if op == "**" {
        let mut p = 1;
        let mut k = 0;
        while k < y {
            p = p * x;
            k += 1;
        }
        return Ok(Val.Int(p));
    }
    Err(type_error(f"unsupported operand type(s) for {op}: 'int' and 'int'"))
}

fn arith_member(op: Str) -> Str {
    if op == "+" {
        "add"
    } else if op == "-" {
        "sub"
    } else if op == "*" {
        "mul"
    } else if op == "/" {
        "div"
    } else if op == "<<" {
        "lshift"
    } else {
        "rshift"
    }
}

fn cmp_member(op: Str) -> Str {
    if op == "==" {
        "eq"
    } else if op == "!=" {
        "ne"
    } else if op == "<" {
        "lt"
    } else if op == "<=" {
        "lte"
    } else if op == ">" {
        "gt"
    } else {
        "gte"
    }
}

// The comparison Python tries on the right when the left side declines.
fn reflected_cmp(op: Str) -> Str {
    if op == "<" {
        ">"
    } else if op == "<=" {
        ">="
    } else if op == ">" {
        "<"
    } else if op == ">=" {
        "<="
    } else {
        op
    }
}

fn is_cmp(op: Str) -> bool {
    op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">="
}

fn is_arith(op: Str) -> bool {
    op == "+" or op == "-" or op == "*" or op == "/" or op == "<<" or op == ">>"
}

// l.__op__(r): Absent when the left side declines (NotImplemented).
fn left_op(a: mut ref A, op: Str, l: ref Val, r: ref Val) -> Result[Val, Exc] {
    let c = cls_of(a, l);
    if c == C_QB or c == C_SETOP {
        if op == "+" or op == "*" or op == "-" {
            let name = if op == "+" { "union" } else if op == "*" { "union_all" } else { "minus" };
            if c == C_QB {
                let q = qb_begin(mut a, obj_id(l));
                return Ok(mk_setop(mut a, q, r, name));
            }
            return setop_method(mut a, obj_id(l), name.to_string(), vec![r.clone()], Vec.new());
        }
        if c == C_QB and (op == "==" or op == "!=") {
            let eq = py_eq(a, l, r);
            return Ok(Val.Bool(if op == "==" { eq } else { not eq }));
        }
    }
    if is_term_cls(c) {
        if op == "&" or op == "|" or op == "^" {
            if not is_criterion_cls(c) {
                return Ok(Val.Absent);
            }
            if c == C_EMPTY {
                return Ok(r.clone());
            }
            let m = if op == "&" { "and_" } else if op == "|" { "or_" } else { "xor_" };
            return Ok(mk_complex(mut a, m, l, r));
        }
        if is_arith(op) {
            let w = wrap(mut a, r);
            return Ok(mk_arith(mut a, arith_member(op), l, w));
        }
        if op == "**" {
            return Ok(mk_func(mut a, "Pow", "POW", vec![l.clone(), r.clone()], Val.Non, Val.Non, 0));
        }
        if op == "%" {
            return Ok(mk_func(mut a, "Mod", "MOD", vec![l.clone(), r.clone()], Val.Non, Val.Non, 0));
        }
        if is_cmp(op) {
            return Ok(crit(mut a, "Equality", cmp_member(op), l, r));
        }
        return Ok(Val.Absent);
    }
    if c == C_TABLE or c == C_ALIASQ or c == C_SCHEMA {
        if op == "==" {
            return Ok(Val.Bool(py_eq(a, l, r)));
        }
        if op == "!=" {
            return Ok(Val.Bool(not py_eq(a, l, r)));
        }
        return Ok(Val.Absent);
    }
    if is_num(l) and is_num(r) {
        return num_op(op, l, r);
    }
    match l {
        Val.Str(s) => match r {
            Val.Str(t) => {
                if op == "+" {
                    return Ok(Val.Str(s.clone() + t));
                }
                if op == "==" {
                    return Ok(Val.Bool(s == t));
                }
                if op == "!=" {
                    return Ok(Val.Bool(s != t));
                }
            }
            _ => {}
        },
        _ => {}
    }
    Ok(Val.Absent)
}

// r.__rop__(l)
fn right_op(a: mut ref A, op: Str, l: ref Val, r: ref Val) -> Result[Val, Exc] {
    let c = cls_of(a, r);
    if c == C_QB and (op == "==" or op == "!=") {
        let eq = py_eq(a, r, l);
        return Ok(Val.Bool(if op == "==" { eq } else { not eq }));
    }
    if is_term_cls(c) {
        if is_arith(op) {
            let w = wrap(mut a, l);
            return Ok(mk_arith(mut a, arith_member(op), w, r));
        }
        if is_cmp(op) {
            return Ok(crit(mut a, "Equality", cmp_member(reflected_cmp(op)), r, l));
        }
        return Ok(Val.Absent);
    }
    if c == C_TABLE or c == C_ALIASQ or c == C_SCHEMA {
        if op == "==" {
            return Ok(Val.Bool(py_eq(a, r, l)));
        }
        if op == "!=" {
            return Ok(Val.Bool(not py_eq(a, r, l)));
        }
    }
    Ok(Val.Absent)
}

fn binop(a: mut ref A, op: Str, l: ref Val, r: ref Val) -> Result[Val, Exc] {
    let x = left_op(mut a, op, l, r)?;
    if not is_absent(x) {
        return Ok(x);
    }
    let y = right_op(mut a, op, l, r)?;
    if not is_absent(y) {
        return Ok(y);
    }
    if op == "==" {
        return Ok(Val.Bool(identical(l, r) or same_val(l, r)));
    }
    if op == "!=" {
        return Ok(Val.Bool(not (identical(l, r) or same_val(l, r))));
    }
    let lc = py_cls(a, l);
    let rc = py_cls(a, r);
    if is_cmp(op) {
        return Err(type_error(f"'{op}' not supported between instances of '{lc}' and '{rc}'"));
    }
    Err(type_error(f"unsupported operand type(s) for {op}: '{lc}' and '{rc}'"))
}

fn unop(a: mut ref A, op: Str, v: ref Val) -> Result[Val, Exc] {
    let c = cls_of(a, v);
    if is_term_cls(c) {
        if op == "-" {
            return Ok(mk_unary(mut a, C_NEG, v));
        }
        if op == "+" {
            return Ok(v.clone());
        }
        return Ok(mk_unary(mut a, C_NOT, v));
    }
    match v {
        Val.Int(n) => {
            if op == "-" {
                return Ok(Val.Int(-n));
            }
            if op == "+" {
                return Ok(Val.Int(n));
            }
            return Ok(Val.Int(-n - 1));
        }
        Val.Float(x) => {
            if op == "-" {
                return Ok(Val.Float(-x));
            }
            if op == "+" {
                return Ok(Val.Float(x));
            }
        }
        _ => {}
    }
    let n = py_cls(a, v);
    let what = if op == "-" { "unary -" } else if op == "+" { "unary +" } else { "unary ~" };
    Err(type_error(f"bad operand type for {what}: '{n}'"))
}

// ------------------------------------------------------------ attributes

fn words(s: Str) -> Vec[String] {
    split_on(s.to_string(), ' ')
}

fn in_words(ws: ref Vec[String], name: ref String) -> bool {
    for w in ws {
        if *w == *name {
            return true;
        }
    }
    false
}

fn term_methods() -> Vec[String] {
    words("as_ eq isnull notnull isnotnull bitwiseand gt gte lt lte ne glob like not_like ilike not_ilike rlike regex regexp between from_to as_of all_ isin notin bin_regex negate lshift rshift replace_table get_sql")
}

fn has_term_method(a: ref A, o: i64, name: ref String) -> bool {
    if in_words(term_methods(), name) {
        return true;
    }
    let c = a.objs[o].cls;
    if c == C_CASE {
        return name == "when" or name == "else_";
    }
    if c == C_FUNC {
        let fk = geti(a, o, F_FK);
        return (has_bit(fk, B_AGG) and name == "filter") or (has_bit(fk, B_DIST) and name == "distinct")
            or (has_bit(fk, B_ANA) and (name == "over" or name == "orderby"))
            or (has_bit(fk, B_WIN) and (name == "rows" or name == "range"))
            or (has_bit(fk, B_IGN) and name == "ignore_nulls");
    }
    false
}

fn module_attr(m: ref String, name: ref String) -> Result[Val, Exc] {
    if m == "fn" or m == "an" {
        if m == "an" and name == "CURRENT_ROW" {
            return Ok(s_("CURRENT ROW"));
        }
        return Ok(Val.Name(m.clone() + "." + name));
    }
    if m == "Order" or m == "JoinType" or m == "DatePart" or m == "ReferenceOption" {
        if has_member(m, name) {
            return Ok(Val.En(m.clone(), name.clone()));
        }
        return Err(attr_error(f"{name}"));
    }
    if m == "Criterion" {
        return Ok(Val.Name(m.clone() + "." + name));
    }
    if dialect_kind(m) >= 0 {
        return Ok(Val.Name(m.clone() + "." + name));
    }
    Err(attr_error(f"type object '{m}' has no attribute '{name}'"))
}

// SqlTypes.<name>
fn sqltype_attr(a: mut ref A, name: ref String) -> Val {
    let lens = words("CHAR VARCHAR LONG_VARCHAR BINARY VARBINARY LONG_VARBINARY");
    if in_words(lens, name) {
        let o = new_obj(mut a, C_SQLTYPE);
        set(mut a, o, F_NAME, sv(name.replace("_", " ")));
        return Val.Obj(o);
    }
    sv(name)
}

// getattr(v, name)
fn getattr_(a: mut ref A, v: ref Val, name: ref String) -> Result[Val, Exc] {
    match v {
        Val.Name(m) => {
            if m == "SqlTypes" {
                return Ok(sqltype_attr(mut a, name));
            }
            return module_attr(m, name);
        }
        _ => {}
    }
    let o = obj_id(v);
    if o < 0 {
        let c = py_cls(a, v);
        return Err(no_attr(c.as_str(), name.as_str()));
    }
    let c = a.objs[o].cls;
    let meth = Val.Meth(o, name.clone());
    if name == "alias" and (is_term_cls(c) or c == C_TABLE or c == C_ALIASQ) {
        let al = get(a, o, F_ALIAS);
        return Ok(if is_absent(al) { Val.Non } else { al });
    }
    if name == "is_aggregate" and (is_node(a, v) or c == C_INTERVAL) {
        return Ok(tri_val(is_agg(a, v)));
    }
    if name == "star" and is_selectable(a, v) {
        return Ok(mk_star(mut a, v));
    }
    if c == C_TABLE {
        if in_words(words("as_ for_ for_portion field get_table_name get_sql select update insert"), name) {
            return Ok(meth);
        }
        return Ok(field_of(mut a, name, v));
    }
    if c == C_QB {
        if name == "dialect" {
            return Ok(get(a, o, F_DIALECT));
        }
        if qb_has_method(geti(a, o, F_DK), name) {
            return Ok(meth);
        }
        return Ok(field_of(mut a, name, v));
    }
    if c == C_SETOP {
        if in_words(words("orderby limit offset union union_all intersect except_of minus as_ get_sql field get_table_name"), name) {
            return Ok(meth);
        }
        return Ok(field_of(mut a, name, v));
    }
    if c == C_ALIASQ {
        if in_words(words("get_sql as_ field get_table_name"), name) {
            return Ok(meth);
        }
        return Ok(field_of(mut a, name, v));
    }
    if c == C_SCHEMA {
        if name == "get_sql" {
            return Ok(meth);
        }
        if getb(a, o, F_ISDB) {
            return Ok(mk_schema(mut a, sv(name), v, false));
        }
        return Ok(mk_table(mut a, sv(name), v, Val.Non, D_BASE));
    }
    if c == C_JOINER {
        return Ok(meth);
    }
    if c == C_CREATE or c == C_DROP or c == C_COLUMN or c == C_INTERVAL {
        return Ok(meth);
    }
    if is_term_cls(c) {
        if has_term_method(a, o, name) {
            return Ok(meth);
        }
        if c == C_NOT {
            return getattr_(mut a, get(a, o, F_TERM), name);
        }
    }
    let cn = py_cls(a, v);
    Err(no_attr(cn.as_str(), name.as_str()))
}

// ------------------------------------------------------------ calls

fn kw_from_args(kws: ref Vec[Karg]) -> Kw {
    let mut kw = kw0();
    for kv in kws {
        let k = kw_key(kv.k);
        if k >= 0 {
            kw = kw_set(kw, k, kv.v.clone());
        }
    }
    kw
}

fn call(a: mut ref A, f: ref Val, args: ref Vec[Val], kws: ref Vec[Karg]) -> Result[Val, Exc] {
    match f {
        Val.Meth(o, name) => return method_call(mut a, o, name, args, kws),
        Val.Name(n) => return builtin_call(mut a, n, args, kws),
        _ => {}
    }
    let c = cls_of(a, f);
    if c == C_CUSTOMFN {
        return custom_call(mut a, obj_id(f), args, kws);
    }
    if c == C_SQLTYPE {
        let o = new_obj(mut a, C_SQLTYPELEN);
        set(mut a, o, F_NAME, get(a, obj_id(f), F_NAME));
        set(mut a, o, F_LENGTH, param(args, kws, 0, "length"));
        return Ok(Val.Obj(o));
    }
    let n = py_cls(a, f);
    Err(type_error(f"'{n}' object is not callable"))
}

fn method_call(a: mut ref A, o: i64, name: ref String, args: ref Vec[Val], kws: ref Vec[Karg]) -> Result[Val, Exc] {
    let c = a.objs[o].cls;
    let v = Val.Obj(o);
    let a0 = param(args, kws, 0, "");
    if name == "get_sql" and c != C_QB {
        let kw = kw_from_args(kws);
        if c == C_EMPTY and kw.ks.len() == 0 {
            return Err(exc("NotImplementedError", String.new()));
        }
        return Ok(sv(sql(mut a, v, kw)?));
    }
    if c == C_QB {
        return qb_method(mut a, o, name, args, kws);
    }
    if c == C_JOINER {
        return joiner_method(mut a, o, name, args, kws);
    }
    if c == C_SETOP {
        return setop_method(mut a, o, name.clone(), args.clone(), kws.clone());
    }
    if c == C_CREATE {
        return create_method(mut a, o, name, args, kws);
    }
    if c == C_DROP {
        return drop_method(mut a, o, name, args);
    }
    if name == "field" {
        return Ok(mk_field(mut a, a0, Val.Non, v));
    }
    if name == "get_table_name" {
        return Ok(table_name(a, v));
    }
    if c == C_COLUMN and name == "get_name_sql" {
        let kw = kw_from_args(kws);
        return Ok(sv(column_name_sql(mut a, o, kw)?));
    }
    if c == C_TABLE {
        return table_method(mut a, o, name, args);
    }
    if name == "as_" {
        let n = copy_obj(mut a, o);
        set(mut a, n, F_ALIAS, a0);
        return Ok(Val.Obj(n));
    }
    term_method(mut a, o, name, args, kws)
}

fn table_method(a: mut ref A, o: i64, name: ref String, args: ref Vec[Val]) -> Result[Val, Exc] {
    let v = Val.Obj(o);
    let a0 = if args.len() > 0 { args[0].clone() } else { Val.Absent };
    if name == "as_" {
        let n = copy_obj(mut a, o);
        set(mut a, n, F_ALIAS, a0);
        return Ok(Val.Obj(n));
    }
    if name == "for_" or name == "for_portion" {
        let n = copy_obj(mut a, o);
        let f = py_truthy(get(a, n, F_FOR));
        let fp = py_truthy(get(a, n, F_FORP));
        if name == "for_" {
            if f {
                return Err(attr_error("'Query' object already has attribute for_".to_string()));
            }
            if fp {
                return Err(attr_error("'Query' object already has attribute for_portion".to_string()));
            }
            set(mut a, n, F_FOR, a0);
        } else {
            if fp {
                return Err(attr_error("'Query' object already has attribute for_portion".to_string()));
            }
            if f {
                return Err(attr_error("'Query' object already has attribute for_".to_string()));
            }
            set(mut a, n, F_FORP, a0);
        }
        return Ok(Val.Obj(n));
    }
    let dk = geti(a, o, F_QCLS);
    let q = mk_qb(mut a, dk, true, Val.Absent);
    let qo = obj_id(q);
    if name == "select" {
        let f = qb_method(mut a, qo, "from_".to_string(), vec![v], Vec.new())?;
        return qb_method(mut a, obj_id(f), "select".to_string(), args, Vec.new());
    }
    if name == "update" {
        return qb_method(mut a, qo, "update".to_string(), vec![v], Vec.new());
    }
    let f = qb_method(mut a, qo, "into".to_string(), vec![v], Vec.new())?;
    qb_method(mut a, obj_id(f), "insert".to_string(), args, Vec.new())
}

fn setop_method(a: mut ref A, o: i64, name: String, args: Vec[Val], kws: Vec[Karg]) -> Result[Val, Exc] {
    let a0 = if args.len() > 0 { args[0].clone() } else { Val.Absent };
    if name == "field" {
        return Ok(mk_field(mut a, a0, Val.Non, Val.Obj(o)));
    }
    if name == "get_table_name" {
        return Ok(get(a, o, F_ALIAS));
    }
    let n = copy_obj(mut a, o);
    if name == "as_" {
        set(mut a, n, F_ALIAS, a0);
    } else if name == "orderby" {
        let ord = order_kw(kws);
        let base = obj_id(get(a, n, F_BASE));
        for f in args {
            let fld = if is_str(f) {
                let ff = first_from(a, base)?;
                mk_field(mut a, f, Val.Non, ff)
            } else {
                wrap(mut a, f)
            };
            let pair = tup(mut a, vec![fld, ord.clone()]);
            lpush(mut a, n, F_ORDERBYS, pair);
        }
    } else if name == "limit" {
        set(mut a, n, F_LIMIT, a0);
    } else if name == "offset" {
        set(mut a, n, F_OFFSET, a0);
    } else if is_setop_name(name) {
        let pair = tup(mut a, vec![Val.En("SetOperation".to_string(), name.clone()), a0]);
        lpush(mut a, n, F_SETOPS, pair);
    } else {
        return Err(no_attr("_SetOperation", name.as_str()));
    }
    Ok(Val.Obj(n))
}

fn mk_case(a: mut ref A, alias: ref Val) -> Val {
    let o = new_term(mut a, C_CASE, alias);
    set_list(mut a, o, F_CASES, Vec.new());
    set(mut a, o, F_ELSE, Val.Non);
    Val.Obj(o)
}

fn matching_member(name: ref String) -> Str {
    if name == "glob" {
        "glob"
    } else if name == "like" {
        "like"
    } else if name == "not_like" {
        "not_like"
    } else if name == "ilike" {
        "ilike"
    } else if name == "not_ilike" {
        "not_ilike"
    } else if name == "rlike" {
        "rlike"
    } else if name == "regex" {
        "regex"
    } else if name == "regexp" {
        "regexp"
    } else if name == "as_of" {
        "as_of"
    } else if name == "bin_regex" {
        "bin_regex"
    } else {
        ""
    }
}

fn term_isin(a: mut ref A, v: ref Val, arg: ref Val) -> Val {
    if is_list_or_tuple(arg) {
        let xs = items(a, arg);
        let t = mk_tuple_cls(mut a, C_TUPLE, xs);
        return mk_contains(mut a, v, t);
    }
    mk_contains(mut a, v, arg)
}

fn term_negate(a: mut ref A, v: ref Val) -> Val {
    if cls_of(a, v) == C_CONTAINS {
        let n = copy_obj(mut a, obj_id(v));
        set(mut a, n, F_NEGATED, Val.Bool(true));
        return Val.Obj(n);
    }
    mk_unary(mut a, C_NOT, v)
}

fn term_method(a: mut ref A, o: i64, name: ref String, args: ref Vec[Val], kws: ref Vec[Karg]) -> Result[Val, Exc] {
    let v = Val.Obj(o);
    let c = a.objs[o].cls;
    let a0 = param(args, kws, 0, "");
    let a1 = param(args, kws, 1, "");
    if name == "eq" or name == "ne" or name == "gt" or name == "gte" or name == "lt" or name == "lte" {
        let op = if name == "eq" {
            "=="
        } else if name == "ne" {
            "!="
        } else if name == "gt" {
            ">"
        } else if name == "gte" {
            ">="
        } else if name == "lt" {
            "<"
        } else {
            "<="
        };
        return binop(mut a, op, v, a0);
    }
    if name == "lshift" {
        return binop(mut a, "<<", v, a0);
    }
    if name == "rshift" {
        return binop(mut a, ">>", v, a0);
    }
    if name == "isnull" {
        return Ok(mk_unary(mut a, C_NULLC, v));
    }
    if name == "isnotnull" {
        return Ok(mk_unary(mut a, C_NOTNULLC, v));
    }
    if name == "notnull" {
        let n = mk_unary(mut a, C_NULLC, v);
        return Ok(mk_unary(mut a, C_NOT, n));
    }
    if name == "bitwiseand" {
        let n = new_term(mut a, C_BITAND, Val.Non);
        set(mut a, n, F_TERM, v);
        let w = wrap(mut a, a0);
        set(mut a, n, F_VALUE, w);
        return Ok(Val.Obj(n));
    }
    let mm = matching_member(name);
    if mm.len() > 0 {
        return Ok(crit(mut a, "Matching", mm, v, a0));
    }
    if name == "between" {
        return Ok(mk_range(mut a, C_BETWEEN, v, a0, a1));
    }
    if name == "from_to" {
        return Ok(mk_range(mut a, C_PERIOD, v, a0, a1));
    }
    if name == "all_" {
        return Ok(mk_unary(mut a, C_ALL, v));
    }
    if name == "isin" {
        return Ok(term_isin(mut a, v, a0));
    }
    if name == "notin" {
        let i = term_isin(mut a, v, a0);
        return Ok(term_negate(mut a, i));
    }
    if name == "negate" {
        return Ok(term_negate(mut a, v));
    }
    if name == "replace_table" {
        return term_replace_table(mut a, v, a0, a1);
    }
    let n = copy_obj(mut a, o);
    if name == "filter" {
        set(mut a, n, F_INCF, Val.Bool(true));
        for f in args {
            lpush(mut a, n, F_FILTERS, f.clone());
        }
    } else if name == "distinct" {
        set(mut a, n, F_DISTINCT, Val.Bool(true));
    } else if name == "over" {
        set(mut a, n, F_INCO, Val.Bool(true));
        for t in args {
            lpush(mut a, n, F_PART, t.clone());
        }
    } else if name == "orderby" {
        set(mut a, n, F_INCO, Val.Bool(true));
        let ord = order_kw(kws);
        for t in args {
            let pair = tup(mut a, vec![t.clone(), ord.clone()]);
            lpush(mut a, n, F_ORDERBYS, pair);
        }
    } else if name == "rows" or name == "range" {
        if py_truthy(get(a, n, F_FRAME)) or py_truthy(get(a, n, F_BOUND)) {
            return Err(attr_error(String.new()));
        }
        set(mut a, n, F_FRAME, s_(if name == "rows" { "ROWS" } else { "RANGE" }));
        let b = if py_truthy(a1) { tup(mut a, vec![a0.clone(), a1.clone()]) } else { a0.clone() };
        set(mut a, n, F_BOUND, b);
    } else if name == "ignore_nulls" {
        set(mut a, n, F_IGN, Val.Bool(true));
    } else if name == "when" and c == C_CASE {
        let w = wrap(mut a, a1);
        let pair = tup(mut a, vec![a0, w]);
        lpush(mut a, n, F_CASES, pair);
    } else if name == "else_" and c == C_CASE {
        let w = wrap(mut a, a0);
        set(mut a, n, F_ELSE, w);
    } else {
        let cn = py_cls(a, v);
        return Err(no_attr(cn.as_str(), name.as_str()));
    }
    Ok(Val.Obj(n))
}

// ------------------------------------------------------------ CREATE and DROP

// MySQLQuery's create and drop builders keep the base dialect (None).
fn mk_create(a: mut ref A, ck: i64) -> Val {
    let o = new_obj(mut a, C_CREATE);
    set(mut a, o, F_DK, Val.Int(ck));
    set(mut a, o, F_CT, Val.Non);
    set(mut a, o, F_TEMP, Val.Bool(false));
    set(mut a, o, F_UNLOG, Val.Bool(false));
    set(mut a, o, F_ASSEL, Val.Non);
    set_list(mut a, o, F_COLUMNS, Vec.new());
    set_list(mut a, o, F_PERIODS, Vec.new());
    set(mut a, o, F_SYSVER, Val.Bool(false));
    set(mut a, o, F_PK, Val.Non);
    set_list(mut a, o, F_UNIQUES, Vec.new());
    set(mut a, o, F_INE, Val.Bool(false));
    set(mut a, o, F_DIALECT, if ck == D_MYSQL { Val.Non } else { dialect_of_kind(ck) });
    set(mut a, o, F_FKCOLS, Val.Non);
    set(mut a, o, F_FKTABLE, Val.Non);
    set(mut a, o, F_FKREF, Val.Non);
    set(mut a, o, F_FKUPD, Val.Non);
    set(mut a, o, F_FKDEL, Val.Non);
    set(mut a, o, F_LOCAL, Val.Bool(false));
    set(mut a, o, F_PRESERVE, Val.Bool(false));
    Val.Obj(o)
}

fn as_column(a: mut ref A, c: ref Val) -> Val {
    if cls_of(a, c) == C_COLUMN {
        return c.clone();
    }
    column_of(mut a, c)
}

fn prepare_columns(a: mut ref A, cols: ref Vec[Val]) -> Val {
    let mut out: Vec[Val] = Vec.new();
    for c in cols {
        out.push(as_column(mut a, c));
    }
    lst(mut a, out)
}

fn already(name: Str) -> Exc {
    attr_error(f"'Query' object already has attribute {name}")
}

fn create_method(a: mut ref A, o: i64, name: ref String, args: ref Vec[Val], kws: ref Vec[Karg]) -> Result[Val, Exc] {
    let n = copy_obj(mut a, o);
    let a0 = param(args, kws, 0, "");
    if name == "create_table" {
        if py_truthy(get(a, n, F_CT)) {
            return Err(already("create_table"));
        }
        let t = as_table(mut a, a0);
        set(mut a, n, F_CT, t);
    } else if name == "temporary" {
        set(mut a, n, F_TEMP, Val.Bool(true));
    } else if name == "unlogged" {
        set(mut a, n, F_UNLOG, Val.Bool(true));
    } else if name == "with_system_versioning" {
        set(mut a, n, F_SYSVER, Val.Bool(true));
    } else if name == "if_not_exists" {
        set(mut a, n, F_INE, Val.Bool(true));
    } else if name == "columns" {
        if py_truthy(get(a, n, F_ASSEL)) {
            return Err(already("as_select"));
        }
        for c in args {
            let col = if is_str(c) {
                column_of(mut a, c)
            } else if is_tuple_val(c) {
                let xs = items(a, c);
                mk_column(mut a, xs[0], xs[1], Val.Non, Val.Non)
            } else {
                c.clone()
            };
            lpush(mut a, n, F_COLUMNS, col);
        }
    } else if name == "period_for" {
        let p = new_obj(mut a, C_PERIODFOR);
        set(mut a, p, F_NAME, a0);
        let s = as_column(mut a, param(args, kws, 1, "start_column"));
        let e = as_column(mut a, param(args, kws, 2, "end_column"));
        set(mut a, p, F_SCOL, s);
        set(mut a, p, F_ECOL, e);
        lpush(mut a, n, F_PERIODS, Val.Obj(p));
    } else if name == "unique" {
        let cols = prepare_columns(mut a, args);
        lpush(mut a, n, F_UNIQUES, cols);
    } else if name == "primary_key" {
        let pk = get(a, n, F_PK);
        if py_truthy(pk) and items(a, pk).len() > 0 {
            return Err(already("primary_key"));
        }
        let cols = prepare_columns(mut a, args);
        set(mut a, n, F_PK, cols);
    } else if name == "foreign_key" {
        let fk = get(a, n, F_FKCOLS);
        if py_truthy(fk) and items(a, fk).len() > 0 {
            return Err(already("foreign_key"));
        }
        let cs = prepare_columns(mut a, items(a, a0));
        set(mut a, n, F_FKCOLS, cs);
        set(mut a, n, F_FKTABLE, param(args, kws, 1, "reference_table"));
        let rs = prepare_columns(mut a, items(a, param(args, kws, 2, "reference_columns")));
        set(mut a, n, F_FKREF, rs);
        set(mut a, n, F_FKDEL, param_or(args, kws, 3, "on_delete", Val.Non));
        set(mut a, n, F_FKUPD, param_or(args, kws, 4, "on_update", Val.Non));
    } else if name == "as_select" {
        if llen(a, n, F_COLUMNS) > 0 {
            return Err(already("columns"));
        }
        if not is_qb(a, a0) {
            return Err(type_error("Expected 'item' to be instance of QueryBuilder".to_string()));
        }
        set(mut a, n, F_ASSEL, a0);
    } else if (name == "local" or name == "preserve_rows") and geti(a, n, F_DK) == D_VERTICA {
        if not getb(a, n, F_TEMP) {
            return Err(attr_error("'Query' object has no attribute temporary".to_string()));
        }
        set(mut a, n, if name == "local" { F_LOCAL } else { F_PRESERVE }, Val.Bool(true));
    } else {
        return Err(no_attr("CreateQueryBuilder", name.as_str()));
    }
    Ok(Val.Obj(n))
}

fn mk_drop(a: mut ref A, dk: i64) -> Val {
    let o = new_obj(mut a, C_DROP);
    set(mut a, o, F_DK, Val.Int(dk));
    set(mut a, o, F_DTKIND, Val.Non);
    set(mut a, o, F_DTARGET, s_(""));
    set(mut a, o, F_IFEX, Val.Non);
    set(mut a, o, F_DIALECT, if dk == D_MYSQL { Val.Non } else { dialect_of_kind(dk) });
    Val.Obj(o)
}

fn drop_method(a: mut ref A, o: i64, name: ref String, args: ref Vec[Val]) -> Result[Val, Exc] {
    let n = copy_obj(mut a, o);
    let a0 = if args.len() > 0 { args[0].clone() } else { Val.Absent };
    if name == "if_exists" {
        set(mut a, n, F_IFEX, Val.Bool(true));
        return Ok(Val.Obj(n));
    }
    let (kind, target) = if name == "drop_database" {
        let t = if cls_of(a, a0) == C_SCHEMA and getb(a, obj_id(a0), F_ISDB) { a0.clone() } else { mk_schema(mut a, a0, Val.Non, true) };
        ("DATABASE", t)
    } else if name == "drop_table" {
        ("TABLE", as_table(mut a, a0))
    } else if name == "drop_user" {
        ("USER", a0.clone())
    } else if name == "drop_view" {
        ("VIEW", a0.clone())
    } else {
        return Err(no_attr("DropQueryBuilder", name.as_str()));
    };
    if py_truthy(get(a, n, F_DTARGET)) {
        return Err(attr_error("'DropQuery' object already has attribute drop_target".to_string()));
    }
    set(mut a, n, F_DTKIND, s_(kind));
    set(mut a, n, F_DTARGET, target);
    Ok(Val.Obj(n))
}

// ------------------------------------------------------------ the library's classes and functions

fn custom_call(a: mut ref A, o: i64, args: ref Vec[Val], kws: ref Vec[Karg]) -> Result[Val, Exc] {
    let name = gets(a, o, F_NAME);
    let params = get(a, o, F_PARAMS);
    let alias = karg(kws, "alias");
    if is_nothing(params) {
        let f = mk_func(mut a, "Function", "", Vec.new(), alias, Val.Non, 0);
        set(mut a, obj_id(f), F_NAME, sv(name));
        return Ok(f);
    }
    let ps = items(a, params);
    if ps.len() != args.len() {
        let mut pn: Vec[String] = Vec.new();
        for p in ps {
            pn.push(pystr(mut a, p)?);
        }
        let mut an_: Vec[String] = Vec.new();
        for x in args {
            an_.push(pystr(mut a, x)?);
        }
        let p1 = join_strs(pn, ", ");
        let p2 = join_strs(an_, ", ");
        return Err(exc("FunctionException", f"Function {name} require these arguments ({p1}), ({p2}) passed"));
    }
    let f = mk_func(mut a, "Function", "", args, alias, Val.Non, 0);
    set(mut a, obj_id(f), F_NAME, sv(name));
    Ok(f)
}

// The functions module: Python class, SQL name and class bits.
fn fn_catalogue() -> Vec[String] {
    words("Abs ABS 1 ApproximatePercentile APPROXIMATE_PERCENTILE 129 Ascii ASCII 0 Avg AVG 1 Bin BIN 0 Cast CAST 32 Coalesce COALESCE 0 Concat CONCAT 0 Count COUNT 3 CurDate CURRENT_DATE 0 CurTime CURRENT_TIME 0 CurTimestamp CURRENT_TIMESTAMP 256 Date DATE 0 DateAdd DATE_ADD 0 DateDiff DATEDIFF 0 Extract EXTRACT 64 First FIRST 1 Floor FLOOR 0 IfNull IFNULL 0 Insert INSERT 0 IsNull ISNULL 0 Last LAST 1 Length LENGTH 0 Lower LOWER 0 Max MAX 1 Min MIN 1 NVL NVL 0 Now NOW 0 NullIf NULLIF 0 RegexpLike REGEXP_LIKE 0 RegexpMatches REGEXP_MATCHES 0 Replace REPLACE 0 Reverse REVERSE 0 Signed CAST 32 SplitPart SPLIT_PART 0 Sqrt SQRT 0 Std STD 1 StdDev STDDEV 1 Substring SUBSTRING 0 Sum SUM 3 TimeDiff TIMEDIFF 0 Timestamp TIMESTAMP 0 TimestampAdd TIMESTAMPADD 0 ToChar TO_CHAR 0 ToDate TO_DATE 0 Trim TRIM 0 Unsigned CAST 32 Upper UPPER 0 UtcTimestamp UTC_TIMESTAMP 0")
}

// The analytics module.
fn an_catalogue() -> Vec[String] {
    words("Rank RANK 5 DenseRank DENSE_RANK 5 RowNumber ROW_NUMBER 5 NTile NTILE 5 Median MEDIAN 5 Lag LAG 5 Lead LEAD 5 FirstValue FIRST_VALUE 29 LastValue LAST_VALUE 29 Avg AVG 13 StdDev STDDEV 13 StdDevPop STDDEV_POP 13 StdDevSamp STDDEV_SAMP 13 Variance VARIANCE 13 VarPop VAR_POP 13 VarSamp VAR_SAMP 13 Count COUNT 13 Sum SUM 13 Max MAX 13 Min MIN 13")
}

// getattr(date_part, "value", date_part), as a LiteralValue.
fn date_part_lit(a: mut ref A, dp: ref Val) -> Result[Val, Exc] {
    let s = if is_enum(dp) { ev(dp) } else { pystr(mut a, dp)? };
    let o = new_term(mut a, C_LIT, Val.Non);
    set(mut a, o, F_VALUE, sv(s));
    set(mut a, o, F_KIND, s_("LiteralValue"));
    Ok(Val.Obj(o))
}

fn module_fn_call(a: mut ref A, m: ref String, name: ref String, args: ref Vec[Val], kws: ref Vec[Karg]) -> Result[Val, Exc] {
    if m == "an" and (name == "Preceding" or name == "Following") {
        let o = new_obj(mut a, C_EDGE);
        let v = param_or(args, kws, 0, "value", Val.Non);
        set(mut a, o, F_VALUE, v);
        set(mut a, o, F_MODIFIER, s_(if name == "Preceding" { "PRECEDING" } else { "FOLLOWING" }));
        return Ok(Val.Obj(o));
    }
    let cat = if m == "fn" { fn_catalogue() } else { an_catalogue() };
    let mut i = 0;
    let mut sqlname = String.new();
    let mut fk = -1;
    while i + 2 < cat.len() {
        if cat[i] == *name {
            sqlname = cat[i + 1].clone();
            fk = atoi(cat[i + 2]);
            break;
        }
        i += 3;
    }
    if fk < 0 {
        return Err(attr_error(f"module 'pypika.{m}' has no attribute '{name}'"));
    }
    let alias = karg(kws, "alias");
    let schema = karg(kws, "schema");
    let mut fargs: Vec[Val] = args.clone();
    let mut extra = Val.Absent;
    if m == "fn" {
        if name == "Count" {
            let p = args[0].clone();
            if is_str(p) and str_of(p) == "*" {
                fargs = vec![mk_star(mut a, Val.Non)];
            }
        } else if name == "ApproximatePercentile" or name == "Cast" or name == "Extract" {
            fargs = vec![args[0].clone()];
            extra = args[1].clone();
            if name == "Extract" {
                fargs = vec![date_part_lit(mut a, args[0])?];
            }
        } else if name == "Signed" or name == "Unsigned" {
            extra = s_(if name == "Signed" { "SIGNED" } else { "UNSIGNED" });
        } else if name == "DateAdd" or name == "TimestampAdd" {
            let dp = date_part_lit(mut a, args[0])?;
            fargs = vec![dp, args[1].clone(), args[2].clone()];
        } else if name == "RegexpMatches" or name == "RegexpLike" {
            if fargs.len() < 3 {
                fargs.push(param_or(args, kws, 2, "modifiers", Val.Non));
            }
        }
    }
    let f = mk_func(mut a, name.as_str(), sqlname.as_str(), fargs, alias, schema, fk);
    let o = obj_id(f);
    if name == "ApproximatePercentile" {
        set(mut a, o, F_PCT, Val.Float(num_f(extra)));
    } else if name == "Cast" or name == "Signed" or name == "Unsigned" {
        set(mut a, o, F_ASTYPE, extra);
    } else if name == "Extract" {
        set(mut a, o, F_FIELD, args[1].clone());
    }
    Ok(f)
}

// Table(name, schema=None, alias=None, query_cls=None)
fn table_call(a: mut ref A, args: ref Vec[Val], kws: ref Vec[Karg], qk: i64) -> Val {
    let name = param(args, kws, 0, "name");
    let schema = param(args, kws, 1, "schema");
    let alias = param(args, kws, 2, "alias");
    let qc = param(args, kws, 3, "query_cls");
    let k = match qc {
        Val.Name(n) => dialect_kind(n),
        _ => qk,
    };
    mk_table(mut a, name, schema, alias, if k < 0 { D_BASE } else { k })
}

// make_tables(*names, schema=, query_cls=)
fn tables_call(a: mut ref A, args: ref Vec[Val], kws: ref Vec[Karg], qk: i64) -> Val {
    let schema = karg(kws, "schema");
    let mut out: Vec[Val] = Vec.new();
    for n in args {
        if is_tuple_val(n) and items(a, n).len() == 2 {
            let xs = items(a, n);
            out.push(mk_table(mut a, xs[0], schema, xs[1], qk));
        } else {
            out.push(mk_table(mut a, n, schema, Val.Non, qk));
        }
    }
    lst(mut a, out)
}

fn drop_kind(q: ref String, method: ref String) -> i64 {
    let dk = dialect_kind(q);
    if dk == D_CH {
        return D_CH;
    }
    if method == "drop_table" and (dk == D_MYSQL or dk == D_SNOW) {
        return dk;
    }
    D_BASE
}

// <Query class>.<classmethod>(...)
fn query_cls_call(a: mut ref A, q: ref String, m: ref String, args: ref Vec[Val], kws: ref Vec[Karg]) -> Result[Val, Exc] {
    let dk = dialect_kind(q);
    if m == "Table" {
        return Ok(table_call(mut a, args, kws, dk));
    }
    if m == "Tables" {
        return Ok(tables_call(mut a, args, kws, dk));
    }
    if m == "create_table" {
        let ck = if dk == D_MYSQL or dk == D_SNOW or dk == D_VERTICA { dk } else { D_BASE };
        let c = mk_create(mut a, ck);
        return create_method(mut a, obj_id(c), m, args, kws);
    }
    if m.starts_with("drop_") {
        let d = mk_drop(mut a, drop_kind(q, m));
        return drop_method(mut a, obj_id(d), m, args);
    }
    let imm = karg(kws, "immutable");
    let askw = karg(kws, "as_keyword");
    let mut rest: Vec[Karg] = Vec.new();
    for kv in kws {
        if kv.k != "immutable" and kv.k != "as_keyword" {
            rest.push(kv.clone());
        }
    }
    let qb = mk_qb(mut a, dk, if is_absent(imm) { true } else { py_truthy(imm) }, askw);
    qb_method(mut a, obj_id(qb), m, args, rest)
}

fn param_cls(n: ref String) -> bool {
    n == "Parameter" or n == "QmarkParameter" or n == "NumericParameter" or n == "NamedParameter"
        or n == "FormatParameter" or n == "PyformatParameter"
}

fn crit_fold(a: mut ref A, op: Str, terms: ref Val) -> Result[Val, Exc] {
    let mut c = Val.Obj(new_term(mut a, C_EMPTY, Val.Non));
    if is_nothing(terms) {
        return Ok(c);
    }
    for t in items(a, terms) {
        c = binop(mut a, op, c, t)?;
    }
    Ok(c)
}

// A call of one of the names the jobs see: the library's classes, its
// modules' functions and the Query classes' classmethods.
fn builtin_call(a: mut ref A, n: ref String, args: ref Vec[Val], kws: ref Vec[Karg]) -> Result[Val, Exc] {
    let dot = split_once(n, ".");
    if dot.len() == 2 {
        let m = dot[0].clone();
        let name = dot[1].clone();
        if m == "fn" or m == "an" {
            return module_fn_call(mut a, m, name, args, kws);
        }
        if m == "Criterion" {
            let terms = param_or(args, kws, 0, "terms", Val.Non);
            return crit_fold(mut a, if name == "all" { "&" } else { "|" }, terms);
        }
        return query_cls_call(mut a, m, name, args, kws);
    }
    let a0 = param(args, kws, 0, "");
    if n == "Table" {
        return Ok(table_call(mut a, args, kws, D_BASE));
    }
    if n == "Tables" {
        let qc = karg(kws, "query_cls");
        let qk = match qc {
            Val.Name(q) => dialect_kind(q),
            _ => D_BASE,
        };
        return Ok(tables_call(mut a, args, kws, qk));
    }
    if n == "Field" {
        let name = param(args, kws, 0, "name");
        let alias = param(args, kws, 1, "alias");
        let table = param(args, kws, 2, "table");
        return Ok(mk_field(mut a, name, alias, table));
    }
    if n == "Schema" or n == "Database" {
        let name = param(args, kws, 0, "name");
        let parent = param(args, kws, 1, "parent");
        return Ok(mk_schema(mut a, name, parent, n == "Database"));
    }
    if n == "AliasedQuery" {
        let name = param(args, kws, 0, "name");
        let query = param(args, kws, 1, "query");
        return Ok(mk_aliasq(mut a, name, query));
    }
    if n == "Column" {
        let name = param(args, kws, 0, "column_name");
        let ctype = param(args, kws, 1, "column_type");
        let nullable = param(args, kws, 2, "nullable");
        let default = param(args, kws, 3, "default");
        return Ok(mk_column(mut a, name, ctype, nullable, default));
    }
    if n == "Columns" {
        let mut out: Vec[Val] = Vec.new();
        for x in args {
            if is_tuple_val(x) and items(a, x).len() == 2 {
                let xs = items(a, x);
                out.push(mk_column(mut a, xs[0], xs[1], Val.Non, Val.Non));
            } else {
                out.push(column_of(mut a, x));
            }
        }
        return Ok(lst(mut a, out));
    }
    if n == "Tuple" {
        return Ok(mk_tuple_cls(mut a, C_TUPLE, args));
    }
    if n == "Array" {
        return Ok(mk_tuple_cls(mut a, C_ARRAY, args));
    }
    if n == "Bracket" {
        return Ok(mk_tuple_cls(mut a, C_BRACKET, vec![a0]));
    }
    if n == "Case" {
        return Ok(mk_case(mut a, karg(kws, "alias")));
    }
    if n == "EmptyCriterion" {
        return Ok(Val.Obj(new_term(mut a, C_EMPTY, Val.Non)));
    }
    if n == "Not" {
        let v = mk_unary(mut a, C_NOT, a0);
        set(mut a, obj_id(v), F_ALIAS, param_or(args, kws, 1, "alias", Val.Non));
        return Ok(v);
    }
    if n == "NullValue" {
        let alias = param(args, kws, 0, "alias");
        return Ok(mk_lit(mut a, "NullValue", "NULL".to_string(), alias));
    }
    if n == "Interval" {
        let units = words("years months days hours minutes seconds microseconds");
        let mut vals: Vec[Val] = Vec.new();
        let mut i = 0;
        while i < 7 {
            vals.push(param_or(args, kws, i, units[i].as_str(), Val.Int(0)));
            i += 1;
        }
        let quarters = param_or(args, kws, 7, "quarters", Val.Int(0));
        let weeks = param_or(args, kws, 8, "weeks", Val.Int(0));
        let dialect = param(args, kws, 9, "dialect");
        return Ok(mk_interval(mut a, vals, quarters, weeks, dialect));
    }
    if n == "Index" {
        return Ok(mk_index(mut a, a0));
    }
    if n == "Values" {
        let f = if is_field(a, a0) { a0.clone() } else { mk_field(mut a, a0, Val.Non, Val.Non) };
        let o = new_term(mut a, C_VALUES, Val.Non);
        set(mut a, o, F_FIELD, f);
        return Ok(Val.Obj(o));
    }
    if n == "ValueWrapper" {
        let alias = param(args, kws, 1, "alias");
        return Ok(mk_vw(mut a, a0, alias, false));
    }
    if param_cls(n) {
        let o = new_term(mut a, C_PARAM, Val.Non);
        set(mut a, o, F_KIND, sv(n));
        set(mut a, o, F_VALUE, if is_absent(a0) { Val.Non } else { a0 });
        return Ok(Val.Obj(o));
    }
    if n == "CustomFunction" {
        let o = new_obj(mut a, C_CUSTOMFN);
        set(mut a, o, F_NAME, a0);
        set(mut a, o, F_PARAMS, param_or(args, kws, 1, "params", Val.Non));
        return Ok(Val.Obj(o));
    }
    if n == "Rollup" {
        return Ok(mk_func(mut a, "Rollup", "ROLLUP", args, Val.Non, Val.Non, 0));
    }
    if n == "date" {
        let y = int_of(args[0]);
        let mo = int_of(args[1]);
        let d = int_of(args[2]);
        return Ok(Val.Date(y * 10000 + mo * 100 + d));
    }
    Err(type_error(f"'{n}' object is not callable"))
}

// ------------------------------------------------------------ the names a job sees

fn base_names() -> Vec[String] {
    words("NULL SYSTEM_TIME AliasedQuery Array Bracket Case ClickHouseQuery Column Columns Criterion CustomFunction Database DatePart EmptyCriterion Field FormatParameter Index Interval JoinType MSSQLQuery MySQLQuery NamedParameter Not NullValue NumericParameter OracleQuery Order Parameter PostgreSQLQuery PyformatParameter QmarkParameter Query RedshiftQuery Rollup Schema SQLLiteQuery SnowflakeQuery Table Tables Tuple Values ValueWrapper VerticaQuery ReferenceOption SqlTypes fn an date")
}

struct Env {
    names: Vec[String],
    vals: Vec[Val],
}

fn env_new(a: mut ref A) -> Env {
    let mut e = Env { names: Vec.new(), vals: Vec.new() };
    for n in base_names() {
        let v = if n == "NULL" {
            mk_null(mut a)
        } else if n == "SYSTEM_TIME" {
            mk_lit(mut a, "SystemTimeValue", "SYSTEM_TIME".to_string(), Val.Non)
        } else {
            sv(n)
        };
        let v2 = match v {
            Val.Str(s) => Val.Name(s),
            other => other,
        };
        e.names.push(n.clone());
        e.vals.push(v2);
    }
    e
}

fn env_get(e: ref Env, name: ref String) -> Result[Val, Exc] {
    let mut i = e.names.len();
    while i > 0 {
        i -= 1;
        if e.names[i] == *name {
            return Ok(e.vals[i].clone());
        }
    }
    Err(exc("NameError", f"name '{name}' is not defined"))
}

fn env_set(e: mut ref Env, name: ref String, v: ref Val) {
    let mut i = 0;
    while i < e.names.len() {
        if e.names[i] == *name {
            e.vals[i] = v.clone();
            return;
        }
        i += 1;
    }
    e.names.push(name.clone());
    e.vals.push(v.clone());
}

// ------------------------------------------------------------ the evaluator

// A job's expression is Python, so it is tokenized and evaluated as it is
// parsed: names, numbers, strings (adjacent ones joined), operators,
// attribute access, calls with *args and keywords, subscripts and slices,
// and tuple and list displays.
const T_NAME: i64 = 1;
const T_INT: i64 = 2;
const T_FLOAT: i64 = 3;
const T_STR: i64 = 4;
const T_OP: i64 = 5;
const T_END: i64 = 6;

#[derive(Clone)]
struct Tok {
    k: i64,
    s: String,
}

fn is_name_char(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_'
}

fn tokenize(src: ref String) -> Result[Vec[Tok], Exc] {
    let cs: Vec[char] = src.chars().collect();
    let n = cs.len();
    let mut out: Vec[Tok] = Vec.new();
    let mut i = 0;
    while i < n {
        let c = cs[i];
        if c == ' ' {
            i += 1;
            continue;
        }
        if is_name_char(c) and not (c >= '0' and c <= '9') {
            let mut s = String.new();
            while i < n and is_name_char(cs[i]) {
                s.push(cs[i]);
                i += 1;
            }
            out.push(Tok { k: T_NAME, s: s });
            continue;
        }
        if c >= '0' and c <= '9' {
            let mut s = String.new();
            let mut float = false;
            while i < n and ((cs[i] >= '0' and cs[i] <= '9') or cs[i] == '.') {
                if cs[i] == '.' {
                    float = true;
                }
                s.push(cs[i]);
                i += 1;
            }
            out.push(Tok { k: if float { T_FLOAT } else { T_INT }, s: s });
            continue;
        }
        if c == '\'' or c == '"' {
            let mut s = String.new();
            i += 1;
            while i < n and cs[i] != c {
                s.push(cs[i]);
                i += 1;
            }
            i += 1;
            let k = out.len();
            if k > 0 and out[k - 1].k == T_STR {
                out[k - 1].s.push_str(s);
            } else {
                out.push(Tok { k: T_STR, s: s });
            }
            continue;
        }
        let two = if i + 1 < n {
            let mut t = String.new();
            t.push(c);
            t.push(cs[i + 1]);
            t
        } else {
            String.new()
        };
        if two == "**" or two == "<<" or two == ">>" or two == "==" or two == "!=" or two == "<=" or two == ">="
            or two == "//" {
            out.push(Tok { k: T_OP, s: two });
            i += 2;
            continue;
        }
        let mut s = String.new();
        s.push(c);
        out.push(Tok { k: T_OP, s: s });
        i += 1;
    }
    out.push(Tok { k: T_END, s: String.new() });
    Ok(out)
}

struct P {
    toks: Vec[Tok],
    i: i64,
}

fn peek_op(p: ref P, op: Str) -> bool {
    p.toks[p.i].k == T_OP and p.toks[p.i].s == op
}

fn peek_name(p: ref P, name: Str) -> bool {
    p.toks[p.i].k == T_NAME and p.toks[p.i].s == name
}

fn expect(p: mut ref P, op: Str) -> Result[(), Exc] {
    if not peek_op(p, op) {
        return Err(exc("SyntaxError", f"expected '{op}'"));
    }
    p.i += 1;
    Ok(())
}

fn ends_seq(p: ref P) -> bool {
    peek_op(p, ")") or peek_op(p, "]") or p.toks[p.i].k == T_END
}

// a, b, ... as a tuple; a single expression with no comma is itself.
fn expr_list(p: mut ref P, a: mut ref A, e: ref Env) -> Result[Val, Exc] {
    let first = test(mut p, mut a, e)?;
    if not peek_op(p, ",") {
        return Ok(first);
    }
    let mut xs = vec![first];
    while peek_op(p, ",") {
        p.i += 1;
        if ends_seq(p) {
            break;
        }
        xs.push(test(mut p, mut a, e)?);
    }
    Ok(tup(mut a, xs))
}

fn cmp_op(p: ref P) -> String {
    let t = p.toks[p.i].clone();
    if t.k == T_OP and (t.s == "==" or t.s == "!=" or t.s == "<" or t.s == ">" or t.s == "<=" or t.s == ">=") {
        return t.s;
    }
    if t.k == T_NAME and t.s == "is" {
        return t.s;
    }
    String.new()
}

fn test(p: mut ref P, a: mut ref A, e: ref Env) -> Result[Val, Exc] {
    let mut l = bor(mut p, mut a, e)?;
    loop {
        let op = cmp_op(p);
        if op.len() == 0 {
            return Ok(l);
        }
        p.i += 1;
        if op == "is" {
            let neg = peek_name(p, "not");
            if neg {
                p.i += 1;
            }
            let r = bor(mut p, mut a, e)?;
            let same = identical(l, r) or (is_nothing(l) and is_nothing(r));
            l = Val.Bool(if neg { not same } else { same });
            continue;
        }
        let r = bor(mut p, mut a, e)?;
        l = binop(mut a, op.as_str(), l, r)?;
    }
}

fn bor(p: mut ref P, a: mut ref A, e: ref Env) -> Result[Val, Exc] {
    let mut l = bxor(mut p, mut a, e)?;
    while peek_op(p, "|") {
        p.i += 1;
        let r = bxor(mut p, mut a, e)?;
        l = binop(mut a, "|", l, r)?;
    }
    Ok(l)
}

fn bxor(p: mut ref P, a: mut ref A, e: ref Env) -> Result[Val, Exc] {
    let mut l = band(mut p, mut a, e)?;
    while peek_op(p, "^") {
        p.i += 1;
        let r = band(mut p, mut a, e)?;
        l = binop(mut a, "^", l, r)?;
    }
    Ok(l)
}

fn band(p: mut ref P, a: mut ref A, e: ref Env) -> Result[Val, Exc] {
    let mut l = shift(mut p, mut a, e)?;
    while peek_op(p, "&") {
        p.i += 1;
        let r = shift(mut p, mut a, e)?;
        l = binop(mut a, "&", l, r)?;
    }
    Ok(l)
}

fn shift(p: mut ref P, a: mut ref A, e: ref Env) -> Result[Val, Exc] {
    let mut l = arith(mut p, mut a, e)?;
    while peek_op(p, "<<") or peek_op(p, ">>") {
        let op = p.toks[p.i].s.clone();
        p.i += 1;
        let r = arith(mut p, mut a, e)?;
        l = binop(mut a, op.as_str(), l, r)?;
    }
    Ok(l)
}

fn arith(p: mut ref P, a: mut ref A, e: ref Env) -> Result[Val, Exc] {
    let mut l = term_(mut p, mut a, e)?;
    while peek_op(p, "+") or peek_op(p, "-") {
        let op = p.toks[p.i].s.clone();
        p.i += 1;
        let r = term_(mut p, mut a, e)?;
        l = binop(mut a, op.as_str(), l, r)?;
    }
    Ok(l)
}

fn term_(p: mut ref P, a: mut ref A, e: ref Env) -> Result[Val, Exc] {
    let mut l = factor(mut p, mut a, e)?;
    while peek_op(p, "*") or peek_op(p, "/") or peek_op(p, "%") or peek_op(p, "//") {
        let op = p.toks[p.i].s.clone();
        p.i += 1;
        let r = factor(mut p, mut a, e)?;
        l = binop(mut a, op.as_str(), l, r)?;
    }
    Ok(l)
}

fn factor(p: mut ref P, a: mut ref A, e: ref Env) -> Result[Val, Exc] {
    if peek_op(p, "-") or peek_op(p, "+") or peek_op(p, "~") {
        let op = p.toks[p.i].s.clone();
        p.i += 1;
        let v = factor(mut p, mut a, e)?;
        return unop(mut a, op.as_str(), v);
    }
    power(mut p, mut a, e)
}

fn power(p: mut ref P, a: mut ref A, e: ref Env) -> Result[Val, Exc] {
    let l = postfix(mut p, mut a, e)?;
    if peek_op(p, "**") {
        p.i += 1;
        let r = factor(mut p, mut a, e)?;
        return binop(mut a, "**", l, r);
    }
    Ok(l)
}

fn call_args(p: mut ref P, a: mut ref A, e: ref Env) -> Result[(Vec[Val], Vec[Karg]), Exc] {
    let mut args: Vec[Val] = Vec.new();
    let mut kws: Vec[Karg] = Vec.new();
    while not peek_op(p, ")") {
        if peek_op(p, "*") {
            p.i += 1;
            let v = test(mut p, mut a, e)?;
            for x in items(a, v) {
                args.push(x.clone());
            }
        } else if p.toks[p.i].k == T_NAME and p.toks[p.i + 1].k == T_OP and p.toks[p.i + 1].s == "=" {
            let k = p.toks[p.i].s.clone();
            p.i += 2;
            let v = test(mut p, mut a, e)?;
            kws.push(Karg { k: k, v: v });
        } else {
            args.push(test(mut p, mut a, e)?);
        }
        if peek_op(p, ",") {
            p.i += 1;
        }
    }
    p.i += 1;
    Ok((args, kws))
}

fn slice_part(p: mut ref P, a: mut ref A, e: ref Env) -> Result[Val, Exc] {
    if peek_op(p, ":") or peek_op(p, "]") {
        return Ok(Val.Non);
    }
    test(mut p, mut a, e)
}

// v[k]
fn subscript(a: mut ref A, v: ref Val, k: ref Val) -> Result[Val, Exc] {
    let is_slice = match k {
        Val.Slc(_) => true,
        _ => false,
    };
    if is_list_or_tuple(v) {
        let xs = items(a, v);
        let mut i = int_of(k);
        if i < 0 {
            i += xs.len();
        }
        if i < 0 or i >= xs.len() {
            let what = if is_tuple_val(v) { "tuple" } else { "list" };
            return Err(exc("IndexError", f"{what} index out of range"));
        }
        return Ok(xs[i].clone());
    }
    let c = cls_of(a, v);
    if c == C_QB and is_slice {
        return qb_method(mut a, obj_id(v), "slice".to_string(), vec![k.clone()], Vec.new());
    }
    if is_selectable(a, v) {
        return method_call(mut a, obj_id(v), "field".to_string(), vec![k.clone()], Vec.new());
    }
    if is_term_cls(c) {
        if not is_slice {
            return Err(type_error("Field' object is not subscriptable".to_string()));
        }
        let lu = items(a, k);
        return term_method(mut a, obj_id(v), "between".to_string(), lu, Vec.new());
    }
    let n = py_cls(a, v);
    Err(type_error(f"'{n}' object is not subscriptable"))
}

fn postfix(p: mut ref P, a: mut ref A, e: ref Env) -> Result[Val, Exc] {
    let mut v = atom(mut p, mut a, e)?;
    loop {
        if peek_op(p, ".") {
            p.i += 1;
            let name = p.toks[p.i].s.clone();
            p.i += 1;
            v = getattr_(mut a, v, name)?;
        } else if peek_op(p, "(") {
            p.i += 1;
            let (args, kws) = call_args(mut p, mut a, e)?;
            v = call(mut a, v, args, kws)?;
        } else if peek_op(p, "[") {
            p.i += 1;
            let lo = slice_part(mut p, mut a, e)?;
            let k = if peek_op(p, ":") {
                p.i += 1;
                let hi = slice_part(mut p, mut a, e)?;
                Val.Slc(new_list(mut a, vec![lo, hi]))
            } else {
                lo
            };
            expect(mut p, "]")?;
            v = subscript(mut a, v, k)?;
        } else {
            return Ok(v);
        }
    }
}

fn atom(p: mut ref P, a: mut ref A, e: ref Env) -> Result[Val, Exc] {
    let t = p.toks[p.i].clone();
    p.i += 1;
    if t.k == T_NAME {
        if t.s == "True" {
            return Ok(Val.Bool(true));
        }
        if t.s == "False" {
            return Ok(Val.Bool(false));
        }
        if t.s == "None" {
            return Ok(Val.Non);
        }
        return env_get(e, t.s);
    }
    if t.k == T_INT {
        return Ok(Val.Int(atoi(t.s)));
    }
    if t.k == T_FLOAT {
        return match f64.parse(t.s.clone()) {
            Ok(x) => Ok(Val.Float(x)),
            Err(_) => Err(exc("SyntaxError", t.s.clone())),
        };
    }
    if t.k == T_STR {
        return Ok(Val.Str(t.s));
    }
    if t.k == T_OP and t.s == "(" {
        if peek_op(p, ")") {
            p.i += 1;
            return Ok(tup(mut a, Vec.new()));
        }
        let first = test(mut p, mut a, e)?;
        if peek_op(p, ")") {
            p.i += 1;
            return Ok(first);
        }
        let mut xs = vec![first];
        while peek_op(p, ",") {
            p.i += 1;
            if peek_op(p, ")") {
                break;
            }
            xs.push(test(mut p, mut a, e)?);
        }
        expect(mut p, ")")?;
        return Ok(tup(mut a, xs));
    }
    if t.k == T_OP and t.s == "[" {
        let mut xs: Vec[Val] = Vec.new();
        while not peek_op(p, "]") {
            xs.push(test(mut p, mut a, e)?);
            if peek_op(p, ",") {
                p.i += 1;
            }
        }
        p.i += 1;
        return Ok(lst(mut a, xs));
    }
    Err(exc("SyntaxError", f"unexpected '{t.s}'"))
}

fn eval_src(a: mut ref A, e: ref Env, src: ref String) -> Result[Val, Exc] {
    let toks = tokenize(src)?;
    let mut p = P { toks: toks, i: 0 };
    let v = expr_list(mut p, mut a, e)?;
    if p.toks[p.i].k != T_END {
        return Err(exc("SyntaxError", "invalid syntax".to_string()));
    }
    Ok(v)
}

// ------------------------------------------------------------ the programs

fn read_text(rel: ref String) -> Result[String, Exc] {
    match fs.read_bytes(f"data/{rel}") {
        Ok(b) => match String.from_utf8(b) {
            Ok(s) => Ok(s),
            Err(_) => Err(exc("UnicodeDecodeError", rel.clone())),
        },
        Err(e) => Err(exc("FileNotFoundError", f"{e}")),
    }
}

fn write_inputs() -> Result[(), String] {
    for d in ["data/out/migrate", "data/out/reports", "data/out/load"] {
        if let Err(e) = fs.create_dir_all(d.to_string()) {
            return Err(f"cannot create {d}: {e}");
        }
    }
    for line in split_on(inputs_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, ' ');
        if let Err(e) = fs.write_bytes(f"data/{f[0]}", hex_bytes(f[1])) {
            return Err(f"cannot write {f[0]}: {e}");
        }
    }
    Ok(())
}

// Writes data/<rel> and prints it back.
fn write_back(rel: ref String, text: ref String) -> Result[(), Exc] {
    if let Err(e) = fs.write(f"data/{rel}", text.clone()) {
        return Err(exc("OSError", f"{e}"));
    }
    let back = read_text(rel)?;
    let mut lines = split_on(back, '\n');
    if lines.len() > 0 and lines[lines.len() - 1].len() == 0 {
        lines.pop();
    }
    let n = lines.len();
    println(f"  wrote {rel} ({n} lines)");
    for ln in lines {
        println(f"  | {ln}");
    }
    Ok(())
}

fn tsv(rel: ref String) -> Result[Vec[Vec[String]], Exc] {
    let mut rows: Vec[Vec[String]] = Vec.new();
    for ln in split_on(read_text(rel)?, '\n') {
        if ln.len() > 0 and not ln.starts_with("#") {
            rows.push(split_on(ln, '\t'));
        }
    }
    Ok(rows)
}

// obj.<name>(*args)
fn mcall(a: mut ref A, v: ref Val, name: Str, args: own Vec[Val]) -> Result[Val, Exc] {
    method_call(mut a, obj_id(v), name.to_string(), args, Vec.new())
}

fn mcall_kw(a: mut ref A, v: ref Val, name: Str, args: own Vec[Val], kws: own Vec[Karg]) -> Result[Val, Exc] {
    method_call(mut a, obj_id(v), name.to_string(), args, kws)
}

// <Query class>.<name>(*args)
fn qcall(a: mut ref A, q: Str, name: Str, args: own Vec[Val]) -> Result[Val, Exc] {
    query_cls_call(mut a, q.to_string(), name.to_string(), args, Vec.new())
}

fn fcall(a: mut ref A, name: Str, args: own Vec[Val]) -> Result[Val, Exc] {
    module_fn_call(mut a, "fn".to_string(), name.to_string(), args, Vec.new())
}

fn strs(xs: ref Vec[String]) -> Vec[Val] {
    let mut out: Vec[Val] = Vec.new();
    for x in xs {
        out.push(sv(x));
    }
    out
}

// A default or a data value as the file spells it.
fn value_of(text: ref String) -> Val {
    if text.len() == 0 {
        return Val.Non;
    }
    if text == "true" {
        return Val.Bool(true);
    }
    if text == "false" {
        return Val.Bool(false);
    }
    let body = if text.starts_with("-") { text.substring(1, text.len()) } else { text.clone() };
    if all_digits(body) {
        return Val.Int(atoi(text));
    }
    if split_on(body, '.').len() == 2 and all_digits(body.replace(".", "")) {
        return match f64.parse(text.clone()) {
            Ok(x) => Val.Float(x),
            Err(_) => sv(text),
        };
    }
    sv(text)
}

fn default_of(a: mut ref A, text: ref String) -> Result[Val, Exc] {
    if text == "-" {
        return Ok(Val.Non);
    }
    if text == "=now" {
        return fcall(mut a, "Now", Vec.new());
    }
    if text == "=curdate" {
        return fcall(mut a, "CurDate", Vec.new());
    }
    if text.len() >= 2 and text.starts_with("'") and text.ends_with("'") {
        return Ok(sv(text.substring(1, text.len() - 1)));
    }
    Ok(value_of(text))
}

fn find_str(xs: ref Vec[String], x: ref String) -> i64 {
    let mut i = 0;
    while i < xs.len() {
        if xs[i] == *x {
            return i;
        }
        i += 1;
    }
    -1
}

fn migrate(a: mut ref A, rel: ref String) -> Result[(), Exc] {
    let rows = tsv(rel)?;
    let mut order: Vec[String] = Vec.new();
    for r in rows {
        if find_str(order, r[0]) < 0 {
            order.push(r[0].clone());
        }
    }
    for (dname, cls) in [("ansi", "Query"), ("mysql", "MySQLQuery"), ("snowflake", "SnowflakeQuery")] {
        let mut stmts: Vec[String] = Vec.new();
        for tname in order {
            let c0 = qcall(mut a, cls, "create_table", vec![sv(tname)])?;
            let mut q = mcall(mut a, c0, "if_not_exists", Vec.new())?;
            let mut columns: Vec[Val] = Vec.new();
            let mut pks: Vec[Val] = Vec.new();
            let mut uniques: Vec[String] = Vec.new();
            let mut unique_cols: Vec[Vec[Val]] = Vec.new();
            let mut fks: Vec[String] = Vec.new();
            let mut fk_cols: Vec[Vec[Val]] = Vec.new();
            let mut fk_refs: Vec[Vec[Val]] = Vec.new();
            for r in rows {
                if r[0] != *tname {
                    continue;
                }
                let nullable = if r[3] == "yes" { Val.Bool(true) } else if r[3] == "no" { Val.Bool(false) } else { Val.Non };
                let d = default_of(mut a, r[4])?;
                columns.push(mk_column(mut a, sv(r[1]), sv(r[2]), nullable, d));
                for key in split_on(r[5], ';') {
                    if key == "pk" {
                        pks.push(sv(r[1]));
                    } else if key.starts_with("unique:") {
                        let g = key.substring(7, key.len());
                        let mut k = find_str(uniques, g);
                        if k < 0 {
                            uniques.push(g);
                            unique_cols.push(Vec.new());
                            k = uniques.len() - 1;
                        }
                        unique_cols[k].push(sv(r[1]));
                    } else if key.starts_with("fk:") {
                        let tc = split_on(key.substring(3, key.len()), '.');
                        let mut k = find_str(fks, tc[0]);
                        if k < 0 {
                            fks.push(tc[0].clone());
                            fk_cols.push(Vec.new());
                            fk_refs.push(Vec.new());
                            k = fks.len() - 1;
                        }
                        fk_cols[k].push(sv(r[1]));
                        fk_refs[k].push(sv(tc[1]));
                    }
                }
            }
            q = mcall(mut a, q, "columns", columns)?;
            let mut g = 0;
            while g < uniques.len() {
                q = mcall(mut a, q, "unique", unique_cols[g].clone())?;
                g += 1;
            }
            if pks.len() > 0 {
                q = mcall(mut a, q, "primary_key", pks)?;
            }
            let mut err = String.new();
            let mut k = 0;
            while k < fks.len() {
                let cols = lst(mut a, fk_cols[k].clone());
                let refs = lst(mut a, fk_refs[k].clone());
                let t = table_of(mut a, fks[k]);
                let kws = vec![Karg { k: "on_delete".to_string(), v: en("ReferenceOption", "cascade") }];
                match mcall_kw(mut a, q, "foreign_key", vec![cols, t, refs], kws) {
                    Ok(v) => q = v,
                    Err(e) => {
                        let c = e.cls.clone();
                        let m = e.msg.clone();
                        err = f"-- {tname}: error {c}: {m}";
                    }
                }
                k += 1;
            }
            if err.len() > 0 {
                stmts.push(err);
            }
            stmts.push(pystr(mut a, q)? + ";");
        }
        let mut i = order.len();
        while i > 0 {
            i -= 1;
            let d0 = qcall(mut a, cls, "drop_table", vec![sv(order[i])])?;
            let d = mcall(mut a, d0, "if_exists", Vec.new())?;
            stmts.push(pystr(mut a, d)? + ";");
        }
        write_back(f"out/migrate/{dname}.sql", join_strs(stmts, "\n") + "\n")?;
    }
    Ok(())
}

// ------------------------------------------------------------ reports

#[derive(Clone)]
struct Named {
    k: String,
    v: Val,
}

fn lookup(xs: ref Vec[Named], k: ref String) -> Result[Val, Exc] {
    for x in xs {
        if x.k == *k {
            return Ok(x.v.clone());
        }
    }
    Err(exc("KeyError", str_repr(k)))
}

fn has_key(xs: ref Vec[Named], k: ref String) -> bool {
    for x in xs {
        if x.k == *k {
            return true;
        }
    }
    false
}

fn put(xs: mut ref Vec[Named], k: ref String, v: ref Val) {
    let mut i = 0;
    while i < xs.len() {
        if xs[i].k == *k {
            xs[i].v = v.clone();
            return;
        }
        i += 1;
    }
    xs.push(Named { k: k.clone(), v: v.clone() });
}

fn report_fn(name: ref String) -> Result[String, Exc] {
    let names = words("sum Sum count Count avg Avg min Min max Max upper Upper lower Lower");
    let mut i = 0;
    while i + 1 < names.len() {
        if names[i] == *name {
            return Ok(names[i + 1].clone());
        }
        i += 2;
    }
    Err(exc("KeyError", str_repr(name)))
}

fn ref_(a: mut ref A, tok: ref String, tables: ref Vec[Named]) -> Result[Val, Exc] {
    let p = split_on(tok, '.');
    if p.len() != 2 {
        let n = p.len();
        let msg = if n < 2 { f"not enough values to unpack (expected 2, got {n})" } else { "too many values to unpack (expected 2)".to_string() };
        return Err(exc("ValueError", msg));
    }
    let t = lookup(tables, p[0])?;
    mcall(mut a, t, "field", vec![sv(p[1])])
}

fn rterm(a: mut ref A, tok: ref String, tables: ref Vec[Named]) -> Result[Val, Exc] {
    if tok.ends_with(")") {
        let ni = split_once(tok.substring(0, tok.len() - 1), "(");
        let name = ni[0].clone();
        let inner = ni[1].clone();
        if name == "distinct" {
            let r = ref_(mut a, inner, tables)?;
            let c = fcall(mut a, "Count", vec![r])?;
            return mcall(mut a, c, "distinct", Vec.new());
        }
        let f = report_fn(name)?;
        if inner == "*" {
            return module_fn_call(mut a, "fn".to_string(), f, vec![s_("*")], Vec.new());
        }
        let x = rterm(mut a, inner, tables)?;
        return module_fn_call(mut a, "fn".to_string(), f, vec![x], Vec.new());
    }
    if tok.contains(".") {
        return ref_(mut a, tok, tables);
    }
    Ok(value_of(tok))
}

fn condition(a: mut ref A, text: ref String, tables: ref Vec[Named]) -> Result[Val, Exc] {
    let mut alts: Vec[Val] = Vec.new();
    for part in split_str(text, " or ") {
        let ws = split_on(part, ' ');
        let w1 = if ws.len() >= 2 { ws[1].clone() } else { String.new() };
        let c = if w1 == "in" {
            let t = rterm(mut a, ws[0], tables)?;
            let mut vs: Vec[Val] = Vec.new();
            for v in split_on(ws[2], '|') {
                vs.push(value_of(v));
            }
            let l = lst(mut a, vs);
            mcall(mut a, t, "isin", vec![l])?
        } else if w1 == "between" {
            let t = rterm(mut a, ws[0], tables)?;
            let s = Val.Slc(new_list(mut a, vec![value_of(ws[2]), value_of(ws[3])]));
            subscript(mut a, t, s)?
        } else if w1 == "like" {
            let t = rterm(mut a, ws[0], tables)?;
            mcall(mut a, t, "like", vec![sv(ws[2])])?
        } else if w1 == "isnull" or w1 == "notnull" {
            let t = rterm(mut a, ws[0], tables)?;
            mcall(mut a, t, if w1 == "isnull" { "isnull" } else { "notnull" }, Vec.new())?
        } else {
            let mut found = Val.Absent;
            for op in ["!=", ">=", "<=", "=", ">", "<"] {
                if part.contains(op) {
                    let lr = split_once(part, op);
                    let l = rterm(mut a, lr[0], tables)?;
                    let r = rterm(mut a, lr[1], tables)?;
                    found = binop(mut a, if op == "=" { "==" } else { op.clone() }, l, r)?;
                    break;
                }
            }
            if is_absent(found) {
                return Err(exc("UnboundLocalError", "cannot access local variable 'c' where it is not associated with a value".to_string()));
            }
            found
        };
        alts.push(c);
    }
    let mut out = alts[0].clone();
    let mut i = 1;
    while i < alts.len() {
        out = binop(mut a, "|", out, alts[i])?;
        i += 1;
    }
    Ok(out)
}

fn build_report(a: mut ref A, cls: Str, r: ref Vec[String]) -> Result[Val, Exc] {
    let mut tables: Vec[Named] = Vec.new();
    let ta = split_on(r[1], ':');
    let t0 = table_of(mut a, ta[0]);
    let t = mcall(mut a, t0, "as_", vec![sv(ta[1])])?;
    put(mut tables, ta[1], t);
    let mut q = qcall(mut a, cls, "from_", vec![t])?;
    if r[2] != "-" {
        for spec in split_on(r[2], ';') {
            let p = split_on(spec, ' ');
            let how = p[0].clone();
            let mut rest = p[3].clone();
            let mut k = 4;
            while k < p.len() {
                rest = rest + " " + p[k];
                k += 1;
            }
            let jt0 = table_of(mut a, p[1]);
            let jt = mcall(mut a, jt0, "as_", vec![sv(p[2])])?;
            put(mut tables, p[2], jt);
            let member = if how == "inner" {
                "inner"
            } else if how == "left" {
                "left"
            } else if how == "right" {
                "right"
            } else if how == "full" {
                "full_outer"
            } else {
                return Err(exc("KeyError", str_repr(how)));
            };
            let j = mcall(mut a, q, "join", vec![jt, en("JoinType", member)])?;
            if rest.starts_with("using ") {
                let fs = split_on(rest.substring(6, rest.len()), ',');
                q = mcall(mut a, j, "using", strs(fs))?;
            } else {
                let lr = split_on(rest, '=');
                let l = ref_(mut a, lr[0], tables)?;
                let rr = ref_(mut a, lr[1], tables)?;
                let on = binop(mut a, "==", l, rr)?;
                q = mcall(mut a, j, "on", vec![on])?;
            }
        }
    }
    let mut selected: Vec[Named] = Vec.new();
    let mut terms: Vec[Val] = Vec.new();
    for item in split_on(r[3], ',') {
        if item.contains(":") {
            let ea = split_on(item, ':');
            let x = rterm(mut a, ea[0], tables)?;
            let tv = mcall(mut a, x, "as_", vec![sv(ea[1])])?;
            put(mut selected, ea[1], tv);
            terms.push(tv);
        } else {
            terms.push(rterm(mut a, item, tables)?);
        }
    }
    q = mcall(mut a, q, "select", terms)?;
    if r[4] != "-" {
        for c in split_on(r[4], ';') {
            let cv = condition(mut a, c, tables)?;
            q = mcall(mut a, q, "where", vec![cv])?;
        }
    }
    if r[5] != "-" {
        let mut gs: Vec[Val] = Vec.new();
        for g in split_on(r[5], ',') {
            gs.push(rterm(mut a, g, tables)?);
        }
        q = mcall(mut a, q, "groupby", gs)?;
    }
    if r[6] != "-" {
        for c in split_on(r[6], ';') {
            let cv = condition(mut a, c, tables)?;
            q = mcall(mut a, q, "having", vec![cv])?;
        }
    }
    if r[7] != "-" {
        for item in split_on(r[7], ',') {
            let kd = split_on(item, ' ');
            let tv = if has_key(selected, kd[0]) { lookup(selected, kd[0])? } else { rterm(mut a, kd[0], tables)? };
            let ord = en("Order", if kd[1] == "desc" { "desc" } else { "asc" });
            q = mcall_kw(mut a, q, "orderby", vec![tv], vec![Karg { k: "order".to_string(), v: ord }])?;
        }
    }
    if r[8] != "-" {
        q = mcall(mut a, q, "limit", vec![Val.Int(atoi(r[8]))])?;
    }
    if r[9] != "-" {
        q = mcall(mut a, q, "offset", vec![Val.Int(atoi(r[9]))])?;
    }
    Ok(q)
}

fn report(a: mut ref A, rel: ref String) -> Result[(), Exc] {
    let rows = tsv(rel)?;
    for (dname, cls) in [("ansi", "Query"), ("mysql", "MySQLQuery"), ("postgres", "PostgreSQLQuery"),
        ("mssql", "MSSQLQuery"), ("oracle", "OracleQuery")] {
        let mut out: Vec[String] = Vec.new();
        for r in rows {
            out.push(f"-- {r[0]}");
            match build_report(mut a, cls, r) {
                Ok(q) => match pystr(mut a, q) {
                    Ok(s) => out.push(s + ";"),
                    Err(e) => out.push(f"-- error {e.cls}: {e.msg}"),
                },
                Err(e) => out.push(f"-- error {e.cls}: {e.msg}"),
            }
        }
        write_back(f"out/reports/{dname}.sql", join_strs(out, "\n") + "\n")?;
    }
    Ok(())
}

// ------------------------------------------------------------ load

fn load(a: mut ref A, rel: ref String, tname: ref String, key: ref String, batch: i64) -> Result[(), Exc] {
    let mut lines: Vec[String] = Vec.new();
    for ln in split_on(read_text(rel)?, '\n') {
        if ln.len() > 0 {
            lines.push(ln.clone());
        }
    }
    let header = split_on(lines[0], ',');
    let mut rows: Vec[Vec[Val]] = Vec.new();
    let mut i = 1;
    while i < lines.len() {
        let mut r: Vec[Val] = Vec.new();
        for v in split_on(lines[i], ',') {
            r.push(value_of(v));
        }
        rows.push(r);
        i += 1;
    }
    let t = table_of(mut a, tname);
    let mut others: Vec[String] = Vec.new();
    for c in header {
        if *c != *key {
            others.push(c.clone());
        }
    }
    for dname in ["postgres", "mysql", "sqlite"] {
        let mut out: Vec[String] = Vec.new();
        let mut k = 0;
        while k < rows.len() {
            let mut chunk: Vec[Val] = Vec.new();
            let mut j = k;
            while j < k + batch and j < rows.len() {
                chunk.push(tup(mut a, rows[j].clone()));
                j += 1;
            }
            let mut q = Val.Non;
            if dname == "postgres" {
                let q0 = qcall(mut a, "PostgreSQLQuery", "into", vec![t.clone()])?;
                let q1 = mcall(mut a, q0, "columns", strs(header))?;
                let q2 = mcall(mut a, q1, "insert", chunk)?;
                q = mcall(mut a, q2, "on_conflict", vec![sv(key)])?;
                for c in others {
                    q = mcall(mut a, q, "do_update", vec![sv(c)])?;
                }
                q = mcall(mut a, q, "returning", vec![sv(key)])?;
            } else if dname == "mysql" {
                let q0 = qcall(mut a, "MySQLQuery", "into", vec![t.clone()])?;
                let q1 = mcall(mut a, q0, "columns", strs(header))?;
                q = mcall(mut a, q1, "insert", chunk)?;
                for c in others {
                    let f = mcall(mut a, t, "field", vec![sv(c)])?;
                    let f2 = mcall(mut a, t, "field", vec![sv(c)])?;
                    let vo = new_term(mut a, C_VALUES, Val.Non);
                    set(mut a, vo, F_FIELD, f2);
                    q = mcall(mut a, q, "on_duplicate_key_update", vec![f, Val.Obj(vo)])?;
                }
            } else {
                let q0 = qcall(mut a, "SQLLiteQuery", "into", vec![t.clone()])?;
                let q1 = mcall(mut a, q0, "columns", strs(header))?;
                q = mcall(mut a, q1, "insert_or_replace", chunk)?;
            }
            out.push(pystr(mut a, q)? + ";");
            k += batch;
        }
        write_back(f"out/load/{tname}.{dname}.sql", join_strs(out, "\n") + "\n")?;
    }
    Ok(())
}

// ------------------------------------------------------------ jobs

fn run_job(a: mut ref A, e: mut ref Env, kind: ref String, src: ref String) -> Result[(), Exc] {
    if kind == "let" {
        let ls = split_once(src, " = ");
        let v = eval_src(mut a, e, ls[1])?;
        let mut names: Vec[String] = Vec.new();
        for n in split_on(ls[0], ',') {
            names.push(n.trim().to_string());
        }
        if names.len() == 1 {
            env_set(mut e, names[0], v);
        } else {
            let vals = items(a, v);
            let mut i = 0;
            while i < names.len() and i < vals.len() {
                env_set(mut e, names[i], vals[i]);
                i += 1;
            }
        }
    } else if kind == "show" {
        let v = eval_src(mut a, e, src)?;
        let s = pystr(mut a, v)?;
        println(s);
    } else if kind == "program" {
        let args = split_on(src, ' ');
        if args[0] == "migrate" {
            migrate(mut a, args[1])?;
        } else if args[0] == "report" {
            report(mut a, args[1])?;
        } else if args[0] == "load" {
            load(mut a, args[1], args[2], args[3], atoi(args[4]))?;
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_inputs() {
        eprintln(e);
        return;
    }
    let mut a = arena_new();
    let mut e = env_new(mut a);
    for hex in split_on(jobs_text(), '\n') {
        if hex.len() == 0 {
            continue;
        }
        let ln = hex_string(hex);
        let ks = split_once(ln, "\t");
        let kind = ks[0].clone();
        let src = ks[1].clone();
        if kind == "#" {
            println("");
            println(f"# {src}");
            continue;
        }
        if kind == "reset" {
            a = arena_new();
            e = env_new(mut a);
            continue;
        }
        println(f"> {src}");
        if let Err(x) = run_job(mut a, mut e, kind, src) {
            let c = x.cls.clone();
            let m = x.msg.clone();
            println(f"error {c}: {m}");
        }
    }
}

// Generated by gen_kara.py from data/jobs.tsv.

fn jobs_text() -> String {
