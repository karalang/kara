// mini_pypika: a port of PyPika 0.48.9 (Apache-2.0; Timothy Heys and
// KAYAK), the SQL query builder that services, ETL jobs and report tools
// use to build SELECT, INSERT, UPDATE, DELETE and DDL statements from
// Python objects instead of string pasting, in ten SQL dialects. It
// replays data/jobs.tsv (see mk.py): the README's examples, then each part
// of the library alone (values and quoting, arithmetic, criteria,
// aggregates, functions, window functions, CASE and intervals, select
// lists, grouping, joins, subqueries and set operations, writes, the
// dialects, DDL and the builder's copy rules), and three programs: a
// schema migrator, a report compiler and a bulk loader, which write SQL
// files under data/out/.
//
// A job is a Python expression over the library's API, so the port
// carries a small Python evaluator. The library's objects are mutable
// Python objects that are copied shallowly by its @builder decorator, so
// a copy shares its lists with the original and some calls change objects
// other queries hold; the port keeps an arena of objects and lists and
// copies them the way Python does. Keyword arguments are passed on with
// **kwargs and consumed by name along the way, which decides which quote
// character each piece of a statement sees, so they are modelled as an
// ordered dictionary.

// ------------------------------------------------------------ text helpers

fn hex_val(c: char) -> i64 {
    if c >= '0' and c <= '9' {
        c as i64 - 48
    } else if c >= 'a' and c <= 'f' {
        c as i64 - 87
    } else if c >= 'A' and c <= 'F' {
        c as i64 - 55
    } else {
        -1
    }
}

fn hex_bytes(s: ref String) -> Vec[u8] {
    let cs: Vec[char] = s.chars().collect();
    let mut bytes: Vec[u8] = Vec.new();
    let mut k = 0;
    while k + 1 < cs.len() {
        bytes.push((hex_val(cs[k]) * 16 + hex_val(cs[k + 1])) as u8);
        k += 2;
    }
    bytes
}

fn hex_string(s: ref String) -> String {
    match String.from_utf8(hex_bytes(s)) {
        Ok(t) => t,
        Err(_) => String.new(),
    }
}

fn split_on(s: ref String, sep: char) -> Vec[String] {
    let mut pieces: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            pieces.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    pieces.push(cur);
    pieces
}

// str.split(sep) for a separator of any length.
fn split_str(s: ref String, sep: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut rest = s.clone();
    loop {
        match rest.find(sep) {
            Some(i) => {
                out.push(rest.substring(0, i));
                rest = rest.substring(i + sep.len(), rest.len());
            }
            None => {
                out.push(rest);
                return out;
            }
        }
    }
}

// str.split(sep, 1)
fn split_once(s: ref String, sep: Str) -> Vec[String] {
    match s.find(sep) {
        Some(i) => vec![s.substring(0, i), s.substring(i + sep.len(), s.len())],
        None => vec![s.clone()],
    }
}

fn join_strs(xs: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    let mut first = true;
    for x in xs {
        if not first {
            out.push_str(sep);
        }
        out.push_str(x);
        first = false;
    }
    out
}

fn all_digits(s: ref String) -> bool {
    if s.len() == 0 {
        return false;
    }
    for c in s.chars() {
        if c < '0' or c > '9' {
            return false;
        }
    }
    true
}

fn atoi(s: ref String) -> i64 {
    match i64.parse(s.clone()) {
        Ok(n) => n,
        Err(_) => 0,
    }
}

fn pad2(n: i64) -> String {
    if n < 10 { f"0{n}" } else { f"{n}" }
}

// repr() of a str.
fn str_repr(s: ref String) -> String {
    let q = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\t' {
            out.push_str("\\t");
        } else {
            out.push(c);
        }
    }
    out.push(q);
    out
}

// ------------------------------------------------------------ errors

// A Python exception: its class and message.
#[derive(Clone)]
struct Exc {
    cls: String,
    msg: String,
}

fn exc(cls: Str, msg: own String) -> Exc {
    Exc { cls: cls.to_string(), msg: msg }
}

fn attr_error(msg: own String) -> Exc {
    exc("AttributeError", msg)
}

fn query_error(msg: Str) -> Exc {
    exc("QueryException", msg.to_string())
}

fn type_error(msg: own String) -> Exc {
    exc("TypeError", msg)
}

// ------------------------------------------------------------ values

// A Python value. Lists, tuples and slices live in the arena's list store
// (a tuple is never changed, a list may be), objects in its object store.
// Absent is a keyword nobody passed or an attribute an object lacks. An
// enum member is its class and member name; a Name is one of the
// library's classes, functions or modules, or a classmethod of one
// ("Query.from_"); a Meth is a method bound to an object.
#[derive(Clone)]
enum Val {
    Absent,
    Non,
    Bool(bool),
    Int(i64),
    Float(f64),
    Str(String),
    Lst(i64),
    Tup(i64),
    Slc(i64),
    Obj(i64),
    Date(i64),
    En(String, String),
    Name(String),
    Meth(i64, String),
}

fn s_(s: Str) -> Val {
    Val.Str(s.to_string())
}

fn sv(s: ref String) -> Val {
    Val.Str(s.clone())
}

fn is_absent(v: ref Val) -> bool {
    match v {
        Val.Absent => true,
        _ => false,
    }
}

fn is_none(v: ref Val) -> bool {
    match v {
        Val.Non => true,
        _ => false,
    }
}

// `v is None` where an absent keyword counts as its default None.
fn is_nothing(v: ref Val) -> bool {
    match v {
        Val.Absent => true,
        Val.Non => true,
        _ => false,
    }
}

fn is_str(v: ref Val) -> bool {
    match v {
        Val.Str(_) => true,
        _ => false,
    }
}

fn str_of(v: ref Val) -> String {
    match v {
        Val.Str(s) => s.clone(),
        _ => String.new(),
    }
}

fn obj_id(v: ref Val) -> i64 {
    match v {
        Val.Obj(i) => i,
        _ => -1,
    }
}

fn is_int(v: ref Val) -> bool {
    match v {
        Val.Int(_) => true,
        _ => false,
    }
}

fn is_bool(v: ref Val) -> bool {
    match v {
        Val.Bool(_) => true,
        _ => false,
    }
}

fn is_list_or_tuple(v: ref Val) -> bool {
    match v {
        Val.Lst(_) => true,
        Val.Tup(_) => true,
        _ => false,
    }
}

fn is_tuple_val(v: ref Val) -> bool {
    match v {
        Val.Tup(_) => true,
        _ => false,
    }
}

fn seq_id(v: ref Val) -> i64 {
    match v {
        Val.Lst(i) => i,
        Val.Tup(i) => i,
        Val.Slc(i) => i,
        _ => -1,
    }
}

// ------------------------------------------------------------ the arena

// One Python object: its class and its attributes (keys F_*), in the
// order they were set.
#[derive(Clone)]
struct Obj {
    cls: i64,
    ks: Vec[i64],
    vs: Vec[Val],
}

struct A {
    objs: Vec[Obj],
    lists: Vec[Vec[Val]],
}

fn arena_new() -> A {
    A { objs: Vec.new(), lists: Vec.new() }
}

fn new_obj(a: mut ref A, cls: i64) -> i64 {
    a.objs.push(Obj { cls: cls, ks: Vec.new(), vs: Vec.new() });
    a.objs.len() - 1
}

fn cls_of(a: ref A, v: ref Val) -> i64 {
    match v {
        Val.Obj(i) => a.objs[i].cls,
        _ => -1,
    }
}

fn get(a: ref A, o: i64, k: i64) -> Val {
    let n = a.objs[o].ks.len();
    let mut i = 0;
    while i < n {
        if a.objs[o].ks[i] == k {
            return a.objs[o].vs[i].clone();
        }
        i += 1;
    }
    Val.Absent
}

fn set(a: mut ref A, o: i64, k: i64, v: own Val) {
    let mut i = 0;
    while i < a.objs[o].ks.len() {
        if a.objs[o].ks[i] == k {
            a.objs[o].vs[i] = v;
            return;
        }
        i += 1;
    }
    a.objs[o].ks.push(k);
    a.objs[o].vs.push(v);
}

fn geti(a: ref A, o: i64, k: i64) -> i64 {
    match get(a, o, k) {
        Val.Int(n) => n,
        _ => 0,
    }
}

fn getb(a: ref A, o: i64, k: i64) -> bool {
    py_truthy(get(a, o, k))
}

fn gets(a: ref A, o: i64, k: i64) -> String {
    str_of(get(a, o, k))
}

// copy.copy(): a new object with the same attribute values, so lists and
// objects are shared.
fn copy_obj(a: mut ref A, o: i64) -> i64 {
    let ob = a.objs[o].clone();
    a.objs.push(ob);
    a.objs.len() - 1
}

fn new_list(a: mut ref A, xs: own Vec[Val]) -> i64 {
    a.lists.push(xs);
    a.lists.len() - 1
}

fn lst(a: mut ref A, xs: own Vec[Val]) -> Val {
    Val.Lst(new_list(mut a, xs))
}

fn tup(a: mut ref A, xs: own Vec[Val]) -> Val {
    Val.Tup(new_list(mut a, xs))
}

fn items(a: ref A, v: ref Val) -> Vec[Val] {
    let i = seq_id(v);
    if i < 0 {
        return Vec.new();
    }
    a.lists[i].clone()
}

// The list an attribute holds.
fn lget(a: ref A, o: i64, k: i64) -> Vec[Val] {
    items(a, get(a, o, k))
}

fn lpush(a: mut ref A, o: i64, k: i64, v: own Val) {
    let i = seq_id(get(a, o, k));
    a.lists[i].push(v);
}

fn llen(a: ref A, o: i64, k: i64) -> i64 {
    let i = seq_id(get(a, o, k));
    if i < 0 {
        return 0;
    }
    a.lists[i].len()
}

// copy(list) into the attribute: a new list with the same items.
fn lcopy(a: mut ref A, o: i64, k: i64) {
    let xs = lget(a, o, k);
    let v = lst(mut a, xs);
    set(mut a, o, k, v);
}

fn set_list(a: mut ref A, o: i64, k: i64, xs: own Vec[Val]) {
    let v = lst(mut a, xs);
    set(mut a, o, k, v);
}

fn identical(x: ref Val, y: ref Val) -> bool {
    match x {
        Val.Obj(i) => match y {
            Val.Obj(j) => i == j,
            _ => false,
        },
        Val.Non => is_none(y),
        _ => false,
    }
}

fn py_truthy(v: ref Val) -> bool {
    match v {
        Val.Absent => false,
        Val.Non => false,
        Val.Bool(b) => b,
        Val.Int(n) => n != 0,
        Val.Float(x) => x != 0.0,
        Val.Str(s) => s.len() > 0,
        _ => true,
    }
}

// ------------------------------------------------------------ keyword arguments

// The keyword arguments get_sql() passes on, as an ordered dictionary.
const W_QC: i64 = 0;
const W_SQC: i64 = 1;
const W_AQC: i64 = 2;
const W_ASK: i64 = 3;
const W_DIA: i64 = 4;
const W_WA: i64 = 5;
const W_WN: i64 = 6;
const W_SUB: i64 = 7;
const W_SUBC: i64 = 8;
const W_GBA: i64 = 9;
const W_OBA: i64 = 10;

fn kw_name(k: i64) -> String {
    let names = vec!["quote_char", "secondary_quote_char", "alias_quote_char", "as_keyword", "dialect",
        "with_alias", "with_namespace", "subquery", "subcriterion", "groupby_alias", "orderby_alias"];
    names[k].to_string()
}

fn kw_key(name: ref String) -> i64 {
    let mut k = 0;
    while k <= W_OBA {
        if kw_name(k) == *name {
            return k;
        }
        k += 1;
    }
    -1
}

#[derive(Clone)]
struct Kw {
    ks: Vec[i64],
    vs: Vec[Val],
}

fn kw0() -> Kw {
    Kw { ks: Vec.new(), vs: Vec.new() }
}

fn kw_get(kw: ref Kw, k: i64) -> Val {
    let mut i = 0;
    while i < kw.ks.len() {
        if kw.ks[i] == k {
            return kw.vs[i].clone();
        }
        i += 1;
    }
    Val.Absent
}

fn kw_has(kw: ref Kw, k: i64) -> bool {
    not is_absent(kw_get(kw, k))
}

// kwargs.get(k, default)
fn kw_or(kw: ref Kw, k: i64, d: own Val) -> Val {
    let v = kw_get(kw, k);
    if is_absent(v) { d } else { v }
}

// kwargs[k] = v: in place, or at the end.
fn kw_set(kw: ref Kw, k: i64, v: own Val) -> Kw {
    let mut out = kw.clone();
    let mut i = 0;
    while i < out.ks.len() {
        if out.ks[i] == k {
            out.vs[i] = v;
            return out;
        }
        i += 1;
    }
    out.ks.push(k);
    out.vs.push(v);
    out
}

fn kw_setdefault(kw: ref Kw, k: i64, v: own Val) -> Kw {
    if kw_has(kw, k) {
        return kw.clone();
    }
    kw_set(kw, k, v)
}

// The dictionary without k: what **kwargs holds once a parameter named k
// has taken its value.
fn kw_del(kw: ref Kw, k: i64) -> Kw {
    let mut out = kw0();
    let mut i = 0;
    while i < kw.ks.len() {
        if kw.ks[i] != k {
            out.ks.push(kw.ks[i]);
            out.vs.push(kw.vs[i].clone());
        }
        i += 1;
    }
    out
}

// f(k=v, **kw): the explicit keyword first.
fn kw_with(kw: ref Kw, k: i64, v: own Val) -> Kw {
    let rest = kw_del(kw, k);
    let mut out = kw0();
    out.ks.push(k);
    out.vs.push(v);
    let mut i = 0;
    while i < rest.ks.len() {
        out.ks.push(rest.ks[i]);
        out.vs.push(rest.vs[i].clone());
        i += 1;
    }
    out
}

fn kw_with2(kw: ref Kw, k1: i64, v1: own Val, k2: i64, v2: own Val) -> Kw {
    let inner = kw_with(kw, k2, v2);
    kw_with(inner, k1, v1)
}

fn kw1(k: i64, v: own Val) -> Kw {
    kw_set(kw0(), k, v)
}

fn kw2(k1: i64, v1: own Val, k2: i64, v2: own Val) -> Kw {
    let k = kw_set(kw0(), k1, v1);
    kw_set(k, k2, v2)
}

// The keyword that get_sql(self) without **kwargs would reject.
fn kw_first(kw: ref Kw) -> String {
    if kw.ks.len() == 0 {
        return String.new();
    }
    kw_name(kw.ks[0])
}

fn kw_true(kw: ref Kw, k: i64) -> bool {
    py_truthy(kw_get(kw, k))
}

