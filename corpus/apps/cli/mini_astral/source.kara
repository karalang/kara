// mini_astral — astral 3.2 (Simon Kennedy), the Python library for the times
// of the sun and moon: dawn, sunrise, solar noon and midnight, sunset, dusk,
// daylight, night, twilight, the golden and blue hours, rahukaalam, the time
// the sun reaches a given elevation, its zenith, azimuth and elevation at an
// instant, moonrise and moonset, the moon's position, azimuth, elevation and
// phase, the Julian day and sidereal time helpers, degrees/minutes/seconds
// parsing, and the built-in geocoder database with its lookups.
//
// Every float is computed in the order the Python computes it, with its float
// `%` (fmod moved onto the divisor's sign) and int() truncation. Its
// datetime arithmetic is ported for fixed UTC offsets: wall-clock fields plus
// an offset, with timedelta and date arithmetic in exact microseconds, and
// the constructors' range checks and messages. math.acos/asin/sqrt raise
// "math domain error" outside their domains, which is what the sun functions
// catch to say the sun never reaches an angle. Exceptions are Result errors
// carrying "Type: repr(message)", the way oracle.py prints them.
// table4(), location_info() and jobs_text() at the end are written by
// gen_kara.py from vendor/astral and data/jobs.tsv.

const PI: f64 = 3.141592653589793;
const DEG_TO_RAD: f64 = 0.017453292519943295;
const RAD_TO_DEG: f64 = 57.29577951308232;
const SUN_APPARENT_RADIUS: f64 = 0.26666666666666666;
const MOON_APPARENT_RADIUS: f64 = 0.5266666666666666;
const MAX_ORDINAL: i64 = 3652059;
const NAN_F: f64 = f64.NAN;

// ---------------------------------------------------------- Python numbers

fn is_nan(x: f64) -> bool {
    x != x
}

fn nan3() -> (f64, f64, f64) {
    (NAN_F, NAN_F, NAN_F)
}

fn copysign0(b: f64) -> f64 {
    let z = 0.0;
    z.copysign(b)
}

// Python's float %: fmod, then moved onto the divisor's sign. Every divisor
// here is a nonzero constant.
fn pmod(a: f64, b: f64) -> f64 {
    let m = a % b;
    if m != 0.0 {
        if (b < 0.0) != (m < 0.0) {
            return m + b;
        }
        return m;
    }
    copysign0(b)
}
// int // and % (floor division)
fn idiv(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) {
        q - 1
    } else {
        q
    }
}

fn imod(a: i64, b: i64) -> i64 {
    a - b * idiv(a, b)
}

fn to_f64(s: String) -> f64 {
    match f64.parse(s.clone()) {
        Ok(v) => v,
        Err(_) => NAN_F,
    }
}

fn to_i64(s: ref String) -> i64 {
    match i64.parse(s.clone()) {
        Ok(v) => v,
        Err(_) => 0,
    }
}

// repr() of a float
fn fmt(x: f64) -> String {
    if is_nan(x) {
        return "nan".to_string();
    }
    f"{x}"
}
fn lpad(s: String, w: i64) -> String {
    let mut t = s.clone();
    while t.len() < w {
        t = f" {t}";
    }
    t
}

fn rpad(s: String, w: i64) -> String {
    let mut t = s.clone();
    while t.len() < w {
        t.push_str(" ");
    }
    t
}

// ---------------------------------------------------------- Python strings

fn is_py_space(c: char) -> bool {
    let o = c as i64;
    (o >= 9 and o <= 13) or (o >= 0x1C and o <= 0x20) or o == 0x85 or o == 0xA0 or o == 0x1680
        or (o >= 0x2000 and o <= 0x200A) or o == 0x2028 or o == 0x2029 or o == 0x202F or o == 0x205F or o == 0x3000
}

fn slice_chars(cs: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut s = String.new();
    let mut i = if lo < 0 { 0 } else { lo };
    let top = if hi > cs.len() { cs.len() } else { hi };
    while i < top {
        s.push(cs[i]);
        i += 1;
    }
    s
}

// s[lo:hi]
fn sl(s: ref String, lo: i64, hi: i64) -> String {
    let cs: Vec[char] = s.chars().collect();
    slice_chars(cs, lo, hi)
}

// s[i] == c, with False past the end
fn at_is(cs: ref Vec[char], i: i64, c: char) -> bool {
    i < cs.len() and cs[i] == c
}

fn py_strip(s: ref String) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut a = 0;
    let mut b = cs.len();
    while a < b and is_py_space(cs[a]) {
        a += 1;
    }
    while b > a and is_py_space(cs[b - 1]) {
        b -= 1;
    }
    slice_chars(cs, a, b)
}

fn py_rstrip(s: ref String) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut b = cs.len();
    while b > 0 and is_py_space(cs[b - 1]) {
        b -= 1;
    }
    slice_chars(cs, 0, b)
}

fn hex_digits(v: i64, n: i64) -> String {
    let ds: Vec[char] = "0123456789abcdef".chars().collect();
    let mut s = String.new();
    let mut k = (n - 1) * 4;
    while k >= 0 {
        s.push(ds[(v >> k) & 15]);
        k -= 4;
    }
    s
}

// str.isprintable() for one character of the text this program sees
fn is_printable(c: char) -> bool {
    let o = c as i64;
    if o < 0x20 or (o >= 0x7F and o <= 0xA0) or o == 0xAD {
        return false;
    }
    if o == 0x1680 or (o >= 0x2000 and o <= 0x200F) or (o >= 0x2028 and o <= 0x202F) or (o >= 0x205F and o <= 0x2064) {
        return false;
    }
    not (o == 0x3000 or o == 0xFEFF or (o >= 0xD800 and o <= 0xDFFF) or (o >= 0xE000 and o <= 0xF8FF))
}

// repr() of a str
fn py_repr_str(s: ref String) -> String {
    let has_single = s.contains("'");
    let has_double = s.contains("\"");
    let q = if has_single and not has_double { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        let o = c as i64;
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if is_printable(c) {
            out.push(c);
        } else if o < 0x100 {
            out.push_str("\\x");
            out.push_str(hex_digits(o, 2));
        } else if o < 0x10000 {
            out.push_str("\\u");
            out.push_str(hex_digits(o, 4));
        } else {
            out.push_str("\\U");
            out.push_str(hex_digits(o, 8));
        }
    }
    out.push(q);
    out
}

fn val_err(msg: ref String) -> String {
    f"ValueError: {py_repr_str(msg)}"
}

fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn is_alpha(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')
}

// Digits with single underscores between them, from cs[i]; the index past
// them, or -1 when an underscore is misplaced. `out` gets the digits.
fn digit_run(cs: ref Vec[char], from: i64, out: mut ref String) -> i64 {
    let mut i = from;
    while i < cs.len() {
        if is_digit(cs[i]) {
            out.push(cs[i]);
        } else if cs[i] == '_' {
            if i == from or not is_digit(cs[i - 1]) or i + 1 >= cs.len() or not is_digit(cs[i + 1]) {
                return -1;
            }
        } else {
            return i;
        }
        i += 1;
    }
    i
}
fn lower_ascii(s: ref String) -> String {
    let lower: Vec[char] = "abcdefghijklmnopqrstuvwxyz".chars().collect();
    let mut out = String.new();
    for c in s.chars() {
        if c >= 'A' and c <= 'Z' {
            out.push(lower[(c as i64) - 65]);
        } else {
            out.push(c);
        }
    }
    out
}

// float(s)
fn py_float(s: ref String) -> Result[f64, String] {
    let bad = val_err(f"could not convert string to float: {py_repr_str(s)}");
    let t = py_strip(s);
    let cs: Vec[char] = t.chars().collect();
    let mut i = 0;
    let mut neg = false;
    if i < cs.len() and (cs[i] == '+' or cs[i] == '-') {
        neg = cs[i] == '-';
        i += 1;
    }
    let word = lower_ascii(slice_chars(cs, i, cs.len()));
    if word == "inf" or word == "infinity" {
        return Ok(if neg { -f64.INFINITY } else { f64.INFINITY });
    }
    if word == "nan" {
        return Ok(NAN_F);
    }
    let mut text = String.new();
    let mut ip = String.new();
    let mut e = digit_run(cs, i, mut ip);
    if e < 0 {
        return Err(bad);
    }
    let mut fp = String.new();
    if e < cs.len() and cs[e] == '.' {
        e = digit_run(cs, e + 1, mut fp);
        if e < 0 {
            return Err(bad);
        }
    }
    if ip.len() == 0 and fp.len() == 0 {
        return Err(bad);
    }
    text.push_str(if ip.len() == 0 { "0" } else { ip });
    text.push_str(".");
    text.push_str(if fp.len() == 0 { "0" } else { fp });
    if e < cs.len() and (cs[e] == 'e' or cs[e] == 'E') {
        let mut k = e + 1;
        let mut esign = "";
        if k < cs.len() and (cs[k] == '+' or cs[k] == '-') {
            esign = if cs[k] == '-' { "-" } else { "+" };
            k += 1;
        }
        let mut ed = String.new();
        let e2 = digit_run(cs, k, mut ed);
        if e2 < 0 or ed.len() == 0 {
            return Err(bad);
        }
        text.push_str(f"e{esign}{ed}");
        e = e2;
    }
    if e != cs.len() {
        return Err(bad);
    }
    let v = to_f64(text);
    Ok(if neg { -v } else { v })
}

fn py_trunc(x: f64) -> Result[i64, String] {
    if is_nan(x) {
        return Err(val_err("cannot convert float NaN to integer"));
    }
    if x == f64.INFINITY or x == -f64.INFINITY {
        return Err(f"OverflowError: {py_repr_str("cannot convert float infinity to integer")}");
    }
    Ok(x as i64)
}

fn tr(x: f64) -> i64 {
    x as i64
}

fn math_domain() -> String {
    val_err("math domain error")
}

fn radians(x: f64) -> f64 {
    x * DEG_TO_RAD
}

fn degrees(x: f64) -> f64 {
    x * RAD_TO_DEG
}

fn py_acos(x: f64) -> Result[f64, String] {
    if x > 1.0 or x < -1.0 {
        return Err(math_domain());
    }
    Ok(x.acos())
}

fn py_asin(x: f64) -> Result[f64, String] {
    if x > 1.0 or x < -1.0 {
        return Err(math_domain());
    }
    Ok(x.asin())
}

fn py_sqrt(x: f64) -> Result[f64, String] {
    if x < 0.0 {
        return Err(math_domain());
    }
    Ok(x.sqrt())
}

fn zero_div() -> String {
    f"ZeroDivisionError: {py_repr_str("float division by zero")}"
}

fn pad2(n: i64) -> String {
    if n < 10 { f"0{n}" } else { f"{n}" }
}

fn pad6(n: i64) -> String {
    let mut s = f"{n}";
    while s.len() < 6 {
        s = f"0{s}";
    }
    s
}

// ---------------------------------------------------------- dates and times

fn is_leap(y: i64) -> bool {
    imod(y, 4) == 0 and (imod(y, 100) != 0 or imod(y, 400) == 0)
}

fn days_in_month(y: i64, m: i64) -> i64 {
    if m == 2 {
        return if is_leap(y) { 29 } else { 28 };
    }
    if m == 4 or m == 6 or m == 9 or m == 11 { 30 } else { 31 }
}

fn days_before_month(y: i64, m: i64) -> i64 {
    let mut n = 0;
    let mut k = 1;
    while k < m {
        n += days_in_month(y, k);
        k += 1;
    }
    n
}

// date.toordinal()
fn ordinal(y: i64, m: i64, d: i64) -> i64 {
    let p = y - 1;
    p * 365 + p / 4 - p / 100 + p / 400 + days_before_month(y, m) + d
}

// date.fromordinal(), CPython's _ord2ymd
fn from_ordinal(n0: i64) -> (i64, i64, i64) {
    let mut n = n0 - 1;
    let n400 = n / 146097;
    n = n % 146097;
    let mut year = n400 * 400 + 1;
    let n100 = n / 36524;
    n = n % 36524;
    let n4 = n / 1461;
    n = n % 1461;
    let n1 = n / 365;
    n = n % 365;
    year += n100 * 100 + n4 * 4 + n1;
    if n1 == 4 or n100 == 4 {
        return (year - 1, 12, 31);
    }
    let mut month = 1;
    while n >= days_in_month(year, month) {
        n -= days_in_month(year, month);
        month += 1;
    }
    (year, month, n + 1)
}

#[derive(Copy, Clone)]
struct Date {
    y: i64,
    m: i64,
    d: i64,
}

fn date_ord(d: Date) -> i64 {
    ordinal(d.y, d.m, d.d)
}

fn date_add_days(d: Date, n: i64) -> Result[Date, String] {
    let o = date_ord(d) + n;
    if o < 1 or o > MAX_ORDINAL {
        return Err(f"OverflowError: {py_repr_str("date value out of range")}");
    }
    let (y, m, dd) = from_ordinal(o);
    Ok(Date { y: y, m: m, d: dd })
}

fn date_str(d: Date) -> String {
    let mut ys = f"{d.y}";
    while ys.len() < 4 {
        ys = f"0{ys}";
    }
    f"{ys}-{pad2(d.m)}-{pad2(d.d)}"
}

// A datetime: its wall-clock fields, and a fixed UTC offset in seconds when
// it is aware.
#[derive(Copy, Clone)]
struct Dt {
    y: i64,
    mo: i64,
    d: i64,
    h: i64,
    mi: i64,
    s: i64,
    us: i64,
    aware: bool,
    off: i64,
}

fn check_date(y: i64, mo: i64, d: i64) -> Result[(), String] {
    if y < 1 or y > 9999 {
        return Err(val_err(f"year {y} is out of range"));
    }
    if mo < 1 or mo > 12 {
        return Err(val_err("month must be in 1..12"));
    }
    if d < 1 or d > days_in_month(y, mo) {
        return Err(val_err("day is out of range for month"));
    }
    Ok(())
}

fn check_time(h: i64, mi: i64, s: i64, us: i64) -> Result[(), String] {
    if h < 0 or h > 23 {
        return Err(val_err("hour must be in 0..23"));
    }
    if mi < 0 or mi > 59 {
        return Err(val_err("minute must be in 0..59"));
    }
    if s < 0 or s > 59 {
        return Err(val_err("second must be in 0..59"));
    }
    if us < 0 or us > 999999 {
        return Err(val_err("microsecond must be in 0..999999"));
    }
    Ok(())
}

// datetime.datetime(y, mo, d, h, mi, s, us, tzinfo=...)
fn mk_dt(y: i64, mo: i64, d: i64, h: i64, mi: i64, s: i64, us: i64, aware: bool, off: i64) -> Result[Dt, String] {
    check_date(y, mo, d)?;
    check_time(h, mi, s, us)?;
    Ok(Dt { y: y, mo: mo, d: d, h: h, mi: mi, s: s, us: us, aware: aware, off: off })
}

fn utc_dt(d: Date, h: i64, mi: i64, s: i64) -> Result[Dt, String] {
    mk_dt(d.y, d.m, d.d, h, mi, s, 0, true, 0)
}

// The wall clock as microseconds since 0001-01-01 00:00 minus a day
fn wall_us(t: Dt) -> i64 {
    ((ordinal(t.y, t.mo, t.d) * 86400 + t.h * 3600 + t.mi * 60 + t.s) * 1000000) + t.us
}

fn dt_from_wall(us: i64, aware: bool, off: i64) -> Result[Dt, String] {
    let days = idiv(us, 86400000000);
    let rem = us - days * 86400000000;
    if days < 1 or days > MAX_ORDINAL {
        return Err(f"OverflowError: {py_repr_str("date value out of range")}");
    }
    let (y, m, d) = from_ordinal(days);
    let secs = rem / 1000000;
    Ok(Dt { y: y, mo: m, d: d, h: secs / 3600, mi: (secs / 60) % 60, s: secs % 60, us: rem % 1000000, aware: aware, off: off })
}

// dt + timedelta(microseconds=delta)
fn dt_add(t: Dt, delta: i64) -> Result[Dt, String] {
    dt_from_wall(wall_us(t) + delta, t.aware, t.off)
}

// dt.astimezone(timezone(timedelta(seconds=off))) for an aware dt
fn astimezone(t: Dt, off: i64) -> Result[Dt, String] {
    dt_from_wall(wall_us(t) - t.off * 1000000 + off * 1000000, true, off)
}

fn utc_us(t: Dt) -> i64 {
    wall_us(t) - t.off * 1000000
}

fn dt_date(t: Dt) -> Date {
    Date { y: t.y, m: t.mo, d: t.d }
}

fn time_str(h: i64, mi: i64, s: i64, us: i64) -> String {
    let base = f"{pad2(h)}:{pad2(mi)}:{pad2(s)}";
    if us != 0 { f"{base}.{pad6(us)}" } else { base }
}

fn offset_str(off: i64) -> String {
    let sign = if off < 0 { "-" } else { "+" };
    let a = if off < 0 { -off } else { off };
    let base = f"{sign}{pad2(a / 3600)}:{pad2((a / 60) % 60)}";
    if a % 60 != 0 { f"{base}:{pad2(a % 60)}" } else { base }
}

// str(datetime)
fn dt_str(t: Dt) -> String {
    let base = f"{date_str(dt_date(t))} {time_str(t.h, t.mi, t.s, t.us)}";
    if t.aware { f"{base}{offset_str(t.off)}" } else { base }
}

// str(timedelta(microseconds=us))
fn td_str(us: i64) -> String {
    let days = idiv(us, 86400000000);
    let rem = us - days * 86400000000;
    let secs = rem / 1000000;
    let frac = rem % 1000000;
    let mut s = String.new();
    if days != 0 {
        let a = if days < 0 { -days } else { days };
        let plural = if a != 1 { "s" } else { "" };
        s.push_str(f"{days} day{plural}, ");
    }
    s.push_str(f"{secs / 3600}:{pad2((secs / 60) % 60)}:{pad2(secs % 60)}");
    if frac != 0 {
        s.push_str(f".{pad6(frac)}");
    }
    s
}

// date.weekday()
fn weekday(d: Date) -> i64 {
    (date_ord(d) + 6) % 7
}

// ------------------------------------------------------------ astral/__init__

// The text of a Python number as f"{x}" prints it: a float, or the int a
// Depression or a literal int carries.
#[derive(Clone)]
struct Num {
    v: f64,
    text: String,
}

fn quote_char(c: char, primes: Str) -> bool {
    for p in primes.chars() {
        if c == p {
            return true;
        }
    }
    false
}

// The optional `(?P<x>\d{1,2})[<marks>]` group of the dms pattern, greedy
fn dms_part(cs: ref Vec[char], pos: i64, marks: Str) -> (String, i64) {
    if pos + 2 < cs.len() and is_digit(cs[pos]) and is_digit(cs[pos + 1]) and quote_char(cs[pos + 2], marks) {
        return (slice_chars(cs, pos, pos + 2), pos + 3);
    }
    if pos + 1 < cs.len() and is_digit(cs[pos]) and quote_char(cs[pos + 1], marks) {
        return (slice_chars(cs, pos, pos + 1), pos + 2);
    }
    ("".to_string(), pos)
}

fn dms_to_float(dms: ref String, has_limit: bool, limit: f64) -> Result[f64, String] {
    let mut res = 0.0;
    match py_float(dms) {
        Ok(v) => {
            res = v;
        }
        Err(_) => {
            // re.match(r"(?P<deg>\d{1,3})[°]((?P<min>\d{1,2})[′'])?((?P<sec>\d{1,2})[″\"])?(?P<dir>[NSEW])?", dms, re.I)
            let cs: Vec[char] = dms.chars().collect();
            let mut n = 0;
            while n < cs.len() and is_digit(cs[n]) {
                n += 1;
            }
            if n < 1 or n > 3 or n >= cs.len() or cs[n] != '°' {
                return Err(val_err("Unable to convert degrees/minutes/seconds to float"));
            }
            let deg = slice_chars(cs, 0, n);
            let (min_, p1) = dms_part(cs, n + 1, "′'");
            let (sec, p2) = dms_part(cs, p1, "″\"");
            let mut dir_ = 'E';
            if p2 < cs.len() and quote_char(cs[p2], "NSEWnsew") {
                dir_ = cs[p2];
            }
            res = to_f64(deg);
            if min_.len() > 0 {
                res += to_f64(min_) / 60.0;
            }
            if sec.len() > 0 {
                res += to_f64(sec) / 3600.0;
            }
            if dir_ == 'S' or dir_ == 's' or dir_ == 'W' or dir_ == 'w' {
                res = -res;
            }
        }
    }
    if has_limit {
        if res > limit {
            res = limit;
        } else if res < -limit {
            res = -limit;
        }
    }
    Ok(res)
}

fn hours_to_time(value0: f64) -> Result[String, String] {
    let mut value = value0;
    let hour = py_trunc(value)?;
    value -= hour as f64;
    value *= 60.0;
    let minute = tr(value);
    value -= minute as f64;
    value *= 60.0;
    let second = tr(value);
    value -= second as f64;
    let microsecond = tr(value * 1000000.0);
    check_time(hour, minute, second, microsecond)?;
    Ok(time_str(hour, minute, second, microsecond))
}

fn time_to_hours(h: i64, m: i64, s: i64, us: i64) -> f64 {
    let mut hours = 0.0;
    hours += h as f64;
    hours += (m as f64) / 60.0;
    hours += (s as f64) / 3600.0;
    hours += (us as f64) / 1000000.0;
    hours
}

// refraction_at_zenith; `.1` is true when it returns the int 0
fn refraction_at_zenith(zenith: f64) -> (f64, bool) {
    let elevation = 90.0 - zenith;
    if elevation >= 85.0 {
        return (0.0, true);
    }
    let mut refraction_correction = 0.0;
    let te = radians(elevation).tan();
    if elevation > 5.0 {
        refraction_correction = 58.1 / te - 0.07 / (te * te * te) + 0.000086 / (te * te * te * te * te);
    } else if elevation > -0.575 {
        let step1 = -12.79 + elevation * 0.711;
        let step2 = 103.4 + elevation * step1;
        let step3 = -518.2 + elevation * step2;
        refraction_correction = 1735.0 + elevation * step3;
    } else {
        refraction_correction = -20.774 / te;
    }
    refraction_correction = refraction_correction / 3600.0;
    (refraction_correction, false)
}

#[derive(Copy, Clone)]
struct Observer {
    latitude: f64,
    longitude: f64,
    tuple_elev: bool,
    e0: f64,
    e1: f64,
}

fn observer_repr(o: Observer) -> String {
    let el = if o.tuple_elev { f"({fmt(o.e0)}, {fmt(o.e1)})" } else { fmt(o.e0) };
    f"{fmt(o.latitude)} {fmt(o.longitude)} {el}"
}

// ------------------------------------------------------------ julian.py

fn julianday_at(y0: i64, m0: i64, day: i64, has_time: bool, secs: i64, gregorian: bool) -> f64 {
    let mut year = y0;
    let mut month = m0;
    let day_fraction = if has_time { (secs as f64) / 86400.0 } else { 0.0 };
    if month <= 2 {
        year -= 1;
        month += 12;
    }
    let a = tr((year as f64) / 100.0);
    let b = if gregorian { 2 - a + tr((a as f64) / 4.0) } else { 0 };
    let s1 = tr(365.25 * ((year + 4716) as f64)) + tr(30.6001 * ((month + 1) as f64)) + day;
    (s1 as f64 + day_fraction + b as f64) - 1524.5
}

fn julianday_date(d: Date) -> f64 {
    julianday_at(d.y, d.m, d.d, false, 0, true)
}

fn julianday_dt(t: Dt) -> f64 {
    julianday_at(t.y, t.mo, t.d, true, t.h * 3600 + t.mi * 60 + t.s, true)
}

fn julianday_modified(t: Dt) -> f64 {
    let mut year = t.y;
    let mut month = t.mo;
    let day = t.d;
    let a0 = 10000 * year + 100 * month + day;
    if year < 0 {
        year += 1;
    }
    if month <= 2 {
        month += 12;
        year -= 1;
    }
    let yf = year as f64;
    let b = if (a0 as f64) <= 15821004.1 {
        -2.0 + ((year + 4716) as f64) / 4.0 - 1179.0
    } else {
        (yf / 400.0) - (yf / 100.0) + (yf / 4.0)
    };
    let a = 365 * year - 679004;
    a as f64 + b + (tr(30.6001 * ((month + 1) as f64)) as f64) + (day as f64) + (t.h as f64) / 24.0
}

fn julianday_to_datetime(jd0: f64) -> Result[String, String] {
    let jd = jd0 + 0.5;
    let z = py_trunc(jd)?;
    let f = jd - z as f64;
    let mut a = z;
    if z >= 2299161 {
        let alpha = tr((z as f64 - 1867216.25) / 36524.25);
        a = z + 1 + alpha + tr((alpha as f64) / 4.0);
    }
    let b = a + 1524;
    let c = tr((b as f64 - 122.1) / 365.25);
    let d0 = tr(365.25 * (c as f64));
    let e = tr(((b - d0) as f64) / 30.6001);
    let d = ((b - d0 - tr(30.6001 * (e as f64))) as f64) + f;
    let day = tr(d);
    let t = d - day as f64;
    let mut total_seconds = t * 86400.0;
    let hour = tr(total_seconds / 3600.0);
    total_seconds -= (hour * 3600) as f64;
    let minute = tr(total_seconds / 60.0);
    total_seconds -= (minute * 60) as f64;
    let seconds = tr(total_seconds);
    let month = if e < 14 { e - 1 } else { e - 13 };
    let year = if month > 2 { c - 4716 } else { c - 4715 };
    let r = mk_dt(year, month, day, hour, minute, seconds, 0, false, 0)?;
    Ok(dt_str(r))
}

fn day_fraction_to_time(fraction: f64) -> Result[String, String] {
    let mut s = fraction * 86400.0;
    let h = tr(s / 3600.0);
    s -= (h * 3600) as f64;
    let m = tr(s / 60.0);
    s -= (m * 60) as f64;
    let si = tr(s);
    check_time(h, m, si, 0)?;
    Ok(time_str(h, m, si, 0))
}

fn julianday_to_juliancentury(jd: f64) -> f64 {
    (jd - 2451545.0) / 36525.0
}

fn juliancentury_to_julianday(jc: f64) -> f64 {
    (jc * 36525.0) + 2451545.0
}

// ------------------------------------------------------------ sidereal.py

fn gmst_of(jd2000: f64) -> f64 {
    let t0 = jd2000 / 36525.0;
    let value = 280.46061837 + 360.98564736629 * jd2000 + 0.000387933 * t0.pow(2.0) + t0.pow(3.0) / 38710000.0;
    pmod(value, 360.0)
}

fn lmst_of(jd2000: f64, longitude: f64) -> f64 {
    let mut mst = gmst_of(jd2000);
    mst += longitude;
    mst
}

// ------------------------------------------------------------ sun.py

fn minutes_to_timedelta(minutes0: f64) -> i64 {
    let mut minutes = minutes0;
    let d = tr(minutes / 1440.0);
    minutes = minutes - (d * 1440) as f64;
    minutes = minutes * 60.0;
    let s = tr(minutes);
    let sfrac = minutes - s as f64;
    let us = tr(sfrac * 1000000.0);
    d * 86400000000 + s * 1000000 + us
}

fn geom_mean_long_sun(jc: f64) -> f64 {
    let l0 = 280.46646 + jc * (36000.76983 + 0.0003032 * jc);
    pmod(l0, 360.0)
}

fn geom_mean_anomaly_sun(jc: f64) -> f64 {
    357.52911 + jc * (35999.05029 - 0.0001537 * jc)
}

fn eccentric_location_earth_orbit(jc: f64) -> f64 {
    0.016708634 - jc * (0.000042037 + 0.0000001267 * jc)
}

fn sun_eq_of_center(jc: f64) -> f64 {
    let m = geom_mean_anomaly_sun(jc);
    let mrad = radians(m);
    let sinm = mrad.sin();
    let sin2m = (mrad + mrad).sin();
    let sin3m = (mrad + mrad + mrad).sin();
    sinm * (1.914602 - jc * (0.004817 + 0.000014 * jc)) + sin2m * (0.019993 - 0.000101 * jc) + sin3m * 0.000289
}

fn sun_true_long(jc: f64) -> f64 {
    geom_mean_long_sun(jc) + sun_eq_of_center(jc)
}

fn sun_apparent_long(jc: f64) -> f64 {
    let true_long = sun_true_long(jc);
    let omega = 125.04 - 1934.136 * jc;
    true_long - 0.00569 - 0.00478 * radians(omega).sin()
}

fn mean_obliquity_of_ecliptic(jc: f64) -> f64 {
    let seconds = 21.448 - jc * (46.815 + jc * (0.00059 - jc * (0.001813)));
    23.0 + (26.0 + (seconds / 60.0)) / 60.0
}

fn obliquity_correction(jc: f64) -> f64 {
    let e0 = mean_obliquity_of_ecliptic(jc);
    let omega = 125.04 - 1934.136 * jc;
    e0 + 0.00256 * radians(omega).cos()
}

fn sun_declination(jc: f64) -> Result[f64, String] {
    let e = obliquity_correction(jc);
    let lambd = sun_apparent_long(jc);
    let sint = radians(e).sin() * radians(lambd).sin();
    Ok(degrees(py_asin(sint)?))
}

fn var_y(jc: f64) -> f64 {
    let epsilon = obliquity_correction(jc);
    let y = (radians(epsilon) / 2.0).tan();
    y * y
}

fn eq_of_time(jc: f64) -> f64 {
    let l0 = geom_mean_long_sun(jc);
    let e = eccentric_location_earth_orbit(jc);
    let m = geom_mean_anomaly_sun(jc);
    let y = var_y(jc);
    let sin2l0 = (2.0 * radians(l0)).sin();
    let sinm = radians(m).sin();
    let cos2l0 = (2.0 * radians(l0)).cos();
    let sin4l0 = (4.0 * radians(l0)).sin();
    let sin2m = (2.0 * radians(m)).sin();
    let etime = y * sin2l0 - 2.0 * e * sinm + 4.0 * e * y * sinm * cos2l0 - 0.5 * y * y * sin4l0 - 1.25 * e * e * sin2m;
    degrees(etime) * 4.0
}

// direction: 1 rising, -1 setting
fn hour_angle(latitude: f64, declination: f64, zenith: f64, direction: i64) -> Result[f64, String] {
    let latitude_rad = radians(latitude);
    let declination_rad = radians(declination);
    let zenith_rad = radians(zenith);
    let h = (zenith_rad.cos() - latitude_rad.sin() * declination_rad.sin()) / (latitude_rad.cos() * declination_rad.cos());
    let mut ha = py_acos(h)?;
    if direction == -1 {
        ha = -ha;
    }
    Ok(ha)
}

fn adjust_to_horizon(elevation: f64) -> f64 {
    if elevation <= 0.0 {
        return 0.0;
    }
    let r = 6356900.0;
    let h1 = r + elevation;
    degrees((r / h1).acos())
}

fn adjust_to_obscuring_feature(e0: f64, e1: f64) -> f64 {
    if e0 == 0.0 {
        return 0.0;
    }
    let sign = if e0 < 0.0 { -1.0 } else { 1.0 };
    sign * degrees((e0.abs() / (e0.pow(2.0) + e1.pow(2.0)).sqrt()).acos())
}

fn clip_lat(lat: f64) -> f64 {
    if lat > 89.8 {
        89.8
    } else if lat < -89.8 {
        -89.8
    } else {
        lat
    }
}

fn time_of_transit(o: Observer, date: Date, zenith: f64, direction: i64, with_refraction: bool) -> Result[Dt, String] {
    let latitude = clip_lat(o.latitude);
    let mut adjustment_for_elevation = 0.0;
    if not o.tuple_elev and o.e0 > 0.0 {
        adjustment_for_elevation = adjust_to_horizon(o.e0);
    } else if o.tuple_elev {
        adjustment_for_elevation = adjust_to_obscuring_feature(o.e0, o.e1);
    }
    let adjustment_for_refraction = if with_refraction {
        let (r, _) = refraction_at_zenith(zenith + adjustment_for_elevation);
        r
    } else {
        0.0
    };
    let jd = julianday_date(date);
    let mut adjustment = 0.0;
    let mut time_utc = 0.0;
    let mut i = 0;
    while i < 2 {
        let jc = julianday_to_juliancentury(jd + adjustment);
        let declination = sun_declination(jc)?;
        let hourangle = hour_angle(latitude, declination, zenith + adjustment_for_elevation + adjustment_for_refraction, direction)?;
        let delta = -o.longitude - degrees(hourangle);
        let eqtime = eq_of_time(jc);
        let mut offset = delta * 4.0 - eqtime;
        if offset < -720.0 {
            offset += 1440.0;
        }
        time_utc = 720.0 + offset;
        adjustment = time_utc / 1440.0;
        i += 1;
    }
    let td = minutes_to_timedelta(time_utc);
    let midnight = utc_dt(date, 0, 0, 0)?;
    dt_add(midnight, td)
}

fn is_domain(e: ref String) -> bool {
    e == math_domain()
}

fn time_at_elevation(o: Observer, elevation0: f64, date: Date, direction0: i64, off: i64, with_refraction: bool) -> Result[Dt, String] {
    let mut elevation = elevation0;
    let mut direction = direction0;
    if elevation > 90.0 {
        elevation = 180.0 - elevation;
        direction = -1;
    }
    let zenith = 90.0 - elevation;
    match time_of_transit(o, date, zenith, direction, with_refraction) {
        Ok(t) => astimezone(t, off),
        Err(e) => {
            if is_domain(e) {
                Err(val_err(f"Sun never reaches an elevation of {fmt(elevation)} degrees at this location."))
            } else {
                Err(e)
            }
        }
    }
}

// The hour, minute and second fix-ups noon() and midnight() share
fn hms_of(time_utc: f64) -> (i64, i64, i64) {
    let mut hour = tr(time_utc);
    let mut minute = tr((time_utc - hour as f64) * 60.0);
    let mut second = tr((((time_utc - hour as f64) * 60.0) - minute as f64) * 60.0);
    if second > 59 {
        second -= 60;
        minute += 1;
    } else if second < 0 {
        second += 60;
        minute -= 1;
    }
    if minute > 59 {
        minute -= 60;
        hour += 1;
    } else if minute < 0 {
        minute += 60;
        hour -= 1;
    }
    (hour, minute, second)
}

fn noon(o: Observer, date0: Date, off: i64) -> Result[Dt, String] {
    let mut date = date0;
    let jc = julianday_to_juliancentury(julianday_date(date));
    let eqtime = eq_of_time(jc);
    let time_utc = (720.0 - (4.0 * o.longitude) - eqtime) / 60.0;
    let (h0, minute, second) = hms_of(time_utc);
    let mut hour = h0;
    if hour > 23 {
        hour -= 24;
        date = date_add_days(date, 1)?;
    } else if hour < 0 {
        hour += 24;
        date = date_add_days(date, -1)?;
    }
    let t = utc_dt(date, hour, minute, second)?;
    astimezone(t, off)
}

fn midnight(o: Observer, date0: Date, off: i64) -> Result[Dt, String] {
    let mut date = date0;
    let jd = julianday_at(date.y, date.m, date.d, true, 43200, true);
    let newt = julianday_to_juliancentury(jd + 0.5 + -o.longitude / 360.0);
    let eqtime = eq_of_time(newt);
    let mut time_utc = (-o.longitude * 4.0) - eqtime;
    time_utc = time_utc / 60.0;
    let (h0, minute, second) = hms_of(time_utc);
    let mut hour = h0;
    if hour < 0 {
        hour += 24;
        date = date_add_days(date, -1)?;
    }
    let t = utc_dt(date, hour, minute, second)?;
    astimezone(t, off)
}

fn zenith_and_azimuth(o: Observer, t: Dt, with_refraction: bool) -> Result[(f64, f64), String] {
    let latitude = clip_lat(o.latitude);
    let longitude = o.longitude;
    let mut zone = 0.0;
    let mut utc = t;
    if t.aware {
        zone = -(t.off as f64) / 3600.0;
        utc = astimezone(t, 0)?;
    }
    let jd = julianday_dt(utc);
    let jc = julianday_to_juliancentury(jd);
    let declination = sun_declination(jc)?;
    let eqtime = eq_of_time(jc);
    let solar_time_fix = eqtime + (4.0 * longitude) + (60.0 * zone);
    let mut true_solar_time = (t.h as f64) * 60.0 + (t.mi as f64) + (t.s as f64) / 60.0 + solar_time_fix;
    while true_solar_time > 1440.0 {
        true_solar_time = true_solar_time - 1440.0;
    }
    let mut hourangle = true_solar_time / 4.0 - 180.0;
    if hourangle < -180.0 {
        hourangle = hourangle + 360.0;
    }
    let ch = radians(hourangle).cos();
    let cl = radians(latitude).cos();
    let sl = radians(latitude).sin();
    let sd = radians(declination).sin();
    let cd = radians(declination).cos();
    let mut csz = cl * cd * ch + sl * sd;
    if csz > 1.0 {
        csz = 1.0;
    } else if csz < -1.0 {
        csz = -1.0;
    }
    let mut zenith = degrees(csz.acos());
    let az_denom = cl * radians(zenith).sin();
    let mut azimuth = 0.0;
    if az_denom.abs() > 0.001 {
        let mut az_rad = ((sl * radians(zenith).cos()) - sd) / az_denom;
        if az_rad.abs() > 1.0 {
            if az_rad < 0.0 {
                az_rad = -1.0;
            } else {
                az_rad = 1.0;
            }
        }
        azimuth = 180.0 - degrees(az_rad.acos());
        if hourangle > 0.0 {
            azimuth = -azimuth;
        }
    } else {
        if latitude > 0.0 {
            azimuth = 180.0;
        } else {
            azimuth = 0.0;
        }
    }
    if azimuth < 0.0 {
        azimuth = azimuth + 360.0;
    }
    if with_refraction {
        let (r, _) = refraction_at_zenith(zenith);
        zenith -= r;
    }
    Ok((zenith, azimuth))
}

fn sun_zenith(o: Observer, t: Dt, with_refraction: bool) -> Result[f64, String] {
    let (z, _) = zenith_and_azimuth(o, t, with_refraction)?;
    Ok(z)
}

fn sun_azimuth(o: Observer, t: Dt) -> Result[f64, String] {
    let (_, a) = zenith_and_azimuth(o, t, true)?;
    Ok(a)
}

fn sun_elevation(o: Observer, t: Dt, with_refraction: bool) -> Result[f64, String] {
    Ok(90.0 - sun_zenith(o, t, with_refraction)?)
}

// The local date of `tot`, compared with the date asked for
fn date_cmp(a: Date, b: Date) -> i64 {
    let x = date_ord(a);
    let y = date_ord(b);
    if x < y {
        -1
    } else if x > y {
        1
    } else {
        0
    }
}

// The search dawn, sunrise, sunset and dusk share: the transit on `date`,
// else on the day before or after, else an error naming `what`.
fn transit_on_date(o: Observer, date: Date, zenith: f64, direction: i64, off: i64, what: Str) -> Result[Dt, String] {
    let mut tot = astimezone(time_of_transit(o, date, zenith, direction, true)?, off)?;
    let c = date_cmp(dt_date(tot), date);
    if c != 0 {
        let delta = if c < 0 { 1 } else { -1 };
        let new_date = date_add_days(date, delta)?;
        tot = astimezone(time_of_transit(o, new_date, zenith, direction, true)?, off)?;
        if date_cmp(dt_date(tot), date) != 0 {
            return Err(val_err(f"Unable to find a {what} time on the date specified"));
        }
    }
    Ok(tot)
}

fn dawn_dusk(o: Observer, date: Date, dep: ref Num, off: i64, direction: i64) -> Result[Dt, String] {
    let what = if direction == 1 { "dawn" } else { "dusk" };
    match transit_on_date(o, date, 90.0 + dep.v, direction, off, what) {
        Ok(t) => Ok(t),
        Err(e) => {
            if is_domain(e) {
                Err(val_err(f"Sun never reaches {dep.text} degrees below the horizon, at this location."))
            } else {
                Err(e)
            }
        }
    }
}

fn dawn(o: Observer, date: Date, dep: ref Num, off: i64) -> Result[Dt, String] {
    dawn_dusk(o, date, dep, off, 1)
}

fn dusk(o: Observer, date: Date, dep: ref Num, off: i64) -> Result[Dt, String] {
    dawn_dusk(o, date, dep, off, -1)
}

fn rise_set(o: Observer, date: Date, off: i64, direction: i64) -> Result[Dt, String] {
    let what = if direction == 1 { "sunrise" } else { "sunset" };
    match transit_on_date(o, date, 90.0 + SUN_APPARENT_RADIUS, direction, off, what) {
        Ok(t) => Ok(t),
        Err(e) => {
            if is_domain(e) {
                let z = sun_zenith(o, noon(o, date, 0)?, true)?;
                if z > 90.0 {
                    Err(val_err("Sun is always below the horizon on this day, at this location."))
                } else {
                    Err(val_err("Sun is always above the horizon on this day, at this location."))
                }
            } else {
                Err(e)
            }
        }
    }
}

fn sunrise(o: Observer, date: Date, off: i64) -> Result[Dt, String] {
    rise_set(o, date, off, 1)
}

fn sunset(o: Observer, date: Date, off: i64) -> Result[Dt, String] {
    rise_set(o, date, off, -1)
}

fn daylight(o: Observer, date: Date, off: i64) -> Result[(Dt, Dt), String] {
    let sr = sunrise(o, date, off)?;
    let ss = sunset(o, date, off)?;
    Ok((sr, ss))
}

fn night(o: Observer, date: Date, off: i64) -> Result[(Dt, Dt), String] {
    let six = Num { v: 6.0, text: "6".to_string() };
    let start = dusk(o, date, six, off)?;
    let tomorrow = date_add_days(date, 1)?;
    let end = dawn(o, tomorrow, six, off)?;
    Ok((start, end))
}

fn twilight(o: Observer, date: Date, direction: i64, off: i64) -> Result[(Dt, Dt), String] {
    let start = astimezone(time_of_transit(o, date, 96.0, direction, true)?, off)?;
    let end = if direction == 1 {
        astimezone(sunrise(o, date, off)?, off)?
    } else {
        astimezone(sunset(o, date, off)?, off)?
    };
    if direction == 1 { Ok((start, end)) } else { Ok((end, start)) }
}

// golden_hour (zeniths 94 and 84) and blue_hour (96 and 94)
fn hour_between(o: Observer, date: Date, direction: i64, off: i64, z_start: f64, z_end: f64) -> Result[(Dt, Dt), String] {
    let start = astimezone(time_of_transit(o, date, z_start, direction, true)?, off)?;
    let end = astimezone(time_of_transit(o, date, z_end, direction, true)?, off)?;
    if direction == 1 { Ok((start, end)) } else { Ok((end, start)) }
}

fn rahukaalam(o: Observer, date: Date, daytime: bool, off: i64) -> Result[(Dt, Dt), String] {
    let (start, end) = if daytime {
        (sunrise(o, date, off)?, sunset(o, date, off)?)
    } else {
        (sunset(o, date, off)?, sunrise(o, date_add_days(date, 1)?, off)?)
    };
    // timedelta(seconds=(end - start).seconds / 8), in microseconds
    let diff = utc_us(end) - utc_us(start);
    let seconds = imod(diff, 86400000000) / 1000000;
    let octant_duration = seconds * 125000;
    let octant_index: Vec[i64] = [1, 6, 4, 5, 3, 2, 7];
    let octant = octant_index[weekday(date)];
    let s2 = dt_add(start, octant_duration * octant)?;
    let e2 = dt_add(s2, octant_duration)?;
    Ok((s2, e2))
}

// ------------------------------------------------------------ moon.py

#[derive(Copy, Clone)]
struct Pos {
    right_ascension: f64,
    declination: f64,
    distance: f64,
}

#[derive(Clone)]
struct T4Row {
    coefficient: f64,
    t: bool,
    is_sin: bool,
    m: Vec[i64],
}

fn interpolate(f0: f64, f1: f64, f2: f64, p: f64) -> f64 {
    let a = f1 - f0;
    let b = f2 - f1 - a;
    f0 + p * (2.0 * a + b * (2.0 * p - 1.0))
}

fn sgn(v: f64) -> i64 {
    if v < 0.0 {
        -1
    } else if v > 0.0 {
        1
    } else {
        0
    }
}

fn frac_rev(x: f64) -> f64 {
    x - (tr(x) as f64)
}

fn calc_value(table: ref Vec[T4Row], args: ref Vec[f64], t_big: f64) -> Result[f64, String] {
    // argument numbers of the multipliers: Gm, Fm, D, Om, Ls, Gs, L2
    let arg_numbers: Vec[i64] = [2, 3, 4, 5, 7, 8, 12];
    let mut result = 0.0;
    for row in table {
        let mut revolutions = 0.0;
        let mut k = 0;
        while k < 7 {
            let multiplier = row.m[k];
            if multiplier != 0 {
                let arg_value = args[arg_numbers[k] - 1];
                if arg_value != 0.0 {
                    revolutions += arg_value * (multiplier as f64);
                } else {
                    return Err(val_err(""));
                }
            }
            k += 1;
        }
        let t_multipler = if row.t { t_big } else { 1.0 };
        let x = revolutions * 2.0 * PI;
        let sc = if row.is_sin { x.sin() } else { x.cos() };
        result += row.coefficient * t_multipler * sc;
    }
    Ok(result)
}

fn moon_position(jd2000: f64, tv: ref Vec[T4Row], tu: ref Vec[T4Row], tw: ref Vec[T4Row]) -> Result[Pos, String] {
    let lm = frac_rev(0.606434 + 0.03660110129 * jd2000);
    let gm = frac_rev(0.374897 + 0.03629164709 * jd2000);
    let fm = frac_rev(0.259091 + 0.03674819520 * jd2000);
    let d = frac_rev(0.827362 + 0.03386319198 * jd2000);
    let om = lm - fm;
    let ls = frac_rev(0.779072 + 0.00273790931 * jd2000);
    let gs = frac_rev(0.993126 + 0.00273777850 * jd2000);
    let l2 = frac_rev(0.505498 + 0.00445046867 * jd2000);
    let args: Vec[f64] = [lm, gm, fm, d, om, 0.0, ls, gs, 0.0, 0.0, 0.0, l2];
    let t_big = jd2000 / 36525.0 + 1.0;
    let v = calc_value(tv, args, t_big)?;
    let u = calc_value(tu, args, t_big)?;
    let w = calc_value(tw, args, t_big)?;
    let mut s = w / py_sqrt(u - v * v)?;
    let right_ascension = py_asin(s)? + lm * 2.0 * PI;
    s = v / py_sqrt(u)?;
    let declination = py_asin(s)?;
    let distance = 60.40974 * py_sqrt(u)?;
    Ok(Pos { right_ascension: right_ascension, declination: declination, distance: distance })
}

// kind: 0 no transit, 1 rise, 2 set
#[derive(Copy, Clone)]
struct Transit {
    kind: i64,
    h: i64,
    m: i64,
}

fn moon_transit_event(hour: i64, lmst: f64, latitude: f64, distance: f64, window: mut ref Vec[Pos]) -> Result[Transit, String] {
    let none = Transit { kind: 0, h: 0, m: 0 };
    let mst = radians(lmst);
    let mut ha: Vec[f64] = [0.0, 0.0, 0.0];
    let k1 = radians(15.0 * 1.0027379097096138907193594760917);
    if window[2].right_ascension < window[0].right_ascension {
        window[2].right_ascension = window[2].right_ascension + 2.0 * PI;
    }
    let hf = hour as f64;
    ha[0] = mst - window[0].right_ascension + (hf * k1);
    ha[2] = mst - window[2].right_ascension + (hf * k1) + k1;
    ha[1] = (ha[2] + ha[0]) / 2.0;
    window[1].declination = (window[2].declination + window[0].declination) / 2.0;
    let sl = radians(latitude).sin();
    let cl = radians(latitude).cos();
    let z = radians(90.0 + MOON_APPARENT_RADIUS - (41.685 / distance)).cos();
    if hour == 0 {
        window[0].distance = sl * window[0].declination.sin() + cl * window[0].declination.cos() * ha[0].cos() - z;
    }
    window[2].distance = sl * window[2].declination.sin() + cl * window[2].declination.cos() * ha[2].cos() - z;
    if sgn(window[0].distance) == sgn(window[2].distance) {
        return Ok(none);
    }
    window[1].distance = sl * window[1].declination.sin() + cl * window[1].declination.cos() * ha[1].cos() - z;
    let a = 2.0 * window[2].distance - 4.0 * window[1].distance + 2.0 * window[0].distance;
    let b = 4.0 * window[1].distance - 3.0 * window[0].distance - window[2].distance;
    let mut discriminant = b * b - 4.0 * a * window[0].distance;
    if discriminant < 0.0 {
        return Ok(none);
    }
    discriminant = discriminant.sqrt();
    if 2.0 * a == 0.0 {
        return Err(zero_div());
    }
    let mut e = (-b + discriminant) / (2.0 * a);
    if e > 1.0 or e < 0.0 {
        e = (-b - discriminant) / (2.0 * a);
    }
    let time = hf + e + 1.0 / 120.0;
    let h = tr(time);
    let m = tr((time - h as f64) * 60.0);
    check_time(h, m, 0, 0)?;
    if window[0].distance < 0.0 and window[2].distance > 0.0 {
        return Ok(Transit { kind: 1, h: h, m: m });
    }
    if window[0].distance > 0.0 and window[2].distance < 0.0 {
        return Ok(Transit { kind: 2, h: h, m: m });
    }
    Ok(none)
}

fn secs_between(a: Dt, b: Dt) -> f64 {
    ((utc_us(a) - utc_us(b)) / 1000000) as f64
}

// Whether a new event replaces the one kept so far (`kept`), given the other
// kind's event (`other`), relative to the hour being searched.
fn should_update(kept: Dt, event: Dt, other: Option[Dt], query: Dt) -> bool {
    let kq = secs_between(kept, query);
    let eq = secs_between(event, query);
    let mut oq = 0.0;
    let mut has_other = false;
    match other {
        Some(t) => {
            oq = secs_between(t, query);
            has_other = true;
        }
        None => {}
    }
    let mut update = sgn(kq) == sgn(eq) and kq.abs() > eq.abs();
    update = update or (sgn(kq) != sgn(eq) and (has_other and sgn(kq) == sgn(oq)));
    update
}

fn riseset(on: Date, o: Observer, t4: ref Vec[Vec[T4Row]]) -> Result[(Option[Dt], Option[Dt]), String] {
    let jd2000 = julianday_date(on) - 2451545.0;
    let t0 = lmst_of(jd2000, o.longitude);
    let mut m: Vec[Pos] = Vec.new();
    let mut interval = 0;
    while interval < 3 {
        m.push(moon_position(jd2000 + (interval as f64) * 0.5, t4[0], t4[1], t4[2])?);
        interval += 1;
    }
    interval = 1;
    while interval < 3 {
        if m[interval].right_ascension <= m[interval - 1].right_ascension {
            m[interval].right_ascension = m[interval].right_ascension + 2.0 * PI;
        }
        interval += 1;
    }
    let zero = Pos { right_ascension: 0.0, declination: 0.0, distance: 0.0 };
    let mut window: Vec[Pos] = [m[0], zero, zero];
    let mut rise_time: Option[Dt] = None;
    let mut set_time: Option[Dt] = None;
    let mut hour = 0;
    while hour < 24 {
        let ph = ((hour + 1) as f64) / 24.0;
        window[2].right_ascension = interpolate(m[0].right_ascension, m[1].right_ascension, m[2].right_ascension, ph);
        window[2].declination = interpolate(m[0].declination, m[1].declination, m[2].declination, ph);
        let info = moon_transit_event(hour, t0, o.latitude, m[1].distance, mut window)?;
        if info.kind != 0 {
            let query_time = utc_dt(on, hour, 0, 0)?;
            let event = utc_dt(on, info.h, info.m, 0)?;
            if info.kind == 1 {
                match rise_time {
                    None => {
                        rise_time = Some(event);
                    }
                    Some(kept) => {
                        if should_update(kept, event, set_time, query_time) {
                            rise_time = Some(event);
                        }
                    }
                }
            } else {
                match set_time {
                    None => {
                        set_time = Some(event);
                    }
                    Some(kept) => {
                        if should_update(kept, event, rise_time, query_time) {
                            set_time = Some(event);
                        }
                    }
                }
            }
        }
        window[0].right_ascension = window[2].right_ascension;
        window[0].declination = window[2].declination;
        window[0].distance = window[2].distance;
        hour += 1;
    }
    Ok((rise_time, set_time))
}

// moonrise (which = 0) and moonset (which = 1)
fn moon_event(o: Observer, date: Date, off: i64, which: i64, t4: ref Vec[Vec[T4Row]]) -> Result[Option[Dt], String] {
    let (r0, s0) = riseset(date, o, t4)?;
    let first = if which == 0 { r0 } else { s0 };
    match first {
        None => {
            if which == 0 {
                Err(val_err("Moon never rises on this date, at this location"))
            } else {
                Err(val_err("Moon never sets on this date, at this location"))
            }
        }
        Some(t) => {
            let mut ev = astimezone(t, off)?;
            let c = date_cmp(dt_date(ev), date);
            if c != 0 {
                let delta = if c > 0 { -1 } else { 1 };
                let new_date = date_add_days(date, delta)?;
                let (r1, s1) = riseset(new_date, o, t4)?;
                let second = if which == 0 { r1 } else { s1 };
                match second {
                    Some(t2) => {
                        ev = astimezone(t2, off)?;
                        if date_cmp(dt_date(ev), date) != 0 {
                            return Ok(None);
                        }
                    }
                    None => {}
                }
            }
            Ok(Some(ev))
        }
    }
}

// moon.azimuth and moon.elevation; julianday() reads the wall clock fields
// whatever the time zone
fn moon_altaz(o: Observer, at: Dt, t4: ref Vec[Vec[T4Row]]) -> Result[(f64, f64), String] {
    let jd2000 = julianday_dt(at) - 2451545.0;
    let position = moon_position(jd2000, t4[0], t4[1], t4[2])?;
    let lst0 = radians(lmst_of(jd2000, o.longitude));
    let hourangle = lst0 - position.right_ascension;
    let sh = hourangle.sin();
    let ch = hourangle.cos();
    let sd = position.declination.sin();
    let cd = position.declination.cos();
    let sl = radians(o.latitude).sin();
    let cl = radians(o.latitude).cos();
    let x = -ch * cd * sl + sd * cl;
    let y = -sh * cd;
    let azimuth = pmod(degrees(y.atan2(x)), 360.0);
    let z = ch * cd * cl + sd * sl;
    let r = (x * x + y * y).sqrt();
    let elevation = degrees(z.atan2(r));
    Ok((azimuth, elevation))
}

fn phase(date: Date) -> f64 {
    let jd = julianday_date(date);
    let dt = (jd - 2382148.0).pow(2.0) / (41048480.0 * 86400.0);
    let t = (jd + dt - 2451545.0) / 36525.0;
    let t2 = t.pow(2.0);
    let t3 = t.pow(3.0);
    let mut d = 297.85 + (445267.1115 * t) - (0.0016300 * t2) + (t3 / 545868.0);
    d = radians(pmod(d, 360.0));
    let mut m = 357.53 + (35999.0503 * t);
    m = radians(pmod(m, 360.0));
    let mut m1 = 134.96 + (477198.8676 * t) + (0.0089970 * t2) + (t3 / 69699.0);
    m1 = radians(pmod(m1, 360.0));
    let mut elong = degrees(d) + 6.29 * m1.sin();
    elong -= 2.10 * m.sin();
    elong += 1.27 * (2.0 * d - m1).sin();
    elong += 0.66 * (2.0 * d).sin();
    elong = pmod(elong, 360.0);
    let ei = tr(elong);
    let mut moon = ((ei as f64 + 6.43) / 360.0) * 28.0;
    if moon >= 28.0 {
        moon -= 28.0;
    }
    moon
}

// ------------------------------------------------------------ geocoder.py

#[derive(Clone)]
struct LocationInfo {
    name: String,
    region: String,
    timezone: String,
    latitude: f64,
    longitude: f64,
}

#[derive(Clone)]
struct GeoEntry {
    key: String,
    locs: Vec[LocationInfo],
}

#[derive(Clone)]
struct Group {
    key: String,
    entries: Vec[GeoEntry],
}

fn sanitize_key(key: ref String) -> String {
    lower_ascii(key).replace(" ", "_")
}

fn timezone_group(loc: ref LocationInfo) -> String {
    match loc.timezone.find("/") {
        Some(i) => loc.timezone.substring(0, i),
        None => loc.timezone.clone(),
    }
}

fn loc_repr(loc: ref LocationInfo) -> String {
    f"LocationInfo(name={py_repr_str(loc.name)}, region={py_repr_str(loc.region)}, timezone={py_repr_str(loc.timezone)}, latitude={fmt(loc.latitude)}, longitude={fmt(loc.longitude)})"
}

fn database() -> Vec[Group] {
    let mut db: Vec[Group] = Vec.new();
    for raw in split_on(location_info(), '\n') {
        let line = py_strip(raw);
        if line.len() == 0 or line.starts_with("#") {
            continue;
        }
        let f = split_on(line, ',');
        let lat = match dms_to_float(f[3], true, 90.0) {
            Ok(v) => v,
            Err(_) => NAN_F,
        };
        let lon = match dms_to_float(f[4], true, 180.0) {
            Ok(v) => v,
            Err(_) => NAN_F,
        };
        let loc = LocationInfo { name: f[0].clone(), region: f[1].clone(), timezone: f[2].clone(), latitude: lat, longitude: lon };
        let gkey = sanitize_key(timezone_group(loc));
        let mut gi = -1;
        let mut i = 0;
        while i < db.len() {
            if db[i].key == gkey {
                gi = i;
            }
            i += 1;
        }
        if gi < 0 {
            db.push(Group { key: gkey, entries: Vec.new() });
            gi = db.len() - 1;
        }
        let lkey = sanitize_key(loc.name);
        let mut ei = -1;
        let mut j = 0;
        while j < db[gi].entries.len() {
            if db[gi].entries[j].key == lkey {
                ei = j;
            }
            j += 1;
        }
        if ei < 0 {
            db[gi].entries.push(GeoEntry { key: lkey, locs: [loc] });
        } else {
            db[gi].entries[ei].locs.push(loc);
        }
    }
    db
}

fn key_err(msg: ref String) -> String {
    f"KeyError: {py_repr_str(msg)}"
}

fn strip_quotes(s: ref String) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut a = 0;
    let mut b = cs.len();
    while a < b and (cs[a] == '"' or cs[a] == '\'') {
        a += 1;
    }
    while b > a and (cs[b - 1] == '"' or cs[b - 1] == '\'') {
        b -= 1;
    }
    slice_chars(cs, a, b)
}

fn lookup_in_group(location: ref String, g: ref Group) -> Option[LocationInfo] {
    let key = sanitize_key(location);
    let mut lookup_name = key.clone();
    let mut lookup_region = "".to_string();
    match key.find(",") {
        Some(i) => {
            lookup_name = key.substring(0, i);
            lookup_region = key.substring(i + 1, key.len());
        }
        None => {}
    }
    lookup_name = strip_quotes(lookup_name);
    lookup_region = strip_quotes(lookup_region);
    for e in g.entries {
        if e.key == lookup_name {
            if lookup_region.len() == 0 {
                return Some(e.locs[0].clone());
            }
            for loc in e.locs {
                if sanitize_key(loc.region) == lookup_region {
                    return Some(loc.clone());
                }
            }
        }
    }
    None
}

// lookup(): a group (its index in .0) or a location (.1)
fn lookup(name: ref String, db: ref Vec[Group]) -> Result[(i64, Option[LocationInfo]), String] {
    let key = sanitize_key(name);
    let mut i = 0;
    while i < db.len() {
        if db[i].key == key {
            return Ok((i, None));
        }
        match lookup_in_group(name, db[i]) {
            Some(loc) => {
                return Ok((-1, Some(loc)));
            }
            None => {}
        }
        i += 1;
    }
    Err(key_err(f"Unrecognised name - {name}"))
}

fn group_of(region: ref String, db: ref Vec[Group]) -> Result[i64, String] {
    let key = sanitize_key(region);
    let mut i = 0;
    while i < db.len() {
        if db[i].key == key {
            return Ok(i);
        }
        i += 1;
    }
    Err(key_err(f"Unrecognised Group - {region}"))
}

fn group_names(g: ref Group, limit: i64) -> (i64, String) {
    let mut s = String.new();
    let mut n = 0;
    for e in g.entries {
        if n < limit {
            if n > 0 {
                s.push_str(", ");
            }
            s.push_str(e.key);
        }
        n += 1;
    }
    (n, s)
}

// ------------------------------------------------------------ the jobs

fn split_on(s: ref String, sep: char) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn to_int(s: ref String) -> i64 {
    to_i64(s)
}

fn parse_tz(tz: ref String) -> (bool, i64) {
    if tz == "naive" {
        return (false, 0);
    }
    if tz == "utc" {
        return (true, 0);
    }
    let secs = to_int(sl(tz, 1, 3)) * 3600 + to_int(sl(tz, 4, 6)) * 60;
    (true, if sl(tz, 0, 1) == "-" { -secs } else { secs })
}

fn parse_date(s: ref String) -> Date {
    Date { y: to_int(sl(s, 0, 4)), m: to_int(sl(s, 5, 7)), d: to_int(sl(s, 8, 10)) }
}

fn parse_dt(s: ref String, aware: bool, off: i64) -> Dt {
    Dt { y: to_int(sl(s, 0, 4)), mo: to_int(sl(s, 5, 7)), d: to_int(sl(s, 8, 10)), h: to_int(sl(s, 11, 13)), mi: to_int(sl(s, 14, 16)), s: to_int(sl(s, 17, 19)), us: to_int(sl(s, 20, 26)), aware: aware, off: off }
}

fn observer(lat: ref String, lon: ref String, el: ref String) -> Observer {
    let la = match dms_to_float(lat, true, 90.0) {
        Ok(v) => v,
        Err(_) => NAN_F,
    };
    let lo = match dms_to_float(lon, true, 180.0) {
        Ok(v) => v,
        Err(_) => NAN_F,
    };
    match el.find("/") {
        Some(i) => Observer { latitude: la, longitude: lo, tuple_elev: true, e0: to_f64(el.substring(0, i)), e1: to_f64(el.substring(i + 1, el.len())) },
        None => Observer { latitude: la, longitude: lo, tuple_elev: false, e0: to_f64(el.clone()), e1: 0.0 },
    }
}

fn depression(s: ref String) -> Num {
    if s == "CIVIL" {
        return Num { v: 6.0, text: "6".to_string() };
    }
    if s == "NAUTICAL" {
        return Num { v: 12.0, text: "12".to_string() };
    }
    if s == "ASTRONOMICAL" {
        return Num { v: 18.0, text: "18".to_string() };
    }
    let v = to_f64(s.clone());
    Num { v: v, text: if s.contains(".") { fmt(v) } else { s.clone() } }
}

fn line(out: mut ref String, name: ref String, r: ref String) {
    out.push_str(f"  {name} => {r}\n");
}

fn show_dt(r: own Result[Dt, String]) -> String {
    match r {
        Ok(t) => dt_str(t),
        Err(e) => e,
    }
}

fn show_pair(r: own Result[(Dt, Dt), String]) -> String {
    match r {
        Ok((a, b)) => f"({dt_str(a)}, {dt_str(b)})",
        Err(e) => e,
    }
}

fn show_opt(r: own Result[Option[Dt], String]) -> String {
    match r {
        Ok(Some(t)) => dt_str(t),
        Ok(None) => "None".to_string(),
        Err(e) => e,
    }
}

fn show_f(r: own Result[f64, String]) -> String {
    match r {
        Ok(v) => fmt(v),
        Err(e) => e,
    }
}

fn show_str(r: own Result[String, String]) -> String {
    match r {
        Ok(v) => v,
        Err(e) => e,
    }
}

fn sun_dict(o: Observer, d: Date, dep: ref Num, off: i64) -> Result[String, String] {
    let a = dawn(o, d, dep, off)?;
    let b = sunrise(o, d, off)?;
    let c = noon(o, d, off)?;
    let e = sunset(o, d, off)?;
    let f = dusk(o, d, dep, off)?;
    Ok(f"{{dawn: {dt_str(a)}, sunrise: {dt_str(b)}, noon: {dt_str(c)}, sunset: {dt_str(e)}, dusk: {dt_str(f)}}}")
}

fn day_job(out: mut ref String, f: ref Vec[String], t4: ref Vec[Vec[T4Row]]) {
    let o = observer(f[1], f[2], f[3]);
    let d = parse_date(f[4]);
    let (_, off) = parse_tz(f[5]);
    let dep = depression(f[6]);
    let civil = depression("CIVIL".to_string());
    let mut hdr = String.new();
    let mut i = 1;
    while i < f.len() {
        if i > 1 {
            hdr.push_str(", ");
        }
        hdr.push_str(f[i]);
        i += 1;
    }
    out.push_str(f"day({hdr})\n");
    out.push_str(f"  observer => {observer_repr(o)}\n");
    line(mut out, "dawn", show_dt(dawn(o, d, civil, off)));
    line(mut out, "dawn(dep)", show_dt(dawn(o, d, dep, off)));
    line(mut out, "sunrise", show_dt(sunrise(o, d, off)));
    line(mut out, "noon", show_dt(noon(o, d, off)));
    line(mut out, "midnight", show_dt(midnight(o, d, off)));
    line(mut out, "sunset", show_dt(sunset(o, d, off)));
    line(mut out, "dusk", show_dt(dusk(o, d, civil, off)));
    line(mut out, "dusk(dep)", show_dt(dusk(o, d, dep, off)));
    line(mut out, "daylight", show_pair(daylight(o, d, off)));
    line(mut out, "night", show_pair(night(o, d, off)));
    line(mut out, "twilight(rising)", show_pair(twilight(o, d, 1, off)));
    line(mut out, "twilight(setting)", show_pair(twilight(o, d, -1, off)));
    line(mut out, "golden_hour(rising)", show_pair(hour_between(o, d, 1, off, 94.0, 84.0)));
    line(mut out, "golden_hour(setting)", show_pair(hour_between(o, d, -1, off, 94.0, 84.0)));
    line(mut out, "blue_hour(rising)", show_pair(hour_between(o, d, 1, off, 96.0, 94.0)));
    line(mut out, "blue_hour(setting)", show_pair(hour_between(o, d, -1, off, 96.0, 94.0)));
    line(mut out, "rahukaalam(day)", show_pair(rahukaalam(o, d, true, off)));
    line(mut out, "rahukaalam(night)", show_pair(rahukaalam(o, d, false, off)));
    line(mut out, "sun", show_str(sun_dict(o, d, dep, off)));
    for spec in split_on(f[7], ',') {
        let p = split_on(spec, ':');
        let direction = if p[1] == "R" { 1 } else { -1 };
        let r = time_at_elevation(o, to_f64(p[0].clone()), d, direction, off, p[2] == "1");
        line(mut out, f"time_at_elevation({p[0]}, {p[1]}, {p[2]})", show_dt(r));
    }
    line(mut out, "moonrise", show_opt(moon_event(o, d, off, 0, t4)));
    line(mut out, "moonset", show_opt(moon_event(o, d, off, 1, t4)));
    line(mut out, "phase", fmt(phase(d)));
}

fn pos_job(out: mut ref String, f: ref Vec[String], t4: ref Vec[Vec[T4Row]]) {
    let o = observer(f[1], f[2], f[3]);
    let (aware, off) = parse_tz(f[5]);
    let t = parse_dt(f[4], aware, off);
    out.push_str(f"pos({f[1]}, {f[2]}, {f[3]}, {f[4]}, {f[5]})\n");
    line(mut out, "sun.zenith", show_f(sun_zenith(o, t, true)));
    line(mut out, "sun.zenith(no refraction)", show_f(sun_zenith(o, t, false)));
    line(mut out, "sun.azimuth", show_f(sun_azimuth(o, t)));
    line(mut out, "sun.elevation", show_f(sun_elevation(o, t, true)));
    line(mut out, "sun.elevation(no refraction)", show_f(sun_elevation(o, t, false)));
    match moon_altaz(o, t, t4) {
        Ok((az, el)) => {
            line(mut out, "moon.azimuth", fmt(az));
            line(mut out, "moon.elevation", fmt(el));
            line(mut out, "moon.zenith", fmt(90.0 - el));
        }
        Err(e) => {
            line(mut out, "moon.azimuth", e);
            line(mut out, "moon.elevation", e);
            line(mut out, "moon.zenith", e);
        }
    }
}

fn city_job(out: mut ref String, f: ref Vec[String], db: ref Vec[Group], t4: ref Vec[Vec[T4Row]]) {
    out.push_str(f"city({py_repr_str(f[1])}, {f[2]}, {f[3]})\n");
    match lookup(f[1], db) {
        Err(e) => {
            out.push_str(f"  {e}\n");
        }
        Ok((gi, found)) => {
            match found {
                None => {
                    let (n, names) = group_names(db[gi], 6);
                    out.push_str(f"  group of {n} names: {names}\n");
                }
                Some(loc) => {
                    out.push_str(f"  {loc_repr(loc)}\n");
                    out.push_str(f"  timezone_group => {py_repr_str(timezone_group(loc))}\n");
                    let o = Observer { latitude: loc.latitude, longitude: loc.longitude, tuple_elev: false, e0: 0.0, e1: 0.0 };
                    let d = parse_date(f[2]);
                    let (_, off) = parse_tz(f[3]);
                    let civil = depression("CIVIL".to_string());
                    line(mut out, "sun", show_str(sun_dict(o, d, civil, off)));
                    line(mut out, "moonrise", show_opt(moon_event(o, d, off, 0, t4)));
                }
            }
        }
    }
}

fn run_job(out: mut ref String, f: ref Vec[String], db: ref Vec[Group], t4: ref Vec[Vec[T4Row]]) {
    let k = f[0].clone();
    if k == "day" {
        day_job(mut out, f, t4);
    } else if k == "pos" {
        pos_job(mut out, f, t4);
    } else if k == "city" {
        city_job(mut out, f, db, t4);
    } else if k == "group" {
        out.push_str(f"group({py_repr_str(f[1])})\n");
        match group_of(f[1], db) {
            Err(e) => {
                out.push_str(f"  {e}\n");
            }
            Ok(gi) => {
                let (n, names) = group_names(db[gi], 1000000);
                out.push_str(f"  {n} names: {names}\n");
                let mut j = 0;
                while j < 3 and j < db[gi].entries.len() {
                    for loc in db[gi].entries[j].locs {
                        out.push_str(f"  {loc_repr(loc)}\n");
                    }
                    j += 1;
                }
            }
        }
    } else if k == "dms" {
        out.push_str(f"dms({py_repr_str(f[1])}, {f[2]})\n");
        let has = f[2] != "none";
        let lim = if has { to_f64(f[2].clone()) } else { 0.0 };
        line(mut out, "dms_to_float", show_f(dms_to_float(f[1], has, lim)));
    } else if k == "h2t" {
        out.push_str(f"h2t({f[1]})\n");
        line(mut out, "hours_to_time", show_str(hours_to_time(to_f64(f[1].clone()))));
    } else if k == "t2h" {
        out.push_str(f"t2h({f[1]}, {f[2]}, {f[3]}, {f[4]})\n");
        let h = to_int(f[1]);
        let m = to_int(f[2]);
        let s = to_int(f[3]);
        let us = to_int(f[4]);
        match check_time(h, m, s, us) {
            Err(e) => {
                out.push_str(f"  {e}\n");
            }
            Ok(_) => {
                let hours = time_to_hours(h, m, s, us);
                line(mut out, "time_to_hours", fmt(hours));
                line(mut out, "time_to_seconds", fmt(hours * 3600.0));
            }
        }
    } else if k == "refr" {
        out.push_str(f"refr({f[1]})\n");
        let (r, is_int) = refraction_at_zenith(to_f64(f[1].clone()));
        line(mut out, "refraction_at_zenith", if is_int { "0".to_string() } else { fmt(r) });
    } else if k == "jd" {
        out.push_str(f"jd({f[1]}, {f[2]})\n");
        let has_time = f[1].contains("T");
        let t = parse_dt(f[1], false, 0);
        let secs = if has_time { t.h * 3600 + t.mi * 60 + t.s } else { 0 };
        let lon = to_f64(f[2].clone());
        let jd = julianday_at(t.y, t.mo, t.d, has_time, secs, true);
        line(mut out, "julianday", fmt(jd));
        line(mut out, "julianday(julian)", fmt(julianday_at(t.y, t.mo, t.d, has_time, secs, false)));
        if has_time {
            line(mut out, "julianday_modified", fmt(julianday_modified(t)));
        }
        line(mut out, "julianday_2000", fmt(jd - 2451545.0));
        let jc = julianday_to_juliancentury(jd);
        line(mut out, "juliancentury", fmt(jc));
        line(mut out, "julianday(juliancentury)", fmt(juliancentury_to_julianday(jc)));
        line(mut out, "gmst", fmt(gmst_of(jd - 2451545.0)));
        line(mut out, "lmst", fmt(lmst_of(jd - 2451545.0, lon)));
    } else if k == "jd2dt" {
        out.push_str(f"jd2dt({f[1]})\n");
        line(mut out, "julianday_to_datetime", show_str(julianday_to_datetime(to_f64(f[1].clone()))));
    } else if k == "dft" {
        out.push_str(f"dft({f[1]})\n");
        line(mut out, "day_fraction_to_time", show_str(day_fraction_to_time(to_f64(f[1].clone()))));
    } else if k == "m2td" {
        out.push_str(f"m2td({f[1]})\n");
        line(mut out, "minutes_to_timedelta", td_str(minutes_to_timedelta(to_f64(f[1].clone()))));
    } else if k == "mpos" {
        out.push_str(f"mpos({f[1]})\n");
        let r = match moon_position(to_f64(f[1].clone()), t4[0], t4[1], t4[2]) {
            Ok(p) => f"AstralBodyPosition(right_ascension={fmt(p.right_ascension)}, declination={fmt(p.declination)}, distance={fmt(p.distance)})",
            Err(e) => e,
        };
        line(mut out, "moon_position", r);
    } else if k == "phase" {
        out.push_str(f"phase({f[1]})\n");
        line(mut out, "phase", fmt(phase(parse_date(f[1]))));
    }
}

fn main() {
    let db = database();
    let t4: Vec[Vec[T4Row]] = [table4(0), table4(1), table4(2)];
    let mut out = String.new();
    for ln in split_on(jobs_text(), '\n') {
        if ln.len() > 0 {
            let f = split_on(ln, '\t');
            run_job(mut out, f, db, t4);
        }
    }
    let mut n = 0;
    for g in db {
        for e in g.entries {
            n += e.locs.len();
        }
    }
    out.push_str(f"database: {db.len()} groups, {n} locations\n");
    print(out);
}

