$ systemctl cat webapp.service
# /etc/systemd/system/webapp.service
# The shop's API, run by the admin.
[Unit]
Description=Shop API (%n)
Requires=postgresql.service
Wants=redis.service metrics-agent.service
After=postgresql.service redis.service network-online.target
Wants=network-online.target

[Service]
User=shop
ExecStart=/srv/shop/bin/api --port 8080

[Install]
WantedBy=multi-user.target

# /etc/systemd/system/webapp.service.d/10-env.conf
[Service]
Environment=RUST_LOG=info

# /etc/systemd/system/webapp.service.d/20-limits.conf
[Unit]
# Drop the soft dependency on redis; the cache is optional now.
Wants=
Wants=metrics-agent.service network-online.target

$ systemctl show webapp.service
Id=webapp.service
Description=Shop API (webapp.service)
LoadState=loaded
FragmentPath=/etc/systemd/system/webapp.service
DropInPaths=/etc/systemd/system/webapp.service.d/10-env.conf /etc/systemd/system/webapp.service.d/20-limits.conf
Requires=postgresql.service
Wants=metrics-agent.service network-online.target
Conflicts=
Before=
After=postgresql.service redis.service network-online.target
ExecStart=/srv/shop/bin/api --port 8080
User=shop
Environment=RUST_LOG=info
ActiveState=inactive
UnitFileState=disabled

$ systemctl show getty@tty2.service
Id=getty@tty2.service
Description=Getty on tty2
LoadState=loaded
FragmentPath=/usr/lib/systemd/system/getty@.service
DropInPaths=
Requires=
Wants=
Conflicts=
Before=
After=systemd-user-sessions.service
ExecStart=-/sbin/agetty -o '-p -- \\u' --noclear tty2 $TERM
User=root
Environment=
ActiveState=inactive
UnitFileState=disabled

$ systemctl show missing.service
Id=missing.service
LoadState=not-found
ActiveState=inactive

$ systemctl enable postgresql.service
