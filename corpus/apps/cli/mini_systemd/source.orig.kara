fn data_files() -> Vec[(String, String)] {
    let mut v: Vec[(String, String)] = Vec.new();
    v.push(("usr/lib/systemd/system/basic.target".to_string(), file_0()));
    v.push(("usr/lib/systemd/system/sysinit.target".to_string(), file_1()));
    v.push(("usr/lib/systemd/system/local-fs.target".to_string(), file_2()));
    v.push(("usr/lib/systemd/system/network.target".to_string(), file_3()));
    v.push(("usr/lib/systemd/system/network-online.target".to_string(), file_4()));
    v.push(("usr/lib/systemd/system/multi-user.target".to_string(), file_5()));
    v.push(("usr/lib/systemd/system/rescue.target".to_string(), file_6()));
    v.push(("usr/lib/systemd/system/systemd-journald.service".to_string(), file_7()));
    v.push(("usr/lib/systemd/system/postgresql.service".to_string(), file_8()));
    v.push(("usr/lib/systemd/system/redis.service".to_string(), file_9()));
    v.push(("usr/lib/systemd/system/nginx.service".to_string(), file_10()));
    v.push(("etc/systemd/system/webapp.service".to_string(), file_11()));
    v.push(("etc/systemd/system/webapp.service.d/10-env.conf".to_string(), file_12()));
    v.push(("etc/systemd/system/webapp.service.d/20-limits.conf".to_string(), file_13()));
    v.push(("etc/systemd/system/metrics-agent.service".to_string(), file_14()));
    v.push(("etc/systemd/system/metrics-agent.service.d/override.conf".to_string(), file_15()));
    v.push(("usr/lib/systemd/system/getty@.service".to_string(), file_16()));
    v.push(("usr/lib/systemd/system/getty.target".to_string(), file_17()));
    v.push(("etc/systemd/system/backup.service".to_string(), file_18()));
    v.push(("etc/systemd/system/broken-mount.service".to_string(), file_19()));
    v.push(("etc/systemd/system/loop-a.service".to_string(), file_20()));
    v.push(("etc/systemd/system/loop-b.service".to_string(), file_21()));
    v.push(("jobs.txt".to_string(), file_22()));
    v
}

fn write_data() -> Result[(), String] {
    let _ = fs.remove_dir_all("data".to_string());
    for (name, text) in data_files() {
        let path = f"data/{name}";
        let dir = match last_index_of(path.as_str(), b'/') {
            Some(i) => path[..i].to_string(),
            None => ".".to_string(),
        };
        if let Err(e) = fs.create_dir_all(dir) {
            return Err(f"{e}");
        }
        if let Err(e) = fs.write(path, text) {
            return Err(f"{e}");
        }
    }
    Ok(())
}

fn run() -> Result[(), String] {
    write_data()?;
    let mut sys = System { state: SortedMap.new() };
    for line in read_file("data/jobs.txt").split("\n") {
        if line.is_empty() or line.starts_with("#") {
            continue;
        }
        let parts = words(line.as_str());
        let cmd = parts[0].clone();
        let arg = if parts.len() > 1 { parts[1].clone() } else { String.new() };
        if cmd != "start" and cmd != "stop" {
            println(f"$ systemctl {line}");
        }
        if cmd == "cat" {
            cmd_cat(arg.as_str());
        } else if cmd == "show" {
            cmd_show(sys, arg.as_str());
        } else if cmd == "enable" {
            cmd_enable(arg.as_str());
        } else if cmd == "disable" {
            cmd_disable(arg.as_str());
        } else if cmd == "list-dependencies" {
            cmd_list_deps(sys, arg.as_str());
        } else if cmd == "start" {
            cmd_start(sys, arg.as_str());
        } else if cmd == "stop" {
            cmd_stop(sys, arg.as_str());
        } else if cmd == "list-units" {
            cmd_list_units(sys);
        }
        println("");
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        eprintln(f"error: {e}");
    }
}
