// mini_pysubs2: a port of pysubs2 1.9.0 (MIT, Tomas Karabela), the
// subtitle library behind many video tools, run as a film festival's
// subtitle desk. The jobs read, convert, edit, retime and save subtitle
// files held in a small in-memory file system rooted at /work, and run the
// `pysubs2` command line over them. See README.md.

// ------------------------------------------------------------ Python str helpers
//
// A Python str can hold lone surrogates (surrogateescape puts them there).
// A Kāra String cannot, so a surrogate U+D800..U+DFFF is held as the
// private-use character U+F0000 + (cp - 0xD800). No job holds a real
// character from that range.

fn sur(cp: i64) -> char {
    char.try_from((0xf0000 + cp - 0xd800) as u32).unwrap()
}

// The code point Python sees.
fn py_cp(c: char) -> i64 {
    let n = c as i64;
    if n >= 0xf0000 and n < 0xf0800 { n - 0xf0000 + 0xd800 } else { n }
}

fn is_sur(c: char) -> bool {
    let n = c as i64;
    n >= 0xf0000 and n < 0xf0800
}

fn hex_digits(n: i64, width: i64) -> String {
    let d: Vec[char] = "0123456789abcdef".chars().collect();
    let mut out = String.new();
    let mut k = width;
    while k > 0 {
        k -= 1;
        out.push(d[(n >> (4 * k)) & 15]);
    }
    out
}

fn upper_hex(n: i64, width: i64) -> String {
    let d: Vec[char] = "0123456789ABCDEF".chars().collect();
    let mut out = String.new();
    let mut k = width;
    while k > 0 {
        k -= 1;
        out.push(d[(n >> (4 * k)) & 15]);
    }
    out
}

// str.isprintable(), for the characters subtitles hold.
fn py_printable(c: char) -> bool {
    let n = py_cp(c);
    if n < 0x20 or (n >= 0x7f and n <= 0xa0) or n == 0xad {
        return false;
    }
    if n == 0x1680 or (n >= 0x2000 and n <= 0x200f) or (n >= 0x2028 and n <= 0x202f) {
        return false;
    }
    if (n >= 0x205f and n <= 0x206f) or n == 0x3000 or n == 0xfeff or (n >= 0xfff9 and n <= 0xfffb) {
        return false;
    }
    not ((n >= 0xd800 and n <= 0xf8ff) or n >= 0xf0000)
}

fn char_esc(n: i64) -> String {
    if n < 0x100 {
        f"\\x{hex_digits(n, 2)}"
    } else if n < 0x10000 {
        f"\\u{hex_digits(n, 4)}"
    } else {
        f"\\U{hex_digits(n, 8)}"
    }
}

// repr() of a str.
fn py_repr_str(s: ref String) -> String {
    let q = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if py_printable(c) {
            out.push(c);
        } else {
            out.push_str(char_esc(py_cp(c)));
        }
    }
    out.push(q);
    out
}

// repr() of a list of str.
fn list_repr(xs: ref Vec[String]) -> String {
    let mut out = String.new();
    out.push('[');
    for i in 0..xs.len() {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(py_repr_str(xs[i]));
    }
    out.push(']');
    out
}

fn py_bool(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

// How the output shows text that may hold control characters.
fn vis(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        let n = py_cp(c);
        if n < 0x20 or n == 0x7f or (n >= 0x80 and n < 0xa0) {
            out.push_str(f"\\x{hex_digits(n, 2)}");
        } else if n == 0x2028 or n == 0x2029 or n == 0xfeff or (n >= 0xd800 and n < 0xe000) {
            out.push_str(f"\\u{hex_digits(n, 4)}");
        } else {
            out.push(c);
        }
    }
    out
}

fn chs(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn chars_str(s: ref Vec[char], a: i64, b: i64) -> String {
    let mut out = String.new();
    for i in a..b {
        out.push(s[i]);
    }
    out
}

fn slice_from(s: ref String, a: i64) -> String {
    let cs = chs(s);
    if a >= cs.len() { String.new() } else { chars_str(cs, a, cs.len()) }
}

fn char_count(s: ref String) -> i64 {
    let mut n = 0;
    for _ in s.chars() {
        n += 1;
    }
    n
}

fn is_line_break(c: char) -> bool {
    let n = c as i64;
    (n >= 10 and n <= 13) or (n >= 0x1c and n <= 0x1e) or n == 0x85 or n == 0x2028 or n == 0x2029
}

// str.splitlines().
fn py_splitlines(s: ref String) -> Vec[String] {
    let cs = chs(s);
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    let mut i = 0;
    while i < cs.len() {
        let c = cs[i];
        if is_line_break(c) {
            out.push(cur);
            cur = String.new();
            if c == '\r' and i + 1 < cs.len() and cs[i + 1] == '\n' {
                i += 1;
            }
        } else {
            cur.push(c);
        }
        i += 1;
    }
    if cur.len() > 0 {
        out.push(cur);
    }
    out
}

// Iterating a text stream: lines split after each '\n', which they keep.
fn stream_lines(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        cur.push(c);
        if c == '\n' {
            out.push(cur);
            cur = String.new();
        }
    }
    if cur.len() > 0 {
        out.push(cur);
    }
    out
}

// str.split(sep) for a one-character separator: always at least one piece.
fn split_on(s: ref String, sep: char) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

// str.split(sep, maxsplit) for a one-character separator.
fn split_max(s: ref String, sep: char, maxsplit: i64) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep and out.len() < maxsplit {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn join_with(xs: ref Vec[String], sep: ref String) -> String {
    let mut out = String.new();
    for i in 0..xs.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(xs[i]);
    }
    out
}

// str.replace(old, new).
fn replace_all(s: ref String, old: Str, new: Str) -> String {
    let cs = chs(s);
    let o: Vec[char] = old.chars().collect();
    let mut out = String.new();
    let mut i = 0;
    while i < cs.len() {
        let mut hit = i + o.len() <= cs.len();
        if hit {
            for k in 0..o.len() {
                if cs[i + k] != o[k] {
                    hit = false;
                    break;
                }
            }
        }
        if hit {
            out.push_str(new);
            i += o.len();
        } else {
            out.push(cs[i]);
            i += 1;
        }
    }
    out
}

// Python's str.isspace() for one character, which is also what `\s` matches.
fn py_isspace(c: char) -> bool {
    let n = c as i64;
    (n >= 9 and n <= 13) or (n >= 0x1c and n <= 0x20) or n == 0x85 or n == 0xa0 or n == 0x1680
        or (n >= 0x2000 and n <= 0x200a) or n == 0x2028 or n == 0x2029 or n == 0x202f or n == 0x205f
        or n == 0x3000
}

// str.isspace()
fn all_space(s: ref String) -> bool {
    if s.len() == 0 {
        return false;
    }
    for c in s.chars() {
        if not py_isspace(c) {
            return false;
        }
    }
    true
}

fn py_strip(s: ref String) -> String {
    let cs = chs(s);
    let mut a = 0;
    let mut b = cs.len();
    while a < b and py_isspace(cs[a]) {
        a += 1;
    }
    while b > a and py_isspace(cs[b - 1]) {
        b -= 1;
    }
    chars_str(cs, a, b)
}

fn py_lstrip(s: ref String) -> String {
    let cs = chs(s);
    let mut a = 0;
    while a < cs.len() and py_isspace(cs[a]) {
        a += 1;
    }
    chars_str(cs, a, cs.len())
}

// str.strip(chars) for one character.
fn strip_char(s: ref String, ch: char) -> String {
    let cs = chs(s);
    let mut a = 0;
    let mut b = cs.len();
    while a < b and cs[a] == ch {
        a += 1;
    }
    while b > a and cs[b - 1] == ch {
        b -= 1;
    }
    chars_str(cs, a, b)
}

fn lower_ascii(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c >= 'A' and c <= 'Z' {
            out.push(char.try_from(c as u32 + 32).unwrap());
        } else {
            out.push(c);
        }
    }
    out
}

// f'{n:0<w>d}' for n >= 0.
fn zpad(n: i64, w: i64) -> String {
    let mut s = f"{n}";
    while s.len() < w {
        s = f"0{s}";
    }
    s
}

// Python's // and % for ints.
fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

fn floor_mod(a: i64, b: i64) -> i64 {
    a - b * floor_div(a, b)
}

#[derive(Clone)]
struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: ref String) -> Exc {
    Exc { kind: kind.to_string(), msg: msg.clone() }
}

// An ordered str -> V dict, as a list of pairs.
fn kv_get(xs: ref Vec[(String, String)], k: ref String) -> Option[String] {
    for (a, b) in xs {
        if *a == *k {
            return Some(b.clone());
        }
    }
    None
}

fn kv_set(xs: mut ref Vec[(String, String)], k: ref String, v: ref String) {
    for i in 0..xs.len() {
        if xs[i].0 == *k {
            xs[i] = (k.clone(), v.clone());
            return;
        }
    }
    xs.push((k.clone(), v.clone()));
}

// ------------------------------------------------------------ numbers
//
// pysubs2's numeric fields hold int or float depending on where they came
// from (a SubStation file gives floats, a JSON file may give ints), and the
// timing helpers take either. Num keeps that distinction.

#[derive(Clone)]
enum Num {
    I(i64),
    F(f64),
}

const INF: f64 = 1.0 / 0.0;

// repr() of a float.
fn float_repr(x: f64) -> String {
    if x != x {
        "nan".to_string()
    } else if x == INF {
        "inf".to_string()
    } else if x == -INF {
        "-inf".to_string()
    } else {
        f"{x}"
    }
}

fn num_repr(n: ref Num) -> String {
    match n {
        Num.I(i) => f"{i}",
        Num.F(x) => float_repr(x),
    }
}

fn num_f(n: ref Num) -> f64 {
    match n {
        Num.I(i) => i as f64,
        Num.F(x) => x,
    }
}

fn num_eq(a: ref Num, b: ref Num) -> bool {
    match (a, b) {
        (Num.I(x), Num.I(y)) => x == y,
        _ => num_f(a) == num_f(b),
    }
}

fn num_add(a: ref Num, b: ref Num) -> Num {
    match (a, b) {
        (Num.I(x), Num.I(y)) => Num.I(x + y),
        _ => Num.F(num_f(a) + num_f(b)),
    }
}

fn num_mul(a: ref Num, k: i64) -> Num {
    match a {
        Num.I(x) => Num.I(x * k),
        Num.F(x) => Num.F(x * (k as f64)),
    }
}

fn is_integer(x: f64) -> bool {
    x == x and x != INF and x != -INF and x.floor() == x
}

// round() of a float to an int: halves go to the even neighbour.
fn round_even(x: f64) -> i64 {
    let f = x.floor();
    let d = x - f;
    let fi = f as i64;
    if d > 0.5 {
        fi + 1
    } else if d < 0.5 {
        fi
    } else if floor_mod(fi, 2) == 0 {
        fi
    } else {
        fi + 1
    }
}

// int(round(n))
fn num_round(n: ref Num) -> i64 {
    match n {
        Num.I(i) => i,
        Num.F(x) => round_even(x),
    }
}

// The digits of int(s, base) once the sign is gone: single underscores may
// sit between digits.
fn digits_value(cs: ref Vec[char], a: i64, base: i64) -> Option[i64] {
    if a >= cs.len() {
        return None;
    }
    let mut v: i64 = 0;
    let mut prev_digit = false;
    for i in a..cs.len() {
        let c = cs[i];
        if c == '_' {
            if not prev_digit or i + 1 >= cs.len() {
                return None;
            }
            prev_digit = false;
            continue;
        }
        let d = if c >= '0' and c <= '9' {
            c as i64 - 48
        } else if c >= 'a' and c <= 'z' {
            c as i64 - 87
        } else if c >= 'A' and c <= 'Z' {
            c as i64 - 55
        } else {
            return None;
        };
        if d >= base {
            return None;
        }
        v = v * base + d;
        prev_digit = true;
    }
    if prev_digit { Some(v) } else { None }
}

// int(s, base) for base 10 or 16.
fn py_int(s: ref String, base: i64) -> Option[i64] {
    let t = chs(py_strip(s));
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == '+' or t[i] == '-') {
        neg = t[i] == '-';
        i += 1;
    }
    if base == 16 and i + 1 < t.len() and t[i] == '0' and (t[i + 1] == 'x' or t[i + 1] == 'X') {
        i += 2;
        if i < t.len() and t[i] == '_' {
            i += 1;
        }
    }
    match digits_value(t, i, base) {
        Some(v) => Some(if neg { -v } else { v }),
        None => None,
    }
}

fn int_error(s: ref String, base: i64) -> Exc {
    exc("ValueError", f"invalid literal for int() with base {base}: {py_repr_str(s)}")
}

fn is_dig(c: char) -> bool {
    c >= '0' and c <= '9'
}

// A run of digits with single underscores between them, from i; returns
// the end and the digits without underscores, or None.
fn digit_run(t: ref Vec[char], i0: i64, out: mut ref String) -> i64 {
    let mut i = i0;
    while i < t.len() {
        if is_dig(t[i]) {
            out.push(t[i]);
            i += 1;
        } else if t[i] == '_' and i > i0 and is_dig(t[i - 1]) and i + 1 < t.len() and is_dig(t[i + 1]) {
            i += 1;
        } else {
            break;
        }
    }
    i
}

// float(s)
fn py_float(s: ref String) -> Option[f64] {
    let t = chs(py_strip(s));
    let mut i = 0;
    let mut sign = String.new();
    if i < t.len() and (t[i] == '+' or t[i] == '-') {
        if t[i] == '-' {
            sign.push('-');
        }
        i += 1;
    }
    let rest = lower_ascii(chars_str(t, i, t.len()));
    if rest == "inf" or rest == "infinity" {
        return Some(if sign.len() > 0 { -INF } else { INF });
    }
    if rest == "nan" {
        return Some(0.0 / 0.0);
    }
    let mut clean = sign.clone();
    let a = i;
    i = digit_run(t, i, mut clean);
    let int_digits = i > a;
    let mut frac_digits = false;
    if i < t.len() and t[i] == '.' {
        clean.push('.');
        let b = i + 1;
        i = digit_run(t, b, mut clean);
        frac_digits = i > b;
    }
    if not int_digits and not frac_digits {
        return None;
    }
    if i < t.len() and (t[i] == 'e' or t[i] == 'E') {
        clean.push('e');
        i += 1;
        if i < t.len() and (t[i] == '+' or t[i] == '-') {
            clean.push(t[i]);
            i += 1;
        }
        let b = i;
        i = digit_run(t, b, mut clean);
        if i == b {
            return None;
        }
    }
    if i != t.len() {
        return None;
    }
    if not int_digits {
        clean = replace_all(clean, ".", "0.");
    }
    match f64.parse(clean) {
        Ok(x) => Some(x),
        Err(_) => None,
    }
}

// ------------------------------------------------------------ regular expressions
//
// The part of Python's `re` that pysubs2 and argparse use: a backtracking
// matcher with Python's leftmost, priority-ordered semantics, run on code
// points. A pattern compiles to a small program; Split tries its first
// branch before its second, which is what makes `*` greedy. `^` and `$`
// follow Python, with MULTILINE as a flag, and IGNORECASE folds ASCII
// letters (the one pattern that uses it, `V4\+ Styles`, has no others).

// `\w`: str.isalnum() or '_'.
fn is_word(c: char) -> bool {
    let n = c as i64;
    if n < 128 {
        return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_';
    }
    if is_sur(c) {
        return false;
    }
    c.is_alphanumeric()
}

#[derive(Clone)]
struct Cls {
    ranges: Vec[(i64, i64)],
    // \s \S \w \W \d \D inside or as the class
    flags: Vec[char],
    neg: bool,
}

fn flag_has(f: char, c: char) -> bool {
    if f == 's' {
        py_isspace(c)
    } else if f == 'S' {
        not py_isspace(c)
    } else if f == 'w' {
        is_word(c)
    } else if f == 'W' {
        not is_word(c)
    } else if f == 'd' {
        is_dig(c)
    } else {
        not is_dig(c)
    }
}

fn cls_raw(k: ref Cls, c: char) -> bool {
    let n = c as i64;
    for r in k.ranges {
        if n >= r.0 and n <= r.1 {
            return true;
        }
    }
    for f in k.flags {
        if flag_has(*f, c) {
            return true;
        }
    }
    false
}

fn swap_case(c: char) -> char {
    if c >= 'a' and c <= 'z' {
        char.try_from(c as u32 - 32).unwrap()
    } else if c >= 'A' and c <= 'Z' {
        char.try_from(c as u32 + 32).unwrap()
    } else {
        c
    }
}

fn cls_has(k: ref Cls, c: char, icase: bool) -> bool {
    let hit = cls_raw(k, c) or (icase and cls_raw(k, swap_case(c)));
    hit != k.neg
}

#[derive(Clone)]
enum Node {
    Char(Cls),
    Any,
    Bol,
    Eol,
    EndZ,
    Seq(Vec[Node]),
    Alt(Vec[Node]),
    Group(i64, Vec[Node]),
    // body (one node), min, max (-1 for none), greedy
    Rep(Vec[Node], i64, i64, bool),
}

#[derive(Clone)]
enum Inst {
    Char(Cls),
    Any,
    Bol,
    Eol,
    EndZ,
    Split(i64, i64),
    Jmp(i64),
    Save(i64),
    Match,
}

#[derive(Clone)]
struct Re {
    prog: Vec[Inst],
    groups: i64,
    multiline: bool,
    icase: bool,
}

struct ReParser {
    cs: Vec[char],
    pos: i64,
    groups: i64,
}

fn one(c: char) -> Cls {
    let mut r: Vec[(i64, i64)] = Vec.new();
    r.push((c as i64, c as i64));
    Cls { ranges: r, flags: Vec.new(), neg: false }
}

fn flag_cls(f: char) -> Cls {
    let mut fl: Vec[char] = Vec.new();
    fl.push(f);
    Cls { ranges: Vec.new(), flags: fl, neg: false }
}

fn escape_char(c: char) -> char {
    if c == 'n' {
        '\n'
    } else if c == 't' {
        '\t'
    } else {
        c
    }
}

impl ReParser {
    fn peek(ref self) -> Option[char] {
        if self.pos < self.cs.len() { Some(self.cs[self.pos]) } else { None }
    }

    fn at(ref self, k: i64) -> char {
        if self.pos + k < self.cs.len() { self.cs[self.pos + k] } else { '\u{0}' }
    }

    fn eat(mut ref self, c: char) -> bool {
        if self.pos < self.cs.len() and self.cs[self.pos] == c {
            self.pos += 1;
            return true;
        }
        false
    }

    fn alt(mut ref self) -> Node {
        let mut arms: Vec[Node] = Vec.new();
        arms.push(self.seq());
        while self.eat('|') {
            arms.push(self.seq());
        }
        if arms.len() == 1 { arms.remove(0) } else { Node.Alt(arms) }
    }

    fn seq(mut ref self) -> Node {
        let mut items: Vec[Node] = Vec.new();
        loop {
            match self.peek() {
                None => break,
                Some(c) => {
                    if c == '|' or c == ')' {
                        break;
                    }
                }
            }
            let atom = self.atom();
            items.push(self.quantified(atom));
        }
        Node.Seq(items)
    }

    fn number(mut ref self) -> i64 {
        let mut n = -1;
        while self.pos < self.cs.len() and is_dig(self.cs[self.pos]) {
            if n < 0 {
                n = 0;
            }
            n = n * 10 + (self.cs[self.pos] as i64 - 48);
            self.pos += 1;
        }
        n
    }

    // Whether a `{` at the cursor starts a valid {m}, {m,}, {,n} or {m,n}.
    fn brace_quantifier(ref self) -> bool {
        let mut k = 1;
        let mut digits = 0;
        while is_dig(self.at(k)) {
            k += 1;
            digits += 1;
        }
        if self.at(k) == '}' {
            return digits > 0;
        }
        if self.at(k) != ',' {
            return false;
        }
        k += 1;
        while is_dig(self.at(k)) {
            k += 1;
        }
        self.at(k) == '}'
    }

    fn quantified(mut ref self, atom: own Node) -> Node {
        let (lo, hi) = match self.peek() {
            Some('*') => {
                self.pos += 1;
                (0, -1)
            }
            Some('+') => {
                self.pos += 1;
                (1, -1)
            }
            Some('?') => {
                self.pos += 1;
                (0, 1)
            }
            Some('{') => {
                if not self.brace_quantifier() {
                    return atom;
                }
                self.pos += 1;
                let a = self.number();
                let lo = if a < 0 { 0 } else { a };
                let hi = if self.eat(',') { self.number() } else { lo };
                self.eat('}');
                (lo, hi)
            }
            _ => return atom,
        };
        let greedy = not self.eat('?');
        let mut body: Vec[Node] = Vec.new();
        body.push(atom);
        Node.Rep(body, lo, hi, greedy)
    }

    // One class member: a character, or an escape (which may be \s etc.).
    fn class_item(mut ref self, k: mut ref Cls) -> Option[i64] {
        let c = self.cs[self.pos];
        self.pos += 1;
        if c == '\\' {
            let e = self.cs[self.pos];
            self.pos += 1;
            if e == 's' or e == 'S' or e == 'w' or e == 'W' or e == 'd' or e == 'D' {
                k.flags.push(e);
                return None;
            }
            return Some(escape_char(e) as i64);
        }
        Some(c as i64)
    }

    fn class(mut ref self) -> Cls {
        let neg = self.eat('^');
        let mut k = Cls { ranges: Vec.new(), flags: Vec.new(), neg: neg };
        let mut first = true;
        while first or self.cs[self.pos] != ']' {
            first = false;
            match self.class_item(mut k) {
                None => {}
                Some(lo) => {
                    if self.at(0) == '-' and self.at(1) != ']' {
                        self.pos += 1;
                        match self.class_item(mut k) {
                            Some(hi) => k.ranges.push((lo, hi)),
                            None => k.ranges.push((lo, lo)),
                        }
                    } else {
                        k.ranges.push((lo, lo));
                    }
                }
            }
        }
        self.pos += 1;
        k
    }

    fn atom(mut ref self) -> Node {
        let c = self.cs[self.pos];
        self.pos += 1;
        if c == '(' {
            let mut capture = true;
            if self.eat('?') {
                if self.eat('P') {
                    // (?P<name>...): a numbered group; the name is not kept.
                    while not self.eat('>') {
                        self.pos += 1;
                    }
                } else {
                    capture = false;
                    self.eat(':');
                }
            }
            let mut idx = 0;
            if capture {
                self.groups += 1;
                idx = self.groups;
            }
            let inner = self.alt();
            self.eat(')');
            let mut body: Vec[Node] = Vec.new();
            body.push(inner);
            if capture { Node.Group(idx, body) } else { Node.Seq(body) }
        } else if c == '[' {
            Node.Char(self.class())
        } else if c == '.' {
            Node.Any
        } else if c == '^' {
            Node.Bol
        } else if c == '$' {
            Node.Eol
        } else if c == '\\' {
            let e = self.cs[self.pos];
            self.pos += 1;
            if e == 'Z' {
                Node.EndZ
            } else if e == 's' or e == 'S' or e == 'w' or e == 'W' or e == 'd' or e == 'D' {
                Node.Char(flag_cls(e))
            } else {
                Node.Char(one(escape_char(e)))
            }
        } else {
            Node.Char(one(c))
        }
    }
}

fn emit_node(prog: mut ref Vec[Inst], n: ref Node) {
    match n {
        Node.Char(k) => prog.push(Inst.Char(k.clone())),
        Node.Any => prog.push(Inst.Any),
        Node.Bol => prog.push(Inst.Bol),
        Node.Eol => prog.push(Inst.Eol),
        Node.EndZ => prog.push(Inst.EndZ),
        Node.Seq(items) => {
            for x in items {
                emit_node(mut prog, x);
            }
        }
        Node.Alt(arms) => {
            let mut jumps: Vec[i64] = Vec.new();
            for i in 0..arms.len() {
                if i + 1 < arms.len() {
                    let split = prog.len();
                    prog.push(Inst.Split(split + 1, 0));
                    emit_node(mut prog, arms[i]);
                    jumps.push(prog.len());
                    prog.push(Inst.Jmp(0));
                    prog[split] = Inst.Split(split + 1, prog.len());
                } else {
                    emit_node(mut prog, arms[i]);
                }
            }
            let end = prog.len();
            for j in jumps {
                prog[j] = Inst.Jmp(end);
            }
        }
        Node.Group(idx, body) => {
            prog.push(Inst.Save(2 * idx));
            emit_node(mut prog, body[0]);
            prog.push(Inst.Save(2 * idx + 1));
        }
        Node.Rep(body, lo, hi, greedy) => {
            for _ in 0..lo {
                emit_node(mut prog, body[0]);
            }
            if hi < 0 {
                // x*: L: split(body, out); body; jmp L
                let l = prog.len();
                prog.push(Inst.Split(0, 0));
                emit_node(mut prog, body[0]);
                prog.push(Inst.Jmp(l));
                let out = prog.len();
                prog[l] = if greedy { Inst.Split(l + 1, out) } else { Inst.Split(out, l + 1) };
            } else {
                for _ in lo..hi {
                    let l = prog.len();
                    prog.push(Inst.Split(0, 0));
                    emit_node(mut prog, body[0]);
                    let out = prog.len();
                    prog[l] = if greedy { Inst.Split(l + 1, out) } else { Inst.Split(out, l + 1) };
                }
            }
        }
    }
}

fn re_compile_flags(pattern: Str, multiline: bool, icase: bool) -> Re {
    let mut p = ReParser { cs: pattern.chars().collect(), pos: 0, groups: 0 };
    let tree = p.alt();
    let mut prog: Vec[Inst] = Vec.new();
    prog.push(Inst.Save(0));
    emit_node(mut prog, tree);
    prog.push(Inst.Save(1));
    prog.push(Inst.Match);
    Re { prog: prog, groups: p.groups, multiline: multiline, icase: icase }
}

fn re_compile(pattern: Str) -> Re {
    re_compile_flags(pattern, false, false)
}

enum Bt {
    Try(i64, i64),
    Restore(i64, i64),
}

// Runs the program at `pos`; the slots hold the group bounds of the first
// way through that reaches Match (at the end of `s`, when `full`).
fn re_run(re: ref Re, s: ref Vec[char], pos0: i64, full: bool, slots: mut ref Vec[i64]) -> bool {
    let n = s.len();
    let mut stack: Vec[Bt] = Vec.new();
    stack.push(Bt.Try(0, pos0));
    while stack.len() > 0 {
        let mut (pc, pos) = match stack.pop().unwrap() {
            Bt.Restore(k, old) => {
                slots[k] = old;
                continue;
            }
            Bt.Try(pc, pos) => (pc, pos),
        };
        loop {
            match re.prog[pc] {
                Inst.Char(k) => {
                    if pos < n and cls_has(k, s[pos], re.icase) {
                        pc += 1;
                        pos += 1;
                    } else {
                        break;
                    }
                }
                Inst.Any => {
                    if pos < n and s[pos] != '\n' {
                        pc += 1;
                        pos += 1;
                    } else {
                        break;
                    }
                }
                Inst.Bol => {
                    if pos == 0 or (re.multiline and s[pos - 1] == '\n') { pc += 1; } else { break; }
                }
                Inst.Eol => {
                    let ok = pos == n or (pos == n - 1 and s[pos] == '\n') or (re.multiline and s[pos] == '\n');
                    if ok { pc += 1; } else { break; }
                }
                Inst.EndZ => {
                    if pos == n { pc += 1; } else { break; }
                }
                Inst.Split(a, b) => {
                    stack.push(Bt.Try(b, pos));
                    pc = a;
                }
                Inst.Jmp(a) => pc = a,
                Inst.Save(k) => {
                    stack.push(Bt.Restore(k, slots[k]));
                    slots[k] = pos;
                    pc += 1;
                }
                Inst.Match => {
                    if full and pos != n {
                        break;
                    }
                    return true;
                }
            }
        }
    }
    false
}

fn new_slots(re: ref Re) -> Vec[i64] {
    let mut slots: Vec[i64] = Vec.new();
    for _ in 0..(2 * re.groups + 2) {
        slots.push(-1);
    }
    slots
}

// re.match at `pos`: the group bounds (-1 for a group that took no part),
// or None.
fn re_match_at(re: ref Re, s: ref Vec[char], pos: i64) -> Option[Vec[i64]] {
    let mut slots = new_slots(re);
    if re_run(re, s, pos, false, mut slots) { Some(slots) } else { None }
}

fn re_search_at(re: ref Re, s: ref Vec[char], from: i64) -> Option[Vec[i64]] {
    let mut pos = from;
    while pos <= s.len() {
        if let Some(m) = re_match_at(re, s, pos) {
            return Some(m);
        }
        pos += 1;
    }
    None
}

// The groups of a match as str, '' for a group that took no part (which
// is what findall gives), with group 0 first.
fn groups_of(re: ref Re, s: ref Vec[char], m: ref Vec[i64]) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for g in 0..(re.groups + 1) {
        if m[2 * g] < 0 {
            out.push(String.new());
        } else {
            out.push(chars_str(s, m[2 * g], m[2 * g + 1]));
        }
    }
    out
}

fn re_match(re: ref Re, text: ref String) -> Option[Vec[String]] {
    let s = chs(text);
    match re_match_at(re, s, 0) {
        None => None,
        Some(m) => Some(groups_of(re, s, m)),
    }
}

fn re_fullmatch(re: ref Re, text: ref String) -> Option[Vec[String]] {
    let s = chs(text);
    let mut slots = new_slots(re);
    if re_run(re, s, 0, true, mut slots) { Some(groups_of(re, s, slots)) } else { None }
}

fn re_search(re: ref Re, text: ref String) -> Option[Vec[String]] {
    let s = chs(text);
    match re_search_at(re, s, 0) {
        None => None,
        Some(m) => Some(groups_of(re, s, m)),
    }
}

fn re_found(re: ref Re, text: ref String) -> bool {
    re_search(re, text).is_some()
}

// re.finditer: the slots of each non-overlapping match.
fn re_iter(re: ref Re, s: ref Vec[char]) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut pos = 0;
    while pos <= s.len() {
        match re_search_at(re, s, pos) {
            None => break,
            Some(m) => {
                pos = if m[1] == m[0] { m[1] + 1 } else { m[1] };
                out.push(m);
            }
        }
    }
    out
}

// re.findall: per match, its groups (or the whole match when there are none).
fn re_findall(re: ref Re, text: ref String) -> Vec[Vec[String]] {
    let s = chs(text);
    let mut out: Vec[Vec[String]] = Vec.new();
    for m in re_iter(re, s) {
        let g = groups_of(re, s, m);
        if re.groups == 0 {
            out.push(g);
        } else {
            let mut t: Vec[String] = Vec.new();
            for i in 1..g.len() {
                t.push(g[i].clone());
            }
            out.push(t);
        }
    }
    out
}

fn re_count(re: ref Re, text: ref String) -> i64 {
    re_iter(re, chs(text)).len()
}

// A replacement template: \1..\9 are groups, \\ a backslash, \n a newline.
fn expand(tpl: Str, g: ref Vec[String]) -> String {
    let t: Vec[char] = tpl.chars().collect();
    let mut out = String.new();
    let mut i = 0;
    while i < t.len() {
        if t[i] == '\\' and i + 1 < t.len() {
            let c = t[i + 1];
            if is_dig(c) {
                out.push_str(g[c as i64 - 48]);
            } else if c == 'n' {
                out.push('\n');
            } else {
                out.push(c);
            }
            i += 2;
        } else {
            out.push(t[i]);
            i += 1;
        }
    }
    out
}

fn re_sub(re: ref Re, tpl: Str, text: ref String) -> String {
    let s = chs(text);
    let mut out = String.new();
    let mut last = 0;
    for m in re_iter(re, s) {
        out.push_str(chars_str(s, last, m[0]));
        out.push_str(expand(tpl, groups_of(re, s, m)));
        last = m[1];
    }
    out.push_str(chars_str(s, last, s.len()));
    out
}

// re.split for a pattern without groups.
fn re_split(re: ref Re, text: ref String) -> Vec[String] {
    let s = chs(text);
    let mut out: Vec[String] = Vec.new();
    let mut last = 0;
    for m in re_iter(re, s) {
        out.push(chars_str(s, last, m[0]));
        last = m[1];
    }
    out.push(chars_str(s, last, s.len()));
    out
}

// The patterns, compiled once.
struct Pats {
    timestamp: Re,
    timestamp_short: Re,
    override_seq: Re,
    override_tag: Re,
    section_heading: Re,
    attachment: Re,
    v4plus: Re,
    v4: Re,
    blank_line: Re,
    number_line: Re,
    trailing_number: Re,
    srt_tags: Vec[(Re, Str)],
    html_tag: Re,
    newline: Re,
    newlines: Re,
    vtt_timestamp: Re,
    microdvd_line: Re,
    word: Re,
    md_style: Re,
    md_font: Re,
    md_size: Re,
    md_pos: Re,
    mpl2: Re,
    tmp_line: Re,
    tmp_u: Re,
    whisper_ts: Re,
    whisper_line: Re,
    cli_time: Re,
    negative_number: Re,
}

fn srt_tag_pats() -> Vec[(Re, Str)] {
    let mut v: Vec[(Re, Str)] = Vec.new();
    v.push((re_compile("< *i *>"), "{\\\\i1}"));
    v.push((re_compile("< */ *i *>"), "{\\\\i0}"));
    v.push((re_compile("< *s *>"), "{\\\\s1}"));
    v.push((re_compile("< */ *s *>"), "{\\\\s0}"));
    v.push((re_compile("< *u *>"), "{\\\\u1}"));
    v.push((re_compile("< */ *u *>"), "{\\\\u0}"));
    v.push((re_compile("< *b *>"), "{\\\\b1}"));
    v.push((re_compile("< */ *b *>"), "{\\\\b0}"));
    v
}

fn patterns() -> Pats {
    Pats {
        timestamp: re_compile("(\\d{1,2}):(\\d{1,2}):(\\d{1,2})[.,](\\d{1,3})"),
        timestamp_short: re_compile("(\\d{1,2}):(\\d{2}):(\\d{2})"),
        override_seq: re_compile("{[^}]*}"),
        override_tag: re_compile("\\\\[ibusp][0-9]|\\\\r[a-zA-Z_0-9 ]*|\\\\fn[a-zA-Z_0-9 ]+"),
        section_heading: re_compile("^.{,3}\\[[^]]*[a-z][^]]*]"),
        attachment: re_compile("(fontname|filename):\\s+(?P<name>\\S+)"),
        v4plus: re_compile_flags("V4\\+ Styles", false, true),
        v4: re_compile_flags("V4 Styles", false, true),
        blank_line: re_compile("\\s*$"),
        number_line: re_compile("\\s*\\d+\\s*$"),
        trailing_number: re_compile("\\n+ *\\d+ *$"),
        srt_tags: srt_tag_pats(),
        html_tag: re_compile("< */? *[a-zA-Z][^>]*>"),
        newline: re_compile("\\n"),
        newlines: re_compile("\n+"),
        vtt_timestamp: re_compile("(\\d{0,4}:)?(\\d{2}):(\\d{2})\\.(\\d{2,3})"),
        microdvd_line: re_compile(" *\\{ *(\\d+) *} *\\{ *(\\d+) *}(.+)"),
        word: re_compile("\\w"),
        md_style: re_compile("\\{[Yy]:[^}]+}"),
        md_font: re_compile("\\{[Ff]:([^}]+)}"),
        md_size: re_compile("\\{[Ss]:([^}]+)}"),
        md_pos: re_compile("\\{P:(\\d+),(\\d+)}"),
        mpl2: re_compile_flags("^\\[(-?\\d+)\\]\\[(-?\\d+)\\](.*)", true, false),
        tmp_line: re_compile("(\\d{1,2}:\\d{2}:\\d{2}):(.+)"),
        tmp_u: re_compile("< *u *>"),
        whisper_ts: re_compile("(?:(\\d{1,2}):)?(\\d{2}):(\\d{2})[.](\\d{3})"),
        whisper_line: re_compile("\\[([^]]+) -> ([^]]+)] (.*)"),
        cli_time: re_compile("(\\d*\\.?\\d*)(ms|m|s|h)"),
        negative_number: re_compile("^-\\d+$|^-\\d*\\.\\d+$"),
    }
}

// ------------------------------------------------------------ codecs
//
// The codecs the jobs name, with Python's error messages and positions.
// Decoding applies the errors handler (strict or surrogateescape), then a
// text-mode file's universal newlines. Encoding works on one write() at a
// time, as TextIOWrapper does: an error reports a position within that
// piece, and the pieces before it stay in the file.

#[derive(Clone)]
enum Codec {
    U8,
    U8Sig,
    Ascii,
    L1,
    Cp1252,
    U16,
}

// encodings.normalize_encoding, after Python's lower-casing.
fn norm_encoding(name: ref String) -> String {
    let mut out = String.new();
    let mut pending = false;
    for c in lower_ascii(name).chars() {
        let alnum = (c >= 'a' and c <= 'z') or is_dig(c) or c == '.';
        if alnum {
            if pending and out.len() > 0 {
                out.push('_');
            }
            pending = false;
            out.push(c);
        } else {
            pending = true;
        }
    }
    out
}

fn codec_lookup(name: ref String) -> Result[Codec, Exc] {
    let k = norm_encoding(name);
    let utf8: Vec[Str] = vec!["utf_8", "utf8", "u8", "utf", "cp65001"];
    let utf8sig: Vec[Str] = vec!["utf_8_sig"];
    let ascii: Vec[Str] = vec!["ascii", "us_ascii", "646", "ansi_x3.4_1968", "cp367", "us"];
    let latin1: Vec[Str] = vec!["latin_1", "latin1", "latin", "l1", "iso8859_1", "iso_8859_1", "8859", "cp819", "iso_ir_100"];
    let cp1252: Vec[Str] = vec!["cp1252", "windows_1252", "1252"];
    let utf16: Vec[Str] = vec!["utf_16", "utf16", "u16"];
    for x in utf8 {
        if k == *x {
            return Ok(Codec.U8);
        }
    }
    for x in utf8sig {
        if k == *x {
            return Ok(Codec.U8Sig);
        }
    }
    for x in ascii {
        if k == *x {
            return Ok(Codec.Ascii);
        }
    }
    for x in latin1 {
        if k == *x {
            return Ok(Codec.L1);
        }
    }
    for x in cp1252 {
        if k == *x {
            return Ok(Codec.Cp1252);
        }
    }
    for x in utf16 {
        if k == *x {
            return Ok(Codec.U16);
        }
    }
    Err(exc("LookupError", f"unknown encoding: {name}"))
}

fn decode_err(codec: Str, a: i64, b: i64, bytes: ref Vec[u8], reason: Str) -> Exc {
    if b == a {
        exc("UnicodeDecodeError", f"'{codec}' codec can't decode byte 0x{hex_digits(bytes[a] as i64, 2)} in position {a}: {reason}")
    } else {
        exc("UnicodeDecodeError", f"'{codec}' codec can't decode bytes in position {a}-{b}: {reason}")
    }
}

fn push_cp(out: mut ref String, cp: i64) {
    out.push(char.try_from(cp as u32).unwrap());
}

// The bytes [a, b) a decoder could not read: an error, or with
// surrogateescape one surrogate per byte.
fn bad_bytes(out: mut ref String, b: ref Vec[u8], a: i64, e: i64, se: bool, codec: Str, reason: Str) -> Result[(), Exc] {
    if not se {
        return Err(decode_err(codec, a, e - 1, b, reason));
    }
    for i in a..e {
        out.push(sur(0xdc00 + b[i] as i64));
    }
    Ok(())
}

fn utf8_decode(b: ref Vec[u8], start: i64, se: bool) -> Result[String, Exc] {
    let n = b.len();
    let mut out = String.new();
    let mut i = start;
    while i < n {
        let x = b[i] as i64;
        if x < 0x80 {
            push_cp(mut out, x);
            i += 1;
            continue;
        }
        let (need, lo, hi) = if x >= 0xc2 and x <= 0xdf {
            (1, 0x80, 0xbf)
        } else if x == 0xe0 {
            (2, 0xa0, 0xbf)
        } else if x == 0xed {
            (2, 0x80, 0x9f)
        } else if x >= 0xe1 and x <= 0xef {
            (2, 0x80, 0xbf)
        } else if x == 0xf0 {
            (3, 0x90, 0xbf)
        } else if x == 0xf4 {
            (3, 0x80, 0x8f)
        } else if x >= 0xf1 and x <= 0xf3 {
            (3, 0x80, 0xbf)
        } else {
            bad_bytes(mut out, b, i, i + 1, se, "utf-8", "invalid start byte")?;
            i += 1;
            continue;
        };
        let mut good = need + 1;
        let mut reason = "";
        for k in 1..(need + 1) {
            if i + k >= n {
                good = k;
                reason = "unexpected end of data";
                break;
            }
            let y = b[i + k] as i64;
            let (l, h) = if k == 1 { (lo, hi) } else { (0x80, 0xbf) };
            if y < l or y > h {
                good = k;
                reason = "invalid continuation byte";
                break;
            }
        }
        if good <= need {
            bad_bytes(mut out, b, i, i + good, se, "utf-8", reason)?;
            i += good;
            continue;
        }
        let mut cp = if need == 1 { x & 0x1f } else if need == 2 { x & 0x0f } else { x & 0x07 };
        for k in 1..(need + 1) {
            cp = cp * 64 + (b[i + k] as i64 & 0x3f);
        }
        push_cp(mut out, cp);
        i += need + 1;
    }
    Ok(out)
}

// The cp1252 characters of bytes 0x80..0x9f; 0 where the byte is undefined.
fn cp1252_high() -> Vec[i64] {
    vec![0x20ac, 0, 0x201a, 0x0192, 0x201e, 0x2026, 0x2020, 0x2021, 0x02c6, 0x2030, 0x0160, 0x2039, 0x0152, 0, 0x017d, 0,
         0, 0x2018, 0x2019, 0x201c, 0x201d, 0x2022, 0x2013, 0x2014, 0x02dc, 0x2122, 0x0161, 0x203a, 0x0153, 0, 0x017e, 0x0178]
}

fn decode(codec: ref Codec, b: ref Vec[u8], se: bool) -> Result[String, Exc] {
    match codec {
        Codec.U8 => utf8_decode(b, 0, se),
        Codec.U8Sig => {
            let skip = if b.len() >= 3 and b[0] == 0xef and b[1] == 0xbb and b[2] == 0xbf { 3 } else { 0 };
            utf8_decode(b, skip, se)
        }
        Codec.L1 => {
            let mut out = String.new();
            for x in b {
                push_cp(mut out, *x as i64);
            }
            Ok(out)
        }
        Codec.Ascii => {
            let mut out = String.new();
            for i in 0..b.len() {
                if b[i] < 0x80 {
                    push_cp(mut out, b[i] as i64);
                } else {
                    bad_bytes(mut out, b, i, i + 1, se, "ascii", "ordinal not in range(128)")?;
                }
            }
            Ok(out)
        }
        Codec.Cp1252 => {
            let high = cp1252_high();
            let mut out = String.new();
            for i in 0..b.len() {
                let x = b[i] as i64;
                if x >= 0x80 and x < 0xa0 {
                    if high[x - 0x80] == 0 {
                        bad_bytes(mut out, b, i, i + 1, se, "charmap", "character maps to <undefined>")?;
                    } else {
                        push_cp(mut out, high[x - 0x80]);
                    }
                } else {
                    push_cp(mut out, x);
                }
            }
            Ok(out)
        }
        Codec.U16 => {
            let mut le = true;
            let mut i = 0;
            if b.len() >= 2 and b[0] == 0xff and b[1] == 0xfe {
                i = 2;
            } else if b.len() >= 2 and b[0] == 0xfe and b[1] == 0xff {
                le = false;
                i = 2;
            }
            let mut out = String.new();
            while i < b.len() {
                if i + 1 >= b.len() {
                    return Err(decode_err("utf-16-le", i, i, b, "truncated data"));
                }
                let u = if le { b[i] as i64 + 256 * (b[i + 1] as i64) } else { 256 * (b[i] as i64) + b[i + 1] as i64 };
                if u >= 0xd800 and u <= 0xdbff and i + 3 < b.len() {
                    let v = if le { b[i + 2] as i64 + 256 * (b[i + 3] as i64) } else { 256 * (b[i + 2] as i64) + b[i + 3] as i64 };
                    if v >= 0xdc00 and v <= 0xdfff {
                        push_cp(mut out, 0x10000 + (u - 0xd800) * 1024 + (v - 0xdc00));
                        i += 4;
                        continue;
                    }
                }
                if u >= 0xd800 and u <= 0xdfff {
                    return Err(decode_err("utf-16-le", i, i + 1, b, "illegal encoding"));
                }
                push_cp(mut out, u);
                i += 2;
            }
            Ok(out)
        }
    }
}

// Universal newlines: \r\n and \r become \n.
fn universal(text: ref String) -> String {
    let cs = chs(text);
    let mut t = String.new();
    let mut i = 0;
    while i < cs.len() {
        if cs[i] == '\r' {
            t.push('\n');
            if i + 1 < cs.len() and cs[i + 1] == '\n' {
                i += 1;
            }
        } else {
            t.push(cs[i]);
        }
        i += 1;
    }
    t
}

fn push_unit(out: mut ref Vec[u8], u: i64) {
    out.push((u % 256) as u8);
    out.push((u / 256) as u8);
}

fn codec_label(codec: ref Codec) -> Str {
    match codec {
        Codec.U8 => "utf-8",
        Codec.U8Sig => "utf-8",
        Codec.Ascii => "ascii",
        Codec.L1 => "latin-1",
        Codec.Cp1252 => "charmap",
        Codec.U16 => "utf-16",
    }
}

// The bytes of one character, or None if the codec cannot encode it.
fn encode_char(codec: ref Codec, c: char, out: mut ref Vec[u8]) -> bool {
    let n = c as i64;
    if is_sur(c) {
        return false;
    }
    match codec {
        Codec.U8 => {
            let mut buf = String.new();
            buf.push(c);
            for x in buf.bytes() {
                out.push(x);
            }
            true
        }
        Codec.U8Sig => {
            let mut buf = String.new();
            buf.push(c);
            for x in buf.bytes() {
                out.push(x);
            }
            true
        }
        Codec.Ascii => {
            if n < 128 {
                out.push(n as u8);
            }
            n < 128
        }
        Codec.L1 => {
            if n < 256 {
                out.push(n as u8);
            }
            n < 256
        }
        Codec.Cp1252 => {
            if n < 0x80 or (n >= 0xa0 and n < 0x100) {
                out.push(n as u8);
                return true;
            }
            let high = cp1252_high();
            for k in 0..32 {
                if high[k] == n {
                    out.push((0x80 + k) as u8);
                    return true;
                }
            }
            false
        }
        Codec.U16 => {
            if n >= 0x10000 {
                let v = n - 0x10000;
                push_unit(mut out, 0xd800 + v / 1024);
                push_unit(mut out, 0xdc00 + v % 1024);
            } else {
                push_unit(mut out, n);
            }
            true
        }
    }
}

fn encode_reason(codec: ref Codec) -> Str {
    match codec {
        Codec.Ascii => "ordinal not in range(128)",
        Codec.L1 => "ordinal not in range(256)",
        Codec.Cp1252 => "character maps to <undefined>",
        _ => "surrogates not allowed",
    }
}

fn encode_err(codec: ref Codec, cs: ref Vec[char], a: i64, b: i64) -> Exc {
    let name = codec_label(codec);
    let reason = encode_reason(codec);
    if b == a + 1 {
        exc("UnicodeEncodeError", f"'{name}' codec can't encode character '{char_esc(py_cp(cs[a]))}' in position {a}: {reason}")
    } else {
        exc("UnicodeEncodeError", f"'{name}' codec can't encode characters in position {a}-{b - 1}: {reason}")
    }
}

fn escapable(c: char) -> bool {
    is_sur(c) and py_cp(c) >= 0xdc80 and py_cp(c) <= 0xdcff
}

// One write(): the piece encoded onto `out`. The codecs gather a run of
// characters they cannot encode and pass it to the error handler;
// surrogateescape turns the escaped bytes of the run back into bytes and
// fails from the first character that is not one.
fn encode_piece(codec: ref Codec, piece: ref String, se: bool, out: mut ref Vec[u8]) -> Result[(), Exc] {
    let cs = chs(piece);
    let mut i = 0;
    while i < cs.len() {
        if encode_char(codec, cs[i], mut out) {
            i += 1;
            continue;
        }
        let mut j = i;
        let mut scratch: Vec[u8] = Vec.new();
        while j < cs.len() and not encode_char(codec, cs[j], mut scratch) {
            j += 1;
        }
        let charmap = match codec {
            Codec.Cp1252 => true,
            _ => false,
        };
        let utf8 = match codec {
            Codec.U8 => true,
            Codec.U8Sig => true,
            _ => false,
        };
        if utf8 {
            // The UTF-8 encoder's run holds only surrogates.
            j = i;
            while j < cs.len() and is_sur(cs[j]) {
                j += 1;
            }
            if j == i {
                j = i + 1;
            }
        }
        let utf16 = match codec {
            Codec.U16 => true,
            _ => false,
        };
        let mut a = i;
        if se and not utf16 {
            if charmap {
                let mut all = true;
                for k in i..j {
                    if not escapable(cs[k]) {
                        all = false;
                    }
                }
                if all {
                    for k in i..j {
                        out.push((py_cp(cs[k]) - 0xdc00) as u8);
                    }
                    i = j;
                    continue;
                }
            } else {
                while a < j and escapable(cs[a]) {
                    out.push((py_cp(cs[a]) - 0xdc00) as u8);
                    a += 1;
                }
                if a == j {
                    i = j;
                    continue;
                }
            }
        }
        return Err(encode_err(codec, cs, a, j));
    }
    Ok(())
}

// ------------------------------------------------------------ the file system

struct World {
    out: String,
    warns: Vec[String],
    files: Map[String, Vec[u8]],
    dirs: Map[String, bool],
}

fn emit(w: mut ref World, s: ref String) {
    w.out.push_str(s);
    w.out.push('\n');
}

fn warn(w: mut ref World, category: Str, msg: ref String) {
    w.warns.push(f"{category}: {msg}");
}

// An absolute, normalized path, the cwd being /work.
fn norm_path(path: ref String) -> String {
    let full = if path.starts_with("/") { path.clone() } else { f"/work/{path}" };
    let mut parts: Vec[String] = Vec.new();
    for x in split_on(full, '/') {
        if x.len() == 0 or x == "." {
            continue;
        }
        if x == ".." {
            if parts.len() > 0 {
                parts.pop();
            }
            continue;
        }
        parts.push(x.clone());
    }
    let mut out = String.new();
    for x in parts {
        out.push('/');
        out.push_str(x);
    }
    if out.len() == 0 { "/".to_string() } else { out }
}

fn parent_of(abs: ref String) -> String {
    let cs = chs(abs);
    let mut i = cs.len() - 1;
    while i > 0 and cs[i] != '/' {
        i -= 1;
    }
    if i == 0 { "/".to_string() } else { chars_str(cs, 0, i) }
}

fn is_dir(w: ref World, path: ref String) -> bool {
    w.dirs.contains_key(norm_path(path))
}

fn is_file(w: ref World, path: ref String) -> bool {
    w.files.contains_key(norm_path(path))
}

fn exists(w: ref World, path: ref String) -> bool {
    is_dir(w, path) or is_file(w, path)
}

fn errno(kind: Str, num: i64, text: Str, path: ref String) -> Exc {
    exc(kind, f"[Errno {num}] {text}: {py_repr_str(path)}")
}

// open(path, 'rb').read()
fn fs_read(w: ref World, path: ref String) -> Result[Vec[u8], Exc] {
    let abs = norm_path(path);
    if w.dirs.contains_key(abs) {
        return Err(errno("IsADirectoryError", 21, "Is a directory", path));
    }
    match w.files.get(abs) {
        Some(b) => Ok(b.clone()),
        None => Err(errno("FileNotFoundError", 2, "No such file or directory", path)),
    }
}

// open(path, 'w'): creates or truncates the file.
fn fs_create(w: mut ref World, path: ref String) -> Result[(), Exc] {
    let abs = norm_path(path);
    if w.dirs.contains_key(abs) {
        return Err(errno("IsADirectoryError", 21, "Is a directory", path));
    }
    let parent = parent_of(abs);
    if w.files.contains_key(parent) {
        return Err(errno("NotADirectoryError", 20, "Not a directory", path));
    }
    if not w.dirs.contains_key(parent) {
        return Err(errno("FileNotFoundError", 2, "No such file or directory", path));
    }
    w.files.insert(abs, Vec.new());
    Ok(())
}

fn fs_put(w: mut ref World, path: ref String, data: own Vec[u8]) {
    w.files.insert(norm_path(path), data);
}

// Path.mkdir(parents=True), for a path that does not exist.
fn fs_makedirs(w: mut ref World, path: ref String) {
    let abs = norm_path(path);
    let mut cur = String.new();
    for x in split_on(abs, '/') {
        if x.len() == 0 {
            continue;
        }
        cur.push('/');
        cur.push_str(x);
        w.dirs.insert(cur.clone(), true);
    }
}

// str(pathlib.Path(p))
fn path_str(p: ref String) -> String {
    let mut parts: Vec[String] = Vec.new();
    for x in split_on(p, '/') {
        if x.len() > 0 and x != "." {
            parts.push(x.clone());
        }
    }
    let mut out = if p.starts_with("/") { "/".to_string() } else { String.new() };
    for i in 0..parts.len() {
        if i > 0 {
            out.push('/');
        }
        out.push_str(parts[i]);
    }
    if out.len() == 0 { ".".to_string() } else { out }
}

// Path.name
fn path_name(p: ref String) -> String {
    let parts = split_on(path_str(p), '/');
    let last = parts[parts.len() - 1].clone();
    if last == "." { String.new() } else { last }
}

// Path.suffix
fn path_suffix(p: ref String) -> String {
    let cs = chs(path_name(p));
    let mut dot = -1;
    for i in 0..cs.len() {
        if cs[i] == '.' {
            dot = i;
        }
    }
    if dot <= 0 or dot == cs.len() - 1 { String.new() } else { chars_str(cs, dot, cs.len()) }
}

// Path.with_suffix(ext)
fn path_with_suffix(p: ref String, ext: ref String) -> String {
    let s = path_str(p);
    let name = path_name(p);
    let suffix = path_suffix(p);
    let cs = chs(name);
    let stem = chars_str(cs, 0, cs.len() - char_count(suffix));
    let sc = chs(s);
    let dir = chars_str(sc, 0, sc.len() - cs.len());
    f"{dir}{stem}{ext}"
}

// a / b for Paths
fn path_join(a: ref String, b: ref String) -> String {
    let x = path_str(a);
    if x == "." { path_str(b) } else { path_str(f"{x}/{b}") }
}

// ------------------------------------------------------------ time.py

fn times_to_ms(h: ref Num, m: ref Num, s: ref Num, ms: ref Num) -> i64 {
    let mut t = num_add(ms, num_mul(s, 1000));
    t = num_add(t, num_mul(m, 60000));
    t = num_add(t, num_mul(h, 3600000));
    num_round(t)
}

fn bad_fps(fps: ref Num) -> Exc {
    exc("ValueError", f"Framerate must be a positive number ({num_repr(fps)}).")
}

fn frames_to_ms(frames: i64, fps: ref Num) -> Result[i64, Exc] {
    if num_f(fps) <= 0.0 {
        return Err(bad_fps(fps));
    }
    Ok(round_even((frames as f64) * (1000.0 / num_f(fps))))
}

fn ms_to_frames(ms: i64, fps: ref Num) -> Result[i64, Exc] {
    if num_f(fps) <= 0.0 {
        return Err(bad_fps(fps));
    }
    Ok(round_even((ms as f64) / 1000.0 * num_f(fps)))
}

#[derive(Clone)]
struct TimeArgs {
    h: Num,
    m: Num,
    s: Num,
    ms: Num,
    frames: Option[i64],
    fps: Option[Num],
}

fn time_args() -> TimeArgs {
    TimeArgs { h: Num.I(0), m: Num.I(0), s: Num.I(0), ms: Num.I(0), frames: None, fps: None }
}

fn make_time(t: ref TimeArgs) -> Result[i64, Exc] {
    match (t.frames, t.fps.clone()) {
        (None, None) => Ok(times_to_ms(t.h, t.m, t.s, t.ms)),
        (Some(f), Some(fps)) => frames_to_ms(f, fps),
        _ => Err(exc("ValueError", "Both fps and frames must be specified".to_string())),
    }
}

// timestamp_to_ms(m.groups()) for 3 or 4 digit groups.
fn timestamp_to_ms(groups: ref Vec[String]) -> i64 {
    let h = py_int(groups[0], 10).unwrap();
    let m = py_int(groups[1], 10).unwrap();
    let s = py_int(groups[2], 10).unwrap();
    let mut ms = 0;
    if groups.len() == 4 {
        let frac = py_int(groups[3], 10).unwrap();
        let mut scale = 1;
        for _ in 0..(3 - char_count(groups[3])) {
            scale *= 10;
        }
        ms = frac * scale;
    }
    ms + s * 1000 + m * 60000 + h * 3600000
}

// The groups of a match without group 0.
fn tail(g: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for i in 1..g.len() {
        out.push(g[i].clone());
    }
    out
}

fn ms_to_times(ms: ref Num) -> (i64, i64, i64, i64) {
    let t = num_round(ms);
    let h = floor_div(t, 3600000);
    let r1 = floor_mod(t, 3600000);
    let m = floor_div(r1, 60000);
    let r2 = floor_mod(r1, 60000);
    (h, m, floor_div(r2, 1000), floor_mod(r2, 1000))
}

fn num_abs(n: ref Num) -> Num {
    match n {
        Num.I(i) => Num.I(if i < 0 { -i } else { i }),
        Num.F(x) => Num.F(if x < 0.0 { -x } else { x }),
    }
}

fn ms_to_str_num(ms: ref Num, fractions: bool) -> String {
    let sgn = if num_f(ms) < 0.0 { "-" } else { "" };
    let (h, m, s, r) = ms_to_times(num_abs(ms));
    if fractions {
        f"{sgn}{h}:{zpad(m, 2)}:{zpad(s, 2)}.{zpad(r, 3)}"
    } else {
        f"{sgn}{h}:{zpad(m, 2)}:{zpad(s, 2)}"
    }
}

fn ms_to_str(ms: i64) -> String {
    ms_to_str_num(Num.I(ms), false)
}

// ------------------------------------------------------------ the model

#[derive(Clone)]
struct Color {
    r: i64,
    g: i64,
    b: i64,
    a: i64,
}

fn rgba(r: i64, g: i64, b: i64, a: i64) -> Color {
    Color { r: r, g: g, b: b, a: a }
}

fn color_repr(c: ref Color) -> String {
    f"Color(r={c.r}, g={c.g}, b={c.b}, a={c.a})"
}

fn color_eq(x: ref Color, y: ref Color) -> bool {
    x.r == y.r and x.g == y.g and x.b == y.b and x.a == y.a
}

// An Alignment member, or the plain int a JSON file leaves there.
#[derive(Clone)]
enum Align {
    E(i64),
    P(i64),
}

fn align_value(a: ref Align) -> i64 {
    match a {
        Align.E(n) => n,
        Align.P(n) => n,
    }
}

fn align_names() -> Vec[Str] {
    vec!["BOTTOM_LEFT", "BOTTOM_CENTER", "BOTTOM_RIGHT", "MIDDLE_LEFT", "MIDDLE_CENTER", "MIDDLE_RIGHT",
         "TOP_LEFT", "TOP_CENTER", "TOP_RIGHT"]
}

fn align_repr(a: ref Align) -> String {
    match a {
        Align.E(n) => f"<Alignment.{align_names()[n - 1]}: {n}>",
        Align.P(n) => f"{n}",
    }
}

fn ssa_alignment() -> Vec[i64] {
    vec![1, 2, 3, 9, 10, 11, 5, 6, 7]
}

// Alignment(n)
fn alignment_of(n: i64) -> Result[Align, Exc] {
    if n >= 1 and n <= 9 {
        Ok(Align.E(n))
    } else {
        Err(exc("ValueError", f"{n} is not a valid Alignment"))
    }
}

fn from_ssa_alignment(n: i64) -> Result[Align, Exc] {
    let t = ssa_alignment();
    for i in 0..t.len() {
        if t[i] == n {
            return Ok(Align.E(i + 1));
        }
    }
    Err(exc("ValueError", "tuple.index(x): x not in tuple".to_string()))
}

fn to_ssa_alignment(n: i64) -> i64 {
    ssa_alignment()[n - 1]
}

#[derive(Clone)]
struct Style {
    fontname: String,
    fontsize: Num,
    primarycolor: Color,
    secondarycolor: Color,
    tertiarycolor: Color,
    outlinecolor: Color,
    backcolor: Color,
    bold: bool,
    italic: bool,
    underline: bool,
    strikeout: bool,
    scalex: Num,
    scaley: Num,
    spacing: Num,
    angle: Num,
    borderstyle: i64,
    outline: Num,
    shadow: Num,
    alignment: Align,
    marginl: i64,
    marginr: i64,
    marginv: i64,
    alphalevel: i64,
    encoding: i64,
    drawing: bool,
}

fn default_style() -> Style {
    Style {
        fontname: "Arial".to_string(),
        fontsize: Num.F(20.0),
        primarycolor: rgba(255, 255, 255, 0),
        secondarycolor: rgba(255, 0, 0, 0),
        tertiarycolor: rgba(0, 0, 0, 0),
        outlinecolor: rgba(0, 0, 0, 0),
        backcolor: rgba(0, 0, 0, 0),
        bold: false,
        italic: false,
        underline: false,
        strikeout: false,
        scalex: Num.F(100.0),
        scaley: Num.F(100.0),
        spacing: Num.F(0.0),
        angle: Num.F(0.0),
        borderstyle: 1,
        outline: Num.F(2.0),
        shadow: Num.F(2.0),
        alignment: Align.E(2),
        marginl: 10,
        marginr: 10,
        marginv: 10,
        alphalevel: 0,
        encoding: 1,
        drawing: false,
    }
}

fn style_repr(s: ref Style) -> String {
    let b = if s.bold { " bold" } else { "" };
    let i = if s.italic { " italic" } else { "" };
    f"<SSAStyle {num_repr(s.fontsize)}px{b}{i} {py_repr_str(s.fontname)}>"
}

// The fields of SSAStyle in their order, each as `name=repr`.
fn style_fields(s: ref Style) -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    v.push(f"fontname={py_repr_str(s.fontname)}");
    v.push(f"fontsize={num_repr(s.fontsize)}");
    v.push(f"primarycolor={color_repr(s.primarycolor)}");
    v.push(f"secondarycolor={color_repr(s.secondarycolor)}");
    v.push(f"tertiarycolor={color_repr(s.tertiarycolor)}");
    v.push(f"outlinecolor={color_repr(s.outlinecolor)}");
    v.push(f"backcolor={color_repr(s.backcolor)}");
    v.push(f"bold={py_bool(s.bold)}");
    v.push(f"italic={py_bool(s.italic)}");
    v.push(f"underline={py_bool(s.underline)}");
    v.push(f"strikeout={py_bool(s.strikeout)}");
    v.push(f"scalex={num_repr(s.scalex)}");
    v.push(f"scaley={num_repr(s.scaley)}");
    v.push(f"spacing={num_repr(s.spacing)}");
    v.push(f"angle={num_repr(s.angle)}");
    v.push(f"borderstyle={s.borderstyle}");
    v.push(f"outline={num_repr(s.outline)}");
    v.push(f"shadow={num_repr(s.shadow)}");
    v.push(f"alignment={align_repr(s.alignment)}");
    v.push(f"marginl={s.marginl}");
    v.push(f"marginr={s.marginr}");
    v.push(f"marginv={s.marginv}");
    v.push(f"alphalevel={s.alphalevel}");
    v.push(f"encoding={s.encoding}");
    v.push(f"drawing={py_bool(s.drawing)}");
    v
}

// SSAStyle.__eq__: the dataclass compares every field.
fn style_eq(x: ref Style, y: ref Style) -> bool {
    x.fontname == y.fontname and num_eq(x.fontsize, y.fontsize) and color_eq(x.primarycolor, y.primarycolor)
        and color_eq(x.secondarycolor, y.secondarycolor) and color_eq(x.tertiarycolor, y.tertiarycolor)
        and color_eq(x.outlinecolor, y.outlinecolor) and color_eq(x.backcolor, y.backcolor)
        and x.bold == y.bold and x.italic == y.italic and x.underline == y.underline and x.strikeout == y.strikeout
        and num_eq(x.scalex, y.scalex) and num_eq(x.scaley, y.scaley) and num_eq(x.spacing, y.spacing)
        and num_eq(x.angle, y.angle) and x.borderstyle == y.borderstyle and num_eq(x.outline, y.outline)
        and num_eq(x.shadow, y.shadow) and align_value(x.alignment) == align_value(y.alignment)
        and x.marginl == y.marginl and x.marginr == y.marginr and x.marginv == y.marginv
        and x.alphalevel == y.alphalevel and x.encoding == y.encoding and x.drawing == y.drawing
}

#[derive(Clone)]
struct Event {
    start: i64,
    end: i64,
    text: String,
    marked: bool,
    layer: i64,
    style: String,
    name: String,
    marginl: i64,
    marginr: i64,
    marginv: i64,
    effect: String,
    kind: String,
}

fn new_event(start: i64, end: i64, text: ref String) -> Event {
    Event {
        start: start,
        end: end,
        text: text.clone(),
        marked: false,
        layer: 0,
        style: "Default".to_string(),
        name: String.new(),
        marginl: 0,
        marginr: 0,
        marginv: 0,
        effect: String.new(),
        kind: "Dialogue".to_string(),
    }
}

fn event_repr(e: ref Event) -> String {
    f"<SSAEvent type={e.kind} start={ms_to_str(e.start)} end={ms_to_str(e.end)} text={py_repr_str(e.text)}>"
}

// SSAEvent.equals: every field.
fn event_equals(x: ref Event, y: ref Event) -> bool {
    x.start == y.start and x.end == y.end and x.text == y.text and x.marked == y.marked and x.layer == y.layer
        and x.style == y.style and x.name == y.name and x.marginl == y.marginl and x.marginr == y.marginr
        and x.marginv == y.marginv and x.effect == y.effect and x.kind == y.kind
}

fn is_comment(e: ref Event) -> bool {
    e.kind == "Comment"
}

fn plaintext(p: ref Pats, e: ref Event) -> String {
    let mut t = re_sub(p.override_seq, "", e.text);
    t = replace_all(t, "\\h", " ");
    t = replace_all(t, "\\n", "\n");
    replace_all(t, "\\N", "\n")
}

fn is_drawing(p: ref Pats, e: ref Event) -> bool {
    let empty: Vec[(String, Style)] = Vec.new();
    for (_, sty) in parse_tags(p, e.text, default_style(), empty, false) {
        if sty.drawing {
            return true;
        }
    }
    false
}

fn is_text(p: ref Pats, e: ref Event) -> bool {
    not (is_comment(e) or is_drawing(p, e))
}

#[derive(Clone)]
struct Subs {
    events: Vec[Event],
    styles: Vec[(String, Style)],
    info: Vec[(String, String)],
    aegisub: Vec[(String, String)],
    fonts: Vec[(String, Vec[String])],
    graphics: Vec[(String, Vec[String])],
    fps: Option[f64],
    format: Option[String],
}

fn new_subs() -> Subs {
    let mut info: Vec[(String, String)] = Vec.new();
    info.push(("WrapStyle".to_string(), "0".to_string()));
    info.push(("ScaledBorderAndShadow".to_string(), "yes".to_string()));
    info.push(("Collisions".to_string(), "Normal".to_string()));
    let mut styles: Vec[(String, Style)] = Vec.new();
    styles.push(("Default".to_string(), default_style()));
    Subs { events: Vec.new(), styles: styles, info: info, aegisub: Vec.new(), fonts: Vec.new(), graphics: Vec.new(), fps: None, format: None }
}

fn style_get(styles: ref Vec[(String, Style)], name: ref String) -> Option[Style] {
    for (k, s) in styles {
        if *k == *name {
            return Some(s.clone());
        }
    }
    None
}

fn style_or_default(styles: ref Vec[(String, Style)], name: ref String) -> Style {
    match style_get(styles, name) {
        Some(s) => s,
        None => default_style(),
    }
}

fn style_set(styles: mut ref Vec[(String, Style)], name: ref String, s: ref Style) {
    for i in 0..styles.len() {
        if styles[i].0 == *name {
            styles[i] = (name.clone(), s.clone());
            return;
        }
    }
    styles.push((name.clone(), s.clone()));
}

fn subs_repr(s: ref Subs) -> String {
    if s.events.len() > 0 {
        let mut mx = s.events[0].end;
        for e in s.events {
            if e.end > mx {
                mx = e.end;
            }
        }
        f"<SSAFile with {s.events.len()} events and {s.styles.len()} styles, last timestamp {ms_to_str(mx)}>"
    } else {
        f"<SSAFile with 0 events and {s.styles.len()} styles>"
    }
}

// substation.parse_tags: the text split at override blocks, each fragment
// with the style the overrides before it give.
fn parse_tags(p: ref Pats, text: ref String, style: ref Style, styles: ref Vec[(String, Style)], skip_empty: bool) -> Vec[(String, Style)] {
    let mut out: Vec[(String, Style)] = Vec.new();
    let fragments = re_split(p.override_seq, text);
    if fragments.len() == 1 {
        if not (skip_empty and text.len() == 0) {
            out.push((text.clone(), style.clone()));
        }
        return out;
    }
    let overrides = re_findall(p.override_seq, text);
    let mut prefix = String.new();
    for i in 0..fragments.len() {
        if i > 0 {
            prefix.push_str(overrides[i - 1][0]);
        }
        let mut s = style.clone();
        for tagv in re_findall(p.override_tag, prefix) {
            let tag = tagv[0].clone();
            let tc = chs(tag);
            if tag == "\\r" {
                s = style.clone();
            } else if tag.starts_with("\\r") {
                let name = chars_str(tc, 2, tc.len());
                if let Some(named) = style_get(styles, name) {
                    s = named;
                }
            } else if tag.starts_with("\\fn") {
                s.fontname = chars_str(tc, 3, tc.len());
            } else if tc[1] == 'i' {
                s.italic = tc[2] == '1';
            } else if tc[1] == 'b' {
                s.bold = tc[2] == '1';
            } else if tc[1] == 'u' {
                s.underline = tc[2] == '1';
            } else if tc[1] == 's' {
                s.strikeout = tc[2] == '1';
            } else if tc[1] == 'p' {
                s.drawing = tc[2] != '0';
            }
        }
        if not (skip_empty and fragments[i].len() == 0) {
            out.push((fragments[i].clone(), s));
        }
    }
    out
}

// ------------------------------------------------------------ text sinks
//
// A writer's output: a StringIO for to_string, or a text-mode file that
// encodes each write() on its own, the way TextIOWrapper does. print()
// writes its arguments, separators and end as separate pieces, so a
// writer calls put once per piece.

struct Sink {
    text: String,
    bytes: Vec[u8],
    file: bool,
    codec: Codec,
    se: bool,
    started: bool,
}

fn str_sink() -> Sink {
    Sink { text: String.new(), bytes: Vec.new(), file: false, codec: Codec.U8, se: false, started: false }
}

fn file_sink(codec: ref Codec, se: bool) -> Sink {
    Sink { text: String.new(), bytes: Vec.new(), file: true, codec: codec.clone(), se: se, started: false }
}

fn put(k: mut ref Sink, piece: ref String) -> Result[(), Exc] {
    if not k.file {
        k.text.push_str(piece);
        return Ok(());
    }
    if not k.started {
        k.started = true;
        match k.codec {
            Codec.U16 => {
                k.bytes.push(0xff);
                k.bytes.push(0xfe);
            }
            Codec.U8Sig => {
                k.bytes.push(0xef);
                k.bytes.push(0xbb);
                k.bytes.push(0xbf);
            }
            _ => {}
        }
    }
    let mut buf: Vec[u8] = Vec.new();
    encode_piece(k.codec, piece, k.se, mut buf)?;
    for x in buf {
        k.bytes.push(*x);
    }
    Ok(())
}

fn puts(k: mut ref Sink, s: Str) -> Result[(), Exc] {
    put(mut k, s.to_string())
}

// ------------------------------------------------------------ SubStation

fn style_fields_of(fmt: ref String) -> Vec[Str] {
    if *fmt == "ass" {
        vec!["fontname", "fontsize", "primarycolor", "secondarycolor", "outlinecolor", "backcolor", "bold", "italic",
             "underline", "strikeout", "scalex", "scaley", "spacing", "angle", "borderstyle", "outline", "shadow",
             "alignment", "marginl", "marginr", "marginv", "encoding"]
    } else {
        vec!["fontname", "fontsize", "primarycolor", "secondarycolor", "tertiarycolor", "backcolor", "bold", "italic",
             "borderstyle", "outline", "shadow", "alignment", "marginl", "marginr", "marginv", "alphalevel", "encoding"]
    }
}

fn event_fields_of(fmt: ref String) -> Vec[Str] {
    if *fmt == "ass" {
        vec!["layer", "start", "end", "style", "name", "marginl", "marginr", "marginv", "effect", "text"]
    } else {
        vec!["marked", "start", "end", "style", "name", "marginl", "marginr", "marginv", "effect", "text"]
    }
}

fn color_to_ass_rgba(c: ref Color) -> String {
    let x = c.a * 16777216 + c.b * 65536 + c.g * 256 + c.r;
    f"&H{upper_hex(x, 8)}"
}

fn color_to_ssa_rgb(c: ref Color) -> String {
    let x = c.b * 65536 + c.g * 256 + c.r;
    f"{x}"
}

// rgba_to_color: "&H..." is read as hex from its third character on.
fn rgba_to_color(s: ref String) -> Option[Color] {
    let x = if s.starts_with("&") {
        py_int(slice_from(s, 2), 16)?
    } else {
        py_int(s, 10)?
    };
    Some(rgba(x & 0xff, (x >> 8) & 0xff, (x >> 16) & 0xff, (x >> 24) & 0xff))
}

fn is_valid_field_content(s: ref String) -> bool {
    not s.contains("\n") and not s.contains(",")
}

const MAX_SSA_TIME: i64 = 35999990;

fn ssa_timestamp(w: mut ref World, requested: i64) -> String {
    let mut ms = requested;
    if ms < 0 {
        warn(mut w, "TimestampUnderflow", "Underflow in SubStation timestamp, clamping to zero".to_string());
        ms = 0;
    } else if ms > MAX_SSA_TIME {
        warn(mut w, "TimestampOverflow", "Overflow in SubStation timestamp, clamping to MAX_REPRESENTABLE_TIME".to_string());
        ms = MAX_SSA_TIME;
    }
    let round_ms = (ms + 5) - floor_mod(ms + 5, 10);
    let (h, m, s, x) = ms_to_times(Num.I(round_ms));
    f"{h}:{zpad(m, 2)}:{zpad(s, 2)}.{zpad(x / 10, 2)}"
}

fn guess_substation(p: ref Pats, text: ref String) -> Option[String] {
    if re_found(p.v4plus, text) {
        Some("ass".to_string())
    } else if re_found(p.v4, text) {
        Some("ssa".to_string())
    } else {
        None
    }
}

fn attr_warn(w: mut ref World, field: Str) {
    warn(mut w, "SubtitleAttributeWarning", f"Failed to parse {field}, using default");
}

fn parse_color(w: mut ref World, field: Str, value: ref String, dflt: ref Color) -> Color {
    match rgba_to_color(py_strip(value)) {
        Some(c) => c,
        None => {
            attr_warn(mut w, field);
            dflt.clone()
        }
    }
}

fn parse_int_field(w: mut ref World, field: Str, value: ref String, dflt: i64) -> i64 {
    match py_int(value, 10) {
        Some(n) => n,
        None => {
            attr_warn(mut w, field);
            dflt
        }
    }
}

fn parse_float_field(w: mut ref World, field: Str, value: ref String, dflt: ref Num) -> Num {
    match py_float(value) {
        Some(x) => Num.F(x),
        None => {
            attr_warn(mut w, field);
            dflt.clone()
        }
    }
}

fn parse_alignment(w: mut ref World, value: ref String, fmt: ref String) -> Align {
    let r = match py_int(value, 10) {
        None => None,
        Some(n) => {
            let a = if *fmt == "ass" { alignment_of(n) } else { from_ssa_alignment(n) };
            match a {
                Ok(x) => Some(x),
                Err(_) => None,
            }
        }
    };
    match r {
        Some(x) => x,
        None => {
            warn(mut w, "SubtitleAttributeWarning", "Failed to parse alignment, using default".to_string());
            Align.E(2)
        }
    }
}

fn parse_time_field(p: ref Pats, field: Str, value: ref String) -> Result[i64, Exc] {
    let mut v = py_strip(value);
    let mut sign = 1;
    if v.starts_with("-") {
        v = slice_from(v, 1);
        sign = -1;
    }
    match re_match(p.timestamp, v) {
        Some(g) => Ok(sign * timestamp_to_ms(tail(g))),
        None => match re_match(p.timestamp_short, v) {
            Some(g) => Ok(sign * timestamp_to_ms(tail(g))),
            None => Err(exc("ValueError", f"Failed to parse {field} timestamp: {py_repr_str(v)}")),
        },
    }
}

fn set_style_field(w: mut ref World, sty: mut ref Style, field: Str, value: ref String, fmt: ref String) {
    let d = default_style();
    if field == "fontname" {
        sty.fontname = py_strip(value);
    } else if field == "fontsize" {
        sty.fontsize = parse_float_field(mut w, field, value, d.fontsize);
    } else if field == "primarycolor" {
        sty.primarycolor = parse_color(mut w, field, value, d.primarycolor);
    } else if field == "secondarycolor" {
        sty.secondarycolor = parse_color(mut w, field, value, d.secondarycolor);
    } else if field == "tertiarycolor" {
        sty.tertiarycolor = parse_color(mut w, field, value, d.tertiarycolor);
    } else if field == "outlinecolor" {
        sty.outlinecolor = parse_color(mut w, field, value, d.outlinecolor);
    } else if field == "backcolor" {
        sty.backcolor = parse_color(mut w, field, value, d.backcolor);
    } else if field == "bold" {
        sty.bold = *value != "0";
    } else if field == "italic" {
        sty.italic = *value != "0";
    } else if field == "underline" {
        sty.underline = *value != "0";
    } else if field == "strikeout" {
        sty.strikeout = *value != "0";
    } else if field == "scalex" {
        sty.scalex = parse_float_field(mut w, field, value, d.scalex);
    } else if field == "scaley" {
        sty.scaley = parse_float_field(mut w, field, value, d.scaley);
    } else if field == "spacing" {
        sty.spacing = parse_float_field(mut w, field, value, d.spacing);
    } else if field == "angle" {
        sty.angle = parse_float_field(mut w, field, value, d.angle);
    } else if field == "borderstyle" {
        sty.borderstyle = parse_int_field(mut w, field, value, d.borderstyle);
    } else if field == "outline" {
        sty.outline = parse_float_field(mut w, field, value, d.outline);
    } else if field == "shadow" {
        sty.shadow = parse_float_field(mut w, field, value, d.shadow);
    } else if field == "alignment" {
        sty.alignment = parse_alignment(mut w, value, fmt);
    } else if field == "marginl" {
        sty.marginl = parse_int_field(mut w, field, value, d.marginl);
    } else if field == "marginr" {
        sty.marginr = parse_int_field(mut w, field, value, d.marginr);
    } else if field == "marginv" {
        sty.marginv = parse_int_field(mut w, field, value, d.marginv);
    } else if field == "alphalevel" {
        sty.alphalevel = parse_int_field(mut w, field, value, d.alphalevel);
    } else if field == "encoding" {
        sty.encoding = parse_int_field(mut w, field, value, d.encoding);
    }
}

fn set_event_field(w: mut ref World, p: ref Pats, ev: mut ref Event, field: Str, value: ref String) -> Result[(), Exc] {
    if field == "start" {
        ev.start = parse_time_field(p, field, value)?;
    } else if field == "end" {
        ev.end = parse_time_field(p, field, value)?;
    } else if field == "layer" {
        ev.layer = parse_int_field(mut w, field, value, 0);
    } else if field == "marked" {
        ev.marked = value.ends_with("1");
    } else if field == "marginl" {
        ev.marginl = parse_int_field(mut w, field, value, 10);
    } else if field == "marginr" {
        ev.marginr = parse_int_field(mut w, field, value, 10);
    } else if field == "marginv" {
        ev.marginv = parse_int_field(mut w, field, value, 10);
    } else if field == "style" {
        ev.style = value.clone();
    } else if field == "name" {
        ev.name = value.clone();
    } else if field == "effect" {
        ev.effect = value.clone();
    } else if field == "text" {
        ev.text = value.clone();
    }
    Ok(())
}

fn att_set(xs: mut ref Vec[(String, Vec[String])], k: ref String, v: ref Vec[String]) {
    for i in 0..xs.len() {
        if xs[i].0 == *k {
            xs[i] = (k.clone(), v.clone());
            return;
        }
    }
    xs.push((k.clone(), v.clone()));
}

// "k: v" split at the first colon.
fn split_colon(s: ref String) -> Option[(String, String)] {
    let parts = split_max(s, ':', 1);
    if parts.len() < 2 {
        None
    } else {
        Some((parts[0].clone(), parts[1].clone()))
    }
}

fn ss_read(w: mut ref World, p: ref Pats, subs: mut ref Subs, lines: ref Vec[String], fmt: ref String) -> Result[(), Exc] {
    subs.info.clear();
    subs.aegisub.clear();
    subs.styles.clear();
    subs.fonts.clear();
    subs.graphics.clear();
    let mut in_info = false;
    let mut in_aegisub = false;
    let mut in_font = false;
    let mut in_graphic = false;
    let mut att_name = String.new();
    let mut att_lines: Vec[String] = Vec.new();
    let mut att_is_font = false;
    for raw in lines {
        let line = py_strip(raw);
        if re_match(p.section_heading, line).is_some() {
            in_info = line.contains("Info");
            in_aegisub = line.contains("Aegisub");
            in_font = line.contains("Fonts");
            in_graphic = line.contains("Graphics");
        } else if in_info or in_aegisub {
            if line.starts_with(";") {
                continue;
            }
            if let Some((k, v)) = split_colon(line) {
                if in_info {
                    kv_set(mut subs.info, k, py_strip(v));
                } else {
                    kv_set(mut subs.aegisub, k, py_strip(v));
                }
            }
        } else if in_font or in_graphic {
            let m = re_match(p.attachment, line);
            att_is_font = in_font;
            if att_name.len() > 0 and (m.is_some() or line.len() == 0) {
                if in_font {
                    att_set(mut subs.fonts, att_name, att_lines);
                } else {
                    att_set(mut subs.graphics, att_name, att_lines);
                }
                att_lines.clear();
                att_name = String.new();
            }
            match m {
                Some(g) => {
                    att_name = g[2].clone();
                }
                None => {
                    if line.len() > 0 {
                        att_lines.push(line.clone());
                    }
                }
            }
        } else if line.starts_with("Style:") {
            let rest = split_colon(line).unwrap().1;
            let buf = split_on(py_strip(rest), ',');
            let fields = style_fields_of(fmt);
            let mut sty = default_style();
            for i in 1..buf.len() {
                if i - 1 < fields.len() {
                    set_style_field(mut w, mut sty, fields[i - 1], buf[i], fmt);
                }
            }
            style_set(mut subs.styles, buf[0], sty);
        } else if line.starts_with("Dialogue:") or line.starts_with("Comment:") {
            let (kind, rest) = split_colon(line).unwrap();
            let fields = event_fields_of(fmt);
            let raw_fields = split_max(py_strip(rest), ',', fields.len() - 1);
            let mut ev = new_event(0, 10000, String.new());
            for i in 0..raw_fields.len() {
                set_event_field(mut w, p, mut ev, fields[i], raw_fields[i])?;
            }
            ev.kind = kind;
            subs.events.push(ev);
        }
    }
    if att_name.len() > 0 {
        if att_is_font {
            att_set(mut subs.fonts, att_name, att_lines);
        } else {
            att_set(mut subs.graphics, att_name, att_lines);
        }
    }
    Ok(())
}

// str(x) of a float field: whole numbers lose their ".0".
fn ss_num(n: ref Num) -> String {
    match n {
        Num.I(i) => f"{i}",
        Num.F(x) => if is_integer(x) { f"{x as i64}" } else { float_repr(x) },
    }
}

fn ss_bool(b: bool) -> String {
    if b { "-1".to_string() } else { "0".to_string() }
}

fn ss_alignment(w: mut ref World, a: ref Align, fmt: ref String) -> String {
    match a {
        Align.P(_) => warn(mut w, "DeprecationWarning", "The 'alignment' attribute of SSAStyle should be an Alignment instance, using plain int is deprecated".to_string()),
        Align.E(_) => {}
    }
    let v = align_value(a);
    if *fmt == "ssa" { f"{to_ssa_alignment(v)}" } else { f"{v}" }
}

fn ss_color(c: ref Color, fmt: ref String) -> String {
    if *fmt == "ass" { color_to_ass_rgba(c) } else { color_to_ssa_rgb(c) }
}

fn style_field_str(w: mut ref World, sty: ref Style, field: Str, fmt: ref String) -> String {
    if field == "fontname" {
        sty.fontname.clone()
    } else if field == "fontsize" {
        ss_num(sty.fontsize)
    } else if field == "primarycolor" {
        ss_color(sty.primarycolor, fmt)
    } else if field == "secondarycolor" {
        ss_color(sty.secondarycolor, fmt)
    } else if field == "tertiarycolor" {
        ss_color(sty.tertiarycolor, fmt)
    } else if field == "outlinecolor" {
        ss_color(sty.outlinecolor, fmt)
    } else if field == "backcolor" {
        ss_color(sty.backcolor, fmt)
    } else if field == "bold" {
        ss_bool(sty.bold)
    } else if field == "italic" {
        ss_bool(sty.italic)
    } else if field == "underline" {
        ss_bool(sty.underline)
    } else if field == "strikeout" {
        ss_bool(sty.strikeout)
    } else if field == "scalex" {
        ss_num(sty.scalex)
    } else if field == "scaley" {
        ss_num(sty.scaley)
    } else if field == "spacing" {
        ss_num(sty.spacing)
    } else if field == "angle" {
        ss_num(sty.angle)
    } else if field == "borderstyle" {
        f"{sty.borderstyle}"
    } else if field == "outline" {
        ss_num(sty.outline)
    } else if field == "shadow" {
        ss_num(sty.shadow)
    } else if field == "alignment" {
        ss_alignment(mut w, sty.alignment, fmt)
    } else if field == "marginl" {
        f"{sty.marginl}"
    } else if field == "marginr" {
        f"{sty.marginr}"
    } else if field == "marginv" {
        f"{sty.marginv}"
    } else if field == "alphalevel" {
        f"{sty.alphalevel}"
    } else {
        f"{sty.encoding}"
    }
}

fn event_field_str(w: mut ref World, ev: ref Event, field: Str) -> String {
    if field == "start" {
        ssa_timestamp(mut w, ev.start)
    } else if field == "end" {
        ssa_timestamp(mut w, ev.end)
    } else if field == "marked" {
        if ev.marked { "Marked=1".to_string() } else { "Marked=0".to_string() }
    } else if field == "layer" {
        f"{ev.layer}"
    } else if field == "style" {
        ev.style.clone()
    } else if field == "name" {
        ev.name.clone()
    } else if field == "marginl" {
        f"{ev.marginl}"
    } else if field == "marginr" {
        f"{ev.marginr}"
    } else if field == "marginv" {
        f"{ev.marginv}"
    } else if field == "effect" {
        ev.effect.clone()
    } else {
        ev.text.clone()
    }
}

// print(a, b, ..., sep=sep): the pieces in order, then the newline.
fn print_parts(k: mut ref Sink, parts: ref Vec[String], sep: Str) -> Result[(), Exc] {
    for i in 0..parts.len() {
        if i > 0 {
            puts(mut k, sep)?;
        }
        put(mut k, parts[i])?;
    }
    puts(mut k, "\n")
}

fn print1(k: mut ref Sink, s: ref String) -> Result[(), Exc] {
    put(mut k, s)?;
    puts(mut k, "\n")
}

const NOTICE: Str = "Script generated by pysubs2\nhttps://pypi.python.org/pypi/pysubs2";

fn ss_write(w: mut ref World, subs: mut ref Subs, k: mut ref Sink, fmt: ref String, header: ref String) -> Result[(), Exc] {
    puts(mut k, "[Script Info]")?;
    puts(mut k, "\n")?;
    for line in py_splitlines(header) {
        print_parts(mut k, vec![";".to_string(), line.clone()], " ")?;
    }
    let st = if *fmt == "ass" { "v4.00+" } else { "v4.00" };
    kv_set(mut subs.info, "ScriptType".to_string(), st.to_string());
    for (key, v) in subs.info {
        print_parts(mut k, vec![key.clone(), v.clone()], ": ")?;
    }
    if subs.aegisub.len() > 0 {
        print1(mut k, "\n[Aegisub Project Garbage]".to_string())?;
        for (key, v) in subs.aegisub {
            print_parts(mut k, vec![key.clone(), v.clone()], ": ")?;
        }
    }
    print1(mut k, if *fmt == "ass" { "\n[V4+ Styles]".to_string() } else { "\n[V4 Styles]".to_string() })?;
    if *fmt == "ass" {
        print1(mut k, "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding".to_string())?;
    } else {
        print1(mut k, "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, TertiaryColour, BackColour, Bold, Italic, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, AlphaLevel, Encoding".to_string())?;
    }
    let sfields = style_fields_of(fmt);
    for (name, sty) in subs.styles {
        let mut parts: Vec[String] = Vec.new();
        parts.push(f"Style: {name}");
        for f in sfields {
            parts.push(style_field_str(mut w, sty, *f, fmt));
        }
        print_parts(mut k, parts, ",")?;
    }
    if subs.fonts.len() > 0 {
        print1(mut k, "\n[Fonts]".to_string())?;
        for (name, lines) in sorted_atts(subs.fonts) {
            print1(mut k, f"fontname: {name}")?;
            for line in lines {
                print1(mut k, line)?;
            }
            puts(mut k, "\n")?;
        }
    }
    if subs.graphics.len() > 0 {
        print1(mut k, "\n[Graphics]".to_string())?;
        for (name, lines) in sorted_atts(subs.graphics) {
            print1(mut k, f"filename: {name}")?;
            for line in lines {
                print1(mut k, line)?;
            }
            puts(mut k, "\n")?;
        }
    }
    print1(mut k, "\n[Events]".to_string())?;
    if *fmt == "ass" {
        print1(mut k, "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text".to_string())?;
    } else {
        print1(mut k, "Format: Marked, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text".to_string())?;
    }
    let efields = event_fields_of(fmt);
    for ev in subs.events {
        let mut parts: Vec[String] = Vec.new();
        for f in efields {
            parts.push(event_field_str(mut w, ev, *f));
        }
        put(mut k, ev.kind)?;
        puts(mut k, ": ")?;
        print_parts(mut k, parts, ",")?;
    }
    Ok(())
}

// sorted(dict.items()): by name, and the names are distinct.
fn sorted_atts(xs: ref Vec[(String, Vec[String])]) -> Vec[(String, Vec[String])] {
    let mut v = xs.clone();
    let n = v.len();
    for i in 1..n {
        let mut j = i;
        while j > 0 and v[j - 1].0 > v[j].0 {
            v.swap(j - 1, j);
            j -= 1;
        }
    }
    v
}

// ------------------------------------------------------------ reader and writer options

struct ReadOpts {
    keep_html: bool,
    keep_unknown: bool,
    fps: Option[f64],
    strict_fps: bool,
}

fn read_opts() -> ReadOpts {
    ReadOpts { keep_html: false, keep_unknown: false, fps: None, strict_fps: true }
}

struct WriteOpts {
    header: String,
    apply_styles: bool,
    keep_ssa_tags: bool,
    fps: Option[f64],
    write_fps: bool,
}

fn write_opts() -> WriteOpts {
    WriteOpts { header: NOTICE.to_string(), apply_styles: true, keep_ssa_tags: false, fps: None, write_fps: true }
}

// ------------------------------------------------------------ SubRip and WebVTT

const MAX_SRT_TIME: i64 = 359999999;

fn srt_timestamp(w: mut ref World, requested: i64) -> String {
    let mut ms = requested;
    if ms < 0 {
        warn(mut w, "TimestampUnderflow", "Underflow in SubRip timestamp, clamping to zero".to_string());
        ms = 0;
    } else if ms > MAX_SRT_TIME {
        warn(mut w, "TimestampOverflow", "Overflow in SubRip timestamp, clamping to MAX_REPRESENTABLE_TIME".to_string());
        ms = MAX_SRT_TIME;
    }
    let (h, m, s, x) = ms_to_times(Num.I(ms));
    f"{zpad(h, 2)}:{zpad(m, 2)}:{zpad(s, 2)},{zpad(x, 3)}"
}

fn vtt_timestamp(w: mut ref World, ms: i64) -> String {
    replace_all(srt_timestamp(mut w, ms), ",", ".")
}

fn vtt_stamp_ms(g: ref Vec[String]) -> Result[i64, Exc] {
    let mut h = 0;
    if g[0].len() > 0 {
        let hs = strip_char(g[0], ':');
        h = match py_int(hs, 10) {
            Some(n) => n,
            None => return Err(int_error(hs, 10)),
        };
    }
    let m = py_int(g[1], 10).unwrap();
    let s = py_int(g[2], 10).unwrap();
    let ms = py_int(g[3], 10).unwrap();
    Ok(times_to_ms(Num.I(h), Num.I(m), Num.I(s), Num.I(ms)))
}

fn contains_any(text: ref String, xs: Vec[Str]) -> bool {
    for x in xs {
        if text.contains(*x) {
            return true;
        }
    }
    false
}

fn guess_srt(p: ref Pats, text: ref String) -> Option[String] {
    if contains_any(text, vec!["[Script Info]", "[V4+ Styles]"]) {
        return None;
    }
    if py_lstrip(text).starts_with("WEBVTT") {
        return None;
    }
    if text.contains("http://www.w3.org/ns/ttml") {
        return None;
    }
    for line in py_splitlines(text) {
        if re_findall(p.timestamp, line).len() == 2 {
            return Some("srt".to_string());
        }
    }
    None
}

fn guess_vtt(text: ref String) -> Option[String] {
    if py_lstrip(text).starts_with("WEBVTT") { Some("vtt".to_string()) } else { None }
}

fn srt_prepare(p: ref Pats, lines: ref Vec[String], o: ref ReadOpts) -> String {
    let n = lines.len();
    if n >= 2 {
        let mut blank = true;
        for i in 0..(n - 1) {
            if re_match(p.blank_line, lines[i]).is_none() {
                blank = false;
            }
        }
        if blank and re_match(p.number_line, lines[n - 1]).is_some() {
            return String.new();
        }
    }
    let mut s = String.new();
    for l in lines {
        s.push_str(l);
    }
    s = py_strip(s);
    s = re_sub(p.trailing_number, "", s);
    if not o.keep_html {
        for (re, tpl) in p.srt_tags {
            s = re_sub(re, tpl, s);
        }
    }
    if not (o.keep_html or o.keep_unknown) {
        s = re_sub(p.html_tag, "", s);
    }
    re_sub(p.newline, "\\\\N", s)
}

fn srt_read(w: mut ref World, p: ref Pats, subs: mut ref Subs, lines: ref Vec[String], vtt: bool, o: ref ReadOpts) -> Result[(), Exc] {
    let mut stamps_at: Vec[(i64, i64)] = Vec.new();
    let mut following: Vec[Vec[String]] = Vec.new();
    for i in 0..lines.len() {
        let line = lines[i].clone();
        let stamps = if vtt { re_findall(p.vtt_timestamp, line) } else { re_findall(p.timestamp, line) };
        if stamps.len() == 2 {
            let a = if vtt { vtt_stamp_ms(stamps[0])? } else { timestamp_to_ms(stamps[0]) };
            let b = if vtt { vtt_stamp_ms(stamps[1])? } else { timestamp_to_ms(stamps[1]) };
            stamps_at.push((a, b));
            following.push(Vec.new());
        } else {
            if stamps.len() > 0 {
                warn(mut w, "PossibleMissedSubtitleWarning", f"Possible missed subtitle start near line {i + 1}");
            }
            if stamps_at.len() > 0 {
                let last = following.len() - 1;
                following[last].push(line);
            }
        }
    }
    for i in 0..stamps_at.len() {
        let (a, b) = stamps_at[i];
        subs.events.push(new_event(a, b, srt_prepare(p, following[i], o)));
    }
    Ok(())
}

fn text_events(p: ref Pats, subs: ref Subs) -> Vec[Event] {
    let mut out: Vec[Event] = Vec.new();
    for e in subs.events {
        if is_text(p, e) {
            out.push(e.clone());
        }
    }
    out
}

fn srt_body(p: ref Pats, subs: ref Subs, text: ref String, style: ref Style, o: ref WriteOpts) -> String {
    let mut t = replace_all(text, "\\h", " ");
    t = replace_all(t, "\\n", "\n");
    t = replace_all(t, "\\N", "\n");
    let mut body = String.new();
    if o.keep_ssa_tags {
        body.push_str(t);
    } else {
        for (frag, sty) in parse_tags(p, t, style, subs.styles, false) {
            let mut f = frag.clone();
            if o.apply_styles {
                if sty.italic {
                    f = f"<i>{f}</i>";
                }
                if sty.underline {
                    f = f"<u>{f}</u>";
                }
                if sty.strikeout {
                    f = f"<s>{f}</s>";
                }
            }
            body.push_str(f);
        }
    }
    re_sub(p.newlines, "\n", py_strip(body))
}

// A stable sort of events by start time.
fn sort_by_start(v: mut ref Vec[Event]) {
    let n = v.len();
    for i in 1..n {
        let mut j = i;
        while j > 0 and v[j - 1].start > v[j].start {
            v.swap(j - 1, j);
            j -= 1;
        }
    }
}

fn srt_write(w: mut ref World, p: ref Pats, subs: ref Subs, k: mut ref Sink, vtt: bool, o: ref WriteOpts) -> Result[(), Exc] {
    let mut lines = text_events(p, subs);
    if vtt {
        print1(mut k, "WEBVTT\n".to_string())?;
        sort_by_start(mut lines);
    }
    for i in 0..lines.len() {
        let line = lines[i].clone();
        let start = if vtt { vtt_timestamp(mut w, line.start) } else { srt_timestamp(mut w, line.start) };
        let end = if vtt { vtt_timestamp(mut w, line.end) } else { srt_timestamp(mut w, line.end) };
        let style = style_or_default(subs.styles, line.style);
        let text = srt_body(p, subs, line.text, style, o);
        print1(mut k, f"{i + 1}")?;
        print_parts(mut k, vec![start, "-->".to_string(), end], " ")?;
        put(mut k, text)?;
        puts(mut k, "\n\n")?;
    }
    Ok(())
}

// ------------------------------------------------------------ MicroDVD

fn guess_microdvd(p: ref Pats, text: ref String) -> Option[String] {
    for line in py_splitlines(text) {
        if re_match(p.microdvd_line, line).is_some() {
            return Some("microdvd".to_string());
        }
    }
    None
}

fn md_prepare(p: ref Pats, text: ref String) -> String {
    let mut t = replace_all(text, "|", "\\N");
    // The {Y:...} style tags become their i/b/u overrides.
    let s = chs(t);
    let mut out = String.new();
    let mut last = 0;
    for m in re_iter(p.md_style, s) {
        out.push_str(chars_str(s, last, m[0]));
        let whole = chars_str(s, m[0], m[1]);
        out.push('{');
        for c in vec!['b', 'i', 'u'] {
            let mut cs = String.new();
            cs.push(*c);
            if whole.contains(cs) {
                out.push('\\');
                out.push(*c);
                out.push('1');
            }
        }
        out.push('}');
        last = m[1];
    }
    out.push_str(chars_str(s, last, s.len()));
    t = out;
    t = re_sub(p.md_font, "{\\\\fn\\1}", t);
    t = re_sub(p.md_size, "{\\\\fs\\1}", t);
    t = re_sub(p.md_pos, "{\\\\pos(\\1,\\2)}", t);
    py_strip(t)
}

fn md_read(w: mut ref World, p: ref Pats, subs: mut ref Subs, lines: ref Vec[String], o: ref ReadOpts) -> Result[(), Exc] {
    let mut fps = o.fps;
    for i in 0..lines.len() {
        let line = lines[i].clone();
        let g = match re_match(p.microdvd_line, line) {
            Some(g) => g,
            None => {
                if re_found(p.word, line) {
                    warn(mut w, "PossibleMissedSubtitleWarning", f"Possible missed subtitle at line {i + 1}");
                }
                continue;
            }
        };
        let fstart = py_int(g[1], 10).unwrap();
        let fend = py_int(g[2], 10).unwrap();
        let rate = match fps {
            Some(f) => {
                subs.fps = Some(f);
                f
            }
            None => {
                let ok = not o.strict_fps or (fstart == 1 and fend == 1);
                let parsed = if ok { py_float(g[3]) } else { None };
                match parsed {
                    Some(x) => {
                        fps = Some(x);
                        subs.fps = Some(x);
                        continue;
                    }
                    None => return Err(exc("UnknownFPSError", "Framerate was not specified and cannot be read from the MicroDVD file.".to_string())),
                }
            }
        };
        let start = frames_to_ms(fstart, Num.F(rate))?;
        let end = frames_to_ms(fend, Num.F(rate))?;
        subs.events.push(new_event(start, end, md_prepare(p, g[3])));
    }
    Ok(())
}

fn is_entirely_italic(p: ref Pats, subs: ref Subs, line: ref Event) -> bool {
    let style = style_or_default(subs.styles, line.style);
    for (frag, sty) in parse_tags(p, line.text, style, subs.styles, false) {
        let mut f = replace_all(frag, "\\h", " ");
        f = replace_all(f, "\\n", "\n");
        f = replace_all(f, "\\N", "\n");
        if not sty.italic and f.len() > 0 and not all_space(f) {
            return false;
        }
    }
    true
}

fn md_write(p: ref Pats, subs: ref Subs, k: mut ref Sink, o: ref WriteOpts) -> Result[(), Exc] {
    let fps = match o.fps {
        Some(f) => f,
        None => match subs.fps {
            Some(f) => f,
            None => return Err(exc("UnknownFPSError", "Framerate must be specified when writing MicroDVD.".to_string())),
        },
    };
    if o.write_fps {
        print1(mut k, f"{{1}}{{1}}{float_repr(fps)}")?;
    }
    for line in text_events(p, subs) {
        let mut text = join_with(py_splitlines(plaintext(p, line)), "|".to_string());
        if o.apply_styles and is_entirely_italic(p, subs, line) {
            text = f"{{Y:i}}{text}";
        }
        let mut start = ms_to_frames(line.start, Num.F(fps))?;
        let mut end = ms_to_frames(line.end, Num.F(fps))?;
        if start < 0 {
            start = 0;
        }
        if end < 0 {
            end = 0;
        }
        print1(mut k, f"{{{start}}}{{{end}}}{text}")?;
    }
    Ok(())
}

// ------------------------------------------------------------ MPL2

fn guess_mpl2(p: ref Pats, text: ref String) -> Option[String] {
    if re_found(p.mpl2, text) { Some("mpl2".to_string()) } else { None }
}

fn mpl2_prepare(text: ref String) -> String {
    let mut out: Vec[String] = Vec.new();
    for part in split_on(text, '|') {
        let mut s = py_strip(part);
        if s.starts_with("/") {
            s = f"{{\\i1}}{py_strip(slice_from(s, 1))}{{\\i0}}";
        }
        out.push(s);
    }
    join_with(out, "\\N".to_string())
}

fn mpl2_read(w: mut ref World, p: ref Pats, subs: mut ref Subs, lines: ref Vec[String]) -> Result[(), Exc] {
    for i in 0..lines.len() {
        let line = lines[i].clone();
        match re_search(p.mpl2, line) {
            Some(g) => {
                let a = py_float(g[1]).unwrap() / 10.0;
                let b = py_float(g[2]).unwrap() / 10.0;
                let start = times_to_ms(Num.I(0), Num.I(0), Num.F(a), Num.I(0));
                let end = times_to_ms(Num.I(0), Num.I(0), Num.F(b), Num.I(0));
                subs.events.push(new_event(start, end, mpl2_prepare(g[3])));
            }
            None => {
                if re_found(p.word, line) {
                    warn(mut w, "PossibleMissedSubtitleWarning", f"Possible missed subtitle at line {i + 1}");
                }
            }
        }
    }
    Ok(())
}

fn mpl2_write(p: ref Pats, subs: ref Subs, k: mut ref Sink) -> Result[(), Exc] {
    for line in text_events(p, subs) {
        let start = floor_div(line.start, 100);
        let end = floor_div(line.end, 100);
        let text = replace_all(plaintext(p, line), "\n", "|");
        print1(mut k, f"[{start}][{end}] {text}")?;
    }
    Ok(())
}

// ------------------------------------------------------------ TMP

const MAX_TMP_TIME: i64 = 359999000;

fn tmp_timestamp(w: mut ref World, requested: i64) -> String {
    let mut ms = requested;
    if ms < 0 {
        warn(mut w, "TimestampUnderflow", "Underflow in TMP timestamp, clamping to zero".to_string());
        ms = 0;
    } else if ms > MAX_TMP_TIME {
        warn(mut w, "TimestampOverflow", "Overflow in TMP timestamp, clamping to MAX_REPRESENTABLE_TIME".to_string());
        ms = MAX_TMP_TIME;
    }
    let (h, m, s, _) = ms_to_times(Num.I(ms));
    f"{zpad(h, 2)}:{zpad(m, 2)}:{zpad(s, 2)}"
}

fn guess_tmp(p: ref Pats, text: ref String) -> Option[String] {
    if contains_any(text, vec!["[Script Info]", "[V4+ Styles]"]) {
        return None;
    }
    for line in py_splitlines(text) {
        if re_match(p.tmp_line, line).is_some() and re_findall(p.tmp_line, line).len() == 1 {
            return Some("tmp".to_string());
        }
    }
    None
}

fn tmp_read(w: mut ref World, p: ref Pats, subs: mut ref Subs, lines: ref Vec[String]) -> Result[(), Exc] {
    let mut events: Vec[Event] = Vec.new();
    for i in 0..lines.len() {
        let line = lines[i].clone();
        let g = match re_match(p.tmp_line, line) {
            Some(g) => g,
            None => {
                if re_found(p.word, line) {
                    warn(mut w, "PossibleMissedSubtitleWarning", f"Possible missed subtitle at line {i + 1}");
                }
                continue;
            }
        };
        let g2 = re_match(p.timestamp_short, g[1]).unwrap();
        let start = timestamp_to_ms(tail(g2));
        let end_guess = start + 500 + char_count(line) * 67;
        let mut text = replace_all(g[2], "|", "\\N");
        text = re_sub(p.tmp_u, "{\\\\u1}", text);
        text = re_sub(p.html_tag, "", text);
        events.push(new_event(start, end_guess, text));
    }
    let n = events.len();
    for i in 0..n {
        if i + 1 < n and events[i + 1].start < events[i].end {
            events[i].end = events[i + 1].start;
        }
    }
    subs.events = events;
    Ok(())
}

fn tmp_write(w: mut ref World, p: ref Pats, subs: ref Subs, k: mut ref Sink, o: ref WriteOpts) -> Result[(), Exc] {
    for line in text_events(p, subs) {
        let start = tmp_timestamp(mut w, line.start);
        let style = style_or_default(subs.styles, line.style);
        let mut body = String.new();
        for (frag, sty) in parse_tags(p, line.text, style, subs.styles, false) {
            let mut f = replace_all(frag, "\\h", " ");
            f = replace_all(f, "\\n", "\n");
            f = replace_all(f, "\\N", "\n");
            if o.apply_styles {
                if sty.italic {
                    f = f"<i>{f}</i>";
                }
                if sty.underline {
                    f = f"<u>{f}</u>";
                }
                if sty.strikeout {
                    f = f"<s>{f}</s>";
                }
            }
            body.push_str(f);
        }
        let text = re_sub(p.newlines, "|", py_strip(body));
        put(mut k, f"{start}:{text}")?;
        puts(mut k, "\n")?;
    }
    Ok(())
}

// ------------------------------------------------------------ whisper-jax

fn whisper_ms(g: ref Vec[String]) -> i64 {
    let mut v: Vec[String] = Vec.new();
    for x in g {
        v.push(if x.len() == 0 { "0".to_string() } else { x.clone() });
    }
    timestamp_to_ms(v)
}

fn whisper_line(p: ref Pats, line: ref String) -> Option[Event] {
    let g = re_match(p.whisper_line, line)?;
    let a = re_fullmatch(p.whisper_ts, g[1]);
    let b = re_fullmatch(p.whisper_ts, g[2]);
    let text = py_strip(g[3]);
    match (a, b) {
        (Some(x), Some(y)) => Some(new_event(whisper_ms(tail(x)), whisper_ms(tail(y)), text)),
        _ => None,
    }
}

fn guess_whisper(p: ref Pats, text: ref String) -> Option[String] {
    let lines = py_splitlines(py_lstrip(text));
    if lines.len() == 0 {
        return None;
    }
    if whisper_line(p, lines[0]).is_some() { Some("whisper_jax".to_string()) } else { None }
}

fn whisper_read(w: mut ref World, p: ref Pats, subs: mut ref Subs, lines: ref Vec[String]) -> Result[(), Exc] {
    for i in 0..lines.len() {
        let line = py_strip(lines[i]);
        match whisper_line(p, line) {
            Some(e) => subs.events.push(e),
            None => {
                if re_found(p.word, line) {
                    warn(mut w, "PossibleMissedSubtitleWarning", f"Possible missed subtitle at line {i + 1}");
                }
            }
        }
    }
    Ok(())
}

// ------------------------------------------------------------ JSON

#[derive(Clone)]
enum JVal {
    Null,
    Bool(bool),
    Int(i64),
    Float(f64),
    Text(String),
    Arr(Vec[JVal]),
    Obj(Vec[(String, JVal)]),
}

struct JsonParser {
    cs: Vec[char],
    pos: i64,
}

fn json_err(at: i64, what: Str) -> Exc {
    exc("JSONDecodeError", f"{what}: char {at}")
}

impl JsonParser {
    fn ws(mut ref self) {
        while self.pos < self.cs.len() {
            let c = self.cs[self.pos];
            if c == ' ' or c == '\t' or c == '\n' or c == '\r' {
                self.pos += 1;
            } else {
                break;
            }
        }
    }

    fn lit(mut ref self, word: Str) -> bool {
        let w: Vec[char] = word.chars().collect();
        if self.pos + w.len() > self.cs.len() {
            return false;
        }
        for i in 0..w.len() {
            if self.cs[self.pos + i] != w[i] {
                return false;
            }
        }
        self.pos += w.len();
        true
    }

    fn hex4(mut ref self) -> Result[i64, Exc] {
        if self.pos + 4 > self.cs.len() {
            return Err(json_err(self.pos, "Invalid \\uXXXX escape"));
        }
        let s = chars_str(self.cs, self.pos, self.pos + 4);
        match py_int(s, 16) {
            Some(n) => {
                self.pos += 4;
                Ok(n)
            }
            None => Err(json_err(self.pos, "Invalid \\uXXXX escape")),
        }
    }

    fn string(mut ref self) -> Result[String, Exc] {
        self.pos += 1;
        let mut out = String.new();
        loop {
            if self.pos >= self.cs.len() {
                return Err(json_err(self.pos, "Unterminated string starting at"));
            }
            let c = self.cs[self.pos];
            self.pos += 1;
            if c == '"' {
                return Ok(out);
            }
            if c != '\\' {
                out.push(c);
                continue;
            }
            if self.pos >= self.cs.len() {
                return Err(json_err(self.pos, "Unterminated string starting at"));
            }
            let e = self.cs[self.pos];
            self.pos += 1;
            if e == 'n' {
                out.push('\n');
            } else if e == 't' {
                out.push('\t');
            } else if e == 'r' {
                out.push('\r');
            } else if e == 'b' {
                out.push('\u{8}');
            } else if e == 'f' {
                out.push('\u{c}');
            } else if e == 'u' {
                let u = self.hex4()?;
                if u >= 0xd800 and u <= 0xdbff and self.pos + 1 < self.cs.len() and self.cs[self.pos] == '\\' and self.cs[self.pos + 1] == 'u' {
                    let save = self.pos;
                    self.pos += 2;
                    let v = self.hex4()?;
                    if v >= 0xdc00 and v <= 0xdfff {
                        push_cp(mut out, 0x10000 + (u - 0xd800) * 1024 + (v - 0xdc00));
                        continue;
                    }
                    self.pos = save;
                }
                if u >= 0xd800 and u <= 0xdfff {
                    out.push(sur(u));
                } else {
                    push_cp(mut out, u);
                }
            } else {
                out.push(e);
            }
        }
    }

    fn number(mut ref self) -> Result[JVal, Exc] {
        let start = self.pos;
        let mut float = false;
        while self.pos < self.cs.len() {
            let c = self.cs[self.pos];
            if is_dig(c) or c == '-' or c == '+' {
                self.pos += 1;
            } else if c == '.' or c == 'e' or c == 'E' {
                float = true;
                self.pos += 1;
            } else {
                break;
            }
        }
        let s = chars_str(self.cs, start, self.pos);
        if float {
            match py_float(s) {
                Some(x) => Ok(JVal.Float(x)),
                None => Err(json_err(start, "Expecting value")),
            }
        } else {
            match py_int(s, 10) {
                Some(n) => Ok(JVal.Int(n)),
                None => Err(json_err(start, "Expecting value")),
            }
        }
    }

    fn value(mut ref self) -> Result[JVal, Exc] {
        self.ws();
        if self.pos >= self.cs.len() {
            return Err(json_err(self.pos, "Expecting value"));
        }
        let c = self.cs[self.pos];
        if c == '{' {
            self.pos += 1;
            let mut items: Vec[(String, JVal)] = Vec.new();
            self.ws();
            if self.pos < self.cs.len() and self.cs[self.pos] == '}' {
                self.pos += 1;
                return Ok(JVal.Obj(items));
            }
            loop {
                self.ws();
                if self.pos >= self.cs.len() or self.cs[self.pos] != '"' {
                    return Err(json_err(self.pos, "Expecting property name enclosed in double quotes"));
                }
                let k = self.string()?;
                self.ws();
                if not self.lit(":") {
                    return Err(json_err(self.pos, "Expecting ':' delimiter"));
                }
                let v = self.value()?;
                // A repeated key keeps its first position and takes the last value.
                let mut found = false;
                for i in 0..items.len() {
                    if items[i].0 == k {
                        items[i] = (k.clone(), v.clone());
                        found = true;
                    }
                }
                if not found {
                    items.push((k, v));
                }
                self.ws();
                if self.lit(",") {
                    continue;
                }
                if self.lit("}") {
                    return Ok(JVal.Obj(items));
                }
                return Err(json_err(self.pos, "Expecting ',' delimiter"));
            }
        }
        if c == '[' {
            self.pos += 1;
            let mut items: Vec[JVal] = Vec.new();
            self.ws();
            if self.lit("]") {
                return Ok(JVal.Arr(items));
            }
            loop {
                items.push(self.value()?);
                self.ws();
                if self.lit(",") {
                    continue;
                }
                if self.lit("]") {
                    return Ok(JVal.Arr(items));
                }
                return Err(json_err(self.pos, "Expecting ',' delimiter"));
            }
        }
        if c == '"' {
            return Ok(JVal.Text(self.string()?));
        }
        if self.lit("true") {
            return Ok(JVal.Bool(true));
        }
        if self.lit("false") {
            return Ok(JVal.Bool(false));
        }
        if self.lit("null") {
            return Ok(JVal.Null);
        }
        if self.lit("NaN") {
            return Ok(JVal.Float(0.0 / 0.0));
        }
        if self.lit("Infinity") {
            return Ok(JVal.Float(INF));
        }
        if self.lit("-Infinity") {
            return Ok(JVal.Float(-INF));
        }
        if is_dig(c) or c == '-' {
            return self.number();
        }
        Err(json_err(self.pos, "Expecting value"))
    }
}

fn json_parse(text: ref String) -> Result[JVal, Exc] {
    let mut jp = JsonParser { cs: chs(text), pos: 0 };
    let v = jp.value()?;
    jp.ws();
    if jp.pos < jp.cs.len() {
        return Err(json_err(jp.pos, "Extra data"));
    }
    Ok(v)
}

fn json_get(obj: ref JVal, key: Str) -> Option[JVal] {
    match obj {
        JVal.Obj(items) => {
            for (k, v) in items {
                if *k == key {
                    return Some(v.clone());
                }
            }
            None
        }
        _ => None,
    }
}

fn json_items(v: ref JVal) -> Vec[(String, JVal)] {
    match v {
        JVal.Obj(items) => items.clone(),
        _ => Vec.new(),
    }
}

fn json_int(v: ref JVal) -> i64 {
    match v {
        JVal.Int(n) => n,
        JVal.Bool(b) => if b { 1 } else { 0 },
        JVal.Float(x) => x as i64,
        _ => 0,
    }
}

fn json_num(v: ref JVal) -> Num {
    match v {
        JVal.Float(x) => Num.F(x),
        _ => Num.I(json_int(v)),
    }
}

fn json_bool(v: ref JVal) -> bool {
    match v {
        JVal.Bool(b) => b,
        JVal.Int(n) => n != 0,
        _ => false,
    }
}

fn json_text(v: ref JVal) -> String {
    match v {
        JVal.Text(s) => s.clone(),
        _ => String.new(),
    }
}

fn json_color(v: ref JVal) -> Color {
    let mut c = rgba(0, 0, 0, 0);
    for (k, x) in json_items(v) {
        if k == "r" {
            c.r = json_int(x);
        } else if k == "g" {
            c.g = json_int(x);
        } else if k == "b" {
            c.b = json_int(x);
        } else if k == "a" {
            c.a = json_int(x);
        }
    }
    c
}

fn json_style(fields: ref JVal) -> Style {
    let mut s = default_style();
    for (k, v) in json_items(fields) {
        if k == "fontname" {
            s.fontname = json_text(v);
        } else if k == "fontsize" {
            s.fontsize = json_num(v);
        } else if k == "primarycolor" {
            s.primarycolor = json_color(v);
        } else if k == "secondarycolor" {
            s.secondarycolor = json_color(v);
        } else if k == "tertiarycolor" {
            s.tertiarycolor = json_color(v);
        } else if k == "outlinecolor" {
            s.outlinecolor = json_color(v);
        } else if k == "backcolor" {
            s.backcolor = json_color(v);
        } else if k == "bold" {
            s.bold = json_bool(v);
        } else if k == "italic" {
            s.italic = json_bool(v);
        } else if k == "underline" {
            s.underline = json_bool(v);
        } else if k == "strikeout" {
            s.strikeout = json_bool(v);
        } else if k == "scalex" {
            s.scalex = json_num(v);
        } else if k == "scaley" {
            s.scaley = json_num(v);
        } else if k == "spacing" {
            s.spacing = json_num(v);
        } else if k == "angle" {
            s.angle = json_num(v);
        } else if k == "borderstyle" {
            s.borderstyle = json_int(v);
        } else if k == "outline" {
            s.outline = json_num(v);
        } else if k == "shadow" {
            s.shadow = json_num(v);
        } else if k == "alignment" {
            s.alignment = Align.P(json_int(v));
        } else if k == "marginl" {
            s.marginl = json_int(v);
        } else if k == "marginr" {
            s.marginr = json_int(v);
        } else if k == "marginv" {
            s.marginv = json_int(v);
        } else if k == "alphalevel" {
            s.alphalevel = json_int(v);
        } else if k == "encoding" {
            s.encoding = json_int(v);
        } else if k == "drawing" {
            s.drawing = json_bool(v);
        }
    }
    s
}

fn json_event(fields: ref JVal) -> Event {
    let mut e = new_event(0, 10000, String.new());
    for (k, v) in json_items(fields) {
        if k == "start" {
            e.start = json_int(v);
        } else if k == "end" {
            e.end = json_int(v);
        } else if k == "text" {
            e.text = json_text(v);
        } else if k == "marked" {
            e.marked = json_bool(v);
        } else if k == "layer" {
            e.layer = json_int(v);
        } else if k == "style" {
            e.style = json_text(v);
        } else if k == "name" {
            e.name = json_text(v);
        } else if k == "marginl" {
            e.marginl = json_int(v);
        } else if k == "marginr" {
            e.marginr = json_int(v);
        } else if k == "marginv" {
            e.marginv = json_int(v);
        } else if k == "effect" {
            e.effect = json_text(v);
        } else if k == "type" {
            e.kind = json_text(v);
        }
    }
    e
}

fn json_read(subs: mut ref Subs, text: ref String) -> Result[(), Exc] {
    let data = json_parse(text)?;
    let info = match json_get(data, "info") {
        Some(v) => v,
        None => return Err(exc("KeyError", "'info'".to_string())),
    };
    subs.info.clear();
    for (k, v) in json_items(info) {
        kv_set(mut subs.info, k, json_text(v));
    }
    let styles = match json_get(data, "styles") {
        Some(v) => v,
        None => return Err(exc("KeyError", "'styles'".to_string())),
    };
    subs.styles.clear();
    for (name, fields) in json_items(styles) {
        style_set(mut subs.styles, name, json_style(fields));
    }
    let events = match json_get(data, "events") {
        Some(v) => v,
        None => return Err(exc("KeyError", "'events'".to_string())),
    };
    let mut evs: Vec[Event] = Vec.new();
    match events {
        JVal.Arr(items) => {
            for f in items {
                evs.push(json_event(f));
            }
        }
        _ => {}
    }
    subs.events = evs;
    Ok(())
}

// json.dumps with ensure_ascii.
fn json_str(s: ref String) -> String {
    let mut out = String.new();
    out.push('"');
    for c in s.chars() {
        let n = py_cp(c);
        if c == '"' {
            out.push_str("\\\"");
        } else if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if n == 8 {
            out.push_str("\\b");
        } else if n == 12 {
            out.push_str("\\f");
        } else if n < 0x20 or n > 0x7e {
            if n >= 0x10000 {
                let v = n - 0x10000;
                out.push_str(f"\\u{hex_digits(0xd800 + v / 1024, 4)}\\u{hex_digits(0xdc00 + v % 1024, 4)}");
            } else {
                out.push_str(f"\\u{hex_digits(n, 4)}");
            }
        } else {
            out.push(c);
        }
    }
    out.push('"');
    out
}

fn json_float(x: f64) -> String {
    if x != x {
        "NaN".to_string()
    } else if x == INF {
        "Infinity".to_string()
    } else if x == -INF {
        "-Infinity".to_string()
    } else {
        float_repr(x)
    }
}

fn json_numv(n: ref Num) -> String {
    match n {
        Num.I(i) => f"{i}",
        Num.F(x) => json_float(x),
    }
}

fn json_colorv(c: ref Color) -> String {
    f"{{\"r\": {c.r}, \"g\": {c.g}, \"b\": {c.b}, \"a\": {c.a}}}"
}

fn json_boolv(b: bool) -> String {
    if b { "true".to_string() } else { "false".to_string() }
}

fn json_stylev(s: ref Style) -> String {
    let mut parts: Vec[String] = Vec.new();
    parts.push(f"\"fontname\": {json_str(s.fontname)}");
    parts.push(f"\"fontsize\": {json_numv(s.fontsize)}");
    parts.push(f"\"primarycolor\": {json_colorv(s.primarycolor)}");
    parts.push(f"\"secondarycolor\": {json_colorv(s.secondarycolor)}");
    parts.push(f"\"tertiarycolor\": {json_colorv(s.tertiarycolor)}");
    parts.push(f"\"outlinecolor\": {json_colorv(s.outlinecolor)}");
    parts.push(f"\"backcolor\": {json_colorv(s.backcolor)}");
    parts.push(f"\"bold\": {json_boolv(s.bold)}");
    parts.push(f"\"italic\": {json_boolv(s.italic)}");
    parts.push(f"\"underline\": {json_boolv(s.underline)}");
    parts.push(f"\"strikeout\": {json_boolv(s.strikeout)}");
    parts.push(f"\"scalex\": {json_numv(s.scalex)}");
    parts.push(f"\"scaley\": {json_numv(s.scaley)}");
    parts.push(f"\"spacing\": {json_numv(s.spacing)}");
    parts.push(f"\"angle\": {json_numv(s.angle)}");
    parts.push(f"\"borderstyle\": {s.borderstyle}");
    parts.push(f"\"outline\": {json_numv(s.outline)}");
    parts.push(f"\"shadow\": {json_numv(s.shadow)}");
    parts.push(f"\"alignment\": {align_value(s.alignment)}");
    parts.push(f"\"marginl\": {s.marginl}");
    parts.push(f"\"marginr\": {s.marginr}");
    parts.push(f"\"marginv\": {s.marginv}");
    parts.push(f"\"alphalevel\": {s.alphalevel}");
    parts.push(f"\"encoding\": {s.encoding}");
    parts.push(f"\"drawing\": {json_boolv(s.drawing)}");
    f"{{{join_with(parts, ", ".to_string())}}}"
}

fn json_eventv(e: ref Event) -> String {
    let mut parts: Vec[String] = Vec.new();
    parts.push(f"\"start\": {e.start}");
    parts.push(f"\"end\": {e.end}");
    parts.push(f"\"text\": {json_str(e.text)}");
    parts.push(f"\"marked\": {json_boolv(e.marked)}");
    parts.push(f"\"layer\": {e.layer}");
    parts.push(f"\"style\": {json_str(e.style)}");
    parts.push(f"\"name\": {json_str(e.name)}");
    parts.push(f"\"marginl\": {e.marginl}");
    parts.push(f"\"marginr\": {e.marginr}");
    parts.push(f"\"marginv\": {e.marginv}");
    parts.push(f"\"effect\": {json_str(e.effect)}");
    parts.push(f"\"type\": {json_str(e.kind)}");
    f"{{{join_with(parts, ", ".to_string())}}}"
}

fn json_write(subs: ref Subs, k: mut ref Sink) -> Result[(), Exc] {
    let mut info: Vec[String] = Vec.new();
    for (key, v) in subs.info {
        info.push(f"{json_str(key)}: {json_str(v)}");
    }
    let mut styles: Vec[String] = Vec.new();
    for (name, s) in subs.styles {
        styles.push(f"{json_str(name)}: {json_stylev(s)}");
    }
    let mut events: Vec[String] = Vec.new();
    for e in subs.events {
        events.push(json_eventv(e));
    }
    let sep = ", ".to_string();
    put(mut k, f"{{\"info\": {{{join_with(info, sep)}}}, \"styles\": {{{join_with(styles, sep)}}}, \"events\": [{join_with(events, sep)}]}}")
}

fn guess_json(text: ref String) -> Option[String] {
    if text.starts_with("{\"") and text.contains("\"info\":") { Some("json".to_string()) } else { None }
}

// ------------------------------------------------------------ the format table

fn format_ids() -> Vec[Str] {
    vec!["srt", "ass", "ssa", "microdvd", "json", "mpl2", "tmp", "vtt", "sami", "whisper_jax", "ttml"]
}

fn ext_table() -> Vec[(Str, Str)] {
    vec![(".srt", "srt"), (".ass", "ass"), (".ssa", "ssa"), (".sub", "microdvd"), (".json", "json"), (".txt", "tmp"),
         (".vtt", "vtt"), (".sami", "sami"), (".smi", "sami"), (".ttml", "ttml")]
}

fn unknown_format(fmt: ref String) -> Exc {
    exc("UnknownFormatIdentifierError", f"Format identifier {py_repr_str(fmt)} does not match any supported subtitle format")
}

fn check_format(fmt: ref String) -> Result[(), Exc] {
    for x in format_ids() {
        if *fmt == *x {
            return Ok(());
        }
    }
    Err(unknown_format(fmt))
}

fn get_format_identifier(ext: ref String) -> Result[String, Exc] {
    for (e, f) in ext_table() {
        if *ext == e {
            return Ok(f.to_string());
        }
    }
    Err(exc("UnknownFileExtensionError", f"File extension {py_repr_str(ext)} does not match any supported subtitle format"))
}

fn get_file_extension(fmt: ref String) -> Result[String, Exc] {
    check_format(fmt)?;
    for (e, f) in ext_table() {
        if *fmt == f {
            return Ok(e.to_string());
        }
    }
    Err(exc("RuntimeError", f"No file extension for format {py_repr_str(fmt)}"))
}

fn guess_sami(text: ref String) -> Option[String] {
    if py_lstrip(text).starts_with("<SAMI>") { Some("sami".to_string()) } else { None }
}

fn guess_ttml(text: ref String) -> Option[String] {
    if text.contains("http://www.w3.org/ns/ttml") { Some("ttml".to_string()) } else { None }
}

// autodetect_format: every format's guess, as a sorted set.
fn guesses(p: ref Pats, text: ref String) -> Vec[String] {
    let mut all: Vec[Option[String]] = Vec.new();
    all.push(guess_srt(p, text));
    all.push(guess_substation(p, text));
    all.push(guess_microdvd(p, text));
    all.push(guess_json(text));
    all.push(guess_mpl2(p, text));
    all.push(guess_tmp(p, text));
    all.push(guess_vtt(text));
    all.push(guess_sami(text));
    all.push(guess_whisper(p, text));
    all.push(guess_ttml(text));
    let mut out: Vec[String] = Vec.new();
    for g in all {
        if let Some(f) = g {
            let mut seen = false;
            for x in out {
                if *x == f {
                    seen = true;
                }
            }
            if not seen {
                out.push(f.clone());
            }
        }
    }
    let n = out.len();
    for i in 1..n {
        let mut j = i;
        while j > 0 and out[j - 1] > out[j] {
            out.swap(j - 1, j);
            j -= 1;
        }
    }
    out
}

fn autodetect(p: ref Pats, text: ref String) -> Result[String, Exc] {
    let fragment = chars_str(chs(text), 0, min_i(char_count(text), 10000));
    let g = guesses(p, fragment);
    if g.len() == 1 {
        Ok(g[0].clone())
    } else if g.len() == 0 {
        Err(exc("FormatAutodetectionError", "No suitable formats".to_string()))
    } else {
        Err(exc("FormatAutodetectionError", f"Multiple suitable formats ({list_repr(g)})"))
    }
}

fn min_i(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

fn not_ported(what: Str) -> Exc {
    exc("NotImplementedError", f"{what} is outside this port")
}

// FormatBase.from_file for the chosen format, over the lines of fp.
fn read_format(w: mut ref World, p: ref Pats, subs: mut ref Subs, text: ref String, fmt: ref String, o: ref ReadOpts) -> Result[(), Exc] {
    let lines = stream_lines(text);
    if *fmt == "srt" {
        srt_read(mut w, p, mut subs, lines, false, o)
    } else if *fmt == "vtt" {
        srt_read(mut w, p, mut subs, lines, true, o)
    } else if *fmt == "ass" or *fmt == "ssa" {
        ss_read(mut w, p, mut subs, lines, fmt)
    } else if *fmt == "microdvd" {
        md_read(mut w, p, mut subs, lines, o)
    } else if *fmt == "json" {
        json_read(mut subs, text)
    } else if *fmt == "mpl2" {
        mpl2_read(mut w, p, mut subs, lines)
    } else if *fmt == "tmp" {
        tmp_read(mut w, p, mut subs, lines)
    } else if *fmt == "whisper_jax" {
        whisper_read(mut w, p, mut subs, lines)
    } else {
        Err(not_ported("Reading SAMI and TTML"))
    }
}

fn write_format(w: mut ref World, p: ref Pats, subs: mut ref Subs, k: mut ref Sink, fmt: ref String, o: ref WriteOpts) -> Result[(), Exc] {
    check_format(fmt)?;
    if *fmt == "srt" {
        srt_write(mut w, p, subs, mut k, false, o)
    } else if *fmt == "vtt" {
        srt_write(mut w, p, subs, mut k, true, o)
    } else if *fmt == "ass" or *fmt == "ssa" {
        ss_write(mut w, mut subs, mut k, fmt, o.header)
    } else if *fmt == "microdvd" {
        md_write(p, subs, mut k, o)
    } else if *fmt == "json" {
        json_write(subs, mut k)
    } else if *fmt == "mpl2" {
        mpl2_write(p, subs, mut k)
    } else if *fmt == "tmp" {
        tmp_write(mut w, p, subs, mut k, o)
    } else if *fmt == "whisper_jax" {
        Err(exc("NotImplementedError", "Writing is not supported for this format".to_string()))
    } else {
        Err(not_ported("Writing SAMI and TTML"))
    }
}

// ------------------------------------------------------------ SSAFile load, save, to_string

fn errors_se(errors: ref Option[String]) -> bool {
    match errors {
        Some(e) => *e == "surrogateescape",
        None => false,
    }
}

// SSAFile.from_file over decoded text; `stream` is false for a StringIO,
// whose lines split on "\n" alone.
fn from_text(w: mut ref World, p: ref Pats, text: ref String, fmt: ref Option[String], o: ref ReadOpts) -> Result[Subs, Exc] {
    let f = match fmt {
        Some(f) => f.clone(),
        None => autodetect(p, text)?,
    };
    check_format(f)?;
    let mut subs = new_subs();
    subs.format = Some(f.clone());
    read_format(mut w, p, mut subs, text, f, o)?;
    Ok(subs)
}

fn load(w: mut ref World, p: ref Pats, path: ref String, enc: ref String, fmt: ref Option[String], errors: ref Option[String], o: ref ReadOpts) -> Result[Subs, Exc] {
    let data = fs_read(w, path)?;
    let codec = codec_lookup(enc)?;
    if let Some(f) = fmt {
        check_format(f)?;
    }
    let text = universal(decode(codec, data, errors_se(errors))?);
    from_text(mut w, p, text, fmt, o)
}

fn save(w: mut ref World, p: ref Pats, subs: mut ref Subs, path: ref String, enc: ref String, fmt: ref Option[String], errors: ref Option[String], o: ref WriteOpts) -> Result[(), Exc] {
    let f = match fmt {
        Some(f) => f.clone(),
        None => get_format_identifier(lower_ascii(path_suffix(path)))?,
    };
    fs_create(mut w, path)?;
    let codec = codec_lookup(enc)?;
    let mut k = file_sink(codec, errors_se(errors));
    let r = write_format(mut w, p, mut subs, mut k, f, o);
    fs_put(mut w, path, k.bytes.clone());
    r
}

fn to_string(w: mut ref World, p: ref Pats, subs: mut ref Subs, fmt: ref String, o: ref WriteOpts) -> Result[String, Exc] {
    let mut k = str_sink();
    write_format(mut w, p, mut subs, mut k, fmt, o)?;
    Ok(k.text.clone())
}

// ------------------------------------------------------------ SSAFile operations

fn shift_subs(subs: mut ref Subs, t: ref TimeArgs) -> Result[(), Exc] {
    let delta = make_time(t)?;
    for i in 0..subs.events.len() {
        subs.events[i].start += delta;
        subs.events[i].end += delta;
    }
    Ok(())
}

fn transform_framerate(subs: mut ref Subs, a: ref Num, b: ref Num) -> Result[(), Exc] {
    if num_f(a) <= 0.0 or num_f(b) <= 0.0 {
        return Err(exc("ValueError", f"Framerates must be positive, cannot transform {num_repr(a)} -> {num_repr(b)}"));
    }
    let ratio = num_f(a) / num_f(b);
    for i in 0..subs.events.len() {
        subs.events[i].start = round_even((subs.events[i].start as f64) * ratio);
        subs.events[i].end = round_even((subs.events[i].end as f64) * ratio);
    }
    Ok(())
}

fn style_index(styles: ref Vec[(String, Style)], name: ref String) -> i64 {
    for i in 0..styles.len() {
        if styles[i].0 == *name {
            return i;
        }
    }
    -1
}

fn rename_style(subs: mut ref Subs, old: ref String, new: ref String) -> Result[(), Exc] {
    let i = style_index(subs.styles, old);
    if i < 0 {
        // str(KeyError(msg)) is the repr of its message.
        return Err(exc("KeyError", py_repr_str(f"Style {py_repr_str(old)} not found")));
    }
    if style_index(subs.styles, new) >= 0 {
        return Err(exc("ValueError", f"There is already a style called {py_repr_str(new)}"));
    }
    if not is_valid_field_content(new) {
        return Err(exc("ValueError", f"{py_repr_str(new)} is not a valid name"));
    }
    let sty = subs.styles[i].1.clone();
    subs.styles.push((new.clone(), sty));
    subs.styles.remove(i);
    for j in 0..subs.events.len() {
        if subs.events[j].style == *old {
            subs.events[j].style = new.clone();
        }
    }
    Ok(())
}

fn import_styles(subs: mut ref Subs, other: ref Subs, overwrite: bool) {
    for (name, sty) in other.styles {
        if style_index(subs.styles, name) < 0 or overwrite {
            style_set(mut subs.styles, name, sty);
        }
    }
}

fn remove_miscellaneous(p: ref Pats, subs: mut ref Subs) {
    let n = subs.events.len();
    let mut dup: Vec[bool] = Vec.new();
    let mut texts: Vec[(i64, i64, String)] = Vec.new();
    for i in 0..n {
        let e = subs.events[i].clone();
        let pt = plaintext(p, e);
        let mut seen = false;
        for (a, b, t) in texts {
            if a == e.start and b == e.end and t == pt {
                seen = true;
            }
        }
        dup.push(seen);
        texts.push((e.start, e.end, pt));
    }
    let mut kept: Vec[Event] = Vec.new();
    for i in 0..n {
        let e = subs.events[i].clone();
        if is_drawing(p, e) or is_comment(e) {
            continue;
        }
        if char_count(py_strip(plaintext(p, e))) < 2 {
            continue;
        }
        if dup[i] {
            continue;
        }
        kept.push(e);
    }
    subs.events = kept;
}

fn opaque_eq(x: ref Vec[(String, Vec[String])], y: ref Vec[(String, Vec[String])]) -> bool {
    for (k, v) in x {
        let mut found = false;
        for (k2, v2) in y {
            if *k == *k2 {
                found = true;
                if v.len() != v2.len() {
                    return false;
                }
                for i in 0..v.len() {
                    if v[i] != v2[i] {
                        return false;
                    }
                }
            }
        }
        if not found {
            return false;
        }
    }
    for (k, _) in y {
        let mut found = false;
        for (k2, _) in x {
            if *k == *k2 {
                found = true;
            }
        }
        if not found {
            return false;
        }
    }
    true
}

// SSAFile.equals. Python walks each key set in set order and stops at the
// first difference; the result and the one FIELDS warning do not depend
// on that order for these files, so the keys go in insertion order.
fn subs_equals(w: mut ref World, a: ref Subs, b: ref Subs) -> bool {
    let mut keys: Vec[String] = Vec.new();
    for (k, _) in a.info {
        keys.push(k.clone());
    }
    for (k, _) in b.info {
        keys.push(k.clone());
    }
    for k in keys {
        if *k == "ScriptType" {
            continue;
        }
        match (kv_get(a.info, k), kv_get(b.info, k)) {
            (Some(x), Some(y)) => {
                if x != y {
                    return false;
                }
            }
            _ => return false,
        }
    }
    if not opaque_eq(a.fonts, b.fonts) or not opaque_eq(a.graphics, b.graphics) {
        return false;
    }
    let mut names: Vec[String] = Vec.new();
    for (k, _) in a.styles {
        names.push(k.clone());
    }
    for (k, _) in b.styles {
        names.push(k.clone());
    }
    for k in names {
        match (style_get(a.styles, k), style_get(b.styles, k)) {
            (Some(x), Some(y)) => {
                if not style_eq(x, y) {
                    warn(mut w, "DeprecationWarning", "Deprecated in 1.2.0 - it's a dataclass now".to_string());
                    return false;
                }
            }
            _ => return false,
        }
    }
    if a.events.len() != b.events.len() {
        return false;
    }
    for i in 0..a.events.len() {
        if not event_equals(a.events[i], b.events[i]) {
            warn(mut w, "DeprecationWarning", "Deprecated in 1.2.0 - it's a dataclass now".to_string());
            return false;
        }
    }
    true
}

fn ev_lt(x: ref Event, y: ref Event) -> bool {
    x.start < y.start or (x.start == y.start and x.end < y.end)
}

fn sort_events(subs: mut ref Subs) {
    let n = subs.events.len();
    for i in 1..n {
        let mut j = i;
        while j > 0 and ev_lt(subs.events[j], subs.events[j - 1]) {
            subs.events.swap(j - 1, j);
            j -= 1;
        }
    }
}

// A Python list index: negative counts from the end.
fn py_index(i: i64, n: i64) -> Option[i64] {
    let k = if i < 0 { i + n } else { i };
    if k < 0 or k >= n { None } else { Some(k) }
}

fn insert_at(i: i64, n: i64) -> i64 {
    let mut k = if i < 0 { i + n } else { i };
    if k < 0 {
        k = 0;
    }
    if k > n {
        k = n;
    }
    k
}

// ------------------------------------------------------------ the command line (argparse)

// The fields are String rather than Str. A struct that can hold a view, passed
// as `mut ref`, may take in the call's other reference arguments
// (core-semantics.md §5.3), so a Str field would keep the parser's buffers
// borrowed for as long as the parser lives.
struct Act {
    opts: Vec[String],
    nargs: i64,
    name: String,
}

const NARGS_ONE: i64 = -1;
const NARGS_STAR: i64 = -2;

fn act(opts: own Vec[Str], nargs: i64, name: Str) -> Act {
    let mut v: Vec[String] = Vec.new();
    for o in opts {
        v.push(o.to_string());
    }
    Act { opts: v, nargs: nargs, name: name.to_string() }
}

fn cli_actions() -> Vec[Act] {
    let mut v: Vec[Act] = Vec.new();
    v.push(act(vec!["-h", "--help"], 0, "help"));
    v.push(act(Vec.new(), NARGS_STAR, "files"));
    v.push(act(vec!["-v", "--version"], 0, "version"));
    v.push(act(vec!["-f", "--from"], NARGS_ONE, "input_format"));
    v.push(act(vec!["-t", "--to"], NARGS_ONE, "output_format"));
    v.push(act(vec!["--input-enc"], NARGS_ONE, "input_enc"));
    v.push(act(vec!["--output-enc"], NARGS_ONE, "output_enc"));
    v.push(act(vec!["--enc-error-handling"], NARGS_ONE, "enc_error_handling"));
    v.push(act(vec!["--fps"], NARGS_ONE, "fps"));
    v.push(act(vec!["-o", "--output-dir"], NARGS_ONE, "output_dir"));
    v.push(act(vec!["--clean"], 0, "clean"));
    v.push(act(vec!["--verbose"], 0, "verbose"));
    v.push(act(vec!["--shift"], NARGS_ONE, "shift"));
    v.push(act(vec!["--shift-back"], NARGS_ONE, "shift_back"));
    v.push(act(vec!["--transform-framerate"], 2, "transform_framerate"));
    v.push(act(vec!["--srt-keep-unknown-html-tags"], 0, "srt_keep_unknown_html_tags"));
    v.push(act(vec!["--srt-keep-html-tags"], 0, "srt_keep_html_tags"));
    v.push(act(vec!["--srt-keep-ssa-tags"], 0, "srt_keep_ssa_tags"));
    v.push(act(vec!["--sub-no-write-fps-declaration"], 0, "sub_no_write_fps_declaration"));
    v
}

// The option strings in the order they were added, with their action.
fn option_strings(acts: ref Vec[Act]) -> Vec[(String, i64)] {
    let mut v: Vec[(String, i64)] = Vec.new();
    for i in 0..acts.len() {
        for o in acts[i].opts {
            v.push((o.to_string(), i));
        }
    }
    v
}

fn action_name(a: ref Act) -> String {
    if a.opts.len() == 0 {
        "FILE".to_string()
    } else {
        let mut parts: Vec[String] = Vec.new();
        for o in a.opts {
            parts.push(o.to_string());
        }
        join_with(parts, "/".to_string())
    }
}

#[derive(Clone)]
struct Opt {
    act: i64,
    text: String,
    sep: Option[String],
    explicit: Option[String],
}

struct CliArgs {
    files: Vec[String],
    input_format: Option[String],
    output_format: Option[String],
    input_enc: String,
    output_enc: Option[String],
    errh: String,
    fps: Option[f64],
    output_dir: Option[String],
    clean: bool,
    verbose: bool,
    shift: Option[i64],
    shift_back: Option[i64],
    tf: Option[(f64, f64)],
    keep_unknown: bool,
    keep_html: bool,
    keep_ssa: bool,
    no_fps_decl: bool,
}

fn default_args() -> CliArgs {
    CliArgs {
        files: Vec.new(),
        input_format: None,
        output_format: None,
        input_enc: "utf-8".to_string(),
        output_enc: None,
        errh: "surrogateescape".to_string(),
        fps: None,
        output_dir: None,
        clean: false,
        verbose: false,
        shift: None,
        shift_back: None,
        tf: None,
        keep_unknown: false,
        keep_html: false,
        keep_ssa: false,
        no_fps_decl: false,
    }
}

// How argparse stops: an ArgumentError (usage plus message, status 2), or
// an action that exits (help and version, status 0).
enum Stop {
    Error(String),
    Exit(i64),
}

struct Cli {
    out: String,
    err: String,
}

fn find_opt(table: ref Vec[(String, i64)], s: ref String) -> i64 {
    for (o, i) in table {
        if *o == *s {
            return i;
        }
    }
    -1
}

// str.partition('=')
fn partition_eq(s: ref String) -> (String, bool, String) {
    let cs = chs(s);
    for i in 0..cs.len() {
        if cs[i] == '=' {
            return (chars_str(cs, 0, i), true, chars_str(cs, i + 1, cs.len()));
        }
    }
    (s.clone(), false, String.new())
}

fn option_tuples(table: ref Vec[(String, i64)], s: ref String) -> Vec[Opt] {
    let cs = chs(s);
    let mut out: Vec[Opt] = Vec.new();
    let (prefix, has_sep, explicit) = partition_eq(s);
    let sep = if has_sep { Some("=".to_string()) } else { None };
    let exp = if has_sep { Some(explicit) } else { None };
    if cs[1] == '-' {
        for (o, i) in table {
            if o.starts_with(prefix) {
                out.push(Opt { act: i, text: o.clone(), sep: sep.clone(), explicit: exp.clone() });
            }
        }
    } else {
        let short = chars_str(cs, 0, 2);
        let short_explicit = chars_str(cs, 2, cs.len());
        for (o, i) in table {
            if *o == short {
                out.push(Opt { act: i, text: o.clone(), sep: Some(String.new()), explicit: Some(short_explicit.clone()) });
            } else if o.starts_with(prefix) {
                out.push(Opt { act: i, text: o.clone(), sep: sep.clone(), explicit: exp.clone() });
            }
        }
    }
    out
}

fn parse_optional(p: ref Pats, table: ref Vec[(String, i64)], s: ref String) -> Option[Vec[Opt]] {
    if s.len() == 0 or not s.starts_with("-") {
        return None;
    }
    let i = find_opt(table, s);
    if i >= 0 {
        return Some(vec![Opt { act: i, text: s.clone(), sep: None, explicit: None }]);
    }
    if char_count(s) == 1 {
        return None;
    }
    let (o, has_sep, explicit) = partition_eq(s);
    if has_sep {
        let j = find_opt(table, o);
        if j >= 0 {
            return Some(vec![Opt { act: j, text: o, sep: Some("=".to_string()), explicit: Some(explicit) }]);
        }
    }
    let tuples = option_tuples(table, s);
    if tuples.len() > 0 {
        return Some(tuples);
    }
    if re_match(p.negative_number, s).is_some() {
        return None;
    }
    if s.contains(" ") {
        return None;
    }
    Some(vec![Opt { act: -1, text: s.clone(), sep: None, explicit: None }])
}

// _match_argument for an optional: how many of the following strings it takes.
fn match_argument(a: ref Act, pattern: ref Vec[char], from: i64) -> Result[i64, Stop] {
    let avail = pattern.len() - from;
    if a.nargs == 0 {
        return Ok(0);
    }
    if a.nargs == NARGS_ONE {
        if avail >= 1 and pattern[from] == 'A' {
            return Ok(1);
        }
        return Err(Stop.Error(f"argument {action_name(a)}: expected one argument"));
    }
    let n = a.nargs;
    let mut ok = avail >= n;
    if ok {
        for i in 0..n {
            if pattern[from + i] != 'A' and pattern[from + i] != 'O' {
                ok = false;
            }
        }
    }
    if ok { Ok(n) } else { Err(Stop.Error(f"argument {action_name(a)}: expected {n} arguments")) }
}

fn positive_float(a: ref Act, s: ref String) -> Result[f64, Stop] {
    match py_float(s) {
        None => Err(Stop.Error(f"argument {action_name(a)}: invalid positive_float value: {py_repr_str(s)}")),
        Some(x) => {
            if x > 0.0 {
                Ok(x)
            } else {
                Err(Stop.Error(f"argument {action_name(a)}: {py_repr_str(s)} is not a positive number"))
            }
        }
    }
}

// cli.time: "1m30.5s" and the like.
fn cli_time(p: ref Pats, a: ref Act, s: ref String) -> Result[i64, Stop] {
    let mut t = time_args();
    for g in re_findall(p.cli_time, s) {
        let v = match py_float(g[0]) {
            Some(x) => x,
            None => return Err(Stop.Error(f"argument {action_name(a)}: invalid time value: {py_repr_str(s)}")),
        };
        if g[1] == "h" {
            t.h = Num.F(v);
        } else if g[1] == "m" {
            t.m = Num.F(v);
        } else if g[1] == "s" {
            t.s = Num.F(v);
        } else {
            t.ms = Num.F(v);
        }
    }
    Ok(make_time(t).unwrap())
}

fn check_choice(a: ref Act, v: ref String, choices: ref Vec[Str]) -> Result[(), Stop] {
    for c in choices {
        if *v == *c {
            return Ok(());
        }
    }
    let mut shown: Vec[String] = Vec.new();
    for c in choices {
        shown.push(py_repr_str(c.to_string()));
    }
    Err(Stop.Error(f"argument {action_name(a)}: invalid choice: {py_repr_str(v)} (choose from {join_with(shown, ", ".to_string())})"))
}

fn character_encoding(s: ref String) -> Result[String, Stop] {
    match codec_lookup(s) {
        Ok(_) => Ok(s.clone()),
        Err(_) => Err(Stop.Error(f"unknown character encoding: {s}")),
    }
}

struct ArgParser {
    acts: Vec[Act],
    seen_non_default: Vec[i64],
    args: CliArgs,
}

// take_action: convert, check the mutually exclusive group, store.
fn take_action(cli: mut ref Cli, p: ref Pats, ps: mut ref ArgParser, ai: i64, strings: ref Vec[String], has_opt: bool) -> Result[(), Stop] {
    let a = ps.acts[ai].clone_act();
    let name = a.name.clone();
    let one = if strings.len() > 0 { strings[0].clone() } else { String.new() };
    // Conversion happens before the conflict check.
    if name == "files" {
        let mut files: Vec[String] = Vec.new();
        for s in strings {
            files.push(path_str(s));
        }
        ps.args.files = files;
    } else if name == "input_format" {
        check_choice(a, one, format_ids())?;
        ps.args.input_format = Some(one.clone());
    } else if name == "output_format" {
        check_choice(a, one, format_ids())?;
        ps.args.output_format = Some(one.clone());
    } else if name == "input_enc" {
        ps.args.input_enc = character_encoding(one)?;
    } else if name == "output_enc" {
        ps.args.output_enc = Some(character_encoding(one)?);
    } else if name == "enc_error_handling" {
        check_choice(a, one, vec!["strict", "surrogateescape"])?;
        ps.args.errh = one.clone();
    } else if name == "fps" {
        ps.args.fps = Some(positive_float(a, one)?);
    } else if name == "output_dir" {
        ps.args.output_dir = Some(path_str(one));
    } else if name == "shift" {
        ps.args.shift = Some(cli_time(p, a, one)?);
    } else if name == "shift_back" {
        ps.args.shift_back = Some(cli_time(p, a, one)?);
    } else if name == "transform_framerate" {
        let x = positive_float(a, strings[0])?;
        let y = positive_float(a, strings[1])?;
        ps.args.tf = Some((x, y));
    }
    if has_opt or strings.len() > 0 {
        let mutex: Vec[i64] = vec![12, 13, 14];
        let mut in_group = false;
        for m in mutex {
            if *m == ai {
                in_group = true;
            }
        }
        if in_group {
            for m in mutex {
                if *m != ai {
                    for s in ps.seen_non_default {
                        if *s == *m {
                            return Err(Stop.Error(f"argument {action_name(a)}: not allowed with argument {action_name(ps.acts[*m])}"));
                        }
                    }
                }
            }
        }
        ps.seen_non_default.push(ai);
    }
    if name == "help" {
        cli.out.push_str(help_text());
        return Err(Stop.Exit(0));
    } else if name == "version" {
        cli.out.push_str("pysubs2 1.9.0\n");
        return Err(Stop.Exit(0));
    } else if name == "clean" {
        ps.args.clean = true;
    } else if name == "verbose" {
        ps.args.verbose = true;
    } else if name == "srt_keep_unknown_html_tags" {
        ps.args.keep_unknown = true;
    } else if name == "srt_keep_html_tags" {
        ps.args.keep_html = true;
    } else if name == "srt_keep_ssa_tags" {
        ps.args.keep_ssa = true;
    } else if name == "sub_no_write_fps_declaration" {
        ps.args.no_fps_decl = true;
    }
    Ok(())
}

impl Act {
    fn clone_act(ref self) -> Act {
        Act { opts: self.opts.clone(), nargs: self.nargs, name: self.name.clone() }
    }
}

// _match_arguments_partial for the one positional (nargs='*').
fn match_files(pattern: ref Vec[char], from: i64) -> Vec[i64] {
    let mut n = 0;
    while from + n < pattern.len() and (pattern[from + n] == 'A' or pattern[from + n] == '-') {
        n += 1;
    }
    if n == 0 and from < pattern.len() and pattern[from] == 'O' {
        Vec.new()
    } else {
        vec![n]
    }
}

fn parse_cli(cli: mut ref Cli, p: ref Pats, argv: ref Vec[String]) -> Result[CliArgs, Stop] {
    let acts = cli_actions();
    let table = option_strings(acts);
    let mut pattern: Vec[char] = Vec.new();
    let mut opt_at: Vec[Option[Vec[Opt]]] = Vec.new();
    let mut after_dashes = false;
    for s in argv {
        if after_dashes {
            pattern.push('A');
            opt_at.push(None);
        } else if *s == "--" {
            pattern.push('-');
            opt_at.push(None);
            after_dashes = true;
        } else {
            match parse_optional(p, table, s) {
                None => {
                    pattern.push('A');
                    opt_at.push(None);
                }
                Some(t) => {
                    pattern.push('O');
                    opt_at.push(Some(t));
                }
            }
        }
    }
    let mut ps = ArgParser { acts: acts, seen_non_default: Vec.new(), args: default_args() };
    let mut extras: Vec[String] = Vec.new();
    let mut positionals_left = true;
    let mut max_opt = -1;
    for i in 0..opt_at.len() {
        if opt_at[i].is_some() {
            max_opt = i;
        }
    }
    let mut start = 0;
    while start <= max_opt {
        let mut next = start;
        while next <= max_opt and opt_at[next].is_none() {
            next += 1;
        }
        if start != next {
            let end = consume_positionals(mut cli, p, mut ps, argv, pattern, start, mut positionals_left)?;
            if end > start {
                start = end;
                continue;
            }
            start = end;
        }
        if opt_at[start].is_none() {
            for i in start..next {
                extras.push(argv[i].clone());
            }
            start = next;
        }
        start = consume_optional(mut cli, p, mut ps, argv, pattern, opt_at, start, mut extras)?;
    }
    let stop = consume_positionals(mut cli, p, mut ps, argv, pattern, start, mut positionals_left)?;
    for i in stop..argv.len() {
        extras.push(argv[i].clone());
    }
    if extras.len() > 0 {
        return Err(Stop.Error(f"unrecognized arguments: {join_with(extras, " ".to_string())}"));
    }
    Ok(ps.args)
}

fn consume_positionals(cli: mut ref Cli, p: ref Pats, ps: mut ref ArgParser, argv: ref Vec[String], pattern: ref Vec[char], start: i64, left: mut ref bool) -> Result[i64, Stop] {
    if not *left {
        return Ok(start);
    }
    let counts = match_files(pattern, start);
    if counts.len() == 0 {
        return Ok(start);
    }
    let n = counts[0];
    let mut args: Vec[String] = Vec.new();
    let mut dropped = false;
    for i in start..(start + n) {
        if pattern[i] == '-' and not dropped {
            dropped = true;
            continue;
        }
        args.push(argv[i].clone());
    }
    *left = false;
    take_action(mut cli, p, mut ps, 1, args, false)?;
    Ok(start + n)
}

fn consume_optional(cli: mut ref Cli, p: ref Pats, ps: mut ref ArgParser, argv: ref Vec[String], pattern: ref Vec[char], opt_at: ref Vec[Option[Vec[Opt]]], start: i64, extras: mut ref Vec[String]) -> Result[i64, Stop] {
    let tuples = opt_at[start].clone().unwrap();
    if tuples.len() > 1 {
        let mut names: Vec[String] = Vec.new();
        for t in tuples {
            names.push(t.text.clone());
        }
        return Err(Stop.Error(f"ambiguous option: {argv[start]} could match {join_with(names, ", ".to_string())}"));
    }
    let table = option_strings(ps.acts);
    let mut cur = tuples[0].clone();
    let mut todo: Vec[(i64, Vec[String], String)] = Vec.new();
    let mut stop = start + 1;
    loop {
        if cur.act < 0 {
            extras.push(argv[start].clone());
            return Ok(start + 1);
        }
        let a = ps.acts[cur.act].clone_act();
        match cur.explicit.clone() {
            Some(explicit) => {
                let count = match_argument(a, vec!['A'], 0)?;
                let oc = chs(cur.text);
                if count == 0 and oc[1] != '-' and explicit.len() > 0 {
                    let sep_set = match cur.sep {
                        Some(s) => s.len() > 0,
                        None => false,
                    };
                    if sep_set or explicit.starts_with("-") {
                        return Err(Stop.Error(f"argument {action_name(a)}: ignored explicit argument {py_repr_str(explicit)}"));
                    }
                    todo.push((cur.act, Vec.new(), cur.text.clone()));
                    let ec = chs(explicit);
                    let mut next = String.new();
                    next.push(oc[0]);
                    next.push(ec[0]);
                    let j = find_opt(table, next);
                    if j >= 0 {
                        let rest = chars_str(ec, 1, ec.len());
                        if rest.len() == 0 {
                            cur = Opt { act: j, text: next, sep: None, explicit: None };
                        } else if rest.starts_with("=") {
                            cur = Opt { act: j, text: next, sep: Some("=".to_string()), explicit: Some(slice_from(rest, 1)) };
                        } else {
                            cur = Opt { act: j, text: next, sep: Some(String.new()), explicit: Some(rest) };
                        }
                    } else {
                        let mut ex = String.new();
                        ex.push(oc[0]);
                        ex.push_str(explicit);
                        extras.push(ex);
                        stop = start + 1;
                        break;
                    }
                } else if count == 1 {
                    stop = start + 1;
                    todo.push((cur.act, vec![explicit.clone()], cur.text.clone()));
                    break;
                } else {
                    return Err(Stop.Error(f"argument {action_name(a)}: ignored explicit argument {py_repr_str(explicit)}"));
                }
            }
            None => {
                let count = match_argument(a, pattern, start + 1)?;
                stop = start + 1 + count;
                let mut args: Vec[String] = Vec.new();
                for i in (start + 1)..stop {
                    args.push(argv[i].clone());
                }
                todo.push((cur.act, args, cur.text.clone()));
                break;
            }
        }
    }
    for (ai, args, _) in todo {
        take_action(mut cli, p, mut ps, ai, args, true)?;
    }
    Ok(stop)
}

// ------------------------------------------------------------ the command line (main)

enum CliEnd {
    Return(i64),
    Exit(i64),
    Raise(Exc),
}

fn cli_process(p: ref Pats, subs: mut ref Subs, args: ref CliArgs) -> Result[(), Exc] {
    if let Some(ms) = args.shift {
        let mut t = time_args();
        t.ms = Num.I(ms);
        shift_subs(mut subs, t)?;
    } else if let Some(ms) = args.shift_back {
        let mut t = time_args();
        t.ms = Num.I(-ms);
        shift_subs(mut subs, t)?;
    } else if let Some((a, b)) = args.tf {
        transform_framerate(mut subs, Num.F(a), Num.F(b))?;
    }
    if args.clean {
        remove_miscellaneous(p, mut subs);
    }
    Ok(())
}

fn cli_main(w: mut ref World, p: ref Pats, cli: mut ref Cli, argv: ref Vec[String]) -> CliEnd {
    let args = match parse_cli(mut cli, p, argv) {
        Ok(a) => a,
        Err(Stop.Exit(code)) => return CliEnd.Exit(code),
        Err(Stop.Error(msg)) => {
            cli.err.push_str(usage_text());
            cli.err.push_str(f"pysubs2: error: {msg}\n");
            return CliEnd.Exit(2);
        }
    };
    match cli_run(mut w, p, mut cli, args) {
        Ok(code) => CliEnd.Return(code),
        Err(e) => CliEnd.Raise(e),
    }
}

fn cli_run(w: mut ref World, p: ref Pats, cli: mut ref Cli, args: ref CliArgs) -> Result[i64, Exc] {
    let mut errors = 0;
    if let Some(d) = args.output_dir {
        if not exists(w, d) {
            fs_makedirs(mut w, d);
        }
    }
    let output_enc = match args.output_enc {
        Some(e) => e.clone(),
        None => args.input_enc.clone(),
    };
    let mut ro = read_opts();
    ro.fps = args.fps;
    ro.keep_unknown = args.keep_unknown;
    ro.keep_html = args.keep_html;
    let mut wo = write_opts();
    wo.fps = args.fps;
    wo.apply_styles = not args.clean;
    wo.keep_ssa_tags = args.keep_ssa;
    wo.write_fps = not args.no_fps_decl;
    let errh = Some(args.errh.clone());
    if args.files.len() == 0 {
        // Standard input is a terminal here, so the CLI prints its help.
        cli.out.push_str(help_text());
        return Ok(1);
    }
    for inpath in args.files {
        if not exists(w, inpath) {
            cli.out.push_str(f"Skipping {inpath} (does not exist)\n");
            errors += 1;
        } else if not is_file(w, inpath) {
            cli.out.push_str(f"Skipping {inpath} (not a file)\n");
            errors += 1;
        } else {
            let mut subs = load(mut w, p, inpath, args.input_enc, args.input_format, errh, ro)?;
            cli_process(p, mut subs, args)?;
            let mut outpath = inpath.clone();
            let output_format = match args.output_format {
                None => subs.format.clone().unwrap(),
                Some(f) => {
                    let ext = get_file_extension(f)?;
                    outpath = path_with_suffix(inpath, ext);
                    f.clone()
                }
            };
            if let Some(d) = args.output_dir {
                outpath = path_join(d, path_name(outpath));
            }
            save(mut w, p, mut subs, outpath, output_enc, Some(output_format), errh, wo)?;
        }
    }
    Ok(if errors == 0 { 0 } else { 1 })
}

// ------------------------------------------------------------ the job runner

fn hex_val(c: char) -> i64 {
    let n = c as i64;
    if n >= 97 { n - 87 } else if n >= 65 { n - 55 } else { n - 48 }
}

fn hex_bytes(s: ref String) -> Vec[u8] {
    let cs: Vec[char] = s.chars().collect();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < cs.len() {
        out.push((hex_val(cs[i]) * 16 + hex_val(cs[i + 1])) as u8);
        i += 2;
    }
    out
}

// An op word: "-" is None, "h:<hex>" a UTF-8 string.
fn word_arg(x: ref String) -> Option[String] {
    if *x == "-" {
        return None;
    }
    if x.starts_with("h:") {
        let cs: Vec[char] = x.chars().collect();
        return Some(String.from_utf8(hex_bytes(chars_str(cs, 2, cs.len()))).unwrap());
    }
    Some(x.clone())
}

fn word_shown(x: ref String) -> String {
    if x.starts_with("h:") {
        return py_repr_str(word_arg(x).unwrap());
    }
    x.clone()
}

// The oracle's num(): an int when it looks like one, else a float.
fn num_word(s: ref String) -> Num {
    let cs = chs(s);
    let mut i = 0;
    if cs.len() > 0 and cs[0] == '-' {
        i = 1;
    }
    let mut all = i < cs.len();
    for k in i..cs.len() {
        if not is_dig(cs[k]) {
            all = false;
        }
    }
    if all { Num.I(py_int(s, 10).unwrap()) } else { Num.F(py_float(s).unwrap()) }
}

struct Kw {
    read: ReadOpts,
    write: WriteOpts,
    time: TimeArgs,
}

fn kwargs_of(words: ref Vec[String], from: i64) -> Kw {
    let mut kw = Kw { read: read_opts(), write: write_opts(), time: time_args() };
    for i in from..words.len() {
        let parts = split_max(words[i], '=', 1);
        let k = parts[0].clone();
        let v = parts[1].clone();
        let flag = v == "1";
        if k == "keep_html_tags" {
            kw.read.keep_html = flag;
        } else if k == "keep_unknown_html_tags" {
            kw.read.keep_unknown = flag;
        } else if k == "strict_fps_inference" {
            kw.read.strict_fps = flag;
        } else if k == "apply_styles" {
            kw.write.apply_styles = flag;
        } else if k == "keep_ssa_tags" {
            kw.write.keep_ssa_tags = flag;
        } else if k == "write_fps_declaration" {
            kw.write.write_fps = flag;
        } else if k == "fps" {
            let f = py_float(v).unwrap();
            kw.read.fps = Some(f);
            kw.write.fps = Some(f);
            kw.time.fps = Some(Num.F(f));
        } else if k == "frames" {
            kw.time.frames = Some(py_int(v, 10).unwrap());
        } else if k == "header_notice" {
            kw.write.header = word_arg(v).unwrap();
        } else if k == "h" {
            kw.time.h = num_word(v);
        } else if k == "m" {
            kw.time.m = num_word(v);
        } else if k == "s" {
            kw.time.s = num_word(v);
        } else if k == "ms" {
            kw.time.ms = num_word(v);
        }
    }
    kw
}

fn text_block(w: mut ref World, s: ref String) {
    for line in split_on(s, '\n') {
        emit(mut w, f"  |{vis(line)}");
    }
}

fn file_block(w: mut ref World, data: ref Vec[u8]) {
    let mut text: Option[String] = None;
    if not data.contains(0) {
        if let Ok(s) = utf8_decode(data, 0, false) {
            text = Some(s);
        }
    }
    match text {
        Some(s) => {
            for line in split_on(s, '\n') {
                emit(mut w, f"    |{vis(line)}");
            }
        }
        None => {
            let mut i = 0;
            while i < data.len() {
                let mut row = String.new();
                let mut k = i;
                while k < data.len() and k < i + 32 {
                    row.push_str(hex_digits(data[k] as i64, 2));
                    k += 1;
                }
                emit(mut w, f"    {row}");
                i += 32;
            }
        }
    }
}

fn opt_str_repr(o: ref Option[String]) -> String {
    match o {
        Some(s) => py_repr_str(s),
        None => "None".to_string(),
    }
}

fn describe(w: mut ref World, p: ref Pats, subs: ref Subs) {
    emit(mut w, f"  repr {subs_repr(subs)}");
    let fps = match subs.fps {
        Some(f) => float_repr(f),
        None => "None".to_string(),
    };
    emit(mut w, f"  format {opt_str_repr(subs.format)}, fps {fps}");
    for (k, v) in subs.info {
        emit(mut w, f"  info {py_repr_str(k)}: {py_repr_str(v)}");
    }
    for (k, v) in subs.aegisub {
        emit(mut w, f"  aegisub {py_repr_str(k)}: {py_repr_str(v)}");
    }
    for (name, sty) in subs.styles {
        emit(mut w, f"  style {py_repr_str(name)} {style_repr(sty)}");
        let fields = style_fields(sty);
        let mut i = 0;
        while i < fields.len() {
            let mut row: Vec[String] = Vec.new();
            let mut k = i;
            while k < fields.len() and k < i + 5 {
                row.push(fields[k].clone());
                k += 1;
            }
            emit(mut w, f"    {join_with(row, " ".to_string())}");
            i += 5;
        }
    }
    for (k, v) in subs.fonts {
        emit(mut w, f"  font {py_repr_str(k)} {list_repr(v)}");
    }
    for (k, v) in subs.graphics {
        emit(mut w, f"  graphic {py_repr_str(k)} {list_repr(v)}");
    }
    for i in 0..subs.events.len() {
        let e = subs.events[i].clone();
        emit(mut w, f"  event {i} {event_repr(e)}");
        emit(mut w, f"    start={e.start} end={e.end} layer={e.layer} style={py_repr_str(e.style)} name={py_repr_str(e.name)} marked={py_bool(e.marked)}");
        emit(mut w, f"    marginl={e.marginl} marginr={e.marginr} marginv={e.marginv} effect={py_repr_str(e.effect)} type={py_repr_str(e.kind)}");
        emit(mut w, f"    text={py_repr_str(e.text)}");
        emit(mut w, f"    plaintext={py_repr_str(plaintext(p, e))} duration={e.end - e.start} is_drawing={py_bool(is_drawing(p, e))} is_text={py_bool(is_text(p, e))}");
    }
}

fn need(s: ref Option[Subs]) -> Result[Subs, Exc] {
    match s {
        Some(x) => Ok(x.clone()),
        None => Err(exc("AttributeError", "'NoneType' object has no attribute 'events'".to_string())),
    }
}

fn arg_at(a: ref Vec[Option[String]], i: i64) -> Option[String] {
    if i < a.len() { a[i].clone() } else { None }
}

fn int_arg(a: ref Vec[Option[String]], i: i64) -> i64 {
    py_int(a[i].clone().unwrap(), 10).unwrap()
}

fn str_arg(a: ref Vec[Option[String]], i: i64) -> String {
    a[i].clone().unwrap()
}

fn index_error() -> Exc {
    exc("IndexError", "list index out of range".to_string())
}

fn ev_index(subs: ref Subs, i: i64) -> Result[i64, Exc] {
    match py_index(i, subs.events.len()) {
        Some(j) => Ok(j),
        None => Err(index_error()),
    }
}

// read_text in the oracle: the file as strict UTF-8.
fn read_text(w: ref World, path: ref String) -> Result[String, Exc] {
    let data = fs_read(w, path)?;
    utf8_decode(data, 0, false)
}

fn tuple_repr(xs: ref Vec[String]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for x in xs {
        parts.push(py_repr_str(x));
    }
    f"({join_with(parts, ", ".to_string())})"
}

fn load_args(a: ref Vec[Option[String]]) -> (String, Option[String], String, Option[String]) {
    let path = str_arg(a, 0);
    let fmt = arg_at(a, 1);
    let enc = match arg_at(a, 2) {
        Some(e) => e,
        None => "utf-8".to_string(),
    };
    (path, fmt, enc, arg_at(a, 3))
}

fn color_op(w: mut ref World, s: ref String) -> Result[(), Exc] {
    let c = match rgba_to_color(s) {
        Some(c) => c,
        None => {
            if s.starts_with("&") {
                return Err(int_error(slice_from(s, 2), 16));
            }
            return Err(int_error(s, 10));
        }
    };
    emit(mut w, f"  {color_repr(c)} {color_to_ass_rgba(c)} {color_to_ssa_rgb(c)}");
    Ok(())
}

fn run_op(w: mut ref World, p: ref Pats, cur: mut ref Option[Subs], words: ref Vec[String]) -> Result[(), Exc] {
    let op = words[0].clone();
    let mut a: Vec[Option[String]] = Vec.new();
    for i in 1..words.len() {
        a.push(word_arg(words[i]));
    }
    if op == "load" {
        let (path, fmt, enc, errors) = load_args(a);
        let kw = kwargs_of(words, 5);
        *cur = Some(load(mut w, p, path, enc, fmt, errors, kw.read)?);
    } else if op == "string" {
        let text = read_text(w, str_arg(a, 0))?;
        *cur = Some(from_text(mut w, p, text, arg_at(a, 1), read_opts())?);
    } else if op == "new" {
        *cur = Some(new_subs());
    } else if op == "show" {
        let subs = need(cur)?;
        describe(mut w, p, subs);
    } else if op == "tostr" {
        let mut subs = need(cur)?;
        let kw = kwargs_of(words, 2);
        let r = to_string(mut w, p, mut subs, str_arg(a, 0), kw.write);
        *cur = Some(subs);
        text_block(mut w, r?);
    } else if op == "save" {
        let mut subs = need(cur)?;
        let (path, fmt, enc, errors) = load_args(a);
        let kw = kwargs_of(words, 5);
        let r = save(mut w, p, mut subs, path, enc, fmt, errors, kw.write);
        *cur = Some(subs);
        r?;
    } else if op == "detect" {
        let text = read_text(w, str_arg(a, 0))?;
        emit(mut w, f"  {autodetect(p, text)?}");
    } else if op == "ext" {
        emit(mut w, f"  {get_file_extension(str_arg(a, 0))?}");
    } else if op == "fmtid" {
        emit(mut w, f"  {get_format_identifier(str_arg(a, 0))?}");
    } else if op == "tsparse" {
        let s = str_arg(a, 0);
        match re_match(p.timestamp, s) {
            Some(g) => emit(mut w, f"  TIMESTAMP {tuple_repr(tail(g))} {timestamp_to_ms(tail(g))}"),
            None => emit(mut w, "  TIMESTAMP no match".to_string()),
        }
        match re_match(p.timestamp_short, s) {
            Some(g) => emit(mut w, f"  TIMESTAMP_SHORT {tuple_repr(tail(g))} {timestamp_to_ms(tail(g))}"),
            None => emit(mut w, "  TIMESTAMP_SHORT no match".to_string()),
        }
    } else if op == "mt" {
        let kw = kwargs_of(words, 1);
        emit(mut w, f"  {make_time(kw.time)?}");
    } else if op == "mstostr" {
        emit(mut w, f"  {ms_to_str_num(num_word(str_arg(a, 0)), a.len() > 1)}");
    } else if op == "mstotimes" {
        let (h, m, s, ms) = ms_to_times(num_word(str_arg(a, 0)));
        emit(mut w, f"  Times(h={h}, m={m}, s={s}, ms={ms})");
    } else if op == "ftoms" {
        emit(mut w, f"  {frames_to_ms(int_arg(a, 0), num_word(str_arg(a, 1)))?}");
    } else if op == "mstof" {
        emit(mut w, f"  {ms_to_frames(int_arg(a, 0), num_word(str_arg(a, 1)))?}");
    } else if op == "stamp" {
        let f = str_arg(a, 0);
        let ms = int_arg(a, 1);
        let s = if f == "ass" {
            ssa_timestamp(mut w, ms)
        } else if f == "srt" {
            srt_timestamp(mut w, ms)
        } else if f == "vtt" {
            vtt_timestamp(mut w, ms)
        } else {
            tmp_timestamp(mut w, ms)
        };
        emit(mut w, f"  {s}");
    } else if op == "color" {
        color_op(mut w, str_arg(a, 0))?;
    } else if op == "tags" {
        let styles = match cur {
            Some(s) => s.styles.clone(),
            None => Vec.new(),
        };
        for (frag, sty) in parse_tags(p, str_arg(a, 0), default_style(), styles, a.len() > 1) {
            emit(mut w, f"  {py_repr_str(frag)} italic={py_bool(sty.italic)} bold={py_bool(sty.bold)} underline={py_bool(sty.underline)} strikeout={py_bool(sty.strikeout)} fontname={py_repr_str(sty.fontname)} drawing={py_bool(sty.drawing)} fontsize={num_repr(sty.fontsize)}");
        }
    } else if op == "align" {
        let al = from_ssa_alignment(int_arg(a, 0))?;
        emit(mut w, f"  {align_repr(al)} {to_ssa_alignment(align_value(al))}");
    } else if op == "cli" {
        let mut argv: Vec[String] = Vec.new();
        for x in a {
            argv.push(x.clone().unwrap());
        }
        let mut cli = Cli { out: String.new(), err: String.new() };
        let end = cli_main(mut w, p, mut cli, argv);
        for line in py_splitlines(cli.out) {
            emit(mut w, f"  out|{vis(line)}");
        }
        for line in py_splitlines(cli.err) {
            emit(mut w, f"  err|{vis(line)}");
        }
        match end {
            CliEnd.Exit(code) => emit(mut w, f"  exit {code}"),
            CliEnd.Return(code) => emit(mut w, f"  return {code}"),
            CliEnd.Raise(e) => return Err(e),
        }
    } else {
        let mut subs = need(cur)?;
        let r = edit(mut w, p, mut subs, op, a, words);
        *cur = Some(subs);
        r?;
    }
    Ok(())
}

// The ops that change the loaded file.
fn edit(w: mut ref World, p: ref Pats, subs: mut ref Subs, op: ref String, a: ref Vec[Option[String]], words: ref Vec[String]) -> Result[(), Exc] {
    if *op == "shift" {
        shift_subs(mut subs, kwargs_of(words, 1).time)?;
    } else if *op == "tf" {
        transform_framerate(mut subs, num_word(str_arg(a, 0)), num_word(str_arg(a, 1)))?;
    } else if *op == "rename" {
        rename_style(mut subs, str_arg(a, 0), str_arg(a, 1))?;
    } else if *op == "import" {
        let other = load(mut w, p, str_arg(a, 0), "utf-8".to_string(), None, None, read_opts())?;
        import_styles(mut subs, other, str_arg(a, 1) == "1");
    } else if *op == "equals" {
        let other = load(mut w, p, str_arg(a, 0), "utf-8".to_string(), None, None, read_opts())?;
        let r = subs_equals(mut w, subs, other);
        emit(mut w, f"  {py_bool(r)}");
    } else if *op == "clean" {
        remove_miscellaneous(p, mut subs);
    } else if *op == "sort" {
        sort_events(mut subs);
    } else if *op == "textevents" {
        for e in text_events(p, subs) {
            emit(mut w, f"  {event_repr(e)}");
        }
    } else if *op == "get" {
        let i = ev_index(subs, int_arg(a, 0))?;
        emit(mut w, f"  {event_repr(subs.events[i])}");
    } else if *op == "setplain" {
        let i = ev_index(subs, int_arg(a, 0))?;
        subs.events[i].text = replace_all(str_arg(a, 1), "\n", "\\N");
    } else if *op == "setdur" {
        let i = ev_index(subs, int_arg(a, 0))?;
        let ms = int_arg(a, 1);
        if ms < 0 {
            return Err(exc("ValueError", "Subtitle duration cannot be negative".to_string()));
        }
        subs.events[i].end = subs.events[i].start + ms;
    } else if *op == "setcomment" {
        let i = ev_index(subs, int_arg(a, 0))?;
        subs.events[i].kind = if str_arg(a, 1) == "1" { "Comment".to_string() } else { "Dialogue".to_string() };
    } else if *op == "del" {
        match py_index(int_arg(a, 0), subs.events.len()) {
            Some(j) => {
                subs.events.remove(j);
            }
            None => return Err(exc("IndexError", "list assignment index out of range".to_string())),
        }
    } else if *op == "insert" {
        let k = insert_at(int_arg(a, 0), subs.events.len());
        subs.events.insert(k, new_event(int_arg(a, 1), int_arg(a, 2), str_arg(a, 3)));
    } else if *op == "copyev" {
        let i = ev_index(subs, int_arg(a, 0))?;
        let e = subs.events[i].clone();
        subs.events.push(e);
    } else if *op == "evequals" {
        let i = ev_index(subs, int_arg(a, 0))?;
        let j = ev_index(subs, int_arg(a, 1))?;
        emit(mut w, f"  {py_bool(event_equals(subs.events[i], subs.events[j]))}");
    } else if *op == "evcmp" {
        let i = ev_index(subs, int_arg(a, 0))?;
        let j = ev_index(subs, int_arg(a, 1))?;
        let x = subs.events[i].clone();
        let y = subs.events[j].clone();
        let eq = x.start == y.start and x.end == y.end;
        let lt = ev_lt(x, y);
        let gt = ev_lt(y, x);
        emit(mut w, f"  == {py_bool(eq)}, != {py_bool(not eq)}, < {py_bool(lt)}, <= {py_bool(lt or eq)}, > {py_bool(gt)}, >= {py_bool(gt or eq)}");
    } else {
        return Err(exc("SystemExit", f"bad op {op}"));
    }
    Ok(())
}

fn run_job(w: mut ref World, p: ref Pats, f: ref Vec[String]) {
    w.files = Map.new();
    w.dirs = Map.new();
    w.dirs.insert("/".to_string(), true);
    w.dirs.insert("/work".to_string(), true);
    if f[2] != "-" {
        for d in split_on(f[2], ',') {
            fs_makedirs(mut w, d);
        }
    }
    if f[1] != "-" {
        for pair in split_on(f[1], ',') {
            let kv = split_on(pair, '=');
            fs_put(mut w, kv[0], hex_bytes(kv[1]));
        }
    }
    emit(mut w, f"== {f[0]}");
    let mut cur: Option[Subs] = None;
    let mut before = w.files.clone();
    for k in 3..f.len() {
        let words = split_on(f[k], ' ');
        let mut shown: Vec[String] = Vec.new();
        for x in words {
            shown.push(word_shown(x));
        }
        emit(mut w, f"> {join_with(shown, " ".to_string())}");
        w.warns.clear();
        if let Err(e) = run_op(mut w, p, mut cur, words) {
            emit(mut w, f"  error {e.kind}: {vis(e.msg)}");
        }
        let warns = w.warns.clone();
        for x in warns {
            emit(mut w, f"  warning {vis(x)}");
        }
        let mut keys: Vec[String] = Vec.new();
        for (key, _) in w.files.iter() {
            keys.push(key.clone());
        }
        keys.sort();
        for key in keys {
            let now = w.files.get(key).unwrap().clone();
            let changed = match before.get(key) {
                Some(old) => *old != now,
                None => true,
            };
            if changed {
                let cs: Vec[char] = key.chars().collect();
                let rel = chars_str(cs, 6, cs.len());
                emit(mut w, f"  wrote {rel} ({now.len()} bytes)");
                file_block(mut w, now);
            }
        }
        before = w.files.clone();
    }
    emit(mut w, String.new());
}

fn main() {
    let p = patterns();
    let mut w = World { out: String.new(), warns: Vec.new(), files: Map.new(), dirs: Map.new() };
    for line in split_on(jobs_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, '\t');
        run_job(mut w, p, f);
    }
    print(w.out);
}

