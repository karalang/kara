    s.push_str("cli convert\tep01.\t-\tcli --to srt ep01.ass\tcli --to vtt --clean ep01.ass\tcli -t tmp ep01.ass\n");
    s.push_str("cli microdvd\tep01.,md1.\t-\tcli --to microdvd ep01.ass\tcli --to microdvd --fps 23.976 ep01.ass\tcli --to microdvd --fps 25 --sub-no-write-fps-declaration ep01.ass\tcli md1.sub\tcli --from srt md1.sub\n");
    s.push_str("cli shift\tsrt1.,ep01.\t-\tcli --shift 0.3s srt1.srt\tcli --shift-back 1m30.5s -o retimed srt1.srt\tcli --shift 2h ep01.ass\tcli --shift 1.5.2s --to vtt srt1.srt\tcli --shift 1h2m3s4ms --to vtt srt1.srt\tcli --shift h: --to tmp srt1.srt\tcli --shift s srt1.srt\tcli --shift 1s --shift-back 1s srt1.srt\tcli --shift=5ms --shift 10ms --to json srt1.srt\n");
    s.push_str("cli framerate\tsrt1.\t-\tcli --transform-framerate 25 23.976 --to vtt srt1.srt\tcli --transform-framerate 25 srt1.srt\tcli --transform-framerate 25 --clean srt1.srt\tcli --transform-framerate 25\tcli --tr 25 50 --to tmp srt1.srt\tcli --fps -5 srt1.srt\tcli --fps abc srt1.srt\tcli --fps nan srt1.srt\tcli --fps -x srt1.srt\tcli --fps\n");
    s.push_str("cli options\tsrt1.\tdir1\tcli --to xyz srt1.srt\tcli --from=vtt --to=ass srt1.srt\tcli -tvtt -oout srt1.srt\tcli -t=srt -o=out2 srt1.srt\tcli --t srt srt1.srt\tcli --s 1s srt1.srt\tcli --sh 1s srt1.srt\tcli --cl --to srt srt1.srt\tcli --to srt --unknown srt1.srt\tcli srt1.srt --to vtt extra.srt\tcli missing.srt dir1 srt1.srt --to ass\tcli --enc-error-handling loose srt1.srt\tcli -x\tcli --to\tcli -f\tcli -vt srt\tcli --clean=yes srt1.srt\tcli h:2d\tcli h: --to srt\tcli ./dir1/../srt1.srt --to mpl2\n");
    s.push_str("cli encodings\tlatin.srt=310a30303a30303a30312c303030202d2d3e2030303a30303a30322c3030300a436166e920e0206d696e7569740a,bad_utf8.srt=310a30303a30303a30312c303030202d2d3e2030303a30303a30322c3030300a6e61ef76652062e28261640a0a320a30303a30303a30332c303030202d2d3e2030303a30303a30342c3030300a656e6420c3,ep01.\t-\tcli --input-enc klingon latin.srt\tcli --output-enc h:5554463820 --to ass latin.srt\tcli --input-enc latin-1 --output-enc utf-8 --to ass latin.srt\tcli --input-enc latin_1 --to vtt latin.srt\tcli --to vtt bad_utf8.srt\tcli --enc-error-handling strict --to tmp bad_utf8.srt\tcli --to tmp --output-enc ascii ep01.ass\tcli --to srt --output-enc utf-16 ep01.ass\tcli --to srt --output-enc ascii --enc-error-handling strict ep01.ass\n");
    s.push_str("cli srt tags\tsrt1.,ep01.\t-\tcli --srt-keep-html-tags --to ass srt1.srt\tcli --srt-keep-unknown-html-tags --to json srt1.srt\tcli --srt-keep-ssa-tags --to srt ep01.ass\tcli --clean ep01.ass\n");
    s.push_str("cli paths\tsrt1.,-dash.srt=310a30303a30303a30312c303030202d2d3e2030303a30303a30322c3030300a4120646173682066696c650a,plain.txt=4e6f207375627469746c657320686572652e0a\tsub\tcli -- -dash.srt\tcli -o sub/deep/er --to vtt srt1.srt\tcli -o plain.txt srt1.srt\tcli -o sub sub\tcli --to ass -dash.srt\tcli --to srt plain.txt\n");
    s
}

fn help_text() -> String {
    let mut s = String.new();
    s.push_str("usage: pysubs2 [-h] [-v]\n               [-f {srt,ass,ssa,microdvd,json,mpl2,tmp,vtt,sami,whisper_jax,ttml}]\n               [-t {srt,ass,ssa,microdvd,json,mpl2,tmp,vtt,sami,whisper_jax,ttml}]\n               [--input-enc ENCODING] [--output-enc ENCODING]\n               [--enc-error-handling {strict,surrogateescape}] [--fps FPS]\n               [-o DIR] [--clean] [--verbose] [--shift TIME |\n               --shift-back TIME | --transform-framerate FPS1 FPS2]\n               [--srt-keep-unknown-html-tags] [--srt-keep-html-tags]\n               [--srt-keep-ssa-tags] [--sub-no-write-fps-declaration]\n               [FILE ...]\n\nThe pysubs2 CLI for processing subtitle files.\nhttps://github.com/tkarabela/pysubs2\n\npositional arguments:\n  FILE                  Input subtitle files. Can be in SubStation Alpha\n                        (*.ass, *.ssa), SubRip (*.srt), MicroDVD (*.sub) or\n                        other supported format. When no files are specified,\n                        pysubs2 will work as a pipe, reading from standard\n");
    s.push_str("                        input and writing to standard output.\n\noptions:\n  -h, --help            show this help message and exit\n  -v, --version         show program's version number and exit\n  -f, --from {srt,ass,ssa,microdvd,json,mpl2,tmp,vtt,sami,whisper_jax,ttml}\n                        By default, subtitle format is detected from the file.\n                        This option can be used to skip autodetection and\n                        force specific format. Generally, it should never be\n                        needed.\n  -t, --to {srt,ass,ssa,microdvd,json,mpl2,tmp,vtt,sami,whisper_jax,ttml}\n                        Convert subtitle files to given format. By default,\n                        each file is saved in its original format.\n  --input-enc ENCODING  Character encoding for input files. By default, UTF-8\n                        is used for both input and output.\n  --output-enc ENCODING\n                        Character encoding for output files. By default, it is\n");
    s.push_str("                        the same as input encoding. If you wish to convert\n                        between encodings, make sure --input-enc is set\n                        correctly! Otherwise, your output files will probably\n                        be corrupted. It's a good idea to back up your files\n                        or use the -o option.\n  --enc-error-handling {strict,surrogateescape}\n                        Character encoding error handling for input and\n                        output. Defaults to 'surrogateescape' which passes\n                        through unrecognized characters to output unchanged.\n                        Use 'strict' if you want the command to fail when\n                        encountering a character incompatible with selected\n                        input/output encoding.\n  --fps FPS             This argument specifies framerate for MicroDVD files.\n                        By default, framerate is detected from the file. Use\n                        this when framerate specification is missing or to\n");
    s.push_str("                        force different framerate.\n  -o, --output-dir DIR  Use this to save all files to given directory. By\n                        default, every file is saved to its parent directory,\n                        ie. unless it's being saved in different subtitle\n                        format (and thus with different file extension), it\n                        overwrites the original file.\n  --clean               Attempt to remove non-essential subtitles (eg.\n                        karaoke, SSA drawing tags), strip styling information\n                        when saving to non-SSA formats\n  --verbose             Print misc logging\n  --shift TIME          Delay all subtitles by given time amount. Time is\n                        specified like this: '1m30s', '0.5s', ...\n  --shift-back TIME     The opposite of --shift (subtitles will appear\n                        sooner).\n  --transform-framerate FPS1 FPS2\n                        Multiply all timestamps by FPS1/FPS2 ratio.\n");
    s.push_str("\noptional arguments (SRT):\n  --srt-keep-unknown-html-tags\n                        (input) do not strip unrecognized HTML tags\n  --srt-keep-html-tags  (input) do not convert HTML tags to SubStation\n                        internally, this implies --srt-keep-unknown-html-tags\n  --srt-keep-ssa-tags   (output) do not convert/strip SubStation tags for\n                        output\n\noptional arguments (MicroDVD):\n  --sub-no-write-fps-declaration\n                        (output) omit writing FPS as first zero-length\n                        subtitle\n\nusage examples:\n  python -m pysubs2 --to srt *.ass\n  python -m pysubs2 --to srt --clean *.ass\n  python -m pysubs2 --to microdvd --fps 23.976 *.ass\n  python -m pysubs2 --shift 0.3s *.srt\n  python -m pysubs2 --shift 0.3s <my_file.srt >retimed_file.srt\n  python -m pysubs2 --shift-back 0.3s --output-dir retimed *.srt\n  python -m pysubs2 --transform-framerate 25 23.976 *.srt\n");
    s
}

fn usage_text() -> String {
    let mut s = String.new();
    s.push_str("usage: pysubs2 [-h] [-v]\n               [-f {srt,ass,ssa,microdvd,json,mpl2,tmp,vtt,sami,whisper_jax,ttml}]\n               [-t {srt,ass,ssa,microdvd,json,mpl2,tmp,vtt,sami,whisper_jax,ttml}]\n               [--input-enc ENCODING] [--output-enc ENCODING]\n               [--enc-error-handling {strict,surrogateescape}] [--fps FPS]\n               [-o DIR] [--clean] [--verbose] [--shift TIME |\n               --shift-back TIME | --transform-framerate FPS1 FPS2]\n               [--srt-keep-unknown-html-tags] [--srt-keep-html-tags]\n               [--srt-keep-ssa-tags] [--sub-no-write-fps-declaration]\n               [FILE ...]\n");
    s
}
