lphalevel": 0, "encoding": 1, "drawing": false}, "OP": {"fontname": "Comic Sans", "fontsize": 36.0, "primarycolor": {"r": 255, "g": 255, "b": 255, "a": 0}, "secondarycolor": {"r": 0, "g": 0, "b": 255, "a": 0}, "tertiarycolor": {"r": 0, "g": 0, "b": 0, "a": 0}, "outlinecolor": {"r": 0, "g": 0, "b": 0, "a": 0}, "backcolor": {"r": 0, "g": 0, "b": 0, "a": 0}, "bold": false, "italic": false, "underline": true, "strikeout": true, "scalex": 100.0, "scaley": 100.0, "spacing": 0.0, "angle": 0.0, "borderstyle": 3, "outline": 2.0, "shadow": 0.0, "alignment": 7, "marginl": 10, "marginr": 10, "marginv": 10, "alphalevel": 0, "encoding": 0, "drawing": false}}, "events": [{"start": 0, "end": 0, "text": "Translation by the Harbour desk", "marked": false, "layer": 0, "style": "Default", "name": "", "marginl": 0, "marginr": 0, "marginv": 0, "effect": "", "type": "Comment"}, {"start": 1200, "end": 4000, "text": "The last ferry leaves at midnight.", "marked": false, "layer": 0, "style": "Default", "name": "Mira", "marginl": 0, "marginr": 0, "marginv": 0, "effect": "", "type": "Dialogue"}, {"start": 4500, "end": 7800, "text": "{\\i1}Midnight?{\\i0} Then we still\\Nhave time.", "marked": false, "layer": 0, "style": "Default", "name": "Tomas", "marginl": 0, "marginr": 0, "marginv": 0, "effect": "", "type": "Dialogue"}, {"start": 5000, "end": 9000, "text": "{\\an8\\pos(960,80)}PIER 7 \u2014 NO ENTRY", "marked": false, "layer": 1, "style": "Sign", "name": "", "marginl": 0, "marginr": 0, "marginv": 0, "effect": "", "type": "Dialogue"}, {"start": 8000, "end": 11000, "text": "She always says that, every night.", "marked": false, "layer": 0, "style": "Thoughts", "name": "Mira", "marginl": 0, "marginr": 0, "marginv": 0, "effect": "", "type": "Dialogue"}, {"start": 11000, "end": 13500, "text": "Wait,\\hwhat was that? \ud83c\udf0a", "marked": false, "layer": 0, "style": "Default", "name": "Mira", "marginl": 0, "marginr": 0, "marginv": 0, "effect": "", "type": "Dialogue"}, {"start": 12000, "end": 13000, "text": "{\\p1}m 0 0 l 100 0 100 100 0 100{\\p0}", "marked": false, "layer": 2, "style": "Sign", "name": "", "marginl": 0, "marginr": 0, "marginv": 0, "effect": "", "type": "Dialogue"}, {"start": 14000, "end": 16000, "text": "{\\k20}Hold {\\k30}the {\\k40}line", "marked": false, "layer": 0, "style": "OP", "name": "", "marginl": 10, "marginr": 10, "marginv": 20, "effect": "Karaoke", "type": "Dialogue"}, {"start": 16000, "end": 18000, "text": "{\\rThoughts}Not again...{\\r} Come on.", "marked": false, "layer": 0, "style": "Default", "name": "Tomas", "marginl": 0, "marginr": 0, "marginv": 0, "effect": "", "type": "Dialogue"}, {"start": 18000, "end": 20000, "text": "{\\fnArial Black\\b1}LAST CALL{\\b0}\\nboarding now", "marked": false, "layer": 0, "style": "Default", "name": "", "marginl": 0, "marginr": 0, "marginv": 0, "effect": "", "type": "Dialogue"}, {"start": 20000, "end": 22000, "text": "Duplicate line", "marked": false, "layer": 0, "style": "Default", "name": "", "marginl": 0, "marginr": 0, "marginv": 0, "effect": "", "type": "Dialogue"}, {"start": 20000, "end": 22000, "text": "Duplicate line", "marked": false, "layer": 0, "style": "Default", "name": "", "marginl": 0, "marginr": 0, "marginv": 0, "effect": "", "type": "Dialogue"}, {"start": 22000, "end": 22500, "text": "!", "marked": false, "layer": 0, "style": "Default", "name": "", "marginl": 0, "marginr": 0, "marginv": 0, "effect": "", "type": "Dialogue"}, {"start": 23000, "end": 24000, "text": "TL note: \"Pier 7\" is a pun", "marked": false, "layer": 0, "style": "Default", "name": "", "marginl": 0, "marginr": 0, "marginv": 0, "effect": "", "type": "Comment"}]}
