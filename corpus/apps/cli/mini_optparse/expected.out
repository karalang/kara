== defaults
> parser prog=sync usage=%prog [options] [REMOTE]
> option -l,--level type=int
  -l/--level: action=store type=int dest=level nargs=1
> option -r,--rate type=float default=s:1.5
  -r/--rate: action=store type=float dest=rate nargs=1
> option -v action=store_true dest=verbose
  -v: action=store_true type=None dest=verbose nargs=None
> set_defaults verbose=b:1 level=s:3 extra=s:42
> option -q action=store_false dest=verbose
  -q: action=store_false type=None dest=verbose nargs=None
> option --label default=i:5
  --label: action=store type=string dest=label nargs=1
> defaults
  {'level': '3', 'rate': '1.5', 'verbose': True, 'extra': '42', 'label': 5}
> parse []
  | values: {'level': 3, 'rate': 1.5, 'verbose': True, 'extra': '42', 'label': 5}
  | args: []
> parse ['-l', '9', '-q']
  | values: {'level': 9, 'rate': 1.5, 'verbose': False, 'extra': '42', 'label': 5}
  | args: []
> set_defaults level=s:ten
> parse ['-l', '2']
  ! OptionValueError: option --level: invalid integer value: 'ten'
> set_defaults level=n: rate=f:2.0
> parse []
  | values: {'level': None, 'rate': 2.0, 'verbose': True, 'extra': '42', 'label': 5}
  | args: []
> interspersed 0
> parse ['-v', 'commit', '-m', 'msg']
  | values: {'level': None, 'rate': 2.0, 'verbose': True, 'extra': '42', 'label': 5}
  | args: ['commit', '-m', 'msg']
> parse ['--', '-v']
  | values: {'level': None, 'rate': 2.0, 'verbose': True, 'extra': '42', 'label': 5}
  | args: ['-v']
> interspersed 1
> parse ['-v', 'commit', '-q', 'msg']
  | values: {'level': None, 'rate': 2.0, 'verbose': False, 'extra': '42', 'label': 5}
  | args: ['commit', 'msg']
== program: backup-tool with backup.conf
> config {'keep': '14', 'compress': 'gzip', 'exclude_from': '/etc/backup/excludes', 'dry_run': 'no', 'bandwidth': '2.5'}
$ backup-tool 
  err| Usage: backup-tool [options] SRC DEST
  err|
  err| backup-tool: error: expected SRC and DEST, got 0 argument(s)
  [exit 2]
$ backup-tool -vv /srv/www /mnt/backup/www
  | dry run /srv/www -> /mnt/backup/www
  |   keep 14, compress gzip, verbosity 2
  |   bandwidth 2.5 MB/s, 256 KB a tick
  |   excludes ['@/etc/backup/excludes']
  |   options {'verbose': 2, 'dry_run': 'no', 'keep': 14, 'compress': 'gzip', 'exclude': None, 'exclude_from': '/etc/backup/excludes', 'bandwidth': 2.5}
$ backup-tool --keep 3 --compress=none -x *.log -x*.tmp /home /mnt/backup/home
  | dry run /home -> /mnt/backup/home
  |   keep 3, compress none, verbosity 0
  |   bandwidth 2.5 MB/s, 256 KB a tick
  |   excludes ['*.log', '*.tmp', '@/etc/backup/excludes']
$ backup-tool -nq --bandwidth 0x10 /srv/db /mnt/backup/db
  err| Usage: backup-tool [options] SRC DEST
  err|
  err| backup-tool: error: option --bandwidth: invalid floating-point value: '0x10'
  [exit 2]
$ backup-tool --keep two /srv /mnt
  err| Usage: backup-tool [options] SRC DEST
  err|
  err| backup-tool: error: option --keep: invalid integer value: 'two'
  [exit 2]
$ backup-tool /srv/www
  err| Usage: backup-tool [options] SRC DEST
  err|
  err| backup-tool: error: expected SRC and DEST, got 1 argument(s)
  [exit 2]
$ backup-tool --compress xz /srv /mnt
  err| Usage: backup-tool [options] SRC DEST
  err|
  err| backup-tool: error: option --compress: invalid choice: 'xz' (choose from 'none', 'gzip', 'zstd')
  [exit 2]
$ backup-tool --ke 5 --bw 10 /a /b
  | dry run /a -> /b
  |   keep 5, compress gzip, verbosity 0
  |   bandwidth 10.0 MB/s, 1024 KB a tick
  |   excludes ['@/etc/backup/excludes']
$ backup-tool --help
  | Usage: backup-tool [options] SRC DEST
  |
  | Options:
  |   --version             show program's version number and exit
  |   -h, --help            show this help message and exit
  |   -v, --verbose         print more detail; repeat for even more
  |   -q, --quiet           print only errors
  |   -n, --dry-run         show what would be copied, but copy nothing
  |   --keep=N              keep N snapshots [default: 14]
  |   --compress=COMPRESS   none, gzip or zstd [default: gzip]
  |   -x GLOB, --exclude=GLOB
  |                         skip files that match GLOB
  |   --exclude-from=FILE   read more globs from FILE
  |   --bandwidth=MBPS, --bw=MBPS
  |                         limit the copy to MBPS megabytes a second
  [exit 0]
== program: vcs, a git-like dispatcher
$ vcs status
  | status of .
$ vcs -C /repo status -s
  | status of /repo (short)
$ vcs --verbose commit -m fix the build -a
  | [.] commit {'message': 'fix the build', 'all': True, 'amend': None} []
  | commit 'fix the build' from all changed files
$ vcs commit -am two words -- -notes.txt
  | commit 'two words' from all changed files
$ vcs commit
  err| Usage: vcs commit -m MSG [-a] [FILE...]
  err|
  err| vcs commit: error: a commit message is required (use -m)
  [exit 2]
$ vcs log -n 3 --oneline main..topic
  | log main..topic, 3 commits, one line each
$ vcs log -n three
  err| Usage: vcs log [-n N] [--oneline] [RANGE]
  err|
  err| vcs log: error: option -n: invalid integer value: 'three'
  [exit 2]
$ vcs -v push --force origin main -v
  err| Usage: vcs push [-f] [-u] REMOTE [BRANCH]
  err|
  err| vcs push: error: no such option: -v
  [exit 2]
$ vcs push --set-upstream origin
  | push the current branch to origin, tracking it
$ vcs checkout -b feature/x --track
  | checkout new branch feature/x tracking upstream
$ vcs frobnicate
  err| Usage: vcs [-C DIR] [-v] COMMAND [ARGS...]
  err|
  err| vcs: error: unknown command 'frobnicate' (choose from status, commit, log, push, checkout)
  [exit 2]
$ vcs --bogus status
  err| Usage: vcs [-C DIR] [-v] COMMAND [ARGS...]
  err|
  err| vcs: error: no such option: --bogus
  [exit 2]
$ vcs 
  err| Usage: vcs [-C DIR] [-v] COMMAND [ARGS...]
  err|
  err| vcs: error: no command given
  [exit 2]
$ vcs commit --help
  | Usage: vcs commit -m MSG [-a] [FILE...]
  |
  | Options:
  |   -h, --help            show this help message and exit
  |   -m MSG, --message=MSG
  |                         the commit message
  |   -a, --all             commit every changed file
  |   --amend               replace the last commit
  [exit 0]
$ vcs -C
  err| Usage: vcs [-C DIR] [-v] COMMAND [ARGS...]
  err|
  err| vcs: error: -C option requires 1 argument
  [exit 2]
