== option errors
> parser prog=lint
> option -
  ! OptionError: invalid option string '-': must be at least two characters long
> option --
  ! OptionError: invalid short option string '--': must be of the form -x, (x any non-dash char)
> option -ab
  ! OptionError: invalid long option string '-ab': must start with --, followed by non-dash
> option -a,---b
  ! OptionError: option -a: invalid long option string '---b': must start with --, followed by non-dash
> option -a,--b,c
  ! OptionError: option -a/--b: invalid option string 'c': must be at least two characters long
> option -a,--b action=storee
  ! OptionError: option -a/--b: invalid action: 'storee'
> option -c type=bogus
  ! OptionError: option -c: invalid option type: 'bogus'
> option -c type=str
  -c: action=store type=string dest=c nargs=1
> option -d action=store_true type=int
  ! OptionError: option -d: must not supply a type for action 'store_true'
> option -e type=choice
  ! OptionError: option -e: must supply a list of choices for type 'choice'
> option -e type=choice choices=s:abc
  ! OptionError: option -e: choices must be a list of strings ('str' supplied)
> option -e type=int choices=l:a
  ! OptionError: option -e: must not supply choices for type 'int'
> option -e choices=l:a,b action=count
  ! OptionError: option -e: must not supply choices for type None
> option -g action=store_true const=i:1
  ! OptionError: option -g: 'const' must not be supplied for action 'store_true'
> option -g action=count nargs=2
  ! OptionError: option -g: 'nargs' must not be supplied for action 'count'
> option -g action=help type=int
  ! OptionError: option -g: must not supply a type for action 'help'
> option -k action=callback callback=nosuch
  ! OptionError: option -k: callback not callable: 'nosuch'
> option -k callback=nosuch
  ! OptionError: option -k: callback supplied ('nosuch') for non-callback option
> option -m colour=red size=2 action=store_true
  ! OptionError: option -m: invalid keyword arguments: colour, size
> option -m action=store_const
  -m: action=store_const type=None dest=m nargs=None
> option -p,--pid-file
  -p/--pid-file: action=store type=string dest=pid_file nargs=1
> option -P,--pid-file
  ! OptionConflictError: option -P/--pid-file: conflicting option string(s): --pid-file
> option -h,--host
  ! OptionConflictError: option -h/--host: conflicting option string(s): -h
> option --x-y-z action=callback callback=csv type=string
  --x-y-z: action=callback type=string dest=x_y_z nargs=1
> option --w action=callback callback=csv
  --w: action=callback type=None dest=None nargs=1
> option -r action=version
  -r: action=version type=None dest=None nargs=None
> parse ['-r']
  [exit 0]
> defaults
  {'c': None, 'm': None, 'pid_file': None, 'x_y_z': None}
== conflict resolve
> parser prog=deploy conflict=resolve version=%prog 1.0
> option -f,--file help=file to deploy
  -f/--file: action=store type=string dest=file nargs=1
> option -f,--force action=store_true help=skip the checks
  -f/--force: action=store_true type=None dest=force nargs=None
> option --file action=store_true dest=file2 help=never shown
  --file: action=store_true type=None dest=file2 nargs=None
> option -h,--host default=s:localhost help=target host [default: %default]
  -h/--host: action=store type=string dest=host nargs=1
> option --version action=store_true help=print the release
  --version: action=store_true type=None dest=version nargs=None
> help
  | Usage: deploy [options]
  |
  | Options:
  |   --help                show this help message and exit
  |   -f, --force           skip the checks
  |   --file                never shown
  |   -h HOST, --host=HOST  target host [default: localhost]
  |   --version             print the release
> defaults
  {'file': None, 'force': None, 'file2': None, 'host': 'localhost', 'version': None}
> parse ['-f', '--file', '-h', 'web1']
  | values: {'file': None, 'force': True, 'file2': True, 'host': 'web1', 'version': None}
  | args: []
> parse ['--help']
  | Usage: deploy [options]
  |
  | Options:
  |   --help                show this help message and exit
  |   -f, --force           skip the checks
  |   --file                never shown
  |   -h HOST, --host=HOST  target host [default: localhost]
  |   --version             print the release
  [exit 0]
> has --force
  True
> remove --force
  removed --force
> has --force
  False
> has -f
  False
> remove --nope
  ! ValueError: no such option '--nope'
> parse ['-f']
