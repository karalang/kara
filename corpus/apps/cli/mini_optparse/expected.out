== actions
> parser prog=build
> option -I,--include action=append dest=paths
  -I/--include: action=append type=string dest=paths nargs=1
> option --debug action=append_const const=s:debug dest=tags
  --debug: action=append_const type=None dest=tags nargs=None
> option --trace action=append_const const=s:trace dest=tags
  --trace: action=append_const type=None dest=tags nargs=None
> option -v action=count dest=verbosity
  -v: action=count type=None dest=verbosity nargs=None
> option --fast action=store_const const=i:3 dest=level
  --fast: action=store_const type=None dest=level nargs=None
> option --slow action=store_const const=i:1 dest=level
  --slow: action=store_const type=None dest=level nargs=None
> option --plain action=store_const dest=level
  --plain: action=store_const type=None dest=level nargs=None
> option --point type=float nargs=2
  --point: action=store type=float dest=point nargs=2
> option -D,--define action=append nargs=2 metavar=KEY VALUE
  -D/--define: action=append type=string dest=define nargs=2
> option --mode choices=l:fast,safe
  --mode: action=store type=choice dest=mode nargs=1
> option --size type=long
  --size: action=store type=long dest=size nargs=1
> option -j type=int dest=jobs
  -j: action=store type=int dest=jobs nargs=1
