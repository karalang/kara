    t.push_str("run\tcommit\n");
    t.push_str("run\tlog\t-n\t3\t--oneline\tmain..topic\n");
    t.push_str("run\tlog\t-n\tthree\n");
    t.push_str("run\t-v\tpush\t--force\torigin\tmain\t-v\n");
    t.push_str("run\tpush\t--set-upstream\torigin\n");
    t.push_str("run\tcheckout\t-b\tfeature/x\t--track\n");
    t.push_str("run\tfrobnicate\n");
    t.push_str("run\t--bogus\tstatus\n");
    t.push_str("run\n");
    t.push_str("run\tcommit\t--help\n");
