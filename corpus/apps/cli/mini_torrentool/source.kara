// ------------------------------------------------------------ Python str helpers

fn hex_digits(n: i64, width: i64) -> String {
    let d: Vec[char] = "0123456789abcdef".chars().collect();
    let mut out = String.new();
    let mut k = width;
    while k > 0 {
        k -= 1;
        out.push(d[(n >> (4 * k)) & 15]);
    }
    out
}

// str.isprintable(), for the characters property files hold.
fn py_printable(c: char) -> bool {
    let n = c as i64;
    if n < 0x20 or (n >= 0x7f and n <= 0xa0) or n == 0xad {
        return false;
    }
    if n == 0x1680 or (n >= 0x2000 and n <= 0x200f) or (n >= 0x2028 and n <= 0x202f) {
        return false;
    }
    if (n >= 0x205f and n <= 0x206f) or n == 0x3000 or n == 0xfeff or n == 0xfffe or n == 0xffff or (n >= 0xfff9 and n <= 0xfffb) {
        return false;
    }
    not (n >= 0xe000 and n <= 0xf8ff)
}

// repr() of a str.
fn py_repr_str(s: ref String) -> String {
    let q = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if py_printable(c) {
            out.push(c);
        } else {
            let n = c as i64;
            if n < 0x100 {
                out.push_str(f"\\x{hex_digits(n, 2)}");
            } else if n < 0x10000 {
                out.push_str(f"\\u{hex_digits(n, 4)}");
            } else {
                out.push_str(f"\\U{hex_digits(n, 8)}");
            }
        }
    }
    out.push(q);
    out
}
// ------------------------------------------------------------ int()
//
// Python's int() of a str, as parse_uri runs it on digits, period and
// counter (from mini_sexpdata).

// The non-ASCII characters str.isspace() is true for.
fn uni_space(c: char) -> bool {
    let n = c as i64;
    n == 0x85 or n == 0xa0 or n == 0x1680 or (n >= 0x2000 and n <= 0x200a) or n == 0x2028 or n == 0x2029
        or n == 0x202f or n == 0x205f or n == 0x3000
}

// The value of a Unicode decimal digit (category Nd), or -1. Each block
// of ten digits starts at one of these zeros (Unicode 15.1, as Python
// 3.13 has it).
fn uni_digit(c: char) -> i64 {
    let zeros: Vec[i64] = vec![
        0x30, 0x660, 0x6f0, 0x7c0, 0x966, 0x9e6, 0xa66, 0xae6,
        0xb66, 0xbe6, 0xc66, 0xce6, 0xd66, 0xde6, 0xe50, 0xed0,
        0xf20, 0x1040, 0x1090, 0x17e0, 0x1810, 0x1946, 0x19d0, 0x1a80,
        0x1a90, 0x1b50, 0x1bb0, 0x1c40, 0x1c50, 0xa620, 0xa8d0, 0xa900,
        0xa9d0, 0xa9f0, 0xaa50, 0xabf0, 0xff10, 0x104a0, 0x10d30, 0x11066,
        0x110f0, 0x11136, 0x111d0, 0x112f0, 0x11450, 0x114d0, 0x11650, 0x116c0,
        0x11730, 0x118e0, 0x11950, 0x11c50, 0x11d50, 0x11da0, 0x11f50, 0x16a60,
        0x16ac0, 0x16b50, 0x1d7ce, 0x1d7d8, 0x1d7e2, 0x1d7ec, 0x1d7f6, 0x1e140,
        0x1e2f0, 0x1e4f0, 0x1e950, 0x1fbf0,
    ];
    let n = c as i64;
    for z in zeros.iter() {
        if n >= *z and n < *z + 10 {
            return n - *z;
        }
    }
    -1
}

fn is_ascii_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn ascii_space(c: char) -> bool {
    c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == '\u{b}' or c == '\u{c}'
}

// What float() and int() do first: Unicode white space becomes a space
// and a Unicode decimal digit its ASCII digit; any other non-ASCII
// character makes the text invalid. Then the white space at the ends is
// stripped and underscores between digits removed.
fn number_text(cs: ref Vec[char]) -> Option[Vec[char]] {
    let mut t: Vec[char] = Vec.new();
    for c in cs.iter() {
        let n = *c as u32;
        if n < 128 {
            t.push(*c);
        } else if uni_space(*c) {
            t.push(' ');
        } else if uni_digit(*c) >= 0 {
            t.push(char.try_from(48 + uni_digit(*c) as u32).unwrap_or('?'));
        } else {
            return None;
        }
    }
    let mut a = 0;
    while a < t.len() and ascii_space(t[a]) {
        a += 1;
    }
    let mut b = t.len();
    while b > a and ascii_space(t[b - 1]) {
        b -= 1;
    }
    let mut out: Vec[char] = Vec.new();
    let mut prev = ' ';
    for i in a..b {
        let c = t[i];
        if c == '_' {
            if not is_ascii_digit(prev) {
                return None;
            }
        } else {
            if prev == '_' and not is_ascii_digit(c) {
                return None;
            }
            out.push(c);
        }
        prev = c;
    }
    if prev == '_' {
        return None;
    }
    Some(out)
}

// The digits of an int, with a '-' when it is below zero.
fn norm_int(neg: bool, ds: ref Vec[char]) -> String {
    let mut s = String.new();
    let mut started = false;
    for c in ds.iter() {
        if *c != '0' {
            started = true;
        }
        if started {
            s.push(*c);
        }
    }
    if not started {
        return "0".to_string();
    }
    if neg { f"-{s}" } else { s }
}

// int() of a str; None where it raises ValueError.
fn py_int(cs: ref Vec[char]) -> Option[String] {
    let t = number_text(cs)?;
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == '+' or t[i] == '-') {
        neg = t[i] == '-';
        i += 1;
    }
    if i == t.len() {
        return None;
    }
    let mut ds: Vec[char] = Vec.new();
    while i < t.len() {
        if not is_ascii_digit(t[i]) {
            return None;
        }
        ds.push(t[i]);
        i += 1;
    }
    Some(norm_int(neg, ds))
}
// ------------------------------------------------------------ text helpers (from mini_urlparse)

fn byte_str(b: ref Vec[u8], from: i64, to: i64) -> String {
    let mut v: Vec[u8] = Vec.new();
    for i in from..to {
        v.push(b[i]);
    }
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn to_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn from_bytes(v: Vec[u8]) -> String {
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn split_on(s: Str, sep: u8) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut st: i64 = 0;
    for i in 0..b.len() {
        if b[i] == sep {
            out.push(byte_str(b, st, i));
            st = i + 1;
        }
    }
    out.push(byte_str(b, st, b.len()));
    out
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

fn lines_of(text: Str) -> Vec[String] {
    let mut v = split_on(text, b'\n');
    if v.len() > 0 and v[v.len() - 1].len() == 0 {
        v.pop();
    }
    v
}

fn sort_strings(v: own Vec[String]) -> Vec[String] {
    let mut v = v;
    for i in 1..v.len() {
        let mut j = i;
        while j > 0 and v[j - 1] > v[j] {
            v.swap(j - 1, j);
            j -= 1;
        }
    }
    v
}

fn hex_val(c: u8) -> u8 {
    if is_digit(c) {
        c - b'0'
    } else if c >= b'a' and c <= b'f' {
        c - b'a' + 10
    } else {
        c - b'A' + 10
    }
}
// ------------------------------------------------------------ hashes and HMAC


// The message padded to whole 64- or 128-byte blocks, with its bit
// length in `lenbytes` bytes, big- or little-endian.
fn md_pad(msg: ref Vec[u8], block: i64, lenbytes: i64, big: bool) -> Vec[u8] {
    let mut m = msg.clone();
    let bits = msg.len() * 8;
    m.push(0x80);
    while m.len() % block != block - lenbytes {
        m.push(0);
    }
    for k in 0..lenbytes {
        let shift = if big { 8 * (lenbytes - 1 - k) } else { 8 * k };
        let b = if shift >= 64 { 0 } else { (bits >> shift) & 0xFF };
        m.push(b as u8);
    }
    m
}

fn le32(b: ref Vec[u8], i: i64) -> u32 {
    (b[i] as u32) | ((b[i + 1] as u32) << 8) | ((b[i + 2] as u32) << 16) | ((b[i + 3] as u32) << 24)
}

fn be32(b: ref Vec[u8], i: i64) -> u32 {
    ((b[i] as u32) << 24) | ((b[i + 1] as u32) << 16) | ((b[i + 2] as u32) << 8) | (b[i + 3] as u32)
}

fn be64(b: ref Vec[u8], i: i64) -> u64 {
    let mut v: u64 = 0;
    for k in 0..8 {
        v = (v << 8) | (b[i + k] as u64);
    }
    v
}

fn le64(b: ref Vec[u8], i: i64) -> u64 {
    let mut v: u64 = 0;
    let mut k: i64 = 7;
    while k >= 0 {
        v = (v << 8) | (b[i + k] as u64);
        k -= 1;
    }
    v
}

fn push_le32(out: mut ref Vec[u8], x: u32) {
    for k in 0..4 {
        out.push(((x >> ((8 * k) as u32)) & 0xFFu32) as u8);
    }
}

fn push_be32(out: mut ref Vec[u8], x: u32) {
    let mut k: i64 = 3;
    while k >= 0 {
        out.push(((x >> ((8 * k) as u32)) & 0xFFu32) as u8);
        k -= 1;
    }
}

fn push_be64(out: mut ref Vec[u8], x: u64) {
    let mut k: i64 = 7;
    while k >= 0 {
        out.push(((x >> ((8 * k) as u64)) & 0xFFu64) as u8);
        k -= 1;
    }
}



fn sha1(msg: ref Vec[u8]) -> Vec[u8] {
    let m = md_pad(msg, 64, 8, true);
    let mut h: Vec[u32] = Vec.new();
    for x in [0x67452301u32, 0xEFCDAB89u32, 0x98BADCFEu32, 0x10325476u32, 0xC3D2E1F0u32] {
        h.push(x);
    }
    let mut w: Vec[u32] = Vec.new();
    for _ in 0..80 {
        w.push(0u32);
    }
    let mut blk: i64 = 0;
    while blk < m.len() {
        for t in 0..16 {
            w[t] = be32(m, blk + 4 * t);
        }
        for t in 16..80 {
            w[t] = (w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16]).rotate_left(1);
        }
        let mut a = h[0];
        let mut b = h[1];
        let mut c = h[2];
        let mut d = h[3];
        let mut e = h[4];
        for t in 0..80 {
            let mut f: u32 = 0;
            let mut k: u32 = 0;
            if t < 20 {
                f = (b & c) | ((b ^ 0xFFFFFFFFu32) & d);
                k = 0x5A827999u32;
            } else if t < 40 {
                f = b ^ c ^ d;
                k = 0x6ED9EBA1u32;
            } else if t < 60 {
                f = (b & c) | (b & d) | (c & d);
                k = 0x8F1BBCDCu32;
            } else {
                f = b ^ c ^ d;
                k = 0xCA62C1D6u32;
            }
            let tmp = a.rotate_left(5).wrapping_add(f).wrapping_add(e).wrapping_add(k).wrapping_add(w[t]);
            e = d;
            d = c;
            c = b.rotate_left(30);
            b = a;
            a = tmp;
        }
        h[0] = h[0].wrapping_add(a);
        h[1] = h[1].wrapping_add(b);
        h[2] = h[2].wrapping_add(c);
        h[3] = h[3].wrapping_add(d);
        h[4] = h[4].wrapping_add(e);
        blk += 64;
    }
    let mut out: Vec[u8] = Vec.new();
    for x in h {
        push_be32(mut out, x);
    }
    out
}
// ------------------------------------------------------------ Python values

// A Python exception: its type and str().
struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: own String) -> Exc {
    Exc { kind: kind.to_string(), msg: msg }
}

fn err_line(e: ref Exc) -> String {
    f"error: {e.kind}: {e.msg}"
}

// What Bencode.decode builds: None (only ever set by a caller), int,
// str, bytes, list and dict, plus the container creators the decoder
// leaves on its stack when a list or dict is never closed.
#[derive(Clone)]
enum BVal {
    NoneV,
    Int(String),
    Str(String),
    Bytes(Vec[u8]),
    List(Vec[BVal]),
    Dict(Vec[(BVal, BVal)]),
    Mark(bool),
}

fn type_name(v: ref BVal) -> String {
    match v {
        BVal.NoneV => "NoneType".to_string(),
        BVal.Int(_) => "int".to_string(),
        BVal.Str(_) => "str".to_string(),
        BVal.Bytes(_) => "bytes".to_string(),
        BVal.List(_) => "list".to_string(),
        BVal.Dict(_) => "dict".to_string(),
        BVal.Mark(_) => "function".to_string(),
    }
}

fn creator_name(is_dict: bool) -> String {
    if is_dict { "create_dict".to_string() } else { "create_list".to_string() }
}

// repr() of a bytes object.
fn py_repr_bytes(b: ref Vec[u8]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for c in b.iter() {
        if *c == b'\'' {
            has_single = true;
        }
        if *c == b'"' {
            has_double = true;
        }
    }
    let q = if has_single and not has_double { b'"' } else { b'\'' };
    let mut out = "b".to_string();
    out.push(q as u32 as u8 as char);
    for c in b.iter() {
        let n = *c as i64;
        if *c == q or *c == b'\\' {
            out.push('\\');
            out.push(*c as char);
        } else if *c == b'\t' {
            out.push_str("\\t");
        } else if *c == b'\n' {
            out.push_str("\\n");
        } else if *c == b'\r' {
            out.push_str("\\r");
        } else if n < 0x20 or n >= 0x7f {
            out.push_str(f"\\x{hex_digits(n, 2)}");
        } else {
            out.push(*c as char);
        }
    }
    out.push(q as char);
    out
}

// repr() of a value. The creators carry an address in Python, which is
// shown as 0x... (the oracle masks it the same way).
fn py_repr(v: ref BVal) -> String {
    match v {
        BVal.NoneV => "None".to_string(),
        BVal.Int(s) => s.clone(),
        BVal.Str(s) => py_repr_str(s),
        BVal.Bytes(b) => py_repr_bytes(b),
        BVal.List(items) => {
            let mut parts: Vec[String] = Vec.new();
            for x in items.iter() {
                parts.push(py_repr(x));
            }
            f"[{join(parts, ", ")}]"
        }
        BVal.Dict(items) => {
            let mut parts: Vec[String] = Vec.new();
            for (k, x) in items.iter() {
                parts.push(f"{py_repr(k)}: {py_repr(x)}");
            }
            "{" + join(parts, ", ") + "}"
        }
        BVal.Mark(d) => f"<function Bencode.decode.<locals>.{creator_name(d)} at 0x...>",
    }
}

// str() of a value.
fn py_str(v: ref BVal) -> String {
    match v {
        BVal.Str(s) => s.clone(),
        _ => py_repr(v),
    }
}

// The oracle's value(): long bytes and the creators abbreviated.
fn value(v: ref BVal) -> String {
    match v {
        BVal.Bytes(b) => {
            if b.len() <= 32 { py_repr_bytes(b) } else { f"<{b.len()} bytes>" }
        }
        BVal.List(items) => {
            let mut parts: Vec[String] = Vec.new();
            for x in items.iter() {
                parts.push(value(x));
            }
            f"[{join(parts, ", ")}]"
        }
        BVal.Dict(items) => {
            let mut parts: Vec[String] = Vec.new();
            for (k, x) in items.iter() {
                parts.push(f"{value(k)}: {value(x)}");
            }
            "{" + join(parts, ", ") + "}"
        }
        BVal.Mark(d) => {
            if d { "<open dict>".to_string() } else { "<open list>".to_string() }
        }
        _ => py_repr(v),
    }
}

fn truthy(v: ref BVal) -> bool {
    match v {
        BVal.NoneV => false,
        BVal.Int(s) => *s != "0",
        BVal.Str(s) => s.len() > 0,
        BVal.Bytes(b) => b.len() > 0,
        BVal.List(items) => items.len() > 0,
        BVal.Dict(items) => items.len() > 0,
        BVal.Mark(_) => true,
    }
}

fn py_eq(a: ref BVal, b: ref BVal) -> bool {
    match (a, b) {
        (BVal.NoneV, BVal.NoneV) => true,
        (BVal.Int(x), BVal.Int(y)) => *x == *y,
        (BVal.Str(x), BVal.Str(y)) => *x == *y,
        (BVal.Bytes(x), BVal.Bytes(y)) => *x == *y,
        (BVal.Mark(x), BVal.Mark(y)) => x == y,
        (BVal.List(x), BVal.List(y)) => {
            if x.len() != y.len() {
                return false;
            }
            for i in 0..x.len() {
                if not py_eq(x[i], y[i]) {
                    return false;
                }
            }
            true
        }
        (BVal.Dict(x), BVal.Dict(y)) => {
            if x.len() != y.len() {
                return false;
            }
            for (k, v) in x.iter() {
                match dict_find(y, k) {
                    Some(j) => {
                        if not py_eq(v, y[j].1) {
                            return false;
                        }
                    }
                    None => return false,
                }
            }
            true
        }
        _ => false,
    }
}

fn dict_find(d: ref Vec[(BVal, BVal)], key: ref BVal) -> Option[i64] {
    for i in 0..d.len() {
        if py_eq(d[i].0, key) {
            return Some(i);
        }
    }
    None
}

// Two of Python's ints, as canonical decimal text.
fn int_lt(a: ref String, b: ref String) -> bool {
    let an = a.starts_with("-");
    let bn = b.starts_with("-");
    if an != bn {
        return an;
    }
    let ad = if an { a.len() - 1 } else { a.len() };
    let bd = if bn { b.len() - 1 } else { b.len() };
    let mag_lt = if ad != bd { ad < bd } else { *a < *b };
    let mag_eq = *a == *b;
    if an { not mag_lt and not mag_eq } else { mag_lt }
}

fn lt_error(a: ref BVal, b: ref BVal) -> Exc {
    exc("TypeError", f"'<' not supported between instances of '{type_name(a)}' and '{type_name(b)}'")
}

// a < b, as Python compares the keys of a dict being sorted.
fn py_lt(a: ref BVal, b: ref BVal) -> Result[bool, Exc] {
    match (a, b) {
        (BVal.Int(x), BVal.Int(y)) => Ok(int_lt(x, y)),
        (BVal.Str(x), BVal.Str(y)) => Ok(*x < *y),
        (BVal.Bytes(x), BVal.Bytes(y)) => {
            let mut i = 0;
            while i < x.len() and i < y.len() {
                if x[i] != y[i] {
                    return Ok(x[i] < y[i]);
                }
                i += 1;
            }
            Ok(x.len() < y.len())
        }
        (BVal.List(x), BVal.List(y)) => {
            let mut i = 0;
            while i < x.len() and i < y.len() {
                if not py_eq(x[i], y[i]) {
                    return py_lt(x[i], y[i]);
                }
                i += 1;
            }
            Ok(x.len() < y.len())
        }
        _ => Err(lt_error(a, b)),
    }
}

// sorted(pairs, key=itemgetter(0)): a stable insertion sort, so two
// keys meet in the order list.sort first compares them.
fn sort_pairs(pairs: own Vec[(BVal, BVal)]) -> Result[Vec[(BVal, BVal)], Exc] {
    let mut v = pairs;
    for i in 1..v.len() {
        let mut j = i;
        while j > 0 {
            if not py_lt(v[j].0, v[j - 1].0)? {
                break;
            }
            v.swap(j - 1, j);
            j -= 1;
        }
    }
    Ok(v)
}

// create_dict: zip the items into pairs (an odd last item is dropped),
// sort them by key and build the dict, the last value of a key winning.
fn create_dict(items: own Vec[BVal]) -> Result[BVal, Exc] {
    let mut pairs: Vec[(BVal, BVal)] = Vec.new();
    let mut i = 0;
    while i + 1 < items.len() {
        pairs.push((items[i].clone(), items[i + 1].clone()));
        i += 2;
    }
    let sorted = sort_pairs(pairs)?;
    let mut out: Vec[(BVal, BVal)] = Vec.new();
    for (k, v) in sorted.iter() {
        match k {
            BVal.List(_) => return Err(exc("TypeError", "unhashable type: 'list'".to_string())),
            BVal.Dict(_) => return Err(exc("TypeError", "unhashable type: 'dict'".to_string())),
            _ => {}
        }
        match dict_find(out, k) {
            Some(j) => out[j].1 = v.clone(),
            None => out.push((k.clone(), v.clone())),
        }
    }
    Ok(BVal.Dict(out))
}

// ------------------------------------------------------------ UTF-8

// bytes.decode() in its strict and its errors="replace" forms: the text,
// and whether every byte was valid. A bad sequence becomes one U+FFFD
// per maximal valid prefix, as Python and the Unicode standard do it.
fn utf8_decode(b: ref Vec[u8], from: i64, to: i64) -> (String, bool) {
    let mut out = String.new();
    let mut ok = true;
    let mut i = from;
    while i < to {
        let c = b[i] as u32;
        if c < 0x80 {
            out.push(char.try_from(c).unwrap_or('?'));
            i += 1;
            continue;
        }
        let mut need = 0;
        let mut lo: u32 = 0x80;
        let mut hi: u32 = 0xBF;
        let mut cp: u32 = 0;
        if c >= 0xC2 and c <= 0xDF {
            need = 1;
            cp = c & 0x1F;
        } else if c >= 0xE0 and c <= 0xEF {
            need = 2;
            cp = c & 0x0F;
            if c == 0xE0 {
                lo = 0xA0;
            }
            if c == 0xED {
                hi = 0x9F;
            }
        } else if c >= 0xF0 and c <= 0xF4 {
            need = 3;
            cp = c & 0x07;
            if c == 0xF0 {
                lo = 0x90;
            }
            if c == 0xF4 {
                hi = 0x8F;
            }
        }
        if need == 0 {
            out.push('\u{FFFD}');
            ok = false;
            i += 1;
            continue;
        }
        let mut j = i + 1;
        let mut good = true;
        let mut k = 0;
        while k < need {
            if j >= to {
                good = false;
                break;
            }
            let d = b[j] as u32;
            let (l, h) = if k == 0 { (lo, hi) } else { (0x80u32, 0xBFu32) };
            if d < l or d > h {
                good = false;
                break;
            }
            cp = (cp << 6) | (d & 0x3F);
            j += 1;
            k += 1;
        }
        if good {
            out.push(char.try_from(cp).unwrap_or('?'));
        } else {
            out.push('\u{FFFD}');
            ok = false;
        }
        i = j;
    }
    (out, ok)
}

// chr() of a byte.
fn latin1(c: u8) -> char {
    char.try_from(c as u32).unwrap_or('?')
}

// ------------------------------------------------------------ Bencode.decode

// parse_forward: the characters up to `till` through int(), and how far
// the caller moves on.
fn parse_forward(data: ref Vec[u8], start: i64, till: u8) -> Result[(String, i64), Exc] {
    let mut cs: Vec[char] = Vec.new();
    let mut idx: i64 = 0;
    let mut k = start;
    while k < data.len() {
        idx = k - start;
        if data[k] == till {
            break;
        }
        cs.push(latin1(data[k]));
        k += 1;
    }
    if cs.len() == 0 {
        return Ok(("0".to_string(), idx + 1));
    }
    match py_int(cs) {
        Some(n) => Ok((n, idx + 1)),
        None => {
            let text: String = cs.iter().collect();
            Err(exc("ValueError", f"invalid literal for int() with base 10: {limit_chars(py_repr_str(text), 200)}"))
        }
    }
}

fn limit_chars(s: own String, n: i64) -> String {
    let cs: Vec[char] = s.chars().collect();
    if cs.len() <= n {
        return s;
    }
    let mut out = String.new();
    for i in 0..n {
        out.push(cs[i]);
    }
    out
}

// The length of a string, clamped to what is left of the data.
fn clamp_len(n: ref String, left: i64) -> i64 {
    if n.len() > 18 {
        return left + 1;
    }
    match i64.parse(n.clone()) {
        Ok(x) => if x > left { left + 1 } else { x },
        Err(_) => left + 1,
    }
}

// str.isdigit() of chr(byte): ASCII digits and ², ³ and ¹.
fn digit_start(c: u8) -> bool {
    (c >= b'0' and c <= b'9') or c == 0xB2 or c == 0xB3 or c == 0xB9
}

fn byte_keyed(latest: Option[BVal], keys: ref Option[Vec[String]]) -> bool {
    match keys {
        None => true,
        Some(ks) => {
            let name = match latest {
                Some(v) => py_str(v),
                None => "None".to_string(),
            };
            for k in ks.iter() {
                if *k == name {
                    return true;
                }
            }
            false
        }
    }
}

fn bdecode(data: ref Vec[u8], keys: ref Option[Vec[String]]) -> Result[BVal, Exc] {
    let mut items: Vec[BVal] = Vec.new();
    let mut opens: Vec[bool] = Vec.new();
    let n = data.len();
    let mut p: i64 = 0;
    while p < n {
        let c = data[p];
        if c == b'd' or c == b'l' {
            items.push(BVal.Mark(c == b'd'));
            opens.push(c == b'd');
            p += 1;
        } else if c == b'i' {
            let (num, used) = parse_forward(data, p + 1, b'e')?;
            items.push(BVal.Int(num));
            p = p + 1 + used;
        } else if digit_start(c) {
            let (len_text, used) = parse_forward(data, p, b':')?;
            let start = if p + used > n { n } else { p + used };
            let len = clamp_len(len_text, n - start);
            let end = if start + len > n { n } else { start + len };
            let (text, ok) = utf8_decode(data, start, end);
            if ok {
                items.push(BVal.Str(text));
            } else {
                let latest: Option[BVal] = if items.len() > 0 { Some(items[items.len() - 1].clone()) } else { None };
                if byte_keyed(latest, keys) {
                    let mut raw: Vec[u8] = Vec.new();
                    for k in start..end {
                        raw.push(data[k]);
                    }
                    items.push(BVal.Bytes(raw));
                } else {
                    items.push(BVal.Str(text));
                }
            }
            p = if start + len > n { n } else { start + len };
        } else if c == b'e' {
            if opens.len() == 0 {
                let (rest, _) = utf8_decode(data, p, n);
                return Err(exc("BencodeDecodingError", f"Unable to parse the rest of the data: \"{limit_chars(rest, 60)}\""));
            }
            let is_dict = opens.pop().unwrap_or(false);
            let mut sub: Vec[BVal] = Vec.new();
            loop {
                let it = items.pop().unwrap_or(BVal.Mark(is_dict));
                match it {
                    BVal.Mark(_) => break,
                    _ => sub.push(it),
                }
            }
            sub.reverse();
            if is_dict {
                items.push(create_dict(sub)?);
            } else {
                items.push(BVal.List(sub));
            }
            p += 1;
        } else {
            return Err(exc("BencodeDecodingError", f"Unable to interpret `{latin1(c)}` char."));
        }
    }
    if items.len() == 1 {
        return Ok(items.pop().unwrap_or(BVal.NoneV));
    }
    Ok(BVal.List(items))
}

// ------------------------------------------------------------ Bencode.encode

fn push_text(out: mut ref Vec[u8], s: Str) {
    for b in s.bytes() {
        out.push(b);
    }
}

fn encode_into(v: ref BVal, out: mut ref Vec[u8]) -> Result[(), Exc] {
    match v {
        BVal.Str(s) => {
            push_text(mut out, f"{s.len()}:");
            push_text(mut out, s);
        }
        BVal.Int(s) => push_text(mut out, f"i{s}e"),
        BVal.List(items) => {
            out.push(b'l');
            for x in items.iter() {
                encode_into(x, mut out)?;
            }
            out.push(b'e');
        }
        BVal.Dict(items) => {
            out.push(b'd');
            let sorted = sort_pairs(items.clone())?;
            for (k, x) in sorted.iter() {
                match k {
                    BVal.Str(s) => {
                        push_text(mut out, f"{s.len()}:");
                        push_text(mut out, s);
                    }
                    BVal.NoneV => return Err(exc("TypeError", "utf_8_encode() argument 1 must be str, not None".to_string())),
                    _ => return Err(exc("TypeError", f"utf_8_encode() argument 1 must be str, not {type_name(k)}")),
                }
                encode_into(x, mut out)?;
            }
            out.push(b'e');
        }
        BVal.Bytes(b) => {
            push_text(mut out, f"{b.len()}:");
            for x in b.iter() {
                out.push(*x);
            }
        }
        _ => return Err(exc("BencodeEncodingError", f"Unable to encode `<class '{type_name(v)}'>` {py_repr(v)}")),
    }
    Ok(())
}

fn bencode(v: ref BVal) -> Result[Vec[u8], Exc] {
    let mut out: Vec[u8] = Vec.new();
    encode_into(v, mut out)?;
    Ok(out)
}
// ------------------------------------------------------------ Python's dict, list and str operations

fn s(text: Str) -> BVal {
    BVal.Str(text.to_string())
}

fn int_val(n: i128) -> BVal {
    BVal.Int(f"{n}")
}

fn attr_get_error(v: ref BVal) -> Exc {
    exc("AttributeError", f"'{type_name(v)}' object has no attribute 'get'")
}

// v.get(key): None when the key is missing.
fn dget(v: ref BVal, key: Str) -> Result[Option[BVal], Exc] {
    match v {
        BVal.Dict(items) => {
            match dict_find(items, s(key)) {
                Some(j) => Ok(Some(items[j].1.clone())),
                None => Ok(None),
            }
        }
        _ => Err(attr_get_error(v)),
    }
}

// v.get(key) with None for a missing key.
fn dget_none(v: ref BVal, key: Str) -> Result[BVal, Exc] {
    Ok(dget(v, key)?.unwrap_or(BVal.NoneV))
}

// v[key] with a str key.
fn getitem(v: ref BVal, key: Str) -> Result[BVal, Exc] {
    match v {
        BVal.Dict(items) => {
            match dict_find(items, s(key)) {
                Some(j) => Ok(items[j].1.clone()),
                None => Err(exc("KeyError", py_repr_str(key.to_string()))),
            }
        }
        BVal.List(_) => Err(exc("TypeError", "list indices must be integers or slices, not str".to_string())),
        BVal.Str(_) => Err(exc("TypeError", "string indices must be integers, not 'str'".to_string())),
        BVal.Bytes(_) => Err(exc("TypeError", "byte indices must be integers or slices, not str".to_string())),
        _ => Err(exc("TypeError", f"'{type_name(v)}' object is not subscriptable")),
    }
}

// v[0].
fn index0(v: ref BVal) -> Result[BVal, Exc] {
    match v {
        BVal.List(items) => {
            if items.len() == 0 {
                return Err(exc("IndexError", "list index out of range".to_string()));
            }
            Ok(items[0].clone())
        }
        BVal.Str(t) => {
            match t.chars().next() {
                Some(c) => Ok(BVal.Str(c.to_string())),
                None => Err(exc("IndexError", "string index out of range".to_string())),
            }
        }
        BVal.Bytes(b) => {
            if b.len() == 0 {
                return Err(exc("IndexError", "index out of range".to_string()));
            }
            Ok(int_val(b[0] as i128))
        }
        BVal.Dict(items) => {
            match dict_find(items, int_val(0)) {
                Some(j) => Ok(items[j].1.clone()),
                None => Err(exc("KeyError", "0".to_string())),
            }
        }
        _ => Err(exc("TypeError", f"'{type_name(v)}' object is not subscriptable")),
    }
}

// key in v, with a str key.
fn contains(v: ref BVal, key: Str) -> Result[bool, Exc] {
    match v {
        BVal.Dict(items) => Ok(dict_find(items, s(key)).is_some()),
        BVal.List(items) => {
            for x in items.iter() {
                if py_eq(x, s(key)) {
                    return Ok(true);
                }
            }
            Ok(false)
        }
        BVal.Str(t) => Ok(t.contains(key)),
        BVal.Bytes(_) => Err(exc("TypeError", "a bytes-like object is required, not 'str'".to_string())),
        _ => Err(exc("TypeError", f"argument of type '{type_name(v)}' is not iterable")),
    }
}

// iter(v): the items of a list, the keys of a dict, the characters of a
// str and the ints of a bytes.
fn py_iter(v: ref BVal) -> Result[Vec[BVal], Exc] {
    let mut out: Vec[BVal] = Vec.new();
    match v {
        BVal.List(items) => {
            for x in items.iter() {
                out.push(x.clone());
            }
        }
        BVal.Dict(items) => {
            for (k, _) in items.iter() {
                out.push(k.clone());
            }
        }
        BVal.Str(t) => {
            for c in t.chars() {
                out.push(BVal.Str(c.to_string()));
            }
        }
        BVal.Bytes(b) => {
            for x in b.iter() {
                out.push(int_val(*x as i128));
            }
        }
        _ => return Err(exc("TypeError", f"'{type_name(v)}' object is not iterable")),
    }
    Ok(out)
}

fn item_assign_error(v: ref BVal) -> Exc {
    exc("TypeError", f"'{type_name(v)}' object does not support item assignment")
}

// v[key] = x: an existing key keeps its place, a new one goes last.
fn set_item(v: mut ref BVal, key: Str, x: own BVal) -> Result[(), Exc] {
    match v {
        BVal.Dict(items) => {
            match dict_find(items, s(key)) {
                Some(j) => items[j].1 = x,
                None => items.push((s(key), x)),
            }
            Ok(())
        }
        _ => Err(item_assign_error(v)),
    }
}

// del v[key].
fn del_item(v: mut ref BVal, key: Str) -> Result[(), Exc] {
    match v {
        BVal.Dict(items) => {
            match dict_find(items, s(key)) {
                Some(j) => {
                    items.remove(j);
                    Ok(())
                }
                None => Err(exc("KeyError", py_repr_str(key.to_string()))),
            }
        }
        BVal.List(_) => Err(exc("TypeError", "list indices must be integers or slices, not str".to_string())),
        _ => Err(exc("TypeError", f"'{type_name(v)}' object doesn't support item deletion")),
    }
}

// int() of a value.
fn py_int_of(v: ref BVal) -> Result[i128, Exc] {
    let text = match v {
        BVal.Int(t) => t.clone(),
        BVal.Str(t) => {
            let cs: Vec[char] = t.chars().collect();
            match py_int(cs) {
                Some(n) => n,
                None => return Err(exc("ValueError", f"invalid literal for int() with base 10: {limit_chars(py_repr_str(t), 200)}")),
            }
        }
        BVal.Bytes(b) => {
            let mut cs: Vec[char] = Vec.new();
            let mut ascii = true;
            for x in b.iter() {
                if *x >= 128 {
                    ascii = false;
                }
                cs.push(latin1(*x));
            }
            match if ascii { py_int(cs) } else { None } {
                Some(n) => n,
                None => return Err(exc("ValueError", f"invalid literal for int() with base 10: {limit_chars(py_repr_bytes(b), 200)}")),
            }
        }
        _ => return Err(exc("TypeError", f"int() argument must be a string, a bytes-like object or a real number, not '{type_name(v)}'")),
    };
    match i128.parse(text.clone()) {
        Ok(n) => Ok(n),
        Err(_) => Err(exc("OverflowError", "timestamp out of range for platform time_t".to_string())),
    }
}

// ------------------------------------------------------------ dates

fn days_from_civil(y: i128, m: i128, d: i128) -> i128 {
    let yy = if m <= 2 { y - 1 } else { y };
    let era = (if yy >= 0 { yy } else { yy - 399 }) / 400;
    let yoe = yy - era * 400;
    let mp = (m + 9) % 12;
    let doy = (153 * mp + 2) / 5 + d - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

fn civil_from_days(z: i128) -> (i128, i128, i128) {
    let zz = z + 719468;
    let era = (if zz >= 0 { zz } else { zz - 146096 }) / 146097;
    let doe = zz - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let y = yoe + era * 400;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = if mp < 10 { mp + 3 } else { mp - 9 };
    (if m <= 2 { y + 1 } else { y }, m, d)
}

fn pad(n: i128, width: i64) -> String {
    let mut t = f"{n}";
    while t.len() < width {
        t = f"0{t}";
    }
    t
}

fn floor_div(a: i128, b: i128) -> i128 {
    let q = a / b;
    if a % b != 0 and a < 0 { q - 1 } else { q }
}

// str(datetime.utcfromtimestamp(t)).
fn utc_text(t: i128) -> Result[String, Exc] {
    let days = floor_div(t, 86400);
    let secs = t - days * 86400;
    let (y, m, d) = civil_from_days(days);
    if y < 1 or y > 9999 {
        return Err(exc("ValueError", f"year {y} is out of range"));
    }
    Ok(f"{pad(y, 4)}-{pad(m, 2)}-{pad(d, 2)} {pad(secs / 3600, 2)}:{pad(secs / 60 % 60, 2)}:{pad(secs % 60, 2)}")
}

fn num_at(t: ref String, from: i64, to: i64) -> i128 {
    let b = to_bytes(t);
    i128.parse(byte_str(b, from, to)).unwrap_or(0)
}

// calendar.timegm(datetime.fromisoformat(text).timetuple()), for the
// YYYY-MM-DDTHH:MM:SS form.
fn timegm_iso(t: ref String) -> i128 {
    let days = days_from_civil(num_at(t, 0, 4), num_at(t, 5, 7), num_at(t, 8, 10));
    days * 86400 + num_at(t, 11, 13) * 3600 + num_at(t, 14, 16) * 60 + num_at(t, 17, 19)
}

// ------------------------------------------------------------ torrentool.utils

// humanize_filesize: the unit from math.log(size, 1024) and the size
// through round(..., 2), which is exact here since the size is an
// integer over a power of two.
fn humanize_filesize(n: i128) -> String {
    if n == 0 {
        return "0 B".to_string();
    }
    let names: Vec[Str] = vec!["B", "KB", "MB", "GB", "TB", "PB", "EB", "ZB", "YB"];
    let idx = ((n as f64).ln() / (1024.0).ln()).floor() as i64;
    let den: i128 = 1 << (10 * idx);
    let num = n * 100;
    let mut r = num / den;
    let rem = num - r * den;
    if rem * 2 > den or (rem * 2 == den and r % 2 == 1) {
        r += 1;
    }
    let whole = r / 100;
    let frac = r % 100;
    let tail = if frac == 0 { "0".to_string() } else if frac % 10 == 0 { f"{frac / 10}" } else { pad(frac, 2) };
    f"{whole}.{tail} {names[idx]}"
}

// ------------------------------------------------------------ paths

fn path_join(base: ref BVal, comps: ref Vec[BVal]) -> Result[BVal, Exc] {
    let mut has_str = false;
    let mut has_bytes = false;
    match base {
        BVal.Str(_) => has_str = true,
        BVal.Bytes(_) => has_bytes = true,
        _ => return Err(exc("TypeError", f"expected str, bytes or os.PathLike object, not {type_name(base)}")),
    }
    for c in comps.iter() {
        match c {
            BVal.Str(_) => has_str = true,
            BVal.Bytes(_) => has_bytes = true,
            _ => return Err(exc("TypeError", f"join() argument must be str, bytes, or os.PathLike object, not '{type_name(c)}'")),
        }
    }
    if has_str and has_bytes {
        return Err(exc("TypeError", "Can't mix strings and bytes in path components".to_string()));
    }
    let mut path = path_bytes(base);
    for c in comps.iter() {
        let b = path_bytes(c);
        if b.len() > 0 and b[0] == b'/' {
            path = b;
        } else if path.len() == 0 or path[path.len() - 1] == b'/' {
            path.extend(b);
        } else {
            path.push(b'/');
            path.extend(b);
        }
    }
    if has_bytes {
        return Ok(BVal.Bytes(path));
    }
    Ok(BVal.Str(from_bytes(path)))
}

fn path_bytes(v: ref BVal) -> Vec[u8] {
    match v {
        BVal.Str(t) => to_bytes(t),
        BVal.Bytes(b) => b.clone(),
        _ => Vec.new(),
    }
}

// os.path.normpath.
fn normpath(path: ref String) -> String {
    if path.len() == 0 {
        return ".".to_string();
    }
    let mut initial = if path.starts_with("/") { 1 } else { 0 };
    if path.starts_with("//") and not path.starts_with("///") {
        initial = 2;
    }
    let mut parts: Vec[String] = Vec.new();
    for comp in split_on(path, b'/').iter() {
        if comp.len() == 0 or *comp == "." {
            continue;
        }
        if *comp != ".." or (initial == 0 and parts.len() == 0) or (parts.len() > 0 and parts[parts.len() - 1] == "..") {
            parts.push(comp.clone());
        } else if parts.len() > 0 {
            parts.pop();
        }
    }
    let mut out = String.new();
    for _ in 0..initial {
        out.push('/');
    }
    out.push_str(join(parts, "/"));
    if out.len() == 0 { ".".to_string() } else { out }
}

fn strip_slashes(t: ref String) -> String {
    let b = to_bytes(t);
    let mut i: i64 = 0;
    let mut j = b.len();
    while i < j and b[i] == b'/' {
        i += 1;
    }
    while j > i and b[j - 1] == b'/' {
        j -= 1;
    }
    byte_str(b, i, j)
}

fn basename(t: ref String) -> String {
    let parts = split_on(t, b'/');
    parts[parts.len() - 1].clone()
}

// ------------------------------------------------------------ Torrent

struct TFile {
    name: BVal,
    length: BVal,
}

struct Torrent {
    st: BVal,
}

fn new_torrent(v: own BVal) -> Torrent {
    if truthy(v) {
        Torrent { st: v }
    } else {
        Torrent { st: BVal.Dict(vec![(s("info"), BVal.Dict(Vec.new()))]) }
    }
}

fn read_torrent(path: ref String) -> Result[Torrent, Exc] {
    let data = match fs.read_bytes(path.clone()) {
        Ok(b) => b,
        Err(e) => return Err(exc("FileNotFoundError", f"{e}")),
    };
    let keys: Option[Vec[String]] = Some(vec!["pieces".to_string()]);
    Ok(new_torrent(bdecode(data, keys)?))
}

impl Torrent {
    // self._struct.get('info', {})
    fn info_or_empty(ref self) -> Result[BVal, Exc] {
        Ok(dget(self.st, "info")?.unwrap_or(BVal.Dict(Vec.new())))
    }

    fn name(ref self) -> Result[BVal, Exc] {
        dget_none(self.info_or_empty()?, "name")
    }

    fn files(ref self) -> Result[Vec[TFile], Exc] {
        let mut out: Vec[TFile] = Vec.new();
        let info = dget_none(self.st, "info")?;
        if not truthy(info) {
            return Ok(out);
        }
        if contains(info, "files")? {
            let base = getitem(info, "name")?;
            for f in py_iter(getitem(info, "files")?)?.iter() {
                let comps = py_iter(getitem(f, "path")?)?;
                let name = path_join(base, comps)?;
                out.push(TFile { name: name, length: getitem(f, "length")? });
            }
        } else {
            let name = getitem(info, "name")?;
            out.push(TFile { name: name, length: getitem(info, "length")? });
        }
        Ok(out)
    }

    fn total_size(ref self) -> Result[i128, Exc] {
        let mut total: i128 = 0;
        for f in self.files()?.iter() {
            match f.length {
                BVal.Int(t) => total += i128.parse(t.clone()).unwrap_or(0),
                _ => return Err(exc("TypeError", f"unsupported operand type(s) for +: 'int' and '{type_name(f.length)}'")),
            }
        }
        Ok(total)
    }

    fn info_hash(ref self) -> Result[Option[String], Exc] {
        let info = dget_none(self.st, "info")?;
        if not truthy(info) {
            return Ok(None);
        }
        let b = bencode(info)?;
        Ok(Some(hex_of(sha1(b))))
    }

    fn announce_urls(ref self) -> Result[BVal, Exc] {
        let urls = dget_none(self.st, "announce-list")?;
        if truthy(urls) {
            return Ok(urls);
        }
        let one = dget_none(self.st, "announce")?;
        if not truthy(one) {
            return Ok(BVal.List(Vec.new()));
        }
        Ok(BVal.List(vec![BVal.List(vec![one])]))
    }

    fn list_getter(ref self, key: Str) -> Result[BVal, Exc] {
        let v = dget_none(self.st, key)?;
        if truthy(v) { Ok(v) } else { Ok(BVal.List(Vec.new())) }
    }

    fn webseeds(ref self) -> Result[BVal, Exc] {
        self.list_getter("url-list")
    }

    fn httpseeds(ref self) -> Result[BVal, Exc] {
        self.list_getter("httpseeds")
    }

    fn get(ref self, key: Str) -> Result[BVal, Exc] {
        dget_none(self.st, key)
    }

    fn source(ref self) -> Result[BVal, Exc] {
        let info = dget_none(self.st, "info")?;
        dget_none(info, "source")
    }

    fn creation_date(ref self) -> Result[String, Exc] {
        match dget(self.st, "creation date")? {
            None => Ok("None".to_string()),
            Some(d) => utc_text(py_int_of(d)?),
        }
    }

    // None stands for the default False.
    fn private(ref self) -> Result[Option[BVal], Exc] {
        dget(self.info_or_empty()?, "private")
    }

    fn private_text(ref self) -> Result[String, Exc] {
        match self.private()? {
            Some(v) => Ok(value(v)),
            None => Ok("False".to_string()),
        }
    }

    fn str_text(ref self) -> Result[String, Exc] {
        Ok(f"Torrent: {py_str(self.name()?)}")
    }

    // get_magnet: tr from the first tier of announce_urls, ws from webseeds.
    fn get_magnet(ref self, tr: bool, ws: bool) -> Result[String, Exc] {
        let hash = match self.info_hash()? {
            Some(h) => h,
            None => return Err(exc("TypeError", "can only concatenate str (not \"NoneType\") to str".to_string())),
        };
        let mut result = f"magnet:?xt=urn:btih:{hash}";
        let mut details: Vec[String] = Vec.new();
        if tr {
            let urls = self.announce_urls()?;
            if truthy(urls) {
                let first = index0(urls)?;
                let mut pairs: Vec[String] = Vec.new();
                for u in py_iter(first)?.iter() {
                    pairs.push(f"tr={quote_value(u)}");
                }
                if pairs.len() > 0 {
                    details.push(join(pairs, "&"));
                }
            }
        }
        if ws {
            let mut pairs: Vec[String] = Vec.new();
            for u in py_iter(self.webseeds()?)?.iter() {
                pairs.push(f"ws={quote_value(u)}");
            }
            if pairs.len() > 0 {
                details.push(join(pairs, "&"));
            }
        }
        if details.len() > 0 {
            result.push_str("&");
            result.push_str(join(details, "&"));
        }
        Ok(result)
    }

    fn magnet_link(ref self) -> Result[String, Exc] {
        self.get_magnet(false, false)
    }

    // The announce_urls setter.
    fn set_announce(mut ref self, val: own BVal) -> Result[(), Exc] {
        set_item(mut self.st, "announce", s(""))?;
        set_item(mut self.st, "announce-list", BVal.List(Vec.new()))?;
        match val {
            BVal.List(items) => {
                if items.len() == 1 {
                    del_item(mut self.st, "announce-list")?;
                    set_item(mut self.st, "announce", items[0].clone())?;
                } else if items.len() > 1 {
                    let mut tiers: Vec[BVal] = Vec.new();
                    for it in items.iter() {
                        match it {
                            BVal.List(_) => tiers.push(it.clone()),
                            _ => tiers.push(BVal.List(vec![it.clone()])),
                        }
                    }
                    set_item(mut self.st, "announce-list", BVal.List(tiers))?;
                    set_item(mut self.st, "announce", items[0].clone())?;
                }
            }
            _ => {
                del_item(mut self.st, "announce-list")?;
                set_item(mut self.st, "announce", val)?;
            }
        }
        Ok(())
    }

    // _list_setter, for webseeds and httpseeds.
    fn set_list(mut ref self, key: Str, val: own BVal) -> Result[(), Exc] {
        match val {
            BVal.NoneV => {
                if let BVal.Dict(items) = self.st {
                    match dict_find(items, s(key)) {
                        Some(j) => {
                            items.remove(j);
                        }
                        None => {}
                    }
                    return Ok(());
                }
                Err(exc("TypeError", f"'{type_name(self.st)}' object doesn't support item deletion"))
            }
            BVal.List(_) => set_item(mut self.st, key, val),
            _ => set_item(mut self.st, key, BVal.List(vec![val])),
        }
    }

    // self._struct['info'][key] = val
    fn set_info(mut ref self, key: Str, val: own BVal) -> Result[(), Exc] {
        match self.st {
            BVal.Dict(items) => {
                match dict_find(items, s("info")) {
                    Some(j) => set_item(mut items[j].1, key, val),
                    None => Err(exc("KeyError", "'info'".to_string())),
                }
            }
            _ => Err(exc("TypeError", f"'{type_name(self.st)}' object is not subscriptable")),
        }
    }

    // The private setter: False deletes info['private'] and ignores any
    // KeyError, True sets it to 1.
    fn set_private(mut ref self, on: bool) -> Result[(), Exc] {
        if on {
            return self.set_info("private", int_val(1));
        }
        if let BVal.Dict(items) = self.st {
            if let Some(j) = dict_find(items, s("info")) {
                del_quiet(mut items[j].1, "private");
            }
        }
        Ok(())
    }
}

// del v[key], ignoring a missing key.
fn del_quiet(v: mut ref BVal, key: Str) {
    if let BVal.Dict(d) = v {
        if let Some(k) = dict_find(d, s(key)) {
            d.remove(k);
        }
    }
}

fn hex_of(b: ref Vec[u8]) -> String {
    let mut out = String.new();
    for x in b.iter() {
        out.push_str(hex_digits(*x as i64, 2));
    }
    out
}

// quote_plus(str(v)) as urlencode does it, with safe=''.
fn quote_value(v: ref BVal) -> String {
    let raw = match v {
        BVal.Bytes(b) => b.clone(),
        _ => to_bytes(py_str(v)),
    };
    let hexd: Vec[char] = "0123456789ABCDEF".chars().collect();
    let mut out = String.new();
    for c in raw.iter() {
        let x = *c;
        if (x >= b'a' and x <= b'z') or (x >= b'A' and x <= b'Z') or (x >= b'0' and x <= b'9') or x == b'_' or x == b'.' or x == b'-' or x == b'~' {
            out.push(x as char);
        } else if x == b' ' {
            out.push('+');
        } else {
            out.push('%');
            out.push(hexd[(x >> 4) as i64]);
            out.push(hexd[(x & 15) as i64]);
        }
    }
    out
}

// ------------------------------------------------------------ Torrent.create_from

struct Target {
    path: String,
    size: i64,
    parts: Vec[String],
}

fn is_dir_path(p: ref String) -> bool {
    match fs.metadata(p.clone()) {
        Ok(m) => m.is_dir,
        Err(_) => false,
    }
}

fn is_file_path(p: ref String) -> bool {
    match fs.metadata(p.clone()) {
        Ok(m) => m.is_file,
        Err(_) => false,
    }
}

fn file_len(p: ref String) -> i64 {
    match fs.metadata(p.clone()) {
        Ok(m) => m.len as i64,
        Err(_) => 0,
    }
}

// os.walk top-down, each directory's files sorted: the paths in the
// order _get_target_files_info lists them.
fn walk(dir: ref String, out: mut ref Vec[String]) {
    let names = match fs.read_dir(dir.clone()) {
        Ok(n) => n,
        Err(_) => Vec.new(),
    };
    let mut files: Vec[String] = Vec.new();
    let mut dirs: Vec[String] = Vec.new();
    for n in names.iter() {
        let p = f"{dir}/{n}";
        if is_dir_path(p) {
            dirs.push(p);
        } else {
            files.push(p);
        }
    }
    for f in sort_strings(files).iter() {
        out.push(f.clone());
    }
    for d in sort_strings(dirs).iter() {
        walk(d, mut out);
    }
}

fn target_files(src: ref String) -> (Vec[Target], i64) {
    let mut paths: Vec[String] = Vec.new();
    if is_dir_path(src) {
        walk(src, mut paths);
    } else {
        paths.push(src.clone());
    }
    let mut out: Vec[Target] = Vec.new();
    let mut total: i64 = 0;
    for p in paths.iter() {
        let size = file_len(p);
        if size == 0 {
            continue;
        }
        let rel = strip_slashes(normpath(p.replace(src.as_str(), "")));
        out.push(Target { path: p.clone(), size: size, parts: split_on(rel, b'/') });
        total += size;
    }
    (out, total)
}

fn create_from(src: ref String) -> Result[Torrent, Exc] {
    let (targets, size_data) = target_files(src);
    let mut size_piece: i64 = 32768;
    if size_data > 32768 {
        size_piece = 262144;
    }
    let mut pieces: Vec[u8] = Vec.new();
    let mut buffer: Vec[u8] = Vec.new();
    for t in targets.iter() {
        let data = match fs.read_bytes(t.path.clone()) {
            Ok(b) => b,
            Err(_) => Vec.new(),
        };
        for b in data.iter() {
            buffer.push(*b);
            if buffer.len() == size_piece {
                pieces.extend(sha1(buffer));
                buffer = Vec.new();
            }
        }
    }
    if buffer.len() > 0 {
        pieces.extend(sha1(buffer));
    }
    let mut info: Vec[(BVal, BVal)] = Vec.new();
    info.push((s("name"), BVal.Str(basename(src))));
    info.push((s("pieces"), BVal.Bytes(pieces)));
    info.push((s("piece length"), int_val(size_piece as i128)));
    if is_dir_path(src) {
        let mut files: Vec[BVal] = Vec.new();
        for t in targets.iter() {
            let mut parts: Vec[BVal] = Vec.new();
            for p in t.parts.iter() {
                parts.push(BVal.Str(p.clone()));
            }
            files.push(BVal.Dict(vec![(s("length"), int_val(t.size as i128)), (s("path"), BVal.List(parts))]));
        }
        info.push((s("files"), BVal.List(files)));
    } else {
        if targets.len() == 0 {
            return Err(exc("TorrentError", "Unable to create torrent for an empty file.".to_string()));
        }
        info.push((s("length"), int_val(targets[0].size as i128)));
    }
    let mut t = new_torrent(BVal.Dict(vec![(s("info"), BVal.Dict(info))]));
    set_item(mut t.st, "created by", s("torrentool/1.2.0"))?;
    Ok(t)
}
// ------------------------------------------------------------ the jobs

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data_files() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn read_text(rel: ref String) -> String {
    match fs.read_to_string(f"data/{rel}") {
        Ok(s) => s,
        Err(_) => "".to_string(),
    }
}

// bytes.fromhex: pairs of hex digits, spaces between them allowed.
fn unhex(s: ref String) -> Vec[u8] {
    let mut digits: Vec[u8] = Vec.new();
    for c in s.bytes() {
        if c != b' ' {
            digits.push(c);
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < digits.len() {
        out.push((hex_val(digits[i]) * 16 + hex_val(digits[i + 1])) as u8);
        i += 2;
    }
    out
}
// CR shows as <CR> and other control characters (C0, DEL and C1) as
// <xNN>, so expected.out stays a plain LF text file.
fn show(text: ref String) -> String {
    let mut out = String.new();
    for c in text.chars() {
        let n = c as i64;
        if c == '\r' {
            out.push_str("<CR>");
        } else if (n < 0x20 and c != '\t' and c != '\n') or (n >= 0x7f and n <= 0x9f) {
            out.push_str(f"<x{hex_digits(n, 2)}>");
        } else {
            out.push(c);
        }
    }
    out
}

// Every line goes out through show().
fn emit(out: mut ref String, line: ref String) {
    out.push_str(show(line));
    out.push_str("\n");
}

fn data_path(rel: ref String) -> String {
    f"data/{rel}"
}

// Job text with \xNN escapes, as bytes.
fn unescape(text: ref String) -> Vec[u8] {
    let b = to_bytes(text);
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        if b[i] == b'\\' and i + 3 < b.len() and b[i + 1] == b'x' {
            out.push(hex_val(b[i + 2]) * 16 + hex_val(b[i + 3]));
            i += 4;
        } else {
            out.push(b[i]);
            i += 1;
        }
    }
    out
}

// Bytes for a log line: printable ASCII as is, the rest as \xNN.
fn escape(b: ref Vec[u8], from: i64, to: i64) -> String {
    let mut out = String.new();
    let mut i = if from < 0 { 0 } else { from };
    let end = if to > b.len() { b.len() } else { to };
    while i < end {
        let c = b[i];
        if c >= 0x20 and c < 0x7f and c != 0x5c {
            out.push(c as char);
        } else {
            out.push_str(f"\\x{hex_digits(c as i64, 2)}");
        }
        i += 1;
    }
    out
}

fn bdecode_job(args: ref Vec[String], out: mut ref String) {
    let keys: Option[Vec[String]] = if args[0] == "-" { None } else { Some(split_on(args[0], b',')) };
    match bdecode(unescape(args[1]), keys) {
        Ok(v) => emit(mut out, show(value(v))),
        Err(e) => emit(mut out, show(err_line(e))),
    }
}

fn read_string_job(args: ref Vec[String], out: mut ref String) {
    let keys: Option[Vec[String]] = None;
    match bdecode(to_bytes(args[0]), keys) {
        Ok(v) => emit(mut out, show(value(v))),
        Err(e) => emit(mut out, show(err_line(e))),
    }
}

fn humanize_job(args: ref Vec[String], out: mut ref String) {
    emit(mut out, humanize_filesize(i128.parse(args[0].clone()).unwrap_or(0)));
}

fn prop(out: mut ref String, label: Str, r: Result[String, Exc]) {
    match r {
        Ok(t) => emit(mut out, f"  {label}: {show(t)}"),
        Err(e) => emit(mut out, f"  {label}: {show(err_line(e))}"),
    }
}

fn files_text(t: ref Torrent) -> Result[String, Exc] {
    let mut parts: Vec[String] = Vec.new();
    for f in t.files()?.iter() {
        let n = match f.length {
            BVal.Int(x) => x.clone(),
            _ => return Err(exc("TypeError", f"%d format: a real number is required, not {type_name(f.length)}")),
        };
        parts.push(f"{py_repr(f.name)} ({n})");
    }
    Ok(f"[{join(parts, ", ")}]")
}

fn hash_repr(t: ref Torrent) -> Result[String, Exc] {
    match t.info_hash()? {
        Some(h) => Ok(py_repr_str(h)),
        None => Ok("None".to_string()),
    }
}

fn shown(r: own Result[BVal, Exc]) -> Result[String, Exc] {
    Ok(value(r?))
}

fn total_text(t: ref Torrent) -> Result[String, Exc] {
    Ok(f"{t.total_size()?}")
}

fn name_repr(t: ref Torrent) -> Result[String, Exc] {
    Ok(py_repr(t.name()?))
}

fn describe(t: ref Torrent, out: mut ref String) {
    prop(mut out, "str", t.str_text());
    prop(mut out, "name", name_repr(t));
    prop(mut out, "files", files_text(t));
    prop(mut out, "total_size", total_text(t));
    prop(mut out, "info_hash", hash_repr(t));
    prop(mut out, "announce_urls", shown(t.announce_urls()));
    prop(mut out, "webseeds", shown(t.webseeds()));
    prop(mut out, "httpseeds", shown(t.httpseeds()));
    prop(mut out, "comment", shown(t.get("comment")));
    prop(mut out, "source", shown(t.source()));
    prop(mut out, "creation_date", t.creation_date());
    prop(mut out, "created_by", shown(t.get("created by")));
    prop(mut out, "private", t.private_text());
    prop(mut out, "magnet_link", t.magnet_link());
    prop(mut out, "get_magnet()", t.get_magnet(true, true));
    prop(mut out, "get_magnet(['ws'])", t.get_magnet(false, true));
}

fn torrent_job(args: ref Vec[String], out: mut ref String) {
    match read_torrent(data_path(args[0])) {
        Ok(t) => describe(t, mut out),
        Err(e) => emit(mut out, show(err_line(e))),
    }
}

fn recode_job(args: ref Vec[String], out: mut ref String) {
    let path = data_path(args[0]);
    let raw = fs.read_bytes(path.clone()).unwrap_or(Vec.new());
    let t = match read_torrent(path) {
        Ok(t) => t,
        Err(e) => {
            emit(mut out, show(err_line(e)));
            return;
        }
    };
    let back = match bencode(t.st) {
        Ok(b) => b,
        Err(e) => {
            emit(mut out, show(err_line(e)));
            return;
        }
    };
    if back == raw {
        emit(mut out, f"same {raw.len()} bytes");
        return;
    }
    let mut i = 0;
    while i < raw.len() and i < back.len() and raw[i] == back[i] {
        i += 1;
    }
    emit(mut out, f"differs at byte {i} of {raw.len()} (now {back.len()} bytes)");
    emit(mut out, f"  was: {escape(raw, i - 16, i + 24)}");
    emit(mut out, f"  now: {escape(back, i - 16, i + 24)}");
    emit(mut out, f"  sha1 now {hex_of(sha1(back))}");
}

// cli.py `torrent info`.
fn info_lines(path: ref String, out: mut ref String) -> Result[(), Exc] {
    let t = read_torrent(path)?;
    let size = t.total_size()?;
    emit(mut out, f"Name: {py_str(t.name()?)}");
    emit(mut out, "Files:".to_string());
    for f in t.files()?.iter() {
        emit(mut out, py_str(f.name));
    }
    let hash = match t.info_hash()? {
        Some(h) => h,
        None => "None".to_string(),
    };
    emit(mut out, f"Hash: {hash}");
    emit(mut out, f"Size: {humanize_filesize(size)} ({size})");
    emit(mut out, f"Magnet: {t.get_magnet(true, true)?}");
    Ok(())
}

fn info_job(args: ref Vec[String], out: mut ref String) {
    if let Err(e) = info_lines(data_path(args[0]), mut out) {
        emit(mut out, show(err_line(e)));
    }
}

// The edit job's values: - is None, [a,b] a list (nested), else a str.
fn split_top(text: ref String) -> Vec[String] {
    let mut parts: Vec[String] = Vec.new();
    let mut depth = 0;
    let mut cur = String.new();
    for c in text.chars() {
        if c == ',' and depth == 0 {
            parts.push(cur);
            cur = String.new();
            continue;
        }
        if c == '[' {
            depth += 1;
        } else if c == ']' {
            depth -= 1;
        }
        cur.push(c);
    }
    parts.push(cur);
    parts
}

fn spec(text: ref String) -> BVal {
    if *text == "-" {
        return BVal.NoneV;
    }
    if text.starts_with("[") {
        let b = to_bytes(text);
        let inner = byte_str(b, 1, b.len() - 1);
        if inner.len() == 0 {
            return BVal.List(Vec.new());
        }
        let mut items: Vec[BVal] = Vec.new();
        for p in split_top(inner).iter() {
            items.push(spec(p));
        }
        return BVal.List(items);
    }
    BVal.Str(text.clone())
}

fn apply_op(t: mut ref Torrent, key: ref String, v: ref String) -> Result[(), Exc] {
    if *key == "announce" {
        t.set_announce(spec(v))
    } else if *key == "webseeds" {
        t.set_list("url-list", spec(v))
    } else if *key == "httpseeds" {
        t.set_list("httpseeds", spec(v))
    } else if *key == "comment" {
        set_item(mut t.st, "comment", BVal.Str(v.clone()))
    } else if *key == "source" {
        t.set_info("source", BVal.Str(v.clone()))
    } else if *key == "private" {
        t.set_private(*v == "1")
    } else if *key == "name" {
        t.set_info("name", BVal.Str(v.clone()))
    } else {
        set_item(mut t.st, "creation date", int_val(timegm_iso(v)))
    }
}

fn edit_job(args: ref Vec[String], out: mut ref String) {
    let mut t = match read_torrent(data_path(args[0])) {
        Ok(t) => t,
        Err(e) => {
            emit(mut out, show(err_line(e)));
            return;
        }
    };
    for i in 1..args.len() {
        let op = args[i].clone();
        let (k, _, v) = partition(op, b'=');
        match apply_op(mut t, k, v) {
            Ok(_) => emit(mut out, show(f"  set {op}")),
            Err(e) => emit(mut out, show(f"  set {op}: {err_line(e)}")),
        }
    }
    prop(mut out, "announce_urls", shown(t.announce_urls()));
    prop(mut out, "webseeds", shown(t.webseeds()));
    prop(mut out, "httpseeds", shown(t.httpseeds()));
    prop(mut out, "private", t.private_text());
    prop(mut out, "str", t.str_text());
    prop(mut out, "creation_date", t.creation_date());
    prop(mut out, "get_magnet()", t.get_magnet(true, true));
    match bencode(t.st) {
        Ok(b) => {
            emit(mut out, f"  to_string: {b.len()} bytes, sha1 {hex_of(sha1(b))}");
            let keys: Option[Vec[String]] = None;
            match bdecode(b, keys) {
                Ok(v) => emit(mut out, show(f"  decoded: {value(v)}")),
                Err(e) => emit(mut out, show(f"  decoded: {err_line(e)}")),
            }
        }
        Err(e) => emit(mut out, show(f"  to_string: {err_line(e)}")),
    }
}

fn partition(s: ref String, c: u8) -> (String, bool, String) {
    let b = to_bytes(s);
    for i in 0..b.len() {
        if b[i] == c {
            return (byte_str(b, 0, i), true, byte_str(b, i + 1, b.len()));
        }
    }
    (s.clone(), false, String.new())
}

// cli.py `torrent create`, with --dest data/out.
fn create_job(args: ref Vec[String], out: mut ref String) {
    let source = args[0].clone();
    let mut tracker = String.new();
    let mut comment = String.new();
    for i in 1..args.len() {
        let (k, _, v) = partition(args[i], b'=');
        if k == "tracker" {
            tracker = v;
        } else if k == "comment" {
            comment = v;
        }
    }
    let title = basename(source).replace(".", "_").replace(" ", "_");
    let dest = f"data/out/{title}.torrent";
    emit(mut out, f"Creating torrent from {source} ...");
    let mut t = match create_from(source) {
        Ok(t) => t,
        Err(e) => {
            emit(mut out, show(err_line(e)));
            return;
        }
    };
    let _ = set_item(mut t.st, "creation date", int_val(timegm_iso("2024-10-20T12:00:00".to_string())));
    if comment.len() > 0 {
        let _ = set_item(mut t.st, "comment", BVal.Str(comment.clone()));
    }
    if tracker.len() > 0 {
        let mut urls: Vec[BVal] = Vec.new();
        for u in split_on(tracker, b',').iter() {
            urls.push(BVal.Str(u.clone()));
        }
        let _ = t.set_announce(BVal.List(urls));
    }
    let bytes = match bencode(t.st) {
        Ok(b) => b,
        Err(e) => {
            emit(mut out, show(err_line(e)));
            return;
        }
    };
    let _ = fs.create_dir_all("data/out".to_string());
    if let Err(e) = fs.write_bytes(dest.clone(), bytes.clone()) {
        emit(mut out, f"cannot write {dest}: {e}");
        return;
    }
    emit(mut out, f"Torrent file created: {dest}");
    let hash = match t.info_hash() {
        Ok(Some(h)) => h,
        _ => "None".to_string(),
    };
    emit(mut out, f"Torrent info hash: {hash}");
    let raw = fs.read_bytes(dest.clone()).unwrap_or(Vec.new());
    emit(mut out, f"  {raw.len()} bytes, sha1 {hex_of(sha1(raw))}");
    let keys: Option[Vec[String]] = None;
    match bdecode(raw, keys) {
        Ok(v) => emit(mut out, show(f"  {value(v)}")),
        Err(e) => emit(mut out, show(f"  {err_line(e)}")),
    }
}

// ------------------------------------------------------------ programs

struct LibEntry {
    name: String,
    size: i128,
    files: i64,
    tracker: String,
    flags: String,
    hash: String,
}

// The first tracker's host:port, as urls[0][0].split("/")[2].
fn tracker_host(urls: ref BVal) -> Result[String, Exc] {
    if not truthy(urls) {
        return Ok("no tracker".to_string());
    }
    let first = py_str(index0(index0(urls)?)?);
    let parts = split_on(first, b'/');
    if parts.len() < 3 {
        return Err(exc("IndexError", "list index out of range".to_string()));
    }
    Ok(parts[2].clone())
}

fn library_entry(path: ref String) -> Result[Option[LibEntry], Exc] {
    let t = read_torrent(path)?;
    let name = t.name()?;
    if let BVal.NoneV = name {
        return Ok(None);
    }
    let size = t.total_size()?;
    let hash = t.info_hash()?.unwrap_or("None".to_string());
    let tracker = tracker_host(t.announce_urls()?)?;
    let mut flags = String.new();
    if let Some(p) = t.private()? {
        if truthy(p) {
            flags.push_str("private ");
        }
    }
    if truthy(t.webseeds()?) {
        flags.push_str("webseed ");
    }
    let files = t.files()?.len();
    Ok(Some(LibEntry { name: py_str(name), size: size, files: files, tracker: tracker, flags: flags, hash: hash }))
}

fn library_job(args: ref Vec[String], out: mut ref String) {
    let folder = data_path(args[0]);
    let names = sort_strings(fs.read_dir(folder.clone()).unwrap_or(Vec.new()));
    let mut seen_hash: Vec[String] = Vec.new();
    let mut seen_file: Vec[String] = Vec.new();
    let mut total: i128 = 0;
    let mut count = 0;
    for fname in names.iter() {
        let e = match library_entry(f"{folder}/{fname}") {
            Ok(Some(e)) => e,
            Ok(None) => {
                emit(mut out, f"{fname}: no name, skipped");
                continue;
            }
            Err(x) => {
                emit(mut out, show(f"{fname}: {err_line(x)}"));
                continue;
            }
        };
        emit(mut out, show(e.name));
        let plural = if e.files == 1 { "" } else { "s" };
        let short = byte_str(to_bytes(e.hash), 0, 12);
        emit(mut out, f"  {humanize_filesize(e.size)} in {e.files} file{plural}, {e.tracker}, {e.flags}{short}");
        count += 1;
        total += e.size;
        let mut dup = -1;
        for i in 0..seen_hash.len() {
            if seen_hash[i] == e.hash {
                dup = i;
            }
        }
        if dup >= 0 {
            emit(mut out, f"  same content as {seen_file[dup]}");
        } else {
            seen_hash.push(e.hash.clone());
            seen_file.push(fname.clone());
        }
    }
    emit(mut out, f"{count} torrents, {humanize_filesize(total)} ({total} bytes) in all, {seen_hash.len()} distinct");
}

struct Have {
    start: i64,
    end: i64,
}

fn int_field(v: ref BVal) -> i64 {
    match v {
        BVal.Int(t) => i64.parse(t.clone()).unwrap_or(0),
        _ => 0,
    }
}

fn verify_job(args: ref Vec[String], out: mut ref String) {
    let t = match read_torrent(data_path(args[0])) {
        Ok(t) => t,
        Err(e) => {
            emit(mut out, show(err_line(e)));
            return;
        }
    };
    let setup = match verify_setup(t) {
        Ok(x) => x,
        Err(e) => {
            emit(mut out, show(err_line(e)));
            return;
        }
    };
    let (plen, pieces, files) = setup;
    let base = data_path(args[1]);
    let mut blob: Vec[u8] = Vec.new();
    let mut have: Vec[Have] = Vec.new();
    for f in files.iter() {
        let name = py_str(f.name);
        let want = int_field(f.length);
        let p = f"{base}/{name}";
        let start = blob.len();
        let status = if is_file_path(p) {
            let body = fs.read_bytes(p.clone()).unwrap_or(Vec.new());
            let st = if body.len() == want { "ok".to_string() } else { f"{body.len()} of {want} bytes" };
            let keep = if body.len() > want { want } else { body.len() };
            for i in 0..keep {
                blob.push(body[i]);
            }
            have.push(Have { start: start, end: start + keep });
            for _ in keep..want {
                blob.push(0);
            }
            st
        } else {
            for _ in 0..want {
                blob.push(0);
            }
            "missing".to_string()
        };
        emit(mut out, show(f"  {name}: {status}"));
    }
    let count = pieces.len() / 20;
    let mut good = 0;
    let mut good_bytes: i128 = 0;
    let mut marks = String.new();
    for i in 0..count {
        let a = i * plen;
        let b = if (i + 1) * plen < blob.len() { (i + 1) * plen } else { blob.len() };
        let mut covered = 0;
        for h in have.iter() {
            let lo = if a > h.start { a } else { h.start };
            let hi = if b < h.end { b } else { h.end };
            if hi > lo {
                covered += hi - lo;
            }
        }
        if covered < b - a {
            marks.push('-');
            continue;
        }
        let mut chunk: Vec[u8] = Vec.new();
        for k in a..b {
            chunk.push(blob[k]);
        }
        let digest = sha1(chunk);
        let mut same = true;
        for k in 0..20 {
            if digest[k] != pieces[i * 20 + k] {
                same = false;
            }
        }
        if same {
            marks.push('#');
            good += 1;
            good_bytes += (b - a) as i128;
        } else {
            marks.push('x');
        }
    }
    let mb = to_bytes(marks);
    let mut i = 0;
    while i < mb.len() {
        let end = if i + 64 < mb.len() { i + 64 } else { mb.len() };
        emit(mut out, f"  [{byte_str(mb, i, end)}]");
        i += 64;
    }
    let left = t.total_size().unwrap_or(0) - good_bytes;
    emit(mut out, f"  {good} of {count} pieces ok, {humanize_filesize(left)} left");
    if good == count {
        match t.magnet_link() {
            Ok(m) => emit(mut out, f"  complete: {m}"),
            Err(e) => emit(mut out, f"  complete: {err_line(e)}"),
        }
    }
}

// info = t._struct["info"]; info["piece length"], info["pieces"], t.files
fn verify_setup(t: ref Torrent) -> Result[(i64, Vec[u8], Vec[TFile]), Exc] {
    let info = getitem(t.st, "info")?;
    let plen = int_field(getitem(info, "piece length")?);
    let pieces = match getitem(info, "pieces")? {
        BVal.Bytes(b) => b,
        BVal.Str(x) => to_bytes(x),
        _ => Vec.new(),
    };
    let files = t.files()?;
    Ok((plen, pieces, files))
}

fn main() {
    if let Err(e) = write_data_files() {
        eprintln(e);
        return;
    }
    let mut out = String.new();
    for line in lines_of(read_text("jobs.tsv".to_string())).iter() {
        let job = split_on(line, b'\t');
        emit(mut out, show(f"== {join(job, " ")}"));
        let mut args: Vec[String] = Vec.new();
        for i in 1..job.len() {
            args.push(job[i].clone());
        }
        let kind = job[0].clone();
        if kind == "bdecode" {
            bdecode_job(args, mut out);
        } else if kind == "read_string" {
            read_string_job(args, mut out);
        } else if kind == "humanize" {
            humanize_job(args, mut out);
        } else if kind == "torrent" {
            torrent_job(args, mut out);
        } else if kind == "recode" {
            recode_job(args, mut out);
        } else if kind == "info" {
            info_job(args, mut out);
        } else if kind == "edit" {
            edit_job(args, mut out);
        } else if kind == "create" {
            create_job(args, mut out);
        } else if kind == "library" {
            library_job(args, mut out);
        } else {
            verify_job(args, mut out);
        }
    }
    print(out);
}
// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    data_part_3(mut v);
    data_part_4(mut v);
    data_part_5(mut v);
    data_part_6(mut v);
    data_part_7(mut v);
    data_part_8(mut v);
    data_part_9(mut v);
    data_part_10(mut v);
    v
}

