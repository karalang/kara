fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

// The bytes a block of hex digits spells; line breaks are skipped.
fn unhex(s: String) -> Vec[u8] {
    let b = to_bytes(s);
    let mut digits: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        if is_hex(b[i]) {
            digits.push(hex_val(b[i]));
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < digits.len() {
        out.push(digits[i] * 16 + digits[i + 1]);
        i += 2;
    }
    out
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data")?;
    put("data/access.log", file_0())?;
    put_bytes("data/access.log.bz2", unhex(file_1()))?;
    put_bytes("data/big.txt.bz2", unhex(file_2()))?;
    put_bytes("data/concat.bz2", unhex(file_3()))?;
    put_bytes("data/empty.bz2", unhex(file_4()))?;
    put("data/empty.txt", file_5())?;
    put_bytes("data/flipped.bz2", unhex(file_6()))?;
    put("data/jobs.txt", file_7())?;
    put("data/notes.bz2", file_8())?;
    put("data/poem.txt", file_9())?;
    put_bytes("data/runs.bin", unhex(file_10()))?;
    put_bytes("data/trailing.bz2", unhex(file_11()))?;
    put_bytes("data/trunc.bz2", unhex(file_12()))?;
    Ok(())
}

// The names of the input files.
fn data_names() -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    v.push("access.log".to_string());
    v.push("access.log.bz2".to_string());
    v.push("big.txt.bz2".to_string());
    v.push("concat.bz2".to_string());
    v.push("empty.bz2".to_string());
    v.push("empty.txt".to_string());
    v.push("flipped.bz2".to_string());
    v.push("jobs.txt".to_string());
    v.push("notes.bz2".to_string());
    v.push("poem.txt".to_string());
    v.push("runs.bin".to_string());
    v.push("trailing.bz2".to_string());
    v.push("trunc.bz2".to_string());
    v
}

// ------------------------------------------------------------ the jobs

// A fresh start, as after unpacking data/: the files the jobs write that
// are not inputs are removed.
fn clear_outputs(jobs: ref Vec[String]) {
    let inputs = data_names();
    for line in jobs {
        let w = split_on(line, b' ');
        if w[0] != "bzip2" {
            continue;
        }
        let mut flags = String.new();
        for a in w {
            if starts_with(a, "-") {
                flags.push_str(a);
            }
        }
        if has_byte(flags, b'c') or has_byte(flags, b't') {
            continue;
        }
        for a in w[1..].to_vec() {
            if starts_with(a, "-") {
                continue;
            }
            let outn = if has_byte(flags, b'd') { slice(a, 0, a.len() - 4) } else { f"{a}.bz2" };
            if not inputs.contains(outn) {
                let _ = fs.remove_file(f"data/{outn}");
            }
        }
    }
}

fn run() -> Result[(), String] {
    write_data()?;
    let text = match fs.read_to_string("data/jobs.txt".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/jobs.txt: {e}"),
    };
    let jobs = lines_of(text);
    clear_outputs(jobs);
    let t = crc_table();
    for line in jobs {
        if line.len() == 0 or starts_with(line, "#") {
            continue;
        }
        let mut job = Job { out: String.new(), err: String.new(), status: 0 };
        let w = split_on(line, b' ');
        let rest: Vec[String] = w[1..].to_vec();
        if w[0] == "bzip2" {
            bzip2(t, mut job, rest);
        } else if w[0] == "sha256sum" {
            sha256sum(mut job, rest);
        }
        let mut out = f"$ {line}\n";
        out.push_str(job.out);
        out.push_str(job.err);
        if job.status != 0 {
            out.push_str(f"[exit status {job.status}]\n");
        }
        println(out);
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"error: {e}");
    }
}
