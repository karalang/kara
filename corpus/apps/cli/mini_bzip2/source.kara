// mini_bzip2: bzip2 1.0.8 and sha256sum, written from bzip2's format and
// sources: the compressor, byte for byte the same as bzip2's, the
// decompressor and the test mode:
// - run-length stage one, the Burrows-Wheeler transform, move-to-front
//   with RUNA/RUNB zero runs, and bzip2's Huffman tables: the initial
//   partition, four refinement passes over 50-symbol groups, its
//   length-limited code builder and the MTF-coded selectors;
// - the block and stream CRCs, several streams in one file, and the
//   errors bzip2 gives for a truncated file, a damaged block, a file that
//   is not bzip2 and trailing garbage;
// - -t, -v and -vv, -d, -c, -k, -f and -1 to -9, with bzip2's messages.
//
// The inputs are the files in data/, made with bzip2 1.0.8. expected.out
// is the output of oracle.py, the same program in Python, and is
// byte-identical to the real bzip2 and sha256sum.

// ------------------------------------------------------------ bytes and text

fn byte_str(b: ref Vec[u8], from: i64, to: i64) -> String {
    let mut v: Vec[u8] = Vec.new();
    for i in from..to {
        v.push(b[i]);
    }
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn to_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn from_bytes(v: Vec[u8]) -> String {
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn is_alpha(c: u8) -> bool {
    (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z')
}

fn is_alnum(c: u8) -> bool {
    is_digit(c) or is_alpha(c)
}

// White space, as `\s` and str.strip see it.
fn is_ws(c: u8) -> bool {
    c == b' ' or c == b'\t' or c == b'\n' or c == b'\r' or c == 11 or c == 12
}

fn lower_byte(c: u8) -> u8 {
    if c >= b'A' and c <= b'Z' { c + 32 } else { c }
}

fn lower(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        out.push(lower_byte(b[i]));
    }
    from_bytes(out)
}

fn strip(s: Str) -> String {
    let b = to_bytes(s);
    let mut i: i64 = 0;
    let mut j = b.len();
    while i < j and is_ws(b[i]) {
        i += 1;
    }
    while j > i and is_ws(b[j - 1]) {
        j -= 1;
    }
    byte_str(b, i, j)
}

fn split_ws(s: Str) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        while i < b.len() and is_ws(b[i]) {
            i += 1;
        }
        let st = i;
        while i < b.len() and not is_ws(b[i]) {
            i += 1;
        }
        if i > st {
            out.push(byte_str(b, st, i));
        }
    }
    out
}

fn split_on(s: Str, sep: u8) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut st: i64 = 0;
    for i in 0..b.len() {
        if b[i] == sep {
            out.push(byte_str(b, st, i));
            st = i + 1;
        }
    }
    out.push(byte_str(b, st, b.len()));
    out
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

// The lines of a file, without their newlines.
fn lines_of(text: Str) -> Vec[String] {
    let mut v = split_on(text, b'\n');
    if v.len() > 0 and v[v.len() - 1].len() == 0 {
        v.pop();
    }
    v
}

// Python's repr of a str.
fn py_repr(s: Str) -> String {
    let b = to_bytes(s);
    let mut has_single = false;
    let mut has_double = false;
    for i in 0..b.len() {
        if b[i] == b'\'' {
            has_single = true;
        }
        if b[i] == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let hex = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    out.push(q);
    let mut skip = false;
    for i in 0..b.len() {
        let c = b[i];
        if skip {
            skip = false;
            continue;
        }
        // U+0080 to U+00A0 and U+00AD are not printable either
        let next: u8 = if i + 1 < b.len() { b[i + 1] } else { 0 };
        if c == 0xC2 and next >= 0x80 and (next <= 0xA0 or next == 0xAD) {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(next / 16) as i64]);
            out.push(hex[(next % 16) as i64]);
            skip = true;
        } else if c == q or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c < 32 or c == 127 {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    from_bytes(out)
}

fn upper(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        let c = b[i];
        out.push(if c >= b'a' and c <= b'z' { c - 32 } else { c });
    }
    from_bytes(out)
}

// Whether `pat` occurs in `b` at `i`.
fn starts_at(b: ref Vec[u8], i: i64, pat: Str) -> bool {
    let p = to_bytes(pat);
    if i < 0 or i + p.len() > b.len() {
        return false;
    }
    for k in 0..p.len() {
        if b[i + k] != p[k] {
            return false;
        }
    }
    true
}

fn starts_with(s: Str, pat: Str) -> bool {
    starts_at(to_bytes(s), 0, pat)
}

fn find_str(s: Str, pat: Str) -> i64 {
    let b = to_bytes(s);
    for i in 0..b.len() + 1 {
        if starts_at(b, i, pat) {
            return i;
        }
    }
    -1
}

fn first_byte(s: Str) -> u8 {
    let b = to_bytes(s);
    if b.len() > 0 { b[0] } else { 0 }
}

fn slice_from(s: Str, i: i64) -> String {
    let b = to_bytes(s);
    byte_str(b, i, b.len())
}

fn is_hex(c: u8) -> bool {
    is_digit(c) or (c >= b'a' and c <= b'f') or (c >= b'A' and c <= b'F')
}

fn hex_val(c: u8) -> u8 {
    if is_digit(c) {
        c - b'0'
    } else if c >= b'a' and c <= b'f' {
        c - b'a' + 10
    } else {
        c - b'A' + 10
    }
}

fn find_byte(s: Str, c: u8) -> i64 {
    let b = to_bytes(s);
    for i in 0..b.len() {
        if b[i] == c {
            return i;
        }
    }
    -1
}

fn rfind_byte(s: Str, c: u8) -> i64 {
    let b = to_bytes(s);
    let mut i = b.len() - 1;
    while i >= 0 {
        if b[i] == c {
            return i;
        }
        i -= 1;
    }
    -1
}

fn has_byte(s: Str, c: u8) -> bool {
    find_byte(s, c) >= 0
}

fn slice(s: Str, from: i64, to: i64) -> String {
    byte_str(to_bytes(s), from, to)
}

// str.partition and str.rpartition on one byte: (before, found, after).
fn partition(s: Str, c: u8) -> (String, bool, String) {
    let i = find_byte(s, c);
    if i < 0 {
        return (s.to_string(), false, String.new());
    }
    (slice(s, 0, i), true, slice_from(s, i + 1))
}

fn rpartition(s: Str, c: u8) -> (String, bool, String) {
    let i = rfind_byte(s, c);
    if i < 0 {
        return (String.new(), false, s.to_string());
    }
    (slice(s, 0, i), true, slice_from(s, i + 1))
}

// Python's repr of a bytes object.
fn bytes_repr(b: ref Vec[u8]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for i in 0..b.len() {
        if b[i] == b'\'' {
            has_single = true;
        }
        if b[i] == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let hex = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    out.push(b'b');
    out.push(q);
    for i in 0..b.len() {
        let c = b[i];
        if c == q or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c < 32 or c >= 127 {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    from_bytes(out)
}

fn is_ascii(s: Str) -> bool {
    let b = to_bytes(s);
    for i in 0..b.len() {
        if b[i] >= 0x80 {
            return false;
        }
    }
    true
}

fn py_int(s: Str) -> Option[i64] {
    let b = to_bytes(strip(s));
    let mut i: i64 = 0;
    let mut neg = false;
    if i < b.len() and (b[i] == b'+' or b[i] == b'-') {
        neg = b[i] == b'-';
        i += 1;
    }
    if i >= b.len() {
        return None;
    }
    let mut n: i64 = 0;
    let mut prev_digit = false;
    while i < b.len() {
        let c = b[i];
        if is_digit(c) {
            n = n * 10 + (c - b'0') as i64;
            prev_digit = true;
        } else if c == b'_' and prev_digit and i + 1 < b.len() and is_digit(b[i + 1]) {
            prev_digit = false;
        } else {
            return None;
        }
        i += 1;
    }
    if neg { Some(-n) } else { Some(n) }
}

// The code points of a string.
fn code_points(s: Str) -> Vec[i64] {
    let b = to_bytes(s);
    let mut out: Vec[i64] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | (b[i + 1] as i64 & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | ((b[i + 1] as i64 & 0x3F) << 6) | (b[i + 2] as i64 & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | ((b[i + 1] as i64 & 0x3F) << 12) | ((b[i + 2] as i64 & 0x3F) << 6) | (b[i + 3] as i64 & 0x3F));
            i += 4;
        }
    }
    out
}

fn push_code_point(out: mut ref Vec[u8], cp: i64) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push(((cp >> 6) | 0xC0) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    } else if cp < 0x10000 {
        out.push(((cp >> 12) | 0xE0) as u8);
        out.push((((cp >> 6) & 0x3F) | 0x80) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    } else {
        out.push(((cp >> 18) | 0xF0) as u8);
        out.push((((cp >> 12) & 0x3F) | 0x80) as u8);
        out.push((((cp >> 6) & 0x3F) | 0x80) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    }
}

fn ljust(s: Str, width: i64) -> String {
    let mut out = s.to_string();
    while out.len() < width {
        out.push_str(" ");
    }
    out
}

fn rjust(s: Str, width: i64) -> String {
    let mut out = String.new();
    let mut n = s.len();
    while n < width {
        out.push_str(" ");
        n += 1;
    }
    out.push_str(s);
    out
}

fn plural(n: i64, one: Str, many: Str) -> String {
    if n == 1 { one.to_string() } else { many.to_string() }
}

// ------------------------------------------------------------ SHA-256 (FIPS 180-4)

const MASK32: i64 = 0xFFFFFFFF;

fn rotr(x: i64, n: i64) -> i64 {
    ((x >> n) | (x << (32 - n))) & MASK32
}

fn rotl(x: i64, n: i64) -> i64 {
    ((x << n) | (x >> (32 - n))) & MASK32
}

// The message padded to whole 64-byte blocks, with its bit length.
fn md_pad(msg: ref Vec[u8]) -> Vec[u8] {
    let mut m = msg.clone();
    let bits = msg.len() * 8;
    m.push(0x80);
    while m.len() % 64 != 56 {
        m.push(0);
    }
    let mut k = 56;
    while k >= 0 {
        m.push(((bits >> k) & 0xFF) as u8);
        k -= 8;
    }
    m
}

fn be32(b: ref Vec[u8], i: i64) -> i64 {
    (b[i] as i64) << 24 | (b[i + 1] as i64) << 16 | (b[i + 2] as i64) << 8 | b[i + 3] as i64
}

fn push_be32(out: mut ref Vec[u8], x: i64) {
    out.push(((x >> 24) & 0xFF) as u8);
    out.push(((x >> 16) & 0xFF) as u8);
    out.push(((x >> 8) & 0xFF) as u8);
    out.push((x & 0xFF) as u8);
}

const SHA256_K: Array[i64, 64] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

fn sha256(msg: ref Vec[u8]) -> Vec[u8] {
    let m = md_pad(msg);
    let mut h: Vec[i64] = Vec.new();
    for x in [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19] {
        h.push(x);
    }
    let mut w: Vec[i64] = Vec.new();
    for _ in 0..64 {
        w.push(0);
    }
    let mut blk: i64 = 0;
    while blk < m.len() {
        for t in 0..16 {
            w[t] = be32(m, blk + 4 * t);
        }
        for t in 16..64 {
            let s0 = rotr(w[t - 15], 7) ^ rotr(w[t - 15], 18) ^ (w[t - 15] >> 3);
            let s1 = rotr(w[t - 2], 17) ^ rotr(w[t - 2], 19) ^ (w[t - 2] >> 10);
            w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & MASK32;
        }
        let mut a = h[0];
        let mut b = h[1];
        let mut c = h[2];
        let mut d = h[3];
        let mut e = h[4];
        let mut f = h[5];
        let mut g = h[6];
        let mut hh = h[7];
        for t in 0..64 {
            let s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
            let ch = (e & f) ^ ((e ^ MASK32) & g);
            let t1 = (hh + s1 + ch + SHA256_K[t] + w[t]) & MASK32;
            let s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
            let maj = (a & b) ^ (a & c) ^ (b & c);
            let t2 = (s0 + maj) & MASK32;
            hh = g;
            g = f;
            f = e;
            e = (d + t1) & MASK32;
            d = c;
            c = b;
            b = a;
            a = (t1 + t2) & MASK32;
        }
        h[0] = (h[0] + a) & MASK32;
        h[1] = (h[1] + b) & MASK32;
        h[2] = (h[2] + c) & MASK32;
        h[3] = (h[3] + d) & MASK32;
        h[4] = (h[4] + e) & MASK32;
        h[5] = (h[5] + f) & MASK32;
        h[6] = (h[6] + g) & MASK32;
        h[7] = (h[7] + hh) & MASK32;
        blk += 64;
    }
    let mut out: Vec[u8] = Vec.new();
    for x in h {
        push_be32(mut out, x);
    }
    out
}

fn hex_of(b: ref Vec[u8]) -> String {
    let mut s = String.new();
    for x in b {
        s.push_str(f"{x:02x}");
    }
    s
}

fn zeros(n: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for _ in 0..n {
        v.push(0);
    }
    v
}

// ------------------------------------------------------------ CRC and bits

// bzip2's CRC-32: the same polynomial as zlib's, but shifted MSB first.
fn crc_table() -> Vec[i64] {
    let mut t: Vec[i64] = Vec.new();
    for i in 0..256 {
        let mut c = i << 24;
        for _ in 0..8 {
            if c & 0x80000000 != 0 {
                c = ((c << 1) ^ 0x04c11db7) & MASK32;
            } else {
                c = (c << 1) & MASK32;
            }
        }
        t.push(c);
    }
    t
}

fn crc_of(t: ref Vec[i64], data: ref Vec[u8]) -> i64 {
    let mut c = MASK32;
    for b in data {
        c = ((c << 8) & MASK32) ^ t[(c >> 24) ^ (b as i64)];
    }
    c ^ MASK32
}

// The stream CRC folds in each block's CRC.
fn combine(comb: i64, block: i64) -> i64 {
    rotl(comb, 1) ^ block
}

struct BitWriter {
    buf: Vec[u8],
    acc: i64,
    n: i64,
}

fn put_bits(w: mut ref BitWriter, n: i64, v: i64) {
    w.acc = (w.acc << n) | v;
    w.n += n;
    while w.n >= 8 {
        w.n -= 8;
        w.buf.push(((w.acc >> w.n) & 0xFF) as u8);
    }
    w.acc &= (1 << w.n) - 1;
}

fn put_byte_list(w: mut ref BitWriter, bytes: ref Vec[i64]) {
    for b in bytes {
        put_bits(w, 8, b);
    }
}

fn finish_bits(w: mut ref BitWriter) {
    if w.n > 0 {
        w.buf.push(((w.acc << (8 - w.n)) & 0xFF) as u8);
        w.acc = 0;
        w.n = 0;
    }
}

const BLOCK_MAGIC: Array[i64, 6] = [0x31, 0x41, 0x59, 0x26, 0x53, 0x59];
const END_MAGIC: Array[i64, 6] = [0x17, 0x72, 0x45, 0x38, 0x50, 0x90];

// ------------------------------------------------------------ the compressor

// One block after run-length stage one, with the CRC of the input it
// covers.
struct Block {
    data: Vec[u8],
    crc: i64,
}

// Stage one replaces a run of 4 to 255 equal bytes by 4 of them and a
// count of the rest; a block holds at most 100000 * level - 19 bytes.
fn rle1_blocks(t: ref Vec[i64], data: ref Vec[u8], level: i64) -> Vec[Block] {
    let nmax = 100000 * level - 19;
    let mut blocks: Vec[Block] = Vec.new();
    let mut blk: Vec[u8] = Vec.new();
    let mut crc = MASK32;
    let mut i: i64 = 0;
    while i < data.len() {
        let ch = data[i];
        let mut ln: i64 = 1;
        while i + ln < data.len() and data[i + ln] == ch and ln < 255 {
            ln += 1;
        }
        if blk.len() >= nmax {
            blocks.push(Block { data: blk, crc: crc ^ MASK32 });
            blk = Vec.new();
            crc = MASK32;
        }
        for _ in 0..ln {
            crc = ((crc << 8) & MASK32) ^ t[(crc >> 24) ^ (ch as i64)];
        }
        if ln < 4 {
            for _ in 0..ln {
                blk.push(ch);
            }
        } else {
            for _ in 0..4 {
                blk.push(ch);
            }
            blk.push((ln - 4) as u8);
        }
        i += ln;
    }
    if blk.len() > 0 {
        blocks.push(Block { data: blk, crc: crc ^ MASK32 });
    }
    blocks
}

// The rotations of the block in sorted order, by prefix doubling: each
// round orders the rotations by their first 2k bytes, from the order by
// the first k, with a counting sort.
fn bwt_sort(blk: ref Vec[u8]) -> Vec[i64] {
    let n = blk.len();
    let mut rank = zeros(n);
    let mut cnt = zeros(256);
    for i in 0..n {
        rank[i] = blk[i] as i64;
        cnt[rank[i]] += 1;
    }
    let mut ptr = zeros(n);
    let mut acc: i64 = 0;
    for c in 0..256 {
        let k = cnt[c];
        cnt[c] = acc;
        acc += k;
    }
    for i in 0..n {
        ptr[cnt[rank[i]]] = i;
        cnt[rank[i]] += 1;
    }
    let mut classes: i64 = 256;
    let mut k: i64 = 1;
    while k < n {
        // ordered by the second half: rotation i - k for each i in order
        let mut by2 = zeros(n);
        for j in 0..n {
            let mut p = ptr[j] - k;
            if p < 0 {
                p += n;
            }
            by2[j] = p;
        }
        let mut c2 = zeros(classes + 1);
        for i in 0..n {
            c2[rank[i]] += 1;
        }
        let mut acc2: i64 = 0;
        for c in 0..classes + 1 {
            let x = c2[c];
            c2[c] = acc2;
            acc2 += x;
        }
        for j in 0..n {
            let p = by2[j];
            ptr[c2[rank[p]]] = p;
            c2[rank[p]] += 1;
        }
        let mut nr = zeros(n);
        let mut r: i64 = 0;
        for j in 1..n {
            let a = ptr[j];
            let b = ptr[j - 1];
            if rank[a] != rank[b] or rank[(a + k) % n] != rank[(b + k) % n] {
                r += 1;
            }
            nr[a] = r;
        }
        nr[ptr[0]] = 0;
        rank = nr;
        classes = r + 1;
        if r == n - 1 {
            break;
        }
        k *= 2;
    }
    ptr
}

// BZ2_hbMakeCodeLengths: Huffman code lengths from a heap of weights
// that carry the tree depth in their low byte; codes longer than maxlen
// halve the weights and start again.
fn code_lengths(freq: ref Vec[i64], alpha: i64, maxlen: i64) -> Vec[i64] {
    let mut weight = zeros(alpha * 2 + 2);
    let mut parent = zeros(alpha * 2 + 2);
    let mut heap = zeros(alpha + 4);
    for i in 0..alpha {
        let f = if freq[i] == 0 { 1 } else { freq[i] };
        weight[i + 1] = f << 8;
    }
    loop {
        let mut nnodes = alpha;
        let mut nheap: i64 = 0;
        heap[0] = 0;
        weight[0] = 0;
        parent[0] = -2;
        for i in 1..alpha + 1 {
            parent[i] = -1;
            nheap += 1;
            heap[nheap] = i;
            up_heap(mut heap, weight, nheap);
        }
        while nheap > 1 {
            let n1 = heap[1];
            heap[1] = heap[nheap];
            nheap -= 1;
            down_heap(mut heap, weight, nheap);
            let n2 = heap[1];
            heap[1] = heap[nheap];
            nheap -= 1;
            down_heap(mut heap, weight, nheap);
            nnodes += 1;
            parent[n1] = nnodes;
            parent[n2] = nnodes;
            let w1 = weight[n1];
            let w2 = weight[n2];
            let depth = if (w1 & 0xFF) > (w2 & 0xFF) { w1 & 0xFF } else { w2 & 0xFF };
            weight[nnodes] = ((w1 & 0xFFFFFF00) + (w2 & 0xFFFFFF00)) | (1 + depth);
            parent[nnodes] = -1;
            nheap += 1;
            heap[nheap] = nnodes;
            up_heap(mut heap, weight, nheap);
        }
        let mut lens = zeros(alpha);
        let mut too_long = false;
        for i in 1..alpha + 1 {
            let mut j: i64 = 0;
            let mut k = i;
            while parent[k] >= 0 {
                k = parent[k];
                j += 1;
            }
            lens[i - 1] = j;
            if j > maxlen {
                too_long = true;
            }
        }
        if not too_long {
            return lens;
        }
        for i in 1..alpha + 1 {
            let j = weight[i] >> 8;
            weight[i] = (1 + j / 2) << 8;
        }
    }
}

fn up_heap(heap: mut ref Vec[i64], weight: ref Vec[i64], at: i64) {
    let mut z = at;
    let tmp = heap[z];
    while weight[tmp] < weight[heap[z >> 1]] {
        heap[z] = heap[z >> 1];
        z = z >> 1;
    }
    heap[z] = tmp;
}

fn down_heap(heap: mut ref Vec[i64], weight: ref Vec[i64], nheap: i64) {
    let mut z: i64 = 1;
    let tmp = heap[z];
    loop {
        let mut y = z << 1;
        if y > nheap {
            break;
        }
        if y < nheap and weight[heap[y + 1]] < weight[heap[y]] {
            y += 1;
        }
        if weight[tmp] < weight[heap[y]] {
            break;
        }
        heap[z] = heap[y];
        z = y;
    }
    heap[z] = tmp;
}

// Moves the entry at position j of a move-to-front list to the front.
fn to_front(yy: mut ref Vec[i64], j: i64) {
    let v = yy[j];
    let mut k = j;
    while k > 0 {
        yy[k] = yy[k - 1];
        k -= 1;
    }
    yy[0] = v;
}

fn position(yy: ref Vec[i64], v: i64) -> i64 {
    let mut j: i64 = 0;
    while yy[j] != v {
        j += 1;
    }
    j
}

// A zero run of length z, written in bijective base 2 with RUNA (0) and
// RUNB (1).
fn push_run(mtfv: mut ref Vec[i64], freq: mut ref Vec[i64], z: i64) {
    let mut zp = z - 1;
    loop {
        let s = zp & 1;
        mtfv.push(s);
        freq[s] += 1;
        if zp < 2 {
            break;
        }
        zp = (zp - 2) / 2;
    }
}

fn group_cost(lens: ref Vec[i64], mtfv: ref Vec[i64], gs: i64, ge: i64) -> i64 {
    let mut c: i64 = 0;
    for i in gs..ge + 1 {
        c += lens[mtfv[i]];
    }
    c
}

fn compress_block(w: mut ref BitWriter, b: ref Block) {
    let blk = ref b.data;
    let n = blk.len();
    let ptr = bwt_sort(blk);
    let orig = position(ptr, 0);
    put_byte_list(w, BLOCK_MAGIC.as_slice().to_vec());
    put_bits(w, 32, b.crc);
    put_bits(w, 1, 0);
    put_bits(w, 24, orig);
    // move-to-front over the last column, with zero runs as RUNA/RUNB
    let mut in_use: Vec[bool] = Vec.new();
    for _ in 0..256 {
        in_use.push(false);
    }
    for x in blk {
        in_use[x as i64] = true;
    }
    let mut seq = zeros(256);
    let mut ninuse: i64 = 0;
    for i in 0..256 {
        if in_use[i] {
            seq[i] = ninuse;
            ninuse += 1;
        }
    }
    let eob = ninuse + 1;
    let alpha = ninuse + 2;
    let mut freq = zeros(alpha);
    let mut mtfv: Vec[i64] = Vec.new();
    let mut yy = zeros(ninuse);
    for i in 0..ninuse {
        yy[i] = i;
    }
    let mut zp: i64 = 0;
    for i in 0..n {
        let mut j = ptr[i] - 1;
        if j < 0 {
            j += n;
        }
        let ll = seq[blk[j] as i64];
        if yy[0] == ll {
            zp += 1;
        } else {
            if zp > 0 {
                push_run(mut mtfv, mut freq, zp);
                zp = 0;
            }
            let k = position(yy, ll);
            to_front(mut yy, k);
            mtfv.push(k + 1);
            freq[k + 1] += 1;
        }
    }
    if zp > 0 {
        push_run(mut mtfv, mut freq, zp);
    }
    mtfv.push(eob);
    freq[eob] += 1;
    let nmtf = mtfv.len();
    // the initial tables split the symbols into ranges of equal weight
    let ng = if nmtf < 200 { 2 } else if nmtf < 600 { 3 } else if nmtf < 1200 { 4 } else if nmtf < 2400 { 5 } else { 6 };
    let mut lens: Vec[Vec[i64]] = Vec.new();
    for _ in 0..ng {
        let mut row = zeros(alpha);
        for v in 0..alpha {
            row[v] = 15;
        }
        lens.push(row);
    }
    let mut npart = ng;
    let mut remf = nmtf;
    let mut gs: i64 = 0;
    while npart > 0 {
        let tf = remf / npart;
        let mut ge = gs - 1;
        let mut af: i64 = 0;
        while af < tf and ge < alpha - 1 {
            ge += 1;
            af += freq[ge];
        }
        if ge > gs and npart != ng and npart != 1 and (ng - npart) % 2 == 1 {
            af -= freq[ge];
            ge -= 1;
        }
        for v in 0..alpha {
            lens[npart - 1][v] = if v >= gs and v <= ge { 0 } else { 15 };
        }
        npart -= 1;
        gs = ge + 1;
        remf -= af;
    }
    // four passes: each 50-symbol group picks its cheapest table, and the
    // tables are rebuilt from the groups that picked them
    let mut sels: Vec[i64] = Vec.new();
    for _ in 0..4 {
        let mut rfreq: Vec[Vec[i64]] = Vec.new();
        for _ in 0..ng {
            rfreq.push(zeros(alpha));
        }
        sels = Vec.new();
        let mut g0: i64 = 0;
        while g0 < nmtf {
            let ge = if g0 + 49 < nmtf - 1 { g0 + 49 } else { nmtf - 1 };
            let mut bt: i64 = -1;
            let mut bc: i64 = 999999999;
            for t in 0..ng {
                let c = group_cost(lens[t], mtfv, g0, ge);
                if c < bc {
                    bc = c;
                    bt = t;
                }
            }
            sels.push(bt);
            for i in g0..ge + 1 {
                rfreq[bt][mtfv[i]] += 1;
            }
            g0 = ge + 1;
        }
        for t in 0..ng {
            lens[t] = code_lengths(rfreq[t], alpha, 17);
        }
    }
    let mut pos = zeros(ng);
    for i in 0..ng {
        pos[i] = i;
    }
    let mut selmtf: Vec[i64] = Vec.new();
    for s in sels {
        let j = position(pos, s);
        to_front(mut pos, j);
        selmtf.push(j);
    }
    // canonical codes, shortest first
    let mut codes: Vec[Vec[i64]] = Vec.new();
    for t in 0..ng {
        let row = ref lens[t];
        let mut mn: i64 = 32;
        let mut mx: i64 = 0;
        for x in row {
            if x < mn {
                mn = x;
            }
            if x > mx {
                mx = x;
            }
        }
        let mut c = zeros(alpha);
        let mut vec: i64 = 0;
        for ln in mn..mx + 1 {
            for i in 0..alpha {
                if row[i] == ln {
                    c[i] = vec;
                    vec += 1;
                }
            }
            vec = vec << 1;
        }
        codes.push(c);
    }
    // the symbol map, in 16 ranges of 16
    let mut in16: Vec[bool] = Vec.new();
    for i in 0..16 {
        let mut any = false;
        for j in 0..16 {
            if in_use[i * 16 + j] {
                any = true;
            }
        }
        in16.push(any);
    }
    for i in 0..16 {
        put_bits(w, 1, if in16[i] { 1 } else { 0 });
    }
    for i in 0..16 {
        if in16[i] {
            for j in 0..16 {
                put_bits(w, 1, if in_use[i * 16 + j] { 1 } else { 0 });
            }
        }
    }
    put_bits(w, 3, ng);
    put_bits(w, 15, sels.len());
    for j in selmtf {
        for _ in 0..j {
            put_bits(w, 1, 1);
        }
        put_bits(w, 1, 0);
    }
    // each table's lengths as steps up (10) and down (11) from the last
    for t in 0..ng {
        let row = ref lens[t];
        let mut cur = row[0];
        put_bits(w, 5, cur);
        for i in 0..alpha {
            while cur < row[i] {
                put_bits(w, 2, 2);
                cur += 1;
            }
            while cur > row[i] {
                put_bits(w, 2, 3);
                cur -= 1;
            }
            put_bits(w, 1, 0);
        }
    }
    let mut g1: i64 = 0;
    let mut sc: i64 = 0;
    while g1 < nmtf {
        let ge = if g1 + 49 < nmtf - 1 { g1 + 49 } else { nmtf - 1 };
        let t = sels[sc];
        for i in g1..ge + 1 {
            let s = mtfv[i];
            put_bits(w, lens[t][s], codes[t][s]);
        }
        g1 = ge + 1;
        sc += 1;
    }
}

fn compress(t: ref Vec[i64], data: ref Vec[u8], level: i64) -> Vec[u8] {
    let mut w = BitWriter { buf: Vec.new(), acc: 0, n: 0 };
    put_bits(mut w, 8, b'B' as i64);
    put_bits(mut w, 8, b'Z' as i64);
    put_bits(mut w, 8, b'h' as i64);
    put_bits(mut w, 8, 0x30 + level);
    let mut comb: i64 = 0;
    for b in rle1_blocks(t, data, level) {
        comb = combine(comb, b.crc);
        compress_block(mut w, b);
    }
    put_byte_list(mut w, END_MAGIC.as_slice().to_vec());
    put_bits(mut w, 32, comb);
    finish_bits(mut w);
    w.buf
}

// ------------------------------------------------------------ the decompressor

// Errors are "eof" (the input ends inside a stream), "data" (a damaged
// block or a CRC that does not match) and "magic" (no stream header).
struct BitReader {
    data: Vec[u8],
    pos: i64,
    acc: i64,
    n: i64,
}

fn get_bits(r: mut ref BitReader, k: i64) -> Result[i64, String] {
    while r.n < k {
        if r.pos >= r.data.len() {
            return Err("eof".to_string());
        }
        r.acc = (r.acc << 8) | (r.data[r.pos] as i64);
        r.pos += 1;
        r.n += 8;
    }
    r.n -= k;
    let v = (r.acc >> r.n) & ((1 << k) - 1);
    r.acc &= (1 << r.n) - 1;
    Ok(v)
}

// A stream ends on a byte boundary; the next one starts at the next byte.
fn drop_partial(r: mut ref BitReader) {
    r.acc = 0;
    r.n = 0;
}

fn data_err[T]() -> Result[T, String] {
    Err("data".to_string())
}

// One table's decoding limits, as BZ2_hbCreateDecodeTables builds them.
struct Table {
    minlen: i64,
    limit: Vec[i64],
    base: Vec[i64],
    perm: Vec[i64],
}

fn decode_table(lens: ref Vec[i64], alpha: i64) -> Table {
    let mut mn: i64 = 32;
    let mut mx: i64 = 0;
    for x in lens {
        if x < mn {
            mn = x;
        }
        if x > mx {
            mx = x;
        }
    }
    let mut perm: Vec[i64] = Vec.new();
    for i in mn..mx + 1 {
        for j in 0..alpha {
            if lens[j] == i {
                perm.push(j);
            }
        }
    }
    let mut base = zeros(23);
    for i in 0..alpha {
        base[lens[i] + 1] += 1;
    }
    for i in 1..23 {
        base[i] += base[i - 1];
    }
    let mut limit = zeros(23);
    let mut vec: i64 = 0;
    for i in mn..mx + 1 {
        vec += base[i + 1] - base[i];
        limit[i] = vec - 1;
        vec = vec << 1;
    }
    for i in mn + 1..mx + 1 {
        base[i] = ((limit[i - 1] + 1) << 1) - base[i];
    }
    Table { minlen: mn, limit: limit, base: base, perm: perm }
}

// Where the symbol reader is: the selectors, the group and how many
// symbols are left in it.
struct Groups {
    sels: Vec[i64],
    tables: Vec[Table],
    group: i64,
    left: i64,
}

fn next_sym(r: mut ref BitReader, g: mut ref Groups) -> Result[i64, String] {
    if g.left == 0 {
        g.group += 1;
        if g.group >= g.sels.len() {
            return data_err();
        }
        g.left = 50;
    }
    g.left -= 1;
    let tables = ref g.tables;
    let t = ref tables[g.sels[g.group]];
    let mut zn = t.minlen;
    let mut zv = get_bits(r, zn)?;
    loop {
        if zn > 20 {
            return data_err();
        }
        if zv <= t.limit[zn] {
            break;
        }
        zn += 1;
        zv = (zv << 1) | get_bits(r, 1)?;
    }
    let k = zv - t.base[zn];
    if k < 0 or k >= 258 or k >= t.perm.len() {
        return data_err();
    }
    Ok(t.perm[k])
}

fn read_magic(r: mut ref BitReader) -> Result[Vec[i64], String] {
    let mut m: Vec[i64] = Vec.new();
    for _ in 0..6 {
        m.push(get_bits(r, 8)?);
    }
    Ok(m)
}

// One stream: its blocks go to sink, and -vv notes go to note.
fn decode_stream(t: ref Vec[i64], r: mut ref BitReader, verbose: i64, sink: mut ref Vec[u8], note: mut ref String) -> Result[(), String] {
    for want in [b'B', b'Z', b'h'] {
        if get_bits(r, 8)? != want as i64 {
            return Err("magic".to_string());
        }
    }
    let level = get_bits(r, 8)? - 0x30;
    if level < 1 or level > 9 {
        return Err("magic".to_string());
    }
    let mut comb: i64 = 0;
    let mut blockno: i64 = 0;
    loop {
        let magic = read_magic(r)?;
        if magic == END_MAGIC.as_slice().to_vec() {
            let stored = get_bits(r, 32)?;
            if stored != comb {
                return data_err();
            }
            drop_partial(r);
            return Ok(());
        }
        if magic != BLOCK_MAGIC.as_slice().to_vec() {
            return data_err();
        }
        blockno += 1;
        if verbose >= 2 {
            note.push_str(f"\n    [{blockno}: huff+mtf ");
        }
        let bcrc = get_bits(r, 32)?;
        get_bits(r, 1)?;
        let orig = get_bits(r, 24)?;
        if orig > 10 + 100000 * level {
            return data_err();
        }
        let mut in16: Vec[i64] = Vec.new();
        for _ in 0..16 {
            in16.push(get_bits(r, 1)?);
        }
        let mut unseq: Vec[u8] = Vec.new();
        for i in 0..16 {
            if in16[i] == 1 {
                for j in 0..16 {
                    if get_bits(r, 1)? == 1 {
                        unseq.push((i * 16 + j) as u8);
                    }
                }
            }
        }
        let ninuse = unseq.len();
        if ninuse == 0 {
            return data_err();
        }
        let alpha = ninuse + 2;
        let ng = get_bits(r, 3)?;
        if ng < 2 or ng > 6 {
            return data_err();
        }
        let nsel = get_bits(r, 15)?;
        if nsel < 1 {
            return data_err();
        }
        let mut pos = zeros(ng);
        for i in 0..ng {
            pos[i] = i;
        }
        let mut sels: Vec[i64] = Vec.new();
        for i in 0..nsel {
            let mut j: i64 = 0;
            while get_bits(r, 1)? == 1 {
                j += 1;
                if j >= ng {
                    return data_err();
                }
            }
            if i < 18002 {
                sels.push(pos[j]);
                to_front(mut pos, j);
            }
        }
        let mut tables: Vec[Table] = Vec.new();
        for _ in 0..ng {
            let mut cur = get_bits(r, 5)?;
            let mut lens: Vec[i64] = Vec.new();
            for _ in 0..alpha {
                loop {
                    if cur < 1 or cur > 20 {
                        return data_err();
                    }
                    if get_bits(r, 1)? == 0 {
                        break;
                    }
                    if get_bits(r, 1)? == 0 {
                        cur += 1;
                    } else {
                        cur -= 1;
                    }
                }
                lens.push(cur);
            }
            tables.push(decode_table(lens, alpha));
        }
        let eob = ninuse + 1;
        let nmax = 100000 * level;
        let mut g = Groups { sels: sels, tables: tables, group: -1, left: 0 };
        let mut yy = zeros(ninuse);
        for i in 0..ninuse {
            yy[i] = i;
        }
        let mut tt: Vec[u8] = Vec.new();
        let mut s = next_sym(r, mut g)?;
        while s != eob {
            if s <= 1 {
                let mut es: i64 = -1;
                let mut nn: i64 = 1;
                while s <= 1 {
                    if nn >= 2 * 1024 * 1024 {
                        return data_err();
                    }
                    es += if s == 0 { nn } else { 2 * nn };
                    nn *= 2;
                    s = next_sym(r, mut g)?;
                }
                es += 1;
                let uc = unseq[yy[0]];
                if tt.len() + es > nmax {
                    return data_err();
                }
                for _ in 0..es {
                    tt.push(uc);
                }
            } else {
                if tt.len() >= nmax {
                    return data_err();
                }
                let v = yy[s - 1];
                to_front(mut yy, s - 1);
                tt.push(unseq[v]);
                s = next_sym(r, mut g)?;
            }
        }
        let n = tt.len();
        if orig >= n {
            return data_err();
        }
        // the inverse transform follows each byte to the rotation after it
        let mut start = zeros(256);
        for b in tt {
            start[b as i64] += 1;
        }
        let mut acc: i64 = 0;
        for i in 0..256 {
            let k = start[i];
            start[i] = acc;
            acc += k;
        }
        let mut nxt = zeros(n);
        for i in 0..n {
            let b = tt[i] as i64;
            nxt[start[b]] = i;
            start[b] += 1;
        }
        let mut p = nxt[orig];
        let mut out: Vec[u8] = Vec.new();
        let mut run: i64 = 0;
        let mut last: i64 = -1;
        for _ in 0..n {
            let b = tt[p];
            p = nxt[p];
            if run == 4 {
                for _ in 0..b as i64 {
                    out.push(last as u8);
                }
                run = 0;
                last = -1;
            } else {
                out.push(b);
                if b as i64 == last {
                    run += 1;
                } else {
                    run = 1;
                }
                last = b as i64;
            }
        }
        if verbose >= 2 {
            note.push_str("rt+rld");
        }
        let c = crc_of(t, out);
        if c != bcrc {
            return data_err();
        }
        comb = combine(comb, c);
        if verbose >= 2 {
            note.push_str("]");
        }
        sink.extend(out);
    }
}

// Every stream in the file. Ok(true) means trailing garbage followed the
// last stream.
fn decode_file(t: ref Vec[i64], data: ref Vec[u8], verbose: i64, sink: mut ref Vec[u8], note: mut ref String) -> Result[bool, String] {
    let mut r = BitReader { data: data.clone(), pos: 0, acc: 0, n: 0 };
    let mut sno: i64 = 0;
    loop {
        sno += 1;
        if let Err(e) = decode_stream(t, mut r, verbose, sink, note) {
            if e == "magic" and sno > 1 {
                return Ok(true);
            }
            return Err(e);
        }
        if r.pos >= r.data.len() {
            return Ok(false);
        }
    }
}

// ------------------------------------------------------------ the commands

struct Job {
    out: String,
    err: String,
    status: i64,
}

fn set_exit(job: mut ref Job, rc: i64) {
    if rc > job.status {
        job.status = rc;
    }
}

fn is_file_path(p: Str) -> bool {
    match fs.metadata(p.to_string()) {
        Ok(m) => m.is_file,
        Err(_) => false,
    }
}

fn exists_path(p: Str) -> bool {
    fs.metadata(p.to_string()).is_ok()
}

fn read_input(path: Str) -> Option[Vec[u8]] {
    match fs.read_bytes(path.to_string()) {
        Ok(b) => Some(b),
        Err(_) => None,
    }
}

fn error_text(e: Str) -> String {
    if e == "eof" {
        "file ends unexpectedly".to_string()
    } else if e == "magic" {
        "bad magic number (file not created by bzip2)".to_string()
    } else {
        "data integrity (CRC) error in data".to_string()
    }
}

fn fixed(x: f64, width: i64, places: i64) -> String {
    let s = if places == 3 { f"{x:.3}" } else { f"{x:.2}" };
    rjust(s, width)
}

// Writes an output file, and removes the input unless -k.
fn write_output(job: mut ref Job, outp: Str, bytes: own Vec[u8], inp: Str, keep: bool) -> bool {
    if let Err(e) = fs.write_bytes(outp.to_string(), bytes) {
        job.err.push_str(f"bzip2: Can't create output file {outp}: {e}.\n");
        set_exit(job, 1);
        return false;
    }
    if not keep {
        let _ = fs.remove_file(inp.to_string());
    }
    true
}

fn bzip2(t: ref Vec[i64], job: mut ref Job, args: ref Vec[String]) {
    let mut mode = b'z';
    let mut keep = false;
    let mut force = false;
    let mut tostd = false;
    let mut verbose: i64 = 0;
    let mut level: i64 = 9;
    let mut files: Vec[String] = Vec.new();
    for a in args {
        let b = to_bytes(a);
        if b.len() > 1 and b[0] == b'-' {
            for ch in b[1..].to_vec() {
                if ch == b'd' or ch == b'z' or ch == b't' {
                    mode = ch;
                } else if ch == b'k' {
                    keep = true;
                } else if ch == b'f' {
                    force = true;
                } else if ch == b'c' {
                    tostd = true;
                } else if ch == b'v' {
                    verbose += 1;
                } else if is_digit(ch) {
                    level = (ch - b'0') as i64;
                }
            }
        } else {
            files.push(a.clone());
        }
    }
    let mut longest: i64 = 0;
    for f in files {
        if f.len() > longest {
            longest = f.len();
        }
    }
    let mut test_fail = false;
    for f in files {
        let path = f"data/{f}";
        let head = f"  {f}: {" ".repeat(longest - f.len())}";
        let data = if is_file_path(path) { read_input(path) } else { None };
        let Some(data) = data else {
            job.err.push_str(f"bzip2: Can't open input {f}: No such file or directory.\n");
            set_exit(job, 1);
            continue;
        };
        if mode == b't' {
            if verbose > 0 {
                job.err.push_str(head);
            }
            let mut sink: Vec[u8] = Vec.new();
            let mut note = String.new();
            let res = decode_file(t, data, verbose, mut sink, mut note);
            job.err.push_str(note);
            match res {
                Ok(trailing) => {
                    if trailing {
                        job.err.push_str("trailing garbage after EOF ignored\n");
                    }
                    if verbose >= 2 {
                        job.err.push_str("\n    ");
                    }
                    if verbose > 0 {
                        job.err.push_str("ok\n");
                    }
                }
                Err(e) => {
                    if verbose == 0 {
                        job.err.push_str(f"bzip2: {f}: ");
                    }
                    job.err.push_str(error_text(e));
                    job.err.push_str("\n");
                    test_fail = true;
                }
            }
            continue;
        }
        if mode == b'd' {
            let outn = if f.ends_with(".bz2") { slice(f, 0, f.len() - 4) } else { f"{f}.out" };
            let outp = f"data/{outn}";
            if not tostd and not force and exists_path(outp) {
                job.err.push_str(f"bzip2: Output file {outn} already exists.\n");
                set_exit(job, 1);
                continue;
            }
            if verbose > 0 {
                job.err.push_str(head);
            }
            let mut sink: Vec[u8] = Vec.new();
            let mut note = String.new();
            let res = decode_file(t, data, verbose, mut sink, mut note);
            job.err.push_str(note);
            match res {
                Ok(trailing) => {
                    if trailing {
                        job.err.push_str("trailing garbage after EOF ignored\n");
                    }
                }
                Err(e) => {
                    job.err.push_str(f"\nbzip2: {f}: {error_text(e)}\n");
                    set_exit(job, 2);
                    continue;
                }
            }
            if tostd {
                job.out.push_str(from_bytes(sink));
            } else if not write_output(job, outp, sink, path, keep) {
                continue;
            }
            if verbose > 0 {
                job.err.push_str("done\n");
            }
            continue;
        }
        let outn = f"{f}.bz2";
        let outp = f"data/{outn}";
        if not tostd and not force and exists_path(outp) {
            job.err.push_str(f"bzip2: Output file {outn} already exists.\n");
            set_exit(job, 1);
            continue;
        }
        if verbose > 0 {
            job.err.push_str(head);
        }
        let z = compress(t, data, level);
        let nin = data.len();
        let nout = z.len();
        if tostd {
            job.out.push_str(from_bytes(z));
        } else if not write_output(job, outp, z, path, keep) {
            continue;
        }
        if verbose > 0 {
            if nin == 0 {
                job.err.push_str(" no data compressed.\n");
            } else {
                let i = nin as f64;
                let o = nout as f64;
                let ratio = fixed(i / o, 6, 3);
                let bits = fixed(8.0 * o / i, 6, 3);
                let saved = fixed(100.0 * (1.0 - o / i), 5, 2);
                job.err.push_str(f"{ratio}:1, {bits} bits/byte, {saved}% saved, {nin} in, {nout} out.\n");
            }
        }
    }
    if test_fail {
        job.err.push_str("\nYou can use the `bzip2recover' program to attempt to recover\ndata from undamaged sections of corrupted files.\n\n");
        set_exit(job, 2);
    }
}

fn sha256sum(job: mut ref Job, args: ref Vec[String]) {
    for f in args {
        let path = f"data/{f}";
        match read_input(path) {
            Some(b) => job.out.push_str(f"{hex_of(sha256(b))}  {f}\n"),
            None => {
                job.err.push_str(f"sha256sum: {f}: No such file or directory\n");
                set_exit(job, 1);
            }
        }
    }
}

