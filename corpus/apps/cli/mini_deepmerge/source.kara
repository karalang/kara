// mini_deepmerge — a port of deepmerge 3.0.1 (MIT, Yusuke Tsutsumi): the
// library pip's config tooling, pydantic-settings and countless apps use to
// deep-merge two nested data structures under a configurable per-type
// strategy. A Merger holds a strategy for each container type (list / dict /
// set), a fallback strategy for two like-typed scalars, and a type-conflict
// strategy for two unlike values; `merge(base, nxt)` walks both in lockstep.
//
// Values use a tiny JSON-with-sets grammar — null / true / false / integers /
// "strings" / [lists] / {"k": v} dicts / <sets> — which is also the grammar
// the merged result is serialized back into. Each job `merge <merger> <base>
// <nxt>` names one of eight strategy configurations (the three deepmerge
// presets always/conservative/merge_or_raise, plus prepend / append_unique /
// set-intersect / set-override / override_if_not_empty). A merger that would
// raise (merge_or_raise on a scalar merge or a type conflict) prints RAISE.
//
// Values live in a flat arena of nodes indexed by i64 (so the recursive merge
// never needs a recursive value type): tag 0 null, 1 bool, 2 int, 3 str,
// 4 list, 5 dict, 6 set. A scalar carries ival/sval; a container carries a
// [kstart, kstart+klen) range into the flat kids/keys arrays. Nodes are
// immutable once built, so a merge that keeps a sub-tree just reuses its
// index. Sets serialize in a canonical order (null < false < true < ints <
// strings) so the output never depends on hash iteration order.
//
// jobs_text() (appended by gen_kara.py) carries data/jobs.tsv verbatim.

struct Cfg {
    dicts: i64, // 0 merge, 1 override
    lists: i64, // 0 override, 1 prepend, 2 append, 3 append_unique
    sets: i64,  // 0 union, 1 intersect, 2 override
    fb: i64,    // fallback: 0 none(raise), 1 override, 2 use_existing
    cf: i64,    // type conflict: 0 none(raise), 1 override, 2 use_existing, 3 override_if_not_empty
}

struct M {
    b: Vec[i64],
    pos: i64,
    src: String,
    tag: Vec[i64],
    ival: Vec[i64],
    sval: Vec[String],
    kstart: Vec[i64],
    klen: Vec[i64],
    kids: Vec[i64],
    keys: Vec[String],
}

fn new_m() -> M {
    M {
        b: Vec.new(),
        pos: 0,
        src: String.new(),
        tag: Vec.new(),
        ival: Vec.new(),
        sval: Vec.new(),
        kstart: Vec.new(),
        klen: Vec.new(),
        kids: Vec.new(),
        keys: Vec.new(),
    }
}

fn str_bytes(s: Str) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for b in s.bytes() {
        v.push(b as i64);
    }
    v
}

fn int_to_str(v: i64) -> String {
    if v == 0 {
        return "0".to_string();
    }
    let mut n = v;
    let mut neg = false;
    if n < 0 {
        neg = true;
        n = -n;
    }
    let mut digs: Vec[i64] = Vec.new();
    while n > 0 {
        digs.push(n % 10);
        n = n / 10;
    }
    let tbl = "0123456789".to_string();
    let mut o = String.new();
    if neg {
        o.push_str("-");
    }
    let mut i = digs.len();
    while i > 0 {
        i = i - 1;
        o.push_str(tbl.substring(digs[i], digs[i] + 1));
    }
    o
}

fn cfg_for(name: Str) -> Cfg {
    if name == "always" {
        return Cfg { dicts: 0, lists: 2, sets: 0, fb: 1, cf: 1 };
    }
    if name == "conservative" {
        return Cfg { dicts: 0, lists: 2, sets: 0, fb: 2, cf: 2 };
    }
    if name == "raise" {
        return Cfg { dicts: 0, lists: 2, sets: 0, fb: 0, cf: 0 };
    }
    if name == "prepend" {
        return Cfg { dicts: 1, lists: 1, sets: 0, fb: 1, cf: 1 };
    }
    if name == "unique" {
        return Cfg { dicts: 0, lists: 3, sets: 0, fb: 1, cf: 1 };
    }
    if name == "intersect" {
        return Cfg { dicts: 0, lists: 2, sets: 1, fb: 1, cf: 1 };
    }
    if name == "setoverride" {
        return Cfg { dicts: 0, lists: 2, sets: 2, fb: 1, cf: 1 };
    }
    // ifnotempty
    Cfg { dicts: 0, lists: 2, sets: 0, fb: 1, cf: 3 }
}

impl M {
    // ---- arena construction ----
    fn add_node(mut ref self, tg: i64, iv: i64, sv: own String, ks: i64, kl: i64) -> i64 {
        let idx = self.tag.len();
        self.tag.push(tg);
        self.ival.push(iv);
        self.sval.push(sv);
        self.kstart.push(ks);
        self.klen.push(kl);
        idx
    }

    fn mk_null(mut ref self) -> i64 {
        self.add_node(0, 0, "".to_string(), 0, 0)
    }
    fn mk_bool(mut ref self, v: i64) -> i64 {
        self.add_node(1, v, "".to_string(), 0, 0)
    }
    fn mk_int(mut ref self, v: i64) -> i64 {
        self.add_node(2, v, "".to_string(), 0, 0)
    }
    fn mk_str(mut ref self, s: own String) -> i64 {
        self.add_node(3, 0, s, 0, 0)
    }

    fn mk_list(mut ref self, vals: ref Vec[i64]) -> i64 {
        let ks = self.kids.len();
        let n = vals.len();
        let mut i = 0;
        while i < n {
            self.kids.push(vals[i]);
            self.keys.push("".to_string());
            i = i + 1;
        }
        self.add_node(4, 0, "".to_string(), ks, n)
    }

    fn mk_set(mut ref self, vals: ref Vec[i64]) -> i64 {
        let ks = self.kids.len();
        let n = vals.len();
        let mut i = 0;
        while i < n {
            self.kids.push(vals[i]);
            self.keys.push("".to_string());
            i = i + 1;
        }
        self.add_node(6, 0, "".to_string(), ks, n)
    }

    fn mk_dict(mut ref self, keys: ref Vec[String], vals: ref Vec[i64]) -> i64 {
        let ks = self.kids.len();
        let n = vals.len();
        let mut i = 0;
        while i < n {
            self.kids.push(vals[i]);
            self.keys.push(keys[i].clone());
            i = i + 1;
        }
        self.add_node(5, 0, "".to_string(), ks, n)
    }

    // ---- parser ----
    fn peek(mut ref self) -> i64 {
        if self.pos < self.b.len() {
            self.b[self.pos]
        } else {
            -1
        }
    }

    fn skip_ws(mut ref self) {
        while self.pos < self.b.len() {
            let c = self.b[self.pos];
            if c == 32 or c == 9 {
                self.pos = self.pos + 1;
            } else {
                return;
            }
        }
    }

    fn parse_into(mut ref self, src: Str) -> i64 {
        self.src = src.to_string();
        self.b = str_bytes(src);
        self.pos = 0;
        self.p_value()
    }

    fn p_value(mut ref self) -> i64 {
        self.skip_ws();
        let c = self.peek();
        if c == 91 {
            return self.p_seq(93, 4); // '[' ']'
        }
        if c == 60 {
            return self.p_seq(62, 6); // '<' '>'
        }
        if c == 123 {
            return self.p_dict(); // '{'
        }
        if c == 34 {
            let s = self.p_string(); // '"'
            return self.mk_str(s);
        }
        self.p_atom()
    }

    fn p_seq(mut ref self, close: i64, tag: i64) -> i64 {
        self.pos = self.pos + 1; // opener
        let mut items: Vec[i64] = Vec.new();
        self.skip_ws();
        if self.peek() == close {
            self.pos = self.pos + 1;
            if tag == 4 {
                return self.mk_list(items);
            }
            return self.mk_set(items);
        }
        let mut more = true;
        while more {
            let v = self.p_value();
            items.push(v);
            self.skip_ws();
            if self.peek() == 44 {
                self.pos = self.pos + 1; // ','
            } else {
                more = false;
            }
        }
        self.skip_ws();
        self.pos = self.pos + 1; // close
        if tag == 4 {
            self.mk_list(items)
        } else {
            self.mk_set(items)
        }
    }

    fn p_dict(mut ref self) -> i64 {
        self.pos = self.pos + 1; // '{'
        let mut dkeys: Vec[String] = Vec.new();
        let mut dvals: Vec[i64] = Vec.new();
        self.skip_ws();
        if self.peek() == 125 {
            self.pos = self.pos + 1; // '}'
            return self.mk_dict(dkeys, dvals);
        }
        let mut more = true;
        while more {
            self.skip_ws();
            let k = self.p_string();
            self.skip_ws();
            self.pos = self.pos + 1; // ':'
            let v = self.p_value();
            dkeys.push(k);
            dvals.push(v);
            self.skip_ws();
            if self.peek() == 44 {
                self.pos = self.pos + 1;
            } else {
                more = false;
            }
        }
        self.skip_ws();
        self.pos = self.pos + 1; // '}'
        self.mk_dict(dkeys, dvals)
    }

    fn p_string(mut ref self) -> String {
        self.pos = self.pos + 1; // opening quote
        let start = self.pos;
        let n = self.b.len();
        while self.pos < n and self.b[self.pos] != 34 {
            self.pos = self.pos + 1;
        }
        let end = self.pos;
        self.pos = self.pos + 1; // closing quote
        self.src.substring(start, end)
    }

    fn p_atom(mut ref self) -> i64 {
        let start = self.pos;
        let n = self.b.len();
        while self.pos < n {
            let c = self.b[self.pos];
            if c == 32 or c == 9 or c == 44 or c == 93 or c == 125 or c == 62 {
                break;
            }
            self.pos = self.pos + 1;
        }
        let tok = self.src.substring(start, self.pos);
        if tok == "null" {
            return self.mk_null();
        }
        if tok == "true" {
            return self.mk_bool(1);
        }
        if tok == "false" {
            return self.mk_bool(0);
        }
        self.mk_int(parse_int_str(tok))
    }

    // ---- structural equality (used by append_unique and set membership) ----
    fn node_eq(mut ref self, x: i64, y: i64) -> bool {
        let tx = self.tag[x];
        let ty = self.tag[y];
        if tx != ty {
            return false;
        }
        if tx == 0 {
            return true;
        }
        if tx == 1 or tx == 2 {
            return self.ival[x] == self.ival[y];
        }
        if tx == 3 {
            return self.sval[x] == self.sval[y];
        }
        if tx == 4 {
            if self.klen[x] != self.klen[y] {
                return false;
            }
            let n = self.klen[x];
            let sx = self.kstart[x];
            let sy = self.kstart[y];
            let mut i = 0;
            while i < n {
                if not self.node_eq(self.kids[sx + i], self.kids[sy + i]) {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }
        if tx == 6 {
            if self.klen[x] != self.klen[y] {
                return false;
            }
            let n = self.klen[x];
            let sx = self.kstart[x];
            let sy = self.kstart[y];
            let mut i = 0;
            while i < n {
                let mut fnd = false;
                let mut j = 0;
                while j < n {
                    if self.node_eq(self.kids[sx + i], self.kids[sy + j]) {
                        fnd = true;
                        break;
                    }
                    j = j + 1;
                }
                if not fnd {
                    return false;
                }
                i = i + 1;
            }
            return true;
        }
        // dict: same size, each key present in the other with an equal value
        if self.klen[x] != self.klen[y] {
            return false;
        }
        let n = self.klen[x];
        let sx = self.kstart[x];
        let sy = self.kstart[y];
        let mut i = 0;
        while i < n {
            let kx = self.keys[sx + i].clone();
            let vx = self.kids[sx + i];
            let mut fnd = false;
            let mut j = 0;
            while j < n {
                if self.keys[sy + j] == kx {
                    if not self.node_eq(vx, self.kids[sy + j]) {
                        return false;
                    }
                    fnd = true;
                    break;
                }
                j = j + 1;
            }
            if not fnd {
                return false;
            }
            i = i + 1;
        }
        true
    }

    // ---- merge engine ----
    fn value_strategy(mut ref self, cfg: ref Cfg, base: i64, nxt: i64) -> i64 {
        let tb = self.tag[base];
        let tn = self.tag[nxt];
        if tb == tn {
            if tb == 5 {
                if cfg.dicts == 1 {
                    return nxt; // override: take nxt wholesale
                }
                return self.dict_merge(cfg, base, nxt);
            }
            if tb == 4 {
                return self.list_merge(cfg, base, nxt);
            }
            if tb == 6 {
                return self.set_merge(cfg, base, nxt);
            }
            // like-typed scalars: no type strategy -> fallback
            return self.apply_fb(cfg, base, nxt);
        }
        // unlike types -> type conflict
        self.apply_cf(cfg, base, nxt)
    }

    fn apply_fb(mut ref self, cfg: ref Cfg, base: i64, nxt: i64) -> i64 {
        if cfg.fb == 1 {
            return nxt;
        }
        if cfg.fb == 2 {
            return base;
        }
        -1 // none -> raise
    }

    fn apply_cf(mut ref self, cfg: ref Cfg, base: i64, nxt: i64) -> i64 {
        if cfg.cf == 1 {
            return nxt;
        }
        if cfg.cf == 2 {
            return base;
        }
        if cfg.cf == 3 {
            return self.override_if_not_empty(base, nxt);
        }
        -1 // none -> raise
    }

    fn override_if_not_empty(mut ref self, base: i64, nxt: i64) -> i64 {
        let t = self.tag[nxt];
        if t == 0 {
            return base; // None
        }
        if t == 3 {
            // empty string is "empty"
            if self.sval[nxt].bytes().len() == 0 {
                return base;
            }
            return nxt;
        }
        if t == 4 or t == 5 or t == 6 {
            if self.klen[nxt] == 0 {
                return base;
            }
            return nxt;
        }
        nxt // int / bool are never "empty" (0, 0.0, false still override)
    }

    fn dict_merge(mut ref self, cfg: ref Cfg, base: i64, nxt: i64) -> i64 {
        let bn = self.klen[base];
        let bs = self.kstart[base];
        let nn = self.klen[nxt];
        let ns = self.kstart[nxt];
        let mut okeys: Vec[String] = Vec.new();
        let mut ovals: Vec[i64] = Vec.new();
        let mut i = 0;
        while i < bn {
            okeys.push(self.keys[bs + i].clone());
            ovals.push(self.kids[bs + i]);
            i = i + 1;
        }
        let mut j = 0;
        while j < nn {
            let k = self.keys[ns + j].clone();
            let v = self.kids[ns + j];
            let mut found = -1;
            let mut p = 0;
            let ok_n = okeys.len();
            while p < ok_n {
                if okeys[p] == k {
                    found = p;
                    break;
                }
                p = p + 1;
            }
            if found < 0 {
                okeys.push(k);
                ovals.push(v);
            } else {
                let merged = self.value_strategy(cfg, ovals[found], v);
                if merged < 0 {
                    return -1;
                }
                ovals[found] = merged;
            }
            j = j + 1;
        }
        self.mk_dict(okeys, ovals)
    }

    fn list_merge(mut ref self, cfg: ref Cfg, base: i64, nxt: i64) -> i64 {
        let s = cfg.lists;
        if s == 0 {
            return nxt; // override
        }
        let bn = self.klen[base];
        let bs = self.kstart[base];
        let nn = self.klen[nxt];
        let ns = self.kstart[nxt];
        let mut out: Vec[i64] = Vec.new();
        if s == 1 {
            // prepend: nxt then base
            let mut i = 0;
            while i < nn {
                out.push(self.kids[ns + i]);
                i = i + 1;
            }
            let mut k = 0;
            while k < bn {
                out.push(self.kids[bs + k]);
                k = k + 1;
            }
            return self.mk_list(out);
        }
        // append (2) or append_unique (3): base then nxt
        let mut i = 0;
        while i < bn {
            out.push(self.kids[bs + i]);
            i = i + 1;
        }
        let mut k = 0;
        while k < nn {
            let cand = self.kids[ns + k];
            if s == 3 {
                let mut dup = false;
                let mut p = 0;
                let on = out.len();
                while p < on {
                    if self.node_eq(out[p], cand) {
                        dup = true;
                        break;
                    }
                    p = p + 1;
                }
                if not dup {
                    out.push(cand);
                }
            } else {
                out.push(cand);
            }
            k = k + 1;
        }
        self.mk_list(out)
    }

    fn set_merge(mut ref self, cfg: ref Cfg, base: i64, nxt: i64) -> i64 {
        let s = cfg.sets;
        if s == 2 {
            return nxt; // override
        }
        let bn = self.klen[base];
        let bs = self.kstart[base];
        let nn = self.klen[nxt];
        let ns = self.kstart[nxt];
        let mut out: Vec[i64] = Vec.new();
        if s == 0 {
            // union: base, then nxt elements not already present
            let mut i = 0;
            while i < bn {
                out.push(self.kids[bs + i]);
                i = i + 1;
            }
            let mut k = 0;
            while k < nn {
                let cand = self.kids[ns + k];
                let mut dup = false;
                let mut p = 0;
                let on = out.len();
                while p < on {
                    if self.node_eq(out[p], cand) {
                        dup = true;
                        break;
                    }
                    p = p + 1;
                }
                if not dup {
                    out.push(cand);
                }
                k = k + 1;
            }
            return self.mk_set(out);
        }
        // intersect (1): base elements that also appear in nxt
        let mut i = 0;
        while i < bn {
            let cand = self.kids[bs + i];
            let mut inn = false;
            let mut p = 0;
            while p < nn {
                if self.node_eq(cand, self.kids[ns + p]) {
                    inn = true;
                    break;
                }
                p = p + 1;
            }
            if inn {
                out.push(cand);
            }
            i = i + 1;
        }
        self.mk_set(out)
    }

    // ---- serialization ----
    fn srank(mut ref self, i: i64) -> i64 {
        let t = self.tag[i];
        if t == 0 {
            return 0;
        }
        if t == 1 {
            return 1;
        }
        if t == 2 {
            return 2;
        }
        3
    }

    // canonical order for set elements: null < false < true < ints < strings
    fn canon_lt(mut ref self, x: i64, y: i64) -> bool {
        let rx = self.srank(x);
        let ry = self.srank(y);
        if rx != ry {
            return rx < ry;
        }
        if rx == 1 or rx == 2 {
            return self.ival[x] < self.ival[y];
        }
        if rx == 3 {
            return self.sval[x] < self.sval[y];
        }
        false // both null
    }

    fn ser(mut ref self, idx: i64) -> String {
        let t = self.tag[idx];
        if t == 0 {
            return "null".to_string();
        }
        if t == 1 {
            if self.ival[idx] == 1 {
                return "true".to_string();
            }
            return "false".to_string();
        }
        if t == 2 {
            return int_to_str(self.ival[idx]);
        }
        if t == 3 {
            let mut o = String.new();
            o.push_str("\"");
            o.push_str(self.sval[idx].clone());
            o.push_str("\"");
            return o;
        }
        if t == 4 {
            return self.ser_seq(idx, "[", "]");
        }
        if t == 6 {
            return self.ser_set(idx);
        }
        self.ser_dict(idx)
    }

    fn ser_seq(mut ref self, idx: i64, op: Str, cl: Str) -> String {
        let n = self.klen[idx];
        let ks = self.kstart[idx];
        let mut o = String.new();
        o.push_str(op);
        let mut i = 0;
        while i < n {
            if i > 0 {
                o.push_str(", ");
            }
            let child = self.kids[ks + i];
            o.push_str(self.ser(child));
            i = i + 1;
        }
        o.push_str(cl);
        o
    }

    fn ser_dict(mut ref self, idx: i64) -> String {
        let n = self.klen[idx];
        let ks = self.kstart[idx];
        let mut o = String.new();
        o.push_str("{");
        let mut i = 0;
        while i < n {
            if i > 0 {
                o.push_str(", ");
            }
            o.push_str("\"");
            o.push_str(self.keys[ks + i].clone());
            o.push_str("\": ");
            let child = self.kids[ks + i];
            o.push_str(self.ser(child));
            i = i + 1;
        }
        o.push_str("}");
        o
    }

    fn ser_set(mut ref self, idx: i64) -> String {
        let n = self.klen[idx];
        let ks = self.kstart[idx];
        let mut order: Vec[i64] = Vec.new();
        let mut i = 0;
        while i < n {
            order.push(self.kids[ks + i]);
            i = i + 1;
        }
        // insertion sort by canonical order
        let m = order.len();
        let mut a = 1;
        while a < m {
            let x = order[a];
            let mut j = a;
            while j > 0 and self.canon_lt(x, order[j - 1]) {
                order[j] = order[j - 1];
                j = j - 1;
            }
            order[j] = x;
            a = a + 1;
        }
        let mut o = String.new();
        o.push_str("<");
        let mut k = 0;
        while k < m {
            if k > 0 {
                o.push_str(", ");
            }
            o.push_str(self.ser(order[k]));
            k = k + 1;
        }
        o.push_str(">");
        o
    }
}

fn parse_int_str(s: Str) -> i64 {
    let b = str_bytes(s);
    let n = b.len();
    let mut i = 0;
    let mut neg = false;
    if n > 0 and b[0] == 45 {
        neg = true;
        i = 1;
    }
    let mut acc = 0;
    while i < n {
        acc = acc * 10 + (b[i] - 48);
        i = i + 1;
    }
    if neg {
        -acc
    } else {
        acc
    }
}

fn run_job(fields: ref Vec[String]) -> String {
    let merger = fields[1].clone();
    let base_s = fields[2].clone();
    let nxt_s = fields[3].clone();
    let cfg = cfg_for(merger);
    let mut m = new_m();
    let b = m.parse_into(base_s);
    let n2 = m.parse_into(nxt_s);
    let r = m.value_strategy(cfg, b, n2);
    if r < 0 {
        return "RAISE".to_string();
    }
    m.ser(r)
}

fn split_fields(line: Str) -> Vec[String] {
    let v = str_bytes(line);
    let n = v.len();
    let mut fields: Vec[String] = Vec.new();
    let mut start = 0;
    let mut i = 0;
    while i <= n {
        if i == n or v[i] == 9 {
            fields.push(line.substring(start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    fields
}

fn main_run() -> String {
    let data = jobs_text();
    let db = str_bytes(data);
    let n = db.len();
    let mut out = String.new();
    let mut i = 0;
    let mut line_start = 0;
    while i <= n {
        if i == n or db[i] == 10 {
            if i > line_start {
                let line = data.substring(line_start, i);
                let fields = split_fields(line);
                out.push_str("== ");
                out.push_str(fields[1].clone());
                out.push_str(" | ");
                out.push_str(fields[2].clone());
                out.push_str(" | ");
                out.push_str(fields[3].clone());
                out.push_str("\n  ");
                out.push_str(run_job(fields));
                out.push_str("\n");
            }
            line_start = i + 1;
        }
        i = i + 1;
    }
    out
}

fn main() {
    print(main_run());
}
// data/jobs.tsv, as mk.py writes it.
fn jobs_text() -> String {
    let mut s = String.new();
    s.push_str("merge\talways\t{\"a\": [1, 2], \"b\": {\"x\": 1}}\t{\"a\": [2, 3], \"b\": {\"y\": 2}, \"c\": 5}\n");
    s.push_str("merge\talways\t{\"a\": 1}\t{\"a\": 2}\n");
    s.push_str("merge\tconservative\t{\"a\": 1}\t{\"a\": 2}\n");
    s.push_str("merge\talways\t{\"a\": 1}\t{\"a\": \"s\"}\n");
    s.push_str("merge\tconservative\t{\"a\": 1}\t{\"a\": \"s\"}\n");
    s.push_str("merge\talways\t[1, 2]\t[3, 4]\n");
    s.push_str("merge\tprepend\t[1, 2]\t[3, 4]\n");
    s.push_str("merge\tunique\t[1, 2, 3]\t[2, 3, 4]\n");
    s.push_str("merge\tunique\t[{\"a\": 1}]\t[{\"a\": 1}, {\"b\": 2}]\n");
    s.push_str("merge\talways\t<1, 2>\t<2, 3>\n");
    s.push_str("merge\tintersect\t<1, 2, 3>\t<2, 3, 4>\n");
    s.push_str("merge\tsetoverride\t<1, 2>\t<3, 4>\n");
    s.push_str("merge\talways\t<\"b\", \"a\">\t<\"c\", \"a\">\n");
    s.push_str("merge\traise\t{\"a\": [1]}\t{\"a\": [2], \"b\": 3}\n");
    s.push_str("merge\traise\t{\"a\": 1}\t{\"b\": 2}\n");
    s.push_str("merge\traise\t{\"a\": 1}\t{\"a\": 2}\n");
    s.push_str("merge\traise\t1\t\"s\"\n");
    s.push_str("merge\tifnotempty\t5\t0\n");
    s.push_str("merge\tifnotempty\t5\tnull\n");
    s.push_str("merge\tifnotempty\t5\t\"s\"\n");
    s.push_str("merge\tifnotempty\t[1]\t{}\n");
    s.push_str("merge\tifnotempty\t5\t[]\n");
    s.push_str("merge\tifnotempty\tfalse\ttrue\n");
    s.push_str("merge\talways\t{\"pkgs\": [{\"n\": \"a\"}], \"env\": {\"p\": \"3\"}}\t{\"pkgs\": [{\"n\": \"b\"}], \"env\": {\"q\": \"4\"}, \"ci\": true}\n");
    s.push_str("merge\talways\t{\"tags\": <\"x\">}\t{\"tags\": <\"y\", \"x\">}\n");
    s.push_str("merge\tprepend\t{\"a\": {\"x\": 1}}\t{\"a\": {\"y\": 2}}\n");
    s.push_str("merge\talways\t{\"a\": null}\t{\"a\": 7}\n");
    s.push_str("merge\tconservative\t{\"a\": null}\t{\"a\": 7}\n");
    s.push_str("merge\talways\t{}\t{\"a\": 1, \"b\": [2]}\n");
    s.push_str("merge\talways\t{\"name\": \"old\"}\t{\"name\": \"new\"}\n");
    s
}
