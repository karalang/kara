fn data_part_2(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("#LWP-Cookies-2.0\n");
    t.push_str("Set-Cookie3: lang=en; path=\"/\"; domain=\".acme.com\"; path_spec; domain_dot; expires=\"2033-05-18 03:33:20Z\"; version=0\n");
    t.push_str("# a comment line is skipped\n");
    t.push_str("Set-Cookie3: cart=\"3 items\"; path=\"/shop\"; domain=\"shop.acme.com\"; path_spec; discard; HttpOnly=None; version=0\n");
    t.push_str("Set-Cookie3: old=1; path=\"/\"; domain=\".acme.com\"; expires=\"2020-01-01 00:00:00Z\"; version=0\n");
    t.push_str("Set-Cookie3: v1=x; path=\"/\"; domain=\"www.acme.com\"; port=\"80,8080\"; port_spec; secure; expires=\"20330518T033320Z\"; Comment=\"x\"; version=1\n");
    v.push(DataFile { path: "session.lwp".to_string(), body: t });
    let mut t = String.new();
    t.push_str("GET\thttps://shop.example.com/\n");
    t.push_str("RESP\tSet-Cookie: visitor=v-1001; Domain=example.com; Path=/; Expires=Fri, 01 Jan 2038 00:00:00 GMT\tSet-Cookie: csrftoken=t-7; Path=/; Secure\n");
    t.push_str("GET\thttps://shop.example.com/login\n");
    t.push_str("RESP\tSet-Cookie: sessionid=s-42; Path=/; Secure; HttpOnly\tSet-Cookie: csrftoken=t-8; Path=/; Secure\n");
