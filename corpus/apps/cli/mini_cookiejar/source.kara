    t.push_str("RESP\tSet-Cookie: recent=o-9,o-8; Path=/account; Max-Age=3600\n");
    t.push_str("GET\thttp://shop.example.com/account/orders\n");
    t.push_str("RESP\n");
    t.push_str("SAVE\twork/session.txt\n");
    t.push_str("RESTART\n");
    t.push_str("GET\thttps://shop.example.com/account/orders\n");
    t.push_str("RESP\tSet-Cookie: sessionid=; Path=/; Max-Age=0\n");
