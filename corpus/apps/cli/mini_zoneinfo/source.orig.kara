fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn unhex(s: String) -> Vec[u8] {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data")?;
    put("data/convert.txt", file_0())?;
    put("data/meetings.txt", file_1())?;
    put("data/tzstrings.txt", file_2())?;
    put("data/years.txt", file_3())?;
    make_dir("data/zones/Africa")?;
    put_bytes("data/zones/Africa/Casablanca", unhex(file_4()))?;
    make_dir("data/zones/America")?;
    put_bytes("data/zones/America/New_York", unhex(file_5()))?;
    put_bytes("data/zones/America/Sao_Paulo", unhex(file_6()))?;
    put_bytes("data/zones/America/St_Johns", unhex(file_7()))?;
    make_dir("data/zones/Antarctica")?;
    put_bytes("data/zones/Antarctica/Troll", unhex(file_8()))?;
    make_dir("data/zones/Asia")?;
    put_bytes("data/zones/Asia/Kolkata", unhex(file_9()))?;
    make_dir("data/zones/Australia")?;
    put_bytes("data/zones/Australia/Lord_Howe", unhex(file_10()))?;
    make_dir("data/zones/Bad")?;
    put_bytes("data/zones/Bad/Empty", unhex(file_11()))?;
    put_bytes("data/zones/Bad/Index", unhex(file_12()))?;
    put_bytes("data/zones/Bad/Magic", unhex(file_13()))?;
    put_bytes("data/zones/Bad/NoNewline", unhex(file_14()))?;
    put_bytes("data/zones/Bad/NoRules", unhex(file_15()))?;
    put_bytes("data/zones/Bad/RulesNoDST", unhex(file_16()))?;
    put_bytes("data/zones/Bad/Week", unhex(file_17()))?;
    make_dir("data/zones/Europe")?;
    put_bytes("data/zones/Europe/London", unhex(file_18()))?;
    make_dir("data/zones/Pacific")?;
    put_bytes("data/zones/Pacific/Apia", unhex(file_19()))?;
    put_bytes("data/zones/Pacific/Chatham", unhex(file_20()))?;
    make_dir("data/zones/Test")?;
    put_bytes("data/zones/Test/Eire", unhex(file_21()))?;
    put_bytes("data/zones/Test/Fixed", unhex(file_22()))?;
    put_bytes("data/zones/Test/FooterOnly", unhex(file_23()))?;
    put_bytes("data/zones/Test/Guess", unhex(file_24()))?;
    put_bytes("data/zones/Test/Indicators", unhex(file_25()))?;
    put_bytes("data/zones/Test/Julian", unhex(file_26()))?;
    put_bytes("data/zones/Test/Version1", unhex(file_27()))?;
    make_dir("data/zones")?;
    put_bytes("data/zones/UTC", unhex(file_28()))?;
    Ok(())
}

// ------------------------------------------------------------ the reports

const ROOT: Str = "data/zones";
const DAYS: Array[Str, 7] = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

fn read(path: Str) -> Result[String, String] {
    match fs.read_to_string(path.to_string()) {
        Ok(t) => Ok(t),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

// Every file under the zones directory, as a key.
fn walk(dir: Str, out: mut ref Vec[String]) -> Result[(), String] {
    let full = if dir.len() > 0 { f"{ROOT}/{dir}" } else { ROOT.to_string() };
    let names = match fs.read_dir(full.clone()) {
        Ok(v) => v,
        Err(e) => return Err(f"cannot list {full}: {e}"),
    };
    for i in 0..names.len() {
        let rel = if dir.len() > 0 { f"{dir}/{names[i]}" } else { names[i].clone() };
        let is_dir = match fs.metadata(f"{ROOT}/{rel}") {
            Ok(m) => m.is_dir,
            Err(e) => return Err(f"cannot stat {rel}: {e}"),
        };
        if is_dir {
            walk(rel, out)?;
        } else {
            out.push(rel);
        }
    }
    Ok(())
}

fn tti_str(t: ref Tti) -> String {
    f"{t.tzname} {off(t.utcoff)} dst {t.dstoff}"
}

fn rule_str(r: ref DayRule) -> String {
    let d = if r.cal { f"M{r.m}.{r.w}.{r.d}" } else if r.julian { f"J{r.d}" } else { f"{r.d}" };
    f"{d}/{r.secs}"
}

fn after_str(a: ref After) -> String {
    if a.is_rule {
        return f"rule {tti_str(a.std)} / {tti_str(a.dst)}, {rule_str(a.start)} to {rule_str(a.end)}";
    }
    f"fixed {tti_str(a.std)}"
}

fn show_zones() -> Result[Vec[Zone], String] {
    println("== zones");
    let mut keys: Vec[String] = Vec.new();
    walk("", mut keys)?;
    for i in 1..keys.len() {
        let mut j = i;
        while j > 0 and keys[j] < keys[j - 1] {
            keys.swap(j - 1, j);
            j -= 1;
        }
    }
    let mut zones: Vec[Zone] = Vec.new();
    for key in keys {
        let bytes = match fs.read_bytes(f"{ROOT}/{key}") {
            Ok(b) => b,
            Err(e) => return Err(f"cannot read {key}: {e}"),
        };
        let raw = match load_data(bytes) {
            Ok(r) => r,
            Err(e) => {
                println(f"{key}: ValueError: {e}");
                continue;
            }
        };
        let z = match load_zone(key, raw) {
            Ok(z) => z,
            Err(e) => {
                println(f"{key}: ValueError: {e}");
                continue;
            }
        };
        let footer = match raw.tz_str.clone() {
            Some(s) => py_repr(s),
            None => "None".to_string(),
        };
        println(f"{key}: version {raw.version}, {raw.trans_utc.len()} transitions, {raw.utcoff.len()} types, footer {footer}");
        let dstoff = utcoff_to_dstoff(raw.trans_idx, raw.utcoff, raw.isdst);
        for t in 0..raw.utcoff.len() {
            println(f"  type {t}: {raw.abbr[t]} {off(raw.utcoff[t])} isdst {raw.isdst[t]} dst {dstoff[t]}");
        }
        if raw.trans_utc.len() > 0 {
            println(f"  first {iso(raw.trans_utc[0])}Z, last {iso(raw.trans_utc[raw.trans_utc.len() - 1])}Z");
        }
        let before = match z.before.clone() {
            Some(t) => tti_str(t),
            None => "None".to_string(),
        };
        println(f"  before {before}");
        println(f"  after {after_str(z.after)}");
        zones.push(z);
    }
    Ok(zones)
}

fn show_tzstrings() -> Result[(), String] {
    println("== tz strings");
    for s in lines_of(read("data/tzstrings.txt")?) {
        match parse_tz_str(s) {
            Ok(a) => {
                println(f"{py_repr(s)}: {after_str(a)}");
                if a.is_rule {
                    for y in [2024, 2025] {
                        let (st, en) = transitions(a, y);
                        println(f"  {y}: {iso(st)} to {iso(en)}");
                    }
                }
            }
            Err(e) => println(f"{py_repr(s)}: ValueError: {e}"),
        }
    }
    Ok(())
}

fn zone_at(zones: ref Vec[Zone], key: Str) -> i64 {
    for i in 0..zones.len() {
        if zones[i].key == key {
            return i;
        }
    }
    -1
}

// The local time at a UTC time, as datetime.astimezone shows it.
fn show_local(z: ref Zone, utc: i64) -> String {
    let (t, fold) = from_utc(z, utc);
    let f: i64 = if fold { 1 } else { 0 };
    f"{iso(utc + t.utcoff)}{off(t.utcoff)} fold {f} {t.tzname} dst {t.dstoff}"
}

fn show_convert(zones: ref Vec[Zone]) -> Result[(), String] {
    println("== conversions");
    for line in lines_of(read("data/convert.txt")?) {
        if line.len() == 0 or first_byte(line) == b'#' {
            continue;
        }
        let w = split_on(line, b' ');
        let z = zones[zone_at(zones, w[1])].clone();
        let t = parse_iso(w[2]);
        if w[0] == "utc" {
            println(f"utc {w[1]} {iso(t)}Z -> {show_local(z, t)}");
        } else {
            let fold = py_int(w[3]).unwrap_or(0);
            let tti = find_trans(z, t, fold);
            let u = t - tti.utcoff;
            let (back, _) = from_utc(z, u);
            let note = if u + back.utcoff == t { String.new() } else { f" (round trip {iso(u + back.utcoff)})" };
            println(f"local {w[1]} {iso(t)} fold {w[3]} -> {tti.tzname} {off(tti.utcoff)} dst {tti.dstoff} = {iso(u)}Z{note}");
        }
    }
    Ok(())
}

fn same_state(a: ref Tti, b: ref Tti) -> bool {
    a.utcoff == b.utcoff and a.dstoff == b.dstoff and a.tzname == b.tzname
}

fn state(z: ref Zone, ts: i64) -> Tti {
    let (t, _) = from_utc(z, ts);
    t
}

fn show_years(zones: ref Vec[Zone]) -> Result[(), String] {
    println("== transitions");
    let step: i64 = 3 * 3600;
    for line in lines_of(read("data/years.txt")?) {
        let w = split_on(line, b' ');
        let z = zones[zone_at(zones, w[0])].clone();
        for k in 1..w.len() {
            let y = py_int(w[k]).unwrap_or(0);
            println(f"{w[0]} {y}:");
            let lo = days_from_civil(y, 1, 1) * 86400;
            let hi = days_from_civil(y + 1, 1, 1) * 86400;
            let mut prev = state(z, lo);
            let mut t = lo;
            let mut count: i64 = 0;
            while t < hi {
                let n = if t + step < hi { t + step } else { hi };
                let cur = state(z, n);
                if not same_state(cur, prev) {
                    // prev holds at a, cur at b
                    let mut a = t;
                    let mut b = n;
                    while b - a > 1 {
                        let mid = fdiv(a + b, 2);
                        if same_state(state(z, mid), prev) {
                            a = mid;
                        } else {
                            b = mid;
                        }
                    }
                    println(f"  {iso(b)}Z {prev.tzname} {off(prev.utcoff)} -> {cur.tzname} {off(cur.utcoff)} dst {cur.dstoff}, clocks go from {iso(b - 1 + prev.utcoff)} to {iso(b + cur.utcoff)}");
                    prev = state(z, b);
                    t = b;
                    count += 1;
                    continue;
                }
                t = n;
            }
            if count == 0 {
                println(f"  none, {prev.tzname} {off(prev.utcoff)} all year");
            }
        }
    }
    Ok(())
}

fn show_meetings(zones: ref Vec[Zone]) -> Result[(), String] {
    println("== meetings");
    for line in lines_of(read("data/meetings.txt")?) {
        if line.len() == 0 or first_byte(line) == b'#' {
            continue;
        }
        let f = split_on(line, b'|');
        let name = strip(f[0]);
        let org = strip(f[1]);
        let z = zones[zone_at(zones, org)].clone();
        println(f"{name} ({org}):");
        let start = parse_iso(strip(f[2]));
        let weeks = py_int(f[3]).unwrap_or(0);
        let others = split_on(strip(f[4]), b' ');
        for k in 0..weeks {
            let t = start + 7 * 86400 * k;
            let a = find_trans(z, t, 0);
            let b = find_trans(z, t, 1);
            let u = t - a.utcoff;
            let (bt, _) = from_utc(z, u);
            let back = u + bt.utcoff;
            let head = f"  {DAYS[weekday(fdiv(t, 86400))]} {iso(t)} {a.tzname}";
            if back != t {
                println(f"{head}: does not exist, clocks skip it; moved to {iso(back)}");
            } else if a.utcoff != b.utcoff {
                println(f"{head}: happens twice, using the first");
            } else {
                println(head);
            }
            for o in others {
                let oz = zones[zone_at(zones, o)].clone();
                let (ot, _) = from_utc(oz, u);
                let loc = u + ot.utcoff;
                let day = fdiv(loc, 86400) - fdiv(t, 86400);
                let shift = if day > 0 { f" (+{day} day)" } else if day < 0 { f" ({day} day)" } else { String.new() };
                println(f"    {o}: {DAYS[weekday(fdiv(loc, 86400))]} {hh_mm(loc)} {ot.tzname}{shift}");
            }
        }
    }
    Ok(())
}

fn run() -> Result[(), String] {
    write_data()?;
    let zones = show_zones()?;
    show_tzstrings()?;
    show_convert(zones)?;
    show_years(zones)?;
    show_meetings(zones)
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_zoneinfo: {e}");
    }
}
