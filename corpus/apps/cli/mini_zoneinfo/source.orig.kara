// mini_zoneinfo: time zones as Python 3.13's zoneinfo handles them,
// read from real TZif files:
// - the TZif loader for versions 1 to 3, with every error it reports;
// - the inferred DST offsets, local transition times, the zone before
//   the first transition, and the footer's POSIX TZ string with its M,
//   J and plain day rules, negative DST and every parsing error;
// - utcoffset, dst and tzname for a wall time with fold 0 and 1, and
//   fromutc with its fold detection, before, inside and after the table;
// - a year-by-year list of each zone's transitions, found by stepping
//   fromutc, and a meeting planner that converts weekly meetings across
//   zones and flags times that are skipped or happen twice.
//
// The inputs are the files in data/. expected.out is the output of
// oracle.py, the same program written with zoneinfo and datetime.

// ------------------------------------------------------------ bytes and text

fn byte_str(b: ref Vec[u8], from: i64, to: i64) -> String {
    let mut v: Vec[u8] = Vec.new();
    for i in from..to {
        v.push(b[i]);
    }
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn to_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn from_bytes(v: Vec[u8]) -> String {
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn is_alpha(c: u8) -> bool {
    (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z')
}

fn is_alnum(c: u8) -> bool {
    is_digit(c) or is_alpha(c)
}

// White space, as `\s` and str.strip see it.
fn is_ws(c: u8) -> bool {
    c == b' ' or c == b'\t' or c == b'\n' or c == b'\r' or c == 11 or c == 12
}

fn lower_byte(c: u8) -> u8 {
    if c >= b'A' and c <= b'Z' { c + 32 } else { c }
}

fn lower(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        out.push(lower_byte(b[i]));
    }
    from_bytes(out)
}

fn strip(s: Str) -> String {
    let b = to_bytes(s);
    let mut i: i64 = 0;
    let mut j = b.len();
    while i < j and is_ws(b[i]) {
        i += 1;
    }
    while j > i and is_ws(b[j - 1]) {
        j -= 1;
    }
    byte_str(b, i, j)
}

fn split_ws(s: Str) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        while i < b.len() and is_ws(b[i]) {
            i += 1;
        }
        let st = i;
        while i < b.len() and not is_ws(b[i]) {
            i += 1;
        }
        if i > st {
            out.push(byte_str(b, st, i));
        }
    }
    out
}

fn split_on(s: Str, sep: u8) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut st: i64 = 0;
    for i in 0..b.len() {
        if b[i] == sep {
            out.push(byte_str(b, st, i));
            st = i + 1;
        }
    }
    out.push(byte_str(b, st, b.len()));
    out
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

// The lines of a file, without their newlines.
fn lines_of(text: Str) -> Vec[String] {
    let mut v = split_on(text, b'\n');
    if v.len() > 0 and v[v.len() - 1].len() == 0 {
        v.pop();
    }
    v
}

// Python's repr of a str.
fn py_repr(s: Str) -> String {
    let b = to_bytes(s);
    let mut has_single = false;
    let mut has_double = false;
    for i in 0..b.len() {
        if b[i] == b'\'' {
            has_single = true;
        }
        if b[i] == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let hex = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    out.push(q);
    let mut skip = false;
    for i in 0..b.len() {
        let c = b[i];
        if skip {
            skip = false;
            continue;
        }
        // U+0080 to U+00A0 and U+00AD are not printable either
        let next: u8 = if i + 1 < b.len() { b[i + 1] } else { 0 };
        if c == 0xC2 and next >= 0x80 and (next <= 0xA0 or next == 0xAD) {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(next / 16) as i64]);
            out.push(hex[(next % 16) as i64]);
            skip = true;
        } else if c == q or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c < 32 or c == 127 {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    from_bytes(out)
}

fn upper(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        let c = b[i];
        out.push(if c >= b'a' and c <= b'z' { c - 32 } else { c });
    }
    from_bytes(out)
}

// Whether `pat` occurs in `b` at `i`.
fn starts_at(b: ref Vec[u8], i: i64, pat: Str) -> bool {
    let p = to_bytes(pat);
    if i < 0 or i + p.len() > b.len() {
        return false;
    }
    for k in 0..p.len() {
        if b[i + k] != p[k] {
            return false;
        }
    }
    true
}

fn starts_with(s: Str, pat: Str) -> bool {
    starts_at(to_bytes(s), 0, pat)
}

fn find_str(s: Str, pat: Str) -> i64 {
    let b = to_bytes(s);
    for i in 0..b.len() + 1 {
        if starts_at(b, i, pat) {
            return i;
        }
    }
    -1
}

fn first_byte(s: Str) -> u8 {
    let b = to_bytes(s);
    if b.len() > 0 { b[0] } else { 0 }
}

fn slice_from(s: Str, i: i64) -> String {
    let b = to_bytes(s);
    byte_str(b, i, b.len())
}

fn is_hex(c: u8) -> bool {
    is_digit(c) or (c >= b'a' and c <= b'f') or (c >= b'A' and c <= b'F')
}

fn hex_val(c: u8) -> u8 {
    if is_digit(c) {
        c - b'0'
    } else if c >= b'a' and c <= b'f' {
        c - b'a' + 10
    } else {
        c - b'A' + 10
    }
}

fn find_byte(s: Str, c: u8) -> i64 {
    let b = to_bytes(s);
    for i in 0..b.len() {
        if b[i] == c {
            return i;
        }
    }
    -1
}

fn rfind_byte(s: Str, c: u8) -> i64 {
    let b = to_bytes(s);
    let mut i = b.len() - 1;
    while i >= 0 {
        if b[i] == c {
            return i;
        }
        i -= 1;
    }
    -1
}

fn has_byte(s: Str, c: u8) -> bool {
    find_byte(s, c) >= 0
}

fn slice(s: Str, from: i64, to: i64) -> String {
    byte_str(to_bytes(s), from, to)
}

// str.partition and str.rpartition on one byte: (before, found, after).
fn partition(s: Str, c: u8) -> (String, bool, String) {
    let i = find_byte(s, c);
    if i < 0 {
        return (s.to_string(), false, String.new());
    }
    (slice(s, 0, i), true, slice_from(s, i + 1))
}

fn rpartition(s: Str, c: u8) -> (String, bool, String) {
    let i = rfind_byte(s, c);
    if i < 0 {
        return (String.new(), false, s.to_string());
    }
    (slice(s, 0, i), true, slice_from(s, i + 1))
}

// Python's repr of a bytes object.
fn bytes_repr(b: ref Vec[u8]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for i in 0..b.len() {
        if b[i] == b'\'' {
            has_single = true;
        }
        if b[i] == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let hex = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    out.push(b'b');
    out.push(q);
    for i in 0..b.len() {
        let c = b[i];
        if c == q or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c < 32 or c >= 127 {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    from_bytes(out)
}

fn is_ascii(s: Str) -> bool {
    let b = to_bytes(s);
    for i in 0..b.len() {
        if b[i] >= 0x80 {
            return false;
        }
    }
    true
}

fn py_int(s: Str) -> Option[i64] {
    let b = to_bytes(strip(s));
    let mut i: i64 = 0;
    let mut neg = false;
    if i < b.len() and (b[i] == b'+' or b[i] == b'-') {
        neg = b[i] == b'-';
        i += 1;
    }
    if i >= b.len() {
        return None;
    }
    let mut n: i64 = 0;
    let mut prev_digit = false;
    while i < b.len() {
        let c = b[i];
        if is_digit(c) {
            n = n * 10 + (c - b'0') as i64;
            prev_digit = true;
        } else if c == b'_' and prev_digit and i + 1 < b.len() and is_digit(b[i + 1]) {
            prev_digit = false;
        } else {
            return None;
        }
        i += 1;
    }
    if neg { Some(-n) } else { Some(n) }
}

// The code points of a string.
fn code_points(s: Str) -> Vec[i64] {
    let b = to_bytes(s);
    let mut out: Vec[i64] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | (b[i + 1] as i64 & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | ((b[i + 1] as i64 & 0x3F) << 6) | (b[i + 2] as i64 & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | ((b[i + 1] as i64 & 0x3F) << 12) | ((b[i + 2] as i64 & 0x3F) << 6) | (b[i + 3] as i64 & 0x3F));
            i += 4;
        }
    }
    out
}

fn push_code_point(out: mut ref Vec[u8], cp: i64) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push(((cp >> 6) | 0xC0) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    } else if cp < 0x10000 {
        out.push(((cp >> 12) | 0xE0) as u8);
        out.push((((cp >> 6) & 0x3F) | 0x80) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    } else {
        out.push(((cp >> 18) | 0xF0) as u8);
        out.push((((cp >> 12) & 0x3F) | 0x80) as u8);
        out.push((((cp >> 6) & 0x3F) | 0x80) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    }
}

// ------------------------------------------------------------ calendar

// Division and remainder rounding down, as Python's // and %.
fn fdiv(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

fn fmod(a: i64, b: i64) -> i64 {
    a - fdiv(a, b) * b
}

fn is_leap(y: i64) -> bool {
    (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
}

fn days_in_month(y: i64, m: i64) -> i64 {
    if m == 2 {
        return if is_leap(y) { 29 } else { 28 };
    }
    if m == 4 or m == 6 or m == 9 or m == 11 { 30 } else { 31 }
}

// Days from 1970-01-01 to a date.
fn days_from_civil(year: i64, m: i64, d: i64) -> i64 {
    let y = if m <= 2 { year - 1 } else { year };
    let era = (if y >= 0 { y } else { y - 399 }) / 400;
    let yoe = y - era * 400;
    let mp = if m > 2 { m - 3 } else { m + 9 };
    let doy = (153 * mp + 2) / 5 + d - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

// The date of a day number: (year, month, day).
fn civil_from_days(z0: i64) -> (i64, i64, i64) {
    let z = z0 + 719468;
    let era = (if z >= 0 { z } else { z - 146096 }) / 146097;
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = if mp < 10 { mp + 3 } else { mp - 9 };
    let y = yoe + era * 400;
    (if m <= 2 { y + 1 } else { y }, m, d)
}

// Monday is 0, as datetime.weekday has it.
fn weekday(days: i64) -> i64 {
    fmod(days + 3, 7)
}

fn pad2(n: i64) -> String {
    if n < 10 { f"0{n}" } else { f"{n}" }
}

fn pad4(n: i64) -> String {
    if n < 10 {
        f"000{n}"
    } else if n < 100 {
        f"00{n}"
    } else if n < 1000 {
        f"0{n}"
    } else {
        f"{n}"
    }
}

// A naive datetime, as seconds from 1970-01-01T00:00:00.
fn iso(ts: i64) -> String {
    let (y, m, d) = civil_from_days(fdiv(ts, 86400));
    let s = fmod(ts, 86400);
    f"{pad4(y)}-{pad2(m)}-{pad2(d)}T{pad2(s / 3600)}:{pad2(s / 60 % 60)}:{pad2(s % 60)}"
}

fn hh_mm(ts: i64) -> String {
    let s = fmod(ts, 86400);
    f"{pad2(s / 3600)}:{pad2(s / 60 % 60)}"
}

fn year_of(ts: i64) -> i64 {
    let (y, _, _) = civil_from_days(fdiv(ts, 86400));
    y
}

// "YYYY-MM-DDTHH:MM:SS" as seconds.
fn parse_iso(s: Str) -> i64 {
    let n = |a: i64, b: i64| -> i64 { py_int(slice(s, a, b)).unwrap_or(0) };
    days_from_civil(n(0, 4), n(5, 7), n(8, 10)) * 86400 + n(11, 13) * 3600 + n(14, 16) * 60 + n(17, 19)
}

// A UTC offset the way isoformat writes it.
fn off(secs: i64) -> String {
    let sign = if secs < 0 { "-" } else { "+" };
    let s = if secs < 0 { -secs } else { secs };
    let sec = s % 60;
    let tail = if sec != 0 { f":{pad2(sec)}" } else { String.new() };
    f"{sign}{pad2(s / 3600)}:{pad2(s / 60 % 60)}{tail}"
}

// ------------------------------------------------------------ the TZif file

struct Reader {
    b: Vec[u8],
    at: i64,
}

impl Reader {
    fn take(mut ref self, n: i64) -> Result[Vec[u8], String] {
        if self.at + n > self.b.len() {
            return Err("Invalid TZif file: truncated".to_string());
        }
        let mut out: Vec[u8] = Vec.new();
        for i in self.at..self.at + n {
            out.push(self.b[i]);
        }
        self.at += n;
        Ok(out)
    }

    fn skip(mut ref self, n: i64) {
        self.at += n;
    }

    fn int(mut ref self, n: i64) -> Result[i64, String] {
        let v = self.take(n)?;
        let mut x: i64 = 0;
        for i in 0..n {
            x = (x << 8) | (v[i] as i64);
        }
        // sign-extend
        if n < 8 and v[0] >= 0x80 {
            x -= 1 << (8 * n);
        }
        Ok(x)
    }

    fn byte(mut ref self) -> Result[i64, String] {
        let v = self.take(1)?;
        Ok(v[0] as i64)
    }

    fn signed_byte(mut ref self) -> Result[i64, String] {
        let v = self.byte()?;
        Ok(if v >= 128 { v - 256 } else { v })
    }
}

struct Header {
    version: i64,
    isutcnt: i64,
    isstdcnt: i64,
    leapcnt: i64,
    timecnt: i64,
    typecnt: i64,
    charcnt: i64,
}

fn read_header(r: mut ref Reader) -> Result[Header, String] {
    if from_bytes(r.take(4)?) != "TZif" {
        return Err("Invalid TZif file: magic not found".to_string());
    }
    let v = r.byte()?;
    let version = if v == 0 { 1 } else { v - 48 };
    r.skip(15);
    Ok(Header {
        version: version,
        isutcnt: r.int(4)?,
        isstdcnt: r.int(4)?,
        leapcnt: r.int(4)?,
        timecnt: r.int(4)?,
        typecnt: r.int(4)?,
        charcnt: r.int(4)?,
    })
}

// What _common.load_data reads from a file.
struct Raw {
    version: i64,
    trans_idx: Vec[i64],
    trans_utc: Vec[i64],
    utcoff: Vec[i64],
    isdst: Vec[i64],
    abbr: Vec[String],
    tz_str: Option[String],
}

fn load_data(bytes: Vec[u8]) -> Result[Raw, String] {
    let mut r = Reader { b: bytes, at: 0 };
    let mut h = read_header(mut r)?;
    let version = h.version;
    let mut time_size: i64 = 4;
    if h.version > 1 {
        // skip the version 1 data, then read the second header
        time_size = 8;
        r.skip(h.timecnt * 5 + h.typecnt * 6 + h.charcnt + h.leapcnt * 8 + h.isstdcnt + h.isutcnt);
        h = read_header(mut r)?;
    }
    let mut trans_utc: Vec[i64] = Vec.new();
    let mut trans_idx: Vec[i64] = Vec.new();
    for _ in 0..h.timecnt {
        trans_utc.push(r.int(time_size)?);
    }
    let mut most: i64 = -1;
    for _ in 0..h.timecnt {
        let i = r.byte()?;
        if i > most {
            most = i;
        }
        trans_idx.push(i);
    }
    if h.timecnt > 0 and most >= h.typecnt {
        return Err(f"Invalid transition index found while reading TZif: {most}");
    }
    let mut utcoff: Vec[i64] = Vec.new();
    let mut isdst: Vec[i64] = Vec.new();
    let mut abbrind: Vec[i64] = Vec.new();
    for _ in 0..h.typecnt {
        utcoff.push(r.int(4)?);
        isdst.push(r.signed_byte()?);
        abbrind.push(r.signed_byte()?);
    }
    let chars = r.take(h.charcnt)?;
    let mut abbr: Vec[String] = Vec.new();
    for i in 0..abbrind.len() {
        let st = abbrind[i];
        let mut e = st;
        while e < chars.len() and chars[e] != 0 {
            e += 1;
        }
        abbr.push(byte_str(chars, st, e));
    }
    let mut tz_str: Option[String] = None;
    if version >= 2 {
        r.skip(h.isutcnt + h.isstdcnt + h.leapcnt * 12);
        let nl = r.byte()?;
        if nl != 10 {
            return Err("Invalid TZif file: no newline before the footer".to_string());
        }
        let mut line: Vec[u8] = Vec.new();
        let mut ended = false;
        while r.at < r.b.len() {
            let c = r.byte()?;
            if c == 10 {
                ended = true;
                break;
            }
            line.push(c as u8);
        }
        if not ended {
            return Err("Invalid TZif file: unexpected end of file".to_string());
        }
        tz_str = Some(from_bytes(line));
    }
    Ok(Raw { version: version, trans_idx: trans_idx, trans_utc: trans_utc, utcoff: utcoff, isdst: isdst, abbr: abbr, tz_str: tz_str })
}

// ------------------------------------------------------------ TZ strings

// A _ttinfo: the offset, the DST part of it, and the name.
#[derive(Clone)]
struct Tti {
    utcoff: i64,
    dstoff: i64,
    tzname: String,
}

fn tti_eq(a: ref Tti, b: ref Tti) -> bool {
    a.utcoff == b.utcoff and a.dstoff == b.dstoff and a.tzname == b.tzname
}

// A transition day: Mm.w.d when `cal`, otherwise Jn or n.
#[derive(Clone)]
struct DayRule {
    cal: bool,
    m: i64,
    w: i64,
    d: i64,
    julian: bool,
    secs: i64,
}

// The rule after the last transition: either a fixed _ttinfo or a
// _TZStr with its two _ttinfos and its start and end.
#[derive(Clone)]
struct After {
    is_rule: bool,
    std: Tti,
    dst: Tti,
    start: DayRule,
    end: DayRule,
    dst_diff: i64,
}

fn fixed_after(t: Tti) -> After {
    let r = DayRule { cal: false, m: 0, w: 0, d: 0, julian: false, secs: 0 };
    After { is_rule: false, std: t.clone(), dst: t, start: r.clone(), end: r, dst_diff: 0 }
}

fn days_before_year(year: i64) -> i64 {
    let y = year - 1;
    y * 365 + fdiv(y, 4) - fdiv(y, 100) + fdiv(y, 400) - 719162
}

const DAYS_BEFORE_MONTH: Array[i64, 13] = [-1, 0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];

fn year_to_epoch(r: ref DayRule, year: i64) -> i64 {
    if not r.cal {
        let mut d = r.d;
        if r.julian and d >= 59 and is_leap(year) {
            d += 1;
        }
        return (days_before_year(year) + d) * 86400 + r.secs;
    }
    // calendar.monthrange counts Monday as 0; POSIX counts Sunday as 0
    let first_day = weekday(days_from_civil(year, r.m, 1));
    let mut month_day = fmod(r.d - (first_day + 1), 7) + 1;
    month_day += (r.w - 1) * 7;
    if month_day > days_in_month(year, r.m) {
        month_day -= 7;
    }
    let leap: i64 = if r.m > 2 and is_leap(year) { 1 } else { 0 };
    let ordinal = days_before_year(year) + DAYS_BEFORE_MONTH[r.m] + leap + month_day;
    ordinal * 86400 + r.secs
}

fn all_digits(b: ref Vec[u8], from: i64, to: i64) -> bool {
    if to <= from {
        return false;
    }
    for i in from..to {
        if not is_digit(b[i]) {
            return false;
        }
    }
    true
}

fn digits_val(b: ref Vec[u8], from: i64, to: i64) -> i64 {
    let mut n: i64 = 0;
    for i in from..to {
        n = n * 10 + (b[i] - b'0') as i64;
    }
    n
}

// [+-]?\d{1,3}(:\d{2}(:\d{2})?)? at b[i..], as many bytes as it takes:
// (end, sign, h, m, s), or end = -1 when nothing matches.
fn scan_hms(b: ref Vec[u8], i0: i64) -> (i64, i64, i64, i64, i64) {
    let mut i = i0;
    let mut sign: i64 = 0;
    if i < b.len() and (b[i] == b'+' or b[i] == b'-') {
        sign = if b[i] == b'-' { -1 } else { 1 };
        i += 1;
    }
    let st = i;
    while i < b.len() and is_digit(b[i]) and i - st < 3 {
        i += 1;
    }
    if i == st {
        return (-1, 0, 0, 0, 0);
    }
    let h = digits_val(b, st, i);
    let mut m: i64 = 0;
    let mut s: i64 = 0;
    if i + 3 <= b.len() and b[i] == b':' and all_digits(b, i + 1, i + 3) {
        m = digits_val(b, i + 1, i + 3);
        i += 3;
        if i + 3 <= b.len() and b[i] == b':' and all_digits(b, i + 1, i + 3) {
            s = digits_val(b, i + 1, i + 3);
            i += 3;
        }
    }
    (i, sign, h, m, s)
}

fn min_i(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

// [a-zA-Z]+ or <[a-zA-Z0-9+-]+> at b[i..]: the end, or -1.
fn scan_abbr(b: ref Vec[u8], i0: i64) -> i64 {
    let mut i = i0;
    if i < b.len() and b[i] == b'<' {
        i += 1;
        let st = i;
        while i < b.len() and (is_alnum(b[i]) or b[i] == b'+' or b[i] == b'-') {
            i += 1;
        }
        if i == st or i >= b.len() or b[i] != b'>' {
            return -1;
        }
        return i + 1;
    }
    while i < b.len() and is_alpha(b[i]) {
        i += 1;
    }
    if i == i0 { -1 } else { i }
}

fn strip_angles(s: Str) -> String {
    let b = to_bytes(s);
    let mut i: i64 = 0;
    let mut j = b.len();
    while i < j and (b[i] == b'<' or b[i] == b'>') {
        i += 1;
    }
    while j > i and (b[j - 1] == b'<' or b[j - 1] == b'>') {
        j -= 1;
    }
    byte_str(b, i, j)
}

// _parse_tz_delta: hours west become seconds east.
fn tz_delta(sign: i64, h: i64, m: i64, s: i64) -> Result[i64, String] {
    if h > 24 {
        return Err("hours".to_string());
    }
    let total = h * 3600 + m * 60 + s;
    Ok(if sign != -1 { -total } else { total })
}

fn parse_time(s: Str) -> Result[i64, String] {
    let b = to_bytes(s);
    let (e, sign, h, m, sec) = scan_hms(b, 0);
    if e != b.len() {
        return Err(f"Invalid time: {s}");
    }
    if h > 167 {
        return Err(f"Hour must be in [0, 167]: {s}");
    }
    let t = h * 3600 + m * 60 + sec;
    Ok(if sign == -1 { -t } else { t })
}

fn parse_day_rule(s: Str) -> Result[DayRule, String] {
    let (date, has_time, time) = partition(s, b'/');
    let b = to_bytes(date);
    let mut r = DayRule { cal: false, m: 0, w: 0, d: 0, julian: false, secs: 7200 };
    if first_byte(date) == b'M' {
        // M(\d{1,2})\.(\d)\.(\d)
        let mut i: i64 = 1;
        while i < b.len() and is_digit(b[i]) {
            i += 1;
        }
        if i == 1 or i > 3 or i + 4 != b.len() or b[i] != b'.' or not is_digit(b[i + 1]) or b[i + 2] != b'.' or not is_digit(b[i + 3]) {
            return Err(f"Invalid dst start/end date: {s}");
        }
        r.cal = true;
        r.m = digits_val(b, 1, i);
        r.w = (b[i + 1] - b'0') as i64;
        r.d = (b[i + 3] - b'0') as i64;
        if r.m < 1 or r.m > 12 {
            return Err("m must be in [1, 12]".to_string());
        }
        if r.w < 1 or r.w > 5 {
            return Err("w must be in [1, 5]".to_string());
        }
        if r.d < 0 or r.d > 6 {
            return Err("d must be in [0, 6]".to_string());
        }
    } else {
        let mut st: i64 = 0;
        if first_byte(date) == b'J' {
            r.julian = true;
            st = 1;
        }
        if b.len() - st > 3 or not all_digits(b, st, b.len()) {
            return Err(f"Invalid dst start/end date: {s}");
        }
        r.d = digits_val(b, st, b.len());
        let min_day: i64 = if r.julian { 1 } else { 0 };
        if r.d < min_day or r.d > 365 {
            return Err(f"d must be in [{min_day}, 365], not: {r.d}");
        }
    }
    if has_time {
        r.secs = parse_time(time)?;
    }
    Ok(r)
}

// _parse_tz_str
fn parse_tz_str(s: Str) -> Result[After, String] {
    let (offset_str, has_rules, rules) = partition(s, b',');
    let b = to_bytes(offset_str);
    let bad = f"{s} is not a valid TZ string";
    let e1 = scan_abbr(b, 0);
    if e1 < 0 {
        return Err(bad);
    }
    let std_abbr = strip_angles(byte_str(b, 0, e1));
    let mut std_off: i64 = 0;
    let mut has_std_off = false;
    let mut dst_abbr = String.new();
    let mut has_dst = false;
    let mut dst_off: i64 = 0;
    let mut has_dst_off = false;
    let mut i = e1;
    if i < b.len() {
        let (e2, sg, h, m, sec) = scan_hms(b, i);
        if e2 < 0 {
            return Err(bad);
        }
        has_std_off = true;
        std_off = match tz_delta(sg, h, m, sec) {
            Ok(v) => v,
            Err(_) => return Err(f"Invalid STD offset in {s}"),
        };
        i = e2;
        if i < b.len() {
            let e3 = scan_abbr(b, i);
            if e3 < 0 {
                return Err(bad);
            }
            dst_abbr = strip_angles(byte_str(b, i, e3));
            has_dst = true;
            i = e3;
            if i < b.len() {
                let (e4, sg2, h2, m2, sec2) = scan_hms(b, i);
                if e4 != b.len() {
                    return Err(bad);
                }
                has_dst_off = true;
                dst_off = match tz_delta(sg2, h2, m2, sec2) {
                    Ok(v) => v,
                    Err(_) => return Err(f"Invalid DST offset in {s}"),
                };
            }
        }
    }
    if not has_std_off {
        return Err(f"Invalid STD offset in {s}");
    }
    if has_dst {
        if not has_dst_off {
            dst_off = std_off + 3600;
        }
        if not has_rules {
            return Err(f"Missing transition rules: {s}");
        }
        let (a, two, c) = partition(rules, b',');
        if not two {
            return Err(f"Invalid TZ string: {s}");
        }
        let start = match parse_day_rule(a) {
            Ok(r) => r,
            Err(_) => return Err(f"Invalid TZ string: {s}"),
        };
        let end = match parse_day_rule(c) {
            Ok(r) => r,
            Err(_) => return Err(f"Invalid TZ string: {s}"),
        };
        let diff = dst_off - std_off;
        return Ok(After {
            is_rule: true,
            std: Tti { utcoff: std_off, dstoff: 0, tzname: std_abbr },
            dst: Tti { utcoff: dst_off, dstoff: diff, tzname: dst_abbr },
            start: start,
            end: end,
            dst_diff: diff,
        });
    }
    if has_rules {
        return Err(f"Transition rule present without DST: {s}");
    }
    Ok(fixed_after(Tti { utcoff: std_off, dstoff: 0, tzname: std_abbr }))
}

fn transitions(a: ref After, year: i64) -> (i64, i64) {
    (year_to_epoch(a.start, year), year_to_epoch(a.end, year))
}

fn rule_info(a: ref After, ts: i64, year: i64, fold: i64) -> Tti {
    let (s0, e0) = transitions(a, year);
    let mut start = s0;
    let mut end = e0;
    if (fold == 1) == (a.dst_diff >= 0) {
        end -= a.dst_diff;
    } else {
        start += a.dst_diff;
    }
    let isdst = if start < end { start <= ts and ts < end } else { not (end <= ts and ts < start) };
    if isdst { a.dst.clone() } else { a.std.clone() }
}

fn rule_info_fromutc(a: ref After, ts: i64, year: i64) -> (Tti, bool) {
    let (s0, e0) = transitions(a, year);
    let start = s0 - a.std.utcoff;
    let end = e0 - a.dst.utcoff;
    let isdst = if start < end { start <= ts and ts < end } else { not (end <= ts and ts < start) };
    let (lo, hi) = if a.dst_diff > 0 { (end, end + a.dst_diff) } else { (start, start - a.dst_diff) };
    let fold = lo <= ts and ts < hi;
    (if isdst { a.dst.clone() } else { a.std.clone() }, fold)
}

// ------------------------------------------------------------ the zone

#[derive(Clone)]
struct Zone {
    key: String,
    trans_utc: Vec[i64],
    // the transitions in local time, for fold 0 and for fold 1
    local0: Vec[i64],
    local1: Vec[i64],
    // the _ttinfo each transition starts
    ttinfos: Vec[Tti],
    before: Option[Tti],
    after: After,
}

// ZoneInfo._utcoff_to_dstoff
fn utcoff_to_dstoff(trans_idx: ref Vec[i64], utcoffsets: ref Vec[i64], isdsts: ref Vec[i64]) -> Vec[i64] {
    let typecnt = isdsts.len();
    let mut dstoffs: Vec[i64] = Vec.new();
    let mut dst_cnt: i64 = 0;
    for i in 0..typecnt {
        dstoffs.push(0);
        if isdsts[i] != 0 {
            dst_cnt += 1;
        }
    }
    let mut dst_found: i64 = 0;
    let mut broke = false;
    for i in 1..trans_idx.len() {
        if dst_cnt == dst_found {
            broke = true;
            break;
        }
        let idx = trans_idx[i];
        if isdsts[idx] == 0 {
            continue;
        }
        if dstoffs[idx] != 0 {
            continue;
        }
        let mut dstoff: i64 = 0;
        let utcoff = utcoffsets[idx];
        let mut comp_idx = trans_idx[i - 1];
        if isdsts[comp_idx] == 0 {
            dstoff = utcoff - utcoffsets[comp_idx];
        }
        if dstoff == 0 and idx < typecnt - 1 and i + 1 < trans_idx.len() {
            comp_idx = trans_idx[i + 1];
            if isdsts[comp_idx] != 0 {
                continue;
            }
            dstoff = utcoff - utcoffsets[comp_idx];
        }
        if dstoff != 0 {
            dst_found += 1;
            dstoffs[idx] = dstoff;
        }
    }
    if not broke {
        // a DST type with no offset found gets one hour
        for idx in 0..typecnt {
            if dstoffs[idx] == 0 and isdsts[idx] != 0 {
                dstoffs[idx] = 3600;
            }
        }
    }
    dstoffs
}

// ZoneInfo._ts_to_local: the larger offset for fold 0, the smaller for 1.
fn ts_to_local(trans_idx: ref Vec[i64], trans_utc: ref Vec[i64], utcoffsets: ref Vec[i64], fold: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    if trans_utc.len() == 0 {
        return out;
    }
    for i in 0..trans_idx.len() {
        let mut a: i64 = 0;
        let mut b: i64 = 0;
        if i == 0 {
            if utcoffsets.len() > 1 {
                a = utcoffsets[0];
                b = utcoffsets[trans_idx[0]];
            } else {
                a = utcoffsets[0];
                b = utcoffsets[0];
            }
        } else {
            a = utcoffsets[trans_idx[i - 1]];
            b = utcoffsets[trans_idx[i]];
        }
        let hi = if a > b { a } else { b };
        let lo = if a > b { b } else { a };
        out.push(trans_utc[i] + if fold == 0 { hi } else { lo });
    }
    out
}

fn load_zone(key: Str, raw: ref Raw) -> Result[Zone, String] {
    let dstoff = utcoff_to_dstoff(raw.trans_idx, raw.utcoff, raw.isdst);
    let mut list: Vec[Tti] = Vec.new();
    for i in 0..raw.utcoff.len() {
        list.push(Tti { utcoff: raw.utcoff[i], dstoff: dstoff[i], tzname: raw.abbr[i].clone() });
    }
    let mut ttinfos: Vec[Tti] = Vec.new();
    for i in 0..raw.trans_idx.len() {
        ttinfos.push(list[raw.trans_idx[i]].clone());
    }
    // the first standard-time type
    let mut before: Option[Tti] = None;
    for i in 0..raw.isdst.len() {
        if raw.isdst[i] == 0 {
            before = Some(list[i].clone());
            break;
        }
    }
    if before.is_none() and ttinfos.len() > 0 {
        before = Some(ttinfos[0].clone());
    }
    let footer = raw.tz_str.clone().unwrap_or(String.new());
    let after = if footer.len() > 0 {
        parse_tz_str(footer)?
    } else {
        if ttinfos.len() == 0 and list.len() == 0 {
            return Err("No time zone information found.".to_string());
        }
        if ttinfos.len() > 0 {
            fixed_after(ttinfos[ttinfos.len() - 1].clone())
        } else {
            fixed_after(list[list.len() - 1].clone())
        }
    };
    Ok(Zone {
        key: key.to_string(),
        trans_utc: raw.trans_utc.clone(),
        local0: ts_to_local(raw.trans_idx, raw.trans_utc, raw.utcoff, 0),
        local1: ts_to_local(raw.trans_idx, raw.trans_utc, raw.utcoff, 1),
        ttinfos: ttinfos,
        before: before,
        after: after,
    })
}

// bisect.bisect_right
fn bisect_right(v: ref Vec[i64], x: i64) -> i64 {
    let mut lo: i64 = 0;
    let mut hi = v.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if x < v[mid] {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    lo
}

fn before_tti(z: ref Zone) -> Tti {
    match z.before.clone() {
        Some(t) => t,
        None => Tti { utcoff: 0, dstoff: 0, tzname: String.new() },
    }
}

// ZoneInfo._find_trans: the _ttinfo in force at a local time.
fn find_trans(z: ref Zone, ts: i64, fold: i64) -> Tti {
    let lt = if fold == 0 { z.local0.clone() } else { z.local1.clone() };
    let n = lt.len();
    if n > 0 and ts < lt[0] {
        return before_tti(z);
    }
    if n == 0 or ts > lt[n - 1] {
        if z.after.is_rule {
            return rule_info(z.after, ts, year_of(ts), fold);
        }
        return z.after.std.clone();
    }
    let idx = bisect_right(lt, ts) - 1;
    z.ttinfos[idx].clone()
}

// ZoneInfo.fromutc: the _ttinfo in force at a UTC time, and the fold of
// the local time it gives.
fn from_utc(z: ref Zone, ts: i64) -> (Tti, bool) {
    let n = z.trans_utc.len();
    if n >= 1 and ts < z.trans_utc[0] {
        return (before_tti(z), false);
    }
    if (n == 0 or ts > z.trans_utc[n - 1]) and z.after.is_rule {
        return rule_info_fromutc(z.after, ts, year_of(ts));
    }
    if n == 0 {
        return (z.after.std.clone(), false);
    }
    let idx = bisect_right(z.trans_utc, ts);
    let mut prev = before_tti(z);
    let mut tti = z.ttinfos[0].clone();
    if n > 1 and ts >= z.trans_utc[1] {
        prev = z.ttinfos[idx - 2].clone();
        tti = z.ttinfos[idx - 1].clone();
    } else if ts > z.trans_utc[n - 1] {
        prev = z.ttinfos[n - 1].clone();
        tti = z.after.std.clone();
    }
    let shift = prev.utcoff - tti.utcoff;
    let fold = shift > ts - z.trans_utc[idx - 1];
    (tti, fold)
}

