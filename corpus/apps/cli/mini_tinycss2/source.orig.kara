// mini_tinycss2: tinycss2 1.4.0, the CSS Syntax Level 3 parser that
// WeasyPrint, bleach's CSS sanitizer and many HTML-to-PDF and e-mail
// tools use to read stylesheets.
//
// The port covers the tokenizer (with its line and column bookkeeping),
// the parsers (component values, declarations, blocks contents, rules,
// stylesheets), serialization (with the token pairs that need a "/**/"
// between them), An+B parsing for :nth-child(), CSS Color Level 3 and
// Level 4 (keywords, hex, rgb, hsl, hwb, lab, lch, oklab, oklch,
// color(), and the conversions tinycss2 implements), and
// parse_stylesheet_bytes with webencodings' labels, BOM sniffing and
// @charset rules.
//
// The run works through the css-parsing-tests suites (the CC0 test
// data tinycss2 and rust-cssparser share) as tinycss2's own test module
// does, then audits six stylesheets: rules, declarations, colors,
// contrast, :nth-child() arguments, custom properties, URLs and a
// minified copy. expected.out is oracle.py's output, which runs the
// same through tinycss2 itself.

// ---------------------------------------------------------------- strings

fn char_of(cp: i64) -> char {
    char.try_from(cp as u32).unwrap_or('\u{fffd}')
}

fn chars_of(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn slice(v: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut out = String.new();
    let mut i = lo;
    while i < hi {
        out.push(v[i]);
        i += 1;
    }
    out
}

fn at(v: ref Vec[char], pos: i64, c: char) -> bool {
    pos >= 0 and pos < v.len() and v[pos] == c
}

// css.startswith(s, pos)
fn starts(v: ref Vec[char], pos: i64, s: Str) -> bool {
    let mut i = pos;
    for c in s.chars() {
        if i >= v.len() or v[i] != c {
            return false;
        }
        i += 1;
    }
    true
}

fn in_set(c: char, set: Str) -> bool {
    for x in set.chars() {
        if x == c {
            return true;
        }
    }
    false
}

fn is_hex(c: char) -> bool {
    (c >= '0' and c <= '9') or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F')
}

fn hex_val(c: char) -> i64 {
    if c >= '0' and c <= '9' {
        c as i64 - 48
    } else if c >= 'a' and c <= 'f' {
        c as i64 - 87
    } else {
        c as i64 - 55
    }
}

// int(s, 16), saturating past any code point.
fn hex_int(s: ref String) -> i64 {
    let mut v: i64 = 0;
    for c in s.chars() {
        if v < 0x1000000 {
            v = v * 16 + hex_val(c);
        }
    }
    v
}

// webencodings.ascii_lower: only A-Z change.
fn ascii_lower(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c >= 'A' and c <= 'Z' {
            out.push(((c as u32) + 32) as u8 as char);
        } else {
            out.push(c);
        }
    }
    out
}

fn char_count(s: ref String) -> i64 {
    s.chars().count()
}

fn hex_upper(v: i64) -> String {
    let digits = "0123456789ABCDEF";
    let ds: Vec[char] = digits.chars().collect();
    if v == 0 {
        return "0".to_string();
    }
    let mut out: Vec[char] = Vec.new();
    let mut n = v;
    while n > 0 {
        out.push(ds[n % 16]);
        n = n / 16;
    }
    let mut s = String.new();
    let mut i = out.len() - 1;
    while i >= 0 {
        s.push(out[i]);
        i -= 1;
    }
    s
}

fn hex2_lower(v: i64) -> String {
    let ds: Vec[char] = "0123456789abcdef".chars().collect();
    let mut s = String.new();
    s.push(ds[(v / 16) % 16]);
    s.push(ds[v % 16]);
    s
}

fn pad_left(s: ref String, width: i64) -> String {
    let mut out = String.new();
    let mut n = char_count(s);
    while n < width {
        out.push(' ');
        n += 1;
    }
    out.push_str(s);
    out
}

// int() of ASCII digits with an optional sign, saturating: the suites'
// integers are far below the limit, which Python's int has none of.
fn py_int(s: ref String) -> i64 {
    let mut n: i64 = 0;
    let mut neg = false;
    for c in s.chars() {
        if c == '-' {
            neg = true;
        } else if c >= '0' and c <= '9' {
            if n < 100000000000000 {
                n = n * 10 + (c as i64 - 48);
            }
        }
    }
    if neg { 0 - n } else { n }
}

// ---------------------------------------------------------------- floats

fn is_nan(x: f64) -> bool {
    x != x
}

fn is_finite(x: f64) -> bool {
    x - x == 0.0
}

// repr() of a float.
fn py_float(x: f64) -> String {
    if is_nan(x) {
        return "nan".to_string();
    }
    f"{x}"
}

// Python's float %: the result has the sign of the divisor.
fn py_mod(x: f64, y: f64) -> f64 {
    let m = x % y;
    if m != 0.0 {
        if (y < 0.0) != (m < 0.0) {
            return m + y;
        }
        return m;
    }
    0.0.copysign(y)
}

// round(x, 6): the correctly rounded decimal, read back.
fn py_round6(x: f64) -> f64 {
    if not is_finite(x) {
        return x;
    }
    let s = f"{x:.6}";
    f64.parse(s).unwrap_or(x)
}

// max(a, b) and min(a, b) keep the first argument unless the second is
// strictly greater (smaller), so a NaN second argument loses.
fn py_max(a: f64, b: f64) -> f64 {
    if b > a { b } else { a }
}

fn py_min(a: f64, b: f64) -> f64 {
    if b < a { b } else { a }
}

// str(int(v)) of an integral float.
fn int_text(v: f64) -> String {
    if v == 0.0 {
        return "0".to_string();
    }
    f"{v:.0}"
}

fn is_integer(v: f64) -> bool {
    is_finite(v) and v.floor() == v
}

// sum() of floats since Python 3.12: Neumaier's compensated sum, with
// the first item as the start (0 + x).
fn py_sum(xs: ref Vec[f64]) -> f64 {
    if xs.is_empty() {
        return 0.0;
    }
    let mut f = 0.0 + xs[0];
    let mut c = 0.0;
    let mut i = 1;
    while i < xs.len() {
        let x = xs[i];
        let t = f + x;
        if f.abs() >= x.abs() {
            c += (f - t) + x;
        } else {
            c += (x - t) + f;
        }
        f = t;
        i += 1;
    }
    if c != 0.0 and is_finite(c) {
        f += c;
    }
    f
}

fn radians(x: f64) -> f64 {
    x * (3.141592653589793 / 180.0)
}

fn degrees(x: f64) -> f64 {
    x * (180.0 / 3.141592653589793)
}

// ---------------------------------------------------------------- errors

#[derive(Clone)]
struct PyErr {
    ty: String,
    msg: String,
}

fn py_err(ty: Str, msg: Str) -> PyErr {
    PyErr { ty: ty.to_string(), msg: msg.to_string() }
}

// ---------------------------------------------------------------- json

// A JSON value, as json.load reads one and as json.dumps writes one.
#[derive(Clone)]
enum J {
    Null,
    Bool(bool),
    Int(i64),
    Float(f64),
    Text(String),
    Arr(Vec[J]),
    Obj(Vec[(String, J)]),
}

struct JsonIn {
    cs: Vec[char],
    pos: i64,
}

impl JsonIn {
    fn ws(mut ref self) {
        while self.pos < self.cs.len() and in_set(self.cs[self.pos], " \n\t\r") {
            self.pos += 1;
        }
    }

    fn hex4(mut ref self) -> i64 {
        let mut v: i64 = 0;
        let mut k = 0;
        while k < 4 {
            v = v * 16 + hex_val(self.cs[self.pos]);
            self.pos += 1;
            k += 1;
        }
        v
    }

    fn text(mut ref self) -> String {
        self.pos += 1;
        let mut out = String.new();
        loop {
            let c = self.cs[self.pos];
            self.pos += 1;
            if c == '"' {
                return out;
            }
            if c != '\\' {
                out.push(c);
                continue;
            }
            let e = self.cs[self.pos];
            self.pos += 1;
            if e == 'n' {
                out.push('\n');
            } else if e == 't' {
                out.push('\t');
            } else if e == 'r' {
                out.push('\r');
            } else if e == 'b' {
                out.push('\u{8}');
            } else if e == 'f' {
                out.push('\u{c}');
            } else if e == 'u' {
                let mut v = self.hex4();
                if v >= 0xD800 and v < 0xDC00 and starts(self.cs, self.pos, "\\u") {
                    self.pos += 2;
                    let w = self.hex4();
                    v = 0x10000 + ((v - 0xD800) << 10) + (w - 0xDC00);
                }
                out.push(char_of(v));
            } else {
                out.push(e);
            }
        }
    }

    fn value(mut ref self) -> J {
        self.ws();
        let c = self.cs[self.pos];
        if c == '"' {
            return J.Text(self.text());
        }
        if c == '{' {
            self.pos += 1;
            let mut items: Vec[(String, J)] = Vec.new();
            loop {
                self.ws();
                if self.cs[self.pos] == '}' {
                    self.pos += 1;
                    return J.Obj(items);
                }
                if self.cs[self.pos] == ',' {
                    self.pos += 1;
                    self.ws();
                }
                let k = self.text();
                self.ws();
                self.pos += 1;
                let v = self.value();
                items.push((k, v));
            }
        }
        if c == '[' {
            self.pos += 1;
            let mut items: Vec[J] = Vec.new();
            loop {
                self.ws();
                if self.cs[self.pos] == ']' {
                    self.pos += 1;
                    return J.Arr(items);
                }
                if self.cs[self.pos] == ',' {
                    self.pos += 1;
                }
                items.push(self.value());
            }
        }
        if starts(self.cs, self.pos, "null") {
            self.pos += 4;
            return J.Null;
        }
        if starts(self.cs, self.pos, "true") {
            self.pos += 4;
            return J.Bool(true);
        }
        if starts(self.cs, self.pos, "false") {
            self.pos += 5;
            return J.Bool(false);
        }
        let start = self.pos;
        let mut float = false;
        while self.pos < self.cs.len() and in_set(self.cs[self.pos], "+-0123456789.eE") {
            if in_set(self.cs[self.pos], ".eE") {
                float = true;
            }
            self.pos += 1;
        }
        let text = slice(self.cs, start, self.pos);
        if float {
            J.Float(f64.parse(text).unwrap_or(0.0))
        } else {
            J.Int(py_int(text))
        }
    }
}

fn parse_json(text: ref String) -> J {
    let mut p = JsonIn { cs: chars_of(text), pos: 0 };
    p.value()
}

fn jget(j: ref J, key: Str) -> J {
    if let J.Obj(items) = j {
        for (k, v) in items.iter() {
            if k == key {
                return v.clone();
            }
        }
    }
    J.Null
}

fn jtext(j: ref J) -> Option[String] {
    if let J.Text(s) = j {
        return Some(s.clone());
    }
    None
}

fn push_u4(out: mut ref String, v: i64) {
    out.push_str("\\u");
    out.push_str(hex2_lower(v / 256));
    out.push_str(hex2_lower(v % 256));
}

// json.dumps of a string (ensure_ascii).
fn json_str(s: ref String) -> String {
    let mut out = String.new();
    out.push('"');
    for c in s.chars() {
        let o = c as i64;
        if c == '"' {
            out.push_str("\\\"");
        } else if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\u{8}' {
            out.push_str("\\b");
        } else if c == '\u{c}' {
            out.push_str("\\f");
        } else if o < 32 or (o >= 127 and o < 0x10000) {
            push_u4(mut out, o);
        } else if o >= 0x10000 {
            let v = o - 0x10000;
            push_u4(mut out, 0xD800 + (v >> 10));
            push_u4(mut out, 0xDC00 + (v & 0x3FF));
        } else {
            out.push(c);
        }
    }
    out.push('"');
    out
}

fn json_float(x: f64) -> String {
    if is_nan(x) {
        return "NaN".to_string();
    }
    if not is_finite(x) {
        return if x > 0.0 { "Infinity".to_string() } else { "-Infinity".to_string() };
    }
    f"{x}"
}

fn dumps_to(j: ref J, out: mut ref String) {
    match j {
        J.Null => out.push_str("null"),
        J.Bool(b) => out.push_str(if *b { "true" } else { "false" }),
        J.Int(n) => out.push_str(f"{n}"),
        J.Float(x) => out.push_str(json_float(*x)),
        J.Text(s) => out.push_str(json_str(s)),
        J.Arr(items) => {
            out.push('[');
            let mut first = true;
            for x in items.iter() {
                if not first {
                    out.push_str(", ");
                }
                first = false;
                dumps_to(x, mut out);
            }
            out.push(']');
        }
        J.Obj(items) => {
            out.push('{');
            let mut first = true;
            for (k, v) in items.iter() {
                if not first {
                    out.push_str(", ");
                }
                first = false;
                out.push_str(json_str(k));
                out.push_str(": ");
                dumps_to(v, mut out);
            }
            out.push('}');
        }
    }
}

fn dumps(j: ref J) -> String {
    let mut out = String.new();
    dumps_to(j, mut out);
    out
}

// A number as Python compares it: bools are 0 and 1.
fn num_of(j: ref J) -> Option[f64] {
    match j {
        J.Bool(b) => Some(if *b { 1.0 } else { 0.0 }),
        J.Int(n) => Some(*n as f64),
        J.Float(x) => Some(*x),
        _ => None,
    }
}

// Python's == on the values json.load and to_json() build.
fn json_eq(a: ref J, b: ref J) -> bool {
    if let Some(x) = num_of(a) {
        if let Some(y) = num_of(b) {
            return x == y;
        }
        return false;
    }
    match (a, b) {
        (J.Null, J.Null) => true,
        (J.Text(x), J.Text(y)) => x == y,
        (J.Arr(x), J.Arr(y)) => {
            if x.len() != y.len() {
                return false;
            }
            let mut i = 0;
            while i < x.len() {
                if not json_eq(x[i], y[i]) {
                    return false;
                }
                i += 1;
            }
            true
        }
        (J.Obj(x), J.Obj(y)) => {
            if x.len() != y.len() {
                return false;
            }
            for (k, v) in x.iter() {
                if not json_eq(v, jget(b, k)) {
                    return false;
                }
            }
            true
        }
        _ => false,
    }
}

fn text_j(s: Str) -> J {
    J.Text(s.to_string())
}

// ---------------------------------------------------------------- ast

// One node of tinycss2.ast. `ty` is the node's `type` attribute
// ("ident", "() block", "qualified-rule", ...); the other fields hold
// whichever attributes that type has:
//   value    the value, a name (function, declaration, at-keyword) or an
//            error's kind
//   lower    lower_value, lower_name or lower_at_keyword
//   repr     representation (numbers, strings, URLs)
//   unit     a dimension's unit; message an error's message
//   kids     a block's content, a function's arguments, a declaration's
//            value or a rule's prelude
//   content  a qualified rule's or an at-rule's {} block content
//   flag     is_identifier (hash) or important (declaration)
#[derive(Clone)]
struct Node {
    ty: String,
    line: i64,
    col: i64,
    value: String,
    lower: String,
    repr: String,
    unit: String,
    message: String,
    num: f64,
    ival: Option[i64],
    start: i64,
    end: i64,
    flag: bool,
    kids: Vec[Node],
    content: Option[Vec[Node]],
}

fn node(ty: Str, line: i64, col: i64) -> Node {
    Node {
        ty: ty.to_string(),
        line: line,
        col: col,
        value: String.new(),
        lower: String.new(),
        repr: String.new(),
        unit: String.new(),
        message: String.new(),
        num: 0.0,
        ival: None,
        start: 0,
        end: 0,
        flag: false,
        kids: Vec.new(),
        content: None,
    }
}

fn valued(ty: Str, line: i64, col: i64, value: ref String) -> Node {
    let mut n = node(ty, line, col);
    n.value = value.clone();
    n
}

fn literal(line: i64, col: i64, value: Str) -> Node {
    valued("literal", line, col, value.to_string())
}

fn parse_error(line: i64, col: i64, kind: Str, message: Str) -> Node {
    let mut n = node("error", line, col);
    n.value = kind.to_string();
    n.message = message.to_string();
    n
}

// IdentToken, AtKeywordToken and FunctionBlock keep the ASCII-lowered
// value too.
fn lowered(ty: Str, line: i64, col: i64, value: ref String) -> Node {
    let mut n = valued(ty, line, col, value);
    n.lower = ascii_lower(value);
    n
}

// token == 'x' (LiteralToken.__eq__ compares the value; every other node
// compares by identity, so never equals a string).
fn is_lit(t: ref Node, s: Str) -> bool {
    t.ty == "literal" and t.value == s
}

fn is_blank(t: ref Node) -> bool {
    t.ty == "whitespace" or t.ty == "comment"
}

// ---------------------------------------------------------------- tokenizer

// The error of a consume_* helper: (kind, message).
type TokErr = Option[(String, String)];

fn tok_err(kind: Str, message: Str) -> TokErr {
    Some((kind.to_string(), message.to_string()))
}

struct Frame {
    tokens: Vec[Node],
    end_char: Option[char],
    block: Node,
}

fn is_ws(c: char) -> bool {
    c == ' ' or c == '\n' or c == '\t'
}

fn skip_ws(css: ref Vec[char], pos: i64) -> i64 {
    let mut p = pos;
    while p < css.len() and is_ws(css[p]) {
        p += 1;
    }
    p
}

fn is_name_char(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '-' or c == '_' or (c as i64) > 0x7F
}

// https://www.w3.org/TR/css-syntax-3/#name-start-code-point
fn is_name_start(css: ref Vec[char], pos: i64) -> bool {
    let c = css[pos];
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_' or (c as i64) > 0x7F
}

// https://drafts.csswg.org/css-syntax/#would-start-an-identifier
fn is_ident_start(css: ref Vec[char], pos: i64) -> bool {
    if is_name_start(css, pos) {
        return true;
    }
    if css[pos] == '-' {
        let p = pos + 1;
        return (p < css.len() and (is_name_start(css, p) or css[p] == '-'))
            or (starts(css, p, "\\") and not starts(css, p, "\\\n"));
    }
    if css[pos] == '\\' {
        return not starts(css, pos, "\\\n");
    }
    false
}

// http://dev.w3.org/csswg/css-syntax/#consume-a-name
fn consume_ident(css: ref Vec[char], pos0: i64) -> (String, i64) {
    let mut out = String.new();
    let mut pos = pos0;
    let mut start = pos;
    while pos < css.len() {
        let c = css[pos];
        if is_name_char(c) {
            pos += 1;
        } else if c == '\\' and not starts(css, pos, "\\\n") {
            out.push_str(slice(css, start, pos));
            let (ch, p) = consume_escape(css, pos + 1);
            out.push(ch);
            pos = p;
            start = pos;
        } else {
            break;
        }
    }
    out.push_str(slice(css, start, pos));
    (out, pos)
}

// https://drafts.csswg.org/css-syntax/#consume-a-string-token
fn consume_quoted_string(css: ref Vec[char], pos0: i64) -> (Option[String], i64, TokErr) {
    let quote = css[pos0];
    let mut pos = pos0 + 1;
    let mut out = String.new();
    let length = css.len();
    let mut start = pos;
    while pos < length {
        let c = css[pos];
        if c == quote {
            out.push_str(slice(css, start, pos));
            pos += 1;
            return (Some(out), pos, None);
        } else if c == '\\' {
            out.push_str(slice(css, start, pos));
            pos += 1;
            if pos < length {
                if css[pos] == '\n' {
                    pos += 1;
                } else {
                    let (ch, p) = consume_escape(css, pos);
                    out.push(ch);
                    pos = p;
                }
            }
            start = pos;
        } else if c == '\n' {
            return (None, pos, tok_err("bad-string", "Bad string token"));
        } else {
            pos += 1;
        }
    }
    out.push_str(slice(css, start, pos));
    (Some(out), pos, tok_err("eof-in-string", "EOF in string"))
}

// https://drafts.csswg.org/css-syntax/#consume-an-escaped-character
// pos is just after the backslash. A code point of 0, a surrogate or one
// past U+10FFFF is U+FFFD (CPython would keep a lone surrogate, which a
// Kāra String cannot hold).
fn consume_escape(css: ref Vec[char], pos: i64) -> (char, i64) {
    let mut p = pos;
    while p < css.len() and p - pos < 6 and is_hex(css[p]) {
        p += 1;
    }
    if p > pos {
        let cp = hex_int(slice(css, pos, p));
        if p < css.len() and is_ws(css[p]) {
            p += 1;
        }
        let ch = if cp > 0 and cp <= 0x10FFFF { char_of(cp) } else { '\u{fffd}' };
        return (ch, p);
    }
    if pos < css.len() {
        return (css[pos], pos + 1);
    }
    ('\u{fffd}', pos)
}

// https://drafts.csswg.org/css-syntax/#non-printable-character, and the
// characters that end an unquoted URL badly.
fn bad_url_char(c: char) -> bool {
    let o = c as i64;
    c == '"' or c == '\'' or c == '(' or o <= 8 or o == 0xB or (o >= 0xE and o <= 0x1F) or o == 0x7F
}

// https://drafts.csswg.org/css-syntax/#consume-a-url-token
// pos is just after the "(" of "url(".
fn consume_url(css: ref Vec[char], pos0: i64) -> (Option[String], i64, TokErr) {
    let length = css.len();
    let mut error: TokErr = None;
    let mut pos = skip_ws(css, pos0);
    if pos >= length {
        return (Some(String.new()), pos, tok_err("eof-in-url", "EOF in URL"));
    }
    let c = css[pos];
    let mut value: Option[String] = None;
    if c == '"' or c == '\'' {
        let (v, p, e) = consume_quoted_string(css, pos);
        value = v;
        pos = p;
        error = e;
    } else if c == ')' {
        return (Some(String.new()), pos + 1, error);
    } else {
        let mut out = String.new();
        let mut start = pos;
        loop {
            if pos >= length {
                out.push_str(slice(css, start, pos));
                return (Some(out), pos, tok_err("eof-in-url", "EOF in URL"));
            }
            let c = css[pos];
            if c == ')' {
                out.push_str(slice(css, start, pos));
                pos += 1;
                return (Some(out), pos, error);
            } else if is_ws(c) {
                out.push_str(slice(css, start, pos));
                value = Some(out.clone());
                pos += 1;
                break;
            } else if c == '\\' and not starts(css, pos, "\\\n") {
                out.push_str(slice(css, start, pos));
                let (ch, p) = consume_escape(css, pos + 1);
                out.push(ch);
                pos = p;
                start = pos;
            } else if bad_url_char(c) {
                value = None;
                pos += 1;
                break;
            } else {
                pos += 1;
            }
        }
    }
    if value.is_some() {
        pos = skip_ws(css, pos);
        if pos < length {
            if css[pos] == ')' {
                return (value, pos + 1, error);
            }
        } else {
            if error.is_none() {
                error = tok_err("eof-in-url", "EOF in URL");
            }
            return (value, pos, error);
        }
    }
    // https://drafts.csswg.org/css-syntax/#consume-the-remnants-of-a-bad-url0
    while pos < length {
        if starts(css, pos, "\\)") {
            pos += 2;
        } else if css[pos] == ')' {
            pos += 1;
            break;
        } else {
            pos += 1;
        }
    }
    (None, pos, tok_err("bad-url", "bad URL token"))
}

// https://drafts.csswg.org/css-syntax/#consume-a-unicode-range-token
// pos is just after the "+" of "U+".
fn consume_unicode_range(css: ref Vec[char], pos0: i64) -> (i64, i64, i64) {
    let length = css.len();
    let mut pos = pos0;
    let mut start_pos = pos;
    let mut max_pos = if pos + 6 < length { pos + 6 } else { length };
    while pos < max_pos and is_hex(css[pos]) {
        pos += 1;
    }
    let mut start = slice(css, start_pos, pos);
    start_pos = pos;
    while pos < max_pos and css[pos] == '?' {
        pos += 1;
    }
    let question_marks = pos - start_pos;
    let mut end = String.new();
    if question_marks > 0 {
        end = start.clone();
        let mut k = 0;
        while k < question_marks {
            end.push('F');
            start.push('0');
            k += 1;
        }
    } else if pos + 1 < length and css[pos] == '-' and is_hex(css[pos + 1]) {
        pos += 1;
        start_pos = pos;
        max_pos = if pos + 6 < length { pos + 6 } else { length };
        while pos < max_pos and is_hex(css[pos]) {
            pos += 1;
        }
        end = slice(css, start_pos, pos);
    } else {
        end = start.clone();
    }
    (hex_int(start), hex_int(end), pos)
}

// _NUMBER_RE = [-+]?([0-9]*\.)?[0-9]+([eE][+-]?[0-9]+)? at pos: the end
// of the match, and whether either group matched.
fn match_number(css: ref Vec[char], pos: i64) -> Option[(i64, bool)] {
    let n = css.len();
    let mut p = pos;
    if p < n and (css[p] == '+' or css[p] == '-') {
        p += 1;
    }
    let mut q = p;
    while q < n and css[q] >= '0' and css[q] <= '9' {
        q += 1;
    }
    let mut groups = false;
    let mut end = 0;
    if q < n and css[q] == '.' and q + 1 < n and css[q + 1] >= '0' and css[q + 1] <= '9' {
        groups = true;
        end = q + 1;
        while end < n and css[end] >= '0' and css[end] <= '9' {
            end += 1;
        }
    } else if q > p {
        end = q;
    } else {
        return None;
    }
    if end < n and (css[end] == 'e' or css[end] == 'E') {
        let mut e = end + 1;
        if e < n and (css[e] == '+' or css[e] == '-') {
            e += 1;
        }
        let digits = e;
        while e < n and css[e] >= '0' and css[e] <= '9' {
            e += 1;
        }
        if e > digits {
            end = e;
            groups = true;
        }
    }
    Some((end, groups))
}

fn drop_last(s: ref String, k: i64) -> String {
    let cs = chars_of(s);
    slice(cs, 0, cs.len() - k)
}

fn numeric(ty: Str, line: i64, col: i64, value: f64, ival: Option[i64], repr: ref String) -> Node {
    let mut t = node(ty, line, col);
    t.num = value;
    t.ival = ival;
    t.repr = repr.clone();
    t
}

fn open_block(stack: mut ref Vec[Frame], tokens: mut ref Vec[Node], end_char: mut ref Option[char], block: own Node, close: char) {
    let parent = mem.replace(mut tokens, Vec.new());
    stack.push(Frame { tokens: parent, end_char: *end_char, block: block });
    *end_char = Some(close);
}

fn close_block(stack: mut ref Vec[Frame], tokens: mut ref Vec[Node], end_char: mut ref Option[char]) {
    let f = stack.pop().unwrap();
    let mut block = f.block;
    block.kids = mem.replace(mut tokens, f.tokens);
    tokens.push(block);
    *end_char = f.end_char;
}

// tinycss2.parse_component_value_list
fn parse_component_value_list(source: ref String, skip_comments: bool) -> Vec[Node] {
    let mut css: Vec[char] = Vec.new();
    let src = chars_of(source);
    let mut i = 0;
    while i < src.len() {
        let c = src[i];
        if c == '\u{0}' {
            css.push('\u{fffd}');
        } else if c == '\r' {
            css.push('\n');
            if at(src, i + 1, '\n') {
                i += 1;
            }
        } else if c == '\u{c}' {
            css.push('\n');
        } else {
            css.push(c);
        }
        i += 1;
    }
    let length = css.len();
    let mut token_start_pos = 0;
    let mut pos = 0;
    let mut line = 1;
    let mut last_newline = -1;
    let mut tokens: Vec[Node] = Vec.new();
    let mut end_char: Option[char] = None;
    let mut stack: Vec[Frame] = Vec.new();

    while pos < length {
        let mut k = token_start_pos;
        while k < pos {
            if css[k] == '\n' {
                line += 1;
                last_newline = k;
            }
            k += 1;
        }
        let column = pos - last_newline;
        token_start_pos = pos;
        let c = css[pos];

        if is_ws(c) {
            pos = skip_ws(css, pos + 1);
            tokens.push(valued("whitespace", line, column, slice(css, token_start_pos, pos)));
            continue;
        } else if (c == 'U' or c == 'u') and pos + 2 < length and css[pos + 1] == '+'
            and (is_hex(css[pos + 2]) or css[pos + 2] == '?') {
            let (start, end, p) = consume_unicode_range(css, pos + 2);
            pos = p;
            let mut t = node("unicode-range", line, column);
            t.start = start;
            t.end = end;
            tokens.push(t);
            continue;
        } else if starts(css, pos, "-->") {
            tokens.push(literal(line, column, "-->"));
            pos += 3;
            continue;
        } else if is_ident_start(css, pos) {
            let (value, p) = consume_ident(css, pos);
            pos = p;
            if not at(css, pos, '(') {
                tokens.push(lowered("ident", line, column, value));
                continue;
            }
            pos += 1;
            if ascii_lower(value) == "url" {
                let url_pos = skip_ws(css, pos);
                if url_pos >= length or (css[url_pos] != '"' and css[url_pos] != '\'') {
                    let (v, p, error) = consume_url(css, pos);
                    pos = p;
                    if let Some(v) = v {
                        let mut repr = f"url({serialize_url(v)})";
                        if let Some((kind, _)) = error.clone() {
                            repr = if kind == "eof-in-string" { drop_last(repr, 2) } else { drop_last(repr, 1) };
                        }
                        let mut t = valued("url", line, column, v);
                        t.repr = repr;
                        tokens.push(t);
                    }
                    if let Some((kind, message)) = error {
                        tokens.push(parse_error(line, column, kind, message));
                    }
                    continue;
                }
            }
            let f = lowered("function", line, column, value);
            open_block(mut stack, mut tokens, mut end_char, f, ')');
            continue;
        }

        if let Some((end, groups)) = match_number(css, pos) {
            pos = end;
            let repr = slice(css, token_start_pos, pos);
            let value = f64.parse(repr).unwrap_or(0.0);
            let ival: Option[i64] = if groups { None } else { Some(py_int(repr)) };
            if pos < length and is_ident_start(css, pos) {
                let (unit, p) = consume_ident(css, pos);
                pos = p;
                let mut t = numeric("dimension", line, column, value, ival, repr);
                t.lower = ascii_lower(unit);
                t.unit = unit;
                tokens.push(t);
            } else if at(css, pos, '%') {
                pos += 1;
                tokens.push(numeric("percentage", line, column, value, ival, repr));
            } else {
                tokens.push(numeric("number", line, column, value, ival, repr));
            }
        } else if c == '@' {
            pos += 1;
            if pos < length and is_ident_start(css, pos) {
                let (value, p) = consume_ident(css, pos);
                pos = p;
                tokens.push(lowered("at-keyword", line, column, value));
            } else {
                tokens.push(literal(line, column, "@"));
            }
        } else if c == '#' {
            pos += 1;
            if pos < length and (is_name_char(css[pos]) or (css[pos] == '\\' and not starts(css, pos, "\\\n"))) {
                let is_identifier = is_ident_start(css, pos);
                let (value, p) = consume_ident(css, pos);
                pos = p;
                let mut t = valued("hash", line, column, value);
                t.flag = is_identifier;
                tokens.push(t);
            } else {
                tokens.push(literal(line, column, "#"));
            }
        } else if c == '{' {
            open_block(mut stack, mut tokens, mut end_char, node("{} block", line, column), '}');
            pos += 1;
        } else if c == '[' {
            open_block(mut stack, mut tokens, mut end_char, node("[] block", line, column), ']');
            pos += 1;
        } else if c == '(' {
            open_block(mut stack, mut tokens, mut end_char, node("() block", line, column), ')');
            pos += 1;
        } else if end_char == Some(c) {
            close_block(mut stack, mut tokens, mut end_char);
            pos += 1;
        } else if c == '}' or c == ']' or c == ')' {
            let kind = c.to_string();
            tokens.push(parse_error(line, column, kind, f"Unmatched {c}"));
            pos += 1;
        } else if c == '"' or c == '\'' {
            let (v, p, error) = consume_quoted_string(css, pos);
            pos = p;
            if let Some(v) = v {
                let mut repr = f"\"{serialize_string_value(v)}\"";
                if error.is_some() {
                    repr = drop_last(repr, 1);
                }
                let mut t = valued("string", line, column, v);
                t.repr = repr;
                tokens.push(t);
            }
            if let Some((kind, message)) = error {
                tokens.push(parse_error(line, column, kind, message));
            }
        } else if starts(css, pos, "/*") {
            let mut close = -1;
            let mut k = pos + 2;
            while k + 1 < length {
                if css[k] == '*' and css[k + 1] == '/' {
                    close = k;
                    break;
                }
                k += 1;
            }
            if close == -1 {
                if not skip_comments {
                    tokens.push(valued("comment", line, column, slice(css, token_start_pos + 2, length)));
                }
                break;
            }
            if not skip_comments {
                tokens.push(valued("comment", line, column, slice(css, token_start_pos + 2, close)));
            }
            pos = close + 2;
        } else if starts(css, pos, "<!--") {
            tokens.push(literal(line, column, "<!--"));
            pos += 4;
        } else if starts(css, pos, "||") {
            tokens.push(literal(line, column, "||"));
            pos += 2;
        } else if in_set(c, "~|^$*") {
            pos += 1;
            if at(css, pos, '=') {
                pos += 1;
                tokens.push(literal(line, column, f"{c}="));
            } else {
                tokens.push(literal(line, column, c.to_string()));
            }
        } else {
            tokens.push(literal(line, column, c.to_string()));
            pos += 1;
        }
    }
    while not stack.is_empty() {
        close_block(mut stack, mut tokens, mut end_char);
    }
    tokens
}

// ---------------------------------------------------------------- serializer

fn is_ident_char(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_' or (c as i64) > 0x7F
}

// An escape for \n, \r and \f, which every serializer spells as hex.
fn newline_escape(c: char) -> Option[Str] {
    if c == '\n' {
        Some("\\A ")
    } else if c == '\r' {
        Some("\\D ")
    } else if c == '\u{c}' {
        Some("\\C ")
    } else {
        None
    }
}

fn serialize_name(value: ref String) -> String {
    let mut out = String.new();
    for c in value.chars() {
        if is_name_char(c) {
            out.push(c);
        } else if let Some(e) = newline_escape(c) {
            out.push_str(e);
        } else {
            out.push('\\');
            out.push(c);
        }
    }
    out
}

// Any string as a CSS identifier.
fn serialize_identifier(value0: ref String) -> String {
    if value0 == "-" {
        return "\\-".to_string();
    }
    let cs = chars_of(value0);
    if starts(cs, 0, "--") {
        return f"--{serialize_name(slice(cs, 2, cs.len()))}";
    }
    let mut result = String.new();
    let mut from = 0;
    if cs[0] == '-' {
        result.push('-');
        from = 1;
    }
    let c = cs[from];
    if is_ident_char(c) {
        result.push(c);
    } else if let Some(e) = newline_escape(c) {
        result.push_str(e);
    } else if c >= '0' and c <= '9' {
        result.push_str(f"\\{hex_upper(c as i64)} ");
    } else {
        result.push('\\');
        result.push(c);
    }
    result.push_str(serialize_name(slice(cs, from + 1, cs.len())));
    result
}

fn serialize_string_value(value: ref String) -> String {
    let mut out = String.new();
    for c in value.chars() {
        if c == '"' {
            out.push_str("\\\"");
        } else if c == '\\' {
            out.push_str("\\\\");
        } else if let Some(e) = newline_escape(c) {
            out.push_str(e);
        } else {
            out.push(c);
        }
    }
    out
}

fn serialize_url(value: ref String) -> String {
    let mut out = String.new();
    for c in value.chars() {
        if c == '\'' {
            out.push_str("\\'");
        } else if c == '"' {
            out.push_str("\\\"");
        } else if c == '\\' {
            out.push_str("\\\\");
        } else if c == ' ' {
            out.push_str("\\ ");
        } else if c == '\t' {
            out.push_str("\\9 ");
        } else if let Some(e) = newline_escape(c) {
            out.push_str(e);
        } else if c == '(' {
            out.push_str("\\(");
        } else if c == ')' {
            out.push_str("\\)");
        } else {
            out.push(c);
        }
    }
    out
}

fn one_of(s: ref String, options: ref Vec[Str]) -> bool {
    for o in options.iter() {
        if s == *o {
            return true;
        }
    }
    false
}

// (previous, next) in serializer.BAD_PAIRS: the pairs that would read
// back as one token, or as a different one, without a comment between.
fn bad_pair(a: ref String, b: ref String) -> bool {
    let num_like: Vec[Str] = vec!["ident", "at-keyword", "hash", "dimension", "#", "-", "number"];
    let starts_num: Vec[Str] = vec!["ident", "function", "url", "number", "percentage", "dimension", "unicode-range"];
    if one_of(a, num_like) and one_of(b, starts_num) {
        return true;
    }
    if one_of(a, vec!["ident", "at-keyword", "hash", "dimension"]) and one_of(b, vec!["-", "-->"]) {
        return true;
    }
    if one_of(a, vec!["#", "-", "number", "@"]) and one_of(b, vec!["ident", "function", "url"]) {
        return true;
    }
    if one_of(a, vec!["unicode-range", ".", "+"]) and one_of(b, vec!["number", "percentage", "dimension"]) {
        return true;
    }
    if a == "@" and one_of(b, vec!["ident", "function", "url", "unicode-range", "-"]) {
        return true;
    }
    if a == "unicode-range" and one_of(b, vec!["ident", "function", "?"]) {
        return true;
    }
    if one_of(a, vec!["$", "*", "^", "~", "|"]) and b == "=" {
        return true;
    }
    (a == "ident" and b == "() block") or (a == "|" and b == "|") or (a == "/" and b == "*")
}

fn serialize_to(nodes: ref Vec[Node], out: mut ref String) {
    let mut previous: Option[String] = None;
    for n in nodes.iter() {
        let st = if n.ty == "literal" { n.value.clone() } else { n.ty.clone() };
        if let Some(p) = previous {
            if bad_pair(p, st) {
                out.push_str("/**/");
            } else if p == "\\" and not (st == "whitespace" and n.value.starts_with("\n")) {
                out.push('\n');
            }
        }
        serialize_node(n, mut out);
        if st == "declaration" {
            out.push(';');
        }
        previous = Some(st);
    }
}

fn serialize(nodes: ref Vec[Node]) -> String {
    let mut out = String.new();
    serialize_to(nodes, mut out);
    out
}

// Whether a function's serialization ends inside a string left open by
// EOF, and so takes no ")".
fn ends_in_open_string(f: ref Node) -> bool {
    if f.ty != "function" or f.kids.is_empty() {
        return false;
    }
    let last = ref f.kids[f.kids.len() - 1];
    if last.ty == "error" and last.value == "eof-in-string" {
        return true;
    }
    ends_in_open_string(last)
}

fn serialize_node(n: ref Node, out: mut ref String) {
    let ty = n.ty.as_str();
    if ty == "error" {
        // tinycss2 raises TypeError for the parser's kinds ("invalid",
        // "empty", "extra-input"); only the tokenizer's ever reach here.
        if n.value == "bad-string" {
            out.push_str("\"[bad string]\n");
        } else if n.value == "bad-url" {
            out.push_str("url([bad url])");
        } else if n.value == ")" or n.value == "]" or n.value == "}" {
            out.push_str(n.value);
        }
    } else if ty == "comment" {
        out.push_str("/*");
        out.push_str(n.value);
        out.push_str("*/");
    } else if ty == "whitespace" or ty == "literal" {
        out.push_str(n.value);
    } else if ty == "ident" {
        out.push_str(serialize_identifier(n.value));
    } else if ty == "at-keyword" {
        out.push('@');
        out.push_str(serialize_identifier(n.value));
    } else if ty == "hash" {
        out.push('#');
        if n.flag {
            out.push_str(serialize_identifier(n.value));
        } else {
            out.push_str(serialize_name(n.value));
        }
    } else if ty == "string" or ty == "url" or ty == "number" {
        out.push_str(n.repr);
    } else if ty == "unicode-range" {
        if n.end == n.start {
            out.push_str(f"U+{hex_upper(n.start)}");
        } else {
            out.push_str(f"U+{hex_upper(n.start)}-{hex_upper(n.end)}");
        }
    } else if ty == "percentage" {
        out.push_str(n.repr);
        out.push('%');
    } else if ty == "dimension" {
        out.push_str(n.repr);
        let u = chars_of(n.unit);
        if n.unit == "e" or n.unit == "E" or starts(u, 0, "e-") or starts(u, 0, "E-") {
            out.push_str("\\65 ");
            out.push_str(serialize_name(slice(u, 1, u.len())));
        } else {
            out.push_str(serialize_identifier(n.unit));
        }
    } else if ty == "() block" {
        out.push('(');
        serialize_to(n.kids, mut out);
        out.push(')');
    } else if ty == "[] block" {
        out.push('[');
        serialize_to(n.kids, mut out);
        out.push(']');
    } else if ty == "{} block" {
        out.push('{');
        serialize_to(n.kids, mut out);
        out.push('}');
    } else if ty == "function" {
        out.push_str(serialize_identifier(n.value));
        out.push('(');
        serialize_to(n.kids, mut out);
        if not ends_in_open_string(n) {
            out.push(')');
        }
    } else if ty == "declaration" {
        out.push_str(serialize_identifier(n.value));
        out.push(':');
        serialize_to(n.kids, mut out);
        if n.flag {
            out.push_str("!important");
        }
    } else if ty == "qualified-rule" {
        serialize_to(n.kids, mut out);
        out.push('{');
        if let Some(c) = n.content {
            serialize_to(c, mut out);
        }
        out.push('}');
    } else if ty == "at-rule" {
        out.push('@');
        out.push_str(serialize_identifier(n.value));
        serialize_to(n.kids, mut out);
        match n.content {
            None => out.push(';'),
            Some(c) => {
                out.push('{');
                serialize_to(c, mut out);
                out.push('}');
            }
        }
    }
}

// ---------------------------------------------------------------- parser

// The token iterator the parsers share. `items` and `front` are kept
// reversed so that next() pops; `front` holds what itertools.chain puts
// ahead of the rest.
struct Stream {
    items: Vec[Node],
    front: Vec[Node],
}

impl Stream {
    fn next(mut ref self) -> Option[Node] {
        if let Some(t) = self.front.pop() {
            return Some(t);
        }
        self.items.pop()
    }
}

fn stream_of(nodes: own Vec[Node]) -> Stream {
    let mut items = nodes;
    items.reverse();
    Stream { items: items, front: Vec.new() }
}

fn stream_css(css: ref String, skip_comments: bool) -> Stream {
    stream_of(parse_component_value_list(css, skip_comments))
}

fn next_significant(tokens: mut ref Stream) -> Option[Node] {
    while let Some(t) = tokens.next() {
        if not is_blank(t) {
            return Some(t);
        }
    }
    None
}

fn parse_one_component_value(tokens: mut ref Stream) -> Node {
    let first = next_significant(mut tokens);
    let second = next_significant(mut tokens);
    match first {
        None => parse_error(1, 1, "empty", "Input is empty"),
        Some(f) => match second {
            Some(s) => parse_error(s.line, s.col, "extra-input", "Got more than one token"),
            None => f,
        },
    }
}

fn parse_one_declaration(tokens: mut ref Stream) -> Node {
    match next_significant(mut tokens) {
        None => parse_error(1, 1, "empty", "Input is empty"),
        Some(first) => parse_declaration(first, mut tokens, true),
    }
}

fn consume_remnants(tokens: mut ref Stream, nested: bool) {
    while let Some(t) = tokens.next() {
        if is_lit(t, ";") {
            return;
        }
        if nested and is_lit(t, "}") {
            return;
        }
    }
}

fn parse_declaration(name: Node, tokens: mut ref Stream, nested: bool) -> Node {
    if name.ty != "ident" {
        consume_remnants(mut tokens, nested);
        return parse_error(name.line, name.col, "invalid", f"Expected <ident> for declaration name, got {name.ty}.");
    }
    let colon = match next_significant(mut tokens) {
        None => {
            consume_remnants(mut tokens, nested);
            return parse_error(name.line, name.col, "invalid", "Expected ':' after declaration name, got EOF");
        }
        Some(c) => c,
    };
    if not is_lit(colon, ":") {
        consume_remnants(mut tokens, nested);
        // (not an f-string in tinycss2 either)
        return parse_error(colon.line, colon.col, "invalid", "Expected ':' after declaration name, got {colon.type}.");
    }
    let mut value: Vec[Node] = Vec.new();
    let mut state = "value";
    let mut bang_position = 0;
    let mut contains_non_whitespace = false;
    let mut contains_simple_block = false;
    let mut i = 0;
    while let Some(token) = tokens.next() {
        if state == "value" and is_lit(token, "!") {
            state = "bang";
            bang_position = i;
        } else if state == "bang" and token.ty == "ident" and token.lower == "important" {
            state = "important";
        } else if not is_blank(token) {
            state = "value";
            if token.ty == "{} block" {
                if contains_non_whitespace {
                    contains_simple_block = true;
                } else {
                    contains_non_whitespace = true;
                }
            } else {
                contains_non_whitespace = true;
            }
        }
        value.push(token);
        i += 1;
    }
    if state == "important" {
        value.truncate(bang_position);
    }
    if contains_simple_block and contains_non_whitespace {
        return parse_error(colon.line, colon.col, "invalid", "Declaration contains {} block");
    }
    let mut d = valued("declaration", name.line, name.col, name.value);
    d.lower = name.lower.clone();
    d.kids = value;
    d.flag = state == "important";
    d
}

fn consume_blocks_content(first_token: Node, tokens: mut ref Stream) -> Node {
    let mut declaration_tokens: Vec[Node] = Vec.new();
    let mut semicolon_token: Vec[Node] = Vec.new();
    if not is_lit(first_token, ";") and first_token.ty != "{} block" {
        while let Some(token) = tokens.next() {
            if is_lit(token, ";") {
                semicolon_token.push(token);
                break;
            }
            let block = token.ty == "{} block";
            declaration_tokens.push(token);
            if block {
                break;
            }
        }
    }
    let mut own = stream_of(declaration_tokens.clone());
    let declaration = parse_declaration(first_token.clone(), mut own, true);
    if declaration.ty == "declaration" {
        return declaration;
    }
    // itertools.chain(declaration_tokens, semicolon_token, mut tokens)
    let mut front = declaration_tokens;
    front.extend(semicolon_token);
    front.reverse();
    tokens.front = front;
    let rule = consume_qualified_rule(first_token, mut tokens, true, Some(";"));
    tokens.front = Vec.new();
    rule
}

fn consume_declaration_in_list(first_token: Node, tokens: mut ref Stream) -> Node {
    let mut other: Vec[Node] = Vec.new();
    while let Some(token) = tokens.next() {
        if is_lit(token, ";") {
            break;
        }
        other.push(token);
    }
    let mut own = stream_of(other);
    parse_declaration(first_token, mut own, true)
}

fn parse_blocks_contents(tokens: mut ref Stream, skip_comments: bool, skip_whitespace: bool) -> Vec[Node] {
    let mut result: Vec[Node] = Vec.new();
    while let Some(token) = tokens.next() {
        if token.ty == "whitespace" {
            if not skip_whitespace {
                result.push(token);
            }
        } else if token.ty == "comment" {
            if not skip_comments {
                result.push(token);
            }
        } else if token.ty == "at-keyword" {
            result.push(consume_at_rule(token, mut tokens));
        } else if not is_lit(token, ";") {
            result.push(consume_blocks_content(token, mut tokens));
        }
    }
    result
}

fn parse_declaration_list(tokens: mut ref Stream, skip_comments: bool, skip_whitespace: bool) -> Vec[Node] {
    let mut result: Vec[Node] = Vec.new();
    while let Some(token) = tokens.next() {
        if token.ty == "whitespace" {
            if not skip_whitespace {
                result.push(token);
            }
        } else if token.ty == "comment" {
            if not skip_comments {
                result.push(token);
            }
        } else if token.ty == "at-keyword" {
            result.push(consume_at_rule(token, mut tokens));
        } else if not is_lit(token, ";") {
            result.push(consume_declaration_in_list(token, mut tokens));
        }
    }
    result
}

fn parse_one_rule(tokens: mut ref Stream) -> Node {
    let first = match next_significant(mut tokens) {
        None => return parse_error(1, 1, "empty", "Input is empty"),
        Some(f) => f,
    };
    let rule = consume_rule(first, mut tokens);
    if let Some(next) = next_significant(mut tokens) {
        return parse_error(next.line, next.col, "extra-input", f"Expected a single rule, got {next.ty} after the first rule.");
    }
    rule
}

fn parse_rule_list(tokens: mut ref Stream, skip_comments: bool, skip_whitespace: bool) -> Vec[Node] {
    let mut result: Vec[Node] = Vec.new();
    while let Some(token) = tokens.next() {
        if token.ty == "whitespace" {
            if not skip_whitespace {
                result.push(token);
            }
        } else if token.ty == "comment" {
            if not skip_comments {
                result.push(token);
            }
        } else {
            result.push(consume_rule(token, mut tokens));
        }
    }
    result
}

fn parse_stylesheet(tokens: mut ref Stream, skip_comments: bool, skip_whitespace: bool) -> Vec[Node] {
    let mut result: Vec[Node] = Vec.new();
    while let Some(token) = tokens.next() {
        if token.ty == "whitespace" {
            if not skip_whitespace {
                result.push(token);
            }
        } else if token.ty == "comment" {
            if not skip_comments {
                result.push(token);
            }
        } else if not is_lit(token, "<!--") and not is_lit(token, "-->") {
            result.push(consume_rule(token, mut tokens));
        }
    }
    result
}

fn consume_rule(first_token: Node, tokens: mut ref Stream) -> Node {
    if first_token.ty == "at-keyword" {
        return consume_at_rule(first_token, mut tokens);
    }
    consume_qualified_rule(first_token, mut tokens, false, None)
}

fn consume_at_rule(at_keyword: Node, tokens: mut ref Stream) -> Node {
    let mut prelude: Vec[Node] = Vec.new();
    let mut content: Option[Vec[Node]] = None;
    while let Some(token) = tokens.next() {
        if token.ty == "{} block" {
            content = Some(token.kids);
            break;
        } else if is_lit(token, ";") {
            break;
        }
        prelude.push(token);
    }
    let mut r = valued("at-rule", at_keyword.line, at_keyword.col, at_keyword.value);
    r.lower = at_keyword.lower.clone();
    r.kids = prelude;
    r.content = content;
    r
}

fn rule_error(token: ref Node, name: Str) -> Node {
    parse_error(token.line, token.col, "invalid", f"{name} reached before {{}} block for a qualified rule.")
}

fn is_stop(token: ref Node, stop_token: Option[Str]) -> bool {
    match stop_token {
        Some(s) => is_lit(token, s),
        None => false,
    }
}

fn consume_qualified_rule(first_token: Node, tokens: mut ref Stream, _nested: bool, stop_token: Option[Str]) -> Node {
    if is_stop(first_token, stop_token) {
        return rule_error(first_token, "Stop token");
    }
    let mut prelude: Vec[Node] = Vec.new();
    let mut block: Vec[Node] = Vec.new();
    if first_token.ty == "{} block" {
        block = first_token.kids.clone();
    } else {
        prelude.push(first_token.clone());
        let mut found = false;
        while let Some(token) = tokens.next() {
            if is_stop(token, stop_token) {
                return rule_error(token, "Stop token");
            }
            if token.ty == "{} block" {
                block = token.kids;
                found = true;
                break;
            }
            prelude.push(token);
        }
        if not found {
            return rule_error(prelude[prelude.len() - 1], "EOF");
        }
    }
    let mut r = node("qualified-rule", first_token.line, first_token.col);
    r.kids = prelude;
    r.content = Some(block);
    r
}

// ---------------------------------------------------------------- nth

// What parse_nth returns: None, (a, b), or the exception it raises.
enum Nth {
    Nothing,
    Pair(i64, i64),
    Raised(PyErr),
}

// N_DASH_DIGITS_RE = '^n(-[0-9]+)$'.match(s): the group's value. "$"
// also matches before a final newline.
fn n_dash_digits(s0: ref String) -> Option[i64] {
    let mut cs = chars_of(s0);
    if not cs.is_empty() and cs[cs.len() - 1] == '\n' {
        cs.pop();
    }
    if cs.len() < 3 or cs[0] != 'n' or cs[1] != '-' {
        return None;
    }
    let mut i = 2;
    while i < cs.len() {
        if cs[i] < '0' or cs[i] > '9' {
            return None;
        }
        i += 1;
    }
    Some(py_int(slice(cs, 1, cs.len())))
}

fn int_of(t: ref Node) -> i64 {
    t.ival.unwrap_or(0)
}

fn parse_nth(tokens: mut ref Stream) -> Nth {
    let token = match next_significant(mut tokens) {
        None => return Nth.Nothing,
        Some(t) => t,
    };
    if token.ty == "number" and token.ival.is_some() {
        return parse_end(mut tokens, 0, int_of(token));
    } else if token.ty == "dimension" and token.ival.is_some() {
        let unit = token.lower.clone();
        if unit == "n" {
            return parse_b(mut tokens, int_of(token));
        } else if unit == "n-" {
            return parse_signless_b(mut tokens, int_of(token), -1);
        } else if let Some(b) = n_dash_digits(unit) {
            return parse_end(mut tokens, int_of(token), b);
        }
    } else if token.ty == "ident" {
        let ident = token.lower.clone();
        if ident == "even" {
            return parse_end(mut tokens, 2, 0);
        } else if ident == "odd" {
            return parse_end(mut tokens, 2, 1);
        } else if ident == "n" {
            return parse_b(mut tokens, 1);
        } else if ident == "-n" {
            return parse_b(mut tokens, -1);
        } else if ident == "n-" {
            return parse_signless_b(mut tokens, 1, -1);
        } else if ident == "-n-" {
            return parse_signless_b(mut tokens, -1, -1);
        } else if ident.starts_with("-") {
            let cs = chars_of(ident);
            if let Some(b) = n_dash_digits(slice(cs, 1, cs.len())) {
                return parse_end(mut tokens, -1, b);
            }
        } else if let Some(b) = n_dash_digits(ident) {
            return parse_end(mut tokens, 1, b);
        }
    } else if is_lit(token, "+") {
        // Whitespace after an initial '+' is invalid.
        let next = match tokens.next() {
            None => return Nth.Raised(py_err("StopIteration", "")),
            Some(t) => t,
        };
        if next.ty == "ident" {
            let ident = next.lower.clone();
            if ident == "n" {
                return parse_b(mut tokens, 1);
            } else if ident == "n-" {
                return parse_signless_b(mut tokens, 1, -1);
            } else if let Some(b) = n_dash_digits(ident) {
                return parse_end(mut tokens, 1, b);
            }
        }
    }
    Nth.Nothing
}

fn signed_repr(t: ref Node) -> bool {
    t.repr.starts_with("-") or t.repr.starts_with("+")
}

fn parse_b(tokens: mut ref Stream, a: i64) -> Nth {
    let token = match next_significant(mut tokens) {
        None => return Nth.Pair(a, 0),
        Some(t) => t,
    };
    if is_lit(token, "+") {
        return parse_signless_b(mut tokens, a, 1);
    } else if is_lit(token, "-") {
        return parse_signless_b(mut tokens, a, -1);
    } else if token.ty == "number" and token.ival.is_some() and signed_repr(token) {
        return parse_end(mut tokens, a, int_of(token));
    }
    Nth.Nothing
}

fn parse_signless_b(tokens: mut ref Stream, a: i64, b_sign: i64) -> Nth {
    let token = match next_significant(mut tokens) {
        None => return Nth.Raised(py_err("AttributeError", "'NoneType' object has no attribute 'type'")),
        Some(t) => t,
    };
    if token.ty == "number" and token.ival.is_some() and not signed_repr(token) {
        return parse_end(mut tokens, a, b_sign * int_of(token));
    }
    Nth.Nothing
}

fn parse_end(tokens: mut ref Stream, a: i64, b: i64) -> Nth {
    if next_significant(mut tokens).is_none() {
        return Nth.Pair(a, b);
    }
    Nth.Nothing
}

// ---------------------------------------------------------------- colors

// colorsys
fn hls_v(m1: f64, m2: f64, hue0: f64) -> f64 {
    let one_sixth = 1.0 / 6.0;
    let two_third = 2.0 / 3.0;
    let hue = py_mod(hue0, 1.0);
    if hue < one_sixth {
        return m1 + (m2 - m1) * hue * 6.0;
    }
    if hue < 0.5 {
        return m2;
    }
    if hue < two_third {
        return m1 + (m2 - m1) * (two_third - hue) * 6.0;
    }
    m1
}

fn hls_to_rgb(h: f64, l: f64, s: f64) -> Vec[f64] {
    if s == 0.0 {
        return vec![l, l, l];
    }
    let m2 = if l <= 0.5 { l * (1.0 + s) } else { l + s - (l * s) };
    let m1 = 2.0 * l - m2;
    let one_third = 1.0 / 3.0;
    vec![hls_v(m1, m2, h + one_third), hls_v(m1, m2, h), hls_v(m1, m2, h - one_third)]
}

// The hash patterns of color3._HASH_REGEXPS, in order: 4 and 3 digits
// (doubled) and 8 and 6 digits. Their "$" matches before a final
// newline too. (Their "\d" would also take non-ASCII decimal digits; the
// port takes ASCII ones.)
fn hash_channels(value: ref String) -> Option[Vec[f64]] {
    let mut cs = chars_of(value);
    if not cs.is_empty() and cs[cs.len() - 1] == '\n' {
        cs.pop();
    }
    for c in cs.iter() {
        if not is_hex(*c) {
            return None;
        }
    }
    let n = cs.len();
    let mut out: Vec[f64] = Vec.new();
    if n == 4 or n == 3 {
        for c in cs.iter() {
            out.push((hex_val(*c) * 17) as f64 / 255.0);
        }
        return Some(out);
    }
    if n == 8 or n == 6 {
        let mut i = 0;
        while i < n {
            out.push((hex_val(cs[i]) * 16 + hex_val(cs[i + 1])) as f64 / 255.0);
            i += 2;
        }
        return Some(out);
    }
    None
}

fn keyword_rgb(name: ref String, level4: bool) -> Option[(i64, i64, i64)] {
    for (k, r, g, b, four) in color_keywords().iter() {
        if name == *k and (level4 or not *four) {
            return Some((*r, *g, *b));
        }
    }
    None
}

fn significant(tokens: ref Vec[Node]) -> Vec[Node] {
    let mut out: Vec[Node] = Vec.new();
    for t in tokens.iter() {
        if not is_blank(t) {
            out.push(t.clone());
        }
    }
    out
}

// tokens[::2] when tokens[1::2] are all commas.
fn every_other(tokens: ref Vec[Node]) -> Option[Vec[Node]] {
    let mut out: Vec[Node] = Vec.new();
    let mut i = 0;
    while i < tokens.len() {
        if i % 2 == 1 {
            if not is_lit(tokens[i], ",") {
                return None;
            }
        } else {
            out.push(tokens[i].clone());
        }
        i += 1;
    }
    Some(out)
}

// ---- Level 3

enum C3 {
    Nothing,
    Current,
    Rgba(Vec[f64]),
}

fn parse_color3(token: ref Node) -> C3 {
    if token.ty == "ident" {
        if token.lower == "currentcolor" {
            return C3.Current;
        }
        if token.lower == "transparent" {
            return C3.Rgba(vec![0.0, 0.0, 0.0, 0.0]);
        }
        if let Some((r, g, b)) = keyword_rgb(token.lower, false) {
            return C3.Rgba(vec![r as f64 / 255.0, g as f64 / 255.0, b as f64 / 255.0, 1.0]);
        }
    } else if token.ty == "hash" {
        if let Some(found) = hash_channels(token.value) {
            let mut channels = found;
            if channels.len() == 3 {
                channels.push(1.0);
            }
            return C3.Rgba(channels);
        }
    } else if token.ty == "function" {
        let tokens = significant(token.kids);
        if tokens.len() % 2 == 1 {
            if let Some(args) = every_other(tokens) {
                let name = token.lower.as_str();
                if name == "rgb" {
                    return parse_rgb3(args, args.len(), 1.0);
                } else if name == "rgba" {
                    if let Some(alpha) = parse_alpha3(args) {
                        return parse_rgb3(args, 3, alpha);
                    }
                } else if name == "hsl" {
                    return parse_hsl3(args, args.len(), 1.0);
                } else if name == "hsla" {
                    if let Some(alpha) = parse_alpha3(args) {
                        return parse_hsl3(args, 3, alpha);
                    }
                }
            }
        }
    }
    C3.Nothing
}

// _parse_alpha(args[3:])
fn parse_alpha3(args: ref Vec[Node]) -> Option[f64] {
    if args.len() == 4 and args[3].ty == "number" {
        return Some(py_min(1.0, py_max(0.0, args[3].num)));
    }
    None
}

// The types of args[:n] are exactly `want`.
fn types_are(args: ref Vec[Node], n: i64, want: Vec[Str]) -> bool {
    if n != want.len() {
        return false;
    }
    let mut i = 0;
    while i < n {
        if args[i].ty != want[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn parse_rgb3(args: ref Vec[Node], n: i64, alpha: f64) -> C3 {
    if types_are(args, n, vec!["number", "number", "number"]) {
        if args[0].ival.is_some() and args[1].ival.is_some() and args[2].ival.is_some() {
            return C3.Rgba(vec![int_of(args[0]) as f64 / 255.0, int_of(args[1]) as f64 / 255.0, int_of(args[2]) as f64 / 255.0, alpha]);
        }
    } else if types_are(args, n, vec!["percentage", "percentage", "percentage"]) {
        return C3.Rgba(vec![args[0].num / 100.0, args[1].num / 100.0, args[2].num / 100.0, alpha]);
    }
    C3.Nothing
}

fn parse_hsl3(args: ref Vec[Node], n: i64, alpha: f64) -> C3 {
    if types_are(args, n, vec!["number", "percentage", "percentage"]) {
        let mut rgb = hls_to_rgb(args[0].num / 360.0, args[2].num / 100.0, args[1].num / 100.0);
        rgb.push(alpha);
        return C3.Rgba(rgb);
    }
    C3.Nothing
}

// ---- Level 4

#[derive(Clone)]
struct Color {
    space: String,
    coords: Vec[Option[f64]],
    alpha: f64,
}

fn new_color(space: Str, coords: own Vec[Option[f64]], alpha: f64) -> Color {
    Color { space: space.to_string(), coords: coords, alpha: py_max(0.0, py_min(1.0, alpha)) }
}

fn plain(xs: Vec[f64]) -> Vec[Option[f64]] {
    let mut out: Vec[Option[f64]] = Vec.new();
    for x in xs.iter() {
        out.push(Some(*x));
    }
    out
}

enum C4 {
    Nothing,
    Current,
    Col(Color),
    Raised(PyErr),
}

fn function_space(s: ref String) -> bool {
    one_of(s, vec!["srgb", "srgb-linear", "display-p3", "a98-rgb", "prophoto-rgb", "rec2020", "xyz", "xyz-d50", "xyz-d65"])
}

fn parse_color4(token: ref Node) -> C4 {
    if token.ty == "ident" {
        if token.lower == "currentcolor" {
            return C4.Current;
        }
        if token.lower == "transparent" {
            return C4.Col(new_color("srgb", plain(vec![0.0, 0.0, 0.0]), 0.0));
        }
        if let Some((r, g, b)) = keyword_rgb(token.lower, true) {
            return C4.Col(new_color("srgb", plain(vec![r as f64 / 255.0, g as f64 / 255.0, b as f64 / 255.0]), 1.0));
        }
        return C4.Nothing;
    }
    if token.ty == "hash" {
        if let Some(found) = hash_channels(token.value) {
            let mut channels = found;
            let alpha = if channels.len() == 4 { channels.pop().unwrap() } else { 1.0 };
            return C4.Col(new_color("srgb", plain(channels), alpha));
        }
        return C4.Nothing;
    }
    if token.ty != "function" {
        return C4.Nothing;
    }
    let mut tokens = significant(token.kids);
    let name = token.lower.as_str();
    let mut space: Option[Node] = None;
    if name == "color" {
        if tokens.is_empty() {
            return C4.Raised(py_err("ValueError", "not enough values to unpack (expected at least 1, got 0)"));
        }
        space = Some(tokens.remove(0));
    }
    let length = tokens.len();
    let mut old_syntax = false;
    if length == 5 or length == 7 {
        if let Some(evens) = every_other(tokens) {
            old_syntax = true;
            tokens = evens;
        }
    }
    if not old_syntax {
        if length == 3 {
        } else if length == 5 and is_lit(tokens[3], "/") {
            tokens.remove(3);
        } else {
            return C4.Nothing;
        }
    }
    let mut args: Vec[Node] = Vec.new();
    let mut i = 0;
    while i < 3 {
        args.push(tokens[i].clone());
        i += 1;
    }
    let alpha = match parse_alpha4(tokens, 3) {
        None => return C4.Nothing,
        Some(a) => a,
    };
    if name == "rgb" or name == "rgba" {
        return parse_rgb4(args, alpha);
    } else if name == "hsl" or name == "hsla" {
        return parse_hsl4(args, alpha, "hsl");
    } else if name == "hwb" {
        return parse_hsl4(args, alpha, "hwb");
    } else if name == "lab" and not old_syntax {
        return parse_lab4(args, alpha, "lab", 1.0, 1.25, 1.25);
    } else if name == "lch" and not old_syntax {
        return parse_lch4(args, alpha, "lch", 1.0, 1.5);
    } else if name == "oklab" and not old_syntax {
        return parse_lab4(args, alpha, "oklab", 0.01, 0.004, 0.004);
    } else if name == "oklch" and not old_syntax {
        return parse_lch4(args, alpha, "oklch", 0.01, 0.004);
    } else if name == "color" and not old_syntax {
        return parse_color_fn(space.unwrap(), args, alpha);
    }
    C4.Nothing
}

// _parse_alpha(tokens[from:])
fn parse_alpha4(tokens: ref Vec[Node], from: i64) -> Option[f64] {
    let n = tokens.len() - from;
    if n <= 0 {
        return Some(1.0);
    }
    if n == 1 {
        let t = ref tokens[from];
        if t.ty == "number" {
            return Some(py_min(1.0, py_max(0.0, t.num)));
        }
        if t.ty == "percentage" {
            return Some(py_min(1.0, py_max(0.0, t.num / 100.0)));
        }
    }
    None
}

fn is_none_ident(t: ref Node) -> bool {
    t.ty == "ident" and t.lower == "none"
}

// _types(args[lo:hi]): the set of types, "none" idents left out.
fn types_of(args: ref Vec[Node], lo: i64, hi: i64) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut i = lo;
    while i < hi {
        let t = ref args[i];
        if not is_none_ident(t) and not out.contains(t.ty) {
            out.push(t.ty.clone());
        }
        i += 1;
    }
    out
}

// _types(...) in (set(), {'number'}, {'percentage'})
fn one_kind(ts: ref Vec[String]) -> bool {
    ts.is_empty() or (ts.len() == 1 and (ts[0] == "number" or ts[0] == "percentage"))
}

// _types(...) <= {'number', 'percentage'}
fn numbers_only(ts: ref Vec[String]) -> bool {
    for t in ts.iter() {
        if t != "number" and t != "percentage" {
            return false;
        }
    }
    true
}

fn parse_rgb4(args: ref Vec[Node], alpha: f64) -> C4 {
    if not one_kind(types_of(args, 0, 3)) {
        return C4.Nothing;
    }
    let mut coords: Vec[Option[f64]] = Vec.new();
    for a in args.iter() {
        coords.push(if a.ty == "number" { Some(a.num / 255.0) } else if a.ty == "percentage" { Some(a.num / 100.0) } else { None });
    }
    C4.Col(new_color("srgb", coords, alpha))
}

fn unless_ident(t: ref Node, v: f64) -> Option[f64] {
    if t.ty == "ident" { None } else { Some(v) }
}

// _parse_hsl and _parse_hwb
fn parse_hsl4(args: ref Vec[Node], alpha: f64, space: Str) -> C4 {
    let ts = types_of(args, 1, 3);
    let ok = if space == "hsl" { one_kind(ts) } else { numbers_only(ts) };
    if not ok {
        return C4.Nothing;
    }
    let hue = match parse_hue(args[0]) {
        None => return C4.Nothing,
        Some(h) => h,
    };
    let coords = vec![unless_ident(args[0], hue), unless_ident(args[1], args[1].num), unless_ident(args[2], args[2].num)];
    C4.Col(new_color(space, coords, alpha))
}

fn scaled(t: ref Node, pct: f64) -> Option[f64] {
    if t.ty == "ident" {
        return None;
    }
    Some(t.num * (if t.ty == "number" { 1.0 } else { pct }))
}

// _parse_lab and _parse_oklab
fn parse_lab4(args: ref Vec[Node], alpha: f64, space: Str, p0: f64, p1: f64, p2: f64) -> C4 {
    if not numbers_only(types_of(args, 0, 3)) {
        return C4.Nothing;
    }
    let coords = vec![scaled(args[0], p0), scaled(args[1], p1), scaled(args[2], p2)];
    C4.Col(new_color(space, coords, alpha))
}

// _parse_lch and _parse_oklch. The hue is None when the LIGHTNESS is an
// ident, as in tinycss2.
fn parse_lch4(args: ref Vec[Node], alpha: f64, space: Str, p0: f64, p1: f64) -> C4 {
    if not numbers_only(types_of(args, 0, 2)) {
        return C4.Nothing;
    }
    let hue = match parse_hue(args[2]) {
        None => return C4.Nothing,
        Some(h) => h,
    };
    let coords = vec![scaled(args[0], p0), scaled(args[1], p1), unless_ident(args[0], hue)];
    C4.Col(new_color(space, coords, alpha))
}

fn parse_color_fn(space: Node, args: ref Vec[Node], alpha: f64) -> C4 {
    if not numbers_only(types_of(args, 0, 3)) {
        return C4.Nothing;
    }
    if space.ty != "ident" or not function_space(space.lower) {
        return C4.Nothing;
    }
    let name = if space.lower == "xyz" { "xyz-d65".to_string() } else { space.lower.clone() };
    let mut coords: Vec[Option[f64]] = Vec.new();
    for a in args.iter() {
        coords.push(if a.ty == "number" { Some(a.num) } else if a.ty == "percentage" { Some(a.num / 100.0) } else { None });
    }
    C4.Col(Color { space: name, coords: coords, alpha: py_max(0.0, py_min(1.0, alpha)) })
}

fn parse_hue(t: ref Node) -> Option[f64] {
    if t.ty == "number" {
        return Some(py_mod(t.num, 360.0));
    }
    if t.ty == "dimension" {
        if t.unit == "deg" {
            return Some(py_mod(t.num, 360.0));
        } else if t.unit == "grad" {
            return Some(py_mod(t.num / 400.0 * 360.0, 360.0));
        } else if t.unit == "rad" {
            return Some(py_mod(degrees(t.num), 360.0));
        } else if t.unit == "turn" {
            return Some(py_mod(t.num * 360.0, 360.0));
        }
        return None;
    }
    if is_none_ident(t) {
        return Some(0.0);
    }
    None
}

// ---- conversions (Color.to)

fn d50() -> Vec[f64] {
    vec![0.3457 / 0.3585, 1.0, (1.0 - 0.3457 - 0.3585) / 0.3585]
}

fn d65() -> Vec[f64] {
    vec![0.3127 / 0.3290, 1.0, (1.0 - 0.3127 - 0.3290) / 0.3290]
}

fn kappa() -> f64 {
    24389.0 / 27.0
}

fn epsilon() -> f64 {
    216.0 / 24389.0
}

fn xyz_to_lab(xyz: ref Vec[f64], d: ref Vec[f64]) -> Vec[f64] {
    let x = xyz[0] / d[0];
    let y = xyz[1] / d[1];
    let z = xyz[2] / d[2];
    let third = 1.0 / 3.0;
    let f0 = if x > epsilon() { x.pow(third) } else { (kappa() * x + 16.0) / 116.0 };
    let f1 = if y > epsilon() { y.pow(third) } else { (kappa() * y + 16.0) / 116.0 };
    let f2 = if z > epsilon() { z.pow(third) } else { (kappa() * z + 16.0) / 116.0 };
    vec![(116.0 * f1) - 16.0, 500.0 * (f0 - f1), 200.0 * (f1 - f2)]
}

fn lab_to_xyz(l: f64, a: f64, b: f64, d: ref Vec[f64]) -> Vec[f64] {
    let f1 = (l + 16.0) / 116.0;
    let f0 = a / 500.0 + f1;
    let f2 = f1 - b / 200.0;
    let x = if f0.pow(3.0) > epsilon() { f0.pow(3.0) } else { (116.0 * f0 - 16.0) / kappa() };
    let y = if l > kappa() * epsilon() { ((l + 16.0) / 116.0).pow(3.0) } else { l / kappa() };
    let z = if f2.pow(3.0) > epsilon() { f2.pow(3.0) } else { (116.0 * f2 - 16.0) / kappa() };
    vec![x * d[0], y * d[1], z * d[2]]
}

fn oklab_to_xyz(l: f64, a: f64, b: f64) -> Vec[f64] {
    let lab = vec![l, a, b];
    let to_lms: Vec[Vec[f64]] = vec![
        vec![0.99999999845051981432, 0.39633779217376785678, 0.21580375806075880339],
        vec![1.0000000088817607767, -0.1055613423236563494, -0.063854174771705903402],
        vec![1.0000000546724109177, -0.089484182094965759684, -1.2914855378640917399],
    ];
    let to_xyz: Vec[Vec[f64]] = vec![
        vec![1.2268798733741557, -0.5578149965554813, 0.28139105017721583],
        vec![-0.04057576262431372, 1.1122868293970594, -0.07171106666151701],
        vec![-0.07637294974672142, -0.4214933239627914, 1.5869240244272418],
    ];
    let mut lms: Vec[f64] = Vec.new();
    for row in to_lms.iter() {
        let terms = vec![row[0] * lab[0], row[1] * lab[1], row[2] * lab[2]];
        lms.push(py_sum(terms));
    }
    let mut out: Vec[f64] = Vec.new();
    for row in to_xyz.iter() {
        let terms = vec![row[0] * lms[0].pow(3.0), row[1] * lms[1].pow(3.0), row[2] * lms[2].pow(3.0)];
        out.push(py_sum(terms));
    }
    out
}

fn polar(c: ref Vec[f64]) -> (f64, f64) {
    (c[1] * radians(c[2]).cos(), c[1] * radians(c[2]).sin())
}

fn not_implemented() -> PyErr {
    py_err("NotImplementedError", "")
}

// Color.to(space)
fn color_to(c: ref Color, space0: Str) -> Result[Color, PyErr] {
    let mut co: Vec[f64] = Vec.new();
    for x in c.coords.iter() {
        co.push(x.unwrap_or(0.0));
    }
    let space = if space0 == "xyz" { "xyz-d65" } else { space0 };
    if space == c.space {
        return Ok(new_color(space, plain(co), c.alpha));
    }
    let from = c.space.as_str();
    if space == "srgb" {
        if from == "hsl" {
            return Ok(new_color(space, plain(hls_to_rgb(co[0] / 360.0, co[2] / 100.0, co[1] / 100.0)), c.alpha));
        }
        if from == "hwb" {
            let white = co[1];
            let black = co[2];
            let mut rgb: Vec[f64] = Vec.new();
            if white + black >= 100.0 {
                let v = white / (white + black);
                rgb = vec![v, v, v];
            } else {
                for ch in hls_to_rgb(co[0] / 360.0, 0.5, 1.0).iter() {
                    rgb.push(((*ch * (100.0 - white - black)) + white) / 100.0);
                }
            }
            return Ok(new_color(space, plain(rgb), c.alpha));
        }
    } else if space == "xyz-d50" {
        if from == "lab" {
            return Ok(new_color(space, plain(lab_to_xyz(co[0], co[1], co[2], d50())), c.alpha));
        }
        if from == "lch" {
            let (a, b) = polar(co);
            return Ok(new_color(space, plain(lab_to_xyz(co[0], a, b, d50())), c.alpha));
        }
    } else if space == "xyz-d65" {
        if from == "oklab" {
            return Ok(new_color(space, plain(oklab_to_xyz(co[0], co[1], co[2])), c.alpha));
        }
        if from == "oklch" {
            let (a, b) = polar(co);
            return Ok(new_color(space, plain(oklab_to_xyz(co[0], a, b)), c.alpha));
        }
    } else if space == "lab" {
        if from == "xyz-d50" {
            return Ok(new_color(space, plain(xyz_to_lab(co, d50())), c.alpha));
        }
        if from == "xyz-d65" {
            return Ok(new_color(space, plain(xyz_to_lab(co, d65())), c.alpha));
        }
        if from == "lch" {
            let (a, b) = polar(co);
            return Ok(new_color(space, plain(vec![co[0], a, b]), c.alpha));
        }
        if from == "oklab" {
            return Ok(new_color(space, plain(xyz_to_lab(oklab_to_xyz(co[0], co[1], co[2]), d65())), c.alpha));
        }
        if from == "oklch" {
            let (a, b) = polar(co);
            return Ok(new_color(space, plain(xyz_to_lab(oklab_to_xyz(co[0], a, b), d65())), c.alpha));
        }
    }
    Err(not_implemented())
}

// ---------------------------------------------------------------- encodings

// webencodings.lookup: the canonical name of a label.
fn lookup(label: ref String) -> Option[String] {
    let cs = chars_of(label);
    let mut a = 0;
    let mut b = cs.len();
    while a < b and in_set(cs[a], "\t\n\u{c}\r ") {
        a += 1;
    }
    while b > a and in_set(cs[b - 1], "\t\n\u{c}\r ") {
        b -= 1;
    }
    let key = ascii_lower(slice(cs, a, b));
    for (k, name) in encoding_labels().iter() {
        if key == *k {
            return Some(name.to_string());
        }
    }
    None
}

fn is_cont(b: u8) -> bool {
    b >= 0x80 and b < 0xC0
}

// CPython's UTF-8 decoder with errors="replace": each maximal invalid
// subpart is one U+FFFD.
fn utf8_decode(data: ref Vec[u8], from: i64) -> String {
    let mut out = String.new();
    let mut i = from;
    let n = data.len();
    while i < n {
        let b = data[i];
        if b < 0x80 {
            out.push(b as char);
            i += 1;
            continue;
        }
        let mut need = 0;
        let mut lo: u8 = 0x80;
        let mut hi: u8 = 0xBF;
        if b >= 0xC2 and b <= 0xDF {
            need = 1;
        } else if b >= 0xE0 and b <= 0xEF {
            need = 2;
            if b == 0xE0 {
                lo = 0xA0;
            }
            if b == 0xED {
                hi = 0x9F;
            }
        } else if b >= 0xF0 and b <= 0xF4 {
            need = 3;
            if b == 0xF0 {
                lo = 0x90;
            }
            if b == 0xF4 {
                hi = 0x8F;
            }
        }
        if need == 0 {
            out.push('\u{fffd}');
            i += 1;
            continue;
        }
        let mut k = 1;
        let mut bad = false;
        while k <= need {
            if i + k >= n {
                out.push('\u{fffd}');
                return out;
            }
            let c = data[i + k];
            let ok = if k == 1 { c >= lo and c <= hi } else { is_cont(c) };
            if not ok {
                bad = true;
                break;
            }
            k += 1;
        }
        if bad {
            out.push('\u{fffd}');
            i += k;
            continue;
        }
        let mut cp: i64 = if need == 1 { (b & 0x1F) as i64 } else if need == 2 { (b & 0x0F) as i64 } else { (b & 0x07) as i64 };
        k = 1;
        while k <= need {
            cp = (cp << 6) | ((data[i + k] & 0x3F) as i64);
            k += 1;
        }
        out.push(char_of(cp));
        i += need + 1;
    }
    out
}

// CPython's UTF-16 decoder with errors="replace".
fn utf16_decode(data: ref Vec[u8], from: i64, big: bool) -> String {
    let mut out = String.new();
    let n = data.len();
    let mut i = from;
    while i < n {
        if i + 1 >= n {
            out.push('\u{fffd}');
            break;
        }
        let u = if big { (data[i] as i64) * 256 + data[i + 1] as i64 } else { (data[i + 1] as i64) * 256 + data[i] as i64 };
        if u < 0xD800 or u > 0xDFFF {
            out.push(char_of(u));
            i += 2;
            continue;
        }
        if u >= 0xDC00 {
            out.push('\u{fffd}');
            i += 2;
            continue;
        }
        if n - i < 4 {
            out.push('\u{fffd}');
            break;
        }
        let w = if big { (data[i + 2] as i64) * 256 + data[i + 3] as i64 } else { (data[i + 3] as i64) * 256 + data[i + 2] as i64 };
        if w >= 0xDC00 and w <= 0xDFFF {
            out.push(char_of(0x10000 + ((u - 0xD800) << 10) + (w - 0xDC00)));
            i += 4;
        } else {
            out.push('\u{fffd}');
            i += 2;
        }
    }
    out
}

// The codecs of the single-byte encodings: the characters of bytes 0x80
// to 0xFF (U+FFFD where the codec has none); 0x00 to 0x7F are ASCII.
fn single_byte_decode(data: ref Vec[u8], from: i64, high: ref Vec[char]) -> String {
    let mut out = String.new();
    let mut i = from;
    while i < data.len() {
        let b = data[i];
        if b < 0x80 {
            out.push(b as char);
        } else {
            out.push(high[(b - 0x80) as i64]);
        }
        i += 1;
    }
    out
}

// webencodings.decode(input, fallback): a BOM wins over the fallback.
fn wdecode(data: ref Vec[u8], fallback: ref String) -> Result[(String, String), PyErr] {
    let n = data.len();
    let mut name = fallback.clone();
    let mut from = 0;
    if n >= 2 and data[0] == 0xFF and data[1] == 0xFE {
        name = "utf-16le".to_string();
        from = 2;
    } else if n >= 2 and data[0] == 0xFE and data[1] == 0xFF {
        name = "utf-16be".to_string();
        from = 2;
    } else if n >= 3 and data[0] == 0xEF and data[1] == 0xBB and data[2] == 0xBF {
        name = "utf-8".to_string();
        from = 3;
    }
    if name == "utf-8" {
        return Ok((utf8_decode(data, from), name));
    }
    if name == "utf-16le" or name == "utf-16be" {
        return Ok((utf16_decode(data, from, name == "utf-16be"), name));
    }
    for (k, high) in single_byte_codecs().iter() {
        if name == *k {
            return Ok((single_byte_decode(data, from, chars_of(high.to_string())), name));
        }
    }
    Err(py_err("LookupError", f"no codec for {name} in this port"))
}

fn bytes_starts(data: ref Vec[u8], at: i64, s: Str) -> bool {
    let mut i = at;
    for b in s.bytes() {
        if i >= data.len() or data[i] != *b {
            return false;
        }
        i += 1;
    }
    true
}

// tinycss2.bytes.decode_stylesheet_bytes
// https://drafts.csswg.org/css-syntax/#the-input-byte-stream
fn decode_stylesheet_bytes(css: ref Vec[u8], protocol: Option[String], environment: Option[String]) -> Result[(String, String), PyErr] {
    if let Some(p) = protocol {
        if not p.is_empty() {
            if let Some(fallback) = lookup(p) {
                return wdecode(css, fallback);
            }
        }
    }
    if bytes_starts(css, 0, "@charset \"") {
        // 100 is arbitrary so that no encoding label is more than 100-10 bytes.
        let mut end_quote = -1;
        let mut i = 10;
        while i < css.len() and i < 100 {
            if css[i] == 0x22 {
                end_quote = i;
                break;
            }
            i += 1;
        }
        if end_quote != -1 and bytes_starts(css, end_quote, "\";") {
            let mut label = String.new();
            let mut k = 10;
            while k < end_quote {
                label.push(css[k] as char);
                k += 1;
            }
            if let Some(fallback) = lookup(label) {
                if fallback == "utf-16be" or fallback == "utf-16le" {
                    return wdecode(css, "utf-8".to_string());
                }
                return wdecode(css, fallback);
            }
        }
    }
    if let Some(e) = environment {
        return wdecode(css, e);
    }
    wdecode(css, "utf-8".to_string())
}

// ---------------------------------------------------------------- suites

fn nodes_j(nodes: ref Vec[Node]) -> Vec[J] {
    let mut out: Vec[J] = Vec.new();
    for n in nodes.iter() {
        out.push(node_j(n));
    }
    out
}

fn tagged(tag: Str, rest: Vec[J]) -> J {
    let mut v = vec![text_j(tag)];
    v.extend(rest);
    J.Arr(v)
}

fn numeric_j(t: ref Node) -> Vec[J] {
    vec![J.Text(t.repr.clone()), J.Float(t.num), text_j(if t.ival.is_some() { "integer" } else { "number" })]
}

// to_json() of test_tinycss2.py
fn node_j(n: ref Node) -> J {
    let ty = n.ty.as_str();
    if ty == "error" {
        return J.Arr(vec![text_j("error"), J.Text(n.value.clone())]);
    }
    if ty == "comment" {
        return text_j("/* \u{2026} */");
    }
    if ty == "whitespace" {
        return text_j(" ");
    }
    if ty == "literal" {
        return J.Text(n.value.clone());
    }
    if ty == "ident" or ty == "at-keyword" or ty == "string" or ty == "url" {
        return J.Arr(vec![J.Text(n.ty.clone()), J.Text(n.value.clone())]);
    }
    if ty == "hash" {
        return J.Arr(vec![text_j("hash"), J.Text(n.value.clone()), text_j(if n.flag { "id" } else { "unrestricted" })]);
    }
    if ty == "number" or ty == "percentage" {
        return tagged(ty, numeric_j(n));
    }
    if ty == "dimension" {
        let mut rest = numeric_j(n);
        rest.push(J.Text(n.unit.clone()));
        return tagged(ty, rest);
    }
    if ty == "unicode-range" {
        return J.Arr(vec![text_j("unicode-range"), J.Int(n.start), J.Int(n.end)]);
    }
    if ty == "{} block" {
        return tagged("{}", nodes_j(n.kids));
    }
    if ty == "[] block" {
        return tagged("[]", nodes_j(n.kids));
    }
    if ty == "() block" {
        return tagged("()", nodes_j(n.kids));
    }
    if ty == "function" {
        let mut rest = vec![J.Text(n.value.clone())];
        rest.extend(nodes_j(n.kids));
        return tagged("function", rest);
    }
    if ty == "declaration" {
        return J.Arr(vec![text_j("declaration"), J.Text(n.value.clone()), J.Arr(nodes_j(n.kids)), J.Bool(n.flag)]);
    }
    let content = match n.content {
        None => J.Null,
        Some(c) => J.Arr(nodes_j(c)),
    };
    if ty == "at-rule" {
        return J.Arr(vec![text_j("at-rule"), J.Text(n.value.clone()), J.Arr(nodes_j(n.kids)), content]);
    }
    J.Arr(vec![text_j("qualified rule"), J.Arr(nodes_j(n.kids)), content])
}

fn number_text(v: Option[f64]) -> String {
    match v {
        None => "none".to_string(),
        Some(x) => {
            let r = py_round6(x + 0.0000001);
            if is_integer(r) { int_text(r) } else { py_float(r) }
        }
    }
}

fn rgb_string(coords: ref Vec[Option[f64]], alpha: f64) -> Result[String, PyErr] {
    let mut parts: Vec[String] = Vec.new();
    for c in coords.iter() {
        match c {
            None => return Err(py_err("TypeError", "unsupported operand type(s) for *: 'NoneType' and 'int'")),
            Some(x) => parts.push(number_text(Some(*x * 255.0))),
        }
    }
    let mut out = if alpha != 1.0 { "rgba(".to_string() } else { "rgb(".to_string() };
    out.push_str(parts.join(", "));
    if alpha != 1.0 {
        out.push_str(f", {number_text(Some(alpha))}");
    }
    out.push(')');
    Ok(out)
}

fn space_string(c: ref Color) -> String {
    let mut parts: Vec[String] = Vec.new();
    for x in c.coords.iter() {
        parts.push(number_text(*x));
    }
    let mut out = f"{c.space}({parts.join(" ")}";
    if c.alpha != 1.0 {
        out.push_str(f" / {number_text(Some(c.alpha))}");
    }
    out.push(')');
    out
}

fn one_token(css: ref String) -> Node {
    let mut s = stream_css(css, true);
    parse_one_component_value(mut s)
}

fn no_space() -> PyErr {
    py_err("AttributeError", "'str' object has no attribute 'space'")
}

fn t_function_4(css: ref String) -> Result[J, PyErr] {
    match parse_color4(one_token(css)) {
        C4.Nothing => Ok(J.Null),
        C4.Raised(e) => Err(e),
        C4.Current => Err(no_space()),
        C4.Col(c) => {
            let mut out = f"color({c.space}";
            for x in c.coords.iter() {
                out.push_str(f" {number_text(*x)}");
            }
            if c.alpha != 1.0 {
                out.push_str(f" / {number_text(Some(c.alpha))}");
            }
            out.push(')');
            Ok(J.Text(out))
        }
    }
}

fn t_rgb3(css: ref String) -> Result[J, PyErr] {
    match parse_color3(one_token(css)) {
        C3.Nothing => Ok(J.Null),
        C3.Current => Ok(text_j("currentColor")),
        C3.Rgba(v) => Ok(J.Text(rgb_string(plain(vec![v[0], v[1], v[2]]), v[3])?)),
    }
}

fn assertion() -> PyErr {
    py_err("AssertionError", "")
}

fn t_rgb4(css: ref String, space: Str, convert: bool) -> Result[J, PyErr] {
    match parse_color4(one_token(css)) {
        C4.Nothing => Ok(J.Null),
        C4.Raised(e) => Err(e),
        C4.Current => Ok(text_j("currentcolor")),
        C4.Col(c) => {
            if c.space != space {
                return Err(assertion());
            }
            let s = if convert { color_to(c, "srgb")? } else { c };
            Ok(J.Text(rgb_string(s.coords, s.alpha)?))
        }
    }
}

fn t_space4(css: ref String, space: Str) -> Result[J, PyErr] {
    match parse_color4(one_token(css)) {
        C4.Nothing => Ok(J.Null),
        C4.Raised(e) => Err(e),
        C4.Current => Ok(text_j("currentcolor")),
        C4.Col(c) => {
            if c.space != space {
                return Err(assertion());
            }
            Ok(J.Text(space_string(c)))
        }
    }
}

fn opt_text(j: ref J) -> Option[String] {
    jtext(j)
}

fn t_bytes(kwargs: ref J) -> Result[J, PyErr] {
    let text = jtext(jget(kwargs, "css_bytes")).unwrap_or(String.new());
    // .encode('latin1')
    let mut data: Vec[u8] = Vec.new();
    for c in text.chars() {
        data.push(c as u32 as u8);
    }
    let protocol = opt_text(jget(kwargs, "protocol_encoding"));
    let mut environment: Option[String] = None;
    if let Some(e) = opt_text(jget(kwargs, "environment_encoding")) {
        if not e.is_empty() {
            environment = lookup(e);
        }
    }
    let (css, encoding) = decode_stylesheet_bytes(data, protocol, environment)?;
    let mut s = stream_css(css, true);
    let rules = parse_stylesheet(mut s, true, true);
    Ok(J.Arr(vec![J.Arr(nodes_j(rules)), J.Text(encoding)]))
}

fn nth_j(r: own Nth) -> Result[J, PyErr] {
    match r {
        Nth.Nothing => Ok(J.Null),
        Nth.Pair(a, b) => Ok(J.Arr(vec![J.Int(a), J.Int(b)])),
        Nth.Raised(e) => Err(e.clone()),
    }
}

fn run_case(suite: Str, input: ref J) -> Result[J, PyErr] {
    if suite == "stylesheet_bytes" {
        return t_bytes(input);
    }
    let css = jtext(input).unwrap_or(String.new());
    if suite == "component_value_list" {
        return Ok(J.Arr(nodes_j(parse_component_value_list(css, true))));
    }
    if suite == "serialization" {
        let parsed = parse_component_value_list(css, true);
        return Ok(J.Arr(nodes_j(parse_component_value_list(serialize(parsed), true))));
    }
    if suite == "nth" {
        let mut s = stream_css(css, true);
        return nth_j(parse_nth(mut s));
    }
    if suite == "color_function_4" {
        return t_function_4(css);
    }
    if suite == "color_hexadecimal_3" or suite == "color_hsl_3" or suite == "color_keywords_3" {
        return t_rgb3(css);
    }
    if suite == "color_hexadecimal_4" or suite == "color_hexadecimal_3_with_4" or suite == "color_keywords_3_with_4" or suite == "color_keywords_4" {
        return t_rgb4(css, "srgb", false);
    }
    if suite == "color_hsl_3_with_4" or suite == "color_hsl_4" {
        return t_rgb4(css, "hsl", true);
    }
    if suite == "color_hwb_4" {
        return t_rgb4(css, "hwb", true);
    }
    if suite == "color_lab_4" {
        return t_space4(css, "lab");
    }
    if suite == "color_oklab_4" {
        return t_space4(css, "oklab");
    }
    if suite == "color_lch_4" {
        return t_space4(css, "lch");
    }
    if suite == "color_oklch_4" {
        return t_space4(css, "oklch");
    }
    let mut s = stream_css(css, true);
    if suite == "one_component_value" {
        return Ok(node_j(parse_one_component_value(mut s)));
    }
    if suite == "declaration_list" {
        return Ok(J.Arr(nodes_j(parse_declaration_list(mut s, true, true))));
    }
    if suite == "blocks_contents" {
        return Ok(J.Arr(nodes_j(parse_blocks_contents(mut s, true, true))));
    }
    if suite == "one_declaration" {
        return Ok(node_j(parse_one_declaration(mut s)));
    }
    if suite == "stylesheet" {
        return Ok(J.Arr(nodes_j(parse_stylesheet(mut s, true, true))));
    }
    if suite == "rule_list" {
        return Ok(J.Arr(nodes_j(parse_rule_list(mut s, true, true))));
    }
    Ok(node_j(parse_one_rule(mut s)))
}

// (suite, file) in the order oracle.py runs them.
fn suites() -> Vec[(Str, Str)] {
    vec![
        ("component_value_list", "component_value_list.json"),
        ("one_component_value", "one_component_value.json"),
        ("declaration_list", "declaration_list.json"),
        ("blocks_contents", "blocks_contents.json"),
        ("one_declaration", "one_declaration.json"),
        ("stylesheet", "stylesheet.json"),
        ("rule_list", "rule_list.json"),
        ("one_rule", "one_rule.json"),
        ("nth", "An+B.json"),
        ("color_function_4", "color_function_4.json"),
        ("color_hexadecimal_3", "color_hexadecimal_3.json"),
        ("color_hexadecimal_4", "color_hexadecimal_4.json"),
        ("color_hexadecimal_3_with_4", "color_hexadecimal_3.json"),
        ("color_hsl_3", "color_hsl_3.json"),
        ("color_hsl_3_with_4", "color_hsl_3.json"),
        ("color_hsl_4", "color_hsl_4.json"),
        ("color_hwb_4", "color_hwb_4.json"),
        ("color_keywords_3", "color_keywords_3.json"),
        ("color_keywords_3_with_4", "color_keywords_3.json"),
        ("color_keywords_4", "color_keywords_4.json"),
        ("color_lab_4", "color_lab_4.json"),
        ("color_oklab_4", "color_oklab_4.json"),
        ("color_lch_4", "color_lch_4.json"),
        ("color_oklch_4", "color_oklch_4.json"),
        ("stylesheet_bytes", "stylesheet_bytes.json"),
        ("serialization", "component_value_list.json"),
    ]
}

fn run_suites() -> Result[(), String] {
    let mut total = 0;
    let mut same = 0;
    for (name, file) in suites().iter() {
        let data = parse_json(read_data(f"data/{file}")?);
        let items = match data {
            J.Arr(v) => v,
            _ => Vec.new(),
        };
        let mut matched = 0;
        let mut i = 0;
        while i + 1 < items.len() {
            let text = match run_case(*name, items[i]) {
                Ok(value) => {
                    if json_eq(value, items[i + 1]) {
                        matched += 1;
                    }
                    dumps(value)
                }
                Err(e) => f"raised {e.ty}: {e.msg}",
            };
            println(f"{name} {i / 2 + 1}: {text}");
            i += 2;
        }
        let cases = items.len() / 2;
        println(f"== {name}: {cases} cases, {matched} as expected");
        total += cases;
        same += matched;
    }
    println(f"== suites: {total} cases, {same} as expected");
    Ok(())
}

// ---------------------------------------------------------------- audit

fn nth_names() -> Vec[Str] {
    vec!["nth-child", "nth-last-child", "nth-of-type", "nth-last-of-type"]
}

// At-rules whose block holds rules rather than declarations.
fn rule_blocks() -> Vec[Str] {
    vec!["media", "supports", "layer", "document", "container", "keyframes"]
}

fn trim(tokens: ref Vec[Node]) -> Vec[Node] {
    let mut a = 0;
    let mut b = tokens.len();
    while a < b and is_blank(tokens[a]) {
        a += 1;
    }
    while b > a and is_blank(tokens[b - 1]) {
        b -= 1;
    }
    let mut out: Vec[Node] = Vec.new();
    let mut i = a;
    while i < b {
        out.push(tokens[i].clone());
        i += 1;
    }
    out
}

fn ser_trim(tokens: ref Vec[Node]) -> String {
    serialize(trim(tokens))
}

fn channel_byte(v: f64) -> i64 {
    py_max(0.0, py_min(255.0, (v * 255.0 + 0.5).floor())) as i64
}

// A color as the audit prints it, and its sRGB form when it has one.
// `c` is None for currentcolor.
fn describe(c: ref Option[Color]) -> Result[(String, Option[Color]), PyErr] {
    let color = match c {
        None => return Ok(("currentcolor".to_string(), None)),
        Some(x) => x,
    };
    let sp = color.space.as_str();
    if sp == "srgb" or sp == "hsl" or sp == "hwb" {
        let s = color_to(color, "srgb")?;
        let mut hex = "#".to_string();
        for x in s.coords.iter() {
            hex.push_str(hex2_lower(channel_byte(x.unwrap_or(0.0))));
        }
        if s.alpha != 1.0 {
            hex.push_str(hex2_lower(channel_byte(s.alpha)));
        }
        return Ok((hex, Some(s)));
    }
    if one_of(color.space, vec!["lab", "lch", "oklab", "oklch", "xyz-d50", "xyz-d65"]) {
        return Ok((space_string(color_to(color, "lab")?), None));
    }
    Ok((f"{color.space} (not converted)", None))
}

fn luminance(s: ref Color) -> f64 {
    let mut lin: Vec[f64] = Vec.new();
    for x in s.coords.iter() {
        let c = x.unwrap_or(0.0);
        lin.push(if c <= 0.04045 { c / 12.92 } else { ((c + 0.055) / 1.055).pow(2.4) });
    }
    0.2126 * lin[0] + 0.7152 * lin[1] + 0.0722 * lin[2]
}

// parse_color4 on a token: Some(None) for currentcolor.
fn color_of(t: ref Node) -> Result[Option[Option[Color]], PyErr] {
    match parse_color4(t) {
        C4.Nothing => Ok(None),
        C4.Current => Ok(Some(None)),
        C4.Col(c) => Ok(Some(Some(c))),
        C4.Raised(e) => Err(e),
    }
}

fn find_colors(tokens: ref Vec[Node], found: mut ref Vec[Option[Color]]) -> Result[(), PyErr] {
    for t in tokens.iter() {
        if t.ty == "ident" or t.ty == "hash" or t.ty == "function" {
            if let Some(c) = color_of(t)? {
                found.push(c);
                continue;
            }
        }
        if t.ty == "function" {
            find_colors(t.kids, mut found)?;
        } else if t.ty == "() block" or t.ty == "[] block" {
            find_colors(t.kids, mut found)?;
        }
    }
    Ok(())
}

fn find_urls(tokens: ref Vec[Node], found: mut ref Vec[String]) {
    for t in tokens.iter() {
        if t.ty == "url" {
            found.push(t.value.clone());
        } else if t.ty == "function" {
            if t.lower == "url" {
                let args = trim(t.kids);
                if args.len() == 1 and args[0].ty == "string" {
                    found.push(args[0].value.clone());
                }
            } else {
                find_urls(t.kids, mut found);
            }
        } else if t.ty == "() block" or t.ty == "[] block" or t.ty == "{} block" {
            find_urls(t.kids, mut found);
        }
    }
}

fn find_vars(tokens: ref Vec[Node], found: mut ref Vec[String]) {
    for t in tokens.iter() {
        if t.ty == "function" {
            if t.lower == "var" {
                let args = trim(t.kids);
                if not args.is_empty() and args[0].ty == "ident" {
                    found.push(args[0].value.clone());
                }
            }
            find_vars(t.kids, mut found);
        } else if t.ty == "() block" or t.ty == "[] block" {
            find_vars(t.kids, mut found);
        }
    }
}

fn find_errors(tokens: ref Vec[Node], found: mut ref Vec[Node]) {
    for t in tokens.iter() {
        if t.ty == "error" {
            found.push(t.clone());
        } else if t.ty == "function" or t.ty == "() block" or t.ty == "[] block" or t.ty == "{} block" {
            find_errors(t.kids, mut found);
        }
    }
}

fn nth_examples(a: i64, b: i64) -> Vec[i64] {
    let mut seen: Vec[i64] = Vec.new();
    let mut n = 0;
    while n < 40 {
        let i = a * n + b;
        if i >= 1 and not seen.contains(i) {
            seen.push(i);
        }
        n += 1;
    }
    seen.sort();
    seen.truncate(6);
    seen
}

fn find_nth(tokens: ref Vec[Node], ind: ref String) {
    for t in tokens.iter() {
        if t.ty == "function" {
            if one_of(t.lower, nth_names()) {
                let mut s = stream_of(t.kids.clone());
                let arg = ser_trim(t.kids);
                match parse_nth(mut s) {
                    Nth.Pair(a, b) => {
                        let mut shown: Vec[String] = Vec.new();
                        for i in nth_examples(a, b).iter() {
                            shown.push(f"{i}");
                        }
                        let list = if shown.is_empty() { "nothing".to_string() } else { shown.join(", ") };
                        println(f"{ind}:{t.value}({arg}) a={a} b={b} matches {list}");
                    }
                    _ => println(f"{ind}:{t.value}({arg}) is not a valid An+B"),
                }
            }
            find_nth(t.kids, ind);
        } else if t.ty == "() block" or t.ty == "[] block" {
            find_nth(t.kids, ind);
        }
    }
}

struct Sheet {
    rules: i64,
    declarations: i64,
    important: i64,
    defined: Vec[String],
    used: Vec[String],
    urls: Vec[String],
    errors: i64,
    low_contrast: i64,
}

// The declaration of `name` that wins in one rule: the last, unless an
// earlier one is !important and it is not.
fn winner(decls: ref Vec[Node], name: Str) -> Option[Node] {
    let mut best: Option[Node] = None;
    for d in decls.iter() {
        if d.lower == name {
            let take = match ref best {
                None => true,
                Some(b) => d.flag or not b.flag,
            };
            if take {
                best = Some(d.clone());
            }
        }
    }
    best
}

fn single_color(d: Option[Node]) -> Result[Option[Color], PyErr] {
    let d = match d {
        None => return Ok(None),
        Some(x) => x,
    };
    let vals = trim(d.kids);
    if vals.len() != 1 {
        return Ok(None);
    }
    let c = match color_of(vals[0])? {
        None => return Ok(None),
        Some(None) => return Ok(None),
        Some(Some(c)) => c,
    };
    let (_, s) = describe(Some(c))?;
    match s {
        Some(x) => Ok(if x.alpha != 1.0 { None } else { Some(x) }),
        None => Ok(None),
    }
}

fn bump(palette: mut ref Vec[(String, i64)], text: ref String) {
    let mut i = 0;
    while i < palette.len() {
        if palette[i].0 == *text {
            palette[i].1 += 1;
            return;
        }
        i += 1;
    }
    palette.push((text.clone(), 1));
}

fn print_error(ind: ref String, e: ref Node) {
    println(f"{ind}{e.line}:{e.col} error {e.value}: {e.message}");
}

fn audit_declarations(sheet: mut ref Sheet, nodes: Vec[Node], ind: ref String, palette: mut ref Vec[(String, i64)]) -> Result[(), PyErr] {
    let mut decls: Vec[Node] = Vec.new();
    let mut seen: Vec[(String, i64)] = Vec.new();
    for d in nodes.iter() {
        if d.ty == "error" {
            sheet.errors += 1;
            print_error(ind, d);
            continue;
        }
        if d.ty != "declaration" {
            println(f"{ind}nested {d.ty} at {d.line}:{d.col}");
            continue;
        }
        sheet.declarations += 1;
        decls.push(d.clone());
        let mut line = f"{ind}{d.value}: {ser_trim(d.kids)}";
        if d.flag {
            sheet.important += 1;
            line.push_str(" !important");
        }
        println(line);
        let mut k = 0;
        let mut found = false;
        while k < seen.len() {
            if seen[k].0 == d.lower {
                println(f"{ind}  duplicate of line {seen[k].1}");
                seen[k].1 = d.line;
                found = true;
            }
            k += 1;
        }
        if not found {
            seen.push((d.lower.clone(), d.line));
        }
        if d.value.starts_with("--") {
            sheet.defined.push(d.value.clone());
        }
        let mut colors: Vec[Option[Color]] = Vec.new();
        find_colors(d.kids, mut colors)?;
        for c in colors.iter() {
            let (text, _) = describe(c)?;
            bump(mut palette, text);
            println(f"{ind}  color {text}");
        }
        if d.lower == "unicode-range" {
            let mut total = 0;
            let mut n = 0;
            for t in d.kids.iter() {
                if t.ty == "unicode-range" {
                    n += 1;
                    total += t.end - t.start + 1;
                }
            }
            println(f"{ind}  {n} ranges, {total} code points");
        }
        find_urls(d.kids, mut sheet.urls);
        find_vars(d.kids, mut sheet.used);
        let mut errs: Vec[Node] = Vec.new();
        find_errors(d.kids, mut errs);
        for e in errs.iter() {
            sheet.errors += 1;
            print_error(f"{ind}  ", e);
        }
    }
    let fg = single_color(winner(decls, "color"))?;
    let mut bg = single_color(winner(decls, "background-color"))?;
    if bg.is_none() {
        bg = single_color(winner(decls, "background"))?;
    }
    if let Some(f) = fg {
        if let Some(b) = bg {
            let mut l1 = luminance(f);
            let mut l2 = luminance(b);
            if l1 < l2 {
                let t = l1;
                l1 = l2;
                l2 = t;
            }
            let ratio = (l1 + 0.05) / (l2 + 0.05);
            let verdict = if ratio >= 7.0 { "AAA" } else if ratio >= 4.5 { "AA" } else if ratio >= 3.0 { "AA large" } else { "FAIL" };
            if verdict == "FAIL" or verdict == "AA large" {
                sheet.low_contrast += 1;
            }
            println(f"{ind}contrast {ratio:.2}:1 {verdict}");
        }
    }
    Ok(())
}

fn blocks_of(content: ref Vec[Node]) -> Vec[Node] {
    let mut s = stream_of(content.clone());
    parse_blocks_contents(mut s, true, true)
}

fn rules_of(content: ref Vec[Node]) -> Vec[Node] {
    let mut s = stream_of(content.clone());
    parse_rule_list(mut s, true, true)
}

fn audit_rules(sheet: mut ref Sheet, rules: ref Vec[Node], ind: ref String, palette: mut ref Vec[(String, i64)]) -> Result[(), PyErr] {
    for r in rules.iter() {
        if r.ty == "error" {
            sheet.errors += 1;
            print_error(ind, r);
            continue;
        }
        sheet.rules += 1;
        let prelude = ser_trim(r.kids);
        let inner = f"{ind}  ";
        if r.ty == "at-rule" {
            let tail = if r.content.is_none() { ";" } else { " {" };
            println(f"{ind}{r.line}:{r.col} @{r.value} {prelude}{tail}");
            if r.lower == "import" {
                find_urls(r.kids, mut sheet.urls);
                let first = trim(r.kids);
                if not first.is_empty() and first[0].ty == "string" {
                    sheet.urls.push(first[0].value.clone());
                }
            }
            if let Some(content) = r.content {
                if one_of(r.lower, rule_blocks()) {
                    audit_rules(mut sheet, rules_of(content), inner, mut palette)?;
                } else {
                    audit_declarations(mut sheet, blocks_of(content), inner, mut palette)?;
                }
                println(f"{ind}}}");
            }
        } else {
            println(f"{ind}{r.line}:{r.col} {prelude} {{");
            find_nth(r.kids, inner);
            let mut errs: Vec[Node] = Vec.new();
            find_errors(r.kids, mut errs);
            for e in errs.iter() {
                sheet.errors += 1;
                print_error(inner, e);
            }
            audit_declarations(mut sheet, blocks_of(r.content.clone().unwrap_or(Vec.new())), inner, mut palette)?;
            println(f"{ind}}}");
        }
    }
    Ok(())
}

fn minify_declarations(nodes: ref Vec[Node]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for d in nodes.iter() {
        if d.ty == "declaration" {
            let mut p = f"{serialize_identifier(d.value)}:{ser_trim(d.kids)}";
            if d.flag {
                p.push_str("!important");
            }
            parts.push(p);
        } else if d.ty == "qualified-rule" {
            parts.push(minify(vec![d.clone()]));
        }
    }
    parts.join(";")
}

fn minify(rules: ref Vec[Node]) -> String {
    let mut out = String.new();
    for r in rules.iter() {
        if r.ty == "qualified-rule" {
            let content = r.content.clone().unwrap_or(Vec.new());
            out.push_str(f"{ser_trim(r.kids)}{{{minify_declarations(blocks_of(content))}}}");
        } else if r.ty == "at-rule" {
            let prelude = ser_trim(r.kids);
            let mut head = f"@{serialize_identifier(r.value)}";
            if not prelude.is_empty() {
                head.push(' ');
                head.push_str(prelude);
            }
            match r.content {
                None => out.push_str(f"{head};"),
                Some(c) => {
                    if one_of(r.lower, rule_blocks()) {
                        out.push_str(f"{head}{{{minify(rules_of(c))}}}");
                    } else {
                        out.push_str(f"{head}{{{minify_declarations(blocks_of(c))}}}");
                    }
                }
            }
        }
    }
    out
}

fn read_bytes_of(path: ref String) -> Result[Vec[u8], String] {
    match fs.read_bytes(path.clone()) {
        Ok(b) => Ok(b),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

fn audit_sheet(name: ref String, protocol: ref String, environment: ref String, palette: mut ref Vec[(String, i64)]) -> Result[(), String] {
    let data = read_bytes_of(f"data/sheets/{name}")?;
    let p: Option[String] = if protocol.is_empty() { None } else { Some(protocol.clone()) };
    let e: Option[String] = if environment.is_empty() { None } else { lookup(environment) };
    let (css, encoding) = match decode_stylesheet_bytes(data, p, e) {
        Ok(x) => x,
        Err(err) => return Err(f"{err.ty}: {err.msg}"),
    };
    let mut s = stream_css(css, true);
    let rules = parse_stylesheet(mut s, true, true);
    println(f"== sheet {name}: {data.len()} bytes, {encoding}");
    let mut sheet = Sheet {
        rules: 0,
        declarations: 0,
        important: 0,
        defined: Vec.new(),
        used: Vec.new(),
        urls: Vec.new(),
        errors: 0,
        low_contrast: 0,
    };
    if let Err(err) = audit_rules(mut sheet, rules, "  ", mut palette) {
        return Err(f"{err.ty}: {err.msg}");
    }
    let mut undefined: Vec[String] = Vec.new();
    for v in sheet.used.iter() {
        if not sheet.defined.contains(v) and not undefined.contains(v) {
            undefined.push(v.clone());
        }
    }
    println(f"  {sheet.rules} rules, {sheet.declarations} declarations ({sheet.important} !important), {sheet.errors} errors, {sheet.low_contrast} low-contrast pairs");
    let undef = if undefined.is_empty() { "none".to_string() } else { undefined.join(", ") };
    println(f"  custom properties: {sheet.defined.len()} defined, {sheet.used.len()} used, undefined: {undef}");
    let mut quoted: Vec[String] = Vec.new();
    for u in sheet.urls.iter() {
        quoted.push(json_str(u));
    }
    let urls = if quoted.is_empty() { "none".to_string() } else { quoted.join(", ") };
    println(f"  urls: {urls}");
    let text = minify(rules);
    let n = char_count(text);
    println(f"  minified to {n} characters");
    if n <= 400 {
        println(f"  {text}");
    }
    Ok(())
}

fn audit(listing: ref String) -> Result[(), String] {
    let mut palette: Vec[(String, i64)] = Vec.new();
    for line in listing.lines() {
        if line.trim().is_empty() {
            continue;
        }
        let cols: Vec[String] = line.split("\t").map(|x| x.to_string()).collect();
        audit_sheet(cols[0], cols[1], cols[2], mut palette)?;
    }
    println("== palette");
    // sorted by count, most first, then by text
    let mut i = 1;
    while i < palette.len() {
        let mut j = i;
        while j > 0 and (palette[j].1 > palette[j - 1].1 or (palette[j].1 == palette[j - 1].1 and palette[j].0 < palette[j - 1].0)) {
            palette.swap(j, j - 1);
            j -= 1;
        }
        i += 1;
    }
    for (text, n) in palette.iter() {
        println(f"  {pad_left(f"{n}", 3)} {text}");
    }
    Ok(())
}

// ---------------------------------------------------------------- main

fn bytes_of(s: ref String) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for b in s.bytes() {
        v.push(*b);
    }
    v
}

fn unhex(s: ref String) -> Vec[u8] {
    let cs = chars_of(s);
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < cs.len() {
        out.push((hex_val(cs[i]) * 16 + hex_val(cs[i + 1])) as u8);
        i += 2;
    }
    out
}

fn write_data() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data/sheets".to_string()) {
        return Err(f"cannot create data/sheets: {e}");
    }
    for (name, text, hex) in data_files().into_iter() {
        let path = f"data/{name}";
        let body = if hex { unhex(text) } else { bytes_of(text) };
        if let Err(e) = fs.write_bytes(path.clone(), body) {
            return Err(f"cannot write {path}: {e}");
        }
    }
    Ok(())
}

fn read_data(path: ref String) -> Result[String, String] {
    match fs.read_to_string(path.clone()) {
        Ok(t) => Ok(t),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

fn run() -> Result[(), String] {
    write_data()?;
    run_suites()?;
    audit(read_data("data/sheets/sheets.tsv")?)?;
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"error: {e}");
    }
}

