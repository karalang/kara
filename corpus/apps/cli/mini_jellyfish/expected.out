== vectors testdata/damerau_levenshtein.csv
damerau_levenshtein('', '') = 0, expected '0'
damerau_levenshtein('abc', '') = 3, expected '3'
damerau_levenshtein('bc', 'abc') = 1, expected '1'
damerau_levenshtein('fuor', 'four') = 1, expected '1'
damerau_levenshtein('abcd', 'acb') = 2, expected '2'
damerau_levenshtein('cape sand recycling ', 'edith ann graham') = 17, expected '17'
damerau_levenshtein('jellyifhs', 'jellyfish') = 2, expected '2'
damerau_levenshtein('ifhs', 'fish') = 2, expected '2'
damerau_levenshtein('Hello, world!', 'Hello,Â\xa0world!') = 2, expected '2'
== vectors testdata/hamming.csv
hamming('', '') = 0, expected '0'
hamming('', 'abc') = 3, expected '3'
hamming('abc', 'abc') = 0, expected '0'
hamming('acc', 'abc') = 1, expected '1'
hamming('abcd', 'abc') = 1, expected '1'
hamming('abc', 'abcd') = 1, expected '1'
hamming('testing', 'this is a test') = 13, expected '13'
hamming('Saturday', 'Sunday') = 7, expected '7'
