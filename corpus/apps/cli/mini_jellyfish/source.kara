fn data_part_1(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("vectors\ttestdata/damerau_levenshtein.csv\n");
    t.push_str("vectors\ttestdata/hamming.csv\n");
    t.push_str("vectors\ttestdata/jaro_distance.csv\n");
    t.push_str("vectors\ttestdata/jaro_winkler.csv\n");
    t.push_str("vectors\ttestdata/jaro_winkler_longtol.csv\n");
    t.push_str("vectors\ttestdata/levenshtein.csv\n");
    t.push_str("vectors\ttestdata/match_rating_codex.csv\n");
    t.push_str("vectors\ttestdata/match_rating_comparison.csv\n");
    t.push_str("vectors\ttestdata/metaphone.csv\n");
    t.push_str("vectors\ttestdata/nysiis.csv\n");
    t.push_str("vectors\ttestdata/soundex.csv\n");
    t.push_str("vectors\ttestdata/wagner_fischer.csv\n");
    t.push_str("encode\tnames.txt\n");
    t.push_str("compare\tpairs.tsv\n");
    t.push_str("dedupe\tcustomers0.csv\n");
    t.push_str("dedupe\tcustomers1.csv\n");
    t.push_str("dedupe\tcustomers2.csv\n");
    t.push_str("suggest\tcommands.txt\ttypos.txt\n");
    t.push_str("search\tsurnames.txt\tqueries.txt\n");
    t.push_str("lookup\tproducts.txt\tproduct_queries.txt\n");
    v.push(DataFile { path: "jobs.tsv".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("Robert\n");
    t.push_str("Rupert\n");
    t.push_str("Rubin\n");
    t.push_str("Ashcraft\n");
    t.push_str("Ashcroft\n");
    t.push_str("Tymczak\n");
