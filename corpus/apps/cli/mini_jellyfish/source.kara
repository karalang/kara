// mini_jellyfish: jellyfish 0.11.2, James Turk's approximate and
// phonetic string matching, as record linkage, search and "did you mean"
// code in Python uses it. It reads the job list from data/jobs.tsv:
// jellyfish's own test vectors, names to encode and pairs to compare, and
// four programs built on it (a customer-record deduplicator, a command
// suggester, a surname search and a fuzzy product lookup).
//
// The port follows jellyfish's pure-Python implementation, line for line,
// on strings as lists of characters, the way Python indexes a str. NFKD
// comes from nfkd_table(), generated from Python's unicodedata.

fn chars_of(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn from_chars(c: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut s = String.new();
    for i in lo..hi {
        s.push(c[i]);
    }
    s
}

fn str_of(c: ref Vec[char]) -> String {
    from_chars(c, 0, c.len())
}

fn nfkd(t: ref Map[char, String], s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        match t.get(c) {
            Some(d) => out.push_str(d),
            None => out.push(c),
        }
    }
    out
}

fn in_set(c: char, set: Str) -> bool {
    for x in set.chars() {
        if x == c {
            return true;
        }
    }
    false
}

fn min_i(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

fn max_i(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

// ------------------------------------------------------------ distances

fn levenshtein_distance(a: ref String, b: ref String) -> i64 {
    if a == b {
        return 0;
    }
    let s1 = chars_of(a);
    let s2 = chars_of(b);
    let rows = s1.len() + 1;
    let cols = s2.len() + 1;
    if s1.len() == 0 {
        return cols - 1;
    }
    if s2.len() == 0 {
        return rows - 1;
    }
    let mut cur: Vec[i64] = Vec.new();
    for c in 0..cols {
        cur.push(c);
    }
    for r in 1..rows {
        let prev = cur.clone();
        cur = Vec.new();
        cur.push(r);
        for _ in 1..cols {
            cur.push(0);
        }
        for c in 1..cols {
            let deletion = prev[c] + 1;
            let insertion = cur[c - 1] + 1;
            let edit = prev[c - 1] + (if s1[r - 1] == s2[c - 1] { 0 } else { 1 });
            cur[c] = min_i(min_i(edit, deletion), insertion);
        }
    }
    cur[cols - 1]
}

fn jaro_winkler_impl(a: ref String, b: ref String, long_tolerance: bool, winklerize: bool) -> f64 {
    let s1 = chars_of(a);
    let s2 = chars_of(b);
    let s1_len = s1.len();
    let s2_len = s2.len();
    if s1_len == 0 or s2_len == 0 {
        return 0.0;
    }
    let min_len = min_i(s1_len, s2_len);
    let mut search_range = max_i(s1_len, s2_len);
    search_range = search_range / 2 - 1;
    if search_range < 0 {
        search_range = 0;
    }
    let mut s1_flags: Vec[bool] = Vec.new();
    for _ in 0..s1_len {
        s1_flags.push(false);
    }
    let mut s2_flags: Vec[bool] = Vec.new();
    for _ in 0..s2_len {
        s2_flags.push(false);
    }
    let mut common: i64 = 0;
    for i in 0..s1_len {
        let low = max_i(0, i - search_range);
        let hi = min_i(i + search_range, s2_len - 1);
        let mut j = low;
        while j <= hi {
            if not s2_flags[j] and s2[j] == s1[i] {
                s1_flags[i] = true;
                s2_flags[j] = true;
                common += 1;
                break;
            }
            j += 1;
        }
    }
    if common == 0 {
        return 0.0;
    }
    let mut k = 0;
    let mut trans_count = 0;
    for i in 0..s1_len {
        if s1_flags[i] {
            let mut j = k;
            while j < s2_len {
                if s2_flags[j] {
                    k = j + 1;
                    break;
                }
                j += 1;
            }
            if s1[i] != s2[j] {
                trans_count += 1;
            }
        }
    }
    trans_count = trans_count / 2;
    let cc = common as f64;
    let mut weight = (cc / (s1_len as f64) + cc / (s2_len as f64) + (cc - (trans_count as f64)) / cc) / 3.0;
    if winklerize and weight > 0.7 {
        let j = min_i(min_len, 4);
        let mut i = 0;
        while i < j and s1[i] == s2[i] {
            i += 1;
        }
        if i > 0 {
            weight += (i as f64) * 0.1 * (1.0 - weight);
        }
        if long_tolerance and min_len > 4 and common > i + 1 and 2 * common >= min_len + i {
            weight += (1.0 - weight) * (((common - i - 1) as f64) / ((s1_len + s2_len - i * 2 + 2) as f64));
        }
    }
    weight
}

fn jaro_similarity(a: ref String, b: ref String) -> f64 {
    jaro_winkler_impl(a, b, false, false)
}

fn jaro_winkler_similarity(a: ref String, b: ref String, long_tolerance: bool) -> f64 {
    jaro_winkler_impl(a, b, long_tolerance, true)
}

fn damerau_levenshtein_distance(a: ref String, b: ref String) -> i64 {
    let s1 = chars_of(a);
    let s2 = chars_of(b);
    let len1 = s1.len();
    let len2 = s2.len();
    let infinite = len1 + len2;
    let mut da: Map[char, i64] = Map.new();
    let mut score: Vec[Vec[i64]] = Vec.new();
    for _ in 0..len1 + 2 {
        let mut row: Vec[i64] = Vec.new();
        for _ in 0..len2 + 2 {
            row.push(0);
        }
        score.push(row);
    }
    score[0][0] = infinite;
    for i in 0..len1 + 1 {
        score[i + 1][0] = infinite;
        score[i + 1][1] = i;
    }
    for i in 0..len2 + 1 {
        score[0][i + 1] = infinite;
        score[1][i + 1] = i;
    }
    for i in 1..len1 + 1 {
        let mut db = 0;
        for j in 1..len2 + 1 {
            let i1 = match da.get(s2[j - 1]) {
                Some(v) => *v,
                None => 0,
            };
            let j1 = db;
            let mut cost = 1;
            if s1[i - 1] == s2[j - 1] {
                cost = 0;
                db = j;
            }
            let a1 = score[i][j] + cost;
            let a2 = score[i + 1][j] + 1;
            let a3 = score[i][j + 1] + 1;
            let a4 = score[i1][j1] + (i - i1 - 1) + 1 + (j - j1 - 1);
            score[i + 1][j + 1] = min_i(min_i(a1, a2), min_i(a3, a4));
        }
        da.insert(s1[i - 1], i);
    }
    score[len1 + 1][len2 + 1]
}

fn hamming_distance(a: ref String, b: ref String) -> i64 {
    let mut s1 = chars_of(a);
    let mut s2 = chars_of(b);
    if s2.len() > s1.len() {
        let t = s1;
        s1 = s2;
        s2 = t;
    }
    let mut distance = s1.len() - s2.len();
    for i in 0..s2.len() {
        if s2[i] != s1[i] {
            distance += 1;
        }
    }
    distance
}

// ------------------------------------------------------------- phonetic

fn soundex_code(c: char) -> Option[char] {
    if in_set(c, "BFPV") {
        Some('1')
    } else if in_set(c, "CGJKQSXZ") {
        Some('2')
    } else if in_set(c, "DT") {
        Some('3')
    } else if c == 'L' {
        Some('4')
    } else if in_set(c, "MN") {
        Some('5')
    } else if c == 'R' {
        Some('6')
    } else {
        None
    }
}

fn soundex(t: ref Map[char, String], input: ref String) -> String {
    if input.len() == 0 {
        return "".to_string();
    }
    let s = chars_of(nfkd(t, input).to_uppercase());
    let mut result: Vec[char] = Vec.new();
    result.push(s[0]);
    let mut count = 1;
    let mut last = soundex_code(s[0]);
    for k in 1..s.len() {
        let letter = s[k];
        match soundex_code(letter) {
            Some(sub) => {
                if last != Some(sub) {
                    result.push(sub);
                    count += 1;
                }
                last = Some(sub);
            }
            None => {
                if letter != 'H' and letter != 'W' {
                    last = None;
                }
            }
        }
        if count == 4 {
            break;
        }
    }
    while count < 4 {
        result.push('0');
        count += 1;
    }
    str_of(result)
}

fn starts(s: ref Vec[char], p: Str) -> bool {
    let q = chars_of(p.to_string());
    if q.len() > s.len() {
        return false;
    }
    for i in 0..q.len() {
        if s[i] != q[i] {
            return false;
        }
    }
    true
}

fn ends(s: ref Vec[char], p: Str) -> bool {
    let q = chars_of(p.to_string());
    if q.len() > s.len() {
        return false;
    }
    let off = s.len() - q.len();
    for i in 0..q.len() {
        if s[off + i] != q[i] {
            return false;
        }
    }
    true
}

fn with_prefix(p: Str, s: ref Vec[char], drop: i64) -> Vec[char] {
    let mut out = chars_of(p.to_string());
    for i in drop..s.len() {
        out.push(s[i]);
    }
    out
}

fn with_suffix(s: ref Vec[char], drop: i64, p: Str) -> Vec[char] {
    let mut out: Vec[char] = Vec.new();
    for i in 0..s.len() - drop {
        out.push(s[i]);
    }
    for c in p.chars() {
        out.push(c);
    }
    out
}

fn last_char(s: ref String) -> char {
    let c = chars_of(s);
    c[c.len() - 1]
}

fn nysiis(input: ref String) -> String {
    if input.len() == 0 {
        return "".to_string();
    }
    let mut s = chars_of(input.to_uppercase());
    if starts(s, "MAC") {
        s = with_prefix("MCC", s, 3);
    } else if starts(s, "KN") {
        s = with_prefix("", s, 1);
    } else if starts(s, "K") {
        s = with_prefix("C", s, 1);
    } else if starts(s, "PH") or starts(s, "PF") {
        s = with_prefix("FF", s, 2);
    } else if starts(s, "SCH") {
        s = with_prefix("SSS", s, 3);
    }
    if ends(s, "IE") or ends(s, "EE") {
        s = with_suffix(s, 2, "Y");
    } else if ends(s, "DT") or ends(s, "RT") or ends(s, "RD") or ends(s, "NT") or ends(s, "ND") {
        s = with_suffix(s, 2, "D");
    }
    let mut key: Vec[String] = Vec.new();
    key.push(from_chars(s, 0, 1));
    let mut i = 1;
    let len_s = s.len();
    while i < len_s {
        let c = s[i];
        let mut ch = from_chars(s, i, i + 1);
        if c == 'E' and i + 1 < len_s and s[i + 1] == 'V' {
            ch = "AF".to_string();
            i += 1;
        } else if in_set(c, "AEIOU") {
            ch = "A".to_string();
        } else if c == 'Q' {
            ch = "G".to_string();
        } else if c == 'Z' {
            ch = "S".to_string();
        } else if c == 'M' {
            ch = "N".to_string();
        } else if c == 'K' {
            ch = if i + 1 < len_s and s[i + 1] == 'N' { "N".to_string() } else { "C".to_string() };
        } else if c == 'S' and i + 2 < len_s and s[i + 1] == 'C' and s[i + 2] == 'H' {
            ch = "SS".to_string();
            i += 2;
        } else if c == 'P' and i + 1 < len_s and s[i + 1] == 'H' {
            ch = "F".to_string();
            i += 1;
        } else if c == 'H' and (not in_set(s[i - 1], "AEIOU") or (i + 1 < len_s and not in_set(s[i + 1], "AEIOU")) or i + 1 == len_s) {
            ch = if in_set(s[i - 1], "AEIOU") { "A".to_string() } else { from_chars(s, i - 1, i) };
        } else if c == 'W' and in_set(s[i - 1], "AEIOU") {
            ch = from_chars(s, i - 1, i);
        }
        if last_char(ch) != last_char(key[key.len() - 1]) {
            key.push(ch);
        }
        i += 1;
    }
    let mut k = chars_of(key.join(""));
    if ends(k, "S") and not (k.len() == 1) {
        k = with_suffix(k, 1, "");
    }
    if ends(k, "AY") {
        k = with_suffix(k, 2, "Y");
    }
    if ends(k, "A") and not (k.len() == 1) {
        k = with_suffix(k, 1, "");
    }
    str_of(k)
}

fn match_rating_codex(input: ref String) -> String {
    let mut s: Vec[char] = Vec.new();
    for c in input.to_uppercase().chars() {
        if c != ' ' {
            s.push(c);
        }
    }
    let mut codex: Vec[char] = Vec.new();
    let mut prev: Option[char] = None;
    let mut first = true;
    for c in s {
        if first or (not in_set(c, "AEIOU") and prev != Some(c)) {
            codex.push(c);
        }
        prev = Some(c);
        first = false;
    }
    if codex.len() > 6 {
        let mut out = from_chars(codex, 0, 3);
        out.push_str(from_chars(codex, codex.len() - 3, codex.len()));
        out
    } else {
        str_of(codex)
    }
}

fn match_rating_comparison(a: ref String, b: ref String) -> Option[bool] {
    let codex1 = chars_of(match_rating_codex(a));
    let codex2 = chars_of(match_rating_codex(b));
    let len1 = codex1.len();
    let len2 = codex2.len();
    if len1 - len2 >= 3 or len2 - len1 >= 3 {
        return None;
    }
    let lensum = len1 + len2;
    let min_rating = if lensum <= 4 {
        5
    } else if lensum <= 7 {
        4
    } else if lensum <= 11 {
        3
    } else {
        2
    };
    let mut res1: Vec[char] = Vec.new();
    let mut res2: Vec[char] = Vec.new();
    for k in 0..max_i(len1, len2) {
        let c1 = if k < len1 { Some(codex1[k]) } else { None };
        let c2 = if k < len2 { Some(codex2[k]) } else { None };
        if c1 != c2 {
            if let Some(c) = c1 {
                res1.push(c);
            }
            if let Some(c) = c2 {
                res2.push(c);
            }
        }
    }
    let mut un1 = 0;
    let mut un2 = 0;
    let n1 = res1.len();
    let n2 = res2.len();
    for k in 0..max_i(n1, n2) {
        let c1 = if k < n1 { Some(res1[n1 - 1 - k]) } else { None };
        let c2 = if k < n2 { Some(res2[n2 - 1 - k]) } else { None };
        if c1 != c2 {
            if c1.is_some() {
                un1 += 1;
            }
            if c2.is_some() {
                un2 += 1;
            }
        }
    }
    Some(6 - max_i(un1, un2) >= min_rating)
}

// The '*****' metaphone uses past the end of the string: no character.
fn at_or_none(s: ref Vec[char], i: i64) -> char {
    if i < s.len() { s[i] } else { '\u{0}' }
}

fn metaphone(t: ref Map[char, String], input: ref String) -> String {
    let mut result: Vec[char] = Vec.new();
    let mut s = chars_of(nfkd(t, input.to_lowercase()));
    if starts(s, "kn") or starts(s, "gn") or starts(s, "pn") or starts(s, "wr") or starts(s, "ae") {
        s = with_prefix("", s, 1);
    }
    let mut i = 0;
    while i < s.len() {
        let c = s[i];
        let next = at_or_none(s, i + 1);
        let nextnext = at_or_none(s, i + 2);
        if c == next and c != 'c' {
            i += 1;
            continue;
        }
        if in_set(c, "aeiou") {
            if i == 0 or s[i - 1] == ' ' {
                result.push(c);
            }
        } else if c == 'b' {
            // `not (...) or next`: next is never empty, so always.
            result.push('b');
        } else if c == 'c' {
            if (next == 'i' and nextnext == 'a') or next == 'h' {
                result.push('x');
                i += 1;
            } else if in_set(next, "iey") {
                result.push('s');
                i += 1;
            } else {
                result.push('k');
            }
        } else if c == 'd' {
            if next == 'g' and in_set(nextnext, "iey") {
                result.push('j');
                i += 2;
            } else {
                result.push('t');
            }
        } else if in_set(c, "fjlmnr") {
            result.push(c);
        } else if c == 'g' {
            if in_set(next, "iey") {
                result.push('j');
            } else if next == 'h' and not in_set(nextnext, "aeiou") {
                i += 1;
            } else {
                // `next == 'n' and not nextnext` never holds.
                result.push('k');
            }
        } else if c == 'h' {
            if i == 0 or in_set(next, "aeiou") or not in_set(s[i - 1], "aeiou") {
                result.push('h');
            }
        } else if c == 'k' {
            if i == 0 or s[i - 1] != 'c' {
                result.push('k');
            }
        } else if c == 'p' {
            if next == 'h' {
                result.push('f');
                i += 1;
            } else {
                result.push('p');
            }
        } else if c == 'q' {
            result.push('k');
        } else if c == 's' {
            if next == 'h' {
                result.push('x');
                i += 1;
            } else if next == 'i' and in_set(nextnext, "oa") {
                result.push('x');
                i += 2;
            } else {
                result.push('s');
            }
        } else if c == 't' {
            if next == 'i' and in_set(nextnext, "oa") {
                result.push('x');
            } else if next == 'h' {
                result.push('0');
                i += 1;
            } else if next != 'c' or nextnext != 'h' {
                result.push('t');
            }
        } else if c == 'v' {
            result.push('f');
        } else if c == 'w' {
            if i == 0 and next == 'h' {
                i += 1;
                result.push('w');
            } else if in_set(next, "aeiou") {
                result.push('w');
            }
        } else if c == 'x' {
            if i == 0 {
                if next == 'h' or (next == 'i' and in_set(nextnext, "oa")) {
                    result.push('x');
                } else {
                    result.push('s');
                }
            } else {
                result.push('k');
                result.push('s');
            }
        } else if c == 'y' {
            if in_set(next, "aeiou") {
                result.push('y');
            }
        } else if c == 'z' {
            result.push('s');
        } else if c == ' ' {
            if result.len() > 0 and result[result.len() - 1] != ' ' {
                result.push(' ');
            }
        }
        i += 1;
    }
    str_of(result).to_uppercase()
}

// ----------------------------------------------------------- printing

fn hex_digits(n: i64, width: i64) -> String {
    let digits = chars_of("0123456789abcdef".to_string());
    let mut out: Vec[char] = Vec.new();
    let mut v = n;
    for _ in 0..width {
        out.push(digits[v % 16]);
        v = v / 16;
    }
    out.reverse();
    str_of(out)
}

// The characters Python's repr escapes, of those the data can hold:
// controls, the spaces other than ' ', and the format characters.
fn unprintable(c: char) -> bool {
    let o = c as i64;
    o < 0x20 or (o >= 0x7f and o <= 0xa0) or o == 0xad or (o >= 0x2000 and o <= 0x200f) or (o >= 0x2028 and o <= 0x202f) or (o >= 0x205f and o <= 0x2064) or o == 0x3000 or o == 0xfeff
}

// Python's repr of a str.
fn str_repr(s: ref String) -> String {
    let mut out = String.new();
    let q = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    out.push(q);
    for c in s.chars() {
        if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == q {
            out.push('\\');
            out.push(c);
        } else if unprintable(c) {
            let o = c as i64;
            if o < 0x100 {
                out.push_str(f"\\x{hex_digits(o, 2)}");
            } else {
                out.push_str(f"\\u{hex_digits(o, 4)}");
            }
        } else {
            out.push(c);
        }
    }
    out.push(q);
    out
}

fn bool_repr(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

fn opt_bool_repr(b: ref Option[bool]) -> String {
    match b {
        Some(v) => bool_repr(*v),
        None => "None".to_string(),
    }
}

fn emit(out: mut ref String, s: ref String) {
    out.push_str(s);
    out.push_str("\n");
}

fn lines_of(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == '\n' {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    if cur.len() > 0 {
        out.push(cur);
    }
    out
}

// csv.reader with the default dialect: quoted fields with "" inside.
fn csv_rows(text: ref String) -> Vec[Vec[String]] {
    let mut rows: Vec[Vec[String]] = Vec.new();
    for line in lines_of(text) {
        let c = chars_of(line);
        let mut row: Vec[String] = Vec.new();
        let mut field = String.new();
        let mut quoted = false;
        let mut i = 0;
        while i < c.len() {
            let ch = c[i];
            if quoted {
                if ch == '"' {
                    if i + 1 < c.len() and c[i + 1] == '"' {
                        field.push('"');
                        i += 1;
                    } else {
                        quoted = false;
                    }
                } else {
                    field.push(ch);
                }
            } else if ch == '"' {
                quoted = true;
            } else if ch == ',' {
                row.push(field);
                field = String.new();
            } else {
                field.push(ch);
            }
            i += 1;
        }
        row.push(field);
        rows.push(row);
    }
    rows
}

// ------------------------------------------------------------ vectors

fn base_name(rel: ref String) -> String {
    let c = chars_of(rel);
    let mut start = 0;
    for i in 0..c.len() {
        if c[i] == '/' {
            start = i + 1;
        }
    }
    from_chars(c, start, c.len() - 4)
}

fn vectors_job(t: ref Map[char, String], rel: ref String, out: mut ref String) {
    let name = base_name(rel);
    for row in csv_rows(read_text(rel)) {
        let a = row[0].clone();
        if name == "soundex" or name == "metaphone" or name == "nysiis" or name == "match_rating_codex" {
            let got = if name == "soundex" {
                soundex(t, a)
            } else if name == "metaphone" {
                metaphone(t, a)
            } else if name == "nysiis" {
                nysiis(a)
            } else {
                match_rating_codex(a)
            };
            emit(mut out, f"{name}({str_repr(a)}) = {str_repr(got)}, expected {str_repr(row[1])}");
            continue;
        }
        let b = row[1].clone();
        let got = if name == "levenshtein" or name == "wagner_fischer" {
            f"{levenshtein_distance(a, b)}"
        } else if name == "damerau_levenshtein" {
            f"{damerau_levenshtein_distance(a, b)}"
        } else if name == "hamming" {
            f"{hamming_distance(a, b)}"
        } else if name == "jaro_distance" {
            f"{jaro_similarity(a, b)}"
        } else if name == "jaro_winkler" {
            f"{jaro_winkler_similarity(a, b, false)}"
        } else if name == "jaro_winkler_longtol" {
            f"{jaro_winkler_similarity(a, b, true)}"
        } else {
            opt_bool_repr(match_rating_comparison(a, b))
        };
        emit(mut out, f"{name}({str_repr(a)}, {str_repr(b)}) = {got}, expected {str_repr(row[2])}");
    }
}

// ------------------------------------------------------ encode, compare

fn encode_job(t: ref Map[char, String], rel: ref String, out: mut ref String) {
    for name in lines_of(read_text(rel)) {
        emit(mut out, f"{str_repr(name)}: soundex={str_repr(soundex(t, name))} metaphone={str_repr(metaphone(t, name))} nysiis={str_repr(nysiis(name))} mrc={str_repr(match_rating_codex(name))}");
    }
}

fn split_tab(line: ref String) -> Vec[String] {
    line.split("\t").map(|p| p.to_string()).collect()
}

fn compare_job(t: ref Map[char, String], rel: ref String, out: mut ref String) {
    for line in lines_of(read_text(rel)) {
        let f = split_tab(line);
        let a = f[0].clone();
        let b = f[1].clone();
        emit(mut out, f"{str_repr(a)} {str_repr(b)}");
        emit(mut out, f"  levenshtein={levenshtein_distance(a, b)} damerau={damerau_levenshtein_distance(a, b)} hamming={hamming_distance(a, b)}");
        emit(mut out, f"  jaro={jaro_similarity(a, b)} jaro_winkler={jaro_winkler_similarity(a, b, false)} long={jaro_winkler_similarity(a, b, true)}");
        let same_s = soundex(t, a) == soundex(t, b);
        let same_m = metaphone(t, a) == metaphone(t, b);
        let same_n = nysiis(a) == nysiis(b);
        emit(mut out, f"  mra={opt_bool_repr(match_rating_comparison(a, b))} same_soundex={bool_repr(same_s)} same_metaphone={bool_repr(same_m)} same_nysiis={bool_repr(same_n)}");
    }
}

// ------------------------------------------------------------- dedupe

#[derive(Clone)]
struct Rec {
    id: i64,
    first: String,
    last: String,
    email: String,
    city: String,
}

fn find(parent: mut ref Vec[i64], x0: i64) -> i64 {
    let mut x = x0;
    while parent[x] != x {
        parent[x] = parent[parent[x]];
        x = parent[x];
    }
    x
}

fn local_part(email: ref String) -> String {
    let parts: Vec[String] = email.split("@").map(|p| p.to_string()).collect();
    parts[0].clone()
}

fn num(s: ref String) -> i64 {
    match i64.parse(s.clone()) {
        Ok(n) => n,
        Err(_) => 0,
    }
}

fn dedupe_job(t: ref Map[char, String], rel: ref String, out: mut ref String) {
    let mut recs: Vec[Rec] = Vec.new();
    let rows = csv_rows(read_text(rel));
    for k in 1..rows.len() {
        let r = rows[k].clone();
        recs.push(Rec { id: num(r[0]), first: r[1].clone(), last: r[2].clone(), email: r[3].clone(), city: r[4].clone() });
    }
    recs.sort_by(|a, b| a.id.cmp(b.id));
    let mut blocks: Map[String, Vec[i64]] = Map.new();
    for i in 0..recs.len() {
        let last = recs[i].last.trim().to_lowercase();
        for key in [f"S:{soundex(t, last)}", f"M:{metaphone(t, last)}"] {
            if not blocks.contains_key(key) {
                blocks.insert(key.clone(), Vec.new());
            }
            match blocks.get_mut(key) {
                Some(v) => v.push(i),
                None => {}
            }
        }
    }
    let mut pairs: Vec[(i64, i64)] = Vec.new();
    for (_, members) in blocks {
        for x in 0..members.len() {
            for y in x + 1..members.len() {
                pairs.push((members[x], members[y]));
            }
        }
    }
    pairs.sort();
    pairs.dedup();
    emit(mut out, f"{recs.len()} records, {blocks.len()} blocks, {pairs.len()} candidate pairs");
    let mut parent: Vec[i64] = Vec.new();
    for i in 0..recs.len() {
        parent.push(i);
    }
    for (i, j) in pairs {
        let a = recs[i].clone();
        let b = recs[j].clone();
        let jl = jaro_winkler_similarity(a.last.to_lowercase(), b.last.to_lowercase(), false);
        let jfi = jaro_winkler_similarity(a.first.to_lowercase(), b.first.to_lowercase(), false);
        let ed = damerau_levenshtein_distance(local_part(a.email), local_part(b.email));
        let mra = match_rating_comparison(a.last, b.last);
        let score = (0.5 * jl + 0.35 * jfi) + 0.15 * (1.0 - (min_i(ed, 5) as f64) / 5.0);
        let same = score >= 0.9 or (score >= 0.82 and mra == Some(true) and a.city == b.city);
        if same {
            let rj = find(mut parent, j);
            let ri = find(mut parent, i);
            parent[ri] = rj;
        }
        let verdict = if same { "MATCH" } else { "-" };
        emit(mut out, f"  {a.id}~{b.id} last={jl} first={jfi} email={ed} mra={opt_bool_repr(mra)} score={score} {verdict}");
    }
    // The groups, each sorted, in order of their first id.
    let mut groups: Vec[Vec[i64]] = Vec.new();
    for i in 0..recs.len() {
        if find(mut parent, i) != i {
            continue;
        }
        let mut g: Vec[i64] = Vec.new();
        for k in 0..recs.len() {
            if find(mut parent, k) == i {
                g.push(recs[k].id);
            }
        }
        if g.len() > 1 {
            g.sort();
            groups.push(g);
        }
    }
    groups.sort_by(|a, b| a[0].cmp(b[0]));
    emit(mut out, f"{groups.len()} duplicate groups");
    for g in groups {
        let mut parts: Vec[String] = Vec.new();
        for n in g {
            for r in recs {
                if r.id == n {
                    parts.push(f"{r.id} {r.first} {r.last} <{r.email}>");
                }
            }
        }
        emit(mut out, f"  {parts.join("; ")}");
    }
}

// ------------------------------------------------------------ suggest

// Sorts (distance, similarity, name) as Python sorts (d, -sim, name).
fn ranked_less(a: ref (i64, f64, String), b: ref (i64, f64, String)) -> bool {
    if a.0 != b.0 {
        return a.0 < b.0;
    }
    if a.1 != b.1 {
        return a.1 > b.1;
    }
    a.2 < b.2
}

fn sort_ranked(v: mut ref Vec[(i64, f64, String)]) {
    let mut i = 1;
    while i < v.len() {
        let mut j = i;
        while j > 0 and ranked_less(v[j], v[j - 1]) {
            v.swap(j, j - 1);
            j -= 1;
        }
        i += 1;
    }
}

fn suggest_job(cmds_rel: ref String, typos_rel: ref String, out: mut ref String) {
    let cmds = lines_of(read_text(cmds_rel));
    for t in lines_of(read_text(typos_rel)) {
        if cmds.contains(t) {
            emit(mut out, f"{t}: a command");
            continue;
        }
        let low = t.to_lowercase();
        let mut scored: Vec[(i64, f64, String)] = Vec.new();
        for c in cmds {
            let d = damerau_levenshtein_distance(low, c);
            if d <= 2 {
                scored.push((d, jaro_winkler_similarity(low, c, false), c.clone()));
            }
        }
        sort_ranked(mut scored);
        if scored.len() == 0 {
            emit(mut out, f"git: '{t}' is not a git command. See 'git --help'.");
            continue;
        }
        let tail = if scored.len() == 1 { " is" } else { "s are" };
        emit(mut out, f"git: '{t}' is not a git command. The most similar command{tail}");
        let mut k = 0;
        while k < scored.len() and k < 4 {
            let (d, s, c) = scored[k].clone();
            emit(mut out, f"        {c} (distance {d}, similarity {s})");
            k += 1;
        }
    }
}

// ------------------------------------------------------------- search

// Sorts (similarity, name) as Python sorts (-sim, name).
fn sort_by_sim(v: mut ref Vec[(f64, String)]) {
    let mut i = 1;
    while i < v.len() {
        let mut j = i;
        while j > 0 and (v[j].0 > v[j - 1].0 or (v[j].0 == v[j - 1].0 and v[j].1 < v[j - 1].1)) {
            v.swap(j, j - 1);
            j -= 1;
        }
        i += 1;
    }
}

fn joined_or_dash(v: ref Vec[String]) -> String {
    if v.len() == 0 { "-".to_string() } else { v.join(", ") }
}

fn search_job(t: ref Map[char, String], names_rel: ref String, queries_rel: ref String, out: mut ref String) {
    let names = lines_of(read_text(names_rel));
    for q in lines_of(read_text(queries_rel)) {
        emit(mut out, f"? {q}");
        for label in ["soundex", "nysiis", "metaphone"] {
            let code = if label == "soundex" { soundex(t, q) } else if label == "nysiis" { nysiis(q) } else { metaphone(t, q) };
            let mut hits: Vec[String] = Vec.new();
            for n in names {
                let c = if label == "soundex" { soundex(t, n) } else if label == "nysiis" { nysiis(n) } else { metaphone(t, n) };
                if c == code {
                    hits.push(n.clone());
                }
            }
            emit(mut out, f"  {label} {code}: {joined_or_dash(hits)}");
        }
        let mut mra: Vec[String] = Vec.new();
        for n in names {
            if match_rating_comparison(q, n) == Some(true) {
                mra.push(n.clone());
            }
        }
        emit(mut out, f"  match rating: {joined_or_dash(mra)}");
        let mut best: Vec[(f64, String)] = Vec.new();
        for n in names {
            best.push((jaro_winkler_similarity(q.to_lowercase(), n.to_lowercase(), false), n.clone()));
        }
        sort_by_sim(mut best);
        let mut parts: Vec[String] = Vec.new();
        for k in 0..min_i(3, best.len()) {
            parts.push(f"{best[k].1} {best[k].0}");
        }
        emit(mut out, f"  closest: {parts.join(", ")}");
    }
}

// ------------------------------------------------------------- lookup

fn tokens(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut word = String.new();
    for ch in s.to_lowercase().chars() {
        if ch.is_alphanumeric() {
            word.push(ch);
        } else if word.len() > 0 {
            out.push(word);
            word = String.new();
        }
    }
    if word.len() > 0 {
        out.push(word);
    }
    out
}

fn lookup_job(products_rel: ref String, queries_rel: ref String, out: mut ref String) {
    let products = lines_of(read_text(products_rel));
    for q in lines_of(read_text(queries_rel)) {
        let qt = tokens(q);
        let mut scored: Vec[(f64, String)] = Vec.new();
        for p in products {
            let pt = tokens(p);
            let mut total = 0.0;
            for w in qt {
                let mut best = 0.0;
                for v in pt {
                    let s = jaro_winkler_similarity(w, v, false);
                    if s > best {
                        best = s;
                    }
                }
                total += best;
            }
            let whole = jaro_winkler_similarity(qt.join(""), pt.join(""), false);
            let avg = if qt.len() > 0 { total / (qt.len() as f64) } else { 0.0 };
            let score = avg * 0.7 + whole * 0.3;
            scored.push((score, p.clone()));
        }
        sort_by_sim(mut scored);
        let mut top: Vec[String] = Vec.new();
        for k in 0..min_i(3, scored.len()) {
            if scored[k].0 >= 0.75 {
                top.push(f"{scored[k].1} ({scored[k].0})");
            }
        }
        let shown = if top.len() > 0 { top.join("; ") } else { "no match".to_string() };
        emit(mut out, f"{str_repr(q)} -> {shown}");
    }
}
// ------------------------------------------------------------ the jobs

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data_files() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        if let Err(e) = fs.write(f"data/{file.path}", file.body.clone()) {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn read_text(rel: ref String) -> String {
    match fs.read_to_string(f"data/{rel}") {
        Ok(s) => s,
        Err(_) => "".to_string(),
    }
}

fn main() {
    if let Err(e) = write_data_files() {
        eprintln(e);
        return;
    }
    let t = nfkd_table();
    let mut out = String.new();
    for line in lines_of(read_text("jobs.tsv".to_string())) {
        let job = split_tab(line);
        emit(mut out, f"== {job.join(" ")}");
        let kind = job[0].clone();
        if kind == "vectors" {
            vectors_job(t, job[1], mut out);
        } else if kind == "encode" {
            encode_job(t, job[1], mut out);
        } else if kind == "compare" {
            compare_job(t, job[1], mut out);
        } else if kind == "dedupe" {
            dedupe_job(t, job[1], mut out);
        } else if kind == "suggest" {
            suggest_job(job[1], job[2], mut out);
        } else if kind == "search" {
            search_job(t, job[1], job[2], mut out);
        } else {
            lookup_job(job[1], job[2], mut out);
        }
    }
    print(out);
}

// NFKD for the characters of tables.py's BLOCKS that it changes,
// from Python's unicodedata.
fn nfkd_table() -> Map[char, String] {
    let mut m: Map[char, String] = Map.new();
    nfkd_part_0(mut m);
    nfkd_part_1(mut m);
    nfkd_part_2(mut m);
    nfkd_part_3(mut m);
    nfkd_part_4(mut m);
    nfkd_part_5(mut m);
    nfkd_part_6(mut m);
    nfkd_part_7(mut m);
    nfkd_part_8(mut m);
    m
}

fn nfkd_part_0(m: mut ref Map[char, String]) {
    m.insert('\u{a0}', " ".to_string());
    m.insert('\u{a8}', " \u{308}".to_string());
    m.insert('\u{aa}', "a".to_string());
    m.insert('\u{af}', " \u{304}".to_string());
