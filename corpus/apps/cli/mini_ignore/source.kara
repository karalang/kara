// mini_ignore: which files a repository ignores, as git decides it, for
// the tools that walk a working tree (search tools, file watchers, build
// systems, backup and sync tools):
// - git's wildmatch, ported from wildmatch.c: `*`, `?`, `**` at a
//   directory boundary and inside a name, character classes with ranges,
//   negation and POSIX names, and backslash escapes;
// - .gitignore parsing as dir.c does it: comments, escaped `#` and `!`,
//   trailing spaces and escaped ones, CRLF lines, a last line with no
//   newline, negation, directory-only patterns, and anchoring;
// - the exclusion rules: the deepest .gitignore first, then
//   .git/info/exclude, the last matching line in a file wins, and nothing
//   under an excluded directory can be re-included.
//
// The run writes a monorepo's working tree into `data/repo` and prints what
// `git ls-files --others` lists as untracked and as ignored, and what
// `git check-ignore -v --non-matching` says about every path in it.
//
// expected.out is the output of oracle.py, which asks git 2.43 itself.

// ------------------------------------------------------------ bytes and text

fn byte_str(b: ref Vec[u8], from: i64, to: i64) -> String {
    let mut v: Vec[u8] = Vec.new();
    for i in from..to {
        v.push(b[i]);
    }
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn to_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn from_bytes(v: Vec[u8]) -> String {
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn is_alpha(c: u8) -> bool {
    (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z')
}

fn is_alnum(c: u8) -> bool {
    is_digit(c) or is_alpha(c)
}

// A word character, as `\w` and `\b` see it.
fn is_word(c: u8) -> bool {
    is_alnum(c) or c == b'_' or c >= 128
}

// White space, as `\s` and str.strip see it.
fn is_ws(c: u8) -> bool {
    c == b' ' or c == b'\t' or c == b'\n' or c == b'\r' or c == 11 or c == 12
}

fn lower_byte(c: u8) -> u8 {
    if c >= b'A' and c <= b'Z' { c + 32 } else { c }
}

fn lower(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        out.push(lower_byte(b[i]));
    }
    from_bytes(out)
}

fn strip(s: Str) -> String {
    let b = to_bytes(s);
    let mut i: i64 = 0;
    let mut j = b.len();
    while i < j and is_ws(b[i]) {
        i += 1;
    }
    while j > i and is_ws(b[j - 1]) {
        j -= 1;
    }
    byte_str(b, i, j)
}

fn split_ws(s: Str) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        while i < b.len() and is_ws(b[i]) {
            i += 1;
        }
        let st = i;
        while i < b.len() and not is_ws(b[i]) {
            i += 1;
        }
        if i > st {
            out.push(byte_str(b, st, i));
        }
    }
    out
}

fn split_on(s: Str, sep: u8) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut st: i64 = 0;
    for i in 0..b.len() {
        if b[i] == sep {
            out.push(byte_str(b, st, i));
            st = i + 1;
        }
    }
    out.push(byte_str(b, st, b.len()));
    out
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

// The lines of a file, without their newlines.
fn lines_of(text: Str) -> Vec[String] {
    let mut v = split_on(text, b'\n');
    if v.len() > 0 and v[v.len() - 1].len() == 0 {
        v.pop();
    }
    v
}

fn contains_str(v: ref Vec[String], s: Str) -> bool {
    for i in 0..v.len() {
        if v[i] == s {
            return true;
        }
    }
    false
}

// A stable sort of strings.
fn sort_strings(v: own Vec[String]) -> Vec[String] {
    let mut v = v;
    for i in 1..v.len() {
        let mut j = i;
        while j > 0 and v[j - 1] > v[j] {
            v.swap(j - 1, j);
            j -= 1;
        }
    }
    v
}

// Python's repr of a str.
fn py_repr(s: Str) -> String {
    let b = to_bytes(s);
    let mut has_single = false;
    let mut has_double = false;
    for i in 0..b.len() {
        if b[i] == b'\'' {
            has_single = true;
        }
        if b[i] == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let hex = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    out.push(q);
    for i in 0..b.len() {
        let c = b[i];
        if c == q or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c < 32 or c == 127 {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    from_bytes(out)
}


// ------------------------------------------------------------ wildmatch

const WM_MATCH: i64 = 0;
const WM_NOMATCH: i64 = 1;
const WM_ABORT_ALL: i64 = -1;
const WM_ABORT_TO_STARSTAR: i64 = -2;

// The byte at `i`, or 0 past the end, as the C code reads its NUL.
fn at(b: ref Vec[u8], i: i64) -> u8 {
    if i < b.len() { b[i] } else { 0 }
}

fn is_glob_special(c: u8) -> bool {
    c == b'*' or c == b'?' or c == b'[' or c == b'\\'
}

fn in_class(name: Str, c: u8) -> Option[bool] {
    let upper = c >= b'A' and c <= b'Z';
    let lower = c >= b'a' and c <= b'z';
    let digit = c >= b'0' and c <= b'9';
    let space = c == b' ' or c == b'\t' or c == b'\n' or c == b'\r';
    let print = c >= 32 and c < 127;
    if name == "alnum" {
        return Some(upper or lower or digit);
    }
    if name == "alpha" {
        return Some(upper or lower);
    }
    if name == "blank" {
        return Some(c == b' ' or c == b'\t');
    }
    if name == "cntrl" {
        return Some(c < 32 or c == 127);
    }
    if name == "digit" {
        return Some(digit);
    }
    if name == "graph" {
        return Some(print and c != b' ');
    }
    if name == "lower" {
        return Some(lower);
    }
    if name == "print" {
        return Some(print);
    }
    if name == "punct" {
        return Some(print and not (upper or lower or digit or c == b' '));
    }
    if name == "space" {
        return Some(space);
    }
    if name == "upper" {
        return Some(upper);
    }
    if name == "xdigit" {
        return Some(digit or (c >= b'a' and c <= b'f') or (c >= b'A' and c <= b'F'));
    }
    None
}

fn has_slash_from(t: ref Vec[u8], from: i64) -> i64 {
    for i in from..t.len() {
        if t[i] == b'/' {
            return i;
        }
    }
    -1
}

// git's dowild: `pat` from `p0` against `text` from `t0`.
fn dowild(pat: ref Vec[u8], p0: i64, text: ref Vec[u8], t0: i64, pathname: bool) -> i64 {
    let mut p = p0;
    let mut t = t0;
    loop {
        let mut p_ch = at(pat, p);
        if p_ch == 0 {
            break;
        }
        let mut t_ch = at(text, t);
        if t_ch == 0 and p_ch != b'*' {
            return WM_ABORT_ALL;
        }
        if p_ch == b'\\' {
            // a literal match with the next character
            p += 1;
            p_ch = at(pat, p);
            if t_ch != p_ch {
                return WM_NOMATCH;
            }
        } else if p_ch == b'?' {
            if pathname and t_ch == b'/' {
                return WM_NOMATCH;
            }
        } else if p_ch == b'*' {
            p += 1;
            let mut match_slash = not pathname;
            if at(pat, p) == b'*' {
                let prev_p = p - 2;
                p += 1;
                while at(pat, p) == b'*' {
                    p += 1;
                }
                let boundary_before = prev_p < p0 or pat[prev_p] == b'/';
                let boundary_after = at(pat, p) == 0 or at(pat, p) == b'/' or (at(pat, p) == b'\\' and at(pat, p + 1) == b'/');
                if boundary_before and boundary_after {
                    // `**/` may match no directory at all
                    if at(pat, p) == b'/' and dowild(pat, p + 1, text, t, pathname) == WM_MATCH {
                        return WM_MATCH;
                    }
                    match_slash = true;
                } else {
                    match_slash = false;
                }
            }
            if at(pat, p) == 0 {
                // a trailing `**` matches everything, a trailing `*` only up to a slash
                if not match_slash and has_slash_from(text, t) >= 0 {
                    return WM_NOMATCH;
                }
                return WM_MATCH;
            } else if not match_slash and at(pat, p) == b'/' {
                // one `*` then a slash matches the rest of this directory name
                let slash = has_slash_from(text, t);
                if slash < 0 {
                    return WM_NOMATCH;
                }
                t = slash + 1;
                p += 1;
                continue;
            }
            loop {
                if t_ch == 0 {
                    break;
                }
                let next = at(pat, p);
                if not is_glob_special(next) {
                    // skip ahead to the literal that follows the star
                    loop {
                        t_ch = at(text, t);
                        if t_ch == 0 or not (match_slash or t_ch != b'/') {
                            break;
                        }
                        if t_ch == next {
                            break;
                        }
                        t += 1;
                    }
                    if t_ch != next {
                        return if match_slash { WM_ABORT_ALL } else { WM_ABORT_TO_STARSTAR };
                    }
                }
                let matched = dowild(pat, p, text, t, pathname);
                if matched != WM_NOMATCH {
                    if not match_slash or matched != WM_ABORT_TO_STARSTAR {
                        return matched;
                    }
                } else if not match_slash and t_ch == b'/' {
                    return WM_ABORT_TO_STARSTAR;
                }
                t += 1;
                t_ch = at(text, t);
            }
            return WM_ABORT_ALL;
        } else if p_ch == b'[' {
            p += 1;
            p_ch = at(pat, p);
            if p_ch == b'^' {
                p_ch = b'!';
            }
            let negated = p_ch == b'!';
            if negated {
                p += 1;
                p_ch = at(pat, p);
            }
            let mut prev_ch: u8 = 0;
            let mut matched = false;
            loop {
                if p_ch == 0 {
                    return WM_ABORT_ALL;
                }
                if p_ch == b'\\' {
                    p += 1;
                    p_ch = at(pat, p);
                    if p_ch == 0 {
                        return WM_ABORT_ALL;
                    }
                    if t_ch == p_ch {
                        matched = true;
                    }
                } else if p_ch == b'-' and prev_ch != 0 and at(pat, p + 1) != 0 and at(pat, p + 1) != b']' {
                    p += 1;
                    p_ch = at(pat, p);
                    if p_ch == b'\\' {
                        p += 1;
                        p_ch = at(pat, p);
                        if p_ch == 0 {
                            return WM_ABORT_ALL;
                        }
                    }
                    if t_ch <= p_ch and t_ch >= prev_ch {
                        matched = true;
                    }
                    p_ch = 0;
                } else if p_ch == b'[' and at(pat, p + 1) == b':' {
                    p += 2;
                    let s = p;
                    while at(pat, p) != 0 and at(pat, p) != b']' {
                        p += 1;
                    }
                    p_ch = at(pat, p);
                    if p_ch == 0 {
                        return WM_ABORT_ALL;
                    }
                    let len = p - s - 1;
                    if len < 0 or pat[p - 1] != b':' {
                        // no ":]", so the `[` is an ordinary member
                        p = s - 2;
                        p_ch = b'[';
                        if t_ch == p_ch {
                            matched = true;
                        }
                    } else {
                        match in_class(byte_str(pat, s, s + len), t_ch) {
                            Some(true) => matched = true,
                            Some(false) => {}
                            None => return WM_ABORT_ALL,
                        }
                        p_ch = 0;
                    }
                } else if t_ch == p_ch {
                    matched = true;
                }
                prev_ch = p_ch;
                p += 1;
                p_ch = at(pat, p);
                if p_ch == b']' {
                    break;
                }
            }
            if matched == negated or (pathname and t_ch == b'/') {
                return WM_NOMATCH;
            }
        } else if t_ch != p_ch {
            return WM_NOMATCH;
        }
        t += 1;
        p += 1;
    }
    if at(text, t) != 0 { WM_NOMATCH } else { WM_MATCH }
}

fn wildmatch(pat: ref Vec[u8], text: Str, pathname: bool) -> bool {
    dowild(pat, 0, to_bytes(text), 0, pathname) == WM_MATCH
}

// ------------------------------------------------------------ patterns

#[derive(Clone)]
struct Pattern {
    // the pattern without its `!` and its trailing `/`
    pat: Vec[u8],
    negative: bool,
    must_be_dir: bool,
    // no slash in it: it matches a basename at any depth
    no_dir: bool,
    // the file it came from and its line, for check-ignore -v
    src: String,
    line: i64,
    // the directory of that file, "" for the top, else "a/b/"
    base: String,
}

impl Pattern {
    fn shown(ref self) -> String {
        let bang = if self.negative { "!" } else { "" };
        let slash = if self.must_be_dir { "/" } else { "" };
        f"{bang}{from_bytes(self.pat.clone())}{slash}"
    }

    fn matches(ref self, path: Str, is_dir: bool) -> bool {
        if self.must_be_dir and not is_dir {
            return false;
        }
        let pb = to_bytes(path);
        if self.no_dir {
            let mut st = pb.len();
            while st > 0 and pb[st - 1] != b'/' {
                st -= 1;
            }
            return wildmatch(self.pat, byte_str(pb, st, pb.len()), false);
        }
        // match_pathname: the pattern is relative to its file's directory
        let mut pat = self.pat.clone();
        if pat.len() > 0 and pat[0] == b'/' {
            pat.remove(0);
        }
        let bb = to_bytes(self.base);
        let baselen = if bb.len() > 0 { bb.len() - 1 } else { 0 };
        if pb.len() < baselen + 1 {
            return false;
        }
        if baselen > 0 and pb[baselen] != b'/' {
            return false;
        }
        for k in 0..baselen {
            if pb[k] != bb[k] {
                return false;
            }
        }
        let from = if baselen > 0 { baselen + 1 } else { 0 };
        wildmatch(pat, byte_str(pb, from, pb.len()), true)
    }
}

// dir.c's trim_trailing_spaces: unescaped spaces at the end go.
fn trim_trailing_spaces(line: ref Vec[u8]) -> Vec[u8] {
    let mut last_space: i64 = -1;
    let mut i: i64 = 0;
    while i < line.len() {
        let c = line[i];
        if c == b' ' {
            if last_space < 0 {
                last_space = i;
            }
        } else if c == b'\\' {
            i += 1;
            if i >= line.len() {
                break;
            }
            last_space = -1;
        } else {
            last_space = -1;
        }
        i += 1;
    }
    let end = if last_space >= 0 { last_space } else { line.len() };
    let mut out: Vec[u8] = Vec.new();
    for k in 0..end {
        out.push(line[k]);
    }
    out
}

// The patterns of one ignore file, as add_patterns_from_buffer reads them.
fn parse_patterns(text: Str, src: Str, base: Str) -> Vec[Pattern] {
    let mut b = to_bytes(text);
    if b.len() > 0 and b[b.len() - 1] != b'\n' {
        b.push(b'\n');
    }
    let mut out: Vec[Pattern] = Vec.new();
    let mut lineno: i64 = 1;
    let mut entry: i64 = 0;
    for i in 0..b.len() {
        if b[i] != b'\n' {
            continue;
        }
        if entry != i and b[entry] != b'#' {
            let end = if i > entry and b[i - 1] == b'\r' { i - 1 } else { i };
            let mut raw: Vec[u8] = Vec.new();
            for k in entry..end {
                raw.push(b[k]);
            }
            let mut p = trim_trailing_spaces(raw);
            let mut negative = false;
            if p.len() > 0 and p[0] == b'!' {
                negative = true;
                p.remove(0);
            }
            let mut must_be_dir = false;
            if p.len() > 0 and p[p.len() - 1] == b'/' {
                must_be_dir = true;
                p.pop();
            }
            let mut no_dir = true;
            for k in 0..p.len() {
                if p[k] == b'/' {
                    no_dir = false;
                }
            }
            out.push(Pattern { pat: p, negative: negative, must_be_dir: must_be_dir, no_dir: no_dir, src: src.to_string(), line: lineno, base: base.to_string() });
        }
        lineno += 1;
        entry = i + 1;
    }
    out
}

// ------------------------------------------------------------ the rules

// The ignore files of a working tree: each directory's .gitignore, and
// .git/info/exclude.
struct Rules {
    dirs: Vec[String],
    lists: Vec[Vec[Pattern]],
    exclude: Vec[Pattern],
}

// A pattern in a list, from the last line up: the last match wins.
fn last_match(list: ref Vec[Pattern], path: Str, is_dir: bool) -> Option[Pattern] {
    let mut i = list.len() - 1;
    while i >= 0 {
        if list[i].matches(path, is_dir) {
            return Some(list[i].clone());
        }
        i -= 1;
    }
    None
}

impl Rules {
    fn list_of(ref self, dir: Str) -> i64 {
        for i in 0..self.dirs.len() {
            if self.dirs[i] == dir {
                return i;
            }
        }
        -1
    }

    // last_matching_pattern_from_lists: the .gitignore files on the stack
    // from the deepest up, then info/exclude.
    fn from_lists(ref self, stack: ref Vec[i64], path: Str, is_dir: bool) -> Option[Pattern] {
        let mut k = stack.len() - 1;
        while k >= 0 {
            if let Some(p) = last_match(self.lists[stack[k]], path, is_dir) {
                return Some(p);
            }
            k -= 1;
        }
        last_match(self.exclude, path, is_dir)
    }

    // The pattern that decides `path`: that of an excluded directory above
    // it if there is one (prep_exclude), else the path's own.
    fn decide(ref self, path: Str, is_dir: bool) -> Option[Pattern] {
        let parts = split_on(path, b'/');
        let mut stack: Vec[i64] = Vec.new();
        let top = self.list_of("");
        if top >= 0 {
            stack.push(top);
        }
        let mut dir = String.new();
        for k in 0..parts.len() - 1 {
            if k > 0 {
                dir.push_str("/");
            }
            dir.push_str(parts[k]);
            if let Some(p) = self.from_lists(stack, dir, true) {
                if not p.negative {
                    return Some(p);
                }
            }
            let l = self.list_of(dir);
            if l >= 0 {
                stack.push(l);
            }
        }
        self.from_lists(stack, path, is_dir)
    }

    fn ignored(ref self, path: Str, is_dir: bool) -> bool {
        match self.decide(path, is_dir) {
            Some(p) => not p.negative,
            None => false,
        }
    }
}

