// ------------------------------------------------------------ the report

const ROOT: Str = "data/repo";

fn read(path: Str) -> Result[String, String] {
    match fs.read_to_string(path.to_string()) {
        Ok(t) => Ok(t),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

// Every path under the working tree, files and directories, as
// (path, is_dir), in directory order.
fn walk(dir: Str, out: mut ref Vec[String], dirs: mut ref Vec[bool]) -> Result[(), String] {
    let full = if dir.len() > 0 { f"{ROOT}/{dir}" } else { ROOT.to_string() };
    let names = match fs.read_dir(full) {
        Ok(v) => v,
        Err(e) => return Err(f"cannot list {full}: {e}"),
    };
    for i in 0..names.len() {
        let rel = if dir.len() > 0 { f"{dir}/{names[i]}" } else { names[i].clone() };
        if rel == ".git" {
            continue;
        }
        let is_dir = match fs.metadata(f"{ROOT}/{rel}") {
            Ok(m) => m.is_dir,
            Err(e) => return Err(f"cannot stat {rel}: {e}"),
        };
        out.push(rel.clone());
        dirs.push(is_dir);
        if is_dir {
            walk(rel, mut out, mut dirs)?;
        }
    }
    Ok(())
}

fn run() -> Result[(), String] {
    write_data()?;
    let mut paths: Vec[String] = Vec.new();
    let mut is_dir: Vec[bool] = Vec.new();
    walk("", mut paths, mut is_dir)?;
    let mut rules = Rules { dirs: Vec.new(), lists: Vec.new(), exclude: Vec.new() };
    rules.exclude = parse_patterns(read("data/exclude.txt")?, ".git/info/exclude", "");
    for i in 0..paths.len() {
        let pb = to_bytes(paths[i]);
        let mut st = pb.len();
        while st > 0 and pb[st - 1] != b'/' {
            st -= 1;
        }
        if is_dir[i] or byte_str(pb, st, pb.len()) != ".gitignore" {
            continue;
        }
        let dir = if st > 0 { byte_str(pb, 0, st - 1) } else { String.new() };
        let base = if st > 0 { byte_str(pb, 0, st) } else { String.new() };
        let text = read(f"{ROOT}/{paths[i]}")?;
        rules.dirs.push(dir);
        rules.lists.push(parse_patterns(text, paths[i], base));
    }
    // git lists paths sorted byte-wise on the whole path
    let mut order: Vec[i64] = Vec.new();
    for i in 0..paths.len() {
        order.push(i);
    }
    for i in 1..order.len() {
        let mut j = i;
        while j > 0 and paths[order[j - 1]] > paths[order[j]] {
            order.swap(j - 1, j);
            j -= 1;
        }
    }
    println("== untracked");
    for k in 0..order.len() {
        let i = order[k];
        if not is_dir[i] and not rules.ignored(paths[i], false) {
            println(paths[i]);
        }
    }
    println("== ignored");
    for k in 0..order.len() {
        let i = order[k];
        if not is_dir[i] and rules.ignored(paths[i], false) {
            println(paths[i]);
        }
    }
    println("== check-ignore");
    for k in 0..order.len() {
        let i = order[k];
        match rules.decide(paths[i], is_dir[i]) {
            Some(p) => println(f"{p.src}:{p.line}:{p.shown()}\t{paths[i]}"),
            None => println(f"::\t{paths[i]}"),
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_ignore: {e}");
    }
}
