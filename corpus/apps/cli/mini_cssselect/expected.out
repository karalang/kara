== spiders/shop.cfg
spiders/shop.cfg:2 price = span[itemprop=price]::attr(content)
  tree: Selector[Attrib[Element[span][itemprop = 'price']]FunctionalPseudoElement[::attr(['content'])]]
  canonical: span[itemprop=price]::attr(content)  specificity: (0, 1, 2)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::span[@itemprop = 'price']/@content
spiders/shop.cfg:3 sku = [itemprop~=sku]
  tree: Selector[Attrib[Element[*][itemprop ~= 'sku']]]
  canonical: [itemprop~=sku]  specificity: (0, 1, 0)
  generic: descendant-or-self::*[@itemprop and contains(concat(' ', normalize-space(@itemprop), ' '), ' sku ')]
  html: = generic
  parsel: = html
spiders/shop.cfg:4 alt.lang = link[hreflang|=en]::attr(href)
  tree: Selector[Attrib[Element[link][hreflang |= 'en']]FunctionalPseudoElement[::attr(['href'])]]
  canonical: link[hreflang|=en]::attr(href)  specificity: (0, 1, 2)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::link[@hreflang and (@hreflang = 'en' or starts-with(@hreflang, 'en-'))]/@href
spiders/shop.cfg:5 pdfs = a[href$=".pdf"]::attr(href)
  tree: Selector[Attrib[Element[a][href $= '.pdf']]FunctionalPseudoElement[::attr(['href'])]]
  canonical: a[href$='.pdf']::attr(href)  specificity: (0, 1, 2)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::a[@href and substring(@href, string-length(@href)-3) = '.pdf']/@href
spiders/shop.cfg:6 external = a[href^="http"]:not([href*="example.com"])::attr(href)
  tree: Selector[Negation[Attrib[Element[a][href ^= 'http']]:not(Attrib[Element[*][href *= 'example.com']])]FunctionalPseudoElement[::attr(['href'])]]
  canonical: a[href^='http']:not([href*='example.com'])::attr(href)  specificity: (0, 2, 2)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::a[(@href and starts-with(@href, 'http')) and (not(@href and contains(@href, 'example.com')))]/@href
spiders/shop.cfg:7 empty.cells = td:empty
  tree: Selector[Pseudo[Element[td]:empty]]
  canonical: td:empty  specificity: (0, 1, 1)
  generic: descendant-or-self::td[not(*) and not(string-length())]
  html: = generic
  parsel: = html
spiders/shop.cfg:8 picked = input:checked::attr(name)
  tree: Selector[Pseudo[Element[input]:checked]FunctionalPseudoElement[::attr(['name'])]]
  canonical: input:checked::attr(name)  specificity: (0, 1, 2)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::input[(@selected and name(.) = 'option') or (@checked and (name(.) = 'input' or name(.) = 'command')and (@type = 'checkbox' or @type = 'radio'))]/@name
spiders/shop.cfg:9 disabled = button:disabled
  tree: Selector[Pseudo[Element[button]:disabled]]
  canonical: button:disabled  specificity: (0, 1, 1)
  generic: descendant-or-self::button[0]
  html: descendant-or-self::button[
        (
            @disabled and
            (
                (name(.) = 'input' and @type != 'hidden') or
                name(.) = 'button' or
                name(.) = 'select' or
                name(.) = 'textarea' or
                name(.) = 'command' or
                name(.) = 'fieldset' or
                name(.) = 'optgroup' or
                name(.) = 'option'
            )
        ) or (
            (
                (name(.) = 'input' and @type != 'hidden') or
                name(.) = 'button' or
                name(.) = 'select' or
                name(.) = 'textarea'
            )
            and ancestor::fieldset[@disabled]
        )
        ]
  parsel: = html
spiders/shop.cfg:10 enabled = input:enabled
  tree: Selector[Pseudo[Element[input]:enabled]]
  canonical: input:enabled  specificity: (0, 1, 1)
  generic: descendant-or-self::input[0]
  html: descendant-or-self::input[
        (
            @href and (
                name(.) = 'a' or
                name(.) = 'link' or
                name(.) = 'area'
            )
        ) or (
            (
                name(.) = 'command' or
                name(.) = 'fieldset' or
                name(.) = 'optgroup'
            )
            and not(@disabled)
        ) or (
            (
                (name(.) = 'input' and @type != 'hidden') or
                name(.) = 'button' or
                name(.) = 'select' or
                name(.) = 'textarea' or
                name(.) = 'keygen'
            )
            and not (@disabled or ancestor::fieldset[@disabled])
        ) or (
            name(.) = 'option' and not(
                @disabled or ancestor::optgroup[@disabled]
            )
        )
        ]
  parsel: = html
