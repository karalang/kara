spiders/quotes.cfg:6 about = .quote span a[href*="/author/"]::attr(href)
  tree: Selector[CombinedSelector[CombinedSelector[Class[Element[*].quote] <followed> Element[span]] <followed> Attrib[Element[a][href *= '/author/']]]FunctionalPseudoElement[::attr(['href'])]]
