== spiders/books.cfg
spiders/books.cfg:2 list.item = article.product_pod
  tree: Selector[Class[Element[article].product_pod]]
  canonical: article.product_pod  specificity: (0, 1, 1)
  generic: descendant-or-self::article[@class and contains(concat(' ', normalize-space(@class), ' '), ' product_pod ')]
  html: = generic
  parsel: = html
spiders/books.cfg:3 list.title = article.product_pod h3 > a::attr(title)
  tree: Selector[CombinedSelector[CombinedSelector[Class[Element[article].product_pod] <followed> Element[h3]] > Element[a]]FunctionalPseudoElement[::attr(['title'])]]
  canonical: article.product_pod   h3 > a::attr(title)  specificity: (0, 1, 4)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::article[@class and contains(concat(' ', normalize-space(@class), ' '), ' product_pod ')]/descendant-or-self::*/h3/a/@title
spiders/books.cfg:4 list.link = h3 a::attr(href)
  tree: Selector[CombinedSelector[Element[h3] <followed> Element[a]]FunctionalPseudoElement[::attr(['href'])]]
  canonical: h3   a::attr(href)  specificity: (0, 0, 3)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::h3/descendant-or-self::*/a/@href
spiders/books.cfg:5 list.price = .product_price .price_color::text
  tree: Selector[CombinedSelector[Class[Element[*].product_price] <followed> Class[Element[*].price_color]]::text]
  canonical: .product_price   .price_color::text  specificity: (0, 2, 1)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::*[@class and contains(concat(' ', normalize-space(@class), ' '), ' product_price ')]/descendant-or-self::*/*[@class and contains(concat(' ', normalize-space(@class), ' '), ' price_color ')]/text()
spiders/books.cfg:6 list.stock = p.instock.availability::text
  tree: Selector[Class[Class[Element[p].instock].availability]::text]
  canonical: p.instock.availability::text  specificity: (0, 2, 2)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::p[(@class and contains(concat(' ', normalize-space(@class), ' '), ' instock ')) and (@class and contains(concat(' ', normalize-space(@class), ' '), ' availability '))]/text()
spiders/books.cfg:7 list.rating = p.star-rating::attr(class)
  tree: Selector[Class[Element[p].star-rating]FunctionalPseudoElement[::attr(['class'])]]
  canonical: p.star-rating::attr(class)  specificity: (0, 1, 2)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::p[@class and contains(concat(' ', normalize-space(@class), ' '), ' star-rating ')]/@class
spiders/books.cfg:8 list.next = li.next > a::attr(href)
  tree: Selector[CombinedSelector[Class[Element[li].next] > Element[a]]FunctionalPseudoElement[::attr(['href'])]]
  canonical: li.next > a::attr(href)  specificity: (0, 1, 3)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::li[@class and contains(concat(' ', normalize-space(@class), ' '), ' next ')]/a/@href
spiders/books.cfg:9 detail.title = div.product_main > h1::text
  tree: Selector[CombinedSelector[Class[Element[div].product_main] > Element[h1]]::text]
  canonical: div.product_main > h1::text  specificity: (0, 1, 3)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::div[@class and contains(concat(' ', normalize-space(@class), ' '), ' product_main ')]/h1/text()
spiders/books.cfg:10 detail.upc = table.table-striped tr:nth-child(1) > td::text
  tree: Selector[CombinedSelector[CombinedSelector[Class[Element[table].table-striped] <followed> Function[Element[tr]:nth-child(['1'])]] > Element[td]]::text]
  canonical: table.table-striped   tr:nth-child(1) > td::text  specificity: (0, 2, 4)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::table[@class and contains(concat(' ', normalize-space(@class), ' '), ' table-striped ')]/descendant-or-self::*/tr[count(preceding-sibling::*) = 0]/td/text()
spiders/books.cfg:11 detail.desc = #product_description + p::text
  tree: Selector[CombinedSelector[Hash[Element[*]#product_description] + Element[p]]::text]
  canonical: #product_description + p::text  specificity: (1, 0, 2)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::*[@id = 'product_description']/following-sibling::*[(name() = 'p') and (position() = 1)]/text()
spiders/books.cfg:12 detail.crumbs = ul.breadcrumb li:not(.active) a::text
  tree: Selector[CombinedSelector[CombinedSelector[Class[Element[ul].breadcrumb] <followed> Negation[Element[li]:not(Class[Element[*].active])]] <followed> Element[a]]::text]
  canonical: ul.breadcrumb   li:not(.active)   a::text  specificity: (0, 2, 4)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::ul[@class and contains(concat(' ', normalize-space(@class), ' '), ' breadcrumb ')]/descendant-or-self::*/li[not(@class and contains(concat(' ', normalize-space(@class), ' '), ' active '))]/descendant-or-self::*/a/text()
spiders/books.cfg:13 detail.image = #product_gallery img::attr(src)
  tree: Selector[CombinedSelector[Hash[Element[*]#product_gallery] <followed> Element[img]]FunctionalPseudoElement[::attr(['src'])]]
  canonical: #product_gallery   img::attr(src)  specificity: (1, 0, 2)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::*[@id = 'product_gallery']/descendant-or-self::*/img/@src
spiders/books.cfg:14 detail.all = div.product_main h1, div.product_main p.price_color
  tree: Selector[CombinedSelector[Class[Element[div].product_main] <followed> Element[h1]]]
  canonical: div.product_main   h1  specificity: (0, 1, 2)
  tree: Selector[CombinedSelector[Class[Element[div].product_main] <followed> Class[Element[p].price_color]]]
  canonical: div.product_main   p.price_color  specificity: (0, 2, 2)
  generic: descendant-or-self::div[@class and contains(concat(' ', normalize-space(@class), ' '), ' product_main ')]/descendant-or-self::*/h1 | descendant-or-self::div[@class and contains(concat(' ', normalize-space(@class), ' '), ' product_main ')]/descendant-or-self::*/p[@class and contains(concat(' ', normalize-space(@class), ' '), ' price_color ')]
  html: = generic
  parsel: = html
== spiders/jobs.cfg
spiders/jobs.cfg:2 card = li[data-job-id]
  tree: Selector[Attrib[Element[li][data-job-id]]]
  canonical: li[data-job-id]  specificity: (0, 1, 1)
  generic: descendant-or-self::li[@data-job-id]
  html: = generic
  parsel: = html
spiders/jobs.cfg:3 remote = li[data-job-id]:has(> span.remote)
  tree: Selector[Relation[Attrib[Element[li][data-job-id]]:has(Selector[Class[Element[span].remote]])]]
  canonical: li[data-job-id]:has(span.remote)  specificity: (0, 2, 2)
  generic: descendant-or-self::li[@data-job-id][./span][@class and contains(concat(' ', normalize-space(@class), ' '), ' remote ')]
  html: = generic
  parsel: = html
spiders/jobs.cfg:4 title = li[data-job-id] :is(h2, h3) > a::text
  tree: Selector[CombinedSelector[CombinedSelector[Attrib[Element[li][data-job-id]] <followed> Matching[Element[*]:is(Element[h2], Element[h3])]] > Element[a]]::text]
  canonical: li[data-job-id]   :is(h2, h3) > a::text  specificity: (0, 1, 4)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::li[@data-job-id]/descendant-or-self::*/*[(name() = 'h2') or (name() = 'h3')]/a/text()
spiders/jobs.cfg:5 salary = [data-testid="salary"]::text
  tree: Selector[Attrib[Element[*][data-testid = 'salary']]::text]
  canonical: [data-testid='salary']::text  specificity: (0, 1, 1)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::*[@data-testid = 'salary']/text()
spiders/jobs.cfg:6 posted = time[datetime]::attr(datetime)
  tree: Selector[Attrib[Element[time][datetime]]FunctionalPseudoElement[::attr(['datetime'])]]
  canonical: time[datetime]::attr(datetime)  specificity: (0, 1, 2)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::time[@datetime]/@datetime
spiders/jobs.cfg:7 english = div:lang(en) p
  tree: Selector[CombinedSelector[Function[Element[div]:lang(['en'])] <followed> Element[p]]]
  canonical: div:lang(en)   p  specificity: (0, 1, 2)
  generic: descendant-or-self::div[lang('en')]/descendant-or-self::*/p
  html: descendant-or-self::div[ancestor-or-self::*[@lang][1][starts-with(concat(translate(@lang, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), '-'), 'en-')]]/descendant-or-self::*/p
  parsel: = html
spiders/jobs.cfg:8 french = article:lang("fr-CA")::text
  tree: Selector[Function[Element[article]:lang(['fr-CA'])]::text]
  canonical: article:lang('fr-CA')::text  specificity: (0, 1, 2)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::article[ancestor-or-self::*[@lang][1][starts-with(concat(translate(@lang, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), '-'), 'fr-ca-')]]/text()
spiders/jobs.cfg:9 no.ads = li:not([data-sponsored]) a.job-link::attr(href)
  tree: Selector[CombinedSelector[Negation[Element[li]:not(Attrib[Element[*][data-sponsored]])] <followed> Class[Element[a].job-link]]FunctionalPseudoElement[::attr(['href'])]]
  canonical: li:not([data-sponsored])   a.job-link::attr(href)  specificity: (0, 2, 3)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::li[not(@data-sponsored)]/descendant-or-self::*/a[@class and contains(concat(' ', normalize-space(@class), ' '), ' job-link ')]/@href
spiders/jobs.cfg:10 odd.rows = tr:nth-child(odd) td:first-of-type::text
  tree: Selector[CombinedSelector[Function[Element[tr]:nth-child(['odd'])] <followed> Pseudo[Element[td]:first-of-type]]::text]
  canonical: tr:nth-child(odd)   td:first-of-type::text  specificity: (0, 2, 3)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::tr[count(preceding-sibling::*) mod 2 = 0]/descendant-or-self::*/td[count(preceding-sibling::td) = 0]/text()
spiders/jobs.cfg:11 last = ul.results > li:last-child
  tree: Selector[CombinedSelector[Class[Element[ul].results] > Pseudo[Element[li]:last-child]]]
  canonical: ul.results > li:last-child  specificity: (0, 2, 2)
  generic: descendant-or-self::ul[@class and contains(concat(' ', normalize-space(@class), ' '), ' results ')]/li[count(following-sibling::*) = 0]
  html: = generic
  parsel: = html
spiders/jobs.cfg:12 every3 = tbody tr:nth-child(3n+2)
  tree: Selector[CombinedSelector[Element[tbody] <followed> Function[Element[tr]:nth-child(['3', 'n', '+2'])]]]
  canonical: tbody   tr:nth-child(3n+2)  specificity: (0, 1, 2)
  generic: descendant-or-self::tbody/descendant-or-self::*/tr[(count(preceding-sibling::*) >= 1) and ((count(preceding-sibling::*) +2) mod 3 = 0)]
  html: = generic
  parsel: = html
spiders/jobs.cfg:13 tail = tbody tr:nth-last-child(-n+3)
  tree: Selector[CombinedSelector[Element[tbody] <followed> Function[Element[tr]:nth-last-child(['-n', '+3'])]]]
  canonical: tbody   tr:nth-last-child(-n+3)  specificity: (0, 1, 2)
  generic: descendant-or-self::tbody/descendant-or-self::*/tr[count(following-sibling::*) <= 2]
  html: = generic
  parsel: = html
spiders/jobs.cfg:14 first3 = ol > li:nth-child(-n + 3)
  tree: Selector[CombinedSelector[Element[ol] > Function[Element[li]:nth-child(['-n', '+', '3'])]]]
  canonical: ol > li:nth-child(-n+3)  specificity: (0, 1, 2)
  generic: descendant-or-self::ol/li[count(preceding-sibling::*) <= 2]
  html: = generic
  parsel: = html
spiders/jobs.cfg:15 even = tr:nth-of-type(even)
  tree: Selector[Function[Element[tr]:nth-of-type(['even'])]]
  canonical: tr:nth-of-type(even)  specificity: (0, 1, 1)
  generic: descendant-or-self::tr[(count(preceding-sibling::tr) +1) mod 2 = 0]
  html: = generic
  parsel: = html
spiders/jobs.cfg:16 fixed = tr:nth-child(0n+5)
  tree: Selector[Function[Element[tr]:nth-child(['0', 'n', '+5'])]]
  canonical: tr:nth-child(0n+5)  specificity: (0, 1, 1)
  generic: descendant-or-self::tr[count(preceding-sibling::*) = 4]
  html: = generic
  parsel: = html
spiders/jobs.cfg:17 none = tr:nth-child(-2n-1)
  tree: Selector[Function[Element[tr]:nth-child(['-2', 'n-1'])]]
  canonical: tr:nth-child(-2n-1)  specificity: (0, 1, 1)
  generic: descendant-or-self::tr[0]
  html: = generic
  parsel: = html
spiders/jobs.cfg:18 from4 = tr:nth-last-of-type(n+4)
  tree: Selector[Function[Element[tr]:nth-last-of-type(['n', '+4'])]]
  canonical: tr:nth-last-of-type(n+4)  specificity: (0, 1, 1)
  generic: descendant-or-self::tr[count(following-sibling::tr) >= 3]
  html: = generic
  parsel: = html
spiders/jobs.cfg:19 loose = tr:nth-child( 2n - 1 )
  tree: Selector[Function[Element[tr]:nth-child(['2', 'n', '-', '1'])]]
  canonical: tr:nth-child(2n-1)  specificity: (0, 1, 1)
  generic: descendant-or-self::tr[count(preceding-sibling::*) mod 2 = 0]
  html: = generic
  parsel: = html
spiders/jobs.cfg:20 step = tr:nth-child(-3n+8)
  tree: Selector[Function[Element[tr]:nth-child(['-3', 'n', '+8'])]]
  canonical: tr:nth-child(-3n+8)  specificity: (0, 1, 1)
  generic: descendant-or-self::tr[(count(preceding-sibling::*) <= 7) and ((count(preceding-sibling::*) +2) mod -3 = 0)]
  html: = generic
  parsel: = html
spiders/jobs.cfg:21 company = div.company:has(img.logo)
  tree: Selector[Relation[Class[Element[div].company]:has(Selector[Class[Element[img].logo]])]]
  canonical: div.company:has(img.logo)  specificity: (0, 2, 2)
  generic: descendant-or-self::div[@class and contains(concat(' ', normalize-space(@class), ' '), ' company ')][descendant::img[@class and contains(concat(' ', normalize-space(@class), ' '), ' logo ')]][@class and contains(concat(' ', normalize-space(@class), ' '), ' company ')]
  html: = generic
  parsel: = html
spiders/jobs.cfg:22 next.job = h2.title:has(+ p)
  tree: Selector[Relation[Class[Element[h2].title]:has(Selector[Element[p]])]]
  canonical: h2.title:has(p)  specificity: (0, 1, 2)
  generic: descendant-or-self::h2[(@class and contains(concat(' ', normalize-space(@class), ' '), ' title ')) and (following-sibling::*[(name() = 'p') and (position() = 1)])]
  html: = generic
  parsel: = html
spiders/jobs.cfg:23 later = h2:has(~ footer)
  tree: Selector[Relation[Element[h2]:has(Selector[Element[footer]])]]
  canonical: h2:has(footer)  specificity: (0, 0, 2)
  generic: descendant-or-self::h2[following-sibling::footer]
  html: = generic
  parsel: = html
