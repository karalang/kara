spiders/quotes.cfg:7 next = li.next a::attr("href")
  tree: Selector[CombinedSelector[Class[Element[li].next] <followed> Element[a]]FunctionalPseudoElement[::attr(['href'])]]
  canonical: li.next   a::attr('href')  specificity: (0, 1, 3)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::li[@class and contains(concat(' ', normalize-space(@class), ' '), ' next ')]/descendant-or-self::*/a/@href
spiders/quotes.cfg:8 login.csrf = form input[name=csrf_token]::attr(value)
  tree: Selector[CombinedSelector[Element[form] <followed> Attrib[Element[input][name = 'csrf_token']]]FunctionalPseudoElement[::attr(['value'])]]
  canonical: form   input[name=csrf_token]::attr(value)  specificity: (0, 1, 3)
  generic: error ExpressionError: Pseudo-elements are not supported.
  html: = generic
  parsel: descendant-or-self::form/descendant-or-self::*/input[@name = 'csrf_token']/@value
spiders/quotes.cfg:9 login.user = FORM INPUT[Name='username']
  tree: Selector[CombinedSelector[Element[FORM] <followed> Attrib[Element[INPUT][Name = 'username']]]]
  canonical: FORM   INPUT[Name='username']  specificity: (0, 1, 2)
  generic: descendant-or-self::FORM/descendant-or-self::*/INPUT[@Name = 'username']
  html: descendant-or-self::form/descendant-or-self::*/input[@name = 'username']
