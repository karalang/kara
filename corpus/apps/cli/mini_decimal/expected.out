== construct from strings
  new 3.14 -> Decimal('3.14')
  new   -0.000   -> Decimal('-0.000')
  new 1_000.5 -> Decimal('1000.5')
  new 1e+3 -> Decimal('1E+3')
  new -1E-3 -> Decimal('-0.001')
  new .5 -> Decimal('0.5')
  new 5. -> Decimal('5')
  new +12.3400 -> Decimal('12.3400')
  new Inf -> Decimal('Infinity')
  new -infinity -> Decimal('-Infinity')
  new nan -> Decimal('NaN')
  new sNaN123 -> Decimal('sNaN123')
  new -NaN0045 -> Decimal('-NaN45')
  new 0E-1000 -> Decimal('0E-1000')
  new 1.5e999999 -> Decimal('1.5E+999999')
  new abc -> InvalidOperation: Invalid literal for Decimal: 'abc' {InvalidOperation}
  new 1.2.3 -> InvalidOperation: Invalid literal for Decimal: '1.2.3' {InvalidOperation}
  new  -> InvalidOperation: Invalid literal for Decimal: '' {InvalidOperation}
  new 1 000 -> InvalidOperation: Invalid literal for Decimal: '1 000' {InvalidOperation}
  new ١٢٣ -> Decimal('123')
== conversion syntax with the trap off
  ctx traps= -> Context(prec=28, rounding=ROUND_HALF_EVEN, Emin=-999999, Emax=999999, capitals=1, clamp=0, flags=[], traps=[])
  new abc -> Decimal('NaN') {InvalidOperation}
  new 12e -> Decimal('NaN') {InvalidOperation}
  add 1 foo -> Decimal('NaN') {InvalidOperation}
  create  7  -> Decimal('NaN') {InvalidOperation}
  create 1_0 -> Decimal('NaN') {InvalidOperation}
  create NaN12345678901234567890123456789 -> Decimal('NaN') {InvalidOperation}
== ints, floats and tuples
  new i:12345678901234567890 -> Decimal('12345678901234567890')
  new i:-7 -> Decimal('-7')
  new f:0.1 -> Decimal('0.1000000000000000055511151231257827021181583404541015625') {FloatOperation}
  new f:-0.0 -> Decimal('-0') {FloatOperation}
  new f:1e300 -> Decimal('') {FloatOperation}
  new f:inf -> Decimal('Infinity') {FloatOperation}
  new f:nan -> Decimal('NaN') {FloatOperation}
  fromfloat 2.5 -> Decimal('2.5')
  fromfloat 1.1 -> Decimal('1.100000000000000088817841970012523233890533447265625')
  fromfloat 1e-7 -> Decimal('9.99999999999999954748111825886258685613938723690807819366455078125E-8')
  tuple 3.14 -> DecimalTuple(sign=0, digits=(3, 1, 4), exponent=-2)
  tuple -0 -> DecimalTuple(sign=1, digits=(0,), exponent=0)
  tuple Inf -> DecimalTuple(sign=0, digits=(0,), exponent='F')
  tuple sNaN7 -> DecimalTuple(sign=0, digits=(7,), exponent='N')
  tuple 1.500E+8 -> DecimalTuple(sign=0, digits=(1, 5, 0, 0), exponent=5)
  ratio 3.14 -> (157, 50)
  ratio -123e5 -> (-12300000, 1)
  ratio 0.00 -> (0, 1)
  ratio 0.0625 -> (1, 16)
  ratio Inf -> OverflowError: cannot convert Infinity to integer ratio
  ratio NaN -> ValueError: cannot convert NaN to integer ratio
== str, repr and to_eng_string
  str 123E+1 -> '1.23E+3'
  str 0.000001 -> '0.000001'
  str 0.0000001 -> '1E-7'
  str -1.20E-7 -> '-1.20E-7'
  str 1E+2 -> '1E+2'
  str 0E-8 -> '0E-8'
  eng 123E+1 -> '1.23E+3'
  eng 1E+7 -> '10E+6'
  eng 0.0000001 -> '100E-9'
  eng 0E-8 -> '0.00E-6'
  eng 0E+1 -> '0.00E+3'
  eng -12.3E-10 -> '-1.23E-9'
  eng 5E+2 -> '500'
  ctx capitals=0 -> Context(prec=28, rounding=ROUND_HALF_EVEN, Emin=-999999, Emax=999999, capitals=0, clamp=0, flags=[], traps=[DivisionByZero, Overflow, InvalidOperation])
  str 1E+5 -> '1e+5'
  eng 1E+5 -> '100e+3'
== addition and subtraction
  add 1.1 2.2 -> Decimal('3.3')
  add 1.30 1.20 -> Decimal('2.50')
  add 1E+2 1E-2 -> Decimal('100.01')
  add -5 5 -> Decimal('0')
  add 0.00 -0 -> Decimal('0.00')
  sub 1.3 1.07 -> Decimal('0.23')
  sub 1.3 2.07 -> Decimal('-0.77')
  add 9999999999999999999999999999 1 -> Decimal('1.000000000000000000000000000E+28') {Rounded}
  add 1E+50 1 -> Decimal('1.000000000000000000000000000E+50') {Inexact, Rounded}
  add 1 1E-40 -> Decimal('1.000000000000000000000000000') {Inexact, Rounded}
  add Inf -Inf -> InvalidOperation: -INF + INF {InvalidOperation}
  add Inf 5 -> Decimal('Infinity')
  add NaN3 1 -> Decimal('NaN3')
  sub -Inf -Inf -> InvalidOperation: -INF + INF {InvalidOperation}
  add 1 i:41 -> Decimal('42')
  add 1 f:0.5 -> TypeError: unsupported operand type(s) for +: 'Decimal' and 'float'
  ctx rounding=ROUND_FLOOR -> Context(prec=28, rounding=ROUND_FLOOR, Emin=-999999, Emax=999999, capitals=1, clamp=0, flags=[], traps=[DivisionByZero, Overflow, InvalidOperation])
  add 5 -5 -> Decimal('-0')
  sub 0 0 -> Decimal('-0')
  neg 0 -> Decimal('-0')
  pos -0 -> Decimal('-0')
== multiplication and division
  mul 1.20 3 -> Decimal('3.60')
  mul -7 1E-3 -> Decimal('-0.007')
  mul 0 -Inf -> InvalidOperation: 0 * (+-)INF {InvalidOperation}
  mul Inf -2 -> Decimal('-Infinity')
  mul 1.5 1.5 -> Decimal('2.25')
  div 1 3 -> Decimal('0.3333333333333333333333333333') {Inexact, Rounded}
  div 2 3 -> Decimal('0.6666666666666666666666666667') {Inexact, Rounded}
  div 1 4 -> Decimal('0.25')
  div 12 12 -> Decimal('1')
  div 8.00 2 -> Decimal('4.00')
  div 2.400 2.0 -> Decimal('1.20')
  div 1000 1E-3 -> Decimal('1.000E+6')
  div 1 0 -> DivisionByZero: x / 0 {DivisionByZero}
  div 0 0 -> InvalidOperation: 0 / 0 {InvalidOperation}
  div -0 5 -> Decimal('-0')
  div Inf Inf -> InvalidOperation: (+-)INF/(+-)INF {InvalidOperation}
  div 5 Inf -> Decimal('0E-1000026') {Clamped}
  div 2.40E+6 2 -> Decimal('1.20E+6')
  div 1 i:7 -> Decimal('0.1428571428571428571428571429') {Inexact, Rounded}
== integer division and remainders
  floordiv 7 2 -> Decimal('3')
  floordiv -7 2 -> Decimal('-3')
  mod -7 2 -> Decimal('-1')
  mod 7 -2 -> Decimal('1')
  mod 10 3.3 -> Decimal('0.1')
  divmod 7.5 2 -> (Decimal('3'), Decimal('1.5'))
  divmod -7.5 2 -> (Decimal('-3'), Decimal('-1.5'))
  divmod 1 0 -> DivisionByZero: x // 0 {DivisionByZero}
  divmod Inf 3 -> InvalidOperation: INF % x {InvalidOperation}
  floordiv 1E+40 3 -> InvalidOperation: quotient too large in //, % or divmod {InvalidOperation}
  remnear 10 6 -> Decimal('-2')
  remnear 2.1 3 -> Decimal('-0.9')
  remnear -10 3 -> Decimal('-1')
  remnear 3.6 1.3 -> Decimal('-0.3')
  remnear 10 0.3 -> Decimal('0.1')
  remnear 1E+40 3 -> InvalidOperation: None {InvalidOperation}
  mod 5 0 -> InvalidOperation: x % 0 {InvalidOperation}
  floordiv 0 0 -> InvalidOperation: 0 // 0 {InvalidOperation}
== powers
  pow 2 10 -> Decimal('1024')
  pow 2 -2 -> Decimal('0.25')
  pow 10 -3 -> Decimal('0.001')
  pow 1.1 2 -> Decimal('1.21')
  pow -2 3 -> Decimal('-8')
  pow -2 -3 -> Decimal('-0.125')
  pow 4 0.5 -> Decimal('2.000000000000000000000000000') {Inexact, Rounded}
  pow 2 0.5 -> Decimal('1.414213562373095048801688724') {Inexact, Rounded}
  pow 8 1/3 -> InvalidOperation: Invalid literal for Decimal: '1/3' {InvalidOperation}
  pow 8 0.333 -> Decimal('1.998614185980905043844758711') {Inexact, Rounded}
  pow 1.0 5 -> Decimal('1.00000')
  pow 1.00 -3 -> Decimal('1')
  pow 0 0 -> InvalidOperation: 0 ** 0 {InvalidOperation}
  pow 0 -1 -> Decimal('Infinity')
  pow -0 -1 -> Decimal('-Infinity')
  pow Inf -1 -> Decimal('0')
  pow -1.5 0.5 -> InvalidOperation: x ** y with x negative and y not an integer {InvalidOperation}
  pow 1.0001 10000 -> Decimal('2.718145926825224864037664675') {Inexact, Rounded}
  pow 0.9 100 -> Decimal('0.00002656139888758747693387813220') {Inexact, Rounded}
  pow 10 1000000 -> Overflow: above Emax {Overflow}
  pow 3 -0.75 -> Decimal('0.4386913376508308202730729673') {Inexact, Rounded}
  pow 25 -0.5 -> Decimal('0.2000000000000000000000000000') {Inexact, Rounded}
  pow 1E-5 2.5 -> Decimal('3.162277660168379331998893544E-13') {Inexact, Rounded}
  powmod 3 200 7 -> Decimal('2')
  powmod -2 3 5 -> Decimal('-3')
  powmod 2.5 2 3 -> InvalidOperation: pow() 3rd argument not allowed unless all arguments are integers {InvalidOperation}
  powmod 2 -1 3 -> InvalidOperation: pow() 2nd argument cannot be negative when 3rd argument specified {InvalidOperation}
== quantize and rounding modes
  quantize 1.41421356 0.001 -> Decimal('1.414') {Inexact, Rounded}
  quantize 2.5 1 -> Decimal('2') {Inexact, Rounded}
  quantize 3.5 1 -> Decimal('4') {Inexact, Rounded}
  quantize -2.5 1 -> Decimal('-2') {Inexact, Rounded}
  quantize 1.005 0.01 ROUND_HALF_UP -> Decimal('1.01') {Inexact, Rounded}
  quantize 1.005 0.01 ROUND_HALF_DOWN -> Decimal('1.00') {Inexact, Rounded}
  quantize 1.015 0.01 ROUND_HALF_EVEN -> Decimal('1.02') {Inexact, Rounded}
  quantize 1.001 0.01 ROUND_UP -> Decimal('1.01') {Inexact, Rounded}
  quantize -1.009 0.01 ROUND_DOWN -> Decimal('-1.00') {Inexact, Rounded}
  quantize -1.001 0.01 ROUND_FLOOR -> Decimal('-1.01') {Inexact, Rounded}
  quantize -1.009 0.01 ROUND_CEILING -> Decimal('-1.00') {Inexact, Rounded}
  quantize 1.04 0.1 ROUND_05UP -> Decimal('1.1') {Inexact, Rounded}
  quantize 1.06 0.1 ROUND_05UP -> Decimal('1.1') {Inexact, Rounded}
  quantize 1.51 0.1 ROUND_05UP -> Decimal('1.6') {Inexact, Rounded}
  quantize 123.456 1E+1 -> Decimal('1.2E+2') {Inexact, Rounded}
  quantize 0 1E-5 -> Decimal('0.00000')
  quantize 1E+30 0.01 -> InvalidOperation: quantize result has too many digits for current context {InvalidOperation}
  quantize Inf 1 -> InvalidOperation: quantize with one INF {InvalidOperation}
  quantize Inf -Inf -> Decimal('Infinity')
  quantize 1 NaN -> Decimal('NaN')
  quantize 5 1E+1000000 -> InvalidOperation: target exponent out of bounds in quantize {InvalidOperation}
  round 2.675 2 -> Decimal('2.68') {Inexact, Rounded}
  round 2.5 -> 2
  round -0.5 -> 0
  round 123.456 -1 -> Decimal('1.2E+2') {Inexact, Rounded}
  round Inf -> OverflowError: cannot round an infinity
  round NaN -> ValueError: cannot round a NaN
  floor -1.5 -> -2
  ceil -1.5 -> -1
  int -9.99 -> -9
  int 1E+3 -> 1000
  int Inf -> OverflowError: Cannot convert infinity to integer
  int NaN -> ValueError: Cannot convert NaN to integer
