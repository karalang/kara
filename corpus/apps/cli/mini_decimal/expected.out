== comparisons
  eq 1.0 1 -> True
  eq 0 -0 -> True
  eq NaN NaN -> False
  eq sNaN 1 -> InvalidOperation: sNaN {InvalidOperation}
  lt 1.1 1.10001 -> True
  lt NaN 1 -> InvalidOperation: comparison involving NaN {InvalidOperation}
  ge -Inf -1E+999 -> False
  lt 1.1 f:1.1 -> True {FloatOperation}
  eq 0.5 f:0.5 -> True {FloatOperation}
  eq 2 i:2 -> True
  compare 2.1 3 -> Decimal('-1')
  compare 2.1 2.10 -> Decimal('0')
  compare NaN 1 -> Decimal('NaN')
  cmpsignal NaN 1 -> InvalidOperation: comparison involving NaN {InvalidOperation}
  cmptotal 12.30 12.3 -> Decimal('-1')
  cmptotal -0 0 -> Decimal('-1')
  cmptotal NaN Inf -> Decimal('1')
  cmptotal sNaN2 NaN1 -> Decimal('-1')
  cmptotal -NaN -sNaN -> Decimal('-1')
  cmptotalmag -3 2 -> Decimal('1')
  max 1 2 -> Decimal('2')
  max 1.0 1 -> Decimal('1')
  max -0 0 -> Decimal('0')
  max NaN 3 -> Decimal('3')
  min 1.00 1.0 -> Decimal('1.00')
  min sNaN 3 -> InvalidOperation: sNaN {InvalidOperation}
  maxmag -3 2 -> Decimal('-3')
  minmag -3 2 -> Decimal('2')
  minmag -2 2 -> Decimal('-2')
== next values and classes
  nextplus 1 -> Decimal('1.000000000000000000000000001')
  nextplus -1E-1000007 -> Decimal('-9.999999999999999999E-1000008')
  nextminus 1 -> Decimal('0.9999999999999999999999999999')
  nextminus Inf -> Decimal('9.999999999999999999999999999E+999999')
  nextplus -Inf -> Decimal('-9.999999999999999999999999999E+999999')
  nexttoward 1 2 -> Decimal('1.000000000000000000000000001')
  nexttoward 1 0 -> Decimal('0.9999999999999999999999999999')
  nexttoward 1 1.0 -> Decimal('1')
  nexttoward -1 -1 -> Decimal('-1')
  ctx prec=5 Emax=99 Emin=-99 traps= -> Context(prec=5, rounding=ROUND_HALF_EVEN, Emin=-99, Emax=99, capitals=1, clamp=0, flags=[], traps=[])
  nexttoward 9.9999E+99 Inf -> Decimal('Infinity') {Inexact, Overflow, Rounded}
  nexttoward 1E-103 0 -> Decimal('0E-103') {Clamped, Inexact, Rounded, Underflow, Subnormal}
  nextplus 9.9999E+99 -> Decimal('Infinity')
  class 0 -> '+Zero'
  class -0 -> '-Zero'
  class 1E-100 -> '+Subnormal'
  class -1E-101 -> '-Subnormal'
  class 2.50 -> '+Normal'
  class -Inf -> '-Infinity'
  class NaN -> 'NaN'
  class sNaN -> 'sNaN'
  isnormal 1E-99 -> True
  issubnormal 1E-100 -> True
  adjusted 123.45 -> 2
  adjusted 0.001 -> -3
  adjusted Inf -> 0
  samequantum 2.17 0.001 -> False
  samequantum 2.17 0.01 -> True
  samequantum Inf -Inf -> True
  samequantum NaN 1 -> False
== digit operations
  ctx prec=9 -> Context(prec=9, rounding=ROUND_HALF_EVEN, Emin=-999999, Emax=999999, capitals=1, clamp=0, flags=[], traps=[DivisionByZero, Overflow, InvalidOperation])
  scaleb 7.50 -2 -> Decimal('0.0750')
  scaleb 7.50 3 -> Decimal('7.50E+3')
  scaleb 1 1.5 -> InvalidOperation: None {InvalidOperation}
  rotate 34 8 -> Decimal('400000003')
  rotate 12 9 -> Decimal('12')
  rotate 123456789 -2 -> Decimal('891234567')
  rotate 123456789 10 -> InvalidOperation: None {InvalidOperation}
  shift 34 8 -> Decimal('400000000')
  shift 12 9 -> Decimal('0')
  shift 123456789 -2 -> Decimal('1234567')
  shift 123456789 +2 -> Decimal('345678900')
  and 1101 1011 -> Decimal('1001')
  or 1101 1011 -> Decimal('1111')
  xor 1101 1011 -> Decimal('110')
  invert 101 -> Decimal('111111010')
  invert 0 -> Decimal('111111111')
  and 12 1 -> InvalidOperation: None {InvalidOperation}
  copysign 1.50 -7 -> Decimal('-1.50')
  copyabs -Inf -> Decimal('Infinity')
  copynegate 0 -> Decimal('-0')
  normalize 120.000 -> Decimal('1.2E+2')
  normalize 0.00 -> Decimal('0')
  normalize -1E+1 -> Decimal('-1E+1')
  integral 2.5 -> Decimal('2')
  integral -1.7 -> Decimal('-2')
  integralx 2.5 -> Decimal('2') {Inexact, Rounded}
  integralx 7.0 -> Decimal('7') {Rounded}
  integralx 1E+3 -> Decimal('1E+3')
  fma 2 3 4 -> Decimal('10')
  fma 1E+27 1E+27 -1E+54 -> Decimal('0E+54')
  fma Inf 0 1 -> InvalidOperation: INF * 0 in fma {InvalidOperation}
== formatting
  format 1234567.891 ,.2f -> '1,234,567.89'
  format 1234567.891 _.1f -> '1_234_567.9'
  format -0.000 .2f -> '-0.00'
  format -0.000 z.2f -> '0.00'
  format 0.5 .0% -> '50%'
  format 0.12345 .1% -> '12.3%'
  format 123.456 e -> '1.23456e+2'
