    s.push_str("light\t1\tsometimes\n");
    s.push_str("light\t2\tyou\n");
    s.push_str("light\t2\tjust\n");
    s.push_str("light\t1\twant\n");
    s.push_str("light\t2\tto\n");
    s.push_str("light\t2\tdraw\n");
    s.push_str("light\t3\ttrees\n");
    s.push_str("light\t1\tin\n");
    s.push_str("light\t1\tyour\n");
    s.push_str("light\t1\tterminal\n");
    s.push_str("heavy\t0\tP\n");
    s.push_str("heavy\t1\tA\n");
    s.push_str("heavy\t2\tB\n");
    s.push_str("heavy\t2\tC\n");
    s.push_str("heavy\t1\tD\n");
    s.push_str("double\t0\t/\n");
    s.push_str("double\t1\tetc\n");
    s.push_str("double\t2\tnginx\n");
    s.push_str("double\t3\tnginx.conf\n");
    s.push_str("double\t2\thosts\n");
    s.push_str("double\t1\thome\n");
    s.push_str("double\t2\talice\n");
    s.push_str("double\t2\tbob\n");
    s.push_str("double\t1\tvar\n");
    s.push_str("double\t2\tlog\n");
    s.push_str("blank\t0\troot\n");
    s.push_str("blank\t1\ta\n");
    s.push_str("blank\t2\taa\n");
    s.push_str("blank\t1\tb\n");
    s.push_str("legacy\t0\troot\n");
    s.push_str("legacy\t1\tsub1\n");
    s.push_str("legacy\t2\tleaf1\n");
    s.push_str("legacy\t2\tleaf2\n");
    s.push_str("legacy\t1\tsub2\n");
    s.push_str("legacy\t2\tleaf3\n");
    s.push_str("ascii\t0\tsingle\n");
    s.push_str("ascii\t0\tr\n");
    s.push_str("ascii\t1\tonly-child\n");
    s.push_str("ascii\t2\tgrand\n");
    s.push_str("light\t0\tdeep\n");
    s.push_str("light\t1\tl1\n");
    s.push_str("light\t2\tl2\n");
    s.push_str("light\t3\tl3\n");
    s.push_str("light\t4\tl4\n");
    s.push_str("light\t1\tsibling\n");
    s.push_str("ascii\t0\tFilesystem\n");
    s.push_str("ascii\t1\tbin\n");
    s.push_str("ascii\t1\tboot\n");
    s.push_str("ascii\t2\tgrub\n");
    s.push_str("ascii\t1\tdev\n");
    s.push_str("ascii\t1\tetc\n");
    s.push_str("ascii\t2\tinit.d\n");
    s.push_str("ascii\t2\trc.d\n");
    s.push_str("ascii\t3\trc.local\n");
    s.push_str("ascii\t1\tusr\n");
    s.push_str("ascii\t2\tbin\n");
    s.push_str("ascii\t2\tlib\n");
    s.push_str("ascii\t2\tlocal\n");
    s.push_str("ascii\t3\tbin\n");
    s.push_str("ascii\t1\tvar\n");
    s.push_str("ascii\t2\tlog\n");
    s.push_str("ascii\t3\tsyslog\n");
    s.push_str("ascii\t2\ttmp\n");
    s
}
