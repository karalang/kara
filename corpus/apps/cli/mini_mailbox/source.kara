// mini_mailbox: Python 3.13's mailbox module, on top of the compat32
// email package ported for mini_mailparser. It reads and writes the five
// formats the module knows: mbox and MMDF single files, Emacs Rmail
// (Babyl), MH folders with their .mh_sequences, and Maildir with
// Maildir++ folders; and the message kinds, with the tables that carry
// flags, sequences and labels from one format to another.
//
// The run writes data/ first: the mailboxes under data/mail/, three raw
// messages under data/raw/, and data/jobs.tsv. Each job copies what it
// needs under data/work/ and opens mailboxes there: it lists and reads
// messages, edits flags and writes the files back, delivers messages,
// converts between formats, moves mail between mailboxes, packs MH
// folders, makes and removes folders, and runs the programs a mail client
// would: an unread count across every mailbox, a search, a digest, an
// archive of old mail and a dedupe by Message-ID.
// ------------------------------------------------------------ characters

fn chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn text(v: ref Vec[char]) -> String {
    v.iter().collect()
}

fn slice(v: ref Vec[char], lo: i64, hi: i64) -> Vec[char] {
    let mut a = lo;
    let mut b = hi;
    if a < 0 {
        a = 0;
    }
    if b > v.len() {
        b = v.len();
    }
    if a >= b {
        return Vec.new();
    }
    v[a..b].to_vec()
}

fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

// str.isspace, which str.strip, str.split and float() use.
fn py_space(c: char) -> bool {
    c.is_whitespace() or (c >= '\u{1c}' and c <= '\u{1f}')
}

fn py_strip(s: ref String) -> String {
    let v = chars(s);
    let mut lo = 0;
    let mut hi = v.len();
    while lo < hi and py_space(v[lo]) {
        lo += 1;
    }
    while hi > lo and py_space(v[hi - 1]) {
        hi -= 1;
    }
    text(slice(v, lo, hi))
}

// str.splitlines()
fn line_break(c: char) -> bool {
    c == '\n' or c == '\r' or c == '\u{b}' or c == '\u{c}' or c == '\u{1c}' or c == '\u{1d}' or c == '\u{1e}'
        or c == '\u{85}' or c == '\u{2028}' or c == '\u{2029}'
}

fn splitlines(s: ref String) -> Vec[String] {
    let v = chars(s);
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    let mut i = 0;
    while i < v.len() {
        let c = v[i];
        if line_break(c) {
            out.push(cur);
            cur = String.new();
            if c == '\r' and i + 1 < v.len() and v[i + 1] == '\n' {
                i += 1;
            }
        } else {
            cur.push(c);
        }
        i += 1;
    }
    if not cur.is_empty() {
        out.push(cur);
    }
    out
}

fn hex_digits(v: i64, n: i64) -> String {
    let mut s = f"{v:x}";
    while s.len() < n {
        s = f"0{s}";
    }
    s
}

fn printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) or (c >= 0x205F and c <= 0x206F) {
        return false;
    }
    if c == 0x3000 or c == 0xFEFF or (c >= 0xE000 and c <= 0xF8FF) or c >= 0xF0000 {
        return false;
    }
    true
}

// repr(str)
fn repr_str(s: ref String) -> String {
    let single = s.contains("'");
    let double = s.contains("\"");
    let q = if single and not double { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        let o = c as i64;
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if printable(o) {
            out.push(c);
        } else if o < 0x100 {
            out.push_str(f"\\x{hex_digits(o, 2)}");
        } else if o < 0x10000 {
            out.push_str(f"\\u{hex_digits(o, 4)}");
        } else {
            out.push_str(f"\\U{hex_digits(o, 8)}");
        }
    }
    out.push(q);
    out
}

// ------------------------------------------------------------ text helpers

// len(s), in code points.
fn width(s: ref String) -> i64 {
    s.chars().count()
}

fn py_lstrip(s: ref String) -> String {
    let v = chars(s);
    let mut lo = 0;
    while lo < v.len() and py_space(v[lo]) {
        lo += 1;
    }
    text(slice(v, lo, v.len()))
}

fn py_isspace(s: ref String) -> bool {
    if s.is_empty() {
        return false;
    }
    for c in s.chars() {
        if not py_space(c) {
            return false;
        }
    }
    true
}

// str.split() with no separator: runs of whitespace.
fn py_split(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if py_space(c) {
            if not cur.is_empty() {
                out.push(cur);
                cur = String.new();
            }
        } else {
            cur.push(c);
        }
    }
    if not cur.is_empty() {
        out.push(cur);
    }
    out
}

fn last_char(s: ref String) -> char {
    s.chars().rev().next().unwrap_or('\u{0}')
}

fn first_char(s: ref String) -> char {
    s.chars().next().unwrap_or('\u{0}')
}

fn count_of(s: ref String, c: char) -> i64 {
    let mut n = 0;
    for x in s.chars() {
        if x == c {
            n += 1;
        }
    }
    n
}

fn has_char(set: Str, c: char) -> bool {
    for x in set.chars() {
        if x == c {
            return true;
        }
    }
    false
}

fn opt_repr(s: ref Option[String]) -> String {
    match s {
        Some(t) => repr_str(t),
        None => "None".to_string(),
    }
}

// repr(bytes)
fn repr_bytes(b: ref Vec[u8]) -> String {
    let mut single = false;
    let mut double = false;
    for c in b.iter() {
        if *c == b'\'' {
            single = true;
        }
        if *c == b'"' {
            double = true;
        }
    }
    let q: u8 = if single and not double { b'"' } else { b'\'' };
    let mut out = "b".to_string();
    out.push(char.try_from(q as i64).unwrap_or('?'));
    for x in b.iter() {
        let c = *x;
        if c == q or c == b'\\' {
            out.push('\\');
            out.push(char.try_from(c as i64).unwrap_or('?'));
        } else if c == b'\t' {
            out.push_str("\\t");
        } else if c == b'\n' {
            out.push_str("\\n");
        } else if c == b'\r' {
            out.push_str("\\r");
        } else if c < 0x20 or c >= 0x7F {
            out.push_str(f"\\x{hex_digits(c as i64, 2)}");
        } else {
            out.push(char.try_from(c as i64).unwrap_or('?'));
        }
    }
    out.push(char.try_from(q as i64).unwrap_or('?'));
    out
}

// ------------------------------------------------------------ codecs

#[derive(Clone, PartialEq)]
enum Codec {
    Utf8,
    Latin1,
    Ascii,
    Cp1252,
    Latin9,
}

// codecs.lookup(name), for the five codecs the port has: the name is
// lowercased, runs of other characters than letters, digits and "." become
// one "_", and the result is looked up among the encodings' aliases.
fn lookup_codec(name: ref String) -> Result[Codec, String] {
    let mut norm = String.new();
    let mut pending = false;
    for c in name.to_lowercase().chars() {
        if c.is_alphanumeric() or c == '.' {
            if pending and not norm.is_empty() {
                norm.push('_');
            }
            pending = false;
            norm.push(c);
        } else {
            pending = true;
        }
    }
    let n = norm.as_str();
    if n == "utf_8" or n == "utf8" or n == "u8" or n == "utf" or n == "utf8_ucs2" or n == "utf8_ucs4" or n == "cp65001" {
        return Ok(Codec.Utf8);
    }
    if n == "latin_1" or n == "latin1" or n == "iso_8859_1" or n == "iso8859_1" or n == "8859" or n == "cp819"
        or n == "l1" or n == "latin" or n == "iso_ir_100" or n == "csisolatin1" or n == "iso_8859_1_1987" {
        return Ok(Codec.Latin1);
    }
    if n == "ascii" or n == "us_ascii" or n == "us" or n == "646" or n == "cp367" or n == "csascii" or n == "ibm367"
        or n == "iso646_us" or n == "iso_646.irv_1991" or n == "iso_ir_6" or n == "ansi_x3.4_1968"
        or n == "ansi_x3.4_1986" or n == "ansi_x3_4_1968" {
        return Ok(Codec.Ascii);
    }
    if n == "cp1252" or n == "windows_1252" or n == "1252" {
        return Ok(Codec.Cp1252);
    }
    if n == "iso8859_15" or n == "iso_8859_15" or n == "latin9" or n == "latin_9" or n == "l9" or n == "8859_15" {
        return Ok(Codec.Latin9);
    }
    Err(f"LookupError: unknown encoding: {name}")
}

fn codec_label(c: ref Codec) -> Str {
    match c {
        Codec.Utf8 => "utf-8",
        Codec.Latin1 => "latin-1",
        Codec.Ascii => "ascii",
        _ => "charmap",
    }
}

fn codec_reason(c: ref Codec) -> Str {
    match c {
        Codec.Latin1 => "ordinal not in range(256)",
        Codec.Ascii => "ordinal not in range(128)",
        _ => "character maps to <undefined>",
    }
}

// Windows-1252's 0x80..0x9F; 0 where the byte is undefined.
fn cp1252_high(b: i64) -> i64 {
    let t = [0x20AC, 0, 0x201A, 0x0192, 0x201E, 0x2026, 0x2020, 0x2021, 0x02C6, 0x2030, 0x0160, 0x2039, 0x0152, 0,
        0x017D, 0, 0, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014, 0x02DC, 0x2122, 0x0161, 0x203A, 0x0153,
        0, 0x017E, 0x0178];
    t[b - 0x80]
}

// The eight places where ISO 8859-15 differs from Latin-1.
fn latin9_byte(cp: i64) -> i64 {
    let t = [(0xA4, 0x20AC), (0xA6, 0x0160), (0xA8, 0x0161), (0xB4, 0x017D), (0xB8, 0x017E), (0xBC, 0x0152),
        (0xBD, 0x0153), (0xBE, 0x0178)];
    for (b, u) in t.iter() {
        if u == cp {
            return b;
        }
        if b == cp {
            return -1;
        }
    }
    if cp < 0x100 { cp } else { -1 }
}

fn latin9_char(b: i64) -> i64 {
    let t = [(0xA4, 0x20AC), (0xA6, 0x0160), (0xA8, 0x0161), (0xB4, 0x017D), (0xB8, 0x017E), (0xBC, 0x0152),
        (0xBD, 0x0153), (0xBE, 0x0178)];
    for (x, u) in t.iter() {
        if x == b {
            return u;
        }
    }
    b
}

// The byte that `cp` encodes to, or -1.
fn encode_one(c: ref Codec, cp: i64) -> i64 {
    match c {
        Codec.Latin1 => if cp < 0x100 { cp } else { -1 },
        Codec.Ascii => if cp < 0x80 { cp } else { -1 },
        Codec.Latin9 => latin9_byte(cp),
        _ => {
            if cp < 0x80 or (cp >= 0xA0 and cp < 0x100) {
                return cp;
            }
            for b in 0x80..0xA0 {
                if cp1252_high(b) == cp and cp != 0 {
                    return b;
                }
            }
            -1
        }
    }
}

fn char_escape(cp: i64) -> String {
    if cp < 0x100 {
        f"\\x{hex_digits(cp, 2)}"
    } else if cp < 0x10000 {
        f"\\u{hex_digits(cp, 4)}"
    } else {
        f"\\U{hex_digits(cp, 8)}"
    }
}

// str.encode(codec) with errors="strict"; the UnicodeEncodeError names
// the run of characters that cannot be encoded.
fn encode_str(s: ref String, c: ref Codec) -> Result[Vec[u8], String] {
    let mut out: Vec[u8] = Vec.new();
    if *c == Codec.Utf8 {
        return Ok(s.bytes().to_vec());
    }
    let v = chars(s);
    let mut i = 0;
    while i < v.len() {
        let b = encode_one(c, v[i] as i64);
        if b < 0 {
            let mut end = i + 1;
            while end < v.len() and encode_one(c, v[end] as i64) < 0 {
                end += 1;
            }
            let label = codec_label(c);
            let reason = codec_reason(c);
            if end == i + 1 {
                return Err(f"UnicodeEncodeError: '{label}' codec can't encode character '{char_escape(v[i] as i64)}' in position {i}: {reason}");
            }
            return Err(f"UnicodeEncodeError: '{label}' codec can't encode characters in position {i}-{end - 1}: {reason}");
        }
        out.push(b as u8);
        i += 1;
    }
    Ok(out)
}

fn cont(b: ref Vec[u8], i: i64, lo: u8, hi: u8) -> bool {
    i < b.len() and b[i] >= lo and b[i] <= hi
}

// One step of CPython's UTF-8 decoder at b[i]: (code point, length), or
// (-1, length of the bad span, reason).
fn utf8_step(b: ref Vec[u8], i: i64) -> (i64, i64, Str) {
    let c = b[i];
    if c < 0x80 {
        return (c as i64, 1, "");
    }
    let (n, lo, hi) = if c >= 0xC2 and c <= 0xDF {
        (2, 0x80, 0xBF)
    } else if c == 0xE0 {
        (3, 0xA0, 0xBF)
    } else if c == 0xED {
        (3, 0x80, 0x9F)
    } else if c >= 0xE1 and c <= 0xEF {
        (3, 0x80, 0xBF)
    } else if c == 0xF0 {
        (4, 0x90, 0xBF)
    } else if c == 0xF4 {
        (4, 0x80, 0x8F)
    } else if c >= 0xF1 and c <= 0xF3 {
        (4, 0x80, 0xBF)
    } else {
        return (-1, 1, "invalid start byte");
    };
    let mut k = 0;
    while k < n - 1 {
        let (l, h) = if k == 0 { (lo as u8, hi as u8) } else { (0x80 as u8, 0xBF as u8) };
        if not cont(b, i + 1 + k, l, h) {
            if i + 1 + k >= b.len() {
                return (-1, 1 + k, "unexpected end of data");
            }
            return (-1, 1 + k, "invalid continuation byte");
        }
        k += 1;
    }
    let mut cp = if n == 2 { c as i64 & 0x1F } else if n == 3 { c as i64 & 0x0F } else { c as i64 & 0x07 };
    for j in 1..n {
        cp = cp * 64 + (b[i + j] as i64 & 0x3F);
    }
    (cp, n, "")
}

fn push_cp(out: mut ref String, cp: i64) {
    out.push(char.try_from(cp).unwrap_or('?'));
}

// bytes.decode(codec, errors) for errors "strict" and "replace".
fn decode_bytes(b: ref Vec[u8], c: ref Codec, replace: bool) -> Result[String, String] {
    let mut out = String.new();
    let mut i = 0;
    while i < b.len() {
        // Workaround (B-2026-10-19-4): without the annotation the literal-only
        // nested if arm is not coerced to Str.
        let (cp, n, reason): (i64, i64, Str) = match c {
            Codec.Utf8 => utf8_step(b, i),
            Codec.Latin1 => (b[i] as i64, 1, ""),
            Codec.Latin9 => (latin9_char(b[i] as i64), 1, ""),
            Codec.Ascii => if b[i] < 0x80 { (b[i] as i64, 1, "") } else { (-1, 1, "ordinal not in range(128)") },
            Codec.Cp1252 => {
                let x = b[i] as i64;
                if x < 0x80 or x >= 0xA0 {
                    (x, 1, "")
                } else if cp1252_high(x) != 0 {
                    (cp1252_high(x), 1, "")
                } else {
                    (-1, 1, "character maps to <undefined>")
                }
            }
        };
        if cp >= 0 {
            push_cp(mut out, cp);
            i += n;
            continue;
        }
        if replace {
            out.push('\u{FFFD}');
            i += n;
            continue;
        }
        let label = codec_label(c);
        if n == 1 {
            return Err(f"UnicodeDecodeError: '{label}' codec can't decode byte 0x{hex_digits(b[i] as i64, 2)} in position {i}: {reason}");
        }
        return Err(f"UnicodeDecodeError: '{label}' codec can't decode bytes in position {i}-{i + n - 1}: {reason}");
    }
    Ok(out)
}

fn encode_named(s: ref String, name: ref String) -> Result[Vec[u8], String] {
    let c = lookup_codec(name)?;
    encode_str(s, c)
}

// str.encode("raw-unicode-escape")
fn raw_unicode_escape(s: ref String) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for c in s.chars() {
        let o = c as i64;
        if o < 0x100 {
            out.push(o as u8);
        } else {
            let e = if o < 0x10000 { f"\\u{hex_digits(o, 4)}" } else { f"\\U{hex_digits(o, 8)}" };
            for x in e.bytes() {
                out.push(*x);
            }
        }
    }
    out
}

// ------------------------------------------------------------ base64 and Q

fn b64_value(c: u8) -> i64 {
    if c >= b'A' and c <= b'Z' {
        c as i64 - 65
    } else if c >= b'a' and c <= b'z' {
        c as i64 - 71
    } else if c >= b'0' and c <= b'9' {
        c as i64 + 4
    } else if c == b'+' {
        62
    } else if c == b'/' {
        63
    } else {
        -1
    }
}

// binascii.a2b_base64 without strict_mode, as CPython 3.13 runs it:
// characters outside the alphabet and every "=" are skipped, and only a
// part-filled last quad must have been padded. None where it raises.
fn a2b_base64(v: ref Vec[u8]) -> Option[Vec[u8]] {
    let mut out: Vec[u8] = Vec.new();
    let mut quad_pos = 0;
    let mut left: i64 = 0;
    let mut pads = 0;
    for x in v.iter() {
        let ch = *x;
        if ch == b'=' {
            if quad_pos >= 2 {
                pads += 1;
            }
            continue;
        }
        let d = b64_value(ch);
        if d < 0 {
            continue;
        }
        pads = 0;
        if quad_pos == 0 {
            quad_pos = 1;
            left = d;
        } else if quad_pos == 1 {
            quad_pos = 2;
            out.push(((left << 2) | (d >> 4)) as u8);
            left = d & 15;
        } else if quad_pos == 2 {
            quad_pos = 3;
            out.push(((left << 4) | (d >> 2)) as u8);
            left = d & 3;
        } else {
            quad_pos = 0;
            out.push(((left << 6) | d) as u8);
            left = 0;
        }
    }
    if quad_pos == 1 or (quad_pos >= 2 and quad_pos + pads < 4) {
        return None;
    }
    Some(out)
}

fn b64encode(b: ref Vec[u8]) -> String {
    let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/".bytes();
    let mut out = String.new();
    let mut i = 0;
    while i < b.len() {
        let n = if b.len() - i >= 3 { 3 } else { b.len() - i };
        let b0 = b[i] as i64;
        let b1 = if n > 1 { b[i + 1] as i64 } else { 0 };
        let b2 = if n > 2 { b[i + 2] as i64 } else { 0 };
        let v = (b0 << 16) | (b1 << 8) | b2;
        out.push(char.try_from(alphabet[(v >> 18) & 63] as i64).unwrap_or('?'));
        out.push(char.try_from(alphabet[(v >> 12) & 63] as i64).unwrap_or('?'));
        if n > 1 {
            out.push(char.try_from(alphabet[(v >> 6) & 63] as i64).unwrap_or('?'));
        } else {
            out.push('=');
        }
        if n > 2 {
            out.push(char.try_from(alphabet[v & 63] as i64).unwrap_or('?'));
        } else {
            out.push('=');
        }
        i += 3;
    }
    out
}

// base64mime.header_length
fn b64_header_length(b: ref Vec[u8]) -> i64 {
    let mut n = (b.len() / 3) * 4;
    if b.len() % 3 != 0 {
        n += 4;
    }
    n
}

fn q_safe(c: u8) -> bool {
    (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z') or (c >= b'0' and c <= b'9') or c == b'-' or c == b'!'
        or c == b'*' or c == b'+' or c == b'/'
}

// quoprimime.header_length
fn q_header_length(b: ref Vec[u8]) -> i64 {
    let mut n = 0;
    for c in b.iter() {
        n += if q_safe(*c) or *c == b' ' { 1 } else { 3 };
    }
    n
}

// quoprimime.header_encode and base64mime.header_encode
fn q_header_encode(b: ref Vec[u8], charset: ref String) -> String {
    if b.is_empty() {
        return String.new();
    }
    let mut enc = String.new();
    for x in b.iter() {
        let c = *x;
        if q_safe(c) {
            enc.push(char.try_from(c as i64).unwrap_or('?'));
        } else if c == b' ' {
            enc.push('_');
        } else {
            enc.push_str(f"={hex_digits(c as i64, 2).to_uppercase()}");
        }
    }
    f"=?{charset}?q?{enc}?="
}

fn b64_header_encode(b: ref Vec[u8], charset: ref String) -> String {
    if b.is_empty() {
        return String.new();
    }
    f"=?{charset}?b?{b64encode(b)}?="
}

// quoprimime.header_decode: "_" is a space and each =XX a character.
fn q_header_decode(s: ref String) -> String {
    let v = chars(s.replace("_", " "));
    let mut out = String.new();
    let mut i = 0;
    while i < v.len() {
        if v[i] == '=' and i + 2 < v.len() and hex_value(v[i + 1]) >= 0 and hex_value(v[i + 2]) >= 0
            and (v[i + 1] as i64) < 128 and (v[i + 2] as i64) < 128 {
            push_cp(mut out, hex_value(v[i + 1]) * 16 + hex_value(v[i + 2]));
            i += 3;
        } else {
            out.push(v[i]);
            i += 1;
        }
    }
    out
}

fn hex_value(c: char) -> i64 {
    if c >= '0' and c <= '9' {
        c as i64 - 48
    } else if c >= 'a' and c <= 'f' {
        c as i64 - 87
    } else if c >= 'A' and c <= 'F' {
        c as i64 - 55
    } else {
        -1
    }
}

// ------------------------------------------------------------ email.charset

// header_encoding and body_encoding: 0 for none, then QP, BASE64 and
// SHORTEST as charset.py numbers them.
#[derive(Clone)]
struct Charset {
    input_charset: String,
    header_encoding: i64,
    body_encoding: i64,
    output_charset: String,
    input_codec: Option[String],
    output_codec: Option[String],
}

fn charset_alias(name: ref String) -> String {
    let n = name.as_str();
    let pairs = [("latin_1", "iso-8859-1"), ("latin-1", "iso-8859-1"), ("latin_2", "iso-8859-2"), ("latin-2", "iso-8859-2"),
        ("latin_3", "iso-8859-3"), ("latin-3", "iso-8859-3"), ("latin_4", "iso-8859-4"), ("latin-4", "iso-8859-4"),
        ("latin_5", "iso-8859-9"), ("latin-5", "iso-8859-9"), ("latin_6", "iso-8859-10"), ("latin-6", "iso-8859-10"),
        ("latin_7", "iso-8859-13"), ("latin-7", "iso-8859-13"), ("latin_8", "iso-8859-14"), ("latin-8", "iso-8859-14"),
        ("latin_9", "iso-8859-15"), ("latin-9", "iso-8859-15"), ("latin_10", "iso-8859-16"), ("latin-10", "iso-8859-16"),
        ("cp949", "ks_c_5601-1987"), ("euc_jp", "euc-jp"), ("euc_kr", "euc-kr"), ("ascii", "us-ascii")];
    for (a, c) in pairs.iter() {
        if *a == n {
            return c.to_string();
        }
    }
    name.clone()
}

// CHARSETS: (header encoding, body encoding, output charset or "").
fn charset_props(name: ref String) -> (i64, i64, String) {
    let n = name.as_str();
    let qp = ["iso-8859-1", "iso-8859-2", "iso-8859-3", "iso-8859-4", "iso-8859-9", "iso-8859-10", "iso-8859-13",
        "iso-8859-14", "iso-8859-15", "iso-8859-16", "windows-1252", "viscii"];
    for q in qp.iter() {
        if *q == n {
            return (1, 1, String.new());
        }
    }
    if n == "us-ascii" {
        return (0, 0, String.new());
    }
    if n == "big5" or n == "gb2312" or n == "koi8-r" {
        return (2, 2, String.new());
    }
    if n == "iso-2022-jp" {
        return (2, 0, String.new());
    }
    if n == "euc-jp" or n == "shift_jis" {
        return (2, 0, "iso-2022-jp".to_string());
    }
    if n == "utf-8" {
        return (3, 2, "utf-8".to_string());
    }
    (3, 2, String.new())
}

fn new_charset(input: ref String) -> Charset {
    let input_charset = charset_alias(input.to_lowercase());
    let (henc, benc, conv) = charset_props(input_charset);
    let conv = if conv.is_empty() { input_charset.clone() } else { conv };
    let output_charset = charset_alias(conv);
    let codec = |n: ref String| if n == "us-ascii" { None } else { Some(n.clone()) };
    Charset {
        input_charset: input_charset.clone(),
        header_encoding: henc,
        body_encoding: benc,
        output_charset: output_charset.clone(),
        input_codec: codec(input_charset),
        output_codec: codec(output_charset),
    }
}

// Charset == "name" compares the lowercased names; a missing charset
// (None) equals nothing.
fn cs_is(c: ref Option[Charset], name: Str) -> bool {
    match c {
        Some(x) => x.input_charset == name,
        None => false,
    }
}

fn cs_eq(a: ref Option[Charset], b: ref Option[Charset]) -> bool {
    match (a, b) {
        (Some(x), Some(y)) => x.input_charset == y.input_charset,
        _ => false,
    }
}

// `charset in (None, "us-ascii")`
fn cs_plain(c: ref Option[Charset]) -> bool {
    c.is_none() or cs_is(c, "us-ascii")
}

fn output_codec_name(c: ref Charset) -> String {
    // Python's `self.output_codec or 'us-ascii'`: an empty name is falsy too.
    match c.output_codec.clone() {
        Some(n) if not n.is_empty() => n,
        _ => "us-ascii".to_string(),
    }
}

// The encoder module _get_encoder picks: 1 quoprimime, 2 base64mime, 0 none.
fn get_encoder(c: ref Charset, b: ref Vec[u8]) -> i64 {
    if c.header_encoding == 3 {
        return if b64_header_length(b) < q_header_length(b) { 2 } else { 1 };
    }
    c.header_encoding
}

fn module_encode(m: i64, b: ref Vec[u8], charset: ref String) -> String {
    if m == 2 { b64_header_encode(b, charset) } else { q_header_encode(b, charset) }
}

fn module_length(m: i64, b: ref Vec[u8]) -> i64 {
    if m == 2 { b64_header_length(b) } else { q_header_length(b) }
}

// Charset.header_encode
fn header_encode(c: ref Charset, s: ref String) -> Result[String, String] {
    let codec = output_codec_name(c);
    let b = encode_named(s, codec)?;
    let m = get_encoder(c, b);
    if m == 0 {
        return Ok(s.clone());
    }
    Ok(module_encode(m, b, codec))
}

// Charset.header_encode_lines: the encoded words a string is cut into so
// that each fits the next of the given lengths. None where not even one
// character fit on the first line.
fn header_encode_lines(c: ref Charset, s: ref String, first: i64, rest: i64) -> Result[Vec[Option[String]], String] {
    let codec = output_codec_name(c);
    let all = encode_named(s, codec)?;
    let m = get_encoder(c, all);
    let charset = c.output_charset.clone();
    let extra = width(charset) + 7;
    let mut lines: Vec[Option[String]] = Vec.new();
    let mut current = String.new();
    let mut maxlen = first - extra;
    for ch in s.chars() {
        let mut this_line = current.clone();
        this_line.push(ch);
        let length = module_length(m, encode_named(this_line, charset)?);
        if length > maxlen {
            if lines.is_empty() and current.is_empty() {
                lines.push(None);
            } else {
                lines.push(Some(module_encode(m, encode_named(current, codec)?, codec)));
            }
            current = String.new();
            current.push(ch);
            maxlen = rest - extra;
        } else {
            current = this_line;
        }
    }
    lines.push(Some(module_encode(m, encode_named(current, codec)?, codec)));
    Ok(lines)
}

// ------------------------------------------------------------ email.header

// One match of header.py's ecre, =?charset?q-or-b?encoded?=, at or after
// `from`: (start, end, charset, encoding, encoded).
fn ecre_find(v: ref Vec[char], from: i64) -> Option[(i64, i64, String, String, String)] {
    let mut i = from;
    while i + 1 < v.len() {
        if v[i] == '=' and v[i + 1] == '?' {
            let mut q = i + 2;
            while q < v.len() and v[q] != '?' {
                q += 1;
            }
            if q + 2 < v.len() and has_char("qQbB", v[q + 1]) and v[q + 2] == '?' {
                let start = q + 3;
                let mut e = start;
                while e + 1 < v.len() and not (v[e] == '?' and v[e + 1] == '=') {
                    e += 1;
                }
                if e + 1 < v.len() {
                    let cs = text(slice(v, i + 2, q));
                    let enc = text(slice(v, q + 1, q + 2));
                    let body = text(slice(v, start, e));
                    return Some((i, e + 2, cs, enc, body));
                }
            }
        }
        i += 1;
    }
    None
}

#[derive(Clone)]
enum Word {
    Text(String),
    Data(Vec[u8]),
}

fn word_bytes(w: ref Word) -> Vec[u8] {
    match w {
        Word.Text(s) => raw_unicode_escape(s),
        Word.Data(b) => b.clone(),
    }
}

// decode_header for a string: Err for HeaderParseError. A header with no
// encoded word comes back whole, as the one Text chunk.
fn decode_header(header: ref String) -> Result[Vec[(Word, Option[String])], String] {
    if ecre_find(chars(header), 0).is_none() {
        return Ok(vec![(Word.Text(header.clone()), None)]);
    }
    // (text, encoding or "", charset)
    let mut words: Vec[(String, String, String)] = Vec.new();
    for line in splitlines(header) {
        let v = chars(line);
        let mut pos = 0;
        let mut first = true;
        loop {
            let found = ecre_find(v, pos);
            let end = match found.clone() {
                Some((s, _, _, _, _)) => s,
                None => v.len(),
            };
            let mut unencoded = text(slice(v, pos, end));
            if first {
                unencoded = py_lstrip(unencoded);
                first = false;
            }
            if not unencoded.is_empty() {
                words.push((unencoded, String.new(), String.new()));
            }
            match found {
                Some((_, e, cs, enc, body)) => {
                    words.push((body, enc.to_lowercase(), cs.to_lowercase()));
                    pos = e;
                }
                None => break,
            }
        }
    }
    let mut drop: Vec[i64] = Vec.new();
    for n in 0..words.len() {
        if n > 1 and not words[n].1.is_empty() and not words[n - 2].1.is_empty() and py_isspace(words[n - 1].0) {
            drop.push(n - 1);
        }
    }
    let mut kept: Vec[(String, String, String)] = Vec.new();
    for n in 0..words.len() {
        let mut dropped = false;
        for d in drop.iter() {
            if *d == n {
                dropped = true;
            }
        }
        if not dropped {
            kept.push(words[n].clone());
        }
    }
    let mut decoded: Vec[(Word, Option[String])] = Vec.new();
    for (s, enc, cs) in kept.iter() {
        if enc.is_empty() {
            decoded.push((Word.Text(s.clone()), None));
        } else if enc == "q" {
            decoded.push((Word.Text(q_header_decode(s)), Some(cs.clone())));
        } else {
            let mut padded = s.clone();
            let paderr = width(s) % 4;
            if paderr != 0 {
                for _ in 0..(4 - paderr) {
                    padded.push('=');
                }
            }
            match a2b_base64(raw_unicode_escape(padded)) {
                Some(b) => decoded.push((Word.Data(b), Some(cs.clone()))),
                None => return Err("HeaderParseError: Base64 decoding error".to_string()),
            }
        }
    }
    let mut collapsed: Vec[(Word, Option[String])] = Vec.new();
    let mut last: Option[Vec[u8]] = None;
    let mut last_cs: Option[String] = None;
    for (w, cs) in decoded.iter() {
        let b = word_bytes(w);
        match last.clone() {
            None => {
                last = Some(b);
                last_cs = cs.clone();
            }
            Some(lw) => {
                if *cs != last_cs {
                    collapsed.push((Word.Data(lw), last_cs.clone()));
                    last = Some(b);
                    last_cs = cs.clone();
                } else if last_cs.is_none() {
                    let mut j = lw.clone();
                    j.push(b' ');
                    for x in b.iter() {
                        j.push(*x);
                    }
                    last = Some(j);
                } else {
                    let mut j = lw.clone();
                    for x in b.iter() {
                        j.push(*x);
                    }
                    last = Some(j);
                }
            }
        }
    }
    collapsed.push((Word.Data(last.unwrap_or(Vec.new())), last_cs));
    Ok(collapsed)
}

fn decoded_repr(d: ref Vec[(Word, Option[String])]) -> String {
    let mut items: Vec[String] = Vec.new();
    for (w, cs) in d.iter() {
        let first = match w {
            Word.Text(s) => repr_str(s),
            Word.Data(b) => repr_bytes(b),
        };
        items.push(f"({first}, {opt_repr(cs)})");
    }
    f"[{items.join(", ")}]"
}

struct Header {
    charset: Charset,
    continuation_ws: String,
    chunks: Vec[(String, Option[Charset])],
    maxlinelen: i64,
    headerlen: i64,
}

fn new_header(charset: ref Option[String], maxlinelen: i64, header_name: ref Option[String], continuation_ws: ref String) -> Header {
    let cs = match charset {
        Some(n) => new_charset(n),
        None => new_charset("us-ascii".to_string()),
    };
    let headerlen = match header_name {
        Some(n) => width(n) + 2,
        None => 0,
    };
    Header { charset: cs, continuation_ws: continuation_ws.clone(), chunks: Vec.new(), maxlinelen: maxlinelen, headerlen: headerlen }
}

// ctext's complement: whitespace and the three characters a comment cannot
// hold.
fn nonctext(c: char) -> bool {
    py_space(c) or c == '(' or c == ')' or c == '\\'
}

impl Header {
    fn append(mut ref self, w: ref Word, charset: ref Option[Charset]) -> Result[(), String] {
        let mut cs = match charset {
            Some(c) => c.clone(),
            None => self.charset.clone(),
        };
        let s = match w {
            Word.Text(t) => t.clone(),
            Word.Data(b) => {
                let input = match cs.input_codec.clone() {
                    Some(n) if not n.is_empty() => n,
                    _ => "us-ascii".to_string(),
                };
                decode_bytes(b, lookup_codec(input)?, false)?
            }
        };
        let output = output_codec_name(cs);
        if let Err(e) = encode_named(s, output) {
            if output != "us-ascii" or not e.starts_with("UnicodeEncodeError") {
                return Err(e);
            }
            cs = new_charset("utf-8".to_string());
        }
        self.chunks.push((s, Some(cs)));
        Ok(())
    }

    fn normalize(mut ref self) {
        let mut chunks: Vec[(String, Option[Charset])] = Vec.new();
        let mut last_cs: Option[Charset] = None;
        let mut last: Vec[String] = Vec.new();
        for (s, cs) in self.chunks.iter() {
            if cs_eq(cs, last_cs) {
                last.push(s.clone());
            } else {
                if last_cs.is_some() {
                    chunks.push((last.join(" "), last_cs.clone()));
                }
                last = vec![s.clone()];
                last_cs = cs.clone();
            }
        }
        if not last.is_empty() {
            chunks.push((last.join(" "), last_cs));
        }
        self.chunks = chunks;
    }

    fn text(mut ref self) -> String {
        self.normalize();
        let mut out = String.new();
        let mut started = false;
        let mut lastcs: Option[Charset] = None;
        let mut lastspace = false;
        for (s, cs) in self.chunks.iter() {
            let mut nextcs = cs.clone();
            if started {
                let hasspace = not s.is_empty() and nonctext(first_char(s));
                if not cs_plain(lastcs) {
                    if cs_plain(nextcs) and not hasspace {
                        out.push(' ');
                        nextcs = None;
                    }
                } else if not cs_plain(nextcs) and not lastspace {
                    out.push(' ');
                }
            }
            lastspace = not s.is_empty() and nonctext(last_char(s));
            lastcs = nextcs;
            out.push_str(s);
            started = true;
        }
        out
    }

    fn encode(mut ref self, splitchars: ref String, maxlinelen: ref Option[i64], linesep: ref String) -> Result[String, String] {
        self.normalize();
        let mut maxlen = match maxlinelen {
            Some(n) => n,
            None => self.maxlinelen,
        };
        if maxlen == 0 {
            maxlen = 1000000;
        }
        let mut f = ValueFormatter {
            maxlen: maxlen,
            continuation_ws: self.continuation_ws.clone(),
            splitchars: splitchars.clone(),
            lines: Vec.new(),
            current: Accumulator { parts: Vec.new(), initial_size: self.headerlen },
        };
        let mut lastcs: Option[Charset] = None;
        let mut started = false;
        let mut lastspace = false;
        for (s, cs) in self.chunks.iter() {
            let charset = cs.clone().unwrap_or(new_charset("us-ascii".to_string()));
            if started {
                let hasspace = not s.is_empty() and nonctext(first_char(s));
                if not cs_plain(lastcs) {
                    if not hasspace or not cs_plain(cs) {
                        f.add_transition();
                    }
                } else if not cs_plain(cs) and not lastspace {
                    f.add_transition();
                }
            }
            lastspace = not s.is_empty() and nonctext(last_char(s));
            lastcs = cs.clone();
            started = true;
            let lines = splitlines(s);
            if lines.is_empty() {
                f.feed("", "", charset)?;
            } else {
                f.feed("", lines[0], charset)?;
            }
            for k in 1..lines.len() {
                f.newline();
                if charset.header_encoding != 0 {
                    f.feed(self.continuation_ws.clone(), f" {py_lstrip(lines[k])}", charset)?;
                } else {
                    let sline = py_lstrip(lines[k]);
                    let v = chars(lines[k]);
                    let fws = text(slice(v, 0, v.len() - width(sline)));
                    f.feed(fws, sline, charset)?;
                }
            }
            if lines.len() > 1 {
                f.newline();
            }
        }
        if not self.chunks.is_empty() {
            f.add_transition();
        }
        let value = f.finish(linesep);
        if embedded_header(value) {
            return Err(f"HeaderParseError: header value appears to contain an embedded header: {repr_str(value)}");
        }
        Ok(value)
    }
}

// _embedded_header.search(value): a line break, then a field name and ":".
fn embedded_header(value: ref String) -> bool {
    let v = chars(value);
    for i in 0..v.len() {
        if v[i] == '\n' {
            let mut j = i + 1;
            while j < v.len() and v[j] != ' ' and v[j] != '\t' {
                if v[j] == ':' and j > i + 1 {
                    return true;
                }
                j += 1;
            }
        }
    }
    false
}

#[derive(Clone)]
struct Accumulator {
    parts: Vec[(String, String)],
    initial_size: i64,
}

impl Accumulator {
    fn push(mut ref self, fws: ref String, s: ref String) {
        self.parts.push((fws.clone(), s.clone()));
    }

    fn pop(mut ref self) -> (String, String) {
        match self.parts.pop() {
            Some(p) => p,
            None => (String.new(), String.new()),
        }
    }

    fn pop_from(mut ref self, i: i64) -> Vec[(String, String)] {
        let mut tail: Vec[(String, String)] = Vec.new();
        for k in i..self.parts.len() {
            tail.push(self.parts[k].clone());
        }
        while self.parts.len() > i {
            self.parts.pop();
        }
        tail
    }

    fn len(ref self) -> i64 {
        let mut n = self.initial_size;
        for (f, s) in self.parts.iter() {
            n += width(f) + width(s);
        }
        n
    }

    fn text(ref self) -> String {
        let mut out = String.new();
        for (f, s) in self.parts.iter() {
            out.push_str(f);
            out.push_str(s);
        }
        out
    }

    fn reset(mut ref self, start: own Vec[(String, String)]) {
        self.parts = start;
        self.initial_size = 0;
    }

    fn is_onlyws(ref self) -> bool {
        self.initial_size == 0 and (self.parts.is_empty() or py_isspace(self.text()))
    }
}

struct ValueFormatter {
    maxlen: i64,
    continuation_ws: String,
    splitchars: String,
    lines: Vec[String],
    current: Accumulator,
}

impl ValueFormatter {
    fn finish(mut ref self, linesep: ref String) -> String {
        self.newline();
        // Workaround (B-2026-10-19-5): join refuses a Str separator.
        self.lines.join(linesep.clone())
    }

    fn newline(mut ref self) {
        let end = self.current.pop();
        if not (end.0 == " " and end.1.is_empty()) {
            self.current.push(end.0, end.1);
        }
        if self.current.len() > 0 {
            if self.current.is_onlyws() and not self.lines.is_empty() {
                let k = self.lines.len() - 1;
                self.lines[k] = f"{self.lines[k]}{self.current.text()}";
            } else {
                self.lines.push(self.current.text());
            }
        }
        self.current.reset(Vec.new());
    }

    fn add_transition(mut ref self) {
        self.current.push(" ".to_string(), String.new());
    }

    fn feed(mut ref self, fws: ref String, s: ref String, charset: ref Charset) -> Result[(), String] {
        if charset.header_encoding == 0 {
            self.ascii_split(fws, s);
            return Ok(());
        }
        let first = self.maxlen - self.current.len();
        let rest = self.maxlen - width(self.continuation_ws);
        let mut lines = header_encode_lines(charset, s, first, rest)?;
        if lines.is_empty() {
            return Ok(());
        }
        let first_line = lines.remove(0);
        if let Some(l) = first_line {
            self.append_chunk(fws, l);
        }
        if lines.is_empty() {
            return Ok(());
        }
        let last = lines.pop().unwrap_or(None).unwrap_or(String.new());
        self.newline();
        self.current.push(self.continuation_ws.clone(), last);
        for l in lines.iter() {
            self.lines.push(f"{self.continuation_ws}{l.clone().unwrap_or(String.new())}");
        }
        Ok(())
    }

    // re.split("([ \t]+)", fws + string), paired up as (fws, part).
    fn ascii_split(mut ref self, fws: ref String, s: ref String) {
        let all = chars(f"{fws}{s}");
        let mut parts: Vec[String] = Vec.new();
        let mut cur = String.new();
        let mut i = 0;
        while i < all.len() {
            if all[i] == ' ' or all[i] == '\t' {
                parts.push(cur);
                cur = String.new();
                let mut sep = String.new();
                while i < all.len() and (all[i] == ' ' or all[i] == '\t') {
                    sep.push(all[i]);
                    i += 1;
                }
                parts.push(sep);
            } else {
                cur.push(all[i]);
                i += 1;
            }
        }
        parts.push(cur);
        if not parts[0].is_empty() {
            parts.insert(0, String.new());
        } else {
            parts.remove(0);
        }
        let mut k = 0;
        while k + 1 < parts.len() {
            self.append_chunk(parts[k], parts[k + 1]);
            k += 2;
        }
    }

    fn append_chunk(mut ref self, fws: ref String, s: ref String) {
        self.current.push(fws, s);
        if self.current.len() <= self.maxlen {
            return;
        }
        let mut split_at = -1;
        for ch in self.splitchars.chars() {
            let mut i = self.current.parts.len() - 1;
            while i > 0 {
                if py_space(ch) {
                    let f = self.current.parts[i].0.clone();
                    if not f.is_empty() and first_char(f) == ch {
                        break;
                    }
                }
                let prev = self.current.parts[i - 1].1.clone();
                if not prev.is_empty() and last_char(prev) == ch {
                    break;
                }
                i -= 1;
            }
            if i > 0 {
                split_at = i;
                break;
            }
        }
        if split_at < 0 {
            let (f, part) = self.current.pop();
            let mut f = f;
            if self.current.initial_size > 0 {
                self.newline();
                if f.is_empty() {
                    f = " ".to_string();
                }
            }
            self.current.push(f, part);
            return;
        }
        let remainder = self.current.pop_from(split_at);
        self.lines.push(self.current.text());
        self.current.reset(remainder);
    }
}

// make_header(decode_header(s))
fn make_header(seq: ref Vec[(Word, Option[String])]) -> Result[Header, String] {
    let mut h = new_header(None, 78, None, " ".to_string());
    for (w, cs) in seq.iter() {
        let charset = match cs {
            Some(n) => Some(new_charset(n)),
            None => None,
        };
        h.append(w, charset)?;
    }
    Ok(h)
}

fn header_str(s: ref String) -> Result[String, String] {
    let mut h = make_header(decode_header(s)?)?;
    Ok(h.text())
}

// ------------------------------------------------------------ email._parseaddr

// _parseaddr.quote: backslashes and double quotes become quoted pairs.
fn quote(s: ref String) -> String {
    s.replace("\\", "\\\\").replace("\"", "\\\"")
}

fn specials() -> Str {
    "()<>@,:;.\"[]"
}

fn is_atomend(c: char) -> bool {
    has_char(specials(), c) or c == ' ' or c == '\t' or c == '\r' or c == '\n'
}

fn is_phraseend(c: char) -> bool {
    c != '.' and is_atomend(c)
}

// AddrlistClass, the address-list parser email.utils still runs.
struct AddrParser {
    field: Vec[char],
    pos: i64,
    commentlist: Vec[String],
}

fn new_addr_parser(field: ref String) -> AddrParser {
    AddrParser { field: chars(field), pos: 0, commentlist: Vec.new() }
}

impl AddrParser {
    fn at(ref self) -> char {
        self.field[self.pos]
    }

    fn more(ref self) -> bool {
        self.pos < self.field.len()
    }

    // Skips white space and collects comments; returns the spaces and tabs.
    fn gotonext(mut ref self) -> String {
        let mut ws = String.new();
        while self.more() {
            let c = self.at();
            if c == ' ' or c == '\t' or c == '\n' or c == '\r' {
                if c != '\n' and c != '\r' {
                    ws.push(c);
                }
                self.pos += 1;
            } else if c == '(' {
                let comment = self.getcomment();
                self.commentlist.push(comment);
            } else {
                break;
            }
        }
        ws
    }

    fn getaddrlist(mut ref self) -> Vec[(String, String)] {
        let mut result: Vec[(String, String)] = Vec.new();
        while self.more() {
            let ad = self.getaddress();
            if ad.is_empty() {
                result.push((String.new(), String.new()));
            } else {
                for a in ad.into_iter() {
                    result.push(a);
                }
            }
        }
        result
    }

    fn getaddress(mut ref self) -> Vec[(String, String)] {
        self.commentlist = Vec.new();
        self.gotonext();
        let oldpos = self.pos;
        let oldcl = self.commentlist.clone();
        let plist = self.getphraselist();
        self.gotonext();
        let mut returnlist: Vec[(String, String)] = Vec.new();
        if not self.more() {
            if not plist.is_empty() {
                returnlist = vec![(self.commentlist.join(" "), plist[0].clone())];
            }
        } else if self.at() == '.' or self.at() == '@' {
            self.pos = oldpos;
            self.commentlist = oldcl;
            let addrspec = self.getaddrspec();
            returnlist = vec![(self.commentlist.join(" "), addrspec)];
        } else if self.at() == ':' {
            let fieldlen = self.field.len();
            self.pos += 1;
            while self.more() {
                self.gotonext();
                if self.pos < fieldlen and self.at() == ';' {
                    self.pos += 1;
                    break;
                }
                for a in self.getaddress().into_iter() {
                    returnlist.push(a);
                }
            }
        } else if self.at() == '<' {
            let routeaddr = self.getrouteaddr();
            if not self.commentlist.is_empty() {
                returnlist = vec![(f"{plist.join(" ")} ({self.commentlist.join(" ")})", routeaddr)];
            } else {
                returnlist = vec![(plist.join(" "), routeaddr)];
            }
        } else if not plist.is_empty() {
            returnlist = vec![(self.commentlist.join(" "), plist[0].clone())];
        } else if has_char(specials(), self.at()) {
            self.pos += 1;
        }
        self.gotonext();
        if self.more() and self.at() == ',' {
            self.pos += 1;
        }
        returnlist
    }

    fn getrouteaddr(mut ref self) -> String {
        let mut expectroute = false;
        self.pos += 1;
        self.gotonext();
        let mut adlist = String.new();
        while self.more() {
            if expectroute {
                self.getdomain();
                expectroute = false;
            } else if self.at() == '>' {
                self.pos += 1;
                break;
            } else if self.at() == '@' {
                self.pos += 1;
                expectroute = true;
            } else if self.at() == ':' {
                self.pos += 1;
            } else {
                adlist = self.getaddrspec();
                self.pos += 1;
                break;
            }
            self.gotonext();
        }
        adlist
    }

    fn getaddrspec(mut ref self) -> String {
        let mut aslist: Vec[String] = Vec.new();
        self.gotonext();
        while self.more() {
            let mut preserve_ws = true;
            let c = self.at();
            if c == '.' {
                if not aslist.is_empty() and py_strip(aslist[aslist.len() - 1]).is_empty() {
                    aslist.pop();
                }
                aslist.push(".".to_string());
                self.pos += 1;
                preserve_ws = false;
            } else if c == '"' {
                let q = self.getquote();
                aslist.push(f"\"{quote(q)}\"");
            } else if is_atomend(c) {
                if not aslist.is_empty() and py_strip(aslist[aslist.len() - 1]).is_empty() {
                    aslist.pop();
                }
                break;
            } else {
                let a = self.getatom(false);
                aslist.push(a);
            }
            let ws = self.gotonext();
            if preserve_ws and not ws.is_empty() {
                aslist.push(ws);
            }
        }
        if not self.more() or self.at() != '@' {
            return aslist.join("");
        }
        aslist.push("@".to_string());
        self.pos += 1;
        self.gotonext();
        let domain = self.getdomain();
        if domain.is_empty() {
            return String.new();
        }
        f"{aslist.join("")}{domain}"
    }

    fn getdomain(mut ref self) -> String {
        let mut sdlist: Vec[String] = Vec.new();
        while self.more() {
            let c = self.at();
            if c == ' ' or c == '\t' {
                self.pos += 1;
            } else if c == '(' {
                let comment = self.getcomment();
                self.commentlist.push(comment);
            } else if c == '[' {
                let lit = self.getdelimited('[', "]\r", false);
                sdlist.push(f"[{lit}]");
            } else if c == '.' {
                self.pos += 1;
                sdlist.push(".".to_string());
            } else if c == '@' {
                return String.new();
            } else if is_atomend(c) {
                break;
            } else {
                let a = self.getatom(false);
                sdlist.push(a);
            }
        }
        sdlist.join("")
    }

    fn getdelimited(mut ref self, begin: char, endchars: Str, allowcomments: bool) -> String {
        if self.at() != begin {
            return String.new();
        }
        let mut out = String.new();
        let mut quoted = false;
        self.pos += 1;
        while self.more() {
            let c = self.at();
            if quoted {
                out.push(c);
                quoted = false;
            } else if has_char(endchars, c) {
                self.pos += 1;
                break;
            } else if allowcomments and c == '(' {
                let comment = self.getcomment();
                out.push_str(comment);
                continue;
            } else if c == '\\' {
                quoted = true;
            } else {
                out.push(c);
            }
            self.pos += 1;
        }
        out
    }

    fn getquote(mut ref self) -> String {
        self.getdelimited('"', "\"\r", false)
    }

    fn getcomment(mut ref self) -> String {
        self.getdelimited('(', ")\r", true)
    }

    fn getatom(mut ref self, phrase: bool) -> String {
        let mut out = String.new();
        while self.more() {
            let c = self.at();
            if (phrase and is_phraseend(c)) or (not phrase and is_atomend(c)) {
                break;
            }
            out.push(c);
            self.pos += 1;
        }
        out
    }

    fn getphraselist(mut ref self) -> Vec[String] {
        let mut plist: Vec[String] = Vec.new();
        while self.more() {
            let c = self.at();
            if c == ' ' or c == '\t' or c == '\r' or c == '\n' {
                self.pos += 1;
            } else if c == '"' {
                let q = self.getquote();
                plist.push(q);
            } else if c == '(' {
                let comment = self.getcomment();
                self.commentlist.push(comment);
            } else if is_phraseend(c) {
                break;
            } else {
                let a = self.getatom(true);
                plist.push(a);
            }
        }
        plist
    }
}

// AddressList(field).addresslist
fn address_list(field: ref String) -> Vec[(String, String)] {
    if field.is_empty() {
        return Vec.new();
    }
    let mut p = new_addr_parser(field);
    p.getaddrlist()
}

// ------------------------------------------------------------ email.utils: addresses

// _iter_escaped_chars: (position, character) with a backslash kept on the
// character it escapes.
fn iter_escaped_chars(addr: ref String) -> Vec[(i64, String)] {
    let v = chars(addr);
    let mut out: Vec[(i64, String)] = Vec.new();
    let mut escape = false;
    let mut pos = 0;
    for k in 0..v.len() {
        pos = k;
        if escape {
            out.push((k, f"\\{v[k]}"));
            escape = false;
        } else if v[k] == '\\' {
            escape = true;
        } else {
            out.push((k, v[k].to_string()));
        }
    }
    if escape {
        out.push((pos, "\\".to_string()));
    }
    out
}

fn strip_quoted_realnames(addr: ref String) -> String {
    if not addr.contains("\"") {
        return addr.clone();
    }
    let v = chars(addr);
    let mut start = 0;
    let mut open = -1;
    let mut result = String.new();
    for (pos, ch) in iter_escaped_chars(addr) {
        if ch == "\"" {
            if open < 0 {
                open = pos;
            } else {
                if start != open {
                    result.push_str(text(slice(v, start, open)));
                }
                start = pos + 1;
                open = -1;
            }
        }
    }
    if start < v.len() {
        result.push_str(text(slice(v, start, v.len())));
    }
    result
}

fn check_parenthesis(addr: ref String) -> bool {
    let a = strip_quoted_realnames(addr);
    let mut opens = 0;
    for (_, ch) in iter_escaped_chars(a) {
        if ch == "(" {
            opens += 1;
        } else if ch == ")" {
            opens -= 1;
            if opens < 0 {
                return false;
            }
        }
    }
    opens == 0
}

fn pre_parse_validation(values: ref Vec[String]) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for v in values.iter() {
        if check_parenthesis(v) {
            out.push(v.clone());
        } else {
            out.push("('', '')".to_string());
        }
    }
    out
}

fn post_parse_validation(pairs: own Vec[(String, String)]) -> Vec[(String, String)] {
    let mut out: Vec[(String, String)] = Vec.new();
    for (n, a) in pairs.into_iter() {
        if a.contains("[") {
            out.push((String.new(), String.new()));
        } else {
            out.push((n, a));
        }
    }
    out
}

fn empty_pair() -> (String, String) {
    (String.new(), String.new())
}

fn parseaddr(addr: ref String, strict: bool) -> (String, String) {
    if not strict {
        let addrs = address_list(addr);
        if addrs.is_empty() {
            return empty_pair();
        }
        return addrs[0].clone();
    }
    let checked = pre_parse_validation(vec![addr.clone()]);
    let addrs = post_parse_validation(address_list(checked[0]));
    if addrs.len() != 1 {
        return empty_pair();
    }
    addrs[0].clone()
}

fn getaddresses(values: ref Vec[String], strict: bool) -> Vec[(String, String)] {
    if not strict {
        return address_list(values.join(", "));
    }
    let checked = pre_parse_validation(values);
    let result = post_parse_validation(address_list(checked.join(", ")));
    let mut n = 0;
    for v in checked.iter() {
        n += 1 + count_of(strip_quoted_realnames(v), ',');
    }
    if result.len() != n {
        return vec![empty_pair()];
    }
    result
}

fn pair_repr(p: ref (String, String)) -> String {
    f"({repr_str(p.0)}, {repr_str(p.1)})"
}

fn pairs_repr(v: ref Vec[(String, String)]) -> String {
    let items: Vec[String] = v.iter().map(|p| pair_repr(p)).collect();
    f"[{items.join(", ")}]"
}

fn formataddr(name: ref String, address: ref String, charset: ref String) -> Result[String, String] {
    encode_str(address, Codec.Ascii)?;
    if name.is_empty() {
        return Ok(address.clone());
    }
    if encode_str(name, Codec.Ascii).is_err() {
        let encoded = header_encode(new_charset(charset), name)?;
        return Ok(f"{encoded} <{address}>");
    }
    let mut quotes = "";
    for c in name.chars() {
        if has_char("[]\\()<>@,:;\".", c) {
            quotes = "\"";
        }
    }
    let mut escaped = String.new();
    for c in name.chars() {
        if c == '\\' or c == '"' {
            escaped.push('\\');
        }
        escaped.push(c);
    }
    Ok(f"{quotes}{escaped}{quotes} <{address}>")
}

fn unquote(s: ref String) -> String {
    let v = chars(s);
    if v.len() > 1 {
        if s.starts_with("\"") and s.ends_with("\"") {
            return text(slice(v, 1, v.len() - 1)).replace("\\\\", "\\").replace("\\\"", "\"");
        }
        if s.starts_with("<") and s.ends_with(">") {
            return text(slice(v, 1, v.len() - 1));
        }
    }
    s.clone()
}

// ------------------------------------------------------------ email.utils: RFC 2231

// decode_rfc2231: three parts, or None for the first two.
fn decode_rfc2231(s: ref String) -> String {
    let parts: Vec[Str] = s.splitn(3, "'").collect();
    if parts.len() <= 2 {
        return f"(None, None, {repr_str(s)})";
    }
    let items: Vec[String] = parts.iter().map(|p| repr_str(p.to_string())).collect();
    f"[{items.join(", ")}]"
}

// urllib.parse.quote(s, safe="", encoding=charset or "ascii")
fn quote_all(s: ref String, codec: ref Codec) -> Result[String, String] {
    let b = encode_str(s, codec)?;
    let mut out = String.new();
    for x in b.iter() {
        let c = *x;
        if (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z') or (c >= b'0' and c <= b'9') or c == b'_'
            or c == b'.' or c == b'-' or c == b'~' {
            out.push(char.try_from(c as i64).unwrap_or('?'));
        } else {
            out.push_str(f"%{hex_digits(c as i64, 2).to_uppercase()}");
        }
    }
    Ok(out)
}

fn encode_rfc2231(s: ref String, charset: ref Option[String], language: ref Option[String]) -> Result[String, String] {
    let codec = match charset {
        Some(c) => lookup_codec(c)?,
        None => Codec.Ascii,
    };
    let q = quote_all(s, codec)?;
    if charset.is_none() and language.is_none() {
        return Ok(q);
    }
    let cs = match charset {
        Some(c) => c.clone(),
        None => "None".to_string(),
    };
    let lang = match language {
        Some(l) => l.clone(),
        None => String.new(),
    };
    Ok(f"{cs}'{lang}'{q}")
}

// collapse_rfc2231_value for a plain value, and for a (charset, language,
// text) triple, decoded with errors="replace".
fn collapse_rfc2231_value(triple: ref Option[(String, String, String)], plain: ref String) -> String {
    match triple {
        None => unquote(plain),
        Some((cs, _, t)) => {
            let raw = raw_unicode_escape(t);
            match lookup_codec(cs) {
                Ok(c) => decode_bytes(raw, c, true).unwrap_or(String.new()),
                Err(_) => unquote(t),
            }
        }
    }
}


// ------------------------------------------------------------ bytes in strings

// A payload is a str. Bytes go into one as "ascii" with surrogateescape:
// ASCII stays, and each byte 0x80..0xFF becomes the lone surrogate
// U+DC80..U+DCFF. A Kāra String cannot hold a lone surrogate, so the port
// keeps it as the private-use code point U+10FF00 + byte instead.
fn escape_bytes(b: ref Vec[u8]) -> String {
    let mut out = String.new();
    for x in b.iter() {
        let c = *x as i64;
        let cp = if c < 128 { c } else { 0x10FF00 + c };
        out.push(char.try_from(cp).unwrap_or('?'));
    }
    out
}

// email.utils._has_surrogates
fn has_surrogates(s: ref String) -> bool {
    for c in s.chars() {
        if c as i64 >= 0x10FF80 {
            return true;
        }
    }
    false
}

// s.encode("ascii", "surrogateescape"), or None where it raises.
fn unescape_bytes(s: ref String) -> Option[Vec[u8]] {
    let mut out: Vec[u8] = Vec.new();
    for c in s.chars() {
        let o = c as i64;
        if o < 128 {
            out.push(o as u8);
        } else if o >= 0x10FF80 and o <= 0x10FFFF {
            out.push((o - 0x10FF00) as u8);
        } else {
            return None;
        }
    }
    Some(out)
}

fn bytes_text(b: ref Vec[u8]) -> String {
    let mut out = String.new();
    for x in b.iter() {
        out.push(char.try_from(*x as i64).unwrap_or('?'));
    }
    out
}

fn str_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

// bytes.splitlines(): only \n, \r and \r\n end a line.
fn split_byte_lines(b: ref Vec[u8]) -> Vec[Vec[u8]] {
    let mut out: Vec[Vec[u8]] = Vec.new();
    let mut cur: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i];
        if c == b'\n' or c == b'\r' {
            out.push(cur);
            cur = Vec.new();
            if c == b'\r' and i + 1 < b.len() and b[i + 1] == b'\n' {
                i += 1;
            }
        } else {
            cur.push(c);
        }
        i += 1;
    }
    if not cur.is_empty() {
        out.push(cur);
    }
    out
}

fn concat(parts: ref Vec[Vec[u8]]) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for p in parts.iter() {
        for x in p.iter() {
            out.push(*x);
        }
    }
    out
}

// ------------------------------------------------------------ binascii

// binascii.a2b_base64(s, strict_mode=True): None where it raises.
fn a2b_base64_strict(v: ref Vec[u8]) -> Option[Vec[u8]] {
    if not v.is_empty() and v[0] == b'=' {
        return None;
    }
    let mut out: Vec[u8] = Vec.new();
    let mut quad_pos = 0;
    let mut left: i64 = 0;
    let mut pads = 0;
    let mut padding_started = false;
    let mut i = 0;
    while i < v.len() {
        let ch = v[i];
        if ch == b'=' {
            padding_started = true;
            if quad_pos == 0 {
                return None;
            }
            if quad_pos >= 2 {
                pads += 1;
                if quad_pos + pads >= 4 {
                    if i + 1 < v.len() {
                        return None;
                    }
                    return Some(out);
                }
            }
            i += 1;
            continue;
        }
        let d = b64_value(ch);
        if d < 0 or padding_started {
            return None;
        }
        pads = 0;
        if quad_pos == 0 {
            quad_pos = 1;
            left = d;
        } else if quad_pos == 1 {
            quad_pos = 2;
            out.push(((left << 2) | (d >> 4)) as u8);
            left = d & 15;
        } else if quad_pos == 2 {
            quad_pos = 3;
            out.push(((left << 4) | (d >> 2)) as u8);
            left = d & 3;
        } else {
            quad_pos = 0;
            out.push(((left << 6) | d) as u8);
            left = 0;
        }
        i += 1;
    }
    if quad_pos != 0 {
        return None;
    }
    Some(out)
}

// email._encoded_words.decode_b: the bytes and the defects it notes.
fn decode_b(encoded: ref Vec[u8]) -> (Vec[u8], Vec[String]) {
    let pad_err = encoded.len() % 4;
    let mut padded = encoded.clone();
    if pad_err > 0 {
        for _ in 0..(4 - pad_err) {
            padded.push(b'=');
        }
    }
    if let Some(b) = a2b_base64_strict(padded) {
        let defects = if pad_err > 0 { vec!["InvalidBase64PaddingDefect".to_string()] } else { Vec.new() };
        return (b, defects);
    }
    if let Some(b) = a2b_base64(encoded) {
        return (b, vec!["InvalidBase64CharactersDefect".to_string()]);
    }
    let mut more = encoded.clone();
    more.push(b'=');
    more.push(b'=');
    if let Some(b) = a2b_base64(more) {
        return (b, vec!["InvalidBase64CharactersDefect".to_string(), "InvalidBase64PaddingDefect".to_string()]);
    }
    (encoded.clone(), vec!["InvalidBase64LengthDefect".to_string()])
}

// base64.encodebytes: lines of 76 characters, each ending in "\n".
fn encodebytes(b: ref Vec[u8]) -> String {
    let mut out = String.new();
    let mut i = 0;
    while i < b.len() {
        let end = if i + 57 < b.len() { i + 57 } else { b.len() };
        out.push_str(b64encode(b[i..end].to_vec()));
        out.push('\n');
        i = end;
    }
    out
}

fn hex_digit(c: u8) -> i64 {
    if c >= b'0' and c <= b'9' {
        c as i64 - 48
    } else if c >= b'a' and c <= b'f' {
        c as i64 - 87
    } else if c >= b'A' and c <= b'F' {
        c as i64 - 55
    } else {
        -1
    }
}

// binascii.a2b_qp(data, header=False), the C decoder quopri.decodestring
// uses.
fn a2b_qp(data: ref Vec[u8]) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let n = data.len();
    let mut i = 0;
    while i < n {
        if data[i] == b'=' {
            i += 1;
            if i >= n {
                break;
            }
            if data[i] == b'\n' or data[i] == b'\r' {
                if data[i] != b'\n' {
                    while i < n and data[i] != b'\n' {
                        i += 1;
                    }
                }
                if i < n {
                    i += 1;
                }
            } else if data[i] == b'=' {
                out.push(b'=');
                i += 1;
            } else if i + 1 < n and hex_digit(data[i]) >= 0 and hex_digit(data[i + 1]) >= 0 {
                out.push((hex_digit(data[i]) * 16 + hex_digit(data[i + 1])) as u8);
                i += 2;
            } else {
                out.push(b'=');
            }
        } else {
            out.push(data[i]);
            i += 1;
        }
    }
    out
}

// binascii.a2b_uu for one line: None where it raises binascii.Error.
fn a2b_uu(line: ref Vec[u8]) -> Option[Vec[u8]] {
    if line.is_empty() {
        return None;
    }
    let mut bin_len = (line[0] as i64 - 32) & 63;
    let mut out: Vec[u8] = Vec.new();
    let mut left: i64 = 0;
    let mut bits = 0;
    let mut i = 1;
    while bin_len > 0 {
        let mut ch: i64 = 0;
        if i < line.len() and line[i] != b'\n' and line[i] != b'\r' {
            let c = line[i] as i64;
            if c < 32 or c > 96 {
                return None;
            }
            ch = (c - 32) & 63;
        }
        left = (left << 6) | ch;
        bits += 6;
        if bits >= 8 {
            bits -= 8;
            out.push(((left >> bits) & 255) as u8);
            left = left & ((1 << bits) - 1);
            bin_len -= 1;
        }
        i += 1;
    }
    while i < line.len() {
        let c = line[i];
        if c != b' ' and c != b'`' and c != b'\n' and c != b'\r' {
            return None;
        }
        i += 1;
    }
    Some(out)
}

fn strip_ws_bytes(b: ref Vec[u8]) -> Vec[u8] {
    let ws = |c: u8| c == b' ' or c == b'\t' or c == b'\r' or c == b'\n' or c == 12;
    let mut lo = 0;
    let mut hi = b.len();
    while lo < hi and ws(b[lo]) {
        lo += 1;
    }
    while hi > lo and ws(b[hi - 1]) {
        hi -= 1;
    }
    b[lo..hi].to_vec()
}

fn starts_with_bytes(b: ref Vec[u8], p: Str) -> bool {
    let pb = p.bytes();
    if b.len() < pb.len() {
        return false;
    }
    for k in 0..pb.len() {
        if b[k] != pb[k] {
            return false;
        }
    }
    true
}

fn is_octal(b: ref Vec[u8]) -> bool {
    // int(mode, base=8): optional sign, then octal digits with single
    // underscores between them, with whitespace around.
    let t = strip_ws_bytes(b);
    let mut i = 0;
    if i < t.len() and (t[i] == b'+' or t[i] == b'-') {
        i += 1;
    }
    if i < t.len() and t[i] == b'0' and i + 1 < t.len() and (t[i + 1] == b'o' or t[i + 1] == b'O') {
        i += 2;
        if i < t.len() and t[i] == b'_' {
            i += 1;
        }
    }
    if i >= t.len() {
        return false;
    }
    let mut prev_digit = false;
    while i < t.len() {
        let c = t[i];
        if c >= b'0' and c <= b'7' {
            prev_digit = true;
        } else if c == b'_' and prev_digit and i + 1 < t.len() {
            prev_digit = false;
        } else {
            return false;
        }
        i += 1;
    }
    prev_digit
}

// email.message._decode_uu: None where it raises ValueError.
fn decode_uu(encoded: ref Vec[u8]) -> Option[Vec[u8]] {
    let lines = split_byte_lines(encoded);
    let mut k = 0;
    let mut found = false;
    while k < lines.len() {
        let line = lines[k].clone();
        k += 1;
        if starts_with_bytes(line, "begin ") {
            let rest = line[6..].to_vec();
            let mut mode: Vec[u8] = Vec.new();
            for x in rest.iter() {
                if *x == b' ' {
                    break;
                }
                mode.push(*x);
            }
            if is_octal(mode) {
                found = true;
                break;
            }
        }
    }
    if not found {
        return None;
    }
    let mut out: Vec[u8] = Vec.new();
    while k < lines.len() {
        let line = lines[k].clone();
        k += 1;
        if line.is_empty() {
            return None;
        }
        if strip_ws_bytes(line) == str_bytes("end") {
            break;
        }
        let part = match a2b_uu(line) {
            Some(p) => p,
            None => {
                let nbytes = (((line[0] as i64 - 32) & 63) * 4 + 5) / 3;
                let cut = if nbytes < line.len() { nbytes } else { line.len() };
                a2b_uu(line[0..cut].to_vec())?
            }
        };
        for x in part.iter() {
            out.push(*x);
        }
    }
    Some(out)
}

// binascii.crc32
fn crc32(b: ref Vec[u8]) -> i64 {
    let mut crc: i64 = 0xFFFFFFFF;
    for x in b.iter() {
        crc = crc ^ (*x as i64);
        for _ in 0..8 {
            if crc & 1 == 1 {
                crc = (crc >> 1) ^ 0xEDB88320;
            } else {
                crc = crc >> 1;
            }
        }
    }
    crc ^ 0xFFFFFFFF
}

// ------------------------------------------------------------ quoprimime

fn qp_body_safe(c: i64) -> bool {
    (c >= 32 and c <= 126 and c != 61) or c == 9 or c == 10 or c == 13
}

// quoprimime.body_encode(body) with maxlinelen 76 and eol "\n", for a
// body of code points below 256.
fn qp_body_encode(body: ref String) -> String {
    if body.is_empty() {
        return String.new();
    }
    let mut t = String.new();
    for c in body.chars() {
        let o = c as i64;
        if qp_body_safe(o) {
            t.push(c);
        } else {
            t.push_str(f"={hex_digits(o, 2).to_uppercase()}");
        }
    }
    let maxlinelen = 76;
    let maxlinelen1 = maxlinelen - 1;
    let mut encoded: Vec[String] = Vec.new();
    for l in splitlines(t).iter() {
        let line = chars(l);
        let mut start = 0;
        let laststart = line.len() - 1 - maxlinelen;
        while start <= laststart {
            let stop = start + maxlinelen1;
            if line[stop - 2] == '=' {
                encoded.push(text(slice(line, start, stop - 1)));
                start = stop - 2;
            } else if line[stop - 1] == '=' {
                encoded.push(text(slice(line, start, stop)));
                start = stop - 1;
            } else {
                encoded.push(f"{text(slice(line, start, stop))}=");
                start = stop;
            }
        }
        if not line.is_empty() and (line[line.len() - 1] == ' ' or line[line.len() - 1] == '\t') {
            let room = start - laststart;
            let last = line[line.len() - 1];
            let q = if room >= 3 {
                f"={hex_digits(last as i64, 2).to_uppercase()}"
            } else if room == 2 {
                f"{last}=\n"
            } else {
                f"=\n={hex_digits(last as i64, 2).to_uppercase()}"
            };
            encoded.push(f"{text(slice(line, start, line.len() - 1))}{q}");
        } else {
            encoded.push(text(slice(line, start, line.len())));
        }
    }
    let lastc = last_char(t);
    if lastc == '\r' or lastc == '\n' {
        encoded.push(String.new());
    }
    encoded.join("\n".to_string())
}

// ------------------------------------------------------------ string helpers

fn py_rstrip(s: ref String) -> String {
    let v = chars(s);
    let mut hi = v.len();
    while hi > 0 and py_space(v[hi - 1]) {
        hi -= 1;
    }
    text(slice(v, 0, hi))
}

// s.lstrip(set) and s.rstrip(set) for a set of characters.
fn lstrip_set(s: ref String, set: Str) -> String {
    let v = chars(s);
    let mut lo = 0;
    while lo < v.len() and has_char(set, v[lo]) {
        lo += 1;
    }
    text(slice(v, lo, v.len()))
}

fn rstrip_set(s: ref String, set: Str) -> String {
    let v = chars(s);
    let mut hi = v.len();
    while hi > 0 and has_char(set, v[hi - 1]) {
        hi -= 1;
    }
    text(slice(v, 0, hi))
}

// Python's index rules for s.find(sub, start, end) and s.count(...):
// negative positions count from the end, then everything is clamped.
fn py_index(i: i64, n: i64) -> i64 {
    let mut k = i;
    if k < 0 {
        k += n;
        if k < 0 {
            k = 0;
        }
    }
    if k > n {
        k = n;
    }
    k
}

fn find_in(v: ref Vec[char], sub: Str, start: i64, end: i64) -> i64 {
    let s: Vec[char] = sub.chars().collect();
    let lo = py_index(start, v.len());
    let hi = py_index(end, v.len());
    let mut i = lo;
    while i + s.len() <= hi {
        let mut ok = true;
        for k in 0..s.len() {
            if v[i + k] != s[k] {
                ok = false;
                break;
            }
        }
        if ok {
            return i;
        }
        i += 1;
    }
    -1
}

fn count_in(v: ref Vec[char], sub: Str, start: i64, end: i64) -> i64 {
    let s: Vec[char] = sub.chars().collect();
    let lo = py_index(start, v.len());
    let hi = py_index(end, v.len());
    let mut n = 0;
    let mut i = lo;
    while i + s.len() <= hi {
        let mut ok = true;
        for k in 0..s.len() {
            if v[i + k] != s[k] {
                ok = false;
                break;
            }
        }
        if ok {
            n += 1;
            i += s.len();
        } else {
            i += 1;
        }
    }
    n
}

fn is_ascii(s: ref String) -> bool {
    for c in s.chars() {
        if c as i64 >= 128 {
            return false;
        }
    }
    true
}

// ------------------------------------------------------------ parameters

// A parameter value: a str, or the (charset, language, value) triple an
// RFC 2231 value decodes to.
#[derive(Clone)]
enum PValue {
    Plain(String),
    Triple(Option[String], Option[String], String),
}

fn pvalue_repr(v: ref PValue) -> String {
    match v {
        PValue.Plain(s) => repr_str(s),
        PValue.Triple(cs, lang, s) => f"({opt_repr(cs)}, {opt_repr(lang)}, {repr_str(s)})",
    }
}

fn params_repr(ps: ref Option[Vec[(String, PValue)]]) -> String {
    match ps {
        None => "None".to_string(),
        Some(v) => {
            let items: Vec[String] = v.iter().map(|p| f"({repr_str(p.0)}, {pvalue_repr(p.1)})").collect();
            f"[{items.join(", ".to_string())}]"
        }
    }
}

fn opt_pvalue_repr(v: ref Option[PValue]) -> String {
    match v {
        Some(p) => pvalue_repr(p),
        None => "None".to_string(),
    }
}

// message._splitparam
fn splitparam(param: ref String) -> (String, Option[String]) {
    match param.find(";") {
        Some(k) => {
            let k = k as i64;
            (py_strip(param[..k].to_string()), Some(py_strip(param[k + 1..].to_string())))
        }
        None => (py_strip(param), None),
    }
}

fn tspecial(c: char) -> bool {
    has_char(" ()<>@,;:\\\"/[]?=", c)
}

// message._formatparam
fn formatparam(param: ref String, value: ref Option[PValue], quote_it: bool) -> Result[String, String] {
    let v = match value {
        None => return Ok(param.clone()),
        Some(PValue.Plain(s)) => {
            if s.is_empty() {
                return Ok(param.clone());
            }
            if not is_ascii(s) {
                let enc = encode_rfc2231(s, Some("utf-8".to_string()), Some(String.new()))?;
                return Ok(f"{param}*={enc}");
            }
            s.clone()
        }
        Some(PValue.Triple(cs, lang, s)) => {
            let enc = encode_rfc2231(s, cs, lang)?;
            return Ok(f"{param}*={enc}");
        }
    };
    let mut special = false;
    for c in v.chars() {
        if tspecial(c) {
            special = true;
        }
    }
    if quote_it or special {
        Ok(f"{param}=\"{quote(v)}\"")
    } else {
        Ok(f"{param}={v}")
    }
}

// message._parseparam
fn parseparam(value: ref String) -> Vec[String] {
    let s = chars(f";{value}");
    let n = s.len();
    let mut plist: Vec[String] = Vec.new();
    let mut start = 0;
    while find_in(s, ";", start, n) == start {
        start += 1;
        let mut end = find_in(s, ";", start, n);
        let mut ind = start;
        let mut diff = 0;
        while end > 0 {
            diff += count_in(s, "\"", ind, end) - count_in(s, "\\\"", ind, end);
            if ((diff % 2) + 2) % 2 == 0 {
                break;
            }
            let next = find_in(s, ";", end + 1, n);
            end = ind;
            ind = next;
        }
        if end < 0 {
            end = n;
        }
        let i = find_in(s, "=", start, end);
        let f = if i == -1 {
            text(slice(s, start, end))
        } else {
            let name = py_rstrip(text(slice(s, start, i))).to_lowercase();
            let val = py_lstrip(text(slice(s, i + 1, end)));
            f"{name}={val}"
        };
        plist.push(py_strip(f));
        start = end;
    }
    plist
}

fn unquotevalue(v: ref PValue) -> PValue {
    match v {
        PValue.Plain(s) => PValue.Plain(unquote(s)),
        PValue.Triple(cs, lang, s) => PValue.Triple(cs.clone(), lang.clone(), unquote(s)),
    }
}

// rfc2231_continuation.match(name): the name and the number, if any.
fn rfc2231_name(name: ref String) -> Option[(String, Option[i64])] {
    let v = chars(name);
    let mut k = 0;
    while k < v.len() and (v[k].is_ascii_alphanumeric() or v[k] == '_') {
        k += 1;
    }
    if k == 0 or k >= v.len() or v[k] != '*' {
        return None;
    }
    let base = text(slice(v, 0, k));
    let mut j = k + 1;
    if j == v.len() {
        return Some((base, None));
    }
    let mut num: i64 = 0;
    let d0 = j;
    while j < v.len() and is_digit(v[j]) {
        num = num * 10 + (v[j] as i64 - 48);
        j += 1;
    }
    if j == d0 {
        return None;
    }
    if j < v.len() and v[j] == '*' {
        j += 1;
    }
    if j != v.len() {
        return None;
    }
    Some((base, Some(num)))
}

// urllib.parse.unquote(s, encoding="latin-1")
fn unquote_latin1(s: ref String) -> String {
    let v = chars(s);
    let mut out = String.new();
    let mut i = 0;
    while i < v.len() {
        if v[i] == '%' and i + 2 < v.len() and hex_value(v[i + 1]) >= 0 and hex_value(v[i + 2]) >= 0 and (v[i + 1] as i64) < 128 and (v[i + 2] as i64) < 128 {
            let b = hex_value(v[i + 1]) * 16 + hex_value(v[i + 2]);
            out.push(char.try_from(b).unwrap_or('?'));
            i += 3;
        } else {
            out.push(v[i]);
            i += 1;
        }
    }
    out
}

// utils.decode_rfc2231 as a triple.
fn split_rfc2231(s: ref String) -> (Option[String], Option[String], String) {
    let parts: Vec[Str] = s.splitn(3, "'").collect();
    if parts.len() <= 2 {
        return (None, None, s.clone());
    }
    (Some(parts[0].to_string()), Some(parts[1].to_string()), parts[2].to_string())
}

// utils.decode_params
fn decode_params(params: ref Vec[(String, String)]) -> Vec[(String, PValue)] {
    let mut out: Vec[(String, PValue)] = vec![(params[0].0.clone(), PValue.Plain(params[0].1.clone()))];
    let mut names: Vec[String] = Vec.new();
    let mut conts: Vec[Vec[(Option[i64], String, bool)]] = Vec.new();
    for k in 1..params.len() {
        let name = params[k].0.clone();
        let encoded = name.ends_with("*");
        let value = unquote(params[k].1);
        match rfc2231_name(name) {
            Some((base, num)) => {
                let mut found = -1;
                for q in 0..names.len() {
                    if names[q] == base {
                        found = q;
                    }
                }
                if found < 0 {
                    names.push(base);
                    conts.push(Vec.new());
                    found = names.len() - 1;
                }
                conts[found].push((num, value, encoded));
            }
            None => out.push((name, PValue.Plain(f"\"{quote(value)}\""))),
        }
    }
    for q in 0..names.len() {
        let mut has_zero = false;
        for c in conts[q].iter() {
            if c.0 == Some(0) {
                has_zero = true;
            }
        }
        let mut list: Vec[(i64, String, bool)] = Vec.new();
        for c in conts[q].iter() {
            match c.0 {
                Some(n) => list.push((n, c.1.clone(), c.2)),
                None => {
                    if not has_zero {
                        list.push((0, c.1.clone(), c.2));
                    }
                }
            }
        }
        // a stable sort on the number
        let mut sorted: Vec[(i64, String, bool)] = Vec.new();
        for item in list.into_iter() {
            let mut at = sorted.len();
            while at > 0 and sorted[at - 1].0 > item.0 {
                at -= 1;
            }
            sorted.insert(at, item);
        }
        let mut joined = String.new();
        let mut extended = false;
        for (_, s, encoded) in sorted.iter() {
            if encoded {
                joined.push_str(unquote_latin1(s));
                extended = true;
            } else {
                joined.push_str(s);
            }
        }
        let value = quote(joined);
        if extended {
            let (cs, lang, v) = split_rfc2231(value);
            out.push((names[q].clone(), PValue.Triple(cs, lang, f"\"{v}\"")));
        } else {
            out.push((names[q].clone(), PValue.Plain(f"\"{value}\"")));
        }
    }
    out
}

// utils.collapse_rfc2231_value
fn collapse_value(v: ref PValue) -> String {
    match v {
        PValue.Plain(s) => unquote(s),
        PValue.Triple(cs, _, t) => {
            let charset = cs.clone().unwrap_or("us-ascii".to_string());
            let raw = raw_unicode_escape(t);
            match lookup_codec(charset) {
                Ok(c) => decode_bytes(raw, c, true).unwrap_or(String.new()),
                Err(_) => unquote(t),
            }
        }
    }
}

fn pvalue_truthy(v: ref Option[PValue]) -> bool {
    match v {
        None => false,
        Some(PValue.Plain(s)) => not s.is_empty(),
        Some(PValue.Triple(_, _, _)) => true,
    }
}

// ------------------------------------------------------------ email.message

#[derive(Clone)]
enum Payload {
    Empty,
    Text(String),
    Parts(Vec[Message]),
}

// A defect: its class name and the argument it was made with, if any.
#[derive(Clone)]
struct Defect {
    name: String,
    arg: Option[String],
}

fn defect(name: Str) -> Defect {
    Defect { name: name.to_string(), arg: None }
}

fn defect_with(name: Str, arg: ref String) -> Defect {
    Defect { name: name.to_string(), arg: Some(arg.clone()) }
}

fn defects_repr(ds: ref Vec[Defect]) -> String {
    let items: Vec[String] = ds.iter().map(|d| match d.arg.clone() {
        Some(a) => f"{d.name}({repr_str(a)})",
        None => d.name.clone(),
    }).collect();
    f"[{items.join(", ".to_string())}]"
}

// Message under the compat32 policy: header values are stored and
// returned as they are.
#[derive(Clone)]
struct Message {
    headers: Vec[(String, String)],
    unixfrom: Option[String],
    payload: Payload,
    preamble: Option[String],
    epilogue: Option[String],
    defects: Vec[Defect],
    default_type: String,
}

fn new_message() -> Message {
    Message {
        headers: Vec.new(),
        unixfrom: None,
        payload: Payload.Empty,
        preamble: None,
        epilogue: None,
        defects: Vec.new(),
        default_type: "text/plain".to_string(),
    }
}

fn key_error(name: ref String) -> String {
    f"KeyError: {repr_str(name)}"
}

impl Message {
    fn is_multipart(ref self) -> bool {
        match self.payload {
            Payload.Parts(_) => true,
            _ => false,
        }
    }

    fn attach(mut ref self, part: own Message) -> Result[(), String] {
        let mut ps: Vec[Message] = match self.payload {
            Payload.Empty => Vec.new(),
            Payload.Parts(ps) => ps.clone(),
            Payload.Text(_) => return Err("TypeError: Attach is not valid on a message with a non-multipart payload".to_string()),
        };
        ps.push(part);
        self.payload = Payload.Parts(ps);
        Ok(())
    }

    fn parts(ref self) -> Vec[Message] {
        match self.payload {
            Payload.Parts(ps) => ps.clone(),
            _ => Vec.new(),
        }
    }

    fn contains(ref self, name: ref String) -> bool {
        let lname = name.to_lowercase();
        for (k, _) in self.headers.iter() {
            if k.to_lowercase() == lname {
                return true;
            }
        }
        false
    }

    fn get(ref self, name: ref String) -> Option[String] {
        let lname = name.to_lowercase();
        for (k, v) in self.headers.iter() {
            if k.to_lowercase() == lname {
                return Some(v.clone());
            }
        }
        None
    }

    fn get_all(ref self, name: ref String) -> Option[Vec[String]] {
        let lname = name.to_lowercase();
        let mut out: Vec[String] = Vec.new();
        for (k, v) in self.headers.iter() {
            if k.to_lowercase() == lname {
                out.push(v.clone());
            }
        }
        if out.is_empty() {
            return None;
        }
        Some(out)
    }

    // msg[name] = value
    fn set(mut ref self, name: ref String, value: ref String) {
        self.headers.push((name.clone(), value.clone()));
    }

    // del msg[name]
    fn remove(mut ref self, name: ref String) {
        let lname = name.to_lowercase();
        let mut kept: Vec[(String, String)] = Vec.new();
        for (k, v) in self.headers.iter() {
            if k.to_lowercase() != lname {
                kept.push((k.clone(), v.clone()));
            }
        }
        self.headers = kept;
    }

    fn replace_header(mut ref self, name: ref String, value: ref String) -> Result[(), String] {
        let lname = name.to_lowercase();
        for i in 0..self.headers.len() {
            if self.headers[i].0.to_lowercase() == lname {
                let k = self.headers[i].0.clone();
                self.headers[i] = (k, value.clone());
                return Ok(());
            }
        }
        Err(key_error(lname))
    }

    fn add_header(mut ref self, name: ref String, value: ref Option[String], params: ref Vec[(String, Option[PValue])]) -> Result[(), String] {
        let mut parts: Vec[String] = Vec.new();
        for (k, v) in params.iter() {
            let key = k.replace("_", "-");
            match v {
                None => parts.push(key),
                Some(_) => parts.push(formatparam(key, v, true)?),
            }
        }
        if let Some(val) = value {
            parts.insert(0, val.clone());
        }
        self.set(name, parts.join("; ".to_string()));
        Ok(())
    }

    fn get_content_type(ref self) -> String {
        match self.get("content-type".to_string()) {
            None => self.default_type.clone(),
            Some(v) => {
                let ctype = splitparam(v).0.to_lowercase();
                if count_of(ctype, '/') != 1 {
                    return "text/plain".to_string();
                }
                ctype
            }
        }
    }

    fn get_content_maintype(ref self) -> String {
        let t = self.get_content_type();
        let parts: Vec[Str] = t.split("/").collect();
        parts[0].to_string()
    }

    fn get_content_subtype(ref self) -> String {
        let t = self.get_content_type();
        let parts: Vec[Str] = t.split("/").collect();
        parts[1].to_string()
    }

    fn get_params_preserve(ref self, header: ref String) -> Option[Vec[(String, PValue)]] {
        let value = self.get(header)?;
        let mut params: Vec[(String, String)] = Vec.new();
        for p in parseparam(value).iter() {
            match p.find("=") {
                Some(k) => {
                    let k = k as i64;
                    params.push((py_strip(p[..k].to_string()), py_strip(p[k + 1..].to_string())));
                }
                None => params.push((py_strip(p), String.new())),
            }
        }
        Some(decode_params(params))
    }

    fn get_params(ref self, header: ref String, unquote_it: bool) -> Option[Vec[(String, PValue)]] {
        let params = self.get_params_preserve(header)?;
        if not unquote_it {
            return Some(params);
        }
        Some(params.iter().map(|p| (p.0.clone(), unquotevalue(p.1))).collect())
    }

    fn get_param(ref self, param: ref String, header: ref String, unquote_it: bool) -> Option[PValue] {
        if not self.contains(header) {
            return None;
        }
        let lparam = param.to_lowercase();
        for (k, v) in self.get_params_preserve(header).unwrap_or(Vec.new()).iter() {
            if k.to_lowercase() == lparam {
                if unquote_it {
                    return Some(unquotevalue(v));
                }
                return Some(v.clone());
            }
        }
        None
    }

    fn set_param(mut ref self, param: ref String, value: ref PValue, header: ref String, requote: bool, charset: ref Option[String], language: ref String, replace: bool) -> Result[(), String] {
        let mut value = value.clone();
        if let PValue.Plain(s) = value.clone() {
            if let Some(cs) = charset {
                if not cs.is_empty() {
                    value = PValue.Triple(Some(cs.clone()), Some(language.clone()), s);
                }
            }
        }
        let current = if not self.contains(header) and header.to_lowercase() == "content-type" {
            Some("text/plain".to_string())
        } else {
            self.get(header)
        };
        let mut ctype = String.new();
        if not pvalue_truthy(self.get_param(param, header, true)) {
            let fp = formatparam(param, Some(value.clone()), requote)?;
            ctype = match current {
                Some(c) if not c.is_empty() => f"{c}; {fp}",
                _ => fp,
            };
        } else {
            let lparam = param.to_lowercase();
            for (old_param, old_value) in self.get_params(header, requote).unwrap_or(Vec.new()).iter() {
                let append = if old_param.to_lowercase() == lparam {
                    formatparam(param, Some(value.clone()), requote)?
                } else {
                    formatparam(old_param, Some(old_value.clone()), requote)?
                };
                if ctype.is_empty() {
                    ctype = append;
                } else {
                    ctype = f"{ctype}; {append}";
                }
            }
        }
        if Some(ctype.clone()) != self.get(header) {
            if replace {
                self.replace_header(header, ctype)?;
            } else {
                self.remove(header);
                self.set(header, ctype);
            }
        }
        Ok(())
    }

    fn del_param(mut ref self, param: ref String, header: ref String, requote: bool) -> Result[(), String] {
        if not self.contains(header) {
            return Ok(());
        }
        let lparam = param.to_lowercase();
        let mut new_ctype = String.new();
        for (p, v) in self.get_params(header, requote).unwrap_or(Vec.new()).iter() {
            if p.to_lowercase() != lparam {
                let fp = formatparam(p, Some(v.clone()), requote)?;
                if new_ctype.is_empty() {
                    new_ctype = fp;
                } else {
                    new_ctype = f"{new_ctype}; {fp}";
                }
            }
        }
        if Some(new_ctype.clone()) != self.get(header) {
            self.remove(header);
            self.set(header, new_ctype);
        }
        Ok(())
    }

    fn set_type(mut ref self, ctype: ref String, header: ref String, requote: bool) -> Result[(), String] {
        if count_of(ctype, '/') != 1 {
            return Err("ValueError: ".to_string());
        }
        if header.to_lowercase() == "content-type" {
            self.remove("mime-version".to_string());
            self.set("MIME-Version".to_string(), "1.0".to_string());
        }
        if not self.contains(header) {
            self.set(header, ctype);
            return Ok(());
        }
        let params = self.get_params(header, requote).unwrap_or(Vec.new());
        self.remove(header);
        self.set(header, ctype);
        for k in 1..params.len() {
            self.set_param(params[k].0, params[k].1, header, requote, None, String.new(), false)?;
        }
        Ok(())
    }

    fn get_filename(ref self) -> Option[String] {
        let mut v = self.get_param("filename".to_string(), "content-disposition".to_string(), true);
        if v.is_none() {
            v = self.get_param("name".to_string(), "content-type".to_string(), true);
        }
        match v {
            None => None,
            Some(p) => Some(py_strip(collapse_value(p))),
        }
    }

    fn get_boundary(ref self) -> Option[String] {
        match self.get_param("boundary".to_string(), "content-type".to_string(), true) {
            None => None,
            Some(p) => Some(py_rstrip(collapse_value(p))),
        }
    }

    fn set_boundary(mut ref self, boundary: ref String) -> Result[(), String] {
        let params = match self.get_params_preserve("content-type".to_string()) {
            Some(p) => p,
            None => return Err("HeaderParseError: No Content-Type header found".to_string()),
        };
        let mut newparams: Vec[(String, String)] = Vec.new();
        let mut found = false;
        for (k, v) in params.iter() {
            if k.to_lowercase() == "boundary" {
                newparams.push(("boundary".to_string(), f"\"{boundary}\""));
                found = true;
            } else {
                // A triple here would print as a tuple; only plain values reach it.
                let s = match v {
                    PValue.Plain(s) => s.clone(),
                    PValue.Triple(cs, lang, s) => f"({opt_repr(cs)}, {opt_repr(lang)}, {repr_str(s)})",
                };
                newparams.push((k.clone(), s));
            }
        }
        if not found {
            newparams.push(("boundary".to_string(), f"\"{boundary}\""));
        }
        let mut headers: Vec[(String, String)] = Vec.new();
        for (h, v) in self.headers.iter() {
            if h.to_lowercase() == "content-type" {
                let parts: Vec[String] = newparams.iter().map(|p| if p.1.is_empty() { p.0.clone() } else { f"{p.0}={p.1}" }).collect();
                headers.push((h.clone(), parts.join("; ".to_string())));
            } else {
                headers.push((h.clone(), v.clone()));
            }
        }
        self.headers = headers;
        Ok(())
    }

    fn get_content_charset(ref self) -> Option[String] {
        let p = self.get_param("charset".to_string(), "content-type".to_string(), true)?;
        let charset = match p {
            PValue.Plain(s) => s,
            PValue.Triple(cs, _, s) => {
                let pcharset = match cs {
                    Some(c) if not c.is_empty() => c,
                    _ => "us-ascii".to_string(),
                };
                match lookup_codec(pcharset) {
                    Ok(c) => decode_bytes(raw_unicode_escape(s), c, false).unwrap_or(s.clone()),
                    Err(_) => s,
                }
            }
        };
        if not is_ascii(charset) {
            return None;
        }
        Some(charset.to_lowercase())
    }

    fn get_content_disposition(ref self) -> Option[String] {
        let v = self.get("content-disposition".to_string())?;
        Some(splitparam(v).0.to_lowercase())
    }

    // walk(): this message, then every subpart depth first.
    fn walk(ref self) -> Vec[Message] {
        let mut out: Vec[Message] = vec![self.clone()];
        for p in self.parts().iter() {
            for q in p.walk().into_iter() {
                out.push(q);
            }
        }
        out
    }

    fn get_charsets(ref self) -> Vec[Option[String]] {
        self.walk().iter().map(|p| p.get_content_charset()).collect()
    }

    fn payload_text(ref self) -> Option[String] {
        match self.payload {
            Payload.Text(t) => Some(t.clone()),
            _ => None,
        }
    }

    // get_payload() for a payload that is not a list.
    fn get_payload_str(ref self) -> Option[String] {
        let payload = self.payload_text()?;
        if has_surrogates(payload) {
            if let Some(b) = unescape_bytes(payload) {
                let cs = self.get_content_charset().unwrap_or("ascii".to_string());
                let decoded = match lookup_codec(cs) {
                    Ok(c) => decode_bytes(b, c, true),
                    Err(_) => decode_bytes(b, Codec.Ascii, true),
                };
                return Some(decoded.unwrap_or(payload));
            }
        }
        Some(payload)
    }

    // get_payload(decode=True): the bytes, or None for a multipart. Base64
    // defects are added to the message.
    fn get_payload_decoded(mut ref self) -> Option[Vec[u8]] {
        let payload = self.payload_text()?;
        let cte = py_strip(self.get("content-transfer-encoding".to_string()).unwrap_or(String.new())).to_lowercase();
        let bpayload = match unescape_bytes(payload) {
            Some(b) => b,
            None => raw_unicode_escape(payload),
        };
        if cte == "quoted-printable" {
            return Some(a2b_qp(bpayload));
        }
        if cte == "base64" {
            let (value, defects) = decode_b(concat(split_byte_lines(bpayload)));
            for d in defects.iter() {
                self.defects.push(defect(d.as_str()));
            }
            return Some(value);
        }
        if cte == "x-uuencode" or cte == "uuencode" or cte == "uue" or cte == "x-uue" {
            return match decode_uu(bpayload) {
                Some(b) => Some(b),
                None => Some(bpayload),
            };
        }
        Some(bpayload)
    }

    fn set_payload_text(mut ref self, s: ref String) {
        self.payload = Payload.Text(s.clone());
    }

    fn items_repr(ref self) -> String {
        let items: Vec[String] = self.headers.iter().map(|h| f"({repr_str(h.0)}, {repr_str(h.1)})").collect();
        f"[{items.join(", ".to_string())}]"
    }
}

// ------------------------------------------------------------ email.feedparser

// io.StringIO(newline="").readlines(): lines end after "\n", "\r\n" or a
// lone "\r", and keep their ending.
fn read_lines(t: ref String) -> Vec[String] {
    let v = chars(t);
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    let mut i = 0;
    while i < v.len() {
        let c = v[i];
        cur.push(c);
        if c == '\n' {
            out.push(cur);
            cur = String.new();
        } else if c == '\r' {
            if i + 1 < v.len() and v[i + 1] == '\n' {
                cur.push('\n');
                i += 1;
            }
            out.push(cur);
            cur = String.new();
        }
        i += 1;
    }
    if not cur.is_empty() {
        out.push(cur);
    }
    out
}

// NLCRE.match: the line starts with a line break.
fn starts_blank(line: ref String) -> bool {
    line.starts_with("\r") or line.starts_with("\n")
}

// The length of the line break NLCRE_eol finds at the end, or 0.
fn eol_len(s: ref String) -> i64 {
    if s.ends_with("\r\n") {
        2
    } else if s.ends_with("\r") or s.ends_with("\n") {
        1
    } else {
        0
    }
}

fn strip_eol(s: ref String) -> String {
    let v = chars(s);
    text(slice(v, 0, v.len() - eol_len(s)))
}

// headerRE: ^(From |[\041-\071\073-\176]*:|[\t ])
fn header_line(line: ref String) -> bool {
    if line.starts_with("From ") or line.starts_with(" ") or line.starts_with("\t") {
        return true;
    }
    for c in line.chars() {
        if c == ':' {
            return true;
        }
        let o = c as i64;
        if o < 33 or o > 126 {
            return false;
        }
    }
    false
}

// boundarymatch(line): whether the line is "--" + boundary followed by
// boundaryendRE, and if so whether it ends the multipart and the line
// break it ends with.
fn boundary_match(line: ref String, separator: ref String) -> Option[(bool, Option[String])] {
    if not line.starts_with(separator.as_str()) {
        return None;
    }
    let v = chars(line);
    let mut i = chars(separator).len();
    let mut end = false;
    if i + 1 < v.len() and v[i] == '-' and v[i + 1] == '-' {
        end = true;
        i += 2;
    }
    while i < v.len() and (v[i] == ' ' or v[i] == '\t') {
        i += 1;
    }
    let rest = text(slice(v, i, v.len()));
    if rest.is_empty() {
        return Some((end, None));
    }
    if rest == "\r\n" or rest == "\r" or rest == "\n" {
        return Some((end, Some(rest)));
    }
    None
}

#[derive(Clone)]
enum Matcher {
    Blank,
    Boundary(String),
}

fn matcher_hit(m: ref Matcher, line: ref String) -> bool {
    match m {
        Matcher.Blank => starts_blank(line),
        Matcher.Boundary(sep) => boundary_match(line, sep).is_some(),
    }
}

// A message while it is parsed: the parser's stack and its _cur and _last
// are indexes into a list of these.
struct Node {
    msg: Message,
    kids: Vec[i64],
    is_list: bool,
}

struct FeedParser {
    lines: Vec[String],
    pos: i64,
    pushed: Vec[String],
    eofstack: Vec[Matcher],
    nodes: Vec[Node],
    stack: Vec[i64],
    cur: i64,
    last: i64,
}

impl FeedParser {
    // BufferedSubFile.readline: "" at the end of the input and at a false
    // end of file, where the line is pushed back.
    fn readline(mut ref self) -> String {
        let line = if not self.pushed.is_empty() {
            self.pushed.pop().unwrap_or(String.new())
        } else if self.pos < self.lines.len() {
            self.pos += 1;
            self.lines[self.pos - 1].clone()
        } else {
            return String.new();
        };
        let mut k = self.eofstack.len();
        while k > 0 {
            k -= 1;
            if matcher_hit(self.eofstack[k], line) {
                self.pushed.push(line);
                return String.new();
            }
        }
        line
    }

    fn unreadline(mut ref self, line: ref String) {
        self.pushed.push(line.clone());
    }

    fn rest(mut ref self) -> String {
        let mut out = String.new();
        loop {
            let line = self.readline();
            if line.is_empty() {
                break;
            }
            out.push_str(line);
        }
        out
    }

    fn add_defect(mut ref self, d: own Defect) {
        let c = self.cur;
        self.nodes[c].msg.defects.push(d);
    }

    fn cur_msg(ref self) -> Message {
        self.nodes[self.cur].msg.clone()
    }

    fn new_message(mut ref self) {
        let mut m = new_message();
        if self.cur >= 0 and self.nodes[self.cur].msg.get_content_type() == "multipart/digest" {
            m.default_type = "message/rfc822".to_string();
        }
        self.nodes.push(Node { msg: m, kids: Vec.new(), is_list: false });
        let id = self.nodes.len() - 1;
        if not self.stack.is_empty() {
            let top = self.stack[self.stack.len() - 1];
            self.nodes[top].kids.push(id);
            self.nodes[top].is_list = true;
        }
        self.stack.push(id);
        self.cur = id;
        self.last = id;
    }

    fn pop_message(mut ref self) -> i64 {
        let id = self.stack.pop().unwrap_or(-1);
        self.cur = if self.stack.is_empty() { -1 } else { self.stack[self.stack.len() - 1] };
        id
    }

    fn set_raw(mut ref self, source: ref Vec[String]) {
        // Compat32.header_source_parse
        let first = source[0].clone();
        let k = first.find(":").unwrap_or(0) as i64;
        let name = first[..k].to_string();
        let mut value = first[k + 1..].to_string();
        for i in 1..source.len() {
            value.push_str(source[i]);
        }
        let value = rstrip_set(lstrip_set(value, " \t\r\n"), "\r\n");
        let c = self.cur;
        self.nodes[c].msg.headers.push((name, value));
    }

    fn parse_headers(mut ref self, lines: ref Vec[String]) {
        let mut lastheader = false;
        let mut lastvalue: Vec[String] = Vec.new();
        for lineno in 0..lines.len() {
            let line = lines[lineno].clone();
            if line.starts_with(" ") or line.starts_with("\t") {
                if not lastheader {
                    self.add_defect(defect_with("FirstHeaderLineIsContinuationDefect", line));
                    continue;
                }
                lastvalue.push(line);
                continue;
            }
            if lastheader {
                self.set_raw(lastvalue);
                lastheader = false;
                lastvalue = Vec.new();
            }
            if line.starts_with("From ") {
                if lineno == 0 {
                    let c = self.cur;
                    self.nodes[c].msg.unixfrom = Some(strip_eol(line));
                    continue;
                } else if lineno == lines.len() - 1 {
                    self.unreadline(line);
                    return;
                } else {
                    self.add_defect(defect_with("MisplacedEnvelopeHeaderDefect", line));
                    continue;
                }
            }
            let i = line.find(":").unwrap_or(0) as i64;
            if i == 0 {
                self.add_defect(defect_with("InvalidHeaderDefect", "Missing header name.".to_string()));
                continue;
            }
            lastheader = true;
            lastvalue = vec![line];
        }
        if lastheader {
            self.set_raw(lastvalue);
        }
    }

    fn parsegen(mut ref self) {
        self.new_message();
        let mut headers: Vec[String] = Vec.new();
        loop {
            let line = self.readline();
            if line.is_empty() {
                break;
            }
            if not header_line(line) {
                if not starts_blank(line) {
                    self.add_defect(defect("MissingHeaderBodySeparatorDefect"));
                    self.unreadline(line);
                }
                break;
            }
            headers.push(line);
        }
        self.parse_headers(headers);
        let msg = self.cur_msg();
        if msg.get_content_type() == "message/delivery-status" {
            loop {
                self.eofstack.push(Matcher.Blank);
                self.parsegen();
                self.pop_message();
                self.eofstack.pop();
                self.readline();
                let line = self.readline();
                if line.is_empty() {
                    break;
                }
                self.unreadline(line);
            }
            return;
        }
        let maintype = msg.get_content_maintype();
        if maintype == "message" {
            self.parsegen();
            self.pop_message();
            return;
        }
        if maintype == "multipart" {
            self.parse_multipart(msg);
            return;
        }
        let body = self.rest();
        let c = self.cur;
        self.nodes[c].msg.payload = Payload.Text(body);
    }

    fn parse_multipart(mut ref self, msg: ref Message) {
        let boundary = match msg.get_boundary() {
            Some(b) => b,
            None => {
                self.add_defect(defect("NoBoundaryInMultipartDefect"));
                let body = self.rest();
                let c = self.cur;
                self.nodes[c].msg.payload = Payload.Text(body);
                return;
            }
        };
        let cte = msg.get("content-transfer-encoding".to_string()).unwrap_or("8bit".to_string()).to_lowercase();
        if cte != "7bit" and cte != "8bit" and cte != "binary" {
            self.add_defect(defect("InvalidMultipartContentTransferEncodingDefect"));
        }
        let separator = f"--{boundary}";
        let mut capturing_preamble = true;
        let mut preamble: Vec[String] = Vec.new();
        let mut linesep: Option[String] = None;
        let mut close_boundary_seen = false;
        loop {
            let line = self.readline();
            if line.is_empty() {
                break;
            }
            match boundary_match(line, separator) {
                Some((is_end, ls)) => {
                    if is_end {
                        close_boundary_seen = true;
                        linesep = ls;
                        break;
                    }
                    if capturing_preamble {
                        if not preamble.is_empty() {
                            let n = preamble.len();
                            preamble[n - 1] = strip_eol(preamble[n - 1]);
                            let c = self.cur;
                            self.nodes[c].msg.preamble = Some(preamble.join("".to_string()));
                        }
                        capturing_preamble = false;
                        self.unreadline(line);
                        continue;
                    }
                    loop {
                        let next = self.readline();
                        if boundary_match(next, separator).is_none() {
                            self.unreadline(next);
                            break;
                        }
                    }
                    self.eofstack.push(Matcher.Boundary(separator.clone()));
                    self.parsegen();
                    let l = self.last;
                    if self.nodes[l].msg.get_content_maintype() == "multipart" {
                        let ep = self.nodes[l].msg.epilogue.clone();
                        match ep {
                            Some(e) => {
                                if e.is_empty() {
                                    self.nodes[l].msg.epilogue = None;
                                } else {
                                    self.nodes[l].msg.epilogue = Some(strip_eol(e));
                                }
                            }
                            None => {}
                        }
                    } else {
                        if let Payload.Text(p) = self.nodes[l].msg.payload.clone() {
                            self.nodes[l].msg.payload = Payload.Text(strip_eol(p));
                        }
                    }
                    self.eofstack.pop();
                    self.pop_message();
                    self.last = self.cur;
                }
                None => preamble.push(line),
            }
        }
        if capturing_preamble {
            self.add_defect(defect("StartBoundaryNotFoundDefect"));
            let c = self.cur;
            self.nodes[c].msg.payload = Payload.Text(preamble.join("".to_string()));
            self.rest();
            self.nodes[c].msg.epilogue = Some(String.new());
            return;
        }
        if not close_boundary_seen {
            self.add_defect(defect("CloseBoundaryNotFoundDefect"));
            return;
        }
        let mut epilogue: Vec[String] = Vec.new();
        if let Some(ls) = linesep {
            if not ls.is_empty() {
                epilogue.push(String.new());
            }
        }
        loop {
            let line = self.readline();
            if line.is_empty() {
                break;
            }
            epilogue.push(line);
        }
        if not epilogue.is_empty() {
            let first = epilogue[0].clone();
            let v = chars(first);
            let cut = if first.starts_with("\r\n") { 2 } else if starts_blank(first) { 1 } else { 0 };
            epilogue[0] = text(slice(v, cut, v.len()));
        }
        let c = self.cur;
        self.nodes[c].msg.epilogue = Some(epilogue.join("".to_string()));
    }

    fn build(ref self, id: i64) -> Message {
        let mut m = self.nodes[id].msg.clone();
        if self.nodes[id].is_list {
            let mut parts: Vec[Message] = Vec.new();
            for k in self.nodes[id].kids.iter() {
                parts.push(self.build(*k));
            }
            m.payload = Payload.Parts(parts);
        }
        m
    }
}

// email.message_from_string, under compat32.
fn message_from_string(t: ref String) -> Message {
    let mut p = FeedParser {
        lines: read_lines(t),
        pos: 0,
        pushed: Vec.new(),
        eofstack: Vec.new(),
        nodes: Vec.new(),
        stack: Vec.new(),
        cur: -1,
        last: -1,
    };
    p.parsegen();
    let root = p.pop_message();
    if p.nodes[root].msg.get_content_maintype() == "multipart" and not p.nodes[root].is_list {
        p.nodes[root].msg.defects.push(defect("MultipartInvariantViolationDefect"));
    }
    p.build(root)
}

// ------------------------------------------------------------ email.generator

// fcre.sub(">From ", s): "From " at the start of any line.
fn mangle_from(s: ref String) -> String {
    let v = chars(s);
    let mut out = String.new();
    let mut i = 0;
    while i < v.len() {
        let bol = i == 0 or v[i - 1] == '\n';
        if bol and i + 5 <= v.len() and text(slice(v, i, i + 5)) == "From " {
            out.push('>');
        }
        out.push(v[i]);
        i += 1;
    }
    out
}

// Generator._write_lines: every line break becomes "\n".
fn write_lines(s: ref String) -> String {
    if s.is_empty() {
        return String.new();
    }
    let v = chars(s);
    let mut out = String.new();
    let mut i = 0;
    while i < v.len() {
        let c = v[i];
        if c == '\r' {
            out.push('\n');
            if i + 1 < v.len() and v[i + 1] == '\n' {
                i += 1;
            }
        } else {
            out.push(c);
        }
        i += 1;
    }
    out
}

// NEWLINE_WITHOUT_FWSP.search
fn newline_without_fwsp(s: ref String) -> bool {
    let v = chars(s);
    let mut i = 0;
    while i < v.len() {
        if v[i] == '\r' and i + 1 < v.len() and v[i + 1] == '\n' {
            if i + 2 < v.len() and v[i + 2] != ' ' and v[i + 2] != '\t' {
                return true;
            }
        }
        if v[i] == '\r' and i + 1 < v.len() and v[i + 1] != ' ' and v[i + 1] != '\n' and v[i + 1] != '\t' {
            return true;
        }
        if v[i] == '\n' and i + 1 < v.len() and v[i + 1] != ' ' and v[i + 1] != '\t' {
            return true;
        }
        i += 1;
    }
    false
}

// Compat32.fold: the value through Header with the field name, wrapped at
// maxlen (0 for no wrapping).
fn fold(name: ref String, value: ref String, maxlen: i64) -> Result[String, String] {
    if has_surrogates(value) {
        return Err("NotImplementedError: unknown-8bit header values are not in the port".to_string());
    }
    let mut h = new_header(None, 78, Some(name.clone()), " ".to_string());
    h.append(Word.Text(value.clone()), None)?;
    let encoded = h.encode(";, \t".to_string(), Some(maxlen), "\n".to_string())?;
    let folded = f"{name}: {encoded}\n";
    let body = text(slice(chars(folded), 0, chars(folded).len() - 1));
    if newline_without_fwsp(body) {
        return Err(f"HeaderWriteError: folded header contains newline: {repr_str(folded)}");
    }
    Ok(folded)
}

struct Gen {
    mangle: bool,
    maxlen: i64,
}

impl Gen {
    fn flatten(ref self, msg: ref Message) -> Result[String, String] {
        let body = self.dispatch(msg)?;
        let mut out = String.new();
        for (h, v) in msg.headers.iter() {
            out.push_str(fold(h, v, self.maxlen)?);
        }
        out.push('\n');
        out.push_str(body);
        Ok(out)
    }

    fn dispatch(ref self, msg: ref Message) -> Result[String, String] {
        let main = msg.get_content_maintype();
        let sub = msg.get_content_subtype();
        if main == "multipart" and sub == "signed" {
            let g = Gen { mangle: self.mangle, maxlen: 0 };
            return g.handle_multipart(msg);
        }
        if main == "message" and sub == "delivery-status" {
            return self.handle_delivery_status(msg);
        }
        if main == "multipart" {
            return self.handle_multipart(msg);
        }
        if main == "message" {
            return self.handle_message(msg);
        }
        self.handle_text(msg)
    }

    fn handle_text(ref self, msg: ref Message) -> Result[String, String] {
        let payload = match msg.payload {
            Payload.Empty => return Ok(String.new()),
            Payload.Text(t) => t.clone(),
            Payload.Parts(_) => return Err("TypeError: string payload expected: <class 'list'>".to_string()),
        };
        if has_surrogates(payload) and msg.get_param("charset".to_string(), "content-type".to_string(), true).is_some() {
            return Err("NotImplementedError: 8-bit payloads re-encoded on output are not in the port".to_string());
        }
        let p = if self.mangle { mangle_from(payload) } else { payload };
        Ok(write_lines(p))
    }

    fn handle_multipart(ref self, msg: ref Message) -> Result[String, String] {
        let subparts = match msg.payload {
            Payload.Empty => Vec.new(),
            Payload.Text(t) => return Ok(t.clone()),
            Payload.Parts(ps) => ps.clone(),
        };
        let mut texts: Vec[String] = Vec.new();
        for part in subparts.iter() {
            texts.push(self.flatten(part)?);
        }
        let boundary = match msg.get_boundary() {
            Some(b) if not b.is_empty() => b,
            _ => return Err("NotImplementedError: a random boundary is not in the port".to_string()),
        };
        let mut out = String.new();
        if let Some(pre) = msg.preamble.clone() {
            let p = if self.mangle { mangle_from(pre) } else { pre };
            out.push_str(write_lines(p));
            out.push('\n');
        }
        out.push_str(f"--{boundary}\n");
        for k in 0..texts.len() {
            if k > 0 {
                out.push_str(f"\n--{boundary}\n");
            }
            out.push_str(texts[k]);
        }
        out.push_str(f"\n--{boundary}--\n");
        if let Some(ep) = msg.epilogue.clone() {
            let e = if self.mangle { mangle_from(ep) } else { ep };
            out.push_str(write_lines(e));
        }
        Ok(out)
    }

    fn handle_delivery_status(ref self, msg: ref Message) -> Result[String, String] {
        let mut blocks: Vec[String] = Vec.new();
        for part in msg.parts().iter() {
            let t = self.flatten(part)?;
            let lines: Vec[Str] = t.split("\n").collect();
            if not lines.is_empty() and lines[lines.len() - 1].is_empty() {
                let kept: Vec[String] = lines[0..lines.len() - 1].iter().map(|l| l.to_string()).collect();
                blocks.push(kept.join("\n".to_string()));
            } else {
                // Workaround (B-2026-10-19-6): `lines` borrows `t` to the end
                // of the loop body, so `t` cannot be moved here.
                blocks.push(t.clone());
            }
        }
        Ok(blocks.join("\n".to_string()))
    }

    fn handle_message(ref self, msg: ref Message) -> Result[String, String] {
        match msg.payload {
            Payload.Parts(ps) => self.flatten(ps[0]),
            Payload.Text(t) => Ok(t.clone()),
            Payload.Empty => Err("TypeError: write() argument must be str, not None".to_string()),
        }
    }
}

// Message.as_string(maxheaderlen=0): no From_ mangling, no wrapping.
fn as_string(msg: ref Message) -> Result[String, String] {
    let g = Gen { mangle: false, maxlen: 0 };
    g.flatten(msg)
}

// ------------------------------------------------------------ email._parseaddr dates and time

// The 10-tuple parsedate_tz returns (the weekday, yearday and DST fields
// are always 0, 1 and -1).
#[derive(Clone)]
struct DateTuple {
    yy: i64,
    mm: i64,
    dd: i64,
    thh: i64,
    tmm: i64,
    tss: i64,
    tz: i64,
}

fn date_tuple_repr(t: ref DateTuple) -> String {
    f"({t.yy}, {t.mm}, {t.dd}, {t.thh}, {t.tmm}, {t.tss}, 0, 1, -1, {t.tz})"
}

fn month_names() -> Vec[Str] {
    vec!["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec",
         "january", "february", "march", "april", "may", "june", "july", "august",
         "september", "october", "november", "december"]
}

fn month_index(s: ref String) -> i64 {
    let names = month_names();
    for i in 0..names.len() {
        if names[i] == s.as_str() {
            return i;
        }
    }
    -1
}

fn is_day_name(s: ref String) -> bool {
    for d in vec!["mon", "tue", "wed", "thu", "fri", "sat", "sun"].iter() {
        if *d == s.as_str() {
            return true;
        }
    }
    false
}

fn tz_table(s: ref String) -> Option[i64] {
    let names = vec!["UT", "UTC", "GMT", "Z", "AST", "ADT", "EST", "EDT", "CST", "CDT", "MST", "MDT", "PST", "PDT"];
    let values = vec![0, 0, 0, 0, -400, -300, -500, -400, -600, -500, -700, -600, -800, -700];
    for i in 0..names.len() {
        if names[i] == s.as_str() {
            return Some(values[i]);
        }
    }
    None
}

// int(s) for the strings parsedate_tz meets: an optional sign and ASCII
// digits, with "_" allowed between digits.
fn py_int(s: ref String) -> Option[i64] {
    let v = chars(py_strip(s));
    if v.is_empty() {
        return None;
    }
    let mut i = 0;
    let mut neg = false;
    if v[0] == '+' or v[0] == '-' {
        neg = v[0] == '-';
        i = 1;
    }
    if i >= v.len() {
        return None;
    }
    let mut n: i64 = 0;
    let mut last_digit = false;
    while i < v.len() {
        let c = v[i];
        if is_digit(c) {
            n = n.checked_mul(10)?.checked_add((c as i64) - ('0' as i64))?;
            last_digit = true;
        } else if c == '_' and last_digit and i + 1 < v.len() and is_digit(v[i + 1]) {
            last_digit = false;
        } else {
            return None;
        }
        i += 1;
    }
    if neg {
        n = -n;
    }
    Some(n)
}

fn drop_last(s: ref String) -> String {
    let v = chars(s);
    text(slice(v, 0, v.len() - 1))
}

fn from_index(s: ref String, i: i64) -> String {
    let v = chars(s);
    text(slice(v, i, v.len()))
}

fn find_char(s: ref String, c: char) -> i64 {
    let v = chars(s);
    for i in 0..v.len() {
        if v[i] == c {
            return i;
        }
    }
    -1
}

fn rfind_char(s: ref String, c: char) -> i64 {
    let v = chars(s);
    let mut i = v.len() - 1;
    while i >= 0 {
        if v[i] == c {
            return i;
        }
        i -= 1;
    }
    -1
}

fn split_on(s: ref String, sep: Str) -> Vec[String] {
    s.split(sep).map(|p| p.to_string()).collect()
}

// _parsedate_tz, then parsedate_tz's "None offset is 0".
fn parsedate_tz(data_in: ref String) -> Option[DateTuple] {
    if data_in.is_empty() {
        return None;
    }
    let mut data = py_split(data_in);
    if data.is_empty() {
        return None;
    }
    if data[0].ends_with(",") or is_day_name(data[0].to_lowercase()) {
        data.remove(0);
    } else {
        let i = rfind_char(data[0], ',');
        if i >= 0 {
            data[0] = from_index(data[0], i + 1);
        }
    }
    if data.len() == 3 {
        let stuff = split_on(data[0], "-");
        if stuff.len() == 3 {
            let mut d2 = stuff;
            d2.push(data[1].clone());
            d2.push(data[2].clone());
            data = d2;
        }
    }
    if data.len() == 4 {
        let s = data[3].clone();
        let mut i = find_char(s, '+');
        if i == -1 {
            i = find_char(s, '-');
        }
        if i > 0 {
            let v = chars(s);
            data[3] = text(slice(v, 0, i));
            data.push(text(slice(v, i, v.len())));
        } else {
            data.push(String.new());
        }
    }
    if data.len() < 5 {
        return None;
    }
    let mut dd = data[0].clone();
    let mut mm = data[1].clone();
    let mut yy = data[2].clone();
    let mut tm = data[3].clone();
    let mut tz = data[4].clone();
    if dd.is_empty() or mm.is_empty() or yy.is_empty() {
        return None;
    }
    mm = mm.to_lowercase();
    if month_index(mm) < 0 {
        let old = mm.clone();
        mm = dd.to_lowercase();
        dd = old;
        if month_index(mm) < 0 {
            return None;
        }
    }
    let mut month = month_index(mm) + 1;
    if month > 12 {
        month -= 12;
    }
    if last_char(dd) == ',' {
        dd = drop_last(dd);
    }
    if find_char(yy, ':') > 0 {
        let old = yy.clone();
        yy = tm.clone();
        tm = old;
    }
    if last_char(yy) == ',' {
        yy = drop_last(yy);
        if yy.is_empty() {
            return None;
        }
    }
    if not is_digit(first_char(yy)) {
        let old = yy.clone();
        yy = tz.clone();
        tz = old;
    }
    if last_char(tm) == ',' {
        tm = drop_last(tm);
    }
    let mut parts = split_on(tm, ":");
    let (thh, tmm, tss) = if parts.len() == 2 {
        (parts[0].clone(), parts[1].clone(), "0".to_string())
    } else if parts.len() == 3 {
        (parts[0].clone(), parts[1].clone(), parts[2].clone())
    } else if parts.len() == 1 and find_char(parts[0], '.') >= 0 {
        parts = split_on(parts[0], ".");
        if parts.len() == 2 {
            (parts[0].clone(), parts[1].clone(), "0".to_string())
        } else if parts.len() == 3 {
            (parts[0].clone(), parts[1].clone(), parts[2].clone())
        } else {
            return None;
        }
    } else {
        return None;
    };
    let mut year = py_int(yy)?;
    let day = py_int(dd)?;
    let hour = py_int(thh)?;
    let minute = py_int(tmm)?;
    let second = py_int(tss)?;
    if year < 100 {
        if year > 68 {
            year += 1900;
        } else {
            year += 2000;
        }
    }
    let tzu = tz.to_uppercase();
    let mut offset: Option[i64] = None;
    if let Some(v) = tz_table(tzu) {
        offset = Some(v);
    } else {
        offset = py_int(tzu);
        if offset == Some(0) and tzu.starts_with("-") {
            offset = None;
        }
    }
    let mut secs = offset.unwrap_or(0);
    if secs != 0 {
        let sign = if secs < 0 { -1 } else { 1 };
        let o = if secs < 0 { -secs } else { secs };
        secs = sign * ((o / 100) * 3600 + (o % 100) * 60);
    }
    Some(DateTuple { yy: year, mm: month, dd: day, thh: hour, tmm: minute, tss: second, tz: secs })
}

// Days from 1970-01-01 to the given civil date (proleptic Gregorian).
fn days_from_civil(y0: i64, m: i64, d: i64) -> i64 {
    let y = if m <= 2 { y0 - 1 } else { y0 };
    let era = if y >= 0 { y / 400 } else { (y - 399) / 400 };
    let yoe = y - era * 400;
    let mp = if m > 2 { m - 3 } else { m + 9 };
    let doy = (153 * mp + 2) / 5 + d - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

// calendar.timegm, then mktime_tz: seconds since the epoch.
fn mktime_tz(t: ref DateTuple) -> Result[i64, String] {
    if t.yy < 1 or t.yy > 9999 {
        return Err(f"ValueError: year {t.yy} is out of range");
    }
    let days = days_from_civil(t.yy, t.mm, 1) + t.dd - 1;
    let hours = days * 24 + t.thh;
    let minutes = hours * 60 + t.tmm;
    Ok(minutes * 60 + t.tss - t.tz)
}

fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

fn pad2(n: i64, c: char) -> String {
    if n < 10 {
        return f"{c}{n}";
    }
    f"{n}"
}

// time.asctime(time.gmtime(ts)): "Mon Oct 19 12:30:02 2026", the day
// padded with a space.
fn asctime_gm(ts: i64) -> String {
    let days = floor_div(ts, 86400);
    let rem = ts - days * 86400;
    let z = days + 719468;
    let era = if z >= 0 { z / 146097 } else { (z - 146096) / 146097 };
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = if mp < 10 { mp + 3 } else { mp - 9 };
    let y = yoe + era * 400 + (if m <= 2 { 1 } else { 0 });
    let wday = ((days % 7) + 7 + 3) % 7;
    let dnames = vec!["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    let mnames = vec!["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    let hh = rem / 3600;
    let mi = (rem % 3600) / 60;
    let ss = rem % 60;
    f"{dnames[wday]} {mnames[m - 1]} {pad2(d, ' ')} {pad2(hh, '0')}:{pad2(mi, '0')}:{pad2(ss, '0')} {y}"
}
// ------------------------------------------------------------ the file system, as os and os.path see it

// The path as the errors print it: the data directory is "<data>".
fn shown(p: ref String) -> String {
    if p == "data" {
        return "<data>".to_string();
    }
    if p.starts_with("data/") {
        return f"<data>{from_index(p, 4)}";
    }
    p.clone()
}

fn join(a: ref String, b: ref String) -> String {
    f"{a}/{b}"
}

fn dirname(p: ref String) -> String {
    let i = rfind_char(p, '/');
    if i < 0 {
        return String.new();
    }
    text(slice(chars(p), 0, i))
}

fn basename(p: ref String) -> String {
    let i = rfind_char(p, '/');
    from_index(p, i + 1)
}

fn exists(p: ref String) -> bool {
    fs.exists(p.clone())
}

fn is_dir(p: ref String) -> bool {
    match fs.metadata(p.clone()) {
        Ok(m) => m.is_dir,
        Err(_) => false,
    }
}

fn not_found(p: ref String) -> String {
    f"FileNotFoundError: [Errno 2] No such file or directory: {repr_str(shown(p))}"
}

fn listdir(p: ref String) -> Result[Vec[String], String] {
    if not is_dir(p) {
        return Err(not_found(p));
    }
    match fs.read_dir(p.clone()) {
        Ok(n) => {
            let mut names = n;
            names.sort();
            Ok(names)
        }
        Err(_) => Err(not_found(p)),
    }
}

fn read_file(p: ref String) -> Result[String, String] {
    match fs.read_to_string(p.clone()) {
        Ok(t) => Ok(t),
        Err(_) => Err(not_found(p)),
    }
}

fn write_file(p: ref String, t: ref String) -> Result[(), String] {
    match fs.write(p.clone(), t.clone()) {
        Ok(_) => Ok(()),
        Err(_) => Err(not_found(p)),
    }
}

fn remove_file(p: ref String) -> Result[(), String] {
    if not exists(p) {
        return Err(not_found(p));
    }
    match fs.remove_file(p.clone()) {
        Ok(_) => Ok(()),
        Err(e) => Err(f"OSError: {e}"),
    }
}

fn mkdir(p: ref String) -> Result[(), String] {
    if exists(p) {
        return Err(f"FileExistsError: [Errno 17] File exists: {repr_str(shown(p))}");
    }
    if not is_dir(dirname(p)) {
        return Err(not_found(p));
    }
    match fs.create_dir(p.clone()) {
        Ok(_) => Ok(()),
        Err(e) => Err(f"OSError: {e}"),
    }
}

fn rmdir(p: ref String) -> Result[(), String] {
    match fs.remove_dir(p.clone()) {
        Ok(_) => Ok(()),
        Err(e) => Err(f"OSError: {e}"),
    }
}

fn rename(a: ref String, b: ref String) -> Result[(), String] {
    if not exists(a) {
        return Err(f"FileNotFoundError: [Errno 2] No such file or directory: {repr_str(shown(a))} -> {repr_str(shown(b))}");
    }
    match fs.rename(a.clone(), b.clone()) {
        Ok(_) => Ok(()),
        Err(e) => Err(f"OSError: {e}"),
    }
}

// os.link(a, b) then os.unlink(a).
fn link_move(a: ref String, b: ref String) -> Result[(), String] {
    if not exists(a) {
        return Err(f"FileNotFoundError: [Errno 2] No such file or directory: {repr_str(shown(a))} -> {repr_str(shown(b))}");
    }
    if exists(b) {
        return Err(f"FileExistsError: [Errno 17] File exists: {repr_str(shown(a))} -> {repr_str(shown(b))}");
    }
    rename(a, b)
}

// open(p, "xb+"): a new, empty file.
fn create_new(p: ref String) -> Result[(), String] {
    if exists(p) {
        return Err(f"FileExistsError: [Errno 17] File exists: {repr_str(shown(p))}");
    }
    write_file(p, String.new())
}

// Every file and directory under p, relative to it; directories end in "/".
fn walk_into(base: ref String, rel: ref String, out: mut ref Vec[String]) -> Result[(), String] {
    let dir = if rel.is_empty() { base.clone() } else { join(base, rel) };
    for n in listdir(dir)?.iter() {
        let r = if rel.is_empty() { n.clone() } else { join(rel, n) };
        if is_dir(join(dir, n)) {
            out.push(f"{r}/");
            walk_into(base, r, mut out)?;
        } else {
            out.push(r);
        }
    }
    Ok(())
}

fn tree(p: ref String) -> Result[Vec[String], String] {
    let mut out: Vec[String] = Vec.new();
    // os.walk of a missing directory yields nothing.
    if not is_dir(p) {
        return Ok(out);
    }
    walk_into(p, String.new(), mut out)?;
    out.sort();
    Ok(out)
}

// shutil.rmtree, bottom up.
fn remove_tree(p: ref String) -> Result[(), String] {
    for n in listdir(p)?.iter() {
        let q = join(p, n);
        if is_dir(q) {
            remove_tree(q)?;
        } else {
            remove_file(q)?;
        }
    }
    rmdir(p)
}

fn make_dirs(p: ref String) -> Result[(), String] {
    match fs.create_dir_all(p.clone()) {
        Ok(_) => Ok(()),
        Err(e) => Err(f"OSError: {e}"),
    }
}

// shutil.copyfile, or shutil.copytree for a directory.
fn copy_path(src: ref String, dst: ref String) -> Result[(), String] {
    if is_dir(src) {
        make_dirs(dst)?;
        for n in listdir(src)?.iter() {
            copy_path(join(src, n), join(dst, n))?;
        }
        return Ok(());
    }
    let t = read_file(src)?;
    write_file(dst, t)
}
// ------------------------------------------------------------ mailbox: the message kinds

// A Babyl label: a str, or the bytes Babyl._generate_toc leaves in the
// label lists it reads from a file.
#[derive(Clone)]
enum Label {
    Str(String),
    Bytes(String),
}

fn label_repr(l: ref Label) -> String {
    match l {
        Label.Str(s) => repr_str(s),
        Label.Bytes(s) => f"b{repr_str(s)}",
    }
}

fn labels_repr(ls: ref Vec[Label]) -> String {
    let items: Vec[String] = ls.iter().map(|l| label_repr(l)).collect();
    f"[{items.join(", ")}]"
}

fn label_is(l: ref Label, s: Str) -> bool {
    match l {
        Label.Str(t) => t == s,
        Label.Bytes(_) => false,
    }
}

fn label_same(a: ref Label, b: ref Label) -> bool {
    match (a.clone(), b.clone()) {
        (Label.Str(x), Label.Str(y)) => x == y,
        (Label.Bytes(x), Label.Bytes(y)) => x == y,
        _ => false,
    }
}

fn has_label(ls: ref Vec[Label], s: Str) -> bool {
    for l in ls.iter() {
        if label_is(l, s) {
            return true;
        }
    }
    false
}

fn special_label(l: ref Label) -> bool {
    for s in vec!["unseen", "deleted", "filed", "answered", "forwarded", "edited", "resent"].iter() {
        if label_is(l, s) {
            return true;
        }
    }
    false
}

#[derive(Clone)]
enum Kind {
    Plain,
    Maildir,
    Mbox,
    Mmdf,
    Mh,
    Babyl,
}

fn kind_is_mboxish(k: ref Kind) -> bool {
    match k {
        Kind.Mbox => true,
        Kind.Mmdf => true,
        _ => false,
    }
}

fn kind_name(k: ref Kind) -> Str {
    match k {
        Kind.Plain => "Message",
        Kind.Maildir => "MaildirMessage",
        Kind.Mbox => "mboxMessage",
        Kind.Mmdf => "MMDFMessage",
        Kind.Mh => "MHMessage",
        Kind.Babyl => "BabylMessage",
    }
}

fn kind_of(name: ref String) -> Kind {
    if name == "maildir" {
        return Kind.Maildir;
    }
    if name == "mbox" {
        return Kind.Mbox;
    }
    if name == "mmdf" {
        return Kind.Mmdf;
    }
    if name == "mh" {
        return Kind.Mh;
    }
    if name == "babyl" {
        return Kind.Babyl;
    }
    Kind.Plain
}

// A mailbox.Message subclass: the email Message and the attributes its
// kind adds.
#[derive(Clone)]
struct MMsg {
    kind: Kind,
    m: Message,
    subdir: String,
    info: String,
    from_: String,
    seqs: Vec[String],
    labels: Vec[Label],
    visible: Message,
}

// What time.asctime(time.gmtime()) would add to a From_ line; the jobs
// never print one.
fn now_text() -> String {
    "Thu Jan  1 00:00:00 1970".to_string()
}

fn new_mmsg(kind: own Kind, m: own Message) -> MMsg {
    let mut out = MMsg {
        kind: kind,
        m: m,
        subdir: "new".to_string(),
        info: String.new(),
        from_: f"MAILER-DAEMON {now_text()}",
        seqs: Vec.new(),
        labels: Vec.new(),
        visible: new_message(),
    };
    if kind_is_mboxish(out.kind) {
        if let Some(u) = out.m.unixfrom.clone() {
            if u.starts_with("From ") {
                out.from_ = from_index(u, 5);
            }
        }
    }
    out
}

fn char_set(s: ref String) -> Vec[char] {
    let mut out: Vec[char] = Vec.new();
    for c in s.chars() {
        if not out.contains(c) {
            out.push(c);
        }
    }
    out
}

fn sorted_text(cs: ref Vec[char]) -> String {
    let mut v = cs.clone();
    v.sort();
    text(v)
}

fn union_chars(a: ref String, b: ref String) -> String {
    let mut s = char_set(a);
    for c in b.chars() {
        if not s.contains(c) {
            s.push(c);
        }
    }
    text(s)
}

fn minus_chars(a: ref String, b: ref String) -> String {
    let drop = char_set(b);
    let mut out: Vec[char] = Vec.new();
    for c in char_set(a).iter() {
        if not drop.contains(*c) {
            out.push(*c);
        }
    }
    text(out)
}

impl MMsg {
    // ---- MaildirMessage
    fn md_flags(ref self) -> String {
        if self.info.starts_with("2,") {
            return from_index(self.info, 2);
        }
        String.new()
    }

    fn md_set_flags(mut ref self, flags: ref String) {
        self.info = f"2,{sorted_text(chars(flags))}";
    }

    fn md_add_flag(mut ref self, flag: ref String) {
        let f = union_chars(self.md_flags(), flag);
        self.md_set_flags(f);
    }

    fn md_remove_flag(mut ref self, flag: ref String) {
        if not self.md_flags().is_empty() {
            let f = minus_chars(self.md_flags(), flag);
            self.md_set_flags(f);
        }
    }

    fn set_subdir(mut ref self, subdir: ref String) -> Result[(), String] {
        if subdir == "new" or subdir == "cur" {
            self.subdir = subdir.clone();
            return Ok(());
        }
        Err(f"ValueError: subdir must be 'new' or 'cur': {subdir}")
    }

    // ---- mboxMessage and MMDFMessage
    fn mb_flags(ref self) -> String {
        let a = self.m.get("Status".to_string()).unwrap_or(String.new());
        let b = self.m.get("X-Status".to_string()).unwrap_or(String.new());
        f"{a}{b}"
    }

    fn put_header(mut ref self, name: Str, value: ref String) -> Result[(), String] {
        if self.m.replace_header(name.to_string(), value.clone()).is_err() {
            self.m.add_header(name.to_string(), Some(value.clone()), Vec.new())?;
        }
        Ok(())
    }

    fn mb_set_flags(mut ref self, flags: ref String) -> Result[(), String] {
        let mut rest = char_set(flags);
        let mut status = String.new();
        let mut xstatus = String.new();
        for f in "RO".chars() {
            if rest.contains(f) {
                status.push(f);
                rest.retain(|c| c != f);
            }
        }
        for f in "DFA".chars() {
            if rest.contains(f) {
                xstatus.push(f);
                rest.retain(|c| c != f);
            }
        }
        xstatus.push_str(sorted_text(rest));
        self.put_header("Status", status)?;
        self.put_header("X-Status", xstatus)?;
        Ok(())
    }

    fn mb_add_flag(mut ref self, flag: ref String) -> Result[(), String] {
        let f = union_chars(self.mb_flags(), flag);
        self.mb_set_flags(f)
    }

    fn mb_remove_flag(mut ref self, flag: ref String) -> Result[(), String] {
        if self.m.contains("Status".to_string()) or self.m.contains("X-Status".to_string()) {
            let f = minus_chars(self.mb_flags(), flag);
            self.mb_set_flags(f)?;
        }
        Ok(())
    }

    // ---- MHMessage
    fn add_sequence(mut ref self, s: ref String) {
        if not self.seqs.contains(s.clone()) {
            self.seqs.push(s.clone());
        }
    }

    fn remove_sequence(mut ref self, s: ref String) {
        for i in 0..self.seqs.len() {
            if self.seqs[i] == *s {
                self.seqs.remove(i);
                return;
            }
        }
    }

    // ---- BabylMessage
    fn add_label(mut ref self, l: ref Label) -> Result[(), String] {
        match l {
            Label.Bytes(_) => Err("TypeError: label must be a string: <class 'bytes'>".to_string()),
            Label.Str(_) => {
                for x in self.labels.iter() {
                    if label_same(x, l) {
                        return Ok(());
                    }
                }
                self.labels.push(l.clone());
                Ok(())
            }
        }
    }

    fn remove_label(mut ref self, l: ref Label) {
        for i in 0..self.labels.len() {
            if label_same(self.labels[i], l) {
                self.labels.remove(i);
                return;
            }
        }
    }

    // The flags of either flag-carrying kind.
    fn add_flag(mut ref self, flag: ref String) -> Result[(), String] {
        match self.kind {
            Kind.Maildir => {
                self.md_add_flag(flag);
                Ok(())
            }
            _ => self.mb_add_flag(flag),
        }
    }

    fn remove_flag(mut ref self, flag: ref String) -> Result[(), String] {
        match self.kind {
            Kind.Maildir => {
                self.md_remove_flag(flag);
                Ok(())
            }
            _ => self.mb_remove_flag(flag),
        }
    }

    fn set_flags(mut ref self, flags: ref String) -> Result[(), String] {
        match self.kind {
            Kind.Maildir => {
                self.md_set_flags(flags);
                Ok(())
            }
            _ => self.mb_set_flags(flags),
        }
    }

    fn state(ref self) -> String {
        let name = kind_name(self.kind);
        match self.kind {
            Kind.Maildir => f"{name} subdir={repr_str(self.subdir)} info={repr_str(self.info)} flags={repr_str(self.md_flags())}",
            Kind.Mbox => f"{name} from={repr_str(self.from_)} flags={repr_str(self.mb_flags())}",
            Kind.Mmdf => f"{name} from={repr_str(self.from_)} flags={repr_str(self.mb_flags())}",
            Kind.Mh => {
                let items: Vec[String] = self.seqs.iter().map(|s| repr_str(s)).collect();
                f"{name} sequences=[{items.join(", ")}]"
            }
            Kind.Babyl => f"{name} labels={labels_repr(self.labels)} visible={self.visible.items_repr()}",
            Kind.Plain => name.to_string(),
        }
    }
}

fn del_status(m: mut ref MMsg) {
    m.m.remove("status".to_string());
    m.m.remove("x-status".to_string());
}

// KindMessage(src): a deep copy of the email Message, then
// src._explain_to(new).
fn convert_msg(kind: own Kind, src: ref MMsg) -> Result[MMsg, String] {
    let mut t = new_mmsg(kind, src.m.clone());
    let tk = t.kind.clone();
    if let Kind.Plain = tk {
        return Ok(t);
    }
    match src.kind {
        Kind.Plain => {}
        Kind.Maildir => {
            let flags = char_set(src.md_flags());
            match tk {
                Kind.Maildir => {
                    t.md_set_flags(src.md_flags());
                    t.set_subdir(src.subdir)?;
                }
                Kind.Mbox | Kind.Mmdf => {
                    if flags.contains('S') {
                        t.mb_add_flag("R".to_string())?;
                    }
                    if src.subdir == "cur" {
                        t.mb_add_flag("O".to_string())?;
                    }
                    if flags.contains('T') {
                        t.mb_add_flag("D".to_string())?;
                    }
                    if flags.contains('F') {
                        t.mb_add_flag("F".to_string())?;
                    }
                    if flags.contains('R') {
                        t.mb_add_flag("A".to_string())?;
                    }
                    t.from_ = f"MAILER-DAEMON {now_text()}";
                }
                Kind.Mh => {
                    if not flags.contains('S') {
                        t.add_sequence("unseen".to_string());
                    }
                    if flags.contains('R') {
                        t.add_sequence("replied".to_string());
                    }
                    if flags.contains('F') {
                        t.add_sequence("flagged".to_string());
                    }
                }
                Kind.Babyl => {
                    if not flags.contains('S') {
                        t.add_label(Label.Str("unseen".to_string()))?;
                    }
                    if flags.contains('T') {
                        t.add_label(Label.Str("deleted".to_string()))?;
                    }
                    if flags.contains('R') {
                        t.add_label(Label.Str("answered".to_string()))?;
                    }
                    if flags.contains('P') {
                        t.add_label(Label.Str("forwarded".to_string()))?;
                    }
                }
                Kind.Plain => {}
            }
        }
        Kind.Mbox | Kind.Mmdf => {
            let flags = char_set(src.mb_flags());
            match tk {
                Kind.Maildir => {
                    if flags.contains('O') {
                        t.set_subdir("cur".to_string())?;
                    }
                    if flags.contains('F') {
                        t.md_add_flag("F".to_string());
                    }
                    if flags.contains('A') {
                        t.md_add_flag("R".to_string());
                    }
                    if flags.contains('R') {
                        t.md_add_flag("S".to_string());
                    }
                    if flags.contains('D') {
                        t.md_add_flag("T".to_string());
                    }
                    del_status(mut t);
                }
                Kind.Mbox | Kind.Mmdf => {
                    t.mb_set_flags(src.mb_flags())?;
                    t.from_ = src.from_.clone();
                }
                Kind.Mh => {
                    if not flags.contains('R') {
                        t.add_sequence("unseen".to_string());
                    }
                    if flags.contains('A') {
                        t.add_sequence("replied".to_string());
                    }
                    if flags.contains('F') {
                        t.add_sequence("flagged".to_string());
                    }
                    del_status(mut t);
                }
                Kind.Babyl => {
                    if not flags.contains('R') {
                        t.add_label(Label.Str("unseen".to_string()))?;
                    }
                    if flags.contains('D') {
                        t.add_label(Label.Str("deleted".to_string()))?;
                    }
                    if flags.contains('A') {
                        t.add_label(Label.Str("answered".to_string()))?;
                    }
                    del_status(mut t);
                }
                Kind.Plain => {}
            }
        }
        Kind.Mh => {
            let seqs = src.seqs.clone();
            match tk {
                Kind.Maildir => {
                    t.set_subdir("cur".to_string())?;
                    if not seqs.contains("unseen".to_string()) {
                        t.md_add_flag("S".to_string());
                    }
                    if seqs.contains("flagged".to_string()) {
                        t.md_add_flag("F".to_string());
                    }
                    if seqs.contains("replied".to_string()) {
                        t.md_add_flag("R".to_string());
                    }
                }
                Kind.Mbox | Kind.Mmdf => {
                    if not seqs.contains("unseen".to_string()) {
                        t.mb_add_flag("RO".to_string())?;
                    } else {
                        t.mb_add_flag("O".to_string())?;
                    }
                    if seqs.contains("flagged".to_string()) {
                        t.mb_add_flag("F".to_string())?;
                    }
                    if seqs.contains("replied".to_string()) {
                        t.mb_add_flag("A".to_string())?;
                    }
                }
                Kind.Mh => {
                    for s in seqs.iter() {
                        t.add_sequence(s);
                    }
                }
                Kind.Babyl => {
                    if seqs.contains("unseen".to_string()) {
                        t.add_label(Label.Str("unseen".to_string()))?;
                    }
                    if seqs.contains("replied".to_string()) {
                        t.add_label(Label.Str("answered".to_string()))?;
                    }
                }
                Kind.Plain => {}
            }
        }
        Kind.Babyl => {
            let ls = src.labels.clone();
            match tk {
                Kind.Maildir => {
                    t.set_subdir("cur".to_string())?;
                    if not has_label(ls, "unseen") {
                        t.md_add_flag("S".to_string());
                    }
                    if has_label(ls, "forwarded") or has_label(ls, "resent") {
                        t.md_add_flag("P".to_string());
                    }
                    if has_label(ls, "answered") {
                        t.md_add_flag("R".to_string());
                    }
                    if has_label(ls, "deleted") {
                        t.md_add_flag("T".to_string());
                    }
                }
                Kind.Mbox | Kind.Mmdf => {
                    if not has_label(ls, "unseen") {
                        t.mb_add_flag("RO".to_string())?;
                    } else {
                        t.mb_add_flag("O".to_string())?;
                    }
                    if has_label(ls, "deleted") {
                        t.mb_add_flag("D".to_string())?;
                    }
                    if has_label(ls, "answered") {
                        t.mb_add_flag("A".to_string())?;
                    }
                }
                Kind.Mh => {
                    if has_label(ls, "unseen") {
                        t.add_sequence("unseen".to_string());
                    }
                    if has_label(ls, "answered") {
                        t.add_sequence("replied".to_string());
                    }
                }
                Kind.Babyl => {
                    t.visible = src.visible.clone();
                    for l in ls.iter() {
                        t.add_label(l)?;
                    }
                }
                Kind.Plain => {}
            }
        }
    }
    Ok(t)
}

// ------------------------------------------------------------ mailbox: the mailboxes

// A message handed to add() or __setitem__: the raw bytes of a file, or a
// Message.
#[derive(Clone)]
enum Input {
    Raw(String),
    Msg(MMsg),
}

#[derive(Clone)]
enum BoxKind {
    Mbox,
    Mmdf,
    Babyl,
    Mh,
    Maildir,
}

#[derive(Clone)]
struct Box {
    kind: BoxKind,
    path: String,
    fdata: Vec[char],
    toc: Vec[(i64, i64, i64)],
    toc_ready: bool,
    next_key: i64,
    pending: bool,
    blabels: Vec[(i64, Vec[Label])],
    count: i64,
}

fn no_key(k: ref String) -> String {
    f"KeyError: {repr_str(f"No message with key: {k}")}"
}

fn no_such_mailbox(p: ref String) -> String {
    f"NoSuchMailboxError: {shown(p)}"
}

fn new_box(kind: own BoxKind, path: ref String) -> Box {
    Box {
        kind: kind,
        path: path.clone(),
        fdata: Vec.new(),
        toc: Vec.new(),
        toc_ready: false,
        next_key: 0,
        pending: false,
        blabels: Vec.new(),
        count: 1,
    }
}

// Opening a mailbox, as each constructor does.
fn open_box(kind: own BoxKind, path: ref String, create: bool) -> Result[Box, String] {
    let mut b = new_box(kind.clone(), path);
    match kind {
        BoxKind.Mh => {
            if not exists(path) {
                if not create {
                    return Err(no_such_mailbox(path));
                }
                mkdir(path)?;
                create_new(join(path, ".mh_sequences"))?;
            }
        }
        BoxKind.Maildir => {
            if not exists(path) {
                if not create {
                    return Err(no_such_mailbox(path));
                }
                mkdir(path)?;
                for s in vec!["tmp", "new", "cur"].iter() {
                    mkdir(join(path, s.to_string()))?;
                }
            }
        }
        _ => {
            if exists(path) {
                b.fdata = chars(read_file(path)?);
            } else {
                if not create {
                    return Err(no_such_mailbox(path));
                }
                write_file(path, String.new())?;
            }
        }
    }
    Ok(b)
}

fn readline(v: ref Vec[char], pos: i64) -> (String, i64) {
    let mut i = pos;
    while i < v.len() {
        if v[i] == '\n' {
            return (text(slice(v, pos, i + 1)), i + 1);
        }
        i += 1;
    }
    (text(slice(v, pos, v.len())), v.len())
}

// f.read(n) from pos: a negative n reads to the end.
fn read_n(v: ref Vec[char], pos: i64, n: i64) -> String {
    if n < 0 {
        return text(slice(v, pos, v.len()));
    }
    text(slice(v, pos, pos + n))
}

fn bytes_strip(s: ref String) -> String {
    let v = chars(s);
    let ws = |c: char| c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == '\u{b}' or c == '\u{c}';
    let mut lo = 0;
    let mut hi = v.len();
    while lo < hi and ws(v[lo]) {
        lo += 1;
    }
    while hi > lo and ws(v[hi - 1]) {
        hi -= 1;
    }
    text(slice(v, lo, hi))
}

fn zip_toc(starts: ref Vec[i64], stops: ref Vec[i64]) -> Vec[(i64, i64, i64)] {
    let mut out: Vec[(i64, i64, i64)] = Vec.new();
    let mut i = 0;
    while i < starts.len() and i < stops.len() {
        out.push((i, starts[i], stops[i]));
        i += 1;
    }
    out
}

fn marker() -> String {
    "\u{1}\u{1}\u{1}\u{1}\n".to_string()
}

impl Box {
    fn is_single(ref self) -> bool {
        match self.kind {
            BoxKind.Mh => false,
            BoxKind.Maildir => false,
            _ => true,
        }
    }

    fn save(ref self) -> Result[(), String] {
        write_file(self.path, text(self.fdata))
    }

    // ---- the single-file mailboxes: the table of contents
    fn generate_toc(mut ref self) {
        let v = self.fdata.clone();
        let mut starts: Vec[i64] = Vec.new();
        let mut stops: Vec[i64] = Vec.new();
        match self.kind {
            BoxKind.Mbox => {
                let mut last_was_empty = false;
                let mut pos = 0;
                loop {
                    let line_pos = pos;
                    let (line, np) = readline(v, pos);
                    pos = np;
                    if line.starts_with("From ") {
                        if stops.len() < starts.len() {
                            if last_was_empty {
                                stops.push(line_pos - 1);
                            } else {
                                stops.push(line_pos);
                            }
                        }
                        starts.push(line_pos);
                        last_was_empty = false;
                    } else if line.is_empty() {
                        if last_was_empty {
                            stops.push(line_pos - 1);
                        } else {
                            stops.push(line_pos);
                        }
                        break;
                    } else if line == "\n" {
                        last_was_empty = true;
                    } else {
                        last_was_empty = false;
                    }
                }
            }
            BoxKind.Mmdf => {
                let mut next_pos = 0;
                loop {
                    let (line, np) = readline(v, next_pos);
                    next_pos = np;
                    if line.starts_with(marker()) {
                        starts.push(next_pos);
                        loop {
                            let line_pos = next_pos;
                            let (l2, np2) = readline(v, next_pos);
                            next_pos = np2;
                            if l2 == marker() {
                                stops.push(line_pos - 1);
                                break;
                            } else if l2.is_empty() {
                                stops.push(line_pos);
                                break;
                            }
                        }
                    } else if line.is_empty() {
                        break;
                    }
                }
            }
            _ => {
                let mut lists: Vec[Vec[Label]] = Vec.new();
                let mut next_pos = 0;
                let mut fp = 0;
                loop {
                    let line_pos = next_pos;
                    let (line, np) = readline(v, fp);
                    fp = np;
                    next_pos = fp;
                    if line == "\u{1f}\u{c}\n" {
                        if stops.len() < starts.len() {
                            stops.push(line_pos - 1);
                        }
                        starts.push(next_pos);
                        let (l2, np2) = readline(v, fp);
                        fp = np2;
                        let mut ls: Vec[Label] = Vec.new();
                        for part in from_index(l2, 1).split(",") {
                            let s = bytes_strip(part.to_string());
                            if not s.is_empty() {
                                ls.push(Label.Bytes(s));
                            }
                        }
                        lists.push(ls);
                    } else if line == "\u{1f}" or line == "\u{1f}\n" {
                        if stops.len() < starts.len() {
                            stops.push(line_pos - 1);
                        }
                    } else if line.is_empty() {
                        stops.push(line_pos - 1);
                        break;
                    }
                }
                self.blabels = Vec.new();
                for i in 0..lists.len() {
                    self.blabels.push((i, lists[i].clone()));
                }
            }
        }
        self.toc = zip_toc(starts, stops);
        self.next_key = self.toc.len();
        self.toc_ready = true;
    }

    fn ensure_toc(mut ref self) {
        if not self.toc_ready {
            self.generate_toc();
        }
    }

    fn lookup(mut ref self, key: i64) -> Result[(i64, i64), String] {
        self.ensure_toc();
        for (k, a, b) in self.toc.iter() {
            if k == key {
                return Ok((a, b));
            }
        }
        Err(no_key(f"{key}"))
    }

    fn babyl_labels_of(ref self, key: i64) -> Option[Vec[Label]] {
        for (k, ls) in self.blabels.iter() {
            if k == key {
                return Some(ls.clone());
            }
        }
        None
    }

    fn set_babyl_labels(mut ref self, key: i64, ls: ref Vec[Label]) {
        for i in 0..self.blabels.len() {
            if self.blabels[i].0 == key {
                self.blabels[i] = (key, ls.clone());
                return;
            }
        }
        self.blabels.push((key, ls.clone()));
    }

    // Babyl.get_labels: the user labels of every message.
    fn get_labels(mut ref self) -> Vec[Label] {
        self.ensure_toc();
        let mut out: Vec[Label] = Vec.new();
        for (_, ls) in self.blabels.iter() {
            for l in ls.iter() {
                if special_label(l) {
                    continue;
                }
                let mut seen = false;
                for x in out.iter() {
                    if label_same(x, l) {
                        seen = true;
                    }
                }
                if not seen {
                    out.push(l.clone());
                }
            }
        }
        out
    }

    fn pre_mailbox_hook(mut ref self, w: mut ref String) -> Result[(), String] {
        if let BoxKind.Babyl = self.kind {
            let mut names: Vec[String] = Vec.new();
            for l in self.get_labels().iter() {
                match l {
                    Label.Str(s) => names.push(s.clone()),
                    Label.Bytes(_) => return Err("AttributeError: 'bytes' object has no attribute 'encode'".to_string()),
                }
            }
            w.push_str(f"BABYL OPTIONS:\nVersion: 5\nLabels:{names.join(",")}\n\u{1f}");
        }
        Ok(())
    }

    fn pre_message_hook(ref self, w: mut ref String) {
        match self.kind {
            BoxKind.Mmdf => w.push_str(marker()),
            BoxKind.Babyl => w.push_str("\u{c}\n"),
            _ => {}
        }
    }

    fn post_message_hook(ref self, w: mut ref String) {
        match self.kind {
            BoxKind.Mbox => w.push('\n'),
            BoxKind.Mmdf => w.push_str(f"\n{marker()}"),
            BoxKind.Babyl => w.push_str("\n\u{1f}"),
            _ => {}
        }
    }

    fn append_newline(ref self) -> bool {
        match self.kind {
            BoxKind.Mbox => true,
            _ => false,
        }
    }

    fn mangle(ref self) -> bool {
        match self.kind {
            BoxKind.Mbox => true,
            BoxKind.Mmdf => true,
            _ => false,
        }
    }

    // _install_message: writes the message to w, which starts at offset
    // base of the file, and returns its (start, stop).
    fn install(ref self, input: ref Input, base: i64, w: mut ref String) -> Result[(i64, i64), String] {
        let start = base + width(w);
        if let BoxKind.Babyl = self.kind {
            babyl_install(input, mut w)?;
            return Ok((start, base + width(w)));
        }
        let mut body = input.clone();
        let mut from_line: Option[String] = None;
        match input {
            Input.Raw(s) => {
                if s.starts_with("From ") {
                    let nl = find_char(s, '\n');
                    if nl >= 0 {
                        let v = chars(s);
                        from_line = Some(text(slice(v, 0, nl)));
                        body = Input.Raw(text(slice(v, nl + 1, v.len())));
                    } else {
                        from_line = Some(s.clone());
                        body = Input.Raw(String.new());
                    }
                }
            }
            Input.Msg(mm) => {
                if kind_is_mboxish(mm.kind) {
                    from_line = Some(f"From {mm.from_}");
                } else {
                    from_line = mm.m.unixfrom.clone();
                }
            }
        }
        let fl = from_line.unwrap_or(f"From MAILER-DAEMON {now_text()}");
        w.push_str(f"{fl}\n");
        w.push_str(dump_message(body, self.mangle(), self.append_newline())?);
        Ok((start, base + width(w)))
    }

    fn append_message(mut ref self, input: ref Input) -> Result[(i64, i64), String] {
        let before = self.fdata.len();
        let mut w = String.new();
        if self.toc.is_empty() and not self.pending {
            self.pre_mailbox_hook(mut w)?;
        }
        self.pre_message_hook(mut w);
        let offsets = self.install(input, before, mut w)?;
        self.post_message_hook(mut w);
        for c in w.chars() {
            self.fdata.push(c);
        }
        self.save()?;
        Ok(offsets)
    }

    // ---- the single-file mailboxes: add, remove, replace, flush
    fn sf_add(mut ref self, input: ref Input) -> Result[i64, String] {
        self.ensure_toc();
        let offs = self.append_message(input)?;
        let key = self.next_key;
        self.toc.push((key, offs.0, offs.1));
        self.next_key += 1;
        if let Input.Msg(mm) = input {
            if let Kind.Babyl = mm.kind {
                if let BoxKind.Babyl = self.kind {
                    self.set_babyl_labels(key, mm.labels);
                }
            }
        }
        Ok(key)
    }

    fn sf_remove(mut ref self, key: i64) -> Result[(), String] {
        self.lookup(key)?;
        self.toc.retain(|t| t.0 != key);
        self.pending = true;
        self.blabels.retain(|t| t.0 != key);
        Ok(())
    }

    fn sf_set(mut ref self, key: i64, input: ref Input) -> Result[(), String] {
        self.lookup(key)?;
        let offs = self.append_message(input)?;
        for i in 0..self.toc.len() {
            if self.toc[i].0 == key {
                self.toc[i] = (key, offs.0, offs.1);
            }
        }
        self.pending = true;
        if let Input.Msg(mm) = input {
            if let Kind.Babyl = mm.kind {
                if let BoxKind.Babyl = self.kind {
                    self.set_babyl_labels(key, mm.labels);
                }
            }
        }
        Ok(())
    }

    fn flush(mut ref self) -> Result[(), String] {
        if not self.is_single() or not self.pending {
            return Ok(());
        }
        let mut w = String.new();
        self.pre_mailbox_hook(mut w)?;
        let mut keys: Vec[i64] = self.toc.iter().map(|t| t.0).collect();
        keys.sort();
        let mut new_toc: Vec[(i64, i64, i64)] = Vec.new();
        for k in keys.iter() {
            let (start, stop) = self.lookup(*k)?;
            self.pre_message_hook(mut w);
            let ns = width(w);
            w.push_str(read_n(self.fdata, start, stop - start));
            new_toc.push((*k, ns, width(w)));
            self.post_message_hook(mut w);
        }
        self.fdata = chars(w);
        self.save()?;
        self.toc = new_toc;
        self.pending = false;
        Ok(())
    }

    // ---- the single-file mailboxes: reading
    fn sf_get_message(mut ref self, key: i64) -> Result[MMsg, String] {
        let (start, stop) = self.lookup(key)?;
        let v = self.fdata.clone();
        if let BoxKind.Babyl = self.kind {
            let (_, p0) = readline(v, start);
            let mut pos = p0;
            let mut orig = String.new();
            loop {
                let (line, np) = readline(v, pos);
                pos = np;
                if line == "*** EOOH ***\n" or line.is_empty() {
                    break;
                }
                orig.push_str(line);
            }
            let mut vis = String.new();
            loop {
                let (line, np) = readline(v, pos);
                pos = np;
                if line == "\n" or line.is_empty() {
                    break;
                }
                vis.push_str(line);
            }
            let n = stop - pos;
            if n < 0 {
                return Err("AssertionError: ".to_string());
            }
            let body = read_n(v, pos, n);
            let mut mm = new_mmsg(Kind.Babyl, message_from_string(f"{orig}{body}"));
            mm.visible = message_from_string(vis);
            if let Some(ls) = self.babyl_labels_of(key) {
                mm.labels = ls;
            }
            return Ok(mm);
        }
        let (line, p) = readline(v, start);
        let from_line = line.replace("\n", "");
        let s = read_n(v, p, stop - p);
        let kind = match self.kind {
            BoxKind.Mmdf => Kind.Mmdf,
            _ => Kind.Mbox,
        };
        let mut mm = new_mmsg(kind, message_from_string(s));
        mm.m.unixfrom = Some(from_line.clone());
        mm.from_ = from_index(from_line, 5);
        Ok(mm)
    }

    fn sf_get_bytes(mut ref self, key: i64, with_from: bool) -> Result[String, String] {
        let (start, stop) = self.lookup(key)?;
        let v = self.fdata.clone();
        if let BoxKind.Babyl = self.kind {
            let (_, p0) = readline(v, start);
            let mut pos = p0;
            let mut orig = String.new();
            loop {
                let (line, np) = readline(v, pos);
                pos = np;
                if line == "*** EOOH ***\n" or line.is_empty() {
                    break;
                }
                orig.push_str(line);
            }
            loop {
                let (line, np) = readline(v, pos);
                pos = np;
                if line == "\n" or line.is_empty() {
                    break;
                }
            }
            let n = stop - pos;
            if n < 0 {
                return Err("AssertionError: ".to_string());
            }
            return Ok(f"{orig}{read_n(v, pos, n)}");
        }
        let mut pos = start;
        if not with_from {
            let (_, p) = readline(v, start);
            pos = p;
        }
        Ok(read_n(v, pos, stop - pos))
    }

    // ---- MH
    fn mh_keys(ref self) -> Result[Vec[i64], String] {
        let mut out: Vec[i64] = Vec.new();
        for n in listdir(self.path)?.iter() {
            if not n.is_empty() and n.chars().all(|c| is_digit(c)) {
                out.push(py_int(n).unwrap_or(0));
            }
        }
        out.sort();
        Ok(out)
    }

    fn mh_file(ref self, key: i64) -> String {
        join(self.path, f"{key}")
    }

    fn get_sequences(ref self) -> Result[Vec[(String, Vec[i64])], String] {
        let mut results: Vec[(String, Vec[i64])] = Vec.new();
        let p = join(self.path, ".mh_sequences".to_string());
        if not exists(p) {
            return Ok(results);
        }
        let t = read_file(p)?;
        let all = self.mh_keys()?;
        for line in read_lines(t).iter() {
            let bad = f"FormatError: Invalid sequence specification: {py_rstrip(line)}";
            let parts = split_on(line, ":");
            if parts.len() != 2 {
                return Err(bad);
            }
            let mut keys: Vec[i64] = Vec.new();
            for spec in py_split(parts[1]).iter() {
                if spec.chars().all(|c| is_digit(c)) {
                    keys.push(py_int(spec).unwrap_or(0));
                } else {
                    let ends = split_on(spec, "-");
                    if ends.len() != 2 {
                        return Err(bad);
                    }
                    let a = match py_int(ends[0]) {
                        Some(x) => x,
                        None => return Err(bad),
                    };
                    let b = match py_int(ends[1]) {
                        Some(x) => x,
                        None => return Err(bad),
                    };
                    let mut k = a;
                    while k <= b {
                        keys.push(k);
                        k += 1;
                    }
                }
            }
            keys.sort();
            keys.dedup();
            let kept: Vec[i64] = keys.iter().filter(|k| all.contains(k)).collect();
            let name = parts[0].clone();
            let mut at = -1;
            for i in 0..results.len() {
                if results[i].0 == name {
                    at = i;
                }
            }
            if kept.is_empty() {
                if at >= 0 {
                    results.remove(at);
                }
            } else if at >= 0 {
                results[at] = (name, kept);
            } else {
                results.push((name, kept));
            }
        }
        Ok(results)
    }

    fn set_sequences(ref self, seqs: ref Vec[(String, Vec[i64])]) -> Result[(), String] {
        let mut out = String.new();
        for (name, keys) in seqs.iter() {
            if keys.is_empty() {
                continue;
            }
            out.push_str(f"{name}:");
            let mut ks = keys.clone();
            ks.sort();
            ks.dedup();
            let mut prev: i64 = -1000000;
            let mut have_prev = false;
            let mut completing = false;
            for k in ks.iter() {
                if have_prev and *k - 1 == prev {
                    if not completing {
                        completing = true;
                        out.push('-');
                    }
                } else if completing {
                    completing = false;
                    out.push_str(f"{prev} {k}");
                } else {
                    out.push_str(f" {k}");
                }
                prev = *k;
                have_prev = true;
            }
            if completing {
                out.push_str(f"{prev}\n");
            } else {
                out.push('\n');
            }
        }
        write_file(join(self.path, ".mh_sequences".to_string()), out)
    }

    fn dump_sequences(ref self, mm: ref MMsg, key: i64) -> Result[(), String] {
        let pending = mm.seqs.clone();
        let mut all = self.get_sequences()?;
        for i in 0..all.len() {
            let (name, kl) = all[i].clone();
            let mut kl2 = kl.clone();
            if pending.contains(name.clone()) {
                kl2.push(key);
            } else if kl.contains(key) {
                let at = kl.iter().position(|k| *k == key).unwrap_or(0);
                kl2.remove(at);
            }
            all[i] = (name, kl2);
        }
        for s in pending.iter() {
            if not all.iter().any(|t| t.0 == *s) {
                all.push((s.clone(), vec![key]));
            }
        }
        self.set_sequences(all)
    }

    fn mh_add(ref self, input: ref Input) -> Result[i64, String] {
        let keys = self.mh_keys()?;
        let new_key = if keys.is_empty() { 1 } else { keys[keys.len() - 1] + 1 };
        let p = self.mh_file(new_key);
        create_new(p)?;
        write_file(p, dump_message(input, false, false)?)?;
        if let Input.Msg(mm) = input {
            if let Kind.Mh = mm.kind {
                self.dump_sequences(mm, new_key)?;
            }
        }
        Ok(new_key)
    }

    fn mh_set(ref self, key: i64, input: ref Input) -> Result[(), String] {
        let p = self.mh_file(key);
        if not exists(p) {
            return Err(no_key(f"{key}"));
        }
        write_file(p, dump_message(input, false, false)?)?;
        if let Input.Msg(mm) = input {
            if let Kind.Mh = mm.kind {
                self.dump_sequences(mm, key)?;
            }
        }
        Ok(())
    }

    fn mh_remove(ref self, key: i64) -> Result[(), String] {
        let p = self.mh_file(key);
        if not exists(p) {
            return Err(no_key(f"{key}"));
        }
        remove_file(p)
    }

    fn mh_get_bytes(ref self, key: i64) -> Result[String, String] {
        let p = self.mh_file(key);
        if not exists(p) {
            return Err(no_key(f"{key}"));
        }
        read_file(p)
    }

    fn mh_get_message(ref self, key: i64) -> Result[MMsg, String] {
        let t = self.mh_get_bytes(key)?;
        let mut mm = new_mmsg(Kind.Mh, message_from_string(t));
        for (name, kl) in self.get_sequences()?.iter() {
            if kl.contains(key) {
                mm.add_sequence(name);
            }
        }
        Ok(mm)
    }

    fn pack(ref self) -> Result[(), String] {
        let mut seqs = self.get_sequences()?;
        let mut prev = 0;
        let mut changes: Vec[(i64, i64)] = Vec.new();
        for key in self.mh_keys()?.iter() {
            if *key - 1 != prev {
                changes.push((*key, prev + 1));
                link_move(self.mh_file(*key), self.mh_file(prev + 1))?;
            }
            prev += 1;
        }
        if changes.is_empty() {
            return Ok(());
        }
        for i in 0..seqs.len() {
            let (name, kl) = seqs[i].clone();
            let mut kl2 = kl.clone();
            for (old, new) in changes.iter() {
                if let Some(at) = kl2.iter().position(|k| *k == old) {
                    kl2[at] = new;
                }
            }
            seqs[i] = (name, kl2);
        }
        self.set_sequences(seqs)
    }

    // ---- Maildir
    fn md_toc(ref self) -> Result[Vec[(String, String)], String] {
        let mut toc: Vec[(String, String)] = Vec.new();
        for sub in vec!["cur", "new"].iter() {
            let dir = join(self.path, sub.to_string());
            for entry in listdir(dir)?.iter() {
                if entry.starts_with(".") or is_dir(join(dir, entry)) {
                    continue;
                }
                let uniq = split_on(entry, ":")[0].clone();
                let sp = f"{sub}/{entry}";
                let mut found = false;
                for i in 0..toc.len() {
                    if toc[i].0 == uniq {
                        toc[i] = (uniq.clone(), sp.clone());
                        found = true;
                    }
                }
                if not found {
                    toc.push((uniq, sp));
                }
            }
        }
        Ok(toc)
    }

    fn md_lookup(ref self, key: ref String) -> Result[String, String] {
        for (k, sp) in self.md_toc()?.iter() {
            if k == key {
                return Ok(sp.clone());
            }
        }
        Err(no_key(key))
    }

    fn md_keys(ref self) -> Result[Vec[String], String] {
        let mut ks: Vec[String] = self.md_toc()?.iter().map(|t| t.0.clone()).collect();
        ks.sort();
        Ok(ks)
    }

    fn md_get_message(ref self, key: ref String) -> Result[MMsg, String] {
        let sp = self.md_lookup(key)?;
        let t = read_file(join(self.path, sp))?;
        let mut mm = new_mmsg(Kind.Maildir, message_from_string(t));
        mm.set_subdir(dirname(sp))?;
        let name = basename(sp);
        if find_char(name, ':') >= 0 {
            let parts = split_on(name, ":");
            mm.info = parts[parts.len() - 1].clone();
        }
        Ok(mm)
    }

    fn md_get_bytes(ref self, key: ref String) -> Result[String, String] {
        let sp = self.md_lookup(key)?;
        read_file(join(self.path, sp))
    }

    fn md_get_info(ref self, key: ref String) -> Result[String, String] {
        let sp = self.md_lookup(key)?;
        if find_char(sp, ':') >= 0 {
            let parts = split_on(sp, ":");
            return Ok(parts[parts.len() - 1].clone());
        }
        Ok(String.new())
    }

    fn md_set_info(ref self, key: ref String, info: ref String) -> Result[(), String] {
        let old = self.md_lookup(key)?;
        let mut new = split_on(old, ":")[0].clone();
        if not info.is_empty() {
            new = f"{new}:{info}";
        }
        if new == old {
            return Ok(());
        }
        rename(join(self.path, old), join(self.path, new))
    }

    fn md_box_flags(ref self, key: ref String) -> Result[String, String] {
        let info = self.md_get_info(key)?;
        if info.starts_with("2,") {
            return Ok(from_index(info, 2));
        }
        Ok(String.new())
    }

    fn md_box_set_flags(ref self, key: ref String, flags: ref String) -> Result[(), String] {
        self.md_set_info(key, f"2,{sorted_text(char_set(flags))}")
    }

    fn md_box_add_flag(ref self, key: ref String, flag: ref String) -> Result[(), String] {
        let f = union_chars(self.md_box_flags(key)?, flag);
        self.md_box_set_flags(key, f)
    }

    fn md_box_remove_flag(ref self, key: ref String, flag: ref String) -> Result[(), String] {
        let cur = self.md_box_flags(key)?;
        if not cur.is_empty() {
            self.md_box_set_flags(key, minus_chars(cur, flag))?;
        }
        Ok(())
    }

    fn md_add(mut ref self, input: ref Input) -> Result[String, String] {
        let uniq = f"1760999999.M{self.count}P1Q{self.count}.kara";
        self.count += 1;
        let tmp = join(join(self.path, "tmp".to_string()), uniq);
        create_new(tmp)?;
        write_file(tmp, dump_message(input, false, false)?)?;
        let mut subdir = "new".to_string();
        let mut suffix = String.new();
        if let Input.Msg(mm) = input {
            if let Kind.Maildir = mm.kind {
                subdir = mm.subdir.clone();
                if not mm.info.is_empty() {
                    suffix = f":{mm.info}";
                }
            }
        }
        let dest = join(join(self.path, subdir), f"{uniq}{suffix}");
        link_move(tmp, dest)?;
        Ok(uniq)
    }

    fn md_remove(ref self, key: ref String) -> Result[(), String] {
        let sp = self.md_lookup(key)?;
        remove_file(join(self.path, sp))
    }

    fn md_set(mut ref self, key: ref String, input: ref Input) -> Result[(), String] {
        let old = self.md_lookup(key)?;
        let temp_key = self.md_add(input)?;
        let temp = self.md_lookup(temp_key)?;
        let is_md = match input {
            Input.Msg(mm) => match mm.kind {
                Kind.Maildir => true,
                _ => false,
            },
            _ => false,
        };
        let dominant = if is_md { temp.clone() } else { old.clone() };
        let subdir = dirname(dominant);
        let suffix = if find_char(dominant, ':') >= 0 {
            let parts = split_on(dominant, ":");
            f":{parts[parts.len() - 1]}"
        } else {
            String.new()
        };
        let _ = self.md_remove(key);
        rename(join(self.path, temp), join(join(self.path, subdir), f"{key}{suffix}"))
    }

    // ---- the Mailbox interface, by kind
    fn keys(ref self) -> Result[Vec[String], String] {
        match self.kind {
            BoxKind.Mh => Ok(self.mh_keys()?.iter().map(|k| f"{k}").collect()),
            BoxKind.Maildir => self.md_keys(),
            _ => {
                let mut b = self.clone();
                b.ensure_toc();
                Ok(b.toc.iter().map(|t| f"{t.0}").collect())
            }
        }
    }

    fn key_repr(ref self, k: ref String) -> String {
        match self.kind {
            BoxKind.Maildir => repr_str(k),
            _ => k.clone(),
        }
    }

    fn keys_repr(ref self) -> Result[String, String] {
        let items: Vec[String] = self.keys()?.iter().map(|k| self.key_repr(k)).collect();
        Ok(f"[{items.join(", ")}]")
    }

    fn get_message(mut ref self, key: ref String) -> Result[MMsg, String] {
        match self.kind {
            BoxKind.Mh => self.mh_get_message(int_key(key)),
            BoxKind.Maildir => self.md_get_message(key),
            _ => self.sf_get_message(int_key(key)),
        }
    }

    fn get_bytes(mut ref self, key: ref String, with_from: bool) -> Result[String, String] {
        match self.kind {
            BoxKind.Mh => self.mh_get_bytes(int_key(key)),
            BoxKind.Maildir => self.md_get_bytes(key),
            _ => self.sf_get_bytes(int_key(key), with_from),
        }
    }

    fn get_string(mut ref self, key: ref String, with_from: bool) -> Result[String, String] {
        let b = self.get_bytes(key, with_from)?;
        let m = message_from_string(b);
        let mut out = String.new();
        if with_from {
            let u = m.unixfrom.clone().unwrap_or(f"From nobody {now_text()}");
            out.push_str(f"{u}\n");
        }
        out.push_str(as_string(m)?);
        Ok(out)
    }

    fn contains_key(mut ref self, key: ref String) -> Result[bool, String] {
        match self.kind {
            BoxKind.Mh => Ok(exists(self.mh_file(int_key(key)))),
            BoxKind.Maildir => Ok(self.md_toc()?.iter().any(|t| t.0 == *key)),
            _ => {
                self.ensure_toc();
                let k = int_key(key);
                Ok(self.toc.iter().any(|t| t.0 == k))
            }
        }
    }

    fn size(mut ref self) -> Result[i64, String] {
        Ok(self.keys()?.len())
    }

    fn add(mut ref self, input: ref Input) -> Result[String, String] {
        match self.kind {
            BoxKind.Mh => Ok(f"{self.mh_add(input)?}"),
            BoxKind.Maildir => self.md_add(input),
            _ => Ok(f"{self.sf_add(input)?}"),
        }
    }

    fn set(mut ref self, key: ref String, input: ref Input) -> Result[(), String] {
        match self.kind {
            BoxKind.Mh => self.mh_set(int_key(key), input),
            BoxKind.Maildir => self.md_set(key, input),
            _ => self.sf_set(int_key(key), input),
        }
    }

    fn remove(mut ref self, key: ref String) -> Result[(), String] {
        match self.kind {
            BoxKind.Mh => self.mh_remove(int_key(key)),
            BoxKind.Maildir => self.md_remove(key),
            _ => self.sf_remove(int_key(key)),
        }
    }

    // ---- folders
    fn list_folders(ref self) -> Result[Vec[String], String] {
        let mut out: Vec[String] = Vec.new();
        for n in listdir(self.path)?.iter() {
            let full = join(self.path, n);
            match self.kind {
                BoxKind.Maildir => {
                    if width(n) > 1 and n.starts_with(".") and is_dir(full) {
                        out.push(from_index(n, 1));
                    }
                }
                _ => {
                    if is_dir(full) {
                        out.push(n.clone());
                    }
                }
            }
        }
        out.sort();
        Ok(out)
    }

    fn folder_path(ref self, name: ref String) -> String {
        match self.kind {
            BoxKind.Maildir => join(self.path, f".{name}"),
            _ => join(self.path, name),
        }
    }

    fn get_folder(ref self, name: ref String) -> Result[Box, String] {
        open_box(self.kind.clone(), self.folder_path(name), false)
    }

    fn add_folder(ref self, name: ref String) -> Result[Box, String] {
        let p = self.folder_path(name);
        let b = open_box(self.kind.clone(), p, true)?;
        if let BoxKind.Maildir = self.kind {
            let mf = join(p, "maildirfolder".to_string());
            if not exists(mf) {
                write_file(mf, String.new())?;
            }
        }
        Ok(b)
    }

    fn remove_folder(ref self, name: ref String) -> Result[(), String] {
        let p = self.folder_path(name);
        if let BoxKind.Maildir = self.kind {
            let mut entries = listdir(join(p, "new".to_string()))?;
            for e in listdir(join(p, "cur".to_string()))?.iter() {
                entries.push(e.clone());
            }
            for e in entries.iter() {
                if e.is_empty() or not e.starts_with(".") {
                    return Err(f"NotEmptyError: Folder contains message(s): {name}");
                }
            }
            for e in listdir(p)?.iter() {
                if e != "new" and e != "cur" and e != "tmp" and is_dir(join(p, e)) {
                    return Err(f"NotEmptyError: Folder contains subdirectory '{name}': {e}");
                }
            }
            return remove_tree(p);
        }
        let entries = listdir(p)?;
        if entries.len() == 1 and entries[0] == ".mh_sequences" {
            remove_file(join(p, ".mh_sequences".to_string()))?;
        } else if not entries.is_empty() {
            return Err(f"NotEmptyError: Folder not empty: {shown(self.path)}");
        }
        rmdir(p)
    }
}

fn int_key(k: ref String) -> i64 {
    py_int(k).unwrap_or(-1)
}

// Mailbox._dump_message: a Message through BytesGenerator(mangle_from_, 0),
// raw bytes with "\nFrom " quoted when mangling.
fn dump_message(input: ref Input, mangle: bool, append_nl: bool) -> Result[String, String] {
    let mut data = match input {
        Input.Msg(mm) => {
            let g = Gen { mangle: mangle, maxlen: 0 };
            g.flatten(mm.m)?
        }
        Input.Raw(s) => if mangle { s.replace("\nFrom ", "\n>From ") } else { s.clone() },
    };
    if append_nl and not data.ends_with("\n") {
        data.push('\n');
    }
    Ok(data)
}

// The first line of v from pos, as BytesIO.readline gives it.
fn take_line(v: ref Vec[char], pos: mut ref i64) -> String {
    let (line, np) = readline(v, *pos);
    *pos = np;
    line
}

// Babyl._install_message, without the offsets.
fn babyl_install(input: ref Input, w: mut ref String) -> Result[(), String] {
    match input {
        Input.Msg(mm) => {
            if let Kind.Babyl = mm.kind {
                let mut special: Vec[Label] = Vec.new();
                let mut user: Vec[Label] = Vec.new();
                for l in mm.labels.iter() {
                    if special_label(l) {
                        special.push(l.clone());
                    } else {
                        user.push(l.clone());
                    }
                }
                w.push('1');
                for l in special.iter() {
                    if let Label.Str(s) = l {
                        w.push_str(f", {s}");
                    }
                }
                w.push_str(",,");
                for l in user.iter() {
                    match l {
                        Label.Str(s) => w.push_str(f" {s},"),
                        Label.Bytes(_) => return Err("AttributeError: 'bytes' object has no attribute 'encode'".to_string()),
                    }
                }
                w.push('\n');
            } else {
                w.push_str("1,,\n");
            }
            let g = Gen { mangle: false, maxlen: 0 };
            let orig = chars(g.flatten(mm.m)?);
            let mut pos = 0;
            loop {
                let line = take_line(orig, mut pos);
                w.push_str(line);
                if line == "\n" or line.is_empty() {
                    break;
                }
            }
            w.push_str("*** EOOH ***\n");
            if let Kind.Babyl = mm.kind {
                // The visible headers go to a buffer that is never rewound,
                // so nothing of them is written.
                let _ = g.flatten(mm.visible)?;
            } else {
                pos = 0;
                loop {
                    let line = take_line(orig, mut pos);
                    w.push_str(line);
                    if line == "\n" or line.is_empty() {
                        break;
                    }
                }
            }
            w.push_str(text(slice(orig, pos, orig.len())));
        }
        Input.Raw(s) => {
            w.push_str("1,,\n");
            let v = chars(s);
            let i = find_in(v, "\n\n", 0, v.len());
            if i >= 0 {
                let head = text(slice(v, 0, i + 2));
                w.push_str(head);
                w.push_str("*** EOOH ***\n");
                w.push_str(head);
                w.push_str(text(slice(v, i + 2, v.len())));
            } else {
                w.push_str("*** EOOH ***\n\n");
                w.push_str(s);
            }
        }
    }
    Ok(())
}
// ------------------------------------------------------------ the jobs

fn subject_of(m: ref Message) -> Result[String, String] {
    match m.get("Subject".to_string()) {
        None => Ok("-".to_string()),
        Some(s) => header_str(s),
    }
}

fn describe(mm: ref MMsg) {
    println(f"  {mm.state()}");
    println(f"  unixfrom {opt_repr(mm.m.unixfrom)}");
    println(f"  headers {mm.m.items_repr()}");
    if mm.m.is_multipart() {
        let cts: Vec[String] = mm.m.walk().iter().map(|p| repr_str(p.get_content_type())).collect();
        println(f"  parts [{cts.join(", ")}]");
    } else {
        let body = match mm.m.payload {
            Payload.Text(t) => repr_str(t),
            _ => "None".to_string(),
        };
        println(f"  body {body}");
    }
}

// Lines end at "\n" only.
fn show_lines(t: ref String) {
    let v = chars(t);
    let mut pos = 0;
    while pos < v.len() {
        let line = take_line(v, mut pos);
        println(f"    | {repr_str(line)}");
    }
}

fn seqs_repr(seqs: ref Vec[(String, Vec[i64])]) -> String {
    let items: Vec[String] = seqs.iter().map(|t| {
        let ks: Vec[String] = t.1.iter().map(|k| f"{k}").collect();
        f"{repr_str(t.0)}: [{ks.join(", ")}]"
    }).collect();
    f"{{{items.join(", ")}}}"
}

fn str_list_repr(v: ref Vec[String]) -> String {
    let items: Vec[String] = v.iter().map(|s| repr_str(s)).collect();
    f"[{items.join(", ")}]"
}

fn parse_seqs(spec: ref String) -> Vec[(String, Vec[i64])] {
    let mut out: Vec[(String, Vec[i64])] = Vec.new();
    if spec == "-" {
        return out;
    }
    for part in spec.split(";") {
        let nv = split_on(part.to_string(), "=");
        let mut ks: Vec[i64] = Vec.new();
        for k in nv[1].split(",") {
            if not k.is_empty() {
                ks.push(py_int(k.to_string()).unwrap_or(0));
            }
        }
        out.push((nv[0].clone(), ks));
    }
    out
}

fn envelope_from(m: ref Message) -> Result[String, String] {
    let (_, a) = parseaddr(m.get("From".to_string()).unwrap_or(String.new()), true);
    let addr = if a.is_empty() { "MAILER-DAEMON".to_string() } else { a };
    match parsedate_tz(m.get("Date".to_string()).unwrap_or(String.new())) {
        None => Ok(f"{addr} Thu Jan  1 00:00:00 1970"),
        Some(t) => Ok(f"{addr} {asctime_gm(mktime_tz(t)?)}"),
    }
}

fn convert(kind: ref String, mm: ref MMsg, redate: bool) -> Result[MMsg, String] {
    let mut c = convert_msg(kind_of(kind), mm)?;
    if redate and kind_is_mboxish(c.kind) {
        c.from_ = envelope_from(mm.m)?;
    }
    Ok(c)
}

fn unread(mm: ref MMsg) -> bool {
    match mm.kind {
        Kind.Mbox | Kind.Mmdf => not mm.mb_flags().contains("R"),
        Kind.Maildir => not mm.md_flags().contains("S"),
        Kind.Mh => mm.seqs.contains("unseen".to_string()),
        Kind.Babyl => has_label(mm.labels, "unseen"),
        Kind.Plain => false,
    }
}

fn text_of(m: ref Message) -> String {
    for p in m.walk().iter() {
        if p.get_content_type() == "text/plain" {
            let mut q = p.clone();
            let b = q.get_payload_decoded().unwrap_or(Vec.new());
            return decode_bytes(b, Codec.Ascii, true).unwrap_or(String.new());
        }
    }
    String.new()
}

fn pad_right(s: ref String, n: i64) -> String {
    let mut out = s.clone();
    let mut w = width(s);
    while w < n {
        out.push(' ');
        w += 1;
    }
    out
}

fn pad_left(s: ref String, n: i64) -> String {
    let mut out = String.new();
    let mut w = width(s);
    while w < n {
        out.push(' ');
        w += 1;
    }
    out.push_str(s);
    out
}

fn box_kind(name: ref String) -> BoxKind {
    if name == "mbox" {
        return BoxKind.Mbox;
    }
    if name == "mmdf" {
        return BoxKind.Mmdf;
    }
    if name == "babyl" {
        return BoxKind.Babyl;
    }
    if name == "mh" {
        return BoxKind.Mh;
    }
    BoxKind.Maildir
}

fn dpath(p: ref String) -> String {
    f"data/{p}"
}

struct Jobs {
    names: Vec[String],
    boxes: Vec[Box],
}

impl Jobs {
    fn find(ref self, name: ref String) -> Result[i64, String] {
        for i in 0..self.names.len() {
            if self.names[i] == *name {
                return Ok(i);
            }
        }
        Err(f"KeyError: {repr_str(name)}")
    }

    fn put(mut ref self, name: ref String, b: own Box) {
        for i in 0..self.names.len() {
            if self.names[i] == *name {
                self.boxes[i] = b;
                return;
            }
        }
        self.names.push(name.clone());
        self.boxes.push(b);
    }

    fn take(mut ref self, name: ref String) -> Result[Box, String] {
        let i = self.find(name)?;
        self.names.remove(i);
        Ok(self.boxes.remove(i))
    }

    fn op(mut ref self, a: ref Vec[String]) -> Result[(), String] {
        let name = a[0].clone();
        if name == "copy" {
            let d = dpath(a[2]);
            make_dirs(dirname(d))?;
            return copy_path(dpath(a[1]), d);
        }
        if name == "rmfile" {
            return remove_file(dpath(a[1]));
        }
        if name == "open" {
            let create = a.len() < 5 or a[4] != "nocreate";
            let b = open_box(box_kind(a[2]), dpath(a[3]), create)?;
            self.put(a[1], b);
            println(f"  opened {a[1]}");
            return Ok(());
        }
        if name == "file" {
            show_lines(read_file(dpath(a[1]))?);
            return Ok(());
        }
        if name == "tree" {
            for t in tree(dpath(a[1]))?.iter() {
                println(f"    {t}");
            }
            return Ok(());
        }
        if name == "date" {
            let line = match parsedate_tz(a[1]) {
                None => f"  date {repr_str(a[1])}: None",
                Some(t) => {
                    let ts = mktime_tz(t)?;
                    f"  date {repr_str(a[1])}: {date_tuple_repr(t)} -> {ts} {asctime_gm(ts)}"
                }
            };
            println(line);
            return Ok(());
        }
        if name == "unread" {
            let mut total = 0;
            for n in a[1..a.len()].iter() {
                let i = self.find(n)?;
                let mut c = 0;
                let keys = self.boxes[i].keys()?;
                for k in keys.iter() {
                    if unread(self.boxes[i].get_message(k)?) {
                        c += 1;
                    }
                }
                total += c;
                println(f"  {n}: {c} unread of {keys.len()}");
            }
            println(f"  total {total}");
            return Ok(());
        }
        if name == "search" {
            let needle = a[a.len() - 1].to_lowercase();
            for n in a[1..a.len() - 1].iter() {
                let i = self.find(n)?;
                let keys = self.boxes[i].keys()?;
                for k in keys.iter() {
                    let mm = self.boxes[i].get_message(k)?;
                    let s = subject_of(mm.m)?;
                    if s.to_lowercase().contains(needle.as_str()) or text_of(mm.m).to_lowercase().contains(needle.as_str()) {
                        println(f"  {n} {self.boxes[i].key_repr(k)}: {s}");
                    }
                }
            }
            return Ok(());
        }
        if name == "dedupe" {
            let i = self.find(a[1])?;
            let mut seen: Vec[Option[String]] = Vec.new();
            for k in self.boxes[i].keys()?.iter() {
                let mid = self.boxes[i].get_message(k)?.m.get("Message-ID".to_string());
                if not seen.contains(mid.clone()) {
                    seen.push(mid);
                }
            }
            let j = self.find(a[2])?;
            for k in self.boxes[j].keys()?.iter() {
                let mid = self.boxes[j].get_message(k)?.m.get("Message-ID".to_string());
                if seen.contains(mid.clone()) {
                    self.boxes[j].remove(k)?;
                    println(f"  dropped {self.boxes[j].key_repr(k)} {mid.clone().unwrap_or("None".to_string())}");
                } else {
                    seen.push(mid);
                }
            }
            return Ok(());
        }
        if name == "archive" {
            let i = self.find(a[1])?;
            let j = self.find(a[2])?;
            let ymd = split_on(a[3], "-");
            let cutoff = days_from_civil(py_int(ymd[0]).unwrap_or(0), py_int(ymd[1]).unwrap_or(0), py_int(ymd[2]).unwrap_or(0)) * 86400;
            for k in self.boxes[i].keys()?.iter() {
                let mm = self.boxes[i].get_message(k)?;
                if let Some(t) = parsedate_tz(mm.m.get("Date".to_string()).unwrap_or(String.new())) {
                    if mktime_tz(t)? < cutoff {
                        let c = convert(a[4], mm, false)?;
                        let nk = self.boxes[j].add(Input.Msg(c))?;
                        self.boxes[i].remove(k)?;
                        println(f"  archived {self.boxes[i].key_repr(k)} as {nk}: {subject_of(mm.m)?}");
                    }
                }
            }
            return Ok(());
        }
        if name == "digest" {
            let i = self.find(a[1])?;
            for k in self.boxes[i].keys()?.iter() {
                let mm = self.boxes[i].get_message(k)?;
                let when = match parsedate_tz(mm.m.get("Date".to_string()).unwrap_or(String.new())) {
                    None => "-".to_string(),
                    Some(t) => asctime_gm(mktime_tz(t)?),
                };
                let (_, addr) = parseaddr(mm.m.get("From".to_string()).unwrap_or(String.new()), true);
                println(f"  {pad_left(self.boxes[i].key_repr(k), 3)} {when}  {pad_right(addr, 28)} {subject_of(mm.m)?}");
            }
            return Ok(());
        }
        if name == "convert" or name == "move" {
            let i = self.find(a[1])?;
            let mm = self.boxes[i].get_message(a[2])?;
            let kind = if name == "convert" { a[3].clone() } else { a[4].clone() };
            let c = convert(kind, mm, a[a.len() - 1] == "redate")?;
            if name == "move" {
                let j = self.find(a[3])?;
                let k = self.boxes[j].add(Input.Msg(c.clone()))?;
                let shown_key = match self.boxes[j].kind {
                    BoxKind.Maildir => "<new>".to_string(),
                    _ => k,
                };
                println(f"  added {shown_key}");
            }
            describe(c);
            return Ok(());
        }
        if name == "close" {
            let mut b = self.take(a[1])?;
            b.flush()?;
            println(f"  closed {a[1]}");
            return Ok(());
        }
        let i = self.find(a[1])?;
        let mut b = self.boxes[i].clone();
        let r = box_op(mut b, a);
        self.boxes[i] = b;
        if let Some(nb) = r? {
            self.put(a[3], nb);
        }
        Ok(())
    }
}

// The jobs on one mailbox; a folder job gives back the folder.
fn box_op(b: mut ref Box, a: ref Vec[String]) -> Result[Option[Box], String] {
    let name = a[0].clone();
    if name == "keys" {
        println(f"  keys {b.keys_repr()?}");
    } else if name == "len" {
        println(f"  len {b.size()?}");
    } else if name == "has" {
        println(f"  has {a[2]} {if b.contains_key(a[2])? { "True" } else { "False" }}");
    } else if name == "get" {
        describe(b.get_message(a[2])?);
    } else if name == "bytes" {
        show_lines(b.get_bytes(a[2], a.len() > 3)?);
    } else if name == "string" {
        show_lines(b.get_string(a[2], a.len() > 3)?);
    } else if name == "summary" {
        for k in b.keys()?.iter() {
            let mm = b.get_message(k)?;
            println(f"  {b.key_repr(k)}: {repr_str(subject_of(mm.m)?)} | {mm.state()}");
        }
    } else if name == "flag" or name == "label" or name == "seq" {
        let mut mm = b.get_message(a[2])?;
        if name == "flag" {
            if a[3] == "set" {
                mm.set_flags(a[4])?;
            } else if a[3] == "add" {
                mm.add_flag(a[4])?;
            } else {
                mm.remove_flag(a[4])?;
            }
        } else if name == "label" {
            if a[3] == "add" {
                mm.add_label(Label.Str(a[4].clone()))?;
            } else {
                mm.remove_label(Label.Str(a[4].clone()));
            }
        } else if a[3] == "add" {
            mm.add_sequence(a[4]);
        } else {
            mm.remove_sequence(a[4]);
        }
        b.set(a[2], Input.Msg(mm.clone()))?;
        println(f"  {b.key_repr(a[2])} now {mm.state()}");
    } else if name == "remove" {
        b.remove(a[2])?;
        println(f"  removed {a[2]}");
    } else if name == "discard" {
        let _ = b.remove(a[2]);
        println(f"  discarded {a[2]}");
    } else if name == "flush" {
        b.flush()?;
        println(f"  flushed {a[1]}");
    } else if name == "add" {
        let raw = read_file(dpath(a[2]))?;
        let k = b.add(Input.Raw(raw))?;
        let shown_key = match b.kind {
            BoxKind.Maildir => "<new>".to_string(),
            _ => k,
        };
        println(f"  added {shown_key}");
    } else if name == "replace" {
        let raw = read_file(dpath(a[3]))?;
        b.set(a[2], Input.Raw(raw))?;
        println(f"  replaced {a[2]}");
    } else if name == "seqs" {
        println(f"  sequences {seqs_repr(b.get_sequences()?)}");
    } else if name == "setseqs" {
        b.set_sequences(parse_seqs(a[2]))?;
        println("  sequences set");
    } else if name == "pack" {
        b.pack()?;
        println("  packed");
    } else if name == "folders" {
        println(f"  folders {str_list_repr(b.list_folders()?)}");
    } else if name == "folder" or name == "addfolder" {
        let nb = if name == "folder" { b.get_folder(a[2])? } else { b.add_folder(a[2])? };
        println(f"  opened {a[3]}");
        return Ok(Some(nb));
    } else if name == "rmfolder" {
        b.remove_folder(a[2])?;
        println(f"  removed folder {a[2]}");
    } else if name == "info" {
        let info = b.md_get_info(a[2])?;
        let flags = b.md_box_flags(a[2])?;
        println(f"  info {repr_str(info)} flags {repr_str(flags)}");
    } else if name == "setinfo" {
        let info = if a.len() > 3 { a[3].clone() } else { String.new() };
        b.md_set_info(a[2], info)?;
        println("  info set");
    } else if name == "set_flags" {
        b.md_box_set_flags(a[2], a[3])?;
        println("  set_flags done");
    } else if name == "add_flag" {
        b.md_box_add_flag(a[2], a[3])?;
        println("  add_flag done");
    } else if name == "remove_flag" {
        b.md_box_remove_flag(a[2], a[3])?;
        println("  remove_flag done");
    } else if name == "labels" {
        let mut items: Vec[String] = b.get_labels().iter().map(|l| label_repr(l)).collect();
        items.sort();
        println(f"  labels [{items.join(", ")}]");
    } else {
        return Err(f"AssertionError: {name}");
    }
    Ok(None)
}

fn run() -> Result[(), String] {
    let t = read_file("data/jobs.tsv".to_string())?;
    let mut jobs = Jobs { names: Vec.new(), boxes: Vec.new() };
    for line in t.lines() {
        if line.is_empty() or line.starts_with("#") {
            continue;
        }
        let a = split_on(line.to_string(), "\t");
        if a[0] == "job" {
            println(f"== {a[1]}");
            jobs = Jobs { names: Vec.new(), boxes: Vec.new() };
            continue;
        }
        if let Err(e) = jobs.op(a) {
            println(f"  error: {e}");
        }
    }
    Ok(())
}

struct DataFile {
    path: String,
    body: String,
}

fn write_data() -> Result[(), String] {
    for file in data_files() {
        let p = dpath(file.path);
        make_dirs(dirname(p))?;
        write_file(p, file.body)?;
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    if let Err(e) = run() {
        eprintln(e);
    }
}
// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    data_part_3(mut v);
    v
}

