== create, set, get and reopen
open('notes', 'n')
db['greeting'] = 'hello'
db[b'bytes-key'] = b'\x00\x01\xff'
db['color'] = 'green'
db['greeting'] = b'hello'
db[b'bytes-key'] = b'\x00\x01\xff'
db['missing'] -> KeyError: b'missing'
'color' in db = True
b'color' in db = True
'nope' in db = False
len(db) = 3
db.keys() = [b'greeting', b'bytes-key', b'color']
db.items() = [(b'greeting', b'hello'), (b'bytes-key', b'\x00\x01\xff'), (b'color', b'green')]
