  notes.bak: missing
db.close()
files notes:
  notes.dir: 3 lines
    'greeting', (0, 5)
    'bytes-key', (512, 3)
    'color', (1024, 5)
  notes.dat: 1029 bytes
  notes.bak: 3 lines
open('notes', 'c')
db.keys() = [b'greeting', b'bytes-key', b'color']
db['color'] = b'green'
db.close()
