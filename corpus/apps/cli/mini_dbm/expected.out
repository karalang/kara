== flags and errors
open('absent', 'r') -> FileNotFoundError: [Errno 2] No such file or directory: b'data/db/absent.dat'
open('absent', 'w') -> FileNotFoundError: [Errno 2] No such file or directory: b'data/db/absent.dat'
open('absent', 'x') -> ValueError: Flag must be one of 'r', 'w', 'c', or 'n'
open('ro', 'n')
db['k'] = 'v'
db.close()
open('ro', 'r')
db['k'] = b'v'
db['k'] = 'w' -> OSError: The database is opened for reading only
del db['k'] -> OSError: The database is opened for reading only
db[5] = 'v' -> OSError: The database is opened for reading only
db.close()
open('ro', 'w')
db['k'] = 'w'
db['num'] = 7 -> TypeError: values must be bytes or strings
db[5] = 'v' -> TypeError: keys must be bytes or strings
db[5] -> KeyError: 5
del db['nope'] -> KeyError: b'nope'
db.close()
db['k'] -> OSError: DBM object has already been closed
db['k'] = 'v' -> OSError: DBM object has already been closed
len(db) -> OSError: DBM object has already been closed
db.keys() -> OSError: DBM object has already been closed
'k' in db -> OSError: DBM object has already been closed
db.close()
open('ro', 'c')
db.items() = [(b'k', b'w')]
db.close()
== hand-made index files
open('handmade', 'r')
db.keys() = [b'alpha', b'beta', b'gamma', b'tab\tkey', b"it's", b'caf\xc3\xa9', b'octAl', b'trailing']
db.items() = [(b'alpha', b'hello'), (b'beta', b'beta'), (b'gamma', b'ccc'), (b'tab\tkey', b'TT'), (b"it's", b'Q'), (b'caf\xc3\xa9', b'XYZ'), (b'octAl', b'OK'), (b'trailing', b'last')]
len(db) = 8
db.close()
open('euro', 'r') -> UnicodeEncodeError: 'latin-1' codec can't encode character '\u20ac' in position 0: ordinal not in range(256)
open('triple', 'r') -> ValueError: too many values to unpack (expected 2)
open('damaged', 'r')
db['past-end'] = b'tail'
db['misaligned'] = b'MISA'
db['overlap-b'] = b'AAAAAAAAAA'
db['empty'] = b''
db.close()
== the n flag starts over
open('fresh', 'n')
db['x'] = '1'
db.close()
open('fresh', 'c')
db['y'] = '2'
db.close()
