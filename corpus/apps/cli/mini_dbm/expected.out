== keys that are not ASCII
open('intl', 'n')
db['café'] = 'coffee'
db['日本'] = 'japan'
db[b'\xe9t\xe9'] = 'latin-1 bytes'
db[b'new\nline'] = 'nl'
db[b'\x7f\x80\xa0\xad'] = 'controls'
db["it's"] = 'quote'
db['say "hi"'] = 'double'
db['both \' and "'] = 'mixed'
db.keys() = [b'caf\xc3\xa9', b'\xe6\x97\xa5\xe6\x9c\xac', b'\xe9t\xe9', b'new\nline', b'\x7f\x80\xa0\xad', b"it's", b'say "hi"', b'both \' and "']
db['café'] = b'coffee'
db[b'caf\xc3\xa9'] = b'coffee'
db.close()
