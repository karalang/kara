fn data_part_1(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("# time, then what happens: login <sid> <user>, touch <sid>, logout <sid>, sweep\n");
    t.push_str("100 login s-7f3a alice\n");
    t.push_str("105 login s-91bc bob\n");
    t.push_str("110 login s-02de carol\n");
    t.push_str("130 touch s-7f3a\n");
    t.push_str("160 logout s-91bc\n");
    t.push_str("200 login s-55aa dave\n");
    t.push_str("700 sweep\n");
    t.push_str("760 touch s-02de\n");
    t.push_str("900 login s-c0de erin\n");
    t.push_str("1300 sweep\n");
    t.push_str("1305 touch s-7f3a\n");
    t.push_str("2500 sweep\n");
    v.push(DataFile { path: "sessions/events.txt".to_string(), body: t });
    let mut t = String.new();
    t.push_str("# long URLs to shorten, in the order they are submitted\n");
    t.push_str("https://docs.python.org/3/library/dbm.html#module-dbm.dumb\n");
    t.push_str("https://en.wikipedia.org/wiki/DBM_(computing)\n");
    t.push_str("https://example.com/blog/2026/10/20/why-we-moved-off-a-dumb-database\n");
    t.push_str("https://docs.python.org/3/library/dbm.html#module-dbm.dumb\n");
    t.push_str("https://example.com/search?q=key+value+store&page=2\n");
    t.push_str("https://example.org/\n");
    t.push_str("https://example.com/a/very/long/path/that/keeps/going/and/going/until/it/is/longer/than/most/people/would/ever/type/by/hand/index.html\n");
    v.push(DataFile { path: "shortener/urls.txt".to_string(), body: t });
    let mut t = String.new();
    t.push_str("# short codes clicked, after a restart\n");
    t.push_str("1\n");
    t.push_str("2\n");
    t.push_str("4\n");
    t.push_str("zz\n");
    t.push_str("3\n");
    t.push_str("1\n");
    v.push(DataFile { path: "shortener/visits.txt".to_string(), body: t });
    let mut t = String.new();
    v.push(DataFile { path: "which/empty.dat".to_string(), body: t });
    let mut t = String.new();
    v.push(DataFile { path: "which/empty.dir".to_string(), body: t });
    let mut t = String.new();
    v.push(DataFile { path: "which/legacy.dir".to_string(), body: t });
    let mut t = String.new();
    v.push(DataFile { path: "which/legacy.pag".to_string(), body: t });
    let mut t = String.new();
    t.push_str("a");
    v.push(DataFile { path: "which/notdumb.dat".to_string(), body: t });
    let mut t = String.new();
    t.push_str("alpha, (0, 1)\n");
    v.push(DataFile { path: "which/notdumb.dir".to_string(), body: t });
    let mut t = String.new();
    t.push_str("ab");
    v.push(DataFile { path: "which/short".to_string(), body: t });
    let mut t = String.new();
    t.push_str("just some text, nothing magic about it\n");
    v.push(DataFile { path: "which/text.txt".to_string(), body: t });
}
