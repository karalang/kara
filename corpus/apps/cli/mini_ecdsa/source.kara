    0x19a4c116b8d2d0c8u64, 0x1e376c085141ab53u64, 0x2748774cdf8eeb99u64, 0x34b0bcb5e19b48a8u64,
    0x391c0cb3c5c95a63u64, 0x4ed8aa4ae3418acbu64, 0x5b9cca4f7763e373u64, 0x682e6ff3d6b2b8a3u64,
    0x748f82ee5defb2fcu64, 0x78a5636f43172f60u64, 0x84c87814a1f0ab72u64, 0x8cc702081a6439ecu64,
    0x90befffa23631e28u64, 0xa4506cebde82bde9u64, 0xbef9a3f7b2c67915u64, 0xc67178f2e372532bu64,
    0xca273eceea26619cu64, 0xd186b8c721c0c207u64, 0xeada7dd6cde0eb1eu64, 0xf57d4f7fee6ed178u64,
    0x06f067aa72176fbau64, 0x0a637dc5a2c898a6u64, 0x113f9804bef90daeu64, 0x1b710b35131c471bu64,
    0x28db77f523047d84u64, 0x32caab7b40c72493u64, 0x3c9ebe0a15c9bebcu64, 0x431d67c49c100d4cu64,
    0x4cc5d4becb3e42b6u64, 0x597f299cfc657e2au64, 0x5fcb6fab3ad6faecu64, 0x6c44198c4a475817u64,
];

const SHA512_IV: Array[u64, 8] = [
    0x6a09e667f3bcc908u64, 0xbb67ae8584caa73bu64, 0x3c6ef372fe94f82bu64, 0xa54ff53a5f1d36f1u64,
    0x510e527fade682d1u64, 0x9b05688c2b3e6c1fu64, 0x1f83d9abfb41bd6bu64, 0x5be0cd19137e2179u64,
];

const SHA384_IV: Array[u64, 8] = [
    0xcbbb9d5dc1059ed8u64, 0x629a292a367cd507u64, 0x9159015a3070dd17u64, 0x152fecd8f70e5939u64,
    0x67332667ffc00b31u64, 0x8eb44a8768581511u64, 0xdb0c2e0d64f98fa7u64, 0x47b5481dbefa4fa4u64,
];

// SHA-512, or SHA-384 with its own initial values and a shorter result.
fn sha512_family(msg: ref Vec[u8], is384: bool) -> Vec[u8] {
    let m = md_pad(msg, 128, 16, true);
    let mut h: Vec[u64] = Vec.new();
    for i in 0..8 {
        h.push(if is384 { SHA384_IV[i] } else { SHA512_IV[i] });
    }
    let mut w: Vec[u64] = Vec.new();
    for _ in 0..80 {
        w.push(0u64);
    }
    let mut blk: i64 = 0;
    while blk < m.len() {
        for t in 0..16 {
            w[t] = be64(m, blk + 8 * t);
        }
        for t in 16..80 {
            let s0 = w[t - 15].rotate_right(1) ^ w[t - 15].rotate_right(8) ^ (w[t - 15] >> 7u64);
            let s1 = w[t - 2].rotate_right(19) ^ w[t - 2].rotate_right(61) ^ (w[t - 2] >> 6u64);
            w[t] = w[t - 16].wrapping_add(s0).wrapping_add(w[t - 7]).wrapping_add(s1);
        }
        let mut v: Vec[u64] = h.clone();
        for t in 0..80 {
            let e = v[4];
            let a = v[0];
            let s1 = e.rotate_right(14) ^ e.rotate_right(18) ^ e.rotate_right(41);
            let ch = (e & v[5]) ^ ((e ^ 0xFFFFFFFFFFFFFFFFu64) & v[6]);
            let t1 = v[7].wrapping_add(s1).wrapping_add(ch).wrapping_add(SHA512_K[t]).wrapping_add(w[t]);
            let s0 = a.rotate_right(28) ^ a.rotate_right(34) ^ a.rotate_right(39);
            let maj = (a & v[1]) ^ (a & v[2]) ^ (v[1] & v[2]);
            let t2 = s0.wrapping_add(maj);
            v[7] = v[6];
            v[6] = v[5];
            v[5] = v[4];
            v[4] = v[3].wrapping_add(t1);
            v[3] = v[2];
            v[2] = v[1];
            v[1] = v[0];
            v[0] = t1.wrapping_add(t2);
        }
        for i in 0..8 {
            h[i] = h[i].wrapping_add(v[i]);
        }
        blk += 128;
    }
    let mut out: Vec[u8] = Vec.new();
    let n = if is384 { 6 } else { 8 };
    for i in 0..n {
        push_be64(mut out, h[i]);
    }
    out
}

// ------------------------------------------------------------ hex and base64

fn hex_of(b: ref Vec[u8]) -> String {
    let mut s = String.new();
    for x in b {
        s.push_str(f"{x:02x}");
    }
    s
}

const B64_ALPHABET: Str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

fn b64_encode(b: ref Vec[u8]) -> String {
    let alpha = to_bytes(B64_ALPHABET);
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let n = b.len() - i;
        let x0 = b[i] as i64;
        let x1 = if n > 1 { b[i + 1] as i64 } else { 0 };
        let x2 = if n > 2 { b[i + 2] as i64 } else { 0 };
        let v = (x0 << 16) | (x1 << 8) | x2;
        out.push(alpha[(v >> 18) & 63]);
        out.push(alpha[(v >> 12) & 63]);
        out.push(if n > 1 { alpha[(v >> 6) & 63] } else { b'=' });
        out.push(if n > 2 { alpha[v & 63] } else { b'=' });
        i += 3;
    }
    from_bytes(out)
}

fn b64_value(c: u8) -> i64 {
    if c >= b'A' and c <= b'Z' {
        (c - b'A') as i64
    } else if c >= b'a' and c <= b'z' {
        (c - b'a') as i64 + 26
    } else if c >= b'0' and c <= b'9' {
        (c - b'0') as i64 + 52
    } else if c == b'+' {
        62
    } else if c == b'/' {
        63
    } else {
        -1
    }
}

// A base64 digest of exactly nbytes, written canonically.
fn b64_digest(s: Str, nbytes: i64) -> Option[Vec[u8]] {
    let b = to_bytes(s);
    if b.len() != (nbytes + 2) / 3 * 4 {
        return None;
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let mut v: i64 = 0;
        let mut pads: i64 = 0;
        for k in 0..4 {
            let c = b[i + k];
            if c == b'=' {
                if i + 4 != b.len() {
                    return None;
                }
                pads += 1;
                v = v << 6;
            } else {
                let x = b64_value(c);
                if x < 0 or pads > 0 {
                    return None;
                }
                v = (v << 6) | x;
            }
        }
        out.push(((v >> 16) & 0xFF) as u8);
        if pads < 2 {
            out.push(((v >> 8) & 0xFF) as u8);
        }
        if pads < 1 {
            out.push((v & 0xFF) as u8);
        }
        i += 4;
    }
    if out.len() != nbytes or b64_encode(out) != s {
        return None;
    }
    Some(out)
}

fn hex_decode(s: Str) -> Vec[u8] {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn split_c(s: ref String, sep: char) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}
fn hex_bytes(s: ref String) -> Vec[u8] {
    let cs: Vec[char] = s.chars().collect();
    let n = cs.len() as i64;
    let mut out: Vec[u8] = Vec.new();
    let mut k: i64 = 0;
    while k < n {
        if cs[k] == 'z' {
            let mut j = k + 1;
            let mut count: i64 = 0;
            while cs[j] != '.' {
                count = count * 10 + (cs[j] as i64 - 48);
                j += 1;
            }
            let mut z: i64 = 0;
            while z < count {
                out.push(0);
                z += 1;
            }
            k = j + 1;
        } else {
            out.push((hex_digit(cs[k]) * 16 + hex_digit(cs[k + 1])) as u8);
            k += 2;
        }
    }
    out
}

fn hex_string(s: ref String) -> String {
    String.from_utf8(hex_bytes(s)).unwrap_or(String.new())
}

fn dirname_of(path: ref String) -> String {
    let cs = chars_of(path);
    let mut cut: i64 = -1;
    let mut k: i64 = 0;
    while k < cs.len() as i64 {
        if cs[k] == '/' {
            cut = k;
        }
        k += 1;
    }
    if cut < 0 { String.new() } else { chars_str(cs, 0, cut) }
}

fn write_inputs() -> Result[(), String] {
    let _ = fs.create_dir_all("data".to_string());
    for line in split_c(inputs_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_c(line, ' ');
        let path = f"data/{f[0]}";
        let _ = fs.create_dir_all(dirname_of(path));
        let bytes = if f.len() > 1 { hex_bytes(f[1]) } else { Vec.new() };
        if let Err(e) = fs.write_bytes(path, bytes) {
            return Err(f"cannot write {f[0]}: {e}");
        }
    }
    Ok(())
}

fn hex_digit(c: char) -> i64 {
    let n = c as i64;
    if n >= 97 { n - 87 } else if n >= 65 { n - 55 } else { n - 48 }
}
fn chars_of(s: ref String) -> Vec[char] {
    s.chars().collect()
}
fn chars_str(cs: ref Vec[char], a: i64, b: i64) -> String {
    let mut out = String.new();
    let mut k = a;
    while k < b {
        out.push(cs[k]);
        k += 1;
    }
    out
}
// ------------------------------------------------------------ big integers

// Python's int, for the non-negative values RSA works with: little-endian
// 64-bit limbs with no zero limb on top, so zero is the empty vector.
fn mask64() -> u128 {
    0xFFFFFFFFFFFFFFFFu128
}

fn bn_norm(a: mut ref Vec[u64]) {
    while a.len() > 0 and a[a.len() - 1] == 0u64 {
        let _ = a.pop();
    }
}

fn bn(v: i64) -> Vec[u64] {
    let mut out: Vec[u64] = Vec.new();
    if v > 0 {
        out.push(v as u64);
    }
    out
}

fn bn_is_zero(a: ref Vec[u64]) -> bool {
    a.len() == 0
}

fn bn_is_odd(a: ref Vec[u64]) -> bool {
    a.len() > 0 and (a[0] & 1u64) == 1u64
}

fn bn_cmp(a: ref Vec[u64], b: ref Vec[u64]) -> i64 {
    if a.len() != b.len() {
        return if a.len() < b.len() { -1 } else { 1 };
    }
    let mut i = a.len() - 1;
    while i >= 0 {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 };
        }
        i -= 1;
    }
    0
}

fn bn_eq_small(a: ref Vec[u64], v: i64) -> bool {
    bn_cmp(a, bn(v)) == 0
}

fn bn_add(a: ref Vec[u64], b: ref Vec[u64]) -> Vec[u64] {
    let n = if a.len() > b.len() { a.len() } else { b.len() };
    let mut out: Vec[u64] = Vec.new();
    let mut carry = 0u128;
    let mut i = 0;
    while i < n {
        let x = if i < a.len() { a[i] as u128 } else { 0u128 };
        let y = if i < b.len() { b[i] as u128 } else { 0u128 };
        let s = x + y + carry;
        out.push((s & mask64()) as u64);
        carry = s >> 64;
        i += 1;
    }
    if carry > 0u128 {
        out.push(carry as u64);
    }
    out
}

// a - b, for a >= b.
fn bn_sub(a: ref Vec[u64], b: ref Vec[u64]) -> Vec[u64] {
    let mut out: Vec[u64] = Vec.new();
    let mut borrow = 0u128;
    let base = 1u128 << 64;
    let mut i = 0;
    while i < a.len() {
        let y = if i < b.len() { b[i] as u128 } else { 0u128 };
        let t = (a[i] as u128) + base - borrow - y;
        out.push((t & mask64()) as u64);
        borrow = if t < base { 1u128 } else { 0u128 };
        i += 1;
    }
    bn_norm(mut out);
    out
}

fn bn_mul(a: ref Vec[u64], b: ref Vec[u64]) -> Vec[u64] {
    if a.len() == 0 or b.len() == 0 {
        return Vec.new();
    }
    let mut out: Vec[u64] = Vec.new();
    let mut k = 0;
    while k < a.len() + b.len() {
        out.push(0u64);
        k += 1;
    }
    let mut i = 0;
    while i < a.len() {
        let x = a[i] as u128;
        let mut carry = 0u128;
        let mut j = 0;
        while j < b.len() {
            let t = x * (b[j] as u128) + (out[i + j] as u128) + carry;
            out[i + j] = (t & mask64()) as u64;
            carry = t >> 64;
            j += 1;
        }
        out[i + b.len()] = carry as u64;
        i += 1;
    }
    bn_norm(mut out);
    out
}

fn bn_mul_small(a: ref Vec[u64], v: u64) -> Vec[u64] {
    let mut out: Vec[u64] = Vec.new();
    let mut carry = 0u128;
    for x in a {
        let t = (x as u128) * (v as u128) + carry;
        out.push((t & mask64()) as u64);
        carry = t >> 64;
    }
    if carry > 0u128 {
        out.push(carry as u64);
    }
    bn_norm(mut out);
    out
}

fn bn_shl(a: ref Vec[u64], bits: i64) -> Vec[u64] {
    if a.len() == 0 {
        return Vec.new();
    }
    let words = bits / 64;
    let s = bits % 64;
    let mut out: Vec[u64] = Vec.new();
    let mut k = 0;
    while k < words {
        out.push(0u64);
        k += 1;
    }
    if s == 0 {
        for x in a {
            out.push(x);
        }
        return out;
    }
    let mut carry = 0u64;
    for x in a {
        out.push((x << s) | carry);
        carry = x >> (64 - s);
    }
    if carry != 0u64 {
        out.push(carry);
    }
    out
}

fn bn_shr(a: ref Vec[u64], bits: i64) -> Vec[u64] {
    let words = bits / 64;
    let s = bits % 64;
    let mut out: Vec[u64] = Vec.new();
    let mut i = words;
    while i < a.len() {
        let lo = a[i] >> s;
        let hi = if s > 0 and i + 1 < a.len() { a[i + 1] << (64 - s) } else { 0u64 };
        out.push(lo | hi);
        i += 1;
    }
    bn_norm(mut out);
    out
}

// int.bit_length()
fn bn_bits(a: ref Vec[u64]) -> i64 {
    if a.len() == 0 {
        return 0;
    }
    let mut top = a[a.len() - 1];
    let mut n = 0;
    while top != 0u64 {
        top = top >> 1;
        n += 1;
    }
    (a.len() - 1) * 64 + n
}

// The quotient and remainder of a by a one-limb divisor.
fn bn_divmod_small(a: ref Vec[u64], d: u64) -> (Vec[u64], u64) {
    let mut q: Vec[u64] = Vec.new();
    let mut k = 0;
    while k < a.len() {
        q.push(0u64);
        k += 1;
    }
    let mut r = 0u128;
    let dd = d as u128;
    let mut i = a.len() - 1;
    while i >= 0 {
        let cur = (r << 64) | (a[i] as u128);
        q[i] = (cur / dd) as u64;
        r = cur % dd;
        i -= 1;
    }
    bn_norm(mut q);
    (q, r as u64)
}

// divmod(a, b) for b > 0: Knuth's algorithm D on 64-bit limbs.
fn bn_divmod(a: ref Vec[u64], b: ref Vec[u64]) -> (Vec[u64], Vec[u64]) {
    if bn_cmp(a, b) < 0 {
        return (Vec.new(), a.clone());
    }
    if b.len() == 1 {
        let (q, r) = bn_divmod_small(a, b[0]);
        let mut rv: Vec[u64] = Vec.new();
        if r != 0u64 {
            rv.push(r);
        }
        return (q, rv);
    }
    let n = b.len();
    let mut top = b[n - 1];
    let mut s = 0;
    while (top & 0x8000000000000000u64) == 0u64 {
        top = top << 1;
        s += 1;
    }
    let v = bn_shl(b, s);
    let mut u = bn_shl(a, s);
    while u.len() <= a.len() {
        u.push(0u64);
    }
    let m = u.len() - n - 1;
    let mut q: Vec[u64] = Vec.new();
    let mut k = 0;
    while k <= m {
        q.push(0u64);
        k += 1;
    }
    let base = 1u128 << 64;
    let vn1 = v[n - 1] as u128;
    let vn2 = v[n - 2] as u128;
    let mut j = m;
    while j >= 0 {
        let num = ((u[j + n] as u128) << 64) | (u[j + n - 1] as u128);
        let mut qhat = num / vn1;
        let mut rhat = num % vn1;
        loop {
            let too_big = if qhat >= base { true } else { qhat * vn2 > ((rhat << 64) | (u[j + n - 2] as u128)) };
            if not too_big {
                break;
            }
            qhat -= 1u128;
            rhat += vn1;
            if rhat >= base {
                break;
            }
        }
        // u[j..j+n] -= qhat * v
        let mut borrow = 0u128;
        let mut carry = 0u128;
        let mut i = 0;
        while i < n {
            let p = qhat * (v[i] as u128) + carry;
            carry = p >> 64;
            let t = (u[i + j] as u128) + base - borrow - (p & mask64());
            u[i + j] = (t & mask64()) as u64;
            borrow = if t < base { 1u128 } else { 0u128 };
            i += 1;
        }
        let t = (u[j + n] as u128) + base - borrow - carry;
        u[j + n] = (t & mask64()) as u64;
        if t < base {
            // qhat was one too large: add v back
            qhat -= 1u128;
            let mut c = 0u128;
            let mut i2 = 0;
            while i2 < n {
                let s2 = (u[i2 + j] as u128) + (v[i2] as u128) + c;
                u[i2 + j] = (s2 & mask64()) as u64;
                c = s2 >> 64;
                i2 += 1;
            }
            u[j + n] = (((u[j + n] as u128) + c) & mask64()) as u64;
        }
        q[j] = qhat as u64;
        j -= 1;
    }
    bn_norm(mut q);
    let mut r: Vec[u64] = Vec.new();
    let mut i = 0;
    while i < n {
        r.push(u[i]);
        i += 1;
    }
    bn_norm(mut r);
    (q, bn_shr(r, s))
}

fn bn_mod(a: ref Vec[u64], m: ref Vec[u64]) -> Vec[u64] {
    bn_divmod(a, m).1
}

fn bn_div(a: ref Vec[u64], m: ref Vec[u64]) -> Vec[u64] {
    bn_divmod(a, m).0
}

// pow(base, exp, m)
fn bn_powmod(base: ref Vec[u64], exp: ref Vec[u64], m: ref Vec[u64]) -> Vec[u64] {
    if bn_eq_small(m, 1) {
        return Vec.new();
    }
    let mut result = bn(1);
    let b = bn_mod(base, m);
    let mut i = bn_bits(exp) - 1;
    while i >= 0 {
        result = bn_mod(bn_mul(result, result), m);
        if ((exp[i / 64] >> (i % 64)) & 1u64) == 1u64 {
            result = bn_mod(bn_mul(result, b), m);
        }
        i -= 1;
    }
    result
}

// int.from_bytes(b, 'big')
fn bn_from_bytes(b: ref Vec[u8]) -> Vec[u64] {
    let mut out: Vec[u64] = Vec.new();
    let mut end = b.len();
    while end > 0 {
        let start = if end >= 8 { end - 8 } else { 0 };
        let mut w = 0u64;
        let mut k = start;
        while k < end {
            w = (w << 8) | (b[k] as u64);
            k += 1;
        }
        out.push(w);
        end = start;
    }
    bn_norm(mut out);
    out
}

// int.to_bytes(length, 'big'), for a value that fits.
fn bn_to_bytes(a: ref Vec[u64], length: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut k = length - 1;
    while k >= 0 {
        let limb = k / 8;
        let byte = if limb < a.len() { ((a[limb] >> ((k % 8) * 8)) & 0xFFu64) as u8 } else { 0u8 };
        out.push(byte);
        k -= 1;
    }
    out
}

fn bn_to_i64(a: ref Vec[u64]) -> i64 {
    if a.len() == 0 { 0 } else { a[0] as i64 }
}

// str(int)
fn bn_str(a: ref Vec[u64]) -> String {
    if a.len() == 0 {
        return "0".to_string();
    }
    let mut chunks: Vec[u64] = Vec.new();
    let mut cur = a.clone();
    while cur.len() > 0 {
        let (q, r) = bn_divmod_small(cur, 10000000000000000000u64);
        chunks.push(r);
        cur = q;
    }
    let mut s = f"{chunks[chunks.len() - 1]}";
    let mut i = chunks.len() - 2;
    while i >= 0 {
        let part = f"{chunks[i]}";
        let mut pad = 19 - part.len();
        while pad > 0 {
            s.push('0');
            pad -= 1;
        }
        s.push_str(part);
        i -= 1;
    }
    s
}

fn bn_parse(s: Str) -> Vec[u64] {
    let mut out: Vec[u64] = Vec.new();
    for c in s.bytes() {
        out = bn_add(bn_mul_small(out, 10u64), bn((c - 48u8) as i64));
    }
    out
}

// A signed value, for extended_gcd's coefficients.
struct SBig {
    neg: bool,
    mag: Vec[u64],
}

fn s_of(a: ref Vec[u64]) -> SBig {
    SBig { neg: false, mag: a.clone() }
}

// a - b
fn s_sub(a: ref SBig, b: ref SBig) -> SBig {
    if a.neg != b.neg {
        return SBig { neg: a.neg, mag: bn_add(a.mag, b.mag) };
    }
    if bn_cmp(a.mag, b.mag) >= 0 {
        let m = bn_sub(a.mag, b.mag);
        SBig { neg: a.neg and m.len() > 0, mag: m }
    } else {
        SBig { neg: not a.neg, mag: bn_sub(b.mag, a.mag) }
    }
}

fn s_mul(q: ref Vec[u64], x: ref SBig) -> SBig {
    let m = bn_mul(q, x.mag);
    SBig { neg: x.neg and m.len() > 0, mag: m }
}

// (s1 - s2) * c % p, with Python's non-negative %.
fn bn_sub_mul_mod(s1: ref Vec[u64], s2: ref Vec[u64], c: ref Vec[u64], p: ref Vec[u64]) -> Vec[u64] {
    if bn_cmp(s1, s2) >= 0 {
        return bn_mod(bn_mul(bn_sub(s1, s2), c), p);
    }
    let r = bn_mod(bn_mul(bn_sub(s2, s1), c), p);
    if r.len() == 0 { r } else { bn_sub(p, r) }
}

// ------------------------------------------------------------ the generator

// os.urandom as oracle.py replaces it: splitmix64, each read taking whole
// words and their little-endian bytes.
struct Rng {
    state: u64,
}

fn rng_word(r: mut ref Rng) -> u64 {
    r.state = r.state.wrapping_add(0x9E3779B97F4A7C15u64);
    let mut z = r.state;
    z = (z ^ (z >> 30)).wrapping_mul(0xBF58476D1CE4E5B9u64);
    z = (z ^ (z >> 27)).wrapping_mul(0x94D049BB133111EBu64);
    z ^ (z >> 31)
}

fn urandom(r: mut ref Rng, n: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    while out.len() < n {
        let w = rng_word(mut r);
        for k in 0..8 {
            out.push(((w >> (k * 8)) & 0xFFu64) as u8);
        }
    }
    out.truncate(n);
    out
}

// --------------------------------------------------------------- errors

// An exception: its class name and message.
struct Exc {
    cls: String,
    msg: String,
}

fn exc(cls: Str, msg: own String) -> Exc {
    Exc { cls: cls.to_string(), msg: msg }
}

// repr() of an exception raised with one string argument.
fn exc_repr(e: ref Exc) -> String {
    f"{e.cls}({py_repr(e.msg)})"
}

// An exception raised with two arguments, the second an exception: str()
// of it is the repr of the tuple.
fn exc_wrap(cls: Str, msg: Str, inner: ref Exc) -> Exc {
    exc(cls, f"({py_repr(msg)}, {exc_repr(inner)})")
}

// ------------------------------------------------------ more of Python's int

// The extended Euclidean algorithm: (gcd, lx, ly), lx and ly made
// non-negative.
fn extended_gcd(a0: ref Vec[u64], b0: ref Vec[u64]) -> (Vec[u64], Vec[u64], Vec[u64]) {
    let mut a = a0.clone();
    let mut b = b0.clone();
    let mut x = s_of(bn(0));
    let mut y = s_of(bn(1));
    let mut lx = s_of(bn(1));
    let mut ly = s_of(bn(0));
    while not bn_is_zero(b) {
        let (q, r) = bn_divmod(a, b);
        a = b;
        b = r;
        let nx = s_sub(lx, s_mul(q, x));
        lx = x;
        x = nx;
        let ny = s_sub(ly, s_mul(q, y));
        ly = y;
        y = ny;
    }
    let lxv = if lx.neg { bn_sub(b0, lx.mag) } else { lx.mag.clone() };
    let lyv = if ly.neg { bn_sub(a0, ly.mag) } else { ly.mag.clone() };
    (a, lxv, lyv)
}

// numbertheory.inverse_mod: pow(a, -1, m), and 0 for 0.
fn inverse_mod(a0: ref Vec[u64], m: ref Vec[u64]) -> Result[Vec[u64], Exc] {
    let a = bn_mod(a0, m);
    if bn_is_zero(a0) {
        return Ok(Vec.new());
    }
    let (g, lx, _) = extended_gcd(a, m);
    if not bn_eq_small(g, 1) {
        return Err(exc("ValueError", "base is not invertible for the given modulus".to_string()));
    }
    Ok(bn_mod(lx, m))
}

// '%x' % n
fn bn_hex(a: ref Vec[u64]) -> String {
    if a.len() == 0 {
        return "0".to_string();
    }
    let digits = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    let mut i = a.len() * 16 - 1;
    let mut started = false;
    while i >= 0 {
        let d = ((a[i / 16] >> ((i % 16) * 4)) & 15u64) as i64;
        if d != 0 or started {
            out.push(digits[d]);
            started = true;
        }
        i -= 1;
    }
    from_bytes(out)
}

// int(s, 16)
fn bn_from_hex(s: Str) -> Vec[u64] {
    let mut out: Vec[u64] = Vec.new();
    for c in s.bytes() {
        out = bn_add(bn_shl(out, 4), bn(hex_val(c) as i64));
    }
    out
}

fn bn_bit(a: ref Vec[u64], i: i64) -> bool {
    i / 64 < a.len() and ((a[i / 64] >> (i % 64)) & 1u64) == 1u64
}

// x.bit_length() or 1
fn bit_length(a: ref Vec[u64]) -> i64 {
    let b = bn_bits(a);
    if b == 0 { 1 } else { b }
}

// util.orderlen: the bytes of the order's hex digits.
fn orderlen(order: ref Vec[u64]) -> i64 {
    (1 + bn_hex(order).len()) / 2
}

// util.number_to_string: big-endian, orderlen(order) bytes.
fn number_to_string(num: ref Vec[u64], order: ref Vec[u64]) -> Result[Vec[u8], Exc] {
    let l = orderlen(order);
    if (bn_bits(num) + 7) / 8 > l {
        return Err(exc("AssertionError", f"({(bn_bits(num) + 7) / 8}, {l})"));
    }
    Ok(bn_to_bytes(num, l))
}

// --------------------------------------------------------- the prime field

// a + b mod p and a - b mod p, for a, b < p, each in one buffer of p's
// length plus a carry limb.
fn f_add(a: ref Vec[u64], b: ref Vec[u64], p: ref Vec[u64]) -> Vec[u64] {
    let n = p.len();
    let mut out = Vec.filled(n + 1, 0u64);
    let mut c = 0u128;
    let mut i = 0;
    while i < n {
        let x = if i < a.len() { a[i] as u128 } else { 0u128 };
        let y = if i < b.len() { b[i] as u128 } else { 0u128 };
        let t = x + y + c;
        out[i] = (t & mask64()) as u64;
        c = t >> 64;
        i += 1;
    }
    out[n] = c as u64;
    // out >= p: compare from the top limb down.
    let mut ge = c != 0u128;
    if not ge {
        ge = true;
        let mut k = n - 1;
        while k >= 0 {
            if out[k] != p[k] {
                ge = out[k] > p[k];
                break;
            }
            k -= 1;
        }
    }
    if ge {
        sub_in_place(mut out, p);
    }
    bn_norm(mut out);
    out
}

fn f_sub(a: ref Vec[u64], b: ref Vec[u64], p: ref Vec[u64]) -> Vec[u64] {
    let n = p.len();
    let mut out = Vec.filled(n + 1, 0u64);
    let mut borrow = 0u128;
    let base = 1u128 << 64;
    let mut i = 0;
    while i < n {
        let x = if i < a.len() { a[i] as u128 } else { 0u128 };
        let y = if i < b.len() { b[i] as u128 } else { 0u128 };
        let t = x + base - y - borrow;
        out[i] = (t & mask64()) as u64;
        borrow = if t < base { 1u128 } else { 0u128 };
        i += 1;
    }
    if borrow != 0u128 {
        // a < b: add p back; the carry out cancels the borrow.
        let mut c = 0u128;
        let mut j = 0;
        while j < n {
            let t = (out[j] as u128) + (p[j] as u128) + c;
            out[j] = (t & mask64()) as u64;
            c = t >> 64;
            j += 1;
        }
    }
    bn_norm(mut out);
    out
}

// a -= p over a's limbs, for a >= p.
fn sub_in_place(a: mut ref Vec[u64], p: ref Vec[u64]) {
    let base = 1u128 << 64;
    let mut borrow = 0u128;
    let mut i = 0;
    while i < a.len() {
        let y = if i < p.len() { p[i] as u128 } else { 0u128 };
        let t = (a[i] as u128) + base - y - borrow;
        a[i] = (t & mask64()) as u64;
        borrow = if t < base { 1u128 } else { 0u128 };
        i += 1;
    }
}

fn f_mul(a: ref Vec[u64], b: ref Vec[u64], p: ref Vec[u64]) -> Vec[u64] {
    bn_mod(bn_mul(a, b), p)
}

fn f_neg(a: ref Vec[u64], p: ref Vec[u64]) -> Vec[u64] {
    if bn_is_zero(a) { Vec.new() } else { bn_sub(p, a) }
}

// --------------------------------------------------------------- base64

// base64.b64decode: characters outside the alphabet are dropped.
fn b64_decode(s: ref Vec[u8]) -> Result[Vec[u8], Exc] {
    let mut out: Vec[u8] = Vec.new();
    let mut acc = 0;
    let mut nbits = 0;
    let mut count = 0;
    let mut pad = 0;
    for c in s {
        if c == 61u8 {
            pad += 1;
            continue;
        }
        let v = b64_value(c);
        if v < 0 {
            continue;
        }
        acc = (acc << 6) | v;
        nbits += 6;
        count += 1;
        if nbits >= 8 {
            nbits -= 8;
            out.push(((acc >> nbits) & 0xFF) as u8);
            acc = acc & ((1 << nbits) - 1);
        }
    }
    if (count + pad) % 4 != 0 {
        return Err(exc("Error", "Incorrect padding".to_string()));
    }
    Ok(out)
}

// base64.urlsafe_b64encode, with the padding stripped.
fn b64url_encode(b: ref Vec[u8]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for c in b64_encode(b).bytes() {
        if c == b'+' {
            out.push(b'-');
        } else if c == b'/' {
            out.push(b'_');
        } else if c != b'=' {
            out.push(c);
        }
    }
    from_bytes(out)
}

// base64.urlsafe_b64decode(s + '=' * (-len(s) % 4))
fn b64url_decode(s: Str) -> Result[Vec[u8], Exc] {
    let mut b: Vec[u8] = Vec.new();
    for c in s.bytes() {
        if c == b'-' {
            b.push(b'+');
        } else if c == b'_' {
            b.push(b'/');
        } else {
            b.push(c);
        }
    }
    while b.len() % 4 != 0 {
        b.push(b'=');
    }
    b64_decode(b)
}

// ------------------------------------------------------------------- der.py

fn sub(b: ref Vec[u8], from: i64, to: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut i = if from < 0 { 0 } else { from };
    let end = if to > b.len() { b.len() } else { to };
    while i < end {
        out.push(b[i]);
        i += 1;
    }
    out
}

fn tail(b: ref Vec[u8], from: i64) -> Vec[u8] {
    sub(b, from, b.len())
}

fn cat(a: ref Vec[u8], b: ref Vec[u8]) -> Vec[u8] {
    let mut out = a.clone();
    for c in b {
        out.push(c);
    }
    out
}

fn unexpected(msg: own String) -> Exc {
    exc("UnexpectedDER", msg)
}

// binascii.hexlify(b), as %s prints it.
fn hexlify_str(b: ref Vec[u8]) -> String {
    f"b'{hex_of(b)}'"
}

fn hex2(c: u8) -> String {
    let digits = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    out.push(digits[(c / 16u8) as i64]);
    out.push(digits[(c % 16u8) as i64]);
    from_bytes(out)
}

// A tuple of ints, as %s and {!r} print it.
fn oid_tuple(oid: ref Vec[i64]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for n in oid {
        parts.push(f"{n}");
    }
    if parts.len() == 1 {
        return f"({parts[0]},)";
    }
    f"({join(parts, ", ")})"
}

fn encode_length(l: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    if l < 128 {
        out.push(l as u8);
        return out;
    }
    let mut body: Vec[u8] = Vec.new();
    let mut v = l;
    while v > 0 {
        body.insert(0, (v & 255) as u8);
        v = v >> 8;
    }
    out.push(128u8 | (body.len() as u8));
    cat(out, body)
}

fn tlv(tag: u8, body: ref Vec[u8]) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    out.push(tag);
    cat(cat(out, encode_length(body.len())), body)
}

fn encode_constructed(tag: i64, value: ref Vec[u8]) -> Vec[u8] {
    tlv((160 + tag) as u8, value)
}

fn encode_integer(r: ref Vec[u64]) -> Vec[u8] {
    let mut s = bn_to_bytes(r, (bn_bits(r) + 7) / 8);
    if s.len() == 0 {
        s.push(0u8);
    }
    if s[0] > 127u8 {
        s.insert(0, 0u8);
    }
    tlv(2u8, s)
}

fn encode_bitstring(s: ref Vec[u8]) -> Vec[u8] {
    let mut body: Vec[u8] = Vec.new();
    body.push(0u8);
    tlv(3u8, cat(body, s))
}

fn encode_octet_string(s: ref Vec[u8]) -> Vec[u8] {
    tlv(4u8, s)
}

fn encode_number(n0: i64) -> Vec[u8] {
    let mut digits: Vec[u8] = Vec.new();
    let mut n = n0;
    while n > 0 {
        digits.insert(0, ((n & 127) | 128) as u8);
        n = n >> 7;
    }
    if digits.len() == 0 {
        digits.push(0u8);
    }
    let last = digits.len() - 1;
    digits[last] = digits[last] & 127u8;
    digits
}

fn encode_oid(oid: ref Vec[i64]) -> Vec[u8] {
    let mut body = encode_number(40 * oid[0] + oid[1]);
    let mut i = 2;
    while i < oid.len() {
        body = cat(body, encode_number(oid[i]));
        i += 1;
    }
    tlv(6u8, body)
}

fn encode_sequence(pieces: ref Vec[Vec[u8]]) -> Vec[u8] {
    let mut body: Vec[u8] = Vec.new();
    for p in pieces {
        body = cat(body, p);
    }
    tlv(48u8, body)
}

fn is_sequence(s: ref Vec[u8]) -> bool {
    s.len() > 0 and s[0] == 48u8
}

fn first_of(s: ref Vec[u8]) -> Result[u8, Exc] {
    if s.len() == 0 {
        return Err(exc("IndexError", "index out of range".to_string()));
    }
    Ok(s[0])
}

// read_length(string): (length, bytes it took)
fn read_length(s: ref Vec[u8]) -> Result[(i64, i64), Exc] {
    if s.len() == 0 {
        return Err(unexpected("Empty string can't encode valid length value".to_string()));
    }
    let num = s[0] as i64;
    if (num & 128) == 0 {
        return Ok((num & 127, 1));
    }
    let llen = num & 127;
    if llen == 0 {
        return Err(unexpected("Invalid length encoding, length of length is 0".to_string()));
    }
    if llen > s.len() - 1 {
        return Err(unexpected("Length of length longer than provided buffer".to_string()));
    }
    let msb = s[1] as i64;
    if msb == 0 or (llen == 1 and msb < 128) {
        return Err(unexpected("Not minimal encoding of length".to_string()));
    }
    let mut v = 0;
    for k in 1..(1 + llen) {
        v = (v << 8) | (s[k] as i64);
    }
    Ok((v, 1 + llen))
}

fn remove_constructed(s: ref Vec[u8]) -> Result[(i64, Vec[u8], Vec[u8]), Exc] {
    let s0 = first_of(s)?;
    if (s0 & 224u8) != 160u8 {
        return Err(unexpected(f"wanted type 'constructed tag' (0xa0-0xbf), got 0x{hex2(s0)}"));
    }
    let tag = (s0 & 31u8) as i64;
    let (length, llen) = read_length(tail(s, 1))?;
    Ok((tag, sub(s, 1 + llen, 1 + llen + length), tail(s, 1 + llen + length)))
}

fn remove_sequence(s: ref Vec[u8]) -> Result[(Vec[u8], Vec[u8]), Exc] {
    if s.len() == 0 {
        return Err(unexpected("Empty string does not encode a sequence".to_string()));
    }
    if s[0] != 48u8 {
        return Err(unexpected(f"wanted type 'sequence' (0x30), got 0x{hex2(s[0])}"));
    }
    let (length, llen) = read_length(tail(s, 1))?;
    if length > s.len() - 1 - llen {
        return Err(unexpected("Length longer than the provided buffer".to_string()));
    }
    let endseq = 1 + llen + length;
    Ok((sub(s, 1 + llen, endseq), tail(s, endseq)))
}

fn remove_octet_string(s: ref Vec[u8]) -> Result[(Vec[u8], Vec[u8]), Exc] {
    if s.len() == 0 or s[0] != 4u8 {
        let n = first_of(s)?;
        return Err(unexpected(f"wanted type 'octetstring' (0x04), got 0x{hex2(n)}"));
    }
    let (length, llen) = read_length(tail(s, 1))?;
    Ok((sub(s, 1 + llen, 1 + llen + length), tail(s, 1 + llen + length)))
}

fn read_number(s: ref Vec[u8]) -> Result[(i64, i64), Exc] {
    if first_of(s)? == 128u8 {
        return Err(unexpected("Non minimal encoding of OID subidentifier".to_string()));
    }
    let mut number = 0;
    let mut llen = 0;
    loop {
        if llen >= s.len() {
            return Err(unexpected("ran out of length bytes".to_string()));
        }
        number = number << 7;
        let d = s[llen] as i64;
        number += d & 127;
        llen += 1;
        if (d & 128) == 0 {
            break;
        }
    }
    Ok((number, llen))
}

fn remove_object(s: ref Vec[u8]) -> Result[(Vec[i64], Vec[u8]), Exc] {
    if s.len() == 0 {
        return Err(unexpected("Empty string does not encode an object identifier".to_string()));
    }
    if s[0] != 6u8 {
        return Err(unexpected(f"wanted type 'object' (0x06), got 0x{hex2(s[0])}"));
    }
    let (length, llen) = read_length(tail(s, 1))?;
    let mut body = sub(s, 1 + llen, 1 + llen + length);
    let rest = tail(s, 1 + llen + length);
    if body.len() == 0 {
        return Err(unexpected("Empty object identifier".to_string()));
    }
    if body.len() != length {
        return Err(unexpected("Length of object identifier longer than the provided buffer".to_string()));
    }
    let mut numbers: Vec[i64] = Vec.new();
    while body.len() > 0 {
        let (n, ll) = read_number(body)?;
        numbers.push(n);
        body = tail(body, ll);
    }
    let n0 = numbers[0];
    let first = if n0 < 80 { n0 / 40 } else { 2 };
    let mut out: Vec[i64] = Vec.new();
    out.push(first);
    out.push(n0 - 40 * first);
    let mut i = 1;
    while i < numbers.len() {
        out.push(numbers[i]);
        i += 1;
    }
    Ok((out, rest))
}

fn remove_integer(s: ref Vec[u8]) -> Result[(Vec[u64], Vec[u8]), Exc] {
    if s.len() == 0 {
        return Err(unexpected("Empty string is an invalid encoding of an integer".to_string()));
    }
    if s[0] != 2u8 {
        return Err(unexpected(f"wanted type 'integer' (0x02), got 0x{hex2(s[0])}"));
    }
    let (length, llen) = read_length(tail(s, 1))?;
    if length > s.len() - 1 - llen {
        return Err(unexpected("Length longer than provided buffer".to_string()));
    }
    if length == 0 {
        return Err(unexpected("0-byte long encoding of integer".to_string()));
    }
    let numberbytes = sub(s, 1 + llen, 1 + llen + length);
    let rest = tail(s, 1 + llen + length);
    let msb = numberbytes[0];
    if msb >= 128u8 {
        return Err(unexpected("Negative integers are not supported".to_string()));
    }
    if length > 1 and msb == 0u8 and numberbytes[1] < 128u8 {
        return Err(unexpected("Invalid encoding of integer, unnecessary zero padding bytes".to_string()));
    }
    Ok((bn_from_bytes(numberbytes), rest))
}

// remove_bitstring(string, 0)
fn remove_bitstring(s: ref Vec[u8]) -> Result[(Vec[u8], Vec[u8]), Exc] {
    if s.len() == 0 {
        return Err(unexpected("Empty string does not encode a bitstring".to_string()));
    }
    if s[0] != 3u8 {
        return Err(unexpected(f"wanted bitstring (0x03), got 0x{hex2(s[0])}"));
    }
    let (length, llen) = read_length(tail(s, 1))?;
    if length == 0 {
        return Err(unexpected("Invalid length of bit string, can't be 0".to_string()));
    }
    let body = sub(s, 1 + llen, 1 + llen + length);
    let rest = tail(s, 1 + llen + length);
    let unused = first_of(body)?;
    if unused > 7u8 {
        return Err(unexpected("Invalid encoding of unused bits".to_string()));
    }
    if unused != 0u8 {
        return Err(unexpected("Unexpected number of unused bits".to_string()));
    }
    Ok((tail(body, 1), rest))
}

fn starts_with_bytes(b: ref Vec[u8], pat: Str) -> bool {
    let p = to_bytes(pat);
    if b.len() < p.len() {
        return false;
    }
    for k in 0..p.len() {
        if b[k] != p[k] {
            return false;
        }
    }
    true
}

// der.unpem: every line that is not a ----- marker, stripped, joined and
// base64-decoded.
fn unpem(pem: ref Vec[u8]) -> Result[Vec[u8], Exc] {
    let mut d: Vec[u8] = Vec.new();
    let mut cur: Vec[u8] = Vec.new();
    let mut i = 0;
    while i <= pem.len() {
        if i == pem.len() or pem[i] == 10u8 {
            if cur.len() > 0 and not starts_with_bytes(cur, "-----") {
                d = cat(d, bytes_strip(cur));
            }
            cur = Vec.new();
        } else {
            cur.push(pem[i]);
        }
        i += 1;
    }
    b64_decode(d)
}

fn bytes_strip(b: ref Vec[u8]) -> Vec[u8] {
    let mut s = 0;
    let mut e = b.len();
    while s < e and is_ws(b[s]) {
        s += 1;
    }
    while e > s and is_ws(b[e - 1]) {
        e -= 1;
    }
    sub(b, s, e)
}

fn topem(der: ref Vec[u8], name: Str) -> String {
    let b64 = b64_encode(der);
    let mut s = f"-----BEGIN {name}-----\n";
    let mut i = 0;
    while i < b64.len() {
        let j = if i + 76 < b64.len() { i + 76 } else { b64.len() };
        s.push_str(slice(b64, i, j));
        s.push('\n');
        i = j;
    }
    s.push_str(f"-----END {name}-----\n");
    s
}

// bytes.find
fn bytes_find(hay: ref Vec[u8], needle: Str) -> i64 {
    let n = to_bytes(needle);
    let mut i = 0;
    while i + n.len() <= hay.len() {
        let mut ok = true;
        for k in 0..n.len() {
            if hay[i + k] != n[k] {
                ok = false;
                break;
            }
        }
        if ok {
            return i;
        }
        i += 1;
    }
    -1
}

// --------------------------------------------------------------- curves.py

// A curve: y^2 = x^3 + ax + b over GF(p), its generator (gx, gy) of order n,
// and the cofactor when it has one (has_h). An Edwards curve keeps only its
// name and OID: this port knows it exists but cannot compute on it.
#[derive(Clone)]
struct Curve {
    name: String,
    openssl: String,
    oid: Vec[i64],
    edwards: bool,
    p: Vec[u64],
    a: Vec[u64],
    b: Vec[u64],
    gx: Vec[u64],
    gy: Vec[u64],
    n: Vec[u64],
    h: Vec[u64],
    has_h: bool,
    baselen: i64,
    vk_len: i64,
    // The generator's comb table (see comb_mul), or empty.
    comb: Vec[Pt],
    comb_d: i64,
}

fn parse_oid(s: Str) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for part in split_on(s, 46u8) {
        out.push(py_int(part).unwrap());
    }
    out
}

fn make_curve(name: Str, openssl: Str, oid: own Vec[i64], p: own Vec[u64], a: own Vec[u64], b: own Vec[u64], gx: own Vec[u64], gy: own Vec[u64], n: own Vec[u64], h: own Vec[u64], has_h: bool) -> Curve {
    let baselen = orderlen(n);
    let vk_len = 2 * orderlen(p);
    Curve { name: name.to_string(), openssl: openssl.to_string(), oid: oid, edwards: false, p: p, a: a, b: b, gx: gx, gy: gy, n: n, h: h, has_h: has_h, baselen: baselen, vk_len: vk_len, comb: Vec.new(), comb_d: 0 }
}

// curves.curves, from the table gen_kara.py copies out of the library.
fn load_curves() -> Vec[Curve] {
    let mut out: Vec[Curve] = Vec.new();
    for line in split_c(curves_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, 32u8);
        if f.len() == 4 {
            out.push(Curve { name: f[0].clone(), openssl: String.new(), oid: parse_oid(f[2]), edwards: true, p: Vec.new(), a: Vec.new(), b: Vec.new(), gx: Vec.new(), gy: Vec.new(), n: Vec.new(), h: Vec.new(), has_h: false, baselen: 0, vk_len: 0, comb: Vec.new(), comb_d: 0 });
            continue;
        }
        let mut c = make_curve(f[0], f[1], parse_oid(f[2]), bn_from_hex(f[3]), bn_from_hex(f[4]), bn_from_hex(f[5]), bn_from_hex(f[6]), bn_from_hex(f[7]), bn_from_hex(f[8]), bn_from_hex(f[9]), true);
        c.comb.push(infinity());
        let mut i = 10;
        while i + 1 < f.len() {
            c.comb.push(Pt { x: bn_from_hex(f[i]), y: bn_from_hex(f[i + 1]), inf: false });
            i += 2;
        }
        c.comb_d = (bn_bits(c.n) + 3) / 4;
        out.push(c);
    }
    out
}

fn curve_names(cs: ref Vec[Curve]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for c in cs {
        parts.push(py_repr(c.name));
    }
    f"[{join(parts, ", ")}]"
}

fn curve_by_name(cs: ref Vec[Curve], name: Str) -> Result[Curve, Exc] {
    for c in cs {
        if c.name == name or (c.openssl.len() > 0 and c.openssl == name) {
            return Ok(c.clone());
        }
    }
    Err(exc("UnknownCurveError", f"Curve with name {py_repr(name)} unknown, only curves supported: {curve_names(cs)}"))
}

fn find_curve(cs: ref Vec[Curve], oid: ref Vec[i64]) -> Result[Curve, Exc] {
    for c in cs {
        if c.oid == *oid {
            return Ok(c.clone());
        }
    }
    Err(exc("UnknownCurveError", f"I don't know about the curve with oid {oid_tuple(oid)}.I only know about these: {curve_names(cs)}"))
}

fn not_ported(c: ref Curve) -> Result[(), Exc] {
    if c.edwards {
        return Err(exc("NotImplementedError", f"{c.name} keys are not ported"));
    }
    Ok(())
}

// Curve.__eq__: the same field and coefficients, and the same generator.
fn curve_eq(x: ref Curve, y: ref Curve) -> bool {
    if x.edwards or y.edwards {
        return x.edwards and y.edwards and x.name == y.name;
    }
    x.p == y.p and bn_mod(x.a, x.p) == bn_mod(y.a, y.p) and bn_mod(x.b, x.p) == bn_mod(y.b, y.p) and x.gx == y.gx and x.gy == y.gy
}

fn contains_point(c: ref Curve, x: ref Vec[u64], y: ref Vec[u64]) -> bool {
    let p = ref c.p;
    let lhs = f_mul(bn_mod(y, p), bn_mod(y, p), p);
    let xm = bn_mod(x, p);
    let rhs = f_add(f_mul(f_add(f_mul(xm, xm, p), bn_mod(c.a, p), p), xm, p), bn_mod(c.b, p), p);
    lhs == rhs
}

// ---------------------------------------------------------- numbertheory.py

fn no_square_root(a: ref Vec[u64], p: ref Vec[u64]) -> Exc {
    exc("SquareRootError", f"{bn_str(a)} has no square root modulo {bn_str(p)}")
}

// square_root_mod_prime(a, p). The library uses a polynomial method when
// p % 8 == 1; this port uses Tonelli-Shanks there. Both find a root, and
// every caller then picks the root by its parity, so the answers agree.
fn square_root_mod_prime(a: ref Vec[u64], p: ref Vec[u64]) -> Result[Vec[u64], Exc] {
    if bn_is_zero(a) {
        return Ok(Vec.new());
    }
    if bn_eq_small(p, 2) {
        return Ok(a.clone());
    }
    let one = bn(1);
    let pm1 = bn_sub(p, one);
    if f_pow(a, bn_shr(pm1, 1), p) == pm1 {
        return Err(no_square_root(a, p));
    }
    let p8 = bn_divmod_small(p, 8u64).1;
    if p8 % 4u64 == 3u64 {
        return Ok(f_pow(a, bn_shr(bn_add(p, one), 2), p));
    }
    if p8 == 5u64 {
        let d = f_pow(a, bn_shr(pm1, 2), p);
        if bn_eq_small(d, 1) {
            return Ok(f_pow(a, bn_shr(bn_add(p, bn(3)), 3), p));
        }
        let t = f_pow(bn_mul_small(a, 4u64), bn_shr(bn_sub(p, bn(5)), 3), p);
        return Ok(bn_mod(bn_mul(bn_mul_small(a, 2u64), t), p));
    }
    let mut q = pm1.clone();
    let mut s = 0;
    while not bn_is_odd(q) {
        q = bn_shr(q, 1);
        s += 1;
    }
    let mut z = bn(2);
    while f_pow(z, bn_shr(pm1, 1), p) != pm1 {
        z = bn_add(z, one);
    }
    let mut m = s;
    let mut c = f_pow(z, q, p);
    let mut t = f_pow(a, q, p);
    let mut r = f_pow(a, bn_shr(bn_add(q, one), 1), p);
    while not bn_eq_small(t, 1) {
        let mut i = 0;
        let mut t2 = t.clone();
        while not bn_eq_small(t2, 1) {
            t2 = f_mul(t2, t2, p);
            i += 1;
        }
        let mut bb = c.clone();
        for _ in 0..(m - i - 1) {
            bb = f_mul(bb, bb, p);
        }
        m = i;
        c = f_mul(bb, bb, p);
        t = f_mul(t, c, p);
        r = f_mul(r, bb, p);
    }
    Ok(r)
}

// --------------------------------------------------------- ellipticcurve.py

// An affine point; inf is the point at infinity.
#[derive(Clone)]
struct Pt {
    x: Vec[u64],
    y: Vec[u64],
    inf: bool,
}

fn infinity() -> Pt {
    Pt { x: Vec.new(), y: Vec.new(), inf: true }
}

fn pt(x: ref Vec[u64], y: ref Vec[u64]) -> Pt {
    Pt { x: x.clone(), y: y.clone(), inf: false }
}

// Montgomery arithmetic mod the field prime p of n limbs: a value x is
// held as x * R mod p, R = 2^(64 n), so a product needs no division.
// Zero is zero in both forms, and sums and differences are unchanged.
struct Mont {
    p: Vec[u64],
    n0: u64,
    r2: Vec[u64],
    a: Vec[u64],
    a_is_m3: bool,
}

// -p^-1 mod 2^64, by Newton's iteration from p0 (right to 3 bits).
fn mont_n0(p0: u64) -> u64 {
    let x = p0 as u128;
    let mut inv = x;
    let mut i = 0;
    while i < 5 {
        let t = (x * inv) & mask64();
        inv = (inv * (((1u128 << 64) + 2u128 - t) & mask64())) & mask64();
        i += 1;
    }
    (((1u128 << 64) - inv) & mask64()) as u64
}

fn mont_of(p: ref Vec[u64]) -> Mont {
    Mont { p: p.clone(), n0: mont_n0(p[0]), r2: bn_mod(bn_shl(bn(1), 128 * p.len()), p), a: Vec.new(), a_is_m3: false }
}

fn mont_ctx(c: ref Curve) -> Mont {
    let mut m = mont_of(c.p);
    let a = bn_mod(c.a, c.p);
    m.a_is_m3 = bn_add(a, bn(3)) == c.p;
    m.a = to_mont(a, m);
    m
}

// pow(a, e, p) for an odd p.
fn f_pow(a: ref Vec[u64], e: ref Vec[u64], p: ref Vec[u64]) -> Vec[u64] {
    let m = mont_of(p);
    let base = to_mont(bn_mod(a, p), m);
    let mut acc = to_mont(bn(1), m);
    let mut i = bn_bits(e) - 1;
    while i >= 0 {
        acc = mont_mul(acc, acc, m);
        if bn_bit(e, i) {
            acc = mont_mul(acc, base, m);
        }
        i -= 1;
    }
    from_mont(acc, m)
}

// a * b / R mod p, for a, b < p (CIOS).
fn mont_mul(a: ref Vec[u64], b: ref Vec[u64], m: ref Mont) -> Vec[u64] {
    let p = ref m.p;
    let n = p.len();
    let mut t = Vec.filled(n + 2, 0u64);
    let mut i = 0;
    while i < n {
        if i < a.len() and a[i] != 0u64 {
            let ai = a[i] as u128;
            let mut c = 0u128;
            let mut j = 0;
            while j < b.len() {
                let s = ai * (b[j] as u128) + (t[j] as u128) + c;
                t[j] = (s & mask64()) as u64;
                c = s >> 64;
                j += 1;
            }
            while c != 0u128 and j < n + 2 {
                let s = (t[j] as u128) + c;
                t[j] = (s & mask64()) as u64;
                c = s >> 64;
                j += 1;
            }
        }
        let q = ((t[0] as u128) * (m.n0 as u128)) & mask64();
        let s0 = (t[0] as u128) + q * (p[0] as u128);
        let mut c = s0 >> 64;
        let mut j = 1;
        while j < n {
            let s = (t[j] as u128) + q * (p[j] as u128) + c;
            t[j - 1] = (s & mask64()) as u64;
            c = s >> 64;
            j += 1;
        }
        let s = (t[n] as u128) + c;
        t[n - 1] = (s & mask64()) as u64;
        t[n] = (((t[n + 1] as u128) + (s >> 64)) & mask64()) as u64;
        t[n + 1] = 0u64;
        i += 1;
    }
    bn_norm(mut t);
    if bn_cmp(t, p) >= 0 { bn_sub(t, p) } else { t }
}

fn to_mont(x: ref Vec[u64], m: ref Mont) -> Vec[u64] {
    mont_mul(x, m.r2, m)
}

fn from_mont(x: ref Vec[u64], m: ref Mont) -> Vec[u64] {
    mont_mul(x, bn(1), m)
}

// Jacobian coordinates: (X/Z^2, Y/Z^3), Z = 0 at infinity, each held in
// Montgomery form.
struct Jac {
    x: Vec[u64],
    y: Vec[u64],
    z: Vec[u64],
}

fn jac_infinity() -> Jac {
    Jac { x: Vec.new(), y: bn(1), z: Vec.new() }
}

fn jac_of(q: ref Pt, m: ref Mont) -> Jac {
    if q.inf {
        return jac_infinity();
    }
    let p = ref m.p;
    Jac { x: to_mont(bn_mod(q.x, p), m), y: to_mont(bn_mod(q.y, p), m), z: to_mont(bn(1), m) }
}

fn jac_copy(j: ref Jac) -> Jac {
    Jac { x: j.x.clone(), y: j.y.clone(), z: j.z.clone() }
}

fn jac_inf(j: ref Jac) -> bool {
    bn_is_zero(j.z) or bn_is_zero(j.y)
}

fn jac_double(j: ref Jac, m: ref Mont) -> Jac {
    if jac_inf(j) {
        return jac_infinity();
    }
    let p = ref m.p;
    if m.a_is_m3 {
        return jac_double_m3(j, m);
    }
    let xx = mont_mul(j.x, j.x, m);
    let yy = mont_mul(j.y, j.y, m);
    let yyyy = mont_mul(yy, yy, m);
    let zz = mont_mul(j.z, j.z, m);
    let xyy = f_add(j.x, yy, p);
    let s0 = f_sub(f_sub(mont_mul(xyy, xyy, m), xx, p), yyyy, p);
    let s = f_add(s0, s0, p);
    let xx3 = f_add(f_add(xx, xx, p), xx, p);
    let mm = if bn_is_zero(m.a) { xx3 } else { f_add(xx3, mont_mul(m.a, mont_mul(zz, zz, m), m), p) };
    let t = f_sub(mont_mul(mm, mm, m), f_add(s, s, p), p);
    let y8 = bn_mod(bn_mul_small(yyyy, 8u64), p);
    let y3 = f_sub(mont_mul(mm, f_sub(s, t, p), m), y8, p);
    let yz = f_add(j.y, j.z, p);
    let z3 = f_sub(f_sub(mont_mul(yz, yz, m), yy, p), zz, p);
    Jac { x: t, y: y3, z: z3 }
}

// Doubling when a = -3, as on the NIST curves: 3 (X - Z^2)(X + Z^2) in
// place of 3 X^2 + a Z^4 saves two products.
fn jac_double_m3(j: ref Jac, m: ref Mont) -> Jac {
    let p = ref m.p;
    let delta = mont_mul(j.z, j.z, m);
    let gamma = mont_mul(j.y, j.y, m);
    let beta = mont_mul(j.x, gamma, m);
    let al = mont_mul(f_sub(j.x, delta, p), f_add(j.x, delta, p), m);
    let alpha = f_add(f_add(al, al, p), al, p);
    let beta2 = f_add(beta, beta, p);
    let beta4 = f_add(beta2, beta2, p);
    let x3 = f_sub(mont_mul(alpha, alpha, m), f_add(beta4, beta4, p), p);
    let yz = f_add(j.y, j.z, p);
    let z3 = f_sub(f_sub(mont_mul(yz, yz, m), gamma, p), delta, p);
    let g8 = bn_mod(bn_mul_small(mont_mul(gamma, gamma, m), 8u64), p);
    let y3 = f_sub(mont_mul(alpha, f_sub(beta4, x3, p), m), g8, p);
    Jac { x: x3, y: y3, z: z3 }
}

fn jac_add(j1: ref Jac, j2: ref Jac, m: ref Mont) -> Jac {
    if jac_inf(j1) {
        return jac_copy(j2);
    }
    if jac_inf(j2) {
        return jac_copy(j1);
    }
    let p = ref m.p;
    let z1z1 = mont_mul(j1.z, j1.z, m);
    let z2z2 = mont_mul(j2.z, j2.z, m);
    let u1 = mont_mul(j1.x, z2z2, m);
    let u2 = mont_mul(j2.x, z1z1, m);
    let s1 = mont_mul(mont_mul(j1.y, j2.z, m), z2z2, m);
    let s2 = mont_mul(mont_mul(j2.y, j1.z, m), z1z1, m);
    let h = f_sub(u2, u1, p);
    let r0 = f_sub(s2, s1, p);
    if bn_is_zero(h) {
        if bn_is_zero(r0) {
            return jac_double(j1, m);
        }
        return jac_infinity();
    }
    let r = f_add(r0, r0, p);
    let h2 = f_add(h, h, p);
    let i = mont_mul(h2, h2, m);
    let jj = mont_mul(h, i, m);
    let v = mont_mul(u1, i, m);
    let x3 = f_sub(f_sub(mont_mul(r, r, m), jj, p), f_add(v, v, p), p);
    let s1j = mont_mul(s1, jj, m);
    let y3 = f_sub(mont_mul(r, f_sub(v, x3, p), m), f_add(s1j, s1j, p), p);
    let zs = f_add(j1.z, j2.z, p);
    let z3 = mont_mul(f_sub(f_sub(mont_mul(zs, zs, m), z1z1, p), z2z2, p), h, m);
    Jac { x: x3, y: y3, z: z3 }
}

fn to_affine(j: ref Jac, m: ref Mont) -> Result[Pt, Exc] {
    if jac_inf(j) {
        return Ok(infinity());
    }
    let p = ref m.p;
    let zi = inverse_mod(from_mont(j.z, m), p)?;
    let zi2 = f_mul(zi, zi, p);
    let x = from_mont(j.x, m);
    let y = from_mont(j.y, m);
    Ok(Pt { x: f_mul(x, zi2, p), y: f_mul(f_mul(y, zi2, p), zi, p), inf: false })
}

// k * q, four bits at a time from a table of q .. 15 q. As
// PointJacobi.__mul__, a point with y = 0 gives infinity.
fn jac_mul(q: ref Pt, k: ref Vec[u64], m: ref Mont) -> Jac {
    if q.inf or bn_is_zero(q.y) or bn_is_zero(k) {
        return jac_infinity();
    }
    let base = jac_of(q, m);
    let mut table: Vec[Jac] = Vec.new();
    table.push(jac_infinity());
    table.push(jac_copy(base));
    let mut i = 2;
    while i < 16 {
        let next = if i % 2 == 0 { jac_double(table[i / 2], m) } else { jac_add(table[i - 1], base, m) };
        table.push(next);
        i += 1;
    }
    let mut top = bn_bits(k);
    while top % 4 != 0 {
        top += 1;
    }
    let mut acc = jac_infinity();
    let mut b = top - 4;
    while b >= 0 {
        acc = jac_double(jac_double(jac_double(jac_double(acc, m), m), m), m);
        let mut idx = 0;
        if bn_bit(k, b + 3) { idx += 8; }
        if bn_bit(k, b + 2) { idx += 4; }
        if bn_bit(k, b + 1) { idx += 2; }
        if bn_bit(k, b) { idx += 1; }
        if idx != 0 {
            acc = jac_add(acc, table[idx], m);
        }
        b -= 4;
    }
    acc
}

// k * G by the comb: bit i of each of k's four d-bit quarters picks a
// table entry, so the run is d doublings instead of 4 d.
fn comb_mul(k: ref Vec[u64], c: ref Curve, m: ref Mont) -> Jac {
    let d = c.comb_d;
    let mut table: Vec[Jac] = Vec.new();
    for q in c.comb {
        table.push(jac_of(q, m));
    }
    let mut acc = jac_infinity();
    let mut i = d - 1;
    while i >= 0 {
        acc = jac_double(acc, m);
        let mut idx = 0;
        if bn_bit(k, i) { idx += 1; }
        if bn_bit(k, i + d) { idx += 2; }
        if bn_bit(k, i + 2 * d) { idx += 4; }
        if bn_bit(k, i + 3 * d) { idx += 8; }
        if idx != 0 {
            acc = jac_add(acc, table[idx], m);
        }
        i -= 1;
    }
    acc
}

// k * q, by the comb when q is the generator and k fits it.
fn jac_mul_on(q: ref Pt, k: ref Vec[u64], c: ref Curve, m: ref Mont) -> Jac {
    if c.comb.len() == 16 and bn_bits(k) <= 4 * c.comb_d and not q.inf and q.x == c.gx and q.y == c.gy {
        return comb_mul(k, c, m);
    }
    jac_mul(q, k, m)
}

// point * k
fn pt_mul(q: ref Pt, k: ref Vec[u64], c: ref Curve) -> Result[Pt, Exc] {
    let m = mont_ctx(c);
    to_affine(jac_mul_on(q, k, c, m), m)
}

// u1 * q1 + u2 * q2 by Shamir's trick: one run of doublings over both
// scalars, two bits at a time, adding i * q1 + j * q2 from a table.
fn pt_mul_add(q1: ref Pt, u1: ref Vec[u64], q2: ref Pt, u2: ref Vec[u64], c: ref Curve) -> Result[Pt, Exc] {
    let m = mont_ctx(c);
    // As PointJacobi.mul_add: a factor that is infinity or zero drops out.
    if q1.inf or bn_is_zero(q1.y) or bn_is_zero(u1) {
        return to_affine(jac_mul(q2, u2, m), m);
    }
    if q2.inf or bn_is_zero(q2.y) or bn_is_zero(u2) {
        return to_affine(jac_mul(q1, u1, m), m);
    }
    let b1 = jac_of(q1, m);
    let b2 = jac_of(q2, m);
    let mut table: Vec[Jac] = Vec.new();
    table.push(jac_infinity());
    table.push(jac_copy(b2));
    table.push(jac_double(b2, m));
    table.push(jac_add(table[2], b2, m));
    let mut i = 4;
    while i < 16 {
        let row = if i % 4 == 0 {
            if i == 4 { jac_copy(b1) } else { jac_add(table[i - 4], b1, m) }
        } else {
            jac_add(table[i - i % 4], table[i % 4], m)
        };
        table.push(row);
        i += 1;
    }
    let mut top = bit_max(bn_bits(u1), bn_bits(u2));
    if top % 2 == 1 {
        top += 1;
    }
    let mut acc = jac_infinity();
    let mut k = top - 2;
    while k >= 0 {
        acc = jac_double(jac_double(acc, m), m);
        let mut idx = 0;
        if bn_bit(u1, k + 1) { idx += 8; }
        if bn_bit(u1, k) { idx += 4; }
        if bn_bit(u2, k + 1) { idx += 2; }
        if bn_bit(u2, k) { idx += 1; }
        if idx != 0 {
            acc = jac_add(acc, table[idx], m);
        }
        k -= 2;
    }
    to_affine(acc, m)
}

// u1 * r + u2 * q and u1 * (-r) + u2 * q, sharing both products: the
// two public keys a signature recovers to.
fn pt_mul_add_pair(r: ref Pt, u1: ref Vec[u64], q: ref Pt, u2: ref Vec[u64], c: ref Curve) -> Result[(Pt, Pt), Exc] {
    let m = mont_ctx(c);
    let a = jac_mul(r, u1, m);
    let b = jac_mul_on(q, u2, c, m);
    let neg_a = if jac_inf(a) { jac_infinity() } else { Jac { x: a.x.clone(), y: f_neg(a.y, m.p), z: a.z.clone() } };
    Ok((to_affine(jac_add(a, b, m), m)?, to_affine(jac_add(neg_a, b, m), m)?))
}

fn bit_max(x: i64, y: i64) -> i64 {
    if x > y { x } else { y }
}

fn generator(c: ref Curve) -> Pt {
    pt(c.gx, c.gy)
}

fn pt_eq(x: ref Pt, y: ref Pt) -> bool {
    if x.inf or y.inf {
        return x.inf and y.inf;
    }
    x.x == y.x and x.y == y.y
}

// AbstractPoint.to_bytes
fn point_to_bytes(q: ref Pt, c: ref Curve, encoding: Str) -> Result[Vec[u8], Exc] {
    let raw = cat(number_to_string(q.x, c.p)?, number_to_string(q.y, c.p)?);
    let odd = bn_is_odd(q.y);
    let mut out: Vec[u8] = Vec.new();
    if encoding == "raw" {
        return Ok(raw);
    } else if encoding == "uncompressed" {
        out.push(4u8);
        return Ok(cat(out, raw));
    } else if encoding == "hybrid" {
        out.push(if odd { 7u8 } else { 6u8 });
        return Ok(cat(out, raw));
    }
    out.push(if odd { 3u8 } else { 2u8 });
    Ok(cat(out, number_to_string(q.x, c.p)?))
}

fn malformed(msg: own String) -> Exc {
    exc("MalformedPointError", msg)
}

fn has_enc(valid: ref Vec[String], name: Str) -> bool {
    for v in valid {
        if v == name {
            return true;
        }
    }
    false
}

fn from_compressed(data: ref Vec[u8], c: ref Curve) -> Result[Pt, Exc] {
    if data[0] != 2u8 and data[0] != 3u8 {
        return Err(malformed("Malformed compressed point encoding".to_string()));
    }
    let is_even = data[0] == 2u8;
    let x = bn_from_bytes(tail(data, 1));
    let p = ref c.p;
    let xm = bn_mod(x, p);
    let alpha = f_add(f_mul(f_add(f_mul(xm, xm, p), bn_mod(c.a, p), p), xm, p), bn_mod(c.b, p), p);
    let beta = match square_root_mod_prime(alpha, p) {
        Ok(v) => v,
        Err(e) => {
            return Err(exc_wrap("MalformedPointError", "Encoding does not correspond to a point on curve", e));
        }
    };
    let y = if is_even == bn_is_odd(beta) { bn_sub(p, beta) } else { beta };
    Ok(Pt { x: x, y: y, inf: false })
}

// AbstractPoint.from_bytes: the coordinates, not yet checked against the
// curve.
fn point_from_bytes(c: ref Curve, data: ref Vec[u8], validate_encoding: bool, valid: ref Vec[String]) -> Result[Pt, Exc] {
    let key_len = data.len();
    let raw_len = c.vk_len;
    if key_len == raw_len and has_enc(valid, "raw") {
        return Ok(Pt { x: bn_from_bytes(sub(data, 0, raw_len / 2)), y: bn_from_bytes(tail(data, raw_len / 2)), inf: false });
    }
    if key_len == raw_len + 1 and (has_enc(valid, "hybrid") or has_enc(valid, "uncompressed")) {
        let x = bn_from_bytes(sub(data, 1, 1 + raw_len / 2));
        let y = bn_from_bytes(tail(data, 1 + raw_len / 2));
        if (data[0] == 6u8 or data[0] == 7u8) and has_enc(valid, "hybrid") {
            let odd = bn_is_odd(y);
            if validate_encoding and ((odd and data[0] != 7u8) or (not odd and data[0] != 6u8)) {
                return Err(malformed("Inconsistent hybrid point encoding".to_string()));
            }
            return Ok(Pt { x: x, y: y, inf: false });
        }
        if data[0] == 4u8 and has_enc(valid, "uncompressed") {
            return Ok(Pt { x: x, y: y, inf: false });
        }
        return Err(malformed("Invalid X9.62 encoding of the public point".to_string()));
    }
    if key_len == raw_len / 2 + 1 and has_enc(valid, "compressed") {
        return from_compressed(data, c);
    }
    Err(malformed(f"Length of string does not match lengths of any of the enabled ({join(valid, ", ")}) encodings of the curve."))
}

fn encodings(names: Str) -> Vec[String] {
    split_on(names, 44u8)
}

// Curve.to_der(encoding, point_encoding)
fn curve_to_der(c: ref Curve, encoding0: Str, point_encoding: Str) -> Result[Vec[u8], Exc] {
    let encoding = if encoding0.len() > 0 { encoding0.to_string() } else if c.oid.len() > 0 { "named_curve".to_string() } else { "explicit".to_string() };
    if encoding != "named_curve" and encoding != "explicit" {
        return Err(exc("ValueError", "Only 'named_curve' and 'explicit' encodings supported".to_string()));
    }
    if encoding == "named_curve" {
        if c.oid.len() == 0 {
            return Err(exc("UnknownCurveError", "Can't encode curve using named_curve encoding without associated curve OID".to_string()));
        }
        return Ok(encode_oid(c.oid));
    }
    not_ported(c)?;
    let p = ref c.p;
    let mut field: Vec[Vec[u8]] = Vec.new();
    field.push(encode_oid([1, 2, 840, 10045, 1, 1].to_vec()));
    field.push(encode_integer(p));
    let mut coeffs: Vec[Vec[u8]] = Vec.new();
    coeffs.push(encode_octet_string(number_to_string(bn_mod(c.a, p), p)?));
    coeffs.push(encode_octet_string(number_to_string(bn_mod(c.b, p), p)?));
    let mut seq: Vec[Vec[u8]] = Vec.new();
    seq.push(encode_integer(bn(1)));
    seq.push(encode_sequence(field));
    seq.push(encode_sequence(coeffs));
    seq.push(encode_octet_string(point_to_bytes(generator(c), c, point_encoding)?));
    seq.push(encode_integer(c.n));
    if c.has_h and not bn_is_zero(c.h) {
        seq.push(encode_integer(c.h));
    }
    Ok(encode_sequence(seq))
}

// Curve.from_der: a named curve's OID, or explicit parameters, matched
// against the known curves.
fn curve_from_der(cs: ref Vec[Curve], data: ref Vec[u8]) -> Result[Curve, Exc] {
    if not is_sequence(data) {
        let (oid, empty) = remove_object(data)?;
        if empty.len() > 0 {
            return Err(unexpected("Unexpected data after OID".to_string()));
        }
        return find_curve(cs, oid);
    }
    let (seq, empty) = remove_sequence(data)?;
    if empty.len() > 0 {
        return Err(unexpected("Unexpected data after ECParameters structure".to_string()));
    }
    let (version, rest1) = remove_integer(seq)?;
    if not bn_eq_small(version, 1) {
        return Err(unexpected("Unknown parameter encoding format".to_string()));
    }
    let (field_id, rest2) = remove_sequence(rest1)?;
    let (curve, rest3) = remove_sequence(rest2)?;
    let (base_bytes, rest4) = remove_octet_string(rest3)?;
    let (order, rest5) = remove_integer(rest4)?;
    let mut cofactor: Vec[u64] = Vec.new();
    let mut has_h = false;
    if rest5.len() > 0 {
        cofactor = remove_integer(rest5)?.0;
        has_h = true;
    }
    let (field_type, rest6) = remove_object(field_id)?;
    if field_type == [1, 2, 840, 10045, 1, 2].to_vec() {
        return Err(exc("UnknownCurveError", "Characteristic 2 curves unsupported".to_string()));
    }
    if field_type != [1, 2, 840, 10045, 1, 1].to_vec() {
        return Err(exc("UnknownCurveError", f"Unknown field type: {oid_tuple(field_type)}"));
    }
    let (prime, empty2) = remove_integer(rest6)?;
    if empty2.len() > 0 {
        return Err(unexpected("Unexpected data after ECParameters.fieldID.Prime-p element".to_string()));
    }
    let (a_bytes, rest7) = remove_octet_string(curve)?;
    let (b_bytes, _) = remove_octet_string(rest7)?;
    let shell = make_curve("unknown", "", Vec.new(), prime, bn_from_bytes(a_bytes), bn_from_bytes(b_bytes), Vec.new(), Vec.new(), order, cofactor, has_h);
    let g = point_from_bytes(shell, base_bytes, true, encodings("uncompressed,compressed,hybrid"))?;
    let tmp = make_curve("unknown", "", Vec.new(), shell.p.clone(), shell.a.clone(), shell.b.clone(), g.x.clone(), g.y.clone(), shell.n.clone(), shell.h.clone(), has_h);
    for c in cs {
        if curve_eq(tmp, c) {
            return Ok(c.clone());
        }
    }
    Ok(tmp)
}

// ----------------------------------------------------------- hashes, hmac

fn hash_digest(name: Str, m: ref Vec[u8]) -> Vec[u8] {
    if name == "sha1" {
        sha1(m)
    } else if name == "sha224" {
        sha256_family(m, true)
    } else if name == "sha256" {
        sha256_family(m, false)
    } else if name == "sha384" {
        sha512_family(m, true)
    } else {
        sha512_family(m, false)
    }
}

fn digest_size(name: Str) -> i64 {
    if name == "sha1" {
        20
    } else if name == "sha224" {
        28
    } else if name == "sha256" {
        32
    } else if name == "sha384" {
        48
    } else {
        64
    }
}

fn hmac(name: Str, key: ref Vec[u8], msg: ref Vec[u8]) -> Vec[u8] {
    let block = if name == "sha384" or name == "sha512" { 128 } else { 64 };
    let mut k = if key.len() > block { hash_digest(name, key) } else { key.clone() };
    while k.len() < block {
        k.push(0u8);
    }
    let mut inner: Vec[u8] = Vec.new();
    let mut outer: Vec[u8] = Vec.new();
    for c in k {
        inner.push(c ^ 0x36u8);
        outer.push(c ^ 0x5Cu8);
    }
    let ih = hash_digest(name, cat(inner, msg));
    hash_digest(name, cat(outer, ih))
}

// ---------------------------------------------------------------- keys.py

// A VerifyingKey, or a SigningKey (is_private, with its secret d). hash is
// the default hash function's name, empty for None.
#[derive(Clone)]
struct Key {
    curve: Curve,
    hash: String,
    q: Pt,
    is_private: bool,
    d: Vec[u64],
}

fn oid_ec_public_key() -> Vec[i64] {
    [1, 2, 840, 10045, 2, 1].to_vec()
}

fn is_eddsa_oid(oid: ref Vec[i64]) -> bool {
    *oid == [1, 3, 101, 112].to_vec() or *oid == [1, 3, 101, 113].to_vec()
}

// VerifyingKey.from_public_point; ecdsa.Public_key's checks all come out
// as the same MalformedPointError.
fn vk_from_point(curve: ref Curve, q: ref Pt, hash: Str, validate: bool) -> Result[Key, Exc] {
    not_ported(curve)?;
    if q.inf {
        return Err(exc("TypeError", "'<=' not supported between instances of 'int' and 'NoneType'".to_string()));
    }
    let bad = "Point does not lay on the curve";
    if bn_cmp(q.x, curve.p) >= 0 or bn_cmp(q.y, curve.p) >= 0 {
        return Err(malformed(bad.to_string()));
    }
    if validate and not contains_point(curve, q.x, q.y) {
        return Err(malformed(bad.to_string()));
    }
    if validate and not (curve.has_h and bn_eq_small(curve.h, 1)) {
        if not pt_mul(q, curve.n, curve)?.inf {
            return Err(malformed(bad.to_string()));
        }
    }
    Ok(Key { curve: curve.clone(), hash: hash.to_string(), q: q.clone(), is_private: false, d: Vec.new() })
}

fn vk_from_string(curve: ref Curve, s: ref Vec[u8], hash: Str, valid: ref Vec[String]) -> Result[Key, Exc] {
    not_ported(curve)?;
    let q = point_from_bytes(curve, s, true, valid)?;
    vk_from_point(curve, q, hash, true)
}

fn vk_to_string(k: ref Key, encoding: Str) -> Result[Vec[u8], Exc] {
    point_to_bytes(k.q, k.curve, encoding)
}

fn hash_label(h: Str) -> String {
    if h.len() == 0 { "None".to_string() } else { h.to_string() }
}

fn vk_repr(k: ref Key) -> Result[String, Exc] {
    Ok(f"VerifyingKey.from_string({bytes_repr(vk_to_string(k, "compressed")?)}, {k.curve.name}, {hash_label(k.hash)})")
}

fn vk_eq(x: ref Key, y: ref Key) -> bool {
    curve_eq(x.curve, y.curve) and pt_eq(x.q, y.q)
}

fn vk_to_der(k: ref Key, point_encoding: Str, curve_encoding: Str) -> Result[Vec[u8], Exc] {
    if point_encoding == "raw" {
        return Err(exc("ValueError", "raw point_encoding not allowed in DER".to_string()));
    }
    let point_str = vk_to_string(k, point_encoding)?;
    let mut alg: Vec[Vec[u8]] = Vec.new();
    alg.push(encode_oid(oid_ec_public_key()));
    alg.push(curve_to_der(k.curve, curve_encoding, point_encoding)?);
    let mut seq: Vec[Vec[u8]] = Vec.new();
    seq.push(encode_sequence(alg));
    seq.push(encode_bitstring(point_str));
    Ok(encode_sequence(seq))
}

fn vk_to_pem(k: ref Key, point_encoding: Str, curve_encoding: Str) -> Result[String, Exc] {
    Ok(topem(vk_to_der(k, point_encoding, curve_encoding)?, "PUBLIC KEY"))
}

fn vk_from_der(cs: ref Vec[Curve], s: ref Vec[u8], hash: Str) -> Result[Key, Exc] {
    let (s1, empty) = remove_sequence(s)?;
    if empty.len() > 0 {
        return Err(unexpected(f"trailing junk after DER pubkey: {hexlify_str(empty)}"));
    }
    let (s2, point_bits) = remove_sequence(s1)?;
    let (oid_pk, rest) = remove_object(s2)?;
    if is_eddsa_oid(oid_pk) {
        return Err(exc("NotImplementedError", "EdDSA keys are not ported".to_string()));
    }
    if oid_pk != oid_ec_public_key() {
        return Err(unexpected(f"Unexpected object identifier in DER encoding: {oid_tuple(oid_pk)}"));
    }
    let curve = curve_from_der(cs, rest)?;
    let (point_str, empty2) = remove_bitstring(point_bits)?;
    if empty2.len() > 0 {
        return Err(unexpected(f"trailing junk after pubkey pointstring: {hexlify_str(empty2)}"));
    }
    if point_str.len() == curve.vk_len {
        return Err(unexpected("Malformed encoding of public point".to_string()));
    }
    vk_from_string(curve, point_str, hash, encodings("uncompressed,compressed,hybrid"))
}

fn vk_from_pem(cs: ref Vec[Curve], s: ref Vec[u8], hash: Str) -> Result[Key, Exc] {
    vk_from_der(cs, unpem(s)?, hash)
}

fn sk_from_secret(curve: ref Curve, d: ref Vec[u64], hash: Str) -> Result[Key, Exc] {
    not_ported(curve)?;
    if bn_is_zero(d) or bn_cmp(d, curve.n) >= 0 {
        return Err(malformed(f"Invalid value for secexp, expected integer between 1 and {bn_str(curve.n)}"));
    }
    let q = pt_mul(generator(curve), d, curve)?;
    let mut k = vk_from_point(curve, q, hash, false)?;
    k.is_private = true;
    k.d = d.clone();
    Ok(k)
}

fn sk_from_string(curve: ref Curve, s: ref Vec[u8], hash: Str) -> Result[Key, Exc] {
    if s.len() != curve.baselen {
        return Err(malformed(f"Invalid length of private key, received {s.len()}, expected {curve.baselen}"));
    }
    sk_from_secret(curve, bn_from_bytes(s), hash)
}

fn sk_from_der(cs: ref Vec[Curve], s0: ref Vec[u8], hash: Str) -> Result[Key, Exc] {
    let (s1, empty) = remove_sequence(s0)?;
    if empty.len() > 0 {
        return Err(unexpected(f"trailing junk after DER privkey: {hexlify_str(empty)}"));
    }
    let (v1, s2) = remove_integer(s1)?;
    let mut version = v1;
    let mut s = s2;
    let mut curve: Option[Curve] = None;
    if is_sequence(s) {
        if bn_cmp(version, bn(1)) > 0 {
            return Err(unexpected(f"expected version '0' or '1' at start of privkey, got {bn_str(version)}"));
        }
        let (sequence, s3) = remove_sequence(s)?;
        let (algorithm_oid, algorithm_identifier) = remove_object(sequence)?;
        if is_eddsa_oid(algorithm_oid) {
            return Err(exc("NotImplementedError", "EdDSA keys are not ported".to_string()));
        }
        if algorithm_oid != oid_ec_public_key() and algorithm_oid != [1, 3, 132, 1, 12].to_vec() and algorithm_oid != [1, 3, 132, 1, 13].to_vec() {
            return Err(unexpected(f"unexpected algorithm identifier '{oid_tuple(algorithm_oid)}'"));
        }
        curve = Some(curve_from_der(cs, algorithm_identifier)?);
        let (s4, _) = remove_octet_string(s3)?;
        let (s5, empty2) = remove_sequence(s4)?;
        if empty2.len() > 0 {
            return Err(unexpected(f"trailing junk after DER privkey: {hexlify_str(empty2)}"));
        }
        let (v2, s6) = remove_integer(s5)?;
        version = v2;
        s = s6;
    }
    if not bn_eq_small(version, 1) {
        return Err(unexpected(f"expected version '1' at start of DER privkey, got {bn_str(version)}"));
    }
    let (privkey_str, s7) = remove_octet_string(s)?;
    let c = match curve {
        Some(c) => c,
        None => {
            let (tag, curve_oid_str, _) = remove_constructed(s7)?;
            if tag != 0 {
                return Err(unexpected(f"expected tag 0 in DER privkey, got {tag}"));
            }
            curve_from_der(cs, curve_oid_str)?
        }
    };
    let mut padded: Vec[u8] = Vec.new();
    while padded.len() + privkey_str.len() < c.baselen {
        padded.push(0u8);
    }
    sk_from_string(c, cat(padded, privkey_str), hash)
}

fn sk_from_pem(cs: ref Vec[Curve], b: ref Vec[u8], hash: Str) -> Result[Key, Exc] {
    let mut at = bytes_find(b, "-----BEGIN EC PRIVATE KEY-----");
    if at == -1 {
        at = bytes_find(b, "-----BEGIN PRIVATE KEY-----");
        if at == -1 {
            return Err(exc("ValueError", "subsection not found".to_string()));
        }
    }
    sk_from_der(cs, unpem(tail(b, at))?, hash)
}

fn sk_to_string(k: ref Key) -> Result[Vec[u8], Exc] {
    number_to_string(k.d, k.curve.n)
}

fn sk_to_der(k: ref Key, point_encoding: Str, format: Str, curve_encoding: Str) -> Result[Vec[u8], Exc] {
    if point_encoding == "raw" {
        return Err(exc("ValueError", "raw encoding not allowed in DER".to_string()));
    }
    let encoded_vk = vk_to_string(k, point_encoding)?;
    let mut elems: Vec[Vec[u8]] = Vec.new();
    elems.push(encode_integer(bn(1)));
    elems.push(encode_octet_string(sk_to_string(k)?));
    if format == "ssleay" {
        elems.push(encode_constructed(0, curve_to_der(k.curve, curve_encoding, "uncompressed")?));
    }
    elems.push(encode_constructed(1, encode_bitstring(encoded_vk)));
    let ec_private_key = encode_sequence(elems);
    if format == "ssleay" {
        return Ok(ec_private_key);
    }
    let mut alg: Vec[Vec[u8]] = Vec.new();
    alg.push(encode_oid(oid_ec_public_key()));
    alg.push(curve_to_der(k.curve, curve_encoding, "uncompressed")?);
    let mut outer: Vec[Vec[u8]] = Vec.new();
    outer.push(encode_integer(bn(1)));
    outer.push(encode_sequence(alg));
    outer.push(encode_octet_string(ec_private_key));
    Ok(encode_sequence(outer))
}

fn sk_to_pem(k: ref Key, point_encoding: Str, format: Str, curve_encoding: Str) -> Result[String, Exc] {
    let header = if format == "ssleay" { "EC PRIVATE KEY" } else { "PRIVATE KEY" };
    Ok(topem(sk_to_der(k, point_encoding, format, curve_encoding)?, header))
}

// util.randrange(order, os.urandom)
fn randrange(rng: mut ref Rng, order: ref Vec[u64]) -> Vec[u64] {
    let upper_2 = bit_length(bn_sub(order, bn(2)));
    let upper_256 = upper_2 / 8 + 1;
    loop {
        let ent = urandom(mut rng, upper_256);
        let num = bn_add(bn_shr(bn_from_bytes(ent), upper_256 * 8 - upper_2), bn(1));
        if bn_cmp(num, order) < 0 {
            return num;
        }
    }
}

fn generate(rng: mut ref Rng, curve: ref Curve, hash: Str) -> Result[Key, Exc] {
    not_ported(curve)?;
    let d = randrange(mut rng, curve.n);
    sk_from_secret(curve, d, hash)
}

fn truncate_and_convert_digest(digest0: ref Vec[u8], curve: ref Curve, allow_truncate: bool) -> Result[Vec[u64], Exc] {
    let mut digest = digest0.clone();
    if not allow_truncate {
        if digest.len() > curve.baselen {
            return Err(exc("BadDigestError", f"this curve ({curve.name}) is too short for the length of your digest ({8 * digest.len()})"));
        }
    } else {
        digest = sub(digest, 0, curve.baselen);
    }
    let mut number = bn_from_bytes(digest);
    if allow_truncate {
        let max_length = bit_length(curve.n);
        let length = digest.len() * 8;
        if length > max_length {
            number = bn_shr(number, length - max_length);
        }
    }
    Ok(number)
}

// ecdsa.Private_key.sign, with k as given.
fn sign_number(k: ref Key, number: ref Vec[u64], kk: ref Vec[u64]) -> Result[(Vec[u64], Vec[u64]), Exc] {
    let n = ref k.curve.n;
    if bn_is_zero(kk) or bn_cmp(kk, n) >= 0 {
        return Err(exc("AssertionError", String.new()));
    }
    let p1 = pt_mul(generator(k.curve), bn_mod(kk, n), k.curve)?;
    let r = bn_mod(p1.x, n);
    if bn_is_zero(r) {
        return Err(exc("RSZeroError", "amazingly unlucky random number r".to_string()));
    }
    let kinv = inverse_mod(kk, n)?;
    let s = bn_mod(bn_mul(kinv, bn_add(number, bn_mod(bn_mul(k.d, r), n))), n);
    if bn_is_zero(s) {
        return Err(exc("RSZeroError", "amazingly unlucky random number s".to_string()));
    }
    Ok((r, s))
}

fn sign_digest(k: ref Key, digest: ref Vec[u8], kk: ref Vec[u64], allow_truncate: bool) -> Result[(Vec[u64], Vec[u64]), Exc] {
    let number = truncate_and_convert_digest(digest, k.curve, allow_truncate)?;
    sign_number(k, number, kk)
}

// --------------------------------------------------------------- rfc6979.py

fn bits2int(data: ref Vec[u8], qlen: i64) -> Vec[u64] {
    let x = bn_from_bytes(data);
    let l = data.len() * 8;
    if l > qlen { bn_shr(x, l - qlen) } else { x }
}

fn bits2octets(data: ref Vec[u8], order: ref Vec[u64]) -> Vec[u8] {
    let z1 = bits2int(data, bit_length(order));
    let z2 = if bn_cmp(z1, order) >= 0 { bn_sub(z1, order) } else { z1 };
    bn_to_bytes(z2, orderlen(order))
}

fn byte_run(c: u8, n: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for _ in 0..n {
        out.push(c);
    }
    out
}

fn generate_k(order: ref Vec[u64], secexp: ref Vec[u64], hname: Str, data: ref Vec[u8], retry0: i64) -> Result[Vec[u64], Exc] {
    let mut retry_gen = retry0;
    let qlen = bit_length(order);
    let holen = digest_size(hname);
    let rolen = (qlen + 7) / 8;
    let bx = cat(number_to_string(secexp, order)?, bits2octets(data, order));
    let mut v = byte_run(1u8, holen);
    let mut k = byte_run(0u8, holen);
    k = hmac(hname, k, cat(cat(v, byte_run(0u8, 1)), bx));
    v = hmac(hname, k, v);
    k = hmac(hname, k, cat(cat(v, byte_run(1u8, 1)), bx));
    v = hmac(hname, k, v);
    loop {
        let mut t: Vec[u8] = Vec.new();
        while t.len() < rolen {
            v = hmac(hname, k, v);
            t = cat(t, v);
        }
        let secret = bits2int(t, qlen);
        if not bn_is_zero(secret) and bn_cmp(secret, order) < 0 {
            if retry_gen <= 0 {
                return Ok(secret);
            }
            retry_gen -= 1;
        }
        k = hmac(hname, k, cat(v, byte_run(0u8, 1)));
        v = hmac(hname, k, v);
    }
}

fn sign_digest_deterministic(k: ref Key, digest: ref Vec[u8], hname: Str, allow_truncate: bool) -> Result[(Vec[u64], Vec[u64]), Exc] {
    let mut retry = 0;
    loop {
        let kk = generate_k(k.curve.n, k.d, hname, digest, retry)?;
        match sign_digest(k, digest, kk, allow_truncate) {
            Ok(rs) => {
                return Ok(rs);
            }
            Err(e) => {
                if e.cls != "RSZeroError" {
                    return Err(e);
                }
                retry += 1;
            }
        }
    }
}

// ----------------------------------------------------- util.sigencode/decode

fn sigencode(name: Str, r: ref Vec[u64], s0: ref Vec[u64], order: ref Vec[u64]) -> Result[Vec[u8], Exc] {
    if name == "string" {
        return Ok(cat(number_to_string(r, order)?, number_to_string(s0, order)?));
    }
    let s = if name == "canon" and bn_cmp(bn_shl(s0, 1), order) > 0 { bn_sub(order, s0) } else { s0.clone() };
    let mut parts: Vec[Vec[u8]] = Vec.new();
    parts.push(encode_integer(r));
    parts.push(encode_integer(s));
    Ok(encode_sequence(parts))
}

fn sigdecode(name: Str, sig: ref Vec[u8], order: ref Vec[u64]) -> Result[(Vec[u64], Vec[u64]), Exc] {
    if name == "string" {
        let l = orderlen(order);
        if sig.len() != 2 * l {
            return Err(exc("MalformedSignature", f"Invalid length of signature, expected {2 * l} bytes long, provided string is {sig.len()} bytes long"));
        }
        return Ok((bn_from_bytes(sub(sig, 0, l)), bn_from_bytes(tail(sig, l))));
    }
    let (rs, empty) = remove_sequence(sig)?;
    if empty.len() > 0 {
        return Err(unexpected(f"trailing junk after DER sig: {hexlify_str(empty)}"));
    }
    let (r, rest) = remove_integer(rs)?;
    let (s, empty2) = remove_integer(rest)?;
    if empty2.len() > 0 {
        return Err(unexpected(f"trailing junk after DER numbers: {hexlify_str(empty2)}"));
    }
    Ok((r, s))
}

// ecdsa.Public_key.verifies
fn verifies(k: ref Key, number: ref Vec[u64], r: ref Vec[u64], s: ref Vec[u64]) -> Result[bool, Exc] {
    let n = ref k.curve.n;
    if bn_is_zero(r) or bn_cmp(r, n) >= 0 or bn_is_zero(s) or bn_cmp(s, n) >= 0 {
        return Ok(false);
    }
    let c = inverse_mod(s, n)?;
    let u1 = bn_mod(bn_mul(number, c), n);
    let u2 = bn_mod(bn_mul(r, c), n);
    let xy = pt_mul_add(generator(k.curve), u1, k.q, u2, k.curve)?;
    if xy.inf {
        return Err(exc("TypeError", "unsupported operand type(s) for %: 'NoneType' and 'int'".to_string()));
    }
    Ok(bn_mod(xy.x, n) == *r)
}

fn verify_digest(k: ref Key, sig: ref Vec[u8], digest: ref Vec[u8], decoding: Str, allow_truncate: bool) -> Result[(), Exc] {
    let number = truncate_and_convert_digest(digest, k.curve, allow_truncate)?;
    let (r, s) = match sigdecode(decoding, sig, k.curve.n) {
        Ok(rs) => rs,
        Err(e) => {
            if e.cls == "UnexpectedDER" or e.cls == "MalformedSignature" {
                return Err(exc_wrap("BadSignatureError", "Malformed formatting of signature", e));
            }
            return Err(e);
        }
    };
    if verifies(k, number, r, s)? {
        return Ok(());
    }
    Err(exc("BadSignatureError", "Signature verification failed".to_string()))
}

fn verify(k: ref Key, sig: ref Vec[u8], data: ref Vec[u8], hname: Str, decoding: Str) -> Result[(), Exc] {
    verify_digest(k, sig, hash_digest(hname, data), decoding, true)
}

// VerifyingKey.from_public_key_recovery: the two keys that could have made
// the signature.
fn recover(sig: ref Vec[u8], data: ref Vec[u8], curve: ref Curve, hname: Str) -> Result[Vec[Key], Exc] {
    not_ported(curve)?;
    let n = ref curve.n;
    let p = ref curve.p;
    let (r, s) = sigdecode("string", sig, n)?;
    let e = truncate_and_convert_digest(hash_digest(hname, data), curve, true)?;
    let x = bn_mod(r, p);
    let alpha = f_add(f_mul(f_add(f_mul(x, x, p), bn_mod(curve.a, p), p), x, p), bn_mod(curve.b, p), p);
    let beta = square_root_mod_prime(alpha, p)?;
    let y = if bn_is_odd(beta) { bn_sub(p, beta) } else { beta };
    let em = bn_mod(e, n);
    let neg_e = if bn_is_zero(em) { em } else { bn_sub(n, em) };
    let rinv = inverse_mod(r, n)?;
    let mut out: Vec[Key] = Vec.new();
    // r^-1 (s R - e G) for R = (x, y) and (x, -y).
    let (q0, q1) = pt_mul_add_pair(pt(r, y), bn_mod(bn_mul(s, rinv), n), generator(curve), bn_mod(bn_mul(neg_e, rinv), n), curve)?;
    for q in [q0, q1] {
        if q.inf {
            return Err(exc("TypeError", "'<=' not supported between instances of 'int' and 'NoneType'".to_string()));
        }
        if not contains_point(curve, q.x, q.y) {
            return Err(exc("InvalidPointError", "Point does not lay on the curve".to_string()));
        }
        out.push(vk_from_point(curve, q, hname, true)?);
    }
    Ok(out)
}

// ECDH(private_key=a), load_received_public_key(b), then
// generate_sharedsecret_bytes().
fn ecdh(a: ref Key, b: ref Key) -> Result[Vec[u8], Exc] {
    if not curve_eq(a.curve, b.curve) {
        return Err(exc("InvalidCurveError", "Curve mismatch.".to_string()));
    }
    let shared = pt_mul(b.q, a.d, a.curve)?;
    if shared.inf {
        return Err(exc("InvalidSharedSecretError", "Invalid shared secret (INFINITY).".to_string()));
    }
    number_to_string(shared.x, a.curve.p)
}

// ------------------------------------------------------------------ jobs

const HEADER: Str = "{\"alg\":\"ES256\",\"typ\":\"JWT\"}";

fn read_file(path: Str) -> Vec[u8] {
    match fs.read_bytes(f"data/{path}") {
        Ok(b) => b,
        Err(_) => Vec.new(),
    }
}

fn key_index(keys: ref Vec[(String, Key)], name: Str) -> i64 {
    let mut i = 0;
    while i < keys.len() {
        if keys[i].0 == name {
            return i;
        }
        i += 1;
    }
    -1
}

fn put_key(keys: mut ref Vec[(String, Key)], name: Str, k: own Key) {
    let at = key_index(keys, name);
    if at >= 0 {
        keys[at].1 = k;
    } else {
        keys.push((name.to_string(), k));
    }
}

fn get_key(keys: ref Vec[(String, Key)], name: Str) -> Result[Key, Exc] {
    let at = key_index(keys, name);
    if at < 0 {
        return Err(exc("KeyError", py_repr(name)));
    }
    Ok(keys[at].1.clone())
}

fn words_from(w: ref Vec[String], from: i64) -> Vec[u8] {
    let mut parts: Vec[String] = Vec.new();
    let mut i = from;
    while i < w.len() {
        parts.push(w[i].clone());
        i += 1;
    }
    to_bytes(join(parts, " "))
}

fn print_block(s: Str) {
    for line in split_on(s, 10u8) {
        if line.len() > 0 {
            println(f"  {line}");
        }
    }
}

fn py_bool(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

fn all_encodings() -> Vec[String] {
    encodings("uncompressed,compressed,hybrid,raw")
}

fn run_job(cs: ref Vec[Curve], rng: mut ref Rng, keys: mut ref Vec[(String, Key)], sig: mut ref Vec[u8], w0: ref Vec[String]) -> Result[(), Exc] {
    let mut w = w0.clone();
    let cmd = w[0].clone();
    if cmd == "seed" {
        rng.state = py_int(w[1]).unwrap() as u64;
    } else if cmd == "curves" {
        let mut i = 1;
        while i < w.len() {
            let c = curve_by_name(cs, w[i])?;
            let mut oid: Vec[String] = Vec.new();
            for n in c.oid {
                oid.push(f"{n}");
            }
            println(f"  {c.name} ({c.openssl}): baselen {c.baselen}, public key {c.vk_len} bytes, signature {2 * c.baselen} bytes, oid {join(oid, ".")}");
            i += 1;
        }
    } else if cmd == "curve" {
        let c = curve_by_name(cs, w[1])?;
        println(f"  {c.name}, order {bn_bits(c.n)} bits");
    } else if cmd == "genkey" {
        let k = generate(mut rng, curve_by_name(cs, w[2])?, w[3])?;
        println(f"  secret {hex_of(sk_to_string(k)?)}");
        put_key(mut keys, w[1], k);
    } else if cmd == "secret" {
        let k = sk_from_secret(curve_by_name(cs, w[2])?, bn_from_hex(w[3]), "sha256")?;
        println(f"  public {hex_of(vk_to_string(k, "compressed")?)}");
        put_key(mut keys, w[1], k);
    } else if cmd == "show" {
        println(f"  {vk_repr(get_key(keys, w[1])?)?}");
    } else if cmd == "encodings" {
        let k = get_key(keys, w[1])?;
        for enc in ["raw", "uncompressed", "compressed", "hybrid"] {
            println(f"  {enc} {hex_of(vk_to_string(k, enc)?)}");
        }
    } else if cmd == "pem" {
        let k = get_key(keys, w[1])?;
        print_block(sk_to_pem(k, w[3], w[2], w[4])?);
        print_block(vk_to_pem(k, w[3], w[4])?);
    } else if cmd == "der" {
        let k = get_key(keys, w[1])?;
        println(f"  private {hex_of(sk_to_der(k, "uncompressed", "ssleay", "")?)}");
        println(f"  public  {hex_of(vk_to_der(k, "uncompressed", "")?)}");
    } else if cmd == "load" {
        let k = sk_from_pem(cs, read_file(w[2]), "sha1")?;
        println(f"  {k.curve.name} key, secret {hex_of(sk_to_string(k)?)}");
        put_key(mut keys, w[1], k);
    } else if cmd == "loadpub" {
        let k = vk_from_pem(cs, read_file(w[2]), "sha1")?;
        println(f"  {k.curve.name} key {hex_of(vk_to_string(k, "compressed")?)}");
        put_key(mut keys, w[1], k);
    } else if cmd == "same" {
        let a = get_key(keys, w[1])?;
        let b = get_key(keys, w[2])?;
        println(f"  {py_bool(vk_eq(a, b))}");
    } else if cmd == "sign" or cmd == "signk" or cmd == "signrand" or cmd == "digest" {
        let k = get_key(keys, w[1])?;
        let mut given: Vec[u64] = Vec.new();
        if cmd == "signk" {
            given = bn_parse(w[2]);
            let _ = w.remove(2);
        }
        let h = w[2].clone();
        let msg = words_from(w, 4);
        let digest = hash_digest(h, msg);
        let (r, s) = if cmd == "sign" {
            sign_digest_deterministic(k, digest, h, true)?
        } else if cmd == "signk" {
            sign_digest(k, digest, given, true)?
        } else if cmd == "signrand" {
            let number = truncate_and_convert_digest(digest, k.curve, true)?;
            let kk = randrange(mut rng, k.curve.n);
            sign_number(k, number, kk)?
        } else {
            let number = truncate_and_convert_digest(digest, k.curve, false)?;
            let kk = randrange(mut rng, k.curve.n);
            sign_number(k, number, kk)?
        };
        let out = sigencode(w[3], r, s, k.curve.n)?;
        println(f"  {out.len()} bytes {hex_of(out)}");
        *sig = out;
    } else if cmd == "verify" {
        let k = get_key(keys, w[1])?;
        verify(k, sig, words_from(w, 4), w[2], w[3])?;
        println("  True");
    } else if cmd == "badsig" {
        let k = get_key(keys, w[1])?;
        verify(k, hex_decode(w[2]), to_bytes("hello"), k.hash, "der")?;
        println("  True");
    } else if cmd == "recover" {
        let k = get_key(keys, w[1])?;
        for vk in recover(sig, words_from(w, 3), k.curve, w[2])? {
            let mark = if vk_eq(vk, k) { " (the signer)" } else { "" };
            println(f"  {hex_of(vk_to_string(vk, "compressed")?)}{mark}");
        }
    } else if cmd == "point" {
        let encs = if w[2] == "-" { all_encodings() } else { encodings(w[2]) };
        let k = vk_from_string(curve_by_name(cs, w[1])?, hex_decode(w[3]), "sha1", encs)?;
        println(f"  {hex_of(vk_to_string(k, "uncompressed")?)}");
    } else if cmd == "ecdh" {
        let a = get_key(keys, w[1])?;
        let b = get_key(keys, w[2])?;
        println(f"  {hex_of(ecdh(a, b)?)}");
    } else if cmd == "!tokens" {
        tokens(get_key(keys, w[1])?, read_file(w[2]), read_file(w[3]), get_key(keys, w[4])?)?;
    } else if cmd == "!ledger" {
        ledger(cs, read_file(w[1]), read_file(w[2]))?;
    }
    Ok(())
}

fn text_lines(b: ref Vec[u8]) -> Vec[String] {
    split_on(from_bytes(b.clone()), 10u8)
}

fn decode_text(s: Str) -> Result[String, Exc] {
    Ok(from_bytes(b64url_decode(s)?))
}

// The issuer signs each claim as an ES256 token; then each presented token
// is checked against the issuer's public key.
fn tokens(issuer: ref Key, claims: ref Vec[u8], presented: ref Vec[u8], vk: ref Key) -> Result[(), Exc] {
    for cl in text_lines(claims) {
        if cl.len() == 0 {
            continue;
        }
        let head = f"{b64url_encode(to_bytes(HEADER))}.{b64url_encode(to_bytes(cl))}";
        let h = to_bytes(head);
        let (r, s) = sign_digest_deterministic(issuer, hash_digest("sha256", h), "sha256", true)?;
        let sig = sigencode("string", r, s, issuer.curve.n)?;
        println(f"  issued {cl}");
        println(f"    {head}.{b64url_encode(sig)}");
    }
    for tok in text_lines(presented) {
        if tok.len() == 0 {
            continue;
        }
        let parts = split_on(tok, 46u8);
        if parts.len() != 3 {
            println(f"  {tok}: malformed");
            continue;
        }
        let header = decode_text(parts[0])?;
        if header != HEADER {
            println(f"  unsupported header {header}");
            continue;
        }
        let payload = decode_text(parts[1])?;
        let signed = to_bytes(f"{parts[0]}.{parts[1]}");
        match verify(vk, b64url_decode(parts[2])?, signed, "sha256", "string") {
            Ok(_) => println(f"  valid {payload}"),
            Err(e) => {
                if e.cls != "BadSignatureError" {
                    return Err(e);
                }
                println(f"  REJECTED {payload}: {e.msg}");
            }
        }
    }
    Ok(())
}

// Accounts with opening balances, and entries whose signer is recovered
// from the signature and must be the account the money leaves.
fn ledger(cs: ref Vec[Curve], accounts: ref Vec[u8], entries: ref Vec[u8]) -> Result[(), Exc] {
    let curve = curve_by_name(cs, "SECP256k1")?;
    let mut names: Vec[String] = Vec.new();
    let mut balance: Vec[i64] = Vec.new();
    let mut pubs: Vec[Key] = Vec.new();
    for line in text_lines(accounts) {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, 32u8);
        names.push(f[0].clone());
        balance.push(py_int(f[1]).unwrap());
        pubs.push(vk_from_string(curve, hex_decode(f[2]), "sha256", all_encodings())?);
    }
    for line in text_lines(entries) {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, 124u8);
        let msg = f"{f[0]}|{f[1]}|{f[2]}";
        let cands = match recover(hex_decode(f[3]), to_bytes(msg), curve, "sha256") {
            Ok(c) => c,
            Err(e) => {
                println(f"  {msg}: {e.cls}: {e.msg}");
                continue;
            }
        };
        let mut signer = -1;
        for i in 0..names.len() {
            for c in cands {
                if vk_eq(pubs[i], c) {
                    signer = i;
                }
            }
        }
        let from = key_of(names, f[0]);
        let to = key_of(names, f[1]);
        let amount = py_int(f[2]).unwrap();
        if signer < 0 {
            println(f"  {msg}: unknown signer");
        } else if names[signer] != f[0] {
            println(f"  {msg}: forged, signed by {names[signer]}");
        } else if to < 0 {
            println(f"  {msg}: no account {f[1]}");
        } else if balance[from] < amount {
            println(f"  {msg}: insufficient funds ({balance[from]})");
        } else {
            balance[from] -= amount;
            balance[to] += amount;
            println(f"  {msg}: ok");
        }
    }
    let mut parts: Vec[String] = Vec.new();
    for i in 0..names.len() {
        parts.push(f"{names[i]} {balance[i]}");
    }
    println(f"  balances: {join(parts, ", ")}");
    Ok(())
}

fn key_of(names: ref Vec[String], name: Str) -> i64 {
    for i in 0..names.len() {
        if names[i] == name {
            return i;
        }
    }
    -1
}

fn main() {
    if let Err(e) = write_inputs() {
        eprintln(e);
        return;
    }
    let cs = load_curves();
    let mut rng = Rng { state: 0u64 };
    let mut keys: Vec[(String, Key)] = Vec.new();
    let mut sig: Vec[u8] = Vec.new();
    for hex in split_c(jobs_text(), '\n') {
        if hex.len() == 0 {
            continue;
        }
        let job = hex_string(hex);
        println(f"> {job}");
        let w = split_on(job, 32u8);
        if let Err(e) = run_job(cs, mut rng, mut keys, mut sig, w) {
            println(f"  {e.cls}: {e.msg}");
        }
    }
}

