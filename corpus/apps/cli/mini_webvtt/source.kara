// mini_webvtt: a port of webvtt-py 0.5.1 (MIT, Alejandro Mendez), the
// WebVTT caption library, run as a streaming service's caption desk. The
// jobs read, convert, edit, save and segment caption files held in a small
// in-memory file system rooted at /work. See README.md.

// ------------------------------------------------------------ Python str helpers

fn hex_digits(n: i64, width: i64) -> String {
    let d: Vec[char] = "0123456789abcdef".chars().collect();
    let mut out = String.new();
    let mut k = width;
    while k > 0 {
        k -= 1;
        out.push(d[(n >> (4 * k)) & 15]);
    }
    out
}

// str.isprintable(), for the characters captions hold.
fn py_printable(c: char) -> bool {
    let n = c as i64;
    if n < 0x20 or (n >= 0x7f and n <= 0xa0) or n == 0xad {
        return false;
    }
    if n == 0x1680 or (n >= 0x2000 and n <= 0x200f) or (n >= 0x2028 and n <= 0x202f) {
        return false;
    }
    if (n >= 0x205f and n <= 0x206f) or n == 0x3000 or n == 0xfeff or (n >= 0xfff9 and n <= 0xfffb) {
        return false;
    }
    not (n >= 0xe000 and n <= 0xf8ff)
}

// repr() of a str.
fn py_repr_str(s: ref String) -> String {
    let q = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if py_printable(c) {
            out.push(c);
        } else {
            let n = c as i64;
            if n < 0x100 {
                out.push_str(f"\\x{hex_digits(n, 2)}");
            } else if n < 0x10000 {
                out.push_str(f"\\u{hex_digits(n, 4)}");
            } else {
                out.push_str(f"\\U{hex_digits(n, 8)}");
            }
        }
    }
    out.push(q);
    out
}

fn opt_repr(o: ref Option[String]) -> String {
    match o {
        Some(s) => py_repr_str(s),
        None => "None".to_string(),
    }
}

// repr() of a list of str.
fn list_repr(xs: ref Vec[String]) -> String {
    let mut out = String.new();
    out.push('[');
    let mut first = true;
    for x in xs {
        if not first {
            out.push_str(", ");
        }
        first = false;
        out.push_str(py_repr_str(x));
    }
    out.push(']');
    out
}

fn py_bool(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

// How the output shows text that may hold control characters.
fn vis(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        let n = c as i64;
        if n < 0x20 or n == 0x7f or (n >= 0x80 and n < 0xa0) {
            out.push_str(f"\\x{hex_digits(n, 2)}");
        } else if n == 0x2028 or n == 0x2029 or n == 0xfeff {
            out.push_str(f"\\u{hex_digits(n, 4)}");
        } else {
            out.push(c);
        }
    }
    out
}

fn is_line_break(c: char) -> bool {
    let n = c as i64;
    (n >= 10 and n <= 13) or (n >= 0x1c and n <= 0x1e) or n == 0x85 or n == 0x2028 or n == 0x2029
}

// str.splitlines().
fn py_splitlines(s: ref String) -> Vec[String] {
    let cs: Vec[char] = s.chars().collect();
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    let mut i = 0;
    while i < cs.len() {
        let c = cs[i];
        if is_line_break(c) {
            out.push(cur);
            cur = String.new();
            if c == '\r' and i + 1 < cs.len() and cs[i + 1] == '\n' {
                i += 1;
            }
        } else {
            cur.push(c);
        }
        i += 1;
    }
    if cur.len() > 0 {
        out.push(cur);
    }
    out
}

// str.split(sep) for a one-character separator: always at least one piece.
fn split_on(s: ref String, sep: char) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn join_lines(xs: ref Vec[String]) -> String {
    let mut out = String.new();
    for i in 0..xs.len() {
        if i > 0 {
            out.push('\n');
        }
        out.push_str(xs[i]);
    }
    out
}

// str.isdigit() for ASCII and fullwidth digits.
fn py_isdigit(s: ref String) -> bool {
    if s.len() == 0 {
        return false;
    }
    for c in s.chars() {
        let n = c as i64;
        if not ((n >= 0x30 and n <= 0x39) or (n >= 0xff10 and n <= 0xff19)) {
            return false;
        }
    }
    true
}

// Python's str.isspace(), which is also what `\s` matches.
fn py_isspace(c: char) -> bool {
    let n = c as i64;
    (n >= 9 and n <= 13) or (n >= 0x1c and n <= 0x20) or n == 0x85 or n == 0xa0 or n == 0x1680
        or (n >= 0x2000 and n <= 0x200a) or n == 0x2028 or n == 0x2029 or n == 0x202f or n == 0x205f
        or n == 0x3000
}

fn chars_str(s: ref Vec[char], a: i64, b: i64) -> String {
    let mut out = String.new();
    for i in a..b {
        out.push(s[i]);
    }
    out
}

// str.strip(), str.rstrip().
fn py_strip(s: ref String) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut a = 0;
    let mut b = cs.len();
    while a < b and py_isspace(cs[a]) {
        a += 1;
    }
    while b > a and py_isspace(cs[b - 1]) {
        b -= 1;
    }
    chars_str(cs, a, b)
}

fn py_rstrip(s: ref String) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut b = cs.len();
    while b > 0 and py_isspace(cs[b - 1]) {
        b -= 1;
    }
    chars_str(cs, 0, b)
}

fn is_blank(s: ref String) -> bool {
    for c in s.chars() {
        if not py_isspace(c) {
            return false;
        }
    }
    true
}

// line.rstrip('\n\r')
fn rstrip_nl(s: ref String) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut b = cs.len();
    while b > 0 and (cs[b - 1] == '\n' or cs[b - 1] == '\r') {
        b -= 1;
    }
    chars_str(cs, 0, b)
}

// f'{n:0<w>d}' for n >= 0.
fn zpad(n: i64, w: i64) -> String {
    let mut s = f"{n}";
    while s.len() < w {
        s = f"0{s}";
    }
    s
}

// Python's // for ints.
fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

#[derive(Clone)]
struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: ref String) -> Exc {
    Exc { kind: kind.to_string(), msg: msg.clone() }
}

// ------------------------------------------------------------ regular expressions
//
// The part of Python's `re` that webvtt-py uses: a backtracking matcher
// with Python's leftmost, priority-ordered semantics. A pattern compiles to
// a small program; Split tries its first branch before its second, which
// is what makes `*` greedy and `*?` lazy. It works on code points, as
// Python's str does.

// `\w`: str.isalnum() or '_'.
fn is_word(c: char) -> bool {
    let n = c as i64;
    if n < 128 {
        return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_';
    }
    c.is_alphanumeric()
}

#[derive(Clone)]
struct Cls {
    ranges: Vec[(i64, i64)],
    space: bool,
    word: bool,
    neg: bool,
}

fn cls_has(k: ref Cls, c: char) -> bool {
    let n = c as i64;
    let mut hit = (k.space and py_isspace(c)) or (k.word and is_word(c));
    for r in k.ranges {
        if n >= r.0 and n <= r.1 {
            hit = true;
        }
    }
    hit != k.neg
}

#[derive(Clone)]
enum Node {
    Char(Cls),
    Any,
    EndZ,
    Seq(Vec[Node]),
    Alt(Vec[Node]),
    Group(i64, Vec[Node]),
    // body (one node), min, max (-1 for none), greedy
    Rep(Vec[Node], i64, i64, bool),
}

#[derive(Clone)]
enum Inst {
    Char(Cls),
    Any,
    EndZ,
    Split(i64, i64),
    Jmp(i64),
    Save(i64),
    Match,
}

struct Re {
    prog: Vec[Inst],
    groups: i64,
    dotall: bool,
}

struct ReParser {
    cs: Vec[char],
    pos: i64,
    groups: i64,
}

fn one(c: char) -> Cls {
    let mut r: Vec[(i64, i64)] = Vec.new();
    r.push((c as i64, c as i64));
    Cls { ranges: r, space: false, word: false, neg: false }
}

impl ReParser {
    fn peek(ref self) -> Option[char] {
        if self.pos < self.cs.len() { Some(self.cs[self.pos]) } else { None }
    }

    fn eat(mut ref self, c: char) -> bool {
        if self.pos < self.cs.len() and self.cs[self.pos] == c {
            self.pos += 1;
            return true;
        }
        false
    }

    fn alt(mut ref self) -> Node {
        let mut arms: Vec[Node] = Vec.new();
        arms.push(self.seq());
        while self.eat('|') {
            arms.push(self.seq());
        }
        if arms.len() == 1 { arms.remove(0) } else { Node.Alt(arms) }
    }

    fn seq(mut ref self) -> Node {
        let mut items: Vec[Node] = Vec.new();
        loop {
            match self.peek() {
                None => break,
                Some(c) => {
                    if c == '|' or c == ')' {
                        break;
                    }
                }
            }
            let atom = self.atom();
            items.push(self.quantified(atom));
        }
        Node.Seq(items)
    }

    fn number(mut ref self) -> i64 {
        let mut n = 0;
        while self.pos < self.cs.len() and self.cs[self.pos] >= '0' and self.cs[self.pos] <= '9' {
            n = n * 10 + (self.cs[self.pos] as i64 - 48);
            self.pos += 1;
        }
        n
    }

    fn quantified(mut ref self, atom: own Node) -> Node {
        let (lo, hi) = match self.peek() {
            Some('*') => {
                self.pos += 1;
                (0, -1)
            }
            Some('+') => {
                self.pos += 1;
                (1, -1)
            }
            Some('?') => {
                self.pos += 1;
                (0, 1)
            }
            Some('{') => {
                self.pos += 1;
                let lo = self.number();
                let hi = if self.eat(',') { self.number() } else { lo };
                self.eat('}');
                (lo, hi)
            }
            _ => return atom,
        };
        let greedy = not self.eat('?');
        let mut body: Vec[Node] = Vec.new();
        body.push(atom);
        Node.Rep(body, lo, hi, greedy)
    }

    fn escape(mut ref self) -> Cls {
        let c = self.cs[self.pos];
        self.pos += 1;
        if c == 's' {
            Cls { ranges: Vec.new(), space: true, word: false, neg: false }
        } else if c == 'w' {
            Cls { ranges: Vec.new(), space: false, word: true, neg: false }
        } else if c == 'd' {
            let mut r: Vec[(i64, i64)] = Vec.new();
            r.push((48, 57));
            Cls { ranges: r, space: false, word: false, neg: false }
        } else if c == 'n' {
            one('\n')
        } else {
            one(c)
        }
    }

    fn class(mut ref self) -> Cls {
        let neg = self.eat('^');
        let mut k = Cls { ranges: Vec.new(), space: false, word: false, neg: neg };
        let mut first = true;
        while first or self.cs[self.pos] != ']' {
            first = false;
            let c = self.cs[self.pos];
            self.pos += 1;
            k.ranges.push((c as i64, c as i64));
        }
        self.pos += 1;
        k
    }

    fn atom(mut ref self) -> Node {
        let c = self.cs[self.pos];
        self.pos += 1;
        if c == '(' {
            let mut capture = true;
            if self.eat('?') {
                capture = false;
                self.eat(':');
            }
            let mut idx = 0;
            if capture {
                self.groups += 1;
                idx = self.groups;
            }
            let inner = self.alt();
            self.eat(')');
            let mut body: Vec[Node] = Vec.new();
            body.push(inner);
            if capture { Node.Group(idx, body) } else { Node.Seq(body) }
        } else if c == '[' {
            Node.Char(self.class())
        } else if c == '.' {
            Node.Any
        } else if c == '\\' {
            if self.eat('Z') { Node.EndZ } else { Node.Char(self.escape()) }
        } else {
            Node.Char(one(c))
        }
    }
}

fn emit_node(prog: mut ref Vec[Inst], n: ref Node) {
    match n {
        Node.Char(k) => prog.push(Inst.Char(k.clone())),
        Node.Any => prog.push(Inst.Any),
        Node.EndZ => prog.push(Inst.EndZ),
        Node.Seq(items) => {
            for x in items {
                emit_node(mut prog, x);
            }
        }
        Node.Alt(arms) => {
            let mut jumps: Vec[i64] = Vec.new();
            for i in 0..arms.len() {
                if i + 1 < arms.len() {
                    let split = prog.len();
                    prog.push(Inst.Split(split + 1, 0));
                    emit_node(mut prog, arms[i]);
                    jumps.push(prog.len());
                    prog.push(Inst.Jmp(0));
                    prog[split] = Inst.Split(split + 1, prog.len());
                } else {
                    emit_node(mut prog, arms[i]);
                }
            }
            let end = prog.len();
            for j in jumps {
                prog[j] = Inst.Jmp(end);
            }
        }
        Node.Group(idx, body) => {
            prog.push(Inst.Save(2 * idx));
            emit_node(mut prog, body[0]);
            prog.push(Inst.Save(2 * idx + 1));
        }
        Node.Rep(body, lo, hi, greedy) => {
            for _ in 0..lo {
                emit_node(mut prog, body[0]);
            }
            if hi < 0 {
                // x*: L: split(body, out); body; jmp L
                let l = prog.len();
                prog.push(Inst.Split(0, 0));
                emit_node(mut prog, body[0]);
                prog.push(Inst.Jmp(l));
                let out = prog.len();
                prog[l] = if greedy { Inst.Split(l + 1, out) } else { Inst.Split(out, l + 1) };
            } else {
                for _ in lo..hi {
                    let l = prog.len();
                    prog.push(Inst.Split(0, 0));
                    emit_node(mut prog, body[0]);
                    let out = prog.len();
                    prog[l] = if greedy { Inst.Split(l + 1, out) } else { Inst.Split(out, l + 1) };
                }
            }
        }
    }
}

fn re_compile(pattern: Str, dotall: bool) -> Re {
    let mut p = ReParser { cs: pattern.chars().collect(), pos: 0, groups: 0 };
    let tree = p.alt();
    let mut prog: Vec[Inst] = Vec.new();
    prog.push(Inst.Save(0));
    emit_node(mut prog, tree);
    prog.push(Inst.Save(1));
    prog.push(Inst.Match);
    Re { prog: prog, groups: p.groups, dotall: dotall }
}

enum Bt {
    Try(i64, i64),
    Restore(i64, i64),
}

// Runs the program at `pos`; the slots hold the group bounds of the first
// way through that reaches Match.
fn re_run(re: ref Re, s: ref Vec[char], pos0: i64, slots: mut ref Vec[i64]) -> bool {
    let mut stack: Vec[Bt] = Vec.new();
    stack.push(Bt.Try(0, pos0));
    while stack.len() > 0 {
        let mut (pc, pos) = match stack.pop().unwrap() {
            Bt.Restore(k, old) => {
                slots[k] = old;
                continue;
            }
            Bt.Try(pc, pos) => (pc, pos),
        };
        loop {
            match re.prog[pc] {
                Inst.Char(k) => {
                    if pos < s.len() and cls_has(k, s[pos]) {
                        pc += 1;
                        pos += 1;
                    } else {
                        break;
                    }
                }
                Inst.Any => {
                    if pos < s.len() and (re.dotall or s[pos] != '\n') {
                        pc += 1;
                        pos += 1;
                    } else {
                        break;
                    }
                }
                Inst.EndZ => {
                    if pos == s.len() { pc += 1; } else { break; }
                }
                Inst.Split(a, b) => {
                    stack.push(Bt.Try(b, pos));
                    pc = a;
                }
                Inst.Jmp(a) => pc = a,
                Inst.Save(k) => {
                    stack.push(Bt.Restore(k, slots[k]));
                    slots[k] = pos;
                    pc += 1;
                }
                Inst.Match => return true,
            }
        }
    }
    false
}

// re.match at `pos`: the group bounds (-1 for a group that took no part),
// or None.
fn re_match_at(re: ref Re, s: ref Vec[char], pos: i64) -> Option[Vec[i64]] {
    let mut slots: Vec[i64] = Vec.new();
    for _ in 0..(2 * re.groups + 2) {
        slots.push(-1);
    }
    if re_run(re, s, pos, mut slots) { Some(slots) } else { None }
}

fn re_match(re: ref Re, text: ref String) -> Option[Vec[String]] {
    let s: Vec[char] = text.chars().collect();
    match re_match_at(re, s, 0) {
        None => None,
        Some(m) => {
            let mut out: Vec[String] = Vec.new();
            for g in 0..(re.groups + 1) {
                if m[2 * g] < 0 {
                    out.push(String.new());
                } else {
                    out.push(chars_str(s, m[2 * g], m[2 * g + 1]));
                }
            }
            Some(out)
        }
    }
}

fn re_search(re: ref Re, s: ref Vec[char], from: i64) -> Option[Vec[i64]] {
    let mut pos = from;
    while pos <= s.len() {
        if let Some(m) = re_match_at(re, s, pos) {
            return Some(m);
        }
        pos += 1;
    }
    None
}

// re.sub with an empty replacement.
fn re_delete(re: ref Re, text: ref String) -> String {
    let s: Vec[char] = text.chars().collect();
    let mut out = String.new();
    let mut last = 0;
    let mut pos = 0;
    while pos <= s.len() {
        match re_search(re, s, pos) {
            None => break,
            Some(m) => {
                out.push_str(chars_str(s, last, m[0]));
                last = m[1];
                pos = if m[1] == m[0] { m[1] + 1 } else { m[1] };
            }
        }
    }
    out.push_str(chars_str(s, last, s.len()));
    out
}

struct Pats {
    ts: Re,
    tags: Re,
    voice: Re,
    vtt_cue: Re,
    comment: Re,
    style: Re,
    srt_cue: Re,
    sbv_cue: Re,
}

fn patterns() -> Pats {
    Pats {
        ts: re_compile("(?:(\\d{1,2}):)?(\\d{1,2}):(\\d{1,2})\\.(\\d{3})", false),
        tags: re_compile("<.*?>", false),
        voice: re_compile("<v(?:\\.\\w+)*\\s+([^>]+)>", false),
        vtt_cue: re_compile("\\s*((?:\\d+:)?\\d{2}:\\d{2}.\\d{3})\\s*-->\\s*((?:\\d+:)?\\d{2}:\\d{2}.\\d{3})", false),
        comment: re_compile("NOTE\\s(.*?)\\Z", true),
        style: re_compile("STYLE\\s(.*?)\\Z", true),
        srt_cue: re_compile("\\s*(\\d+:\\d{2}:\\d{2},\\d{3})\\s*-->\\s*(\\d+:\\d{2}:\\d{2},\\d{3})", false),
        sbv_cue: re_compile("\\s*(\\d{1,2}:\\d{1,2}:\\d{1,2}.\\d{3}),(\\d{1,2}:\\d{1,2}:\\d{1,2}.\\d{3})", false),
    }
}

// ------------------------------------------------------------ models.py

#[derive(Clone)]
struct Ts {
    h: i64,
    m: i64,
    s: i64,
    ms: i64,
}

fn digits_value(s: ref String) -> i64 {
    let mut n = 0;
    for c in s.chars() {
        n = n * 10 + (c as i64 - 48);
    }
    n
}

fn ts_str(t: ref Ts) -> String {
    f"{zpad(t.h, 2)}:{zpad(t.m, 2)}:{zpad(t.s, 2)}.{zpad(t.ms, 3)}"
}

fn ts_repr(t: ref Ts) -> String {
    f"<Timestamp hours={t.h} minutes={t.m} seconds={t.s} milliseconds={t.ms}>"
}

fn ts_seconds(t: ref Ts) -> i64 {
    t.h * 3600 + t.m * 60 + t.s
}

// Tuple order: -1, 0 or 1.
fn ts_cmp(a: ref Ts, b: ref Ts) -> i64 {
    let x: Vec[i64] = vec![a.h, a.m, a.s, a.ms];
    let y: Vec[i64] = vec![b.h, b.m, b.s, b.ms];
    for i in 0..4 {
        if x[i] < y[i] {
            return -1;
        }
        if x[i] > y[i] {
            return 1;
        }
    }
    0
}

fn bad_ts(value: ref String) -> Exc {
    exc("MalformedCaptionError", f"Invalid timestamp {py_repr_str(value)}")
}

// Timestamp.from_string
fn ts_from(p: ref Pats, value: ref String) -> Result[Ts, Exc] {
    let g = match re_match(p.ts, value) {
        Some(g) => g,
        None => return Err(bad_ts(value)),
    };
    let h = if g[1].len() > 0 { digits_value(g[1]) } else { 0 };
    let t = Ts { h: h, m: digits_value(g[2]), s: digits_value(g[3]), ms: digits_value(g[4]) };
    if t.m > 59 or t.s > 59 {
        return Err(bad_ts(value));
    }
    Ok(t)
}

#[derive(Clone)]
struct Cap {
    start: Ts,
    end: Ts,
    ident: Option[String],
    lines: Vec[String],
    comments: Vec[String],
}

fn truthy(o: ref Option[String]) -> Option[String] {
    match o {
        Some(s) => if s.len() > 0 { Some(s.clone()) } else { None },
        None => None,
    }
}

// Caption(start, end, text, identifier): the start setter runs first.
fn cap_new(p: ref Pats, start: ref Option[String], end: ref Option[String], lines: own Vec[String], ident: own Option[String]) -> Result[Cap, Exc] {
    let s = match truthy(start) {
        Some(x) => x,
        None => "00:00:00.000".to_string(),
    };
    let e = match truthy(end) {
        Some(x) => x,
        None => "00:00:00.000".to_string(),
    };
    let st = ts_from(p, s)?;
    let en = ts_from(p, e)?;
    Ok(Cap { start: st, end: en, ident: ident, lines: lines, comments: Vec.new() })
}

fn cap_raw(c: ref Cap) -> String {
    join_lines(c.lines)
}

fn cap_text(p: ref Pats, c: ref Cap) -> String {
    re_delete(p.tags, cap_raw(c))
}

fn cleaned(p: ref Pats, c: ref Cap) -> String {
    let mut out = String.new();
    for ch in cap_text(p, c).chars() {
        if ch == '\n' {
            out.push_str("\\n");
        } else {
            out.push(ch);
        }
    }
    out
}

fn cap_repr(p: ref Pats, c: ref Cap) -> String {
    f"<Caption start={py_repr_str(ts_str(c.start))} end={py_repr_str(ts_str(c.end))} text={py_repr_str(cleaned(p, c))} identifier={opt_repr(c.ident)}>"
}

fn cap_str(p: ref Pats, c: ref Cap) -> String {
    f"{ts_str(c.start)} {ts_str(c.end)} {cleaned(p, c)}"
}

fn cap_voice(p: ref Pats, c: ref Cap) -> Option[String] {
    if c.lines.len() > 0 and c.lines[0].starts_with("<v") {
        if let Some(g) = re_match(p.voice, c.lines[0]) {
            return Some(g[1].clone());
        }
    }
    None
}

fn cap_eq(a: ref Cap, b: ref Cap) -> bool {
    let same_id = match (a.ident.clone(), b.ident.clone()) {
        (Some(x), Some(y)) => x == y,
        (None, None) => true,
        _ => false,
    };
    ts_cmp(a.start, b.start) == 0 and ts_cmp(a.end, b.end) == 0 and cap_raw(a) == cap_raw(b) and same_id
}

#[derive(Clone)]
struct Style {
    lines: Vec[String],
    comments: Vec[String],
}

// ------------------------------------------------------------ webvtt.py

#[derive(Clone)]
struct Vtt {
    file: Option[String],
    caps: Vec[Cap],
    styles: Vec[Style],
    hdr: Vec[String],
    ftr: Vec[String],
    has_bom: bool,
    encoding: String,
}

fn vtt_new(file: own Option[String]) -> Vtt {
    Vtt {
        file: file,
        caps: Vec.new(),
        styles: Vec.new(),
        hdr: Vec.new(),
        ftr: Vec.new(),
        has_bom: false,
        encoding: "utf-8".to_string(),
    }
}

fn vtt_repr(w: ref Vtt) -> String {
    f"<WebVTT file={opt_repr(w.file)} encoding={py_repr_str(w.encoding)}>"
}

fn total_length(w: ref Vtt) -> i64 {
    if w.caps.len() == 0 {
        return 0;
    }
    ts_seconds(w.caps[w.caps.len() - 1].end) - ts_seconds(w.caps[0].start)
}

// utils.iter_blocks_of_lines
fn blocks(lines: ref Vec[String]) -> Vec[Vec[String]] {
    let mut out: Vec[Vec[String]] = Vec.new();
    let mut cur: Vec[String] = Vec.new();
    for line in lines {
        if not is_blank(line) {
            cur.push(line.clone());
        } else if cur.len() > 0 {
            out.push(cur);
            cur = Vec.new();
        }
    }
    if cur.len() > 0 {
        out.push(cur);
    }
    out
}

// ------------------------------------------------------------ vtt.py

fn has_arrow(s: ref String) -> bool {
    s.contains("-->")
}

fn cue_valid(p: ref Pats, lines: ref Vec[String]) -> bool {
    (lines.len() >= 2 and re_match(p.vtt_cue, lines[0]).is_some() and not has_arrow(lines[1]))
        or (lines.len() >= 3 and not has_arrow(lines[0]) and re_match(p.vtt_cue, lines[1]).is_some()
            and not has_arrow(lines[2]))
}

fn comment_from(p: ref Pats, lines: ref Vec[String]) -> String {
    match re_match(p.comment, join_lines(lines)) {
        Some(g) => py_strip(g[1]),
        None => String.new(),
    }
}

fn style_valid(lines: ref Vec[String]) -> bool {
    if lines.len() < 2 or lines[0] != "STYLE" {
        return false;
    }
    for line in lines {
        if is_blank(line) or has_arrow(line) {
            return false;
        }
    }
    true
}

enum Item {
    C(Cap),
    S(Style),
}

// parse_item: a caption, a style or nothing.
fn parse_item(p: ref Pats, lines: ref Vec[String]) -> Result[Option[Item], Exc] {
    if cue_valid(p, lines) {
        let mut ident: Option[String] = None;
        let mut start: Option[String] = None;
        let mut end: Option[String] = None;
        let mut payload: Vec[String] = Vec.new();
        for line in lines {
            if let Some(g) = re_match(p.vtt_cue, line) {
                start = Some(g[1].clone());
                end = Some(g[2].clone());
            } else if start.is_none() {
                ident = Some(line.clone());
            } else {
                payload.push(line.clone());
            }
        }
        let c = cap_new(p, start, end, payload, ident)?;
        return Ok(Some(Item.C(c)));
    }
    if style_valid(lines) {
        let text = match re_match(p.style, join_lines(lines)) {
            Some(g) => py_strip(g[1]),
            None => String.new(),
        };
        return Ok(Some(Item.S(Style { lines: py_splitlines(text), comments: Vec.new() })));
    }
    Ok(None)
}

fn vtt_parse(p: ref Pats, lines: ref Vec[String], w: mut ref Vtt) -> Result[(), Exc] {
    if lines.len() == 0 or not lines[0].starts_with("WEBVTT") {
        return Err(exc("MalformedFileError", "Invalid format".to_string()));
    }
    let mut items: Vec[Item] = Vec.new();
    let mut comments: Vec[String] = Vec.new();
    for block in blocks(lines) {
        match parse_item(p, block)? {
            Some(item) => {
                let mut it = item;
                match it {
                    Item.C(mut ref c) => c.comments = comments,
                    Item.S(mut ref s) => s.comments = comments,
                }
                comments = Vec.new();
                items.push(it);
            }
            None => {
                if block[0].starts_with("NOTE") {
                    comments.push(comment_from(p, block));
                }
            }
        }
    }
    let mut hdr: Vec[String] = Vec.new();
    if items.len() > 0 {
        match items[0] {
            Item.C(mut ref c) => {
                hdr = c.comments.clone();
                c.comments = Vec.new();
            }
            Item.S(mut ref s) => {
                hdr = s.comments.clone();
                s.comments = Vec.new();
            }
        }
    }
    for it in items {
        match it {
            Item.C(c) => w.caps.push(c.clone()),
            Item.S(s) => w.styles.push(s.clone()),
        }
    }
    w.hdr = hdr;
    w.ftr = comments;
    Ok(())
}

fn comment_lines(c: ref String, out: mut ref Vec[String]) {
    let parts = split_on(c, '\n');
    if parts.len() == 1 {
        out.push(f"NOTE {c}");
        return;
    }
    out.push("NOTE".to_string());
    for x in parts {
        out.push(x.clone());
    }
}

// vtt.to_str
fn vtt_to_str(w: ref Vtt) -> String {
    let mut out: Vec[String] = Vec.new();
    out.push("WEBVTT".to_string());
    for c in w.hdr {
        out.push(String.new());
        comment_lines(c, mut out);
    }
    for s in w.styles {
        for c in s.comments {
            out.push(String.new());
            comment_lines(c, mut out);
        }
        out.push(String.new());
        out.push("STYLE".to_string());
        for line in s.lines {
            out.push(line.clone());
        }
    }
    for cap in w.caps {
        for c in cap.comments {
            out.push(String.new());
            comment_lines(c, mut out);
        }
        out.push(String.new());
        if let Some(id) = truthy(cap.ident) {
            out.push(id);
        }
        out.push(f"{ts_str(cap.start)} --> {ts_str(cap.end)}");
        for line in cap.lines {
            out.push(line.clone());
        }
    }
    if w.ftr.len() == 0 {
        out.push(String.new());
    }
    for c in w.ftr {
        out.push(String.new());
        comment_lines(c, mut out);
    }
    join_lines(out)
}

// ------------------------------------------------------------ srt.py and sbv.py

fn dots_to_commas(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        out.push(if c == '.' { ',' } else { c });
    }
    out
}

fn commas_to_dots(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        out.push(if c == ',' { '.' } else { c });
    }
    out
}

fn srt_parse(p: ref Pats, lines: ref Vec[String]) -> Result[Vec[Cap], Exc] {
    let ok = lines.len() >= 3 and py_isdigit(lines[0]) and has_arrow(lines[1]) and not is_blank(lines[2]);
    if not ok {
        return Err(exc("MalformedFileError", "Invalid format".to_string()));
    }
    let mut caps: Vec[Cap] = Vec.new();
    for block in blocks(lines) {
        if block.len() < 3 or not py_isdigit(block[0]) {
            continue;
        }
        let g = match re_match(p.srt_cue, block[1]) {
            Some(g) => g,
            None => continue,
        };
        let mut payload: Vec[String] = Vec.new();
        for i in 2..block.len() {
            payload.push(block[i].clone());
        }
        caps.push(cap_new(p, Some(commas_to_dots(g[1])), Some(commas_to_dots(g[2])), payload, None)?);
    }
    Ok(caps)
}

fn srt_write(p: ref Pats, caps: ref Vec[Cap]) -> String {
    let mut out: Vec[String] = Vec.new();
    let mut index = 1;
    for c in caps {
        out.push(f"{index}");
        out.push(f"{dots_to_commas(ts_str(c.start))} --> {dots_to_commas(ts_str(c.end))}");
        for line in py_splitlines(cap_text(p, c)) {
            out.push(line.clone());
        }
        out.push(String.new());
        index += 1;
    }
    py_rstrip(join_lines(out))
}

fn sbv_parse(p: ref Pats, lines: ref Vec[String]) -> Result[Vec[Cap], Exc] {
    if lines.len() < 2 {
        return Err(exc("MalformedFileError", "Invalid format".to_string()));
    }
    let bs = blocks(lines);
    if bs.len() == 0 {
        // next() on the exhausted generator
        return Err(exc("StopIteration", String.new()));
    }
    let valid = |b: ref Vec[String]| {
        b.len() >= 2 and re_match(p.sbv_cue, b[0]).is_some() and not is_blank(b[1])
    };
    if not valid(bs[0]) {
        return Err(exc("MalformedFileError", "Invalid format".to_string()));
    }
    let mut caps: Vec[Cap] = Vec.new();
    for block in bs {
        if not valid(block) {
            continue;
        }
        let g = re_match(p.sbv_cue, block[0]).unwrap();
        let mut payload: Vec[String] = Vec.new();
        for i in 1..block.len() {
            payload.push(block[i].clone());
        }
        caps.push(cap_new(p, Some(g[1].clone()), Some(g[2].clone()), payload, None)?);
    }
    Ok(caps)
}

// ------------------------------------------------------------ codecs

#[derive(Clone)]
enum Codec {
    U8,
    U16(bool),
    U32(bool),
    L1,
}

fn codec_lookup(name: ref String) -> Result[Codec, Exc] {
    let mut k = String.new();
    for c in name.chars() {
        if (c >= 'a' and c <= 'z') or (c >= '0' and c <= '9') {
            k.push(c);
        } else if c >= 'A' and c <= 'Z' {
            k.push(char.try_from(c as u32 + 32).unwrap());
        }
    }
    if k == "utf8" {
        Ok(Codec.U8)
    } else if k == "utf16le" {
        Ok(Codec.U16(true))
    } else if k == "utf16be" {
        Ok(Codec.U16(false))
    } else if k == "utf32le" {
        Ok(Codec.U32(true))
    } else if k == "utf32be" {
        Ok(Codec.U32(false))
    } else if k == "latin1" or k == "iso88591" or k == "l1" {
        Ok(Codec.L1)
    } else {
        Err(exc("LookupError", f"unknown encoding: {name}"))
    }
}

fn decode_err(codec: Str, a: i64, b: i64, bytes: ref Vec[u8], reason: Str) -> Exc {
    if b == a {
        exc("UnicodeDecodeError", f"'{codec}' codec can't decode byte 0x{hex_digits(bytes[a] as i64, 2)} in position {a}: {reason}")
    } else {
        exc("UnicodeDecodeError", f"'{codec}' codec can't decode bytes in position {a}-{b}: {reason}")
    }
}

fn utf8_decode(b: ref Vec[u8]) -> Result[String, Exc] {
    let n = b.len();
    let mut i = 0;
    while i < n {
        let x = b[i] as i64;
        if x < 0x80 {
            i += 1;
            continue;
        }
        let (need, lo, hi) = if x >= 0xc2 and x <= 0xdf {
            (1, 0x80, 0xbf)
        } else if x == 0xe0 {
            (2, 0xa0, 0xbf)
        } else if x == 0xed {
            (2, 0x80, 0x9f)
        } else if x >= 0xe1 and x <= 0xef {
            (2, 0x80, 0xbf)
        } else if x == 0xf0 {
            (3, 0x90, 0xbf)
        } else if x == 0xf4 {
            (3, 0x80, 0x8f)
        } else if x >= 0xf1 and x <= 0xf3 {
            (3, 0x80, 0xbf)
        } else {
            return Err(decode_err("utf-8", i, i, b, "invalid start byte"));
        };
        for k in 1..(need + 1) {
            if i + k >= n {
                return Err(decode_err("utf-8", i, n - 1, b, "unexpected end of data"));
            }
            let y = b[i + k] as i64;
            let (l, h) = if k == 1 { (lo, hi) } else { (0x80, 0xbf) };
            if y < l or y > h {
                return Err(decode_err("utf-8", i, i + k - 1, b, "invalid continuation byte"));
            }
        }
        i += need + 1;
    }
    Ok(String.from_utf8(b.clone()).unwrap())
}

fn push_cp(out: mut ref String, cp: i64) {
    out.push(char.try_from(cp as u32).unwrap());
}

fn decode(codec: ref Codec, b: ref Vec[u8]) -> Result[String, Exc] {
    match codec {
        Codec.U8 => utf8_decode(b),
        Codec.L1 => {
            let mut out = String.new();
            for x in b {
                push_cp(mut out, *x as i64);
            }
            Ok(out)
        }
        Codec.U16(le) => {
            let name = if le { "utf-16-le" } else { "utf-16-be" };
            let mut out = String.new();
            let mut i = 0;
            let unit = |j: i64| {
                if le { b[j] as i64 + 256 * (b[j + 1] as i64) } else { 256 * (b[j] as i64) + b[j + 1] as i64 }
            };
            while i < b.len() {
                if i + 1 >= b.len() {
                    return Err(decode_err(name, i, i, b, "truncated data"));
                }
                let u = unit(i);
                if u >= 0xd800 and u <= 0xdbff {
                    if i + 3 >= b.len() {
                        return Err(decode_err(name, i, b.len() - 1, b, "unexpected end of data"));
                    }
                    let v = unit(i + 2);
                    if v < 0xdc00 or v > 0xdfff {
                        return Err(decode_err(name, i, i + 1, b, "illegal UTF-16 surrogate"));
                    }
                    push_cp(mut out, 0x10000 + (u - 0xd800) * 1024 + (v - 0xdc00));
                    i += 4;
                } else if u >= 0xdc00 and u <= 0xdfff {
                    return Err(decode_err(name, i, i + 1, b, "illegal encoding"));
                } else {
                    push_cp(mut out, u);
                    i += 2;
                }
            }
            Ok(out)
        }
        Codec.U32(le) => {
            let name = if le { "utf-32-le" } else { "utf-32-be" };
            let mut out = String.new();
            let mut i = 0;
            while i < b.len() {
                if i + 3 >= b.len() {
                    return Err(decode_err(name, i, b.len() - 1, b, "truncated data"));
                }
                let mut u = 0;
                for k in 0..4 {
                    let j = if le { i + 3 - k } else { i + k };
                    u = u * 256 + b[j] as i64;
                }
                if u > 0x10ffff {
                    return Err(decode_err(name, i, i + 3, b, "code point not in range(0x110000)"));
                }
                if u >= 0xd800 and u <= 0xdfff {
                    return Err(decode_err(name, i, i + 3, b, "code point in surrogate code point range(0xd800, 0xe000)"));
                }
                push_cp(mut out, u);
                i += 4;
            }
            Ok(out)
        }
    }
}

fn char_esc(n: i64) -> String {
    if n < 0x100 {
        f"\\x{hex_digits(n, 2)}"
    } else if n < 0x10000 {
        f"\\u{hex_digits(n, 4)}"
    } else {
        f"\\U{hex_digits(n, 8)}"
    }
}

fn push_unit(out: mut ref Vec[u8], u: i64, le: bool) {
    if le {
        out.push((u % 256) as u8);
        out.push((u / 256) as u8);
    } else {
        out.push((u / 256) as u8);
        out.push((u % 256) as u8);
    }
}

fn encode(codec: ref Codec, s: ref String) -> Result[Vec[u8], Exc] {
    let mut out: Vec[u8] = Vec.new();
    match codec {
        Codec.U8 => {
            for x in s.bytes() {
                out.push(x);
            }
        }
        Codec.L1 => {
            let cs: Vec[char] = s.chars().collect();
            let mut i = 0;
            while i < cs.len() {
                let n = cs[i] as i64;
                if n > 255 {
                    let mut j = i;
                    while j < cs.len() and cs[j] as i64 > 255 {
                        j += 1;
                    }
                    let msg = if j == i + 1 {
                        f"'latin-1' codec can't encode character '{char_esc(n)}' in position {i}: ordinal not in range(256)"
                    } else {
                        f"'latin-1' codec can't encode characters in position {i}-{j - 1}: ordinal not in range(256)"
                    };
                    return Err(exc("UnicodeEncodeError", msg));
                }
                out.push(n as u8);
                i += 1;
            }
        }
        Codec.U16(le) => {
            for c in s.chars() {
                let n = c as i64;
                if n >= 0x10000 {
                    let v = n - 0x10000;
                    push_unit(mut out, 0xd800 + v / 1024, le);
                    push_unit(mut out, 0xdc00 + v % 1024, le);
                } else {
                    push_unit(mut out, n, le);
                }
            }
        }
        Codec.U32(le) => {
            for c in s.chars() {
                let n = c as i64;
                let bs: Vec[i64] = vec![n / 16777216, (n / 65536) % 256, (n / 256) % 256, n % 256];
                for k in 0..4 {
                    out.push((if le { bs[3 - k] } else { bs[k] }) as u8);
                }
            }
        }
    }
    Ok(out)
}

// utils.CODEC_BOMS, in its order. The byte lists are bound with their type
// first because a `vec![..]` of integer literals inside a tuple is typed
// Vec[i64] even where (String, Vec[u8]) is expected (B-2026-10-23-7).
fn codec_boms() -> Vec[(String, Vec[u8])] {
    let mut v: Vec[(String, Vec[u8])] = Vec.new();
    let u8bom: Vec[u8] = vec![0xef, 0xbb, 0xbf];
    let u32le: Vec[u8] = vec![0xff, 0xfe, 0, 0];
    let u32be: Vec[u8] = vec![0, 0, 0xfe, 0xff];
    let u16le: Vec[u8] = vec![0xff, 0xfe];
    let u16be: Vec[u8] = vec![0xfe, 0xff];
    v.push(("utf-8".to_string(), u8bom));
    v.push(("utf-32-le".to_string(), u32le));
    v.push(("utf-32-be".to_string(), u32be));
    v.push(("utf-16-le".to_string(), u16le));
    v.push(("utf-16-be".to_string(), u16be));
    v
}

fn detect_bom(data: ref Vec[u8]) -> Option[(String, i64)] {
    for (enc, bom) in codec_boms() {
        let mut hit = data.len() >= bom.len();
        if hit {
            for i in 0..bom.len() {
                if data[i] != bom[i] {
                    hit = false;
                }
            }
        }
        if hit {
            return Some((enc.clone(), bom.len()));
        }
    }
    None
}

// A text-mode file's lines: universal newlines, then rstrip('\n\r').
fn text_lines(text: ref String) -> Vec[String] {
    let mut t = String.new();
    let cs: Vec[char] = text.chars().collect();
    let mut i = 0;
    while i < cs.len() {
        if cs[i] == '\r' {
            t.push('\n');
            if i + 1 < cs.len() and cs[i + 1] == '\n' {
                i += 1;
            }
        } else {
            t.push(cs[i]);
        }
        i += 1;
    }
    let mut out = split_on(t, '\n');
    if out[out.len() - 1].len() == 0 {
        out.pop();
    }
    out
}

// ------------------------------------------------------------ the file system

struct World {
    out: String,
    files: Map[String, Vec[u8]],
    dirs: Map[String, bool],
}

fn emit(w: mut ref World, s: ref String) {
    w.out.push_str(s);
    w.out.push('\n');
}

// An absolute, normalized path, the cwd being /work.
fn norm_path(path: ref String) -> String {
    let full = if path.starts_with("/") { path.clone() } else { f"/work/{path}" };
    let mut parts: Vec[String] = Vec.new();
    for x in split_on(full, '/') {
        if x.len() == 0 or x == "." {
            continue;
        }
        if x == ".." {
            if parts.len() > 0 {
                parts.pop();
            }
            continue;
        }
        parts.push(x.clone());
    }
    let mut out = String.new();
    for x in parts {
        out.push('/');
        out.push_str(x);
    }
    if out.len() == 0 { "/".to_string() } else { out }
}

fn parent_of(abs: ref String) -> String {
    let cs: Vec[char] = abs.chars().collect();
    let mut i = cs.len() - 1;
    while i > 0 and cs[i] != '/' {
        i -= 1;
    }
    if i == 0 { "/".to_string() } else { chars_str(cs, 0, i) }
}

fn is_dir(w: ref World, path: ref String) -> bool {
    w.dirs.contains_key(norm_path(path))
}

fn errno(kind: Str, num: i64, text: Str, path: ref String) -> Exc {
    exc(kind, f"[Errno {num}] {text}: {py_repr_str(path)}")
}

// open(path, 'rb').read()
fn fs_read(w: ref World, path: ref String) -> Result[Vec[u8], Exc] {
    let abs = norm_path(path);
    if w.dirs.contains_key(abs) {
        return Err(errno("IsADirectoryError", 21, "Is a directory", path));
    }
    match w.files.get(abs) {
        Some(b) => Ok(b.clone()),
        None => Err(errno("FileNotFoundError", 2, "No such file or directory", path)),
    }
}

// open(path, 'w'): creates or truncates the file.
fn fs_create(w: mut ref World, path: ref String) -> Result[(), Exc] {
    let abs = norm_path(path);
    if w.dirs.contains_key(abs) {
        return Err(errno("IsADirectoryError", 21, "Is a directory", path));
    }
    if not w.dirs.contains_key(parent_of(abs)) {
        return Err(errno("FileNotFoundError", 2, "No such file or directory", path));
    }
    w.files.insert(abs, Vec.new());
    Ok(())
}

fn fs_put(w: mut ref World, path: ref String, data: own Vec[u8]) {
    w.files.insert(norm_path(path), data);
}

// os.makedirs(path, exist_ok=True)
fn fs_makedirs(w: mut ref World, path: ref String) -> Result[(), Exc] {
    let abs = norm_path(path);
    if w.dirs.contains_key(abs) {
        return Ok(());
    }
    if w.files.contains_key(abs) {
        return Err(errno("FileExistsError", 17, "File exists", path));
    }
    let mut cur = String.new();
    for x in split_on(abs, '/') {
        if x.len() == 0 {
            continue;
        }
        cur.push('/');
        cur.push_str(x);
        w.dirs.insert(cur.clone(), true);
    }
    Ok(())
}

// str(pathlib.Path(p))
fn path_str(p: ref String) -> String {
    let mut parts: Vec[String] = Vec.new();
    for x in split_on(p, '/') {
        if x.len() > 0 and x != "." {
            parts.push(x.clone());
        }
    }
    let mut out = if p.starts_with("/") { "/".to_string() } else { String.new() };
    for i in 0..parts.len() {
        if i > 0 {
            out.push('/');
        }
        out.push_str(parts[i]);
    }
    if out.len() == 0 { ".".to_string() } else { out }
}

// os.path.join with two parts.
fn path_join(a: ref String, b: ref String) -> String {
    if b.starts_with("/") {
        b.clone()
    } else if a.len() == 0 or a.ends_with("/") {
        f"{a}{b}"
    } else {
        f"{a}/{b}"
    }
}

// os.path.splitext(p)[0]
fn splitext_root(p: ref String) -> String {
    let cs: Vec[char] = p.chars().collect();
    let mut sep = -1;
    let mut dot = -1;
    for i in 0..cs.len() {
        if cs[i] == '/' {
            sep = i;
        }
        if cs[i] == '.' {
            dot = i;
        }
    }
    if dot > sep {
        let mut k = sep + 1;
        while k < dot {
            if cs[k] != '.' {
                return chars_str(cs, 0, dot);
            }
            k += 1;
        }
    }
    p.clone()
}

fn basename(p: ref String) -> String {
    let cs: Vec[char] = p.chars().collect();
    let mut sep = -1;
    for i in 0..cs.len() {
        if cs[i] == '/' {
            sep = i;
        }
    }
    chars_str(cs, sep + 1, cs.len())
}

// ------------------------------------------------------------ reading

struct Text {
    lines: Vec[String],
    bom: Option[String],
}

// utils.FileWrapper: BOM detection, then the file read in text mode.
fn read_text(w: ref World, path: ref String, encoding: ref Option[String]) -> Result[Text, Exc] {
    let data = fs_read(w, path)?;
    let bom = detect_bom(data);
    let (enc, skip) = match bom {
        Some((ref e, n)) => (e.clone(), n),
        None => match truthy(encoding) {
            Some(e) => (e, 0),
            None => ("utf-8".to_string(), 0),
        },
    };
    let codec = codec_lookup(enc)?;
    let text = decode(codec, data[skip..].to_vec())?;
    let b = match bom {
        Some((e, _)) => Some(e.clone()),
        None => None,
    };
    Ok(Text { lines: text_lines(text), bom: b })
}

fn webvtt_read(p: ref Pats, w: ref World, path: ref String, encoding: ref Option[String]) -> Result[Vtt, Exc] {
    let t = read_text(w, path, encoding)?;
    let mut v = vtt_new(Some(path.clone()));
    vtt_parse(p, t.lines, mut v)?;
    if let Some(e) = t.bom {
        v.encoding = e;
        v.has_bom = true;
    }
    Ok(v)
}

// The lines of a BytesIO, each decoded as UTF-8 on its own.
fn buffer_lines(data: ref Vec[u8]) -> Result[Vec[String], Exc] {
    let mut out: Vec[String] = Vec.new();
    let mut cur: Vec[u8] = Vec.new();
    for x in data {
        cur.push(*x);
        if *x == 10 {
            out.push(rstrip_nl(utf8_decode(cur)?));
            cur = Vec.new();
        }
    }
    if cur.len() > 0 {
        out.push(rstrip_nl(utf8_decode(cur)?));
    }
    Ok(out)
}

fn unsupported(fmt: ref String) -> Exc {
    exc("ValueError", f"Format {fmt} is not supported.")
}

// ------------------------------------------------------------ saving

// WebVTT._get_destination_file
fn destination(w: ref World, v: ref Vtt, dest: ref Option[String], ext: Str) -> Result[String, Exc] {
    let missing = exc("MissingFilenameError", String.new());
    let file = truthy(v.file);
    let d = match truthy(dest) {
        Some(d) => d,
        None => match file {
            Some(ref f) => f"{splitext_root(f)}.{ext}",
            None => return Err(missing),
        },
    };
    let mut target = path_join("/work".to_string(), d);
    if is_dir(w, target) {
        return match file {
            Some(f) => Ok(path_join(target, f"{splitext_root(basename(f))}.{ext}")),
            None => Err(missing),
        };
    }
    let cs: Vec[char] = target.chars().collect();
    let tail = chars_str(cs, if cs.len() > 4 { cs.len() - 4 } else { 0 }, cs.len()).to_lowercase();
    if tail != f".{ext}" {
        target = f"{target}.{ext}";
    }
    Ok(target)
}

// open(file, 'w', encoding=...) and the writes into it.
fn write_text(w: mut ref World, file: ref String, encoding: ref String, bom: bool, text: ref String) -> Result[(), Exc] {
    fs_create(mut w, file)?;
    let codec = codec_lookup(encoding)?;
    let mut data: Vec[u8] = Vec.new();
    let mut known = false;
    for (name, _) in codec_boms() {
        if name == *encoding {
            known = true;
        }
    }
    if bom and known {
        for x in encode(codec, "\u{feff}".to_string())? {
            data.push(x);
        }
    }
    for x in encode(codec, text)? {
        data.push(x);
    }
    fs_put(mut w, file, data);
    Ok(())
}

fn save(p: ref Pats, w: mut ref World, v: mut ref Vtt, dest: ref Option[String], enc: ref Option[String], add_bom: ref Option[bool]) -> Result[(), Exc] {
    let file = destination(w, v, dest, "vtt")?;
    v.file = Some(file.clone());
    let encoding = match truthy(enc) {
        Some(e) => e,
        None => v.encoding.clone(),
    };
    let bom = match add_bom {
        Some(b) => b,
        None => v.has_bom,
    };
    write_text(mut w, file, encoding, bom, vtt_to_str(v))
}

fn save_srt(p: ref Pats, w: mut ref World, v: mut ref Vtt, dest: ref Option[String], enc: ref String) -> Result[(), Exc] {
    let file = destination(w, v, dest, "srt")?;
    v.file = Some(file.clone());
    write_text(mut w, file, enc, false, srt_write(p, v.caps))
}

// ------------------------------------------------------------ segmenter.py

fn py_index(i: i64, n: i64) -> Option[i64] {
    let j = if i < 0 { i + n } else { i };
    if j < 0 or j >= n { None } else { Some(j) }
}

fn index_error() -> Exc {
    exc("IndexError", "list index out of range".to_string())
}

fn slice_segments(caps: ref Vec[Cap], seconds: i64) -> Result[Vec[Vec[i64]], Exc] {
    let zero = exc("ZeroDivisionError", "division by zero".to_string());
    let total = if caps.len() == 0 {
        0
    } else {
        if seconds == 0 {
            return Err(zero);
        }
        0 - floor_div(0 - ts_seconds(caps[caps.len() - 1].end), seconds)
    };
    let mut segs: Vec[Vec[i64]] = Vec.new();
    for _ in 0..total {
        segs.push(Vec.new());
    }
    let n = segs.len();
    for ci in 0..caps.len() {
        if seconds == 0 {
            return Err(zero);
        }
        let a = floor_div(ts_seconds(caps[ci].start), seconds);
        match py_index(a, n) {
            Some(j) => segs[j].push(ci),
            None => return Err(index_error()),
        }
        let b = floor_div(ts_seconds(caps[ci].end), seconds);
        if b > a {
            for i in (a + 1)..(b + 1) {
                match py_index(i, n) {
                    Some(j) => segs[j].push(ci),
                    None => return Err(index_error()),
                }
            }
        }
    }
    Ok(segs)
}

fn segment(p: ref Pats, w: mut ref World, path: ref String, output: ref Option[String], seconds: i64, mpegts: i64) -> Result[(), Exc] {
    let v = webvtt_read(p, w, path, None)?;
    let folder = match output {
        Some(o) => path_str(o),
        None => {
            return Err(exc("TypeError", "argument should be a str or an os.PathLike object where __fspath__ returns a str, not 'NoneType'".to_string()));
        }
    };
    fs_makedirs(mut w, folder)?;
    let segs = slice_segments(v.caps, seconds)?;
    let within = |name: ref String| {
        if folder == "." { name.clone() } else { f"{folder}/{name}" }
    };
    for i in 0..segs.len() {
        let mut s = String.new();
        s.push_str("WEBVTT\n");
        s.push_str(f"X-TIMESTAMP-MAP=MPEGTS:{mpegts},LOCAL:00:00:00.000\n");
        for ci in segs[i] {
            let c = v.caps[*ci].clone();
            s.push_str(f"\n{ts_str(c.start)} --> {ts_str(c.end)}\n");
            for line in c.lines {
                s.push_str(f"{line}\n");
            }
        }
        write_text(mut w, within(f"fileSequence{i}.webvtt"), "utf-8".to_string(), false, s)?;
    }
    let mut m = String.new();
    m.push_str("#EXTM3U\n");
    m.push_str(f"#EXT-X-TARGETDURATION:{seconds}\n");
    m.push_str("#EXT-X-VERSION:3\n");
    m.push_str("#EXT-X-PLAYLIST-TYPE:VOD\n");
    for i in 0..segs.len() {
        m.push_str("#EXTINF:30.00000\n");
        m.push_str(f"fileSequence{i}.webvtt\n");
    }
    m.push_str("#EXT-X-ENDLIST\n");
    write_text(mut w, within("prog_index.m3u8".to_string()), "utf-8".to_string(), false, m)
}

// ------------------------------------------------------------ cli.py (argparse)

fn usage() -> String {
    "usage: webvtt [-h] [-o PATH] [-d NUMBER] [-m NUMBER] {segment} PATH".to_string()
}

fn help_text() -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    v.push(usage());
    v.push(String.new());
    v.push("Segment WebVTT files.".to_string());
    v.push(String.new());
    v.push("positional arguments:".to_string());
    v.push("  {segment}             command to perform".to_string());
    v.push("  PATH                  WebVTT file".to_string());
    v.push(String.new());
    v.push("options:".to_string());
    v.push("  -h, --help            show this help message and exit".to_string());
    v.push("  -o, --output PATH     output directory".to_string());
    v.push("  -d, --target-duration NUMBER".to_string());
    v.push("                        target duration of each segment in seconds, default:".to_string());
    v.push("                        10".to_string());
    v.push("  -m, --mpegts NUMBER   presentation timestamp value, default: 900000".to_string());
    v
}

// The option strings in the order the parser registered them, and the
// action each one names: 0 help, 1 output, 2 target-duration, 3 mpegts.
fn option_strings() -> Vec[(String, i64)] {
    let mut v: Vec[(String, i64)] = Vec.new();
    v.push(("-h".to_string(), 0));
    v.push(("--help".to_string(), 0));
    v.push(("-o".to_string(), 1));
    v.push(("--output".to_string(), 1));
    v.push(("-d".to_string(), 2));
    v.push(("--target-duration".to_string(), 2));
    v.push(("-m".to_string(), 3));
    v.push(("--mpegts".to_string(), 3));
    v
}

fn action_name(a: i64) -> String {
    if a == 1 {
        "-o/--output".to_string()
    } else if a == 2 {
        "-d/--target-duration".to_string()
    } else {
        "-m/--mpegts".to_string()
    }
}

// What _parse_optional makes of one argument.
enum CliArg {
    Pos,
    // a known option and its explicit argument
    Opt(i64, Option[String]),
    Unknown,
}

fn find_option(s: ref String) -> Option[i64] {
    for (o, a) in option_strings() {
        if o == *s {
            return Some(a);
        }
    }
    None
}

fn is_negative_number(s: ref String) -> bool {
    let cs: Vec[char] = s.chars().collect();
    if cs.len() < 2 or cs[0] != '-' {
        return false;
    }
    let mut digits = 0;
    let mut dots = 0;
    let mut after_dot = 0;
    for i in 1..cs.len() {
        if cs[i] >= '0' and cs[i] <= '9' {
            digits += 1;
            if dots > 0 {
                after_dot += 1;
            }
        } else if cs[i] == '.' {
            dots += 1;
        } else {
            return false;
        }
    }
    (dots == 0 and digits > 0) or (dots == 1 and after_dot > 0)
}

fn parse_optional(s: ref String) -> Result[CliArg, String] {
    if s.len() == 0 or not s.starts_with("-") {
        return Ok(CliArg.Pos);
    }
    if let Some(a) = find_option(s) {
        return Ok(CliArg.Opt(a, None));
    }
    let cs: Vec[char] = s.chars().collect();
    if cs.len() == 1 {
        return Ok(CliArg.Pos);
    }
    let mut eq = -1;
    for i in 0..cs.len() {
        if eq < 0 and cs[i] == '=' {
            eq = i;
        }
    }
    if eq >= 0 {
        if let Some(a) = find_option(chars_str(cs, 0, eq)) {
            return Ok(CliArg.Opt(a, Some(chars_str(cs, eq + 1, cs.len()))));
        }
    }
    // _get_option_tuples
    let mut found: Vec[(i64, Option[String], String)] = Vec.new();
    if cs[1] == '-' {
        let (prefix, explicit) = if eq >= 0 {
            (chars_str(cs, 0, eq), Some(chars_str(cs, eq + 1, cs.len())))
        } else {
            (s.clone(), None)
        };
        for (o, a) in option_strings() {
            if o.starts_with(prefix) {
                found.push((a, explicit.clone(), o.clone()));
            }
        }
    } else {
        let short = chars_str(cs, 0, 2);
        let rest = chars_str(cs, 2, cs.len());
        for (o, a) in option_strings() {
            // `o` is compared without `*`; see B-2026-10-23-8.
            if o == short {
                found.push((a, Some(rest.clone()), o.clone()));
            } else if o.starts_with(s) {
                found.push((a, None, o.clone()));
            }
        }
    }
    if found.len() > 1 {
        let mut names: Vec[String] = Vec.new();
        for f in found {
            names.push(f.2.clone());
        }
        return Err(f"ambiguous option: {s} could match {names.join(", ")}");
    }
    if found.len() == 1 {
        return Ok(CliArg.Opt(found[0].0, found[0].1.clone()));
    }
    if is_negative_number(s) {
        return Ok(CliArg.Pos);
    }
    if s.contains(" ") {
        return Ok(CliArg.Pos);
    }
    Ok(CliArg.Unknown)
}

// int(s) for a str.
fn py_int(s: ref String) -> Option[i64] {
    let t: Vec[char] = py_strip(s).chars().collect();
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == '+' or t[i] == '-') {
        neg = t[i] == '-';
        i += 1;
    }
    if i >= t.len() {
        return None;
    }
    let mut n = 0;
    let mut prev_digit = false;
    while i < t.len() {
        let c = t[i];
        if c >= '0' and c <= '9' {
            n = n * 10 + (c as i64 - 48);
            prev_digit = true;
        } else if c == '_' and prev_digit and i + 1 < t.len() and t[i + 1] >= '0' and t[i + 1] <= '9' {
            prev_digit = false;
        } else {
            return None;
        }
        i += 1;
    }
    Some(if neg { 0 - n } else { n })
}

struct CliOut {
    out: Vec[String],
    err: Vec[String],
    code: Option[i64],
}

// argparse's parse_args for webvtt's parser; Err is the error message.
fn cli_parse(args: ref Vec[String], co: mut ref CliOut) -> Result[(Option[String], Option[String], i64, i64), String] {
    let mut command: Option[String] = None;
    let mut file: Option[String] = None;
    let mut output: Option[String] = None;
    let mut seconds = 10;
    let mut mpegts = 900000;
    let mut kinds: Vec[CliArg] = Vec.new();
    let mut dashdash = false;
    let mut skip: Vec[bool] = Vec.new();
    for a in args {
        if dashdash {
            kinds.push(CliArg.Pos);
            skip.push(false);
        } else if *a == "--" {
            dashdash = true;
            kinds.push(CliArg.Pos);
            skip.push(true);
        } else {
            kinds.push(parse_optional(a)?);
            skip.push(false);
        }
    }
    let mut extras: Vec[String] = Vec.new();
    let mut npos = 0;
    let mut i = 0;
    while i < args.len() {
        if skip[i] {
            i += 1;
            continue;
        }
        match kinds[i] {
            CliArg.Pos => {
                if npos == 0 {
                    if args[i] != "segment" {
                        return Err(f"argument command: invalid choice: {py_repr_str(args[i])} (choose from 'segment')");
                    }
                    command = Some(args[i].clone());
                    npos = 1;
                } else if npos == 1 {
                    file = Some(args[i].clone());
                    npos = 2;
                } else {
                    extras.push(args[i].clone());
                }
            }
            CliArg.Unknown => extras.push(args[i].clone()),
            CliArg.Opt(a, explicit) => {
                if a == 0 {
                    for line in help_text() {
                        co.out.push(line.clone());
                    }
                    co.code = Some(0);
                    return Err(String.new());
                }
                let value = match explicit {
                    Some(x) => x.clone(),
                    None => {
                        let next_ok = i + 1 < args.len() and not skip[i + 1] and match kinds[i + 1] {
                            CliArg.Pos => true,
                            _ => false,
                        };
                        if not next_ok {
                            return Err(f"argument {action_name(a)}: expected one argument");
                        }
                        i += 1;
                        args[i].clone()
                    }
                };
                if a == 1 {
                    output = Some(value);
                } else {
                    let n = match py_int(value) {
                        Some(n) => n,
                        None => return Err(f"argument {action_name(a)}: invalid int value: {py_repr_str(value)}"),
                    };
                    if a == 2 {
                        seconds = n;
                    } else {
                        mpegts = n;
                    }
                }
            }
        }
        i += 1;
    }
    if npos < 2 {
        let names = if npos == 0 { "command, PATH" } else { "PATH" };
        return Err(f"the following arguments are required: {names}");
    }
    if extras.len() > 0 {
        return Err(f"unrecognized arguments: {extras.join(" ")}");
    }
    Ok((file, output, seconds, mpegts))
}

fn cli_main(p: ref Pats, w: mut ref World, args: ref Vec[String]) -> Result[(), Exc] {
    let mut co = CliOut { out: Vec.new(), err: Vec.new(), code: None };
    let parsed = cli_parse(args, mut co);
    let result = match parsed {
        Ok((file, output, seconds, mpegts)) => segment(p, mut w, file.unwrap(), output, seconds, mpegts),
        Err(msg) => {
            if co.code.is_none() {
                co.err.push(usage());
                co.err.push(f"webvtt: error: {msg}");
                co.code = Some(2);
            }
            Ok(())
        }
    };
    for line in co.out {
        emit(mut w, f"  out|{line}");
    }
    for line in co.err {
        emit(mut w, f"  err|{line}");
    }
    result?;
    if let Some(c) = co.code {
        emit(mut w, f"  exit {c}");
    }
    Ok(())
}

// ------------------------------------------------------------ the jobs

fn hex_val(c: char) -> i64 {
    let n = c as i64;
    if n >= 97 { n - 87 } else if n >= 65 { n - 55 } else { n - 48 }
}

fn hex_bytes(s: ref String) -> Vec[u8] {
    let cs: Vec[char] = s.chars().collect();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < cs.len() {
        out.push((hex_val(cs[i]) * 16 + hex_val(cs[i + 1])) as u8);
        i += 2;
    }
    out
}

// An op word: "-" is None, "h:<hex>" a UTF-8 string.
fn word_arg(x: ref String) -> Option[String] {
    if *x == "-" {
        return None;
    }
    if x.starts_with("h:") {
        let cs: Vec[char] = x.chars().collect();
        return Some(String.from_utf8(hex_bytes(chars_str(cs, 2, cs.len()))).unwrap());
    }
    Some(x.clone())
}

fn word_shown(x: ref String) -> String {
    if x.starts_with("h:") {
        return py_repr_str(word_arg(x).unwrap());
    }
    x.clone()
}

fn describe(p: ref Pats, w: mut ref World, v: ref Vtt) {
    emit(mut w, f"  repr {vtt_repr(v)}");
    emit(mut w, f"  captions {v.caps.len()}, styles {v.styles.len()}, total_length {total_length(v)}");
    emit(mut w, f"  header_comments {list_repr(v.hdr)}");
    emit(mut w, f"  footer_comments {list_repr(v.ftr)}");
    for i in 0..v.styles.len() {
        let s = v.styles[i].clone();
        emit(mut w, f"  style {i} {py_repr_str(join_lines(s.lines))} comments {list_repr(s.comments)}");
    }
    for i in 0..v.caps.len() {
        let c = v.caps[i].clone();
        emit(mut w, f"  caption {i} {cap_repr(p, c)}");
        emit(mut w, f"    str {vis(cap_str(p, c))}");
        emit(mut w, f"    seconds {ts_seconds(c.start)} {ts_seconds(c.end)}, identifier {opt_repr(c.ident)}, voice {opt_repr(cap_voice(p, c))}");
        emit(mut w, f"    lines {list_repr(c.lines)}");
        emit(mut w, f"    comments {list_repr(c.comments)}");
    }
}

fn text_block(w: mut ref World, s: ref String) {
    for line in split_on(s, '\n') {
        emit(mut w, f"  |{vis(line)}");
    }
}

fn file_block(w: mut ref World, data: ref Vec[u8]) {
    let mut text: Option[String] = None;
    if not data.contains(0) {
        if let Ok(s) = utf8_decode(data) {
            text = Some(s);
        }
    }
    match text {
        Some(s) => {
            for line in split_on(s, '\n') {
                emit(mut w, f"    |{vis(line)}");
            }
        }
        None => {
            let mut i = 0;
            while i < data.len() {
                let mut row = String.new();
                let mut k = i;
                while k < data.len() and k < i + 32 {
                    row.push_str(hex_digits(data[k] as i64, 2));
                    k += 1;
                }
                emit(mut w, f"    {row}");
                i += 32;
            }
        }
    }
}

fn need(v: ref Option[Vtt]) -> Result[Vtt, Exc] {
    match v {
        Some(x) => Ok(x.clone()),
        None => Err(exc("AttributeError", "'NoneType' object has no attribute 'captions'".to_string())),
    }
}

fn arg_at(a: ref Vec[Option[String]], i: i64) -> Option[String] {
    if i < a.len() { a[i].clone() } else { None }
}

fn int_arg(a: ref Vec[Option[String]], i: i64) -> i64 {
    py_int(a[i].clone().unwrap()).unwrap()
}

fn cap_index(v: ref Vtt, i: i64) -> Result[i64, Exc] {
    match py_index(i, v.caps.len()) {
        Some(j) => Ok(j),
        None => Err(index_error()),
    }
}

fn text_arg(o: ref Option[String]) -> Vec[String] {
    match o {
        Some(s) => py_splitlines(s),
        None => Vec.new(),
    }
}

fn run_op(p: ref Pats, w: mut ref World, cur: mut ref Option[Vtt], words: ref Vec[String]) -> Result[(), Exc] {
    let op = words[0].clone();
    let mut a: Vec[Option[String]] = Vec.new();
    for i in 1..words.len() {
        a.push(word_arg(words[i]));
    }
    if op == "read" or op == "srt" or op == "sbv" {
        let path = a[0].clone().unwrap();
        let enc = arg_at(a, 1);
        if op == "read" {
            *cur = Some(webvtt_read(p, w, path, enc)?);
        } else {
            let t = read_text(w, path, enc)?;
            let caps = if op == "srt" { srt_parse(p, t.lines)? } else { sbv_parse(p, t.lines)? };
            let mut v = vtt_new(Some(path));
            v.caps = caps;
            *cur = Some(v);
        }
    } else if op == "buffer" {
        let data = fs_read(w, a[0].clone().unwrap())?;
        let fmt = a[1].clone().unwrap();
        if fmt != "vtt" and fmt != "srt" and fmt != "sbv" {
            return Err(unsupported(fmt));
        }
        let lines = buffer_lines(data)?;
        let mut v = vtt_new(None);
        if fmt == "vtt" {
            vtt_parse(p, lines, mut v)?;
        } else if fmt == "srt" {
            v.caps = srt_parse(p, lines)?;
        } else {
            v.caps = sbv_parse(p, lines)?;
        }
        *cur = Some(v);
    } else if op == "string" {
        let data = fs_read(w, a[0].clone().unwrap())?;
        let text = utf8_decode(data)?;
        let mut v = vtt_new(None);
        vtt_parse(p, py_splitlines(text), mut v)?;
        *cur = Some(v);
    } else if op == "new" {
        *cur = Some(vtt_new(None));
    } else if op == "show" {
        let v = need(cur)?;
        describe(p, mut w, v);
    } else if op == "content" {
        let v = need(cur)?;
        text_block(mut w, vtt_to_str(v));
    } else if op == "write" {
        let v = need(cur)?;
        let fmt = a[0].clone().unwrap();
        if fmt == "vtt" {
            text_block(mut w, vtt_to_str(v));
        } else if fmt == "srt" {
            text_block(mut w, srt_write(p, v.caps));
        } else {
            return Err(unsupported(fmt));
        }
    } else if op == "slice" {
        let v = need(cur)?;
        let start = match truthy(a[0]) {
            Some(s) => Some(ts_from(p, s)?),
            None => None,
        };
        let end = match truthy(a[1]) {
            Some(s) => Some(ts_from(p, s)?),
            None => None,
        };
        for c in v.caps {
            let after = match start {
                Some(ref t) => ts_cmp(c.start, t) >= 0,
                None => true,
            };
            let before = match end {
                Some(ref t) => ts_cmp(c.end, t) <= 0,
                None => true,
            };
            if after and before {
                emit(mut w, f"  {vis(cap_str(p, c))}");
            }
        }
    } else if op == "segment" {
        segment(p, mut w, a[0].clone().unwrap(), a[1], int_arg(a, 2), int_arg(a, 3))?;
    } else if op == "save" or op == "savesrt" {
        let mut v = need(cur)?;
        let enc = arg_at(a, 1);
        let r = if op == "save" {
            let bom = match arg_at(a, 2) {
                Some(x) => Some(x == "1"),
                None => None,
            };
            save(p, mut w, mut v, a[0], enc, bom)
        } else {
            let e = match enc {
                Some(e) => e,
                None => "utf-8".to_string(),
            };
            save_srt(p, mut w, mut v, a[0], e)
        };
        let shown = opt_repr(v.file);
        *cur = Some(v);
        r?;
        emit(mut w, f"  file {shown}");
    } else if op == "cli" {
        let mut args: Vec[String] = Vec.new();
        for x in a {
            args.push(x.clone().unwrap());
        }
        cli_main(p, mut w, args)?;
    } else {
        let mut v = need(cur)?;
        let r = edit(p, mut w, mut v, op, a);
        *cur = Some(v);
        r?;
    }
    Ok(())
}

// The ops that build or change a WebVTT by hand.
fn edit(p: ref Pats, w: mut ref World, v: mut ref Vtt, op: ref String, a: ref Vec[Option[String]]) -> Result[(), Exc] {
    if *op == "cap" {
        let c = cap_new(p, a[0], a[1], text_arg(a[2]), a[3].clone())?;
        v.caps.push(c);
    } else if *op == "settext" {
        let i = cap_index(v, int_arg(a, 0))?;
        v.caps[i].lines = text_arg(a[1]);
    } else if *op == "setstart" {
        let i = cap_index(v, int_arg(a, 0))?;
        v.caps[i].start = ts_from(p, a[1].clone().unwrap())?;
    } else if *op == "setend" {
        let i = cap_index(v, int_arg(a, 0))?;
        v.caps[i].end = ts_from(p, a[1].clone().unwrap())?;
    } else if *op == "style" {
        v.styles.push(Style { lines: text_arg(a[0]), comments: Vec.new() });
    } else if *op == "hdr" {
        v.hdr.push(a[0].clone().unwrap());
    } else if *op == "ftr" {
        v.ftr.push(a[0].clone().unwrap());
    } else if *op == "capcomment" {
        let i = cap_index(v, int_arg(a, 0))?;
        v.caps[i].comments.push(a[1].clone().unwrap());
    } else if *op == "stylecomment" {
        let i = int_arg(a, 0);
        v.styles[i].comments.push(a[1].clone().unwrap());
    } else if *op == "del" {
        match py_index(int_arg(a, 0), v.caps.len()) {
            Some(j) => {
                v.caps.remove(j);
            }
            None => return Err(exc("IndexError", "list assignment index out of range".to_string())),
        }
    } else if *op == "get" {
        let i = cap_index(v, int_arg(a, 0))?;
        emit(mut w, f"  {cap_repr(p, v.caps[i])}");
    } else if *op == "eq" {
        let i = cap_index(v, int_arg(a, 0))?;
        let j = cap_index(v, int_arg(a, 1))?;
        emit(mut w, f"  {py_bool(cap_eq(v.caps[i], v.caps[j]))}");
    } else if *op == "ts" {
        let t = ts_from(p, a[0].clone().unwrap())?;
        emit(mut w, f"  {ts_str(t)} {ts_repr(t)} {ts_seconds(t)} ({t.h}, {t.m}, {t.s}, {t.ms})");
    } else if *op == "cmp" {
        let x = ts_from(p, a[0].clone().unwrap())?;
        let y = ts_from(p, a[1].clone().unwrap())?;
        let c = ts_cmp(x, y);
        emit(mut w, f"  == {py_bool(c == 0)}, != {py_bool(c != 0)}, < {py_bool(c < 0)}, <= {py_bool(c <= 0)}, > {py_bool(c > 0)}, >= {py_bool(c >= 0)}");
    } else {
        return Err(exc("SystemExit", f"bad op {op}"));
    }
    Ok(())
}

fn run_job(p: ref Pats, w: mut ref World, f: ref Vec[String]) {
    w.files = Map.new();
    w.dirs = Map.new();
    w.dirs.insert("/".to_string(), true);
    w.dirs.insert("/work".to_string(), true);
    if f[2] != "-" {
        for d in split_on(f[2], ',') {
            fs_makedirs(mut w, d).unwrap();
        }
    }
    if f[1] != "-" {
        for pair in split_on(f[1], ',') {
            let kv = split_on(pair, '=');
            fs_put(mut w, kv[0], hex_bytes(kv[1]));
        }
    }
    emit(mut w, f"== {f[0]}");
    // The tests of the timestamp ops need no WebVTT; give them an empty one.
    let mut cur: Option[Vtt] = if f[3].starts_with("ts ") { Some(vtt_new(None)) } else { None };
    let mut before = w.files.clone();
    for k in 3..f.len() {
        let words = split_on(f[k], ' ');
        let mut shown: Vec[String] = Vec.new();
        for x in words {
            shown.push(word_shown(x));
        }
        emit(mut w, f"> {shown.join(" ")}");
        if let Err(e) = run_op(p, mut w, mut cur, words) {
            emit(mut w, f"  error {e.kind}: {vis(e.msg)}");
        }
        let mut keys: Vec[String] = Vec.new();
        for (key, _) in w.files.iter() {
            keys.push(key.clone());
        }
        keys.sort();
        for key in keys {
            let now = w.files.get(key).unwrap().clone();
            let changed = match before.get(key) {
                Some(old) => *old != now,
                None => true,
            };
            if changed {
                let cs: Vec[char] = key.chars().collect();
                let rel = chars_str(cs, 6, cs.len());
                emit(mut w, f"  wrote {rel} ({now.len()} bytes)");
                file_block(mut w, now);
            }
        }
        before = w.files.clone();
    }
    emit(mut w, String.new());
}

fn main() {
    let p = patterns();
    let mut w = World { out: String.new(), files: Map.new(), dirs: Map.new() };
    for line in split_on(jobs_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, '\t');
        run_job(p, mut w, f);
    }
    print(w.out);
}

