// mini_tinytag: tinytag 2.3.2, the audio metadata reader for Python, on
// a shelf of small audio files:
// - the eight parser classes: ID3 (v1, and v2.2, v2.3 and v2.4 frames,
//   with text encodings, synced lyrics, pictures, iTunes grouping and
//   custom frames), MPEG (frame headers, Xing, Info and VBRI headers, and
//   the CBR estimate), Ogg (Vorbis, Opus, FLAC and Speex streams, with
//   packets across pages), FLAC (STREAMINFO, Vorbis comments, pictures),
//   WAVE (fmt, fact, LIST INFO, an ID3 chunk, XMP), ASF (content and
//   extended content descriptions, the metadata objects, stream
//   properties), MP4 (the atom tree, ilst items, custom '----' atoms,
//   mp4a and alac) and AIFF (COMM with its 80-bit rate, AIFC, ID3);
// - TinyTag's field model: _set_field, which sends a second value to the
//   other dict and renames a field that collides with an attribute,
//   _update, Images, as_dict, and how a file's parser class is found by
//   its name or by its magic bytes;
// - the command line (python -m tinytag): json, csv, tsv and tabularcsv
//   output, saving cover art, skipping unsupported files, and the error
//   messages for broken ones.
//
// The inputs are data/jobs.txt and the audio files beside it, made by
// mk.py. expected.out is the output of oracle.py, which runs the same
// jobs through tinytag itself (the copy in tinytag/).

struct DataFile {
    path: String,
    body: String,
    hex: bool,
}

fn hex_val(c: u8) -> u8 {
    if c >= b'0' and c <= b'9' {
        c - b'0'
    } else if c >= b'a' and c <= b'f' {
        c - b'a' + 10
    } else {
        c - b'A' + 10
    }
}

// hex, where Z<count>; stands for that many zero bytes
fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        if b[i] == b'Z' {
            let mut n = 0;
            i += 1;
            while i < b.len() and b[i] != b';' {
                n = n * 10 + (b[i] - b'0') as i64;
                i += 1;
            }
            i += 1;
            let mut k = 0;
            while k < n {
                out.push(0);
                k += 1;
            }
            continue;
        }
        if i + 1 >= b.len() {
            break;
        }
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn write_data() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data/out".to_string()) {
        return Err(f"cannot create data/out: {e}");
    }
    for file in data_files() {
        let p = f"data/{file.path}";
        if file.hex {
            if let Err(e) = fs.write_bytes(p.clone(), unhex(file.body)) {
                return Err(f"cannot write {p}: {e}");
            }
        } else if let Err(e) = fs.write(p.clone(), file.body.clone()) {
            return Err(f"cannot write {p}: {e}");
        }
    }
    Ok(())
}

// ------------------------------------------------------------ TinyTag.get

fn unsupported() -> Fail {
    fail("UnsupportedFormatError", "No tag reader found to support file type".to_string())
}

// TinyTag._get_parser_for_file_handle
fn magic_class(fh: mut ref Fh) -> i64 {
    let header = fh.read(30);
    if starts(header, "ID3") {
        return K_ID3;
    }
    if header.len() >= 2 and header[0] == 0xFF and (header[1] & 0xE0) == 0xE0 {
        if fh.buf.len() >= 128 {
            fh.seek(fh.buf.len() - 128);
            if is_bytes(fh.read(3), "TAG") {
                return K_ID3;
            }
        }
        return K_MPEG;
    }
    if starts(header, "fLaC") {
        return K_FLAC;
    }
    if starts_at(header, "ftyp", 4) {
        return K_MP4;
    }
    if starts(header, "OggS") {
        return K_OGG;
    }
    if starts(header, "RIFF") and starts_at(header, "WAVE", 8) {
        return K_WAVE;
    }
    if starts_bytes(header, asf_guid("header")) and header.len() > 29 and header[29] == 2 {
        return K_ASF;
    }
    if starts(header, "FORM") and (starts_at(header, "AIFF", 8) or starts_at(header, "AIFC", 8)) {
        return K_AIFF;
    }
    0
}

fn tt_get(name: ref String, tags: bool, duration: bool, image: bool, magic: bool) -> Result[Tag, Fail] {
    let mut kind = 0;
    if not magic {
        kind = ext_class(name);
        if kind == 0 {
            return Err(unsupported());
        }
    }
    let bytes = match fs.read_bytes(name.clone()) {
        Ok(b) => b,
        Err(_) => return Err(fail("FileNotFoundError", f"[Errno 2] No such file or directory: {repr_str(name)}")),
    };
    let mut fh = fh_of(bytes);
    if kind == 0 {
        kind = ext_class(name);
        if kind == 0 {
            kind = magic_class(mut fh);
        }
        if kind == 0 {
            return Err(unsupported());
        }
    }
    let filesize = fh.buf.len();
    fh.seek(0);
    let mut t = new_tag(kind, name, filesize);
    match load(mut t, mut fh, tags, duration, image) {
        Ok(_) => Ok(t),
        Err(e) => Err(fail("ParseError", e.msg)),
    }
}

// ------------------------------------------------------------ the command line

fn usage() {
    println("tinytag [options] <filename...>\n\n    -h, --help\n        Display help\n\n    -i, --save-image <image-path>\n        Save the cover art to a file\n\n    -f, --format json|csv|tsv|tabularcsv\n        Specify how the output should be formatted\n\n    -s, --skip-unsupported\n        Skip files that do not have a file extension supported by tinytag\n\n");
}

fn index_of(argv: ref Vec[String], name: Str) -> i64 {
    let mut i = 0;
    while i < argv.len() {
        if argv[i] == name {
            return i;
        }
        i += 1;
    }
    -1
}

// list.pop(i)
fn pop_at(argv: mut ref Vec[String], i: i64) -> String {
    let mut rest: Vec[String] = Vec.new();
    let mut out = String.new();
    let mut k = 0;
    while k < argv.len() {
        if k == i {
            out = argv[k].clone();
        } else {
            rest.push(argv[k].clone());
        }
        k += 1;
    }
    argv.clear();
    for x in rest.into_iter() {
        argv.push(x);
    }
    out
}

fn pop_param(argv: mut ref Vec[String], name: Str) -> Option[String] {
    let i = index_of(argv, name);
    if i < 0 {
        return None;
    }
    pop_at(mut argv, i);
    Some(pop_at(mut argv, i))
}

fn pop_switch(argv: mut ref Vec[String], name: Str) -> bool {
    let i = index_of(argv, name);
    if i < 0 {
        return false;
    }
    pop_at(mut argv, i);
    true
}

// `a or b` for two optional strings
fn or_param(a: own Option[String], argv: mut ref Vec[String], name: Str) -> Option[String] {
    match a {
        Some(s) => {
            if s.len() > 0 {
                Some(s)
            } else {
                pop_param(mut argv, name)
            }
        }
        None => pop_param(mut argv, name),
    }
}

// os.path.splitext
fn splitext(p: ref String) -> (String, String) {
    let b = p.bytes().to_vec();
    let mut slash = -1;
    let mut dot = -1;
    let mut i = 0;
    while i < b.len() {
        if b[i] == b'/' {
            slash = i;
            dot = -1;
        } else if b[i] == b'.' {
            dot = i;
        }
        i += 1;
    }
    if dot < 0 {
        return (p.clone(), String.new());
    }
    let mut k = slash + 1;
    while k < dot and b[k] == b'.' {
        k += 1;
    }
    if k == dot {
        return (p.clone(), String.new());
    }
    (text_of(sub(b, 0, dot)), text_of(tail(b, dot)))
}

fn is_file(p: ref String) -> bool {
    match fs.metadata(p.clone()) {
        Ok(m) => m.is_file,
        Err(_) => false,
    }
}

// __main__._run
fn run_cli(args: ref Vec[String]) -> i64 {
    let mut argv: Vec[String] = Vec.new();
    argv.push("tinytag".to_string());
    for a in args {
        argv.push(a.clone());
    }
    let mut header_printed = false;
    let first = pop_param(mut argv, "--save-image");
    let image_path = or_param(first, mut argv, "-i");
    let f1 = pop_param(mut argv, "--format");
    let fmt = match or_param(f1, mut argv, "-f") {
        Some(f) => if f.len() > 0 { f } else { "json".to_string() },
        None => "json".to_string(),
    };
    let skip_unsupported = pop_switch(mut argv, "--skip-unsupported") or pop_switch(mut argv, "-s");
    let filenames = argv[1..argv.len()].to_vec();
    let display_help = filenames.len() == 0 or pop_switch(mut argv, "--help") or pop_switch(mut argv, "-h");
    if display_help {
        usage();
        return 0;
    }
    let mut i = 0;
    while i < filenames.len() {
        let filename = filenames[i].clone();
        if skip_unsupported and not (ext_class(filename) != 0 and is_file(filename)) {
            i += 1;
            continue;
        }
        let tag = match tt_get(filename, true, true, false or image_path.is_some(), true) {
            Ok(t) => t,
            Err(e) => {
                println(f"{filename}: {e.msg}");
                return 1;
            }
        };
        if let Some(path) = image_path.clone() {
            if path.len() > 0 {
                let mut actual = path.clone();
                if filenames.len() > 1 {
                    let (root, ext) = splitext(path);
                    actual = f"{root}{i:05}{ext}";
                }
                if let Some(im) = tag.images.any() {
                    if let Err(e) = fs.write_bytes(actual.clone(), im.data) {
                        println(f"{filename}: {e}");
                        return 1;
                    }
                }
            }
        }
        header_printed = print_tag(tag, fmt, header_printed);
        i += 1;
    }
    0
}

// ------------------------------------------------------------ the jobs

fn show_images(t: ref Tag) {
    let images = t.images.as_dict();
    if images.len() == 0 {
        println("no images");
    }
    for (k, v) in images.into_iter() {
        println(f"{k}: {repr_images(v)}");
    }
    let any = match t.images.any() {
        Some(im) => repr_image(im),
        None => "None".to_string(),
    };
    println(f"any: {any}");
}

fn job_get(args: ref Vec[String]) {
    let name = args[0].clone();
    let mut tags = true;
    let mut duration = true;
    let mut image = false;
    let mut magic = true;
    let mut i = 1;
    while i < args.len() {
        if let Some((k, v)) = split_eq(args[i]) {
            let on = v == "1";
            if k == "tags" {
                tags = on;
            } else if k == "duration" {
                duration = on;
            } else if k == "image" {
                image = on;
            } else if k == "magic" {
                magic = on;
            }
        }
        i += 1;
    }
    match tt_get(name, tags, duration, image, magic) {
        Ok(t) => {
            println(to_json(t.as_dict()));
            if image {
                show_images(t);
            }
        }
        Err(e) => println(f"error: {e.kind}: {e.msg}"),
    }
}

fn job_images(name: ref String) {
    match tt_get(name, true, true, true, true) {
        Ok(t) => show_images(t),
        Err(e) => println(f"error: {e.kind}: {e.msg}"),
    }
}

fn job_files(dir: ref String) {
    let mut names = match fs.read_dir(dir.clone()) {
        Ok(v) => v,
        Err(e) => {
            println(f"cannot list {dir}: {e}");
            return;
        }
    };
    names.sort();
    for n in names.iter() {
        let p = f"{dir}/{n}";
        match fs.read_bytes(p.clone()) {
            Ok(b) => println(f"{n} {b.len()} bytes {hex_str(sub(b, 0, 16))}"),
            Err(e) => println(f"cannot read {p}: {e}"),
        }
    }
}

fn split_ws(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for p in s.split(" ") {
        if p.len() > 0 {
            out.push(p.to_string());
        }
    }
    out
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    let text = match fs.read_to_string("data/jobs.txt".to_string()) {
        Ok(t) => t,
        Err(e) => {
            eprintln(f"cannot read data/jobs.txt: {e}");
            return;
        }
    };
    for raw in text.lines() {
        let line = raw.trim().to_string();
        if line.len() == 0 or raw.starts_with("#") {
            continue;
        }
        println(f"$ {line}");
        let parts = split_ws(line);
        let cmd = parts[0].clone();
        let args = parts[1..parts.len()].to_vec();
        if cmd == "tinytag" {
            let rc = run_cli(args);
            println(f"exit {rc}");
        } else if cmd == "get" {
            job_get(args);
        } else if cmd == "images" {
            job_images(args[0]);
        } else if cmd == "supported" {
            for a in args.iter() {
                let ok = if ext_class(a) != 0 { "True" } else { "False" };
                println(f"{a}: {ok}");
            }
        } else if cmd == "files" {
            job_files(args[0]);
        } else {
            println("unknown job");
        }
    }
}
// ------------------------------------------------------------ errors

// A Python exception as tinytag's callers see it: its class name and
// str(). Parser failures are wrapped in ParseError, as TinyTag.get wraps
// whatever _load raises.
#[derive(Clone)]
struct Fail {
    kind: String,
    msg: String,
}

fn fail(kind: Str, msg: own String) -> Fail {
    Fail { kind: kind.to_string(), msg: msg }
}

fn parse_error(msg: Str) -> Fail {
    fail("ParseError", msg.to_string())
}

// struct.unpack_from's check, with its message.
fn need(b: ref Vec[u8], off: i64, size: i64) -> Result[(), Fail] {
    if off + size > b.len() {
        return Err(fail("ParseError", f"unpack_from requires a buffer of at least {size + off} bytes for unpacking {size} bytes at offset {off} (actual buffer size is {b.len()})"));
    }
    Ok(())
}

// struct.unpack's check: the buffer must be exactly the format's size.
fn need_exact(b: ref Vec[u8], size: i64) -> Result[(), Fail] {
    if b.len() != size {
        return Err(fail("ParseError", f"unpack requires a buffer of {size} bytes"));
    }
    Ok(())
}

// b[i], or IndexError
fn at(b: ref Vec[u8], i: i64) -> Result[i64, Fail] {
    if i < 0 or i >= b.len() {
        return Err(fail("ParseError", "index out of range".to_string()));
    }
    Ok(b[i] as i64)
}

// ------------------------------------------------------------ bytes

fn sub(b: ref Vec[u8], start: i64, end: i64) -> Vec[u8] {
    let mut s = start;
    let mut e = end;
    if e > b.len() {
        e = b.len();
    }
    if s < 0 {
        s = 0;
    }
    if s > e {
        s = e;
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i = s;
    while i < e {
        out.push(b[i]);
        i += 1;
    }
    out
}

fn tail(b: ref Vec[u8], start: i64) -> Vec[u8] {
    sub(b, start, b.len())
}

fn push_all(out: mut ref Vec[u8], b: ref Vec[u8]) {
    for x in b {
        out.push(x);
    }
}

fn bytes_of(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn same_bytes(a: ref Vec[u8], b: ref Vec[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

// b.startswith(p, at)
fn starts_at(b: ref Vec[u8], p: Str, at: i64) -> bool {
    let q = p.bytes().to_vec();
    if at + q.len() > b.len() {
        return false;
    }
    let mut i = 0;
    while i < q.len() {
        if b[at + i] != q[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn starts(b: ref Vec[u8], p: Str) -> bool {
    starts_at(b, p, 0)
}

fn starts_bytes(b: ref Vec[u8], q: ref Vec[u8]) -> bool {
    if q.len() > b.len() {
        return false;
    }
    let mut i = 0;
    while i < q.len() {
        if b[i] != q[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn is_bytes(b: ref Vec[u8], p: Str) -> bool {
    b.len() == p.len() and starts(b, p)
}

// bytes.find(needle, start)
fn find_bytes(b: ref Vec[u8], needle: ref Vec[u8], start: i64) -> i64 {
    let mut i = if start < 0 { 0 } else { start };
    while i + needle.len() <= b.len() {
        let mut k = 0;
        while k < needle.len() and b[i + k] == needle[k] {
            k += 1;
        }
        if k == needle.len() {
            return i;
        }
        i += 1;
    }
    -1
}

fn find_str(b: ref Vec[u8], needle: Str, start: i64) -> i64 {
    find_bytes(b, needle.bytes().to_vec(), start)
}

// bytes.rstrip(b'\x00')
fn unpad_bytes(b: ref Vec[u8]) -> Vec[u8] {
    let mut e = b.len();
    while e > 0 and b[e - 1] == 0 {
        e -= 1;
    }
    sub(b, 0, e)
}

// bytes.split(b'\x00')
fn split_nul(b: ref Vec[u8]) -> Vec[Vec[u8]] {
    let mut out: Vec[Vec[u8]] = Vec.new();
    let mut cur: Vec[u8] = Vec.new();
    for x in b {
        if x == 0 {
            out.push(cur.clone());
            cur = Vec.new();
        } else {
            cur.push(x);
        }
    }
    out.push(cur);
    out
}

fn uint(b: ref Vec[u8], off: i64, n: i64, le: bool) -> i64 {
    let mut v: i64 = 0;
    let mut i = 0;
    while i < n {
        let k = if le { off + n - 1 - i } else { off + i };
        v = (v << 8) | (b[k] as i64);
        i += 1;
    }
    v
}

// A signed integer of n bytes.
fn sint(b: ref Vec[u8], off: i64, n: i64, le: bool) -> i64 {
    let v = uint(b, off, n, le);
    if n == 8 {
        return v;
    }
    let top = 1 << (8 * n - 1);
    if v >= top { v - 2 * top } else { v }
}

fn be16(b: ref Vec[u8], off: i64) -> i64 {
    uint(b, off, 2, false)
}

fn be32(b: ref Vec[u8], off: i64) -> i64 {
    uint(b, off, 4, false)
}

fn le16(b: ref Vec[u8], off: i64) -> i64 {
    uint(b, off, 2, true)
}

fn le32(b: ref Vec[u8], off: i64) -> i64 {
    uint(b, off, 4, true)
}

fn hex2(b: u8) -> String {
    f"{b:02x}"
}

fn hex_str(b: ref Vec[u8]) -> String {
    let mut s = String.new();
    for x in b {
        s.push_str(hex2(x));
    }
    s
}

// f'{n:X}'
fn hex_upper(n: i64) -> String {
    f"{n:X}"
}

// ------------------------------------------------------------ text

fn push_cp(out: mut ref Vec[u8], c: i64) {
    if c < 0x80 {
        out.push(c as u8);
    } else if c < 0x800 {
        out.push((0xC0 | (c >> 6)) as u8);
        out.push((0x80 | (c & 0x3F)) as u8);
    } else if c < 0x10000 {
        out.push((0xE0 | (c >> 12)) as u8);
        out.push((0x80 | ((c >> 6) & 0x3F)) as u8);
        out.push((0x80 | (c & 0x3F)) as u8);
    } else {
        out.push((0xF0 | (c >> 18)) as u8);
        out.push((0x80 | ((c >> 12) & 0x3F)) as u8);
        out.push((0x80 | ((c >> 6) & 0x3F)) as u8);
        out.push((0x80 | (c & 0x3F)) as u8);
    }
}

fn text_of(b: ref Vec[u8]) -> String {
    String.from_utf8(b.clone()).unwrap_or("?".to_string())
}

fn latin1(b: ref Vec[u8]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for x in b {
        push_cp(mut out, x as i64);
    }
    text_of(out)
}

// .decode('utf-8', 'replace'): each maximal invalid subpart becomes one
// U+FFFD, as CPython's decoder reports its errors.
fn utf8_replace(input: ref Vec[u8]) -> String {
    let n = input.len();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < n {
        let b = input[i] as i64;
        if b < 0x80 {
            out.push(b as u8);
            i += 1;
            continue;
        }
        let mut need = 0;
        let mut lo = 0x80;
        let mut hi = 0xBF;
        if b >= 0xC2 and b <= 0xDF {
            need = 1;
        } else if b >= 0xE0 and b <= 0xEF {
            need = 2;
            if b == 0xE0 {
                lo = 0xA0;
            }
            if b == 0xED {
                hi = 0x9F;
            }
        } else if b >= 0xF0 and b <= 0xF4 {
            need = 3;
            if b == 0xF0 {
                lo = 0x90;
            }
            if b == 0xF4 {
                hi = 0x8F;
            }
        }
        if need == 0 {
            push_cp(mut out, 0xFFFD);
            i += 1;
            continue;
        }
        let mut k = 1;
        let mut bad = false;
        while k <= need {
            if i + k >= n {
                break;
            }
            let c = input[i + k] as i64;
            let low = if k == 1 { lo } else { 0x80 };
            let high = if k == 1 { hi } else { 0xBF };
            if c < low or c > high {
                bad = true;
                break;
            }
            k += 1;
        }
        if bad {
            push_cp(mut out, 0xFFFD);
            i += k;
            continue;
        }
        if k <= need {
            // cut off by the end of the input
            push_cp(mut out, 0xFFFD);
            i = n;
            continue;
        }
        let mut j = 1;
        let mut c = if need == 1 { b & 0x1F } else if need == 2 { b & 0x0F } else { b & 0x07 };
        while j <= need {
            c = (c << 6) | ((input[i + j] as i64) & 0x3F);
            j += 1;
        }
        push_cp(mut out, c);
        i += need + 1;
    }
    text_of(out)
}

fn unit16(input: ref Vec[u8], i: i64, be: bool) -> i64 {
    if be {
        ((input[i] as i64) << 8) | (input[i + 1] as i64)
    } else {
        (input[i] as i64) | ((input[i + 1] as i64) << 8)
    }
}

// .decode('utf-16-le' or 'utf-16-be', 'replace')
fn utf16_replace(input: ref Vec[u8], be: bool) -> String {
    let n = input.len();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < n {
        if i + 1 >= n {
            push_cp(mut out, 0xFFFD);
            i = n;
            continue;
        }
        let u = unit16(input, i, be);
        if u < 0xD800 or u > 0xDFFF {
            push_cp(mut out, u);
            i += 2;
            continue;
        }
        if u >= 0xDC00 {
            push_cp(mut out, 0xFFFD);
            i += 2;
            continue;
        }
        if i + 3 >= n {
            push_cp(mut out, 0xFFFD);
            i = n;
            continue;
        }
        let u2 = unit16(input, i + 2, be);
        if u2 >= 0xDC00 and u2 <= 0xDFFF {
            push_cp(mut out, 0x10000 + ((u - 0xD800) << 10) + (u2 - 0xDC00));
            i += 4;
        } else {
            push_cp(mut out, 0xFFFD);
            i += 2;
        }
    }
    text_of(out)
}

// str.rstrip('\x00')
fn unpad(s: ref String) -> String {
    let b = s.bytes().to_vec();
    text_of(unpad_bytes(b))
}

// str.isdecimal() for the ASCII digits
fn is_decimal(s: ref String) -> bool {
    if s.len() == 0 {
        return false;
    }
    for c in s.bytes() {
        if c < b'0' or c > b'9' {
            return false;
        }
    }
    true
}

fn to_int(s: ref String) -> i64 {
    let mut v = 0;
    for c in s.bytes() {
        v = v * 10 + (c - b'0') as i64;
    }
    v
}

// value.split('/')[:2], as (value, total, found)
fn split_slash(v: ref String) -> (String, String, bool) {
    match v.find("/") {
        Some(i) => {
            let rest = v[i + 1..v.len()].to_string();
            let total = match rest.find("/") {
                Some(j) => rest[0..j].to_string(),
                None => rest.clone(),
            };
            (v[0..i].to_string(), total, true)
        }
        None => (v.clone(), String.new(), false),
    }
}

// key.split('=', 1)
fn split_eq(s: ref String) -> Option[(String, String)] {
    match s.find("=") {
        Some(i) => Some((s[0..i].to_string(), s[i + 1..s.len()].to_string())),
        None => None,
    }
}

// a2b_base64 in its lenient mode: characters outside the alphabet are
// skipped, and decoding stops at padding.
fn b64_val(c: u8) -> i64 {
    if c >= b'A' and c <= b'Z' {
        (c - b'A') as i64
    } else if c >= b'a' and c <= b'z' {
        (c - b'a') as i64 + 26
    } else if c >= b'0' and c <= b'9' {
        (c - b'0') as i64 + 52
    } else if c == b'+' {
        62
    } else if c == b'/' {
        63
    } else {
        -1
    }
}

fn b64_decode(s: ref String) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut acc = 0;
    let mut bits = 0;
    for c in s.bytes() {
        if c == b'=' {
            break;
        }
        let v = b64_val(c);
        if v < 0 {
            continue;
        }
        acc = (acc << 6) | v;
        bits += 6;
        if bits >= 8 {
            bits -= 8;
            out.push(((acc >> bits) & 0xff) as u8);
        }
    }
    out
}

// ------------------------------------------------------------ repr

fn quote_for(b: ref Vec[u8]) -> u8 {
    let mut single = false;
    let mut double = false;
    for c in b {
        if c == 39 {
            single = true;
        }
        if c == 34 {
            double = true;
        }
    }
    if single and not double { 34 } else { 39 }
}

fn repr_bytes(b: ref Vec[u8]) -> String {
    let q = quote_for(b);
    let mut out: Vec[u8] = Vec.new();
    out.push(b'b');
    out.push(q);
    for x in b {
        if x == q or x == 92 {
            out.push(92);
            out.push(x);
        } else if x == 9 {
            push_all(mut out, bytes_of("\\t"));
        } else if x == 10 {
            push_all(mut out, bytes_of("\\n"));
        } else if x == 13 {
            push_all(mut out, bytes_of("\\r"));
        } else if x >= 0x20 and x < 0x7F {
            out.push(x);
        } else {
            push_all(mut out, bytes_of(f"\\x{hex2(x)}"));
        }
    }
    out.push(q);
    text_of(out)
}

// repr(str): the C0 and C1 controls, NO-BREAK SPACE and SOFT HYPHEN
// are escaped; everything else these files hold is printable.
fn repr_str(s: ref String) -> String {
    let q = quote_for(s.bytes().to_vec());
    let qc = q as char;
    let mut out = String.new();
    out.push(qc);
    for c in s.chars() {
        let n = c as i64;
        if c == qc or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if n == 9 {
            out.push_str("\\t");
        } else if n == 10 {
            out.push_str("\\n");
        } else if n == 13 {
            out.push_str("\\r");
        } else if n < 0x20 or (n >= 0x7F and n <= 0xA0) or n == 0xAD {
            out.push_str(f"\\x{hex2(n as u8)}");
        } else {
            out.push(c);
        }
    }
    out.push(qc);
    out
}

fn repr_opt(s: ref Option[String]) -> String {
    match s {
        Some(x) => repr_str(x),
        None => "None".to_string(),
    }
}

// ------------------------------------------------------------ a file

// A binary file object (or a BytesIO) over bytes already read: read,
// seek and tell as Python has them, so a seek may go past the end.
struct Fh {
    buf: Vec[u8],
    pos: i64,
}

impl Fh {
    fn read(mut ref self, n: i64) -> Vec[u8] {
        let start = self.pos;
        let mut end = start + n;
        if n < 0 or end > self.buf.len() {
            end = self.buf.len();
        }
        if start >= end {
            return Vec.new();
        }
        self.pos = end;
        sub(self.buf, start, end)
    }

    fn seek(mut ref self, p: i64) -> i64 {
        self.pos = p;
        p
    }

    fn skip(mut ref self, n: i64) -> i64 {
        self.pos += n;
        self.pos
    }

    fn tell(ref self) -> i64 {
        self.pos
    }
}

fn fh_of(b: own Vec[u8]) -> Fh {
    Fh { buf: b, pos: 0 }
}
// ------------------------------------------------------------ values

// A field's value: tinytag stores str, int, float and bool.
#[derive(Clone)]
enum Val {
    Str(String),
    Int(i64),
    Float(f64),
    Bool(bool),
}

fn num_of(v: ref Val) -> Option[f64] {
    match v {
        Val.Int(n) => Some(n as f64),
        Val.Float(x) => Some(x),
        Val.Bool(b) => Some(if b { 1.0 } else { 0.0 }),
        Val.Str(_) => None,
    }
}

// value == old_value, as Python compares them: numbers across types, and
// a str never equal to a number.
fn val_eq(a: ref Val, b: ref Val) -> bool {
    match a {
        Val.Str(x) => match b {
            Val.Str(y) => x == y,
            _ => false,
        },
        _ => match (num_of(a), num_of(b)) {
            (Some(x), Some(y)) => x == y,
            _ => false,
        },
    }
}

fn py_float(x: f64) -> String {
    f"{x}"
}

// str(value)
fn val_str(v: ref Val) -> String {
    match v {
        Val.Str(s) => s.clone(),
        Val.Int(n) => f"{n}",
        Val.Float(x) => py_float(x),
        Val.Bool(b) => if b { "True".to_string() } else { "False".to_string() },
    }
}

fn s_val(s: Str) -> Val {
    Val.Str(s.to_string())
}

// ------------------------------------------------------------ images

#[derive(Clone)]
struct Image {
    name: String,
    size: i64,
    data: Vec[u8],
    mime_type: Option[String],
    description: Option[String],
}

// Image.__repr__: the data cut to 45 bytes and '..'.
fn repr_image(im: ref Image) -> String {
    let mut d = im.data.clone();
    if d.len() > 45 {
        d = sub(im.data, 0, 45);
        d.push(b'.');
        d.push(b'.');
    }
    f"Image(name={repr_str(im.name)}, size={im.size}, data={repr_bytes(d)}, mime_type={repr_opt(im.mime_type)}, description={repr_opt(im.description)})"
}

fn repr_images(v: ref Vec[Image]) -> String {
    let mut s = "[".to_string();
    let mut i = 0;
    while i < v.len() {
        if i > 0 {
            s.push_str(", ");
        }
        s.push_str(repr_image(v[i]));
        i += 1;
    }
    s.push_str("]");
    s
}

// tinytag's Images: three named slots, then the OtherImages dict.
#[derive(Clone)]
struct Images {
    front_cover: Option[Image],
    back_cover: Option[Image],
    media: Option[Image],
    keys: Vec[String],
    lists: Vec[Vec[Image]],
}

fn no_images() -> Images {
    Images { front_cover: None, back_cover: None, media: None, keys: Vec.new(), lists: Vec.new() }
}

impl Images {
    fn slot(ref self, name: ref String) -> Option[Option[Image]] {
        if name == "front_cover" {
            Some(self.front_cover.clone())
        } else if name == "back_cover" {
            Some(self.back_cover.clone())
        } else if name == "media" {
            Some(self.media.clone())
        } else {
            None
        }
    }

    fn set_slot(mut ref self, name: ref String, im: own Image) {
        if name == "front_cover" {
            self.front_cover = Some(im);
        } else if name == "back_cover" {
            self.back_cover = Some(im);
        } else {
            self.media = Some(im);
        }
    }

    fn set_other_field(mut ref self, name: ref String, im: own Image) {
        let mut i = 0;
        while i < self.keys.len() {
            if self.keys[i] == name {
                self.lists[i].push(im);
                return;
            }
            i += 1;
        }
        self.keys.push(name.clone());
        let mut l: Vec[Image] = Vec.new();
        l.push(im);
        self.lists.push(l);
    }

    // Images._set_field. Every name tinytag hands it is one of the three
    // slots or starts with 'other.'.
    fn set_field(mut ref self, name: ref String, im: own Image) {
        match self.slot(name) {
            Some(Some(_)) => {
                self.set_other_field(name, im);
                return;
            }
            Some(None) => {
                self.set_slot(name, im);
                return;
            }
            None => {}
        }
        if name.starts_with("other.") {
            let short = name[6..name.len()].to_string();
            self.set_other_field(short, im);
        } else {
            self.set_other_field(name, im);
        }
    }

    fn update(mut ref self, other: ref Images) {
        if let Some(im) = other.front_cover.clone() {
            self.set_field("front_cover".to_string(), im);
        }
        if let Some(im) = other.back_cover.clone() {
            self.set_field("back_cover".to_string(), im);
        }
        if let Some(im) = other.media.clone() {
            self.set_field("media".to_string(), im);
        }
        let mut i = 0;
        while i < other.keys.len() {
            for im in other.lists[i].clone().into_iter() {
                self.set_other_field(other.keys[i], im);
            }
            i += 1;
        }
    }

    fn any(ref self) -> Option[Image] {
        if self.front_cover.is_some() {
            return self.front_cover.clone();
        }
        if self.back_cover.is_some() {
            return self.back_cover.clone();
        }
        if self.media.is_some() {
            return self.media.clone();
        }
        for l in self.lists.clone().into_iter() {
            for im in l.into_iter() {
                return Some(im);
            }
        }
        None
    }

    fn as_dict(ref self) -> Vec[(String, Vec[Image])] {
        let mut out: Vec[(String, Vec[Image])] = Vec.new();
        if let Some(im) = self.front_cover.clone() {
            out.push(("front_cover".to_string(), vec_of_image(im)));
        }
        if let Some(im) = self.back_cover.clone() {
            out.push(("back_cover".to_string(), vec_of_image(im)));
        }
        if let Some(im) = self.media.clone() {
            out.push(("media".to_string(), vec_of_image(im)));
        }
        let mut i = 0;
        while i < self.keys.len() {
            let mut found = false;
            let mut j = 0;
            while j < out.len() {
                if out[j].0 == self.keys[i] {
                    found = true;
                    for im in self.lists[i].clone().into_iter() {
                        out[j].1.push(im);
                    }
                }
                j += 1;
            }
            if not found {
                out.push((self.keys[i].clone(), self.lists[i].clone()));
            }
            i += 1;
        }
        out
    }
}

fn vec_of_image(im: own Image) -> Vec[Image] {
    let mut v: Vec[Image] = Vec.new();
    v.push(im);
    v
}

// ------------------------------------------------------------ the tag

// The parser classes; each adds its own private attributes to __dict__.
const K_ID3: i64 = 1;
const K_MPEG: i64 = 2;
const K_OGG: i64 = 3;
const K_WAVE: i64 = 4;
const K_FLAC: i64 = 5;
const K_ASF: i64 = 6;
const K_MP4: i64 = 7;
const K_AIFF: i64 = 8;

// The public attributes TinyTag.__init__ creates, in order. After them
// in __dict__ come images, other, the private attributes, and then any
// attribute a parser added.
fn public_names() -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    for n in ["filename", "filesize", "mime_type", "is_lossless", "duration", "channels", "bitrate", "bitdepth", "samplerate", "artist", "albumartist", "composer", "album", "disc", "disc_total", "title", "track", "track_total", "genre", "year", "comment"] {
        v.push(n.to_string());
    }
    v
}

const N_PUBLIC: i64 = 21;

fn private_names(kind: i64) -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    for n in ["_filehandler", "_default_encoding", "_parse_duration", "_parse_tags", "_load_image", "_duration_parsed", "_tags_parsed"] {
        v.push(n.to_string());
    }
    if kind == K_ID3 {
        for n in ["_only_id3", "_modern_grouping_values", "_legacy_grouping_values"] {
            v.push(n.to_string());
        }
    } else if kind == K_MPEG {
        v.push("_end_padding".to_string());
    } else if kind == K_OGG {
        for n in ["_granule_pos", "_audio_size", "_granule_pos_serial", "_audio_size_serial"] {
            v.push(n.to_string());
        }
    }
    v
}

struct Tag {
    kind: i64,
    names: Vec[String],
    vals: Vec[Option[Val]],
    other_keys: Vec[String],
    other_lists: Vec[Vec[String]],
    images: Images,
    parse_tags: bool,
    parse_duration: bool,
    load_image: bool,
    duration_parsed: bool,
    tags_parsed: bool,
    // _ID3
    only_id3: bool,
    modern_grouping: Vec[String],
    legacy_grouping: Vec[String],
    // _MPEG
    end_padding: i64,
    // _Ogg
    granule_pos: i64,
    audio_size: i64,
    granule_pos_serial: Option[i64],
    audio_size_serial: Option[i64],
}

fn new_tag(kind: i64, filename: ref String, filesize: i64) -> Tag {
    let names = public_names();
    let mut vals: Vec[Option[Val]] = Vec.new();
    let mut i = 0;
    while i < names.len() {
        vals.push(None);
        i += 1;
    }
    vals[0] = Some(Val.Str(filename.clone()));
    vals[1] = Some(Val.Int(filesize));
    Tag {
        kind: kind,
        names: names,
        vals: vals,
        other_keys: Vec.new(),
        other_lists: Vec.new(),
        images: no_images(),
        parse_tags: true,
        parse_duration: true,
        load_image: false,
        duration_parsed: false,
        tags_parsed: false,
        only_id3: false,
        modern_grouping: Vec.new(),
        legacy_grouping: Vec.new(),
        end_padding: 0,
        granule_pos: 0,
        audio_size: 0,
        granule_pos_serial: None,
        audio_size_serial: None,
    }
}

impl Tag {
    fn index(ref self, name: ref String) -> i64 {
        let mut i = 0;
        while i < self.names.len() {
            if self.names[i] == name {
                return i;
            }
            i += 1;
        }
        -1
    }

    fn get(ref self, name: Str) -> Option[Val] {
        let i = self.index(name.to_string());
        if i < 0 {
            return None;
        }
        self.vals[i].clone()
    }

    // `not self.<name>`, for a str field
    fn empty(ref self, name: Str) -> bool {
        match self.get(name) {
            None => true,
            Some(Val.Str(s)) => s.len() == 0,
            Some(v) => match num_of(v) {
                Some(x) => x == 0.0,
                None => false,
            },
        }
    }

    // self.<name> = value
    fn put(mut ref self, name: ref String, v: own Val) {
        let i = self.index(name);
        if i < 0 {
            self.names.push(name.clone());
            self.vals.push(Some(v));
        } else {
            self.vals[i] = Some(v);
        }
    }

    fn set(mut ref self, name: Str, v: own Val) {
        self.put(name.to_string(), v);
    }

    // fieldname in self.__dict__
    fn in_dict(ref self, name: ref String) -> bool {
        if self.index(name) >= 0 or name == "images" or name == "other" {
            return true;
        }
        for p in private_names(self.kind) {
            if p == name {
                return true;
            }
        }
        false
    }

    fn set_other_field(mut ref self, name: ref String, value: ref String) {
        if value.len() == 0 {
            return;
        }
        let mut i = 0;
        while i < self.other_keys.len() {
            if self.other_keys[i] == name {
                for x in self.other_lists[i].clone() {
                    if x == value {
                        return;
                    }
                }
                self.other_lists[i].push(value.clone());
                return;
            }
            i += 1;
        }
        self.other_keys.push(name.clone());
        let mut l: Vec[String] = Vec.new();
        l.push(value.clone());
        self.other_lists.push(l);
    }

    fn set_other(mut ref self, name: Str, value: ref String) {
        self.set_other_field(name.to_string(), value);
    }

    fn set_field(mut ref self, name: ref String, value: own Val) {
        if let Val.Str(s) = value.clone() {
            if s.len() == 0 {
                return;
            }
        }
        let i = self.index(name);
        let old = if i < 0 { None } else { self.vals[i].clone() };
        if let Some(o) = old {
            if val_eq(value, o) {
                return;
            }
            self.set_other_field(name, val_str(value));
            return;
        }
        if name.starts_with("other.") {
            let mut short = name[6..name.len()].to_string();
            if self.in_dict(short) {
                short = f"_{short}";
            }
            self.set_other_field(short, val_str(value));
            return;
        }
        self.put(name, value);
    }

    fn sf(mut ref self, name: Str, value: own Val) {
        self.set_field(name.to_string(), value);
    }

    fn update(mut ref self, other: ref Tag) {
        let mut i = 3;
        while i < N_PUBLIC {
            if let Some(v) = other.vals[i].clone() {
                self.set_field(other.names[i], v);
            }
            i += 1;
        }
        self.images.update(other.images);
        let mut k = 0;
        while k < other.other_keys.len() {
            for v in other.other_lists[k].clone() {
                self.set_other_field(other.other_keys[k], v);
            }
            k += 1;
        }
        i = N_PUBLIC;
        while i < other.names.len() {
            if let Some(v) = other.vals[i].clone() {
                self.set_field(other.names[i], v);
            }
            i += 1;
        }
    }

    fn as_dict(ref self) -> Vec[(String, Field)] {
        let mut out: Vec[(String, Field)] = Vec.new();
        let mut i = 0;
        while i < N_PUBLIC {
            self.dict_entry(mut out, i);
            i += 1;
        }
        let mut k = 0;
        while k < self.other_keys.len() {
            let key = self.other_keys[k].clone();
            let mut at = -1;
            let mut j = 0;
            while j < out.len() {
                if out[j].0 == key {
                    at = j;
                }
                j += 1;
            }
            if at < 0 {
                out.push((key, Field.List(self.other_lists[k].clone())));
            } else {
                let merged = match out[at].1.clone() {
                    Field.List(l) => {
                        let mut l2 = l.clone();
                        for x in self.other_lists[k].clone() {
                            l2.push(x.clone());
                        }
                        l2
                    }
                    Field.Raw(_) => self.other_lists[k].clone(),
                };
                out[at] = (key, Field.List(merged));
            }
            k += 1;
        }
        i = N_PUBLIC;
        while i < self.names.len() {
            self.dict_entry(mut out, i);
            i += 1;
        }
        out
    }

    fn dict_entry(ref self, out: mut ref Vec[(String, Field)], i: i64) {
        if let Some(v) = self.vals[i].clone() {
            let key = self.names[i].clone();
            if is_audio_key(key) {
                out.push((key, Field.Raw(v)));
            } else {
                let mut l: Vec[String] = Vec.new();
                l.push(val_str(v));
                out.push((key, Field.List(l)));
            }
        }
    }
}

fn is_audio_key(k: ref String) -> bool {
    for n in ["filename", "filesize", "mime_type", "duration", "channels", "bitrate", "bitdepth", "samplerate", "is_lossless"] {
        if k == n {
            return true;
        }
    }
    false
}

// A value of as_dict(): an audio property as it is, or a list of str.
#[derive(Clone)]
enum Field {
    Raw(Val),
    List(Vec[String]),
}

// ------------------------------------------------------------ output

fn push_json_str(out: mut ref String, s: ref String) {
    out.push_str("\"");
    for c in s.chars() {
        let n = c as i64;
        if c == '"' {
            out.push_str("\\\"");
        } else if c == '\\' {
            out.push_str("\\\\");
        } else if n == 10 {
            out.push_str("\\n");
        } else if n == 13 {
            out.push_str("\\r");
        } else if n == 9 {
            out.push_str("\\t");
        } else if n == 8 {
            out.push_str("\\b");
        } else if n == 12 {
            out.push_str("\\f");
        } else if n < 0x20 {
            out.push_str(f"\\u{n:04x}");
        } else {
            out.push(c);
        }
    }
    out.push_str("\"");
}

fn json_val(v: ref Val) -> String {
    match v {
        Val.Str(s) => {
            let mut o = String.new();
            push_json_str(mut o, s);
            o
        }
        Val.Bool(b) => if b { "true".to_string() } else { "false".to_string() },
        _ => val_str(v),
    }
}

// json.dumps(d, ensure_ascii=False, indent=2)
fn to_json(d: ref Vec[(String, Field)]) -> String {
    if d.len() == 0 {
        return "{}".to_string();
    }
    let mut o = "{\n".to_string();
    let mut i = 0;
    while i < d.len() {
        o.push_str("  ");
        push_json_str(mut o, d[i].0);
        o.push_str(": ");
        match d[i].1.clone() {
            Field.Raw(v) => o.push_str(json_val(v)),
            Field.List(l) => {
                if l.len() == 0 {
                    o.push_str("[]");
                } else {
                    o.push_str("[\n");
                    let mut j = 0;
                    while j < l.len() {
                        o.push_str("    ");
                        push_json_str(mut o, l[j]);
                        if j + 1 < l.len() {
                            o.push_str(",");
                        }
                        o.push_str("\n");
                        j += 1;
                    }
                    o.push_str("  ]");
                }
            }
        }
        if i + 1 < d.len() {
            o.push_str(",");
        }
        o.push_str("\n");
        i += 1;
    }
    o.push_str("}");
    o
}

// str(value) as the csv module writes it
fn field_str(f: ref Field) -> String {
    match f {
        Field.Raw(v) => val_str(v),
        Field.List(l) => {
            let mut s = "[".to_string();
            let mut i = 0;
            while i < l.len() {
                if i > 0 {
                    s.push_str(", ");
                }
                s.push_str(repr_str(l[i]));
                i += 1;
            }
            s.push_str("]");
            s
        }
    }
}

// a csv.writer field, QUOTE_MINIMAL
fn csv_field(s: ref String, delim: u8) -> String {
    let mut quote = false;
    for c in s.bytes() {
        if c == delim or c == b'"' or c == 10 or c == 13 {
            quote = true;
        }
    }
    if not quote {
        return s.clone();
    }
    let mut o = "\"".to_string();
    for c in s.chars() {
        if c == '"' {
            o.push_str("\"\"");
        } else {
            o.push(c);
        }
    }
    o.push_str("\"");
    o
}

fn csv_row(fields: ref Vec[String], delim: u8) -> String {
    let mut o = String.new();
    let mut i = 0;
    while i < fields.len() {
        if i > 0 {
            o.push(delim as char);
        }
        o.push_str(csv_field(fields[i], delim));
        i += 1;
    }
    o.push_str("\n");
    o
}

fn is_py_space(c: u8) -> bool {
    c == 32 or (c >= 9 and c <= 13) or (c >= 0x1c and c <= 0x1f)
}

// str.strip()
fn py_strip(s: ref String) -> String {
    let b = s.bytes().to_vec();
    let mut a = 0;
    let mut e = b.len();
    while a < e and is_py_space(b[a]) {
        a += 1;
    }
    while e > a and is_py_space(b[e - 1]) {
        e -= 1;
    }
    text_of(sub(b, a, e))
}

// __main__._print_tag
fn print_tag(t: ref Tag, fmt: ref String, header_printed: bool) -> bool {
    let data = t.as_dict();
    if fmt == "json" {
        println(to_json(data));
        return header_printed;
    }
    if fmt != "csv" and fmt != "tsv" and fmt != "tabularcsv" {
        return header_printed;
    }
    let mut keys: Vec[String] = Vec.new();
    let mut vals: Vec[String] = Vec.new();
    for (k, f) in data.into_iter() {
        let s = match f {
            Field.Raw(Val.Str(x)) => x.replace("\u{0}", ";"),
            _ => field_str(f),
        };
        keys.push(k);
        vals.push(s);
    }
    let delim = if fmt == "tsv" { b'\t' } else { b',' };
    let mut hp = header_printed;
    let mut text = String.new();
    if fmt == "tabularcsv" {
        if not hp {
            text.push_str(csv_row(keys, delim));
            hp = true;
        }
        text.push_str(csv_row(vals, delim));
        text = py_strip(text);
    } else {
        let mut i = 0;
        while i < keys.len() {
            let mut row: Vec[String] = Vec.new();
            row.push(keys[i].clone());
            row.push(vals[i].clone());
            text.push_str(csv_row(row, delim));
            i += 1;
        }
    }
    println(text);
    hp
}
// ------------------------------------------------------------ loading

// TinyTag._load: the flags, then the class's _parse unless the file is
// empty or neither tags nor duration were asked for.
fn load(t: mut ref Tag, fh: mut ref Fh, tags: bool, duration: bool, image: bool) -> Result[(), Fail] {
    t.parse_tags = tags;
    t.parse_duration = duration;
    t.load_image = image;
    if t.filesize() == 0 {
        return Ok(());
    }
    if tags or duration {
        parse(mut t, mut fh)?;
    }
    Ok(())
}

fn parse(t: mut ref Tag, fh: mut ref Fh) -> Result[(), Fail] {
    let k = t.kind;
    if k == K_ID3 {
        parse_id3(mut t, mut fh)
    } else if k == K_MPEG {
        parse_mpeg(mut t, mut fh)
    } else if k == K_OGG {
        parse_ogg(mut t, mut fh)
    } else if k == K_WAVE {
        parse_wave(mut t, mut fh)
    } else if k == K_FLAC {
        parse_flac(mut t, mut fh)
    } else if k == K_ASF {
        parse_asf(mut t, mut fh)
    } else if k == K_MP4 {
        parse_mp4(mut t, mut fh)
    } else {
        parse_aiff(mut t, mut fh)
    }
}

// A parser for a part of the file, as tinytag makes one: a fresh tag of
// that class with the outer tag's filename and filesize.
fn sub_tag(kind: i64, t: ref Tag) -> Tag {
    new_tag(kind, t.filename(), t.filesize())
}

impl Tag {
    fn filename(ref self) -> String {
        match self.vals[0].clone() {
            Some(Val.Str(s)) => s,
            _ => String.new(),
        }
    }

    fn filesize(ref self) -> i64 {
        match self.vals[1].clone() {
            Some(Val.Int(n)) => n,
            _ => 0,
        }
    }

    // an int attribute, or 0 when it is None
    fn int_of(ref self, name: Str) -> i64 {
        match self.get(name) {
            Some(Val.Int(n)) => n,
            _ => 0,
        }
    }

    fn float_of(ref self, name: Str) -> f64 {
        match self.get(name) {
            Some(v) => match num_of(v) {
                Some(x) => x,
                None => 0.0,
            },
            None => 0.0,
        }
    }
}

// ------------------------------------------------------------ _ID3

fn nul1() -> Vec[u8] {
    bytes_of("\u{0}")
}

fn nul2() -> Vec[u8] {
    bytes_of("\u{0}\u{0}")
}

// _ID3._find_string_end_pos
fn find_end(content: ref Vec[u8], enc: i64, start: i64) -> i64 {
    if enc == 0 or enc == 3 {
        let e = find_bytes(content, nul1(), start);
        return if e < 0 { start } else { e + 1 };
    }
    let mut e = find_bytes(content, nul2(), start);
    while e >= 0 and (e - start) % 2 != 0 {
        e = find_bytes(content, nul2(), e + 1);
    }
    if e < 0 { start } else { e + 2 }
}

// _ID3._decode_string; an encoding of -1 is None.
fn decode_string(v: ref Vec[u8], enc: i64) -> String {
    let s = if enc == 1 {
        let be = v.len() >= 2 and v[0] == 0xFE and v[1] == 0xFF;
        let le = v.len() >= 2 and v[0] == 0xFF and v[1] == 0xFE;
        if be or le {
            let end = if v.len() % 2 == 0 { v.len() } else { v.len() - 1 };
            utf16_replace(sub(v, 2, end), be)
        } else {
            utf16_replace(v, false)
        }
    } else if enc == 2 {
        if v.len() % 2 != 0 {
            utf16_replace(sub(v, 0, v.len() - 1), true)
        } else {
            utf16_replace(v, true)
        }
    } else if enc == 3 {
        utf8_replace(v)
    } else {
        latin1(v)
    };
    unpad(s)
}

fn unsynchsafe(d: ref Vec[u8], off: i64) -> Result[i64, Fail] {
    let a = at(d, off)?;
    let b = at(d, off + 1)?;
    let c = at(d, off + 2)?;
    let e = at(d, off + 3)?;
    Ok((a << 21) | (b << 14) | (c << 7) | e)
}

fn ascii_lower(b: ref Vec[u8]) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for c in b {
        if c >= b'A' and c <= b'Z' {
            out.push(c + 32);
        } else {
            out.push(c);
        }
    }
    out
}

// b[:end], with Python's meaning for a negative end
fn head(b: ref Vec[u8], end: i64) -> Vec[u8] {
    if end < 0 {
        sub(b, 0, b.len() + end)
    } else {
        sub(b, 0, end)
    }
}

fn strip_other(name: ref String) -> String {
    if name.starts_with("other.") {
        name[6..name.len()].to_string()
    } else {
        name.clone()
    }
}

fn some_text(s: own String) -> Option[String] {
    if s.len() == 0 { None } else { Some(s) }
}

// _ID3._create_tag_image
fn create_tag_image(data: own Vec[u8], pic_type: i64, mime: own Option[String], desc: own Option[String]) -> Result[(String, Image), Fail] {
    let mut field = "other.unknown".to_string();
    if pic_type >= 0 and pic_type <= IMAGE_TYPE_LEN {
        if pic_type == IMAGE_TYPE_LEN {
            return Err(fail("IndexError", "tuple index out of range".to_string()));
        }
        field = image_type(pic_type);
    }
    let name = strip_other(field);
    let size = data.len();
    let m = match mime {
        Some(x) => some_text(x),
        None => None,
    };
    let d = match desc {
        Some(x) => some_text(x),
        None => None,
    };
    Ok((field, Image { name: name, size: size, data: data, mime_type: m, description: d }))
}

fn id3_header(fh: mut ref Fh) -> Result[(i64, bool, i64), Fail] {
    let header = fh.read(10);
    if header.len() == 10 and starts(header, "ID3") {
        let major = header[3] as i64;
        let extended = (header[5] & 0x40) > 0;
        let size = unsynchsafe(header, 6)?;
        return Ok((size, extended, major));
    }
    Ok((0, false, 0))
}

fn parse_id3(t: mut ref Tag, fh: mut ref Fh) -> Result[(), Fail] {
    let mut audio_offset = fh.tell();
    let mut tag_size = 0;
    if t.parse_tags {
        tag_size = parse_id3v2(mut t, mut fh)?;
    } else if t.parse_duration {
        let (size, _e, _m) = id3_header(mut fh)?;
        tag_size = size;
    }
    if tag_size > 0 {
        audio_offset += 10 + tag_size;
    }
    fh.seek(audio_offset);
    if t.only_id3 {
        return Ok(());
    }
    let header = fh.read(4);
    if t.filename().ends_with(".flac") or is_bytes(header, "fLaC") {
        t.set("mime_type", s_val("audio/flac"));
        fh.seek(audio_offset);
        let mut ft = sub_tag(K_FLAC, t);
        load(mut ft, mut fh, t.parse_tags, t.parse_duration, t.load_image)?;
        t.update(ft);
    } else {
        t.set("mime_type", s_val("audio/mpeg"));
        let mut end_padding = 0;
        if t.filesize() >= 128 {
            fh.seek(fh.buf.len() - 128);
            if parse_id3v1(mut t, mut fh)? {
                end_padding = 128;
            }
        }
        fh.seek(audio_offset);
        let mut mt = sub_tag(K_MPEG, t);
        mt.end_padding = end_padding;
        load(mut mt, mut fh, false, t.parse_duration, false)?;
        t.update(mt);
    }
    t.tags_parsed = t.parse_tags;
    t.duration_parsed = t.parse_duration;
    Ok(())
}

fn parse_id3v2(t: mut ref Tag, fh: mut ref Fh) -> Result[i64, Fail] {
    let (size, extended, major) = id3_header(mut fh)?;
    if size <= 0 {
        return Ok(size);
    }
    let mut parsed = 10;
    if extended {
        let e = fh.read(6);
        let ext = unsynchsafe(e, 0)?;
        parsed += ext;
        fh.skip(ext - 6);
    }
    while parsed < size {
        let n = parse_frame(mut t, mut fh, size, major)?;
        if n == -1 {
            break;
        }
        parsed += n;
    }
    set_grouping_work_fields(mut t);
    Ok(size)
}

fn v1_text(b: ref Vec[u8]) -> String {
    unpad(latin1(b))
}

fn parse_id3v1(t: mut ref Tag, fh: mut ref Fh) -> Result[bool, Fail] {
    let content = fh.read(if t.parse_tags { 128 } else { 3 });
    if not starts(content, "TAG") {
        return Ok(false);
    }
    if not t.parse_tags {
        return Ok(true);
    }
    if t.empty("title") {
        t.sf("title", Val.Str(v1_text(sub(content, 3, 33))));
    }
    if t.empty("artist") {
        t.sf("artist", Val.Str(v1_text(sub(content, 33, 63))));
    }
    if t.empty("album") {
        t.sf("album", Val.Str(v1_text(sub(content, 63, 93))));
    }
    if t.empty("year") {
        t.sf("year", Val.Str(v1_text(sub(content, 93, 97))));
    }
    let mut comment = sub(content, 97, 127);
    let n = comment.len();
    let last = at(comment, n - 1)?;
    let second = at(comment, n - 2)?;
    if second == 0 and last != 0 {
        if t.get("track").is_none() {
            t.sf("track", Val.Int(last));
        }
        comment = sub(comment, 0, n - 2);
    }
    if t.empty("comment") {
        t.sf("comment", Val.Str(v1_text(comment)));
    }
    if t.empty("genre") {
        let g = at(content, 127)?;
        if g < GENRE_NAME_LEN {
            t.sf("genre", Val.Str(genre_name(g)));
        }
    }
    Ok(true)
}

fn set_custom_field(t: mut ref Tag, name: ref String, value: ref String) {
    let lower = name.to_lowercase();
    let field = match id3_custom(lower) {
        Some(f) => f,
        None => f"other.{lower}",
    };
    t.set_field(field, Val.Str(value.clone()));
}

fn set_grouping_work_fields(t: mut ref Tag) {
    if t.modern_grouping.len() > 0 {
        for v in t.modern_grouping.clone() {
            t.set_other("grouping", v);
        }
        for v in t.legacy_grouping.clone() {
            t.set_other("work", v);
        }
        return;
    }
    for v in t.legacy_grouping.clone() {
        t.set_other("grouping", v);
    }
}

fn parse_id3_image(fid: ref String, content: ref Vec[u8]) -> Result[(String, Image), Fail] {
    let enc = at(content, 0)?;
    let mut mime: Option[String] = None;
    let mut desc_start = 5;
    if fid == "PIC" {
        mime = id3v22_image_format(latin1(ascii_lower(sub(content, 1, 4))));
    } else {
        let me = find_end(content, 0, 1);
        mime = Some(decode_string(sub(content, 1, me), -1).to_lowercase());
        desc_start = me + 1;
    }
    let pic_type = at(content, desc_start - 1)?;
    let mut de = find_end(content, enc, desc_start);
    if de + 1 < content.len() and content[de] == 0 and content[de + 1] != 0 {
        de += 1;
    }
    let desc = decode_string(sub(content, desc_start, de), enc);
    create_tag_image(tail(content, de), pic_type, mime, Some(desc))
}

fn lrc_timestamp(seconds: f64) -> String {
    let total = (seconds * 100.0) as i64;
    let minutes = total / 6000;
    let rest = total % 6000;
    let secs = rest / 100;
    let cs = rest % 100;
    f"{minutes:02}:{secs:02}.{cs:02}"
}

fn lstrip_nl(s: ref String) -> String {
    let b = s.bytes().to_vec();
    let mut i = 0;
    while i < b.len() and b[i] == 10 {
        i += 1;
    }
    text_of(tail(b, i))
}

fn parse_synced_lyrics(content: ref Vec[u8]) -> Result[String, Fail] {
    let mut lyrics = String.new();
    let n = content.len();
    let enc = at(content, 0)?;
    let ts_format = at(content, 4)?;
    let mut end_pos = find_end(content, enc, 6);
    let mut offset = end_pos;
    let mut found_line = false;
    while offset < n {
        end_pos = find_end(content, enc, offset);
        let value = lstrip_nl(decode_string(sub(content, offset, end_pos), enc));
        offset = end_pos;
        if offset + 4 > n {
            break;
        }
        let time = be32(content, offset);
        offset += 4;
        if found_line {
            lyrics.push_str("\n");
        }
        found_line = true;
        if ts_format == 2 {
            let stamp = lrc_timestamp(time as f64 / 1000.0);
            lyrics.push_str(f"[{stamp}]{value}");
        } else {
            lyrics.push_str(value);
        }
    }
    Ok(lyrics)
}

fn is_numbered(f: ref String) -> bool {
    f == "track" or f == "disc" or f == "other.movement"
}

// the values of a text frame, split at the encoding's terminator
fn set_text_frame(t: mut ref Tag, fieldname: ref String, content0: ref Vec[u8]) -> Result[(), Fail] {
    let enc = at(content0, 0)?;
    let content = tail(content0, 1);
    let n = content.len();
    let mut offset = 0;
    while offset < n {
        let mut end_pos = find_end(content, enc, offset);
        if end_pos <= offset {
            end_pos = n;
        }
        let mut value = decode_string(sub(content, offset, end_pos), enc);
        offset = end_pos;
        if is_numbered(fieldname) {
            if value.contains("/") {
                let (v, total, _found) = split_slash(value);
                if is_decimal(total) {
                    t.set_field(f"{fieldname}_total", Val.Int(to_int(total)));
                }
                value = v;
            }
            if is_decimal(value) {
                t.set_field(fieldname, Val.Int(to_int(value)));
            }
        } else if fieldname == "genre" {
            let mut genre_id = 255;
            if is_decimal(value) {
                genre_id = to_int(value);
            } else if value.starts_with("(") {
                let close = match value.find(")") {
                    Some(i) => i,
                    None => -1,
                };
                let inner = if close < 0 {
                    if value.len() >= 2 { value[1..value.len() - 1].to_string() } else { String.new() }
                } else {
                    value[1..close].to_string()
                };
                if close > 0 and is_decimal(inner) {
                    genre_id = to_int(inner);
                }
            }
            if genre_id >= 0 and genre_id < GENRE_NAME_LEN {
                value = genre_name(genre_id);
            }
            t.set_field(fieldname, Val.Str(value));
        } else if fieldname == "modern_grouping" {
            t.modern_grouping.push(value);
        } else if fieldname == "legacy_grouping" {
            t.legacy_grouping.push(value);
        } else {
            t.set_field(fieldname, Val.Str(value));
        }
    }
    Ok(())
}

fn all_zero(b: ref Vec[u8]) -> bool {
    for x in b {
        if x != 0 {
            return false;
        }
    }
    true
}

fn parse_frame(t: mut ref Tag, fh: mut ref Fh, total_size: i64, ver: i64) -> Result[i64, Fail] {
    let header_len = if ver == 2 { 6 } else { 10 };
    let mut parsed = header_len;
    let size_bytes = if ver == 2 { 3 } else { 4 };
    let header = fh.read(header_len);
    if header.len() != header_len {
        return Ok(-1);
    }
    let fid_b = sub(header, 0, size_bytes);
    if all_zero(fid_b) {
        return Ok(-1);
    }
    let frame_size = if size_bytes == 3 {
        uint(header, 3, 3, false)
    } else if ver == 4 {
        unsynchsafe(header, 4)?
    } else {
        be32(header, 4)
    };
    parsed += frame_size;
    if frame_size == 0 {
        return Ok(parsed);
    }
    if frame_size > total_size {
        return Ok(-1);
    }
    let fid = latin1(fid_b);
    let mapped = if t.parse_tags { id3_field(fid) } else { None };
    if let Some(fieldname) = mapped {
        let content0 = fh.read(frame_size);
        if fieldname == "comment" or fieldname == "other.lyrics" {
            let enc = at(content0, 0)?;
            let content = tail(content0, 4);
            let end_pos = find_end(content, enc, 0);
            let mut value = decode_string(sub(content, 0, end_pos), enc);
            if end_pos < content.len() {
                let descriptor = value.clone();
                value = decode_string(tail(content, end_pos), enc);
                if fieldname == "comment" and descriptor.len() > 0 and value.len() > 0 {
                    set_custom_field(mut t, descriptor, value);
                    return Ok(parsed);
                }
            }
            t.set_field(fieldname, Val.Str(value));
            return Ok(parsed);
        }
        if fid.starts_with("W") {
            t.set_field(fieldname, Val.Str(decode_string(content0, -1)));
            return Ok(parsed);
        }
        set_text_frame(mut t, fieldname, content0)?;
    } else if t.parse_tags and (fid == "SYLT" or fid == "SLT") {
        let content = fh.read(frame_size);
        let lyrics = parse_synced_lyrics(content)?;
        t.set_other("lyrics", lyrics);
    } else if t.parse_tags and (fid == "TXXX" or fid == "TXX") {
        let content = fh.read(frame_size);
        let enc = at(content, 0)?;
        let end_pos = find_end(content, enc, 1);
        let description = decode_string(sub(content, 1, end_pos), enc);
        let value = decode_string(tail(content, end_pos), enc);
        if description.len() > 0 and value.len() > 0 {
            set_custom_field(mut t, description, value);
        }
    } else if t.parse_tags and fid == "PRIV" {
        let content = fh.read(frame_size);
        let owner_end = find_end(content, 0, 0);
        let owner = head(content, owner_end - 1);
        if is_bytes(owner, "XMP") {
            let value = utf8_replace(unpad_bytes(tail(content, owner_end)));
            t.set_other("xmp", value);
        }
    } else if t.parse_tags and not id3_ignored(fid) {
        let content = fh.read(frame_size);
        let enc = at(content, 0)?;
        let value = if enc >= 0 and enc <= 3 {
            decode_string(tail(content, 1), enc)
        } else {
            decode_string(content, -1)
        };
        t.set_field(f"other.{fid.to_lowercase()}", Val.Str(value));
    } else if t.load_image and (fid == "APIC" or fid == "PIC") {
        let content = fh.read(frame_size);
        let (field, image) = parse_id3_image(fid, content)?;
        t.images.set_field(field, image);
    } else {
        fh.skip(frame_size);
    }
    Ok(parsed)
}

// ------------------------------------------------------------ _MPEG

fn parse_xing(c: ref Vec[u8], off0: i64) -> Result[(i64, i64), Fail] {
    let mut off = off0 + 4;
    need(c, off, 4)?;
    let flags = sint(c, off, 4, false);
    off += 4;
    let mut frames = 0;
    let mut byte_count = 0;
    if flags & 1 != 0 {
        need(c, off, 4)?;
        frames = sint(c, off, 4, false);
        off += 4;
    }
    if flags & 2 != 0 {
        need(c, off, 4)?;
        byte_count = sint(c, off, 4, false);
    }
    Ok((frames, byte_count))
}

fn parse_vbri(c: ref Vec[u8], off0: i64) -> Result[(i64, i64), Fail] {
    let off = off0 + 10;
    need(c, off, 4)?;
    let byte_count = be32(c, off);
    need(c, off + 4, 4)?;
    let frames = be32(c, off + 4);
    Ok((frames, byte_count))
}

fn parse_mpeg(t: mut ref Tag, fh: mut ref Fh) -> Result[(), Fail] {
    t.set("mime_type", s_val("audio/mpeg"));
    if not t.parse_duration {
        return Ok(());
    }
    t.set("is_lossless", Val.Bool(false));
    let mut samples_pf = 0;
    let mut max_estimation_frames = 0;
    let mut frame_size_accu = 0;
    let mut frames = 0;
    let mut bitrate_accu = 0;
    let mut last_bitrates: Vec[i64] = Vec.new();
    let mut first_id = -1;
    let mut audio_offset = fh.tell();
    loop {
        let header = fh.read(4);
        let header_len = header.len();
        if header_len < 4 {
            if frames > 0 {
                t.set("bitrate", Val.Float(bitrate_accu as f64 / frames as f64));
            }
            break;
        }
        let id_byte = header[1] as i64;
        let br_sr_byte = header[2] as i64;
        let br_id = (br_sr_byte >> 4) & 15;
        let sr_id = (br_sr_byte >> 2) & 3;
        let padding = (br_sr_byte >> 1) & 1;
        let mpeg_id = (id_byte >> 3) & 3;
        let layer_id = (id_byte >> 1) & 3;
        let version_id = (id_byte >> 1) & 15;
        let channel_mode = ((header[3] as i64) >> 6) & 3;
        if header[0] != 0xFF or (id_byte & 0xE0) != 0xE0 or (first_id >= 0 and first_id != version_id) or br_id > 14 or br_id == 0 or sr_id == 3 or layer_id == 0 or mpeg_id == 1 {
            let mut idx = -1;
            let mut k = 1;
            while k < header_len {
                if header[k] == 0xFF {
                    idx = k;
                    break;
                }
                k += 1;
            }
            let mut next_offset = header_len;
            if idx != -1 {
                next_offset = idx;
                fh.skip(idx - header_len);
            }
            if frames == 0 {
                audio_offset += next_offset;
            }
            continue;
        }
        t.set("channels", Val.Int(mpeg_channels(channel_mode)));
        let frame_br = mpeg_bitrate((mpeg_id * 4 + layer_id) * 16 + br_id);
        let samplerate = mpeg_sample_rate(mpeg_id * 3 + sr_id);
        t.set("samplerate", Val.Int(samplerate));
        samples_pf = mpeg_samples_per_frame(mpeg_id * 4 + layer_id);
        let slot_size = mpeg_slot_size(layer_id);
        let coefficient = (samples_pf / 8 / slot_size) * 1000;
        let frame_length = ((coefficient * frame_br) / samplerate + padding) * slot_size;
        if first_id < 0 {
            first_id = version_id;
            max_estimation_frames = (30 * samplerate) / samples_pf;
        }
        if frames == 0 {
            let mut xframes = 0;
            let mut byte_count = 0;
            let prev_offset = header_len + audio_offset;
            let frame_content = fh.read(if frame_length < 50 { frame_length } else { 50 });
            let mut xing = find_str(frame_content, "Xing", 0);
            if xing == -1 {
                xing = find_str(frame_content, "Info", 0);
            }
            if xing != -1 {
                let (f, b) = parse_xing(frame_content, xing)?;
                xframes = f;
                byte_count = b - frame_length;
            } else {
                let vbri = find_str(frame_content, "VBRI", 0);
                if vbri != -1 {
                    let (f, b) = parse_vbri(frame_content, vbri)?;
                    xframes = f;
                    byte_count = b;
                }
            }
            if xframes > 0 and byte_count > 0 {
                let dur = (xframes * samples_pf) as f64 / samplerate as f64;
                t.set("duration", Val.Float(dur));
                t.set("bitrate", Val.Float((byte_count * 8) as f64 / dur / 1000.0));
                t.duration_parsed = true;
                return Ok(());
            }
            fh.seek(prev_offset);
        }
        frames += 1;
        bitrate_accu += frame_br;
        if frames <= 5 and not last_bitrates.contains(frame_br) {
            last_bitrates.push(frame_br);
        }
        frame_size_accu += frame_length;
        let is_cbr = frames == 5 and last_bitrates.len() == 1;
        if frames == max_estimation_frames or is_cbr {
            let stream_size = t.filesize() - audio_offset - t.end_padding;
            let est = (stream_size as f64 / (frame_size_accu as f64 / frames as f64) + 0.5) as i64;
            let samples = est * samples_pf;
            t.set("duration", Val.Float(samples as f64 / samplerate as f64));
            t.set("bitrate", Val.Float(bitrate_accu as f64 / frames as f64));
            t.duration_parsed = true;
            return Ok(());
        }
        if frame_length > 1 {
            fh.skip(frame_length - header_len);
        }
    }
    let sr = t.int_of("samplerate");
    if sr != 0 {
        t.set("duration", Val.Float((frames * samples_pf) as f64 / sr as f64));
    }
    t.duration_parsed = true;
    Ok(())
}
// ------------------------------------------------------------ helpers

// struct.unpack('<I', fh.read(4)) and friends
fn read_le(fh: mut ref Fh, n: i64) -> Result[i64, Fail] {
    let b = fh.read(n);
    need_exact(b, n)?;
    Ok(uint(b, 0, n, true))
}

fn read_be(fh: mut ref Fh, n: i64) -> Result[i64, Fail] {
    let b = fh.read(n);
    need_exact(b, n)?;
    Ok(uint(b, 0, n, false))
}

// int / int, which Python divides as floats
fn fdiv(a: i64, b: i64) -> f64 {
    a as f64 / b as f64
}

// ------------------------------------------------------------ Vorbis comments

// A value _parse_vorbis_comment yields: a field value or a picture.
enum VItem {
    V(Val),
    Img(Image),
}

fn is_track_disc(f: ref String) -> bool {
    f == "track" or f == "disc" or f == "track_total" or f == "disc_total"
}

// _Ogg._parse_vorbis_comment
fn parse_vorbis_comment(fh: mut ref Fh, load_image: bool, read_data: bool) -> Result[Vec[(String, VItem)], Fail] {
    let mut out: Vec[(String, VItem)] = Vec.new();
    let vendor_length = read_le(mut fh, 4)?;
    fh.skip(vendor_length);
    let elements = read_le(mut fh, 4)?;
    let mut i = 0;
    while i < elements {
        i += 1;
        let length = read_le(mut fh, 4)?;
        if not read_data {
            fh.skip(length);
            continue;
        }
        let pair = utf8_replace(fh.read(length));
        let (key, value0) = match split_eq(pair) {
            Some(kv) => kv,
            None => continue,
        };
        let key_lower = key.to_lowercase();
        if key_lower == "metadata_block_picture" {
            if load_image {
                let mut pic = fh_of(b64_decode(value0));
                if let Some((field, image)) = parse_flac_image(mut pic, true)? {
                    out.push((field, VItem.Img(image)));
                }
            }
            continue;
        }
        let fieldname = match vorbis_field(key_lower) {
            Some(f) => f,
            None => f"other.{key_lower}",
        };
        if is_track_disc(fieldname) {
            let mut value = value0.clone();
            if (fieldname == "track" or fieldname == "disc") and value.contains("/") {
                let (v, total, _found) = split_slash(value);
                if is_decimal(total) {
                    out.push((f"{fieldname}_total", VItem.V(Val.Int(to_int(total)))));
                }
                value = v;
            }
            if is_decimal(value) {
                out.push((fieldname, VItem.V(Val.Int(to_int(value)))));
            }
        } else {
            out.push((fieldname, VItem.V(Val.Str(value0))));
        }
    }
    Ok(out)
}

fn set_vorbis_comment_fields(t: mut ref Tag, fh: mut ref Fh) -> Result[(), Fail] {
    for (field, item) in parse_vorbis_comment(mut fh, t.load_image, true)?.into_iter() {
        match item {
            VItem.Img(im) => t.images.set_field(field, im),
            VItem.V(v) => t.set_field(field, v),
        }
    }
    Ok(())
}

// ------------------------------------------------------------ _Ogg

// What _Ogg._parse keeps between packets.
struct OggState {
    check_flac: bool,
    check_speex: bool,
    preskip: i64,
}

fn walker_at(packet: ref Vec[u8], pos: i64) -> Fh {
    let mut w = fh_of(packet.clone());
    w.seek(pos);
    w
}

// One packet of _Ogg._parse's loop; true when the loop breaks.
fn ogg_packet(t: mut ref Tag, packet: ref Vec[u8], serial: i64, st: mut ref OggState) -> Result[bool, Fail] {
    if starts(packet, "\u{1}vorbis") {
        if t.parse_duration {
            need(packet, 11, 5)?;
            let channels = packet[11] as i64;
            let samplerate = sint(packet, 12, 4, true);
            need(packet, 20, 4)?;
            let bitrate = sint(packet, 20, 4, true);
            if channels > 0 {
                t.set("channels", Val.Int(channels));
            }
            if samplerate > 0 {
                t.set("samplerate", Val.Int(samplerate));
            }
            if bitrate > 0 {
                t.set("bitrate", Val.Float(fdiv(bitrate, 1000)));
            }
            t.set("mime_type", s_val("audio/ogg; codecs=\"vorbis\""));
            t.set("is_lossless", Val.Bool(false));
            t.granule_pos_serial = Some(serial);
            t.duration_parsed = true;
        }
    } else if starts(packet, "\u{3}vorbis") {
        if t.parse_tags {
            let mut w = walker_at(packet, 7);
            set_vorbis_comment_fields(mut t, mut w)?;
            t.tags_parsed = true;
        }
    } else if starts(packet, "OpusHead") {
        if t.parse_duration {
            need(packet, 8, 4)?;
            let version = packet[8] as i64;
            let channels = packet[9] as i64;
            st.preskip = le16(packet, 10);
            if (version & 0xF0) == 0 {
                if channels > 0 {
                    t.set("channels", Val.Int(channels));
                }
                t.set("samplerate", Val.Int(48000));
            }
            t.set("mime_type", s_val("audio/ogg; codecs=\"opus\""));
            t.set("is_lossless", Val.Bool(false));
            t.duration_parsed = true;
            t.granule_pos_serial = Some(serial);
        }
    } else if starts(packet, "OpusTags") {
        if t.parse_tags {
            let mut w = walker_at(packet, 8);
            set_vorbis_comment_fields(mut t, mut w)?;
            t.tags_parsed = true;
        }
        t.audio_size_serial = Some(serial);
    } else if starts(packet, "\u{7f}FLAC") {
        let mut w = walker_at(packet, 9);
        let mut ft = sub_tag(K_FLAC, t);
        load(mut ft, mut w, false, t.parse_duration, t.load_image)?;
        t.update(ft);
        if t.parse_duration {
            t.set("mime_type", s_val("audio/ogg; codecs=\"flac\""));
            t.set("is_lossless", Val.Bool(true));
        }
        t.duration_parsed = t.parse_duration;
        st.check_flac = true;
    } else if st.check_flac {
        if t.parse_tags {
            let mut w = walker_at(packet, 0);
            let meta_header = w.read(4);
            let block_type = at(meta_header, 0)? & 0x7f;
            if block_type == 4 {
                set_vorbis_comment_fields(mut t, mut w)?;
            }
            t.tags_parsed = true;
        }
        st.check_flac = false;
    } else if starts(packet, "Speex   ") {
        if t.parse_duration {
            need(packet, 36, 4)?;
            let samplerate = sint(packet, 36, 4, true);
            need(packet, 48, 8)?;
            let channels = sint(packet, 48, 4, true);
            let bitrate = sint(packet, 52, 4, true);
            if samplerate > 0 {
                t.set("samplerate", Val.Int(samplerate));
            }
            if channels > 0 {
                t.set("channels", Val.Int(channels));
            }
            if bitrate > 0 {
                t.set("bitrate", Val.Float(fdiv(bitrate, 1000)));
            }
            t.set("mime_type", s_val("audio/ogg; codecs=\"speex\""));
            t.set("is_lossless", Val.Bool(false));
            t.granule_pos_serial = Some(serial);
            t.duration_parsed = true;
        }
        st.check_speex = true;
    } else if st.check_speex {
        if t.parse_tags {
            let mut w = walker_at(packet, 0);
            set_vorbis_comment_fields(mut t, mut w)?;
            t.tags_parsed = true;
        }
        st.check_speex = false;
    }
    Ok(t.tags_parsed and not t.parse_duration)
}

fn same_serial(a: Option[i64], serial: i64) -> bool {
    match a {
        Some(x) => x == serial,
        None => false,
    }
}

// _Ogg._parse, with _parse_pages run in line: the generator's state and
// the packet loop's share the tag, so each packet is handled as the
// generator yields it.
fn parse_ogg(t: mut ref Tag, fh: mut ref Fh) -> Result[(), Fail] {
    let mut st = OggState { check_flac: false, check_speex: false, preskip: 0 };
    let mut serials: Vec[i64] = Vec.new();
    let mut packets: Vec[Vec[u8]] = Vec.new();
    let mut last_granule_pos = 0;
    let mut last_audio_size = 0;
    let mut page_header = fh.read(27);
    if not starts(page_header, "OggS") or not (page_header.len() > 4 and page_header[4] == 0) {
        return Err(parse_error("Invalid OGG header"));
    }
    t.set("mime_type", s_val("audio/ogg"));
    let mut stop = false;
    while page_header.len() == 27 {
        let version = page_header[4];
        if not starts(page_header, "OggS") or version != 0 {
            break;
        }
        let eos = page_header[5] & 0x04;
        let granule_pos = sint(page_header, 6, 8, true);
        let serial = uint(page_header, 14, 4, true);
        let mut slot = -1;
        let mut k = 0;
        while k < serials.len() {
            if serials[k] == serial {
                slot = k;
            }
            k += 1;
        }
        if slot < 0 {
            serials.push(serial);
            packets.push(Vec.new());
            slot = serials.len() - 1;
        }
        let size_match = same_serial(t.audio_size_serial, serial);
        if same_serial(t.granule_pos_serial, serial) {
            if eos != 0 {
                t.granule_pos = granule_pos;
            } else {
                t.granule_pos = last_granule_pos;
                last_granule_pos = granule_pos;
            }
        }
        let segments = page_header[26] as i64;
        let seg_sizes = fh.read(segments);
        let mut read_size = 0;
        let mut audio_size = 0;
        for seg in seg_sizes {
            let s = seg as i64;
            read_size += s;
            if size_match {
                audio_size += s;
            }
            if s < 255 and not t.tags_parsed {
                let more = fh.read(read_size);
                push_all(mut packets[slot], more);
                let packet = packets[slot].clone();
                if ogg_packet(mut t, packet, serial, mut st)? {
                    stop = true;
                    break;
                }
                packets[slot] = Vec.new();
                read_size = 0;
            }
        }
        if stop {
            break;
        }
        if read_size > 0 {
            if t.tags_parsed and t.duration_parsed {
                fh.skip(read_size);
            } else {
                let more = fh.read(read_size);
                push_all(mut packets[slot], more);
            }
        }
        if size_match {
            if eos != 0 {
                t.audio_size += last_audio_size + audio_size;
            } else {
                t.audio_size += last_audio_size;
                last_audio_size = audio_size;
            }
        }
        page_header = fh.read(27);
    }
    let sr = t.int_of("samplerate");
    if t.get("duration").is_some() or sr == 0 {
        return Ok(());
    }
    let d = fdiv(t.granule_pos - st.preskip, sr);
    if d < 0.0 {
        t.set("duration", Val.Int(0));
    } else {
        t.set("duration", Val.Float(d));
    }
    let dur = t.float_of("duration");
    if t.audio_size != 0 and dur != 0.0 {
        t.set("bitrate", Val.Float((t.audio_size * 8) as f64 / dur / 1000.0));
    }
    Ok(())
}

// ------------------------------------------------------------ _Flac

fn parse_flac(t: mut ref Tag, fh: mut ref Fh) -> Result[(), Fail] {
    let header = fh.read(4);
    if not starts(header, "fLaC") {
        return Err(parse_error("Invalid FLAC header"));
    }
    t.set("mime_type", s_val("audio/flac"));
    let mut found_streaminfo = false;
    let mut block_header = fh.read(4);
    while block_header.len() == 4 {
        let block_type = (block_header[0] & 0x7f) as i64;
        let is_last = (block_header[0] & 0x80) != 0;
        let is_streaminfo = block_type == 0;
        let size = uint(block_header, 1, 3, false);
        if t.parse_duration and is_streaminfo and not found_streaminfo {
            let h = fh.read(size);
            need(h, 10, 8)?;
            let info = uint(h, 10, 8, false);
            let samplerate = (info >> 44) & ((1 << 20) - 1);
            let channels = ((info >> 41) & 7) + 1;
            let bitdepth = ((info >> 36) & 31) + 1;
            let total_samples = info & ((1 << 36) - 1);
            if samplerate > 0 {
                t.set("samplerate", Val.Int(samplerate));
                let duration = fdiv(total_samples, samplerate);
                t.set("duration", Val.Float(duration));
                if duration > 0.0 {
                    t.set("bitrate", Val.Float((t.filesize() * 8) as f64 / duration / 1000.0));
                }
            }
            t.set("channels", Val.Int(channels));
            t.set("bitdepth", Val.Int(bitdepth));
            t.set("is_lossless", Val.Bool(true));
        } else if block_type == 4 {
            for (field, item) in parse_vorbis_comment(mut fh, false, t.parse_tags)?.into_iter() {
                if let VItem.V(v) = item {
                    t.set_field(field, v);
                }
            }
        } else if block_type == 6 {
            if let Some((field, image)) = parse_flac_image(mut fh, t.load_image)? {
                t.images.set_field(field, image);
            }
        } else {
            fh.skip(size);
        }
        if is_streaminfo and not found_streaminfo {
            found_streaminfo = true;
        }
        if is_last {
            break;
        }
        block_header = fh.read(4);
    }
    let duration = t.float_of("duration");
    if duration != 0.0 {
        let audio_offset = fh.tell();
        let bitrate = ((t.filesize() - audio_offset) * 8) as f64 / duration / 1000.0;
        if bitrate > 0.0 {
            t.set("bitrate", Val.Float(bitrate));
        }
    }
    t.duration_parsed = t.parse_duration;
    t.tags_parsed = t.parse_tags;
    Ok(())
}

// _Flac._parse_image
fn parse_flac_image(fh: mut ref Fh, read_data: bool) -> Result[Option[(String, Image)], Fail] {
    let mut mime: Option[String] = None;
    let pic_type = read_be(mut fh, 4)?;
    let mime_len = read_be(mut fh, 4)?;
    if read_data {
        mime = Some(utf8_replace(fh.read(mime_len)));
    } else {
        fh.skip(mime_len);
    }
    let mut desc: Option[String] = None;
    let desc_len = read_be(mut fh, 4)?;
    if read_data {
        desc = Some(utf8_replace(fh.read(desc_len)));
    } else {
        fh.skip(desc_len);
    }
    fh.skip(16);
    let pic_len = read_be(mut fh, 4)?;
    if not read_data {
        fh.skip(pic_len);
        return Ok(None);
    }
    let data = fh.read(pic_len);
    Ok(Some(create_tag_image(data, pic_type, mime, desc)?))
}

// ------------------------------------------------------------ _Wave

// an embedded ID3 tag, as _Wave and _Aiff read one
fn embedded_id3(t: mut ref Tag, body: own Vec[u8]) -> Result[(), Fail] {
    let mut id3 = sub_tag(K_ID3, t);
    let mut w = fh_of(body);
    id3.only_id3 = true;
    load(mut id3, mut w, true, false, t.load_image)?;
    t.update(id3);
    Ok(())
}

fn parse_wave(t: mut ref Tag, fh: mut ref Fh) -> Result[(), Fail] {
    let header = fh.read(12);
    if not starts(header, "RIFF") or not starts_at(header, "WAVE", 8) {
        return Err(parse_error("Invalid WAV header"));
    }
    t.set("mime_type", s_val("audio/wav"));
    let mut block_align = 0;
    let mut audio_size = 0;
    let mut num_samples = 0;
    let mut chunk_header = fh.read(8);
    while chunk_header.len() == 8 {
        let unpadded = le32(chunk_header, 4);
        let size = unpadded + unpadded % 2;
        if t.parse_duration and starts(chunk_header, "fmt ") {
            let chunk = fh.read(size);
            need(chunk, 0, 8)?;
            let mut format_tag = le16(chunk, 0);
            let channels = le16(chunk, 2);
            let samplerate = le32(chunk, 4);
            need(chunk, 12, 4)?;
            block_align = le16(chunk, 12);
            let bitdepth = le16(chunk, 14);
            if format_tag == 0xFFFE {
                need(chunk, 24, 2)?;
                format_tag = le16(chunk, 24);
            }
            if channels > 0 {
                t.set("channels", Val.Int(channels));
            }
            if samplerate > 0 {
                t.set("samplerate", Val.Int(samplerate));
            }
            if bitdepth > 0 {
                t.set("bitdepth", Val.Int(bitdepth));
            }
            if format_tag != 0 {
                t.set("mime_type", Val.Str(f"audio/wav; codecs=\"{hex_upper(format_tag)}\""));
                t.set("is_lossless", Val.Bool(wav_lossless(format_tag)));
            }
        } else if t.parse_duration and starts(chunk_header, "data") {
            audio_size = unpadded;
            fh.skip(size);
        } else if t.parse_duration and starts(chunk_header, "fact") {
            let chunk = fh.read(size);
            need(chunk, 0, 4)?;
            num_samples = le32(chunk, 0);
        } else if t.parse_tags and starts(chunk_header, "LIST") {
            let chunk = fh.read(size);
            if starts(chunk, "INFO") {
                let mut w = walker_at(chunk, 4);
                let mut field = w.read(4);
                while field.len() == 4 {
                    let mut data_length = read_le(mut w, 4)?;
                    data_length += data_length % 2;
                    let data = unpad_bytes(w.read(data_length));
                    let id = latin1(field);
                    let fieldname = match riff_field(id) {
                        Some(f) => f,
                        None => f"other.{id}".to_lowercase(),
                    };
                    let value = utf8_replace(data);
                    if fieldname == "track" {
                        if is_decimal(value) {
                            t.set_field(fieldname, Val.Int(to_int(value)));
                        }
                    } else {
                        t.set_field(fieldname, Val.Str(value));
                    }
                    field = w.read(4);
                }
            }
        } else if t.parse_tags and (starts(chunk_header, "id3 ") or starts(chunk_header, "ID3 ")) {
            let body = fh.read(size);
            embedded_id3(mut t, body)?;
        } else if t.parse_tags and starts(chunk_header, "_PMX") {
            let chunk = unpad_bytes(fh.read(size));
            t.set_other("xmp", utf8_replace(chunk));
        } else {
            fh.skip(size);
        }
        chunk_header = fh.read(8);
    }
    let samplerate = t.int_of("samplerate");
    let lossless = match t.get("is_lossless") {
        Some(Val.Bool(b)) => b,
        _ => false,
    };
    if not lossless and samplerate != 0 {
        if audio_size == 0 {
            num_samples = 0;
        }
        let duration = fdiv(num_samples, samplerate);
        t.set("duration", Val.Float(duration));
        if duration != 0.0 {
            t.set("bitrate", Val.Float((audio_size * 8) as f64 / duration / 1000.0));
        }
    } else if block_align != 0 and samplerate != 0 {
        t.set("duration", Val.Float(fdiv(audio_size, block_align * samplerate)));
        t.set("bitrate", Val.Float(fdiv(block_align * samplerate * 8, 1000)));
    }
    t.duration_parsed = t.parse_duration;
    t.tags_parsed = t.parse_tags;
    Ok(())
}

// ------------------------------------------------------------ _ASF

fn asf_guid(name: Str) -> Vec[u8] {
    if name == "header" {
        unhex("3026b2758e66cf11a6d900aa0062ce6c".to_string())
    } else if name == "content" {
        unhex("3326b2758e66cf11a6d900aa0062ce6c".to_string())
    } else if name == "ext_content" {
        unhex("40a4d0d207e3d21197f000a0c95ea850".to_string())
    } else if name == "file_prop" {
        unhex("a1dcab8c47a9cf118ee400c00c205365".to_string())
    } else if name == "stream_props" {
        unhex("9107dcb7b7a9cf118ee600c00c205365".to_string())
    } else if name == "audio_media" {
        unhex("409e69f84d5bcf11a8fd00805f5c442b".to_string())
    } else if name == "header_ext" {
        unhex("b503bf5f2ea9cf118ee300c00c205365".to_string())
    } else if name == "metadata" {
        unhex("eacbf8c5af5b77488467aa8c44fa4cca".to_string())
    } else if name == "metadata_library" {
        unhex("941c23449894d149a1411d134e457054".to_string())
    } else {
        unhex("cbcf7abea997e8429c71999491e3afac".to_string())
    }
}

fn utf16le_text(b: ref Vec[u8]) -> String {
    unpad(utf16_replace(b, false))
}

// _ASF._parse_value
fn asf_value(t: mut ref Tag, fh: mut ref Fh, name0: ref String, value_type: i64, value_len: i64) -> Result[(), Fail] {
    let value = if value_type == 0 {
        utf16le_text(fh.read(value_len))
    } else if value_type > 1 and value_type < 6 and (value_len == 1 or value_len == 2 or value_len == 4 or value_len == 8) {
        let b = fh.read(value_len);
        need_exact(b, value_len)?;
        let n = uint(b, 0, value_len, true);
        if n < 0 {
            f"{n as u64}"
        } else {
            f"{n}"
        }
    } else {
        fh.skip(value_len);
        return Ok(());
    };
    let field = match asf_field(name0) {
        Some(f) => f,
        None => {
            let name = if name0.starts_with("WM/") { name0[3..name0.len()].to_string() } else { name0.clone() };
            f"other.{name.to_lowercase()}"
        }
    };
    if field == "track" or field == "disc" {
        if is_decimal(value) {
            t.set_field(field, Val.Int(to_int(value)));
        }
    } else {
        t.set_field(field, Val.Str(value));
    }
    Ok(())
}

fn parse_asf(t: mut ref Tag, fh: mut ref Fh) -> Result[(), Fail] {
    let header = fh.read(30);
    if not starts_bytes(header, asf_guid("header")) or not (header.len() > 29 and header[29] == 2) {
        return Err(parse_error("Invalid WMA header"));
    }
    t.set("mime_type", s_val("application/vnd.ms-asf"));
    let header_len = 24;
    let mut object_header = fh.read(header_len);
    while object_header.len() == header_len {
        let mut object_size = uint(object_header, 16, 8, true);
        if object_size < header_len {
            break;
        }
        object_size -= header_len;
        if t.parse_tags and starts_bytes(object_header, asf_guid("content")) {
            let mut w = fh_of(fh.read(object_size));
            let lens = w.read(10);
            need_exact(lens, 10)?;
            let names = ["title", "artist", "other.copyright", "comment", "_rating"];
            let mut i = 0;
            while i < 5 {
                let value = utf16le_text(w.read(le16(lens, 2 * i)));
                let name = names[i].to_string();
                if not name.starts_with("_") and value.len() > 0 {
                    t.set_field(name, Val.Str(value));
                }
                i += 1;
            }
        } else if t.parse_tags and starts_bytes(object_header, asf_guid("ext_content")) {
            let mut w = fh_of(fh.read(object_size));
            let count = read_le(mut w, 2)?;
            let mut i = 0;
            while i < count {
                let name_len = read_le(mut w, 2)?;
                let name = utf16le_text(w.read(name_len));
                let tl = w.read(4);
                need_exact(tl, 4)?;
                asf_value(mut t, mut w, name, le16(tl, 0), le16(tl, 2))?;
                i += 1;
            }
        } else if t.parse_tags and starts_bytes(object_header, asf_guid("header_ext")) {
            let mut offset = fh.skip(18);
            let data_size = read_le(mut fh, 4)?;
            offset += 4;
            let end_offset = offset + data_size;
            while offset < end_offset {
                let subheader = fh.read(header_len);
                offset += subheader.len();
                need(subheader, 16, 8)?;
                let mut sub_size = uint(subheader, 16, 8, true) - header_len;
                if sub_size < 0 {
                    sub_size = 0;
                }
                if starts_bytes(subheader, asf_guid("metadata")) or starts_bytes(subheader, asf_guid("metadata_library")) {
                    let content = fh.read(sub_size);
                    offset += content.len();
                    let mut w = fh_of(content);
                    let count = read_le(mut w, 2)?;
                    let mut i = 0;
                    while i < count {
                        w.skip(4);
                        let name_len = read_le(mut w, 2)?;
                        let value_type = read_le(mut w, 2)?;
                        let value_len = read_le(mut w, 4)?;
                        let name = utf16le_text(w.read(name_len));
                        asf_value(mut t, mut w, name, value_type, value_len)?;
                        i += 1;
                    }
                } else {
                    offset = fh.skip(sub_size);
                }
            }
        } else if t.parse_duration and starts_bytes(object_header, asf_guid("file_prop")) {
            let data = fh.read(object_size);
            need(data, 40, 8)?;
            let play = fdiv(uint(data, 40, 8, true), 10000000);
            need(data, 56, 8)?;
            let preroll = fdiv(uint(data, 56, 8, true), 1000);
            let d = play - preroll;
            t.set("duration", Val.Float(if d < 0.0 { 0.0 } else { d }));
        } else if t.parse_duration and starts_bytes(object_header, asf_guid("stream_props")) {
            let data = fh.read(object_size);
            if same_bytes(sub(data, 0, 16), asf_guid("audio_media")) {
                need(data, 54, 12)?;
                let format_tag = le16(data, 54);
                let channels = le16(data, 56);
                let samplerate = le32(data, 58);
                let avg_bytes = le32(data, 62);
                if channels > 0 {
                    t.set("channels", Val.Int(channels));
                }
                if samplerate > 0 {
                    t.set("samplerate", Val.Int(samplerate));
                }
                if avg_bytes > 0 {
                    t.set("bitrate", Val.Float(fdiv(avg_bytes * 8, 1000)));
                }
                if format_tag != 0 {
                    t.set("mime_type", Val.Str(f"application/vnd.ms-asf; codecs=\"{hex_upper(format_tag)}\""));
                    t.set("is_lossless", Val.Bool(wav_lossless(format_tag)));
                }
                need(data, 68, 2)?;
                let bitdepth = le16(data, 68);
                if bitdepth > 0 {
                    t.set("bitdepth", Val.Int(bitdepth));
                }
            }
        } else if t.parse_tags and starts_bytes(object_header, asf_guid("xmp")) {
            let value = utf8_replace(fh.read(object_size));
            t.set_other("xmp", value);
        } else {
            fh.skip(object_size);
        }
        object_header = fh.read(header_len);
    }
    t.duration_parsed = t.parse_duration;
    t.tags_parsed = t.parse_tags;
    Ok(())
}

// ------------------------------------------------------------ _Aiff

// 2 ** e as a float, for e <= 0
fn pow2_neg(e: i64) -> f64 {
    let mut x = 1.0;
    let mut i = 0;
    while i < -e {
        x = x * 0.5;
        if x == 0.0 {
            break;
        }
        i += 1;
    }
    x
}

// an unsigned 64-bit integer as the nearest float
fn u64_float(v: i64) -> f64 {
    let hi = (v >> 32) & 0xFFFFFFFF;
    let lo = v & 0xFFFFFFFF;
    hi as f64 * 4294967296.0 + lo as f64
}

fn parse_aiff(t: mut ref Tag, fh: mut ref Fh) -> Result[(), Fail] {
    let header = fh.read(12);
    if not starts(header, "FORM") or not (starts_at(header, "AIFC", 8) or starts_at(header, "AIFF", 8)) {
        return Err(parse_error("Invalid AIFF header"));
    }
    t.set("mime_type", s_val("audio/aiff"));
    let mut chunk_header = fh.read(8);
    while chunk_header.len() == 8 {
        let id = latin1(sub(chunk_header, 0, 4));
        let unpadded = be32(chunk_header, 4);
        let size = unpadded + unpadded % 2;
        let mapped = if t.parse_tags { aiff_field(id) } else { None };
        if let Some(field) = mapped {
            let chunk = unpad_bytes(fh.read(size));
            for part in split_nul(chunk) {
                t.set_field(field, Val.Str(utf8_replace(part)));
            }
        } else if t.parse_duration and starts(chunk_header, "COMM") {
            let chunk = fh.read(size);
            need(chunk, 0, 8)?;
            let channels = sint(chunk, 0, 2, false);
            let num_frames = be32(chunk, 2);
            let bitdepth = sint(chunk, 6, 2, false);
            if channels > 0 {
                t.set("channels", Val.Int(channels));
            }
            if bitdepth > 0 {
                t.set("bitdepth", Val.Int(bitdepth));
            }
            need(chunk, 8, 10)?;
            let exp = be16(chunk, 8);
            let mantissa = uint(chunk, 10, 8, false);
            let k = exp - 0x3FFF - 63;
            let sr = if k >= 0 {
                mantissa << k
            } else {
                (u64_float(mantissa) * pow2_neg(k)) as i64
            };
            if sr > 0 {
                let duration = fdiv(num_frames, sr);
                let bitrate = fdiv(sr * channels * bitdepth, 1000);
                if bitrate > 0.0 {
                    t.set("bitrate", Val.Float(bitrate));
                }
                t.set("samplerate", Val.Int(sr));
                t.set("duration", Val.Float(duration));
            }
            let mut compression = latin1(sub(chunk, 18, 22));
            if compression.len() == 0 {
                compression = "NONE".to_string();
            }
            t.set("mime_type", Val.Str(f"audio/aiff; codecs=\"{compression}\""));
            t.set("is_lossless", Val.Bool(aiff_uncompressed(compression)));
            t.duration_parsed = true;
            if not t.parse_tags {
                break;
            }
        } else if t.parse_tags and (starts(chunk_header, "id3 ") or starts(chunk_header, "ID3 ")) {
            let body = fh.read(size);
            embedded_id3(mut t, body)?;
        } else if t.parse_tags and starts(chunk_header, "APPL") {
            let chunk = fh.read(size);
            if starts(chunk, "XMP ") {
                t.set_other("xmp", utf8_replace(unpad_bytes(tail(chunk, 4))));
            }
        } else {
            fh.skip(size);
        }
        chunk_header = fh.read(8);
    }
    t.tags_parsed = t.parse_tags;
    Ok(())
}
// ------------------------------------------------------------ _MP4

// A value an atom parser yields: a field value, an image, or a list.
enum Mv {
    V(Val),
    Img(Image),
    L(Vec[String]),
}

// A dict of _MP4's parser tree. The trees are fixed except the one
// _traverse_atoms makes for an unknown atom under ilst, which maps that
// atom to {b'data': _data_parser(field)}.
#[derive(Clone)]
struct Tree {
    kind: i64,
    item: i64,
    f1: String,
    f2: String,
    atom: String,
}

const T_EMPTY: i64 = 0;
const T_ROOT_AUDIO: i64 = 1;
const T_ROOT_META: i64 = 2;
const T_ROOT_BOTH: i64 = 3;
const T_MOOV_AUDIO: i64 = 4;
const T_MOOV_META: i64 = 5;
const T_MOOV_BOTH: i64 = 6;
const T_TRAK: i64 = 7;
const T_MDIA: i64 = 8;
const T_MINF: i64 = 9;
const T_STBL: i64 = 10;
const T_STSD: i64 = 11;
const T_UDTA: i64 = 12;
const T_META: i64 = 13;
const T_ILST: i64 = 14;
const T_ITEM: i64 = 15;
const T_UNKNOWN: i64 = 16;

// the leaves: the parsers
const L_DATA: i64 = 0;
const L_NUMS: i64 = 1;
const L_GENRE: i64 = 2;
const L_COVER: i64 = 3;
const L_CUSTOM: i64 = 4;
const L_UUID: i64 = 5;
const L_MVHD: i64 = 6;
const L_MP4A: i64 = 7;
const L_ALAC: i64 = 8;

fn tree(kind: i64) -> Tree {
    Tree { kind: kind, item: 0, f1: String.new(), f2: String.new(), atom: String.new() }
}

// path.get(atom_type)
enum Ent {
    Sub(Tree),
    Leaf(i64, String, String),
    Missing,
}

fn leaf(k: i64) -> Ent {
    Ent.Leaf(k, String.new(), String.new())
}

fn child(tr: ref Tree, a: ref String) -> Ent {
    let k = tr.kind;
    if k == T_ROOT_AUDIO or k == T_ROOT_META or k == T_ROOT_BOTH {
        if a == "moov" {
            return Ent.Sub(tree(k + 3));
        }
        if a == "uuid" and k != T_ROOT_AUDIO {
            return leaf(L_UUID);
        }
    } else if k == T_MOOV_AUDIO or k == T_MOOV_BOTH {
        if a == "mvhd" {
            return leaf(L_MVHD);
        }
        if a == "trak" {
            return Ent.Sub(tree(T_TRAK));
        }
        if a == "udta" and k == T_MOOV_BOTH {
            return Ent.Sub(tree(T_UDTA));
        }
    } else if k == T_MOOV_META {
        if a == "udta" {
            return Ent.Sub(tree(T_UDTA));
        }
    } else if k == T_TRAK {
        if a == "mdia" {
            return Ent.Sub(tree(T_MDIA));
        }
    } else if k == T_MDIA {
        if a == "minf" {
            return Ent.Sub(tree(T_MINF));
        }
    } else if k == T_MINF {
        if a == "stbl" {
            return Ent.Sub(tree(T_STBL));
        }
    } else if k == T_STBL {
        if a == "stsd" {
            return Ent.Sub(tree(T_STSD));
        }
    } else if k == T_STSD {
        if a == "mp4a" {
            return leaf(L_MP4A);
        }
        if a == "alac" {
            return leaf(L_ALAC);
        }
    } else if k == T_UDTA {
        if a == "meta" {
            return Ent.Sub(tree(T_META));
        }
    } else if k == T_META {
        if a == "ilst" {
            return Ent.Sub(tree(T_ILST));
        }
    } else if k == T_ILST {
        if let Some((item, f1, f2)) = ilst_entry(a) {
            if item == 4 {
                return leaf(L_CUSTOM);
            }
            return Ent.Sub(Tree { kind: T_ITEM, item: item, f1: f1, f2: f2, atom: String.new() });
        }
    } else if k == T_ITEM {
        if a == "data" {
            return Ent.Leaf(tr.item, tr.f1.clone(), tr.f2.clone());
        }
    } else if k == T_UNKNOWN {
        if a == tr.atom {
            return Ent.Sub(Tree { kind: T_ITEM, item: L_DATA, f1: tr.f1.clone(), f2: String.new(), atom: String.new() });
        }
    }
    Ent.Missing
}

// _MP4._read_atom_header: (type, header size, size), where a missing
// type or size is None.
fn read_atom_header(fh: mut ref Fh) -> (Option[Vec[u8]], i64, Option[i64]) {
    let h = fh.read(8);
    let mut header_size = h.len();
    if header_size < 8 {
        return (None, header_size, None);
    }
    let mut size = be32(h, 0);
    let typ = sub(h, 4, 8);
    if size == 1 {
        let ext = fh.read(8);
        header_size += ext.len();
        if header_size == 16 {
            size = uint(ext, 0, 8, false);
        }
    }
    if size < header_size {
        (Some(typ), header_size, None)
    } else {
        (Some(typ), header_size, Some(size - header_size))
    }
}

fn is_ascii(b: ref Vec[u8]) -> bool {
    for c in b {
        if c >= 0x80 {
            return false;
        }
    }
    true
}

fn path_is(path: ref Vec[String], want: ref Vec[String]) -> bool {
    if path.len() != want.len() {
        return false;
    }
    let mut i = 0;
    while i < path.len() {
        if path[i] != want[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn ilst_path() -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    for a in ["ftyp", "moov", "udta", "meta", "ilst"] {
        v.push(a.to_string());
    }
    v
}

fn covr_path() -> Vec[String] {
    let mut v = ilst_path();
    v.push("covr".to_string());
    v
}

fn parse_mp4(t: mut ref Tag, fh: mut ref Fh) -> Result[(), Fail] {
    let kind = if t.parse_duration and t.parse_tags {
        T_ROOT_BOTH
    } else if t.parse_duration {
        T_ROOT_AUDIO
    } else if t.parse_tags {
        T_ROOT_META
    } else {
        T_EMPTY
    };
    traverse_atoms(mut t, mut fh, tree(kind), None, None, None)?;
    t.duration_parsed = t.parse_duration;
    t.tags_parsed = t.parse_tags;
    Ok(())
}

fn traverse_atoms(t: mut ref Tag, fh: mut ref Fh, tr: ref Tree, start: Option[i64], stop: Option[i64], path0: own Option[Vec[String]]) -> Result[i64, Fail] {
    let mut pos = match start {
        Some(p) => p,
        None => fh.tell(),
    };
    let mut (typ, header_size, size) = read_atom_header(mut fh);
    let mut path: Vec[String] = Vec.new();
    let mut have_path = false;
    match path0 {
        Some(p) => {
            path = p;
            have_path = true;
        }
        None => {
            let ok = match typ.clone() {
                Some(b) => is_ascii(b),
                None => false,
            };
            if not ok {
                return Err(parse_error("Invalid MP4 header"));
            }
            t.set("mime_type", s_val("audio/mp4"));
        }
    }
    let stop_pos = match stop {
        Some(s) => s,
        None => 0,
    };
    loop {
        let ty = match typ.clone() {
            Some(b) => b,
            None => break,
        };
        let mut sz = match size {
            Some(s) => s,
            None => break,
        };
        pos += header_size;
        let name = latin1(ty);
        if not have_path {
            path.push(name.clone());
            have_path = true;
        }
        if sz >= 4 {
            if name == "meta" or name == "stsd" {
                pos = fh.skip(4);
                sz -= 4;
            }
            if name == "stsd" {
                pos = fh.skip(4);
                sz -= 4;
            }
        }
        match child(tr, name) {
            Ent.Leaf(k, f1, f2) => {
                if not t.load_image and path_is(path, covr_path()) {
                    pos = fh.skip(sz);
                } else {
                    let data = fh.read(sz);
                    pos += data.len();
                    for (field, value) in run_parser(k, f1, f2, data)?.into_iter() {
                        match value {
                            Mv.Img(im) => t.images.set_field(field, im),
                            Mv.L(l) => {
                                for x in l.into_iter() {
                                    t.set_field(field, Val.Str(x));
                                }
                            }
                            Mv.V(v) => {
                                if field == "codec" {
                                    t.set("mime_type", Val.Str(f"audio/mp4; codecs=\"{val_str(v)}\""));
                                } else {
                                    t.set_field(field, v);
                                }
                            }
                        }
                    }
                }
            }
            Ent.Sub(s) => {
                let mut p2 = path.clone();
                p2.push(name.clone());
                pos = traverse_atoms(mut t, mut fh, s, Some(pos), Some(pos + sz), Some(p2))?;
            }
            Ent.Missing => {
                if path_is(path, ilst_path()) {
                    let field = f"other.{name.to_lowercase()}";
                    fh.skip(-header_size);
                    pos -= header_size;
                    let unknown = Tree { kind: T_UNKNOWN, item: L_DATA, f1: field, f2: String.new(), atom: name.clone() };
                    let mut p2 = path.clone();
                    p2.push(name.clone());
                    pos = traverse_atoms(mut t, mut fh, unknown, Some(pos), Some(pos + sz + header_size), Some(p2))?;
                } else {
                    pos = fh.skip(sz);
                }
            }
        }
        if stop_pos != 0 and pos >= stop_pos {
            return Ok(pos);
        }
        let (a, b, c) = read_atom_header(mut fh);
        typ = a;
        header_size = b;
        size = c;
    }
    Ok(pos)
}

fn one(field: Str, v: own Mv) -> Vec[(String, Mv)] {
    let mut out: Vec[(String, Mv)] = Vec.new();
    out.push((field.to_string(), v));
    out
}

// _MP4._data_parser(field)
fn data_atom(field: ref String, data: ref Vec[u8]) -> Result[(String, Mv), Fail] {
    need(data, 0, 4)?;
    let data_type = be32(data, 0);
    let d = tail(data, 8);
    let mut value = String.new();
    if data_type == 1 {
        value = utf8_replace(d);
    } else if data_type == 21 {
        let n = d.len();
        if n == 1 or n == 2 or n == 4 or n == 8 {
            value = f"{sint(d, 0, n, false)}";
        }
    }
    Ok((field.clone(), Mv.V(Val.Str(value))))
}

fn run_parser(k: i64, f1: ref String, f2: ref String, data: ref Vec[u8]) -> Result[Vec[(String, Mv)], Fail] {
    let mut out: Vec[(String, Mv)] = Vec.new();
    if k == L_DATA {
        out.push(data_atom(f1, data)?);
    } else if k == L_NUMS {
        let nd = sub(data, 8, 14);
        need_exact(nd, 6)?;
        out.push((f1.clone(), Mv.V(Val.Int(be16(nd, 2)))));
        out.push((f2.clone(), Mv.V(Val.Int(be16(nd, 4)))));
    } else if k == L_GENRE {
        need(data, 8, 2)?;
        let idx = be16(data, 8) - 1;
        if idx < GENRE_NAME_LEN {
            let i = if idx < 0 { GENRE_NAME_LEN + idx } else { idx };
            out.push(("genre".to_string(), Mv.V(Val.Str(genre_name(i)))));
        }
    } else if k == L_COVER {
        need(data, 0, 4)?;
        let data_type = be32(data, 0);
        let image_data = tail(data, 8);
        let size = image_data.len();
        let im = Image { name: "front_cover".to_string(), size: size, data: image_data, mime_type: mp4_image_mime(data_type), description: None };
        out.push(("front_cover".to_string(), Mv.Img(im)));
    } else if k == L_CUSTOM {
        return parse_custom_field(data);
    } else if k == L_UUID {
        if same_bytes(sub(data, 0, 16), unhex("be7acfcb97a942e89c71999491e3afac".to_string())) {
            out.push(("other.xmp".to_string(), Mv.V(Val.Str(utf8_replace(tail(data, 16))))));
        }
    } else if k == L_MVHD {
        let version = at(data, 0)?;
        if version == 0 {
            need(data, 12, 8)?;
            let time_scale = be32(data, 12);
            let duration = be32(data, 16);
            if time_scale > 0 {
                out.push(("duration".to_string(), Mv.V(Val.Float(fdiv(duration, time_scale)))));
            }
        } else if version == 1 {
            need(data, 20, 12)?;
            let time_scale = be32(data, 20);
            let duration = uint(data, 24, 8, false);
            if time_scale > 0 {
                out.push(("duration".to_string(), Mv.V(Val.Float(fdiv(duration, time_scale)))));
            }
        }
    } else if k == L_MP4A {
        return parse_mp4a(data);
    } else {
        out.push(("codec".to_string(), Mv.V(s_val("alac"))));
        out.push(("is_lossless".to_string(), Mv.V(Val.Bool(true))));
        let bitdepth = at(data, 45)?;
        let channels = at(data, 49)?;
        need(data, 56, 8)?;
        let avg_br = be32(data, 56);
        let samplerate = be32(data, 60);
        if bitdepth > 0 {
            out.push(("bitdepth".to_string(), Mv.V(Val.Int(bitdepth))));
        }
        if channels > 0 {
            out.push(("channels".to_string(), Mv.V(Val.Int(channels))));
        }
        if avg_br > 0 {
            out.push(("bitrate".to_string(), Mv.V(Val.Float(fdiv(avg_br, 1000)))));
        }
        if samplerate != 0 {
            out.push(("samplerate".to_string(), Mv.V(Val.Int(samplerate))));
        }
    }
    Ok(out)
}

fn parse_custom_field(data: ref Vec[u8]) -> Result[Vec[(String, Mv)], Fail] {
    let mut fh = fh_of(data.clone());
    let mut field_name = String.new();
    let mut values: Vec[String] = Vec.new();
    let mut (typ, _hs, size) = read_atom_header(mut fh);
    loop {
        let ty = match typ.clone() {
            Some(b) => b,
            None => break,
        };
        let sz = match size {
            Some(s) => s,
            None => break,
        };
        if is_bytes(ty, "name") {
            let raw = fh.read(sz);
            let fname = utf8_replace(ascii_lower(tail(raw, 4)));
            field_name = match mp4_custom(fname) {
                Some(f) => f,
                None => f"other.{fname}",
            };
        } else if is_bytes(ty, "data") and field_name.len() > 0 {
            let atom = fh.read(sz);
            let (_f, v) = data_atom(field_name, atom)?;
            if let Mv.V(x) = v {
                values.push(val_str(x));
            }
        } else {
            fh.skip(sz);
        }
        let (a, b, c) = read_atom_header(mut fh);
        typ = a;
        _hs = b;
        size = c;
    }
    let mut out: Vec[(String, Mv)] = Vec.new();
    if field_name.len() > 0 and values.len() > 0 {
        out.push((field_name, Mv.L(values)));
    }
    Ok(out)
}

fn read_descriptor_size(data: ref Vec[u8], off0: i64) -> Result[(i64, i64), Fail] {
    let mut size = 0;
    let mut off = off0;
    let mut i = 0;
    while i < 4 {
        let b = at(data, off)?;
        off += 1;
        size = (size << 7) | (b & 0x7f);
        if b & 0x80 == 0 {
            break;
        }
        i += 1;
    }
    Ok((size, off))
}

fn parse_mp4a(data: ref Vec[u8]) -> Result[Vec[(String, Mv)], Fail] {
    let mut out: Vec[(String, Mv)] = Vec.new();
    need(data, 16, 2)?;
    let channels = be16(data, 16);
    need(data, 22, 4)?;
    let samplerate = be32(data, 22);
    if channels > 0 {
        out.push(("channels".to_string(), Mv.V(Val.Int(channels))));
    }
    if samplerate > 0 {
        out.push(("samplerate".to_string(), Mv.V(Val.Int(samplerate))));
    }
    let mut offset = 36 + 5;
    let (_s1, o1) = read_descriptor_size(data, offset)?;
    offset = o1 + 4;
    let (_s2, o2) = read_descriptor_size(data, offset)?;
    offset = o2;
    let object_type = at(data, offset)?;
    let mut codec = f"mp4a.{hex_upper(object_type)}";
    offset += 9;
    need(data, offset, 4)?;
    let avg_br = be32(data, offset);
    if avg_br > 0 {
        out.push(("bitrate".to_string(), Mv.V(Val.Float(fdiv(avg_br, 1000)))));
    }
    offset += 4;
    if data.len() > offset {
        let tag = data[offset] as i64;
        offset += 1;
        if tag == 5 {
            let (_s3, o3) = read_descriptor_size(data, offset)?;
            offset = o3;
            let first = at(data, offset)?;
            let mut aot = first >> 3;
            if aot == 31 {
                let next = at(data, offset + 1)?;
                aot = 32 + (((first & 7) << 3) | (next >> 5));
            }
            codec = f"{codec}.{aot}";
        }
    }
    if object_type != 0 {
        let lossless = mp4_lossless(codec);
        out.push(("codec".to_string(), Mv.V(Val.Str(codec))));
        out.push(("is_lossless".to_string(), Mv.V(Val.Bool(lossless))));
    }
    Ok(out)
}
