        "TKEY" => Some("other.initial_key".to_string()),
        "TKE" => Some("other.initial_key".to_string()),
        "TLAN" => Some("other.language".to_string()),
        "TLA" => Some("other.language".to_string()),
        "TPUB" => Some("other.publisher".to_string()),
        "TPB" => Some("other.publisher".to_string()),
        "USLT" => Some("other.lyrics".to_string()),
        "ULT" => Some("other.lyrics".to_string()),
        "TPE3" => Some("other.conductor".to_string()),
