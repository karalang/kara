fn data_11() -> DataFile {
    let mut t = String.new();
    t.push_str("# mini_tinytag jobs: the tinytag command line, then the Python API\n");
    t.push_str("tinytag data/song.mp3\n");
    t.push_str("tinytag --format json data/vbr.mp3 data/vbri.mp3\n");
    t.push_str("tinytag -f json data/old.mp3 data/v1only.mp3 data/stream.dat\n");
    t.push_str("tinytag -f csv data/album.flac\n");
    t.push_str("tinytag -f tsv data/tagged.flac data/vorbis.ogg\n");
    t.push_str("tinytag -f tabularcsv data/voice.opus data/flac.oga data/talk.spx\n");
    t.push_str("tinytag -f json data/field.wav data/ext.wav data/adpcm.wav\n");
    t.push_str("tinytag data/tune.m4a data/lossless.m4a\n");
    t.push_str("tinytag -f csv data/show.wma\n");
    t.push_str("tinytag -f json data/loop.aiff data/comp.aifc\n");
    t.push_str("tinytag -i data/out/cover.png data/song.mp3\n");
    t.push_str("tinytag --save-image data/out/art.jpg -f tsv data/album.flac data/tune.m4a data/vorbis.ogg data/v1only.mp3\n");
    t.push_str("tinytag -s data/notes.txt data/empty.mp3 data/mystery.bin data/real_flac.bin\n");
    t.push_str("tinytag data/notes.txt data/loop.aiff\n");
    t.push_str("tinytag data/empty.mp3 data/real_flac.bin data/really_ogg.mp4\n");
    t.push_str("tinytag data/bad.ogg\n");
    t.push_str("tinytag data/bad.flac\n");
    t.push_str("tinytag data/fake.wav\n");
    t.push_str("tinytag data/noise.m4a\n");
    t.push_str("tinytag data/short.m4a\n");
    t.push_str("tinytag data/cut.mp3\n");
    t.push_str("tinytag data/mystery.bin\n");
    t.push_str("tinytag data/missing.mp3\n");
    t.push_str("tinytag -f xml data/field.wav\n");
    t.push_str("tinytag -f csv\n");
    t.push_str("tinytag -h data/song.mp3\n");
    t.push_str("get data/vorbis.ogg tags=0\n");
    t.push_str("get data/vorbis.ogg duration=0\n");
    t.push_str("get data/tune.m4a duration=0 image=1\n");
    t.push_str("get data/tune.m4a tags=0\n");
    t.push_str("get data/song.mp3 tags=0\n");
    t.push_str("get data/song.mp3 duration=0 image=1\n");
    t.push_str("get data/album.flac duration=0 image=1\n");
    t.push_str("get data/vorbis.ogg image=1\n");
    t.push_str("get data/old.mp3 image=1\n");
    t.push_str("get data/field.wav tags=0 duration=0\n");
    t.push_str("get data/show.wma duration=0\n");
    t.push_str("get data/loop.aiff tags=0\n");
    t.push_str("get data/real_flac.bin magic=0\n");
    t.push_str("get data/song.mp3 magic=0 tags=0\n");
    t.push_str("images data/song.mp3\n");
    t.push_str("images data/album.flac\n");
    t.push_str("images data/old.mp3\n");
    t.push_str("images data/field.wav\n");
    t.push_str("supported song.mp3 SONG.MP3 a.m4b x.aifc clip.wmv notes.txt archive.flac.zip .ogg\n");
