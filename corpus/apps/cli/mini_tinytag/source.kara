// _MP4._LOSSLESS_CODECS
fn mp4_lossless(k: ref String) -> bool {
    match k {
        "mp4a.40.35" => true,
        "mp4a.40.36" => true,
        "mp4a.40.37" => true,
        "mp4a.40.38" => true,
        _ => false,
    }
}

// _MP4's tree below ilst: for each atom, the parser of its data atom, as
// (kind, field, field): 0 _data_parser, 1 _nums_parser, 2 the genre, 3
// the cover; 4 is the '----' atom, parsed by _parse_custom_field itself.
fn ilst_entry(k: ref String) -> Option[(i64, String, String)] {
    match k {
        "\u{a9}ART" => Some((0, "artist".to_string(), "".to_string())),
        "\u{a9}alb" => Some((0, "album".to_string(), "".to_string())),
        "\u{a9}cmt" => Some((0, "comment".to_string(), "".to_string())),
        "\u{a9}com" => Some((0, "composer".to_string(), "".to_string())),
        "\u{a9}con" => Some((0, "other.conductor".to_string(), "".to_string())),
        "\u{a9}day" => Some((0, "year".to_string(), "".to_string())),
        "\u{a9}des" => Some((0, "other.description".to_string(), "".to_string())),
        "\u{a9}dir" => Some((0, "other.director".to_string(), "".to_string())),
        "\u{a9}gen" => Some((0, "genre".to_string(), "".to_string())),
        "\u{a9}grp" => Some((0, "other.grouping".to_string(), "".to_string())),
        "\u{a9}lyr" => Some((0, "other.lyrics".to_string(), "".to_string())),
        "\u{a9}mvc" => Some((0, "other.movement_total".to_string(), "".to_string())),
        "\u{a9}mvi" => Some((0, "other.movement".to_string(), "".to_string())),
        "\u{a9}mvn" => Some((0, "other.movement_name".to_string(), "".to_string())),
        "\u{a9}nam" => Some((0, "title".to_string(), "".to_string())),
        "\u{a9}pub" => Some((0, "other.publisher".to_string(), "".to_string())),
        "\u{a9}too" => Some((0, "other.encoded_by".to_string(), "".to_string())),
        "\u{a9}wrk" => Some((0, "other.work".to_string(), "".to_string())),
        "\u{a9}wrt" => Some((0, "composer".to_string(), "".to_string())),
        "aART" => Some((0, "albumartist".to_string(), "".to_string())),
        "cprt" => Some((0, "other.copyright".to_string(), "".to_string())),
        "desc" => Some((0, "other.description".to_string(), "".to_string())),
        "disk" => Some((1, "disc".to_string(), "disc_total".to_string())),
        "gnre" => Some((2, "".to_string(), "".to_string())),
        "shwm" => Some((0, "other.show_movement".to_string(), "".to_string())),
        "trkn" => Some((1, "track".to_string(), "track_total".to_string())),
        "tmpo" => Some((0, "other.bpm".to_string(), "".to_string())),
        "covr" => Some((3, "".to_string(), "".to_string())),
        "----" => Some((4, "".to_string(), "".to_string())),
        _ => None,
    }
}

// _Aiff._AIFF_MAPPING
fn aiff_field(k: ref String) -> Option[String] {
    match k {
        "NAME" => Some("title".to_string()),
        "AUTH" => Some("artist".to_string()),
        "ANNO" => Some("comment".to_string()),
        "(c) " => Some("other.copyright".to_string()),
        _ => None,
    }
}

// _Aiff._UNCOMPRESSED_FORMATS
fn aiff_uncompressed(k: ref String) -> bool {
    match k {
        "23ni" => true,
        "42ni" => true,
        "FL32" => true,
        "FL64" => true,
        "NONE" => true,
        "fl32" => true,
        "fl64" => true,
        "in24" => true,
        "in32" => true,
        "raw " => true,
        "sowt" => true,
        "twos" => true,
        _ => false,
    }
}

// TinyTag._get_parser_for_filename: each extension and its class
fn ext_class(name: ref String) -> i64 {
    let n = name.to_lowercase();
    if n.ends_with(".mp1") {
        return K_ID3;
    }
    if n.ends_with(".mp2") {
        return K_ID3;
    }
    if n.ends_with(".mp3") {
        return K_ID3;
    }
    if n.ends_with(".flac") {
        return K_ID3;
    }
    if n.ends_with(".oga") {
        return K_OGG;
    }
    if n.ends_with(".ogv") {
        return K_OGG;
    }
    if n.ends_with(".ogg") {
        return K_OGG;
    }
    if n.ends_with(".opus") {
        return K_OGG;
    }
    if n.ends_with(".spx") {
        return K_OGG;
    }
    if n.ends_with(".wav") {
        return K_WAVE;
    }
    if n.ends_with(".wma") {
        return K_ASF;
    }
    if n.ends_with(".wmv") {
        return K_ASF;
    }
    if n.ends_with(".asf") {
        return K_ASF;
    }
    if n.ends_with(".m4b") {
        return K_MP4;
    }
    if n.ends_with(".m4a") {
        return K_MP4;
    }
    if n.ends_with(".m4r") {
        return K_MP4;
    }
    if n.ends_with(".m4v") {
        return K_MP4;
    }
    if n.ends_with(".mp4") {
        return K_MP4;
    }
    if n.ends_with(".aax") {
        return K_MP4;
    }
    if n.ends_with(".aaxc") {
        return K_MP4;
    }
    if n.ends_with(".aiff") {
        return K_AIFF;
    }
    if n.ends_with(".aifc") {
        return K_AIFF;
    }
    if n.ends_with(".aif") {
        return K_AIFF;
    }
    if n.ends_with(".afc") {
        return K_AIFF;
    }
    0
}
