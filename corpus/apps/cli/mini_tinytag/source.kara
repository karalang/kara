// _MPEG._SAMPLES_PER_FRAME, at mpeg_id * 4 + layer_id
fn mpeg_samples_per_frame(i: i64) -> i64 {
    match i {
        1 => 576,
        2 => 1152,
        3 => 384,
        9 => 576,
        10 => 1152,
        11 => 384,
        13 => 1152,
        14 => 1152,
        15 => 384,
        _ => 0,
    }
}

// _MPEG._SLOT_SIZES
fn mpeg_slot_size(i: i64) -> i64 {
    match i {
        1 => 1,
        2 => 1,
        3 => 4,
        _ => 0,
    }
}

// _MPEG._CHANNELS_PER_CHANNEL_MODE
fn mpeg_channels(i: i64) -> i64 {
    match i {
        0 => 2,
        1 => 2,
        2 => 2,
        3 => 1,
        _ => 0,
    }
}

