        "TP2" => Some("albumartist".to_string()),
        "TCOM" => Some("composer".to_string()),
        "TCM" => Some("composer".to_string()),
        "WOAR" => Some("other.url".to_string()),
        "WAR" => Some("other.url".to_string()),
        "TSRC" => Some("other.isrc".to_string()),
        "TRC" => Some("other.isrc".to_string()),
        "TCOP" => Some("other.copyright".to_string()),
