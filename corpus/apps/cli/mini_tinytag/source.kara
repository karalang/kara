// _MPEG._SAMPLE_RATES, at mpeg_id * 3 + sr_id
fn mpeg_sample_rate(i: i64) -> i64 {
    match i {
        0 => 11025,
        1 => 12000,
        2 => 8000,
        6 => 22050,
        7 => 24000,
        8 => 16000,
        9 => 44100,
        10 => 48000,
        11 => 32000,
        _ => 0,
    }
}

