// mini_geopy: a port of geopy 2.4.1 (MIT; the geopy authors), the Python
// library most code reaches for to parse coordinates and measure distances
// between them. It parses a point the way geopy does, with its own
// POINT_PATTERN regular expression (degrees, arcminutes and arcseconds,
// N/S/E/W on either side, decimal or symbol notation, an optional altitude
// with a unit), normalizes the coordinates, and prints the point in each
// of geopy's formats. It also ports the unit helpers, format_degrees, and
// the Distance classes: geodesic on the ellipsoid, great_circle on the
// sphere, destination points, and Distance arithmetic and comparisons.
//
// Three earlier ports carry the parts geopy leans on. POINT_PATTERN runs
// on the regular-expression engine from mini_re (Python re semantics,
// verbose and Unicode flags, lazy repeats and backtracking). geodesic runs
// on the geographiclib 2.1 port from mini_geographiclib, which is the
// library geopy itself calls. format_degrees prints with %g, which Kāra's
// formatting does not have, so %g is done by hand: it rounds the exact
// binary value to 6 significant digits, half to even, with the
// arbitrary-precision Decimal from mini_zxcvbn.
//
// data/jobs.tsv (see mk.py) is a list of commands: `point` parses a
// coordinate string, `make`, `seq` and `lonlat` build points from numbers
// and sequences, `degrees`, `parse_degrees`, `altitude` and `units` call
// the helpers, `dist` and `dest` measure distances and destinations,
// `arith` does Distance arithmetic, and `route`, `nearest` and `fence` are
// small programs over the input files. oracle.py runs the same commands
// against the real library.
//
// Compiler gaps, worked around (in the geographiclib part):
// - B-2026-10-23-3: a method call on a `const` (`TOL0.sqrt()`) runs under
//   --interp but v2 lowers it as a call of `f64.sqrt` and fails, so tiny()
//   and tol2() copy the const into a local first.
// - B-2026-10-23-4: Display breaks an exact tie between two equally short
//   decimals away from zero, Python's repr toward the even digit, so fmt()
//   checks the exact expansion and keeps the even candidate.

// ------------------------------------------------------------ helpers

struct Exc {
    cls: String,
    msg: String,
}

fn exc(cls: Str, msg: own String) -> Exc {
    Exc { cls: cls.to_string(), msg: msg }
}

fn value_error(msg: own String) -> Exc {
    exc("ValueError", msg)
}

fn hex_digit(c: char) -> i64 {
    if c >= '0' and c <= '9' {
        c as i64 - 48
    } else if c >= 'a' and c <= 'f' {
        c as i64 - 87
    } else {
        0
    }
}

fn hex_bytes(s: ref String) -> Vec[u8] {
    let cs: Vec[char] = s.chars().collect();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < cs.len() {
        out.push((hex_digit(cs[i]) * 16 + hex_digit(cs[i + 1])) as u8);
        i += 2;
    }
    out
}

fn hex_string(s: ref String) -> String {
    String.from_utf8(hex_bytes(s)).unwrap_or(String.new())
}

fn split_on(s: ref String, sep: char) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn join_strs(xs: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    let mut first = true;
    for x in xs {
        if not first {
            out.push_str(sep);
        }
        out.push_str(x);
        first = false;
    }
    out
}

fn dirname_of(path: ref String) -> String {
    let cs: Vec[char] = path.chars().collect();
    let mut cut = 0;
    let mut i = 0;
    while i < cs.len() {
        if cs[i] == '/' {
            cut = i;
        }
        i += 1;
    }
    let mut out = String.new();
    let mut k = 0;
    while k < cut {
        out.push(cs[k]);
        k += 1;
    }
    out
}

// str.strip()'s whitespace.
fn py_space(c: char) -> bool {
    c.is_whitespace() or (c >= '\u{1c}' and c <= '\u{1f}')
}

fn py_strip(s: ref String) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut lo = 0;
    let mut hi = cs.len();
    while lo < hi and py_space(cs[lo]) {
        lo += 1;
    }
    while hi > lo and py_space(cs[hi - 1]) {
        hi -= 1;
    }
    let mut out = String.new();
    let mut k = lo;
    while k < hi {
        out.push(cs[k]);
        k += 1;
    }
    out
}

// repr() of a str, quoted as Python quotes it.
fn str_repr_s(s: ref String) -> String {
    let q = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if (c as i64) < 32 or c as i64 == 127 {
            let n = c as i64;
            let hx = "0123456789abcdef";
            let hc: Vec[char] = hx.chars().collect();
            out.push_str("\\x");
            out.push(hc[n / 16]);
            out.push(hc[n % 16]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    out
}

fn is_ascii_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

// digitpart: digit (['_'] digit)*, from k; returns the end, or -1.
fn digit_part(cs: ref Vec[char], k0: i64, out: mut ref String) -> i64 {
    let mut k = k0;
    if k >= cs.len() or not is_ascii_digit(cs[k]) {
        return -1;
    }
    while k < cs.len() {
        if is_ascii_digit(cs[k]) {
            out.push(cs[k]);
            k += 1;
        } else if cs[k] == '_' and k + 1 < cs.len() and is_ascii_digit(cs[k + 1]) and k > k0 {
            k += 1;
        } else {
            break;
        }
    }
    k
}

// float(str): surrounding whitespace, a sign, underscores between digits,
// and inf / infinity / nan in any case.
fn py_float(s: ref String) -> Option[f64] {
    let t = py_strip(s);
    let cs: Vec[char] = t.chars().collect();
    let mut k = 0;
    let mut neg = false;
    if k < cs.len() and (cs[k] == '+' or cs[k] == '-') {
        neg = cs[k] == '-';
        k += 1;
    }
    let mut rest = String.new();
    let mut j = k;
    while j < cs.len() {
        rest.push(cs[j]);
        j += 1;
    }
    let low = rest.to_lowercase();
    if low == "inf" or low == "infinity" {
        return Some(if neg { f64.NEG_INFINITY } else { f64.INFINITY });
    }
    if low == "nan" {
        return Some(f64.NAN);
    }
    let mut body = String.new();
    let mut seen = false;
    if k < cs.len() and is_ascii_digit(cs[k]) {
        k = digit_part(cs, k, mut body);
        seen = true;
    }
    if k < cs.len() and cs[k] == '.' {
        body.push('.');
        k += 1;
        if k < cs.len() and is_ascii_digit(cs[k]) {
            k = digit_part(cs, k, mut body);
            seen = true;
        }
    }
    if not seen {
        return None;
    }
    if k < cs.len() and (cs[k] == 'e' or cs[k] == 'E') {
        body.push('e');
        k += 1;
        if k < cs.len() and (cs[k] == '+' or cs[k] == '-') {
            body.push(cs[k]);
            k += 1;
        }
        k = digit_part(cs, k, mut body);
        if k < 0 {
            return None;
        }
    }
    if k != cs.len() {
        return None;
    }
    match f64.parse(body) {
        Ok(x) => Some(if neg { -x } else { x }),
        Err(_) => None,
    }
}

fn float_of(s: ref String) -> Result[f64, Exc] {
    match py_float(s) {
        Some(x) => Ok(x),
        None => Err(value_error(f"could not convert string to float: {str_repr_s(s)}")),
    }
}

fn neg_zero() -> f64 {
    0.0 * -1.0
}

fn sign_bit(x: f64) -> bool {
    (x.to_bits() >> 63) == 1
}

// '%g' % x: six significant digits, rounded half-even on the exact
// binary value as C's printf rounds, trailing zeros dropped.
fn fmt_g(x: f64) -> String {
    if is_nan(x) {
        return "nan".to_string();
    }
    if x == f64.INFINITY {
        return "inf".to_string();
    }
    if x == f64.NEG_INFINITY {
        return "-inf".to_string();
    }
    let sign = if sign_bit(x) { "-" } else { "" };
    let ax = x.abs();
    if ax == 0.0 {
        return f"{sign}0";
    }
    let d = dec_fix(dec_from_f64(ax), 6);
    let full = big_to_string(d.coef);
    let e = d.exp + full.len() - 1;
    // the significant digits without trailing zeros
    let fc: Vec[char] = full.chars().collect();
    let mut n = fc.len();
    while n > 1 and fc[n - 1] == '0' {
        n -= 1;
    }
    let mut digits = String.new();
    let mut k = 0;
    while k < n {
        digits.push(fc[k]);
        k += 1;
    }
    let dc: Vec[char] = digits.chars().collect();
    let mut out = String.new();
    out.push_str(sign);
    if e >= -4 and e < 6 {
        if e >= 0 {
            let mut i = 0;
            while i <= e {
                out.push(if i < dc.len() { dc[i] } else { '0' });
                i += 1;
            }
            if dc.len() > e + 1 {
                out.push('.');
                let mut j = e + 1;
                while j < dc.len() {
                    out.push(dc[j]);
                    j += 1;
                }
            }
        } else {
            out.push_str("0.");
            let mut z = 0;
            while z < -e - 1 {
                out.push('0');
                z += 1;
            }
            out.push_str(digits);
        }
    } else {
        out.push(dc[0]);
        if dc.len() > 1 {
            out.push('.');
            let mut j = 1;
            while j < dc.len() {
                out.push(dc[j]);
                j += 1;
            }
        }
        let ae = if e < 0 { -e } else { e };
        let es = if ae < 10 { f"0{ae}" } else { f"{ae}" };
        out.push_str(if e < 0 { "e-" } else { "e+" });
        out.push_str(es);
    }
    out
}

fn py_bool(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

// ------------------------------------------------------------ geopy.units

fn u_degrees(radians: f64, arcminutes: f64, arcseconds: f64) -> f64 {
    let mut deg = 0.0;
    if radians != 0.0 {
        deg = degrees(radians);
    }
    if arcminutes != 0.0 {
        deg += arcminutes / u_arcminutes(1.0, 0.0, 0.0);
    }
    if arcseconds != 0.0 {
        deg += arcseconds / u_arcseconds(1.0, 0.0, 0.0);
    }
    deg
}

fn u_radians(degrees0: f64, arcminutes: f64, arcseconds: f64) -> f64 {
    let mut deg = degrees0;
    if arcminutes != 0.0 {
        deg += arcminutes / u_arcminutes(1.0, 0.0, 0.0);
    }
    if arcseconds != 0.0 {
        deg += arcseconds / u_arcseconds(1.0, 0.0, 0.0);
    }
    radians(deg)
}

fn u_arcminutes(degrees0: f64, radians: f64, arcseconds: f64) -> f64 {
    let mut deg = degrees0;
    if radians != 0.0 {
        deg += degrees(radians);
    }
    if arcseconds != 0.0 {
        deg += arcseconds / u_arcseconds(1.0, 0.0, 0.0);
    }
    deg * 60.0
}

fn u_arcseconds(degrees0: f64, radians: f64, arcminutes: f64) -> f64 {
    let mut deg = degrees0;
    if radians != 0.0 {
        deg += degrees(radians);
    }
    if arcminutes != 0.0 {
        deg += arcminutes / u_arcminutes(1.0, 0.0, 0.0);
    }
    deg * 3600.0
}

fn u_kilometers(meters: f64, miles: f64, feet: f64, nautical: f64) -> f64 {
    let mut ret = 0.0;
    if meters != 0.0 {
        ret += meters / 1000.0;
    }
    if feet != 0.0 {
        ret += feet / u_feet(1.0, 0.0, 0.0, 0.0);
    }
    if nautical != 0.0 {
        ret += nautical / u_nautical(1.0, 0.0, 0.0, 0.0);
    }
    ret += miles * 1.609344;
    ret
}

fn u_meters(kilometers: f64, miles: f64, feet: f64, nautical: f64) -> f64 {
    (kilometers + u_kilometers(0.0, miles, feet, nautical)) * 1000.0
}

fn u_miles(kilometers0: f64, meters: f64, feet: f64, nautical: f64) -> f64 {
    let mut kilometers = kilometers0;
    let mut ret = 0.0;
    if nautical != 0.0 {
        kilometers += nautical / u_nautical(1.0, 0.0, 0.0, 0.0);
    }
    if feet != 0.0 {
        kilometers += feet / u_feet(1.0, 0.0, 0.0, 0.0);
    }
    if meters != 0.0 {
        kilometers += meters / 1000.0;
    }
    ret += kilometers / 1.609344;
    ret
}

fn u_feet(kilometers0: f64, meters: f64, miles0: f64, nautical: f64) -> f64 {
    let mut kilometers = kilometers0;
    let mut miles = miles0;
    let mut ret = 0.0;
    if nautical != 0.0 {
        kilometers += nautical / u_nautical(1.0, 0.0, 0.0, 0.0);
    }
    if meters != 0.0 {
        kilometers += meters / 1000.0;
    }
    if kilometers != 0.0 {
        miles += u_miles(kilometers, 0.0, 0.0, 0.0);
    }
    ret += miles * 5280.0;
    ret
}

fn u_nautical(kilometers0: f64, meters: f64, miles: f64, feet: f64) -> f64 {
    let mut kilometers = kilometers0;
    let mut ret = 0.0;
    if feet != 0.0 {
        kilometers += feet / u_feet(1.0, 0.0, 0.0, 0.0);
    }
    if miles != 0.0 {
        kilometers += u_kilometers(0.0, miles, 0.0, 0.0);
    }
    if meters != 0.0 {
        kilometers += meters / 1000.0;
    }
    ret += kilometers / 1.852;
    ret
}

// A units function called by keyword, as units.<name>(**kwargs) is.
fn call_unit(name: ref String, kws: ref Vec[(String, f64)]) -> Result[f64, Exc] {
    let canon = if name == "rad" {
        "radians"
    } else if name == "arcmin" {
        "arcminutes"
    } else if name == "arcsec" {
        "arcseconds"
    } else if name == "km" {
        "kilometers"
    } else if name == "m" {
        "meters"
    } else if name == "mi" {
        "miles"
    } else if name == "ft" {
        "feet"
    } else if name == "nm" {
        "nautical"
    } else {
        name.as_str()
    };
    let params: Vec[String] = if canon == "degrees" {
        vec!["radians", "arcminutes", "arcseconds"]
    } else if canon == "radians" {
        vec!["degrees", "arcminutes", "arcseconds"]
    } else if canon == "arcminutes" {
        vec!["degrees", "radians", "arcseconds"]
    } else if canon == "arcseconds" {
        vec!["degrees", "radians", "arcminutes"]
    } else if canon == "kilometers" {
        vec!["meters", "miles", "feet", "nautical"]
    } else if canon == "meters" {
        vec!["kilometers", "miles", "feet", "nautical"]
    } else if canon == "miles" {
        vec!["kilometers", "meters", "feet", "nautical"]
    } else if canon == "feet" {
        vec!["kilometers", "meters", "miles", "nautical"]
    } else if canon == "nautical" {
        vec!["kilometers", "meters", "miles", "feet"]
    } else {
        return Err(exc("AttributeError", f"module 'geopy.units' has no attribute {str_repr_s(name)}"));
    };
    let mut a: Vec[f64] = vec![0.0, 0.0, 0.0, 0.0];
    for (key, v) in kws.iter() {
        let mut found = -1;
        let mut k = 0;
        while k < params.len() {
            if params[k] == *key {
                found = k;
            }
            k += 1;
        }
        if found < 0 {
            return Err(exc("TypeError", f"{canon}() got an unexpected keyword argument {str_repr_s(key)}"));
        }
        a[found] = *v;
    }
    Ok(if canon == "degrees" {
        u_degrees(a[0], a[1], a[2])
    } else if canon == "radians" {
        u_radians(a[0], a[1], a[2])
    } else if canon == "arcminutes" {
        u_arcminutes(a[0], a[1], a[2])
    } else if canon == "arcseconds" {
        u_arcseconds(a[0], a[1], a[2])
    } else if canon == "kilometers" {
        u_kilometers(a[0], a[1], a[2], a[3])
    } else if canon == "meters" {
        u_meters(a[0], a[1], a[2], a[3])
    } else if canon == "miles" {
        u_miles(a[0], a[1], a[2], a[3])
    } else if canon == "feet" {
        u_feet(a[0], a[1], a[2], a[3])
    } else {
        u_nautical(a[0], a[1], a[2], a[3])
    })
}

// ------------------------------------------------------------ geopy.format

struct Symbols {
    deg: String,
    arcmin: String,
    arcsec: String,
}

fn symbols_of(name: ref String) -> Symbols {
    let (d, m, s) = if name == "unicode" {
        ("\u{b0}", "\u{2032}", "\u{2033}")
    } else if name == "latin1" {
        ("\u{b0}", "'", "\"")
    } else if name == "html" {
        ("&deg;", "&prime;", "&Prime;")
    } else if name == "xml" {
        ("&#176;", "&#8242;", "&#8243;")
    } else if name == "abbr" {
        ("deg", "arcmin", "arcsec")
    } else {
        ("", "'", "\"")
    };
    Symbols { deg: d.to_string(), arcmin: m.to_string(), arcsec: s.to_string() }
}

// int(x) for a finite float, as the digits '%d' prints.
fn trunc_str(x: f64) -> String {
    let t = x.trunc();
    let d = dec_from_f64(t.abs());
    let digits = big_to_string(dec_round_int(d));
    if t < 0.0 { f"-{digits}" } else { digits }
}

fn format_degrees(degrees0: f64, sym: ref Symbols) -> String {
    let arcminutes = u_arcminutes(degrees0 - degrees0.trunc(), 0.0, 0.0);
    let arcseconds = u_arcseconds(0.0, 0.0, arcminutes - arcminutes.trunc());
    f"{trunc_str(degrees0)}{sym.deg} {trunc_str(arcminutes.abs())}{sym.arcmin} {fmt_g(arcseconds.abs())}{sym.arcsec}"
}

fn unit_ok(unit: ref String) -> bool {
    unit == "km" or unit == "m" or unit == "mi" or unit == "ft" or unit == "nm" or unit == "nmi"
}

fn format_distance(kilometers: f64, unit: ref String) -> Result[String, Exc] {
    let magnitude = if unit == "km" {
        kilometers
    } else if unit == "m" {
        u_meters(kilometers, 0.0, 0.0, 0.0)
    } else if unit == "mi" {
        u_miles(kilometers, 0.0, 0.0, 0.0)
    } else if unit == "ft" {
        u_feet(kilometers, 0.0, 0.0, 0.0)
    } else if unit == "nm" or unit == "nmi" {
        u_nautical(kilometers, 0.0, 0.0, 0.0)
    } else {
        return Err(exc("KeyError", str_repr_s(unit)));
    };
    Ok(f"{fmt(magnitude)}{unit}")
}

// ------------------------------------------------------------ geopy.point

struct Point {
    latitude: f64,
    longitude: f64,
    altitude: f64,
}

impl Clone for Point {
    fn clone(ref self) -> Point {
        Point { latitude: self.latitude, longitude: self.longitude, altitude: self.altitude }
    }
}

// An argument a caller hands Point(): None, a number, a str, or a list.
enum Val {
    Nothing,
    Int(i64),
    Flt(f64),
    Text(String),
    Items(Vec[Val]),
}

fn val_repr(v: ref Val) -> String {
    match v {
        Val.Nothing => "None".to_string(),
        Val.Int(n) => f"{n}",
        Val.Flt(x) => fmt(*x),
        Val.Text(s) => str_repr_s(s),
        Val.Items(_) => "[...]".to_string(),
    }
}

// float(x or 0.0)
fn coord_float(v: ref Val) -> Result[f64, Exc] {
    match v {
        Val.Nothing => Ok(0.0),
        Val.Int(n) => Ok(*n as f64),
        Val.Flt(x) => Ok(if *x == 0.0 { 0.0 } else { *x }),
        Val.Text(s) => {
            if s.len() == 0 {
                Ok(0.0)
            } else {
                float_of(s)
            }
        }
        Val.Items(_) => Err(exc("TypeError", "float() argument must be a string or a real number, not 'list'".to_string())),
    }
}

fn is_finite(x: f64) -> bool {
    not is_nan(x) and x != f64.INFINITY and x != f64.NEG_INFINITY
}

// _normalize_angle: x into [-limit; limit), -0 turned to +0.
fn normalize_angle(x: f64, limit: f64) -> f64 {
    let double_limit = limit * 2.0;
    let mut modulo = x % double_limit;
    if modulo == 0.0 {
        modulo = 0.0;
    }
    if modulo < -limit {
        return modulo + double_limit;
    }
    if modulo >= limit {
        return modulo - double_limit;
    }
    modulo
}

fn normalize_coordinates(lat0: ref Val, lon0: ref Val, alt0: ref Val) -> Result[Point, Exc] {
    let latitude = coord_float(lat0)?;
    let mut longitude = coord_float(lon0)?;
    let altitude = coord_float(alt0)?;
    if not (is_finite(latitude) and is_finite(longitude) and is_finite(altitude)) {
        return Err(value_error(f"Point coordinates must be finite. ({fmt(latitude)}, {fmt(longitude)}, {fmt(altitude)}) has been passed as coordinates."));
    }
    if latitude.abs() > 90.0 {
        return Err(value_error("Latitude must be in the [-90; 90] range.".to_string()));
    }
    if longitude.abs() > 180.0 {
        longitude = normalize_angle(longitude, 180.0);
    }
    Ok(Point { latitude: latitude, longitude: longitude, altitude: altitude })
}

fn is_number(v: ref Val) -> bool {
    match v {
        Val.Int(_) => true,
        Val.Flt(_) => true,
        _ => false,
    }
}

fn is_nothing(v: ref Val) -> bool {
    match v {
        Val.Nothing => true,
        _ => false,
    }
}

// Point(latitude, longitude, altitude)
fn new_point(rx: ref Program, lat: ref Val, lon: ref Val, alt: ref Val) -> Result[Point, Exc] {
    let single = not is_nothing(lat) and is_nothing(lon) and is_nothing(alt);
    if single and not is_number(lat) {
        match lat {
            Val.Text(s) => return point_from_string(rx, s),
            Val.Items(items) => return point_from_sequence(rx, items),
            _ => {}
        }
    }
    if single {
        return Err(value_error("A single number has been passed to the Point constructor. This is probably a mistake, because constructing a Point with just a latitude seems senseless. If this is exactly what was meant, then pass the zero longitude explicitly to get rid of this error.".to_string()));
    }
    normalize_coordinates(lat, lon, alt)
}

fn point_from_sequence(rx: ref Program, items: ref Vec[Val]) -> Result[Point, Exc] {
    if items.len() > 3 {
        return Err(value_error("When creating a Point from sequence, it must not have more than 3 items.".to_string()));
    }
    let a = if items.len() > 0 { items[0].clone() } else { Val.Nothing };
    let b = if items.len() > 1 { items[1].clone() } else { Val.Nothing };
    let c = if items.len() > 2 { items[2].clone() } else { Val.Nothing };
    new_point(rx, a, b, c)
}

impl Clone for Val {
    fn clone(ref self) -> Val {
        match self {
            Val.Nothing => Val.Nothing,
            Val.Int(n) => Val.Int(*n),
            Val.Flt(x) => Val.Flt(*x),
            Val.Text(s) => Val.Text(s.clone()),
            Val.Items(v) => {
                let mut out: Vec[Val] = Vec.new();
                for x in v.iter() {
                    out.push(x.clone());
                }
                Val.Items(out)
            }
        }
    }
}

fn point3(rx: ref Program, lat: f64, lon: f64, alt: f64) -> Result[Point, Exc] {
    new_point(rx, Val.Flt(lat), Val.Flt(lon), Val.Flt(alt))
}

// Point.parse_degrees
fn parse_degrees(degrees_v: ref Val, arcminutes_v: ref Val, arcseconds_v: ref Val, direction: ref Option[String]) -> Result[f64, Exc] {
    let mut degrees0 = val_float(degrees_v)?;
    let negative = degrees0 < 0.0;
    let arcminutes = val_float(arcminutes_v)?;
    let arcseconds = val_float(arcseconds_v)?;
    if arcminutes != 0.0 or arcseconds != 0.0 {
        let more = u_degrees(0.0, arcminutes, arcseconds);
        if negative {
            degrees0 -= more;
        } else {
            degrees0 += more;
        }
    }
    match direction {
        None => Ok(degrees0),
        Some(d) => {
            if d == "N" or d == "E" {
                Ok(degrees0)
            } else if d == "S" or d == "W" {
                Ok(-degrees0)
            } else {
                Err(value_error("Invalid direction! Should be one of [NSEW].".to_string()))
            }
        }
    }
}

// float(x), where x is a str or a number
fn val_float(v: ref Val) -> Result[f64, Exc] {
    match v {
        Val.Int(n) => Ok(*n as f64),
        Val.Flt(x) => Ok(*x),
        Val.Text(s) => float_of(s),
        _ => Err(exc("TypeError", "float() argument must be a string or a real number, not 'NoneType'".to_string())),
    }
}

// Point.parse_altitude: the altitude in kilometres, or None.
fn parse_altitude(distance: ref Option[String], unit: ref Option[String]) -> Result[Option[f64], Exc] {
    let text = match distance {
        None => return Ok(None),
        Some(t) => t.clone(),
    };
    let d = float_of(text)?;
    let u = match unit {
        Some(u) => u.clone(),
        None => "None".to_string(),
    };
    if u == "km" {
        Ok(Some(d))
    } else if u == "m" {
        Ok(Some(u_kilometers(d, 0.0, 0.0, 0.0)))
    } else if u == "mi" {
        Ok(Some(u_kilometers(0.0, d, 0.0, 0.0)))
    } else if u == "ft" {
        Ok(Some(u_kilometers(0.0, 0.0, d, 0.0)))
    } else if u == "nm" or u == "nmi" {
        Ok(Some(u_kilometers(0.0, 0.0, 0.0, d)))
    } else {
        Err(exc("NotImplementedError", "Bad distance unit specified, valid are: dict_keys(['km', 'm', 'mi', 'ft', 'nm', 'nmi'])".to_string()))
    }
}

fn cps(s: ref String) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s.chars() {
        out.push(c as i64);
    }
    out
}

fn group_named(prog: ref Program, s: ref Vec[i64], found: ref Found, name: Str) -> Option[String] {
    let key = cps(name.to_string());
    for (n, g) in prog.names.iter() {
        if same(n, key) {
            let (a, b) = found.spans[*g - 1];
            if a < 0 {
                return None;
            }
            return Some(to_string(slice(s, a, b)));
        }
    }
    None
}

// A group's text, or None when it did not take part or matched nothing
// (`if match.group(...)` treats both alike).
fn truthy(g: ref Option[String]) -> Option[String] {
    match g {
        Some(t) => if t.len() > 0 { Some(t.clone()) } else { None },
        None => None,
    }
}

fn group_or_zero(g: ref Option[String]) -> Val {
    match truthy(g) {
        Some(t) => Val.Text(t),
        None => Val.Flt(0.0),
    }
}

// Point.from_string
fn point_from_string(rx: ref Program, string: ref String) -> Result[Point, Exc] {
    let text = string.replace("''", "\"");
    let s = cps(text);
    let mut m = new_matcher(rx, s);
    let found = match find(mut m, rx, 0, false, 1) {
        Some(f) => f,
        None => return Err(value_error("Failed to create Point instance from string: unknown format.".to_string())),
    };
    let lat_dir = match truthy(group_named(rx, s, found, "latitude_direction_front")) {
        Some(d) => Some(d),
        None => truthy(group_named(rx, s, found, "latitude_direction_back")),
    };
    let lon_dir = match truthy(group_named(rx, s, found, "longitude_direction_front")) {
        Some(d) => Some(d),
        None => truthy(group_named(rx, s, found, "longitude_direction_back")),
    };
    let latitude = parse_degrees(
        group_or_zero(group_named(rx, s, found, "latitude_degrees")),
        group_or_zero(group_named(rx, s, found, "latitude_arcminutes")),
        group_or_zero(group_named(rx, s, found, "latitude_arcseconds")),
        lat_dir,
    )?;
    let longitude = parse_degrees(
        group_or_zero(group_named(rx, s, found, "longitude_degrees")),
        group_or_zero(group_named(rx, s, found, "longitude_arcminutes")),
        group_or_zero(group_named(rx, s, found, "longitude_arcseconds")),
        lon_dir,
    )?;
    let altitude = parse_altitude(group_named(rx, s, found, "altitude_distance"), group_named(rx, s, found, "altitude_units"))?;
    let alt_v = match altitude {
        Some(a) => Val.Flt(a),
        None => Val.Nothing,
    };
    new_point(rx, Val.Flt(latitude), Val.Flt(longitude), alt_v)
}

fn point_repr(p: ref Point) -> String {
    f"Point({fmt(p.latitude)}, {fmt(p.longitude)}, {fmt(p.altitude)})"
}

// Point.format(altitude, deg_char, min_char, sec_char); `unit` is the
// altitude's unit, or "" to leave it out.
fn point_format(p: ref Point, unit: Str, sym: ref Symbols) -> String {
    let lat = f"{format_degrees(p.latitude.abs(), sym)} {if p.latitude >= 0.0 { "N" } else { "S" }}";
    let lon = f"{format_degrees(p.longitude.abs(), sym)} {if p.longitude >= 0.0 { "E" } else { "W" }}";
    let mut parts: Vec[String] = vec![lat, lon];
    if unit.len() > 0 {
        parts.push(format_distance(p.altitude, unit.to_string()).unwrap_or(String.new()));
    }
    join_strs(parts, ", ")
}

fn default_unit(p: ref Point) -> Str {
    if p.altitude != 0.0 { "km" } else { "" }
}

fn point_str(p: ref Point) -> String {
    point_format(p, default_unit(p), Symbols { deg: String.new(), arcmin: "m".to_string(), arcsec: "s".to_string() })
}

fn point_unicode(p: ref Point) -> String {
    point_format(p, default_unit(p), Symbols { deg: "\u{b0}".to_string(), arcmin: "\u{2032}".to_string(), arcsec: "\u{2033}".to_string() })
}

fn point_decimal(p: ref Point) -> String {
    let mut parts: Vec[String] = vec![fmt(p.latitude), fmt(p.longitude)];
    let unit = default_unit(p);
    if unit.len() > 0 {
        parts.push(format_distance(p.altitude, unit.to_string()).unwrap_or(String.new()));
    }
    join_strs(parts, ", ")
}

// ------------------------------------------------------------ geopy.distance

const EARTH_RADIUS: f64 = 6371.009;

fn ellipsoid_named(name: ref String) -> Option[(f64, f64, f64)] {
    if name == "WGS-84" {
        Some((6378.137, 6356.7523142, 1.0 / 298.257223563))
    } else if name == "GRS-80" {
        Some((6378.137, 6356.7523141, 1.0 / 298.257222101))
    } else if name == "Airy (1830)" {
        Some((6377.563396, 6356.256909, 1.0 / 299.3249646))
    } else if name == "Intl 1924" {
        Some((6378.388, 6356.911946, 1.0 / 297.0))
    } else if name == "Clarke (1880)" {
        Some((6378.249145, 6356.51486955, 1.0 / 293.465))
    } else if name == "GRS-67" {
        Some((6378.1600, 6356.774719, 1.0 / 298.25))
    } else {
        None
    }
}

// kind: 0 Distance, 1 great_circle, 2 geodesic
struct Dist {
    kind: i64,
    km: f64,
    radius: f64,
    ell: (f64, f64, f64),
}

fn kind_name(kind: i64) -> String {
    if kind == 1 {
        "great_circle".to_string()
    } else if kind == 2 {
        "geodesic".to_string()
    } else {
        "Distance".to_string()
    }
}

// self.__class__(km): the class's default radius or ellipsoid.
fn dist_of(kind: i64, km: f64) -> Dist {
    Dist { kind: kind, km: 0.0 + km + 0.0, radius: EARTH_RADIUS, ell: ellipsoid_named("WGS-84".to_string()).unwrap_or((0.0, 0.0, 0.0)) }
}

fn ensure_same_altitude(a: ref Point, b: ref Point) -> Result[(), Exc] {
    if (a.altitude - b.altitude).abs() > 0.000001 {
        return Err(value_error("Calculating distance between points with different altitudes is not supported".to_string()));
    }
    Ok(())
}

fn geod_for(d: ref Dist) -> Result[Geod, Exc] {
    let (a, _, f) = d.ell;
    match new_geod(a, f) {
        Ok(g) => Ok(g),
        Err(e) => Err(value_error(e)),
    }
}

fn measure(rx: ref Program, d: ref Dist, a0: ref Val, b0: ref Val) -> Result[f64, Exc] {
    if d.kind == 0 {
        return Err(exc("NotImplementedError", "Distance is an abstract class".to_string()));
    }
    let a = new_point(rx, a0, Val.Nothing, Val.Nothing)?;
    let b = new_point(rx, b0, Val.Nothing, Val.Nothing)?;
    ensure_same_altitude(a, b)?;
    if d.kind == 1 {
        let lat1 = u_radians(a.latitude, 0.0, 0.0);
        let lng1 = u_radians(a.longitude, 0.0, 0.0);
        let lat2 = u_radians(b.latitude, 0.0, 0.0);
        let lng2 = u_radians(b.longitude, 0.0, 0.0);
        let sin_lat1 = lat1.sin();
        let cos_lat1 = lat1.cos();
        let sin_lat2 = lat2.sin();
        let cos_lat2 = lat2.cos();
        let delta_lng = lng2 - lng1;
        let cos_delta_lng = delta_lng.cos();
        let sin_delta_lng = delta_lng.sin();
        let y = ((cos_lat2 * sin_delta_lng).pow(2.0) + (cos_lat1 * sin_lat2 - sin_lat1 * cos_lat2 * cos_delta_lng).pow(2.0)).sqrt();
        let x = sin_lat1 * sin_lat2 + cos_lat1 * cos_lat2 * cos_delta_lng;
        return Ok(d.radius * y.atan2(x));
    }
    let g = geod_for(d)?;
    let r = gen_inverse(g, a.latitude, a.longitude, b.latitude, b.longitude, DISTANCE);
    Ok(r.s12)
}

// A distance class built as the job's call builds it: points, a plain
// number, and keyword arguments.
fn build_dist(rx: ref Program, kind: i64, args: ref Vec[Val], kws: ref Vec[(String, String)]) -> Result[Dist, Exc] {
    let mut d = dist_of(kind, 0.0);
    let mut rest: Vec[(String, f64)] = Vec.new();
    let mut kilometers = 0.0;
    for (key, v) in kws.iter() {
        if key == "radius" and kind == 1 {
            d.radius = float_of(v)?;
        } else if key == "ellipsoid" and kind == 2 {
            if v.contains(",") {
                let parts = split_on(v, ',');
                d.ell = (float_of(parts[0])?, float_of(parts[1])?, float_of(parts[2])?);
            } else {
                d.ell = match ellipsoid_named(v) {
                    Some(e) => e,
                    None => return Err(exc("Exception", "Invalid ellipsoid. See geopy.distance.ELLIPSOIDS".to_string())),
                };
            }
        } else if key == "kilometers" {
            kilometers = float_of(v)?;
        } else {
            rest.push((key.clone(), float_of(v)?));
        }
    }
    if args.len() == 1 {
        kilometers += match args[0] {
            Val.Flt(x) => x,
            _ => return Err(exc("TypeError", "unsupported operand type(s) for +=: 'int' and 'tuple'".to_string())),
        };
    } else if args.len() > 1 {
        let mut k = 0;
        while k + 1 < args.len() {
            kilometers += measure(rx, d, args[k], args[k + 1])?;
            k += 1;
        }
    }
    kilometers += call_unit("kilometers".to_string(), rest)?;
    d.km = kilometers;
    Ok(d)
}

fn dist_repr(d: ref Dist) -> String {
    f"Distance({fmt(d.km)})"
}

fn dist_str(d: ref Dist) -> String {
    f"{fmt(d.km)} km"
}

fn d_m(d: ref Dist) -> f64 {
    u_meters(d.km, 0.0, 0.0, 0.0)
}

fn d_mi(d: ref Dist) -> f64 {
    u_miles(d.km, 0.0, 0.0, 0.0)
}

fn d_ft(d: ref Dist) -> f64 {
    u_feet(d.km, 0.0, 0.0, 0.0)
}

fn d_nm(d: ref Dist) -> f64 {
    u_nautical(d.km, 0.0, 0.0, 0.0)
}

fn destination(rx: ref Program, d: ref Dist, point0: ref Val, bearing0: f64, distance: f64) -> Result[Point, Exc] {
    if d.kind == 0 {
        return Err(exc("NotImplementedError", "Distance is an abstract class".to_string()));
    }
    let point = new_point(rx, point0, Val.Nothing, Val.Nothing)?;
    if d.kind == 1 {
        let lat1 = u_radians(point.latitude, 0.0, 0.0);
        let lng1 = u_radians(point.longitude, 0.0, 0.0);
        let bearing = u_radians(bearing0, 0.0, 0.0);
        let d_div_r = distance / d.radius;
        let lat2 = (lat1.sin() * d_div_r.cos() + lat1.cos() * d_div_r.sin() * bearing.cos()).asin();
        let lng2 = lng1 + (bearing.sin() * d_div_r.sin() * lat1.cos()).atan2(d_div_r.cos() - lat1.sin() * lat2.sin());
        return new_point(rx, Val.Flt(u_degrees(lat2, 0.0, 0.0)), Val.Flt(u_degrees(lng2, 0.0, 0.0)), Val.Nothing);
    }
    let g = geod_for(d)?;
    let p = gen_direct(g, point.latitude, point.longitude, bearing0, false, distance, LATITUDE | LONGITUDE);
    new_point(rx, Val.Flt(p.lat2), Val.Flt(p.lon2), Val.Nothing)
}

// float // float, as CPython's float_floor_div computes it.
fn float_floordiv(vx: f64, wx: f64) -> Result[f64, Exc] {
    if wx == 0.0 {
        return Err(exc("ZeroDivisionError", "float floor division by zero".to_string()));
    }
    let mut md = vx % wx;
    let mut div = (vx - md) / wx;
    if md != 0.0 {
        if (wx < 0.0) != (md < 0.0) {
            md += wx;
            div -= 1.0;
        }
    }
    if div != 0.0 {
        let mut floordiv = div.floor();
        if div - floordiv > 0.5 {
            floordiv += 1.0;
        }
        Ok(floordiv)
    } else {
        Ok(if sign_bit(vx / wx) { neg_zero() } else { 0.0 })
    }
}

fn float_div(a: f64, b: f64) -> Result[f64, Exc] {
    if b == 0.0 {
        return Err(exc("ZeroDivisionError", "float division by zero".to_string()));
    }
    Ok(a / b)
}

// ------------------------------------------------------------ the re engine (from mini_re)

// ------------------------------------------------------------ errors

struct ReErr {
    kind: String,
    msg: String,
    pos: i64,
}

fn re_error(msg: own String, pos: i64) -> ReErr {
    ReErr { kind: "error".to_string(), msg: msg, pos: pos }
}

fn other_error(kind: Str, msg: own String) -> ReErr {
    ReErr { kind: kind.to_string(), msg: msg, pos: -1 }
}

fn err_text(e: ref ReErr) -> String {
    if e.kind == "error" {
        if e.pos >= 0 {
            return f"error: {e.msg} at position {e.pos}";
        }
        return f"error: {e.msg}";
    }
    f"{e.kind}: {e.msg}"
}

// -------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for cp in s {
        if cp < 0x80 {
            out.push(cp as u8);
        } else if cp < 0x800 {
            out.push((0xC0 | (cp >> 6)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else if cp < 0x10000 {
            out.push((0xE0 | (cp >> 12)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (cp >> 18)) as u8);
            out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

fn str_repr(s: ref Vec[i64], out: mut ref Vec[i64]) {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
}

fn repr_of(s: ref Vec[i64]) -> String {
    let mut out: Vec[i64] = Vec.new();
    str_repr(s, mut out);
    to_string(out)
}

// ----------------------------------------------------- character kinds

fn is_decimal(c: i64) -> bool {
    if c < 0x80 {
        return c >= 48 and c <= 57;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return true;
        }
    }
    false
}

fn is_space(c: i64, ascii: bool) -> bool {
    if c == 32 or (c >= 9 and c <= 13) {
        return true;
    }
    if ascii {
        return false;
    }
    (c >= 0x1C and c <= 0x1F) or c == 0x85 or c == 0xA0 or c == 0x1680 or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F or c == 0x3000
}

fn as_char(c: i64) -> Option[char] {
    if c < 0 or (c >= 0xD800 and c <= 0xDFFF) or c > 0x10FFFF {
        return None;
    }
    char.try_from(c as u32).ok()
}

fn is_word(c: i64, ascii: bool) -> bool {
    if c < 0x80 {
        return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
    }
    if ascii {
        return false;
    }
    match as_char(c) {
        Some(ch) => ch.is_alphanumeric(),
        None => false,
    }
}

fn lower(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 65 and c <= 90 { c + 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_lowercase() as u32 as i64,
        None => c,
    }
}

fn upper(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 97 and c <= 122 { c - 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_uppercase() as u32 as i64,
        None => c,
    }
}

// ------------------------------------------------------- parsed form

// The categories of \d \D \s \S \w \W.
fn cat_digit() -> i64 { 0 }
fn cat_not_digit() -> i64 { 1 }
fn cat_space() -> i64 { 2 }
fn cat_not_space() -> i64 { 3 }
fn cat_word() -> i64 { 4 }
fn cat_not_word() -> i64 { 5 }

// The positions ^ $ \A \Z \b \B and the forms the compiler turns them
// into under MULTILINE.
fn at_beginning() -> i64 { 0 }
fn at_beginning_line() -> i64 { 1 }
fn at_beginning_string() -> i64 { 2 }
fn at_end() -> i64 { 3 }
fn at_end_line() -> i64 { 4 }
fn at_end_string() -> i64 { 5 }
fn at_boundary() -> i64 { 6 }
fn at_non_boundary() -> i64 { 7 }

#[derive(Clone)]
enum Item {
    Lit(i64),
    Range(i64, i64),
    Cat(i64),
}

enum Node {
    Lit(i64),
    NotLit(i64),
    Any,
    In(Vec[Item], bool),
    At(i64),
    Branch(Vec[Vec[Node]]),
    // group (0: none), flags turned on, flags turned off, contents
    Group(i64, i64, i64, Vec[Node]),
    // 0 greedy, 1 lazy, 2 possessive; min; max; the item repeated
    Repeat(i64, i64, i64, Vec[Node]),
    Atomic(Vec[Node]),
    // direction (1 ahead, -1 behind), negative, contents
    Assert(i64, bool, Vec[Node]),
    GroupRef(i64),
    // group, yes branch, no branch
    Exists(i64, Vec[Node], Vec[Node]),
    Failure,
}

fn is_repeat(n: ref Node) -> bool {
    match n {
        Node.Repeat(_, _, _, _) => true,
        _ => false,
    }
}

fn is_at(n: ref Node) -> bool {
    match n {
        Node.At(_) => true,
        _ => false,
    }
}

fn flag_i() -> i64 { 2 }
fn flag_l() -> i64 { 4 }
fn flag_m() -> i64 { 8 }
fn flag_s() -> i64 { 16 }
fn flag_u() -> i64 { 32 }
fn flag_x() -> i64 { 64 }
fn flag_a() -> i64 { 256 }
fn type_flags() -> i64 { 4 | 32 | 256 }
fn maxrepeat() -> i64 { 4294967295 }
fn maxgroups() -> i64 { 1073741823 }
fn maxwidth() -> i64 { 1 << 62 }

fn flag_value(c: i64) -> i64 {
    match c {
        105 => 2,
        76 => 4,
        109 => 8,
        115 => 16,
        120 => 64,
        97 => 256,
        117 => 32,
        _ => 0,
    }
}

// ------------------------------------------------------------ tokens

// One token: nothing at the end of the pattern (n 0), a character (n 1),
// or a backslash and the character after it (n 2).
#[derive(Copy, Clone)]
struct T {
    n: i64,
    a: i64,
    b: i64,
}

fn tok_none() -> T {
    T { n: 0, a: 0, b: 0 }
}

fn tok_is(t: T, c: i64) -> bool {
    t.n == 1 and t.a == c
}

fn tok_text(t: T) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    if t.n >= 1 {
        v.push(t.a);
    }
    if t.n == 2 {
        v.push(t.b);
    }
    v
}

fn is_ascii_letter(c: i64) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

fn is_hex(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

fn is_oct(c: i64) -> bool {
    c >= 48 and c <= 55
}

fn is_dec(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn digits_value(s: ref Vec[i64], start: i64, base: i64) -> i64 {
    let mut v = 0;
    let mut i = start;
    while i < s.len() {
        let c = s[i];
        let d = if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 };
        v = v * base + d;
        i += 1;
    }
    v
}

// str.isidentifier, near enough: a letter or underscore, then letters,
// digits and underscores.
fn is_identifier(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    let mut i = 0;
    while i < name.len() {
        let c = name[i];
        let ok = if c == 95 {
            true
        } else if i == 0 {
            match as_char(c) {
                Some(ch) => ch.is_alphabetic(),
                None => false,
            }
        } else {
            is_word(c, false)
        };
        if not ok {
            return false;
        }
        i += 1;
    }
    true
}

fn is_ascii_decimal(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    for c in name {
        if not is_dec(c) {
            return false;
        }
    }
    true
}

struct Tokenizer {
    s: Vec[i64],
    index: i64,
    next: T,
}

impl Tokenizer {
    fn advance(mut ref self) -> Result[(), ReErr] {
        let index = self.index;
        if index >= self.s.len() {
            self.next = tok_none();
            return Ok(());
        }
        let c = self.s[index];
        if c == 92 {
            if index + 1 >= self.s.len() {
                return Err(re_error("bad escape (end of pattern)".to_string(), self.s.len() - 1));
            }
            self.next = T { n: 2, a: 92, b: self.s[index + 1] };
            self.index = index + 2;
        } else {
            self.next = T { n: 1, a: c, b: 0 };
            self.index = index + 1;
        }
        Ok(())
    }

    fn get(mut ref self) -> Result[T, ReErr] {
        let t = self.next;
        self.advance()?;
        Ok(t)
    }

    fn take(mut ref self, c: i64) -> Result[bool, ReErr] {
        if tok_is(self.next, c) {
            self.advance()?;
            return Ok(true);
        }
        Ok(false)
    }

    fn tell(ref self) -> i64 {
        self.index - self.next.n
    }

    fn seek(mut ref self, index: i64) -> Result[(), ReErr] {
        self.index = index;
        self.advance()
    }

    fn error(ref self, msg: own String, offset: i64) -> ReErr {
        re_error(msg, self.tell() - offset)
    }

    // getwhile: up to n characters of a kind (0 octal, 1 decimal, 2 hex).
    fn getwhile(mut ref self, n: i64, kind: i64, out: mut ref Vec[i64]) -> Result[(), ReErr] {
        let mut k = 0;
        while k < n {
            let t = self.next;
            if t.n != 1 {
                break;
            }
            let ok = if kind == 0 { is_oct(t.a) } else if kind == 1 { is_dec(t.a) } else { is_hex(t.a) };
            if not ok {
                break;
            }
            out.push(t.a);
            self.advance()?;
            k += 1;
        }
        Ok(())
    }

    fn getuntil(mut ref self, terminator: i64, name: Str) -> Result[Vec[i64], ReErr] {
        let mut result: Vec[i64] = Vec.new();
        loop {
            let c = self.next;
            self.advance()?;
            if c.n == 0 {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 0));
                }
                let term = to_string(vec_of(terminator));
                return Err(self.error(f"missing {term}, unterminated name", result.len()));
            }
            if tok_is(c, terminator) {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 1));
                }
                break;
            }
            push_all(mut result, tok_text(c));
        }
        Ok(result)
    }

    fn checkgroupname(ref self, name: ref Vec[i64], offset: i64) -> Result[(), ReErr] {
        if not is_identifier(name) {
            return Err(self.error(f"bad character in group name {repr_of(name)}", name.len() + offset));
        }
        Ok(())
    }
}

fn vec_of(c: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(c);
    v
}

fn new_tokenizer(s: ref Vec[i64]) -> Result[Tokenizer, ReErr] {
    let mut t = Tokenizer { s: s.clone(), index: 0, next: tok_none() };
    t.advance()?;
    Ok(t)
}

// ------------------------------------------------------------ parser

#[derive(Clone)]
struct Width {
    lo: i64,
    hi: i64,
}

struct ParseState {
    flags: i64,
    names: Vec[(Vec[i64], i64)],
    // per group: whether it is closed, and its width
    closed: Vec[bool],
    widths: Vec[Width],
    lookbehind_groups: i64,
    // conditional references by number, in order: (group, position)
    refpos: Vec[(i64, i64)],
}

impl ParseState {
    fn groups(ref self) -> i64 {
        self.closed.len()
    }

    fn group_of(ref self, name: ref Vec[i64]) -> i64 {
        for (n, g) in self.names.iter() {
            if same(n, name) {
                return *g;
            }
        }
        -1
    }

    fn checkgroup(ref self, gid: i64) -> bool {
        gid < self.groups() and self.closed[gid]
    }

    fn checklookbehindgroup(ref self, gid: i64, src: ref Tokenizer) -> Result[(), ReErr] {
        if self.lookbehind_groups >= 0 {
            if not self.checkgroup(gid) {
                return Err(src.error("cannot refer to an open group".to_string(), 0));
            }
            if gid >= self.lookbehind_groups {
                return Err(src.error("cannot refer to group defined in the same lookbehind subpattern".to_string(), 0));
            }
        }
        Ok(())
    }
}

fn add_width(a: i64, b: i64) -> i64 {
    if a >= maxwidth() - b { maxwidth() } else { a + b }
}

fn mul_width(a: i64, n: i64) -> i64 {
    if a == 0 or n == 0 {
        0
    } else if a >= maxwidth() / n {
        maxwidth()
    } else {
        a * n
    }
}

// SubPattern.getwidth.
fn width_of(widths: ref Vec[Width], p: ref Vec[Node]) -> Width {
    let mut lo = 0;
    let mut hi = 0;
    for n in p.iter() {
        match n {
            Node.Branch(items) => {
                let mut i = maxwidth();
                let mut j = 0;
                for item in items.iter() {
                    let w = width_of(widths, item);
                    if w.lo < i {
                        i = w.lo;
                    }
                    if w.hi > j {
                        j = w.hi;
                    }
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Atomic(body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Group(_, _, _, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Repeat(_, min, max, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, mul_width(w.lo, *min));
                if *max == maxrepeat() and w.hi > 0 {
                    hi = maxwidth();
                } else {
                    hi = add_width(hi, mul_width(w.hi, *max));
                }
            }
            Node.GroupRef(g) => {
                let w = ref widths[*g];
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Exists(_, yes, no) => {
                let wy = width_of(widths, yes);
                let mut i = wy.lo;
                let mut j = wy.hi;
                if no.len() > 0 {
                    let wn = width_of(widths, no);
                    if wn.lo < i {
                        i = wn.lo;
                    }
                    if wn.hi > j {
                        j = wn.hi;
                    }
                } else {
                    i = 0;
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Lit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.NotLit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.Any => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.In(_, _) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            _ => {}
        }
    }
    Width { lo: lo, hi: hi }
}

fn category_of(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        100 => 0,
        68 => 1,
        115 => 2,
        83 => 3,
        119 => 4,
        87 => 5,
        _ => -1,
    }
}

fn escape_value(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        97 => 7,
        98 => 8,
        102 => 12,
        110 => 10,
        114 => 13,
        116 => 9,
        118 => 11,
        92 => 92,
        _ => -1,
    }
}

// \x, \u and \U: the escape text so far, and the code point.
fn hex_escape(src: mut ref Tokenizer, t: T, esc: mut ref Vec[i64]) -> Result[i64, ReErr] {
    let n = if t.b == 120 { 2 } else if t.b == 117 { 4 } else { 8 };
    src.getwhile(n, 2, mut esc)?;
    if esc.len() != n + 2 {
        return Err(src.error(f"incomplete escape {to_string(esc)}", esc.len()));
    }
    let c = digits_value(esc, 2, 16);
    if c > 0x10FFFF {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(c)
}

// _class_escape: an escape inside [...], a literal or a category.
fn class_escape(src: mut ref Tokenizer, t: T) -> Result[Item, ReErr] {
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Item.Lit(e));
    }
    let cat = category_of(t);
    if cat >= 0 {
        return Ok(Item.Cat(cat));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Item.Lit(v));
    }
    if is_oct(c) {
        src.getwhile(2, 0, mut esc)?;
        let v = digits_value(esc, 1, 8);
        if v > 0o377 {
            return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
        }
        return Ok(Item.Lit(v));
    }
    if is_dec(c) or is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Item.Lit(c))
}

// _escape: an escape outside a set.
fn escape(src: mut ref Tokenizer, t: T, st: ref ParseState) -> Result[Node, ReErr] {
    let cat = category_of(t);
    if cat >= 0 {
        let mut items: Vec[Item] = Vec.new();
        items.push(Item.Cat(cat));
        return Ok(Node.In(items, false));
    }
    match t.b {
        65 => return Ok(Node.At(at_beginning_string())),
        98 => return Ok(Node.At(at_boundary())),
        66 => return Ok(Node.At(at_non_boundary())),
        90 => return Ok(Node.At(at_end_string())),
        _ => {}
    }
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Node.Lit(e));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Node.Lit(v));
    }
    if c == 48 {
        src.getwhile(2, 0, mut esc)?;
        return Ok(Node.Lit(digits_value(esc, 1, 8)));
    }
    if is_dec(c) {
        // an octal escape or a group reference
        let nt = src.next;
        if nt.n == 1 and is_dec(nt.a) {
            esc.push(nt.a);
            src.advance()?;
            let nt2 = src.next;
            if is_oct(esc[1]) and is_oct(esc[2]) and nt2.n == 1 and is_oct(nt2.a) {
                esc.push(nt2.a);
                src.advance()?;
                let v = digits_value(esc, 1, 8);
                if v > 0o377 {
                    return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
                }
                return Ok(Node.Lit(v));
            }
        }
        let group = digits_value(esc, 1, 10);
        if group < st.groups() {
            if not st.checkgroup(group) {
                return Err(src.error("cannot refer to an open group".to_string(), esc.len()));
            }
            st.checklookbehindgroup(group, src)?;
            return Ok(Node.GroupRef(group));
        }
        return Err(src.error(f"invalid group reference {group}", esc.len() - 1));
    }
    if is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Node.Lit(c))
}

fn parse_sub(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64) -> Result[Vec[Node], ReErr] {
    let mut items: Vec[Vec[Node]] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let first = nested == 0 and items.len() == 0;
        let item = parse_seq(mut src, mut st, verbose, nested + 1, first)?;
        items.push(item);
        if not src.take(124)? {
            break;
        }
        if nested == 0 {
            verbose = (st.flags & flag_x()) != 0;
        }
    }
    if items.len() == 1 {
        return Ok(items.pop().unwrap());
    }
    let mut out: Vec[Node] = Vec.new();
    out.push(Node.Branch(items));
    Ok(out)
}

// _parse_flags: None (as Err-free Ok(None)) for global flags, else the
// flags turned on and off.
fn parse_flags(src: mut ref Tokenizer, st: mut ref ParseState, first_char: T) -> Result[Option[(i64, i64)], ReErr] {
    let mut ch = first_char;
    let mut add = 0;
    let mut del = 0;
    if not tok_is(ch, 45) {
        loop {
            let flag = flag_value(ch.a);
            if ch.a == 76 {
                return Err(src.error("bad inline flags: cannot use 'L' flag with a str pattern".to_string(), 0));
            }
            add = add | flag;
            if (flag & type_flags()) != 0 and (add & type_flags()) != flag {
                return Err(src.error("bad inline flags: flags 'a', 'u' and 'L' are incompatible".to_string(), 0));
            }
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing -, : or )".to_string(), 0));
            }
            if tok_is(ch, 41) or tok_is(ch, 45) or tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing -, : or )" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if tok_is(ch, 41) {
        st.flags = st.flags | add;
        return Ok(None);
    }
    if tok_is(ch, 45) {
        ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("missing flag".to_string(), 0));
        }
        if ch.n != 1 or flag_value(ch.a) == 0 {
            let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing flag" };
            return Err(src.error(msg.to_string(), ch.n));
        }
        loop {
            let flag = flag_value(ch.a);
            if (flag & type_flags()) != 0 {
                return Err(src.error("bad inline flags: cannot turn off flags 'a', 'u' and 'L'".to_string(), 0));
            }
            del = del | flag;
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing :".to_string(), 0));
            }
            if tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing :" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if (add & del) != 0 {
        return Err(src.error("bad inline flags: flag turned on and off".to_string(), 1));
    }
    Ok(Some((add, del)))
}

fn is_alpha(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

fn parse_set(src: mut ref Tokenizer, out: mut ref Vec[Node]) -> Result[(), ReErr] {
    let here = src.tell() - 1;
    let mut set: Vec[Item] = Vec.new();
    let negate = src.take(94)?;
    loop {
        let this = src.get()?;
        if this.n == 0 {
            return Err(src.error("unterminated character set".to_string(), src.tell() - here));
        }
        if tok_is(this, 93) and set.len() > 0 {
            break;
        }
        let code1 = if this.n == 2 { class_escape(mut src, this)? } else { Item.Lit(this.a) };
        if src.take(45)? {
            let that = src.get()?;
            if that.n == 0 {
                return Err(src.error("unterminated character set".to_string(), src.tell() - here));
            }
            if tok_is(that, 93) {
                set.push(code1);
                set.push(Item.Lit(45));
                break;
            }
            let code2 = if that.n == 2 { class_escape(mut src, that)? } else { Item.Lit(that.a) };
            let text = f"{to_string(tok_text(this))}-{to_string(tok_text(that))}";
            let offset = this.n + 1 + that.n;
            let lo = match code1 {
                Item.Lit(c) => c,
                _ => -1,
            };
            let hi = match code2 {
                Item.Lit(c) => c,
                _ => -1,
            };
            if lo < 0 or hi < 0 or hi < lo {
                return Err(src.error(f"bad character range {text}", offset));
            }
            set.push(Item.Range(lo, hi));
        } else {
            set.push(code1);
        }
    }
    if set.len() == 1 {
        let only = ref set[0];
        if let Item.Lit(c) = only {
            if negate {
                out.push(Node.NotLit(*c));
            } else {
                out.push(Node.Lit(*c));
            }
            return Ok(());
        }
    }
    out.push(Node.In(set, negate));
    Ok(())
}

// The quantifier just read (its first character is `this`), applied to
// the last item. Returns false when `{` turned out to be a literal.
fn parse_repeat(src: mut ref Tokenizer, this: T, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let here = src.tell();
    let mut min = 0;
    let mut max = maxrepeat();
    if tok_is(this, 63) {
        max = 1;
    } else if tok_is(this, 43) {
        min = 1;
    } else if tok_is(this, 123) {
        if tok_is(src.next, 125) {
            out.push(Node.Lit(123));
            return Ok(false);
        }
        let mut lo: Vec[i64] = Vec.new();
        let mut hi: Vec[i64] = Vec.new();
        while src.next.n == 1 and is_dec(src.next.a) {
            lo.push(src.get()?.a);
        }
        if src.take(44)? {
            while src.next.n == 1 and is_dec(src.next.a) {
                hi.push(src.get()?.a);
            }
        } else {
            hi = lo.clone();
        }
        if not src.take(125)? {
            out.push(Node.Lit(123));
            src.seek(here)?;
            return Ok(false);
        }
        if lo.len() > 0 {
            if lo.len() > 10 or digits_value(lo, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            min = digits_value(lo, 0, 10);
        }
        if hi.len() > 0 {
            if hi.len() > 10 or digits_value(hi, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            max = digits_value(hi, 0, 10);
            if max < min {
                return Err(src.error("min repeat greater than max repeat".to_string(), src.tell() - here));
            }
        }
    }
    if out.len() == 0 or is_at(out[out.len() - 1]) {
        return Err(src.error("nothing to repeat".to_string(), src.tell() - here + 1));
    }
    if is_repeat(out[out.len() - 1]) {
        return Err(src.error("multiple repeat".to_string(), src.tell() - here + 1));
    }
    let last = out.pop().unwrap();
    let mut body: Vec[Node] = Vec.new();
    match last {
        Node.Group(0, 0, 0, p) => body = p,
        other => body.push(other),
    }
    let kind = if src.take(63)? { 1 } else if src.take(43)? { 2 } else { 0 };
    out.push(Node.Repeat(kind, min, max, body));
    Ok(true)
}

fn parse_seq(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64, first: bool) -> Result[Vec[Node], ReErr] {
    let mut out: Vec[Node] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let this = src.next;
        if this.n == 0 or tok_is(this, 124) or tok_is(this, 41) {
            break;
        }
        src.advance()?;
        if verbose {
            if this.n == 1 and (this.a == 32 or (this.a >= 9 and this.a <= 13)) {
                continue;
            }
            if tok_is(this, 35) {
                loop {
                    let t = src.get()?;
                    if t.n == 0 or tok_is(t, 10) {
                        break;
                    }
                }
                continue;
            }
        }
        if this.n == 2 {
            let node = escape(mut src, this, st)?;
            out.push(node);
            continue;
        }
        let c = this.a;
        if c == 91 {
            parse_set(mut src, mut out)?;
        } else if c == 42 or c == 43 or c == 63 or c == 123 {
            parse_repeat(mut src, this, mut out)?;
        } else if c == 46 {
            out.push(Node.Any);
        } else if c == 94 {
            out.push(Node.At(at_beginning()));
        } else if c == 36 {
            out.push(Node.At(at_end()));
        } else if c == 40 {
            if parse_group(mut src, mut st, mut verbose, nested, first, mut out)? {
                continue;
            }
        } else {
            out.push(Node.Lit(c));
        }
    }
    Ok(out)
}

// `(` and what follows. Returns true for a construct that adds nothing
// (a comment, global flags).
fn parse_group(src: mut ref Tokenizer, st: mut ref ParseState, verbose: mut ref bool, nested: i64, first: bool, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let start = src.tell() - 1;
    let mut capture = true;
    let mut atomic = false;
    let mut name: Vec[i64] = Vec.new();
    let mut named = false;
    let mut add = 0;
    let mut del = 0;
    if src.take(63)? {
        let ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("unexpected end of pattern".to_string(), 0));
        }
        if tok_is(ch, 80) {
            if src.take(60)? {
                name = src.getuntil(62, "group name")?;
                src.checkgroupname(name, 1)?;
                named = true;
            } else if src.take(61)? {
                let ref_name = src.getuntil(41, "group name")?;
                src.checkgroupname(ref_name, 1)?;
                let gid = st.group_of(ref_name);
                if gid < 0 {
                    return Err(src.error(f"unknown group name {repr_of(ref_name)}", ref_name.len() + 1));
                }
                if not st.checkgroup(gid) {
                    return Err(src.error("cannot refer to an open group".to_string(), ref_name.len() + 1));
                }
                st.checklookbehindgroup(gid, src)?;
                out.push(Node.GroupRef(gid));
                return Ok(true);
            } else {
                let c2 = src.get()?;
                if c2.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                return Err(src.error(f"unknown extension ?P{to_string(tok_text(c2))}", c2.n + 2));
            }
        } else if tok_is(ch, 58) {
            capture = false;
        } else if tok_is(ch, 35) {
            loop {
                if src.next.n == 0 {
                    return Err(src.error("missing ), unterminated comment".to_string(), src.tell() - start));
                }
                if tok_is(src.get()?, 41) {
                    break;
                }
            }
            return Ok(true);
        } else if tok_is(ch, 61) or tok_is(ch, 33) or tok_is(ch, 60) {
            let mut kind = ch;
            let mut dir = 1;
            let mut outer_lookbehind = 0;
            if tok_is(ch, 60) {
                kind = src.get()?;
                if kind.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                if not (tok_is(kind, 61) or tok_is(kind, 33)) {
                    return Err(src.error(f"unknown extension ?<{to_string(tok_text(kind))}", kind.n + 2));
                }
                dir = -1;
                outer_lookbehind = st.lookbehind_groups;
                if outer_lookbehind < 0 {
                    st.lookbehind_groups = st.groups();
                }
            }
            let p = parse_sub(mut src, mut st, *verbose, nested + 1)?;
            if dir < 0 and outer_lookbehind < 0 {
                st.lookbehind_groups = -1;
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            if tok_is(kind, 61) {
                out.push(Node.Assert(dir, false, p));
            } else if p.len() > 0 {
                out.push(Node.Assert(dir, true, p));
            } else {
                out.push(Node.Failure);
            }
            return Ok(true);
        } else if tok_is(ch, 40) {
            let condname = src.getuntil(41, "group name")?;
            let mut condgroup = 0;
            if not is_ascii_decimal(condname) {
                src.checkgroupname(condname, 1)?;
                condgroup = st.group_of(condname);
                if condgroup < 0 {
                    return Err(src.error(f"unknown group name {repr_of(condname)}", condname.len() + 1));
                }
            } else {
                if condname.len() > 10 {
                    return Err(src.error(f"invalid group reference {to_string(condname)}", condname.len() + 1));
                }
                condgroup = digits_value(condname, 0, 10);
                if condgroup == 0 {
                    return Err(src.error("bad group number".to_string(), condname.len() + 1));
                }
                if condgroup >= maxgroups() {
                    return Err(src.error(f"invalid group reference {condgroup}", condname.len() + 1));
                }
                let mut seen = false;
                for (g, _) in st.refpos.iter() {
                    if *g == condgroup {
                        seen = true;
                    }
                }
                if not seen {
                    st.refpos.push((condgroup, src.tell() - condname.len() - 1));
                }
            }
            st.checklookbehindgroup(condgroup, src)?;
            let yes = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
            let mut no: Vec[Node] = Vec.new();
            if src.take(124)? {
                no = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
                if tok_is(src.next, 124) {
                    return Err(src.error("conditional backref with more than two branches".to_string(), 0));
                }
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            out.push(Node.Exists(condgroup, yes, no));
            return Ok(true);
        } else if tok_is(ch, 62) {
            capture = false;
            atomic = true;
        } else if (ch.n == 1 and flag_value(ch.a) != 0) or tok_is(ch, 45) {
            match parse_flags(mut src, mut st, ch)? {
                None => {
                    if not first or out.len() > 0 {
                        return Err(src.error("global flags not at the start of the expression".to_string(), src.tell() - start));
                    }
                    *verbose = (st.flags & flag_x()) != 0;
                    return Ok(true);
                }
                Some((a, d)) => {
                    add = a;
                    del = d;
                    capture = false;
                }
            }
        } else {
            return Err(src.error(f"unknown extension ?{to_string(tok_text(ch))}", ch.n + 1));
        }
    }
    let mut group = 0;
    if capture {
        group = st.groups();
        st.closed.push(false);
        st.widths.push(Width { lo: 0, hi: 0 });
        if named {
            let was = st.group_of(name);
            if was >= 0 {
                return Err(src.error(f"redefinition of group name {repr_of(name)} as group {group}; was group {was}", name.len() + 1));
            }
            st.names.push((name.clone(), group));
        }
    }
    let sub_verbose = (*verbose or (add & flag_x()) != 0) and (del & flag_x()) == 0;
    let p = parse_sub(mut src, mut st, sub_verbose, nested + 1)?;
    if not src.take(41)? {
        return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
    }
    if group > 0 {
        let w = width_of(st.widths, p);
        st.widths[group] = w;
        st.closed[group] = true;
    }
    if atomic {
        out.push(Node.Atomic(p));
    } else {
        out.push(Node.Group(group, add, del, p));
    }
    Ok(false)
}

struct Parsed {
    nodes: Vec[Node],
    flags: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
    widths: Vec[Width],
}

fn parse(pattern: ref Vec[i64], flags: i64) -> Result[Parsed, ReErr] {
    let mut src = new_tokenizer(pattern)?;
    let mut st = ParseState {
        flags: flags,
        names: Vec.new(),
        closed: Vec.new(),
        widths: Vec.new(),
        lookbehind_groups: -1,
        refpos: Vec.new(),
    };
    // group 0 is the whole match
    st.closed.push(true);
    st.widths.push(Width { lo: 0, hi: 0 });
    let nodes = parse_sub(mut src, mut st, (flags & flag_x()) != 0, 0)?;
    if (st.flags & flag_a()) != 0 and (st.flags & flag_u()) != 0 {
        return Err(other_error("ValueError", "ASCII and UNICODE flags are incompatible".to_string()));
    }
    if src.next.n != 0 {
        return Err(src.error("unbalanced parenthesis".to_string(), 0));
    }
    for (g, pos) in st.refpos.iter() {
        if *g >= st.groups() {
            return Err(re_error(f"invalid group reference {*g}", *pos));
        }
    }
    let groups = st.groups() - 1;
    Ok(Parsed { nodes: nodes, flags: st.flags, groups: groups, names: st.names, widths: st.widths })
}

// ---------------------------------------------------------- compiler

enum Op {
    // character (lowered when case-insensitive), case-insensitive, ASCII
    Lit(i64, bool, bool),
    NotLit(i64, bool, bool),
    Any,
    AnyAll,
    // set, case-insensitive, ASCII-only categories
    In(i64, bool, bool),
    // anchor kind, ASCII-only word boundary
    At(i64, bool),
    Mark(i64),
    Split(i64, i64),
    Jmp(i64),
    // repeat register, the Until it starts at
    RepInit(i64, i64),
    // register, min, max, greedy, body, exit
    Until(i64, i64, i64, bool, i64, i64),
    Ref(i64, bool, bool),
    // lookbehind width (-1 for lookahead), negative, sub-program, next
    Look(i64, bool, i64, i64),
    Atomic(i64, i64),
    Exists(i64, i64),
    Fail,
    Succeed,
    Match,
}

struct Program {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
}

struct CharSet {
    items: Vec[Item],
    negate: bool,
}

fn combine(flags: i64, add: i64, del: i64) -> i64 {
    let mut f = flags;
    if (add & type_flags()) != 0 {
        f = f & (0x7FFFFFFF ^ type_flags());
    }
    (f | add) & (0x7FFFFFFF ^ del)
}

struct Compiler {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
}

impl Compiler {
    fn emit(mut ref self, op: own Op) -> i64 {
        self.ops.push(op);
        self.ops.len() - 1
    }

    fn here(ref self) -> i64 {
        self.ops.len()
    }

    fn compile(mut ref self, p: ref Parsed, nodes: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let icase = (flags & flag_i()) != 0;
        let ascii = (flags & flag_a()) != 0;
        for n in nodes.iter() {
            match n {
                Node.Lit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.Lit(v, icase, ascii));
                }
                Node.NotLit(c) => {
                    let v = if icase { lower(*c, ascii) } else { *c };
                    self.emit(Op.NotLit(v, icase, ascii));
                }
                Node.Any => {
                    if (flags & flag_s()) != 0 {
                        self.emit(Op.AnyAll);
                    } else {
                        self.emit(Op.Any);
                    }
                }
                Node.In(items, negate) => {
                    self.sets.push(CharSet { items: items.clone(), negate: *negate });
                    let idx = self.sets.len() - 1;
                    self.emit(Op.In(idx, icase, ascii));
                }
                Node.At(kind) => {
                    let mut k = *kind;
                    if (flags & flag_m()) != 0 {
                        if k == at_beginning() {
                            k = at_beginning_line();
                        } else if k == at_end() {
                            k = at_end_line();
                        }
                    }
                    self.emit(Op.At(k, ascii));
                }
                Node.Branch(items) => {
                    let mut ends: Vec[i64] = Vec.new();
                    let mut i = 0;
                    while i < items.len() {
                        if i + 1 < items.len() {
                            let split = self.emit(Op.Fail);
                            self.compile(p, items[i], flags)?;
                            ends.push(self.emit(Op.Fail));
                            let next = self.here();
                            self.ops[split] = Op.Split(split + 1, next);
                        } else {
                            self.compile(p, items[i], flags)?;
                        }
                        i += 1;
                    }
                    let end = self.here();
                    for at in ends {
                        self.ops[at] = Op.Jmp(end);
                    }
                }
                Node.Group(g, add, off, body) => {
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g));
                    }
                    self.compile(p, body, combine(flags, *add, *off))?;
                    if *g > 0 {
                        self.emit(Op.Mark(2 * *g + 1));
                    }
                }
                Node.Repeat(kind, min, max, body) => {
                    if *kind == 2 {
                        let at = self.emit(Op.Fail);
                        self.compile_repeat(p, *min, *max, true, body, flags)?;
                        self.emit(Op.Succeed);
                        let next = self.here();
                        self.ops[at] = Op.Atomic(at + 1, next);
                    } else {
                        self.compile_repeat(p, *min, *max, *kind == 0, body, flags)?;
                    }
                }
                Node.Atomic(body) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Atomic(at + 1, next);
                }
                Node.Assert(dir, negative, body) => {
                    let mut width = -1;
                    if *dir < 0 {
                        let w = width_of(p.widths, body);
                        if w.lo != w.hi {
                            return Err(other_error("error", "look-behind requires fixed-width pattern".to_string()));
                        }
                        width = w.lo;
                    }
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Look(width, *negative, at + 1, next);
                }
                Node.GroupRef(g) => {
                    self.emit(Op.Ref(*g, icase, ascii));
                }
                Node.Exists(g, yes, no) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, yes, flags)?;
                    if no.len() > 0 {
                        let jump = self.emit(Op.Fail);
                        let no_pc = self.here();
                        self.compile(p, no, flags)?;
                        let end = self.here();
                        self.ops[jump] = Op.Jmp(end);
                        self.ops[at] = Op.Exists(*g, no_pc);
                    } else {
                        let end = self.here();
                        self.ops[at] = Op.Exists(*g, end);
                    }
                }
                Node.Failure => {
                    self.emit(Op.Fail);
                }
            }
        }
        Ok(())
    }

    fn compile_repeat(mut ref self, p: ref Parsed, min: i64, max: i64, greedy: bool, body: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let r = self.repeats;
        self.repeats += 1;
        let init = self.emit(Op.Fail);
        self.compile(p, body, flags)?;
        let until = self.emit(Op.Fail);
        self.ops[init] = Op.RepInit(r, until);
        self.ops[until] = Op.Until(r, min, max, greedy, init + 1, until + 1);
        Ok(())
    }
}

fn compile(pattern: ref Vec[i64], flags: i64) -> Result[Program, ReErr] {
    let p = parse(pattern, flags)?;
    let mut c = Compiler { ops: Vec.new(), sets: Vec.new(), repeats: 0 };
    c.compile(p, p.nodes, p.flags)?;
    c.emit(Op.Match);
    Ok(Program { ops: c.ops, sets: c.sets, repeats: c.repeats, groups: p.groups, names: p.names })
}

// ----------------------------------------------------------- matcher

struct Undo {
    kind: i64,
    idx: i64,
    old: i64,
}

struct Choice {
    pc: i64,
    pos: i64,
    trail: i64,
    // 0: resume at pc; 1: a lazy repeat's Until, after its tail failed
    mode: i64,
}

struct Matcher {
    s: Vec[i64],
    marks: Vec[i64],
    counts: Vec[i64],
    lasts: Vec[i64],
    lastindex: i64,
    trail: Vec[Undo],
    start: i64,
    must_advance: bool,
    match_all: bool,
}

impl Matcher {
    fn set_mark(mut ref self, slot: i64, v: i64) {
        self.trail.push(Undo { kind: 0, idx: slot, old: self.marks[slot] });
        self.marks[slot] = v;
    }

    fn set_count(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 1, idx: r, old: self.counts[r] });
        self.counts[r] = v;
    }

    fn set_last(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 2, idx: r, old: self.lasts[r] });
        self.lasts[r] = v;
    }

    fn set_lastindex(mut ref self, v: i64) {
        self.trail.push(Undo { kind: 3, idx: 0, old: self.lastindex });
        self.lastindex = v;
    }

    fn undo_to(mut ref self, len: i64) {
        while self.trail.len() > len {
            let u = self.trail.pop().unwrap();
            if u.kind == 0 {
                self.marks[u.idx] = u.old;
            } else if u.kind == 1 {
                self.counts[u.idx] = u.old;
            } else if u.kind == 2 {
                self.lasts[u.idx] = u.old;
            } else {
                self.lastindex = u.old;
            }
        }
    }

    // A group that has both marks, the end not before the start.
    fn group_span(ref self, g: i64) -> (i64, i64) {
        let a = self.marks[2 * g];
        let b = self.marks[2 * g + 1];
        if a < 0 or b < 0 or b < a {
            return (-1, -1);
        }
        (a, b)
    }

    fn at(ref self, kind: i64, ascii: bool, pos: i64) -> bool {
        let n = self.s.len();
        if kind == 0 or kind == 2 {
            return pos == 0;
        }
        if kind == 1 {
            return pos == 0 or self.s[pos - 1] == 10;
        }
        if kind == 3 {
            return pos == n or (pos == n - 1 and self.s[pos] == 10);
        }
        if kind == 4 {
            return pos == n or self.s[pos] == 10;
        }
        if kind == 5 {
            return pos == n;
        }
        if n == 0 {
            return false;
        }
        let before = pos > 0 and is_word(self.s[pos - 1], ascii);
        let after = pos < n and is_word(self.s[pos], ascii);
        if kind == 6 { before != after } else { before == after }
    }

    // Runs the program from pc at pos, backtracking through its own
    // choices only. Returns where it succeeded, or -1.
    fn run(mut ref self, prog: ref Program, pc0: i64, pos0: i64, top: bool) -> i64 {
        let base = self.trail.len();
        let mut choices: Vec[Choice] = Vec.new();
        let mut pc = pc0;
        let mut pos = pos0;
        let mut mode = 0;
        loop {
            let mut ok = true;
            let op = ref prog.ops[pc];
            if mode == 1 {
                // a lazy repeat whose tail failed: try one more item
                mode = 0;
                ok = false;
                if let Op.Until(r, _, max, _, body, _) = op {
                    let count = self.counts[*r] + 1;
                    if not ((count >= *max and *max != maxrepeat()) or pos == self.lasts[*r]) {
                        self.set_count(*r, count);
                        self.set_last(*r, pos);
                        pc = *body;
                        ok = true;
                    }
                }
                if ok {
                    continue;
                }
            } else {
                match op {
                    Op.Lit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) == *c } else { self.s[pos] == *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.NotLit(c, icase, ascii) => {
                        if pos < self.s.len() and (if *icase { lower(self.s[pos], *ascii) != *c } else { self.s[pos] != *c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Any => {
                        if pos < self.s.len() and self.s[pos] != 10 {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.AnyAll => {
                        if pos < self.s.len() {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.In(set, icase, ascii) => {
                        if pos < self.s.len() and in_set(prog.sets[*set], self.s[pos], *icase, *ascii) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.At(kind, ascii) => {
                        if self.at(*kind, *ascii, pos) {
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Mark(slot) => {
                        self.set_mark(*slot, pos);
                        if (*slot & 1) == 1 {
                            self.set_lastindex(*slot / 2);
                        }
                        pc += 1;
                    }
                    Op.Split(a, b) => {
                        choices.push(Choice { pc: *b, pos: pos, trail: self.trail.len(), mode: 0 });
                        pc = *a;
                    }
                    Op.Jmp(a) => pc = *a,
                    Op.RepInit(r, until) => {
                        self.set_count(*r, -1);
                        self.set_last(*r, -1);
                        pc = *until;
                    }
                    Op.Until(r, min, max, greedy, body, exit) => {
                        let count = self.counts[*r] + 1;
                        if count < *min {
                            self.set_count(*r, count);
                            pc = *body;
                        } else if *greedy {
                            if (count < *max or *max == maxrepeat()) and pos != self.lasts[*r] {
                                choices.push(Choice { pc: *exit, pos: pos, trail: self.trail.len(), mode: 0 });
                                self.set_count(*r, count);
                                self.set_last(*r, pos);
                                pc = *body;
                            } else {
                                pc = *exit;
                            }
                        } else {
                            choices.push(Choice { pc: pc, pos: pos, trail: self.trail.len(), mode: 1 });
                            pc = *exit;
                        }
                    }
                    Op.Ref(g, icase, ascii) => {
                        let (a, b) = self.group_span(*g);
                        if a < 0 {
                            ok = false;
                        } else {
                            let len = b - a;
                            if pos + len > self.s.len() {
                                ok = false;
                            } else {
                                let mut k = 0;
                                while k < len {
                                    let x = self.s[a + k];
                                    let y = self.s[pos + k];
                                    let eq = if *icase { lower(x, *ascii) == lower(y, *ascii) } else { x == y };
                                    if not eq {
                                        ok = false;
                                        break;
                                    }
                                    k += 1;
                                }
                                if ok {
                                    pos += len;
                                    pc += 1;
                                }
                            }
                        }
                    }
                    Op.Look(width, negative, sub, next) => {
                        let mark = self.trail.len();
                        let from = if *width < 0 { pos } else { pos - *width };
                        let found = from >= 0 and self.run(prog, *sub, from, false) >= 0;
                        if *negative {
                            self.undo_to(mark);
                            if found {
                                ok = false;
                            } else {
                                pc = *next;
                            }
                        } else if found {
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Atomic(sub, next) => {
                        let end = self.run(prog, *sub, pos, false);
                        if end >= 0 {
                            pos = end;
                            pc = *next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Exists(g, no) => {
                        let (a, _) = self.group_span(*g);
                        if a >= 0 {
                            pc += 1;
                        } else {
                            pc = *no;
                        }
                    }
                    Op.Fail => ok = false,
                    Op.Succeed => return pos,
                    Op.Match => {
                        if top and ((self.match_all and pos != self.s.len()) or (self.must_advance and pos == self.start)) {
                            ok = false;
                        } else {
                            return pos;
                        }
                    }
                }
            }
            if not ok {
                match choices.pop() {
                    Some(ch) => {
                        self.undo_to(ch.trail);
                        pc = ch.pc;
                        pos = ch.pos;
                        mode = ch.mode;
                    }
                    None => {
                        self.undo_to(base);
                        return -1;
                    }
                }
            }
        }
    }
}

fn in_items(set: ref CharSet, c: i64, ascii: bool) -> bool {
    for item in set.items.iter() {
        let hit = match item {
            Item.Lit(l) => c == *l,
            Item.Range(lo, hi) => c >= *lo and c <= *hi,
            Item.Cat(k) => {
                let kind = *k;
                if kind == 0 {
                    if ascii { c >= 48 and c <= 57 } else { is_decimal(c) }
                } else if kind == 1 {
                    if ascii { not (c >= 48 and c <= 57) } else { not is_decimal(c) }
                } else if kind == 2 {
                    is_space(c, ascii)
                } else if kind == 3 {
                    not is_space(c, ascii)
                } else if kind == 4 {
                    is_word(c, ascii)
                } else {
                    not is_word(c, ascii)
                }
            }
        };
        if hit {
            return true;
        }
    }
    false
}

// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = lower(c, ascii);
        if lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program, s: ref Vec[i64]) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        s: s.clone(),
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn find(m: mut ref Matcher, prog: ref Program, from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= m.s.len() {
        let mut k = 0;
        while k < m.marks.len() {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}

// ------------------------------------------------------------ geographiclib (from mini_geographiclib)

const PI_F: f64 = 3.141592653589793;
const DBL_MIN: f64 = 2.2250738585072014e-308;
const TOL0: f64 = 2.220446049250313e-16;
const GEOD_ORDER: i64 = 6;
const MAXIT1: i64 = 20;
const MAXIT2: i64 = 83;

const CAP_C1: i64 = 1;
const CAP_C1P: i64 = 2;
const CAP_C2: i64 = 4;
const CAP_C3: i64 = 8;
const CAP_C4: i64 = 16;
const OUT_MASK: i64 = 65408;
const EMPTY: i64 = 0;
const LATITUDE: i64 = 128;
const LONGITUDE: i64 = 264;
const AZIMUTH: i64 = 512;
const DISTANCE: i64 = 1025;
const STANDARD: i64 = 1929;
const DISTANCE_IN: i64 = 2051;
const REDUCEDLENGTH: i64 = 4101;
const GEODESICSCALE: i64 = 8197;
const AREA: i64 = 16400;
const LONG_UNROLL: i64 = 32768;
const ALL: i64 = 32671;

// B-2026-10-23-3: a method call on a const fails on v2, so the const is
// copied into a local first.
fn tiny() -> f64 {
    let m = DBL_MIN;
    m.sqrt()
}

fn tol1() -> f64 {
    200.0 * TOL0
}

fn tol2() -> f64 {
    let t = TOL0;
    t.sqrt()
}

fn xthresh() -> f64 {
    1000.0 * tol2()
}

fn has(m: i64, bits: i64) -> bool {
    (m & bits) != 0
}

// ----------------------------------------------------------- CPython math

fn is_nan(x: f64) -> bool {
    x != x
}

fn finite(x: f64) -> bool {
    x == x and x.abs() != f64.INFINITY
}

fn sq(x: f64) -> f64 {
    x * x
}

fn radians(x: f64) -> f64 {
    x * (PI_F / 180.0)
}

fn degrees(x: f64) -> f64 {
    x * (180.0 / PI_F)
}

// Python's max(a, b) / min(a, b): the first argument wins unless the second
// is strictly beyond it.
fn pmax(a: f64, b: f64) -> f64 {
    if b > a { b } else { a }
}

fn pmin(a: f64, b: f64) -> f64 {
    if b < a { b } else { a }
}

// round() to nearest, ties to even.
fn py_round(x: f64) -> i64 {
    let f = x.floor();
    let d = x - f;
    let fi = f as i64;
    if d > 0.5 {
        fi + 1
    } else if d < 0.5 {
        fi
    } else if fi % 2 == 0 {
        fi
    } else {
        fi + 1
    }
}

fn floor_mod(q: i64, m: i64) -> i64 {
    let r = q % m;
    if r < 0 { r + m } else { r }
}

// Dekker's exact product: z + zz == x * y.
fn two_prod(x: f64, y: f64) -> (f64, f64) {
    let mut t = x * 134217729.0;
    let xh = t - (t - x);
    let xl = x - xh;
    t = y * 134217729.0;
    let yh = t - (t - y);
    let yl = y - yh;
    let p = xh * yh;
    let q = xh * yl + xl * yh;
    let z = p + q;
    let zz = p - z + q + xl * yl;
    (z, zz)
}

// The exponent e of m = f * 2^e with 0.5 <= f < 1 (m > 0, finite).
fn frexp_e(m: f64) -> i64 {
    let mut e = 0;
    let mut x = m;
    while x >= 1.0 {
        x *= 0.5;
        e += 1;
    }
    while x < 0.5 {
        x *= 2.0;
        e -= 1;
    }
    e
}

fn pow2(n: i64) -> f64 {
    let mut r = 1.0;
    let mut i = 0;
    if n >= 0 {
        while i < n {
            r *= 2.0;
            i += 1;
        }
    } else {
        while i < -n {
            r *= 0.5;
            i += 1;
        }
    }
    r
}

// CPython's vector_norm for two coordinates.
fn vector_norm2(a: f64, b: f64, mx: f64, nan: bool) -> f64 {
    if mx == f64.INFINITY {
        return mx;
    }
    if nan {
        return f64.NAN;
    }
    if mx == 0.0 {
        return mx;
    }
    let e = frexp_e(mx);
    if e < -1023 {
        return DBL_MIN * vector_norm2(a / DBL_MIN, b / DBL_MIN, mx / DBL_MIN, nan);
    }
    let scale = pow2(-e);
    let mut csum = 1.0;
    let mut f1 = 0.0;
    let mut f2 = 0.0;
    let mut k = 0;
    while k < 2 {
        let x = if k == 0 { a * scale } else { b * scale };
        let (hi, lo) = two_prod(x, x);
        let s = csum + hi;
        let y = (csum - s) + hi;
        csum = s;
        f1 += lo;
        f2 += y;
        k += 1;
    }
    let mut h = (csum - 1.0 + (f1 + f2)).sqrt();
    let (hi, lo) = two_prod(-h, h);
    let s = csum + hi;
    let y = (csum - s) + hi;
    csum = s;
    f1 += lo;
    f2 += y;
    let x = csum - 1.0 + (f1 + f2);
    h += x / (2.0 * h);
    h / scale
}

fn hypot(x: f64, y: f64) -> f64 {
    let ax = x.abs();
    let ay = y.abs();
    let nan = ax != ax or ay != ay;
    let mut mx = 0.0;
    if ax > mx {
        mx = ax;
    }
    if ay > mx {
        mx = ay;
    }
    vector_norm2(ax, ay, mx, nan)
}

// CPython's math.remainder (m_remainder).
fn py_remainder(x: f64, y: f64) -> f64 {
    if finite(x) and finite(y) {
        if y == 0.0 {
            return f64.NAN;
        }
        let ax = x.abs();
        let ay = y.abs();
        let m = ax % ay;
        let c = ay - m;
        let r = if m < c {
            m
        } else if m > c {
            -c
        } else {
            m - 2.0 * ((0.5 * (ax - m)) % ay)
        };
        return 1.0.copysign(x) * r;
    }
    if is_nan(x) {
        return x;
    }
    if is_nan(y) {
        return y;
    }
    if x.abs() == f64.INFINITY {
        return f64.NAN;
    }
    x
}

// ----------------------------------------------------------- Math (geomath)

fn cbrt(x: f64) -> f64 {
    x.abs().pow(1.0 / 3.0).copysign(x)
}

fn norm(x: f64, y: f64) -> (f64, f64) {
    let r = hypot(x, y);
    (x / r, y / r)
}

fn err_sum(u: f64, v: f64) -> (f64, f64) {
    let s = u + v;
    let mut up = s - v;
    let mut vpp = s - up;
    up -= u;
    vpp -= v;
    let t = if s == 0.0 { s } else { 0.0 - (up + vpp) };
    (s, t)
}

fn polyval(n0: i64, p: ref Vec[f64], s0: i64, x: f64) -> f64 {
    let mut n = n0;
    let mut s = s0;
    let mut y = if n < 0 { 0.0 } else { p[s] };
    while n > 0 {
        n -= 1;
        s += 1;
        y = y * x + p[s];
    }
    y
}

fn ang_round(x: f64) -> f64 {
    let z = 1.0 / 16.0;
    let mut y = x.abs();
    if y < z {
        y = z - (z - y);
    }
    y.copysign(x)
}

fn remainder(x: f64, y: f64) -> f64 {
    if finite(x) { py_remainder(x, y) } else { f64.NAN }
}

fn ang_normalize(x: f64) -> f64 {
    let y = remainder(x, 360.0);
    if y.abs() == 180.0 { 180.0.copysign(x) } else { y }
}

fn lat_fix(x: f64) -> f64 {
    if x.abs() > 90.0 { f64.NAN } else { x }
}

fn ang_diff(x: f64, y: f64) -> (f64, f64) {
    let (d0, t0) = err_sum(remainder(-x, 360.0), remainder(y, 360.0));
    let (d1, t) = err_sum(remainder(d0, 360.0), t0);
    let mut d = d1;
    if d == 0.0 or d.abs() == 180.0 {
        d = d.copysign(if t == 0.0 { y - x } else { -t });
    }
    (d, t)
}

fn quadrant(q0: i64, s0: f64, c0: f64, x: f64) -> (f64, f64) {
    let q = floor_mod(q0, 4);
    let mut s = s0;
    let mut c = c0;
    if q == 1 {
        s = c0;
        c = -s0;
    } else if q == 2 {
        s = -s0;
        c = -c0;
    } else if q == 3 {
        s = -c0;
        c = s0;
    }
    c = c + 0.0;
    if s == 0.0 {
        s = s.copysign(x);
    }
    (s, c)
}

fn sincosd(x: f64) -> (f64, f64) {
    let mut r = if finite(x) { x % 360.0 } else { f64.NAN };
    let q = if is_nan(r) { 0 } else { py_round(r / 90.0) };
    r -= 90.0 * (q as f64);
    r = radians(r);
    quadrant(q, r.sin(), r.cos(), x)
}

fn sincosde(x: f64, t: f64) -> (f64, f64) {
    let q = if finite(x) { py_round(x / 90.0) } else { 0 };
    let mut r = x - 90.0 * (q as f64);
    r = radians(ang_round(r + t));
    quadrant(q, r.sin(), r.cos(), x)
}

fn atan2d(y0: f64, x0: f64) -> f64 {
    let mut x = x0;
    let mut y = y0;
    let mut q = 0;
    if y.abs() > x.abs() {
        q = 2;
        let t = x;
        x = y;
        y = t;
    }
    if x < 0.0 {
        q += 1;
        x = -x;
    }
    let mut ang = degrees(y.atan2(x));
    if q == 1 {
        ang = 180.0.copysign(y) - ang;
    } else if q == 2 {
        ang = 90.0 - ang;
    } else if q == 3 {
        ang = -90.0 + ang;
    }
    ang
}

// ----------------------------------------------------------- series

fn floats(v: Vec[i64]) -> Vec[f64] {
    let mut out: Vec[f64] = Vec.new();
    for x in v {
        out.push(x as f64);
    }
    out
}

fn sin_cos_series(sinp: bool, sinx: f64, cosx: f64, c: ref Vec[f64]) -> f64 {
    let mut k = c.len();
    let mut n = if sinp { k - 1 } else { k };
    let ar = 2.0 * (cosx - sinx) * (cosx + sinx);
    let mut y1 = 0.0;
    let mut y0 = 0.0;
    if (n & 1) != 0 {
        k -= 1;
        y0 = c[k];
    }
    n = n / 2;
    while n > 0 {
        n -= 1;
        k -= 1;
        y1 = ar * y0 - y1 + c[k];
        k -= 1;
        y0 = ar * y1 - y0 + c[k];
    }
    if sinp { 2.0 * sinx * cosx * y0 } else { cosx * (y0 - y1) }
}

fn astroid(x: f64, y: f64) -> f64 {
    let p = sq(x);
    let q = sq(y);
    let mut r = (p + q - 1.0) / 6.0;
    if not (q == 0.0 and r <= 0.0) {
        let s = p * q / 4.0;
        let r2 = sq(r);
        let r3 = r * r2;
        let disc = s * (s + 2.0 * r3);
        let mut u = r;
        if disc >= 0.0 {
            let mut t3 = s + r3;
            t3 += if t3 < 0.0 { -disc.sqrt() } else { disc.sqrt() };
            let t = cbrt(t3);
            u += t + (if t != 0.0 { r2 / t } else { 0.0 });
        } else {
            let ang = (-disc).sqrt().atan2(-(s + r3));
            u += 2.0 * r * (ang / 3.0).cos();
        }
        let v = (sq(u) + q).sqrt();
        let uv = if u < 0.0 { q / (v - u) } else { u + v };
        let w = (uv - q) / (2.0 * v);
        r = uv / ((uv + sq(w)).sqrt() + w);
        return r;
    }
    0.0
}

fn a1m1f(eps: f64) -> f64 {
    let coeff = floats([1, 4, 64, 0, 256]);
    let m = GEOD_ORDER / 2;
    let t = polyval(m, coeff, 0, sq(eps)) / coeff[m + 1];
    (t + eps) / (1.0 - eps)
}

// The C1, C1' and C2 coefficient sets, filled into c[1..6] (c[0] unused).
fn c_series(eps: f64, coeff: ref Vec[f64]) -> Vec[f64] {
    let mut c: Vec[f64] = Vec.new();
    c.push(0.0);
    let eps2 = sq(eps);
    let mut d = eps;
    let mut o = 0;
    let mut l = 1;
    while l <= GEOD_ORDER {
        let m = (GEOD_ORDER - l) / 2;
        c.push(d * polyval(m, coeff, o, eps2) / coeff[o + m + 1]);
        o += m + 2;
        d *= eps;
        l += 1;
    }
    c
}

fn c1f(eps: f64) -> Vec[f64] {
    let coeff = floats([-1, 6, -16, 32, -9, 64, -128, 2048, 9, -16, 768, 3, -5, 512, -7, 1280, -7, 2048]);
    c_series(eps, coeff)
}

fn c1pf(eps: f64) -> Vec[f64] {
    let coeff = floats([205, -432, 768, 1536, 4005, -4736, 3840, 12288, -225, 116, 384, -7173, 2695, 7680, 3467, 7680, 38081, 61440]);
    c_series(eps, coeff)
}

fn a2m1f(eps: f64) -> f64 {
    let coeff = floats([-11, -28, -192, 0, 256]);
    let m = GEOD_ORDER / 2;
    let t = polyval(m, coeff, 0, sq(eps)) / coeff[m + 1];
    (t - eps) / (1.0 + eps)
}

fn c2f(eps: f64) -> Vec[f64] {
    let coeff = floats([1, 2, 16, 32, 35, 64, 384, 2048, 15, 80, 768, 7, 35, 512, 63, 1280, 77, 2048]);
    c_series(eps, coeff)
}

// ----------------------------------------------------------- Geodesic

struct Geod {
    a: f64,
    f: f64,
    f1: f64,
    e2: f64,
    ep2: f64,
    n: f64,
    b: f64,
    c2: f64,
    etol2: f64,
    a3x: Vec[f64],
    c3x: Vec[f64],
    c4x: Vec[f64],
}

const ERR_ZERO: Str = "ZeroDivisionError: float division by zero";
const ERR_DOMAIN: Str = "ValueError: math domain error";

fn new_geod(a: f64, f: f64) -> Result[Geod, String] {
    let f1 = 1.0 - f;
    let e2 = f * (2.0 - f);
    if sq(f1) == 0.0 {
        return Err(ERR_ZERO.to_string());
    }
    let ep2 = e2 / sq(f1);
    if 2.0 - f == 0.0 {
        return Err(ERR_ZERO.to_string());
    }
    let n = f / (2.0 - f);
    let b = a * f1;
    let mut ratio = 1.0;
    if e2 != 0.0 {
        if e2 > 0.0 {
            if e2.sqrt() >= 1.0 {
                return Err(ERR_DOMAIN.to_string());
            }
            ratio = e2.sqrt().atanh();
        } else {
            ratio = (-e2).sqrt().atan();
        }
        ratio = ratio / e2.abs().sqrt();
    }
    let c2 = (sq(a) + sq(b) * ratio) / 2.0;
    let arg = pmax(0.001, f.abs()) * pmin(1.0, 1.0 - f / 2.0) / 2.0;
    if arg < 0.0 {
        return Err(ERR_DOMAIN.to_string());
    }
    if arg.sqrt() == 0.0 {
        return Err(ERR_ZERO.to_string());
    }
    let etol2 = 0.1 * tol2() / arg.sqrt();
    if not (finite(a) and a > 0.0) {
        return Err("ValueError: Equatorial radius is not positive".to_string());
    }
    if not (finite(b) and b > 0.0) {
        return Err("ValueError: Polar semi-axis is not positive".to_string());
    }
    // A3x
    let ca3 = floats([-3, 128, -2, -3, 64, -1, -3, -1, 16, 3, -1, -2, 8, 1, -1, 2, 1, 1]);
    let mut a3x: Vec[f64] = Vec.new();
    let mut o = 0;
    let mut j = GEOD_ORDER - 1;
    while j >= 0 {
        let m = if GEOD_ORDER - j - 1 < j { GEOD_ORDER - j - 1 } else { j };
        a3x.push(polyval(m, ca3, o, n) / ca3[o + m + 1]);
        o += m + 2;
        j -= 1;
    }
    // C3x
    let cc3 = floats([3, 128, 2, 5, 128, -1, 3, 3, 64, -1, 0, 1, 8, -1, 1, 4, 5, 256, 1, 3, 128, -3, -2, 3, 64, 1, -3, 2, 32, 7, 512, -10, 9, 384, 5, -9, 5, 192, 7, 512, -14, 7, 512, 21, 2560]);
    let mut c3x: Vec[f64] = Vec.new();
    o = 0;
    let mut l = 1;
    while l < GEOD_ORDER {
        j = GEOD_ORDER - 1;
        while j >= l {
            let m = if GEOD_ORDER - j - 1 < j { GEOD_ORDER - j - 1 } else { j };
            c3x.push(polyval(m, cc3, o, n) / cc3[o + m + 1]);
            o += m + 2;
            j -= 1;
        }
        l += 1;
    }
    // C4x
    let cc4 = floats([97, 15015, 1088, 156, 45045, -224, -4784, 1573, 45045, -10656, 14144, -4576, -858, 45045, 64, 624, -4576, 6864, -3003, 15015, 100, 208, 572, 3432, -12012, 30030, 45045, 1, 9009, -2944, 468, 135135, 5792, 1040, -1287, 135135, 5952, -11648, 9152, -2574, 135135, -64, -624, 4576, -6864, 3003, 135135, 8, 10725, 1856, -936, 225225, -8448, 4992, -1144, 225225, -1440, 4160, -4576, 1716, 225225, -136, 63063, 1024, -208, 105105, 3584, -3328, 1144, 315315, -128, 135135, -2560, 832, 405405, 128, 99099]);
    let mut c4x: Vec[f64] = Vec.new();
    o = 0;
    l = 0;
    while l < GEOD_ORDER {
        j = GEOD_ORDER - 1;
        while j >= l {
            let m = GEOD_ORDER - j - 1;
            c4x.push(polyval(m, cc4, o, n) / cc4[o + m + 1]);
            o += m + 2;
            j -= 1;
        }
        l += 1;
    }
    Ok(Geod { a: a, f: f, f1: f1, e2: e2, ep2: ep2, n: n, b: b, c2: c2, etol2: etol2, a3x: a3x, c3x: c3x, c4x: c4x })
}

fn a3f(g: ref Geod, eps: f64) -> f64 {
    polyval(GEOD_ORDER - 1, g.a3x, 0, eps)
}

fn c3f(g: ref Geod, eps: f64) -> Vec[f64] {
    let mut c: Vec[f64] = Vec.new();
    c.push(0.0);
    let mut mult = 1.0;
    let mut o = 0;
    let mut l = 1;
    while l < GEOD_ORDER {
        let m = GEOD_ORDER - l - 1;
        mult *= eps;
        c.push(mult * polyval(m, g.c3x, o, eps));
        o += m + 1;
        l += 1;
    }
    c
}

fn c4f(g: ref Geod, eps: f64) -> Vec[f64] {
    let mut c: Vec[f64] = Vec.new();
    let mut mult = 1.0;
    let mut o = 0;
    let mut l = 0;
    while l < GEOD_ORDER {
        let m = GEOD_ORDER - l - 1;
        c.push(mult * polyval(m, g.c4x, o, eps));
        o += m + 1;
        mult *= eps;
        l += 1;
    }
    c
}

struct Lengths {
    s12b: f64,
    m12b: f64,
    m0: f64,
    mm12: f64,
    mm21: f64,
}

fn lengths(g: ref Geod, eps: f64, sig12: f64, ssig1: f64, csig1: f64, dn1: f64, ssig2: f64, csig2: f64, dn2: f64, cbet1: f64, cbet2: f64, outmask0: i64) -> Lengths {
    let outmask = outmask0 & OUT_MASK;
    let mut s12b = f64.NAN;
    let mut m12b = f64.NAN;
    let mut m0 = f64.NAN;
    let mut m0x = f64.NAN;
    let mut j12 = f64.NAN;
    let mut mm12 = f64.NAN;
    let mut mm21 = f64.NAN;
    let mut a1 = 0.0;
    let mut a2 = 0.0;
    let mut c1a: Vec[f64] = Vec.new();
    let mut c2a: Vec[f64] = Vec.new();
    let rl_gs = REDUCEDLENGTH | GEODESICSCALE;
    if has(outmask, DISTANCE | rl_gs) {
        a1 = a1m1f(eps);
        c1a = c1f(eps);
        if has(outmask, rl_gs) {
            a2 = a2m1f(eps);
            c2a = c2f(eps);
            m0x = a1 - a2;
            a2 = 1.0 + a2;
        }
        a1 = 1.0 + a1;
    }
    if has(outmask, DISTANCE) {
        let b1 = sin_cos_series(true, ssig2, csig2, c1a) - sin_cos_series(true, ssig1, csig1, c1a);
        s12b = a1 * (sig12 + b1);
        if has(outmask, rl_gs) {
            let b2 = sin_cos_series(true, ssig2, csig2, c2a) - sin_cos_series(true, ssig1, csig1, c2a);
            j12 = m0x * sig12 + (a1 * b1 - a2 * b2);
        }
    } else if has(outmask, rl_gs) {
        let mut l = 1;
        while l < GEOD_ORDER {
            c2a[l] = a1 * c1a[l] - a2 * c2a[l];
            l += 1;
        }
        j12 = m0x * sig12 + (sin_cos_series(true, ssig2, csig2, c2a) - sin_cos_series(true, ssig1, csig1, c2a));
    }
    if has(outmask, REDUCEDLENGTH) {
        m0 = m0x;
        m12b = dn2 * (csig1 * ssig2) - dn1 * (ssig1 * csig2) - csig1 * csig2 * j12;
    }
    if has(outmask, GEODESICSCALE) {
        let csig12 = csig1 * csig2 + ssig1 * ssig2;
        let t = g.ep2 * (cbet1 - cbet2) * (cbet1 + cbet2) / (dn1 + dn2);
        mm12 = csig12 + (t * ssig2 - csig2 * j12) * ssig1 / dn1;
        mm21 = csig12 - (t * ssig1 - csig1 * j12) * ssig2 / dn2;
    }
    Lengths { s12b: s12b, m12b: m12b, m0: m0, mm12: mm12, mm21: mm21 }
}

struct Start {
    sig12: f64,
    salp1: f64,
    calp1: f64,
    salp2: f64,
    calp2: f64,
    dnm: f64,
}

fn inverse_start(g: ref Geod, sbet1: f64, cbet1: f64, dn1: f64, sbet2: f64, cbet2: f64, dn2: f64, lam12: f64, slam12: f64, clam12: f64) -> Start {
    let mut sig12 = -1.0;
    let mut salp2 = f64.NAN;
    let mut calp2 = f64.NAN;
    let mut dnm = f64.NAN;
    let sbet12 = sbet2 * cbet1 - cbet2 * sbet1;
    let cbet12 = cbet2 * cbet1 + sbet2 * sbet1;
    let mut sbet12a = sbet2 * cbet1;
    sbet12a += cbet2 * sbet1;
    let shortline = cbet12 >= 0.0 and sbet12 < 0.5 and cbet2 * lam12 < 0.5;
    let mut somg12 = slam12;
    let mut comg12 = clam12;
    if shortline {
        let mut sbetm2 = sq(sbet1 + sbet2);
        sbetm2 /= sbetm2 + sq(cbet1 + cbet2);
        dnm = (1.0 + g.ep2 * sbetm2).sqrt();
        let omg12 = lam12 / (g.f1 * dnm);
        somg12 = omg12.sin();
        comg12 = omg12.cos();
    }
    let mut salp1 = cbet2 * somg12;
    let mut calp1 = if comg12 >= 0.0 {
        sbet12 + cbet2 * sbet1 * sq(somg12) / (1.0 + comg12)
    } else {
        sbet12a - cbet2 * sbet1 * sq(somg12) / (1.0 - comg12)
    };
    let ssig12 = hypot(salp1, calp1);
    let csig12 = sbet1 * sbet2 + cbet1 * cbet2 * comg12;
    if shortline and ssig12 < g.etol2 {
        salp2 = cbet1 * somg12;
        calp2 = sbet12 - cbet1 * sbet2 * (if comg12 >= 0.0 { sq(somg12) / (1.0 + comg12) } else { 1.0 - comg12 });
        let (s2, c2) = norm(salp2, calp2);
        salp2 = s2;
        calp2 = c2;
        sig12 = ssig12.atan2(csig12);
    } else if g.n.abs() >= 0.1 or csig12 >= 0.0 or ssig12 >= 6.0 * g.n.abs() * PI_F * sq(cbet1) {
        // zeroth order spherical approximation is OK
    } else {
        let lam12x = (-slam12).atan2(-clam12);
        let mut x = 0.0;
        let mut y = 0.0;
        let mut lamscale = 0.0;
        if g.f >= 0.0 {
            let k2 = sq(sbet1) * g.ep2;
            let eps = k2 / (2.0 * (1.0 + (1.0 + k2).sqrt()) + k2);
            lamscale = g.f * cbet1 * a3f(g, eps) * PI_F;
            let betscale = lamscale * cbet1;
            x = lam12x / lamscale;
            y = sbet12a / betscale;
        } else {
            let cbet12a = cbet2 * cbet1 - sbet2 * sbet1;
            let bet12a = sbet12a.atan2(cbet12a);
            let ln = lengths(g, g.n, PI_F + bet12a, sbet1, -cbet1, dn1, sbet2, cbet2, dn2, cbet1, cbet2, REDUCEDLENGTH);
            x = -1.0 + ln.m12b / (cbet1 * cbet2 * ln.m0 * PI_F);
            let betscale = if x < -0.01 { sbet12a / x } else { -g.f * sq(cbet1) * PI_F };
            lamscale = betscale / cbet1;
            y = lam12x / lamscale;
        }
        if y > -tol1() and x > -1.0 - xthresh() {
            if g.f >= 0.0 {
                salp1 = pmin(1.0, -x);
                calp1 = -(1.0 - sq(salp1)).sqrt();
            } else {
                calp1 = pmax(if x > -tol1() { 0.0 } else { -1.0 }, x);
                salp1 = (1.0 - sq(calp1)).sqrt();
            }
        } else {
            let k = astroid(x, y);
            let omg12a = lamscale * (if g.f >= 0.0 { -x * k / (1.0 + k) } else { -y * (1.0 + k) / k });
            somg12 = omg12a.sin();
            comg12 = -omg12a.cos();
            salp1 = cbet2 * somg12;
            calp1 = sbet12a - cbet2 * sbet1 * sq(somg12) / (1.0 - comg12);
        }
    }
    if not (salp1 <= 0.0) {
        let (s1, c1) = norm(salp1, calp1);
        salp1 = s1;
        calp1 = c1;
    } else {
        salp1 = 1.0;
        calp1 = 0.0;
    }
    Start { sig12: sig12, salp1: salp1, calp1: calp1, salp2: salp2, calp2: calp2, dnm: dnm }
}

struct Lam {
    lam12: f64,
    salp2: f64,
    calp2: f64,
    sig12: f64,
    ssig1: f64,
    csig1: f64,
    ssig2: f64,
    csig2: f64,
    eps: f64,
    domg12: f64,
    dlam12: f64,
}

fn lambda12(g: ref Geod, sbet1: f64, cbet1: f64, dn1: f64, sbet2: f64, cbet2: f64, dn2: f64, salp1: f64, calp1_in: f64, slam120: f64, clam120: f64, diffp: bool) -> Lam {
    let mut calp1 = calp1_in;
    if sbet1 == 0.0 and calp1 == 0.0 {
        calp1 = -tiny();
    }
    let salp0 = salp1 * cbet1;
    let calp0 = hypot(calp1, salp1 * sbet1);
    let somg1 = salp0 * sbet1;
    let comg1 = calp1 * cbet1;
    let (ssig1, csig1) = norm(sbet1, comg1);
    let salp2 = if cbet2 != cbet1 { salp0 / cbet2 } else { salp1 };
    let calp2 = if cbet2 != cbet1 or sbet2.abs() != -sbet1 {
        (sq(calp1 * cbet1) + (if cbet1 < -sbet1 { (cbet2 - cbet1) * (cbet1 + cbet2) } else { (sbet1 - sbet2) * (sbet1 + sbet2) })).sqrt() / cbet2
    } else {
        calp1.abs()
    };
    let somg2 = salp0 * sbet2;
    let comg2 = calp2 * cbet2;
    let (ssig2, csig2) = norm(sbet2, comg2);
    let sig12 = (pmax(0.0, csig1 * ssig2 - ssig1 * csig2) + 0.0).atan2(csig1 * csig2 + ssig1 * ssig2);
    let somg12 = pmax(0.0, comg1 * somg2 - somg1 * comg2) + 0.0;
    let comg12 = comg1 * comg2 + somg1 * somg2;
    let eta = (somg12 * clam120 - comg12 * slam120).atan2(comg12 * clam120 + somg12 * slam120);
    let k2 = sq(calp0) * g.ep2;
    let eps = k2 / (2.0 * (1.0 + (1.0 + k2).sqrt()) + k2);
    let c3a = c3f(g, eps);
    let b312 = sin_cos_series(true, ssig2, csig2, c3a) - sin_cos_series(true, ssig1, csig1, c3a);
    let domg12 = -g.f * a3f(g, eps) * salp0 * (sig12 + b312);
    let lam12 = eta + domg12;
    let mut dlam12 = f64.NAN;
    if diffp {
        if calp2 == 0.0 {
            dlam12 = -2.0 * g.f1 * dn1 / sbet1;
        } else {
            let ln = lengths(g, eps, sig12, ssig1, csig1, dn1, ssig2, csig2, dn2, cbet1, cbet2, REDUCEDLENGTH);
            dlam12 = ln.m12b;
            dlam12 *= g.f1 / (calp2 * cbet2);
        }
    }
    Lam { lam12: lam12, salp2: salp2, calp2: calp2, sig12: sig12, ssig1: ssig1, csig1: csig1, ssig2: ssig2, csig2: csig2, eps: eps, domg12: domg12, dlam12: dlam12 }
}

struct Inv {
    a12: f64,
    s12: f64,
    salp1: f64,
    calp1: f64,
    salp2: f64,
    calp2: f64,
    m12: f64,
    mm12: f64,
    mm21: f64,
    ss12: f64,
}

fn gen_inverse(g: ref Geod, lat1_in: f64, lon1: f64, lat2_in: f64, lon2: f64, outmask0: i64) -> Inv {
    let mut a12 = f64.NAN;
    let mut s12 = f64.NAN;
    let mut m12 = f64.NAN;
    let mut mm12 = f64.NAN;
    let mut mm21 = f64.NAN;
    let mut ss12 = f64.NAN;
    let outmask = outmask0 & OUT_MASK;
    let (lon12a, lon12sa) = ang_diff(lon1, lon2);
    let mut lonsign = 1.0.copysign(lon12a);
    let lon12 = lonsign * lon12a;
    let mut lon12s = lonsign * lon12sa;
    let lam12 = radians(lon12);
    let (slam12, clam12) = sincosde(lon12, lon12s);
    lon12s = (180.0 - lon12) - lon12s;

    let mut lat1 = ang_round(lat_fix(lat1_in));
    let mut lat2 = ang_round(lat_fix(lat2_in));
    let swapp = if lat1.abs() < lat2.abs() or is_nan(lat2) { -1.0 } else { 1.0 };
    if swapp < 0.0 {
        lonsign *= -1.0;
        let t = lat1;
        lat1 = lat2;
        lat2 = t;
    }
    let latsign = 1.0.copysign(-lat1);
    lat1 *= latsign;
    lat2 *= latsign;

    let (sb1, cb1) = sincosd(lat1);
    let (sbet1, cb1n) = norm(sb1 * g.f1, cb1);
    let cbet1 = pmax(tiny(), cb1n);
    let (sb2, cb2) = sincosd(lat2);
    let (sb2n, cb2n) = norm(sb2 * g.f1, cb2);
    let mut sbet2 = sb2n;
    let mut cbet2 = pmax(tiny(), cb2n);

    if cbet1 < -sbet1 {
        if cbet2 == cbet1 {
            sbet2 = sbet1.copysign(sbet2);
        }
    } else {
        if sbet2.abs() == -sbet1 {
            cbet2 = cbet1;
        }
    }
    let dn1 = (1.0 + g.ep2 * sq(sbet1)).sqrt();
    let dn2 = (1.0 + g.ep2 * sq(sbet2)).sqrt();

    let mut meridian = lat1 == -90.0 or slam12 == 0.0;
    let mut calp1 = 0.0;
    let mut salp1 = 0.0;
    let mut calp2 = 0.0;
    let mut salp2 = 0.0;
    let mut sig12 = 0.0;
    let mut s12x = f64.NAN;
    let mut m12x = f64.NAN;

    if meridian {
        calp1 = clam12;
        salp1 = slam12;
        calp2 = 1.0;
        salp2 = 0.0;
        let ssig1 = sbet1;
        let csig1 = calp1 * cbet1;
        let ssig2 = sbet2;
        let csig2 = calp2 * cbet2;
        sig12 = (pmax(0.0, csig1 * ssig2 - ssig1 * csig2) + 0.0).atan2(csig1 * csig2 + ssig1 * ssig2);
        let ln = lengths(g, g.n, sig12, ssig1, csig1, dn1, ssig2, csig2, dn2, cbet1, cbet2, outmask | DISTANCE | REDUCEDLENGTH);
        s12x = ln.s12b;
        m12x = ln.m12b;
        mm12 = ln.mm12;
        mm21 = ln.mm21;
        if sig12 < tol2() or m12x >= 0.0 {
            if sig12 < 3.0 * tiny() or (sig12 < TOL0 and (s12x < 0.0 or m12x < 0.0)) {
                sig12 = 0.0;
                m12x = 0.0;
                s12x = 0.0;
            }
            m12x *= g.b;
            s12x *= g.b;
            a12 = degrees(sig12);
        } else {
            meridian = false;
        }
    }

    let mut somg12 = 2.0;
    let mut comg12 = 0.0;
    let mut omg12 = 0.0;
    if not meridian and sbet1 == 0.0 and (g.f <= 0.0 or lon12s >= g.f * 180.0) {
        calp1 = 0.0;
        calp2 = 0.0;
        salp1 = 1.0;
        salp2 = 1.0;
        s12x = g.a * lam12;
        sig12 = lam12 / g.f1;
        omg12 = sig12;
        m12x = g.b * sig12.sin();
        if has(outmask, GEODESICSCALE) {
            mm12 = sig12.cos();
            mm21 = mm12;
        }
        a12 = lon12 / g.f1;
    } else if not meridian {
        let st = inverse_start(g, sbet1, cbet1, dn1, sbet2, cbet2, dn2, lam12, slam12, clam12);
        sig12 = st.sig12;
        salp1 = st.salp1;
        calp1 = st.calp1;
        salp2 = st.salp2;
        calp2 = st.calp2;
        let dnm = st.dnm;
        if sig12 >= 0.0 {
            s12x = sig12 * g.b * dnm;
            m12x = sq(dnm) * g.b * (sig12 / dnm).sin();
            if has(outmask, GEODESICSCALE) {
                mm12 = (sig12 / dnm).cos();
                mm21 = mm12;
            }
            a12 = degrees(sig12);
            omg12 = lam12 / (g.f1 * dnm);
        } else {
            let mut numit = 0;
            let mut tripn = false;
            let mut tripb = false;
            let mut salp1a = tiny();
            let mut calp1a = 1.0;
            let mut salp1b = tiny();
            let mut calp1b = -1.0;
            let mut ssig1 = 0.0;
            let mut csig1 = 0.0;
            let mut ssig2 = 0.0;
            let mut csig2 = 0.0;
            let mut eps = 0.0;
            let mut domg12 = 0.0;
            loop {
                let lm = lambda12(g, sbet1, cbet1, dn1, sbet2, cbet2, dn2, salp1, calp1, slam12, clam12, numit < MAXIT1);
                let v = lm.lam12;
                salp2 = lm.salp2;
                calp2 = lm.calp2;
                sig12 = lm.sig12;
                ssig1 = lm.ssig1;
                csig1 = lm.csig1;
                ssig2 = lm.ssig2;
                csig2 = lm.csig2;
                eps = lm.eps;
                domg12 = lm.domg12;
                let dv = lm.dlam12;
                let lim = if tripn { 8.0 } else { 1.0 };
                if tripb or not (v.abs() >= lim * TOL0) or numit == MAXIT2 {
                    break;
                }
                if v > 0.0 and (numit > MAXIT1 or calp1 / salp1 > calp1b / salp1b) {
                    salp1b = salp1;
                    calp1b = calp1;
                } else if v < 0.0 and (numit > MAXIT1 or calp1 / salp1 < calp1a / salp1a) {
                    salp1a = salp1;
                    calp1a = calp1;
                }
                numit += 1;
                let mut newton = false;
                if numit < MAXIT1 and dv > 0.0 {
                    let dalp1 = -v / dv;
                    if dalp1.abs() < PI_F {
                        let sdalp1 = dalp1.sin();
                        let cdalp1 = dalp1.cos();
                        let nsalp1 = salp1 * cdalp1 + calp1 * sdalp1;
                        if nsalp1 > 0.0 {
                            calp1 = calp1 * cdalp1 - salp1 * sdalp1;
                            salp1 = nsalp1;
                            let (s1, c1) = norm(salp1, calp1);
                            salp1 = s1;
                            calp1 = c1;
                            tripn = v.abs() <= 16.0 * TOL0;
                            newton = true;
                        }
                    }
                }
                if not newton {
                    salp1 = (salp1a + salp1b) / 2.0;
                    calp1 = (calp1a + calp1b) / 2.0;
                    let (s1, c1) = norm(salp1, calp1);
                    salp1 = s1;
                    calp1 = c1;
                    tripn = false;
                    tripb = (salp1a - salp1).abs() + (calp1a - calp1) < TOL0 or (salp1 - salp1b).abs() + (calp1 - calp1b) < TOL0;
                }
            }
            let lengthmask = outmask | (if has(outmask, REDUCEDLENGTH | GEODESICSCALE) { DISTANCE } else { EMPTY });
            let ln = lengths(g, eps, sig12, ssig1, csig1, dn1, ssig2, csig2, dn2, cbet1, cbet2, lengthmask);
            s12x = ln.s12b;
            m12x = ln.m12b;
            mm12 = ln.mm12;
            mm21 = ln.mm21;
            m12x *= g.b;
            s12x *= g.b;
            a12 = degrees(sig12);
            if has(outmask, AREA) {
                let sdomg12 = domg12.sin();
                let cdomg12 = domg12.cos();
                somg12 = slam12 * cdomg12 - clam12 * sdomg12;
                comg12 = clam12 * cdomg12 + slam12 * sdomg12;
            }
        }
    }

    if has(outmask, DISTANCE) {
        s12 = 0.0 + s12x;
    }
    if has(outmask, REDUCEDLENGTH) {
        m12 = 0.0 + m12x;
    }
    if has(outmask, AREA) {
        let salp0 = salp1 * cbet1;
        let calp0 = hypot(calp1, salp1 * sbet1);
        if calp0 != 0.0 and salp0 != 0.0 {
            let k2 = sq(calp0) * g.ep2;
            let eps = k2 / (2.0 * (1.0 + (1.0 + k2).sqrt()) + k2);
            let a4 = sq(g.a) * calp0 * salp0 * g.e2;
            let (ssig1, csig1) = norm(sbet1, calp1 * cbet1);
            let (ssig2, csig2) = norm(sbet2, calp2 * cbet2);
            let c4a = c4f(g, eps);
            let b41 = sin_cos_series(false, ssig1, csig1, c4a);
            let b42 = sin_cos_series(false, ssig2, csig2, c4a);
            ss12 = a4 * (b42 - b41);
        } else {
            ss12 = 0.0;
        }
        if not meridian and somg12 == 2.0 {
            somg12 = omg12.sin();
            comg12 = omg12.cos();
        }
        let mut alp12 = 0.0;
        if not meridian and comg12 > -0.7071 and sbet2 - sbet1 < 1.75 {
            let domg12 = 1.0 + comg12;
            let dbet1 = 1.0 + cbet1;
            let dbet2 = 1.0 + cbet2;
            alp12 = 2.0 * (somg12 * (sbet1 * dbet2 + sbet2 * dbet1)).atan2(domg12 * (sbet1 * sbet2 + dbet1 * dbet2));
        } else {
            let mut salp12 = salp2 * calp1 - calp2 * salp1;
            let mut calp12 = calp2 * calp1 + salp2 * salp1;
            if salp12 == 0.0 and calp12 < 0.0 {
                salp12 = tiny() * calp1;
                calp12 = -1.0;
            }
            alp12 = salp12.atan2(calp12);
        }
        ss12 += g.c2 * alp12;
        ss12 *= swapp * lonsign * latsign;
        ss12 += 0.0;
    }
    if swapp < 0.0 {
        let t = salp1;
        salp1 = salp2;
        salp2 = t;
        let u = calp1;
        calp1 = calp2;
        calp2 = u;
        if has(outmask, GEODESICSCALE) {
            let w = mm12;
            mm12 = mm21;
            mm21 = w;
        }
    }
    salp1 *= swapp * lonsign;
    calp1 *= swapp * latsign;
    salp2 *= swapp * lonsign;
    calp2 *= swapp * latsign;
    Inv { a12: a12, s12: s12, salp1: salp1, calp1: calp1, salp2: salp2, calp2: calp2, m12: m12, mm12: mm12, mm21: mm21, ss12: ss12 }
}

// ----------------------------------------------------------- output

// Python's repr: the shortest digits that read back, like Kara's Display,
// but when two candidates are equally short and the value lies exactly
// halfway between them Python keeps the one with the even last digit, where
// Kara's rendering takes the one farther from zero (B-2026-10-23-4). The
// exact expansion shows the tie: one more digit, a 5, then only zeros. Only
// plain decimals are checked; none of the outputs ties in exponent form.
fn fmt(x: f64) -> String {
    if is_nan(x) {
        return "nan".to_string();
    }
    let s = f"{x}";
    let sb = s.bytes().to_vec();
    let mut sdot = -1;
    let mut i = 0;
    while i < sb.len() {
        if sb[i] == b'e' {
            return s;
        }
        if sb[i] == b'.' {
            sdot = i;
        }
        i += 1;
    }
    if sdot < 0 {
        return s;
    }
    let k = sb.len() - sdot - 1;
    let ub = f"{x:.60}".bytes().to_vec();
    let mut udot = 0;
    while ub[udot] != b'.' {
        udot += 1;
    }
    let cut = udot + k + 1;
    if cut >= ub.len() or ub[cut] != b'5' {
        return s;
    }
    let mut j = cut + 1;
    while j < ub.len() {
        if ub[j] != b'0' {
            return s;
        }
        j += 1;
    }
    if (ub[cut - 1] - b'0') % 2 != 0 {
        return s;
    }
    let mut lo: Vec[u8] = Vec.new();
    let mut m = 0;
    while m < cut {
        lo.push(ub[m]);
        m += 1;
    }
    String.from_utf8(lo).unwrap_or(s.clone())
}


struct Line {
    a: f64,
    f: f64,
    b: f64,
    c2: f64,
    f1: f64,
    caps: i64,
    lat1: f64,
    lon1: f64,
    azi1: f64,
    salp1: f64,
    calp1: f64,
    dn1: f64,
    salp0: f64,
    calp0: f64,
    ssig1: f64,
    somg1: f64,
    csig1: f64,
    comg1: f64,
    k2: f64,
    a1m1: f64,
    c1a: Vec[f64],
    b11: f64,
    stau1: f64,
    ctau1: f64,
    c1pa: Vec[f64],
    a2m1: f64,
    c2a: Vec[f64],
    b21: f64,
    c3a: Vec[f64],
    a3c: f64,
    b31: f64,
    c4a: Vec[f64],
    a4: f64,
    b41: f64,
    s13: f64,
    a13: f64,
}

struct Pos {
    a12: f64,
    lat2: f64,
    lon2: f64,
    azi2: f64,
    s12: f64,
    m12: f64,
    mm12: f64,
    mm21: f64,
    ss12: f64,
}

fn new_line(g: ref Geod, lat1: f64, lon1: f64, azi1_in: f64, caps0: i64, salp1_in: f64, calp1_in: f64) -> Line {
    let caps = caps0 | LATITUDE | AZIMUTH | LONG_UNROLL;
    let lat1f = lat_fix(lat1);
    let mut azi1 = azi1_in;
    let mut salp1 = salp1_in;
    let mut calp1 = calp1_in;
    if is_nan(salp1_in) or is_nan(calp1_in) {
        azi1 = ang_normalize(azi1_in);
        let (s, c) = sincosd(ang_round(azi1_in));
        salp1 = s;
        calp1 = c;
    }
    let (sb1, cb1) = sincosd(ang_round(lat1f));
    let (sbet1, cb1n) = norm(sb1 * g.f1, cb1);
    let cbet1 = pmax(tiny(), cb1n);
    let dn1 = (1.0 + g.ep2 * sq(sbet1)).sqrt();
    let salp0 = salp1 * cbet1;
    let calp0 = hypot(calp1, salp1 * sbet1);
    let somg1 = salp0 * sbet1;
    let comg1 = if sbet1 != 0.0 or calp1 != 0.0 { cbet1 * calp1 } else { 1.0 };
    let (ssig1, csig1) = norm(sbet1, comg1);
    let k2 = sq(calp0) * g.ep2;
    let eps = k2 / (2.0 * (1.0 + (1.0 + k2).sqrt()) + k2);
    let mut ln = Line {
        a: g.a, f: g.f, b: g.b, c2: g.c2, f1: g.f1, caps: caps, lat1: lat1f, lon1: lon1,
        azi1: azi1, salp1: salp1, calp1: calp1, dn1: dn1, salp0: salp0, calp0: calp0,
        ssig1: ssig1, somg1: somg1, csig1: csig1, comg1: comg1, k2: k2,
        a1m1: 0.0, c1a: Vec.new(), b11: 0.0, stau1: 0.0, ctau1: 0.0, c1pa: Vec.new(),
        a2m1: 0.0, c2a: Vec.new(), b21: 0.0, c3a: Vec.new(), a3c: 0.0, b31: 0.0,
        c4a: Vec.new(), a4: 0.0, b41: 0.0, s13: f64.NAN, a13: f64.NAN,
    };
    if has(caps, CAP_C1) {
        ln.a1m1 = a1m1f(eps);
        ln.c1a = c1f(eps);
        ln.b11 = sin_cos_series(true, ssig1, csig1, ln.c1a);
        let s = ln.b11.sin();
        let c = ln.b11.cos();
        ln.stau1 = ssig1 * c + csig1 * s;
        ln.ctau1 = csig1 * c - ssig1 * s;
    }
    if has(caps, CAP_C1P) {
        ln.c1pa = c1pf(eps);
    }
    if has(caps, CAP_C2) {
        ln.a2m1 = a2m1f(eps);
        ln.c2a = c2f(eps);
        ln.b21 = sin_cos_series(true, ssig1, csig1, ln.c2a);
    }
    if has(caps, CAP_C3) {
        ln.c3a = c3f(g, eps);
        ln.a3c = -g.f * salp0 * a3f(g, eps);
        ln.b31 = sin_cos_series(true, ssig1, csig1, ln.c3a);
    }
    if has(caps, CAP_C4) {
        ln.c4a = c4f(g, eps);
        ln.a4 = sq(g.a) * calp0 * salp0 * g.e2;
        ln.b41 = sin_cos_series(false, ssig1, csig1, ln.c4a);
    }
    ln
}

impl Line {
    fn gen_position(ref self, arcmode: bool, s12_a12: f64, outmask0: i64) -> Pos {
        let mut r = Pos { a12: f64.NAN, lat2: f64.NAN, lon2: f64.NAN, azi2: f64.NAN, s12: f64.NAN, m12: f64.NAN, mm12: f64.NAN, mm21: f64.NAN, ss12: f64.NAN };
        let outmask = outmask0 & self.caps & OUT_MASK;
        if not (arcmode or has(self.caps, OUT_MASK & DISTANCE_IN)) {
            return r;
        }
        let mut b12 = 0.0;
        let mut ab1 = 0.0;
        let mut sig12 = 0.0;
        let mut ssig12 = 0.0;
        let mut csig12 = 0.0;
        if arcmode {
            sig12 = radians(s12_a12);
            let (s, c) = sincosd(s12_a12);
            ssig12 = s;
            csig12 = c;
        } else {
            let mut tau12 = s12_a12 / (self.b * (1.0 + self.a1m1));
            if not finite(tau12) {
                tau12 = f64.NAN;
            }
            let s = tau12.sin();
            let c = tau12.cos();
            b12 = -sin_cos_series(true, self.stau1 * c + self.ctau1 * s, self.ctau1 * c - self.stau1 * s, self.c1pa);
            sig12 = tau12 - (b12 - self.b11);
            ssig12 = sig12.sin();
            csig12 = sig12.cos();
            if self.f.abs() > 0.01 {
                let ssig2 = self.ssig1 * csig12 + self.csig1 * ssig12;
                let csig2 = self.csig1 * csig12 - self.ssig1 * ssig12;
                b12 = sin_cos_series(true, ssig2, csig2, self.c1a);
                let serr = (1.0 + self.a1m1) * (sig12 + (b12 - self.b11)) - s12_a12 / self.b;
                sig12 = sig12 - serr / (1.0 + self.k2 * sq(ssig2)).sqrt();
                ssig12 = sig12.sin();
                csig12 = sig12.cos();
            }
        }
        let ssig2 = self.ssig1 * csig12 + self.csig1 * ssig12;
        let mut csig2 = self.csig1 * csig12 - self.ssig1 * ssig12;
        let dn2 = (1.0 + self.k2 * sq(ssig2)).sqrt();
        if has(outmask, DISTANCE | REDUCEDLENGTH | GEODESICSCALE) {
            if arcmode or self.f.abs() > 0.01 {
                b12 = sin_cos_series(true, ssig2, csig2, self.c1a);
            }
            ab1 = (1.0 + self.a1m1) * (b12 - self.b11);
        }
        let sbet2 = self.calp0 * ssig2;
        let mut cbet2 = hypot(self.salp0, self.calp0 * csig2);
        if cbet2 == 0.0 {
            cbet2 = tiny();
            csig2 = tiny();
        }
        let salp2 = self.salp0;
        let calp2 = self.calp0 * csig2;
        if has(outmask, DISTANCE) {
            r.s12 = if arcmode { self.b * ((1.0 + self.a1m1) * sig12 + ab1) } else { s12_a12 };
        }
        if has(outmask, LONGITUDE) {
            let somg2 = self.salp0 * ssig2;
            let comg2 = csig2;
            let e = 1.0.copysign(self.salp0);
            let omg12 = if has(outmask, LONG_UNROLL) {
                e * (sig12 - (ssig2.atan2(csig2) - self.ssig1.atan2(self.csig1)) + ((e * somg2).atan2(comg2) - (e * self.somg1).atan2(self.comg1)))
            } else {
                (somg2 * self.comg1 - comg2 * self.somg1).atan2(comg2 * self.comg1 + somg2 * self.somg1)
            };
            let lam12 = omg12 + self.a3c * (sig12 + (sin_cos_series(true, ssig2, csig2, self.c3a) - self.b31));
            let lon12 = degrees(lam12);
            r.lon2 = if has(outmask, LONG_UNROLL) { self.lon1 + lon12 } else { ang_normalize(ang_normalize(self.lon1) + ang_normalize(lon12)) };
        }
        if has(outmask, LATITUDE) {
            r.lat2 = atan2d(sbet2, self.f1 * cbet2);
        }
        if has(outmask, AZIMUTH) {
            r.azi2 = atan2d(salp2, calp2);
        }
        if has(outmask, REDUCEDLENGTH | GEODESICSCALE) {
            let b22 = sin_cos_series(true, ssig2, csig2, self.c2a);
            let ab2 = (1.0 + self.a2m1) * (b22 - self.b21);
            let j12 = (self.a1m1 - self.a2m1) * sig12 + (ab1 - ab2);
            if has(outmask, REDUCEDLENGTH) {
                r.m12 = self.b * ((dn2 * (self.csig1 * ssig2) - self.dn1 * (self.ssig1 * csig2)) - self.csig1 * csig2 * j12);
            }
            if has(outmask, GEODESICSCALE) {
                let t = self.k2 * (ssig2 - self.ssig1) * (ssig2 + self.ssig1) / (self.dn1 + dn2);
                r.mm12 = csig12 + (t * ssig2 - csig2 * j12) * self.ssig1 / self.dn1;
                r.mm21 = csig12 - (t * self.ssig1 - self.csig1 * j12) * ssig2 / dn2;
            }
        }
        if has(outmask, AREA) {
            let b42 = sin_cos_series(false, ssig2, csig2, self.c4a);
            let mut salp12 = 0.0;
            let mut calp12 = 0.0;
            if self.calp0 == 0.0 or self.salp0 == 0.0 {
                salp12 = salp2 * self.calp1 - calp2 * self.salp1;
                calp12 = calp2 * self.calp1 + salp2 * self.salp1;
            } else {
                salp12 = self.calp0 * self.salp0 * (if csig12 <= 0.0 { self.csig1 * (1.0 - csig12) + ssig12 * self.ssig1 } else { ssig12 * (self.csig1 * ssig12 / (1.0 + csig12) + self.ssig1) });
                calp12 = sq(self.salp0) + sq(self.calp0) * self.csig1 * csig2;
            }
            r.ss12 = self.c2 * salp12.atan2(calp12) + self.a4 * (b42 - self.b41);
        }
        r.a12 = if arcmode { s12_a12 } else { degrees(sig12) };
        r
    }

    fn set_distance(mut ref self, s13: f64) {
        self.s13 = s13;
        let p = self.gen_position(false, s13, 0);
        self.a13 = p.a12;
    }

    fn set_arc(mut ref self, a13: f64) {
        self.a13 = a13;
        let p = self.gen_position(true, a13, DISTANCE);
        self.s13 = p.s12;
    }

}

fn gen_direct(g: ref Geod, lat1: f64, lon1: f64, azi1: f64, arcmode: bool, s12_a12: f64, outmask0: i64) -> Pos {
    let mut outmask = outmask0;
    if not arcmode {
        outmask = outmask | DISTANCE_IN;
    }
    let ln = new_line(g, lat1, lon1, azi1, outmask, f64.NAN, f64.NAN);
    ln.gen_position(arcmode, s12_a12, outmask)
}



// ------------------------------------------------------------ Python ints and Decimals (for %g)

// A non-negative Python int: little-endian base-10**9 limbs, no zero top
// limb, and no limbs at all for zero. %g rounds the exact binary value of a
// float, which takes more digits than an i64 holds, so a Decimal of these
// limbs carries it.
const LIMB: i64 = 1000000000;

fn big_trim(a: own Vec[i64]) -> Vec[i64] {
    let mut v = a;
    while v.len() > 0 and v[v.len() - 1] == 0 {
        let _ = v.pop();
    }
    v
}

fn big_of(n: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    let mut x = n;
    while x > 0 {
        v.push(x % LIMB);
        x = x / LIMB;
    }
    v
}

fn big_is_zero(a: ref Vec[i64]) -> bool {
    a.len() == 0
}

fn big_cmp(a: ref Vec[i64], b: ref Vec[i64]) -> i64 {
    if a.len() != b.len() {
        return if a.len() < b.len() { -1 } else { 1 };
    }
    let mut i = a.len();
    while i > 0 {
        i -= 1;
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 };
        }
    }
    0
}

fn big_add(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let n = if a.len() > b.len() { a.len() } else { b.len() };
    let mut out: Vec[i64] = Vec.new();
    let mut carry = 0;
    let mut i = 0;
    while i < n {
        let x = (if i < a.len() { a[i] } else { 0 }) + (if i < b.len() { b[i] } else { 0 }) + carry;
        out.push(x % LIMB);
        carry = x / LIMB;
        i += 1;
    }
    if carry > 0 {
        out.push(carry);
    }
    out
}

// a - b for a >= b.
fn big_sub(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut borrow = 0;
    let mut i = 0;
    while i < a.len() {
        let mut x = a[i] - borrow - (if i < b.len() { b[i] } else { 0 });
        if x < 0 {
            x += LIMB;
            borrow = 1;
        } else {
            borrow = 0;
        }
        out.push(x);
        i += 1;
    }
    big_trim(out)
}

fn big_mul_small(a: ref Vec[i64], m: i64) -> Vec[i64] {
    if m == 0 {
        return Vec.new();
    }
    let mut out: Vec[i64] = Vec.new();
    let mut carry = 0;
    for x in a {
        let p = *x * m + carry;
        out.push(p % LIMB);
        carry = p / LIMB;
    }
    while carry > 0 {
        out.push(carry % LIMB);
        carry = carry / LIMB;
    }
    out
}

fn big_mul(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    if a.len() == 0 or b.len() == 0 {
        return Vec.new();
    }
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < a.len() + b.len() {
        out.push(0);
        k += 1;
    }
    let mut i = 0;
    while i < a.len() {
        let mut carry = 0;
        let ai = a[i];
        let mut j = 0;
        while j < b.len() {
            let p = out[i + j] + ai * b[j] + carry;
            out[i + j] = p % LIMB;
            carry = p / LIMB;
            j += 1;
        }
        let mut t = i + b.len();
        while carry > 0 {
            let p = out[t] + carry;
            out[t] = p % LIMB;
            carry = p / LIMB;
            t += 1;
        }
        i += 1;
    }
    big_trim(out)
}

fn big_divmod_small(a: ref Vec[i64], d: i64) -> (Vec[i64], i64) {
    let mut q: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < a.len() {
        q.push(0);
        k += 1;
    }
    let mut rem = 0;
    let mut i = a.len();
    while i > 0 {
        i -= 1;
        let cur = rem * LIMB + a[i];
        q[i] = cur / d;
        rem = cur % d;
    }
    (big_trim(q), rem)
}

fn pow10_small(n: i64) -> i64 {
    let mut p = 1;
    let mut k = 0;
    while k < n {
        p *= 10;
        k += 1;
    }
    p
}

// a * 10**n.
fn big_shift(a: ref Vec[i64], n: i64) -> Vec[i64] {
    if a.len() == 0 {
        return Vec.new();
    }
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < n / 9 {
        out.push(0);
        k += 1;
    }
    for x in a {
        out.push(*x);
    }
    big_mul_small(out, pow10_small(n % 9))
}

fn big_pow10(n: i64) -> Vec[i64] {
    big_shift(big_of(1), n)
}

// divmod(a, 10**n).
fn big_split(a: ref Vec[i64], n: i64) -> (Vec[i64], Vec[i64]) {
    let limbs = n / 9;
    let mut hi: Vec[i64] = Vec.new();
    let mut lo: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < a.len() {
        if i < limbs {
            lo.push(a[i]);
        } else {
            hi.push(a[i]);
        }
        i += 1;
    }
    let (q, r) = big_divmod_small(hi, pow10_small(n % 9));
    // the remainder's top limb is r times 10**(9*limbs)
    while lo.len() < limbs {
        lo.push(0);
    }
    lo.push(r);
    (q, big_trim(lo))
}

fn big_digits(a: ref Vec[i64]) -> i64 {
    if a.len() == 0 {
        return 1;
    }
    let mut d = (a.len() - 1) * 9;
    let mut top = a[a.len() - 1];
    while top > 0 {
        d += 1;
        top = top / 10;
    }
    d
}

fn big_is_odd(a: ref Vec[i64]) -> bool {
    a.len() > 0 and a[0] % 2 == 1
}

fn big_last_digit(a: ref Vec[i64]) -> i64 {
    if a.len() == 0 { 0 } else { a[0] % 10 }
}

fn big_to_string(a: ref Vec[i64]) -> String {
    if a.len() == 0 {
        return "0".to_string();
    }
    let mut out = f"{a[a.len() - 1]}";
    let mut i = a.len() - 1;
    while i > 0 {
        i -= 1;
        let s = f"{a[i]}";
        let mut k = s.len();
        while k < 9 {
            out.push('0');
            k += 1;
        }
        out.push_str(s);
    }
    out
}

fn big_from_digits(s: ref String) -> Vec[i64] {
    let mut v = Vec.new();
    for c in s.chars() {
        v = big_add(big_mul_small(v, 10), big_of(c as i64 - 48));
    }
    v
}

// divmod(a, b) for b > 0, by long division one decimal digit at a time.
fn big_divmod(a: ref Vec[i64], b: ref Vec[i64]) -> (Vec[i64], Vec[i64]) {
    if b.len() == 1 {
        let (q, r) = big_divmod_small(a, b[0]);
        return (q, big_of(r));
    }
    let digits: Vec[char] = big_to_string(a).chars().collect();
    let mut q: Vec[i64] = Vec.new();
    let mut rem: Vec[i64] = Vec.new();
    for c in digits {
        rem = big_add(big_mul_small(rem, 10), big_of(c as i64 - 48));
        let mut qd = 0;
        while big_cmp(rem, b) >= 0 {
            rem = big_sub(rem, b);
            qd += 1;
        }
        q = big_add(big_mul_small(q, 10), big_of(qd));
    }
    (q, rem)
}

// float(n), correctly rounded as Python converts an int.
fn big_to_f64(a: ref Vec[i64]) -> f64 {
    f64.parse(big_to_string(a)).unwrap_or(0.0)
}

fn big_from_u64(n: u64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    let mut x = n;
    while x > 0 {
        v.push((x % 1000000000) as i64);
        x = x / 1000000000;
    }
    v
}

// ------------------------------------------------------------ Decimal

// A finite non-negative decimal.Decimal: coefficient and exponent, kept
// exactly as Python keeps them (Decimal('1.0') and Decimal('1') differ).
// Arithmetic rounds to the default context, 28 digits half-even.
struct Dec {
    coef: Vec[i64],
    exp: i64,
}

const PREC: i64 = 28;

impl Clone for Dec {
    fn clone(ref self) -> Dec {
        Dec { coef: self.coef.clone(), exp: self.exp }
    }
}

fn dec_int(n: i64) -> Dec {
    Dec { coef: big_of(n), exp: 0 }
}

fn dec_big(b: ref Vec[i64]) -> Dec {
    Dec { coef: b.clone(), exp: 0 }
}

// Context._fix for a finite number: round to `prec` digits, half-even.
fn dec_fix(d: own Dec, prec: i64) -> Dec {
    if big_is_zero(d.coef) {
        return d;
    }
    let n = big_digits(d.coef);
    if n <= prec {
        return d;
    }
    let drop = n - prec;
    let (q, r) = big_split(d.coef, drop);
    let half = big_mul_small(big_pow10(drop - 1), 5);
    let c = big_cmp(r, half);
    let mut coef = q;
    let mut exp = d.exp + drop;
    if c > 0 or (c == 0 and big_is_odd(coef)) {
        coef = big_add(coef, big_of(1));
        if big_digits(coef) > prec {
            let (q2, _) = big_divmod_small(coef, 10);
            coef = q2;
            exp += 1;
        }
    }
    Dec { coef: coef, exp: exp }
}

fn dec_mul(a: ref Dec, b: ref Dec) -> Dec {
    dec_fix(Dec { coef: big_mul(a.coef, b.coef), exp: a.exp + b.exp }, PREC)
}

// The coefficient of `d` at the smaller exponent `exp`.
fn dec_align(d: ref Dec, exp: i64) -> Vec[i64] {
    big_shift(d.coef, d.exp - exp)
}

fn dec_add(a: ref Dec, b: ref Dec) -> Dec {
    let exp = if a.exp < b.exp { a.exp } else { b.exp };
    if big_is_zero(a.coef) and big_is_zero(b.coef) {
        return Dec { coef: Vec.new(), exp: exp };
    }
    // Decimal.__add__ rescales the nonzero operand when the other is zero.
    if big_is_zero(a.coef) or big_is_zero(b.coef) {
        let other = if big_is_zero(a.coef) { b } else { a };
        let mut e = exp;
        if other.exp - PREC - 1 > e {
            e = other.exp - PREC - 1;
        }
        let coef = if e < other.exp { dec_align(other, e) } else { other.coef.clone() };
        let e2 = if e < other.exp { e } else { other.exp };
        return dec_fix(Dec { coef: coef, exp: e2 }, PREC);
    }
    dec_fix(Dec { coef: big_add(dec_align(a, exp), dec_align(b, exp)), exp: exp }, PREC)
}

fn dec_cmp(a: ref Dec, b: ref Dec) -> i64 {
    let az = big_is_zero(a.coef);
    let bz = big_is_zero(b.coef);
    if az or bz {
        return if az and bz { 0 } else if az { -1 } else { 1 };
    }
    // compare adjusted exponents first, then the aligned coefficients
    let adj_a = a.exp + big_digits(a.coef);
    let adj_b = b.exp + big_digits(b.coef);
    if adj_a != adj_b {
        return if adj_a < adj_b { -1 } else { 1 };
    }
    let exp = if a.exp < b.exp { a.exp } else { b.exp };
    big_cmp(dec_align(a, exp), dec_align(b, exp))
}

// Decimal.__truediv__ at `prec` digits.
fn dec_div(a: ref Dec, b: ref Dec, prec: i64) -> Dec {
    if big_is_zero(a.coef) {
        return Dec { coef: Vec.new(), exp: a.exp - b.exp };
    }
    let shift = big_digits(b.coef) - big_digits(a.coef) + prec + 1;
    let mut exp = a.exp - b.exp - shift;
    let (q, r) = if shift >= 0 {
        big_divmod(big_shift(a.coef, shift), b.coef)
    } else {
        big_divmod(a.coef, big_shift(b.coef, -shift))
    };
    let mut coeff = q;
    if not big_is_zero(r) {
        // not exact: nudge a coefficient ending in 0 or 5 so it rounds right
        if big_last_digit(coeff) % 5 == 0 {
            coeff = big_add(coeff, big_of(1));
        }
    } else {
        let ideal = a.exp - b.exp;
        while exp < ideal and big_last_digit(coeff) == 0 {
            let (q2, _) = big_divmod_small(coeff, 10);
            coeff = q2;
            exp += 1;
        }
    }
    dec_fix(Dec { coef: coeff, exp: exp }, prec)
}

// round(d): to an int, half-even.
fn dec_round_int(d: ref Dec) -> Vec[i64] {
    if d.exp >= 0 {
        return big_shift(d.coef, d.exp);
    }
    let (q, r) = big_split(d.coef, -d.exp);
    let half = big_mul_small(big_pow10(-d.exp - 1), 5);
    let c = big_cmp(r, half);
    if c > 0 or (c == 0 and big_is_odd(q)) {
        big_add(q, big_of(1))
    } else {
        q
    }
}

// str(Decimal), the scientific form when the exponent is positive or the
// number is small.
fn dec_to_string(d: ref Dec) -> String {
    let digits = big_to_string(d.coef);
    let n = digits.len();
    let leftdigits = d.exp + n;
    let dotplace = if d.exp <= 0 and leftdigits > -6 { leftdigits } else { 1 };
    let mut out = String.new();
    if dotplace <= 0 {
        out.push_str("0.");
        let mut k = 0;
        while k < -dotplace {
            out.push('0');
            k += 1;
        }
        out.push_str(digits);
    } else if dotplace >= n {
        out.push_str(digits);
        let mut k = n;
        while k < dotplace {
            out.push('0');
            k += 1;
        }
    } else {
        out.push_str(digits[0..dotplace]);
        out.push('.');
        out.push_str(digits[dotplace..n]);
    }
    if leftdigits != dotplace {
        let e = leftdigits - dotplace;
        if e >= 0 {
            out.push_str(f"E+{e}");
        } else {
            out.push_str(f"E{e}");
        }
    }
    out
}

fn dec_to_f64(d: ref Dec) -> f64 {
    f64.parse(dec_to_string(d)).unwrap_or(0.0)
}

// Decimal(x) for a finite float x >= 0: exactly its binary value.
fn dec_from_f64(x: f64) -> Dec {
    let bits = x.to_bits();
    let eb = ((bits >> 52) & 0x7ff) as i64;
    let frac = bits & 0xfffffffffffff;
    let mut m: u64 = if eb == 0 { frac } else { frac | 0x10000000000000 };
    let mut e: i64 = if eb == 0 { -1074 } else { eb - 1075 };
    if m == 0 {
        return dec_int(0);
    }
    while m % 2 == 0 {
        m = m / 2;
        e += 1;
    }
    let mut coef = big_from_u64(m);
    if e >= 0 {
        let mut k = 0;
        while k < e {
            coef = big_mul_small(coef, 2);
            k += 1;
        }
        return Dec { coef: coef, exp: 0 };
    }
    let mut k = 0;
    while k < -e {
        coef = big_mul_small(coef, 5);
        k += 1;
    }
    Dec { coef: coef, exp: e }
}

// Decimal(s) for the plain and exponent forms the jobs use.
fn dec_from_str(s: ref String) -> Dec {
    let mut digits = String.new();
    let mut exp = 0;
    let mut after_dot = false;
    let mut e_part = String.new();
    let mut in_exp = false;
    for c in s.chars() {
        if in_exp {
            e_part.push(c);
        } else if c == 'e' or c == 'E' {
            in_exp = true;
        } else if c == '.' {
            after_dot = true;
        } else {
            digits.push(c);
            if after_dot {
                exp -= 1;
            }
        }
    }
    if e_part.len() > 0 {
        let neg = e_part.starts_with("-");
        let body = if neg or e_part.starts_with("+") { e_part[1..e_part.len()].to_string() } else { e_part.clone() };
        let v = big_to_f64(big_from_digits(body)) as i64;
        exp += if neg { -v } else { v };
    }
    Dec { coef: big_from_digits(digits), exp: exp }
}

// ------------------------------------------------------------- jobs

fn out(s: ref String) {
    println(f"  {s}");
}

// Job text uses \t, \n, \\ and \uXXXX escapes.
fn unescape(s: ref String) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut res: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < cs.len() {
        let c = cs[i];
        if c == '\\' and i + 1 < cs.len() {
            let n = cs[i + 1];
            if n == 't' {
                res.push(9);
            } else if n == 'n' {
                res.push(10);
            } else if n == 'u' {
                let mut v = 0;
                let mut k = i + 2;
                while k < i + 6 and k < cs.len() {
                    v = v * 16 + hex_digit(cs[k]);
                    k += 1;
                }
                res.push(v);
                i += 4;
            } else {
                res.push(n as i64);
            }
            i += 2;
            continue;
        }
        res.push(c as i64);
        i += 1;
    }
    to_string(res)
}

// s.partition(sep): the text before the first sep and the text after it.
fn partition(s: ref String, sep: char) -> (String, String) {
    let mut head = String.new();
    let mut tail = String.new();
    let mut seen = false;
    for c in s.chars() {
        if seen {
            tail.push(c);
        } else if c == sep {
            seen = true;
        } else {
            head.push(c);
        }
    }
    (head, tail)
}

fn drop_chars(s: ref String, n: i64) -> String {
    let mut res = String.new();
    let mut k = 0;
    for c in s.chars() {
        if k >= n {
            res.push(c);
        }
        k += 1;
    }
    res
}

// `-` is None, `i:` an int, `f:` a float, `s:` a str.
fn value(spec: ref String) -> Result[Val, Exc] {
    if spec == "-" {
        return Ok(Val.Nothing);
    }
    let (kind, rest) = partition(spec, ':');
    if kind == "i" {
        return Ok(Val.Int(float_of(rest)? as i64));
    }
    if kind == "f" {
        return Ok(Val.Flt(float_of(rest)?));
    }
    Ok(Val.Text(unescape(rest)))
}

fn show_point(p: ref Point) {
    out(f"repr {point_repr(p)}");
    out(f"str {point_str(p)}");
    out(f"unicode {point_unicode(p)}");
    out(f"decimal {point_decimal(p)}");
    out(f"with altitude {point_format(p, "km", Symbols { deg: String.new(), arcmin: "m".to_string(), arcsec: "s".to_string() })}");
    let mut alts: Vec[String] = Vec.new();
    for u in ["km", "m", "mi", "ft", "nm", "nmi"] {
        alts.push(format_distance(p.altitude, u.to_string()).unwrap_or(String.new()));
    }
    out(f"altitude {join_strs(alts, " ")}");
    out(f"items {fmt(p.latitude)} {fmt(p.longitude)} {fmt(p.altitude)}");
}

// A job's point: `s:<text>` is a string, else comma-separated floats (a
// tuple).
fn point_arg(spec: ref String) -> Result[Val, Exc] {
    if spec.starts_with("s:") {
        return Ok(Val.Text(unescape(drop_chars(spec, 2))));
    }
    let mut items: Vec[Val] = Vec.new();
    for x in split_on(spec, ',') {
        items.push(Val.Flt(float_of(x)?));
    }
    Ok(Val.Items(items))
}

fn point_val(p: ref Point) -> Val {
    Val.Items(vec![Val.Flt(p.latitude), Val.Flt(p.longitude), Val.Flt(p.altitude)])
}

fn class_kind(algo: ref String) -> Result[i64, Exc] {
    if algo == "distance" or algo == "geodesic" {
        Ok(2)
    } else if algo == "great_circle" {
        Ok(1)
    } else if algo == "Distance" {
        Ok(0)
    } else {
        Err(exc("KeyError", str_repr_s(algo)))
    }
}

// algo(*points, **kwargs) from a job's fields.
fn build(rx: ref Program, algo: ref String, fields: ref Vec[String], from: i64) -> Result[Dist, Exc] {
    let mut args: Vec[Val] = Vec.new();
    let mut kws: Vec[(String, String)] = Vec.new();
    let mut k = from;
    while k < fields.len() {
        let f = fields[k].clone();
        k += 1;
        if f.contains("=") and not f.starts_with("s:") {
            let (key, v) = partition(f, '=');
            if key == "override" {
                continue;
            }
            if key != "ellipsoid" {
                let _ = float_of(v)?;
            }
            kws.push((key, v));
        } else if f.starts_with("n:") {
            args.push(Val.Flt(float_of(drop_chars(f, 2))?));
        } else {
            args.push(point_arg(f)?);
        }
    }
    build_dist(rx, class_kind(algo)?, args, kws)
}

fn show_distance(d: ref Dist) {
    out(f"repr {dist_repr(d)}");
    out(f"str {dist_str(d)}");
    out(f"km {fmt(d.km)} m {fmt(d_m(d))} mi {fmt(d_mi(d))} ft {fmt(d_ft(d))} nm {fmt(d_nm(d))}");
}

// ------------------------------------------------------------- commands

fn cmd_point(rx: ref Program, f: ref Vec[String]) -> Result[(), Exc] {
    let p = new_point(rx, Val.Text(unescape(f[1])), Val.Nothing, Val.Nothing)?;
    show_point(p);
    Ok(())
}

fn field(f: ref Vec[String], k: i64) -> String {
    if k < f.len() { f[k].clone() } else { "-".to_string() }
}

fn cmd_make(rx: ref Program, f: ref Vec[String]) -> Result[(), Exc] {
    let a = value(field(f, 1))?;
    let b = value(field(f, 2))?;
    let c = value(field(f, 3))?;
    let p = new_point(rx, a, b, c)?;
    out(f"repr {point_repr(p)}");
    out(f"str {point_str(p)}");
    out(f"decimal {point_decimal(p)}");
    Ok(())
}

fn cmd_seq(rx: ref Program, f: ref Vec[String]) -> Result[(), Exc] {
    let mut items: Vec[Val] = Vec.new();
    let mut k = 1;
    while k < f.len() {
        items.push(value(f[k])?);
        k += 1;
    }
    let p = new_point(rx, Val.Items(items), Val.Nothing, Val.Nothing)?;
    out(f"repr {point_repr(p)}");
    Ok(())
}

fn cmd_lonlat(rx: ref Program, f: ref Vec[String]) -> Result[(), Exc] {
    let lon = float_of(f[1])?;
    let lat = float_of(f[2])?;
    let alt = if f.len() > 3 { float_of(f[3])? } else { 0.0 };
    let p = point3(rx, lat, lon, alt)?;
    out(f"repr {point_repr(p)}");
    Ok(())
}

fn cmd_degrees(f: ref Vec[String]) -> Result[(), Exc] {
    let x = float_of(f[1])?;
    out(format_degrees(x, symbols_of(f[2])));
    Ok(())
}

fn cmd_parse_degrees(f: ref Vec[String]) -> Result[(), Exc] {
    let direction = if f[4] == "-" { None } else { Some(f[4].clone()) };
    let x = parse_degrees(Val.Text(f[1].clone()), Val.Text(f[2].clone()), Val.Text(f[3].clone()), direction)?;
    out(fmt(x));
    Ok(())
}

fn cmd_altitude(f: ref Vec[String]) -> Result[(), Exc] {
    let dist = if f[1] == "-" { None } else { Some(f[1].clone()) };
    match parse_altitude(dist, Some(f[2].clone()))? {
        Some(x) => out(fmt(x)),
        None => out("None".to_string()),
    }
    Ok(())
}

fn cmd_units(f: ref Vec[String]) -> Result[(), Exc] {
    let mut kws: Vec[(String, f64)] = Vec.new();
    let mut k = 2;
    while k < f.len() {
        let (key, v) = partition(f[k], '=');
        kws.push((key, float_of(v)?));
        k += 1;
    }
    out(fmt(call_unit(f[1], kws)?));
    Ok(())
}

fn cmd_dist(rx: ref Program, f: ref Vec[String]) -> Result[(), Exc] {
    let d = build(rx, f[1], f, 2)?;
    show_distance(d);
    Ok(())
}

fn cmd_dest(rx: ref Program, f: ref Vec[String]) -> Result[(), Exc] {
    let point = point_arg(f[2])?;
    let bearing = float_of(f[3])?;
    let d = build(rx, f[1], f, 4)?;
    let mut km = d.km;
    let mut k = 4;
    while k < f.len() {
        if f[k].starts_with("override=") {
            km = dist_of(0, float_of(drop_chars(f[k], 9))?).km;
            break;
        }
        k += 1;
    }
    let p = destination(rx, d, point, bearing, km)?;
    out(f"repr {point_repr(p)}");
    out(f"str {point_str(p)}");
    Ok(())
}

// An arith operand: None, a number, or a distance.
enum Opd {
    Nothing,
    Num(f64),
    D(Dist),
}

fn operand(rx: ref Program, spec: ref String) -> Result[Opd, Exc] {
    if spec == "-" {
        return Ok(Opd.Nothing);
    }
    let (kind, rest) = partition(spec, ':');
    if kind == "n" {
        return Ok(Opd.Num(float_of(rest)?));
    }
    let mut kws: Vec[(String, String)] = Vec.new();
    for kv in split_on(rest, ',') {
        let (key, v) = partition(kv, '=');
        if key != "ellipsoid" {
            let _ = float_of(v)?;
        }
        kws.push((key, v));
    }
    let k = if kind == "d" {
        0
    } else if kind == "gc" {
        1
    } else if kind == "geo" {
        2
    } else {
        return Err(exc("KeyError", str_repr_s(kind)));
    };
    Ok(Opd.D(build_dist(rx, k, Vec.new(), kws)?))
}

// What an operation gives back: a distance, a float or a bool.
enum Res {
    D(Dist),
    F(f64),
    B(bool),
}

fn added_error() -> Exc {
    exc("TypeError", "Distance instance must be added with Distance instance.".to_string())
}

fn mul_error() -> Exc {
    exc("TypeError", "Distance instance must be multiplicated with numbers.".to_string())
}

fn none_error(op: Str) -> Exc {
    exc("TypeError", f"unsupported operand type(s) for {op}: 'float' and 'NoneType'")
}

fn opd_km(b: ref Opd, op: Str) -> Result[f64, Exc] {
    match b {
        Opd.D(d) => Ok(d.km),
        Opd.Num(x) => Ok(*x),
        Opd.Nothing => Err(none_error(op)),
    }
}

// cmp(a, b) as geopy defines it: (a > b) - (a < b).
fn cmp_f(a: f64, b: f64) -> i64 {
    let gt = if a > b { 1 } else { 0 };
    let lt = if a < b { 1 } else { 0 };
    gt - lt
}

fn compute(op: ref String, a: ref Dist, b: ref Opd) -> Result[Res, Exc] {
    if op == "add" or op == "sub" {
        let other = match b {
            Opd.D(d) => if op == "sub" { -d.km } else { d.km },
            Opd.Num(_) => return Err(added_error()),
            Opd.Nothing => {
                if op == "sub" {
                    return Err(exc("TypeError", "bad operand type for unary -: 'NoneType'".to_string()));
                }
                return Err(added_error());
            }
        };
        return Ok(Res.D(dist_of(a.kind, a.km + other)));
    }
    if op == "neg" {
        return Ok(Res.D(dist_of(a.kind, -a.km)));
    }
    if op == "mul" or op == "rmul" {
        return match b {
            Opd.D(_) => Err(mul_error()),
            Opd.Num(x) => Ok(Res.D(dist_of(a.kind, if op == "mul" { a.km * *x } else { *x * a.km }))),
            Opd.Nothing => Err(none_error("*")),
        };
    }
    if op == "div" {
        return match b {
            Opd.D(d) => Ok(Res.F(float_div(a.km, d.km)?)),
            Opd.Num(x) => Ok(Res.D(dist_of(a.kind, float_div(a.km, *x)?))),
            Opd.Nothing => Err(none_error("/")),
        };
    }
    if op == "floordiv" {
        return match b {
            Opd.D(d) => Ok(Res.F(float_floordiv(a.km, d.km)?)),
            Opd.Num(x) => Ok(Res.D(dist_of(a.kind, float_floordiv(a.km, *x)?))),
            Opd.Nothing => Err(none_error("//")),
        };
    }
    if op == "abs" {
        return Ok(Res.D(dist_of(a.kind, a.km.abs())));
    }
    if op == "bool" {
        return Ok(Res.B(a.km != 0.0));
    }
    let c = cmp_f(a.km, opd_km(b, "<")?);
    if op == "eq" {
        Ok(Res.B(c == 0))
    } else if op == "ne" {
        Ok(Res.B(c != 0))
    } else if op == "lt" {
        Ok(Res.B(c < 0))
    } else if op == "le" {
        Ok(Res.B(c <= 0))
    } else if op == "gt" {
        Ok(Res.B(c > 0))
    } else {
        Ok(Res.B(c >= 0))
    }
}

fn cmd_arith(rx: ref Program, f: ref Vec[String]) -> Result[(), Exc] {
    let op = f[1].clone();
    let a = match operand(rx, f[2])? {
        Opd.D(d) => d,
        _ => return Err(exc("TypeError", "the left operand is not a distance".to_string())),
    };
    let b = operand(rx, f[3])?;
    let known = ["add", "sub", "neg", "mul", "rmul", "div", "floordiv", "abs", "bool", "eq", "ne", "lt", "le", "gt", "ge"];
    let mut is_op = false;
    for k in known {
        if op == k {
            is_op = true;
        }
    }
    if not is_op {
        show_distance(a);
        return Ok(());
    }
    match compute(op, a, b)? {
        Res.D(d) => {
            out(f"{kind_name(d.kind)} {dist_repr(d)}");
            if d.kind == 1 {
                out(f"model {fmt(d.radius)}");
            } else if d.kind == 2 {
                let (ea, eb, ef) = d.ell;
                out(f"model ({fmt(ea)}, {fmt(eb)}, {fmt(ef)})");
            }
        }
        Res.F(x) => out(fmt(x)),
        Res.B(t) => out(py_bool(t)),
    }
    Ok(())
}

fn read_lines(name: ref String) -> Result[Vec[String], Exc] {
    match fs.read_to_string(f"data/{name}") {
        Ok(text) => Ok(split_on(text, '\n')),
        Err(_) => Err(exc("OSError", f"cannot read {name}")),
    }
}

fn pair_km(rx: ref Program, kind: i64, a: ref Point, b: ref Point) -> Result[Dist, Exc] {
    build_dist(rx, kind, vec![point_val(a), point_val(b)], Vec.new())
}

fn cmd_route(rx: ref Program, f: ref Vec[String]) -> Result[(), Exc] {
    let mut points: Vec[Point] = Vec.new();
    for line in read_lines(f[1])?.into_iter() {
        if py_strip(line).len() == 0 {
            continue;
        }
        points.push(new_point(rx, Val.Text(line), Val.Nothing, Val.Nothing)?);
    }
    let mut n = 0;
    for p in points.iter() {
        out(f"{n} {point_decimal(p)}");
        n += 1;
    }
    let mut k = 0;
    while k + 1 < points.len() {
        let geo = pair_km(rx, 2, points[k], points[k + 1])?;
        let gc = pair_km(rx, 1, points[k], points[k + 1])?;
        out(f"leg {k}-{k + 1} geodesic {fmt(geo.km)} great_circle {fmt(gc.km)}");
        k += 1;
    }
    let mut all: Vec[Val] = Vec.new();
    for p in points.iter() {
        all.push(point_val(p));
    }
    let total = build_dist(rx, 2, all, Vec.new())?;
    out(f"total {dist_str(total)} ({fmt(d_mi(total))} mi, {fmt(d_nm(total))} nm)");
    let gc = build_dist(rx, 1, all, Vec.new())?;
    out(f"great circle {dist_str(gc)}");
    Ok(())
}

struct Near {
    km: f64,
    name: String,
    point: Point,
}

fn cmd_nearest(rx: ref Program, f: ref Vec[String]) -> Result[(), Exc] {
    let query = new_point(rx, Val.Text(f[2].clone()), Val.Nothing, Val.Nothing)?;
    let k = float_of(f[3])? as i64;
    let mut found: Vec[Near] = Vec.new();
    for line in read_lines(f[1])?.into_iter() {
        if line.len() == 0 {
            continue;
        }
        let (name, text) = partition(line, '|');
        let p = match new_point(rx, Val.Text(text), Val.Nothing, Val.Nothing) {
            Ok(p) => p,
            Err(e) => {
                if e.cls == "ValueError" {
                    out(f"skip {name}: {e.msg}");
                    continue;
                }
                return Err(e);
            }
        };
        let km = pair_km(rx, 2, query, p)?.km;
        // a stable insertion, as list.sort keeps equal keys in order
        let mut at = found.len();
        while at > 0 and found[at - 1].km > km {
            at -= 1;
        }
        found.insert(at, Near { km: km, name: name, point: p });
    }
    out(f"from {point_unicode(query)}");
    let mut n = 0;
    for t in found.iter() {
        if n >= k {
            break;
        }
        out(f"{t.name} {point_decimal(t.point)} {fmt(t.km)} km {fmt(u_miles(t.km, 0.0, 0.0, 0.0))} mi");
        n += 1;
    }
    Ok(())
}

fn cmd_fence(rx: ref Program, f: ref Vec[String]) -> Result[(), Exc] {
    let center = new_point(rx, Val.Text(f[2].clone()), Val.Nothing, Val.Nothing)?;
    let radius = float_of(f[3])?;
    let mut inside = 0;
    for line in read_lines(f[1])?.into_iter() {
        if line.len() == 0 {
            continue;
        }
        let p = new_point(rx, Val.Text(line.clone()), Val.Nothing, Val.Nothing)?;
        let d = match pair_km(rx, 1, center, p) {
            Ok(d) => d,
            Err(e) => {
                if e.cls == "ValueError" {
                    out(f"{line} error ValueError: {e.msg}");
                    continue;
                }
                return Err(e);
            }
        };
        let is_in = cmp_f(d.km, radius) <= 0;
        if is_in {
            inside += 1;
        }
        out(f"{if is_in { "in" } else { "out" }} {point_decimal(p)} {fmt(d_m(d))} m");
    }
    out(f"{inside} inside {fmt(radius)} km of {point_str(center)}");
    Ok(())
}

fn run_job(rx: ref Program, f: ref Vec[String]) -> Result[(), Exc] {
    let cmd = f[0].clone();
    if cmd == "point" {
        cmd_point(rx, f)
    } else if cmd == "make" {
        cmd_make(rx, f)
    } else if cmd == "seq" {
        cmd_seq(rx, f)
    } else if cmd == "lonlat" {
        cmd_lonlat(rx, f)
    } else if cmd == "degrees" {
        cmd_degrees(f)
    } else if cmd == "parse_degrees" {
        cmd_parse_degrees(f)
    } else if cmd == "altitude" {
        cmd_altitude(f)
    } else if cmd == "units" {
        cmd_units(f)
    } else if cmd == "dist" {
        cmd_dist(rx, f)
    } else if cmd == "dest" {
        cmd_dest(rx, f)
    } else if cmd == "arith" {
        cmd_arith(rx, f)
    } else if cmd == "route" {
        cmd_route(rx, f)
    } else if cmd == "nearest" {
        cmd_nearest(rx, f)
    } else if cmd == "fence" {
        cmd_fence(rx, f)
    } else {
        Err(exc("KeyError", str_repr_s(cmd)))
    }
}

fn write_inputs() -> Result[(), String] {
    let _ = fs.create_dir_all("data".to_string());
    for line in split_on(inputs_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, ' ');
        let path = f"data/{f[0]}";
        let _ = fs.create_dir_all(dirname_of(path));
        let bytes = if f.len() > 1 { hex_bytes(f[1]) } else { Vec.new() };
        if let Err(e) = fs.write_bytes(path, bytes) {
            return Err(f"cannot write {f[0]}: {e}");
        }
    }
    Ok(())
}

fn load_pattern() -> Result[Program, String] {
    let text = match fs.read_to_string("data/point_pattern.txt".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read point_pattern.txt: {e}"),
    };
    match compile(cps(text), flag_x() | flag_u()) {
        Ok(p) => Ok(p),
        Err(e) => Err(f"cannot compile POINT_PATTERN: {err_text(e)}"),
    }
}

fn main() {
    if let Err(e) = write_inputs() {
        eprintln(e);
        return;
    }
    let rx = match load_pattern() {
        Ok(p) => p,
        Err(e) => {
            eprintln(e);
            return;
        }
    };
    for line in split_on(jobs_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let job = hex_string(line);
        if job.starts_with("#") {
            println(job);
            continue;
        }
        let shown = job.replace("\t", " ");
        println(f"> {shown}");
        let f = split_on(job, '\t');
        if let Err(e) = run_job(rx, f) {
            println(f"  error {e.cls}: {e.msg}");
        }
    }
}

