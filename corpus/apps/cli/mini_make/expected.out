== make -n
tr a-z A-Z < src/a.c > build/a.o
echo "link build/app from 3 objects"
cat build/a.o build/b.o build/main.o > build/app
printf '%s\n' a.o b.o main.o > build/manifest.txt
(exit 0)
== make clean
rm -rf build
(exit 0)
== make -n
mkdir -p build
tr a-z A-Z < src/a.c > build/a.o
tr a-z A-Z < src/b.c > build/b.o
tr a-z A-Z < src/main.c > build/main.o
echo "link build/app from 3 objects"
cat build/a.o build/b.o build/main.o > build/app
printf '%s\n' a.o b.o main.o > build/manifest.txt
(exit 0)
