    let mut t = String.new();
    t.push_str("[ ,]\n");
    v.push(DataFile { path: "broken/comma_only.json5".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("7b61073a20317d0a");
    v.push(DataFile { path: "broken/control_key.json5".to_string(), hex: true, body: t });
    let mut t = String.new();
