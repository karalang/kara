// mini_json5: JSON5, ported from json5 0.17.3 (dpranke's pure-Python
// library, the one behind `python -m json5`), which reads Renovate and
// pnpm configs, Chromium-style feature lists and other hand-edited
// files that need comments, unquoted keys and trailing commas.
// - the parser: json5's own PEG parser (generated by glop), rule for
//   rule, so an error names the same line, column and character; then
//   the walk that turns its tree into values, with Python's int() and
//   float() over the number text and the duplicate-key check;
// - the encoder, JSON5Encoder: indent as a number or a string,
//   separators, sort_keys, quote_keys, trailing_commas, the four quote
//   styles, ensure_ascii and allow_nan, and its rule for which keys can
//   go unquoted (identifiers that are not reserved words);
// - `python -m json5`, its argument parser and the way it prints;
// - Python's repr of what comes out, so output compares directly.
//
// Text is code points, as Python's str is: columns count characters, a
// \uXXXX escape gives one code point each (so an escaped surrogate pair
// stays two lone surrogates, as json5 keeps it), and the character
// classes come from a table of Python's unicodedata (at the end).
// Integers keep their digits, so a value past 64 bits loads and dumps
// unchanged.
//
// The run writes data/, then runs data/jobs.tsv. expected.out is what
// oracle.py prints with the real json5.

enum Ast {
    Null,
    True,
    False,
    Obj(Vec[AstMember]),
    Arr(Vec[Ast]),
    Str(Vec[i64]),
    Num(String),
}

struct AstMember {
    key: Vec[i64],
    val: Ast,
}

#[derive(Clone)]
enum J {
    Null,
    Bool(bool),
    Int(String),
    Float(f64),
    Str(Vec[i64]),
    Arr(Vec[J]),
    Obj(Vec[Member]),
}

#[derive(Clone)]
struct Member {
    key: Vec[i64],
    val: J,
}

struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: own String) -> Exc {
    Exc { kind: kind.to_string(), msg: msg }
}

fn value_error(msg: own String) -> Exc {
    exc("ValueError", msg)
}

// "Kind: message", with a raw newline or carriage return in the message
// escaped so it stays on one line.
fn exc_line(e: ref Exc) -> String {
    let mut out = String.new();
    for ch in e.msg.chars() {
        if ch == '\n' {
            out.push_str("\\n");
        } else if ch == '\r' {
            out.push_str("\\r");
        } else {
            out.push(ch);
        }
    }
    f"{e.kind}: {out}"
}

// ------------------------------------------------------------- text

fn push_utf8(out: mut ref Vec[u8], cp: i64) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push((0xC0 | (cp >> 6)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else if cp < 0x10000 {
        out.push((0xE0 | (cp >> 12)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else {
        out.push((0xF0 | (cp >> 18)) as u8);
        out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    }
}

fn hex_n(v: i64, width: i64) -> String {
    let mut s = f"{v:x}";
    while s.len() < width {
        s = f"0{s}";
    }
    s
}

// Code points as UTF-8 for printing; a lone surrogate is written as
// \udXXX, the way Python's backslashreplace writes it.
fn to_text(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for c in s {
        if c >= 0xD800 and c <= 0xDFFF {
            for b in f"\\u{hex_n(c, 4)}".bytes() {
                out.push(b);
            }
        } else {
            push_utf8(mut out, c);
        }
    }
    String.from_utf8(out).unwrap_or("?".to_string())
}

fn cps_of(s: ref String) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for ch in s.chars() {
        out.push(ch as i64);
    }
    out
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn ascii_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for c in s {
        out.push(c as u8);
    }
    String.from_utf8(out).unwrap_or("?".to_string())
}

fn cmp_cps(a: ref Vec[i64], b: ref Vec[i64]) -> i64 {
    let mut i = 0;
    while i < a.len() and i < b.len() {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 };
        }
        i += 1;
    }
    a.len() - b.len()
}

fn same_cps(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    cmp_cps(a, b) == 0
}

fn is_cont(b: ref Vec[u8], i: i64, lo: i64, hi: i64) -> bool {
    i < b.len() and (b[i] as i64) >= lo and (b[i] as i64) <= hi
}

fn decode_error(b: ref Vec[u8], start: i64, end: i64, reason: Str) -> Exc {
    let what = if end - start == 1 {
        f"byte 0x{hex_n(b[start] as i64, 2)} in position {start}"
    } else {
        f"bytes in position {start}-{end - 1}"
    };
    exc("UnicodeDecodeError", f"'utf-8' codec can't decode {what}: {reason}")
}

// bytes.decode("utf-8"), with Python's errors for a bad sequence.
fn decode_utf8(b: ref Vec[u8]) -> Result[Vec[i64], Exc] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
            continue;
        }
        let mut need = 0;
        let mut lo = 0x80;
        let mut hi = 0xBF;
        if c >= 0xC2 and c <= 0xDF {
            need = 1;
        } else if c >= 0xE0 and c <= 0xEF {
            need = 2;
            if c == 0xE0 {
                lo = 0xA0;
            } else if c == 0xED {
                hi = 0x9F;
            }
        } else if c >= 0xF0 and c <= 0xF4 {
            need = 3;
            if c == 0xF0 {
                lo = 0x90;
            } else if c == 0xF4 {
                hi = 0x8F;
            }
        } else {
            return Err(decode_error(b, i, i + 1, "invalid start byte"));
        }
        let mut cp = if need == 1 { c & 0x1F } else if need == 2 { c & 0x0F } else { c & 0x07 };
        let mut k = 1;
        while k <= need {
            let ok = if k == 1 { is_cont(b, i + 1, lo, hi) } else { is_cont(b, i + k, 0x80, 0xBF) };
            if not ok {
                if i + k >= b.len() {
                    return Err(decode_error(b, i, b.len(), "unexpected end of data"));
                }
                return Err(decode_error(b, i, i + k, "invalid continuation byte"));
            }
            cp = (cp << 6) | ((b[i + k] as i64) & 0x3F);
            k += 1;
        }
        out.push(cp);
        i += need + 1;
    }
    Ok(out)
}

// str.isspace()
fn is_py_space(c: i64) -> bool {
    (c >= 9 and c <= 13) or (c >= 0x1C and c <= 0x20) or c == 0x85 or c == 0xA0 or c == 0x1680
        or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F
        or c == 0x205F or c == 0x3000
}

// ------------------------------------------------- character classes

// unicodedata.category, folded to the classes json5 and repr() ask
// about: 1 for a letter or Nl (an identifier start), 2 for Mn, Mc, Nd
// or Pc (an identifier part), 3 for Zs, 4 for what str.isprintable()
// refuses (Cc, Cf, Cs, Co, Cn, Zl, Zp), 0 for the rest.
#[derive(Clone)]
struct Cats {
    starts: Vec[i64],
    cls: Vec[i64],
}

fn load_cats() -> Cats {
    let mut starts: Vec[i64] = Vec.new();
    let mut cls: Vec[i64] = Vec.new();
    let mut at = 0;
    let mut num = 0;
    for b in cat_table().bytes() {
        if b == b',' {
            at += num / 10;
            starts.push(at);
            cls.push(num % 10);
            num = 0;
        } else if b >= b'a' {
            num = num * 16 + (b - b'a') as i64 + 10;
        } else {
            num = num * 16 + (b - b'0') as i64;
        }
    }
    Cats { starts: starts, cls: cls }
}

fn cat(t: ref Cats, c: i64) -> i64 {
    let mut lo = 0;
    let mut hi = t.starts.len() - 1;
    while lo < hi {
        let mid = (lo + hi + 1) / 2;
        if t.starts[mid] <= c {
            lo = mid;
        } else {
            hi = mid - 1;
        }
    }
    t.cls[lo]
}

fn printable(t: ref Cats, c: i64) -> bool {
    let k = cat(t, c);
    not (k == 4 or (k == 3 and c != 32))
}

// --------------------------------------------------- big hex numbers

// int(text, base=16) printed in decimal, for a hex literal of any size.
fn hex_to_dec(hs: ref Vec[i64]) -> String {
    let mut limbs: Vec[i64] = Vec.new();
    limbs.push(0);
    for h in hs {
        let mut carry = if h >= 97 { h - 87 } else if h >= 65 { h - 55 } else { h - 48 };
        let mut i = 0;
        while i < limbs.len() {
            let x = limbs[i] * 16 + carry;
            limbs[i] = x % 1000000000;
            carry = x / 1000000000;
            i += 1;
        }
        if carry > 0 {
            limbs.push(carry);
        }
    }
    let mut s = f"{limbs[limbs.len() - 1]}";
    let mut i = limbs.len() - 2;
    while i >= 0 {
        let part = f"{limbs[i]}";
        let mut k = part.len();
        while k < 9 {
            s.push('0');
            k += 1;
        }
        s.push_str(part);
        i -= 1;
    }
    s
}
// ------------------------------------------------------------ parser

// json5/parser.py, the parser glop generates from json5.g, rule for
// rule. Each rule returns whether it matched (with its value); `pos`
// moves over what matched. Every failure raises `errpos` to where it
// happened, and a negative lookahead that fails puts errpos back as it
// was, exactly as the generated _fail and _not do; the error message
// names the character at errpos. An alternative that fails is rewound
// before the next one is tried, but its failures still count.
struct Json5Parser {
    s: Vec[i64],
    end: i64,
    pos: i64,
    errpos: i64,
    strict: bool,
    consume: bool,
    cats: Cats,
}

fn new_parser(s: ref Vec[i64], start: i64, strict: bool, consume: bool, cats: ref Cats) -> Json5Parser {
    Json5Parser {
        s: s.clone(),
        end: s.len(),
        pos: start,
        errpos: start,
        strict: strict,
        consume: consume,
        cats: cats.clone(),
    }
}

impl Json5Parser {
    fn fail(mut ref self) {
        if self.pos > self.errpos {
            self.errpos = self.pos;
        }
    }

    fn ch(mut ref self, c: i64) -> bool {
        if self.pos < self.end and self.s[self.pos] == c {
            self.pos += 1;
            return true;
        }
        self.fail();
        false
    }

    fn range(mut ref self, lo: i64, hi: i64) -> bool {
        if self.pos < self.end and self.s[self.pos] >= lo and self.s[self.pos] <= hi {
            self.pos += 1;
            return true;
        }
        self.fail();
        false
    }

    // _str: each character in turn, so a partial match fails where it
    // stopped
    fn lit(mut ref self, t: Str) -> bool {
        for b in t.bytes() {
            if not self.ch(b as i64) {
                return false;
            }
        }
        true
    }

    fn anything(mut ref self) -> bool {
        if self.pos < self.end {
            self.pos += 1;
            return true;
        }
        self.fail();
        false
    }

    fn at_end(mut ref self) -> bool {
        if self.pos == self.end {
            return true;
        }
        self.fail();
        false
    }

    // A semantic predicate (?(...)) that is false fails where it stands.
    fn pred(mut ref self, v: bool) -> bool {
        if not v {
            self.fail();
        }
        v
    }

    // `anything` followed by a category test: a character of the wrong
    // class fails one past it.
    fn cat_char(mut ref self, want: i64) -> bool {
        if not self.anything() {
            return false;
        }
        let c = self.s[self.pos - 1];
        self.pred(cat(self.cats, c) == want)
    }

    fn cur(ref self) -> i64 {
        self.s[self.pos - 1]
    }

    // The end of a negative lookahead whose rule matched: back to p,
    // errpos as it was, then fail.
    fn not_matched(mut ref self, p: i64, e: i64) -> bool {
        self.pos = p;
        self.errpos = e;
        self.fail();
        false
    }

    fn digit(mut ref self) -> bool {
        self.range(48, 57)
    }

    fn not_digit(mut ref self) -> bool {
        let p = self.pos;
        let e = self.errpos;
        if self.digit() {
            return self.not_matched(p, e);
        }
        self.pos = p;
        true
    }

    // ------------------------------------------------- whitespace

    fn sp(mut ref self) {
        loop {
            let p = self.pos;
            if not self.ws() {
                self.pos = p;
                break;
            }
        }
    }

    fn ws(mut ref self) -> bool {
        let p = self.pos;
        if self.ch(32) {
            return true;
        }
        self.pos = p;
        if self.eol() {
            return true;
        }
        self.pos = p;
        if self.comment() {
            return true;
        }
        for c in [9, 11, 12, 0xA0, 0xFEFF] {
            self.pos = p;
            if self.ch(c) {
                return true;
            }
        }
        self.pos = p;
        // ~~(x=anything ?(is_unicat(x, 'Zs'))) anything: the double
        // lookahead leaves errpos raised to here either way
        self.fail();
        if self.pos < self.end and cat(self.cats, self.s[self.pos]) == 3 {
            self.pos += 1;
            return true;
        }
        false
    }

    fn eol(mut ref self) -> bool {
        let p = self.pos;
        if self.ch(13) and self.ch(10) {
            return true;
        }
        for c in [13, 10, 0x2028] {
            self.pos = p;
            if self.ch(c) {
                return true;
            }
        }
        self.pos = p;
        self.ch(0x2029)
    }

    fn not_eol(mut ref self) -> bool {
        let p = self.pos;
        let e = self.errpos;
        if self.eol() {
            return self.not_matched(p, e);
        }
        self.pos = p;
        true
    }

    fn comment(mut ref self) -> bool {
        let p = self.pos;
        if self.lit("//") {
            loop {
                let q = self.pos;
                if not (self.not_eol() and self.anything()) {
                    self.pos = q;
                    break;
                }
            }
            return true;
        }
        self.pos = p;
        if not self.lit("/*") {
            return false;
        }
        loop {
            let q = self.pos;
            let e = self.errpos;
            let closes = self.lit("*/");
            let ok = if closes {
                self.not_matched(q, e)
            } else {
                self.pos = q;
                self.anything()
            };
            if not ok {
                self.pos = q;
                break;
            }
        }
        self.lit("*/")
    }

    // ---------------------------------------------------- values

    fn value(mut ref self) -> Option[Ast] {
        let p = self.pos;
        if self.lit("null") {
            return Some(Ast.Null);
        }
        self.pos = p;
        if self.lit("true") {
            return Some(Ast.True);
        }
        self.pos = p;
        if self.lit("false") {
            return Some(Ast.False);
        }
        self.pos = p;
        if let Some(ms) = self.object() {
            return Some(Ast.Obj(ms));
        }
        self.pos = p;
        if let Some(vs) = self.array() {
            return Some(Ast.Arr(vs));
        }
        self.pos = p;
        if let Some(s) = self.string() {
            return Some(Ast.Str(s));
        }
        self.pos = p;
        match self.num_literal() {
            Some(n) => Some(Ast.Num(n)),
            None => None,
        }
    }

    fn object(mut ref self) -> Option[Vec[AstMember]] {
        let p = self.pos;
        if self.ch(123) {
            self.sp();
            if let Some(ms) = self.member_list() {
                self.sp();
                if self.ch(125) {
                    return Some(ms);
                }
            }
        }
        self.pos = p;
        if not self.ch(123) {
            return None;
        }
        self.sp();
        if not self.ch(125) {
            return None;
        }
        Some(Vec.new())
    }

    fn member_list(mut ref self) -> Option[Vec[AstMember]] {
        let mut ms: Vec[AstMember] = Vec.new();
        match self.member() {
            Some(m) => ms.push(m),
            None => return None,
        }
        loop {
            let p = self.pos;
            self.sp();
            let mut got: Option[AstMember] = None;
            if self.ch(44) {
                self.sp();
                got = self.member();
            }
            match got {
                Some(m) => ms.push(m),
                None => {
                    self.pos = p;
                    break;
                }
            }
        }
        self.sp();
        let p = self.pos;
        if not self.ch(44) {
            self.pos = p;
        }
        Some(ms)
    }

    fn member_rest(mut ref self, key: own Vec[i64]) -> Option[AstMember] {
        self.sp();
        if not self.ch(58) {
            return None;
        }
        self.sp();
        match self.value() {
            Some(v) => Some(AstMember { key: key, val: v }),
            None => None,
        }
    }

    fn member(mut ref self) -> Option[AstMember] {
        let p = self.pos;
        if let Some(k) = self.string() {
            if let Some(m) = self.member_rest(k) {
                return Some(m);
            }
        }
        self.pos = p;
        match self.ident() {
            Some(k) => self.member_rest(k),
            None => None,
        }
    }

    fn array(mut ref self) -> Option[Vec[Ast]] {
        let p = self.pos;
        if self.ch(91) {
            self.sp();
            if let Some(vs) = self.element_list() {
                self.sp();
                if self.ch(93) {
                    return Some(vs);
                }
            }
        }
        self.pos = p;
        if not self.ch(91) {
            return None;
        }
        self.sp();
        if not self.ch(93) {
            return None;
        }
        Some(Vec.new())
    }

    fn element_list(mut ref self) -> Option[Vec[Ast]] {
        let mut vs: Vec[Ast] = Vec.new();
        match self.value() {
            Some(v) => vs.push(v),
            None => return None,
        }
        loop {
            let p = self.pos;
            self.sp();
            let mut got: Option[Ast] = None;
            if self.ch(44) {
                self.sp();
                got = self.value();
            }
            match got {
                Some(v) => vs.push(v),
                None => {
                    self.pos = p;
                    break;
                }
            }
        }
        self.sp();
        let p = self.pos;
        if not self.ch(44) {
            self.pos = p;
        }
        Some(vs)
    }

    // --------------------------------------------------- strings

    fn string(mut ref self) -> Option[Vec[i64]] {
        let p = self.pos;
        if let Some(s) = self.quoted(39) {
            return Some(s);
        }
        self.pos = p;
        self.quoted(34)
    }

    fn quoted(mut ref self, q: i64) -> Option[Vec[i64]] {
        if not self.ch(q) {
            return None;
        }
        let mut out: Vec[i64] = Vec.new();
        loop {
            let p = self.pos;
            match self.str_char(q) {
                Some(c) => {
                    if c >= 0 {
                        out.push(c);
                    }
                }
                None => {
                    self.pos = p;
                    break;
                }
            }
        }
        if not self.ch(q) {
            return None;
        }
        Some(out)
    }

    // What ends a run of plain characters: a backslash, the quote, or
    // (strict) a raw CR or LF.
    fn char_stop(mut ref self, q: i64) -> bool {
        let p = self.pos;
        if self.ch(92) {
            return true;
        }
        self.pos = p;
        if self.ch(q) {
            return true;
        }
        self.pos = p;
        if not self.pred(self.strict) {
            return false;
        }
        let r = self.pos;
        if self.ch(13) {
            return true;
        }
        self.pos = r;
        self.ch(10)
    }

    // sqchar / dqchar; -1 stands for the '' a line continuation gives
    fn str_char(mut ref self, q: i64) -> Option[i64] {
        let p = self.pos;
        let e = self.errpos;
        let stops = self.char_stop(q);
        if stops {
            self.not_matched(p, e);
        } else {
            self.pos = p;
            if self.anything() {
                return Some(self.cur());
            }
        }
        self.pos = p;
        if self.ch(92) {
            if let Some(c) = self.esc_char() {
                return Some(c);
            }
        }
        self.pos = p;
        if self.ch(92) and self.eol() {
            return Some(-1);
        }
        None
    }

    fn esc_char(mut ref self) -> Option[i64] {
        let p = self.pos;
        let simple = [(98, 8), (102, 12), (110, 10), (114, 13), (116, 9), (118, 11), (39, 39), (34, 34), (92, 92)];
        for (c, v) in simple {
            self.pos = p;
            if self.ch(c) {
                return Some(v);
            }
        }
        // ~('x' | 'u' | digit | eol) anything
        self.pos = p;
        let e = self.errpos;
        let mut blocked = self.ch(120);
        if not blocked {
            self.pos = p;
            blocked = self.ch(117);
        }
        if not blocked {
            self.pos = p;
            blocked = self.digit();
        }
        if not blocked {
            self.pos = p;
            blocked = self.eol();
        }
        if blocked {
            self.not_matched(p, e);
        } else {
            self.pos = p;
            if self.anything() {
                return Some(self.cur());
            }
        }
        self.pos = p;
        if self.ch(48) and self.not_digit() {
            return Some(0);
        }
        self.pos = p;
        if self.ch(120) {
            if let Some(a) = self.hex() {
                if let Some(b) = self.hex() {
                    return Some(a * 16 + b);
                }
            }
        }
        self.pos = p;
        self.unicode_esc()
    }

    fn hex(mut ref self) -> Option[i64] {
        let p = self.pos;
        if self.range(97, 102) {
            return Some(self.cur() - 87);
        }
        self.pos = p;
        if self.range(65, 70) {
            return Some(self.cur() - 55);
        }
        self.pos = p;
        if self.digit() {
            return Some(self.cur() - 48);
        }
        None
    }

    fn unicode_esc(mut ref self) -> Option[i64] {
        if not self.ch(117) {
            return None;
        }
        let mut v = 0;
        let mut k = 0;
        while k < 4 {
            match self.hex() {
                Some(h) => v = v * 16 + h,
                None => return None,
            }
            k += 1;
        }
        Some(v)
    }

    // ----------------------------------------------- identifiers

    fn ascii_id_start(mut ref self) -> bool {
        let p = self.pos;
        if self.range(97, 122) {
            return true;
        }
        self.pos = p;
        if self.range(65, 90) {
            return true;
        }
        self.pos = p;
        if self.ch(36) {
            return true;
        }
        self.pos = p;
        self.ch(95)
    }

    // the six other_id_start alternatives, Ll Lm Lo Lt Lu Nl, which all
    // fail at the same place
    fn other_id_start(mut ref self) -> bool {
        self.cat_char(1)
    }

    fn id_start(mut ref self) -> Option[i64] {
        let p = self.pos;
        if self.ascii_id_start() {
            return Some(self.cur());
        }
        self.pos = p;
        if self.other_id_start() {
            return Some(self.cur());
        }
        self.pos = p;
        if not self.ch(92) {
            return None;
        }
        self.unicode_esc()
    }

    fn id_continue(mut ref self) -> Option[i64] {
        let p = self.pos;
        if self.ascii_id_start() {
            return Some(self.cur());
        }
        self.pos = p;
        if self.digit() {
            return Some(self.cur());
        }
        self.pos = p;
        if self.other_id_start() {
            return Some(self.cur());
        }
        // Mn, Mc, Nd, Pc
        self.pos = p;
        if self.cat_char(2) {
            return Some(self.cur());
        }
        self.pos = p;
        if self.ch(92) {
            if let Some(c) = self.unicode_esc() {
                return Some(c);
            }
        }
        self.pos = p;
        if self.ch(0x200C) {
            return Some(0x200C);
        }
        self.pos = p;
        if self.ch(0x200D) {
            return Some(0x200D);
        }
        None
    }

    fn ident(mut ref self) -> Option[Vec[i64]] {
        let mut out: Vec[i64] = Vec.new();
        match self.id_start() {
            Some(c) => out.push(c),
            None => return None,
        }
        loop {
            let p = self.pos;
            match self.id_continue() {
                Some(c) => out.push(c),
                None => {
                    self.pos = p;
                    break;
                }
            }
        }
        Some(out)
    }

    // --------------------------------------------------- numbers

    fn digits(mut ref self, out: mut ref String) {
        loop {
            let p = self.pos;
            if not self.digit() {
                self.pos = p;
                break;
            }
            out.push(self.cur() as u8 as char);
        }
    }

    fn num_literal(mut ref self) -> Option[String] {
        let p = self.pos;
        if self.ch(45) {
            if let Some(n) = self.unsigned_lit() {
                return Some(f"-{n}");
            }
        }
        self.pos = p;
        if self.ch(43) {
            if let Some(n) = self.unsigned_lit() {
                return Some(n);
            }
        }
        self.pos = p;
        self.unsigned_lit()
    }

    fn unsigned_lit(mut ref self) -> Option[String] {
        let p = self.pos;
        if let Some(d) = self.dec_literal() {
            let q = self.pos;
            let e = self.errpos;
            if self.id_start().is_some() {
                self.not_matched(q, e);
            } else {
                self.pos = q;
                return Some(d);
            }
        }
        self.pos = p;
        if let Some(h) = self.hex_literal() {
            return Some(h);
        }
        self.pos = p;
        if self.lit("Infinity") {
            return Some("Infinity".to_string());
        }
        self.pos = p;
        if self.lit("NaN") {
            return Some("NaN".to_string());
        }
        None
    }

    fn dec_literal(mut ref self) -> Option[String] {
        let p = self.pos;
        // int frac exp | int frac | int exp | int | frac exp | frac
        let mut k = 0;
        while k < 6 {
            self.pos = p;
            let mut text = String.new();
            let mut ok = true;
            if k < 4 {
                match self.dec_int_lit() {
                    Some(d) => text.push_str(d),
                    None => ok = false,
                }
            }
            if ok and (k == 0 or k == 1 or k >= 4) {
                match self.frac() {
                    Some(f) => text.push_str(f),
                    None => ok = false,
                }
            }
            if ok and (k == 0 or k == 2 or k == 4) {
                match self.exp() {
                    Some(x) => text.push_str(x),
                    None => ok = false,
                }
            }
            if ok {
                return Some(text);
            }
            k += 1;
        }
        None
    }

    fn dec_int_lit(mut ref self) -> Option[String] {
        let p = self.pos;
        if self.ch(48) and self.not_digit() {
            return Some("0".to_string());
        }
        self.pos = p;
        if not self.range(49, 57) {
            return None;
        }
        let mut s = String.new();
        s.push(self.cur() as u8 as char);
        self.digits(mut s);
        Some(s)
    }

    fn frac(mut ref self) -> Option[String] {
        if not self.ch(46) {
            return None;
        }
        let mut s = ".".to_string();
        self.digits(mut s);
        Some(s)
    }

    fn e_mark(mut ref self) -> bool {
        let p = self.pos;
        if self.ch(101) {
            return true;
        }
        self.pos = p;
        self.ch(69)
    }

    fn exp(mut ref self) -> Option[String] {
        let p = self.pos;
        if self.e_mark() {
            let q = self.pos;
            let mut sign = 0;
            if self.ch(43) {
                sign = 43;
            } else {
                self.pos = q;
                if self.ch(45) {
                    sign = 45;
                }
            }
            if sign != 0 {
                let mut s = "e".to_string();
                s.push(sign as u8 as char);
                self.digits(mut s);
                return Some(s);
            }
        }
        self.pos = p;
        if not self.e_mark() {
            return None;
        }
        let mut s = "e".to_string();
        self.digits(mut s);
        Some(s)
    }

    fn hex_literal(mut ref self) -> Option[String] {
        let p = self.pos;
        if not self.lit("0x") {
            self.pos = p;
            if not self.lit("0X") {
                return None;
            }
        }
        let mut s = "0x".to_string();
        match self.hex() {
            Some(_) => s.push(self.cur() as u8 as char),
            None => return None,
        }
        loop {
            let q = self.pos;
            if self.hex().is_none() {
                self.pos = q;
                break;
            }
            s.push(self.cur() as u8 as char);
        }
        Some(s)
    }

    // ------------------------------------------------------ grammar

    fn trailing(mut ref self) -> bool {
        let p = self.pos;
        if self.pred(self.consume) {
            self.sp();
            if self.at_end() {
                return true;
            }
        }
        self.pos = p;
        let e = self.errpos;
        if self.pred(self.consume) {
            return self.not_matched(p, e);
        }
        self.pos = p;
        true
    }

    fn grammar(mut ref self) -> Option[Ast] {
        self.sp();
        let v = self.value()?;
        if not self.trailing() {
            return None;
        }
        Some(v)
    }

    fn err_str(ref self) -> String {
        let mut line = 1;
        let mut col = 1;
        let mut i = 0;
        while i < self.errpos {
            if self.s[i] == 10 {
                line += 1;
                col = 1;
            } else {
                col += 1;
            }
            i += 1;
        }
        let thing = if self.errpos == self.s.len() {
            "end of input".to_string()
        } else {
            let mut one: Vec[i64] = Vec.new();
            one.push(self.s[self.errpos]);
            f"\"{to_text(one)}\""
        };
        f"<string>:{line} Unexpected {thing} at column {col}"
    }
}
// ------------------------------------------------------------- loads

struct LoadOpts {
    strict: bool,
    consume: bool,
    dups: bool,
}

fn default_load() -> LoadOpts {
    LoadOpts { strict: true, consume: true, dups: true }
}

fn has_ch(s: ref String, c: char) -> bool {
    for x in s.chars() {
        if x == c {
            return true;
        }
    }
    false
}

// float(text) over what the number rule matched: it needs a digit
// before the exponent and one after the e.
fn py_float(v: ref String) -> Result[f64, Exc] {
    let b = v.bytes();
    let mut i = 0;
    if i < b.len() and (b[i] == b'-' or b[i] == b'+') {
        i += 1;
    }
    let mut mant = 0;
    let mut exp_digits = -1;
    while i < b.len() {
        let c = b[i];
        if c == b'e' or c == b'E' {
            exp_digits = 0;
        } else if c >= b'0' and c <= b'9' {
            if exp_digits >= 0 {
                exp_digits += 1;
            } else {
                mant += 1;
            }
        }
        i += 1;
    }
    if mant == 0 or exp_digits == 0 {
        return Err(value_error(f"could not convert string to float: '{v}'"));
    }
    match f64.parse(v.clone()) {
        Ok(x) => Ok(x),
        Err(_) => Err(value_error(f"could not convert string to float: '{v}'")),
    }
}

// _walk_ast: numbers go through int() or float() by what their text
// holds, and an object is dict(pairs) once its values are walked.
fn walk(a: ref Ast, dups: bool) -> Result[J, Exc] {
    match a {
        Ast.Null => Ok(J.Null),
        Ast.True => Ok(J.Bool(true)),
        Ast.False => Ok(J.Bool(false)),
        Ast.Str(s) => Ok(J.Str(s.clone())),
        Ast.Num(v) => {
            let neg = v.starts_with("-");
            let unsigned = if neg { v.substring(1, v.len()) } else { v.clone() };
            if unsigned.starts_with("0x") {
                let digits = hex_to_dec(cps_of(unsigned.substring(2, unsigned.len())));
                if neg and digits != "0" {
                    return Ok(J.Int(f"-{digits}"));
                }
                return Ok(J.Int(digits));
            }
            if has_ch(v, '.') or has_ch(v, 'e') or has_ch(v, 'E') {
                return Ok(J.Float(py_float(v)?));
            }
            if unsigned == "Infinity" {
                return Ok(J.Float(if neg { -1.0 / 0.0 } else { 1.0 / 0.0 }));
            }
            if unsigned == "NaN" {
                return Ok(J.Float(0.0 / 0.0));
            }
            if v == "-0" {
                return Ok(J.Int("0".to_string()));
            }
            Ok(J.Int(v.clone()))
        }
        Ast.Arr(items) => {
            let mut out: Vec[J] = Vec.new();
            for it in items {
                out.push(walk(it, dups)?);
            }
            Ok(J.Arr(out))
        }
        Ast.Obj(ms) => {
            let mut pairs: Vec[Member] = Vec.new();
            for m in ms {
                pairs.push(Member { key: m.key.clone(), val: walk(m.val, dups)? });
            }
            if not dups {
                let mut i = 0;
                while i < pairs.len() {
                    let mut k = 0;
                    while k < i {
                        if same_cps(pairs[k].key, pairs[i].key) {
                            return Err(value_error(f"Duplicate key \"{to_text(pairs[i].key)}\" found in object"));
                        }
                        k += 1;
                    }
                    i += 1;
                }
            }
            // dict(pairs): a repeated key keeps its first place and takes
            // its last value
            let mut out: Vec[Member] = Vec.new();
            for p in pairs.into_iter() {
                let mut found = -1;
                let mut k = 0;
                while k < out.len() {
                    if same_cps(out[k].key, p.key) {
                        found = k;
                    }
                    k += 1;
                }
                if found >= 0 {
                    out[found].val = p.val;
                } else {
                    out.push(p);
                }
            }
            Ok(J.Obj(out))
        }
    }
}

// json5.parse: the value and where the parser stopped, or the error and
// how far it got.
fn parse(s: ref Vec[i64], start: i64, o: ref LoadOpts, cats: ref Cats) -> Result[(J, i64), (Exc, i64)] {
    let mut p = new_parser(s, start, o.strict, o.consume, cats);
    match p.grammar() {
        Some(ast) => match walk(ast, o.dups) {
            Ok(v) => Ok((v, p.pos)),
            Err(e) => Err((e, p.pos)),
        },
        None => Err((value_error(p.err_str()), p.errpos)),
    }
}

fn loads(s: ref Vec[i64], o: ref LoadOpts, cats: ref Cats) -> Result[J, Exc] {
    if s.len() == 0 {
        return Err(value_error("Empty strings are not legal JSON5".to_string()));
    }
    match parse(s, 0, o, cats) {
        Ok((v, _)) => Ok(v),
        Err((e, _)) => Err(e),
    }
}

fn loads_bytes(b: ref Vec[u8], o: ref LoadOpts, cats: ref Cats) -> Result[J, Exc] {
    let s = decode_utf8(b)?;
    loads(s, o, cats)
}

// ------------------------------------------------------------- dumps

#[derive(Clone)]
struct DumpOpts {
    // indent: None, an int, or a string
    indent_kind: i64,
    indent_n: i64,
    indent_s: Vec[i64],
    item_sep: String,
    kv_sep: String,
    sort_keys: bool,
    quote_keys: bool,
    trailing_commas: bool,
    // 0 always_double, 1 always_single, 2 prefer_double, 3 prefer_single
    quote_style: i64,
    ensure_ascii: bool,
    allow_nan: bool,
}

fn default_dump() -> DumpOpts {
    DumpOpts {
        indent_kind: 0,
        indent_n: 0,
        indent_s: Vec.new(),
        item_sep: ", ".to_string(),
        kv_sep: ": ".to_string(),
        sort_keys: false,
        quote_keys: false,
        trailing_commas: true,
        quote_style: 0,
        ensure_ascii: true,
        allow_nan: true,
    }
}

// The item separator follows the indent, as JSON5Encoder picks it when
// no separators are given.
fn set_indent_int(o: mut ref DumpOpts, n: i64) {
    o.indent_kind = 1;
    o.indent_n = n;
    o.item_sep = ",".to_string();
}

fn set_indent_str(o: mut ref DumpOpts, s: own Vec[i64]) {
    o.indent_kind = 2;
    o.indent_s = s;
    o.item_sep = ",".to_string();
}

fn style_named(name: ref String) -> i64 {
    if name == "always_single" {
        1
    } else if name == "prefer_double" {
        2
    } else if name == "prefer_single" {
        3
    } else {
        0
    }
}

fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    if x == 1.0 / 0.0 {
        return "inf".to_string();
    }
    if x == -1.0 / 0.0 {
        return "-inf".to_string();
    }
    f"{x}"
}

fn reserved_words() -> Vec[Vec[i64]] {
    let words = ["break", "case", "catch", "class", "const", "continue", "debugger", "default", "delete", "do",
     "else", "enum", "export", "extends", "false", "finally", "for", "function", "if", "implements",
     "import", "in", "instanceof", "interface", "let", "new", "null", "package", "private",
     "protected", "public", "return", "static", "super", "switch", "this", "throw", "true", "try",
     "typeof", "var", "void", "while", "with", "yield"];
    let mut v: Vec[Vec[i64]] = Vec.new();
    for w in words {
        v.push(cps_of(w));
    }
    v
}

struct Encoder {
    o: DumpOpts,
    cats: Cats,
    reserved: Vec[Vec[i64]],
}

fn new_encoder(o: ref DumpOpts, cats: ref Cats) -> Encoder {
    Encoder { o: o.clone(), cats: cats.clone(), reserved: reserved_words() }
}

impl Encoder {
    fn is_identifier(ref self, key: ref Vec[i64]) -> bool {
        if key.len() == 0 {
            return false;
        }
        let first = key[0];
        if cat(self.cats, first) != 1 and first != 36 and first != 95 {
            return false;
        }
        let mut i = 1;
        while i < key.len() {
            let c = key[i];
            let k = cat(self.cats, c);
            if k != 1 and k != 2 and c != 36 and c != 95 {
                return false;
            }
            i += 1;
        }
        true
    }

    fn is_reserved(ref self, key: ref Vec[i64]) -> bool {
        for w in self.reserved {
            if same_cps(w, key) {
                return true;
            }
        }
        false
    }

    fn escape_ch(ref self, c: i64, out: mut ref Vec[i64]) {
        let named = if c == 92 {
            "\\\\"
        } else if c == 39 {
            "\\'"
        } else if c == 34 {
            "\\\""
        } else if c == 10 {
            "\\n"
        } else if c == 13 {
            "\\r"
        } else if c == 9 {
            "\\t"
        } else if c == 8 {
            "\\b"
        } else if c == 12 {
            "\\f"
        } else if c == 11 {
            "\\v"
        } else if c == 0 {
            "\\0"
        } else {
            ""
        };
        if named.len() > 0 {
            push_ascii(mut out, named);
            return;
        }
        if c < 65536 {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
            return;
        }
        let v = c - 0x10000;
        push_ascii(mut out, "\\u");
        push_ascii(mut out, hex_n(0xD800 + (v >> 10), 4));
        push_ascii(mut out, "\\u");
        push_ascii(mut out, hex_n(0xDC00 + (v & 0x3FF), 4));
    }

    // _encode_quoted_str: a prefer_* style that guessed wrong encodes the
    // string again with the other quote
    fn quoted(ref self, s: ref Vec[i64], style: i64, out: mut ref Vec[i64]) {
        let mut ret: Vec[i64] = Vec.new();
        let mut dq = 0;
        let mut sq = 0;
        let double = style == 0 or style == 2;
        for c in s {
            if c == 34 {
                dq += 1;
                if double {
                    self.escape_ch(c, mut ret);
                } else {
                    ret.push(c);
                }
            } else if c == 39 {
                sq += 1;
                if not double {
                    self.escape_ch(c, mut ret);
                } else {
                    ret.push(c);
                }
            } else if c == 92 or c < 32 {
                self.escape_ch(c, mut ret);
            } else if c < 128 or (not self.o.ensure_ascii and c != 0x2028 and c != 0x2029) {
                ret.push(c);
            } else {
                self.escape_ch(c, mut ret);
            }
        }
        if dq > sq and style == 2 {
            self.quoted(s, 1, mut out);
            return;
        }
        if sq > dq and style == 3 {
            self.quoted(s, 0, mut out);
            return;
        }
        let q = if double { 34 } else { 39 };
        out.push(q);
        for c in ret {
            out.push(c);
        }
        out.push(q);
    }

    fn encode_str(ref self, s: ref Vec[i64], as_key: bool, out: mut ref Vec[i64]) {
        if as_key and self.is_identifier(s) and not self.o.quote_keys and not self.is_reserved(s) {
            for c in s {
                out.push(c);
            }
            return;
        }
        self.quoted(s, self.o.quote_style, mut out);
    }

    fn spacers(ref self, level: i64) -> (Vec[i64], Vec[i64]) {
        let mut indent: Vec[i64] = Vec.new();
        let mut end: Vec[i64] = Vec.new();
        if self.o.indent_kind == 0 {
            return (indent, end);
        }
        if self.o.trailing_commas {
            end.push(44);
        }
        indent.push(10);
        end.push(10);
        if self.o.indent_kind == 1 {
            if self.o.indent_n > 0 {
                let mut k = 0;
                while k < self.o.indent_n * level {
                    indent.push(32);
                    k += 1;
                }
                k = 0;
                while k < self.o.indent_n * (level - 1) {
                    end.push(32);
                    k += 1;
                }
            }
        } else {
            let mut k = 0;
            while k < level {
                for c in self.o.indent_s {
                    indent.push(c);
                }
                k += 1;
            }
            k = 0;
            while k < level - 1 {
                for c in self.o.indent_s {
                    end.push(c);
                }
                k += 1;
            }
        }
        (indent, end)
    }

    fn encode(ref self, v: ref J, level: i64, out: mut ref Vec[i64]) -> Result[(), Exc] {
        match v {
            J.Null => push_ascii(mut out, "null"),
            J.Bool(b) => push_ascii(mut out, if b { "true" } else { "false" }),
            J.Int(d) => push_ascii(mut out, d),
            J.Float(x) => {
                let text = if x != x {
                    "NaN".to_string()
                } else if x == 1.0 / 0.0 {
                    "Infinity".to_string()
                } else if x == -1.0 / 0.0 {
                    "-Infinity".to_string()
                } else {
                    f"{x}"
                };
                let special = x != x or x == 1.0 / 0.0 or x == -1.0 / 0.0;
                if special and not self.o.allow_nan {
                    return Err(value_error(f"Illegal JSON5 value: {float_repr(x)}"));
                }
                push_ascii(mut out, text);
            }
            J.Str(s) => self.encode_str(s, false, mut out),
            J.Arr(items) => {
                if items.len() == 0 {
                    push_ascii(mut out, "[]");
                    return Ok(());
                }
                let (indent, end) = self.spacers(level + 1);
                out.push(91);
                for c in indent {
                    out.push(c);
                }
                let mut i = 0;
                while i < items.len() {
                    if i > 0 {
                        push_ascii(mut out, self.o.item_sep);
                        for c in indent {
                            out.push(c);
                        }
                    }
                    self.encode(items[i], level + 1, mut out)?;
                    i += 1;
                }
                for c in end {
                    out.push(c);
                }
                out.push(93);
            }
            J.Obj(ms) => {
                if ms.len() == 0 {
                    push_ascii(mut out, "{}");
                    return Ok(());
                }
                let (indent, end) = self.spacers(level + 1);
                let mut order: Vec[i64] = Vec.new();
                let mut i = 0;
                while i < ms.len() {
                    // sorted(): stable, by code point
                    let mut at = order.len();
                    if self.o.sort_keys {
                        while at > 0 and cmp_cps(ms[order[at - 1]].key, ms[i].key) > 0 {
                            at -= 1;
                        }
                    }
                    order.insert(at, i);
                    i += 1;
                }
                out.push(123);
                for c in indent {
                    out.push(c);
                }
                let mut first = true;
                for k in order {
                    if not first {
                        push_ascii(mut out, self.o.item_sep);
                        for c in indent {
                            out.push(c);
                        }
                    }
                    first = false;
                    self.encode_str(ms[k].key, true, mut out);
                    push_ascii(mut out, self.o.kv_sep);
                    self.encode(ms[k].val, level + 1, mut out)?;
                }
                for c in end {
                    out.push(c);
                }
                out.push(125);
            }
        }
        Ok(())
    }
}

fn dumps(v: ref J, o: ref DumpOpts, cats: ref Cats) -> Result[Vec[i64], Exc] {
    let enc = new_encoder(o, cats);
    let mut out: Vec[i64] = Vec.new();
    enc.encode(v, 0, mut out)?;
    Ok(out)
}

// -------------------------------------------------------------- repr

fn str_repr(t: ref Cats, s: ref Vec[i64], out: mut ref Vec[i64]) {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or printable(t, c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
}

fn repr(t: ref Cats, v: ref J, out: mut ref Vec[i64]) {
    match v {
        J.Null => push_ascii(mut out, "None"),
        J.Bool(b) => push_ascii(mut out, if b { "True" } else { "False" }),
        J.Int(digits) => push_ascii(mut out, digits),
        J.Float(x) => push_ascii(mut out, float_repr(x)),
        J.Str(s) => str_repr(t, s, mut out),
        J.Arr(items) => {
            out.push(91);
            let mut i = 0;
            while i < items.len() {
                if i > 0 {
                    push_ascii(mut out, ", ");
                }
                repr(t, items[i], mut out);
                i += 1;
            }
            out.push(93);
        }
        J.Obj(ms) => {
            out.push(123);
            let mut i = 0;
            while i < ms.len() {
                if i > 0 {
                    push_ascii(mut out, ", ");
                }
                str_repr(t, ms[i].key, mut out);
                push_ascii(mut out, ": ");
                repr(t, ms[i].val, mut out);
                i += 1;
            }
            out.push(125);
        }
    }
}

fn repr_text(t: ref Cats, v: ref J) -> String {
    let mut out: Vec[i64] = Vec.new();
    repr(t, v, mut out);
    to_text(out)
}
// --------------------------------------------------------------- tool

// `python -m json5` (json5/tool.py) with argparse's handling of its
// options.
struct ToolResult {
    out: String,
    err: String,
    code: String,
}

fn style_choice(v: ref String) -> bool {
    v == "always_double" or v == "always_single" or v == "prefer_double" or v == "prefer_single"
}

// int(text) for the --indent value: blanks around it, a sign, digits
// with single underscores between them
fn py_int(text: ref String) -> Option[i64] {
    let t = text.trim().to_string();
    let b = t.bytes();
    let mut i = 0;
    let mut neg = false;
    if i < b.len() and (b[i] == b'+' or b[i] == b'-') {
        neg = b[i] == b'-';
        i += 1;
    }
    if i >= b.len() {
        return None;
    }
    let mut n = 0;
    let mut last_digit = false;
    while i < b.len() {
        let c = b[i];
        if c >= b'0' and c <= b'9' {
            n = n * 10 + (c - b'0') as i64;
            last_digit = true;
        } else if c == b'_' and last_digit and i + 1 < b.len() {
            last_digit = false;
        } else {
            return None;
        }
        i += 1;
    }
    if not last_digit {
        return None;
    }
    Some(if neg { -n } else { n })
}

fn tool_error(msg: ref String) -> ToolResult {
    let mut err = "usage: json5 [options] [FILE]\n".to_string();
    err.push_str("    -h/--help for help\n\n");
    err.push_str(f"error: {msg}\n");
    ToolResult { out: String.new(), err: err, code: "2".to_string() }
}

fn run_tool(args: ref Vec[String], cats: ref Cats) -> ToolResult {
    let mut version = false;
    let mut cmd: Option[String] = None;
    let mut as_json = false;
    let mut indent = "4".to_string();
    let mut quote_keys = false;
    let mut trailing = true;
    let mut strict = true;
    let mut style = "always_double".to_string();
    let mut file = "-".to_string();
    let mut i = 0;
    while i < args.len() {
        let a = args[i].clone();
        let takes = a == "-c" or a == "--indent" or a == "--quote-style";
        if takes and i + 1 >= args.len() {
            return tool_error(f"argument {a}: expected one argument");
        }
        if a == "-V" or a == "--version" {
            version = true;
        } else if a == "-c" {
            cmd = Some(args[i + 1].clone());
        } else if a == "--as-json" {
            as_json = true;
        } else if a == "--indent" {
            indent = args[i + 1].clone();
        } else if a == "--quote-keys" {
            quote_keys = true;
        } else if a == "--no-quote-keys" {
            quote_keys = false;
        } else if a == "--trailing-commas" {
            trailing = true;
        } else if a == "--no-trailing-commas" {
            trailing = false;
        } else if a == "--strict" {
            strict = true;
        } else if a == "--no-strict" {
            strict = false;
        } else if a == "--quote-style" {
            let v = args[i + 1].clone();
            if not style_choice(v) {
                return tool_error(f"argument --quote-style: invalid choice: '{v}' (choose from 'always_double', 'always_single', 'prefer_double', 'prefer_single')");
            }
            style = v;
        } else {
            file = a;
        }
        i += if takes { 2 } else { 1 };
    }
    if version {
        return ToolResult { out: "0.17.3\n".to_string(), err: String.new(), code: "0".to_string() };
    }
    match tool_body(cmd, file, indent, as_json, quote_keys, trailing, strict, style, cats) {
        Ok(s) => ToolResult { out: f"{s}\n", err: String.new(), code: "0".to_string() },
        Err(e) => ToolResult { out: String.new(), err: String.new(), code: exc_line(e) },
    }
}

fn tool_body(cmd: ref Option[String], file: ref String, indent: ref String, as_json: bool, quote_keys: bool,
             trailing: bool, strict: bool, style: ref String, cats: ref Cats) -> Result[String, Exc] {
    let inp = match cmd {
        Some(c) => cps_of(c),
        None => match fs.read_bytes(file.clone()) {
            Ok(b) => decode_utf8(b)?,
            Err(_) => return Err(exc("FileNotFoundError", f"[Errno 2] No such file or directory: '{file}'")),
        },
    };
    let mut o = default_dump();
    if indent != "None" {
        match py_int(indent) {
            Some(n) => set_indent_int(mut o, n),
            None => set_indent_str(mut o, cps_of(indent)),
        }
    }
    o.quote_keys = quote_keys;
    o.trailing_commas = trailing;
    o.quote_style = style_named(style);
    if as_json {
        o.quote_keys = true;
        o.trailing_commas = false;
        o.quote_style = 0;
    }
    let mut lo = default_load();
    lo.strict = strict;
    let v = loads(inp, lo, cats)?;
    Ok(to_text(dumps(v, o, cats)?))
}

fn print_streams(r: ref ToolResult) {
    for (name, text) in [("stdout", r.out.clone()), ("stderr", r.err.clone())] {
        if text.len() > 0 {
            let body = if text.ends_with("\n") { text.substring(0, text.len() - 1) } else { text.clone() };
            for line in body.split("\n") {
                println(f"  {name}|{line}");
            }
        }
    }
    println(f"  -> {r.code}");
}

// --------------------------------------------------------------- jobs

fn load_opts(fields: ref Vec[String], first: i64) -> LoadOpts {
    let mut o = default_load();
    let mut i = first;
    while i < fields.len() {
        let f = fields[i].clone();
        if f == "strict=0" {
            o.strict = false;
        } else if f == "trailing=0" {
            o.consume = false;
        } else if f == "dups=0" {
            o.dups = false;
        }
        i += 1;
    }
    o
}

fn dump_opts(fields: ref Vec[String], first: i64) -> DumpOpts {
    let mut o = default_dump();
    let mut i = first;
    while i < fields.len() {
        let f = fields[i].clone();
        let eq = f.find("=").unwrap_or(f.len());
        let k = f.substring(0, eq);
        let v = f.substring(eq + 1, f.len());
        if k == "indent" {
            if v == "tab" {
                let mut tab: Vec[i64] = Vec.new();
                tab.push(9);
                set_indent_str(mut o, tab);
            } else if v.starts_with("s:") {
                set_indent_str(mut o, cps_of(v.substring(2, v.len())));
            } else {
                set_indent_int(mut o, py_int(v).unwrap_or(0));
            }
        } else if k == "compact" {
            o.item_sep = ",".to_string();
            o.kv_sep = ":".to_string();
        } else if k == "quote_style" {
            o.quote_style = style_named(v);
        } else if k == "sort_keys" {
            o.sort_keys = v == "1";
        } else if k == "quote_keys" {
            o.quote_keys = v == "1";
        } else if k == "trailing_commas" {
            o.trailing_commas = v == "1";
        } else if k == "ensure_ascii" {
            o.ensure_ascii = v == "1";
        } else if k == "allow_nan" {
            o.allow_nan = v == "1";
        }
        i += 1;
    }
    o
}

fn py_bool(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

fn all_space(s: ref Vec[i64], from: i64) -> bool {
    let mut i = from;
    while i < s.len() {
        if not is_py_space(s[i]) {
            return false;
        }
        i += 1;
    }
    true
}

fn parse_stream(s: ref Vec[i64], cats: ref Cats) {
    let mut o = default_load();
    o.consume = false;
    let mut start = 0;
    loop {
        match parse(s, start, o, cats) {
            Err((e, pos)) => {
                println(f"  error at {pos}: {e.msg}");
                return;
            }
            Ok((v, pos)) => {
                println(f"  {start}..{pos}: {repr_text(cats, v)}");
                start = pos;
            }
        }
        if start == s.len() or all_space(s, start) {
            return;
        }
    }
}

fn roundtrip(v: ref J, cats: ref Cats) -> Result[String, Exc] {
    let plain = default_dump();
    let lo = default_load();
    let a = dumps(v, plain, cats)?;
    let b = dumps(loads(a, lo, cats)?, plain, cats)?;
    let mut pretty = default_dump();
    set_indent_int(mut pretty, 2);
    pretty.quote_keys = true;
    pretty.sort_keys = true;
    pretty.ensure_ascii = false;
    pretty.quote_style = 3;
    let c = dumps(v, pretty, cats)?;
    let d = dumps(loads(c, lo, cats)?, pretty, cats)?;
    Ok(f"  compact {a.len()} chars, same again {py_bool(same_cps(a, b))}; pretty {c.len()} chars, same again {py_bool(same_cps(c, d))}")
}

fn run_cases(cats: ref Cats) {
    let text = fs.read_to_string("data/cases.tsv".to_string()).unwrap_or(String.new());
    for line in text.lines() {
        let tab = line.find("\t").unwrap_or(0);
        let opts = line.substring(0, tab);
        let doc = line.substring(tab + 1, line.len());
        let mut fields: Vec[String] = Vec.new();
        if opts.len() > 0 {
            for f in opts.split(",") {
                fields.push(f.to_string());
            }
        }
        let r = match loads(cps_of(doc), load_opts(fields, 0), cats) {
            Ok(v) => repr_text(cats, v),
            Err(e) => exc_line(e),
        };
        let shown = if opts.len() > 0 { opts.clone() } else { "-".to_string() };
        println(f"  {shown} {doc} -> {r}");
    }
}

fn run(f: ref Vec[String], cats: ref Cats) -> Result[(), Exc] {
    if f[0] == "cases" {
        run_cases(cats);
        return Ok(());
    }
    if f[0] == "tool" {
        let mut args: Vec[String] = Vec.new();
        let mut i = 1;
        while i < f.len() {
            args.push(f[i].clone());
            i += 1;
        }
        print_streams(run_tool(args, cats));
        return Ok(());
    }
    let raw = fs.read_bytes(f"data/{f[1]}").unwrap_or(Vec.new());
    if f[0] == "parse" {
        parse_stream(decode_utf8(raw)?, cats);
        return Ok(());
    }
    let value = loads_bytes(raw, load_opts(f, 2), cats)?;
    if f[0] == "load" {
        println(f"  {repr_text(cats, value)}");
    } else if f[0] == "dump" {
        let s = to_text(dumps(value, dump_opts(f, 2), cats)?);
        for line in s.split("\n") {
            println(f"  |{line}");
        }
    } else if f[0] == "roundtrip" {
        println(roundtrip(value, cats)?);
    }
    Ok(())
}

// -------------------------------------------------------------- files

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn hex_val(c: u8) -> u8 {
    if c >= b'a' { c - b'a' + 10 } else { c - b'0' }
}

fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    let cats = load_cats();
    let jobs = fs.read_to_string("data/jobs.tsv".to_string()).unwrap_or(String.new());
    for job in jobs.lines() {
        let f: Vec[String] = job.split("\t").map(|p| p.to_string()).collect();
        println(f"== {f.join(" | ")}");
        if let Err(e) = run(f, cats) {
            println(f"  {exc_line(e)}");
        }
    }
}
// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    data_part_3(mut v);
    v
}

