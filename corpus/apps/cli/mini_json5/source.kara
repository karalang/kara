    v.push(DataFile { path: "broken/unterminated.json5".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("  \n");
    t.push_str("\t\n");
    v.push(DataFile { path: "broken/whitespace.json5".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("'\\01'\n");
    v.push(DataFile { path: "broken/zero_digit.json5".to_string(), hex: false, body: t });
}

