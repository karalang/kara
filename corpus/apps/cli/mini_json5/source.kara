    let mut t = String.new();
    t.push_str("{timeout: 1e}\n");
    v.push(DataFile { path: "broken/bad_exponent.json5".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("[1.5E+]\n");
