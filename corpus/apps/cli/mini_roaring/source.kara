// mini_roaring: Roaring bitmaps (Chambi, Lemire, Kaser and Godin), the
// compressed sets of u32 that Lucene, Druid, ClickHouse and Spark keep their
// postings and row sets in. A bitmap splits each value into a 16-bit chunk
// key and a 16-bit low half; each chunk is an array of sorted lows (at most
// 4096 of them), a 1024-word bitmap, or a list of runs. Sets combine chunk
// by chunk, and a bitmap reads and writes the portable serialization format
// that CRoaring, the Java library and pyroaring share (RoaringFormatSpec).
//
// The jobs are an analytics session over a week of product events: daily
// actives, retention and funnels as intersections, then ranges, rank and
// select, and .roar files written, dumped and read back.

const ARRAY_MAX: i64 = 4096;
const WORDS: i64 = 1024;
const COOKIE_NO_RUN: i64 = 12346;
const COOKIE_RUN: i64 = 12347;
const TOP: i64 = 4294967296;

// ------------------------------------------------------------ containers

// One chunk's lows: sorted u16s, 1024 words of bits with their count, or
// runs (each a start and its length less one).
#[derive(Clone)]
enum Container {
    Array(Vec[u16]),
    Bits(Vec[u64], i64),
    Runs(Vec[u16], Vec[u16]),
}

struct Chunk {
    key: i64,
    c: Container,
}

#[derive(Clone)]
struct Bitmap {
    chunks: Vec[Chunk],
}

fn bit(x: i64) -> u64 {
    (1 as u64) << ((x & 63) as u32)
}

fn card_of(c: ref Container) -> i64 {
    match c {
        Container.Array(a) => a.len(),
        Container.Bits(_, n) => n,
        Container.Runs(_, lens) => {
            let mut n = 0;
            for l in lens.iter() {
                n += (*l as i64) + 1;
            }
            n
        }
    }
}

fn kind_name(c: ref Container) -> Str {
    match c {
        Container.Array(_) => "array",
        Container.Bits(_, _) => "bitmap",
        Container.Runs(_, _) => "run",
    }
}

// The chunk's lows, ascending.
fn lows_of(c: ref Container) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    match c {
        Container.Array(a) => {
            for x in a.iter() {
                out.push(*x as i64);
            }
        }
        Container.Bits(w, _) => {
            for i in 0..WORDS {
                let mut word = w[i];
                while word != 0 {
                    let t = word.trailing_zeros();
                    out.push(i * 64 + t);
                    word = word & (word - 1);
                }
            }
        }
        Container.Runs(starts, lens) => {
            for i in 0..starts.len() {
                let s = starts[i] as i64;
                for x in s..(s + (lens[i] as i64) + 1) {
                    out.push(x);
                }
            }
        }
    }
    out
}

fn bits_of(c: ref Container) -> Vec[u64] {
    match c {
        Container.Bits(w, _) => w.clone(),
        _ => {
            let mut w: Vec[u64] = Vec.filled(WORDS, 0 as u64);
            for x in lows_of(c) {
                w[x >> 6] = w[x >> 6] | bit(x);
            }
            w
        }
    }
}

fn popcount(w: ref Vec[u64]) -> i64 {
    let mut n = 0;
    for x in w.iter() {
        n += x.count_ones();
    }
    n
}

// An array or a bitmap, by the count: the form every change leaves.
fn from_bits(w: own Vec[u64]) -> Option[Container] {
    let n = popcount(w);
    if n == 0 {
        None
    } else if n > ARRAY_MAX {
        Some(Container.Bits(w, n))
    } else {
        let c = Container.Bits(w, n);
        let mut a: Vec[u16] = Vec.new();
        for x in lows_of(c) {
            a.push(x as u16);
        }
        Some(Container.Array(a))
    }
}

fn from_lows(lows: ref Vec[i64]) -> Option[Container] {
    if lows.len() == 0 {
        None
    } else if lows.len() <= ARRAY_MAX {
        let mut a: Vec[u16] = Vec.new();
        for x in lows.iter() {
            a.push(*x as u16);
        }
        Some(Container.Array(a))
    } else {
        let mut w: Vec[u64] = Vec.filled(WORDS, 0 as u64);
        for x in lows.iter() {
            w[*x >> 6] = w[*x >> 6] | bit(*x);
        }
        Some(Container.Bits(w, lows.len()))
    }
}

// A run container as an array or a bitmap.
fn plain(c: ref Container) -> Container {
    match c {
        Container.Runs(_, _) => from_lows(lows_of(c)).unwrap(),
        Container.Array(a) => Container.Array(a.clone()),
        Container.Bits(w, n) => Container.Bits(w.clone(), n),
    }
}

// The first index in `a` whose value is not below `x`.
fn lower_bound(a: ref Vec[u16], x: i64) -> i64 {
    let mut lo = 0;
    let mut hi = a.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if (a[mid] as i64) < x {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo
}

fn contains_low(c: ref Container, x: i64) -> bool {
    match c {
        Container.Array(a) => {
            let i = lower_bound(a, x);
            i < a.len() and (a[i] as i64) == x
        }
        Container.Bits(w, _) => (w[x >> 6] & bit(x)) != 0,
        Container.Runs(starts, lens) => {
            // The last run starting at or before x.
            let i = lower_bound(starts, x + 1) - 1;
            i >= 0 and x <= (starts[i] as i64) + (lens[i] as i64)
        }
    }
}

// How many lows of the chunk are at most x.
fn rank_low(c: ref Container, x: i64) -> i64 {
    match c {
        Container.Array(a) => lower_bound(a, x + 1),
        Container.Bits(w, _) => {
            let mut n = 0;
            let last = x >> 6;
            for i in 0..last {
                n += w[i].count_ones();
            }
            let keep = if (x & 63) == 63 { ~(0 as u64) } else { bit(x + 1) - 1 };
            n + (w[last] & keep).count_ones()
        }
        Container.Runs(starts, lens) => {
            let mut n = 0;
            for i in 0..starts.len() {
                let s = starts[i] as i64;
                let e = s + (lens[i] as i64);
                if s > x {
                    break;
                }
                n += if e <= x { e - s + 1 } else { x - s + 1 };
            }
            n
        }
    }
}

fn runs_in(lows: ref Vec[i64]) -> (Vec[u16], Vec[u16]) {
    let mut starts: Vec[u16] = Vec.new();
    let mut lens: Vec[u16] = Vec.new();
    let mut i = 0;
    while i < lows.len() {
        let s = lows[i];
        let mut j = i;
        while j + 1 < lows.len() and lows[j + 1] == lows[j] + 1 {
            j += 1;
        }
        starts.push(s as u16);
        lens.push((lows[j] - s) as u16);
        i = j + 1;
    }
    (starts, lens)
}

// The runs a container would need, counted without building them.
fn run_count(c: ref Container) -> i64 {
    match c {
        Container.Runs(starts, _) => starts.len(),
        Container.Array(a) => {
            let mut n = 0;
            for i in 0..a.len() {
                if i == 0 or (a[i] as i64) != (a[i - 1] as i64) + 1 {
                    n += 1;
                }
            }
            n
        }
        Container.Bits(w, _) => {
            // A run starts at every set bit whose lower neighbour is clear.
            let mut n = 0;
            let mut carry: u64 = 0;
            for i in 0..WORDS {
                let word = w[i];
                let below = (word << 1) | carry;
                n += (word & ~below).count_ones();
                carry = word >> 63;
            }
            n
        }
    }
}

// ------------------------------------------------------------ two chunks

#[derive(PartialEq)]
enum Op {
    And,
    Or,
    Xor,
    AndNot,
}

fn merge_arrays(op: Op, a: ref Vec[u16], b: ref Vec[u16]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    let mut j = 0;
    while i < a.len() or j < b.len() {
        let x = if i < a.len() { a[i] as i64 } else { 65536 };
        let y = if j < b.len() { b[j] as i64 } else { 65536 };
        if x == y {
            match op {
                Op.And | Op.Or => out.push(x),
                _ => {}
            }
            i += 1;
            j += 1;
        } else if x < y {
            match op {
                Op.Or | Op.Xor | Op.AndNot => out.push(x),
                _ => {}
            }
            i += 1;
        } else {
            match op {
                Op.Or | Op.Xor => out.push(y),
                _ => {}
            }
            j += 1;
        }
    }
    out
}

fn combine(op: Op, a: ref Container, b: ref Container) -> Option[Container] {
    let pa = plain(a);
    let pb = plain(b);
    match (pa, pb) {
        (Container.Array(x), Container.Array(y)) => from_lows(merge_arrays(op, x, y)),
        (Container.Array(x), other) if op == Op.And => {
            // Probe the bitmap for each of the array's lows.
            let mut out: Vec[i64] = Vec.new();
            for v in x.iter() {
                if contains_low(other, *v as i64) {
                    out.push(*v as i64);
                }
            }
            from_lows(out)
        }
        (other, Container.Array(y)) if op == Op.And => {
            let mut out: Vec[i64] = Vec.new();
            for v in y.iter() {
                if contains_low(other, *v as i64) {
                    out.push(*v as i64);
                }
            }
            from_lows(out)
        }
        (x, y) => {
            let wa = bits_of(x);
            let wb = bits_of(y);
            let mut w: Vec[u64] = Vec.filled(WORDS, 0 as u64);
            for i in 0..WORDS {
                w[i] = match op {
                    Op.And => wa[i] & wb[i],
                    Op.Or => wa[i] | wb[i],
                    Op.Xor => wa[i] ^ wb[i],
                    Op.AndNot => wa[i] & ~wb[i],
                };
            }
            from_bits(w)
        }
    }
}

impl Op {
    fn name(ref self) -> Str {
        match self {
            Op.And => "and",
            Op.Or => "or",
            Op.Xor => "xor",
            Op.AndNot => "andnot",
        }
    }
}

// ------------------------------------------------------------ bitmaps

impl Bitmap {
    fn new() -> Bitmap {
        Bitmap { chunks: Vec.new() }
    }

    fn card(ref self) -> i64 {
        let mut n = 0;
        for ch in self.chunks.iter() {
            n += card_of(ch.c);
        }
        n
    }

    // The index of the chunk with this key, or where it would go.
    fn find(ref self, key: i64) -> (i64, bool) {
        let mut lo = 0;
        let mut hi = self.chunks.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if self.chunks[mid].key < key {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        (lo, lo < self.chunks.len() and self.chunks[lo].key == key)
    }

    fn contains(ref self, v: i64) -> bool {
        let (i, found) = self.find(v >> 16);
        found and contains_low(self.chunks[i].c, v & 65535)
    }

    fn add(mut ref self, v: i64) {
        let key = v >> 16;
        let low = v & 65535;
        let (i, found) = self.find(key);
        if not found {
            let mut a: Vec[u16] = Vec.new();
            a.push(low as u16);
            self.chunks.insert(i, Chunk { key: key, c: Container.Array(a) });
            return;
        }
        if contains_low(self.chunks[i].c, low) {
            return;
        }
        let next = match plain(self.chunks[i].c) {
            Container.Array(a) => {
                let mut a = a;
                let at = lower_bound(a, low);
                a.insert(at, low as u16);
                if a.len() > ARRAY_MAX {
                    let mut w: Vec[u64] = Vec.filled(WORDS, 0 as u64);
                    for x in a.iter() {
                        let x = *x as i64;
                        w[x >> 6] = w[x >> 6] | bit(x);
                    }
                    Container.Bits(w, a.len())
                } else {
                    Container.Array(a)
                }
            }
            Container.Bits(w, n) => {
                let mut w = w;
                w[low >> 6] = w[low >> 6] | bit(low);
                Container.Bits(w, n + 1)
            }
            Container.Runs(_, _) => unreachable("plain leaves no runs"),
        };
        self.chunks[i].c = next;
    }

    fn remove(mut ref self, v: i64) {
        let key = v >> 16;
        let low = v & 65535;
        let (i, found) = self.find(key);
        if not found or not contains_low(self.chunks[i].c, low) {
            return;
        }
        let next = match plain(self.chunks[i].c) {
            Container.Array(a) => {
                let mut a = a;
                let at = lower_bound(a, low);
                let _ = a.remove(at);
                if a.len() == 0 {
                    None
                } else {
                    Some(Container.Array(a))
                }
            }
            Container.Bits(w, _) => {
                let mut w = w;
                w[low >> 6] = w[low >> 6] & ~bit(low);
                from_bits(w)
            }
            Container.Runs(_, _) => unreachable("plain leaves no runs"),
        };
        match next {
            Some(c) => self.chunks[i].c = c,
            None => {
                let _ = self.chunks.remove(i);
            }
        }
    }

    // Adds, removes or flips [lo, hi) chunk by chunk: `how` is 0, 1 or 2.
    // A chunk the range adds to that was empty becomes one run; a chunk
    // whose values change becomes an array or a bitmap by its count, and
    // one whose values do not keeps its form.
    fn range_op(mut ref self, lo: i64, hi: i64, how: i64) {
        if lo >= hi {
            return;
        }
        let first = lo >> 16;
        let last = (hi - 1) >> 16;
        for key in first..(last + 1) {
            let a = if key == first { lo & 65535 } else { 0 };
            let b = if key == last { (hi - 1) & 65535 } else { 65535 };
            let (i, found) = self.find(key);
            if not found {
                if how == 1 {
                    continue;
                }
                let c = if how == 0 {
                    let mut s: Vec[u16] = Vec.new();
                    let mut l: Vec[u16] = Vec.new();
                    s.push(a as u16);
                    l.push((b - a) as u16);
                    Container.Runs(s, l)
                } else {
                    let mut w: Vec[u64] = Vec.filled(WORDS, 0 as u64);
                    set_span(mut w, a, b, 0);
                    from_bits(w).unwrap()
                };
                self.chunks.insert(i, Chunk { key: key, c: c });
                continue;
            }
            let before = card_of(self.chunks[i].c);
            let mut w = bits_of(self.chunks[i].c);
            set_span(mut w, a, b, how);
            if popcount(w) == before and how != 2 {
                continue;
            }
            match from_bits(w) {
                Some(c) => self.chunks[i].c = c,
                None => {
                    let _ = self.chunks.remove(i);
                }
            }
        }
    }

    fn combine_with(ref self, op: Op, other: ref Bitmap) -> Bitmap {
        let mut out = Bitmap.new();
        let mut i = 0;
        let mut j = 0;
        let a = ref self.chunks;
        let b = ref other.chunks;
        while i < a.len() or j < b.len() {
            let ka = if i < a.len() { a[i].key } else { 65536 };
            let kb = if j < b.len() { b[j].key } else { 65536 };
            if ka == kb {
                if let Some(c) = combine(op, a[i].c, b[j].c) {
                    out.chunks.push(Chunk { key: ka, c: c });
                }
                i += 1;
                j += 1;
            } else if ka < kb {
                match op {
                    Op.And => {}
                    _ => out.chunks.push(Chunk { key: ka, c: plain(a[i].c) }),
                }
                i += 1;
            } else {
                match op {
                    Op.Or | Op.Xor => out.chunks.push(Chunk { key: kb, c: plain(b[j].c) }),
                    _ => {}
                }
                j += 1;
            }
        }
        out
    }

    // Each chunk as runs when that is smaller than both other forms.
    fn optimize(mut ref self) {
        for ch in self.chunks.iter_mut() {
            let n = card_of(ch.c);
            let runs = run_count(ch.c);
            let other = if 2 * n < 8192 { 2 * n } else { 8192 };
            if 2 + 4 * runs < other {
                let (s, l) = runs_in(lows_of(ch.c));
                ch.c = Container.Runs(s, l);
            } else {
                ch.c = plain(ch.c);
            }
        }
    }

    fn rank(ref self, v: i64) -> i64 {
        let key = v >> 16;
        let mut n = 0;
        for ch in self.chunks.iter() {
            if ch.key < key {
                n += card_of(ch.c);
            } else if ch.key == key {
                n += rank_low(ch.c, v & 65535);
            }
        }
        n
    }

    fn select(ref self, i: i64) -> Option[i64] {
        let mut left = i;
        for ch in self.chunks.iter() {
            let n = card_of(ch.c);
            if left < n {
                let lows = lows_of(ch.c);
                return Some(ch.key * 65536 + lows[left]);
            }
            left -= n;
        }
        None
    }

    // The first `n` values, ascending.
    fn first(ref self, n: i64) -> Vec[i64] {
        let mut out: Vec[i64] = Vec.new();
        for ch in self.chunks.iter() {
            for x in lows_of(ch.c) {
                if out.len() == n {
                    return out;
                }
                out.push(ch.key * 65536 + x);
            }
        }
        out
    }

    fn max(ref self) -> i64 {
        let ch = self.chunks.last().unwrap();
        let lows = lows_of(ch.c);
        ch.key * 65536 + lows[lows.len() - 1]
    }

    fn values_equal(ref self, other: ref Bitmap) -> bool {
        if self.chunks.len() != other.chunks.len() {
            return false;
        }
        for i in 0..self.chunks.len() {
            if self.chunks[i].key != other.chunks[i].key {
                return false;
            }
            if lows_of(self.chunks[i].c) != lows_of(other.chunks[i].c) {
                return false;
            }
        }
        true
    }

    // Containers by form: (array, bitmap, run).
    fn forms(ref self) -> (i64, i64, i64) {
        let mut a = 0;
        let mut b = 0;
        let mut r = 0;
        for ch in self.chunks.iter() {
            match ch.c {
                Container.Array(_) => a += 1,
                Container.Bits(_, _) => b += 1,
                Container.Runs(_, _) => r += 1,
            }
        }
        (a, b, r)
    }
}

// Sets (how 0), clears (1) or flips (2) the lows a..=b of 1024 words.
fn set_span(w: mut ref Vec[u64], a: i64, b: i64, how: i64) {
    let wa = a >> 6;
    let wb = b >> 6;
    for i in wa..(wb + 1) {
        let lo = if i == wa { a & 63 } else { 0 };
        let hi = if i == wb { b & 63 } else { 63 };
        let top = if hi == 63 { ~(0 as u64) } else { bit(hi + 1) - 1 };
        let mask = top & ~(bit(lo) - 1);
        w[i] = match how {
            0 => w[i] | mask,
            1 => w[i] & ~mask,
            _ => w[i] ^ mask,
        };
    }
}

// A bitmap of ascending, distinct values.
fn from_sorted(vals: ref Vec[i64]) -> Bitmap {
    let mut out = Bitmap.new();
    let mut i = 0;
    while i < vals.len() {
        let key = vals[i] >> 16;
        let mut lows: Vec[i64] = Vec.new();
        while i < vals.len() and vals[i] >> 16 == key {
            lows.push(vals[i] & 65535);
            i += 1;
        }
        out.chunks.push(Chunk { key: key, c: from_lows(lows).unwrap() });
    }
    out
}

// ------------------------------------------------------------ the format

fn put16(out: mut ref Vec[u8], v: i64) {
    out.push((v & 255) as u8);
    out.push(((v >> 8) & 255) as u8);
}

fn put32(out: mut ref Vec[u8], v: i64) {
    put16(mut out, v & 65535);
    put16(mut out, (v >> 16) & 65535);
}

fn put64(out: mut ref Vec[u8], v: u64) {
    for k in 0..8 {
        out.push(((v >> ((8 * k) as u32)) & 255) as u8);
    }
}

fn body_of(c: ref Container) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    match c {
        Container.Array(a) => {
            for x in a.iter() {
                put16(mut out, *x as i64);
            }
        }
        Container.Bits(w, _) => {
            for x in w.iter() {
                put64(mut out, *x);
            }
        }
        Container.Runs(starts, lens) => {
            put16(mut out, starts.len());
            for i in 0..starts.len() {
                put16(mut out, starts[i]);
                put16(mut out, lens[i]);
            }
        }
    }
    out
}

fn serialize(b: ref Bitmap) -> Vec[u8] {
    let n = b.chunks.len();
    let mut hasrun = false;
    for ch in b.chunks.iter() {
        if kind_name(ch.c) == "run" {
            hasrun = true;
        }
    }
    let mut out: Vec[u8] = Vec.new();
    if hasrun {
        put32(mut out, COOKIE_RUN | ((n - 1) << 16));
        let mut bits: Vec[u8] = Vec.filled((n + 7) / 8, 0 as u8);
        for i in 0..n {
            if kind_name(b.chunks[i].c) == "run" {
                bits[i / 8] = bits[i / 8] | ((1 as u8) << ((i % 8) as u32));
            }
        }
        out.extend(bits);
    } else {
        put32(mut out, COOKIE_NO_RUN);
        put32(mut out, n);
    }
    let mut bodies: Vec[Vec[u8]] = Vec.new();
    for ch in b.chunks.iter() {
        put16(mut out, ch.key);
        put16(mut out, card_of(ch.c) - 1);
        bodies.push(body_of(ch.c));
    }
    if not hasrun or n >= 4 {
        let mut pos = out.len() + 4 * n;
        for body in bodies.iter() {
            put32(mut out, pos);
            pos += body.len();
        }
    }
    for body in bodies.iter() {
        out.extend(body.clone());
    }
    out
}

struct Reader {
    data: Vec[u8],
    pos: i64,
}

impl Reader {
    fn need(ref self, k: i64, what: Str) -> Result[(), String] {
        if self.pos + k > self.data.len() {
            return Err(f"truncated {what}");
        }
        Ok(())
    }

    fn u16(mut ref self) -> i64 {
        let v = (self.data[self.pos] as i64) | ((self.data[self.pos + 1] as i64) << 8);
        self.pos += 2;
        v
    }

    fn u32(mut ref self) -> i64 {
        let lo = self.u16();
        let hi = self.u16();
        lo | (hi << 16)
    }

    fn u64(mut ref self) -> u64 {
        let mut v: u64 = 0;
        for k in 0..8 {
            v = v | ((self.data[self.pos + k] as u64) << ((8 * k) as u32));
        }
        self.pos += 8;
        v
    }
}

fn deserialize(data: own Vec[u8]) -> Result[Bitmap, String] {
    let mut r = Reader { data: data, pos: 0 };
    r.need(4, "header")?;
    let cookie = r.u32();
    let mut runbits: Option[Vec[u8]] = None;
    let n = if (cookie & 65535) == COOKIE_RUN {
        let n = (cookie >> 16) + 1;
        let k = (n + 7) / 8;
        r.need(k, "header")?;
        let mut bits: Vec[u8] = Vec.new();
        for _ in 0..k {
            bits.push(r.data[r.pos]);
            r.pos += 1;
        }
        runbits = Some(bits);
        n
    } else if cookie == COOKIE_NO_RUN {
        r.need(4, "header")?;
        r.u32()
    } else {
        return Err(f"bad cookie {cookie}");
    };
    if n > 65536 {
        return Err(f"{n} containers is more than 65536");
    }
    r.need(4 * n, "header")?;
    let mut keys: Vec[i64] = Vec.new();
    let mut cards: Vec[i64] = Vec.new();
    for i in 0..n {
        let k = r.u16();
        let c = r.u16() + 1;
        if i > 0 and k <= keys[i - 1] {
            return Err(f"keys out of order at container {i}");
        }
        keys.push(k);
        cards.push(c);
    }
    let mut offsets: Vec[i64] = Vec.new();
    if runbits.is_none() or n >= 4 {
        r.need(4 * n, "header")?;
        for _ in 0..n {
            offsets.push(r.u32());
        }
    }
    let mut out = Bitmap.new();
    for i in 0..n {
        if offsets.len() > 0 and offsets[i] != r.pos {
            return Err(f"offset of container {i} is {offsets[i]}, not {r.pos}");
        }
        let isrun = match runbits {
            Some(ref bits) => ((bits[i / 8] >> ((i % 8) as u32)) & 1) == 1,
            None => false,
        };
        let card = cards[i];
        let c = if isrun {
            r.need(2, f"container {i}")?;
            let nr = r.u16();
            r.need(4 * nr, f"container {i}")?;
            let mut starts: Vec[u16] = Vec.new();
            let mut lens: Vec[u16] = Vec.new();
            let mut total = 0;
            let mut last = -1;
            for _ in 0..nr {
                let s = r.u16();
                let l = r.u16();
                if s <= last or s + l > 65535 {
                    return Err(f"bad run in container {i}");
                }
                last = s + l;
                total += l + 1;
                starts.push(s as u16);
                lens.push(l as u16);
            }
            if total != card {
                return Err(f"container {i} holds {total} values, its header says {card}");
            }
            Container.Runs(starts, lens)
        } else if card <= ARRAY_MAX {
            r.need(2 * card, f"container {i}")?;
            let mut a: Vec[u16] = Vec.new();
            for j in 0..card {
                let x = r.u16();
                if j > 0 and x <= (a[j - 1] as i64) {
                    return Err(f"unsorted array in container {i}");
                }
                a.push(x as u16);
            }
            Container.Array(a)
        } else {
            r.need(8192, f"container {i}")?;
            let mut w: Vec[u64] = Vec.new();
            for _ in 0..WORDS {
                w.push(r.u64());
            }
            let got = popcount(w);
            if got != card {
                return Err(f"container {i} holds {got} values, its header says {card}");
            }
            Container.Bits(w, card)
        };
        out.chunks.push(Chunk { key: keys[i], c: c });
    }
    if r.pos != r.data.len() {
        let extra = r.data.len() - r.pos;
        return Err(f"{extra} bytes after the last container");
    }
    Ok(out)
}

// CRC-32 (IEEE), as zlib computes it.
fn crc32(data: ref Vec[u8]) -> i64 {
    let mut table: Vec[i64] = Vec.new();
    for n in 0..256 {
        let mut c = n;
        for _ in 0..8 {
            c = if (c & 1) == 1 { 3988292384 ^ (c >> 1) } else { c >> 1 };
        }
        table.push(c);
    }
    let mut crc = 4294967295;
    for b in data.iter() {
        crc = table[(crc ^ (*b as i64)) & 255] ^ (crc >> 8);
    }
    crc ^ 4294967295
}

fn hex2(v: i64) -> String {
    let digits = "0123456789abcdef";
    let hi = (v >> 4) & 15;
    let lo = v & 15;
    digits.substring(hi, hi + 1).to_string() + digits.substring(lo, lo + 1)
}

fn hex_word(v: i64, n: i64) -> String {
    let mut s = String.new();
    let mut k = n - 1;
    while k >= 0 {
        s = s + hex2((v >> ((8 * k) as u32)) & 255);
        k -= 1;
    }
    s
}

// ------------------------------------------------------------ events

const DAYS: Array[Str, 7] = ["1", "2", "3", "4", "5", "6", "7"];
const EVENTS: Array[Str, 4] = ["view", "signup", "cart", "buy"];

struct Row {
    day: String,
    user: i64,
    event: String,
}

fn is_digits(s: Str) -> bool {
    if s.len() == 0 {
        return false;
    }
    for c in s.bytes() {
        if c < b'0' or c > b'9' {
            return false;
        }
    }
    true
}

// A u32, or 2^32 itself where a range may end there.
fn parse_u32(s: Str, allow_top: bool) -> Result[i64, String] {
    if not is_digits(s) or s.len() > 10 {
        return Err(f"bad value: {s}");
    }
    let v = match i64.parse(s) {
        Ok(v) => v,
        Err(_) => return Err(f"bad value: {s}"),
    };
    let limit = if allow_top { TOP } else { TOP - 1 };
    if v > limit {
        return Err(f"bad value: {s}");
    }
    Ok(v)
}

fn parse_row(line: Str) -> Option[Row] {
    let parts: Vec[Str] = line.split(",").collect();
    if parts.len() != 3 {
        return None;
    }
    if not DAYS.contains(parts[0]) or not EVENTS.contains(parts[2]) {
        return None;
    }
    match parse_u32(parts[1], false) {
        Ok(u) => Some(Row { day: parts[0].to_string(), user: u, event: parts[2].to_string() }),
        Err(_) => None,
    }
}

// The users of the rows `keep` accepts, as a bitmap.
fn users_where(rows: ref Vec[Row], name: String) -> Bitmap {
    let mut vals: Vec[i64] = Vec.new();
    for r in rows.iter() {
        let hit = if name.starts_with("d") {
            "d" + r.day == name
        } else {
            "e_" + r.event == name
        };
        if hit {
            vals.push(r.user);
        }
    }
    vals.sort();
    vals.dedup();
    from_sorted(vals)
}

// ------------------------------------------------------------ jobs

fn forms_text(b: ref Bitmap) -> String {
    let (a, bm, r) = b.forms();
    f"array {a}, bitmap {bm}, run {r}"
}

fn stats_line(name: Str, b: ref Bitmap) -> String {
    let (a, bm, r) = b.forms();
    let bytes = serialize(b).len();
    let card = b.card();
    let n = b.chunks.len();
    f"{name}: card={card} containers={n} array={a} bitmap={bm} run={r} bytes={bytes}"
}

fn show(name: Str, b: ref Bitmap, out: mut ref Vec[String]) {
    if b.chunks.len() == 0 {
        out.push(f"{name}: empty");
        return;
    }
    let card = b.card();
    let min = b.first(1)[0];
    let max = b.max();
    out.push(f"{name}: card={card} min={min} max={max}");
    let n = b.chunks.len();
    out.push(f"  containers: {n} ({forms_text(b)})");
    let mut parts: Vec[String] = Vec.new();
    for i in 0..n {
        if i == 6 {
            parts.push("...".to_string());
            break;
        }
        let ch = ref b.chunks[i];
        parts.push(f"{ch.key}:{kind_name(ch.c)}:{card_of(ch.c)}");
    }
    out.push("  " + parts.join(" "));
    let first: Vec[String] = b.first(8).iter().map(|v| f"{v}").collect();
    let more = if card > 8 { " ..." } else { "" };
    out.push("  first: " + first.join(" ") + more);
}

fn hexdump(b: ref Bitmap, out: mut ref Vec[String]) {
    let data = serialize(b);
    let shown = if data.len() < 64 { data.len() } else { 64 };
    let mut i = 0;
    while i < shown {
        let end = if i + 16 < shown { i + 16 } else { shown };
        let mut row: Vec[String] = Vec.new();
        for k in i..end {
            row.push(hex2(data[k]));
        }
        out.push(f"  {hex_word(i, 2)}: {row.join(" ")}");
        i += 16;
    }
    let more = if data.len() > 64 { " (first 64 shown)" } else { "" };
    out.push(f"  {data.len()} bytes{more}");
}

struct Session {
    maps: Map[String, Bitmap],
}

impl Session {
    fn get(ref self, name: Str) -> Result[Bitmap, String] {
        match self.maps.get(name.to_string()) {
            Some(b) => Ok(b.clone()),
            None => Err(f"no bitmap named {name}"),
        }
    }

    fn get_or_new(ref self, name: Str) -> Bitmap {
        self.maps.get(name.to_string()).cloned() ?? Bitmap.new()
    }

    fn load(mut ref self, file: Str, out: mut ref Vec[String]) -> Result[(), String] {
        let text = match fs.read_to_string("data/" + file.to_string()) {
            Ok(t) => t,
            Err(e) => return Err(f"{file}: {e}"),
        };
        let mut rows: Vec[Row] = Vec.new();
        let mut bad = 0;
        let mut first = true;
        for line in text.split("\n") {
            if first {
                first = false;
                continue;
            }
            if line.len() == 0 {
                continue;
            }
            match parse_row(line) {
                Some(r) => rows.push(r),
                None => bad += 1,
            }
        }
        // One bitmap per day and per event, each built in a task of its
        // own; they print in name order.
        let mut names: Vec[String] = Vec.new();
        for d in DAYS {
            names.push("d" + d.to_string());
        }
        for e in EVENTS {
            names.push("e_" + e.to_string());
        }
        names.sort();
        let group = TaskGroup.new();
        let mut handles = Vec.new();
        for name in names.iter() {
            let name = name.clone();
            handles.push(group.spawn(|| users_where(rows, name)));
        }
        let mut built: Vec[Bitmap] = Vec.new();
        for h in handles.into_iter() {
            built.push(h.join());
        }
        out.push(f"loaded {file}: {rows.len()} rows, {bad} skipped, {names.len()} bitmaps");
        for i in 0..names.len() {
            let card = built[i].card();
            out.push(f"  {names[i]}: {card} users");
            self.maps[names[i].clone()] = built[i].clone();
        }
        Ok(())
    }

    fn job(mut ref self, line: Str, out: mut ref Vec[String]) -> Result[(), String] {
        let w: Vec[Str] = line.split_whitespace().collect();
        let cmd = w[0];
        let args: Vec[Str] = w[1..].to_vec();
        let need = |k: i64| {
            if args.len() < k {
                let s = if k > 1 { "s" } else { "" };
                return Err(f"{cmd}: needs {k} argument{s}");
            }
            Ok(())
        };
        match cmd {
            "load" => {
                need(1)?;
                self.load(args[0], out)?;
            }
            "show" => {
                need(1)?;
                let b = self.get(args[0])?;
                show(args[0], b, mut out);
            }
            "stats" => {
                need(1)?;
                let b = self.get(args[0])?;
                out.push(stats_line(args[0], b));
            }
            "and" | "or" | "xor" | "andnot" => {
                need(1)?;
                let op = match cmd {
                    "and" => Op.And,
                    "or" => Op.Or,
                    "xor" => Op.Xor,
                    _ => Op.AndNot,
                };
                let mut srcs: Vec[Bitmap] = Vec.new();
                for a in args[1..].iter() {
                    srcs.push(self.get(*a)?);
                }
                let mut acc = if srcs.len() == 0 { Bitmap.new() } else { srcs[0].clone() };
                for k in 1..srcs.len() {
                    acc = acc.combine_with(op, srcs[k]);
                }
                // A lone source is copied as its values, in plain form.
                if srcs.len() == 1 {
                    acc = acc.combine_with(Op.Or, Bitmap.new());
                }
                let card = acc.card();
                let names = args[1..].join(", ");
                self.maps[args[0].to_string()] = acc;
                out.push(f"{args[0]} = {op.name()}({names}): card={card}");
            }
            "addrange" | "removerange" | "flip" => {
                need(3)?;
                let lo = parse_u32(args[1], true)?;
                let hi = parse_u32(args[2], true)?;
                let mut b = self.get_or_new(args[0]);
                let (how, sign) = match cmd {
                    "addrange" => (0, "+="),
                    "removerange" => (1, "-="),
                    _ => (2, "^="),
                };
                b.range_op(lo, hi, how);
                let card = b.card();
                self.maps[args[0].to_string()] = b;
                out.push(f"{args[0]} {sign} [{lo}, {hi}): card={card}");
            }
            "add" | "remove" => {
                need(2)?;
                let mut vals: Vec[i64] = Vec.new();
                for a in args[1..].iter() {
                    vals.push(parse_u32(*a, false)?);
                }
                let mut b = self.get_or_new(args[0]);
                for v in vals.iter() {
                    if cmd == "add" {
                        b.add(*v);
                    } else {
                        b.remove(*v);
                    }
                }
                let card = b.card();
                self.maps[args[0].to_string()] = b;
                let sign = if cmd == "add" { "+" } else { "-" };
                let shown: Vec[String] = vals.iter().map(|v| f"{v}").collect();
                out.push(f"{args[0]} {sign} {{{shown.join(", ")}}}: card={card}");
            }
            "optimize" => {
                need(1)?;
                let mut b = self.get(args[0])?;
                b.optimize();
                out.push(f"{args[0]} optimized: {forms_text(b)}");
                self.maps[args[0].to_string()] = b;
            }
            "rank" => {
                need(2)?;
                let b = self.get(args[0])?;
                let v = parse_u32(args[1], false)?;
                out.push(f"rank({args[0]}, {v}) = {b.rank(v)}");
            }
            "select" => {
                need(2)?;
                let b = self.get(args[0])?;
                let i = parse_u32(args[1], false)?;
                match b.select(i) {
                    Some(v) => out.push(f"select({args[0]}, {i}) = {v}"),
                    None => out.push(f"! select({args[0]}, {i}): out of range (card {b.card()})"),
                }
            }
            "contains" => {
                need(2)?;
                let b = self.get(args[0])?;
                let mut parts: Vec[String] = Vec.new();
                for a in args[1..].iter() {
                    let v = parse_u32(*a, false)?;
                    let yes = if b.contains(v) { "yes" } else { "no" };
                    parts.push(f"{v} {yes}");
                }
                out.push(f"contains {args[0]}: {parts.join(", ")}");
            }
            "retention" => {
                need(2)?;
                let a = self.get(args[0])?;
                let b = self.get(args[1])?;
                let k = a.combine_with(Op.And, b).card();
                let n = a.card();
                if n == 0 {
                    out.push(f"retention {args[0]} -> {args[1]}: kept 0 of 0");
                } else {
                    let pm = k * 1000 / n;
                    out.push(f"retention {args[0]} -> {args[1]}: kept {k} of {n} ({pm} per mille)");
                }
            }
            "jaccard" => {
                need(2)?;
                let a = self.get(args[0])?;
                let b = self.get(args[1])?;
                let u = a.combine_with(Op.Or, b).card();
                if u == 0 {
                    out.push(f"jaccard({args[0]}, {args[1]}) undefined: both empty");
                } else {
                    let pm = a.combine_with(Op.And, b).card() * 1000 / u;
                    out.push(f"jaccard({args[0]}, {args[1]}) = {pm} per mille");
                }
            }
            "equal" => {
                need(2)?;
                let a = self.get(args[0])?;
                let b = self.get(args[1])?;
                let yes = if a.values_equal(b) { "yes" } else { "no" };
                out.push(f"{args[0]} == {args[1]}: {yes}");
            }
            "hexdump" => {
                need(1)?;
                let b = self.get(args[0])?;
                out.push(f"{args[0]}:");
                hexdump(b, mut out);
            }
            "save" => {
                need(2)?;
                let b = self.get(args[0])?;
                let data = serialize(b);
                let n = data.len();
                let crc = hex_word(crc32(data), 4);
                if let Err(e) = fs.write_bytes("data/" + args[1].to_string(), data) {
                    return Err(f"{args[1]}: {e}");
                }
                out.push(f"saved {args[0]} -> {args[1]}: {n} bytes, crc32 {crc}");
            }
            "loadroar" => {
                need(2)?;
                let data = match fs.read_bytes("data/" + args[1].to_string()) {
                    Ok(d) => d,
                    Err(_) => return Err(f"{args[1]}: cannot read"),
                };
                let b = match deserialize(data) {
                    Ok(b) => b,
                    Err(e) => return Err(f"{args[1]}: {e}"),
                };
                let card = b.card();
                let n = b.chunks.len();
                out.push(f"loaded {args[0]} <- {args[1]}: card={card} containers={n} ({forms_text(b)})");
                self.maps[args[0].to_string()] = b;
            }
            _ => return Err(f"unknown command: {cmd}"),
        }
        Ok(())
    }
}

fn is_hexd(c: u8) -> bool {
    (c >= b'0' and c <= b'9') or (c >= b'a' and c <= b'f') or (c >= b'A' and c <= b'F')
}

fn hex_val(c: u8) -> u8 {
    if c >= b'0' and c <= b'9' {
        c - b'0'
    } else if c >= b'a' and c <= b'f' {
        c - b'a' + 10
    } else {
        c - b'A' + 10
    }
}

fn unhex(s: Str) -> Vec[u8] {
    let mut digits: Vec[u8] = Vec.new();
    for c in s.bytes() {
        if is_hexd(c) {
            digits.push(hex_val(c));
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < digits.len() {
        out.push(digits[i] * 16 + digits[i + 1]);
        i += 2;
    }
    out
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn main() {
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        eprintln(f"cannot create data: {e}");
        return;
    }
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    let jobs = match fs.read_to_string("data/jobs.txt".to_string()) {
        Ok(t) => t,
        Err(e) => {
            eprintln(f"cannot read jobs.txt: {e}");
            return;
        }
    };
    let mut s = Session { maps: Map.new() };
    let mut out: Vec[String] = Vec.new();
    for line in jobs.split("\n") {
        let t = line.trim();
        if t.len() == 0 or t.starts_with("#") {
            continue;
        }
        out.push(f"> {t}");
        if let Err(e) = s.job(t, mut out) {
            out.push(f"! {e}");
        }
    }
    println(out.join("\n"));
}

// ============================================================ data

// The files under data/, in name order.
fn write_data() -> Result[(), String] {
    put_bytes("data/bad_cookie.roar", unhex(file_0()))?;
    put_bytes("data/events.csv", unhex(file_1()))?;
    put_bytes("data/jobs.txt", unhex(file_2()))?;
    put_bytes("data/shipped.roar", unhex(file_3()))?;
    put_bytes("data/truncated.roar", unhex(file_4()))?;
    put_bytes("data/unsorted.roar", unhex(file_5()))?;
    Ok(())
}

