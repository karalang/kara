// mini_tomlkit: tomlkit 0.13.2, the style-preserving TOML library for
// Python:
// - the parser, which keeps every comment, blank line, indent and
//   original spelling of a value, and its error messages with line and
//   column;
// - the document model: Container, Table, InlineTable, AoT, Array,
//   String, Integer, Float, Bool, the dates and times, Whitespace,
//   Comment and Null, with super tables, dotted keys and out-of-order
//   tables (OutOfOrderTableProxy);
// - editing in place: setting, replacing, deleting, appending and
//   inserting, setdefault, pop and update, comment() and indent(), and
//   arrays' add_line and multiline;
// - building: document, table, aot, inline_table, item(), string() and
//   the other constructors, value(), key_value() and dumps(), and
//   TOMLFile, which keeps a file's line endings;
// - a release script that bumps the versions in Cargo and Python
//   manifests and adds a CHANGELOG entry, and a migration of service
//   configs to a new schema, both keeping the files' formatting.
//
// The inputs are data/jobs.jsonl and the files beside it, made by mk.py.
// expected.out is the output of oracle.py, which runs the same jobs
// through tomlkit itself (the copy in tomlkit/).

struct DataFile {
    path: String,
    body: String,
}

fn write_data() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        return Err(f"cannot create data: {e}");
    }
    for file in data_files() {
        let mut dir = "data".to_string();
        let parts: Vec[Str] = file.path.split("/").collect();
        let mut i = 0;
        while i + 1 < parts.len() {
            dir = f"{dir}/{parts[i]}";
            i += 1;
        }
        if let Err(e) = fs.create_dir_all(dir) {
            return Err(f"cannot create {dir}: {e}");
        }
        if let Err(e) = fs.write(f"data/{file.path}", file.body.clone()) {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    if let Err(e) = run() {
        eprintln(failure(e));
    }
}

// ------------------------------------------------------------ Python values

// A value json.loads gives: integers keep their digits, so one past 64
// bits prints as Python prints it; objects keep their keys in order, and
// a repeated key keeps its first place and takes its last value.
#[derive(Clone)]
enum J {
    Null,
    Bool(bool),
    Int(String),
    Float(f64),
    Str(String),
    Arr(Vec[J]),
    Obj(Vec[Member]),
}

#[derive(Clone)]
struct Member {
    key: String,
    val: J,
}

// A raised exception: its class name and str().
#[derive(Clone)]
struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: own String) -> Exc {
    Exc { kind: kind.to_string(), msg: msg }
}

fn failure(e: ref Exc) -> String {
    f"{e.kind}: {e.msg}"
}

// ------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn push_utf8(out: mut ref Vec[u8], cp: i64) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push((0xC0 | (cp >> 6)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else if cp < 0x10000 {
        out.push((0xE0 | (cp >> 12)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else {
        out.push((0xF0 | (cp >> 18)) as u8);
        out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    }
}

fn is_surrogate(cp: i64) -> bool {
    cp >= 0xD800 and cp <= 0xDFFF
}

fn hex4(cp: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = 12;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn ascii_string(s: ref Vec[i64], start: i64, end: i64) -> String {
    let mut out: Vec[u8] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i] as u8);
        i += 1;
    }
    String.from_utf8(out).unwrap()
}


// ---------------------------------------------------------- decoding

// The C scanner in Modules/_json.c, over code points.
struct Scanner {
    s: Vec[i64],
}

fn is_digit(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn hex_value(c: i64) -> i64 {
    if c >= 48 and c <= 57 {
        c - 48
    } else if c >= 97 and c <= 102 {
        c - 87
    } else if c >= 65 and c <= 70 {
        c - 55
    } else {
        -1
    }
}

impl Scanner {
    fn at(ref self, i: i64) -> i64 {
        if i >= 0 and i < self.s.len() { self.s[i] } else { -1 }
    }

    // JSONDecodeError's message: the line and column are counted from the
    // newlines before the position.
    fn fail(ref self, msg: Str, pos: i64) -> Exc {
        let mut line = 1;
        let mut last = -1;
        let mut i = 0;
        while i < pos {
            if self.s[i] == 10 {
                line += 1;
                last = i;
            }
            i += 1;
        }
        exc("JSONDecodeError", f"{msg}: line {line} column {pos - last} (char {pos})")
    }

    fn skip_ws(ref self, start: i64) -> i64 {
        let mut i = start;
        while i < self.s.len() {
            let c = self.s[i];
            if c != 32 and c != 9 and c != 10 and c != 13 {
                break;
            }
            i += 1;
        }
        i
    }

    fn matches(ref self, i: i64, word: Str) -> bool {
        let w = word.bytes();
        if i + w.len() > self.s.len() {
            return false;
        }
        let mut k = 0;
        while k < w.len() {
            if self.s[i + k] != w[k] as i64 {
                return false;
            }
            k += 1;
        }
        true
    }

    fn scan_once(ref self, idx: i64) -> Result[(J, i64), Exc] {
        let c = self.at(idx);
        if c == 34 {
            let (text, end) = self.scan_string(idx + 1)?;
            return Ok((J.Str(cps_string(text)), end));
        }
        if c == 123 {
            return self.parse_object(idx + 1);
        }
        if c == 91 {
            return self.parse_array(idx + 1);
        }
        if c == 110 and self.matches(idx, "null") {
            return Ok((J.Null, idx + 4));
        }
        if c == 116 and self.matches(idx, "true") {
            return Ok((J.Bool(true), idx + 4));
        }
        if c == 102 and self.matches(idx, "false") {
            return Ok((J.Bool(false), idx + 5));
        }
        if c == 78 and self.matches(idx, "NaN") {
            return Ok((J.Float(0.0 / 0.0), idx + 3));
        }
        if c == 73 and self.matches(idx, "Infinity") {
            return Ok((J.Float(1.0 / 0.0), idx + 8));
        }
        if c == 45 and self.matches(idx, "-Infinity") {
            return Ok((J.Float(-1.0 / 0.0), idx + 9));
        }
        self.match_number(idx)
    }

    // -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][-+]?[0-9]+)?, then int() or float()
    // of the text. Anything else at a value's place is "Expecting value".
    fn match_number(ref self, start: i64) -> Result[(J, i64), Exc] {
        let end_idx = self.s.len() - 1;
        let mut idx = start;
        if self.at(idx) == 45 {
            idx += 1;
            if idx > end_idx {
                return Err(self.fail("Expecting value", start));
            }
        }
        let c = self.at(idx);
        if c >= 49 and c <= 57 {
            idx += 1;
            while idx <= end_idx and is_digit(self.s[idx]) {
                idx += 1;
            }
        } else if c == 48 {
            idx += 1;
        } else {
            return Err(self.fail("Expecting value", start));
        }
        let mut is_float = false;
        if idx < end_idx and self.s[idx] == 46 and is_digit(self.s[idx + 1]) {
            is_float = true;
            idx += 2;
            while idx <= end_idx and is_digit(self.s[idx]) {
                idx += 1;
            }
        }
        if idx < end_idx and (self.s[idx] == 101 or self.s[idx] == 69) {
            let e_start = idx;
            idx += 1;
            if idx < end_idx and (self.s[idx] == 45 or self.s[idx] == 43) {
                idx += 1;
            }
            while idx <= end_idx and is_digit(self.s[idx]) {
                idx += 1;
            }
            if is_digit(self.s[idx - 1]) {
                is_float = true;
            } else {
                idx = e_start;
            }
        }
        let text = ascii_string(self.s, start, idx);
        if is_float {
            return match f64.parse(text) {
                Ok(x) => Ok((J.Float(x), idx)),
                Err(_) => Err(exc("ValueError", f"could not convert string to float: '{text}'")),
            };
        }
        let digits = if self.s[start] == 45 { idx - start - 1 } else { idx - start };
        if digits > 4300 {
            return Err(exc("ValueError", f"Exceeds the limit (4300 digits) for integer string conversion: value has {digits} digits; use sys.set_int_max_str_digits() to increase the limit"));
        }
        if text == "-0" {
            return Ok((J.Int("0".to_string()), idx));
        }
        Ok((J.Int(text), idx))
    }

    fn hex_escape(ref self, at: i64) -> Option[i64] {
        let mut v = 0;
        let mut k = 0;
        while k < 4 {
            let d = hex_value(self.at(at + k));
            if d < 0 {
                return None;
            }
            v = v * 16 + d;
            k += 1;
        }
        Some(v)
    }

    // scanstring: `start` is just past the opening quote.
    fn scan_string(ref self, start: i64) -> Result[(Vec[i64], i64), Exc] {
        let len = self.s.len();
        let begin = start - 1;
        let mut out: Vec[i64] = Vec.new();
        let mut end = start;
        loop {
            let mut next = end;
            let mut c = 0;
            while next < len {
                c = self.s[next];
                if c == 34 or c == 92 {
                    break;
                }
                if c <= 0x1F {
                    return Err(self.fail("Invalid control character at", next));
                }
                out.push(c);
                next += 1;
            }
            if next == len {
                return Err(self.fail("Unterminated string starting at", begin));
            }
            next += 1;
            if c == 34 {
                return Ok((out, next));
            }
            if next == len {
                return Err(self.fail("Unterminated string starting at", begin));
            }
            let e = self.s[next];
            if e != 117 {
                end = next + 1;
                let ch = match e {
                    34 => 34,
                    92 => 92,
                    47 => 47,
                    98 => 8,
                    102 => 12,
                    110 => 10,
                    114 => 13,
                    116 => 9,
                    _ => 0,
                };
                if ch == 0 {
                    return Err(self.fail("Invalid \\escape", end - 2));
                }
                out.push(ch);
            } else {
                next += 1;
                end = next + 4;
                if end >= len {
                    return Err(self.fail("Invalid \\uXXXX escape", next - 1));
                }
                let mut cp = match self.hex_escape(next) {
                    Some(v) => v,
                    None => return Err(self.fail("Invalid \\uXXXX escape", end - 5)),
                };
                // A high surrogate followed by an escaped low one is a pair;
                // followed by anything else it stays on its own.
                if cp >= 0xD800 and cp <= 0xDBFF and end + 6 < len and self.s[end] == 92 and self.s[end + 1] == 117 {
                    let low = match self.hex_escape(end + 2) {
                        Some(v) => v,
                        None => return Err(self.fail("Invalid \\uXXXX escape", end + 1)),
                    };
                    if low >= 0xDC00 and low <= 0xDFFF {
                        cp = 0x10000 + (((cp - 0xD800) << 10) | (low - 0xDC00));
                        end += 6;
                    }
                }
                out.push(cp);
            }
        }
    }

    fn parse_object(ref self, start: i64) -> Result[(J, i64), Exc] {
        let mut members: Vec[Member] = Vec.new();
        let mut idx = self.skip_ws(start);
        if self.at(idx) != 125 {
            loop {
                if self.at(idx) != 34 {
                    return Err(self.fail("Expecting property name enclosed in double quotes", idx));
                }
                let (key, after_key) = self.scan_string(idx + 1)?;
                idx = self.skip_ws(after_key);
                if self.at(idx) != 58 {
                    return Err(self.fail("Expecting ':' delimiter", idx));
                }
                idx = self.skip_ws(idx + 1);
                let (val, after_val) = self.scan_once(idx)?;
                put_member(mut members, cps_string(key), val);
                idx = self.skip_ws(after_val);
                if self.at(idx) == 125 {
                    break;
                }
                if self.at(idx) != 44 {
                    return Err(self.fail("Expecting ',' delimiter", idx));
                }
                let comma = idx;
                idx = self.skip_ws(idx + 1);
                if self.at(idx) == 125 {
                    return Err(self.fail("Illegal trailing comma before end of object", comma));
                }
            }
        }
        Ok((J.Obj(members), idx + 1))
    }

    fn parse_array(ref self, start: i64) -> Result[(J, i64), Exc] {
        let mut items: Vec[J] = Vec.new();
        let mut idx = self.skip_ws(start);
        if self.at(idx) != 93 {
            loop {
                let (val, after) = self.scan_once(idx)?;
                items.push(val);
                idx = self.skip_ws(after);
                if self.at(idx) == 93 {
                    break;
                }
                if self.at(idx) != 44 {
                    return Err(self.fail("Expecting ',' delimiter", idx));
                }
                let comma = idx;
                idx = self.skip_ws(idx + 1);
                if self.at(idx) == 93 {
                    return Err(self.fail("Illegal trailing comma before end of array", comma));
                }
            }
        }
        Ok((J.Arr(items), idx + 1))
    }
}

// dict(pairs): a key seen again keeps its place and takes the new value.
fn put_member(members: mut ref Vec[Member], key: own String, val: own J) {
    let mut j = 0;
    while j < members.len() {
        if members[j].key == key {
            members[j].val = val;
            return;
        }
        j += 1;
    }
    members.push(Member { key: key, val: val });
}

// A str from code points. A lone surrogate, which a str can hold but a
// Kara String cannot, becomes U+FFFD.
fn cps_string(cps: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for c in cps.iter() {
        if is_surrogate(*c) {
            push_utf8(mut out, 0xFFFD);
        } else {
            push_utf8(mut out, *c);
        }
    }
    String.from_utf8(out).unwrap()
}

fn string_cps(s: ref String) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s.chars() {
        out.push(c as i64);
    }
    out
}

// json.loads on a str.
fn loads_cps(text: ref Vec[i64]) -> Result[J, Exc] {
    let sc = Scanner { s: text.clone() };
    if sc.at(0) == 0xFEFF {
        return Err(sc.fail("Unexpected UTF-8 BOM (decode using utf-8-sig)", 0));
    }
    let start = sc.skip_ws(0);
    let (value, end) = sc.scan_once(start)?;
    let stop = sc.skip_ws(end);
    if stop != sc.s.len() {
        return Err(sc.fail("Extra data", stop));
    }
    Ok(value)
}

fn loads_str(text: ref String) -> Result[J, Exc] {
    loads_cps(string_cps(text))
}

// The error bytes.decode("utf-8") raises: the bad byte, or the bytes from
// a sequence's start up to the one that does not fit.
fn utf8_error(b: ref Vec[u8], start: i64, end: i64, reason: Str) -> Exc {
    if end - start == 1 {
        return exc("UnicodeDecodeError", f"'utf-8' codec can't decode byte 0x{b[start]:02x} in position {start}: {reason}");
    }
    exc("UnicodeDecodeError", f"'utf-8' codec can't decode bytes in position {start}-{end - 1}: {reason}")
}

fn is_cont(c: u8) -> bool {
    c >= 0x80 and c <= 0xBF
}

// bytes.decode("utf-8", "surrogatepass"), as json.loads decodes bytes.
// An encoded surrogate (ED A0..BF 80..BF) is let through.
fn utf8_decode(b: ref Vec[u8]) -> Result[Vec[i64], Exc] {
    let mut out: Vec[i64] = Vec.new();
    let n = b.len();
    let mut i = 0;
    while i < n {
        let c = b[i];
        if c < 0x80 {
            out.push(c as i64);
            i += 1;
            continue;
        }
        if c < 0xC2 or c > 0xF4 {
            return Err(utf8_error(b, i, i + 1, "invalid start byte"));
        }
        let need = if c < 0xE0 { 1 } else if c < 0xF0 { 2 } else { 3 };
        // The range the second byte must fall in.
        let mut lo: u8 = 0x80;
        let mut hi: u8 = 0xBF;
        if c == 0xE0 {
            lo = 0xA0;
        } else if c == 0xF0 {
            lo = 0x90;
        } else if c == 0xF4 {
            hi = 0x8F;
        }
        // ED A0..BF starts a surrogate, which strict UTF-8 rejects at the
        // second byte; when the third byte does not complete it, the error
        // is that one.
        let surrogate = c == 0xED and n > i + 1 and b[i + 1] >= 0xA0 and b[i + 1] <= 0xBF;
        if surrogate and (n <= i + 2 or not is_cont(b[i + 2])) {
            return Err(utf8_error(b, i, i + 1, "invalid continuation byte"));
        }
        let mut k = 1;
        while k <= need {
            if i + k >= n {
                return Err(utf8_error(b, i, n, "unexpected end of data"));
            }
            let d = b[i + k];
            let ok = if k == 1 { d >= lo and d <= hi } else { is_cont(d) };
            if not ok {
                return Err(utf8_error(b, i, i + k, "invalid continuation byte"));
            }
            k += 1;
        }
        let mut cp = if need == 1 { (c as i64) & 0x1F } else if need == 2 { (c as i64) & 0x0F } else { (c as i64) & 0x07 };
        for j in 1..(need + 1) {
            cp = (cp << 6) | ((b[i + j] as i64) & 0x3F);
        }
        out.push(cp);
        i += need + 1;
    }
    Ok(out)
}

// json.loads on bytes: the encoding is detected (only UTF-8, with or
// without its BOM, is handled here), the bytes are decoded, and the text
// is loaded. A decode error is a ValueError, as JSONDecodeError is.
fn loads_bytes(b: ref Vec[u8]) -> Result[J, Exc] {
    let mut body = b.clone();
    if b.len() >= 3 and b[0] == 0xEF and b[1] == 0xBB and b[2] == 0xBF {
        body = Vec.new();
        for i in 3..b.len() {
            body.push(b[i]);
        }
    }
    let cps = utf8_decode(body)?;
    loads_cps(cps)
}
// ------------------------------------------------------------ text helpers

fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    f"{x}"
}

// str.isprintable outside ASCII: controls, format characters, separators
// other than space, surrogates and private use are not printable.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x8E2 or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

fn str_repr(s: ref String) -> String {
    let has_single = s.contains("'");
    let has_double = s.contains("\"");
    let quote = if has_single and not has_double { '"' } else { '\'' };
    let mut out = String.new();
    out.push(quote);
    for ch in s.chars() {
        let c = ch as i64;
        if ch == quote or ch == '\\' {
            out.push('\\');
            out.push(ch);
        } else if c == 9 {
            out.push_str("\\t");
        } else if c == 10 {
            out.push_str("\\n");
        } else if c == 13 {
            out.push_str("\\r");
        } else if c < 0x20 or c == 0x7F {
            out.push_str(f"\\x{hex_n(c, 2)}");
        } else if c < 0x7F or is_printable(c) {
            out.push(ch);
        } else if c <= 0xFF {
            out.push_str(f"\\x{hex_n(c, 2)}");
        } else if c <= 0xFFFF {
            out.push_str(f"\\u{hex_n(c, 4)}");
        } else {
            out.push_str(f"\\U{hex_n(c, 8)}");
        }
    }
    out.push(quote);
    out
}

fn json_str(s: ref String, out: mut ref String) {
    out.push('"');
    for ch in s.chars() {
        let c = ch as i64;
        if ch == '"' {
            out.push_str("\\\"");
        } else if ch == '\\' {
            out.push_str("\\\\");
        } else if c == 8 {
            out.push_str("\\b");
        } else if c == 12 {
            out.push_str("\\f");
        } else if c == 10 {
            out.push_str("\\n");
        } else if c == 13 {
            out.push_str("\\r");
        } else if c == 9 {
            out.push_str("\\t");
        } else if c < 0x20 {
            out.push_str(f"\\u{hex4(c)}");
        } else {
            out.push(ch);
        }
    }
    out.push('"');
}

fn json_float(x: f64) -> String {
    if x != x {
        return "NaN".to_string();
    }
    if x == 1.0 / 0.0 {
        return "Infinity".to_string();
    }
    if x == -1.0 / 0.0 {
        return "-Infinity".to_string();
    }
    float_repr(x)
}

// json.dumps(v, ensure_ascii=False) with the default separators.
fn json_dumps(v: ref J, out: mut ref String) {
    match v {
        J.Null => out.push_str("null"),
        J.Bool(b) => out.push_str(if b { "true" } else { "false" }),
        J.Int(s) => out.push_str(s),
        J.Float(x) => out.push_str(json_float(x)),
        J.Str(s) => json_str(s, mut out),
        J.Arr(xs) => {
            out.push('[');
            let mut i = 0;
            while i < xs.len() {
                if i > 0 {
                    out.push_str(", ");
                }
                json_dumps(xs[i], mut out);
                i += 1;
            }
            out.push(']');
        }
        J.Obj(ms) => {
            out.push('{');
            let mut i = 0;
            while i < ms.len() {
                if i > 0 {
                    out.push_str(", ");
                }
                json_str(ms[i].key, mut out);
                out.push_str(": ");
                json_dumps(ms[i].val, mut out);
                i += 1;
            }
            out.push('}');
        }
    }
}

fn cps(s: ref String) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for ch in s.chars() {
        out.push(ch as i64);
    }
    out
}

fn cp_char(c: i64) -> char {
    char.try_from(c as u32).unwrap()
}

fn cps_text(v: ref Vec[i64], start: i64, end: i64) -> String {
    let mut out = String.new();
    let mut i = start;
    while i < end {
        out.push(cp_char(v[i]));
        i += 1;
    }
    out
}

fn char_len(s: ref String) -> i64 {
    let mut n = 0;
    for _c in s.chars() {
        n += 1;
    }
    n
}

fn is_ascii_digit(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn is_ascii_alpha(c: i64) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

fn in_set(c: i64, set: Str) -> bool {
    for b in set.bytes() {
        if (b as i64) == c {
            return true;
        }
    }
    false
}

fn lower_ascii(s: ref String) -> String {
    let mut out = String.new();
    for ch in s.chars() {
        let c = ch as i64;
        if c >= 65 and c <= 90 {
            out.push(cp_char(c + 32));
        } else {
            out.push(ch);
        }
    }
    out
}

fn str_contains_cp(s: ref String, c: i64) -> bool {
    for ch in s.chars() {
        if (ch as i64) == c {
            return true;
        }
    }
    false
}

// str.splitlines(): the line breaks Python knows.
fn is_line_break(c: i64) -> bool {
    c == 10 or c == 13 or c == 11 or c == 12 or c == 0x1C or c == 0x1D or c == 0x1E or c == 0x85 or c == 0x2028 or c == 0x2029
}

// The lengths of str.splitlines()'s pieces.
fn splitline_lengths(s: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    let mut start = 0;
    while i < s.len() {
        let c = s[i];
        if is_line_break(c) {
            out.push(i - start);
            if c == 13 and i + 1 < s.len() and s[i + 1] == 10 {
                i += 1;
            }
            start = i + 1;
        }
        i += 1;
    }
    if start < s.len() {
        out.push(s.len() - start);
    }
    out
}

fn rstrip_ws(s: ref String) -> String {
    let v = cps(s);
    let mut end = v.len();
    while end > 0 and (v[end - 1] == 32 or v[end - 1] == 9 or v[end - 1] == 10 or v[end - 1] == 13 or v[end - 1] == 11 or v[end - 1] == 12) {
        end -= 1;
    }
    cps_text(v, 0, end)
}

fn strip_ws(s: ref String) -> String {
    let v = cps(s);
    let mut start = 0;
    let mut end = v.len();
    while start < end and (v[start] == 32 or v[start] == 9 or v[start] == 10 or v[start] == 13 or v[start] == 11 or v[start] == 12) {
        start += 1;
    }
    while end > start and (v[end - 1] == 32 or v[end - 1] == 9 or v[end - 1] == 10 or v[end - 1] == 13 or v[end - 1] == 11 or v[end - 1] == 12) {
        end -= 1;
    }
    cps_text(v, start, end)
}

fn pad2(n: i64) -> String {
    if n < 10 {
        f"0{n}"
    } else {
        f"{n}"
    }
}

fn pad_n(n: i64, w: i64) -> String {
    let mut s = f"{n}";
    while char_len(s) < w {
        s = f"0{s}";
    }
    s
}

// int(s, base) for the strings tomlkit hands it: surrounding whitespace,
// a sign, the base's prefix, and single underscores between digits.
// None where Python raises ValueError, or past 64 bits.
fn digit_value(c: i64) -> i64 {
    if c >= 48 and c <= 57 {
        return c - 48;
    }
    if c >= 97 and c <= 122 {
        return c - 87;
    }
    if c >= 65 and c <= 90 {
        return c - 55;
    }
    99
}

fn py_int(s: ref String, base: i64) -> Option[i64] {
    let t = cps(strip_ws(s));
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == 43 or t[i] == 45) {
        neg = t[i] == 45;
        i += 1;
    }
    if base != 10 and i + 1 < t.len() and t[i] == 48 {
        let p = t[i + 1];
        let want = if base == 16 { 120 } else if base == 8 { 111 } else { 98 };
        if p == want or p == want - 32 {
            i += 2;
            // An underscore may follow the prefix.
            if i < t.len() and t[i] == 95 {
                i += 1;
            }
        }
    }
    if i >= t.len() {
        return None;
    }
    let mut n: i64 = 0;
    let mut prev_us = true;
    while i < t.len() {
        let c = t[i];
        if c == 95 {
            if prev_us {
                return None;
            }
            prev_us = true;
            i += 1;
            continue;
        }
        let d = digit_value(c);
        if d >= base {
            return None;
        }
        if n > (9223372036854775807 - d) / base {
            return None;
        }
        n = n * base + d;
        prev_us = false;
        i += 1;
    }
    if prev_us {
        return None;
    }
    if neg {
        Some(-n)
    } else {
        Some(n)
    }
}

// float(s) for the lowercased, underscore-free text tomlkit hands it.
fn py_float(s: ref String) -> Option[f64] {
    let t = cps(strip_ws(s));
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == 43 or t[i] == 45) {
        neg = t[i] == 45;
        i += 1;
    }
    let rest = lower_ascii(cps_text(t, i, t.len()));
    if rest == "inf" or rest == "infinity" {
        return Some(if neg { -1.0 / 0.0 } else { 1.0 / 0.0 });
    }
    if rest == "nan" {
        let nan = 0.0 / 0.0;
        return Some(if neg { -nan } else { nan });
    }
    // [digits] [. digits] [e [sign] digits], with a digit somewhere
    // before the exponent.
    let mut j = i;
    let mut digits = 0;
    while j < t.len() and is_ascii_digit(t[j]) {
        j += 1;
        digits += 1;
    }
    if j < t.len() and t[j] == 46 {
        j += 1;
        while j < t.len() and is_ascii_digit(t[j]) {
            j += 1;
            digits += 1;
        }
    }
    if digits == 0 {
        return None;
    }
    if j < t.len() and (t[j] == 101 or t[j] == 69) {
        j += 1;
        if j < t.len() and (t[j] == 43 or t[j] == 45) {
            j += 1;
        }
        let mut e = 0;
        while j < t.len() and is_ascii_digit(t[j]) {
            j += 1;
            e += 1;
        }
        if e == 0 {
            return None;
        }
    }
    if j != t.len() {
        return None;
    }
    let text = cps_text(t, 0, t.len());
    match f64.parse(text) {
        Ok(x) => Some(x),
        Err(_) => None,
    }
}
// ------------------------------------------------------------ dates and times

// A datetime, date or time as Python holds it. tz is the UTC offset in
// minutes when has_tz; tzname is the name tomlkit gave the timezone.
#[derive(Clone)]
struct Dt {
    year: i64,
    month: i64,
    day: i64,
    hour: i64,
    minute: i64,
    second: i64,
    micro: i64,
    has_tz: bool,
    tz: i64,
}

fn dt_zero() -> Dt {
    Dt { year: 0, month: 0, day: 0, hour: 0, minute: 0, second: 0, micro: 0, has_tz: false, tz: 0 }
}

fn is_leap(y: i64) -> bool {
    (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
}

fn days_in_month(y: i64, m: i64) -> i64 {
    if m == 2 {
        if is_leap(y) { 29 } else { 28 }
    } else if m == 4 or m == 6 or m == 9 or m == 11 {
        30
    } else {
        31
    }
}

fn date_iso(d: ref Dt) -> String {
    f"{pad_n(d.year, 4)}-{pad2(d.month)}-{pad2(d.day)}"
}

fn time_iso(d: ref Dt) -> String {
    let mut s = f"{pad2(d.hour)}:{pad2(d.minute)}:{pad2(d.second)}";
    if d.micro != 0 {
        s.push_str(f".{pad_n(d.micro, 6)}");
    }
    s
}

fn tz_iso(d: ref Dt) -> String {
    if not d.has_tz {
        return String.new();
    }
    let sign = if d.tz < 0 { "-" } else { "+" };
    let a = if d.tz < 0 { -d.tz } else { d.tz };
    f"{sign}{pad2(a / 60)}:{pad2(a % 60)}"
}

fn datetime_iso(d: ref Dt) -> String {
    f"{date_iso(d)}T{time_iso(d)}{tz_iso(d)}"
}

// The pieces of tomlkit's RFC 3339 regexes, over code points.
fn digits_at(s: ref Vec[i64], i: i64, n: i64) -> bool {
    if i + n > s.len() {
        return false;
    }
    let mut j = i;
    while j < i + n {
        if not is_ascii_digit(s[j]) {
            return false;
        }
        j += 1;
    }
    true
}

fn num_at(s: ref Vec[i64], i: i64, n: i64) -> i64 {
    let mut v = 0;
    let mut j = i;
    while j < i + n {
        v = v * 10 + s[j] - 48;
        j += 1;
    }
    v
}

// RFC_3339_LOOSE: which of its date (group 1) and time (group 5) parts
// matched, or None when the whole text does not match.
struct Loose {
    date: bool,
    time: bool,
}

fn match_tz(s: ref Vec[i64], i: i64, strict: bool) -> i64 {
    // ([Zz]|[\+|\-]([01][0-9]|2[0-3]):([0-5][0-9]))? from i; returns
    // where it ends, i when absent.
    if i < s.len() and (s[i] == 90 or s[i] == 122) {
        return i + 1;
    }
    if i < s.len() and (s[i] == 43 or s[i] == 124 or s[i] == 45) and digits_at(s, i + 1, 2) and i + 3 < s.len() and s[i + 3] == 58 and digits_at(s, i + 4, 2) {
        let h = num_at(s, i + 1, 2);
        let m = num_at(s, i + 4, 2);
        if h <= 23 and m <= 59 {
            return i + 6;
        }
    }
    let _ = strict;
    i
}

fn match_loose(s: ref Vec[i64]) -> Option[Loose] {
    let mut i = 0;
    let mut date = false;
    // (([0-9]+)-(\d{2})-(\d{2}))?
    let mut j = 0;
    while j < s.len() and is_ascii_digit(s[j]) {
        j += 1;
    }
    if j > 0 and j < s.len() and s[j] == 45 and digits_at(s, j + 1, 2) and j + 3 < s.len() and s[j + 3] == 45 and digits_at(s, j + 4, 2) {
        date = true;
        i = j + 6;
    }
    let mut time = false;
    // (([Tt ])?(\d{2}):(\d{2}):(\d{2})(\.([0-9]+))?(tz)?)?
    let mut k = i;
    if k < s.len() and (s[k] == 84 or s[k] == 116 or s[k] == 32) {
        k += 1;
    }
    if digits_at(s, k, 2) and k + 2 < s.len() and s[k + 2] == 58 and digits_at(s, k + 3, 2) and k + 5 < s.len() and s[k + 5] == 58 and digits_at(s, k + 6, 2) {
        k += 8;
        if k < s.len() and s[k] == 46 and k + 1 < s.len() and is_ascii_digit(s[k + 1]) {
            k += 1;
            while k < s.len() and is_ascii_digit(s[k]) {
                k += 1;
            }
        }
        k = match_tz(s, k, false);
        time = true;
        i = k;
    }
    if i != s.len() {
        return None;
    }
    Some(Loose { date: date, time: time })
}

// What parse_rfc3339 gives: 0 a datetime, 1 a date, 2 a time.
struct Rfc {
    kind: i64,
    dt: Dt,
}

fn date_part(s: ref Vec[i64], d: mut ref Dt) -> i64 {
    // ([0-9]+)-(0[1-9]|1[012])-(0[1-9]|[12][0-9]|3[01]); returns the end,
    // or -1.
    let mut j = 0;
    while j < s.len() and is_ascii_digit(s[j]) {
        j += 1;
    }
    if j == 0 or j >= s.len() or s[j] != 45 or not digits_at(s, j + 1, 2) or j + 3 >= s.len() or s[j + 3] != 45 or not digits_at(s, j + 4, 2) {
        return -1;
    }
    let m = num_at(s, j + 1, 2);
    let day = num_at(s, j + 4, 2);
    if m < 1 or m > 12 or day < 1 or day > 31 {
        return -1;
    }
    // The year as int() reads it: leading zeros and all.
    let mut y = 0;
    let mut k = 0;
    while k < j {
        if y > 100000000 {
            y = 100000000;
        } else {
            y = y * 10 + s[k] - 48;
        }
        k += 1;
    }
    d.year = y;
    d.month = m;
    d.day = day;
    j + 6
}

fn time_part(s: ref Vec[i64], i: i64, d: mut ref Dt) -> i64 {
    // ([01][0-9]|2[0-3]):([0-5][0-9]):([0-5][0-9]|60)(\.([0-9]+))?
    if not digits_at(s, i, 2) or i + 2 >= s.len() or s[i + 2] != 58 or not digits_at(s, i + 3, 2) or i + 5 >= s.len() or s[i + 5] != 58 or not digits_at(s, i + 6, 2) {
        return -1;
    }
    let h = num_at(s, i, 2);
    let m = num_at(s, i + 3, 2);
    let sec = num_at(s, i + 6, 2);
    if h > 23 or m > 59 or sec > 60 {
        return -1;
    }
    d.hour = h;
    d.minute = m;
    d.second = sec;
    d.micro = 0;
    let mut k = i + 8;
    if k < s.len() and s[k] == 46 and k + 1 < s.len() and is_ascii_digit(s[k + 1]) {
        k += 1;
        let start = k;
        while k < s.len() and is_ascii_digit(s[k]) {
            k += 1;
        }
        // int(f"{frac:<06s}"[:6])
        let mut us = 0;
        let mut n = 0;
        while n < 6 {
            let c = if start + n < k { s[start + n] - 48 } else { 0 };
            us = us * 10 + c;
            n += 1;
        }
        d.micro = us;
    }
    k
}

fn bad_rfc() -> Exc {
    exc("ValueError", "Invalid RFC 339 string".to_string())
}

// parse_rfc3339, and the checks datetime(), date() and time() make on
// what it read.
fn parse_rfc3339(text: ref String) -> Result[Rfc, Exc] {
    let s = cps(text);
    let mut d = dt_zero();
    let e = date_part(s, mut d);
    if e >= 0 and e < s.len() and (s[e] == 84 or s[e] == 116 or s[e] == 32) {
        let t = time_part(s, e + 1, mut d);
        if t >= 0 {
            let z = match_tz(s, t, true);
            if z == s.len() {
                if z > t {
                    if s[t] == 90 or s[t] == 122 {
                        d.has_tz = true;
                        d.tz = 0;
                    } else {
                        let off = num_at(s, t + 1, 2) * 60 + num_at(s, t + 4, 2);
                        d.has_tz = true;
                        d.tz = if s[t] == 45 { -off } else { off };
                    }
                }
                check_date(d)?;
                check_time(d)?;
                return Ok(Rfc { kind: 0, dt: d });
            }
        }
    }
    let mut d2 = dt_zero();
    let e2 = date_part(s, mut d2);
    if e2 == s.len() {
        check_date(d2)?;
        return Ok(Rfc { kind: 1, dt: d2 });
    }
    let mut d3 = dt_zero();
    let t3 = time_part(s, 0, mut d3);
    if t3 >= 0 and t3 == s.len() {
        check_time(d3)?;
        return Ok(Rfc { kind: 2, dt: d3 });
    }
    Err(bad_rfc())
}

fn check_date(d: ref Dt) -> Result[(), Exc] {
    if d.year < 1 or d.year > 9999 {
        return Err(exc("ValueError", f"year {d.year} is out of range"));
    }
    if d.day > days_in_month(d.year, d.month) {
        return Err(exc("ValueError", "day is out of range for month".to_string()));
    }
    Ok(())
}

fn check_time(d: ref Dt) -> Result[(), Exc] {
    if d.second > 59 {
        return Err(exc("ValueError", "second must be in 0..59".to_string()));
    }
    Ok(())
}

// ------------------------------------------------------------ plain values

// What unwrap() gives, and the values a job hands tomlkit.
#[derive(Clone)]
enum PyV {
    None,
    Bool(bool),
    Int(i64),
    Float(f64),
    Str(String),
    List(Vec[PyV]),
    Dict(Vec[PyItem]),
    DateTime(Dt),
    Date(Dt),
    Time(Dt),
}

#[derive(Clone)]
struct PyItem {
    key: String,
    val: PyV,
}

fn show(v: ref PyV) -> String {
    match v {
        PyV.None => "None".to_string(),
        PyV.Bool(b) => if b { "True".to_string() } else { "False".to_string() },
        PyV.Int(n) => f"{n}",
        PyV.Float(x) => float_repr(x),
        PyV.Str(s) => str_repr(s),
        PyV.List(xs) => {
            let mut out = "[".to_string();
            let mut i = 0;
            while i < xs.len() {
                if i > 0 {
                    out.push_str(", ");
                }
                out.push_str(show(xs[i]));
                i += 1;
            }
            out.push(']');
            out
        }
        PyV.Dict(ms) => {
            let mut out = "{".to_string();
            let mut i = 0;
            while i < ms.len() {
                if i > 0 {
                    out.push_str(", ");
                }
                out.push_str(str_repr(ms[i].key));
                out.push_str(": ");
                out.push_str(show(ms[i].val));
                i += 1;
            }
            out.push('}');
            out
        }
        PyV.DateTime(d) => f"datetime({datetime_iso(d)})",
        PyV.Date(d) => f"date({date_iso(d)})",
        PyV.Time(d) => f"time({time_iso(d)})",
    }
}

fn py_type(v: ref PyV) -> String {
    match v {
        PyV.None => "NoneType".to_string(),
        PyV.Bool(_) => "bool".to_string(),
        PyV.Int(_) => "int".to_string(),
        PyV.Float(_) => "float".to_string(),
        PyV.Str(_) => "str".to_string(),
        PyV.List(_) => "list".to_string(),
        PyV.Dict(_) => "dict".to_string(),
        PyV.DateTime(_) => "datetime".to_string(),
        PyV.Date(_) => "date".to_string(),
        PyV.Time(_) => "time".to_string(),
    }
}

// merge_dicts(d1, d2), for unwrap()'s repeated keys.
fn merge_dicts(d1: mut ref Vec[PyItem], d2: ref Vec[PyItem]) {
    for m in d2 {
        let mut found = -1;
        let mut i = 0;
        while i < d1.len() {
            if d1[i].key == m.key {
                found = i;
                break;
            }
            i += 1;
        }
        if found >= 0 {
            let mut merged = false;
            if let PyV.Dict(inner2) = m.val.clone() {
                if let PyV.Dict(inner1) = d1[found].val.clone() {
                    let mut inner1 = inner1;
                    merge_dicts(mut inner1, inner2);
                    d1[found].val = PyV.Dict(inner1);
                    merged = true;
                }
            }
            if not merged {
                d1[found].val = m.val.clone();
            }
        } else {
            d1.push(PyItem { key: m.key.clone(), val: m.val.clone() });
        }
    }
}

// ------------------------------------------------------------ keys

// KeyType: 0 bare, 1 basic ("), 2 literal (').
#[derive(Clone)]
struct SKey {
    key: String,
    t: i64,
    sep: String,
    original: String,
    dotted: bool,
}

// A SingleKey (single, parts holding just itself) or a DottedKey.
#[derive(Clone)]
struct Key {
    single: bool,
    parts: Vec[SKey],
    sep: String,
    original: String,
}

fn key_delim(t: i64) -> Str {
    if t == 1 {
        "\""
    } else if t == 2 {
        "'"
    } else {
        ""
    }
}

fn is_bare_text(k: ref String) -> bool {
    if k.len() == 0 {
        return false;
    }
    for ch in k.chars() {
        let c = ch as i64;
        if not (is_ascii_alpha(c) or is_ascii_digit(c) or c == 45 or c == 95) {
            return false;
        }
    }
    true
}

// SingleKey(k, t, sep, original), with None as -1 / an empty Option.
fn skey(k: ref String, t: i64, sep: Option[String], original: Option[String]) -> SKey {
    let tt = if t >= 0 { t } else if is_bare_text(k) { 0 } else { 1 };
    let sp = match sep {
        Some(s) => s.clone(),
        None => " = ".to_string(),
    };
    let orig = match original {
        Some(o) => o.clone(),
        None => {
            let body = if tt == 1 { escape_string(k, basic_escapes()) } else { k.clone() };
            f"{key_delim(tt)}{body}{key_delim(tt)}"
        }
    };
    SKey { key: k.clone(), t: tt, sep: sp, original: orig, dotted: false }
}

fn single(s: own SKey) -> Key {
    Key { single: true, parts: vec![s], sep: String.new(), original: String.new() }
}

fn key_of(k: ref String) -> Key {
    single(skey(k, -1, None, None))
}

fn dotted_key(parts: own Vec[SKey], sep: Option[String], original: Option[String]) -> Key {
    let orig = match original {
        Some(o) => o.clone(),
        None => {
            let mut s = String.new();
            let mut i = 0;
            while i < parts.len() {
                if i > 0 {
                    s.push('.');
                }
                s.push_str(parts[i].original);
                i += 1;
            }
            s
        }
    };
    let sp = match sep {
        Some(s) => s.clone(),
        None => " = ".to_string(),
    };
    Key { single: false, parts: parts, sep: sp, original: orig }
}

fn key_str(k: ref Key) -> String {
    if k.single {
        return k.parts[0].key.clone();
    }
    let mut s = String.new();
    let mut i = 0;
    while i < k.parts.len() {
        if i > 0 {
            s.push('.');
        }
        s.push_str(k.parts[i].key);
        i += 1;
    }
    s
}

fn key_text(k: ref Key) -> String {
    if k.single {
        k.parts[0].original.clone()
    } else {
        k.original.clone()
    }
}

fn key_sep(k: ref Key) -> String {
    if k.single {
        k.parts[0].sep.clone()
    } else {
        k.sep.clone()
    }
}

fn set_key_sep(k: mut ref Key, s: own String) {
    if k.single {
        k.parts[0].sep = s;
    } else {
        k.sep = s;
    }
}

fn key_dotted(k: ref Key) -> bool {
    if k.single {
        k.parts[0].dotted
    } else {
        false
    }
}

fn key_multi(k: ref Key) -> bool {
    k.parts.len() > 1
}

fn key_bare(k: ref Key) -> bool {
    k.single and k.parts[0].t == 0
}

// Key.concat: a DottedKey of both keys' parts, with this key's sep.
fn key_concat(a: ref Key, b: ref Key) -> Key {
    let mut parts = a.parts.clone();
    for p in b.parts {
        parts.push(p.clone());
    }
    dotted_key(parts, Some(key_sep(a)), None)
}

// Key == Key as tomlkit compares them.
fn key_eq(a: ref Key, b: ref Key) -> bool {
    if a.single != b.single {
        return false;
    }
    if a.single {
        return a.parts[0].key == b.parts[0].key;
    }
    if a.parts.len() != b.parts.len() {
        return false;
    }
    let mut i = 0;
    while i < a.parts.len() {
        if a.parts[i].key != b.parts[i].key {
            return false;
        }
        i += 1;
    }
    true
}

// ------------------------------------------------------------ items

#[derive(Clone)]
struct Trivia {
    indent: String,
    comment_ws: String,
    comment: String,
    trail: String,
}

fn trivia() -> Trivia {
    Trivia { indent: String.new(), comment_ws: String.new(), comment: String.new(), trail: "\n".to_string() }
}

fn trivia4(indent: ref String, cws: ref String, comment: ref String, trail: ref String) -> Trivia {
    Trivia { indent: indent.clone(), comment_ws: cws.clone(), comment: comment.clone(), trail: trail.clone() }
}

// An _ArrayItemGroup: item indices, -1 for None.
#[derive(Clone)]
struct Group {
    value: i64,
    indent: i64,
    comma: i64,
    comment: i64,
}

fn group() -> Group {
    Group { value: -1, indent: -1, comma: -1, comment: -1 }
}

// Item kinds.
const K_WS: i64 = 0;
const K_COMMENT: i64 = 1;
const K_INT: i64 = 2;
const K_FLOAT: i64 = 3;
const K_BOOL: i64 = 4;
const K_DATETIME: i64 = 5;
const K_DATE: i64 = 6;
const K_TIME: i64 = 7;
const K_ARRAY: i64 = 8;
const K_TABLE: i64 = 9;
const K_INLINE: i64 = 10;
const K_STRING: i64 = 11;
const K_AOT: i64 = 12;
const K_NULL: i64 = 13;

// StringType: 0 SLB ("), 1 MLB ("""), 2 SLL ('), 3 MLL (''').
fn st_value(t: i64) -> Str {
    if t == 0 {
        "\""
    } else if t == 1 {
        "\"\"\""
    } else if t == 2 {
        "'"
    } else {
        "'''"
    }
}

fn st_unit(t: i64) -> i64 {
    if t < 2 { 34 } else { 39 }
}

fn st_basic(t: i64) -> bool {
    t < 2
}

fn st_multiline(t: i64) -> bool {
    t == 1 or t == 3
}

fn st_toggle(t: i64) -> i64 {
    if t == 0 {
        1
    } else if t == 1 {
        0
    } else if t == 2 {
        3
    } else {
        2
    }
}

fn st_name(t: i64) -> Str {
    if t == 0 {
        "StringType.SLB"
    } else if t == 1 {
        "StringType.MLB"
    } else if t == 2 {
        "StringType.SLL"
    } else {
        "StringType.MLL"
    }
}

#[derive(Clone)]
struct ItemD {
    kind: i64,
    tv: Trivia,
    // Whitespace: s and fixed. String: s is the value, raw the original.
    // Integer, Float, the dates: raw.
    s: String,
    raw: String,
    fixed: bool,
    ival: i64,
    fval: f64,
    sign: bool,
    st: i64,
    dt: Dt,
    // Array: the list, its groups, multiline.
    elems: Vec[i64],
    groups: Vec[Group],
    multiline: bool,
    // Table and InlineTable: the container; AoT: its tables.
    cont: i64,
    aot_elem: bool,
    sup: i64,
    name: Option[String],
    display: Option[String],
    inew: bool,
    body: Vec[i64],
    parsed: bool,
}

fn item_d(kind: i64, tv: own Trivia) -> ItemD {
    ItemD {
        kind: kind,
        tv: tv,
        s: String.new(),
        raw: String.new(),
        fixed: false,
        ival: 0,
        fval: 0.0,
        sign: false,
        st: 0,
        dt: dt_zero(),
        elems: Vec.new(),
        groups: Vec.new(),
        multiline: false,
        cont: -1,
        aot_elem: false,
        sup: -1,
        name: None,
        display: None,
        inew: false,
        body: Vec.new(),
        parsed: false,
    }
}

// A body entry of a Container.
#[derive(Clone)]
struct Ent {
    key: Option[Key],
    item: i64,
}

// A _map entry: the key object first stored, and its body indices (one
// index stands for an int, more for a tuple).
#[derive(Clone)]
struct MapEnt {
    key: Key,
    idx: Vec[i64],
}

#[derive(Clone)]
struct Cont {
    map: Vec[MapEnt],
    body: Vec[Ent],
    parsed: bool,
    table_keys: Vec[Key],
    dkeys: Vec[String],
}

struct World {
    items: Vec[ItemD],
    conts: Vec[Cont],
    proxies: Vec[Proxy],
}

fn new_item(w: mut ref World, d: own ItemD) -> i64 {
    w.items.push(d);
    w.items.len() - 1
}

fn new_cont(w: mut ref World, parsed: bool) -> i64 {
    w.conts.push(Cont { map: Vec.new(), body: Vec.new(), parsed: parsed, table_keys: Vec.new(), dkeys: Vec.new() });
    w.conts.len() - 1
}

fn mk_ws(w: mut ref World, s: ref String, fixed: bool) -> i64 {
    let mut d = item_d(K_WS, trivia());
    d.s = s.clone();
    d.fixed = fixed;
    new_item(mut w, d)
}

fn mk_ws_str(w: mut ref World, s: Str) -> i64 {
    mk_ws(mut w, s.to_string(), false)
}

fn mk_comment(w: mut ref World, tv: own Trivia) -> i64 {
    new_item(mut w, item_d(K_COMMENT, tv))
}

fn mk_null(w: mut ref World) -> i64 {
    let mut tv = trivia();
    tv.trail = String.new();
    new_item(mut w, item_d(K_NULL, tv))
}

fn mk_int(w: mut ref World, v: i64, tv: own Trivia, raw: ref String) -> i64 {
    let mut d = item_d(K_INT, tv);
    d.ival = v;
    d.raw = raw.clone();
    // re.match(r"^[+\-]\d+$", raw)
    let r = cps(raw);
    let mut sign = r.len() > 1 and (r[0] == 43 or r[0] == 45);
    if sign {
        let mut i = 1;
        while i < r.len() {
            if not is_ascii_digit(r[i]) {
                sign = false;
            }
            i += 1;
        }
    }
    d.sign = sign;
    new_item(mut w, d)
}

fn mk_float(w: mut ref World, v: f64, tv: own Trivia, raw: ref String) -> i64 {
    let mut d = item_d(K_FLOAT, tv);
    d.fval = v;
    d.raw = raw.clone();
    let r = cps(raw);
    d.sign = r.len() > 1 and (r[0] == 43 or r[0] == 45);
    new_item(mut w, d)
}

fn mk_bool(w: mut ref World, v: bool, tv: own Trivia) -> i64 {
    let mut d = item_d(K_BOOL, tv);
    d.ival = if v { 1 } else { 0 };
    new_item(mut w, d)
}

fn mk_dt(w: mut ref World, kind: i64, dt: ref Dt, tv: own Trivia, raw: ref String) -> i64 {
    let mut d = item_d(kind, tv);
    d.dt = dt.clone();
    d.raw = raw.clone();
    new_item(mut w, d)
}

fn mk_string(w: mut ref World, t: i64, value: ref String, original: ref String, tv: own Trivia) -> i64 {
    let mut d = item_d(K_STRING, tv);
    d.st = t;
    d.s = value.clone();
    d.raw = original.clone();
    new_item(mut w, d)
}

fn kind_name(k: i64) -> Str {
    if k == K_WS {
        "Whitespace"
    } else if k == K_COMMENT {
        "Comment"
    } else if k == K_INT {
        "Integer"
    } else if k == K_FLOAT {
        "Float"
    } else if k == K_BOOL {
        "Bool"
    } else if k == K_DATETIME {
        "DateTime"
    } else if k == K_DATE {
        "Date"
    } else if k == K_TIME {
        "Time"
    } else if k == K_ARRAY {
        "Array"
    } else if k == K_TABLE {
        "Table"
    } else if k == K_INLINE {
        "InlineTable"
    } else if k == K_STRING {
        "String"
    } else if k == K_AOT {
        "AoT"
    } else {
        "Null"
    }
}

fn kind_of(w: ref World, id: i64) -> i64 {
    w.items[id].kind
}

fn is_table(w: ref World, id: i64) -> bool {
    w.items[id].kind == K_TABLE
}

fn is_table_or_aot(w: ref World, id: i64) -> bool {
    let k = w.items[id].kind;
    k == K_TABLE or k == K_AOT
}

fn is_ws(w: ref World, id: i64) -> bool {
    w.items[id].kind == K_WS
}

fn is_null(w: ref World, id: i64) -> bool {
    w.items[id].kind == K_NULL
}
// ------------------------------------------------------------ errors

fn nonexistent(k: ref String) -> Exc {
    exc("NonExistentKey", str_repr(f"Key \"{k}\" does not exist."))
}

fn already_present(k: ref String) -> Exc {
    exc("KeyAlreadyPresent", f"Key \"{k}\" already exists.")
}

fn index_error(assign: bool) -> Exc {
    if assign {
        exc("IndexError", "list assignment index out of range".to_string())
    } else {
        exc("IndexError", "list index out of range".to_string())
    }
}

fn tk_error(msg: Str) -> Exc {
    exc("TOMLKitError", msg.to_string())
}

// ------------------------------------------------------------ escaping

// The escape sets: 0 the basic escapes of keys and SLB strings (the
// control characters, " and \), 1 those of MLB strings (the control
// characters but \n and \r, \ and """).
fn basic_escapes() -> i64 {
    0
}

fn is_control(c: i64) -> bool {
    c < 0x20 or c == 0x7F
}

fn compact_escape(c: i64) -> Option[String] {
    if c == 8 {
        Some("\\b".to_string())
    } else if c == 9 {
        Some("\\t".to_string())
    } else if c == 10 {
        Some("\\n".to_string())
    } else if c == 12 {
        Some("\\f".to_string())
    } else if c == 13 {
        Some("\\r".to_string())
    } else if c == 34 {
        Some("\\\"".to_string())
    } else if c == 92 {
        Some("\\\\".to_string())
    } else {
        None
    }
}

// _utils.escape_string over one of the escape sets above.
fn escape_string(s: ref String, set: i64) -> String {
    let v = cps(s);
    let mut out = String.new();
    let mut i = 0;
    while i < v.len() {
        let c = v[i];
        if set == 1 and c == 34 and i + 2 < v.len() and v[i + 1] == 34 and v[i + 2] == 34 {
            out.push_str("\"\"\\\"");
            i += 3;
            continue;
        }
        let escaped = if set == 0 {
            is_control(c) or c == 34 or c == 92
        } else {
            (is_control(c) and c != 10 and c != 13) or c == 92
        };
        if escaped {
            match compact_escape(c) {
                Some(e) => out.push_str(e),
                None => out.push_str(f"\\u{hex4(c)}"),
            }
        } else {
            out.push(cp_char(c));
        }
        i += 1;
    }
    out
}

fn seq_present(v: ref Vec[i64], seq: Str) -> bool {
    let s = cps(seq.to_string());
    let mut i = 0;
    while i + s.len() <= v.len() {
        let mut ok = true;
        let mut j = 0;
        while j < s.len() {
            if v[i + j] != s[j] {
                ok = false;
                break;
            }
            j += 1;
        }
        if ok {
            return true;
        }
        i += 1;
    }
    false
}

// String.from_raw(value, type_, escape).
fn string_from_raw(w: mut ref World, value: ref String, t: i64, escape: bool) -> Result[i64, Exc] {
    let v = cps(value);
    if t >= 2 {
        let mut bad = false;
        for c in v {
            if is_control(c) and c != 9 {
                if not (t == 3 and (c == 10 or c == 13)) {
                    bad = true;
                }
            }
        }
        if t == 2 and seq_present(v, "'") {
            bad = true;
        }
        if t == 3 and seq_present(v, "'''") {
            bad = true;
        }
        if bad {
            let r = str_repr(value);
            let inner = cps_text(cps(r), 1, char_len(r) - 1);
            return Err(exc("InvalidStringError", f"Invalid string: {st_value(t)}{inner}{st_value(t)}."));
        }
    }
    let shown = if escape and t < 2 {
        escape_string(value, if t == 0 { 0 } else { 1 })
    } else {
        value.clone()
    };
    Ok(mk_string(mut w, t, value, shown, trivia()))
}

// ------------------------------------------------------------ rendering

fn as_string(w: ref World, id: i64) -> String {
    let d = w.items[id].clone();
    let k = d.kind;
    if k == K_WS {
        d.s.clone()
    } else if k == K_COMMENT {
        f"{d.tv.indent}{d.tv.comment}{d.tv.trail}"
    } else if k == K_INT or k == K_FLOAT or k == K_DATETIME or k == K_DATE or k == K_TIME {
        d.raw.clone()
    } else if k == K_BOOL {
        if d.ival != 0 { "true".to_string() } else { "false".to_string() }
    } else if k == K_STRING {
        f"{st_value(d.st)}{d.raw}{st_value(d.st)}"
    } else if k == K_ARRAY {
        array_as_string(w, id)
    } else if k == K_TABLE {
        c_as_string(w, d.cont)
    } else if k == K_INLINE {
        inline_as_string(w, id)
    } else if k == K_AOT {
        let mut s = String.new();
        for t in d.body {
            s.push_str(as_string(w, t));
        }
        s
    } else {
        String.new()
    }
}

fn group_items(g: ref Group) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    if g.indent >= 0 {
        out.push(g.indent);
    }
    if g.value >= 0 {
        out.push(g.value);
    }
    if g.comma >= 0 {
        out.push(g.comma);
    }
    if g.comment >= 0 {
        out.push(g.comment);
    }
    out
}

fn array_as_string(w: ref World, id: i64) -> String {
    let d = w.items[id].clone();
    if not d.multiline or d.groups.len() == 0 {
        let mut s = "[".to_string();
        for g in d.groups {
            for x in group_items(g) {
                s.push_str(as_string(w, x));
            }
        }
        s.push(']');
        return s;
    }
    let mut s = "[\n".to_string();
    for g in d.groups {
        if g.value < 0 {
            continue;
        }
        s.push_str(d.tv.indent);
        s.push_str("    ");
        s.push_str(as_string(w, g.value));
        if not is_null(w, g.value) {
            s.push(',');
        }
        if g.comment >= 0 {
            s.push_str(as_string(w, g.comment));
        }
        s.push('\n');
    }
    s.push_str(d.tv.indent);
    s.push(']');
    s
}

fn rstrip_chars(s: ref String, chars: Str) -> String {
    let v = cps(s);
    let mut end = v.len();
    while end > 0 and in_set(v[end - 1], chars) {
        end -= 1;
    }
    cps_text(v, 0, end)
}

fn inline_as_string(w: ref World, id: i64) -> String {
    let d = w.items[id].clone();
    let body = w.conts[d.cont].body.clone();
    let mut buf = "{".to_string();
    let mut last = -1;
    let mut i = body.len() - 1;
    while i >= 0 {
        if body[i].key.is_some() {
            last = i;
            break;
        }
        i -= 1;
    }
    i = 0;
    while i < body.len() {
        let e = body[i].clone();
        match e.key {
            None => {
                if i == body.len() - 1 {
                    if d.inew {
                        buf = rstrip_chars(buf, ", ");
                    } else {
                        buf = rstrip_chars(buf, ",");
                    }
                }
                buf.push_str(as_string(w, e.item));
            }
            Some(k) => {
                let v = w.items[e.item].clone();
                let trail = v.tv.trail.replace("\n", "");
                buf.push_str(v.tv.indent);
                buf.push_str(key_text(k));
                if key_dotted(k) {
                    buf.push('.');
                }
                buf.push_str(key_sep(k));
                buf.push_str(as_string(w, e.item));
                buf.push_str(v.tv.comment);
                buf.push_str(trail);
                if last >= 0 and i < last {
                    buf.push(',');
                    if d.inew {
                        buf.push(' ');
                    }
                }
            }
        }
        i += 1;
    }
    buf.push('}');
    buf
}

// ------------------------------------------------------------ unwrap

fn unwrap_item(w: mut ref World, id: i64) -> Result[PyV, Exc] {
    let k = w.items[id].kind;
    if k == K_INT {
        return Ok(PyV.Int(w.items[id].ival));
    }
    if k == K_FLOAT {
        return Ok(PyV.Float(w.items[id].fval));
    }
    if k == K_BOOL {
        return Ok(PyV.Bool(w.items[id].ival != 0));
    }
    if k == K_STRING {
        return Ok(PyV.Str(w.items[id].s.clone()));
    }
    if k == K_DATETIME {
        return Ok(PyV.DateTime(w.items[id].dt.clone()));
    }
    if k == K_DATE {
        return Ok(PyV.Date(w.items[id].dt.clone()));
    }
    if k == K_TIME {
        return Ok(PyV.Time(w.items[id].dt.clone()));
    }
    if k == K_ARRAY {
        let elems = w.items[id].elems.clone();
        let mut out: Vec[PyV] = Vec.new();
        for e in elems {
            out.push(unwrap_item(mut w, e)?);
        }
        return Ok(PyV.List(out));
    }
    if k == K_TABLE or k == K_INLINE {
        let c = w.items[id].cont;
        return table_unwrap(mut w, c);
    }
    if k == K_AOT {
        let body = w.items[id].body.clone();
        let mut out: Vec[PyV] = Vec.new();
        for t in body {
            out.push(unwrap_item(mut w, t)?);
        }
        return Ok(PyV.List(out));
    }
    if k == K_NULL {
        return Ok(PyV.None);
    }
    Err(exc("NotImplementedError", String.new()))
}

fn unwrap_val(w: mut ref World, v: ref Val) -> Result[PyV, Exc] {
    match v {
        Val.Py(p) => Ok(p.clone()),
        Val.It(id) => unwrap_item(mut w, id),
        Val.Doc(c) => c_unwrap(mut w, c),
        Val.Prox(p) => {
            let inner = w.proxies[p].internal;
            c_unwrap(mut w, inner)
        }
        Val.Ky(_) => Err(exc("AttributeError", "'SingleKey' object has no attribute 'unwrap'".to_string())),
    }
}

// AbstractTable.unwrap: no merging of repeated keys.
fn table_unwrap(w: mut ref World, c: i64) -> Result[PyV, Exc] {
    let keys = w.conts[c].dkeys.clone();
    let mut out: Vec[PyItem] = Vec.new();
    for k in keys {
        let v = c_getitem(mut w, c, key_of(k))?;
        let p = unwrap_val(mut w, v)?;
        let mut found = false;
        let mut i = 0;
        while i < out.len() {
            if out[i].key == k {
                out[i].val = p.clone();
                found = true;
            }
            i += 1;
        }
        if not found {
            out.push(PyItem { key: k.clone(), val: p });
        }
    }
    Ok(PyV.Dict(out))
}

// ------------------------------------------------------------ item()

// item(value, _parent, _sort_keys): parent is the kind of the parent
// item, -1 for None.
fn item_of(w: mut ref World, v: ref Val, parent: i64, sort_keys: bool) -> Result[i64, Exc] {
    match v {
        Val.It(id) => Ok(id),
        Val.Py(p) => item_py(mut w, p, parent, sort_keys),
        Val.Doc(_) => Err(exc("ConvertError", "Unable to convert an object of <class 'tomlkit.toml_document.TOMLDocument'> to a TOML item".to_string())),
        Val.Prox(_) => Err(exc("ConvertError", "Unable to convert an object of <class 'tomlkit.container.OutOfOrderTableProxy'> to a TOML item".to_string())),
        Val.Ky(_) => Err(exc("ConvertError", "Unable to convert an object of <class 'tomlkit.items.SingleKey'> to a TOML item".to_string())),
    }
}

fn is_dict(p: ref PyV) -> bool {
    match p {
        PyV.Dict(_) => true,
        _ => false,
    }
}

// sorted(items, key=...) as item() sorts a dict's items: by (is a dict,
// key) when sorting keys, else not at all.
fn sorted_for_item(ms: ref Vec[PyItem], sort_keys: bool, dicts_last: bool) -> Vec[PyItem] {
    let mut out = ms.clone();
    if not sort_keys and not dicts_last {
        return out;
    }
    // A stable insertion sort.
    let mut i = 1;
    while i < out.len() {
        let mut j = i;
        while j > 0 {
            let a = out[j - 1].clone();
            let b = out[j].clone();
            let ad = is_dict(a.val);
            let bd = is_dict(b.val);
            let greater = if ad != bd {
                ad and not bd
            } else if sort_keys {
                a.key > b.key
            } else {
                false
            };
            if greater {
                out[j - 1] = b;
                out[j] = a;
                j -= 1;
            } else {
                break;
            }
        }
        i += 1;
    }
    out
}

fn new_table_item(w: mut ref World, kind: i64, aot_elem: bool) -> i64 {
    let c = new_cont(mut w, false);
    let mut d = item_d(kind, trivia());
    d.cont = c;
    if kind == K_TABLE {
        d.aot_elem = aot_elem;
    } else {
        d.inew = aot_elem;
    }
    new_item(mut w, d)
}

fn item_py(w: mut ref World, p: ref PyV, parent: i64, sort_keys: bool) -> Result[i64, Exc] {
    match p {
        PyV.Bool(b) => Ok(mk_bool(mut w, b, trivia())),
        PyV.Int(n) => Ok(mk_int(mut w, n, trivia(), f"{n}")),
        PyV.Float(x) => Ok(mk_float(mut w, x, trivia(), float_repr(x))),
        PyV.Str(s) => string_from_raw(mut w, s, 0, true),
        PyV.DateTime(d) => {
            let raw = datetime_iso(d).replace("+00:00", "Z");
            Ok(mk_dt(mut w, K_DATETIME, d, trivia(), raw))
        }
        PyV.Date(d) => Ok(mk_dt(mut w, K_DATE, d, trivia(), date_iso(d))),
        PyV.Time(d) => Ok(mk_dt(mut w, K_TIME, d, trivia(), time_iso(d))),
        PyV.Dict(ms) => {
            let kind = if parent == K_ARRAY or parent == K_INLINE { K_INLINE } else { K_TABLE };
            let t = new_table_item(mut w, kind, false);
            for m in sorted_for_item(ms, sort_keys, false) {
                let v = item_py(mut w, m.val, kind, sort_keys)?;
                table_setitem(mut w, t, m.key, Val.It(v))?;
            }
            Ok(t)
        }
        PyV.List(xs) => {
            let mut all_dicts = xs.len() > 0;
            for x in xs {
                if not is_dict(x) {
                    all_dicts = false;
                }
            }
            let aot = all_dicts and (parent == -1 or parent == K_TABLE);
            let a = if aot {
                let mut d = item_d(K_AOT, trivia());
                d.tv.trail = String.new();
                new_item(mut w, d)
            } else {
                new_item(mut w, item_d(K_ARRAY, trivia()))
            };
            let ctor = if aot { K_TABLE } else { K_INLINE };
            for x in xs {
                let v = match x {
                    PyV.Dict(ms) => {
                        let t = new_table_item(mut w, ctor, true);
                        for m in sorted_for_item(ms, sort_keys, true) {
                            let i = item_py(mut w, m.val, ctor, sort_keys)?;
                            if ctor == K_INLINE {
                                w.items[i].tv.trail = String.new();
                            }
                            table_setitem(mut w, t, m.key, Val.It(i))?;
                        }
                        Val.It(t)
                    }
                    _ => Val.Py(x.clone()),
                };
                if aot {
                    let n = w.items[a].body.len();
                    aot_insert(mut w, a, n, v)?;
                } else {
                    let n = w.items[a].elems.len();
                    array_insert(mut w, a, n, v)?;
                }
            }
            Ok(a)
        }
        PyV.None => Err(exc("ConvertError", "Unable to convert an object of <class 'NoneType'> to a TOML item".to_string())),
    }
}

// ------------------------------------------------------------ arrays

// Array(value, trivia): the list, and value grouped as _group_values
// groups it.
fn mk_array(w: mut ref World, value: ref Vec[i64], tv: own Trivia) -> i64 {
    let mut elems: Vec[i64] = Vec.new();
    for v in value {
        let k = w.items[*v].kind;
        if k != K_WS and k != K_COMMENT and k != K_NULL {
            elems.push(*v);
        }
    }
    let mut groups: Vec[Group] = Vec.new();
    let mut this = group();
    for v in value {
        let k = w.items[*v].kind;
        if k == K_WS {
            if not w.items[*v].s.contains(",") {
                groups.push(this.clone());
                this = group();
                this.indent = *v;
            } else {
                if this.value < 0 {
                    this.value = mk_null(mut w);
                }
                this.comma = *v;
            }
        } else if k == K_COMMENT {
            if this.value < 0 {
                this.value = mk_null(mut w);
            }
            this.comment = *v;
        } else if this.value < 0 {
            this.value = *v;
        } else {
            groups.push(this.clone());
            this = group();
            this.value = *v;
        }
    }
    groups.push(this);
    let mut kept: Vec[Group] = Vec.new();
    for g in groups {
        if g.indent >= 0 or g.value >= 0 or g.comma >= 0 or g.comment >= 0 {
            kept.push(g.clone());
        }
    }
    let mut d = item_d(K_ARRAY, tv);
    d.elems = elems;
    d.groups = kept;
    new_item(mut w, d)
}

// _reindex: the group of each value of the list.
fn index_map(w: ref World, a: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let groups = w.items[a].groups.clone();
    let mut i = 0;
    while i < groups.len() {
        let v = groups[i].value;
        if v >= 0 and not is_null(w, v) {
            out.push(i);
        }
        i += 1;
    }
    out
}

fn group_is_ws(g: ref Group) -> bool {
    g.value < 0 and g.comment < 0
}

fn ws_has(w: ref World, id: i64, c: Str) -> bool {
    id >= 0 and w.items[id].s.contains(c)
}

// list.insert's position: past the end appends, negative counts back.
fn list_pos(pos: i64, n: i64) -> i64 {
    if pos < 0 {
        let p = pos + n;
        if p < 0 { 0 } else { p }
    } else if pos > n {
        n
    } else {
        pos
    }
}

fn array_insert(w: mut ref World, a: i64, pos0: i64, value: own Val) -> Result[(), Exc] {
    let it = item_of(mut w, value, K_ARRAY, false)?;
    let length = w.items[a].elems.len();
    let ik = w.items[it].kind;
    if ik != K_COMMENT and ik != K_WS {
        let p = list_pos(pos0, length);
        w.items[a].elems.insert(p, it);
    }
    let mut pos = pos0;
    if pos < 0 {
        pos += length;
        if pos < 0 {
            pos = 0;
        }
    }
    let imap = index_map(w, a);
    let mut idx = 0;
    let mut default_indent = " ";
    if pos < length {
        if pos >= imap.len() {
            return Err(index_error(false));
        }
        idx = imap[pos];
    } else {
        idx = w.items[a].groups.len();
        if idx >= 1 and group_is_ws(w.items[a].groups[idx - 1]) {
            idx -= 1;
            let ind = w.items[a].groups[idx].indent;
            if ind >= 0 and ws_has(w, ind, "\n") {
                default_indent = "\n    ";
            }
        }
    }
    let mut indent = -1;
    let mut comma = if pos < length { mk_ws_str(mut w, ",") } else { -1 };
    let ng = w.items[a].groups.len();
    if idx < ng and not group_is_ws(w.items[a].groups[idx]) {
        indent = w.items[a].groups[idx].indent;
    }
    if idx > 0 {
        let last = w.items[a].groups[idx - 1].clone();
        if indent < 0 {
            indent = last.indent;
        }
        let last_null = last.value >= 0 and is_null(w, last.value);
        if not last_null and default_indent.contains("\n") {
            comma = last.comma;
        }
        if last.comma < 0 and not last_null {
            let c = mk_ws_str(mut w, ",");
            w.items[a].groups[idx - 1].comma = c;
        }
    }
    if indent < 0 and (idx > 0 or default_indent.contains("\n")) {
        indent = mk_ws_str(mut w, default_indent);
    }
    let g = Group { value: it, indent: indent, comma: comma, comment: -1 };
    w.items[a].groups.insert(idx, g);
    Ok(())
}

fn array_getitem(w: ref World, a: i64, i: i64) -> Result[Val, Exc] {
    let n = w.items[a].elems.len();
    let j = if i < 0 { i + n } else { i };
    if j < 0 or j >= n {
        return Err(index_error(false));
    }
    let id = w.items[a].elems[j];
    if w.items[id].kind == K_BOOL {
        return Ok(Val.Py(PyV.Bool(w.items[id].ival != 0)));
    }
    Ok(Val.It(id))
}

fn array_setitem(w: mut ref World, a: i64, i: i64, value: own Val) -> Result[(), Exc] {
    let it = item_of(mut w, value, K_ARRAY, false)?;
    let n = w.items[a].elems.len();
    let j = if i < 0 { i + n } else { i };
    if j < 0 or j >= n {
        return Err(index_error(true));
    }
    w.items[a].elems[j] = it;
    let imap = index_map(w, a);
    let g = imap[j];
    w.items[a].groups[g].value = it;
    Ok(())
}

fn array_delitem(w: mut ref World, a: i64, i: i64) -> Result[(), Exc] {
    let length = w.items[a].elems.len();
    let j = if i < 0 { length + i } else { i };
    if j < 0 or j >= length {
        return Err(index_error(true));
    }
    let imap = index_map(w, a);
    w.items[a].elems.remove(j);
    let idx = imap[j];
    w.items[a].groups.remove(idx);
    if idx == 0 and w.items[a].groups.len() > 0 {
        let ind = w.items[a].groups[0].indent;
        if ind >= 0 and not ws_has(w, ind, "\n") {
            w.items[a].groups[0].indent = -1;
        }
    }
    let ng = w.items[a].groups.len();
    if ng > 0 {
        if not group_is_ws(w.items[a].groups[ng - 1]) {
            w.items[a].groups[ng - 1].comma = -1;
        }
    }
    Ok(())
}

fn array_clear(w: mut ref World, a: i64) {
    w.items[a].elems.clear();
    w.items[a].groups.clear();
}

// add_line(*items, indent, comment, add_comma, newline).
fn array_add_line(w: mut ref World, a: i64, items: ref Vec[Val], indent: ref String, comment: Option[String], add_comma: bool, newline: bool) -> Result[(), Exc] {
    let mut new_values: Vec[i64] = Vec.new();
    let first_indent = if newline { f"\n{indent}" } else { indent.clone() };
    if first_indent.len() > 0 {
        new_values.push(mk_ws(mut w, first_indent, false));
    }
    let mut whitespace = String.new();
    let mut data_values: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < items.len() {
        let it = item_of(mut w, items[i], K_ARRAY, false)?;
        let k = w.items[it].kind;
        if k == K_COMMENT or (add_comma and k == K_WS) {
            return Err(exc("ValueError", f"item type <class 'tomlkit.items.{kind_name(k)}'> is not allowed in add_line"));
        }
        if k != K_WS {
            if whitespace.len() > 0 {
                new_values.push(mk_ws(mut w, whitespace, false));
                whitespace = String.new();
            }
            new_values.push(it);
            data_values.push(it);
            if add_comma {
                new_values.push(mk_ws_str(mut w, ","));
                if i != items.len() - 1 {
                    new_values.push(mk_ws_str(mut w, " "));
                }
            }
        } else if not w.items[it].s.contains(",") {
            whitespace.push_str(w.items[it].s);
        } else {
            new_values.push(it);
        }
        i += 1;
    }
    if whitespace.len() > 0 {
        new_values.push(mk_ws(mut w, whitespace, false));
    }
    if let Some(c) = comment {
        if c.len() > 0 {
            let ind = if items.len() > 0 { " " } else { "" };
            let mut tv = trivia();
            tv.indent = ind.to_string();
            tv.comment = f"# {c}";
            tv.trail = String.new();
            new_values.push(mk_comment(mut w, tv));
        }
    }
    for v in data_values {
        w.items[a].elems.push(v);
    }
    let tmp = mk_array(mut w, new_values, trivia());
    let new_groups = w.items[tmp].groups.clone();
    let ng = w.items[a].groups.len();
    if ng > 0 {
        let mut j = ng - 1;
        let mut last_value = -1;
        while j >= 0 {
            let v = w.items[a].groups[j].value;
            if v >= 0 and not is_null(w, v) {
                last_value = j;
                break;
            }
            j -= 1;
        }
        if last_value >= 0 {
            let c = mk_ws_str(mut w, ",");
            w.items[a].groups[last_value].comma = c;
        }
        if group_is_ws(w.items[a].groups[ng - 1]) {
            let mut at = ng - 1;
            for g in new_groups {
                w.items[a].groups.insert(at, g.clone());
                at += 1;
            }
        } else {
            for g in new_groups {
                w.items[a].groups.push(g.clone());
            }
        }
    } else {
        for g in new_groups {
            w.items[a].groups.push(g.clone());
        }
    }
    Ok(())
}

// ------------------------------------------------------------ arrays of tables

fn indent_spaces(s: ref String) -> Option[String] {
    // re.match(r"(?s)^[^ ]*([ ]+).*$", s).group(1)
    let v = cps(s);
    let mut i = 0;
    while i < v.len() and v[i] != 32 {
        i += 1;
    }
    if i >= v.len() {
        return None;
    }
    let mut j = i;
    while j < v.len() and v[j] == 32 {
        j += 1;
    }
    Some(cps_text(v, i, j))
}

// value.trivia.indent = prefix + indent + rest, where prefix runs up to
// the first space.
fn splice_indent(s: ref String, indent: ref String) -> String {
    let v = cps(s);
    let mut i = 0;
    while i < v.len() and v[i] != 32 {
        i += 1;
    }
    f"{cps_text(v, 0, i)}{indent}{cps_text(v, i, v.len())}"
}

fn aot_insert(w: mut ref World, a: i64, index0: i64, value: own Val) -> Result[(), Exc] {
    let t = item_of(mut w, value, K_AOT, false)?;
    if w.items[t].kind != K_TABLE {
        return Err(exc("ValueError", f"Unsupported insert value type: <class 'tomlkit.items.{kind_name(w.items[t].kind)}'>"));
    }
    let length = w.items[a].body.len();
    let mut index = index0;
    if index < 0 {
        index += length;
    }
    if index < 0 {
        index = 0;
    } else if index >= length {
        index = length;
    }
    if let Some(ind) = indent_spaces(w.items[a].tv.indent) {
        let s = splice_indent(w.items[t].tv.indent, ind);
        w.items[t].tv.indent = s;
    }
    // A table is truthy when it has keys.
    let mut prev = if index > 0 and length > 0 { w.items[a].body[index - 1] } else { -1 };
    let mut next = if index < length - 1 { w.items[a].body[index + 1] } else { -1 };
    if prev >= 0 and table_len(w, prev) == 0 {
        prev = -1;
    }
    if next >= 0 and table_len(w, next) == 0 {
        next = -1;
    }
    if not w.items[a].parsed {
        if prev >= 0 and not w.items[t].tv.indent.contains("\n") {
            let s = f"\n{w.items[t].tv.indent}";
            w.items[t].tv.indent = s;
        }
        if next >= 0 and not w.items[next].tv.indent.contains("\n") {
            let s = f"\n{w.items[next].tv.indent}";
            w.items[next].tv.indent = s;
        }
    }
    w.items[a].body.insert(index, t);
    Ok(())
}

fn aot_new(w: mut ref World, tables: ref Vec[i64], name: own Option[String], parsed: bool) -> Result[i64, Exc] {
    let mut d = item_d(K_AOT, trivia());
    d.tv.trail = String.new();
    d.name = name;
    d.parsed = parsed;
    let a = new_item(mut w, d);
    for t in tables {
        let n = w.items[a].body.len();
        aot_insert(mut w, a, n, Val.It(*t))?;
    }
    Ok(a)
}

fn aot_getitem(w: ref World, a: i64, i: i64) -> Result[Val, Exc] {
    let n = w.items[a].body.len();
    let j = if i < 0 { i + n } else { i };
    if j < 0 or j >= n {
        return Err(index_error(false));
    }
    Ok(Val.It(w.items[a].body[j]))
}

fn aot_delitem(w: mut ref World, a: i64, i: i64) -> Result[(), Exc] {
    let n = w.items[a].body.len();
    let j = if i < 0 { i + n } else { i };
    if j < 0 or j >= n {
        return Err(index_error(true));
    }
    w.items[a].body.remove(j);
    Ok(())
}

// ------------------------------------------------------------ tables

fn table_len(w: ref World, t: i64) -> i64 {
    w.conts[w.items[t].cont].dkeys.len()
}

// Table.append(key, item).
// key_obj: the key was given as a Key, not a str, so the item is fetched
// back through the container (a Bool comes back as a bool).
fn table_append(w: mut ref World, t: i64, key: Option[Key], key_obj: bool, value: own Val) -> Result[(), Exc] {
    let kind = w.items[t].kind;
    let it = item_of(mut w, value, kind, false)?;
    let c = w.items[t].cont;
    if kind == K_INLINE {
        let ik = w.items[it].kind;
        if ik != K_WS and ik != K_COMMENT {
            if w.items[it].tv.indent.len() == 0 and w.conts[c].dkeys.len() > 0 and not w.items[t].inew {
                w.items[it].tv.indent = " ".to_string();
            }
            if w.items[it].tv.comment.len() > 0 {
                w.items[it].tv.comment = String.new();
            }
        }
        c_append(mut w, c, key, it, true)?;
        return Ok(());
    }
    c_append(mut w, c, key.clone(), it, true)?;
    let mut target = Val.It(it);
    if let Some(k) = key {
        if key_obj {
            let first = k.parts[0].key.clone();
            target = c_getitem(mut w, c, key_of(first))?;
        }
    }
    let ind = match indent_spaces(w.items[t].tv.indent) {
        Some(s) => s,
        None => return Ok(()),
    };
    match target {
        Val.It(x) => {
            if w.items[x].kind != K_WS {
                let s = splice_indent(w.items[x].tv.indent, ind);
                w.items[x].tv.indent = s;
            }
        }
        Val.Py(p) => {
            return Err(exc("AttributeError", f"'{py_type(p)}' object has no attribute 'trivia'"));
        }
        _ => {
            return Err(exc("AttributeError", "'OutOfOrderTableProxy' object has no attribute 'trivia'".to_string()));
        }
    }
    Ok(())
}

// Table.raw_append(key, item): no indentation copied.
fn table_raw_append(w: mut ref World, t: i64, key: Option[Key], it: i64) -> Result[(), Exc] {
    let c = w.items[t].cont;
    c_append(mut w, c, key.clone(), it, false)?;
    // The item is fetched back by its first key, which builds (and
    // validates) a proxy when the key is now out of order.
    if let Some(k) = key {
        let first = k.parts[0].key.clone();
        c_getitem(mut w, c, key_of(first))?;
    }
    Ok(())
}

// AbstractTable.add(key, value) / add(item).
fn table_add(w: mut ref World, t: i64, key: Option[Key], key_obj: bool, value: Option[Val]) -> Result[(), Exc] {
    match value {
        Some(v) => table_append(mut w, t, key, key_obj, v.clone()),
        None => Err(exc("ValueError", "Non comment/whitespace items must have an associated key".to_string())),
    }
}

fn table_getitem(w: mut ref World, t: i64, key: Key) -> Result[Val, Exc] {
    let c = w.items[t].cont;
    c_getitem(mut w, c, key)
}

// AbstractTable.__setitem__, and InlineTable's, which drops comments.
fn table_setitem(w: mut ref World, t: i64, key: ref String, value: own Val) -> Result[(), Exc] {
    let kind = w.items[t].kind;
    let it = item_of(mut w, value, kind, false)?;
    if kind == K_INLINE {
        let ik = w.items[it].kind;
        if ik == K_WS {
            return Err(exc("RuntimeError", "Called trivia on a Whitespace variant.".to_string()));
        }
        if w.items[it].tv.comment.len() > 0 {
            w.items[it].tv.comment = String.new();
        }
    }
    let c = w.items[t].cont;
    let is_replace = c_contains(w, c, key);
    c_setitem(mut w, c, key, Val.It(it))?;
    if is_replace {
        return Ok(());
    }
    let ind = match indent_spaces(w.items[t].tv.indent) {
        Some(s) => s,
        None => return Ok(()),
    };
    if w.items[it].kind != K_WS {
        let s = splice_indent(w.items[it].tv.indent, ind);
        w.items[it].tv.indent = s;
    }
    Ok(())
}

fn table_remove(w: mut ref World, t: i64, key: Key) -> Result[(), Exc] {
    let c = w.items[t].cont;
    c_remove(mut w, c, key)
}

fn table_is_super(w: mut ref World, t: i64) -> Result[bool, Exc] {
    let sup = w.items[t].sup;
    if sup >= 0 {
        return Ok(sup == 1);
    }
    if table_len(w, t) == 0 {
        return Ok(false);
    }
    let c = w.items[t].cont;
    let keys = w.conts[c].dkeys.clone();
    for k in keys {
        let child = c_getitem(mut w, c, key_of(k))?;
        let me = map_find(w, c, k);
        let idx = w.conts[c].map[me].idx.clone();
        if idx.len() > 1 {
            return Ok(false);
        }
        let real_key = w.conts[c].body[idx[0]].key.clone();
        let child_ok = match child {
            Val.It(x) => is_table_or_aot(w, x),
            _ => false,
        };
        match real_key {
            None => return Ok(false),
            Some(rk) => {
                if not child_ok or key_dotted(rk) {
                    return Ok(false);
                }
            }
        }
    }
    Ok(true)
}

fn invalidate_display_name(w: mut ref World, id: i64) -> Result[(), Exc] {
    let k = w.items[id].kind;
    if k == K_AOT {
        let body = w.items[id].body.clone();
        for t in body {
            invalidate_display_name(mut w, t)?;
        }
        return Ok(());
    }
    if k != K_TABLE {
        return Ok(());
    }
    w.items[id].display = None;
    let c = w.items[id].cont;
    let keys = w.conts[c].dkeys.clone();
    for key in keys {
        let child = c_getitem(mut w, c, key_of(key))?;
        if let Val.It(x) = child {
            invalidate_display_name(mut w, x)?;
        }
    }
    Ok(())
}

// Item.comment(text).
fn item_comment(w: mut ref World, id: i64, text: ref String) {
    let mut c = text.clone();
    if not strip_ws(c).starts_with("#") {
        c = f"# {c}";
    }
    w.items[id].tv.comment_ws = " ".to_string();
    w.items[id].tv.comment = c;
}

fn spaces(n: i64) -> String {
    let mut s = String.new();
    let mut i = 0;
    while i < n {
        s.push(' ');
        i += 1;
    }
    s
}

// Item.indent(n), and Table.indent, which indents its items too.
fn item_indent(w: mut ref World, id: i64, n: i64) {
    let cur = w.items[id].tv.indent.clone();
    if cur.starts_with("\n") {
        w.items[id].tv.indent = f"\n{spaces(n)}";
    } else {
        w.items[id].tv.indent = spaces(n);
    }
    if w.items[id].kind != K_TABLE {
        return;
    }
    let ind = match indent_spaces(w.items[id].tv.indent) {
        Some(s) => s,
        None => String.new(),
    };
    let c = w.items[id].cont;
    let body = w.conts[c].body.clone();
    for e in body {
        if w.items[e.item].kind != K_WS {
            let s = f"{ind}{w.items[e.item].tv.indent}";
            w.items[e.item].tv.indent = s;
        }
    }
}
// ------------------------------------------------------------ containers

// What a Python expression can hold here: a plain value, an item, a
// document (its container), an out-of-order table proxy, or a key.
#[derive(Clone)]
enum Val {
    Py(PyV),
    It(i64),
    Doc(i64),
    Prox(i64),
    Ky(Key),
}

// A _tables_map entry: a key (None for whitespace and comments) and
// the tables it was found in.
#[derive(Clone)]
struct TMEnt {
    key: Option[Key],
    idx: Vec[i64],
}

struct Proxy {
    container: i64,
    internal: i64,
    tables: Vec[i64],
    tmap: Vec[TMEnt],
    dkeys: Vec[String],
}

fn mk_table(w: mut ref World, parsed: bool, tv: own Trivia, aot_elem: bool, sup: i64, name: own Option[String], display: own Option[String]) -> i64 {
    let c = new_cont(mut w, parsed);
    let mut d = item_d(K_TABLE, tv);
    d.cont = c;
    d.aot_elem = aot_elem;
    d.sup = sup;
    d.name = name;
    d.display = display;
    new_item(mut w, d)
}

fn mk_inline(w: mut ref World, c: i64, tv: own Trivia, new: bool) -> i64 {
    let mut d = item_d(K_INLINE, tv);
    d.cont = c;
    d.inew = new;
    new_item(mut w, d)
}

// The _map entry for a key, -1 when absent. Only single keys are ever
// stored, and a dotted key equals none of them.
fn map_find(w: ref World, c: i64, k: ref String) -> i64 {
    let mut i = 0;
    while i < w.conts[c].map.len() {
        if w.conts[c].map[i].key.parts[0].key == *k {
            return i;
        }
        i += 1;
    }
    -1
}

fn map_find_key(w: ref World, c: i64, k: ref Key) -> i64 {
    if not k.single {
        return -1;
    }
    map_find(w, c, k.parts[0].key)
}

fn dkeys_add(keys: mut ref Vec[String], k: ref String) {
    for x in keys {
        if x == k {
            return;
        }
    }
    keys.push(k.clone());
}

fn dkeys_del(keys: mut ref Vec[String], k: ref String) -> bool {
    let mut i = 0;
    while i < keys.len() {
        if keys[i] == *k {
            keys.remove(i);
            return true;
        }
        i += 1;
    }
    false
}

fn c_contains(w: ref World, c: i64, k: ref String) -> bool {
    map_find(w, c, k) >= 0
}

// Container.item(key).
fn c_item(w: mut ref World, c: i64, key: ref Key) -> Result[Val, Exc] {
    let m = map_find_key(w, c, key);
    if m < 0 {
        return Err(nonexistent(key_text(key)));
    }
    let idx = w.conts[c].map[m].idx.clone();
    if idx.len() > 1 {
        let p = proxy_new(mut w, c, idx)?;
        return Ok(Val.Prox(p));
    }
    Ok(Val.It(w.conts[c].body[idx[0]].item))
}

// Container.__getitem__: a Bool comes back as a bool.
fn c_getitem(w: mut ref World, c: i64, key: ref Key) -> Result[Val, Exc] {
    let v = c_item(mut w, c, key)?;
    if let Val.It(id) = v {
        if w.items[id].kind == K_BOOL {
            return Ok(Val.Py(PyV.Bool(w.items[id].ival != 0)));
        }
    }
    Ok(v)
}

fn c_unwrap(w: mut ref World, c: i64) -> Result[PyV, Exc] {
    table_unwrap(mut w, c)
}

fn c_last_item(w: ref World, c: i64) -> i64 {
    let n = w.conts[c].body.len();
    if n == 0 { -1 } else { w.conts[c].body[n - 1].item }
}

// _previous_item_with_index(): the last body index holding no Null.
fn c_prev_index(w: ref World, c: i64) -> i64 {
    let mut i = w.conts[c].body.len() - 1;
    while i >= 0 {
        if not is_null(w, w.conts[c].body[i].item) {
            return i;
        }
        i -= 1;
    }
    -1
}

fn c_prev_item(w: ref World, c: i64) -> i64 {
    let i = c_prev_index(w, c);
    if i < 0 { -1 } else { w.conts[c].body[i].item }
}

fn ends_with_whitespace(w: ref World, id: i64) -> bool {
    if id < 0 {
        return false;
    }
    let k = w.items[id].kind;
    if k == K_TABLE {
        let p = c_prev_item(w, w.items[id].cont);
        return p >= 0 and is_ws(w, p);
    }
    if k == K_AOT {
        let n = w.items[id].body.len();
        return n > 0 and is_ws(w, w.items[id].body[n - 1]);
    }
    false
}

fn c_parsing(w: mut ref World, c: i64, parsing: bool) {
    w.conts[c].parsed = parsing;
    let body = w.conts[c].body.clone();
    for e in body {
        let k = w.items[e.item].kind;
        if k == K_TABLE {
            c_parsing(mut w, w.items[e.item].cont, parsing);
        } else if k == K_AOT {
            let ts = w.items[e.item].body.clone();
            for t in ts {
                c_parsing(mut w, w.items[t].cont, parsing);
            }
        }
    }
}

fn key_is_dotted_opt(k: ref Option[Key]) -> bool {
    match k {
        Some(x) => key_dotted(x),
        None => false,
    }
}

fn c_handle_dotted_key(w: mut ref World, c: i64, key: ref Key, value: i64) -> Result[(), Exc] {
    if is_table_or_aot(w, value) {
        return Err(tk_error("Can't add a table to a dotted key"));
    }
    let n = key.parts.len();
    let mut name = key.parts[0].clone();
    name.dotted = true;
    let table = mk_table(mut w, true, trivia(), false, 1, None, None);
    let mut current = table;
    let mut i = 1;
    while i < n - 1 {
        let mut part = key.parts[i].clone();
        part.dotted = true;
        let nt = mk_table(mut w, true, trivia(), false, 1, None, None);
        table_append(mut w, current, Some(single(part)), true, Val.It(nt))?;
        current = nt;
        i += 1;
    }
    let mut last = key.parts[n - 1].clone();
    last.sep = key.sep.clone();
    table_append(mut w, current, Some(single(last)), true, Val.It(value))?;
    c_append(mut w, c, Some(single(name)), table, true)?;
    Ok(())
}

fn c_last_index_before_table(w: ref World, c: i64) -> i64 {
    let mut last = -1;
    let mut i = 0;
    while i < w.conts[c].body.len() {
        let e = w.conts[c].body[i].clone();
        let k = w.items[e.item].kind;
        if k == K_NULL {
            i += 1;
            continue;
        }
        if k == K_WS and not w.items[e.item].fixed {
            i += 1;
            continue;
        }
        if (k == K_TABLE or k == K_AOT) and not key_is_dotted_opt(e.key) {
            break;
        }
        last = i;
        i += 1;
    }
    last + 1
}

fn c_validate_ooo(w: mut ref World, c: i64) -> Result[(), Exc] {
    let mut i = 0;
    while i < w.conts[c].map.len() {
        let idx = w.conts[c].map[i].idx.clone();
        if idx.len() > 1 {
            proxy_validate(mut w, c, idx)?;
        }
        i += 1;
    }
    Ok(())
}

fn c_validate_key(w: mut ref World, c: i64, key: ref Key) -> Result[(), Exc] {
    let m = map_find_key(w, c, key);
    if m < 0 {
        return Ok(());
    }
    let idx = w.conts[c].map[m].idx.clone();
    if idx.len() > 1 {
        proxy_validate(mut w, c, idx)?;
    }
    Ok(())
}

// copy.deepcopy of an item, sharing nothing with the original.
struct Memo {
    old: Vec[i64],
    new: Vec[i64],
}

fn deep_copy(w: mut ref World, id: i64, memo: mut ref Memo) -> i64 {
    if id < 0 {
        return id;
    }
    let mut i = 0;
    while i < memo.old.len() {
        if memo.old[i] == id {
            return memo.new[i];
        }
        i += 1;
    }
    let d = w.items[id].clone();
    let n = new_item(mut w, d);
    memo.old.push(id);
    memo.new.push(n);
    let elems = w.items[id].elems.clone();
    let mut ne: Vec[i64] = Vec.new();
    for e in elems {
        ne.push(deep_copy(mut w, e, mut memo));
    }
    w.items[n].elems = ne;
    let groups = w.items[id].groups.clone();
    let mut ng: Vec[Group] = Vec.new();
    for g in groups {
        let v = deep_copy(mut w, g.value, mut memo);
        let ind = deep_copy(mut w, g.indent, mut memo);
        let cm = deep_copy(mut w, g.comma, mut memo);
        let co = deep_copy(mut w, g.comment, mut memo);
        ng.push(Group { value: v, indent: ind, comma: cm, comment: co });
    }
    w.items[n].groups = ng;
    let body = w.items[id].body.clone();
    let mut nb: Vec[i64] = Vec.new();
    for t in body {
        nb.push(deep_copy(mut w, t, mut memo));
    }
    w.items[n].body = nb;
    let c = w.items[id].cont;
    if c >= 0 {
        let nc = new_cont(mut w, w.conts[c].parsed);
        let mut cont = w.conts[c].clone();
        let mut j = 0;
        while j < cont.body.len() {
            cont.body[j].item = deep_copy(mut w, cont.body[j].item, mut memo);
            j += 1;
        }
        w.conts[nc] = cont;
        w.items[n].cont = nc;
    }
    n
}

fn copy_item(w: mut ref World, id: i64) -> i64 {
    let mut memo = Memo { old: Vec.new(), new: Vec.new() };
    deep_copy(mut w, id, mut memo)
}

// Container.append(key, item, validate).
fn c_append(w: mut ref World, c: i64, key: Option[Key], it: i64, validate: bool) -> Result[(), Exc] {
    if let Some(k) = key {
        if key_multi(k) {
            return c_handle_dotted_key(mut w, c, k, it);
        }
    }
    let ik = w.items[it].kind;
    if (ik == K_TABLE or ik == K_AOT) and w.items[it].name.is_none() {
        if let Some(k) = key {
            w.items[it].name = Some(key_str(k));
        }
    }
    let prev = c_prev_item(w, c);
    let prev_ws = (prev >= 0 and is_ws(w, prev)) or ends_with_whitespace(w, prev);
    let parsed = w.conts[c].parsed;
    let has_body = w.conts[c].body.len() > 0;
    if ik == K_TABLE {
        if not parsed {
            invalidate_display_name(mut w, it)?;
        }
        if has_body and not (parsed or w.items[it].tv.indent.len() > 0 or prev_ws) and not key_is_dotted_opt(key) {
            w.items[it].tv.indent = "\n".to_string();
        }
    }
    if ik == K_AOT and has_body and not parsed {
        invalidate_display_name(mut w, it)?;
        if w.items[it].body.len() > 0 {
            let first = w.items[it].body[0];
            if not (w.items[first].tv.indent.contains("\n") or prev_ws) {
                let s = f"\n{w.items[first].tv.indent}";
                w.items[first].tv.indent = s;
            }
        }
    }
    if let Some(k) = key {
        let m = map_find_key(w, c, k);
        if m >= 0 {
            let current_idx = w.conts[c].map[m].idx.clone();
            let last_pos = current_idx[current_idx.len() - 1];
            let cbe = w.conts[c].body[last_pos].clone();
            let current = cbe.item;
            let ck = w.items[current].kind;
            let cbe_key = cbe.key.unwrap();
            if ik == K_TABLE {
                if ck != K_TABLE and ck != K_AOT {
                    return Err(already_present(key_str(k)));
                }
                if w.items[it].aot_elem {
                    if ck != K_AOT {
                        let a = aot_new(mut w, vec![current, it], None, parsed)?;
                        c_replace(mut w, c, k, k, Val.It(a))?;
                    } else {
                        let n = w.items[current].body.len();
                        aot_insert(mut w, current, n, Val.It(it))?;
                    }
                    return Ok(());
                } else if ck == K_AOT {
                    return Err(already_present(key_str(k)));
                } else if table_is_super(mut w, current)? {
                    if table_is_super(mut w, it)? {
                        let tk = w.conts[c].table_keys.clone();
                        let last_tk_differs = tk.len() == 0 or not key_eq(tk[tk.len() - 1], cbe_key);
                        if key_dotted(k) or key_dotted(cbe_key) or last_tk_differs {
                            let idx = if key_dotted(k) and not parsed {
                                c_last_index_before_table(w, c)
                            } else {
                                w.conts[c].body.len()
                            };
                            if idx < w.conts[c].body.len() {
                                c_insert_at(mut w, c, idx, k, it)?;
                            } else {
                                c_raw_append(mut w, c, key.clone(), it)?;
                            }
                            if validate {
                                c_validate_key(mut w, c, k)?;
                            }
                            return Ok(());
                        }
                        let copy = copy_item(mut w, current);
                        let ib = w.conts[w.items[it].cont].body.clone();
                        for e in ib {
                            table_append(mut w, copy, e.key.clone(), true, Val.It(e.item))?;
                        }
                        w.conts[c].body[last_pos] = Ent { key: Some(cbe_key.clone()), item: copy };
                        return Ok(());
                    } else if key_dotted(cbe_key) {
                        return Err(tk_error("Redefinition of an existing table"));
                    }
                } else if not table_is_super(mut w, it)? {
                    return Err(already_present(key_str(k)));
                }
            } else if ik == K_AOT {
                if ck != K_AOT {
                    return Err(already_present(key_str(k)));
                }
                let ts = w.items[it].body.clone();
                for t in ts {
                    let n = w.items[current].body.len();
                    aot_insert(mut w, current, n, Val.It(t))?;
                }
                return Ok(());
            } else {
                return Err(already_present(key_str(k)));
            }
        }
    }
    let is_tab = ik == K_TABLE or ik == K_AOT;
    if key.is_some() and w.conts[c].body.len() > 0 and not w.conts[c].parsed and (not is_tab or key_is_dotted_opt(key)) {
        let last_index = c_last_index_before_table(w, c);
        if last_index < w.conts[c].body.len() {
            return c_insert_at(mut w, c, last_index, key.clone().unwrap(), it);
        }
        let pi = c_last_item(w, c);
        if not (is_ws(w, pi) or ends_with_whitespace(w, pi) or w.items[pi].tv.trail.contains("\n")) {
            w.items[pi].tv.trail.push('\n');
        }
    }
    c_raw_append(mut w, c, key, it)
}

fn c_raw_append(w: mut ref World, c: i64, key: Option[Key], it: i64) -> Result[(), Exc] {
    let n = w.conts[c].body.len();
    if let Some(k) = key {
        let m = map_find_key(w, c, k);
        if m >= 0 {
            let idx = w.conts[c].map[m].idx.clone();
            let current = w.conts[c].body[idx[idx.len() - 1]].item;
            if w.items[current].kind != K_TABLE {
                return Err(already_present(key_str(k)));
            }
            w.conts[c].map[m].idx.push(n);
        } else {
            w.conts[c].map.push(MapEnt { key: k.clone(), idx: vec![n] });
        }
    }
    w.conts[c].body.push(Ent { key: key.clone(), item: it });
    if w.items[it].kind == K_TABLE {
        if let Some(k) = key {
            w.conts[c].table_keys.push(k.clone());
        }
    }
    if let Some(k) = key {
        let s = key_str(k);
        dkeys_add(mut w.conts[c].dkeys, s);
    }
    Ok(())
}

fn c_remove_at(w: mut ref World, c: i64, idx: i64) -> Result[(), Exc] {
    let key = w.conts[c].body[idx].key.clone();
    let k = match key {
        Some(k) => k,
        None => return Err(nonexistent("None".to_string())),
    };
    let m = map_find_key(w, c, k);
    if m < 0 {
        return Err(nonexistent(key_text(k)));
    }
    let nul = mk_null(mut w);
    w.conts[c].body[idx] = Ent { key: None, item: nul };
    let index = w.conts[c].map[m].idx.clone();
    if index.len() > 1 {
        let mut kept: Vec[i64] = Vec.new();
        let mut removed = false;
        for i in index {
            if i == idx and not removed {
                removed = true;
            } else {
                kept.push(i);
            }
        }
        w.conts[c].map[m].idx = kept;
    } else {
        let s = key_str(k);
        dkeys_del(mut w.conts[c].dkeys, s);
        w.conts[c].map.remove(m);
    }
    Ok(())
}

fn c_remove(w: mut ref World, c: i64, key: ref Key) -> Result[(), Exc] {
    let m = map_find_key(w, c, key);
    if m < 0 {
        return Err(nonexistent(key_text(key)));
    }
    let idx = w.conts[c].map[m].idx.clone();
    w.conts[c].map.remove(m);
    for i in idx {
        let nul = mk_null(mut w);
        w.conts[c].body[i] = Ent { key: None, item: nul };
    }
    let s = key_str(key);
    if not dkeys_del(mut w.conts[c].dkeys, s) {
        return Err(exc("KeyError", str_repr(s)));
    }
    Ok(())
}

fn c_insert_at(w: mut ref World, c: i64, idx: i64, key: ref Key, it: i64) -> Result[(), Exc] {
    let n = w.conts[c].body.len();
    if idx > n - 1 {
        return Err(exc("ValueError", f"Unable to insert at position {idx}"));
    }
    if idx > 0 {
        let p = w.conts[c].body[idx - 1].item;
        if not (is_ws(w, p) or ends_with_whitespace(w, p) or is_table_or_aot(w, it) or w.items[p].tv.trail.contains("\n")) {
            w.items[p].tv.trail.push('\n');
        }
    }
    let mut i = 0;
    while i < w.conts[c].map.len() {
        let mut j = 0;
        while j < w.conts[c].map[i].idx.len() {
            if w.conts[c].map[i].idx[j] >= idx {
                w.conts[c].map[i].idx[j] += 1;
            }
            j += 1;
        }
        i += 1;
    }
    let m = map_find_key(w, c, key);
    if m >= 0 {
        w.conts[c].map[m].idx.push(idx);
    } else {
        w.conts[c].map.push(MapEnt { key: key.clone(), idx: vec![idx] });
    }
    w.conts[c].body.insert(idx, Ent { key: Some(key.clone()), item: it });
    let s = key_str(key);
    dkeys_add(mut w.conts[c].dkeys, s);
    Ok(())
}

// Container.__setitem__(key, value) for a str key.
fn c_setitem(w: mut ref World, c: i64, key: ref String, value: own Val) -> Result[(), Exc] {
    let m = map_find(w, c, key);
    if m >= 0 {
        let idx = w.conts[c].map[m].idx.clone();
        return c_replace_at(mut w, c, idx, key_of(key), true, value);
    }
    let it = item_of(mut w, value, -1, false)?;
    c_append(mut w, c, Some(key_of(key)), it, true)
}

fn c_replace(w: mut ref World, c: i64, key: ref Key, new_key: ref Key, value: own Val) -> Result[(), Exc] {
    let m = map_find_key(w, c, key);
    if m < 0 {
        return Err(nonexistent(key_text(key)));
    }
    let idx = w.conts[c].map[m].idx.clone();
    c_replace_at(mut w, c, idx, new_key.clone(), false, value)
}

// _replace_at(idx, new_key, value); new_is_str: new_key stands for a
// str rather than a Key.
fn c_replace_at(w: mut ref World, c: i64, idxs: ref Vec[i64], new_key0: own Key, new_is_str: bool, value0: own Val) -> Result[(), Exc] {
    let value = item_of(mut w, value0, -1, false)?;
    let mut i = 1;
    while i < idxs.len() {
        let nul = mk_null(mut w);
        w.conts[c].body[idxs[i]] = Ent { key: None, item: nul };
        i += 1;
    }
    let mut idx = idxs[0];
    let ent = w.conts[c].body[idx].clone();
    let k = ent.key.unwrap();
    let v = ent.item;
    let tab_new = is_table_or_aot(w, value);
    let tab_old = is_table_or_aot(w, v);
    let mut new_key = new_key0;
    if new_is_str {
        if tab_new != tab_old or key_str(new_key) != key_str(k) {
            // SingleKey(new_key), as given
        } else {
            new_key = k.clone();
        }
    }
    let m = map_find_key(w, c, k);
    if m >= 0 {
        w.conts[c].map.remove(m);
    }
    w.conts[c].map.push(MapEnt { key: new_key.clone(), idx: vec![idx] });
    if not key_eq(new_key, k) {
        let s = key_str(k);
        dkeys_del(mut w.conts[c].dkeys, s);
    }
    if tab_new != tab_old {
        c_remove(mut w, c, k)?;
        let mut found = false;
        let mut j = idx;
        while j < w.conts[c].body.len() {
            if is_table_or_aot(w, w.conts[c].body[j].item) {
                c_insert_at(mut w, c, j, new_key, value)?;
                idx = j;
                found = true;
                break;
            }
            j += 1;
        }
        if not found {
            idx = -1;
            c_append(mut w, c, Some(new_key.clone()), value, true)?;
        }
    } else {
        let vk = w.items[value].kind;
        if vk != K_WS and vk != K_AOT {
            let old = w.items[v].tv.clone();
            let mut tv = w.items[value].tv.clone();
            tv.indent = old.indent.clone();
            if tv.comment_ws.len() == 0 {
                tv.comment_ws = old.comment_ws.clone();
            }
            if tv.comment.len() == 0 {
                tv.comment = old.comment.clone();
            }
            tv.trail = old.trail.clone();
            w.items[value].tv = tv;
        }
        w.conts[c].body[idx] = Ent { key: Some(new_key.clone()), item: value };
    }
    invalidate_display_name(mut w, value)?;
    if w.items[value].kind == K_TABLE {
        let last = c_prev_index(w, c);
        if idx < 0 {
            idx = last;
        }
        let has_ws = ends_with_whitespace(w, value);
        let mut replace_has_ws = false;
        if w.items[v].kind == K_TABLE {
            let vb = w.conts[w.items[v].cont].body.clone();
            if vb.len() > 0 and is_ws(w, vb[vb.len() - 1].item) {
                replace_has_ws = true;
            }
        }
        let next_ws = idx < last and is_ws(w, w.conts[c].body[idx + 1].item);
        if (idx < last or replace_has_ws) and not (next_ws or has_ws) {
            let nl = mk_ws_str(mut w, "\n");
            table_append(mut w, value, None, false, Val.It(nl))?;
        }
        let s = key_str(new_key);
        dkeys_add(mut w.conts[c].dkeys, s);
    }
    Ok(())
}

// ------------------------------------------------------------ rendering

fn c_as_string(w: ref World, c: i64) -> String {
    let mut s = String.new();
    for e in w.conts[c].body {
        match e.key {
            Some(k) => {
                let kind = w.items[e.item].kind;
                if kind == K_TABLE {
                    s.push_str(render_table(w, k, e.item, None));
                } else if kind == K_AOT {
                    s.push_str(render_aot(w, k, e.item, None));
                } else {
                    s.push_str(render_simple(w, Some(k.clone()), e.item, None));
                }
            }
            None => s.push_str(render_simple(w, None, e.item, None)),
        }
    }
    s
}

fn join_prefix(prefix: ref Option[String], k: ref String) -> String {
    match prefix {
        Some(p) => f"{p}.{k}",
        None => k.clone(),
    }
}

fn render_table(w: ref World, key: ref Key, table: i64, prefix: Option[String]) -> String {
    let mut cur = String.new();
    let d = w.items[table].clone();
    let k = match d.display {
        Some(dn) => dn.clone(),
        None => join_prefix(prefix, key_text(key)),
    };
    let body = w.conts[d.cont].body.clone();
    let mut any_plain = false;
    for e in body {
        let vk = w.items[e.item].kind;
        if vk != K_TABLE and vk != K_AOT and vk != K_WS and vk != K_NULL {
            any_plain = true;
        }
    }
    let is_sup = table_is_super_ro(w, table);
    if not is_sup or (any_plain and not key_dotted(key)) {
        let (open, close) = if d.aot_elem { ("[[", "]]") } else { ("[", "]") };
        let nl = if not d.tv.trail.contains("\n") and w.conts[d.cont].dkeys.len() > 0 { "\n" } else { "" };
        cur.push_str(f"{d.tv.indent}{open}{k}{close}{d.tv.comment_ws}{d.tv.comment}{d.tv.trail}{nl}");
    } else if d.tv.indent == "\n" {
        cur.push_str(d.tv.indent);
    }
    for e in body {
        let ek = e.key.clone();
        let vk = w.items[e.item].kind;
        if vk == K_TABLE {
            let kk = ek.unwrap();
            if table_is_super_ro(w, e.item) and key_dotted(kk) and not key_dotted(key) {
                cur.push_str(render_table(w, kk, e.item, None));
            } else {
                cur.push_str(render_table(w, kk, e.item, Some(k.clone())));
            }
        } else if vk == K_AOT {
            cur.push_str(render_aot(w, ek.unwrap(), e.item, Some(k.clone())));
        } else {
            let p = if key_dotted(key) { Some(k.clone()) } else { None };
            cur.push_str(render_simple(w, ek, e.item, p));
        }
    }
    cur
}

fn render_aot(w: ref World, key: ref Key, aot: i64, prefix: Option[String]) -> String {
    let k = join_prefix(prefix, key_text(key));
    let mut cur = String.new();
    for t in w.items[aot].body {
        cur.push_str(render_aot_table(w, t, k));
    }
    cur
}

fn render_aot_table(w: ref World, table: i64, k: ref String) -> String {
    let d = w.items[table].clone();
    let mut cur = f"{d.tv.indent}[[{k}]]{d.tv.comment_ws}{d.tv.comment}{d.tv.trail}";
    let body = w.conts[d.cont].body.clone();
    for e in body {
        let ek = e.key.clone();
        let vk = w.items[e.item].kind;
        if vk == K_TABLE {
            let kk = ek.unwrap();
            if table_is_super_ro(w, e.item) and key_dotted(kk) {
                cur.push_str(render_table(w, kk, e.item, None));
            } else {
                cur.push_str(render_table(w, kk, e.item, Some(k.clone())));
            }
        } else if vk == K_AOT {
            cur.push_str(render_aot(w, ek.unwrap(), e.item, Some(k.clone())));
        } else {
            cur.push_str(render_simple(w, ek, e.item, None));
        }
    }
    cur
}

fn render_simple(w: ref World, key: Option[Key], it: i64, prefix: Option[String]) -> String {
    match key {
        None => as_string(w, it),
        Some(k) => {
            let kk = join_prefix(prefix, key_text(k));
            let d = w.items[it].clone();
            f"{d.tv.indent}{kk}{key_sep(k)}{as_string(w, it)}{d.tv.comment_ws}{d.tv.comment}{d.tv.trail}"
        }
    }
}

// is_super_table() without the lookups that can fail: rendering only
// reaches tables whose keys are all in the map.
fn table_is_super_ro(w: ref World, t: i64) -> bool {
    let sup = w.items[t].sup;
    if sup >= 0 {
        return sup == 1;
    }
    let c = w.items[t].cont;
    if w.conts[c].dkeys.len() == 0 {
        return false;
    }
    for k in w.conts[c].dkeys {
        let m = map_find(w, c, k);
        if m < 0 {
            return false;
        }
        let idx = w.conts[c].map[m].idx.clone();
        if idx.len() > 1 {
            return false;
        }
        let e = w.conts[c].body[idx[0]].clone();
        match e.key {
            None => return false,
            Some(rk) => {
                if not is_table_or_aot(w, e.item) or key_dotted(rk) {
                    return false;
                }
            }
        }
    }
    true
}

// ------------------------------------------------------------ out-of-order tables

fn proxy_validate(w: mut ref World, c: i64, indices: ref Vec[i64]) -> Result[(), Exc] {
    let temp = new_cont(mut w, true);
    for i in indices {
        let it = w.conts[c].body[*i].item;
        if w.items[it].kind == K_TABLE {
            let body = w.conts[w.items[it].cont].body.clone();
            for e in body {
                c_append(mut w, temp, e.key.clone(), e.item, false)?;
            }
        }
    }
    c_validate_ooo(mut w, temp)
}

fn tmap_find(p: ref Proxy, k: ref String) -> i64 {
    let mut i = 0;
    while i < p.tmap.len() {
        if let Some(x) = p.tmap[i].key {
            if key_eq(x, key_of(k)) {
                return i;
            }
        }
        i += 1;
    }
    -1
}

fn tmap_find_opt(p: ref Proxy, k: ref Option[Key]) -> i64 {
    let mut i = 0;
    while i < p.tmap.len() {
        match (p.tmap[i].key.clone(), k) {
            (None, None) => return i,
            (Some(a), Some(b)) => {
                if key_eq(a, b) {
                    return i;
                }
            }
            _ => {}
        }
        i += 1;
    }
    -1
}

fn proxy_new(w: mut ref World, c: i64, indices: ref Vec[i64]) -> Result[i64, Exc] {
    let internal = new_cont(mut w, true);
    let mut p = Proxy { container: c, internal: internal, tables: Vec.new(), tmap: Vec.new(), dkeys: Vec.new() };
    for i in indices {
        let it = w.conts[c].body[*i].item;
        if w.items[it].kind == K_TABLE {
            p.tables.push(it);
            let ti = p.tables.len() - 1;
            let body = w.conts[w.items[it].cont].body.clone();
            for e in body {
                c_raw_append(mut w, internal, e.key.clone(), e.item)?;
                let m = tmap_find_opt(p, e.key);
                if m >= 0 {
                    p.tmap[m].idx.push(ti);
                } else {
                    p.tmap.push(TMEnt { key: e.key.clone(), idx: vec![ti] });
                }
                if let Some(k) = e.key {
                    dkeys_add(mut p.dkeys, key_str(k));
                }
            }
        }
    }
    c_validate_ooo(mut w, internal)?;
    w.proxies.push(p);
    Ok(w.proxies.len() - 1)
}

fn proxy_getitem(w: mut ref World, p: i64, key: ref String) -> Result[Val, Exc] {
    let internal = w.proxies[p].internal;
    if not c_contains(w, internal, key) {
        return Err(nonexistent(key));
    }
    c_getitem(mut w, internal, key_of(key))
}

fn proxy_remove_table(w: mut ref World, p: i64, table: i64) -> Result[(), Exc] {
    let mut i = 0;
    while i < w.proxies[p].tables.len() {
        if w.proxies[p].tables[i] == table {
            w.proxies[p].tables.remove(i);
            break;
        }
        i += 1;
    }
    let c = w.proxies[p].container;
    let mut j = 0;
    while j < w.conts[c].body.len() {
        if w.conts[c].body[j].item == table {
            c_remove_at(mut w, c, j)?;
            break;
        }
        j += 1;
    }
    Ok(())
}

fn proxy_setitem(w: mut ref World, p: i64, key: ref String, item: own Val) -> Result[(), Exc] {
    let m = tmap_find(w.proxies[p], key);
    if m >= 0 {
        while w.proxies[p].tmap[m].idx.len() > 1 {
            let last = w.proxies[p].tmap[m].idx.pop().unwrap();
            let table = w.proxies[p].tables[last];
            proxy_remove_table(mut w, p, table)?;
        }
        let first = w.proxies[p].tmap[m].idx[0];
        let t = w.proxies[p].tables[first];
        table_setitem(mut w, t, key, item.clone())?;
    } else if w.proxies[p].tables.len() > 0 {
        let t = w.proxies[p].tables[0];
        table_setitem(mut w, t, key, item.clone())?;
    } else {
        let c = w.proxies[p].container;
        c_setitem(mut w, c, key, item.clone())?;
    }
    let internal = w.proxies[p].internal;
    c_setitem(mut w, internal, key, item)?;
    dkeys_add(mut w.proxies[p].dkeys, key);
    Ok(())
}

fn proxy_delitem(w: mut ref World, p: i64, key: ref String) -> Result[(), Exc] {
    let m = tmap_find(w.proxies[p], key);
    if m < 0 {
        return Err(nonexistent(key));
    }
    let idx = w.proxies[p].tmap[m].idx.clone();
    let mut i = idx.len() - 1;
    while i >= 0 {
        let table = w.proxies[p].tables[idx[i]];
        table_delitem(mut w, table, key)?;
        if table_len(w, table) == 0 and w.proxies[p].tables.len() > 1 {
            proxy_remove_table(mut w, p, table)?;
        }
        i -= 1;
    }
    w.proxies[p].tmap.remove(m);
    let internal = w.proxies[p].internal;
    c_remove(mut w, internal, key_of(key))?;
    dkeys_del(mut w.proxies[p].dkeys, key);
    Ok(())
}

// AbstractTable.__delitem__ / remove(key) for a str key.
fn table_delitem(w: mut ref World, t: i64, key: ref String) -> Result[(), Exc] {
    let c = w.items[t].cont;
    c_remove(mut w, c, key_of(key))
}
// ------------------------------------------------------------ the parser

// The Source: code points, the index and the marker. The current
// character is the one at idx, NUL past the end.
struct P {
    s: Vec[i64],
    idx: i64,
    marker: i64,
    aot_stack: Vec[Key],
}

fn new_parser(text: ref String) -> P {
    P { s: cps(text), idx: 0, marker: 0, aot_stack: Vec.new() }
}

fn cur(p: ref P) -> i64 {
    if p.idx < p.s.len() { p.s[p.idx] } else { 0 }
}

fn at_end(p: ref P) -> bool {
    p.idx >= p.s.len()
}

fn inc(p: mut ref P) -> bool {
    if p.idx + 1 < p.s.len() {
        p.idx += 1;
        true
    } else {
        p.idx = p.s.len();
        false
    }
}

fn inc_eof(p: mut ref P) -> Result[(), Exc] {
    if not inc(mut p) {
        return Err(perr(p, "UnexpectedEofError", "Unexpected end of file"));
    }
    Ok(())
}

fn inc_n(p: mut ref P, n: i64) -> bool {
    let mut i = 0;
    while i < n {
        if not inc(mut p) {
            return false;
        }
        i += 1;
    }
    true
}

fn mark(p: mut ref P) {
    p.marker = p.idx;
}

fn extract(p: ref P) -> String {
    cps_text(p.s, p.marker, p.idx)
}

fn is_spaces(c: i64) -> bool {
    c == 32 or c == 9
}

fn is_nl(c: i64) -> bool {
    c == 10 or c == 13
}

fn is_tws(c: i64) -> bool {
    is_spaces(c) or is_nl(c)
}

fn is_bare_char(c: i64) -> bool {
    is_ascii_alpha(c) or is_ascii_digit(c) or c == 45 or c == 95
}

// consume(chars, min=0): skip the run of chars.
fn consume(p: mut ref P, chars: Str) {
    while in_set(cur(p), chars) {
        if not inc(mut p) {
            break;
        }
    }
}

fn linecol(p: ref P) -> (i64, i64) {
    let lines = splitline_lengths(p.s);
    let mut c = 0;
    let mut i = 0;
    while i < lines.len() {
        if c + lines[i] + 1 > p.idx {
            return (i + 1, p.idx - c);
        }
        c += lines[i] + 1;
        i += 1;
    }
    (lines.len(), 0)
}

fn perr(p: ref P, kind: Str, msg: Str) -> Exc {
    perr_s(p, kind, msg.to_string())
}

fn perr_s(p: ref P, kind: Str, msg: own String) -> Exc {
    let (l, c) = linecol(p);
    exc(kind, f"{msg} at line {l} col {c}")
}

fn char_repr(c: i64) -> String {
    str_repr(cp_char(c).to_string())
}

fn unexpected(p: ref P, c: i64) -> Exc {
    perr_s(p, "UnexpectedCharError", f"Unexpected character: {char_repr(c)}")
}

fn unexpected_s(p: ref P, s: ref String) -> Exc {
    perr_s(p, "UnexpectedCharError", f"Unexpected character: {str_repr(s)}")
}

fn bad_char_in_string(p: ref P, c: i64) -> Exc {
    perr_s(p, "InvalidCharInStringError", f"Invalid character {char_repr(c)} in string")
}

fn control_char(p: ref P, code: i64, what: Str) -> Exc {
    let mut d = "\\u00".to_string();
    if code < 16 {
        d.push('0');
    }
    d.push_str(if code < 16 { hex_n(code, 1) } else { hex_n(code, 2) });
    perr_s(p, "InvalidControlChar", f"Control characters (codes less than 0x1f and 0x7f) are not allowed in {what}, use {d} instead")
}

fn internal(p: ref P, msg: Str) -> Exc {
    perr_s(p, "InternalParserError", f"Internal parser error ({msg})")
}

// Wraps an error from Container.append as parse() does.
fn wrap_append(p: ref P, e: own Exc) -> Exc {
    perr_s(p, "ParseError", e.msg)
}

// ---------------------------------------------------------------- parse()

fn parse_doc(w: mut ref World, text: ref String) -> Result[i64, Exc] {
    let mut p = new_parser(text);
    parse_body(mut w, mut p)
}

fn parse_body(w: mut ref World, p: mut ref P) -> Result[i64, Exc] {
    let body = new_cont(mut w, true);
    while not at_end(p) {
        if cur(p) == 91 {
            break;
        }
        let item = parse_item(mut w, mut p)?;
        let (key, value) = match item {
            Some(x) => x,
            None => break,
        };
        let multi = match key {
            Some(ref k) => key_multi(k),
            None => false,
        };
        if multi or not merge_ws(mut w, p, value, body) {
            match c_append(mut w, body, key, value, true) {
                Ok(_) => {}
                Err(e) => return Err(wrap_append(p, e)),
            }
        }
        mark(mut p);
    }
    while not at_end(p) {
        let (key, value0) = parse_table(mut w, mut p, None)?;
        let mut value = value0;
        if w.items[value].kind == K_TABLE and w.items[value].aot_elem {
            value = parse_aot(mut w, mut p, value, key)?;
        }
        match c_append(mut w, body, Some(key), value, true) {
            Ok(_) => {}
            Err(e) => return Err(wrap_append(p, e)),
        }
    }
    c_parsing(mut w, body, false);
    Ok(body)
}

fn merge_ws(w: mut ref World, p: ref P, item: i64, c: i64) -> bool {
    let last = c_last_item(w, c);
    if last < 0 {
        return false;
    }
    if not is_ws(w, item) or not is_ws(w, last) {
        return false;
    }
    let start = p.idx - (char_len(w.items[last].s) + char_len(w.items[item].s));
    let text = cps_text(p.s, start, p.idx);
    let ws = mk_ws(mut w, text, false);
    let n = w.conts[c].body.len();
    w.conts[c].body[n - 1].item = ws;
    true
}

fn is_child(parent: ref Key, child: ref Key) -> bool {
    let a = parent.parts.len();
    let b = child.parts.len();
    if a > b {
        return false;
    }
    let mut i = 0;
    while i < a {
        if parent.parts[i].key != child.parts[i].key {
            return false;
        }
        i += 1;
    }
    a != b
}

fn parse_item(w: mut ref World, p: mut ref P) -> Result[Option[(Option[Key], i64)], Exc] {
    mark(mut p);
    let saved = p.idx;
    loop {
        let c = cur(p);
        if c == 10 {
            inc(mut p);
            let ws = mk_ws(mut w, extract(p), false);
            return Ok(Some((None, ws)));
        } else if c == 32 or c == 9 or c == 13 {
            if not inc(mut p) {
                let ws = mk_ws(mut w, extract(p), false);
                return Ok(Some((None, ws)));
            }
        } else if c == 35 {
            let indent = extract(p);
            let (cws, comment, trail) = parse_comment_trail(mut p, true)?;
            let cm = mk_comment(mut w, trivia4(indent, cws, comment, trail));
            return Ok(Some((None, cm)));
        } else if c == 91 {
            return Ok(None);
        } else {
            p.idx = saved;
            break;
        }
    }
    let (k, v) = parse_key_value(mut w, mut p, true)?;
    Ok(Some((Some(k), v)))
}

fn parse_comment_trail(p: mut ref P, parse_trail: bool) -> Result[(String, String, String), Exc] {
    if at_end(p) {
        return Ok((String.new(), String.new(), String.new()));
    }
    let mut comment = String.new();
    let mut cws = String.new();
    mark(mut p);
    loop {
        let c = cur(p);
        if c == 10 {
            break;
        } else if c == 35 {
            cws = extract(p);
            mark(mut p);
            inc(mut p);
            while not at_end(p) and not is_nl(cur(p)) {
                let code = cur(p);
                if code == 0x7F or (code <= 0x1F and code != 9) {
                    return Err(control_char(p, code, "comments"));
                }
                if not inc(mut p) {
                    break;
                }
            }
            comment = extract(p);
            mark(mut p);
            break;
        } else if c == 32 or c == 9 or c == 13 {
            inc(mut p);
        } else {
            return Err(unexpected(p, c));
        }
        if at_end(p) {
            break;
        }
    }
    let mut trail = String.new();
    if parse_trail {
        while is_spaces(cur(p)) and inc(mut p) {}
        if cur(p) == 13 {
            inc(mut p);
        }
        if cur(p) == 10 {
            inc(mut p);
        }
        if p.idx != p.marker or is_tws(cur(p)) {
            trail = extract(p);
        }
    }
    Ok((cws, comment, trail))
}

fn parse_key_value(w: mut ref World, p: mut ref P, parse_comment: bool) -> Result[(Key, i64), Exc] {
    mark(mut p);
    while is_spaces(cur(p)) and inc(mut p) {}
    let indent = extract(p);
    let mut key = parse_key(mut w, mut p)?;
    mark(mut p);
    let mut found_equals = cur(p) == 61;
    while (cur(p) == 61 or is_spaces(cur(p))) and inc(mut p) {
        if cur(p) == 61 {
            if found_equals {
                return Err(unexpected(p, 61));
            }
            found_equals = true;
        }
    }
    if not found_equals {
        return Err(unexpected(p, cur(p)));
    }
    let sep = key_sep(key);
    if sep.len() == 0 {
        set_key_sep(mut key, extract(p));
    } else {
        set_key_sep(mut key, f"{sep}{extract(p)}");
    }
    let val = parse_value(mut w, mut p)?;
    if parse_comment {
        let (cws, comment, trail) = parse_comment_trail(mut p, true)?;
        if w.items[val].tv.comment_ws.len() == 0 {
            w.items[val].tv.comment_ws = cws;
        }
        w.items[val].tv.comment = comment;
        w.items[val].tv.trail = trail;
    } else {
        w.items[val].tv.trail = String.new();
    }
    w.items[val].tv.indent = indent;
    Ok((key, val))
}

fn parse_key(w: mut ref World, p: mut ref P) -> Result[Key, Exc] {
    mark(mut p);
    while is_spaces(cur(p)) and inc(mut p) {}
    let c = cur(p);
    if c == 34 or c == 39 {
        parse_quoted_key(mut w, mut p)
    } else {
        parse_bare_key(mut w, mut p)
    }
}

fn parse_quoted_key(w: mut ref World, p: mut ref P) -> Result[Key, Exc] {
    let mut original = extract(p);
    let kt = if cur(p) == 34 { 1 } else { 2 };
    let ks = parse_string(mut w, mut p, if kt == 1 { 0 } else { 2 })?;
    let st = w.items[ks].st;
    if st_multiline(st) {
        return Err(unexpected_s(p, st_value(st).to_string()));
    }
    original.push_str(as_string(w, ks));
    mark(mut p);
    while is_spaces(cur(p)) and inc(mut p) {}
    original.push_str(extract(p));
    let mut key = single(skey(w.items[ks].s, kt, Some(String.new()), Some(original)));
    if cur(p) == 46 {
        inc(mut p);
        let rest = parse_key(mut w, mut p)?;
        key = key_concat(key, rest);
    }
    Ok(key)
}

fn parse_bare_key(w: mut ref World, p: mut ref P) -> Result[Key, Exc] {
    while (is_bare_char(cur(p)) or is_spaces(cur(p))) and inc(mut p) {}
    let original = extract(p);
    let k = strip_ws(original);
    if k.len() == 0 {
        return Err(perr(p, "EmptyKeyError", "Empty key"));
    }
    if k.contains(" ") {
        return Err(perr_s(p, "ParseError", f"Invalid key \"{k}\""));
    }
    let mut key = single(skey(k, 0, Some(String.new()), Some(original)));
    if cur(p) == 46 {
        inc(mut p);
        let rest = parse_key(mut w, mut p)?;
        key = key_concat(key, rest);
    }
    Ok(key)
}

fn peek(p: mut ref P, n: i64) -> String {
    let saved = p.idx;
    let mut buf = String.new();
    let mut i = 0;
    while i < n {
        let c = cur(p);
        if in_set(c, " \t\n\r#,]}") or c == 0 {
            break;
        }
        buf.push(cp_char(c));
        inc(mut p);
        i += 1;
    }
    p.idx = saved;
    buf
}

fn scan_value(p: mut ref P, stops: Str) {
    while not in_set(cur(p), stops) and inc(mut p) {}
}

fn parse_value(w: mut ref World, p: mut ref P) -> Result[i64, Exc] {
    mark(mut p);
    let c = cur(p);
    if c == 34 {
        return parse_string_restoring(mut w, mut p, 0);
    }
    if c == 39 {
        return parse_string_restoring(mut w, mut p, 2);
    }
    if c == 116 {
        return parse_bool(mut w, mut p, true);
    }
    if c == 102 {
        return parse_bool(mut w, mut p, false);
    }
    if c == 91 {
        return parse_array(mut w, mut p);
    }
    if c == 123 {
        return parse_inline_table(mut w, mut p);
    }
    let pk = peek(mut p, 4);
    if c == 43 or c == 45 or pk == "+inf" or pk == "-inf" or pk == "inf" or pk == "+nan" or pk == "-nan" or pk == "nan" {
        scan_value(mut p, " \t\n\r#,]}");
        let raw = extract(p);
        return match parse_number(mut w, raw, trivia()) {
            Some(it) => Ok(it),
            None => Err(perr(p, "InvalidNumberError", "Invalid number")),
        };
    }
    if is_ascii_digit(c) {
        scan_value(mut p, " \t\n\r#,]}");
        let raw = extract(p);
        if let Some(m) = match_loose(cps(raw)) {
            if m.date and m.time {
                return match parse_rfc3339(raw) {
                    Ok(r) => Ok(mk_dt(mut w, K_DATETIME, r.dt, trivia(), raw)),
                    Err(_) => Err(perr(p, "InvalidDateTimeError", "Invalid datetime")),
                };
            }
            if m.date {
                let r = match parse_rfc3339(raw) {
                    Ok(r) => r,
                    Err(_) => return Err(perr(p, "InvalidDateError", "Invalid date")),
                };
                mark(mut p);
                scan_value(mut p, "\t\n\r#,]}");
                let time_raw = extract(p);
                let time_part = rstrip_ws(time_raw);
                let mut tv = trivia();
                tv.comment_ws = cps_text(cps(time_raw), char_len(time_part), char_len(time_raw));
                if time_part.len() == 0 {
                    return Ok(mk_dt(mut w, K_DATE, r.dt, tv, raw));
                }
                let full = f"{raw}{time_part}";
                return match parse_rfc3339(full) {
                    Ok(r2) => {
                        if r2.kind != 0 {
                            return Err(exc("AssertionError", String.new()));
                        }
                        Ok(mk_dt(mut w, K_DATETIME, r2.dt, tv, full))
                    }
                    Err(_) => Err(perr(p, "InvalidDateError", "Invalid date")),
                };
            }
            if m.time {
                return match parse_rfc3339(raw) {
                    Ok(r) => Ok(mk_dt(mut w, K_TIME, r.dt, trivia(), raw)),
                    Err(_) => Err(perr(p, "InvalidTimeError", "Invalid time")),
                };
            }
        }
        return match parse_number(mut w, raw, trivia()) {
            Some(it) => Ok(it),
            None => Err(perr(p, "InvalidNumberError", "Invalid number")),
        };
    }
    Err(unexpected(p, c))
}

fn parse_bool(w: mut ref World, p: mut ref P, value: bool) -> Result[i64, Exc] {
    let saved = p.idx;
    let word = if value { "true" } else { "false" };
    for b in word.bytes() {
        if cur(p) == (b as i64) {
            inc(mut p);
        } else {
            let e = unexpected(p, cur(p));
            p.idx = saved;
            return Err(e);
        }
    }
    Ok(mk_bool(mut w, value, trivia()))
}

fn parse_array(w: mut ref World, p: mut ref P) -> Result[i64, Exc] {
    inc_eof(mut p)?;
    let mut elems: Vec[i64] = Vec.new();
    let mut prev_value = false;
    loop {
        let start = p.idx;
        consume(mut p, " \t\n\r");
        let indent = cps_text(p.s, start, p.idx);
        if indent.contains("\n") or indent.contains("\r") {
            elems.push(mk_ws(mut w, indent, false));
            continue;
        }
        if cur(p) == 35 {
            let (cws, comment, trail) = parse_comment_trail(mut p, false)?;
            elems.push(mk_comment(mut w, trivia4(indent, cws, comment, trail)));
            continue;
        }
        if indent.len() > 0 {
            elems.push(mk_ws(mut w, indent, false));
            continue;
        }
        if not prev_value {
            match parse_value(mut w, mut p) {
                Ok(v) => {
                    elems.push(v);
                    prev_value = true;
                    continue;
                }
                Err(e) => {
                    if e.kind != "UnexpectedCharError" {
                        return Err(e);
                    }
                }
            }
        }
        if prev_value and cur(p) == 44 {
            inc_eof(mut p)?;
            elems.push(mk_ws_str(mut w, ","));
            prev_value = false;
            continue;
        }
        if cur(p) == 93 {
            inc(mut p);
            break;
        }
        return Err(unexpected(p, cur(p)));
    }
    Ok(mk_array(mut w, elems, trivia()))
}

fn parse_inline_table(w: mut ref World, p: mut ref P) -> Result[i64, Exc] {
    inc_eof(mut p)?;
    let elems = new_cont(mut w, true);
    // None (-1): empty so far; 0: no comma after the last pair; 1: a comma.
    let mut trailing = -1;
    loop {
        let start = p.idx;
        consume(mut p, " \t");
        let raw = cps_text(p.s, start, p.idx);
        if raw.len() > 0 {
            let ws = mk_ws(mut w, raw, false);
            c_append(mut w, elems, None, ws, true)?;
        }
        if trailing != 1 {
            if cur(p) == 125 {
                inc(mut p);
                break;
            }
            if trailing == 0 or (trailing == -1 and cur(p) == 44) {
                return Err(unexpected(p, cur(p)));
            }
        } else if cur(p) == 125 or cur(p) == 44 {
            return Err(unexpected(p, cur(p)));
        }
        let (key, val) = parse_key_value(mut w, mut p, false)?;
        c_append(mut w, elems, Some(key), val, true)?;
        let start2 = p.idx;
        consume(mut p, " \t");
        let raw2 = cps_text(p.s, start2, p.idx);
        if raw2.len() > 0 {
            let ws = mk_ws(mut w, raw2, false);
            c_append(mut w, elems, None, ws, true)?;
        }
        trailing = if cur(p) == 44 { 1 } else { 0 };
        if trailing == 1 {
            inc_eof(mut p)?;
        }
    }
    Ok(mk_inline(mut w, elems, trivia(), false))
}

fn starts_any(s: ref String, ps: ref Vec[Str]) -> bool {
    for x in ps {
        if s.starts_with(*x) {
            return true;
        }
    }
    false
}

// The digit class of _parse_number, case-insensitively.
fn is_base_digit(c: i64, base: i64) -> bool {
    if base == 2 {
        c == 48 or c == 49
    } else if base == 8 {
        c >= 48 and c <= 55
    } else if base == 16 {
        is_ascii_digit(c) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)
    } else {
        is_ascii_digit(c)
    }
}

fn parse_number(w: mut ref World, raw0: ref String, tv: own Trivia) -> Option[i64] {
    let mut sign = String.new();
    let mut raw = raw0.clone();
    if raw.starts_with("+") or raw.starts_with("-") {
        let v = cps(raw);
        sign = cp_char(v[0]).to_string();
        raw = cps_text(v, 1, v.len());
    }
    let rlen = char_len(raw);
    if rlen > 1 and ((raw.starts_with("0") and not starts_any(raw, vec!["0.", "0o", "0x", "0b", "0e"])) or (sign.len() > 0 and raw.starts_with("."))) {
        return None;
    }
    if starts_any(raw, vec!["0o", "0x", "0b"]) and sign.len() > 0 {
        return None;
    }
    let base = if raw.starts_with("0b") { 2 } else if raw.starts_with("0o") { 8 } else if raw.starts_with("0x") { 16 } else { 10 };
    // Drop the underscores that sit between two digits.
    let v = cps(raw);
    let mut kept = String.new();
    let mut i = 0;
    while i < v.len() {
        let c = v[i];
        if c == 95 and i > 0 and i + 1 < v.len() and is_base_digit(v[i - 1], base) and is_base_digit(v[i + 1], base) {
            i += 1;
            continue;
        }
        kept.push(cp_char(c));
        i += 1;
    }
    let clean = lower_ascii(kept);
    if clean.contains("_") {
        return None;
    }
    let mantissa = match clean.find("e") {
        Some(at) => cps_text(cps(clean), 0, at),
        None => clean.clone(),
    };
    if clean.ends_with(".") or (not clean.starts_with("0x") and mantissa.ends_with(".")) {
        return None;
    }
    let full = f"{sign}{clean}";
    let shown = f"{sign}{raw}";
    if let Some(n) = py_int(full, base) {
        return Some(mk_int(mut w, n, tv, shown));
    }
    if let Some(x) = py_float(full) {
        return Some(mk_float(mut w, x, tv, shown));
    }
    None
}

fn parse_string_restoring(w: mut ref World, p: mut ref P, t: i64) -> Result[i64, Exc] {
    let saved = p.idx;
    match parse_string(mut w, mut p, t) {
        Ok(s) => Ok(s),
        Err(e) => {
            p.idx = saved;
            Err(e)
        }
    }
}

fn escaped_char(c: i64) -> i64 {
    if c == 98 {
        8
    } else if c == 116 {
        9
    } else if c == 110 {
        10
    } else if c == 102 {
        12
    } else if c == 114 {
        13
    } else if c == 34 {
        34
    } else if c == 92 {
        92
    } else {
        -1
    }
}

fn parse_escaped_char(p: mut ref P, multiline: bool) -> Result[String, Exc] {
    if multiline and is_tws(cur(p)) {
        let mut tmp = String.new();
        while is_tws(cur(p)) {
            tmp.push(cp_char(cur(p)));
            inc_eof(mut p)?;
        }
        if not tmp.contains("\n") {
            return Err(bad_char_in_string(p, cur(p)));
        }
        return Ok(String.new());
    }
    let e = escaped_char(cur(p));
    if e >= 0 {
        inc_eof(mut p)?;
        return Ok(cp_char(e).to_string());
    }
    let c = cur(p);
    if c == 117 or c == 85 {
        let (u, n) = peek_unicode(mut p, c == 85);
        if let Some(ch) = u {
            inc_n(mut p, n + 1);
            return Ok(ch);
        }
        return Err(perr(p, "InvalidUnicodeValueError", "Invalid unicode value"));
    }
    Err(bad_char_in_string(p, c))
}

// _peek_unicode: the character and how many hex digits it took.
fn peek_unicode(p: mut ref P, is_long: bool) -> (Option[String], i64) {
    let saved = p.idx;
    let saved_marker = p.marker;
    inc(mut p);
    mark(mut p);
    let n = if is_long { 8 } else { 4 };
    let mut out: Option[String] = None;
    if inc_n(mut p, n) {
        let ex = extract(p);
        let v = cps(ex);
        let surrogate = (v[0] == 100 or v[0] == 68) and not (v[1] >= 48 and v[1] <= 55);
        if not surrogate {
            if let Some(code) = py_int(ex, 16) {
                if code >= 0 and code <= 0x10FFFF and not (code >= 0xD800 and code <= 0xDFFF) {
                    out = Some(cp_char(code).to_string());
                }
            }
        }
    }
    p.idx = saved;
    p.marker = saved_marker;
    (out, n)
}

fn parse_string(w: mut ref World, p: mut ref P, delim0: i64) -> Result[i64, Exc] {
    let mut delim = delim0;
    let unit = st_unit(delim);
    if cur(p) != unit {
        return Err(perr_s(p, "InternalParserError", f"Internal parser error (Invalid character for string type {st_name(delim)})"));
    }
    inc_eof(mut p)?;
    if cur(p) == unit {
        if not inc(mut p) or cur(p) != unit {
            return Ok(mk_string(mut w, delim, String.new(), String.new(), trivia()));
        }
        inc_eof(mut p)?;
        delim = st_toggle(delim);
    }
    mark(mut p);
    let mut value = String.new();
    let ml = st_multiline(delim);
    if ml {
        if cur(p) == 10 {
            inc_eof(mut p)?;
        } else if cur(p) == 13 {
            let saved = p.idx;
            let crlf = inc(mut p) and cur(p) == 10;
            p.idx = saved;
            if crlf {
                if not inc_n(mut p, 2) {
                    return Err(perr(p, "UnexpectedEofError", "Unexpected end of file"));
                }
            }
        }
    }
    let mut escaped = false;
    loop {
        let code = cur(p);
        let bad = if not ml {
            code == 0x7F or (code <= 0x1F and code != 9)
        } else {
            code == 0x7F or (code <= 0x1F and code != 9 and code != 10 and code != 13)
        };
        if not escaped and bad {
            return Err(control_char(p, code, "strings"));
        } else if not escaped and code == unit {
            let mut original = extract(p);
            if ml {
                let mut close = String.new();
                while cur(p) == unit {
                    close.push(cp_char(unit));
                    inc(mut p);
                }
                let n = char_len(close);
                if n < 3 {
                    value.push_str(close);
                    continue;
                }
                if n == 3 {
                    return Ok(mk_string(mut w, delim, value, original, trivia()));
                }
                if n >= 6 {
                    return Err(bad_char_in_string(p, cur(p)));
                }
                let extra = cps_text(cps(close), 0, n - 3);
                value.push_str(extra);
                original.push_str(extra);
                return Ok(mk_string(mut w, delim, value, original, trivia()));
            }
            inc(mut p);
            return Ok(mk_string(mut w, delim, value, original, trivia()));
        } else if st_basic(delim) and escaped {
            let e = parse_escaped_char(mut p, ml)?;
            value.push_str(e);
            escaped = false;
        } else if st_basic(delim) and code == 92 {
            escaped = true;
            inc_eof(mut p)?;
        } else {
            value.push(cp_char(code));
            inc_eof(mut p)?;
        }
    }
}

fn parse_table(w: mut ref World, p: mut ref P, parent_name: Option[Key]) -> Result[(Key, i64), Exc] {
    if cur(p) != 91 {
        return Err(internal(p, "_parse_table() called on non-bracket character."));
    }
    let indent = extract(p);
    inc(mut p);
    if at_end(p) {
        return Err(perr(p, "UnexpectedEofError", "Unexpected end of file"));
    }
    let mut is_aot = false;
    if cur(p) == 91 {
        if not inc(mut p) {
            return Err(perr(p, "UnexpectedEofError", "Unexpected end of file"));
        }
        is_aot = true;
    }
    let mut key = match parse_key(mut w, mut p) {
        Ok(k) => k,
        Err(e) => {
            if e.kind == "EmptyKeyError" {
                return Err(perr(p, "EmptyTableNameError", "Empty table name"));
            }
            return Err(e);
        }
    };
    if at_end(p) {
        return Err(perr(p, "UnexpectedEofError", "Unexpected end of file"));
    } else if cur(p) != 93 {
        return Err(unexpected(p, cur(p)));
    }
    set_key_sep(mut key, String.new());
    let full_key = key.clone();
    let all_parts = key.parts.clone();
    for part in all_parts {
        if strip_ws(part.key).contains(" ") and part.t == 0 {
            return Err(perr_s(p, "ParseError", f"Invalid table name \"{key_text(full_key)}\""));
        }
    }
    let parent_n = match parent_name {
        Some(pn) => pn.parts.len(),
        None => 0,
    };
    let missing_table = all_parts.len() > parent_n + 1;
    let mut name_parts: Vec[SKey] = Vec.new();
    let mut i = parent_n;
    while i < all_parts.len() {
        name_parts.push(all_parts[i].clone());
        i += 1;
    }
    inc(mut p);
    if is_aot {
        inc(mut p);
    }
    let (cws, comment, trail) = parse_comment_trail(mut p, true)?;
    let mut result = -1;
    let tname = if name_parts.len() > 0 { name_parts[0].key.clone() } else { key_str(key) };
    let mut table = mk_table(mut w, true, trivia4(indent, cws, comment, trail), is_aot, 0, Some(tname), Some(key_text(full_key)));
    let np = name_parts.len();
    if np > 1 {
        if missing_table {
            let mut in_stack = false;
            for s in p.aot_stack {
                if key_eq(s, single(name_parts[0].clone())) {
                    in_stack = true;
                }
            }
            table = mk_table(mut w, true, trivia4("", cws, comment, trail), is_aot and in_stack, 1, Some(name_parts[0].key.clone()), None);
        }
        result = table;
        key = single(name_parts[0].clone());
        let mut j = 0;
        while j < np - 1 {
            let nm = name_parts[j + 1].clone();
            let last = j == np - 2;
            let display = if last { Some(key_text(full_key)) } else { None };
            let sup = if j < np - 2 { 1 } else { 0 };
            let child = mk_table(mut w, true, trivia4(indent, cws, comment, trail), is_aot and last, sup, Some(nm.key.clone()), display);
            if is_aot and last {
                let tn = w.items[table].name.clone();
                let a = aot_new(mut w, vec![child], tn, true)?;
                table_raw_append(mut w, table, Some(single(nm)), a)?;
            } else {
                table_raw_append(mut w, table, Some(single(nm)), child)?;
            }
            table = child;
            j += 1;
        }
    } else if np > 0 {
        key = single(name_parts[0].clone());
    }
    while not at_end(p) {
        let item = parse_item(mut w, mut p)?;
        match item {
            Some((k, it)) => {
                let values = w.items[table].cont;
                if not merge_ws(mut w, p, it, values) {
                    table_raw_append(mut w, table, k, it)?;
                }
            }
            None => {
                if cur(p) == 91 {
                    let (_, key_next) = peek_table(mut w, mut p)?;
                    if is_child(full_key, key_next) {
                        let (kn, tn) = parse_table(mut w, mut p, Some(full_key.clone()))?;
                        table_raw_append(mut w, table, Some(kn), tn)?;
                        while not at_end(p) {
                            let (_, key_next2) = peek_table(mut w, mut p)?;
                            if not is_child(full_key, key_next2) {
                                break;
                            }
                            let (kn2, tn2) = parse_table(mut w, mut p, Some(full_key.clone()))?;
                            table_raw_append(mut w, table, Some(kn2), tn2)?;
                        }
                    }
                    break;
                }
                return Err(internal(p, "_parse_item() returned None on a non-bracket character."));
            }
        }
    }
    let tc = w.items[table].cont;
    c_validate_ooo(mut w, tc)?;
    if result < 0 {
        result = table;
        let top_differs = match p.aot_stack.last() {
            Some(top) => not key_eq(full_key, top),
            None => true,
        };
        if is_aot and top_differs {
            result = parse_aot(mut w, mut p, result, full_key)?;
        }
    }
    Ok((key, result))
}

fn peek_table(w: mut ref World, p: mut ref P) -> Result[(bool, Key), Exc] {
    let saved = p.idx;
    let saved_marker = p.marker;
    if cur(p) != 91 {
        return Err(internal(p, "_peek_table() entered on non-bracket character"));
    }
    inc(mut p);
    let mut is_aot = false;
    if cur(p) == 91 {
        inc(mut p);
        is_aot = true;
    }
    let r = match parse_key(mut w, mut p) {
        Ok(k) => Ok((is_aot, k)),
        Err(e) => {
            if e.kind == "EmptyKeyError" {
                Err(perr(p, "EmptyTableNameError", "Empty table name"))
            } else {
                Err(e)
            }
        }
    };
    p.idx = saved;
    p.marker = saved_marker;
    r
}

fn parse_aot(w: mut ref World, p: mut ref P, first: i64, name_first: ref Key) -> Result[i64, Exc] {
    let mut payload = vec![first];
    p.aot_stack.push(name_first.clone());
    while not at_end(p) {
        let (is_aot_next, name_next) = peek_table(mut w, mut p)?;
        if is_aot_next and key_eq(name_next, name_first) {
            let (_, t) = parse_table(mut w, mut p, Some(name_first.clone()))?;
            payload.push(t);
        } else {
            break;
        }
    }
    p.aot_stack.pop();
    aot_new(mut w, payload, None, true)
}

// tomlkit.value(raw) and tomlkit.key_value(src).
fn api_value(w: mut ref World, raw: ref String) -> Result[i64, Exc] {
    let mut p = new_parser(raw);
    let v = parse_value(mut w, mut p)?;
    if not at_end(p) {
        return Err(unexpected(p, cur(p)));
    }
    Ok(v)
}

fn api_key_value(w: mut ref World, src: ref String) -> Result[(Key, i64), Exc] {
    let mut p = new_parser(src);
    parse_key_value(mut w, mut p, false)
}
// ------------------------------------------------------------ the job runner

struct Binding {
    name: String,
    val: Val,
}

// A TOMLFile: where it is and the line ending it found.
struct TFile {
    name: String,
    path: String,
    linesep: String,
}

struct Env {
    vars: Vec[Binding],
    files: Vec[TFile],
}

fn env_get(env: ref Env, name: ref String) -> Result[Val, Exc] {
    for b in env.vars {
        if b.name == *name {
            return Ok(b.val.clone());
        }
    }
    Err(exc("KeyError", str_repr(name)))
}

fn env_set(env: mut ref Env, name: ref String, v: own Val) {
    let mut i = 0;
    while i < env.vars.len() {
        if env.vars[i].name == *name {
            env.vars[i].val = v;
            return;
        }
        i += 1;
    }
    env.vars.push(Binding { name: name.clone(), val: v });
}

fn new_world() -> World {
    World { items: Vec.new(), conts: Vec.new(), proxies: Vec.new() }
}

// ---------------------------------------------------------------- JSON access

fn j_member(v: ref J, k: Str) -> Option[J] {
    if let J.Obj(ms) = v {
        for m in ms {
            if m.key == k {
                return Some(m.val.clone());
            }
        }
    }
    None
}

fn j_items(v: ref J) -> Vec[J] {
    match v {
        J.Arr(xs) => xs.clone(),
        _ => Vec.new(),
    }
}

fn j_str(v: ref J) -> String {
    match v {
        J.Str(s) => s.clone(),
        _ => String.new(),
    }
}

fn j_int(v: ref J) -> i64 {
    match v {
        J.Int(s) => match py_int(s, 10) {
            Some(n) => n,
            None => 0,
        },
        _ => 0,
    }
}

fn j_bool(v: ref J) -> bool {
    match v {
        J.Bool(b) => b,
        _ => false,
    }
}

// The one key of a {"$...": ...} object.
fn j_tag(v: ref J) -> Option[(String, J)] {
    if let J.Obj(ms) = v {
        if ms.len() == 1 and ms[0].key.starts_with("$") {
            return Some((ms[0].key.clone(), ms[0].val.clone()));
        }
    }
    None
}

// ---------------------------------------------------------------- values

fn py_of(v: own Val) -> Result[PyV, Exc] {
    match v {
        Val.Py(p) => Ok(p),
        _ => Err(exc("TypeError", "a job nests a TOML object in plain data".to_string())),
    }
}

fn ev(w: mut ref World, env: ref Env, x: ref J) -> Result[Val, Exc] {
    if let Some((tag, v)) = j_tag(x) {
        if tag == "$v" {
            return env_get(env, j_str(v));
        }
        if tag == "$f" {
            return match py_float(j_str(v)) {
                Some(f) => Ok(Val.Py(PyV.Float(f))),
                None => Err(exc("ValueError", f"could not convert string to float: {str_repr(j_str(v))}")),
            };
        }
        if tag == "$dt" or tag == "$date" or tag == "$time" {
            let r = parse_rfc3339(j_str(v))?;
            return Ok(Val.Py(rfc_py(r)));
        }
        if tag == "$call" {
            let xs = j_items(v);
            let name = j_str(xs[0]);
            let mut args: Vec[J] = Vec.new();
            let mut i = 1;
            while i < xs.len() {
                args.push(xs[i].clone());
                i += 1;
            }
            return call(mut w, env, name, args);
        }
        if tag == "$key" {
            return Ok(Val.Ky(api_key(v)));
        }
    }
    match x {
        J.Null => Ok(Val.Py(PyV.None)),
        J.Bool(b) => Ok(Val.Py(PyV.Bool(b))),
        J.Int(_) => Ok(Val.Py(PyV.Int(j_int(x)))),
        J.Float(f) => Ok(Val.Py(PyV.Float(f))),
        J.Str(s) => Ok(Val.Py(PyV.Str(s.clone()))),
        J.Arr(xs) => {
            let mut out: Vec[PyV] = Vec.new();
            for e in xs {
                let v = ev(mut w, env, e)?;
                out.push(py_of(v)?);
            }
            Ok(Val.Py(PyV.List(out)))
        }
        J.Obj(ms) => {
            let mut out: Vec[PyItem] = Vec.new();
            for m in ms {
                let v = ev(mut w, env, m.val)?;
                out.push(PyItem { key: m.key.clone(), val: py_of(v)? });
            }
            Ok(Val.Py(PyV.Dict(out)))
        }
    }
}

fn rfc_py(r: ref Rfc) -> PyV {
    if r.kind == 0 {
        PyV.DateTime(r.dt.clone())
    } else if r.kind == 1 {
        PyV.Date(r.dt.clone())
    } else {
        PyV.Time(r.dt.clone())
    }
}

// tomlkit.key(k): a SingleKey for a str, a DottedKey for a list.
fn api_key(v: ref J) -> Key {
    match v {
        J.Arr(xs) => {
            let mut parts: Vec[SKey] = Vec.new();
            for x in xs {
                parts.push(skey(j_str(x), -1, None, None));
            }
            dotted_key(parts, None, None)
        }
        _ => key_of(j_str(v)),
    }
}

fn kw_bool(kw: ref Option[J], k: Str, default: bool) -> bool {
    match kw {
        Some(o) => match j_member(o, k) {
            Some(v) => j_bool(v),
            None => default,
        },
        None => default,
    }
}

fn arg_str(args: ref Vec[J], i: i64) -> String {
    if i < args.len() { j_str(args[i]) } else { String.new() }
}

fn call(w: mut ref World, env: ref Env, name: ref String, args0: own Vec[J]) -> Result[Val, Exc] {
    let mut args = args0;
    let mut kw: Option[J] = None;
    if args.len() > 0 {
        if let Some(o) = j_member(args[args.len() - 1], "$kw") {
            kw = Some(o);
            args.pop();
        }
    }
    if name == "document" {
        return Ok(Val.Doc(new_cont(mut w, false)));
    }
    if name == "comment" {
        let mut tv = trivia();
        tv.comment_ws = "  ".to_string();
        tv.comment = f"# {arg_str(args, 0)}";
        return Ok(Val.It(mk_comment(mut w, tv)));
    }
    if name == "nl" {
        return Ok(Val.It(mk_ws_str_fixed(mut w, "\n")));
    }
    if name == "ws" {
        return Ok(Val.It(mk_ws(mut w, arg_str(args, 0), true)));
    }
    if name == "table" {
        let sup = if args.len() > 0 { if j_bool(args[0]) { 1 } else { 0 } } else { -1 };
        return Ok(Val.It(mk_table(mut w, false, trivia(), false, sup, None, None)));
    }
    if name == "aot" {
        return Ok(Val.It(aot_new(mut w, Vec.new(), None, false)?));
    }
    if name == "inline_table" {
        let c = new_cont(mut w, false);
        return Ok(Val.It(mk_inline(mut w, c, trivia(), true)));
    }
    if name == "item" {
        let v = ev(mut w, env, args[0])?;
        return Ok(Val.It(item_of(mut w, v, -1, false)?));
    }
    if name == "string" {
        let literal = kw_bool(kw, "literal", false);
        let multiline = kw_bool(kw, "multiline", false);
        let escape = kw_bool(kw, "escape", true);
        let t = if literal and multiline { 3 } else if literal { 2 } else if multiline { 1 } else { 0 };
        return Ok(Val.It(string_from_raw(mut w, arg_str(args, 0), t, escape)?));
    }
    if name == "integer" {
        let n = match args[0] {
            J.Str(s) => match py_int(s, 10) {
                Some(n) => n,
                None => return Err(exc("ValueError", f"invalid literal for int() with base 10: {str_repr(s)}")),
            },
            _ => j_int(args[0]),
        };
        return Ok(Val.It(item_of(mut w, Val.Py(PyV.Int(n)), -1, false)?));
    }
    if name == "float_" {
        let s = arg_str(args, 0);
        let x = match py_float(s) {
            Some(x) => x,
            None => return Err(exc("ValueError", f"could not convert string to float: {str_repr(s)}")),
        };
        return Ok(Val.It(item_of(mut w, Val.Py(PyV.Float(x)), -1, false)?));
    }
    if name == "boolean" {
        let b = arg_str(args, 0) == "true";
        return Ok(Val.It(item_of(mut w, Val.Py(PyV.Bool(b)), -1, false)?));
    }
    if name == "date" or name == "time" or name == "datetime" {
        let r = parse_rfc3339(arg_str(args, 0))?;
        // A datetime is a date too.
        let ok = if name == "date" { r.kind <= 1 } else if name == "time" { r.kind == 2 } else { r.kind == 0 };
        if not ok {
            return Err(exc("ValueError", f"{name}() only accepts {name} strings."));
        }
        return Ok(Val.It(item_of(mut w, Val.Py(rfc_py(r)), -1, false)?));
    }
    if name == "array" {
        let raw = if args.len() > 0 { arg_str(args, 0) } else { "[]".to_string() };
        return Ok(Val.It(api_value(mut w, raw)?));
    }
    if name == "key" {
        return Ok(Val.Ky(api_key(args[0])));
    }
    Err(exc("AttributeError", f"module 'tomlkit' has no attribute {str_repr(name)}"))
}

fn mk_ws_str_fixed(w: mut ref World, s: Str) -> i64 {
    mk_ws(mut w, s.to_string(), true)
}

fn val_kind(w: ref World, v: ref Val) -> String {
    match v {
        Val.Py(p) => py_type(p),
        Val.It(id) => kind_name(w.items[id].kind).to_string(),
        Val.Doc(_) => "TOMLDocument".to_string(),
        Val.Prox(_) => "OutOfOrderTableProxy".to_string(),
        Val.Ky(k) => if k.single { "SingleKey".to_string() } else { "DottedKey".to_string() },
    }
}

// show(plain(x)).
fn show_val(w: mut ref World, v: ref Val) -> Result[String, Exc] {
    match v {
        Val.Ky(k) => Ok(f"<Key {key_text(k)}>"),
        _ => {
            let p = unwrap_val(mut w, v)?;
            Ok(show(p))
        }
    }
}

fn val_as_string(w: ref World, v: ref Val) -> Result[String, Exc] {
    match v {
        Val.It(id) => Ok(as_string(w, id)),
        Val.Doc(c) => Ok(c_as_string(w, c)),
        Val.Ky(k) => Ok(key_text(k)),
        Val.Prox(_) => Err(exc("AttributeError", "'OutOfOrderTableProxy' object has no attribute 'as_string'".to_string())),
        Val.Py(p) => Err(exc("AttributeError", f"'{py_type(p)}' object has no attribute 'as_string'")),
    }
}

// The container behind a document or a table, -1 for anything else.
fn cont_of(w: ref World, v: ref Val) -> i64 {
    match v {
        Val.Doc(c) => c,
        Val.It(id) => {
            let k = w.items[id].kind;
            if k == K_TABLE or k == K_INLINE { w.items[id].cont } else { -1 }
        }
        _ => -1,
    }
}

fn not_subscriptable(w: ref World, v: ref Val) -> Exc {
    exc("TypeError", f"'{val_kind(w, v)}' object is not subscriptable")
}

fn index_of(k: ref Val) -> Option[i64] {
    match k {
        Val.Py(PyV.Int(n)) => Some(n),
        _ => None,
    }
}

fn key_name(k: ref Val) -> Option[String] {
    match k {
        Val.Py(PyV.Str(s)) => Some(s.clone()),
        _ => None,
    }
}

fn list_index_error(k: ref Val) -> Exc {
    match k {
        Val.Py(p) => exc("TypeError", f"list indices must be integers or slices, not {py_type(p)}"),
        _ => exc("TypeError", "list indices must be integers or slices".to_string()),
    }
}

fn get_item(w: mut ref World, x: ref Val, k: ref Val) -> Result[Val, Exc] {
    if let Val.Prox(p) = x {
        let s = key_name(k).unwrap_or(String.new());
        return proxy_getitem(mut w, p, s);
    }
    let c = cont_of(w, x);
    if c >= 0 {
        return match key_name(k) {
            Some(s) => c_getitem(mut w, c, key_of(s)),
            None => Err(exc("TypeError", "'int' object is not iterable".to_string())),
        };
    }
    if let Val.It(id) = x {
        let kind = w.items[id].kind;
        if kind == K_ARRAY {
            return match index_of(k) {
                Some(i) => array_getitem(w, id, i),
                None => Err(list_index_error(k)),
            };
        }
        if kind == K_AOT {
            return match index_of(k) {
                Some(i) => aot_getitem(w, id, i),
                None => Err(list_index_error(k)),
            };
        }
        if kind == K_STRING {
            return Err(exc("TypeError", "string indices must be integers, not 'str'".to_string()));
        }
    }
    Err(not_subscriptable(w, x))
}

fn set_item(w: mut ref World, x: ref Val, k: ref Val, v: own Val) -> Result[(), Exc] {
    if let Val.Prox(p) = x {
        let s = key_name(k).unwrap_or(String.new());
        return proxy_setitem(mut w, p, s, v);
    }
    if let Val.Doc(c) = x {
        let s = key_name(k).unwrap_or(String.new());
        return c_setitem(mut w, c, s, v);
    }
    if let Val.It(id) = x {
        let kind = w.items[id].kind;
        if kind == K_TABLE or kind == K_INLINE {
            let s = key_name(k).unwrap_or(String.new());
            return table_setitem(mut w, id, s, v);
        }
        if kind == K_ARRAY {
            return match index_of(k) {
                Some(i) => array_setitem(mut w, id, i, v),
                None => Err(list_index_error(k)),
            };
        }
        if kind == K_AOT {
            return Err(exc("NotImplementedError", String.new()));
        }
    }
    Err(exc("TypeError", f"'{val_kind(w, x)}' object does not support item assignment"))
}

fn del_item(w: mut ref World, x: ref Val, k: ref Val) -> Result[(), Exc] {
    if let Val.Prox(p) = x {
        let s = key_name(k).unwrap_or(String.new());
        return proxy_delitem(mut w, p, s);
    }
    let c = cont_of(w, x);
    if c >= 0 {
        let s = key_name(k).unwrap_or(String.new());
        return c_remove(mut w, c, key_of(s));
    }
    if let Val.It(id) = x {
        let kind = w.items[id].kind;
        if kind == K_ARRAY {
            return match index_of(k) {
                Some(i) => array_delitem(mut w, id, i),
                None => Err(list_index_error(k)),
            };
        }
        if kind == K_AOT {
            return match index_of(k) {
                Some(i) => aot_delitem(mut w, id, i),
                None => Err(list_index_error(k)),
            };
        }
    }
    Err(exc("TypeError", f"'{val_kind(w, x)}' object doesn't support item deletion"))
}

fn has_key(w: mut ref World, x: ref Val, k: ref String) -> bool {
    match get_item(mut w, x, Val.Py(PyV.Str(k.clone()))) {
        Ok(_) => true,
        Err(_) => false,
    }
}

fn val_len(w: ref World, x: ref Val) -> Result[i64, Exc] {
    if let Val.Prox(p) = x {
        return Ok(w.proxies[p].dkeys.len());
    }
    let c = cont_of(w, x);
    if c >= 0 {
        return Ok(w.conts[c].dkeys.len());
    }
    if let Val.It(id) = x {
        let kind = w.items[id].kind;
        if kind == K_ARRAY {
            return Ok(w.items[id].elems.len());
        }
        if kind == K_AOT {
            return Ok(w.items[id].body.len());
        }
        if kind == K_STRING {
            return Ok(char_len(w.items[id].s));
        }
    }
    Err(exc("TypeError", f"object of type '{val_kind(w, x)}' has no len()"))
}

fn val_keys(w: ref World, x: ref Val) -> Vec[String] {
    if let Val.Prox(p) = x {
        return w.proxies[p].dkeys.clone();
    }
    let c = cont_of(w, x);
    if c >= 0 { w.conts[c].dkeys.clone() } else { Vec.new() }
}

// x.append(key, value) on a document or a table.
fn append_kv(w: mut ref World, x: ref Val, key: own Val, v: own Val) -> Result[(), Exc] {
    let (k, key_obj) = match key {
        Val.Py(PyV.Str(s)) => (Some(key_of(s)), false),
        Val.Py(PyV.None) => (None, false),
        Val.Ky(k) => (Some(k), true),
        _ => return Err(exc("TypeError", "a key must be a str or a Key".to_string())),
    };
    if let Val.Doc(c) = x {
        let it = item_of(mut w, v, -1, false)?;
        return c_append(mut w, c, k, it, true);
    }
    if let Val.It(id) = x {
        let kind = w.items[id].kind;
        if kind == K_TABLE or kind == K_INLINE {
            return table_append(mut w, id, k, key_obj, v);
        }
    }
    Err(exc("AttributeError", f"'{val_kind(w, x)}' object has no attribute 'append'"))
}

fn is_ws_or_comment(w: ref World, v: ref Val) -> bool {
    match v {
        Val.It(id) => {
            let k = w.items[id].kind;
            k == K_WS or k == K_COMMENT
        }
        _ => false,
    }
}

// x.add(key, value) or x.add(item).
fn add(w: mut ref World, x: ref Val, args: own Vec[Val]) -> Result[(), Exc] {
    if args.len() == 1 {
        if not is_ws_or_comment(w, args[0]) {
            return Err(exc("ValueError", "Non comment/whitespace items must have an associated key".to_string()));
        }
        return append_kv(mut w, x, Val.Py(PyV.None), args[0].clone());
    }
    append_kv(mut w, x, args[0].clone(), args[1].clone())
}

// x.append(value) on an array or an array of tables.
fn push(w: mut ref World, x: ref Val, v: own Val) -> Result[(), Exc] {
    if let Val.It(id) = x {
        let kind = w.items[id].kind;
        if kind == K_ARRAY {
            let n = w.items[id].elems.len();
            return array_insert(mut w, id, n, v);
        }
        if kind == K_AOT {
            let n = w.items[id].body.len();
            return aot_insert(mut w, id, n, v);
        }
    }
    Err(exc("TypeError", "append() missing 1 required positional argument: '_item'".to_string()))
}

fn insert(w: mut ref World, x: ref Val, i: i64, v: own Val) -> Result[(), Exc] {
    if let Val.It(id) = x {
        let kind = w.items[id].kind;
        if kind == K_ARRAY {
            return array_insert(mut w, id, i, v);
        }
        if kind == K_AOT {
            return aot_insert(mut w, id, i, v);
        }
    }
    Err(exc("AttributeError", f"'{val_kind(w, x)}' object has no attribute 'insert'"))
}

// MutableMapping.setdefault, then self[key].
fn setdefault(w: mut ref World, x: ref Val, k: ref String, default: own Val) -> Result[Val, Exc] {
    let key = Val.Py(PyV.Str(k.clone()));
    match get_item(mut w, x, key) {
        Ok(_) => {}
        Err(e) => {
            if e.kind != "NonExistentKey" {
                return Err(e);
            }
            set_item(mut w, x, key, default)?;
        }
    }
    get_item(mut w, x, key)
}

fn pop(w: mut ref World, x: ref Val, k: ref String) -> Result[Val, Exc] {
    let key = Val.Py(PyV.Str(k.clone()));
    let v = get_item(mut w, x, key)?;
    del_item(mut w, x, key)?;
    Ok(v)
}

fn update(w: mut ref World, x: ref Val, d: own Val) -> Result[(), Exc] {
    match d {
        Val.Py(PyV.Dict(ms)) => {
            for m in ms {
                set_item(mut w, x, Val.Py(PyV.Str(m.key.clone())), Val.Py(m.val.clone()))?;
            }
            Ok(())
        }
        _ => Err(exc("TypeError", "update() takes a dict here".to_string())),
    }
}

// ---------------------------------------------------------------- output

fn esc(line: ref String) -> String {
    line.replace("\r", "\\r").replace("\t", "\\t")
}

fn text(s: ref String) {
    let mut lines: Vec[String] = Vec.new();
    for l in s.split("\n") {
        lines.push(l.to_string());
    }
    let mut tail = false;
    if lines[lines.len() - 1].len() == 0 {
        lines.pop();
    } else {
        tail = true;
    }
    for l in lines {
        println(f"  |{esc(l)}|");
    }
    if tail and s.len() > 0 {
        println("  (no newline at end)");
    }
}

fn pad(depth: i64) -> String {
    let mut s = String.new();
    let mut i = 0;
    while i < depth {
        s.push_str("  ");
        i += 1;
    }
    s
}

fn body(w: ref World, c: i64, depth: i64) {
    let p = pad(depth);
    for e in w.conts[c].body {
        let mut name = match e.key {
            None => "-".to_string(),
            Some(k) => key_text(k),
        };
        if key_is_dotted_opt(e.key) {
            name.push_str(" (dotted)");
        }
        let v = e.item;
        let d = w.items[v].clone();
        let k = d.kind;
        if k == K_WS {
            println(f"  {p}{name} Whitespace {str_repr(d.s)}");
        } else if k == K_COMMENT {
            println(f"  {p}{name} Comment {str_repr(as_string(w, v))}");
        } else if k == K_TABLE or k == K_INLINE {
            println(f"  {p}{name} {kind_name(k)}");
            body(w, d.cont, depth + 1);
        } else if k == K_AOT {
            println(f"  {p}{name} AoT");
            for t in d.body {
                println(f"  {p}  [[]] Table");
                body(w, w.items[t].cont, depth + 2);
            }
        } else {
            println(f"  {p}{name} {kind_name(k)} {str_repr(as_string(w, v))}");
        }
    }
}

// ---------------------------------------------------------------- files

fn read_text(path: ref String) -> Result[String, Exc] {
    match fs.read_to_string(path.clone()) {
        Ok(t) => Ok(t),
        Err(e) => Err(exc("OSError", f"{path}: {e}")),
    }
}

fn write_text(path: ref String, s: ref String) -> Result[(), Exc] {
    let v = cps(path);
    let mut slash = -1;
    let mut i = 0;
    while i < v.len() {
        if v[i] == 47 {
            slash = i;
        }
        i += 1;
    }
    if slash > 0 {
        let dir = cps_text(v, 0, slash);
        if let Err(e) = fs.create_dir_all(dir) {
            return Err(exc("OSError", f"{path}: {e}"));
        }
    }
    match fs.write(path.clone(), s.clone()) {
        Ok(_) => Ok(()),
        Err(e) => Err(exc("OSError", f"{path}: {e}")),
    }
}

fn count_of(s: ref String, sub: Str) -> i64 {
    let v = cps(s);
    let t = cps(sub.to_string());
    let mut n = 0;
    let mut i = 0;
    while i + t.len() <= v.len() {
        let mut j = 0;
        while j < t.len() and v[i + j] == t[j] {
            j += 1;
        }
        if j == t.len() {
            n += 1;
            i += t.len();
        } else {
            i += 1;
        }
    }
    n
}

// TOMLFile.read(): the document, and the line ending it uses.
fn tfile_read(w: mut ref World, path: ref String) -> Result[(i64, String), Exc] {
    let content = read_text(path)?;
    let mut linesep = "\n".to_string();
    let nl = count_of(content, "\n");
    if nl > 0 {
        let crlf = count_of(content, "\r\n");
        if crlf == nl {
            linesep = "\r\n".to_string();
        } else if crlf == 0 {
            linesep = "\n".to_string();
        } else {
            linesep = "mixed".to_string();
        }
    }
    let doc = parse_doc(mut w, content)?;
    Ok((doc, linesep))
}

// TOMLFile.write(): the document with the file's line ending.
fn tfile_write(w: ref World, path: ref String, linesep: ref String, doc: i64) -> Result[(), Exc] {
    let mut content = c_as_string(w, doc);
    if linesep == "\n" {
        content = content.replace("\r\n", "\n");
    } else if linesep == "\r\n" {
        let v = cps(content);
        let mut out = String.new();
        let mut i = 0;
        while i < v.len() {
            if v[i] == 10 and (i == 0 or v[i - 1] != 13) {
                out.push_str("\r\n");
            } else {
                out.push(cp_char(v[i]));
            }
            i += 1;
        }
        content = out;
    }
    write_text(path, content)
}

// ---------------------------------------------------------------- jobs

fn op_str(op: ref Vec[J], i: i64) -> String {
    j_str(op[i])
}

fn walk(w: mut ref World, env: ref Env, base: ref String, keys: ref Vec[J]) -> Result[Val, Exc] {
    let mut x = env_get(env, base)?;
    for k in keys {
        let kv = ev(mut w, env, k)?;
        x = get_item(mut w, x, kv)?;
    }
    Ok(x)
}

fn slice(op: ref Vec[J], start: i64, end: i64) -> Vec[J] {
    let mut out: Vec[J] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(op[i].clone());
        i += 1;
    }
    out
}

fn step(w: mut ref World, env: mut ref Env, op: ref Vec[J]) -> Result[(), Exc] {
    let o = op_str(op, 0);
    let n = op.len();
    if o == "parse" {
        let src = read_text(f"data/docs/{op_str(op, 2)}.toml")?;
        let d = parse_doc(mut w, src)?;
        env_set(mut env, op_str(op, 1), Val.Doc(d));
    } else if o == "parses" {
        let d = parse_doc(mut w, op_str(op, 2))?;
        env_set(mut env, op_str(op, 1), Val.Doc(d));
    } else if o == "check" {
        let d = parse_doc(mut w, op_str(op, 1))?;
        let p = c_unwrap(mut w, d)?;
        println(f"  {show(p)}");
    } else if o == "rt" {
        let name = op_str(op, 1);
        let src = read_text(f"data/docs/{name}.toml")?;
        let d = parse_doc(mut w, src)?;
        let out = c_as_string(w, d);
        if out == src {
            println(f"  rt {name}: ok");
        } else {
            println(f"  rt {name}: differs");
            text(out);
        }
    } else if o == "let" {
        let v = ev(mut w, env, op[2])?;
        env_set(mut env, op_str(op, 1), v);
    } else if o == "get" {
        let v = walk(mut w, env, op_str(op, 2), slice(op, 3, n))?;
        env_set(mut env, op_str(op, 1), v);
    } else if o == "text" {
        let x = walk(mut w, env, op_str(op, 1), slice(op, 2, n))?;
        text(val_as_string(w, x)?);
    } else if o == "show" {
        let x = walk(mut w, env, op_str(op, 1), slice(op, 2, n))?;
        println(f"  {show_val(mut w, x)?}");
    } else if o == "print" {
        let x = walk(mut w, env, op_str(op, 1), slice(op, 2, n))?;
        let k = val_kind(w, x);
        println(f"  {k} {show_val(mut w, x)?}");
    } else if o == "raw" {
        let x = walk(mut w, env, op_str(op, 1), slice(op, 2, n))?;
        let k = val_kind(w, x);
        println(f"  {k} {str_repr(val_as_string(w, x)?)}");
    } else if o == "body" {
        let x = walk(mut w, env, op_str(op, 1), slice(op, 2, n))?;
        let c = cont_of(w, x);
        if c < 0 {
            return Err(exc("AttributeError", f"'{val_kind(w, x)}' object has no attribute 'body'"));
        }
        body(w, c, 0);
    } else if o == "set" {
        let x = walk(mut w, env, op_str(op, 1), slice(op, 2, n - 2))?;
        let k = ev(mut w, env, op[n - 2])?;
        let v = ev(mut w, env, op[n - 1])?;
        set_item(mut w, x, k, v)?;
    } else if o == "del" {
        let x = walk(mut w, env, op_str(op, 1), slice(op, 2, n - 1))?;
        let k = ev(mut w, env, op[n - 1])?;
        del_item(mut w, x, k)?;
    } else if o == "append" {
        let x = env_get(env, op_str(op, 1))?;
        let k = ev(mut w, env, op[2])?;
        let v = ev(mut w, env, op[3])?;
        append_kv(mut w, x, k, v)?;
    } else if o == "add" {
        let x = env_get(env, op_str(op, 1))?;
        let mut args: Vec[Val] = Vec.new();
        let mut i = 2;
        while i < n {
            args.push(ev(mut w, env, op[i])?);
            i += 1;
        }
        add(mut w, x, args)?;
    } else if o == "push" {
        let x = env_get(env, op_str(op, 1))?;
        let v = ev(mut w, env, op[2])?;
        push(mut w, x, v)?;
    } else if o == "insert" {
        let x = env_get(env, op_str(op, 1))?;
        let v = ev(mut w, env, op[3])?;
        insert(mut w, x, j_int(op[2]), v)?;
    } else if o == "multiline" {
        if let Val.It(a) = env_get(env, op_str(op, 1))? {
            w.items[a].multiline = j_bool(op[2]);
        }
    } else if o == "add_line" {
        let x = env_get(env, op_str(op, 1))?;
        let mut items: Vec[Val] = Vec.new();
        for e in j_items(op[2]) {
            items.push(ev(mut w, env, e)?);
        }
        let mut indent = "    ".to_string();
        let mut comment: Option[String] = None;
        let mut add_comma = true;
        let mut newline = true;
        if n > 3 {
            if let J.Obj(ms) = op[3] {
                for m in ms {
                    if m.key == "indent" {
                        indent = j_str(m.val);
                    } else if m.key == "comment" {
                        comment = Some(j_str(m.val));
                    } else if m.key == "add_comma" {
                        add_comma = j_bool(m.val);
                    } else if m.key == "newline" {
                        newline = j_bool(m.val);
                    }
                }
            }
        }
        if let Val.It(a) = x {
            array_add_line(mut w, a, items, indent, comment, add_comma, newline)?;
        }
    } else if o == "clear" {
        if let Val.It(a) = env_get(env, op_str(op, 1))? {
            array_clear(mut w, a);
        }
    } else if o == "comment" {
        if let Val.It(id) = env_get(env, op_str(op, 1))? {
            item_comment(mut w, id, op_str(op, 2));
        }
    } else if o == "indent" {
        if let Val.It(id) = env_get(env, op_str(op, 1))? {
            item_indent(mut w, id, j_int(op[2]));
        }
    } else if o == "setdefault" {
        let x = env_get(env, op_str(op, 1))?;
        let d = ev(mut w, env, op[3])?;
        let r = setdefault(mut w, x, op_str(op, 2), d)?;
        let k = val_kind(w, r);
        println(f"  {k} {show_val(mut w, r)?}");
    } else if o == "pop" {
        let x = env_get(env, op_str(op, 1))?;
        let r = pop(mut w, x, op_str(op, 2))?;
        let k = val_kind(w, r);
        println(f"  {k} {show_val(mut w, r)?}");
    } else if o == "update" {
        let x = env_get(env, op_str(op, 1))?;
        let d = ev(mut w, env, op[2])?;
        update(mut w, x, d)?;
    } else if o == "len" {
        let x = walk(mut w, env, op_str(op, 1), slice(op, 2, n))?;
        println(f"  {val_len(w, x)?}");
    } else if o == "keys" {
        let x = walk(mut w, env, op_str(op, 1), slice(op, 2, n))?;
        let mut ks: Vec[PyV] = Vec.new();
        for k in val_keys(w, x) {
            ks.push(PyV.Str(k.clone()));
        }
        println(f"  {show(PyV.List(ks))}");
    } else if o == "in" {
        let x = env_get(env, op_str(op, 1))?;
        let k = op_str(op, 2);
        let r = has_key(mut w, x, k);
        println(f"  {if r { "True" } else { "False" }}");
    } else if o == "super" {
        let x = walk(mut w, env, op_str(op, 1), slice(op, 2, n))?;
        match x {
            Val.It(t) => {
                let s = table_is_super(mut w, t)?;
                println(f"  {if s { "True" } else { "False" }}");
            }
            _ => return Err(exc("AttributeError", f"'{val_kind(w, x)}' object has no attribute 'is_super_table'")),
        }
    } else if o == "dumps" {
        let d = ev(mut w, env, op[1])?;
        let t = item_of(mut w, d, -1, j_bool(op[2]))?;
        text(as_string(w, t));
    } else if o == "kv" {
        let (k, v) = api_key_value(mut w, op_str(op, 1))?;
        let vv = Val.It(v);
        let kind = val_kind(w, vv);
        println(f"  {str_repr(key_text(k))} {kind} {str_repr(as_string(w, v))} {show_val(mut w, vv)?}");
    } else if o == "value" {
        let v = api_value(mut w, op_str(op, 1))?;
        let vv = Val.It(v);
        let kind = val_kind(w, vv);
        println(f"  {kind} {str_repr(as_string(w, v))} {show_val(mut w, vv)?}");
    } else if o == "fread" {
        let name = op_str(op, 1);
        let path = f"data/docs/{op_str(op, 2)}.toml";
        let (d, linesep) = tfile_read(mut w, path)?;
        env_set(mut env, name, Val.Doc(d));
        println(f"  linesep {str_repr(linesep)}");
        env.files.push(TFile { name: name, path: path, linesep: linesep });
    } else if o == "fwrite" {
        let name = op_str(op, 1);
        let mut linesep = "\n".to_string();
        for f in env.files {
            if f.name == name {
                linesep = f.linesep.clone();
            }
        }
        let path = f"data/out/{op_str(op, 2)}";
        if let Val.Doc(d) = env_get(env, name)? {
            tfile_write(w, path, linesep, d)?;
        }
        text(read_text(path)?);
    } else {
        return Err(exc("SystemExit", f"unknown op {o}"));
    }
    Ok(())
}

fn run_jobs(w: mut ref World) -> Result[(), Exc] {
    let text = read_text("data/jobs.jsonl".to_string())?;
    for line in text.split("\n") {
        if line.len() == 0 {
            continue;
        }
        let job = loads_str(line.to_string())?;
        println(f"== {j_str(j_member(job, "name").unwrap_or(J.Null))}");
        let mut env = Env { vars: Vec.new(), files: Vec.new() };
        for op in j_items(j_member(job, "steps").unwrap_or(J.Null)) {
            let parts = j_items(op);
            let mut shown = String.new();
            let mut i = 0;
            while i < parts.len() {
                if i > 0 {
                    shown.push(' ');
                }
                json_dumps(parts[i], mut shown);
                i += 1;
            }
            println(f"> {shown}");
            if let Err(e) = step(mut w, mut env, parts) {
                println(f"  ! {e.kind}: {e.msg}");
            }
        }
    }
    Ok(())
}
// ------------------------------------------------------------ program 1: a release script
//
// Reads data/repo/release.toml, sets the new version in each manifest it
// lists, keeps the version requirement of every path dependency in step,
// adds the release to CHANGELOG.toml, and writes the results to
// data/out/repo/ with their formatting and comments kept.

fn key_v(k: Str) -> Val {
    Val.Py(PyV.Str(k.to_string()))
}

fn at(w: mut ref World, x: ref Val, k: Str) -> Result[Val, Exc] {
    get_item(mut w, x, key_v(k))
}

fn at2(w: mut ref World, x: ref Val, k1: Str, k2: Str) -> Result[Val, Exc] {
    let y = at(mut w, x, k1)?;
    at(mut w, y, k2)
}

fn str_at(w: mut ref World, x: ref Val, k: Str) -> Result[String, Exc] {
    let y = at(mut w, x, k)?;
    Ok(str_val(w, y))
}

fn elements_at(w: mut ref World, x: ref Val, k: Str) -> Result[Vec[Val], Exc] {
    let y = at(mut w, x, k)?;
    Ok(elements(w, y))
}

fn iso_at(w: mut ref World, x: ref Val, k: Str) -> Result[String, Exc] {
    let y = at(mut w, x, k)?;
    Ok(isoformat(w, y))
}

// str(x) of a String, Integer or Float item.
fn str_val(w: ref World, x: ref Val) -> String {
    match x {
        Val.It(id) => {
            let d = w.items[id].clone();
            if d.kind == K_STRING {
                d.s.clone()
            } else if d.kind == K_INT {
                f"{d.ival}"
            } else if d.kind == K_FLOAT {
                float_repr(d.fval)
            } else {
                as_string(w, id)
            }
        }
        Val.Py(PyV.Str(s)) => s.clone(),
        Val.Py(PyV.Bool(b)) => if b { "True".to_string() } else { "False".to_string() },
        _ => String.new(),
    }
}

fn is_str_val(w: ref World, x: ref Val) -> bool {
    match x {
        Val.It(id) => w.items[id].kind == K_STRING,
        Val.Py(PyV.Str(_)) => true,
        _ => false,
    }
}

fn isoformat(w: ref World, x: ref Val) -> String {
    match x {
        Val.It(id) => {
            let d = w.items[id].clone();
            if d.kind == K_DATE {
                date_iso(d.dt)
            } else if d.kind == K_TIME {
                time_iso(d.dt)
            } else {
                datetime_iso(d.dt)
            }
        }
        _ => String.new(),
    }
}

// The items of an array (as list iteration sees them) or the tables of
// an array of tables.
fn elements(w: ref World, x: ref Val) -> Vec[Val] {
    let mut out: Vec[Val] = Vec.new();
    if let Val.It(id) = x {
        let d = w.items[id].clone();
        if d.kind == K_ARRAY {
            for e in d.elems {
                out.push(Val.It(e));
            }
        } else if d.kind == K_AOT {
            for t in d.body {
                out.push(Val.It(t));
            }
        }
    }
    out
}

fn bump_requirement(old: ref String, new: ref String) -> String {
    let v = cps(old);
    let mut i = 0;
    while i < v.len() and not is_ascii_digit(v[i]) {
        i += 1;
    }
    f"{cps_text(v, 0, i)}{new}"
}

fn is_table_like(w: ref World, x: ref Val) -> bool {
    match x {
        Val.It(id) => {
            let k = w.items[id].kind;
            k == K_TABLE or k == K_INLINE
        }
        _ => false,
    }
}

fn bump_path_deps(w: mut ref World, deps: ref Val, section: ref String, new: ref String, crates: ref Vec[String], changes: mut ref Vec[String]) -> Result[(), Exc] {
    for name in val_keys(w, deps) {
        let dep = get_item(mut w, deps, Val.Py(PyV.Str(name.clone())))?;
        let mut listed = false;
        for c in crates {
            if c == name {
                listed = true;
            }
        }
        if listed and is_table_like(w, dep) and has_key(mut w, dep, "path".to_string()) and has_key(mut w, dep, "version".to_string()) {
            let old = str_at(mut w, dep, "version")?;
            set_item(mut w, dep, key_v("version"), Val.Py(PyV.Str(bump_requirement(old, new))))?;
            let now = str_at(mut w, dep, "version")?;
            changes.push(f"{section}.{name}.version: {old} -> {now}");
        }
    }
    Ok(())
}

fn release(w: mut ref World) -> Result[(), Exc] {
    println("== release");
    let plan = Val.Doc(parse_doc(mut w, read_text("data/repo/release.toml".to_string())?)?);
    let rel = at(mut w, plan, "release")?;
    let new = str_at(mut w, rel, "version")?;
    let mut crates: Vec[String] = Vec.new();
    for c in elements_at(mut w, rel, "crates")? {
        crates.push(str_val(w, c));
    }
    let date = at(mut w, rel, "date")?;
    println(f"  version {new}, dated {isoformat(w, date)}");
    for f in elements_at(mut w, rel, "files")? {
        let path = str_at(mut w, f, "path")?;
        let doc = Val.Doc(parse_doc(mut w, read_text(f"data/repo/{path}")?)?);
        let mut changes: Vec[String] = Vec.new();
        let k = str_at(mut w, f, "kind")?;
        if k == "cargo-workspace" {
            let pkg = at2(mut w, doc, "workspace", "package")?;
            let old = str_at(mut w, pkg, "version")?;
            changes.push(f"workspace.package.version: {old} -> {new}");
            set_item(mut w, pkg, key_v("version"), Val.Py(PyV.Str(new.clone())))?;
            let deps = at2(mut w, doc, "workspace", "dependencies")?;
            bump_path_deps(mut w, deps, "workspace.dependencies".to_string(), new, crates, mut changes)?;
        } else if k == "cargo" {
            let pkg = at(mut w, doc, "package")?;
            let v = at(mut w, pkg, "version")?;
            if is_str_val(w, v) {
                changes.push(f"package.version: {str_val(w, v)} -> {new}");
                set_item(mut w, pkg, key_v("version"), Val.Py(PyV.Str(new.clone())))?;
            } else {
                changes.push("package.version: from the workspace".to_string());
            }
            for section in vec!["dependencies", "dev-dependencies"] {
                if has_key(mut w, doc, section.to_string()) {
                    let deps = at(mut w, doc, section)?;
                    bump_path_deps(mut w, deps, section.to_string(), new, crates, mut changes)?;
                }
            }
        } else if k == "poetry" {
            let p = at2(mut w, doc, "tool", "poetry")?;
            let old = str_at(mut w, p, "version")?;
            changes.push(f"tool.poetry.version: {old} -> {new}");
            set_item(mut w, p, key_v("version"), Val.Py(PyV.Str(new.clone())))?;
        } else if k == "pep621" {
            let p = at(mut w, doc, "project")?;
            let old = str_at(mut w, p, "version")?;
            changes.push(f"project.version: {old} -> {new}");
            set_item(mut w, p, key_v("version"), Val.Py(PyV.Str(new.clone())))?;
        } else {
            changes.push(f"unknown kind {str_repr(k)}, left alone");
        }
        let out = val_as_string(w, doc)?;
        write_text(f"data/out/repo/{path}", out)?;
        println(f"  {path}:");
        for c in changes {
            println(f"    {c}");
        }
        text(read_text(f"data/out/repo/{path}")?);
    }

    let log = Val.Doc(parse_doc(mut w, read_text("data/repo/CHANGELOG.toml".to_string())?)?);
    let notes = str_at(mut w, rel, "notes")?;
    let when = unwrap_val(mut w, date)?;
    let entry_v = PyV.Dict(vec![
        PyItem { key: "version".to_string(), val: PyV.Str(new.clone()) },
        PyItem { key: "date".to_string(), val: when },
        PyItem { key: "notes".to_string(), val: PyV.Str(notes) },
    ]);
    let entry = item_of(mut w, Val.Py(entry_v), -1, false)?;
    let nl = mk_ws_str_fixed(mut w, "\n");
    table_append(mut w, entry, None, false, Val.It(nl))?;
    let releases = at(mut w, log, "releases")?;
    insert(mut w, releases, 0, Val.It(entry))?;
    write_text("data/out/repo/CHANGELOG.toml".to_string(), val_as_string(w, log)?)?;
    println("  CHANGELOG.toml:");
    text(read_text("data/out/repo/CHANGELOG.toml".to_string())?);
    let again = Val.Doc(parse_doc(mut w, read_text("data/out/repo/CHANGELOG.toml".to_string())?)?);
    for r in elements_at(mut w, again, "releases")? {
        let v = str_at(mut w, r, "version")?;
        let d = iso_at(mut w, r, "date")?;
        let n = str_at(mut w, r, "notes")?;
        println(f"    {v} {d} {n}");
    }
    Ok(())
}

// ------------------------------------------------------------ program 2: migrating service configs to schema 2
//
// Copies data/etc/ to data/out/etc/ and moves each config there to
// schema 2 in place: the log settings go into a [logging] table, the
// server's *_timeout strings become *_timeout_ms integers, and the
// [[upstreams]] array becomes a table of tables named after each
// upstream. Comments and line endings are kept.

fn duration_ms(s: ref String) -> Result[i64, String] {
    let v = cps(s);
    let bad = f"bad duration {str_repr(s)}";
    let mut total = 0;
    let mut num = String.new();
    let mut i = 0;
    while i < v.len() {
        let c = v[i];
        if is_ascii_digit(c) {
            num.push(cp_char(c));
            i += 1;
            continue;
        }
        let mut unit = cp_char(c).to_string();
        if c == 109 and i + 1 < v.len() and v[i + 1] == 115 {
            unit = "ms".to_string();
        }
        if num.len() == 0 {
            return Err(bad);
        }
        let n = py_int(num, 10).unwrap();
        if unit == "ms" {
            total += n;
        } else if unit == "s" {
            total += n * 1000;
        } else if unit == "m" {
            total += n * 60000;
        } else if unit == "h" {
            total += n * 3600000;
        } else {
            return Err(bad);
        }
        num = String.new();
        i += char_len(unit);
    }
    if num.len() > 0 {
        return Err(bad);
    }
    Ok(total)
}

fn int_val(n: i64) -> Val {
    Val.Py(PyV.Int(n))
}

fn migrate_one(w: mut ref World, name: ref String) -> Result[(), Exc] {
    let path = f"data/out/etc/{name}";
    let (d, linesep) = tfile_read(mut w, path)?;
    let doc = Val.Doc(d);
    println(f"  {name}:");
    if has_key(mut w, doc, "schema".to_string()) {
        let s = at(mut w, doc, "schema")?;
        if let Val.It(id) = s {
            if w.items[id].kind == K_INT and w.items[id].ival == 2 {
                println("    already at schema 2");
                return Ok(());
            }
        }
    }
    let mut notes: Vec[String] = Vec.new();
    let log = mk_table(mut w, false, trivia(), false, -1, None, None);
    for (old, new) in vec![("log_level", "level"), ("log_format", "format")] {
        if has_key(mut w, doc, old.to_string()) {
            let it = c_item(mut w, d, key_of(old.to_string()))?;
            c_remove(mut w, d, key_of(old.to_string()))?;
            table_append(mut w, log, Some(key_of(new.to_string())), false, it)?;
            notes.push(f"{old} -> logging.{new}");
        }
    }
    if table_len(w, log) > 0 {
        c_append(mut w, d, Some(key_of("logging".to_string())), log, true)?;
    }
    if has_key(mut w, doc, "server".to_string()) {
        let srv = at(mut w, doc, "server")?;
        if let Val.It(st) = srv {
            for k in val_keys(w, srv) {
                let v = get_item(mut w, srv, Val.Py(PyV.Str(k.clone())))?;
                if k.ends_with("_timeout") and is_str_val(w, v) {
                    let text_v = str_val(w, v);
                    let ms = match duration_ms(text_v) {
                        Ok(ms) => ms,
                        Err(e) => {
                            notes.push(f"server.{k}: {e}");
                            continue;
                        }
                    };
                    table_delitem(mut w, st, k)?;
                    table_append(mut w, st, Some(key_of(f"{k}_ms")), false, int_val(ms))?;
                    notes.push(f"server.{k} = {text_v} -> server.{k}_ms = {ms}");
                }
            }
        }
    }
    let mut ups_is_aot = false;
    if has_key(mut w, doc, "upstreams".to_string()) {
        if let Val.It(u) = c_item(mut w, d, key_of("upstreams".to_string()))? {
            ups_is_aot = w.items[u].kind == K_AOT;
        }
    }
    if ups_is_aot {
        let ups = mk_table(mut w, false, trivia(), false, 1, None, None);
        for t in elements_at(mut w, doc, "upstreams")? {
            let n = str_at(mut w, t, "name")?;
            let nt = mk_table(mut w, false, trivia(), false, -1, None, None);
            for k in val_keys(w, t) {
                let v = get_item(mut w, t, Val.Py(PyV.Str(k.clone())))?;
                if k != "name" {
                    table_setitem(mut w, nt, k, v)?;
                }
            }
            table_append(mut w, ups, Some(key_of(n)), false, Val.It(nt))?;
            notes.push(f"upstreams[{n}] -> upstreams.{n}");
        }
        c_remove(mut w, d, key_of("upstreams".to_string()))?;
        c_append(mut w, d, Some(key_of("upstreams".to_string())), ups, true)?;
    }
    if has_key(mut w, doc, "version".to_string()) {
        c_remove(mut w, d, key_of("version".to_string()))?;
    }
    let two = item_of(mut w, int_val(2), -1, false)?;
    c_append(mut w, d, Some(key_of("schema".to_string())), two, true)?;
    notes.push("version 1 -> schema 2".to_string());
    tfile_write(w, path, linesep, d)?;
    for n in notes {
        println(f"    {n}");
    }
    let written = read_text(path)?;
    text(written);
    let again = parse_doc(mut w, written)?;
    let p = c_unwrap(mut w, again)?;
    println(f"    {show(p)}");
    Ok(())
}

fn sorted_names(dir: Str) -> Result[Vec[String], Exc] {
    let mut names = match fs.read_dir(dir) {
        Ok(v) => v,
        Err(e) => return Err(exc("OSError", f"{dir}: {e}")),
    };
    names.sort();
    Ok(names)
}

fn migrate(w: mut ref World) -> Result[(), Exc] {
    println("== migrate");
    for name in sorted_names("data/etc")? {
        write_text(f"data/out/etc/{name}", read_text(f"data/etc/{name}")?)?;
    }
    for name in sorted_names("data/out/etc")? {
        migrate_one(mut w, name)?;
    }
    Ok(())
}

fn run() -> Result[(), Exc] {
    let mut w = new_world();
    run_jobs(mut w)?;
    release(mut w)?;
    migrate(mut w)?;
    Ok(())
}

// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    data_part_3(mut v);
    data_part_4(mut v);
    v
}

