    t.push_str("{\"name\": \"files keep line endings\", \"steps\": [[\"fread\", \"d\", \"crlf\"], [\"set\", \"d\", \"server\", \"port\", 8443], [\"fwrite\", \"d\", \"crlf.toml\"], [\"fread\", \"e\", \"service\"], [\"set\", \"e\", \"version\", 2], [\"fwrite\", \"e\", \"service.toml\"], [\"fread\", \"m\", \"mixed\"], [\"set\", \"m\", \"b\", 20], [\"fwrite\", \"m\", \"mixed.toml\"]]}\n");
    v.push(DataFile { path: "jobs.jsonl".to_string(), body: t });
    let mut t = String.new();
    t.push_str("# Release history, newest first.\n");
    t.push_str("\n");
