== new document
> "let" "d" {"$call": ["document"]}
> "add" "d" {"$call": ["comment", "generated by deploy-tool"]}
> "add" "d" {"$call": ["nl"]}
> "add" "d" "title" "release"
> "let" "t" {"$call": ["table"]}
> "add" "t" "host" "example.org"
> "add" "t" "port" 443
> "append" "t" null {"$call": ["comment", "ports below 1024 need root"]}
> "add" "d" "server" {"$v": "t"}
> "let" "a" {"$call": ["aot"]}
> "push" "a" {"$call": ["item", {"name": "web", "replicas": 3}]}
> "push" "a" {"$call": ["item", {"name": "worker", "replicas": 1}]}
> "append" "d" "service" {"$v": "a"}
> "let" "s" {"$call": ["table", true]}
> "let" "inner" {"$call": ["table"]}
> "update" "inner" {"x": 1}
> "append" "s" "inner" {"$v": "inner"}
> "append" "d" "outer" {"$v": "s"}
> "add" "d" "late" true
> "text" "d"
  |# generated by deploy-tool|
  ||
  |title = "release"|
  |late = true|
  ||
  |[server]|
  |host = "example.org"|
  |port = 443|
  |# ports below 1024 need root|
  ||
  |[[service]]|
  |name = "web"|
  |replicas = 3|
  ||
  |[[service]]|
  |name = "worker"|
  |replicas = 1|
  ||
  |[outer.inner]|
  |x = 1|
> "show" "d"
  {'title': 'release', 'server': {'host': 'example.org', 'port': 443}, 'service': [{'name': 'web', 'replicas': 3}, {'name': 'worker', 'replicas': 1}], 'outer': {'inner': {'x': 1}}, 'late': True}
== document errors
> "let" "d" {"$call": ["document"]}
> "add" "d" "x" 1
> "add" "d" "x" 2
  ! KeyAlreadyPresent: Key "x" already exists.
> "add" "d" 5
  ! ValueError: Non comment/whitespace items must have an associated key
> "append" "d" {"$key": ["a", "b"]} {"t": 1}
  ! TOMLKitError: Can't add a table to a dotted key
> "del" "d" "zzz"
  ! NonExistentKey: 'Key "zzz" does not exist.'
> "pop" "d" "x"
  Integer 1
> "pop" "d" "x"
  ! NonExistentKey: 'Key "x" does not exist.'
> "text" "d"
== setdefault and pop
> "parse" "d" "service"
