  Array '[\n    "crates/alpha",\n    "crates/beta",\n    "crates/server",\n    "crates/web",\n]'
> "get" "e" "d" "workspace" "exclude"
> "push" "e" "crates/old"
> "insert" "e" 0 "crates/zero"
> "raw" "e"
  Array '["crates/zero","crates/experimental", "crates/old"]'
> "del" "e" 0
> "del" "e" -1
> "raw" "e"
  Array '["crates/experimental"]'
> "del" "e" 0
> "raw" "e"
  Array '[]'
> "push" "e" "only"
> "raw" "e"
  Array '["only"]'
> "del" "e" 3
  ! IndexError: list assignment index out of range
== netlify redirects
> "parse" "d" "netlify"
> "get" "r" "d" "redirects"
> "push" "r" {"from": "/old", "to": "/new", "status": 302}
> "set" "d" "build" "environment" "HUGO_VERSION" "0.126.0"
> "set" "d" "build" "processing" {"skip_processing": true}
> "text" "d"
  |[build]|
  |  base = "site/"|
  |  publish = "public/"|
  |  command = "hugo --gc --minify"|
  ||
  |  [build.environment]|
  |    HUGO_VERSION = "0.126.0"|
  |    NODE_ENV = "production"|
  ||
  |[build.processing]|
  |skip_processing = true|
  |[context.deploy-preview]|
  |  command = "hugo --buildDrafts --buildFuture -b $DEPLOY_PRIME_URL"|
  ||
  |[[redirects]]|
  |  from = "/blog/*"|
  |  to = "/posts/:splat"|
  |  status = 301|
  |  force = false|
  ||
  |[[redirects]]|
  |  from = "/api/*"|
  |  to = "https://api.example.net/:splat"|
  |  status = 200|
  ||
  |[[redirects]]|
  |from = "/old"|
  |to = "/new"|
  |status = 302|
  |[[headers]]|
  |  for = "/*"|
  |  [headers.values]|
  |    X-Frame-Options = "DENY"|
  |    Content-Security-Policy = "default-src 'self'"|
== service settings
