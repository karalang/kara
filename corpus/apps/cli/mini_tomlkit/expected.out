== cargo dependencies
> "parse" "d" "cargo"
> "get" "deps" "d" "dependencies"
> "let" "it" {"$call": ["inline_table"]}
> "update" "it" {"version": "1.0", "features": ["full"]}
> "set" "deps" "tokio" {"$v": "it"}
> "set" "deps" "log" "0.4.21"
> "del" "deps" "memmap2"
> "get" "feat" "d" "features"
> "set" "feat" "mmap" []
> "set" "feat" "default" ["std"]
> "set" "d" "package" "version" "0.10.0"
> "get" "bins" "d" "bin"
> "push" "bins" {"name": "ferrite-repair", "path": "src/bin/repair.rs"}
> "del" "d" "profile" "release" "debug"
> "set" "d" "profile" "release" "strip" "symbols"
> "text" "d"
  |[package]|
  |name = "ferrite"|
  |version = "0.10.0"|
  |edition = "2021"|
  |rust-version = "1.74"|
  |authors = ["The Ferrite Developers"]|
  |description = "A tiny embedded key-value store"|
  |keywords = ["kv", "embedded", "storage"]|
  |categories = ["database-implementations"]|
  ||
  |[dependencies]|
  |serde = { version = "1.0", features = ["derive"] }|
  |crc32fast = "1.4"|
  |log = "0.4.21"|
  |tokio = {version = "1.0", features = ["full"]}|
  ||
  |[dev-dependencies]|
  |tempfile = "3"|
  |proptest = { version = "1.4", default-features = false, features = ["std"] }|
  ||
  |[features]|
  |default = ["std"]|
  |mmap = []|
  ||
  |[profile.release]|
  |lto = true|
  |codegen-units = 1|
  |opt-level = 3|
  |strip = "symbols"|
  ||
  |[[bin]]|
  |name = "ferrite-cli"|
  |path = "src/bin/cli.rs"|
  ||
  |[[bin]]|
  |name = "ferrite-bench"|
  |path = "src/bin/bench.rs"|
  |required-features = ["mmap"]|
  ||
  |[[bin]]|
  |name = "ferrite-repair"|
  |path = "src/bin/repair.rs"|
  |[[example]]|
  |name = "basic"|
> "len" "bins"
  3
== cargo aot insert and delete
> "parse" "d" "cargo"
> "get" "bins" "d" "bin"
> "insert" "bins" 0 {"name": "ferrite-first", "path": "src/main.rs"}
> "del" "bins" 1
> "text" "d"
  |[package]|
  |name = "ferrite"|
  |version = "0.9.4"|
  |edition = "2021"|
  |rust-version = "1.74"|
  |authors = ["The Ferrite Developers"]|
  |description = "A tiny embedded key-value store"|
  |keywords = ["kv", "embedded", "storage"]|
  |categories = ["database-implementations"]|
  ||
  |[dependencies]|
  |serde = { version = "1.0", features = ["derive"] }|
  |crc32fast = "1.4"|
  |memmap2 = { version = "0.9", optional = true }|
  |log = "0.4"|
  ||
  |[dev-dependencies]|
  |tempfile = "3"|
  |proptest = { version = "1.4", default-features = false, features = ["std"] }|
  ||
  |[features]|
  |default = ["mmap"]|
  |mmap = ["dep:memmap2"]|
  ||
  |[profile.release]|
  |lto = true|
  |codegen-units = 1|
  |opt-level = 3|
  |debug = false|
  ||
  |[[bin]]|
  |name = "ferrite-first"|
  |path = "src/main.rs"|
  |[[bin]]|
  |name = "ferrite-bench"|
  |path = "src/bin/bench.rs"|
  |required-features = ["mmap"]|
  ||
  |[[example]]|
  |name = "basic"|
