== structure of strings
> "parse" "d" "strings"
> "body" "d"
  str1  String '"I\'m a string. \\"You can quote me\\". Name\\tJos\\u00E9\\nLocation\\tSF."'
  str2  String '"""\nRoses are red\nViolets are blue"""'
  str3  String '"""\\\n       The quick brown \\\n       fox jumps over \\\n       the lazy dog.\\\n       """'
  str4  String '"""Here are two quotation marks: "". Simple enough."""'
  str5  String '"""Here are fifteen quotation marks: ""\\"""\\"""\\"""\\"""\\"."""'
  str6  String '""""This," she said, "is just a pointless statement.""""'
  winpath   String "'C:\\Users\\nodejs\\templates'"
  quoted    String '\'Tom "Dubs" Preston-Werner\''
  regex     String "'<\\i\\c*\\s*>'"
  regex2  String "'''I [dw]on't need \\d{2} apples'''"
  lines   String "'''\nThe first newline is\ntrimmed in raw strings.\n   All other whitespace\n   is preserved.\n'''"
  quot15  String '\'\'\'Here are fifteen quotation marks: """""""""""""""\'\'\''
  apos15  String '"Here are fifteen apostrophes: \'\'\'\'\'\'\'\'\'\'\'\'\'\'\'"'
  emoji  String '"\\U0001F600 and \\u00e9"'
  empty  String '""'
  empty_lit  String "''"
== structure of arrays
> "parse" "d" "arrays"
> "body" "d"
  integers  Array '[ 1, 2, 3 ]'
  colors  Array '[ "red", "yellow", "green" ]'
  nested_arrays_of_ints  Array '[ [ 1, 2 ], [3, 4, 5] ]'
  nested_mixed_array  Array '[ [ 1, 2 ], ["a", "b", "c"] ]'
  string_array  Array '[ "all", \'strings\', """are the same""", \'\'\'type\'\'\' ]'
  numbers  Array '[ 0.1, 0.2, 0.5, 1, 2, 5 ]'
  contributors  Array '[\n  "Foo Bar <foo@example.com>",\n  { name = "Baz Qux", email = "bazqux@example.com", url = "https://example.com/bazqux" }\n]'
  integers2  Array '[\n  1, 2, 3\n]'
  integers3  Array '[\n  1,\n  2, # this is ok\n]'
  empty  Array '[]'
  empty_ws  Array '[ ]'
  commented  Array '[ # opening\n  "x", # first\n  # alone\n  "y"\n]'
== structure of dotted
> "parse" "d" "dotted"
> "body" "d"
  name  String '"Orange"'
  physical (dotted) Table
    color  String '"orange"'
  physical (dotted) Table
    shape  String '"round"'
  site (dotted) Table
    "google.com"  Bool 'true'
  3 (dotted) Table
    14159  String '"pi"'
  "ʎǝʞ"  String '"value"'
  'key2'  String '"literal key"'
  a  (dotted) Table
     b  (dotted) Table
       c  Integer '1'
  ""  String '"empty quoted key"'
  - Whitespace '\n'
  tool Table
    lint (dotted) Table
      enabled  Bool 'true'
    lint (dotted) Table
      rules  Array '["E1", "W2"]'
== structure of netlify
> "parse" "d" "netlify"
> "body" "d"
  build Table
    base  String '"site/"'
    publish  String '"public/"'
    command  String '"hugo --gc --minify"'
    - Whitespace '\n'
    environment Table
      HUGO_VERSION  String '"0.125.4"'
      NODE_ENV  String '"production"'
      - Whitespace '\n'
  context Table
    deploy-preview Table
      command  String '"hugo --buildDrafts --buildFuture -b $DEPLOY_PRIME_URL"'
      - Whitespace '\n'
  redirects AoT
    [[]] Table
      from  String '"/blog/*"'
      to  String '"/posts/:splat"'
      status  Integer '301'
      force  Bool 'false'
      - Whitespace '\n'
    [[]] Table
      from  String '"/api/*"'
      to  String '"https://api.example.net/:splat"'
      status  Integer '200'
      - Whitespace '\n'
  headers AoT
    [[]] Table
      for  String '"/*"'
      values Table
        X-Frame-Options  String '"DENY"'
        Content-Security-Policy  String '"default-src \'self\'"'
== structure of outoforder
> "parse" "d" "outoforder"
> "body" "d"
  - Comment '# Tables of one parent spread through the file, as TOML allows.\n'
  fruit Table
    apple Table
      color  String '"red"'
      - Whitespace '\n'
  animal Table
    legs  Integer '4'
    - Whitespace '\n'
  fruit Table
    orange Table
      color  String '"orange"'
      - Whitespace '\n'
    apple Table
      texture Table
        smooth  Bool 'true'
