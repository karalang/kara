  String 'team-orders'
> "setdefault" "d" "limits" {"rps": 500}
  Table {'rps': 500}
> "pop" "d" "log_format"
  String 'json'
> "get" "s" "d" "server"
> "pop" "s" "workers"
  Integer 8
> "text" "d"
  |# orders-api: production settings|
  |version = 1|
  |log_level = "info"|
  |owner = "team-orders"|
  ||
  |[server]|
  |host = "0.0.0.0"|
  |port = 8443|
  |read_timeout = "15s"|
  ||
  |[database]|
  |url = "postgres://orders@db.internal:5432/orders"|
  |pool_size = 20|
  |# Statement timeout in milliseconds.|
  |statement_timeout = 5000|
  ||
  |[cache]|
  |backend = "redis"|
  |url = "redis://cache.internal:6379/2"|
  |ttl = 300|
  ||
  |[[upstreams]]|
  |name = "payments"|
  |url = "https://payments.internal"|
  |retries = 3|
  ||
  |[[upstreams]]|
  |name = "inventory"|
  |url = "https://inventory.internal"|
  |retries = 1|
  ||
  |[limits]|
  |rps = 500|
== dumps of plain data
> "dumps" {"title": "x", "owner": {"name": "y", "dob": {"$dt": "1979-05-27T07:32:00-08:00"}}, "ports": [8000, 8001], "flags": {"a": true}, "z": 1} false
  |title = "x"|
  |ports = [8000, 8001]|
  |z = 1|
  ||
  |[owner]|
  |name = "y"|
  |dob = 1979-05-27T07:32:00-08:00|
  ||
  |[flags]|
  |a = true|
> "dumps" {"title": "x", "owner": {"name": "y", "dob": {"$dt": "1979-05-27T07:32:00-08:00"}}, "ports": [8000, 8001], "flags": {"a": true}, "z": 1} true
  |ports = [8000, 8001]|
  |title = "x"|
  |z = 1|
  ||
  |[flags]|
  |a = true|
  ||
  |[owner]|
  |dob = 1979-05-27T07:32:00-08:00|
  |name = "y"|
> "dumps" {"servers": [{"name": "a", "ip": "10.0.0.1"}, {"name": "b"}], "mixed": [1, {"x": 2}], "points": [{"x": 1, "y": {"z": 2}}]} false
  |mixed = [1, {x = 2}]|
  |[[servers]]|
  |name = "a"|
  |ip = "10.0.0.1"|
  ||
  |[[servers]]|
  |name = "b"|
  ||
  |[[points]]|
  |x = 1|
  ||
  |[points.y]|
  |z = 2|
> "dumps" {"b": 2, "a": {"d": 1, "c": [{"y": 1, "x": 2}]}, "aa": 0} true
  |aa = 0|
  |b = 2|
  ||
  |[a]|
  |d = 1|
  |[[a.c]]|
  |x = 2|
  |y = 1|
> "dumps" {"when": {"$date": "2024-05-01"}, "at": {"$time": "09:30:00.5"}, "utc": {"$dt": "2024-05-01T09:30:00Z"}, "local": {"$dt": "2024-05-01T09:30:00"}, "f": 1.5, "e": 1e-07, "big": 1e+300, "inf": {"$f": "inf"}, "ninf": {"$f": "-inf"}, "nan": {"$f": "nan"}, "neg0": {"$f": "-0.0"}} false
  |when = 2024-05-01|
  |at = 09:30:00.500000|
  |utc = 2024-05-01T09:30:00Z|
  |local = 2024-05-01T09:30:00|
  |f = 1.5|
  |e = 1e-07|
  |big = 1e+300|
  |inf = inf|
  |ninf = -inf|
  |nan = nan|
  |neg0 = -0.0|
> "dumps" {"s": "tab\there \"q\" back\\slash\u0001 é", "k y": 1, "": 2, "dotted.key": 3, "é": 4} false
  |s = "tab\there \"q\" back\\slash\u0001 é"|
  |"k y" = 1|
  |"" = 2|
  |"dotted.key" = 3|
  |"é" = 4|
> "dumps" {"empty": {}, "nested": {"empty": {}}, "list": [], "e2": [[]]} false
  |list = []|
  |e2 = [[]]|
  |[empty]|
  ||
  |[nested.empty]|
== item conversions
> "let" "a" {"$call": ["item", [1, 2, 3]]}
> "raw" "a"
  Array '[1, 2, 3]'
> "let" "b" {"$call": ["item", [{"x": 1}, {"x": 2}]]}
> "raw" "b"
  AoT 'x = 1\nx = 2\n'
> "let" "c" {"$call": ["item", {"t": {"u": 1}, "v": 2}]}
> "raw" "c"
  Table 'v = 2\n[t]\nu = 1\n'
> "let" "e" {"$call": ["item", [[1, 2], {"k": "v"}, "s"]]}
> "raw" "e"
  Array '[[1, 2], {k = "v"}, "s"]'
> "let" "f" {"$call": ["item", {"$f": "nan"}]}
> "raw" "f"
  Float 'nan'
> "let" "g" {"$call": ["item", {"$dt": "2024-01-02T03:04:05.000600+05:30"}]}
> "raw" "g"
  DateTime '2024-01-02T03:04:05.000600+05:30'
> "print" "g"
  DateTime datetime(2024-01-02T03:04:05.000600+05:30)
> "let" "h" {"$call": ["item", {"$time": "23:59:59"}]}
> "raw" "h"
  Time '23:59:59'
> "let" "i" {"$call": ["item", true]}
> "raw" "i"
  Bool 'true'
> "let" "j" {"$call": ["item", -12]}
> "raw" "j"
  Integer '-12'
> "let" "k" {"$call": ["item", 3.0]}
> "raw" "k"
  Float '3.0'
> "let" "l" {"$call": ["item", 12345678.9]}
> "raw" "l"
  Float '12345678.9'
== string constructors
> "let" "a" {"$call": ["string", "plain"]}
> "raw" "a"
  String '"plain"'
> "let" "a" {"$call": ["string", "C:\\temp", {"$kw": {"literal": true}}]}
> "raw" "a"
  String "'C:\\temp'"
> "let" "a" {"$call": ["string", "one\ntwo\n", {"$kw": {"multiline": true}}]}
> "raw" "a"
  String '"""one\ntwo\n"""'
> "let" "a" {"$call": ["string", "has \"\"\" inside \\ and \t tab\r\nnext", {"$kw": {"multiline": true}}]}
> "raw" "a"
  String '"""has ""\\" inside \\\\ and \\t tab\r\nnext"""'
> "print" "a"
  String 'has """ inside \\ and \t tab\r\nnext'
> "let" "a" {"$call": ["string", "lit\nlines", {"$kw": {"literal": true, "multiline": true}}]}
> "raw" "a"
  String "'''lit\nlines'''"
> "let" "a" {"$call": ["string", "it's", {"$kw": {"literal": true}}]}
  ! InvalidStringError: Invalid string: 'it's'.
> "let" "a" {"$call": ["string", "x'''y", {"$kw": {"literal": true, "multiline": true}}]}
  ! InvalidStringError: Invalid string: '''x'''y'''.
> "let" "a" {"$call": ["string", "bell\u0007", {"$kw": {"literal": true}}]}
  ! InvalidStringError: Invalid string: 'bell\x07'.
> "let" "a" {"$call": ["string", "raw \\n kept", {"$kw": {"escape": false}}]}
> "raw" "a"
  String '"raw \\n kept"'
> "let" "a" {"$call": ["string", "\u0000\u001f é"]}
> "raw" "a"
  String '"\\u0000\\u001f\\u007f\x80 é"'
> "let" "a" {"$call": ["string", "\"\"\"\"", {"$kw": {"multiline": true}}]}
> "raw" "a"
  String '"""""\\"""""'
== scalar constructors
> "let" "a" {"$call": ["integer", "42"]}
> "raw" "a"
  Integer '42'
> "let" "a" {"$call": ["integer", -7]}
> "raw" "a"
  Integer '-7'
> "let" "a" {"$call": ["float_", "2.50"]}
> "raw" "a"
  Float '2.5'
> "let" "a" {"$call": ["boolean", "true"]}
> "raw" "a"
  Bool 'true'
> "let" "a" {"$call": ["boolean", "True"]}
> "raw" "a"
  Bool 'false'
> "let" "a" {"$call": ["date", "2024-07-04"]}
> "raw" "a"
  Date '2024-07-04'
> "let" "a" {"$call": ["date", "2024-07-04T00:00:00"]}
> "let" "a" {"$call": ["time", "12:30:45.123"]}
> "raw" "a"
  Time '12:30:45.123000'
> "print" "a"
  Time time(12:30:45.123000)
> "let" "a" {"$call": ["datetime", "2024-07-04 12:30:45+02:00"]}
> "raw" "a"
  DateTime '2024-07-04T12:30:45+02:00'
> "print" "a"
  DateTime datetime(2024-07-04T12:30:45+02:00)
> "let" "a" {"$call": ["datetime", "2024-07-04"]}
  ! ValueError: datetime() only accepts datetime strings.
> "let" "a" {"$call": ["date", "July 4"]}
  ! ValueError: Invalid RFC 339 string
> "let" "a" {"$call": ["array"]}
> "raw" "a"
  Array '[]'
> "let" "a" {"$call": ["array", "[1, 2,   3]"]}
> "raw" "a"
  Array '[1, 2,   3]'
> "let" "a" {"$call": ["key", "simple"]}
> "let" "a" {"$call": ["key", "needs quoting"]}
> "let" "w" {"$call": ["ws", "  \t"]}
> "raw" "w"
  Whitespace '  \t'
> "let" "c" {"$call": ["comment", "hello"]}
> "raw" "c"
  Comment '# hello\n'
== value and key_value
> "value" "1"
  Integer '1' 1
> "value" "0x1F"
  Integer '0x1F' 31
> "value" "true"
  Bool 'true' True
> "value" "\"s\\u00e9\""
  String '"s\\u00e9"' 'sé'
> "value" "[1, [2, 3], {a = 1}]"
  Array '[1, [2, 3], {a = 1}]' [1, [2, 3], {'a': 1}]
> "value" "{ a = 1, b.c = 2 }"
  InlineTable '{ a = 1, b.c = 2 }' {'a': 1, 'b': {'c': 2}}
> "value" "1979-05-27"
  Date '1979-05-27' date(1979-05-27)
> "value" "1979-05-27 07:32:00"
  DateTime '1979-05-27 07:32:00' datetime(1979-05-27T07:32:00)
> "value" "07:32:00"
  Time '07:32:00' time(07:32:00)
> "value" "nan"
  Float 'nan' nan
> "value" "-inf"
  Float '-inf' -inf
> "value" "1 2"
  ! UnexpectedCharError: Unexpected character: ' ' at line 1 col 1
> "value" "\"unterminated"
  ! UnexpectedEofError: Unexpected end of file at line 1 col 13
> "value" ""
  ! UnexpectedCharError: Unexpected character: '\x00' at line 0 col 0
> "kv" "a = 1"
  'a ' Integer '1' 1
> "kv" "  \"quoted key\"   =   'v'"
  '"quoted key"   ' String "'v'" 'v'
> "kv" "a.b.c = [1]"
  'a.b.c ' Array '[1]' [1]
> "kv" "x=1 # c"
  'x' Integer '1' 1
> "kv" "a b = 1"
  ! ParseError: Invalid key "a b" at line 1 col 4
> "kv" "a = "
  ! UnexpectedCharError: Unexpected character: '\x00' at line 1 col 4
== arrays by hand
> "let" "a" {"$call": ["array"]}
> "push" "a" 1
> "push" "a" 2
> "raw" "a"
  Array '[1, 2]'
> "multiline" "a" true
> "raw" "a"
  Array '[\n    1,\n    2,\n]'
> "insert" "a" 0 0
> "raw" "a"
  Array '[\n    0,\n    1,\n    2,\n]'
> "let" "b" {"$call": ["array"]}
> "add_line" "b" [1, 2, 3]
> "add_line" "b" [4, 5, 6] {"comment": "second row"}
> "add_line" "b" [] {"indent": ""}
> "raw" "b"
  Array '[\n    1, 2, 3,\n    4, 5, 6, # second row\n]'
> "print" "b"
  Array [1, 2, 3, 4, 5, 6]
> "let" "c" {"$call": ["array", "[\n    \"a\",\n    \"b\",\n]"]}
> "push" "c" "c"
> "insert" "c" 1 "a2"
> "raw" "c"
  Array '[\n    "a",\n    "a2",\n    "b",\n    "c",\n]'
> "del" "c" 0
> "raw" "c"
  Array '[\n    "a2",\n    "b",\n    "c",\n]'
> "set" "c" -1 "last"
> "raw" "c"
  Array '[\n    "a2",\n    "b",\n    "last",\n]'
> "insert" "c" 99 "end"
> "raw" "c"
  Array '[\n    "a2",\n    "b",\n    "last",\n    "end",\n]'
> "insert" "c" -99 "start"
> "raw" "c"
  Array '[\n    "start",\n    "a2",\n    "b",\n    "last",\n    "end",\n]'
> "clear" "c"
> "raw" "c"
  Array '[]'
> "push" "c" 1
> "raw" "c"
  Array '[1]'
> "let" "e" {"$call": ["array", "[1, 2] "]}
  ! UnexpectedCharError: Unexpected character: ' ' at line 1 col 6
> "let" "e" {"$call": ["array", "[ # c\n  1, # one\n  2\n]"]}
> "push" "e" 3
> "raw" "e"
  Array '[ # c\n  1, # one\n  2,\n  3\n]'
> "del" "e" 0
> "raw" "e"
  Array '[ # c\n  2,\n  3\n]'
> "set" "e" 5 1
  ! IndexError: list assignment index out of range
> "add_line" "e" [{"$call": ["comment", "no"]}]
  ! ValueError: item type <class 'tomlkit.items.Comment'> is not allowed in add_line
== inline tables
> "parses" "d" "point = { x = 1, y = 2 }\nempty = {}\n"
> "get" "p" "d" "point"
> "set" "p" "z" 3
> "del" "p" "x"
> "raw" "p"
  InlineTable '{  y = 2, z = 3}'
> "get" "e" "d" "empty"
> "set" "e" "a" 1
> "set" "e" "b" {"c": 2}
> "raw" "e"
  InlineTable '{a = 1,b = {c = 2}}'
> "let" "n" {"$call": ["inline_table"]}
> "append" "n" "k" "v"
> "append" "n" "j" {"$call": ["integer", "5"]}
> "raw" "n"
  InlineTable '{k = "v", j = 5}'
> "let" "i" {"$call": ["integer", "7"]}
> "comment" "i" "dropped"
> "set" "n" "i" {"$v": "i"}
> "raw" "n"
  InlineTable '{k = "v", j = 5, i = 7}'
> "set" "d" "point" {"$v": "n"}
> "text" "d"
  |point = {k = "v", j = 5, i = 7}|
  |empty = {a = 1,b = {c = 2}}|
== tables by hand
> "let" "d" {"$call": ["document"]}
> "let" "t" {"$call": ["table"]}
> "add" "t" "a" 1
> "add" "t" {"$call": ["nl"]}
> "add" "t" "b" 2
> "append" "d" "t" {"$v": "t"}
> "let" "u" {"$call": ["table"]}
> "add" "u" "c" 3
> "append" "d" "u" {"$v": "u"}
> "add" "d" "after" "x"
> "text" "d"
  |after = "x"|
  |[t]|
  |a = 1|
  ||
  |b = 2|
  ||
  |[u]|
  |c = 3|
> "body" "d"
  after String '"x"'
  t Table
    a Integer '1'
    - Whitespace '\n'
    b Integer '2'
  u Table
    c Integer '3'
> "let" "d2" {"$call": ["document"]}
> "add" "d2" "k" 1
> "append" "d2" "t" {"x": {"y": {"z": 1}}}
> "text" "d2"
  |k = 1|
  ||
  |[t.x.y]|
  |z = 1|
> "super" "d2" "t"
  True
> "super" "d2" "t" "x"
  True
== files keep line endings
> "fread" "d" "crlf"
  linesep '\r\n'
> "set" "d" "server" "port" 8443
> "fwrite" "d" "crlf.toml"
  |# saved on Windows\r|
  |[server]\r|
  |host = "0.0.0.0"\r|
  |port = 8443\r|
  |\r|
  |[server.tls]\r|
  |enabled = false # off in dev\r|
  |ciphers = [\r|
  |  "TLS_AES_128_GCM_SHA256",\r|
  |]\r|
> "fread" "e" "service"
  linesep '\n'
> "set" "e" "version" 2
> "fwrite" "e" "service.toml"
  |# orders-api: production settings|
  |version = 2|
  |log_level = "info"|
  |log_format = "json"  # json or text|
  ||
  |[server]|
  |host = "0.0.0.0"|
  |port = 8443|
  |workers = 8|
  |read_timeout = "15s"|
  ||
  |[database]|
  |url = "postgres://orders@db.internal:5432/orders"|
  |pool_size = 20|
  |# Statement timeout in milliseconds.|
  |statement_timeout = 5000|
  ||
  |[cache]|
  |backend = "redis"|
  |url = "redis://cache.internal:6379/2"|
  |ttl = 300|
  ||
  |[[upstreams]]|
  |name = "payments"|
  |url = "https://payments.internal"|
  |retries = 3|
  ||
  |[[upstreams]]|
  |name = "inventory"|
  |url = "https://inventory.internal"|
  |retries = 1|
> "fread" "m" "mixed"
  linesep 'mixed'
> "set" "m" "b" 20
> "fwrite" "m" "mixed.toml"
  |a = 1\r|
  |b = 20|
  |c = 3\r|
== release
  version 1.5.0, dated 2024-06-01
  Cargo.toml:
    workspace.package.version: 1.4.0 -> 1.5.0
    workspace.dependencies.ferrite-core.version: 1.4.0 -> 1.5.0
  |[workspace]|
  |resolver = "2"|
  |members = ["crates/core", "crates/cli"]|
  ||
  |[workspace.package]|
  |version = "1.5.0"|
  |edition = "2021"|
  |license = "MIT OR Apache-2.0"|
  |repository = "https://git.example.org/ferrite"|
  ||
  |[workspace.dependencies]|
  |ferrite-core = { path = "crates/core", version = "1.5.0" }|
  |serde = { version = "1.0.197", features = ["derive"] }|
  |clap = "4.5"|
  crates/core/Cargo.toml:
    package.version: from the workspace
  |[package]|
  |name = "ferrite-core"|
  |version.workspace = true|
  |edition.workspace = true|
  |license.workspace = true|
  ||
  |[dependencies]|
  |serde.workspace = true|
  |crc32fast = "1.4"|
  ||
  |[dev-dependencies]|
  |ferrite-testkit = { path = "../testkit", version = "0.3" }|
  crates/cli/Cargo.toml:
    package.version: 1.4.0 -> 1.5.0
    dependencies.ferrite-core.version: =1.4.0 -> =1.5.0
    dependencies.ferrite-repair.version: ~1.4 -> ~1.5.0
  |[package]|
  |name = "ferrite"|
  |version = "1.5.0" # keep in step with the workspace|
  |edition = "2021"|
  |description = "Command-line tool for ferrite stores"|
  ||
  |[[bin]]|
  |name = "ferrite"|
  |path = "src/main.rs"|
  ||
  |[dependencies]|
  |ferrite-core = { path = "../core", version = "=1.5.0" }|
  |clap = { workspace = true }|
  ||
  |[dependencies.ferrite-repair]|
  |path = "../repair"|
  |version = "~1.5.0"|
  |optional = true|
  python/pyproject.toml:
    tool.poetry.version: 1.4.0 -> 1.5.0
  |[tool.poetry]|
  |name = "ferrite-tools"|
  |version = "1.5.0"|
  |description = "Python helpers for ferrite stores"|
  |authors = ["The Ferrite Developers"]|
  ||
  |[tool.poetry.dependencies]|
  |python = "^3.10"|
  python/ferrite-py/pyproject.toml:
    project.version: 1.4.0 -> 1.5.0
  |[build-system]|
  |requires = ["maturin>=1.5,<2.0"]|
  |build-backend = "maturin"|
  ||
  |[project]|
  |name = "ferrite-py"|
  |version = "1.5.0"|
  |requires-python = ">=3.9"|
  |classifiers = [|
  |    "Programming Language :: Rust",|
  |    "Programming Language :: Python :: Implementation :: CPython",|
  |]|
  CHANGELOG.toml:
  |# Release history, newest first.|
  ||
  |[[releases]]|
  |version = "1.5.0"|
  |date = 2024-06-01|
  |notes = "Faster compaction and a new repair command."|
  ||
  |[[releases]]|
  |version = "1.4.0"|
  |date = 2024-03-12|
  |notes = "Memory-mapped reads."|
  ||
  |[[releases]]|
  |version = "1.3.2"|
  |date = 2024-01-20|
  |notes = "Fix a crash on empty logs."|
    1.5.0 2024-06-01 Faster compaction and a new repair command.
    1.4.0 2024-03-12 Memory-mapped reads.
    1.3.2 2024-01-20 Fix a crash on empty logs.
== migrate
  billing-worker.toml:
    log_level -> logging.level
    server.shutdown_timeout = 1m30s -> server.shutdown_timeout_ms = 90000
    upstreams[ledger] -> upstreams.ledger
    version 1 -> schema 2
  |# billing-worker\r|
  |schema = 2\r|
  |\r|
  |[server]\r|
  |port = 9100\r|
  |shutdown_timeout_ms = 90000\r|
  |\r|
  |\r|
  |[logging]\r|
  |level = "warn"\r|
  |\r|
  |[upstreams.ledger]\r|
  |url = "https://ledger.internal"\r|
  |retries = 5\r|
    {'schema': 2, 'server': {'port': 9100, 'shutdown_timeout_ms': 90000}, 'logging': {'level': 'warn'}, 'upstreams': {'ledger': {'url': 'https://ledger.internal', 'retries': 5}}}
  notifier.toml:
    log_level -> logging.level
    log_format -> logging.format
    server.read_timeout = 250ms -> server.read_timeout_ms = 250
    server.idle_timeout = 2m -> server.idle_timeout_ms = 120000
    version 1 -> schema 2
  |# Verbose while we chase the duplicate-email bug.|
  |schema = 2|
  ||
  |[server]|
  |host = "127.0.0.1"|
  |port = 7000|
  |tls = { cert = "/etc/notifier/cert.pem", key = "/etc/notifier/key.pem" }|
  |max_body = "1MB"|
  |read_timeout_ms = 250|
  |idle_timeout_ms = 120000|
  ||
  |[smtp]|
  |relay = "mail.internal"|
  |port = 25|
  ||
  |[logging]|
  |level = "debug"|
  |format = "text"|
    {'schema': 2, 'server': {'host': '127.0.0.1', 'port': 7000, 'tls': {'cert': '/etc/notifier/cert.pem', 'key': '/etc/notifier/key.pem'}, 'max_body': '1MB', 'read_timeout_ms': 250, 'idle_timeout_ms': 120000}, 'smtp': {'relay': 'mail.internal', 'port': 25}, 'logging': {'level': 'debug', 'format': 'text'}}
  orders-api.toml:
    log_level -> logging.level
    log_format -> logging.format
    server.read_timeout = 15s -> server.read_timeout_ms = 15000
    upstreams[payments] -> upstreams.payments
    upstreams[inventory] -> upstreams.inventory
    version 1 -> schema 2
