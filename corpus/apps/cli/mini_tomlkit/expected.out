> "del" "u" 0
> "text" "d"
  |# orders-api: production settings|
  |version = 1|
  |log_level = "debug"|
  |log_format = "json"  # json or text|
  |region = "eu-west-1"|
  ||
  |[server]|
  |host = "0.0.0.0"|
  |port = 9443|
  |workers = 8|
  |read_timeout = "15s"|
  ||
  |[database]|
  |url = "postgres://orders@db.internal:5432/orders"|
  |pool_size = 40|
  |# Statement timeout in milliseconds.|
  |statement_timeout = 5000|
  ||
  |[database.replica]|
  |url = "postgres://replica"|
  |pool_size = 5|
  |[[upstreams]]|
  |name = "inventory"|
  |url = "https://inventory.internal"|
  |retries = 1|
> "show" "d"
  {'version': 1, 'log_level': 'debug', 'log_format': 'json', 'server': {'host': '0.0.0.0', 'port': 9443, 'workers': 8, 'read_timeout': '15s'}, 'database': {'url': 'postgres://orders@db.internal:5432/orders', 'pool_size': 40, 'statement_timeout': 5000, 'replica': {'url': 'postgres://replica', 'pool_size': 5}}, 'upstreams': [{'name': 'inventory', 'url': 'https://inventory.internal', 'retries': 1}], 'region': 'eu-west-1'}
