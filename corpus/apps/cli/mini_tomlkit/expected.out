== error: array eof
> "check" "a = [1, 2"
  ! UnexpectedCharError: Unexpected character: '\x00' at line 1 col 9
== error: inline trailing comma
> "check" "a = {x = 1,}\n"
  ! UnexpectedCharError: Unexpected character: '}' at line 1 col 11
== error: inline leading comma
> "check" "a = {, x = 1}\n"
  ! UnexpectedCharError: Unexpected character: ',' at line 1 col 5
== error: inline no comma
> "check" "a = {x = 1 y = 2}\n"
  ! UnexpectedCharError: Unexpected character: 'y' at line 1 col 11
== error: inline newline
> "check" "a = {x = 1,\n y = 2}\n"
  ! EmptyKeyError: Empty key at line 1 col 11
== error: inline duplicate
> "check" "a = {x = 1, x = 2}\n"
  ! KeyAlreadyPresent: Key "x" already exists.
== error: inline eof
> "check" "a = {x = 1,"
  ! UnexpectedEofError: Unexpected end of file at line 1 col 11
== error: table name space
> "check" "[a b]\n"
  ! ParseError: Invalid key "a b" at line 1 col 4
== error: bad line start
> "check" "!x = 1\n"
  ! EmptyKeyError: Empty key at line 1 col 0
== error: only a value
> "check" "\"x\"\n"
  ! UnexpectedCharError: Unexpected character: '\n' at line 1 col 3
== error: backslash ws no newline
> "check" "a = \"\"\"x\\  y\"\"\"\n"
  ! InvalidCharInStringError: Invalid character 'y' in string at line 1 col 11
== error: mixed array
> "check" "a = [1, \"x\", 2.5]\n"
  {'a': [1, 'x', 2.5]}
== error: crlf bare cr
> "check" "a = 1\rb = 2\n"
  ! UnexpectedCharError: Unexpected character: 'b' at line 2 col 0
