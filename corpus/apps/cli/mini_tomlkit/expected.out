  |# Packaging for the "inkwell" project.|
  |readme-note = "see README"|
  |[build-system]|
  |requires = ["poetry-core>=1.8"]|
  |build-backend = "poetry.core.masonry.api"|
  ||
  |[tool.poetry]|
  |name = "inkwell"|
  |version = "2.3.1"   # bumped by the release script|
  |description = "Render Markdown notebooks to static sites"|
  |authors = ["Ada Byron <ada@example.org>", "Grace H. <grace@example.org>"]|
  |license = "MIT"|
  |readme = "README.md"|
  |classifiers = [|
  |    "Development Status :: 4 - Beta",|
  |    "Programming Language :: Python :: 3",  # keep sorted|
  |    "Topic :: Text Processing :: Markup",|
  |]|
  |packages = [{ include = "inkwell", from = "src" }]|
  ||
  |[tool.poetry.dependencies]|
  |python = "^3.9"|
  |markdown-it-py = { version = "^3.0", extras = ["linkify"] }|
  |jinja2 = "^3.1"|
  |watchdog = { version = ">=3.0", optional = true }|
  ||
  |[tool.poetry.group.dev.dependencies]|
  |pytest = "^8.0"|
  |pytest-cov = "^5.0"|
  |ruff = "0.4.4"|
  ||
  |[tool.poetry.extras]|
  |watch = ["watchdog"]|
  ||
  |[tool.poetry.scripts]|
  |inkwell = "inkwell.cli:main"|
  ||
  |[tool.ruff]|
  |line-length = 100|
  |target-version = "py39"|
  ||
  |[tool.ruff.lint]|
  |select = ["E", "F", "I", "B"]|
  |ignore = [] # nothing yet|
  ||
  |[tool.pytest.ini_options]|
  |addopts = "-ra --strict-markers"|
  |testpaths = [|
  |  "tests",|
  |]|
  ||
  |[tool.black]|
  |line-length = 100|
  |target-version = ["py39"]|
  ||
  |[tool.mypy]|
  |strict = true|
  ||
  |[[tool.mypy.overrides]]|
  |module = "tests.*"|
  |disallow_untyped_defs = false|
  ||
  |[project]|
  |name = "inkwell"|
  ||
  |[project.urls]|
  |Homepage = "https://inkwell.example.org"|
