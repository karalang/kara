== error: missing value
> "check" "a = \n"
  ! UnexpectedCharError: Unexpected character: '\n' at line 1 col 4
== error: missing equals
> "check" "a 1\n"
  ! ParseError: Invalid key "a 1" at line 1 col 3
== error: two equals
> "check" "a == 1\n"
  ! UnexpectedCharError: Unexpected character: '=' at line 1 col 3
== error: bare key space
> "check" "first name = 1\n"
  ! ParseError: Invalid key "first name" at line 1 col 11
== error: empty key
> "check" "= 1\n"
  ! EmptyKeyError: Empty key at line 1 col 0
== error: empty table name
> "check" "[]\n"
  ! EmptyTableNameError: Empty table name at line 1 col 1
== error: unterminated table
> "check" "[a\nb = 1\n"
  ! UnexpectedCharError: Unexpected character: '\n' at line 1 col 2
== error: table eof
> "check" "[a"
  ! UnexpectedEofError: Unexpected end of file at line 1 col 2
== error: duplicate key
> "check" "a = 1\na = 2\n"
  ! ParseError: Key "a" already exists. at line 2 col 0
== error: duplicate key in table
> "check" "[t]\nx = 1\nx = 2\n"
  ! KeyAlreadyPresent: Key "x" already exists.
== error: duplicate table
> "check" "[t]\nx = 1\n[t]\ny = 2\n"
  ! ParseError: Key "t" already exists. at line 4 col 0
== error: table after aot
> "check" "[[t]]\nx = 1\n[t]\ny = 2\n"
  ! ParseError: Key "t" already exists. at line 4 col 0
== error: aot after table
> "check" "[t]\nx = 1\n[[t]]\ny = 2\n"
  ! ParseError: Key "t" already exists. at line 4 col 0
== error: dotted redefines table
> "check" "[a]\nb.c = 1\n[a.b]\nd = 2\n"
  ! TOMLKitError: Redefinition of an existing table
== error: value then table
> "check" "a = 1\n[a]\nb = 2\n"
  ! ParseError: Key "a" already exists. at line 3 col 0
== error: leading zero
> "check" "n = 012\n"
  ! InvalidNumberError: Invalid number at line 1 col 7
== error: double underscore
> "check" "n = 1__2\n"
  ! InvalidNumberError: Invalid number at line 1 col 8
== error: trailing underscore
> "check" "n = 12_\n"
  ! InvalidNumberError: Invalid number at line 1 col 7
== error: trailing dot
> "check" "n = 1.\n"
  ! InvalidNumberError: Invalid number at line 1 col 6
== error: dot exponent
> "check" "n = 1.e5\n"
  ! InvalidNumberError: Invalid number at line 1 col 8
== error: signed hex
> "check" "n = +0x1F\n"
  ! InvalidNumberError: Invalid number at line 1 col 9
== error: hex underscore lead
> "check" "n = 0x_1F\n"
  ! InvalidNumberError: Invalid number at line 1 col 9
