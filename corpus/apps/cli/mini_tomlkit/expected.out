== bump pyproject
> "parse" "d" "pyproject"
> "get" "p" "d" "tool" "poetry"
> "set" "p" "version" "2.4.0"
> "get" "deps" "p" "dependencies"
> "set" "deps" "httpx" "^0.27"
> "set" "deps" "jinja2" {"version": "^3.1", "extras": ["i18n"]}
> "del" "d" "tool" "poetry" "group" "dev" "dependencies" "pytest-cov"
> "get" "cls" "p" "classifiers"
> "insert" "cls" 2 "Programming Language :: Python :: 3.12"
> "push" "cls" "Typing :: Typed"
> "set" "d" "tool" "ruff" "line-length" 88
> "get" "ign" "d" "tool" "ruff" "lint" "ignore"
> "push" "ign" "E501"
> "text" "d"
  |# Packaging for the "inkwell" project.|
  |[build-system]|
  |requires = ["poetry-core>=1.8"]|
  |build-backend = "poetry.core.masonry.api"|
  ||
  |[tool.poetry]|
  |name = "inkwell"|
  |version = "2.4.0"   # bumped by the release script|
  |description = "Render Markdown notebooks to static sites"|
  |authors = ["Ada Byron <ada@example.org>", "Grace H. <grace@example.org>"]|
  |license = "MIT"|
  |readme = "README.md"|
  |classifiers = [|
  |    "Development Status :: 4 - Beta",|
  |    "Programming Language :: Python :: 3",  # keep sorted|
  |    "Programming Language :: Python :: 3.12",|
  |    "Topic :: Text Processing :: Markup",|
  |    "Typing :: Typed",|
  |]|
  |packages = [{ include = "inkwell", from = "src" }]|
  ||
  |[tool.poetry.dependencies]|
  |python = "^3.9"|
  |markdown-it-py = { version = "^3.0", extras = ["linkify"] }|
  |watchdog = { version = ">=3.0", optional = true }|
  |httpx = "^0.27"|
  ||
  |[tool.poetry.dependencies.jinja2]|
  |version = "^3.1"|
  |extras = ["i18n"]|
  |[tool.poetry.group.dev.dependencies]|
  |pytest = "^8.0"|
  |ruff = "0.4.4"|
  ||
  |[tool.poetry.extras]|
  |watch = ["watchdog"]|
  ||
  |[tool.poetry.scripts]|
  |inkwell = "inkwell.cli:main"|
  ||
  |[tool.ruff]|
  |line-length = 88|
  |target-version = "py39"|
  ||
  |[tool.ruff.lint]|
  |select = ["E", "F", "I", "B"]|
  |ignore = ["E501"] # nothing yet|
  ||
  |[tool.pytest.ini_options]|
  |addopts = "-ra --strict-markers"|
  |testpaths = [|
  |  "tests",|
  |]|
