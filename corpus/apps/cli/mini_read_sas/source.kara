    put_bytes("data/jobs.txt", unhex(file_10()))?;
    put_bytes("data/lb_2024.xpt", unhex(file_11()))?;
    put_bytes("data/lb_2024.xpt.gz", unhex(file_12()))?;
    put_bytes("data/lb_2024.xpt.zip", unhex(file_13()))?;
    put_bytes("data/lb_cport.xpt", unhex(file_14()))?;
    put_bytes("data/lb_noobs.xpt", unhex(file_15()))?;
    put_bytes("data/lb_prefix.xpt", unhex(file_16()))?;
    put_bytes("data/lb_v8.xpt", unhex(file_17()))?;
    put_bytes("data/lb_wide.xpt", unhex(file_18()))?;
    put_bytes("data/ledger_badrdc.sas7bdat", unhex(file_19()))?;
    put_bytes("data/ledger_badrle.sas7bdat", unhex(file_20()))?;
    put_bytes("data/ledger_longrle.sas7bdat", unhex(file_21()))?;
    put_bytes("data/ledger_mismatch.sas7bdat", unhex(file_22()))?;
    put_bytes("data/ledger_newsub.sas7bdat", unhex(file_23()))?;
    put_bytes("data/ledger_shortrle.sas7bdat", unhex(file_24()))?;
