// The files under data/, in name order.
fn write_data() -> Result[(), String] {
    put_bytes("data/ae_ds.xpt", unhex(file_0()))?;
    put_bytes("data/branch_sales.sas7bdat", unhex(file_1()))?;
    put_bytes("data/claims_2023.sas7bdat", unhex(file_2()))?;
