== bom kicad/power.kicad_sch
USB-C power input rev B (2024-03-09)
note C1: Bulk cap, X5R "16V" rated
skip #PWR01 (not in BOM)
1 x C1  10u  Capacitor_SMD:C_0805_2012Metric  [Device:C]
2 x R1,R2  5.1k  Resistor_SMD:R_0603_1608Metric  [Device:R]
1 wire(s); first runs ((xy 101.6 85.09) (xy 101.6 76.2))
== libs kicad/fp-lib-table
version 7
Connector_USB: /usr/share/kicad/footprints/Connector_USB.pretty (KiCad, enabled) "USB connectors"
Resistor_SMD: /usr/share/kicad/footprints/Resistor_SMD.pretty (KiCad, enabled) "Resistor SMD footprints"
project: /home/dev/usb-power/footprints/project.pretty (KiCad, disabled) "Footprints made for this board"
== deps dune/lib/dune
library kara_parse (kara.parse)
  libraries: str unix menhirLib
  ppx: ppx_deriving.show ppx_sexp_conv
  flags: ((:standard -w +a-4-40-42-44 -strict-sequence))
menhir ((modules grammar) (flags --explain --table))
ocamllex = lexer
== deps dune/dune-project
lang (dune 3.11)
name = kara
generate_opam_files = true
source ((github karalang/kara-ocaml))
license = BSD-2-Clause
authors = "Kara contributors"
package kara: Tools for the Kara language
  depends ocaml ((>= 4.14))
  depends menhir ((>= 20230608))
  depends ppx_deriving (:with-test)
== packages emacs/archive-contents
archive format 1
magit 20240301.1458 [tar] A Git porcelain inside Emacs.
  needs: emacs 25.1, compat 29.1.4.4, dash 2.19.1, transient 0.5.0, with-editor 3.3.2
  url: https://github.com/magit/magit
  keywords: ("git" "tools" "vc")
dash 20240103.1301 [tar] A modern list library for Emacs
  needs: emacs 24
  url: https://github.com/magnars/dash.el
  keywords: ("extensions" "lisp")
rainbow-delimiters 20210515.1254 [single] Highlight brackets according to their depth
  needs: -
  url: https://github.com/Fanael/rainbow-delimiters
  keywords: ("faces" "convenience" "lisp" "tools")
== customs emacs/custom.el
custom-set-variables:
  column-number-mode = t
  fill-column = 80
  indent-tabs-mode = ()
  package-selected-packages = '(magit dash rainbow-delimiters)
  tab-width = 4
  user-mail-address = "dev@example.org"
custom-set-faces:
  default = ((t (:family "Iosevka" :height 120)))
== smt smt/query.smt2
set-logic (QF_LIA)
declare x : () -> Int
assert (   and   (> x 0)   (< x 10) )
assert (   =   (* 2 x)   7 )
check-sat ()
get-model ()
