car Symbol('dash')
cdr Brackets(I=[[20240103, 1301], [[Symbol('emacs'), [24]]], 'A modern list library for Emacs', Symbol('tar'), [[Symbol(':url'), Symbol('.'), 'https://github.com/magnars/dash.el'], [Symbol(':keywords'), 'extensions', 'lisp']]])
car Symbol('rainbow-delimiters')
