== carcdr corner/dotted.sexp
car Symbol('a')
cdr 1
car Symbol('b')
cdr [2, 3]
car Symbol('c')
cdr [4]
car Symbol('d')
cdr Symbol('e')
car Symbol('.')
cdr [Symbol('g')]
car Symbol('h')
cdr [Symbol('.')]
car Symbol('i')
cdr []
