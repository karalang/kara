fn data_part_3(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("<p>See <a href=\"https://example.org/\">the site</a> and <a href=\"/docs\">the docs</a>.</p>\n");
    t.push_str("<ul><li><A HREF=\"/upper\">shouting</A></li><li><a href=\"/two\">one</a><a href=\"/three\">two</a></li></ul>\n");
    t.push_str("<a href=\"/broken\">no end\n");
    t.push_str("<p>then <a href=\"/later\">later</a></p>\n");
    v.push(DataFile { path: "page.html".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("Shipping #kara today! #compilers #rust_lang and #2024 #über, not a#tag. ##double #\n");
    v.push(DataFile { path: "post.txt".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("Mix 2 cups of flour with 1 cup of milk.\n");
    t.push_str("Add 3 tbsp of sugar, 10 g of salt and 1 pinch of love.\n");
    t.push_str("Bake 25 minutes of time.\n");
    v.push(DataFile { path: "recipe.txt".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("[server]\n");
    t.push_str("host = example.org\n");
    t.push_str("port = 8080\n");
    t.push_str("\n");
    t.push_str("[client]\n");
    t.push_str("retries = 3\n");
    t.push_str("name = kara client\n");
    t.push_str("empty = \n");
    v.push(DataFile { path: "settings.ini".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("given\tstore_sells\tthe store sells {item} at {price:Money} each\n");
    t.push_str("given\tstore_sells_quoted\tthe store sells \"{item}\" at {price:Money} each\n");
    t.push_str("given\tempty_cart\tan empty cart\n");
    t.push_str("when\tadd_one\tI add a {item}\n");
    t.push_str("when\tadd_many\tI add {qty:d} {item}\n");
    t.push_str("when\tremove\tI remove {item}\n");
    t.push_str("when\tapply_code\tI apply the code {code:w}\n");
    t.push_str("then\tcart_count\tthe cart has {n:d} items\n");
    t.push_str("then\ttotal\tthe total is {amount:Money}\n");
    t.push_str("then\tcontains\tthe cart contains {item}\n");
    t.push_str("then\tnot_contains\tthe cart does not contain {item}\n");
    t.push_str("then\ttold\tI am told \"{message}\"\n");
    t.push_str("given\tholds\tthe warehouse holds {qty:d} {item:w}\n");
    t.push_str("when\tarrive\t{qty:d} {item:w} arrive on {day:%Y-%m-%d}\n");
    t.push_str("when\tleave\t{qty:d} {item:w} leave on {day:%Y-%m-%d}\n");
    t.push_str("then\tholds_check\tthe warehouse holds {qty:d} {item:w}\n");
    t.push_str("then\tlast_move\tthe last movement was on {day:%Y-%m-%d}\n");
    t.push_str("then\tout_of_stock\t{item:w} is out of stock\n");
    v.push(DataFile { path: "steps.txt".to_string(), hex: false, body: t });
}
