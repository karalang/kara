// mini_parse: parse 1.22.3, the library that reads values back out of a
// str.format()-style template ("{name} is {age:d}"), as Python 3.13 runs
// it. The template becomes a regular expression, so the regex engine of
// mini_re (Python's re, ported from _parser.py and sre) is here too. On
// top of it are the field parser with its group-name mangling, the format
// spec with fill, alignment, width, grouping and precision, every type
// parse knows (numbers in each base, floats, Decimal, percentages,
// letters and the \w \s \d classes, the seven date and time shapes and
// strftime directives through a port of _strptime), custom types with a
// pattern, Result with its nested names and spans, and search and findall.
//
// The jobs in data/jobs.jsonl parse, search and scan strings and files,
// show the expressions templates turn into, run a BDD suite whose steps
// are matched with parse the way behave matches them, and report on an
// access log and an application log.

// ------------------------------------------------------------ JSON in

// The jobs file holds strings, numbers, booleans, arrays and objects.
#[derive(Clone)]
enum J {
    S(String),
    N(i64),
    A(Vec[J]),
    O(Vec[(String, J)]),
    B(bool),
    Null,
}

fn json_space(c: char) -> bool {
    c == ' ' or c == '\n' or c == '\r' or c == '\t'
}

struct JsonIn {
    cs: Vec[char],
    pos: i64,
}

impl JsonIn {
    fn ws(mut ref self) {
        while self.pos < self.cs.len() and json_space(self.cs[self.pos]) {
            self.pos += 1;
        }
    }

    fn word(mut ref self, w: Str) -> bool {
        let wc: Vec[char] = w.chars().collect();
        if self.pos + wc.len() > self.cs.len() {
            return false;
        }
        let mut k = 0;
        while k < wc.len() {
            if self.cs[self.pos + k] != wc[k] {
                return false;
            }
            k += 1;
        }
        self.pos += wc.len();
        true
    }

    fn hex4(mut ref self) -> u32 {
        let mut n: u32 = 0;
        let mut k = 0;
        while k < 4 {
            let c = self.cs[self.pos];
            let d = if c >= '0' and c <= '9' {
                (c as u32) - ('0' as u32)
            } else if c >= 'a' and c <= 'f' {
                (c as u32) - ('a' as u32) + 10
            } else {
                (c as u32) - ('A' as u32) + 10
            };
            n = n * 16 + d;
            self.pos += 1;
            k += 1;
        }
        n
    }

    fn value(mut ref self) -> Result[J, String] {
        self.ws();
        if self.pos >= self.cs.len() {
            return Err("unexpected end of JSON".to_string());
        }
        let c = self.cs[self.pos];
        if c == '[' {
            self.pos += 1;
            let mut items: Vec[J] = Vec.new();
            self.ws();
            if self.pos < self.cs.len() and self.cs[self.pos] == ']' {
                self.pos += 1;
                return Ok(J.A(items));
            }
            loop {
                items.push(self.value()?);
                self.ws();
                if self.pos >= self.cs.len() {
                    return Err("unterminated JSON array".to_string());
                }
                let d = self.cs[self.pos];
                self.pos += 1;
                if d == ']' {
                    return Ok(J.A(items));
                }
                if d != ',' {
                    return Err(f"bad JSON array separator {d}");
                }
            }
        }
        if c == '{' {
            self.pos += 1;
            let mut members: Vec[(String, J)] = Vec.new();
            self.ws();
            if self.pos < self.cs.len() and self.cs[self.pos] == '}' {
                self.pos += 1;
                return Ok(J.O(members));
            }
            loop {
                let key = match self.value()? {
                    J.S(k) => k,
                    _ => return Err("JSON object key is not a string".to_string()),
                };
                self.ws();
                if self.pos >= self.cs.len() or self.cs[self.pos] != ':' {
                    return Err("missing ':' in JSON object".to_string());
                }
                self.pos += 1;
                let v = self.value()?;
                members.push((key, v));
                self.ws();
                if self.pos >= self.cs.len() {
                    return Err("unterminated JSON object".to_string());
                }
                let d = self.cs[self.pos];
                self.pos += 1;
                if d == '}' {
                    return Ok(J.O(members));
                }
                if d != ',' {
                    return Err(f"bad JSON object separator {d}");
                }
            }
        }
        if self.word("true") {
            return Ok(J.B(true));
        }
        if self.word("false") {
            return Ok(J.B(false));
        }
        if self.word("null") {
            return Ok(J.Null);
        }
        if c == '-' or (c >= '0' and c <= '9') {
            let mut neg = false;
            if c == '-' {
                neg = true;
                self.pos += 1;
            }
            let mut n: i64 = 0;
            while self.pos < self.cs.len() and self.cs[self.pos] >= '0' and self.cs[self.pos] <= '9' {
                n = n * 10 + ((self.cs[self.pos] as u32) - ('0' as u32)) as i64;
                self.pos += 1;
            }
            return Ok(J.N(if neg { -n } else { n }));
        }
        if c != '"' {
            return Err(f"unexpected JSON character {c}");
        }
        self.pos += 1;
        let mut s = String.new();
        while self.pos < self.cs.len() {
            let d = self.cs[self.pos];
            self.pos += 1;
            if d == '"' {
                return Ok(J.S(s));
            }
            if d != '\\' {
                s.push(d);
                continue;
            }
            let e = self.cs[self.pos];
            self.pos += 1;
            if e == 'n' {
                s.push('\n');
            } else if e == 't' {
                s.push('\t');
            } else if e == 'r' {
                s.push('\r');
            } else if e == 'b' {
                s.push('\u{8}');
            } else if e == 'f' {
                s.push('\u{c}');
            } else if e == 'u' {
                let mut n = self.hex4();
                if n >= 0xD800 and n < 0xDC00 {
                    self.pos += 2;
                    let lo = self.hex4();
                    n = 0x10000 + ((n - 0xD800) << 10) + (lo - 0xDC00);
                }
                s.push(char.try_from(n).unwrap_or('?'));
            } else {
                s.push(e);
            }
        }
        Err("unterminated JSON string".to_string())
    }
}

fn json_line(l: ref String) -> Result[J, String] {
    let mut p = JsonIn { cs: l.chars().collect(), pos: 0 };
    p.value()
}

fn j_get(j: ref J, key: Str) -> J {
    match j {
        J.O(members) => {
            for (k, v) in members.iter() {
                if k == key {
                    return v.clone();
                }
            }
            J.Null
        }
        _ => J.Null,
    }
}

fn j_has(j: ref J, key: Str) -> bool {
    match j_get(j, key) {
        J.Null => false,
        _ => true,
    }
}

fn j_str(j: ref J, key: Str) -> String {
    match j_get(j, key) {
        J.S(s) => s,
        _ => String.new(),
    }
}

fn j_int(j: ref J, key: Str, default: i64) -> i64 {
    match j_get(j, key) {
        J.N(n) => n,
        _ => default,
    }
}

fn j_bool(j: ref J, key: Str) -> bool {
    match j_get(j, key) {
        J.B(b) => b,
        _ => false,
    }
}

fn j_strs(j: ref J, key: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    if let J.A(items) = j_get(j, key) {
        for it in items.iter() {
            if let J.S(s) = it {
                out.push(s.clone());
            }
        }
    }
    out
}

// ------------------------------------------------------------ text as code points

fn cps(s: Str) -> Vec[i64] {
    codepoints(s.bytes())
}

fn cps_of(s: ref String) -> Vec[i64] {
    codepoints(s.bytes())
}

fn cat(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut out = a.clone();
    push_all(mut out, b);
    out
}

fn cat_ascii(a: ref Vec[i64], s: Str) -> Vec[i64] {
    let mut out = a.clone();
    push_ascii(mut out, s);
    out
}

fn index_of(s: ref Vec[i64], c: i64) -> i64 {
    let mut i = 0;
    while i < s.len() {
        if s[i] == c {
            return i;
        }
        i += 1;
    }
    -1
}

fn has(s: ref Vec[i64], c: i64) -> bool {
    index_of(s, c) >= 0
}

// `needle in s` for str
fn contains_seq(s: ref Vec[i64], needle: ref Vec[i64]) -> bool {
    find_seq(s, needle, 0) >= 0
}

fn find_seq(s: ref Vec[i64], needle: ref Vec[i64], from: i64) -> i64 {
    let mut i = from;
    while i + needle.len() <= s.len() {
        let mut k = 0;
        while k < needle.len() and s[i + k] == needle[k] {
            k += 1;
        }
        if k == needle.len() {
            return i;
        }
        i += 1;
    }
    -1
}

fn starts_with_seq(s: ref Vec[i64], p: Str) -> bool {
    let n = cps(p);
    if n.len() > s.len() {
        return false;
    }
    let mut k = 0;
    while k < n.len() {
        if s[k] != n[k] {
            return false;
        }
        k += 1;
    }
    true
}

fn eq_ascii(s: ref Vec[i64], p: Str) -> bool {
    same(s, cps(p))
}

// One character in a str of ASCII choices.
fn in_ascii(c: i64, set: Str) -> bool {
    for b in set.bytes() {
        if (b as i64) == c {
            return true;
        }
    }
    false
}

// str.replace
fn replace_seq(s: ref Vec[i64], old: ref Vec[i64], new: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < s.len() {
        if old.len() > 0 and i + old.len() <= s.len() {
            let mut k = 0;
            while k < old.len() and s[i + k] == old[k] {
                k += 1;
            }
            if k == old.len() {
                push_all(mut out, new);
                i += old.len();
                continue;
            }
        }
        out.push(s[i]);
        i += 1;
    }
    out
}

fn replace_char(s: ref Vec[i64], old: i64, new: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s {
        if c == old {
            push_all(mut out, new);
        } else {
            out.push(c);
        }
    }
    out
}

fn repeat(c: i64, n: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < n {
        out.push(c);
        k += 1;
    }
    out
}

// str.split(sep) for a one-character separator
fn split_on(s: ref Vec[i64], sep: i64) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    for c in s {
        if c == sep {
            out.push(cur);
            cur = Vec.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn strip(s: ref Vec[i64]) -> Vec[i64] {
    let mut a = 0;
    let mut b = s.len();
    while a < b and is_space(s[a], false) {
        a += 1;
    }
    while b > a and is_space(s[b - 1], false) {
        b -= 1;
    }
    slice(s, a, b)
}

fn lower_all(s: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s {
        out.push(lower(c, false));
    }
    out
}

fn upper_all(s: ref Vec[i64]) -> Vec[i64] {
    cps_of(to_string(s).to_uppercase())
}

fn is_alpha_cp(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

// str.isupper
fn is_upper_str(s: ref Vec[i64]) -> bool {
    let mut cased = false;
    for c in s {
        if lower(c, false) != c {
            cased = true;
        } else if upper(c, false) != c {
            return false;
        }
    }
    cased
}

// The value of a decimal digit: the decimal digits come in runs of ten.
fn digit_value(c: i64) -> i64 {
    if c < 0x80 {
        return c - 48;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return c - s;
        }
    }
    0
}

// str.isdigit, for the strings date_convert looks at
fn all_decimal(s: ref Vec[i64]) -> bool {
    if s.len() == 0 {
        return false;
    }
    for c in s {
        if not is_decimal(c) {
            return false;
        }
    }
    true
}

fn pad_n(n: i64, width: i64) -> String {
    let mut s = f"{n}";
    while s.len() < width {
        s = f"0{s}";
    }
    s
}

fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

fn floor_mod(a: i64, b: i64) -> i64 {
    a - floor_div(a, b) * b
}
// ------------------------------------------------------------ errors

struct ReErr {
    kind: String,
    msg: String,
    pos: i64,
}

fn re_error(msg: own String, pos: i64) -> ReErr {
    ReErr { kind: "error".to_string(), msg: msg, pos: pos }
}

fn other_error(kind: Str, msg: own String) -> ReErr {
    ReErr { kind: kind.to_string(), msg: msg, pos: -1 }
}

fn err_text(e: ref ReErr) -> String {
    if e.kind == "error" {
        if e.pos >= 0 {
            return f"error: {e.msg} at position {e.pos}";
        }
        return f"error: {e.msg}";
    }
    f"{e.kind}: {e.msg}"
}

// -------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for cp in s {
        if cp < 0x80 {
            out.push(cp as u8);
        } else if cp < 0x800 {
            out.push((0xC0 | (cp >> 6)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else if cp < 0x10000 {
            out.push((0xE0 | (cp >> 12)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (cp >> 18)) as u8);
            out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

fn str_repr(s: ref Vec[i64], out: mut ref Vec[i64]) {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
}

fn repr_of(s: ref Vec[i64]) -> String {
    let mut out: Vec[i64] = Vec.new();
    str_repr(s, mut out);
    to_string(out)
}

// ----------------------------------------------------- character kinds

fn is_decimal(c: i64) -> bool {
    if c < 0x80 {
        return c >= 48 and c <= 57;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return true;
        }
    }
    false
}

fn is_space(c: i64, ascii: bool) -> bool {
    if c == 32 or (c >= 9 and c <= 13) {
        return true;
    }
    if ascii {
        return false;
    }
    (c >= 0x1C and c <= 0x1F) or c == 0x85 or c == 0xA0 or c == 0x1680 or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F or c == 0x3000
}

fn as_char(c: i64) -> Option[char] {
    if c < 0 or (c >= 0xD800 and c <= 0xDFFF) or c > 0x10FFFF {
        return None;
    }
    char.try_from(c as u32).ok()
}

fn is_word(c: i64, ascii: bool) -> bool {
    if c < 0x80 {
        return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
    }
    if ascii {
        return false;
    }
    match as_char(c) {
        Some(ch) => ch.is_alphanumeric(),
        None => false,
    }
}

fn lower(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 65 and c <= 90 { c + 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_lowercase() as u32 as i64,
        None => c,
    }
}

fn upper(c: i64, ascii: bool) -> i64 {
    if c < 0x80 {
        return if c >= 97 and c <= 122 { c - 32 } else { c };
    }
    if ascii {
        return c;
    }
    match as_char(c) {
        Some(ch) => ch.to_uppercase() as u32 as i64,
        None => c,
    }
}

// ------------------------------------------------------- parsed form

// The categories of \d \D \s \S \w \W.
fn cat_digit() -> i64 { 0 }
fn cat_not_digit() -> i64 { 1 }
fn cat_space() -> i64 { 2 }
fn cat_not_space() -> i64 { 3 }
fn cat_word() -> i64 { 4 }
fn cat_not_word() -> i64 { 5 }

// The positions ^ $ \A \Z \b \B and the forms the compiler turns them
// into under MULTILINE.
fn at_beginning() -> i64 { 0 }
fn at_beginning_line() -> i64 { 1 }
fn at_beginning_string() -> i64 { 2 }
fn at_end() -> i64 { 3 }
fn at_end_line() -> i64 { 4 }
fn at_end_string() -> i64 { 5 }
fn at_boundary() -> i64 { 6 }
fn at_non_boundary() -> i64 { 7 }

#[derive(Clone)]
enum Item {
    Lit(i64),
    Range(i64, i64),
    Cat(i64),
}

enum Node {
    Lit(i64),
    NotLit(i64),
    Any,
    In(Vec[Item], bool),
    At(i64),
    Branch(Vec[Vec[Node]]),
    // group (0: none), flags turned on, flags turned off, contents
    Group(i64, i64, i64, Vec[Node]),
    // 0 greedy, 1 lazy, 2 possessive; min; max; the item repeated
    Repeat(i64, i64, i64, Vec[Node]),
    Atomic(Vec[Node]),
    // direction (1 ahead, -1 behind), negative, contents
    Assert(i64, bool, Vec[Node]),
    GroupRef(i64),
    // group, yes branch, no branch
    Exists(i64, Vec[Node], Vec[Node]),
    Failure,
}

fn is_repeat(n: ref Node) -> bool {
    match n {
        Node.Repeat(_, _, _, _) => true,
        _ => false,
    }
}

fn is_at(n: ref Node) -> bool {
    match n {
        Node.At(_) => true,
        _ => false,
    }
}

fn flag_i() -> i64 { 2 }
fn flag_l() -> i64 { 4 }
fn flag_m() -> i64 { 8 }
fn flag_s() -> i64 { 16 }
fn flag_u() -> i64 { 32 }
fn flag_x() -> i64 { 64 }
fn flag_a() -> i64 { 256 }
fn type_flags() -> i64 { 4 | 32 | 256 }
fn maxrepeat() -> i64 { 4294967295 }
fn maxgroups() -> i64 { 1073741823 }
fn maxwidth() -> i64 { 1 << 62 }

fn flag_value(c: i64) -> i64 {
    match c {
        105 => 2,
        76 => 4,
        109 => 8,
        115 => 16,
        120 => 64,
        97 => 256,
        117 => 32,
        _ => 0,
    }
}

// ------------------------------------------------------------ tokens

// One token: nothing at the end of the pattern (n 0), a character (n 1),
// or a backslash and the character after it (n 2).
#[derive(Copy, Clone)]
struct T {
    n: i64,
    a: i64,
    b: i64,
}

fn tok_none() -> T {
    T { n: 0, a: 0, b: 0 }
}

fn tok_is(t: T, c: i64) -> bool {
    t.n == 1 and t.a == c
}

fn tok_text(t: T) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    if t.n >= 1 {
        v.push(t.a);
    }
    if t.n == 2 {
        v.push(t.b);
    }
    v
}

fn is_ascii_letter(c: i64) -> bool {
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

fn is_hex(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
}

fn is_oct(c: i64) -> bool {
    c >= 48 and c <= 55
}

fn is_dec(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn digits_value(s: ref Vec[i64], start: i64, base: i64) -> i64 {
    let mut v = 0;
    let mut i = start;
    while i < s.len() {
        let c = s[i];
        let d = if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 };
        v = v * base + d;
        i += 1;
    }
    v
}

// str.isidentifier, near enough: a letter or underscore, then letters,
// digits and underscores.
fn is_identifier(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    let mut i = 0;
    while i < name.len() {
        let c = name[i];
        let ok = if c == 95 {
            true
        } else if i == 0 {
            match as_char(c) {
                Some(ch) => ch.is_alphabetic(),
                None => false,
            }
        } else {
            is_word(c, false)
        };
        if not ok {
            return false;
        }
        i += 1;
    }
    true
}

fn is_ascii_decimal(name: ref Vec[i64]) -> bool {
    if name.len() == 0 {
        return false;
    }
    for c in name {
        if not is_dec(c) {
            return false;
        }
    }
    true
}

struct Tokenizer {
    s: Vec[i64],
    index: i64,
    next: T,
}

impl Tokenizer {
    fn advance(mut ref self) -> Result[(), ReErr] {
        let index = self.index;
        if index >= self.s.len() {
            self.next = tok_none();
            return Ok(());
        }
        let c = self.s[index];
        if c == 92 {
            if index + 1 >= self.s.len() {
                return Err(re_error("bad escape (end of pattern)".to_string(), self.s.len() - 1));
            }
            self.next = T { n: 2, a: 92, b: self.s[index + 1] };
            self.index = index + 2;
        } else {
            self.next = T { n: 1, a: c, b: 0 };
            self.index = index + 1;
        }
        Ok(())
    }

    fn get(mut ref self) -> Result[T, ReErr] {
        let t = self.next;
        self.advance()?;
        Ok(t)
    }

    fn take(mut ref self, c: i64) -> Result[bool, ReErr] {
        if tok_is(self.next, c) {
            self.advance()?;
            return Ok(true);
        }
        Ok(false)
    }

    fn tell(ref self) -> i64 {
        self.index - self.next.n
    }

    fn seek(mut ref self, index: i64) -> Result[(), ReErr] {
        self.index = index;
        self.advance()
    }

    fn error(ref self, msg: own String, offset: i64) -> ReErr {
        re_error(msg, self.tell() - offset)
    }

    // getwhile: up to n characters of a kind (0 octal, 1 decimal, 2 hex).
    fn getwhile(mut ref self, n: i64, kind: i64, out: mut ref Vec[i64]) -> Result[(), ReErr] {
        let mut k = 0;
        while k < n {
            let t = self.next;
            if t.n != 1 {
                break;
            }
            let ok = if kind == 0 { is_oct(t.a) } else if kind == 1 { is_dec(t.a) } else { is_hex(t.a) };
            if not ok {
                break;
            }
            out.push(t.a);
            self.advance()?;
            k += 1;
        }
        Ok(())
    }

    fn getuntil(mut ref self, terminator: i64, name: Str) -> Result[Vec[i64], ReErr] {
        let mut result: Vec[i64] = Vec.new();
        loop {
            let c = self.next;
            self.advance()?;
            if c.n == 0 {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 0));
                }
                let term = to_string(vec_of(terminator));
                return Err(self.error(f"missing {term}, unterminated name", result.len()));
            }
            if tok_is(c, terminator) {
                if result.len() == 0 {
                    return Err(self.error(f"missing {name}", 1));
                }
                break;
            }
            push_all(mut result, tok_text(c));
        }
        Ok(result)
    }

    fn checkgroupname(ref self, name: ref Vec[i64], offset: i64) -> Result[(), ReErr] {
        if not is_identifier(name) {
            return Err(self.error(f"bad character in group name {repr_of(name)}", name.len() + offset));
        }
        Ok(())
    }
}

fn vec_of(c: i64) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(c);
    v
}

fn new_tokenizer(s: ref Vec[i64]) -> Result[Tokenizer, ReErr] {
    let mut t = Tokenizer { s: s.clone(), index: 0, next: tok_none() };
    t.advance()?;
    Ok(t)
}

// ------------------------------------------------------------ parser

#[derive(Clone)]
struct Width {
    lo: i64,
    hi: i64,
}

struct ParseState {
    flags: i64,
    names: Vec[(Vec[i64], i64)],
    // per group: whether it is closed, and its width
    closed: Vec[bool],
    widths: Vec[Width],
    lookbehind_groups: i64,
    // conditional references by number, in order: (group, position)
    refpos: Vec[(i64, i64)],
}

impl ParseState {
    fn groups(ref self) -> i64 {
        self.closed.len()
    }

    fn group_of(ref self, name: ref Vec[i64]) -> i64 {
        for (n, g) in self.names.iter() {
            if same(n, name) {
                return g;
            }
        }
        -1
    }

    fn checkgroup(ref self, gid: i64) -> bool {
        gid < self.groups() and self.closed[gid]
    }

    fn checklookbehindgroup(ref self, gid: i64, src: ref Tokenizer) -> Result[(), ReErr] {
        if self.lookbehind_groups >= 0 {
            if not self.checkgroup(gid) {
                return Err(src.error("cannot refer to an open group".to_string(), 0));
            }
            if gid >= self.lookbehind_groups {
                return Err(src.error("cannot refer to group defined in the same lookbehind subpattern".to_string(), 0));
            }
        }
        Ok(())
    }
}

fn add_width(a: i64, b: i64) -> i64 {
    if a >= maxwidth() - b { maxwidth() } else { a + b }
}

fn mul_width(a: i64, n: i64) -> i64 {
    if a == 0 or n == 0 {
        0
    } else if a >= maxwidth() / n {
        maxwidth()
    } else {
        a * n
    }
}

// SubPattern.getwidth.
fn width_of(widths: ref Vec[Width], p: ref Vec[Node]) -> Width {
    let mut lo = 0;
    let mut hi = 0;
    for n in p.iter() {
        match n {
            Node.Branch(items) => {
                let mut i = maxwidth();
                let mut j = 0;
                for item in items.iter() {
                    let w = width_of(widths, item);
                    if w.lo < i {
                        i = w.lo;
                    }
                    if w.hi > j {
                        j = w.hi;
                    }
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Atomic(body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Group(_, _, _, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Repeat(_, min, max, body) => {
                let w = width_of(widths, body);
                lo = add_width(lo, mul_width(w.lo, min));
                if max == maxrepeat() and w.hi > 0 {
                    hi = maxwidth();
                } else {
                    hi = add_width(hi, mul_width(w.hi, max));
                }
            }
            Node.GroupRef(g) => {
                let w = ref widths[g];
                lo = add_width(lo, w.lo);
                hi = add_width(hi, w.hi);
            }
            Node.Exists(_, yes, no) => {
                let wy = width_of(widths, yes);
                let mut i = wy.lo;
                let mut j = wy.hi;
                if no.len() > 0 {
                    let wn = width_of(widths, no);
                    if wn.lo < i {
                        i = wn.lo;
                    }
                    if wn.hi > j {
                        j = wn.hi;
                    }
                } else {
                    i = 0;
                }
                lo = add_width(lo, i);
                hi = add_width(hi, j);
            }
            Node.Lit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.NotLit(_) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.Any => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            Node.In(_, _) => {
                lo = add_width(lo, 1);
                hi = add_width(hi, 1);
            }
            _ => {}
        }
    }
    Width { lo: lo, hi: hi }
}

fn category_of(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        100 => 0,
        68 => 1,
        115 => 2,
        83 => 3,
        119 => 4,
        87 => 5,
        _ => -1,
    }
}

fn escape_value(t: T) -> i64 {
    if t.n != 2 {
        return -1;
    }
    match t.b {
        97 => 7,
        98 => 8,
        102 => 12,
        110 => 10,
        114 => 13,
        116 => 9,
        118 => 11,
        92 => 92,
        _ => -1,
    }
}

// \x, \u and \U: the escape text so far, and the code point.
fn hex_escape(src: mut ref Tokenizer, t: T, esc: mut ref Vec[i64]) -> Result[i64, ReErr] {
    let n = if t.b == 120 { 2 } else if t.b == 117 { 4 } else { 8 };
    src.getwhile(n, 2, mut esc)?;
    if esc.len() != n + 2 {
        return Err(src.error(f"incomplete escape {to_string(esc)}", esc.len()));
    }
    let c = digits_value(esc, 2, 16);
    if c > 0x10FFFF {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(c)
}

// _class_escape: an escape inside [...], a literal or a category.
fn class_escape(src: mut ref Tokenizer, t: T) -> Result[Item, ReErr] {
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Item.Lit(e));
    }
    let cat = category_of(t);
    if cat >= 0 {
        return Ok(Item.Cat(cat));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Item.Lit(v));
    }
    if is_oct(c) {
        src.getwhile(2, 0, mut esc)?;
        let v = digits_value(esc, 1, 8);
        if v > 0o377 {
            return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
        }
        return Ok(Item.Lit(v));
    }
    if is_dec(c) or is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Item.Lit(c))
}

// _escape: an escape outside a set.
fn escape(src: mut ref Tokenizer, t: T, st: ref ParseState) -> Result[Node, ReErr] {
    let cat = category_of(t);
    if cat >= 0 {
        let mut items: Vec[Item] = Vec.new();
        items.push(Item.Cat(cat));
        return Ok(Node.In(items, false));
    }
    match t.b {
        65 => return Ok(Node.At(at_beginning_string())),
        98 => return Ok(Node.At(at_boundary())),
        66 => return Ok(Node.At(at_non_boundary())),
        90 => return Ok(Node.At(at_end_string())),
        _ => {}
    }
    let e = escape_value(t);
    if e >= 0 {
        return Ok(Node.Lit(e));
    }
    let c = t.b;
    let mut esc = tok_text(t);
    if c == 120 or c == 117 or c == 85 {
        let v = hex_escape(mut src, t, mut esc)?;
        return Ok(Node.Lit(v));
    }
    if c == 48 {
        src.getwhile(2, 0, mut esc)?;
        return Ok(Node.Lit(digits_value(esc, 1, 8)));
    }
    if is_dec(c) {
        // an octal escape or a group reference
        let nt = src.next;
        if nt.n == 1 and is_dec(nt.a) {
            esc.push(nt.a);
            src.advance()?;
            let nt2 = src.next;
            if is_oct(esc[1]) and is_oct(esc[2]) and nt2.n == 1 and is_oct(nt2.a) {
                esc.push(nt2.a);
                src.advance()?;
                let v = digits_value(esc, 1, 8);
                if v > 0o377 {
                    return Err(src.error(f"octal escape value {to_string(esc)} outside of range 0-0o377", esc.len()));
                }
                return Ok(Node.Lit(v));
            }
        }
        let group = digits_value(esc, 1, 10);
        if group < st.groups() {
            if not st.checkgroup(group) {
                return Err(src.error("cannot refer to an open group".to_string(), esc.len()));
            }
            st.checklookbehindgroup(group, src)?;
            return Ok(Node.GroupRef(group));
        }
        return Err(src.error(f"invalid group reference {group}", esc.len() - 1));
    }
    if is_ascii_letter(c) {
        return Err(src.error(f"bad escape {to_string(esc)}", esc.len()));
    }
    Ok(Node.Lit(c))
}

fn parse_sub(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64) -> Result[Vec[Node], ReErr] {
    let mut items: Vec[Vec[Node]] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let first = nested == 0 and items.len() == 0;
        let item = parse_seq(mut src, mut st, verbose, nested + 1, first)?;
        items.push(item);
        if not src.take(124)? {
            break;
        }
        if nested == 0 {
            verbose = (st.flags & flag_x()) != 0;
        }
    }
    if items.len() == 1 {
        return Ok(items.pop().unwrap());
    }
    let mut out: Vec[Node] = Vec.new();
    out.push(Node.Branch(items));
    Ok(out)
}

// _parse_flags: None (as Err-free Ok(None)) for global flags, else the
// flags turned on and off.
fn parse_flags(src: mut ref Tokenizer, st: mut ref ParseState, first_char: T) -> Result[Option[(i64, i64)], ReErr] {
    let mut ch = first_char;
    let mut add = 0;
    let mut del = 0;
    if not tok_is(ch, 45) {
        loop {
            let flag = flag_value(ch.a);
            if ch.a == 76 {
                return Err(src.error("bad inline flags: cannot use 'L' flag with a str pattern".to_string(), 0));
            }
            add = add | flag;
            if (flag & type_flags()) != 0 and (add & type_flags()) != flag {
                return Err(src.error("bad inline flags: flags 'a', 'u' and 'L' are incompatible".to_string(), 0));
            }
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing -, : or )".to_string(), 0));
            }
            if tok_is(ch, 41) or tok_is(ch, 45) or tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing -, : or )" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if tok_is(ch, 41) {
        st.flags = st.flags | add;
        return Ok(None);
    }
    if tok_is(ch, 45) {
        ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("missing flag".to_string(), 0));
        }
        if ch.n != 1 or flag_value(ch.a) == 0 {
            let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing flag" };
            return Err(src.error(msg.to_string(), ch.n));
        }
        loop {
            let flag = flag_value(ch.a);
            if (flag & type_flags()) != 0 {
                return Err(src.error("bad inline flags: cannot turn off flags 'a', 'u' and 'L'".to_string(), 0));
            }
            del = del | flag;
            ch = src.get()?;
            if ch.n == 0 {
                return Err(src.error("missing :".to_string(), 0));
            }
            if tok_is(ch, 58) {
                break;
            }
            if ch.n != 1 or flag_value(ch.a) == 0 {
                let msg = if ch.n == 1 and is_alpha(ch.a) { "unknown flag" } else { "missing :" };
                return Err(src.error(msg.to_string(), ch.n));
            }
        }
    }
    if (add & del) != 0 {
        return Err(src.error("bad inline flags: flag turned on and off".to_string(), 1));
    }
    Ok(Some((add, del)))
}

fn is_alpha(c: i64) -> bool {
    match as_char(c) {
        Some(ch) => ch.is_alphabetic(),
        None => false,
    }
}

fn parse_set(src: mut ref Tokenizer, out: mut ref Vec[Node]) -> Result[(), ReErr] {
    let here = src.tell() - 1;
    let mut set: Vec[Item] = Vec.new();
    let negate = src.take(94)?;
    loop {
        let this = src.get()?;
        if this.n == 0 {
            return Err(src.error("unterminated character set".to_string(), src.tell() - here));
        }
        if tok_is(this, 93) and set.len() > 0 {
            break;
        }
        let code1 = if this.n == 2 { class_escape(mut src, this)? } else { Item.Lit(this.a) };
        if src.take(45)? {
            let that = src.get()?;
            if that.n == 0 {
                return Err(src.error("unterminated character set".to_string(), src.tell() - here));
            }
            if tok_is(that, 93) {
                set.push(code1);
                set.push(Item.Lit(45));
                break;
            }
            let code2 = if that.n == 2 { class_escape(mut src, that)? } else { Item.Lit(that.a) };
            let text = f"{to_string(tok_text(this))}-{to_string(tok_text(that))}";
            let offset = this.n + 1 + that.n;
            let lo = match code1 {
                Item.Lit(c) => c,
                _ => -1,
            };
            let hi = match code2 {
                Item.Lit(c) => c,
                _ => -1,
            };
            if lo < 0 or hi < 0 or hi < lo {
                return Err(src.error(f"bad character range {text}", offset));
            }
            set.push(Item.Range(lo, hi));
        } else {
            set.push(code1);
        }
    }
    if set.len() == 1 {
        let only = ref set[0];
        if let Item.Lit(c) = only {
            if negate {
                out.push(Node.NotLit(c));
            } else {
                out.push(Node.Lit(c));
            }
            return Ok(());
        }
    }
    out.push(Node.In(set, negate));
    Ok(())
}

// The quantifier just read (its first character is `this`), applied to
// the last item. Returns false when `{` turned out to be a literal.
fn parse_repeat(src: mut ref Tokenizer, this: T, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let here = src.tell();
    let mut min = 0;
    let mut max = maxrepeat();
    if tok_is(this, 63) {
        max = 1;
    } else if tok_is(this, 43) {
        min = 1;
    } else if tok_is(this, 123) {
        if tok_is(src.next, 125) {
            out.push(Node.Lit(123));
            return Ok(false);
        }
        let mut lo: Vec[i64] = Vec.new();
        let mut hi: Vec[i64] = Vec.new();
        while src.next.n == 1 and is_dec(src.next.a) {
            lo.push(src.get()?.a);
        }
        if src.take(44)? {
            while src.next.n == 1 and is_dec(src.next.a) {
                hi.push(src.get()?.a);
            }
        } else {
            hi = lo.clone();
        }
        if not src.take(125)? {
            out.push(Node.Lit(123));
            src.seek(here)?;
            return Ok(false);
        }
        if lo.len() > 0 {
            if lo.len() > 10 or digits_value(lo, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            min = digits_value(lo, 0, 10);
        }
        if hi.len() > 0 {
            if hi.len() > 10 or digits_value(hi, 0, 10) >= maxrepeat() {
                return Err(other_error("OverflowError", "the repetition number is too large".to_string()));
            }
            max = digits_value(hi, 0, 10);
            if max < min {
                return Err(src.error("min repeat greater than max repeat".to_string(), src.tell() - here));
            }
        }
    }
    if out.len() == 0 or is_at(out[out.len() - 1]) {
        return Err(src.error("nothing to repeat".to_string(), src.tell() - here + 1));
    }
    if is_repeat(out[out.len() - 1]) {
        return Err(src.error("multiple repeat".to_string(), src.tell() - here + 1));
    }
    let last = out.pop().unwrap();
    let mut body: Vec[Node] = Vec.new();
    match last {
        Node.Group(0, 0, 0, p) => body = p,
        other => body.push(other),
    }
    let kind = if src.take(63)? { 1 } else if src.take(43)? { 2 } else { 0 };
    out.push(Node.Repeat(kind, min, max, body));
    Ok(true)
}

fn parse_seq(src: mut ref Tokenizer, st: mut ref ParseState, verbose0: bool, nested: i64, first: bool) -> Result[Vec[Node], ReErr] {
    let mut out: Vec[Node] = Vec.new();
    let mut verbose = verbose0;
    loop {
        let this = src.next;
        if this.n == 0 or tok_is(this, 124) or tok_is(this, 41) {
            break;
        }
        src.advance()?;
        if verbose {
            if this.n == 1 and (this.a == 32 or (this.a >= 9 and this.a <= 13)) {
                continue;
            }
            if tok_is(this, 35) {
                loop {
                    let t = src.get()?;
                    if t.n == 0 or tok_is(t, 10) {
                        break;
                    }
                }
                continue;
            }
        }
        if this.n == 2 {
            let node = escape(mut src, this, st)?;
            out.push(node);
            continue;
        }
        let c = this.a;
        if c == 91 {
            parse_set(mut src, mut out)?;
        } else if c == 42 or c == 43 or c == 63 or c == 123 {
            parse_repeat(mut src, this, mut out)?;
        } else if c == 46 {
            out.push(Node.Any);
        } else if c == 94 {
            out.push(Node.At(at_beginning()));
        } else if c == 36 {
            out.push(Node.At(at_end()));
        } else if c == 40 {
            if parse_group(mut src, mut st, mut verbose, nested, first, mut out)? {
                continue;
            }
        } else {
            out.push(Node.Lit(c));
        }
    }
    Ok(out)
}

// `(` and what follows. Returns true for a construct that adds nothing
// (a comment, global flags).
fn parse_group(src: mut ref Tokenizer, st: mut ref ParseState, verbose: mut ref bool, nested: i64, first: bool, out: mut ref Vec[Node]) -> Result[bool, ReErr] {
    let start = src.tell() - 1;
    let mut capture = true;
    let mut atomic = false;
    let mut name: Vec[i64] = Vec.new();
    let mut named = false;
    let mut add = 0;
    let mut del = 0;
    if src.take(63)? {
        let ch = src.get()?;
        if ch.n == 0 {
            return Err(src.error("unexpected end of pattern".to_string(), 0));
        }
        if tok_is(ch, 80) {
            if src.take(60)? {
                name = src.getuntil(62, "group name")?;
                src.checkgroupname(name, 1)?;
                named = true;
            } else if src.take(61)? {
                let ref_name = src.getuntil(41, "group name")?;
                src.checkgroupname(ref_name, 1)?;
                let gid = st.group_of(ref_name);
                if gid < 0 {
                    return Err(src.error(f"unknown group name {repr_of(ref_name)}", ref_name.len() + 1));
                }
                if not st.checkgroup(gid) {
                    return Err(src.error("cannot refer to an open group".to_string(), ref_name.len() + 1));
                }
                st.checklookbehindgroup(gid, src)?;
                out.push(Node.GroupRef(gid));
                return Ok(true);
            } else {
                let c2 = src.get()?;
                if c2.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                return Err(src.error(f"unknown extension ?P{to_string(tok_text(c2))}", c2.n + 2));
            }
        } else if tok_is(ch, 58) {
            capture = false;
        } else if tok_is(ch, 35) {
            loop {
                if src.next.n == 0 {
                    return Err(src.error("missing ), unterminated comment".to_string(), src.tell() - start));
                }
                if tok_is(src.get()?, 41) {
                    break;
                }
            }
            return Ok(true);
        } else if tok_is(ch, 61) or tok_is(ch, 33) or tok_is(ch, 60) {
            let mut kind = ch;
            let mut dir = 1;
            let mut outer_lookbehind = 0;
            if tok_is(ch, 60) {
                kind = src.get()?;
                if kind.n == 0 {
                    return Err(src.error("unexpected end of pattern".to_string(), 0));
                }
                if not (tok_is(kind, 61) or tok_is(kind, 33)) {
                    return Err(src.error(f"unknown extension ?<{to_string(tok_text(kind))}", kind.n + 2));
                }
                dir = -1;
                outer_lookbehind = st.lookbehind_groups;
                if outer_lookbehind < 0 {
                    st.lookbehind_groups = st.groups();
                }
            }
            let p = parse_sub(mut src, mut st, *verbose, nested + 1)?;
            if dir < 0 and outer_lookbehind < 0 {
                st.lookbehind_groups = -1;
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            if tok_is(kind, 61) {
                out.push(Node.Assert(dir, false, p));
            } else if p.len() > 0 {
                out.push(Node.Assert(dir, true, p));
            } else {
                out.push(Node.Failure);
            }
            return Ok(true);
        } else if tok_is(ch, 40) {
            let condname = src.getuntil(41, "group name")?;
            let mut condgroup = 0;
            if not is_ascii_decimal(condname) {
                src.checkgroupname(condname, 1)?;
                condgroup = st.group_of(condname);
                if condgroup < 0 {
                    return Err(src.error(f"unknown group name {repr_of(condname)}", condname.len() + 1));
                }
            } else {
                if condname.len() > 10 {
                    return Err(src.error(f"invalid group reference {to_string(condname)}", condname.len() + 1));
                }
                condgroup = digits_value(condname, 0, 10);
                if condgroup == 0 {
                    return Err(src.error("bad group number".to_string(), condname.len() + 1));
                }
                if condgroup >= maxgroups() {
                    return Err(src.error(f"invalid group reference {condgroup}", condname.len() + 1));
                }
                let mut seen = false;
                for (g, _) in st.refpos.iter() {
                    if g == condgroup {
                        seen = true;
                    }
                }
                if not seen {
                    st.refpos.push((condgroup, src.tell() - condname.len() - 1));
                }
            }
            st.checklookbehindgroup(condgroup, src)?;
            let yes = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
            let mut no: Vec[Node] = Vec.new();
            if src.take(124)? {
                no = parse_seq(mut src, mut st, *verbose, nested + 1, false)?;
                if tok_is(src.next, 124) {
                    return Err(src.error("conditional backref with more than two branches".to_string(), 0));
                }
            }
            if not src.take(41)? {
                return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
            }
            out.push(Node.Exists(condgroup, yes, no));
            return Ok(true);
        } else if tok_is(ch, 62) {
            capture = false;
            atomic = true;
        } else if (ch.n == 1 and flag_value(ch.a) != 0) or tok_is(ch, 45) {
            match parse_flags(mut src, mut st, ch)? {
                None => {
                    if not first or out.len() > 0 {
                        return Err(src.error("global flags not at the start of the expression".to_string(), src.tell() - start));
                    }
                    *verbose = (st.flags & flag_x()) != 0;
                    return Ok(true);
                }
                Some((a, d)) => {
                    add = a;
                    del = d;
                    capture = false;
                }
            }
        } else {
            return Err(src.error(f"unknown extension ?{to_string(tok_text(ch))}", ch.n + 1));
        }
    }
    let mut group = 0;
    if capture {
        group = st.groups();
        st.closed.push(false);
        st.widths.push(Width { lo: 0, hi: 0 });
        if named {
            let was = st.group_of(name);
            if was >= 0 {
                return Err(src.error(f"redefinition of group name {repr_of(name)} as group {group}; was group {was}", name.len() + 1));
            }
            st.names.push((name.clone(), group));
        }
    }
    let sub_verbose = (*verbose or (add & flag_x()) != 0) and (del & flag_x()) == 0;
    let p = parse_sub(mut src, mut st, sub_verbose, nested + 1)?;
    if not src.take(41)? {
        return Err(src.error("missing ), unterminated subpattern".to_string(), src.tell() - start));
    }
    if group > 0 {
        let w = width_of(st.widths, p);
        st.widths[group] = w;
        st.closed[group] = true;
    }
    if atomic {
        out.push(Node.Atomic(p));
    } else {
        out.push(Node.Group(group, add, del, p));
    }
    Ok(false)
}

struct Parsed {
    nodes: Vec[Node],
    flags: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
    widths: Vec[Width],
}

fn parse(pattern: ref Vec[i64], flags: i64) -> Result[Parsed, ReErr] {
    let mut src = new_tokenizer(pattern)?;
    let mut st = ParseState {
        flags: flags,
        names: Vec.new(),
        closed: Vec.new(),
        widths: Vec.new(),
        lookbehind_groups: -1,
        refpos: Vec.new(),
    };
    // group 0 is the whole match
    st.closed.push(true);
    st.widths.push(Width { lo: 0, hi: 0 });
    let nodes = parse_sub(mut src, mut st, (flags & flag_x()) != 0, 0)?;
    if (st.flags & flag_a()) != 0 and (st.flags & flag_u()) != 0 {
        return Err(other_error("ValueError", "ASCII and UNICODE flags are incompatible".to_string()));
    }
    if src.next.n != 0 {
        return Err(src.error("unbalanced parenthesis".to_string(), 0));
    }
    for (g, pos) in st.refpos.iter() {
        if g >= st.groups() {
            return Err(re_error(f"invalid group reference {g}", pos));
        }
    }
    let groups = st.groups() - 1;
    Ok(Parsed { nodes: nodes, flags: st.flags, groups: groups, names: st.names, widths: st.widths })
}

// ---------------------------------------------------------- compiler

enum Op {
    // character (lowered when case-insensitive), case-insensitive, ASCII
    Lit(i64, bool, bool),
    NotLit(i64, bool, bool),
    Any,
    AnyAll,
    // set, case-insensitive, ASCII-only categories
    In(i64, bool, bool),
    // anchor kind, ASCII-only word boundary
    At(i64, bool),
    Mark(i64),
    Split(i64, i64),
    Jmp(i64),
    // repeat register, the Until it starts at
    RepInit(i64, i64),
    // register, min, max, greedy, body, exit
    Until(i64, i64, i64, bool, i64, i64),
    Ref(i64, bool, bool),
    // lookbehind width (-1 for lookahead), negative, sub-program, next
    Look(i64, bool, i64, i64),
    Atomic(i64, i64),
    Exists(i64, i64),
    Fail,
    Succeed,
    Match,
}

struct Program {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
    groups: i64,
    names: Vec[(Vec[i64], i64)],
}

struct CharSet {
    items: Vec[Item],
    negate: bool,
}

fn combine(flags: i64, add: i64, del: i64) -> i64 {
    let mut f = flags;
    if (add & type_flags()) != 0 {
        f = f & (0x7FFFFFFF ^ type_flags());
    }
    (f | add) & (0x7FFFFFFF ^ del)
}

struct Compiler {
    ops: Vec[Op],
    sets: Vec[CharSet],
    repeats: i64,
}

impl Compiler {
    fn emit(mut ref self, op: own Op) -> i64 {
        self.ops.push(op);
        self.ops.len() - 1
    }

    fn here(ref self) -> i64 {
        self.ops.len()
    }

    fn compile(mut ref self, p: ref Parsed, nodes: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let icase = (flags & flag_i()) != 0;
        let ascii = (flags & flag_a()) != 0;
        for n in nodes.iter() {
            match n {
                Node.Lit(c) => {
                    let v = if icase { lower(c, ascii) } else { c };
                    self.emit(Op.Lit(v, icase, ascii));
                }
                Node.NotLit(c) => {
                    let v = if icase { lower(c, ascii) } else { c };
                    self.emit(Op.NotLit(v, icase, ascii));
                }
                Node.Any => {
                    if (flags & flag_s()) != 0 {
                        self.emit(Op.AnyAll);
                    } else {
                        self.emit(Op.Any);
                    }
                }
                Node.In(items, negate) => {
                    self.sets.push(CharSet { items: items.clone(), negate: negate });
                    let idx = self.sets.len() - 1;
                    self.emit(Op.In(idx, icase, ascii));
                }
                Node.At(kind) => {
                    let mut k = kind;
                    if (flags & flag_m()) != 0 {
                        if k == at_beginning() {
                            k = at_beginning_line();
                        } else if k == at_end() {
                            k = at_end_line();
                        }
                    }
                    self.emit(Op.At(k, ascii));
                }
                Node.Branch(items) => {
                    let mut ends: Vec[i64] = Vec.new();
                    let mut i = 0;
                    while i < items.len() {
                        if i + 1 < items.len() {
                            let split = self.emit(Op.Fail);
                            self.compile(p, items[i], flags)?;
                            ends.push(self.emit(Op.Fail));
                            let next = self.here();
                            self.ops[split] = Op.Split(split + 1, next);
                        } else {
                            self.compile(p, items[i], flags)?;
                        }
                        i += 1;
                    }
                    let end = self.here();
                    for at in ends {
                        self.ops[at] = Op.Jmp(end);
                    }
                }
                Node.Group(g, add, off, body) => {
                    if g > 0 {
                        self.emit(Op.Mark(2 * g));
                    }
                    self.compile(p, body, combine(flags, add, off))?;
                    if g > 0 {
                        self.emit(Op.Mark(2 * g + 1));
                    }
                }
                Node.Repeat(kind, min, max, body) => {
                    if kind == 2 {
                        let at = self.emit(Op.Fail);
                        self.compile_repeat(p, min, max, true, body, flags)?;
                        self.emit(Op.Succeed);
                        let next = self.here();
                        self.ops[at] = Op.Atomic(at + 1, next);
                    } else {
                        self.compile_repeat(p, min, max, kind == 0, body, flags)?;
                    }
                }
                Node.Atomic(body) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Atomic(at + 1, next);
                }
                Node.Assert(dir, negative, body) => {
                    let mut width = -1;
                    if dir < 0 {
                        let w = width_of(p.widths, body);
                        if w.lo != w.hi {
                            return Err(other_error("error", "look-behind requires fixed-width pattern".to_string()));
                        }
                        width = w.lo;
                    }
                    let at = self.emit(Op.Fail);
                    self.compile(p, body, flags)?;
                    self.emit(Op.Succeed);
                    let next = self.here();
                    self.ops[at] = Op.Look(width, negative, at + 1, next);
                }
                Node.GroupRef(g) => {
                    self.emit(Op.Ref(g, icase, ascii));
                }
                Node.Exists(g, yes, no) => {
                    let at = self.emit(Op.Fail);
                    self.compile(p, yes, flags)?;
                    if no.len() > 0 {
                        let jump = self.emit(Op.Fail);
                        let no_pc = self.here();
                        self.compile(p, no, flags)?;
                        let end = self.here();
                        self.ops[jump] = Op.Jmp(end);
                        self.ops[at] = Op.Exists(g, no_pc);
                    } else {
                        let end = self.here();
                        self.ops[at] = Op.Exists(g, end);
                    }
                }
                Node.Failure => {
                    self.emit(Op.Fail);
                }
            }
        }
        Ok(())
    }

    fn compile_repeat(mut ref self, p: ref Parsed, min: i64, max: i64, greedy: bool, body: ref Vec[Node], flags: i64) -> Result[(), ReErr] {
        let r = self.repeats;
        self.repeats += 1;
        let init = self.emit(Op.Fail);
        self.compile(p, body, flags)?;
        let until = self.emit(Op.Fail);
        self.ops[init] = Op.RepInit(r, until);
        self.ops[until] = Op.Until(r, min, max, greedy, init + 1, until + 1);
        Ok(())
    }
}

fn compile(pattern: ref Vec[i64], flags: i64) -> Result[Program, ReErr] {
    let p = parse(pattern, flags)?;
    let mut c = Compiler { ops: Vec.new(), sets: Vec.new(), repeats: 0 };
    c.compile(p, p.nodes, p.flags)?;
    c.emit(Op.Match);
    Ok(Program { ops: c.ops, sets: c.sets, repeats: c.repeats, groups: p.groups, names: p.names })
}

// ----------------------------------------------------------- matcher

struct Undo {
    kind: i64,
    idx: i64,
    old: i64,
}

struct Choice {
    pc: i64,
    pos: i64,
    trail: i64,
    // 0: resume at pc; 1: a lazy repeat's Until, after its tail failed
    mode: i64,
}

struct Matcher {
    s: Vec[i64],
    marks: Vec[i64],
    counts: Vec[i64],
    lasts: Vec[i64],
    lastindex: i64,
    trail: Vec[Undo],
    start: i64,
    must_advance: bool,
    match_all: bool,
}

impl Matcher {
    fn set_mark(mut ref self, slot: i64, v: i64) {
        self.trail.push(Undo { kind: 0, idx: slot, old: self.marks[slot] });
        self.marks[slot] = v;
    }

    fn set_count(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 1, idx: r, old: self.counts[r] });
        self.counts[r] = v;
    }

    fn set_last(mut ref self, r: i64, v: i64) {
        self.trail.push(Undo { kind: 2, idx: r, old: self.lasts[r] });
        self.lasts[r] = v;
    }

    fn set_lastindex(mut ref self, v: i64) {
        self.trail.push(Undo { kind: 3, idx: 0, old: self.lastindex });
        self.lastindex = v;
    }

    fn undo_to(mut ref self, len: i64) {
        while self.trail.len() > len {
            let u = self.trail.pop().unwrap();
            if u.kind == 0 {
                self.marks[u.idx] = u.old;
            } else if u.kind == 1 {
                self.counts[u.idx] = u.old;
            } else if u.kind == 2 {
                self.lasts[u.idx] = u.old;
            } else {
                self.lastindex = u.old;
            }
        }
    }

    // A group that has both marks, the end not before the start.
    fn group_span(ref self, g: i64) -> (i64, i64) {
        let a = self.marks[2 * g];
        let b = self.marks[2 * g + 1];
        if a < 0 or b < 0 or b < a {
            return (-1, -1);
        }
        (a, b)
    }

    fn at(ref self, kind: i64, ascii: bool, pos: i64) -> bool {
        let n = self.s.len();
        if kind == 0 or kind == 2 {
            return pos == 0;
        }
        if kind == 1 {
            return pos == 0 or self.s[pos - 1] == 10;
        }
        if kind == 3 {
            return pos == n or (pos == n - 1 and self.s[pos] == 10);
        }
        if kind == 4 {
            return pos == n or self.s[pos] == 10;
        }
        if kind == 5 {
            return pos == n;
        }
        if n == 0 {
            return false;
        }
        let before = pos > 0 and is_word(self.s[pos - 1], ascii);
        let after = pos < n and is_word(self.s[pos], ascii);
        if kind == 6 { before != after } else { before == after }
    }

    // Runs the program from pc at pos, backtracking through its own
    // choices only. Returns where it succeeded, or -1.
    fn run(mut ref self, prog: ref Program, pc0: i64, pos0: i64, top: bool) -> i64 {
        let base = self.trail.len();
        let mut choices: Vec[Choice] = Vec.new();
        let mut pc = pc0;
        let mut pos = pos0;
        let mut mode = 0;
        loop {
            let mut ok = true;
            let op = ref prog.ops[pc];
            if mode == 1 {
                // a lazy repeat whose tail failed: try one more item
                mode = 0;
                ok = false;
                if let Op.Until(r, _, max, _, body, _) = op {
                    let count = self.counts[r] + 1;
                    if not ((count >= max and max != maxrepeat()) or pos == self.lasts[r]) {
                        self.set_count(r, count);
                        self.set_last(r, pos);
                        pc = body;
                        ok = true;
                    }
                }
                if ok {
                    continue;
                }
            } else {
                match op {
                    Op.Lit(c, icase, ascii) => {
                        if pos < self.s.len() and (if icase { lower(self.s[pos], ascii) == c } else { self.s[pos] == c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.NotLit(c, icase, ascii) => {
                        if pos < self.s.len() and (if icase { lower(self.s[pos], ascii) != c } else { self.s[pos] != c }) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Any => {
                        if pos < self.s.len() and self.s[pos] != 10 {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.AnyAll => {
                        if pos < self.s.len() {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.In(set, icase, ascii) => {
                        if pos < self.s.len() and in_set(prog.sets[set], self.s[pos], icase, ascii) {
                            pos += 1;
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.At(kind, ascii) => {
                        if self.at(kind, ascii, pos) {
                            pc += 1;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Mark(slot) => {
                        self.set_mark(slot, pos);
                        if (slot & 1) == 1 {
                            self.set_lastindex(slot / 2);
                        }
                        pc += 1;
                    }
                    Op.Split(a, b) => {
                        choices.push(Choice { pc: b, pos: pos, trail: self.trail.len(), mode: 0 });
                        pc = a;
                    }
                    Op.Jmp(a) => pc = a,
                    Op.RepInit(r, until) => {
                        self.set_count(r, -1);
                        self.set_last(r, -1);
                        pc = until;
                    }
                    Op.Until(r, min, max, greedy, body, exit) => {
                        let count = self.counts[r] + 1;
                        if count < min {
                            self.set_count(r, count);
                            pc = body;
                        } else if greedy {
                            if (count < max or max == maxrepeat()) and pos != self.lasts[r] {
                                choices.push(Choice { pc: exit, pos: pos, trail: self.trail.len(), mode: 0 });
                                self.set_count(r, count);
                                self.set_last(r, pos);
                                pc = body;
                            } else {
                                pc = exit;
                            }
                        } else {
                            choices.push(Choice { pc: pc, pos: pos, trail: self.trail.len(), mode: 1 });
                            pc = exit;
                        }
                    }
                    Op.Ref(g, icase, ascii) => {
                        let (a, b) = self.group_span(g);
                        if a < 0 {
                            ok = false;
                        } else {
                            let len = b - a;
                            if pos + len > self.s.len() {
                                ok = false;
                            } else {
                                let mut k = 0;
                                while k < len {
                                    let x = self.s[a + k];
                                    let y = self.s[pos + k];
                                    let eq = if icase { lower(x, ascii) == lower(y, ascii) } else { x == y };
                                    if not eq {
                                        ok = false;
                                        break;
                                    }
                                    k += 1;
                                }
                                if ok {
                                    pos += len;
                                    pc += 1;
                                }
                            }
                        }
                    }
                    Op.Look(width, negative, sub, next) => {
                        let mark = self.trail.len();
                        let from = if width < 0 { pos } else { pos - width };
                        let found = from >= 0 and self.run(prog, sub, from, false) >= 0;
                        if negative {
                            self.undo_to(mark);
                            if found {
                                ok = false;
                            } else {
                                pc = next;
                            }
                        } else if found {
                            pc = next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Atomic(sub, next) => {
                        let end = self.run(prog, sub, pos, false);
                        if end >= 0 {
                            pos = end;
                            pc = next;
                        } else {
                            ok = false;
                        }
                    }
                    Op.Exists(g, no) => {
                        let (a, _) = self.group_span(g);
                        if a >= 0 {
                            pc += 1;
                        } else {
                            pc = no;
                        }
                    }
                    Op.Fail => ok = false,
                    Op.Succeed => return pos,
                    Op.Match => {
                        if top and ((self.match_all and pos != self.s.len()) or (self.must_advance and pos == self.start)) {
                            ok = false;
                        } else {
                            return pos;
                        }
                    }
                }
            }
            if not ok {
                match choices.pop() {
                    Some(ch) => {
                        self.undo_to(ch.trail);
                        pc = ch.pc;
                        pos = ch.pos;
                        mode = ch.mode;
                    }
                    None => {
                        self.undo_to(base);
                        return -1;
                    }
                }
            }
        }
    }
}

fn in_items(set: ref CharSet, c: i64, ascii: bool) -> bool {
    for item in set.items.iter() {
        let hit = match item {
            Item.Lit(l) => c == l,
            Item.Range(lo, hi) => c >= lo and c <= hi,
            Item.Cat(k) => {
                let kind = k;
                if kind == 0 {
                    if ascii { c >= 48 and c <= 57 } else { is_decimal(c) }
                } else if kind == 1 {
                    if ascii { not (c >= 48 and c <= 57) } else { not is_decimal(c) }
                } else if kind == 2 {
                    is_space(c, ascii)
                } else if kind == 3 {
                    not is_space(c, ascii)
                } else if kind == 4 {
                    is_word(c, ascii)
                } else {
                    not is_word(c, ascii)
                }
            }
        };
        if hit {
            return true;
        }
    }
    false
}

// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = lower(c, ascii);
        if lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program, s: ref Vec[i64]) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        s: s.clone(),
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn find(m: mut ref Matcher, prog: ref Program, from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= m.s.len() {
        let mut k = 0;
        while k < m.marks.len() {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}

// All the matches finditer gives: each search starts where the last
// match ended, and must move on past an empty one.
fn all_matches(prog: ref Program, s: ref Vec[i64], limit: i64) -> Vec[Found] {
    let mut m = new_matcher(prog, s);
    let mut out: Vec[Found] = Vec.new();
    let mut pos = 0;
    let mut must_advance = false;
    while pos <= s.len() and (limit == 0 or out.len() < limit) {
        match find(mut m, prog, pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    out
}

// ------------------------------------------------------------ Python values

// An exception as Python prints it: "ValueError: ...".
struct PyErr {
    kind: String,
    msg: String,
}

fn py_err(kind: Str, msg: own String) -> PyErr {
    PyErr { kind: kind.to_string(), msg: msg }
}

fn value_error(msg: own String) -> PyErr {
    py_err("ValueError", msg)
}

fn err_line(e: ref PyErr) -> String {
    f"{e.kind}: {e.msg}"
}

// A tzinfo: parse's FixedTzOffset (fixed is true, with the name it was
// given), or datetime.timezone from strptime's %z.
#[derive(Clone)]
struct Tz {
    fixed: bool,
    name: Vec[i64],
    // the offset in microseconds east of UTC
    us: i64,
}

#[derive(Clone)]
struct Moment {
    y: i64,
    mo: i64,
    d: i64,
    h: i64,
    mi: i64,
    s: i64,
    us: i64,
    tz: Option[Tz],
}

#[derive(Clone)]
enum Val {
    None,
    Bool(bool),
    Int(i64),
    Float(f64),
    Str(Vec[i64]),
    // the text inside Decimal('...')
    Dec(String),
    Tuple(Vec[Val]),
    List(Vec[Val]),
    Dict(Vec[(Vec[i64], Val)]),
    DateTime(Moment),
    Date(i64, i64, i64),
    // a time is a Moment whose date is not shown
    Time(Moment),
}

fn type_name(v: ref Val) -> Str {
    match v {
        Val.None => "NoneType",
        Val.Bool(_) => "bool",
        Val.Int(_) => "int",
        Val.Float(_) => "float",
        Val.Str(_) => "str",
        Val.Dec(_) => "decimal.Decimal",
        Val.Tuple(_) => "tuple",
        Val.List(_) => "list",
        Val.Dict(_) => "dict",
        Val.DateTime(_) => "datetime.datetime",
        Val.Date(_, _, _) => "datetime.date",
        Val.Time(_) => "datetime.time",
    }
}

fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    if x == 1.0 / 0.0 {
        return "inf".to_string();
    }
    if x == -1.0 / 0.0 {
        return "-inf".to_string();
    }
    if x == 0.0 {
        return if x.to_bits() >> 63 == 1 { "-0.0".to_string() } else { "0.0".to_string() };
    }
    f"{x}"
}

// str(timedelta(microseconds=us))
fn td_str(us: i64) -> String {
    let days = floor_div(us, 86400000000);
    let rest = us - days * 86400000000;
    let secs = rest / 1000000;
    let micro = rest % 1000000;
    let mut s = f"{secs / 3600}:{pad_n((secs / 60) % 60, 2)}:{pad_n(secs % 60, 2)}";
    if micro != 0 {
        s = f"{s}.{pad_n(micro, 6)}";
    }
    if days != 0 {
        let plural = if days == 1 or days == -1 { "" } else { "s" };
        s = f"{days} day{plural}, {s}";
    }
    s
}

// repr(timedelta(microseconds=us))
fn td_repr(us: i64) -> String {
    let days = floor_div(us, 86400000000);
    let rest = us - days * 86400000000;
    let secs = rest / 1000000;
    let micro = rest % 1000000;
    let mut parts: Vec[String] = Vec.new();
    if days != 0 {
        parts.push(f"days={days}");
    }
    if secs != 0 {
        parts.push(f"seconds={secs}");
    }
    if micro != 0 {
        parts.push(f"microseconds={micro}");
    }
    if parts.len() == 0 {
        return "datetime.timedelta(0)".to_string();
    }
    f"datetime.timedelta({parts.join(", ")})"
}

fn tz_repr(t: ref Tz) -> String {
    if t.fixed {
        return f"<FixedTzOffset {to_string(t.name)} {td_str(t.us)}>";
    }
    if t.us == 0 {
        return "datetime.timezone.utc".to_string();
    }
    f"datetime.timezone({td_repr(t.us)})"
}

fn dt_repr(t: ref Moment, with_date: bool) -> String {
    let mut parts: Vec[String] = Vec.new();
    if with_date {
        parts.push(f"{t.y}");
        parts.push(f"{t.mo}");
        parts.push(f"{t.d}");
    }
    parts.push(f"{t.h}");
    parts.push(f"{t.mi}");
    if t.us != 0 {
        parts.push(f"{t.s}");
        parts.push(f"{t.us}");
    } else if t.s != 0 {
        parts.push(f"{t.s}");
    }
    let mut s = parts.join(", ");
    if let Some(z) = t.tz {
        s = f"{s}, tzinfo={tz_repr(z)}";
    }
    if with_date { f"datetime.datetime({s})" } else { f"datetime.time({s})" }
}

fn val_repr(v: ref Val, out: mut ref Vec[i64]) {
    match v {
        Val.None => push_ascii(mut out, "None"),
        Val.Bool(b) => push_ascii(mut out, if b { "True" } else { "False" }),
        Val.Int(n) => push_ascii(mut out, f"{n}"),
        Val.Float(x) => push_ascii(mut out, float_repr(x)),
        Val.Str(s) => str_repr(s, mut out),
        Val.Dec(t) => push_ascii(mut out, f"Decimal('{t}')"),
        Val.Tuple(items) => {
            out.push(40);
            let mut k = 0;
            while k < items.len() {
                if k > 0 {
                    push_ascii(mut out, ", ");
                }
                val_repr(items[k], mut out);
                k += 1;
            }
            if items.len() == 1 {
                out.push(44);
            }
            out.push(41);
        }
        Val.List(items) => {
            out.push(91);
            let mut k = 0;
            while k < items.len() {
                if k > 0 {
                    push_ascii(mut out, ", ");
                }
                val_repr(items[k], mut out);
                k += 1;
            }
            out.push(93);
        }
        Val.Dict(items) => {
            out.push(123);
            let mut k = 0;
            while k < items.len() {
                if k > 0 {
                    push_ascii(mut out, ", ");
                }
                let (key, val) = ref items[k];
                str_repr(key, mut out);
                push_ascii(mut out, ": ");
                val_repr(val, mut out);
                k += 1;
            }
            out.push(125);
        }
        Val.DateTime(t) => push_all(mut out, cps_of(dt_repr(t, true))),
        Val.Date(y, m, d) => push_ascii(mut out, f"datetime.date({y}, {m}, {d})"),
        Val.Time(t) => push_all(mut out, cps_of(dt_repr(t, false))),
    }
}

fn repr_val(v: ref Val) -> String {
    let mut out: Vec[i64] = Vec.new();
    val_repr(v, mut out);
    to_string(out)
}

fn val_eq(a: ref Val, b: ref Val) -> bool {
    repr_val(a) == repr_val(b)
}

// ------------------------------------------------------------ int(), float() and Decimal()

fn bad_int(s: ref Vec[i64], base: i64) -> PyErr {
    value_error(f"invalid literal for int() with base {base}: {repr_of(s)}")
}

// int(s): whitespace around, a sign, and decimal digits of any script
// with single underscores between them.
fn py_int(s: ref Vec[i64]) -> Result[i64, PyErr] {
    let t = strip(s);
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == 43 or t[i] == 45) {
        neg = t[i] == 45;
        i += 1;
    }
    if i >= t.len() {
        return Err(bad_int(s, 10));
    }
    let mut n: i64 = 0;
    let mut prev_digit = false;
    while i < t.len() {
        let c = t[i];
        if is_decimal(c) {
            n = n * 10 + digit_value(c);
            prev_digit = true;
        } else if c == 95 and prev_digit and i + 1 < t.len() and is_decimal(t[i + 1]) {
            prev_digit = false;
        } else {
            return Err(bad_int(s, 10));
        }
        i += 1;
    }
    Ok(if neg { -n } else { n })
}

// int(s, base) for a string of the base's ASCII digits, which is all
// int_convert ever passes it.
fn py_int_base(s: ref Vec[i64], base: i64) -> Result[i64, PyErr] {
    if s.len() == 0 {
        return Err(bad_int(s, base));
    }
    let mut n: i64 = 0;
    for c in s {
        let d = if c >= 48 and c <= 57 { c - 48 } else { c - 97 + 10 };
        n = n * base + d;
    }
    Ok(n)
}

// float(s) for the strings parse's float patterns match.
fn py_float(s: ref Vec[i64]) -> Result[f64, PyErr] {
    let t = strip(s);
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == 43 or t[i] == 45) {
        neg = t[i] == 45;
        i += 1;
    }
    let rest = to_string(lower_all(slice(t, i, t.len())));
    if rest == "inf" or rest == "infinity" {
        return Ok(if neg { -1.0 / 0.0 } else { 1.0 / 0.0 });
    }
    if rest == "nan" {
        return Ok(0.0 / 0.0);
    }
    let lit = to_string(t);
    let fixed = if lit.starts_with(".") or lit.starts_with("-.") or lit.starts_with("+.") {
        lit.replace(".", "0.")
    } else {
        lit
    };
    let unsigned = if fixed.starts_with("+") { to_string(slice(cps_of(fixed), 1, fixed.len())) } else { fixed };
    match f64.parse(unsigned) {
        Ok(x) => Ok(x),
        Err(_) => Err(value_error(f"could not convert string to float: {repr_of(s)}")),
    }
}

// The text repr(Decimal(s)) shows.
fn py_decimal(s: ref Vec[i64]) -> Result[String, PyErr] {
    let t = strip(s);
    let mut i = 0;
    let mut sign = "";
    if i < t.len() and (t[i] == 43 or t[i] == 45) {
        if t[i] == 45 {
            sign = "-";
        }
        i += 1;
    }
    let rest = to_string(lower_all(slice(t, i, t.len())));
    if rest == "inf" or rest == "infinity" {
        return Ok(f"{sign}Infinity");
    }
    if rest == "nan" {
        return Ok(f"{sign}NaN");
    }
    let mut digits: Vec[i64] = Vec.new();
    let mut frac = 0;
    let mut seen_point = false;
    while i < t.len() {
        let c = t[i];
        if c == 46 and not seen_point {
            seen_point = true;
        } else if is_decimal(c) {
            digits.push(48 + digit_value(c));
            if seen_point {
                frac += 1;
            }
        } else {
            return Err(py_err("decimal.InvalidOperation", "[<class 'decimal.ConversionSyntax'>]".to_string()));
        }
        i += 1;
    }
    let mut a = 0;
    while a + 1 < digits.len() and digits[a] == 48 {
        a += 1;
    }
    let coeff = slice(digits, a, digits.len());
    let exp = -frac;
    let n = coeff.len();
    let adjusted = exp + n - 1;
    let c = to_string(coeff);
    if exp <= 0 and adjusted >= -6 {
        if exp == 0 {
            return Ok(f"{sign}{c}");
        }
        let point = n + exp;
        if point > 0 {
            let head = to_string(slice(coeff, 0, point));
            let tail = to_string(slice(coeff, point, n));
            return Ok(f"{sign}{head}.{tail}");
        }
        let zeros = to_string(repeat(48, -point));
        return Ok(f"{sign}0.{zeros}{c}");
    }
    let head = to_string(slice(coeff, 0, 1));
    let mut body = head;
    if n > 1 {
        body = f"{body}.{to_string(slice(coeff, 1, n))}";
    }
    let esign = if adjusted >= 0 { "+" } else { "" };
    Ok(f"{sign}{body}E{esign}{adjusted}")
}

// ------------------------------------------------------------ the calendar

fn is_leap(y: i64) -> bool {
    y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)
}

fn days_in_month(y: i64, m: i64) -> i64 {
    let dim = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    if m == 2 and is_leap(y) { 29 } else { dim[m] }
}

fn days_before_month(y: i64, m: i64) -> i64 {
    let dbm = [0, 0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
    dbm[m] + if m > 2 and is_leap(y) { 1 } else { 0 }
}

fn to_ordinal(y: i64, m: i64, d: i64) -> i64 {
    let y1 = y - 1;
    y1 * 365 + y1 / 4 - y1 / 100 + y1 / 400 + days_before_month(y, m) + d
}

// date.fromordinal
fn from_ordinal(ord: i64) -> (i64, i64, i64) {
    let mut n = ord - 1;
    let n400 = n / 146097;
    n = n % 146097;
    let mut year = n400 * 400 + 1;
    let n100 = n / 36524;
    n = n % 36524;
    let n4 = n / 1461;
    n = n % 1461;
    let n1 = n / 365;
    n = n % 365;
    year += n100 * 100 + n4 * 4 + n1;
    if n1 == 4 or n100 == 4 {
        return (year - 1, 12, 31);
    }
    let leap = n1 == 3 and (n4 != 24 or n100 == 3);
    let dbm = [0, 0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
    let dim = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    let mut month = (n + 50) >> 5;
    let mut preceding = dbm[month] + if month > 2 and leap { 1 } else { 0 };
    if preceding > n {
        month -= 1;
        preceding -= dim[month] + if month == 2 and leap { 1 } else { 0 };
    }
    n -= preceding;
    (year, month, n + 1)
}

fn weekday(y: i64, m: i64, d: i64) -> i64 {
    (to_ordinal(y, m, d) + 6) % 7
}

// The checks date() makes, in its order.
fn check_date(y: i64, m: i64, d: i64) -> Result[(), PyErr] {
    if y < 1 or y > 9999 {
        return Err(value_error(f"year {y} is out of range"));
    }
    if m < 1 or m > 12 {
        return Err(value_error("month must be in 1..12".to_string()));
    }
    if d < 1 or d > days_in_month(y, m) {
        return Err(value_error("day is out of range for month".to_string()));
    }
    Ok(())
}

// And the ones time() makes.
fn check_time(h: i64, mi: i64, s: i64, us: i64) -> Result[(), PyErr] {
    if h < 0 or h > 23 {
        return Err(value_error("hour must be in 0..23".to_string()));
    }
    if mi < 0 or mi > 59 {
        return Err(value_error("minute must be in 0..59".to_string()));
    }
    if s < 0 or s > 59 {
        return Err(value_error("second must be in 0..59".to_string()));
    }
    if us < 0 or us > 999999 {
        return Err(value_error("microsecond must be in 0..999999".to_string()));
    }
    Ok(())
}

fn date_iso(y: i64, m: i64, d: i64) -> String {
    f"{pad_n(y, 4)}-{pad_n(m, 2)}-{pad_n(d, 2)}"
}

// datetime.isoformat()
fn dt_iso(t: ref Moment) -> String {
    let mut s = f"{date_iso(t.y, t.mo, t.d)}T{pad_n(t.h, 2)}:{pad_n(t.mi, 2)}:{pad_n(t.s, 2)}";
    if t.us != 0 {
        s = f"{s}.{pad_n(t.us, 6)}";
    }
    if let Some(z) = t.tz {
        let mut off = z.us;
        let mut sign = "+";
        if off < 0 {
            sign = "-";
            off = -off;
        }
        let secs = off / 1000000;
        s = f"{s}{sign}{pad_n(secs / 3600, 2)}:{pad_n((secs / 60) % 60, 2)}";
        if secs % 60 != 0 or off % 1000000 != 0 {
            s = f"{s}:{pad_n(secs % 60, 2)}";
        }
        if off % 1000000 != 0 {
            s = f"{s}.{pad_n(off % 1000000, 6)}";
        }
    }
    s
}

// An aware datetime's instant, in microseconds, for comparisons.
fn dt_instant(t: ref Moment) -> i64 {
    let local = ((to_ordinal(t.y, t.mo, t.d) * 24 + t.h) * 60 + t.mi) * 60 + t.s;
    let off = match t.tz {
        Some(z) => z.us,
        None => 0,
    };
    local * 1000000 + t.us - off
}
// ------------------------------------------------------------ compiled patterns

// Every expression is compiled once; the jobs build many parsers from the
// same few templates.
struct Rx {
    progs: Vec[Program],
    index: Map[String, i64],
}

fn new_rx() -> Rx {
    Rx { progs: Vec.new(), index: Map.new() }
}

fn rx_compile(rx: mut ref Rx, pattern: ref Vec[i64], flags: i64) -> Result[i64, ReErr] {
    let key = f"{flags}:{to_string(pattern)}";
    if let Some(i) = rx.index.get(key) {
        return Ok(i);
    }
    let prog = compile(pattern, flags)?;
    rx.progs.push(prog);
    let i = rx.progs.len() - 1;
    rx.index.insert(key, i);
    Ok(i)
}

fn re_message(e: ref ReErr) -> String {
    if e.pos >= 0 { f"{e.msg} at position {e.pos}" } else { e.msg.clone() }
}

// re.error reaches the caller as re.PatternError, its name since 3.13.
fn pattern_error(e: ref ReErr) -> PyErr {
    if e.kind == "error" {
        return py_err("PatternError", re_message(e));
    }
    py_err(e.kind.as_str(), e.msg.clone())
}

fn flag_ignorecase() -> i64 { 2 }
fn flag_dotall() -> i64 { 16 }

fn group_of(s: ref Vec[i64], m: ref Found, g: i64) -> Option[Vec[i64]] {
    let (a, b) = m.spans[g - 1];
    if a < 0 { None } else { Some(slice(s, a, b)) }
}

fn named_group(prog: ref Program, name: ref Vec[i64]) -> i64 {
    for (n, g) in prog.names.iter() {
        if same(n, name) {
            return g;
        }
    }
    -1
}

// ------------------------------------------------------------ the format spec

struct Spec {
    fill: i64,
    align: i64,
    width: Vec[i64],
    grouping: i64,
    precision: Option[Vec[i64]],
    ty: Vec[i64],
}

fn is_ascii_digit(c: i64) -> bool {
    c >= 48 and c <= 57
}

// The strftime directives parse turns into patterns, in its order.
fn dt_keys() -> Vec[Str] {
    vec!["%a", "%A", "%w", "%d", "%b", "%B", "%m", "%y", "%Y", "%H", "%I", "%p", "%M", "%S", "%f", "%z", "%j", "%U", "%W"]
}

fn dt_regex(key: Str) -> Str {
    if key == "%a" {
        "(?:Sun|Mon|Tue|Wed|Thu|Fri|Sat)"
    } else if key == "%A" {
        "(?:Sunday|Monday|Tuesday|Wednesday|Thursday|Friday|Saturday)"
    } else if key == "%w" {
        "[0-6]"
    } else if key == "%d" or key == "%m" or key == "%H" or key == "%I" or key == "%U" or key == "%W" {
        "[0-9]{1,2}"
    } else if key == "%b" {
        "(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)"
    } else if key == "%B" {
        "(?:January|February|March|April|May|June|July|August|September|October|November|December)"
    } else if key == "%y" {
        "[0-9]{2}"
    } else if key == "%Y" {
        "[0-9]{4}"
    } else if key == "%p" {
        "(?:AM|PM)"
    } else if key == "%M" or key == "%S" {
        "[0-9]{2}"
    } else if key == "%f" {
        "[0-9]{1,6}"
    } else if key == "%z" {
        "[+|-][0-9]{2}(:?[0-9]{2})?(:?[0-9]{2})?"
    } else {
        "[0-9]{1,3}"
    }
}

fn has_dt_key(ty: ref Vec[i64]) -> bool {
    for k in dt_keys() {
        if contains_seq(ty, cps(k)) {
            return true;
        }
    }
    false
}

// get_regex_for_datetime_format
fn dt_format_regex(ty: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < ty.len() {
        if ty[i] == 37 and i + 1 < ty.len() {
            let mut hit = false;
            for k in dt_keys() {
                let kc = cps(k);
                if ty[i + 1] == kc[1] {
                    push_ascii(mut out, dt_regex(k));
                    hit = true;
                    break;
                }
            }
            if hit {
                i += 2;
                continue;
            }
        }
        out.push(ty[i]);
        i += 1;
    }
    out
}

fn allowed_type(ty: ref Vec[i64]) -> bool {
    if ty.len() == 1 {
        return in_ascii(ty[0], "nboxX%fFeEgGwWdDsSl");
    }
    ty.len() == 2 and ty[0] == 116 and in_ascii(ty[1], "ieahgcts")
}

fn extra_index(extra: ref Vec[(Vec[i64], i64)], ty: ref Vec[i64]) -> i64 {
    for (name, conv) in extra.iter() {
        if same(name, ty) {
            return conv;
        }
    }
    -1
}

// extract_format: [[fill]align][sign][0][width][grouping][.precision][type]
fn extract_format(format: ref Vec[i64], extra: ref Vec[(Vec[i64], i64)]) -> Result[Spec, PyErr] {
    let mut f = format.clone();
    let mut fill = -1;
    let mut align = -1;
    if in_ascii(f[0], "<>=^") {
        align = f[0];
        f = slice(f, 1, f.len());
    } else if f.len() > 1 and in_ascii(f[1], "<>=^") {
        fill = f[0];
        align = f[1];
        f = slice(f, 2, f.len());
    }
    if f.len() > 0 and in_ascii(f[0], "+- ") {
        f = slice(f, 1, f.len());
    }
    if f.len() > 0 and f[0] == 48 {
        f = slice(f, 1, f.len());
    }
    let mut width: Vec[i64] = Vec.new();
    while f.len() > 0 and is_decimal(f[0]) {
        width.push(f[0]);
        f = slice(f, 1, f.len());
    }
    let mut grouping = -1;
    if f.len() > 0 and (f[0] == 44 or f[0] == 95) {
        grouping = f[0];
        f = slice(f, 1, f.len());
    }
    let mut precision: Option[Vec[i64]] = None;
    if f.len() > 0 and f[0] == 46 {
        f = slice(f, 1, f.len());
        let mut p: Vec[i64] = Vec.new();
        while f.len() > 0 and is_decimal(f[0]) {
            p.push(f[0]);
            f = slice(f, 1, f.len());
        }
        precision = Some(p);
    }
    let ty = f;
    if ty.len() > 0 and not allowed_type(ty) and extra_index(extra, ty) < 0 and not has_dt_key(ty) {
        return Err(value_error(f"format spec {repr_of(ty)} not recognised"));
    }
    Ok(Spec { fill: fill, align: align, width: width, grouping: grouping, precision: precision, ty: ty })
}

// ------------------------------------------------------------ the custom types

// The converters a job can name, with the pattern and group count each
// carries the way @with_pattern attaches them.
fn extra_id(name: ref String) -> i64 {
    let names = vec!["Number", "Bool", "Word", "Color", "Size", "Range", "Csv", "Money"];
    let mut k = 0;
    while k < names.len() {
        if names[k] == name {
            return k;
        }
        k += 1;
    }
    -1
}

fn extra_pattern(id: i64) -> Str {
    if id == 0 {
        "\\d+"
    } else if id == 1 {
        "(yes|no|on|off|true|false)"
    } else if id == 3 {
        "red|green|blue"
    } else if id == 4 {
        "(\\d+)x(\\d+)"
    } else if id == 5 {
        "(\\d+)-(\\d+)"
    } else if id == 6 {
        "[^,]+(?:,[^,]+)*"
    } else if id == 7 {
        "\\$\\d+\\.\\d\\d"
    } else {
        ".+?"
    }
}

fn extra_group_count(id: i64) -> i64 {
    if id == 1 { 1 } else if id == 4 { 2 } else { 0 }
}

fn unpack_error(got: i64, want: i64) -> PyErr {
    if got > want {
        value_error(f"too many values to unpack (expected {want})")
    } else {
        value_error(f"not enough values to unpack (expected {want}, got {got})")
    }
}

fn extra_convert(id: i64, text: ref Vec[i64]) -> Result[Val, PyErr] {
    if id == 0 {
        return Ok(Val.Int(py_int(text)?));
    }
    if id == 1 {
        let l = to_string(lower_all(text));
        return Ok(Val.Bool(l == "yes" or l == "on" or l == "true"));
    }
    if id == 2 {
        return Ok(Val.Str(upper_all(text)));
    }
    if id == 3 {
        return Ok(Val.Str(text.clone()));
    }
    if id == 4 {
        let parts = split_on(lower_all(text), 120);
        if parts.len() != 2 {
            return Err(unpack_error(parts.len(), 2));
        }
        return Ok(Val.Tuple(vec![Val.Int(py_int(parts[0])?), Val.Int(py_int(parts[1])?)]));
    }
    if id == 5 {
        let parts = split_on(text, 45);
        if parts.len() != 2 {
            return Err(unpack_error(parts.len(), 2));
        }
        let a = py_int(parts[0])?;
        let b = py_int(parts[1])?;
        let mut items: Vec[Val] = Vec.new();
        let mut k = a;
        while k <= b {
            items.push(Val.Int(k));
            k += 1;
        }
        return Ok(Val.List(items));
    }
    if id == 6 {
        let mut items: Vec[Val] = Vec.new();
        for p in split_on(text, 44).iter() {
            items.push(Val.Str(strip(p)));
        }
        return Ok(Val.List(items));
    }
    let parts = split_on(slice(text, 1, text.len()), 46);
    if parts.len() != 2 {
        return Err(unpack_error(parts.len(), 2));
    }
    Ok(Val.Int(py_int(parts[0])? * 100 + py_int(parts[1])?))
}

// ------------------------------------------------------------ the converters

// date_convert's arguments: which groups of the match hold what. mode is
// 0 for a time alone, 1 ymd, 2 mdy, 3 dmy, 4 d_m_y (i1 day, i2 month,
// i3 year), 5 mm and dd (i1, i2); -1 is an argument not given.
#[derive(Clone)]
struct DateConv {
    mode: i64,
    i1: i64,
    i2: i64,
    i3: i64,
    hms: i64,
    am: i64,
    tz: i64,
}

#[derive(Clone)]
enum Conv {
    // int_convert with a base, or 0 to detect it
    IntC(i64),
    Pct,
    FloatC,
    DecC,
    Strf(Vec[i64]),
    DateC(DateConv),
    Extra(i64),
}

#[derive(Clone)]
struct GConv {
    // the fixed field's index, or -1 for a named group
    fixed: i64,
    name: Vec[i64],
    conv: Conv,
}

fn none_error() -> PyErr {
    py_err("TypeError", "'NoneType' object is not subscriptable".to_string())
}

// int_convert.__call__
fn int_convert(s: ref Vec[i64], base0: i64) -> Result[i64, PyErr] {
    let mut sign = 1;
    let mut start = 0;
    if s[0] == 45 {
        sign = -1;
        start = 1;
    } else if s[0] == 43 {
        start = 1;
    }
    let mut base = base0;
    if base == 0 {
        base = 10;
        if s[start] == 48 and s.len() - start > 2 {
            let c = s[start + 1];
            if c == 98 or c == 66 {
                base = 2;
            } else if c == 111 or c == 79 {
                base = 8;
            } else if c == 120 or c == 88 {
                base = 16;
            }
        }
    }
    let charset = slice(cps("0123456789abcdefghijklmnopqrstuvwxyz"), 0, base);
    let mut kept: Vec[i64] = Vec.new();
    for c in lower_all(s) {
        if has(charset, c) {
            kept.push(c);
        }
    }
    Ok(sign * py_int_base(kept, base)?)
}

fn convert(rx: mut ref Rx, conv: ref Conv, text: ref Option[Vec[i64]], groups: ref Vec[Option[Vec[i64]]]) -> Result[Val, PyErr] {
    if let Conv.DateC(dc) = conv {
        return date_convert(dc, groups);
    }
    let t = match text {
        Some(t) => t.clone(),
        None => return Err(none_error()),
    };
    match conv {
        Conv.IntC(base) => Ok(Val.Int(int_convert(t, base)?)),
        Conv.Pct => Ok(Val.Float(py_float(slice(t, 0, t.len() - 1))? / 100.0)),
        Conv.FloatC => Ok(Val.Float(py_float(t)?)),
        Conv.DecC => Ok(Val.Dec(py_decimal(t)?)),
        Conv.Strf(ty) => strf_date_convert(mut rx, t, ty),
        Conv.Extra(id) => extra_convert(id, t),
        Conv.DateC(_) => Err(none_error()),
    }
}

fn opt_group(groups: ref Vec[Option[Vec[i64]]], k: i64) -> Option[Vec[i64]] {
    if k < 0 or k >= groups.len() { None } else { groups[k].clone() }
}

fn months_map(m: ref Vec[i64]) -> i64 {
    let names = vec!["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    let full = vec!["January", "February", "March", "April", "May", "June", "July", "August", "September", "October",
        "November", "December"];
    let mut k = 0;
    while k < 12 {
        if eq_ascii(m, names[k]) or eq_ascii(m, full[k]) {
            return k + 1;
        }
        k += 1;
    }
    -1
}

// re.split(r"[-/\s]", s)
fn split_date(s: ref Vec[i64]) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    for c in s {
        if c == 45 or c == 47 or is_space(c, false) {
            out.push(cur);
            cur = Vec.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn three(parts: ref Vec[Vec[i64]]) -> Result[(), PyErr] {
    if parts.len() != 3 {
        return Err(unpack_error(parts.len(), 3));
    }
    Ok(())
}

// date_convert
fn date_convert(dc: ref DateConv, groups: ref Vec[Option[Vec[i64]]]) -> Result[Val, PyErr] {
    let mut y: Vec[i64] = Vec.new();
    let mut m: Vec[i64] = Vec.new();
    let mut d: Vec[i64] = Vec.new();
    let time_only = dc.mode == 0;
    if dc.mode == 5 {
        return Err(py_err("NotImplementedError", "the ts type takes today's year".to_string()));
    }
    if dc.mode >= 1 and dc.mode <= 3 {
        let parts = split_date(opt_group(groups, dc.i1).unwrap_or(Vec.new()));
        three(parts)?;
        if dc.mode == 1 {
            y = parts[0].clone();
            m = parts[1].clone();
            d = parts[2].clone();
        } else if dc.mode == 2 {
            m = parts[0].clone();
            d = parts[1].clone();
            y = parts[2].clone();
        } else {
            d = parts[0].clone();
            m = parts[1].clone();
            y = parts[2].clone();
        }
    } else if dc.mode == 4 {
        d = opt_group(groups, dc.i1).unwrap_or(Vec.new());
        m = opt_group(groups, dc.i2).unwrap_or(Vec.new());
        y = opt_group(groups, dc.i3).unwrap_or(Vec.new());
    }
    let mut hh = 0;
    let mut mm = 0;
    let mut ss = 0;
    let mut us = 0;
    if dc.hms >= 0 {
        if let Some(t) = opt_group(groups, dc.hms) {
            if t.len() > 0 {
                let parts = split_on(t, 58);
                if parts.len() == 2 {
                    hh = py_int(parts[0])?;
                    mm = py_int(parts[1])?;
                } else {
                    let mut sec = parts[2].clone();
                    if has(sec, 46) {
                        let sp = split_on(sec, 46);
                        if sp.len() != 2 {
                            return Err(unpack_error(sp.len(), 2));
                        }
                        let mut u = sp[1].clone();
                        while u.len() < 6 {
                            u.push(48);
                        }
                        us = py_int(slice(u, 0, 6))?;
                        sec = sp[0].clone();
                    }
                    ss = py_int(sec)?;
                    hh = py_int(parts[0])?;
                    mm = py_int(parts[1])?;
                }
            }
        }
    }
    if dc.am >= 0 {
        let am = match opt_group(groups, dc.am) {
            Some(a) => strip(a),
            None => Vec.new(),
        };
        if eq_ascii(am, "AM") and hh == 12 {
            hh -= 12;
        } else if eq_ascii(am, "PM") and hh == 12 {
            hh = hh;
        } else if eq_ascii(am, "PM") {
            hh += 12;
        }
    }
    let mut tz: Option[Tz] = None;
    if dc.tz >= 0 {
        if let Some(raw) = opt_group(groups, dc.tz) {
            if eq_ascii(raw, "Z") {
                tz = Some(Tz { fixed: true, name: cps("UTC"), us: 0 });
            } else if raw.len() > 0 {
                let t = strip(raw);
                if is_upper_str(t) {
                    return Err(py_err("TypeError", "tzinfo argument must be None or of a tzinfo subclass, not type 'str'".to_string()));
                }
                let sign = t[0];
                let mut tzh: Vec[i64] = Vec.new();
                let mut tzm: Vec[i64] = Vec.new();
                if has(t, 58) {
                    let sp = split_on(slice(t, 1, t.len()), 58);
                    if sp.len() != 2 {
                        return Err(unpack_error(sp.len(), 2));
                    }
                    tzh = sp[0].clone();
                    tzm = sp[1].clone();
                } else if t.len() == 4 {
                    tzh = slice(t, 1, 2);
                    tzm = slice(t, 2, 4);
                } else {
                    tzh = slice(t, 1, if t.len() < 3 { t.len() } else { 3 });
                    if t.len() > 3 {
                        tzm = slice(t, 3, if t.len() < 5 { t.len() } else { 5 });
                    }
                }
                let mut offset = py_int(tzm)? + py_int(tzh)? * 60;
                if sign == 45 {
                    offset = -offset;
                }
                tz = Some(Tz { fixed: true, name: t, us: offset * 60000000 });
            }
        }
    }
    if time_only {
        check_time(hh, mm, ss, us)?;
        return Ok(Val.Time(Moment { y: 1900, mo: 1, d: 1, h: hh, mi: mm, s: ss, us: us, tz: tz }));
    }
    let yy = py_int(y)?;
    let mon = if all_decimal(m) {
        py_int(m)?
    } else {
        let k = months_map(m);
        if k < 0 {
            return Err(py_err("KeyError", repr_of(m)));
        }
        k
    };
    let dd = py_int(d)?;
    check_date(yy, mon, dd)?;
    check_time(hh, mm, ss, us)?;
    Ok(Val.DateTime(Moment { y: yy, mo: mon, d: dd, h: hh, mi: mm, s: ss, us: us, tz: tz }))
}

fn strf_date_convert(rx: mut ref Rx, x: ref Vec[i64], ty: ref Vec[i64]) -> Result[Val, PyErr] {
    let mut is_date = false;
    for c in "aAwdbBmyYjUW".bytes() {
        if contains_seq(ty, vec![37, c as i64]) {
            is_date = true;
        }
    }
    let mut is_time = false;
    for c in "HIpMSfz".bytes() {
        if contains_seq(ty, vec![37, c as i64]) {
            is_time = true;
        }
    }
    let dt = strptime(mut rx, x, ty)?;
    if is_date and is_time {
        return Ok(Val.DateTime(dt));
    }
    if is_date {
        return Ok(Val.Date(dt.y, dt.mo, dt.d));
    }
    if is_time {
        return Ok(Val.Time(dt));
    }
    Err(value_error("Datetime not a date nor a time?".to_string()))
}
// ------------------------------------------------------------ _strptime

// LocaleTime in the C locale.
fn f_weekday() -> Vec[Str] {
    vec!["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
}

fn a_weekday() -> Vec[Str] {
    vec!["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
}

fn f_month() -> Vec[Str] {
    vec!["", "january", "february", "march", "april", "may", "june", "july", "august", "september", "october",
        "november", "december"]
}

fn a_month() -> Vec[Str] {
    vec!["", "jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]
}

// TimeRE.__seqToRE: longest first, keeping the order of equal lengths.
fn seq_to_re(names: ref Vec[Str], from: i64, directive: Str) -> String {
    let mut order: Vec[Str] = Vec.new();
    let mut k = from;
    while k < names.len() {
        let cur = names[k];
        let mut j = order.len();
        order.push(cur);
        while j > 0 and order[j - 1].len() < cur.len() {
            order[j] = order[j - 1];
            j -= 1;
        }
        order[j] = cur;
        k += 1;
    }
    f"(?P<{directive}>{order.join("|")})"
}

// TimeRE's mapping for a directive, or None where it has none (KeyError).
fn directive_re(key: ref Vec[i64]) -> Option[String] {
    let k = to_string(key);
    let d = "(?P<d>3[0-1]|[1-2]\\d|0[1-9]|[1-9]| [1-9])";
    let h = "(?P<H>2[0-3]|[0-1]\\d|\\d| \\d)";
    let i = "(?P<I>1[0-2]|0[1-9]|[1-9]| [1-9])";
    let u = "(?P<U>5[0-3]|[0-4]\\d|\\d)";
    let r = if k == "d" or k == "e" {
        d.to_string()
    } else if k == "f" {
        "(?P<f>[0-9]{1,6})".to_string()
    } else if k == "H" or k == "k" {
        h.to_string()
    } else if k == "I" or k == "l" {
        i.to_string()
    } else if k == "j" {
        "(?P<j>36[0-6]|3[0-5]\\d|[1-2]\\d\\d|0[1-9]\\d|00[1-9]|[1-9]\\d|0[1-9]|[1-9])".to_string()
    } else if k == "m" {
        "(?P<m>1[0-2]|0[1-9]|[1-9])".to_string()
    } else if k == "M" {
        "(?P<M>[0-5]\\d|\\d)".to_string()
    } else if k == "S" {
        "(?P<S>6[0-1]|[0-5]\\d|\\d)".to_string()
    } else if k == "U" {
        u.to_string()
    } else if k == "W" {
        u.replace("U", "W")
    } else if k == "w" {
        "(?P<w>[0-6])".to_string()
    } else if k == "y" {
        "(?P<y>\\d\\d)".to_string()
    } else if k == "Y" {
        "(?P<Y>\\d\\d\\d\\d)".to_string()
    } else if k == "z" {
        "(?P<z>[+-]\\d\\d:?[0-5]\\d(:?[0-5]\\d(\\.\\d{1,6})?)?|(?-i:Z))".to_string()
    } else if k == "A" {
        seq_to_re(f_weekday(), 0, "A")
    } else if k == "a" {
        seq_to_re(a_weekday(), 0, "a")
    } else if k == "B" {
        seq_to_re(f_month(), 1, "B")
    } else if k == "b" {
        seq_to_re(a_month(), 1, "b")
    } else if k == "p" or k == "P" or k == "Op" {
        seq_to_re(vec!["am", "pm"], 0, "p")
    } else if k == "%" {
        "%".to_string()
    } else if k == "Od" or k == "Oe" or k == "Om" or k == "Oy" or k == "OC" or k == "OH" or k == "OI" or k == "OM"
        or k == "OS" {
        let c = to_string(slice(key, 1, 2));
        let name = if c == "e" { "d".to_string() } else { c };
        f"(?P<{name}>\\d\\d|\\d| \\d)"
    } else if k == "Ow" {
        "(?P<w>\\d)".to_string()
    } else if k == "T" {
        return Some(to_string(time_pattern(cps("%H:%M:%S")).ok()?));
    } else if k == "R" {
        return Some(to_string(time_pattern(cps("%H:%M")).ok()?));
    } else {
        return None;
    };
    Some(r)
}

// TimeRE.pattern; Err holds the directive a KeyError names.
fn time_pattern(format: ref Vec[i64]) -> Result[Vec[i64], Vec[i64]] {
    let mut esc: Vec[i64] = Vec.new();
    for c in format {
        if in_ascii(c, "\\.^$*+?(){}[]|") {
            esc.push(92);
        }
        esc.push(c);
    }
    let mut ws: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < esc.len() {
        if is_space(esc[i], false) {
            while i < esc.len() and is_space(esc[i], false) {
                i += 1;
            }
            push_ascii(mut ws, "\\s+");
            continue;
        }
        if esc[i] == 39 {
            push_all(mut ws, cps("['\u{2bc}]"));
        } else {
            ws.push(esc[i]);
        }
        i += 1;
    }
    let mut out: Vec[i64] = Vec.new();
    i = 0;
    while i < ws.len() {
        if ws[i] != 37 {
            out.push(ws[i]);
            i += 1;
            continue;
        }
        i += 1;
        while i < ws.len() and in_ascii(ws[i], "-_0^#") {
            i += 1;
        }
        while i < ws.len() and is_ascii_digit(ws[i]) {
            i += 1;
        }
        let mut key: Vec[i64] = Vec.new();
        if i < ws.len() and (ws[i] == 79 or ws[i] == 69) {
            key.push(ws[i]);
            i += 1;
        }
        if i < ws.len() and ws[i] == 92 {
            key.push(92);
            i += 1;
        }
        if i < ws.len() and ws[i] != 10 {
            key.push(ws[i]);
            i += 1;
        }
        match directive_re(key) {
            Some(r) => push_all(mut out, cps_of(r)),
            None => return Err(key),
        }
    }
    Ok(out)
}

struct TzOut {
    has: bool,
    secs: i64,
    frac: i64,
}

fn index_in(names: ref Vec[Str], s: ref Vec[i64]) -> i64 {
    let l = to_string(lower_all(s));
    let mut k = 0;
    while k < names.len() {
        if names[k] == l {
            return k;
        }
        k += 1;
    }
    -1
}

// _calc_julian_from_U_or_W
fn julian_from_week(year: i64, week: i64, day_of_week0: i64, starts_mon: bool) -> i64 {
    let mut first = weekday(year, 1, 1);
    let mut dow = day_of_week0;
    if not starts_mon {
        first = (first + 1) % 7;
        dow = (dow + 1) % 7;
    }
    let week0 = (7 - first) % 7;
    if week == 0 {
        return 1 + dow - first;
    }
    1 + week0 + 7 * (week - 1) + dow
}

// datetime.strptime(data, format)
fn strptime(rx: mut ref Rx, data: ref Vec[i64], format: ref Vec[i64]) -> Result[Moment, PyErr] {
    let pattern = match time_pattern(format) {
        Ok(p) => p,
        Err(key) => {
            let bad = replace_seq(key, cps("\\s"), Vec.new());
            if bad.len() == 0 {
                return Err(value_error(f"stray % in format '{to_string(format)}'"));
            }
            let mut b = bad.clone();
            let k = index_of(b, 92);
            if k >= 0 {
                b = cat(slice(b, 0, k), slice(b, k + 1, b.len()));
            }
            return Err(value_error(f"'{to_string(b)}' is a bad directive in format '{to_string(format)}'"));
        }
    };
    let pi = match rx_compile(mut rx, pattern, flag_ignorecase()) {
        Ok(i) => i,
        Err(e) => return Err(pattern_error(e)),
    };
    let found = {
        let prog = ref rx.progs[pi];
        let mut m = new_matcher(prog, data);
        find(mut m, prog, 0, false, 1)
    };
    let f = match found {
        Some(f) => f,
        None => return Err(value_error(f"time data {repr_of(data)} does not match format {repr_of(format)}")),
    };
    if f.end != data.len() {
        return Err(value_error(f"unconverted data remains: {to_string(slice(data, f.end, data.len()))}"));
    }
    let names = rx.progs[pi].names.clone();
    let mut year = -1;
    let mut month = 1;
    let mut day = 1;
    let mut hour = 0;
    let mut minute = 0;
    let mut second = 0;
    let mut fraction = 0;
    let mut tz = TzOut { has: false, secs: 0, frac: 0 };
    let mut week_of_year = -1;
    let mut week_starts = -1;
    let mut wday = -1;
    let mut julian = -1;
    // %p, which %I reads
    let mut ampm: Vec[i64] = Vec.new();
    for (name, g) in names.iter() {
        if eq_ascii(name, "p") {
            if let Some(t) = group_of(data, f, g) {
                ampm = lower_all(t);
            }
        }
    }
    for (name, g) in names.iter() {
        let t = match group_of(data, f, g) {
            Some(t) => t,
            None => continue,
        };
        let key = to_string(name);
        if key == "y" {
            year = py_int(t)?;
            year += if year <= 68 { 2000 } else { 1900 };
        } else if key == "Y" {
            year = py_int(t)?;
        } else if key == "m" {
            month = py_int(t)?;
        } else if key == "B" {
            month = index_in(f_month(), t);
        } else if key == "b" {
            month = index_in(a_month(), t);
        } else if key == "d" {
            day = py_int(t)?;
        } else if key == "H" {
            hour = py_int(t)?;
        } else if key == "I" {
            hour = py_int(t)?;
            if ampm.len() == 0 or eq_ascii(ampm, "am") {
                if hour == 12 {
                    hour = 0;
                }
            } else if eq_ascii(ampm, "pm") {
                if hour != 12 {
                    hour += 12;
                }
            }
        } else if key == "M" {
            minute = py_int(t)?;
        } else if key == "S" {
            second = py_int(t)?;
        } else if key == "f" {
            let mut s = t.clone();
            while s.len() < 6 {
                s.push(48);
            }
            fraction = py_int(s)?;
        } else if key == "A" {
            wday = index_in(f_weekday(), t);
        } else if key == "a" {
            wday = index_in(a_weekday(), t);
        } else if key == "w" {
            wday = py_int(t)?;
            wday = if wday == 0 { 6 } else { wday - 1 };
        } else if key == "j" {
            julian = py_int(t)?;
        } else if key == "U" or key == "W" {
            week_of_year = py_int(t)?;
            week_starts = if key == "U" { 6 } else { 0 };
        } else if key == "z" {
            tz = parse_z(t)?;
        }
    }
    let mut leap_year_fix = false;
    if year < 0 {
        if month == 2 and day == 29 {
            year = 1904;
            leap_year_fix = true;
        } else {
            year = 1900;
        }
    }
    if julian < 0 and wday >= 0 and week_of_year >= 0 {
        julian = julian_from_week(year, week_of_year, wday, week_starts == 0);
        if julian <= 0 {
            year -= 1;
            julian += if is_leap(year) { 366 } else { 365 };
        }
    }
    if julian < 0 {
        check_date(year, month, day)?;
    } else {
        check_date(year, 1, 1)?;
        let (yy, mm, dd) = from_ordinal(julian - 1 + to_ordinal(year, 1, 1));
        check_date(yy, mm, dd)?;
        year = yy;
        month = mm;
        day = dd;
    }
    if leap_year_fix {
        year = 1900;
    }
    let mut zone: Option[Tz] = None;
    if tz.has {
        let us = tz.secs * 1000000 + tz.frac;
        if us <= -86400000000 or us >= 86400000000 {
            return Err(value_error(f"offset must be a timedelta strictly between -timedelta(hours=24) and timedelta(hours=24), not {td_repr(us)}."));
        }
        zone = Some(Tz { fixed: false, name: Vec.new(), us: us });
    }
    check_date(year, month, day)?;
    check_time(hour, minute, second, fraction)?;
    Ok(Moment { y: year, mo: month, d: day, h: hour, mi: minute, s: second, us: fraction, tz: zone })
}

fn cut(s: ref Vec[i64], a: i64, b: i64) -> Vec[i64] {
    let lo = if a > s.len() { s.len() } else { a };
    let hi = if b > s.len() { s.len() } else { b };
    if hi <= lo { Vec.new() } else { slice(s, lo, hi) }
}

// The %z branch of _strptime.
fn parse_z(found: ref Vec[i64]) -> Result[TzOut, PyErr] {
    if eq_ascii(found, "Z") {
        return Ok(TzOut { has: true, secs: 0, frac: 0 });
    }
    let mut z = found.clone();
    if z[3] == 58 {
        z = cat(cut(z, 0, 3), cut(z, 4, z.len()));
        if z.len() > 5 {
            if z[5] != 58 {
                return Err(value_error(f"Inconsistent use of : in {to_string(found)}"));
            }
            z = cat(cut(z, 0, 5), cut(z, 6, z.len()));
        }
    }
    let hours = py_int(cut(z, 1, 3))?;
    let minutes = py_int(cut(z, 3, 5))?;
    let sec_text = cut(z, 5, 7);
    let seconds = if sec_text.len() == 0 { 0 } else { py_int(sec_text)? };
    let mut gmtoff = hours * 3600 + minutes * 60 + seconds;
    let mut rem = cut(z, 8, z.len());
    while rem.len() < 6 {
        rem.push(48);
    }
    let mut frac = py_int(rem)?;
    if z[0] == 45 {
        gmtoff = -gmtoff;
        frac = -frac;
    }
    Ok(TzOut { has: true, secs: gmtoff, frac: frac })
}
// ------------------------------------------------------------ FmtParser

struct FmtParser {
    format: Vec[i64],
    // group name -> field name, and back
    group_to_name: Vec[(Vec[i64], Vec[i64])],
    name_to_group: Vec[(Vec[i64], Vec[i64])],
    // the format spec first seen for each field name
    name_types: Vec[(Vec[i64], Vec[i64])],
    extra: Vec[(Vec[i64], i64)],
    flags: i64,
    fixed_fields: Vec[i64],
    named_fields: Vec[Vec[i64]],
    group_index: i64,
    convs: Vec[GConv],
    expression: Vec[i64],
}

fn lookup(pairs: ref Vec[(Vec[i64], Vec[i64])], key: ref Vec[i64]) -> Option[Vec[i64]] {
    for (k, v) in pairs.iter() {
        if same(k, key) {
            return Some(v.clone());
        }
    }
    None
}

fn parse_re() -> Str {
    "({{|}}|{[\\w-]*(?:\\.[\\w-]+|\\[[^]]+])*(?::[^}]+)?})"
}

// PARSE_RE.split(format): the text between fields, and each field.
fn split_format(rx: mut ref Rx, format: ref Vec[i64]) -> Vec[Vec[i64]] {
    let pi = rx_compile(mut rx, cps(parse_re()), 0).ok().unwrap();
    let prog = ref rx.progs[pi];
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut last = 0;
    for m in all_matches(prog, format, 0).iter() {
        out.push(slice(format, last, m.start));
        out.push(slice(format, m.start, m.end));
        last = m.end;
    }
    out.push(slice(format, last, format.len()));
    out
}

// REGEX_SAFETY.sub: a backslash before ?\.[]()*+^$!|
fn regex_safe(text: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in text {
        if in_ascii(c, "?\\.[]()*+^$!|") {
            out.push(92);
        }
        out.push(c);
    }
    out
}

fn new_parser(rx: mut ref Rx, format: ref Vec[i64], extra: ref Vec[(Vec[i64], i64)], case_sensitive: bool) -> Result[FmtParser, PyErr] {
    let flags = if case_sensitive { flag_dotall() } else { flag_ignorecase() | flag_dotall() };
    let mut p = FmtParser {
        format: format.clone(),
        group_to_name: Vec.new(),
        name_to_group: Vec.new(),
        name_types: Vec.new(),
        extra: extra.clone(),
        flags: flags,
        fixed_fields: Vec.new(),
        named_fields: Vec.new(),
        group_index: 0,
        convs: Vec.new(),
        expression: Vec.new(),
    };
    let mut e: Vec[i64] = Vec.new();
    for part in split_format(mut rx, format).iter() {
        if part.len() == 0 {
            continue;
        }
        if eq_ascii(part, "{{") {
            push_ascii(mut e, "\\{");
        } else if eq_ascii(part, "}}") {
            push_ascii(mut e, "\\}");
        } else if part[0] == 123 and part[part.len() - 1] == 125 {
            let s = p.handle_field(part)?;
            push_all(mut e, s);
        } else {
            push_all(mut e, regex_safe(part));
        }
    }
    p.expression = e;
    Ok(p)
}

impl FmtParser {
    fn to_group_name(mut ref self, field: ref Vec[i64]) -> Result[Vec[i64], PyErr] {
        let mut group = field.clone();
        for c in "._-".bytes() {
            group = replace_char(group, c as i64, cps("_"));
        }
        group = replace_char(group, 91, cps("_"));
        group = replace_char(group, 93, cps("_"));
        let mut n = 1;
        while lookup(self.group_to_name, group).is_some() {
            n += 1;
            if has(field, 46) {
                group = replace_char(field, 46, repeat(95, n));
            } else if has(field, 95) {
                group = replace_char(field, 95, repeat(95, n));
            } else if has(field, 45) {
                group = replace_char(field, 45, repeat(95, n));
            } else {
                return Err(py_err("KeyError", repr_of(cps_of(f"duplicated group name {repr_of(field)}"))));
            }
        }
        self.group_to_name.push((group.clone(), field.clone()));
        self.name_to_group.push((field.clone(), group.clone()));
        Ok(group)
    }

    fn add_conv(mut ref self, fixed: i64, name: ref Vec[i64], conv: own Conv) {
        self.convs.push(GConv { fixed: fixed, name: name.clone(), conv: conv });
    }

    fn handle_field(mut ref self, part: ref Vec[i64]) -> Result[Vec[i64], PyErr] {
        let field = slice(part, 1, part.len() - 1);
        let colon = index_of(field, 58);
        let name = if colon >= 0 { slice(field, 0, colon) } else { field.clone() };
        let format = if colon >= 0 { slice(field, colon + 1, field.len()) } else { Vec.new() };
        let mut fixed = -1;
        let mut group: Vec[i64] = Vec.new();
        let mut wrap_named = false;
        if name.len() > 0 and is_alpha_cp(name[0]) {
            if let Some(g) = lookup(self.name_to_group, name) {
                let seen = lookup(self.name_types, name).unwrap();
                if not same(seen, format) {
                    return Err(py_err("RepeatedNameError", f"field type {repr_of(format)} for field \"{to_string(name)}\" does not match previous seen type {repr_of(seen)}"));
                }
                return Ok(cat_ascii(cat(cps("(?P="), g), ")"));
            }
            group = self.to_group_name(name)?;
            self.name_types.push((name.clone(), format.clone()));
            self.named_fields.push(group.clone());
            wrap_named = true;
        } else {
            self.fixed_fields.push(self.group_index);
            fixed = self.group_index;
        }
        let open = if wrap_named { cat_ascii(cat(cps("(?P<"), group), ">") } else { cps("(") };
        if format.len() == 0 {
            self.group_index += 1;
            return Ok(cat_ascii(cat_ascii(open, ".+?"), ")"));
        }
        let spec = extract_format(format, self.extra)?;
        let ty = spec.ty.clone();
        let is_numeric = ty.len() > 0 and contains_seq(cps("n%fFegdobxEGX"), ty);
        let ex = extra_index(self.extra, ty);
        let mut s: Vec[i64] = Vec.new();
        let n = self.group_index;
        if ex >= 0 {
            s = cps(extra_pattern(ex));
            self.group_index += extra_group_count(ex);
            self.add_conv(fixed, group, Conv.Extra(ex));
        } else if eq_ascii(ty, "n") {
            s = cps("\\d{1,3}([,.]\\d{3})*");
            self.group_index += 1;
            self.add_conv(fixed, group, Conv.IntC(10));
        } else if eq_ascii(ty, "b") {
            s = cps("(0[bB])?[01]+");
            self.add_conv(fixed, group, Conv.IntC(2));
            self.group_index += 1;
        } else if eq_ascii(ty, "o") {
            s = cps("(0[oO])?[0-7]+");
            self.add_conv(fixed, group, Conv.IntC(8));
            self.group_index += 1;
        } else if eq_ascii(ty, "x") or eq_ascii(ty, "X") {
            s = cps("(0[xX])?[0-9a-fA-F]+");
            self.add_conv(fixed, group, Conv.IntC(16));
            self.group_index += 1;
        } else if eq_ascii(ty, "%") {
            s = cps("\\d+(\\.\\d+)?%");
            self.group_index += 1;
            self.add_conv(fixed, group, Conv.Pct);
        } else if eq_ascii(ty, "f") or eq_ascii(ty, "F") {
            let zero_prec = match spec.precision {
                Some(p) => eq_ascii(p, "0"),
                None => false,
            };
            s = if zero_prec { cps("(?:\\d+|nan|NAN|inf|INF)") } else { cps("(?:\\d*\\.\\d+|nan|NAN|inf|INF)") };
            self.add_conv(fixed, group, if eq_ascii(ty, "f") { Conv.FloatC } else { Conv.DecC });
        } else if eq_ascii(ty, "e") or eq_ascii(ty, "E") {
            s = cps("\\d*\\.\\d+[eE][-+]?\\d+|nan|NAN|[-+]?inf|[-+]?INF");
            self.add_conv(fixed, group, Conv.FloatC);
        } else if eq_ascii(ty, "g") or eq_ascii(ty, "G") {
            s = cps("\\d+(\\.\\d+)?([eE][-+]?\\d+)?|nan|NAN|[-+]?inf|[-+]?INF");
            self.group_index += 2;
            self.add_conv(fixed, group, Conv.FloatC);
        } else if eq_ascii(ty, "d") {
            let width = if spec.width.len() > 0 { f"{{1,{py_int(spec.width)?}}}" } else { "+".to_string() };
            let g = if spec.grouping >= 0 { to_string(vec![spec.grouping]) } else { String.new() };
            s = cps_of(f"[-+ ]?[0-9{g}]{width}|[-+ ]?0[xX][0-9a-fA-F{g}]{width}|[-+ ]?0[bB][01{g}]{width}|[-+ ]?0[oO][0-7{g}]{width}");
            self.add_conv(fixed, group, Conv.IntC(0));
        } else if has_dt_key(ty) {
            s = dt_format_regex(ty);
            self.add_conv(fixed, group, Conv.Strf(ty.clone()));
        } else if eq_ascii(ty, "ti") {
            s = cps_of(f"(\\d{{4}}-\\d\\d-\\d\\d)((\\s+|T){time_pat()})?(Z|\\s*[-+]\\d\\d:?\\d\\d)?");
            self.add_conv(fixed, group, Conv.DateC(DateConv { mode: 1, i1: n + 1, i2: -1, i3: -1, hms: n + 4, am: -1, tz: n + 7 }));
            self.group_index += 7;
        } else if eq_ascii(ty, "tg") {
            s = cps_of(f"(\\d{{1,2}}[-/](\\d{{1,2}}|{all_months_pat()})[-/]\\d{{4}})(\\s+{time_pat()})?{am_pat()}?{tz_pat()}?");
            self.add_conv(fixed, group, Conv.DateC(DateConv { mode: 3, i1: n + 1, i2: -1, i3: -1, hms: n + 5, am: n + 8, tz: n + 9 }));
            self.group_index += 9;
        } else if eq_ascii(ty, "ta") {
            s = cps_of(f"((\\d{{1,2}}|{all_months_pat()})[-/]\\d{{1,2}}[-/]\\d{{4}})(\\s+{time_pat()})?{am_pat()}?{tz_pat()}?");
            self.add_conv(fixed, group, Conv.DateC(DateConv { mode: 2, i1: n + 1, i2: -1, i3: -1, hms: n + 5, am: n + 8, tz: n + 9 }));
            self.group_index += 9;
        } else if eq_ascii(ty, "te") {
            s = cps_of(f"({days_pat()},\\s+)?(\\d{{1,2}}\\s+{months_pat()}\\s+\\d{{4}})\\s+{time_pat()}{tz_pat()}");
            self.add_conv(fixed, group, Conv.DateC(DateConv { mode: 3, i1: n + 3, i2: -1, i3: -1, hms: n + 5, am: -1, tz: n + 8 }));
            self.group_index += 8;
        } else if eq_ascii(ty, "th") {
            s = cps_of(f"(\\d{{1,2}}[-/]{months_pat()}[-/]\\d{{4}}):{time_pat()}{tz_pat()}");
            self.add_conv(fixed, group, Conv.DateC(DateConv { mode: 3, i1: n + 1, i2: -1, i3: -1, hms: n + 3, am: -1, tz: n + 6 }));
            self.group_index += 6;
        } else if eq_ascii(ty, "tc") {
            s = cps_of(f"({days_pat()})\\s+{months_pat()}\\s+(\\d{{1,2}})\\s+{time_pat()}\\s+(\\d{{4}})");
            self.add_conv(fixed, group, Conv.DateC(DateConv { mode: 4, i1: n + 4, i2: n + 3, i3: n + 8, hms: n + 5, am: -1, tz: -1 }));
            self.group_index += 8;
        } else if eq_ascii(ty, "tt") {
            s = cps_of(f"{time_pat()}?{am_pat()}?{tz_pat()}?");
            self.add_conv(fixed, group, Conv.DateC(DateConv { mode: 0, i1: -1, i2: -1, i3: -1, hms: n + 1, am: n + 4, tz: n + 5 }));
            self.group_index += 5;
        } else if eq_ascii(ty, "ts") {
            s = cps_of(f"{months_pat()}(\\s+)(\\d+)(\\s+)(\\d{{1,2}}:\\d{{1,2}}:\\d{{1,2}})?");
            self.add_conv(fixed, group, Conv.DateC(DateConv { mode: 5, i1: n + 1, i2: n + 3, i3: -1, hms: n + 5, am: -1, tz: -1 }));
            self.group_index += 5;
        } else if eq_ascii(ty, "l") {
            s = cps("[A-Za-z]+");
        } else if ty.len() > 0 {
            s = cat_ascii(cat(cps("\\"), ty), "+");
        } else if let Some(prec) = spec.precision {
            if spec.width.len() > 0 {
                s = cat_ascii(cat(cat_ascii(cat(cps(".{"), spec.width), ","), prec), "}?");
            } else {
                s = cat_ascii(cat(cps(".{1,"), prec), "}?");
            }
        } else if spec.width.len() > 0 {
            s = cat_ascii(cat(cps(".{"), spec.width), ",}?");
        } else {
            s = cps(".+?");
        }
        let mut align = spec.align;
        let mut fill = spec.fill;
        if is_numeric {
            if align == 61 {
                if fill < 0 {
                    fill = 48;
                }
                s = cat(vec![fill, 42], s);
            }
            s = cat(cps("[-+ ]?"), s);
        }
        if fill < 0 {
            fill = 32;
        }
        s = cat_ascii(cat(open, s), ")");
        self.group_index += 1;
        if spec.width.len() > 0 and align < 0 {
            align = 62;
        }
        let f = if in_ascii(fill, ".\\+?*[](){}^$") { vec![92, fill] } else { vec![fill] };
        if align == 60 {
            s = cat_ascii(cat(s, f), "*");
        } else if align == 62 {
            s = cat(cat_ascii(f.clone(), "*"), s);
        } else if align == 94 {
            s = cat_ascii(cat(cat(cat_ascii(f.clone(), "*"), s), f), "*");
        }
        Ok(s)
    }
}

fn time_pat() -> Str {
    "(\\d{1,2}:\\d{1,2}(:\\d{1,2}(\\.\\d+)?)?)"
}

fn am_pat() -> Str {
    "(\\s+[AP]M)"
}

fn tz_pat() -> Str {
    "(\\s+[-+]\\d\\d?:?\\d\\d)"
}

fn days_pat() -> Str {
    "(Mon|Tue|Wed|Thu|Fri|Sat|Sun)"
}

fn months_pat() -> Str {
    "(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)"
}

fn all_months_pat() -> Str {
    "(Jan|January|Feb|February|Mar|March|Apr|April|May|Jun|June|Jul|July|Aug|August|Sep|September|Oct|October|Nov|November|Dec|December)"
}

// ------------------------------------------------------------ Result

#[derive(Clone)]
struct PResult {
    fixed: Vec[Val],
    named: Vec[(Vec[i64], Val)],
    named_spans: Vec[(Vec[i64], (i64, i64))],
    fixed_spans: Vec[(i64, (i64, i64))],
}

fn result_repr(r: ref PResult) -> String {
    let mut out: Vec[i64] = Vec.new();
    push_ascii(mut out, "<Result ");
    val_repr(Val.Tuple(r.fixed.clone()), mut out);
    out.push(32);
    val_repr(Val.Dict(r.named.clone()), mut out);
    out.push(62);
    to_string(out)
}

fn spans_repr(r: ref PResult) -> String {
    let mut out: Vec[i64] = Vec.new();
    out.push(123);
    let mut first = true;
    for (k, sp) in r.named_spans.iter() {
        if not first {
            push_ascii(mut out, ", ");
        }
        first = false;
        str_repr(k, mut out);
        push_ascii(mut out, f": {span_text(*sp)}");
    }
    for (k, sp) in r.fixed_spans.iter() {
        if not first {
            push_ascii(mut out, ", ");
        }
        first = false;
        push_ascii(mut out, f"{k}: {span_text(*sp)}");
    }
    out.push(125);
    to_string(out)
}

fn span_text(span: (i64, i64)) -> String {
    let (a, b) = span;
    f"({a}, {b})"
}

fn result_get(r: ref PResult, key: Str) -> Option[Val] {
    for (k, v) in r.named.iter() {
        if eq_ascii(k, key) {
            return Some(v.clone());
        }
    }
    None
}

fn get_str(r: ref PResult, key: Str) -> Vec[i64] {
    match result_get(r, key) {
        Some(Val.Str(s)) => s,
        _ => Vec.new(),
    }
}

fn get_int(r: ref PResult, key: Str) -> i64 {
    match result_get(r, key) {
        Some(Val.Int(n)) => n,
        _ => 0,
    }
}

// The '[b][c]' keys of 'a[b][c]'.
fn subkeys(s: ref Vec[i64]) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut i = 0;
    while i < s.len() {
        if s[i] == 91 {
            let mut j = i + 1;
            while j < s.len() and s[j] != 93 {
                j += 1;
            }
            if j < s.len() and j > i + 1 {
                out.push(slice(s, i + 1, j));
                i = j + 1;
                continue;
            }
        }
        i += 1;
    }
    out
}

// d[keys[0]][keys[1]]... = value, with setdefault's {} along the way.
fn assign(d: own Vec[(Vec[i64], Val)], keys: ref Vec[Vec[i64]], i: i64, value: own Val) -> Result[Vec[(Vec[i64], Val)], PyErr] {
    let mut dict = d;
    let key = keys[i].clone();
    let mut at = -1;
    let mut k = 0;
    while k < dict.len() {
        if same(dict[k].0, key) {
            at = k;
        }
        k += 1;
    }
    if i == keys.len() - 1 {
        if at >= 0 {
            dict[at] = (key, value);
        } else {
            dict.push((key, value));
        }
        return Ok(dict);
    }
    let child = if at >= 0 {
        dict[at].1.clone()
    } else {
        dict.push((key.clone(), Val.Dict(Vec.new())));
        at = dict.len() - 1;
        Val.Dict(Vec.new())
    };
    match child {
        Val.Dict(inner) => {
            let filled = assign(inner, keys, i + 1, value)?;
            dict[at] = (key, Val.Dict(filled));
            Ok(dict)
        }
        other => {
            let t = type_name(other);
            if i + 1 == keys.len() - 1 {
                Err(py_err("TypeError", f"'{t}' object does not support item assignment"))
            } else {
                Err(py_err("AttributeError", f"'{t}' object has no attribute 'setdefault'"))
            }
        }
    }
}

// _expand_named_fields
fn expand_named(named: ref Vec[(Vec[i64], Val)]) -> Result[Vec[(Vec[i64], Val)], PyErr] {
    let mut result: Vec[(Vec[i64], Val)] = Vec.new();
    for (field, value) in named.iter() {
        let n = index_of(field, 91);
        let mut keys: Vec[Vec[i64]] = Vec.new();
        if n < 0 {
            keys.push(field.clone());
        } else {
            keys.push(slice(field, 0, n));
            for sk in subkeys(slice(field, n, field.len())).iter() {
                keys.push(sk.clone());
            }
        }
        result = assign(result, keys, 0, value.clone())?;
    }
    Ok(result)
}

fn find_conv(p: ref FmtParser, fixed: i64, name: ref Vec[i64]) -> Option[Conv] {
    for c in p.convs.iter() {
        if fixed >= 0 and c.fixed == fixed {
            return Some(c.conv.clone());
        }
        if fixed < 0 and c.fixed < 0 and same(c.name, name) {
            return Some(c.conv.clone());
        }
    }
    None
}

fn raw_val(t: ref Option[Vec[i64]]) -> Val {
    match t {
        Some(s) => Val.Str(s.clone()),
        None => Val.None,
    }
}

// evaluate_result
fn evaluate(rx: mut ref Rx, p: ref FmtParser, prog_names: ref Vec[(Vec[i64], i64)], s: ref Vec[i64], m: ref Found) -> Result[PResult, PyErr] {
    let mut groups: Vec[Option[Vec[i64]]] = Vec.new();
    for (a, b) in m.spans.iter() {
        groups.push(if a < 0 { None } else { Some(slice(s, a, b)) });
    }
    let mut fixed: Vec[Val] = Vec.new();
    for n in p.fixed_fields.iter() {
        if *n >= groups.len() {
            return Err(py_err("IndexError", "list index out of range".to_string()));
        }
        let v = match find_conv(p, *n, Vec.new()) {
            Some(c) => convert(mut rx, c, groups[*n], groups)?,
            None => raw_val(groups[*n]),
        };
        fixed.push(v);
    }
    let mut named: Vec[(Vec[i64], Val)] = Vec.new();
    let mut named_spans: Vec[(Vec[i64], (i64, i64))] = Vec.new();
    for k in p.named_fields.iter() {
        let korig = lookup(p.group_to_name, k).unwrap();
        let g = named_group_in(prog_names, k);
        let text = if g > 0 { groups[g - 1].clone() } else { None };
        let v = match find_conv(p, -1, k) {
            Some(c) => convert(mut rx, c, text, groups)?,
            None => raw_val(text),
        };
        named.push((korig.clone(), v));
        named_spans.push((korig, if g > 0 { m.spans[g - 1] } else { (-1, -1) }));
    }
    let mut fixed_spans: Vec[(i64, (i64, i64))] = Vec.new();
    let mut i = 0;
    while i < p.fixed_fields.len() {
        let n = p.fixed_fields[i];
        if n + 1 > m.spans.len() {
            return Err(py_err("IndexError", "no such group".to_string()));
        }
        fixed_spans.push((i, m.spans[n]));
        i += 1;
    }
    let expanded = expand_named(named)?;
    Ok(PResult { fixed: fixed, named: expanded, named_spans: named_spans, fixed_spans: fixed_spans })
}

fn named_group_in(names: ref Vec[(Vec[i64], i64)], name: ref Vec[i64]) -> i64 {
    for (n, g) in names.iter() {
        if same(n, name) {
            return g;
        }
    }
    -1
}

// FmtParser.parse: the whole string.
fn p_parse(rx: mut ref Rx, p: ref FmtParser, s: ref Vec[i64]) -> Result[Option[PResult], PyErr] {
    let expr = cat_ascii(cat(cps("\\A"), p.expression), "\\Z");
    let pi = match rx_compile(mut rx, expr, p.flags) {
        Ok(i) => i,
        Err(_) => {
            return Err(py_err("NotImplementedError", f"Group names (e.g. (?P<name>) can cause failure, as they are not escaped properly: '{to_string(expr)}'"));
        }
    };
    let (found, names) = {
        let prog = ref rx.progs[pi];
        let mut m = new_matcher(prog, s);
        (find(mut m, prog, 0, false, 1), prog.names.clone())
    };
    match found {
        Some(m) => Ok(Some(evaluate(mut rx, p, names, s, m)?)),
        None => Ok(None),
    }
}

fn search_prog(rx: mut ref Rx, p: ref FmtParser) -> Result[i64, PyErr] {
    match rx_compile(mut rx, p.expression, p.flags) {
        Ok(i) => Ok(i),
        Err(e) => Err(pattern_error(e)),
    }
}

// FmtParser.search, from pos and with the string cut at endpos.
fn p_search(rx: mut ref Rx, p: ref FmtParser, s: ref Vec[i64], pos: i64, endpos: i64) -> Result[Option[PResult], PyErr] {
    let pi = search_prog(mut rx, p)?;
    let end = if endpos < 0 or endpos > s.len() { s.len() } else { endpos };
    let (found, names) = {
        let prog = ref rx.progs[pi];
        let mut m = new_matcher(prog, slice(s, 0, end));
        (find(mut m, prog, pos, false, 0), prog.names.clone())
    };
    match found {
        Some(m) => Ok(Some(evaluate(mut rx, p, names, s, m)?)),
        None => Ok(None),
    }
}

// FmtParser.findall's iterator, run to the end or to the first exception.
fn p_findall(rx: mut ref Rx, p: ref FmtParser, s: ref Vec[i64], pos0: i64, endpos: i64) -> (Vec[PResult], Option[PyErr]) {
    let mut out: Vec[PResult] = Vec.new();
    let pi = match search_prog(mut rx, p) {
        Ok(i) => i,
        Err(e) => return (out, Some(e)),
    };
    let end = if endpos < 0 or endpos > s.len() { s.len() } else { endpos };
    let cut_s = slice(s, 0, end);
    let mut pos = pos0;
    loop {
        let (found, names) = {
            let prog = ref rx.progs[pi];
            let mut m = new_matcher(prog, cut_s);
            (find(mut m, prog, pos, false, 0), prog.names.clone())
        };
        let m = match found {
            Some(m) => m,
            None => break,
        };
        pos = m.end;
        match evaluate(mut rx, p, names, s, m) {
            Ok(r) => out.push(r),
            Err(e) => return (out, Some(e)),
        }
    }
    (out, None)
}
// ------------------------------------------------------------ the unit jobs

fn emit(out: mut ref String, line: ref String) {
    out.push_str(line.as_str());
    out.push('\n');
}

fn show(out: mut ref String, r: ref Option[PResult]) {
    match r {
        Some(r) => {
            emit(mut out, f"  {result_repr(r)}");
            emit(mut out, f"  spans {spans_repr(r)}");
        }
        None => emit(mut out, "  None".to_string()),
    }
}

// "Number,Bool" or "d=Number": the extra_types dict a job passes.
fn extra_of(spec: ref String) -> Vec[(Vec[i64], i64)] {
    let mut out: Vec[(Vec[i64], i64)] = Vec.new();
    if spec.is_empty() {
        return out;
    }
    for item in spec.split(",") {
        let parts: Vec[Str] = item.split("=").collect();
        let (name, conv) = if parts.len() == 2 { (parts[0], parts[1]) } else { (item, item) };
        let key = cps(name);
        let id = extra_id(conv.to_string());
        let mut found = false;
        let mut k = 0;
        while k < out.len() {
            if same(out[k].0, key) {
                out[k] = (key.clone(), id);
                found = true;
            }
            k += 1;
        }
        if not found {
            out.push((key, id));
        }
    }
    out
}

fn header(n: i64, j: ref J) -> String {
    let fmt = cps_of(j_str(j, "fmt"));
    let mut h = f"== {n} {j_str(j, "op")} {repr_of(fmt)}";
    if j_has(j, "s") {
        h = f"{h} {repr_of(cps_of(j_str(j, "s")))}";
    }
    if j_bool(j, "cs") {
        h = f"{h} cs";
    }
    if j_has(j, "pos") {
        h = f"{h} pos={j_int(j, "pos", 0)}";
    }
    if j_has(j, "endpos") {
        h = f"{h} endpos={j_int(j, "endpos", 0)}";
    }
    let extra = j_str(j, "extra");
    if not extra.is_empty() {
        h = f"{h} extra={extra}";
    }
    h
}

fn ints_repr(v: ref Vec[i64]) -> String {
    let parts: Vec[String] = v.iter().map(|x| f"{*x}").collect();
    f"[{parts.join(", ")}]"
}

fn names_repr(v: ref Vec[Vec[i64]]) -> String {
    let parts: Vec[String] = v.iter().map(|x| repr_of(x)).collect();
    f"[{parts.join(", ")}]"
}

fn parser_repr(p: ref FmtParser) -> String {
    if p.format.len() > 20 {
        return f"<Parser {repr_of(cat_ascii(slice(p.format, 0, 17), "..."))}>";
    }
    f"<Parser {repr_of(p.format)}>"
}

fn run_unit(rx: mut ref Rx, j: ref J, out: mut ref String) -> Result[(), PyErr] {
    let op = j_str(j, "op");
    let extra = extra_of(j_str(j, "extra"));
    let fmt = cps_of(j_str(j, "fmt"));
    let s = cps_of(j_str(j, "s"));
    let p = new_parser(mut rx, fmt, extra, j_bool(j, "cs"))?;
    if op == "parse" {
        let r = p_parse(mut rx, p, s)?;
        show(mut out, r);
    } else if op == "search" {
        let r = p_search(mut rx, p, s, j_int(j, "pos", 0), j_int(j, "endpos", -1))?;
        show(mut out, r);
    } else if op == "findall" {
        let (rs, err) = p_findall(mut rx, p, s, j_int(j, "pos", 0), j_int(j, "endpos", -1));
        for r in rs.iter() {
            show(mut out, Some(r.clone()));
        }
        if let Some(e) = err {
            return Err(e);
        }
        emit(mut out, f"  {rs.len()} found");
    } else {
        emit(mut out, f"  {parser_repr(p)}");
        emit(mut out, f"  {to_string(p.expression)}");
        emit(mut out, f"  named {names_repr(p.named_fields)} fixed {ints_repr(p.fixed_fields)}");
    }
    Ok(())
}

fn read_data(name: ref String) -> Vec[i64] {
    match fs.read_to_string(f"data/{name}") {
        Ok(t) => cps_of(t),
        Err(_) => Vec.new(),
    }
}

// read().split("\n")[:-1]
fn file_lines(name: ref String) -> Vec[Vec[i64]] {
    let mut parts = split_on(read_data(name), 10);
    parts.pop();
    parts
}

// ------------------------------------------------------------ a BDD runner

fn money(c: i64) -> String {
    f"${c / 100}.{pad_n(c % 100, 2)}"
}

struct World {
    prices: Vec[(Vec[i64], i64)],
    cart: Vec[(Vec[i64], i64)],
    discount: i64,
    message: Vec[i64],
    stock: Vec[(Vec[i64], i64)],
    last: Option[Val],
}

fn get_count(d: ref Vec[(Vec[i64], i64)], key: ref Vec[i64]) -> Option[i64] {
    for (k, v) in d.iter() {
        if same(k, key) {
            return Some(v);
        }
    }
    None
}

fn set_count(d: mut ref Vec[(Vec[i64], i64)], key: ref Vec[i64], v: i64) {
    let mut k = 0;
    while k < d.len() {
        if same(d[k].0, key) {
            d[k] = (key.clone(), v);
            return;
        }
        k += 1;
    }
    d.push((key.clone(), v));
}

fn del_count(d: mut ref Vec[(Vec[i64], i64)], key: ref Vec[i64]) {
    let mut out: Vec[(Vec[i64], i64)] = Vec.new();
    for (k, v) in d.iter() {
        if not same(k, key) {
            out.push((k.clone(), v));
        }
    }
    *d = out;
}

fn date_text(v: ref Option[Val]) -> String {
    match v {
        Some(Val.Date(y, m, d)) => date_iso(y, m, d),
        _ => "never".to_string(),
    }
}

// The step bodies; Err is a failed assertion.
fn step_impl(name: ref String, w: mut ref World, r: ref PResult) -> Result[(), String] {
    let n = name.as_str();
    if n == "store_sells" or n == "store_sells_quoted" {
        set_count(mut w.prices, get_str(r, "item"), get_int(r, "price"));
    } else if n == "empty_cart" {
        w.cart = Vec.new();
        w.discount = 0;
    } else if n == "add_one" or n == "add_many" {
        let item = get_str(r, "item");
        let qty = match result_get(r, "qty") {
            Some(Val.Int(q)) => q,
            _ => 1,
        };
        if get_count(w.prices, item).is_none() {
            w.message = cps_of(f"we do not sell {to_string(item)}");
        } else {
            let have = get_count(w.cart, item).unwrap_or(0);
            set_count(mut w.cart, item, have + qty);
        }
    } else if n == "remove" {
        let item = get_str(r, "item");
        if get_count(w.cart, item).is_none() {
            return Err(f"{to_string(item)} is not in the cart");
        }
        del_count(mut w.cart, item);
    } else if n == "apply_code" {
        let code = to_string(get_str(r, "code"));
        if code == "SAVE10" {
            w.discount = 10;
        } else if code == "HALF" {
            w.discount = 50;
        } else {
            return Err(f"unknown code {code}");
        }
    } else if n == "cart_count" {
        let mut total = 0;
        for (_, q) in w.cart.iter() {
            total += q;
        }
        let want = get_int(r, "n");
        if total != want {
            return Err(f"expected {want} items, the cart has {total}");
        }
    } else if n == "total" {
        let mut t = 0;
        for (item, q) in w.cart.iter() {
            t += q * get_count(w.prices, item).unwrap_or(0);
        }
        t -= t * w.discount / 100;
        let want = get_int(r, "amount");
        if t != want {
            return Err(f"expected {money(want)}, the total is {money(t)}");
        }
    } else if n == "contains" {
        let item = get_str(r, "item");
        if get_count(w.cart, item).is_none() {
            return Err(f"{to_string(item)} is not in the cart");
        }
    } else if n == "not_contains" {
        let item = get_str(r, "item");
        if get_count(w.cart, item).is_some() {
            return Err(f"{to_string(item)} is in the cart");
        }
    } else if n == "told" {
        let msg = get_str(r, "message");
        if not same(w.message, msg) {
            return Err(f"the last message was {repr_of(w.message)}");
        }
    } else if n == "holds" or n == "arrive" or n == "leave" or n == "holds_check" or n == "out_of_stock" {
        let item = lower_all(get_str(r, "item"));
        let have = get_count(w.stock, item).unwrap_or(0);
        let qty = get_int(r, "qty");
        let it = to_string(item);
        if n == "holds" {
            set_count(mut w.stock, item, qty);
        } else if n == "arrive" {
            set_count(mut w.stock, item, have + qty);
            w.last = result_get(r, "day");
        } else if n == "leave" {
            if qty > have {
                return Err(f"only {have} {it} left");
            }
            set_count(mut w.stock, item, have - qty);
            w.last = result_get(r, "day");
        } else if n == "holds_check" {
            if have != qty {
                return Err(f"the warehouse holds {have} {it}");
            }
        } else if have != 0 {
            return Err(f"{have} {it} left");
        }
    } else if n == "last_move" {
        let day = result_get(r, "day");
        let same_day = match (w.last.clone(), day) {
            (Some(a), Some(b)) => val_eq(a, b),
            _ => false,
        };
        if not same_day {
            return Err(f"the last movement was on {date_text(w.last)}");
        }
    }
    Ok(())
}

struct StepDef {
    kind: String,
    name: String,
    parser: FmtParser,
}

fn load_steps(rx: mut ref Rx) -> Result[Vec[StepDef], PyErr] {
    let mut steps: Vec[StepDef] = Vec.new();
    let extra = vec![(cps("Money"), 7)];
    for line in file_lines("steps.txt".to_string()).iter() {
        let f = split_on(line, 9);
        let p = new_parser(mut rx, f[2], extra, false)?;
        steps.push(StepDef { kind: to_string(f[0]), name: to_string(f[1]), parser: p });
    }
    Ok(steps)
}

struct Scenario {
    title: String,
    steps: Vec[(String, String)],
    outline: bool,
    rows: Vec[Vec[String]],
}

struct Feature {
    name: String,
    background: Vec[(String, String)],
    scenarios: Vec[Scenario],
}

fn keyword_kind(word: ref String) -> Option[String] {
    let l = word.to_lowercase();
    if l == "given" or l == "when" or l == "then" {
        return Some(l);
    }
    if l == "and" or l == "but" {
        return Some(String.new());
    }
    None
}

fn parse_feature(text: ref String) -> Feature {
    let mut f = Feature { name: String.new(), background: Vec.new(), scenarios: Vec.new() };
    // 0 nothing yet, 1 the background, 2 the last scenario
    let mut cur = 0;
    for raw in text.split("\n") {
        let line = raw.trim().to_string();
        if line.is_empty() {
            continue;
        }
        if line.starts_with("Feature:") {
            f.name = after(line, "Feature:");
        } else if line.starts_with("Background:") {
            cur = 1;
        } else if line.starts_with("Scenario Outline:") {
            f.scenarios.push(Scenario { title: after(line, "Scenario Outline:"), steps: Vec.new(), outline: true, rows: Vec.new() });
            cur = 2;
        } else if line.starts_with("Scenario:") {
            f.scenarios.push(Scenario { title: after(line, "Scenario:"), steps: Vec.new(), outline: false, rows: Vec.new() });
            cur = 2;
        } else if line.starts_with("Examples:") {
            continue;
        } else if line.starts_with("|") and cur == 2 and f.scenarios[f.scenarios.len() - 1].outline {
            let inner = strip_bars(line);
            let cells: Vec[String] = inner.split("|").map(|c| c.trim().to_string()).collect();
            let last = f.scenarios.len() - 1;
            f.scenarios[last].rows.push(cells);
        } else if cur != 0 {
            let word = match line.split(" ").next() {
                Some(w) => w.to_string(),
                None => String.new(),
            };
            if keyword_kind(word).is_some() {
                let rest = after(line, word.as_str());
                if cur == 1 {
                    f.background.push((word, rest));
                } else {
                    let last = f.scenarios.len() - 1;
                    f.scenarios[last].steps.push((word, rest));
                }
            }
        }
    }
    f
}

// line[len(prefix):].strip()
fn after(line: ref String, prefix: Str) -> String {
    let c = cps_of(line);
    let n = cps(prefix).len();
    to_string(strip(slice(c, n, c.len())))
}

// line.strip("|")
fn strip_bars(line: ref String) -> String {
    let c = cps_of(line);
    let mut a = 0;
    let mut b = c.len();
    while a < b and c[a] == 124 {
        a += 1;
    }
    while b > a and c[b - 1] == 124 {
        b -= 1;
    }
    to_string(slice(c, a, b))
}

fn expand_outline(sc: ref Scenario) -> Vec[(String, Vec[(String, String)])] {
    let mut out: Vec[(String, Vec[(String, String)])] = Vec.new();
    if not sc.outline {
        out.push((sc.title.clone(), sc.steps.clone()));
        return out;
    }
    let head = sc.rows[0].clone();
    let mut r = 1;
    while r < sc.rows.len() {
        let row = sc.rows[r].clone();
        let mut steps: Vec[(String, String)] = Vec.new();
        for (kw, text) in sc.steps.iter() {
            let mut t = text.clone();
            let mut k = 0;
            while k < head.len() and k < row.len() {
                t = t.replace(f"<{head[k]}>".as_str(), row[k].as_str());
                k += 1;
            }
            steps.push((kw.clone(), t));
        }
        let mut labels: Vec[String] = Vec.new();
        let mut k = 0;
        while k < head.len() and k < row.len() {
            labels.push(f"{head[k]}={row[k]}");
            k += 1;
        }
        out.push((f"{sc.title} [{labels.join(", ")}]", steps));
        r += 1;
    }
    out
}

fn find_step(rx: mut ref Rx, steps: ref Vec[StepDef], kind: ref String, text: ref Vec[i64]) -> Result[Option[(String, PResult)], PyErr] {
    for st in steps.iter() {
        if st.kind != kind {
            continue;
        }
        if let Some(r) = p_parse(mut rx, st.parser, text)? {
            return Ok(Some((st.name.clone(), r)));
        }
    }
    Ok(None)
}

fn run_bdd(rx: mut ref Rx, j: ref J, out: mut ref String) -> Result[(), PyErr] {
    let steps = load_steps(mut rx)?;
    let dry = j_bool(j, "dry");
    // passed, failed, undefined, skipped
    let mut totals = vec![0, 0, 0, 0];
    let mut sc_totals = vec![0, 0, 0];
    for path in j_strs(j, "files").iter() {
        let text = match fs.read_to_string(f"data/{path}") {
            Ok(t) => t,
            Err(_) => String.new(),
        };
        let feature = parse_feature(text);
        emit(mut out, f"Feature: {feature.name}");
        for sc in feature.scenarios.iter() {
            for (title, sc_steps) in expand_outline(sc).iter() {
                emit(mut out, f"  Scenario: {title}");
                let mut w = World { prices: Vec.new(), cart: Vec.new(), discount: 0, message: Vec.new(), stock: Vec.new(), last: None };
                // 0 passed, 1 failed, 2 undefined
                let mut status = 0;
                let mut kind = "given".to_string();
                let mut all = feature.background.clone();
                for st in sc_steps.iter() {
                    all.push(st.clone());
                }
                for (kw, text) in all.iter() {
                    let k = keyword_kind(kw).unwrap_or(String.new());
                    if not k.is_empty() {
                        kind = k;
                    }
                    let line = f"    {kw} {text}";
                    if status != 0 {
                        emit(mut out, f"{line} ... skipped");
                        totals[3] += 1;
                        continue;
                    }
                    let found = match find_step(mut rx, steps, kind, cps_of(text)) {
                        Ok(f) => f,
                        Err(e) => {
                            emit(mut out, f"{line} ... failed: {err_line(e)}");
                            totals[1] += 1;
                            status = 1;
                            continue;
                        }
                    };
                    let (name, r) = match found {
                        Some(x) => x,
                        None => {
                            emit(mut out, f"{line} ... undefined");
                            totals[2] += 1;
                            status = 2;
                            continue;
                        }
                    };
                    if dry {
                        emit(mut out, f"{line} -> {name} {repr_val(Val.Dict(r.named.clone()))}");
                        totals[0] += 1;
                        continue;
                    }
                    match step_impl(name, mut w, r) {
                        Ok(()) => {
                            emit(mut out, f"{line} ... passed");
                            totals[0] += 1;
                        }
                        Err(msg) => {
                            emit(mut out, f"{line} ... failed: {msg}");
                            totals[1] += 1;
                            status = 1;
                        }
                    }
                }
                sc_totals[status] += 1;
            }
        }
    }
    let scs = sc_totals[0] + sc_totals[1] + sc_totals[2];
    emit(mut out, f"{scs} scenarios ({sc_totals[0]} passed, {sc_totals[1]} failed, {sc_totals[2]} undefined)");
    let n = totals[0] + totals[1] + totals[2] + totals[3];
    emit(mut out, f"{n} steps ({totals[0]} passed, {totals[1]} failed, {totals[2]} undefined, {totals[3]} skipped)");
    Ok(())
}

// ------------------------------------------------------------ the log reports

fn bump(d: mut ref Vec[(String, i64)], key: ref String) {
    let mut k = 0;
    while k < d.len() {
        if d[k].0 == key {
            let n = d[k].1;
            d[k] = (key.clone(), n + 1);
            return;
        }
        k += 1;
    }
    d.push((key.clone(), 1));
}

// sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))
fn ranked(d: ref Vec[(String, i64)]) -> Vec[(String, i64)] {
    let mut v = d.clone();
    let mut k = 1;
    while k < v.len() {
        let cur = v[k].clone();
        let mut j = k;
        while j > 0 and (v[j - 1].1 < cur.1 or (v[j - 1].1 == cur.1 and cmp_cps(cps_of(v[j - 1].0), cps_of(cur.0)) > 0)) {
            v[j] = v[j - 1].clone();
            j -= 1;
        }
        v[j] = cur;
        k += 1;
    }
    v
}

fn by_key(d: ref Vec[(String, i64)]) -> Vec[(String, i64)] {
    let mut v = d.clone();
    let mut k = 1;
    while k < v.len() {
        let cur = v[k].clone();
        let mut j = k;
        while j > 0 and cmp_cps(cps_of(v[j - 1].0), cps_of(cur.0)) > 0 {
            v[j] = v[j - 1].clone();
            j -= 1;
        }
        v[j] = cur;
        k += 1;
    }
    v
}

fn cmp_cps(a: ref Vec[i64], b: ref Vec[i64]) -> i64 {
    let mut i = 0;
    while i < a.len() and i < b.len() {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 };
        }
        i += 1;
    }
    if a.len() < b.len() { -1 } else if a.len() > b.len() { 1 } else { 0 }
}

fn joined(d: ref Vec[(String, i64)]) -> String {
    let parts: Vec[String] = d.iter().map(|kv| f"{kv.0}={kv.1}").collect();
    parts.join(" ")
}

fn run_logs(rx: mut ref Rx, j: ref J, out: mut ref String) -> Result[(), PyErr] {
    let p = new_parser(mut rx, cps_of(j_str(j, "fmt")), Vec.new(), false)?;
    let search = j_bool(j, "search");
    let mut status: Vec[(i64, i64)] = Vec.new();
    let mut methods: Vec[(String, i64)] = Vec.new();
    let mut paths: Vec[(String, i64)] = Vec.new();
    let mut days: Vec[(String, i64)] = Vec.new();
    let mut ips: Vec[String] = Vec.new();
    let mut total = 0;
    let mut good = 0;
    let mut first: Option[Moment] = None;
    let mut last: Option[Moment] = None;
    let mut n = 0;
    for line in file_lines(j_str(j, "file")).iter() {
        n += 1;
        let got = if search { p_search(mut rx, p, line, 0, -1) } else { p_parse(mut rx, p, line) };
        let r = match got {
            Ok(Some(r)) => r,
            Ok(None) => {
                emit(mut out, f"line {n}: no match");
                continue;
            }
            Err(e) => {
                emit(mut out, f"line {n}: {err_line(e)}");
                continue;
            }
        };
        good += 1;
        let code = get_int(r, "status");
        let mut k = 0;
        let mut seen = false;
        while k < status.len() {
            if status[k].0 == code {
                let c = status[k].1;
                status[k] = (code, c + 1);
                seen = true;
            }
            k += 1;
        }
        if not seen {
            status.push((code, 1));
        }
        if result_get(r, "method").is_some() {
            bump(mut methods, to_string(get_str(r, "method")));
            bump(mut paths, to_string(get_str(r, "path")));
        }
        let ip = to_string(get_str(r, "ip"));
        if not ips.contains(ip) {
            ips.push(ip);
        }
        let size = get_str(r, "size");
        if not eq_ascii(size, "-") {
            total += py_int(size)?;
        }
        if let Some(Val.DateTime(when)) = result_get(r, "when") {
            bump(mut days, date_iso(when.y, when.mo, when.d));
            let earlier = match first {
                Some(ref f) => dt_instant(when) < dt_instant(f),
                None => true,
            };
            if earlier {
                first = Some(when.clone());
            }
            let later = match last {
                Some(ref l) => dt_instant(when) > dt_instant(l),
                None => true,
            };
            if later {
                last = Some(when.clone());
            }
        }
    }
    emit(mut out, f"{good} requests from {ips.len()} addresses, {total} bytes");
    let mut k = 1;
    while k < status.len() {
        let cur = status[k];
        let mut i = k;
        while i > 0 and status[i - 1].0 > cur.0 {
            status[i] = status[i - 1];
            i -= 1;
        }
        status[i] = cur;
        k += 1;
    }
    let parts: Vec[String] = status.iter().map(|kv| f"{kv.0}={kv.1}").collect();
    emit(mut out, f"status {parts.join(" ")}");
    if methods.len() > 0 {
        emit(mut out, f"methods {joined(ranked(methods))}");
        let mut top = ranked(paths);
        while top.len() > 5 {
            top.pop();
        }
        emit(mut out, f"top paths {joined(top)}");
    }
    emit(mut out, f"days {joined(by_key(days))}");
    let f = match first {
        Some(t) => repr_val(Val.DateTime(t)),
        None => "None".to_string(),
    };
    let l = match last {
        Some(t) => repr_val(Val.DateTime(t)),
        None => "None".to_string(),
    };
    emit(mut out, f"first {f}");
    emit(mut out, f"last {l}");
    Ok(())
}

fn run_applog(rx: mut ref Rx, j: ref J, out: mut ref String) -> Result[(), PyErr] {
    let p = new_parser(mut rx, cps_of(j_str(j, "fmt")), Vec.new(), false)?;
    let served = new_parser(mut rx, cps("request served in {ms:d} ms"), Vec.new(), false)?;
    let mut levels: Vec[(String, i64)] = Vec.new();
    let mut loggers: Vec[(String, i64)] = Vec.new();
    let mut ms: Vec[i64] = Vec.new();
    let mut n = 0;
    for line in file_lines(j_str(j, "file")).iter() {
        n += 1;
        let r = match p_parse(mut rx, p, line) {
            Ok(Some(r)) => r,
            Ok(None) => {
                emit(mut out, f"line {n}: no match");
                continue;
            }
            Err(e) => {
                emit(mut out, f"line {n}: {err_line(e)}");
                continue;
            }
        };
        let level = to_string(get_str(r, "level"));
        let logger = to_string(get_str(r, "logger"));
        bump(mut levels, level);
        bump(mut loggers, logger);
        let message = get_str(r, "message");
        if level == "ERROR" or level == "WARNING" {
            let when = match result_get(r, "when") {
                Some(Val.DateTime(t)) => dt_iso(t),
                _ => String.new(),
            };
            emit(mut out, f"{when} {level} {logger}: {to_string(message)}");
        }
        if let Some(s) = p_search(mut rx, served, message, 0, -1)? {
            ms.push(get_int(s, "ms"));
        }
    }
    emit(mut out, f"levels {joined(by_key(levels))}");
    emit(mut out, f"loggers {joined(ranked(loggers))}");
    if ms.len() > 0 {
        let mut sum = 0;
        let mut max = ms[0];
        for x in ms.iter() {
            sum += *x;
            if *x > max {
                max = *x;
            }
        }
        emit(mut out, f"served {ms.len()} requests, {sum} ms in all, slowest {max} ms");
    }
    Ok(())
}

fn run_scan(rx: mut ref Rx, j: ref J, out: mut ref String) -> Result[(), PyErr] {
    let p = new_parser(mut rx, cps_of(j_str(j, "fmt")), Vec.new(), false)?;
    let text = read_data(j_str(j, "file"));
    let (rs, err) = p_findall(mut rx, p, text, 0, -1);
    for r in rs.iter() {
        show(mut out, Some(r.clone()));
    }
    if let Some(e) = err {
        return Err(e);
    }
    emit(mut out, f"  {rs.len()} found");
    Ok(())
}

fn run() -> Result[(), String] {
    let jobs = match fs.read_to_string("data/jobs.jsonl") {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/jobs.jsonl: {e}"),
    };
    let mut rx = new_rx();
    let mut n = 0;
    for line in jobs.split("\n") {
        if line.is_empty() {
            continue;
        }
        n += 1;
        let j = json_line(line.to_string())?;
        let mut out = String.new();
        emit(mut out, header(n, j));
        let op = j_str(j, "op");
        let res = if op == "bdd" {
            run_bdd(mut rx, j, mut out)
        } else if op == "logs" {
            run_logs(mut rx, j, mut out)
        } else if op == "applog" {
            run_applog(mut rx, j, mut out)
        } else if op == "scan" {
            run_scan(mut rx, j, mut out)
        } else {
            run_unit(mut rx, j, mut out)
        };
        if let Err(e) = res {
            emit(mut out, f"  {err_line(e)}");
        }
        print(out);
    }
    Ok(())
}

// ------------------------------------------------------------ data/

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn hex_val(c: u8) -> u8 {
    if c >= b'a' { c - b'a' + 10 } else { c - b'0' }
}

fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    if let Err(e) = run() {
        eprintln(e);
    }
}
// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    data_part_3(mut v);
    v
}

