    let mut t = String.new();
    t.push_str("Feature: Shopping cart\n");
    t.push_str("  Prices are in dollars and cents.\n");
    t.push_str("\n");
    t.push_str("  Background:\n");
    t.push_str("    Given the store sells apple at $0.50 each\n");
    t.push_str("    And the store sells \"pear\" at $0.75 each\n");
    t.push_str("    And the store sells loaf of bread at $2.25 each\n");
    t.push_str("\n");
    t.push_str("  Scenario: Adding fruit\n");
    t.push_str("    Given an empty cart\n");
    t.push_str("    When I add 3 apple\n");
    t.push_str("    And I add a pear\n");
    t.push_str("    Then the cart has 4 items\n");
    t.push_str("    And the total is $2.25\n");
    t.push_str("\n");
    t.push_str("  Scenario: Removing things\n");
    t.push_str("    Given an empty cart\n");
    t.push_str("    When I add 2 loaf of bread\n");
    t.push_str("    And I add 1 apple\n");
    t.push_str("    And I remove apple\n");
    t.push_str("    Then the cart has 2 items\n");
    t.push_str("    And the cart contains loaf of bread\n");
    t.push_str("    But the cart does not contain apple\n");
    t.push_str("    And the total is $4.50\n");
    t.push_str("\n");
    t.push_str("  Scenario: A discount code\n");
    t.push_str("    Given an empty cart\n");
    t.push_str("    When I add 10 apple\n");
    t.push_str("    And I apply the code SAVE10\n");
    t.push_str("    Then the total is $4.50\n");
    t.push_str("    And the total is $5.00\n");
    t.push_str("    And the cart has 10 items\n");
    t.push_str("\n");
    t.push_str("  Scenario: Things the store does not sell\n");
    t.push_str("    Given an empty cart\n");
    t.push_str("    When I add 2 mango\n");
    t.push_str("    Then the cart has 0 items\n");
    t.push_str("    And I am told \"we do not sell mango\"\n");
    t.push_str("\n");
    t.push_str("  Scenario: Steps nobody wrote\n");
    t.push_str("    Given an empty cart\n");
    t.push_str("    When I juggle 3 apple\n");
    t.push_str("    Then the cart has 0 items\n");
    t.push_str("\n");
    t.push_str("  Scenario Outline: Many apples\n");
    t.push_str("    Given an empty cart\n");
    t.push_str("    When I add <n> apple\n");
    t.push_str("    Then the total is <total>\n");
    t.push_str("    And the cart has <n> items\n");
    t.push_str("\n");
    t.push_str("    Examples:\n");
    t.push_str("      | n  | total  |\n");
    t.push_str("      | 1  | $0.50  |\n");
    t.push_str("      | 4  | $2.00  |\n");
    t.push_str("      | 12 | $6.00  |\n");
    t.push_str("      | 7  | $9.99  |\n");
    v.push(DataFile { path: "features/cart.feature".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("Feature: Inventory\n");
    t.push_str("  Scenario: Receiving stock\n");
    t.push_str("    Given the warehouse holds 10 apple\n");
    t.push_str("    When 5 apple arrive on 2024-03-01\n");
    t.push_str("    And 3 apple leave on 2024-03-02\n");
    t.push_str("    Then the warehouse holds 12 apple\n");
    t.push_str("    And the last movement was on 2024-03-02\n");
    t.push_str("\n");
    t.push_str("  Scenario: Selling out\n");
    t.push_str("    Given the warehouse holds 2 PEAR\n");
    t.push_str("    When 2 pear leave on 2024-02-29\n");
    t.push_str("    Then the warehouse holds 0 pear\n");
    t.push_str("    And pear is out of stock\n");
    t.push_str("\n");
    t.push_str("  Scenario: Dates the calendar does not have\n");
    t.push_str("    Given the warehouse holds 1 plum\n");
    t.push_str("    When 1 plum arrive on 2023-02-29\n");
    t.push_str("    Then the warehouse holds 2 plum\n");
    t.push_str("\n");
    t.push_str("  Scenario: Shouting\n");
    t.push_str("    GIVEN THE WAREHOUSE HOLDS 4 FIG\n");
    t.push_str("    Then the warehouse holds 4 fig\n");
    v.push(DataFile { path: "features/inventory.feature".to_string(), hex: false, body: t });
}

