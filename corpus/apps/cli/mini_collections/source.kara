fn jobs_text() -> String {
    let mut s = String.new();
    s.push_str("counter\tnew a b c a b a|repr|most 2|most|most 0|total|get a|get z|elements|update a z z|repr|subtract a a a a|repr|most 2|del z|repr|pos|neg\n");
    s.push_str("counter\tnew @page.txt|most 5|total|get fox|add fox fox cat|sub the the the the the the the the|and fox dog cat|or fox fox fox fox fox|le the|ge the|eq the|ne the\n");
    s.push_str("counter\tnew|repr|most 3|total|pos|update x|subtract x y|repr|pos|neg|elements|le|eq\n");
    s.push_str("counter\tnew b a b a|repr|most|update a|most|subtract b|most\n");
    s.push_str("deque\t-\tappend 1|append 2|appendleft 0|extend 3 4|extendleft 9 8|len|get 0|get -1|get 3|set 1 7|rotate 2|rotate -3|count 4|index 4|index 99|remove 4|remove 99|reverse|pop|popleft|insert 2 5|clear|pop|popleft|get 0\n");
    s.push_str("deque\t3\tappend 1|append 2|append 3|append 4|appendleft 0|extend 5 6 7 8|extendleft 1 2|insert 1 9|pop|insert 1 9|rotate 1|maxlen|len|clear|maxlen\n");
    s.push_str("deque\t0\tappend 1|appendleft 2|extend 3 4|len|insert 0 1|pop\n");
    s.push_str("deque\t1\tappend 1|append 2|rotate 5|appendleft 3|pop|pop\n");
    s.push_str("deque\t-\textend 1 2 3 4 5|rotate 7|rotate -12|rotate 0|reverse|index 5|count 9|set 9 1|get -6|get -5\n");
    s.push_str("odict\tset a 1|set b 2|set c 3|repr|set a 10|repr|move a last|repr|move c first|repr|get b|get z|del b|repr|del b|keys|popitem last|popitem first|repr|popitem last|popitem first|repr|set z 26|move z first|move q last|repr\n");
    s.push_str("lru\t3\t@trace.txt\n");
    s.push_str("lru\t1\t@trace.txt\n");
    s.push_str("lru\t8\t@trace.txt\n");
    s.push_str("lru\t0\t@trace.txt\n");
    s.push_str("chain\tverbose=1,port=8080\tport=9000,host=example.org\thost=localhost,port=80,debug=0\tget port|get host|get debug|get user|in verbose|in user|len|keys|repr|set debug 1|keys|repr|del host|del port|keys|repr|pop verbose|pop verbose|child|set port 1|repr|parents|get port|len\n");
    s.push_str("chain\t-\t-\tget x|len|keys|set x 1|repr|del x|del x|repr\n");
    s.push_str("group\t@access.log\n");
    s.push_str("tail\t3\t@access.log\n");
    s.push_str("tail\t1\t@access.log\n");
    s.push_str("tail\t20\t@access.log\n");
    s.push_str("tail\t0\t@access.log\n");
    s
}
