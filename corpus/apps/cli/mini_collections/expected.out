  most = [('a', 3), ('b', 1)]
== deque | - | append 1|append 2|appendleft 0|extend 3 4|extendleft 9 8|len|get 0|get -1|get 3|set 1 7|rotate 2|rotate -3|count 4|index 4|index 99|remove 4|remove 99|reverse|pop|popleft|insert 2 5|clear|pop|popleft|get 0
  append 1 -> deque([1])
  append 2 -> deque([1, 2])
  appendleft 0 -> deque([0, 1, 2])
  extend 3 4 -> deque([0, 1, 2, 3, 4])
  extendleft 9 8 -> deque([8, 9, 0, 1, 2, 3, 4])
  len = 7 -> deque([8, 9, 0, 1, 2, 3, 4])
  get 0 = 8 -> deque([8, 9, 0, 1, 2, 3, 4])
  get -1 = 4 -> deque([8, 9, 0, 1, 2, 3, 4])
  get 3 = 1 -> deque([8, 9, 0, 1, 2, 3, 4])
  set 1 7 -> deque([8, 7, 0, 1, 2, 3, 4])
  rotate 2 -> deque([3, 4, 8, 7, 0, 1, 2])
  rotate -3 -> deque([7, 0, 1, 2, 3, 4, 8])
  count 4 = 1 -> deque([7, 0, 1, 2, 3, 4, 8])
  index 4 = 5 -> deque([7, 0, 1, 2, 3, 4, 8])
  index 99: ValueError: 99 is not in deque
  remove 4 -> deque([7, 0, 1, 2, 3, 8])
  remove 99: ValueError: 99 is not in deque
  reverse -> deque([8, 3, 2, 1, 0, 7])
  pop = 7 -> deque([8, 3, 2, 1, 0])
  popleft = 8 -> deque([3, 2, 1, 0])
  insert 2 5 -> deque([3, 2, 5, 1, 0])
  clear -> deque([])
  pop: IndexError: pop from an empty deque
  popleft: IndexError: pop from an empty deque
  get 0: IndexError: deque index out of range
== deque | 3 | append 1|append 2|append 3|append 4|appendleft 0|extend 5 6 7 8|extendleft 1 2|insert 1 9|pop|insert 1 9|rotate 1|maxlen|len|clear|maxlen
  append 1 -> deque([1], maxlen=3)
  append 2 -> deque([1, 2], maxlen=3)
  append 3 -> deque([1, 2, 3], maxlen=3)
  append 4 -> deque([2, 3, 4], maxlen=3)
  appendleft 0 -> deque([0, 2, 3], maxlen=3)
  extend 5 6 7 8 -> deque([6, 7, 8], maxlen=3)
  extendleft 1 2 -> deque([2, 1, 6], maxlen=3)
  insert 1 9: IndexError: deque already at its maximum size
  pop = 6 -> deque([2, 1], maxlen=3)
  insert 1 9 -> deque([2, 9, 1], maxlen=3)
  rotate 1 -> deque([1, 2, 9], maxlen=3)
  maxlen = 3 -> deque([1, 2, 9], maxlen=3)
  len = 3 -> deque([1, 2, 9], maxlen=3)
  clear -> deque([], maxlen=3)
  maxlen = 3 -> deque([], maxlen=3)
== deque | 0 | append 1|appendleft 2|extend 3 4|len|insert 0 1|pop
  append 1 -> deque([], maxlen=0)
  appendleft 2 -> deque([], maxlen=0)
  extend 3 4 -> deque([], maxlen=0)
  len = 0 -> deque([], maxlen=0)
  insert 0 1: IndexError: deque already at its maximum size
  pop: IndexError: pop from an empty deque
== deque | 1 | append 1|append 2|rotate 5|appendleft 3|pop|pop
  append 1 -> deque([1], maxlen=1)
  append 2 -> deque([2], maxlen=1)
  rotate 5 -> deque([2], maxlen=1)
  appendleft 3 -> deque([3], maxlen=1)
  pop = 3 -> deque([], maxlen=1)
  pop: IndexError: pop from an empty deque
== deque | - | extend 1 2 3 4 5|rotate 7|rotate -12|rotate 0|reverse|index 5|count 9|set 9 1|get -6|get -5
  extend 1 2 3 4 5 -> deque([1, 2, 3, 4, 5])
  rotate 7 -> deque([4, 5, 1, 2, 3])
  rotate -12 -> deque([1, 2, 3, 4, 5])
  rotate 0 -> deque([1, 2, 3, 4, 5])
  reverse -> deque([5, 4, 3, 2, 1])
  index 5 = 0 -> deque([5, 4, 3, 2, 1])
  count 9 = 0 -> deque([5, 4, 3, 2, 1])
  set 9 1: IndexError: deque index out of range
  get -6: IndexError: deque index out of range
  get -5 = 5 -> deque([5, 4, 3, 2, 1])
== odict | set a 1|set b 2|set c 3|repr|set a 10|repr|move a last|repr|move c first|repr|get b|get z|del b|repr|del b|keys|popitem last|popitem first|repr|popitem last|popitem first|repr|set z 26|move z first|move q last|repr
  set a 1 -> OrderedDict({'a': 1})
  set b 2 -> OrderedDict({'a': 1, 'b': 2})
  set c 3 -> OrderedDict({'a': 1, 'b': 2, 'c': 3})
  repr -> OrderedDict({'a': 1, 'b': 2, 'c': 3})
  set a 10 -> OrderedDict({'a': 10, 'b': 2, 'c': 3})
  repr -> OrderedDict({'a': 10, 'b': 2, 'c': 3})
  move a last -> OrderedDict({'b': 2, 'c': 3, 'a': 10})
  repr -> OrderedDict({'b': 2, 'c': 3, 'a': 10})
  move c first -> OrderedDict({'c': 3, 'b': 2, 'a': 10})
  repr -> OrderedDict({'c': 3, 'b': 2, 'a': 10})
  get b = 2 -> OrderedDict({'c': 3, 'b': 2, 'a': 10})
  get z: KeyError: 'z'
  del b -> OrderedDict({'c': 3, 'a': 10})
  repr -> OrderedDict({'c': 3, 'a': 10})
  del b: KeyError: 'b'
  keys = ['c', 'a'] -> OrderedDict({'c': 3, 'a': 10})
  popitem last = ('a', 10) -> OrderedDict({'c': 3})
  popitem first = ('c', 3) -> OrderedDict()
  repr -> OrderedDict()
  popitem last: KeyError: 'dictionary is empty'
  popitem first: KeyError: 'dictionary is empty'
  repr -> OrderedDict()
  set z 26 -> OrderedDict({'z': 26})
  move z first -> OrderedDict({'z': 26})
  move q last: KeyError: 'q'
  repr -> OrderedDict({'z': 26})
