  Counter({'a': 3, 'b': 2, 'c': 1})
  most 2 = [('a', 3), ('b', 2)]
  most = [('a', 3), ('b', 2), ('c', 1)]
  most 0 = []
  total = 6
  get a = 3
  get z = 0
  elements = ['a', 'a', 'a', 'b', 'b', 'c']
  update a z z -> Counter({'a': 4, 'b': 2, 'z': 2, 'c': 1})
  Counter({'a': 4, 'b': 2, 'z': 2, 'c': 1})
  subtract a a a a -> Counter({'b': 2, 'z': 2, 'c': 1, 'a': 0})
  Counter({'b': 2, 'z': 2, 'c': 1, 'a': 0})
  most 2 = [('b', 2), ('z', 2)]
  del z -> Counter({'b': 2, 'c': 1, 'a': 0})
  Counter({'b': 2, 'c': 1, 'a': 0})
  +c = Counter({'b': 2, 'c': 1})
  -c = Counter()
