// mini_ijson: a port of ijson 3.3.0 (BSD-3-Clause; Ivan Sagalaev and
// Rodrigo Tobar), the iterative JSON parser that ETL jobs, log shippers and
// API clients use to walk a JSON document too large to load: it reads the
// input a chunk at a time and hands out parse events, prefixed events,
// the objects found under a prefix, or the key-value pairs of an object.
// This is the library's pure Python backend, the one every installation
// has.
//
// It replays data/jobs.tsv (see mk.py) over a shop's order export, its
// catalog, a JSON-lines event log and some damaged files: every event of
// the four interfaces, the number and string rules with their exact
// errors, how the chunk size decides which events come out before an
// error, the push interface a network reader drives, and the library's
// dump tool. Then four programs: a revenue report in exact decimals, a
// latency summary of the event log, a schema survey and a JSON-lines
// extractor.
//
// The library is a chain of Python coroutines: a UTF-8 decoder feeds a
// lexer, which feeds a parser, which feeds the prefix tracker and the
// object builders. Each coroutine is a state machine here that keeps the
// place where the Python one waits for its next value, so a lexeme split
// across two chunks, a character split across two reads, and the events
// a failing chunk takes with it all come out as they do in Python.

// ------------------------------------------------------------ text helpers

fn hex_val(c: char) -> i64 {
    if c >= '0' and c <= '9' {
        c as i64 - 48
    } else if c >= 'a' and c <= 'f' {
        c as i64 - 87
    } else if c >= 'A' and c <= 'F' {
        c as i64 - 55
    } else {
        -1
    }
}

fn hex_bytes(s: ref String) -> Vec[u8] {
    let cs: Vec[char] = s.chars().collect();
    let mut bytes: Vec[u8] = Vec.new();
    let mut k = 0;
    while k + 1 < cs.len() {
        bytes.push((hex_val(cs[k]) * 16 + hex_val(cs[k + 1])) as u8);
        k += 2;
    }
    bytes
}

fn hex_string(s: ref String) -> String {
    match String.from_utf8(hex_bytes(s)) {
        Ok(t) => t,
        Err(_) => String.new(),
    }
}

fn split_on(s: ref String, sep: char) -> Vec[String] {
    let mut pieces: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            pieces.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    pieces.push(cur);
    pieces
}

fn join_strs(xs: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    let mut first = true;
    for x in xs {
        if not first {
            out.push_str(sep);
        }
        out.push_str(x);
        first = false;
    }
    out
}

fn atoi(s: ref String) -> i64 {
    match i64.parse(s.clone()) {
        Ok(n) => n,
        Err(_) => 0,
    }
}

fn chr(n: i64) -> char {
    match char.try_from(n) {
        Ok(c) => c,
        Err(_) => '?',
    }
}

const HEX: Str = "0123456789abcdef";

fn hex2(n: i64) -> String {
    let ds: Vec[char] = HEX.chars().collect();
    let mut out = String.new();
    out.push(ds[(n / 16) % 16]);
    out.push(ds[n % 16]);
    out
}

fn hexn(n: i64, width: i64) -> String {
    let ds: Vec[char] = HEX.chars().collect();
    let mut digits: Vec[char] = Vec.new();
    let mut m = n;
    while m > 0 {
        digits.push(ds[m % 16]);
        m = m / 16;
    }
    while digits.len() < width {
        digits.push('0');
    }
    let mut out = String.new();
    let mut i = digits.len() - 1;
    while i >= 0 {
        out.push(digits[i]);
        i -= 1;
    }
    out
}

fn pad_left(s: ref String, n: i64) -> String {
    let mut out = String.new();
    let mut k = s.chars().count();
    while k < n {
        out.push(' ');
        k += 1;
    }
    out.push_str(s);
    out
}

fn pad_right(s: ref String, n: i64) -> String {
    let mut out = s.clone();
    let mut k = s.chars().count();
    while k < n {
        out.push(' ');
        k += 1;
    }
    out
}

fn zpad(n: i64, w: i64) -> String {
    let s = f"{n}";
    let mut out = String.new();
    let mut k = s.len();
    while k < w {
        out.push('0');
        k += 1;
    }
    out.push_str(s);
    out
}

// Whether str.isprintable() holds, for the characters the code pages here

// Whether str.isprintable() holds: the controls, the C1 range, the spaces
// other than U+0020, the line and paragraph separators, the format
// characters and the private use area are not printable.
fn printable(n: i64) -> bool {
    if n < 32 or (n >= 127 and n <= 160) or n == 173 or n == 0x1680 {
        return false;
    }
    if (n >= 0x2000 and n <= 0x200F) or (n >= 0x2028 and n <= 0x202F) or (n >= 0x205F and n <= 0x2064) {
        return false;
    }
    if n == 0x3000 or n == 0xFEFF or (n >= 0xFFF9 and n <= 0xFFFB) {
        return false;
    }
    not (n >= 0xE000 and n <= 0xF8FF)
}

// repr() of a str.
fn str_repr(s: ref String) -> String {
    let q = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        let n = c as i64;
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if not printable(n) {
            if n < 256 {
                out.push_str("\\x");
                out.push_str(hex2(n));
            } else if n < 0x10000 {
                out.push_str("\\u");
                out.push_str(hexn(n, 4));
            } else {
                out.push_str("\\U");
                out.push_str(hexn(n, 8));
            }
        } else {
            out.push(c);
        }
    }
    out.push(q);
    out
}

fn sub(b: ref Vec[u8], from: i64, to: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut i = from;
    while i < to {
        out.push(b[i]);
        i += 1;
    }
    out
}

fn chars_str(cs: ref Vec[char], from: i64, to: i64) -> String {
    let mut out = String.new();
    let mut i = from;
    while i < to {
        out.push(cs[i]);
        i += 1;
    }
    out
}

// ------------------------------------------------------------ exceptions

// A Python exception: the class as the job output names it and str(e).
struct Exc {
    cls: String,
    msg: String,
}

fn exc(cls: Str, msg: own String) -> Exc {
    Exc { cls: cls.to_string(), msg: msg }
}

fn json_error(msg: own String) -> Exc {
    exc("ijson.common.JSONError", msg)
}

fn incomplete(msg: own String) -> Exc {
    exc("ijson.common.IncompleteJSONError", msg)
}

fn unexpected(sym: ref String, pos: i64) -> Exc {
    exc("ijson.backends.python.UnexpectedSymbol", f"Unexpected symbol {str_repr(sym)} at {pos}")
}

fn not_found(path: ref String) -> Exc {
    exc("FileNotFoundError", f"[Errno 2] No such file or directory: {str_repr(path)}")
}

fn err_line(e: ref Exc) -> String {
    f"error {e.cls}: {e.msg}"
}

// ------------------------------------------------------------ values

// A Python value the parser can produce. Int keeps the digits, so the
// arbitrary-size integers JSON allows print as Python prints them; Dec is
// a decimal.Decimal as sign, coefficient digits and exponent; Map keeps
// its keys in insertion order, as dict does.
#[derive(Clone)]
enum Val {
    Non,
    Bool(bool),
    Int(String),
    Dec(bool, String, i64),
    Float(f64),
    Str(String),
    List(Vec[Val]),
    Map(Vec[String], Vec[Val]),
}

// The event names.
const EV_NULL: i64 = 0;
const EV_BOOLEAN: i64 = 1;
const EV_NUMBER: i64 = 2;
const EV_STRING: i64 = 3;
const EV_MAP_KEY: i64 = 4;
const EV_START_MAP: i64 = 5;
const EV_END_MAP: i64 = 6;
const EV_START_ARRAY: i64 = 7;
const EV_END_ARRAY: i64 = 8;

fn ev_name(k: i64) -> String {
    let s = if k == EV_NULL {
        "null"
    } else if k == EV_BOOLEAN {
        "boolean"
    } else if k == EV_NUMBER {
        "number"
    } else if k == EV_STRING {
        "string"
    } else if k == EV_MAP_KEY {
        "map_key"
    } else if k == EV_START_MAP {
        "start_map"
    } else if k == EV_END_MAP {
        "end_map"
    } else if k == EV_START_ARRAY {
        "start_array"
    } else {
        "end_array"
    };
    s.to_string()
}

// What one of the four interfaces hands out.
#[derive(Clone)]
enum Out {
    Basic(i64, Val),
    Parsed(String, i64, Val),
    Item(Val),
    Pair(String, Val),
}

// Decimal.__str__: the to-scientific-string rules of the decimal spec.
fn sci_string(neg: bool, digits: ref String, exp: i64) -> String {
    let mut out = String.new();
    if neg {
        out.push('-');
    }
    let n = digits.len();
    let adjusted = exp + n - 1;
    if exp <= 0 and adjusted >= -6 {
        if exp == 0 {
            out.push_str(digits);
        } else if n + exp > 0 {
            out.push_str(digits.substring(0, n + exp));
            out.push('.');
            out.push_str(digits.substring(n + exp, n));
        } else {
            out.push_str("0.");
            let mut k = n + exp;
            while k < 0 {
                out.push('0');
                k += 1;
            }
            out.push_str(digits);
        }
        return out;
    }
    out.push_str(digits.substring(0, 1));
    if n > 1 {
        out.push('.');
        out.push_str(digits.substring(1, n));
    }
    out.push('E');
    if adjusted >= 0 {
        out.push('+');
    }
    out.push_str(f"{adjusted}");
    out
}

#[allow(mutual_recursion_note)]
fn dict_repr(keys: ref Vec[String], vals: ref Vec[Val], od: bool) -> String {
    let mut out = String.new();
    if od {
        if keys.len() == 0 {
            return "OrderedDict()".to_string();
        }
        out.push_str("OrderedDict(");
    }
    out.push('{');
    let mut i = 0;
    while i < keys.len() {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(str_repr(keys[i]));
        out.push_str(": ");
        out.push_str(repr(vals[i], od));
        i += 1;
    }
    out.push('}');
    if od {
        out.push(')');
    }
    out
}

// repr() of a value; od says the maps are OrderedDicts (map_type=OrderedDict).
fn repr(v: ref Val, od: bool) -> String {
    match v {
        Val.Non => "None".to_string(),
        Val.Bool(b) => if b { "True".to_string() } else { "False".to_string() },
        Val.Int(s) => s.clone(),
        Val.Dec(neg, d, e) => f"Decimal('{sci_string(neg, d, e)}')",
        Val.Float(x) => f"{x}",
        Val.Str(s) => str_repr(s),
        Val.List(xs) => {
            let mut out = String.new();
            out.push('[');
            let mut i = 0;
            while i < xs.len() {
                if i > 0 {
                    out.push_str(", ");
                }
                out.push_str(repr(xs[i], od));
                i += 1;
            }
            out.push(']');
            out
        }
        Val.Map(ks, vs) => dict_repr(ks, vs, od),
    }
}

// str() of a value.
fn val_str(v: ref Val) -> String {
    match v {
        Val.Str(s) => s.clone(),
        Val.Dec(neg, d, e) => sci_string(neg, d, e),
        _ => repr(v, false),
    }
}

fn out_repr(o: ref Out, od: bool) -> String {
    match o {
        Out.Basic(k, v) => f"({str_repr(ev_name(k))}, {repr(v, od)})",
        Out.Parsed(p, k, v) => f"({str_repr(p)}, {str_repr(ev_name(k))}, {repr(v, od)})",
        Out.Item(v) => repr(v, od),
        Out.Pair(k, v) => f"({str_repr(k)}, {repr(v, od)})",
    }
}

// The value at key k of a map, if it is one.
fn get(v: ref Val, k: Str) -> Option[Val] {
    match v {
        Val.Map(ks, vs) => {
            let mut i = 0;
            while i < ks.len() {
                if ks[i] == k {
                    return Some(vs[i].clone());
                }
                i += 1;
            }
            None
        }
        _ => None,
    }
}

fn get_str(v: ref Val, k: Str) -> String {
    match get(v, k) {
        Some(Val.Str(s)) => s,
        _ => String.new(),
    }
}

// ------------------------------------------------------------ json.dumps

fn json_string(s: ref String) -> String {
    let mut out = String.new();
    out.push('"');
    for c in s.chars() {
        let n = c as i64;
        if c == '"' {
            out.push_str("\\\"");
        } else if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if n == 8 {
            out.push_str("\\b");
        } else if n == 12 {
            out.push_str("\\f");
        } else if n < 32 or (n > 126 and n < 0x10000) {
            out.push_str("\\u");
            out.push_str(hexn(n, 4));
        } else if n >= 0x10000 {
            let m = n - 0x10000;
            out.push_str("\\u");
            out.push_str(hexn(0xD800 + m / 1024, 4));
            out.push_str("\\u");
            out.push_str(hexn(0xDC00 + m % 1024, 4));
        } else {
            out.push(c);
        }
    }
    out.push('"');
    out
}

// json.dumps(v) with its defaults (ensure_ascii, ", " and ": ").
fn dumps(v: ref Val) -> String {
    match v {
        Val.Non => "null".to_string(),
        Val.Bool(b) => if b { "true".to_string() } else { "false".to_string() },
        Val.Int(s) => s.clone(),
        Val.Dec(neg, d, e) => sci_string(neg, d, e),
        Val.Float(x) => f"{x}",
        Val.Str(s) => json_string(s),
        Val.List(xs) => {
            let mut parts: Vec[String] = Vec.new();
            for x in xs {
                parts.push(dumps(x));
            }
            f"[{join_strs(parts, ", ")}]"
        }
        Val.Map(ks, vs) => {
            let mut parts: Vec[String] = Vec.new();
            let mut i = 0;
            while i < ks.len() {
                parts.push(f"{json_string(ks[i])}: {dumps(vs[i])}");
                i += 1;
            }
            f"{{{join_strs(parts, ", ")}}}"
        }
    }
}

// ------------------------------------------------------------ ObjectBuilder

// One container the builder has open, and the key it went in under.
struct Frame {
    is_map: bool,
    keys: Vec[String],
    vals: Vec[Val],
    attach: String,
}

// common.ObjectBuilder. Python puts a container into its parent when it
// opens; here it goes in when it closes, under the key that was current
// when it opened, which gives the same object.
struct Builder {
    stack: Vec[Frame],
    key: String,
    value: Val,
}

fn builder_new() -> Builder {
    Builder { stack: Vec.new(), key: String.new(), value: Val.Non }
}

fn map_set(f: mut ref Frame, k: ref String, v: own Val) {
    let mut i = 0;
    while i < f.keys.len() {
        if f.keys[i] == *k {
            f.vals[i] = v;
            return;
        }
        i += 1;
    }
    f.keys.push(k.clone());
    f.vals.push(v);
}

fn put(b: mut ref Builder, v: own Val, k: ref String) {
    let n = b.stack.len();
    if n == 0 {
        b.value = v;
    } else if b.stack[n - 1].is_map {
        map_set(mut b.stack[n - 1], k, v);
    } else {
        b.stack[n - 1].vals.push(v);
    }
}

fn builder_event(b: mut ref Builder, kind: i64, v: ref Val) {
    if kind == EV_MAP_KEY {
        b.key = match v {
            Val.Str(s) => s.clone(),
            _ => String.new(),
        };
    } else if kind == EV_START_MAP or kind == EV_START_ARRAY {
        b.stack.push(Frame { is_map: kind == EV_START_MAP, keys: Vec.new(), vals: Vec.new(), attach: b.key.clone() });
    } else if kind == EV_END_MAP or kind == EV_END_ARRAY {
        match b.stack.pop() {
            Some(f) => {
                let at = f.attach.clone();
                let done = if f.is_map { Val.Map(f.keys, f.vals) } else { Val.List(f.vals) };
                put(mut b, done, at);
            }
            None => {}
        }
    } else {
        let k = b.key.clone();
        put(mut b, v.clone(), k);
    }
}

// ------------------------------------------------------------ UTF-8

fn is_cont(x: u8) -> bool {
    x >= 0x80 and x <= 0xBF
}

fn decode_error(b: ref Vec[u8], from: i64, to: i64, why: Str) -> Exc {
    if to - from == 1 {
        exc("UnicodeDecodeError", f"'utf-8' codec can't decode byte 0x{hex2(b[from] as i64)} in position {from}: {why}")
    } else {
        exc("UnicodeDecodeError", f"'utf-8' codec can't decode bytes in position {from}-{to - 1}: {why}")
    }
}

// The incremental UTF-8 decoder's decode(b, final): the text and how many
// bytes it used. A sequence cut off at the end waits for the next call
// unless final; any other bad byte is an error with CPython's message.
fn decode_utf8(b: ref Vec[u8], is_final: bool) -> Result[(String, i64), Exc] {
    let mut out = String.new();
    let n = b.len();
    let mut i = 0;
    while i < n {
        let x = b[i] as i64;
        if x < 0x80 {
            out.push(chr(x));
            i += 1;
            continue;
        }
        let need = if x >= 0xC2 and x <= 0xDF { 1 } else if x >= 0xE0 and x <= 0xEF { 2 } else if x >= 0xF0 and x <= 0xF4 { 3 } else { 0 };
        if need == 0 {
            return Err(decode_error(b, i, i + 1, "invalid start byte"));
        }
        let mut good = 0;
        let mut k = 1;
        while k <= need and i + k < n {
            let y = b[i + k];
            let ok = if k == 1 and x == 0xE0 {
                y >= 0xA0 and y <= 0xBF
            } else if k == 1 and x == 0xED {
                y >= 0x80 and y <= 0x9F
            } else if k == 1 and x == 0xF0 {
                y >= 0x90 and y <= 0xBF
            } else if k == 1 and x == 0xF4 {
                y >= 0x80 and y <= 0x8F
            } else {
                is_cont(y)
            };
            if not ok {
                break;
            }
            good += 1;
            k += 1;
        }
        if good == need {
            let mut cp = if need == 1 { x - 0xC0 } else if need == 2 { x - 0xE0 } else { x - 0xF0 };
            let mut j = 1;
            while j <= need {
                cp = cp * 64 + (b[i + j] as i64 - 0x80);
                j += 1;
            }
            out.push(chr(cp));
            i += need + 1;
            continue;
        }
        if i + 1 + good >= n {
            if not is_final {
                return Ok((out, i));
            }
            return Err(decode_error(b, i, n, "unexpected end of data"));
        }
        return Err(decode_error(b, i, i + 1 + good, "invalid continuation byte"));
    }
    Ok((out, n))
}

// ------------------------------------------------------------ scanstring

// json.decoder.JSONDecodeError for a position in the string lexeme.
fn decode_json_error(msg: Str, doc: ref Vec[char], pos: i64) -> Exc {
    let mut line = 1;
    let mut last_nl = -1;
    let mut i = 0;
    while i < pos {
        if doc[i] == '\n' {
            line += 1;
            last_nl = i;
        }
        i += 1;
    }
    exc("json.decoder.JSONDecodeError", f"{msg}: line {line} column {pos - last_nl} (char {pos})")
}

fn hex4(s: ref Vec[char], at: i64) -> i64 {
    let mut v = 0;
    let mut i = at;
    while i < at + 4 {
        let d = hex_val(s[i]);
        if d < 0 {
            return -1;
        }
        v = v * 16 + d;
        i += 1;
    }
    v
}

// scanstring(symbol, 1)[0], as CPython's C scanner does it with strict
// on. A lone surrogate, which a str can hold and a String cannot, comes
// out as U+FFFD; no input here has one.
fn parse_string(sym: ref String) -> Result[String, Exc] {
    let s: Vec[char] = sym.chars().collect();
    let len = s.len();
    let begin = 0;
    let mut end = 1;
    let mut out = String.new();
    loop {
        let mut next = end;
        let mut c = ' ';
        let mut found = false;
        while next < len {
            c = s[next];
            if c == '"' or c == '\\' {
                found = true;
                break;
            }
            if (c as i64) <= 0x1f {
                return Err(decode_json_error("Invalid control character at", s, next));
            }
            out.push(c);
            next += 1;
        }
        if not found {
            return Err(decode_json_error("Unterminated string starting at", s, begin));
        }
        next += 1;
        if c == '"' {
            break;
        }
        if next == len {
            return Err(decode_json_error("Unterminated string starting at", s, begin));
        }
        let e = s[next];
        if e != 'u' {
            end = next + 1;
            if e == '"' or e == '\\' or e == '/' {
                out.push(e);
            } else if e == 'b' {
                out.push(chr(8));
            } else if e == 'f' {
                out.push(chr(12));
            } else if e == 'n' {
                out.push('\n');
            } else if e == 'r' {
                out.push('\r');
            } else if e == 't' {
                out.push('\t');
            } else {
                return Err(decode_json_error("Invalid \\escape", s, end - 2));
            }
            continue;
        }
        next += 1;
        end = next + 4;
        if end >= len {
            return Err(decode_json_error("Invalid \\uXXXX escape", s, next - 1));
        }
        let mut cp = hex4(s, next);
        if cp < 0 {
            return Err(decode_json_error("Invalid \\uXXXX escape", s, end - 5));
        }
        if cp >= 0xD800 and cp <= 0xDBFF and end + 6 < len and s[end] == '\\' and s[end + 1] == 'u' {
            end += 6;
            let c2 = hex4(s, end - 4);
            if c2 < 0 {
                return Err(decode_json_error("Invalid \\uXXXX escape", s, end - 5));
            }
            if c2 >= 0xDC00 and c2 <= 0xDFFF {
                cp = 0x10000 + (cp - 0xD800) * 1024 + (c2 - 0xDC00);
            } else {
                end -= 6;
            }
        }
        if cp >= 0xD800 and cp <= 0xDFFF {
            out.push(chr(0xFFFD));
        } else {
            out.push(chr(cp));
        }
    }
    Ok(out)
}

// ------------------------------------------------------------ numbers

fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn has_char(cs: ref Vec[char], x: char) -> bool {
    for c in cs {
        if *c == x {
            return true;
        }
    }
    false
}

// int(symbol), for a lexeme with no '.', 'e' or 'E': a sign and digits.
fn py_int(cs: ref Vec[char]) -> Option[Val] {
    let mut i = 0;
    let mut neg = false;
    if i < cs.len() and (cs[i] == '+' or cs[i] == '-') {
        neg = cs[i] == '-';
        i += 1;
    }
    if i >= cs.len() {
        return None;
    }
    let mut digits = String.new();
    while i < cs.len() {
        if not is_digit(cs[i]) {
            return None;
        }
        if not (digits.len() == 0 and cs[i] == '0') {
            digits.push(cs[i]);
        }
        i += 1;
    }
    // CPython refuses to convert more than 4300 digits.
    if digits.len() > 4300 {
        return None;
    }
    if digits.len() == 0 {
        return Some(Val.Int("0".to_string()));
    }
    Some(Val.Int(if neg { f"-{digits}" } else { digits }))
}

// The parts of a decimal literal: sign, integer digits, fraction digits,
// exponent; None unless the whole lexeme is one.
fn literal(cs: ref Vec[char]) -> Option[(bool, String, String, i64)] {
    let mut i = 0;
    let mut neg = false;
    if i < cs.len() and (cs[i] == '+' or cs[i] == '-') {
        neg = cs[i] == '-';
        i += 1;
    }
    let mut ip = String.new();
    while i < cs.len() and is_digit(cs[i]) {
        ip.push(cs[i]);
        i += 1;
    }
    let mut fp = String.new();
    if i < cs.len() and cs[i] == '.' {
        i += 1;
        while i < cs.len() and is_digit(cs[i]) {
            fp.push(cs[i]);
            i += 1;
        }
    }
    if ip.len() == 0 and fp.len() == 0 {
        return None;
    }
    let mut ex = 0;
    if i < cs.len() and (cs[i] == 'e' or cs[i] == 'E') {
        i += 1;
        let mut eneg = false;
        if i < cs.len() and (cs[i] == '+' or cs[i] == '-') {
            eneg = cs[i] == '-';
            i += 1;
        }
        let mut digits = 0;
        while i < cs.len() and is_digit(cs[i]) {
            if ex < 100000000000 {
                ex = ex * 10 + (cs[i] as i64 - 48);
            }
            digits += 1;
            i += 1;
        }
        if digits == 0 {
            return None;
        }
        if eneg {
            ex = -ex;
        }
    }
    if i != cs.len() {
        return None;
    }
    Some((neg, ip, fp, ex))
}

// decimal.Decimal(symbol).
fn py_decimal(cs: ref Vec[char]) -> Option[Val] {
    match literal(cs) {
        Some((neg, ip, fp, ex)) => {
            let mut digits = String.new();
            for c in f"{ip}{fp}".chars() {
                if not (digits.len() == 0 and c == '0') {
                    digits.push(c);
                }
            }
            if digits.len() == 0 {
                digits.push('0');
            }
            Some(Val.Dec(neg, digits, ex - fp.len()))
        }
        None => None,
    }
}

// float(symbol).
fn py_float(cs: ref Vec[char]) -> Option[Val] {
    match literal(cs) {
        Some((neg, ip, fp, ex)) => {
            let sign = if neg { "-" } else { "" };
            let i2 = if ip.len() == 0 { "0".to_string() } else { ip };
            let f2 = if fp.len() == 0 { "0".to_string() } else { fp };
            match f64.parse(f"{sign}{i2}.{f2}e{ex}") {
                Ok(x) => Some(Val.Float(x)),
                Err(_) => None,
            }
        }
        None => None,
    }
}

fn starts(word: Str, sym: ref String) -> bool {
    let w: Vec[char] = word.chars().collect();
    let cs: Vec[char] = sym.chars().collect();
    if cs.len() > w.len() {
        return false;
    }
    let mut i = 0;
    while i < cs.len() {
        if cs[i] != w[i] {
            return false;
        }
        i += 1;
    }
    true
}

// The number branch of parse_value, with its leading-zero and fraction
// checks and the bare except around the conversion.
fn to_number(sym: ref String, pos: i64, use_float: bool) -> Result[Val, Exc] {
    let cs: Vec[char] = sym.chars().collect();
    let n = cs.len();
    if (n > 1 and cs[0] == '0' and cs[1] != 'e' and cs[1] != 'E' and cs[1] != '.') or (n > 2 and cs[0] == '-' and cs[1] == '0' and cs[2] != 'e' and cs[2] != 'E' and cs[2] != '.') {
        return Err(json_error(f"Invalid JSON number: {sym}"));
    }
    if cs[0] == '.' or cs[n - 1] == '.' {
        return Err(json_error(f"Invalid JSON number: {sym}"));
    }
    let plain = not (has_char(cs, '.') or has_char(cs, 'e') or has_char(cs, 'E'));
    let got = if plain {
        py_int(cs)
    } else if use_float {
        // float overflow raises inside the try, so it ends as below.
        match py_float(cs) {
            Some(Val.Float(x)) => if x > 1.7976931348623157e308 or x < -1.7976931348623157e308 { None } else { Some(Val.Float(x)) },
            other => other,
        }
    } else {
        py_decimal(cs)
    };
    match got {
        Some(v) => Ok(v),
        None => {
            if starts("true", sym) or starts("false", sym) or starts("null", sym) {
                Err(incomplete("Incomplete JSON content".to_string()))
            } else {
                Err(unexpected(sym, pos))
            }
        }
    }
}

// ------------------------------------------------------------ the pipeline

// \s in a str pattern: the characters str.isspace() accepts.
fn is_space(c: char) -> bool {
    let n = c as i64;
    if n == 32 or (n >= 9 and n <= 13) or (n >= 0x1C and n <= 0x1F) or n == 0x85 or n == 0xA0 {
        return true;
    }
    n == 0x1680 or (n >= 0x2000 and n <= 0x200A) or n == 0x2028 or n == 0x2029 or n == 0x202F or n == 0x205F or n == 0x3000
}

// [a-z0-9eE\.\+-], the run LEXEME_RE matches.
fn is_word(c: char) -> bool {
    (c >= 'a' and c <= 'z') or is_digit(c) or c == 'E' or c == '.' or c == '+' or c == '-'
}

fn is_unary(sym: ref String) -> bool {
    sym == "[" or sym == "]" or sym == "{" or sym == "}" or sym == ","
}

// Where each coroutine of the chain waits.
const L_FIRST: i64 = 0;
const L_STRING: i64 = 1;
const L_WORD: i64 = 2;
const L_MORE: i64 = 3;
const L_DONE: i64 = 4;

const P_VALUE: i64 = 0;
const P_ARRAY_ELEMENT_END: i64 = 1;
const P_OBJECT_KEY: i64 = 2;
const P_OBJECT_END: i64 = 3;

const MODE_BASIC: i64 = 0;
const MODE_PARSE: i64 = 1;
const MODE_ITEMS: i64 = 2;
const MODE_KVITEMS: i64 = 3;

// One coroutine chain: utf8_encoder -> Lexer -> parse_value, then
// parse_basecoro and items_basecoro or kvitems_basecoro as the mode asks.
// What reaches the sink goes to queue.
struct Pipe {
    mode: i64,
    prefix: String,
    multi: bool,
    use_float: bool,
    queue: Vec[Out],
    // utf8_encoder
    pending: Vec[u8],
    alive: bool,
    // Lexer
    buf: Vec[char],
    pos: i64,
    discarded: i64,
    data_nonempty: bool,
    lwait: i64,
    lstart: i64,
    // parse_value: the state stack, and which yield it waits at (0 the
    // top of the loop, 1 after '[', 2 after '{', 3 after a key).
    stack: Vec[i64],
    stage: i64,
    // parse_basecoro
    path: Vec[String],
    // items_basecoro and kvitems_basecoro
    building: bool,
    depth: i64,
    bld: Builder,
    kstate: i64,
    kkey: String,
}

fn pipe_new(mode: i64, prefix: ref String, multi: bool, use_float: bool) -> Pipe {
    Pipe {
        mode: mode,
        prefix: prefix.clone(),
        multi: multi,
        use_float: use_float,
        queue: Vec.new(),
        pending: Vec.new(),
        alive: true,
        buf: Vec.new(),
        pos: 0,
        discarded: 0,
        data_nonempty: false,
        lwait: L_FIRST,
        lstart: 0,
        stack: vec![P_VALUE],
        stage: 0,
        path: Vec.new(),
        building: false,
        depth: 0,
        bld: builder_new(),
        kstate: 0,
        kkey: String.new(),
    }
}

fn str_of(v: ref Val) -> String {
    match v {
        Val.Str(s) => s.clone(),
        _ => String.new(),
    }
}

fn join_path(path: ref Vec[String], upto: i64) -> String {
    let mut out = String.new();
    let mut i = 0;
    while i < upto {
        if i > 0 {
            out.push('.');
        }
        out.push_str(path[i]);
        i += 1;
    }
    out
}

fn items_feed(p: mut ref Pipe, cur: ref String, kind: i64, v: ref Val) {
    if p.building {
        if kind == EV_START_MAP or kind == EV_START_ARRAY {
            p.depth += 1;
        } else if kind == EV_END_MAP or kind == EV_END_ARRAY {
            p.depth -= 1;
        }
        if p.depth == 0 {
            // Python's builder put the container in place when it opened;
            // this one closes it now, which leaves the same value.
            builder_event(mut p.bld, kind, v);
            p.building = false;
            p.queue.push(Out.Item(p.bld.value.clone()));
        } else {
            builder_event(mut p.bld, kind, v);
        }
        return;
    }
    if *cur == p.prefix {
        if kind == EV_START_MAP or kind == EV_START_ARRAY {
            p.building = true;
            p.depth = 1;
            p.bld = builder_new();
            builder_event(mut p.bld, kind, v);
        } else {
            p.queue.push(Out.Item(v.clone()));
        }
    }
}

// The `while path == prefix and event == 'map_key'` test of kvitems.
fn kv_start(p: mut ref Pipe, cur: ref String, kind: i64, v: ref Val) {
    if *cur == p.prefix and kind == EV_MAP_KEY {
        p.kkey = str_of(v);
        p.bld = builder_new();
        p.depth = 0;
        p.kstate = 1;
    } else {
        p.kstate = 0;
    }
}

fn kv_feed(p: mut ref Pipe, cur: ref String, kind: i64, v: ref Val) {
    if p.kstate == 0 {
        kv_start(mut p, cur, kind, v);
        return;
    }
    if kind == EV_START_MAP {
        p.depth += 1;
    } else if kind == EV_END_MAP and p.kstate == 2 {
        p.depth -= 1;
    }
    if (kind != EV_MAP_KEY or p.depth != 0) and (kind != EV_END_MAP or p.depth != -1) {
        builder_event(mut p.bld, kind, v);
        p.kstate = 2;
    } else {
        p.queue.push(Out.Pair(p.kkey.clone(), p.bld.value.clone()));
        kv_start(mut p, cur, kind, v);
    }
}

// parse_basecoro, then the mode's sink.
fn emit(p: mut ref Pipe, kind: i64, v: own Val) {
    if p.mode == MODE_BASIC {
        p.queue.push(Out.Basic(kind, v));
        return;
    }
    let n = p.path.len();
    let prefix = if kind == EV_MAP_KEY {
        let pre = join_path(p.path, n - 1);
        p.path[n - 1] = str_of(v);
        pre
    } else if kind == EV_START_MAP {
        let pre = join_path(p.path, n);
        p.path.push(String.new());
        pre
    } else if kind == EV_START_ARRAY {
        let pre = join_path(p.path, n);
        p.path.push("item".to_string());
        pre
    } else if kind == EV_END_MAP or kind == EV_END_ARRAY {
        p.path.pop();
        join_path(p.path, n - 1)
    } else {
        join_path(p.path, n)
    };
    if p.mode == MODE_PARSE {
        p.queue.push(Out.Parsed(prefix, kind, v));
    } else if p.mode == MODE_ITEMS {
        items_feed(mut p, prefix, kind, v);
    } else {
        kv_feed(mut p, prefix, kind, v);
    }
}

fn pop_state(p: mut ref Pipe) {
    p.stack.pop();
}

fn set_top(p: mut ref Pipe, s: i64) {
    let n = p.stack.len();
    p.stack[n - 1] = s;
}

// One lexeme at the top of parse_value's loop.
fn parse_symbol(p: mut ref Pipe, pos: i64, sym: ref String) -> Result[(), Exc] {
    if p.stack.len() == 0 {
        if p.multi {
            p.stack.push(P_VALUE);
        } else {
            return Err(json_error("Additional data found".to_string()));
        }
    }
    let state = p.stack[p.stack.len() - 1];
    let cs: Vec[char] = sym.chars().collect();
    let first = cs[0];
    if state == P_VALUE {
        if sym == "null" {
            emit(mut p, EV_NULL, Val.Non);
            pop_state(mut p);
        } else if sym == "true" {
            emit(mut p, EV_BOOLEAN, Val.Bool(true));
            pop_state(mut p);
        } else if sym == "false" {
            emit(mut p, EV_BOOLEAN, Val.Bool(false));
            pop_state(mut p);
        } else if first == '"' {
            let s = parse_string(sym)?;
            emit(mut p, EV_STRING, Val.Str(s));
            pop_state(mut p);
        } else if sym == "[" {
            emit(mut p, EV_START_ARRAY, Val.Non);
            p.stage = 1;
        } else if sym == "{" {
            emit(mut p, EV_START_MAP, Val.Non);
            p.stage = 2;
        } else {
            let v = to_number(sym, pos, p.use_float)?;
            emit(mut p, EV_NUMBER, v);
            pop_state(mut p);
        }
    } else if state == P_OBJECT_KEY {
        if first != '"' {
            return Err(unexpected(sym, pos));
        }
        let s = parse_string(sym)?;
        emit(mut p, EV_MAP_KEY, Val.Str(s));
        p.stage = 3;
    } else if state == P_OBJECT_END {
        if sym == "," {
            set_top(mut p, P_OBJECT_KEY);
        } else if sym != "}" {
            return Err(unexpected(sym, pos));
        } else {
            emit(mut p, EV_END_MAP, Val.Non);
            pop_state(mut p);
            pop_state(mut p);
        }
    } else {
        if sym == "," {
            set_top(mut p, P_ARRAY_ELEMENT_END);
            p.stack.push(P_VALUE);
        } else if sym != "]" {
            return Err(unexpected(sym, pos));
        } else {
            emit(mut p, EV_END_ARRAY, Val.Non);
            pop_state(mut p);
            pop_state(mut p);
        }
    }
    Ok(())
}

// parse_value receives (pos, symbol), or EOF.
fn parser_send(p: mut ref Pipe, pos: i64, sym: ref String, eof: bool) -> Result[(), Exc] {
    let stage = p.stage;
    p.stage = 0;
    if stage == 1 {
        if eof {
            return Err(incomplete("Incomplete JSON content".to_string()));
        }
        if sym == "]" {
            emit(mut p, EV_END_ARRAY, Val.Non);
            pop_state(mut p);
            return Ok(());
        }
        p.stack.push(P_ARRAY_ELEMENT_END);
        p.stack.push(P_VALUE);
        return parse_symbol(mut p, pos, sym);
    }
    if stage == 2 {
        if eof {
            return Err(incomplete("Incomplete JSON content".to_string()));
        }
        if sym == "}" {
            emit(mut p, EV_END_MAP, Val.Non);
            pop_state(mut p);
            return Ok(());
        }
        p.stack.push(P_OBJECT_KEY);
        return parse_symbol(mut p, pos, sym);
    }
    if stage == 3 {
        if eof {
            return Err(incomplete("Incomplete JSON content".to_string()));
        }
        if sym != ":" {
            return Err(unexpected(sym, pos));
        }
        set_top(mut p, P_OBJECT_END);
        p.stack.push(P_VALUE);
        return Ok(());
    }
    if eof {
        if p.stack.len() > 0 {
            return Err(incomplete("Incomplete JSON content".to_string()));
        }
        return Ok(());
    }
    parse_symbol(mut p, pos, sym)
}

// LEXEME_RE.search(buf, from): where the lexeme starts and ends, or -1.
fn search(buf: ref Vec[char], from: i64) -> (i64, i64) {
    let mut i = from;
    while i < buf.len() and is_space(buf[i]) {
        i += 1;
    }
    if i >= buf.len() {
        return (-1, -1);
    }
    if not is_word(buf[i]) {
        return (i, i + 1);
    }
    let mut j = i;
    while j < buf.len() and is_word(buf[j]) {
        j += 1;
    }
    (i, j)
}

// Looks for the closing quote of the string lexeme at p.pos, from
// p.lstart: its index, or -1 when the buffer ends first.
fn string_end(p: mut ref Pipe) -> i64 {
    loop {
        let mut end = p.lstart;
        while end < p.buf.len() and p.buf[end] != '"' {
            end += 1;
        }
        if end >= p.buf.len() {
            return -1;
        }
        let mut escpos = end - 1;
        while p.buf[escpos] == '\\' {
            escpos -= 1;
        }
        if (end - escpos) % 2 == 0 {
            p.lstart = end + 1;
        } else {
            return end;
        }
    }
}

// The Lexer's loop, from the top, until it waits for data or ends.
fn lexer_run(p: mut ref Pipe) -> Result[(), Exc] {
    loop {
        let (ms, me) = search(p.buf, p.pos);
        if ms >= 0 {
            if p.buf[ms] == '"' {
                p.pos = ms;
                p.lstart = ms + 1;
                let end = string_end(mut p);
                if end < 0 {
                    p.lwait = L_STRING;
                    return Ok(());
                }
                lexer_string_done(mut p, end)?;
            } else {
                if me == p.buf.len() {
                    let lex = chars_str(p.buf, ms, me);
                    if not is_unary(lex) {
                        p.lwait = L_WORD;
                        return Ok(());
                    }
                }
                let lex = chars_str(p.buf, ms, me);
                let at = p.discarded + ms;
                p.pos = me;
                parser_send(mut p, at, lex, false)?;
            }
        } else {
            if p.data_nonempty {
                p.lwait = L_MORE;
                return Ok(());
            }
            p.lwait = L_DONE;
            parser_send(mut p, -1, String.new(), true)?;
            return Ok(());
        }
    }
}

fn lexer_string_done(p: mut ref Pipe, end: i64) -> Result[(), Exc] {
    let lex = chars_str(p.buf, p.pos, end + 1);
    let at = p.discarded + p.pos;
    p.pos = end + 1;
    parser_send(mut p, at, lex, false)
}

// The Lexer receives data where it waits; closing is a GeneratorExit
// there, which it treats as no more data.
fn lexer_send(p: mut ref Pipe, data: ref String) -> Result[(), Exc] {
    let cs: Vec[char] = data.chars().collect();
    let wait = p.lwait;
    if wait == L_DONE {
        return Ok(());
    }
    p.data_nonempty = cs.len() > 0;
    if wait == L_FIRST {
        p.buf = cs;
        p.pos = 0;
        p.discarded = 0;
        return lexer_run(mut p);
    }
    if wait == L_STRING {
        if cs.len() == 0 {
            p.lwait = L_DONE;
            return Err(incomplete("Incomplete string lexeme".to_string()));
        }
        for c in cs {
            p.buf.push(c);
        }
        let end = string_end(mut p);
        if end < 0 {
            return Ok(());
        }
        lexer_string_done(mut p, end)?;
        return lexer_run(mut p);
    }
    if wait == L_WORD {
        for c in cs {
            p.buf.push(c);
        }
        let (ms, me) = search(p.buf, p.pos);
        let lex = chars_str(p.buf, ms, me);
        if p.data_nonempty and not is_unary(lex) and me == p.buf.len() {
            return Ok(());
        }
        let at = p.discarded + ms;
        p.pos = me;
        parser_send(mut p, at, lex, false)?;
        return lexer_run(mut p);
    }
    // Waiting for more data with the buffer used up.
    if not p.data_nonempty {
        p.lwait = L_DONE;
        parser_send(mut p, -1, String.new(), true)?;
        return Ok(());
    }
    p.discarded += p.buf.len();
    p.buf = cs;
    p.pos = 0;
    lexer_run(mut p)
}

fn lexer_close(p: mut ref Pipe) -> Result[(), Exc] {
    lexer_send(mut p, String.new())
}

fn decode_failed(p: mut ref Pipe, e: ref Exc) -> Exc {
    p.alive = false;
    // utf8_encoder closes the lexer first, ignoring what that raises.
    let _ = lexer_close(mut p);
    p.lwait = L_DONE;
    incomplete(e.msg.clone())
}

// coro.send(bdata) on the chain: Ok(true) where Python raises
// StopIteration.
fn pipe_send(p: mut ref Pipe, bdata: ref Vec[u8]) -> Result[bool, Exc] {
    if not p.alive {
        return Ok(true);
    }
    let mut data = p.pending.clone();
    for x in bdata {
        data.push(*x);
    }
    match decode_utf8(data, false) {
        Err(e) => Err(decode_failed(mut p, e)),
        Ok((text, used)) => {
            p.pending = sub(data, used, data.len());
            if text.len() > 0 {
                match lexer_send(mut p, text) {
                    Ok(_) => Ok(false),
                    Err(e) => {
                        p.alive = false;
                        Err(e)
                    }
                }
            } else if bdata.len() == 0 {
                p.alive = false;
                lexer_close(mut p)?;
                Ok(true)
            } else {
                Ok(false)
            }
        }
    }
}

// coro.close() on the chain: the decoder's final decode, then the lexer's
// close.
fn pipe_close(p: mut ref Pipe) -> Result[(), Exc] {
    if not p.alive {
        return Ok(());
    }
    p.alive = false;
    let data = p.pending.clone();
    match decode_utf8(data, true) {
        Err(e) => Err(decode_failed(mut p, e)),
        Ok(_) => lexer_close(mut p),
    }
}

// coros2gen over file_source: the events come out a chunk at a time, and
// those of a chunk that raises are lost with it.
struct Gen {
    p: Pipe,
    data: Vec[u8],
    at: i64,
    buf_size: i64,
    qi: i64,
    done: bool,
    comments: bool,
}

fn gen_next(g: mut ref Gen) -> Result[Option[Out], Exc] {
    if g.comments {
        g.comments = false;
        g.done = true;
        return Err(exc("ValueError", "Comments are not supported by the python backend".to_string()));
    }
    loop {
        if g.qi < g.p.queue.len() {
            let o = g.p.queue[g.qi].clone();
            g.qi += 1;
            return Ok(Some(o));
        }
        if g.done {
            return Ok(None);
        }
        g.p.queue = Vec.new();
        g.qi = 0;
        let end = if g.at + g.buf_size < g.data.len() { g.at + g.buf_size } else { g.data.len() };
        let chunk = sub(g.data, g.at, end);
        g.at = end;
        match pipe_send(mut g.p, chunk) {
            Err(e) => {
                g.done = true;
                g.p.queue = Vec.new();
                return Err(e);
            }
            Ok(fin) => {
                if fin {
                    g.done = true;
                }
            }
        }
    }
}

// ------------------------------------------------------------ decimals

// A Decimal as coefficient and exponent, for the report's arithmetic; the
// amounts in it are small enough for i64.
fn dec_of(v: ref Val) -> (i64, i64) {
    match v {
        Val.Dec(neg, d, e) => (if neg { -atoi(d) } else { atoi(d) }, e),
        Val.Int(s) => (atoi(s), 0),
        _ => (0, 0),
    }
}

fn pow10(n: i64) -> i64 {
    let mut p = 1;
    let mut k = 0;
    while k < n {
        p = p * 10;
        k += 1;
    }
    p
}

fn dadd(a: (i64, i64), b: (i64, i64)) -> (i64, i64) {
    let (c1, e1) = a;
    let (c2, e2) = b;
    if e1 <= e2 {
        (c1 + c2 * pow10(e2 - e1), e1)
    } else {
        (c1 * pow10(e1 - e2) + c2, e2)
    }
}

fn dsub(a: (i64, i64), b: (i64, i64)) -> (i64, i64) {
    let (c2, e2) = b;
    dadd(a, (-c2, e2))
}

fn dmul(a: (i64, i64), b: (i64, i64)) -> (i64, i64) {
    let (c1, e1) = a;
    let (c2, e2) = b;
    (c1 * c2, e1 + e2)
}

// -1, 0 or 1 as a is less than, equal to or greater than b.
fn dcmp(a: (i64, i64), b: (i64, i64)) -> i64 {
    let (d, _) = dsub(a, b);
    if d < 0 {
        -1
    } else if d > 0 {
        1
    } else {
        0
    }
}

// .quantize(Decimal("0.01")) under the default ROUND_HALF_EVEN.
fn quantize2(a: (i64, i64)) -> (i64, i64) {
    let (c, e) = a;
    if e >= -2 {
        return (c * pow10(e + 2), -2);
    }
    let div = pow10(-2 - e);
    let neg = c < 0;
    let m = if neg { -c } else { c };
    let mut q = m / div;
    let r = m % div;
    if r * 2 > div or (r * 2 == div and q % 2 == 1) {
        q += 1;
    }
    (if neg { -q } else { q }, -2)
}

fn dstr(a: (i64, i64)) -> String {
    let (c, e) = a;
    let m = if c < 0 { -c } else { c };
    sci_string(c < 0, f"{m}", e)
}

// ------------------------------------------------------------ the jobs

struct Opts {
    buf: i64,
    multi: bool,
    float: bool,
    od: bool,
    take: i64,
    comments: bool,
    cuts: String,
    method: String,
    prefix: String,
    has_prefix: bool,
}

fn is_option(key: ref String) -> bool {
    key == "buf" or key == "multi" or key == "float" or key == "map" or key == "take" or key == "comments" or key == "cuts" or key == "method" or key == "prefix"
}

// The key=value options of a job, and the other fields in order.
fn options(parts: ref Vec[String]) -> (Opts, Vec[String]) {
    let mut o = Opts {
        buf: 65536,
        multi: false,
        float: false,
        od: false,
        take: -1,
        comments: false,
        cuts: String.new(),
        method: "basic_parse".to_string(),
        prefix: String.new(),
        has_prefix: false,
    };
    let mut rest: Vec[String] = Vec.new();
    let mut i = 1;
    while i < parts.len() {
        let p = parts[i].clone();
        let mut key = String.new();
        let mut val = String.new();
        let mut seen = false;
        for c in p.chars() {
            if seen {
                val.push(c);
            } else if c == '=' {
                seen = true;
            } else {
                key.push(c);
            }
        }
        if seen and is_option(key) {
            if key == "buf" {
                o.buf = atoi(val);
            } else if key == "multi" {
                o.multi = val == "1";
            } else if key == "float" {
                o.float = val == "1";
            } else if key == "map" {
                o.od = val == "od";
            } else if key == "take" {
                o.take = atoi(val);
            } else if key == "comments" {
                o.comments = val == "1";
            } else if key == "cuts" {
                o.cuts = val;
            } else if key == "method" {
                o.method = val;
            } else {
                o.prefix = val;
                o.has_prefix = true;
            }
        } else {
            rest.push(p);
        }
        i += 1;
    }
    (o, rest)
}

// =text is inline UTF-8 text, x:hex inline bytes, anything else a path.
fn source(spec: ref String) -> Result[Vec[u8], Exc] {
    if spec.starts_with("=") {
        let mut out: Vec[u8] = Vec.new();
        for b in spec.substring(1, spec.len()).bytes() {
            out.push(b);
        }
        return Ok(out);
    }
    if spec.starts_with("x:") {
        return Ok(hex_bytes(spec.substring(2, spec.len())));
    }
    match fs.read_bytes(spec.clone()) {
        Ok(b) => Ok(b),
        Err(_) => Err(not_found(spec)),
    }
}

fn gen_of(data: own Vec[u8], mode: i64, prefix: ref String, multi: bool, use_float: bool, buf: i64) -> Gen {
    Gen {
        p: pipe_new(mode, prefix, multi, use_float),
        data: data,
        at: 0,
        buf_size: buf,
        qi: 0,
        done: false,
        comments: false,
    }
}

fn show(g: mut ref Gen, o: ref Opts) -> Result[(), Exc] {
    let mut n = 0;
    loop {
        match gen_next(mut g)? {
            None => return Ok(()),
            Some(ev) => {
                if n == o.take {
                    println(f"  (stopped after {o.take})");
                    return Ok(());
                }
                println(f"  {out_repr(ev, o.od)}");
                n += 1;
            }
        }
    }
}

fn mode_of(cmd: ref String) -> i64 {
    if cmd == "basic" or cmd == "basic_parse" {
        MODE_BASIC
    } else if cmd == "parse" {
        MODE_PARSE
    } else if cmd == "kvitems" {
        MODE_KVITEMS
    } else {
        MODE_ITEMS
    }
}

fn gen_job(cmd: ref String, src: ref String, prefix: ref String, o: ref Opts) -> Result[(), Exc] {
    let data = source(src)?;
    let mut g = gen_of(data, mode_of(cmd), prefix, o.multi, o.float, o.buf);
    g.comments = o.comments;
    if cmd == "count" {
        let mut n = 0;
        loop {
            match gen_next(mut g)? {
                None => break,
                Some(_) => n += 1,
            }
        }
        println(f"  {n}");
        return Ok(());
    }
    show(mut g, o)
}

// The push interface: *_coro(sink, ...) driven by send() and close(), with
// the sink's events printed after each call.
fn push(method: ref String, src: ref String, prefix: ref String, o: ref Opts) -> Result[(), Exc] {
    let data = source(src)?;
    let mut bounds: Vec[i64] = vec![0];
    for c in split_on(o.cuts, ',') {
        if c.len() > 0 {
            bounds.push(atoi(c));
        }
    }
    bounds.push(data.len());
    let mut p = pipe_new(mode_of(method), prefix, o.multi, o.float);
    let mut shown = 0;
    let mut i = 0;
    while i + 1 < bounds.len() {
        let chunk = sub(data, bounds[i], bounds[i + 1]);
        println(f"  send {chunk.len()} bytes");
        let r = pipe_send(mut p, chunk);
        flush(mut p, mut shown, o);
        match r {
            Ok(true) => println("    finished"),
            Ok(false) => {}
            Err(e) => {
                println(f"    {err_line(e)}");
                return Ok(());
            }
        }
        i += 1;
    }
    println("  close");
    let r = pipe_close(mut p);
    flush(mut p, mut shown, o);
    if let Err(e) = r {
        println(f"    {err_line(e)}");
    }
    Ok(())
}

fn flush(p: mut ref Pipe, shown: mut ref i64, o: ref Opts) {
    for ev in p.queue {
        if *shown == o.take {
            break;
        }
        println(f"    {out_repr(ev, o.od)}");
        *shown += 1;
    }
    p.queue = Vec.new();
}

// python -m ijson.dump, reading the file as its standard input.
fn dump(src: ref String, o: ref Opts) -> Result[(), Exc] {
    let method = o.method.clone();
    let header = if method == "parse" {
        "#: path, name, value"
    } else if method == "kvitems" {
        "#: key, value"
    } else if method == "items" {
        "#: value"
    } else {
        "#: name, value"
    };
    let data = source(src)?;
    println(f"  {header}");
    let mut rule = String.new();
    let mut k = 0;
    while k < header.len() {
        rule.push('-');
        k += 1;
    }
    println(f"  {rule}");
    let mut g = gen_of(data, mode_of(method), o.prefix, o.multi, false, 65536);
    let mut i = 0;
    loop {
        match gen_next(mut g) {
            Err(e) => {
                println(f"  {err_line(e)}");
                return Ok(());
            }
            Ok(None) => return Ok(()),
            Ok(Some(ev)) => {
                let line = match ev {
                    Out.Basic(kind, v) => f"{ev_name(kind)}, {val_str(v)}",
                    Out.Parsed(pre, kind, v) => f"{pre}, {ev_name(kind)}, {val_str(v)}",
                    Out.Item(v) => val_str(v),
                    Out.Pair(key, v) => f"{key}, {val_str(v)}",
                };
                println(f"  {i}: {line}");
                i += 1;
            }
        }
    }
}

fn write_text(path: ref String, text: ref String) -> Result[(), Exc] {
    match fs.write(path.clone(), text.clone()) {
        Ok(_) => Ok(()),
        Err(_) => Err(not_found(path)),
    }
}

// One customer's line of the report.
#[derive(Clone)]
struct Account {
    name: String,
    orders: i64,
    revenue: (i64, i64),
    refunded: (i64, i64),
    open: i64,
}

// A revenue report streamed from the order export: each order is built
// from the events under orders.item, its lines checked against its total,
// and its discount applied in exact decimals.
fn report(src: ref String, dest: ref String) -> Result[(), Exc] {
    let data = source(src)?;
    let mut g = gen_of(data, MODE_ITEMS, "orders.item".to_string(), false, false, 512);
    let mut accts: Vec[Account] = Vec.new();
    let mut notes: Vec[String] = Vec.new();
    loop {
        let o = match gen_next(mut g)? {
            Some(Out.Item(v)) => v,
            Some(_) => continue,
            None => break,
        };
        let mut lines_total = (0, 0);
        match get(o, "lines") {
            Some(Val.List(ls)) => {
                for ln in ls {
                    let price = dec_of(get(ln, "price").unwrap_or(Val.Non));
                    let qty = dec_of(get(ln, "qty").unwrap_or(Val.Non));
                    lines_total = dadd(lines_total, dmul(price, qty));
                }
            }
            _ => {}
        }
        let total = dec_of(get(o, "total").unwrap_or(Val.Non));
        let id = repr(get(o, "id").unwrap_or(Val.Non), false);
        if dcmp(lines_total, total) != 0 {
            notes.push(f"order {id}: total {dstr(total)}, lines add up to {dstr(lines_total)}");
        }
        let mut net = total;
        match get(o, "discount") {
            Some(d) => {
                net = quantize2(dmul(net, dsub((1, 0), dec_of(d))));
            }
            None => {}
        }
        let name = get_str(o, "customer");
        let status = get_str(o, "status");
        let mut at = -1;
        let mut k = 0;
        while k < accts.len() {
            if accts[k].name == name {
                at = k;
            }
            k += 1;
        }
        if at < 0 {
            accts.push(Account { name: name.clone(), orders: 0, revenue: (0, 0), refunded: (0, 0), open: 0 });
            at = accts.len() - 1;
        }
        accts[at].orders += 1;
        if status == "paid" or status == "shipped" {
            accts[at].revenue = dadd(accts[at].revenue, net);
        } else if status == "refunded" {
            accts[at].refunded = dadd(accts[at].refunded, net);
        } else {
            accts[at].open += 1;
        }
    }
    // sorted(key=(-revenue, name)), a selection sort keeping the first of
    // equal keys as sorted() keeps them.
    let mut rows: Vec[Account] = Vec.new();
    let mut used: Vec[bool] = Vec.new();
    for _ in accts {
        used.push(false);
    }
    while rows.len() < accts.len() {
        let mut best = -1;
        let mut k = 0;
        while k < accts.len() {
            if not used[k] {
                if best < 0 {
                    best = k;
                } else {
                    let c = dcmp(accts[k].revenue, accts[best].revenue);
                    if c > 0 or (c == 0 and accts[k].name < accts[best].name) {
                        best = k;
                    }
                }
            }
            k += 1;
        }
        used[best] = true;
        rows.push(accts[best].clone());
    }
    let mut lines: Vec[String] = Vec.new();
    lines.push(f"{pad_right("customer", 16)} {pad_left("orders", 6)} {pad_left("revenue", 10)} {pad_left("refunded", 10)} {pad_left("open", 4)}");
    let mut grand = (0, 0);
    let mut count = 0;
    for a in rows {
        lines.push(f"{pad_right(a.name, 16)} {pad_left(f"{a.orders}", 6)} {pad_left(dstr(a.revenue), 10)} {pad_left(dstr(a.refunded), 10)} {pad_left(f"{a.open}", 4)}");
        grand = dadd(grand, a.revenue);
        count += a.orders;
    }
    lines.push(f"{pad_right("all", 16)} {pad_left(f"{count}", 6)} {pad_left(dstr(grand), 10)}");
    for n in notes {
        lines.push(n.clone());
    }
    write_text(dest, f"{join_strs(lines, "\n")}\n")?;
    println(f"  wrote {dest} ({accts.len()} customers, {notes.len()} notes)");
    Ok(())
}

fn float_of(v: ref Val) -> f64 {
    match v {
        Val.Float(x) => x,
        Val.Int(s) => atoi(s) as f64,
        _ => 0.0,
    }
}

// A latency summary of the JSON-lines event log, one value a line read
// with multiple_values; a bad line stops the run and nothing is written.
fn latency(src: ref String, dest: ref String) -> Result[(), Exc] {
    let data = source(src)?;
    let mut g = gen_of(data, MODE_ITEMS, String.new(), true, true, 128);
    let mut names: Vec[String] = Vec.new();
    let mut counts: Vec[i64] = Vec.new();
    let mut totals: Vec[f64] = Vec.new();
    let mut tops: Vec[f64] = Vec.new();
    loop {
        let ev = match gen_next(mut g) {
            Err(e) => {
                println(f"  {err_line(e)}");
                let mut n = 0;
                for c in counts {
                    n += c;
                }
                println(f"  read {n} events; nothing written");
                return Ok(());
            }
            Ok(None) => break,
            Ok(Some(Out.Item(v))) => v,
            Ok(Some(_)) => continue,
        };
        let kind = get_str(ev, "type");
        let ms = float_of(get(ev, "ms").unwrap_or(Val.Non));
        let mut at = -1;
        let mut k = 0;
        while k < names.len() {
            if names[k] == kind {
                at = k;
            }
            k += 1;
        }
        if at < 0 {
            names.push(kind);
            counts.push(0);
            totals.push(0.0);
            tops.push(0.0);
            at = names.len() - 1;
        }
        counts[at] += 1;
        totals[at] = totals[at] + ms;
        if ms > tops[at] {
            tops[at] = ms;
        }
    }
    let mut order: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < names.len() {
        let mut j = order.len();
        while j > 0 and names[order[j - 1]] > names[k] {
            j -= 1;
        }
        order.insert(j, k);
        k += 1;
    }
    let mut lines: Vec[String] = vec!["type,count,mean_ms,max_ms".to_string()];
    for i in order {
        let mean = totals[i] / (counts[i] as f64);
        lines.push(f"{names[i]},{counts[i]},{mean:.3},{tops[i]}");
    }
    write_text(dest, f"{join_strs(lines, "\n")}\n")?;
    println(f"  wrote {dest} ({names.len()} types)");
    Ok(())
}

fn tuple_less(a1: ref String, a2: ref String, b1: ref String, b2: ref String) -> bool {
    *a1 < *b1 or (*a1 == *b1 and *a2 < *b2)
}

// Every prefix and the events seen there, as a schema survey of a file
// nobody documented.
fn schema(src: ref String) -> Result[(), Exc] {
    let data = source(src)?;
    let mut g = gen_of(data, MODE_PARSE, String.new(), false, false, 65536);
    let mut pres: Vec[String] = Vec.new();
    let mut evs: Vec[String] = Vec.new();
    let mut counts: Vec[i64] = Vec.new();
    loop {
        let (prefix, kind) = match gen_next(mut g)? {
            Some(Out.Parsed(p, k, _)) => (p, k),
            Some(_) => continue,
            None => break,
        };
        if kind == EV_MAP_KEY or kind == EV_END_MAP or kind == EV_END_ARRAY {
            continue;
        }
        let name = ev_name(kind);
        let mut at = -1;
        let mut k = 0;
        while k < pres.len() {
            if pres[k] == prefix and evs[k] == name {
                at = k;
            }
            k += 1;
        }
        if at < 0 {
            pres.push(prefix);
            evs.push(name);
            counts.push(1);
        } else {
            counts[at] += 1;
        }
    }
    let mut order: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < pres.len() {
        let mut j = order.len();
        while j > 0 and tuple_less(pres[k], evs[k], pres[order[j - 1]], evs[order[j - 1]]) {
            j -= 1;
        }
        order.insert(j, k);
        k += 1;
    }
    for i in order {
        let shown = if pres[i].len() == 0 { "(root)".to_string() } else { pres[i].clone() };
        println(f"  {pad_right(shown, 28)} {pad_right(evs[i], 12)} {counts[i]}");
    }
    Ok(())
}

// The objects under a prefix, with use_float, as JSON lines.
fn extract(src: ref String, prefix: ref String, dest: ref String) -> Result[(), Exc] {
    let data = source(src)?;
    let mut g = gen_of(data, MODE_ITEMS, prefix, false, true, 65536);
    let mut text = String.new();
    let mut n = 0;
    loop {
        match gen_next(mut g)? {
            Some(Out.Item(v)) => {
                text.push_str(dumps(v));
                text.push('\n');
                n += 1;
            }
            Some(_) => {}
            None => break,
        }
    }
    write_text(dest, text)?;
    println(f"  wrote {dest} ({n} lines)");
    Ok(())
}

fn cat(path: ref String) {
    let text = match fs.read_to_string(path.clone()) {
        Ok(s) => s,
        Err(_) => {
            println(f"  {err_line(not_found(path))}");
            return;
        }
    };
    // open() in text mode reads with universal newlines.
    let mut norm = String.new();
    let mut after_cr = false;
    for c in text.chars() {
        if c == '\r' {
            norm.push('\n');
            after_cr = true;
        } else {
            if not (c == '\n' and after_cr) {
                norm.push(c);
            }
            after_cr = false;
        }
    }
    let mut lines = split_on(norm, '\n');
    if lines.len() > 0 and lines[lines.len() - 1].len() == 0 {
        lines.pop();
    }
    println(f"  {path} ({lines.len()} lines)");
    for ln in lines {
        println(f"  | {ln}");
    }
}

fn run(parts: ref Vec[String]) -> Result[(), Exc] {
    let cmd = parts[0].clone();
    let (o, rest) = options(parts);
    if cmd == "version" {
        println("  3.3.0 python python");
    } else if cmd == "basic" or cmd == "parse" {
        gen_job(cmd, rest[0], String.new(), o)?;
    } else if cmd == "items" or cmd == "kvitems" or cmd == "count" {
        gen_job(cmd, rest[0], rest[1], o)?;
    } else if cmd == "push" {
        push(rest[0], rest[1], rest[2], o)?;
    } else if cmd == "dump" {
        dump(rest[0], o)?;
    } else if cmd == "report" {
        report(rest[0], rest[1])?;
    } else if cmd == "latency" {
        latency(rest[0], rest[1])?;
    } else if cmd == "schema" {
        schema(rest[0])?;
    } else if cmd == "extract" {
        extract(rest[0], rest[1], rest[2])?;
    } else if cmd == "cat" {
        cat(rest[0]);
    }
    Ok(())
}

fn dirname_of(path: ref String) -> String {
    let cs: Vec[char] = path.chars().collect();
    let mut cut = 0;
    let mut i = 0;
    while i < cs.len() {
        if cs[i] == '/' {
            cut = i;
        }
        i += 1;
    }
    chars_str(cs, 0, cut)
}

fn write_inputs() -> Result[(), String] {
    for line in split_on(inputs_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, ' ');
        let path = f"data/{f[0]}";
        let _ = fs.create_dir_all(dirname_of(path));
        let bytes = if f.len() > 1 { hex_bytes(f[1]) } else { Vec.new() };
        if let Err(e) = fs.write_bytes(path, bytes) {
            return Err(f"cannot write {f[0]}: {e}");
        }
    }
    let _ = fs.remove_dir_all("data/out".to_string());
    if let Err(e) = fs.create_dir_all("data/out".to_string()) {
        return Err(f"cannot create data/out: {e}");
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_inputs() {
        eprintln(e);
        return;
    }
    let mut n = 0;
    let mut nerr = 0;
    for line in split_on(jobs_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let parts = split_on(hex_string(line), '\t');
        println(f"> {join_strs(parts, " ")}");
        if let Err(e) = run(parts) {
            println(f"  {err_line(e)}");
            nerr += 1;
        }
        n += 1;
    }
    println(f"{n} jobs, {nerr} ended in an error");
}

