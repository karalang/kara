fn data_part_1(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("1.4.1\n");
    v.push(DataFile { path: "services/api/VERSION".to_string(), body: t });
    let mut t = String.new();
    t.push_str("0.9.0\n");
    v.push(DataFile { path: "services/worker/VERSION".to_string(), body: t });
}
