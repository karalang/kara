// mini_morton — a port of pymorton 0.1.0 (MIT, Trevor Prater). Morton order
// (Z-order) maps multi-dimensional coordinates to a single integer by
// interleaving the bits of the coordinates, so that points close in space stay
// close on the line. It is the ordering behind quadtree/octree traversal and
// the spatial keys used by B-trees, geohashes and texture memory: sort the
// codes and you get a depth-first walk of the tree for free.
//
// Each job is one of:
//   il2 <x> <y>          → interleave2: the 2-D Morton code (16-bit coords);
//   dl2 <n>              → deinterleave2: `<x> <y>`, the coordinates of code n;
//   il3 <x> <y> <z>      → interleave3: the 3-D Morton code (10-bit coords);
//   dl3 <n>              → deinterleave3: `<x> <y> <z>`.
//
// The four bit-spreading helpers (part1by1 / part1by2 and their inverses) are
// ported verbatim from the library — the same magic masks and shift ladder,
// which is why coordinates above the range (16 bits for 2-D, 10 for 3-D) are
// silently masked to the low bits exactly as upstream. All arithmetic stays
// within 32 bits, well inside i64.
//
// Scope: the integer interleave / de-interleave API. The library's
// float lat/lng geohash helpers (interleave_latlng / deinterleave_latlng), which
// depend on floating-point formatting, are out of scope (see README).
// jobs_text() carries data/jobs.tsv verbatim.

fn str_bytes(s: Str) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for b in s.bytes() {
        v.push(b as i64);
    }
    v
}

fn split_fields(line: Str, sepb: i64) -> Vec[String] {
    let v = str_bytes(line);
    let n = v.len();
    let mut fields: Vec[String] = Vec.new();
    let mut start = 0;
    let mut i = 0;
    while i <= n {
        if i == n or v[i] == sepb {
            fields.push(line.substring(start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    fields
}

fn parse_uint(s: Str) -> i64 {
    let b = str_bytes(s);
    let mut acc = 0;
    let mut i = 0;
    while i < b.len() {
        acc = acc * 10 + (b[i] - 48);
        i = i + 1;
    }
    acc
}

fn itoa(n: i64) -> String {
    if n == 0 {
        return "0".to_string();
    }
    let tbl = "0123456789".to_string();
    let mut x = n;
    let mut digits: Vec[i64] = Vec.new();
    while x > 0 {
        digits.push(x % 10);
        x = x / 10;
    }
    let mut o = String.new();
    let mut i = digits.len();
    while i > 0 {
        i = i - 1;
        let d = digits[i];
        o.push_str(tbl.substring(d, d + 1));
    }
    o
}

// Spread the low 16 bits of n so that bit k lands at position 2k.
fn part1by1(n0: i64) -> i64 {
    let mut n = n0 & 0x0000ffff;
    n = (n | (n << 8)) & 0x00ff00ff;
    n = (n | (n << 4)) & 0x0f0f0f0f;
    n = (n | (n << 2)) & 0x33333333;
    n = (n | (n << 1)) & 0x55555555;
    n
}

// Spread the low 10 bits of n so that bit k lands at position 3k.
fn part1by2(n0: i64) -> i64 {
    let mut n = n0 & 0x000003ff;
    n = (n ^ (n << 16)) & 0xff0000ff;
    n = (n ^ (n << 8)) & 0x0300f00f;
    n = (n ^ (n << 4)) & 0x030c30c3;
    n = (n ^ (n << 2)) & 0x09249249;
    n
}

// Inverse of part1by1: gather every second bit back into the low 16.
fn unpart1by1(n0: i64) -> i64 {
    let mut n = n0 & 0x55555555;
    n = (n ^ (n >> 1)) & 0x33333333;
    n = (n ^ (n >> 2)) & 0x0f0f0f0f;
    n = (n ^ (n >> 4)) & 0x00ff00ff;
    n = (n ^ (n >> 8)) & 0x0000ffff;
    n
}

// Inverse of part1by2: gather every third bit back into the low 10.
fn unpart1by2(n0: i64) -> i64 {
    let mut n = n0 & 0x09249249;
    n = (n ^ (n >> 2)) & 0x030c30c3;
    n = (n ^ (n >> 4)) & 0x0300f00f;
    n = (n ^ (n >> 8)) & 0xff0000ff;
    n = (n ^ (n >> 16)) & 0x000003ff;
    n
}

fn interleave2(x: i64, y: i64) -> i64 {
    part1by1(x) | (part1by1(y) << 1)
}

fn interleave3(x: i64, y: i64, z: i64) -> i64 {
    part1by2(x) | (part1by2(y) << 1) | (part1by2(z) << 2)
}

fn main_run() -> String {
    let data = jobs_text();
    let db = str_bytes(data.clone());
    let n = db.len();
    let mut out = String.new();
    let mut i = 0;
    let mut ls = 0;
    while i <= n {
        if i == n or db[i] == 10 {
            if i > ls {
                let line = data.substring(ls, i);
                let f = split_fields(line, 9);
                let op = f[0].clone();
                out.push_str("== ");
                out.push_str(op.clone());
                if op == "il2" {
                    let x = parse_uint(f[1].clone());
                    let y = parse_uint(f[2].clone());
                    out.push_str(" ");
                    out.push_str(f[1].clone());
                    out.push_str(" ");
                    out.push_str(f[2].clone());
                    out.push_str("\n");
                    out.push_str(itoa(interleave2(x, y)));
                } else {
                    if op == "il3" {
                        let x = parse_uint(f[1].clone());
                        let y = parse_uint(f[2].clone());
                        let z = parse_uint(f[3].clone());
                        out.push_str(" ");
                        out.push_str(f[1].clone());
                        out.push_str(" ");
                        out.push_str(f[2].clone());
                        out.push_str(" ");
                        out.push_str(f[3].clone());
                        out.push_str("\n");
                        out.push_str(itoa(interleave3(x, y, z)));
                    } else {
                        if op == "dl2" {
                            let code = parse_uint(f[1].clone());
                            out.push_str(" ");
                            out.push_str(f[1].clone());
                            out.push_str("\n");
                            out.push_str(itoa(unpart1by1(code)));
                            out.push_str(" ");
                            out.push_str(itoa(unpart1by1(code >> 1)));
                        } else {
                            let code = parse_uint(f[1].clone());
                            out.push_str(" ");
                            out.push_str(f[1].clone());
                            out.push_str("\n");
                            out.push_str(itoa(unpart1by2(code)));
                            out.push_str(" ");
                            out.push_str(itoa(unpart1by2(code >> 1)));
                            out.push_str(" ");
                            out.push_str(itoa(unpart1by2(code >> 2)));
                        }
                    }
                }
                out.push_str("\n");
            }
            ls = i + 1;
        }
        i = i + 1;
    }
    out
}

fn main() {
    print(main_run());
}

