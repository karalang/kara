# headers
list 'a, b, c'
  ['a', 'b', 'c'] -> 'a, b, c'
list 'token, "quoted value", "with, comma"'
  ['token', 'quoted value', 'with, comma'] -> 'token, "quoted value", "with, comma"'
list '  spaced  ,  out , , ,last '
  ['spaced', 'out', '', '', 'last'] -> 'spaced, out, "", "", last'
list '"esc\\"aped", "back\\\\slash", plain"quote'
  ['esc"aped', 'back\\slash', 'plain"quote'] -> '"esc\\"aped", "back\\\\slash", "plain\\"quote"'
list 'foo="bar, baz", qux'
  ['foo="bar, baz"', 'qux'] -> '"foo=\\"bar, baz\\"", qux'
list '"unterminated, still going'
  ['"unterminated, still going'] -> '"\\"unterminated, still going"'
list ''
  [] -> ''
list ',,,'
  ['', '', ''] -> '"", "", ""'
list 'a, "", b'
  ['a', '', 'b'] -> 'a, "", b'
list '"x" , "y"z, w"v"'
  ['x', '"y"z', 'w"v"'] -> 'x, "\\"y\\"z", "w\\"v\\""'
dict 'a=b, c=d'
  {'a': 'b', 'c': 'd'} -> 'a=b, c=d'
dict 'realm="Login Required", charset=UTF-8'
  {'realm': 'Login Required', 'charset': 'UTF-8'} -> 'realm="Login Required", charset=UTF-8'
dict 'key, other=1, =nokey, empty='
  {'key': None, 'other': '1', 'empty': ''} -> 'key, other=1, empty=""'
dict "title*=UTF-8''%E2%82%AC%20rates, plain=x"
  {'title': '€ rates', 'plain': 'x'} -> 'title="€ rates", plain=x'
dict "title*=iso-8859-1'en'%A3%20pound"
  {'title': '£ pound'} -> 'title="£ pound"'
dict "title*=bogus''%41%42"
  {'title': '%41%42'} -> 'title=%41%42'
dict 'name*=noquotes'
  {'name': 'noquotes'} -> 'name=noquotes'
dict 'a="1", a="2", b=3'
  {'a': '2', 'b': '3'} -> 'a=2, b=3'
dict 'q="quoted \\"inner\\" text"'
  {'q': 'quoted "inner" text'} -> 'q="quoted \\"inner\\" text"'
dict 'x = 1 , y= "2" ,z =3'
  {'x': '1', 'y': '2', 'z': '3'} -> 'x=1, y=2, z=3'
dict 'max-age=0, no-cache, no-store, must-revalidate'
  {'max-age': '0', 'no-cache': None, 'no-store': None, 'must-revalidate': None} -> 'max-age=0, no-cache, no-store, must-revalidate'
dict 'username="Mufasa", realm="testrealm@host.com", nonce="dcd98b7102dd2f0e8b11d0f600bfb0c093", uri="/dir/index.html", qop=auth, nc=00000001, cnonce="0a4f113b"'
  {'username': 'Mufasa', 'realm': 'testrealm@host.com', 'nonce': 'dcd98b7102dd2f0e8b11d0f600bfb0c093', 'uri': '/dir/index.html', 'qop': 'auth', 'nc': '00000001', 'cnonce': '0a4f113b'} -> 'username=Mufasa, realm="testrealm@host.com", nonce=dcd98b7102dd2f0e8b11d0f600bfb0c093, uri="/dir/index.html", qop=auth, nc=00000001, cnonce=0a4f113b'
options 'text/html; charset=UTF-8'
  ('text/html', {'charset': 'UTF-8'}) -> 'text/html; charset=UTF-8'
options ''
  ('', {}) -> ''
options 'text/plain'
  ('text/plain', {}) -> 'text/plain'
options 'multipart/form-data; boundary="----WebKitFormBoundary7MA4YWxkTrZu0gW"'
  ('multipart/form-data', {'boundary': '----WebKitFormBoundary7MA4YWxkTrZu0gW'}) -> 'multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW'
options 'attachment; filename="report 2024.pdf"; size=1024'
  ('attachment', {'filename': 'report 2024.pdf', 'size': '1024'}) -> 'attachment; filename="report 2024.pdf"; size=1024'
options "attachment; filename*=UTF-8''na%C3%AFve%20file.txt"
  ('attachment', {'filename': 'naïve file.txt'}) -> 'attachment; filename="naïve file.txt"'
options 'attachment; filename*=utf-8\'en\'%E2%82%AC%20rates.csv; filename="EURO rates.csv"'
  ('attachment', {'filename': 'EURO rates.csv'}) -> 'attachment; filename="EURO rates.csv"'
options 'form-data; name*0="long"; name*1="-part"; name*2="-name"'
  ('form-data', {'name': 'long-part-name'}) -> 'form-data; name=long-part-name'
options 'form-data; title*0*=us-ascii\'en\'This%20is%20even%20more%20; title*1*=%2A%2A%2Afun%2A%2A%2A%20; title*2="isn\'t it!"'
  ('form-data', {'title': "This is even more ***fun*** isn't it!"}) -> 'form-data; title="This is even more ***fun*** isn\'t it!"'
options 'text/html; Charset="utf-8"; LEVEL=1'
  ('text/html', {'charset': 'utf-8', 'level': '1'}) -> 'text/html; charset=utf-8; level=1'
options 'text/html; charset'
  ('text/html', {}) -> 'text/html'
options 'text/html; =value; key=; ok=1'
  ('text/html', {'ok': '1'}) -> 'text/html; ok=1'
options 'text/html; "quoted"=x; next=y'
  ('text/html', {'next': 'y'}) -> 'text/html; next=y'
options 'form-data; name="a\\"b"; filename="c\\\\d.txt"'
  ('form-data', {'name': 'a"b', 'filename': 'c\\d.txt'}) -> 'form-data; name="a\\"b"; filename="c\\\\d.txt"'
options 'form-data; name="html%22quote"'
  ('form-data', {'name': 'html"quote'}) -> 'form-data; name="html\\"quote"'
options '  text/css  ;  charset = utf-8  '
  ('text/css', {}) -> 'text/css'
options 'application/json;;;charset=utf-8'
  ('application/json', {'charset': 'utf-8'}) -> 'application/json; charset=utf-8'
options 'text/plain; a="semi;colon"; b=2'
  ('text/plain', {'a': 'semi;colon', 'b': '2'}) -> 'text/plain; a="semi;colon"; b=2'
options 'text/plain; a="unterminated; b=2'
  ('text/plain', {'b': '2'}) -> 'text/plain; b=2'
options "image/png; name*=bogus''x%20y"
  ('image/png', {'name': 'x%20y'}) -> 'image/png; name=x%20y'
options 'message/external-body; access-type=URL; URL*0="ftp://"; URL*1="cs.utk.edu/pub/moore/bulk-mailer/bulk-mailer.tar"'
  ('message/external-body', {'access-type': 'URL', 'url': 'ftp://cs.utk.edu/pub/moore/bulk-mailer/bulk-mailer.tar'}) -> 'message/external-body; access-type=URL; url="ftp://cs.utk.edu/pub/moore/bulk-mailer/bulk-mailer.tar"'
