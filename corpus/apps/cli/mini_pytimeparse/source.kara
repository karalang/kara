    s.push_str("+ 1 minute\tseconds\n");
    s.push_str("1.2 seconds\tseconds\n");
    s.push_str("1.2 minutes\tseconds\n");
    s.push_str("1.5h\tseconds\n");
    s.push_str("4.5m 3s\tseconds\n");
    s.push_str("1:30\tseconds\n");
