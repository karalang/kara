fn jobs_tsv() -> String {
    """
	pods.json	.items | length
-r	pods.json	.items[] | "\\(.metadata.namespace)/\\(.metadata.name) \\(.status.phase)"
-c	pods.json	[.items[] | select(.status.phase != "Running") | .metadata.name]
	pods.json	.items | group_by(.metadata.namespace) | map({ns: .[0].metadata.namespace, pods: length, restarts: (map(.status.containerStatuses[].restartCount) | add)})
-r	pods.json	.items[] | .metadata.name as $pod | .status.containerStatuses[]? | [$pod, .name, .image, .restartCount, .ready] | @tsv
-c	pods.json	[.items[].metadata.labels.app] | unique, (map(select(startswith("a") or endswith("e"))) | sort)
-c	pods.json	.items | map(select(.metadata.labels.tier? == "web")) | sort_by(.metadata.name) | map(.metadata.name)
	pods.json	.items | max_by(.status.containerStatuses | map(.restartCount) | add // 0) | .metadata.name
-r	pods.json	.items[] | select(.status.startTime) | "\\(.metadata.name)\\t\\(1760140800 - (.status.startTime | fromdateiso8601)) s\\t\\(.status.startTime | fromdateiso8601 | todate)"
-c	pods.json	[.items[] | try (.status.containerStatuses[0].restartCount | if . > 3 then error("too many restarts: \\(.)") else . end) catch .]
--argjson n 3 -c	pods.json	[limit($n; .items[].metadata.name)], [.items[] | .metadata.labels | to_entries | length], (.items | first(.[] | select(.status.phase == "Failed")) | .metadata.name)
	releases.json	[.[] | select(.prerelease | not)] | first | .tag_name
-r	releases.json	.[] | "\\(.tag_name): \\([.assets[].download_count] | add // 0) downloads"
-c	releases.json	[.[] | .assets[] | select(.name | endswith(".tar.gz"))] | map({name, mb: (.size / 1048576 * 10 | floor / 10)})
-c	releases.json	map(.tag_name | ltrimstr("v") | split("-")[0] | split(".") | map(tonumber)) | sort, (sort | last | map(tostring) | join("."))
-r	releases.json	.[] | [.tag_name, (.published_at | fromdateiso8601 | . / 86400 | floor), .prerelease] | @csv
-c	events.ndjson	select(.level == "error") | {ts, svc, msg}
-s	events.ndjson	group_by(.svc) | map({svc: .[0].svc, n: length, levels: (map(.level) | unique), max: (map(.latency_ms | numbers) | max)})
-s -r	events.ndjson	map(.level) | reduce .[] as $l ({}; .[$l] += 1) | to_entries[] | "\\(.key)=\\(.value)"
	events.ndjson	.latency_ms / 1000
-n	events.ndjson	[inputs | .latency_ms | numbers] | add / length
-n -c	events.ndjson	foreach inputs as $e ({n: 0, slow: 0}; .n += 1 | .slow += (if ($e.latency_ms | type) == "number" and $e.latency_ms > 100 then 1 else 0 end); [.n, .slow])
	config.json	.services.api.replicas += 2 | .services.api
-c	config.json	del(.services.legacy, .tags[0]) | [(.services | keys), .tags]
-c	config.json	[paths(type == "number")]
-c	config.json	to_entries | map(select(.key | startswith("feature_"))) | from_entries
	config.json	. * {"services": {"api": {"image": "api:2.0", "env": {"LOG_LEVEL": "debug"}}}} | .services.api
-c	config.json	walk(if type == "string" then ascii_upcase else . end) | .services.worker, .limits
-c	config.json	[.. | objects | select(has("port")) | .port], [.. | numbers] , (.limits | map_values(. * 2))
-r	config.json	.services | to_entries[] | "\\(.key)\\t\\(.value.port // "-")\\t\\(.value.env | keys | join(","))"
-c	config.json	getpath(["services","api","env"]), setpath(["limits","ratio"]; 0.25).limits, (delpaths([["services"],["environments"]]) | keys_unsorted)
--arg env prod	config.json	.environments[$env].url, (.environments | to_entries | map(.value.replicas) | add)
-c -S	config.json	.limits, {z: 1, a: {y: 2, b: 3}}
-c	config.json	def fact: if . <= 1 then 1 else . * (. - 1 | fact) end; def twice(f): f | f; [range(1;8) | fact], (5 | twice(. * 3)), ([.tags[] | ascii_downcase] | unique)
-c	config.json	.tags as [$first, $second] | {$first, $second, rest: .tags[2:], count: (.tags | length), idx: (.tags | index("red"))}
	config.json	.limits.ratio + .limits.burst, .limits.ratio * 3, .version / 4, -.limits.max_conns, 10 % 3, (.tags | length) * 1e17
-r	config.json	.owner | @base64, @uri, @html, ("a b <c>" | @sh), ([1, "x,y", null] | @csv), (. | @json), ("\\(.)" | ascii_upcase)
	config.json	.services.api + 1
	config.json	.tags[] | .name
-c	config.json	([.services[] | .port] | sort), ([.services[].replicas] | add), ([.tags[] | length] | min, max), (.version | tostring | length)
	config.json	.version as $v | $nope
	config.json	.name | upcase
	config.json	.services | keys | +
	config.json	.a ++ 1
-c	config.json	path(.services.api.env[]), [paths(type == "boolean")], ([path(..)] | length)
-c	config.json	[1, null, true, "a", [2], {"k": 0}, false, -1.5] | sort, (map(type) | unique)

"""
}


// ------------------------------------------------------------ the command line

// jq's compile-error report: each error, the program with the column
// marked, and the count.
fn compile_report(prog: Str, errs: ref Vec[CErr], err: mut ref String) {
    for i in 0..errs.len() {
        let c = ref errs[i];
        err.push_str(f"jq: error: {c.msg} at <top-level>, line 1:\n{prog}{spaces(c.col)}\n");
    }
    let n = errs.len();
    let s = if n == 1 { "" } else { "s" };
    err.push_str(f"jq: {n} compile error{s}\n");
}

// The prelude's definitions as frames, outermost first; returns the
// innermost one, and records each name/arity for the checks.
fn base_env(tree: ref Prog, r: mut ref R, root: i64, names: mut ref Vec[String]) -> i64 {
    let mut e = root;
    let mut env: i64 = -1;
    loop {
        let x = ref tree.exprs[e];
        match x {
            Expr.Def(d, body) => {
                let fd = ref tree.defs[*d];
                env = push_frame(mut r, F_DEF, fd.name, fd.params.len(), J.Null, *d, -1, env);
                names.push(f"{fd.name}/{fd.params.len()}");
                e = *body;
            }
            _ => break,
        }
    }
    env
}

fn count_newlines(s: Str) -> i64 {
    let b = s.bytes();
    let mut n: i64 = 0;
    for i in 0..b.len() {
        if b[i] == b'\n' {
            n += 1;
        }
    }
    n
}

// Options of one job.
struct Opts { compact: bool, raw: bool, slurp: bool, null_input: bool, sort: bool, names: Vec[String], vals: Vec[J] }

fn parse_flags(words: ref Vec[String]) -> Result[Opts, String] {
    let mut o = Opts { compact: false, raw: false, slurp: false, null_input: false, sort: false, names: Vec.new(), vals: Vec.new() };
    let mut i: i64 = 0;
    while i < words.len() {
        let w = words[i].clone();
        if w == "--arg" or w == "--argjson" {
            if i + 2 >= words.len() {
                return Err(f"{w} takes two parameters (e.g. {w} varname value)");
            }
            o.names.push(f"${words[i + 1]}");
            if w == "--arg" {
                o.vals.push(J.Str(words[i + 2].clone()));
            } else {
                match parse_json(words[i + 2]) {
                    Ok(x) => o.vals.push(x),
                    Err(_) => return Err(f"Invalid JSON text passed to --argjson"),
                }
            }
            i += 3;
            continue;
        }
        let b = w.bytes();
        for k in 1..b.len() {
            let c = b[k];
            if c == b'c' {
                o.compact = true;
            } else if c == b'r' {
                o.raw = true;
            } else if c == b's' {
                o.slurp = true;
            } else if c == b'n' {
                o.null_input = true;
            } else if c == b'S' {
                o.sort = true;
            } else {
                return Err(f"Unknown option: {w}");
            }
        }
        i += 1;
    }
    Ok(o)
}

// Runs one input through the program: its outputs to `out`, its error
// to `err`; returns the exit status it leaves (5 after an error).
fn process(tree: ref Prog, r: mut ref R, root: i64, input: ref J, env: i64, o: ref Opts, file: Str, out: mut ref String, err: mut ref String) -> i64 {
    let res = run(tree, mut r, root, input, env);
    for i in 0..res.vals.len() {
        let v = ref res.vals[i];
        match v {
            J.Str(s) => {
                if o.raw {
                    out.push_str(s);
                } else {
                    dump_to(v, not o.compact, o.sort, 0, mut out);
                }
            }
            _ => dump_to(v, not o.compact, o.sort, 0, mut out),
        }
        out.push_str("\n");
    }
    let e = match res.err {
        Some(x) => x,
        None => return 0,
    };
    let loc = if r.line < 0 { "<unknown>".to_string() } else { f"{file}:{r.line}" };
    // a `ref` binding: `karac check` takes the `J.Str(s)` arm as moving
    // `e` on every path (B-2026-10-15-32)
    let ev = ref e;
    match ev {
        J.Str(s) => err.push_str(f"jq: error (at {loc}): {s}\n"),
        _ => err.push_str(f"jq: error (at {loc}) (not a string): {dump(e)}\n"),
    }
    5
}

// One jq invocation: what it prints on stdout and on stderr, and its
// exit status.
fn run_job(tree: mut ref Prog, prelude: i64, words: ref Vec[String], file: Str, prog: Str, out: mut ref String, err: mut ref String) -> i64 {
    let o = match parse_flags(words) {
        Ok(x) => x,
        Err(m) => {
            err.push_str(f"jq: {m}\n");
            return 2;
        }
    };
    let root = match parse_program(mut tree, prog) {
        Ok(e) => e,
        Err(c) => {
            let errs: Vec[CErr] = vec![c];
            compile_report(prog, errs, mut err);
            return 3;
        }
    };
    let mut r = R { frames: Vec.new(), inputs: Vec.new(), lines: Vec.new(), next: 0, line: -1, file: f"data/{file}" };
    let mut fns: Vec[String] = Vec.new();
    let mut env = base_env(tree, mut r, prelude, mut fns);
    env = push_var(mut r, "$ENV", empty_obj(), env);
    for i in 0..o.names.len() {
        env = push_var(mut r, o.names[i], o.vals[i].clone(), env);
    }
    let mut sc = Scope { fns: fns, vars: o.names.clone() };
    let mut errs: Vec[CErr] = Vec.new();
    check(tree, root, mut sc, mut errs);
    if errs.len() > 0 {
        compile_report(prog, errs, mut err);
        return 3;
    }
    let text = match fs.read_to_string(f"data/{file}") {
        Ok(t) => t,
        Err(e) => {
            err.push_str(f"jq: error: Could not open {file}: {e}\n");
            return 2;
        }
    };
    let (vals, lines) = match parse_values(text) {
        Ok(x) => x,
        Err(m) => {
            err.push_str(f"jq: error (at {file}:0): {m}\n");
            return 2;
        }
    };
    if o.slurp {
        r.inputs.push(arr(vals));
        r.lines.push(count_newlines(text));
    } else {
        r.inputs = vals;
        r.lines = lines;
    }
    if o.null_input {
        return process(tree, mut r, root, J.Null, env, o, file, mut out, mut err);
    }
    let mut status: i64 = 0;
    while r.next < r.inputs.len() {
        let k = r.next;
        r.next += 1;
        r.line = r.lines[k];
        let input = r.inputs[k].clone();
        status = process(tree, mut r, root, input, env, o, file, mut out, mut err);
    }
    status
}

fn write_data() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        return Err(f"cannot create data: {e}");
    }
    let names: Array[Str, 4] = ["pods.json", "releases.json", "events.ndjson", "config.json"];
    let texts: Array[String, 4] = [pods_json(), releases_json(), events_ndjson(), config_json()];
    for i in 0..4 {
        if let Err(e) = fs.write(f"data/{names[i]}", texts[i].clone()) {
            return Err(f"cannot write data/{names[i]}: {e}");
        }
    }
    if let Err(e) = fs.write("jobs.tsv".to_string(), jobs_tsv()) {
        return Err(f"cannot write jobs.tsv: {e}");
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        println(e);
        return;
    }
    let jobs = match fs.read_to_string("jobs.tsv".to_string()) {
        Ok(t) => t,
        Err(e) => {
            println(f"cannot read jobs.tsv: {e}");
            return;
        }
    };
    let mut tree = new_prog();
    let prelude = match parse_program(mut tree, PRELUDE) {
        Ok(e) => e,
        Err(c) => {
            println(f"prelude: {c.msg} at {c.col}");
            return;
        }
    };
    let lines = split_str(jobs, "\n");
    for i in 0..lines.len() {
        let line = str_of(lines[i]);
        if line.len() == 0 {
            continue;
        }
        let fields = split_str(line, "\t");
        if fields.len() != 3 {
            println(f"jobs.tsv: bad line {line}");
            return;
        }
        let flags = str_of(fields[0]);
        let file = str_of(fields[1]);
        let prog = str_of(fields[2]);
        let mut words: Vec[String] = Vec.new();
        let parts = split_str(flags, " ");
        for k in 0..parts.len() {
            let w = str_of(parts[k]);
            if w.len() > 0 {
                words.push(w);
            }
        }
        let shown = if flags.len() > 0 { f"{flags} " } else { String.new() };
        println(f"$ jq {shown}'{prog}' {file}");
        let mut out = String.new();
        let mut err = String.new();
        let status = run_job(mut tree, prelude, words, file, prog, mut out, mut err);
        print(out);
        print(err);
        if status != 0 {
            println(f"[exit {status}]");
        }
    }
}
