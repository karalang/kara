// mini_prettytable: text tables as prettytable 3.16.0 draws them, the
// library behind many Python command line tools' `print(table)`. The
// port covers:
// - tables built by rows, columns and an index column, with dividers,
//   slices, copies and every option of the constructor and get_string;
// - borders, rules, padding, alignment, wrapping by width, minimum and
//   maximum table widths, titles and header styles;
// - sorting with sort keys, row filters and start/end slicing, with
//   CPython's sort and the TypeErrors it raises;
// - int, float, None and custom formats;
// - the seven preset styles and ColorTable with its themes;
// - CSV, JSON, HTML, LaTeX and MediaWiki output, and pagination;
// - tables read from CSV (with csv.Sniffer), JSON, HTML and MediaWiki;
// - six programs: a top-like process list, a disk report, a test
//   summary, a host inventory, a dependency audit and an invoice.
//
// expected.out is the output of oracle.py, which runs the jobs through
// prettytable itself.

// ------------------------------------------------------------ characters

fn chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn text(v: ref Vec[char]) -> String {
    v.iter().collect()
}

fn slice(v: ref Vec[char], lo: i64, hi: i64) -> Vec[char] {
    let mut a = lo;
    let mut b = hi;
    if a < 0 {
        a = 0;
    }
    if b > v.len() {
        b = v.len();
    }
    if a >= b {
        return Vec.new();
    }
    v[a..b].to_vec()
}

fn width(s: ref String) -> i64 {
    s.chars().count()
}

fn spaces(n: i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(' ');
    }
    s
}

fn repeat(s: ref String, n: i64) -> String {
    let mut out = String.new();
    for _ in 0..n {
        out.push_str(s);
    }
    out
}

fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

// str.isspace, which str.strip, str.split and float() use.
fn py_space(c: char) -> bool {
    c.is_whitespace() or (c >= '\u{1c}' and c <= '\u{1f}')
}

fn py_strip(s: ref String) -> String {
    let v = chars(s);
    let mut lo = 0;
    let mut hi = v.len();
    while lo < hi and py_space(v[lo]) {
        lo += 1;
    }
    while hi > lo and py_space(v[hi - 1]) {
        hi -= 1;
    }
    text(slice(v, lo, hi))
}

fn py_rstrip(s: ref String) -> String {
    let v = chars(s);
    let mut hi = v.len();
    while hi > 0 and py_space(v[hi - 1]) {
        hi -= 1;
    }
    text(slice(v, 0, hi))
}

fn ascii_lower(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c >= 'A' and c <= 'Z' {
            out.push(char.try_from(c as i64 + 32).unwrap_or(c));
        } else {
            out.push(c);
        }
    }
    out
}

// str.rfind(c), in code points.
fn rfind(v: ref Vec[char], c: char) -> i64 {
    let mut k = v.len() - 1;
    while k >= 0 {
        if v[k] == c {
            return k;
        }
        k -= 1;
    }
    -1
}

// `needle in hay`
fn contains_seq(hay: ref Vec[char], needle: ref Vec[char]) -> bool {
    if needle.is_empty() {
        return true;
    }
    let mut i = 0;
    while i + needle.len() <= hay.len() {
        let mut ok = true;
        for k in 0..needle.len() {
            if hay[i + k] != needle[k] {
                ok = false;
                break;
            }
        }
        if ok {
            return true;
        }
        i += 1;
    }
    false
}

// str.splitlines()
fn line_break(c: char) -> bool {
    c == '\n' or c == '\r' or c == '\u{b}' or c == '\u{c}' or c == '\u{1c}' or c == '\u{1d}' or c == '\u{1e}'
        or c == '\u{85}' or c == '\u{2028}' or c == '\u{2029}'
}

fn splitlines(s: ref String) -> Vec[String] {
    let v = chars(s);
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    let mut i = 0;
    while i < v.len() {
        let c = v[i];
        if line_break(c) {
            out.push(cur);
            cur = String.new();
            if c == '\r' and i + 1 < v.len() and v[i + 1] == '\n' {
                i += 1;
            }
        } else {
            cur.push(c);
        }
        i += 1;
    }
    if not cur.is_empty() {
        out.push(cur);
    }
    out
}

// re.split("[\r\n]", s)
fn split_rn(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == '\r' or c == '\n' {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn has_line_break(s: ref String) -> bool {
    s.contains("\n") or s.contains("\r")
}

fn hex_digits(v: i64, n: i64) -> String {
    let mut s = f"{v:x}";
    while s.len() < n {
        s = f"0{s}";
    }
    s
}

fn printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) or (c >= 0x205F and c <= 0x206F) {
        return false;
    }
    if c == 0x3000 or c == 0xFEFF or (c >= 0xE000 and c <= 0xF8FF) {
        return false;
    }
    true
}

// repr(str)
fn repr_str(s: ref String) -> String {
    let single = s.contains("'");
    let double = s.contains("\"");
    let q = if single and not double { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        let o = c as i64;
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if printable(o) {
            out.push(c);
        } else if o < 0x100 {
            out.push_str(f"\\x{hex_digits(o, 2)}");
        } else if o < 0x10000 {
            out.push_str(f"\\u{hex_digits(o, 4)}");
        } else {
            out.push_str(f"\\U{hex_digits(o, 8)}");
        }
    }
    out.push(q);
    out
}

// s.encode("unicode_escape").decode()
fn unicode_escape(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        let o = c as i64;
        if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if o >= 0x20 and o < 0x7f {
            out.push(c);
        } else if o < 0x100 {
            out.push_str(f"\\x{hex_digits(o, 2)}");
        } else if o < 0x10000 {
            out.push_str(f"\\u{hex_digits(o, 4)}");
        } else {
            out.push_str(f"\\U{hex_digits(o, 8)}");
        }
    }
    out
}

fn hex_value(c: char) -> i64 {
    if c >= '0' and c <= '9' {
        c as i64 - 48
    } else if c >= 'a' and c <= 'f' {
        c as i64 - 87
    } else if c >= 'A' and c <= 'F' {
        c as i64 - 55
    } else {
        -1
    }
}

// s.encode("utf-8").decode("unicode_escape"), for the escapes above.
fn unicode_unescape(s: ref String) -> String {
    let v = chars(s);
    let mut out = String.new();
    let mut i = 0;
    while i < v.len() {
        if v[i] != '\\' or i + 1 >= v.len() {
            out.push(v[i]);
            i += 1;
            continue;
        }
        let e = v[i + 1];
        let n = if e == 'x' { 2 } else if e == 'u' { 4 } else if e == 'U' { 8 } else { 0 };
        if n > 0 {
            let mut code = 0;
            for k in 0..n {
                code = code * 16 + hex_value(v[i + 2 + k]);
            }
            out.push(char.try_from(code).unwrap_or('?'));
            i += 2 + n;
        } else {
            if e == 't' {
                out.push('\t');
            } else if e == 'n' {
                out.push('\n');
            } else if e == 'r' {
                out.push('\r');
            } else {
                out.push(e);
            }
            i += 2;
        }
    }
    out
}


fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    if x == 1.0 / 0.0 {
        return "inf".to_string();
    }
    if x == -1.0 / 0.0 {
        return "-inf".to_string();
    }
    if x == 0.0 {
        return if x.to_bits() >> 63 == 1 { "-0.0".to_string() } else { "0.0".to_string() };
    }
    f"{x}"
}

// ------------------------------------------------------------ Python's int() and float()

// The digits of s[lo..hi] with Python's underscores: each '_' sits between
// two digits. None if anything else is there.
fn digits_with_underscores(v: ref Vec[char], lo: i64, hi: i64) -> Option[String] {
    let mut out = String.new();
    for k in lo..hi {
        let c = v[k];
        if is_digit(c) {
            out.push(c);
        } else if c == '_' and k > lo and k + 1 < hi and is_digit(v[k - 1]) and is_digit(v[k + 1]) {
            continue;
        } else {
            return None;
        }
    }
    Some(out)
}

// Can int(s) convert it?
fn py_int_ok(s: ref String) -> bool {
    let v = chars(py_strip(s));
    let mut i = 0;
    if i < v.len() and (v[i] == '+' or v[i] == '-') {
        i += 1;
    }
    if i >= v.len() {
        return false;
    }
    match digits_with_underscores(v, i, v.len()) {
        Some(d) => not d.is_empty(),
        None => false,
    }
}

// float(s), or None where it raises.
fn py_float(s: ref String) -> Option[f64] {
    let v = chars(py_strip(s));
    let mut i = 0;
    let mut neg = false;
    if i < v.len() and (v[i] == '+' or v[i] == '-') {
        neg = v[i] == '-';
        i += 1;
    }
    let rest = ascii_lower(text(slice(v, i, v.len())));
    if rest == "inf" or rest == "infinity" {
        return Some(if neg { -1.0 / 0.0 } else { 1.0 / 0.0 });
    }
    if rest == "nan" {
        return Some(0.0 / 0.0);
    }
    let n = v.len();
    let mut k = i;
    while k < n and (is_digit(v[k]) or v[k] == '_') {
        k += 1;
    }
    let int_part = digits_with_underscores(v, i, k)?;
    let mut frac_part = String.new();
    if k < n and v[k] == '.' {
        let f0 = k + 1;
        k += 1;
        while k < n and (is_digit(v[k]) or v[k] == '_') {
            k += 1;
        }
        frac_part = digits_with_underscores(v, f0, k)?;
    }
    if int_part.is_empty() and frac_part.is_empty() {
        return None;
    }
    let mut exp_part = "0".to_string();
    if k < n and (v[k] == 'e' or v[k] == 'E') {
        k += 1;
        let mut sign = String.new();
        if k < n and (v[k] == '+' or v[k] == '-') {
            sign.push(v[k]);
            k += 1;
        }
        let e0 = k;
        while k < n and (is_digit(v[k]) or v[k] == '_') {
            k += 1;
        }
        let e = digits_with_underscores(v, e0, k)?;
        if e.is_empty() {
            return None;
        }
        exp_part = f"{sign}{e}";
    }
    if k != n {
        return None;
    }
    let ip = if int_part.is_empty() { "0".to_string() } else { int_part };
    let fp = if frac_part.is_empty() { "0".to_string() } else { frac_part };
    let sign = if neg { "-" } else { "" };
    let lit = f"{sign}{ip}.{fp}e{exp_part}";
    match f64.parse(lit) {
        Ok(x) => Some(x),
        Err(_) => None,
    }
}

fn is_inf_or_nan(x: f64) -> bool {
    x != x or x == 1.0 / 0.0 or x == -1.0 / 0.0
}

// ------------------------------------------------------------ format specs

fn value_error(msg: ref String) -> String {
    f"ValueError: {msg}"
}

struct Spec {
    fill: char,
    align: char,
    sign: char,
    no_neg_0: bool,
    alternate: bool,
    width: i64,
    // 0 none, 1 ',' every 3, 2 '_' every 3, 3 '_' every 4
    sep: i64,
    precision: i64,
    kind: char,
}

fn is_align(c: char) -> bool {
    c == '<' or c == '>' or c == '=' or c == '^'
}

// A presentation type in an error message.
fn code_text(c: char) -> String {
    let o = c as i64;
    if o > 32 and o < 128 {
        f"'{c}'"
    } else {
        f"'\\x{o:x}'"
    }
}

fn unknown_code(c: char, tname: Str) -> String {
    value_error(f"Unknown format code {code_text(c)} for object of type '{tname}'")
}

fn both_seps() -> String {
    value_error("Cannot specify both ',' and '_'.")
}

// The digits at sp[pos..]: (value, digit count, position after them).
fn spec_integer(sp: ref Vec[char], pos: i64) -> Result[(i64, i64, i64), String] {
    let mut acc = 0;
    let mut n = 0;
    let mut p = pos;
    while p < sp.len() and is_digit(sp[p]) {
        let d = sp[p] as i64 - 48;
        if acc > (9223372036854775807 - d) / 10 {
            return Err(value_error("Too many decimal digits in format string"));
        }
        acc = acc * 10 + d;
        n += 1;
        p += 1;
    }
    Ok((acc, n, p))
}

// parse_internal_render_format_spec in Python/formatter_unicode.c.
fn parse_spec(sp: ref Vec[char], tname: Str, default_type: char, default_align: char) -> Result[Spec, String] {
    let mut f = Spec {
        fill: ' ',
        align: default_align,
        sign: '\u{0}',
        no_neg_0: false,
        alternate: false,
        width: -1,
        sep: 0,
        precision: -1,
        kind: default_type,
    };
    let end = sp.len();
    let mut pos = 0;
    let mut fill_given = false;
    let mut align_given = false;
    if end - pos >= 2 and is_align(sp[pos + 1]) {
        f.align = sp[pos + 1];
        f.fill = sp[pos];
        fill_given = true;
        align_given = true;
        pos += 2;
    } else if end - pos >= 1 and is_align(sp[pos]) {
        f.align = sp[pos];
        align_given = true;
        pos += 1;
    }
    if pos < end and (sp[pos] == ' ' or sp[pos] == '+' or sp[pos] == '-') {
        f.sign = sp[pos];
        pos += 1;
    }
    if pos < end and sp[pos] == 'z' {
        f.no_neg_0 = true;
        pos += 1;
    }
    if pos < end and sp[pos] == '#' {
        f.alternate = true;
        pos += 1;
    }
    if not fill_given and pos < end and sp[pos] == '0' {
        f.fill = '0';
        if not align_given and default_align == '>' {
            f.align = '=';
        }
        pos += 1;
    }
    let (w, width_digits, after_width) = spec_integer(sp, pos)?;
    pos = after_width;
    if width_digits > 0 {
        f.width = w;
    }
    if pos < end and sp[pos] == ',' {
        f.sep = 1;
        pos += 1;
    }
    if pos < end and sp[pos] == '_' {
        if f.sep != 0 {
            return Err(both_seps());
        }
        f.sep = 2;
        pos += 1;
    }
    if pos < end and sp[pos] == ',' and f.sep == 2 {
        return Err(both_seps());
    }
    if pos < end and sp[pos] == '.' {
        pos += 1;
        let (precision, precision_digits, after_precision) = spec_integer(sp, pos)?;
        pos = after_precision;
        if precision_digits == 0 {
            return Err(value_error("Format specifier missing precision"));
        }
        f.precision = precision;
    }
    if end - pos > 1 {
        return Err(value_error(f"Invalid format specifier '{text(sp)}' for object of type '{tname}'"));
    }
    if end - pos == 1 {
        f.kind = sp[pos];
    }
    if f.sep != 0 {
        let t = f.kind;
        let grouped = t == 'd' or t == 'e' or t == 'f' or t == 'g' or t == 'E' or t == 'G' or t == '%' or t == 'F' or t == '\u{0}';
        let radix = t == 'b' or t == 'o' or t == 'x' or t == 'X';
        if radix and f.sep == 2 {
            f.sep = 3;
        } else if not grouped {
            let which = if f.sep == 1 { "," } else { "_" };
            return Err(value_error(f"Cannot specify '{which}' with {code_text(t)}."));
        }
    }
    Ok(f)
}

fn fill_run(c: char, n: i64) -> String {
    let mut s = String.new();
    for _ in 0..n {
        s.push(c);
    }
    s
}

// body padded to the spec's width (body is n code points long).
fn pad_to(body: ref String, n: i64, w: i64, align: char, fill: char) -> String {
    let total = if w > n { w } else { n };
    let left = if align == '>' {
        total - n
    } else if align == '^' {
        (total - n) / 2
    } else {
        0
    };
    f"{fill_run(fill, left)}{body}{fill_run(fill, total - n - left)}"
}

// _PyUnicode_InsertThousandsGrouping: digits in groups of g, zero-filled
// out to min_width (which counts the separators).
fn group_digits(d: ref String, min_width: i64, g: i64, sep: char) -> String {
    let cs = chars(d);
    let mut remaining = cs.len();
    let mut pos = cs.len();
    let mut m = min_width;
    let mut groups: Vec[String] = Vec.new();
    let mut done = false;
    while not done {
        let mut l = remaining;
        if m > l {
            l = m;
        }
        if l < 1 {
            l = 1;
        }
        if l > g {
            l = g;
        }
        let n_zeros = if l > remaining { l - remaining } else { 0 };
        let n_chars = if remaining < l { remaining } else { l };
        groups.push(f"{fill_run('0', n_zeros)}{text(slice(cs, pos - n_chars, pos))}");
        pos -= n_chars;
        remaining -= n_chars;
        m -= l;
        if remaining <= 0 and m <= 0 {
            done = true;
        } else {
            m -= 1;
        }
    }
    let mut out = String.new();
    let mut k = groups.len() - 1;
    while k >= 0 {
        out.push_str(groups[k]);
        if k > 0 {
            out.push(sep);
        }
        k -= 1;
    }
    out
}

// calc_number_spec + fill_number: sign, prefix, digits (grouped here) and
// the remainder (a fraction, exponent or '%'), padded per the spec.
fn fill_number(sign: ref String, prefix: ref String, digits: ref String, remainder: ref String, f: ref Spec) -> String {
    let n_sign = width(sign);
    let n_prefix = width(prefix);
    let n_rem = width(remainder);
    let grouped = if f.sep == 0 {
        digits.clone()
    } else {
        let min_width = if f.fill == '0' and f.align == '=' {
            f.width - n_sign - n_prefix - n_rem
        } else {
            0
        };
        let sep = if f.sep == 1 { ',' } else { '_' };
        let g = if f.sep == 3 { 4 } else { 3 };
        group_digits(digits, min_width, g, sep)
    };
    let n = n_sign + n_prefix + width(grouped) + n_rem;
    let padding = if f.width > n { f.width - n } else { 0 };
    if f.align == '=' {
        f"{sign}{prefix}{fill_run(f.fill, padding)}{grouped}{remainder}"
    } else {
        pad_to(f"{sign}{prefix}{grouped}{remainder}", n, f.width, f.align, f.fill)
    }
}

fn sign_text(negative: bool, f: ref Spec) -> String {
    if negative {
        "-".to_string()
    } else if f.sign == '+' {
        "+".to_string()
    } else if f.sign == ' ' {
        " ".to_string()
    } else {
        String.new()
    }
}

// n in the given base, with lower- or upper-case letters.
fn to_base(n: u64, base: u64, upper: bool) -> String {
    if n == 0 {
        return "0".to_string();
    }
    let mut rev: Vec[char] = Vec.new();
    let mut m = n;
    while m > 0 {
        let d = (m % base) as i64;
        let c = if d < 10 { 48 + d } else if upper { 55 + d } else { 87 + d };
        rev.push(char.try_from(c).unwrap_or('?'));
        m = m / base;
    }
    rev.reverse();
    text(rev)
}

// format(v, spec) for an int: format_long_internal, or
// format_float_internal on float(v) for the float types.
fn format_int(v: i64, spec: ref String) -> Result[String, String] {
    let sp = chars(spec);
    if sp.is_empty() {
        return Ok(v.to_string());
    }
    let f = parse_spec(sp, "int", 'd', '>')?;
    let t = f.kind;
    if t == 'e' or t == 'E' or t == 'f' or t == 'F' or t == 'g' or t == 'G' or t == '%' {
        return Ok(format_float_spec(v as f64, f));
    }
    if not (t == 'b' or t == 'c' or t == 'd' or t == 'o' or t == 'x' or t == 'X' or t == 'n') {
        return Err(unknown_code(t, "int"));
    }
    if f.precision != -1 {
        return Err(value_error("Precision not allowed in integer format specifier"));
    }
    if f.no_neg_0 {
        return Err(value_error("Negative zero coercion (z) not allowed in integer format specifier"));
    }
    if t == 'c' {
        if f.sign != '\u{0}' {
            return Err(value_error("Sign not allowed with integer format specifier 'c'"));
        }
        if f.alternate {
            return Err(value_error("Alternate form (#) not allowed with integer format specifier 'c'"));
        }
        if v < 0 or v > 0x10ffff {
            return Err("OverflowError: %c arg not in range(0x110000)".to_string());
        }
        let mut one = String.new();
        one.push(char.try_from(v).unwrap_or('?'));
        return Ok(fill_number("", "", "", one, f));
    }
    let base: u64 = if t == 'b' {
        2
    } else if t == 'o' {
        8
    } else if t == 'x' or t == 'X' {
        16
    } else {
        10
    };
    let prefix = if not f.alternate or base == 10 {
        String.new()
    } else if t == 'b' {
        "0b".to_string()
    } else if t == 'o' {
        "0o".to_string()
    } else if t == 'x' {
        "0x".to_string()
    } else {
        "0X".to_string()
    };
    let a: u64 = if v < 0 { ((0 - (v + 1)) as u64) + 1 } else { v as u64 };
    let digits = to_base(a, base, t == 'X');
    Ok(fill_number(sign_text(v < 0, f), prefix, digits, "", f))
}

// format(True, spec): bool's own str() for an empty spec, an int otherwise.
fn format_bool(b: bool, spec: ref String) -> Result[String, String] {
    if spec.is_empty() {
        return Ok(if b { "True".to_string() } else { "False".to_string() });
    }
    format_int(if b { 1 } else { 0 }, spec)
}

// ------------------------------------------------------------ floats

// The exact decimal value of a positive finite x: big-endian digits d
// (no leading zero) and an exponent e, with x == d * 10^e.
fn exact_decimal(x: f64) -> (Vec[i64], i64) {
    let bits = x.to_bits() as i64;
    let e = (bits >> 52) & 0x7FF;
    let mut mant = bits & 0xFFFFFFFFFFFFF;
    let mut e2 = 0;
    if e == 0 {
        e2 = -1074;
    } else {
        mant = mant | 0x10000000000000;
        e2 = e - 1075;
    }
    while e2 < 0 and mant % 2 == 0 {
        mant = mant / 2;
        e2 += 1;
    }
    // Little-endian decimal digits of mant * 2^e2 (or * 5^-e2).
    let mut n: Vec[i64] = Vec.new();
    let mut t = mant;
    while t > 0 {
        n.push(t % 10);
        t = t / 10;
    }
    let factor = if e2 >= 0 { 2 } else { 5 };
    let times = if e2 >= 0 { e2 } else { 0 - e2 };
    for _ in 0..times {
        let mut carry = 0;
        for i in 0..n.len() {
            let v = n[i] * factor + carry;
            n[i] = v % 10;
            carry = v / 10;
        }
        while carry > 0 {
            n.push(carry % 10);
            carry = carry / 10;
        }
    }
    n.reverse();
    (n, if e2 >= 0 { 0 } else { e2 })
}

// The first `keep` digits of d (zero-padded), rounded half to even on the
// rest. When the rounding carries out, the result has keep + 1 digits.
fn round_digits(d: ref Vec[i64], keep: i64) -> Vec[i64] {
    let mut r: Vec[i64] = Vec.new();
    for i in 0..keep {
        r.push(if i < d.len() { d[i] } else { 0 });
    }
    if keep < 0 or keep >= d.len() {
        return r;
    }
    let first = d[keep];
    let mut rest = false;
    for i in (keep + 1)..d.len() {
        if d[i] != 0 {
            rest = true;
        }
    }
    let odd = keep > 0 and r[keep - 1] % 2 == 1;
    let up = first > 5 or (first == 5 and (rest or odd));
    if not up {
        return r;
    }
    let mut i = keep - 1;
    while i >= 0 {
        if r[i] == 9 {
            r[i] = 0;
            i -= 1;
        } else {
            r[i] += 1;
            return r;
        }
    }
    r.insert(0, 1);
    r
}

fn digit_text(d: ref Vec[i64], lo: i64, hi: i64) -> String {
    let mut s = String.new();
    for i in lo..hi {
        s.push(char.try_from(48 + d[i]).unwrap_or('?'));
    }
    s
}

// x >= 0 to `precision` places ('f').
fn fixed_text(x: f64, precision: i64, alt: bool) -> String {
    let mut n: Vec[i64] = Vec.new();
    if x != 0.0 {
        let (d, e) = exact_decimal(x);
        let keep = d.len() + e + precision;
        if keep >= 0 {
            n = round_digits(d, keep);
        }
    }
    // n is round(x * 10^precision); give it precision + 1 digits at least.
    while n.len() < precision + 1 {
        n.insert(0, 0);
    }
    let mut lead = 0;
    while lead < n.len() - precision - 1 and n[lead] == 0 {
        lead += 1;
    }
    let point = n.len() - precision;
    let mut s = digit_text(n, lead, point);
    if precision > 0 {
        s.push('.');
        s.push_str(digit_text(n, point, n.len()));
    } else if alt {
        s.push('.');
    }
    s
}

// x >= 0 rounded to p significant digits: (exactly p digits, the decimal
// exponent of the first).
fn significant(x: f64, p: i64) -> (Vec[i64], i64) {
    if x == 0.0 {
        let mut z: Vec[i64] = Vec.new();
        for _ in 0..p {
            z.push(0);
        }
        return (z, 0);
    }
    let (d, e) = exact_decimal(x);
    let mut exp = d.len() + e - 1;
    let mut r = round_digits(d, p);
    if r.len() > p {
        r.pop();
        exp += 1;
    }
    (r, exp)
}

fn exp_text(e: i64, upper: bool) -> String {
    let mark = if upper { 'E' } else { 'e' };
    let sign = if e < 0 { '-' } else { '+' };
    let a = if e < 0 { -e } else { e };
    if a < 10 {
        f"{mark}{sign}0{a}"
    } else {
        f"{mark}{sign}{a}"
    }
}

// PyOS_double_to_string of x >= 0 for the types e, f, g and r.
fn float_body(x: f64, t: char, precision: i64, alt: bool, add_dot_0: bool) -> String {
    let upper = t == 'E' or t == 'F' or t == 'G';
    if x != x {
        return if upper { "NAN".to_string() } else { "nan".to_string() };
    }
    if x == 1.0 / 0.0 {
        return if upper { "INF".to_string() } else { "inf".to_string() };
    }
    if t == 'f' or t == 'F' {
        return fixed_text(x, precision, alt);
    }
    if t == 'r' {
        let mut s = float_repr(x);
        if alt and not s.contains(".") {
            s = match s.find("e") {
                Some(k) => f"{s[0..k]}.{s[k..]}",
                None => f"{s}.",
            };
        }
        return s;
    }
    if t == 'e' or t == 'E' {
        let (d, e) = significant(x, precision + 1);
        let mut s = digit_text(d, 0, 1);
        if precision > 0 or alt {
            s.push('.');
        }
        s.push_str(digit_text(d, 1, d.len()));
        s.push_str(exp_text(e, upper));
        return s;
    }
    // 'g'
    let p = if precision == 0 { 1 } else { precision };
    let (d, e) = significant(x, p);
    let mut n = d.len();
    if not alt {
        while n > 1 and d[n - 1] == 0 {
            n -= 1;
        }
    }
    let decpt = e + 1;
    let limit = if add_dot_0 { p - 1 } else { p };
    let mut s = String.new();
    if decpt <= -4 or decpt > limit {
        s.push_str(digit_text(d, 0, 1));
        if n > 1 or alt {
            s.push('.');
        }
        s.push_str(digit_text(d, 1, n));
        s.push_str(exp_text(e, upper));
        return s;
    }
    if decpt <= 0 {
        s.push_str("0.");
        for _ in 0..(0 - decpt) {
            s.push('0');
        }
        s.push_str(digit_text(d, 0, n));
    } else if decpt >= n {
        s.push_str(digit_text(d, 0, n));
        for _ in 0..(decpt - n) {
            s.push('0');
        }
        if alt {
            s.push('.');
        }
    } else {
        s.push_str(digit_text(d, 0, decpt));
        s.push('.');
        s.push_str(digit_text(d, decpt, n));
    }
    if add_dot_0 and not s.contains(".") {
        s.push_str(".0");
    }
    s
}

fn all_zero_digits(s: ref String) -> bool {
    for c in s.chars() {
        if c >= '1' and c <= '9' {
            return false;
        }
        if c == 'e' or c == 'E' {
            break;
        }
    }
    true
}

// format_float_internal in Python/formatter_unicode.c.
fn format_float_spec(x: f64, f: ref Spec) -> String {
    let mut t = f.kind;
    let mut precision = f.precision;
    let mut default_precision = 6;
    let mut add_dot_0 = false;
    let mut pct = false;
    if t == '\u{0}' {
        add_dot_0 = true;
        t = 'r';
        default_precision = 0;
    }
    if t == 'n' {
        t = 'g';
    }
    let mut val = x;
    if t == '%' {
        t = 'f';
        val = val * 100.0;
        pct = true;
    }
    if precision < 0 {
        precision = default_precision;
    } else if t == 'r' {
        t = 'g';
    }
    let mut negative = val.to_bits() >> 63 == 1 and val == val;
    let a = if negative { 0.0 - val } else { val };
    let body = chars(float_body(a, t, precision, f.alternate, add_dot_0));
    if negative and f.no_neg_0 and val == val and val != -1.0 / 0.0 and all_zero_digits(text(body)) {
        negative = false;
    }
    let mut k = 0;
    while k < body.len() and is_digit(body[k]) {
        k += 1;
    }
    let mut rem = text(slice(body, k, body.len()));
    if pct {
        rem.push('%');
    }
    fill_number(sign_text(negative, f), "", text(slice(body, 0, k)), rem, f)
}

// format(x, spec) for a float.
fn format_float(x: f64, spec: ref String) -> Result[String, String] {
    let f = parse_spec(chars(spec), "float", '\u{0}', '>')?;
    let t = f.kind;
    if not (t == '\u{0}' or t == 'e' or t == 'E' or t == 'f' or t == 'F' or t == 'g' or t == 'G' or t == 'n' or t == '%') {
        return Err(unknown_code(t, "float"));
    }
    Ok(format_float_spec(x, f))
}


// ------------------------------------------------------------ characters

// textwrap's _whitespace: the only characters its regexes treat as space.
fn tw_is_ws(c: char) -> bool {
    c == ' ' or c == '\t' or c == '\n' or c == '\u{b}' or c == '\u{c}' or c == '\r'
}

// str.isspace, which str.strip and str.split use: Unicode White_Space plus
// the four ASCII separators U+001C..U+001F.
fn tw_py_space(c: char) -> bool {
    c.is_whitespace() or (c >= '\u{1c}' and c <= '\u{1f}')
}

// The regex class \w.
fn tw_is_word(c: char) -> bool {
    c.is_alphanumeric() or c == '_'
}

// textwrap's `letter`, [^\d\W]: a word character that is not a digit.
fn tw_is_letter(c: char) -> bool {
    tw_is_word(c) and not c.is_ascii_digit()
}

// textwrap's `word_punct`, [\w!"'&.,?].
fn tw_is_word_punct(c: char) -> bool {
    tw_is_word(c) or c == '!' or c == '"' or c == '\'' or c == '&' or c == '.' or c == ',' or c == '?'
}

fn tw_chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn tw_text(v: ref Vec[char]) -> String {
    v.iter().collect()
}

fn tw_is_blank(v: ref Vec[char]) -> bool {
    v.iter().all(|c| tw_py_space(*c))
}

fn tw_lstrip(v: ref Vec[char]) -> Vec[char] {
    let mut i = 0;
    while i < v.len() and tw_py_space(v[i]) {
        i += 1;
    }
    v[i..].to_vec()
}

fn tw_rstrip(v: ref Vec[char]) -> Vec[char] {
    let mut n = v.len();
    while n > 0 and tw_py_space(v[n - 1]) {
        n -= 1;
    }
    v[0..n].to_vec()
}

fn tw_concat(parts: ref Vec[Vec[char]]) -> Vec[char] {
    let mut out: Vec[char] = Vec.new();
    for p in parts.iter() {
        for c in p.iter() {
            out.push(*c);
        }
    }
    out
}

fn tw_total_len(parts: ref Vec[Vec[char]]) -> i64 {
    let mut n = 0;
    for p in parts.iter() {
        n += p.len();
    }
    n
}

// str.split() with no argument: runs of whitespace separate the words.
fn tw_py_split(v: ref Vec[char]) -> Vec[Vec[char]] {
    let mut words: Vec[Vec[char]] = Vec.new();
    let mut cur: Vec[char] = Vec.new();
    for c in v.iter() {
        if tw_py_space(*c) {
            if not cur.is_empty() {
                words.push(cur);
                cur = Vec.new();
            }
        } else {
            cur.push(*c);
        }
    }
    if not cur.is_empty() {
        words.push(cur);
    }
    words
}

// str.split(sep) for a one-character separator: always at least one piece.
fn tw_split_on(v: ref Vec[char], sep: char) -> Vec[Vec[char]] {
    let mut pieces: Vec[Vec[char]] = Vec.new();
    let mut cur: Vec[char] = Vec.new();
    for c in v.iter() {
        if *c == sep {
            pieces.push(cur);
            cur = Vec.new();
        } else {
            cur.push(*c);
        }
    }
    pieces.push(cur);
    pieces
}

fn tw_join_on(pieces: ref Vec[Vec[char]], sep: char) -> Vec[char] {
    let mut out: Vec[char] = Vec.new();
    for i in 0..pieces.len() {
        if i > 0 {
            out.push(sep);
        }
        for c in pieces[i].iter() {
            out.push(*c);
        }
    }
    out
}

fn tw_starts_with(v: ref Vec[char], prefix: ref Vec[char]) -> bool {
    if prefix.len() > v.len() {
        return false;
    }
    for i in 0..prefix.len() {
        if v[i] != prefix[i] {
            return false;
        }
    }
    true
}

// ------------------------------------------------------------ TextWrapper

struct Wrapper {
    width: i64,
    initial_indent: Vec[char],
    subsequent_indent: Vec[char],
    expand_tabs: bool,
    tabsize: i64,
    replace_whitespace: bool,
    fix_sentence_endings: bool,
    break_long_words: bool,
    break_on_hyphens: bool,
    drop_whitespace: bool,
    max_lines: Option[i64],
    placeholder: Vec[char],
}

impl Wrapper {
    fn new(width: i64) -> Wrapper {
        Wrapper {
            width: width,
            initial_indent: Vec.new(),
            subsequent_indent: Vec.new(),
            expand_tabs: true,
            tabsize: 8,
            replace_whitespace: true,
            fix_sentence_endings: false,
            break_long_words: true,
            break_on_hyphens: true,
            drop_whitespace: true,
            max_lines: None,
            placeholder: tw_chars(" [...]"),
        }
    }

    // _munge_whitespace: str.expandtabs, then every _whitespace character
    // becomes a space.
    fn munge(ref self, t: ref Vec[char]) -> Vec[char] {
        let mut out: Vec[char] = Vec.new();
        if self.expand_tabs {
            let mut col = 0;
            for c in t.iter() {
                if *c == '\t' {
                    if self.tabsize > 0 {
                        let incr = self.tabsize - col % self.tabsize;
                        for _ in 0..incr {
                            out.push(' ');
                        }
                        col += incr;
                    }
                } else if *c == '\n' or *c == '\r' {
                    out.push(*c);
                    col = 0;
                } else {
                    out.push(*c);
                    col += 1;
                }
            }
        } else {
            out = t.clone();
        }
        if self.replace_whitespace {
            for i in 0..out.len() {
                if tw_is_ws(out[i]) {
                    out[i] = ' ';
                }
            }
        }
        out
    }

    // _split: wordsep_re (or wordsep_simple_re) splits the text into
    // chunks that tile it.
    fn split(ref self, t: ref Vec[char]) -> Vec[Vec[char]] {
        let n = t.len();
        let mut chunks: Vec[Vec[char]] = Vec.new();
        let mut i = 0;
        while i < n {
            let mut end = i;
            if tw_is_ws(t[i]) {
                while end < n and tw_is_ws(t[end]) {
                    end += 1;
                }
            } else if not self.break_on_hyphens {
                while end < n and not tw_is_ws(t[end]) {
                    end += 1;
                }
            } else {
                end = match tw_em_dash_at(t, i) {
                    Some(e) => e,
                    None => tw_word_end(t, i),
                };
            }
            chunks.push(t[i..end].to_vec());
            i = end;
        }
        chunks
    }

    // _fix_sentence_endings
    fn fix_endings(ref self, chunks: mut ref Vec[Vec[char]]) {
        let mut i = 0;
        while i + 1 < chunks.len() {
            if chunks[i + 1] == vec![' '] and tw_sentence_end(chunks[i]) {
                chunks[i + 1] = vec![' ', ' '];
                i += 2;
            } else {
                i += 1;
            }
        }
    }

    // _handle_long_word
    fn handle_long_word(ref self, rev: mut ref Vec[Vec[char]], cur_line: mut ref Vec[Vec[char]], cur_len: i64, width: i64) {
        let space_left = if width < 1 { 1 } else { width - cur_len };
        if self.break_long_words and space_left > 0 {
            let mut end = space_left;
            let last = rev.len() - 1;
            let chunk = rev[last].clone();
            if self.break_on_hyphens and chunk.len() > space_left {
                // chunk.rfind('-', 0, space_left)
                let mut hyphen = -1;
                let mut k = space_left;
                while k > 0 {
                    k -= 1;
                    if chunk[k] == '-' {
                        hyphen = k;
                        break;
                    }
                }
                if hyphen > 0 and chunk[0..hyphen].iter().any(|c| *c != '-') {
                    end = hyphen + 1;
                }
            }
            if end > chunk.len() {
                end = chunk.len();
            }
            cur_line.push(chunk[0..end].to_vec());
            rev[last] = chunk[end..].to_vec();
        } else if cur_line.is_empty() {
            cur_line.push(rev.pop().unwrap());
        }
    }

    // _wrap_chunks
    fn wrap_chunks(ref self, chunks: own Vec[Vec[char]]) -> Result[Vec[Vec[char]], String] {
        let mut lines: Vec[Vec[char]] = Vec.new();
        if self.width <= 0 {
            return Err(f"invalid width {self.width} (must be > 0)");
        }
        if let Some(ml) = self.max_lines {
            let indent = if ml > 1 { self.subsequent_indent.clone() } else { self.initial_indent.clone() };
            if indent.len() + tw_lstrip(self.placeholder).len() > self.width {
                return Err("placeholder too large for max width".to_string());
            }
        }
        let mut rev = chunks;
        rev.reverse();
        while not rev.is_empty() {
            let mut cur_line: Vec[Vec[char]] = Vec.new();
            let mut cur_len = 0;
            let indent = if lines.is_empty() { self.initial_indent.clone() } else { self.subsequent_indent.clone() };
            let width = self.width - indent.len();
            if self.drop_whitespace and tw_is_blank(rev[rev.len() - 1]) and not lines.is_empty() {
                rev.pop();
            }
            while not rev.is_empty() {
                let l = rev[rev.len() - 1].len();
                if cur_len + l <= width {
                    cur_line.push(rev.pop().unwrap());
                    cur_len += l;
                } else {
                    break;
                }
            }
            if not rev.is_empty() and rev[rev.len() - 1].len() > width {
                self.handle_long_word(mut rev, mut cur_line, cur_len, width);
                cur_len = tw_total_len(cur_line);
            }
            if self.drop_whitespace and not cur_line.is_empty() and tw_is_blank(cur_line[cur_line.len() - 1]) {
                cur_len -= cur_line[cur_line.len() - 1].len();
                cur_line.pop();
            }
            if cur_line.is_empty() {
                continue;
            }
            let fits = match self.max_lines {
                None => true,
                Some(ml) => {
                    lines.len() + 1 < ml
                        or ((rev.is_empty() or (self.drop_whitespace and rev.len() == 1 and tw_is_blank(rev[0]))) and cur_len <= width)
                }
            };
            if fits {
                let mut line = indent.clone();
                for c in tw_concat(cur_line).iter() {
                    line.push(*c);
                }
                lines.push(line);
                continue;
            }
            // Truncate with the placeholder, and stop.
            let mut placed = false;
            while not cur_line.is_empty() {
                if not tw_is_blank(cur_line[cur_line.len() - 1]) and cur_len + self.placeholder.len() <= width {
                    cur_line.push(self.placeholder.clone());
                    let mut line = indent.clone();
                    for c in tw_concat(cur_line).iter() {
                        line.push(*c);
                    }
                    lines.push(line);
                    placed = true;
                    break;
                }
                cur_len -= cur_line[cur_line.len() - 1].len();
                cur_line.pop();
            }
            if not placed {
                let mut done = false;
                if not lines.is_empty() {
                    let last = lines.len() - 1;
                    let prev_line = tw_rstrip(lines[last]);
                    if prev_line.len() + self.placeholder.len() <= self.width {
                        let mut line = prev_line;
                        for c in self.placeholder.iter() {
                            line.push(*c);
                        }
                        lines[last] = line;
                        done = true;
                    }
                }
                if not done {
                    let mut line = indent.clone();
                    for c in tw_lstrip(self.placeholder).iter() {
                        line.push(*c);
                    }
                    lines.push(line);
                }
            }
            break;
        }
        Ok(lines)
    }

    fn wrap(ref self, t: ref Vec[char]) -> Result[Vec[Vec[char]], String] {
        let mut chunks = self.split(self.munge(t));
        if self.fix_sentence_endings {
            self.fix_endings(mut chunks);
        }
        self.wrap_chunks(chunks)
    }

    fn fill(ref self, t: ref Vec[char]) -> Result[Vec[char], String] {
        match self.wrap(t) {
            Ok(lines) => Ok(tw_join_on(lines, '\n')),
            Err(e) => Err(e),
        }
    }
}

// The em-dash alternative of wordsep_re, (?<=word_punct) -{2,} (?=\w),
// tried at i: the end of the dash run.
fn tw_em_dash_at(t: ref Vec[char], i: i64) -> Option[i64] {
    if i == 0 or not tw_is_word_punct(t[i - 1]) {
        return None;
    }
    let mut k = i;
    while k < t.len() and t[k] == '-' {
        k += 1;
    }
    if k - i >= 2 and k < t.len() and tw_is_word(t[k]) {
        Some(k)
    } else {
        None
    }
}

// (?=-{2,}\w) at j.
fn tw_dashes_then_word(t: ref Vec[char], j: i64) -> bool {
    let mut k = j;
    while k < t.len() and t[k] == '-' {
        k += 1;
    }
    k - j >= 2 and k < t.len() and tw_is_word(t[k])
}

// The word alternative of wordsep_re, tried at i (a non-space): the lazy
// \S+? grows one character at a time until one of its three endings
// matches.
fn tw_word_end(t: ref Vec[char], i: i64) -> i64 {
    let n = t.len();
    let mut j = i + 1;
    loop {
        // A hyphen inside a compound word: -(?:(?<=lt{2}-)|(?<=lt-lt-))(?=lt-?lt)
        if j < n and t[j] == '-' {
            let behind = (j >= 2 and tw_is_letter(t[j - 2]) and tw_is_letter(t[j - 1]))
                or (j >= 3 and tw_is_letter(t[j - 3]) and t[j - 2] == '-' and tw_is_letter(t[j - 1]));
            let ahead = j + 1 < n and tw_is_letter(t[j + 1])
                and ((j + 2 < n and tw_is_letter(t[j + 2])) or (j + 3 < n and t[j + 2] == '-' and tw_is_letter(t[j + 3])));
            if behind and ahead {
                return j + 1;
            }
        }
        // The end of the word: (?=ws|\Z)
        if j == n or tw_is_ws(t[j]) {
            return j;
        }
        // An em-dash follows: (?<=word_punct)(?=-{2,}\w)
        if tw_is_word_punct(t[j - 1]) and tw_dashes_then_word(t, j) {
            return j;
        }
        j += 1;
    }
}

// sentence_end_re, [a-z][\.\!\?][\"\']?\Z, searched in a chunk.
fn tw_sentence_end(c: ref Vec[char]) -> bool {
    let mut n = c.len();
    if n > 0 and (c[n - 1] == '"' or c[n - 1] == '\'') {
        n -= 1;
    }
    n >= 2 and c[n - 2] >= 'a' and c[n - 2] <= 'z' and (c[n - 1] == '.' or c[n - 1] == '!' or c[n - 1] == '?')
}

// ------------------------------------------------------------ the module functions

// textwrap.shorten

// ------------------------------------------------------------ bytes and text

fn cv_byte_str(b: ref Vec[u8], from: i64, to: i64) -> String {
    let mut v: Vec[u8] = Vec.new();
    for i in from..to {
        v.push(b[i]);
    }
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn cv_to_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn cv_from_bytes(v: Vec[u8]) -> String {
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn cv_is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn cv_is_alpha(c: u8) -> bool {
    (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z')
}

fn cv_is_alnum(c: u8) -> bool {
    cv_is_digit(c) or cv_is_alpha(c)
}

// A word character, as `\w` and `\b` see it.
fn cv_is_word(c: u8) -> bool {
    cv_is_alnum(c) or c == b'_' or c >= 128
}

// White space, as `\s` and str.strip see it.
fn cv_is_ws(c: u8) -> bool {
    c == b' ' or c == b'\t' or c == b'\n' or c == b'\r' or c == 11 or c == 12
}

fn cv_lower_byte(c: u8) -> u8 {
    if c >= b'A' and c <= b'Z' { c + 32 } else { c }
}

fn cv_lower(s: Str) -> String {
    let b = cv_to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        out.push(cv_lower_byte(b[i]));
    }
    cv_from_bytes(out)
}

fn cv_strip(s: Str) -> String {
    let b = cv_to_bytes(s);
    let mut i: i64 = 0;
    let mut j = b.len();
    while i < j and cv_is_ws(b[i]) {
        i += 1;
    }
    while j > i and cv_is_ws(b[j - 1]) {
        j -= 1;
    }
    cv_byte_str(b, i, j)
}

fn cv_split_ws(s: Str) -> Vec[String] {
    let b = cv_to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        while i < b.len() and cv_is_ws(b[i]) {
            i += 1;
        }
        let st = i;
        while i < b.len() and not cv_is_ws(b[i]) {
            i += 1;
        }
        if i > st {
            out.push(cv_byte_str(b, st, i));
        }
    }
    out
}

fn cv_split_on(s: Str, sep: u8) -> Vec[String] {
    let b = cv_to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut st: i64 = 0;
    for i in 0..b.len() {
        if b[i] == sep {
            out.push(cv_byte_str(b, st, i));
            st = i + 1;
        }
    }
    out.push(cv_byte_str(b, st, b.len()));
    out
}

fn cv_join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

// The lines of a file, without their newlines.
fn cv_lines_of(text: Str) -> Vec[String] {
    let mut v = cv_split_on(text, b'\n');
    if v.len() > 0 and v[v.len() - 1].len() == 0 {
        v.pop();
    }
    v
}

fn cv_contains_str(v: ref Vec[String], s: Str) -> bool {
    for i in 0..v.len() {
        if v[i] == s {
            return true;
        }
    }
    false
}

// A stable sort of strings.
fn cv_sort_strings(v: own Vec[String]) -> Vec[String] {
    let mut v = v;
    for i in 1..v.len() {
        let mut j = i;
        while j > 0 and v[j - 1] > v[j] {
            v.swap(j - 1, j);
            j -= 1;
        }
    }
    v
}

// Python's repr of a str.
fn cv_py_repr(s: Str) -> String {
    let b = cv_to_bytes(s);
    let mut has_single = false;
    let mut has_double = false;
    for i in 0..b.len() {
        if b[i] == b'\'' {
            has_single = true;
        }
        if b[i] == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let hex = cv_to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    out.push(q);
    for i in 0..b.len() {
        let c = b[i];
        if c == q or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c < 32 or c == 127 {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    cv_from_bytes(out)
}


// ------------------------------------------------------------ dialects

// A character that is not set, as a dialect's quotechar or escapechar can be.
const CV_UNSET: i64 = -2;
// The end of a line, as the reader's state machine sees it.
const CV_EOL: i64 = -1;

const CV_QUOTE_MINIMAL: i64 = 0;
const CV_QUOTE_ALL: i64 = 1;
const CV_QUOTE_NONNUMERIC: i64 = 2;
const CV_QUOTE_NONE: i64 = 3;
const CV_QUOTE_STRINGS: i64 = 4;
const CV_QUOTE_NOTNULL: i64 = 5;

#[derive(Clone)]
struct Dialect {
    delimiter: i64,
    quotechar: i64,
    escapechar: i64,
    doublequote: bool,
    skipinitialspace: bool,
    lineterminator: String,
    quoting: i64,
    strict: bool,
}

fn cv_excel() -> Dialect {
    Dialect {
        delimiter: b',' as i64,
        quotechar: b'"' as i64,
        escapechar: CV_UNSET,
        doublequote: true,
        skipinitialspace: false,
        lineterminator: "\r\n".to_string(),
        quoting: CV_QUOTE_MINIMAL,
        strict: false,
    }
}

impl Dialect {
    // The checks _csv makes when a reader or writer is made.
    fn check(ref self) -> Result[(), String] {
        if self.delimiter == b'\r' as i64 or self.delimiter == b'\n' as i64 {
            return Err("bad delimiter value".to_string());
        }
        if self.delimiter == self.escapechar {
            return Err("bad delimiter or escapechar value".to_string());
        }
        if self.delimiter == self.quotechar {
            return Err("bad delimiter or quotechar value".to_string());
        }
        if self.escapechar != CV_UNSET and self.escapechar == self.quotechar {
            return Err("bad escapechar or quotechar value".to_string());
        }
        let lt = cv_to_bytes(self.lineterminator);
        for k in 0..lt.len() {
            if lt[k] as i64 == self.delimiter {
                return Err("bad delimiter or lineterminator value".to_string());
            }
        }
        Ok(())
    }
}

// The character a name in a job stands for.
fn cv_char_named(name: Str) -> Result[i64, String] {
    let names = ["comma", "tab", "semicolon", "pipe", "space", "colon", "dquote", "squote", "backslash"];
    let chars = ",\t;| :\"'\\";
    let cb = cv_to_bytes(chars);
    for i in 0..names.len() {
        if names[i] == name {
            return Ok(cb[i] as i64);
        }
    }
    if name == "none" {
        return Ok(CV_UNSET);
    }
    Err(f"unknown character {name}")
}

fn cv_quoting_named(name: Str) -> Result[i64, String] {
    let names = ["minimal", "all", "nonnumeric", "none", "strings", "notnull"];
    for i in 0..names.len() {
        if names[i] == name {
            return Ok(i);
        }
    }
    Err(f"unknown quoting {name}")
}

fn cv_int_of(s: Str) -> i64 {
    let b = cv_to_bytes(s);
    let mut n: i64 = 0;
    let mut k: i64 = 0;
    let neg = b.len() > 0 and b[0] == b'-';
    if neg {
        k = 1;
    }
    while k < b.len() {
        n = n * 10 + (b[k] - b'0') as i64;
        k += 1;
    }
    if neg { -n } else { n }
}

// ------------------------------------------------------------ the reader

// A field as the reader returns it: a string, a float (the numeric quoting
// modes) or None (CV_QUOTE_NOTNULL and CV_QUOTE_STRINGS).
#[derive(Clone)]
enum Value {
    S(String),
    F(f64),
    Null,
}

fn cv_value_repr(v: ref Value) -> String {
    match ref v {
        Value.S(s) => cv_py_repr(s),
        Value.F(x) => f"{x}",
        Value.Null => "None".to_string(),
    }
}

fn cv_row_repr(row: ref Vec[Value]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for i in 0..row.len() {
        parts.push(cv_value_repr(row[i]));
    }
    f"[{cv_join(parts, ", ")}]"
}

// The lines of a text as a file read with newline='' gives them, each with
// its own line end; with `lf_only`, as a StringIO reading "\n" ends only.
fn cv_split_lines(text: Str, lf_only: bool) -> Vec[String] {
    let b = cv_to_bytes(text);
    let mut out: Vec[String] = Vec.new();
    let mut st: i64 = 0;
    let mut i: i64 = 0;
    while i < b.len() {
        if b[i] == b'\n' {
            out.push(cv_byte_str(b, st, i + 1));
            i += 1;
            st = i;
        } else if b[i] == b'\r' and not lf_only {
            let end = if i + 1 < b.len() and b[i + 1] == b'\n' { i + 2 } else { i + 1 };
            out.push(cv_byte_str(b, st, end));
            i = end;
            st = i;
        } else {
            i += 1;
        }
    }
    if st < b.len() {
        out.push(cv_byte_str(b, st, b.len()));
    }
    out
}

const CV_START_RECORD: i64 = 0;
const CV_START_FIELD: i64 = 1;
const CV_ESCAPED_CHAR: i64 = 2;
const CV_IN_FIELD: i64 = 3;
const CV_IN_QUOTED_FIELD: i64 = 4;
const CV_ESCAPE_IN_QUOTED_FIELD: i64 = 5;
const CV_QUOTE_IN_QUOTED_FIELD: i64 = 6;
const CV_EAT_CRNL: i64 = 7;
const CV_AFTER_ESCAPED_CRNL: i64 = 8;

struct Reader {
    d: Dialect,
    lines: Vec[String],
    next_line: i64,
    line_num: i64,
    limit: i64,
    state: i64,
    fields: Vec[Value],
    field: Vec[u8],
    field_len: i64,
    unquoted: bool,
}

fn cv_new_reader(text: Str, d: ref Dialect, lf_only: bool, limit: i64) -> Result[Reader, String] {
    d.check()?;
    Ok(Reader {
        d: d.clone(),
        lines: cv_split_lines(text, lf_only),
        next_line: 0,
        line_num: 0,
        limit: limit,
        state: CV_START_RECORD,
        fields: Vec.new(),
        field: Vec.new(),
        field_len: 0,
        unquoted: true,
    })
}

// Python's float() of a field.
fn cv_to_float(s: Str) -> Result[f64, String] {
    match f64.parse(cv_strip(s)).ok() {
        Some(x) => Ok(x),
        None => Err(f"could not convert string to float: {cv_py_repr(s)}"),
    }
}

impl Reader {
    fn save_field(mut ref self) -> Result[(), String] {
        let q = self.d.quoting;
        let text = cv_from_bytes(self.field.clone());
        let v = if self.unquoted and self.field_len == 0 and (q == CV_QUOTE_NOTNULL or q == CV_QUOTE_STRINGS) {
            Value.Null
        } else if self.unquoted and self.field_len != 0 and (q == CV_QUOTE_NONNUMERIC or q == CV_QUOTE_STRINGS) {
            Value.F(cv_to_float(text)?)
        } else {
            Value.S(text)
        };
        self.fields.push(v);
        self.field.clear();
        self.field_len = 0;
        self.unquoted = true;
        Ok(())
    }

    fn add_char(mut ref self, c: i64) -> Result[(), String] {
        // the limit counts characters; a UTF-8 continuation byte is part of one
        let starts = c < 128 or c >= 192;
        if starts {
            if self.field_len >= self.limit {
                return Err(f"field larger than field limit ({self.limit})");
            }
            self.field_len += 1;
        }
        self.field.push(c as u8);
        Ok(())
    }

    fn end_line(mut ref self, c: i64) -> Result[(), String] {
        self.save_field()?;
        self.state = if c == CV_EOL { CV_START_RECORD } else { CV_EAT_CRNL };
        Ok(())
    }

    fn process(mut ref self, c0: i64) -> Result[(), String] {
        let mut c = c0;
        let d = self.d.clone();
        let nl = c == b'\n' as i64 or c == b'\r' as i64;
        let quote = c == d.quotechar and d.quoting != CV_QUOTE_NONE;
        if self.state == CV_START_RECORD {
            if c == CV_EOL {
                return Ok(());
            }
            if nl {
                self.state = CV_EAT_CRNL;
                return Ok(());
            }
            self.state = CV_START_FIELD;
        }
        if self.state == CV_START_FIELD {
            if nl or c == CV_EOL {
                self.end_line(c)?;
            } else if quote {
                self.unquoted = false;
                self.state = CV_IN_QUOTED_FIELD;
            } else if c == d.escapechar {
                self.state = CV_ESCAPED_CHAR;
            } else if c == b' ' as i64 and d.skipinitialspace {
                // spaces at the start of a field are dropped
            } else if c == d.delimiter {
                self.save_field()?;
            } else {
                self.add_char(c)?;
                self.state = CV_IN_FIELD;
            }
            return Ok(());
        }
        if self.state == CV_ESCAPED_CHAR {
            if nl {
                self.add_char(c)?;
                self.state = CV_AFTER_ESCAPED_CRNL;
                return Ok(());
            }
            if c == CV_EOL {
                c = b'\n' as i64;
            }
            self.add_char(c)?;
            self.state = CV_IN_FIELD;
            return Ok(());
        }
        if self.state == CV_AFTER_ESCAPED_CRNL {
            if c == CV_EOL {
                return Ok(());
            }
            self.state = CV_IN_FIELD;
        }
        if self.state == CV_IN_FIELD {
            if nl or c == CV_EOL {
                self.end_line(c)?;
            } else if c == d.escapechar {
                self.state = CV_ESCAPED_CHAR;
            } else if c == d.delimiter {
                self.save_field()?;
                self.state = CV_START_FIELD;
            } else {
                self.add_char(c)?;
            }
            return Ok(());
        }
        if self.state == CV_IN_QUOTED_FIELD {
            if c == CV_EOL {
                // the line end is in the field already
                return Ok(());
            }
            if c == d.escapechar {
                self.state = CV_ESCAPE_IN_QUOTED_FIELD;
            } else if quote {
                self.state = if d.doublequote { CV_QUOTE_IN_QUOTED_FIELD } else { CV_IN_FIELD };
            } else {
                self.add_char(c)?;
            }
            return Ok(());
        }
        if self.state == CV_ESCAPE_IN_QUOTED_FIELD {
            if c == CV_EOL {
                c = b'\n' as i64;
            }
            self.add_char(c)?;
            self.state = CV_IN_QUOTED_FIELD;
            return Ok(());
        }
        if self.state == CV_QUOTE_IN_QUOTED_FIELD {
            if quote {
                self.add_char(c)?;
                self.state = CV_IN_QUOTED_FIELD;
            } else if c == d.delimiter {
                self.save_field()?;
                self.state = CV_START_FIELD;
            } else if nl or c == CV_EOL {
                self.end_line(c)?;
            } else if not d.strict {
                self.add_char(c)?;
                self.state = CV_IN_FIELD;
            } else {
                let dl = cv_from_bytes([d.delimiter as u8]);
                let ql = cv_from_bytes([d.quotechar as u8]);
                return Err(f"'{dl}' expected after '{ql}'");
            }
            return Ok(());
        }
        // CV_EAT_CRNL
        if nl {
            return Ok(());
        }
        if c == CV_EOL {
            self.state = CV_START_RECORD;
            return Ok(());
        }
        Err("new-line character seen in unquoted field - do you need to open the file with newline=''?".to_string())
    }

    // The next record; None at the end of the input.
    fn next(mut ref self) -> Result[Option[Vec[Value]], String] {
        self.fields = Vec.new();
        self.field.clear();
        self.field_len = 0;
        self.unquoted = true;
        self.state = CV_START_RECORD;
        loop {
            if self.next_line >= self.lines.len() {
                if self.field_len != 0 or self.state == CV_IN_QUOTED_FIELD {
                    if self.d.strict {
                        return Err("unexpected end of data".to_string());
                    }
                    self.save_field()?;
                    break;
                }
                return Ok(None);
            }
            let line = cv_to_bytes(self.lines[self.next_line]);
            self.next_line += 1;
            self.line_num += 1;
            for k in 0..line.len() {
                self.process(line[k] as i64)?;
            }
            self.process(CV_EOL)?;
            if self.state == CV_START_RECORD {
                break;
            }
        }
        let row = self.fields.clone();
        self.fields = Vec.new();
        Ok(Some(row))
    }

    // The records as strings, for the reader of a sniffed dialect.
    fn next_strings(mut ref self) -> Result[Option[Vec[String]], String] {
        match self.next()? {
            Some(row) => {
                let mut out: Vec[String] = Vec.new();
                for i in 0..row.len() {
                    match ref row[i] {
                        Value.S(s) => out.push(s.clone()),
                        Value.F(x) => out.push(f"{x}"),
                        Value.Null => out.push(String.new()),
                    }
                }
                Ok(Some(out))
            }
            None => Ok(None),
        }
    }
}

// ------------------------------------------------------------ the writer

// A value handed to the writer: a string, a number (written as Python's
// str() writes it) or None.
#[derive(Clone)]
enum Cell {
    Text(String),
    Num(String),
    Null,
}

fn cv_t(s: Str) -> Cell {
    Cell.Text(s.to_string())
}

fn cv_n(s: Str) -> Cell {
    Cell.Num(s.to_string())
}

struct Writer {
    d: Dialect,
    rec: Vec[u8],
    num_fields: i64,
}

fn cv_new_writer(d: ref Dialect) -> Result[Writer, String] {
    d.check()?;
    Ok(Writer { d: d.clone(), rec: Vec.new(), num_fields: 0 })
}

impl Writer {
    // One field, with its delimiter, quotes and escapes; `null` is None.
    fn append(mut ref self, text: Str, null: bool, quoted0: bool) -> Result[(), String] {
        let d = self.d.clone();
        let b = cv_to_bytes(text);
        let lt = cv_to_bytes(d.lineterminator);
        let mut quoted = quoted0;
        if not quoted and b.len() == 0 and d.delimiter == b' ' as i64 and d.skipinitialspace {
            if d.quoting == CV_QUOTE_NONE or (null and (d.quoting == CV_QUOTE_STRINGS or d.quoting == CV_QUOTE_NOTNULL)) {
                return Err("empty field must be quoted if delimiter is a space and skipinitialspace is true".to_string());
            }
            quoted = true;
        }
        let mut body: Vec[u8] = Vec.new();
        for i in 0..b.len() {
            let c = b[i] as i64;
            let mut special = c == d.delimiter or c == d.escapechar or c == d.quotechar or c == b'\n' as i64 or c == b'\r' as i64;
            for k in 0..lt.len() {
                if lt[k] as i64 == c {
                    special = true;
                }
            }
            if special {
                let mut want_escape = false;
                if d.quoting == CV_QUOTE_NONE {
                    want_escape = true;
                } else {
                    if c == d.quotechar {
                        if d.doublequote {
                            body.push(d.quotechar as u8);
                        } else {
                            want_escape = true;
                        }
                    } else if c == d.escapechar {
                        want_escape = true;
                    }
                    if not want_escape {
                        quoted = true;
                    }
                }
                if want_escape {
                    if d.escapechar == CV_UNSET {
                        return Err("need to escape, but no escapechar set".to_string());
                    }
                    body.push(d.escapechar as u8);
                }
            }
            body.push(b[i]);
        }
        if self.num_fields > 0 {
            self.rec.push(d.delimiter as u8);
        }
        if quoted {
            self.rec.push(d.quotechar as u8);
        }
        for i in 0..body.len() {
            self.rec.push(body[i]);
        }
        if quoted {
            self.rec.push(d.quotechar as u8);
        }
        self.num_fields += 1;
        Ok(())
    }

    // writerow: the record and its line terminator.
    fn row(mut ref self, cells: ref Vec[Cell]) -> Result[String, String] {
        self.rec.clear();
        self.num_fields = 0;
        let q = self.d.quoting;
        let mut last_null = false;
        for i in 0..cells.len() {
            let (text, is_num, null) = match ref cells[i] {
                Cell.Text(s) => (s.clone(), false, false),
                Cell.Num(s) => (s.clone(), true, false),
                Cell.Null => (String.new(), false, true),
            };
            let quoted = if q == CV_QUOTE_NONNUMERIC {
                not is_num
            } else if q == CV_QUOTE_ALL {
                true
            } else if q == CV_QUOTE_STRINGS {
                not is_num and not null
            } else if q == CV_QUOTE_NOTNULL {
                not null
            } else {
                false
            };
            last_null = null;
            self.append(text, null, quoted)?;
        }
        if self.num_fields > 0 and self.rec.len() == 0 {
            if q == CV_QUOTE_NONE or (last_null and (q == CV_QUOTE_STRINGS or q == CV_QUOTE_NOTNULL)) {
                return Err("single empty field record must be quoted".to_string());
            }
            self.num_fields -= 1;
            self.append("", true, true)?;
        }
        let mut out = cv_from_bytes(self.rec.clone());
        out.push_str(self.d.lineterminator);
        Ok(out)
    }
}

// ------------------------------------------------------------ DictReader

// A DictReader value: a field, the list under restkey, or restval's None.
#[derive(Clone)]
enum DVal {
    S(String),
    L(Vec[String]),
    Null,
}

// A dict as DictReader builds it: keys in insertion order, None allowed.
#[derive(Clone)]
struct Dict {
    keys: Vec[Option[String]],
    vals: Vec[DVal],
}

impl Dict {
    fn set(mut ref self, k: own Option[String], v: own DVal) {
        for i in 0..self.keys.len() {
            if self.keys[i] == k {
                self.vals[i] = v;
                return;
            }
        }
        self.keys.push(k);
        self.vals.push(v);
    }

    fn get(ref self, k: Str) -> String {
        for i in 0..self.keys.len() {
            if let Some(key) = ref self.keys[i] {
                if key == k {
                    if let DVal.S(s) = ref self.vals[i] {
                        return s.clone();
                    }
                }
            }
        }
        String.new()
    }

    fn repr(ref self) -> String {
        let mut parts: Vec[String] = Vec.new();
        for i in 0..self.keys.len() {
            let k = match ref self.keys[i] {
                Some(s) => cv_py_repr(s),
                None => "None".to_string(),
            };
            let v = match ref self.vals[i] {
                DVal.S(s) => cv_py_repr(s),
                DVal.L(l) => {
                    let mut items: Vec[String] = Vec.new();
                    for j in 0..l.len() {
                        items.push(cv_py_repr(l[j]));
                    }
                    f"[{cv_join(items, ", ")}]"
                }
                DVal.Null => "None".to_string(),
            };
            parts.push(f"{k}: {v}");
        }
        f"{{{cv_join(parts, ", ")}}}"
    }
}

struct DictReader {
    r: Reader,
    fieldnames: Vec[String],
    have_names: bool,
    restkey: Option[String],
    restval: Option[String],
    line_num: i64,
}

fn cv_dict_reader(r: own Reader, fieldnames: own Option[Vec[String]], restkey: own Option[String], restval: own Option[String]) -> DictReader {
    let have = fieldnames.is_some();
    DictReader { r: r, fieldnames: fieldnames.unwrap_or(Vec.new()), have_names: have, restkey: restkey, restval: restval, line_num: 0 }
}

impl DictReader {
    fn names(mut ref self) -> Result[Vec[String], String] {
        if not self.have_names {
            if let Some(row) = self.r.next_strings()? {
                self.fieldnames = row;
            }
            self.have_names = true;
        }
        self.line_num = self.r.line_num;
        Ok(self.fieldnames.clone())
    }

    fn next(mut ref self) -> Result[Option[Dict], String] {
        if self.line_num == 0 {
            self.names()?;
        }
        let mut row = match self.r.next_strings()? {
            Some(r) => r,
            None => return Ok(None),
        };
        while row.len() == 0 {
            row = match self.r.next_strings()? {
                Some(r) => r,
                None => return Ok(None),
            };
        }
        self.line_num = self.r.line_num;
        let names = self.fieldnames.clone();
        let mut d = Dict { keys: Vec.new(), vals: Vec.new() };
        let lf = names.len();
        let lr = row.len();
        let m = if lf < lr { lf } else { lr };
        for i in 0..m {
            d.set(Some(names[i].clone()), DVal.S(row[i].clone()));
        }
        if lf < lr {
            let mut rest: Vec[String] = Vec.new();
            for i in lf..lr {
                rest.push(row[i].clone());
            }
            d.set(self.restkey.clone(), DVal.L(rest));
        } else if lf > lr {
            for i in lr..lf {
                let v = match ref self.restval {
                    Some(s) => DVal.S(s.clone()),
                    None => DVal.Null,
                };
                d.set(Some(names[i].clone()), v);
            }
        }
        Ok(Some(d))
    }
}

// ------------------------------------------------------------ DictWriter

// A row for DictWriter: the keys and values of a Python dict.
struct WDict {
    keys: Vec[String],
    vals: Vec[Cell],
}

// DictWriter.writerow: the values in fieldnames order, restval for a
// missing key, and an error for an extra key unless extras are ignored.
fn cv_dict_row(w: mut ref Writer, names: ref Vec[String], d: ref WDict, restval: Str, ignore: bool) -> Result[String, String] {
    if not ignore {
        let mut wrong: Vec[String] = Vec.new();
        for i in 0..d.keys.len() {
            if not cv_contains_str(names, d.keys[i]) {
                wrong.push(cv_py_repr(d.keys[i]));
            }
        }
        if wrong.len() > 0 {
            return Err(f"dict contains fields not in fieldnames: {cv_join(wrong, ", ")}");
        }
    }
    let mut cells: Vec[Cell] = Vec.new();
    for i in 0..names.len() {
        let mut c = cv_t(restval);
        for k in 0..d.keys.len() {
            if d.keys[k] == names[i] {
                c = d.vals[k].clone();
            }
        }
        cells.push(c);
    }
    w.row(cells)
}

fn cv_header_row(w: mut ref Writer, names: ref Vec[String]) -> Result[String, String] {
    let mut cells: Vec[Cell] = Vec.new();
    for i in 0..names.len() {
        cells.push(cv_t(names[i]));
    }
    w.row(cells)
}

// ------------------------------------------------------------ the Sniffer

// Sniffer._guess_quote_and_delimiter's regular expressions, matched by
// hand. Each quoted body is `(?:QQ|(?!Q).)*+`: doubled quotes or other
// characters, possessively, so it ends at the first single quote.
fn cv_is_delim_class(c: u8) -> bool {
    not (cv_is_word(c) or c == b'\n' or c == b'"' or c == b'\'')
}

fn cv_quoted_body_end(d: ref Vec[u8], from: i64, q: u8) -> i64 {
    let mut p = from;
    loop {
        if p + 1 < d.len() and d[p] == q and d[p + 1] == q {
            p += 2;
        } else if p < d.len() and d[p] != q {
            p += 1;
        } else {
            return p;
        }
    }
}

// A match: its quote, its delimiter (0 for none), whether a space followed
// the delimiter, and where it ends.
struct QMatch {
    quote: u8,
    delim: u8,
    space: bool,
    end: i64,
}

// `(?P<delim>D)(?P<space> ?)(?P<quote>Q)BODY(?P=quote)` then, for form 1,
// `(?P=delim)`, and for form 3, `(?:$|\n)`.
fn cv_match_delim_first(d: ref Vec[u8], s: i64, form: i64) -> Option[QMatch] {
    if s >= d.len() or not cv_is_delim_class(d[s]) {
        return None;
    }
    let delim = d[s];
    let mut p = s + 1;
    let space = p < d.len() and d[p] == b' ';
    if space {
        p += 1;
    }
    if p >= d.len() or not (d[p] == b'"' or d[p] == b'\'') {
        return None;
    }
    let q = d[p];
    p = cv_quoted_body_end(d, p + 1, q);
    if p >= d.len() or d[p] != q {
        return None;
    }
    p += 1;
    if form == 1 {
        if p >= d.len() or d[p] != delim {
            return None;
        }
        p += 1;
    } else if p < d.len() and d[p] != b'\n' {
        return None;
    }
    Some(QMatch { quote: q, delim: delim, space: space, end: p })
}

// `(?:^|\n)(?P<quote>Q)BODY(?P=quote)` then, for form 2,
// `(?P<delim>D)(?P<space> ?)`, and for form 4, `(?:$|\n)`.
fn cv_match_line_first(d: ref Vec[u8], s: i64, form: i64) -> Option[QMatch] {
    let mut starts: Vec[i64] = Vec.new();
    if s == 0 or d[s - 1] == b'\n' {
        starts.push(s);
    }
    if s < d.len() and d[s] == b'\n' {
        starts.push(s + 1);
    }
    for k in 0..starts.len() {
        let mut p = starts[k];
        if p >= d.len() or not (d[p] == b'"' or d[p] == b'\'') {
            continue;
        }
        let q = d[p];
        p = cv_quoted_body_end(d, p + 1, q);
        if p >= d.len() or d[p] != q {
            continue;
        }
        p += 1;
        if form == 2 {
            if p >= d.len() or not cv_is_delim_class(d[p]) {
                continue;
            }
            let delim = d[p];
            p += 1;
            let space = p < d.len() and d[p] == b' ';
            if space {
                p += 1;
            }
            return Some(QMatch { quote: q, delim: delim, space: space, end: p });
        }
        if p < d.len() and d[p] != b'\n' {
            continue;
        }
        return Some(QMatch { quote: q, delim: 0, space: false, end: p });
    }
    None
}

fn cv_find_all_form(d: ref Vec[u8], form: i64) -> Vec[QMatch] {
    let mut out: Vec[QMatch] = Vec.new();
    let mut s: i64 = 0;
    while s <= d.len() {
        let m = if form == 1 or form == 3 { cv_match_delim_first(d, s, form) } else { cv_match_line_first(d, s, form) };
        match m {
            Some(m) => {
                s = m.end;
                out.push(m);
            }
            None => s += 1,
        }
    }
    out
}

// A count per character, in the order the characters were first counted,
// as a Python dict keeps them.
struct Counts {
    keys: Vec[u8],
    counts: Vec[i64],
}

impl Counts {
    fn add(mut ref self, c: u8) {
        for i in 0..self.keys.len() {
            if self.keys[i] == c {
                self.counts[i] += 1;
                return;
            }
        }
        self.keys.push(c);
        self.counts.push(1);
    }

    // max(d, key=d.get): the first key with the largest count.
    fn best(ref self) -> i64 {
        let mut b: i64 = 0;
        for i in 1..self.keys.len() {
            if self.counts[i] > self.counts[b] {
                b = i;
            }
        }
        b
    }
}

struct Guess {
    quotechar: u8,
    doublequote: bool,
    delimiter: u8,
    skipinitialspace: bool,
}

fn cv_guess_quote_and_delimiter(d: ref Vec[u8]) -> Guess {
    let mut matches: Vec[QMatch] = Vec.new();
    let mut form: i64 = 1;
    while form <= 4 {
        matches = cv_find_all_form(d, form);
        if matches.len() > 0 {
            break;
        }
        form += 1;
    }
    if matches.len() == 0 {
        return Guess { quotechar: 0, doublequote: false, delimiter: 0, skipinitialspace: false };
    }
    let mut quotes = Counts { keys: Vec.new(), counts: Vec.new() };
    let mut delims = Counts { keys: Vec.new(), counts: Vec.new() };
    let mut spaces: i64 = 0;
    for i in 0..matches.len() {
        quotes.add(matches[i].quote);
        if form == 4 {
            continue;
        }
        delims.add(matches[i].delim);
        if matches[i].space {
            spaces += 1;
        }
    }
    let quotechar = quotes.keys[quotes.best()];
    let mut delim: u8 = 0;
    let mut skip = false;
    if delims.keys.len() > 0 {
        let b = delims.best();
        delim = delims.keys[b];
        skip = delims.counts[b] == spaces;
        if delim == b'\n' {
            delim = 0;
        }
    }
    // a doubled quote inside a whole quoted field means doublequote
    let mut doublequote = false;
    if delim != 0 {
        let q = quotechar;
        let mut s: i64 = 0;
        while s < d.len() and not doublequote {
            let at_start = (s > 0 and d[s - 1] == delim) or s == 0 or d[s - 1] == b'\n';
            let mut matched_end: i64 = -1;
            if at_start {
                let mut p = s;
                if delim != b' ' {
                    while p < d.len() and d[p] == b' ' {
                        p += 1;
                    }
                }
                if p < d.len() and d[p] == q {
                    p += 1;
                    let body = p;
                    loop {
                        if p + 1 < d.len() and d[p] == q and d[p + 1] == q {
                            p += 2;
                        } else if p < d.len() and d[p] != q {
                            p += 1;
                        } else {
                            break;
                        }
                    }
                    let body_end = p;
                    if p < d.len() and d[p] == q {
                        p += 1;
                        let ok = if p < d.len() and d[p] == delim {
                            p += 1;
                            true
                        } else {
                            p == d.len() or d[p] == b'\n'
                        };
                        if ok {
                            matched_end = p;
                            for k in body..body_end - 1 {
                                if d[k] == q and d[k + 1] == q {
                                    doublequote = true;
                                }
                            }
                        }
                    }
                }
            }
            s = if matched_end > s { matched_end } else { s + 1 };
        }
    }
    Guess { quotechar: quotechar, doublequote: doublequote, delimiter: delim, skipinitialspace: skip }
}

fn cv_count_byte(line: ref Vec[u8], c: u8) -> i64 {
    let mut n: i64 = 0;
    for i in 0..line.len() {
        if line[i] == c {
            n += 1;
        }
    }
    n
}

// data[0].count(d) == data[0].count(d + " ")
fn cv_spaces_after(line: ref Vec[u8], c: u8) -> bool {
    let mut pairs: i64 = 0;
    let mut i: i64 = 0;
    while i < line.len() {
        if i + 1 < line.len() and line[i] == c and line[i + 1] == b' ' {
            pairs += 1;
            i += 2;
        } else {
            i += 1;
        }
    }
    cv_count_byte(line, c) == pairs
}

// One character's mode: the frequency, and how many lines show it less
// the lines that show any other frequency.
#[derive(Clone)]
struct Mode {
    c: u8,
    freq: i64,
    count: i64,
}

fn cv_guess_delimiter(text: ref Vec[u8]) -> (u8, bool) {
    let all = cv_split_on(cv_from_bytes(text.clone()), b'\n');
    let mut data: Vec[Vec[u8]] = Vec.new();
    for i in 0..all.len() {
        if all[i].len() > 0 {
            data.push(cv_to_bytes(all[i]));
        }
    }
    let chunk = if data.len() < 10 { data.len() } else { 10 };
    let mut iteration: i64 = 0;
    // per character: the frequencies seen and on how many lines, in order
    let mut freqs: Vec[Vec[i64]] = Vec.new();
    let mut lines: Vec[Vec[i64]] = Vec.new();
    for _ in 0..127 {
        freqs.push(Vec.new());
        lines.push(Vec.new());
    }
    let mut modes: Vec[Mode] = Vec.new();
    let mut delims: Vec[Mode] = Vec.new();
    let mut start: i64 = 0;
    let mut end = chunk;
    while start < data.len() {
        iteration += 1;
        let stop = if end < data.len() { end } else { data.len() };
        for li in start..stop {
            for c in 0..127 {
                let f = cv_count_byte(data[li], c as u8);
                let mut found = false;
                for k in 0..freqs[c].len() {
                    if freqs[c][k] == f {
                        lines[c][k] += 1;
                        found = true;
                    }
                }
                if not found {
                    freqs[c].push(f);
                    lines[c].push(1);
                }
            }
        }
        for c in 0..127 {
            if freqs[c].len() == 0 or (freqs[c].len() == 1 and freqs[c][0] == 0) {
                continue;
            }
            let mut m = Mode { c: c as u8, freq: freqs[c][0], count: lines[c][0] };
            if freqs[c].len() > 1 {
                let mut b: i64 = 0;
                for k in 1..freqs[c].len() {
                    if lines[c][k] > lines[c][b] {
                        b = k;
                    }
                }
                let mut others: i64 = 0;
                for k in 0..freqs[c].len() {
                    if k != b {
                        others += lines[c][k];
                    }
                }
                m = Mode { c: c as u8, freq: freqs[c][b], count: lines[c][b] - others };
            }
            let mut placed = false;
            for k in 0..modes.len() {
                if modes[k].c == c as u8 {
                    modes[k] = m.clone();
                    placed = true;
                }
            }
            if not placed {
                modes.push(m);
            }
        }
        let seen = chunk * iteration;
        let total = (if seen < data.len() { seen } else { data.len() }) as f64;
        let mut consistency: f64 = 1.0;
        let threshold: f64 = 0.9;
        while delims.len() == 0 and consistency >= threshold {
            for k in 0..modes.len() {
                let v = modes[k].clone();
                if v.freq > 0 and v.count > 0 and (v.count as f64) / total >= consistency {
                    delims.push(v);
                }
            }
            consistency -= 0.01;
        }
        if delims.len() == 1 {
            let dl = delims[0].c;
            return (dl, cv_spaces_after(data[0], dl));
        }
        start = end;
        end += chunk;
    }
    if delims.len() == 0 {
        return (0, false);
    }
    let preferred = cv_to_bytes(",\t; :");
    for i in 0..preferred.len() {
        for k in 0..delims.len() {
            if delims[k].c == preferred[i] {
                return (preferred[i], cv_spaces_after(data[0], preferred[i]));
            }
        }
    }
    // the largest (mode, character) pair
    let mut b: i64 = 0;
    for k in 1..delims.len() {
        let x = delims[k].clone();
        let y = delims[b].clone();
        if x.freq > y.freq or (x.freq == y.freq and (x.count > y.count or (x.count == y.count and x.c > y.c))) {
            b = k;
        }
    }
    let dl = delims[b].c;
    (dl, cv_spaces_after(data[0], dl))
}

// Sniffer().sniff(sample)
fn cv_sniff(sample: Str) -> Result[Dialect, String] {
    let raw = cv_to_bytes(sample);
    let mut d: Vec[u8] = Vec.new();
    for i in 0..raw.len() {
        if raw[i] == b'\r' {
            if i + 1 < raw.len() and raw[i + 1] == b'\n' {
                continue;
            }
            d.push(b'\n');
        } else {
            d.push(raw[i]);
        }
    }
    let g = cv_guess_quote_and_delimiter(d);
    let mut delim = g.delimiter;
    let mut skip = g.skipinitialspace;
    if delim == 0 {
        let (dl, sk) = cv_guess_delimiter(d);
        delim = dl;
        skip = sk;
    }
    if delim == 0 {
        return Err("Could not determine delimiter".to_string());
    }
    let mut dialect = cv_excel();
    dialect.doublequote = g.doublequote;
    dialect.delimiter = delim as i64;
    dialect.quotechar = if g.quotechar == 0 { b'"' as i64 } else { g.quotechar as i64 };
    dialect.skipinitialspace = skip;
    Ok(dialect)
}

// The end of a run of digits, with single underscores between them.
fn cv_digits_from(b: ref Vec[u8], at: i64) -> i64 {
    let mut q = at;
    while q < b.len() and cv_is_digit(b[q]) {
        q += 1;
        if q + 1 < b.len() and b[q] == b'_' and cv_is_digit(b[q + 1]) {
            q += 1;
        }
    }
    q
}

fn cv_is_j(c: u8) -> bool {
    c == b'j' or c == b'J'
}

// The number of characters in a string.
fn cv_char_len(s: Str) -> i64 {
    let b = cv_to_bytes(s);
    let mut n: i64 = 0;
    for i in 0..b.len() {
        if b[i] < 128 or b[i] >= 192 {
            n += 1;
        }
    }
    n
}

// Python's float() syntax, from `from`; the end, or -1 if there is none.
fn cv_float_end(b: ref Vec[u8], from: i64, signed: bool) -> i64 {
    let mut p = from;
    if signed and p < b.len() and (b[p] == b'+' or b[p] == b'-') {
        p += 1;
    }
    let words = ["infinity", "inf", "nan"];
    for w in 0..words.len() {
        let wb = cv_to_bytes(words[w]);
        if p + wb.len() <= b.len() {
            let mut same = true;
            for k in 0..wb.len() {
                if cv_lower_byte(b[p + k]) != wb[k] {
                    same = false;
                }
            }
            if same {
                return p + wb.len();
            }
        }
    }
    let int_end = cv_digits_from(b, p);
    let mut q = int_end;
    let mut frac = false;
    if q < b.len() and b[q] == b'.' {
        let f = cv_digits_from(b, q + 1);
        frac = f > q + 1;
        q = f;
    }
    if int_end == p and not frac {
        return -1;
    }
    if q < b.len() and (b[q] == b'e' or b[q] == b'E') {
        let mut e = q + 1;
        if e < b.len() and (b[e] == b'+' or b[e] == b'-') {
            e += 1;
        }
        let ee = cv_digits_from(b, e);
        if ee > e {
            q = ee;
        }
    }
    q
}

// Python's complex() of a string: a real, an imaginary or a sum of both.
fn cv_is_complex(s: Str) -> bool {
    let mut t = cv_strip(s);
    let tb = cv_to_bytes(t);
    if tb.len() >= 2 and tb[0] == b'(' and tb[tb.len() - 1] == b')' {
        t = cv_strip(cv_byte_str(tb, 1, tb.len() - 1));
    }
    let b = cv_to_bytes(t);
    let n = b.len();
    let e1 = cv_float_end(b, 0, true);
    if e1 >= 0 {
        if e1 == n {
            return true;
        }
        if cv_is_j(b[e1]) and e1 + 1 == n {
            return true;
        }
        if b[e1] == b'+' or b[e1] == b'-' {
            let e2 = cv_float_end(b, e1 + 1, false);
            let at = if e2 >= 0 { e2 } else { e1 + 1 };
            return at < n and cv_is_j(b[at]) and at + 1 == n;
        }
        return false;
    }
    let mut p: i64 = 0;
    if p < n and (b[p] == b'+' or b[p] == b'-') {
        p += 1;
    }
    p < n and cv_is_j(b[p]) and p + 1 == n
}

// Sniffer().has_header(sample): a vote, column by column, on whether the
// first row differs in type or length from the rows under it.
fn cv_has_header(sample: Str) -> Result[bool, String] {
    let d = cv_sniff(sample)?;
    let mut r = cv_new_reader(sample, d, true, 131072)?;
    let header = match r.next_strings()? {
        Some(h) => h,
        None => return Err("StopIteration".to_string()),
    };
    let columns = header.len();
    // per column: -1 not yet typed, -2 complex, else a length; and alive
    let mut types: Vec[i64] = Vec.new();
    let mut alive: Vec[bool] = Vec.new();
    for _ in 0..columns {
        types.push(-1);
        alive.push(true);
    }
    let mut checked: i64 = 0;
    loop {
        let row = match r.next_strings()? {
            Some(row) => row,
            None => break,
        };
        if checked > 20 {
            break;
        }
        checked += 1;
        if row.len() != columns {
            continue;
        }
        for col in 0..columns {
            if not alive[col] {
                continue;
            }
            let this = if cv_is_complex(row[col]) { -2 } else { cv_char_len(row[col]) };
            if this != types[col] {
                if types[col] == -1 {
                    types[col] = this;
                } else {
                    alive[col] = false;
                }
            }
        }
    }
    let mut vote: i64 = 0;
    for col in 0..columns {
        if not alive[col] {
            continue;
        }
        if types[col] >= 0 {
            if cv_char_len(header[col]) != types[col] {
                vote += 1;
            } else {
                vote -= 1;
            }
        } else if types[col] == -2 and cv_is_complex(header[col]) {
            vote -= 1;
        } else {
            // not a number, or a column that never got a type (None(...))
            vote += 1;
        }
    }
    Ok(vote > 0)
}

// ------------------------------------------------------------ the files

// data/after_quote.csv

// ------------------------------------------------------------ text

fn aj_chars_of(s: Str) -> Vec[char] {
    s.chars().collect()
}

fn aj_str_of(cs: ref Vec[char]) -> String {
    let mut s = String.new();
    for c in cs.iter() {
        s.push(*c);
    }
    s
}

fn aj_sub_chars(cs: ref Vec[char], from: i64, to: i64) -> Vec[char] {
    let mut v: Vec[char] = Vec.new();
    for i in from..to {
        v.push(cs[i]);
    }
    v
}

fn aj_join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

fn aj_ascii_lower(c: char) -> char {
    if c >= 'A' and c <= 'Z' {
        char.try_from((c as u32) + 32).unwrap_or(c)
    } else {
        c
    }
}

fn aj_hex_char(n: u32) -> char {
    let h: Vec[char] = "0123456789abcdef".chars().collect();
    h[(n & 15) as i64]
}

// n in lowercase hex, padded with zeros to width digits.
fn aj_hex_pad(n: u32, width: i64) -> String {
    let mut ds: Vec[char] = Vec.new();
    let mut m = n;
    while m > 0 {
        ds.push(aj_hex_char(m));
        m = m / 16;
    }
    while ds.len() < width {
        ds.push('0');
    }
    let mut s = String.new();
    let mut i = ds.len() - 1;
    while i >= 0 {
        s.push(ds[i]);
        i -= 1;
    }
    s
}

fn aj_hex_parse(s: Str) -> u64 {
    let mut n: u64 = 0;
    for c in s.chars() {
        let d = if c >= '0' and c <= '9' {
            (c as u32) - ('0' as u32)
        } else {
            (c as u32) - ('a' as u32) + 10
        };
        n = n * 16 + (d as u64);
    }
    n
}

fn aj_dec_parse(s: Str) -> i64 {
    let mut n: i64 = 0;
    for c in s.chars() {
        n = n * 10 + ((c as u32) - ('0' as u32)) as i64;
    }
    n
}

// ------------------------------------------------------------ JSON in

// The jobs file holds strings, numbers, booleans, null, arrays and
// objects. A number keeps its text.
#[derive(Clone)]
enum J {
    S(String),
    N(String),
    F(f64),
    A(Vec[J]),
    O(Vec[(String, J)]),
    B(bool),
    Null,
}

fn aj_json_space(c: char) -> bool {
    c == ' ' or c == '\n' or c == '\r' or c == '\t'
}

fn aj_json_num_char(c: char) -> bool {
    (c >= '0' and c <= '9') or c == '-' or c == '+' or c == '.' or c == 'e' or c == 'E'
}

struct JsonIn {
    cs: Vec[char],
    pos: i64,
}

impl JsonIn {
    fn ws(mut ref self) {
        while self.pos < self.cs.len() and aj_json_space(self.cs[self.pos]) {
            self.pos += 1;
        }
    }

    fn word(mut ref self, w: Str) -> bool {
        let wc: Vec[char] = w.chars().collect();
        if self.pos + wc.len() > self.cs.len() {
            return false;
        }
        let mut k = 0;
        while k < wc.len() {
            if self.cs[self.pos + k] != wc[k] {
                return false;
            }
            k += 1;
        }
        self.pos += wc.len();
        true
    }

    fn hex4(mut ref self) -> u32 {
        let mut n: u32 = 0;
        let mut k = 0;
        while k < 4 {
            let c = aj_ascii_lower(self.cs[self.pos]);
            let d = if c >= '0' and c <= '9' {
                (c as u32) - ('0' as u32)
            } else {
                (c as u32) - ('a' as u32) + 10
            };
            n = n * 16 + d;
            self.pos += 1;
            k += 1;
        }
        n
    }

    fn value(mut ref self) -> Result[J, String] {
        self.ws();
        if self.pos >= self.cs.len() {
            return Err("unexpected end of JSON".to_string());
        }
        let c = self.cs[self.pos];
        if c == '[' {
            self.pos += 1;
            let mut items: Vec[J] = Vec.new();
            self.ws();
            if self.pos < self.cs.len() and self.cs[self.pos] == ']' {
                self.pos += 1;
                return Ok(J.A(items));
            }
            loop {
                items.push(self.value()?);
                self.ws();
                if self.pos >= self.cs.len() {
                    return Err("unterminated JSON array".to_string());
                }
                let d = self.cs[self.pos];
                self.pos += 1;
                if d == ']' {
                    return Ok(J.A(items));
                }
                if d != ',' {
                    return Err(f"bad JSON array separator {d}");
                }
            }
        }
        if c == '{' {
            self.pos += 1;
            let mut members: Vec[(String, J)] = Vec.new();
            self.ws();
            if self.pos < self.cs.len() and self.cs[self.pos] == '}' {
                self.pos += 1;
                return Ok(J.O(members));
            }
            loop {
                let key = match self.value()? {
                    J.S(k) => k,
                    _ => return Err("JSON object key is not a string".to_string()),
                };
                self.ws();
                if self.pos >= self.cs.len() or self.cs[self.pos] != ':' {
                    return Err("missing ':' in JSON object".to_string());
                }
                self.pos += 1;
                let v = self.value()?;
                members.push((key, v));
                self.ws();
                if self.pos >= self.cs.len() {
                    return Err("unterminated JSON object".to_string());
                }
                let d = self.cs[self.pos];
                self.pos += 1;
                if d == '}' {
                    return Ok(J.O(members));
                }
                if d != ',' {
                    return Err(f"bad JSON object separator {d}");
                }
            }
        }
        if self.word("true") {
            return Ok(J.B(true));
        }
        if self.word("false") {
            return Ok(J.B(false));
        }
        if self.word("null") {
            return Ok(J.Null);
        }
        if c == '-' or (c >= '0' and c <= '9') {
            let st = self.pos;
            while self.pos < self.cs.len() and aj_json_num_char(self.cs[self.pos]) {
                self.pos += 1;
            }
            return Ok(J.N(aj_str_of(aj_sub_chars(self.cs, st, self.pos))));
        }
        if c != '"' {
            return Err(f"unexpected JSON character {c}");
        }
        self.pos += 1;
        let mut s = String.new();
        while self.pos < self.cs.len() {
            let d = self.cs[self.pos];
            self.pos += 1;
            if d == '"' {
                return Ok(J.S(s));
            }
            if d != '\\' {
                s.push(d);
                continue;
            }
            let e = self.cs[self.pos];
            self.pos += 1;
            if e == 'n' {
                s.push('\n');
            } else if e == 't' {
                s.push('\t');
            } else if e == 'r' {
                s.push('\r');
            } else if e == 'b' {
                s.push('\u{8}');
            } else if e == 'f' {
                s.push('\u{c}');
            } else if e == 'u' {
                let mut n = self.hex4();
                if n >= 0xD800 and n < 0xDC00 {
                    self.pos += 2;
                    let lo = self.hex4();
                    n = 0x10000 + ((n - 0xD800) << 10) + (lo - 0xDC00);
                }
                s.push(char.try_from(n).unwrap_or('?'));
            } else {
                s.push(e);
            }
        }
        Err("unterminated JSON string".to_string())
    }
}

fn aj_json_line(l: ref String) -> Result[J, String] {
    let mut p = JsonIn { cs: l.chars().collect(), pos: 0 };
    p.value()
}

fn aj_j_get(j: ref J, key: Str) -> J {
    match j {
        J.O(members) => {
            for (k, v) in members.iter() {
                if k == key {
                    return v.clone();
                }
            }
            J.Null
        }
        _ => J.Null,
    }
}

fn aj_j_str(j: ref J, key: Str) -> String {
    match aj_j_get(j, key) {
        J.S(s) => s,
        _ => String.new(),
    }
}

fn aj_j_bool(j: ref J, key: Str) -> bool {
    match aj_j_get(j, key) {
        J.B(b) => b,
        _ => false,
    }
}

fn aj_j_strs(j: ref J, key: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    if let J.A(items) = aj_j_get(j, key) {
        for it in items.iter() {
            if let J.S(s) = it {
                out.push(s.clone());
            }
        }
    }
    out
}

// Whether the object has the member at all.
fn aj_j_present(j: ref J, key: Str) -> bool {
    if let J.O(members) = j {
        for (k, _) in members.iter() {
            if k == key {
                return true;
            }
        }
    }
    false
}



// ---------------------------------------------------------------- chars

fn hp_is_space(c: char) -> bool {
    c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == '\u{c}'
}

fn hp_is_alpha(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')
}

fn hp_is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn hp_is_hex(c: char) -> bool {
    hp_is_digit(c) or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F')
}

fn hp_is_alnum(c: char) -> bool {
    hp_is_alpha(c) or hp_is_digit(c)
}

fn hp_ascii_lower(c: char) -> char {
    if c >= 'A' and c <= 'Z' {
        match char.try_from(c as i64 + 32) {
            Ok(l) => l,
            Err(_) => c,
        }
    } else {
        c
    }
}

fn hp_to_chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn hp_text(raw: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut s = String.new();
    let mut k = lo;
    while k < hi {
        s.push(raw[k]);
        k += 1;
    }
    s
}

// raw[i..] starts with s.
fn hp_at(raw: ref Vec[char], i: i64, s: ref String) -> bool {
    let mut k = i;
    for c in s.chars() {
        if k >= raw.len() or raw[k] != c {
            return false;
        }
        k += 1;
    }
    true
}

// raw[i..] starts with s, ignoring ASCII case.
fn hp_at_nocase(raw: ref Vec[char], i: i64, s: ref String) -> bool {
    let mut k = i;
    for c in s.chars() {
        if k >= raw.len() or hp_ascii_lower(raw[k]) != hp_ascii_lower(c) {
            return false;
        }
        k += 1;
    }
    true
}

fn hp_find_char(raw: ref Vec[char], c: char, from: i64) -> i64 {
    let mut k = from;
    while k < raw.len() {
        if raw[k] == c {
            return k;
        }
        k += 1;
    }
    -1
}

fn hp_find_str(raw: ref Vec[char], s: ref String, from: i64) -> i64 {
    let mut k = from;
    while k < raw.len() {
        if hp_at(raw, k, s) {
            return k;
        }
        k += 1;
    }
    -1
}

// ---------------------------------------------------------------- html.escape / html.unescape

fn hp_escape(s: ref String, quote: bool) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c == '&' {
            out.push_str("&amp;");
        } else if c == '<' {
            out.push_str("&lt;");
        } else if c == '>' {
            out.push_str("&gt;");
        } else if quote and c == '"' {
            out.push_str("&quot;");
        } else if quote and c == '\'' {
            out.push_str("&#x27;");
        } else {
            out.push(c);
        }
    }
    out
}

// The numeric-character-reference-end-state table of html/__init__.py.
fn hp_invalid_charref(num: i64) -> Option[i64] {
    if num == 0 {
        return Some(0xfffd);
    }
    if num == 0x0d {
        return Some(0x0d);
    }
    if num < 0x80 or num > 0x9f {
        return None;
    }
    let table: Vec[i64] = vec![
        0x20ac, 0x81, 0x201a, 0x0192, 0x201e, 0x2026, 0x2020, 0x2021,
        0x02c6, 0x2030, 0x0160, 0x2039, 0x0152, 0x8d, 0x017d, 0x8f,
        0x90, 0x2018, 0x2019, 0x201c, 0x201d, 0x2022, 0x2013, 0x2014,
        0x02dc, 0x2122, 0x0161, 0x203a, 0x0153, 0x9d, 0x017e, 0x0178,
    ];
    Some(table[num - 0x80])
}

fn hp_invalid_codepoint(num: i64) -> bool {
    if (num >= 0x1 and num <= 0x8) or num == 0xb or (num >= 0xe and num <= 0x1f) {
        return true;
    }
    if (num >= 0x7f and num <= 0x9f) or (num >= 0xfdd0 and num <= 0xfdef) {
        return true;
    }
    num % 0x10000 >= 0xfffe and num <= 0x10ffff
}

fn hp_push_code(out: mut ref String, num: i64) {
    match char.try_from(num) {
        Ok(c) => out.push(c),
        Err(_) => out.push('\u{fffd}'),
    }
}

fn hp_numeric_ref(num: i64, out: mut ref String) {
    match hp_invalid_charref(num) {
        Some(v) => {
            hp_push_code(mut out, v);
            return;
        }
        None => {}
    }
    if (num >= 0xd800 and num <= 0xdfff) or num > 0x10ffff {
        out.push('\u{fffd}');
        return;
    }
    if hp_invalid_codepoint(num) {
        return;
    }
    hp_push_code(mut out, num);
}

// The digits raw[lo..hi] in base 10 or 16, held at 0x110000 once past
// the last code point, as int() then the range check would decide.
fn hp_ref_number(raw: ref Vec[char], lo: i64, hi: i64, base: i64) -> i64 {
    let mut n = 0;
    let mut k = lo;
    while k < hi {
        let c = raw[k];
        let d = if hp_is_digit(c) {
            c as i64 - '0' as i64
        } else {
            hp_ascii_lower(c) as i64 - 'a' as i64 + 10
        };
        n = n * base + d;
        if n > 0x10ffff {
            n = 0x110000;
        }
        k += 1;
    }
    n
}

// A named reference's text, the name possibly ending in ';'.
fn hp_named_ref(name: ref Vec[char], ents: ref Map[String, String], out: mut ref String) {
    let whole = hp_text(name, 0, name.len());
    match ents.get(whole.clone()) {
        Some(v) => {
            out.push_str(v);
            return;
        }
        None => {}
    }
    // The longest name the standard allows as a prefix.
    let mut x = name.len() - 1;
    while x > 1 {
        match ents.get(hp_text(name, 0, x)) {
            Some(v) => {
                out.push_str(v);
                out.push_str(hp_text(name, x, name.len()));
                return;
            }
            None => {}
        }
        x -= 1;
    }
    out.push('&');
    out.push_str(whole);
}

fn hp_named_class(c: char) -> bool {
    not (c == '\t' or c == '\n' or c == '\u{c}' or c == ' ' or c == '<' or c == '&' or c == '#' or c == ';')
}

// html.unescape over raw[lo..hi].
fn hp_unescape_chars(raw: ref Vec[char], lo: i64, hi: i64, ents: ref Map[String, String]) -> String {
    let mut out = String.new();
    let mut p = lo;
    while p < hi {
        if raw[p] != '&' {
            out.push(raw[p]);
            p += 1;
            continue;
        }
        if p + 1 < hi and raw[p + 1] == '#' {
            if p + 2 < hi and hp_is_digit(raw[p + 2]) {
                let mut q = p + 2;
                while q < hi and hp_is_digit(raw[q]) {
                    q += 1;
                }
                hp_numeric_ref(hp_ref_number(raw, p + 2, q, 10), mut out);
                if q < hi and raw[q] == ';' {
                    q += 1;
                }
                p = q;
            } else if p + 3 < hi and (raw[p + 2] == 'x' or raw[p + 2] == 'X') and hp_is_hex(raw[p + 3]) {
                let mut q = p + 3;
                while q < hi and hp_is_hex(raw[q]) {
                    q += 1;
                }
                hp_numeric_ref(hp_ref_number(raw, p + 3, q, 16), mut out);
                if q < hi and raw[q] == ';' {
                    q += 1;
                }
                p = q;
            } else {
                out.push('&');
                p += 1;
            }
            continue;
        }
        let mut q = p + 1;
        while q < hi and q - (p + 1) < 32 and hp_named_class(raw[q]) {
            q += 1;
        }
        if q == p + 1 {
            out.push('&');
            p += 1;
            continue;
        }
        if q < hi and raw[q] == ';' {
            q += 1;
        }
        let name: Vec[char] = raw[p + 1..q].iter().collect();
        hp_named_ref(name, ents, mut out);
        p = q;
    }
    out
}

fn hp_unescape(s: ref String, ents: ref Map[String, String]) -> String {
    let raw = hp_to_chars(s);
    hp_unescape_chars(raw, 0, raw.len(), ents)
}

// _unescape_attrvalue: numeric references always, named ones only when
// the whole name is in the table and no '=' follows.
fn hp_unescape_attr(s: ref String, ents: ref Map[String, String]) -> String {
    let raw = hp_to_chars(s);
    let n = raw.len();
    let mut out = String.new();
    let mut p = 0;
    while p < n {
        if raw[p] != '&' {
            out.push(raw[p]);
            p += 1;
            continue;
        }
        let mut q = p + 1;
        let mut numeric = false;
        if q < n and raw[q] == '#' {
            if q + 1 < n and hp_is_digit(raw[q + 1]) {
                q += 1;
                while q < n and hp_is_digit(raw[q]) {
                    q += 1;
                }
                numeric = true;
            } else if q + 2 < n and (raw[q + 1] == 'x' or raw[q + 1] == 'X') and hp_is_hex(raw[q + 2]) {
                q += 2;
                while q < n and hp_is_hex(raw[q]) {
                    q += 1;
                }
                numeric = true;
            } else {
                out.push('&');
                p += 1;
                continue;
            }
        } else if q < n and hp_is_alpha(raw[q]) {
            while q < n and hp_is_alnum(raw[q]) {
                q += 1;
            }
        } else {
            out.push('&');
            p += 1;
            continue;
        }
        let mut eq = false;
        if q < n and (raw[q] == ';' or raw[q] == '=') {
            eq = raw[q] == '=';
            q += 1;
        }
        let r = hp_text(raw, p, q);
        if numeric {
            out.push_str(hp_unescape_chars(raw, p, q, ents));
        } else if not eq and ents.contains_key(hp_text(raw, p + 1, q)) {
            out.push_str(hp_unescape_chars(raw, p, q, ents));
        } else {
            out.push_str(r);
        }
        p = q;
    }
    out
}

// ---------------------------------------------------------------- the tokenizer's patterns

// The end of locatetagend's match at p (a tag name's first letter).
fn hp_locate_tag_end(raw: ref Vec[char], p: i64) -> i64 {
    let n = raw.len();
    let mut k = p + 1;
    while k < n and not (hp_is_space(raw[k]) or raw[k] == '/' or raw[k] == '>') {
        k += 1;
    }
    while k < n and (hp_is_space(raw[k]) or raw[k] == '/') {
        k += 1;
    }
    loop {
        if k >= n or not hp_after_attr_gap(raw[k - 1]) {
            break;
        }
        let c = raw[k];
        if hp_is_space(c) or c == '/' or c == '>' {
            break;
        }
        k = hp_attr_name_end(raw, k);
        match hp_value_indicator(raw, k) {
            Some(v) => k = v.2,
            None => {}
        }
        while k < n and (hp_is_space(raw[k]) or raw[k] == '/') {
            k += 1;
        }
    }
    if k < n and raw[k] == '>' {
        k += 1;
    }
    k
}

// The lookbehind before an attribute name: ['"\t\n\r\f /].
fn hp_after_attr_gap(c: char) -> bool {
    c == '\'' or c == '"' or hp_is_space(c) or c == '/'
}

fn hp_attr_name_end(raw: ref Vec[char], k: i64) -> i64 {
    let n = raw.len();
    let mut e = k + 1;
    while e < n and not (hp_is_space(raw[e]) or raw[e] == '/' or raw[e] == '=' or raw[e] == '>') {
        e += 1;
    }
    e
}

// A value at b: 'x', "x" or a bare run; None when a quote opens and never
// closes.
fn hp_value_at(raw: ref Vec[char], b: i64) -> Option[i64] {
    let n = raw.len();
    if b < n and (raw[b] == '\'' or raw[b] == '"') {
        let q = hp_find_char(raw, raw[b], b + 1);
        if q < 0 {
            return None;
        }
        return Some(q + 1);
    }
    let mut e = b;
    while e < n and not (raw[e] == '>' or hp_is_space(raw[e])) {
        e += 1;
    }
    Some(e)
}

// `[\t\n\r\f ]*=[\t\n\r\f ]*` and a value after an attribute name ending
// at k: (value start, value end, match end), backtracking the way re does
// when a quote never closes.
fn hp_value_indicator(raw: ref Vec[char], k: i64) -> Option[(i64, i64, i64)] {
    let n = raw.len();
    let mut a = k;
    while a < n and hp_is_space(raw[a]) {
        a += 1;
    }
    if a >= n or raw[a] != '=' {
        return None;
    }
    let mut b = a + 1;
    while b < n and hp_is_space(raw[b]) {
        b += 1;
    }
    match hp_value_at(raw, b) {
        Some(e) => Some((b, e, e)),
        None => {
            if b > a + 1 {
                // One space fewer, and the value is the empty bare run.
                Some((b - 1, b - 1, b - 1))
            } else {
                None
            }
        }
    }
}

struct Attr {
    name: String,
    value: Option[String],
}

// ---------------------------------------------------------------- events

enum Event {
    Start(String, Vec[Attr]),
    StartEnd(String, Vec[Attr]),
    End(String),
    Data(String),
    Comment(String),
    Decl(String),
    Pi(String),
    UnknownDecl(String),
    CharRef(String),
    EntityRef(String),
}

struct Ev {
    line: i64,
    col: i64,
    ev: Event,
}

// ---------------------------------------------------------------- HTMLParser

struct HtmlParser {
    convert_charrefs: bool,
    raw: Vec[char],
    lineno: i64,
    offset: i64,
    lasttag: String,
    cdata_elem: String,
    escapable: bool,
    support_cdata: bool,
    pending: Vec[char],
    pending_len: i64,
    parse_threshold: i64,
    starttag_text: Option[String],
    events: Vec[Ev],
}

fn hp_is_cdata_content(tag: ref String) -> bool {
    tag == "script" or tag == "style" or tag == "xmp" or tag == "iframe" or tag == "noembed" or tag == "noframes"
}

impl HtmlParser {
    fn new(convert_charrefs: bool) -> HtmlParser {
        HtmlParser {
            convert_charrefs: convert_charrefs,
            raw: Vec.new(),
            lineno: 1,
            offset: 0,
            lasttag: "???".to_string(),
            cdata_elem: String.new(),
            escapable: true,
            support_cdata: true,
            pending: Vec.new(),
            pending_len: 0,
            parse_threshold: 1,
            starttag_text: None,
            events: Vec.new(),
        }
    }

    fn emit(mut ref self, ev: own Event) {
        self.events.push(Ev { line: self.lineno, col: self.offset, ev: ev });
    }

    fn feed(mut ref self, data: ref Vec[char], ents: ref Map[String, String]) {
        self.pending_len += data.len();
        if self.pending_len < self.parse_threshold {
            for c in data.iter() {
                self.pending.push(*c);
            }
            return;
        }
        for c in self.pending.iter() {
            self.raw.push(*c);
        }
        for c in data.iter() {
            self.raw.push(*c);
        }
        self.pending.clear();
        self.pending_len = 0;
        let n = self.raw.len();
        self.goahead(false, ents);
        if self.raw.len() < n {
            self.parse_threshold = 1;
        } else {
            self.parse_threshold = self.raw.len();
        }
    }

    fn close(mut ref self, ents: ref Map[String, String]) {
        if self.pending.len() > 0 {
            for c in self.pending.iter() {
                self.raw.push(*c);
            }
            self.pending.clear();
            self.pending_len = 0;
        }
        self.goahead(true, ents);
    }

    fn getpos(ref self) -> (i64, i64) {
        (self.lineno, self.offset)
    }

    fn updatepos(mut ref self, i: i64, j: i64) -> i64 {
        if i >= j {
            return j;
        }
        let mut nlines = 0;
        let mut last = -1;
        let mut k = i;
        while k < j {
            if self.raw[k] == '\n' {
                nlines += 1;
                last = k;
            }
            k += 1;
        }
        if nlines > 0 {
            self.lineno += nlines;
            self.offset = j - (last + 1);
        } else {
            self.offset += j - i;
        }
        j
    }

    fn set_cdata_mode(mut ref self, elem: ref String, escapable: bool) {
        self.cdata_elem = elem.to_lowercase();
        self.escapable = escapable;
    }

    fn clear_cdata_mode(mut ref self) {
        self.cdata_elem = String.new();
        self.escapable = true;
    }

    // self.interesting.search(rawdata, i): the start of the match, or -1.
    fn interesting(ref self, i: i64) -> i64 {
        let n = self.raw.len();
        if self.cdata_elem == "plaintext" {
            return n;
        }
        let mut p = i;
        while p < n {
            let c = self.raw[p];
            if self.cdata_elem == "" {
                if c == '<' or c == '&' {
                    return p;
                }
            } else {
                if self.escapable and not self.convert_charrefs and c == '&' {
                    return p;
                }
                if c == '<' and p + 1 < n and self.raw[p + 1] == '/' and hp_at_nocase(self.raw, p + 2, self.cdata_elem) {
                    let after = p + 2 + self.cdata_elem.chars().count();
                    if after < n and (hp_is_space(self.raw[after]) or self.raw[after] == '/' or self.raw[after] == '>') {
                        return p;
                    }
                }
            }
            p += 1;
        }
        -1
    }

    fn data(mut ref self, lo: i64, hi: i64, ents: ref Map[String, String]) {
        let s = if self.convert_charrefs and self.escapable {
            hp_unescape_chars(self.raw, lo, hi, ents)
        } else {
            hp_text(self.raw, lo, hi)
        };
        self.emit(Event.Data(s));
    }

    fn goahead(mut ref self, end: bool, ents: ref Map[String, String]) {
        let n = self.raw.len();
        let mut i = 0;
        while i < n {
            let mut j = n;
            if self.convert_charrefs and self.cdata_elem == "" {
                let lt = hp_find_char(self.raw, '<', i);
                if lt < 0 {
                    // A reference may be cut in half at the end of the buffer.
                    let lo = if i > n - 34 { i } else { n - 34 };
                    let mut amppos = -1;
                    let mut k = n - 1;
                    while k >= lo {
                        if self.raw[k] == '&' {
                            amppos = k;
                            break;
                        }
                        k -= 1;
                    }
                    if amppos >= 0 {
                        let mut ended = false;
                        let mut q = amppos;
                        while q < n {
                            let c = self.raw[q];
                            if hp_is_space(c) or c == ';' {
                                ended = true;
                                break;
                            }
                            q += 1;
                        }
                        if not ended {
                            break;
                        }
                    }
                    j = n;
                } else {
                    j = lt;
                }
            } else {
                let m = self.interesting(i);
                if m >= 0 {
                    j = m;
                } else {
                    if self.cdata_elem != "" {
                        break;
                    }
                    j = n;
                }
            }
            if i < j {
                self.data(i, j, ents);
            }
            i = self.updatepos(i, j);
            if i == n {
                break;
            }
            if self.raw[i] == '<' {
                let mut k = 0;
                if i + 1 < n and hp_is_alpha(self.raw[i + 1]) {
                    k = self.parse_starttag(i, ents);
                } else if hp_at(self.raw, i, "</") {
                    k = self.parse_endtag(i);
                } else if hp_at(self.raw, i, "<!--") {
                    k = self.parse_comment(i);
                } else if hp_at(self.raw, i, "<?") {
                    k = self.parse_pi(i);
                } else if hp_at(self.raw, i, "<!") {
                    k = self.parse_html_declaration(i);
                } else if i + 1 < n or end {
                    self.emit(Event.Data("<".to_string()));
                    k = i + 1;
                } else {
                    break;
                }
                if k < 0 {
                    if not end {
                        break;
                    }
                    self.flush_unterminated(i);
                    k = n;
                }
                i = self.updatepos(i, k);
            } else if hp_at(self.raw, i, "&#") {
                match self.match_charref(i) {
                    Some((name, e)) => {
                        self.emit(Event.CharRef(name));
                        let mut k = e;
                        if self.raw[k - 1] != ';' {
                            k -= 1;
                        }
                        i = self.updatepos(i, k);
                        continue;
                    }
                    None => {}
                }
                let incomplete = i + 2 < n and (hp_is_digit(self.raw[i + 2])
                    or (i + 3 < n and (self.raw[i + 2] == 'x' or self.raw[i + 2] == 'X') and hp_is_hex(self.raw[i + 3])));
                if incomplete {
                    if end {
                        let name = hp_text(self.raw, i + 2, n);
                        self.emit(Event.CharRef(name));
                        i = self.updatepos(i, n);
                    }
                    break;
                } else if i + 3 < n {
                    self.emit(Event.Data("&#".to_string()));
                    i = self.updatepos(i, i + 2);
                } else {
                    break;
                }
            } else if self.raw[i] == '&' {
                match self.match_entityref(i) {
                    Some((name, e)) => {
                        self.emit(Event.EntityRef(name));
                        let mut k = e;
                        if self.raw[k - 1] != ';' {
                            k -= 1;
                        }
                        i = self.updatepos(i, k);
                        continue;
                    }
                    None => {}
                }
                let incomplete = i + 1 < n and (hp_is_alpha(self.raw[i + 1]) or self.raw[i + 1] == '#');
                if incomplete {
                    if end {
                        let name = hp_text(self.raw, i + 1, n);
                        self.emit(Event.EntityRef(name));
                        i = self.updatepos(i, n);
                    }
                    break;
                } else if i + 1 < n {
                    self.emit(Event.Data("&".to_string()));
                    i = self.updatepos(i, i + 1);
                } else {
                    break;
                }
            } else {
                panic("interesting.search() lied");
            }
        }
        if end and i < n {
            self.data(i, n, ents);
            i = self.updatepos(i, n);
        }
        self.raw = self.raw[i..].iter().collect();
    }

    // What goahead does at EOF with a construct that never ended.
    fn flush_unterminated(mut ref self, i: i64) {
        let n = self.raw.len();
        if i + 1 < n and hp_is_alpha(self.raw[i + 1]) {
            return;
        }
        if hp_at(self.raw, i, "</") {
            if i + 2 == n {
                self.emit(Event.Data("</".to_string()));
            } else if i + 2 < n and hp_is_alpha(self.raw[i + 2]) {
                return;
            } else {
                let s = hp_text(self.raw, i + 2, n);
                self.emit(Event.Comment(s));
            }
        } else if hp_at(self.raw, i, "<!--") {
            let mut j = n;
            let suffixes: Vec[String] = vec!["--!".to_string(), "--".to_string(), "-".to_string()];
            for suffix in suffixes.iter() {
                let len = suffix.chars().count();
                if n - (i + 4) >= len and hp_at(self.raw, n - len, suffix) {
                    j -= len;
                    break;
                }
            }
            let s = hp_text(self.raw, i + 4, j);
            self.emit(Event.Comment(s));
        } else if hp_at(self.raw, i, "<![CDATA[") and self.support_cdata {
            let s = hp_text(self.raw, i + 3, n);
            self.emit(Event.UnknownDecl(s));
        } else if hp_at_nocase(self.raw, i, "<!doctype") {
            let s = hp_text(self.raw, i + 2, n);
            self.emit(Event.Decl(s));
        } else if hp_at(self.raw, i, "<!") {
            let s = hp_text(self.raw, i + 2, n);
            self.emit(Event.Comment(s));
        } else if hp_at(self.raw, i, "<?") {
            let s = hp_text(self.raw, i + 2, n);
            self.emit(Event.Pi(s));
        } else {
            panic("we should not get here!");
        }
    }

    // charref: &#(?:[0-9]+|[xX][0-9a-fA-F]+)[^0-9a-fA-F] at i.
    fn match_charref(ref self, i: i64) -> Option[(String, i64)] {
        let n = self.raw.len();
        let mut q = i + 2;
        if q < n and hp_is_digit(self.raw[q]) {
            while q < n and hp_is_digit(self.raw[q]) {
                q += 1;
            }
        } else if q + 1 < n and (self.raw[q] == 'x' or self.raw[q] == 'X') and hp_is_hex(self.raw[q + 1]) {
            q += 1;
            while q < n and hp_is_hex(self.raw[q]) {
                q += 1;
            }
        } else {
            return None;
        }
        if q >= n or hp_is_hex(self.raw[q]) {
            return None;
        }
        Some((hp_text(self.raw, i + 2, q), q + 1))
    }

    // entityref: &([a-zA-Z][-.a-zA-Z0-9]*)[^a-zA-Z0-9] at i, giving back
    // name characters when the buffer ends inside the name.
    fn match_entityref(ref self, i: i64) -> Option[(String, i64)] {
        let n = self.raw.len();
        if i + 1 >= n or not hp_is_alpha(self.raw[i + 1]) {
            return None;
        }
        let mut e = i + 2;
        while e < n and (hp_is_alnum(self.raw[e]) or self.raw[e] == '-' or self.raw[e] == '.') {
            e += 1;
        }
        if e < n {
            return Some((hp_text(self.raw, i + 1, e), e + 1));
        }
        let mut b = e - 1;
        while b > i + 1 {
            if not hp_is_alnum(self.raw[b]) {
                return Some((hp_text(self.raw, i + 1, b), b + 1));
            }
            b -= 1;
        }
        None
    }

    fn parse_html_declaration(mut ref self, i: i64) -> i64 {
        if hp_at(self.raw, i, "<!--") {
            return self.parse_comment(i);
        } else if hp_at(self.raw, i, "<![CDATA[") and self.support_cdata {
            let j = hp_find_str(self.raw, "]]>", i + 9);
            if j < 0 {
                return -1;
            }
            let s = hp_text(self.raw, i + 3, j);
            self.emit(Event.UnknownDecl(s));
            return j + 3;
        } else if hp_at_nocase(self.raw, i, "<!doctype") {
            let gtpos = hp_find_char(self.raw, '>', i + 9);
            if gtpos < 0 {
                return -1;
            }
            let s = hp_text(self.raw, i + 2, gtpos);
            self.emit(Event.Decl(s));
            return gtpos + 1;
        }
        self.parse_bogus_comment(i)
    }

    fn parse_comment(mut ref self, i: i64) -> i64 {
        let n = self.raw.len();
        let mut start = -1;
        let mut stop = -1;
        // An empty comment is closed by the first ">" or "->".
        if i + 4 < n and self.raw[i + 4] == '>' {
            start = i + 4;
            stop = i + 5;
        } else if i + 5 < n and self.raw[i + 4] == '-' and self.raw[i + 5] == '>' {
            start = i + 4;
            stop = i + 6;
        } else {
            let mut p = i + 4;
            while p + 2 < n {
                if self.raw[p] == '-' and self.raw[p + 1] == '-' {
                    if self.raw[p + 2] == '>' {
                        start = p;
                        stop = p + 3;
                        break;
                    }
                    if p + 3 < n and self.raw[p + 2] == '!' and self.raw[p + 3] == '>' {
                        start = p;
                        stop = p + 4;
                        break;
                    }
                }
                p += 1;
            }
            if start < 0 {
                return -1;
            }
        }
        let s = hp_text(self.raw, i + 4, start);
        self.emit(Event.Comment(s));
        stop
    }

    fn parse_bogus_comment(mut ref self, i: i64) -> i64 {
        let pos = hp_find_char(self.raw, '>', i + 2);
        if pos < 0 {
            return -1;
        }
        let s = hp_text(self.raw, i + 2, pos);
        self.emit(Event.Comment(s));
        pos + 1
    }

    fn parse_pi(mut ref self, i: i64) -> i64 {
        let j = hp_find_char(self.raw, '>', i + 2);
        if j < 0 {
            return -1;
        }
        let s = hp_text(self.raw, i + 2, j);
        self.emit(Event.Pi(s));
        j + 1
    }

    fn parse_starttag(mut ref self, i: i64, ents: ref Map[String, String]) -> i64 {
        self.starttag_text = None;
        let endpos = hp_locate_tag_end(self.raw, i + 1);
        if self.raw[endpos - 1] != '>' {
            return -1;
        }
        self.starttag_text = Some(hp_text(self.raw, i, endpos));
        let n = self.raw.len();

        // tagfind_tolerant
        let mut k = i + 2;
        while k < n and not (hp_is_space(self.raw[k]) or self.raw[k] == '/' or self.raw[k] == '>') {
            k += 1;
        }
        let tag = hp_text(self.raw, i + 1, k).to_lowercase();
        k = hp_skip_attr_gap(self.raw, k);
        self.lasttag = tag.clone();

        let mut attrs: Vec[Attr] = Vec.new();
        while k < endpos {
            // attrfind_tolerant
            if not hp_after_attr_gap(self.raw[k - 1]) {
                break;
            }
            let c = self.raw[k];
            if hp_is_space(c) or c == '/' or c == '>' {
                break;
            }
            let ne = hp_attr_name_end(self.raw, k);
            let name = hp_text(self.raw, k, ne).to_lowercase();
            let mut value: Option[String] = None;
            let mut m = ne;
            match hp_value_indicator(self.raw, ne) {
                Some((vs, ve, e)) => {
                    let mut v = hp_text(self.raw, vs, ve);
                    if ve - vs >= 2 and (self.raw[vs] == '\'' or self.raw[vs] == '"') and self.raw[ve - 1] == self.raw[vs] {
                        v = hp_text(self.raw, vs + 1, ve - 1);
                    }
                    if v.len() > 0 {
                        v = hp_unescape_attr(v, ents);
                    }
                    value = Some(v);
                    m = e;
                }
                None => {}
            }
            attrs.push(Attr { name: name, value: value });
            k = hp_skip_attr_gap(self.raw, m);
        }

        let tail = hp_text(self.raw, k, endpos);
        let end = tail.trim();
        if end != ">" and end != "/>" {
            let s = hp_text(self.raw, i, endpos);
            self.emit(Event.Data(s));
            return endpos;
        }
        if end == "/>" {
            self.emit(Event.StartEnd(tag, attrs));
        } else {
            self.emit(Event.Start(tag.clone(), attrs));
            if hp_is_cdata_content(tag) or tag == "plaintext" {
                self.set_cdata_mode(tag, false);
            } else if tag == "textarea" or tag == "title" {
                self.set_cdata_mode(tag, true);
            }
        }
        endpos
    }

    fn parse_endtag(mut ref self, i: i64) -> i64 {
        let n = self.raw.len();
        if hp_find_char(self.raw, '>', i + 2) < 0 {
            return -1;
        }
        if not (i + 2 < n and hp_is_alpha(self.raw[i + 2])) {
            if self.raw[i + 2] == '>' {
                // "</>" is ignored.
                return i + 3;
            }
            return self.parse_bogus_comment(i);
        }
        let j = hp_locate_tag_end(self.raw, i + 2);
        if self.raw[j - 1] != '>' {
            return -1;
        }
        let mut k = i + 3;
        while k < n and not (hp_is_space(self.raw[k]) or self.raw[k] == '/' or self.raw[k] == '>') {
            k += 1;
        }
        let tag = hp_text(self.raw, i + 2, k).to_lowercase();
        self.emit(Event.End(tag));
        self.clear_cdata_mode();
        j
    }
}

// (?:[\t\n\r\f ]|/(?!>))*
fn hp_skip_attr_gap(raw: ref Vec[char], from: i64) -> i64 {
    let n = raw.len();
    let mut k = from;
    while k < n {
        if hp_is_space(raw[k]) {
            k += 1;
        } else if raw[k] == '/' and not (k + 1 < n and raw[k + 1] == '>') {
            k += 1;
        } else {
            break;
        }
    }
    k
}

fn hp_parse_all(src: ref String, convert: bool, chunk: i64, ents: ref Map[String, String]) -> HtmlParser {
    let mut p = HtmlParser.new(convert);
    let chars = hp_to_chars(src);
    if chunk == 0 {
        p.feed(chars, ents);
    } else {
        let mut k = 0;
        while k < chars.len() {
            let hi = if k + chunk < chars.len() { k + chunk } else { chars.len() };
            let piece: Vec[char] = chars[k..hi].iter().collect();
            p.feed(piece, ents);
            k = hi;
        }
    }
    p.close(ents);
    p
}

fn hp_html5_entities() -> Map[String, String] {
    let mut m: Map[String, String] = Map.new();
    hp_add_entities_0(mut m);
    hp_add_entities_1(mut m);
    hp_add_entities_2(mut m);
    hp_add_entities_3(mut m);
    hp_add_entities_4(mut m);
    hp_add_entities_5(mut m);
    hp_add_entities_6(mut m);
    hp_add_entities_7(mut m);
    hp_add_entities_8(mut m);
    m
}

fn hp_add_entities_0(m: mut ref Map[String, String]) {
    m.insert("AElig".to_string(), "\u{c6}".to_string());
    m.insert("AElig;".to_string(), "\u{c6}".to_string());
    m.insert("AMP".to_string(), "&".to_string());
    m.insert("AMP;".to_string(), "&".to_string());
    m.insert("Aacute".to_string(), "\u{c1}".to_string());
    m.insert("Aacute;".to_string(), "\u{c1}".to_string());
    m.insert("Abreve;".to_string(), "\u{102}".to_string());
    m.insert("Acirc".to_string(), "\u{c2}".to_string());
    m.insert("Acirc;".to_string(), "\u{c2}".to_string());
    m.insert("Acy;".to_string(), "\u{410}".to_string());
    m.insert("Afr;".to_string(), "\u{1d504}".to_string());
    m.insert("Agrave".to_string(), "\u{c0}".to_string());
