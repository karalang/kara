// ------------------------------------------------------------ Python values

// An error is its Python form, "Kind: message".
fn value_err(msg: ref String) -> String {
    f"ValueError: {msg}"
}

fn type_err(msg: ref String) -> String {
    f"TypeError: {msg}"
}

fn key_err(key: ref String) -> String {
    f"KeyError: {repr_str(key)}"
}

// The values a row holds: what the jobs pass in, as Python has them.
#[derive(Clone)]
enum V {
    S(String),
    I(i64),
    F(f64),
    B(bool),
    N,
    L(Vec[V]),
}

fn py_str(v: ref V) -> String {
    match v {
        V.S(s) => s.clone(),
        _ => py_repr(v),
    }
}

fn py_repr(v: ref V) -> String {
    match v {
        V.S(s) => repr_str(s),
        V.I(n) => f"{n}",
        V.F(x) => float_repr(*x),
        V.B(b) => if *b { "True".to_string() } else { "False".to_string() },
        V.N => "None".to_string(),
        V.L(items) => {
            let mut parts: Vec[String] = Vec.new();
            for it in items.iter() {
                parts.push(py_repr(it));
            }
            f"[{join_strs(parts, ", ")}]"
        }
    }
}

fn type_name(v: ref V) -> String {
    let t = match v {
        V.S(_) => "str",
        V.I(_) => "int",
        V.F(_) => "float",
        V.B(_) => "bool",
        V.N => "NoneType",
        V.L(_) => "list",
    };
    t.to_string()
}

fn truthy(v: ref V) -> bool {
    match v {
        V.S(s) => s.len() > 0,
        V.I(n) => *n != 0,
        V.F(x) => *x != 0.0,
        V.B(b) => *b,
        V.N => false,
        V.L(items) => items.len() > 0,
    }
}

// The number of an int, float or bool.
fn num_of(v: ref V) -> Option[f64] {
    match v {
        V.I(n) => Some(*n as f64),
        V.F(x) => Some(*x),
        V.B(b) => Some(if *b { 1.0 } else { 0.0 }),
        _ => None,
    }
}

fn int_of(v: ref V) -> Option[i64] {
    match v {
        V.I(n) => Some(*n),
        V.B(b) => Some(if *b { 1 } else { 0 }),
        _ => None,
    }
}

fn py_eq(a: ref V, b: ref V) -> bool {
    if let (Some(x), Some(y)) = (int_of(a), int_of(b)) {
        return x == y;
    }
    if let (Some(x), Some(y)) = (num_of(a), num_of(b)) {
        return x == y;
    }
    match (a, b) {
        (V.S(x), V.S(y)) => x == y,
        (V.N, V.N) => true,
        (V.L(x), V.L(y)) => {
            if x.len() != y.len() {
                return false;
            }
            for i in 0..x.len() {
                if not py_eq(x[i], y[i]) {
                    return false;
                }
            }
            true
        }
        _ => false,
    }
}

fn unorderable(op: Str, a: ref V, b: ref V) -> String {
    type_err(f"'{op}' not supported between instances of '{type_name(a)}' and '{type_name(b)}'")
}

// a < b, as Python orders numbers, strings and lists.
fn py_lt(a: ref V, b: ref V) -> Result[bool, String] {
    if let (Some(x), Some(y)) = (int_of(a), int_of(b)) {
        return Ok(x < y);
    }
    if let (Some(x), Some(y)) = (num_of(a), num_of(b)) {
        return Ok(x < y);
    }
    match (a, b) {
        (V.S(x), V.S(y)) => Ok(x < y),
        (V.L(x), V.L(y)) => {
            let n = if x.len() < y.len() { x.len() } else { y.len() };
            for i in 0..n {
                if not py_eq(x[i], y[i]) {
                    return py_lt(x[i], y[i]);
                }
            }
            Ok(x.len() < y.len())
        }
        _ => Err(unorderable("<", a, b)),
    }
}

fn py_gt(a: ref V, b: ref V) -> Result[bool, String] {
    match py_lt(b, a) {
        Ok(r) => Ok(r),
        Err(_) => Err(unorderable(">", a, b)),
    }
}

// float(v)
fn py_float_of(v: ref V) -> Result[f64, String] {
    match v {
        V.S(s) => match py_float(s) {
            Some(x) => Ok(x),
            None => Err(value_err(f"could not convert string to float: {repr_str(s)}")),
        },
        V.N => Err(type_err("float() argument must be a string or a real number, not 'NoneType'")),
        V.L(_) => Err(type_err("float() argument must be a string or a real number, not 'list'")),
        _ => Ok(num_of(v).unwrap_or(0.0)),
    }
}

fn join_strs(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

fn strs_repr(v: ref Vec[String]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for s in v.iter() {
        parts.push(repr_str(s));
    }
    f"[{join_strs(parts, ", ")}]"
}

// ------------------------------------------------------------ list.sort

// list.sort for the short lists a table holds, as CPython 3.13 does it
// below 64 items: the first run is found (and reversed when it descends),
// then binary insertion sort places the rest. Only `<` is asked, in the
// order CPython asks it, so a TypeError names the types the same way
// round. The items move with their keys.
fn sort_by_keys(items: own Vec[Vec[V]], keys: own Vec[V], reverse: bool) -> Result[Vec[Vec[V]], String] {
    let mut a = keys;
    let mut v = items;
    let n = a.len();
    if n < 2 {
        return Ok(v);
    }
    if reverse {
        a.reverse();
        v.reverse();
    }
    let run = count_run(mut a, mut v)?;
    binarysort(mut a, mut v, run)?;
    if reverse {
        v.reverse();
    }
    Ok(v)
}

fn reverse_range(a: mut ref Vec[V], v: mut ref Vec[Vec[V]], lo: i64, hi: i64) {
    let mut i = lo;
    let mut j = hi - 1;
    while i < j {
        let t = a[i].clone();
        a[i] = a[j].clone();
        a[j] = t;
        let u = v[i].clone();
        v[i] = v[j].clone();
        v[j] = u;
        i += 1;
        j -= 1;
    }
}

fn count_run(a: mut ref Vec[V], v: mut ref Vec[Vec[V]]) -> Result[i64, String] {
    let total = a.len();
    let mut n = 1;
    while n < total {
        if py_lt(a[n], a[n - 1])? {
            break;
        }
        n += 1;
    }
    if n == total {
        return Ok(n);
    }
    if n > 1 {
        if py_lt(a[0], a[n - 1])? {
            return Ok(n);
        }
        reverse_range(mut a, mut v, 0, n);
    }
    n += 1;
    let mut neq = 0;
    while n < total {
        if py_lt(a[n], a[n - 1])? {
            if neq > 0 {
                neq += 1;
                reverse_range(mut a, mut v, n - neq, n);
                neq = 0;
            }
        } else {
            if py_lt(a[n - 1], a[n])? {
                break;
            }
            neq += 1;
        }
        n += 1;
    }
    if neq > 0 {
        neq += 1;
        reverse_range(mut a, mut v, n - neq, n);
    }
    reverse_range(mut a, mut v, 0, n);
    while n < total {
        if py_lt(a[n], a[n - 1])? {
            break;
        }
        n += 1;
    }
    Ok(n)
}

fn binarysort(a: mut ref Vec[V], v: mut ref Vec[Vec[V]], ok0: i64) -> Result[(), String] {
    let n = a.len();
    let mut ok = if ok0 == 0 { 1 } else { ok0 };
    while ok < n {
        let mut l = 0;
        let mut r = ok;
        let pivot = a[ok].clone();
        let vpivot = v[ok].clone();
        while l < r {
            let m = (l + r) / 2;
            if py_lt(pivot, a[m])? {
                r = m;
            } else {
                l = m + 1;
            }
        }
        let mut m = ok;
        while m > l {
            a[m] = a[m - 1].clone();
            v[m] = v[m - 1].clone();
            m -= 1;
        }
        a[l] = pivot;
        v[l] = vpivot;
        ok += 1;
    }
    Ok(())
}

// ------------------------------------------------------------ dicts

// The table's per-field settings are dicts, so they keep insertion order
// and an assignment to a present key keeps its place.
#[derive(Clone)]
struct SMap {
    items: Vec[(String, String)],
}

impl SMap {
    fn new() -> SMap {
        SMap { items: Vec.new() }
    }

    fn get(ref self, k: ref String) -> Option[String] {
        for (key, v) in self.items.iter() {
            if key == k {
                return Some(v.clone());
            }
        }
        None
    }

    fn has(ref self, k: ref String) -> bool {
        self.get(k).is_some()
    }

    fn set(mut ref self, k: ref String, v: ref String) {
        for i in 0..self.items.len() {
            if self.items[i].0 == *k {
                self.items[i].1 = v.clone();
                return;
            }
        }
        self.items.push((k.clone(), v.clone()));
    }

    fn len(ref self) -> i64 {
        self.items.len()
    }

    fn repr(ref self) -> String {
        let mut parts: Vec[String] = Vec.new();
        for (k, v) in self.items.iter() {
            parts.push(f"{repr_str(k)}: {repr_str(v)}");
        }
        "{" + join_strs(parts, ", ") + "}"
    }
}

#[derive(Clone)]
struct IMap {
    items: Vec[(String, i64)],
}

impl IMap {
    fn new() -> IMap {
        IMap { items: Vec.new() }
    }

    fn get(ref self, k: ref String) -> Option[i64] {
        for (key, v) in self.items.iter() {
            if key == k {
                return Some(*v);
            }
        }
        None
    }

    fn set(mut ref self, k: ref String, v: i64) {
        for i in 0..self.items.len() {
            if self.items[i].0 == *k {
                self.items[i].1 = v;
                return;
            }
        }
        self.items.push((k.clone(), v));
    }

    fn repr(ref self) -> String {
        let mut parts: Vec[String] = Vec.new();
        for (k, v) in self.items.iter() {
            parts.push(f"{repr_str(k)}: {v}");
        }
        "{" + join_strs(parts, ", ") + "}"
    }
}

// none_format: a field's replacement for "None", or None.
#[derive(Clone)]
struct NMap {
    items: Vec[(String, Option[String])],
}

impl NMap {
    fn new() -> NMap {
        NMap { items: Vec.new() }
    }

    // .get(field): the replacement when there is one.
    fn get(ref self, k: ref String) -> Option[String] {
        for (key, v) in self.items.iter() {
            if key == k {
                return v.clone();
            }
        }
        None
    }

    fn set(mut ref self, k: ref String, v: ref Option[String]) {
        for i in 0..self.items.len() {
            if self.items[i].0 == *k {
                self.items[i].1 = v.clone();
                return;
            }
        }
        self.items.push((k.clone(), v.clone()));
    }

    fn repr(ref self) -> String {
        let mut parts: Vec[String] = Vec.new();
        for (k, v) in self.items.iter() {
            let r = match v {
                Some(s) => repr_str(s),
                None => "None".to_string(),
            };
            parts.push(f"{repr_str(k)}: {r}");
        }
        "{" + join_strs(parts, ", ") + "}"
    }
}

// ------------------------------------------------------------ wcwidth

// The width tables of wcwidth 0.2.13 for Unicode 15.1.0, read from
// data/wcwidth.txt: zero width, East Asian wide, and the characters
// VS16 turns wide.
struct Widths {
    zero: Vec[(i64, i64)],
    wide: Vec[(i64, i64)],
    vs16: Vec[(i64, i64)],
}

fn hex_num(s: Str) -> i64 {
    let mut n = 0;
    for c in s.chars() {
        n = n * 16 + hex_value(c);
    }
    n
}

fn ranges_of(line: Str) -> Vec[(i64, i64)] {
    let mut out: Vec[(i64, i64)] = Vec.new();
    for part in line.split(" ") {
        if part.is_empty() {
            continue;
        }
        let ab: Vec[Str] = part.split("-").collect();
        out.push((hex_num(ab[0]), hex_num(ab[1])));
    }
    out
}

fn load_widths() -> Result[Widths, String] {
    let t = match fs.read_to_string("data/wcwidth.txt") {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/wcwidth.txt: {e}"),
    };
    let lines: Vec[Str] = t.split("\n").collect();
    Ok(Widths { zero: ranges_of(lines[0]), wide: ranges_of(lines[1]), vs16: ranges_of(lines[2]) })
}

fn bisearch(ucs: i64, table: ref Vec[(i64, i64)]) -> i64 {
    let mut lbound = 0;
    let mut ubound = table.len() - 1;
    if ubound < 0 {
        return 0;
    }
    if ucs < table[0].0 or ucs > table[ubound].1 {
        return 0;
    }
    while ubound >= lbound {
        let mid = (lbound + ubound) / 2;
        if ucs > table[mid].1 {
            lbound = mid + 1;
        } else if ucs < table[mid].0 {
            ubound = mid - 1;
        } else {
            return 1;
        }
    }
    0
}

fn wcwidth(w: ref Widths, ucs: i64) -> i64 {
    if ucs >= 32 and ucs < 0x7f {
        return 1;
    }
    if (ucs != 0 and ucs < 32) or (ucs >= 0x7f and ucs < 0xa0) {
        return -1;
    }
    if bisearch(ucs, w.zero) == 1 {
        return 0;
    }
    1 + bisearch(ucs, w.wide)
}

// wcswidth(): the cells a string takes, or -1 when it holds a control.
fn wcswidth(w: ref Widths, s: ref Vec[char]) -> i64 {
    let mut width = 0;
    let mut idx = 0;
    let mut last: Option[i64] = None;
    while idx < s.len() {
        let c = s[idx] as i64;
        if c == 0x200D {
            idx += 2;
            continue;
        }
        if c == 0xFE0F and last.is_some() {
            width += bisearch(last.unwrap(), w.vs16);
            last = None;
            idx += 1;
            continue;
        }
        let cw = wcwidth(w, c);
        if cw < 0 {
            return cw;
        }
        if cw > 0 {
            last = Some(c);
        }
        width += cw;
        idx += 1;
    }
    width
}

// ------------------------------------------------------------ escapes

fn at_seq(cs: ref Vec[char], i: i64, pat: Str) -> bool {
    let p: Vec[char] = pat.chars().collect();
    if i + p.len() > cs.len() {
        return false;
    }
    for k in 0..p.len() {
        if cs[i + k] != p[k] {
            return false;
        }
    }
    true
}

// _osc8_re.sub(r"\1", s): an OSC 8 hyperlink, \033]8;;.*?\033\\(.*?)\033]8;;\033\\,
// becomes its text. The lazy parts give way the way sre backtracks, and
// neither crosses a newline.
fn sub_osc8(cs: ref Vec[char]) -> Vec[char] {
    let mut out: Vec[char] = Vec.new();
    let mut i = 0;
    while i < cs.len() {
        let mut done = false;
        if at_seq(cs, i, "\u{1b}]8;;") {
            let mut p1 = i + 5;
            while p1 < cs.len() and not done {
                if at_seq(cs, p1, "\u{1b}\\") {
                    let mut p2 = p1 + 2;
                    while p2 <= cs.len() {
                        if at_seq(cs, p2, "\u{1b}]8;;\u{1b}\\") {
                            for k in (p1 + 2)..p2 {
                                out.push(cs[k]);
                            }
                            i = p2 + 7;
                            done = true;
                            break;
                        }
                        if p2 >= cs.len() or cs[p2] == '\n' {
                            break;
                        }
                        p2 += 1;
                    }
                }
                if done or cs[p1] == '\n' {
                    break;
                }
                p1 += 1;
            }
        }
        if not done {
            out.push(cs[i]);
            i += 1;
        }
    }
    out
}

// _re.sub("", s): the colour codes \033[...m and \033(B go.
fn sub_ansi(cs: ref Vec[char]) -> Vec[char] {
    let mut out: Vec[char] = Vec.new();
    let mut i = 0;
    while i < cs.len() {
        if cs[i] == '\u{1b}' and i + 1 < cs.len() and cs[i + 1] == '[' {
            let mut j = i + 2;
            while j < cs.len() and ((cs[j] >= '0' and cs[j] <= '9') or cs[j] == ';') {
                j += 1;
            }
            if j < cs.len() and cs[j] == 'm' {
                i = j + 1;
                continue;
            }
        }
        if at_seq(cs, i, "\u{1b}(B") {
            i += 3;
            continue;
        }
        out.push(cs[i]);
        i += 1;
    }
    out
}

// _str_block_width
fn block_width(w: ref Widths, s: ref String) -> i64 {
    let cs: Vec[char] = s.chars().collect();
    wcswidth(w, sub_ansi(sub_osc8(cs)))
}

fn split_nl(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for part in s.split("\n") {
        out.push(part.to_string());
    }
    out
}

// _get_size: the widest line and the number of lines.
fn get_size(w: ref Widths, s: ref String) -> (i64, i64) {
    let lines = split_nl(s);
    let mut width = 0;
    let mut first = true;
    for l in lines.iter() {
        let b = block_width(w, l);
        if first or b > width {
            width = b;
        }
        first = false;
    }
    (width, lines.len())
}

// ------------------------------------------------------------ str methods

fn is_cased(c: char) -> bool {
    c.is_lowercase() or c.is_uppercase()
}

fn char_upper(c: char) -> String {
    let mut s = String.new();
    s.push(c);
    s.to_uppercase()
}

fn char_lower(c: char) -> String {
    let mut s = String.new();
    s.push(c);
    s.to_lowercase()
}

fn py_upper(s: ref String) -> String {
    s.to_uppercase()
}

fn py_lower(s: ref String) -> String {
    s.to_lowercase()
}

// str.capitalize(): the first character in title case, the rest lower.
fn py_capitalize(s: ref String) -> String {
    let mut out = String.new();
    let mut first = true;
    for c in s.chars() {
        if first {
            out.push_str(char_upper(c));
        } else {
            out.push_str(char_lower(c));
        }
        first = false;
    }
    out
}

// str.title(): a cased character after an uncased one goes up, others down.
fn py_title(s: ref String) -> String {
    let mut out = String.new();
    let mut prev_cased = false;
    for c in s.chars() {
        if prev_cased {
            out.push_str(char_lower(c));
        } else {
            out.push_str(char_upper(c));
        }
        prev_cased = is_cased(c);
    }
    out
}

fn replace_all(s: ref String, from: Str, to: Str) -> String {
    s.replace(from, to)
}

fn n_spaces(n: i64) -> String {
    let mut s = String.new();
    let mut k = 0;
    while k < n {
        s.push(' ');
        k += 1;
    }
    s
}

fn n_times(s: ref String, n: i64) -> String {
    let mut out = String.new();
    let mut k = 0;
    while k < n {
        out.push_str(s);
        k += 1;
    }
    out
}

// s[a:b] by characters, with Python's clamping (b may be negative).
fn char_slice(s: ref String, a: i64, b: i64) -> String {
    let cs: Vec[char] = s.chars().collect();
    let n = cs.len();
    let mut lo = if a < 0 { a + n } else { a };
    let mut hi = if b < 0 { b + n } else { b };
    if lo < 0 {
        lo = 0;
    }
    if hi > n {
        hi = n;
    }
    let mut out = String.new();
    let mut k = lo;
    while k < hi {
        out.push(cs[k]);
        k += 1;
    }
    out
}

fn char_len(s: ref String) -> i64 {
    s.chars().count()
}

// ------------------------------------------------------------ job values

// A row value from a job or a JSON file: an int, a float, a string, a
// bool, None or a list.
fn v_of_j(j: ref J) -> V {
    match j {
        J.S(s) => V.S(s.clone()),
        J.N(t) => {
            if t.contains(".") or t.contains("e") or t.contains("E") {
                V.F(f64.parse(t).unwrap_or(0.0))
            } else {
                V.I(i64.parse(t).unwrap_or(0))
            }
        }
        J.F(x) => V.F(*x),
        J.B(b) => V.B(*b),
        J.Null => V.N,
        J.A(items) => {
            let mut out: Vec[V] = Vec.new();
            for it in items.iter() {
                out.push(v_of_j(it));
            }
            V.L(out)
        }
        J.O(_) => V.N,
    }
}

fn j_is_dict(j: ref J) -> bool {
    match j {
        J.O(_) => true,
        _ => false,
    }
}

fn j_is_none(j: ref J) -> bool {
    match j {
        J.Null => true,
        _ => false,
    }
}

// None, or a dict with nothing in it: what the per-field setters reset on.
fn j_none_or_empty(j: ref J) -> bool {
    match j {
        J.Null => true,
        J.O(m) => m.len() == 0,
        _ => false,
    }
}

fn j_truthy(j: ref J) -> bool {
    match j {
        J.S(s) => s.len() > 0,
        J.N(_) => truthy(v_of_j(j)),
        J.F(x) => *x != 0.0,
        J.B(b) => *b,
        J.Null => false,
        J.A(items) => items.len() > 0,
        J.O(m) => m.len() > 0,
    }
}

// str(val) of a job value.
fn j_text(j: ref J) -> String {
    match j {
        J.S(s) => s.clone(),
        J.O(m) => {
            let mut parts: Vec[String] = Vec.new();
            for (k, v) in m.iter() {
                parts.push(f"{repr_str(k)}: {py_repr(v_of_j(v))}");
            }
            "{" + join_strs(parts, ", ") + "}"
        }
        _ => py_str(v_of_j(j)),
    }
}

// val in (True, False): True, False, 1, 0, 1.0 and 0.0 are.
fn j_bool(j: ref J) -> Option[bool] {
    match j {
        J.B(b) => Some(*b),
        J.N(_) => {
            match num_of(v_of_j(j)) {
                Some(x) => if x == 1.0 { Some(true) } else if x == 0.0 { Some(false) } else { None },
                None => None,
            }
        }
        _ => None,
    }
}

// int(val)
fn j_int(j: ref J) -> Result[i64, String] {
    match v_of_j(j) {
        V.I(n) => Ok(n),
        V.B(b) => Ok(if b { 1 } else { 0 }),
        V.F(x) => Ok(x as i64),
        V.S(s) => match i64.parse(py_strip(s)) {
            Ok(n) => Ok(n),
            Err(_) => Err(value_err(f"invalid literal for int() with base 10: {repr_str(s)}")),
        },
        V.N => {
            if j_is_dict(j) {
                Err(type_err("int() argument must be a string, a bytes-like object or a real number, not 'dict'"))
            } else {
                Err(type_err("int() argument must be a string, a bytes-like object or a real number, not 'NoneType'"))
            }
        }
        V.L(_) => Err(type_err("int() argument must be a string, a bytes-like object or a real number, not 'list'")),
    }
}

fn j_strs(j: ref J) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    if let J.A(items) = j {
        for it in items.iter() {
            out.push(j_text(it));
        }
    }
    out
}

fn j_members(j: ref J) -> Vec[(String, J)] {
    match j {
        J.O(m) => m.clone(),
        _ => Vec.new(),
    }
}

fn kw_get(kw: ref Vec[(String, J)], name: Str) -> Option[J] {
    for (k, v) in kw.iter() {
        if k == name {
            return Some(v.clone());
        }
    }
    None
}

fn kw_has(kw: ref Vec[(String, J)], name: Str) -> bool {
    kw_get(kw, name).is_some()
}

fn strs_contain(v: ref Vec[String], s: ref String) -> bool {
    for x in v.iter() {
        if x == s {
            return true;
        }
    }
    false
}

fn opt_fields_skip(fields: ref Option[Vec[String]], field: ref String) -> bool {
    match fields {
        Some(f) => f.len() > 0 and not strs_contain(f, field),
        None => false,
    }
}

fn bools_repr(v: ref Vec[bool]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for b in v.iter() {
        parts.push(if *b { "True".to_string() } else { "False".to_string() });
    }
    f"[{join_strs(parts, ", ")}]"
}

fn rows_repr(rows: ref Vec[Vec[V]]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for r in rows.iter() {
        parts.push(py_repr(V.L(r.clone())));
    }
    f"[{join_strs(parts, ", ")}]"
}

// ------------------------------------------------------------ printf

// (f"%{fmt}d") % value and (f"%{fmt}f") % value: the conversion is given
// as Python's format spec, and what follows it is kept as it is.
fn printf_one(fmt: ref String, value: ref V) -> Result[String, String] {
    let cs = chars(fmt);
    let mut out = String.new();
    let mut i = 0;
    let mut used = false;
    while i < cs.len() {
        if cs[i] != '%' {
            out.push(cs[i]);
            i += 1;
            continue;
        }
        i += 1;
        if i < cs.len() and cs[i] == '%' {
            out.push('%');
            i += 1;
            continue;
        }
        let mut left = false;
        let mut sign = String.new();
        let mut zero = false;
        let mut alt = false;
        while i < cs.len() and (cs[i] == '-' or cs[i] == '+' or cs[i] == ' ' or cs[i] == '#' or cs[i] == '0') {
            let c = cs[i];
            if c == '-' {
                left = true;
            } else if c == '+' {
                sign = "+".to_string();
            } else if c == ' ' {
                if sign.len() == 0 {
                    sign = " ".to_string();
                }
            } else if c == '#' {
                alt = true;
            } else {
                zero = true;
            }
            i += 1;
        }
        let mut width = String.new();
        while i < cs.len() and is_digit(cs[i]) {
            width.push(cs[i]);
            i += 1;
        }
        let mut prec = String.new();
        let mut has_prec = false;
        if i < cs.len() and cs[i] == '.' {
            has_prec = true;
            i += 1;
            while i < cs.len() and is_digit(cs[i]) {
                prec.push(cs[i]);
                i += 1;
            }
            if prec.len() == 0 {
                prec = "0".to_string();
            }
        }
        if i >= cs.len() {
            return Err(value_err("incomplete format"));
        }
        let conv = cs[i];
        i += 1;
        used = true;
        let mut spec = String.new();
        if left {
            spec.push('<');
        }
        spec.push_str(sign);
        if alt {
            spec.push('#');
        }
        if zero and not left {
            spec.push('0');
        }
        spec.push_str(width);
        if has_prec {
            spec.push('.');
            spec.push_str(prec);
        }
        if conv == 'd' or conv == 'i' or conv == 'u' {
            spec.push('d');
            let n = match value {
                V.I(n) => *n,
                V.B(b) => if *b { 1 } else { 0 },
                V.F(x) => *x as i64,
                _ => return Err(type_err(f"%{conv} format: a real number is required, not {type_name(value)}")),
            };
            out.push_str(format_int(n, spec)?);
        } else if conv == 'f' or conv == 'F' or conv == 'e' or conv == 'E' or conv == 'g' or conv == 'G' {
            spec.push(conv);
            let x = match num_of(value) {
                Some(x) => x,
                None => return Err(type_err(f"must be real number, not {type_name(value)}")),
            };
            out.push_str(format_float(x, spec)?);
        } else {
            return Err(value_err(f"unsupported format character '{conv}'"));
        }
    }
    if not used {
        return Err(type_err("not all arguments converted during string formatting"));
    }
    Ok(out)
}

// ------------------------------------------------------------ formatters

// The functions a job names for custom_format.
fn formatter(name: ref String, field: ref String, v: ref V) -> Result[String, String] {
    if name == "upper" {
        return Ok(py_upper(py_str(v)));
    }
    if name == "money" {
        if let V.S(s) = v {
            if s.len() == 0 {
                return Ok(String.new());
            }
        }
        return Ok(f"${fmt_num(v, ",.2f")?}");
    }
    if name == "percent" {
        return fmt_num(v, ".1%");
    }
    if name == "label" {
        return Ok(f"{field}={py_str(v)}");
    }
    if name == "yesno" {
        return Ok(if truthy(v) { "yes".to_string() } else { "no".to_string() });
    }
    if name == "kib" {
        let x = match num_of(v) {
            Some(x) => x,
            None => return Err(type_err(f"unsupported operand type(s) for /: '{type_name(v)}' and 'int'")),
        };
        let s = format_float(x / 1024.0, ".1f".to_string())?;
        return Ok(f"{s} KiB");
    }
    if name == "lines" {
        return Ok(py_str(v).replace(", ", "\n"));
    }
    if name == "red" {
        return Ok(f"\u{1b}[31m{py_str(v)}\u{1b}[0m");
    }
    if name == "link" {
        let s = py_str(v);
        return Ok(f"\u{1b}]8;;https://pypi.org/project/{s}/\u{1b}\\{s}\u{1b}]8;;\u{1b}\\");
    }
    Err(f"unknown formatter {name}")
}

// format(v, spec) for a number.
fn fmt_num(v: ref V, spec: Str) -> Result[String, String] {
    let sp = spec.to_string();
    match v {
        V.I(n) => format_int(*n, sp),
        V.B(b) => format_bool(*b, sp),
        V.F(x) => format_float(*x, sp),
        _ => Err(value_err(f"Unknown format code '{last_char(spec)}' for object of type '{type_name(v)}'")),
    }
}

fn last_char(s: Str) -> char {
    let cs: Vec[char] = s.chars().collect();
    cs[cs.len() - 1]
}

// ------------------------------------------------------------ sort keys and filters

// The functions a job names for sort_key: each gets the decorated row,
// the sort value first.
fn sort_key_of(name: ref Option[String], row: ref Vec[V]) -> Result[V, String] {
    let n = match name {
        Some(n) => n.clone(),
        None => return Ok(V.L(row.clone())),
    };
    if n == "lower" {
        return Ok(V.S(py_lower(py_str(row[0]))));
    }
    if n == "length" {
        return Ok(V.I(char_len(py_str(row[0]))));
    }
    if n == "last" {
        return Ok(row[row.len() - 1].clone());
    }
    if n == "number" {
        return Ok(V.F(py_float_of(row[0])?));
    }
    if n == "rest" {
        let mut rest: Vec[V] = Vec.new();
        for i in 1..row.len() {
            rest.push(row[i].clone());
        }
        return Ok(V.L(rest));
    }
    Err(f"unknown sort key {n}")
}

// ["gt"|"eq"|"has", i, v] and ["truthy", i]
fn row_filter_ok(spec: ref Option[J], row: ref Vec[V]) -> Result[bool, String] {
    let s = match spec {
        Some(s) => s.clone(),
        None => return Ok(true),
    };
    let parts = match s {
        J.A(p) => p,
        _ => return Ok(true),
    };
    let kind = j_text(parts[0]);
    let i = j_int(parts[1])?;
    let cell = if i < 0 { row[row.len() + i].clone() } else { row[i].clone() };
    if kind == "truthy" {
        return Ok(truthy(cell));
    }
    let v = v_of_j(parts[2]);
    if kind == "gt" {
        return py_gt(cell, v);
    }
    if kind == "eq" {
        return Ok(py_eq(cell, v));
    }
    if kind == "has" {
        return Ok(py_str(cell).contains(py_str(v)));
    }
    Err(f"unknown filter {kind}")
}

// ------------------------------------------------------------ the table

// HRuleStyle and VRuleStyle
const FRAME: i64 = 0;
const ALL: i64 = 1;
const NONE: i64 = 2;
const HEADER: i64 = 3;

// TableStyle
const DEFAULT: i64 = 10;
const MSWORD_FRIENDLY: i64 = 11;
const PLAIN_COLUMNS: i64 = 12;
const MARKDOWN: i64 = 13;
const ORGMODE: i64 = 14;
const DOUBLE_BORDER: i64 = 15;
const SINGLE_BORDER: i64 = 16;

fn style_named(name: ref String) -> Result[i64, String] {
    let names = ["DEFAULT", "MSWORD_FRIENDLY", "PLAIN_COLUMNS", "MARKDOWN", "ORGMODE", "DOUBLE_BORDER", "SINGLE_BORDER"];
    for i in 0..names.len() {
        if names[i] == *name {
            return Ok(DEFAULT + i);
        }
    }
    Err(key_err(name))
}

fn rule_repr(kind: Str, v: i64) -> String {
    let names = ["FRAME", "ALL", "NONE", "HEADER"];
    if v >= 0 and v < 4 {
        return f"<{kind}.{names[v]}: {v}>";
    }
    f"{v}"
}

const BASE_ALIGN_VALUE: Str = "base_align_value";
const RESET_CODE: Str = "\u{1b}[0m";

// The eight junction characters, by their place in the arrays below.
const J_TOP: i64 = 0;
const J_BOTTOM: i64 = 1;
const J_RIGHT: i64 = 2;
const J_LEFT: i64 = 3;
const J_TOP_RIGHT: i64 = 4;
const J_TOP_LEFT: i64 = 5;
const J_BOTTOM_RIGHT: i64 = 6;
const J_BOTTOM_LEFT: i64 = 7;

fn junction_names() -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    for n in ["top", "bottom", "right", "left", "top_right", "top_left", "bottom_right", "bottom_left"] {
        v.push(f"{n}_junction_char");
    }
    v
}

fn junction_index(name: Str) -> i64 {
    let names = junction_names();
    for i in 0..names.len() {
        if names[i] == name {
            return i;
        }
    }
    -1
}

// self._options, in its order: the order options are validated in.
fn option_names() -> Vec[String] {
    let names = [
        "title", "start", "end", "fields", "header", "use_header_width", "border",
        "preserve_internal_border", "sortby", "reversesort", "sort_key", "row_filter",
        "attributes", "format", "hrules", "vrules", "int_format", "float_format",
        "custom_format", "min_table_width", "max_table_width", "padding_width",
        "left_padding_width", "right_padding_width", "vertical_char", "horizontal_char",
        "horizontal_align_char", "junction_char", "header_style", "xhtml", "print_empty",
        "oldsortslice", "top_junction_char", "bottom_junction_char", "right_junction_char",
        "left_junction_char", "top_right_junction_char", "top_left_junction_char",
        "bottom_right_junction_char", "bottom_left_junction_char", "align", "valign",
        "max_width", "min_width", "none_format", "escape_header", "escape_data",
        "break_on_hyphens",
    ];
    let mut v: Vec[String] = Vec.new();
    for n in names {
        v.push(n.to_string());
    }
    v
}

fn is_option(name: ref String) -> bool {
    strs_contain(option_names(), name)
}

#[derive(Clone)]
struct Table {
    color: bool,
    field_names: Vec[String],
    rows: Vec[Vec[V]],
    dividers: Vec[bool],
    align: SMap,
    valign: SMap,
    max_width: IMap,
    min_width: IMap,
    int_format: SMap,
    float_format: SMap,
    // custom_format names a formatter per field; cf_shared says the dict
    // is the one the constructor was given, as Python shares it.
    custom_format: SMap,
    cf_shared: bool,
    none_format: NMap,
    style: Option[i64],
    orgmode: bool,
    kwargs: Vec[(String, J)],
    title: Option[String],
    start: i64,
    end: Option[i64],
    fields: Option[Vec[String]],
    header: bool,
    use_header_width: bool,
    header_style: Option[String],
    border: bool,
    preserve_internal_border: bool,
    hrules: i64,
    vrules: i64,
    sortby: Option[String],
    reversesort: bool,
    sort_key: Option[String],
    row_filter: Option[J],
    escape_data: bool,
    escape_header: bool,
    min_table_width: Option[i64],
    max_table_width: Option[i64],
    padding_width: i64,
    left_padding_width: Option[i64],
    right_padding_width: Option[i64],
    vertical_char: String,
    horizontal_char: String,
    horizontal_align_char: Option[String],
    junction_char: String,
    junctions: Vec[Option[String]],
    print_empty: bool,
    oldsortslice: bool,
    format: bool,
    xhtml: bool,
    attributes: Vec[(String, String)],
    break_on_hyphens: bool,
    widths: Vec[i64],
    hrule: String,
}

// A theme: the colours of a ColorTable.
struct Theme {
    default_color: String,
    vertical_char: String,
    vertical_color: String,
    horizontal_char: String,
    horizontal_color: String,
    junction_char: String,
    junction_color: String,
}

fn format_code(s: ref String) -> String {
    if py_strip(s).len() == 0 {
        String.new()
    } else if s.starts_with("\u{1b}[") {
        s.clone()
    } else {
        f"\u{1b}[{s}m"
    }
}

fn new_theme(default_color: Str, vertical_color: Str, horizontal_color: Str, junction_color: Str) -> Theme {
    Theme {
        default_color: format_code(default_color.to_string()),
        vertical_char: "|".to_string(),
        vertical_color: format_code(vertical_color.to_string()),
        horizontal_char: "-".to_string(),
        horizontal_color: format_code(horizontal_color.to_string()),
        junction_char: "+".to_string(),
        junction_color: format_code(junction_color.to_string()),
    }
}

fn theme_named(name: ref String) -> Result[Theme, String] {
    if name == "DEFAULT" {
        return Ok(new_theme("", "", "", ""));
    }
    if name == "DYSLEXIA_FRIENDLY" {
        return Ok(new_theme("38;5;223", "38;5;22", "38;5;22", "38;5;58"));
    }
    if name == "EARTH" {
        return Ok(new_theme("33", "38;5;94", "38;5;22", "38;5;130"));
    }
    if name == "GLARE_REDUCTION" {
        return Ok(new_theme("38;5;252", "38;5;240", "38;5;240", "38;5;246"));
    }
    if name == "HIGH_CONTRAST" {
        return Ok(new_theme("97", "91", "94", "93"));
    }
    if name == "LAVENDER" {
        return Ok(new_theme("38;5;183", "35", "38;5;147", "38;5;219"));
    }
    if name == "OCEAN" {
        return Ok(new_theme("96", "34", "34", "36"));
    }
    if name == "OCEAN_DEEP" {
        return Ok(new_theme("96", "34", "36", "94"));
    }
    if name == "PASTEL" {
        return Ok(new_theme("38;5;223", "38;5;152", "38;5;187", "38;5;157"));
    }
    Err(f"AttributeError: type object 'Themes' has no attribute {repr_str(name)}")
}

// Theme(**kw)
fn custom_theme(kw: ref Vec[(String, J)]) -> Theme {
    Theme {
        default_color: format_code(kw_text(kw, "default_color", "")),
        vertical_char: kw_text(kw, "vertical_char", "|"),
        vertical_color: format_code(kw_text(kw, "vertical_color", "")),
        horizontal_char: kw_text(kw, "horizontal_char", "-"),
        horizontal_color: format_code(kw_text(kw, "horizontal_color", "")),
        junction_char: kw_text(kw, "junction_char", "+"),
        junction_color: format_code(kw_text(kw, "junction_color", "")),
    }
}

fn kw_text(kw: ref Vec[(String, J)], name: Str, dflt: Str) -> String {
    match kw_get(kw, name) {
        Some(j) => j_text(j),
        None => dflt.to_string(),
    }
}

fn kwv(kw: ref Vec[(String, J)], name: Str) -> J {
    match kw_get(kw, name) {
        Some(j) => j,
        None => J.Null,
    }
}

fn ch_str(c: char) -> String {
    let mut s = String.new();
    s.push(c);
    s
}

// The options a rendering uses: the table's own, with the keyword
// arguments laid over them.
#[derive(Clone)]
struct Opt {
    title: Option[String],
    start: i64,
    end: Option[i64],
    fields: Option[Vec[String]],
    header: bool,
    use_header_width: bool,
    border: bool,
    preserve_internal_border: bool,
    sortby: Option[String],
    reversesort: bool,
    sort_key: Option[String],
    row_filter: Option[J],
    attributes: Vec[(String, String)],
    format: bool,
    hrules: i64,
    vrules: i64,
    padding_width: i64,
    left_padding_width: Option[i64],
    right_padding_width: Option[i64],
    vertical_char: String,
    horizontal_char: String,
    junction_char: String,
    junctions: Vec[String],
    xhtml: bool,
    print_empty: bool,
    oldsortslice: bool,
    escape_header: bool,
    escape_data: bool,
    break_on_hyphens: bool,
    // keyword arguments that are not options, for csv.writer and json.dumps
    extra: Vec[(String, J)],
}

fn opt_int(j: ref J) -> Option[i64] {
    if j_is_none(j) {
        None
    } else {
        j_int(j).ok()
    }
}

fn opt_str(j: ref J) -> Option[String] {
    if j_is_none(j) {
        None
    } else {
        Some(j_text(j))
    }
}

fn opt_strs(j: ref J) -> Option[Vec[String]] {
    match j {
        J.A(_) => Some(j_strs(j)),
        _ => None,
    }
}

fn attrs_of(j: ref J) -> Vec[(String, String)] {
    let mut out: Vec[(String, String)] = Vec.new();
    for (k, v) in j_members(j).iter() {
        out.push((k.clone(), j_text(v)));
    }
    out
}

fn bool_of(j: ref J) -> bool {
    match j_bool(j) {
        Some(b) => b,
        None => j_truthy(j),
    }
}

impl Opt {
    // options[name] = kwargs[name]
    fn apply(mut ref self, name: ref String, j: ref J) {
        let n: Str = name.as_str();
        if n == "title" {
            self.title = opt_str(j);
        } else if n == "start" {
            self.start = j_int(j).unwrap_or(0);
        } else if n == "end" {
            self.end = opt_int(j);
        } else if n == "fields" {
            self.fields = opt_strs(j);
        } else if n == "header" {
            self.header = bool_of(j);
        } else if n == "use_header_width" {
            self.use_header_width = bool_of(j);
        } else if n == "border" {
            self.border = bool_of(j);
        } else if n == "preserve_internal_border" {
            self.preserve_internal_border = bool_of(j);
        } else if n == "sortby" {
            self.sortby = opt_str(j);
        } else if n == "reversesort" {
            self.reversesort = bool_of(j);
        } else if n == "sort_key" {
            self.sort_key = opt_str(j);
        } else if n == "row_filter" {
            self.row_filter = Some(j.clone());
        } else if n == "attributes" {
            self.attributes = attrs_of(j);
        } else if n == "format" {
            self.format = bool_of(j);
        } else if n == "hrules" {
            self.hrules = j_int(j).unwrap_or(0);
        } else if n == "vrules" {
            self.vrules = j_int(j).unwrap_or(0);
        } else if n == "padding_width" {
            self.padding_width = j_int(j).unwrap_or(0);
        } else if n == "left_padding_width" {
            self.left_padding_width = opt_int(j);
        } else if n == "right_padding_width" {
            self.right_padding_width = opt_int(j);
        } else if n == "vertical_char" {
            self.vertical_char = j_text(j);
        } else if n == "horizontal_char" {
            self.horizontal_char = j_text(j);
        } else if n == "junction_char" {
            self.junction_char = j_text(j);
        } else if n == "xhtml" {
            self.xhtml = bool_of(j);
        } else if n == "print_empty" {
            self.print_empty = bool_of(j);
        } else if n == "oldsortslice" {
            self.oldsortslice = bool_of(j);
        } else if n == "escape_header" {
            self.escape_header = bool_of(j);
        } else if n == "escape_data" {
            self.escape_data = bool_of(j);
        } else if n == "break_on_hyphens" {
            self.break_on_hyphens = bool_of(j);
        } else {
            let k = junction_index(n);
            if k >= 0 {
                self.junctions[k] = j_text(j);
            }
        }
    }

    // _get_padding_widths
    fn pads(ref self) -> (i64, i64) {
        let l = match ref self.left_padding_width {
            Some(n) => n,
            None => self.padding_width,
        };
        let r = match ref self.right_padding_width {
            Some(n) => n,
            None => self.padding_width,
        };
        (l, r)
    }

    // options[where + name], for where in "", "top_", "bottom_"
    fn left_j(ref self, place: Str) -> String {
        if place == "top_" {
            self.junctions[J_TOP_LEFT].clone()
        } else if place == "bottom_" {
            self.junctions[J_BOTTOM_LEFT].clone()
        } else {
            self.junctions[J_LEFT].clone()
        }
    }

    fn right_j(ref self, place: Str) -> String {
        if place == "top_" {
            self.junctions[J_TOP_RIGHT].clone()
        } else if place == "bottom_" {
            self.junctions[J_BOTTOM_RIGHT].clone()
        } else {
            self.junctions[J_RIGHT].clone()
        }
    }

    fn mid_j(ref self, place: Str) -> String {
        if place == "top_" {
            self.junctions[J_TOP].clone()
        } else if place == "bottom_" {
            self.junctions[J_BOTTOM].clone()
        } else {
            self.junction_char.clone()
        }
    }

    fn skips(ref self, field: ref String) -> bool {
        opt_fields_skip(self.fields, field)
    }
}

fn new_table(w: ref Widths, color: bool, field_names: ref Option[J], kw0: ref Vec[(String, J)]) -> Result[Table, String] {
    let mut base = SMap.new();
    base.set(BASE_ALIGN_VALUE.to_string(), "c".to_string());
    let mut t = Table {
        color: color,
        field_names: Vec.new(),
        rows: Vec.new(),
        dividers: Vec.new(),
        align: base,
        valign: SMap.new(),
        max_width: IMap.new(),
        min_width: IMap.new(),
        int_format: SMap.new(),
        float_format: SMap.new(),
        custom_format: SMap.new(),
        cf_shared: false,
        none_format: NMap.new(),
        style: None,
        orgmode: false,
        kwargs: Vec.new(),
        title: None,
        start: 0,
        end: None,
        fields: None,
        header: true,
        use_header_width: true,
        header_style: None,
        border: true,
        preserve_internal_border: false,
        hrules: FRAME,
        vrules: ALL,
        sortby: None,
        reversesort: false,
        sort_key: None,
        row_filter: None,
        escape_data: true,
        escape_header: true,
        min_table_width: None,
        max_table_width: None,
        padding_width: 1,
        left_padding_width: None,
        right_padding_width: None,
        vertical_char: "|".to_string(),
        horizontal_char: "-".to_string(),
        horizontal_align_char: None,
        junction_char: "+".to_string(),
        junctions: Vec.new(),
        print_empty: true,
        oldsortslice: false,
        format: false,
        xhtml: false,
        attributes: Vec.new(),
        break_on_hyphens: true,
        widths: Vec.new(),
        hrule: String.new(),
    };
    for _ in 0..8 {
        t.junctions.push(None);
    }
    if let Some(names) = field_names {
        if j_truthy(names) {
            t.set_field_names(w, names)?;
        }
    }
    let mut kw: Vec[(String, J)] = Vec.new();
    for name in option_names().iter() {
        match kw_get(kw0, name) {
            Some(v) => {
                t.validate(w, name, v)?;
                kw.push((name.clone(), v));
            }
            None => kw.push((name.clone(), J.Null)),
        }
    }
    t.kwargs = kw.clone();
    let tj = kwv(kw, "title");
    t.title = if j_truthy(tj) { Some(j_text(tj)) } else { None };
    t.start = if j_truthy(kwv(kw, "start")) { j_int(kwv(kw, "start"))? } else { 0 };
    t.end = if j_truthy(kwv(kw, "end")) { Some(j_int(kwv(kw, "end"))?) } else { None };
    t.fields = if j_truthy(kwv(kw, "fields")) { Some(j_strs(kwv(kw, "fields"))) } else { None };
    t.header = j_bool(kwv(kw, "header")).unwrap_or(true);
    t.use_header_width = j_bool(kwv(kw, "use_header_width")).unwrap_or(true);
    t.header_style = if j_truthy(kwv(kw, "header_style")) { Some(j_text(kwv(kw, "header_style"))) } else { None };
    t.border = j_bool(kwv(kw, "border")).unwrap_or(true);
    t.preserve_internal_border = j_bool(kwv(kw, "preserve_internal_border")).unwrap_or(false);
    t.hrules = if j_truthy(kwv(kw, "hrules")) { j_int(kwv(kw, "hrules"))? } else { FRAME };
    t.vrules = if j_truthy(kwv(kw, "vrules")) { j_int(kwv(kw, "vrules"))? } else { ALL };
    t.sortby = if j_truthy(kwv(kw, "sortby")) { Some(j_text(kwv(kw, "sortby"))) } else { None };
    t.reversesort = j_bool(kwv(kw, "reversesort")).unwrap_or(false);
    t.sort_key = if j_truthy(kwv(kw, "sort_key")) { Some(j_text(kwv(kw, "sort_key"))) } else { None };
    t.row_filter = if j_truthy(kwv(kw, "row_filter")) { Some(kwv(kw, "row_filter")) } else { None };
    t.escape_data = j_bool(kwv(kw, "escape_data")).unwrap_or(true);
    t.escape_header = j_bool(kwv(kw, "escape_header")).unwrap_or(true);
    t.column_specific_args(w)?;
    t.min_table_width = if j_truthy(kwv(kw, "min_table_width")) { Some(j_int(kwv(kw, "min_table_width"))?) } else { None };
    t.max_table_width = if j_truthy(kwv(kw, "max_table_width")) { Some(j_int(kwv(kw, "max_table_width"))?) } else { None };
    t.padding_width = if j_is_none(kwv(kw, "padding_width")) { 1 } else { j_int(kwv(kw, "padding_width"))? };
    t.left_padding_width = if j_truthy(kwv(kw, "left_padding_width")) { Some(j_int(kwv(kw, "left_padding_width"))?) } else { None };
    t.right_padding_width = if j_truthy(kwv(kw, "right_padding_width")) { Some(j_int(kwv(kw, "right_padding_width"))?) } else { None };
    t.vertical_char = if j_truthy(kwv(kw, "vertical_char")) { j_text(kwv(kw, "vertical_char")) } else { "|".to_string() };
    t.horizontal_char = if j_truthy(kwv(kw, "horizontal_char")) { j_text(kwv(kw, "horizontal_char")) } else { "-".to_string() };
    t.horizontal_align_char = opt_str(kwv(kw, "horizontal_align_char"));
    t.junction_char = if j_truthy(kwv(kw, "junction_char")) { j_text(kwv(kw, "junction_char")) } else { "+".to_string() };
    let jn = junction_names();
    for k in 0..8 {
        t.junctions[k] = opt_str(kwv(kw, jn[k]));
    }
    t.print_empty = j_bool(kwv(kw, "print_empty")).unwrap_or(true);
    t.oldsortslice = j_bool(kwv(kw, "oldsortslice")).unwrap_or(false);
    t.format = j_truthy(kwv(kw, "format"));
    t.xhtml = j_truthy(kwv(kw, "xhtml"));
    t.attributes = attrs_of(kwv(kw, "attributes"));
    t.break_on_hyphens = j_bool(kwv(kw, "break_on_hyphens")).unwrap_or(true);
    if color {
        let th = match kw_get(kw0, "theme") {
            Some(j) => theme_named(j_text(j))?,
            None => theme_named("DEFAULT".to_string())?,
        };
        t.set_theme(th);
    }
    Ok(t)
}

impl Table {
    fn colcount(ref self) -> i64 {
        if self.field_names.len() > 0 {
            self.field_names.len()
        } else if self.rows.len() > 0 {
            self.rows[0].len()
        } else {
            0
        }
    }

    // ColorTable.update_theme
    fn set_theme(mut ref self, th: ref Theme) {
        self.vertical_char = f"{th.vertical_color}{th.vertical_char}{RESET_CODE}{th.default_color}";
        self.horizontal_char = f"{th.horizontal_color}{th.horizontal_char}{RESET_CODE}{th.default_color}";
        self.junction_char = f"{th.junction_color}{th.junction_char}{RESET_CODE}{th.default_color}";
    }

    // The junction properties: the character, or junction_char.
    fn junction(ref self, k: i64) -> String {
        match self.junctions[k] {
            Some(s) => if s.len() > 0 { s.clone() } else { self.junction_char.clone() },
            None => self.junction_char.clone(),
        }
    }

    // ---------------------------------------------------------- validation

    fn validate(ref self, w: ref Widths, name: ref String, j: ref J) -> Result[(), String] {
        let n: Str = name.as_str();
        if n == "field_names" {
            return self.validate_field_names(j_strs(j));
        }
        if n == "none_format" {
            return validate_none_format(j);
        }
        let ints = ["start", "end", "max_width", "min_width", "min_table_width", "max_table_width",
                    "padding_width", "left_padding_width", "right_padding_width"];
        for k in ints {
            if n == k {
                if j_int(j)? < 0 {
                    return Err(value_err(f"Invalid value for {n}: {j_text(j)}"));
                }
                return Ok(());
            }
        }
        if n == "sortby" {
            return self.validate_field_name(j);
        }
        if n == "sort_key" or n == "row_filter" {
            if j_is_none(j) {
                return Err(value_err(f"Invalid value for {n}. Must be a function."));
            }
            return Ok(());
        }
        if n == "hrules" or n == "vrules" {
            let top = if n == "hrules" { 3.0 } else { 2.0 };
            let ok = match num_of(v_of_j(j)) {
                Some(x) => x >= 0.0 and x <= top and x == ((x as i64) as f64),
                None => false,
            };
            if not ok {
                let kind = if n == "hrules" { "HRuleStyle" } else { "VRuleStyle" };
                return Err(value_err(f"Invalid value for {n}. Must be {kind}."));
            }
            return Ok(());
        }
        if n == "fields" {
            if let J.A(items) = j {
                for x in items.iter() {
                    self.validate_field_name(x)?;
                }
            }
            return Ok(());
        }
        let bools = ["header", "use_header_width", "border", "preserve_internal_border", "reversesort",
                     "xhtml", "format", "print_empty", "oldsortslice", "escape_header", "escape_data",
                     "break_on_hyphens"];
        for k in bools {
            if n == k {
                if j_bool(j).is_none() {
                    return Err(value_err(f"Invalid value for {n}. Must be True or False."));
                }
                return Ok(());
            }
        }
        if n == "header_style" {
            return validate_header_style(j);
        }
        if n == "int_format" {
            return validate_int_format(n, j);
        }
        if n == "float_format" {
            return validate_float_format(n, j);
        }
        if n == "custom_format" {
            return match j {
                J.O(_) => Ok(()),
                J.S(_) => Err("AttributeError: 'function' object has no attribute 'items'".to_string()),
                _ => Err(f"AttributeError: '{type_name(v_of_j(j))}' object has no attribute 'items'"),
            };
        }
        if n == "vertical_char" or n == "horizontal_char" or n == "horizontal_align_char" or n == "junction_char" or junction_index(n) >= 0 {
            return validate_single_char(w, n, j);
        }
        if n == "attributes" {
            if not j_is_dict(j) {
                return Err(type_err("Attributes must be a dictionary of name/value pairs"));
            }
        }
        Ok(())
    }

    fn validate_field_names(ref self, val: ref Vec[String]) -> Result[(), String] {
        if self.field_names.len() > 0 and val.len() != self.field_names.len() {
            return Err(value_err(f"Field name list has incorrect number of values, (actual) {val.len()}!={self.field_names.len()} (expected)"));
        }
        if self.rows.len() > 0 and val.len() != self.rows[0].len() {
            return Err(value_err(f"Field name list has incorrect number of values, (actual) {val.len()}!={self.rows[0].len()} (expected)"));
        }
        for i in 0..val.len() {
            for k in (i + 1)..val.len() {
                if val[i] == val[k] {
                    return Err(value_err("Field names must be unique"));
                }
            }
        }
        Ok(())
    }

    fn validate_field_name(ref self, j: ref J) -> Result[(), String] {
        if j_is_none(j) {
            return Ok(());
        }
        if let J.S(s) = j {
            if strs_contain(self.field_names, s) {
                return Ok(());
            }
        }
        Err(value_err(f"Invalid field name: {j_text(j)}"))
    }

    // ---------------------------------------------------------- setters

    // _column_specific_args: the per-field settings from the constructor.
    fn column_specific_args(mut ref self, w: ref Widths) -> Result[(), String] {
        for attr in ["align", "valign", "max_width", "min_width", "int_format", "float_format", "custom_format", "none_format"] {
            let v = match kw_get(self.kwargs, attr) {
                Some(j) => if j_truthy(j) { j } else { J.O(Vec.new()) },
                None => J.O(Vec.new()),
            };
            if attr == "custom_format" {
                self.set_custom_format(v, j_truthy(v))?;
            } else {
                self.set_attr(w, attr.to_string(), v)?;
            }
        }
        Ok(())
    }

    fn set_field_names(mut ref self, w: ref Widths, j: ref J) -> Result[(), String] {
        let val = j_strs(j);
        self.validate_field_names(val)?;
        let old: Vec[String] = self.field_names.clone();
        self.field_names = val.clone();
        self.column_specific_args(w)?;
        if self.align.len() > 0 and old.len() > 0 {
            let n = if old.len() < val.len() { old.len() } else { val.len() };
            for i in 0..n {
                let a = match self.align.get(old[i]) {
                    Some(a) => a,
                    None => return Err(key_err(old[i])),
                };
                self.align.set(val[i], a);
            }
        } else if self.align.len() > 0 {
            let a = match self.align.get(BASE_ALIGN_VALUE.to_string()) {
                Some(a) => a,
                None => return Err(key_err(BASE_ALIGN_VALUE.to_string())),
            };
            for f in self.field_names.clone().iter() {
                self.align.set(f, a);
            }
        } else {
            self.set_attr(w, "align".to_string(), J.S("c".to_string()))?;
        }
        if self.valign.len() > 0 and old.len() > 0 {
            let n = if old.len() < val.len() { old.len() } else { val.len() };
            for i in 0..n {
                let a = match self.valign.get(old[i]) {
                    Some(a) => a,
                    None => return Err(key_err(old[i])),
                };
                self.valign.set(val[i], a);
            }
        } else {
            self.set_attr(w, "valign".to_string(), J.S("t".to_string()))?;
        }
        Ok(())
    }

    // The custom_format setter; `shared` when the dict is the constructor's.
    fn set_custom_format(mut ref self, j: ref J, shared: bool) -> Result[(), String] {
        match j {
            J.Null => {
                self.custom_format = SMap.new();
                self.cf_shared = false;
            }
            J.O(m) => {
                let mut d = SMap.new();
                for (k, v) in m.iter() {
                    d.set(k, j_text(v));
                }
                self.custom_format = d;
                self.cf_shared = shared;
            }
            J.S(name) => {
                for f in self.field_names.clone().iter() {
                    self.cf_set(f, name);
                }
            }
            _ => return Err(type_err("The custom_format property need to be a dictionary or callable")),
        }
        Ok(())
    }

    fn cf_set(mut ref self, field: ref String, name: ref String) {
        self.custom_format.set(field, name);
        if self.cf_shared {
            for i in 0..self.kwargs.len() {
                if self.kwargs[i].0 == "custom_format" {
                    let mut m = j_members(self.kwargs[i].1);
                    let mut found = false;
                    for k in 0..m.len() {
                        if m[k].0 == *field {
                            m[k].1 = J.S(name.clone());
                            found = true;
                        }
                    }
                    if not found {
                        m.push((field.clone(), J.S(name.clone())));
                    }
                    self.kwargs[i].1 = J.O(m);
                }
            }
        }
    }

    // setattr(t, name, value)
    fn set_attr(mut ref self, w: ref Widths, name: ref String, j: ref J) -> Result[(), String] {
        let n: Str = name.as_str();
        let names = self.field_names.clone();
        if n == "field_names" {
            return self.set_field_names(w, j);
        }
        if n == "align" {
            let val = if j_none_or_empty(j) {
                "c".to_string()
            } else {
                validate_align(j)?;
                j_text(j)
            };
            if names.len() == 0 {
                let mut m = SMap.new();
                m.set(BASE_ALIGN_VALUE.to_string(), val);
                self.align = m;
            } else {
                for f in names.iter() {
                    self.align.set(f, val);
                }
            }
            return Ok(());
        }
        if n == "valign" {
            if names.len() == 0 {
                self.valign = SMap.new();
                return Ok(());
            }
            let val = if j_none_or_empty(j) {
                "t".to_string()
            } else {
                validate_valign(j)?;
                j_text(j)
            };
            for f in names.iter() {
                self.valign.set(f, val);
            }
            return Ok(());
        }
        if n == "max_width" or n == "min_width" {
            if j_none_or_empty(j) {
                if n == "max_width" {
                    self.max_width = IMap.new();
                } else {
                    self.min_width = IMap.new();
                }
                return Ok(());
            }
            self.validate(w, name, j)?;
            let v = j_int(j)?;
            for f in names.iter() {
                if n == "max_width" {
                    self.max_width.set(f, v);
                } else {
                    self.min_width.set(f, v);
                }
            }
            return Ok(());
        }
        if n == "int_format" or n == "float_format" {
            if j_none_or_empty(j) {
                if n == "int_format" {
                    self.int_format = SMap.new();
                } else {
                    self.float_format = SMap.new();
                }
                return Ok(());
            }
            self.validate(w, name, j)?;
            let v = j_text(j);
            for f in names.iter() {
                if n == "int_format" {
                    self.int_format.set(f, v);
                } else {
                    self.float_format.set(f, v);
                }
            }
            return Ok(());
        }
        if n == "custom_format" {
            return self.set_custom_format(j, false);
        }
        if n == "none_format" {
            if names.len() == 0 {
                self.none_format = NMap.new();
                return Ok(());
            }
            if j_none_or_empty(j) {
                for f in names.iter() {
                    self.none_format.set(f, None);
                }
                return Ok(());
            }
            validate_none_format(j)?;
            for f in names.iter() {
                self.none_format.set(f, Some(j_text(j)));
            }
            return Ok(());
        }
        if n == "title" {
            self.title = Some(j_text(j));
            return Ok(());
        }
        if n == "header_style" {
            validate_header_style(j)?;
            self.header_style = opt_str(j);
            return Ok(());
        }
        // the single-character properties take str(val)
        let single = n == "vertical_char" or n == "horizontal_char" or n == "horizontal_align_char" or n == "junction_char" or junction_index(n) >= 0;
        let val = if single { J.S(j_text(j)) } else { j.clone() };
        self.validate(w, name, val)?;
        if n == "start" {
            self.start = j_int(val)?;
        } else if n == "end" {
            self.end = Some(j_int(val)?);
        } else if n == "sortby" {
            self.sortby = opt_str(val);
        } else if n == "reversesort" {
            self.reversesort = bool_of(val);
        } else if n == "sort_key" {
            self.sort_key = opt_str(val);
        } else if n == "row_filter" {
            self.row_filter = Some(val);
        } else if n == "header" {
            self.header = bool_of(val);
        } else if n == "use_header_width" {
            self.use_header_width = bool_of(val);
        } else if n == "border" {
            self.border = bool_of(val);
        } else if n == "preserve_internal_border" {
            self.preserve_internal_border = bool_of(val);
        } else if n == "hrules" {
            self.hrules = j_int(val)?;
        } else if n == "vrules" {
            self.vrules = j_int(val)?;
        } else if n == "padding_width" {
            self.padding_width = j_int(val)?;
        } else if n == "left_padding_width" {
            self.left_padding_width = Some(j_int(val)?);
        } else if n == "right_padding_width" {
            self.right_padding_width = Some(j_int(val)?);
        } else if n == "min_table_width" {
            self.min_table_width = Some(j_int(val)?);
        } else if n == "max_table_width" {
            self.max_table_width = Some(j_int(val)?);
        } else if n == "fields" {
            self.fields = opt_strs(val);
        } else if n == "vertical_char" {
            self.vertical_char = j_text(val);
        } else if n == "horizontal_char" {
            self.horizontal_char = j_text(val);
        } else if n == "horizontal_align_char" {
            self.horizontal_align_char = Some(j_text(val));
        } else if n == "junction_char" {
            self.junction_char = j_text(val);
        } else if n == "format" {
            self.format = bool_of(val);
        } else if n == "print_empty" {
            self.print_empty = bool_of(val);
        } else if n == "attributes" {
            self.attributes = attrs_of(val);
        } else if n == "oldsortslice" {
            self.oldsortslice = bool_of(val);
        } else if n == "escape_header" {
            self.escape_header = bool_of(val);
        } else if n == "escape_data" {
            self.escape_data = bool_of(val);
        } else if n == "break_on_hyphens" {
            self.break_on_hyphens = bool_of(val);
        } else if n == "xhtml" {
            self.xhtml = bool_of(val);
        } else if junction_index(n) >= 0 {
            self.junctions[junction_index(n)] = Some(j_text(val));
        } else {
            return Err(f"AttributeError: cannot set {n}");
        }
        Ok(())
    }

    // getattr(t, name), as its repr
    fn get_attr(ref self, name: ref String) -> Result[String, String] {
        let n: Str = name.as_str();
        if n == "rowcount" {
            return Ok(f"{self.rows.len()}");
        }
        if n == "colcount" {
            return Ok(f"{self.colcount()}");
        }
        if n == "field_names" {
            return Ok(strs_repr(self.field_names));
        }
        if n == "align" {
            return Ok(self.align.repr());
        }
        if n == "valign" {
            return Ok(self.valign.repr());
        }
        if n == "rows" {
            return Ok(rows_repr(self.rows));
        }
        if n == "dividers" {
            return Ok(bools_repr(self.dividers));
        }
        if n == "vrules" {
            return Ok(rule_repr("VRuleStyle", self.vrules));
        }
        if n == "hrules" {
            return Ok(rule_repr("HRuleStyle", self.hrules));
        }
        if n == "left_padding_width" {
            return Ok(match ref self.left_padding_width {
                Some(v) => f"{v}",
                None => "None".to_string(),
            });
        }
        if n == "horizontal_align_char" {
            return Ok(repr_str(self.junction(J_BOTTOM_LEFT)));
        }
        if junction_index(n) >= 0 {
            return Ok(repr_str(self.junction(junction_index(n))));
        }
        if n == "title" {
            return Ok(match ref self.title {
                Some(s) => repr_str(s),
                None => "None".to_string(),
            });
        }
        if n == "max_width" {
            return Ok(self.max_width.repr());
        }
        if n == "min_width" {
            return Ok(self.min_width.repr());
        }
        if n == "none_format" {
            return Ok(self.none_format.repr());
        }
        Err(f"AttributeError: {n}")
    }

    // t.set_key: getattr(t, attr)[key] = value, straight into the dict
    fn set_key(mut ref self, attr: ref String, key: ref String, j: ref J) -> Result[(), String] {
        let n: Str = attr.as_str();
        if n == "align" {
            self.align.set(key, j_text(j));
        } else if n == "valign" {
            self.valign.set(key, j_text(j));
        } else if n == "int_format" {
            self.int_format.set(key, j_text(j));
        } else if n == "float_format" {
            self.float_format.set(key, j_text(j));
        } else if n == "none_format" {
            self.none_format.set(key, opt_str(j));
        } else if n == "max_width" {
            self.max_width.set(key, j_int(j)?);
        } else if n == "min_width" {
            self.min_width.set(key, j_int(j)?);
        } else if n == "custom_format" {
            self.cf_set(key, j_text(j));
        } else {
            return Err(f"TypeError: cannot set a key of {n}");
        }
        Ok(())
    }

    // ---------------------------------------------------------- styles

    fn set_default_style(mut ref self) {
        self.header = true;
        self.border = true;
        self.hrules = FRAME;
        self.vrules = ALL;
        self.padding_width = 1;
        self.left_padding_width = Some(1);
        self.right_padding_width = Some(1);
        self.vertical_char = "|".to_string();
        self.horizontal_char = "-".to_string();
        self.horizontal_align_char = None;
        self.junction_char = "+".to_string();
        for k in 0..8 {
            self.junctions[k] = None;
        }
    }

    fn set_junctions(mut ref self, chars: Str) {
        let cs: Vec[char] = chars.chars().collect();
        self.horizontal_char = ch_str(cs[0]);
        self.vertical_char = ch_str(cs[1]);
        self.junction_char = ch_str(cs[2]);
        for k in 0..8 {
            self.junctions[k] = Some(ch_str(cs[k + 3]));
        }
    }

    fn set_style(mut ref self, style: i64) -> Result[(), String] {
        self.set_default_style();
        self.style = Some(style);
        if style == MSWORD_FRIENDLY {
            self.hrules = NONE;
        } else if style == PLAIN_COLUMNS {
            self.border = false;
            self.left_padding_width = Some(0);
            self.right_padding_width = Some(8);
        } else if style == MARKDOWN {
            self.hrules = HEADER;
            self.junction_char = "|".to_string();
            self.horizontal_align_char = Some(":".to_string());
        } else if style == ORGMODE {
            self.orgmode = true;
        } else if style == DOUBLE_BORDER {
            // horizontal, vertical, junction, then top, bottom, right, left,
            // top right, top left, bottom right, bottom left
            self.set_junctions("═║╬╦╩╣╠╗╔╝╚");
        } else if style == SINGLE_BORDER {
            self.set_junctions("─│┼┬┴┤├┐┌┘└");
        } else if style != DEFAULT {
            return Err(value_err("Invalid pre-set style"));
        }
        Ok(())
    }

    // ---------------------------------------------------------- data

    fn add_row(mut ref self, w: ref Widths, row: ref Vec[V], divider: bool) -> Result[(), String] {
        if self.field_names.len() > 0 and row.len() != self.field_names.len() {
            return Err(value_err(f"Row has incorrect number of values, (actual) {row.len()}!={self.field_names.len()} (expected)"));
        }
        if self.field_names.len() == 0 {
            let mut names: Vec[J] = Vec.new();
            for n in 0..row.len() {
                names.push(J.S(f"Field {n + 1}"));
            }
            self.set_field_names(w, J.A(names))?;
        }
        self.rows.push(row.clone());
        self.dividers.push(divider);
        Ok(())
    }

    fn add_rows(mut ref self, w: ref Widths, rows: ref Vec[Vec[V]], divider: bool) -> Result[(), String] {
        for i in 0..rows.len() {
            self.add_row(w, rows[i], divider and i + 1 == rows.len())?;
        }
        Ok(())
    }

    fn del_row(mut ref self, i: i64) -> Result[(), String] {
        if i > self.rows.len() - 1 {
            return Err(f"IndexError: Can't delete row at index {i}, table only has {self.rows.len()} rows");
        }
        let k = if i < 0 { self.rows.len() + i } else { i };
        if k < 0 {
            return Err("IndexError: list assignment index out of range".to_string());
        }
        self.rows.remove(k);
        self.dividers.remove(k);
        Ok(())
    }

    fn add_divider(mut ref self) {
        let n = self.dividers.len();
        if n >= 1 {
            self.dividers[n - 1] = true;
        }
    }

    fn add_column(mut ref self, name: ref String, column: ref Vec[V], align: ref String, valign: ref String) -> Result[(), String] {
        if self.rows.len() == 0 or self.rows.len() == column.len() {
            validate_align(J.S(align.clone()))?;
            validate_valign(J.S(valign.clone()))?;
            self.field_names.push(name.clone());
            self.align.set(name, align);
            self.valign.set(name, valign);
            for i in 0..column.len() {
                if self.rows.len() < i + 1 {
                    self.rows.push(Vec.new());
                    self.dividers.push(false);
                }
                self.rows[i].push(column[i].clone());
            }
            return Ok(());
        }
        Err(value_err(f"Column length {column.len()} does not match number of rows {self.rows.len()}"))
    }

    fn add_autoindex(mut ref self, name: ref String) {
        self.field_names.insert(0, name.clone());
        let a = match kw_get(self.kwargs, "align") {
            Some(j) => if j_truthy(j) { j_text(j) } else { "c".to_string() },
            None => "c".to_string(),
        };
        let v = match kw_get(self.kwargs, "valign") {
            Some(j) => if j_truthy(j) { j_text(j) } else { "t".to_string() },
            None => "t".to_string(),
        };
        self.align.set(name, a);
        self.valign.set(name, v);
        for i in 0..self.rows.len() {
            self.rows[i].insert(0, V.I(i + 1));
        }
    }

    fn del_column(mut ref self, name: ref String) -> Result[(), String] {
        let mut idx = -1;
        for i in 0..self.field_names.len() {
            if self.field_names[i] == *name {
                idx = i;
                break;
            }
        }
        if idx < 0 {
            let mut names: Vec[String] = Vec.new();
            for f in self.field_names.iter() {
                names.push(repr_str(f));
            }
            return Err(value_err(f"Can't delete column {repr_str(name)} which is not a field name of this table. Field names are: {join_strs(names, ", ")}"));
        }
        self.field_names.remove(idx);
        for i in 0..self.rows.len() {
            self.rows[i].remove(idx);
        }
        Ok(())
    }

    fn clear_rows(mut ref self) {
        self.rows = Vec.new();
        self.dividers = Vec.new();
    }

    fn clear(mut ref self) {
        self.rows = Vec.new();
        self.dividers = Vec.new();
        self.field_names = Vec.new();
        self.widths = Vec.new();
    }

    // t[lo:hi] and t[i]: a new PrettyTable with these rows and the
    // options copied, all but the style.
    fn with_rows(ref self, w: ref Widths, rows: ref Vec[Vec[V]]) -> Result[Table, String] {
        let mut n = self.clone();
        n.color = false;
        n.style = None;
        n.orgmode = false;
        n.cf_shared = false;
        let mut kw: Vec[(String, J)] = Vec.new();
        for name in option_names().iter() {
            kw.push((name.clone(), J.Null));
        }
        n.kwargs = kw;
        n.rows = Vec.new();
        n.dividers = Vec.new();
        n.widths = Vec.new();
        for r in rows.iter() {
            n.add_row(w, r, false)?;
        }
        Ok(n)
    }

    // ---------------------------------------------------------- options

    // _get_options
    fn options(ref self, w: ref Widths, kw: ref Vec[(String, J)]) -> Result[Opt, String] {
        let mut js: Vec[String] = Vec.new();
        for k in 0..8 {
            js.push(self.junction(k));
        }
        let mut o = Opt {
            title: self.title.clone(),
            start: self.start,
            end: self.end,
            fields: self.fields.clone(),
            header: self.header,
            use_header_width: self.use_header_width,
            border: self.border,
            preserve_internal_border: self.preserve_internal_border,
            sortby: self.sortby.clone(),
            reversesort: self.reversesort,
            sort_key: self.sort_key.clone(),
            row_filter: self.row_filter.clone(),
            attributes: self.attributes.clone(),
            format: self.format,
            hrules: self.hrules,
            vrules: self.vrules,
            padding_width: self.padding_width,
            left_padding_width: self.left_padding_width,
            right_padding_width: self.right_padding_width,
            vertical_char: self.vertical_char.clone(),
            horizontal_char: self.horizontal_char.clone(),
            junction_char: self.junction_char.clone(),
            junctions: js,
            xhtml: self.xhtml,
            print_empty: self.print_empty,
            oldsortslice: self.oldsortslice,
            escape_header: self.escape_header,
            escape_data: self.escape_data,
            break_on_hyphens: self.break_on_hyphens,
            extra: Vec.new(),
        };
        for name in option_names().iter() {
            if let Some(v) = kw_get(kw, name) {
                self.validate(w, name, v)?;
                o.apply(name, v);
            }
        }
        for (k, v) in kw.iter() {
            if not is_option(k) {
                o.extra.push((k.clone(), v.clone()));
            }
        }
        Ok(o)
    }
}

fn validate_none_format(j: ref J) -> Result[(), String] {
    match j {
        J.Null => Ok(()),
        J.S(_) => Ok(()),
        _ => Err(type_err("Replacement for None value must be a string if being supplied.")),
    }
}

fn validate_header_style(j: ref J) -> Result[(), String] {
    let ok = match j {
        J.Null => true,
        J.S(s) => s == "cap" or s == "title" or s == "upper" or s == "lower",
        _ => false,
    };
    if ok {
        Ok(())
    } else {
        Err(value_err("Invalid header style, use cap, title, upper, lower or None"))
    }
}

fn validate_align(j: ref J) -> Result[(), String] {
    if let J.S(s) = j {
        if s == "l" or s == "c" or s == "r" {
            return Ok(());
        }
    }
    Err(value_err(f"Alignment {j_text(j)} is invalid, use l, c or r"))
}

fn validate_valign(j: ref J) -> Result[(), String] {
    if let J.S(s) = j {
        if s == "t" or s == "m" or s == "b" {
            return Ok(());
        }
    }
    Err(value_err(f"Alignment {j_text(j)} is invalid, use t, m, b"))
}

fn all_digits(s: ref String) -> bool {
    if s.len() == 0 {
        return false;
    }
    for c in s.chars() {
        if not is_digit(c) {
            return false;
        }
    }
    true
}

fn validate_int_format(name: Str, j: ref J) -> Result[(), String] {
    if let J.S(s) = j {
        if s.len() == 0 or all_digits(s) {
            return Ok(());
        }
    }
    Err(value_err(f"Invalid value for {name}. Must be an integer format string."))
}

fn validate_float_format(name: Str, j: ref J) -> Result[(), String] {
    let bad = value_err(f"Invalid value for {name}. Must be a float format string.");
    let s = match j {
        J.S(s) => s.clone(),
        _ => return Err(bad),
    };
    if s.len() == 0 {
        return Ok(());
    }
    if not s.contains(".") {
        return Err(bad);
    }
    let bits: Vec[String] = split_on_str(s, ".");
    if bits.len() > 2 {
        return Err(bad);
    }
    if not (bits[0].len() == 0 or all_digits(bits[0])) {
        return Err(bad);
    }
    let b1 = bits[1].clone();
    let ok1 = b1.len() == 0 or all_digits(b1) or (b1.ends_with("f") and all_digits(rstrip_f(b1)));
    if not ok1 {
        return Err(bad);
    }
    Ok(())
}

fn rstrip_f(s: ref String) -> String {
    let mut cs = chars(s);
    while cs.len() > 0 and cs[cs.len() - 1] == 'f' {
        cs.pop();
    }
    text(cs)
}

fn split_on_str(s: ref String, sep: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for p in s.split(sep) {
        out.push(p.to_string());
    }
    out
}

fn validate_single_char(w: ref Widths, name: Str, j: ref J) -> Result[(), String] {
    let s = match j {
        J.S(s) => s.clone(),
        _ => return Err(type_err(f"expected string or bytes-like object, got '{type_name(v_of_j(j))}'")),
    };
    if block_width(w, s) != 1 {
        return Err(value_err(f"Invalid value for {name}. Must be a string of length 1."));
    }
    Ok(())
}

// ------------------------------------------------------------ plain text

fn py_floordiv(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

fn py_mod(a: i64, b: i64) -> i64 {
    let r = a % b;
    if r != 0 and ((r < 0) != (b < 0)) { r + b } else { r }
}

// _justify
fn justify(w: ref Widths, s: ref String, width: i64, align: ref String) -> String {
    let bw = block_width(w, s);
    let excess = width - bw;
    if align == "l" {
        return f"{s}{n_spaces(excess)}";
    }
    if align == "r" {
        return f"{n_spaces(excess)}{s}";
    }
    let half = py_floordiv(excess, 2);
    if py_mod(excess, 2) != 0 {
        if py_mod(bw, 2) != 0 {
            return f"{n_spaces(half)}{s}{n_spaces(half + 1)}";
        }
        return f"{n_spaces(half + 1)}{s}{n_spaces(half)}";
    }
    f"{n_spaces(half)}{s}{n_spaces(half)}"
}

fn clamp_index(k: i64, n: i64) -> i64 {
    let a = if k < 0 { k + n } else { k };
    if a < 0 { 0 } else if a > n { n } else { a }
}

fn py_slice_list(v: ref Vec[Vec[V]], start: i64, end: ref Option[i64]) -> Vec[Vec[V]] {
    let n = v.len();
    let lo = clamp_index(start, n);
    let hi = match end {
        Some(e) => clamp_index(*e, n),
        None => n,
    };
    let mut out: Vec[Vec[V]] = Vec.new();
    let mut k = lo;
    while k < hi {
        out.push(v[k].clone());
        k += 1;
    }
    out
}

fn py_slice_bools(v: ref Vec[bool], start: i64, end: ref Option[i64]) -> Vec[bool] {
    let n = v.len();
    let mut lo = if start < 0 { start + n } else { start };
    let mut hi = match end {
        Some(e) => if *e < 0 { *e + n } else { *e },
        None => n,
    };
    if lo < 0 {
        lo = 0;
    }
    if hi > n {
        hi = n;
    }
    let mut out: Vec[bool] = Vec.new();
    let mut k = lo;
    while k < hi {
        out.push(v[k]);
        k += 1;
    }
    out
}

impl Table {
    fn align_of(ref self, field: ref String) -> Result[String, String] {
        match self.align.get(field) {
            Some(a) => Ok(a),
            None => Err(key_err(field)),
        }
    }

    fn valign_of(ref self, field: ref String) -> Result[String, String] {
        match self.valign.get(field) {
            Some(a) => Ok(a),
            None => Err(key_err(field)),
        }
    }

    // _format_value
    fn format_value(ref self, field: ref String, value: ref V) -> Result[String, String] {
        let is_int = match value {
            V.I(_) => true,
            V.B(_) => true,
            _ => false,
        };
        let is_float = match value {
            V.F(_) => true,
            _ => false,
        };
        if is_int {
            if let Some(f) = self.int_format.get(field) {
                return printf_one(f"%{f}d", value);
            }
        } else if is_float {
            if let Some(f) = self.float_format.get(field) {
                return printf_one(f"%{f}f", value);
            }
        }
        match self.custom_format.get(field) {
            Some(name) => formatter(name, field, value),
            None => Ok(py_str(value)),
        }
    }

    fn format_rows(ref self, rows: ref Vec[Vec[V]]) -> Result[Vec[Vec[String]], String] {
        let mut out: Vec[Vec[String]] = Vec.new();
        for row in rows.iter() {
            let mut cells: Vec[String] = Vec.new();
            let n = if row.len() < self.field_names.len() { row.len() } else { self.field_names.len() };
            for i in 0..n {
                cells.push(self.format_value(self.field_names[i], row[i])?);
            }
            out.push(cells);
        }
        Ok(out)
    }

    // _get_rows
    fn get_rows(ref self, o: ref Opt) -> Result[Vec[Vec[V]], String] {
        let base = if o.oldsortslice {
            py_slice_list(self.rows, o.start, o.end)
        } else {
            self.rows.clone()
        };
        let mut rows: Vec[Vec[V]] = Vec.new();
        for r in base.iter() {
            if row_filter_ok(o.row_filter, r)? {
                rows.push(r.clone());
            }
        }
        if let Some(sortby) = o.sortby.clone() {
            if sortby.len() > 0 {
                let mut si = -1;
                for i in 0..self.field_names.len() {
                    if self.field_names[i] == sortby {
                        si = i;
                        break;
                    }
                }
                if si < 0 {
                    return Err(value_err(f"{repr_str(sortby)} is not in list"));
                }
                let mut dec: Vec[Vec[V]] = Vec.new();
                let mut keys: Vec[V] = Vec.new();
                for r in rows.iter() {
                    let mut d: Vec[V] = Vec.new();
                    d.push(r[si].clone());
                    for c in r.iter() {
                        d.push(c.clone());
                    }
                    keys.push(sort_key_of(o.sort_key, d)?);
                    dec.push(d);
                }
                let sorted = sort_by_keys(dec, keys, o.reversesort)?;
                rows = Vec.new();
                for d in sorted.iter() {
                    let mut r: Vec[V] = Vec.new();
                    for k in 1..d.len() {
                        r.push(d[k].clone());
                    }
                    rows.push(r);
                }
            }
        }
        if not o.oldsortslice {
            rows = py_slice_list(rows, o.start, o.end);
        }
        Ok(rows)
    }

    fn get_dividers(ref self, o: ref Opt) -> Vec[bool] {
        let mut d = if o.oldsortslice {
            py_slice_bools(self.dividers, o.start, o.end)
        } else {
            self.dividers.clone()
        };
        let sorted = match ref o.sortby {
            Some(s) => s.len() > 0,
            None => false,
        };
        if sorted {
            for i in 0..d.len() {
                d[i] = false;
            }
        }
        d
    }

    // _compute_table_width, with its FRAME case lost to the if that follows
    fn compute_table_width(ref self, o: ref Opt) -> i64 {
        let mut tw = if o.vrules == ALL { 1 } else { 0 };
        let (l, r) = o.pads();
        let pad = l + r;
        let fields_on = match ref o.fields {
            Some(f) => f.len() > 0,
            None => false,
        };
        for i in 0..self.field_names.len() {
            let f = self.field_names[i].clone();
            if not fields_on or not o.skips(f) {
                tw += self.widths[i] + pad + 1;
            }
        }
        tw
    }

    // _compute_widths
    fn compute_widths(mut ref self, w: ref Widths, rows: ref Vec[Vec[String]], o: ref Opt) -> Result[(), String] {
        let mut widths: Vec[i64] = Vec.new();
        for f in self.field_names.iter() {
            widths.push(if o.header and o.use_header_width { get_size(w, f).0 } else { 0 });
        }
        for row in rows.iter() {
            for index in 0..row.len() {
                let field = self.field_names[index].clone();
                let mut value = row[index].clone();
                if value == "None" {
                    if let Some(nv) = self.none_format.get(field) {
                        value = nv;
                    }
                }
                let size = get_size(w, value).0;
                match self.max_width.get(field) {
                    Some(m) => {
                        let s = if size < m { size } else { m };
                        if s > widths[index] {
                            widths[index] = s;
                        }
                    }
                    None => {
                        if size > widths[index] {
                            widths[index] = size;
                        }
                    }
                }
                if let Some(m) = self.min_width.get(field) {
                    if m > widths[index] {
                        widths[index] = m;
                    }
                }
                if self.style == Some(MARKDOWN) {
                    let a = self.align_of(field)?;
                    let least = if a == "l" or a == "r" { 1 } else { 3 };
                    if least > widths[index] {
                        widths[index] = least;
                    }
                }
            }
        }
        self.widths = widths.clone();
        let (l, r) = o.pads();
        let pad = l + r;
        if let Some(mtw) = self.max_table_width {
            if mtw != 0 {
                let tw = self.compute_table_width(o);
                if tw > mtw {
                    let markup = pad * widths.len() + widths.len() - 1;
                    let scale = ((mtw - markup) as f64) / ((tw - markup) as f64);
                    let mut scaled: Vec[i64] = Vec.new();
                    for x in widths.iter() {
                        let v = ((*x as f64) * scale) as i64;
                        scaled.push(if v > 1 { v } else { 1 });
                    }
                    self.widths = scaled;
                }
            }
        }
        let has_title = match ref o.title {
            Some(t) => t.len() > 0,
            None => false,
        };
        let min_tw = match ref self.min_table_width {
            Some(n) => n,
            None => 0,
        };
        if min_tw != 0 or has_title {
            let mut title_width = 0;
            if has_title {
                title_width = block_width(w, o.title.clone().unwrap_or(String.new())) + pad;
                if o.vrules == FRAME or o.vrules == ALL {
                    title_width += 2;
                }
            }
            let mut min_width = if title_width > min_tw { title_width } else { min_tw };
            let borders = if o.border {
                widths.len() + 1
            } else if o.preserve_internal_border {
                widths.len()
            } else {
                0
            };
            min_width -= pad * widths.len() + borders;
            let mut content = 0;
            for x in widths.iter() {
                content += *x;
            }
            if content == 0 {
                content = 1;
            }
            if content < min_width {
                let scale = (min_width as f64) / (content as f64);
                let mut grown: Vec[i64] = Vec.new();
                let mut total = 0;
                for x in widths.iter() {
                    let v = ((*x as f64) * scale) as i64;
                    grown.push(v);
                    total += v;
                }
                if total < min_width {
                    let n = grown.len();
                    if n == 0 {
                        return Err("IndexError: list index out of range".to_string());
                    }
                    grown[n - 1] += min_width - total;
                }
                self.widths = grown;
            }
        }
        Ok(())
    }

    // _stringify_hrule
    fn stringify_hrule(ref self, o: ref Opt, place: Str) -> Result[String, String] {
        if not o.border and not o.preserve_internal_border {
            return Ok(String.new());
        }
        let (lpad, rpad) = o.pads();
        let framed = o.vrules == ALL or o.vrules == FRAME;
        let mut bits: Vec[String] = Vec.new();
        bits.push(if framed { o.left_j(place) } else { o.horizontal_char.clone() });
        if self.field_names.len() == 0 {
            bits.push(o.right_j(place));
            return Ok(join_strs(bits, ""));
        }
        let n = if self.field_names.len() < self.widths.len() { self.field_names.len() } else { self.widths.len() };
        for i in 0..n {
            let field = self.field_names[i].clone();
            if o.skips(field) {
                continue;
            }
            let mut line = n_times(o.horizontal_char, self.widths[i] + lpad + rpad);
            if let Some(hac) = self.horizontal_align_char.clone() {
                if hac.len() > 0 {
                    let a = self.align_of(field)?;
                    if a == "l" or a == "c" {
                        line = f" {hac}{char_slice(line, 2, char_len(line) + 2)}";
                    }
                    if a == "c" or a == "r" {
                        line = f"{char_slice(line, 0, -2)}{hac} ";
                    }
                }
            }
            bits.push(line);
            bits.push(if o.vrules == ALL { o.mid_j(place) } else { o.horizontal_char.clone() });
        }
        if framed {
            bits.pop();
            bits.push(o.right_j(place));
        }
        if o.preserve_internal_border and not o.border {
            let mut inner: Vec[String] = Vec.new();
            for k in 1..(bits.len() - 1) {
                inner.push(bits[k].clone());
            }
            bits = inner;
        }
        Ok(join_strs(bits, ""))
    }

    // _stringify_title
    fn stringify_title(ref self, w: ref Widths, title: ref String, o: ref Opt) -> Result[String, String] {
        let mut lines: Vec[String] = Vec.new();
        let (lpad, rpad) = o.pads();
        if o.border {
            if o.vrules == ALL {
                let mut o2 = o.clone();
                o2.vrules = FRAME;
                lines.push(self.stringify_hrule(o2, "top_")?);
            } else if o.vrules == FRAME {
                lines.push(self.stringify_hrule(o, "top_")?);
            }
        }
        let endpoint = if (o.vrules == ALL or o.vrules == FRAME) and o.border {
            o.vertical_char.clone()
        } else {
            " ".to_string()
        };
        let padded = f"{n_spaces(lpad)}{title}{n_spaces(rpad)}";
        let mut sum = 0;
        for x in self.widths.iter() {
            sum += *x + lpad + rpad + 1;
        }
        lines.push(f"{endpoint}{justify(w, padded, sum - 1, "c".to_string())}{endpoint}");
        Ok(join_strs(lines, "\n"))
    }

    fn styled(ref self, field: ref String) -> String {
        match ref self.header_style {
            Some(s) => {
                if s == "cap" {
                    py_capitalize(field)
                } else if s == "title" {
                    py_title(field)
                } else if s == "upper" {
                    py_upper(field)
                } else if s == "lower" {
                    py_lower(field)
                } else {
                    field.clone()
                }
            }
            None => field.clone(),
        }
    }

    // left_junction_char + line[len(left):-len(right)] + right_junction_char
    fn rejoin(ref self, line: ref String) -> String {
        let left = self.junction(J_LEFT);
        let right = self.junction(J_RIGHT);
        f"{left}{char_slice(line, char_len(left), 0 - char_len(right))}{right}"
    }

    // _stringify_header
    fn stringify_header(ref self, w: ref Widths, o: ref Opt) -> Result[String, String] {
        let mut bits: Vec[String] = Vec.new();
        let (lpad, rpad) = o.pads();
        let framed = o.vrules == ALL or o.vrules == FRAME;
        if o.border {
            if o.hrules == ALL or o.hrules == FRAME {
                let mut top = self.stringify_hrule(o, "top_")?;
                let has_title = match ref o.title {
                    Some(t) => t.len() > 0,
                    None => false,
                };
                if has_title and framed {
                    top = self.rejoin(top);
                }
                bits.push(top);
                bits.push("\n".to_string());
            }
            bits.push(if framed { o.vertical_char.clone() } else { " ".to_string() });
        }
        if self.field_names.len() == 0 {
            bits.push(if framed { o.vertical_char.clone() } else { " ".to_string() });
        }
        let n = if self.field_names.len() < self.widths.len() { self.field_names.len() } else { self.widths.len() };
        for i in 0..n {
            let field = self.field_names[i].clone();
            let width = self.widths[i];
            if o.skips(field) {
                continue;
            }
            let mut name = self.styled(field);
            if block_width(w, name) > width {
                name = char_slice(name, 0, width);
            }
            bits.push(f"{n_spaces(lpad)}{justify(w, name, width, self.align_of(field)?)}{n_spaces(rpad)}");
            if o.border or o.preserve_internal_border {
                bits.push(if o.vrules == ALL { o.vertical_char.clone() } else { " ".to_string() });
            }
        }
        if not o.border and o.preserve_internal_border {
            bits.pop();
            bits.push(" ".to_string());
        }
        if o.border and o.vrules == FRAME {
            bits.pop();
            bits.push(o.vertical_char.clone());
        }
        if (o.border or o.preserve_internal_border) and o.hrules != NONE {
            bits.push("\n".to_string());
            bits.push(self.hrule.clone());
        }
        Ok(join_strs(bits, ""))
    }

    // _stringify_row
    fn stringify_row(ref self, w: ref Widths, row0: ref Vec[String], o: ref Opt, hrule: ref String) -> Result[String, String] {
        let mut row = row0.clone();
        let mut n = row.len();
        if self.field_names.len() < n {
            n = self.field_names.len();
        }
        if self.widths.len() < n {
            n = self.widths.len();
        }
        for index in 0..n {
            let field = self.field_names[index].clone();
            let width = self.widths[index];
            let mut new_lines: Vec[String] = Vec.new();
            for line0 in split_nl(row[index]).iter() {
                let mut line = line0.clone();
                if line == "None" {
                    if let Some(nv) = self.none_format.get(field) {
                        line = nv;
                    }
                }
                if block_width(w, line) > width {
                    let mut tw = Wrapper.new(width);
                    tw.break_on_hyphens = o.break_on_hyphens;
                    line = match tw.fill(chars(line)) {
                        Ok(cs) => text(cs),
                        Err(e) => return Err(value_err(e)),
                    };
                }
                new_lines.push(line);
            }
            row[index] = join_strs(new_lines, "\n");
        }
        let mut row_height = 0;
        for c in row.iter() {
            let h = get_size(w, c).1;
            if h > row_height {
                row_height = h;
            }
        }
        let (lpad, rpad) = o.pads();
        let mut bits: Vec[Vec[String]] = Vec.new();
        for _ in 0..row_height {
            let mut b: Vec[String] = Vec.new();
            if o.border {
                b.push(if o.vrules == ALL or o.vrules == FRAME { self.vertical_char.clone() } else { " ".to_string() });
            }
            bits.push(b);
        }
        for i in 0..n {
            let field = self.field_names[i].clone();
            let width = self.widths[i];
            let valign = self.valign_of(field)?;
            let mut lines = split_nl(row[i]);
            let d = row_height - lines.len();
            if d != 0 {
                let mut padded: Vec[String] = Vec.new();
                if valign == "m" {
                    let top = d / 2;
                    for _ in 0..top {
                        padded.push(String.new());
                    }
                    for l in lines.iter() {
                        padded.push(l.clone());
                    }
                    for _ in 0..(d - top) {
                        padded.push(String.new());
                    }
                } else if valign == "b" {
                    for _ in 0..d {
                        padded.push(String.new());
                    }
                    for l in lines.iter() {
                        padded.push(l.clone());
                    }
                } else {
                    for l in lines.iter() {
                        padded.push(l.clone());
                    }
                    for _ in 0..d {
                        padded.push(String.new());
                    }
                }
                lines = padded;
            }
            for y in 0..lines.len() {
                if o.skips(field) {
                    continue;
                }
                let cell = f"{n_spaces(lpad)}{justify(w, lines[y], width, self.align_of(field)?)}{n_spaces(rpad)}";
                bits[y].push(cell);
                if o.border or o.preserve_internal_border {
                    bits[y].push(if o.vrules == ALL { self.vertical_char.clone() } else { " ".to_string() });
                }
            }
        }
        if not o.border and o.preserve_internal_border {
            let last = bits.len() - 1;
            bits[last].pop();
            bits[last].push(" ".to_string());
        }
        for y in 0..row_height {
            if o.border and o.vrules == FRAME {
                bits[y].pop();
                bits[y].push(o.vertical_char.clone());
            }
        }
        if o.border and o.hrules == ALL {
            bits[row_height - 1].push("\n".to_string());
            bits[row_height - 1].push(hrule.clone());
        }
        let mut out: Vec[String] = Vec.new();
        for b in bits.iter() {
            out.push(join_strs(b, ""));
        }
        Ok(join_strs(out, "\n"))
    }

    // get_string
    fn get_string(mut ref self, w: ref Widths, kw: ref Vec[(String, J)]) -> Result[String, String] {
        let o = self.options(w, kw)?;
        if self.rows.len() == 0 and (not o.print_empty or not o.border) {
            return Ok(String.new());
        }
        let rows = self.get_rows(o)?;
        let dividers = self.get_dividers(o);
        let formatted = self.format_rows(rows)?;
        self.compute_widths(w, formatted, o)?;
        self.hrule = self.stringify_hrule(o, "")?;
        let title = match ref o.title {
            Some(t) => if t.len() > 0 { Some(t.clone()) } else { self.title.clone() },
            None => self.title.clone(),
        };
        let has_title = match ref title {
            Some(t) => t.len() > 0,
            None => false,
        };
        let mut lines: Vec[String] = Vec.new();
        if has_title {
            lines.push(self.stringify_title(w, title.clone().unwrap_or(String.new()), o)?);
        }
        if o.header {
            lines.push(self.stringify_header(w, o)?);
        } else if o.border and (o.hrules == ALL or o.hrules == FRAME) {
            let mut top = self.stringify_hrule(o, "top_")?;
            if has_title and (o.vrules == ALL or o.vrules == FRAME) {
                top = self.rejoin(top);
            }
            lines.push(top);
        }
        let nf = formatted.len();
        if nf > 0 {
            let mut k = 0;
            while k + 1 < nf and k + 1 < dividers.len() {
                lines.push(self.stringify_row(w, formatted[k], o, self.hrule)?);
                if dividers[k] {
                    lines.push(self.stringify_hrule(o, "")?);
                }
                k += 1;
            }
            let bottom = self.stringify_hrule(o, "bottom_")?;
            lines.push(self.stringify_row(w, formatted[nf - 1], o, bottom)?);
        }
        if o.border and o.hrules == FRAME {
            lines.push(self.stringify_hrule(o, "bottom_")?);
        }
        if self.orgmode {
            let ll = char_len(self.junction(J_LEFT));
            let rl = char_len(self.junction(J_RIGHT));
            let mut org: Vec[String] = Vec.new();
            for old in lines.iter() {
                for nl in split_nl(old).iter() {
                    org.push(f"|{char_slice(nl, ll, 0 - rl)}|");
                }
            }
            lines = org;
        }
        Ok(join_strs(lines, "\n"))
    }

    // what str(t) and the text format print: ColorTable adds RESET_CODE
    fn text_of(mut ref self, w: ref Widths, kw: ref Vec[(String, J)]) -> Result[String, String] {
        let s = self.get_string(w, kw)?;
        if self.color {
            Ok(f"{s}{RESET_CODE}")
        } else {
            Ok(s)
        }
    }

    fn paginate(mut ref self, w: ref Widths, page_length: i64, line_break: ref String, kw0: ref Vec[(String, J)]) -> Result[String, String] {
        let mut start = match kw_get(kw0, "start") {
            Some(j) => j_int(j)?,
            None => 0,
        };
        let true_end = match kw_get(kw0, "end") {
            Some(j) => j_int(j)?,
            None => self.rows.len(),
        };
        let mut pages: Vec[String] = Vec.new();
        loop {
            let end = if start + page_length < true_end { start + page_length } else { true_end };
            let mut kw: Vec[(String, J)] = Vec.new();
            for (k, v) in kw0.iter() {
                if k != "start" and k != "end" {
                    kw.push((k.clone(), v.clone()));
                }
            }
            kw.push(("start".to_string(), J.N(f"{start}")));
            kw.push(("end".to_string(), J.N(f"{end}")));
            pages.push(self.text_of(w, kw)?);
            if end == true_end {
                break;
            }
            start += page_length;
        }
        Ok(join_strs(pages, line_break))
    }
}

// ------------------------------------------------------------ CSV

fn csv_cell(v: ref V) -> Cell {
    match v {
        V.S(s) => Cell.Text(s.clone()),
        V.I(_) => Cell.Num(py_str(v)),
        V.F(_) => Cell.Num(py_str(v)),
        V.B(_) => Cell.Num(py_str(v)),
        V.N => Cell.Null,
        V.L(_) => Cell.Text(py_str(v)),
    }
}

// csv.writer(buf, **csv_options): the excel dialect with the options laid over it.
fn csv_dialect(extra: ref Vec[(String, J)]) -> Result[Dialect, String] {
    let mut d = cv_excel();
    for (k, v) in extra.iter() {
        let n: Str = k.as_str();
        if n == "delimiter" or n == "quotechar" or n == "escapechar" {
            let s = j_text(v);
            let cs = chars(s);
            if cs.len() != 1 {
                return Err(type_err(f"\"{n}\" must be a 1-character string"));
            }
            let c = cs[0] as i64;
            if n == "delimiter" {
                d.delimiter = c;
            } else if n == "quotechar" {
                d.quotechar = c;
            } else {
                d.escapechar = c;
            }
        } else if n == "quoting" {
            d.quoting = j_int(v)?;
        } else if n == "lineterminator" {
            d.lineterminator = j_text(v);
        } else if n == "doublequote" {
            d.doublequote = j_truthy(v);
        } else if n == "skipinitialspace" {
            d.skipinitialspace = j_truthy(v);
        } else if n == "strict" {
            d.strict = j_truthy(v);
        } else {
            return Err(type_err(f"'{n}' is an invalid keyword argument for this function"));
        }
    }
    Ok(d)
}

fn wanted_fields(names: ref Vec[String], fields: ref Option[Vec[String]]) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for f in names.iter() {
        if not opt_fields_skip(fields, f) {
            out.push(f.clone());
        }
    }
    out
}

// ------------------------------------------------------------ JSON

fn json_quote(s: ref String) -> String {
    let mut out = String.new();
    out.push('"');
    for c in s.chars() {
        let o = c as i64;
        if c == '"' {
            out.push_str("\\\"");
        } else if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if o == 8 {
            out.push_str("\\b");
        } else if o == 12 {
            out.push_str("\\f");
        } else if o < 0x20 or (o > 0x7f and o < 0x10000) {
            out.push_str(f"\\u{hex_digits(o, 4)}");
        } else if o >= 0x10000 {
            let v = o - 0x10000;
            out.push_str(f"\\u{hex_digits(0xd800 + (v >> 10), 4)}\\u{hex_digits(0xdc00 + (v & 0x3ff), 4)}");
        } else {
            out.push(c);
        }
    }
    out.push('"');
    out
}

// json.dumps's options
struct JsonOpts {
    indent: Option[i64],
    item_sep: String,
    key_sep: String,
    sort_keys: bool,
}

// An element of the list get_json_string dumps: the header or a row.
enum JOut {
    Val(V),
    Dict(Vec[(String, V)]),
}

fn json_newline(jo: ref JsonOpts, level: i64) -> String {
    match jo.indent {
        Some(n) => f"\n{n_spaces(n * level)}",
        None => String.new(),
    }
}

fn json_seq(parts: ref Vec[String], open: Str, close: Str, jo: ref JsonOpts, level: i64) -> String {
    if parts.len() == 0 {
        return f"{open}{close}";
    }
    let mut out = open.to_string();
    let inner = json_newline(jo, level + 1);
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(jo.item_sep);
        }
        out.push_str(inner);
        out.push_str(parts[i]);
    }
    out.push_str(json_newline(jo, level));
    out.push_str(close);
    out
}

fn json_value(v: ref V, jo: ref JsonOpts, level: i64) -> String {
    match v {
        V.S(s) => json_quote(s),
        V.I(n) => f"{n}",
        V.F(_) => py_str(v),
        V.B(b) => if *b { "true".to_string() } else { "false".to_string() },
        V.N => "null".to_string(),
        V.L(items) => {
            let mut parts: Vec[String] = Vec.new();
            for it in items.iter() {
                parts.push(json_value(it, jo, level + 1));
            }
            json_seq(parts, "[", "]", jo, level)
        }
    }
}

fn json_dict(d: ref Vec[(String, V)], jo: ref JsonOpts, level: i64) -> String {
    let mut items = d.clone();
    if jo.sort_keys {
        // insertion sort by key, stable like sorted()
        let mut k = 1;
        while k < items.len() {
            let mut m = k;
            while m > 0 and items[m].0 < items[m - 1].0 {
                let t = items[m].clone();
                items[m] = items[m - 1].clone();
                items[m - 1] = t;
                m -= 1;
            }
            k += 1;
        }
    }
    let mut parts: Vec[String] = Vec.new();
    for (k, v) in items.iter() {
        parts.push(f"{json_quote(k)}{jo.key_sep}{json_value(v, jo, level + 1)}");
    }
    json_seq(parts, "{", "}", jo, level)
}

fn json_opts(extra: ref Vec[(String, J)]) -> Result[JsonOpts, String] {
    let mut jo = JsonOpts {
        indent: Some(4),
        item_sep: ",".to_string(),
        key_sep: ": ".to_string(),
        sort_keys: true,
    };
    for (k, v) in extra.iter() {
        let n: Str = k.as_str();
        if n == "indent" {
            jo.indent = opt_int(v);
        } else if n == "separators" {
            let parts = j_strs(v);
            jo.item_sep = parts[0].clone();
            jo.key_sep = parts[1].clone();
        } else if n == "sort_keys" {
            jo.sort_keys = j_truthy(v);
        } else {
            return Err(type_err(f"JSONEncoder.__init__() got an unexpected keyword argument '{n}'"));
        }
    }
    Ok(jo)
}

// ------------------------------------------------------------ the exports

impl Table {
    fn get_csv_string(ref self, w: ref Widths, kw: ref Vec[(String, J)]) -> Result[String, String] {
        let o = self.options(w, kw)?;
        let mut wr = cv_new_writer(csv_dialect(o.extra)?).map_err(|e| type_err(e))?;
        let mut out = String.new();
        let fields_on = match ref o.fields {
            Some(f) => f.len() > 0,
            None => false,
        };
        if o.header {
            let names = if fields_on { wanted_fields(self.field_names, o.fields) } else { self.field_names.clone() };
            let mut cells: Vec[Cell] = Vec.new();
            for n in names.iter() {
                cells.push(Cell.Text(n.clone()));
            }
            out.push_str(wr.row(cells).map_err(|e| f"Error: {e}")?);
        }
        let rows = self.get_rows(o)?;
        for row in rows.iter() {
            let mut cells: Vec[Cell] = Vec.new();
            for i in 0..row.len() {
                if i < self.field_names.len() and fields_on and o.skips(self.field_names[i]) {
                    continue;
                }
                if fields_on and i >= self.field_names.len() {
                    continue;
                }
                cells.push(csv_cell(row[i]));
            }
            out.push_str(wr.row(cells).map_err(|e| f"Error: {e}")?);
        }
        Ok(out)
    }

    fn get_json_string(ref self, w: ref Widths, kw: ref Vec[(String, J)]) -> Result[String, String] {
        let o = self.options(w, kw)?;
        let jo = json_opts(o.extra)?;
        let fields_on = match ref o.fields {
            Some(f) => f.len() > 0,
            None => false,
        };
        let mut objects: Vec[JOut] = Vec.new();
        if o.header {
            let names = if fields_on { wanted_fields(self.field_names, o.fields) } else { self.field_names.clone() };
            let mut vs: Vec[V] = Vec.new();
            for n in names.iter() {
                vs.push(V.S(n.clone()));
            }
            objects.push(JOut.Val(V.L(vs)));
        }
        let rows = self.get_rows(o)?;
        for row in rows.iter() {
            let mut d: Vec[(String, V)] = Vec.new();
            let n = if row.len() < self.field_names.len() { row.len() } else { self.field_names.len() };
            for i in 0..n {
                let f = self.field_names[i].clone();
                if fields_on and o.skips(f) {
                    continue;
                }
                // a dict: a repeated key keeps its first place and the last value
                let mut found = false;
                for k in 0..d.len() {
                    if d[k].0 == f {
                        d[k].1 = row[i].clone();
                        found = true;
                    }
                }
                if not found {
                    d.push((f, row[i].clone()));
                }
            }
            objects.push(JOut.Dict(d));
        }
        let mut parts: Vec[String] = Vec.new();
        for ob in objects.iter() {
            parts.push(match ob {
                JOut.Val(v) => json_value(v, jo, 1),
                JOut.Dict(d) => json_dict(d, jo, 1),
            });
        }
        Ok(json_seq(parts, "[", "]", jo, 0))
    }

    fn get_html_string(ref self, w: ref Widths, kw: ref Vec[(String, J)]) -> Result[String, String] {
        let o = self.options(w, kw)?;
        if o.format {
            self.formatted_html(o)
        } else {
            self.simple_html(o)
        }
    }

    fn html_open(ref self, o: ref Opt, framing: Str) -> String {
        let mut tag = "<table".to_string();
        tag.push_str(framing);
        for (k, v) in o.attributes.iter() {
            tag.push_str(f" {hp_escape(k, true)}=\"{hp_escape(v, true)}\"");
        }
        tag.push('>');
        tag
    }

    fn simple_html(ref self, o: ref Opt) -> Result[String, String] {
        let br = if o.xhtml { "<br/>" } else { "<br>" };
        let mut lines: Vec[String] = Vec.new();
        lines.push(self.html_open(o, ""));
        let title = match ref o.title {
            Some(t) => if t.len() > 0 { Some(t.clone()) } else { self.title.clone() },
            None => self.title.clone(),
        };
        if let Some(t) = title {
            if t.len() > 0 {
                lines.push(f"    <caption>{hp_escape(t, true)}</caption>");
            }
        }
        if o.header {
            lines.push("    <thead>".to_string());
            lines.push("        <tr>".to_string());
            for f in self.field_names.iter() {
                if o.skips(f) {
                    continue;
                }
                let s = if o.escape_header { hp_escape(f, true) } else { f.clone() };
                lines.push(f"            <th>{s.replace("\n", br)}</th>");
            }
            lines.push("        </tr>".to_string());
            lines.push("    </thead>".to_string());
        }
        lines.push("    <tbody>".to_string());
        let rows = self.get_rows(o)?;
        let formatted = self.format_rows(rows)?;
        for row in formatted.iter() {
            lines.push("        <tr>".to_string());
            for i in 0..row.len() {
                let f = self.field_names[i].clone();
                if o.skips(f) {
                    continue;
                }
                let s = if o.escape_data { hp_escape(row[i], true) } else { row[i].clone() };
                lines.push(f"            <td>{s.replace("\n", br)}</td>");
            }
            lines.push("        </tr>".to_string());
        }
        lines.push("    </tbody>".to_string());
        lines.push("</table>".to_string());
        Ok(join_strs(lines, "\n"))
    }

    fn formatted_html(ref self, o: ref Opt) -> Result[String, String] {
        let (lpad, rpad) = o.pads();
        let br = if o.xhtml { "<br/>" } else { "<br>" };
        let mut framing = String.new();
        if o.border {
            let fr: Str = if o.hrules == ALL and o.vrules == ALL {
                " frame=\"box\" rules=\"all\""
            } else if o.hrules == FRAME and o.vrules == FRAME {
                " frame=\"box\""
            } else if o.hrules == FRAME and o.vrules == ALL {
                " frame=\"box\" rules=\"cols\""
            } else if o.hrules == FRAME {
                " frame=\"hsides\""
            } else if o.hrules == ALL {
                " frame=\"hsides\" rules=\"rows\""
            } else if o.vrules == FRAME {
                " frame=\"vsides\""
            } else if o.vrules == ALL {
                " frame=\"vsides\" rules=\"cols\""
            } else {
                ""
            };
            framing = fr.to_string();
        }
        if not o.border and o.preserve_internal_border {
            framing.push_str(" rules=\"cols\"");
        }
        let mut lines: Vec[String] = Vec.new();
        lines.push(self.html_open(o, framing));
        let title = match ref o.title {
            Some(t) => if t.len() > 0 { Some(t.clone()) } else { self.title.clone() },
            None => self.title.clone(),
        };
        if let Some(t) = title {
            if t.len() > 0 {
                lines.push(f"    <caption>{hp_escape(t, true)}</caption>");
            }
        }
        if o.header {
            lines.push("    <thead>".to_string());
            lines.push("        <tr>".to_string());
            for f in self.field_names.iter() {
                if o.skips(f) {
                    continue;
                }
                let s = if o.escape_header { hp_escape(f, true) } else { f.clone() };
                let content = s.replace("\n", br);
                lines.push(f"            <th style=\"padding-left: {lpad}em; padding-right: {rpad}em; text-align: center\">{content}</th>");
            }
            lines.push("        </tr>".to_string());
            lines.push("    </thead>".to_string());
        }
        lines.push("    <tbody>".to_string());
        let rows = self.get_rows(o)?;
        let formatted = self.format_rows(rows)?;
        let mut aligns: Vec[String] = Vec.new();
        let mut valigns: Vec[String] = Vec.new();
        for f in self.field_names.iter() {
            let a = self.align_of(f)?;
            aligns.push(if a == "l" {
                "left".to_string()
            } else if a == "r" {
                "right".to_string()
            } else if a == "c" {
                "center".to_string()
            } else {
                return Err(key_err(a));
            });
            let v = self.valign_of(f)?;
            valigns.push(if v == "t" {
                "top".to_string()
            } else if v == "m" {
                "middle".to_string()
            } else if v == "b" {
                "bottom".to_string()
            } else {
                return Err(key_err(v));
            });
        }
        for row in formatted.iter() {
            lines.push("        <tr>".to_string());
            for i in 0..row.len() {
                let f = self.field_names[i].clone();
                if o.skips(f) {
                    continue;
                }
                let s = if o.escape_data { hp_escape(row[i], true) } else { row[i].clone() };
                let content = s.replace("\n", br);
                lines.push(f"            <td style=\"padding-left: {lpad}em; padding-right: {rpad}em; text-align: {aligns[i]}; vertical-align: {valigns[i]}\">{content}</td>");
            }
            lines.push("        </tr>".to_string());
        }
        lines.push("    </tbody>".to_string());
        lines.push("</table>".to_string());
        Ok(join_strs(lines, "\n"))
    }

    fn get_latex_string(ref self, w: ref Widths, kw: ref Vec[(String, J)]) -> Result[String, String] {
        let o = self.options(w, kw)?;
        let fields_on = match ref o.fields {
            Some(f) => f.len() > 0,
            None => false,
        };
        let wanted = if fields_on { wanted_fields(self.field_names, o.fields) } else { self.field_names.clone() };
        let mut al: Vec[String] = Vec.new();
        for f in wanted.iter() {
            al.push(self.align_of(f)?);
        }
        let mut lines: Vec[String] = Vec.new();
        if o.format {
            let mut a = if (o.border and o.vrules == ALL) or (not o.border and o.preserve_internal_border) {
                join_strs(al, "|")
            } else {
                join_strs(al, "")
            };
            if o.border and (o.vrules == ALL or o.vrules == FRAME) {
                a = f"|{a}|";
            }
            lines.push(f"\\begin{{tabular}}{{{a}}}");
            if o.border and (o.hrules == ALL or o.hrules == FRAME) {
                lines.push("\\hline".to_string());
            }
            if o.header {
                lines.push(f"{join_strs(wanted, " & ")} \\\\");
            }
            if (o.border or o.preserve_internal_border) and (o.hrules == ALL or o.hrules == HEADER) {
                lines.push("\\hline".to_string());
            }
        } else {
            lines.push(f"\\begin{{tabular}}{{{join_strs(al, "")}}}");
            if o.header {
                lines.push(f"{join_strs(wanted, " & ")} \\\\");
            }
        }
        let rows = self.get_rows(o)?;
        let formatted = self.format_rows(rows)?;
        for row in formatted.iter() {
            let mut data: Vec[String] = Vec.new();
            for i in 0..row.len() {
                if strs_contain(wanted, self.field_names[i]) {
                    data.push(row[i].clone());
                }
            }
            lines.push(f"{join_strs(data, " & ")} \\\\");
            if o.format and o.border and o.hrules == ALL {
                lines.push("\\hline".to_string());
            }
        }
        if o.format and o.border and o.hrules == FRAME {
            lines.push("\\hline".to_string());
        }
        lines.push("\\end{tabular}".to_string());
        Ok(join_strs(lines, "\r\n"))
    }

    fn get_mediawiki_string(ref self, w: ref Widths, kw: ref Vec[(String, J)]) -> Result[String, String] {
        let o = self.options(w, kw)?;
        let mut lines: Vec[String] = Vec.new();
        if o.attributes.len() > 0 {
            let mut parts: Vec[String] = Vec.new();
            for (k, v) in o.attributes.iter() {
                parts.push(f"{k}=\"{v}\"");
            }
            lines.push(f"{{| {join_strs(parts, " ")}");
        } else {
            lines.push("{| class=\"wikitable\"".to_string());
        }
        if let Some(c) = o.title.clone() {
            if c.len() > 0 {
                lines.push(f"|+ {c}");
            }
        }
        if o.header {
            lines.push("|-".to_string());
            let mut headers: Vec[String] = Vec.new();
            for f in self.field_names.iter() {
                if field_wanted(o.fields, f) {
                    headers.push(f.clone());
                }
            }
            if headers.len() > 0 {
                lines.push(f"! {join_strs(headers, " !! ")}");
            }
        }
        let rows = self.get_rows(o)?;
        let formatted = self.format_rows(rows)?;
        for row in formatted.iter() {
            lines.push("|-".to_string());
            let mut cells: Vec[String] = Vec.new();
            for i in 0..row.len() {
                if field_wanted(o.fields, self.field_names[i]) {
                    cells.push(row[i].clone());
                }
            }
            if cells.len() > 0 {
                lines.push(f"| {join_strs(cells, " || ")}");
            }
        }
        lines.push("|}".to_string());
        Ok(join_strs(lines, "\n"))
    }

    fn get_formatted_string(mut ref self, w: ref Widths, out: ref String, kw: ref Vec[(String, J)]) -> Result[String, String] {
        let n: Str = out.as_str();
        if n == "text" {
            return self.text_of(w, kw);
        }
        if n == "html" {
            return self.get_html_string(w, kw);
        }
        if n == "json" {
            return self.get_json_string(w, kw);
        }
        if n == "csv" {
            return self.get_csv_string(w, kw);
        }
        if n == "latex" {
            return self.get_latex_string(w, kw);
        }
        if n == "mediawiki" {
            return self.get_mediawiki_string(w, kw);
        }
        Err(value_err(f"Invalid format {n}. Must be one of: text, html, json, csv, latex or mediawiki"))
    }
}

// mediawiki's filter: `fields is not None and field not in fields` skips
fn field_wanted(fields: ref Option[Vec[String]], f: ref String) -> bool {
    match fields {
        Some(fs) => strs_contain(fs, f),
        None => true,
    }
}

// ------------------------------------------------------------ table factories

// A file read in text mode: "\r\n" and "\r" become "\n".
fn universal_newlines(s: ref String) -> String {
    let cs = chars(s);
    let mut out = String.new();
    let mut i = 0;
    while i < cs.len() {
        if cs[i] == '\r' {
            out.push('\n');
            if i + 1 < cs.len() and cs[i + 1] == '\n' {
                i += 1;
            }
        } else {
            out.push(cs[i]);
        }
        i += 1;
    }
    out
}

fn strip_all(v: ref Vec[String]) -> Vec[J] {
    let mut out: Vec[J] = Vec.new();
    for s in v.iter() {
        out.push(J.S(py_strip(s)));
    }
    out
}

fn strip_cells(v: ref Vec[String]) -> Vec[V] {
    let mut out: Vec[V] = Vec.new();
    for s in v.iter() {
        out.push(V.S(py_strip(s)));
    }
    out
}

fn from_csv(w: ref Widths, raw: ref String, field_names: ref Option[J], kw0: ref Vec[(String, J)]) -> Result[Table, String] {
    let params = ["delimiter", "doublequote", "escapechar", "lineterminator", "quotechar", "quoting", "skipinitialspace", "strict"];
    let mut fmt: Vec[(String, J)] = Vec.new();
    let mut kw: Vec[(String, J)] = Vec.new();
    for (k, v) in kw0.iter() {
        let mut is_param = false;
        for p in params.iter() {
            if *k == *p {
                is_param = true;
            }
        }
        if is_param {
            fmt.push((k.clone(), v.clone()));
        } else {
            kw.push((k.clone(), v.clone()));
        }
    }
    let text = universal_newlines(raw);
    let dialect = if fmt.len() > 0 {
        csv_dialect(fmt)?
    } else {
        let sample = char_slice(text, 0, 1024);
        cv_sniff(sample).map_err(|e| f"Error: {e}")?
    };
    let mut reader = cv_new_reader(text, dialect, true, 131072).map_err(|e| type_err(e))?;
    let mut table = new_table(w, false, None, kw)?;
    let given = match field_names {
        Some(j) => j_truthy(j),
        None => false,
    };
    if given {
        table.set_field_names(w, field_names.clone().unwrap_or(J.Null))?;
    } else {
        match reader.next_strings().map_err(|e| f"Error: {e}")? {
            Some(names) => table.set_field_names(w, J.A(strip_all(names)))?,
            None => return Err("StopIteration: ".to_string()),
        }
    }
    loop {
        match reader.next_strings().map_err(|e| f"Error: {e}")? {
            Some(row) => table.add_row(w, strip_cells(row), false)?,
            None => break,
        }
    }
    Ok(table)
}

fn from_json(w: ref Widths, text: ref String, kw: ref Vec[(String, J)]) -> Result[Table, String] {
    let mut table = new_table(w, false, None, kw)?;
    let objects = match aj_json_line(text) {
        Ok(J.A(items)) => items,
        Ok(_) => return Err(type_err("the JSON is not a list")),
        Err(e) => return Err(f"JSONDecodeError: {e}"),
    };
    if objects.len() == 0 {
        return Err("IndexError: list index out of range".to_string());
    }
    table.set_field_names(w, objects[0])?;
    let names = table.field_names.clone();
    for k in 1..objects.len() {
        let mut row: Vec[V] = Vec.new();
        for key in names.iter() {
            if not aj_j_present(objects[k], key) {
                return Err(key_err(key));
            }
            row.push(v_of_j(aj_j_get(objects[k], key)));
        }
        table.add_row(w, row, false)?;
    }
    Ok(table)
}

// TableHandler: the HTMLParser that turns each <table> into a table.
struct TableHandler {
    kwargs: Vec[(String, J)],
    tables: Vec[Table],
    last_row: Vec[String],
    rows: Vec[(Vec[String], bool)],
    max_row_width: i64,
    last_content: String,
    is_last_row_header: bool,
    colspan: i64,
}

impl TableHandler {
    fn start(mut ref self, tag: ref String, attrs: ref Vec[Attr]) -> Result[(), String] {
        if tag == "th" {
            self.is_last_row_header = true;
        }
        for a in attrs.iter() {
            if a.name == "colspan" {
                self.colspan = match a.value {
                    Some(v) => j_int(J.S(v.clone()))?,
                    None => return Err(type_err("int() argument must be a string, a bytes-like object or a real number, not 'NoneType'")),
                };
            }
        }
        Ok(())
    }

    fn end(mut ref self, w: ref Widths, tag: ref String) -> Result[(), String] {
        if tag == "th" or tag == "td" {
            self.last_row.push(py_strip(self.last_content));
            if self.colspan != 0 {
                for _ in 1..self.colspan {
                    self.last_row.push(String.new());
                }
                self.colspan = 0;
            }
        }
        if tag == "tr" {
            let row = self.last_row.clone();
            if row.len() > self.max_row_width {
                self.max_row_width = row.len();
            }
            self.rows.push((row, self.is_last_row_header));
            self.last_row = Vec.new();
            self.is_last_row_header = false;
        }
        if tag == "table" {
            let t = self.generate_table(w)?;
            self.tables.push(t);
            self.rows = Vec.new();
        }
        self.last_content = " ".to_string();
        Ok(())
    }

    fn generate_table(mut ref self, w: ref Widths) -> Result[Table, String] {
        let mut table = new_table(w, false, None, self.kwargs)?;
        for i in 0..self.rows.len() {
            let mut cells = self.rows[i].0.clone();
            if cells.len() < self.max_row_width {
                let appends = self.max_row_width - cells.len();
                for _ in 1..appends {
                    cells.push("-".to_string());
                }
            }
            self.rows[i].0 = cells.clone();
            if self.rows[i].1 {
                let mut k = 0;
                while k < cells.len() {
                    let mut m = k + 1;
                    while m < cells.len() {
                        if cells[k] == cells[m] {
                            cells[m] = f"{cells[m]}'";
                        }
                        m += 1;
                    }
                    k += 1;
                }
                let mut names: Vec[J] = Vec.new();
                for c in cells.iter() {
                    names.push(J.S(c.clone()));
                }
                table.set_field_names(w, J.A(names))?;
            } else {
                let mut row: Vec[V] = Vec.new();
                for c in cells.iter() {
                    row.push(V.S(c.clone()));
                }
                table.add_row(w, row, false)?;
            }
        }
        Ok(table)
    }
}

fn from_html(w: ref Widths, ents: ref Map[String, String], html: ref String, kw: ref Vec[(String, J)]) -> Result[Vec[Table], String] {
    let p = hp_parse_all(html, true, 0, ents);
    let mut h = TableHandler {
        kwargs: kw.clone(),
        tables: Vec.new(),
        last_row: Vec.new(),
        rows: Vec.new(),
        max_row_width: 0,
        last_content: String.new(),
        is_last_row_header: false,
        colspan: 0,
    };
    for e in p.events.iter() {
        match e.ev {
            Event.Start(tag, attrs) => h.start(tag, attrs)?,
            Event.StartEnd(tag, attrs) => {
                h.start(tag, attrs)?;
                h.end(w, tag)?;
            }
            Event.End(tag) => h.end(w, tag)?,
            Event.Data(s) => h.last_content.push_str(s),
            _ => {}
        }
    }
    Ok(h.tables)
}

fn from_mediawiki(w: ref Widths, wiki: ref String, kw: ref Vec[(String, J)]) -> Result[Table, String] {
    let lines = split_nl(py_strip(wiki));
    let mut table = new_table(w, false, None, kw)?;
    let mut header: Vec[String] = Vec.new();
    let mut rows: Vec[Vec[String]] = Vec.new();
    let mut inside = false;
    for line0 in lines.iter() {
        let line = py_strip(line0);
        if line.starts_with("{|") {
            inside = true;
            continue;
        }
        if line.starts_with("|}") {
            break;
        }
        if not inside {
            continue;
        }
        if line.starts_with("|-") or line.starts_with("|+") {
            continue;
        }
        if line.starts_with("!") {
            header = Vec.new();
            for c in split_on_str(char_slice(line, 1, char_len(line)), "!!").iter() {
                header.push(py_strip(c));
            }
            let mut names: Vec[J] = Vec.new();
            for c in header.iter() {
                names.push(J.S(c.clone()));
            }
            table.set_field_names(w, J.A(names))?;
            continue;
        }
        if line.starts_with("|") {
            let mut row: Vec[String] = Vec.new();
            for c in split_on_str(char_slice(line, 1, char_len(line)), "||").iter() {
                row.push(py_strip(c));
            }
            rows.push(row);
            continue;
        }
    }
    if header.len() == 0 {
        return Err(value_err("No valid header found in the MediaWiki table."));
    }
    for row in rows.iter() {
        if row.len() != header.len() {
            return Err(value_err("Row length mismatch between header and body."));
        }
        let mut cells: Vec[V] = Vec.new();
        for c in row.iter() {
            cells.push(V.S(c.clone()));
        }
        table.add_row(w, cells, false)?;
    }
    Ok(table)
}

// ------------------------------------------------------------ the jobs

// The values a job names: rule styles by name, attributes as pairs.
fn conv(name: ref String, j: ref J) -> J {
    if name == "hrules" or name == "vrules" {
        if let J.S(s) = j {
            let names = ["FRAME", "ALL", "NONE", "HEADER"];
            for i in 0..names.len() {
                if names[i] == *s {
                    return J.N(f"{i}");
                }
            }
        }
    }
    if name == "attributes" {
        if let J.A(items) = j {
            let mut m: Vec[(String, J)] = Vec.new();
            for it in items.iter() {
                if let J.A(pair) = it {
                    m.push((j_text(pair[0]), pair[1].clone()));
                }
            }
            return J.O(m);
        }
    }
    j.clone()
}

fn kwargs_of(op: ref J) -> Vec[(String, J)] {
    let mut out: Vec[(String, J)] = Vec.new();
    for (k, v) in j_members(aj_j_get(op, "kw")).iter() {
        out.push((k.clone(), conv(k, v)));
    }
    out
}

fn row_of(j: ref J) -> Vec[V] {
    match v_of_j(j) {
        V.L(items) => items,
        _ => Vec.new(),
    }
}

fn read_data(name: ref String) -> Result[String, String] {
    match fs.read_to_string(f"data/{name}") {
        Ok(t) => Ok(universal_newlines(t)),
        Err(e) => Err(f"FileNotFoundError: {e}"),
    }
}

fn visible(s: ref String) -> String {
    s.replace("\r", "\\r").replace("\u{c}", "\\f")
}

struct Tables {
    names: Vec[String],
    tabs: Vec[Table],
}

impl Tables {
    fn put(mut ref self, name: ref String, t: own Table) {
        for i in 0..self.names.len() {
            if self.names[i] == *name {
                self.tabs[i] = t;
                return;
            }
        }
        self.names.push(name.clone());
        self.tabs.push(t);
    }

    fn find(ref self, name: ref String) -> Result[i64, String] {
        for i in 0..self.names.len() {
            if self.names[i] == *name {
                return Ok(i);
            }
        }
        Err(key_err(name))
    }
}

fn op_int(op: ref J, key: Str) -> Option[i64] {
    if aj_j_present(op, key) {
        opt_int(aj_j_get(op, key))
    } else {
        None
    }
}

fn show(w: ref Widths, t: mut ref Table, op: ref J) -> Result[String, String] {
    let fmt = aj_j_str(op, "fmt");
    let kw = kwargs_of(op);
    if fmt == "str" {
        return t.text_of(w, Vec.new());
    }
    if fmt == "text" {
        return t.text_of(w, kw);
    }
    if fmt == "html" {
        return t.get_html_string(w, kw);
    }
    if fmt == "csv" {
        return t.get_csv_string(w, kw);
    }
    if fmt == "json" {
        return t.get_json_string(w, kw);
    }
    if fmt == "latex" {
        return t.get_latex_string(w, kw);
    }
    if fmt == "mediawiki" {
        return t.get_mediawiki_string(w, kw);
    }
    if fmt == "formatted" {
        return t.get_formatted_string(w, aj_j_str(op, "out"), kw);
    }
    if fmt == "paginate" {
        let pl = match op_int(op, "page_length") {
            Some(n) => n,
            None => 58,
        };
        let lb = if aj_j_present(op, "line_break") { aj_j_str(op, "line_break") } else { "\u{c}".to_string() };
        return t.paginate(w, pl, lb, kw);
    }
    Err(f"unknown format {fmt}")
}

fn run_op(w: ref Widths, ents: ref Map[String, String], tables: mut ref Tables, op: ref J) -> Result[Option[String], String] {
    let kind = aj_j_str(op, "op");
    let name = if aj_j_present(op, "t") { aj_j_str(op, "t") } else { "t".to_string() };
    if kind == "new" {
        let color = aj_j_str(op, "cls") == "ColorTable";
        let kw = kwargs_of(op);
        let names = if aj_j_present(op, "field_names") { Some(aj_j_get(op, "field_names")) } else { None };
        let t = new_table(w, color, names, kw)?;
        tables.put(name, t);
        return Ok(None);
    }
    if kind == "from_csv" {
        let names = if aj_j_present(op, "field_names") { Some(aj_j_get(op, "field_names")) } else { None };
        let text = read_data(aj_j_str(op, "file"))?;
        let t = from_csv(w, text, names, kwargs_of(op))?;
        tables.put(name, t);
        return Ok(None);
    }
    if kind == "from_json" {
        let text = if aj_j_present(op, "text") { aj_j_str(op, "text") } else { read_data(aj_j_str(op, "file"))? };
        let t = from_json(w, text, kwargs_of(op))?;
        tables.put(name, t);
        return Ok(None);
    }
    if kind == "from_html" {
        let found = from_html(w, ents, read_data(aj_j_str(op, "file"))?, kwargs_of(op))?;
        let n = found.len();
        let mut i = 0;
        for t in found.into_iter() {
            tables.put(f"{name}{i}", t);
            i += 1;
        }
        return Ok(Some(f"{n} tables"));
    }
    if kind == "from_html_one" {
        let found = from_html(w, ents, read_data(aj_j_str(op, "file"))?, kwargs_of(op))?;
        if found.len() != 1 {
            return Err(value_err("More than one <table> in provided HTML code. Use from_html instead."));
        }
        for t in found.into_iter() {
            tables.put(name, t);
        }
        return Ok(None);
    }
    if kind == "from_mediawiki" {
        let text = if aj_j_present(op, "text") { aj_j_str(op, "text") } else { read_data(aj_j_str(op, "file"))? };
        let t = from_mediawiki(w, text, kwargs_of(op))?;
        tables.put(name, t);
        return Ok(None);
    }
    let ti = tables.find(name)?;
    if kind == "set" {
        let attr = aj_j_str(op, "attr");
        let v = conv(attr, aj_j_get(op, "value"));
        tables.tabs[ti].set_attr(w, attr, v)?;
    } else if kind == "set_key" {
        let attr = aj_j_str(op, "attr");
        let v = conv(attr, aj_j_get(op, "value"));
        tables.tabs[ti].set_key(attr, aj_j_str(op, "key"), v)?;
    } else if kind == "theme" {
        let th = theme_named(aj_j_str(op, "name"))?;
        if tables.tabs[ti].color {
            tables.tabs[ti].set_theme(th);
        }
    } else if kind == "custom_theme" {
        let th = custom_theme(j_members(aj_j_get(op, "kw")));
        if tables.tabs[ti].color {
            tables.tabs[ti].set_theme(th);
        }
    } else if kind == "add_row" {
        tables.tabs[ti].add_row(w, row_of(aj_j_get(op, "row")), aj_j_bool(op, "divider"))?;
    } else if kind == "add_rows" {
        let mut rows: Vec[Vec[V]] = Vec.new();
        if let J.A(items) = aj_j_get(op, "rows") {
            for it in items.iter() {
                rows.push(row_of(it));
            }
        }
        tables.tabs[ti].add_rows(w, rows, aj_j_bool(op, "divider"))?;
    } else if kind == "add_column" {
        let align = if aj_j_present(op, "align") { aj_j_str(op, "align") } else { "c".to_string() };
        let valign = if aj_j_present(op, "valign") { aj_j_str(op, "valign") } else { "t".to_string() };
        tables.tabs[ti].add_column(aj_j_str(op, "name"), row_of(aj_j_get(op, "column")), align, valign)?;
    } else if kind == "add_autoindex" {
        let n = if aj_j_present(op, "name") { aj_j_str(op, "name") } else { "Index".to_string() };
        tables.tabs[ti].add_autoindex(n);
    } else if kind == "del_row" {
        tables.tabs[ti].del_row(op_int(op, "i").unwrap_or(0))?;
    } else if kind == "del_column" {
        tables.tabs[ti].del_column(aj_j_str(op, "name"))?;
    } else if kind == "add_divider" {
        tables.tabs[ti].add_divider();
    } else if kind == "clear_rows" {
        tables.tabs[ti].clear_rows();
    } else if kind == "clear" {
        tables.tabs[ti].clear();
    } else if kind == "set_style" {
        let style = match aj_j_get(op, "style") {
            J.S(s) => style_named(s)?,
            other => j_int(other)?,
        };
        tables.tabs[ti].set_style(style)?;
    } else if kind == "slice" {
        let t = tables.tabs[ti].clone();
        let lo = op_int(op, "lo").unwrap_or(0);
        let rows = py_slice_list(t.rows, lo, op_int(op, "hi"));
        let n = t.with_rows(w, rows)?;
        tables.put(aj_j_str(op, "to"), n);
    } else if kind == "index" {
        let t = tables.tabs[ti].clone();
        let i0 = op_int(op, "i").unwrap_or(0);
        let i = if i0 < 0 { i0 + t.rows.len() } else { i0 };
        if i < 0 or i >= t.rows.len() {
            return Err("IndexError: list index out of range".to_string());
        }
        let mut rows: Vec[Vec[V]] = Vec.new();
        rows.push(t.rows[i].clone());
        let n = t.with_rows(w, rows)?;
        tables.put(aj_j_str(op, "to"), n);
    } else if kind == "copy" {
        let t = tables.tabs[ti].clone();
        tables.put(aj_j_str(op, "to"), t);
    } else if kind == "get" {
        let attr = aj_j_str(op, "attr");
        let r = tables.tabs[ti].get_attr(attr)?;
        return Ok(Some(f"{attr} = {r}"));
    } else if kind == "show" {
        let s = show(w, mut tables.tabs[ti], op)?;
        return Ok(Some(f"-- {aj_j_str(op, "say")}\n{visible(s)}"));
    } else {
        return Err(f"unknown op {kind}");
    }
    Ok(None)
}

fn run() -> Result[(), String] {
    let w = load_widths()?;
    let ents = hp_html5_entities();
    let text = match fs.read_to_string("data/jobs.jsonl") {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/jobs.jsonl: {e}"),
    };
    for line in split_nl(text).iter() {
        if line.len() == 0 {
            continue;
        }
        let job = aj_json_line(line)?;
        println(f"== {aj_j_str(job, "name")}");
        let mut tables = Tables { names: Vec.new(), tabs: Vec.new() };
        if let J.A(ops) = aj_j_get(job, "ops") {
            for op in ops.iter() {
                match run_op(w, ents, mut tables, op) {
                    Ok(Some(s)) => println(s),
                    Ok(None) => {}
                    Err(e) => println(f"! {e}"),
                }
            }
        }
    }
    Ok(())
}

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn hex_val(c: u8) -> u8 {
    if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 }
}

fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    if let Err(e) = run() {
        eprintln(e);
    }
}


