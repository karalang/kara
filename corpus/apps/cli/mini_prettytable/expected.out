== options
-- vrules=FRAME, left_padding_width=0, header=1 in the constructor
+---+---+
| a | b |
+---+---+
| 1 | 2 |
+---+---+
vrules = <VRuleStyle.ALL: 1>
left_padding_width = None
-- the same set as attributes
+-----+
|a  b |
+-----+
|1  2 |
+-----+
horizontal_align_char = '+'
horizontal_align_char = 'L'
top_junction_char = '+'
top_junction_char = '*'
-- junction * with a bottom-left L
*-----*
|a  b |
*-----*
|1  2 |
L-----*
! ValueError: Invalid value for start: -1
! ValueError: Invalid value for hrules. Must be HRuleStyle.
! ValueError: Invalid field name: b
! ValueError: Invalid field name: z
! ValueError: Invalid value for junction_char. Must be a string of length 1.
! ValueError: Invalid value for int_format. Must be an integer format string.
! ValueError: Invalid value for float_format. Must be a float format string.
! ValueError: Invalid value for float_format. Must be a float format string.
! ValueError: Invalid value for float_format. Must be a float format string.
! ValueError: Invalid header style, use cap, title, upper, lower or None
! ValueError: Invalid value for border. Must be True or False.
! TypeError: Replacement for None value must be a string if being supplied.
! TypeError: Attributes must be a dictionary of name/value pairs
! ValueError: Field names must be unique
! ValueError: Row has incorrect number of values, (actual) 1!=2 (expected)
! ValueError: Field name list has incorrect number of values, (actual) 3!=2 (expected)
! IndexError: Can't delete row at index 0, table only has 0 rows
! ValueError: Can't delete column 'c' which is not a field name of this table. Field names are: 'a', 'b'
! ValueError: Column length 2 does not match number of rows 1
! ValueError: Alignment x is invalid, use l, c or r
! ValueError: Alignment x is invalid, use t, m, b
! ValueError: Alignment x is invalid, use l, c or r
! ValueError: Alignment x is invalid, use t, m, b
! ValueError: Invalid value for max_width: -2
! ValueError: Invalid field name: zz
! ValueError: Invalid value for padding_width: -1
! ValueError: Invalid value for vertical_char. Must be a string of length 1.
-- vertical char 7
+---+---+
7 a 7 b 7
+---+---+
7 1 7 2 7
+---+---+
title = '2024'
-- an alignment set straight into the dict
+-------+
7  2024 7
+---+---+
7 a 7 b 7
+---+---+
7 1 7 2 7
+---+---+
! KeyError: 'x'
! ValueError: Invalid pre-set style
