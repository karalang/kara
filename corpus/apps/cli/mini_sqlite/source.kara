fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn unhex(s: String) -> Vec[u8] {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data")?;
    put("data/bad.db", file_0())?;
    put("data/lookups.txt", file_1())?;
    put_bytes("data/notes16.db", unhex(file_2()))?;
    put_bytes("data/shop.db", unhex(file_3()))?;
    Ok(())
}

// ------------------------------------------------------------ the report

fn read(path: Str) -> Result[String, String] {
    match fs.read_to_string(path.to_string()) {
        Ok(t) => Ok(t),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

fn text_of(v: ref Val) -> String {
    match v {
        Val.Text(s) => s.clone(),
        _ => String.new(),
    }
}

fn int_of(v: ref Val) -> i64 {
    match v {
        Val.Int(n) => *n,
        _ => 0,
    }
}

fn rjust(s: Str, width: i64) -> String {
    let mut out = String.new();
    let mut n = s.len();
    while n < width {
        out.push_str(" ");
        n += 1;
    }
    out.push_str(s);
    out
}

fn ljust(s: Str, width: i64) -> String {
    let mut out = s.to_string();
    while out.len() < width {
        out.push_str(" ");
    }
    out
}

fn schema_of(db: ref Db) -> Result[Vec[Obj], String] {
    let mut rows: Vec[(i64, Vec[Val])] = Vec.new();
    table_rows(db, 1, mut rows)?;
    let mut out: Vec[Obj] = Vec.new();
    for r in rows {
        let (_, v) = r;
        out.push(Obj { kind: text_of(v[0]), name: text_of(v[1]), table: text_of(v[2]), root: int_of(v[3]), sql: v[4].clone() });
    }
    Ok(out)
}

fn find_obj(schema: ref Vec[Obj], name: Str) -> Obj {
    for o in schema {
        if o.name == name {
            return o.clone();
        }
    }
    schema[0].clone()
}

// A table's row as SELECT * gives it: the rowid for an INTEGER PRIMARY
// KEY, defaults for columns added after the row was written, and whole
// numbers in REAL columns turned back into floats.
fn table_row(def: ref TableDef, rowid: i64, rec: ref Vec[Val]) -> Vec[Val] {
    let mut out: Vec[Val] = Vec.new();
    for i in 0..def.cols.len() {
        let col = def.cols[i].clone();
        let v = if col.rowid_alias {
            Val.Int(rowid)
        } else if i < rec.len() {
            rec[i].clone()
        } else {
            col.default_val.clone()
        };
        let w = match v {
            Val.Int(n) => if col.affinity == AFF_REAL { Val.Real(n as f64) } else { Val.Int(n) },
            other => other,
        };
        out.push(w);
    }
    out
}

fn table_def(o: ref Obj) -> TableDef {
    parse_table(text_of(o.sql))
}

fn show_header(db: ref Db) {
    let enc = if db.encoding == 1 { "UTF-8" } else if db.encoding == 2 { "UTF-16le" } else { "UTF-16be" };
    let av = if not auto_vacuum(db) { "none" } else if u32_at(db.data, 64) != 0 { "incremental" } else { "full" };
    println(f"page size {db.page_size}, {db.pages} pages, {enc}, auto-vacuum {av}");
    println(f"schema version {u32_at(db.data, 40)}, user version {i32_at(db.data, 60)}, application id {i32_at(db.data, 68)}, written by {u32_at(db.data, 96)}");
    println(f"{u32_at(db.data, 36)} free pages");
}

fn show_pages(db: ref Db, schema: ref Vec[Obj]) -> Result[(), String] {
    println("-- pages");
    let mut info: Vec[PageInfo] = Vec.new();
    for _ in 0..db.pages + 1 {
        info.push(PageInfo { kind: String.new(), name: String.new(), path: String.new(), cells: 0, payload: 0, unused: 0, max: 0 });
    }
    walk(db, 1, "sqlite_schema", "/", mut info)?;
    for o in schema {
        if o.root > 0 {
            walk(db, o.root, o.name, "/", mut info)?;
        }
    }
    let free = free_pages(db);
    for p in 1..db.pages + 1 {
        let pi = info[p].clone();
        if pi.kind.len() > 0 {
            println(f"{rjust(f"{p}", 4)} {ljust(pi.kind, 8)} {pi.name} {pi.path} cells {pi.cells}, payload {pi.payload}, unused {pi.unused}, max {pi.max}");
        } else if is_ptrmap(db, p) {
            println(f"{rjust(f"{p}", 4)} ptrmap");
        } else if free.contains(p) {
            println(f"{rjust(f"{p}", 4)} free");
        } else {
            println(f"{rjust(f"{p}", 4)} lost");
        }
    }
    if auto_vacuum(db) {
        println("-- pointer map");
        let mut ents: Vec[String] = Vec.new();
        for p in 3..db.pages + 1 {
            if is_ptrmap(db, p) {
                continue;
            }
            let (t, parent) = ptrmap_entry(db, p);
            let kind = if t == 1 {
                "root"
            } else if t == 2 {
                "free"
            } else if t == 3 {
                "overflow1"
            } else if t == 4 {
                "overflow2"
            } else {
                "btree"
            };
            ents.push(f"{p} {kind} {parent}");
        }
        let mut i: i64 = 0;
        while i < ents.len() {
            let mut line: Vec[String] = Vec.new();
            for k in i..i + 6 {
                if k < ents.len() {
                    line.push(ents[k].clone());
                }
            }
            println(f"  {join(line, " | ")}");
            i += 6;
        }
    }
    Ok(())
}

fn show_tables(db: ref Db, schema: ref Vec[Obj]) -> Result[(), String] {
    println("-- tables");
    for o in schema {
        if o.kind != "table" {
            continue;
        }
        let def = table_def(o);
        if def.without_rowid {
            let mut ents: Vec[Vec[Val]] = Vec.new();
            index_entries(db, o.root, mut ents)?;
            println(f"{o.name}: {ents.len()} rows");
            let mut deleted: Vec[Vec[Val]] = Vec.new();
            for e in ents {
                if starts_with(text_of(e[0]), "deleted:") {
                    deleted.push(e.clone());
                } else {
                    println(f"  {show_row(e)}");
                }
            }
            if deleted.len() > 0 {
                let mut sum: i64 = 0;
                for d in deleted {
                    sum += int_of(d[1]);
                }
                println(f"  {deleted.len()} deleted:* keys, values sum to {sum}, first {show_row(deleted[0])}, last {show_row(deleted[deleted.len() - 1])}");
            }
            continue;
        }
        let mut rows: Vec[(i64, Vec[Val])] = Vec.new();
        table_rows(db, o.root, mut rows)?;
        println(f"{o.name}: {rows.len()} rows");
        for i in 0..rows.len() {
            let (rowid, rec) = rows[i].clone();
            if o.name == "orders" and rowid % 20 != 0 and i != rows.len() - 1 {
                continue;
            }
            println(f"  {rowid}: {show_row(table_row(def, rowid, rec))}");
        }
    }
    Ok(())
}

// The columns an index covers: from its CREATE INDEX, or for an automatic
// index, from the n-th UNIQUE or PRIMARY KEY constraint of its table.
fn columns_of_index(o: ref Obj, schema: ref Vec[Obj]) -> Vec[String] {
    match o.sql {
        Val.Text(s) => index_columns(s),
        _ => {
            let (_, _, n) = rpartition(o.name, b'_');
            let def = table_def(find_obj(schema, o.table));
            let k = py_int(n).unwrap_or(1);
            def.uniques[k - 1].clone()
        }
    }
}

fn show_indexes(db: ref Db, schema: ref Vec[Obj]) -> Result[(), String] {
    println("-- indexes");
    for o in schema {
        if o.kind != "index" {
            continue;
        }
        let cols = columns_of_index(o, schema);
        let mut ents: Vec[Vec[Val]] = Vec.new();
        index_entries(db, o.root, mut ents)?;
        println(f"{o.name} ({join(cols, ", ")}): {ents.len()} entries");
        for i in 0..3 {
            println(f"  {show_row(ents[i])}");
        }
        println("  ...");
        for i in ents.len() - 3..ents.len() {
            println(f"  {show_row(ents[i])}");
        }
    }
    Ok(())
}

fn get_row(db: ref Db, t: ref Obj, rowid: i64) -> Result[Option[Vec[Val]], String] {
    let mut rows: Vec[(i64, Vec[Val])] = Vec.new();
    table_range(db, t.root, rowid, rowid, mut rows)?;
    if rows.len() == 0 {
        return Ok(None);
    }
    let (_, rec) = rows[0].clone();
    Ok(Some(table_row(table_def(t), rowid, rec)))
}

fn show_lookups(db: ref Db, schema: ref Vec[Obj], path: Str) -> Result[(), String] {
    println("-- lookups");
    let customers = find_obj(schema, "customers");
    let orders = find_obj(schema, "orders");
    let by_email = find_obj(schema, "sqlite_autoindex_customers_1");
    let by_customer = find_obj(schema, "idx_orders_customer");
    for l in lines_of(read(path)?) {
        if l.len() == 0 or first_byte(l) == b'#' {
            continue;
        }
        let (cmd, _, arg) = partition(l, b' ');
        if cmd == "email" {
            let mut hits: Vec[Vec[Val]] = Vec.new();
            index_equal(db, by_email.root, Val.Text(arg.clone()), mut hits)?;
            let mut shown = "not found".to_string();
            if hits.len() > 0 {
                let rowid = int_of(hits[0][hits[0].len() - 1]);
                if let Some(r) = get_row(db, customers, rowid)? {
                    shown = f"{rowid}: {show_row(r)}";
                }
            }
            println(f"email {py_repr(arg)}: {shown}");
        } else if cmd == "orders" {
            let c = py_int(arg).unwrap_or(0);
            let mut hits: Vec[Vec[Val]] = Vec.new();
            index_equal(db, by_customer.root, Val.Int(c), mut hits)?;
            println(f"orders of {arg}: {hits.len()}");
            for h in hits {
                let rowid = int_of(h[2]);
                let total = match get_row(db, orders, rowid)? {
                    Some(r) => show(r[2]),
                    None => "missing".to_string(),
                };
                println(f"  {rowid} {text_of(h[1])} {total}");
            }
        } else {
            let parts = split_on(arg, b' ');
            let t = find_obj(schema, parts[0]);
            let a = py_int(parts[1]).unwrap_or(0);
            let b = py_int(parts[2]).unwrap_or(0);
            let mut rows: Vec[(i64, Vec[Val])] = Vec.new();
            table_range(db, t.root, a, b, mut rows)?;
            println(f"{parts[0]} rows {parts[1]} to {parts[2]}: {rows.len()}");
            let def = table_def(t);
            for r in rows {
                let (rowid, rec) = r.clone();
                println(f"  {rowid}: {show_row(table_row(def, rowid, rec))}");
            }
        }
    }
    Ok(())
}

#[derive(Clone)]
struct Group {
    country: String,
    count: i64,
    sum: i64,
}

fn show_countries(db: ref Db, schema: ref Vec[Obj]) -> Result[(), String] {
    println("-- orders by country");
    let mut country: Map[i64, String] = Map.new();
    let mut rows: Vec[(i64, Vec[Val])] = Vec.new();
    let customers = find_obj(schema, "customers");
    table_rows(db, customers.root, mut rows)?;
    let cdef = table_def(customers);
    for r in rows {
        let (rowid, rec) = r.clone();
        let row = table_row(cdef, rowid, rec);
        country.insert(rowid, text_of(row[3]));
    }
    let mut orders: Vec[(i64, Vec[Val])] = Vec.new();
    table_rows(db, find_obj(schema, "orders").root, mut orders)?;
    let mut groups: Vec[Group] = Vec.new();
    for r in orders {
        let (_, rec) = r.clone();
        let total = int_of(rec[2]);
        if total < -1000000000000 or total > 1000000000000 {
            continue;
        }
        let c = match country.get(int_of(rec[1])) {
            Some(c) => c.clone(),
            None => continue,
        };
        let mut found = false;
        for i in 0..groups.len() {
            if groups[i].country == c {
                groups[i].count += 1;
                groups[i].sum += total;
                found = true;
            }
        }
        if not found {
            groups.push(Group { country: c, count: 1, sum: total });
        }
    }
    for i in 1..groups.len() {
        let mut j = i;
        while j > 0 and compare_bytes(to_bytes(groups[j].country), to_bytes(groups[j - 1].country)) < 0 {
            groups.swap(j - 1, j);
            j -= 1;
        }
    }
    for g in groups {
        println(f"{g.country} {g.count} {g.sum}");
    }
    Ok(())
}

fn report(path: Str, lookups: Str) -> Result[(), String] {
    println(f"== {path}");
    let data = match fs.read_bytes(path.to_string()) {
        Ok(b) => b,
        Err(e) => return Err(f"cannot read {path}: {e}"),
    };
    let db = match open_db(data) {
        Ok(db) => db,
        Err(e) => {
            println(f"error: {e}");
            return Ok(());
        }
    };
    show_header(db);
    let schema = schema_of(db)?;
    println("-- schema");
    for o in schema {
        println(f"{o.kind} {o.name} on {o.table}, root {o.root}: {show(o.sql)}");
    }
    show_pages(db, schema)?;
    show_tables(db, schema)?;
    show_indexes(db, schema)?;
    if lookups.len() > 0 {
        show_lookups(db, schema, lookups)?;
        show_countries(db, schema)?;
    }
    Ok(())
}

fn run() -> Result[(), String] {
    write_data()?;
    report("data/shop.db", "data/lookups.txt")?;
    report("data/notes16.db", "")?;
    report("data/bad.db", "")
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_sqlite: {e}");
    }
}
