// mini_sqlite: a reader for SQLite database files, written from the
// file-format spec and checked against SQLite 3.45 itself:
// - the 100-byte header, b-tree pages, cells and their local and
//   overflow payload, varints, records and serial types;
// - UTF-8 and UTF-16 text, the REAL-affinity rule for whole numbers,
//   INTEGER PRIMARY KEY, and the defaults of columns added later with
//   ALTER TABLE, read from the schema's CREATE TABLE text;
// - WITHOUT ROWID tables, indexes and their automatic UNIQUE indexes;
// - a dbstat-style report of every page, the freelist and the
//   auto-vacuum pointer map;
// - and lookups that descend the b-trees instead of scanning them.
//
// The inputs are the files in data/. expected.out is the output of
// oracle.py, which asks Python's sqlite3 the same questions.
// ------------------------------------------------------------ bytes and text

fn byte_str(b: ref Vec[u8], from: i64, to: i64) -> String {
    let mut v: Vec[u8] = Vec.new();
    for i in from..to {
        v.push(b[i]);
    }
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn to_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn from_bytes(v: Vec[u8]) -> String {
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn is_alpha(c: u8) -> bool {
    (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z')
}

fn is_alnum(c: u8) -> bool {
    is_digit(c) or is_alpha(c)
}

// White space, as `\s` and str.strip see it.
fn is_ws(c: u8) -> bool {
    c == b' ' or c == b'\t' or c == b'\n' or c == b'\r' or c == 11 or c == 12
}

fn lower_byte(c: u8) -> u8 {
    if c >= b'A' and c <= b'Z' { c + 32 } else { c }
}

fn lower(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        out.push(lower_byte(b[i]));
    }
    from_bytes(out)
}

fn strip(s: Str) -> String {
    let b = to_bytes(s);
    let mut i: i64 = 0;
    let mut j = b.len();
    while i < j and is_ws(b[i]) {
        i += 1;
    }
    while j > i and is_ws(b[j - 1]) {
        j -= 1;
    }
    byte_str(b, i, j)
}

fn split_ws(s: Str) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        while i < b.len() and is_ws(b[i]) {
            i += 1;
        }
        let st = i;
        while i < b.len() and not is_ws(b[i]) {
            i += 1;
        }
        if i > st {
            out.push(byte_str(b, st, i));
        }
    }
    out
}

fn split_on(s: Str, sep: u8) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut st: i64 = 0;
    for i in 0..b.len() {
        if b[i] == sep {
            out.push(byte_str(b, st, i));
            st = i + 1;
        }
    }
    out.push(byte_str(b, st, b.len()));
    out
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

// The lines of a file, without their newlines.
fn lines_of(text: Str) -> Vec[String] {
    let mut v = split_on(text, b'\n');
    if v.len() > 0 and v[v.len() - 1].len() == 0 {
        v.pop();
    }
    v
}

// Python's repr of a str.
fn py_repr(s: Str) -> String {
    let b = to_bytes(s);
    let mut has_single = false;
    let mut has_double = false;
    for i in 0..b.len() {
        if b[i] == b'\'' {
            has_single = true;
        }
        if b[i] == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let hex = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    out.push(q);
    let mut skip = false;
    for i in 0..b.len() {
        let c = b[i];
        if skip {
            skip = false;
            continue;
        }
        // U+0080 to U+00A0 and U+00AD are not printable either
        let next: u8 = if i + 1 < b.len() { b[i + 1] } else { 0 };
        if c == 0xC2 and next >= 0x80 and (next <= 0xA0 or next == 0xAD) {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(next / 16) as i64]);
            out.push(hex[(next % 16) as i64]);
            skip = true;
        } else if c == q or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c < 32 or c == 127 {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    from_bytes(out)
}

fn upper(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        let c = b[i];
        out.push(if c >= b'a' and c <= b'z' { c - 32 } else { c });
    }
    from_bytes(out)
}

// Whether `pat` occurs in `b` at `i`.
fn starts_at(b: ref Vec[u8], i: i64, pat: Str) -> bool {
    let p = to_bytes(pat);
    if i < 0 or i + p.len() > b.len() {
        return false;
    }
    for k in 0..p.len() {
        if b[i + k] != p[k] {
            return false;
        }
    }
    true
}

fn starts_with(s: Str, pat: Str) -> bool {
    starts_at(to_bytes(s), 0, pat)
}

fn find_str(s: Str, pat: Str) -> i64 {
    let b = to_bytes(s);
    for i in 0..b.len() + 1 {
        if starts_at(b, i, pat) {
            return i;
        }
    }
    -1
}

fn first_byte(s: Str) -> u8 {
    let b = to_bytes(s);
    if b.len() > 0 { b[0] } else { 0 }
}

fn slice_from(s: Str, i: i64) -> String {
    let b = to_bytes(s);
    byte_str(b, i, b.len())
}

fn is_hex(c: u8) -> bool {
    is_digit(c) or (c >= b'a' and c <= b'f') or (c >= b'A' and c <= b'F')
}

fn hex_val(c: u8) -> u8 {
    if is_digit(c) {
        c - b'0'
    } else if c >= b'a' and c <= b'f' {
        c - b'a' + 10
    } else {
        c - b'A' + 10
    }
}

fn find_byte(s: Str, c: u8) -> i64 {
    let b = to_bytes(s);
    for i in 0..b.len() {
        if b[i] == c {
            return i;
        }
    }
    -1
}

fn rfind_byte(s: Str, c: u8) -> i64 {
    let b = to_bytes(s);
    let mut i = b.len() - 1;
    while i >= 0 {
        if b[i] == c {
            return i;
        }
        i -= 1;
    }
    -1
}

fn has_byte(s: Str, c: u8) -> bool {
    find_byte(s, c) >= 0
}

fn slice(s: Str, from: i64, to: i64) -> String {
    byte_str(to_bytes(s), from, to)
}

// str.partition and str.rpartition on one byte: (before, found, after).
fn partition(s: Str, c: u8) -> (String, bool, String) {
    let i = find_byte(s, c);
    if i < 0 {
        return (s.to_string(), false, String.new());
    }
    (slice(s, 0, i), true, slice_from(s, i + 1))
}

fn rpartition(s: Str, c: u8) -> (String, bool, String) {
    let i = rfind_byte(s, c);
    if i < 0 {
        return (String.new(), false, s.to_string());
    }
    (slice(s, 0, i), true, slice_from(s, i + 1))
}

// Python's repr of a bytes object.
fn bytes_repr(b: ref Vec[u8]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for i in 0..b.len() {
        if b[i] == b'\'' {
            has_single = true;
        }
        if b[i] == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let hex = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    out.push(b'b');
    out.push(q);
    for i in 0..b.len() {
        let c = b[i];
        if c == q or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c < 32 or c >= 127 {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    from_bytes(out)
}

fn is_ascii(s: Str) -> bool {
    let b = to_bytes(s);
    for i in 0..b.len() {
        if b[i] >= 0x80 {
            return false;
        }
    }
    true
}

fn py_int(s: Str) -> Option[i64] {
    let b = to_bytes(strip(s));
    let mut i: i64 = 0;
    let mut neg = false;
    if i < b.len() and (b[i] == b'+' or b[i] == b'-') {
        neg = b[i] == b'-';
        i += 1;
    }
    if i >= b.len() {
        return None;
    }
    let mut n: i64 = 0;
    let mut prev_digit = false;
    while i < b.len() {
        let c = b[i];
        if is_digit(c) {
            n = n * 10 + (c - b'0') as i64;
            prev_digit = true;
        } else if c == b'_' and prev_digit and i + 1 < b.len() and is_digit(b[i + 1]) {
            prev_digit = false;
        } else {
            return None;
        }
        i += 1;
    }
    if neg { Some(-n) } else { Some(n) }
}

// The code points of a string.
fn code_points(s: Str) -> Vec[i64] {
    let b = to_bytes(s);
    let mut out: Vec[i64] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | (b[i + 1] as i64 & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | ((b[i + 1] as i64 & 0x3F) << 6) | (b[i + 2] as i64 & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | ((b[i + 1] as i64 & 0x3F) << 12) | ((b[i + 2] as i64 & 0x3F) << 6) | (b[i + 3] as i64 & 0x3F));
            i += 4;
        }
    }
    out
}

fn push_code_point(out: mut ref Vec[u8], cp: i64) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push(((cp >> 6) | 0xC0) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    } else if cp < 0x10000 {
        out.push(((cp >> 12) | 0xE0) as u8);
        out.push((((cp >> 6) & 0x3F) | 0x80) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    } else {
        out.push(((cp >> 18) | 0xF0) as u8);
        out.push((((cp >> 12) & 0x3F) | 0x80) as u8);
        out.push((((cp >> 6) & 0x3F) | 0x80) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    }
}

// ------------------------------------------------------------ the file and its pages

const INDEX_INTERIOR: u8 = 2;
const TABLE_INTERIOR: u8 = 5;
const INDEX_LEAF: u8 = 10;
const TABLE_LEAF: u8 = 13;

fn u16_at(b: ref Vec[u8], i: i64) -> i64 {
    (b[i] as i64) * 256 + b[i + 1] as i64
}

fn u32_at(b: ref Vec[u8], i: i64) -> i64 {
    let mut v: i64 = 0;
    for k in 0..4 {
        v = v * 256 + b[i + k] as i64;
    }
    v
}

// A signed 32-bit header field.
fn i32_at(b: ref Vec[u8], i: i64) -> i64 {
    let v = u32_at(b, i);
    if v >= 2147483648 { v - 4294967296 } else { v }
}

// A varint and the number of bytes it took.
fn varint(b: ref Vec[u8], pos: i64) -> (i64, i64) {
    let mut v: i64 = 0;
    for k in 0..8 {
        let c = b[pos + k];
        v = (v << 7) | (c & 0x7F) as i64;
        if c < 0x80 {
            return (v, k + 1);
        }
    }
    v = (v << 8) | b[pos + 8] as i64;
    (v, 9)
}

struct Db {
    data: Vec[u8],
    page_size: i64,
    usable: i64,
    pages: i64,
    encoding: i64,
}

fn open_db(data: own Vec[u8]) -> Result[Db, String] {
    let magic = to_bytes("SQLite format 3");
    if data.len() < 100 {
        return Err("file is not a database".to_string());
    }
    for k in 0..magic.len() {
        if data[k] != magic[k] {
            return Err("file is not a database".to_string());
        }
    }
    if data[15] != 0 {
        return Err("file is not a database".to_string());
    }
    let raw = u16_at(data, 16);
    let size = if raw == 1 { 65536 } else { raw };
    let reserved = data[20] as i64;
    let in_header = u32_at(data, 28);
    let valid = u32_at(data, 24) == u32_at(data, 92);
    let pages = if valid and in_header > 0 { in_header } else { data.len() / size };
    let enc = u32_at(data, 56);
    Ok(Db { data: data, page_size: size, usable: size - reserved, pages: pages, encoding: if enc == 0 { 1 } else { enc } })
}

// One b-tree page: where its header and cells are, as file offsets.
#[derive(Clone)]
struct Page {
    no: i64,
    base: i64,
    flag: u8,
    first_free: i64,
    content: i64,
    frag: i64,
    right: i64,
    cells: Vec[i64],
}

impl Page {
    fn is_leaf(ref self) -> bool {
        self.flag == TABLE_LEAF or self.flag == INDEX_LEAF
    }

    fn is_table(ref self) -> bool {
        self.flag == TABLE_LEAF or self.flag == TABLE_INTERIOR
    }
}

fn read_page(db: ref Db, no: i64) -> Result[Page, String] {
    if no < 1 or no > db.pages {
        return Err(f"page {no} is out of range");
    }
    let base = (no - 1) * db.page_size;
    let h = if no == 1 { base + 100 } else { base };
    let b = ref db.data;
    let flag = b[h];
    if flag != INDEX_INTERIOR and flag != TABLE_INTERIOR and flag != INDEX_LEAF and flag != TABLE_LEAF {
        return Err(f"page {no} is not a b-tree page (flag {flag})");
    }
    let leaf = flag == TABLE_LEAF or flag == INDEX_LEAF;
    let n = u16_at(b, h + 3);
    let start = if leaf { h + 8 } else { h + 12 };
    let mut cells: Vec[i64] = Vec.new();
    for k in 0..n {
        cells.push(base + u16_at(b, start + 2 * k));
    }
    let content = u16_at(b, h + 5);
    Ok(Page {
        no: no,
        base: base,
        flag: flag,
        first_free: u16_at(b, h + 1),
        content: if content == 0 { 65536 } else { content },
        frag: b[h + 7] as i64,
        right: if leaf { 0 } else { u32_at(b, h + 8) },
        cells: cells,
    })
}

// A cell: its left child (interior pages), its rowid (table pages), the
// size of its whole payload, how much of it is on the page and where,
// and the first overflow page.
#[derive(Clone)]
struct Cell {
    left: i64,
    rowid: i64,
    size: i64,
    local: i64,
    start: i64,
    overflow: i64,
}

// How much of a payload of `p` bytes stays on the page.
fn local_size(db: ref Db, p: i64, table: bool) -> i64 {
    let u = db.usable;
    let x = if table { u - 35 } else { (u - 12) * 64 / 255 - 23 };
    if p <= x {
        return p;
    }
    let m = (u - 12) * 32 / 255 - 23;
    let k = m + (p - m) % (u - 4);
    if k <= x { k } else { m }
}

fn read_cell(db: ref Db, page: ref Page, i: i64) -> Cell {
    let b = ref db.data;
    let mut pos = page.cells[i];
    let mut cell = Cell { left: 0, rowid: 0, size: 0, local: 0, start: 0, overflow: 0 };
    if not page.is_leaf() {
        cell.left = u32_at(b, pos);
        pos += 4;
    }
    if page.flag == TABLE_INTERIOR {
        let (r, _) = varint(b, pos);
        cell.rowid = r;
        return cell;
    }
    let (size, n) = varint(b, pos);
    pos += n;
    if page.flag == TABLE_LEAF {
        let (r, m) = varint(b, pos);
        cell.rowid = r;
        pos += m;
    }
    cell.size = size;
    cell.local = local_size(db, size, page.flag == TABLE_LEAF);
    cell.start = pos;
    if cell.local < size {
        cell.overflow = u32_at(b, pos + cell.local);
    }
    cell
}

// The overflow pages of a cell, in chain order.
fn overflow_pages(db: ref Db, cell: ref Cell) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut next = cell.overflow;
    while next != 0 {
        out.push(next);
        next = u32_at(db.data, (next - 1) * db.page_size);
    }
    out
}

fn payload(db: ref Db, cell: ref Cell) -> Vec[u8] {
    let b = ref db.data;
    let mut out: Vec[u8] = Vec.new();
    for k in 0..cell.local {
        out.push(b[cell.start + k]);
    }
    let per = db.usable - 4;
    for p in overflow_pages(db, cell) {
        let base = (p - 1) * db.page_size + 4;
        let left = cell.size - out.len();
        let n = if left < per { left } else { per };
        for k in 0..n {
            out.push(b[base + k]);
        }
    }
    out
}

// ------------------------------------------------------------ records

#[derive(Clone)]
enum Val {
    Null,
    Int(i64),
    Real(f64),
    Text(String),
    Blob(Vec[u8]),
}

fn decode_text(db: ref Db, b: ref Vec[u8], from: i64, n: i64) -> String {
    if db.encoding == 1 {
        return byte_str(b, from, from + n);
    }
    let le = db.encoding == 2;
    let mut out: Vec[u8] = Vec.new();
    let mut i = from;
    while i + 1 < from + n {
        let u = if le { (b[i + 1] as i64) * 256 + b[i] as i64 } else { (b[i] as i64) * 256 + b[i + 1] as i64 };
        i += 2;
        if u >= 0xD800 and u < 0xDC00 and i + 1 < from + n {
            let lo = if le { (b[i + 1] as i64) * 256 + b[i] as i64 } else { (b[i] as i64) * 256 + b[i + 1] as i64 };
            i += 2;
            push_code_point(mut out, 0x10000 + ((u - 0xD800) << 10) + (lo - 0xDC00));
        } else {
            push_code_point(mut out, u);
        }
    }
    from_bytes(out)
}

// A big-endian two's-complement integer of n bytes.
fn int_at(b: ref Vec[u8], from: i64, n: i64) -> i64 {
    let mut v: i64 = if b[from] >= 0x80 { -1 } else { 0 };
    for k in 0..n {
        v = (v << 8) | b[from + k] as i64;
    }
    v
}

fn real_at(b: ref Vec[u8], from: i64) -> f64 {
    int_at(b, from, 8).bits_as_f64()
}

fn decode_record(db: ref Db, b: ref Vec[u8]) -> Vec[Val] {
    let (hsize, n0) = varint(b, 0);
    let mut types: Vec[i64] = Vec.new();
    let mut p = n0;
    while p < hsize {
        let (t, n) = varint(b, p);
        types.push(t);
        p += n;
    }
    let mut out: Vec[Val] = Vec.new();
    let mut at = hsize;
    for t in types {
        if t == 0 {
            out.push(Val.Null);
        } else if t >= 1 and t <= 6 {
            let n = if t == 5 { 6 } else if t == 6 { 8 } else { t };
            out.push(Val.Int(int_at(b, at, n)));
            at += n;
        } else if t == 7 {
            out.push(Val.Real(real_at(b, at)));
            at += 8;
        } else if t == 8 {
            out.push(Val.Int(0));
        } else if t == 9 {
            out.push(Val.Int(1));
        } else if t >= 12 and t % 2 == 0 {
            let n = (t - 12) / 2;
            let mut v: Vec[u8] = Vec.new();
            for k in 0..n {
                v.push(b[at + k]);
            }
            out.push(Val.Blob(v));
            at += n;
        } else {
            let n = (t - 13) / 2;
            out.push(Val.Text(decode_text(db, b, at, n)));
            at += n;
        }
    }
    out
}

fn record_of(db: ref Db, cell: ref Cell) -> Vec[Val] {
    decode_record(db, payload(db, cell))
}

// ------------------------------------------------------------ showing values

fn hex2(c: u8) -> String {
    let h = to_bytes("0123456789abcdef");
    let mut v: Vec[u8] = Vec.new();
    v.push(h[(c / 16) as i64]);
    v.push(h[(c % 16) as i64]);
    from_bytes(v)
}

// The first n code points of s.
fn take_chars(s: Str, n: i64) -> String {
    let cps = code_points(s);
    let mut out: Vec[u8] = Vec.new();
    for k in 0..cps.len() {
        if k >= n {
            break;
        }
        push_code_point(mut out, cps[k]);
    }
    from_bytes(out)
}

// The oracle's text(): NULL, numbers as Python prints them, text and
// blobs cut at 40 characters and 16 bytes.
fn show(v: ref Val) -> String {
    match v {
        Val.Null => "NULL".to_string(),
        Val.Int(n) => f"{n}",
        Val.Real(x) => f"{x}",
        Val.Text(s) => {
            let n = code_points(s).len();
            if n > 40 { f"{py_repr(take_chars(s, 40))} +{n - 40}" } else { py_repr(s) }
        }
        Val.Blob(b) => {
            let mut h = String.new();
            for k in 0..b.len() {
                if k < 16 {
                    h.push_str(hex2(b[k]));
                }
            }
            if b.len() > 16 { f"x'{h}' +{b.len() - 16}" } else { f"x'{h}'" }
        }
    }
}

fn show_row(vals: ref Vec[Val]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for v in vals {
        parts.push(show(v));
    }
    join(parts, ", ")
}

// ------------------------------------------------------------ the schema

const AFF_BLOB: i64 = 0;
const AFF_TEXT: i64 = 1;
const AFF_NUMERIC: i64 = 2;
const AFF_INTEGER: i64 = 3;
const AFF_REAL: i64 = 4;

#[derive(Clone)]
struct ColumnDef {
    name: String,
    affinity: i64,
    default_val: Val,
    rowid_alias: bool,
}

// A row of sqlite_schema.
#[derive(Clone)]
struct Obj {
    kind: String,
    name: String,
    table: String,
    root: i64,
    sql: Val,
}

// A CREATE TABLE statement, as much of it as reading the file needs.
#[derive(Clone)]
struct TableDef {
    cols: Vec[ColumnDef],
    uniques: Vec[Vec[String]],
    without_rowid: bool,
}

fn contains_str(s: Str, pat: Str) -> bool {
    find_str(s, pat) >= 0
}

// The column affinity rules of section 3.1 of the datatype document.
fn affinity_of(decl: Str) -> i64 {
    let t = upper(decl);
    if contains_str(t, "INT") {
        AFF_INTEGER
    } else if contains_str(t, "CHAR") or contains_str(t, "CLOB") or contains_str(t, "TEXT") {
        AFF_TEXT
    } else if contains_str(t, "BLOB") or t.len() == 0 {
        AFF_BLOB
    } else if contains_str(t, "REAL") or contains_str(t, "FLOA") or contains_str(t, "DOUB") {
        AFF_REAL
    } else {
        AFF_NUMERIC
    }
}

// SQL tokens: words, numbers (with their sign), 'strings', quoted names
// and single punctuation characters.
fn sql_tokens(s: Str) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let c = b[i];
        if is_ws(c) {
            i += 1;
            continue;
        }
        let st = i;
        if c == b'\'' or c == b'"' or c == b'`' or c == b'[' {
            let close = if c == b'[' { b']' } else { c };
            i += 1;
            while i < b.len() {
                if b[i] == close {
                    if close != b']' and i + 1 < b.len() and b[i + 1] == close {
                        i += 2;
                        continue;
                    }
                    break;
                }
                i += 1;
            }
            i += 1;
        } else if is_alnum(c) or c == b'_' or c >= 0x80 or ((c == b'-' or c == b'+') and i + 1 < b.len() and is_digit(b[i + 1])) {
            i += 1;
            while i < b.len() and (is_alnum(b[i]) or b[i] == b'_' or b[i] == b'.' or b[i] >= 0x80) {
                i += 1;
            }
        } else {
            i += 1;
        }
        out.push(byte_str(b, st, i));
    }
    out
}

// A name without its quotes.
fn unquote(t: Str) -> String {
    let c = first_byte(t);
    if (c == b'"' or c == b'`' or c == b'[' or c == b'\'') and t.len() >= 2 {
        let inner = slice(t, 1, t.len() - 1);
        if c == b'[' {
            return inner;
        }
        let q = byte_str(to_bytes(t), 0, 1);
        let mut out = String.new();
        let b = to_bytes(inner);
        let mut i: i64 = 0;
        while i < b.len() {
            out.push_str(byte_str(b, i, i + 1));
            if b[i] == first_byte(q) and i + 1 < b.len() and b[i + 1] == b[i] {
                i += 1;
            }
            i += 1;
        }
        return out;
    }
    t.to_string()
}

fn literal(t: Str) -> Val {
    let c = first_byte(t);
    if c == b'\'' {
        return Val.Text(unquote(t));
    }
    let u = upper(t);
    if u == "NULL" {
        return Val.Null;
    }
    if u == "TRUE" {
        return Val.Int(1);
    }
    if u == "FALSE" {
        return Val.Int(0);
    }
    if let Some(n) = py_int(t) {
        return Val.Int(n);
    }
    match f64.parse(t).ok() {
        Some(x) => Val.Real(x),
        None => Val.Null,
    }
}

// The parts between the outer parentheses, split at top-level commas.
fn column_defs(toks: ref Vec[String]) -> (Vec[Vec[String]], i64) {
    let mut defs: Vec[Vec[String]] = Vec.new();
    let mut cur: Vec[String] = Vec.new();
    let mut depth: i64 = 0;
    let mut i: i64 = 0;
    while i < toks.len() and toks[i] != "(" {
        i += 1;
    }
    i += 1;
    while i < toks.len() {
        let t = toks[i].clone();
        if t == "(" {
            depth += 1;
        } else if t == ")" {
            if depth == 0 {
                break;
            }
            depth -= 1;
        } else if t == "," and depth == 0 {
            defs.push(cur);
            cur = Vec.new();
            i += 1;
            continue;
        }
        cur.push(t);
        i += 1;
    }
    defs.push(cur);
    (defs, i + 1)
}

// The names in a parenthesized list starting at toks[i] == "(".
fn name_list(toks: ref Vec[String], i: i64) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut k = i + 1;
    let mut want = true;
    while k < toks.len() and toks[k] != ")" {
        if toks[k] == "," {
            want = true;
        } else if want {
            out.push(unquote(toks[k]));
            want = false;
        }
        k += 1;
    }
    out
}

fn is_constraint_word(u: Str) -> bool {
    u == "CONSTRAINT" or u == "PRIMARY" or u == "NOT" or u == "NULL" or u == "UNIQUE" or u == "CHECK" or u == "DEFAULT" or u == "COLLATE" or u == "REFERENCES" or u == "GENERATED" or u == "AS"
}

fn parse_table(sql: Str) -> TableDef {
    let toks = sql_tokens(sql);
    let (defs, after) = column_defs(toks);
    let mut def = TableDef { cols: Vec.new(), uniques: Vec.new(), without_rowid: false };
    for k in after..toks.len() {
        if upper(toks[k]) == "ROWID" {
            def.without_rowid = true;
        }
    }
    let mut table_uniques: Vec[Vec[String]] = Vec.new();
    for d in defs {
        if d.len() == 0 {
            continue;
        }
        let head = upper(d[0]);
        if head == "CONSTRAINT" or head == "PRIMARY" or head == "UNIQUE" or head == "CHECK" or head == "FOREIGN" {
            let mut k: i64 = 0;
            while k < d.len() and d[k] != "(" {
                k += 1;
            }
            let cols = name_list(d, k);
            if contains_str(upper(join(d, " ")), "PRIMARY KEY") {
                if not def.without_rowid {
                    table_uniques.push(cols);
                }
            } else if contains_str(upper(join(d, " ")), "UNIQUE") {
                table_uniques.push(cols);
            }
            continue;
        }
        let name = unquote(d[0]);
        let mut k: i64 = 1;
        let mut decl: Vec[String] = Vec.new();
        while k < d.len() and not is_constraint_word(upper(d[k])) {
            decl.push(d[k].clone());
            k += 1;
        }
        let type_name = join(decl, " ");
        let mut col = ColumnDef { name: name.clone(), affinity: affinity_of(type_name), default_val: Val.Null, rowid_alias: false };
        while k < d.len() {
            let u = upper(d[k]);
            if u == "PRIMARY" {
                if upper(type_name) == "INTEGER" and not def.without_rowid {
                    col.rowid_alias = true;
                } else if not def.without_rowid {
                    let mut one: Vec[String] = Vec.new();
                    one.push(name.clone());
                    def.uniques.push(one);
                }
            } else if u == "UNIQUE" {
                let mut one: Vec[String] = Vec.new();
                one.push(name.clone());
                def.uniques.push(one);
            } else if u == "DEFAULT" and k + 1 < d.len() {
                col.default_val = literal(d[k + 1]);
                k += 1;
            }
            k += 1;
        }
        def.cols.push(col);
    }
    for u in table_uniques {
        def.uniques.push(u.clone());
    }
    def
}

// The columns of CREATE INDEX name ON table(cols).
fn index_columns(sql: Str) -> Vec[String] {
    let toks = sql_tokens(sql);
    let mut k: i64 = 0;
    while k < toks.len() and toks[k] != "(" {
        k += 1;
    }
    name_list(toks, k)
}

// ------------------------------------------------------------ walking the b-trees

#[derive(Clone)]
struct PageInfo {
    kind: String,
    name: String,
    path: String,
    cells: i64,
    payload: i64,
    unused: i64,
    max: i64,
}

fn hex_digits(n: i64, width: i64) -> String {
    let h = to_bytes("0123456789abcdef");
    let mut v: Vec[u8] = Vec.new();
    let mut x = n;
    while x > 0 {
        v.push(h[x % 16]);
        x /= 16;
    }
    while v.len() < width {
        v.push(b'0');
    }
    v.reverse();
    from_bytes(v)
}

// What dbstat reports for each page of one b-tree.
fn walk(db: ref Db, no: i64, name: Str, path: Str, info: mut ref Vec[PageInfo]) -> Result[(), String] {
    let page = read_page(db, no)?;
    let leaf = page.is_leaf();
    let hdr = if leaf { 8 } else { 12 };
    let first = if no == 1 { 100 } else { 0 };
    let n = page.cells.len();
    let mut unused = page.content - hdr - first - 2 * n + page.frag;
    let mut off = page.first_free;
    while off != 0 {
        unused += u16_at(db.data, page.base + off + 2);
        off = u16_at(db.data, page.base + off);
    }
    let mut pay: i64 = 0;
    let mut max: i64 = 0;
    for i in 0..n {
        let cell = read_cell(db, page, i);
        if page.flag != TABLE_INTERIOR {
            pay += cell.local;
            if cell.size > max {
                max = cell.size;
            }
        }
        let chain = overflow_pages(db, cell);
        let mut left = cell.size - cell.local;
        for k in 0..chain.len() {
            let here = if left < db.usable - 4 { left } else { db.usable - 4 };
            left -= here;
            info[chain[k]] = PageInfo { kind: "overflow".to_string(), name: name.to_string(), path: f"{path}{hex_digits(i, 3)}+{hex_digits(k, 6)}", cells: 0, payload: here, unused: db.usable - 4 - here, max: 0 };
        }
        if not leaf {
            walk(db, cell.left, name, f"{path}{hex_digits(i, 3)}/", mut info)?;
        }
    }
    if not leaf {
        walk(db, page.right, name, f"{path}{hex_digits(n, 3)}/", mut info)?;
    }
    let kind = if leaf { "leaf" } else { "internal" };
    info[no] = PageInfo { kind: kind.to_string(), name: name.to_string(), path: path.to_string(), cells: n, payload: pay, unused: unused, max: max };
    Ok(())
}

// Every row of a rowid table, in rowid order.
fn table_rows(db: ref Db, no: i64, out: mut ref Vec[(i64, Vec[Val])]) -> Result[(), String] {
    table_range(db, no, -9223372036854775807 - 1, 9223372036854775807, mut out)
}

// The rows with a <= rowid <= b, visiting only the subtrees that can
// hold them.
fn table_range(db: ref Db, no: i64, a: i64, b: i64, out: mut ref Vec[(i64, Vec[Val])]) -> Result[(), String] {
    let page = read_page(db, no)?;
    let n = page.cells.len();
    if page.is_leaf() {
        for i in 0..n {
            let cell = read_cell(db, page, i);
            if cell.rowid >= a and cell.rowid <= b {
                out.push((cell.rowid, record_of(db, cell)));
            }
        }
        return Ok(());
    }
    let mut prev: i64 = 0;
    for i in 0..n {
        let cell = read_cell(db, page, i);
        if cell.rowid >= a and (i == 0 or prev < b) {
            table_range(db, cell.left, a, b, mut out)?;
        }
        prev = cell.rowid;
    }
    if n == 0 or prev < b {
        table_range(db, page.right, a, b, mut out)?;
    }
    Ok(())
}

// SQLite's BINARY comparison of two values: NULL, then numbers, then
// text, then blobs; text and blobs compare by bytes.
fn class_of(v: ref Val) -> i64 {
    match v {
        Val.Null => 0,
        Val.Int(_) => 1,
        Val.Real(_) => 1,
        Val.Text(_) => 2,
        Val.Blob(_) => 3,
    }
}

fn compare_bytes(a: ref Vec[u8], b: ref Vec[u8]) -> i64 {
    let n = if a.len() < b.len() { a.len() } else { b.len() };
    for i in 0..n {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 };
        }
    }
    if a.len() == b.len() { 0 } else if a.len() < b.len() { -1 } else { 1 }
}

fn as_f64(v: ref Val) -> f64 {
    match v {
        Val.Int(n) => *n as f64,
        Val.Real(x) => *x,
        _ => 0.0,
    }
}

fn compare_vals(a: ref Val, b: ref Val) -> i64 {
    let ca = class_of(a);
    let cb = class_of(b);
    if ca != cb {
        return if ca < cb { -1 } else { 1 };
    }
    match (a, b) {
        (Val.Int(x), Val.Int(y)) => if *x < *y { -1 } else if *x > *y { 1 } else { 0 },
        (Val.Text(x), Val.Text(y)) => compare_bytes(to_bytes(x), to_bytes(y)),
        (Val.Blob(x), Val.Blob(y)) => compare_bytes(x, y),
        _ => {
            if ca == 1 {
                let x = as_f64(a);
                let y = as_f64(b);
                if x < y { -1 } else if x > y { 1 } else { 0 }
            } else {
                0
            }
        }
    }
}

// Every entry of an index b-tree in order: an interior cell's own entry
// comes after its left subtree.
fn index_entries(db: ref Db, no: i64, out: mut ref Vec[Vec[Val]]) -> Result[(), String] {
    let page = read_page(db, no)?;
    for i in 0..page.cells.len() {
        let cell = read_cell(db, page, i);
        if not page.is_leaf() {
            index_entries(db, cell.left, mut out)?;
        }
        out.push(record_of(db, cell));
    }
    if not page.is_leaf() {
        index_entries(db, page.right, mut out)?;
    }
    Ok(())
}

// The entries whose first column equals `key`, in index order.
fn index_equal(db: ref Db, no: i64, key: ref Val, out: mut ref Vec[Vec[Val]]) -> Result[(), String] {
    let page = read_page(db, no)?;
    let n = page.cells.len();
    let mut prev: i64 = -1;
    for i in 0..n {
        let cell = read_cell(db, page, i);
        let rec = record_of(db, cell);
        let c = compare_vals(rec[0], key);
        if not page.is_leaf() and c >= 0 and (i == 0 or prev <= 0) {
            index_equal(db, cell.left, key, mut out)?;
        }
        if c == 0 {
            out.push(rec);
        }
        prev = c;
    }
    if not page.is_leaf() and (n == 0 or prev <= 0) {
        index_equal(db, page.right, key, mut out)?;
    }
    Ok(())
}

fn free_pages(db: ref Db) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut trunk = u32_at(db.data, 32);
    while trunk != 0 {
        out.push(trunk);
        let base = (trunk - 1) * db.page_size;
        let n = u32_at(db.data, base + 4);
        for k in 0..n {
            out.push(u32_at(db.data, base + 8 + 4 * k));
        }
        trunk = u32_at(db.data, base);
    }
    out
}

fn auto_vacuum(db: ref Db) -> bool {
    u32_at(db.data, 52) != 0
}

// Pointer-map pages: page 2 and then one every usable/5 + 1 pages.
fn is_ptrmap(db: ref Db, p: i64) -> bool {
    auto_vacuum(db) and p >= 2 and (p - 2) % (db.usable / 5 + 1) == 0
}

// The pointer-map entry for page p: its type and its parent page.
fn ptrmap_entry(db: ref Db, p: i64) -> (i64, i64) {
    let span = db.usable / 5 + 1;
    let m = 2 + (p - 2) / span * span;
    let at = (m - 1) * db.page_size + 5 * (p - m - 1);
    (db.data[at] as i64, u32_at(db.data, at + 1))
}

