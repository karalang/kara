    s.push_str("pack('<L', -1)\n");
    s.push_str("pack('<q', 9223372036854775808)\n");
    s.push_str("pack('<Q', -1)\n");
    s.push_str("pack('<Q', 18446744073709551616)\n");
    s.push_str("pack('h', 40000)\n");
    s.push_str("pack('i', 2147483648)\n");
    s.push_str("pack('I', -1)\n");
    s.push_str("pack('l', 9223372036854775808)\n");
    s.push_str("pack('L', -1)\n");
    s.push_str("pack('q', -9223372036854775809)\n");
