// mini_hijri — the converter core of hijri-converter 2.3.2 (MIT, Mohammed
// Alshehri), the library that converts between the Gregorian calendar and the
// Umm al-Qura lunar Hijri calendar used across the Islamic world.
//
// Ports hijri_converter.convert (the Hijri and Gregorian date objects),
// helpers (the Julian-day conversions) and the Umm al-Qura MONTH_STARTS table
// from ummalqura, plus the en/ar/bn name tables from locales. The arithmetic
// is exactly the library's — a proleptic-Gregorian ordinal (ported from
// CPython's date.toordinal / fromordinal), the reduced Julian day, and a
// bisect into MONTH_STARTS — so every conversion, weekday, month length and
// range/validation error matches the library. All integer; no float anywhere.
//
// MONTH_STARTS is stored as one digit per month-length delta (delta-28) and
// rebuilt at run time; the name tables are the library's verbatim.

fn to_bytes(s: String) -> Vec[i64] {
    let mut v = Vec.new();
    for c in s.bytes() {
        v.push(c as i64);
    }
    v
}

fn parse_u(s: String) -> i64 {
    let v = to_bytes(s);
    let mut t = 0;
    let mut k = 0;
    while k < v.len() {
        if v[k] >= 48 and v[k] <= 57 {
            t = t * 10 + (v[k] - 48);
        }
        k = k + 1;
    }
    t
}

fn int_str(n: i64) -> String {
    f"{n}"
}

fn pad(n: i64, width: i64) -> String {
    let mut s = int_str(n);
    while s.len() < width {
        s = f"0{s}";
    }
    s
}

fn isleap(y: i64) -> bool {
    y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)
}

// Cumulative days before month m (1..12), non-leap.
fn dbm(m: i64) -> i64 {
    let mut v = Vec.new();
    v.push(0);
    v.push(0);
    v.push(31);
    v.push(59);
    v.push(90);
    v.push(120);
    v.push(151);
    v.push(181);
    v.push(212);
    v.push(243);
    v.push(273);
    v.push(304);
    v.push(334);
    v[m]
}

fn dim(m: i64) -> i64 {
    let mut v = Vec.new();
    v.push(0);
    v.push(31);
    v.push(28);
    v.push(31);
    v.push(30);
    v.push(31);
    v.push(30);
    v.push(31);
    v.push(31);
    v.push(30);
    v.push(31);
    v.push(30);
    v.push(31);
    v[m]
}

fn ymd2ord(y: i64, m: i64, d: i64) -> i64 {
    let yy = y - 1;
    let dby = yy * 365 + yy / 4 - yy / 100 + yy / 400;
    let mut extra = 0;
    if m > 2 and isleap(y) {
        extra = 1;
    }
    dby + dbm(m) + extra + d
}

#[derive(Clone)]
struct Ymd {
    y: i64,
    m: i64,
    d: i64,
}

fn ord2ymd(n0: i64) -> Ymd {
    let mut n = n0 - 1;
    let n400 = n / 146097;
    n = n % 146097;
    let mut year = n400 * 400 + 1;
    let n100 = n / 36524;
    n = n % 36524;
    let n4 = n / 1461;
    n = n % 1461;
    let n1 = n / 365;
    n = n % 365;
    year = year + n100 * 100 + n4 * 4 + n1;
    if n1 == 4 or n100 == 4 {
        return Ymd { y: year - 1, m: 12, d: 31 };
    }
    let leap = n1 == 3 and (n4 != 24 or n100 == 3);
    let mut month = (n + 50) / 32;
    let mut extra = 0;
    if month > 2 and leap {
        extra = 1;
    }
    let mut preceding = dbm(month) + extra;
    if preceding > n {
        month = month - 1;
        let mut sub = dim(month);
        if month == 2 and leap {
            sub = sub + 1;
        }
        preceding = preceding - sub;
    }
    n = n - preceding;
    Ymd { y: year, m: month, d: n + 1 }
}

fn month_starts() -> Vec[i64] {
    let mut v = Vec.new();
    let mut acc = ms_base();
    v.push(acc);
    let db = to_bytes(ms_deltas());
    let n = db.len();
    let mut i = 0;
    while i < n {
        acc = acc + 28 + (db[i] - 48);
        v.push(acc);
        i = i + 1;
    }
    v
}

// bisect.bisect (== bisect_right): insertion point to the right of x.
fn bisect_right(v: Vec[i64], x: i64) -> i64 {
    let mut lo = 0;
    let mut hi = v.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if x < v[mid] {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    lo
}

// Constants from ummalqura.
fn hijri_offset() -> i64 {
    16104
}

fn hmin_year() -> i64 {
    1343
}

fn hmax_year() -> i64 {
    1500
}

// Lexicographic (y,m,d) compare: -1, 0, 1.
fn cmp_ymd(ay: i64, am: i64, ad: i64, by: i64, bm: i64, bd: i64) -> i64 {
    if ay != by {
        if ay < by { -1 } else { 1 }
    } else if am != bm {
        if am < bm { -1 } else { 1 }
    } else if ad != bd {
        if ad < bd { -1 } else { 1 }
    } else {
        0
    }
}

fn name_at(names: Vec[String], i: i64) -> String {
    names[i].clone()
}

// Gregorian (y,m,d) -> Hijri, with the library's range check. Returns the
// output block, or an `error=` line.
fn g2h(y: i64, m: i64, d: i64) -> String {
    // _check_range: (y,m,d) within ((1924,8,1),(2077,11,16))
    if cmp_ymd(y, m, d, 1924, 8, 1) < 0 or cmp_ymd(y, m, d, 2077, 11, 16) > 0 {
        return "  error=date out of range".to_string();
    }
    let ord = ymd2ord(y, m, d);
    let jdn = ord + 1721425;
    let rjd = jdn - 2400000;
    let ms = month_starts();
    let index = bisect_right(ms, rjd) - 1;
    let months = index + hijri_offset();
    let years = months / 12;
    let hy = years + 1;
    let hm = months - years * 12 + 1;
    let hd = rjd - ms[index] + 1;
    let length = ms[index + 1] - ms[index];
    let weekday = jdn % 7;
    let mut out = String.new();
    out.push_str(f"  hijri_iso={pad(hy, 4)}-{pad(hm, 2)}-{pad(hd, 2)}\n");
    out.push_str(f"  hijri_dmy={pad(hd, 2)}/{pad(hm, 2)}/{int_str(hy)}\n");
    out.push_str(f"  hijri_dmy2={int_str(hd)}-{int_str(hm)}-{int_str(hy)}\n");
    out.push_str(f"  month_en={name_at(hmon_en(), hm - 1)}\n");
    out.push_str(f"  month_ar={name_at(hmon_ar(), hm - 1)}\n");
    out.push_str(f"  month_bn={name_at(hmon_bn(), hm - 1)}\n");
    out.push_str(f"  day_en={name_at(day_en(), weekday)}\n");
    out.push_str(f"  weekday={int_str(weekday)}\n");
    out.push_str(f"  isoweekday={int_str(weekday + 1)}\n");
    out.push_str(f"  length={int_str(length)}\n");
    out.push_str("  notation=AH");
    out
}

// Hijri (y,m,d) -> Gregorian, with the library's validation.
fn h2g(y: i64, m: i64, d: i64) -> String {
    if y < hmin_year() or y > hmax_year() {
        return "  error=date out of range".to_string();
    }
    if m < 1 or m > 12 {
        return "  error=month must be in 1..12".to_string();
    }
    let ms = month_starts();
    let index = (y - 1) * 12 + m - 1 - hijri_offset();
    let length = ms[index + 1] - ms[index];
    if d < 1 or d > length {
        return f"  error=day must be in 1..{int_str(length)} for month";
    }
    let rjd = ms[index] + d - 1;
    let jdn = rjd + 2400000;
    let don = jdn - 1721425;
    let g = ord2ymd(don);
    let weekday = jdn % 7;
    let mut out = String.new();
    out.push_str(f"  greg_iso={pad(g.y, 4)}-{pad(g.m, 2)}-{pad(g.d, 2)}\n");
    out.push_str(f"  greg_dmy={pad(g.d, 2)}/{pad(g.m, 2)}/{int_str(g.y)}\n");
    out.push_str(f"  month_en={name_at(gmon_en(), g.m - 1)}\n");
    out.push_str(f"  month_ar={name_at(gmon_ar(), g.m - 1)}\n");
    out.push_str(f"  day_en={name_at(day_en(), weekday)}\n");
    out.push_str("  notation=CE");
    out
}

fn run_job(fields: Vec[String]) -> String {
    let dir = fields[0].clone();
    let s = fields[1].clone();
    let y = parse_u(s.substring(0, 4));
    let m = parse_u(s.substring(5, 7));
    let d = parse_u(s.substring(8, 10));
    if dir == "g2h" {
        g2h(y, m, d)
    } else {
        h2g(y, m, d)
    }
}

fn main() {
    let _ = fs.create_dir_all("data");
    let _ = fs.write("data/jobs.tsv", jobs_text());
    let jobs = fs.read_to_string("data/jobs.tsv").unwrap_or(String.new());
    let mut out = String.new();
    for line in jobs.lines() {
        let fields: Vec[String] = line.split("\t").map(|p| p.to_string()).collect();
        if fields.len() < 2 {
            continue;
        }
        out.push_str("== ");
        out.push_str(fields.join(" | "));
        out.push_str("\n");
        out.push_str(run_job(fields));
        out.push_str("\n");
    }
    print(out);
}
fn ms_base() -> i64 { 23999 }

