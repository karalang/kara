// data/jobs.tsv, as mk.py writes it.
fn jobs_text() -> String {
    let mut s = String.new();
    s.push_str("g2h\t1924-08-02\n");
    s.push_str("g2h\t2023-10-22\n");
    s.push_str("g2h\t2000-01-01\n");
    s.push_str("g2h\t1990-05-20\n");
    s.push_str("g2h\t2077-11-16\n");
    s.push_str("g2h\t1924-07-31\n");
    s.push_str("g2h\t2077-11-17\n");
    s.push_str("h2g\t1445-04-07\n");
    s.push_str("h2g\t1343-01-01\n");
    s.push_str("h2g\t1500-12-30\n");
    s.push_str("h2g\t1446-09-01\n");
    s.push_str("h2g\t1411-06-05\n");
    s.push_str("h2g\t1342-12-30\n");
    s.push_str("h2g\t1501-01-01\n");
    s.push_str("h2g\t1445-13-01\n");
    s.push_str("h2g\t1445-01-40\n");
    s.push_str("h2g\t1445-12-29\n");
    s
}
