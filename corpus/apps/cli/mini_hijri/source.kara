    s.push_str("212111212122212121211221212212112121212221211212121221212121212121221212121212121221221211212122121212112121222121211212");
    s.push_str("122212121121122122212112112212212121212121212212121212121212212121211212212212121121212221212112121221221211211221222121");
    s.push_str("121122122122112112122212121211212212212121211212212122121211212122212121121212212212121121222212112111222212211211122212");
    s.push_str("212121121212212212112121212212122121121212212212112121221221211211222122121121122122122112121212122121212112122212121211");
    s.push_str("212212212121121212212211212121212212121212121212212211212112212221121121212221212112121222121211212122122121121212122121");
    s.push_str("212121212122121221121212122212112112122212211211212221212121121221221212112121221221212112121221221211212121222121121212");
    s.push_str("122211212121122212121212112212122121211212122212121121122122212112112212221211211221221212121122121221212121212121212212");
