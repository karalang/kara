// mini_spellchecker: pyspellchecker 0.8.1, Tyler Barrus's spell checker
// after Peter Norvig's "How to Write a Spelling Corrector", as a
// documentation team uses it: a dictionary built from the team's own
// docs (data/corpus.txt), documents from the review queue checked against
// it, and the dictionary edited, exported to JSON and opened again. It
// reads its commands from data/jobs.txt.
//
// The port follows spellchecker.py and utils.py: a word frequency table
// (a Counter in Python) with the totals, the letter set and the longest
// word it keeps up to date, the regex tokenizer, the "should this be
// checked at all" rule (single punctuation, too long, or anything
// Python's float() accepts), and candidates at edit distance one, then
// two. Python returns sets; this port returns them sorted, as the oracle
// prints them.

const MASK32: i64 = 4294967295;

fn fnv(text: ref String) -> i64 {
    let mut h = 2166136261;
    for b in text.bytes() {
        h = ((h ^ (b as i64)) * 16777619) & MASK32;
    }
    h
}

fn join(xs: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..xs.len() as i64 {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(xs[i]);
    }
    out
}

fn from_chars(c: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut s = String.new();
    for i in lo..hi {
        s.push(c[i]);
    }
    s
}

fn sorted_set(s: ref Set[String]) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for w in s.iter() {
        out.push(w.clone());
    }
    out.sort();
    out
}

// Python prints a set as {a, b}; None when there is none.
fn show_set(xs: ref Option[Vec[String]]) -> String {
    match xs {
        Some(v) => "{".to_string() + join(v, ", ") + "}".to_string(),
        None => "None".to_string(),
    }
}

fn py_bool(b: bool) -> String {
    if b {
        "True".to_string()
    } else {
        "False".to_string()
    }
}

// ------------------------------------------------------------ utils.py
// _parse_into_words: re.findall(r"(\w[\w']*\w|\w)", text). The greedy run
// of word characters and apostrophes gives back trailing apostrophes so
// that the match ends on a word character.

fn is_word_char(c: char) -> bool {
    c.is_alphanumeric() or c == '_'
}

fn parse_into_words(text: ref String) -> Vec[String] {
    let cs: Vec[char] = text.chars().collect();
    let n = cs.len() as i64;
    let mut out: Vec[String] = Vec.new();
    let mut i = 0;
    while i < n {
        if is_word_char(cs[i]) {
            let mut j = i + 1;
            while j < n and (is_word_char(cs[j]) or cs[j] == '\'') {
                j += 1;
            }
            let mut e = j;
            while e > i + 1 and cs[e - 1] == '\'' {
                e -= 1;
            }
            out.push(from_chars(cs, i, e));
            i = e;
        } else {
            i += 1;
        }
    }
    out
}

// string.punctuation
fn is_punctuation(c: char) -> bool {
    for p in "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~".chars() {
        if p == c {
            return true;
        }
    }
    false
}

fn is_digit(cs: ref Vec[char], i: i64) -> bool {
    i < cs.len() as i64 and cs[i].is_ascii_digit()
}

// digitpart: digit (["_"] digit)*, from a digit at i; returns the end.
fn digit_part(cs: ref Vec[char], start: i64) -> i64 {
    let n = cs.len() as i64;
    let mut i = start + 1;
    while i < n {
        if cs[i].is_ascii_digit() {
            i += 1;
        } else if cs[i] == '_' and is_digit(cs, i + 1) {
            i += 2;
        } else {
            break;
        }
    }
    i
}

// Whether Python's float() accepts the text: surrounding whitespace, a
// sign, then inf, infinity or nan in any case, or a decimal number with
// optional fraction and exponent, digits grouped by single underscores.
fn python_float_accepts(word: ref String) -> bool {
    let cs: Vec[char] = word.trim().chars().collect();
    let n = cs.len() as i64;
    let mut i = 0;
    if i < n and (cs[i] == '+' or cs[i] == '-') {
        i += 1;
    }
    let rest = from_chars(cs, i, n).to_lowercase();
    if rest == "inf" or rest == "infinity" or rest == "nan" {
        return true;
    }
    let mut digits = false;
    if is_digit(cs, i) {
        i = digit_part(cs, i);
        digits = true;
    }
    if i < n and cs[i] == '.' {
        i += 1;
        if is_digit(cs, i) {
            i = digit_part(cs, i);
            digits = true;
        }
    }
    if not digits {
        return false;
    }
    if i < n and (cs[i] == 'e' or cs[i] == 'E') {
        i += 1;
        if i < n and (cs[i] == '+' or cs[i] == '-') {
            i += 1;
        }
        if not is_digit(cs, i) {
            return false;
        }
        i = digit_part(cs, i);
    }
    i == n
}

// ------------------------------------------------------------ WordFrequency
// The Counter of words and what _update_dictionary keeps beside it. A
// checker that is not case-sensitive folds every word to lower case on
// the way in and on every lookup.

struct WordFrequency {
    dictionary: Map[String, i64],
    total_words: i64,
    unique_words: i64,
    letters: Vec[char],
    longest_word_length: i64,
    case_sensitive: bool,
}

impl WordFrequency {
    fn new(case_sensitive: bool) -> WordFrequency {
        WordFrequency {
            dictionary: Map.new(),
            total_words: 0,
            unique_words: 0,
            letters: Vec.new(),
            longest_word_length: 0,
            case_sensitive: case_sensitive,
        }
    }

    fn fold(ref self, word: ref String) -> String {
        if self.case_sensitive {
            word.clone()
        } else {
            word.to_lowercase()
        }
    }

    fn contains(ref self, word: ref String) -> bool {
        self.dictionary.contains_key(self.fold(word))
    }

    fn get(ref self, word: ref String) -> i64 {
        self.dictionary.get(self.fold(word)) ?? 0
    }

    // Counter.update: counts add to what is there.
    fn bump(mut ref self, key: own String, n: i64) {
        let had = self.dictionary.get(key) ?? 0;
        self.dictionary.insert(key, had + n);
    }

    fn update_dictionary(mut ref self) {
        self.longest_word_length = 0;
        let mut total = 0;
        let mut letters: Set[char] = Set.new();
        let mut longest = 0;
        for (k, v) in self.dictionary.iter() {
            total += *v;
            let mut n = 0;
            for c in k.chars() {
                letters.insert(c);
                n += 1;
            }
            if n > longest {
                longest = n;
            }
        }
        self.total_words = total;
        self.unique_words = self.dictionary.len();
        self.longest_word_length = longest;
        let mut ls: Vec[char] = Vec.new();
        for c in letters.iter() {
            ls.push(*c);
        }
        ls.sort();
        self.letters = ls;
    }

    fn tokenize(ref self, text: ref String) -> Vec[String] {
        let mut out: Vec[String] = Vec.new();
        for w in parse_into_words(text) {
            out.push(self.fold(w));
        }
        out
    }

    fn load_text(mut ref self, text: ref String) {
        for w in self.tokenize(text).into_iter() {
            self.bump(w, 1);
        }
        self.update_dictionary();
    }

    fn load_words(mut ref self, words: ref Vec[String]) {
        for i in 0..words.len() as i64 {
            let k = self.fold(words[i]);
            self.bump(k, 1);
        }
        self.update_dictionary();
    }

    // load_json, and add() through it.
    fn load_counts(mut ref self, counts: ref Vec[(String, i64)]) {
        for i in 0..counts.len() as i64 {
            self.bump(counts[i].0.clone(), counts[i].1);
        }
        self.update_dictionary();
    }

    fn add(mut ref self, word: ref String, val: i64) {
        let mut one: Vec[(String, i64)] = Vec.new();
        one.push((self.fold(word), val));
        self.load_counts(one);
    }

    fn pop(mut ref self, word: ref String) -> Option[i64] {
        let k = self.fold(word);
        self.dictionary.remove(k)
    }

    fn remove(mut ref self, word: ref String) {
        let _ = self.pop(word);
        self.update_dictionary();
    }

    fn remove_words(mut ref self, words: ref Vec[String]) {
        for i in 0..words.len() as i64 {
            let _ = self.pop(words[i]);
        }
        self.update_dictionary();
    }

    fn remove_by_threshold(mut ref self, threshold: i64) {
        let mut doomed: Vec[String] = Vec.new();
        for (k, v) in self.dictionary.iter() {
            if *v <= threshold {
                doomed.push(k.clone());
            }
        }
        self.remove_words(doomed);
    }

    // The words with their counts, most frequent first, ties by word.
    fn top(ref self, n: i64) -> Vec[(String, i64)] {
        let mut all: Vec[(String, i64)] = Vec.new();
        for (k, v) in self.dictionary.iter() {
            all.push((k.clone(), *v));
        }
        all.sort_by(|a, b| if a.1 != b.1 { b.1.cmp(a.1) } else { a.0.cmp(b.0) });
        let mut out: Vec[(String, i64)] = Vec.new();
        for i in 0..all.len() as i64 {
            if i < n {
                out.push((all[i].0.clone(), all[i].1));
            }
        }
        out
    }
}

// ------------------------------------------------------------ SpellChecker

struct SpellChecker {
    wf: WordFrequency,
    distance: i64,
}

// The distance setter: 1 or 2, anything else becomes 2.
fn valid_distance(val: i64) -> i64 {
    if val > 0 and val <= 2 {
        val
    } else {
        2
    }
}

impl SpellChecker {
    fn new(distance: i64, case_sensitive: bool) -> SpellChecker {
        SpellChecker { wf: WordFrequency.new(case_sensitive), distance: valid_distance(distance) }
    }

    fn should_check(ref self, word: ref String) -> bool {
        let n = word.chars().count() as i64;
        if n == 1 and is_punctuation(word.chars().next().unwrap()) {
            return false;
        }
        if n > self.wf.longest_word_length + 3 {
            return false;
        }
        if word.to_lowercase() == "nan" {
            return true;
        }
        if python_float_accepts(word) {
            return false;
        }
        true
    }

    fn in_dictionary(ref self, folded: ref String) -> bool {
        self.wf.dictionary.contains_key(folded)
    }

    fn known(ref self, words: ref Vec[String]) -> Vec[String] {
        let mut s: Set[String] = Set.new();
        for i in 0..words.len() as i64 {
            let w = self.wf.fold(words[i]);
            if self.in_dictionary(w) and self.should_check(w) {
                s.insert(w);
            }
        }
        sorted_set(s)
    }

    fn unknown(ref self, words: ref Vec[String]) -> Vec[String] {
        let mut s: Set[String] = Set.new();
        for i in 0..words.len() as i64 {
            if self.should_check(words[i]) {
                let w = self.wf.fold(words[i]);
                if not self.in_dictionary(w) {
                    s.insert(w);
                }
            }
        }
        sorted_set(s)
    }

    // edit_distance_1: every deletion, transposition, replacement and
    // insertion, with the letters the dictionary uses. A word that is not
    // checked is its own only edit. The set comes back in the order its
    // members were first made.
    fn edit_distance_1(ref self, word: ref String) -> Vec[String] {
        let w = self.wf.fold(word);
        if not self.should_check(w) {
            let mut only: Vec[String] = Vec.new();
            only.push(w);
            return only;
        }
        let cs: Vec[char] = w.chars().collect();
        let n = cs.len() as i64;
        let letters = self.wf.letters.clone();
        let mut seen: Set[String] = Set.new();
        let mut out: Vec[String] = Vec.new();
        for i in 0..n {
            let mut d = from_chars(cs, 0, i);
            d.push_str(from_chars(cs, i + 1, n));
            if seen.insert(d.clone()) {
                out.push(d);
            }
        }
        for i in 0..n - 1 {
            let mut t = from_chars(cs, 0, i);
            t.push(cs[i + 1]);
            t.push(cs[i]);
            t.push_str(from_chars(cs, i + 2, n));
            if seen.insert(t.clone()) {
                out.push(t);
            }
        }
        for i in 0..n {
            let left = from_chars(cs, 0, i);
            let right = from_chars(cs, i + 1, n);
            for c in letters.iter() {
                let mut r = left.clone();
                r.push(*c);
                r.push_str(right);
                if seen.insert(r.clone()) {
                    out.push(r);
                }
            }
        }
        for i in 0..n + 1 {
            let left = from_chars(cs, 0, i);
            let right = from_chars(cs, i, n);
            for c in letters.iter() {
                let mut r = left.clone();
                r.push(*c);
                r.push_str(right);
                if seen.insert(r.clone()) {
                    out.push(r);
                }
            }
        }
        out
    }

    // The words of the dictionary one edit away from any checked word in
    // the list: __edit_distance_alt, then known() over it. Only membership
    // matters here, so each edit is built in one buffer and looked up
    // without the set edit_distance_1 makes. The edits of a folded word
    // are already folded: their letters come from the dictionary's keys.
    fn known_one_edit_from(ref self, words: ref Vec[String]) -> Vec[String] {
        let mut s: Set[String] = Set.new();
        for i in 0..words.len() as i64 {
            if self.should_check(words[i]) {
                let e1 = self.wf.fold(words[i]);
                self.known_edits(e1, mut s);
            }
        }
        sorted_set(s)
    }

    fn keep_if_known(ref self, cand: ref String, s: mut ref Set[String]) {
        if self.in_dictionary(cand) and self.should_check(cand) {
            s.insert(cand.clone());
        }
    }

    fn known_edits(ref self, w: ref String, s: mut ref Set[String]) {
        // edit_distance_1 of an unchecked word is the word itself, which
        // known() then drops for the same reason.
        if not self.should_check(w) {
            return;
        }
        let cs: Vec[char] = w.chars().collect();
        let n = cs.len() as i64;
        let mut buf = String.new();
        for i in 0..n {
            buf.clear();
            for j in 0..n {
                if j != i {
                    buf.push(cs[j]);
                }
            }
            self.keep_if_known(buf, mut s);
        }
        for i in 0..n - 1 {
            buf.clear();
            for j in 0..n {
                if j == i {
                    buf.push(cs[i + 1]);
                } else if j == i + 1 {
                    buf.push(cs[i]);
                } else {
                    buf.push(cs[j]);
                }
            }
            self.keep_if_known(buf, mut s);
        }
        for i in 0..n + 1 {
            let left = from_chars(cs, 0, i);
            let right = from_chars(cs, i, n);
            let after = if i < n { from_chars(cs, i + 1, n) } else { String.new() };
            for c in self.wf.letters.iter() {
                if i < n {
                    buf.clear();
                    buf.push_str(left);
                    buf.push(*c);
                    buf.push_str(after);
                    self.keep_if_known(buf, mut s);
                }
                buf.clear();
                buf.push_str(left);
                buf.push(*c);
                buf.push_str(right);
                self.keep_if_known(buf, mut s);
            }
        }
    }

    fn candidates(ref self, word: ref String) -> Option[Vec[String]] {
        let mut one: Vec[String] = Vec.new();
        one.push(word.clone());
        if not self.known(one).is_empty() {
            return Some(one);
        }
        if not self.should_check(word) {
            let mut same: Vec[String] = Vec.new();
            same.push(word.clone());
            return Some(same);
        }
        let res = self.edit_distance_1(word);
        let k1 = self.known(res);
        if not k1.is_empty() {
            return Some(k1);
        }
        if self.distance == 2 {
            let k2 = self.known_one_edit_from(res);
            if not k2.is_empty() {
                return Some(k2);
            }
        }
        None
    }

    // max(sorted(candidates), key=frequency): the first of the most
    // frequent, in sorted order.
    fn best_of(ref self, c: ref Vec[String]) -> String {
        let mut best = 0;
        for i in 1..c.len() as i64 {
            if self.wf.get(c[i]) > self.wf.get(c[best]) {
                best = i;
            }
        }
        c[best].clone()
    }

    fn correction(ref self, word: ref String) -> Option[String] {
        match self.candidates(word) {
            None => None,
            Some(c) => Some(self.best_of(c)),
        }
    }

    // edit_distance_2 is a list, one entry per edit of an edit, repeats
    // and all; the report gives its length and the known words in it.
    fn edit_distance_2(ref self, word: ref String) -> (i64, Vec[String]) {
        let w = self.wf.fold(word);
        let mut count = 0;
        let mut s: Set[String] = Set.new();
        for e1 in self.edit_distance_1(w) {
            for e2 in self.edit_distance_1(e1) {
                count += 1;
                let k = self.wf.fold(e2);
                if self.in_dictionary(k) and self.should_check(k) {
                    s.insert(k);
                }
            }
        }
        (count, sorted_set(s))
    }
}

// ------------------------------------------------------------ export, load_dictionary
// export() is json.dumps(dictionary, sort_keys=True), written plain (the
// oracle passes gzipped=False). load_dictionary() reads the file, folds
// the whole text to lower case unless the checker is case-sensitive, and
// json.loads it, so keys that fold together keep the last one's count.

fn json_string(s: ref String) -> String {
    let mut out = "\"".to_string();
    for c in s.chars() {
        if c == '"' {
            out.push_str("\\\"");
        } else if c == '\\' {
            out.push_str("\\\\");
        } else {
            out.push(c);
        }
    }
    out.push('"');
    out
}

fn export_text(wf: ref WordFrequency) -> String {
    let mut keys: Vec[String] = Vec.new();
    for (k, _) in wf.dictionary.iter() {
        keys.push(k.clone());
    }
    keys.sort();
    let mut out = "{".to_string();
    for i in 0..keys.len() as i64 {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(json_string(keys[i]));
        out.push_str(": ");
        let n = wf.dictionary.get(keys[i]) ?? 0;
        out.push_str(f"{n}");
    }
    out.push('}');
    out
}

fn skip_ws(cs: ref Vec[char], start: i64) -> i64 {
    let mut i = start;
    while i < cs.len() as i64 and (cs[i] == ' ' or cs[i] == '\n' or cs[i] == '\t' or cs[i] == '\r') {
        i += 1;
    }
    i
}

fn hex_value(c: char) -> i64 {
    let lower: Vec[char] = "0123456789abcdef".chars().collect();
    let upper: Vec[char] = "0123456789ABCDEF".chars().collect();
    for i in 0..16 {
        if lower[i] == c or upper[i] == c {
            return i;
        }
    }
    -1
}

// A JSON string at cs[start] (the opening quote); returns it and the
// index after the closing quote.
fn read_json_string(cs: ref Vec[char], start: i64) -> Result[(String, i64), String] {
    let n = cs.len() as i64;
    let mut i = start + 1;
    let mut out = String.new();
    while i < n {
        let c = cs[i];
        if c == '"' {
            return Ok((out, i + 1));
        }
        if c == '\\' {
            if i + 1 >= n {
                break;
            }
            let e = cs[i + 1];
            if e == 'n' {
                out.push('\n');
                i += 2;
            } else if e == 't' {
                out.push('\t');
                i += 2;
            } else if e == 'u' {
                let mut v = 0;
                for k in 0..4 {
                    let d = if i + 2 + k < n { hex_value(cs[i + 2 + k]) } else { -1 };
                    if d < 0 {
                        return Err(f"bad \\u escape at {i}");
                    }
                    v = v * 16 + d;
                }
                match char.try_from(v as u32) {
                    Ok(ch) => out.push(ch),
                    Err(_) => return Err(f"bad \\u escape at {i}"),
                }
                i += 6;
            } else {
                out.push(e);
                i += 2;
            }
        } else {
            out.push(c);
            i += 1;
        }
    }
    Err("unterminated string".to_string())
}

// A flat JSON object of words to counts, the shape export() writes.
fn parse_counts(text: ref String) -> Result[Map[String, i64], String] {
    let cs: Vec[char] = text.chars().collect();
    let n = cs.len() as i64;
    let mut out: Map[String, i64] = Map.new();
    let mut i = skip_ws(cs, 0);
    if i >= n or cs[i] != '{' {
        return Err("expected {".to_string());
    }
    i = skip_ws(cs, i + 1);
    if i < n and cs[i] == '}' {
        return Ok(out);
    }
    while i < n {
        if cs[i] != '"' {
            return Err(f"expected a key at {i}");
        }
        let (key, after) = read_json_string(cs, i)?;
        i = skip_ws(cs, after);
        if i >= n or cs[i] != ':' {
            return Err(f"expected : at {i}");
        }
        i = skip_ws(cs, i + 1);
        let neg = i < n and cs[i] == '-';
        if neg {
            i += 1;
        }
        if not is_digit(cs, i) {
            return Err(f"expected a count at {i}");
        }
        let mut v = 0;
        while is_digit(cs, i) {
            v = v * 10 + (cs[i] as i64 - '0' as i64);
            i += 1;
        }
        out.insert(key, if neg { -v } else { v });
        i = skip_ws(cs, i);
        if i < n and cs[i] == ',' {
            i = skip_ws(cs, i + 1);
        } else if i < n and cs[i] == '}' {
            return Ok(out);
        } else {
            return Err(f"expected , or }} at {i}");
        }
    }
    Err("unterminated object".to_string())
}

fn load_dictionary(wf: mut ref WordFrequency, path: ref String) -> Result[(), String] {
    let raw = match fs.read_to_string(path.clone()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read {path}: {e}"),
    };
    let data = if wf.case_sensitive { raw } else { raw.to_lowercase() };
    let counts = parse_counts(data)?;
    let mut pairs: Vec[(String, i64)] = Vec.new();
    for (k, v) in counts.iter() {
        pairs.push((k.clone(), *v));
    }
    wf.load_counts(pairs);
    Ok(())
}

// ------------------------------------------------------------ jobs
// One command per line, as oracle.py runs them against the library: a
// command word, then its arguments split at whitespace, or for split,
// check and load_text the rest of the line as text.

fn opt(args: ref Vec[String], key: Str) -> String {
    for i in 0..args.len() as i64 {
        match args[i].split_once("=") {
            Some((k, v)) => {
                if k == key {
                    return v.to_string();
                }
            },
            None => {},
        }
    }
    "".to_string()
}

fn to_int(s: ref String) -> i64 {
    match i64.parse(s) {
        Ok(v) => v,
        Err(_) => 0,
    }
}

fn show_count(v: Option[i64]) -> String {
    match v {
        Some(n) => f"{n}",
        None => "None".to_string(),
    }
}

fn show_word(v: ref Option[String]) -> String {
    match v {
        Some(w) => w.clone(),
        None => "None".to_string(),
    }
}

fn stats_line(wf: ref WordFrequency) -> String {
    let mut letters = String.new();
    for i in 0..wf.letters.len() as i64 {
        letters.push(wf.letters[i]);
    }
    let mut tops: Vec[String] = Vec.new();
    for p in wf.top(6) {
        tops.push(f"{p.0} {p.1}");
    }
    let t = join(tops, ", ");
    f"{wf.total_words} total, {wf.unique_words} unique, longest {wf.longest_word_length}, letters [{letters}]; top {t}"
}

fn ed1_line(edits: ref Vec[String]) -> String {
    let mut e = edits.clone();
    e.sort();
    let n = e.len() as i64;
    let mut first: Vec[String] = Vec.new();
    let mut last: Vec[String] = Vec.new();
    for i in 0..n {
        if i < 6 {
            first.push(e[i].clone());
        }
        if i >= n - 3 {
            last.push(e[i].clone());
        }
    }
    let h = fnv(join(e, " "));
    let a = join(first, " ");
    let b = join(last, " ");
    f"{n} edits, first {a}, last {b}; fnv {h:08x}"
}

// A document from the review queue: its unknown words, each with the
// correction and how many candidates there were, and the hash of the
// document with every correctable word replaced.
fn check_line(sc: ref SpellChecker, text: ref String) -> String {
    let toks = parse_into_words(text);
    let bad = sc.unknown(toks);
    let mut parts: Vec[String] = Vec.new();
    let mut fixes: Map[String, String] = Map.new();
    for i in 0..bad.len() as i64 {
        let w = bad[i].clone();
        // correction() would compute the candidates again; the oracle
        // calls both, and this takes the same pick from the one list.
        let (n, fix) = match sc.candidates(w) {
            Some(c) => (c.len() as i64, Some(sc.best_of(c))),
            None => (0, None),
        };
        let shown = show_word(fix);
        parts.push(f"{w} -> {shown} ({n})");
        match fix {
            Some(f) => {
                fixes.insert(w, f);
            },
            None => {},
        }
    }
    let mut fixed: Vec[String] = Vec.new();
    for i in 0..toks.len() as i64 {
        match fixes.get(toks[i].to_lowercase()) {
            Some(f) => fixed.push(f.clone()),
            None => fixed.push(toks[i].clone()),
        }
    }
    let p = join(parts, "; ");
    let h = fnv(join(fixed, " "));
    f"{toks.len()} words, {bad.len()} unknown: {p}; fnv {h:08x}"
}

fn first_chars(s: ref String, n: i64) -> String {
    let mut out = String.new();
    let mut k = 0;
    for c in s.chars() {
        if k < n {
            out.push(c);
        }
        k += 1;
    }
    out
}

struct Desk {
    names: Vec[String],
    checkers: Vec[SpellChecker],
    cur: i64,
}

impl Desk {
    fn put(mut ref self, name: ref String, sc: own SpellChecker) {
        for i in 0..self.names.len() as i64 {
            if self.names[i] == *name {
                self.checkers[i] = sc;
                self.cur = i;
                return;
            }
        }
        self.names.push(name.clone());
        self.checkers.push(sc);
        self.cur = self.names.len() as i64 - 1;
    }

    fn find(ref self, name: ref String) -> i64 {
        for i in 0..self.names.len() as i64 {
            if self.names[i] == *name {
                return i;
            }
        }
        -1
    }
}

// The commands that change the current checker.
fn edit_job(sc: mut ref SpellChecker, op: ref String, args: ref Vec[String], rest: ref String) -> Result[String, String] {
    if op == "load_text_file" {
        let text = match fs.read_to_string(args[0].clone()) {
            Ok(t) => t,
            Err(e) => return Err(f"cannot read {args[0]}: {e}"),
        };
        sc.wf.load_text(text);
        return Ok(f"{sc.wf.total_words} words");
    }
    if op == "load_text" {
        sc.wf.load_text(rest);
        return Ok(f"{sc.wf.total_words} words");
    }
    if op == "load_words" {
        sc.wf.load_words(args);
        return Ok(f"{sc.wf.total_words} words");
    }
    if op == "add" {
        sc.wf.add(args[0], to_int(args[1]));
        return Ok(f" {args[0]}: {sc.wf.get(args[0])}");
    }
    if op == "pop" {
        let v = sc.wf.pop(args[0]);
        return Ok(f" {args[0]}: {show_count(v)}");
    }
    if op == "remove" {
        sc.wf.remove(args[0]);
        return Ok(f" {args[0]}: {sc.wf.unique_words} words");
    }
    if op == "remove_words" {
        sc.wf.remove_words(args);
        return Ok(f"{sc.wf.unique_words} words");
    }
    if op == "remove_threshold" {
        sc.wf.remove_by_threshold(to_int(args[0]));
        return Ok(f" {args[0]}: {sc.wf.unique_words} words");
    }
    if op == "distance" {
        sc.distance = valid_distance(to_int(args[0]));
        return Ok(f" {args[0]}: {sc.distance}");
    }
    Err(f"unknown op {op}")
}

// The commands that only read it.
fn query_job(sc: ref SpellChecker, op: ref String, args: ref Vec[String], rest: ref String) -> Result[String, String] {
    if op == "stats" {
        return Ok(stats_line(sc.wf));
    }
    if op == "freq" {
        return Ok(f" {args[0]}: {sc.wf.get(args[0])}");
    }
    if op == "contains" {
        return Ok(f" {args[0]}: {py_bool(sc.wf.contains(args[0]))}");
    }
    if op == "split" {
        let toks = parse_into_words(rest);
        return Ok(f"{toks.len()} [{join(toks, "|")}]");
    }
    if op == "known" {
        return Ok(show_set(Some(sc.known(args))));
    }
    if op == "unknown" {
        return Ok(show_set(Some(sc.unknown(args))));
    }
    if op == "candidates" {
        return Ok(f" {args[0]}: {show_set(sc.candidates(args[0]))}");
    }
    if op == "correction" {
        return Ok(f" {args[0]}: {show_word(sc.correction(args[0]))}");
    }
    if op == "ed1" {
        return Ok(f" {args[0]}: {ed1_line(sc.edit_distance_1(args[0]))}");
    }
    if op == "ed2" {
        let (n, k) = sc.edit_distance_2(args[0]);
        return Ok(f" {args[0]}: {n} edits, {k.len()} known: {show_set(Some(k))}");
    }
    if op == "check" {
        return Ok(check_line(sc, rest));
    }
    if op == "export" {
        let data = export_text(sc.wf);
        if let Err(e) = fs.write(args[0].clone(), data.clone()) {
            return Err(f"cannot write {args[0]}: {e}");
        }
        let back = match fs.read_to_string(args[0].clone()) {
            Ok(t) => t,
            Err(e) => return Err(f"cannot read {args[0]}: {e}"),
        };
        return Ok(f" {args[0]}: {back.len()} bytes, starts [{first_chars(back, 60)}]; fnv {fnv(back):08x}");
    }
    Err(f"unknown op {op}")
}

fn is_edit(op: ref String) -> bool {
    op == "load_text_file" or op == "load_text" or op == "load_words" or op == "add" or op == "pop" or op == "remove" or op == "remove_words" or op == "remove_threshold" or op == "distance"
}

fn run_jobs(text: ref String) -> Result[i64, String] {
    let mut desk = Desk { names: Vec.new(), checkers: Vec.new(), cur: -1 };
    let mut lines = 0;
    let all: Vec[String] = text.split("\n").map(|l| l.to_string()).collect();
    for li in 0..all.len() as i64 - 1 {
        let line = all[li].clone();
        if line.starts_with("#") {
            println(line);
            lines += 1;
            continue;
        }
        let (op, rest) = match line.split_once(" ") {
            Some((a, b)) => (a.to_string(), b.to_string()),
            None => (line.clone(), "".to_string()),
        };
        let args: Vec[String] = rest.split_whitespace().map(|p| p.to_string()).collect();
        if op == "new" {
            let d = to_int(opt(args, "distance"));
            let cs = opt(args, "case") == "1";
            desk.put(args[0], SpellChecker.new(d, cs));
            let shown = desk.checkers[desk.cur].distance;
            println(f"{args[0]}: new checker, distance {shown}, case-sensitive {py_bool(cs)}");
        } else if op == "open" {
            let mut sc = SpellChecker.new(2, false);
            load_dictionary(mut sc.wf, args[1])?;
            let n = sc.wf.unique_words;
            desk.put(args[0], sc);
            println(f"{args[0]}: opened {args[1]}, {n} words");
        } else if op == "use" {
            let i = desk.find(args[0]);
            if i < 0 {
                return Err(f"no checker {args[0]}");
            }
            desk.cur = i;
            println(f"{args[0]}: in use");
        } else {
            let name = desk.names[desk.cur].clone();
            let res = if is_edit(op) {
                edit_job(mut desk.checkers[desk.cur], op, args, rest)
            } else {
                query_job(desk.checkers[desk.cur], op, args, rest)
            };
            match res {
                Ok(s) => {
                    if s.starts_with(" ") {
                        println(f"{name} {op}{s}");
                    } else {
                        println(f"{name} {op}: {s}");
                    }
                },
                Err(e) => return Err(e),
            }
        }
        lines += 1;
    }
    Ok(lines)
}

fn main() {
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        eprintln(f"cannot create data: {e}");
        return;
    }
    if let Err(e) = fs.write("data/corpus.txt".to_string(), corpus_text()) {
        eprintln(f"cannot write data/corpus.txt: {e}");
        return;
    }
    if let Err(e) = fs.write("data/jobs.txt".to_string(), jobs_text()) {
        eprintln(f"cannot write data/jobs.txt: {e}");
        return;
    }
    let text = match fs.read_to_string("data/jobs.txt".to_string()) {
        Ok(t) => t,
        Err(e) => {
            eprintln(f"cannot read data/jobs.txt: {e}");
            return;
        },
    };
    if let Err(e) = run_jobs(text) {
        eprintln(f"error: {e}");
    }
    for p in ["data/corpus.txt", "data/jobs.txt", "data/docs.json", "data/names.json"] {
        let _ = fs.remove_file(p.to_string());
    }
}

