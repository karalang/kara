== striptags
-- striptags Markup('Main &raquo;\t<em>About</em>')
   'Main » About'
-- unescape Markup('Main &raquo;\t<em>About</em>')
   'Main »\t<em>About</em>'
-- striptags Markup('<p>Hello <b>World</b></p>')
   'Hello World'
-- unescape Markup('<p>Hello <b>World</b></p>')
   '<p>Hello <b>World</b></p>'
-- striptags Markup('a <!-- hidden <b> --> b')
   'a b'
-- unescape Markup('a <!-- hidden <b> --> b')
   'a <!-- hidden <b> --> b'
-- striptags Markup('a <!-- never closed')
   'a <!-- never closed'
-- unescape Markup('a <!-- never closed')
   'a <!-- never closed'
-- striptags Markup('x < y and y > z')
   'x z'
-- unescape Markup('x < y and y > z')
   'x < y and y > z'
-- striptags Markup('<a href=\'/x\' title="a>b">link</a>')
   'b">link'
-- unescape Markup('<a href=\'/x\' title="a>b">link</a>')
   '<a href=\'/x\' title="a>b">link</a>'
-- striptags Markup('&lt;tag&gt; &amp;amp; &#39; &#x27; &#34; &quot;')
   '<tag> &amp; \' \' " "'
-- unescape Markup('&lt;tag&gt; &amp;amp; &#39; &#x27; &#34; &quot;')
   '<tag> &amp; \' \' " "'
-- striptags Markup('&copy 2024 &copy; &COPY')
   '© 2024 © ©'
-- unescape Markup('&copy 2024 &copy; &COPY')
   '© 2024 © ©'
-- striptags Markup('&notit; &notin; &not')
   '¬it; ∉ ¬'
-- unescape Markup('&notit; &notin; &not')
   '¬it; ∉ ¬'
-- striptags Markup('&#128512; &#x1F600; &#0; &#129; &#xD800; &#1114112; &#65534;')
   '😀 😀 � \x81 � � '
-- unescape Markup('&#128512; &#x1F600; &#0; &#129; &#xD800; &#1114112; &#65534;')
   '😀 😀 � \x81 � � '
-- striptags Markup('&;&#;&#x;&abc')
   '&;&#;&#x;&abc'
-- unescape Markup('&;&#;&#x;&abc')
   '&;&#;&#x;&abc'
-- striptags Markup('&AMP;&ampx')
   '&&x'
-- unescape Markup('&AMP;&ampx')
   '&&x'
-- striptags Markup('line\n\n  two   three\r\n')
   'line two three'
-- unescape Markup('line\n\n  two   three\r\n')
   'line\n\n  two   three\r\n'
-- striptags Markup('<br/><br />text<hr>')
   'text'
-- unescape Markup('<br/><br />text<hr>')
   '<br/><br />text<hr>'
-- striptags Markup('unclosed <tag text')
   'unclosed <tag text'
-- unescape Markup('unclosed <tag text')
   'unclosed <tag text'
-- striptags Markup('<<<>>>')
   '>>'
-- unescape Markup('<<<>>>')
   '<<<>>>'
-- striptags Markup('')
   ''
-- unescape Markup('')
   ''
-- striptags Markup('Caf&eacute; &mdash; cr&egrave;me &frac12; &hellip;')
   'Café — crème ½ …'
-- unescape Markup('Caf&eacute; &mdash; cr&egrave;me &frac12; &hellip;')
   'Café — crème ½ …'
-- striptags Markup('<script>evil()</script>Safe')
   'evil()Safe'
-- unescape Markup('<script>evil()</script>Safe')
   '<script>evil()</script>Safe'
-- striptags Markup('&#9;&#10;&#13;')
   '\t\n\r'
-- unescape Markup('&#9;&#10;&#13;')
   '\t\n\r'
-- striptags Markup('\u3000wide\u3000space\u3000')
   'wide space'
-- unescape Markup('\u3000wide\u3000space\u3000')
   '\u3000wide\u3000space\u3000'
-- striptags Markup('<p>a</p><p>b</p>')
   'ab'
-- unescape Markup('<p>a</p><p>b</p>')
   '<p>a</p><p>b</p>'
-- striptags Markup('<!---->x<!-- -->y')
   'xy'
-- unescape Markup('<!---->x<!-- -->y')
   '<!---->x<!-- -->y'
