== concat
-- add Markup('<em>Hello</em> ') '<foo>'
   Markup('<em>Hello</em> &lt;foo&gt;')
-- add '<foo>' Markup('<em>Hello</em>')
   Markup('&lt;foo&gt;<em>Hello</em>')
-- add Markup('a') Markup('<b>')
   Markup('a<b>')
-- add Markup('a') Badge('<x>')
   Markup('a<span class="badge">&lt;x&gt;</span>')
-- add Badge('<x>') Markup('a')
   Markup('<span class="badge">&lt;x&gt;</span>a')
-- add Markup('a') 3
   error: TypeError: unsupported operand type(s) for +: 'Markup' and 'int'
-- add 3 Markup('a')
   error: TypeError: unsupported operand type(s) for +: 'int' and 'Markup'
-- add Markup('a') None
   error: TypeError: unsupported operand type(s) for +: 'Markup' and 'NoneType'
-- add 'x' '<y>'
   'x<y>'
-- add Markup('a') User('B&B', 'b@x', 2)
   Markup('a<a href="mailto:b@x">B&amp;B</a>')
-- add Markup('') ''
   Markup('')
-- add Markup('&') '&'
   Markup('&&amp;')
-- mul Markup('<br>') 3
   Markup('<br><br><br>')
-- rmul 3 Markup('<br>')
   Markup('<br><br><br>')
-- mul Markup('ab') 0
   Markup('')
-- rmul 0 Markup('ab')
   Markup('')
-- mul Markup('ab') -2
   Markup('')
-- rmul -2 Markup('ab')
   Markup('')
-- mul Markup('<') True
   Markup('<')
-- rmul True Markup('<')
   Markup('<')
== percent
-- mod Markup('<em>%s</em>') ('foo & bar',)
   Markup('<em>foo &amp; bar</em>')
-- mod Markup('%d|%.2f|%s|%r|%5s|%-4s|%i') (5, 2.5, '<a>', '<b>', 'x', 'y', 7.9)
   Markup('5|2.50|&lt;a&gt;|&#39;&lt;b&gt;&#39;|    x|y   |7')
-- mod Markup('%c') (65,)
   error: TypeError: %c requires int or char
-- mod Markup('%d') ('5',)
   Markup('5')
-- mod Markup('%d') ('x',)
   error: ValueError: invalid literal for int() with base 10: 'x'
-- mod Markup('%f') ('x',)
   error: ValueError: could not convert string to float: 'x'
-- mod Markup('%.1f') ('2.25',)
   Markup('2.2')
-- mod Markup('%x') (255,)
   error: TypeError: %x format: an integer is required, not _MarkupEscapeHelper
-- mod Markup('%(a)s %(b)d') {'a': '<', 'b': 3}
   Markup('&lt; 3')
-- mod Markup('%(a)s') {'b': '<'}
   error: KeyError: 'a'
-- mod Markup('%s %s') ('a',)
   error: TypeError: not enough arguments for format string
-- mod Markup('%s') ('a', 'b')
   error: TypeError: not all arguments converted during string formatting
-- mod Markup('%s') [1, '<']
   Markup('[1, &#39;&lt;&#39;]')
-- mod Markup('%s') 'x'
   Markup('x')
-- mod Markup('%z') 'x'
   error: ValueError: unsupported format character 'z' (0x7a) at index 1
-- mod Markup('%s%%') 5
   Markup('5%')
-- mod Markup('%*d') (5, 3)
   error: TypeError: * wants int
-- mod Markup('%05d|%+d|% d|%-5d|') (42, 42, 42, 42)
   Markup('00042|+42| 42|42   |')
-- mod Markup('%d') (True,)
   Markup('1')
-- mod Markup('%s') (None,)
   Markup('None')
-- mod Markup('%.3s') ('<<<<',)
   Markup('&lt')
-- mod Markup('%s by %s') (Markup('<b>x</b>'), User('Zoë', 'z@x', 1))
   Markup('<b>x</b> by <a href="mailto:z@x">Zoë</a>')
-- mod Markup('%s') Badge('a<b')
   Markup('<span class="badge">a&lt;b</span>')
-- mod Markup('%r') Badge('a<b')
   Markup('Badge(&#39;a&lt;b&#39;)')
-- mod Markup('%r') (Plain('<p>'),)
   Markup('Plain(&#39;&lt;p&gt;&#39;)')
-- mod Markup('%s') Plain('<p>')
   Markup('&lt;p&gt;')
-- mod Markup('%(u)s') {'u': User('Q', 'q@x', 9)}
   Markup('<a href="mailto:q@x">Q</a>')
-- mod Markup('%5.1f%%') (99.95,)
   Markup('100.0%')
-- mod Markup('%.0f %.0f %.0f') (0.5, 1.5, 2.5)
   Markup('0 2 2')
-- mod Markup('%f') (1e+22,)
   Markup('10000000000000000000000.000000')
-- mod Markup('%.3f') (-0.0005,)
   Markup('-0.001')
-- mod Markup('%d items') (3.99,)
   Markup('3 items')
-- mod Markup('%s') ()
   error: TypeError: not enough arguments for format string
-- mod Markup('%s') ((),)
   Markup('()')
-- mod Markup('no fields') ()
   Markup('no fields')
-- mod Markup('no fields') ('x',)
   error: TypeError: not all arguments converted during string formatting
-- mod Markup('no fields') {'a': 1}
   Markup('no fields')
-- mod Markup('%(a)s %s') {'a': 1}
   error: TypeError: not enough arguments for format string
-- mod Markup('%') ()
   error: ValueError: incomplete format
-- mod Markup('%(a') {'a': 1}
   error: ValueError: incomplete format key
-- mod Markup('%10.4s|') ('<tag>',)
   Markup('      &lt;|')
-- mod Markup('%-+6d|%06.2f') (7, -1.5)
   Markup('+7    |-01.50')
-- mod Markup('%s') 1e16
   Markup('1e+16')
-- mod Markup('%s') (0.1,)
   Markup('0.1')
-- mod Markup('%r') (2.5,)
   Markup('2.5')
-- mod Markup('%d') (None,)
   error: TypeError: %d format: a real number is required, not _MarkupEscapeHelper
-- mod Markup('%f') (None,)
   error: TypeError: float() argument must be a string or a real number, not 'NoneType'
== format
-- format Markup('<em>{}</em>') ('foo & bar',) {}
   Markup('<em>foo &amp; bar</em>')
-- format Markup('{0!s} {0!r} {0}') (Markup('<b>'),) {}
   Markup('&lt;b&gt; Markup(&#39;&lt;b&gt;&#39;) <b>')
-- format Markup('{0:>5}') (Markup('<b>'),) {}
   error: ValueError: Unsupported format specification for Markup.
-- format Markup('{0:>5}') ('<b>',) {}
   Markup('  &lt;b&gt;')
-- format Markup('{}') (3.25,) {}
   Markup('3.25')
-- format Markup('{:.2f}') (3.255,) {}
   Markup('3.25')
-- format Markup('{x}') () {}
   error: KeyError: 'x'
-- format Markup('{0}{1}') ('a',) {}
   error: IndexError: tuple index out of range
-- format Markup('{user:link} wrote') () {'user': User('Ann <a>', 'ann@x', 7)}
   Markup('<a href="mailto:ann@x">Ann &lt;a&gt;</a> wrote')
-- format Markup('{user:name} | {user}') () {'user': User('Ann <a>', 'ann@x', 7)}
   Markup('Ann &lt;a&gt; | <a href="mailto:ann@x">Ann &lt;a&gt;</a>')
-- format Markup('{user:bogus}') () {'user': User('Ann', 'a@x', 7)}
   error: ValueError: Invalid format spec 'bogus' for User
-- format Markup('{0.name} <{0.email}> #{0.id:03d}') (User('B&B', 'b@x', 5),) {}
   Markup('B&amp;B <b@x> #005')
-- format Markup('{0.nope}') (User('B', 'b@x', 5),) {}
   error: AttributeError: 'User' object has no attribute 'nope'
-- format Markup('{b} {b:x}') () {'b': Badge('<hot>')}
   error: ValueError: Format specifier x given, but <class '__main__.Badge'> does not define __html_format__. A class that defines __html__ must define __html_format__ to work with format specifiers.
-- format Markup('{p} {p!r}') () {'p': Plain('<p>')}
   Markup('&lt;p&gt; Plain(&#39;&lt;p&gt;&#39;)')
-- format Markup('{0[name]} {0[n]:,}') ({'name': '<N>', 'n': 1234567},) {}
   Markup('&lt;N&gt; 1,234,567')
-- format Markup('{0[1]} {0[0]}') (['<a>', '<b>'],) {}
   Markup('&lt;b&gt; &lt;a&gt;')
-- format Markup('{0[2]}') (['<a>'],) {}
   error: IndexError: list index out of range
-- format Markup('{0[k]}') ({},) {}
   error: KeyError: 'k'
-- format Markup('{} {1}') ('a', 'b') {}
   error: ValueError: cannot switch from manual field specification to automatic field numbering
-- format Markup('{0} {}') ('a', 'b') {}
