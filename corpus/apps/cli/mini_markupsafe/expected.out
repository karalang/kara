== escape
-- escape 'plain text'
   Markup('plain text')
-- escape_silent 'plain text'
   Markup('plain text')
-- soft_str 'plain text'
   'plain text'
-- markup 'plain text'
   Markup('plain text')
-- str 'plain text'
   'plain text'
-- repr 'plain text'
   "'plain text'"
-- escape '<script>alert("x")</script>'
   Markup('&lt;script&gt;alert(&#34;x&#34;)&lt;/script&gt;')
-- escape_silent '<script>alert("x")</script>'
   Markup('&lt;script&gt;alert(&#34;x&#34;)&lt;/script&gt;')
-- soft_str '<script>alert("x")</script>'
   '<script>alert("x")</script>'
-- markup '<script>alert("x")</script>'
   Markup('<script>alert("x")</script>')
-- str '<script>alert("x")</script>'
   '<script>alert("x")</script>'
-- repr '<script>alert("x")</script>'
   '\'<script>alert("x")</script>\''
-- escape 'Tom & Jerry'
