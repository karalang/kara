// mini_markupsafe: MarkupSafe 3.0.4, the string type Jinja, Flask and
// Werkzeug autoescape HTML with. A Markup is text already safe for HTML;
// anything combined with it is escaped first. The port covers escape,
// escape_silent and soft_str; Markup's constructor with objects that
// define __html__; + and * on both sides; % formatting through
// markupsafe's escape helper, with CPython's PyUnicode_Format rules and
// its errors (including the ones the helper itself causes, such as %x
// and %c refusing it); format and format_map through markupsafe's
// EscapeFormatter on top of Python's string.Formatter, with the
// format-spec mini-language for str, int and float; every str method
// Markup wraps; unescape with the HTML5 entity table; and striptags.
//
// Python's float repr and %f/%e/format output are done exactly here,
// from the float's binary value. str.lower, upper, title, capitalize,
// swapcase and casefold use data/unicode.txt, which mk.py writes from
// Python's tables for the characters the jobs reach. A forum thread is
// rendered on top, the way a template with autoescaping renders one.
// expected.out is the output of oracle.py, which runs the jobs through
// markupsafe itself.

// ---------------------------------------------------------------- chars

fn to_chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn text(raw: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut s = String.new();
    let mut k = lo;
    while k < hi {
        s.push(raw[k]);
        k += 1;
    }
    s
}

fn char_count(s: ref String) -> i64 {
    let mut n = 0;
    for _c in s.chars() {
        n += 1;
    }
    n
}

fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn is_ident_start(c: char) -> bool {
    c == '_' or (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')
}

fn is_ident(c: char) -> bool {
    is_ident_start(c) or is_digit(c)
}

fn chr(n: i64) -> char {
    match char.try_from(n) {
        Ok(c) => c,
        Err(_) => '?',
    }
}

fn repeat(c: char, n: i64) -> String {
    let mut s = String.new();
    let mut k = 0;
    while k < n {
        s.push(c);
        k += 1;
    }
    s
}

// n >= 0 in the given base, with lower- or upper-case letters.
fn to_base(n: i64, base: i64, upper: bool) -> String {
    if n == 0 {
        return "0".to_string();
    }
    let mut rev: Vec[char] = Vec.new();
    let mut m = n;
    while m > 0 {
        let d = m % base;
        if d < 10 {
            rev.push(chr(48 + d));
        } else if upper {
            rev.push(chr(55 + d));
        } else {
            rev.push(chr(87 + d));
        }
        m = m / base;
    }
    let mut s = String.new();
    let mut k = rev.len() - 1;
    while k >= 0 {
        s.push(rev[k]);
        k -= 1;
    }
    s
}

// Lower-case hex, zero-padded to at least width digits.
fn hex(n: i64, width: i64) -> String {
    let h = to_base(n, 16, false);
    let n_digits = char_count(h);
    if n_digits >= width {
        h
    } else {
        f"{repeat('0', width - n_digits)}{h}"
    }
}

fn is_hex(c: char) -> bool {
    is_digit(c) or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F')
}

fn ascii_lower(c: char) -> char {
    if c >= 'A' and c <= 'Z' { chr(c as i64 + 32) } else { c }
}

// ------------------------------------------------------------ Unicode

struct UInfo {
    lower: String,
    upper: String,
    title: String,
    fold: String,
    flags: String,
}

struct Uni {
    info: Map[char, UInfo],
}

fn hex_value(s: Str) -> i64 {
    let mut v = 0;
    for b in s.bytes() {
        let c = b as i64;
        v = v * 16 + (if c >= 97 { c - 87 } else if c >= 65 { c - 55 } else { c - 48 });
    }
    v
}

fn hex_text(s: Str) -> String {
    let mut out = String.new();
    for part in s.split(" ") {
        if part.len() > 0 {
            out.push(chr(hex_value(part)));
        }
    }
    out
}

fn load_uni() -> Result[Uni, String] {
    let t = match fs.read_to_string("data/unicode.txt") {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/unicode.txt: {e}"),
    };
    let mut info: Map[char, UInfo] = Map.new();
    for line in t.lines() {
        if line.starts_with("#") or line.len() == 0 {
            continue;
        }
        let f: Vec[Str] = line.split(";").collect();
        info.insert(chr(hex_value(f[0])), UInfo {
            lower: hex_text(f[1]),
            upper: hex_text(f[2]),
            title: hex_text(f[3]),
            fold: hex_text(f[4]),
            flags: f[5].to_string(),
        });
    }
    Ok(Uni { info: info })
}

impl Uni {
    fn has(self, c: char, flag: Str) -> bool {
        match self.info.get(c) {
            Some(u) => u.flags.contains(flag),
            None => false,
        }
    }

    fn is_space(self, c: char) -> bool {
        self.has(c, "s")
    }

    fn is_printable(self, c: char) -> bool {
        self.has(c, "p")
    }

    // kind 0 lower, 1 upper, 2 title, 3 casefold.
    fn map_char(self, c: char, kind: i64, out: mut ref String) {
        match self.info.get(c) {
            Some(u) => {
                if kind == 0 {
                    out.push_str(u.lower);
                } else if kind == 1 {
                    out.push_str(u.upper);
                } else if kind == 2 {
                    out.push_str(u.title);
                } else {
                    out.push_str(u.fold);
                }
            }
            None => out.push(c),
        }
    }

    // lower_ucs4: GREEK CAPITAL LETTER SIGMA becomes final sigma after a
    // cased letter with no cased letter following (case-ignorable
    // characters skipped both ways).
    fn lower_at(self, s: ref Vec[char], i: i64, out: mut ref String) {
        let c = s[i];
        if c != '\u{3a3}' {
            self.map_char(c, 0, mut out);
            return;
        }
        let mut j = i - 1;
        while j >= 0 and self.has(s[j], "i") {
            j -= 1;
        }
        let mut fin = j >= 0 and self.has(s[j], "c");
        if fin and i + 1 < s.len() {
            let mut k = i + 1;
            while k < s.len() and self.has(s[k], "i") {
                k += 1;
            }
            fin = k == s.len() or not self.has(s[k], "c");
        }
        out.push(if fin { '\u{3c2}' } else { '\u{3c3}' });
    }

    fn lower(self, s: ref String) -> String {
        let cs = to_chars(s);
        let mut out = String.new();
        for i in 0..cs.len() {
            self.lower_at(cs, i, mut out);
        }
        out
    }

    fn upper(self, s: ref String) -> String {
        let mut out = String.new();
        for c in s.chars() {
            self.map_char(c, 1, mut out);
        }
        out
    }

    fn casefold(self, s: ref String) -> String {
        let mut out = String.new();
        for c in s.chars() {
            self.map_char(c, 3, mut out);
        }
        out
    }

    fn title(self, s: ref String) -> String {
        let cs = to_chars(s);
        let mut out = String.new();
        let mut prev = false;
        for i in 0..cs.len() {
            if prev {
                self.lower_at(cs, i, mut out);
            } else {
                self.map_char(cs[i], 2, mut out);
            }
            prev = self.has(cs[i], "c");
        }
        out
    }

    fn capitalize(self, s: ref String) -> String {
        let cs = to_chars(s);
        let mut out = String.new();
        for i in 0..cs.len() {
            if i == 0 {
                self.map_char(cs[i], 2, mut out);
            } else {
                self.lower_at(cs, i, mut out);
            }
        }
        out
    }

    fn swapcase(self, s: ref String) -> String {
        let cs = to_chars(s);
        let mut out = String.new();
        for i in 0..cs.len() {
            if self.has(cs[i], "u") {
                self.lower_at(cs, i, mut out);
            } else if self.has(cs[i], "l") {
                self.map_char(cs[i], 1, mut out);
            } else {
                out.push(cs[i]);
            }
        }
        out
    }
}


// ------------------------------------------------------------ big integers

// Magnitudes as 32-bit limbs, least significant first, with no high
// zero limbs (zero is the empty vector).
fn big_trim(a: mut ref Vec[u32]) {
    while a.len() > 0 and a[a.len() - 1] == 0 {
        a.pop();
    }
}

fn big_mul_add(a: mut ref Vec[u32], m: u64, add: u64) {
    let mut carry = add;
    for i in 0..a.len() {
        let t = (a[i] as u64) * m + carry;
        a[i] = (t & 4294967295) as u32;
        carry = t >> 32;
    }
    while carry > 0 {
        a.push((carry & 4294967295) as u32);
        carry = carry >> 32;
    }
}

fn big_from_digits(ds: ref Vec[u8]) -> Vec[u32] {
    let mut a: Vec[u32] = Vec.new();
    for d in ds.iter() {
        big_mul_add(mut a, 10, *d as u64);
    }
    big_trim(mut a);
    a
}

fn big_pow10(n: i64) -> Vec[u32] {
    let mut a: Vec[u32] = [1];
    let mut k = n;
    while k >= 9 {
        big_mul_add(mut a, 1000000000, 0);
        k -= 9;
    }
    while k > 0 {
        big_mul_add(mut a, 10, 0);
        k -= 1;
    }
    a
}

fn big_mul(a: ref Vec[u32], b: ref Vec[u32]) -> Vec[u32] {
    let mut out: Vec[u32] = Vec.new();
    for _ in 0..(a.len() + b.len()) {
        out.push(0);
    }
    for i in 0..a.len() {
        let mut carry: u64 = 0;
        for j in 0..b.len() {
            let t = (a[i] as u64) * (b[j] as u64) + (out[i + j] as u64) + carry;
            out[i + j] = (t & 4294967295) as u32;
            carry = t >> 32;
        }
        let mut k = i + b.len();
        while carry > 0 {
            let t = (out[k] as u64) + carry;
            out[k] = (t & 4294967295) as u32;
            carry = t >> 32;
            k += 1;
        }
    }
    big_trim(mut out);
    out
}

fn big_bitlen(a: ref Vec[u32]) -> i64 {
    if a.len() == 0 {
        return 0;
    }
    let mut top = a[a.len() - 1];
    let mut n: i64 = 0;
    while top > 0 {
        n += 1;
        top = top >> 1;
    }
    (a.len() - 1) * 32 + n
}

fn big_shl(a: ref Vec[u32], bits: i64) -> Vec[u32] {
    let mut out: Vec[u32] = Vec.new();
    for _ in 0..(bits / 32) {
        out.push(0);
    }
    let s = bits % 32;
    let mut carry: u64 = 0;
    for i in 0..a.len() {
        let t = ((a[i] as u64) << s) | carry;
        out.push((t & 4294967295) as u32);
        carry = t >> 32;
    }
    if carry > 0 {
        out.push(carry as u32);
    }
    big_trim(mut out);
    out
}

fn big_shr1(a: mut ref Vec[u32]) {
    let mut i = 0;
    while i < a.len() {
        let hi: u32 = if i + 1 < a.len() { a[i + 1] & 1 } else { 0 };
        a[i] = (a[i] >> 1) | (hi << 31);
        i += 1;
    }
    big_trim(mut a);
}

fn big_cmp(a: ref Vec[u32], b: ref Vec[u32]) -> i64 {
    if a.len() != b.len() {
        return if a.len() < b.len() { -1 } else { 1 };
    }
    let mut i = a.len() - 1;
    while i >= 0 {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 };
        }
        i -= 1;
    }
    0
}

// a -= b, where a >= b.
fn big_sub(a: mut ref Vec[u32], b: ref Vec[u32]) {
    let mut borrow: i64 = 0;
    for i in 0..a.len() {
        let bv: i64 = if i < b.len() { b[i] as i64 } else { 0 };
        let mut t = (a[i] as i64) - bv - borrow;
        if t < 0 {
            t += 4294967296;
            borrow = 1;
        } else {
            borrow = 0;
        }
        a[i] = t as u32;
    }
    big_trim(mut a);
}

// ------------------------------------------------------------ decimal to float

// The f64 nearest to digits * 10**exp10, ties to even, as CPython's
// float() gives it. digits holds the digit values without leading zeros.
fn decimal_to_f64(digits: ref Vec[u8], exp10: i64, neg: bool) -> f64 {
    let mut ds = digits.clone();
    let mut e10 = exp10;
    while ds.len() > 0 and ds[ds.len() - 1] == 0 {
        ds.pop();
        e10 += 1;
    }
    let sign: f64 = if neg { -1.0 } else { 1.0 };
    if ds.len() == 0 {
        return sign * 0.0;
    }
    let n = ds.len();
    if n + e10 > 310 {
        return sign * f64.INFINITY;
    }
    if n + e10 < -330 {
        return sign * 0.0;
    }
    // The digits and the power of ten are exact, so one operation
    // rounds correctly.
    if n <= 15 and e10 >= -22 and e10 <= 22 {
        let mut m: f64 = 0.0;
        for d in ds.iter() {
            m = m * 10.0 + (*d as f64);
        }
        let mut p: f64 = 1.0;
        let mut k = if e10 < 0 { -e10 } else { e10 };
        while k > 0 {
            p *= 10.0;
            k -= 1;
        }
        return sign * (if e10 < 0 { m / p } else { m * p });
    }
    let mut num = big_from_digits(ds);
    let mut den: Vec[u32] = [1];
    if e10 >= 0 {
        num = big_mul(num, big_pow10(e10));
    } else {
        den = big_pow10(-e10);
    }
    // q = floor(num * 2**s / den) with 54 bits: the 53 of the result
    // and one to round on.
    let mut s = 54 - (big_bitlen(num) - big_bitlen(den));
    if s > 1075 {
        s = 1075;
    }
    let mut q: u64 = 0;
    let mut rem: Vec[u32] = Vec.new();
    let mut tries = 0;
    while tries < 2 {
        let mut n2 = if s > 0 { big_shl(num, s) } else { num.clone() };
        let d2 = if s < 0 { big_shl(den, -s) } else { den.clone() };
        let mut dd = big_shl(d2, 55);
        q = 0;
        let mut bit = 55;
        while bit >= 0 {
            if big_cmp(n2, dd) >= 0 {
                big_sub(mut n2, dd);
                q = q | ((1 as u64) << bit);
            }
            big_shr1(mut dd);
            bit -= 1;
        }
        rem = n2;
        if q >= ((1 as u64) << 54) and s < 1075 {
            s -= 1;
            tries += 1;
            continue;
        }
        if q < ((1 as u64) << 53) and s < 1075 {
            s += 1;
            tries += 1;
            continue;
        }
        break;
    }
    let mut mant = q >> 1;
    let round = (q & 1) == 1;
    let sticky = rem.len() > 0;
    if round and (sticky or (mant & 1) == 1) {
        mant += 1;
    }
    // The value is mant * 2**(1 - s).
    let mut e2 = 1 - s;
    if mant == ((1 as u64) << 53) {
        mant = mant >> 1;
        e2 += 1;
    }
    let bits: u64 = if mant < ((1 as u64) << 52) {
        // Subnormal: s is 1075 and the exponent field is zero.
        mant
    } else {
        let biased = e2 + 1075;
        if biased >= 2047 {
            return sign * f64.INFINITY;
        }
        ((biased as u64) << 52) | (mant & (((1 as u64) << 52) - 1))
    };
    sign * bits.bits_as_f64()
}

// ------------------------------------------------------------ float to decimal

fn big_to_digits(a: ref Vec[u32]) -> Vec[char] {
    if a.len() == 0 {
        return ['0'];
    }
    let mut x = a.clone();
    let mut chunks: Vec[u64] = Vec.new();
    while x.len() > 0 {
        let mut rem: u64 = 0;
        let mut i = x.len() - 1;
        while i >= 0 {
            let cur = (rem << 32) | (x[i] as u64);
            x[i] = (cur / 1000000000) as u32;
            rem = cur % 1000000000;
            i -= 1;
        }
        big_trim(mut x);
        chunks.push(rem);
    }
    let mut out: Vec[char] = Vec.new();
    let mut k = chunks.len() - 1;
    while k >= 0 {
        let s = chunks[k].to_string();
        if k < chunks.len() - 1 {
            for _ in 0..(9 - s.len()) {
                out.push('0');
            }
        }
        for c in s.chars() {
            out.push(c);
        }
        k -= 1;
    }
    out
}

// The exact decimal value of a finite, non-negative x: its digits with no
// leading zeros (none for zero) and the decimal exponent of the first.
fn exact_digits(x: f64) -> (Vec[char], i64) {
    let bits = x.to_bits();
    let biased = ((bits >> 52) & 2047) as i64;
    let frac = bits & ((1 as u64 << 52) - 1);
    let m: u64 = if biased == 0 { frac } else { frac | (1 as u64 << 52) };
    let q = if biased == 0 { -1074 } else { biased - 1075 };
    if m == 0 {
        return (Vec.new(), 0);
    }
    let mut a: Vec[u32] = Vec.new();
    big_mul_add(mut a, 1, m);
    let mut e10 = 0;
    if q >= 0 {
        a = big_shl(a, q);
    } else {
        // m * 2**q == m * 5**-q * 10**q
        let mut k = 0;
        while k < -q {
            big_mul_add(mut a, 5, 0);
            k += 1;
        }
        e10 = q;
    }
    let mut d = big_to_digits(a);
    while d.len() > 1 and d[d.len() - 1] == '0' {
        d.pop();
        e10 += 1;
    }
    let n = d.len();
    (d, e10 + n - 1)
}

// The exact digits (d, e) rounded half-to-even to keep the digits whose
// place is at least 10**place: the kept digits (possibly empty when all
// round away) and the exponent of the first.
fn round_place(d: ref Vec[char], e: i64, place: i64) -> (Vec[char], i64) {
    let n = e - place + 1;
    if n >= d.len() {
        return (d.clone(), e);
    }
    if n < 0 {
        return (Vec.new(), place);
    }
    let mut keep: Vec[char] = Vec.new();
    for k in 0..n {
        keep.push(d[k]);
    }
    let first = d[n];
    let mut rest = false;
    for k in (n + 1)..d.len() {
        if d[k] != '0' {
            rest = true;
        }
    }
    let odd = n > 0 and (d[n - 1] as i64 - 48) % 2 == 1;
    let up = first > '5' or (first == '5' and (rest or odd));
    if not up {
        while keep.len() > 0 and keep[keep.len() - 1] == '0' {
            keep.pop();
        }
        if keep.len() == 0 {
            return (Vec.new(), place);
        }
        return (keep, e);
    }
    let mut j = keep.len() - 1;
    while j >= 0 and keep[j] == '9' {
        keep.pop();
        j -= 1;
    }
    if j < 0 {
        return (['1'], e + 1);
    }
    keep[j] = chr(keep[j] as i64 + 1);
    (keep, e)
}

fn digit_vals(d: ref Vec[char]) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for c in d.iter() {
        v.push((*c as i64 - 48) as u8);
    }
    v
}

// The shortest digits that read back as x (x finite and non-negative).
// A rounding that reads back keeps reading back with more digits, so the
// count is found by bisection.
fn shortest_digits(x: f64) -> (Vec[char], i64) {
    let (d, e) = exact_digits(x);
    if d.len() == 0 {
        return (['0'], 0);
    }
    let mut lo = 1;
    let mut hi = 17;
    while lo < hi {
        let p = (lo + hi) / 2;
        let (r, re) = round_place(d, e, e - p + 1);
        if r.len() > 0 and decimal_to_f64(digit_vals(r), re - r.len() + 1, false) == x {
            hi = p;
        } else {
            lo = p + 1;
        }
    }
    round_place(d, e, e - lo + 1)
}

fn exp_text(e: i64, upper: bool) -> String {
    let mark = if upper { 'E' } else { 'e' };
    let sign = if e < 0 { '-' } else { '+' };
    let a = if e < 0 { -e } else { e };
    if a < 10 {
        f"{mark}{sign}0{a}"
    } else {
        f"{mark}{sign}{a}"
    }
}

fn is_neg(x: f64) -> bool {
    (x.to_bits() >> 63) == 1
}

// repr(float).
fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    let sign = if is_neg(x) { "-" } else { "" };
    let a = if is_neg(x) { -x } else { x };
    if a == f64.INFINITY {
        return f"{sign}inf";
    }
    let (d, e) = shortest_digits(a);
    let decpt = e + 1;
    let mut s = sign.to_string();
    if decpt <= -4 or decpt > 16 {
        s.push(d[0]);
        if d.len() > 1 {
            s.push('.');
            s.push_str(text(d, 1, d.len()));
        }
        s.push_str(exp_text(e, false));
    } else if decpt <= 0 {
        s.push_str("0.");
        s.push_str(repeat('0', -decpt));
        s.push_str(text(d, 0, d.len()));
    } else if decpt >= d.len() {
        s.push_str(text(d, 0, d.len()));
        s.push_str(repeat('0', decpt - d.len()));
        s.push_str(".0");
    } else {
        s.push_str(text(d, 0, decpt));
        s.push('.');
        s.push_str(text(d, decpt, d.len()));
    }
    s
}

// x (finite, non-negative) with `precision` digits after the point, as
// '%.Nf' writes it: the integer digits and the fraction (with its point).
fn fixed_text(x: f64, precision: i64, alt: bool) -> (String, String) {
    let (d, e) = exact_digits(x);
    let (r, re) = if d.len() == 0 { (Vec.new(), 0) } else { round_place(d, e, -precision) };
    // the digit at place p (0 when outside r)
    let mut int_part = String.new();
    if r.len() == 0 or re < 0 {
        int_part.push('0');
    } else {
        for i in 0..(re + 1) {
            int_part.push(if i < r.len() { r[i] } else { '0' });
        }
    }
    let mut frac = String.new();
    if precision > 0 or alt {
        frac.push('.');
    }
    for p in 1..(precision + 1) {
        let k = re + p;
        frac.push(if r.len() > 0 and k >= 0 and k < r.len() { r[k] } else { '0' });
    }
    (int_part, frac)
}

// x (finite, non-negative) as '%.Ne' writes it.
fn sci_text(x: f64, precision: i64, alt: bool, upper: bool) -> (String, String) {
    let (d, e) = exact_digits(x);
    let (r, re) = if d.len() == 0 { (['0'], 0) } else { round_place(d, e, e - precision) };
    let mut frac = String.new();
    if precision > 0 or alt {
        frac.push('.');
    }
    for k in 1..(precision + 1) {
        frac.push(if k < r.len() { r[k] } else { '0' });
    }
    frac.push_str(exp_text(re, upper));
    (r[0].to_string(), frac)
}

// ------------------------------------------------------------ float() and int() of a str

// A float literal's text (digits, a point, an exponent) to the nearest
// f64.
fn parse_float_text(t: ref Vec[char], neg: bool) -> f64 {
    let mut digits: Vec[u8] = Vec.new();
    let mut exp10: i64 = 0;
    let mut i = 0;
    let mut point = false;
    while i < t.len() {
        let c = t[i];
        if is_digit(c) {
            let d = (c as i64 - 48) as u8;
            if digits.len() > 0 or d != 0 {
                digits.push(d);
            }
            if point {
                exp10 -= 1;
            }
        } else if c == '.' {
            point = true;
        } else if c == 'e' or c == 'E' {
            let mut j = i + 1;
            let mut eneg = false;
            if j < t.len() and (t[j] == '+' or t[j] == '-') {
                eneg = t[j] == '-';
                j += 1;
            }
            let mut ev = 0;
            while j < t.len() {
                ev = ev * 10 + (t[j] as i64 - 48);
                if ev > 100000 {
                    ev = 100000;
                }
                j += 1;
            }
            exp10 += if eneg { -ev } else { ev };
            break;
        }
        i += 1;
    }
    decimal_to_f64(digits, exp10, neg)
}

fn strip_py_space(s: ref String, env: ref Env) -> Vec[char] {
    let cs = to_chars(s);
    let mut a = 0;
    let mut b = cs.len();
    while a < b and env.uni.is_space(cs[a]) {
        a += 1;
    }
    while b > a and env.uni.is_space(cs[b - 1]) {
        b -= 1;
    }
    let mut out: Vec[char] = Vec.new();
    for k in a..b {
        out.push(cs[k]);
    }
    out
}

// int(s): whitespace, a sign, digits with single underscores between.
fn py_int_str(s: ref String, env: ref Env) -> Option[i64] {
    let t = strip_py_space(s, env);
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == '+' or t[i] == '-') {
        neg = t[i] == '-';
        i += 1;
    }
    if i >= t.len() {
        return None;
    }
    let mut v = 0;
    let mut prev_digit = false;
    while i < t.len() {
        let c = t[i];
        if c == '_' {
            if not prev_digit or i + 1 == t.len() {
                return None;
            }
            prev_digit = false;
        } else if is_digit(c) {
            v = v * 10 + (c as i64 - 48);
            prev_digit = true;
        } else {
            return None;
        }
        i += 1;
    }
    Some(if neg { -v } else { v })
}

// float(s): whitespace, a sign, then inf, infinity, nan, or a decimal
// number with single underscores between digits.
fn py_float_str(s: ref String, env: ref Env) -> Option[f64] {
    let t = strip_py_space(s, env);
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == '+' or t[i] == '-') {
        neg = t[i] == '-';
        i += 1;
    }
    let mut word = String.new();
    for k in i..t.len() {
        word.push(ascii_lower(t[k]));
    }
    let sign: f64 = if neg { -1.0 } else { 1.0 };
    if word == "inf" or word == "infinity" {
        return Some(sign * f64.INFINITY);
    }
    if word == "nan" {
        return Some(f64.INFINITY - f64.INFINITY);
    }
    let mut body: Vec[char] = Vec.new();
    let mut seen = false;
    let mut point = false;
    let mut exp = false;
    let mut exp_digit = false;
    while i < t.len() {
        let c = t[i];
        if is_digit(c) {
            if exp {
                exp_digit = true;
            } else {
                seen = true;
            }
        } else if c == '.' and not point and not exp {
            point = true;
        } else if (c == 'e' or c == 'E') and seen and not exp {
            exp = true;
        } else if (c == '+' or c == '-') and exp and (t[i - 1] == 'e' or t[i - 1] == 'E') {
        } else if c == '_' and i > 0 and i + 1 < t.len() and is_digit(t[i - 1]) and is_digit(t[i + 1]) {
            i += 1;
            continue;
        } else {
            return None;
        }
        body.push(c);
        i += 1;
    }
    if not seen or (exp and not exp_digit) {
        return None;
    }
    Some(parse_float_text(body, neg))
}

// ---------------------------------------------------------------- the format spec

struct Spec {
    fill: char,
    align: char,
    sign: char,
    no_neg_0: bool,
    alternate: bool,
    width: i64,
    // 0 none, 1 ',' every 3, 2 '_' every 3, 3 '_' every 4
    sep: i64,
    precision: i64,
    kind: char,
}

fn is_align(c: char) -> bool {
    c == '<' or c == '>' or c == '=' or c == '^'
}

// A presentation type in an error message: 'c', or '\xNN' outside the
// printable ASCII range.
fn code_text(c: char) -> String {
    let o = c as i64;
    if o > 32 and o < 128 {
        f"'{c}'"
    } else {
        f"'\\x{to_base(o, 16, false)}'"
    }
}

fn unknown_code(c: char, tname: ref String) -> PyError {
    value_error(f"Unknown format code {code_text(c)} for object of type '{tname}'")
}

fn both_seps() -> PyError {
    value_error("Cannot specify both ',' and '_'.")
}

// The digits at sp[pos..]: (value, digit count, position after them).
fn spec_integer(sp: ref Vec[char], pos: i64) -> Result[(i64, i64, i64), PyError] {
    let mut acc = 0;
    let mut n = 0;
    let mut p = pos;
    while p < sp.len() and is_digit(sp[p]) {
        let d = sp[p] as i64 - 48;
        if acc > (9223372036854775807 - d) / 10 {
            return Err(value_error("Too many decimal digits in format string"));
        }
        acc = acc * 10 + d;
        n += 1;
        p += 1;
    }
    Ok((acc, n, p))
}

// parse_internal_render_format_spec.
fn parse_spec(sp: ref Vec[char], tname: ref String, default_type: char, default_align: char) -> Result[Spec, PyError] {
    let mut f = Spec {
        fill: ' ',
        align: default_align,
        sign: '\u{0}',
        no_neg_0: false,
        alternate: false,
        width: -1,
        sep: 0,
        precision: -1,
        kind: default_type,
    };
    let end = sp.len();
    let mut pos = 0;
    let mut fill_given = false;
    let mut align_given = false;
    if end - pos >= 2 and is_align(sp[pos + 1]) {
        f.align = sp[pos + 1];
        f.fill = sp[pos];
        fill_given = true;
        align_given = true;
        pos += 2;
    } else if end - pos >= 1 and is_align(sp[pos]) {
        f.align = sp[pos];
        align_given = true;
        pos += 1;
    }
    if pos < end and (sp[pos] == ' ' or sp[pos] == '+' or sp[pos] == '-') {
        f.sign = sp[pos];
        pos += 1;
    }
    if pos < end and sp[pos] == 'z' {
        f.no_neg_0 = true;
        pos += 1;
    }
    if pos < end and sp[pos] == '#' {
        f.alternate = true;
        pos += 1;
    }
    if not fill_given and pos < end and sp[pos] == '0' {
        f.fill = '0';
        if not align_given and default_align == '>' {
            f.align = '=';
        }
        pos += 1;
    }
    let (width, width_digits, after_width) = spec_integer(sp, pos)?;
    pos = after_width;
    if width_digits > 0 {
        f.width = width;
    }
    if pos < end and sp[pos] == ',' {
        f.sep = 1;
        pos += 1;
    }
    if pos < end and sp[pos] == '_' {
        if f.sep != 0 {
            return Err(both_seps());
        }
        f.sep = 2;
        pos += 1;
    }
    if pos < end and sp[pos] == ',' and f.sep == 2 {
        return Err(both_seps());
    }
    if pos < end and sp[pos] == '.' {
        pos += 1;
        let (precision, precision_digits, after_precision) = spec_integer(sp, pos)?;
        pos = after_precision;
        if precision_digits == 0 {
            return Err(value_error("Format specifier missing precision"));
        }
        f.precision = precision;
    }
    if end - pos > 1 {
        return Err(value_error(f"Invalid format specifier '{text(sp, 0, end)}' for object of type '{tname}'"));
    }
    if end - pos == 1 {
        f.kind = sp[pos];
    }
    if f.sep != 0 {
        let t = f.kind;
        let grouped = t == 'd' or t == 'e' or t == 'f' or t == 'g' or t == 'E' or t == 'G' or t == '%' or t == 'F';
        let radix = t == 'b' or t == 'o' or t == 'x' or t == 'X';
        if radix and f.sep == 2 {
            f.sep = 3;
        } else if not grouped {
            let which = if f.sep == 1 { "," } else { "_" };
            return Err(value_error(f"Cannot specify '{which}' with {code_text(t)}."));
        }
    }
    Ok(f)
}

// body padded to width (body is n code points long).
fn pad(body: ref String, n: i64, width: i64, align: char, fill: char) -> String {
    let total = if width > n { width } else { n };
    let left = if align == '>' {
        total - n
    } else if align == '^' {
        (total - n) / 2
    } else {
        0
    };
    f"{repeat(fill, left)}{body}{repeat(fill, total - n - left)}"
}

// _PyUnicode_InsertThousandsGrouping: digits in groups of g, zero-filled
// out to min_width (which counts the separators).
fn group_digits(d: ref String, min_width: i64, g: i64, sep: char) -> String {
    let cs = to_chars(d);
    let mut remaining = cs.len();
    let mut pos = cs.len();
    let mut m = min_width;
    let mut groups: Vec[String] = Vec.new();
    let mut done = false;
    while not done {
        let mut l = remaining;
        if m > l {
            l = m;
        }
        if l < 1 {
            l = 1;
        }
        if l > g {
            l = g;
        }
        let n_zeros = if l > remaining { l - remaining } else { 0 };
        let n_chars = if remaining < l { remaining } else { l };
        groups.push(f"{repeat('0', n_zeros)}{text(cs, pos - n_chars, pos)}");
        pos -= n_chars;
        remaining -= n_chars;
        m -= l;
        if remaining <= 0 and m <= 0 {
            done = true;
        } else {
            m -= 1;
        }
    }
    let mut out = String.new();
    let mut k = groups.len() - 1;
    while k >= 0 {
        out.push_str(groups[k]);
        if k > 0 {
            out.push(sep);
        }
        k -= 1;
    }
    out
}

// calc_number_spec + fill_number: sign, prefix, digits (grouped here) and
// the remainder (a fraction, exponent or '%'), padded per the spec.
fn fill_number(sign: ref String, prefix: ref String, digits: ref String, remainder: ref String, f: ref Spec) -> String {
    let n_sign = char_count(sign);
    let n_prefix = char_count(prefix);
    let n_rem = char_count(remainder);
    let grouped = if f.sep == 0 {
        digits.clone()
    } else {
        let min_width = if f.fill == '0' and f.align == '=' {
            f.width - n_sign - n_prefix - n_rem
        } else {
            0
        };
        let sep = if f.sep == 1 { ',' } else { '_' };
        let g = if f.sep == 3 { 4 } else { 3 };
        group_digits(digits, min_width, g, sep)
    };
    let n = n_sign + n_prefix + char_count(grouped) + n_rem;
    let padding = if f.width > n { f.width - n } else { 0 };
    if f.align == '=' {
        f"{sign}{prefix}{repeat(f.fill, padding)}{grouped}{remainder}"
    } else {
        pad(f"{sign}{prefix}{grouped}{remainder}", n, f.width, f.align, f.fill)
    }
}

fn sign_text(negative: bool, f: ref Spec) -> String {
    if negative {
        "-".to_string()
    } else if f.sign == '+' {
        "+".to_string()
    } else if f.sign == ' ' {
        " ".to_string()
    } else {
        String.new()
    }
}

// ---------------------------------------------------------------- str, int, float

// format_string_internal.
fn format_str(s: ref String, sp: ref Vec[char]) -> Result[String, PyError] {
    let f = parse_spec(sp, "str", 's', '<')?;
    if f.kind != 's' {
        return Err(unknown_code(f.kind, "str"));
    }
    if f.sign == ' ' {
        return Err(value_error("Space not allowed in string format specifier"));
    }
    if f.sign != '\u{0}' {
        return Err(value_error("Sign not allowed in string format specifier"));
    }
    if f.no_neg_0 {
        return Err(value_error("Negative zero coercion (z) not allowed in string format specifier"));
    }
    if f.alternate {
        return Err(value_error("Alternate form (#) not allowed in string format specifier"));
    }
    if f.align == '=' {
        return Err(value_error("'=' alignment not allowed in string format specifier"));
    }
    let cs = to_chars(s);
    let mut n = cs.len();
    if f.precision >= 0 and n > f.precision {
        n = f.precision;
    }
    Ok(pad(text(cs, 0, n), n, f.width, f.align, f.fill))
}

// format_long_internal, or format_float_internal for the float types.
fn format_int(v: i64, sp: ref Vec[char]) -> Result[String, PyError] {
    let f = parse_spec(sp, "int", 'd', '>')?;
    let t = f.kind;
    if t == 'e' or t == 'E' or t == 'f' or t == 'F' or t == 'g' or t == 'G' or t == '%' {
        return format_float(v as f64, sp);
    }
    if not (t == 'b' or t == 'c' or t == 'd' or t == 'o' or t == 'x' or t == 'X' or t == 'n') {
        return Err(unknown_code(t, "int"));
    }
    if f.precision != -1 {
        return Err(value_error("Precision not allowed in integer format specifier"));
    }
    if f.no_neg_0 {
        return Err(value_error("Negative zero coercion (z) not allowed in integer format specifier"));
    }
    if t == 'c' {
        if f.sign != '\u{0}' {
            return Err(value_error("Sign not allowed with integer format specifier 'c'"));
        }
        if f.alternate {
            return Err(value_error("Alternate form (#) not allowed with integer format specifier 'c'"));
        }
        if v < 0 or v > 0x10ffff {
            return Err(py_error("OverflowError", "%c arg not in range(0x110000)"));
        }
        let mut one = String.new();
        one.push(chr(v));
        return Ok(fill_number("", "", "", one, f));
    }
    let base = if t == 'b' {
        2
    } else if t == 'o' {
        8
    } else if t == 'x' or t == 'X' {
        16
    } else {
        10
    };
    let prefix = if not f.alternate or base == 10 {
        String.new()
    } else if t == 'b' {
        "0b".to_string()
    } else if t == 'o' {
        "0o".to_string()
    } else if t == 'x' {
        "0x".to_string()
    } else {
        "0X".to_string()
    };
    let a = if v < 0 { -v } else { v };
    let digits = to_base(a, base, t == 'X');
    Ok(fill_number(sign_text(v < 0, f), prefix, digits, "", f))
}

// a rounded half-to-even to n significant digits: (exactly n digits, the
// decimal exponent of the first).

// format_float_internal, for the presentation types the jobs use: none
// (repr), e, E, f, F and %.
fn format_float(v: f64, sp: ref Vec[char]) -> Result[String, PyError] {
    let f = parse_spec(sp, "float", '\u{0}', '>')?;
    let mut t = f.kind;
    if not (t == '\u{0}' or t == 'e' or t == 'E' or t == 'f' or t == 'F' or t == '%') {
        return Err(unknown_code(t, "float"));
    }
    let mut x = v;
    let mut pct = false;
    if t == '%' {
        t = 'f';
        x = x * 100.0;
        pct = true;
    }
    let precision = if f.precision < 0 { 6 } else { f.precision };
    let mut neg = is_neg(x);
    let a = if neg { -x } else { x };
    let mut (digits, rem) = if a != a {
        ("nan".to_string(), String.new())
    } else if a == f64.INFINITY {
        ((if t == 'F' or t == 'E' { "INF" } else { "inf" }).to_string(), String.new())
    } else if t == 'f' or t == 'F' {
        fixed_text(a, precision, f.alternate)
    } else if t == 'e' or t == 'E' {
        sci_text(a, precision, f.alternate, t == 'E')
    } else {
        let cs = to_chars(float_repr(a));
        let mut k = 0;
        while k < cs.len() and is_digit(cs[k]) {
            k += 1;
        }
        (text(cs, 0, k), text(cs, k, cs.len()))
    };
    if a != a {
        neg = false;
    }
    if f.no_neg_0 and neg {
        let mut zero = true;
        for c in digits.chars() {
            if c != '0' {
                zero = false;
            }
        }
        for c in rem.chars() {
            if is_digit(c) and c != '0' {
                zero = false;
            }
        }
        if zero {
            neg = false;
        }
    }
    if pct {
        rem.push('%');
    }
    Ok(fill_number(sign_text(neg, f), "", digits, rem, f))
}

// ------------------------------------------------------------ values

// The Python values the jobs build: literals, Markup strings, and three
// application classes: User (with __html__ and __html_format__), Badge
// (with __html__ only) and Plain (with neither).
#[derive(Clone)]
enum Value {
    Nil,
    Bool(bool),
    Int(i64),
    Float(f64),
    Str(String),
    Markup(String),
    List(Vec[Value]),
    Tuple(Vec[Value]),
    Dict(Vec[(Value, Value)]),
    User(String, String, i64),
    Badge(String),
    Plain(String),
}

struct PyError {
    kind: String,
    msg: String,
}

fn py_error(kind: Str, msg: own String) -> PyError {
    PyError { kind: kind.to_string(), msg: msg }
}

fn value_error(msg: ref String) -> PyError {
    py_error("ValueError", msg.clone())
}

fn type_error(msg: ref String) -> PyError {
    py_error("TypeError", msg.clone())
}

struct Env {
    uni: Uni,
    ents: Map[String, String],
}

fn type_name(v: ref Value) -> String {
    (match v {
        Value.Nil => "NoneType",
        Value.Bool(_) => "bool",
        Value.Int(_) => "int",
        Value.Float(_) => "float",
        Value.Str(_) => "str",
        Value.Markup(_) => "Markup",
        Value.List(_) => "list",
        Value.Tuple(_) => "tuple",
        Value.Dict(_) => "dict",
        Value.User(_, _, _) => "User",
        Value.Badge(_) => "Badge",
        Value.Plain(_) => "Plain",
    }).to_string()
}

fn is_text(v: ref Value) -> bool {
    match v {
        Value.Str(_) => true,
        Value.Markup(_) => true,
        _ => false,
    }
}

fn text_of(v: ref Value) -> String {
    match v {
        Value.Str(s) => s.clone(),
        Value.Markup(s) => s.clone(),
        _ => String.new(),
    }
}

fn has_html(v: ref Value) -> bool {
    match v {
        Value.Markup(_) => true,
        Value.User(_, _, _) => true,
        Value.Badge(_) => true,
        _ => false,
    }
}

// repr() of a str, or ascii().
fn str_repr(s: ref String, ascii: bool, env: ref Env) -> String {
    let mut single = false;
    let mut double = false;
    for c in s.chars() {
        if c == '\'' {
            single = true;
        } else if c == '"' {
            double = true;
        }
    }
    let quote = if single and not double { '"' } else { '\'' };
    let mut out = String.new();
    out.push(quote);
    for c in s.chars() {
        let o = c as i64;
        if c == quote or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if o < 0x7f and o >= 0x20 {
            out.push(c);
        } else if ascii or not env.uni.is_printable(c) {
            if o < 0x100 {
                out.push_str("\\x");
                out.push_str(hex(o, 2));
            } else if o < 0x10000 {
                out.push_str("\\u");
                out.push_str(hex(o, 4));
            } else {
                out.push_str("\\U");
                out.push_str(hex(o, 8));
            }
        } else {
            out.push(c);
        }
    }
    out.push(quote);
    out
}

fn join_reprs(items: ref Vec[Value], ascii: bool, env: ref Env) -> String {
    let mut parts: Vec[String] = Vec.new();
    for x in items.iter() {
        parts.push(repr(x, ascii, env));
    }
    parts.join(", ")
}

fn repr(v: ref Value, ascii: bool, env: ref Env) -> String {
    match v {
        Value.Nil => "None".to_string(),
        Value.Bool(b) => (if b { "True" } else { "False" }).to_string(),
        Value.Int(n) => n.to_string(),
        Value.Float(x) => float_repr(x),
        Value.Str(s) => str_repr(s, ascii, env),
        Value.Markup(s) => f"Markup({str_repr(s, ascii, env)})",
        Value.List(items) => f"[{join_reprs(items, ascii, env)}]",
        Value.Tuple(items) => {
            if items.len() == 1 {
                f"({repr(items[0], ascii, env)},)"
            } else {
                f"({join_reprs(items, ascii, env)})"
            }
        }
        Value.Dict(pairs) => {
            let mut parts: Vec[String] = Vec.new();
            for (k, x) in pairs.iter() {
                parts.push(f"{repr(k, ascii, env)}: {repr(x, ascii, env)}");
            }
            "{" + parts.join(", ") + "}"
        }
        Value.User(name, _, id) => f"User({str_repr(name, ascii, env)}, {id})",
        Value.Badge(label) => f"Badge({str_repr(label, ascii, env)})",
        Value.Plain(t) => f"Plain({str_repr(t, ascii, env)})",
    }
}

// str(): a Markup becomes a plain str with the same text.
fn to_str(v: ref Value, env: ref Env) -> String {
    match v {
        Value.Str(s) => s.clone(),
        Value.Markup(s) => s.clone(),
        Value.User(name, email, _) => f"{name} <{email}>",
        Value.Plain(t) => t.clone(),
        _ => repr(v, false, env),
    }
}

// The pure-Python _escape_inner.
fn escape_inner(s: ref String) -> String {
    s.replace("&", "&amp;").replace(">", "&gt;").replace("<", "&lt;").replace("'", "&#39;").replace("\"", "&#34;")
}

// v.__html__().
fn html_of(v: ref Value, env: ref Env) -> Result[String, PyError] {
    match v {
        Value.Markup(s) => Ok(s.clone()),
        Value.User(name, email, _) => {
            let args: Vec[Value] = vec![Value.Str(email.clone()), Value.Str(name.clone())];
            markup_format("<a href=\"mailto:{0}\">{1}</a>", args, Vec.new(), env)
        }
        Value.Badge(label) => Ok(f"<span class=\"badge\">{escape_inner(label)}</span>"),
        _ => Ok(to_str(v, env)),
    }
}

// markupsafe.escape: the text of the Markup it returns.
fn escape(v: ref Value, env: ref Env) -> Result[String, PyError] {
    match v {
        Value.Str(s) => Ok(escape_inner(s)),
        _ => {
            if has_html(v) {
                html_of(v, env)
            } else {
                Ok(escape_inner(to_str(v, env)))
            }
        }
    }
}

// Markup(v): the object's __html__, or its str, unescaped.
fn markup_of(v: ref Value, env: ref Env) -> Result[String, PyError] {
    if has_html(v) {
        return html_of(v, env);
    }
    Ok(to_str(v, env))
}

// ------------------------------------------------------------ literals

struct Lit {
    cs: Vec[char],
    p: i64,
}

fn syntax(msg: Str) -> PyError {
    py_error("SyntaxError", msg.to_string())
}

impl Lit {
    fn skip(mut ref self) {
        while self.p < self.cs.len() and (self.cs[self.p] == ' ' or self.cs[self.p] == '\t') {
            self.p += 1;
        }
    }

    fn peek(mut ref self) -> char {
        self.skip();
        if self.p < self.cs.len() { self.cs[self.p] } else { '\u{0}' }
    }

    fn eat(mut ref self, c: char) -> bool {
        if self.peek() == c {
            self.p += 1;
            return true;
        }
        false
    }

    fn hex_digits(mut ref self, n: i64) -> i64 {
        let mut v = 0;
        for _ in 0..n {
            let c = self.cs[self.p];
            self.p += 1;
            v = v * 16 + (if is_digit(c) { c as i64 - 48 } else { ascii_lower(c) as i64 - 87 });
        }
        v
    }

    fn string(mut ref self) -> String {
        let q = self.cs[self.p];
        self.p += 1;
        let mut out = String.new();
        while self.p < self.cs.len() and self.cs[self.p] != q {
            let c = self.cs[self.p];
            self.p += 1;
            if c != '\\' {
                out.push(c);
                continue;
            }
            let e = self.cs[self.p];
            self.p += 1;
            if e == 'n' {
                out.push('\n');
            } else if e == 't' {
                out.push('\t');
            } else if e == 'r' {
                out.push('\r');
            } else if e == 'x' {
                out.push(chr(self.hex_digits(2)));
            } else if e == 'u' {
                out.push(chr(self.hex_digits(4)));
            } else if e == 'U' {
                out.push(chr(self.hex_digits(8)));
            } else {
                out.push(e);
            }
        }
        self.p += 1;
        out
    }

    fn number(mut ref self, neg: bool) -> Value {
        let start = self.p;
        let mut is_float = false;
        while self.p < self.cs.len() {
            let c = self.cs[self.p];
            if is_digit(c) {
                self.p += 1;
            } else if c == '.' or c == 'e' or c == 'E' {
                is_float = true;
                self.p += 1;
            } else if (c == '+' or c == '-') and (self.cs[self.p - 1] == 'e' or self.cs[self.p - 1] == 'E') {
                self.p += 1;
            } else {
                break;
            }
        }
        let t = text(self.cs, start, self.p);
        if not is_float {
            let n = i64.parse(t).unwrap_or(0);
            return Value.Int(if neg { -n } else { n });
        }
        Value.Float(parse_float_text(to_chars(t), neg))
    }

    // A scalar: a string, a number, None, True or False.
    fn expr(mut ref self) -> Result[Value, PyError] {
        let c = self.peek();
        if c == '\'' or c == '"' {
            return Ok(Value.Str(self.string()));
        }
        if c == '-' {
            self.p += 1;
            self.skip();
            return Ok(self.number(true));
        }
        if is_digit(c) {
            return Ok(self.number(false));
        }
        let start = self.p;
        while self.p < self.cs.len() and is_ident(self.cs[self.p]) {
            self.p += 1;
        }
        let name = text(self.cs, start, self.p);
        if name == "None" {
            return Ok(Value.Nil);
        }
        if name == "True" or name == "False" {
            return Ok(Value.Bool(name == "True"));
        }
        Err(syntax("unknown name"))
    }
}

fn lit_text(args: ref Vec[Value], k: i64) -> String {
    text_of(args[k])
}

// A job argument: literals, lists, tuples, dicts and the four
// constructors. Markup(x) of an object calls its __html__.
fn parse_value(s: ref String, env: ref Env) -> Result[Value, PyError] {
    let mut lx = Lit { cs: to_chars(s), p: 0 };
    rebuild(mut lx, env)
}

fn rebuild(lx: mut ref Lit, env: ref Env) -> Result[Value, PyError] {
    let c = lx.peek();
    if c == '[' or c == '(' or c == '{' {
        let close = if c == '[' { ']' } else if c == '(' { ')' } else { '}' };
        lx.p += 1;
        let mut out: Vec[Value] = Vec.new();
        let mut pairs: Vec[(Value, Value)] = Vec.new();
        let mut comma = false;
        while not lx.eat(close) {
            let k = rebuild(mut lx, env)?;
            if c == '{' {
                lx.eat(':');
                let x = rebuild(mut lx, env)?;
                pairs.push((k, x));
            } else {
                out.push(k);
            }
            comma = lx.eat(',');
        }
        if c == '{' {
            return Ok(Value.Dict(pairs));
        }
        if c == '[' {
            return Ok(Value.List(out));
        }
        if out.len() == 1 and not comma {
            return Ok(out[0].clone());
        }
        return Ok(Value.Tuple(out));
    }
    if is_ident_start(c) {
        let start = lx.p;
        while lx.p < lx.cs.len() and is_ident(lx.cs[lx.p]) {
            lx.p += 1;
        }
        let name = text(lx.cs, start, lx.p);
        if lx.peek() == '(' {
            lx.p += 1;
            let mut args: Vec[Value] = Vec.new();
            while not lx.eat(')') {
                args.push(rebuild(mut lx, env)?);
                lx.eat(',');
            }
            if name == "Markup" {
                let inner = if args.len() == 0 { Value.Str(String.new()) } else { args[0].clone() };
                return Ok(Value.Markup(markup_of(inner, env)?));
            }
            if name == "User" {
                return Ok(Value.User(lit_text(args, 0), lit_text(args, 1), match args[2] { Value.Int(n) => n, _ => 0 }));
            }
            if name == "Badge" {
                return Ok(Value.Badge(lit_text(args, 0)));
            }
            return Ok(Value.Plain(lit_text(args, 0)));
        }
        lx.p = start;
    }
    lx.expr()
}

// ------------------------------------------------------------ str.format, as EscapeFormatter runs it

fn badge_spec_error(spec: ref String) -> PyError {
    value_error(f"Format specifier {spec} given, but <class '__main__.Badge'> does not define __html_format__. A class that defines __html__ must define __html_format__ to work with format specifiers.")
}

// format(value, spec), the builtin.
fn builtin_format(v: ref Value, spec: ref String, env: ref Env) -> Result[String, PyError] {
    let sp = to_chars(spec);
    match v {
        Value.Str(s) => format_str(s, sp),
        Value.Markup(s) => format_str(s, sp),
        Value.Int(n) => if sp.len() == 0 { Ok(n.to_string()) } else { format_int(n, sp) },
        Value.Bool(b) => if sp.len() == 0 { Ok(to_str(v, env)) } else { format_int(if b { 1 } else { 0 }, sp) },
        Value.Float(x) => if sp.len() == 0 { Ok(float_repr(x)) } else { format_float(x, sp) },
        _ => {
            if sp.len() == 0 {
                Ok(to_str(v, env))
            } else {
                Err(type_error(f"unsupported format string passed to {type_name(v)}.__format__"))
            }
        }
    }
}

// EscapeFormatter.format_field: the text of str(self.escape(rv)).
fn format_field(v: ref Value, spec: ref String, env: ref Env) -> Result[String, PyError] {
    match v {
        Value.Markup(s) => {
            if spec.len() > 0 {
                return Err(value_error("Unsupported format specification for Markup."));
            }
            Ok(s.clone())
        }
        Value.User(name, _, _) => {
            if spec.len() == 0 or spec == "link" {
                return html_of(v, env);
            }
            if spec == "name" {
                return Ok(escape_inner(name));
            }
            Err(value_error(f"Invalid format spec {str_repr(spec, false, env)} for User"))
        }
        Value.Badge(_) => {
            if spec.len() > 0 {
                return Err(badge_spec_error(spec));
            }
            // __html__ returns a plain str, which escape() escapes.
            Ok(escape_inner(html_of(v, env)?))
        }
        _ => Ok(escape_inner(builtin_format(v, spec, env)?)),
    }
}

fn get_attr(obj: ref Value, name: ref String) -> Result[Value, PyError] {
    match obj {
        Value.User(n, e, id) => {
            if name == "name" {
                return Ok(Value.Str(n.clone()));
            }
            if name == "email" {
                return Ok(Value.Str(e.clone()));
            }
            if name == "id" {
                return Ok(Value.Int(id));
            }
        }
        Value.Badge(l) => {
            if name == "label" {
                return Ok(Value.Str(l.clone()));
            }
        }
        Value.Plain(t) => {
            if name == "text" {
                return Ok(Value.Str(t.clone()));
            }
        }
        _ => {}
    }
    Err(py_error("AttributeError", f"'{type_name(obj)}' object has no attribute '{name}'"))
}

fn same_key(a: ref Value, b: ref Value) -> bool {
    match (a, b) {
        (Value.Int(x), Value.Int(y)) => x == y,
        (Value.Str(x), Value.Str(y)) => x == y,
        (Value.Str(x), Value.Markup(y)) => x == y,
        (Value.Markup(x), Value.Str(y)) => x == y,
        (Value.Markup(x), Value.Markup(y)) => x == y,
        _ => false,
    }
}

fn dict_get(pairs: ref Vec[(Value, Value)], key: ref Value, env: ref Env) -> Result[Value, PyError] {
    for (k, x) in pairs.iter() {
        if same_key(k, key) {
            return Ok(x.clone());
        }
    }
    Err(py_error("KeyError", repr(key, false, env)))
}

fn index_of(n: i64, len: i64) -> i64 {
    if n < 0 { n + len } else { n }
}

// obj[key].
fn get_item(obj: ref Value, key: ref Value, env: ref Env) -> Result[Value, PyError] {
    match obj {
        Value.Dict(pairs) => dict_get(pairs, key, env),
        Value.List(items) => match key {
            Value.Int(n) => {
                let k = index_of(n, items.len());
                if k < 0 or k >= items.len() {
                    return Err(py_error("IndexError", "list index out of range".to_string()));
                }
                Ok(items[k].clone())
            }
            _ => Err(type_error(f"list indices must be integers or slices, not {type_name(key)}")),
        },
        Value.Tuple(items) => match key {
            Value.Int(n) => {
                let k = index_of(n, items.len());
                if k < 0 or k >= items.len() {
                    return Err(py_error("IndexError", "tuple index out of range".to_string()));
                }
                Ok(items[k].clone())
            }
            _ => Err(type_error(f"tuple indices must be integers or slices, not {type_name(key)}")),
        },
        Value.Str(s) => str_item(s, key, false),
        Value.Markup(s) => str_item(s, key, true),
        _ => Err(type_error(f"'{type_name(obj)}' object is not subscriptable")),
    }
}

fn str_item(s: ref String, key: ref Value, markup: bool) -> Result[Value, PyError] {
    match key {
        Value.Int(n) => {
            let cs = to_chars(s);
            let k = index_of(n, cs.len());
            if k < 0 or k >= cs.len() {
                return Err(py_error("IndexError", "string index out of range".to_string()));
            }
            let t = text(cs, k, k + 1);
            Ok(if markup { Value.Markup(t) } else { Value.Str(t) })
        }
        _ => Err(type_error(f"string indices must be integers, not '{type_name(key)}'")),
    }
}

// get_integer: the value of an all-digit name, or -1.
fn name_integer(cs: ref Vec[char], lo: i64, hi: i64) -> i64 {
    if lo >= hi {
        return -1;
    }
    let mut v = 0;
    for k in lo..hi {
        if not is_digit(cs[k]) {
            return -1;
        }
        v = v * 10 + (cs[k] as i64 - 48);
    }
    v
}

struct Formatter {
    args: Vec[Value],
    kw: Vec[(Value, Value)],
    // the next automatic index, or -1 once a field was numbered by hand
    auto: i64,
}

impl Formatter {
    // Formatter.get_field, with formatter_field_name_split.
    fn get_field(self, cs: ref Vec[char], lo: i64, hi: i64, env: ref Env) -> Result[Value, PyError] {
        let mut i = lo;
        while i < hi and cs[i] != '.' and cs[i] != '[' {
            i += 1;
        }
        let idx = name_integer(cs, lo, i);
        let mut obj = if idx >= 0 {
            if idx >= self.args.len() {
                return Err(py_error("IndexError", "tuple index out of range".to_string()));
            }
            self.args[idx].clone()
        } else {
            dict_get(self.kw, Value.Str(text(cs, lo, i)), env)?
        };
        let mut p = i;
        while p < hi {
            let c = cs[p];
            p += 1;
            let start = p;
            if c == '.' {
                while p < hi and cs[p] != '.' and cs[p] != '[' {
                    p += 1;
                }
                if p == start {
                    return Err(value_error("Empty attribute in format string"));
                }
                let next = get_attr(obj, text(cs, start, p))?;
                obj = next;
            } else if c == '[' {
                while p < hi and cs[p] != ']' {
                    p += 1;
                }
                if p >= hi {
                    return Err(value_error("Missing ']' in format string"));
                }
                let end = p;
                p += 1;
                if end == start {
                    return Err(value_error("Empty attribute in format string"));
                }
                let k = name_integer(cs, start, end);
                let key = if k >= 0 { Value.Int(k) } else { Value.Str(text(cs, start, end)) };
                let next = get_item(obj, key, env)?;
                obj = next;
            } else {
                return Err(value_error("Only '.' or '[' may follow ']' in format field specifier"));
            }
        }
        Ok(obj)
    }

    // Formatter._vformat over cs[lo..hi].
    fn vformat(mut ref self, cs: ref Vec[char], lo: i64, hi: i64, depth: i64, env: ref Env) -> Result[String, PyError] {
        if depth < 0 {
            return Err(value_error("Max string recursion exceeded"));
        }
        let mut out = String.new();
        let mut pos = lo;
        while pos < hi {
            // MarkupIterator_next: literal text up to a brace.
            let start = pos;
            let mut c = '\u{0}';
            let mut markup = false;
            while pos < hi {
                c = cs[pos];
                pos += 1;
                if c == '{' or c == '}' {
                    markup = true;
                    break;
                }
            }
            let at_end = pos >= hi;
            let mut len = pos - start;
            if c == '}' and (at_end or cs[pos] != '}') {
                return Err(value_error("Single '}' encountered in format string"));
            }
            if at_end and c == '{' {
                return Err(value_error("Single '{' encountered in format string"));
            }
            if not at_end {
                if c == cs[pos] {
                    pos += 1;
                    markup = false;
                } else {
                    len -= 1;
                }
            }
            out.push_str(text(cs, start, start + len));
            if not markup {
                continue;
            }
            // parse_field
            let name_lo = pos;
            c = '\u{0}';
            while pos < hi {
                c = cs[pos];
                pos += 1;
                if c == '{' {
                    return Err(value_error("unexpected '{' in field name"));
                }
                if c == '[' {
                    while pos < hi and cs[pos] != ']' {
                        pos += 1;
                    }
                    continue;
                }
                if c == '}' or c == ':' or c == '!' {
                    break;
                }
            }
            let name_hi = if c == '}' or c == ':' or c == '!' { pos - 1 } else { pos };
            let mut conv = '\u{0}';
            let mut spec_lo = pos;
            let mut spec_hi = pos;
            if c == '!' or c == ':' {
                let mut done = false;
                if c == '!' {
                    if pos >= hi {
                        return Err(value_error("end of string while looking for conversion specifier"));
                    }
                    conv = cs[pos];
                    pos += 1;
                    if pos < hi {
                        let d = cs[pos];
                        pos += 1;
                        if d == '}' {
                            done = true;
                            spec_lo = pos;
                            spec_hi = pos;
                        } else if d != ':' {
                            return Err(value_error("expected ':' after conversion specifier"));
                        }
                    }
                }
                if not done {
                    spec_lo = pos;
                    let mut count = 1;
                    let mut closed = false;
                    while pos < hi {
                        let d = cs[pos];
                        pos += 1;
                        if d == '{' {
                            count += 1;
                        } else if d == '}' {
                            count -= 1;
                            if count == 0 {
                                spec_hi = pos - 1;
                                closed = true;
                                break;
                            }
                        }
                    }
                    if not closed {
                        return Err(value_error("unmatched '{' in format spec"));
                    }
                }
            } else if c != '}' {
                return Err(value_error("expected '}' before end of string"));
            }
            // _vformat's field handling
            let mut name_cs: Vec[char] = Vec.new();
            for k in name_lo..name_hi {
                name_cs.push(cs[k]);
            }
            if name_cs.len() == 0 {
                if self.auto < 0 {
                    return Err(value_error("cannot switch from manual field specification to automatic field numbering"));
                }
                name_cs = to_chars(self.auto.to_string());
                self.auto += 1;
            } else if name_integer(name_cs, 0, name_cs.len()) >= 0 {
                if self.auto > 0 {
                    return Err(value_error("cannot switch from manual field specification to automatic field numbering"));
                }
                self.auto = -1;
            }
            let obj = self.get_field(name_cs, 0, name_cs.len(), env)?;
            let conv_obj = if conv == '\u{0}' {
                obj
            } else if conv == 's' {
                Value.Str(to_str(obj, env))
            } else if conv == 'r' {
                Value.Str(repr(obj, false, env))
            } else if conv == 'a' {
                Value.Str(repr(obj, true, env))
            } else {
                return Err(value_error(f"Unknown conversion specifier {conv}"));
            };
            let spec = self.vformat(cs, spec_lo, spec_hi, depth - 1, env)?;
            out.push_str(format_field(conv_obj, spec, env)?);
        }
        Ok(out)
    }
}

fn markup_format(fmt: ref String, args: ref Vec[Value], kw: ref Vec[(Value, Value)], env: ref Env) -> Result[String, PyError] {
    let mut f = Formatter { args: args.clone(), kw: kw.clone(), auto: 0 };
    let cs = to_chars(fmt);
    f.vformat(cs, 0, cs.len(), 2, env)
}

// ------------------------------------------------------------ Markup % value

// What _MarkupEscapeHelper's int() gives, or the error %d raises.
fn helper_int(o: ref Value, conv: char, env: ref Env) -> Result[i64, PyError] {
    let wrong = type_error(f"%{conv} format: a real number is required, not _MarkupEscapeHelper");
    match o {
        Value.Int(n) => Ok(n),
        Value.Bool(b) => Ok(if b { 1 } else { 0 }),
        Value.Float(x) => {
            if x != x {
                return Err(value_error("cannot convert float NaN to integer"));
            }
            if x == f64.INFINITY or x == -f64.INFINITY {
                return Err(py_error("OverflowError", "cannot convert float infinity to integer".to_string()));
            }
            Ok(x as i64)
        }
        Value.Str(s) => int_of_str(s, env),
        Value.Markup(s) => int_of_str(s, env),
        _ => Err(wrong),
    }
}

fn int_of_str(s: ref String, env: ref Env) -> Result[i64, PyError] {
    match py_int_str(s, env) {
        Some(n) => Ok(n),
        None => Err(value_error(f"invalid literal for int() with base 10: {str_repr(s, false, env)}")),
    }
}

fn helper_float(o: ref Value, env: ref Env) -> Result[f64, PyError] {
    match o {
        Value.Int(n) => Ok(n as f64),
        Value.Bool(b) => Ok(if b { 1.0 } else { 0.0 }),
        Value.Float(x) => Ok(x),
        Value.Str(s) => float_of_str(s, env),
        Value.Markup(s) => float_of_str(s, env),
        _ => Err(type_error(f"float() argument must be a string or a real number, not '{type_name(o)}'")),
    }
}

fn float_of_str(s: ref String, env: ref Env) -> Result[f64, PyError] {
    match py_float_str(s, env) {
        Some(x) => Ok(x),
        None => Err(value_error(f"could not convert string to float: {str_repr(s, false, env)}")),
    }
}

fn pad_left(body: ref String, width: i64, left_align: bool, fill: char) -> String {
    let n = char_count(body);
    if width <= n {
        return body.clone();
    }
    if left_align {
        f"{body}{repeat(' ', width - n)}"
    } else {
        f"{repeat(fill, width - n)}{body}"
    }
}

// sign, digits and padding for %d and %f.
fn pad_number(neg: bool, body: ref String, plus: bool, space: bool, zero: bool, left: bool, width: i64) -> String {
    let sign = if neg { "-" } else if plus { "+" } else if space { " " } else { "" };
    let n = char_count(body) + sign.len();
    if width > n and zero and not left {
        return f"{sign}{repeat('0', width - n)}{body}";
    }
    pad_left(f"{sign}{body}", width, left, ' ')
}

// unicode_format (PyUnicode_Format) over markupsafe's escape helpers:
// args are the helpers' objects, `mapping` when markupsafe passed one
// helper whose object has __getitem__.
fn percent(fmt: ref String, args: ref Vec[Value], mapping: bool, env: ref Env) -> Result[String, PyError] {
    let cs = to_chars(fmt);
    let n = cs.len();
    let mut out = String.new();
    // CPython's argidx and arglen; arglen -1 for a single object.
    let mut arglen = if mapping { -1 } else { args.len() };
    let mut argidx = if mapping { -2 } else { 0 };
    let mut cur = if mapping { args[0].clone() } else { Value.Nil };
    let mut pos = 0;
    while pos < n {
        if cs[pos] != '%' {
            out.push(cs[pos]);
            pos += 1;
            continue;
        }
        pos += 1;
        // the key
        if pos < n and cs[pos] == '(' {
            if not mapping {
                return Err(type_error("format requires a mapping"));
            }
            pos += 1;
            let kstart = pos;
            let mut level = 1;
            while pos < n and level > 0 {
                if cs[pos] == ')' {
                    level -= 1;
                } else if cs[pos] == '(' {
                    level += 1;
                }
                pos += 1;
            }
            if level > 0 {
                return Err(value_error("incomplete format key"));
            }
            let key = Value.Str(text(cs, kstart, pos - 1));
            cur = get_item(args[0], key, env)?;
            arglen = -1;
            argidx = -2;
        }
        let mut left = false;
        let mut plus = false;
        let mut space = false;
        let mut alt = false;
        let mut zero = false;
        while pos < n {
            let c = cs[pos];
            if c == '-' {
                left = true;
            } else if c == '+' {
                plus = true;
            } else if c == ' ' {
                space = true;
            } else if c == '#' {
                alt = true;
            } else if c == '0' {
                zero = true;
            } else {
                break;
            }
            pos += 1;
        }
        let mut width = -1;
        if pos < n and cs[pos] == '*' {
            // the argument is a helper, never an int
            return Err(type_error("* wants int"));
        }
        while pos < n and is_digit(cs[pos]) {
            width = (if width < 0 { 0 } else { width }) * 10 + (cs[pos] as i64 - 48);
            pos += 1;
        }
        let mut prec = -1;
        if pos < n and cs[pos] == '.' {
            pos += 1;
            if pos < n and cs[pos] == '*' {
                return Err(type_error("* wants int"));
            }
            prec = 0;
            while pos < n and is_digit(cs[pos]) {
                prec = prec * 10 + (cs[pos] as i64 - 48);
                pos += 1;
            }
        }
        while pos < n and (cs[pos] == 'h' or cs[pos] == 'l' or cs[pos] == 'L') {
            pos += 1;
        }
        if pos >= n {
            return Err(value_error("incomplete format"));
        }
        let conv = cs[pos];
        pos += 1;
        if conv == '%' {
            out.push('%');
            continue;
        }
        // getnextarg
        let obj = if argidx < arglen {
            let k = argidx;
            argidx += 1;
            if arglen < 0 { cur.clone() } else { args[k].clone() }
        } else {
            return Err(type_error("not enough arguments for format string"));
        };
        if conv == 's' or conv == 'r' or conv == 'a' {
            let mut s = if conv == 's' {
                escape(obj, env)?
            } else {
                escape(Value.Str(repr(obj, false, env)), env)?
            };
            if prec >= 0 {
                let t = to_chars(s);
                if t.len() > prec {
                    s = text(t, 0, prec);
                }
            }
            out.push_str(pad_left(s, width, left, ' '));
        } else if conv == 'd' or conv == 'i' or conv == 'u' {
            let v = helper_int(obj, conv, env)?;
            let mut digits = (if v < 0 { -v } else { v }).to_string();
            if prec > char_count(digits) {
                digits = f"{repeat('0', prec - char_count(digits))}{digits}";
            }
            out.push_str(pad_number(v < 0, digits, plus, space, zero, left, width));
        } else if conv == 'x' or conv == 'X' or conv == 'o' {
            return Err(type_error(f"%{conv} format: an integer is required, not _MarkupEscapeHelper"));
        } else if conv == 'f' or conv == 'F' or conv == 'e' or conv == 'E' {
            let x = helper_float(obj, env)?;
            let p = if prec < 0 { 6 } else { prec };
            let neg = is_neg(x) and x == x;
            let a = if is_neg(x) { -x } else { x };
            let body = if a != a {
                (if conv == 'F' or conv == 'E' { "NAN" } else { "nan" }).to_string()
            } else if a == f64.INFINITY {
                (if conv == 'F' or conv == 'E' { "INF" } else { "inf" }).to_string()
            } else if conv == 'f' or conv == 'F' {
                let (i, fr) = fixed_text(a, p, alt);
                f"{i}{fr}"
            } else {
                let (i, fr) = sci_text(a, p, alt, conv == 'E');
                f"{i}{fr}"
            };
            out.push_str(pad_number(neg, body, plus, space, zero and a == a and a != f64.INFINITY, left, width));
        } else if conv == 'c' {
            return Err(type_error("%c requires int or char"));
        } else {
            let o = conv as i64;
            let shown = if o > 32 and o < 127 { conv.to_string() } else { "?".to_string() };
            return Err(value_error(f"unsupported format character '{shown}' (0x{to_base(o, 16, false)}) at index {pos - 1}"));
        }
    }
    if argidx < arglen and not mapping {
        return Err(type_error("not all arguments converted during string formatting"));
    }
    Ok(out)
}

// Markup.__mod__: a tuple's items each wrapped, an object with
// __getitem__ (other than a str) wrapped as a mapping, anything else
// wrapped in a one-item tuple.
fn markup_mod(fmt: ref String, v: ref Value, env: ref Env) -> Result[String, PyError] {
    match v {
        Value.Tuple(items) => percent(fmt, items, false, env),
        Value.List(_) => percent(fmt, vec![v.clone()], true, env),
        Value.Dict(_) => percent(fmt, vec![v.clone()], true, env),
        _ => percent(fmt, vec![v.clone()], false, env),
    }
}

// ------------------------------------------------------------ str methods, as Markup wraps them

fn find_at(cs: ref Vec[char], pat: ref Vec[char], from: i64) -> i64 {
    let mut i = from;
    while i + pat.len() <= cs.len() {
        let mut ok = true;
        for k in 0..pat.len() {
            if cs[i + k] != pat[k] {
                ok = false;
                break;
            }
        }
        if ok {
            return i;
        }
        i += 1;
    }
    -1
}

fn rfind_at(cs: ref Vec[char], pat: ref Vec[char]) -> i64 {
    let mut i = cs.len() - pat.len();
    while i >= 0 {
        let mut ok = true;
        for k in 0..pat.len() {
            if cs[i + k] != pat[k] {
                ok = false;
                break;
            }
        }
        if ok {
            return i;
        }
        i -= 1;
    }
    -1
}

fn starts_at(cs: ref Vec[char], pat: Str, at: i64) -> bool {
    let p = to_chars(pat.to_string());
    if at + p.len() > cs.len() {
        return false;
    }
    for k in 0..p.len() {
        if cs[at + k] != p[k] {
            return false;
        }
    }
    true
}

fn py_split(s: ref String, sep: ref Option[String], maxsplit: i64, env: ref Env) -> Result[Vec[String], PyError] {
    let cs = to_chars(s);
    let mut out: Vec[String] = Vec.new();
    match sep {
        None => {
            let mut i = 0;
            let mut splits = 0;
            loop {
                while i < cs.len() and env.uni.is_space(cs[i]) {
                    i += 1;
                }
                if i >= cs.len() {
                    break;
                }
                if maxsplit >= 0 and splits >= maxsplit {
                    out.push(text(cs, i, cs.len()));
                    break;
                }
                let start = i;
                while i < cs.len() and not env.uni.is_space(cs[i]) {
                    i += 1;
                }
                out.push(text(cs, start, i));
                splits += 1;
            }
        }
        Some(sp) => {
            let pat = to_chars(sp);
            if pat.len() == 0 {
                return Err(value_error("empty separator"));
            }
            let mut start = 0;
            let mut splits = 0;
            loop {
                if maxsplit >= 0 and splits >= maxsplit {
                    break;
                }
                let at = find_at(cs, pat, start);
                if at < 0 {
                    break;
                }
                out.push(text(cs, start, at));
                start = at + pat.len();
                splits += 1;
            }
            out.push(text(cs, start, cs.len()));
        }
    }
    Ok(out)
}

fn py_rsplit(s: ref String, sep: ref Option[String], maxsplit: i64, env: ref Env) -> Result[Vec[String], PyError] {
    let cs = to_chars(s);
    let mut out: Vec[String] = Vec.new();
    match sep {
        None => {
            let mut i = cs.len();
            let mut splits = 0;
            loop {
                while i > 0 and env.uni.is_space(cs[i - 1]) {
                    i -= 1;
                }
                if i <= 0 {
                    break;
                }
                if maxsplit >= 0 and splits >= maxsplit {
                    out.push(text(cs, 0, i));
                    break;
                }
                let end = i;
                while i > 0 and not env.uni.is_space(cs[i - 1]) {
                    i -= 1;
                }
                out.push(text(cs, i, end));
                splits += 1;
            }
        }
        Some(sp) => {
            let pat = to_chars(sp);
            if pat.len() == 0 {
                return Err(value_error("empty separator"));
            }
            let mut end = cs.len();
            let mut splits = 0;
            loop {
                if maxsplit >= 0 and splits >= maxsplit {
                    break;
                }
                let head: Vec[char] = to_chars(text(cs, 0, end));
                let at = rfind_at(head, pat);
                if at < 0 {
                    break;
                }
                out.push(text(cs, at + pat.len(), end));
                end = at;
                splits += 1;
            }
            out.push(text(cs, 0, end));
        }
    }
    out.reverse();
    Ok(out)
}

fn py_splitlines(s: ref String, keepends: bool, env: ref Env) -> Vec[String] {
    let cs = to_chars(s);
    let mut out: Vec[String] = Vec.new();
    let mut i = 0;
    let mut start = 0;
    while i < cs.len() {
        if env.uni.has(cs[i], "b") {
            let mut eol = i + 1;
            if cs[i] == '\r' and i + 1 < cs.len() and cs[i + 1] == '\n' {
                eol = i + 2;
            }
            out.push(text(cs, start, if keepends { eol } else { i }));
            i = eol;
            start = eol;
        } else {
            i += 1;
        }
    }
    if start < cs.len() {
        out.push(text(cs, start, cs.len()));
    }
    out
}

fn strips(c: char, by_set: bool, set: ref Vec[char], env: ref Env) -> bool {
    if by_set { set.contains(c) } else { env.uni.is_space(c) }
}

fn py_strip(s: ref String, chars: ref Option[String], left: bool, right: bool, env: ref Env) -> String {
    let cs = to_chars(s);
    let set: Vec[char] = match chars {
        Some(c) => to_chars(c),
        None => Vec.new(),
    };
    let by_set = chars.is_some();
    let mut a = 0;
    let mut b = cs.len();
    if left {
        while a < b and strips(cs[a], by_set, set, env) {
            a += 1;
        }
    }
    if right {
        while b > a and strips(cs[b - 1], by_set, set, env) {
            b -= 1;
        }
    }
    text(cs, a, b)
}

fn py_replace(s: ref String, old: ref String, new: ref String, count: i64) -> String {
    let cs = to_chars(s);
    let pat = to_chars(old);
    let mut out = String.new();
    if pat.len() == 0 {
        let mut n = 0;
        for i in 0..(cs.len() + 1) {
            if count < 0 or n < count {
                out.push_str(new);
                n += 1;
            }
            if i < cs.len() {
                out.push(cs[i]);
            }
        }
        return out;
    }
    let mut start = 0;
    let mut n = 0;
    loop {
        if count >= 0 and n >= count {
            break;
        }
        let at = find_at(cs, pat, start);
        if at < 0 {
            break;
        }
        out.push_str(text(cs, start, at));
        out.push_str(new);
        start = at + pat.len();
        n += 1;
    }
    out.push_str(text(cs, start, cs.len()));
    out
}

fn fill_char(fill: ref String) -> Result[char, PyError] {
    let cs = to_chars(fill);
    if cs.len() != 1 {
        return Err(type_error("The fill character must be exactly one character long"));
    }
    Ok(cs[0])
}

fn py_justify(s: ref String, width: i64, fill: char, how: char) -> String {
    let n = char_count(s);
    if width <= n {
        return s.clone();
    }
    let marg = width - n;
    let left = if how == 'l' { 0 } else if how == 'r' { marg } else { marg / 2 + (marg & width & 1) };
    f"{repeat(fill, left)}{s}{repeat(fill, marg - left)}"
}

fn py_zfill(s: ref String, width: i64) -> String {
    let cs = to_chars(s);
    if cs.len() >= width {
        return s.clone();
    }
    let fill = width - cs.len();
    if cs.len() > 0 and (cs[0] == '+' or cs[0] == '-') {
        return f"{cs[0]}{repeat('0', fill)}{text(cs, 1, cs.len())}";
    }
    f"{repeat('0', fill)}{s}"
}

fn py_expandtabs(s: ref String, tabsize: i64) -> String {
    let mut out = String.new();
    let mut col = 0;
    for c in s.chars() {
        if c == '\t' {
            if tabsize > 0 {
                let n = tabsize - col % tabsize;
                out.push_str(repeat(' ', n));
                col += n;
            }
        } else {
            out.push(c);
            col += 1;
            if c == '\n' or c == '\r' {
                col = 0;
            }
        }
    }
    out
}

fn clamp_index(v: ref Value, dflt: i64, len: i64, st: i64) -> i64 {
    match v {
        Value.Int(n) => {
            let mut k = n;
            if k < 0 {
                k += len;
                if k < 0 {
                    k = if st < 0 { -1 } else { 0 };
                }
            } else if k >= len {
                k = if st < 0 { len - 1 } else { len };
            }
            k
        }
        _ => dflt,
    }
}

// The indices a slice picks, as slice.indices does.
fn slice_indices(len: i64, start: ref Value, stop: ref Value, step: ref Value) -> Result[Vec[i64], PyError] {
    let st = match step {
        Value.Int(n) => n,
        _ => 1,
    };
    if st == 0 {
        return Err(value_error("slice step cannot be zero"));
    }
    let a = clamp_index(start, if st < 0 { len - 1 } else { 0 }, len, st);
    let b = clamp_index(stop, if st < 0 { -1 } else { len }, len, st);
    let mut out: Vec[i64] = Vec.new();
    let mut i = a;
    while (st > 0 and i < b) or (st < 0 and i > b) {
        out.push(i);
        i += st;
    }
    Ok(out)
}

// Markup.striptags: comments and tags out, whitespace collapsed, then
// html.unescape.
fn striptags(s: ref String, env: ref Env) -> Result[String, PyError] {
    let cs = to_chars(s);
    let lt = ['<'];
    let mut parts = String.new();
    let mut pos = 0;
    loop {
        let start = find_at(cs, lt, pos);
        if start < 0 {
            break;
        }
        let mut end = 0;
        if starts_at(cs, "<!--", start) {
            end = find_at(cs, to_chars("-->".to_string()), start + 4);
            if end < 0 {
                break;
            }
            end += 3;
        } else {
            end = find_at(cs, ['>'], start);
            if end < 0 {
                break;
            }
            end += 1;
        }
        parts.push_str(text(cs, pos, start));
        pos = end;
    }
    let mut value = s.clone();
    if pos > 0 {
        parts.push_str(text(cs, pos, cs.len()));
        value = parts;
    }
    let words = py_split(value, None, -1, env)?;
    Ok(unescape(words.join(" "), env.ents))
}

fn markups(v: ref Vec[String]) -> Vec[Value] {
    let mut out: Vec[Value] = Vec.new();
    for s in v.iter() {
        out.push(Value.Markup(s.clone()));
    }
    out
}

fn opt_text(args: ref Vec[Value], k: i64) -> Option[String] {
    if k < args.len() and is_text(args[k]) { Some(text_of(args[k])) } else { None }
}

fn int_arg(args: ref Vec[Value], k: i64, dflt: i64) -> i64 {
    if k < args.len() {
        match args[k] {
            Value.Int(n) => return n,
            Value.Bool(b) => return if b { 1 } else { 0 },
            _ => {}
        }
    }
    dflt
}

// m.<meth>(*args) for a Markup m.
fn call_method(m: ref String, meth: ref String, args: ref Vec[Value], env: ref Env) -> Result[Value, PyError] {
    if meth == "split" {
        return Ok(Value.List(markups(py_split(m, opt_text(args, 0), int_arg(args, 1, -1), env)?)));
    }
    if meth == "rsplit" {
        return Ok(Value.List(markups(py_rsplit(m, opt_text(args, 0), int_arg(args, 1, -1), env)?)));
    }
    if meth == "splitlines" {
        let keep = match args.get(0) {
            Some(Value.Bool(b)) => b,
            _ => false,
        };
        return Ok(Value.List(markups(py_splitlines(m, keep, env))));
    }
    if meth == "strip" or meth == "lstrip" or meth == "rstrip" {
        let l = meth != "rstrip";
        let r = meth != "lstrip";
        return Ok(Value.Markup(py_strip(m, opt_text(args, 0), l, r, env)));
    }
    if meth == "lower" {
        return Ok(Value.Markup(env.uni.lower(m)));
    }
    if meth == "upper" {
        return Ok(Value.Markup(env.uni.upper(m)));
    }
    if meth == "title" {
        return Ok(Value.Markup(env.uni.title(m)));
    }
    if meth == "capitalize" {
        return Ok(Value.Markup(env.uni.capitalize(m)));
    }
    if meth == "swapcase" {
        return Ok(Value.Markup(env.uni.swapcase(m)));
    }
    if meth == "casefold" {
        return Ok(Value.Markup(env.uni.casefold(m)));
    }
    if meth == "replace" {
        let new = escape(args[1], env)?;
        return Ok(Value.Markup(py_replace(m, text_of(args[0]), new, int_arg(args, 2, -1))));
    }
    if meth == "ljust" or meth == "rjust" or meth == "center" {
        let fill = if args.len() > 1 { fill_char(escape(args[1], env)?)? } else { ' ' };
        let how = if meth == "ljust" { 'l' } else if meth == "rjust" { 'r' } else { 'c' };
        return Ok(Value.Markup(py_justify(m, int_arg(args, 0, 0), fill, how)));
    }
    if meth == "zfill" {
        return Ok(Value.Markup(py_zfill(m, int_arg(args, 0, 0))));
    }
    if meth == "expandtabs" {
        return Ok(Value.Markup(py_expandtabs(m, int_arg(args, 0, 8))));
    }
    if meth == "removeprefix" {
        let p = text_of(args[0]);
        return Ok(Value.Markup(if m.starts_with(p.as_str()) { m[p.len()..].to_string() } else { m.clone() }));
    }
    if meth == "removesuffix" {
        let p = text_of(args[0]);
        return Ok(Value.Markup(if p.len() > 0 and m.ends_with(p.as_str()) { m[..m.len() - p.len()].to_string() } else { m.clone() }));
    }
    if meth == "partition" or meth == "rpartition" {
        let cs = to_chars(m);
        let pat = to_chars(text_of(args[0]));
        if pat.len() == 0 {
            return Err(value_error("empty separator"));
        }
        let at = if meth == "partition" { find_at(cs, pat, 0) } else { rfind_at(cs, pat) };
        let parts = if at < 0 {
            if meth == "partition" {
                vec![m.clone(), String.new(), String.new()]
            } else {
                vec![String.new(), String.new(), m.clone()]
            }
        } else {
            vec![text(cs, 0, at), text(pat, 0, pat.len()), text(cs, at + pat.len(), cs.len())]
        };
        return Ok(Value.Tuple(markups(parts)));
    }
    if meth == "unescape" {
        return Ok(Value.Str(unescape(m, env.ents)));
    }
    if meth == "striptags" {
        return Ok(Value.Str(striptags(m, env)?));
    }
    if meth == "getitem" {
        return get_item(Value.Markup(m.clone()), args[0], env);
    }
    if meth == "slice" {
        let cs = to_chars(m);
        let a = if args.len() > 0 { args[0].clone() } else { Value.Nil };
        let b = if args.len() > 1 { args[1].clone() } else { Value.Nil };
        let c = if args.len() > 2 { args[2].clone() } else { Value.Nil };
        let mut out = String.new();
        for k in slice_indices(cs.len(), a, b, c)? {
            out.push(cs[k]);
        }
        return Ok(Value.Markup(out));
    }
    if meth == "join" {
        let items = match args[0] {
            Value.List(xs) => xs.clone(),
            Value.Tuple(xs) => xs.clone(),
            _ => Vec.new(),
        };
        let mut parts: Vec[String] = Vec.new();
        for x in items.iter() {
            parts.push(escape(x, env)?);
        }
        return Ok(Value.Markup(parts.join(m.as_str())));
    }
    Err(py_error("AttributeError", f"'Markup' object has no attribute '{meth}'"))
}


// ---------------------------------------------------------------- html.unescape

// The numeric-character-reference-end-state table of html/__init__.py.
fn invalid_charref(num: i64) -> Option[i64] {
    if num == 0 {
        return Some(0xfffd);
    }
    if num == 0x0d {
        return Some(0x0d);
    }
    if num < 0x80 or num > 0x9f {
        return None;
    }
    let table: Vec[i64] = vec![
        0x20ac, 0x81, 0x201a, 0x0192, 0x201e, 0x2026, 0x2020, 0x2021,
        0x02c6, 0x2030, 0x0160, 0x2039, 0x0152, 0x8d, 0x017d, 0x8f,
        0x90, 0x2018, 0x2019, 0x201c, 0x201d, 0x2022, 0x2013, 0x2014,
        0x02dc, 0x2122, 0x0161, 0x203a, 0x0153, 0x9d, 0x017e, 0x0178,
    ];
    Some(table[num - 0x80])
}

fn invalid_codepoint(num: i64) -> bool {
    if (num >= 0x1 and num <= 0x8) or num == 0xb or (num >= 0xe and num <= 0x1f) {
        return true;
    }
    if (num >= 0x7f and num <= 0x9f) or (num >= 0xfdd0 and num <= 0xfdef) {
        return true;
    }
    num % 0x10000 >= 0xfffe and num <= 0x10ffff
}

fn push_code(out: mut ref String, num: i64) {
    match char.try_from(num) {
        Ok(c) => out.push(c),
        Err(_) => out.push('\u{fffd}'),
    }
}

fn numeric_ref(num: i64, out: mut ref String) {
    match invalid_charref(num) {
        Some(v) => {
            push_code(mut out, v);
            return;
        }
        None => {}
    }
    if (num >= 0xd800 and num <= 0xdfff) or num > 0x10ffff {
        out.push('\u{fffd}');
        return;
    }
    if invalid_codepoint(num) {
        return;
    }
    push_code(mut out, num);
}

// The digits raw[lo..hi] in base 10 or 16, held at 0x110000 once past
// the last code point, as int() then the range check would decide.
fn ref_number(raw: ref Vec[char], lo: i64, hi: i64, base: i64) -> i64 {
    let mut n = 0;
    let mut k = lo;
    while k < hi {
        let c = raw[k];
        let d = if is_digit(c) {
            c as i64 - '0' as i64
        } else {
            ascii_lower(c) as i64 - 'a' as i64 + 10
        };
        n = n * base + d;
        if n > 0x10ffff {
            n = 0x110000;
        }
        k += 1;
    }
    n
}

// A named reference's text, the name possibly ending in ';'.
fn named_ref(name: ref Vec[char], ents: ref Map[String, String], out: mut ref String) {
    let whole = text(name, 0, name.len());
    match ents.get(whole.clone()) {
        Some(v) => {
            out.push_str(v);
            return;
        }
        None => {}
    }
    // The longest name the standard allows as a prefix.
    let mut x = name.len() - 1;
    while x > 1 {
        match ents.get(text(name, 0, x)) {
            Some(v) => {
                out.push_str(v);
                out.push_str(text(name, x, name.len()));
                return;
            }
            None => {}
        }
        x -= 1;
    }
    out.push('&');
    out.push_str(whole);
}

fn named_class(c: char) -> bool {
    not (c == '\t' or c == '\n' or c == '\u{c}' or c == ' ' or c == '<' or c == '&' or c == '#' or c == ';')
}

// html.unescape over raw[lo..hi].
fn unescape_chars(raw: ref Vec[char], lo: i64, hi: i64, ents: ref Map[String, String]) -> String {
    let mut out = String.new();
    let mut p = lo;
    while p < hi {
        if raw[p] != '&' {
            out.push(raw[p]);
            p += 1;
            continue;
        }
        if p + 1 < hi and raw[p + 1] == '#' {
            if p + 2 < hi and is_digit(raw[p + 2]) {
                let mut q = p + 2;
                while q < hi and is_digit(raw[q]) {
                    q += 1;
                }
                numeric_ref(ref_number(raw, p + 2, q, 10), mut out);
                if q < hi and raw[q] == ';' {
                    q += 1;
                }
                p = q;
            } else if p + 3 < hi and (raw[p + 2] == 'x' or raw[p + 2] == 'X') and is_hex(raw[p + 3]) {
                let mut q = p + 3;
                while q < hi and is_hex(raw[q]) {
                    q += 1;
                }
                numeric_ref(ref_number(raw, p + 3, q, 16), mut out);
                if q < hi and raw[q] == ';' {
                    q += 1;
                }
                p = q;
            } else {
                out.push('&');
                p += 1;
            }
            continue;
        }
        let mut q = p + 1;
        while q < hi and q - (p + 1) < 32 and named_class(raw[q]) {
            q += 1;
        }
        if q == p + 1 {
            out.push('&');
            p += 1;
            continue;
        }
        if q < hi and raw[q] == ';' {
            q += 1;
        }
        let name: Vec[char] = raw[p + 1..q].iter().collect();
        named_ref(name, ents, mut out);
        p = q;
    }
    out
}

fn unescape(s: ref String, ents: ref Map[String, String]) -> String {
    let raw = to_chars(s);
    unescape_chars(raw, 0, raw.len(), ents)
}

fn html5_entities() -> Map[String, String] {
    let mut m: Map[String, String] = Map.new();
    add_entities_0(mut m);
    add_entities_1(mut m);
    add_entities_2(mut m);
    add_entities_3(mut m);
    add_entities_4(mut m);
    add_entities_5(mut m);
    add_entities_6(mut m);
    add_entities_7(mut m);
    add_entities_8(mut m);
    m
}

