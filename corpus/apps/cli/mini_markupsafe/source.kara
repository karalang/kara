// ------------------------------------------------------------ jobs

fn unesc(s: Str) -> String {
    let cs = to_chars(s.to_string());
    let mut out = String.new();
    let mut i = 0;
    while i < cs.len() {
        if cs[i] == '\\' and i + 1 < cs.len() {
            let n = cs[i + 1];
            out.push(if n == 't' { '\t' } else if n == 'n' { '\n' } else { n });
            i += 2;
        } else {
            out.push(cs[i]);
            i += 1;
        }
    }
    out
}

fn add_values(a: ref Value, b: ref Value, env: ref Env) -> Result[Value, PyError] {
    let a_markup = match a { Value.Markup(_) => true, _ => false };
    let b_markup = match b { Value.Markup(_) => true, _ => false };
    if a_markup {
        if is_text(b) or has_html(b) {
            return Ok(Value.Markup(f"{text_of(a)}{escape(b, env)?}"));
        }
    } else if b_markup {
        // Markup is a str subclass, so its __radd__ goes first.
        if is_text(a) or has_html(a) {
            return Ok(Value.Markup(f"{escape(a, env)?}{text_of(b)}"));
        }
    } else if is_text(a) and is_text(b) {
        return Ok(Value.Str(f"{text_of(a)}{text_of(b)}"));
    }
    Err(type_error(f"unsupported operand type(s) for +: '{type_name(a)}' and '{type_name(b)}'"))
}

fn mul_value(m: ref Value, n: ref Value) -> Value {
    let k = match n {
        Value.Int(k) => k,
        Value.Bool(b) => if b { 1 } else { 0 },
        _ => 0,
    };
    let mut out = String.new();
    for _ in 0..k {
        out.push_str(text_of(m));
    }
    Value.Markup(out)
}

fn arg_tuple(s: ref String, env: ref Env) -> Result[Vec[Value], PyError] {
    if s.len() == 0 {
        return Ok(Vec.new());
    }
    match parse_value(f"({s},)", env)? {
        Value.Tuple(xs) => Ok(xs),
        other => Ok(vec![other]),
    }
}

// The forum thread, rendered as oracle.py's thread() renders it.
fn preview(html: ref String, env: ref Env) -> Result[String, PyError] {
    let t = striptags(html, env)?;
    let cs = to_chars(t);
    if cs.len() <= 40 {
        return Ok(t);
    }
    Ok(f"{text(cs, 0, 39)}\u{2026}")
}

fn render_thread(title: ref Value, comments: ref Value, env: ref Env) -> Result[Vec[String], PyError] {
    let mut out: Vec[String] = Vec.new();
    out.push(markup_mod("<h1>%s</h1>", title, env)?);
    out.push("<ul>".to_string());
    let list = match comments {
        Value.List(xs) => xs.clone(),
        _ => Vec.new(),
    };
    let mut names: Vec[String] = Vec.new();
    for c in list.iter() {
        let f = match c {
            Value.Tuple(xs) => xs.clone(),
            _ => Vec.new(),
        };
        let user = f[0].clone();
        let id = match user {
            Value.User(_, _, id) => id,
            _ => 0,
        };
        names.push(to_str(user, env));
        let mut badges: Vec[String] = Vec.new();
        let tags = match f[3] {
            Value.List(xs) => xs.clone(),
            _ => Vec.new(),
        };
        for t in tags.iter() {
            badges.push(escape(Value.Badge(text_of(t)), env)?);
        }
        let badge_text = if tags.len() > 0 { Value.Markup(f" {badges.join(" ")}") } else { Value.Str(String.new()) };
        let lines = py_split(escape(f[1], env)?, Some("\n".to_string()), -1, env)?;
        let head_args: Vec[Value] = vec![Value.Int(id), user, f[2].clone(), badge_text];
        out.push(markup_format("<li id=\"c{0}\"><p>{1:link} {2:+d}{3}</p>", head_args, Vec.new(), env)?);
        let body: Vec[Value] = vec![Value.Markup(lines.join("<br>"))];
        out.push(markup_format("<div>{}</div>", body, Vec.new(), env)?);
        match f[4] {
            Value.Str(html) => {
                let pv = preview(html, env)?;
                let pair = Value.Tuple(vec![Value.Str(pv), Value.Markup(html.clone())]);
                out.push(markup_mod("<p class=\"preview\" title=\"%s\">%s</p>", pair, env)?);
            }
            _ => {}
        }
        out.push("</li>".to_string());
    }
    out.push("</ul>".to_string());
    let tail = Value.Tuple(vec![Value.Int(list.len()), Value.Str(names.join(", "))]);
    out.push(markup_mod("<p>%d comments by %s</p>", tail, env)?);
    let mut lines: Vec[String] = Vec.new();
    for o in out.iter() {
        for l in py_split(o, Some("\n".to_string()), -1, env)?.into_iter() {
            lines.push(l);
        }
    }
    Ok(lines)
}

fn run_op(op: ref String, f: ref Vec[String], env: ref Env) -> Result[Value, PyError] {
    if op == "escape" {
        return Ok(Value.Markup(escape(parse_value(f[1], env)?, env)?));
    }
    if op == "escape_silent" {
        let v = parse_value(f[1], env)?;
        return Ok(Value.Markup(match v {
            Value.Nil => String.new(),
            _ => escape(v, env)?,
        }));
    }
    if op == "soft_str" {
        let v = parse_value(f[1], env)?;
        return Ok(if is_text(v) { v } else { Value.Str(to_str(v, env)) });
    }
    if op == "markup" {
        return Ok(Value.Markup(markup_of(parse_value(f[1], env)?, env)?));
    }
    if op == "str" {
        return Ok(Value.Str(to_str(parse_value(f[1], env)?, env)));
    }
    if op == "repr" {
        return Ok(Value.Str(repr(parse_value(f[1], env)?, false, env)));
    }
    if op == "add" {
        return add_values(parse_value(f[1], env)?, parse_value(f[2], env)?, env);
    }
    if op == "mul" {
        return Ok(mul_value(parse_value(f[1], env)?, parse_value(f[2], env)?));
    }
    if op == "rmul" {
        return Ok(mul_value(parse_value(f[2], env)?, parse_value(f[1], env)?));
    }
    if op == "mod" {
        let m = parse_value(f[1], env)?;
        return Ok(Value.Markup(markup_mod(text_of(m), parse_value(f[2], env)?, env)?));
    }
    if op == "format" or op == "format_map" {
        let m = parse_value(f[1], env)?;
        let (args, kw) = if op == "format" {
            (match parse_value(f[2], env)? { Value.Tuple(xs) => xs, _ => Vec.new() }, parse_value(f[3], env)?)
        } else {
            (Vec.new(), parse_value(f[2], env)?)
        };
        let pairs = match kw {
            Value.Dict(p) => p,
            _ => Vec.new(),
        };
        return Ok(Value.Markup(markup_format(text_of(m), args, pairs, env)?));
    }
    if op == "call" {
        let m = parse_value(f[1], env)?;
        let args = arg_tuple(f[3], env)?;
        return call_method(text_of(m), f[2], args, env);
    }
    if op == "striptags" {
        return Ok(Value.Str(striptags(text_of(parse_value(f[1], env)?), env)?));
    }
    if op == "unescape" {
        return Ok(Value.Str(unescape(text_of(parse_value(f[1], env)?), env.ents)));
    }
    Err(py_error("SystemExit", f"unknown op {op}"))
}

fn run() -> Result[(), String] {
    let jobs = match fs.read_to_string("data/jobs.tsv") {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/jobs.tsv: {e}"),
    };
    let env = Env { uni: load_uni()?, ents: html5_entities() };
    let mut out: Vec[String] = Vec.new();
    for line in jobs.lines() {
        if line.starts_with("== ") {
            out.push(line.to_string());
            continue;
        }
        let mut f: Vec[String] = Vec.new();
        for x in line.split("\t") {
            f.push(unesc(x));
        }
        let op = f[0].clone();
        let mut head = f"-- {op}";
        for k in 1..f.len() {
            head.push(' ');
            head.push_str(f[k]);
        }
        out.push(head);
        if op == "thread" {
            let r = match parse_value(f[1], env) {
                Ok(title) => match parse_value(f[2], env) {
                    Ok(cs) => render_thread(title, cs, env),
                    Err(e) => Err(e),
                },
                Err(e) => Err(e),
            };
            match r {
                Ok(lines) => {
                    for l in lines {
                        out.push(f"   {l}");
                    }
                }
                Err(e) => out.push(f"   error: {e.kind}: {e.msg}"),
            }
            continue;
        }
        match run_op(op, f, env) {
            Ok(v) => out.push(f"   {repr(v, false, env)}"),
            Err(e) => out.push(f"   error: {e.kind}: {e.msg}"),
        }
    }
    for l in out.iter() {
        println(l);
    }
    Ok(())
}

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn hex_val(c: u8) -> u8 {
    if c >= b'a' { c - b'a' + 10 } else { c - b'0' }
}

fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    if let Err(e) = run() {
        eprintln(e);
    }
}

// ------------------------------------------------------------ data

// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    v
}

fn data_part_0(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
