fn data_part_1(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("root = true\n");
    t.push_str("[*]\n");
    t.push_str("alt = file\n");
    t.push_str("indent_style = tab\n");
    v.push(DataFile { path: "root/alt/.ec".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("root = true\n");
    t.push_str("[*]\n");
    t.push_str("alt = no\n");
    v.push(DataFile { path: "root/alt/.editorconfig".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("root = true\n");
    t.push_str("[*]\n");
    t.push_str("indent_size = 4\n");
    t.push_str("this line has no separator\n");
    t.push_str("[*.c]\n");
    t.push_str("= no name\n");
    t.push_str("indent_style = tab\n");
    t.push_str("  just words\n");
    t.push_str("[*.h\n");
    t.push_str("tab_width = 4\n");
    v.push(DataFile { path: "root/broken/.editorconfig".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("[*]\n");
    t.push_str("from = sub\n");
    v.push(DataFile { path: "root/dironly/sub/.editorconfig".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("# SPDX-style header comment\n");
