EditorConfig Python Core Version 0.17.1
== glob "*.py"
regex: (?s)[^/]*\.py\Z
  "a.py" -> yes
  "dir/a.py" -> no
  ".py" -> yes
  "a.pyc" -> no
== glob "**.py"
regex: (?s).*[^/]*\.py\Z
  "a.py" -> yes
  "dir/a.py" -> yes
  "x/y/z.py" -> yes
== glob "**/*.py"
regex: (?s).*[^/]*/[^/]*\.py\Z
  "a.py" -> no
  "/a.py" -> yes
  "dir/a.py" -> yes
== glob "a/**/b"
regex: (?s)a(?:/|/.*/)b\Z
  "a/b" -> yes
  "a/x/b" -> yes
  "a/x/y/b" -> yes
  "ab" -> no
== glob "?.txt"
regex: (?s)[^/]\.txt\Z
  "a.txt" -> yes
  "ab.txt" -> no
  "/.txt" -> no
== glob "[abc].txt"
regex: (?s)[abc]\.txt\Z
  "a.txt" -> yes
  "d.txt" -> no
  "[abc].txt" -> no
== glob "[!abc].txt"
regex: (?s)[^abc]\.txt\Z
  "a.txt" -> no
  "d.txt" -> yes
  "!.txt" -> yes
== glob "[^abc].txt"
regex: (?s)[^abc]\.txt\Z
  "d.txt" -> yes
  "^.txt" -> yes
== glob "[a-c]x"
regex: (?s)[a-c]x\Z
  "bx" -> yes
  "-x" -> no
  "dx" -> no
== glob "[a/b]c"
regex: (?s)\[a/b]c\Z
  "[a/b]c" -> yes
  "a/bc" -> no
  "ac" -> no
== glob "[*]"
regex: (?s)[[^/]*]\Z
  "*" -> no
  "x" -> no
  "]" -> yes
  "*]" -> no
  "xx]" -> no
== glob "[?*]"
regex: (?s)[[^/][^/]*]\Z
  "?" -> no
  "a" -> no
  "ab]" -> no
  "[ab]" -> yes
== glob "{a,b}.c"
regex: (?s)(?:a|b)\.c\Z
  "a.c" -> yes
  "b.c" -> yes
  "ab.c" -> no
  "{a,b}.c" -> no
== glob "{a}.c"
regex: (?s)\{a\}\.c\Z
  "a.c" -> no
  "{a}.c" -> yes
== glob "{a,b.c"
regex: (?s)\{a\,b\.c\Z
  "{a,b.c" -> yes
  "a" -> no
== glob "a,b"
regex: (?s)a\,b\Z
  "a,b" -> yes
  "a" -> no
== glob "{a\\,b,c}"
regex: (?s)(?:a\,b|c)\Z
  "a,b" -> yes
  "c" -> yes
  "a" -> no
== glob "\\*.txt"
regex: (?s)[^/]*\.txt\Z
  "*.txt" -> yes
  "a.txt" -> yes
== glob "\\\\x"
regex: (?s)\\x\Z
  "\\x" -> yes
== glob "{1..5}"
regex: (?s)([+-]?\d+)\Z
