// mini_jsonlogic: a JsonLogic rules engine, the JSON rule format feature
// flag services and form validators share between server and browser. The
// operations of panzi-json-logic's Python port with its JavaScript-style
// coercions (loose equality, `+` on strings, `"%.15g"` number text), the
// short-circuit and list forms, and `var` paths, deciding a web shop's
// feature flags for a few users and then running single cases.
// README.md is the spec; oracle.py is the reference.

import std.encoding.hex_decode;
import std.json.{Json};

// ------------------------------------------------------------ values

/// A Python value as `json.loads` makes it: `Int` and `Float` stay apart,
/// and an object keeps its keys in order.
#[derive(Clone)]
enum Val {
    Null,
    Bool(bool),
    Int(i64),
    Float(f64),
    Str(String),
    List(Vec[Val]),
    Obj(Vec[(String, Val)]),
}

fn from_json(j: own Json) -> Val {
    match j {
        Json.Null => Val.Null,
        Json.Bool(b) => Val.Bool(b),
        Json.Int(i) => Val.Int(i),
        Json.Number(f) => Val.Float(f),
        Json.String(s) => Val.Str(s),
        Json.Array(xs) => Val.List(xs.into_iter().map(|x| from_json(x)).collect()),
        Json.Object(fields) => Val.Obj(fields.into_iter().map(|(k, v)| (k, from_json(v))).collect()),
    }
}

fn get_key(fields: Slice[(String, Val)], key: Str) -> Option[Val] {
    for (k, v) in fields.iter() {
        if k == key {
            return Some(v.clone());
        }
    }
    None
}

// ------------------------------------------------------------ text

/// Python's `repr` of a string, for the operation names the cases use.
fn py_repr(s: Str) -> String {
    let q = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        if c == '\\' or c == q {
            out.push('\\');
        }
        out.push(c);
    }
    out.push(q);
    out
}

fn hex4(n: i64) -> String {
    let digits = "0123456789abcdef";
    let mut out = "\\u".to_string();
    for shift in [12, 8, 4, 0] {
        let d = (n >> shift) & 15;
        out.push_str(digits[d..d + 1]);
    }
    out
}

/// `json.dumps` of a string: ASCII only, as `ensure_ascii` writes it.
fn json_string(s: Str) -> String {
    let mut out = "\"".to_string();
    for c in s.chars() {
        match c {
            '"' => out.push_str("\\\""),
            '\\' => out.push_str("\\\\"),
            '\n' => out.push_str("\\n"),
            '\r' => out.push_str("\\r"),
            '\t' => out.push_str("\\t"),
            '\u{8}' => out.push_str("\\b"),
            '\u{c}' => out.push_str("\\f"),
            _ => {
                let n = c as i64;
                if n >= 32 and n <= 126 {
                    out.push(c);
                } else if n < 65536 {
                    out.push_str(hex4(n));
                } else {
                    let v = n - 65536;
                    out.push_str(hex4(55296 + (v >> 10)));
                    out.push_str(hex4(56320 + (v & 1023)));
                }
            }
        }
    }
    out.push('"');
    out
}

/// `json.dumps` with its default separators; NaN and the infinities as
/// Python writes them.
fn dumps(v: ref Val) -> String {
    match v {
        Val.Null => "null".to_string(),
        Val.Bool(b) => if b { "true".to_string() } else { "false".to_string() },
        Val.Int(i) => f"{i}",
        Val.Float(x) => {
            if x.is_nan() {
                "NaN".to_string()
            } else if x.is_infinite() {
                if x > 0.0 { "Infinity".to_string() } else { "-Infinity".to_string() }
            } else {
                f"{x}"
            }
        }
        Val.Str(s) => json_string(s),
        Val.List(xs) => {
            let parts: Vec[String] = xs.iter().map(|x| dumps(x)).collect();
            f"[{parts.join(", ")}]"
        }
        Val.Obj(fields) => {
            let parts: Vec[String] = fields.iter().map(|(k, x)| f"{json_string(k)}: {dumps(x)}").collect();
            "{" + parts.join(", ") + "}"
        }
    }
}

/// `"%.15g" % x`: fifteen significant digits, correctly rounded (half to
/// even on an exact tie), trailing zeros dropped, and an exponent when the
/// decimal exponent is below -4 or at least 15.
fn format_g15(x: f64) -> String {
    if x.is_nan() {
        return "nan".to_string();
    }
    if x.is_infinite() {
        return if x > 0.0 { "inf".to_string() } else { "-inf".to_string() };
    }
    let sign = if x.is_sign_negative() { "-" } else { "" };
    let a = x.abs();
    if a == 0.0 {
        return f"{sign}0";
    }
    // Every digit of the exact binary value: a double has at most 1074
    // digits after the point.
    let text = f"{a:.1100}";
    let (whole, frac) = text.split_once(".").unwrap();
    let all: Vec[char] = whole.chars().chain(frac.chars()).collect();
    let mut first = 0;
    while all[first] == '0' {
        first += 1;
    }
    let mut exp = whole.len() - 1 - first;
    let mut digits: Vec[i64] = Vec.new();
    for k in first..first + 15 {
        digits.push(if k < all.len() { (all[k] as i64) - ('0' as i64) } else { 0 });
    }
    let rest = if first + 15 < all.len() { all[first + 15..].to_vec() } else { Vec.new() };
    let up = if rest.is_empty() or rest[0] < '5' {
        false
    } else if rest[0] > '5' or rest[1..].iter().any(|c| *c != '0') {
        true
    } else {
        digits[14] % 2 == 1
    };
    if up {
        let mut k = 14;
        loop {
            digits[k] += 1;
            if digits[k] < 10 {
                break;
            }
            digits[k] = 0;
            if k == 0 {
                digits.insert(0, 1);
                digits.pop();
                exp += 1;
                break;
            }
            k -= 1;
        }
    }
    while digits.len() > 1 and digits[digits.len() - 1] == 0 {
        digits.pop();
    }
    let mut ds = String.new();
    for d in digits.iter() {
        ds.push_str(f"{d}");
    }
    if exp < -4 or exp >= 15 {
        let mant = if ds.len() > 1 { f"{ds[0..1]}.{ds[1..]}" } else { ds.clone() };
        let esign = if exp < 0 { "-" } else { "+" };
        let e = exp.abs();
        let epad = if e < 10 { f"0{e}" } else { f"{e}" };
        return f"{sign}{mant}e{esign}{epad}";
    }
    if exp < 0 {
        let mut zeros = String.new();
        for _ in 0..(-exp - 1) {
            zeros.push('0');
        }
        return f"{sign}0.{zeros}{ds}";
    }
    let int_len = exp + 1;
    if ds.len() <= int_len {
        let mut s = ds.clone();
        while s.len() < int_len {
            s.push('0');
        }
        f"{sign}{s}"
    } else {
        f"{sign}{ds[0..int_len]}.{ds[int_len..]}"
    }
}

// ------------------------------------------------------------ coercions

/// Python's `float(s)`: surrounding whitespace, a sign, `inf`, `infinity`
/// or `nan` in any case, or decimal digits with single underscores between
/// them, a point and an exponent.
fn py_float(s: Str) -> Option[f64] {
    let t = s.trim();
    let (neg, body) = if let Some(r) = t.strip_prefix("-") {
        (true, r)
    } else if let Some(r) = t.strip_prefix("+") {
        (false, r)
    } else {
        (false, t)
    };
    let low = body.to_lowercase();
    if low == "inf" or low == "infinity" {
        return Some(if neg { -f64.INFINITY } else { f64.INFINITY });
    }
    if low == "nan" {
        return Some(f64.NAN);
    }
    let cs: Vec[char] = body.chars().collect();
    let mut clean = String.new();
    let mut i = 0;
    let mut int_digits = 0;
    let mut frac_digits = 0;
    // A run of digits with single underscores between them.
    while i < cs.len() and cs[i].is_ascii_digit() {
        clean.push(cs[i]);
        int_digits += 1;
        i += 1;
        if i + 1 < cs.len() and cs[i] == '_' and cs[i + 1].is_ascii_digit() {
            i += 1;
        }
    }
    if i < cs.len() and cs[i] == '.' {
        clean.push('.');
        i += 1;
        while i < cs.len() and cs[i].is_ascii_digit() {
            clean.push(cs[i]);
            frac_digits += 1;
            i += 1;
            if i + 1 < cs.len() and cs[i] == '_' and cs[i + 1].is_ascii_digit() {
                i += 1;
            }
        }
    }
    if int_digits + frac_digits == 0 {
        return None;
    }
    if i < cs.len() and (cs[i] == 'e' or cs[i] == 'E') {
        clean.push('e');
        i += 1;
        if i < cs.len() and (cs[i] == '+' or cs[i] == '-') {
            clean.push(cs[i]);
            i += 1;
        }
        let mut exp_digits = 0;
        while i < cs.len() and cs[i].is_ascii_digit() {
            clean.push(cs[i]);
            exp_digits += 1;
            i += 1;
            if i + 1 < cs.len() and cs[i] == '_' and cs[i + 1].is_ascii_digit() {
                i += 1;
            }
        }
        if exp_digits == 0 {
            return None;
        }
    }
    if i != cs.len() {
        return None;
    }
    let x = f64.parse(clean).ok()?;
    Some(if neg { -x } else { x })
}

fn is_num(v: ref Val) -> bool {
    match v {
        Val.Int(_) | Val.Float(_) | Val.Bool(_) => true,
        _ => false,
    }
}

/// The value of an int-like number (an `int` or a `bool`).
fn int_of(v: ref Val) -> Option[i64] {
    match v {
        Val.Int(i) => Some(i),
        Val.Bool(b) => Some(if b { 1 } else { 0 }),
        _ => None,
    }
}

fn f64_of(v: ref Val) -> f64 {
    match v {
        Val.Int(i) => i as f64,
        Val.Bool(b) => if b { 1.0 } else { 0.0 },
        Val.Float(x) => x,
        _ => f64.NAN,
    }
}

/// `to_number`: numbers (booleans among them) as they are, `None` as 0, a
/// list by its one item, text through `float()`, and NaN for the rest.
fn to_number(v: ref Val) -> Val {
    match v {
        Val.Int(_) | Val.Float(_) | Val.Bool(_) => v.clone(),
        Val.Null => Val.Int(0),
        Val.List(xs) => {
            if xs.is_empty() {
                Val.Int(0)
            } else if xs.len() > 1 {
                Val.Float(f64.NAN)
            } else {
                to_number(xs[0])
            }
        }
        Val.Obj(_) => Val.Float(f64.NAN),
        Val.Str(s) => {
            let low = s.trim().to_lowercase();
            if low == "inf" or low == "-inf" or low == "+inf" {
                return Val.Float(f64.NAN);
            }
            Val.Float(py_float(s) ?? f64.NAN)
        }
    }
}

/// `to_string`: text as it is, a float through `"%.15g"`, and a boolean
/// through `str()`, since a Python `bool` is an `int`.
fn to_string(v: ref Val) -> String {
    match v {
        Val.Str(s) => s.clone(),
        Val.Float(x) => format_g15(x),
        Val.Int(i) => f"{i}",
        Val.Bool(b) => if b { "True".to_string() } else { "False".to_string() },
        Val.Null => "null".to_string(),
        Val.List(xs) => {
            let parts: Vec[String] = xs.iter().map(|x| to_string(x)).collect();
            parts.join(",")
        }
        Val.Obj(_) => "[object Object]".to_string(),
    }
}

fn to_bool(v: ref Val) -> bool {
    match v {
        Val.Null => false,
        Val.Bool(b) => b,
        Val.Float(x) => not x.is_nan() and x != 0.0,
        Val.Int(i) => i != 0,
        Val.Str(s) => not s.is_empty(),
        Val.List(xs) => not xs.is_empty(),
        Val.Obj(_) => true,
    }
}

// Python's comparisons between numbers of any of the three kinds.

fn num_lt(a: ref Val, b: ref Val) -> bool {
    match (int_of(a), int_of(b)) {
        (Some(x), Some(y)) => x < y,
        _ => f64_of(a) < f64_of(b),
    }
}

fn num_eq(a: ref Val, b: ref Val) -> bool {
    match (int_of(a), int_of(b)) {
        (Some(x), Some(y)) => x == y,
        _ => f64_of(a) == f64_of(b),
    }
}

/// Python's `==`: numbers across kinds, lists item by item, dicts by their
/// keys and values in any order.
fn py_eq(a: ref Val, b: ref Val) -> bool {
    if is_num(a) and is_num(b) {
        return num_eq(a, b);
    }
    match (a, b) {
        (Val.Null, Val.Null) => true,
        (Val.Str(x), Val.Str(y)) => x == y,
        (Val.List(xs), Val.List(ys)) => {
            if xs.len() != ys.len() {
                return false;
            }
            for k in 0..xs.len() {
                if not py_eq(xs[k], ys[k]) {
                    return false;
                }
            }
            true
        }
        (Val.Obj(xs), Val.Obj(ys)) => {
            if xs.len() != ys.len() {
                return false;
            }
            for (k, v) in xs.iter() {
                match get_key(ys, k) {
                    Some(w) => {
                        if not py_eq(v, w) {
                            return false;
                        }
                    }
                    None => return false,
                }
            }
            true
        }
        _ => false,
    }
}

fn same_kind(a: ref Val, b: ref Val) -> bool {
    match (a, b) {
        (Val.Null, Val.Null) | (Val.Bool(_), Val.Bool(_)) | (Val.Int(_), Val.Int(_)) => true,
        (Val.Float(_), Val.Float(_)) | (Val.Str(_), Val.Str(_)) => true,
        (Val.List(_), Val.List(_)) | (Val.Obj(_), Val.Obj(_)) => true,
        _ => false,
    }
}

fn is_container(v: ref Val) -> bool {
    match v {
        Val.List(_) | Val.Obj(_) => true,
        _ => false,
    }
}

/// `op_equals`, the loose `==`. Two lists or objects are never the same
/// object here (README.md).
fn loose_eq(a: ref Val, b: ref Val) -> bool {
    if same_kind(a, b) {
        if is_container(a) {
            return false;
        }
        return py_eq(a, b);
    }
    if is_num(a) {
        return num_eq(a, if is_num(b) { b.clone() } else { to_number(b) });
    }
    if is_num(b) {
        return num_eq(to_number(a), b);
    }
    match (a, b) {
        (Val.Null, _) | (_, Val.Null) => false,
        (Val.Str(s), _) => s == to_string(b),
        (_, Val.Str(s)) => to_string(a) == s,
        _ => false,
    }
}

/// One of `<`, `<=`, `>`, `>=` between two values: numbers against the
/// other side as a number, then text against the other side as text, then
/// both as numbers.
fn compare(op: Str, a: ref Val, b: ref Val) -> bool {
    let (x, y, text) = if is_num(a) {
        (a.clone(), to_number(b), false)
    } else if is_num(b) {
        (to_number(a), b.clone(), false)
    } else if let Val.Str(_) = a {
        (a.clone(), Val.Str(to_string(b)), true)
    } else if let Val.Str(_) = b {
        (Val.Str(to_string(a)), b.clone(), true)
    } else {
        (to_number(a), to_number(b), false)
    };
    if text {
        let (Val.Str(s), Val.Str(t)) = (x, y) else {
            return false;
        };
        return match op {
            "<" => s < t,
            "<=" => s <= t,
            ">" => s > t,
            _ => s >= t,
        };
    }
    match op {
        "<" => num_lt(x, y),
        "<=" => num_lt(x, y) or num_eq(x, y),
        ">" => num_lt(y, x),
        _ => num_lt(y, x) or num_eq(x, y),
    }
}

// ------------------------------------------------------------ arithmetic

fn arith(op: Str, a: ref Val, b: ref Val) -> Result[Val, String] {
    if let (Some(x), Some(y)) = (int_of(a), int_of(b)) {
        return match op {
            "+" => Ok(Val.Int(x + y)),
            "-" => Ok(Val.Int(x - y)),
            "*" => Ok(Val.Int(x * y)),
            "/" => {
                if y == 0 {
                    return Err("ZeroDivisionError: division by zero".to_string());
                }
                Ok(Val.Float((x as f64) / (y as f64)))
            }
            _ => {
                if y == 0 {
                    return Err("ZeroDivisionError: integer modulo by zero".to_string());
                }
                let mut r = x % y;
                if r != 0 and (r < 0) != (y < 0) {
                    r += y;
                }
                Ok(Val.Int(r))
            }
        };
    }
    let x = f64_of(a);
    let y = f64_of(b);
    match op {
        "+" => Ok(Val.Float(x + y)),
        "-" => Ok(Val.Float(x - y)),
        "*" => Ok(Val.Float(x * y)),
        "/" => {
            if y == 0.0 {
                return Err("ZeroDivisionError: float division by zero".to_string());
            }
            Ok(Val.Float(x / y))
        }
        _ => {
            if y == 0.0 {
                return Err("ZeroDivisionError: float modulo by zero".to_string());
            }
            let mut m = x % y;
            if m != 0.0 {
                if (y < 0.0) != (m < 0.0) {
                    m += y;
                }
            } else {
                m = 0.0.copysign(y);
            }
            Ok(Val.Float(m))
        }
    }
}

fn negate(v: ref Val) -> Val {
    match int_of(v) {
        Some(i) => Val.Int(-i),
        None => Val.Float(-f64_of(v)),
    }
}

// ------------------------------------------------------------ var

/// A list or text's length, and its item at `i` (a character of text).
fn seq_len(v: ref Val) -> Option[i64] {
    match v {
        Val.List(xs) => Some(xs.len()),
        Val.Str(s) => Some(s.chars().count()),
        _ => None,
    }
}

fn seq_item(v: ref Val, i: i64) -> Val {
    match v {
        Val.List(xs) => xs[i].clone(),
        Val.Str(s) => Val.Str(s.char_at(i).unwrap().to_string()),
        _ => Val.Null,
    }
}

/// A path component that `int(prop, 10)` reads back as itself: `0`, or a
/// digit 1 to 9 and more digits.
fn canonical_index(prop: Str) -> Option[i64] {
    if prop.is_empty() or not prop.chars().all(|c| c.is_ascii_digit()) {
        return None;
    }
    if prop.len() > 1 and prop.starts_with("0") {
        return None;
    }
    i64.parse(prop).ok()
}

fn op_var(data: ref Val, key: ref Val, default: ref Val) -> Val {
    match key {
        Val.Null => return data.clone(),
        Val.Str(s) => {
            if s.is_empty() {
                return data.clone();
            }
        }
        _ => {}
    }
    if is_num(key) {
        let Some(n) = seq_len(data) else {
            // An object's keys are text, so a number finds nothing there.
            return default.clone();
        };
        let x = f64_of(key);
        if x.is_nan() {
            return default.clone();
        }
        let index = i64.checked_from(x) ?? -1;
        if not num_eq(Val.Int(index), key) or index < 0 or index >= n {
            return default.clone();
        }
        return seq_item(data, index);
    }
    let mut cur = data.clone();
    for prop in to_string(key).split(".") {
        if let Some(n) = seq_len(cur) {
            if prop == "length" {
                return Val.Int(n);
            }
            let Some(index) = canonical_index(prop) else {
                return default.clone();
            };
            if index >= n {
                return default.clone();
            }
            cur = seq_item(cur, index);
        } else if let Val.Obj(fields) = cur {
            cur = get_key(fields, prop) ?? Val.Null;
        } else {
            return default.clone();
        }
    }
    if let Val.Null = cur {
        return default.clone();
    }
    cur
}

fn op_missing(data: ref Val, args: Slice[Val]) -> Val {
    let keys: Vec[Val] = match args.first() {
        Some(Val.List(xs)) => xs.clone(),
        _ => args.to_vec(),
    };
    let mut missing: Vec[Val] = Vec.new();
    for key in keys.iter() {
        let value = op_var(data, key, Val.Null);
        let absent = match value {
            Val.Null => true,
            Val.Str(s) => s.is_empty(),
            _ => false,
        };
        if absent {
            missing.push(key.clone());
        }
    }
    Val.List(missing)
}

// ------------------------------------------------------------ apply

/// Argument `i`, or `None` past the end (the operations' defaults).
fn arg(args: Slice[Val], i: i64) -> Val {
    if i < args.len() { args[i].clone() } else { Val.Null }
}

fn is_null(v: ref Val) -> bool {
    match v {
        Val.Null => true,
        _ => false,
    }
}

const BUILTINS: Array[Str, 25] = [
    "==", "!=", "===", "!==", "<", ">", "<=", ">=", "!", "!!", "+", "*", "-", "/", "%",
    "in", "min", "max", "cat", "log", "var", "substr", "merge", "missing", "missing_some",
];

fn apply(logic: ref Val, data: ref Val) -> Result[Val, String] {
    let fields = match logic {
        Val.List(items) => {
            let mut out: Vec[Val] = Vec.new();
            for item in items.iter() {
                out.push(apply(item, data)?);
            }
            return Ok(Val.List(out));
        }
        Val.Obj(fields) => fields,
        _ => return Ok(logic.clone()),
    };
    if fields.len() != 1 {
        return Ok(logic.clone());
    }
    let (op, raw) = ref fields[0];
    let args: Vec[Val] = match raw {
        Val.List(xs) => xs.clone(),
        _ => [raw.clone()],
    };
    match op.as_str() {
        "if" | "?:" => {
            let argc = args.len();
            let mut index = 0;
            while index < argc - 1 {
                if to_bool(apply(args[index], data)?) {
                    return apply(args[index + 1], data);
                }
                index += 2;
            }
            if index >= argc {
                return Ok(Val.Null);
            }
            return apply(args[index], data);
        }
        "and" | "or" => {
            let mut current = Val.Null;
            for a in args.iter() {
                current = apply(a, data)?;
                if to_bool(current) == (op == "or") {
                    return Ok(current);
                }
            }
            return Ok(current);
        }
        "filter" | "map" => {
            if args.len() < (if op == "filter" { 2 } else { 1 }) {
                return Ok(Val.List(Vec.new()));
            }
            let Val.List(items) = apply(args[0], data)? else {
                return Ok(Val.List(Vec.new()));
            };
            let sublogic = arg(args, 1);
            let mut out: Vec[Val] = Vec.new();
            for item in items.iter() {
                let r = apply(sublogic, item)?;
                if op == "map" {
                    out.push(r);
                } else if to_bool(r) {
                    out.push(item.clone());
                }
            }
            return Ok(Val.List(out));
        }
        "reduce" => {
            if args.is_empty() {
                return Ok(Val.Null);
            }
            let init = arg(args, 2);
            let Val.List(items) = apply(args[0], data)? else {
                return Ok(init);
            };
            let sublogic = arg(args, 1);
            let mut acc = init;
            for item in items.iter() {
                let context = Val.Obj([("accumulator".to_string(), acc), ("current".to_string(), item.clone())]);
                acc = apply(sublogic, context)?;
            }
            return Ok(acc);
        }
        "all" | "some" | "none" => {
            let empty = op == "none";
            if args.len() < 2 {
                return Ok(Val.Bool(empty));
            }
            let Val.List(items) = apply(args[0], data)? else {
                return Ok(Val.Bool(empty));
            };
            if op == "all" {
                if items.is_empty() {
                    return Ok(Val.Bool(false));
                }
                for item in items.iter() {
                    if not to_bool(apply(args[1], item)?) {
                        return Ok(Val.Bool(false));
                    }
                }
                return Ok(Val.Bool(true));
            }
            for item in items.iter() {
                if to_bool(apply(args[1], item)?) {
                    return Ok(Val.Bool(not empty));
                }
            }
            return Ok(Val.Bool(empty));
        }
        _ => {}
    }
    let mut values: Vec[Val] = Vec.new();
    for a in args.iter() {
        values.push(apply(a, data)?);
    }
    builtin(op, data, values)
}

fn builtin(op: Str, data: ref Val, args: Vec[Val]) -> Result[Val, String] {
    let a = arg(args, 0);
    let b = arg(args, 1);
    let c = arg(args, 2);
    match op {
        "==" => Ok(Val.Bool(loose_eq(a, b))),
        "!=" => Ok(Val.Bool(not loose_eq(a, b))),
        "===" => Ok(Val.Bool(py_eq(a, b))),
        "!==" => Ok(Val.Bool(not py_eq(a, b))),
        "<" | ">" | "<=" | ">=" => {
            if is_null(c) {
                return Ok(Val.Bool(compare(op, a, b)));
            }
            Ok(Val.Bool(compare(op, a, b) and compare(op, b, c)))
        }
        "!" => Ok(Val.Bool(not to_bool(a))),
        "!!" => Ok(Val.Bool(to_bool(a))),
        "+" | "*" => {
            let mut value = Val.Int(if op == "+" { 0 } else { 1 });
            for x in args.iter() {
                value = arith(op, value, to_number(x))?;
            }
            Ok(value)
        }
        "-" => {
            if is_null(b) {
                return Ok(negate(to_number(a)));
            }
            arith("-", to_number(a), to_number(b))
        }
        "/" | "%" => arith(op, to_number(a), to_number(b)),
        "in" => match b {
            Val.List(xs) => Ok(Val.Bool(xs.iter().any(|x| py_eq(a, x)))),
            Val.Str(s) => Ok(Val.Bool(s.contains(to_string(a)))),
            _ => Ok(Val.Bool(false)),
        },
        "min" | "max" => {
            if args.is_empty() {
                return Ok(Val.Float(f64.NAN));
            }
            let mut best = to_number(args[0]);
            for x in args[1..].iter() {
                let n = to_number(x);
                let better = if op == "min" { num_lt(n, best) } else { num_lt(best, n) };
                if better {
                    best = n;
                }
            }
            Ok(best)
        }
        "cat" => {
            let mut out = String.new();
            for x in args.iter() {
                out.push_str(to_string(x));
            }
            Ok(Val.Str(out))
        }
        "log" => {
            println(dumps(a));
            Ok(a)
        }
        "var" => {
            if args.len() > 2 {
                return Err(f"TypeError: op_var() takes from 0 to 3 positional arguments but {args.len() + 1} were given");
            }
            Ok(op_var(data, a, b))
        }
        "substr" => Ok(Val.Str(substr(to_string(a), to_number(b), c))),
        "merge" => {
            let mut items: Vec[Val] = Vec.new();
            for x in args.iter() {
                match x {
                    Val.List(xs) => items.extend(xs.iter().cloned()),
                    _ => items.push(x.clone()),
                }
            }
            Ok(Val.List(items))
        }
        "missing" => Ok(op_missing(data, args)),
        "missing_some" => {
            let Val.List(keys) = b else {
                return Ok(Val.List(Vec.new()));
            };
            let need = to_number(a);
            let Val.List(missing) = op_missing(data, [Val.List(keys.clone())]) else {
                return Ok(Val.List(Vec.new()));
            };
            let found = Val.Int(keys.len() - missing.len());
            if num_lt(need, found) or num_eq(need, found) {
                return Ok(Val.List(Vec.new()));
            }
            Ok(Val.List(missing))
        }
        _ => {
            if op.contains(".") {
                let first = op.split(".").next().unwrap();
                if BUILTINS.iter().any(|n| *n == first) {
                    return Err("TypeError: 'function' object is not subscriptable".to_string());
                }
                return Err(f"ReferenceError: Unrecognized operation: {py_repr(first)}");
            }
            Err(f"ReferenceError: Unrecognized operation: {py_repr(op)}")
        }
    }
}

/// `int()` of a number: toward zero.
fn trunc_of(v: ref Val) -> i64 {
    match int_of(v) {
        Some(i) => i,
        None => i64.checked_from(f64_of(v)) ?? 0,
    }
}

/// `op_substr`, in characters.
fn substr(text: Str, index: Val, length: Val) -> String {
    let cs: Vec[char] = text.chars().collect();
    let n = cs.len();
    let start = if f64_of(index).is_nan() {
        0
    } else if num_lt(index, Val.Int(0)) {
        let back = negate(index);
        if num_lt(back, Val.Int(n)) { n - trunc_of(back) } else { 0 }
    } else {
        let i = trunc_of(index);
        if i >= n { n } else { i }
    };
    let end = if is_null(length) {
        n
    } else {
        let len = to_number(length);
        if f64_of(len).is_nan() {
            start
        } else {
            let k = trunc_of(len);
            if k < 0 {
                if n + k < start { start } else { n + k }
            } else {
                start + k
            }
        }
    };
    let end = if end > n { n } else { end };
    let start = if start > end { end } else { start };
    cs[start..end].iter().collect()
}

// ------------------------------------------------------------ main

fn result_text(logic: ref Val, data: ref Val) -> String {
    match apply(logic, data) {
        Ok(v) => dumps(v),
        Err(e) => f"error {e}",
    }
}

fn parse(path: Str) -> Result[Val, String] {
    let text = fs.read_to_string(path).map_err(|e| f"cannot read {path}: {e}")?;
    parse_text(text).map_err(|e| f"{path}: {e}")
}

fn parse_text(text: Str) -> Result[Val, String] {
    let j = Json.parse(text).map_err(|e| f"bad JSON: {e.message}")?;
    Ok(from_json(j))
}

fn run() -> Result[(), String] {
    fs.create_dir_all("data").map_err(|e| f"cannot create data: {e}")?;
    write_data()?;
    let flags = parse("data/flags.json")?;
    let users = parse("data/users.json")?;
    let (Val.Obj(flags), Val.List(users)) = (flags, users) else {
        return Err("flags must be an object and users a list".to_string());
    };
    println("== flags");
    for user in users.iter() {
        let name = match user {
            Val.Obj(fields) => to_string(get_key(fields, "name") ?? Val.Null),
            _ => "?".to_string(),
        };
        println(f"user {name}");
        for (flag, logic) in flags.iter() {
            println(f"  {flag}: {result_text(logic, user)}");
        }
    }
    println("== cases");
    let text = fs.read_to_string("data/cases.jsonl").map_err(|e| f"cannot read data/cases.jsonl: {e}")?;
    for line in text.split("\n") {
        if line.is_empty() {
            continue;
        }
        let Val.List(parts) = parse_text(line)? else {
            return Err(f"bad case: {line}");
        };
        let name = to_string(parts[0]);
        println(f"{name}: {result_text(parts[1], parts[2])}");
    }
    Ok(())
}

fn put_bytes(path: Str, hex: Str) -> Result[(), String] {
    let digits: String = hex.chars().filter(|c| not c.is_whitespace()).collect();
    let bytes = hex_decode(digits).map_err(|e| f"bad data for {path}: {e}")?;
    fs.write_bytes(path, bytes).map_err(|e| f"cannot write {path}: {e}")
}

fn main() {
    if let Err(e) = run() {
        eprintln(e);
    }
}

// ============================================================ data

// The files under data/, in name order.
fn write_data() -> Result[(), String] {
    put_bytes("data/cases.jsonl", file_0())?;
    put_bytes("data/flags.json", file_1())?;
    put_bytes("data/users.json", file_2())?;
    Ok(())
}

