$ schema shop.db name=order_facts keys=id parse_dates=placed :: SELECT id, placed, total_cents / 100.0 AS total, status = 'paid' AS paid, coupon FROM orders LIMIT 3
CREATE TABLE "order_facts" (
"id" INTEGER,
  "placed" TIMESTAMP,
  "total" REAL,
  "paid" INTEGER,
  "coupon" TEXT,
  CONSTRAINT order_facts_pk PRIMARY KEY ("id")
)
$ schema shop.db name=my"table sqltype=n:BIGINT :: SELECT count(*) AS n, NULL AS missing FROM orders
CREATE TABLE "my""table" (
"n" BIGINT,
  "missing" TEXT
)
