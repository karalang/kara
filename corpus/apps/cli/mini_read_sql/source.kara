// mini_read_sql: a Kāra port of pandas 3.0.5's SQL reader and writer
// (BSD-3-Clause, the pandas development team) over its sqlite3
// fallback, with the SQLite 3.45 engine underneath (public domain):
// the file format, the SQL it runs and the answers it gives.
//
// read_sql_query opens a database file read-only, prepares the query
// (tokenizer, parser, name resolution with SQLite's affinity and
// collation rules), binds its parameters and runs it: nested-loop joins
// in FROM order, WHERE, GROUP BY with the aggregates SQLite has (sum
// with its Kahan-Babuska-Neumaier error term), HAVING, window functions,
// DISTINCT, compound selects, ORDER BY and LIMIT, with SQLite's scalar,
// printf and date functions. The rows go through pandas' type inference
// (dtype_backend), dtype, parse_dates and index_col, or come back in
// chunks. get_schema prints the CREATE TABLE pandas would run, and
// to_sql writes a frame into an in-memory copy of the database.
//
// It reads data/jobs.txt, one job per line, runs each in a task of its
// own, and prints, in job order, `$ <job>` and what the oracle prints:
// the frame's shape, dtypes and to_csv, the schema, or to_sql's count
// and the queries that read its table back. An error prints as
// `! <exception>: <message>`.

import std.sync.{TaskGroup};

// ------------------------------------------------------------ bytes and text

fn byte_str(b: ref Vec[u8], from: i64, to: i64) -> String {
    let mut v: Vec[u8] = Vec.new();
    for i in from..to {
        v.push(b[i]);
    }
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn to_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn from_bytes(v: Vec[u8]) -> String {
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn sub_bytes(b: ref Vec[u8], from: i64, to: i64) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for i in from..to {
        v.push(b[i]);
    }
    v
}

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn is_alpha(c: u8) -> bool {
    (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z')
}

fn is_alnum(c: u8) -> bool {
    is_digit(c) or is_alpha(c)
}

fn lower_byte(c: u8) -> u8 {
    if c >= b'A' and c <= b'Z' { c + 32 } else { c }
}

fn upper_byte(c: u8) -> u8 {
    if c >= b'a' and c <= b'z' { c - 32 } else { c }
}

// ASCII case folding, as SQLite's lower(), upper() and NOCASE do it.
fn ascii_lower(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        out.push(lower_byte(b[i]));
    }
    from_bytes(out)
}

fn ascii_upper(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        out.push(upper_byte(b[i]));
    }
    from_bytes(out)
}

// sqlite3StrICmp: equal ignoring ASCII case.
fn ieq(a: Str, b: Str) -> bool {
    let x = to_bytes(a);
    let y = to_bytes(b);
    if x.len() != y.len() {
        return false;
    }
    for i in 0..x.len() {
        if lower_byte(x[i]) != lower_byte(y[i]) {
            return false;
        }
    }
    true
}

fn split_on(s: Str, sep: u8) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut st: i64 = 0;
    for i in 0..b.len() {
        if b[i] == sep {
            out.push(byte_str(b, st, i));
            st = i + 1;
        }
    }
    out.push(byte_str(b, st, b.len()));
    out
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

fn lines_of(text: Str) -> Vec[String] {
    let mut v = split_on(text, b'\n');
    if v.len() > 0 and v[v.len() - 1].len() == 0 {
        v.pop();
    }
    v
}

fn has_byte(s: Str, c: u8) -> bool {
    let b = to_bytes(s);
    for i in 0..b.len() {
        if b[i] == c {
            return true;
        }
    }
    false
}

// Where pat first occurs in b at or after `from`, or -1.
fn find_bytes(b: ref Vec[u8], pat: ref Vec[u8], from: i64) -> i64 {
    if pat.len() == 0 {
        return from;
    }
    let mut i = from;
    while i + pat.len() <= b.len() {
        let mut ok = true;
        for k in 0..pat.len() {
            if b[i + k] != pat[k] {
                ok = false;
                break;
            }
        }
        if ok {
            return i;
        }
        i += 1;
    }
    -1
}

fn replace_all(s: Str, from: Str, to: Str) -> String {
    let b = to_bytes(s);
    let f = to_bytes(from);
    if f.len() == 0 {
        return s.to_string();
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let at = find_bytes(b, f, i);
        if at < 0 {
            for k in i..b.len() {
                out.push(b[k]);
            }
            break;
        }
        for k in i..at {
            out.push(b[k]);
        }
        for c in to.bytes() {
            out.push(c);
        }
        i = at + f.len();
    }
    from_bytes(out)
}

const HEX_LOWER: Str = "0123456789abcdef";
const HEX_UPPER: Str = "0123456789ABCDEF";

// Python's repr of a str.
fn py_repr(s: Str) -> String {
    let b = to_bytes(s);
    let mut has_single = false;
    let mut has_double = false;
    for i in 0..b.len() {
        if b[i] == b'\'' {
            has_single = true;
        }
        if b[i] == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let hex = to_bytes(HEX_LOWER);
    let mut out: Vec[u8] = Vec.new();
    out.push(q);
    for i in 0..b.len() {
        let c = b[i];
        if c == q or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c < 32 or c == 127 {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    from_bytes(out)
}

// Python's repr of a bytes object.
fn bytes_repr(b: ref Vec[u8]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for i in 0..b.len() {
        if b[i] == b'\'' {
            has_single = true;
        }
        if b[i] == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let hex = to_bytes(HEX_LOWER);
    let mut out: Vec[u8] = vec![b'b', q];
    for i in 0..b.len() {
        let c = b[i];
        if c == q or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c < 32 or c >= 127 {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    from_bytes(out)
}

// Python's repr of a float.
fn float_repr(x: f64) -> String {
    if x.is_nan() {
        return "nan".to_string();
    }
    f"{x}"
}

// ------------------------------------------------------------ code points

// The code points of UTF-8 text.
fn code_points(s: Str) -> Vec[i64] {
    let b = to_bytes(s);
    let mut out: Vec[i64] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 and i + 1 < b.len() {
            out.push(((c & 0x1F) << 6) | (b[i + 1] as i64 & 0x3F));
            i += 2;
        } else if c < 0xF0 and i + 2 < b.len() {
            out.push(((c & 0x0F) << 12) | ((b[i + 1] as i64 & 0x3F) << 6) | (b[i + 2] as i64 & 0x3F));
            i += 3;
        } else if i + 3 < b.len() {
            out.push(((c & 0x07) << 18) | ((b[i + 1] as i64 & 0x3F) << 12) | ((b[i + 2] as i64 & 0x3F) << 6) | (b[i + 3] as i64 & 0x3F));
            i += 4;
        } else {
            out.push(0xFFFD);
            i += 1;
        }
    }
    out
}

fn push_code_point(out: mut ref Vec[u8], cp: i64) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push((0xC0 | (cp >> 6)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else if cp < 0x10000 {
        out.push((0xE0 | (cp >> 12)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else {
        out.push((0xF0 | (cp >> 18)) as u8);
        out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    }
}

fn from_code_points(cps: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for c in cps {
        push_code_point(mut out, c);
    }
    from_bytes(out)
}

// Text as UTF-16, little-endian or big-endian.
fn utf16_bytes(s: Str, le: bool) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for cp in code_points(s) {
        let mut units: Vec[i64] = Vec.new();
        if cp >= 0x10000 {
            let v = cp - 0x10000;
            units.push(0xD800 + (v >> 10));
            units.push(0xDC00 + (v & 0x3FF));
        } else {
            units.push(cp);
        }
        for u in units {
            if le {
                out.push((u & 0xFF) as u8);
                out.push((u >> 8) as u8);
            } else {
                out.push((u >> 8) as u8);
                out.push((u & 0xFF) as u8);
            }
        }
    }
    out
}

fn utf16_text(b: ref Vec[u8], le: bool) -> String {
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < b.len() {
        let u = if le { (b[i + 1] as i64) * 256 + b[i] as i64 } else { (b[i] as i64) * 256 + b[i + 1] as i64 };
        i += 2;
        if u >= 0xD800 and u < 0xDC00 and i + 1 < b.len() {
            let lo = if le { (b[i + 1] as i64) * 256 + b[i] as i64 } else { (b[i] as i64) * 256 + b[i + 1] as i64 };
            i += 2;
            push_code_point(mut out, 0x10000 + ((u - 0xD800) << 10) + (lo - 0xDC00));
        } else {
            push_code_point(mut out, u);
        }
    }
    from_bytes(out)
}

// Bytes taken as UTF-8 text, the way SQLite reads a blob as text:
// whatever the bytes are, up to the first zero byte.
fn lossy_text(b: ref Vec[u8]) -> String {
    let mut v: Vec[u8] = Vec.new();
    for c in b {
        if c == 0 {
            break;
        }
        v.push(c);
    }
    String.from_utf8(v).unwrap_or("?".to_string())
}

// ------------------------------------------------------------ dates

fn fdiv(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

fn fmod(a: i64, b: i64) -> i64 {
    a - fdiv(a, b) * b
}

fn days_from_civil(y0: i64, m: i64, d: i64) -> i64 {
    let y = if m <= 2 { y0 - 1 } else { y0 };
    let era = fdiv(y, 400);
    let yoe = y - era * 400;
    let mp = (m + 9) % 12;
    let doy = (153 * mp + 2) / 5 + d - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

fn civil_from_days(z0: i64) -> (i64, i64, i64) {
    let z = z0 + 719468;
    let era = fdiv(z, 146097);
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let y = yoe + era * 400;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = if mp < 10 { mp + 3 } else { mp - 9 };
    (if m <= 2 { y + 1 } else { y }, m, d)
}

fn days_in_month(y: i64, m: i64) -> i64 {
    if m == 2 {
        if (y % 4 == 0 and y % 100 != 0) or y % 400 == 0 { 29 } else { 28 }
    } else if m == 4 or m == 6 or m == 9 or m == 11 {
        30
    } else {
        31
    }
}

// ------------------------------------------------------------ errors

// An exception as Python prints it: `! <kind>: <msg>`.
#[derive(Clone)]
struct PyErr {
    kind: String,
    msg: String,
}

fn py_err(kind: Str, msg: Str) -> PyErr {
    PyErr { kind: kind.to_string(), msg: msg.to_string() }
}
// ------------------------------------------------------------ the file format
// The reader of mini_sqlite: pages, cells, overflow chains and records.

const INDEX_INTERIOR: u8 = 2;
const TABLE_INTERIOR: u8 = 5;
const INDEX_LEAF: u8 = 10;
const TABLE_LEAF: u8 = 13;

fn u16_at(b: ref Vec[u8], i: i64) -> i64 {
    (b[i] as i64) * 256 + b[i + 1] as i64
}

fn u32_at(b: ref Vec[u8], i: i64) -> i64 {
    let mut v: i64 = 0;
    for k in 0..4 {
        v = v * 256 + b[i + k] as i64;
    }
    v
}

// A varint and the number of bytes it took.
fn varint(b: ref Vec[u8], pos: i64) -> (i64, i64) {
    let mut v: i64 = 0;
    for k in 0..8 {
        let c = b[pos + k];
        v = (v << 7) | (c & 0x7F) as i64;
        if c < 0x80 {
            return (v, k + 1);
        }
    }
    v = (v << 8) | b[pos + 8] as i64;
    (v, 9)
}

#[derive(Clone)]
struct Page {
    no: i64,
    flag: u8,
    right: i64,
    cells: Vec[i64],
}

fn is_leaf(page: ref Page) -> bool {
    page.flag == TABLE_LEAF or page.flag == INDEX_LEAF
}

fn read_page(db: ref Db, no: i64) -> Result[Page, String] {
    if no < 1 or no > db.pages {
        return Err("database disk image is malformed".to_string());
    }
    let base = (no - 1) * db.page_size;
    let h = if no == 1 { base + 100 } else { base };
    let b = ref db.file;
    let flag = b[h];
    if flag != INDEX_INTERIOR and flag != TABLE_INTERIOR and flag != INDEX_LEAF and flag != TABLE_LEAF {
        return Err("database disk image is malformed".to_string());
    }
    let leaf = flag == TABLE_LEAF or flag == INDEX_LEAF;
    let n = u16_at(b, h + 3);
    let start = if leaf { h + 8 } else { h + 12 };
    let mut cells: Vec[i64] = Vec.new();
    for k in 0..n {
        cells.push(base + u16_at(b, start + 2 * k));
    }
    Ok(Page { no: no, flag: flag, right: if leaf { 0 } else { u32_at(b, h + 8) }, cells: cells })
}

#[derive(Clone)]
struct Cell {
    left: i64,
    rowid: i64,
    size: i64,
    local: i64,
    start: i64,
    overflow: i64,
}

// How much of a payload of `p` bytes stays on the page.
fn local_size(db: ref Db, p: i64, table: bool) -> i64 {
    let u = db.usable;
    let x = if table { u - 35 } else { (u - 12) * 64 / 255 - 23 };
    if p <= x {
        return p;
    }
    let m = (u - 12) * 32 / 255 - 23;
    let k = m + (p - m) % (u - 4);
    if k <= x { k } else { m }
}

fn read_cell(db: ref Db, page: ref Page, i: i64) -> Cell {
    let b = ref db.file;
    let mut pos = page.cells[i];
    let mut cell = Cell { left: 0, rowid: 0, size: 0, local: 0, start: 0, overflow: 0 };
    if not is_leaf(page) {
        cell.left = u32_at(b, pos);
        pos += 4;
    }
    if page.flag == TABLE_INTERIOR {
        let (r, _) = varint(b, pos);
        cell.rowid = r;
        return cell;
    }
    let (size, n) = varint(b, pos);
    pos += n;
    if page.flag == TABLE_LEAF {
        let (r, m) = varint(b, pos);
        cell.rowid = r;
        pos += m;
    }
    cell.size = size;
    cell.local = local_size(db, size, page.flag == TABLE_LEAF);
    cell.start = pos;
    if cell.local < size {
        cell.overflow = u32_at(b, pos + cell.local);
    }
    cell
}

fn payload(db: ref Db, cell: ref Cell) -> Vec[u8] {
    let b = ref db.file;
    let mut out: Vec[u8] = Vec.new();
    for k in 0..cell.local {
        out.push(b[cell.start + k]);
    }
    let per = db.usable - 4;
    let mut next = cell.overflow;
    while next != 0 {
        let base = (next - 1) * db.page_size;
        let left = cell.size - out.len();
        let n = if left < per { left } else { per };
        for k in 0..n {
            out.push(b[base + 4 + k]);
        }
        next = u32_at(b, base);
    }
    out
}

fn decode_text(enc: i64, b: ref Vec[u8], from: i64, n: i64) -> String {
    if enc == ENC_UTF8 {
        return byte_str(b, from, from + n);
    }
    utf16_text(sub_bytes(b, from, from + n), enc == ENC_UTF16LE)
}

// A big-endian two's-complement integer of n bytes.
fn int_at(b: ref Vec[u8], from: i64, n: i64) -> i64 {
    let mut v: i64 = if b[from] >= 0x80 { -1 } else { 0 };
    for k in 0..n {
        v = (v << 8) | b[from + k] as i64;
    }
    v
}

fn decode_record(enc: i64, b: ref Vec[u8]) -> Vec[V] {
    let (hsize, n0) = varint(b, 0);
    let mut types: Vec[i64] = Vec.new();
    let mut p = n0;
    while p < hsize {
        let (t, n) = varint(b, p);
        types.push(t);
        p += n;
    }
    let mut out: Vec[V] = Vec.new();
    let mut at = hsize;
    for t in types {
        if t == 0 {
            out.push(V.Null);
        } else if t >= 1 and t <= 6 {
            let n = if t == 5 { 6 } else if t == 6 { 8 } else { t };
            out.push(V.Int(int_at(b, at, n)));
            at += n;
        } else if t == 7 {
            out.push(V.Real(int_at(b, at, 8).bits_as_f64()));
            at += 8;
        } else if t == 8 {
            out.push(V.Int(0));
        } else if t == 9 {
            out.push(V.Int(1));
        } else if t >= 12 and t % 2 == 0 {
            let n = (t - 12) / 2;
            out.push(V.Blob(sub_bytes(b, at, at + n)));
            at += n;
        } else {
            let n = (t - 13) / 2;
            out.push(V.Text(decode_text(enc, b, at, n)));
            at += n;
        }
    }
    out
}

// Every row of a table b-tree, in rowid order.
fn table_rows(db: ref Db, no: i64, out: mut ref Vec[(i64, Vec[V])]) -> Result[(), String] {
    let page = read_page(db, no)?;
    for i in 0..page.cells.len() {
        let cell = read_cell(db, page, i);
        if is_leaf(page) {
            out.push((cell.rowid, decode_record(db.enc, payload(db, cell))));
        } else {
            table_rows(db, cell.left, mut out)?;
        }
    }
    if not is_leaf(page) {
        table_rows(db, page.right, mut out)?;
    }
    Ok(())
}

// Every entry of an index b-tree in order: an interior cell's own entry
// comes after its left subtree.
fn index_entries(db: ref Db, no: i64, out: mut ref Vec[Vec[V]]) -> Result[(), String] {
    let page = read_page(db, no)?;
    for i in 0..page.cells.len() {
        let cell = read_cell(db, page, i);
        if not is_leaf(page) {
            index_entries(db, cell.left, mut out)?;
        }
        out.push(decode_record(db.enc, payload(db, cell)));
    }
    if not is_leaf(page) {
        index_entries(db, page.right, mut out)?;
    }
    Ok(())
}

// ------------------------------------------------------------ the schema

#[derive(Clone)]
struct TCol {
    name: String,
    decl: String,
    aff: i64,
    coll: i64,
    notnull: bool,
    dflt_text: String,
    has_dflt: bool,
    dflt: V,
    pk: i64,
    rowid_alias: bool,
}

#[derive(Clone)]
struct Table {
    name: String,
    cols: Vec[TCol],
    rows: Vec[Vec[V]],
    rowids: Vec[i64],
    without_rowid: bool,
    root: i64,
    loaded: bool,
}

// A row of sqlite_schema.
#[derive(Clone)]
struct Obj {
    kind: String,
    name: String,
    tbl: String,
    root: i64,
    sql: V,
}

#[derive(Clone)]
struct Db {
    file: Vec[u8],
    page_size: i64,
    usable: i64,
    pages: i64,
    enc: i64,
    master: Vec[Obj],
    tables: Vec[Table],
    bad: String,
}

fn empty_db() -> Db {
    Db { file: Vec.new(), page_size: 4096, usable: 4096, pages: 0, enc: ENC_UTF8, master: Vec.new(), tables: Vec.new(), bad: String.new() }
}

fn master_table() -> Table {
    let names = vec!["type", "name", "tbl_name", "rootpage", "sql"];
    let decls = vec!["text", "text", "text", "int", "text"];
    let mut cols: Vec[TCol] = Vec.new();
    for k in 0..5 {
        cols.push(TCol {
            name: names[k].to_string(),
            decl: decls[k].to_string(),
            aff: affinity_of(decls[k]),
            coll: COLL_BINARY,
            notnull: false,
            dflt_text: String.new(),
            has_dflt: false,
            dflt: V.Null,
            pk: 0,
            rowid_alias: false,
        });
    }
    Table { name: "sqlite_master".to_string(), cols: cols, rows: Vec.new(), rowids: Vec.new(), without_rowid: false, root: 1, loaded: false }
}

// Opens a database file. An empty file is an empty database; a file that
// is not one opens, and every statement on it then fails.
fn open_database(data: own Vec[u8]) -> Db {
    let mut db = empty_db();
    db.tables.push(master_table());
    if data.len() == 0 {
        return db;
    }
    let magic = to_bytes("SQLite format 3");
    let mut ok = data.len() >= 100;
    if ok {
        for k in 0..magic.len() {
            if data[k] != magic[k] {
                ok = false;
            }
        }
        if data[15] != 0 {
            ok = false;
        }
    }
    if not ok {
        db.bad = "file is not a database".to_string();
        return db;
    }
    let raw = u16_at(data, 16);
    db.page_size = if raw == 1 { 65536 } else { raw };
    db.usable = db.page_size - data[20] as i64;
    let in_header = u32_at(data, 28);
    let valid = u32_at(data, 24) == u32_at(data, 92);
    db.pages = if valid and in_header > 0 { in_header } else { data.len() / db.page_size };
    let enc = u32_at(data, 56);
    db.enc = if enc == 0 { 1 } else { enc };
    db.file = data;
    let mut rows: Vec[(i64, Vec[V])] = Vec.new();
    if let Err(e) = table_rows(db, 1, mut rows) {
        db.bad = e;
        return db;
    }
    for r in rows {
        let (_, v) = r;
        let root = if v.len() > 3 { int_value(v[3]) } else { 0 };
        let sql = if v.len() > 4 { v[4].clone() } else { V.Null };
        db.master.push(Obj { kind: obj_text(v, 0), name: obj_text(v, 1), tbl: obj_text(v, 2), root: root, sql: sql });
    }
    for k in 0..db.master.len() {
        let o = db.master[k].clone();
        if o.kind == "table" {
            if let V.Text(s) = o.sql {
                if let Ok(t) = parse_create_table(s) {
                    let mut t = t;
                    t.root = o.root;
                    db.tables.push(t);
                }
            }
        }
    }
    db
}

fn obj_text(v: ref Vec[V], k: i64) -> String {
    if k < v.len() {
        match v[k] {
            V.Text(s) => s.clone(),
            _ => String.new(),
        }
    } else {
        String.new()
    }
}

// The index of a table by name, ignoring case; sqlite_master is 0.
fn find_table(db: ref Db, name: Str) -> i64 {
    if ieq(name, "sqlite_master") or ieq(name, "sqlite_schema") {
        return 0;
    }
    for k in 1..db.tables.len() {
        if ieq(db.tables[k].name, name) {
            return k;
        }
    }
    -1
}

fn find_view(db: ref Db, name: Str) -> Option[String] {
    for o in db.master {
        if o.kind == "view" and ieq(o.name, name) {
            if let V.Text(s) = o.sql {
                return Some(s.clone());
            }
        }
    }
    None
}

// Reads a table's rows from the file the first time a statement uses it.
fn load_table(db: mut ref Db, ti: i64) -> Result[(), String] {
    if db.tables[ti].loaded {
        return Ok(());
    }
    if ti == 0 {
        let mut rows: Vec[Vec[V]] = Vec.new();
        let mut ids: Vec[i64] = Vec.new();
        for k in 0..db.master.len() {
            let o = ref db.master[k];
            rows.push(vec![V.Text(o.kind.clone()), V.Text(o.name.clone()), V.Text(o.tbl.clone()), V.Int(o.root), o.sql.clone()]);
            ids.push(k + 1);
        }
        db.tables[0].rows = rows;
        db.tables[0].rowids = ids;
        db.tables[0].loaded = true;
        return Ok(());
    }
    let t = db.tables[ti].clone();
    let mut rows: Vec[Vec[V]] = Vec.new();
    let mut ids: Vec[i64] = Vec.new();
    if t.root > 0 and db.file.len() > 0 {
        if t.without_rowid {
            let mut recs: Vec[Vec[V]] = Vec.new();
            index_entries(db, t.root, mut recs)?;
            let order = storage_order(t);
            for rec in recs {
                let mut row: Vec[V] = Vec.new();
                for k in 0..t.cols.len() {
                    row.push(V.Null);
                }
                for k in 0..order.len() {
                    let ci = order[k];
                    row[ci] = if k < rec.len() { real_column(rec[k].clone(), t.cols[ci].aff) } else { t.cols[ci].dflt.clone() };
                }
                ids.push(ids.len() + 1);
                rows.push(row);
            }
        } else {
            let mut recs: Vec[(i64, Vec[V])] = Vec.new();
            table_rows(db, t.root, mut recs)?;
            for r in recs {
                let (rowid, rec) = r;
                let mut row: Vec[V] = Vec.new();
                for k in 0..t.cols.len() {
                    let c = ref t.cols[k];
                    row.push(if c.rowid_alias {
                        V.Int(rowid)
                    } else if k < rec.len() {
                        real_column(rec[k].clone(), c.aff)
                    } else {
                        c.dflt.clone()
                    });
                }
                ids.push(rowid);
                rows.push(row);
            }
        }
    }
    db.tables[ti].rows = rows;
    db.tables[ti].rowids = ids;
    db.tables[ti].loaded = true;
    Ok(())
}

// A WITHOUT ROWID table's record: the key columns, then the rest.
fn storage_order(t: ref Table) -> Vec[i64] {
    let mut order: Vec[i64] = Vec.new();
    let mut k: i64 = 1;
    loop {
        let mut found = false;
        for c in 0..t.cols.len() {
            if t.cols[c].pk == k {
                order.push(c);
                found = true;
            }
        }
        if not found {
            break;
        }
        k += 1;
    }
    for c in 0..t.cols.len() {
        if t.cols[c].pk == 0 {
            order.push(c);
        }
    }
    order
}

// ------------------------------------------------------------ CREATE TABLE

fn is_col_constraint(u: Str) -> bool {
    u == "CONSTRAINT" or u == "PRIMARY" or u == "NOT" or u == "NULL" or u == "UNIQUE" or u == "CHECK" or u == "DEFAULT"
        or u == "COLLATE" or u == "REFERENCES" or u == "GENERATED" or u == "AS"
}

// The value of a DEFAULT clause's tokens.
fn default_value(toks: ref Vec[Tok]) -> V {
    if toks.len() == 0 {
        return V.Null;
    }
    let mut neg = false;
    let mut k: i64 = 0;
    if toks[0].kind == TK_OP and (toks[0].text == "-" or toks[0].text == "+") {
        neg = toks[0].text == "-";
        k = 1;
    }
    if k >= toks.len() {
        return V.Null;
    }
    let t = ref toks[k];
    if t.kind == TK_INTEGER {
        let (v, rc) = atoi64(to_bytes(t.text));
        if rc == 0 {
            return V.Int(if neg { -v } else { v });
        }
        let r = atof(to_bytes(t.text)).0;
        return V.Real(if neg { -r } else { r });
    }
    if t.kind == TK_FLOAT {
        let r = atof(to_bytes(t.text)).0;
        return V.Real(if neg { -r } else { r });
    }
    if t.kind == TK_STRING {
        return V.Text(t.val.clone());
    }
    if t.kind == TK_BLOB {
        let hex = to_bytes(t.val);
        let mut b: Vec[u8] = Vec.new();
        let mut i: i64 = 0;
        while i + 1 < hex.len() {
            b.push(hex_digit(hex[i]) * 16 + hex_digit(hex[i + 1]));
            i += 2;
        }
        return V.Blob(b);
    }
    if t.kind == TK_ID and ieq(t.text, "TRUE") {
        return V.Int(1);
    }
    if t.kind == TK_ID and ieq(t.text, "FALSE") {
        return V.Int(0);
    }
    V.Null
}

fn parse_create_table(sql: Str) -> Result[Table, String] {
    let toks = tokenize(sql);
    let sb = to_bytes(sql);
    let mut i: i64 = 0;
    while i < toks.len() and not (toks[i].kind == TK_OP and toks[i].text == "(") {
        i += 1;
    }
    if i >= toks.len() or i < 1 {
        return Err("no column list".to_string());
    }
    let mut t = Table { name: toks[i - 1].val.clone(), cols: Vec.new(), rows: Vec.new(), rowids: Vec.new(), without_rowid: false, root: 0, loaded: false };
    // the definitions between the outer parentheses
    let mut defs: Vec[Vec[Tok]] = Vec.new();
    let mut cur_def: Vec[Tok] = Vec.new();
    let mut depth: i64 = 0;
    i += 1;
    while i < toks.len() {
        let tk = toks[i].clone();
        if tk.kind == TK_OP and tk.text == "(" {
            depth += 1;
        } else if tk.kind == TK_OP and tk.text == ")" {
            if depth == 0 {
                break;
            }
            depth -= 1;
        } else if tk.kind == TK_OP and tk.text == "," and depth == 0 {
            defs.push(cur_def);
            cur_def = Vec.new();
            i += 1;
            continue;
        }
        cur_def.push(tk);
        i += 1;
    }
    defs.push(cur_def);
    for k in i..toks.len() {
        if toks[k].kind == TK_ID and ieq(toks[k].text, "ROWID") {
            t.without_rowid = true;
        }
    }
    let mut table_pk: Vec[String] = Vec.new();
    for d in defs {
        if d.len() == 0 {
            continue;
        }
        let head = ascii_upper(d[0].text);
        if not d[0].quoted and (head == "CONSTRAINT" or head == "PRIMARY" or head == "UNIQUE" or head == "CHECK" or head == "FOREIGN") {
            let mut k: i64 = 0;
            while k < d.len() and not (d[k].kind == TK_ID and ieq(d[k].text, "PRIMARY")) {
                k += 1;
            }
            if k < d.len() {
                while k < d.len() and d[k].text != "(" {
                    k += 1;
                }
                k += 1;
                while k < d.len() and d[k].text != ")" {
                    if d[k].kind == TK_ID and not is_sort_word(d[k].text) {
                        table_pk.push(d[k].val.clone());
                    }
                    k += 1;
                }
            }
            continue;
        }
        let mut col = TCol {
            name: d[0].val.clone(),
            decl: String.new(),
            aff: AFF_BLOB,
            coll: COLL_BINARY,
            notnull: false,
            dflt_text: String.new(),
            has_dflt: false,
            dflt: V.Null,
            pk: 0,
            rowid_alias: false,
        };
        let mut k: i64 = 1;
        let type_from = k;
        let mut tdepth: i64 = 0;
        while k < d.len() {
            if tdepth == 0 and d[k].kind == TK_ID and not d[k].quoted and is_col_constraint(ascii_upper(d[k].text)) {
                break;
            }
            if d[k].text == "(" {
                tdepth += 1;
            } else if d[k].text == ")" {
                tdepth -= 1;
            }
            k += 1;
        }
        if k > type_from {
            col.decl = byte_str(sb, d[type_from].from, d[k - 1].to);
        }
        col.aff = affinity_of(col.decl);
        while k < d.len() {
            let u = ascii_upper(d[k].text);
            if u == "PRIMARY" {
                col.pk = 1;
                k += 1;
            } else if u == "NOT" and k + 1 < d.len() and ieq(d[k + 1].text, "NULL") {
                col.notnull = true;
                k += 2;
            } else if u == "COLLATE" and k + 1 < d.len() {
                col.coll = coll_of_name(d[k + 1].val);
                k += 2;
            } else if u == "DEFAULT" and k + 1 < d.len() {
                let st = k + 1;
                let mut en = st + 1;
                if d[st].text == "(" {
                    let mut dd: i64 = 0;
                    en = st;
                    while en < d.len() {
                        if d[en].text == "(" {
                            dd += 1;
                        } else if d[en].text == ")" {
                            dd -= 1;
                            if dd == 0 {
                                en += 1;
                                break;
                            }
                        }
                        en += 1;
                    }
                } else if (d[st].text == "-" or d[st].text == "+") and st + 1 < d.len() {
                    en = st + 2;
                }
                col.has_dflt = true;
                col.dflt_text = byte_str(sb, d[st].from, d[en - 1].to);
                let mut vt: Vec[Tok] = Vec.new();
                for z in st..en {
                    if d[z].text != "(" and d[z].text != ")" {
                        vt.push(d[z].clone());
                    }
                }
                col.dflt = default_value(vt);
                k = en;
            } else if u == "REFERENCES" or u == "CHECK" {
                k += 1;
                if k < d.len() and u == "REFERENCES" {
                    k += 1;
                }
                if k < d.len() and d[k].text == "(" {
                    let mut dd: i64 = 0;
                    while k < d.len() {
                        if d[k].text == "(" {
                            dd += 1;
                        } else if d[k].text == ")" {
                            dd -= 1;
                            if dd == 0 {
                                k += 1;
                                break;
                            }
                        }
                        k += 1;
                    }
                }
            } else {
                k += 1;
            }
        }
        col.dflt = apply_affinity(col.dflt, col.aff);
        t.cols.push(col);
    }
    if table_pk.len() > 0 {
        for n in 0..table_pk.len() {
            for c in 0..t.cols.len() {
                if ieq(t.cols[c].name, table_pk[n]) {
                    t.cols[c].pk = n + 1;
                }
            }
        }
    }
    let mut npk: i64 = 0;
    for c in t.cols {
        if c.pk > 0 {
            npk += 1;
        }
    }
    if npk == 1 and not t.without_rowid {
        for c in 0..t.cols.len() {
            if t.cols[c].pk == 1 and ieq(t.cols[c].decl, "INTEGER") {
                t.cols[c].rowid_alias = true;
            }
        }
    }
    Ok(t)
}

fn is_sort_word(s: Str) -> bool {
    ieq(s, "ASC") or ieq(s, "DESC") or ieq(s, "COLLATE")
}
// ------------------------------------------------------------ the x87 long double

// SQLite 3.45 on x86-64 turns a double into decimal digits, and decimal
// text into a double, in 80-bit long double arithmetic: each multiply by
// a power of ten rounds to a 64-bit significand. The digits it prints
// and the doubles it reads depend on that rounding, so the port carries
// a small long double of its own. Big numbers are 16-bit limbs, least
// significant first.

fn bn_trim(a: own Vec[i64]) -> Vec[i64] {
    let mut a = a;
    while a.len() > 0 and a[a.len() - 1] == 0 {
        a.pop();
    }
    a
}

fn bn_of(n: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut x = n;
    while x > 0 {
        out.push(x % 65536);
        x /= 65536;
    }
    out
}

fn bn_bitlen(a: ref Vec[i64]) -> i64 {
    if a.len() == 0 {
        return 0;
    }
    let mut t = a[a.len() - 1];
    let mut b: i64 = 0;
    while t > 0 {
        b += 1;
        t /= 2;
    }
    (a.len() - 1) * 16 + b
}

fn bn_bit(a: ref Vec[i64], i: i64) -> i64 {
    let l = i / 16;
    if l >= a.len() {
        return 0;
    }
    (a[l] >> (i % 16)) & 1
}

// Whether any bit below bit k is set.
fn bn_low_set(a: ref Vec[i64], k: i64) -> bool {
    let full = k / 16;
    for i in 0..full {
        if i < a.len() and a[i] != 0 {
            return true;
        }
    }
    let rest = k % 16;
    if rest > 0 and full < a.len() {
        return (a[full] & ((1 << rest) - 1)) != 0;
    }
    false
}

fn bn_mul(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.filled(a.len() + b.len() + 1, 0);
    for i in 0..a.len() {
        let mut carry: i64 = 0;
        for j in 0..b.len() {
            let t = out[i + j] + a[i] * b[j] + carry;
            out[i + j] = t % 65536;
            carry = t / 65536;
        }
        let mut k = i + b.len();
        while carry > 0 {
            let t = out[k] + carry;
            out[k] = t % 65536;
            carry = t / 65536;
            k += 1;
        }
    }
    bn_trim(out)
}

fn bn_mul_small(a: ref Vec[i64], n: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut carry: i64 = 0;
    for i in 0..a.len() {
        let t = a[i] * n + carry;
        out.push(t % 65536);
        carry = t / 65536;
    }
    while carry > 0 {
        out.push(carry % 65536);
        carry /= 65536;
    }
    bn_trim(out)
}

fn bn_add_small(a: ref Vec[i64], n: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut carry = n;
    for i in 0..a.len() {
        let t = a[i] + carry;
        out.push(t % 65536);
        carry = t / 65536;
    }
    while carry > 0 {
        out.push(carry % 65536);
        carry /= 65536;
    }
    bn_trim(out)
}

fn bn_divmod_small(a: ref Vec[i64], d: i64) -> (Vec[i64], i64) {
    let mut out: Vec[i64] = Vec.filled(a.len(), 0);
    let mut rem: i64 = 0;
    let mut i = a.len() - 1;
    while i >= 0 {
        let cur = rem * 65536 + a[i];
        out[i] = cur / d;
        rem = cur % d;
        i -= 1;
    }
    (bn_trim(out), rem)
}

fn bn_shl(a: ref Vec[i64], s: i64) -> Vec[i64] {
    let bits = s % 16;
    let mut out: Vec[i64] = Vec.filled(s / 16, 0);
    let mut carry: i64 = 0;
    for i in 0..a.len() {
        let t = (a[i] << bits) + carry;
        out.push(t % 65536);
        carry = t / 65536;
    }
    if carry > 0 {
        out.push(carry);
    }
    bn_trim(out)
}

fn bn_shr(a: ref Vec[i64], s: i64) -> Vec[i64] {
    let bits = s % 16;
    let mut out: Vec[i64] = Vec.new();
    for i in s / 16..a.len() {
        let lo = a[i] >> bits;
        let hi = if i + 1 < a.len() { (a[i + 1] << (16 - bits)) % 65536 } else { 0 };
        out.push(lo | hi);
    }
    bn_trim(out)
}

fn bn_cmp(a: ref Vec[i64], b: ref Vec[i64]) -> i64 {
    if a.len() != b.len() {
        return if a.len() < b.len() { -1 } else { 1 };
    }
    let mut i = a.len() - 1;
    while i >= 0 {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 };
        }
        i -= 1;
    }
    0
}

fn bn_decimal(a: ref Vec[i64]) -> String {
    if a.len() == 0 {
        return "0".to_string();
    }
    let mut parts: Vec[i64] = Vec.new();
    let mut x = a.clone();
    while x.len() > 0 {
        let (q, r) = bn_divmod_small(x, 10000);
        parts.push(r);
        x = q;
    }
    let mut out = parts[parts.len() - 1].to_string();
    let mut k = parts.len() - 2;
    while k >= 0 {
        out.push_str(f"{parts[k]:04}");
        k -= 1;
    }
    out
}

// m * 2^e with m holding exactly 64 bits, or m empty for zero.
#[derive(Clone)]
struct Ld {
    m: Vec[i64],
    e: i64,
}

// m * 2^e rounded to 64 bits, ties to even.
fn ld_round(m: own Vec[i64], e: i64) -> Ld {
    let m = bn_trim(m);
    let n = bn_bitlen(m);
    if n == 0 {
        return Ld { m: m, e: 0 };
    }
    if n <= 64 {
        return Ld { m: bn_shl(m, 64 - n), e: e - (64 - n) };
    }
    let s = n - 64;
    let mut q = bn_shr(m, s);
    if bn_bit(m, s - 1) == 1 and (bn_low_set(m, s - 1) or bn_bit(q, 0) == 1) {
        q = bn_add_small(q, 1);
        if bn_bitlen(q) > 64 {
            return Ld { m: bn_shr(q, 1), e: e + s + 1 };
        }
    }
    Ld { m: q, e: e + s }
}

fn ld_mul(a: ref Ld, b: ref Ld) -> Ld {
    if a.m.len() == 0 or b.m.len() == 0 {
        return Ld { m: Vec.new(), e: 0 };
    }
    ld_round(bn_mul(a.m, b.m), a.e + b.e)
}

// Compares two values that are both zero or positive.
fn ld_cmp(a: ref Ld, b: ref Ld) -> i64 {
    let az = a.m.len() == 0;
    let bz = b.m.len() == 0;
    if az or bz {
        return if az and bz { 0 } else if az { -1 } else { 1 };
    }
    if a.e != b.e {
        return if a.e < b.e { -1 } else { 1 };
    }
    bn_cmp(a.m, b.m)
}

// A constant given as its 64-bit significand in four 16-bit pieces,
// high first, and its exponent.
fn ld_k(h3: i64, h2: i64, h1: i64, h0: i64, e: i64) -> Ld {
    Ld { m: vec![h0, h1, h2, h3], e: e }
}

// The long double constants SQLite's conversions use, as the compiler
// rounds them.
struct LdK {
    e100: Ld,
    e10: Ld,
    e1: Ld,
    e119: Ld,
    e29: Ld,
    e19: Ld,
    e17: Ld,
    e7: Ld,
    m1: Ld,
    m10: Ld,
    m100: Ld,
    m97: Ld,
}

fn ld_consts() -> LdK {
    LdK {
        e100: ld_k(0x924d, 0x692c, 0xa61b, 0xe758, 269),
        e10: ld_k(0x9502, 0xf900, 0, 0, -30),
        e1: ld_k(0xa000, 0, 0, 0, -60),
        e119: ld_k(0x9e9f, 0x11c4, 0x014d, 0xda7e, 332),
        e29: ld_k(0xa18f, 0x07d7, 0x36b9, 0x0be5, 33),
        e19: ld_k(0x8ac7, 0x2304, 0x89e8, 0, 0),
        e17: ld_k(0xb1a2, 0xbc2e, 0xc500, 0, -7),
        e7: ld_k(0x9896, 0x8000, 0, 0, -40),
        m1: ld_k(0xcccc, 0xcccc, 0xcccc, 0xcccd, -67),
        m10: ld_k(0xdbe6, 0xfece, 0xbded, 0xd5bf, -97),
        m100: ld_k(0xdff9, 0x7724, 0x7029, 0x7ebd, -396),
        m97: ld_k(0xdab9, 0x9e59, 0x9588, 0x85c5, -386),
    }
}

// A positive finite double, exactly.
fn ld_of_f64(x: f64) -> Ld {
    let bits = x.to_bits();
    let ex = ((bits >> 52) & 0x7FF) as i64;
    let frac = (bits & 0xFFFFFFFFFFFFF) as i64;
    if ex == 0 {
        ld_round(bn_of(frac), -1074)
    } else {
        ld_round(bn_of(frac + 4503599627370496), ex - 1075)
    }
}

// The value rounded to the nearest double, ties to even.
fn ld_to_f64(a: ref Ld) -> f64 {
    if a.m.len() == 0 {
        return 0.0;
    }
    let top = a.e + 63;
    let mut shift: i64 = 11;
    if top < -1022 {
        shift += -1022 - top;
    }
    if shift > 66 {
        return 0.0;
    }
    let mut q = bn_shr(a.m, shift);
    if bn_bit(a.m, shift - 1) == 1 and (bn_low_set(a.m, shift - 1) or bn_bit(q, 0) == 1) {
        q = bn_add_small(q, 1);
    }
    let mut v: i64 = 0;
    let mut k = q.len() - 1;
    while k >= 0 {
        v = v * 65536 + q[k];
        k -= 1;
    }
    if top < -1022 {
        return v.bits_as_f64();
    }
    let mut biased = top + 1023;
    if v >= 9007199254740992 {
        v /= 2;
        biased += 1;
    }
    if biased >= 2047 {
        return f64.INFINITY;
    }
    ((biased << 52) | (v - 4503599627370496)).bits_as_f64()
}

// floor(a), for a positive value.
fn ld_floor(a: ref Ld) -> Vec[i64] {
    if a.e >= 0 { bn_shl(a.m, a.e) } else { bn_shr(a.m, -a.e) }
}

// sqlite3FpDecode: the decimal digits of r, rounded to iRound digits
// (after the point when iRound is negative) and to at most mx digits,
// with trailing zeros removed. idp is where the point goes.
#[derive(Clone)]
struct Fp {
    neg: bool,
    special: i64,
    z: Vec[u8],
    idp: i64,
}

fn fp_decode(r0: f64, i_round0: i64, mx: i64) -> Fp {
    let mut r = r0;
    let mut neg = false;
    if r < 0.0 {
        neg = true;
        r = -r;
    } else if r == 0.0 {
        return Fp { neg: false, special: 0, z: vec![b'0'], idp: 1 };
    }
    if r.is_nan() {
        return Fp { neg: false, special: 2, z: Vec.new(), idp: 0 };
    }
    if r.is_infinite() {
        return Fp { neg: neg, special: 1, z: Vec.new(), idp: 0 };
    }
    let k = ld_consts();
    let mut rr = ld_of_f64(r);
    let mut exp: i64 = 0;
    if ld_cmp(rr, k.e19) >= 0 {
        while ld_cmp(rr, k.e119) >= 0 {
            exp += 100;
            rr = ld_mul(rr, k.m100);
        }
        while ld_cmp(rr, k.e29) >= 0 {
            exp += 10;
            rr = ld_mul(rr, k.m10);
        }
        while ld_cmp(rr, k.e19) >= 0 {
            exp += 1;
            rr = ld_mul(rr, k.m1);
        }
    } else {
        while ld_cmp(rr, k.m97) < 0 {
            exp -= 100;
            rr = ld_mul(rr, k.e100);
        }
        while ld_cmp(rr, k.e7) < 0 {
            exp -= 10;
            rr = ld_mul(rr, k.e10);
        }
        while ld_cmp(rr, k.e17) < 0 {
            exp -= 1;
            rr = ld_mul(rr, k.e1);
        }
    }
    let mut z = to_bytes(bn_decimal(ld_floor(rr)));
    let mut idp = z.len() + exp;
    let mut i_round = i_round0;
    if i_round <= 0 {
        i_round = idp - i_round;
        if i_round == 0 and z[0] >= b'5' {
            i_round = 1;
            z.insert(0, b'0');
            idp += 1;
        }
    }
    if i_round > 0 and (i_round < z.len() or z.len() > mx) {
        if i_round > mx {
            i_round = mx;
        }
        let up = z[i_round] >= b'5';
        z.truncate(i_round);
        if up {
            let mut j = i_round - 1;
            loop {
                z[j] += 1;
                if z[j] <= b'9' {
                    break;
                }
                z[j] = b'0';
                if j == 0 {
                    z.insert(0, b'1');
                    idp += 1;
                    break;
                }
                j -= 1;
            }
        }
    }
    while z.len() > 0 and z[z.len() - 1] == b'0' {
        z.pop();
    }
    Fp { neg: neg, special: 0, z: z, idp: idp }
}

// sqlite3AtoF: the double that text reads as, and how much of it is a
// number: 1 a whole integer, 2 or 3 a whole real (with a point or an
// exponent), -1 a number followed by other text, 0 not a number.
fn atof(b: ref Vec[u8]) -> (f64, i64) {
    let n = b.len();
    let mut i: i64 = 0;
    let mut neg = false;
    let mut s: Vec[i64] = Vec.new();
    let mut d: i64 = 0;
    let mut esign: i64 = 1;
    let mut e: i64 = 0;
    let mut e_valid = true;
    let mut n_digit: i64 = 0;
    let mut e_type: i64 = 1;
    let big = bn_of(1844674407370955160);
    while i < n and is_sql_space(b[i]) {
        i += 1;
    }
    if i >= n {
        return (0.0, 0);
    }
    if b[i] == b'-' {
        neg = true;
        i += 1;
    } else if b[i] == b'+' {
        i += 1;
    }
    while i < n and is_digit(b[i]) {
        s = bn_add_small(bn_mul_small(s, 10), (b[i] - b'0') as i64);
        i += 1;
        n_digit += 1;
        if bn_cmp(s, big) >= 0 {
            while i < n and is_digit(b[i]) {
                i += 1;
                d += 1;
            }
        }
    }
    if i < n and b[i] == b'.' {
        i += 1;
        e_type += 1;
        while i < n and is_digit(b[i]) {
            if bn_cmp(s, big) < 0 {
                s = bn_add_small(bn_mul_small(s, 10), (b[i] - b'0') as i64);
                d -= 1;
                n_digit += 1;
            }
            i += 1;
        }
    }
    if i < n and (b[i] == b'e' or b[i] == b'E') {
        i += 1;
        e_valid = false;
        e_type += 1;
        if i < n {
            if b[i] == b'-' {
                esign = -1;
                i += 1;
            } else if b[i] == b'+' {
                i += 1;
            }
            while i < n and is_digit(b[i]) {
                e = if e < 10000 { e * 10 + (b[i] - b'0') as i64 } else { 10000 };
                i += 1;
                e_valid = true;
            }
        }
    }
    while i < n and is_sql_space(b[i]) {
        i += 1;
    }
    let rc = if i == n and n_digit > 0 and e_valid and e_type > 0 {
        e_type
    } else if e_type >= 2 and (e_type == 3 or e_valid) and n_digit > 0 {
        -1
    } else {
        0
    };
    if s.len() == 0 {
        return (if neg { -0.0 } else { 0.0 }, rc);
    }
    e = e * esign + d;
    let lim = bn_of(1844674407370955156);
    while e > 0 and bn_cmp(s, lim) < 0 {
        s = bn_mul_small(s, 10);
        e -= 1;
    }
    while e < 0 {
        let (q, rem) = bn_divmod_small(s, 10);
        if rem != 0 {
            break;
        }
        s = q;
        e += 1;
    }
    let k = ld_consts();
    let mut r = ld_round(s, 0);
    if e > 0 {
        while e >= 100 {
            e -= 100;
            r = ld_mul(r, k.e100);
        }
        while e >= 10 {
            e -= 10;
            r = ld_mul(r, k.e10);
        }
        while e >= 1 {
            e -= 1;
            r = ld_mul(r, k.e1);
        }
    } else {
        while e <= -100 {
            e += 100;
            r = ld_mul(r, k.m100);
        }
        while e <= -10 {
            e += 10;
            r = ld_mul(r, k.m10);
        }
        while e <= -1 {
            e += 1;
            r = ld_mul(r, k.m1);
        }
    }
    let v = ld_to_f64(r);
    (if neg { -v } else { v }, rc)
}

fn is_sql_space(c: u8) -> bool {
    c == b' ' or c == b'\t' or c == b'\n' or c == 11 or c == 12 or c == b'\r'
}
// ------------------------------------------------------------ values

// A value as SQLite holds it (a Mem with one type).
#[derive(Clone)]
enum V {
    Null,
    Int(i64),
    Real(f64),
    Text(String),
    Blob(Vec[u8]),
}

// Affinities, with SQLite's codes: none sorts below the column ones.
const AFF_NONE: i64 = 64;
const AFF_BLOB: i64 = 65;
const AFF_TEXT: i64 = 66;
const AFF_NUMERIC: i64 = 67;
const AFF_INTEGER: i64 = 68;
const AFF_REAL: i64 = 69;

// Collations; COLL_NONE is "no collation" (sqlite3ExprCollSeq gave 0).
const COLL_NONE: i64 = -1;
const COLL_BINARY: i64 = 0;
const COLL_NOCASE: i64 = 1;
const COLL_RTRIM: i64 = 2;

const ENC_UTF8: i64 = 1;
const ENC_UTF16LE: i64 = 2;
const ENC_UTF16BE: i64 = 3;

const I64_MAX: i64 = 9223372036854775807;
const I64_MIN: i64 = -9223372036854775807 - 1;

fn type_name(v: ref V) -> String {
    match v {
        V.Null => "null".to_string(),
        V.Int(_) => "integer".to_string(),
        V.Real(_) => "real".to_string(),
        V.Text(_) => "text".to_string(),
        V.Blob(_) => "blob".to_string(),
    }
}

fn is_null(v: ref V) -> bool {
    match v {
        V.Null => true,
        _ => false,
    }
}

fn is_numeric_aff(a: i64) -> bool {
    a >= AFF_NUMERIC
}

// The affinity of a declared column type (section 3.1 of datatype3).
fn affinity_of(decl: Str) -> i64 {
    let t = to_bytes(ascii_upper(decl));
    if find_bytes(t, to_bytes("INT"), 0) >= 0 {
        AFF_INTEGER
    } else if find_bytes(t, to_bytes("CHAR"), 0) >= 0 or find_bytes(t, to_bytes("CLOB"), 0) >= 0 or find_bytes(t, to_bytes("TEXT"), 0) >= 0 {
        AFF_TEXT
    } else if find_bytes(t, to_bytes("BLOB"), 0) >= 0 or t.len() == 0 {
        AFF_BLOB
    } else if find_bytes(t, to_bytes("REAL"), 0) >= 0 or find_bytes(t, to_bytes("FLOA"), 0) >= 0 or find_bytes(t, to_bytes("DOUB"), 0) >= 0 {
        AFF_REAL
    } else {
        AFF_NUMERIC
    }
}

fn coll_of_name(name: Str) -> i64 {
    if ieq(name, "NOCASE") {
        COLL_NOCASE
    } else if ieq(name, "RTRIM") {
        COLL_RTRIM
    } else if ieq(name, "BINARY") {
        COLL_BINARY
    } else {
        -2
    }
}

// ------------------------------------------------------------ number text

// sqlite3Atoi64: the integer a text starts with, and 0 when that was all
// of it, 1 with other text after it, -1 with no digits, 2 when it
// overflows, 3 for exactly 9223372036854775808.
fn atoi64(b: ref Vec[u8]) -> (i64, i64) {
    let n = b.len();
    let mut i: i64 = 0;
    while i < n and is_sql_space(b[i]) {
        i += 1;
    }
    let mut neg = false;
    if i < n {
        if b[i] == b'-' {
            neg = true;
            i += 1;
        } else if b[i] == b'+' {
            i += 1;
        }
    }
    let start = i;
    while i < n and b[i] == b'0' {
        i += 1;
    }
    let digits_from = i;
    let mut u: u64 = 0;
    while i < n and is_digit(b[i]) {
        u = u.wrapping_mul(10).wrapping_add((b[i] - b'0') as u64);
        i += 1;
    }
    let nd = i - digits_from;
    let big: u64 = 9223372036854775807;
    let mut value: i64 = if u > big {
        if neg { I64_MIN } else { I64_MAX }
    } else if neg {
        -(u as i64)
    } else {
        u as i64
    };
    let mut rc: i64 = 0;
    if nd == 0 and start == digits_from {
        rc = -1;
    } else if i < n {
        let mut j = i;
        while j < n {
            if not is_sql_space(b[j]) {
                rc = 1;
                break;
            }
            j += 1;
        }
    }
    if nd < 19 {
        return (value, rc);
    }
    let c: i64 = if nd > 19 { 1 } else { compare_2pow63(b, digits_from) };
    if c < 0 {
        return (value, rc);
    }
    value = if neg { I64_MIN } else { I64_MAX };
    if c > 0 {
        (value, 2)
    } else if neg {
        (value, rc)
    } else {
        (value, 3)
    }
}

fn compare_2pow63(b: ref Vec[u8], at: i64) -> i64 {
    let pow63 = to_bytes("922337203685477580");
    let mut c: i64 = 0;
    for i in 0..18 {
        if c == 0 {
            c = (b[at + i] as i64 - pow63[i] as i64) * 10;
        }
    }
    if c == 0 {
        c = b[at + 18] as i64 - b'8' as i64;
    }
    c
}

fn text_bytes(v: ref V) -> Vec[u8] {
    match v {
        V.Text(s) => to_bytes(s),
        V.Blob(b) => b.clone(),
        _ => Vec.new(),
    }
}

// sqlite3RealToI64 and sqlite3RealSameAsInt.
fn real_to_i64(r: f64) -> i64 {
    if r < -9223372036854774784.0 {
        I64_MIN
    } else if r > 9223372036854774784.0 {
        I64_MAX
    } else {
        r as i64
    }
}

fn real_same_as_int(r: f64, i: i64) -> bool {
    let r2 = i as f64;
    r == 0.0 or (r.to_bits() == r2.to_bits() and i >= -2251799813685248 and i < 2251799813685248)
}

// doubleToInt64, as sqlite3VdbeIntValue uses it.
fn double_to_i64(r: f64) -> i64 {
    if r.is_nan() {
        return 0;
    }
    if r <= -9223372036854775808.0 {
        I64_MIN
    } else if r >= 9223372036854775807.0 {
        I64_MAX
    } else {
        r as i64
    }
}

// sqlite3VdbeIntValue and sqlite3VdbeRealValue.
fn int_value(v: ref V) -> i64 {
    match v {
        V.Int(i) => i,
        V.Real(r) => double_to_i64(r),
        V.Text(_) => atoi64(text_bytes(v)).0,
        V.Blob(_) => atoi64(text_bytes(v)).0,
        V.Null => 0,
    }
}

fn real_value(v: ref V) -> f64 {
    match v {
        V.Int(i) => i as f64,
        V.Real(r) => r,
        V.Text(_) => atof(text_bytes(v)).0,
        V.Blob(_) => atof(text_bytes(v)).0,
        V.Null => 0.0,
    }
}

// sqlite3VdbeBooleanValue of a value that is not NULL.
fn bool_value(v: ref V) -> bool {
    match v {
        V.Int(i) => i != 0,
        _ => real_value(v) != 0.0,
    }
}

// numericType / computeNumericType: the number a value counts as in
// arithmetic.
fn numeric_value(v: ref V) -> V {
    match v {
        V.Int(i) => V.Int(i),
        V.Real(r) => V.Real(r),
        V.Null => V.Int(0),
        _ => {
            let b = text_bytes(v);
            let (r, rc) = atof(b);
            if rc <= 0 {
                let (ix, irc) = atoi64(b);
                if rc == 0 and irc <= 1 {
                    V.Int(ix)
                } else {
                    V.Real(r)
                }
            } else if rc == 1 {
                let (ix, irc) = atoi64(b);
                if irc == 0 { V.Int(ix) } else { V.Real(r) }
            } else {
                V.Real(r)
            }
        }
    }
}

// applyNumericAffinity on a text value: the number it reads as when all
// of it is a number, else the text unchanged.
fn apply_numeric(v: ref V, try_int: bool) -> V {
    let b = match v {
        V.Text(s) => to_bytes(s),
        _ => return v.clone(),
    };
    let (r, rc) = atof(b);
    if rc <= 0 {
        return v.clone();
    }
    if rc == 1 {
        let ix = real_to_i64(r);
        if real_same_as_int(r, ix) {
            return V.Int(ix);
        }
        let (iv, irc) = atoi64(b);
        if irc == 0 {
            return V.Int(iv);
        }
    }
    if try_int {
        return integer_affinity(r);
    }
    V.Real(r)
}

// sqlite3VdbeIntegerAffinity: a real that is exactly an integer becomes
// one.
fn integer_affinity(r: f64) -> V {
    let ix = double_to_i64(r);
    if r == ix as f64 and ix > I64_MIN and ix < I64_MAX {
        V.Int(ix)
    } else {
        V.Real(r)
    }
}

// The text SQLite gives a number: an integer's digits, a real's "%!.15g".
fn num_text(v: ref V) -> String {
    match v {
        V.Int(i) => i.to_string(),
        V.Real(r) => real_text(r),
        V.Text(s) => s.clone(),
        V.Blob(b) => lossy_text(b),
        V.Null => String.new(),
    }
}

fn real_text(r: f64) -> String {
    let mut spec = fmt_spec();
    spec.precision = 15;
    spec.altform2 = true;
    fmt_float(r, b'g', spec)
}

// applyAffinity: what storing a value into a column of this affinity
// makes of it.
fn apply_affinity(v: ref V, aff: i64) -> V {
    if aff >= AFF_NUMERIC {
        match v {
            V.Int(i) => V.Int(i),
            V.Real(r) => if aff <= AFF_REAL { integer_affinity(r) } else { V.Real(r) },
            V.Text(_) => apply_numeric(v, true),
            _ => v.clone(),
        }
    } else if aff == AFF_TEXT {
        match v {
            V.Int(_) => V.Text(num_text(v)),
            V.Real(_) => V.Text(num_text(v)),
            _ => v.clone(),
        }
    } else {
        v.clone()
    }
}

// A REAL column reads back the integers it stored as reals.
fn real_column(v: own V, aff: i64) -> V {
    if aff == AFF_REAL {
        match v {
            V.Int(i) => V.Real(i as f64),
            other => other,
        }
    } else {
        v
    }
}

// sqlite3VdbeMemNumerify, as CAST(... AS NUMERIC) uses it.
fn numerify(v: ref V) -> V {
    match v {
        V.Text(_) => {},
        V.Blob(_) => {},
        _ => return v.clone(),
    }
    let b = text_bytes(v);
    let (r, rc) = atof(b);
    let (ix, irc) = atoi64(b);
    if (rc == 0 or rc == 1) and irc <= 1 {
        return V.Int(ix);
    }
    let ix2 = real_to_i64(r);
    if real_same_as_int(r, ix2) {
        return V.Int(ix2);
    }
    V.Real(r)
}

// The bytes of a text in the database's encoding.
fn enc_bytes(s: Str, enc: i64) -> Vec[u8] {
    if enc == ENC_UTF8 {
        to_bytes(s)
    } else {
        utf16_bytes(s, enc == ENC_UTF16LE)
    }
}

// A blob read as text in the database's encoding.
fn blob_as_text(b: ref Vec[u8], enc: i64) -> String {
    if enc == ENC_UTF8 {
        lossy_text(b)
    } else {
        let mut v = b.clone();
        if v.len() % 2 == 1 {
            v.pop();
        }
        utf16_text(v, enc == ENC_UTF16LE)
    }
}

// sqlite3_value_text: NULL stays None.
fn value_text(v: ref V, enc: i64) -> Option[String] {
    match v {
        V.Null => None,
        V.Blob(b) => Some(blob_as_text(b, enc)),
        _ => Some(num_text(v)),
    }
}

// sqlite3_value_blob: a text's bytes in the database's encoding.
fn value_blob(v: ref V, enc: i64) -> Vec[u8] {
    match v {
        V.Null => Vec.new(),
        V.Blob(b) => b.clone(),
        V.Text(s) => enc_bytes(s, enc),
        _ => to_bytes(num_text(v)),
    }
}

// sqlite3VdbeMemCast.
fn cast_value(v: ref V, aff: i64, enc: i64) -> V {
    match v {
        V.Null => return V.Null,
        _ => {},
    }
    if aff == AFF_BLOB or aff == AFF_NONE {
        match v {
            V.Blob(b) => V.Blob(b.clone()),
            V.Text(s) => V.Blob(enc_bytes(s, enc)),
            _ => V.Blob(to_bytes(num_text(v))),
        }
    } else if aff == AFF_NUMERIC {
        numerify(v)
    } else if aff == AFF_INTEGER {
        V.Int(int_value(v))
    } else if aff == AFF_REAL {
        V.Real(real_value(v))
    } else {
        match v {
            V.Blob(b) => V.Text(blob_as_text(b, enc)),
            _ => V.Text(num_text(v)),
        }
    }
}

// ------------------------------------------------------------ comparing

// sqlite3IntFloatCompare, exactly.
fn int_float_compare(i: i64, r: f64) -> i64 {
    if r.is_nan() {
        return 1;
    }
    if r < -9223372036854775808.0 {
        return 1;
    }
    if r >= 9223372036854775808.0 {
        return -1;
    }
    let y = r as i64;
    if i < y {
        return -1;
    }
    if i > y {
        return 1;
    }
    let f = r - y as f64;
    if f > 0.0 {
        -1
    } else if f < 0.0 {
        1
    } else {
        0
    }
}

fn cmp_bytes(a: ref Vec[u8], b: ref Vec[u8]) -> i64 {
    let n = if a.len() < b.len() { a.len() } else { b.len() };
    for i in 0..n {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 };
        }
    }
    a.len() - b.len()
}

// Two texts under a collation; BINARY compares the database encoding's
// bytes, NOCASE and RTRIM the UTF-8 ones.
fn coll_compare(a: Str, b: Str, coll: i64, enc: i64) -> i64 {
    if coll == COLL_NOCASE {
        let x = to_bytes(a);
        let y = to_bytes(b);
        let n = if x.len() < y.len() { x.len() } else { y.len() };
        for i in 0..n {
            let p = lower_byte(x[i]);
            let q = lower_byte(y[i]);
            if p != q {
                return p as i64 - q as i64;
            }
        }
        return x.len() - y.len();
    }
    if coll == COLL_RTRIM {
        let mut x = to_bytes(a);
        let mut y = to_bytes(b);
        while x.len() > 0 and x[x.len() - 1] == b' ' {
            x.pop();
        }
        while y.len() > 0 and y[y.len() - 1] == b' ' {
            y.pop();
        }
        return cmp_bytes(x, y);
    }
    if enc == ENC_UTF8 {
        cmp_bytes(to_bytes(a), to_bytes(b))
    } else {
        cmp_bytes(enc_bytes(a, enc), enc_bytes(b, enc))
    }
}

fn class_rank(v: ref V) -> i64 {
    match v {
        V.Null => 0,
        V.Int(_) => 1,
        V.Real(_) => 1,
        V.Text(_) => 2,
        V.Blob(_) => 3,
    }
}

// sqlite3MemCompare: NULL < numbers < text < blobs.
fn mem_compare(a: ref V, b: ref V, coll: i64, enc: i64) -> i64 {
    let ra = class_rank(a);
    let rb = class_rank(b);
    if ra != rb {
        return if ra < rb { -1 } else { 1 };
    }
    match a {
        V.Null => 0,
        V.Int(x) => match b {
            V.Int(y) => if x < y { -1 } else if x > y { 1 } else { 0 },
            V.Real(y) => int_float_compare(x, y),
            _ => 0,
        },
        V.Real(x) => match b {
            V.Real(y) => if x < y { -1 } else if x > y { 1 } else { 0 },
            V.Int(y) => -int_float_compare(y, x),
            _ => 0,
        },
        V.Text(x) => match b {
            V.Text(y) => coll_compare(x, y, if coll == COLL_NONE { COLL_BINARY } else { coll }, enc),
            _ => 0,
        },
        V.Blob(x) => match b {
            V.Blob(y) => cmp_bytes(x, y),
            _ => 0,
        },
    }
}

// The operands of a comparison after OP_Eq's affinity conversions.
fn compare_prep(a: ref V, b: ref V, aff: i64) -> (V, V) {
    if aff >= AFF_NUMERIC {
        (apply_numeric(a, false), apply_numeric(b, false))
    } else if aff == AFF_TEXT {
        let x = match a {
            V.Int(_) => V.Text(num_text(a)),
            V.Real(_) => V.Text(num_text(a)),
            _ => a.clone(),
        };
        let y = match b {
            V.Int(_) => V.Text(num_text(b)),
            V.Real(_) => V.Text(num_text(b)),
            _ => b.clone(),
        };
        let any_text = match a {
            V.Text(_) => true,
            _ => match b {
                V.Text(_) => true,
                _ => false,
            },
        };
        if any_text { (x, y) } else { (a.clone(), b.clone()) }
    } else {
        (a.clone(), b.clone())
    }
}

// A comparison: None when either side is NULL.
fn compare_aff(a: ref V, b: ref V, aff: i64, coll: i64, enc: i64) -> Option[i64] {
    if is_null(a) or is_null(b) {
        return None;
    }
    let (x, y) = compare_prep(a, b, aff);
    Some(mem_compare(x, y, coll, enc))
}

// sqlite3CompareAffinity given both sides' affinities.
fn compare_affinity(aff1: i64, aff2: i64) -> i64 {
    if aff1 > AFF_NONE and aff2 > AFF_NONE {
        if is_numeric_aff(aff1) or is_numeric_aff(aff2) {
            AFF_NUMERIC
        } else {
            AFF_BLOB
        }
    } else if aff1 <= AFF_NONE {
        aff2
    } else {
        aff1
    }
}
// ------------------------------------------------------------ tokens

const TK_EOF: i64 = 0;
const TK_ID: i64 = 1;
const TK_STRING: i64 = 2;
const TK_INTEGER: i64 = 3;
const TK_FLOAT: i64 = 4;
const TK_BLOB: i64 = 5;
const TK_VAR: i64 = 6;
const TK_OP: i64 = 7;
const TK_ILLEGAL: i64 = 8;

// A token: its kind, its text as written (a name or string without its
// quotes in `val`), and where it is in the statement.
#[derive(Clone)]
struct Tok {
    kind: i64,
    text: String,
    val: String,
    quoted: bool,
    from: i64,
    to: i64,
}

fn is_id_char(c: u8) -> bool {
    is_alnum(c) or c == b'_' or c == b'$' or c >= 0x80
}

fn tokenize(sql: Str) -> Vec[Tok] {
    let b = to_bytes(sql);
    let n = b.len();
    let mut out: Vec[Tok] = Vec.new();
    let mut i: i64 = 0;
    while i < n {
        let c = b[i];
        if is_sql_space(c) {
            i += 1;
            continue;
        }
        if c == b'-' and i + 1 < n and b[i + 1] == b'-' {
            while i < n and b[i] != b'\n' {
                i += 1;
            }
            continue;
        }
        if c == b'/' and i + 1 < n and b[i + 1] == b'*' {
            i += 2;
            while i + 1 < n and not (b[i] == b'*' and b[i + 1] == b'/') {
                i += 1;
            }
            i += 2;
            continue;
        }
        let st = i;
        let mut kind = TK_OP;
        let mut val = String.new();
        let mut quoted = false;
        if (c == b'x' or c == b'X') and i + 1 < n and b[i + 1] == b'\'' {
            i += 2;
            let vs = i;
            while i < n and b[i] != b'\'' {
                i += 1;
            }
            val = byte_str(b, vs, i);
            i += 1;
            kind = TK_BLOB;
        } else if c == b'\'' or c == b'"' or c == b'`' or c == b'[' {
            let close = if c == b'[' { b']' } else { c };
            i += 1;
            let mut v: Vec[u8] = Vec.new();
            while i < n {
                if b[i] == close {
                    if close != b']' and i + 1 < n and b[i + 1] == close {
                        v.push(close);
                        i += 2;
                        continue;
                    }
                    break;
                }
                v.push(b[i]);
                i += 1;
            }
            i += 1;
            val = from_bytes(v);
            kind = if c == b'\'' { TK_STRING } else { TK_ID };
            quoted = c != b'\'';
        } else if is_digit(c) or (c == b'.' and i + 1 < n and is_digit(b[i + 1])) {
            kind = TK_INTEGER;
            if c == b'0' and i + 1 < n and (b[i + 1] == b'x' or b[i + 1] == b'X') {
                i += 2;
                while i < n and (is_digit(b[i]) or (lower_byte(b[i]) >= b'a' and lower_byte(b[i]) <= b'f')) {
                    i += 1;
                }
            } else {
                while i < n and is_digit(b[i]) {
                    i += 1;
                }
                if i < n and b[i] == b'.' {
                    kind = TK_FLOAT;
                    i += 1;
                    while i < n and is_digit(b[i]) {
                        i += 1;
                    }
                }
                if i < n and (b[i] == b'e' or b[i] == b'E') and i + 1 < n and (is_digit(b[i + 1]) or ((b[i + 1] == b'+' or b[i + 1] == b'-') and i + 2 < n and is_digit(b[i + 2]))) {
                    kind = TK_FLOAT;
                    i += 2;
                    while i < n and is_digit(b[i]) {
                        i += 1;
                    }
                }
                if i < n and is_id_char(b[i]) {
                    kind = TK_ILLEGAL;
                    while i < n and is_id_char(b[i]) {
                        i += 1;
                    }
                }
            }
        } else if c == b'?' {
            i += 1;
            while i < n and is_digit(b[i]) {
                i += 1;
            }
            kind = TK_VAR;
        } else if c == b':' or c == b'@' or c == b'$' {
            i += 1;
            while i < n and is_id_char(b[i]) {
                i += 1;
            }
            kind = TK_VAR;
        } else if is_id_char(c) {
            while i < n and is_id_char(b[i]) {
                i += 1;
            }
            kind = TK_ID;
        } else {
            let two = if i + 1 < n { byte_str(b, i, i + 2) } else { String.new() };
            if two == "<=" or two == ">=" or two == "<>" or two == "!=" or two == "==" or two == "||" or two == "<<" or two == ">>" {
                i += 2;
            } else {
                i += 1;
            }
        }
        let text = byte_str(b, st, i);
        if kind == TK_ID and not quoted {
            val = text.clone();
        }
        if kind == TK_INTEGER or kind == TK_FLOAT or kind == TK_VAR or kind == TK_OP {
            val = text.clone();
        }
        out.push(Tok { kind: kind, text: text, val: val, quoted: quoted, from: st, to: i });
    }
    out.push(Tok { kind: TK_EOF, text: String.new(), val: String.new(), quoted: false, from: n, to: n });
    out
}

// The words that cannot name a column or a table where this parser
// meets them.
fn is_reserved(u: Str) -> bool {
    u == "SELECT" or u == "FROM" or u == "WHERE" or u == "GROUP" or u == "HAVING" or u == "ORDER" or u == "LIMIT"
        or u == "UNION" or u == "INTERSECT" or u == "EXCEPT" or u == "ON" or u == "JOIN" or u == "LEFT" or u == "INNER"
        or u == "CROSS" or u == "NATURAL" or u == "USING" or u == "AND" or u == "OR" or u == "NOT" or u == "IN"
        or u == "IS" or u == "NULL" or u == "BETWEEN" or u == "LIKE" or u == "GLOB" or u == "CASE" or u == "WHEN"
        or u == "THEN" or u == "ELSE" or u == "END" or u == "AS" or u == "COLLATE" or u == "EXISTS" or u == "DISTINCT"
        or u == "ALL" or u == "ESCAPE" or u == "ISNULL" or u == "NOTNULL" or u == "WINDOW" or u == "VALUES"
        or u == "OUTER" or u == "RIGHT" or u == "FULL" or u == "INDEXED" or u == "REGEXP" or u == "MATCH"
        or u == "CAST" or u == "FILTER" or u == "OVER" or u == "WITH" or u == "OFFSET"
}
// ------------------------------------------------------------ the syntax tree

// Expression kinds.
const E_NULL: i64 = 1;
const E_INT: i64 = 2;
const E_REAL: i64 = 3;
const E_TEXT: i64 = 4;
const E_BLOB: i64 = 5;
const E_PARAM: i64 = 6;
const E_COL: i64 = 7;
const E_NEG: i64 = 8;
const E_POS: i64 = 9;
const E_BITNOT: i64 = 10;
const E_NOT: i64 = 11;
const E_BIN: i64 = 12;
const E_ISNULL: i64 = 13;
const E_IN: i64 = 14;
const E_BETWEEN: i64 = 15;
const E_LIKE: i64 = 16;
const E_COLLATE: i64 = 17;
const E_CASE: i64 = 18;
const E_CAST: i64 = 19;
const E_FUNC: i64 = 20;
const E_EXISTS: i64 = 21;
const E_SUBQ: i64 = 22;
const E_ALIAS: i64 = 23;
const E_GLOB: i64 = 24;

// Binary operators.
const B_CONCAT: i64 = 1;
const B_MUL: i64 = 2;
const B_DIV: i64 = 3;
const B_MOD: i64 = 4;
const B_ADD: i64 = 5;
const B_SUB: i64 = 6;
const B_SHL: i64 = 7;
const B_SHR: i64 = 8;
const B_BITAND: i64 = 9;
const B_BITOR: i64 = 10;
const B_LT: i64 = 11;
const B_LE: i64 = 12;
const B_GT: i64 = 13;
const B_GE: i64 = 14;
const B_EQ: i64 = 15;
const B_NE: i64 = 16;
const B_IS: i64 = 17;
const B_ISNOT: i64 = 18;
const B_AND: i64 = 19;
const B_OR: i64 = 20;

// What a function call is, once resolved.
const F_SCALAR: i64 = 0;
const F_AGG: i64 = 1;
const F_WIN: i64 = 2;

#[derive(Clone)]
struct Ex {
    op: i64,
    sub: i64,
    a: i64,
    b: i64,
    c: i64,
    list: Vec[i64],
    sel: i64,
    text: String,
    qual: String,
    num: i64,
    real: f64,
    blob: Vec[u8],
    neg: bool,
    star: bool,
    win: i64,
    filter: i64,
    // filled in by name resolution
    depth: i64,
    idx: i64,
    aff: i64,
    coll: i64,
    slot: i64,
    kind: i64,
    cname: String,
}

fn ex(op: i64) -> Ex {
    Ex {
        op: op,
        sub: 0,
        a: -1,
        b: -1,
        c: -1,
        list: Vec.new(),
        sel: -1,
        text: String.new(),
        qual: String.new(),
        num: 0,
        real: 0.0,
        blob: Vec.new(),
        neg: false,
        star: false,
        win: -1,
        filter: -1,
        depth: 0,
        idx: -1,
        aff: AFF_NONE,
        coll: COLL_NONE,
        slot: -1,
        kind: F_SCALAR,
        cname: String.new(),
    }
}

// An ORDER BY term; col is the result column it names, once resolved.
#[derive(Clone)]
struct OTerm {
    e: i64,
    desc: bool,
    nulls: i64,
    col: i64,
}

const FB_UNB_PREC: i64 = 1;
const FB_PREC: i64 = 2;
const FB_CURRENT: i64 = 3;
const FB_FOLL: i64 = 4;
const FB_UNB_FOLL: i64 = 5;

#[derive(Clone)]
struct Win {
    part: Vec[i64],
    order: Vec[OTerm],
    rows: bool,
    start: i64,
    start_n: i64,
    end: i64,
    end_n: i64,
}

#[derive(Clone)]
struct ResCol {
    e: i64,
    alias: String,
    has_alias: bool,
    star: bool,
    star_qual: String,
    span: String,
}

const J_INNER: i64 = 0;
const J_LEFT: i64 = 1;
const J_CROSS: i64 = 2;

// A column a FROM source offers.
#[derive(Clone)]
struct ColInfo {
    name: String,
    aff: i64,
    coll: i64,
}

#[derive(Clone)]
struct Src {
    name: String,
    alias: String,
    sel: i64,
    join: i64,
    on: i64,
    // resolved: a base table, or a select that is run for it
    table: i64,
    run: i64,
    cols: Vec[ColInfo],
    off: i64,
}

#[derive(Clone)]
struct Core {
    distinct: bool,
    cols: Vec[ResCol],
    srcs: Vec[Src],
    where_e: i64,
    group: Vec[i64],
    having: i64,
    // filled in by name resolution
    aggs: Vec[i64],
    wins: Vec[i64],
    is_agg: bool,
    width: i64,
    names: Vec[String],
    affs: Vec[i64],
    colls: Vec[i64],
    order: Vec[OTerm],
}

const OP_UNION: i64 = 1;
const OP_UNION_ALL: i64 = 2;
const OP_INTERSECT: i64 = 3;
const OP_EXCEPT: i64 = 4;

#[derive(Clone)]
struct Cte {
    name: String,
    sel: i64,
}

#[derive(Clone)]
struct Sel {
    ctes: Vec[Cte],
    cores: Vec[i64],
    ops: Vec[i64],
    order: Vec[OTerm],
    limit: i64,
    offset: i64,
    prepared: bool,
}

// A parsed statement: its nodes, cores, selects and windows.
#[derive(Clone)]
struct Q {
    exprs: Vec[Ex],
    cores: Vec[Core],
    sels: Vec[Sel],
    wins: Vec[Win],
    nparams: i64,
    param_names: Vec[String],
}

fn new_q() -> Q {
    Q { exprs: Vec.new(), cores: Vec.new(), sels: Vec.new(), wins: Vec.new(), nparams: 0, param_names: Vec.new() }
}

// ------------------------------------------------------------ the parser

struct P {
    toks: Vec[Tok],
    pos: i64,
    sql: String,
}

fn new_parser(sql: Str) -> P {
    P { toks: tokenize(sql), pos: 0, sql: sql.to_string() }
}

fn cur(p: ref P) -> Tok {
    p.toks[p.pos].clone()
}

fn kind_at(p: ref P, k: i64) -> i64 {
    let i = if p.pos + k < p.toks.len() { p.pos + k } else { p.toks.len() - 1 };
    p.toks[i].kind
}

fn is_kw(p: ref P, w: Str) -> bool {
    let t = ref p.toks[p.pos];
    t.kind == TK_ID and not t.quoted and ieq(t.text, w)
}

fn is_kw_at(p: ref P, k: i64, w: Str) -> bool {
    let i = if p.pos + k < p.toks.len() { p.pos + k } else { p.toks.len() - 1 };
    let t = ref p.toks[i];
    t.kind == TK_ID and not t.quoted and ieq(t.text, w)
}

fn is_op(p: ref P, o: Str) -> bool {
    let t = ref p.toks[p.pos];
    t.kind == TK_OP and t.text == o
}

fn advance(p: mut ref P) {
    if p.pos < p.toks.len() - 1 {
        p.pos += 1;
    }
}

fn syntax_error(p: ref P) -> String {
    let t = ref p.toks[p.pos];
    if t.kind == TK_EOF {
        "incomplete input".to_string()
    } else if t.kind == TK_ILLEGAL {
        f"unrecognized token: \"{t.text}\""
    } else {
        f"near \"{t.text}\": syntax error"
    }
}

fn eat_kw(p: mut ref P, w: Str) -> bool {
    if is_kw(p, w) {
        advance(mut p);
        true
    } else {
        false
    }
}

fn eat_op(p: mut ref P, o: Str) -> bool {
    if is_op(p, o) {
        advance(mut p);
        true
    } else {
        false
    }
}

fn expect_kw(p: mut ref P, w: Str) -> Result[(), String] {
    if eat_kw(mut p, w) { Ok(()) } else { Err(syntax_error(p)) }
}

fn expect_op(p: mut ref P, o: Str) -> Result[(), String] {
    if eat_op(mut p, o) { Ok(()) } else { Err(syntax_error(p)) }
}

// A name: an identifier (not a reserved word unless quoted) or a string.
fn is_name(p: ref P) -> bool {
    let t = ref p.toks[p.pos];
    (t.kind == TK_ID and (t.quoted or not is_reserved(ascii_upper(t.text)))) or t.kind == TK_STRING
}

fn take_name(p: mut ref P) -> Result[String, String] {
    if not is_name(p) {
        return Err(syntax_error(p));
    }
    let v = p.toks[p.pos].val.clone();
    advance(mut p);
    Ok(v)
}

fn add(q: mut ref Q, e: own Ex) -> i64 {
    q.exprs.push(e);
    q.exprs.len() - 1
}

fn span_text(p: ref P, from_tok: i64) -> String {
    let st = p.toks[from_tok].from;
    let en = if p.pos > from_tok { p.toks[p.pos - 1].to } else { st };
    byte_str(to_bytes(p.sql), st, en)
}

// ------------------------------------------------------------ statements

const S_SELECT: i64 = 1;
const S_PRAGMA: i64 = 2;

struct Stmt {
    kind: i64,
    sel: i64,
    name: String,
    arg: String,
}

fn parse_statement(sql: Str, q: mut ref Q) -> Result[Stmt, String] {
    let mut p = new_parser(sql);
    let mut st = Stmt { kind: S_SELECT, sel: -1, name: String.new(), arg: String.new() };
    if is_kw(p, "SELECT") or is_kw(p, "WITH") or is_kw(p, "VALUES") {
        st.sel = parse_select(mut p, mut q)?;
    } else if is_kw(p, "PRAGMA") {
        advance(mut p);
        st.kind = S_PRAGMA;
        st.name = take_name(mut p)?;
        if eat_op(mut p, "(") {
            st.arg = take_name(mut p)?;
            expect_op(mut p, ")")?;
        } else if eat_op(mut p, "=") {
            st.arg = take_name(mut p)?;
        }
    } else {
        return Err(syntax_error(p));
    }
    eat_op(mut p, ";");
    if kind_at(p, 0) != TK_EOF {
        return Err(syntax_error(p));
    }
    Ok(st)
}

fn parse_select(p: mut ref P, q: mut ref Q) -> Result[i64, String] {
    let mut s = Sel { ctes: Vec.new(), cores: Vec.new(), ops: Vec.new(), order: Vec.new(), limit: -1, offset: -1, prepared: false };
    if eat_kw(mut p, "WITH") {
        eat_kw(mut p, "RECURSIVE");
        loop {
            let name = take_name(mut p)?;
            expect_kw(mut p, "AS")?;
            if eat_kw(mut p, "NOT") {
                expect_kw(mut p, "MATERIALIZED")?;
            } else {
                eat_kw(mut p, "MATERIALIZED");
            }
            expect_op(mut p, "(")?;
            let sub = parse_select(mut p, mut q)?;
            expect_op(mut p, ")")?;
            s.ctes.push(Cte { name: name, sel: sub });
            if not eat_op(mut p, ",") {
                break;
            }
        }
    }
    s.cores.push(parse_core(mut p, mut q)?);
    loop {
        let op = if is_kw(p, "UNION") {
            advance(mut p);
            if eat_kw(mut p, "ALL") { OP_UNION_ALL } else { OP_UNION }
        } else if eat_kw(mut p, "INTERSECT") {
            OP_INTERSECT
        } else if eat_kw(mut p, "EXCEPT") {
            OP_EXCEPT
        } else {
            break;
        };
        s.ops.push(op);
        s.cores.push(parse_core(mut p, mut q)?);
    }
    if eat_kw(mut p, "ORDER") {
        expect_kw(mut p, "BY")?;
        s.order = parse_order_terms(mut p, mut q)?;
    }
    if eat_kw(mut p, "LIMIT") {
        let a = parse_expr(mut p, mut q)?;
        if eat_kw(mut p, "OFFSET") {
            s.limit = a;
            s.offset = parse_expr(mut p, mut q)?;
        } else if eat_op(mut p, ",") {
            s.offset = a;
            s.limit = parse_expr(mut p, mut q)?;
        } else {
            s.limit = a;
        }
    }
    q.sels.push(s);
    Ok(q.sels.len() - 1)
}

fn parse_order_terms(p: mut ref P, q: mut ref Q) -> Result[Vec[OTerm], String] {
    let mut out: Vec[OTerm] = Vec.new();
    loop {
        let e = parse_expr(mut p, mut q)?;
        let mut t = OTerm { e: e, desc: false, nulls: 0, col: -1 };
        if eat_kw(mut p, "DESC") {
            t.desc = true;
        } else {
            eat_kw(mut p, "ASC");
        }
        if eat_kw(mut p, "NULLS") {
            if eat_kw(mut p, "FIRST") {
                t.nulls = 1;
            } else {
                expect_kw(mut p, "LAST")?;
                t.nulls = 2;
            }
        }
        out.push(t);
        if not eat_op(mut p, ",") {
            break;
        }
    }
    Ok(out)
}

fn parse_core(p: mut ref P, q: mut ref Q) -> Result[i64, String] {
    let mut c = Core {
        distinct: false,
        cols: Vec.new(),
        srcs: Vec.new(),
        where_e: -1,
        group: Vec.new(),
        having: -1,
        aggs: Vec.new(),
        wins: Vec.new(),
        is_agg: false,
        width: 0,
        names: Vec.new(),
        affs: Vec.new(),
        colls: Vec.new(),
        order: Vec.new(),
    };
    expect_kw(mut p, "SELECT")?;
    if eat_kw(mut p, "DISTINCT") {
        c.distinct = true;
    } else {
        eat_kw(mut p, "ALL");
    }
    loop {
        let st = p.pos;
        if eat_op(mut p, "*") {
            c.cols.push(ResCol { e: -1, alias: String.new(), has_alias: false, star: true, star_qual: String.new(), span: "*".to_string() });
        } else if kind_at(p, 0) == TK_ID and p.toks[p.pos + 1].kind == TK_OP and p.toks[p.pos + 1].text == "." and p.toks[p.pos + 2].kind == TK_OP and p.toks[p.pos + 2].text == "*" {
            let qual = p.toks[p.pos].val.clone();
            advance(mut p);
            advance(mut p);
            advance(mut p);
            c.cols.push(ResCol { e: -1, alias: String.new(), has_alias: false, star: true, star_qual: qual, span: String.new() });
        } else {
            let e = parse_expr(mut p, mut q)?;
            let span = span_text(p, st);
            let mut rc = ResCol { e: e, alias: String.new(), has_alias: false, star: false, star_qual: String.new(), span: span };
            if eat_kw(mut p, "AS") {
                let t = cur(p);
                if t.kind == TK_ID or t.kind == TK_STRING {
                    rc.alias = t.val.clone();
                    rc.has_alias = true;
                    advance(mut p);
                } else {
                    return Err(syntax_error(p));
                }
            } else if is_name(p) {
                rc.alias = p.toks[p.pos].val.clone();
                rc.has_alias = true;
                advance(mut p);
            }
            c.cols.push(rc);
        }
        if not eat_op(mut p, ",") {
            break;
        }
    }
    if eat_kw(mut p, "FROM") {
        c.srcs = parse_from(mut p, mut q)?;
    }
    if eat_kw(mut p, "WHERE") {
        c.where_e = parse_expr(mut p, mut q)?;
    }
    if eat_kw(mut p, "GROUP") {
        expect_kw(mut p, "BY")?;
        loop {
            c.group.push(parse_expr(mut p, mut q)?);
            if not eat_op(mut p, ",") {
                break;
            }
        }
    }
    if eat_kw(mut p, "HAVING") {
        c.having = parse_expr(mut p, mut q)?;
    }
    q.cores.push(c);
    Ok(q.cores.len() - 1)
}

fn new_src(name: own String, sel: i64, join: i64) -> Src {
    Src { name: name, alias: String.new(), sel: sel, join: join, on: -1, table: -1, run: -1, cols: Vec.new(), off: 0 }
}

fn parse_from(p: mut ref P, q: mut ref Q) -> Result[Vec[Src], String] {
    let mut out: Vec[Src] = Vec.new();
    let mut join = J_INNER;
    loop {
        let mut s = if eat_op(mut p, "(") {
            let sub = parse_select(mut p, mut q)?;
            expect_op(mut p, ")")?;
            new_src(String.new(), sub, join)
        } else {
            let mut name = take_name(mut p)?;
            if eat_op(mut p, ".") {
                name = take_name(mut p)?;
            }
            new_src(name, -1, join)
        };
        if eat_kw(mut p, "AS") {
            s.alias = take_name(mut p)?;
        } else if is_name(p) and kind_at(p, 0) == TK_ID {
            s.alias = take_name(mut p)?;
        }
        if eat_kw(mut p, "ON") {
            s.on = parse_expr(mut p, mut q)?;
        }
        out.push(s);
        if eat_op(mut p, ",") {
            join = J_CROSS;
            continue;
        }
        eat_kw(mut p, "NATURAL");
        if eat_kw(mut p, "LEFT") {
            eat_kw(mut p, "OUTER");
            expect_kw(mut p, "JOIN")?;
            join = J_LEFT;
        } else if eat_kw(mut p, "INNER") {
            expect_kw(mut p, "JOIN")?;
            join = J_INNER;
        } else if eat_kw(mut p, "CROSS") {
            expect_kw(mut p, "JOIN")?;
            join = J_CROSS;
        } else if eat_kw(mut p, "JOIN") {
            join = J_INNER;
        } else {
            break;
        }
    }
    Ok(out)
}

// ------------------------------------------------------------ expressions

fn parse_expr(p: mut ref P, q: mut ref Q) -> Result[i64, String] {
    parse_or(mut p, mut q)
}

fn bin(q: mut ref Q, op: i64, a: i64, b: i64) -> i64 {
    let mut e = ex(E_BIN);
    e.sub = op;
    e.a = a;
    e.b = b;
    add(mut q, e)
}

fn parse_or(p: mut ref P, q: mut ref Q) -> Result[i64, String] {
    let mut l = parse_and(mut p, mut q)?;
    while eat_kw(mut p, "OR") {
        let r = parse_and(mut p, mut q)?;
        l = bin(mut q, B_OR, l, r);
    }
    Ok(l)
}

fn parse_and(p: mut ref P, q: mut ref Q) -> Result[i64, String] {
    let mut l = parse_not(mut p, mut q)?;
    while eat_kw(mut p, "AND") {
        let r = parse_not(mut p, mut q)?;
        l = bin(mut q, B_AND, l, r);
    }
    Ok(l)
}

fn parse_not(p: mut ref P, q: mut ref Q) -> Result[i64, String] {
    if eat_kw(mut p, "NOT") {
        let x = parse_not(mut p, mut q)?;
        let mut e = ex(E_NOT);
        e.a = x;
        return Ok(add(mut q, e));
    }
    parse_eq(mut p, mut q)
}

fn parse_eq(p: mut ref P, q: mut ref Q) -> Result[i64, String] {
    let mut l = parse_cmp(mut p, mut q)?;
    loop {
        if eat_op(mut p, "=") or eat_op(mut p, "==") {
            let r = parse_cmp(mut p, mut q)?;
            l = bin(mut q, B_EQ, l, r);
        } else if eat_op(mut p, "!=") or eat_op(mut p, "<>") {
            let r = parse_cmp(mut p, mut q)?;
            l = bin(mut q, B_NE, l, r);
        } else if eat_kw(mut p, "IS") {
            let mut op = B_IS;
            if eat_kw(mut p, "NOT") {
                op = B_ISNOT;
            }
            if eat_kw(mut p, "DISTINCT") {
                expect_kw(mut p, "FROM")?;
                op = if op == B_IS { B_ISNOT } else { B_IS };
            }
            let r = parse_cmp(mut p, mut q)?;
            l = bin(mut q, op, l, r);
        } else if eat_kw(mut p, "ISNULL") {
            let mut e = ex(E_ISNULL);
            e.a = l;
            l = add(mut q, e);
        } else if eat_kw(mut p, "NOTNULL") {
            let mut e = ex(E_ISNULL);
            e.a = l;
            e.neg = true;
            l = add(mut q, e);
        } else {
            let save = p.pos;
            let neg = eat_kw(mut p, "NOT");
            if neg and eat_kw(mut p, "NULL") {
                let mut e = ex(E_ISNULL);
                e.a = l;
                e.neg = true;
                l = add(mut q, e);
            } else if eat_kw(mut p, "BETWEEN") {
                let lo = parse_cmp(mut p, mut q)?;
                expect_kw(mut p, "AND")?;
                let hi = parse_cmp(mut p, mut q)?;
                let mut e = ex(E_BETWEEN);
                e.a = l;
                e.b = lo;
                e.c = hi;
                e.neg = neg;
                l = add(mut q, e);
            } else if eat_kw(mut p, "IN") {
                let mut e = ex(E_IN);
                e.a = l;
                e.neg = neg;
                expect_op(mut p, "(")?;
                if is_kw(p, "SELECT") or is_kw(p, "WITH") {
                    e.sel = parse_select(mut p, mut q)?;
                } else if not is_op(p, ")") {
                    loop {
                        e.list.push(parse_expr(mut p, mut q)?);
                        if not eat_op(mut p, ",") {
                            break;
                        }
                    }
                }
                expect_op(mut p, ")")?;
                l = add(mut q, e);
            } else if is_kw(p, "LIKE") or is_kw(p, "GLOB") {
                let op = if is_kw(p, "LIKE") { E_LIKE } else { E_GLOB };
                advance(mut p);
                let r = parse_cmp(mut p, mut q)?;
                let mut e = ex(op);
                e.a = l;
                e.b = r;
                e.neg = neg;
                if op == E_LIKE and eat_kw(mut p, "ESCAPE") {
                    e.c = parse_cmp(mut p, mut q)?;
                }
                l = add(mut q, e);
            } else {
                p.pos = save;
                break;
            }
        }
    }
    Ok(l)
}

fn parse_cmp(p: mut ref P, q: mut ref Q) -> Result[i64, String] {
    let mut l = parse_bits(mut p, mut q)?;
    loop {
        let op = if eat_op(mut p, "<") {
            B_LT
        } else if eat_op(mut p, "<=") {
            B_LE
        } else if eat_op(mut p, ">") {
            B_GT
        } else if eat_op(mut p, ">=") {
            B_GE
        } else {
            break;
        };
        let r = parse_bits(mut p, mut q)?;
        l = bin(mut q, op, l, r);
    }
    Ok(l)
}

fn parse_bits(p: mut ref P, q: mut ref Q) -> Result[i64, String] {
    let mut l = parse_add(mut p, mut q)?;
    loop {
        let op = if eat_op(mut p, "&") {
            B_BITAND
        } else if eat_op(mut p, "|") {
            B_BITOR
        } else if eat_op(mut p, "<<") {
            B_SHL
        } else if eat_op(mut p, ">>") {
            B_SHR
        } else {
            break;
        };
        let r = parse_add(mut p, mut q)?;
        l = bin(mut q, op, l, r);
    }
    Ok(l)
}

fn parse_add(p: mut ref P, q: mut ref Q) -> Result[i64, String] {
    let mut l = parse_mul(mut p, mut q)?;
    loop {
        let op = if eat_op(mut p, "+") {
            B_ADD
        } else if eat_op(mut p, "-") {
            B_SUB
        } else {
            break;
        };
        let r = parse_mul(mut p, mut q)?;
        l = bin(mut q, op, l, r);
    }
    Ok(l)
}

fn parse_mul(p: mut ref P, q: mut ref Q) -> Result[i64, String] {
    let mut l = parse_concat(mut p, mut q)?;
    loop {
        let op = if eat_op(mut p, "*") {
            B_MUL
        } else if eat_op(mut p, "/") {
            B_DIV
        } else if eat_op(mut p, "%") {
            B_MOD
        } else {
            break;
        };
        let r = parse_concat(mut p, mut q)?;
        l = bin(mut q, op, l, r);
    }
    Ok(l)
}

fn parse_concat(p: mut ref P, q: mut ref Q) -> Result[i64, String] {
    let mut l = parse_collate(mut p, mut q)?;
    while eat_op(mut p, "||") {
        let r = parse_collate(mut p, mut q)?;
        l = bin(mut q, B_CONCAT, l, r);
    }
    Ok(l)
}

fn parse_collate(p: mut ref P, q: mut ref Q) -> Result[i64, String] {
    let mut l = parse_unary(mut p, mut q)?;
    while eat_kw(mut p, "COLLATE") {
        let name = take_name(mut p)?;
        let mut e = ex(E_COLLATE);
        e.a = l;
        e.text = name;
        l = add(mut q, e);
    }
    Ok(l)
}

fn parse_unary(p: mut ref P, q: mut ref Q) -> Result[i64, String] {
    let op = if is_op(p, "-") {
        E_NEG
    } else if is_op(p, "+") {
        E_POS
    } else if is_op(p, "~") {
        E_BITNOT
    } else {
        return parse_primary(mut p, mut q);
    };
    advance(mut p);
    let x = parse_unary(mut p, mut q)?;
    let mut e = ex(op);
    e.a = x;
    Ok(add(mut q, e))
}

fn parse_primary(p: mut ref P, q: mut ref Q) -> Result[i64, String] {
    let t = cur(p);
    if t.kind == TK_INTEGER or t.kind == TK_FLOAT {
        advance(mut p);
        let mut e = ex(if t.kind == TK_INTEGER { E_INT } else { E_REAL });
        e.text = t.text.clone();
        return Ok(add(mut q, e));
    }
    if t.kind == TK_STRING {
        advance(mut p);
        let mut e = ex(E_TEXT);
        e.text = t.val.clone();
        return Ok(add(mut q, e));
    }
    if t.kind == TK_BLOB {
        advance(mut p);
        let hex = to_bytes(t.val);
        if hex.len() % 2 == 1 {
            return Err(f"unrecognized token: \"{t.text}\"");
        }
        let mut e = ex(E_BLOB);
        let mut k: i64 = 0;
        while k + 1 < hex.len() {
            e.blob.push(hex_digit(hex[k]) * 16 + hex_digit(hex[k + 1]));
            k += 2;
        }
        return Ok(add(mut q, e));
    }
    if t.kind == TK_VAR {
        advance(mut p);
        let mut e = ex(E_PARAM);
        let b = to_bytes(t.text);
        if b[0] == b'?' {
            if b.len() > 1 {
                e.num = atoi64(sub_bytes(b, 1, b.len())).0;
            } else {
                e.num = q.nparams + 1;
            }
            while q.param_names.len() < e.num {
                q.param_names.push(String.new());
            }
        } else {
            let mut found: i64 = -1;
            for k in 0..q.param_names.len() {
                if q.param_names[k] == t.text {
                    found = k + 1;
                }
            }
            if found < 0 {
                q.param_names.push(t.text.clone());
                found = q.param_names.len();
            }
            e.num = found;
        }
        if e.num > q.nparams {
            q.nparams = e.num;
        }
        e.text = t.text.clone();
        return Ok(add(mut q, e));
    }
    if t.kind == TK_OP and t.text == "(" {
        advance(mut p);
        if is_kw(p, "SELECT") or is_kw(p, "WITH") {
            let s = parse_select(mut p, mut q)?;
            expect_op(mut p, ")")?;
            let mut e = ex(E_SUBQ);
            e.sel = s;
            return Ok(add(mut q, e));
        }
        let x = parse_expr(mut p, mut q)?;
        expect_op(mut p, ")")?;
        return Ok(x);
    }
    if t.kind != TK_ID {
        return Err(syntax_error(p));
    }
    if not t.quoted {
        let u = ascii_upper(t.text);
        if u == "NULL" {
            advance(mut p);
            return Ok(add(mut q, ex(E_NULL)));
        }
        if u == "CAST" {
            advance(mut p);
            expect_op(mut p, "(")?;
            let x = parse_expr(mut p, mut q)?;
            expect_kw(mut p, "AS")?;
            let mut words: Vec[String] = Vec.new();
            while kind_at(p, 0) == TK_ID {
                words.push(cur(p).val.clone());
                advance(mut p);
            }
            if eat_op(mut p, "(") {
                while not is_op(p, ")") and kind_at(p, 0) != TK_EOF {
                    advance(mut p);
                }
                expect_op(mut p, ")")?;
            }
            expect_op(mut p, ")")?;
            let mut e = ex(E_CAST);
            e.a = x;
            e.text = join(words, " ");
            e.aff = affinity_of(e.text);
            return Ok(add(mut q, e));
        }
        if u == "CASE" {
            advance(mut p);
            let mut e = ex(E_CASE);
            if not is_kw(p, "WHEN") {
                e.a = parse_expr(mut p, mut q)?;
            }
            while eat_kw(mut p, "WHEN") {
                e.list.push(parse_expr(mut p, mut q)?);
                expect_kw(mut p, "THEN")?;
                e.list.push(parse_expr(mut p, mut q)?);
            }
            if e.list.len() == 0 {
                return Err(syntax_error(p));
            }
            if eat_kw(mut p, "ELSE") {
                e.c = parse_expr(mut p, mut q)?;
            }
            expect_kw(mut p, "END")?;
            return Ok(add(mut q, e));
        }
        if u == "EXISTS" {
            advance(mut p);
            expect_op(mut p, "(")?;
            let s = parse_select(mut p, mut q)?;
            expect_op(mut p, ")")?;
            let mut e = ex(E_EXISTS);
            e.sel = s;
            return Ok(add(mut q, e));
        }
        if is_reserved(u) {
            return Err(syntax_error(p));
        }
    }
    advance(mut p);
    if is_op(p, "(") and not t.quoted {
        advance(mut p);
        let mut e = ex(E_FUNC);
        e.text = t.val.clone();
        if eat_op(mut p, "*") {
            e.star = true;
        } else if not is_op(p, ")") {
            if eat_kw(mut p, "DISTINCT") {
                e.neg = true;
            } else {
                eat_kw(mut p, "ALL");
            }
            loop {
                e.list.push(parse_expr(mut p, mut q)?);
                if not eat_op(mut p, ",") {
                    break;
                }
            }
        }
        expect_op(mut p, ")")?;
        if is_kw(p, "FILTER") and p.toks[p.pos + 1].text == "(" {
            advance(mut p);
            advance(mut p);
            expect_kw(mut p, "WHERE")?;
            e.filter = parse_expr(mut p, mut q)?;
            expect_op(mut p, ")")?;
        }
        if is_kw(p, "OVER") and p.toks[p.pos + 1].text == "(" {
            advance(mut p);
            e.win = parse_window(mut p, mut q)?;
        }
        return Ok(add(mut q, e));
    }
    let mut e = ex(E_COL);
    if is_op(p, ".") {
        advance(mut p);
        let col = cur(p);
        if col.kind != TK_ID {
            return Err(syntax_error(p));
        }
        advance(mut p);
        e.qual = t.val.clone();
        e.text = col.val.clone();
    } else {
        e.text = t.val.clone();
    }
    Ok(add(mut q, e))
}

fn hex_digit(c: u8) -> u8 {
    if is_digit(c) { c - b'0' } else { lower_byte(c) - b'a' + 10 }
}

fn parse_bound(p: mut ref P, q: mut ref Q) -> Result[(i64, i64), String] {
    if eat_kw(mut p, "UNBOUNDED") {
        if eat_kw(mut p, "PRECEDING") {
            return Ok((FB_UNB_PREC, -1));
        }
        expect_kw(mut p, "FOLLOWING")?;
        return Ok((FB_UNB_FOLL, -1));
    }
    if eat_kw(mut p, "CURRENT") {
        expect_kw(mut p, "ROW")?;
        return Ok((FB_CURRENT, -1));
    }
    let n = parse_expr(mut p, mut q)?;
    if eat_kw(mut p, "PRECEDING") {
        return Ok((FB_PREC, n));
    }
    expect_kw(mut p, "FOLLOWING")?;
    Ok((FB_FOLL, n))
}

fn parse_window(p: mut ref P, q: mut ref Q) -> Result[i64, String] {
    expect_op(mut p, "(")?;
    let mut w = Win { part: Vec.new(), order: Vec.new(), rows: false, start: FB_UNB_PREC, start_n: -1, end: FB_CURRENT, end_n: -1 };
    if eat_kw(mut p, "PARTITION") {
        expect_kw(mut p, "BY")?;
        loop {
            w.part.push(parse_expr(mut p, mut q)?);
            if not eat_op(mut p, ",") {
                break;
            }
        }
    }
    if eat_kw(mut p, "ORDER") {
        expect_kw(mut p, "BY")?;
        w.order = parse_order_terms(mut p, mut q)?;
    }
    if is_kw(p, "ROWS") or is_kw(p, "RANGE") or is_kw(p, "GROUPS") {
        w.rows = is_kw(p, "ROWS");
        advance(mut p);
        if eat_kw(mut p, "BETWEEN") {
            let (a, an) = parse_bound(mut p, mut q)?;
            expect_kw(mut p, "AND")?;
            let (b, bn) = parse_bound(mut p, mut q)?;
            w.start = a;
            w.start_n = an;
            w.end = b;
            w.end_n = bn;
        } else {
            let (a, an) = parse_bound(mut p, mut q)?;
            w.start = a;
            w.start_n = an;
            w.end = FB_CURRENT;
        }
    }
    expect_op(mut p, ")")?;
    q.wins.push(w);
    Ok(q.wins.len() - 1)
}
// ------------------------------------------------------------ name resolution

// What a statement runs against: the database and the bound parameters.
#[derive(Clone)]
struct Env {
    db: Db,
    params: Vec[V],
}

// One SELECT core whose sources names may come from; alias_ok when its
// result aliases are visible too (WHERE, GROUP BY, HAVING, ORDER BY).
#[derive(Clone)]
struct Scope {
    core: i64,
    alias_ok: bool,
}

#[derive(Clone)]
struct RCtx {
    scopes: Vec[Scope],
    ctes: Vec[Cte],
    allow_agg: bool,
    allow_win: bool,
}

fn is_agg_name(n: Str, nargs: i64, star: bool) -> bool {
    if star {
        return n == "count";
    }
    n == "count" or n == "sum" or n == "total" or n == "avg" or n == "group_concat" or n == "string_agg"
        or ((n == "min" or n == "max") and nargs == 1)
}

fn is_win_name(n: Str) -> bool {
    n == "row_number" or n == "rank" or n == "dense_rank" or n == "ntile" or n == "lag" or n == "lead"
        or n == "first_value" or n == "last_value" or n == "percent_rank" or n == "cume_dist" or n == "nth_value"
}

// The argument counts a function takes: (least, most; -1 is any).
fn arity(n: Str) -> (i64, i64) {
    if n == "abs" or n == "upper" or n == "lower" or n == "length" or n == "typeof" or n == "hex" or n == "quote"
        or n == "unicode" or n == "sum" or n == "total" or n == "avg" or n == "ntile" or n == "first_value"
        or n == "last_value" or n == "sign" or n == "zeroblob" or n == "octet_length" {
        (1, 1)
    } else if n == "round" or n == "trim" or n == "ltrim" or n == "rtrim" or n == "group_concat" {
        (1, 2)
    } else if n == "substr" or n == "substring" {
        (2, 3)
    } else if n == "replace" or n == "iif" {
        (3, 3)
    } else if n == "instr" or n == "ifnull" or n == "nullif" or n == "string_agg" or n == "nth_value" {
        (2, 2)
    } else if n == "coalesce" or n == "concat_ws" {
        (2, -1)
    } else if n == "concat" or n == "printf" or n == "format" or n == "strftime" {
        (1, -1)
    } else if n == "min" or n == "max" {
        (1, -1)
    } else if n == "char" or n == "date" or n == "time" or n == "datetime" or n == "julianday" or n == "unixepoch" {
        (0, -1)
    } else if n == "count" {
        (0, 1)
    } else if n == "row_number" or n == "rank" or n == "dense_rank" or n == "percent_rank" or n == "cume_dist" {
        (0, 0)
    } else if n == "lag" or n == "lead" {
        (1, 3)
    } else {
        (-1, -1)
    }
}

// sqlite3ExprAffinity.
fn expr_aff(q: ref Q, e: i64) -> i64 {
    let x = ref q.exprs[e];
    if x.op == E_COL {
        x.aff
    } else if x.op == E_CAST {
        x.aff
    } else if x.op == E_COLLATE or x.op == E_ALIAS {
        expr_aff(q, x.a)
    } else if x.op == E_SUBQ {
        let s = ref q.sels[x.sel];
        let c = ref q.cores[s.cores[0]];
        if c.cols.len() > 0 { expr_aff(q, c.cols[0].e) } else { AFF_NONE }
    } else {
        AFF_NONE
    }
}

// EP_Collate: an explicit COLLATE somewhere in the tree.
fn has_collate(q: ref Q, e: i64) -> bool {
    if e < 0 {
        return false;
    }
    let x = ref q.exprs[e];
    if x.op == E_COLLATE {
        return true;
    }
    if x.op == E_SUBQ or x.op == E_EXISTS {
        return false;
    }
    if has_collate(q, x.a) or has_collate(q, x.b) or has_collate(q, x.c) {
        return true;
    }
    for k in x.list {
        if has_collate(q, k) {
            return true;
        }
    }
    false
}

// sqlite3ExprCollSeq: COLL_NONE when the tree names no collation.
fn expr_coll(q: ref Q, e0: i64) -> i64 {
    let mut e = e0;
    while e >= 0 {
        let x = ref q.exprs[e];
        if x.op == E_COL {
            return x.coll;
        }
        if x.op == E_CAST or x.op == E_POS or x.op == E_ALIAS {
            e = x.a;
            continue;
        }
        if x.op == E_COLLATE {
            return x.coll;
        }
        if has_collate(q, e) {
            if x.a >= 0 and has_collate(q, x.a) {
                e = x.a;
            } else {
                let mut next = x.b;
                for k in x.list {
                    if has_collate(q, k) {
                        next = k;
                        break;
                    }
                }
                e = next;
            }
        } else {
            break;
        }
    }
    COLL_NONE
}

// sqlite3BinaryCompareCollSeq.
fn binary_coll(q: ref Q, l: i64, r: i64) -> i64 {
    if has_collate(q, l) {
        expr_coll(q, l)
    } else if r >= 0 and has_collate(q, r) {
        expr_coll(q, r)
    } else {
        let c = expr_coll(q, l);
        if c == COLL_NONE and r >= 0 { expr_coll(q, r) } else { c }
    }
}

fn nn_coll(c: i64) -> i64 {
    if c == COLL_NONE { COLL_BINARY } else { c }
}

fn contains_agg(q: ref Q, e: i64) -> bool {
    if e < 0 {
        return false;
    }
    let x = ref q.exprs[e];
    if x.op == E_FUNC and x.kind == F_AGG {
        return true;
    }
    if x.op == E_SUBQ or x.op == E_EXISTS {
        return false;
    }
    if contains_agg(q, x.a) or contains_agg(q, x.b) or contains_agg(q, x.c) {
        return true;
    }
    for k in x.list {
        if contains_agg(q, k) {
            return true;
        }
    }
    false
}

fn first_agg_name(q: ref Q, e: i64) -> String {
    if e < 0 {
        return String.new();
    }
    let x = ref q.exprs[e];
    if x.op == E_FUNC and x.kind == F_AGG {
        return x.text.clone();
    }
    for k in vec![x.a, x.b, x.c] {
        let n = first_agg_name(q, k);
        if n.len() > 0 {
            return n;
        }
    }
    for k in x.list {
        let n = first_agg_name(q, k);
        if n.len() > 0 {
            return n;
        }
    }
    String.new()
}

// Looks a column name up, innermost scope first.
fn resolve_col(q: mut ref Q, e: i64, ctx: ref RCtx) -> Result[(), String] {
    let name = q.exprs[e].text.clone();
    let qual = q.exprs[e].qual.clone();
    let full = if qual.len() > 0 { f"{qual}.{name}" } else { name.clone() };
    let n = ctx.scopes.len();
    for d in 0..n {
        let sc = ctx.scopes[n - 1 - d].clone();
        let mut cnt: i64 = 0;
        let mut idx: i64 = -1;
        let mut info = ColInfo { name: String.new(), aff: AFF_NONE, coll: COLL_BINARY };
        for s in q.cores[sc.core].srcs {
            let sname = if s.alias.len() > 0 { s.alias.clone() } else { s.name.clone() };
            if qual.len() > 0 and not ieq(qual, sname) {
                continue;
            }
            for j in 0..s.cols.len() {
                if ieq(s.cols[j].name, name) {
                    cnt += 1;
                    idx = s.off + j;
                    info = s.cols[j].clone();
                    break;
                }
            }
        }
        if cnt > 1 {
            return Err(f"ambiguous column name: {full}");
        }
        if cnt == 1 {
            let x = mut ref q.exprs[e];
            x.depth = d;
            x.idx = idx;
            x.aff = info.aff;
            x.coll = info.coll;
            x.cname = info.name;
            return Ok(());
        }
        if qual.len() == 0 and sc.alias_ok {
            let cols = q.cores[sc.core].cols.clone();
            for rc in cols {
                if rc.has_alias and ieq(rc.alias, name) {
                    if not ctx.allow_agg and contains_agg(q, rc.e) {
                        return Err(f"misuse of aliased aggregate {name}");
                    }
                    let x = mut ref q.exprs[e];
                    x.op = E_ALIAS;
                    x.a = rc.e;
                    return Ok(());
                }
            }
        }
    }
    Err(f"no such column: {full}")
}

fn resolve(env: mut ref Env, q: mut ref Q, e: i64, ctx: ref RCtx) -> Result[(), String] {
    if e < 0 {
        return Ok(());
    }
    let op = q.exprs[e].op;
    if op == E_COL {
        return resolve_col(mut q, e, ctx);
    }
    if op == E_ALIAS {
        return Ok(());
    }
    if op == E_COLLATE {
        let c = coll_of_name(q.exprs[e].text);
        if c == -2 {
            return Err(f"no such collation sequence: {q.exprs[e].text}");
        }
        q.exprs[e].coll = c;
        return resolve(mut env, mut q, q.exprs[e].a, ctx);
    }
    if op == E_SUBQ or op == E_EXISTS or (op == E_IN and q.exprs[e].sel >= 0) {
        if op == E_IN {
            resolve(mut env, mut q, q.exprs[e].a, ctx)?;
        }
        let mut sub = ctx.clone();
        sub.allow_agg = true;
        sub.allow_win = true;
        for k in 0..sub.scopes.len() {
            sub.scopes[k].alias_ok = false;
        }
        let s = q.exprs[e].sel;
        return prepare_select(mut env, mut q, s, sub.scopes, sub.ctes);
    }
    if op == E_FUNC {
        return resolve_func(mut env, mut q, e, ctx);
    }
    let x = q.exprs[e].clone();
    resolve(mut env, mut q, x.a, ctx)?;
    resolve(mut env, mut q, x.b, ctx)?;
    resolve(mut env, mut q, x.c, ctx)?;
    for k in x.list {
        resolve(mut env, mut q, k, ctx)?;
    }
    if op == E_BIN and is_cmp_op(x.sub) {
        q.exprs[e].aff = compare_affinity(expr_aff(q, x.b), expr_aff(q, x.a));
        q.exprs[e].coll = binary_coll(q, x.a, x.b);
    }
    Ok(())
}

fn resolve_func(env: mut ref Env, q: mut ref Q, e: i64, ctx: ref RCtx) -> Result[(), String] {
    let x = q.exprs[e].clone();
    let name = ascii_lower(x.text);
    let nargs = x.list.len();
    let (lo, hi) = arity(name);
    if lo < 0 {
        return Err(f"no such function: {x.text}");
    }
    if nargs < lo or (hi >= 0 and nargs > hi) or (x.star and name != "count") {
        return Err(f"wrong number of arguments to function {x.text}()");
    }
    q.exprs[e].text = name.clone();
    let core = ctx.scopes[ctx.scopes.len() - 1].core;
    let mut inner = ctx.clone();
    if x.win >= 0 {
        if not ctx.allow_win {
            return Err(f"misuse of window function {x.text}()");
        }
        q.exprs[e].kind = F_WIN;
        q.exprs[e].slot = q.cores[core].wins.len();
        q.cores[core].wins.push(e);
        inner.allow_win = false;
        for a in x.list {
            resolve(mut env, mut q, a, inner)?;
        }
        let w = q.wins[x.win].clone();
        for p in w.part {
            resolve(mut env, mut q, p, inner)?;
        }
        for t in w.order {
            resolve(mut env, mut q, t.e, inner)?;
        }
        resolve(mut env, mut q, w.start_n, inner)?;
        resolve(mut env, mut q, w.end_n, inner)?;
        return Ok(());
    }
    if is_win_name(name) {
        return Err(f"misuse of window function {x.text}()");
    }
    if is_agg_name(name, nargs, x.star) {
        if not ctx.allow_agg {
            return Err(f"misuse of aggregate function {x.text}()");
        }
        q.exprs[e].kind = F_AGG;
        q.exprs[e].slot = q.cores[core].aggs.len();
        q.cores[core].aggs.push(e);
        inner.allow_agg = false;
        inner.allow_win = false;
        for a in x.list {
            resolve(mut env, mut q, a, inner)?;
        }
        if x.filter >= 0 {
            resolve(mut env, mut q, x.filter, inner)?;
        }
        if nargs > 0 {
            let mut c = COLL_NONE;
            for a in x.list {
                if c == COLL_NONE {
                    c = expr_coll(q, a);
                }
            }
            q.exprs[e].coll = nn_coll(c);
        }
        return Ok(());
    }
    for a in x.list {
        resolve(mut env, mut q, a, ctx)?;
    }
    let mut c = COLL_NONE;
    for a in x.list {
        if c == COLL_NONE {
            c = expr_coll(q, a);
        }
    }
    q.exprs[e].coll = nn_coll(c);
    Ok(())
}

// ------------------------------------------------------------ selects

fn find_cte(ctes: ref Vec[Cte], name: Str) -> i64 {
    let mut k = ctes.len() - 1;
    while k >= 0 {
        if ieq(ctes[k].name, name) {
            return ctes[k].sel;
        }
        k -= 1;
    }
    -1
}

// The columns a select hands to whatever reads it.
fn select_cols(q: ref Q, s: i64) -> Vec[ColInfo] {
    let c = ref q.cores[q.sels[s].cores[0]];
    let mut out: Vec[ColInfo] = Vec.new();
    for k in 0..c.names.len() {
        out.push(ColInfo { name: c.names[k].clone(), aff: c.affs[k], coll: c.colls[k] });
    }
    out
}

fn view_select_text(sql: Str) -> String {
    let toks = tokenize(sql);
    for k in 0..toks.len() {
        if toks[k].kind == TK_ID and ieq(toks[k].text, "AS") {
            return byte_str(to_bytes(sql), toks[k + 1].from, sql.len());
        }
    }
    String.new()
}

fn prepare_select(env: mut ref Env, q: mut ref Q, s: i64, scopes: Vec[Scope], ctes0: own Vec[Cte]) -> Result[(), String] {
    if q.sels[s].prepared {
        return Ok(());
    }
    q.sels[s].prepared = true;
    let mut ctes = ctes0;
    let own_ctes = q.sels[s].ctes.clone();
    for c in own_ctes {
        prepare_select(mut env, mut q, c.sel, Vec.new(), ctes.clone())?;
        ctes.push(c.clone());
    }
    let cores = q.sels[s].cores.clone();
    let order = q.sels[s].order.clone();
    for k in 0..cores.len() {
        let o = if cores.len() == 1 { order.clone() } else { Vec.new() };
        prepare_core(mut env, mut q, cores[k], scopes.clone(), ctes.clone(), o)?;
    }
    let n0 = q.cores[cores[0]].names.len();
    for k in 1..cores.len() {
        if q.cores[cores[k]].names.len() != n0 {
            let o = q.sels[s].ops[k - 1];
            let what = if o == OP_UNION {
                "UNION"
            } else if o == OP_UNION_ALL {
                "UNION ALL"
            } else if o == OP_INTERSECT {
                "INTERSECT"
            } else {
                "EXCEPT"
            };
            return Err(f"SELECTs to the left and right of {what} do not have the same number of result columns");
        }
    }
    if cores.len() > 1 {
        let mut terms = order.clone();
        for i in 0..terms.len() {
            let x = q.exprs[terms[i].e].clone();
            let mut col: i64 = -1;
            if x.op == E_INT {
                let (v, _) = atoi64(to_bytes(x.text));
                if v >= 1 and v <= n0 {
                    col = v - 1;
                }
            } else if x.op == E_COL and x.qual.len() == 0 {
                for j in 0..n0 {
                    if ieq(q.cores[cores[0]].names[j], x.text) {
                        col = j;
                        break;
                    }
                }
            }
            if col < 0 {
                return Err(f"{ordinal(i + 1)} ORDER BY term does not match any column in the result set");
            }
            terms[i].col = col;
        }
        q.sels[s].order = terms;
    }
    let empty = RCtx { scopes: Vec.new(), ctes: Vec.new(), allow_agg: false, allow_win: false };
    let lim = q.sels[s].limit;
    let off = q.sels[s].offset;
    resolve(mut env, mut q, lim, empty)?;
    resolve(mut env, mut q, off, empty)?;
    Ok(())
}

fn ordinal(n: i64) -> String {
    let suffix = if n % 10 == 1 and n % 100 != 11 {
        "st"
    } else if n % 10 == 2 and n % 100 != 12 {
        "nd"
    } else if n % 10 == 3 and n % 100 != 13 {
        "rd"
    } else {
        "th"
    };
    f"{n}{suffix}"
}

fn col_ref(qual: Str, name: Str) -> Ex {
    let mut e = ex(E_COL);
    e.qual = qual.to_string();
    e.text = name.to_string();
    e
}

fn prepare_core(env: mut ref Env, q: mut ref Q, c: i64, scopes: Vec[Scope], ctes: Vec[Cte], order: own Vec[OTerm]) -> Result[(), String] {
    // the sources and their columns
    let nsrc = q.cores[c].srcs.len();
    let mut width: i64 = 0;
    for k in 0..nsrc {
        let s = q.cores[c].srcs[k].clone();
        let mut cols: Vec[ColInfo] = Vec.new();
        let mut table: i64 = -1;
        let mut run: i64 = -1;
        if s.sel >= 0 {
            prepare_select(mut env, mut q, s.sel, scopes.clone(), ctes.clone())?;
            run = s.sel;
            cols = select_cols(q, s.sel);
        } else {
            let cte = find_cte(ctes, s.name);
            if cte >= 0 {
                run = cte;
                cols = select_cols(q, cte);
            } else {
                if env.db.bad.len() > 0 {
                    return Err(env.db.bad.clone());
                }
                let ti = find_table(env.db, s.name);
                if ti >= 0 {
                    load_table(mut env.db, ti)?;
                    table = ti;
                    for tc in env.db.tables[ti].cols {
                        cols.push(ColInfo { name: tc.name.clone(), aff: tc.aff, coll: tc.coll });
                    }
                } else {
                    match find_view(env.db, s.name) {
                        Some(sql) => {
                            let text = view_select_text(sql);
                            let mut p = new_parser(text);
                            let vs = parse_select(mut p, mut q)?;
                            prepare_select(mut env, mut q, vs, Vec.new(), Vec.new())?;
                            run = vs;
                            cols = select_cols(q, vs);
                        }
                        None => return Err(f"no such table: {s.name}"),
                    }
                }
            }
        }
        let w = cols.len();
        let src = mut ref q.cores[c].srcs[k];
        src.table = table;
        src.run = run;
        src.cols = cols;
        src.off = width;
        width += w;
    }
    q.cores[c].width = width;
    // `*` and `t.*`
    let old = q.cores[c].cols.clone();
    let mut cols: Vec[ResCol] = Vec.new();
    for rc in old {
        if not rc.star {
            cols.push(rc.clone());
            continue;
        }
        if nsrc == 0 {
            return Err("no tables specified".to_string());
        }
        let mut matched = false;
        let srcs = q.cores[c].srcs.clone();
        for s in srcs {
            let sname = if s.alias.len() > 0 { s.alias.clone() } else { s.name.clone() };
            if rc.star_qual.len() > 0 and not ieq(rc.star_qual, sname) {
                continue;
            }
            matched = true;
            for ci in s.cols {
                let e = add(mut q, col_ref(sname, ci.name));
                cols.push(ResCol { e: e, alias: String.new(), has_alias: false, star: false, star_qual: String.new(), span: ci.name.clone() });
            }
        }
        if not matched {
            return Err(f"no such table: {rc.star_qual}");
        }
    }
    q.cores[c].cols = cols.clone();
    let mut sc = scopes.clone();
    sc.push(Scope { core: c, alias_ok: false });
    let mut ctx = RCtx { scopes: sc, ctes: ctes.clone(), allow_agg: true, allow_win: true };
    for rc in cols {
        resolve(mut env, mut q, rc.e, ctx)?;
    }
    // ON and WHERE see the aliases but no aggregates
    let last = ctx.scopes.len() - 1;
    ctx.scopes[last].alias_ok = true;
    let mut plain = ctx.clone();
    plain.allow_agg = false;
    plain.allow_win = false;
    for k in 0..nsrc {
        let on = q.cores[c].srcs[k].on;
        resolve(mut env, mut q, on, plain)?;
    }
    let w = q.cores[c].where_e;
    resolve(mut env, mut q, w, plain)?;
    let ncols = cols.len();
    let group = q.cores[c].group.clone();
    for i in 0..group.len() {
        let x = q.exprs[group[i]].clone();
        if x.op == E_INT {
            let (v, _) = atoi64(to_bytes(x.text));
            if v < 1 or v > ncols {
                return Err(f"{ordinal(i + 1)} GROUP BY term out of range - should be between 1 and {ncols}");
            }
            q.cores[c].group[i] = cols[v - 1].e;
            continue;
        }
        if let Err(m) = resolve(mut env, mut q, group[i], plain) {
            if starts_with(m, "misuse of aggregate") {
                return Err("aggregate functions are not allowed in the GROUP BY clause".to_string());
            }
            return Err(m);
        }
    }
    let mut terms = order;
    for i in 0..terms.len() {
        let x = q.exprs[terms[i].e].clone();
        if x.op == E_COL and x.qual.len() == 0 {
            for j in 0..ncols {
                if cols[j].has_alias and ieq(cols[j].alias, x.text) {
                    terms[i].col = j;
                    break;
                }
            }
            if terms[i].col >= 0 {
                continue;
            }
        }
        if x.op == E_INT {
            let (v, _) = atoi64(to_bytes(x.text));
            if v < 1 or v > ncols {
                return Err(f"{ordinal(i + 1)} ORDER BY term out of range - should be between 1 and {ncols}");
            }
            terms[i].col = v - 1;
            continue;
        }
        resolve(mut env, mut q, terms[i].e, ctx)?;
    }
    let h = q.cores[c].having;
    ctx.allow_win = false;
    resolve(mut env, mut q, h, ctx)?;
    q.cores[c].order = terms;
    q.cores[c].is_agg = q.cores[c].group.len() > 0 or q.cores[c].aggs.len() > 0 or h >= 0;
    // what the result columns are called and what they carry
    let mut names: Vec[String] = Vec.new();
    let mut affs: Vec[i64] = Vec.new();
    let mut colls: Vec[i64] = Vec.new();
    for rc in cols {
        let x = ref q.exprs[rc.e];
        names.push(if rc.has_alias {
            rc.alias.clone()
        } else if x.op == E_COL {
            x.cname.clone()
        } else {
            rc.span.clone()
        });
        affs.push(expr_aff(q, rc.e));
        colls.push(expr_coll(q, rc.e));
    }
    q.cores[c].names = names;
    q.cores[c].affs = affs;
    q.cores[c].colls = colls;
    Ok(())
}

fn starts_with(s: Str, pat: Str) -> bool {
    let a = to_bytes(s);
    let b = to_bytes(pat);
    if b.len() > a.len() {
        return false;
    }
    for i in 0..b.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    true
}
// ------------------------------------------------------------ evaluation

// The values a row offers its expressions: the sources' columns side by
// side, the group's aggregates and the row's window functions.
#[derive(Clone)]
struct Frame {
    vals: Vec[V],
    aggs: Vec[V],
    wins: Vec[V],
}

fn frame_of(vals: own Vec[V]) -> Frame {
    Frame { vals: vals, aggs: Vec.new(), wins: Vec.new() }
}

fn int_v(b: bool) -> V {
    V.Int(if b { 1 } else { 0 })
}

// sqlite3DecOrHexToI64 on an integer literal: its value and 0, or 2 when
// it overflows, 3 for exactly 9223372036854775808.
fn literal_int(text: Str) -> (i64, i64) {
    let b = to_bytes(text);
    if b.len() > 2 and b[0] == b'0' and (b[1] == b'x' or b[1] == b'X') {
        let mut u: u64 = 0;
        for k in 2..b.len() {
            u = u.wrapping_mul(16).wrapping_add(hex_digit(b[k]) as u64);
        }
        return (u as i64, 0);
    }
    atoi64(b)
}

fn eval_literal(x: ref Ex, neg: bool) -> V {
    if x.op == E_REAL {
        let r = atof(to_bytes(x.text)).0;
        return V.Real(if neg { -r } else { r });
    }
    let (v, c) = literal_int(x.text);
    if c == 3 and neg {
        return V.Int(I64_MIN);
    }
    if c == 2 or c == 3 {
        let r = atof(to_bytes(x.text)).0;
        return V.Real(if neg { -r } else { r });
    }
    V.Int(if neg { -v } else { v })
}

fn is_cmp_op(op: i64) -> bool {
    op >= B_LT and op <= B_ISNOT
}

// The affinity and collation a comparison of l and r uses.
fn cmp_rules(q: ref Q, l: i64, r: i64) -> (i64, i64) {
    (compare_affinity(expr_aff(q, r), expr_aff(q, l)), binary_coll(q, l, r))
}

fn eval(env: ref Env, q: ref Q, e: i64, f: ref Frame, outer: ref Vec[Frame]) -> Result[V, String] {
    let x = ref q.exprs[e];
    let op = x.op;
    if op == E_COL {
        if x.depth == 0 {
            return Ok(f.vals[x.idx].clone());
        }
        return Ok(outer[outer.len() - x.depth].vals[x.idx].clone());
    }
    if op == E_INT or op == E_REAL {
        return Ok(eval_literal(x, false));
    }
    if op == E_TEXT {
        return Ok(V.Text(x.text.clone()));
    }
    if op == E_NULL {
        return Ok(V.Null);
    }
    if op == E_BLOB {
        return Ok(V.Blob(x.blob.clone()));
    }
    if op == E_PARAM {
        return Ok(if x.num >= 1 and x.num <= env.params.len() { env.params[x.num - 1].clone() } else { V.Null });
    }
    if op == E_ALIAS or op == E_COLLATE or op == E_POS {
        return eval(env, q, x.a, f, outer);
    }
    if op == E_BIN {
        return eval_bin(env, q, e, f, outer);
    }
    if op == E_FUNC {
        if x.kind == F_AGG {
            return Ok(f.aggs[x.slot].clone());
        }
        if x.kind == F_WIN {
            return Ok(f.wins[x.slot].clone());
        }
        return call_func(env, q, e, f, outer);
    }
    if op == E_NEG {
        let c = ref q.exprs[x.a];
        if c.op == E_INT or c.op == E_REAL {
            return Ok(eval_literal(c, true));
        }
        let v = eval(env, q, x.a, f, outer)?;
        return Ok(arith(B_SUB, V.Int(0), v));
    }
    if op == E_BITNOT {
        let v = eval(env, q, x.a, f, outer)?;
        return Ok(if is_null(v) { V.Null } else { V.Int(~int_value(v)) });
    }
    if op == E_NOT {
        let v = eval(env, q, x.a, f, outer)?;
        return Ok(if is_null(v) { V.Null } else { int_v(not bool_value(v)) });
    }
    if op == E_ISNULL {
        let v = eval(env, q, x.a, f, outer)?;
        return Ok(int_v(is_null(v) != x.neg));
    }
    if op == E_CAST {
        let v = eval(env, q, x.a, f, outer)?;
        return Ok(cast_value(v, x.aff, env.db.enc));
    }
    if op == E_BETWEEN {
        let v = eval(env, q, x.a, f, outer)?;
        let lo = eval(env, q, x.b, f, outer)?;
        let hi = eval(env, q, x.c, f, outer)?;
        let (a1, c1) = cmp_rules(q, x.a, x.b);
        let (a2, c2) = cmp_rules(q, x.a, x.c);
        let ge = compare_aff(v, lo, a1, c1, env.db.enc);
        let le = compare_aff(v, hi, a2, c2, env.db.enc);
        let p = match ge {
            Some(c) => V.Int(if c >= 0 { 1 } else { 0 }),
            None => V.Null,
        };
        let r = match le {
            Some(c) => V.Int(if c <= 0 { 1 } else { 0 }),
            None => V.Null,
        };
        let both = logic_and(p, r);
        return Ok(if x.neg { not_v(both) } else { both });
    }
    if op == E_IN {
        return eval_in(env, q, e, f, outer);
    }
    if op == E_LIKE or op == E_GLOB {
        let s = eval(env, q, x.a, f, outer)?;
        let pat = eval(env, q, x.b, f, outer)?;
        let mut esc: i64 = 0;
        if x.c >= 0 {
            let ev = eval(env, q, x.c, f, outer)?;
            match value_text(ev, env.db.enc) {
                None => return Ok(V.Null),
                Some(t) => {
                    let cps = code_points(t);
                    if cps.len() != 1 {
                        return Err("ESCAPE expression must be a single character".to_string());
                    }
                    esc = cps[0];
                }
            }
        }
        let st = value_text(s, env.db.enc);
        let pt = value_text(pat, env.db.enc);
        if st.is_none() or pt.is_none() {
            return Ok(V.Null);
        }
        let mut pc = code_points(pt.unwrap());
        pc.push(0);
        let mut sc = code_points(st.unwrap());
        sc.push(0);
        let m = if op == E_LIKE {
            pattern_compare(pc, 0, sc, 0, b'%' as i64, b'_' as i64, false, true, esc) == 0
        } else {
            pattern_compare(pc, 0, sc, 0, b'*' as i64, b'?' as i64, true, false, b'[' as i64) == 0
        };
        return Ok(int_v(m != x.neg));
    }
    if op == E_CASE {
        let mut base = V.Null;
        let mut rules = (AFF_NONE, COLL_BINARY);
        if x.a >= 0 {
            base = eval(env, q, x.a, f, outer)?;
        }
        let mut k: i64 = 0;
        while k + 1 < x.list.len() {
            let w = eval(env, q, x.list[k], f, outer)?;
            let hit = if x.a >= 0 {
                rules = cmp_rules(q, x.a, x.list[k]);
                match compare_aff(base, w, rules.0, rules.1, env.db.enc) {
                    Some(c) => c == 0,
                    None => false,
                }
            } else {
                not is_null(w) and bool_value(w)
            };
            if hit {
                return eval(env, q, x.list[k + 1], f, outer);
            }
            k += 2;
        }
        if x.c >= 0 {
            return eval(env, q, x.c, f, outer);
        }
        return Ok(V.Null);
    }
    if op == E_EXISTS {
        let mut o2 = outer.clone();
        o2.push(f.clone());
        let rows = run_select(env, q, x.sel, o2)?;
        return Ok(int_v(rows.len() > 0));
    }
    if op == E_SUBQ {
        let mut o2 = outer.clone();
        o2.push(f.clone());
        let rows = run_select(env, q, x.sel, o2)?;
        if rows.len() == 0 or rows[0].len() == 0 {
            return Ok(V.Null);
        }
        return Ok(rows[0][0].clone());
    }
    Err(f"cannot evaluate expression kind {op}")
}

fn not_v(v: V) -> V {
    if is_null(v) { V.Null } else { int_v(not bool_value(v)) }
}

// Three-valued AND and OR.
fn logic_and(a: V, b: V) -> V {
    let fa = not is_null(a) and not bool_value(a);
    let fb = not is_null(b) and not bool_value(b);
    if fa or fb {
        V.Int(0)
    } else if is_null(a) or is_null(b) {
        V.Null
    } else {
        V.Int(1)
    }
}

fn logic_or(a: V, b: V) -> V {
    let ta = not is_null(a) and bool_value(a);
    let tb = not is_null(b) and bool_value(b);
    if ta or tb {
        V.Int(1)
    } else if is_null(a) or is_null(b) {
        V.Null
    } else {
        V.Int(0)
    }
}

fn eval_bin(env: ref Env, q: ref Q, e: i64, f: ref Frame, outer: ref Vec[Frame]) -> Result[V, String] {
    let x = ref q.exprs[e];
    let sub = x.sub;
    if sub == B_AND {
        let a = eval(env, q, x.a, f, outer)?;
        if not is_null(a) and not bool_value(a) {
            return Ok(V.Int(0));
        }
        let b = eval(env, q, x.b, f, outer)?;
        return Ok(logic_and(a, b));
    }
    if sub == B_OR {
        let a = eval(env, q, x.a, f, outer)?;
        if not is_null(a) and bool_value(a) {
            return Ok(V.Int(1));
        }
        let b = eval(env, q, x.b, f, outer)?;
        return Ok(logic_or(a, b));
    }
    let a = eval(env, q, x.a, f, outer)?;
    let b = eval(env, q, x.b, f, outer)?;
    if is_cmp_op(sub) {
        let aff = x.aff;
        let coll = x.coll;
        if sub == B_IS or sub == B_ISNOT {
            let same = if is_null(a) and is_null(b) {
                true
            } else if is_null(a) or is_null(b) {
                false
            } else {
                compare_aff(a, b, aff, coll, env.db.enc).unwrap() == 0
            };
            return Ok(int_v(same == (sub == B_IS)));
        }
        return Ok(match compare_aff(a, b, aff, coll, env.db.enc) {
            None => V.Null,
            Some(c) => int_v(if sub == B_LT {
                c < 0
            } else if sub == B_LE {
                c <= 0
            } else if sub == B_GT {
                c > 0
            } else if sub == B_GE {
                c >= 0
            } else if sub == B_EQ {
                c == 0
            } else {
                c != 0
            }),
        });
    }
    if sub == B_CONCAT {
        if is_null(a) or is_null(b) {
            return Ok(V.Null);
        }
        let mut s = value_text(a, env.db.enc).unwrap();
        s.push_str(value_text(b, env.db.enc).unwrap());
        return Ok(V.Text(s));
    }
    if sub == B_BITAND or sub == B_BITOR or sub == B_SHL or sub == B_SHR {
        if is_null(a) or is_null(b) {
            return Ok(V.Null);
        }
        return Ok(V.Int(bit_op(sub, int_value(a), int_value(b))));
    }
    Ok(arith(sub, a, b))
}

fn bit_op(op: i64, a: i64, b0: i64) -> i64 {
    if op == B_BITAND {
        return a & b0;
    }
    if op == B_BITOR {
        return a | b0;
    }
    if b0 == 0 {
        return a;
    }
    let mut left = op == B_SHL;
    let mut b = b0;
    if b < 0 {
        left = not left;
        b = if b > -64 { -b } else { 64 };
    }
    if b >= 64 {
        return if a >= 0 or left { 0 } else { -1 };
    }
    let u = a as u64;
    if left {
        (u << b) as i64
    } else {
        let mut r = u >> b;
        if a < 0 {
            r = r | (0xffffffffffffffff << (64 - b));
        }
        r as i64
    }
}

// OP_Add and its kin.
fn arith(op: i64, a: V, b: V) -> V {
    if is_null(a) or is_null(b) {
        return V.Null;
    }
    let na = numeric_value(a);
    let nb = numeric_value(b);
    if let V.Int(x) = na {
        if let V.Int(y) = nb {
            if op == B_ADD {
                if let Some(r) = x.checked_add(y) {
                    return V.Int(r);
                }
            } else if op == B_SUB {
                if let Some(r) = x.checked_sub(y) {
                    return V.Int(r);
                }
            } else if op == B_MUL {
                if let Some(r) = x.checked_mul(y) {
                    return V.Int(r);
                }
            } else if op == B_DIV {
                if y == 0 {
                    return V.Null;
                }
                if not (y == -1 and x == I64_MIN) {
                    return V.Int(x / y);
                }
            } else {
                if y == 0 {
                    return V.Null;
                }
                let d = if y == -1 { 1 } else { y };
                return V.Int(x % d);
            }
        }
    }
    let ra = real_value(na);
    let rb = real_value(nb);
    let r = if op == B_ADD {
        ra + rb
    } else if op == B_SUB {
        ra - rb
    } else if op == B_MUL {
        ra * rb
    } else if op == B_DIV {
        if rb == 0.0 {
            return V.Null;
        }
        ra / rb
    } else {
        let ia = int_value(a);
        let ib = int_value(b);
        if ib == 0 {
            return V.Null;
        }
        let d = if ib == -1 { 1 } else { ib };
        (ia % d) as f64
    };
    if r.is_nan() {
        return V.Null;
    }
    V.Real(r)
}

fn eval_in(env: ref Env, q: ref Q, e: i64, f: ref Frame, outer: ref Vec[Frame]) -> Result[V, String] {
    let x = ref q.exprs[e];
    let l = eval(env, q, x.a, f, outer)?;
    let mut vals: Vec[V] = Vec.new();
    let mut aff = expr_aff(q, x.a);
    let mut coll = expr_coll(q, x.a);
    if x.sel >= 0 {
        let mut o2 = outer.clone();
        o2.push(f.clone());
        let rows = run_select(env, q, x.sel, o2)?;
        for r in rows {
            vals.push(r[0].clone());
        }
        let c0 = ref q.cores[q.sels[x.sel].cores[0]];
        let re = c0.cols[0].e;
        aff = compare_affinity(expr_aff(q, re), aff);
        coll = binary_coll(q, x.a, re);
    } else {
        for k in x.list {
            vals.push(eval(env, q, k, f, outer)?);
        }
    }
    if vals.len() == 0 {
        return Ok(int_v(x.neg));
    }
    if is_null(l) {
        return Ok(V.Null);
    }
    let mut saw_null = false;
    for v in vals {
        match compare_aff(l, v, aff, coll, env.db.enc) {
            None => saw_null = true,
            Some(c) => {
                if c == 0 {
                    return Ok(int_v(not x.neg));
                }
            }
        }
    }
    if saw_null {
        return Ok(V.Null);
    }
    Ok(int_v(x.neg))
}

// patternCompare: 0 a match, 1 no match, 2 no match and no use trying
// later starting points.
fn pattern_compare(p: ref Vec[i64], pi0: i64, s: ref Vec[i64], si0: i64, all: i64, one: i64, set: bool, nocase: bool, other: i64) -> i64 {
    let mut pi = pi0;
    let mut si = si0;
    let mut escaped: i64 = -1;
    loop {
        let c0 = p[pi];
        if c0 == 0 {
            break;
        }
        pi += 1;
        let mut c = c0;
        if c == all {
            loop {
                c = p[pi];
                if c == 0 {
                    break;
                }
                if c == all {
                    pi += 1;
                    continue;
                }
                if c == one {
                    pi += 1;
                    if s[si] == 0 {
                        return 2;
                    }
                    si += 1;
                    continue;
                }
                break;
            }
            if c == 0 {
                return 0;
            }
            pi += 1;
            if c == other {
                if not set {
                    c = p[pi];
                    pi += 1;
                    if c == 0 {
                        return 2;
                    }
                } else {
                    while s[si] != 0 {
                        let m = pattern_compare(p, pi - 1, s, si, all, one, set, nocase, other);
                        if m != 1 {
                            return m;
                        }
                        si += 1;
                    }
                    return 2;
                }
            }
            while s[si] != 0 {
                let c2 = s[si];
                si += 1;
                let same = c2 == c or (nocase and c < 0x80 and c2 < 0x80 and lower_byte(c as u8) == lower_byte(c2 as u8));
                if not same {
                    continue;
                }
                let m = pattern_compare(p, pi, s, si, all, one, set, nocase, other);
                if m != 1 {
                    return m;
                }
            }
            return 2;
        }
        if c == other {
            if not set {
                c = p[pi];
                pi += 1;
                if c == 0 {
                    return 1;
                }
                escaped = pi;
            } else {
                let mut prior: i64 = 0;
                let mut seen = false;
                let mut invert = false;
                let sc = s[si];
                if sc == 0 {
                    return 1;
                }
                si += 1;
                let mut c2 = p[pi];
                pi += 1;
                if c2 == b'^' as i64 {
                    invert = true;
                    c2 = p[pi];
                    pi += 1;
                }
                if c2 == b']' as i64 {
                    if sc == b']' as i64 {
                        seen = true;
                    }
                    c2 = p[pi];
                    pi += 1;
                }
                while c2 != 0 and c2 != b']' as i64 {
                    if c2 == b'-' as i64 and p[pi] != b']' as i64 and p[pi] != 0 and prior > 0 {
                        c2 = p[pi];
                        pi += 1;
                        if sc >= prior and sc <= c2 {
                            seen = true;
                        }
                        prior = 0;
                    } else {
                        if sc == c2 {
                            seen = true;
                        }
                        prior = c2;
                    }
                    c2 = p[pi];
                    pi += 1;
                }
                if c2 == 0 or seen == invert {
                    return 1;
                }
                continue;
            }
        }
        let c2 = s[si];
        if c2 != 0 {
            si += 1;
        }
        if c == c2 {
            continue;
        }
        if nocase and c < 0x80 and c2 < 0x80 and c2 != 0 and lower_byte(c as u8) == lower_byte(c2 as u8) {
            continue;
        }
        if c == one and pi != escaped and c2 != 0 {
            continue;
        }
        return 1;
    }
    if s[si] == 0 { 0 } else { 1 }
}
// ------------------------------------------------------------ scalar functions

fn call_func(env: ref Env, q: ref Q, e: i64, f: ref Frame, outer: ref Vec[Frame]) -> Result[V, String] {
    let x = ref q.exprs[e];
    let name = x.text.clone();
    if name == "coalesce" or name == "ifnull" {
        for a in x.list {
            let v = eval(env, q, a, f, outer)?;
            if not is_null(v) {
                return Ok(v);
            }
        }
        return Ok(V.Null);
    }
    if name == "iif" {
        let c = eval(env, q, x.list[0], f, outer)?;
        let pick = if not is_null(c) and bool_value(c) { x.list[1] } else { x.list[2] };
        return eval(env, q, pick, f, outer);
    }
    let mut args: Vec[V] = Vec.new();
    for a in x.list {
        args.push(eval(env, q, a, f, outer)?);
    }
    scalar_func(name, args, x.coll, env.db.enc)
}

// sqlite3_value_int: the 32-bit integer a value reads as.
fn int32_value(v: ref V) -> i64 {
    (int_value(v) as i32) as i64
}

fn hex_of(b: ref Vec[u8]) -> String {
    let d = to_bytes(HEX_UPPER);
    let mut out: Vec[u8] = Vec.new();
    for c in b {
        out.push(d[(c >> 4) as i64]);
        out.push(d[(c & 15) as i64]);
    }
    from_bytes(out)
}

// sqlite3QuoteValue.
fn quote_value(v: ref V, enc: i64) -> String {
    match v {
        V.Null => "NULL".to_string(),
        V.Int(i) => i.to_string(),
        V.Real(r) => {
            let mut spec = fmt_spec();
            spec.altform2 = true;
            spec.zeropad = true;
            spec.precision = 15;
            let t = fmt_float(r, b'g', spec);
            let back = atof(to_bytes(t)).0;
            if back.to_bits() == r.to_bits() or back == r {
                t
            } else {
                spec.precision = 20;
                fmt_float(r, b'e', spec)
            }
        },
        V.Blob(b) => f"X'{hex_of(b)}'",
        V.Text(_) => from_bytes(sql_escape(value_text(v, enc), b'Q')),
    }
}

fn trim_cps(s: ref Vec[i64], set: ref Vec[i64], flags: i64) -> String {
    let mut lo: i64 = 0;
    let mut hi: i64 = s.len();
    if flags & 1 != 0 {
        while lo < hi and set.contains(s[lo]) {
            lo += 1;
        }
    }
    if flags & 2 != 0 {
        while hi > lo and set.contains(s[hi - 1]) {
            hi -= 1;
        }
    }
    let mut part: Vec[i64] = Vec.new();
    for k in lo..hi {
        part.push(s[k]);
    }
    from_code_points(part)
}

// substrFunc.
fn substr_value(args: ref Vec[V], enc: i64) -> V {
    if is_null(args[1]) or (args.len() == 3 and is_null(args[2])) {
        return V.Null;
    }
    let mut p1 = int32_value(args[1]);
    let is_blob = match args[0] {
        V.Blob(_) => true,
        _ => false,
    };
    let mut bytes: Vec[u8] = Vec.new();
    let mut cps: Vec[i64] = Vec.new();
    let len: i64 = if is_blob {
        bytes = value_blob(args[0], enc);
        bytes.len()
    } else {
        match value_text(args[0], enc) {
            None => return V.Null,
            Some(t) => cps = code_points(t),
        }
        cps.len()
    };
    let mut neg_p2 = false;
    let mut p2: i64 = 1000000000;
    if args.len() == 3 {
        p2 = int32_value(args[2]);
        if p2 < 0 {
            p2 = -p2;
            neg_p2 = true;
        }
    }
    if p1 < 0 {
        p1 += len;
        if p1 < 0 {
            p2 += p1;
            if p2 < 0 {
                p2 = 0;
            }
            p1 = 0;
        }
    } else if p1 > 0 {
        p1 -= 1;
    } else if p2 > 0 {
        p2 -= 1;
    }
    if neg_p2 {
        p1 -= p2;
        if p1 < 0 {
            p2 += p1;
            p1 = 0;
        }
    }
    if p1 > len {
        p1 = len;
    }
    let mut end = p1 + p2;
    if end > len {
        end = len;
    }
    if is_blob {
        return V.Blob(sub_bytes(bytes, p1, end));
    }
    let mut part: Vec[i64] = Vec.new();
    for k in p1..end {
        part.push(cps[k]);
    }
    V.Text(from_code_points(part))
}

// instrFunc: characters for text, bytes for two blobs.
fn instr_value(a: ref V, b: ref V, enc: i64) -> V {
    if is_null(a) or is_null(b) {
        return V.Null;
    }
    let both_blob = match a {
        V.Blob(_) => match b {
            V.Blob(_) => true,
            _ => false,
        },
        _ => false,
    };
    if both_blob {
        let h = value_blob(a, enc);
        let n = value_blob(b, enc);
        if n.len() == 0 {
            return V.Int(1);
        }
        let at = find_bytes(h, n, 0);
        return V.Int(if at < 0 { 0 } else { at + 1 });
    }
    let h = code_points(value_text(a, enc).unwrap());
    let n = code_points(value_text(b, enc).unwrap());
    if n.len() == 0 {
        return V.Int(1);
    }
    let mut k: i64 = 0;
    while k + n.len() <= h.len() {
        let mut same = true;
        for j in 0..n.len() {
            if h[k + j] != n[j] {
                same = false;
                break;
            }
        }
        if same {
            return V.Int(k + 1);
        }
        k += 1;
    }
    V.Int(0)
}

// concatFuncCore: the non-empty values, separated.
fn concat_values(args: ref Vec[V], from: i64, sep: Str, enc: i64) -> V {
    let mut out = String.new();
    let mut any = false;
    for k in from..args.len() {
        match value_text(args[k], enc) {
            None => {},
            Some(t) => {
                if t.len() > 0 {
                    if any {
                        out.push_str(sep);
                    }
                    out.push_str(t);
                    any = true;
                }
            }
        }
    }
    V.Text(out)
}

fn round_value(args: ref Vec[V]) -> V {
    let mut n: i64 = 0;
    if args.len() == 2 {
        if is_null(args[1]) {
            return V.Null;
        }
        n = int32_value(args[1]);
        if n > 30 {
            n = 30;
        }
        if n < 0 {
            n = 0;
        }
    }
    if is_null(args[0]) {
        return V.Null;
    }
    let mut r = real_value(args[0]);
    if r < -4503599627370496.0 or r > 4503599627370496.0 {
        // already whole
    } else if n == 0 {
        r = ((r + if r < 0.0 { -0.5 } else { 0.5 }) as i64) as f64;
    } else {
        let mut spec = fmt_spec();
        spec.altform2 = true;
        spec.precision = n;
        r = atof(to_bytes(fmt_float(r, b'f', spec))).0;
    }
    V.Real(r)
}

fn scalar_func(name: Str, args: Vec[V], coll: i64, enc: i64) -> Result[V, String] {
    let n = args.len();
    if name == "date" or name == "time" or name == "datetime" or name == "julianday" or name == "unixepoch" or name == "strftime" {
        return Ok(date_func(name, args, enc));
    }
    if name == "typeof" {
        return Ok(V.Text(type_name(args[0])));
    }
    if name == "length" {
        return Ok(match args[0] {
            V.Null => V.Null,
            V.Text(s) => V.Int(code_points(s).len()),
            V.Blob(b) => V.Int(b.len()),
            _ => V.Int(to_bytes(num_text(args[0])).len()),
        });
    }
    if name == "octet_length" {
        return Ok(match args[0] {
            V.Null => V.Null,
            V.Text(s) => V.Int(enc_bytes(s, enc).len()),
            V.Blob(b) => V.Int(b.len()),
            _ => V.Int(to_bytes(num_text(args[0])).len() * (if enc == ENC_UTF8 { 1 } else { 2 })),
        });
    }
    if name == "upper" or name == "lower" {
        return Ok(match value_text(args[0], enc) {
            None => V.Null,
            Some(t) => V.Text(if name == "upper" { ascii_upper(t) } else { ascii_lower(t) }),
        });
    }
    if name == "abs" {
        return match args[0] {
            V.Null => Ok(V.Null),
            V.Int(i) => {
                if i == I64_MIN {
                    Err("integer overflow".to_string())
                } else {
                    Ok(V.Int(if i < 0 { -i } else { i }))
                }
            },
            _ => {
                let r = real_value(args[0]);
                Ok(V.Real(if r < 0.0 { -r } else { r }))
            },
        };
    }
    if name == "sign" {
        let nv = apply_numeric(args[0], false);
        return Ok(match nv {
            V.Int(i) => V.Int(if i < 0 { -1 } else if i > 0 { 1 } else { 0 }),
            V.Real(r) => V.Int(if r < 0.0 { -1 } else if r > 0.0 { 1 } else { 0 }),
            _ => V.Null,
        });
    }
    if name == "round" {
        return Ok(round_value(args));
    }
    if name == "hex" {
        return Ok(V.Text(hex_of(value_blob(args[0], enc))));
    }
    if name == "quote" {
        return Ok(V.Text(quote_value(args[0], enc)));
    }
    if name == "unicode" {
        return Ok(match value_text(args[0], enc) {
            None => V.Null,
            Some(t) => {
                let cps = code_points(t);
                if cps.len() == 0 { V.Null } else { V.Int(cps[0]) }
            }
        });
    }
    if name == "char" {
        let mut cps: Vec[i64] = Vec.new();
        for a in args {
            let c = int_value(a);
            cps.push(if c < 0 or c > 0x10ffff { 0xfffd } else { c });
        }
        return Ok(V.Text(from_code_points(cps)));
    }
    if name == "zeroblob" {
        let k = int_value(args[0]);
        let mut b: Vec[u8] = Vec.new();
        for _ in 0..(if k < 0 { 0 } else { k }) {
            b.push(0);
        }
        return Ok(V.Blob(b));
    }
    if name == "substr" or name == "substring" {
        return Ok(substr_value(args, enc));
    }
    if name == "instr" {
        return Ok(instr_value(args[0], args[1], enc));
    }
    if name == "replace" {
        let s = match value_text(args[0], enc) {
            None => return Ok(V.Null),
            Some(t) => t,
        };
        let pat = match value_text(args[1], enc) {
            None => return Ok(V.Null),
            Some(t) => t,
        };
        if pat.len() == 0 {
            return Ok(V.Text(s));
        }
        let rep = match value_text(args[2], enc) {
            None => return Ok(V.Null),
            Some(t) => t,
        };
        return Ok(V.Text(replace_all(s, pat, rep)));
    }
    if name == "trim" or name == "ltrim" or name == "rtrim" {
        let flags = if name == "ltrim" { 1 } else if name == "rtrim" { 2 } else { 3 };
        let s = match value_text(args[0], enc) {
            None => return Ok(V.Null),
            Some(t) => t,
        };
        let set = if n == 2 {
            match value_text(args[1], enc) {
                None => return Ok(V.Null),
                Some(t) => code_points(t),
            }
        } else {
            vec![32]
        };
        let cps = code_points(s);
        if set.len() == 0 {
            return Ok(V.Text(from_code_points(cps)));
        }
        return Ok(V.Text(trim_cps(cps, set, flags)));
    }
    if name == "nullif" {
        let c = if coll == COLL_NONE { COLL_BINARY } else { coll };
        return Ok(if mem_compare(args[0], args[1], c, enc) != 0 { args[0].clone() } else { V.Null });
    }
    if name == "min" or name == "max" {
        let c = if coll == COLL_NONE { COLL_BINARY } else { coll };
        if is_null(args[0]) {
            return Ok(V.Null);
        }
        let mut best: i64 = 0;
        for i in 1..n {
            if is_null(args[i]) {
                return Ok(V.Null);
            }
            let cmp = mem_compare(args[best], args[i], c, enc);
            if (name == "min" and cmp >= 0) or (name == "max" and cmp < 0) {
                best = i;
            }
        }
        return Ok(args[best].clone());
    }
    if name == "concat" {
        return Ok(concat_values(args, 0, "", enc));
    }
    if name == "concat_ws" {
        return Ok(match value_text(args[0], enc) {
            None => V.Null,
            Some(sep) => concat_values(args, 1, sep, enc),
        });
    }
    if name == "printf" or name == "format" {
        return Ok(match value_text(args[0], enc) {
            None => V.Null,
            Some(fmt) => {
                let mut rest: Vec[V] = Vec.new();
                for k in 1..n {
                    rest.push(args[k].clone());
                }
                V.Text(sql_printf(fmt, rest, enc))
            }
        });
    }
    Err(f"no such function: {name}")
}
// ------------------------------------------------------------ printf

// One conversion's flags, width and precision, as sqlite3_str_vappendf
// reads them.
#[derive(Clone)]
struct Spec {
    left: bool,
    prefix: u8,
    alt: bool,
    altform2: bool,
    zeropad: bool,
    thousand: bool,
    width: i64,
    precision: i64,
}

fn fmt_spec() -> Spec {
    Spec { left: false, prefix: 0, alt: false, altform2: false, zeropad: false, thousand: false, width: 0, precision: -1 }
}

// The width padding every conversion ends with, counted in bytes.
fn pad_spec(body: Vec[u8], spec: ref Spec, width: i64) -> String {
    let n = body.len();
    if width <= n {
        return from_bytes(body);
    }
    let mut out: Vec[u8] = Vec.new();
    if not spec.left {
        for _ in 0..(width - n) {
            out.push(b' ');
        }
    }
    for c in body {
        out.push(c);
    }
    if spec.left {
        for _ in 0..(width - n) {
            out.push(b' ');
        }
    }
    from_bytes(out)
}

fn push_str(out: mut ref Vec[u8], s: Str) {
    for c in to_bytes(s) {
        out.push(c);
    }
}

// etFLOAT, etEXP and etGENERIC.
fn fmt_float(r: f64, conv: u8, spec: ref Spec) -> String {
    let mut precision = if spec.precision < 0 { 6 } else { spec.precision };
    let upper = conv == b'E' or conv == b'G';
    let mut xtype = lower_byte(conv);
    let i_round = if xtype == b'f' {
        -precision
    } else if xtype == b'g' {
        if precision == 0 {
            precision = 1;
        }
        precision
    } else {
        precision + 1
    };
    let mut s = fp_decode(r, i_round, if spec.altform2 { 26 } else { 16 });
    if s.special == 2 {
        let body = to_bytes(if spec.zeropad { "null" } else { "NaN" });
        return pad_spec(body, spec, spec.width);
    }
    if s.special == 1 {
        if spec.zeropad {
            s.z = vec![b'9'];
            s.idp = 1000;
        } else {
            let mut body: Vec[u8] = Vec.new();
            if s.neg {
                body.push(b'-');
            } else if spec.prefix != 0 {
                body.push(spec.prefix);
            }
            push_str(mut body, "Inf");
            return pad_spec(body, spec, spec.width);
        }
    }
    let prefix = if s.neg { b'-' } else { spec.prefix };
    if xtype == b'g' and precision > 0 {
        precision -= 1;
    }
    let mut rtz = spec.altform2;
    if xtype == b'g' {
        rtz = not spec.alt;
        let exp = s.idp - 1;
        if exp < -4 or exp > precision {
            xtype = b'e';
        } else {
            precision = precision - exp;
            xtype = b'f';
        }
    }
    let mut e2 = if xtype == b'e' { 0 } else { s.idp - 1 };
    let flag_dp = precision > 0 or spec.alt or spec.altform2;
    let mut b: Vec[u8] = Vec.new();
    if prefix != 0 {
        b.push(prefix);
    }
    let n = s.z.len();
    let mut j: i64 = 0;
    if e2 < 0 {
        b.push(b'0');
    } else {
        while e2 >= 0 {
            if j < n {
                b.push(s.z[j]);
                j += 1;
            } else {
                b.push(b'0');
            }
            if spec.thousand and e2 % 3 == 0 and e2 > 1 {
                b.push(b',');
            }
            e2 -= 1;
        }
    }
    if flag_dp {
        b.push(b'.');
    }
    e2 += 1;
    while e2 < 0 and precision > 0 {
        b.push(b'0');
        precision -= 1;
        e2 += 1;
    }
    while precision > 0 {
        if j < n {
            b.push(s.z[j]);
            j += 1;
        } else {
            b.push(b'0');
        }
        precision -= 1;
    }
    if rtz and flag_dp {
        while b[b.len() - 1] == b'0' {
            b.pop();
        }
        if b[b.len() - 1] == b'.' {
            if spec.altform2 {
                b.push(b'0');
            } else {
                b.pop();
            }
        }
    }
    if xtype == b'e' {
        let mut exp = s.idp - 1;
        b.push(if upper { b'E' } else { b'e' });
        if exp < 0 {
            b.push(b'-');
            exp = -exp;
        } else {
            b.push(b'+');
        }
        if exp >= 100 {
            b.push((exp / 100) as u8 + b'0');
            exp = exp % 100;
        }
        b.push((exp / 10) as u8 + b'0');
        b.push((exp % 10) as u8 + b'0');
    }
    if spec.zeropad and not spec.left and b.len() < spec.width {
        let npad = spec.width - b.len();
        let at = if prefix != 0 { 1 } else { 0 };
        for _ in 0..npad {
            b.insert(at, b'0');
        }
    }
    pad_spec(b, spec, spec.width)
}

// etDECIMAL and etRADIX.
fn fmt_int(v: i64, conv: u8, spec: ref Spec) -> String {
    let signed = conv == b'd' or conv == b'i';
    let base: u64 = if conv == b'x' or conv == b'X' { 16 } else if conv == b'o' { 8 } else { 10 };
    let thousand = spec.thousand and base == 10;
    let mut prefix: u8 = 0;
    let mut u: u64 = v as u64;
    if signed {
        if v < 0 {
            u = (~v as u64).wrapping_add(1);
            prefix = b'-';
        } else {
            prefix = spec.prefix;
        }
    }
    let alt = spec.alt and u != 0;
    let mut precision = spec.precision;
    let has_prefix = if prefix != 0 { 1 } else { 0 };
    if spec.zeropad and precision < spec.width - has_prefix {
        precision = spec.width - has_prefix;
    }
    let digits = to_bytes(if conv == b'X' { HEX_UPPER } else { HEX_LOWER });
    let mut rev: Vec[u8] = Vec.new();
    loop {
        rev.push(digits[(u % base) as i64]);
        u = u / base;
        if u == 0 {
            break;
        }
    }
    while precision > rev.len() {
        rev.push(b'0');
    }
    let mut body: Vec[u8] = Vec.new();
    let len = rev.len();
    for k in 0..len {
        body.push(rev[len - 1 - k]);
        let left = len - 1 - k;
        if thousand and left > 0 and left % 3 == 0 {
            body.push(b',');
        }
    }
    if prefix != 0 {
        body.insert(0, prefix);
    }
    if alt {
        if conv == b'x' {
            body.insert(0, b'x');
            body.insert(0, b'0');
        } else if conv == b'X' {
            body.insert(0, b'X');
            body.insert(0, b'0');
        } else if conv == b'o' {
            body.insert(0, b'0');
        }
    }
    pad_spec(body, spec, spec.width)
}

// %q, %Q and %w.
fn sql_escape(arg: Option[String], conv: u8) -> Vec[u8] {
    let quote = if conv == b'w' { b'"' } else { b'\'' };
    let isnull = arg.is_none();
    let text = match arg {
        Some(t) => t.clone(),
        None => (if conv == b'Q' { "NULL" } else { "(NULL)" }).to_string(),
    };
    let need = not isnull and conv == b'Q';
    let mut out: Vec[u8] = Vec.new();
    if need {
        out.push(quote);
    }
    for c in to_bytes(text) {
        out.push(c);
        if c == quote {
            out.push(quote);
        }
    }
    if need {
        out.push(quote);
    }
    out
}

// The SQL printf(): sqlite3_str_vappendf over a list of values.
fn sql_printf(fmt: Str, args: ref Vec[V], enc: i64) -> String {
    let b = to_bytes(fmt);
    let n = b.len();
    let mut out: Vec[u8] = Vec.new();
    let mut used: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        if b[i] != b'%' {
            out.push(b[i]);
            i += 1;
            continue;
        }
        i += 1;
        if i >= n {
            out.push(b'%');
            break;
        }
        let mut spec = fmt_spec();
        loop {
            if i >= n {
                break;
            }
            let c = b[i];
            if c == b'-' {
                spec.left = true;
            } else if c == b'+' {
                spec.prefix = b'+';
            } else if c == b' ' {
                spec.prefix = b' ';
            } else if c == b'#' {
                spec.alt = true;
            } else if c == b'!' {
                spec.altform2 = true;
            } else if c == b'0' {
                spec.zeropad = true;
            } else if c == b',' {
                spec.thousand = true;
            } else {
                break;
            }
            i += 1;
        }
        if i < n and b[i] == b'*' {
            let w = if used < args.len() { int_value(args[used]) } else { 0 };
            used += 1;
            if w < 0 {
                spec.left = true;
                spec.width = -w;
            } else {
                spec.width = w;
            }
            i += 1;
        } else {
            while i < n and is_digit(b[i]) {
                spec.width = spec.width * 10 + (b[i] - b'0') as i64;
                i += 1;
            }
        }
        if i < n and b[i] == b'.' {
            i += 1;
            if i < n and b[i] == b'*' {
                let p = if used < args.len() { int_value(args[used]) } else { 0 };
                used += 1;
                spec.precision = if p < 0 { -p } else { p };
                i += 1;
            } else {
                let mut p: i64 = 0;
                while i < n and is_digit(b[i]) {
                    p = p * 10 + (b[i] - b'0') as i64;
                    i += 1;
                }
                spec.precision = p;
            }
        }
        while i < n and b[i] == b'l' {
            i += 1;
        }
        if i >= n {
            break;
        }
        let c = b[i];
        i += 1;
        let arg = if used < args.len() { args[used].clone() } else { V.Null };
        let has_arg = used < args.len();
        if c == b'd' or c == b'i' or c == b'u' or c == b'x' or c == b'X' or c == b'o' {
            used += 1;
            push_str(mut out, fmt_int(if has_arg { int_value(arg) } else { 0 }, c, spec));
        } else if c == b'f' or c == b'e' or c == b'E' or c == b'g' or c == b'G' {
            used += 1;
            push_str(mut out, fmt_float(if has_arg { real_value(arg) } else { 0.0 }, c, spec));
        } else if c == b's' or c == b'z' {
            used += 1;
            let t = if has_arg { value_text(arg, enc) } else { None };
            let tb = to_bytes(t.unwrap_or(String.new()));
            let mut len = tb.len();
            if spec.precision >= 0 {
                if spec.altform2 {
                    let mut k: i64 = 0;
                    let mut chars: i64 = 0;
                    while k < tb.len() and chars < spec.precision {
                        k += 1;
                        while k < tb.len() and (tb[k] & 0xc0) == 0x80 {
                            k += 1;
                        }
                        chars += 1;
                    }
                    len = k;
                } else if spec.precision < len {
                    len = spec.precision;
                }
            }
            let body = sub_bytes(tb, 0, len);
            let mut width = spec.width;
            if spec.altform2 and width > 0 {
                for x in body {
                    if (x & 0xc0) == 0x80 {
                        width += 1;
                    }
                }
            }
            push_str(mut out, pad_spec(body, spec, width));
        } else if c == b'q' or c == b'Q' or c == b'w' {
            used += 1;
            let t = if has_arg { value_text(arg, enc) } else { None };
            push_str(mut out, pad_spec(sql_escape(t, c), spec, spec.width));
        } else if c == b'c' {
            used += 1;
            let t = if has_arg { value_text(arg, enc) } else { None };
            let cps = code_points(t.unwrap_or(String.new()));
            let mut body: Vec[u8] = Vec.new();
            let times = if spec.precision > 1 { spec.precision } else { 1 };
            for _ in 0..times {
                if cps.len() > 0 {
                    push_code_point(mut body, cps[0]);
                }
            }
            push_str(mut out, pad_spec(body, spec, spec.width));
        } else if c == b'%' {
            out.push(b'%');
        } else {
            break;
        }
    }
    from_bytes(out)
}
// ------------------------------------------------------------ dates

// date.c's DateTime: a julian day in milliseconds and/or its calendar
// fields, with which of them are current.
#[derive(Clone)]
struct Dt {
    ijd: i64,
    y: i64,
    mo: i64,
    d: i64,
    h: i64,
    mi: i64,
    tz: i64,
    s: f64,
    valid_jd: bool,
    raw_s: bool,
    valid_ymd: bool,
    valid_hms: bool,
    valid_tz: bool,
    tz_set: bool,
    is_error: bool,
    use_subsec: bool,
}

fn dt_zero() -> Dt {
    Dt {
        ijd: 0,
        y: 0,
        mo: 0,
        d: 0,
        h: 0,
        mi: 0,
        tz: 0,
        s: 0.0,
        valid_jd: false,
        raw_s: false,
        valid_ymd: false,
        valid_hms: false,
        valid_tz: false,
        tz_set: false,
        is_error: false,
        use_subsec: false,
    }
}

fn byte_at(b: ref Vec[u8], i: i64) -> u8 {
    if i >= 0 and i < b.len() { b[i] } else { 0 }
}

fn is_c_space(c: u8) -> bool {
    c == b' ' or c == b'\t' or c == b'\n' or c == 0x0b or c == 0x0c or c == b'\r'
}

// One field of getDigits: n digits from at, within min..max, followed by
// next (when next is not 0); -1 when the text does not fit.
fn gd(b: ref Vec[u8], at: i64, n: i64, min: i64, max: i64, next: u8) -> i64 {
    let mut val: i64 = 0;
    for k in 0..n {
        let c = byte_at(b, at + k);
        if not is_digit(c) {
            return -1;
        }
        val = val * 10 + (c - b'0') as i64;
    }
    if val < min or val > max or (next != 0 and byte_at(b, at + n) != next) {
        return -1;
    }
    val
}

fn dt_error(p: mut ref Dt) {
    p.ijd = 0;
    p.valid_jd = false;
    p.valid_ymd = false;
    p.valid_hms = false;
    p.valid_tz = false;
    p.raw_s = false;
    p.is_error = true;
}

fn parse_tz(b: ref Vec[u8], at: i64, p: mut ref Dt) -> bool {
    let mut i = at;
    while is_c_space(byte_at(b, i)) {
        i += 1;
    }
    p.tz = 0;
    let c = byte_at(b, i);
    if c == b'Z' or c == b'z' {
        i += 1;
    } else {
        let sgn: i64 = if c == b'-' {
            -1
        } else if c == b'+' {
            1
        } else {
            return c != 0;
        };
        i += 1;
        let h = gd(b, i, 2, 0, 14, b':');
        let m = if h < 0 { -1 } else { gd(b, i + 3, 2, 0, 59, 0) };
        if m < 0 {
            return true;
        }
        i += 5;
        p.tz = sgn * (m + h * 60);
    }
    while is_c_space(byte_at(b, i)) {
        i += 1;
    }
    p.tz_set = true;
    byte_at(b, i) != 0
}

fn parse_hms(b: ref Vec[u8], at: i64, p: mut ref Dt) -> bool {
    let h = gd(b, at, 2, 0, 24, b':');
    let m = if h < 0 { -1 } else { gd(b, at + 3, 2, 0, 59, 0) };
    if m < 0 {
        return true;
    }
    let mut i = at + 5;
    let mut s: i64 = 0;
    let mut ms = 0.0;
    if byte_at(b, i) == b':' {
        i += 1;
        s = gd(b, i, 2, 0, 59, 0);
        if s < 0 {
            return true;
        }
        i += 2;
        if byte_at(b, i) == b'.' and is_digit(byte_at(b, i + 1)) {
            let mut scale = 1.0;
            i += 1;
            while is_digit(byte_at(b, i)) {
                ms = ms * 10.0 + (byte_at(b, i) - b'0') as f64;
                scale *= 10.0;
                i += 1;
            }
            ms /= scale;
        }
    }
    p.valid_jd = false;
    p.raw_s = false;
    p.valid_hms = true;
    p.h = h;
    p.mi = m;
    p.s = s as f64 + ms;
    if parse_tz(b, i, mut p) {
        return true;
    }
    p.valid_tz = p.tz != 0;
    false
}

fn compute_jd(p: mut ref Dt) {
    if p.valid_jd {
        return;
    }
    let mut y: i64 = 2000;
    let mut m: i64 = 1;
    let mut d: i64 = 1;
    if p.valid_ymd {
        y = p.y;
        m = p.mo;
        d = p.d;
    }
    if y < -4713 or y > 9999 or p.raw_s {
        dt_error(mut p);
        return;
    }
    if m <= 2 {
        y -= 1;
        m += 12;
    }
    let a = y / 100;
    let bb = 2 - a + a / 4;
    let x1 = 36525 * (y + 4716) / 100;
    let x2 = 306001 * (m + 1) / 10000;
    p.ijd = (((x1 + x2 + d + bb) as f64 - 1524.5) * 86400000.0) as i64;
    p.valid_jd = true;
    if p.valid_hms {
        p.ijd += p.h * 3600000 + p.mi * 60000 + (p.s * 1000.0 + 0.5) as i64;
        if p.valid_tz {
            p.ijd -= p.tz * 60000;
            p.valid_ymd = false;
            p.valid_hms = false;
            p.valid_tz = false;
        }
    }
}

fn valid_julian(ijd: i64) -> bool {
    ijd >= 0 and ijd <= 464269060799999
}

fn parse_ymd(b: ref Vec[u8], p: mut ref Dt) -> bool {
    let mut i: i64 = 0;
    let neg = byte_at(b, 0) == b'-';
    if neg {
        i = 1;
    }
    let y = gd(b, i, 4, 0, 14712, b'-');
    let m = if y < 0 { -1 } else { gd(b, i + 5, 2, 1, 12, b'-') };
    let d = if m < 0 { -1 } else { gd(b, i + 8, 2, 1, 31, 0) };
    if d < 0 {
        return true;
    }
    i += 10;
    while is_c_space(byte_at(b, i)) or byte_at(b, i) == b'T' {
        i += 1;
    }
    if not parse_hms(b, i, mut p) {
        // the time came too
    } else if byte_at(b, i) == 0 {
        p.valid_hms = false;
    } else {
        return true;
    }
    p.valid_jd = false;
    p.valid_ymd = true;
    p.y = if neg { -y } else { y };
    p.mo = m;
    p.d = d;
    if p.valid_tz {
        compute_jd(mut p);
    }
    false
}

fn set_raw(p: mut ref Dt, r: f64) {
    p.s = r;
    p.raw_s = true;
    if r >= 0.0 and r < 5373484.5 {
        p.ijd = (r * 86400000.0 + 0.5) as i64;
        p.valid_jd = true;
    }
}

fn parse_date_or_time(z: Str, p: mut ref Dt) -> bool {
    let b = to_bytes(z);
    if not parse_ymd(b, mut p) {
        return false;
    }
    if not parse_hms(b, 0, mut p) {
        return false;
    }
    let (r, rc) = atof(b);
    if rc > 0 {
        set_raw(mut p, r);
        return false;
    }
    true
}

fn compute_ymd(p: mut ref Dt) {
    if p.valid_ymd {
        return;
    }
    if not p.valid_jd {
        p.y = 2000;
        p.mo = 1;
        p.d = 1;
    } else if not valid_julian(p.ijd) {
        dt_error(mut p);
        return;
    } else {
        let z = (p.ijd + 43200000) / 86400000;
        let a0 = ((z as f64 - 1867216.25) / 36524.25) as i64;
        let a = z + 1 + a0 - a0 / 4;
        let bb = a + 1524;
        let c = ((bb as f64 - 122.1) / 365.25) as i64;
        let d = (36525 * (c & 32767)) / 100;
        let e = ((bb - d) as f64 / 30.6001) as i64;
        let x1 = (30.6001 * e as f64) as i64;
        p.d = bb - d - x1;
        p.mo = if e < 14 { e - 1 } else { e - 13 };
        p.y = if p.mo > 2 { c - 4716 } else { c - 4715 };
    }
    p.valid_ymd = true;
}

fn compute_hms(p: mut ref Dt) {
    if p.valid_hms {
        return;
    }
    compute_jd(mut p);
    let day_ms = (p.ijd + 43200000) % 86400000;
    p.s = (day_ms % 60000) as f64 / 1000.0;
    let day_min = day_ms / 60000;
    p.mi = day_min % 60;
    p.h = day_min / 60;
    p.raw_s = false;
    p.valid_hms = true;
}

fn compute_ymd_hms(p: mut ref Dt) {
    compute_ymd(mut p);
    compute_hms(mut p);
}

fn clear_ymd_hms_tz(p: mut ref Dt) {
    p.valid_ymd = false;
    p.valid_hms = false;
    p.valid_tz = false;
}

fn starts_ieq(z: ref Vec[u8], pre: Str) -> bool {
    let pb = to_bytes(pre);
    if z.len() < pb.len() {
        return false;
    }
    for k in 0..pb.len() {
        if lower_byte(z[k]) != lower_byte(pb[k]) {
            return false;
        }
    }
    true
}

// parseModifier: true when the modifier is not one SQLite accepts here.
fn parse_modifier(z: Str, p: mut ref Dt, idx: i64) -> bool {
    let b = to_bytes(z);
    let c0 = lower_byte(byte_at(b, 0));
    if c0 == b'a' {
        if ieq(z, "auto") {
            if idx > 1 {
                return true;
            }
            if not p.raw_s or p.valid_jd {
                p.raw_s = false;
                return false;
            }
            if p.s >= -210866760000.0 and p.s <= 253402300799.0 {
                let r = p.s * 1000.0 + 210866760000000.0;
                clear_ymd_hms_tz(mut p);
                p.ijd = (r + 0.5) as i64;
                p.valid_jd = true;
                p.raw_s = false;
                return false;
            }
        }
        return true;
    }
    if c0 == b'j' {
        if ieq(z, "julianday") {
            if idx > 1 {
                return true;
            }
            if p.valid_jd and p.raw_s {
                p.raw_s = false;
                return false;
            }
        }
        return true;
    }
    if c0 == b'u' {
        if ieq(z, "unixepoch") and p.raw_s {
            if idx > 1 {
                return true;
            }
            let r = p.s * 1000.0 + 210866760000000.0;
            if r >= 0.0 and r < 464269060800000.0 {
                clear_ymd_hms_tz(mut p);
                p.ijd = (r + 0.5) as i64;
                p.valid_jd = true;
                p.raw_s = false;
                return false;
            }
        }
        return true;
    }
    if c0 == b'w' {
        if starts_ieq(b, "weekday ") {
            let rest = sub_bytes(b, 8, b.len());
            let (r, rc) = atof(rest);
            if rc > 0 and r >= 0.0 and r < 7.0 and (r as i64) as f64 == r {
                let n = r as i64;
                compute_ymd_hms(mut p);
                p.valid_tz = false;
                p.valid_jd = false;
                compute_jd(mut p);
                let mut zz = ((p.ijd + 129600000) / 86400000) % 7;
                if zz > n {
                    zz -= 7;
                }
                p.ijd += (n - zz) * 86400000;
                clear_ymd_hms_tz(mut p);
                return false;
            }
        }
        return true;
    }
    if c0 == b's' {
        if not starts_ieq(b, "start of ") {
            if ieq(z, "subsec") or ieq(z, "subsecond") {
                p.use_subsec = true;
                return false;
            }
            return true;
        }
        if not p.valid_jd and not p.valid_ymd and not p.valid_hms {
            return true;
        }
        let what = byte_str(b, 9, b.len());
        compute_ymd(mut p);
        p.valid_hms = true;
        p.h = 0;
        p.mi = 0;
        p.s = 0.0;
        p.raw_s = false;
        p.valid_tz = false;
        p.valid_jd = false;
        if ieq(what, "month") {
            p.d = 1;
            return false;
        }
        if ieq(what, "year") {
            p.mo = 1;
            p.d = 1;
            return false;
        }
        return not ieq(what, "day");
    }
    if c0 == b'+' or c0 == b'-' or is_digit(c0) {
        return parse_shift(b, mut p);
    }
    true
}

// The modifiers that start with a sign or a digit: ±YYYY-MM-DD,
// ±HH:MM[:SS.SSS] and "NNN units".
fn parse_shift(b: ref Vec[u8], p: mut ref Dt) -> bool {
    let z0 = b[0];
    let mut n: i64 = 1;
    while n < b.len() {
        let c = b[n];
        if c == b':' or is_c_space(c) {
            break;
        }
        if c == b'-' {
            if n == 5 and gd(b, 1, 4, 0, 14712, 0) >= 0 {
                break;
            }
            if n == 6 and gd(b, 1, 5, 0, 14712, 0) >= 0 {
                break;
            }
        }
        n += 1;
    }
    let (r0, rc) = atof(sub_bytes(b, 0, n));
    if rc <= 0 {
        return true;
    }
    let mut r = r0;
    let mut z2: i64 = 0;
    if byte_at(b, n) == b'-' {
        if z0 != b'+' and z0 != b'-' {
            return true;
        }
        let base: i64 = if n == 5 { 0 } else { 1 };
        let yy = gd(b, 1, 4 + base, 0, 14712, b'-');
        let mm = if yy < 0 { -1 } else { gd(b, 6 + base, 2, 0, 12, b'-') };
        let mut dd = if mm < 0 { -1 } else { gd(b, 9 + base, 2, 0, 31, 0) };
        if dd < 0 or mm >= 12 or dd >= 31 {
            return true;
        }
        compute_ymd_hms(mut p);
        p.valid_jd = false;
        if z0 == b'-' {
            p.y -= yy;
            p.mo -= mm;
            dd = -dd;
        } else {
            p.y += yy;
            p.mo += mm;
        }
        let x = if p.mo > 0 { (p.mo - 1) / 12 } else { (p.mo - 12) / 12 };
        p.y += x;
        p.mo -= x * 12;
        compute_jd(mut p);
        p.valid_hms = false;
        p.valid_ymd = false;
        p.ijd += dd * 86400000;
        let at = base + 11;
        if byte_at(b, at) == 0 {
            return false;
        }
        if is_c_space(byte_at(b, at)) and gd(b, at + 1, 2, 0, 24, b':') >= 0 and gd(b, at + 4, 2, 0, 59, 0) >= 0 {
            z2 = at + 1;
            n = 2;
        } else {
            return true;
        }
    }
    if byte_at(b, z2 + n) == b':' {
        let mut start = z2;
        if not is_digit(byte_at(b, start)) {
            start += 1;
        }
        let mut tx = dt_zero();
        if parse_hms(b, start, mut tx) {
            return true;
        }
        compute_jd(mut tx);
        tx.ijd -= 43200000;
        let day = tx.ijd / 86400000;
        tx.ijd -= day * 86400000;
        if z0 == b'-' {
            tx.ijd = -tx.ijd;
        }
        compute_jd(mut p);
        clear_ymd_hms_tz(mut p);
        p.ijd += tx.ijd;
        return false;
    }
    let mut i = n;
    while is_c_space(byte_at(b, i)) {
        i += 1;
    }
    let unit = sub_bytes(b, i, b.len());
    let mut un = unit.len();
    if un > 10 or un < 3 {
        return true;
    }
    if lower_byte(unit[un - 1]) == b's' {
        un -= 1;
    }
    compute_jd(mut p);
    let rounder = if r < 0.0 { -0.5 } else { 0.5 };
    let names = ["second", "minute", "hour", "day", "month", "year"];
    let limits = [4.6427e+14, 7.7379e+12, 1.2897e+11, 5373485.0, 176546.0, 14713.0];
    let xforms = [1.0, 60.0, 3600.0, 86400.0, 2592000.0, 31536000.0];
    let mut rc2 = true;
    for k in 0..6 {
        let nm = to_bytes(names[k]);
        if nm.len() == un and starts_ieq(unit, names[k]) and r > -limits[k] and r < limits[k] {
            if k == 4 {
                compute_ymd_hms(mut p);
                p.mo += r as i64;
                let x = if p.mo > 0 { (p.mo - 1) / 12 } else { (p.mo - 12) / 12 };
                p.y += x;
                p.mo -= x * 12;
                p.valid_jd = false;
                r -= (r as i64) as f64;
            } else if k == 5 {
                let yy = r as i64;
                compute_ymd_hms(mut p);
                p.y += yy;
                p.valid_jd = false;
                r -= yy as f64;
            }
            compute_jd(mut p);
            p.ijd += (r * 1000.0 * xforms[k] + rounder) as i64;
            rc2 = false;
            break;
        }
    }
    clear_ymd_hms_tz(mut p);
    rc2
}

// isDate: the date the arguments name, or None for NULL.
fn is_date(args: ref Vec[V], enc: i64) -> Option[Dt] {
    let mut p = dt_zero();
    if args.len() == 0 {
        return None;
    }
    match args[0] {
        V.Int(_) => set_raw(mut p, real_value(args[0])),
        V.Real(_) => set_raw(mut p, real_value(args[0])),
        _ => {
            match value_text(args[0], enc) {
                None => return None,
                Some(t) => {
                    if parse_date_or_time(t, mut p) {
                        return None;
                    }
                }
            }
        }
    }
    for i in 1..args.len() {
        match value_text(args[i], enc) {
            None => return None,
            Some(t) => {
                if parse_modifier(t, mut p, i) {
                    return None;
                }
            }
        }
    }
    compute_jd(mut p);
    if p.is_error or not valid_julian(p.ijd) {
        return None;
    }
    if args.len() == 1 and p.valid_ymd and p.d > 28 {
        p.valid_ymd = false;
    }
    Some(p)
}

fn zpad(v: i64, w: i64) -> String {
    let mut s = (if v < 0 { -v } else { v }).to_string();
    while s.len() < w {
        s = f"0{s}";
    }
    if v < 0 {
        s = f"-{s}";
    }
    s
}

fn spad(v: i64, w: i64) -> String {
    let mut s = v.to_string();
    while s.len() < w {
        s = f" {s}";
    }
    s
}

fn ymd_text(p: ref Dt) -> String {
    let y = if p.y < 0 { -p.y } else { p.y };
    let mut s = f"{zpad(y % 10000, 4)}-{zpad(p.mo, 2)}-{zpad(p.d, 2)}";
    if p.y < 0 {
        s = f"-{s}";
    }
    s
}

fn hms_text(p: ref Dt) -> String {
    let mut s = f"{zpad(p.h, 2)}:{zpad(p.mi, 2)}:";
    if p.use_subsec {
        let ms = (1000.0 * p.s + 0.5) as i64;
        s.push_str(f"{(ms / 10000) % 10}{(ms / 1000) % 10}.{(ms / 100) % 10}{(ms / 10) % 10}{ms % 10}");
    } else {
        let sec = p.s as i64;
        s.push_str(f"{(sec / 10) % 10}{sec % 10}");
    }
    s
}

fn date_func(name: Str, args: ref Vec[V], enc: i64) -> V {
    if name == "strftime" {
        if args.len() == 0 {
            return V.Null;
        }
        let fmt = match value_text(args[0], enc) {
            None => return V.Null,
            Some(t) => t,
        };
        let mut rest: Vec[V] = Vec.new();
        for k in 1..args.len() {
            rest.push(args[k].clone());
        }
        let mut p = match is_date(rest, enc) {
            None => return V.Null,
            Some(d) => d,
        };
        compute_jd(mut p);
        compute_ymd_hms(mut p);
        return match strftime_text(fmt, p) {
            None => V.Null,
            Some(t) => V.Text(t),
        };
    }
    let mut p = match is_date(args, enc) {
        None => return V.Null,
        Some(d) => d,
    };
    if name == "julianday" {
        compute_jd(mut p);
        return V.Real(p.ijd as f64 / 86400000.0);
    }
    if name == "unixepoch" {
        compute_jd(mut p);
        if p.use_subsec {
            return V.Real((p.ijd - 210866760000000) as f64 / 1000.0);
        }
        return V.Int(p.ijd / 1000 - 210866760000);
    }
    compute_ymd_hms(mut p);
    if name == "date" {
        return V.Text(ymd_text(p));
    }
    if name == "time" {
        return V.Text(hms_text(p));
    }
    V.Text(f"{ymd_text(p)} {hms_text(p)}")
}

fn strftime_text(fmt: Str, x: ref Dt) -> Option[String] {
    let b = to_bytes(fmt);
    let mut out = String.new();
    let mut i: i64 = 0;
    let mut lit: Vec[u8] = Vec.new();
    while i < b.len() {
        if b[i] != b'%' {
            lit.push(b[i]);
            i += 1;
            continue;
        }
        out.push_str(from_bytes(lit));
        lit = Vec.new();
        let cf = byte_at(b, i + 1);
        i += 2;
        if cf == b'd' {
            out.push_str(zpad(x.d, 2));
        } else if cf == b'e' {
            out.push_str(spad(x.d, 2));
        } else if cf == b'f' {
            let s = if x.s > 59.999 { 59.999 } else { x.s };
            let mut spec = fmt_spec();
            spec.zeropad = true;
            spec.width = 6;
            spec.precision = 3;
            out.push_str(fmt_float(s, b'f', spec));
        } else if cf == b'F' {
            out.push_str(f"{zpad(x.y, 4)}-{zpad(x.mo, 2)}-{zpad(x.d, 2)}");
        } else if cf == b'H' {
            out.push_str(zpad(x.h, 2));
        } else if cf == b'k' {
            out.push_str(spad(x.h, 2));
        } else if cf == b'I' or cf == b'l' {
            let mut h = x.h;
            if h > 12 {
                h -= 12;
            }
            if h == 0 {
                h = 12;
            }
            out.push_str(if cf == b'I' { zpad(h, 2) } else { spad(h, 2) });
        } else if cf == b'W' or cf == b'j' {
            let mut y = x.clone();
            y.valid_jd = false;
            y.mo = 1;
            y.d = 1;
            compute_jd(mut y);
            let nday = (x.ijd - y.ijd + 43200000) / 86400000;
            if cf == b'W' {
                let wd = ((x.ijd + 43200000) / 86400000) % 7;
                out.push_str(zpad((nday + 7 - wd) / 7, 2));
            } else {
                out.push_str(zpad(nday + 1, 3));
            }
        } else if cf == b'J' {
            let mut spec = fmt_spec();
            spec.precision = 16;
            out.push_str(fmt_float(x.ijd as f64 / 86400000.0, b'g', spec));
        } else if cf == b'm' {
            out.push_str(zpad(x.mo, 2));
        } else if cf == b'M' {
            out.push_str(zpad(x.mi, 2));
        } else if cf == b'p' or cf == b'P' {
            let pm = x.h >= 12;
            out.push_str(if cf == b'p' { if pm { "PM" } else { "AM" } } else { if pm { "pm" } else { "am" } });
        } else if cf == b'R' {
            out.push_str(f"{zpad(x.h, 2)}:{zpad(x.mi, 2)}");
        } else if cf == b's' {
            if x.use_subsec {
                let mut spec = fmt_spec();
                spec.precision = 3;
                out.push_str(fmt_float((x.ijd - 210866760000000) as f64 / 1000.0, b'f', spec));
            } else {
                out.push_str((x.ijd / 1000 - 210866760000).to_string());
            }
        } else if cf == b'S' {
            out.push_str(zpad(x.s as i64, 2));
        } else if cf == b'T' {
            out.push_str(f"{zpad(x.h, 2)}:{zpad(x.mi, 2)}:{zpad(x.s as i64, 2)}");
        } else if cf == b'u' or cf == b'w' {
            let mut c = ((x.ijd + 129600000) / 86400000) % 7;
            if c == 0 and cf == b'u' {
                c = 7;
            }
            out.push_str(c.to_string());
        } else if cf == b'Y' {
            out.push_str(zpad(x.y, 4));
        } else if cf == b'%' {
            out.push_str("%");
        } else {
            return None;
        }
    }
    out.push_str(from_bytes(lit));
    Some(out)
}
// ------------------------------------------------------------ sorting

// One sort term: its direction, where NULLs go (0 the default, 1 first,
// 2 last) and its collation.
#[derive(Clone)]
struct SortKey {
    desc: bool,
    nulls: i64,
    coll: i64,
}

fn key_cmp(a: ref Vec[V], b: ref Vec[V], ks: ref Vec[SortKey], enc: i64) -> i64 {
    for k in 0..ks.len() {
        let xn = is_null(a[k]);
        let yn = is_null(b[k]);
        if xn or yn {
            if xn and yn {
                continue;
            }
            let nulls_first = if ks[k].nulls == 1 { true } else if ks[k].nulls == 2 { false } else { not ks[k].desc };
            return if xn == nulls_first { -1 } else { 1 };
        }
        let c = mem_compare(a[k], b[k], ks[k].coll, enc);
        if c != 0 {
            return if ks[k].desc { -c } else { c };
        }
    }
    0
}

// A stable merge sort: the order the rows' keys put them in, ties kept
// in the order they came.
fn stable_order(keys: ref Vec[Vec[V]], ks: ref Vec[SortKey], enc: i64) -> Vec[i64] {
    let n = keys.len();
    let mut idx: Vec[i64] = Vec.new();
    for i in 0..n {
        idx.push(i);
    }
    let mut width: i64 = 1;
    while width < n {
        let mut tmp: Vec[i64] = Vec.new();
        let mut lo: i64 = 0;
        while lo < n {
            let mid = if lo + width < n { lo + width } else { n };
            let hi = if lo + 2 * width < n { lo + 2 * width } else { n };
            let mut i = lo;
            let mut j = mid;
            while i < mid and j < hi {
                if key_cmp(keys[idx[i]], keys[idx[j]], ks, enc) <= 0 {
                    tmp.push(idx[i]);
                    i += 1;
                } else {
                    tmp.push(idx[j]);
                    j += 1;
                }
            }
            while i < mid {
                tmp.push(idx[i]);
                i += 1;
            }
            while j < hi {
                tmp.push(idx[j]);
                j += 1;
            }
            lo = hi;
        }
        idx = tmp;
        width *= 2;
    }
    idx
}

fn same_key(a: ref Vec[V], b: ref Vec[V], ks: ref Vec[SortKey], enc: i64) -> bool {
    key_cmp(a, b, ks, enc) == 0
}

// ------------------------------------------------------------ aggregates

// An aggregate's running state: SumCtx, the min/max best, the
// group_concat text and the values a DISTINCT aggregate has seen.
#[derive(Clone)]
struct Acc {
    cnt: i64,
    isum: i64,
    rsum: f64,
    rerr: f64,
    approx: bool,
    ovrfl: bool,
    best: V,
    has_best: bool,
    text: String,
    any: bool,
    seen: Vec[V],
}

fn new_acc() -> Acc {
    Acc {
        cnt: 0,
        isum: 0,
        rsum: 0.0,
        rerr: 0.0,
        approx: false,
        ovrfl: false,
        best: V.Null,
        has_best: false,
        text: String.new(),
        any: false,
        seen: Vec.new(),
    }
}

fn kbn_step(a: mut ref Acc, r: f64) {
    let s = a.rsum;
    let t = s + r;
    let abs_s = if s < 0.0 { -s } else { s };
    let abs_r = if r < 0.0 { -r } else { r };
    if abs_s > abs_r {
        a.rerr += (s - t) + r;
    } else {
        a.rerr += (r - t) + s;
    }
    a.rsum = t;
}

fn kbn_step_int(a: mut ref Acc, v: i64) {
    if v <= -4503599627370496 or v >= 4503599627370496 {
        let sm = v % 16384;
        kbn_step(mut a, (v - sm) as f64);
        kbn_step(mut a, sm as f64);
    } else {
        kbn_step(mut a, v as f64);
    }
}

fn kbn_init(a: mut ref Acc, v: i64) {
    if v <= -4503599627370496 or v >= 4503599627370496 {
        let sm = v % 16384;
        a.rsum = (v - sm) as f64;
        a.rerr = sm as f64;
    } else {
        a.rsum = v as f64;
        a.rerr = 0.0;
    }
}

fn sum_step(a: mut ref Acc, v0: ref V) {
    let v = apply_numeric(v0, false);
    if is_null(v) {
        return;
    }
    a.cnt += 1;
    let is_int = match v {
        V.Int(_) => true,
        _ => false,
    };
    if not a.approx {
        if not is_int {
            kbn_init(mut a, a.isum);
            a.approx = true;
            kbn_step(mut a, real_value(v));
        } else {
            let i = int_value(v);
            match a.isum.checked_add(i) {
                Some(x) => a.isum = x,
                None => {
                    a.ovrfl = true;
                    kbn_init(mut a, a.isum);
                    a.approx = true;
                    kbn_step_int(mut a, i);
                }
            }
        }
    } else if is_int {
        kbn_step_int(mut a, int_value(v));
    } else {
        a.ovrfl = false;
        kbn_step(mut a, real_value(v));
    }
}

fn sum_inverse(a: mut ref Acc, v0: ref V) {
    let v = apply_numeric(v0, false);
    if is_null(v) {
        return;
    }
    a.cnt -= 1;
    let is_int = match v {
        V.Int(_) => true,
        _ => false,
    };
    if not a.approx {
        a.isum = a.isum.wrapping_sub(int_value(v));
    } else if is_int {
        let i = int_value(v);
        if i != I64_MIN {
            kbn_step_int(mut a, -i);
        } else {
            kbn_step_int(mut a, I64_MAX);
            kbn_step_int(mut a, 1);
        }
    } else {
        kbn_step(mut a, -real_value(v));
    }
}

fn sum_real(a: ref Acc) -> f64 {
    if a.approx {
        if a.rerr.is_finite() { a.rsum + a.rerr } else { a.rsum }
    } else {
        a.isum as f64
    }
}

fn is_minmax(name: Str) -> bool {
    name == "min" or name == "max"
}

// One step of an aggregate; true when a min() or max() kept its best
// (sqlite3SkipAccumulatorLoad).
fn agg_step(a: mut ref Acc, name: Str, args: ref Vec[V], star: bool, coll: i64, enc: i64) -> bool {
    if name == "count" {
        if star or args.len() == 0 or not is_null(args[0]) {
            a.cnt += 1;
        }
        return false;
    }
    if name == "sum" or name == "total" or name == "avg" {
        sum_step(mut a, args[0]);
        return false;
    }
    if is_minmax(name) {
        if is_null(args[0]) {
            return a.has_best;
        }
        if not a.has_best {
            a.best = args[0].clone();
            a.has_best = true;
            return false;
        }
        let c = mem_compare(a.best, args[0], coll, enc);
        if (name == "max" and c < 0) or (name == "min" and c > 0) {
            a.best = args[0].clone();
            return false;
        }
        return true;
    }
    // group_concat and string_agg
    if is_null(args[0]) {
        return false;
    }
    if a.any {
        if args.len() == 2 {
            if let Some(sep) = value_text(args[1], enc) {
                a.text.push_str(sep);
            }
        } else {
            a.text.push_str(",");
        }
    }
    a.text.push_str(value_text(args[0], enc).unwrap());
    a.any = true;
    false
}

fn agg_inverse(a: mut ref Acc, name: Str, args: ref Vec[V], star: bool) {
    if name == "count" {
        if star or args.len() == 0 or not is_null(args[0]) {
            a.cnt -= 1;
        }
    } else {
        sum_inverse(mut a, args[0]);
    }
}

fn agg_final(a: ref Acc, name: Str) -> Result[V, String] {
    if name == "count" {
        return Ok(V.Int(a.cnt));
    }
    if name == "sum" {
        if a.cnt == 0 {
            return Ok(V.Null);
        }
        if a.approx {
            if a.ovrfl {
                return Err("integer overflow".to_string());
            }
            return Ok(V.Real(sum_real(a)));
        }
        return Ok(V.Int(a.isum));
    }
    if name == "total" {
        return Ok(V.Real(sum_real(a)));
    }
    if name == "avg" {
        if a.cnt == 0 {
            return Ok(V.Null);
        }
        return Ok(V.Real(sum_real(a) / a.cnt as f64));
    }
    if is_minmax(name) {
        return Ok(if a.has_best { a.best.clone() } else { V.Null });
    }
    Ok(if a.any { V.Text(a.text.clone()) } else { V.Null })
}

// Feeds one row to an aggregate expression: its FILTER, its DISTINCT
// and its arguments. Some(skipped) when the step ran.
fn agg_feed(env: ref Env, q: ref Q, ae: i64, acc: mut ref Acc, f: ref Frame, outer: ref Vec[Frame]) -> Result[Option[bool], String] {
    let x = ref q.exprs[ae];
    if x.filter >= 0 {
        let v = eval(env, q, x.filter, f, outer)?;
        if is_null(v) or not bool_value(v) {
            return Ok(None);
        }
    }
    let mut args: Vec[V] = Vec.new();
    for a in x.list {
        args.push(eval(env, q, a, f, outer)?);
    }
    if x.neg and args.len() > 0 {
        if is_null(args[0]) {
            return Ok(None);
        }
        for s in acc.seen {
            if mem_compare(s, args[0], x.coll, env.db.enc) == 0 {
                return Ok(None);
            }
        }
        acc.seen.push(args[0].clone());
    }
    Ok(Some(agg_step(mut acc, x.text, args, x.star, x.coll, env.db.enc)))
}

// ------------------------------------------------------------ selects

fn null_row(n: i64) -> Vec[V] {
    let mut r: Vec[V] = Vec.new();
    for _ in 0..n {
        r.push(V.Null);
    }
    r
}

fn truthy(v: ref V) -> bool {
    not is_null(v) and bool_value(v)
}

// The rows a FROM source that is not a base table yields.
fn run_source(env: ref Env, q: ref Q, s: ref Src, outer: ref Vec[Frame]) -> Result[Vec[Vec[V]], String] {
    if s.table >= 0 {
        return Ok(Vec.new());
    }
    run_select(env, q, s.run, outer)
}

// Nested loops over the sources in FROM order; each combination that
// passes ON and WHERE is pushed to out.
fn join_from(env: ref Env, q: ref Q, c: i64, k: i64, ext: ref Vec[Vec[Vec[V]]], fr: mut ref Frame, outer: ref Vec[Frame], out: mut ref Vec[Vec[V]]) -> Result[(), String] {
    let core = ref q.cores[c];
    if k == core.srcs.len() {
        if core.where_e >= 0 {
            let v = eval(env, q, core.where_e, fr, outer)?;
            if not truthy(v) {
                return Ok(());
            }
        }
        out.push(fr.vals.clone());
        return Ok(());
    }
    let s = ref core.srcs[k];
    let is_table = s.table >= 0;
    let n = if is_table { env.db.tables[s.table].rows.len() } else { ext[k].len() };
    let w = s.cols.len();
    let mut matched = false;
    for i in 0..n {
        for j in 0..w {
            fr.vals[s.off + j] = if is_table { env.db.tables[s.table].rows[i][j].clone() } else { ext[k][i][j].clone() };
        }
        if s.on >= 0 {
            let v = eval(env, q, s.on, fr, outer)?;
            if not truthy(v) {
                continue;
            }
        }
        matched = true;
        join_from(env, q, c, k + 1, ext, mut fr, outer, mut out)?;
    }
    if not matched and s.join == J_LEFT {
        for j in 0..w {
            fr.vals[s.off + j] = V.Null;
        }
        join_from(env, q, c, k + 1, ext, mut fr, outer, mut out)?;
    }
    Ok(())
}

// The frames one core yields before its result columns: one per row, or
// one per group with its aggregates.
fn core_frames(env: ref Env, q: ref Q, c: i64, outer: ref Vec[Frame]) -> Result[Vec[Frame], String] {
    let core = ref q.cores[c];
    let mut ext: Vec[Vec[Vec[V]]] = Vec.new();
    for s in core.srcs {
        ext.push(run_source(env, q, s, outer)?);
    }
    let mut rows: Vec[Vec[V]] = Vec.new();
    let mut fr = frame_of(null_row(core.width));
    join_from(env, q, c, 0, ext, mut fr, outer, mut rows)?;
    let nwin = core.wins.len();
    if not core.is_agg {
        let mut out: Vec[Frame] = Vec.new();
        for r in rows {
            out.push(Frame { vals: r.clone(), aggs: Vec.new(), wins: null_row(nwin) });
        }
        return Ok(out);
    }
    // group the rows: sorted by the GROUP BY keys under their collations
    let ng = core.group.len();
    let mut ks: Vec[SortKey] = Vec.new();
    for g in core.group {
        ks.push(SortKey { desc: false, nulls: 0, coll: nn_coll(expr_coll(q, g)) });
    }
    let mut keys: Vec[Vec[V]] = Vec.new();
    for r in rows {
        let f = frame_of(r.clone());
        let mut k: Vec[V] = Vec.new();
        for g in core.group {
            k.push(eval(env, q, g, f, outer)?);
        }
        keys.push(k);
    }
    let order = if ng > 0 { stable_order(keys, ks, env.db.enc) } else {
        let mut o: Vec[i64] = Vec.new();
        for i in 0..rows.len() {
            o.push(i);
        }
        o
    };
    let mut last_minmax: i64 = -1;
    for k in 0..core.aggs.len() {
        if is_minmax(q.exprs[core.aggs[k]].text) {
            last_minmax = k;
        }
    }
    let mut out: Vec[Frame] = Vec.new();
    let mut i: i64 = 0;
    let n = order.len();
    loop {
        if i >= n and not (ng == 0 and n == 0 and out.len() == 0) {
            break;
        }
        let mut accs: Vec[Acc] = Vec.new();
        for _ in core.aggs {
            accs.push(new_acc());
        }
        let mut bare: Vec[V] = null_row(core.width);
        let mut j = i;
        let mut first = true;
        while j < n and (ng == 0 or same_key(keys[order[i]], keys[order[j]], ks, env.db.enc)) {
            let f = frame_of(rows[order[j]].clone());
            let mut skipped = false;
            for k in 0..core.aggs.len() {
                let r = agg_feed(env, q, core.aggs[k], mut accs[k], f, outer)?;
                if k == last_minmax {
                    if let Some(s) = r {
                        skipped = s;
                    }
                }
            }
            let load = if last_minmax >= 0 { not skipped } else { first };
            if load {
                bare = rows[order[j]].clone();
            }
            first = false;
            j += 1;
        }
        let mut finals: Vec[V] = Vec.new();
        for k in 0..core.aggs.len() {
            finals.push(agg_final(accs[k], q.exprs[core.aggs[k]].text)?);
        }
        let gf = Frame { vals: bare, aggs: finals, wins: null_row(nwin) };
        let keep = if core.having >= 0 { truthy(eval(env, q, core.having, gf, outer)?) } else { true };
        if keep {
            out.push(gf);
        }
        if j == i {
            break;
        }
        i = j;
    }
    Ok(out)
}

// ------------------------------------------------------------ windows

fn ex_equal(q: ref Q, a: i64, b: i64) -> bool {
    if a < 0 or b < 0 {
        return a == b;
    }
    let x = ref q.exprs[a];
    let y = ref q.exprs[b];
    if x.op != y.op or x.sub != y.sub or x.text != y.text or x.qual != y.qual or x.neg != y.neg or x.star != y.star {
        return false;
    }
    if x.op == E_COL and (x.depth != y.depth or x.idx != y.idx) {
        return false;
    }
    if x.list.len() != y.list.len() {
        return false;
    }
    for k in 0..x.list.len() {
        if not ex_equal(q, x.list[k], y.list[k]) {
            return false;
        }
    }
    ex_equal(q, x.a, y.a) and ex_equal(q, x.b, y.b) and ex_equal(q, x.c, y.c) and x.sel == y.sel
}

fn win_equal(q: ref Q, a: ref Win, b: ref Win) -> bool {
    if a.part.len() != b.part.len() or a.order.len() != b.order.len() or a.rows != b.rows or a.start != b.start or a.end != b.end {
        return false;
    }
    for k in 0..a.part.len() {
        if not ex_equal(q, a.part[k], b.part[k]) {
            return false;
        }
    }
    for k in 0..a.order.len() {
        if a.order[k].desc != b.order[k].desc or a.order[k].nulls != b.order[k].nulls or not ex_equal(q, a.order[k].e, b.order[k].e) {
            return false;
        }
    }
    ex_equal(q, a.start_n, b.start_n) and ex_equal(q, a.end_n, b.end_n)
}

fn frame_offset(env: ref Env, q: ref Q, e: i64, f: ref Frame, outer: ref Vec[Frame]) -> Result[i64, String] {
    if e < 0 {
        return Ok(0);
    }
    let v = eval(env, q, e, f, outer)?;
    let n = int_value(v);
    if n < 0 {
        return Err("frame starting offset must be a non-negative integer".to_string());
    }
    Ok(n)
}

// Computes every window function of the core: one window definition at
// a time, the last one first, each a stable sort of the rows as the
// previous one left them.
fn apply_windows(env: ref Env, q: ref Q, c: i64, frames0: own Vec[Frame], outer: ref Vec[Frame]) -> Result[Vec[Frame], String] {
    let core = ref q.cores[c];
    let mut frames = frames0;
    let mut defs: Vec[Vec[i64]] = Vec.new();
    for slot in 0..core.wins.len() {
        let w = ref q.wins[q.exprs[core.wins[slot]].win];
        let mut placed = false;
        for d in 0..defs.len() {
            let w0 = ref q.wins[q.exprs[core.wins[defs[d][0]]].win];
            if win_equal(q, w0, w) {
                defs[d].push(slot);
                placed = true;
                break;
            }
        }
        if not placed {
            defs.push(vec![slot]);
        }
    }
    let enc = env.db.enc;
    let mut d = defs.len() - 1;
    while d >= 0 {
        let w = q.wins[q.exprs[core.wins[defs[d][0]]].win].clone();
        let np = w.part.len();
        let mut ks: Vec[SortKey] = Vec.new();
        for p in w.part {
            ks.push(SortKey { desc: false, nulls: 0, coll: nn_coll(expr_coll(q, p)) });
        }
        let mut oks: Vec[SortKey] = Vec.new();
        for t in w.order {
            let k = SortKey { desc: t.desc, nulls: t.nulls, coll: nn_coll(expr_coll(q, t.e)) };
            ks.push(k.clone());
            oks.push(k);
        }
        let mut keys: Vec[Vec[V]] = Vec.new();
        for f in frames {
            let mut k: Vec[V] = Vec.new();
            for p in w.part {
                k.push(eval(env, q, p, f, outer)?);
            }
            for t in w.order {
                k.push(eval(env, q, t.e, f, outer)?);
            }
            keys.push(k);
        }
        let order = stable_order(keys, ks, enc);
        let mut sorted: Vec[Frame] = Vec.new();
        let mut skeys: Vec[Vec[V]] = Vec.new();
        for i in order {
            sorted.push(frames[i].clone());
            skeys.push(keys[i].clone());
        }
        frames = sorted;
        // the partitions: runs of equal PARTITION BY keys
        let n = frames.len();
        let mut pk: Vec[SortKey] = Vec.new();
        for k in 0..np {
            pk.push(ks[k].clone());
        }
        let mut okeys: Vec[Vec[V]] = Vec.new();
        let mut pkeys: Vec[Vec[V]] = Vec.new();
        for k in skeys {
            let mut a: Vec[V] = Vec.new();
            let mut b: Vec[V] = Vec.new();
            for j in 0..k.len() {
                if j < np {
                    a.push(k[j].clone());
                } else {
                    b.push(k[j].clone());
                }
            }
            pkeys.push(a);
            okeys.push(b);
        }
        let mut lo: i64 = 0;
        while lo < n {
            let mut hi = lo + 1;
            while hi < n and same_key(pkeys[lo], pkeys[hi], pk, enc) {
                hi += 1;
            }
            for slot in defs[d] {
                window_partition(env, q, core.wins[slot], slot, w, mut frames, okeys, oks, lo, hi, outer)?;
            }
            lo = hi;
        }
        d -= 1;
    }
    Ok(frames)
}

// The last row (exclusive) of the peer group row i is in.
fn peer_end(okeys: ref Vec[Vec[V]], oks: ref Vec[SortKey], i: i64, hi: i64, enc: i64) -> i64 {
    let mut j = i + 1;
    while j < hi and same_key(okeys[i], okeys[j], oks, enc) {
        j += 1;
    }
    j
}

fn peer_start(okeys: ref Vec[Vec[V]], oks: ref Vec[SortKey], i: i64, lo: i64, enc: i64) -> i64 {
    let mut j = i;
    while j > lo and same_key(okeys[i], okeys[j - 1], oks, enc) {
        j -= 1;
    }
    j
}

fn window_partition(env: ref Env, q: ref Q, e: i64, slot: i64, w: ref Win, frames: mut ref Vec[Frame], okeys: ref Vec[Vec[V]], oks: ref Vec[SortKey], lo: i64, hi: i64, outer: ref Vec[Frame]) -> Result[(), String] {
    let x = q.exprs[e].clone();
    let name = x.text.clone();
    let enc = env.db.enc;
    let n = hi - lo;
    if name == "row_number" {
        for i in lo..hi {
            frames[i].wins[slot] = V.Int(i - lo + 1);
        }
        return Ok(());
    }
    if name == "rank" or name == "dense_rank" or name == "percent_rank" or name == "cume_dist" {
        let mut dense: i64 = 0;
        let mut i = lo;
        while i < hi {
            let j = if w.order.len() == 0 { hi } else { peer_end(okeys, oks, i, hi, enc) };
            dense += 1;
            for k in i..j {
                frames[k].wins[slot] = if name == "rank" {
                    V.Int(i - lo + 1)
                } else if name == "dense_rank" {
                    V.Int(dense)
                } else if name == "percent_rank" {
                    V.Real(if n > 1 { (i - lo) as f64 / (n - 1) as f64 } else { 0.0 })
                } else {
                    V.Real((j - lo) as f64 / n as f64)
                };
            }
            i = j;
        }
        return Ok(());
    }
    if name == "ntile" {
        let p = int_value(eval(env, q, x.list[0], frames[lo], outer)?);
        if p <= 0 {
            return Err("argument of ntile must be a positive integer".to_string());
        }
        let size = n / p;
        for i in lo..hi {
            let row = i - lo;
            frames[i].wins[slot] = if size == 0 {
                V.Int(row + 1)
            } else {
                let large = n - p * size;
                let small = large * (size + 1);
                if row < small { V.Int(1 + row / (size + 1)) } else { V.Int(1 + large + (row - small) / size) }
            };
        }
        return Ok(());
    }
    if name == "lag" or name == "lead" {
        let mut vals: Vec[V] = Vec.new();
        for i in lo..hi {
            vals.push(eval(env, q, x.list[0], frames[i], outer)?);
        }
        for i in lo..hi {
            let off = if x.list.len() > 1 { int_value(eval(env, q, x.list[1], frames[i], outer)?) } else { 1 };
            let at = if name == "lag" { i - lo - off } else { i - lo + off };
            frames[i].wins[slot] = if at >= 0 and at < n {
                vals[at].clone()
            } else if x.list.len() > 2 {
                eval(env, q, x.list[2], frames[i], outer)?
            } else {
                V.Null
            };
        }
        return Ok(());
    }
    // the frame of row i: [start, end)
    let mut starts: Vec[i64] = Vec.new();
    let mut ends: Vec[i64] = Vec.new();
    for i in lo..hi {
        let f = frames[i].clone();
        let s = if w.start == FB_UNB_PREC {
            lo
        } else if w.start == FB_CURRENT {
            if w.rows { i } else if w.order.len() == 0 { lo } else { peer_start(okeys, oks, i, lo, enc) }
        } else if w.start == FB_PREC {
            let k = frame_offset(env, q, w.start_n, f, outer)?;
            if i - k < lo { lo } else { i - k }
        } else if w.start == FB_FOLL {
            let k = frame_offset(env, q, w.start_n, f, outer)?;
            i + k
        } else {
            hi
        };
        let t = if w.end == FB_UNB_FOLL {
            hi
        } else if w.end == FB_CURRENT {
            if w.rows { i + 1 } else if w.order.len() == 0 { hi } else { peer_end(okeys, oks, i, hi, enc) }
        } else if w.end == FB_PREC {
            let k = frame_offset(env, q, w.end_n, f, outer)?;
            i - k + 1
        } else {
            let k = frame_offset(env, q, w.end_n, f, outer)?;
            if i + k + 1 > hi { hi } else { i + k + 1 }
        };
        starts.push(s);
        ends.push(if t < s { s } else { t });
    }
    if name == "first_value" or name == "last_value" or name == "nth_value" {
        for i in lo..hi {
            let s = starts[i - lo];
            let t = ends[i - lo];
            let at = if name == "first_value" {
                s
            } else if name == "last_value" {
                t - 1
            } else {
                let k = int_value(eval(env, q, x.list[1], frames[i], outer)?);
                if k <= 0 {
                    return Err("second argument to nth_value must be a positive integer".to_string());
                }
                s + k - 1
            };
            frames[i].wins[slot] = if at >= s and at < t { eval(env, q, x.list[0], frames[at], outer)? } else { V.Null };
        }
        return Ok(());
    }
    // an aggregate over the frame
    let mut args: Vec[Vec[V]] = Vec.new();
    for i in lo..hi {
        let mut a: Vec[V] = Vec.new();
        for k in x.list {
            a.push(eval(env, q, k, frames[i], outer)?);
        }
        args.push(a);
    }
    let inverse_ok = name == "count" or name == "sum" or name == "total" or name == "avg";
    let mut incremental = true;
    for i in 1..n {
        if starts[i] < starts[i - 1] or ends[i] < ends[i - 1] {
            incremental = false;
        }
    }
    if not inverse_ok and starts[0] != lo {
        incremental = false;
    }
    for i in 0..n {
        if not inverse_ok and starts[i] != lo {
            incremental = false;
        }
    }
    if x.neg {
        incremental = false;
    }
    if incremental {
        let mut acc = new_acc();
        let mut s = lo;
        let mut t = lo;
        for i in lo..hi {
            while s < starts[i - lo] {
                if s < t {
                    agg_inverse(mut acc, name, args[s - lo], x.star);
                }
                s += 1;
            }
            if t < s {
                t = s;
            }
            while t < ends[i - lo] {
                agg_step(mut acc, name, args[t - lo], x.star, x.coll, enc);
                t += 1;
            }
            frames[i].wins[slot] = agg_final(acc, name)?;
        }
        return Ok(());
    }
    for i in lo..hi {
        let mut acc = new_acc();
        for k in starts[i - lo]..ends[i - lo] {
            let a = ref args[k - lo];
            if x.neg {
                if is_null(a[0]) {
                    continue;
                }
                let mut dup = false;
                for sv in acc.seen {
                    if mem_compare(sv, a[0], x.coll, enc) == 0 {
                        dup = true;
                    }
                }
                if dup {
                    continue;
                }
                acc.seen.push(a[0].clone());
            }
            agg_step(mut acc, name, a, x.star, x.coll, enc);
        }
        frames[i].wins[slot] = agg_final(acc, name)?;
    }
    Ok(())
}

// ------------------------------------------------------------ running a select

// One core's result rows and the keys its ORDER BY sorts them by.
fn run_core(env: ref Env, q: ref Q, c: i64, outer: ref Vec[Frame], with_order: bool) -> Result[(Vec[Vec[V]], Vec[Vec[V]]), String] {
    let mut frames = core_frames(env, q, c, outer)?;
    let core = ref q.cores[c];
    if core.wins.len() > 0 {
        frames = apply_windows(env, q, c, frames, outer)?;
    }
    let mut rows: Vec[Vec[V]] = Vec.new();
    let mut keys: Vec[Vec[V]] = Vec.new();
    for f in frames {
        let mut r: Vec[V] = Vec.new();
        for rc in core.cols {
            r.push(eval(env, q, rc.e, f, outer)?);
        }
        let mut k: Vec[V] = Vec.new();
        if with_order {
            for t in core.order {
                k.push(if t.col >= 0 { r[t.col].clone() } else { eval(env, q, t.e, f, outer)? });
            }
        }
        if core.distinct {
            let mut dup = false;
            for prev in rows {
                if distinct_same(prev, r, core.colls, env.db.enc) {
                    dup = true;
                    break;
                }
            }
            if dup {
                continue;
            }
        }
        rows.push(r);
        keys.push(k);
    }
    Ok((rows, keys))
}

fn distinct_same(a: ref Vec[V], b: ref Vec[V], colls: ref Vec[i64], enc: i64) -> bool {
    for k in 0..a.len() {
        if mem_compare(a[k], b[k], nn_coll(colls[k]), enc) != 0 {
            return false;
        }
    }
    true
}

fn order_keys(q: ref Q, terms: ref Vec[OTerm], colls: ref Vec[i64]) -> Vec[SortKey] {
    let mut ks: Vec[SortKey] = Vec.new();
    for t in terms {
        let c = if t.col >= 0 { colls[t.col] } else { expr_coll(q, t.e) };
        ks.push(SortKey { desc: t.desc, nulls: t.nulls, coll: nn_coll(c) });
    }
    ks
}

// The collations a compound select compares whole rows with.
fn compound_colls(q: ref Q, s: ref Sel) -> Vec[i64] {
    let n = q.cores[s.cores[0]].colls.len();
    let mut out: Vec[i64] = Vec.new();
    for k in 0..n {
        let mut c = COLL_NONE;
        for ci in s.cores {
            if c == COLL_NONE {
                c = q.cores[ci].colls[k];
            }
        }
        out.push(nn_coll(c));
    }
    out
}

fn sorted_distinct(rows: own Vec[Vec[V]], colls: ref Vec[i64], enc: i64) -> Vec[Vec[V]] {
    let mut ks: Vec[SortKey] = Vec.new();
    for c in colls {
        ks.push(SortKey { desc: false, nulls: 0, coll: c });
    }
    let order = stable_order(rows, ks, enc);
    let mut out: Vec[Vec[V]] = Vec.new();
    for i in order {
        if out.len() > 0 and same_key(out[out.len() - 1], rows[i], ks, enc) {
            continue;
        }
        out.push(rows[i].clone());
    }
    out
}

fn contains_row(rows: ref Vec[Vec[V]], r: ref Vec[V], colls: ref Vec[i64], enc: i64) -> bool {
    for x in rows {
        if distinct_same(x, r, colls, enc) {
            return true;
        }
    }
    false
}

fn limit_value(env: ref Env, q: ref Q, e: i64, outer: ref Vec[Frame]) -> Result[i64, String] {
    let v = eval(env, q, e, frame_of(Vec.new()), outer)?;
    let n = apply_numeric(v, true);
    match n {
        V.Int(i) => Ok(i),
        _ => Err("datatype mismatch".to_string()),
    }
}

fn run_select(env: ref Env, q: ref Q, s: i64, outer: ref Vec[Frame]) -> Result[Vec[Vec[V]], String] {
    let sel = ref q.sels[s];
    let enc = env.db.enc;
    let mut rows: Vec[Vec[V]] = Vec.new();
    if sel.cores.len() == 1 {
        let c = sel.cores[0];
        let (r, keys) = run_core(env, q, c, outer, true)?;
        rows = r;
        if q.cores[c].order.len() > 0 {
            let ks = order_keys(q, q.cores[c].order, q.cores[c].colls);
            let order = stable_order(keys, ks, enc);
            let mut sorted: Vec[Vec[V]] = Vec.new();
            for i in order {
                sorted.push(rows[i].clone());
            }
            rows = sorted;
        }
    } else {
        let colls = compound_colls(q, sel);
        let (r0, _) = run_core(env, q, sel.cores[0], outer, false)?;
        rows = r0;
        for k in 1..sel.cores.len() {
            let (r, _) = run_core(env, q, sel.cores[k], outer, false)?;
            let op = sel.ops[k - 1];
            if op == OP_UNION_ALL {
                for x in r {
                    rows.push(x.clone());
                }
            } else if op == OP_UNION {
                for x in r {
                    rows.push(x.clone());
                }
                rows = sorted_distinct(rows, colls, enc);
            } else if op == OP_INTERSECT {
                let mut keep: Vec[Vec[V]] = Vec.new();
                for x in rows {
                    if contains_row(r, x, colls, enc) {
                        keep.push(x.clone());
                    }
                }
                rows = sorted_distinct(keep, colls, enc);
            } else {
                let mut keep: Vec[Vec[V]] = Vec.new();
                for x in rows {
                    if not contains_row(r, x, colls, enc) {
                        keep.push(x.clone());
                    }
                }
                rows = sorted_distinct(keep, colls, enc);
            }
        }
        if sel.order.len() > 0 {
            let ks = order_keys(q, sel.order, colls);
            let mut keys: Vec[Vec[V]] = Vec.new();
            for r in rows {
                let mut k: Vec[V] = Vec.new();
                for t in sel.order {
                    k.push(r[t.col].clone());
                }
                keys.push(k);
            }
            let order = stable_order(keys, ks, enc);
            let mut sorted: Vec[Vec[V]] = Vec.new();
            for i in order {
                sorted.push(rows[i].clone());
            }
            rows = sorted;
        }
    }
    if sel.limit >= 0 {
        let lim = limit_value(env, q, sel.limit, outer)?;
        let off = if sel.offset >= 0 { limit_value(env, q, sel.offset, outer)? } else { 0 };
        let mut out: Vec[Vec[V]] = Vec.new();
        let start = if off < 0 { 0 } else { off };
        for i in start..rows.len() {
            if lim >= 0 and out.len() >= lim {
                break;
            }
            out.push(rows[i].clone());
        }
        rows = out;
    }
    Ok(rows)
}

// ------------------------------------------------------------ statements

// A statement's result: its column names and rows.
#[derive(Clone)]
struct ResultSet {
    names: Vec[String],
    rows: Vec[Vec[V]],
}

// Prepares a statement against the database; the parameters it uses
// are counted in q.
fn prepare_statement(env: mut ref Env, sql: Str, q: mut ref Q) -> Result[Stmt, String] {
    let st = parse_statement(sql, mut q)?;
    if st.kind == S_SELECT {
        prepare_select(mut env, mut q, st.sel, Vec.new(), Vec.new())?;
    }
    Ok(st)
}

fn run_statement(env: ref Env, q: ref Q, st: ref Stmt) -> Result[ResultSet, String] {
    if st.kind == S_PRAGMA {
        let names = vec!["cid".to_string(), "name".to_string(), "type".to_string(), "notnull".to_string(), "dflt_value".to_string(), "pk".to_string()];
        let mut rows: Vec[Vec[V]] = Vec.new();
        if ieq(st.name, "table_info") {
            let ti = find_table(env.db, st.arg);
            if ti > 0 {
                let t = ref env.db.tables[ti];
                for k in 0..t.cols.len() {
                    let c = ref t.cols[k];
                    rows.push(vec![
                        V.Int(k),
                        V.Text(c.name.clone()),
                        V.Text(c.decl.clone()),
                        V.Int(if c.notnull { 1 } else { 0 }),
                        if c.has_dflt { V.Text(c.dflt_text.clone()) } else { V.Null },
                        V.Int(c.pk),
                    ]);
                }
            }
        }
        return Ok(ResultSet { names: names, rows: rows });
    }
    let rows = run_select(env, q, st.sel, Vec.new())?;
    let c = ref q.cores[q.sels[st.sel].cores[0]];
    Ok(ResultSet { names: c.names.clone(), rows: rows })
}
// ------------------------------------------------------------ pandas columns

// A datetime64 column: nanoseconds since the epoch, and the unit its
// dtype names (0 s, 1 ms, 2 us, 3 ns).
#[derive(Clone)]
struct DtCol {
    v: Vec[Option[i64]],
    unit: i64,
}

// A column as pandas holds it after read_sql_query: numpy int64,
// float64, str and object, the nullable Int64, Float64 and string, and
// datetime64.
#[derive(Clone)]
enum Col {
    Int(Vec[i64]),
    Float(Vec[f64]),
    Str(Vec[Option[String]]),
    Obj(Vec[V]),
    NInt(Vec[Option[i64]]),
    NFloat(Vec[Option[f64]]),
    NStr(Vec[Option[String]]),
    Dt(DtCol),
}

const NS_SEC: i64 = 1000000000;
const NS_DAY: i64 = 86400000000000;

fn col_len(c: ref Col) -> i64 {
    match c {
        Col.Int(v) => v.len(),
        Col.Float(v) => v.len(),
        Col.Str(v) => v.len(),
        Col.Obj(v) => v.len(),
        Col.NInt(v) => v.len(),
        Col.NFloat(v) => v.len(),
        Col.NStr(v) => v.len(),
        Col.Dt(d) => d.v.len(),
    }
}

fn dtype_name(c: ref Col) -> String {
    match c {
        Col.Int(_) => "int64".to_string(),
        Col.Float(_) => "float64".to_string(),
        Col.Str(_) => "str".to_string(),
        Col.Obj(_) => "object".to_string(),
        Col.NInt(_) => "Int64".to_string(),
        Col.NFloat(_) => "Float64".to_string(),
        Col.NStr(_) => "string".to_string(),
        Col.Dt(d) => {
            let u = if d.unit == 0 { "s" } else if d.unit == 1 { "ms" } else if d.unit == 2 { "us" } else { "ns" };
            f"datetime64[{u}]"
        },
    }
}

// A value's str() as Python prints it in an object column.
fn py_str(v: ref V) -> String {
    match v {
        V.Null => "None".to_string(),
        V.Int(i) => i.to_string(),
        V.Real(r) => float_repr(r),
        V.Text(s) => s.clone(),
        V.Blob(b) => bytes_repr(b),
    }
}

// The bytes of a blob as UTF-8 text, as bytes.decode() reads them.
fn decode_utf8(b: ref Vec[u8]) -> Result[String, PyErr] {
    let n = b.len();
    let mut i: i64 = 0;
    while i < n {
        let c = b[i];
        let need = if c < 0x80 { 0 } else if c >= 0xc2 and c < 0xe0 { 1 } else if c >= 0xe0 and c < 0xf0 { 2 } else if c >= 0xf0 and c < 0xf5 { 3 } else { -1 };
        if need < 0 {
            return Err(py_err("UnicodeDecodeError", f"'utf-8' codec can't decode byte 0x{hex2(c)} in position {i}: invalid start byte"));
        }
        for k in 1..(need + 1) {
            if i + k >= n or (b[i + k] & 0xc0) != 0x80 {
                return Err(py_err("UnicodeDecodeError", f"'utf-8' codec can't decode byte 0x{hex2(c)} in position {i}: invalid continuation byte"));
            }
        }
        i += need + 1;
    }
    Ok(from_bytes(b.clone()))
}

fn hex2(c: u8) -> String {
    let d = to_bytes(HEX_LOWER);
    from_bytes(vec![d[(c >> 4) as i64], d[(c & 15) as i64]])
}

// maybe_convert_objects and, with dtype_backend=numpy_nullable, the
// masked arrays and StringDtype.
fn infer_col(vals: own Vec[V], nullable: bool) -> Result[Col, PyErr] {
    let mut ints: i64 = 0;
    let mut reals: i64 = 0;
    let mut texts: i64 = 0;
    let mut blobs: i64 = 0;
    let mut nulls: i64 = 0;
    for v in vals {
        match v {
            V.Null => nulls += 1,
            V.Int(_) => ints += 1,
            V.Real(_) => reals += 1,
            V.Text(_) => texts += 1,
            V.Blob(_) => blobs += 1,
        }
    }
    let numeric = texts == 0 and blobs == 0;
    if nullable {
        if numeric and reals == 0 and ints > 0 {
            let mut out: Vec[Option[i64]] = Vec.new();
            for v in vals {
                out.push(match v {
                    V.Int(i) => Some(i),
                    _ => None,
                });
            }
            return Ok(Col.NInt(out));
        }
        if numeric and reals > 0 {
            let mut out: Vec[Option[f64]] = Vec.new();
            for v in vals {
                out.push(match v {
                    V.Int(i) => Some(i as f64),
                    V.Real(r) => Some(r),
                    _ => None,
                });
            }
            return Ok(Col.NFloat(out));
        }
        let mut out: Vec[Option[String]] = Vec.new();
        for v in vals {
            out.push(match v {
                V.Null => None,
                V.Blob(b) => Some(decode_utf8(b)?),
                _ => Some(py_str(v)),
            });
        }
        return Ok(Col.NStr(out));
    }
    if numeric and reals == 0 and nulls == 0 and ints > 0 {
        let mut out: Vec[i64] = Vec.new();
        for v in vals {
            out.push(int_value(v));
        }
        return Ok(Col.Int(out));
    }
    if numeric and (reals > 0 or ints > 0) {
        let mut out: Vec[f64] = Vec.new();
        for v in vals {
            out.push(match v {
                V.Null => nan(),
                _ => real_value(v),
            });
        }
        return Ok(Col.Float(out));
    }
    if ints == 0 and reals == 0 and blobs == 0 and texts > 0 {
        let mut out: Vec[Option[String]] = Vec.new();
        for v in vals {
            out.push(match v {
                V.Text(s) => Some(s.clone()),
                _ => None,
            });
        }
        return Ok(Col.Str(out));
    }
    Ok(Col.Obj(vals))
}

// ------------------------------------------------------------ astype

fn int_cast_error() -> PyErr {
    py_err("IntCastingNaNError", "Cannot convert non-finite values (NA or inf) to integer.Replace or remove non-finite values or cast to an integer typethat supports these values (e.g. 'Int64')")
}

fn nan() -> f64 {
    0.0 / 0.0
}

// float() of a string: a number with optional surrounding spaces.
fn float_of_text(s: Str) -> Result[f64, PyErr] {
    let b = to_bytes(s);
    let mut lo: i64 = 0;
    let mut hi = b.len();
    while lo < hi and is_sql_space(b[lo]) {
        lo += 1;
    }
    while hi > lo and is_sql_space(b[hi - 1]) {
        hi -= 1;
    }
    let t = sub_bytes(b, lo, hi);
    let (x, rc) = atof(t);
    if rc > 0 {
        return Ok(x);
    }
    let low = ascii_lower(from_bytes(t));
    if low == "nan" or low == "+nan" or low == "-nan" {
        return Ok(nan());
    }
    if low == "inf" or low == "+inf" or low == "infinity" or low == "+infinity" {
        return Ok(1.0 / 0.0);
    }
    if low == "-inf" or low == "-infinity" {
        return Ok(-1.0 / 0.0);
    }
    Err(py_err("ValueError", f"could not convert string to float: {py_repr(s)}"))
}

fn as_floats(c: ref Col) -> Result[Vec[Option[f64]], PyErr] {
    let mut out: Vec[Option[f64]] = Vec.new();
    match c {
        Col.Int(v) => {
            for x in v {
                out.push(Some(x as f64));
            }
        }
        Col.Float(v) => {
            for x in v {
                out.push(if x.is_nan() { None } else { Some(x) });
            }
        }
        Col.NInt(v) => {
            for x in v {
                out.push(match x {
                    Some(i) => Some(i as f64),
                    None => None,
                });
            }
        }
        Col.NFloat(v) => {
            for x in v {
                out.push(x);
            }
        }
        Col.Str(v) => {
            for x in v {
                out.push(match x {
                    Some(s) => Some(float_of_text(s)?),
                    None => None,
                });
            }
        }
        Col.NStr(v) => {
            for x in v {
                out.push(match x {
                    Some(s) => Some(float_of_text(s)?),
                    None => None,
                });
            }
        }
        Col.Obj(v) => {
            for x in v {
                out.push(match x {
                    V.Null => None,
                    V.Int(i) => Some(i as f64),
                    V.Real(r) => Some(r),
                    V.Text(s) => Some(float_of_text(s)?),
                    V.Blob(_) => return Err(py_err("TypeError", "float() argument must be a string or a real number, not 'bytes'")),
                });
            }
        }
        Col.Dt(d) => {
            for x in d.v {
                out.push(match x {
                    Some(i) => Some(i as f64),
                    None => None,
                });
            }
        }
    }
    Ok(out)
}

fn as_texts(c: ref Col) -> Vec[Option[String]] {
    let mut out: Vec[Option[String]] = Vec.new();
    let texts = col_texts(c);
    let n = col_len(c);
    for k in 0..n {
        out.push(if cell_is_na(c, k) { None } else { Some(texts[k].clone()) });
    }
    out
}

fn cell_is_na(c: ref Col, k: i64) -> bool {
    match c {
        Col.Int(_) => false,
        Col.Float(v) => v[k].is_nan(),
        Col.Str(v) => v[k].is_none(),
        Col.Obj(v) => is_null(v[k]),
        Col.NInt(v) => v[k].is_none(),
        Col.NFloat(v) => v[k].is_none(),
        Col.NStr(v) => v[k].is_none(),
        Col.Dt(d) => d.v[k].is_none(),
    }
}

// DataFrame.astype for one column.
fn cast_col(c: ref Col, kind: Str) -> Result[Col, PyErr] {
    if kind == "float64" or kind == "float" {
        let fs = as_floats(c)?;
        let mut out: Vec[f64] = Vec.new();
        for x in fs {
            out.push(x.unwrap_or(nan()));
        }
        return Ok(Col.Float(out));
    }
    if kind == "Float64" {
        return Ok(Col.NFloat(as_floats(c)?));
    }
    if kind == "int64" or kind == "int" or kind == "Int64" {
        let nullable = kind == "Int64";
        let mut out: Vec[Option[i64]] = Vec.new();
        match c {
            Col.Int(v) => {
                for x in v {
                    out.push(Some(x));
                }
            }
            Col.NInt(v) => {
                for x in v {
                    out.push(x);
                }
            }
            _ => {
                for x in as_floats(c)? {
                    match x {
                        None => out.push(None),
                        Some(r) => {
                            if not r.is_finite() {
                                return Err(int_cast_error());
                            }
                            if nullable and r != (r as i64) as f64 {
                                return Err(py_err("TypeError", "cannot safely cast non-equivalent float64 to int64"));
                            }
                            out.push(Some(r as i64));
                        }
                    }
                }
            }
        }
        if nullable {
            return Ok(Col.NInt(out));
        }
        let mut plain: Vec[i64] = Vec.new();
        for x in out {
            match x {
                Some(i) => plain.push(i),
                None => return Err(int_cast_error()),
            }
        }
        return Ok(Col.Int(plain));
    }
    if kind == "str" {
        return Ok(Col.Str(as_texts(c)));
    }
    if kind == "string" {
        return Ok(Col.NStr(as_texts(c)));
    }
    if kind == "object" {
        let mut out: Vec[V] = Vec.new();
        let texts = col_texts(c);
        for k in 0..col_len(c) {
            out.push(if cell_is_na(c, k) {
                V.Null
            } else {
                match c {
                    Col.Int(v) => V.Int(v[k]),
                    Col.Float(v) => V.Real(v[k]),
                    Col.NInt(v) => V.Int(v[k].unwrap()),
                    Col.NFloat(v) => V.Real(v[k].unwrap()),
                    Col.Obj(v) => v[k].clone(),
                    _ => V.Text(texts[k].clone()),
                }
            });
        }
        return Ok(Col.Obj(out));
    }
    Err(py_err("TypeError", f"data type {py_repr(kind)} not understood"))
}

// ------------------------------------------------------------ to_datetime

fn unit_ns(uc: i64) -> i64 {
    if uc == 0 { 1000000000 } else if uc == 1 { 1000000 } else if uc == 2 { 1000 } else { 1 }
}

fn unit_code(u: Str) -> i64 {
    if u == "s" { 0 } else if u == "ms" { 1 } else if u == "us" { 2 } else if u == "ns" { 3 } else { -1 }
}

// The formats _guess_datetime_format finds in this data: the date's
// shape, the date-time separator and how much of the time is there.
#[derive(Clone)]
struct DtFmt {
    kind: i64,
    sep: u8,
    time: i64,
}

fn digits_at(b: ref Vec[u8], at: i64, n: i64) -> Option[i64] {
    if at + n > b.len() {
        return None;
    }
    let mut v: i64 = 0;
    for k in 0..n {
        let c = b[at + k];
        if not is_digit(c) {
            return None;
        }
        v = v * 10 + (c - b'0') as i64;
    }
    Some(v)
}

// kind 1 %Y-%m, 2 %Y-%m-%d, 3 %m/%d/%Y; time 0 none, 1 %H:%M, 2 %H:%M:%S,
// 3 %H:%M:%S.%f.
fn guess_format(s: Str) -> Option[DtFmt] {
    let b = to_bytes(s);
    let n = b.len();
    if n == 10 and b[2] == b'/' and b[5] == b'/' and digits_at(b, 0, 2).is_some() and digits_at(b, 3, 2).is_some() and digits_at(b, 6, 4).is_some() {
        return Some(DtFmt { kind: 3, sep: 0, time: 0 });
    }
    if n < 7 or digits_at(b, 0, 4).is_none() or b[4] != b'-' or digits_at(b, 5, 2).is_none() {
        return None;
    }
    if n == 7 {
        return Some(DtFmt { kind: 1, sep: 0, time: 0 });
    }
    if n < 10 or b[7] != b'-' or digits_at(b, 8, 2).is_none() {
        return None;
    }
    if n == 10 {
        return Some(DtFmt { kind: 2, sep: 0, time: 0 });
    }
    let sep = b[10];
    if sep != b' ' and sep != b'T' {
        return None;
    }
    if n < 16 or digits_at(b, 11, 2).is_none() or b[13] != b':' or digits_at(b, 14, 2).is_none() {
        return None;
    }
    if n == 16 {
        return Some(DtFmt { kind: 2, sep: sep, time: 1 });
    }
    if n < 19 or b[16] != b':' or digits_at(b, 17, 2).is_none() {
        return None;
    }
    if n == 19 {
        return Some(DtFmt { kind: 2, sep: sep, time: 2 });
    }
    if b[19] == b'.' and n > 20 and digits_at(b, 20, n - 20).is_some() {
        return Some(DtFmt { kind: 2, sep: sep, time: 3 });
    }
    None
}

fn ymd_ns(y: i64, m: i64, d: i64) -> Option[i64] {
    if m < 1 or m > 12 or d < 1 or d > days_in_month(y, m) {
        return None;
    }
    Some(days_from_civil(y, m, d) * NS_DAY)
}

// A string under the guessed format, exactly; None is NaT.
fn parse_with(f: ref DtFmt, s: Str) -> Option[i64] {
    let b = to_bytes(s);
    let n = b.len();
    if f.kind == 3 {
        if n != 10 or b[2] != b'/' or b[5] != b'/' {
            return None;
        }
        return ymd_ns(digits_at(b, 6, 4)?, digits_at(b, 0, 2)?, digits_at(b, 3, 2)?);
    }
    if n < 7 or b[4] != b'-' {
        return None;
    }
    let y = digits_at(b, 0, 4)?;
    let m = digits_at(b, 5, 2)?;
    if f.kind == 1 {
        return if n == 7 { ymd_ns(y, m, 1) } else { None };
    }
    if n < 10 or b[7] != b'-' {
        return None;
    }
    let base = ymd_ns(y, m, digits_at(b, 8, 2)?)?;
    if f.time == 0 {
        return if n == 10 { Some(base) } else { None };
    }
    if n < 16 or b[10] != f.sep or b[13] != b':' {
        return None;
    }
    let h = digits_at(b, 11, 2)?;
    let mi = digits_at(b, 14, 2)?;
    if h > 23 or mi > 59 {
        return None;
    }
    let mut ns = base + (h * 3600 + mi * 60) * NS_SEC;
    if f.time == 1 {
        return if n == 16 { Some(ns) } else { None };
    }
    if n < 19 or b[16] != b':' {
        return None;
    }
    let sec = digits_at(b, 17, 2)?;
    if sec > 59 {
        return None;
    }
    ns += sec * NS_SEC;
    if f.time == 2 {
        return if n == 19 { Some(ns) } else { None };
    }
    if n < 21 or b[19] != b'.' or n - 20 > 9 {
        return None;
    }
    let frac = digits_at(b, 20, n - 20)?;
    let mut scale: i64 = 1;
    for _ in 0..(9 - (n - 20)) {
        scale *= 10;
    }
    Some(ns + frac * scale)
}

// _handle_date_column: a unit for numbers, a guessed format for text.
fn to_datetime(c: ref Col, fmt: ref Option[String]) -> Result[Col, PyErr] {
    let mut unit_name = match fmt {
        Some(u) => u.clone(),
        None => String.new(),
    };
    let numeric = match c {
        Col.Int(_) => true,
        Col.Float(_) => true,
        Col.NInt(_) => true,
        Col.NFloat(_) => true,
        _ => false,
    };
    if fmt.is_none() and numeric {
        unit_name = "s".to_string();
    }
    let uc = unit_code(unit_name);
    if uc >= 0 {
        let mult = unit_ns(uc);
        let mut out: Vec[Option[i64]] = Vec.new();
        let mut is_float = false;
        match c {
            Col.Int(v) => {
                for x in v {
                    out.push(Some(x * mult));
                }
            }
            Col.NInt(v) => {
                for x in v {
                    out.push(match x {
                        Some(i) => Some(i * mult),
                        None => None,
                    });
                }
            }
            _ => {
                is_float = true;
                for x in as_floats(c)? {
                    out.push(match x {
                        Some(r) => if r.is_finite() { Some((r * mult as f64).round() as i64) } else { None },
                        None => None,
                    });
                }
            }
        }
        return Ok(Col.Dt(DtCol { v: out, unit: if is_float { 3 } else { uc } }));
    }
    if let Col.Dt(d) = c {
        return Ok(Col.Dt(d.clone()));
    }
    let texts = as_texts(c);
    let mut guess: Option[DtFmt] = None;
    let mut all_na = true;
    for t in texts {
        if let Some(s) = t {
            all_na = false;
            if guess.is_none() {
                guess = guess_format(s);
            }
            break;
        }
    }
    if all_na {
        return Ok(Col.Dt(DtCol { v: vec_none(texts.len()), unit: 0 }));
    }
    let mut out: Vec[Option[i64]] = Vec.new();
    for t in texts {
        out.push(match t {
            None => None,
            Some(s) => match guess {
                Some(ref g) => parse_with(g, s),
                None => None,
            },
        });
    }
    Ok(Col.Dt(DtCol { v: out, unit: 2 }))
}

fn vec_none(n: i64) -> Vec[Option[i64]] {
    let mut v: Vec[Option[i64]] = Vec.new();
    for _ in 0..n {
        v.push(None);
    }
    v
}

// ------------------------------------------------------------ printing

fn pad2(v: i64) -> String {
    if v < 10 { f"0{v}" } else { v.to_string() }
}

fn frac_digits(v: i64, n: i64) -> String {
    let mut s = v.to_string();
    while s.len() < n {
        s = f"0{s}";
    }
    s
}

// format_array_from_datetime: dates alone when every value is midnight,
// else seconds and as many fraction digits as the finest value needs.
fn dt_texts(v: ref Vec[Option[i64]]) -> Vec[String] {
    let mut date_only = true;
    let mut need: i64 = 0;
    for x in v {
        if let Some(ns) = x {
            if fmod(ns, NS_DAY) != 0 {
                date_only = false;
            }
            let sub = fmod(ns, NS_SEC);
            if sub % 1000 != 0 {
                need = 9;
            } else if sub % 1000000 != 0 and need < 6 {
                need = 6;
            } else if sub != 0 and need < 3 {
                need = 3;
            }
        }
    }
    let mut out: Vec[String] = Vec.new();
    for x in v {
        match x {
            None => out.push(String.new()),
            Some(ns) => out.push(dt_text(ns, date_only, need)),
        }
    }
    out
}

fn dt_text(ns: i64, date_only: bool, need: i64) -> String {
    let days = fdiv(ns, NS_DAY);
    let rem = ns - days * NS_DAY;
    let (y, m, d) = civil_from_days(days);
    let day = f"{frac_digits(y, 4)}-{pad2(m)}-{pad2(d)}";
    if date_only {
        return day;
    }
    let secs = rem / NS_SEC;
    let sub = rem % NS_SEC;
    let mut t = f"{day} {pad2(secs / 3600)}:{pad2((secs / 60) % 60)}:{pad2(secs % 60)}";
    if need == 9 {
        t.push_str(f".{frac_digits(sub, 9)}");
    } else if need == 6 {
        t.push_str(f".{frac_digits(sub / 1000, 6)}");
    } else if need == 3 {
        t.push_str(f".{frac_digits(sub / 1000000, 3)}");
    }
    t
}

// What to_csv writes for each cell; missing values are empty.
fn col_texts(c: ref Col) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    match c {
        Col.Int(v) => {
            for x in v {
                out.push(x.to_string());
            }
        }
        Col.Float(v) => {
            for x in v {
                out.push(if x.is_nan() { String.new() } else { float_repr(x) });
            }
        }
        Col.Str(v) => {
            for x in v {
                out.push(x.clone().unwrap_or(String.new()));
            }
        }
        Col.NStr(v) => {
            for x in v {
                out.push(x.clone().unwrap_or(String.new()));
            }
        }
        Col.Obj(v) => {
            for x in v {
                out.push(if is_null(x) { String.new() } else { py_str(x) });
            }
        }
        Col.NInt(v) => {
            for x in v {
                out.push(match x {
                    Some(i) => i.to_string(),
                    None => String.new(),
                });
            }
        }
        Col.NFloat(v) => {
            for x in v {
                out.push(match x {
                    Some(r) => float_repr(r),
                    None => String.new(),
                });
            }
        }
        Col.Dt(d) => {
            out = dt_texts(d.v);
        }
    }
    out
}

fn csv_field(s: Str) -> String {
    if has_byte(s, b',') or has_byte(s, b'"') or has_byte(s, b'\n') or has_byte(s, b'\r') {
        f"\"{replace_all(s, "\"", "\"\"")}\""
    } else {
        s.to_string()
    }
}

fn csv_row(fields: ref Vec[String]) -> String {
    if fields.len() == 1 and fields[0].len() == 0 {
        return "\"\"\n".to_string();
    }
    let mut parts: Vec[String] = Vec.new();
    for f in fields {
        parts.push(csv_field(f));
    }
    f"{join(parts, ",")}\n"
}

// ------------------------------------------------------------ frames

// A DataFrame: its columns, and the index (a RangeIndex when idx_names
// is empty).
#[derive(Clone)]
struct Pdf {
    names: Vec[String],
    cols: Vec[Col],
    idx_names: Vec[String],
    idx_cols: Vec[Col],
    nrows: i64,
}

fn slice_col(c: ref Col, from: i64, to: i64) -> Col {
    match c {
        Col.Int(v) => Col.Int(v[from..to].to_vec()),
        Col.Float(v) => Col.Float(v[from..to].to_vec()),
        Col.Str(v) => Col.Str(v[from..to].to_vec()),
        Col.Obj(v) => Col.Obj(v[from..to].to_vec()),
        Col.NInt(v) => Col.NInt(v[from..to].to_vec()),
        Col.NFloat(v) => Col.NFloat(v[from..to].to_vec()),
        Col.NStr(v) => Col.NStr(v[from..to].to_vec()),
        Col.Dt(d) => Col.Dt(DtCol { v: d.v[from..to].to_vec(), unit: d.unit }),
    }
}

// What the oracle's frame() prints: the shape, the index and column
// dtypes, then to_csv of the first `head` rows.
fn frame_text(f: ref Pdf, head: i64) -> String {
    let mut out = f"shape ({f.nrows}, {f.names.len()})\n";
    for k in 0..f.idx_names.len() {
        out.push_str(f"  index {py_repr(f.idx_names[k])}: {dtype_name(f.idx_cols[k])}\n");
    }
    for k in 0..f.names.len() {
        out.push_str(f"  {py_repr(f.names[k])}: {dtype_name(f.cols[k])}\n");
    }
    let n = if head >= 0 and head < f.nrows { head } else { f.nrows };
    let mut header: Vec[String] = Vec.new();
    if f.idx_names.len() == 0 {
        header.push(String.new());
    } else {
        for x in f.idx_names {
            header.push(x.clone());
        }
    }
    for x in f.names {
        header.push(x.clone());
    }
    out.push_str(csv_row(header));
    let mut texts: Vec[Vec[String]] = Vec.new();
    for c in f.idx_cols {
        texts.push(col_texts(slice_col(c, 0, n)));
    }
    for c in f.cols {
        texts.push(col_texts(slice_col(c, 0, n)));
    }
    for r in 0..n {
        let mut row: Vec[String] = Vec.new();
        if f.idx_names.len() == 0 {
            row.push(r.to_string());
        }
        for t in texts {
            row.push(t[r].clone());
        }
        out.push_str(csv_row(row));
    }
    out
}

// ------------------------------------------------------------ read_sql_query

#[derive(Clone)]
struct Opts {
    index_col: Vec[String],
    params: Option[Vec[V]],
    named: Option[Vec[(String, V)]],
    has_dates: bool,
    dates: Vec[(String, Option[String])],
    dtype_all: Option[String],
    dtypes: Vec[(String, String)],
    chunksize: i64,
    head: i64,
    nullable: bool,
    name: String,
    keys: Vec[String],
    if_exists: String,
    index: bool,
    index_label: Option[String],
    sqltypes: Vec[(String, String)],
}

fn new_opts() -> Opts {
    Opts {
        index_col: Vec.new(),
        params: None,
        named: None,
        has_dates: false,
        dates: Vec.new(),
        dtype_all: None,
        dtypes: Vec.new(),
        chunksize: -1,
        head: -1,
        nullable: false,
        name: String.new(),
        keys: Vec.new(),
        if_exists: "fail".to_string(),
        index: true,
        index_label: None,
        sqltypes: Vec.new(),
    }
}

fn db_error(sql: Str, msg: Str) -> PyErr {
    py_err("DatabaseError", f"Execution failed on sql '{sql}': {msg}")
}

// sqlite3's Cursor.execute: prepare, bind the parameters, run.
fn execute(db: ref Db, sql: Str, o: ref Opts) -> Result[ResultSet, PyErr] {
    if db.bad.len() > 0 {
        return Err(db_error(sql, db.bad));
    }
    let mut env = Env { db: db.clone(), params: Vec.new() };
    let mut q = new_q();
    let st = match prepare_statement(mut env, sql, mut q) {
        Ok(s) => s,
        Err(m) => return Err(db_error(sql, m)),
    };
    let need = if q.param_names.len() > q.nparams { q.param_names.len() } else { q.nparams };
    match o.named {
        Some(pairs) => {
            for i in 0..need {
                let pname = if i < q.param_names.len() { q.param_names[i].clone() } else { String.new() };
                if pname.len() == 0 {
                    return Err(db_error(sql, f"Binding {i + 1} has no name, but you supplied a dictionary (which has only names)."));
                }
                let key = byte_str(to_bytes(pname), 1, pname.len());
                let mut found = false;
                for p in pairs {
                    if p.0 == key {
                        env.params.push(p.1.clone());
                        found = true;
                        break;
                    }
                }
                if not found {
                    return Err(db_error(sql, f"You did not supply a value for binding parameter {pname}."));
                }
            }
        }
        None => {
            let given = match o.params {
                Some(ps) => ps.clone(),
                None => Vec.new(),
            };
            if given.len() != need {
                return Err(db_error(sql, f"Incorrect number of bindings supplied. The current statement uses {need}, and there are {given.len()} supplied."));
            }
            env.params = given;
        }
    }
    match run_statement(env, q, st) {
        Ok(r) => Ok(r),
        Err(m) => Err(db_error(sql, m)),
    }
}

fn find_dtype(o: ref Opts, name: Str) -> Option[String] {
    if let Some(t) = o.dtype_all {
        return Some(t.clone());
    }
    for p in o.dtypes {
        if p.0 == name {
            return Some(p.1.clone());
        }
    }
    None
}

// _wrap_result: inference, astype, parse_dates, set_index.
fn wrap_result(names: ref Vec[String], rows: ref Vec[Vec[V]], from: i64, to: i64, o: ref Opts) -> Result[Pdf, PyErr] {
    let mut cols: Vec[Col] = Vec.new();
    let nrows = to - from;
    for k in 0..names.len() {
        if nrows == 0 {
            cols.push(Col.Obj(Vec.new()));
            continue;
        }
        let mut vals: Vec[V] = Vec.new();
        for r in from..to {
            vals.push(rows[r][k].clone());
        }
        cols.push(infer_col(vals, o.nullable)?);
    }
    if o.dtype_all.is_some() or o.dtypes.len() > 0 {
        for k in 0..names.len() {
            if let Some(t) = find_dtype(o, names[k]) {
                cols[k] = match cast_col(cols[k], t) {
                    Ok(c) => c,
                    Err(e) => {
                        if o.dtype_all.is_some() {
                            return Err(e);
                        }
                        return Err(py_err(e.kind, f"{e.msg}: Error while type casting for column {py_repr(names[k])}"));
                    }
                };
            }
        }
    }
    if o.has_dates {
        for k in 0..names.len() {
            for d in o.dates {
                if d.0 == names[k] {
                    cols[k] = to_datetime(cols[k], d.1)?;
                }
            }
        }
    }
    let mut f = Pdf { names: names.clone(), cols: cols, idx_names: Vec.new(), idx_cols: Vec.new(), nrows: nrows };
    if o.index_col.len() > 0 {
        let mut missing: Vec[String] = Vec.new();
        for n in o.index_col {
            if not f.names.contains(n) {
                missing.push(py_repr(n));
            }
        }
        if missing.len() == o.index_col.len() {
            return Err(py_err("KeyError", f"\"None of [{join(missing, ", ")}] are in the columns\""));
        }
        if missing.len() > 0 {
            return Err(py_err("KeyError", f"\"[{join(missing, ", ")}] not in index\""));
        }
        let mut names2: Vec[String] = Vec.new();
        let mut cols2: Vec[Col] = Vec.new();
        for n in o.index_col {
            for k in 0..f.names.len() {
                if f.names[k] == n {
                    f.idx_names.push(n.clone());
                    f.idx_cols.push(f.cols[k].clone());
                    break;
                }
            }
        }
        for k in 0..f.names.len() {
            if not o.index_col.contains(f.names[k]) {
                names2.push(f.names[k].clone());
                cols2.push(f.cols[k].clone());
            }
        }
        f.names = names2;
        f.cols = cols2;
    }
    Ok(f)
}

// read_sql_query, whole: one frame.
fn read_query(db: ref Db, sql: Str, o: ref Opts) -> Result[Pdf, PyErr] {
    let rs = execute(db, sql, o)?;
    wrap_result(rs.names, rs.rows, 0, rs.rows.len(), o)
}

// read_sql_query with chunksize: a frame per chunk, and one empty frame
// when there are no rows.
fn read_chunks(db: ref Db, sql: Str, o: ref Opts) -> Result[String, PyErr] {
    let rs = execute(db, sql, o)?;
    let n = rs.rows.len();
    let size = if o.chunksize > 0 { o.chunksize } else { 1 };
    let mut out = String.new();
    let mut k: i64 = 0;
    let mut at: i64 = 0;
    loop {
        if at >= n and k > 0 {
            break;
        }
        let to = if at + size < n { at + size } else { n };
        let f = wrap_result(rs.names, rs.rows, at, to, o)?;
        out.push_str(f"chunk {k}\n");
        out.push_str(frame_text(f, o.head));
        k += 1;
        at = to;
        if n == 0 {
            break;
        }
    }
    Ok(out)
}
// ------------------------------------------------------------ get_schema and to_sql

// _get_valid_sqlite_name.
fn sqlite_name(s: Str) -> String {
    f"\"{replace_all(s, "\"", "\"\"")}\""
}

// SQLiteTable._sql_type_name: infer_dtype over the values that are not
// missing, then _SQL_TYPES.
fn sql_type(c: ref Col) -> String {
    match c {
        Col.Int(_) => "INTEGER".to_string(),
        Col.NInt(_) => "INTEGER".to_string(),
        Col.Float(_) => "REAL".to_string(),
        Col.NFloat(_) => "REAL".to_string(),
        Col.Dt(_) => "TIMESTAMP".to_string(),
        Col.Obj(v) => {
            let mut ints: i64 = 0;
            let mut reals: i64 = 0;
            let mut other: i64 = 0;
            for x in v {
                match x {
                    V.Null => {},
                    V.Int(_) => ints += 1,
                    V.Real(_) => reals += 1,
                    _ => other += 1,
                }
            }
            if other == 0 and reals == 0 and ints > 0 {
                "INTEGER".to_string()
            } else if other == 0 and ints == 0 and reals > 0 {
                "REAL".to_string()
            } else {
                "TEXT".to_string()
            }
        },
        _ => "TEXT".to_string(),
    }
}

fn lookup(pairs: ref Vec[(String, String)], key: Str) -> Option[String] {
    for p in pairs {
        if p.0 == key {
            return Some(p.1.clone());
        }
    }
    None
}

// The index levels to_sql writes as columns, as _index_name names them.
fn index_labels(f: ref Pdf, o: ref Opts) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    if not o.index {
        return out;
    }
    if let Some(l) = o.index_label {
        out.push(l.clone());
        return out;
    }
    if f.idx_names.len() == 0 {
        out.push(if f.names.contains("index") { "level_0".to_string() } else { "index".to_string() });
        return out;
    }
    for n in f.idx_names {
        out.push(n.clone());
    }
    out
}

fn range_col(n: i64) -> Col {
    let mut v: Vec[i64] = Vec.new();
    for i in 0..n {
        v.push(i);
    }
    Col.Int(v)
}

// The columns to_sql writes: the index levels first, then the frame's.
fn table_columns(f: ref Pdf, o: ref Opts) -> (Vec[String], Vec[Col], i64) {
    let labels = index_labels(f, o);
    let mut names: Vec[String] = Vec.new();
    let mut cols: Vec[Col] = Vec.new();
    for k in 0..labels.len() {
        names.push(labels[k].clone());
        cols.push(if f.idx_cols.len() == 0 { range_col(f.nrows) } else { f.idx_cols[k].clone() });
    }
    for k in 0..f.names.len() {
        names.push(f.names[k].clone());
        cols.push(f.cols[k].clone());
    }
    (names, cols, labels.len())
}

// SQLiteTable._create_table_setup: CREATE TABLE, and CREATE INDEX over
// the index levels.
fn create_statements(name: Str, names: ref Vec[String], cols: ref Vec[Col], nidx: i64, keys: ref Vec[String], sqltypes: ref Vec[(String, String)]) -> Vec[String] {
    let mut defs: Vec[String] = Vec.new();
    for k in 0..names.len() {
        let t = match lookup(sqltypes, names[k]) {
            Some(t) => t,
            None => sql_type(cols[k]),
        };
        defs.push(f"{sqlite_name(names[k])} {t}");
    }
    if keys.len() > 0 {
        let mut ks: Vec[String] = Vec.new();
        for k in keys {
            ks.push(sqlite_name(k));
        }
        defs.push(f"CONSTRAINT {name}_pk PRIMARY KEY ({join(ks, ", ")})");
    }
    let mut out: Vec[String] = Vec.new();
    out.push(f"CREATE TABLE {sqlite_name(name)} (\n{join(defs, ",\n  ")}\n)");
    if nidx > 0 {
        let mut ix: Vec[String] = Vec.new();
        let mut ixq: Vec[String] = Vec.new();
        for k in 0..nidx {
            ix.push(names[k].clone());
            ixq.push(sqlite_name(names[k]));
        }
        out.push(f"CREATE INDEX {sqlite_name(f"ix_{name}_{join(ix, "_")}")}ON {sqlite_name(name)} ({join(ixq, ",")})");
    }
    out
}

fn get_schema(f: ref Pdf, o: ref Opts) -> String {
    let mut o2 = o.clone();
    o2.index = false;
    let (names, cols, nidx) = table_columns(f, o2);
    join(create_statements(o.name, names, cols, nidx, o.keys, o.sqltypes), ";\n")
}

// The value sqlite3 binds for one cell of the frame.
fn cell_value(c: ref Col, k: i64) -> V {
    match c {
        Col.Int(v) => V.Int(v[k]),
        Col.Float(v) => if v[k].is_nan() { V.Null } else { V.Real(v[k]) },
        Col.Str(v) => match v[k] {
            Some(s) => V.Text(s.clone()),
            None => V.Null,
        },
        Col.NStr(v) => match v[k] {
            Some(s) => V.Text(s.clone()),
            None => V.Null,
        },
        Col.Obj(v) => v[k].clone(),
        Col.NInt(v) => match v[k] {
            Some(i) => V.Int(i),
            None => V.Null,
        },
        Col.NFloat(v) => match v[k] {
            Some(r) => if r.is_nan() { V.Null } else { V.Real(r) },
            None => V.Null,
        },
        Col.Dt(d) => match d.v[k] {
            None => V.Null,
            Some(ns) => V.Text(iso_text(ns)),
        },
    }
}

// datetime.isoformat(" "), which leaves out a zero fraction.
fn iso_text(ns: i64) -> String {
    let days = fdiv(ns, NS_DAY);
    let rem = ns - days * NS_DAY;
    let (y, m, d) = civil_from_days(days);
    let secs = rem / NS_SEC;
    let us = (rem % NS_SEC) / 1000;
    let mut t = f"{frac_digits(y, 4)}-{pad2(m)}-{pad2(d)} {pad2(secs / 3600)}:{pad2((secs / 60) % 60)}:{pad2(secs % 60)}";
    if us != 0 {
        t.push_str(f".{frac_digits(us, 6)}");
    }
    t
}

// What CREATE TABLE and CREATE INDEX leave in the in-memory copy.
fn run_create(db: mut ref Db, sql: Str) -> Result[(), PyErr] {
    let mut root: i64 = db.pages;
    for o in db.master {
        if o.root > root {
            root = o.root;
        }
    }
    root += 1;
    if starts_with(sql, "CREATE TABLE") {
        let mut t = match parse_create_table(sql) {
            Ok(t) => t,
            Err(m) => return Err(db_error(sql, m)),
        };
        t.root = root;
        t.loaded = true;
        let name = t.name.clone();
        db.tables.push(t);
        db.master.push(Obj { kind: "table".to_string(), name: name.clone(), tbl: name, root: root, sql: V.Text(sql.to_string()) });
    } else {
        let toks = tokenize(sql);
        let iname = toks[2].val.clone();
        let tname = toks[4].val.clone();
        db.master.push(Obj { kind: "index".to_string(), name: iname, tbl: tname, root: root, sql: V.Text(sql.to_string()) });
    }
    db.tables[0].loaded = false;
    Ok(())
}

// DROP TABLE: the table and its indexes.
fn drop_table(db: mut ref Db, name: Str) {
    let mut master: Vec[Obj] = Vec.new();
    for o in db.master {
        if not ieq(o.tbl, name) {
            master.push(o.clone());
        }
    }
    db.master = master;
    let ti = find_table(db, name);
    if ti > 0 {
        db.tables.remove(ti);
    }
    db.tables[0].loaded = false;
}

// One INSERT: affinity, defaults and the rowid; rows stay in rowid order.
fn insert_row(db: mut ref Db, ti: i64, names: ref Vec[String], vals: ref Vec[V]) -> Result[(), String] {
    let t = db.tables[ti].clone();
    let mut row: Vec[V] = Vec.new();
    let mut rowid: i64 = -1;
    let mut max_id: i64 = 0;
    for id in t.rowids {
        if id > max_id {
            max_id = id;
        }
    }
    for c in t.cols {
        let mut v = c.dflt.clone();
        for k in 0..names.len() {
            if ieq(names[k], c.name) {
                v = vals[k].clone();
            }
        }
        let stored = real_column(apply_affinity(v, c.aff), c.aff);
        if c.rowid_alias {
            match stored {
                V.Null => {},
                V.Int(i) => rowid = i,
                _ => return Err("datatype mismatch".to_string()),
            }
        }
        row.push(stored);
    }
    if rowid < 0 {
        rowid = max_id + 1;
        for k in 0..t.cols.len() {
            if t.cols[k].rowid_alias {
                row[k] = V.Int(rowid);
            }
        }
    }
    let mut at = t.rowids.len();
    while at > 0 and t.rowids[at - 1] > rowid {
        at -= 1;
    }
    if at > 0 and t.rowids[at - 1] == rowid {
        return Err(f"UNIQUE constraint failed: {t.name}.{rowid_name(t)}");
    }
    db.tables[ti].rows.insert(at, row);
    db.tables[ti].rowids.insert(at, rowid);
    Ok(())
}

fn rowid_name(t: ref Table) -> String {
    for c in t.cols {
        if c.rowid_alias {
            return c.name.clone();
        }
    }
    "rowid".to_string()
}

// DataFrame.to_sql into the in-memory copy; the rows it inserted.
fn to_sql(db: mut ref Db, f: ref Pdf, o: ref Opts) -> Result[i64, PyErr] {
    let name = o.name.clone();
    if o.if_exists != "fail" and o.if_exists != "replace" and o.if_exists != "append" and o.if_exists != "delete_rows" {
        return Err(py_err("ValueError", f"'{o.if_exists}' is not valid for if_exists"));
    }
    let (names, cols, nidx) = table_columns(f, o);
    let mut exists = false;
    for m in db.master {
        if (m.kind == "table" or m.kind == "view") and m.name == name {
            exists = true;
        }
    }
    let empty: Vec[String] = Vec.new();
    let stmts = create_statements(name, names, cols, nidx, empty, o.sqltypes);
    if exists {
        if o.if_exists == "fail" {
            return Err(py_err("ValueError", f"Table '{name}' already exists."));
        }
        if o.if_exists == "replace" {
            drop_table(mut db, name);
            for s in stmts {
                run_create(mut db, s)?;
            }
        }
    } else {
        for s in stmts {
            run_create(mut db, s)?;
        }
    }
    if f.nrows == 0 {
        return Ok(0);
    }
    let ti = find_table(db, name);
    if ti <= 0 {
        return Err(py_err("OperationalError", f"no such table: {name}"));
    }
    if let Err(m) = load_table(mut db, ti) {
        return Err(py_err("OperationalError", m));
    }
    for r in 0..f.nrows {
        let mut vals: Vec[V] = Vec.new();
        for c in cols {
            vals.push(cell_value(c, r));
        }
        if let Err(m) = insert_row(mut db, ti, names, vals) {
            return Err(py_err("IntegrityError", m));
        }
    }
    Ok(f.nrows)
}
// ------------------------------------------------------------ the jobs

// split_top: split on sep where it is not inside single quotes.
fn split_top(v: Str, sep: u8) -> Vec[String] {
    let b = to_bytes(v);
    let mut out: Vec[String] = Vec.new();
    let mut cur: Vec[u8] = Vec.new();
    let mut quoted = false;
    for c in b {
        if c == b'\'' {
            quoted = not quoted;
        }
        if c == sep and not quoted {
            out.push(from_bytes(cur));
            cur = Vec.new();
        } else {
            cur.push(c);
        }
    }
    out.push(from_bytes(cur));
    out
}

fn unhex_pairs(s: Str) -> Vec[u8] {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < b.len() {
        out.push((hex_digit(b[i]) * 16 + hex_digit(b[i + 1])) as u8);
        i += 2;
    }
    out
}

// The oracle's literal(): None, a quoted string, x'..' bytes, an int or
// a float.
fn literal(t: Str) -> Result[V, PyErr] {
    let b = to_bytes(t);
    if t == "None" {
        return Ok(V.Null);
    }
    if b.len() >= 2 and b[0] == b'\'' {
        return Ok(V.Text(replace_all(byte_str(b, 1, b.len() - 1), "''", "'")));
    }
    if b.len() >= 3 and b[0] == b'x' and b[1] == b'\'' {
        return Ok(V.Blob(unhex_pairs(byte_str(b, 2, b.len() - 1))));
    }
    let (i, rc) = atoi64(b);
    if rc == 0 and b.len() > 0 {
        return Ok(V.Int(i));
    }
    Ok(V.Real(float_of_text(t)?))
}

fn split_once(s: Str, sep: u8) -> (String, String, bool) {
    let b = to_bytes(s);
    for i in 0..b.len() {
        if b[i] == sep {
            return (byte_str(b, 0, i), byte_str(b, i + 1, b.len()), true);
        }
    }
    (s.to_string(), String.new(), false)
}

fn opts_of(words: ref Vec[String]) -> Result[Opts, PyErr] {
    let mut o = new_opts();
    for w in words {
        let (k, v0, ok) = split_once(w, b'=');
        if not ok {
            return Err(py_err("ValueError", "not enough values to unpack (expected 2, got 1)"));
        }
        let v = replace_all(v0, "\\s", " ");
        if k == "index_col" {
            o.index_col = split_on(v, b',');
        } else if k == "params" {
            let mut ps: Vec[V] = Vec.new();
            for t in split_top(v, b',') {
                ps.push(literal(t)?);
            }
            o.params = Some(ps);
        } else if k == "named" {
            let mut ps: Vec[(String, V)] = Vec.new();
            for p in split_top(v, b',') {
                let (a, bv, _) = split_once(p, b'=');
                ps.push((a, literal(bv)?));
            }
            o.named = Some(ps);
        } else if k == "parse_dates" {
            o.has_dates = true;
            for p in split_on(v, b',') {
                let (c, fmt, has) = split_once(p, b':');
                o.dates.push((c, if has and fmt.len() > 0 { Some(fmt) } else { None }));
            }
        } else if k == "dtype" {
            if has_byte(v, b':') {
                for p in split_on(v, b',') {
                    let (c, t, _) = split_once(p, b':');
                    o.dtypes.push((c, t));
                }
            } else {
                o.dtype_all = Some(v);
            }
        } else if k == "chunksize" {
            o.chunksize = atoi64(to_bytes(v)).0;
        } else if k == "head" {
            o.head = atoi64(to_bytes(v)).0;
        } else if k == "dtype_backend" {
            o.nullable = v == "numpy_nullable";
        } else if k == "keys" {
            o.keys = split_on(v, b',');
        } else if k == "index" {
            o.index = v == "True";
        } else if k == "sqltype" {
            for p in split_on(v, b',') {
                let (c, t, _) = split_once(p, b':');
                o.sqltypes.push((c, t));
            }
        } else if k == "name" {
            o.name = v;
        } else if k == "if_exists" {
            o.if_exists = v;
        } else if k == "index_label" {
            o.index_label = Some(v);
        }
    }
    Ok(o)
}

// sqlite3.connect(f"file:{path}?mode=ro", uri=True).
fn connect(path: Str) -> Result[Db, PyErr] {
    match fs.read_bytes(path.to_string()) {
        Ok(b) => Ok(open_database(b)),
        Err(_) => Err(py_err("OperationalError", "unable to open database file")),
    }
}

// Splits on a separator of several bytes.
fn split_str(s: Str, sep: Str) -> Vec[String] {
    let b = to_bytes(s);
    let p = to_bytes(sep);
    let mut out: Vec[String] = Vec.new();
    let mut from: i64 = 0;
    loop {
        let at = find_bytes(b, p, from);
        if at < 0 {
            out.push(byte_str(b, from, b.len()));
            break;
        }
        out.push(byte_str(b, from, at));
        from = at + p.len();
    }
    out
}

// One job of data/jobs.txt: what the oracle prints for it.
fn run_job(line: Str) -> Result[String, PyErr] {
    let halves = split_str(line, " :: ");
    let head_part = halves[0].clone();
    let mut sql_part = String.new();
    if halves.len() > 1 {
        let b = to_bytes(line);
        sql_part = byte_str(b, head_part.len() + 4, b.len());
    }
    let w = split_on(head_part, b' ');
    let kind = w[0].clone();
    let path = f"data/{w[1]}";
    let sqls = split_str(sql_part, " ;; ");
    let mut rest: Vec[String] = Vec.new();
    for k in 2..w.len() {
        rest.push(w[k].clone());
    }
    let o = opts_of(rest)?;
    let db = connect(path)?;
    if kind == "read" {
        let f = read_query(db, sqls[0], o)?;
        return Ok(frame_text(f, o.head));
    }
    if kind == "chunks" {
        return read_chunks(db, sqls[0], o);
    }
    if kind == "schema" {
        let f = read_query(db, sqls[0], o)?;
        return Ok(f"{get_schema(f, o)}\n");
    }
    if kind == "tosql" {
        let mut mem = db.clone();
        let f = read_query(mem, sqls[0], o)?;
        let mut out = f"to_sql {to_sql(mut mem, f, o)?}\n";
        let plain = new_opts();
        for k in 1..sqls.len() {
            out.push_str(f"> {sqls[k]}\n");
            let g = read_query(mem, sqls[k], plain)?;
            out.push_str(frame_text(g, -1));
        }
        return Ok(out);
    }
    Ok(String.new())
}

// The transcript of one job; what it printed before an exception stays.
fn transcript(line: Str) -> String {
    let mut t = f"$ {line}\n";
    match run_job(line) {
        Ok(text) => t.push_str(text),
        Err(e) => t.push_str(f"! {e.kind}: {e.msg}\n"),
    }
    t
}
// ------------------------------------------------------------ data/

fn hex_val(c: u8) -> u8 {
    if is_digit(c) { c - b'0' } else { c - b'a' + 10 }
}

// The bytes a block of hex digits spells; line breaks are skipped.
fn unhex(s: String) -> Vec[u8] {
    let b = to_bytes(s);
    let mut digits: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        let c = b[i];
        if is_digit(c) or (c >= b'a' and c <= b'f') {
            digits.push(hex_val(c));
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < digits.len() {
        out.push(digits[i] * 16 + digits[i + 1]);
        i += 2;
    }
    out
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn main() {
    if let Err(e) = fs.create_dir_all("data".to_string()) {
        eprintln(f"cannot create data: {e}");
        return;
    }
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    let jobs = match fs.read_to_string("data/jobs.txt".to_string()) {
        Ok(t) => t,
        Err(e) => {
            eprintln(f"cannot read jobs.txt: {e}");
            return;
        }
    };
    let mut lines: Vec[String] = Vec.new();
    for l in lines_of(jobs) {
        if l.len() > 0 and not starts_with(l, "#") {
            lines.push(l.clone());
        }
    }
    // Every job in a task of its own; the transcript prints in job order.
    let group = TaskGroup.new();
    let mut handles = Vec.new();
    for line in lines {
        handles.push(group.spawn(|| transcript(line)));
    }
    for h in handles.into_iter() {
        print(h.join());
    }
}

// ============================================================ data

// The files under data/, in name order.
fn write_data() -> Result[(), String] {
    put_bytes("data/empty.db", unhex(file_0()))?;
    put_bytes("data/history.db", unhex(file_1()))?;
    put_bytes("data/jobs.txt", unhex(file_2()))?;
    put_bytes("data/ledger16.db", unhex(file_3()))?;
    put_bytes("data/mixed.db", unhex(file_4()))?;
    put_bytes("data/notadb.db", unhex(file_5()))?;
    put_bytes("data/sensors.db", unhex(file_6()))?;
    put_bytes("data/shop.db", unhex(file_7()))?;
    Ok(())
}

