// mini_duration — a port of durationpy 0.11 (MIT; Ilia Choly), the Go-style
// duration-string codec used to read durations like "1h30m", "1.5h", "2w3d"
// out of configuration. This port follows durationpy/duration.py: from_str
// tokenises ([value][unit]) pairs, requires them to cover the whole string with
// no gaps, sums each value*unit, and normalises the total to a timedelta's
// (days, seconds, microseconds) fields; to_str decomposes a timedelta back into
// unit components (default rolls everything into hours; extended breaks out
// y/mm/d). The library's float path is reproduced in exact i64 fixed-point over
// the subset the katas exercise (whole-microsecond parse results, whole-component
// format outputs, ASCII units); the finer-grained and float-formatting corners
// are datetime-library boundaries documented in README.md. A rejected duration
// is reported with the canonical token "ERR" rather than the library's exact
// message string. See README.md.

fn str_bytes(s: String) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for b in s.bytes() {
        v.push(b);
    }
    v
}

fn is_digit(c: u8) -> bool {
    c >= 48 and c <= 57
}

fn is_lower(c: u8) -> bool {
    c >= 97 and c <= 122
}

// unit size in NANOSECONDS, or -1 if the unit token is unknown.
fn unit_size(u: String) -> i64 {
    let s = 1000000000;            // one second in ns
    if u == "ns" {
        1
    } else if u == "us" {
        1000
    } else if u == "ms" {
        1000000
    } else if u == "s" {
        s
    } else if u == "m" {
        60 * s
    } else if u == "h" {
        3600 * s
    } else if u == "d" {
        86400 * s
    } else if u == "w" {
        604800 * s
    } else if u == "mm" {
        2592000 * s
    } else if u == "y" {
        31536000 * s
    } else {
        -1
    }
}

fn itoa(n: i64) -> String {
    if n == 0 {
        return "0";
    }
    let mut neg = false;
    let mut v = n;
    if v < 0 {
        neg = true;
        v = -v;
    }
    let mut digs: Vec[u8] = Vec.new();
    while v > 0 {
        digs.push((48 + (v % 10)) as u8);
        v = v / 10;
    }
    let mut out: Vec[u8] = Vec.new();
    if neg {
        out.push(45);
    }
    let mut i = digs.len();
    while i > 0 {
        out.push(digs[i - 1]);
        i = i - 1;
    }
    String.from_utf8(out).unwrap_or("")
}

fn pow10(e: i64) -> i64 {
    let mut p = 1;
    let mut i = 0;
    while i < e {
        p = p * 10;
        i = i + 1;
    }
    p
}

// floored division for signed a, positive b (mirrors Python //)
fn fdiv(a: i64, b: i64) -> i64 {
    let mut q = a / b;
    if (a % b) != 0 and ((a < 0) != (b < 0)) {
        q = q - 1;
    }
    q
}

struct Parsed {
    ok: bool,
    total_ns: i64,
}

// Parse a duration string over the exact-integer subset. ok=false means the
// library rejects it (reported as "ERR").
fn parse_dur(s: String) -> Parsed {
    if s == "0" or s == "+0" or s == "-0" {
        return Parsed { ok: true, total_ns: 0 };
    }
    let b = str_bytes(s);
    let n = b.len();
    let mut sign = 1;
    let mut start = 0;
    if n > 0 and (b[0] == 43 or b[0] == 45) {
        if b[0] == 45 {
            sign = -1;
        }
        start = 1;
    }
    let mut total = 0;
    let mut any = false;
    let mut pos = start;       // expected start of the next token
    let mut i = start;
    while i < n {
        // value: digits and dots
        let mut j = i;
        while j < n and (is_digit(b[j]) or b[j] == 46) {
            j = j + 1;
        }
        if j == i {
            // not at a value -> extra chars region
            i = n + 1;          // force the trailing-coverage check to fail
        } else {
            let mut k = j;
            while k < n and is_lower(b[k]) {
                k = k + 1;
            }
            if k == j {
                // a value with no unit: regex finds no match here
                i = n + 1;
            } else {
                if i != pos {
                    return Parsed { ok: false, total_ns: 0 };  // gap
                }
                // value = s[i..j]
                let mut dots = 0;
                let mut num = 0;
                let mut scale = 0;
                let mut seen_dot = false;
                let mut t = i;
                while t < j {
                    if b[t] == 46 {
                        dots = dots + 1;
                        seen_dot = true;
                    } else {
                        num = num * 10 + ((b[t] - 48) as i64);
                        if seen_dot {
                            scale = scale + 1;
                        }
                    }
                    t = t + 1;
                }
                if dots > 1 or j - i == 0 or (j - i == 1 and b[i] == 46) {
                    return Parsed { ok: false, total_ns: 0 };  // bad value
                }
                let usz = unit_size(s.substring(j, k));
                if usz < 0 {
                    return Parsed { ok: false, total_ns: 0 };  // unknown unit
                }
                let pw = pow10(scale);
                if (num * usz) % pw != 0 {
                    return Parsed { ok: false, total_ns: 0 };  // finer than subset
                }
                total = total + (num * usz) / pw;
                any = true;
                pos = k;
                i = k;
            }
        }
    }
    if not any {
        return Parsed { ok: false, total_ns: 0 };
    }
    if pos != n {
        return Parsed { ok: false, total_ns: 0 };    // extra chars at the end
    }
    Parsed { ok: true, total_ns: sign * total }
}

// Normalise signed total_ns (a multiple of 1000) to "days|seconds|microseconds".
fn fields_str(total_ns: i64) -> String {
    let total_us = fdiv(total_ns, 1000);
    let us = total_us - fdiv(total_us, 1000000) * 1000000;
    let rem_s = fdiv(total_us, 1000000);
    let sec = rem_s - fdiv(rem_s, 86400) * 86400;
    let days = fdiv(rem_s, 86400);
    let mut out = String.new();
    out.push_str(itoa(days));
    out.push_str("|");
    out.push_str(itoa(sec));
    out.push_str("|");
    out.push_str(itoa(us));
    out
}

// to_str over the whole-component subset: every emitted quantity is an integer,
// so Python's {:g} formatting is plain integer printing.
fn to_str_dur(total_ns: i64, extended: bool) -> String {
    let mut ns = total_ns;
    let mut sign = "";
    if ns < 0 {
        sign = "-";
        ns = -ns;
    }
    let one_s = 1000000000;
    let mut out = String.new();
    if ns < one_s {
        if ns == 0 {
            return "0";
        }
        let ms = ns / 1000000;
        if ms != 0 {
            ns = ns - 1000000 * ms;
            out.push_str(itoa(ms));
            out.push_str("ms");
        }
        let usv = ns / 1000;
        if usv != 0 {
            ns = ns - 1000 * usv;
            out.push_str(itoa(usv));
            out.push_str("us");
        }
        if ns != 0 {
            out.push_str(itoa(ns));
            out.push_str("ns");
        }
        let mut r = String.new();
        r.push_str(sign);
        r.push_str(out);
        return r;
    }
    if extended {
        let ysz = 31536000 * one_s;
        let msz = 2592000 * one_s;
        let dsz = 86400 * one_s;
        let y = ns / ysz;
        if y != 0 {
            ns = ns - ysz * y;
            out.push_str(itoa(y));
            out.push_str("y");
        }
        let mo = ns / msz;
        if mo != 0 {
            ns = ns - msz * mo;
            out.push_str(itoa(mo));
            out.push_str("mm");
        }
        let dd = ns / dsz;
        if dd != 0 {
            ns = ns - dsz * dd;
            out.push_str(itoa(dd));
            out.push_str("d");
        }
    }
    let hsz = 3600 * one_s;
    let minsz = 60 * one_s;
    let h = ns / hsz;
    if h != 0 {
        ns = ns - hsz * h;
        out.push_str(itoa(h));
        out.push_str("h");
    }
    let mi = ns / minsz;
    if mi != 0 {
        ns = ns - minsz * mi;
        out.push_str(itoa(mi));
        out.push_str("m");
    }
    let sv = ns / one_s;
    if sv != 0 {
        ns = ns - one_s * sv;
        out.push_str(itoa(sv));
        out.push_str("s");
    }
    let mut r = String.new();
    r.push_str(sign);
    r.push_str(out);
    r
}

fn main_run() -> String {
    let data = jobs_text();
    let db = str_bytes(data.clone());
    let n = db.len();
    let mut out = String.new();
    let mut i = 0;
    let mut ls = 0;
    while i <= n {
        if i == n or db[i] == 10 {
            if i > ls {
                let line = data.substring(ls, i);
                let lb = str_bytes(line.clone());
                let mut tab = -1;
                let mut t = 0;
                while t < lb.len() {
                    if lb[t] == 9 {
                        tab = t;
                        t = lb.len();
                    } else {
                        t = t + 1;
                    }
                }
                if tab >= 0 {
                    let op = line.substring(0, tab);
                    let arg = line.substring(tab + 1, lb.len());
                    if op == "p" {
                        let r = parse_dur(arg.clone());
                        if r.ok {
                            out.push_str(fields_str(r.total_ns));
                        } else {
                            out.push_str("ERR");
                        }
                    } else if op == "f" {
                        let micro = parse_dur_int(arg.clone());
                        out.push_str(to_str_dur(micro * 1000, false));
                    } else if op == "fe" {
                        let micro = parse_dur_int(arg.clone());
                        out.push_str(to_str_dur(micro * 1000, true));
                    }
                    out.push_str("\n");
                }
            }
            ls = i + 1;
        }
        i = i + 1;
    }
    out
}

// Parse a plain signed decimal integer (the f/fe argument, a microsecond count).
fn parse_dur_int(s: String) -> i64 {
    let b = str_bytes(s);
    let n = b.len();
    let mut i = 0;
    let mut neg = false;
    if n > 0 and (b[0] == 43 or b[0] == 45) {
        if b[0] == 45 {
            neg = true;
        }
        i = 1;
    }
    let mut v = 0;
    while i < n {
        if is_digit(b[i]) {
            v = v * 10 + ((b[i] - 48) as i64);
        }
        i = i + 1;
    }
    if neg {
        -v
    } else {
        v
    }
}

fn main() {
    print(main_run());
}

// data/jobs.tsv, as mk.py writes it.
fn jobs_text() -> String {
    let mut s = String.new();
    s.push_str("p\t0\n");
    s.push_str("p\t+0\n");
    s.push_str("p\t-0\n");
    s.push_str("p\t1s\n");
    s.push_str("p\t90m\n");
    s.push_str("p\t1h30m\n");
    s.push_str("p\t2h45m\n");
    s.push_str("p\t1.5h\n");
    s.push_str("p\t0.25h\n");
    s.push_str("p\t100ms\n");
    s.push_str("p\t250us\n");
    s.push_str("p\t1d\n");
    s.push_str("p\t2w\n");
    s.push_str("p\t1y\n");
    s.push_str("p\t3mm\n");
    s.push_str("p\t500ms\n");
    s.push_str("p\t1h\n");
    s.push_str("p\t+2h\n");
    s.push_str("p\t-3d\n");
    s.push_str("p\t1w2d3h4m5s\n");
    s.push_str("p\t12h\n");
    s.push_str("p\t36h\n");
    s.push_str("p\t2d5h30m\n");
    s.push_str("p\t750ms\n");
    s.push_str("p\t10s\n");
    s.push_str("p\t59m59s\n");
    s.push_str("p\t24h\n");
    s.push_str("p\t48h\n");
    s.push_str("p\t1000ms\n");
    s.push_str("p\t1500ms\n");
    s.push_str("p\t5m\n");
    s.push_str("p\t-1h30m\n");
    s.push_str("p\t+90m\n");
    s.push_str("p\t\n");
    s.push_str("p\tabc\n");
    s.push_str("p\t1x\n");
    s.push_str("p\t1h2\n");
    s.push_str("p\th\n");
    s.push_str("p\t1.2.3s\n");
    s.push_str("p\t10 s\n");
    s.push_str("p\t1h \n");
    s.push_str("p\t 1h\n");
    s.push_str("p\t1z\n");
    s.push_str("p\t100\n");
    s.push_str("p\tns\n");
    s.push_str("f\t0\n");
    s.push_str("f\t1000000\n");
    s.push_str("f\t90000000\n");
    s.push_str("f\t5400000000\n");
    s.push_str("f\t3600000000\n");
    s.push_str("f\t500000\n");
    s.push_str("f\t250\n");
    s.push_str("f\t1000\n");
    s.push_str("f\t86400000000\n");
    s.push_str("fe\t86400000000\n");
    s.push_str("fe\t172800000000\n");
    s.push_str("fe\t31536000000000\n");
    s.push_str("fe\t2592000000000\n");
    s.push_str("f\t45000000000\n");
    s.push_str("f\t3900000000\n");
    s.push_str("f\t1000000000\n");
    s.push_str("f\t60000000\n");
    s.push_str("f\t750000\n");
    s.push_str("f\t999000\n");
    s.push_str("f\t999000000\n");
    s.push_str("fe\t213000000000\n");
    s.push_str("f\t213000000000\n");
    s
}
