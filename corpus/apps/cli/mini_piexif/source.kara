// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    v
}

fn data_part_0(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("# camera model, seconds to add to its clock, and the offset it was in\n");
    t.push_str("Canon EOS R6 -3600 +01:00\n");
    t.push_str("SONY ILCE-7M4 +125 +01:00\n");
    t.push_str("Canon EOS R6 Mark II 0 +01:00\n");
    v.push(DataFile { path: "clock.txt".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("524946464400000057454250565038580a000000020000001f0000130000414e494d06000000000000000000414e4d46");
    t.push_str("180000000000000000001f0000130000000000005650382000000000");
    v.push(DataFile { path: "img/anim.webp".to_string(), hex: true, body: t });
    let mut t = String.new();
