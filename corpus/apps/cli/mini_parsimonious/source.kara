        }
        _ => {}
    }
    out
}

// Under IGNORECASE sre lowercases the set when it compiles it and tests
// the lowercased character; a character is in the lowered set if it, or
// its uppercase, is in the set and lowers to it.
fn in_set(set: ref CharSet, c: i64, icase: bool, ascii: bool) -> bool {
    let mut hit = false;
    if icase {
        let lo = lower(c, ascii);
        if lower(lo, ascii) == lo and in_items(set, lo, ascii) {
            hit = true;
        }
        let up = upper(lo, ascii);
        if not hit and lower(up, ascii) == lo and in_items(set, up, ascii) {
            hit = true;
        }
        // and the set takes in the extra cases of each letter in it
        if not hit and not ascii {
            for x in extra_cases(lo).iter() {
                let xu = upper(*x, ascii);
                if in_items(set, *x, ascii) or (lower(xu, ascii) == *x and in_items(set, xu, ascii)) {
                    hit = true;
                }
            }
        }
    } else {
        hit = in_items(set, c, ascii);
    }
    hit != set.negate
}

// ------------------------------------------------------- the module

struct Found {
    start: i64,
    end: i64,
    // group spans, (-1, -1) when a group did not take part
    spans: Vec[(i64, i64)],
    lastindex: i64,
}

fn new_matcher(prog: ref Program, s: ref Vec[i64]) -> Matcher {
    let mut marks: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < 2 * (prog.groups + 1) {
        marks.push(-1);
        k += 1;
    }
    let mut counts: Vec[i64] = Vec.new();
    let mut lasts: Vec[i64] = Vec.new();
    k = 0;
    while k < prog.repeats {
        counts.push(-1);
        lasts.push(-1);
        k += 1;
    }
    Matcher {
        s: s.clone(),
        marks: marks,
        counts: counts,
        lasts: lasts,
        lastindex: -1,
        trail: Vec.new(),
        start: 0,
        must_advance: false,
        match_all: false,
    }
}

// sre_search from `from` (or one attempt there for match and
// fullmatch: mode 1 and 2).
fn re_find(m: mut ref Matcher, prog: ref Program, from: i64, must_advance: bool, mode: i64) -> Option[Found] {
    let mut start = from;
    while start <= m.s.len() {
        let mut k = 0;
        while k < m.marks.len() {
            m.marks[k] = -1;
            k += 1;
        }
        m.lastindex = -1;
        m.trail.clear();
        m.start = start;
        m.must_advance = must_advance and start == from;
        m.match_all = mode == 2;
        let end = m.run(prog, 0, start, true);
        if end >= 0 {
            let mut spans: Vec[(i64, i64)] = Vec.new();
            let mut g = 1;
            while g <= prog.groups {
                spans.push(m.group_span(g));
                g += 1;
            }
            return Some(Found { start: start, end: end, spans: spans, lastindex: m.lastindex });
        }
        if mode != 0 {
            return None;
        }
        start += 1;
    }
    None
}

// All the matches finditer gives: each search starts where the last
// match ended, and must move on past an empty one.
fn all_matches(prog: ref Program, s: ref Vec[i64], limit: i64) -> Vec[Found] {
    let mut m = new_matcher(prog, s);
    let mut out: Vec[Found] = Vec.new();
    let mut pos = 0;
    let mut must_advance = false;
    while pos <= s.len() and (limit == 0 or out.len() < limit) {
        match re_find(mut m, prog, pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    out
}

fn group_text(s: ref Vec[i64], span: (i64, i64), out: mut ref Vec[i64]) {
    let (a, b) = span;
    if a < 0 {
        push_ascii(mut out, "None");
    } else {
        str_repr(slice(s, a, b), mut out);
    }
}

fn span_text(span: (i64, i64)) -> String {
    let (a, b) = span;
    f"({a}, {b})"
}

// ------------------------------------------------- re.compile's cache

// Each pattern is compiled once and keeps one matcher; a search swaps
// the subject into that matcher and back, so no call copies the text.
struct Rx {
    progs: Vec[Program],
    ms: Vec[Matcher],
    keys: Map[String, i64],
}

fn new_rx() -> Rx {
    Rx { progs: Vec.new(), ms: Vec.new(), keys: Map.new() }
}

fn rx_id_v(rx: mut ref Rx, pat: ref Vec[i64], flags: i64) -> i64 {
    let key = f"{flags}:{to_string(pat)}";
    if let Some(id) = rx.keys.get(key) {
        return *id;
    }
    let prog = match re_compile(pat, flags) {
        Ok(p) => p,
        Err(e) => {
            eprintln(f"bad pattern {to_string(pat)}: {err_text(e)}");
            re_compile(u("(?!)"), 0).unwrap()
        }
    };
    let empty: Vec[i64] = Vec.new();
    let m = new_matcher(prog, empty);
    rx.progs.push(prog);
    rx.ms.push(m);
    let id = rx.progs.len() - 1;
    rx.keys.insert(key, id);
    id
}

fn rx_id(rx: mut ref Rx, pat: Str, flags: i64) -> i64 {
    rx_id_v(mut rx, u(pat), flags)
}

// pattern.search (mode 0), match (1) or fullmatch (2) at pos.
fn rx_run(rx: mut ref Rx, id: i64, s: mut ref Vec[i64], pos0: i64, mode: i64) -> Option[Found] {
    // sre clamps the position into the string
    let pos = if pos0 > s.len() { s.len() } else if pos0 < 0 { 0 } else { pos0 };
    mem.swap(mut rx.ms[id].s, mut s);
    let r = re_find(mut rx.ms[id], rx.progs[id], pos, false, mode);
    mem.swap(mut rx.ms[id].s, mut s);
    r
}

// The same with endpos: the subject ends there.
fn rx_run_end(rx: mut ref Rx, id: i64, s: ref Vec[i64], pos: i64, endpos: i64, mode: i64) -> Option[Found] {
    let mut t = sl(s, 0, endpos);
    rx_run(mut rx, id, mut t, pos, mode)
}

fn rx_search(rx: mut ref Rx, id: i64, s: mut ref Vec[i64], pos: i64) -> Option[Found] {
    rx_run(mut rx, id, mut s, pos, 0)
}

fn rx_match(rx: mut ref Rx, id: i64, s: mut ref Vec[i64], pos: i64) -> Option[Found] {
    rx_run(mut rx, id, mut s, pos, 1)
}

// finditer.
fn rx_all(rx: mut ref Rx, id: i64, s: mut ref Vec[i64]) -> Vec[Found] {
    let mut out: Vec[Found] = Vec.new();
    mem.swap(mut rx.ms[id].s, mut s);
    let mut pos = 0;
    let mut must_advance = false;
    let n = rx.ms[id].s.len();
    while pos <= n {
        match re_find(mut rx.ms[id], rx.progs[id], pos, must_advance, 0) {
            Some(found) => {
                must_advance = found.end == found.start;
                pos = found.end;
                out.push(found);
            }
            None => break,
        }
    }
    mem.swap(mut rx.ms[id].s, mut s);
    out
}

fn group_index(rx: ref Rx, id: i64, name: Str) -> i64 {
    let n = u(name);
    for (k, g) in rx.progs[id].names.iter() {
        if same(k, n) {
            return *g;
        }
    }
    -1
}

// m.group(g) for g >= 1, None when the group did not take part.
fn group_n(s: ref Vec[i64], f: ref Found, g: i64) -> Option[Vec[i64]] {
    let (a, b) = f.spans[g - 1];
    if a < 0 {
        return None;
    }
    Some(slice(s, a, b))
}

fn group_or_empty(s: ref Vec[i64], f: ref Found, g: i64) -> Vec[i64] {
    match group_n(s, f, g) {
        Some(t) => t,
        None => Vec.new(),
    }
}

fn group_named(rx: ref Rx, id: i64, s: ref Vec[i64], f: ref Found, name: Str) -> Option[Vec[i64]] {
    group_n(s, f, group_index(rx, id, name))
}

fn gs(rx: ref Rx, id: i64, s: ref Vec[i64], f: ref Found, name: Str) -> Vec[i64] {
    match group_named(rx, id, s, f, name) {
        Some(t) => t,
        None => Vec.new(),
    }
}

fn group0(s: ref Vec[i64], f: ref Found) -> Vec[i64] {
    slice(s, f.start, f.end)
}

// m.lastgroup.
fn last_group(rx: ref Rx, id: i64, f: ref Found) -> String {
    for (k, g) in rx.progs[id].names.iter() {
        if *g == f.lastindex {
            return to_string(k);
        }
    }
    String.new()
}

// pattern.sub with a literal replacement.
fn rx_sub(rx: mut ref Rx, id: i64, s: ref Vec[i64], repl: Str) -> Vec[i64] {
    let mut t = s.clone();
    let found = rx_all(mut rx, id, mut t);
    let r = u(repl);
    let mut out: Vec[i64] = Vec.new();
    let mut pos = 0;
    for f in found.iter() {
        push_all(mut out, slice(t, pos, f.start));
        push_all(mut out, r);
        pos = f.end;
    }
    push_all(mut out, slice(t, pos, t.len()));
    out
}

// pattern.sub(r'\1' + suffix).
fn rx_sub_g1(rx: mut ref Rx, id: i64, s: ref Vec[i64], suffix: ref Vec[i64]) -> Vec[i64] {
    let mut t = s.clone();
    let found = rx_all(mut rx, id, mut t);
    let mut out: Vec[i64] = Vec.new();
    let mut pos = 0;
    for f in found.iter() {
        push_all(mut out, slice(t, pos, f.start));
        push_all(mut out, group_or_empty(t, f, 1));
        push_all(mut out, suffix);
        pos = f.end;
    }
    push_all(mut out, slice(t, pos, t.len()));
    out
}

// pattern.split, for a pattern without groups.
fn rx_split(rx: mut ref Rx, id: i64, s: ref Vec[i64]) -> Vec[Vec[i64]] {
    let mut t = s.clone();
    let found = rx_all(mut rx, id, mut t);
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut pos = 0;
    for f in found.iter() {
        out.push(slice(t, pos, f.start));
        pos = f.end;
    }
    out.push(slice(t, pos, t.len()));
    out
}
// ------------------------------------------------------------ Python str

// mistune's text is a Python str; here it is its code points, and these
// are the str methods mistune calls.

fn u(s: Str) -> Vec[i64] {
    codepoints(s.bytes())
}

fn us(s: ref String) -> Vec[i64] {
    codepoints(s.bytes())
}

fn cat(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut out = a.clone();
    push_all(mut out, b);
    out
}

fn cat3(a: ref Vec[i64], b: ref Vec[i64], c: ref Vec[i64]) -> Vec[i64] {
    let mut out = a.clone();
    push_all(mut out, b);
    push_all(mut out, c);
    out
}

fn ucat(a: Str, b: ref Vec[i64]) -> Vec[i64] {
    let mut out = u(a);
    push_all(mut out, b);
    out
}

fn catu(a: ref Vec[i64], b: Str) -> Vec[i64] {
    let mut out = a.clone();
    push_ascii(mut out, b);
    out
}

fn wrap(a: Str, b: ref Vec[i64], c: Str) -> Vec[i64] {
    let mut out = u(a);
    push_all(mut out, b);
    push_all(mut out, u(c));
    out
}

fn push_str(out: mut ref Vec[i64], s: Str) {
    push_all(mut out, u(s));
}

fn eq(a: ref Vec[i64], b: Str) -> bool {
    same(a, u(b))
}

// s[a:b] with Python's clamping.
fn sl(s: ref Vec[i64], a: i64, b: i64) -> Vec[i64] {
    let n = s.len();
    let mut lo = if a < 0 { a + n } else { a };
    let mut hi = if b < 0 { b + n } else { b };
    if lo < 0 {
        lo = 0;
    }
    if hi > n {
        hi = n;
    }
    if lo >= hi {
        return Vec.new();
    }
    slice(s, lo, hi)
}

fn tail(s: ref Vec[i64], a: i64) -> Vec[i64] {
    sl(s, a, s.len())
}

fn starts_at(s: ref Vec[i64], p: ref Vec[i64], at: i64) -> bool {
    if at < 0 or at + p.len() > s.len() {
        return false;
    }
    let mut i = 0;
    while i < p.len() {
        if s[at + i] != p[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn starts(s: ref Vec[i64], p: Str) -> bool {
    starts_at(s, u(p), 0)
}

fn starts_v(s: ref Vec[i64], p: ref Vec[i64]) -> bool {
    starts_at(s, p, 0)
}

fn ends(s: ref Vec[i64], p: Str) -> bool {
    let q = u(p);
    starts_at(s, q, s.len() - q.len())
}

fn find_v(s: ref Vec[i64], p: ref Vec[i64], from: i64) -> i64 {
    let mut i = if from < 0 { 0 } else { from };
    while i + p.len() <= s.len() {
        if starts_at(s, p, i) {
            return i;
        }
        i += 1;
    }
    -1
}

fn find(s: ref Vec[i64], p: Str, from: i64) -> i64 {
    find_v(s, u(p), from)
}

fn has_char(s: ref Vec[i64], c: i64) -> bool {
    for x in s {
        if x == c {
            return true;
        }
    }
    false
}

fn contains(s: ref Vec[i64], p: Str) -> bool {
    find(s, p, 0) >= 0
}

// str.replace(old, new, count), count -1 for all.
fn replace_v(s: ref Vec[i64], old: ref Vec[i64], new: ref Vec[i64], count: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    if old.len() == 0 {
        // Python puts `new` before every character and at the end.
        let mut n = 0;
        let mut i = 0;
        while i <= s.len() {
            if count < 0 or n < count {
                push_all(mut out, new);
                n += 1;
            }
            if i < s.len() {
                out.push(s[i]);
            }
            i += 1;
        }
        return out;
    }
    let mut i = 0;
    let mut n = 0;
    while i < s.len() {
        if (count < 0 or n < count) and starts_at(s, old, i) {
            push_all(mut out, new);
            i += old.len();
            n += 1;
        } else {
            out.push(s[i]);
            i += 1;
        }
    }
    out
}

fn replace(s: ref Vec[i64], old: Str, new: Str) -> Vec[i64] {
    replace_v(s, u(old), u(new), -1)
}

fn replace1(s: ref Vec[i64], old: Str, new: Str) -> Vec[i64] {
    replace_v(s, u(old), u(new), 1)
}

fn is_ws(c: i64) -> bool {
    is_space(c, false)
}

// str.strip() and friends; `chars` empty means whitespace.
fn in_chars(c: i64, chars: ref Vec[i64]) -> bool {
    if chars.len() == 0 { is_ws(c) } else { has_char(chars, c) }
}

fn strip_chars(s: ref Vec[i64], chars: ref Vec[i64], left: bool, right: bool) -> Vec[i64] {
    let mut a = 0;
    let mut b = s.len();
    if left {
        while a < b and in_chars(s[a], chars) {
            a += 1;
        }
    }
    if right {
        while b > a and in_chars(s[b - 1], chars) {
            b -= 1;
        }
    }
    slice(s, a, b)
}

fn strip(s: ref Vec[i64]) -> Vec[i64] {
    strip_chars(s, Vec.new(), true, true)
}

fn lstrip(s: ref Vec[i64]) -> Vec[i64] {
    strip_chars(s, Vec.new(), true, false)
}

fn rstrip(s: ref Vec[i64]) -> Vec[i64] {
    strip_chars(s, Vec.new(), false, true)
}

fn strip_of(s: ref Vec[i64], chars: Str) -> Vec[i64] {
    strip_chars(s, u(chars), true, true)
}

fn rstrip_of(s: ref Vec[i64], chars: Str) -> Vec[i64] {
    strip_chars(s, u(chars), false, true)
}

fn is_blank(s: ref Vec[i64]) -> bool {
    for c in s {
        if not is_ws(c) {
            return false;
        }
    }
    true
}

// str.split() with no separator.
fn split_ws(s: ref Vec[i64]) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut i = 0;
    while i < s.len() {
        while i < s.len() and is_ws(s[i]) {
            i += 1;
        }
        if i >= s.len() {
            break;
        }
        let a = i;
        while i < s.len() and not is_ws(s[i]) {
            i += 1;
        }
        out.push(slice(s, a, i));
    }
    out
}

// str.split(sep).
fn split_on(s: ref Vec[i64], sep: Str) -> Vec[Vec[i64]] {
    let p = u(sep);
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut a = 0;
    let mut i = 0;
    while i + p.len() <= s.len() {
        if starts_at(s, p, i) {
            out.push(slice(s, a, i));
            i += p.len();
            a = i;
        } else {
            i += 1;
        }
    }
    out.push(slice(s, a, s.len()));
    out
}

fn is_line_break(c: i64) -> bool {
    c == 10 or c == 13 or c == 11 or c == 12 or c == 0x1C or c == 0x1D or c == 0x1E or c == 0x85 or c == 0x2028 or c == 0x2029
}

// str.splitlines(), keepends or not.
fn split_lines(s: ref Vec[i64], keep: bool) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut a = 0;
    let mut i = 0;
    while i < s.len() {
        if is_line_break(s[i]) {
            let mut end = i + 1;
            if s[i] == 13 and i + 1 < s.len() and s[i + 1] == 10 {
                end = i + 2;
            }
            out.push(slice(s, a, if keep { end } else { i }));
            a = end;
            i = end;
        } else {
            i += 1;
        }
    }
    if a < s.len() {
        out.push(slice(s, a, s.len()));
    }
    out
}

fn join(parts: ref Vec[Vec[i64]], sep: Str) -> Vec[i64] {
    let p = u(sep);
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < parts.len() {
        if i > 0 {
            push_all(mut out, p);
        }
        push_all(mut out, parts[i]);
        i += 1;
    }
    out
}

fn spaces(n: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        out.push(32);
        i += 1;
    }
    out
}

fn repeat(c: i64, n: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        out.push(c);
        i += 1;
    }
    out
}

// str.lower() and str.upper(), with the full case mappings.
fn py_lower(s: ref Vec[i64]) -> Vec[i64] {
    us(to_string(s).to_lowercase())
}

fn py_upper(s: ref Vec[i64]) -> Vec[i64] {
    us(to_string(s).to_uppercase())
}

fn ascii_lower(s: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s {
        out.push(if c >= 65 and c <= 90 { c + 32 } else { c });
    }
    out
}

fn num_text(n: i64) -> Vec[i64] {
    u(f"{n}")
}

fn is_digit_text(s: ref Vec[i64]) -> bool {
    if s.len() == 0 {
        return false;
    }
    for c in s {
        if c < 48 or c > 57 {
            return false;
        }
    }
    true
}

// int() of a run of ASCII digits; -1 when it is not one.
fn int_of(s: ref Vec[i64]) -> i64 {
    let t = strip(s);
    if not is_digit_text(t) or t.len() > 18 {
        return -1;
    }
    let mut v = 0;
    for c in t {
        v = v * 10 + (c - 48);
    }
    v
}

// textwrap.indent(text, prefix): every line with something other than
// whitespace in it gets the prefix.
fn indent(text: ref Vec[i64], prefix: Str) -> Vec[i64] {
    let p = u(prefix);
    let mut out: Vec[i64] = Vec.new();
    for line in split_lines(text, true) {
        if not is_blank(line) {
            push_all(mut out, p);
        }
        push_all(mut out, line);
    }
    out
}
fn split_c(s: ref String, sep: char) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}
fn hex_bytes(s: ref String) -> Vec[u8] {
    let cs: Vec[char] = s.chars().collect();
    let n = cs.len() as i64;
    let mut out: Vec[u8] = Vec.new();
    let mut k: i64 = 0;
    while k < n {
        if cs[k] == 'z' {
            let mut j = k + 1;
            let mut count: i64 = 0;
            while cs[j] != '.' {
                count = count * 10 + (cs[j] as i64 - 48);
                j += 1;
            }
            let mut z: i64 = 0;
            while z < count {
                out.push(0);
                z += 1;
            }
            k = j + 1;
        } else {
            out.push((hex_digit(cs[k]) * 16 + hex_digit(cs[k + 1])) as u8);
            k += 2;
        }
    }
    out
}

fn hex_string(s: ref String) -> String {
    String.from_utf8(hex_bytes(s)).unwrap_or(String.new())
}

fn dirname_of(path: ref String) -> String {
    let cs = chars_of(path);
    let mut cut: i64 = -1;
    let mut k: i64 = 0;
    while k < cs.len() as i64 {
        if cs[k] == '/' {
            cut = k;
        }
        k += 1;
    }
    if cut < 0 { String.new() } else { chars_str(cs, 0, cut) }
}

fn write_inputs() -> Result[(), String] {
    let _ = fs.create_dir_all("data".to_string());
    for line in split_c(inputs_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_c(line, ' ');
        let path = f"data/{f[0]}";
        let _ = fs.create_dir_all(dirname_of(path));
        let bytes = if f.len() > 1 { hex_bytes(f[1]) } else { Vec.new() };
        if let Err(e) = fs.write_bytes(path, bytes) {
            return Err(f"cannot write {f[0]}: {e}");
        }
    }
    Ok(())
}

fn hex_digit(c: char) -> i64 {
    let n = c as i64;
    if n >= 97 { n - 87 } else if n >= 65 { n - 55 } else { n - 48 }
}
fn chars_of(s: ref String) -> Vec[char] {
    s.chars().collect()
}
fn chars_str(cs: ref Vec[char], a: i64, b: i64) -> String {
    let mut out = String.new();
    let mut k = a;
    while k < b {
        out.push(cs[k]);
        k += 1;
    }
    out
}
// ------------------------------------------------------------ expressions

// The expression classes of parsimonious/expressions.py, kept in one arena
// so a grammar's rules can point at each other the way Python objects do.
fn k_literal() -> i64 { 0 }
fn k_regex() -> i64 { 1 }
fn k_sequence() -> i64 { 2 }
fn k_oneof() -> i64 { 3 }
fn k_lookahead() -> i64 { 4 }
fn k_quantifier() -> i64 { 5 }
fn k_lazy() -> i64 { 6 }

struct Expr {
    kind: i64,
    name: Vec[i64],
    // the literal, the regex pattern or the label a LazyReference names
    text: Vec[i64],
    is_bytes: bool,
    prog: i64,
    flags: i64,
    members: Vec[i64],
    negative: bool,
    min: i64,
    // -1 is float('inf')
    max: i64,
}

// One parse-tree node. `tid` names the text it covers.
struct PNode {
    expr: i64,
    tid: i64,
    start: i64,
    end: i64,
    children: Vec[i64],
    is_regex: bool,
}

struct Px {
    ex: Vec[Expr],
    nodes: Vec[PNode],
    texts: Vec[Vec[i64]],
    progs: Vec[Program],
    ms: Vec[Matcher],
}

fn new_px() -> Px {
    Px { ex: Vec.new(), nodes: Vec.new(), texts: Vec.new(), progs: Vec.new(), ms: Vec.new() }
}

fn new_expr(px: mut ref Px, kind: i64, members: own Vec[i64], name: Str) -> i64 {
    px.ex.push(Expr { kind: kind, name: u(name), text: Vec.new(), is_bytes: false, prog: -1, flags: 0, members: members, negative: false, min: 0, max: -1 });
    px.ex.len() - 1
}

fn lit_expr(px: mut ref Px, lit: own Vec[i64], name: Str) -> i64 {
    let e = new_expr(mut px, k_literal(), Vec.new(), name);
    px.ex[e].text = lit;
    e
}

fn flag_bits(i: bool, l: bool, m: bool, s: bool, un: bool, x: bool, a: bool) -> i64 {
    let mut f = 0;
    if i {
        f = f | flag_i();
    }
    if l {
        f = f | flag_l();
    }
    if m {
        f = f | flag_m();
    }
    if s {
        f = f | flag_s();
    }
    if un {
        f = f | flag_u();
    }
    if x {
        f = f | flag_x();
    }
    if a {
        f = f | flag_a();
    }
    f
}

// Regex(pattern, ...): re.compile, which reports a bad pattern as
// re.PatternError. A str pattern's flags gain UNICODE unless ASCII is set.
fn regex_expr(px: mut ref Px, pattern: own Vec[i64], flags: i64, name: Str) -> Result[i64, Raised] {
    let prog = match re_compile(pattern, flags) {
        Ok(p) => p,
        Err(e) => {
            let msg = if e.pos >= 0 { f"{e.msg} at position {e.pos}" } else { e.msg.clone() };
            return Err(Raised.Exc("PatternError".to_string(), msg));
        }
    };
    let empty: Vec[i64] = Vec.new();
    px.ms.push(new_matcher(prog, empty));
    px.progs.push(prog);
    let e = new_expr(mut px, k_regex(), Vec.new(), name);
    px.ex[e].text = pattern;
    px.ex[e].prog = px.progs.len() - 1;
    px.ex[e].flags = if (flags & flag_a()) != 0 { flags } else { flags | flag_u() };
    Ok(e)
}

fn quant_expr(px: mut ref Px, member: i64, min: i64, max: i64, name: Str) -> i64 {
    let e = new_expr(mut px, k_quantifier(), [member].to_vec(), name);
    px.ex[e].min = min;
    px.ex[e].max = max;
    e
}

fn not_expr(px: mut ref Px, member: i64) -> i64 {
    let e = new_expr(mut px, k_lookahead(), [member].to_vec(), "");
    px.ex[e].negative = true;
    e
}

fn class_name(px: ref Px, e: i64) -> String {
    let k = px.ex[e].kind;
    if k == k_literal() {
        "Literal".to_string()
    } else if k == k_regex() {
        "Regex".to_string()
    } else if k == k_sequence() {
        "Sequence".to_string()
    } else if k == k_oneof() {
        "OneOf".to_string()
    } else if k == k_lookahead() {
        "Lookahead".to_string()
    } else if k == k_quantifier() {
        "Quantifier".to_string()
    } else {
        "LazyReference".to_string()
    }
}

// ------------------------------------------------------------- as_rule

fn member_text(px: ref Px, m: i64) -> Vec[i64] {
    if px.ex[m].name.len() > 0 { px.ex[m].name.clone() } else { as_rhs(px, m) }
}

fn regex_flag_letters(bits: i64) -> String {
    let letters = u("ilmsuxa");
    let mut out: Vec[i64] = Vec.new();
    let mut i = 1;
    while i <= letters.len() {
        if ((1 << i) & bits) != 0 {
            out.push(letters[i - 1]);
        }
        i += 1;
    }
    to_string(out)
}

fn as_rhs(px: ref Px, e: i64) -> Vec[i64] {
    let x = ref px.ex[e];
    let mut out: Vec[i64] = Vec.new();
    if x.kind == k_literal() {
        if x.is_bytes {
            out.push(98);
        }
        str_repr(x.text, mut out);
    } else if x.kind == k_regex() {
        out.push(126);
        str_repr(x.text, mut out);
        push_ascii(mut out, regex_flag_letters(x.flags));
    } else if x.kind == k_sequence() or x.kind == k_oneof() {
        let sep = if x.kind == k_sequence() { " " } else { " / " };
        out.push(40);
        let mut first = true;
        for m in x.members {
            if not first {
                push_ascii(mut out, sep);
            }
            first = false;
            push_all(mut out, member_text(px, m));
        }
        out.push(41);
    } else if x.kind == k_lookahead() {
        out.push(if x.negative { 33 } else { 38 });
        push_all(mut out, member_text(px, x.members[0]));
    } else if x.kind == k_quantifier() {
        push_all(mut out, member_text(px, x.members[0]));
        let q = if x.min == 0 and x.max == 1 {
            "?".to_string()
        } else if x.min == 0 and x.max < 0 {
            "*".to_string()
        } else if x.min == 1 and x.max < 0 {
            "+".to_string()
        } else if x.max < 0 {
            f"{{{x.min},}}"
        } else if x.min == 0 {
            f"{{,{x.max}}}"
        } else {
            f"{{{x.min},{x.max}}}"
        };
        push_ascii(mut out, q);
    } else {
        push_ascii(mut out, "<LazyReference to ");
        push_all(mut out, x.text);
        out.push(62);
    }
    out
}

fn as_rule(px: ref Px, e: i64) -> Vec[i64] {
    let mut rhs = strip(as_rhs(px, e));
    if rhs.len() > 0 and rhs[0] == 40 and rhs[rhs.len() - 1] == 41 {
        rhs = slice(rhs, 1, rhs.len() - 1);
    }
    if px.ex[e].name.len() > 0 {
        let mut out = px.ex[e].name.clone();
        push_ascii(mut out, " = ");
        push_all(mut out, rhs);
        out
    } else {
        rhs
    }
}

// str(expression)
fn expr_str(px: ref Px, e: i64) -> Vec[i64] {
    let mut out = u(f"<{class_name(px, e)} ");
    push_all(mut out, as_rule(px, e));
    out.push(62);
    out
}

// -------------------------------------------------------------- matching

// The ParseError that match() fills in as it goes.
struct Track {
    pos: i64,
    expr: i64,
}

enum PErr {
    // ParseError, IncompleteParseError, LeftRecursionError: the text, the
    // position and the expression
    Parse(i64, i64, i64),
    Incomplete(i64, i64, i64),
    LeftRec(i64, i64, i64),
}

fn new_node(px: mut ref Px, e: i64, tid: i64, start: i64, end: i64, children: own Vec[i64]) -> i64 {
    px.nodes.push(PNode { expr: e, tid: tid, start: start, end: end, children: children, is_regex: false });
    px.nodes.len() - 1
}

// The cache key of (id(expr), pos).
fn cache_key(e: i64, pos: i64, n: i64) -> i64 {
    e * (n + 1) + pos
}

// Expression.match_core. Ok(-1) is None; Err(e) is a LeftRecursionError
// raised at expression e.
fn match_core(px: mut ref Px, text: mut ref Vec[i64], tid: i64, e: i64, pos: i64, cache: mut ref Map[i64, i64], err: mut ref Track) -> Result[i64, i64] {
    let key = cache_key(e, pos, text.len());
    let mut node: i64 = -1;
    match cache.get(key) {
        Some(v) => {
            node = *v;
        }
        None => {
            cache.insert(key, -2);
            node = uncached_match(mut px, mut text, tid, e, pos, mut cache, mut err)?;
            cache.insert(key, node);
        }
    }
    if node == -2 {
        return Err(e);
    }
    if node == -1 and pos >= err.pos and (px.ex[e].name.len() > 0 or err.expr < 0) {
        err.expr = e;
        err.pos = pos;
    }
    Ok(node)
}

fn uncached_match(px: mut ref Px, text: mut ref Vec[i64], tid: i64, e: i64, pos: i64, cache: mut ref Map[i64, i64], err: mut ref Track) -> Result[i64, i64] {
    let kind = px.ex[e].kind;
    if kind == k_literal() {
        if starts_at(text, px.ex[e].text, pos) {
            let end = pos + px.ex[e].text.len();
            return Ok(new_node(mut px, e, tid, pos, end, Vec.new()));
        }
        return Ok(-1);
    }
    if kind == k_regex() {
        let id = px.ex[e].prog;
        // re.match clamps pos into the string
        let p = if pos > text.len() { text.len() } else { pos };
        mem.swap(mut px.ms[id].s, mut text);
        let found = re_find(mut px.ms[id], px.progs[id], p, false, 1);
        mem.swap(mut px.ms[id].s, mut text);
        return match found {
            Some(f) => {
                let n = new_node(mut px, e, tid, pos, pos + f.end - f.start, Vec.new());
                px.nodes[n].is_regex = true;
                Ok(n)
            }
            None => Ok(-1),
        };
    }
    let members = px.ex[e].members.clone();
    if kind == k_sequence() {
        let mut new_pos = pos;
        let mut children: Vec[i64] = Vec.new();
        for m in members {
            let node = match_core(mut px, mut text, tid, m, new_pos, mut cache, mut err)?;
            if node < 0 {
                return Ok(-1);
            }
            children.push(node);
            new_pos += px.nodes[node].end - px.nodes[node].start;
        }
        return Ok(new_node(mut px, e, tid, pos, new_pos, children));
    }
    if kind == k_oneof() {
        for m in members {
            let node = match_core(mut px, mut text, tid, m, pos, mut cache, mut err)?;
            if node >= 0 {
                let end = px.nodes[node].end;
                return Ok(new_node(mut px, e, tid, pos, end, [node].to_vec()));
            }
        }
        return Ok(-1);
    }
    if kind == k_lookahead() {
        let node = match_core(mut px, mut text, tid, members[0], pos, mut cache, mut err)?;
        if (node < 0) == px.ex[e].negative {
            return Ok(new_node(mut px, e, tid, pos, pos, Vec.new()));
        }
        return Ok(-1);
    }
    if kind == k_quantifier() {
        let min = px.ex[e].min;
        let max = px.ex[e].max;
        let mut new_pos = pos;
        let mut children: Vec[i64] = Vec.new();
        let size = text.len();
        while new_pos < size and (max < 0 or children.len() < max) {
            let node = match_core(mut px, mut text, tid, members[0], new_pos, mut cache, mut err)?;
            if node < 0 {
                break;
            }
            children.push(node);
            let length = px.nodes[node].end - px.nodes[node].start;
            if children.len() >= min and length == 0 {
                break;
            }
            new_pos += length;
        }
        if children.len() >= min {
            return Ok(new_node(mut px, e, tid, pos, new_pos, children));
        }
        return Ok(-1);
    }
    Ok(-1)
}

// Expression.match / Expression.parse on a new text.
fn expr_match(px: mut ref Px, e: i64, text: own Vec[i64], pos: i64, whole: bool) -> Result[i64, PErr] {
    let tid = px.texts.len();
    px.texts.push(Vec.new());
    let mut t = text;
    let mut cache: Map[i64, i64] = Map.new();
    let mut err = Track { pos: -1, expr: -1 };
    let r = match_core(mut px, mut t, tid, e, pos, mut cache, mut err);
    let n = t.len();
    px.texts[tid] = t;
    let node = match r {
        Ok(v) => v,
        Err(at) => return Err(PErr.LeftRec(tid, -1, at)),
    };
    if node < 0 {
        return Err(PErr.Parse(tid, err.pos, err.expr));
    }
    if whole and px.nodes[node].end < n {
        return Err(PErr.Incomplete(tid, px.nodes[node].end, e));
    }
    Ok(node)
}

// ---------------------------------------------------------------- errors

// str.count('\n', 0, pos) + 1
fn err_line(t: ref Vec[i64], pos: i64) -> i64 {
    let mut n = 1;
    for c in sl(t, 0, pos) {
        if c == 10 {
            n += 1;
        }
    }
    n
}

// pos - str.rindex('\n', 0, pos), or pos + 1 when there is none
fn err_column(t: ref Vec[i64], pos: i64) -> i64 {
    let head = sl(t, 0, pos);
    let mut k = head.len() - 1;
    while k >= 0 {
        if head[k] == 10 {
            return pos - k;
        }
        k -= 1;
    }
    pos + 1
}

fn perr_text(px: ref Px, e: ref PErr) -> String {
    match e {
        PErr.Parse(tid, pos, x) => {
            let t = ref px.texts[*tid];
            let rule = if px.ex[*x].name.len() > 0 { f"'{to_string(px.ex[*x].name)}'" } else { to_string(expr_str(px, *x)) };
            f"ParseError: Rule {rule} didn't match at '{to_string(sl(t, *pos, *pos + 20))}' (line {err_line(t, *pos)}, column {err_column(t, *pos)})."
        }
        PErr.Incomplete(tid, pos, x) => {
            let t = ref px.texts[*tid];
            f"IncompleteParseError: Rule '{to_string(px.ex[*x].name)}' matched in its entirety, but it didn't consume all the text. The non-matching portion of the text begins with '{to_string(sl(t, *pos, *pos + 20))}' (line {err_line(t, *pos)}, column {err_column(t, *pos)})."
        }
        PErr.LeftRec(tid, pos, x) => {
            let t = ref px.texts[*tid];
            let rule = if px.ex[*x].name.len() > 0 { px.ex[*x].name.clone() } else { expr_str(px, *x) };
            let mut r: Vec[i64] = Vec.new();
            str_repr(rule, mut r);
            let mut w: Vec[i64] = Vec.new();
            str_repr(sl(t, *pos, *pos + 20), mut w);
            let mut s = f"LeftRecursionError: Left recursion in rule {to_string(r)} at {to_string(w)} (line {err_line(t, *pos)}, column {err_column(t, *pos)}).\n\n";
            s.push_str("Parsimonious is a packrat parser, so it can't handle left recursion.\n");
            s.push_str("See https://en.wikipedia.org/wiki/Parsing_expression_grammar#Indirect_left_recursion\n");
            s.push_str("for how to rewrite your grammar into a rule that does not use left-recursion.");
            s
        }
    }
}

// ------------------------------------------------------------- the tree

fn node_text(px: ref Px, n: i64) -> Vec[i64] {
    let x = ref px.nodes[n];
    slice(px.texts[x.tid], x.start, x.end)
}

fn node_str(px: ref Px, n: i64) -> String {
    to_string(node_text(px, n))
}

fn expr_name(px: ref Px, n: i64) -> String {
    to_string(px.ex[px.nodes[n].expr].name)
}

// Node.prettily, as lines.
fn prettily(px: ref Px, n: i64, error: i64, indent: Str, out: mut ref Vec[String]) {
    let cls = if px.nodes[n].is_regex { "RegexNode" } else { "Node" };
    let name = expr_name(px, n);
    let called = if name.len() > 0 { f" called \"{name}\"" } else { String.new() };
    let mark = if n == error { "  <-- *** We were here. ***" } else { "" };
    let head = f"<{cls}{called} matching \"{node_str(px, n)}\">{mark}";
    for line in split_c(head, '\n') {
        out.push(f"{indent}{line}");
    }
    let deeper = f"{indent}    ";
    for c in px.nodes[n].children {
        prettily(px, c, error, deeper, mut out);
    }
}

fn pretty_text(px: ref Px, n: i64, error: i64) -> String {
    let mut lines: Vec[String] = Vec.new();
    prettily(px, n, error, "", mut lines);
    let mut s = String.new();
    let mut first = true;
    for l in lines {
        if not first {
            s.push('\n');
        }
        first = false;
        s.push_str(l);
    }
    s
}

// --------------------------------------------------------------- visiting

// What a visit_* method gives back.
#[derive(Clone)]
enum V {
    N(i64),
    L(Vec[V]),
    E(i64),
    S(Vec[i64]),
    I(i64),
    B(bool),
    Null,
    D(Vec[(Vec[i64], V)]),
    Q(i64),
}

// What a visit can raise: an exception NodeVisitor.visit wraps (its class
// and message), a VisitationError (its message), or an UndefinedLabel,
// which visit lets through.
enum Raised {
    Exc(String, String),
    Visit(String),
    Undefined(Vec[i64]),
}

fn raised_text(r: ref Raised) -> String {
    match r {
        Raised.Exc(c, m) => f"{c}: {m}",
        Raised.Visit(m) => f"VisitationError: {m}",
        Raised.Undefined(l) => f"UndefinedLabel: The label \"{to_string(l)}\" was never defined.",
    }
}

fn exc(cls: Str, msg: own String) -> Raised {
    Raised.Exc(cls.to_string(), msg)
}

// generic_visit: the visited children, or the node when it has none.
fn generic(n: i64, kids: own Vec[V]) -> V {
    if kids.len() == 0 { V.N(n) } else { V.L(kids) }
}

fn v_list(v: ref V) -> Vec[V] {
    match v {
        V.L(x) => x.clone(),
        _ => Vec.new(),
    }
}

fn v_node(v: ref V) -> i64 {
    match v {
        V.N(x) => *x,
        _ => -1,
    }
}

fn v_expr(v: ref V) -> i64 {
    match v {
        V.E(x) => *x,
        _ => -1,
    }
}

fn v_int(v: ref V) -> i64 {
    match v {
        V.I(x) => *x,
        _ => 0,
    }
}

fn v_str(v: ref V) -> Vec[i64] {
    match v {
        V.S(x) => x.clone(),
        _ => Vec.new(),
    }
}

// The visitors: which visit_* methods a node's name selects.
fn vis_rules() -> i64 { 0 }
fn vis_calc() -> i64 { 1 }
fn vis_json() -> i64 { 2 }
fn vis_ini() -> i64 { 3 }
fn vis_query() -> i64 { 4 }

// The state the visitors keep.
struct Work {
    last_lit: i64,
    last_bytes: bool,
    rule_names: Vec[Vec[i64]],
    rule_exprs: Vec[i64],
    default: i64,
    queries: Vec[QNode],
}

fn new_work() -> Work {
    Work { last_lit: -1, last_bytes: false, rule_names: Vec.new(), rule_exprs: Vec.new(), default: -1, queries: Vec.new() }
}

// NodeVisitor.visit: the children first, then the method; an exception
// becomes a VisitationError showing the node it was raised at.
fn visit(px: mut ref Px, w: mut ref Work, vis: i64, n: i64) -> Result[V, Raised] {
    let mut kids: Vec[V] = Vec.new();
    for c in px.nodes[n].children.clone() {
        kids.push(visit(mut px, mut w, vis, c)?);
    }
    let name = expr_name(px, n);
    let r = if vis == vis_rules() {
        rule_method(mut px, mut w, name, n, kids)
    } else if vis == vis_calc() {
        calc_method(px, name, n, kids)
    } else if vis == vis_json() {
        json_method(px, name, n, kids)
    } else if vis == vis_ini() {
        ini_method(px, name, n, kids)
    } else {
        query_method(px, mut w, name, n, kids)
    };
    match r {
        Err(Raised.Exc(c, m)) => Err(Raised.Visit(f"{c}: {m}\n\nParse tree:\n{pretty_text(px, n, n)}")),
        other => other,
    }
}

// ------------------------------------------------------------ RuleVisitor

fn rule_method(px: mut ref Px, w: mut ref Work, name: Str, n: i64, kids: own Vec[V]) -> Result[V, Raised] {
    if name == "expression" or name == "term" or name == "atom" {
        return Ok(kids[0].clone());
    }
    if name == "parenthesized" {
        return Ok(kids[2].clone());
    }
    if name == "quantifier" {
        return Ok(kids[0].clone());
    }
    if name == "quantified" {
        let atom = v_expr(kids[0]);
        let q = node_str(px, v_node(kids[1]));
        if q == "?" {
            return Ok(V.E(quant_expr(mut px, atom, 0, 1, "")));
        }
        if q == "*" {
            return Ok(V.E(quant_expr(mut px, atom, 0, -1, "")));
        }
        if q == "+" {
            return Ok(V.E(quant_expr(mut px, atom, 1, -1, "")));
        }
        let inner = slice(u(q), 1, u(q).len() - 1);
        let parts = split_on(inner, ",");
        let mut min = 0;
        let mut max = -1;
        if parts.len() == 1 {
            min = int_of(parts[0]);
            max = min;
        } else {
            if parts[0].len() > 0 {
                min = int_of(parts[0]);
            }
            if parts[1].len() > 0 {
                max = int_of(parts[1]);
            }
        }
        return Ok(V.E(quant_expr(mut px, atom, min, max, "")));
    }
    if name == "lookahead_term" {
        return Ok(V.E(new_expr(mut px, k_lookahead(), [v_expr(kids[1])].to_vec(), "")));
    }
    if name == "not_term" {
        return Ok(V.E(not_expr(mut px, v_expr(kids[1]))));
    }
    if name == "rule" {
        let e = v_expr(kids[2]);
        px.ex[e].name = v_str(kids[0]);
        return Ok(V.E(e));
    }
    if name == "sequence" or name == "ored" {
        let mut members = [v_expr(kids[0])].to_vec();
        for t in v_list(kids[1]) {
            members.push(v_expr(t));
        }
        let kind = if name == "sequence" { k_sequence() } else { k_oneof() };
        return Ok(V.E(new_expr(mut px, kind, members, "")));
    }
    if name == "or_term" {
        return Ok(kids[2].clone());
    }
    if name == "label" {
        return Ok(V.S(node_text(px, v_node(kids[0]))));
    }
    if name == "reference" {
        let e = new_expr(mut px, k_lazy(), Vec.new(), "");
        px.ex[e].text = v_str(kids[0]);
        return Ok(V.E(e));
    }
    if name == "regex" {
        let flags = py_upper(node_text(px, v_node(kids[2])));
        let pattern = px.ex[v_expr(kids[1])].text.clone();
        let f = flag_bits(has_char(flags, 73), has_char(flags, 76), has_char(flags, 77), has_char(flags, 83), has_char(flags, 85), has_char(flags, 88), has_char(flags, 65));
        return Ok(V.E(regex_expr(mut px, pattern, f, "")?));
    }
    if name == "spaceless_literal" {
        let (value, is_bytes) = evaluate_string(node_text(px, n))?;
        if w.last_lit >= 0 and w.last_bytes != is_bytes {
            let ty = |b: bool| if b { "<class 'bytes'>" } else { "<class 'str'>" };
            let mut msg = f"Found {node_str(px, w.last_lit)} ({ty(w.last_bytes)}) and {node_str(px, n)} ({ty(is_bytes)}) string literals.\n";
            msg.push_str("All strings in a single grammar must be of the same type.\n");
            return Err(exc("BadGrammar", msg));
        }
        w.last_lit = n;
        w.last_bytes = is_bytes;
        let e = lit_expr(mut px, value, "");
        px.ex[e].is_bytes = is_bytes;
        return Ok(V.E(e));
    }
    if name == "literal" {
        return Ok(kids[0].clone());
    }
    if name == "rules" {
        let rules = v_list(kids[1]);
        w.rule_names = Vec.new();
        w.rule_exprs = Vec.new();
        for r in rules {
            let e = v_expr(r);
            let nm = px.ex[e].name.clone();
            let at = index_of(w.rule_names, nm);
            if at >= 0 {
                w.rule_exprs[at] = e;
            } else {
                w.rule_names.push(nm);
                w.rule_exprs.push(e);
            }
        }
        let mut i = 0;
        while i < w.rule_exprs.len() {
            let e = w.rule_exprs[i];
            w.rule_exprs[i] = resolve_refs(mut px, w, e)?;
            i += 1;
        }
        w.default = if rules.len() > 0 {
            let first = px.ex[v_expr(rules[0])].name.clone();
            w.rule_exprs[index_of(w.rule_names, first)]
        } else {
            -1
        };
        return Ok(V.Null);
    }
    Ok(generic(n, kids))
}

fn index_of(names: ref Vec[Vec[i64]], nm: ref Vec[i64]) -> i64 {
    let mut i = 0;
    while i < names.len() {
        if same(names[i], nm) {
            return i;
        }
        i += 1;
    }
    -1
}

// resolve_refs: a LazyReference follows the rule map to an expression;
// a compound resolves its members in place.
fn resolve_refs(px: mut ref Px, w: ref Work, e: i64) -> Result[i64, Raised] {
    let kind = px.ex[e].kind;
    if kind == k_lazy() {
        let mut seen: Vec[Vec[i64]] = Vec.new();
        let mut cur = e;
        loop {
            let label = px.ex[cur].text.clone();
            if index_of(seen, label) >= 0 {
                return Err(exc("BadGrammar", f"Circular Reference resolving {to_string(px.ex[e].name)}={to_string(px.ex[e].text)}."));
            }
            seen.push(label.clone());
            let at = index_of(w.rule_names, label);
            if at < 0 {
                return Err(Raised.Undefined(label));
            }
            cur = w.rule_exprs[at];
            if px.ex[cur].kind != k_lazy() {
                return Ok(cur);
            }
        }
    }
    if kind == k_literal() or kind == k_regex() {
        return Ok(e);
    }
    let members = px.ex[e].members.clone();
    let mut out: Vec[i64] = Vec.new();
    for m in members {
        out.push(resolve_refs(mut px, w, m)?);
    }
    px.ex[e].members = out;
    Ok(e)
}

// utils.evaluate_string: ast.literal_eval of a string literal, which the
// grammar's spaceless_literal has already matched. Gives the value and
// whether it is bytes.
fn evaluate_string(src: ref Vec[i64]) -> Result[(Vec[i64], bool), Raised] {
    let mut i = 0;
    let mut raw = false;
    let mut is_bytes = false;
    let mut is_u = false;
    while i < src.len() and src[i] != 34 and src[i] != 39 {
        let c = src[i] | 32;
        if c == 114 {
            raw = true;
        } else if c == 98 {
            is_bytes = true;
        } else {
            is_u = true;
        }
        i += 1;
    }
    if is_u and (raw or is_bytes) {
        return Err(exc("SyntaxError", "invalid syntax (<unknown>, line 1)".to_string()));
    }
    let body = slice(src, i + 1, src.len() - 1);
    if raw {
        return Ok((body, is_bytes));
    }
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < body.len() {
        let c = body[k];
        if c != 92 or k + 1 >= body.len() {
            out.push(c);
            k += 1;
            continue;
        }
        let d = body[k + 1];
        k += 2;
        if d == 10 {
            continue;
        }
        let simple = if d == 92 { 92 } else if d == 39 { 39 } else if d == 34 { 34 } else if d == 97 { 7 } else if d == 98 { 8 } else if d == 102 { 12 } else if d == 110 { 10 } else if d == 114 { 13 } else if d == 116 { 9 } else if d == 118 { 11 } else { -1 };
        if simple >= 0 {
            out.push(simple);
        } else if d >= 48 and d <= 55 {
            let mut v = d - 48;
            let mut n = 1;
            while n < 3 and k < body.len() and body[k] >= 48 and body[k] <= 55 {
                v = v * 8 + body[k] - 48;
                k += 1;
                n += 1;
            }
            out.push(v);
        } else if d == 120 or (not is_bytes and (d == 117 or d == 85)) {
            let width = if d == 120 { 2 } else if d == 117 { 4 } else { 8 };
            let mut v = 0;
            let mut n = 0;
            while n < width {
                if k >= body.len() or hex_val(body[k]) < 0 {
                    return Err(exc("SyntaxError", "(unicode error) truncated escape (<unknown>, line 1)".to_string()));
                }
                v = v * 16 + hex_val(body[k]);
                k += 1;
                n += 1;
            }
            out.push(v);
        } else {
            out.push(92);
            out.push(d);
        }
    }
    Ok((out, is_bytes))
}

fn hex_val(c: i64) -> i64 {
    if c >= 48 and c <= 57 {
        c - 48
    } else if c >= 97 and c <= 102 {
        c - 87
    } else if c >= 65 and c <= 70 {
        c - 55
    } else {
        -1
    }
}

// --------------------------------------------------------------- Grammar

struct Gram {
    names: Vec[Vec[i64]],
    exprs: Vec[i64],
    default: i64,
}

fn gram_of(w: ref Work) -> Gram {
    Gram { names: w.rule_names.clone(), exprs: w.rule_exprs.clone(), default: w.default }
}

fn gram_get(g: ref Gram, name: Str) -> i64 {
    g.exprs[index_of(g.names, u(name))]
}

// Grammar.__init__: the rules text parsed by rule_grammar, then visited.
enum GErr {
    P(PErr),
    R(Raised),
}

fn gerr_text(px: ref Px, e: ref GErr) -> String {
    match e {
        GErr.P(p) => perr_text(px, p),
        GErr.R(r) => raised_text(r),
    }
}

fn make_grammar(px: mut ref Px, rule_grammar: ref Gram, rules: own Vec[i64]) -> Result[Gram, GErr] {
    let tree = match expr_match(mut px, rule_grammar.default, rules, 0, true) {
        Ok(t) => t,
        Err(e) => return Err(GErr.P(e)),
    };
    let mut w = new_work();
    if let Err(e) = visit(mut px, mut w, vis_rules(), tree) {
        return Err(GErr.R(e));
    }
    Ok(gram_of(w))
}

// str(grammar)
fn gram_str(px: ref Px, g: ref Gram) -> String {
    let mut lines: Vec[Vec[i64]] = Vec.new();
    if g.default >= 0 {
        lines.push(as_rule(px, g.default));
    }
    for e in g.exprs {
        if e != g.default {
            lines.push(as_rule(px, e));
        }
    }
    to_string(join(lines, "\n"))
}

// BootstrappingGrammar._expressions_from_rules: the rule grammar built by
// hand, which then reads rule_syntax.
fn bootstrap(px: mut ref Px) -> Gram {
    let comment = regex_expr(mut px, u("#[^\\r\\n]*"), 0, "comment").unwrap();
    let ws = regex_expr(mut px, u("\\s+"), 0, "").unwrap();
    let meaninglessness = new_expr(mut px, k_oneof(), [ws, comment].to_vec(), "meaninglessness");
    let ws_opt = quant_expr(mut px, meaninglessness, 0, -1, "_");
    let eq = lit_expr(mut px, u("="), "");
    let equals = new_expr(mut px, k_sequence(), [eq, ws_opt].to_vec(), "equals");
    let ident = regex_expr(mut px, u("[a-zA-Z_][a-zA-Z_0-9]*"), 0, "").unwrap();
    let label = new_expr(mut px, k_sequence(), [ident, ws_opt].to_vec(), "label");
    let not_equals = not_expr(mut px, equals);
    let reference = new_expr(mut px, k_sequence(), [label, not_equals].to_vec(), "reference");
    let qchar = regex_expr(mut px, u("[*+?]"), 0, "").unwrap();
    let quantifier = new_expr(mut px, k_sequence(), [qchar, ws_opt].to_vec(), "quantifier");
    let spaceless = regex_expr(mut px, u("u?r?\"[^\"\\\\]*(?:\\\\.[^\"\\\\]*)*\""), flag_i() | flag_s(), "spaceless_literal").unwrap();
    let literal = new_expr(mut px, k_sequence(), [spaceless, ws_opt].to_vec(), "literal");
    let tilde = lit_expr(mut px, u("~"), "");
    let rflags = regex_expr(mut px, u("[ilmsuxa]*"), flag_i(), "").unwrap();
    let regex = new_expr(mut px, k_sequence(), [tilde, literal, rflags, ws_opt].to_vec(), "regex");
    let atom = new_expr(mut px, k_oneof(), [reference, literal, regex].to_vec(), "atom");
    let quantified = new_expr(mut px, k_sequence(), [atom, quantifier].to_vec(), "quantified");
    let term = new_expr(mut px, k_oneof(), [quantified, atom].to_vec(), "term");
    let bang = lit_expr(mut px, u("!"), "");
    let not_term = new_expr(mut px, k_sequence(), [bang, term, ws_opt].to_vec(), "not_term");
    px.ex[term].members = [not_term, quantified, atom].to_vec();
    let terms = quant_expr(mut px, term, 1, -1, "");
    let sequence = new_expr(mut px, k_sequence(), [term, terms].to_vec(), "sequence");
    let slash = lit_expr(mut px, u("/"), "");
    let or_term = new_expr(mut px, k_sequence(), [slash, ws_opt, term].to_vec(), "or_term");
    let or_terms = quant_expr(mut px, or_term, 1, -1, "");
    let ored = new_expr(mut px, k_sequence(), [term, or_terms].to_vec(), "ored");
    let expression = new_expr(mut px, k_oneof(), [ored, sequence, term].to_vec(), "expression");
    let rule = new_expr(mut px, k_sequence(), [label, equals, expression].to_vec(), "rule");
    let rule_list = quant_expr(mut px, rule, 1, -1, "");
    let rules = new_expr(mut px, k_sequence(), [ws_opt, rule_list].to_vec(), "rules");
    let syntax = codepoints(hex_bytes(rule_syntax_text().trim().to_string()));
    let tree = expr_match(mut px, rules, syntax, 0, true).unwrap();
    let mut w = new_work();
    let _ = visit(mut px, mut w, vis_rules(), tree);
    gram_of(w)
}

fn rule_grammar(px: mut ref Px) -> Gram {
    let boot = bootstrap(mut px);
    let syntax = codepoints(hex_bytes(rule_syntax_text().trim().to_string()));
    match make_grammar(mut px, boot, syntax) {
        Ok(g) => g,
        Err(e) => {
            eprintln(gerr_text(px, e));
            boot
        }
    }
}

// ------------------------------------------------------------ the visitors

// items(): an empty `*` or `?` visits to its node, as generic_visit gives it.
fn items(v: ref V) -> Vec[V] {
    v_list(v)
}

fn first_of(v: ref V) -> V {
    match v {
        V.L(x) => x[0].clone(),
        _ => V.Null,
    }
}

fn nth(v: ref V, i: i64) -> V {
    match v {
        V.L(x) => x[i].clone(),
        _ => V.Null,
    }
}

fn int_text(t: ref Vec[i64]) -> i64 {
    let s = strip(t);
    if s.len() > 0 and s[0] == 45 {
        return -int_of(slice(s, 1, s.len()));
    }
    int_of(s)
}

// Python's // and % on ints.
fn py_div(a: i64, b: i64) -> Result[i64, Raised] {
    if b == 0 {
        return Err(exc("ZeroDivisionError", "integer division or modulo by zero".to_string()));
    }
    let mut q = a / b;
    if a % b != 0 and ((a < 0) != (b < 0)) {
        q -= 1;
    }
    Ok(q)
}

fn py_mod(a: i64, b: i64) -> Result[i64, Raised] {
    if b == 0 {
        return Err(exc("ZeroDivisionError", "integer modulo by zero".to_string()));
    }
    let mut r = a % b;
    if r != 0 and ((r < 0) != (b < 0)) {
        r += b;
    }
    Ok(r)
}

fn calc_method(px: ref Px, name: Str, n: i64, kids: own Vec[V]) -> Result[V, Raised] {
    if name == "line" {
        return Ok(kids[1].clone());
    }
    if name == "expr" or name == "term" {
        let mut v = v_int(kids[0]);
        for it in items(kids[1]) {
            let op = to_string(v_str(nth(it, 0)));
            let t = v_int(nth(it, 1));
            if op == "+" {
                v = v + t;
            } else if op == "-" {
                v = v - t;
            } else if op == "*" {
                v = v * t;
            } else if op == "/" {
                v = py_div(v, t)?;
            } else {
                v = py_mod(v, t)?;
            }
        }
        return Ok(V.I(v));
    }
    if name == "factor" {
        return Ok(kids[0].clone());
    }
    if name == "neg" {
        return Ok(V.I(-v_int(kids[2])));
    }
    if name == "paren" {
        return Ok(kids[2].clone());
    }
    if name == "call" {
        let fname = to_string(v_str(kids[0]));
        let a = items(kids[3]);
        let mut args: Vec[i64] = Vec.new();
        if a.len() > 0 {
            for x in v_list(a[0]) {
                args.push(v_int(x));
            }
        }
        if fname == "max" or fname == "min" {
            if args.len() == 0 {
                return Err(exc("ValueError", f"{fname}() iterable argument is empty"));
            }
            let mut best = args[0];
            for x in args {
                if (fname == "max" and x > best) or (fname == "min" and x < best) {
                    best = x;
                }
            }
            return Ok(V.I(best));
        }
        if fname == "abs" {
            if args.len() != 1 {
                return Err(exc("TypeError", f"abs takes 1 argument, got {args.len()}"));
            }
            return Ok(V.I(if args[0] < 0 { -args[0] } else { args[0] }));
        }
        if fname == "pow" {
            if args.len() != 2 {
                return Err(exc("TypeError", f"pow takes 2 arguments, got {args.len()}"));
            }
            let mut r = 1;
            let mut k = 0;
            while k < args[1] {
                r = r * args[0];
                k += 1;
            }
            return Ok(V.I(r));
        }
        let mut q: Vec[i64] = Vec.new();
        str_repr(u(fname), mut q);
        return Err(exc("NameError", f"unknown function {to_string(q)}"));
    }
    if name == "args" {
        let mut out = [kids[0].clone()].to_vec();
        for it in items(kids[1]) {
            out.push(nth(it, 2));
        }
        return Ok(V.L(out));
    }
    if name == "addop" or name == "mulop" {
        return Ok(V.S(strip(node_text(px, n))));
    }
    if name == "number" {
        return Ok(V.I(int_text(node_text(px, n))));
    }
    if name == "name" {
        return Ok(V.S(node_text(px, n)));
    }
    Ok(generic(n, kids))
}

// json.loads of a string token.
fn json_string(t: ref Vec[i64]) -> Vec[i64] {
    let body = slice(t, 1, t.len() - 1);
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < body.len() {
        let c = body[k];
        if c != 92 {
            out.push(c);
            k += 1;
            continue;
        }
        let d = body[k + 1];
        k += 2;
        if d == 117 {
            let mut v = 0;
            for j in 0..4 {
                v = v * 16 + hex_val(body[k + j]);
            }
            k += 4;
            if v >= 0xD800 and v <= 0xDBFF and k + 1 < body.len() and body[k] == 92 and body[k + 1] == 117 {
                let mut v2 = 0;
                for j in 0..4 {
                    v2 = v2 * 16 + hex_val(body[k + 2 + j]);
                }
                if v2 >= 0xDC00 and v2 <= 0xDFFF {
                    v = 0x10000 + ((v - 0xD800) << 10) + (v2 - 0xDC00);
                    k += 6;
                }
            }
            out.push(v);
        } else {
            out.push(if d == 98 { 8 } else if d == 102 { 12 } else if d == 110 { 10 } else if d == 114 { 13 } else if d == 116 { 9 } else { d });
        }
    }
    out
}

fn d_set(d: mut ref Vec[(Vec[i64], V)], k: ref Vec[i64], v: own V) {
    let mut i = 0;
    while i < d.len() {
        if same(d[i].0, k) {
            d[i].1 = v;
            return;
        }
        i += 1;
    }
    d.push((k.clone(), v));
}

fn json_method(px: ref Px, name: Str, n: i64, kids: own Vec[V]) -> Result[V, Raised] {
    if name == "value" {
        return Ok(first_of(kids[1]));
    }
    if name == "object" {
        let mut d: Vec[(Vec[i64], V)] = Vec.new();
        for m in items(kids[2]) {
            for p in v_list(m) {
                d_set(mut d, v_str(nth(p, 0)), nth(p, 1));
            }
        }
        return Ok(V.D(d));
    }
    if name == "members" {
        let mut out = [kids[0].clone()].to_vec();
        for it in items(kids[1]) {
            out.push(nth(it, 2));
        }
        return Ok(V.L(out));
    }
    if name == "pair" {
        return Ok(V.L([kids[0].clone(), kids[3].clone()].to_vec()));
    }
    if name == "array" {
        let mut out: Vec[V] = Vec.new();
        for m in items(kids[2]) {
            for x in v_list(m) {
                out.push(x.clone());
            }
        }
        return Ok(V.L(out));
    }
    if name == "items" {
        let mut out = [kids[0].clone()].to_vec();
        for it in items(kids[1]) {
            out.push(nth(it, 1));
        }
        return Ok(V.L(out));
    }
    if name == "string" {
        return Ok(V.S(json_string(node_text(px, n))));
    }
    if name == "number" {
        return Ok(V.I(int_text(node_text(px, n))));
    }
    if name == "true" {
        return Ok(V.B(true));
    }
    if name == "false" {
        return Ok(V.B(false));
    }
    if name == "null" {
        return Ok(V.Null);
    }
    Ok(generic(n, kids))
}

fn dumps_str(s: ref Vec[i64], out: mut ref String) {
    out.push('"');
    for c in s {
        if c == 34 {
            out.push_str("\\\"");
        } else if c == 92 {
            out.push_str("\\\\");
        } else if c == 10 {
            out.push_str("\\n");
        } else if c == 13 {
            out.push_str("\\r");
        } else if c == 9 {
            out.push_str("\\t");
        } else if c == 8 {
            out.push_str("\\b");
        } else if c == 12 {
            out.push_str("\\f");
        } else if c >= 0x20 and c <= 0x7E {
            out.push((c as u8) as char);
        } else if c > 0xFFFF {
            let v = c - 0x10000;
            out.push_str(f"\\u{hex_n(0xD800 + (v >> 10), 4)}\\u{hex_n(0xDC00 + (v & 0x3FF), 4)}");
        } else {
            out.push_str(f"\\u{hex_n(c, 4)}");
        }
    }
    out.push('"');
}

fn dumps(v: ref V, out: mut ref String) {
    match v {
        V.D(d) => {
            out.push('{');
            let mut first = true;
            for p in d {
                if not first {
                    out.push_str(", ");
                }
                first = false;
                dumps_str(p.0, mut out);
                out.push_str(": ");
                dumps(p.1, mut out);
            }
            out.push('}');
        }
        V.L(l) => {
            out.push('[');
            let mut first = true;
            for x in l {
                if not first {
                    out.push_str(", ");
                }
                first = false;
                dumps(x, mut out);
            }
            out.push(']');
        }
        V.S(s) => dumps_str(s, mut out),
        V.I(i) => out.push_str(f"{i}"),
        V.B(b) => out.push_str(if *b { "true" } else { "false" }),
        _ => out.push_str("null"),
    }
}

fn dumps_of(v: ref V) -> String {
    let mut s = String.new();
    dumps(v, mut s);
    s
}

fn leaves(v: ref V, path: Str, out: mut ref Vec[String]) {
    match v {
        V.D(d) => {
            if d.len() > 0 {
                for p in d {
                    let k = to_string(p.0);
                    let sub = if path.len() > 0 { f"{path}.{k}" } else { k };
                    leaves(p.1, sub, mut out);
                }
                return;
            }
        }
        V.L(l) => {
            if l.len() > 0 {
                let mut i = 0;
                for x in l {
                    leaves(x, f"{path}[{i}]", mut out);
                    i += 1;
                }
                return;
            }
        }
        _ => {}
    }
    let p = if path.len() > 0 { path.to_string() } else { ".".to_string() };
    out.push(f"{p} = {dumps_of(v)}");
}

fn ini_method(px: ref Px, name: Str, n: i64, kids: own Vec[V]) -> Result[V, Raised] {
    if name == "file" {
        let mut sections: Vec[(Vec[i64], V)] = Vec.new();
        let mut cur: i64 = -1;
        for k in kids {
            let item = first_of(k);
            match item {
                V.L(x) => {
                    let what = to_string(v_str(x[0]));
                    let key = v_str(x[1]);
                    if what == "section" {
                        cur = sec_index(mut sections, key);
                    } else {
                        if cur < 0 {
                            cur = sec_index(mut sections, u("DEFAULT"));
                        }
                        let mut pairs = match sections[cur].1 { V.D(p) => p.clone(), _ => Vec.new() };
                        d_set(mut pairs, key, x[2].clone());
                        sections[cur].1 = V.D(pairs);
                    }
                }
                _ => {}
            }
        }
        return Ok(V.D(sections));
    }
    if name == "section" {
        return Ok(V.L([V.S(u("section")), V.S(strip(node_text(px, v_node(kids[1]))))].to_vec()));
    }
    if name == "pair" {
        let raw = strip(node_text(px, v_node(kids[5])));
        let low = to_string(py_lower(raw));
        let val = if raw.len() > 0 and is_digit_text(raw) {
            V.I(int_of(raw))
        } else if low == "yes" or low == "true" or low == "on" {
            V.B(true)
        } else if low == "no" or low == "false" or low == "off" {
            V.B(false)
        } else if raw.len() == 0 {
            V.Null
        } else {
            V.S(raw)
        };
        return Ok(V.L([V.S(u("pair")), V.S(node_text(px, v_node(kids[1]))), val].to_vec()));
    }
    if name == "comment" or name == "blank" {
        return Ok(V.Null);
    }
    Ok(generic(n, kids))
}

// sections.setdefault(name, {})
fn sec_index(sections: mut ref Vec[(Vec[i64], V)], key: ref Vec[i64]) -> i64 {
    let mut i = 0;
    while i < sections.len() {
        if same(sections[i].0, key) {
            return i;
        }
        i += 1;
    }
    sections.push((key.clone(), V.D(Vec.new())));
    sections.len() - 1
}

fn py_value_repr(v: ref V) -> String {
    match v {
        V.S(s) => {
            let mut q: Vec[i64] = Vec.new();
            str_repr(s, mut q);
            to_string(q)
        }
        V.I(i) => f"{i}",
        V.B(b) => if *b { "True".to_string() } else { "False".to_string() },
        _ => "None".to_string(),
    }
}

// ------------------------------------------------------------- queries

// One node of a query: or, and, not, a flag or a comparison.
struct QNode {
    kind: i64,
    kids: Vec[i64],
    field: Vec[i64],
    op: String,
    want: V,
}

fn q_new(w: mut ref Work, kind: i64, kids: own Vec[i64], field: own Vec[i64], op: own String, want: own V) -> V {
    w.queries.push(QNode { kind: kind, kids: kids, field: field, op: op, want: want });
    V.Q(w.queries.len() - 1)
}

fn v_q(v: ref V) -> i64 {
    match v {
        V.Q(x) => *x,
        _ => -1,
    }
}

fn query_fields() -> Vec[String] {
    ["name".to_string(), "age".to_string(), "city".to_string(), "active".to_string(), "role".to_string()].to_vec()
}

fn query_method(px: ref Px, w: mut ref Work, name: Str, n: i64, kids: own Vec[V]) -> Result[V, Raised] {
    if name == "query" {
        return Ok(kids[1].clone());
    }
    if name == "disj" or name == "conj" {
        let mut all = [v_q(kids[0])].to_vec();
        for it in items(kids[1]) {
            all.push(v_q(nth(it, 1)));
        }
        if all.len() == 1 {
            return Ok(kids[0].clone());
        }
        let kind = if name == "disj" { 0 } else { 1 };
        return Ok(q_new(mut w, kind, all, Vec.new(), String.new(), V.Null));
    }
    if name == "neg" {
        return match kids[0] {
            V.L(x) => Ok(q_new(mut w, 2, [v_q(x[1])].to_vec(), Vec.new(), String.new(), V.Null)),
            other => Ok(other.clone()),
        };
    }
    if name == "atom" {
        return Ok(kids[0].clone());
    }
    if name == "group" {
        return Ok(kids[2].clone());
    }
    if name == "cmp" {
        return Ok(q_new(mut w, 4, Vec.new(), v_str(kids[0]), to_string(v_str(kids[1])), kids[2].clone()));
    }
    if name == "flag" {
        return Ok(q_new(mut w, 3, Vec.new(), v_str(kids[0]), String.new(), V.Null));
    }
    if name == "op" {
        return Ok(V.S(strip(node_text(px, n))));
    }
    if name == "value" {
        return Ok(first_of(kids[0]));
    }
    if name == "number" {
        return Ok(V.I(int_text(node_text(px, n))));
    }
    if name == "string" {
        let t = node_text(px, n);
        return Ok(V.S(slice(t, 1, t.len() - 1)));
    }
    if name == "field" {
        let f = node_text(px, v_node(kids[1]));
        let fs = to_string(f);
        let mut known = false;
        for k in query_fields() {
            if k == fs {
                known = true;
            }
        }
        if not known {
            let mut q: Vec[i64] = Vec.new();
            str_repr(f, mut q);
            return Err(exc("ValueError", f"unknown field {to_string(q)}"));
        }
        return Ok(V.S(f));
    }
    Ok(generic(n, kids))
}

struct Rec {
    vals: Vec[(Vec[i64], V)],
}

fn rec_get(r: ref Rec, f: ref Vec[i64]) -> V {
    for p in r.vals {
        if same(p.0, f) {
            return p.1.clone();
        }
    }
    V.Null
}

fn type_name(v: ref V) -> String {
    match v {
        V.S(_) => "str".to_string(),
        V.I(_) => "int".to_string(),
        V.B(_) => "bool".to_string(),
        _ => "NoneType".to_string(),
    }
}

fn num_of(v: ref V) -> Option[i64] {
    match v {
        V.I(i) => Some(*i),
        V.B(b) => Some(if *b { 1 } else { 0 }),
        _ => None,
    }
}

// -1, 0 or 1, or None when Python cannot order the two.
fn py_cmp(a: ref V, b: ref V) -> Option[i64] {
    match (num_of(a), num_of(b)) {
        (Some(x), Some(y)) => return Some(if x < y { -1 } else if x > y { 1 } else { 0 }),
        _ => {}
    }
    match (a, b) {
        (V.S(x), V.S(y)) => {
            let mut i = 0;
            while i < x.len() and i < y.len() {
                if x[i] != y[i] {
                    return Some(if x[i] < y[i] { -1 } else { 1 });
                }
                i += 1;
            }
            Some(if x.len() < y.len() { -1 } else if x.len() > y.len() { 1 } else { 0 })
        }
        _ => None,
    }
}

fn py_text(v: ref V) -> Vec[i64] {
    match v {
        V.S(s) => s.clone(),
        V.I(i) => u(f"{i}"),
        V.B(b) => u(if *b { "True" } else { "False" }),
        _ => u("None"),
    }
}

fn truthy(v: ref V) -> bool {
    match v {
        V.S(s) => s.len() > 0,
        V.I(i) => *i != 0,
        V.B(b) => *b,
        _ => false,
    }
}

fn holds(w: ref Work, q: i64, rec: ref Rec) -> Result[bool, String] {
    let node = ref w.queries[q];
    if node.kind == 0 {
        for k in node.kids {
            if holds(w, k, rec)? {
                return Ok(true);
            }
        }
        return Ok(false);
    }
    if node.kind == 1 {
        for k in node.kids {
            if not holds(w, k, rec)? {
                return Ok(false);
            }
        }
        return Ok(true);
    }
    if node.kind == 2 {
        return Ok(not holds(w, node.kids[0], rec)?);
    }
    let have = rec_get(rec, node.field);
    if node.kind == 3 {
        return Ok(truthy(have));
    }
    let op = node.op.clone();
    if op == "~" {
        let hay = py_lower(py_text(have));
        let needle = py_lower(py_text(node.want));
        return Ok(find_v(hay, needle, 0) >= 0);
    }
    let c = py_cmp(have, node.want);
    if op == "=" or op == "!=" {
        let equal = match c { Some(x) => x == 0, None => false };
        return Ok(if op == "=" { equal } else { not equal });
    }
    match c {
        Some(x) => Ok(if op == "<" { x < 0 } else if op == ">" { x > 0 } else if op == "<=" { x <= 0 } else { x >= 0 }),
        None => Err(f"TypeError: '{op}' not supported between instances of '{type_name(have)}' and '{type_name(node.want)}'"),
    }
}

fn records(path: Str) -> Vec[Rec] {
    let lines = split_on(read_text(path), "\n");
    let head = split_on(lines[0], ",");
    let mut out: Vec[Rec] = Vec.new();
    let mut i = 1;
    while i < lines.len() {
        if lines[i].len() > 0 {
            let cells = split_on(lines[i], ",");
            let mut vals: Vec[(Vec[i64], V)] = Vec.new();
            let mut j = 0;
            while j < head.len() and j < cells.len() {
                let h = to_string(head[j]);
                let v = if h == "age" {
                    V.I(int_of(cells[j]))
                } else if h == "active" {
                    V.B(eq(cells[j], "yes"))
                } else {
                    V.S(cells[j].clone())
                };
                vals.push((head[j].clone(), v));
                j += 1;
            }
            out.push(Rec { vals: vals });
        }
        i += 1;
    }
    out
}

// ------------------------------------------------------------------ jobs

fn read_text(path: Str) -> Vec[i64] {
    match fs.read_bytes(f"data/{path}") {
        Ok(b) => codepoints(b),
        Err(_) => Vec.new(),
    }
}

fn block(s: Str) {
    if s.len() > 0 {
        for line in split_c(s.to_string(), '\n') {
            println(f"  {line}");
        }
    }
}

fn load(px: mut ref Px, rg: ref Gram, path: Str) -> Gram {
    match make_grammar(mut px, rg, read_text(path)) {
        Ok(g) => g,
        Err(e) => {
            eprintln(gerr_text(px, e));
            Gram { names: Vec.new(), exprs: Vec.new(), default: -1 }
        }
    }
}

fn run_visitor(px: mut ref Px, w: mut ref Work, vis: i64, e: i64, text: own Vec[i64]) -> Result[V, String] {
    let node = match expr_match(mut px, e, text, 0, true) {
        Ok(n) => n,
        Err(err) => return Err(perr_text(px, err)),
    };
    match visit(mut px, mut w, vis, node) {
        Ok(v) => Ok(v),
        Err(r) => Err(raised_text(r)),
    }
}

fn main() {
    if let Err(e) = write_inputs() {
        eprintln(e);
        return;
    }
    let mut px = new_px();
    let rg = rule_grammar(mut px);
    let calc = load(mut px, rg, "grammars/calc.peg");
    let jsong = load(mut px, rg, "grammars/json.peg");
    let ini = load(mut px, rg, "grammars/ini.peg");
    let query = load(mut px, rg, "grammars/query.peg");
    for hex in split_c(jobs_text(), '\n') {
        if hex.len() == 0 {
            continue;
        }
        let job = hex_string(hex);
        println(f"> {job}");
        let w = split_c(job, ' ');
        if w[0] == "rules" {
            println(f"  {rg.exprs.len()} rules, default {to_string(px.ex[rg.default].name)}");
            block(gram_str(px, rg));
        } else if w[0] == "grammar" {
            match make_grammar(mut px, rg, read_text(w[1])) {
                Ok(g) => {
                    let d = if g.default >= 0 { to_string(px.ex[g.default].name) } else { "None".to_string() };
                    println(f"  {g.exprs.len()} rules, default {d}");
                    block(gram_str(px, g));
                }
                Err(e) => block(gerr_text(px, e)),
            }
        } else if w[0] == "tree" or w[0] == "match" {
            let text = read_text(w[2]);
            let n = text.len();
            let g = match make_grammar(mut px, rg, read_text(w[1])) {
                Ok(g) => g,
                Err(e) => {
                    block(gerr_text(px, e));
                    continue;
                }
            };
            let e = if w.len() > 3 { gram_get(g, w[3]) } else { g.default };
            if e < 0 {
                block("RuntimeError: Can't call parse() on a Grammar that has no default rule. Choose a specific rule instead, like some_grammar['some_rule'].parse(...).");
                continue;
            }
            let node = match expr_match(mut px, e, text, 0, w[0] == "tree") {
                Ok(n) => n,
                Err(err) => {
                    block(perr_text(px, err));
                    continue;
                }
            };
            if w[0] == "match" {
                let mut q: Vec[i64] = Vec.new();
                str_repr(node_text(px, node), mut q);
                println(f"  matched {px.nodes[node].end} of {n}: {to_string(q)}");
            }
            block(pretty_text(px, node, -1));
        } else if w[0] == "!calc" {
            for line in split_on(read_text(w[1]), "\n") {
                if line.len() == 0 {
                    continue;
                }
                let mut q: Vec[i64] = Vec.new();
                str_repr(line, mut q);
                let mut wk = new_work();
                match run_visitor(mut px, mut wk, vis_calc(), calc.default, line.clone()) {
                    Ok(v) => println(f"  {to_string(q)} = {v_int(v)}"),
                    Err(e) => {
                        println(f"  {to_string(q)}");
                        block(e);
                    }
                }
            }
        } else if w[0] == "!json" {
            let mut wk = new_work();
            match run_visitor(mut px, mut wk, vis_json(), jsong.default, read_text(w[1])) {
                Ok(v) => {
                    println(f"  {dumps_of(v)}");
                    let mut out: Vec[String] = Vec.new();
                    leaves(v, "", mut out);
                    for l in out {
                        println(f"    {l}");
                    }
                }
                Err(e) => block(e),
            }
        } else if w[0] == "!ini" {
            let mut wk = new_work();
            match run_visitor(mut px, mut wk, vis_ini(), ini.default, read_text(w[1])) {
                Ok(V.D(secs)) => {
                    for s in secs {
                        println(f"  [{to_string(s.0)}]");
                        for p in v_dict(s.1) {
                            println(f"    {to_string(p.0)} = {py_value_repr(p.1)}");
                        }
                    }
                }
                Ok(_) => {}
                Err(e) => block(e),
            }
        } else if w[0] == "!query" {
            let recs = records(w[1]);
            for line in split_on(read_text(w[2]), "\n") {
                if line.len() == 0 {
                    continue;
                }
                let shown = to_string(line);
                let mut wk = new_work();
                let q = match run_visitor(mut px, mut wk, vis_query(), query.default, line.clone()) {
                    Ok(v) => v_q(v),
                    Err(e) => {
                        println(f"  {shown}");
                        block(e);
                        continue;
                    }
                };
                let mut names: Vec[Vec[i64]] = Vec.new();
                let mut failed = String.new();
                for r in recs {
                    match holds(wk, q, r) {
                        Ok(true) => names.push(v_str(rec_get(r, u("name")))),
                        Ok(false) => {}
                        Err(e) => {
                            failed = e;
                            break;
                        }
                    }
                }
                if failed.len() > 0 {
                    println(f"  {shown}");
                    block(failed);
                    continue;
                }
                let joined = if names.len() > 0 { to_string(join(names, ", ")) } else { "-".to_string() };
                println(f"  {shown}: {joined} ({names.len()})");
            }
        }
    }
}

fn v_dict(v: ref V) -> Vec[(Vec[i64], V)] {
    match v {
        V.D(d) => d.clone(),
        _ => Vec.new(),
    }
}

