> rules
  22 rules, default rules
  rules = _ rule*
  rule = label equals expression
  equals = '=' _
  literal = spaceless_literal _
  spaceless_literal = ~'u?r?b?"[^"\\\\]*(?:\\\\.[^"\\\\]*)*"'isu / ~"u?r?b?'[^'\\\\]*(?:\\\\.[^'\\\\]*)*'"isu
  expression = ored / sequence / term
  or_term = '/' _ term
  ored = term or_term+
  sequence = term term+
  not_term = '!' term _
  lookahead_term = '&' term _
  term = not_term / lookahead_term / quantified / atom
  quantified = atom quantifier
  atom = reference / literal / regex / parenthesized
  regex = '~' spaceless_literal ~'[ilmsuxa]*'iu _
  parenthesized = '(' _ expression ')' _
  quantifier = ~'[*+?]|\\{\\d*,\\d+\\}|\\{\\d+,\\d*\\}|\\{\\d+\\}'u _
  reference = label !equals
  label = ~'[a-zA-Z_][a-zA-Z_0-9]*(?!["\'])'u _
  _ = meaninglessness*
  meaninglessness = ~'\\s+'u / comment
  comment = ~'#[^\\r\\n]*'u
> grammar grammars/calc.peg
  13 rules, default line
  line = _ expr
  expr = term (addop term)*
  term = factor (mulop factor)*
  factor = number / paren / neg / call
  neg = '-' _ factor
  paren = '(' _ expr ')' _
  call = name '(' _ args? ')' _
  args = expr (',' _ expr)*
  addop = ~'[+-]'u _
  mulop = ~'[*/%]'u _
  number = ~'[0-9]+'u _
  name = ~'[a-z]+'u
  _ = ~'[ \\t]*'u
> grammar grammars/json.peg
  12 rules, default value
  value = _ (object / array / string / number / true / false / null) _
  object = '{' _ members? '}'
  members = pair (',' _ pair)*
  pair = string _ ':' value
  array = '[' _ items? ']'
  items = value (',' value)*
  string = ~'"(?:[^"\\\\\\x00-\\x1f]|\\\\["\\\\/bfnrt]|\\\\u[0-9a-fA-F]{4})*"'u
  number = ~'-?(?:0|[1-9][0-9]*)'u
  true = 'true'
  false = 'false'
  null = 'null'
  _ = ~'\\s*'u
> grammar grammars/ini.peg
  9 rules, default file
  file = (blank / comment / section / pair)*
  section = '[' ~'[^\\]\\n]+'u ']' _ nl
  pair = _ key _ ~'[:=]'u _ val nl
  key = ~'[A-Za-z0-9_.\\-]+'u
  val = ~'[^\\n]*'u
  comment = _ ~'[#;][^\\n]*'u nl
  blank = _ nl
  nl = '\n' / !~'.'su
  _ = ~'[ \\t]*'u
> grammar grammars/query.peg
  18 rules, default query
  query = _ disj
  disj = conj (kw_or conj)*
  conj = neg (kw_and neg)*
  neg = (kw_not neg) / atom
  atom = group / cmp / flag
  group = '(' _ disj ')' _
  cmp = field op value
  flag = field !op
  op = ~'<=|>=|!=|=|<|>|~'u _
  value = (number / string) _
  number = ~'-?[0-9]+'u
  string = ~'"[^"]*"'u
  field = !keyword ~'[a-z_]+'u _
  keyword = ~'(and|or|not)\\b'u
  kw_or = ~'or\\b'u _
  kw_and = ~'and\\b'u _
  kw_not = ~'not\\b'u _
  _ = ~'\\s*'u
> grammar grammars/greeting.peg
  5 rules, default greeting
  greeting = hello _ name punct?
  hello = ~'hello|hi'iu
  name = ~'[A-Z][a-z]+'u
  punct = '!' / '.'
  _ = ' '+
> grammar grammars/quant.peg
  7 rules, default row
  row = word{2,2} sep+ digit{,3} tail? &end rest
  word = ~'[a-z]+'u ' '
  sep = '-'
  digit = ~'[0-9]'u
  tail = !'x' ~'[a-z]'u
  end = ~'.'su
  rest = ~'.*'su
> grammar grammars/csv.peg
  5 rules, default file
  file = row*
  row = cell (',' cell)* '\n'
  cell = quoted / bare
  quoted = ~'"(?:[^"]|"")*"'u
  bare = ~'[^,\n]*'u
> grammar grammars/literals.peg
  2 rules, default lits
  lits = 'tab\there' "it's" 'say "hi"' 'back\\slash' 'café' 'A' '\\n'
  flags = ~'[a-z]+' ~' a  b 'ux ~'^x$'mu ~'X'isu
> grammar grammars/alias.peg
  2 rules, default salutation
  salutation = 'hi' / 'hello'
> grammar grammars/leftrec.peg
  2 rules, default expr
  expr = (expr '+' num) / num
  num = ~'[0-9]+'u
