// mini_unidiff: unidiff 0.7.5, Matias Bordese's unified diff parser, as
// code review bots, patch tools and CI checks in Python use it. It reads
// the job list from data/jobs.tsv: diffs to parse and dump, and four
// programs built on the parse (a diffstat, a patch applier, a review
// comment mapper and a scanner of added lines).
//
// unidiff reads a diff with the regexes in its constants module; here
// each regex is a function that matches the way Python's re does,
// backtracking included. Python's exceptions are Exc values: the class
// name and str(exc).

#[derive(Clone)]
struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: own String) -> Exc {
    Exc { kind: kind.to_string(), msg: msg }
}

fn parse_error(msg: own String) -> Exc {
    exc("UnidiffParseError", msg)
}

fn dev_null() -> String {
    "/dev/null".to_string()
}

fn chars_of(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn from_chars(c: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut s = String.new();
    for i in lo..hi {
        s.push(c[i]);
    }
    s
}

fn char_len(s: ref String) -> i64 {
    chars_of(s).len()
}

// s[2:], by characters.
fn drop2(s: ref String) -> String {
    let c = chars_of(s);
    if c.len() <= 2 { "".to_string() } else { from_chars(c, 2, c.len()) }
}

fn has_at(c: ref Vec[char], at: i64, lit: Str) -> bool {
    let l = chars_of(lit.to_string());
    if at + l.len() > c.len() {
        return false;
    }
    for k in 0..l.len() {
        if c[at + k] != l[k] {
            return false;
        }
    }
    true
}

fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

// Python's \s, on the characters a diff here can hold.
fn is_space(c: char) -> bool {
    c == ' ' or c == '\t' or c == '\n' or c == '\r'
}

// str.strip().
fn strip(s: ref String) -> String {
    let c = chars_of(s);
    let mut lo = 0;
    let mut hi = c.len();
    while lo < hi and is_space(c[lo]) {
        lo += 1;
    }
    while hi > lo and is_space(c[hi - 1]) {
        hi -= 1;
    }
    from_chars(c, lo, hi)
}

// How many characters from `at` are none of `stop`: a [^...]+ run.
fn run_without(c: ref Vec[char], at: i64, stop: Str) -> i64 {
    let s = chars_of(stop.to_string());
    let mut k = at;
    while k < c.len() and not s.contains(c[k]) {
        k += 1;
    }
    k - at
}

// RE_SOURCE_FILENAME and RE_TARGET_FILENAME: `^<lead>([^\t\n]+)(?:\t([^\n]+))?`.
fn match_filename(line: ref String, lead: Str) -> Option[(String, Option[String])] {
    let c = chars_of(line);
    if not has_at(c, 0, lead) {
        return None;
    }
    let at = chars_of(lead.to_string()).len();
    let n = run_without(c, at, "\t\n");
    if n == 0 {
        return None;
    }
    let name = from_chars(c, at, at + n);
    let mut stamp: Option[String] = None;
    let t = at + n;
    if t < c.len() and c[t] == '\t' {
        let m = run_without(c, t + 1, "\n");
        if m > 0 {
            stamp = Some(from_chars(c, t + 1, t + 1 + m));
        }
    }
    Some((name, stamp))
}

// RE_DIFF_GIT_HEADER: `^diff --git (a/[^\t\n]+) (b/[^\t\n]+)`.
fn match_git_header(line: ref String) -> Option[(String, String)] {
    let c = chars_of(line);
    if not has_at(c, 0, "diff --git a/") {
        return None;
    }
    let at = 11;
    let seg = run_without(c, at, "\t\n");
    // The greedy source ends at the last " b/" that leaves the target a
    // character.
    let mut i = at + seg - 4;
    while i >= at + 3 {
        if has_at(c, i, " b/") and i + 3 < at + seg {
            return Some((from_chars(c, at, i), from_chars(c, i + 1, at + seg)));
        }
        i -= 1;
    }
    None
}

// RE_DIFF_GIT_HEADER_NO_PREFIX: `^diff --git ([^\t\n]+) ([^\t\n]+)`.
fn match_git_header_no_prefix(line: ref String) -> Option[(String, String)] {
    let c = chars_of(line);
    if not has_at(c, 0, "diff --git ") {
        return None;
    }
    let at = 11;
    let seg = run_without(c, at, "\t\n");
    let mut i = at + seg - 2;
    while i >= at + 1 {
        if c[i] == ' ' {
            return Some((from_chars(c, at, i), from_chars(c, i + 1, at + seg)));
        }
        i -= 1;
    }
    None
}

// Where `.*://[^\t\n]+` starting at `from` can end, longest first: the
// .* takes the most it can, then the run does.
fn uri_ends(c: ref Vec[char], from: i64) -> Vec[i64] {
    let mut line_end = from;
    while line_end < c.len() and c[line_end] != '\n' {
        line_end += 1;
    }
    let mut out: Vec[i64] = Vec.new();
    let mut j = line_end - 3;
    while j >= from {
        if has_at(c, j, "://") {
            let n = run_without(c, j + 3, "\t\n");
            let mut k = n;
            while k >= 1 {
                out.push(j + 3 + k);
                k -= 1;
            }
        }
        j -= 1;
    }
    out
}

// RE_DIFF_GIT_HEADER_URI_LIKE: `^diff --git (.*://[^\t\n]+) (.*://[^\t\n]+)`.
fn match_git_header_uri(line: ref String) -> Option[(String, String)] {
    let c = chars_of(line);
    if not has_at(c, 0, "diff --git ") {
        return None;
    }
    let at = 11;
    for e in uri_ends(c, at) {
        if e < c.len() and c[e] == ' ' {
            let t = uri_ends(c, e + 1);
            if t.len() > 0 {
                return Some((from_chars(c, at, e), from_chars(c, e + 1, t[0])));
            }
        }
    }
    None
}

// `^<lead> \d+$`: the new and deleted file mode lines.
fn match_mode_line(line: ref String, lead: Str) -> bool {
    let c = chars_of(line);
    if not has_at(c, 0, lead) {
        return false;
    }
    let mut end = c.len();
    if end > 0 and c[end - 1] == '\n' {
        end -= 1;
    }
    let at = chars_of(lead.to_string()).len();
    if end <= at {
        return false;
    }
    for k in at..end {
        if not is_digit(c[k]) {
            return false;
        }
    }
    true
}

fn digits_at(c: ref Vec[char], at: i64) -> i64 {
    let mut k = at;
    while k < c.len() and is_digit(c[k]) {
        k += 1;
    }
    k - at
}

fn num_of(c: ref Vec[char], lo: i64, hi: i64) -> i64 {
    match i64.parse(from_chars(c, lo, hi)) {
        Ok(n) => n,
        Err(_) => 0,
    }
}

#[derive(Clone)]
struct HunkHead {
    src_start: i64,
    src_len: Option[i64],
    tgt_start: i64,
    tgt_len: Option[i64],
    section: String,
}

// RE_HUNK_HEADER: `^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))?\ @@[ ]?(.*)`.
fn match_hunk_header(line: ref String) -> Option[HunkHead] {
    let c = chars_of(line);
    if not has_at(c, 0, "@@ -") {
        return None;
    }
    let mut at = 4;
    let n = digits_at(c, at);
    if n == 0 {
        return None;
    }
    let src_start = num_of(c, at, at + n);
    at += n;
    let mut src_len: Option[i64] = None;
    if at < c.len() and c[at] == ',' {
        let m = digits_at(c, at + 1);
        if m == 0 {
            return None;
        }
        src_len = Some(num_of(c, at + 1, at + 1 + m));
        at += 1 + m;
    }
    if not has_at(c, at, " +") {
        return None;
    }
    at += 2;
    let n2 = digits_at(c, at);
    if n2 == 0 {
        return None;
    }
    let tgt_start = num_of(c, at, at + n2);
    at += n2;
    let mut tgt_len: Option[i64] = None;
    if at < c.len() and c[at] == ',' {
        let m = digits_at(c, at + 1);
        if m == 0 {
            return None;
        }
        tgt_len = Some(num_of(c, at + 1, at + 1 + m));
        at += 1 + m;
    }
    if not has_at(c, at, " @@") {
        return None;
    }
    at += 3;
    if at < c.len() and c[at] == ' ' {
        at += 1;
    }
    let n3 = run_without(c, at, "\n");
    Some(HunkHead {
        src_start: src_start,
        src_len: src_len,
        tgt_start: tgt_start,
        tgt_len: tgt_len,
        section: from_chars(c, at, at + n3),
    })
}

fn is_type_char(c: char) -> bool {
    c == '-' or c == ' ' or c == '+' or c == '\\'
}

// RE_HUNK_BODY_LINE, then RE_HUNK_EMPTY_BODY_LINE: the line's type and
// value.
fn match_body_line(line: ref String) -> Option[(String, String)] {
    let c = chars_of(line);
    if c.len() > 0 and is_type_char(c[0]) {
        return Some((from_chars(c, 0, 1), from_chars(c, 1, c.len())));
    }
    if c.len() > 0 and (c[0] == '\r' or c[0] == '\n') {
        let n = if c.len() > 1 and (c[1] == '\r' or c[1] == '\n') { 2 } else { 1 };
        return Some(("".to_string(), from_chars(c, 0, n)));
    }
    None
}

// One way the rest of RE_BINARY_DIFF can match from `at`: the target
// and where the match ends. `[\s0-9:\+-]+` is greedy and gives back.
fn stamp_chars(c: ref Vec[char], at: i64) -> i64 {
    let mut k = at;
    while k < c.len() and (is_space(c[k]) or is_digit(c[k]) or c[k] == ':' or c[k] == '+' or c[k] == '-') {
        k += 1;
    }
    k - at
}

fn binary_tail(c: ref Vec[char], at: i64) -> bool {
    has_at(c, at, " differ") or has_at(c, at, " has changed")
}

// After the source (and its timestamp): ` and <target>...` or nothing,
// then the tail. The target, if the and-group took part.
fn binary_rest(c: ref Vec[char], at: i64) -> Option[Option[String]] {
    if has_at(c, at, " and ") {
        let lo = at + 5;
        let mut e = lo + 1;
        while e <= c.len() and c[e - 1] != '\t' {
            // the timestamp group first, then without it
            if e < c.len() and c[e] == '\t' {
                let m = stamp_chars(c, e + 1);
                let mut k = m;
                while k >= 1 {
                    if binary_tail(c, e + 1 + k) {
                        return Some(Some(from_chars(c, lo, e)));
                    }
                    k -= 1;
                }
            }
            if binary_tail(c, e) {
                return Some(Some(from_chars(c, lo, e)));
            }
            e += 1;
        }
    }
    if binary_tail(c, at) {
        return Some(None);
    }
    None
}

// RE_BINARY_DIFF: `^Binary files? ([^\t]+?)(?:\t([\s0-9:\+-]+))?(?: and
// ([^\t]+?)(?:\t([\s0-9:\+-]+))?)? (differ|has changed)`: the source and
// target filenames.
fn match_binary(line: ref String) -> Option[(String, Option[String])] {
    let c = chars_of(line);
    let lo = if has_at(c, 0, "Binary files ") {
        13
    } else if has_at(c, 0, "Binary file ") {
        12
    } else {
        return None;
    };
    let mut e = lo + 1;
    while e <= c.len() and c[e - 1] != '\t' {
        if e < c.len() and c[e] == '\t' {
            let m = stamp_chars(c, e + 1);
            let mut k = m;
            while k >= 1 {
                if let Some(t) = binary_rest(c, e + 1 + k) {
                    return Some((from_chars(c, lo, e), t));
                }
                k -= 1;
            }
        }
        if let Some(t) = binary_rest(c, e) {
            return Some((from_chars(c, lo, e), t));
        }
        e += 1;
    }
    None
}

// Python's repr of a str.
fn str_repr(s: ref String) -> String {
    let mut out = String.new();
    let q = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    out.push(q);
    for c in s.chars() {
        if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == q {
            out.push('\\');
            out.push(c);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    out
}

fn opt_repr(s: ref Option[String]) -> String {
    match s {
        Some(ref v) => str_repr(v),
        None => "None".to_string(),
    }
}

fn opt_num(n: ref Option[i64]) -> String {
    match n {
        Some(v) => f"{v}",
        None => "None".to_string(),
    }
}

fn bool_repr(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

// The escaping the dump prints raw diff text with.
fn esc(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\n' {
            out.push_str("\\n");
        } else {
            out.push(c);
        }
    }
    out
}

// StringIO's lines: each ends after its \n.
fn split_lines_keep(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        cur.push(c);
        if c == '\n' {
            out.push(cur);
            cur = String.new();
        }
    }
    if cur.len() > 0 {
        out.push(cur);
    }
    out
}

// -------------------------------------------------------------- model

#[derive(Clone)]
struct Line {
    value: String,
    line_type: String,
    source_line_no: Option[i64],
    target_line_no: Option[i64],
    diff_line_no: Option[i64],
}

fn new_line(value: own String, line_type: own String) -> Line {
    Line { value: value, line_type: line_type, source_line_no: None, target_line_no: None, diff_line_no: None }
}

impl Line {
    fn is_added(ref self) -> bool {
        self.line_type == "+"
    }

    fn is_removed(ref self) -> bool {
        self.line_type == "-"
    }

    fn is_context(ref self) -> bool {
        self.line_type == " "
    }

    fn str(ref self) -> String {
        f"{self.line_type}{self.value}"
    }
}

#[derive(Clone)]
struct Hunk {
    source_start: i64,
    source_length: i64,
    target_start: i64,
    target_length: i64,
    section_header: String,
    lines: Vec[Line],
    meta_added: Option[i64],
    meta_removed: Option[i64],
}

impl Hunk {
    fn of(h: ref HunkHead) -> Hunk {
        Hunk {
            source_start: h.src_start,
            source_length: match h.src_len { Some(n) => n, None => 1 },
            target_start: h.tgt_start,
            target_length: match h.tgt_len { Some(n) => n, None => 1 },
            section_header: h.section.clone(),
            lines: Vec.new(),
            meta_added: None,
            meta_removed: None,
        }
    }

    fn repr(ref self) -> String {
        f"<Hunk: @@ {self.source_start},{self.source_length} {self.target_start},{self.target_length} @@ {self.section_header}>"
    }

    fn str(ref self) -> String {
        let section = if self.section_header.len() > 0 { f" {self.section_header}" } else { "".to_string() };
        let mut out = f"@@ -{self.source_start},{self.source_length} +{self.target_start},{self.target_length} @@{section}\n";
        for l in self.lines {
            out.push_str(l.str());
        }
        out
    }

    fn added(ref self) -> i64 {
        if let Some(n) = self.meta_added {
            return n;
        }
        let mut n = 0;
        for l in self.lines {
            if l.is_added() {
                n += 1;
            }
        }
        n
    }

    fn removed(ref self) -> i64 {
        if let Some(n) = self.meta_removed {
            return n;
        }
        let mut n = 0;
        for l in self.lines {
            if l.is_removed() {
                n += 1;
            }
        }
        n
    }

    fn is_valid(ref self) -> bool {
        let mut src = 0;
        let mut tgt = 0;
        for l in self.lines {
            if l.is_context() or l.is_removed() {
                src += 1;
            }
            if l.is_context() or l.is_added() {
                tgt += 1;
            }
        }
        src == self.source_length and tgt == self.target_length
    }
}

// A PatchedFile. Its patch info is shared with the parser, which goes on
// adding lines to it, so it lives in the PatchSet's `infos` and the file
// holds its index there (-1 for None).
#[derive(Clone)]
struct PatchedFile {
    info: i64,
    source_file: String,
    target_file: Option[String],
    source_timestamp: Option[String],
    target_timestamp: Option[String],
    is_binary_file: bool,
    hunks: Vec[Hunk],
}

fn new_file(info: i64, source: ref String, target: ref Option[String], st: ref Option[String], tt: ref Option[String], binary: bool) -> PatchedFile {
    PatchedFile {
        info: info,
        source_file: source.clone(),
        target_file: target.clone(),
        source_timestamp: st.clone(),
        target_timestamp: tt.clone(),
        is_binary_file: binary,
        hunks: Vec.new(),
    }
}

fn none_attr(name: Str) -> Exc {
    exc("AttributeError", f"'NoneType' object has no attribute '{name}'")
}

impl PatchedFile {
    fn target_is(ref self, s: Str) -> bool {
        match self.target_file {
            Some(ref t) => t == s,
            None => false,
        }
    }

    fn is_rename(ref self) -> Result[bool, Exc] {
        if self.source_file == "/dev/null" or self.target_is("/dev/null") {
            return Ok(false);
        }
        match self.target_file {
            Some(ref t) => Ok(drop2(self.source_file) != drop2(t)),
            None => Err(exc("TypeError", "'NoneType' object is not subscriptable".to_string())),
        }
    }

    fn path(ref self) -> Result[String, Exc] {
        let mut filepath = Some(self.source_file.clone());
        let to_target = if self.source_file == "/dev/null" {
            true
        } else {
            self.is_rename()? and not self.target_is("/dev/null") and self.target_file.is_some()
        };
        if to_target {
            filepath = self.target_file.clone();
        }
        match filepath {
            Some(p) => {
                if p.starts_with("a/") or p.starts_with("b/") { Ok(drop2(p)) } else { Ok(p) }
            }
            None => Err(none_attr("startswith")),
        }
    }

    fn repr(ref self) -> Result[String, Exc] {
        Ok(f"<PatchedFile: {self.path()?}>")
    }

    fn added(ref self) -> i64 {
        let mut n = 0;
        for h in self.hunks {
            n += h.added();
        }
        n
    }

    fn removed(ref self) -> i64 {
        let mut n = 0;
        for h in self.hunks {
            n += h.removed();
        }
        n
    }

    fn is_added_file(ref self) -> bool {
        if self.source_file == "/dev/null" {
            return true;
        }
        self.hunks.len() == 1 and self.hunks[0].source_start == 0 and self.hunks[0].source_length == 0
    }

    fn is_removed_file(ref self) -> bool {
        if self.target_is("/dev/null") {
            return true;
        }
        self.hunks.len() == 1 and self.hunks[0].target_start == 0 and self.hunks[0].target_length == 0
    }

    fn is_modified_file(ref self) -> bool {
        not (self.is_added_file() or self.is_removed_file())
    }

    // _parse_hunk: reads the hunk's lines from lines[*at], leaving *at
    // on the last line it read.
    fn parse_hunk(mut ref self, header: ref String, lines: ref Vec[String], at: mut ref i64, meta: bool) -> Result[(), Exc] {
        let head = match match_hunk_header(header) {
            Some(h) => h,
            None => return Err(parse_error("bad hunk header".to_string())),
        };
        let mut hunk = Hunk.of(head);
        let mut source_line_no = hunk.source_start;
        let mut target_line_no = hunk.target_start;
        let expected_source_end = source_line_no + hunk.source_length;
        let expected_target_end = target_line_no + hunk.target_length;
        let mut added = 0;
        let mut removed = 0;
        while *at + 1 < lines.len() {
            *at += 1;
            let line = lines[*at].clone();
            let diff_line_no = *at + 1;
            let mut original: Option[Line] = None;
            if meta {
                let line_type = match line.chars().next() {
                    Some(c) => c,
                    None => ' ',
                };
                if not is_type_char(line_type) {
                    return Err(parse_error(f"Hunk diff line expected: {line}"));
                }
                if line_type == '+' {
                    target_line_no += 1;
                    added += 1;
                } else if line_type == '-' {
                    source_line_no += 1;
                    removed += 1;
                } else if line_type == ' ' {
                    target_line_no += 1;
                    source_line_no += 1;
                }
            } else {
                let (kind, value) = match match_body_line(line) {
                    Some(m) => m,
                    None => return Err(parse_error(f"Hunk diff line expected: {line}")),
                };
                let line_type = if kind.len() == 0 { " ".to_string() } else { kind };
                let mut l = new_line(value, line_type.clone());
                if line_type == "+" {
                    l.target_line_no = Some(target_line_no);
                    target_line_no += 1;
                } else if line_type == "-" {
                    l.source_line_no = Some(source_line_no);
                    source_line_no += 1;
                } else if line_type == " " {
                    l.target_line_no = Some(target_line_no);
                    l.source_line_no = Some(source_line_no);
                    target_line_no += 1;
                    source_line_no += 1;
                }
                original = Some(l);
            }
            if source_line_no > expected_source_end or target_line_no > expected_target_end {
                return Err(parse_error("Hunk is longer than expected".to_string()));
            }
            if let Some(l) = original {
                let mut l = l;
                l.diff_line_no = Some(diff_line_no);
                hunk.lines.push(l);
            }
            if source_line_no == expected_source_end and target_line_no == expected_target_end {
                break;
            }
        }
        if source_line_no < expected_source_end or target_line_no < expected_target_end {
            return Err(parse_error("Hunk is shorter than expected".to_string()));
        }
        if meta {
            hunk.meta_added = Some(added);
            hunk.meta_removed = Some(removed);
        }
        self.hunks.push(hunk);
        Ok(())
    }

    fn add_no_newline_marker(mut ref self) -> Result[(), Exc] {
        let n = self.hunks.len();
        if n == 0 {
            return Err(parse_error("Unexpected marker: No newline at end of file".to_string()));
        }
        self.hunks[n - 1].lines.push(new_line(" No newline at end of file\n".to_string(), "\\".to_string()));
        Ok(())
    }

    fn append_trailing_empty_line(mut ref self) -> Result[(), Exc] {
        let n = self.hunks.len();
        if n == 0 {
            return Err(parse_error("Unexpected trailing newline character".to_string()));
        }
        self.hunks[n - 1].lines.push(new_line("\n".to_string(), "".to_string()));
        Ok(())
    }
}

struct PatchSet {
    files: Vec[PatchedFile],
    infos: Vec[Vec[String]],
}

fn info_repr(info: ref Vec[String]) -> String {
    f"<PatchInfo: {strip(info[0])}>"
}

impl PatchSet {
    fn parse(text: ref String, meta: bool) -> Result[PatchSet, Exc] {
        let mut ps = PatchSet { files: Vec.new(), infos: Vec.new() };
        let lines = split_lines_keep(text);
        // The parser's locals: the file and patch info it is on (-1 for
        // None), and the filenames the last header named.
        let mut current: i64 = -1;
        let mut info: i64 = -1;
        let mut source_file = "".to_string();
        let mut source_timestamp: Option[String] = None;
        let mut at: i64 = -1;
        while at + 1 < lines.len() {
            at += 1;
            let line = lines[at].clone();
            let mut git = match_git_header(line);
            if git.is_none() {
                git = match_git_header_uri(line);
            }
            if git.is_none() {
                git = match_git_header_no_prefix(line);
            }
            if let Some((src, tgt)) = git {
                ps.infos.push(Vec.new());
                info = ps.infos.len() - 1;
                source_file = src.clone();
                ps.files.push(new_file(info, src, Some(tgt), None, None, false));
                current = ps.files.len() - 1;
                ps.infos[info].push(line);
                continue;
            }
            if match_mode_line(line, "new file mode ") {
                if current < 0 or info < 0 {
                    return Err(parse_error(f"Unexpected new file found: {line}"));
                }
                ps.files[current].source_file = dev_null();
                ps.infos[info].push(line);
                continue;
            }
            if match_mode_line(line, "deleted file mode ") {
                if current < 0 or info < 0 {
                    return Err(parse_error(f"Unexpected deleted file found: {line}"));
                }
                ps.files[current].target_file = Some(dev_null());
                ps.infos[info].push(line);
                continue;
            }
            if let Some((src, stamp)) = match_filename(line, "--- ") {
                source_file = src;
                source_timestamp = stamp;
                if current >= 0 and ps.files[current].source_file != source_file {
                    current = -1;
                } else if current >= 0 {
                    ps.files[current].source_timestamp = source_timestamp.clone();
                }
                continue;
            }
            if let Some((tgt, stamp)) = match_filename(line, "+++ ") {
                if current >= 0 and not ps.files[current].target_is(tgt) {
                    return Err(parse_error(f"Target without source: {line}"));
                }
                if current < 0 {
                    ps.files.push(new_file(info, source_file, Some(tgt), source_timestamp, stamp, false));
                    current = ps.files.len() - 1;
                    info = -1;
                } else {
                    ps.files[current].target_timestamp = stamp;
                }
                continue;
            }
            if match_hunk_header(line).is_some() {
                info = -1;
                if current < 0 {
                    return Err(parse_error(f"Unexpected hunk found: {line}"));
                }
                ps.files[current].parse_hunk(line, lines, mut at, meta)?;
                continue;
            }
            if line.starts_with("\\ No newline at end of file") {
                if current < 0 {
                    return Err(parse_error(f"Unexpected marker: {line}"));
                }
                ps.files[current].add_no_newline_marker()?;
                continue;
            }
            if line == "\n" and current >= 0 {
                ps.files[current].append_trailing_empty_line()?;
                continue;
            }
            if info < 0 {
                current = -1;
                ps.infos.push(Vec.new());
                info = ps.infos.len() - 1;
            }
            if let Some((src, tgt)) = match_binary(line) {
                source_file = src.clone();
                ps.infos[info].push(line);
                if current >= 0 {
                    ps.files[current].is_binary_file = true;
                } else {
                    ps.files.push(new_file(info, src, tgt, None, None, true));
                }
                info = -1;
                current = -1;
                continue;
            }
            if line == "GIT binary patch\n" {
                if current < 0 {
                    return Err(none_attr("is_binary_file"));
                }
                ps.files[current].is_binary_file = true;
                info = -1;
                current = -1;
                continue;
            }
            ps.infos[info].push(line);
        }
        Ok(ps)
    }

    fn file_str(ref self, f: ref PatchedFile) -> String {
        let mut out = String.new();
        if f.info >= 0 {
            for l in self.infos[f.info] {
                out.push_str(l);
            }
        }
        if not f.is_binary_file and f.hunks.len() > 0 {
            let st = match f.source_timestamp {
                Some(ref t) => f"\t{t}",
                None => "".to_string(),
            };
            let tt = match f.target_timestamp {
                Some(ref t) => f"\t{t}",
                None => "".to_string(),
            };
            let target = match f.target_file {
                Some(ref t) => t.clone(),
                None => "None".to_string(),
            };
            out.push_str(f"--- {f.source_file}{st}\n+++ {target}{tt}\n");
        }
        for h in f.hunks {
            out.push_str(h.str());
        }
        out
    }

    fn str(ref self) -> String {
        let mut out = String.new();
        for f in self.files {
            out.push_str(self.file_str(f));
        }
        out
    }

    fn added(ref self) -> i64 {
        let mut n = 0;
        for f in self.files {
            n += f.added();
        }
        n
    }

    fn removed(ref self) -> i64 {
        let mut n = 0;
        for f in self.files {
            n += f.removed();
        }
        n
    }
}

// --------------------------------------------------------------- jobs

fn emit(out: mut ref String, s: ref String) {
    out.push_str(s);
    out.push_str("\n");
}

fn err_line(e: ref Exc) -> String {
    f"error: {e.kind}: {esc(e.msg)}"
}

// open(..., newline=None): \r\n and \r read as \n.
fn universal_newlines(s: ref String) -> String {
    let mut out = String.new();
    let mut after_cr = false;
    for c in s.chars() {
        if c == '\r' {
            out.push('\n');
            after_cr = true;
            continue;
        }
        if c == '\n' and after_cr {
            after_cr = false;
            continue;
        }
        after_cr = false;
        out.push(c);
    }
    out
}

fn load(rel: ref String) -> Result[PatchSet, Exc] {
    PatchSet.parse(read_text(rel), false)
}

fn paths(ps: ref PatchSet, which: i64) -> Result[String, Exc] {
    let mut parts: Vec[String] = Vec.new();
    for f in ps.files {
        let pick = if which == 0 {
            f.is_added_file()
        } else if which == 1 {
            f.is_removed_file()
        } else {
            f.is_modified_file()
        };
        if pick {
            parts.push(str_repr(f.path()?));
        }
    }
    Ok(f"[{parts.join(", ")}]")
}

fn dump(ps: ref PatchSet, text: ref String, out: mut ref String) -> Result[(), Exc] {
    emit(mut out, f"files: {ps.files.len()} added: {ps.added()} removed: {ps.removed()}");
    emit(mut out, f"added_files: {paths(ps, 0)?}");
    emit(mut out, f"removed_files: {paths(ps, 1)?}");
    emit(mut out, f"modified_files: {paths(ps, 2)?}");
    for f in ps.files {
        emit(mut out, f.repr()?);
        emit(mut out, f"  source={str_repr(f.source_file)} target={opt_repr(f.target_file)}");
        emit(mut out, f"  source_timestamp={opt_repr(f.source_timestamp)} target_timestamp={opt_repr(f.target_timestamp)}");
        let rename = f.is_rename()?;
        emit(mut out, f"  binary={bool_repr(f.is_binary_file)} rename={bool_repr(rename)} added_file={bool_repr(f.is_added_file())} removed_file={bool_repr(f.is_removed_file())} modified_file={bool_repr(f.is_modified_file())} +{f.added()} -{f.removed()}");
        if f.info < 0 {
            emit(mut out, "  info: None");
        } else {
            let info = ps.infos[f.info].clone();
            emit(mut out, f"  info: {info_repr(info)}, {info.len()} lines");
            for l in info {
                emit(mut out, f"  | {esc(l)}");
            }
        }
        for h in f.hunks {
            emit(mut out, f"  {h.repr()}");
            emit(mut out, f"    section={str_repr(h.section_header)} added={h.added()} removed={h.removed()} valid={bool_repr(h.is_valid())} lines={h.lines.len()}");
            for l in h.lines {
                emit(mut out, f"    {str_repr(l.line_type)} {str_repr(l.value)} src={opt_num(l.source_line_no)} tgt={opt_num(l.target_line_no)} diff={opt_num(l.diff_line_no)}");
            }
        }
    }
    let s = ps.str();
    if s == text {
        emit(mut out, "str: same");
    } else {
        emit(mut out, "str: differs");
        for l in split_lines_keep(s) {
            emit(mut out, f"  > {esc(l)}");
        }
    }
    Ok(())
}

fn parse_job(rel: ref String, mode: ref String, out: mut ref String) -> Result[(), Exc] {
    let mut text = read_text(rel);
    if mode == "file" {
        text = universal_newlines(text);
    }
    let ps = PatchSet.parse(text, mode == "meta")?;
    dump(ps, text, mut out)
}

fn pad_right(s: ref String, w: i64) -> String {
    let mut out = s.clone();
    let mut n = char_len(s);
    while n < w {
        out.push(' ');
        n += 1;
    }
    out
}

fn pad_left(s: ref String, w: i64) -> String {
    let mut out = String.new();
    let mut n = char_len(s);
    while n < w {
        out.push(' ');
        n += 1;
    }
    out.push_str(s);
    out
}

fn repeat(c: char, n: i64) -> String {
    let mut out = String.new();
    for _ in 0..n {
        out.push(c);
    }
    out
}

fn plural(n: i64) -> String {
    if n == 1 { "".to_string() } else { "s".to_string() }
}

fn stat_job(rel: ref String, out: mut ref String) -> Result[(), Exc] {
    let ps = load(rel)?;
    let width = 40;
    let mut most = 0;
    let mut name_w = 0;
    for f in ps.files {
        most = if f.added() + f.removed() > most { f.added() + f.removed() } else { most };
    }
    for f in ps.files {
        let w = char_len(f.path()?);
        name_w = if w > name_w { w } else { name_w };
    }
    for f in ps.files {
        let n = f.added() + f.removed();
        let name = pad_right(f.path()?, name_w);
        if f.is_binary_file {
            emit(mut out, f" {name} | Bin");
            continue;
        }
        let mut plus = f.added();
        let mut minus = f.removed();
        if most > width {
            plus = if f.added() > 0 { (f.added() * width + most - 1) / most } else { 0 };
            minus = if f.removed() > 0 { (f.removed() * width + most - 1) / most } else { 0 };
        }
        emit(mut out, f" {name} | {pad_left(f"{n}", 4)} {repeat('+', plus)}{repeat('-', minus)}");
    }
    let files = ps.files.len();
    let a = ps.added();
    let r = ps.removed();
    emit(mut out, f" {files} file{plural(files)} changed, {a} insertion{plural(a)}(+), {r} deletion{plural(r)}(-)");
    Ok(())
}

fn strip_prefix(name: ref String, p: Str) -> String {
    if name.starts_with(p) { drop2(name) } else { name.clone() }
}

fn line_count(s: ref String) -> i64 {
    split_lines_keep(s).len()
}

// Applies f's hunks to orig (backwards when reverse): the result, or why
// a hunk does not fit.
fn apply_file(f: ref PatchedFile, orig: ref String, reverse: bool) -> Result[String, String] {
    let lines = split_lines_keep(orig);
    let mut out = String.new();
    let mut pos = 0;
    let mut n = 0;
    for h in f.hunks {
        n += 1;
        let start = if reverse { h.target_start } else { h.source_start };
        let length = if reverse { h.target_length } else { h.source_length };
        let at = if length > 0 { start - 1 } else { start };
        if at < pos or at > lines.len() {
            return Err(f"hunk #{n} FAILED at {start}");
        }
        while pos < at {
            out.push_str(lines[pos]);
            pos += 1;
        }
        let body = h.lines.clone();
        let mut i = 0;
        while i < body.len() {
            let mut kind = body[i].line_type.clone();
            if kind == "\\" or kind == "" {
                i += 1;
                continue;
            }
            if reverse and kind == "+" {
                kind = "-".to_string();
            } else if reverse and kind == "-" {
                kind = "+".to_string();
            }
            let mut value = body[i].value.clone();
            if i + 1 < body.len() and body[i + 1].line_type == "\\" and value.ends_with("\n") {
                value = value[0..value.len() - 1].to_string();
            }
            i += 1;
            if kind == "+" {
                out.push_str(value);
                continue;
            }
            if pos >= lines.len() or lines[pos] != value {
                return Err(f"hunk #{n} FAILED at {start}");
            }
            pos += 1;
            if kind == " " {
                out.push_str(value);
            }
        }
    }
    while pos < lines.len() {
        out.push_str(lines[pos]);
        pos += 1;
    }
    Ok(out)
}

fn read_or_none(rel: ref String) -> Option[String] {
    match fs.read_to_string(f"data/{rel}") {
        Ok(s) => Some(s),
        Err(_) => None,
    }
}

fn apply_job(rel: ref String, base: ref String, want: ref String, reverse: bool, out: mut ref String) -> Result[(), Exc] {
    let ps = load(rel)?;
    let mut ok = 0;
    for f in ps.files {
        let mut src = strip_prefix(f.source_file, "a/");
        let target = match f.target_file {
            Some(ref t) => t.clone(),
            None => "None".to_string(),
        };
        let mut dst = strip_prefix(target, "b/");
        if reverse {
            let t = src;
            src = dst;
            dst = t;
        }
        let path = f.path()?;
        if f.is_binary_file {
            emit(mut out, f"{path}: binary, skipped");
            continue;
        }
        let orig = if src == "/dev/null" { Some("".to_string()) } else { read_or_none(f"{base}/{src}") };
        let text = match orig {
            Some(t) => t,
            None => {
                emit(mut out, f"{path}: {src} is missing");
                continue;
            }
        };
        let result = match apply_file(f, text, reverse) {
            Ok(r) => r,
            Err(why) => {
                emit(mut out, f"{path}: {why}");
                continue;
            }
        };
        if dst == "/dev/null" {
            let empty = result.len() == 0;
            emit(mut out, f"{path}: deleted, {if empty { "empty" } else { "NOT EMPTY" }}");
            if empty {
                ok += 1;
            }
            continue;
        }
        let same = match read_or_none(f"{want}/{dst}") {
            Some(e) => e == result,
            None => false,
        };
        if same {
            ok += 1;
        }
        emit(mut out, f"{path} -> {dst}: {line_count(result)} lines, {if same { "matches" } else { "DIFFERS" }}");
    }
    emit(mut out, f"{ok} of {ps.files.len()} files ok");
    Ok(())
}

fn lines_of(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for l in split_lines_keep(s) {
        if l.ends_with("\n") {
            out.push(l[0..l.len() - 1].to_string());
        } else {
            out.push(l.clone());
        }
    }
    out
}

fn position_job(rel: ref String, comments: ref String, out: mut ref String) -> Result[(), Exc] {
    let ps = load(rel)?;
    for c in lines_of(read_text(comments)) {
        let parts: Vec[String] = c.split("\t").map(|p| p.to_string()).collect();
        let name = parts[0].clone();
        let no = match i64.parse(parts[1].clone()) {
            Ok(n) => n,
            Err(_) => 0,
        };
        let mut found: i64 = -1;
        let mut k = 0;
        while k < ps.files.len() {
            if ps.files[k].path()? == name and found < 0 {
                found = k;
            }
            k += 1;
        }
        if found < 0 {
            emit(mut out, f"{name}:{no}: file not in diff");
            continue;
        }
        let mut pos = 0;
        let mut hit: Option[(i64, Line)] = None;
        let mut first = true;
        for h in ps.files[found].hunks {
            if not first {
                pos += 1;
            }
            first = false;
            for l in h.lines {
                pos += 1;
                if hit.is_none() and l.target_line_no == Some(no) and (l.line_type == "+" or l.line_type == " ") {
                    hit = Some((pos, l.clone()));
                }
            }
        }
        match hit {
            None => emit(mut out, f"{name}:{no}: outside the diff"),
            Some((p, l)) => {
                let kind = if l.is_added() { "added" } else { "context" };
                emit(mut out, f"{name}:{no}: position {p}, {kind}, diff line {opt_num(l.diff_line_no)}");
            }
        }
    }
    Ok(())
}

fn scan_job(rel: ref String, rules: ref String, out: mut ref String) -> Result[(), Exc] {
    let ps = load(rel)?;
    let words = lines_of(read_text(rules));
    let mut hits = 0;
    for f in ps.files {
        for h in f.hunks {
            for l in h.lines {
                if not l.is_added() {
                    continue;
                }
                for w in words {
                    if l.value.contains(w) {
                        hits += 1;
                        emit(mut out, f"{f.path()?}:{opt_num(l.target_line_no)}: {w}: {esc(strip(l.value))}");
                    }
                }
            }
        }
    }
    emit(mut out, f"{hits} findings");
    Ok(())
}
// ------------------------------------------------------------ the jobs

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data_files() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        if let Err(e) = fs.write(f"data/{file.path}", file.body.clone()) {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn read_text(rel: ref String) -> String {
    match fs.read_to_string(f"data/{rel}") {
        Ok(s) => s,
        Err(_) => "".to_string(),
    }
}

fn run_job(job: ref Vec[String], out: mut ref String) -> Result[(), Exc] {
    let kind = job[0].clone();
    if kind == "parse" {
        parse_job(job[1], job[2], mut out)
    } else if kind == "stat" {
        stat_job(job[1], mut out)
    } else if kind == "apply" {
        apply_job(job[1], job[2], job[3], false, mut out)
    } else if kind == "revert" {
        apply_job(job[1], job[2], job[3], true, mut out)
    } else if kind == "position" {
        position_job(job[1], job[2], mut out)
    } else {
        scan_job(job[1], job[2], mut out)
    }
}

fn main() {
    if let Err(e) = write_data_files() {
        eprintln(e);
        return;
    }
    let mut out = String.new();
    for line in lines_of(read_text("jobs.tsv".to_string())) {
        let job: Vec[String] = line.split("\t").map(|p| p.to_string()).collect();
        emit(mut out, f"== {job.join(" ")}");
        // A parse error, or a property of a file the parser left
        // half-built (a binary file with no target).
        if let Err(e) = run_job(job, mut out) {
            emit(mut out, err_line(e));
        }
    }
    print(out);
}
// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    data_part_3(mut v);
    data_part_4(mut v);
    data_part_5(mut v);
    data_part_6(mut v);
    data_part_7(mut v);
    data_part_8(mut v);
    data_part_9(mut v);
    data_part_10(mut v);
    data_part_11(mut v);
    data_part_12(mut v);
    data_part_13(mut v);
    data_part_14(mut v);
    data_part_15(mut v);
    data_part_16(mut v);
    data_part_17(mut v);
    data_part_18(mut v);
    data_part_19(mut v);
    data_part_20(mut v);
    v
}

fn data_part_0(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("--- a/x\n");
    t.push_str("+++ b/x\n");
    t.push_str("@@ -1,2 +1,2 @@\n");
    t.push_str(" one\n");
    t.push_str("*two\n");
    v.push(DataFile { path: "extra/bad_body_line.diff".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("Binary file build/app.wasm has changed\n");
    t.push_str("Binary files only/a differ\n");
    v.push(DataFile { path: "extra/binary_no_target.diff".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("Binary files a/x and y.png and b/x and y.png differ\n");
    t.push_str("Binary files a/s.db\t2024-01-02 10:11:12 +0100 and b/s.db\t2024-01-03 09:00:00 +0100 differ\n");
