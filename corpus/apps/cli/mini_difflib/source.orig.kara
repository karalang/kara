    s.push_str("from collections import OrderedDict\n");
    s.push_str("\n");
    s.push_str("\n");
    s.push_str("class Cache:\n");
    s.push_str("    \"\"\"A cache whose entries expire, holding at most max_size entries.\"\"\"\n");
    s.push_str("\n");
    s.push_str("    def __init__(self, ttl, max_size=128):\n");
    s.push_str("        self.ttl = ttl\n");
    s.push_str("        self.max_size = max_size\n");
    s.push_str("        self.data = OrderedDict()\n");
    s.push_str("\n");
    s.push_str("    def get(self, key, default=None):\n");
    s.push_str("        if key not in self.data:\n");
    s.push_str("            return default\n");
    s.push_str("        value, stamp = self.data[key]\n");
    s.push_str("        if time.monotonic() - stamp > self.ttl:\n");
    s.push_str("            del self.data[key]\n");
    s.push_str("            return default\n");
    s.push_str("        self.data.move_to_end(key)\n");
    s.push_str("        return value\n");
    s.push_str("\n");
    s.push_str("    def put(self, key, value):\n");
    s.push_str("        self.data[key] = (value, time.monotonic())\n");
    s.push_str("        self.data.move_to_end(key)\n");
    s.push_str("        while len(self.data) > self.max_size:\n");
    s.push_str("            self.data.popitem(last=False)\n");
    s.push_str("\n");
    s.push_str("    def __len__(self):\n");
    s.push_str("        return len(self.data)\n");
    v.push(("cache.py".to_string(), s));
