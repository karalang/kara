    s.push_str("\n");
    s.push_str("\n");
    s.push_str("class Cache:\n");
    s.push_str("    \"\"\"A cache whose entries expire.\"\"\"\n");
    s.push_str("\n");
    s.push_str("    def __init__(self, ttl):\n");
    s.push_str("        self.ttl = ttl\n");
    s.push_str("        self.data = {}\n");
    s.push_str("\n");
    s.push_str("    def get(self, key):\n");
    s.push_str("        if key not in self.data:\n");
    s.push_str("            return None\n");
    s.push_str("        value, stamp = self.data[key]\n");
    s.push_str("        if time.time() - stamp > self.ttl:\n");
    s.push_str("            del self.data[key]\n");
    s.push_str("            return None\n");
    s.push_str("        return value\n");
    s.push_str("\n");
    s.push_str("    def put(self, key, value):\n");
    s.push_str("        self.data[key] = (value, time.time())\n");
    s.push_str("\n");
    s.push_str("    def size(self):\n");
    s.push_str("        return len(self.data)\n");
