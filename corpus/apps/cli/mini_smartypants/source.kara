// mini_smartypants: a port of smartypants 2.0.2 (BSD-3; John Gruber, Chad
// Miller, Yu-Jie Lin, Leo Hemsted, Justin Mayer), the filter a static-site
// generator runs its HTML through to turn straight quotes, double dashes
// and three dots into curly quotes, dashes and ellipses, leaving code,
// scripts and styles alone. It replays data/jobs.tsv (see mk.py): calls on
// smartypants() and each converter, the posts of a small blog under
// data/posts/, and the `smartypants` command run over them.
//
// Text is held as a Vec of code points. The library's regular expressions
// are read off the vendored module (regex_text()) and compiled here for a
// backtracking matcher that tries alternatives in order, as Python's re
// does.

// ------------------------------------------------------------ code points

fn chr_of(n: i64) -> char {
    match char.try_from(n) {
        Ok(c) => c,
        Err(_) => '?',
    }
}

fn cps_of(s: ref String) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s.chars() {
        out.push(c as i64);
    }
    out
}

fn cps_str(cs: ref Vec[i64]) -> String {
    let mut s = String.new();
    for c in cs {
        s.push(chr_of(*c));
    }
    s
}

fn lit(s: Str) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s.chars() {
        out.push(c as i64);
    }
    out
}

fn sub(cs: ref Vec[i64], lo: i64, hi: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let end = if hi > cs.len() { cs.len() } else { hi };
    let mut k = if lo < 0 { 0 } else { lo };
    while k < end {
        out.push(cs[k]);
        k += 1;
    }
    out
}

fn push_all(out: mut ref Vec[i64], xs: ref Vec[i64]) {
    for x in xs {
        out.push(*x);
    }
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut k = 0;
    while k < a.len() {
        if a[k] != b[k] {
            return false;
        }
        k += 1;
    }
    true
}

fn starts_with(cs: ref Vec[i64], at: i64, p: ref Vec[i64]) -> bool {
    if at + p.len() > cs.len() {
        return false;
    }
    let mut k = 0;
    while k < p.len() {
        if cs[at + k] != p[k] {
            return false;
        }
        k += 1;
    }
    true
}

// str.replace(old, new): non-overlapping, left to right.
fn replace_all(cs: ref Vec[i64], old: ref Vec[i64], new: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < cs.len() {
        if old.len() > 0 and starts_with(cs, k, old) {
            push_all(mut out, new);
            k += old.len();
        } else {
            out.push(cs[k]);
            k += 1;
        }
    }
    out
}

// `x in s` for a substring.
fn contains(cs: ref Vec[i64], p: ref Vec[i64]) -> bool {
    let mut k = 0;
    while k + p.len() <= cs.len() {
        if starts_with(cs, k, p) {
            return true;
        }
        k += 1;
    }
    false
}

fn hex_digits(n: i64, width: i64) -> String {
    let d: Vec[char] = "0123456789abcdef".chars().collect();
    let mut out = String.new();
    let mut k = width;
    while k > 0 {
        k -= 1;
        out.push(d[(n >> (4 * k)) & 15]);
    }
    out
}

fn hex_val(c: char) -> i64 {
    if c >= '0' and c <= '9' {
        c as i64 - 48
    } else if c >= 'a' and c <= 'f' {
        c as i64 - 87
    } else if c >= 'A' and c <= 'F' {
        c as i64 - 55
    } else {
        -1
    }
}

fn hex_num(s: ref String) -> i64 {
    let mut v = 0;
    for c in s.chars() {
        v = v * 16 + hex_val(c);
    }
    v
}

// The text a run of hex digit pairs spells in UTF-8, as code points.
fn hex_text(s: ref String) -> Vec[i64] {
    let cs: Vec[char] = s.chars().collect();
    let mut bytes: Vec[u8] = Vec.new();
    let mut k = 0;
    while k + 1 < cs.len() {
        bytes.push((hex_val(cs[k]) * 16 + hex_val(cs[k + 1])) as u8);
        k += 2;
    }
    utf8_cps(bytes)
}

fn utf8_cps(bytes: own Vec[u8]) -> Vec[i64] {
    match String.from_utf8(bytes) {
        Ok(s) => cps_of(s),
        Err(_) => Vec.new(),
    }
}

fn split_on(s: ref String, sep: char) -> Vec[String] {
    let mut pieces: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            pieces.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    pieces.push(cur);
    pieces
}

fn split_cps(cs: ref Vec[i64], sep: i64) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    for c in cs {
        if *c == sep {
            out.push(cur);
            cur = Vec.new();
        } else {
            cur.push(*c);
        }
    }
    out.push(cur);
    out
}

fn lower(cs: ref Vec[i64]) -> Vec[i64] {
    cps_of(cps_str(cs).to_lowercase())
}

// ------------------------------------------------------------ Unicode data

// Sorted, non-overlapping [lo, hi] runs, flattened.
fn in_runs(rs: ref Vec[i64], cp: i64) -> bool {
    let mut lo = 0;
    let mut hi = rs.len() / 2;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if rs[2 * mid + 1] < cp {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    lo < rs.len() / 2 and rs[2 * lo] <= cp
}

// str.isalnum(), isdecimal(), isspace() and isprintable() as runs (see
// unicode_text()).
struct Uni {
    alnum: Vec[i64],
    decimal: Vec[i64],
    space: Vec[i64],
    nonprint: Vec[i64],
}

fn load_uni() -> Uni {
    let mut u = Uni { alnum: Vec.new(), decimal: Vec.new(), space: Vec.new(), nonprint: Vec.new() };
    for line in split_on(unicode_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let tag = line.substring(0, 1);
        let f = split_on(line.substring(1, line.len()), ' ');
        let lo = hex_num(f[0]);
        let hi = hex_num(f[1]);
        if tag == "W" {
            u.alnum.push(lo);
            u.alnum.push(hi);
        } else if tag == "9" {
            u.decimal.push(lo);
            u.decimal.push(hi);
        } else if tag == "S" {
            u.space.push(lo);
            u.space.push(hi);
        } else {
            u.nonprint.push(lo);
            u.nonprint.push(hi);
        }
    }
    u
}

// ------------------------------------------------------------ repr()

fn char_esc(n: i64) -> String {
    if n < 0x100 {
        f"\\x{hex_digits(n, 2)}"
    } else if n < 0x10000 {
        f"\\u{hex_digits(n, 4)}"
    } else {
        f"\\U{hex_digits(n, 8)}"
    }
}

fn has(cs: ref Vec[i64], x: i64) -> bool {
    for c in cs {
        if *c == x {
            return true;
        }
    }
    false
}

fn str_repr(u: ref Uni, cs: ref Vec[i64]) -> String {
    let q: i64 = if has(cs, 39) and not has(cs, 34) { 34 } else { 39 };
    let mut out = String.new();
    out.push(chr_of(q));
    for c in cs {
        let n = *c;
        if n == q or n == 92 {
            out.push('\\');
            out.push(chr_of(n));
        } else if n == 10 {
            out.push_str("\\n");
        } else if n == 13 {
            out.push_str("\\r");
        } else if n == 9 {
            out.push_str("\\t");
        } else if n < 0x20 or n == 0x7f {
            out.push_str(char_esc(n));
        } else if n < 0x7f or not in_runs(u.nonprint, n) {
            out.push(chr_of(n));
        } else {
            out.push_str(char_esc(n));
        }
    }
    out.push(chr_of(q));
    out
}

fn list_repr(u: ref Uni, items: ref Vec[Vec[i64]]) -> String {
    let mut s = "[".to_string();
    let mut k = 0;
    while k < items.len() {
        if k > 0 {
            s.push_str(", ");
        }
        s.push_str(str_repr(u, items[k]));
        k += 1;
    }
    s.push_str("]");
    s
}

// ------------------------------------------------------------ regular expressions
//
// A backtracking matcher for the part of Python's re these patterns use:
// literals and escapes, classes with ranges and \s \w \d, ".", "^" and
// "$", \b and \B, capturing and non-capturing groups, the four lookaround
// assertions, alternation, the * + ? {m} {m,n} quantifiers (greedy or
// lazy), and the IGNORECASE, DOTALL and VERBOSE flags. Classes are
// Unicode's, as for a str pattern.

// One instruction. Jump targets are offsets from the instruction itself,
// so a compiled piece can be copied (a quantifier repeats it) unchanged.
#[derive(Clone)]
struct Inst {
    op: i64,
    x: i64,
    y: i64,
    z: i64,
}

const OP_CHAR: i64 = 0;
const OP_ANY: i64 = 1;
const OP_CLASS: i64 = 2;
const OP_SPLIT: i64 = 3;
const OP_JMP: i64 = 4;
const OP_BOL: i64 = 5;
const OP_EOL: i64 = 6;
const OP_LOOK: i64 = 7;
const OP_MATCH: i64 = 8;
const OP_SAVE: i64 = 9;
const OP_WORDB: i64 = 10;
// A one-character atom repeated x..y times (z: lazy); the atom is the
// next instruction and the rest of the program follows it.
const OP_REP: i64 = 11;

fn inst(op: i64, x: i64, y: i64, z: i64) -> Inst {
    Inst { op: op, x: x, y: y, z: z }
}

// A character class: [lo, hi] runs, and the categories it includes
// (1 \s, 2 \w, 3 \d; negative for \S \W \D).
#[derive(Clone)]
struct Cls {
    neg: bool,
    runs: Vec[i64],
    cats: Vec[i64],
}

// A compiled piece of a pattern and the range of lengths it matches.
struct Frag {
    code: Vec[Inst],
    minw: i64,
    maxw: i64,
}

const INF: i64 = 1000000000;

fn frag(code: own Vec[Inst], minw: i64, maxw: i64) -> Frag {
    Frag { code: code, minw: minw, maxw: maxw }
}

const IGNORECASE: i64 = 2;
const DOTALL: i64 = 16;
const VERBOSE: i64 = 64;

struct Regex {
    prog: Vec[Inst],
    classes: Vec[Cls],
    groups: i64,
    icase: bool,
    dotall: bool,
    // The one-character instructions a match can begin with, so search()
    // tries only the positions one of them accepts (any_start: a match
    // can begin anywhere, or be empty).
    firsts: Vec[i64],
    any_start: bool,
}

struct ReParser {
    src: Vec[i64],
    pos: i64,
    verbose: bool,
    classes: Vec[Cls],
    groups: i64,
}

fn is_hex(c: i64) -> bool {
    (c >= 48 and c <= 57) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)
}

impl ReParser {
    fn more(ref self) -> bool {
        self.pos < self.src.len()
    }

    fn peek(ref self) -> i64 {
        if self.pos < self.src.len() { self.src[self.pos] } else { -1 }
    }

    // VERBOSE: whitespace and comments outside a class are ignored.
    fn skip_ws(mut ref self) {
        if not self.verbose {
            return;
        }
        while self.more() {
            let c = self.peek();
            if c == 32 or c == 9 or c == 10 or c == 13 or c == 11 or c == 12 {
                self.pos += 1;
            } else if c == 35 {
                while self.more() and self.peek() != 10 {
                    self.pos += 1;
                }
            } else {
                return;
            }
        }
    }

    fn add_class(mut ref self, c: Cls) -> i64 {
        self.classes.push(c.clone());
        self.classes.len() - 1
    }

    // The escape after a backslash: a code point, or a category as a
    // negative number (-1 \s, -2 \w, -3 \d, -11 \S, -12 \W, -13 \D).
    fn escape(mut ref self) -> i64 {
        let c = self.peek();
        self.pos += 1;
        let cats = lit("swdSWD");
        let mut k = 0;
        while k < 6 {
            if c == cats[k] {
                return if k < 3 { -(k + 1) } else { -(k + 8) };
            }
            k += 1;
        }
        let digits = if c == 120 { 2 } else if c == 117 { 4 } else if c == 85 { 8 } else { 0 };
        if digits > 0 {
            let mut v = 0;
            let mut n = 0;
            while n < digits and is_hex(self.peek()) {
                v = v * 16 + hex_val(chr_of(self.peek()));
                self.pos += 1;
                n += 1;
            }
            return v;
        }
        if c == 110 {
            return 10;
        }
        if c == 116 {
            return 9;
        }
        if c == 114 {
            return 13;
        }
        if c == 102 {
            return 12;
        }
        if c == 118 {
            return 11;
        }
        if c == 97 {
            return 7;
        }
        c
    }

    fn class_cat(mut ref self, e: i64) -> i64 {
        let cat = if e > -10 { -e } else { -(-e - 10) };
        let c = Cls { neg: false, runs: Vec.new(), cats: vec![cat] };
        self.add_class(c)
    }

    fn parse_class(mut ref self) -> i64 {
        let mut c = Cls { neg: false, runs: Vec.new(), cats: Vec.new() };
        if self.peek() == 94 {
            c.neg = true;
            self.pos += 1;
        }
        let mut first = true;
        while self.more() {
            let ch = self.peek();
            if ch == 93 and not first {
                self.pos += 1;
                break;
            }
            first = false;
            self.pos += 1;
            let lo = if ch == 92 { self.escape() } else { ch };
            if lo < 0 {
                c.cats.push(if lo > -10 { -lo } else { -(-lo - 10) });
                continue;
            }
            if self.peek() == 45 and self.pos + 1 < self.src.len() and self.src[self.pos + 1] != 93 {
                self.pos += 1;
                let h = self.peek();
                self.pos += 1;
                let hi = if h == 92 { self.escape() } else { h };
                c.runs.push(lo);
                c.runs.push(hi);
            } else {
                c.runs.push(lo);
                c.runs.push(lo);
            }
        }
        c.runs = merge_runs(c.runs);
        self.add_class(c)
    }

    fn parse_alt(mut ref self) -> Frag {
        let mut branches: Vec[Frag] = Vec.new();
        branches.push(self.parse_seq());
        while self.peek() == 124 {
            self.pos += 1;
            branches.push(self.parse_seq());
        }
        if branches.len() == 1 {
            return branches.pop().unwrap();
        }
        let mut minw = INF;
        let mut maxw = 0;
        let mut total = 0;
        for b in branches.iter() {
            total += b.code.len() + 2;
            if b.minw < minw {
                minw = b.minw;
            }
            if b.maxw > maxw {
                maxw = b.maxw;
            }
        }
        total -= 2;
        let mut code: Vec[Inst] = Vec.new();
        let n = branches.len();
        let mut k = 0;
        for b in branches.iter() {
            if k < n - 1 {
                code.push(inst(OP_SPLIT, 1, b.code.len() + 2, 0));
            }
            for i in b.code.iter() {
                code.push(i.clone());
            }
            if k < n - 1 {
                code.push(inst(OP_JMP, total - code.len(), 0, 0));
            }
            k += 1;
        }
        frag(code, minw, maxw)
    }

    fn parse_seq(mut ref self) -> Frag {
        let mut code: Vec[Inst] = Vec.new();
        let mut minw = 0;
        let mut maxw = 0;
        loop {
            self.skip_ws();
            let c = self.peek();
            if c < 0 or c == 124 or c == 41 {
                break;
            }
            let atom = self.parse_atom();
            let piece = self.parse_quant(atom);
            for i in piece.code.iter() {
                code.push(i.clone());
            }
            minw += piece.minw;
            maxw = if maxw >= INF or piece.maxw >= INF { INF } else { maxw + piece.maxw };
        }
        frag(code, minw, maxw)
    }

    fn parse_atom(mut ref self) -> Frag {
        let c = self.peek();
        self.pos += 1;
        if c == 40 {
            // -2: capturing, -1: (?:...), 0..3: lookahead, negative
            // lookahead, lookbehind, negative lookbehind
            let mut look = -2;
            if self.peek() == 63 {
                self.pos += 1;
                let k = self.peek();
                self.pos += 1;
                if k == 60 {
                    let k2 = self.peek();
                    self.pos += 1;
                    look = if k2 == 33 { 3 } else { 2 };
                } else if k == 33 {
                    look = 1;
                } else if k == 61 {
                    look = 0;
                } else {
                    look = -1;
                }
            }
            let mut group = 0;
            if look == -2 {
                self.groups += 1;
                group = self.groups;
            }
            let inner = self.parse_alt();
            self.pos += 1;
            if look == -1 {
                return inner;
            }
            let mut code: Vec[Inst] = Vec.new();
            if look == -2 {
                code.push(inst(OP_SAVE, 2 * group, 0, 0));
                for i in inner.code.iter() {
                    code.push(i.clone());
                }
                code.push(inst(OP_SAVE, 2 * group + 1, 0, 0));
                return frag(code, inner.minw, inner.maxw);
            }
            let z = if look >= 2 { look + 4 * inner.minw } else { look };
            code.push(inst(OP_LOOK, 1, inner.code.len() + 2, z));
            for i in inner.code.iter() {
                code.push(i.clone());
            }
            code.push(inst(OP_MATCH, 0, 0, 0));
            return frag(code, 0, 0);
        }
        if c == 91 {
            let k = self.parse_class();
            return frag(vec![inst(OP_CLASS, k, 0, 0)], 1, 1);
        }
        if c == 46 {
            return frag(vec![inst(OP_ANY, 0, 0, 0)], 1, 1);
        }
        if c == 94 {
            return frag(vec![inst(OP_BOL, 0, 0, 0)], 0, 0);
        }
        if c == 36 {
            return frag(vec![inst(OP_EOL, 0, 0, 0)], 0, 0);
        }
        if c == 92 {
            let n = self.peek();
            if n == 98 or n == 66 {
                self.pos += 1;
                return frag(vec![inst(OP_WORDB, if n == 98 { 1 } else { 0 }, 0, 0)], 0, 0);
            }
            let e = self.escape();
            if e < 0 {
                let k = self.class_cat(e);
                return frag(vec![inst(OP_CLASS, k, 0, 0)], 1, 1);
            }
            return frag(vec![inst(OP_CHAR, e, 0, 0)], 1, 1);
        }
        frag(vec![inst(OP_CHAR, c, 0, 0)], 1, 1)
    }

    // A number at the parser's position, or -1 if there is none.
    fn number(mut ref self) -> i64 {
        let start = self.pos;
        let mut v = 0;
        while self.peek() >= 48 and self.peek() <= 57 {
            v = v * 10 + self.peek() - 48;
            self.pos += 1;
        }
        if self.pos == start { -1 } else { v }
    }

    fn parse_quant(mut ref self, atom: own Frag) -> Frag {
        self.skip_ws();
        let c = self.peek();
        let mut lo = -1;
        let mut hi = -1;
        if c == 42 {
            lo = 0;
            hi = INF;
            self.pos += 1;
        } else if c == 43 {
            lo = 1;
            hi = INF;
            self.pos += 1;
        } else if c == 63 {
            lo = 0;
            hi = 1;
            self.pos += 1;
        } else if c == 123 {
            let save = self.pos;
            self.pos += 1;
            let a = self.number();
            let mut b = a;
            if self.peek() == 44 {
                self.pos += 1;
                b = self.number();
                if b < 0 {
                    b = INF;
                }
            }
            if self.peek() == 125 and (a >= 0 or b >= 0) {
                self.pos += 1;
                lo = if a < 0 { 0 } else { a };
                hi = b;
            } else {
                self.pos = save;
                return atom;
            }
        } else {
            return atom;
        }
        let mut lazy = false;
        if self.peek() == 63 {
            lazy = true;
            self.pos += 1;
        }
        repeat(atom, lo, hi, lazy)
    }
}

fn merge_runs(rs: Vec[i64]) -> Vec[i64] {
    let n = rs.len() / 2;
    let mut idx: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < n {
        let mut j = idx.len();
        idx.push(k);
        while j > 0 and rs[2 * idx[j - 1]] > rs[2 * k] {
            idx[j] = idx[j - 1];
            j -= 1;
        }
        idx[j] = k;
        k += 1;
    }
    let mut out: Vec[i64] = Vec.new();
    for i in idx {
        let lo = rs[2 * i];
        let hi = rs[2 * i + 1];
        let m = out.len();
        if m > 0 and lo <= out[m - 1] + 1 {
            if hi > out[m - 1] {
                out[m - 1] = hi;
            }
        } else {
            out.push(lo);
            out.push(hi);
        }
    }
    out
}

fn copy_code(dst: mut ref Vec[Inst], src: ref Vec[Inst]) {
    for i in src.iter() {
        dst.push(i.clone());
    }
}

fn repeat(atom: Frag, lo: i64, hi: i64, lazy: bool) -> Frag {
    let n = atom.code.len();
    let minw = atom.minw * lo;
    let maxw = if hi >= INF or atom.maxw >= INF { INF } else { atom.maxw * hi };
    let mut code: Vec[Inst] = Vec.new();
    if n == 1 {
        let op = atom.code[0].op;
        if op == OP_CHAR or op == OP_ANY or op == OP_CLASS {
            code.push(inst(OP_REP, lo, hi, if lazy { 1 } else { 0 }));
            code.push(atom.code[0].clone());
            return frag(code, minw, maxw);
        }
    }
    let mut k = 0;
    while k < lo {
        copy_code(mut code, atom.code);
        k += 1;
    }
    if hi >= INF {
        // L: split body, out; body; jmp L
        if lazy {
            code.push(inst(OP_SPLIT, n + 2, 1, 0));
        } else {
            code.push(inst(OP_SPLIT, 1, n + 2, 0));
        }
        copy_code(mut code, atom.code);
        code.push(inst(OP_JMP, -(n + 1), 0, 0));
    } else {
        // Each optional copy: split body, end; body. Nested, so they
        // are taken in order.
        let opt = hi - lo;
        let mut j = 0;
        while j < opt {
            let rest = (opt - j) * (n + 1) - 1;
            if lazy {
                code.push(inst(OP_SPLIT, rest + 1, 1, 0));
            } else {
                code.push(inst(OP_SPLIT, 1, rest + 1, 0));
            }
            copy_code(mut code, atom.code);
            j += 1;
        }
    }
    frag(code, minw, maxw)
}

fn compile(src: ref Vec[i64], flags: i64) -> Regex {
    let mut p = ReParser { src: src.clone(), pos: 0, verbose: (flags & VERBOSE) != 0, classes: Vec.new(), groups: 0 };
    let f = p.parse_alt();
    let mut prog = f.code;
    prog.push(inst(OP_MATCH, 0, 0, 0));
    let mut firsts: Vec[i64] = Vec.new();
    let mut seen: Vec[bool] = Vec.new();
    for _ in 0..prog.len() {
        seen.push(false);
    }
    let any_start = first_atoms(prog, 0, mut seen, mut firsts);
    Regex {
        prog: prog,
        classes: p.classes,
        groups: p.groups,
        icase: (flags & IGNORECASE) != 0,
        dotall: (flags & DOTALL) != 0,
        firsts: firsts,
        any_start: any_start,
    }
}

// Collects into firsts the atoms a match from pc can consume first;
// true if it can match without consuming anything (or past $), when
// search() must try every position. A path through ^ only matches at 0,
// which search() always tries.
fn first_atoms(prog: ref Vec[Inst], pc: i64, seen: mut ref Vec[bool], firsts: mut ref Vec[i64]) -> bool {
    if seen[pc] {
        return false;
    }
    seen[pc] = true;
    let i = ref prog[pc];
    let op = i.op;
    if op == OP_CHAR or op == OP_CLASS {
        firsts.push(pc);
        false
    } else if op == OP_ANY or op == OP_MATCH or op == OP_EOL {
        true
    } else if op == OP_REP {
        if prog[pc + 1].op == OP_ANY {
            return true;
        }
        firsts.push(pc + 1);
        if i.x == 0 { first_atoms(prog, pc + 2, mut seen, mut firsts) } else { false }
    } else if op == OP_SPLIT {
        let a = first_atoms(prog, pc + i.x, mut seen, mut firsts);
        let b = first_atoms(prog, pc + i.y, mut seen, mut firsts);
        a or b
    } else if op == OP_JMP {
        first_atoms(prog, pc + i.x, mut seen, mut firsts)
    } else if op == OP_BOL {
        false
    } else if op == OP_LOOK {
        first_atoms(prog, pc + i.y, mut seen, mut firsts)
    } else {
        first_atoms(prog, pc + 1, mut seen, mut firsts)
    }
}

fn word_char(u: ref Uni, c: i64) -> bool {
    c == 95 or in_runs(u.alnum, c)
}

fn cat_has(u: ref Uni, cat: i64, c: i64) -> bool {
    let a = if cat < 0 { -cat } else { cat };
    let r = if a == 1 {
        in_runs(u.space, c)
    } else if a == 2 {
        word_char(u, c)
    } else {
        in_runs(u.decimal, c)
    };
    if cat < 0 { not r } else { r }
}

fn ascii_lower(c: i64) -> i64 {
    if c >= 65 and c <= 90 { c + 32 } else { c }
}

fn ascii_upper(c: i64) -> i64 {
    if c >= 97 and c <= 122 { c - 32 } else { c }
}

// A match: where it ends, and each group's (start, end), -1 if unset.
struct Match {
    end: i64,
    caps: Vec[i64],
}

impl Regex {
    fn in_class(ref self, u: ref Uni, k: i64, c: i64) -> bool {
        let cl = ref self.classes[k];
        let mut r = in_runs(cl.runs, c);
        if not r {
            for cat in cl.cats.iter() {
                if cat_has(u, *cat, c) {
                    r = true;
                }
            }
        }
        if cl.neg { not r } else { r }
    }

    fn atom_ok(ref self, u: ref Uni, i: ref Inst, c: i64) -> bool {
        if i.op == OP_CHAR {
            if self.icase { ascii_lower(c) == ascii_lower(i.x) } else { c == i.x }
        } else if i.op == OP_ANY {
            self.dotall or c != 10
        } else if self.icase {
            let cl = ref self.classes[i.x];
            let hit = |x: i64| {
                let mut r = in_runs(cl.runs, x);
                for cat in cl.cats.iter() {
                    if cat_has(u, *cat, x) {
                        r = true;
                    }
                }
                r
            };
            let r = hit(c) or hit(ascii_lower(c)) or hit(ascii_upper(c));
            if cl.neg { not r } else { r }
        } else {
            self.in_class(u, i.x, c)
        }
    }

    // Runs the program from pc at pos: the end of the first match the
    // backtracking order finds, or -1. Groups set on the way are written
    // to caps only along the path that matches.
    fn run(ref self, u: ref Uni, pc0: i64, pos0: i64, t: ref Vec[i64], caps: mut ref Vec[i64]) -> i64 {
        let mut pc = pc0;
        let mut pos = pos0;
        let n = t.len();
        loop {
            let i = ref self.prog[pc];
            let op = i.op;
            if op == OP_CHAR or op == OP_ANY or op == OP_CLASS {
                if pos < n and self.atom_ok(u, i, t[pos]) {
                    pos += 1;
                    pc += 1;
                } else {
                    return -1;
                }
            } else if op == OP_REP {
                let atom = ref self.prog[pc + 1];
                let mut most = 0;
                while most < i.y and pos + most < n and self.atom_ok(u, atom, t[pos + most]) {
                    most += 1;
                }
                if most < i.x {
                    return -1;
                }
                let lazy = i.z == 1;
                let mut j = if lazy { i.x } else { most };
                loop {
                    let mut c2 = caps.clone();
                    let r = self.run(u, pc + 2, pos + j, t, mut c2);
                    if r >= 0 {
                        copy_caps(mut caps, c2);
                        return r;
                    }
                    if lazy {
                        if j >= most {
                            return -1;
                        }
                        j += 1;
                    } else {
                        if j <= i.x {
                            return -1;
                        }
                        j -= 1;
                    }
                }
            } else if op == OP_SPLIT {
                let mut c2 = caps.clone();
                let r = self.run(u, pc + i.x, pos, t, mut c2);
                if r >= 0 {
                    copy_caps(mut caps, c2);
                    return r;
                }
                pc += i.y;
            } else if op == OP_JMP {
                pc += i.x;
            } else if op == OP_SAVE {
                caps[i.x] = pos;
                pc += 1;
            } else if op == OP_BOL {
                if pos != 0 {
                    return -1;
                }
                pc += 1;
            } else if op == OP_EOL {
                if not (pos == n or (pos == n - 1 and t[pos] == 10)) {
                    return -1;
                }
                pc += 1;
            } else if op == OP_WORDB {
                let before = pos > 0 and word_char(u, t[pos - 1]);
                let after = pos < n and word_char(u, t[pos]);
                if (before != after) != (i.x == 1) {
                    return -1;
                }
                pc += 1;
            } else if op == OP_LOOK {
                let kind = i.z % 4;
                let width = i.z / 4;
                let mut ok = false;
                let mut scratch = caps.clone();
                if kind >= 2 {
                    let start = pos - width;
                    if start >= 0 {
                        ok = self.run(u, pc + i.x, start, t, mut scratch) == pos;
                    }
                } else {
                    ok = self.run(u, pc + i.x, pos, t, mut scratch) >= 0;
                }
                if kind == 1 or kind == 3 {
                    ok = not ok;
                }
                if not ok {
                    return -1;
                }
                pc += i.y;
            } else {
                return pos;
            }
        }
    }

    fn fresh_caps(ref self) -> Vec[i64] {
        let mut caps: Vec[i64] = Vec.new();
        for _ in 0..2 * (self.groups + 1) {
            caps.push(-1);
        }
        caps
    }

    // match(): anchored at pos.
    fn match_at(ref self, u: ref Uni, t: ref Vec[i64], pos: i64) -> Option[Match] {
        let mut caps = self.fresh_caps();
        let e = self.run(u, 0, pos, t, mut caps);
        if e < 0 {
            return None;
        }
        caps[0] = pos;
        caps[1] = e;
        Some(Match { end: e, caps: caps })
    }

    // search() from pos.
    fn search(ref self, u: ref Uni, t: ref Vec[i64], pos: i64) -> Option[Match] {
        let mut s = pos;
        while s <= t.len() {
            if s > 0 and not self.any_start {
                let mut ok = false;
                if s < t.len() {
                    for f in self.firsts.iter() {
                        if not ok and self.atom_ok(u, self.prog[*f], t[s]) {
                            ok = true;
                        }
                    }
                }
                if not ok {
                    s += 1;
                    continue;
                }
            }
            match self.match_at(u, t, s) {
                Some(m) => {
                    return Some(m);
                }
                None => {}
            }
            s += 1;
        }
        None
    }

    // sub(): each non-overlapping match, left to right, replaced by the
    // template, where \1 to \99 are groups (an unmatched one is empty).
    fn sub(ref self, u: ref Uni, t: ref Vec[i64], template: Str) -> Vec[i64] {
        let tm = lit(template);
        let mut out: Vec[i64] = Vec.new();
        let mut last = 0;
        let mut pos = 0;
        while pos <= t.len() {
            let m = match self.search(u, t, pos) {
                Some(m) => m,
                None => {
                    break;
                }
            };
            let s = m.caps[0];
            push_all(mut out, sub(t, last, s));
            let mut k = 0;
            while k < tm.len() {
                if tm[k] == 92 and k + 1 < tm.len() and tm[k + 1] >= 48 and tm[k + 1] <= 57 {
                    let mut g = tm[k + 1] - 48;
                    k += 2;
                    if k < tm.len() and tm[k] >= 48 and tm[k] <= 57 {
                        g = g * 10 + tm[k] - 48;
                        k += 1;
                    }
                    if m.caps[2 * g] >= 0 and m.caps[2 * g + 1] >= 0 {
                        push_all(mut out, sub(t, m.caps[2 * g], m.caps[2 * g + 1]));
                    }
                } else {
                    out.push(tm[k]);
                    k += 1;
                }
            }
            last = m.end;
            pos = if m.end > s { m.end } else { m.end + 1 };
        }
        push_all(mut out, sub(t, last, t.len()));
        out
    }
}

fn copy_caps(dst: mut ref Vec[i64], src: ref Vec[i64]) {
    let mut k = 0;
    while k < src.len() {
        dst[k] = src[k];
        k += 1;
    }
}

fn group(m: ref Match, t: ref Vec[i64], g: i64) -> Option[Vec[i64]] {
    if m.caps[2 * g] < 0 or m.caps[2 * g + 1] < 0 {
        None
    } else {
        Some(sub(t, m.caps[2 * g], m.caps[2 * g + 1]))
    }
}

// ------------------------------------------------------------ smartypants.py

// The library's patterns, by "<function>.<n>" (see regex_text()).
struct Patterns {
    names: Vec[String],
    all: Vec[Regex],
}

fn load_patterns() -> Patterns {
    let mut p = Patterns { names: Vec.new(), all: Vec.new() };
    for line in split_on(regex_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, ' ');
        p.names.push(f[0].clone());
        p.all.push(compile(hex_text(f[2]), int_of(f[1])));
    }
    p
}

impl Patterns {
    fn get(ref self, name: Str) -> ref Regex {
        let mut k = 0;
        while k < self.all.len() {
            if self.names[k] == name {
                return ref self.all[k];
            }
            k += 1;
        }
        ref self.all[0]
    }
}

fn int_of(s: ref String) -> i64 {
    let mut neg = false;
    let mut v = 0;
    for c in s.chars() {
        if c == '-' {
            neg = true;
        } else {
            v = v * 10 + (c as i64 - 48);
        }
    }
    if neg { -v } else { v }
}

// class _Attr
const A_Q: i64 = 1;
const A_B_LOWER: i64 = 2;
const A_B: i64 = 6;
const A_MASK_B: i64 = 6;
const A_D_LOWER: i64 = 8;
const A_D: i64 = 24;
const A_I: i64 = 40;
const A_MASK_D: i64 = 56;
const A_E: i64 = 64;
const A_W: i64 = 128;
const A_U: i64 = 256;
const A_H: i64 = 512;
const A_S: i64 = 768;
const A_MASK_O: i64 = 768;
const A_SET1: i64 = 75;

// The attribute a character of `smartypants -a` names, as getattr(Attr,
// c) finds it, or -1.
fn attr_named(c: char) -> i64 {
    if c == 'q' {
        A_Q
    } else if c == 'b' {
        A_B_LOWER
    } else if c == 'B' {
        A_B
    } else if c == 'd' {
        A_D_LOWER
    } else if c == 'D' {
        A_D
    } else if c == 'i' {
        A_I
    } else if c == 'e' {
        A_E
    } else if c == 'w' {
        A_W
    } else if c == 'u' {
        A_U
    } else if c == 'h' {
        A_H
    } else if c == 's' {
        A_S
    } else {
        -1
    }
}

fn set_attr(n: i64) -> i64 {
    if n == 0 {
        0
    } else if n == 1 {
        A_SET1
    } else if n == 2 {
        A_Q | A_B_LOWER | A_D | A_E
    } else {
        A_Q | A_B_LOWER | A_I | A_E
    }
}

// The module's state: Attr.default and tags_to_skip.
struct Sp {
    p: Patterns,
    u: Uni,
    default_attr: i64,
    tags_to_skip: Vec[String],
}

fn default_tags() -> Vec[String] {
    let mut v: Vec[String] = Vec.new();
    for t in ["pre", "samp", "code", "tt", "kbd", "script", "style", "math"] {
        v.push(t.to_string());
    }
    v
}

fn tags_pattern(tags: ref Vec[String]) -> Vec[i64] {
    let mut s = "<(/)?(".to_string();
    let mut k = 0;
    while k < tags.len() {
        if k > 0 {
            s.push('|');
        }
        s.push_str(tags[k]);
        k += 1;
    }
    s.push_str(")[^>]*>");
    cps_of(s)
}

// _tags_to_skip_regex(tags)
fn tags_to_skip_regex(tags: ref Vec[String]) -> Regex {
    compile(tags_pattern(tags), IGNORECASE)
}

fn re_sub(sp: ref Sp, name: Str, t: ref Vec[i64], template: Str) -> Vec[i64] {
    sp.p.get(name).sub(sp.u, t, template)
}

fn convert_quotes(sp: ref Sp, text: ref Vec[i64]) -> Vec[i64] {
    // Special case if the very first character is a quote followed by
    // punctuation at a non-word-break. Close the quotes by brute force:
    let mut t = re_sub(sp, "convert_quotes.0", text, "&#8217;");
    t = re_sub(sp, "convert_quotes.1", t, "&#8221;");
    // Special case for double sets of quotes
    t = re_sub(sp, "convert_quotes.2", t, "&#8220;&#8216;");
    t = re_sub(sp, "convert_quotes.3", t, "&#8216;&#8220;");
    // Special case for decade abbreviations (the '80s):
    t = re_sub(sp, "convert_quotes.4", t, "&#8217;");
    // Get most opening single quotes:
    t = re_sub(sp, "convert_quotes.5", t, "\\1&#8216;");
    t = re_sub(sp, "convert_quotes.6", t, "\\1&#8217;");
    t = re_sub(sp, "convert_quotes.7", t, "\\1&#8217;\\2");
    // Any remaining single quotes should be opening ones:
    t = re_sub(sp, "convert_quotes.8", t, "&#8216;");
    // Get most opening double quotes:
    t = re_sub(sp, "convert_quotes.9", t, "\\1&#8220;");
    // Double closing quotes:
    t = re_sub(sp, "convert_quotes.10", t, "&#8221;");
    t = re_sub(sp, "convert_quotes.11", t, "&#8221;");
    t = re_sub(sp, "convert_quotes.12", t, "\\1&#8221;");
    // Any remaining quotes should be opening ones.
    re_sub(sp, "convert_quotes.13", t, "&#8220;")
}

fn convert_backticks(sp: ref Sp, text: ref Vec[i64]) -> Vec[i64] {
    let t = re_sub(sp, "convert_backticks.0", text, "&#8220;");
    re_sub(sp, "convert_backticks.1", t, "&#8221;")
}

fn convert_single_backticks(sp: ref Sp, text: ref Vec[i64]) -> Vec[i64] {
    let t = re_sub(sp, "convert_single_backticks.0", text, "&#8216;");
    re_sub(sp, "convert_single_backticks.1", t, "&#8217;")
}

fn convert_dashes(sp: ref Sp, text: ref Vec[i64]) -> Vec[i64] {
    re_sub(sp, "convert_dashes.0", text, "&#8212;")
}

fn convert_dashes_oldschool(sp: ref Sp, text: ref Vec[i64]) -> Vec[i64] {
    let t = re_sub(sp, "convert_dashes_oldschool.0", text, "&#8212;");
    re_sub(sp, "convert_dashes_oldschool.1", t, "&#8211;")
}

fn convert_dashes_oldschool_inverted(sp: ref Sp, text: ref Vec[i64]) -> Vec[i64] {
    let t = re_sub(sp, "convert_dashes_oldschool_inverted.0", text, "&#8211;");
    re_sub(sp, "convert_dashes_oldschool_inverted.1", t, "&#8212;")
}

fn convert_ellipses(sp: ref Sp, text: ref Vec[i64]) -> Vec[i64] {
    let t = re_sub(sp, "convert_ellipses.0", text, "&#8230;");
    re_sub(sp, "convert_ellipses.1", t, "&#8230;")
}

// convert_entities(text, mode), through CTBL in its order.
fn convert_entities(text: ref Vec[i64], mode: i64) -> Vec[i64] {
    let keys = ["&#8211;", "&#8212;", "&#8216;", "&#8217;", "&#8220;", "&#8221;", "&#8230;"];
    let unicode = ["\u{2013}", "\u{2014}", "\u{2018}", "\u{2019}", "\u{201c}", "\u{201d}", "\u{2026}"];
    let named = ["&ndash;", "&mdash;", "&lsquo;", "&rsquo;", "&ldquo;", "&rdquo;", "&hellip;"];
    let ascii = ["-", "--", "'", "'", "\"", "\"", "..."];
    let mut t = text.clone();
    let mut k = 0;
    while k < 7 {
        let v = if mode == 0 { unicode[k].clone() } else if mode == 1 { named[k].clone() } else { ascii[k].clone() };
        t = replace_all(t, lit(keys[k]), lit(v));
        k += 1;
    }
    t
}

fn process_escapes(sp: ref Sp, text: ref Vec[i64]) -> Vec[i64] {
    let mut t = re_sub(sp, "process_escapes.0", text, "&#92;");
    t = re_sub(sp, "process_escapes.1", t, "&#34;");
    t = re_sub(sp, "process_escapes.2", t, "&#39;");
    t = re_sub(sp, "process_escapes.3", t, "&#46;");
    t = re_sub(sp, "process_escapes.4", t, "&#45;");
    re_sub(sp, "process_escapes.5", t, "&#96;")
}

struct Token {
    tag: bool,
    text: Vec[i64],
}

// str.rstrip() and str.rstrip(chars).
fn rstrip_space(u: ref Uni, t: ref Vec[i64]) -> Vec[i64] {
    let mut n = t.len();
    while n > 0 and in_runs(u.space, t[n - 1]) {
        n -= 1;
    }
    sub(t, 0, n)
}

fn rstrip_char(t: ref Vec[i64], c: i64) -> Vec[i64] {
    let mut n = t.len();
    while n > 0 and t[n - 1] == c {
        n -= 1;
    }
    sub(t, 0, n)
}

// _tokenize(text): tags (comments included, unless one holds "--") and
// the runs of text between them.
fn tokenize(sp: ref Sp, text: ref Vec[i64]) -> Vec[Token] {
    let soup = sp.p.get("_tokenize.0");
    let mut tokens: Vec[Token] = Vec.new();
    let mut previous_end = 0;
    let mut at = 0;
    loop {
        let m = match soup.match_at(sp.u, text, at) {
            Some(m) => m,
            None => {
                break;
            }
        };
        let g1 = group(m, text, 1).unwrap_or(Vec.new());
        if g1.len() > 0 {
            tokens.push(Token { tag: false, text: g1 });
        }
        let tag = group(m, text, 2).unwrap_or(Vec.new());
        let mut is_tag = true;
        if starts_with(tag, 0, lit("<!--")) {
            // remove --[white space]> from the end of tag
            let inner = rstrip_char(rstrip_space(sp.u, rstrip_char(sub(tag, 4, tag.len()), 62)), 45);
            if contains(inner, lit("--")) {
                is_tag = false;
            }
        }
        tokens.push(Token { tag: is_tag, text: tag });
        previous_end = m.end;
        at = m.end;
    }
    if previous_end < text.len() {
        tokens.push(Token { tag: false, text: sub(text, previous_end, text.len()) });
    }
    tokens
}

// smartypants(text, attr)
fn smartypants(sp: ref Sp, text: ref Vec[i64], attr_given: Option[i64]) -> Vec[i64] {
    let mut skipped_tag_stack: Vec[Vec[i64]] = Vec.new();
    let attr = match attr_given {
        Some(a) => a,
        None => sp.default_attr,
    };
    let do_quotes = attr & A_Q;
    let do_backticks = attr & A_MASK_B;
    let do_dashes = attr & A_MASK_D;
    let do_ellipses = attr & A_E;
    let do_entities = attr & A_MASK_O;
    let convert_quot = attr & A_W;
    let tokens = tokenize(sp, text);
    let mut result: Vec[i64] = Vec.new();
    let mut in_pre = false;
    let mut prev_token_last_char: Vec[i64] = Vec.new();
    let skip_rx = tags_to_skip_regex(sp.tags_to_skip);
    let not_space = sp.p.get("smartypants.1");
    for cur in tokens.iter() {
        if cur.tag {
            // Don't mess with quotes inside some tags.
            push_all(mut result, cur.text);
            match skip_rx.match_at(sp.u, cur.text, 0) {
                Some(m) => {
                    let name = lower(group(m, cur.text, 2).unwrap_or(Vec.new()));
                    if group(m, cur.text, 1).is_none() {
                        skipped_tag_stack.push(name);
                        in_pre = true;
                    } else {
                        if skipped_tag_stack.len() > 0 {
                            let top = skipped_tag_stack[skipped_tag_stack.len() - 1].clone();
                            if same(name, top) {
                                skipped_tag_stack.pop();
                            }
                        }
                        if skipped_tag_stack.len() == 0 {
                            in_pre = false;
                        }
                    }
                }
                None => {}
            }
        } else {
            let mut t = cur.text.clone();
            // Remember last char of this token before processing.
            let last_char = sub(t, t.len() - 1, t.len());
            if not in_pre {
                t = process_escapes(sp, t);
                if convert_quot != 0 {
                    t = re_sub(sp, "smartypants.0", t, "\"");
                }
                if do_dashes != 0 {
                    if do_dashes == A_D_LOWER {
                        t = convert_dashes(sp, t);
                    }
                    if do_dashes == A_D {
                        t = convert_dashes_oldschool(sp, t);
                    }
                    if do_dashes == A_I {
                        t = convert_dashes_oldschool_inverted(sp, t);
                    }
                }
                if do_ellipses != 0 {
                    t = convert_ellipses(sp, t);
                }
                // Note: backticks need to be processed before quotes.
                if do_backticks == A_B_LOWER {
                    t = convert_backticks(sp, t);
                }
                if do_backticks == A_B {
                    t = convert_single_backticks(sp, t);
                }
                if do_quotes != 0 {
                    if same(t, lit("'")) {
                        // Special case: single-character ' token
                        t = if not_space.match_at(sp.u, prev_token_last_char, 0).is_some() { lit("&#8217;") } else { lit("&#8216;") };
                    } else if same(t, lit("\"")) {
                        // Special case: single-character " token
                        t = if not_space.match_at(sp.u, prev_token_last_char, 0).is_some() { lit("&#8221;") } else { lit("&#8220;") };
                    } else {
                        t = convert_quotes(sp, t);
                    }
                }
                if do_entities != 0 {
                    let mode = if do_entities == A_U { 0 } else if do_entities == A_H { 1 } else { 2 };
                    t = convert_entities(t, mode);
                }
            }
            prev_token_last_char = last_char;
            push_all(mut result, t);
        }
    }
    result
}

// ------------------------------------------------------------ files

fn read_file(path: ref String) -> Option[Vec[i64]] {
    match fs.read_bytes(path.clone()) {
        Ok(b) => Some(utf8_cps(b)),
        Err(_) => None,
    }
}

fn write_posts() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data/posts".to_string()) {
        return Err(f"cannot create data/posts: {e}");
    }
    for line in split_on(posts_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, ' ');
        let mut bytes: Vec[u8] = Vec.new();
        if f[1] != "-" {
            let cs: Vec[char] = f[1].chars().collect();
            let mut k = 0;
            while k + 1 < cs.len() {
                bytes.push((hex_val(cs[k]) * 16 + hex_val(cs[k + 1])) as u8);
                k += 2;
            }
        }
        if let Err(e) = fs.write_bytes(f"data/posts/{f[0]}", bytes) {
            return Err(f"cannot write {f[0]}: {e}");
        }
    }
    Ok(())
}

// What oracle.py prints for some text: each line after `mark`.
fn show_lines(cs: ref Vec[i64], mark: Str) {
    if cs.len() == 0 {
        return;
    }
    for line in split_cps(cs, 10) {
        if line.len() == 0 {
            println(f"  {mark}");
        } else {
            println(f"  {mark} {cps_str(line)}");
        }
    }
}

// ------------------------------------------------------------ the command

// The vendored `smartypants` script under argparse, run in data/: its
// standard output, standard error and exit status.
struct Run {
    out: Vec[i64],
    err: Vec[i64],
    code: i64,
}

fn usage_error(msg: ref String) -> Run {
    let text = f"usage: smartypants [-h] [-v] [-a ATTR] [-s SKIP] [FILE ...]\nsmartypants: error: {msg}\n";
    Run { out: Vec.new(), err: cps_of(text), code: 2 }
}

fn run_cli(sp: mut ref Sp, args: ref Vec[String]) -> Run {
    let mut attr_s = "1".to_string();
    let mut skip_s = "pre,samp,code,tt,kbd,script,style,math".to_string();
    let mut files: Vec[Vec[i64]] = Vec.new();
    let mut extras: Vec[String] = Vec.new();
    let mut only_positional = false;
    let mut k = 0;
    while k < args.len() {
        let a = args[k].clone();
        let is_opt = not only_positional and a.len() > 1 and a.starts_with("-");
        if not is_opt {
            // argparse.FileType('r') opens each file as it is parsed
            match read_file(f"data/{a}") {
                Some(t) => files.push(t),
                None => {
                    return usage_error(f"argument FILE: can't open '{a}': [Errno 2] No such file or directory: '{a}'");
                }
            }
            k += 1;
            continue;
        }
        if a == "--" {
            only_positional = true;
            k += 1;
            continue;
        }
        if a == "-v" or a == "--version" {
            return Run { out: cps_of("2.0.2\n".to_string()), err: Vec.new(), code: 0 };
        }
        let mut name = String.new();
        let mut value: Option[String] = None;
        if a.starts_with("--attr") or a.starts_with("--skip") {
            name = a.substring(0, 6);
            if a.len() > 6 {
                if a.substring(6, 7) == "=" {
                    value = Some(a.substring(7, a.len()));
                } else {
                    extras.push(a.clone());
                    k += 1;
                    continue;
                }
            }
        } else if a.starts_with("-a") or a.starts_with("-s") {
            name = a.substring(0, 2);
            if a.len() > 2 {
                value = Some(a.substring(2, a.len()));
            }
        } else {
            extras.push(a.clone());
            k += 1;
            continue;
        }
        let shown = if name == "-a" or name == "--attr" { "-a/--attr" } else { "-s/--skip" };
        let v = match value {
            Some(v) => v,
            None => {
                if k + 1 >= args.len() or (args[k + 1].len() > 1 and args[k + 1].starts_with("-")) {
                    return usage_error(f"argument {shown}: expected one argument");
                }
                k += 1;
                args[k].clone()
            }
        };
        if shown == "-a/--attr" {
            attr_s = v;
        } else {
            skip_s = v;
        }
        k += 1;
    }
    if extras.len() > 0 {
        let mut joined = String.new();
        let mut j = 0;
        while j < extras.len() {
            if j > 0 {
                joined.push(' ');
            }
            joined.push_str(extras[j]);
            j += 1;
        }
        return usage_error(f"unrecognized arguments: {joined}");
    }
    // _str_attr_to_int, under warnings.catch_warnings(record=True): the
    // same warning twice is recorded once.
    let mut attr = 0;
    let mut warned: Vec[String] = Vec.new();
    for c in attr_s.chars() {
        let v = if c >= '0' and c <= '3' { set_attr(c as i64 - 48) } else { attr_named(c) };
        if v < 0 {
            let msg = f"Unknown attribute: {c}";
            if not warned.contains(msg) {
                warned.push(msg);
            }
            continue;
        }
        attr = attr | v;
    }
    if warned.len() > 0 {
        return Run { out: cps_of(f"{warned[warned.len() - 1]}\n"), err: Vec.new(), code: 1 };
    }
    sp.tags_to_skip = split_on(skip_s, ',');
    let mut out: Vec[i64] = Vec.new();
    for f in files.iter() {
        push_all(mut out, smartypants(sp, f, Some(attr)));
    }
    Run { out: out, err: Vec.new(), code: 0 }
}

// ------------------------------------------------------------ the jobs

// A text field: backslash escapes itself, a tab and a newline.
fn unesc(cs: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < cs.len() {
        if cs[k] == 92 and k + 1 < cs.len() {
            let n = cs[k + 1];
            if n == 92 {
                out.push(92);
            } else if n == 116 {
                out.push(9);
            } else if n == 110 {
                out.push(10);
            } else {
                out.push(92);
                out.push(n);
            }
            k += 2;
        } else {
            out.push(cs[k]);
            k += 1;
        }
    }
    out
}

fn attr_of(f: ref Vec[i64]) -> Option[i64] {
    if same(f, lit("-")) { None } else { Some(int_of(cps_str(f))) }
}

fn attr_repr(a: ref Option[i64]) -> String {
    match a {
        Some(v) => f"{v}",
        None => "None".to_string(),
    }
}

fn names_repr(u: ref Uni, v: ref Vec[String]) -> String {
    let mut items: Vec[Vec[i64]] = Vec.new();
    for s in v.iter() {
        items.push(cps_of(s));
    }
    list_repr(u, items)
}

fn main() {
    if let Err(e) = write_posts() {
        eprintln(e);
        return;
    }
    let mut sp = Sp { p: load_patterns(), u: load_uni(), default_attr: A_SET1, tags_to_skip: default_tags() };
    for hex in split_on(jobs_text(), '\n') {
        if hex.len() == 0 {
            continue;
        }
        let f = split_cps(hex_text(hex), 9);
        let op = cps_str(f[0]);
        if op == "job" {
            println(f"== {cps_str(f[1])}");
        } else if op == "sp" {
            let text = unesc(f[1]);
            let a = attr_of(f[2]);
            println(f"> smartypants({str_repr(sp.u, text)}, {attr_repr(a)})");
            println(f"  -> {str_repr(sp.u, smartypants(sp, text, a))}");
        } else if op == "fn" {
            let name = cps_str(f[1]);
            if name == "_tags_to_skip_regex" {
                let given = cps_str(f[2]);
                let tags = if given == "-" { default_tags() } else { split_on(given, ',') };
                let shown = if given == "-" { "None".to_string() } else { names_repr(sp.u, tags) };
                println(f"> {name}({shown})");
                println(f"  -> {str_repr(sp.u, tags_pattern(tags))}");
                continue;
            }
            let text = unesc(f[2]);
            if name == "convert_entities" {
                let mode = int_of(cps_str(f[3]));
                println(f"> {name}({str_repr(sp.u, text)}, {mode})");
                println(f"  -> {str_repr(sp.u, convert_entities(text, mode))}");
                continue;
            }
            println(f"> {name}({str_repr(sp.u, text)})");
            if name == "_tokenize" {
                let mut s = "[".to_string();
                let mut k = 0;
                for tok in tokenize(sp, text).iter() {
                    if k > 0 {
                        s.push_str(", ");
                    }
                    let kind = if tok.tag { "'tag'" } else { "'text'" };
                    s.push_str(f"[{kind}, {str_repr(sp.u, tok.text)}]");
                    k += 1;
                }
                s.push_str("]");
                println(f"  -> {s}");
                continue;
            }
            let r = if name == "convert_quotes" {
                convert_quotes(sp, text)
            } else if name == "convert_backticks" {
                convert_backticks(sp, text)
            } else if name == "convert_single_backticks" {
                convert_single_backticks(sp, text)
            } else if name == "convert_dashes" {
                convert_dashes(sp, text)
            } else if name == "convert_dashes_oldschool" {
                convert_dashes_oldschool(sp, text)
            } else if name == "convert_dashes_oldschool_inverted" {
                convert_dashes_oldschool_inverted(sp, text)
            } else if name == "convert_ellipses" {
                convert_ellipses(sp, text)
            } else {
                process_escapes(sp, text)
            };
            println(f"  -> {str_repr(sp.u, r)}");
        } else if op == "default" {
            sp.default_attr = int_of(cps_str(f[1]));
            println(f"> Attr.default = {cps_str(f[1])}");
        } else if op == "skip" {
            let given = cps_str(f[1]);
            sp.tags_to_skip = if given == "-" { default_tags() } else { split_on(given, ',') };
            println(f"> tags_to_skip = {names_repr(sp.u, sp.tags_to_skip)}");
        } else if op == "file" {
            let name = cps_str(f[1]);
            let a = attr_of(f[2]);
            let text = read_file(f"data/posts/{name}").unwrap_or(Vec.new());
            println(f"> file {name} attr={attr_repr(a)}");
            show_lines(smartypants(sp, text, a), "|");
        } else if op == "cli" {
            let mut args: Vec[String] = Vec.new();
            let mut shown = String.new();
            let mut k = 1;
            while k < f.len() {
                let a = cps_str(f[k]);
                if k > 1 {
                    shown.push(' ');
                }
                shown.push_str(a);
                args.push(if a == "''" { String.new() } else { a });
                k += 1;
            }
            println(f"> smartypants {shown}");
            let r = run_cli(mut sp, args);
            show_lines(r.out, "|");
            show_lines(r.err, "!");
            println(f"  exit {r.code}");
        }
    }
}

