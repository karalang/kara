== the converters one at a time
> convert_quotes('"foo" -- bar')
  -> '&#8220;foo&#8221; -- bar'
> convert_quotes('"Isn\'t this fun?"')
  -> '&#8220;Isn&#8217;t this fun?&#8221;'
> convert_quotes("'Isn't this fun?'")
  -> '&#8216;Isn&#8217;t this fun?&#8217;'
> convert_quotes("1440-80's")
  -> '1440-80&#8217;s'
> convert_quotes("1440-'80s")
  -> '1440-&#8216;80s'
> convert_quotes("1440--'80s")
  -> '1440--&#8216;80s'
> convert_quotes('1960s')
  -> '1960s'
> convert_quotes("1960's")
  -> '1960&#8217;s'
> convert_quotes("one two '60s")
  -> 'one two &#8216;60s'
> convert_quotes("'60s")
  -> '&#8216;60s'
> convert_quotes("the '80s and the 90's")
  -> 'the &#8216;80s and the 90&#8217;s'
> convert_quotes('21st century')
  -> '21st century'
> convert_quotes('3rd')
  -> '3rd'
> convert_quotes('You should use ";" here')
  -> 'You should use &#8220;;&#8221; here'
> convert_quotes('Take a look at the "<a>Essay on quoting</a>" paper.')
  -> 'Take a look at the &#8220;<a>Essay on quoting</a>&#8221; paper.'
> convert_quotes('Take a look at "<a>Essay on quoting</a>".')
  -> 'Take a look at &#8220;<a>Essay on quoting</a>&#8221;.'
> convert_quotes("<p>He said &quot;Let's write some code.&quot; This code here <code>if True:\n\tprint &quot;Okay&quot;</code> is python code.</p>")
  -> '<p>He said &quot;Let&#8217;s write some code.&quot; This code here <code>if True:\n\tprint &quot;Okay&quot;</code> is python code.</p>'
> convert_quotes('--')
  -> '--'
> convert_quotes('-->')
  -> '-->'
> convert_quotes('-- \t  >')
  -> '-- \t  >'
> convert_quotes('<!-- "foo" --> blah--blah <!-- "bar" -->')
  -> '<!-- &#8220;foo&#8221; --> blah--blah <!-- &#8220;bar&#8221; -->'
> convert_quotes('<p>foo -- "bar"<!-- foo-bar\n<p>blah "this"</p>\n-->\n</p>')
  -> '<p>foo -- &#8220;bar&#8221;<!-- foo-bar\n<p>blah &#8220;this&#8221;</p>\n-->\n</p>'
> convert_quotes('<!-- comment -->')
  -> '<!-- comment -->'
> convert_quotes('<!-- <li>Fee-fi-of-fum</li> -->')
  -> '<!-- <li>Fee-fi-of-fum</li> -->'
> convert_quotes('<!-- "foo" --> <!-- "bar" -->')
  -> '<!-- &#8220;foo&#8221; --> <!-- &#8220;bar&#8221; -->'
> convert_quotes('<!-- -- -->')
  -> '<!-- -- -->'
> convert_quotes('<!-- -- -- \t >')
  -> '<!-- -- -- \t >'
> convert_quotes('<!---->')
  -> '<!---->'
> convert_quotes('<!-- --->')
  -> '<!-- --->'
> convert_quotes('<!-- x -- >')
  -> '<!-- x -- >'
> convert_quotes('"quote here"')
  -> '&#8220;quote here&#8221;'
> convert_quotes('"quote&ndash;here"')
  -> '&#8220;quote&ndash;here&#8221;'
> convert_quotes('Nothing endures but change. -- Heraclitus')
  -> 'Nothing endures but change. -- Heraclitus'
> convert_quotes('Life itself is the proper binge. --- Julia Child (1912--2004)')
  -> 'Life itself is the proper binge. --- Julia Child (1912--2004)'
> convert_quotes('Dare to be naïve. -- Buckminster Fuller (1895---1983)')
  -> 'Dare to be naïve. -- Buckminster Fuller (1895---1983)'
> convert_quotes('Huh...?')
  -> 'Huh...?'
> convert_quotes('Wait. . . what?')
  -> 'Wait. . . what?'
> convert_quotes('Four.... dots')
  -> 'Four.... dots'
> convert_quotes('Spaced . . . . out')
  -> 'Spaced . . . . out'
> convert_quotes("``Isn't this fun?''")
  -> '``Isn&#8217;t this fun?&#8217;&#8216;'
> convert_quotes("`Isn't this fun?'")
  -> '`Isn&#8217;t this fun?&#8217;'
> convert_quotes("``double'' and `single'")
  -> '``double&#8217;&#8217; and `single&#8217;'
> convert_quotes('"smarty" \\"pants\\"')
  -> '&#8220;smarty&#8221; \\&#8221;pants\\&#8221;'
> convert_quotes('\\\\')
  -> '\\\\'
> convert_quotes('a \\- b \\. c \\` d \\\' e \\" f \\\\ g')
  -> 'a \\- b \\. c \\` d \\&#8217; e \\&#8221; f \\\\ g'
> convert_quotes("'")
  -> '&#8216;'
> convert_quotes('"')
  -> '&#8220;'
> convert_quotes("x'")
  -> 'x&#8217;'
> convert_quotes("'x")
  -> '&#8216;x'
> convert_quotes('x"')
  -> 'x&#8221;'
> convert_quotes('"x')
  -> '&#8220;x'
> convert_quotes("' '")
  -> '&#8216; &#8216;'
> convert_quotes('" "')
  -> '&#8221; &#8220;'
> convert_quotes('He said, "\'Quoted\' words in a larger quote."')
  -> 'He said, &#8220;&#8216;Quoted&#8217; words in a larger quote.&#8221;'
> convert_quotes('\'"Nested" inside\'')
  -> '&#8216;&#8220;Nested&#8221; inside&#8217;'
> convert_quotes('"\'Double then single\'"')
  -> '&#8220;&#8216;Double then single&#8217;&#8221;'
> convert_quotes('"..." and \'...\'')
  -> '&#8221;...&#8221; and &#8216;...&#8217;'
> convert_quotes('"?" she asked')
  -> '&#8221;?&#8221; she asked'
> convert_quotes("'!' he said")
  -> '&#8216;!&#8217; he said'
> convert_quotes('"!" -- \'?\'')
  -> '&#8221;!&#8221; -- &#8216;?&#8217;'
> convert_quotes("Rock 'n' roll")
  -> 'Rock &#8216;n&#8217; roll'
> convert_quotes("'Tis the season")
  -> '&#8216;Tis the season'
> convert_quotes("the dog's bone, the dogs' bones")
  -> 'the dog&#8217;s bone, the dogs&#8217; bones'
> convert_quotes('&nbsp;\'tis &nbsp;"so"')
  -> '&nbsp;&#8216;tis &nbsp;&#8220;so&#8221;'
> convert_quotes('&mdash;\'word\' &ndash;"word"')
  -> '&mdash;&#8216;word&#8217; &ndash;&#8220;word&#8221;'
> convert_quotes('&#8211;\'dash\' &#8212;"dash" &#x2013;\'hex\' &#x2014;"hex"')
  -> '&#8211;&#8217;dash&#8217; &#8212;&#8221;dash&#8221; &#x2013;&#8217;hex&#8217; &#x2014;&#8221;hex&#8221;'
> convert_quotes('("paren") [\'bracket\'] {"brace"} -\'dash\'-')
  -> '(&#8220;paren&#8221;) [&#8216;bracket&#8217;] {&#8220;brace&#8221;} -&#8216;dash&#8217;-'
> convert_quotes('"5\'10" tall"')
