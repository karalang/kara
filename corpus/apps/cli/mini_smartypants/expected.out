> _tokenize('emoji 🎉 "party" \'time\'')
  -> [['text', 'emoji 🎉 "party" \'time\'']]
> _tokenize('\'_underscore_\' "_also_"')
  -> [['text', '\'_underscore_\' "_also_"']]
> _tokenize('<b>"bold"</b> <i>\'italic\'</i>')
  -> [['tag', '<b>'], ['text', '"bold"'], ['tag', '</b>'], ['text', ' '], ['tag', '<i>'], ['text', "'italic'"], ['tag', '</i>']]
> _tokenize('<a href="x">"link"</a>')
  -> [['tag', '<a href="x">'], ['text', '"link"'], ['tag', '</a>']]
> _tokenize('<code>"code"</code> "after"')
  -> [['tag', '<code>'], ['text', '"code"'], ['tag', '</code>'], ['text', ' "after"']]
> _tokenize('<pre>"pre" -- </pre> -- "after"')
  -> [['tag', '<pre>'], ['text', '"pre" -- '], ['tag', '</pre>'], ['text', ' -- "after"']]
> _tokenize('<PRE>"upper"</PRE> "after"')
  -> [['tag', '<PRE>'], ['text', '"upper"'], ['tag', '</PRE>'], ['text', ' "after"']]
> _tokenize('<pre><code>"a"</pre> "b"</code> "c"')
  -> [['tag', '<pre>'], ['tag', '<code>'], ['text', '"a"'], ['tag', '</pre>'], ['text', ' "b"'], ['tag', '</code>'], ['text', ' "c"']]
> _tokenize('<code><pre>"a"</code></pre> "b"')
  -> [['tag', '<code>'], ['tag', '<pre>'], ['text', '"a"'], ['tag', '</code>'], ['tag', '</pre>'], ['text', ' "b"']]
> _tokenize('</pre> "stray close"')
  -> [['tag', '</pre>'], ['text', ' "stray close"']]
> _tokenize('<pre/> "self closing"')
  -> [['tag', '<pre/>'], ['text', ' "self closing"']]
> _tokenize('<prefix>"not pre"</prefix>')
  -> [['tag', '<prefix>'], ['text', '"not pre"'], ['tag', '</prefix>']]
> _tokenize('<script>if (a--) { x = "y"; }</script> -- "z"')
  -> [['tag', '<script>'], ['text', 'if (a--) { x = "y"; }'], ['tag', '</script>'], ['text', ' -- "z"']]
> _tokenize('<style>a { b: "c" }</style> "d"')
  -> [['tag', '<style>'], ['text', 'a { b: "c" }'], ['tag', '</style>'], ['text', ' "d"']]
> _tokenize('a < b and "c" > d')
  -> [['text', 'a '], ['tag', '< b and "c" >'], ['text', ' d']]
> _tokenize('<p "unterminated tag')
  -> [['text', '<p "unterminated tag']]
