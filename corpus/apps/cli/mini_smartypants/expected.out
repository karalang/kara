== changing the default
> Attr.default = 1
> smartypants('"foo" -- bar', None)
  -> '&#8220;foo&#8221; -- bar'
> smartypants('"foo" -- bar', 107)
  -> '&#8220;foo&#8221; &#8212; bar'
> smartypants('\'tis... the \'80s --- "really"', None)
  -> '&#8216;tis... the &#8216;80s --- &#8220;really&#8221;'
> smartypants('\'tis... the \'80s --- "really"', 107)
  -> '&#8216;tis&#8230; the &#8216;80s &#8211; &#8220;really&#8221;'
