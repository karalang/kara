== the library's examples and tests
> smartypants('"foo" -- bar', None)
  -> '&#8220;foo&#8221; &#8212; bar'
> smartypants('"Isn\'t this fun?"', None)
  -> '&#8220;Isn&#8217;t this fun?&#8221;'
> smartypants("'Isn't this fun?'", None)
  -> '&#8216;Isn&#8217;t this fun?&#8217;'
> smartypants("1440-80's", None)
  -> '1440-80&#8217;s'
> smartypants("1440-'80s", None)
  -> '1440-&#8216;80s'
> smartypants("1440--'80s", None)
  -> '1440&#8212;&#8216;80s'
> smartypants('1960s', None)
  -> '1960s'
> smartypants("1960's", None)
  -> '1960&#8217;s'
> smartypants("one two '60s", None)
  -> 'one two &#8216;60s'
> smartypants("'60s", None)
  -> '&#8216;60s'
> smartypants("the '80s and the 90's", None)
  -> 'the &#8216;80s and the 90&#8217;s'
> smartypants('21st century', None)
  -> '21st century'
> smartypants('3rd', None)
  -> '3rd'
> smartypants('You should use ";" here', None)
  -> 'You should use &#8220;;&#8221; here'
> smartypants('Take a look at the "<a>Essay on quoting</a>" paper.', None)
  -> 'Take a look at the &#8220;<a>Essay on quoting</a>&#8221; paper.'
> smartypants('Take a look at "<a>Essay on quoting</a>".', None)
  -> 'Take a look at &#8220;<a>Essay on quoting</a>&#8221;.'
> smartypants("<p>He said &quot;Let's write some code.&quot; This code here <code>if True:\n\tprint &quot;Okay&quot;</code> is python code.</p>", None)
  -> '<p>He said &quot;Let&#8217;s write some code.&quot; This code here <code>if True:\n\tprint &quot;Okay&quot;</code> is python code.</p>'
> smartypants('--', None)
  -> '&#8212;'
> smartypants('-->', None)
  -> '&#8212;>'
> smartypants('-- \t  >', None)
  -> '&#8212; \t  >'
> smartypants('<!-- "foo" --> blah--blah <!-- "bar" -->', None)
  -> '<!-- "foo" --> blah&#8212;blah <!-- "bar" -->'
> smartypants('<p>foo -- "bar"<!-- foo-bar\n<p>blah "this"</p>\n-->\n</p>', None)
  -> '<p>foo &#8212; &#8220;bar&#8221;<!-- foo-bar\n<p>blah "this"</p>\n-->\n</p>'
> smartypants('<!-- comment -->', None)
  -> '<!-- comment -->'
> smartypants('<!-- <li>Fee-fi-of-fum</li> -->', None)
  -> '<!-- <li>Fee-fi-of-fum</li> -->'
> smartypants('<!-- "foo" --> <!-- "bar" -->', None)
  -> '<!-- "foo" --> <!-- "bar" -->'
> smartypants('<!-- -- -->', None)
  -> '<!&#8212; &#8212; &#8212;>'
> smartypants('<!-- -- -- \t >', None)
  -> '<!&#8212; &#8212; &#8212; \t >'
> smartypants('<!---->', None)
  -> '<!---->'
> smartypants('<!-- --->', None)
  -> '<!-- --->'
> smartypants('<!-- x -- >', None)
  -> '<!-- x -- >'
> smartypants('"quote here"', None)
  -> '&#8220;quote here&#8221;'
> smartypants('"quote&ndash;here"', None)
  -> '&#8220;quote&ndash;here&#8221;'
> smartypants('Nothing endures but change. -- Heraclitus', None)
  -> 'Nothing endures but change. &#8212; Heraclitus'
> smartypants('Life itself is the proper binge. --- Julia Child (1912--2004)', None)
  -> 'Life itself is the proper binge. &#8212;- Julia Child (1912&#8212;2004)'
> smartypants('Dare to be naïve. -- Buckminster Fuller (1895---1983)', None)
  -> 'Dare to be naïve. &#8212; Buckminster Fuller (1895&#8212;-1983)'
> smartypants('Huh...?', None)
  -> 'Huh&#8230;?'
> smartypants('Wait. . . what?', None)
  -> 'Wait&#8230; what?'
> smartypants('Four.... dots', None)
  -> 'Four&#8230;. dots'
> smartypants('Spaced . . . . out', None)
  -> 'Spaced &#8230; . out'
> smartypants("``Isn't this fun?''", None)
  -> '&#8220;Isn&#8217;t this fun?&#8221;'
> smartypants('"foo" -- bar', 8)
  -> '"foo" &#8212; bar'
> smartypants("<p>He said &quot;Let's write some code.&quot;</p>", 128)
  -> '<p>He said "Let\'s write some code."</p>'
> smartypants("<p>He said &quot;Let's write some code.&quot;</p>", 129)
  -> '<p>He said &#8220;Let&#8217;s write some code.&#8221;</p>'
> smartypants('"quote here"', 331)
  -> '“quote here”'
> smartypants('"quote&ndash;here"', 331)
  -> '“quote&ndash;here”'
> smartypants('"quote here"', 587)
  -> '&ldquo;quote here&rdquo;'
> smartypants('"quote here"', 843)
  -> '"quote here"'
