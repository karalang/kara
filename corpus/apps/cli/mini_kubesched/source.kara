// mini_kubesched: a pod scheduler in the shape of kube-scheduler. Nodes
// and pods come from manifest files (each parsed in a task of its own);
// filter and score plugins place each pod, lower-priority pods are
// preempted when nothing fits, and a day of cluster events plays out.
// README.md is the spec; oracle.py is the reference.

const MILLI_DEFAULT: i64 = 100;
const MEM_DEFAULT: i64 = 200 * 1024 * 1024;
const KI: i64 = 1024;

// ------------------------------------------------------------ quantities

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn digits(s: Str) -> bool {
    s.len() > 0 and s.bytes().iter().all(|c| is_digit(c))
}

// An optional '-' and digits.
fn parse_int(s: Str) -> Option[i64] {
    let neg = s.starts_with("-");
    let body = if neg { s.substring(1) } else { s.to_string() };
    if not digits(body) or body.len() > 15 {
        return None;
    }
    let v = i64.parse(body).ok()?;
    Some(if neg { -v } else { v })
}

fn bad_quantity(s: Str) -> String {
    f"bad quantity '{s}'"
}

fn parse_cpu(s: Str) -> Result[i64, String] {
    if s.ends_with("m") {
        let n = s.substring(0, s.len() - 1);
        if not digits(n) or s.len() > 13 {
            return Err(bad_quantity(s));
        }
        return Ok(i64.parse(n).ok() ?? 0);
    }
    let (whole, frac) = match s.split_once(".") {
        Some((w, f)) => {
            if not digits(f) or f.len() > 3 {
                return Err(bad_quantity(s));
            }
            (w.to_string(), Some(f.to_string()))
        }
        None => (s.to_string(), None),
    };
    if not digits(whole) or whole.len() > 9 {
        return Err(bad_quantity(s));
    }
    let mut v = (i64.parse(whole).ok() ?? 0) * 1000;
    if let Some(f) = frac {
        let mut padded = f.clone();
        while padded.len() < 3 {
            padded.push_str("0");
        }
        v += i64.parse(padded).ok() ?? 0;
    }
    Ok(v)
}

fn mem_units() -> Vec[(String, i64)] {
    let mut out: Vec[(String, i64)] = Vec.new();
    out.push(("Ki".to_string(), KI));
    out.push(("Mi".to_string(), KI * KI));
    out.push(("Gi".to_string(), KI * KI * KI));
    out.push(("Ti".to_string(), KI * KI * KI * KI));
    out.push(("k".to_string(), 1000));
    out.push(("M".to_string(), 1000000));
    out.push(("G".to_string(), 1000000000));
    out.push(("T".to_string(), 1000000000000));
    out
}

fn parse_mem(s: Str) -> Result[i64, String] {
    for (suf, mul) in mem_units().iter() {
        if s.ends_with(suf) {
            let n = s.substring(0, s.len() - suf.len());
            if not digits(n) or n.len() > 9 {
                return Err(bad_quantity(s));
            }
            return Ok((i64.parse(n).ok() ?? 0) * mul);
        }
    }
    if not digits(s) or s.len() > 15 {
        return Err(bad_quantity(s));
    }
    Ok(i64.parse(s).ok() ?? 0)
}

fn show_cpu(m: i64) -> String {
    f"{m}m"
}

fn show_mem(b: i64) -> String {
    for (suf, mul) in [("Gi", KI * KI * KI), ("Mi", KI * KI), ("Ki", KI)].iter() {
        if b != 0 and b % mul == 0 {
            return f"{b / mul}{suf}";
        }
    }
    f"{b}"
}

fn pct(used: i64, cap: i64) -> i64 {
    if cap == 0 { 0 } else { used * 100 / cap }
}

// ------------------------------------------------------------ terms

#[derive(Clone)]
struct Taint {
    key: String,
    value: String,
    effect: String,
}

impl Taint {
    fn show(self) -> String {
        if self.value.len() > 0 {
            f"{self.key}={self.value}:{self.effect}"
        } else {
            f"{self.key}:{self.effect}"
        }
    }
}

// Key "" with `exists` tolerates every key; effect "" every effect.
#[derive(Clone)]
struct Toleration {
    key: String,
    exists: bool,
    value: String,
    effect: String,
}

#[derive(Clone)]
struct Req {
    key: String,
    op: String,
    vals: Vec[String],
}

#[derive(Clone)]
struct Pref {
    weight: i64,
    req: Req,
}

#[derive(Clone)]
struct Label {
    key: String,
    value: String,
}

#[derive(Clone)]
struct Apart {
    key: String,
    sel: Vec[Label],
}

#[derive(Clone)]
struct Spread {
    key: String,
    skew: i64,
    sel: Vec[Label],
}

fn is_effect(s: Str) -> bool {
    s == "NoSchedule" or s == "PreferNoSchedule" or s == "NoExecute"
}

fn is_op(s: Str) -> bool {
    s == "In" or s == "NotIn" or s == "Exists" or s == "DoesNotExist" or s == "Gt" or s == "Lt"
}

fn parse_label(tok: Str) -> Result[Label, String] {
    match tok.split_once("=") {
        Some((k, v)) if k.len() > 0 => Ok(Label { key: k.to_string(), value: v.to_string() }),
        _ => Err(f"bad label '{tok}'"),
    }
}

fn parse_selector(tok: Str) -> Result[Vec[Label], String] {
    let mut out: Vec[Label] = Vec.new();
    for t in tok.split(",") {
        out.push(parse_label(t)?);
    }
    Ok(out)
}

fn parse_taint(tok: Str) -> Result[Taint, String] {
    let Some((kv, eff)) = tok.rsplit_once(":") else {
        return Err(f"bad taint '{tok}'");
    };
    if kv.len() == 0 {
        return Err(f"bad taint '{tok}'");
    }
    if not is_effect(eff) {
        return Err(f"bad effect '{eff}'");
    }
    let (k, v) = kv.split_once("=") ?? (kv, "");
    if k.len() == 0 {
        return Err(f"bad taint '{tok}'");
    }
    Ok(Taint { key: k.to_string(), value: v.to_string(), effect: eff.to_string() })
}

fn parse_toleration(tok: Str) -> Result[Toleration, String] {
    if tok == "*" {
        return Ok(Toleration { key: "".to_string(), exists: true, value: "".to_string(), effect: "".to_string() });
    }
    let (kv, eff) = match tok.rsplit_once(":") {
        Some((kv, eff)) => {
            if not is_effect(eff) {
                return Err(f"bad effect '{eff}'");
            }
            (kv, eff)
        }
        None => (tok, ""),
    };
    let (k, v, exists) = match kv.split_once("=") {
        Some((k, v)) => (k, v, false),
        None => (kv, "", true),
    };
    if k.len() == 0 {
        return Err(f"bad toleration '{tok}'");
    }
    Ok(Toleration { key: k.to_string(), exists: exists, value: v.to_string(), effect: eff.to_string() })
}

fn parse_requirement(toks: Vec[Str]) -> Result[Req, String] {
    let text = toks.join(" ");
    if toks.len() < 2 {
        return Err(f"bad requirement '{text}'");
    }
    if not is_op(toks[1]) {
        return Err(f"bad operator '{toks[1]}'");
    }
    let key = toks[0].to_string();
    let op = toks[1].to_string();
    if op == "Exists" or op == "DoesNotExist" {
        if toks.len() != 2 {
            return Err(f"bad requirement '{text}'");
        }
        return Ok(Req { key: key, op: op, vals: Vec.new() });
    }
    if toks.len() != 3 {
        return Err(f"bad requirement '{text}'");
    }
    let vals: Vec[String] = toks[2].split(",").map(|v| v.to_string()).collect();
    if (op == "Gt" or op == "Lt") and (vals.len() != 1 or parse_int(vals[0]).is_none()) {
        return Err(f"bad requirement '{text}'");
    }
    Ok(Req { key: key, op: op, vals: vals })
}

fn holds(r: Req, labels: SortedMap[String, String]) -> bool {
    let got = labels.get(r.key);
    match r.op.as_str() {
        "In" => match got {
            Some(v) => r.vals.contains(v),
            None => false,
        },
        "NotIn" => match got {
            Some(v) => not r.vals.contains(v),
            None => true,
        },
        "Exists" => got.is_some(),
        "DoesNotExist" => got.is_none(),
        _ => {
            let Some(v) = got else {
                return false;
            };
            let Some(n) = parse_int(v) else {
                return false;
            };
            let bound = parse_int(r.vals[0]) ?? 0;
            if r.op == "Gt" { n > bound } else { n < bound }
        }
    }
}

fn tolerates(tols: Vec[Toleration], t: Taint) -> bool {
    for tol in tols.iter() {
        if tol.effect.len() > 0 and tol.effect != t.effect {
            continue;
        }
        if tol.exists and (tol.key.len() == 0 or tol.key == t.key) {
            return true;
        }
        if not tol.exists and tol.key == t.key and tol.value == t.value {
            return true;
        }
    }
    false
}

// ------------------------------------------------------------ manifests

#[derive(Clone)]
struct Node {
    name: String,
    cpu: i64,
    mem: i64,
    max_pods: i64,
    labels: SortedMap[String, String],
    taints: Vec[Taint],
    cordoned: bool,
    at: String,
}

#[derive(Clone)]
struct Pod {
    name: String,
    ns: String,
    prio: i64,
    cpu: i64,
    mem: i64,
    labels: SortedMap[String, String],
    select: Vec[Label],
    require: Vec[Req],
    prefer: Vec[Pref],
    tols: Vec[Toleration],
    apart: Vec[Apart],
    spread: Vec[Spread],
    node: Option[String],
    seq: i64,
    at: String,
}

enum Block {
    N(Node),
    P(Pod),
}

struct Parsed {
    nodes: Vec[Node],
    pods: Vec[Pod],
    errors: Vec[String],
}

fn parse_header(toks: Vec[Str], at: own String) -> Result[Block, String] {
    let kind = toks[0];
    if kind == "node" {
        if toks.len() < 2 {
            return Err("node needs a name".to_string());
        }
        let name = toks[1].to_string();
        let mut cpu: Option[i64] = None;
        let mut mem: Option[i64] = None;
        let mut pods: Option[i64] = None;
        for t in toks.iter().skip(2) {
            let Some((k, v)) = t.split_once("=") else {
                return Err(f"unknown field '{t}'");
            };
            if k == "cpu" {
                cpu = Some(parse_cpu(v)?);
            } else if k == "memory" {
                mem = Some(parse_mem(v)?);
            } else if k == "pods" {
                match parse_int(v) {
                    Some(n) if n >= 0 => pods = Some(n),
                    _ => return Err(bad_quantity(v)),
                }
            } else {
                return Err(f"unknown field '{t}'");
            }
        }
        let (Some(c), Some(m), Some(p)) = (cpu, mem, pods) else {
            return Err(f"node '{name}' needs cpu, memory and pods");
        };
        let mut labels: SortedMap[String, String] = SortedMap.new();
        labels.insert("hostname".to_string(), name.clone());
        return Ok(Block.N(Node {
            name: name.clone(),
            cpu: c,
            mem: m,
            max_pods: p,
            labels: labels,
            taints: Vec.new(),
            cordoned: false,
            at: at,
        }));
    }
    if kind == "pod" {
        if toks.len() < 2 {
            return Err("pod needs a name".to_string());
        }
        let name = toks[1].to_string();
        let ns = match name.split_once("/") {
            Some((ns, short)) if ns.len() > 0 and short.len() > 0 => ns.to_string(),
            _ => return Err(f"pod name '{name}' needs a namespace"),
        };
        let mut prio = 0;
        for t in toks.iter().skip(2) {
            match t.split_once("=") {
                Some(("priority", v)) => match parse_int(v) {
                    Some(n) => prio = n,
                    None => return Err(f"bad priority '{v}'"),
                },
                _ => return Err(f"unknown field '{t}'"),
            }
        }
        return Ok(Block.P(Pod {
            name: name,
            ns: ns,
            prio: prio,
            cpu: 0,
            mem: 0,
            labels: SortedMap.new(),
            select: Vec.new(),
            require: Vec.new(),
            prefer: Vec.new(),
            tols: Vec.new(),
            apart: Vec.new(),
            spread: Vec.new(),
            node: None,
            seq: 0,
            at: at,
        }));
    }
    Err(f"unknown directive '{kind}'")
}

fn node_field(n: mut ref Node, toks: Vec[Str]) -> Result[(), String] {
    let f = toks[0];
    let rest: Vec[Str] = toks.iter().skip(1).collect();
    if f == "label" {
        for t in rest.iter() {
            let l = parse_label(t)?;
            n.labels.insert(l.key, l.value);
        }
    } else if f == "taint" {
        for t in rest.iter() {
            n.taints.push(parse_taint(t)?);
        }
    } else if f == "unschedulable" and rest.len() == 0 {
        n.cordoned = true;
    } else {
        return Err(f"unknown field '{f}'");
    }
    Ok(())
}

fn pod_field(p: mut ref Pod, toks: Vec[Str]) -> Result[(), String] {
    let f = toks[0];
    let rest: Vec[Str] = toks.iter().skip(1).collect();
    if f == "request" {
        for t in rest.iter() {
            match t.split_once("=") {
                Some(("cpu", v)) => p.cpu = parse_cpu(v)?,
                Some(("memory", v)) => p.mem = parse_mem(v)?,
                _ => return Err(f"unknown field '{t}'"),
            }
        }
    } else if f == "label" {
        for t in rest.iter() {
            let l = parse_label(t)?;
            p.labels.insert(l.key, l.value);
        }
    } else if f == "select" {
        for t in rest.iter() {
            p.select.push(parse_label(t)?);
        }
    } else if f == "require" {
        p.require.push(parse_requirement(rest)?);
    } else if f == "prefer" {
        let w = if rest.len() > 0 { parse_int(rest[0]) } else { None };
        match w {
            Some(w) if w >= 1 and w <= 100 => {
                let req = parse_requirement(rest.iter().skip(1).collect())?;
                p.prefer.push(Pref { weight: w, req: req });
            }
            _ => {
                let shown = if rest.len() > 0 { rest[0] } else { "" };
                return Err(f"bad weight '{shown}'");
            }
        }
    } else if f == "tolerate" {
        for t in rest.iter() {
            p.tols.push(parse_toleration(t)?);
        }
    } else if f == "apart" {
        if rest.len() != 2 {
            return Err(f"bad term '{rest.join(" ")}'");
        }
        p.apart.push(Apart { key: rest[0].to_string(), sel: parse_selector(rest[1])? });
    } else if f == "spread" {
        if rest.len() != 3 {
            return Err(f"bad term '{rest.join(" ")}'");
        }
        let skew = match parse_int(rest[1]) {
            Some(s) if s >= 1 => s,
            _ => return Err(f"bad skew '{rest[1]}'"),
        };
        p.spread.push(Spread { key: rest[0].to_string(), skew: skew, sel: parse_selector(rest[2])? });
    } else {
        return Err(f"unknown field '{f}'");
    }
    Ok(())
}

fn close_block(cur: own Option[Block], bad: bool, out: mut ref Parsed) {
    if bad {
        return;
    }
    match cur {
        Some(Block.N(n)) => out.nodes.push(n),
        Some(Block.P(p)) => out.pods.push(p),
        None => {}
    }
}

fn parse_file(path: String, text: String) -> Parsed {
    let mut out = Parsed { nodes: Vec.new(), pods: Vec.new(), errors: Vec.new() };
    let mut cur: Option[Block] = None;
    let mut bad = false;
    for (i, raw) in text.split("\n").enumerate() {
        let line = match raw.split_once("#") {
            Some((before, _)) => before,
            None => raw,
        };
        let toks: Vec[Str] = line.split_whitespace().collect();
        if toks.len() == 0 {
            continue;
        }
        let at = f"{path}:{i + 1}";
        if line.starts_with(" ") or line.starts_with("\t") {
            if bad {
                continue;
            }
            let res = match cur {
                Some(Block.N(mut ref n)) => node_field(mut n, toks),
                Some(Block.P(mut ref p)) => pod_field(mut p, toks),
                None => Err("field outside a block".to_string()),
            };
            if let Err(e) = res {
                out.errors.push(f"{at}: {e}");
                bad = true;
            }
            continue;
        }
        close_block(cur, bad, mut out);
        cur = None;
        bad = false;
        match parse_header(toks, at.clone()) {
            Ok(b) => cur = Some(b),
            Err(e) => {
                out.errors.push(f"{at}: {e}");
                bad = true;
            }
        }
    }
    close_block(cur, bad, mut out);
    out
}

// ------------------------------------------------------------ the cluster

fn sel_matches(sel: Vec[Label], ns: Str, p: Pod) -> bool {
    p.ns == ns and sel.iter().all(|l| p.labels.get(l.key) == Some(ref l.value))
}

fn label_of(n: Node, key: Str) -> Option[String] {
    n.labels.get(key).cloned()
}

fn is_resource(why: Str) -> bool {
    why == "Too many pods" or why == "Insufficient cpu" or why == "Insufficient memory"
}

struct Cluster {
    nodes: SortedMap[String, Node],
    pods: SortedMap[String, Pod],
    pending: Vec[String],
    next_seq: i64,
    out: Vec[String],
}

impl Cluster {
    fn admit(mut ref self, nodes: own Vec[Node], pods: own Vec[Pod]) {
        for n in nodes.into_iter() {
            if self.nodes.contains_key(n.name) {
                self.out.push(f"{n.at}: duplicate node '{n.name}'");
                continue;
            }
            self.nodes.insert(n.name.clone(), n);
        }
        for p in pods.into_iter() {
            if self.pods.contains_key(p.name) {
                self.out.push(f"{p.at}: duplicate pod '{p.name}'");
                continue;
            }
            let mut p = p;
            p.seq = self.next_seq;
            self.next_seq += 1;
            self.pending.push(p.name.clone());
            self.pods.insert(p.name.clone(), p);
        }
    }

    fn on(self, node: Str) -> Vec[Pod] {
        self.pods.values().filter(|p| p.node == Some(node.to_string())).cloned().collect()
    }

    // cpu, memory and pod count on a node, leaving out the pods in skip.
    fn used(self, node: Str, skip: Vec[String]) -> (i64, i64, i64) {
        let mut c = 0;
        let mut m = 0;
        let mut k = 0;
        for p in self.pods.values() {
            if p.node == Some(node.to_string()) and not skip.contains(p.name) {
                c += p.cpu;
                m += p.mem;
                k += 1;
            }
        }
        (c, m, k)
    }

    fn affinity_ok(self, pod: Pod, n: Node) -> bool {
        for l in pod.select.iter() {
            if n.labels.get(l.key) != Some(ref l.value) {
                return false;
            }
        }
        pod.require.iter().all(|r| holds(r, n.labels))
    }

    // The running pods other than `pod` and those in skip.
    fn others(self, pod: Pod, skip: Vec[String]) -> Vec[Pod] {
        self.pods
            .values()
            .filter(|p| p.node.is_some() and p.name != pod.name and not skip.contains(p.name))
            .cloned()
            .collect()
    }

    fn host(self, p: Pod) -> Node {
        let name = p.node.clone() ?? "".to_string();
        self.nodes.get(name).cloned().unwrap()
    }

    // Why node n refuses pod; empty when it fits.
    fn filter(self, pod: Pod, n: Node, skip: Vec[String]) -> Vec[String] {
        let mut why: Vec[String] = Vec.new();
        if n.cordoned {
            why.push("node(s) were unschedulable".to_string());
            return why;
        }
        for t in n.taints.iter() {
            if t.effect != "PreferNoSchedule" and not tolerates(pod.tols, t) {
                why.push(f"node(s) had untolerated taint {{{t.key}: {t.value}}}");
                return why;
            }
        }
        if not self.affinity_ok(pod, n) {
            why.push("node(s) didn't match Pod's node affinity/selector".to_string());
            return why;
        }
        let (c, m, k) = self.used(n.name, skip);
        if k + 1 > n.max_pods {
            why.push("Too many pods".to_string());
        }
        if c + pod.cpu > n.cpu {
            why.push("Insufficient cpu".to_string());
        }
        if m + pod.mem > n.mem {
            why.push("Insufficient memory".to_string());
        }
        if why.len() > 0 {
            return why;
        }
        let others = self.others(pod, skip);
        for s in pod.spread.iter() {
            let Some(mine) = label_of(n, s.key) else {
                why.push("node(s) didn't match pod topology spread constraints".to_string());
                return why;
            };
            let mut counts: SortedMap[String, i64] = SortedMap.new();
            let mut eligible: Vec[String] = Vec.new();
            for m2 in self.nodes.values() {
                if let Some(d) = label_of(m2, s.key) {
                    if self.affinity_ok(pod, m2) {
                        counts.insert(d, 0);
                        eligible.push(m2.name.clone());
                    }
                }
            }
            for p in others.iter() {
                let host = p.node.clone() ?? "".to_string();
                if eligible.contains(host) and sel_matches(s.sel, pod.ns, p) {
                    let d = label_of(self.host(p), s.key) ?? "".to_string();
                    let c = counts.get(d).cloned() ?? 0;
                    counts.insert(d, c + 1);
                }
            }
            let me = if sel_matches(s.sel, pod.ns, pod) { 1 } else { 0 };
            let low = counts.values().cloned().min() ?? 0;
            let here = counts.get(mine).cloned() ?? 0;
            if here + me - low > s.skew {
                why.push("node(s) didn't match pod topology spread constraints".to_string());
                return why;
            }
        }
        for a in pod.apart.iter() {
            let Some(mine) = label_of(n, a.key) else {
                continue;
            };
            for p in others.iter() {
                if label_of(self.host(p), a.key) == Some(mine.clone()) and sel_matches(a.sel, pod.ns, p) {
                    why.push("node(s) didn't match pod anti-affinity rules".to_string());
                    return why;
                }
            }
        }
        for p in others.iter() {
            let host = self.host(p);
            for a in p.apart.iter() {
                if let Some(mine) = label_of(n, a.key) {
                    if label_of(host, a.key) == Some(mine) and sel_matches(a.sel, p.ns, pod) {
                        why.push("node(s) didn't satisfy existing pods anti-affinity rules".to_string());
                        return why;
                    }
                }
            }
        }
        why
    }

    // The total score of each feasible node.
    fn scores(self, pod: Pod, feasible: Vec[Node]) -> SortedMap[String, i64] {
        let pc = if pod.cpu == 0 { MILLI_DEFAULT } else { pod.cpu };
        let pm = if pod.mem == 0 { MEM_DEFAULT } else { pod.mem };
        let mut least: SortedMap[String, i64] = SortedMap.new();
        let mut bal: SortedMap[String, i64] = SortedMap.new();
        let mut aff: SortedMap[String, i64] = SortedMap.new();
        let mut taint: SortedMap[String, i64] = SortedMap.new();
        let mut spread: SortedMap[String, i64] = SortedMap.new();
        for n in feasible.iter() {
            let mut c = pc;
            let mut m = pm;
            for p in self.on(n.name).iter() {
                c += if p.cpu == 0 { MILLI_DEFAULT } else { p.cpu };
                m += if p.mem == 0 { MEM_DEFAULT } else { p.mem };
            }
            let lc = if n.cpu == 0 { 0 } else { (n.cpu - c).max(0) * 100 / n.cpu };
            let lm = if n.mem == 0 { 0 } else { (n.mem - m).max(0) * 100 / n.mem };
            least.insert(n.name.clone(), (lc + lm) / 2);
            let fc = if n.cpu == 0 { 10000 } else { (c * 10000 / n.cpu).min(10000) };
            let fm = if n.mem == 0 { 10000 } else { (m * 10000 / n.mem).min(10000) };
            bal.insert(n.name.clone(), (20000 - (fc - fm).abs()) / 200);
            let mut a = 0;
            for pr in pod.prefer.iter() {
                if holds(pr.req, n.labels) {
                    a += pr.weight;
                }
            }
            aff.insert(n.name.clone(), a);
            let mut t = 0;
            for tn in n.taints.iter() {
                if tn.effect == "PreferNoSchedule" and not tolerates(pod.tols, tn) {
                    t += 1;
                }
            }
            taint.insert(n.name.clone(), t);
            let mut s = 0;
            for sp in pod.spread.iter() {
                let mine = label_of(n, sp.key);
                for p in self.others(pod, Vec.new()).iter() {
                    if label_of(self.host(p), sp.key) == mine and sel_matches(sp.sel, pod.ns, p) {
                        s += 1;
                    }
                }
            }
            spread.insert(n.name.clone(), s);
        }
        let hi = aff.values().cloned().max() ?? 0;
        let ht = taint.values().cloned().max() ?? 0;
        let hs = spread.values().cloned().max() ?? 0;
        let ls = spread.values().cloned().min() ?? 0;
        let mut total: SortedMap[String, i64] = SortedMap.new();
        for (name, l) in least.iter() {
            let a = aff.get(name).cloned() ?? 0;
            let a = if hi == 0 { 0 } else { a * 100 / hi };
            let t = taint.get(name).cloned() ?? 0;
            let t = if ht == 0 { 100 } else { 100 - t * 100 / ht };
            let s = spread.get(name).cloned() ?? 0;
            let s = if pod.spread.len() == 0 {
                0
            } else if hs == 0 {
                100
            } else {
                (hs + ls - s) * 100 / hs
            };
            let b = bal.get(name).cloned() ?? 0;
            total.insert(name.clone(), l + b + 2 * a + 3 * t + 2 * s);
        }
        total
    }

    // The node to preempt on and its victims, or None.
    fn preempt(self, pod: Pod) -> Option[(String, Vec[String])] {
        let mut best: Option[((i64, i64, i64, String), Vec[String])] = None;
        for n in self.nodes.values() {
            let why = self.filter(pod, n, Vec.new());
            if not why.iter().all(|w| is_resource(w)) {
                continue;
            }
            let mut lower: Vec[Pod] = self.on(n.name).into_iter().filter(|p| p.prio < pod.prio).collect();
            if lower.len() == 0 {
                continue;
            }
            let mut gone: Vec[String] = lower.iter().map(|p| p.name.clone()).collect();
            if self.filter(pod, n, gone).len() > 0 {
                continue;
            }
            lower.sort_by_key(|p| (-p.prio, p.seq));
            for p in lower.iter() {
                gone.retain(|g| g != p.name);
                if self.filter(pod, n, gone).len() > 0 {
                    gone.push(p.name.clone());
                }
            }
            gone.sort();
            let prios: Vec[i64] = gone.iter().map(|v| self.pods.get(v).unwrap().prio).collect();
            let key = (prios.iter().cloned().max() ?? 0, prios.iter().sum(), gone.len(), n.name.clone());
            let better = match best {
                Some((ref k, _)) => key < k,
                None => true,
            };
            if better {
                best = Some((key, gone));
            }
        }
        best.map(|(k, v)| (k.3, v))
    }

    fn set_node(mut ref self, pod: Str, node: own Option[String]) {
        if let Some(p) = self.pods.get_mut(pod) {
            p.node = node;
        }
    }

    fn queue_order(self, names: Vec[String]) -> Vec[String] {
        let mut q = names.clone();
        q.sort_by_key(|n| {
            let p = self.pods.get(n).unwrap();
            (-p.prio, p.seq)
        });
        q
    }

    fn schedule(mut ref self) {
        let queue = self.queue_order(self.pending);
        self.pending = Vec.new();
        let mut bound = 0;
        for name in queue.iter() {
            let pod = self.pods.get(name).cloned().unwrap();
            let mut feasible: Vec[Node] = Vec.new();
            let mut reasons: SortedMap[String, i64] = SortedMap.new();
            for n in self.nodes.values() {
                let why = self.filter(pod, n, Vec.new());
                if why.len() == 0 {
                    feasible.push(n.clone());
                }
                for w in why.into_iter() {
                    let c = reasons.get(w).cloned() ?? 0;
                    reasons.insert(w, c + 1);
                }
            }
            if feasible.len() > 0 {
                let sc = self.scores(pod, feasible);
                let top = sc.values().cloned().max() ?? 0;
                let pick = sc.iter().find(|(_, v)| v == top).map(|(k, _)| k.clone()).unwrap();
                self.set_node(name, Some(pick.clone()));
                bound += 1;
                self.out.push(f"bind {name} -> {pick} (score {top})");
                continue;
            }
            if let Some((node, victims)) = self.preempt(pod) {
                self.out.push(f"preempt on {node} for {name}: evicts {victims.join(", ")}");
                for v in victims.iter() {
                    self.set_node(v, None);
                    self.pending.push(v.clone());
                }
                self.set_node(name, Some(node.clone()));
                bound += 1;
                self.out.push(f"bind {name} -> {node} (after preemption)");
                continue;
            }
            let mut parts: Vec[String] = reasons.iter().map(|(w, c)| f"{c} {w}").collect();
            parts.sort();
            self.out.push(f"FailedScheduling {name}: 0/{self.nodes.len()} nodes are available: {parts.join(", ")}.");
            self.pending.push(name.clone());
        }
        self.out.push(f"bound {bound}, pending {self.pending.len()}");
    }

    fn evict(mut ref self, name: Str, why: Str) {
        let node = self.pods.get(name).and_then(|p| p.node.clone()) ?? "".to_string();
        self.out.push(f"evict {name} from {node} ({why})");
        self.set_node(name, None);
        self.pending.push(name.to_string());
    }

    fn pod_names_on(self, node: Str) -> Vec[String] {
        let mut names: Vec[String] = self.on(node).iter().map(|p| p.name.clone()).collect();
        names.sort();
        names
    }

    fn event(mut ref self, toks: Vec[Str]) -> Result[(), String] {
        let cmd = toks[0];
        let args: Vec[Str] = toks.iter().skip(1).collect();
        let whole = toks.join(" ");
        if cmd == "schedule" and args.len() == 0 {
            self.schedule();
        } else if cmd == "apply" and args.len() == 1 {
            let path = args[0].to_string();
            let text = read(path)?;
            let parsed = parse_file(path.clone(), text);
            self.out.push(f"{path}: {parsed.nodes.len()} nodes, {parsed.pods.len()} pods");
            for e in parsed.errors.iter() {
                self.out.push(e.clone());
            }
            self.admit(parsed.nodes, parsed.pods);
        } else if cmd == "delete" and args.len() == 1 {
            let name = args[0].to_string();
            if self.pods.remove(name).is_none() {
                return Err(f"no pod '{name}'");
            }
            self.pending.retain(|q| q != name);
            self.out.push(f"deleted {name}");
        } else if (cmd == "cordon" or cmd == "uncordon" or cmd == "drain" or cmd == "fail" or cmd == "taint" or cmd == "untaint") and args.len() > 0 {
            let node = args[0].to_string();
            if not self.nodes.contains_key(node) {
                return Err(f"no node '{node}'");
            }
            if (cmd == "cordon" or cmd == "uncordon") and args.len() == 1 {
                let on = cmd == "cordon";
                self.nodes.get_mut(node).unwrap().cordoned = on;
                self.out.push(f"node {node} {cmd}ed");
            } else if cmd == "drain" and args.len() == 1 {
                self.nodes.get_mut(node).unwrap().cordoned = true;
                for p in self.pod_names_on(node).iter() {
                    self.evict(p, "drain");
                }
                self.out.push(f"node {node} drained");
            } else if cmd == "fail" and args.len() == 1 {
                let gone = self.pod_names_on(node);
                for q in gone.iter() {
                    self.set_node(q, None);
                    self.pending.push(q.clone());
                }
                self.nodes.remove(node);
                self.out.push(f"node {node} failed: {gone.len()} pods back to pending");
            } else if cmd == "taint" and args.len() == 2 {
                let t = parse_taint(args[1])?;
                self.nodes.get_mut(node).unwrap().taints.push(t.clone());
                self.out.push(f"node {node} tainted {t.show()}");
                if t.effect == "NoExecute" {
                    for name in self.pod_names_on(node).iter() {
                        let p = self.pods.get(name).cloned().unwrap();
                        if not tolerates(p.tols, t) {
                            self.evict(name, f"taint {t.show()}");
                        }
                    }
                }
            } else if cmd == "untaint" and args.len() == 2 {
                let key = args[1].to_string();
                let n = self.nodes.get_mut(node).unwrap();
                let before = n.taints.len();
                n.taints.retain(|t| t.key != key);
                let removed = before - n.taints.len();
                self.out.push(f"node {node} untainted {key} ({removed} removed)");
            } else {
                return Err(f"bad event '{whole}'");
            }
        } else if cmd == "show" and args.len() == 1 and args[0] == "pods" {
            let mut rows: Vec[Vec[String]] = Vec.new();
            rows.push(["NAMESPACE", "NAME", "PRIORITY", "STATUS", "NODE"].iter().map(|s| s.to_string()).collect());
            for p in self.pods.values() {
                let short = p.name.split_once("/").map(|(_, s)| s.to_string()) ?? "".to_string();
                let status = if p.node.is_some() { "Running" } else { "Pending" };
                let node = p.node.clone() ?? "<none>".to_string();
                rows.push([p.ns.clone(), short, f"{p.prio}", status.to_string(), node].to_vec());
            }
            table(rows, mut self.out);
        } else if cmd == "show" and args.len() == 1 and args[0] == "nodes" {
            let mut rows: Vec[Vec[String]] = Vec.new();
            rows.push(["NAME", "STATUS", "CPU", "MEMORY", "PODS", "TAINTS"].iter().map(|s| s.to_string()).collect());
            for n in self.nodes.values() {
                let (c, m, k) = self.used(n.name, Vec.new());
                let status = if n.cordoned { "Ready,SchedulingDisabled" } else { "Ready" };
                let taints: Vec[String] = n.taints.iter().map(|t| t.show()).collect();
                let shown = if taints.len() == 0 { "<none>".to_string() } else { taints.join(",") };
                rows.push([
                    n.name.clone(),
                    status.to_string(),
                    f"{show_cpu(c)}/{show_cpu(n.cpu)} ({pct(c, n.cpu)}%)",
                    f"{show_mem(m)}/{show_mem(n.mem)} ({pct(m, n.mem)}%)",
                    f"{k}/{n.max_pods}",
                    shown,
                ].to_vec());
            }
            table(rows, mut self.out);
        } else if cmd == "show" and args.len() == 1 and args[0] == "pending" {
            let q = self.queue_order(self.pending);
            if q.len() == 0 {
                self.out.push("0 pending".to_string());
            } else {
                self.out.push(f"{q.len()} pending: {q.join(", ")}");
            }
        } else {
            return Err(f"bad event '{whole}'");
        }
        Ok(())
    }
}

fn table(rows: Vec[Vec[String]], out: mut ref Vec[String]) {
    let mut w: Vec[i64] = Vec.new();
    for i in 0..rows[0].len() {
        w.push(rows.iter().map(|r| r[i].len()).max() ?? 0);
    }
    for r in rows.iter() {
        let mut line = String.new();
        for (i, c) in r.iter().enumerate() {
            if i > 0 {
                line.push_str("   ");
            }
            line.push_str(c);
            for _ in c.len()..w[i] {
                line.push_str(" ");
            }
        }
        out.push(line.trim_end().to_string());
    }
}

fn read(path: Str) -> Result[String, String] {
    match fs.read_to_string(path.to_string()) {
        Ok(t) => Ok(t),
        Err(_) => Err(f"cannot read {path}"),
    }
}

fn run() -> Result[(), String] {
    fs.create_dir_all("data/out".to_string()).map_err(|e| f"cannot create data/out: {e}")?;
    write_data()?;
    let mut names: Vec[String] = fs.read_dir("data".to_string()).map_err(|e| f"cannot list data: {e}")?
        .into_iter()
        .filter(|n| n.ends_with(".nodes") or n.ends_with(".pods"))
        .collect();
    names.sort();
    // Each manifest is parsed in a task of its own.
    let group = TaskGroup.new();
    let mut handles = Vec.new();
    for name in names.iter() {
        let path = f"data/{name}";
        let text = read(path)?;
        handles.push(group.spawn(|| parse_file(path, text)));
    }
    let mut out: Vec[String] = Vec.new();
    out.push("== load".to_string());
    let mut nodes: Vec[Node] = Vec.new();
    let mut pods: Vec[Pod] = Vec.new();
    for (name, h) in names.iter().zip(handles.into_iter()) {
        let p = h.join();
        out.push(f"data/{name}: {p.nodes.len()} nodes, {p.pods.len()} pods");
        for e in p.errors.into_iter() {
            out.push(e);
        }
        for n in p.nodes.into_iter() {
            nodes.push(n);
        }
        for q in p.pods.into_iter() {
            pods.push(q);
        }
    }
    let mut c = Cluster { nodes: SortedMap.new(), pods: SortedMap.new(), pending: Vec.new(), next_seq: 0, out: out };
    c.admit(nodes, pods);
    c.out.push(f"{c.nodes.len()} nodes, {c.pods.len()} pods");
    c.out.push("== events".to_string());
    for (i, raw) in read("data/events.txt")?.split("\n").enumerate() {
        let line = match raw.split_once("#") {
            Some((before, _)) => before.trim(),
            None => raw.trim(),
        };
        if line.len() == 0 {
            continue;
        }
        c.out.push(f"> {line}");
        if let Err(e) = c.event(line.split_whitespace().collect()) {
            c.out.push(f"error: data/events.txt:{i + 1}: {e}");
        }
    }
    let mut rows: Vec[String] = Vec.new();
    for p in c.pods.values() {
        if let Some(n) = p.node.clone() {
            rows.push(f"{p.name} {n}");
        }
    }
    rows.sort();
    let mut body = String.new();
    for r in rows.iter() {
        body.push_str(r);
        body.push_str("\n");
    }
    put_bytes("data/out/bindings.txt", body.bytes().to_vec())?;
    let back = read("data/out/bindings.txt")?;
    let lines: Vec[Str] = back.split("\n").filter(|l| l.len() > 0).collect();
    c.out.push("== write".to_string());
    c.out.push(f"data/out/bindings.txt: {lines.len()} bindings, {back.len()} bytes");
    let mut per: SortedMap[String, i64] = SortedMap.new();
    for l in lines.iter() {
        let node = l.split_once(" ").map(|(_, n)| n.to_string()) ?? "".to_string();
        let k = per.get(node).cloned() ?? 0;
        per.insert(node, k + 1);
    }
    let counts: Vec[String] = per.iter().map(|(k, v)| f"{k} {v}").collect();
    c.out.push(counts.join(", "));
    println(c.out.join("\n"));
    Ok(())
}

fn is_hexd(c: u8) -> bool {
    is_digit(c) or (c >= b'a' and c <= b'f')
}

fn hex_val(c: u8) -> u8 {
    if is_digit(c) { c - b'0' } else { c - b'a' + 10 }
}

fn unhex(s: Str) -> Vec[u8] {
    let mut digits: Vec[u8] = Vec.new();
    for c in s.bytes() {
        if is_hexd(c) {
            digits.push(hex_val(c));
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < digits.len() {
        out.push(digits[i] * 16 + digits[i + 1]);
        i += 2;
    }
    out
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        eprintln(e);
    }
}

// ============================================================ data

// The files under data/, in name order.
fn write_data() -> Result[(), String] {
    put_bytes("data/batch.pods", unhex(file_0()))?;
    put_bytes("data/cluster.nodes", unhex(file_1()))?;
    put_bytes("data/events.txt", unhex(file_2()))?;
    put_bytes("data/scaleup.later", unhex(file_3()))?;
    put_bytes("data/system.pods", unhex(file_4()))?;
    put_bytes("data/urgent.later", unhex(file_5()))?;
    put_bytes("data/web.pods", unhex(file_6()))?;
    put_bytes("data/zz_broken.pods", unhex(file_7()))?;
    Ok(())
}

