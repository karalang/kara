fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data")?;
    put("data/acl.txt", file_0())?;
    put("data/addresses.txt", file_1())?;
    put("data/conns.txt", file_2())?;
    put("data/networks.txt", file_3())?;
    put("data/ops.txt", file_4())?;
    put("data/plan.txt", file_5())?;
    Ok(())
}

// ------------------------------------------------------------ the address plan

// The pools, the free blocks and the allocations of both versions.
struct Plan {
    pools4: Vec[Net],
    pools6: Vec[Net],
    free4: Vec[Net],
    free6: Vec[Net],
    // the allocations in the order they were made
    names: Vec[String],
    nets: Vec[Net],
}

fn collapse_list(nets: ref Vec[Net]) -> Vec[Net] {
    let mut items: Vec[Item] = Vec.new();
    for i in 0..nets.len() {
        items.push(net_item(nets[i]));
    }
    match collapse(items) {
        Ok(v) => v,
        Err(_) => nets.clone(),
    }
}

impl Plan {
    fn pools(ref self, v: i64) -> Vec[Net] {
        if v == 4 { self.pools4.clone() } else { self.pools6.clone() }
    }

    fn free(ref self, v: i64) -> Vec[Net] {
        if v == 4 { self.free4.clone() } else { self.free6.clone() }
    }

    fn set_free(mut ref self, v: i64, f: own Vec[Net]) {
        if v == 4 {
            self.free4 = f;
        } else {
            self.free6 = f;
        }
    }

    fn add_free(mut ref self, v: i64, nets: ref Vec[Net]) {
        let mut all = self.free(v);
        for i in 0..nets.len() {
            all.push(nets[i].clone());
        }
        self.set_free(v, collapse_list(all));
    }

    fn find(ref self, name: Str) -> i64 {
        for i in 0..self.names.len() {
            if self.names[i] == name {
                return i;
            }
        }
        -1
    }

    // Carve `net` out of the free block that holds it.
    fn take(mut ref self, name: Str, net: ref Net) -> bool {
        let v = net.addr.v;
        let mut free = self.free(v);
        for i in 0..free.len() {
            let b = free[i].clone();
            let inside = match subnet_of(net, b) {
                Ok(x) => x,
                Err(_) => false,
            };
            if inside {
                free.remove(i);
                self.set_free(v, free);
                let rest = match exclude(b, net) {
                    Ok(r) => r,
                    Err(_) => Vec.new(),
                };
                self.add_free(v, rest);
                let at = self.find(name);
                if at >= 0 {
                    self.nets[at] = net.clone();
                } else {
                    self.names.push(name.to_string());
                    self.nets.push(net.clone());
                }
                return true;
            }
        }
        false
    }

    fn show(ref self) {
        for v in [4, 6] {
            println(f"  IPv{v}:");
            let pools = self.pools(v);
            let free = self.free(v);
            for pi in 0..pools.len() {
                let p = pools[pi].clone();
                let mut inside: Vec[i64] = Vec.new();
                for i in 0..self.nets.len() {
                    let n = self.nets[i].clone();
                    if n.addr.v == v and subnet_of(n, p) == Ok(true) {
                        inside.push(i);
                    }
                }
                for i in 1..inside.len() {
                    let mut j = i;
                    while j > 0 and self.before(inside[j], inside[j - 1]) {
                        inside.swap(j - 1, j);
                        j -= 1;
                    }
                }
                let mut used: u128 = 0;
                for i in 0..inside.len() {
                    used += num_addresses(self.nets[inside[i]]);
                }
                let total = num_addresses(p);
                println(f"    pool {net_str(p)}: {used}/{total} used ({used * 100 / total}%)");
                for i in 0..inside.len() {
                    println(f"      {net_str(self.nets[inside[i]])} {self.names[inside[i]]}");
                }
                for i in 0..free.len() {
                    if subnet_of(free[i], p) == Ok(true) {
                        println(f"      {net_str(free[i])} free");
                    }
                }
            }
        }
    }

    // (network, name) order
    fn before(ref self, a: i64, b: i64) -> bool {
        let na = self.nets[a].clone();
        let nb = self.nets[b].clone();
        if net_lt(na, nb) {
            return true;
        }
        if net_lt(nb, na) {
            return false;
        }
        self.names[a] < self.names[b]
    }
}

fn show_plan() -> Result[Plan, String] {
    println("== plan");
    let mut plan = Plan { pools4: Vec.new(), pools6: Vec.new(), free4: Vec.new(), free6: Vec.new(), names: Vec.new(), nets: Vec.new() };
    let lines = lines_of(read("data/plan.txt")?);
    for li in 0..lines.len() {
        let w = split_ws(lines[li]);
        let cmd = w[0].clone();
        if cmd == "pool" {
            let n = match ip_network(w[1], true) {
                Ok(n) => n,
                Err(e) => return Err(show_err(e)),
            };
            let v = n.addr.v;
            if v == 4 {
                plan.pools4.push(n.clone());
            } else {
                plan.pools6.push(n.clone());
            }
            let mut one: Vec[Net] = Vec.new();
            one.push(n.clone());
            plan.add_free(v, one);
            println(f"pool {net_str(n)} ({num_addresses(n)} addresses)");
        } else if cmd == "reserve" {
            let name = w[1].clone();
            let n = match ip_network(w[2], true) {
                Ok(n) => n,
                Err(e) => return Err(show_err(e)),
            };
            let mut clash: i64 = -1;
            for i in 0..plan.nets.len() {
                let o = plan.nets[i].clone();
                if clash < 0 and o.addr.v == n.addr.v and overlaps(o, n) {
                    clash = i;
                }
            }
            if clash >= 0 {
                println(f"reserve {name}: {net_str(n)} overlaps {plan.names[clash]} ({net_str(plan.nets[clash])})");
            } else if plan.take(name, n) {
                println(f"reserve {name} {net_str(n)}");
            } else {
                println(f"reserve {name}: {net_str(n)} is outside every pool");
            }
        } else if cmd == "alloc" {
            let name = w[1].clone();
            let v = digits_value(slice_from(w[2], 1)) as i64;
            let p = digits_value(slice_from(w[3], 1)) as i64;
            if p > max_plen(v) {
                println(f"alloc {name}: /{p} is not a valid IPv{v} prefix");
                continue;
            }
            let free = plan.free(v);
            let mut best: i64 = -1;
            for i in 0..free.len() {
                if free[i].plen <= p and (best < 0 or free[i].plen > free[best].plen) {
                    best = i;
                }
            }
            if best < 0 {
                println(f"alloc {name}: no free /{p} in the IPv{v} pools");
                continue;
            }
            let block = free[best].clone();
            let net = net_of(v, block.addr.ip, p);
            plan.take(name, net);
            println(f"alloc {name} {net_str(net)} (from {net_str(block)})");
        } else if cmd == "free" {
            let name = w[1].clone();
            let at = plan.find(name);
            if at < 0 {
                println(f"free {name}: no such allocation");
                continue;
            }
            let n = plan.nets[at].clone();
            plan.names.remove(at);
            plan.nets.remove(at);
            let mut one: Vec[Net] = Vec.new();
            one.push(n.clone());
            plan.add_free(n.addr.v, one);
            println(f"free {name} {net_str(n)}");
        } else if cmd == "show" {
            println("show");
            plan.show();
        }
    }
    Ok(plan)
}

// ------------------------------------------------------------ the firewall

struct Rule {
    k: i64,
    action: String,
    proto: String,
    any_src: bool,
    src: Net,
    any_dst: bool,
    dst: Net,
    // (lo, hi) pairs; empty for any port
    ports: Vec[i64],
}

// A rule's source or destination: `any`, `@allocation` or a network.
fn endpoint(s: Str, plan: ref Plan) -> Result[(bool, Net), IpError] {
    if s == "any" {
        return Ok((true, net_of(4, 0, 0)));
    }
    if first_byte(s) == b'@' {
        let name = slice_from(s, 1);
        let at = plan.find(name);
        if at < 0 {
            return Err(ve(f"no allocation named {py_repr(name)}"));
        }
        return Ok((false, plan.nets[at].clone()));
    }
    Ok((false, ip_network(s, true)?))
}

fn parse_ports(s: Str) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    if s == "any" {
        return out;
    }
    let parts = split_on(s, b',');
    for i in 0..parts.len() {
        let (lo, dash, hi) = partition(parts[i], b'-');
        out.push(digits_value(lo) as i64);
        out.push(digits_value(if dash { hi } else { lo.clone() }) as i64);
    }
    out
}

fn ports_str(p: ref Vec[i64]) -> String {
    if p.len() == 0 {
        return "any".to_string();
    }
    let mut out: Vec[String] = Vec.new();
    let mut i: i64 = 0;
    while i < p.len() {
        out.push(if p[i] == p[i + 1] { f"{p[i]}" } else { f"{p[i]}-{p[i + 1]}" });
        i += 2;
    }
    join(out, ",")
}

fn side_str(any: bool, n: ref Net) -> String {
    if any { "any".to_string() } else { net_str(n) }
}

fn split_hostport(s: Str) -> Result[(Addr, i64), IpError] {
    let mut host = String.new();
    let mut port = String.new();
    let mut found = false;
    if first_byte(s) == b'[' {
        let rest = slice_from(s, 1);
        let at = find_str(rest, "]:");
        if at >= 0 {
            host = slice(rest, 0, at);
            port = slice_from(rest, at + 2);
            found = true;
        }
    } else {
        let (h, sep, p) = rpartition(s, b':');
        host = h;
        port = p;
        found = sep;
    }
    if not found {
        return Err(ve(f"no port in {py_repr(s)}"));
    }
    let a = ip_address(host)?;
    Ok((a, py_int_or(port)?))
}

fn hostport(a: ref Addr, port: i64) -> String {
    if a.v == 6 { f"[{addr_str(a)}]:{port}" } else { f"{addr_str(a)}:{port}" }
}

fn pad_right(s: Str, n: i64) -> String {
    let mut out = s.to_string();
    while out.len() < n {
        out.push_str(" ");
    }
    out
}

fn show_firewall(plan: ref Plan) -> Result[(), String] {
    println("== firewall");
    let mut rules: Vec[Rule] = Vec.new();
    let mut k: i64 = 0;
    let acl = lines_of(read("data/acl.txt")?);
    for li in 0..acl.len() {
        let line = acl[li].clone();
        if first_byte(line) == b'#' {
            continue;
        }
        k += 1;
        let w = split_ws(line);
        let src = match endpoint(w[2], plan) {
            Ok(x) => x,
            Err(e) => {
                println(f"rule {k}: {show_err(e)}, skipped");
                continue;
            }
        };
        let dst = match endpoint(w[3], plan) {
            Ok(x) => x,
            Err(e) => {
                println(f"rule {k}: {show_err(e)}, skipped");
                continue;
            }
        };
        let (any_src, src_net) = src;
        let (any_dst, dst_net) = dst;
        let r = Rule { k: k, action: w[0].clone(), proto: w[1].clone(), any_src: any_src, src: src_net, any_dst: any_dst, dst: dst_net, ports: parse_ports(w[4]) };
        println(f"rule {k}: {r.action} {r.proto} {side_str(r.any_src, r.src)} -> {side_str(r.any_dst, r.dst)} ports {ports_str(r.ports)}");
        rules.push(r);
    }
    let mut hit_keys: Vec[String] = Vec.new();
    let mut hit_counts: Vec[i64] = Vec.new();
    let mut denied4: Vec[Item] = Vec.new();
    let mut denied6: Vec[Item] = Vec.new();
    let conns = lines_of(read("data/conns.txt")?);
    for li in 0..conns.len() {
        let line = conns[li].clone();
        let w = split_ws(line);
        let proto = w[0].clone();
        let (src, sport) = match split_hostport(w[1]) {
            Ok(x) => x,
            Err(e) => {
                println(f"  error   {line}: {show_err(e)}");
                continue;
            }
        };
        let (dst, dport) = match split_hostport(w[3]) {
            Ok(x) => x,
            Err(e) => {
                println(f"  error   {line}: {show_err(e)}");
                continue;
            }
        };
        let mut verdict = "deny".to_string();
        let mut which = "-".to_string();
        for ri in 0..rules.len() {
            let r = rules[ri].clone();
            if r.proto != "any" and r.proto != proto {
                continue;
            }
            if not r.any_src and not contains(r.src, src) {
                continue;
            }
            if not r.any_dst and not contains(r.dst, dst) {
                continue;
            }
            if r.ports.len() > 0 {
                let mut ok = false;
                let mut i: i64 = 0;
                while i < r.ports.len() {
                    if r.ports[i] <= dport and dport <= r.ports[i + 1] {
                        ok = true;
                    }
                    i += 2;
                }
                if not ok {
                    continue;
                }
            }
            verdict = r.action.clone();
            which = f"{r.k}";
            break;
        }
        let mut at: i64 = -1;
        for i in 0..hit_keys.len() {
            if hit_keys[i] == which {
                at = i;
            }
        }
        if at < 0 {
            hit_keys.push(which.clone());
            hit_counts.push(1);
        } else {
            hit_counts[at] += 1;
        }
        let scope = if addr_flag(src, "global") { "global" } else if addr_flag(src, "private") { "private" } else { "shared" };
        println(f"  {pad_right(verdict, 7)} rule {which} {proto} {hostport(src, sport)} -> {hostport(dst, dport)} ({scope})");
        if verdict == "deny" and addr_flag(src, "global") {
            if src.v == 4 {
                denied4.push(addr_item(src));
            } else {
                denied6.push(addr_item(src));
            }
        }
    }
    let mut order: Vec[i64] = Vec.new();
    for i in 0..hit_keys.len() {
        order.push(i);
    }
    for i in 1..order.len() {
        let mut j = i;
        while j > 0 and hit_keys[order[j]] < hit_keys[order[j - 1]] {
            order.swap(j - 1, j);
            j -= 1;
        }
    }
    let mut parts: Vec[String] = Vec.new();
    for i in 0..order.len() {
        parts.push(f"{hit_keys[order[i]]}={hit_counts[order[i]]}");
    }
    println(f"hits: {join(parts, " ")}");
    for v in [4, 6] {
        let items = if v == 4 { denied4.clone() } else { denied6.clone() };
        let list = match collapse(items) {
            Ok(x) => net_list(x),
            Err(e) => show_err(e),
        };
        let shown = if list.len() > 0 { list } else { "-".to_string() };
        println(f"blocklist v{v} (global sources): {shown}");
    }
    Ok(())
}

fn run() -> Result[(), String] {
    write_data()?;
    show_addresses()?;
    show_networks()?;
    show_ops()?;
    let plan = show_plan()?;
    show_firewall(plan)
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_ipaddress: {e}");
    }
}
