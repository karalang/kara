  'a': value='2' coded='2'
  'A': value='3' coded='3'
  | Set-Cookie: A=3
  | Set-Cookie: a=2
'x="unterminated; y=2'
  <SimpleCookie: >
'w=1;\ttab=2'
  <SimpleCookie: tab='2' w='1'>
  'w': value='1' coded='1'
  'tab': value='2' coded='2'
  | Set-Cookie: tab=2
  | Set-Cookie: w=1
