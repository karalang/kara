fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data")?;
    put("data/headers.txt", file_0())?;
    put("data/jar.txt", file_1())?;
    Ok(())
}

// ------------------------------------------------------------ the report

fn read(path: Str) -> Result[String, String] {
    match fs.read_to_string(path.to_string()) {
        Ok(t) => Ok(t),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

fn show_morsels(c: ref Cookie) {
    for i in 0..c.morsels.len() {
        let m = c.morsels[i].clone();
        let mut attrs: Vec[String] = Vec.new();
        for k in 0..RESERVED.len() {
            if not attr_is_empty(m.attrs[k]) {
                attrs.push(f"{RESERVED[k]}={attr_repr(m.attrs[k])}");
            }
        }
        println(rstrip(f"  {py_repr(m.key)}: value={py_repr(m.value)} coded={py_repr(m.coded)} {join(attrs, " ")}"));
    }
}

fn show_load() -> Result[(), String] {
    println("== load");
    let lines = lines_of(read("data/headers.txt")?);
    for i in 0..lines.len() {
        println(py_repr(lines[i]));
        let mut c = Cookie { morsels: Vec.new() };
        match load(mut c, lines[i]) {
            Ok(_) => {}
            Err(e) => println(f"  CookieError: {e}"),
        }
        println(f"  {c.repr()}");
        show_morsels(c);
        let out = c.output(Vec.new(), "Set-Cookie:")?;
        for k in 0..out.len() {
            println(f"  | {out[k]}");
        }
    }
    Ok(())
}

fn attempt(label: Str, r: own Result[(), String]) {
    match r {
        Ok(_) => println(f"{label}: ok"),
        Err(e) => println(f"{label}: CookieError: {e}"),
    }
}

fn show_build() -> Result[(), String] {
    println("== build");
    let mut c = Cookie { morsels: Vec.new() };
    c.set("sid", "abc123")?;
    c.set_attr("sid", "path", Attr.Text("/".to_string()))?;
    c.set_attr("sid", "max-age", Attr.Int(3600))?;
    c.set_attr("sid", "httponly", Attr.Flag(true))?;
    c.set_attr("sid", "secure", Attr.Flag(true))?;
    c.set_attr("sid", "samesite", Attr.Text("Strict".to_string()))?;
    c.set("pref", "dark mode; \"x\"")?;
    c.set_attr("pref", "expires", Attr.Text("Thu, 01 Jan 2027 00:00:00 GMT".to_string()))?;
    c.set_attr("pref", "comment", Attr.Text("user's choice".to_string()))?;
    c.set_attr("pref", "Domain", Attr.Text("example.com".to_string()))?;
    c.set("n", "42")?;
    c.set("latin", "café \\ back")?;
    c.set("empty", "")?;
    c.set("sym", "a:b|c~d")?;
    attempt("c['café'] = 'x'", c.set("café", "x"));
    attempt("c['path'] = 'x'", c.set("path", "x"));
    attempt("c['a b'] = 'x'", c.set("a b", "x"));
    attempt("c['sid']['bogus'] = 1", c.set_attr("sid", "bogus", Attr.Int(1)));
    attempt("c['ctl'] = 'a\\nb'", c.set("ctl", "a\nb"));
    attempt("c['sid']['domain'] = 'ex\\x01.com'", c.set_attr("sid", "domain", Attr.Text("ex\u{01}.com".to_string())));
    attempt("c['sid']['VERSION'] = '1'", c.set_attr("sid", "VERSION", Attr.Text("1".to_string())));
    println(c.repr());
    show_morsels(c);
    let all = c.output(Vec.new(), "Set-Cookie:")?;
    for k in 0..all.len() {
        println(f"| {all[k]}");
    }
    let mut only: Vec[String] = Vec.new();
    only.push("path".to_string());
    only.push("httponly".to_string());
    let some = c.output(only, "Cookie:")?;
    for k in 0..some.len() {
        println(f"| {some[k]}");
    }
    let pref = c.morsels[c.find("pref")].clone();
    println(f"<Morsel: {pref.output_string(Vec.new())}>");
    let sid = c.morsels[c.find("sid")].clone();
    println(f"{sid.js_output()?}|");
    Ok(())
}

fn show_jar() -> Result[(), String] {
    println("== jar");
    let mut jar = Jar { cookies: Vec.new(), now: 0, serial: 0 };
    let mut url = String.new();
    let lines = lines_of(read("data/jar.txt")?);
    for i in 0..lines.len() {
        let (word, _, rest) = partition(lines[i], b' ');
        if word == "at" {
            jar.now = digits_value(rest);
            println(f"-- at {jar.now}");
        } else if word == "resp" {
            url = rest.clone();
            println(f"-- response from {url}");
        } else if word == "Set-Cookie:" {
            jar.store(url, rest);
        } else if word == "req" {
            let h = jar.header_for(rest);
            println(f"-- request to {rest}");
            if h.len() > 0 {
                println(f"  Cookie: {h}");
            } else {
                println("  (no cookies)");
            }
        } else if word == "dump" {
            println("-- jar");
            jar.dump();
        }
    }
    Ok(())
}

fn run() -> Result[(), String] {
    write_data()?;
    show_load()?;
    show_build()?;
    show_jar()
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_cookies: {e}");
    }
}
