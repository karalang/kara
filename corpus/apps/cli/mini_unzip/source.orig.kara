fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

// The bytes a block of hex digits spells; line breaks are skipped.
fn unhex(s: String) -> Vec[u8] {
    let b = to_bytes(s);
    let mut digits: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        if is_hex(b[i]) {
            digits.push(hex_val(b[i]));
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < digits.len() {
        out.push(digits[i] * 16 + digits[i + 1]);
        i += 2;
    }
    out
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data")?;
    put_bytes("data/badcrc.zip", unhex(file_0()))?;
    put_bytes("data/evil.zip", unhex(file_1()))?;
    put_bytes("data/infozip.zip", unhex(file_2()))?;
    put("data/jobs.txt", file_3())?;
    put("data/notes.txt", file_4())?;
    put_bytes("data/plain.zip", unhex(file_5()))?;
    put_bytes("data/secret.zip", unhex(file_6()))?;
    put_bytes("data/sfx.zip", unhex(file_7()))?;
    put_bytes("data/stream.zip", unhex(file_8()))?;
    put_bytes("data/trunc.zip", unhex(file_9()))?;
    put_bytes("data/zip64.zip", unhex(file_10()))?;
    Ok(())
}

// ------------------------------------------------------------ the jobs

// A fresh start for the extraction jobs, as after unpacking data/.
fn clear_outputs(jobs: ref Vec[String]) {
    for line in jobs {
        let w = split_on(line, b' ');
        for i in 0..w.len() {
            if w[i] == "-d" and i + 1 < w.len() {
                let (top, _, _) = partition(w[i + 1], b'/');
                let path = f"data/{top}";
                if is_dir_path(path) {
                    let _ = fs.remove_dir_all(path);
                }
            }
        }
    }
}

fn run() -> Result[(), String] {
    write_data()?;
    let text = match fs.read_to_string("data/jobs.txt".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/jobs.txt: {e}"),
    };
    let jobs = lines_of(text);
    clear_outputs(jobs);
    let t = crc_table();
    for line in jobs {
        if line.len() == 0 or starts_with(line, "#") {
            continue;
        }
        let mut job = Job { out: String.new(), err: String.new(), status: 0 };
        let w = split_on(line, b' ');
        let rest: Vec[String] = w[1..].to_vec();
        if w[0] == "zipinfo" {
            zipinfo(mut job, rest);
        } else if w[0] == "unzip" {
            unzip(t, mut job, rest);
        } else if w[0] == "tree" {
            tree(t, mut job, rest[0]);
        }
        let mut out = f"$ {line}\n";
        out.push_str(job.out);
        out.push_str(job.err);
        if job.status != 0 {
            out.push_str(f"[exit status {job.status}]\n");
        }
        println(out);
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"error: {e}");
    }
}
