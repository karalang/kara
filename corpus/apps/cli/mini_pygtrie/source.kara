// mini_pygtrie — a port of the pure-Python trie of pygtrie 2.6.2 (Apache-2.0,
// Google LLC). pygtrie.CharTrie is a string-keyed trie (prefix tree): the data
// structure behind routing tables, autocompletion and longest-prefix matching.
//
// This ports the CharTrie core statement for statement, with sorted-sibling
// iteration enabled (Trie.enable_sorting(True)) so the key order is total and
// deterministic. A node holds a value flag plus parallel step/child vectors
// kept in ascending step order, so the pre-order DFS is sorted. set / get /
// has_key / has_subtrie / has_node, delete with empty-node pruning and the
// ShortKeyError on a prefix-only key, and shortest_prefix / longest_prefix /
// prefixes / keys(prefix) follow the library's logic branch for branch. The
// port is functional — every set/delete rebuilds the nodes on the path, which
// is observationally identical to pygtrie's in-place mutation.
//
// Each job drives one evolving CharTrie and prints a line:
//   s <key> <val> -> len <n>          set (new length)
//   g <key>       -> <val> | miss     get
//   hk <key>      -> yes | no         has_key
//   hs <key>      -> yes | no         has_subtrie
//   hn <key>      -> 0..3             has_node bit-field (VALUE=1, SUBTRIE=2)
//   d <key>       -> len <n> | short | miss   delete (+ prune); short = ShortKeyError
//   sp <key>      -> <key> <val> | none   shortest_prefix
//   lp <key>      -> <key> <val> | none   longest_prefix
//   pf <key>      -> [(k v), ...]     prefixes along the path
//   ks <prefix>   -> [k, ...] | nokey keys(prefix), sorted
//   ka            -> [k, ...]         all keys, sorted
//   l             -> len <n>
//
// Keys are lowercase ASCII (and the empty string); values are small ints.
// Scope: the CharTrie core. StringTrie separators, the tuple-key Trie, PrefixSet,
// subtrie slice-delete, merge/update and pickling are out of scope (see README).
// jobs_text() carries data/jobs.tsv verbatim.

#[derive(Clone)]
struct TNode {
    has_val: bool,
    val: i64,
    steps: Vec[i64], // child step bytes, ascending
    kids: Vec[TNode],
}

struct Found {
    exists: bool,
    has_val: bool,
    val: i64,
    has_kids: bool,
}

struct DRes {
    node: TNode,
    status: i64, // 0 = ok / found, 1 = short (ShortKeyError), 2 = miss / absent
}

struct Pfx {
    keys: Vec[String],
    vals: Vec[i64],
}

fn empty_node() -> TNode {
    let s: Vec[i64] = Vec.new();
    let k: Vec[TNode] = Vec.new();
    TNode { has_val: false, val: 0, steps: s, kids: k }
}

fn chr1(b: i64) -> String {
    let mut u: Vec[u8] = Vec.new();
    u.push(b as u8);
    String.from_utf8(u).unwrap_or("".to_string())
}

fn bytes_to_str(bytes: ref Vec[i64], upto: i64) -> String {
    let mut u: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < upto {
        u.push(bytes[i] as u8);
        i = i + 1;
    }
    String.from_utf8(u).unwrap_or("".to_string())
}

fn child_index(node: ref TNode, step: i64) -> i64 {
    let mut i = 0;
    while i < node.steps.len() {
        if node.steps[i] == step {
            return i;
        }
        i = i + 1;
    }
    -1
}

fn build_chain(path: ref Vec[i64], i: i64, val: i64) -> TNode {
    let mut nd = empty_node();
    if i == path.len() {
        nd.has_val = true;
        nd.val = val;
        return nd;
    }
    let child = build_chain(path, i + 1, val);
    nd.steps.push(path[i]);
    nd.kids.push(child);
    nd
}

fn tset(node: ref TNode, path: ref Vec[i64], i: i64, val: i64) -> TNode {
    let mut out = node.clone();
    if i == path.len() {
        out.has_val = true;
        out.val = val;
        return out;
    }
    let step = path[i];
    let idx = child_index(node, step);
    if idx >= 0 {
        let nc = tset(node.kids[idx], path, i + 1, val);
        out.kids[idx] = nc;
        return out;
    }
    // Insert a fresh child chain, keeping steps in ascending order.
    let nc = build_chain(path, i + 1, val);
    let mut nsteps: Vec[i64] = Vec.new();
    let mut nkids: Vec[TNode] = Vec.new();
    let mut j = 0;
    let mut placed = false;
    while j < out.steps.len() {
        if not placed and out.steps[j] > step {
            nsteps.push(step);
            nkids.push(nc.clone());
            placed = true;
        }
        nsteps.push(out.steps[j]);
        nkids.push(out.kids[j].clone());
        j = j + 1;
    }
    if not placed {
        nsteps.push(step);
        nkids.push(nc.clone());
    }
    out.steps = nsteps;
    out.kids = nkids;
    out
}

fn find(node: ref TNode, path: ref Vec[i64], i: i64) -> Found {
    if i == path.len() {
        Found { exists: true, has_val: node.has_val, val: node.val, has_kids: node.kids.len() > 0 }
    } else {
        let idx = child_index(node, path[i]);
        if idx < 0 {
            Found { exists: false, has_val: false, val: 0, has_kids: false }
        } else {
            find(node.kids[idx], path, i + 1)
        }
    }
}

fn tcount(node: ref TNode) -> i64 {
    let mut n = 0;
    if node.has_val {
        n = 1;
    }
    let mut i = 0;
    while i < node.kids.len() {
        n = n + tcount(node.kids[i]);
        i = i + 1;
    }
    n
}

fn tdel(node: ref TNode, path: ref Vec[i64], i: i64) -> DRes {
    if i == path.len() {
        if not node.has_val {
            return DRes { node: node.clone(), status: 1 };
        }
        let mut out = node.clone();
        out.has_val = false;
        out.val = 0;
        return DRes { node: out, status: 0 };
    }
    let step = path[i];
    let idx = child_index(node, step);
    if idx < 0 {
        return DRes { node: node.clone(), status: 2 };
    }
    let r = tdel(node.kids[idx], path, i + 1);
    if r.status != 0 {
        return DRes { node: node.clone(), status: r.status };
    }
    let mut out = node.clone();
    let child = r.node;
    if not child.has_val and child.kids.len() == 0 {
        // Child became empty: drop it from the parent (prune).
        let mut nsteps: Vec[i64] = Vec.new();
        let mut nkids: Vec[TNode] = Vec.new();
        let mut j = 0;
        while j < out.steps.len() {
            if j != idx {
                nsteps.push(out.steps[j]);
                nkids.push(out.kids[j].clone());
            }
            j = j + 1;
        }
        out.steps = nsteps;
        out.kids = nkids;
    } else {
        out.kids[idx] = child;
    }
    DRes { node: out, status: 0 }
}

fn walk_prefixes(root: ref TNode, path: ref Vec[i64]) -> Pfx {
    let mut keys: Vec[String] = Vec.new();
    let mut vals: Vec[i64] = Vec.new();
    let mut node = root.clone();
    let mut pos = 0;
    let mut go = true;
    while go {
        if node.has_val {
            keys.push(bytes_to_str(path, pos));
            vals.push(node.val);
        }
        if pos == path.len() {
            go = false;
        } else {
            let idx = child_index(node, path[pos]);
            if idx < 0 {
                go = false;
            } else {
                node = node.kids[idx].clone();
                pos = pos + 1;
            }
        }
    }
    Pfx { keys: keys, vals: vals }
}

fn descend(root: ref TNode, path: ref Vec[i64]) -> DRes {
    let mut node = root.clone();
    let mut pos = 0;
    let mut ok = true;
    while pos < path.len() and ok {
        let idx = child_index(node, path[pos]);
        if idx < 0 {
            ok = false;
        } else {
            node = node.kids[idx].clone();
            pos = pos + 1;
        }
    }
    if ok {
        DRes { node: node, status: 0 }
    } else {
        DRes { node: empty_node(), status: 2 }
    }
}

// Pre-order DFS (sorted siblings) collecting keys with a value under `node`,
// each prefixed by `prefix` (the path from the root to `node`).
fn collect(node: ref TNode, prefix: String) -> Vec[String] {
    let mut acc: Vec[String] = Vec.new();
    if node.has_val {
        acc.push(prefix.clone());
    }
    let mut j = 0;
    while j < node.steps.len() {
        let mut p2 = prefix.clone();
        p2.push_str(chr1(node.steps[j]));
        let sub = collect(node.kids[j], p2);
        let mut m = 0;
        while m < sub.len() {
            acc.push(sub[m].clone());
            m = m + 1;
        }
        j = j + 1;
    }
    acc
}

fn str_bytes(s: Str) -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    for b in s.bytes() {
        v.push(b as i64);
    }
    v
}

fn split_fields(line: Str, sepb: i64) -> Vec[String] {
    let v = str_bytes(line);
    let n = v.len();
    let mut fields: Vec[String] = Vec.new();
    let mut start = 0;
    let mut i = 0;
    while i <= n {
        if i == n or v[i] == sepb {
            fields.push(line.substring(start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    fields
}

fn parse_uint(s: Str) -> i64 {
    let b = str_bytes(s);
    let mut acc = 0;
    let mut i = 0;
    while i < b.len() {
        acc = acc * 10 + (b[i] - 48);
        i = i + 1;
    }
    acc
}

fn itoa(n: i64) -> String {
    if n == 0 {
        return "0".to_string();
    }
    let tbl = "0123456789".to_string();
    let mut x = n;
    let mut digits: Vec[i64] = Vec.new();
    while x > 0 {
        digits.push(x % 10);
        x = x / 10;
    }
    let mut o = String.new();
    let mut i = digits.len();
    while i > 0 {
        i = i - 1;
        let d = digits[i];
        o.push_str(tbl.substring(d, d + 1));
    }
    o
}

fn join_pfx(p: ref Pfx) -> String {
    let mut o = String.new();
    o.push_str("[");
    let mut i = 0;
    while i < p.keys.len() {
        if i > 0 {
            o.push_str(", ");
        }
        o.push_str("(");
        o.push_str(p.keys[i].clone());
        o.push_str(" ");
        o.push_str(itoa(p.vals[i]));
        o.push_str(")");
        i = i + 1;
    }
    o.push_str("]");
    o
}

fn join_keys(ks: ref Vec[String]) -> String {
    let mut o = String.new();
    o.push_str("[");
    let mut i = 0;
    while i < ks.len() {
        if i > 0 {
            o.push_str(", ");
        }
        o.push_str(ks[i].clone());
        i = i + 1;
    }
    o.push_str("]");
    o
}

fn main_run() -> String {
    let data = jobs_text();
    let db = str_bytes(data.clone());
    let n = db.len();
    let mut out = String.new();

    let mut root = empty_node();

    let mut i = 0;
    let mut ls = 0;
    while i <= n {
        if i == n or db[i] == 10 {
            if i > ls {
                let line = data.substring(ls, i);
                let f = split_fields(line, 9);
                let op = f[0].clone();
                if op == "s" {
                    let path = str_bytes(f[1].clone());
                    let v = parse_uint(f[2].clone());
                    root = tset(root, path, 0, v);
                    out.push_str("len ");
                    out.push_str(itoa(tcount(root)));
                } else if op == "g" {
                    let path = str_bytes(f[1].clone());
                    let r = find(root, path, 0);
                    if r.exists and r.has_val {
                        out.push_str(itoa(r.val));
                    } else {
                        out.push_str("miss");
                    }
                } else if op == "hk" {
                    let path = str_bytes(f[1].clone());
                    let r = find(root, path, 0);
                    if r.exists and r.has_val {
                        out.push_str("yes");
                    } else {
                        out.push_str("no");
                    }
                } else if op == "hs" {
                    let path = str_bytes(f[1].clone());
                    let r = find(root, path, 0);
                    if r.exists and r.has_kids {
                        out.push_str("yes");
                    } else {
                        out.push_str("no");
                    }
                } else if op == "hn" {
                    let path = str_bytes(f[1].clone());
                    let r = find(root, path, 0);
                    let mut bf = 0;
                    if r.exists {
                        if r.has_val {
                            bf = bf | 1;
                        }
                        if r.has_kids {
                            bf = bf | 2;
                        }
                    }
                    out.push_str(itoa(bf));
                } else if op == "d" {
                    let path = str_bytes(f[1].clone());
                    let r = tdel(root, path, 0);
                    if r.status == 1 {
                        out.push_str("short");
                    } else if r.status == 2 {
                        out.push_str("miss");
                    } else {
                        root = r.node;
                        out.push_str("len ");
                        out.push_str(itoa(tcount(root)));
                    }
                } else if op == "sp" {
                    let path = str_bytes(f[1].clone());
                    let p = walk_prefixes(root, path);
                    if p.keys.len() == 0 {
                        out.push_str("none");
                    } else {
                        out.push_str(p.keys[0].clone());
                        out.push_str(" ");
                        out.push_str(itoa(p.vals[0]));
                    }
                } else if op == "lp" {
                    let path = str_bytes(f[1].clone());
                    let p = walk_prefixes(root, path);
                    let m = p.keys.len();
                    if m == 0 {
                        out.push_str("none");
                    } else {
                        out.push_str(p.keys[m - 1].clone());
                        out.push_str(" ");
                        out.push_str(itoa(p.vals[m - 1]));
                    }
                } else if op == "pf" {
                    let path = str_bytes(f[1].clone());
                    let p = walk_prefixes(root, path);
                    out.push_str(join_pfx(p));
                } else if op == "ks" {
                    let key = f[1].clone();
                    let path = str_bytes(key.clone());
                    let d = descend(root, path);
                    if d.status != 0 {
                        out.push_str("nokey");
                    } else {
                        let ks = collect(d.node, key);
                        out.push_str(join_keys(ks));
                    }
                } else if op == "ka" {
                    let ks = collect(root, "".to_string());
                    out.push_str(join_keys(ks));
                } else if op == "l" {
                    out.push_str("len ");
                    out.push_str(itoa(tcount(root)));
                }
                out.push_str("\n");
            }
            ls = i + 1;
        }
        i = i + 1;
    }
    out
}

fn main() {
    print(main_run());
}

