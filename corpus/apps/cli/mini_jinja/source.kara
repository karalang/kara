fn ends_with(s: Str, tail: Str) -> bool {
    let b = s.bytes();
    let t = tail.bytes();
    if t.len() > b.len() {
        return false;
    }
    for i in 0..t.len() {
        if b[b.len() - t.len() + i] != t[i] {
            return false;
        }
    }
    true
}

fn parent_dir(path: Str) -> String {
    let b = path.bytes();
    let mut i = b.len() - 1;
    while i >= 0 and b[i] != b'/' {
        i -= 1;
    }
    if i < 0 {
        return ".".to_string();
    }
    byte_str(b, 0, i)
}

// Writes a rendered page and prints it, as render.py does.
fn emit(path: Str, res: own Result[String, String]) {
    let text = match res {
        Ok(t) => t,
        Err(e) => {
            println(f"== {path}: error: {e}");
            return;
        }
    };
    if let Err(e) = fs.create_dir_all(parent_dir(path)) {
        println(f"cannot create the directory of {path}: {e}");
        return;
    }
    if let Err(e) = fs.write(path.to_string(), text.clone()) {
        println(f"cannot write {path}: {e}");
        return;
    }
    println(f"== {path} ({text.len()} bytes)");
    print(text);
}

fn copy_dict(d: ref JDict) -> JDict {
    let out = new_dict(false);
    for i in 0..d.keys.len() {
        dict_set(out, d.keys[i], d.vals[i].clone());
    }
    out
}

fn main() {
    let names: Array[Str, 6] = ["base.html", "footer.html", "macros.html", "index.html", "post.html", "digest.txt"];
    let texts: Array[String, 6] = [base_html(), footer_html(), macros_html(), index_html(), post_html(), digest_txt()];
    for dir in ["templates", "data"] {
        if let Err(e) = fs.create_dir_all(dir.to_string()) {
            println(f"cannot create {dir}: {e}");
            return;
        }
    }
    for i in 0..6 {
        fs.write(f"templates/{names[i]}", texts[i].clone()).unwrap();
    }
    fs.write("data/site.json".to_string(), site_json()).unwrap();

    // the loader: every template, parsed once; .html autoescapes
    let mut ast = new_ast();
    for i in 0..6 {
        let src = match fs.read_to_string(f"templates/{names[i]}") {
            Ok(s) => s,
            Err(e) => {
                println(f"cannot read {names[i]}: {e}");
                return;
            }
        };
        if let Err(e) = parse_template(mut ast, names[i], src, ends_with(names[i], ".html")) {
            println(f"{names[i]}: {e}");
            return;
        }
    }
    let json = match fs.read_to_string("data/site.json".to_string()) {
        Ok(s) => s,
        Err(e) => {
            println(f"cannot read data/site.json: {e}");
            return;
        }
    };
    let data = match parse_json(json) {
        Ok(Val.Dict(d)) => d,
        Ok(_) => {
            println("data/site.json: not an object");
            return;
        }
        Err(e) => {
            println(e);
            return;
        }
    };
    let posts = match dict_get(data, "posts") {
        Some(Val.List(l)) => l.items.clone(),
        _ => Vec.new(),
    };
    let mut published: Vec[Val] = Vec.new();
    for i in 0..posts.len() {
        let draft = get_attr(posts[i], "draft").unwrap_or(Val.None);
        if not truthy(draft) {
            published.push(posts[i].clone());
        }
    }

    emit("out/index.html", render_root(ast, ast.find_tpl("index.html"), data));
    for i in 0..published.len() {
        let ctx = copy_dict(data);
        dict_set(ctx, "post", published[i].clone());
        dict_set(ctx, "posts", new_list(published.clone()));
        dict_set(ctx, "index", Val.Int(i));
        let slug = to_str(get_attr(published[i], "slug").unwrap_or(Val.None));
        emit(f"out/{slug}/index.html", render_root(ast, ast.find_tpl("post.html"), ctx));
    }
    emit("out/digest.txt", render_root(ast, ast.find_tpl("digest.txt"), data));

    // one-line templates, autoescaped as strings are
    println("== errors");
    let cases: Array[Str, 10] = [
        "{% for x in xs %}{{ x }}",
        "{{ x|nosuch }}",
        "{{ missing.attr }}",
        "a\n{% endif %}",
        "{{ 1 / zero }}",
        "{% if x %}\n{% for y in x %}\n{% endif %}",
        "{{ x + }}",
        "{% macro m(a) %}{{ a }}{% endmacro %}{{ m(1, 2) }}",
        "<{{ x.y.z }}>",
        "{{ '<b>' ~ x.y }} {{ '<b>'|safe ~ x.y }}",
    ];
    let ctx = new_dict(false);
    dict_set(ctx, "xs", new_list(vec![Val.Int(1)]));
    let x = new_dict(false);
    dict_set(x, "y", Val.Int(1));
    dict_set(ctx, "x", Val.Dict(x));
    dict_set(ctx, "zero", Val.Int(0));
    for i in 0..10 {
        match parse_template(mut ast, "<template>", cases[i], true) {
            Err(e) => println(f"error: {e}"),
            Ok(t) => match render_root(ast, t, ctx) {
                Ok(s) => println(f"ok: {s}"),
                Err(e) => println(f"error: {e}"),
            },
        }
    }
}
