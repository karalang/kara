fn data_part_1(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("{\n");
    t.push_str("\t\"apiVersion\": \"apps/v1\",\n");
    t.push_str("\t\"kind\": \"Deployment\",\n");
    t.push_str("\t\"metadata\": {\n");
    t.push_str("\t\t\"name\": \"cafe-api\",\n");
