    t.push_str("\t\t\"labels\": {\"app\": \"cafe-api\", \"tier\": \"backend\"},\n");
    t.push_str("\t\t\"annotations\": {\"deployment.kubernetes.io/revision\": \"12\"}\n");
    t.push_str("\t},\n");
    t.push_str("\t\"spec\": {\n");
