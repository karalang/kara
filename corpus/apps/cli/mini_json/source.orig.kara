// mini_json: Python 3.13's json module (loads and dumps) over real
// documents. It reads the job list from data/jobs.tsv and, for each job,
// loads a file and prints the value's repr, dumps it back out with the
// given options, decodes a JSON Lines log line by line, or checks that a
// dump loads back to the same text. Malformed files print the error that
// json.loads raises, with its line, column and character position.
//
// Text is handled as code points, as Python's str is: positions in error
// messages count characters, not bytes, and a string may hold a lone
// surrogate from a \uXXXX escape. Integers keep their digits, so a value
// past 64 bits loads and dumps unchanged, up to Python's 4300-digit limit.
// Objects keep their keys in order; a repeated key keeps its first place
// and takes its last value, as dict() does.

enum J {
    Null,
    Bool(bool),
    Int(String),
    Float(f64),
    Str(Vec[i64]),
    Arr(Vec[J]),
    Obj(Vec[Member]),
}

struct Member {
    key: Vec[i64],
    val: J,
}

struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: own String) -> Exc {
    Exc { kind: kind.to_string(), msg: msg }
}

// ------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn push_utf8(out: mut ref Vec[u8], cp: i64) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push((0xC0 | (cp >> 6)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else if cp < 0x10000 {
        out.push((0xE0 | (cp >> 12)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else {
        out.push((0xF0 | (cp >> 18)) as u8);
        out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    }
}

fn is_surrogate(cp: i64) -> bool {
    cp >= 0xD800 and cp <= 0xDFFF
}

fn hex4(cp: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = 12;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// str.encode("utf-8"): a lone surrogate cannot be encoded, and the error
// names the first run of them by position.
fn to_utf8(s: ref Vec[i64]) -> Result[String, Exc] {
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < s.len() {
        let c = s[i];
        if is_surrogate(c) {
            let mut j = i;
            while j < s.len() and is_surrogate(s[j]) {
                j += 1;
            }
            let reason = "surrogates not allowed";
            if j - i == 1 {
                return Err(exc("UnicodeEncodeError", f"'utf-8' codec can't encode character '\\u{hex4(c)}' in position {i}: {reason}"));
            }
            return Err(exc("UnicodeEncodeError", f"'utf-8' codec can't encode characters in position {i}-{j - 1}: {reason}"));
        }
        push_utf8(mut out, c);
        i += 1;
    }
    Ok(String.from_utf8(out).unwrap())
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn ascii_string(s: ref Vec[i64], start: i64, end: i64) -> String {
    let mut out: Vec[u8] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i] as u8);
        i += 1;
    }
    String.from_utf8(out).unwrap()
}

fn cmp_cps(a: ref Vec[i64], b: ref Vec[i64]) -> i64 {
    let mut i = 0;
    while i < a.len() and i < b.len() {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 };
        }
        i += 1;
    }
    a.len() - b.len()
}

// ---------------------------------------------------------- decoding

// The C scanner in Modules/_json.c, over code points.
struct Scanner {
    s: Vec[i64],
}

fn is_digit(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn hex_value(c: i64) -> i64 {
    if c >= 48 and c <= 57 {
        c - 48
    } else if c >= 97 and c <= 102 {
        c - 87
    } else if c >= 65 and c <= 70 {
        c - 55
    } else {
        -1
    }
}

impl Scanner {
    fn at(ref self, i: i64) -> i64 {
        if i >= 0 and i < self.s.len() { self.s[i] } else { -1 }
    }

    // JSONDecodeError's message: the line and column are counted from the
    // newlines before the position.
    fn fail(ref self, msg: Str, pos: i64) -> Exc {
        let mut line = 1;
        let mut last = -1;
        let mut i = 0;
        while i < pos {
            if self.s[i] == 10 {
                line += 1;
                last = i;
            }
            i += 1;
        }
        exc("JSONDecodeError", f"{msg}: line {line} column {pos - last} (char {pos})")
    }

    fn skip_ws(ref self, start: i64) -> i64 {
        let mut i = start;
        while i < self.s.len() {
            let c = self.s[i];
            if c != 32 and c != 9 and c != 10 and c != 13 {
                break;
            }
            i += 1;
        }
        i
    }

    fn matches(ref self, i: i64, word: Str) -> bool {
        let w = word.bytes();
        if i + w.len() > self.s.len() {
            return false;
        }
        let mut k = 0;
        while k < w.len() {
            if self.s[i + k] != w[k] as i64 {
                return false;
            }
            k += 1;
        }
        true
    }

    fn scan_once(ref self, idx: i64) -> Result[(J, i64), Exc] {
        let c = self.at(idx);
        if c == 34 {
            let (text, end) = self.scan_string(idx + 1)?;
            return Ok((J.Str(text), end));
        }
        if c == 123 {
            return self.parse_object(idx + 1);
        }
        if c == 91 {
            return self.parse_array(idx + 1);
        }
        if c == 110 and self.matches(idx, "null") {
            return Ok((J.Null, idx + 4));
        }
        if c == 116 and self.matches(idx, "true") {
            return Ok((J.Bool(true), idx + 4));
        }
        if c == 102 and self.matches(idx, "false") {
            return Ok((J.Bool(false), idx + 5));
        }
        if c == 78 and self.matches(idx, "NaN") {
            return Ok((J.Float(0.0 / 0.0), idx + 3));
        }
        if c == 73 and self.matches(idx, "Infinity") {
            return Ok((J.Float(1.0 / 0.0), idx + 8));
        }
        if c == 45 and self.matches(idx, "-Infinity") {
            return Ok((J.Float(-1.0 / 0.0), idx + 9));
        }
        self.match_number(idx)
    }

    // -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][-+]?[0-9]+)?, then int() or float()
    // of the text. Anything else at a value's place is "Expecting value".
    fn match_number(ref self, start: i64) -> Result[(J, i64), Exc] {
        let end_idx = self.s.len() - 1;
        let mut idx = start;
        if self.at(idx) == 45 {
            idx += 1;
            if idx > end_idx {
                return Err(self.fail("Expecting value", start));
            }
        }
        let c = self.at(idx);
        if c >= 49 and c <= 57 {
            idx += 1;
            while idx <= end_idx and is_digit(self.s[idx]) {
                idx += 1;
            }
        } else if c == 48 {
            idx += 1;
        } else {
            return Err(self.fail("Expecting value", start));
        }
        let mut is_float = false;
        if idx < end_idx and self.s[idx] == 46 and is_digit(self.s[idx + 1]) {
            is_float = true;
            idx += 2;
            while idx <= end_idx and is_digit(self.s[idx]) {
                idx += 1;
            }
        }
        if idx < end_idx and (self.s[idx] == 101 or self.s[idx] == 69) {
            let e_start = idx;
            idx += 1;
            if idx < end_idx and (self.s[idx] == 45 or self.s[idx] == 43) {
                idx += 1;
            }
            while idx <= end_idx and is_digit(self.s[idx]) {
                idx += 1;
            }
            if is_digit(self.s[idx - 1]) {
                is_float = true;
            } else {
                idx = e_start;
            }
        }
        let text = ascii_string(self.s, start, idx);
        if is_float {
            return match f64.parse(text) {
                Ok(x) => Ok((J.Float(x), idx)),
                Err(_) => Err(exc("ValueError", f"could not convert string to float: '{text}'")),
            };
        }
        let digits = if self.s[start] == 45 { idx - start - 1 } else { idx - start };
        if digits > 4300 {
            return Err(exc("ValueError", f"Exceeds the limit (4300 digits) for integer string conversion: value has {digits} digits; use sys.set_int_max_str_digits() to increase the limit"));
        }
        if text == "-0" {
            return Ok((J.Int("0".to_string()), idx));
        }
        Ok((J.Int(text), idx))
    }

    fn hex_escape(ref self, at: i64) -> Option[i64] {
        let mut v = 0;
        let mut k = 0;
        while k < 4 {
            let d = hex_value(self.at(at + k));
            if d < 0 {
                return None;
            }
            v = v * 16 + d;
            k += 1;
        }
        Some(v)
    }

    // scanstring: `start` is just past the opening quote.
    fn scan_string(ref self, start: i64) -> Result[(Vec[i64], i64), Exc] {
        let len = self.s.len();
        let begin = start - 1;
        let mut out: Vec[i64] = Vec.new();
        let mut end = start;
        loop {
            let mut next = end;
            let mut c = 0;
            while next < len {
                c = self.s[next];
                if c == 34 or c == 92 {
                    break;
                }
                if c <= 0x1F {
                    return Err(self.fail("Invalid control character at", next));
                }
                out.push(c);
                next += 1;
            }
            if next == len {
                return Err(self.fail("Unterminated string starting at", begin));
            }
            next += 1;
            if c == 34 {
                return Ok((out, next));
            }
            if next == len {
                return Err(self.fail("Unterminated string starting at", begin));
            }
            let e = self.s[next];
            if e != 117 {
                end = next + 1;
                let ch = match e {
                    34 => 34,
                    92 => 92,
                    47 => 47,
                    98 => 8,
                    102 => 12,
                    110 => 10,
                    114 => 13,
                    116 => 9,
                    _ => 0,
                };
                if ch == 0 {
                    return Err(self.fail("Invalid \\escape", end - 2));
                }
                out.push(ch);
            } else {
                next += 1;
                end = next + 4;
                if end >= len {
                    return Err(self.fail("Invalid \\uXXXX escape", next - 1));
                }
                let mut cp = match self.hex_escape(next) {
                    Some(v) => v,
                    None => return Err(self.fail("Invalid \\uXXXX escape", end - 5)),
                };
                // A high surrogate followed by an escaped low one is a pair;
                // followed by anything else it stays on its own.
                if cp >= 0xD800 and cp <= 0xDBFF and end + 6 < len and self.s[end] == 92 and self.s[end + 1] == 117 {
                    let low = match self.hex_escape(end + 2) {
                        Some(v) => v,
                        None => return Err(self.fail("Invalid \\uXXXX escape", end + 1)),
                    };
                    if low >= 0xDC00 and low <= 0xDFFF {
                        cp = 0x10000 + (((cp - 0xD800) << 10) | (low - 0xDC00));
                        end += 6;
                    }
                }
                out.push(cp);
            }
        }
    }

    fn parse_object(ref self, start: i64) -> Result[(J, i64), Exc] {
        let mut members: Vec[Member] = Vec.new();
        let mut idx = self.skip_ws(start);
        if self.at(idx) != 125 {
            loop {
                if self.at(idx) != 34 {
                    return Err(self.fail("Expecting property name enclosed in double quotes", idx));
                }
                let (key, after_key) = self.scan_string(idx + 1)?;
                idx = self.skip_ws(after_key);
                if self.at(idx) != 58 {
                    return Err(self.fail("Expecting ':' delimiter", idx));
                }
                idx = self.skip_ws(idx + 1);
                let (val, after_val) = self.scan_once(idx)?;
                put_member(mut members, key, val);
                idx = self.skip_ws(after_val);
                if self.at(idx) == 125 {
                    break;
                }
                if self.at(idx) != 44 {
                    return Err(self.fail("Expecting ',' delimiter", idx));
                }
                let comma = idx;
                idx = self.skip_ws(idx + 1);
                if self.at(idx) == 125 {
                    return Err(self.fail("Illegal trailing comma before end of object", comma));
                }
            }
        }
        Ok((J.Obj(members), idx + 1))
    }

    fn parse_array(ref self, start: i64) -> Result[(J, i64), Exc] {
        let mut items: Vec[J] = Vec.new();
        let mut idx = self.skip_ws(start);
        if self.at(idx) != 93 {
            loop {
                let (val, after) = self.scan_once(idx)?;
                items.push(val);
                idx = self.skip_ws(after);
                if self.at(idx) == 93 {
                    break;
                }
                if self.at(idx) != 44 {
                    return Err(self.fail("Expecting ',' delimiter", idx));
                }
                let comma = idx;
                idx = self.skip_ws(idx + 1);
                if self.at(idx) == 93 {
                    return Err(self.fail("Illegal trailing comma before end of array", comma));
                }
            }
        }
        Ok((J.Arr(items), idx + 1))
    }
}

// dict(pairs): a key seen again keeps its place and takes the new value.
fn put_member(members: mut ref Vec[Member], key: own Vec[i64], val: own J) {
    let mut j = 0;
    while j < members.len() {
        if cmp_cps(members[j].key, key) == 0 {
            members[j].val = val;
            return;
        }
        j += 1;
    }
    members.push(Member { key: key, val: val });
}

// json.loads on a str.
fn loads(text: ref Vec[i64]) -> Result[J, Exc] {
    let sc = Scanner { s: text.clone() };
    if sc.at(0) == 0xFEFF {
        return Err(sc.fail("Unexpected UTF-8 BOM (decode using utf-8-sig)", 0));
    }
    let start = sc.skip_ws(0);
    let (value, end) = sc.scan_once(start)?;
    let stop = sc.skip_ws(end);
    if stop != sc.s.len() {
        return Err(sc.fail("Extra data", stop));
    }
    Ok(value)
}

// ---------------------------------------------------------- encoding

struct Opts {
    has_indent: bool,
    indent: String,
    item_sep: String,
    key_sep: String,
    sort_keys: bool,
    ensure_ascii: bool,
    allow_nan: bool,
}

fn default_opts() -> Opts {
    Opts {
        has_indent: false,
        indent: String.new(),
        item_sep: ", ".to_string(),
        key_sep: ": ".to_string(),
        sort_keys: false,
        ensure_ascii: true,
        allow_nan: true,
    }
}

// The job's keyword arguments: indent=N or indent=t (a tab), compact=1
// (separators (",", ":")), and the boolean flags.
fn parse_opts(fields: ref Vec[String], first: i64) -> Opts {
    let mut o = default_opts();
    let mut compact = false;
    let mut i = first;
    while i < fields.len() {
        let parts: Vec[String] = fields[i].split("=").map(|p| p.to_string()).collect();
        let on = parts[1] == "1";
        if parts[0] == "indent" {
            o.has_indent = true;
            if parts[1] == "t" {
                o.indent = "\t".to_string();
            } else {
                let n = i64.parse(parts[1].clone()).unwrap_or(0);
                o.indent = " ".repeat(n);
            }
        } else if parts[0] == "compact" {
            compact = on;
        } else if parts[0] == "sort_keys" {
            o.sort_keys = on;
        } else if parts[0] == "ensure_ascii" {
            o.ensure_ascii = on;
        } else if parts[0] == "allow_nan" {
            o.allow_nan = on;
        }
        i += 1;
    }
    if compact {
        o.item_sep = ",".to_string();
        o.key_sep = ":".to_string();
    } else if o.has_indent {
        o.item_sep = ",".to_string();
    }
    o
}

fn push_u_escape(out: mut ref Vec[i64], cp: i64) {
    push_ascii(mut out, "\\u");
    push_ascii(mut out, hex4(cp));
}

// encode_basestring / encode_basestring_ascii.
fn encode_str(o: ref Opts, s: ref Vec[i64], out: mut ref Vec[i64]) {
    out.push(34);
    for c in s {
        if c == 34 {
            push_ascii(mut out, "\\\"");
        } else if c == 92 {
            push_ascii(mut out, "\\\\");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 8 {
            push_ascii(mut out, "\\b");
        } else if c == 12 {
            push_ascii(mut out, "\\f");
        } else if c < 0x20 {
            push_u_escape(mut out, c);
        } else if not o.ensure_ascii or c <= 0x7E {
            out.push(c);
        } else if c >= 0x10000 {
            let n = c - 0x10000;
            push_u_escape(mut out, 0xD800 | ((n >> 10) & 0x3FF));
            push_u_escape(mut out, 0xDC00 | (n & 0x3FF));
        } else {
            push_u_escape(mut out, c);
        }
    }
    out.push(34);
}

fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    f"{x}"
}

fn float_json(o: ref Opts, x: f64) -> Result[String, Exc] {
    let finite = x == x and x != 1.0 / 0.0 and x != -1.0 / 0.0;
    if finite {
        return Ok(f"{x}");
    }
    if not o.allow_nan {
        return Err(exc("ValueError", f"Out of range float values are not JSON compliant: {float_repr(x)}"));
    }
    if x != x {
        Ok("NaN".to_string())
    } else if x > 0.0 {
        Ok("Infinity".to_string())
    } else {
        Ok("-Infinity".to_string())
    }
}

fn newline_indent(o: ref Opts, level: i64, out: mut ref Vec[i64]) {
    out.push(10);
    let mut k = 0;
    while k < level {
        push_ascii(mut out, o.indent);
        k += 1;
    }
}

// The order dumps writes an object's members in: as stored, or sorted by
// key with sort_keys.
fn member_order(o: ref Opts, members: ref Vec[Member]) -> Vec[i64] {
    let mut order: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < members.len() {
        order.push(i);
        i += 1;
    }
    if o.sort_keys {
        let mut k = 1;
        while k < order.len() {
            let cur = order[k];
            let mut j = k;
            while j > 0 and cmp_cps(members[order[j - 1]].key, members[cur].key) > 0 {
                order[j] = order[j - 1];
                j -= 1;
            }
            order[j] = cur;
            k += 1;
        }
    }
    order
}

// _iterencode: the separators and indentation of json.dumps.
fn encode(o: ref Opts, v: ref J, level: i64, out: mut ref Vec[i64]) -> Result[(), Exc] {
    match v {
        J.Null => push_ascii(mut out, "null"),
        J.Bool(b) => push_ascii(mut out, if b { "true" } else { "false" }),
        J.Int(digits) => push_ascii(mut out, digits),
        J.Float(x) => {
            let text = float_json(o, x)?;
            push_ascii(mut out, text);
        }
        J.Str(s) => encode_str(o, s, mut out),
        J.Arr(items) => {
            if items.len() == 0 {
                push_ascii(mut out, "[]");
                return Ok(());
            }
            out.push(91);
            let inner = level + 1;
            if o.has_indent {
                newline_indent(o, inner, mut out);
            }
            let mut i = 0;
            while i < items.len() {
                if i > 0 {
                    push_ascii(mut out, o.item_sep);
                    if o.has_indent {
                        newline_indent(o, inner, mut out);
                    }
                }
                encode(o, items[i], inner, mut out)?;
                i += 1;
            }
            if o.has_indent {
                newline_indent(o, level, mut out);
            }
            out.push(93);
        }
        J.Obj(members) => {
            if members.len() == 0 {
                push_ascii(mut out, "{}");
                return Ok(());
            }
            out.push(123);
            let inner = level + 1;
            if o.has_indent {
                newline_indent(o, inner, mut out);
            }
            let order = member_order(o, members);
            let mut i = 0;
            while i < order.len() {
                if i > 0 {
                    push_ascii(mut out, o.item_sep);
                    if o.has_indent {
                        newline_indent(o, inner, mut out);
                    }
                }
                let m = ref members[order[i]];
                encode_str(o, m.key, mut out);
                push_ascii(mut out, o.key_sep);
                encode(o, m.val, inner, mut out)?;
                i += 1;
            }
            if o.has_indent {
                newline_indent(o, level, mut out);
            }
            out.push(125);
        }
    }
    Ok(())
}

fn dumps(o: ref Opts, v: ref J) -> Result[Vec[i64], Exc] {
    let mut out: Vec[i64] = Vec.new();
    encode(o, v, 0, mut out)?;
    Ok(out)
}

// -------------------------------------------------------------- repr

// str.isprintable for the characters outside ASCII: the controls, the
// format characters, the separators other than space, surrogates and the
// private use areas are not printable. (Unassigned code points are not
// printable either; this table does not list them.)
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x8E2 or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c == 0x110BD or c == 0x110CD {
        return false;
    }
    if (c >= 0x1BCA0 and c <= 0x1BCA3) or (c >= 0x1D173 and c <= 0x1D17A) or c == 0xE0001 {
        return false;
    }
    if (c >= 0xE0020 and c <= 0xE007F) or c >= 0xF0000 {
        return false;
    }
    true
}

fn str_repr(s: ref Vec[i64], out: mut ref Vec[i64]) {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
}

fn repr(v: ref J, out: mut ref Vec[i64]) {
    match v {
        J.Null => push_ascii(mut out, "None"),
        J.Bool(b) => push_ascii(mut out, if b { "True" } else { "False" }),
        J.Int(digits) => push_ascii(mut out, digits),
        J.Float(x) => push_ascii(mut out, float_repr(x)),
        J.Str(s) => str_repr(s, mut out),
        J.Arr(items) => {
            out.push(91);
            let mut i = 0;
            while i < items.len() {
                if i > 0 {
                    push_ascii(mut out, ", ");
                }
                repr(items[i], mut out);
                i += 1;
            }
            out.push(93);
        }
        J.Obj(members) => {
            out.push(123);
            let mut i = 0;
            while i < members.len() {
                if i > 0 {
                    push_ascii(mut out, ", ");
                }
                str_repr(members[i].key, mut out);
                push_ascii(mut out, ": ");
                repr(members[i].val, mut out);
                i += 1;
            }
            out.push(125);
        }
    }
}

// --------------------------------------------------------------- jobs

fn py_bool(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

fn read_text(name: ref String) -> Result[Vec[i64], Exc] {
    match fs.read_to_string(f"data/{name}") {
        Ok(t) => Ok(codepoints(t.bytes())),
        Err(e) => Err(exc("FileNotFoundError", f"{e}")),
    }
}

fn is_blank(line: ref Vec[i64]) -> bool {
    for c in line {
        if c != 32 and c != 9 and c != 10 and c != 13 and c != 11 and c != 12 {
            return false;
        }
    }
    true
}

fn split_lines(text: ref Vec[i64]) -> Vec[Vec[i64]] {
    let mut lines: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    for c in text {
        if c == 10 {
            lines.push(cur);
            cur = Vec.new();
        } else {
            cur.push(c);
        }
    }
    lines.push(cur);
    lines
}

// One line of a JSON Lines file: its dump, or the error loading it.
fn jsonl_line(o: ref Opts, line: ref Vec[i64]) -> Result[String, Exc] {
    let v = loads(line)?;
    let text = dumps(o, v)?;
    to_utf8(text)
}

fn roundtrip(v: ref J) -> Result[String, Exc] {
    let plain = default_opts();
    let a = dumps(plain, v)?;
    let b = dumps(plain, loads(a)?)?;
    let mut pretty = default_opts();
    pretty.has_indent = true;
    pretty.indent = "   ".to_string();
    pretty.item_sep = ",".to_string();
    pretty.sort_keys = true;
    pretty.ensure_ascii = false;
    let c = dumps(pretty, v)?;
    let d = dumps(pretty, loads(c)?)?;
    let same_a = py_bool(cmp_cps(a, b) == 0);
    let same_c = py_bool(cmp_cps(c, d) == 0);
    Ok(f"  compact {a.len()} chars, same again {same_a}; pretty {c.len()} chars, same again {same_c}\n")
}

fn run(f: ref Vec[String], out: mut ref String) -> Result[(), Exc] {
    let text = read_text(f[1])?;
    let o = parse_opts(f, 2);
    if f[0] == "jsonl" {
        let lines = split_lines(text);
        let mut n = 0;
        while n < lines.len() {
            if not is_blank(lines[n]) {
                match jsonl_line(o, lines[n]) {
                    Ok(s) => out.push_str(f"  {n + 1}: {s}\n"),
                    Err(e) => out.push_str(f"  {n + 1}: {e.kind}: {e.msg}\n"),
                }
            }
            n += 1;
        }
        return Ok(());
    }
    let value = loads(text)?;
    if f[0] == "load" {
        let mut r: Vec[i64] = Vec.new();
        repr(value, mut r);
        let s = to_utf8(r)?;
        out.push_str(f"  {s}\n");
    } else if f[0] == "dump" {
        let s = to_utf8(dumps(o, value)?)?;
        for line in s.split("\n") {
            out.push_str(f"  |{line}\n");
        }
    } else if f[0] == "roundtrip" {
        out.push_str(roundtrip(value)?);
    }
    Ok(())
}

// -------------------------------------------------------------- files

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn hex_val(c: u8) -> u8 {
    if c >= b'a' { c - b'a' + 10 } else { c - b'0' }
}

fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    let jobs = match fs.read_to_string("data/jobs.tsv".to_string()) {
        Ok(t) => t,
        Err(e) => {
            eprintln(f"cannot read jobs.tsv: {e}");
            return;
        }
    };
    for job in jobs.lines() {
        let f: Vec[String] = job.split("\t").map(|p| p.to_string()).collect();
        println(f"== {f.join(" | ")}");
        let mut out = String.new();
        match run(f, mut out) {
            Ok(()) => print(out),
            Err(e) => {
                print(out);
                println(f"  {e.kind}: {e.msg}");
            }
        }
    }
}

