    t.push_str("\t\t\"strategy\": {\"type\": \"RollingUpdate\", \"rollingUpdate\": {\"maxSurge\": \"25%\", \"maxUnavailable\": 0}},\n");
    t.push_str("\t\t\"template\": {\n");
