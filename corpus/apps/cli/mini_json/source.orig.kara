    t.push_str("\t\t\t\t\t\t\"image\": \"registry.example.com/cafe-api:2.4.1\",\n");
    t.push_str("\t\t\t\t\t\t\"ports\": [{\"containerPort\": 8080, \"protocol\": \"TCP\"}],\n");
    t.push_str("\t\t\t\t\t\t\"env\": [\n");
