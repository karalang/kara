  |  "apiVersion": "apps/v1",
  |  "kind": "Deployment",
  |  "metadata": {
  |    "name": "cafe-api",
  |    "namespace": "prod",
  |    "labels": {
  |      "app": "cafe-api",
  |      "tier": "backend"
  |    },
  |    "annotations": {
  |      "deployment.kubernetes.io/revision": "12"
  |    }
  |  },
  |  "spec": {
  |    "replicas": 3,
  |    "revisionHistoryLimit": 10,
  |    "selector": {
  |      "matchLabels": {
  |        "app": "cafe-api"
  |      }
  |    },
  |    "strategy": {
  |      "type": "RollingUpdate",
  |      "rollingUpdate": {
  |        "maxSurge": "25%",
  |        "maxUnavailable": 0
  |      }
  |    },
  |    "template": {
  |      "metadata": {
  |        "labels": {
