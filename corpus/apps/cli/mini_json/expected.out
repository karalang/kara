  |                "containerPort": 8080,
  |                "protocol": "TCP"
  |              }
  |            ],
  |            "env": [
  |              {
  |                "name": "DATABASE_URL",
  |                "valueFrom": {
  |                  "secretKeyRef": {
  |                    "name": "db",
  |                    "key": "url"
  |                  }
  |                }
  |              },
  |              {
  |                "name": "LOG_LEVEL",
  |                "value": "info"
  |              }
  |            ],
  |            "resources": {
  |              "limits": {
  |                "cpu": "500m",
  |                "memory": "256Mi"
  |              },
  |              "requests": {
