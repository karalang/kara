// mini_korean_lunar — a port of korean_lunar_calendar 0.4.0 (MIT; Jinil Lee),
// the library (used by the `holidays` project and Korean/Chinese calendar apps)
// that converts between the Gregorian solar calendar and the Korean/Chinese
// lunisolar calendar over years 1000–2050, following the KARI tables, and renders
// a date's sexagenary-cycle (gapja) name. This port follows
// korean_lunar_calendar.py exactly: the same bit-packed per-year data table
// (big/small months, the intercalary-month index, the solar leap bit, the
// cumulative-day counts), the same absolute-day arithmetic for both directions,
// the same validity rules (including the 1582 Gregorian-reform skip), and the
// same gapja index math. All arithmetic is integer; the gapja strings carry CJK
// characters, emitted as UTF-8. See README.md.

fn str_bytes(s: String) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for b in s.bytes() {
        v.push(b);
    }
    v
}

fn itoa4(n: i64) -> String {
    // zero-padded to at least 4 digits (years), like "%04d"
    let mut digs: Vec[u8] = Vec.new();
    let mut v = n;
    if v == 0 {
        digs.push(48);
    }
    while v > 0 {
        digs.push((48 + (v % 10)) as u8);
        v = v / 10;
    }
    while digs.len() < 4 {
        digs.push(48);
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i = digs.len();
    while i > 0 {
        out.push(digs[i - 1]);
        i = i - 1;
    }
    String.from_utf8(out).unwrap_or("")
}

fn itoa2(n: i64) -> String {
    // zero-padded to 2 digits (month/day), like "%02d"
    let mut out: Vec[u8] = Vec.new();
    if n < 10 {
        out.push(48);
        out.push((48 + n) as u8);
    } else {
        out.push((48 + (n / 10)) as u8);
        out.push((48 + (n % 10)) as u8);
    }
    String.from_utf8(out).unwrap_or("")
}

fn hex_val(b: u8) -> i64 {
    if b >= 48 and b <= 57 {
        (b - 48) as i64
    } else if b >= 97 and b <= 102 {
        (b - 87) as i64
    } else if b >= 65 and b <= 70 {
        (b - 55) as i64
    } else {
        0
    }
}

// Parse a space-separated list of hex tokens into Vec[i64].
fn parse_hex_list(s: String) -> Vec[i64] {
    let b = str_bytes(s.clone());
    let n = b.len();
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        while i < n and b[i] == 32 {
            i = i + 1;
        }
        if i < n {
            let mut v = 0;
            while i < n and b[i] != 32 {
                v = v * 16 + hex_val(b[i]);
                i = i + 1;
            }
            out.push(v);
        }
    }
    out
}

// Append the UTF-8 bytes of a Unicode code point (all gapja code points are in
// the BMP, so this covers the 1/2/3-byte forms).
fn push_utf8(out: mut ref Vec[u8], cp: i64) {
    if cp < 128 {
        out.push(cp as u8);
    } else if cp < 2048 {
        out.push((192 + (cp >> 6)) as u8);
        out.push((128 + (cp & 63)) as u8);
    } else {
        out.push((224 + (cp >> 12)) as u8);
        out.push((128 + ((cp >> 6) & 63)) as u8);
        out.push((128 + (cp & 63)) as u8);
    }
}

struct Cal {
    data: Vec[i64],
    cum_l: Vec[i64],   // cumulative lunar days 1000..1000+i
    cum_s: Vec[i64],   // cumulative solar days 1000..1000+i
}

fn solar_month_days_raw(ld: i64, month: i64) -> i64 {
    // SOLAR_DAYS = [31,28,31,30,31,30,31,31,30,31,30,31, 29(feb-leap)]
    let interc = ((ld >> 30) & 1) > 0;
    if month == 2 {
        if interc {
            29
        } else {
            28
        }
    } else if month == 1 or month == 3 or month == 5 or month == 7 or month == 8 or month == 10 or month == 12 {
        31
    } else {
        30
    }
}

fn solar_year_days_raw(ld: i64) -> i64 {
    if ((ld >> 30) & 1) > 0 {
        366
    } else {
        365
    }
}

fn lunar_year_days_raw(ld: i64) -> i64 {
    (ld >> 17) & 511
}

fn build_cal() -> Cal {
    let data = parse_hex_list(lunar_data_str());
    let n = data.len();
    let mut cum_l: Vec[i64] = Vec.new();
    let mut cum_s: Vec[i64] = Vec.new();
    let mut i = 0;
    let mut accl = 0;
    let mut accs = 0;
    while i < n {
        accl = accl + lunar_year_days_raw(data[i]);
        accs = accs + solar_year_days_raw(data[i]);
        cum_l.push(accl);
        cum_s.push(accs);
        i = i + 1;
    }
    Cal { data: data, cum_l: cum_l, cum_s: cum_s }
}

fn interc_month(ld: i64) -> i64 {
    (ld >> 12) & 15
}

fn lunar_month_days(cal: ref Cal, year: i64, month: i64, is_inter: bool) -> i64 {
    let ld = cal.data[year - 1000];
    if is_inter and interc_month(ld) == month {
        if ((ld >> 16) & 1) > 0 {
            30
        } else {
            29
        }
    } else {
        if ((ld >> (12 - month)) & 1) > 0 {
            30
        } else {
            29
        }
    }
}

// cumulative lunar days for years 1000..year (0 when year < 1000)
fn lunar_days_before_year(cal: ref Cal, year: i64) -> i64 {
    if year < 1000 {
        0
    } else {
        cal.cum_l[year - 1000]
    }
}

fn lunar_days_before_month(cal: ref Cal, year: i64, month: i64, is_inter: bool) -> i64 {
    let mut days = 0;
    if year >= 1000 and month > 0 {
        let mut bm = 1;
        while bm < month + 1 {
            days = days + lunar_month_days(cal, year, bm, false);
            bm = bm + 1;
        }
        if is_inter {
            let im = interc_month(cal.data[year - 1000]);
            if im > 0 and im < month + 1 {
                days = days + lunar_month_days(cal, year, im, true);
            }
        }
    }
    days
}

fn lunar_abs_days(cal: ref Cal, year: i64, month: i64, day: i64, is_inter: bool) -> i64 {
    let mut days = lunar_days_before_year(cal, year - 1)
        + lunar_days_before_month(cal, year, month - 1, true) + day;
    if is_inter and interc_month(cal.data[year - 1000]) == month {
        days = days + lunar_month_days(cal, year, month, false);
    }
    days
}

fn solar_days_before_year(cal: ref Cal, year: i64) -> i64 {
    if year < 1000 {
        0
    } else {
        cal.cum_s[year - 1000]
    }
}

fn solar_days_before_month(cal: ref Cal, year: i64, month: i64) -> i64 {
    // ld is read lazily so an empty month range (month == 0, reached via
    // solar_abs_days(ly + 1, 1, 1)) never indexes data out of range at year 2051.
    let mut days = 0;
    let mut bm = 1;
    while bm < month + 1 {
        days = days + solar_month_days_raw(cal.data[year - 1000], bm);
        bm = bm + 1;
    }
    days
}

fn solar_abs_days(cal: ref Cal, year: i64, month: i64, day: i64) -> i64 {
    solar_days_before_year(cal, year - 1) + solar_days_before_month(cal, year, month - 1) + day - 43
}

struct Ymd {
    y: i64,
    m: i64,
    d: i64,
    inter: bool,
}

fn solar_from_lunar(cal: ref Cal, ly: i64, lm: i64, ld: i64, is_inter: bool) -> Ymd {
    let abs_days = lunar_abs_days(cal, ly, lm, ld, is_inter);
    let mut sy = ly + 1;
    if abs_days < solar_abs_days(cal, ly + 1, 1, 1) {
        sy = ly;
    }
    let mut sm = 0;
    let mut sd = 0;
    let mut month = 12;
    while month > 0 {
        let abm = solar_abs_days(cal, sy, month, 1);
        if abs_days >= abm {
            sm = month;
            sd = abs_days - abm + 1;
            month = 0;
        } else {
            month = month - 1;
        }
    }
    Ymd { y: sy, m: sm, d: sd, inter: false }
}

fn lunar_from_solar(cal: ref Cal, sy: i64, sm: i64, sd: i64) -> Ymd {
    let abs_days = solar_abs_days(cal, sy, sm, sd);
    let mut ly = sy - 1;
    if abs_days >= lunar_abs_days(cal, sy, 1, 1, false) {
        ly = sy;
    }
    let mut lm = 0;
    let mut ld = 0;
    let mut is_inter = false;
    let mut month = 12;
    while month > 0 {
        let abm = lunar_abs_days(cal, ly, month, 1, false);
        if abs_days >= abm {
            lm = month;
            if interc_month(cal.data[ly - 1000]) == month {
                is_inter = abs_days >= lunar_abs_days(cal, ly, month, 1, true);
            }
            ld = abs_days - lunar_abs_days(cal, ly, lm, 1, is_inter) + 1;
            month = 0;
        } else {
            month = month - 1;
        }
    }
    Ymd { y: ly, m: lm, d: ld, inter: is_inter }
}

fn valid_date(cal: ref Cal, is_lunar: bool, is_inter: bool, year: i64, month: i64, day: i64) -> bool {
    let dv = year * 10000 + month * 100 + day;
    let mut lo = 10000213;
    let mut hi = 20501231;
    if is_lunar {
        lo = 10000101;
        hi = 20501118;
    }
    if lo <= dv and dv <= hi and month > 0 and month < 13 and day > 0 {
        if is_lunar and is_inter and interc_month(cal.data[year - 1000]) != month {
            return false;
        }
        if (not is_lunar) and year == 1582 and month == 10 and day > 4 and day < 15 {
            return false;
        }
        let mut limit = 0;
        if is_lunar {
            limit = lunar_month_days(cal, year, month, is_inter);
        } else {
            limit = solar_month_days_raw(cal.data[year - 1000], month);
        }
        if day <= limit {
            return true;
        }
    }
    false
}

// gapja index triple ((yC,yG),(mC,mG),(dC,dG)); -1 marker in yC means "unset".
struct Gapja {
    yc: i64,
    yg: i64,
    mc: i64,
    mg: i64,
    dc: i64,
    dg: i64,
    unset: bool,
}

fn gapja_indices(cal: ref Cal, d: ref Ymd) -> Gapja {
    let abs_days = lunar_abs_days(cal, d.y, d.m, d.d, d.inter);
    if abs_days <= 0 {
        return Gapja { yc: 0, yg: 0, mc: 0, mg: 0, dc: 0, dg: 0, unset: true };
    }
    let mc_count = d.m + 12 * (d.y - 1000);
    Gapja {
        yc: ((d.y + 6) - 1000) % 10,
        yg: (d.y - 1000) % 12,
        mc: (mc_count + 3) % 10,
        mg: (mc_count + 1) % 12,
        dc: (abs_days + 4) % 10,
        dg: (abs_days + 2) % 12,
        unset: false,
    }
}

// cheongan (10), ganji (12), unit (3) code points for each script.
fn gapja_string(cal: ref Cal, d: ref Ymd, korean: bool) -> String {
    let g = gapja_indices(cal, d);
    let che = if korean { korean_cheongan() } else { chinese_cheongan() };
    let gan = if korean { korean_ganji() } else { chinese_ganji() };
    let unit = if korean { korean_unit() } else { chinese_unit() };
    let mut out: Vec[u8] = Vec.new();
    push_utf8(mut out, che[g.yc]);
    push_utf8(mut out, gan[g.yg]);
    push_utf8(mut out, unit[0]);
    out.push(32);
    push_utf8(mut out, che[g.mc]);
    push_utf8(mut out, gan[g.mg]);
    push_utf8(mut out, unit[1]);
    out.push(32);
    push_utf8(mut out, che[g.dc]);
    push_utf8(mut out, gan[g.dg]);
    push_utf8(mut out, unit[2]);
    if d.inter {
        out.push(32);
        out.push(40);
        if korean {
            push_utf8(mut out, 50980);   // 0xc724 윤
        } else {
            push_utf8(mut out, 38287);   // 0x958f 閏
        }
        push_utf8(mut out, unit[1]);
        out.push(41);
    }
    String.from_utf8(out).unwrap_or("")
}

fn iso(y: i64, m: i64, d: i64) -> String {
    let mut s = String.new();
    s.push_str(itoa4(y));
    s.push_str("-");
    s.push_str(itoa2(m));
    s.push_str("-");
    s.push_str(itoa2(d));
    s
}

fn parse_ints(s: String) -> Vec[i64] {
    let b = str_bytes(s.clone());
    let n = b.len();
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        while i < n and b[i] == 32 {
            i = i + 1;
        }
        if i < n {
            let mut neg = false;
            if b[i] == 45 {
                neg = true;
                i = i + 1;
            }
            let mut v = 0;
            while i < n and b[i] >= 48 and b[i] <= 57 {
                v = v * 10 + ((b[i] - 48) as i64);
                i = i + 1;
            }
            if neg {
                v = -v;
            }
            out.push(v);
        }
    }
    out
}

fn main_run() -> String {
    let cal = build_cal();
    let data = jobs_text();
    let db = str_bytes(data.clone());
    let n = db.len();
    let mut out = String.new();
    let mut i = 0;
    let mut ls = 0;
    while i <= n {
        if i == n or db[i] == 10 {
            if i > ls {
                let line = data.substring(ls, i);
                let lb = str_bytes(line.clone());
                let mut tab = -1;
                let mut t = 0;
                while t < lb.len() {
                    if lb[t] == 9 {
                        tab = t;
                        t = lb.len();
                    } else {
                        t = t + 1;
                    }
                }
                if tab >= 0 {
                    let op = line.substring(0, tab);
                    let arg = line.substring(tab + 1, lb.len());
                    let p = parse_ints(arg.clone());
                    if op == "s2l" {
                        if valid_date(cal, false, false, p[0], p[1], p[2]) {
                            let d = lunar_from_solar(cal, p[0], p[1], p[2]);
                            out.push_str(iso(d.y, d.m, d.d));
                            if d.inter {
                                out.push_str(" Intercalation");
                            }
                        } else {
                            out.push_str("INVALID");
                        }
                    } else if op == "l2s" {
                        let is_i = p[3] != 0;
                        if valid_date(cal, true, is_i, p[0], p[1], p[2]) {
                            let d = solar_from_lunar(cal, p[0], p[1], p[2], is_i);
                            out.push_str(iso(d.y, d.m, d.d));
                        } else {
                            out.push_str("INVALID");
                        }
                    } else if op == "gap" or op == "cgap" {
                        if valid_date(cal, false, false, p[0], p[1], p[2]) {
                            let d = lunar_from_solar(cal, p[0], p[1], p[2]);
                            out.push_str(gapja_string(cal, d, op == "gap"));
                        } else {
                            out.push_str("INVALID");
                        }
                    }
                    out.push_str("\n");
                }
            }
            ls = i + 1;
        }
        i = i + 1;
    }
    out
}

fn main() {
    print(main_run());
}

fn korean_cheongan() -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(44049); v.push(51012); v.push(48337); v.push(51221); v.push(47924);
    v.push(44592); v.push(44221); v.push(49888); v.push(51076); v.push(44228);
    v
}

fn korean_ganji() -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(51088); v.push(52629); v.push(51064); v.push(47896); v.push(51652);
    v.push(49324); v.push(50724); v.push(48120); v.push(49888); v.push(50976);
    v.push(49696); v.push(54644);
    v
}

fn korean_unit() -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(45380); v.push(50900); v.push(51068);
    v
}

fn chinese_cheongan() -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(30002); v.push(20057); v.push(19993); v.push(19969); v.push(25098);
    v.push(24049); v.push(24218); v.push(36763); v.push(22764); v.push(30328);
    v
}

fn chinese_ganji() -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(23376); v.push(19985); v.push(23493); v.push(21359); v.push(36784);
    v.push(24051); v.push(21320); v.push(26410); v.push(30003); v.push(37193);
    v.push(25100); v.push(20133);
    v
}

fn chinese_unit() -> Vec[i64] {
    let mut v: Vec[i64] = Vec.new();
    v.push(24180); v.push(26376); v.push(26085);
    v
}

