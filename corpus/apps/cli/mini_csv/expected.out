== dict
  fieldnames ['id', 'name', 'city']
  2 {'id': '1', 'name': 'Ada', 'city': 'London'}
  3 {'id': '2', 'name': 'Grace', 'city': 'N/A'}
  5 {'id': '3', 'name': 'Linus', 'city': 'Helsinki', '_extra': ['Finland', 'extra']}
  6 {'id': '4', 'name': '', 'city': ''}
  1 {'key': 'x1', 'value': '10'}
  2 {'key': 'x2', 'value': '20', None: ['spare']}
  3 {'key': 'x3', 'value': None}
  2 {'k': '3', 'v': '2'}
  raise: 'id,name,email\r\n1,Ann,-\r\n2,"Bo, Jr.",bo@example.org\r\n<dict contains fields not in fieldnames: \'phone\'>-,-,-\r\n'
  ignore: 'id,name,email\r\n1,Ann,-\r\n2,"Bo, Jr.",bo@example.org\r\n3,-,-\r\n-,-,-\r\n'
== sniff
colons.txt: delimiter=':' quotechar='"' doublequote=False skipinitialspace=False header=False
  ['root', 'x', '0', '0', 'root', '/root', '/bin/bash']
  ['daemon', 'x', '1', '1', 'daemon', '/usr/sbin', '/usr/sbin/nologin']
  ['bin', 'x', '2', '2', 'bin', '/bin', '/usr/sbin/nologin']
complex.txt: delimiter=',' quotechar='"' doublequote=False skipinitialspace=False header=True
  ['re', 'im']
  ['1+2j', '3']
  ['-4.5e1', 'inf']
  ['nan', '7j']
dq.txt: delimiter=',' quotechar='"' doublequote=True skipinitialspace=False header=False
  ['name', 'quote']
  ['Ann', 'She said "hi"']
  ['Bo', 'none']
lengths.txt: delimiter=',' quotechar='"' doublequote=False skipinitialspace=False header=True
  ['code', 'label']
  ['AB', 'first']
  ['CD', 'second']
  ['EF', 'third']
mixed.txt: delimiter=',' quotechar='"' doublequote=False skipinitialspace=False header=False
  ['x;y', 'z']
  ['1;2', '3']
  ['4;5', '6']
