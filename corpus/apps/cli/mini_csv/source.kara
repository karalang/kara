fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data")?;
    put("data/after_quote.csv", file_0())?;
    put("data/contacts.csv", file_1())?;
    put("data/cr_mid.csv", file_2())?;
    put("data/dupcols.csv", file_3())?;
    put("data/eof_quote.csv", file_4())?;
    put("data/escaped.txt", file_5())?;
    put("data/headerless.csv", file_6())?;
    put("data/inventory.tsv", file_7())?;
    put("data/long.csv", file_8())?;
    put("data/nulls.csv", file_9())?;
    put("data/numbers.csv", file_10())?;
    put("data/orders.csv", file_11())?;
    put("data/prices_eu.csv", file_12())?;
    put("data/ragged.csv", file_13())?;
    put("data/read-jobs.txt", file_14())?;
    make_dir("data/sniff")?;
    put("data/sniff/colons.txt", file_15())?;
    put("data/sniff/complex.txt", file_16())?;
    put("data/sniff/dq.txt", file_17())?;
    put("data/sniff/lengths.txt", file_18())?;
    put("data/sniff/mixed.txt", file_19())?;
    put("data/sniff/noheader.txt", file_20())?;
    put("data/sniff/onecol.txt", file_21())?;
    put("data/sniff/oneword.txt", file_22())?;
    put("data/sniff/pipes.txt", file_23())?;
    put("data/sniff/plain.txt", file_24())?;
    put("data/sniff/quoted.txt", file_25())?;
    put("data/sniff/spaced.txt", file_26())?;
    put("data/sniff/tabs.txt", file_27())?;
    put("data/survey.csv", file_28())?;
    put("data/write-jobs.txt", file_29())?;
    Ok(())
}

// ------------------------------------------------------------ the report

fn read(path: Str) -> Result[String, String] {
    match fs.read_to_string(path.to_string()) {
        Ok(t) => Ok(t),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

fn write_file(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn show_reads() -> Result[(), String] {
    println("== read");
    let jobs = lines_of(read("data/read-jobs.txt")?);
    for i in 0..jobs.len() {
        let words = split_ws(jobs[i]);
        let job = parse_job(words, 1)?;
        println(f"-- {jobs[i]}");
        let text = read(f"data/{words[0]}")?;
        let mut r = match new_reader(text, job.d, job.text_source, job.limit) {
            Ok(r) => r,
            Err(e) => {
                println(f"  Error: {e}");
                continue;
            }
        };
        loop {
            match r.next() {
                Ok(Some(row)) => println(f"  {r.line_num} {row_repr(row)}"),
                Ok(None) => break,
                Err(e) => {
                    println(f"  Error: {e} (line {r.line_num})");
                    break;
                }
            }
        }
    }
    Ok(())
}

// The rows every writer job writes.
fn write_rows() -> Vec[Vec[Cell]] {
    let mut rows: Vec[Vec[Cell]] = Vec.new();
    rows.push([t("id"), t("name"), t("note"), t("amount")]);
    rows.push([n("1"), t("plain"), t(""), n("2.5")]);
    rows.push([n("2"), t("has,comma"), t("say \"hi\""), n("-3")]);
    rows.push([n("3"), t("multi\nline"), t("cr\rhere"), Cell.Null]);
    rows.push([n("4"), t(" lead space"), t("back\\slash"), n("0.1")]);
    rows.push([n("5"), t("tab\there"), t("semi;colon"), n("10")]);
    rows.push([n("6"), t("it's"), t("a b"), t("'q'")]);
    rows.push([t("")]);
    rows.push([Cell.Null]);
    rows.push(Vec.new());
    rows
}

fn show_writes() -> Result[(), String] {
    println("== write");
    let jobs = lines_of(read("data/write-jobs.txt")?);
    let rows = write_rows();
    for i in 0..jobs.len() {
        let words = split_ws(jobs[i]);
        let job = parse_job(words, 0)?;
        let label = if jobs[i].len() > 0 { jobs[i].clone() } else { "excel".to_string() };
        println(f"-- {label}");
        let mut w = new_writer(job.d)?;
        for k in 0..rows.len() {
            match w.row(rows[k]) {
                Ok(s) => println(f"  {py_repr(s)}"),
                Err(e) => println(f"  Error: {e}"),
            }
        }
    }
    Ok(())
}

fn wdict(keys: ref Vec[String], vals: ref Vec[Cell]) -> WDict {
    WDict { keys: keys.clone(), vals: vals.clone() }
}

fn show_dicts() -> Result[(), String] {
    println("== dict");
    let r = new_reader(read("data/ragged.csv")?, excel(), false, 131072)?;
    let mut dr = dict_reader(r, None, Some("_extra".to_string()), Some("N/A".to_string()));
    let names = dr.names()?;
    let mut shown: Vec[String] = Vec.new();
    for i in 0..names.len() {
        shown.push(py_repr(names[i]));
    }
    println(f"  fieldnames [{join(shown, ", ")}]");
    while let Some(d) = dr.next()? {
        println(f"  {dr.line_num} {d.repr()}");
    }
    let r = new_reader(read("data/headerless.csv")?, excel(), false, 131072)?;
    let mut dr = dict_reader(r, Some(["key".to_string(), "value".to_string()]), None, None);
    while let Some(d) = dr.next()? {
        println(f"  {dr.line_num} {d.repr()}");
    }
    let r = new_reader(read("data/dupcols.csv")?, excel(), false, 131072)?;
    let mut dr = dict_reader(r, None, None, None);
    while let Some(d) = dr.next()? {
        println(f"  {dr.line_num} {d.repr()}");
    }
    let mut dicts: Vec[WDict] = Vec.new();
    dicts.push(wdict(["id".to_string(), "name".to_string()], [n("1"), t("Ann")]));
    dicts.push(wdict(["email".to_string(), "id".to_string(), "name".to_string()], [t("bo@example.org"), n("2"), t("Bo, Jr.")]));
    dicts.push(wdict(["id".to_string(), "phone".to_string()], [n("3"), t("555")]));
    dicts.push(wdict(Vec.new(), Vec.new()));
    let fields = ["id".to_string(), "name".to_string(), "email".to_string()];
    let actions = ["raise", "ignore"];
    for a in 0..actions.len() {
        let mut w = new_writer(excel())?;
        let mut buf = header_row(mut w, fields)?;
        for i in 0..dicts.len() {
            match dict_row(mut w, fields, dicts[i], "-", actions[a] == "ignore") {
                Ok(s) => buf.push_str(s),
                Err(e) => buf.push_str(f"<{e}>"),
            }
        }
        println(f"  {actions[a]}: {py_repr(buf)}");
    }
    Ok(())
}

fn yes(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

fn char_repr(c: i64) -> String {
    py_repr(from_bytes([c as u8]))
}

fn show_sniffs() -> Result[(), String] {
    println("== sniff");
    let mut names = match fs.read_dir("data/sniff".to_string()) {
        Ok(v) => v,
        Err(e) => return Err(f"cannot list data/sniff: {e}"),
    };
    names.sort();
    for i in 0..names.len() {
        let sample = read(f"data/sniff/{names[i]}")?;
        let d = match sniff(sample) {
            Ok(d) => d,
            Err(e) => {
                println(f"{names[i]}: Error: {e}");
                continue;
            }
        };
        let header = match has_header(sample) {
            Ok(h) => yes(h),
            Err(e) => f"Error: {e}",
        };
        println(f"{names[i]}: delimiter={char_repr(d.delimiter)} quotechar={char_repr(d.quotechar)} doublequote={yes(d.doublequote)} skipinitialspace={yes(d.skipinitialspace)} header={header}");
        let mut r = match new_reader(sample, d, true, 131072) {
            Ok(r) => r,
            Err(e) => {
                println(f"  Error: {e}");
                continue;
            }
        };
        loop {
            match r.next() {
                Ok(Some(row)) => println(f"  {row_repr(row)}"),
                Ok(None) => break,
                Err(e) => {
                    println(f"  Error: {e}");
                    break;
                }
            }
        }
    }
    Ok(())
}

// "1.234,50" in cents.
fn cents(s: Str) -> i64 {
    let b = to_bytes(s);
    let neg = b.len() > 0 and b[0] == b'-';
    let mut euros: i64 = 0;
    let mut frac: Vec[u8] = Vec.new();
    let mut in_frac = false;
    for i in 0..b.len() {
        let c = b[i];
        if c == b',' {
            in_frac = true;
        } else if is_digit(c) {
            if in_frac {
                frac.push(c);
            } else {
                euros = euros * 10 + (c - b'0') as i64;
            }
        }
    }
    frac.push(b'0');
    frac.push(b'0');
    let n = euros * 100 + ((frac[0] - b'0') as i64) * 10 + (frac[1] - b'0') as i64;
    if neg { -n } else { n }
}

fn money(n: i64) -> String {
    let sign = if n < 0 { "-" } else { "" };
    let a = if n < 0 { -n } else { n };
    let c = a % 100;
    let pad = if c < 10 { "0" } else { "" };
    f"{sign}{a / 100}.{pad}{c}"
}

fn show_report() -> Result[(), String] {
    println("== report");
    let text = read("data/orders.csv")?;
    let dialect = sniff(text)?;
    println(f"sniffed delimiter={char_repr(dialect.delimiter)} header={yes(has_header(text)?)}");
    let r = new_reader(text, dialect, false, 131072)?;
    let mut dr = dict_reader(r, None, None, None);
    let mut orders: Vec[Dict] = Vec.new();
    while let Some(d) = dr.next()? {
        orders.push(d);
    }
    make_dir("data/out")?;
    let base = excel();
    let mut clean = new_writer(Dialect { quoting: QUOTE_NONNUMERIC, ..base })?;
    let mut out = clean.row([t("order"), t("date"), t("country"), t("customer"), t("amount"), t("status")])?;
    let mut countries: Vec[String] = Vec.new();
    let mut totals: Vec[i64] = Vec.new();
    let mut counts: Vec[i64] = Vec.new();
    for i in 0..orders.len() {
        let o = orders[i].clone();
        let c = cents(o.get("Betrag"));
        let customer = join(split_ws(o.get("Kunde")), " ");
        out.push_str(clean.row([n(o.get("Bestellung")), t(o.get("Datum")), t(o.get("Land")), t(customer), t(money(c)), t(o.get("Status"))])?);
        let status = o.get("Status");
        if status == "bezahlt" or status == "erstattet" {
            let land = o.get("Land");
            let mut at: i64 = -1;
            for k in 0..countries.len() {
                if countries[k] == land {
                    at = k;
                }
            }
            if at < 0 {
                countries.push(land);
                totals.push(0);
                counts.push(0);
                at = countries.len() - 1;
            }
            totals[at] += c;
            counts[at] += 1;
        }
    }
    write_file("data/out/orders_clean.csv", out)?;
    let fields = ["country".to_string(), "orders".to_string(), "revenue".to_string()];
    let base = excel();
    let mut sw = new_writer(Dialect { lineterminator: "\n".to_string(), ..base })?;
    let mut summary = header_row(mut sw, fields)?;
    let sorted = sort_strings(countries.clone());
    let mut all_orders: i64 = 0;
    let mut all_cents: i64 = 0;
    for i in 0..sorted.len() {
        let mut at: i64 = 0;
        for k in 0..countries.len() {
            if countries[k] == sorted[i] {
                at = k;
            }
        }
        all_orders += counts[at];
        all_cents += totals[at];
        let row = wdict(fields, [t(sorted[i]), n(f"{counts[at]}"), t(money(totals[at]))]);
        summary.push_str(dict_row(mut sw, fields, row, "", false)?);
    }
    let row = wdict(fields, [t("total"), n(f"{all_orders}"), t(money(all_cents))]);
    summary.push_str(dict_row(mut sw, fields, row, "", false)?);
    write_file("data/out/summary.csv", summary)?;
    let files = ["orders_clean.csv", "summary.csv"];
    for i in 0..files.len() {
        println(f"-- data/out/{files[i]}");
        let back_text = read(f"data/out/{files[i]}")?;
        println(py_repr(back_text));
        let quoting = if i == 0 { QUOTE_NONNUMERIC } else { QUOTE_MINIMAL };
        let base = excel();
        let mut r = new_reader(back_text, Dialect { quoting: quoting, ..base }, false, 131072)?;
        let mut back: Vec[Vec[Value]] = Vec.new();
        while let Some(row) = r.next()? {
            back.push(row);
        }
        println(f"  read back: {back.len()} rows, last {row_repr(back[back.len() - 1])}");
    }
    Ok(())
}

fn run() -> Result[(), String] {
    write_data()?;
    show_reads()?;
    show_writes()?;
    show_dicts()?;
    show_sniffs()?;
    show_report()?;
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_csv: {e}");
    }
}
