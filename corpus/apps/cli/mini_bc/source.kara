    return (t)
}
sum(a[], 3)
define clobber(v[]) {
    v[0] = 99
    return (v[0])
}
clobber(a[])
a[0]
define setall(*v[], n, val) {
    auto i
    for (i = 0; i < n; i++) v[i] = val
}
setall(a[], 3, 7)
a[0] + a[1] + a[2]
define void greet(name) {
    print "hello, number ", name, "\\n"
}
greet(42)
define ack(m, n) {
    if (m == 0) return (n + 1)
    if (n == 0) return (ack(m - 1, 1))
    return (ack(m - 1, ack(m, n - 1)))
}
ack(2, 3)
define hanoi(n) {
