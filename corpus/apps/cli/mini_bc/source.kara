}
counter()
z[3]
define collatz(n) {
    auto steps
    while (n != 1) {
        if (n % 2 == 0) n /= 2 else n = 3 * n + 1
        steps += 1
    }
    return (steps)
}
collatz(27)
i = 0
while (1) {
    i += 1
    if (i == 3) continue
    if (i > 6) break
    print i, " "
}
print "\\n"
for (;;) { break }
for (j = 0; j < 3; j++) if (j == 1) print "one\\n" else print "not one\\n"
if (0) 5 else if (1) 6 else 7

"""
}

