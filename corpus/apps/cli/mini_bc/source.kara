// data/series.bc
fn file_8() -> String {
    """
/* Constants from series, without the -l library. */
define arctan(x) {
    auto term, sum, k, x2, prev
    sum = x
    term = x
    x2 = x * x
    k = 1
    prev = 0
    while (sum != prev) {
        prev = sum
        term = -term * x2
        k += 2
        sum += term / k
    }
    return (sum)
}
define exp1() {
    auto term, sum, n
    sum = 1
    term = 1
    n = 0
    while (term > 0) {
        n += 1
        term = term / n
        sum += term
    }
    return (sum)
}
scale = 60
pi = 16 * arctan(1/5) - 4 * arctan(1/239)
scale = 50
pi / 1
e = exp1()
e
scale = 70
sqrt(2)
phi = (1 + sqrt(5)) / 2
phi
scale = 20
sqrt(10^40 + 1)
sqrt(.0004)
sqrt(123456789)
scale = 3
sqrt(2.00000)
22 / 7 - pi

"""
}

fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data")?;
    put("data/bases.bc", file_0())?;
    put("data/bigint.bc", file_1())?;
    put("data/errors.bc", file_2())?;
    put("data/functions.bc", file_3())?;
    put("data/jobs.txt", file_4())?;
    put("data/loan.bc", file_5())?;
    put("data/report.bc", file_6())?;
    put("data/scale.bc", file_7())?;
    put("data/series.bc", file_8())?;
    Ok(())
}

// ------------------------------------------------------------ the run

fn show(text: Str) {
    print(text);
    if text.len() > 0 and not text.ends_with("\n") {
        println("[no newline at end]");
    }
}

fn run() -> Result[(), String] {
    write_data()?;
    let jobs = match fs.read_to_string("data/jobs.txt".to_string()) {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/jobs.txt: {e}"),
    };
    for line in jobs.lines() {
        let name = line.trim().to_string();
        if name.len() == 0 {
            continue;
        }
        println(f"$ bc < {name}");
        let src = match fs.read_to_string(f"data/{name}") {
            Ok(t) => t,
            Err(e) => return Err(f"cannot read data/{name}: {e}"),
        };
        let (out, err) = run_script(src);
        show(out);
        show(err);
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_bc: {e}");
    }
}
