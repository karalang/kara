== track slices and sums
  a = Message('note_on', channel=0, note=60, velocity=64, time=0)
  b = Message('note_off', channel=0, note=60, velocity=64, time=10)
  c = Message('clock', time=0)
  t = MidiTrack of 3
  s = t[1:3]
  s.repr:
    MidiTrack([
      Message('note_off', channel=0, note=60, velocity=64, time=10),
      Message('clock', time=0)])
  s2 = t[5:9]
  s2.repr:
    MidiTrack()
  m = t[0]
  m.repr: Message('note_on', channel=0, note=60, velocity=64, time=0)
  m2 = t[-1]
  m2.repr: Message('clock', time=0)
  m3: IndexError: list index out of range
  u = t + s
  u.repr:
    MidiTrack([
      Message('note_on', channel=0, note=60, velocity=64, time=0),
      Message('note_off', channel=0, note=60, velocity=64, time=10),
      Message('clock', time=0),
      Message('note_off', channel=0, note=60, velocity=64, time=10),
      Message('clock', time=0)])
  u.len: 5
  w = s * 2
  w.repr:
    MidiTrack([
      Message('note_off', channel=0, note=60, velocity=64, time=10),
      Message('clock', time=0),
      Message('note_off', channel=0, note=60, velocity=64, time=10),
      Message('clock', time=0)])
  z = s * 0
  z.repr:
    MidiTrack()
  z.append(c)
  z.repr:
    MidiTrack([clock time=0])
