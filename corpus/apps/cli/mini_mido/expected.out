  m.velocity = 0: ok
  m.channel = 15: ok
  m.time = 0.5: ok
  m.repr: Message('note_on', channel=15, note=72, velocity=0, time=0.5)
  m.str: note_on channel=15 note=72 velocity=0 time=0.5
  m.type = 'note_off': AttributeError: type attribute is read only
  m.pitch = 3: AttributeError: note_on message has no attribute pitch
  m.note = 300: ValueError: data byte must be in range 0..127
  m.channel = '1': TypeError: channel must be int
  m.time = 'late': TypeError: time must be int or float
  m.repr: Message('note_on', channel=15, note=72, velocity=0, time=0.5)
