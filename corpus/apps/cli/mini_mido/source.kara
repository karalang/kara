// mini_mido: mido 1.3.3, the pure-Python MIDI library behind most
// Python music tools, sequencers and patch librarians:
// - Message and MetaMessage with every type, their checks, repr, str,
//   bytes, hex, bin and dict; from_bytes, from_hex and from_str; copy,
//   equality, freezing; UnknownMetaMessage;
// - the Parser and Tokenizer, parse_string_stream, the unit functions,
//   variable-length ints and signed/unsigned;
// - MidiTrack (names, slices, fix_end_of_track, merge_tracks) and
//   MidiFile: reading with running status, clip, charsets and the debug
//   dump, every way a broken file fails, saving, length and playback;
// - SysEx files in both formats and the EchoPort;
// - five programs: a song report with the tempo map, a transposer, a
//   SysEx patch librarian, a composer from text event logs and a MIDI
//   thru box.
//
// The inputs are data/jobs.jsonl and the files beside it, made by mk.py.
// expected.out is the output of oracle.py, which runs the same jobs and
// programs through mido itself (the copy in mido/).

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn hex_val(c: i64) -> i64 {
    if c >= 97 { c - 87 } else { c - 48 }
}

fn unhex(s: ref String) -> Vec[u8] {
    let d = s.bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < d.len() {
        out.push((hex_val(d[i] as i64) * 16 + hex_val(d[i + 1] as i64)) as u8);
        i += 2;
    }
    out
}

fn write_data() -> Result[(), String] {
    if fs.exists("data/out".to_string()) {
        if let Err(e) = fs.remove_dir_all("data/out".to_string()) {
            return Err(f"cannot clear data/out: {e}");
        }
    }
    for file in data_files() {
        let mut dir = "data".to_string();
        let parts: Vec[Str] = file.path.split("/").collect();
        let mut i = 0;
        while i + 1 < parts.len() {
            dir = f"{dir}/{parts[i]}";
            i += 1;
        }
        if let Err(e) = fs.create_dir_all(dir) {
            return Err(f"cannot create {dir}: {e}");
        }
        let p = f"data/{file.path}";
        let r = if file.hex { fs.write_bytes(p.clone(), unhex(file.body)) } else { fs.write(p.clone(), file.body.clone()) };
        if let Err(e) = r {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    if let Err(e) = run() {
        eprintln(failure(e));
    }
}
// ------------------------------------------------------------ Python values

// A value json.loads gives: integers keep their digits, so one past 64
// bits prints as Python prints it; objects keep their keys in order, and
// a repeated key keeps its first place and takes its last value.
#[derive(Clone)]
enum J {
    Null,
    Bool(bool),
    Int(String),
    Float(f64),
    Str(String),
    Arr(Vec[J]),
    Obj(Vec[Member]),
}

#[derive(Clone)]
struct Member {
    key: String,
    val: J,
}

// A raised exception: its class name and str().
#[derive(Clone)]
struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: own String) -> Exc {
    Exc { kind: kind.to_string(), msg: msg }
}

fn failure(e: ref Exc) -> String {
    f"{e.kind}: {e.msg}"
}

// ------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn push_utf8(out: mut ref Vec[u8], cp: i64) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push((0xC0 | (cp >> 6)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else if cp < 0x10000 {
        out.push((0xE0 | (cp >> 12)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else {
        out.push((0xF0 | (cp >> 18)) as u8);
        out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    }
}

fn is_surrogate(cp: i64) -> bool {
    cp >= 0xD800 and cp <= 0xDFFF
}

fn hex4(cp: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = 12;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn ascii_string(s: ref Vec[i64], start: i64, end: i64) -> String {
    let mut out: Vec[u8] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i] as u8);
        i += 1;
    }
    String.from_utf8(out).unwrap()
}


// ---------------------------------------------------------- decoding

// The C scanner in Modules/_json.c, over code points.
struct Scanner {
    s: Vec[i64],
}

fn is_digit(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn hex_value(c: i64) -> i64 {
    if c >= 48 and c <= 57 {
        c - 48
    } else if c >= 97 and c <= 102 {
        c - 87
    } else if c >= 65 and c <= 70 {
        c - 55
    } else {
        -1
    }
}

impl Scanner {
    fn at(ref self, i: i64) -> i64 {
        if i >= 0 and i < self.s.len() { self.s[i] } else { -1 }
    }

    // JSONDecodeError's message: the line and column are counted from the
    // newlines before the position.
    fn fail(ref self, msg: Str, pos: i64) -> Exc {
        let mut line = 1;
        let mut last = -1;
        let mut i = 0;
        while i < pos {
            if self.s[i] == 10 {
                line += 1;
                last = i;
            }
            i += 1;
        }
        exc("JSONDecodeError", f"{msg}: line {line} column {pos - last} (char {pos})")
    }

    fn skip_ws(ref self, start: i64) -> i64 {
        let mut i = start;
        while i < self.s.len() {
            let c = self.s[i];
            if c != 32 and c != 9 and c != 10 and c != 13 {
                break;
            }
            i += 1;
        }
        i
    }

    fn matches(ref self, i: i64, word: Str) -> bool {
        let w = word.bytes();
        if i + w.len() > self.s.len() {
            return false;
        }
        let mut k = 0;
        while k < w.len() {
            if self.s[i + k] != w[k] as i64 {
                return false;
            }
            k += 1;
        }
        true
    }

    fn scan_once(ref self, idx: i64) -> Result[(J, i64), Exc] {
        let c = self.at(idx);
        if c == 34 {
            let (text, end) = self.scan_string(idx + 1)?;
            return Ok((J.Str(cps_string(text)), end));
        }
        if c == 123 {
            return self.parse_object(idx + 1);
        }
        if c == 91 {
            return self.parse_array(idx + 1);
        }
        if c == 110 and self.matches(idx, "null") {
            return Ok((J.Null, idx + 4));
        }
        if c == 116 and self.matches(idx, "true") {
            return Ok((J.Bool(true), idx + 4));
        }
        if c == 102 and self.matches(idx, "false") {
            return Ok((J.Bool(false), idx + 5));
        }
        if c == 78 and self.matches(idx, "NaN") {
            return Ok((J.Float(0.0 / 0.0), idx + 3));
        }
        if c == 73 and self.matches(idx, "Infinity") {
            return Ok((J.Float(1.0 / 0.0), idx + 8));
        }
        if c == 45 and self.matches(idx, "-Infinity") {
            return Ok((J.Float(-1.0 / 0.0), idx + 9));
        }
        self.match_number(idx)
    }

    // -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][-+]?[0-9]+)?, then int() or float()
    // of the text. Anything else at a value's place is "Expecting value".
    fn match_number(ref self, start: i64) -> Result[(J, i64), Exc] {
        let end_idx = self.s.len() - 1;
        let mut idx = start;
        if self.at(idx) == 45 {
            idx += 1;
            if idx > end_idx {
                return Err(self.fail("Expecting value", start));
            }
        }
        let c = self.at(idx);
        if c >= 49 and c <= 57 {
            idx += 1;
            while idx <= end_idx and is_digit(self.s[idx]) {
                idx += 1;
            }
        } else if c == 48 {
            idx += 1;
        } else {
            return Err(self.fail("Expecting value", start));
        }
        let mut is_float = false;
        if idx < end_idx and self.s[idx] == 46 and is_digit(self.s[idx + 1]) {
            is_float = true;
            idx += 2;
            while idx <= end_idx and is_digit(self.s[idx]) {
                idx += 1;
            }
        }
        if idx < end_idx and (self.s[idx] == 101 or self.s[idx] == 69) {
            let e_start = idx;
            idx += 1;
            if idx < end_idx and (self.s[idx] == 45 or self.s[idx] == 43) {
                idx += 1;
            }
            while idx <= end_idx and is_digit(self.s[idx]) {
                idx += 1;
            }
            if is_digit(self.s[idx - 1]) {
                is_float = true;
            } else {
                idx = e_start;
            }
        }
        let text = ascii_string(self.s, start, idx);
        if is_float {
            return match f64.parse(text) {
                Ok(x) => Ok((J.Float(x), idx)),
                Err(_) => Err(exc("ValueError", f"could not convert string to float: '{text}'")),
            };
        }
        let digits = if self.s[start] == 45 { idx - start - 1 } else { idx - start };
        if digits > 4300 {
            return Err(exc("ValueError", f"Exceeds the limit (4300 digits) for integer string conversion: value has {digits} digits; use sys.set_int_max_str_digits() to increase the limit"));
        }
        if text == "-0" {
            return Ok((J.Int("0".to_string()), idx));
        }
        Ok((J.Int(text), idx))
    }

    fn hex_escape(ref self, at: i64) -> Option[i64] {
        let mut v = 0;
        let mut k = 0;
        while k < 4 {
            let d = hex_value(self.at(at + k));
            if d < 0 {
                return None;
            }
            v = v * 16 + d;
            k += 1;
        }
        Some(v)
    }

    // scanstring: `start` is just past the opening quote.
    fn scan_string(ref self, start: i64) -> Result[(Vec[i64], i64), Exc] {
        let len = self.s.len();
        let begin = start - 1;
        let mut out: Vec[i64] = Vec.new();
        let mut end = start;
        loop {
            let mut next = end;
            let mut c = 0;
            while next < len {
                c = self.s[next];
                if c == 34 or c == 92 {
                    break;
                }
                if c <= 0x1F {
                    return Err(self.fail("Invalid control character at", next));
                }
                out.push(c);
                next += 1;
            }
            if next == len {
                return Err(self.fail("Unterminated string starting at", begin));
            }
            next += 1;
            if c == 34 {
                return Ok((out, next));
            }
            if next == len {
                return Err(self.fail("Unterminated string starting at", begin));
            }
            let e = self.s[next];
            if e != 117 {
                end = next + 1;
                let ch = match e {
                    34 => 34,
                    92 => 92,
                    47 => 47,
                    98 => 8,
                    102 => 12,
                    110 => 10,
                    114 => 13,
                    116 => 9,
                    _ => 0,
                };
                if ch == 0 {
                    return Err(self.fail("Invalid \\escape", end - 2));
                }
                out.push(ch);
            } else {
                next += 1;
                end = next + 4;
                if end >= len {
                    return Err(self.fail("Invalid \\uXXXX escape", next - 1));
                }
                let mut cp = match self.hex_escape(next) {
                    Some(v) => v,
                    None => return Err(self.fail("Invalid \\uXXXX escape", end - 5)),
                };
                // A high surrogate followed by an escaped low one is a pair;
                // followed by anything else it stays on its own.
                if cp >= 0xD800 and cp <= 0xDBFF and end + 6 < len and self.s[end] == 92 and self.s[end + 1] == 117 {
                    let low = match self.hex_escape(end + 2) {
                        Some(v) => v,
                        None => return Err(self.fail("Invalid \\uXXXX escape", end + 1)),
                    };
                    if low >= 0xDC00 and low <= 0xDFFF {
                        cp = 0x10000 + (((cp - 0xD800) << 10) | (low - 0xDC00));
                        end += 6;
                    }
                }
                out.push(cp);
            }
        }
    }

    fn parse_object(ref self, start: i64) -> Result[(J, i64), Exc] {
        let mut members: Vec[Member] = Vec.new();
        let mut idx = self.skip_ws(start);
        if self.at(idx) != 125 {
            loop {
                if self.at(idx) != 34 {
                    return Err(self.fail("Expecting property name enclosed in double quotes", idx));
                }
                let (key, after_key) = self.scan_string(idx + 1)?;
                idx = self.skip_ws(after_key);
                if self.at(idx) != 58 {
                    return Err(self.fail("Expecting ':' delimiter", idx));
                }
                idx = self.skip_ws(idx + 1);
                let (val, after_val) = self.scan_once(idx)?;
                put_member(mut members, cps_string(key), val);
                idx = self.skip_ws(after_val);
                if self.at(idx) == 125 {
                    break;
                }
                if self.at(idx) != 44 {
                    return Err(self.fail("Expecting ',' delimiter", idx));
                }
                let comma = idx;
                idx = self.skip_ws(idx + 1);
                if self.at(idx) == 125 {
                    return Err(self.fail("Illegal trailing comma before end of object", comma));
                }
            }
        }
        Ok((J.Obj(members), idx + 1))
    }

    fn parse_array(ref self, start: i64) -> Result[(J, i64), Exc] {
        let mut items: Vec[J] = Vec.new();
        let mut idx = self.skip_ws(start);
        if self.at(idx) != 93 {
            loop {
                let (val, after) = self.scan_once(idx)?;
                items.push(val);
                idx = self.skip_ws(after);
                if self.at(idx) == 93 {
                    break;
                }
                if self.at(idx) != 44 {
                    return Err(self.fail("Expecting ',' delimiter", idx));
                }
                let comma = idx;
                idx = self.skip_ws(idx + 1);
                if self.at(idx) == 93 {
                    return Err(self.fail("Illegal trailing comma before end of array", comma));
                }
            }
        }
        Ok((J.Arr(items), idx + 1))
    }
}

// dict(pairs): a key seen again keeps its place and takes the new value.
fn put_member(members: mut ref Vec[Member], key: own String, val: own J) {
    let mut j = 0;
    while j < members.len() {
        if members[j].key == key {
            members[j].val = val;
            return;
        }
        j += 1;
    }
    members.push(Member { key: key, val: val });
}

// A str from code points. A lone surrogate, which a str can hold but a
// Kara String cannot, becomes U+FFFD.
fn cps_string(cps: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for c in cps.iter() {
        if is_surrogate(*c) {
            push_utf8(mut out, 0xFFFD);
        } else {
            push_utf8(mut out, *c);
        }
    }
    String.from_utf8(out).unwrap()
}

fn string_cps(s: ref String) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s.chars() {
        out.push(c as i64);
    }
    out
}

// json.loads on a str.
fn loads_cps(text: ref Vec[i64]) -> Result[J, Exc] {
    let sc = Scanner { s: text.clone() };
    if sc.at(0) == 0xFEFF {
        return Err(sc.fail("Unexpected UTF-8 BOM (decode using utf-8-sig)", 0));
    }
    let start = sc.skip_ws(0);
    let (value, end) = sc.scan_once(start)?;
    let stop = sc.skip_ws(end);
    if stop != sc.s.len() {
        return Err(sc.fail("Extra data", stop));
    }
    Ok(value)
}

fn loads_str(text: ref String) -> Result[J, Exc] {
    loads_cps(string_cps(text))
}

// The error bytes.decode("utf-8") raises: the bad byte, or the bytes from
// a sequence's start up to the one that does not fit.
fn utf8_error(b: ref Vec[u8], start: i64, end: i64, reason: Str) -> Exc {
    if end - start == 1 {
        return exc("UnicodeDecodeError", f"'utf-8' codec can't decode byte 0x{b[start]:02x} in position {start}: {reason}");
    }
    exc("UnicodeDecodeError", f"'utf-8' codec can't decode bytes in position {start}-{end - 1}: {reason}")
}

fn is_cont(c: u8) -> bool {
    c >= 0x80 and c <= 0xBF
}

// bytes.decode("utf-8", "surrogatepass"), as json.loads decodes bytes.
// An encoded surrogate (ED A0..BF 80..BF) is let through.
fn utf8_decode(b: ref Vec[u8]) -> Result[Vec[i64], Exc] {
    let mut out: Vec[i64] = Vec.new();
    let n = b.len();
    let mut i = 0;
    while i < n {
        let c = b[i];
        if c < 0x80 {
            out.push(c as i64);
            i += 1;
            continue;
        }
        if c < 0xC2 or c > 0xF4 {
            return Err(utf8_error(b, i, i + 1, "invalid start byte"));
        }
        let need = if c < 0xE0 { 1 } else if c < 0xF0 { 2 } else { 3 };
        // The range the second byte must fall in.
        let mut lo: u8 = 0x80;
        let mut hi: u8 = 0xBF;
        if c == 0xE0 {
            lo = 0xA0;
        } else if c == 0xF0 {
            lo = 0x90;
        } else if c == 0xF4 {
            hi = 0x8F;
        }
        // ED A0..BF starts a surrogate, which strict UTF-8 rejects at the
        // second byte; when the third byte does not complete it, the error
        // is that one.
        let surrogate = c == 0xED and n > i + 1 and b[i + 1] >= 0xA0 and b[i + 1] <= 0xBF;
        if surrogate and (n <= i + 2 or not is_cont(b[i + 2])) {
            return Err(utf8_error(b, i, i + 1, "invalid continuation byte"));
        }
        let mut k = 1;
        while k <= need {
            if i + k >= n {
                return Err(utf8_error(b, i, n, "unexpected end of data"));
            }
            let d = b[i + k];
            let ok = if k == 1 { d >= lo and d <= hi } else { is_cont(d) };
            if not ok {
                return Err(utf8_error(b, i, i + k, "invalid continuation byte"));
            }
            k += 1;
        }
        let mut cp = if need == 1 { (c as i64) & 0x1F } else if need == 2 { (c as i64) & 0x0F } else { (c as i64) & 0x07 };
        for j in 1..(need + 1) {
            cp = (cp << 6) | ((b[i + j] as i64) & 0x3F);
        }
        out.push(cp);
        i += need + 1;
    }
    Ok(out)
}

// json.loads on bytes: the encoding is detected (only UTF-8, with or
// without its BOM, is handled here), the bytes are decoded, and the text
// is loaded. A decode error is a ValueError, as JSONDecodeError is.
fn loads_bytes(b: ref Vec[u8]) -> Result[J, Exc] {
    let mut body = b.clone();
    if b.len() >= 3 and b[0] == 0xEF and b[1] == 0xBB and b[2] == 0xBF {
        body = Vec.new();
        for i in 3..b.len() {
            body.push(b[i]);
        }
    }
    let cps = utf8_decode(body)?;
    loads_cps(cps)
}
// ------------------------------------------------------------ helpers

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    let mut i = 0;
    while i < parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
        i += 1;
    }
    out
}



// Whether str.isprintable() holds for one code point, for the ones these
// programs meet: the C0 and C1 controls, DEL, no-break space and the
// soft hyphen are not.
fn printable(cp: i64) -> bool {
    not (cp < 0x20 or (cp >= 0x7F and cp <= 0xA0) or cp == 0xAD)
}

fn str_repr(t: ref String) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for c in t.chars() {
        if c == '\'' {
            has_single = true;
        } else if c == '"' {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { '"' } else { '\'' };
    let mut out = String.new();
    out.push(quote);
    for c in t.chars() {
        let cp = c as i64;
        if c == quote or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if not printable(cp) {
            out.push_str("\\x");
            out.push_str(hex_n(cp, 2));
        } else {
            out.push(c);
        }
    }
    out.push(quote);
    out
}

// ------------------------------------------------------------- errors


fn is_py_space(c: char) -> bool {
    let cp = c as i64;
    (cp >= 9 and cp <= 13) or (cp >= 28 and cp <= 32) or cp == 133 or cp == 160
}

// int(text): surrounding whitespace, a sign, and single underscores
// between digits.
fn parse_py_int(t: ref String) -> Option[i64] {
    let cs: Vec[char] = t.chars().collect();
    let mut lo = 0;
    let mut hi = cs.len();
    while lo < hi and is_py_space(cs[lo]) {
        lo += 1;
    }
    while hi > lo and is_py_space(cs[hi - 1]) {
        hi -= 1;
    }
    let mut neg = false;
    if lo < hi and (cs[lo] == '-' or cs[lo] == '+') {
        neg = cs[lo] == '-';
        lo += 1;
    }
    if lo >= hi {
        return None;
    }
    let mut n = 0;
    let mut prev_digit = false;
    let mut i = lo;
    while i < hi {
        let c = cs[i];
        if c >= '0' and c <= '9' {
            n = n * 10 + (c as i64 - 48);
            prev_digit = true;
        } else if c == '_' and prev_digit and i + 1 < hi {
            prev_digit = false;
        } else {
            return None;
        }
        i += 1;
    }
    if not prev_digit {
        return None;
    }
    Some(if neg { -n } else { n })
}


fn float_repr(x: f64) -> String {
    if x.is_nan() {
        return "nan".to_string();
    }
    f"{x}"
}

// repr() of a value json.loads gave.
fn py_repr(j: ref J) -> String {
    match j {
        J.Null => "None".to_string(),
        J.Bool(b) => if *b { "True".to_string() } else { "False".to_string() },
        J.Int(t) => t.clone(),
        J.Float(x) => float_repr(*x),
        J.Str(t) => str_repr(t),
        J.Arr(items) => {
            let mut parts: Vec[String] = Vec.new();
            for x in items.iter() {
                parts.push(py_repr(x));
            }
            f"[{join(parts, ", ")}]"
        }
        J.Obj(members) => {
            let mut parts: Vec[String] = Vec.new();
            for m in members.iter() {
                parts.push(f"{str_repr(m.key)}: {py_repr(m.val)}");
            }
            f"{{{join(parts, ", ")}}}"
        }
    }
}

fn opt_repr(t: ref Option[String]) -> String {
    match t {
        Some(x) => str_repr(x),
        None => "None".to_string(),
    }
}

fn ints_repr(xs: ref Vec[i64]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for x in xs.iter() {
        parts.push(f"{x}");
    }
    f"[{join(parts, ", ")}]"
}

fn as_num(j: ref J) -> f64 {
    match j {
        J.Bool(b) => if *b { 1.0 } else { 0.0 },
        J.Int(t) => {
            let n: Option[i64] = t.parse();
            n.unwrap_or(0) as f64
        }
        J.Float(x) => *x,
        _ => 0.0,
    }
}

fn as_int(j: ref J) -> i64 {
    match j {
        J.Bool(b) => if *b { 1 } else { 0 },
        J.Int(t) => {
            let n: Option[i64] = t.parse();
            n.unwrap_or(0)
        }
        _ => 0,
    }
}

fn members_of(j: ref J) -> Vec[Member] {
    match j {
        J.Obj(m) => m.clone(),
        _ => Vec.new(),
    }
}

fn member(ms: ref Vec[Member], key: Str) -> Option[J] {
    for m in ms.iter() {
        if m.key == key {
            return Some(m.val.clone());
        }
    }
    None
}

// dict.update: a key keeps its place and takes the new value.
fn update(ms: mut ref Vec[Member], key: ref String, val: own J) {
    let mut i = 0;
    while i < ms.len() {
        if ms[i].key == *key {
            ms[i].val = val;
            return;
        }
        i += 1;
    }
    ms.push(Member { key: key.clone(), val: val });
}

fn text_of(j: ref J) -> String {
    match j {
        J.Str(t) => t.clone(),
        _ => py_repr(j),
    }
}

fn opt_text(j: ref J) -> Option[String] {
    match j {
        J.Null => None,
        J.Str(t) => Some(t.clone()),
        _ => Some(py_repr(j)),
    }
}

fn chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn from_chars(cs: ref Vec[char], lo: i64, hi: i64) -> String {
    let mut out = String.new();
    let mut i = if lo < 0 { 0 } else { lo };
    let end = if hi > cs.len() { cs.len() } else { hi };
    while i < end {
        out.push(cs[i]);
        i += 1;
    }
    out
}

// s[lo:hi] by code points, clamped the way Python slices are.
fn slice(s: ref String, lo: i64, hi: i64) -> String {
    from_chars(chars(s), lo, hi)
}

fn is_dig(c: char) -> bool {
    c >= '0' and c <= '9'
}

// str.isdigit() for the ASCII digits these codes use.
fn all_digits(s: ref String) -> bool {
    if s.len() == 0 {
        return false;
    }
    for c in s.chars() {
        if not is_dig(c) {
            return false;
        }
    }
    true
}

fn digit(c: char) -> i64 {
    c as i64 - 48
}

// int(c) for one character.
fn int_char(c: char) -> Result[i64, Exc] {
    if is_dig(c) {
        Ok(digit(c))
    } else {
        Err(exc("ValueError", f"invalid literal for int() with base 10: {str_repr(c.to_string())}"))
    }
}

fn is_shell_safe(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or is_dig(c) or c == '@' or c == '%' or c == '+'
        or c == '=' or c == ':' or c == ',' or c == '.' or c == '/' or c == '-' or c == '_'
}

// shlex.quote.
fn shell_quote(s: ref String) -> String {
    if s.len() == 0 {
        return "''".to_string();
    }
    let mut safe = true;
    for c in s.chars() {
        if not is_shell_safe(c) {
            safe = false;
        }
    }
    if safe {
        return s.clone();
    }
    let inner = s.replace("'", "'\"'\"'");
    f"'{inner}'"
}
// ------------------------------------------------------------ values

// A Python value as mido sees one: what json.loads gives a job, plus
// tuples (SysexData and decoded data are tuples).
#[derive(Clone)]
enum V {
    Nil,
    Bool(bool),
    Int(i64),
    Float(f64),
    Str(String),
    List(Vec[V]),
    Tuple(Vec[V]),
}

fn from_j(j: ref J) -> V {
    match j {
        J.Null => V.Nil,
        J.Bool(b) => V.Bool(*b),
        J.Int(t) => {
            let n: Option[i64] = t.parse();
            V.Int(n.unwrap_or(0))
        }
        J.Float(x) => V.Float(*x),
        J.Str(t) => V.Str(t.clone()),
        J.Arr(items) => {
            let mut out: Vec[V] = Vec.new();
            for x in items.iter() {
                out.push(from_j(x));
            }
            V.List(out)
        }
        J.Obj(members) => {
            let mut out: Vec[V] = Vec.new();
            for m in members.iter() {
                if m.key == "tuple" {
                    match from_j(m.val) {
                        V.List(xs) => {
                            out = xs;
                        }
                        _ => {}
                    }
                }
            }
            V.Tuple(out)
        }
    }
}

fn repr_items(xs: ref Vec[V]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for x in xs.iter() {
        parts.push(repr(x));
    }
    join(parts, ", ")
}

fn repr(v: ref V) -> String {
    match v {
        V.Nil => "None".to_string(),
        V.Bool(b) => if *b { "True".to_string() } else { "False".to_string() },
        V.Int(n) => f"{n}",
        V.Float(x) => float_repr(*x),
        V.Str(t) => str_repr(t),
        V.List(xs) => f"[{repr_items(xs)}]",
        V.Tuple(xs) => {
            if xs.len() == 1 {
                f"({repr(xs[0])},)"
            } else {
                f"({repr_items(xs)})"
            }
        }
    }
}

// str(v): a string is itself, everything else its repr.
fn pstr(v: ref V) -> String {
    match v {
        V.Str(t) => t.clone(),
        _ => repr(v),
    }
}

fn type_name(v: ref V) -> String {
    let t = match v {
        V.Nil => "NoneType",
        V.Bool(_) => "bool",
        V.Int(_) => "int",
        V.Float(_) => "float",
        V.Str(_) => "str",
        V.List(_) => "list",
        V.Tuple(_) => "tuple",
    };
    t.to_string()
}

// isinstance(v, Integral): bool counts.
fn is_integral(v: ref V) -> bool {
    match v {
        V.Bool(_) => true,
        V.Int(_) => true,
        _ => false,
    }
}

// isinstance(v, Real).
fn is_real(v: ref V) -> bool {
    match v {
        V.Bool(_) => true,
        V.Int(_) => true,
        V.Float(_) => true,
        _ => false,
    }
}

fn int_of(v: ref V) -> i64 {
    match v {
        V.Bool(b) => if *b { 1 } else { 0 },
        V.Int(n) => *n,
        V.Float(x) => *x as i64,
        _ => 0,
    }
}

fn num_of(v: ref V) -> f64 {
    match v {
        V.Bool(b) => if *b { 1.0 } else { 0.0 },
        V.Int(n) => *n as f64,
        V.Float(x) => *x,
        _ => 0.0,
    }
}

fn is_float(v: ref V) -> bool {
    match v {
        V.Float(_) => true,
        _ => false,
    }
}

fn text_val(v: ref V) -> String {
    match v {
        V.Str(t) => t.clone(),
        _ => String.new(),
    }
}

// Python's ==, for the values these programs compare.
fn py_eq(a: ref V, b: ref V) -> bool {
    if is_real(a) and is_real(b) {
        if is_float(a) or is_float(b) {
            return num_of(a) == num_of(b);
        }
        return int_of(a) == int_of(b);
    }
    match a {
        V.Nil => match b {
            V.Nil => true,
            _ => false,
        },
        V.Str(x) => match b {
            V.Str(y) => *x == *y,
            _ => false,
        },
        V.List(xs) => match b {
            V.List(ys) => items_eq(xs, ys),
            _ => false,
        },
        V.Tuple(xs) => match b {
            V.Tuple(ys) => items_eq(xs, ys),
            _ => false,
        },
        _ => false,
    }
}

fn items_eq(xs: ref Vec[V], ys: ref Vec[V]) -> bool {
    if xs.len() != ys.len() {
        return false;
    }
    for i in 0..xs.len() {
        if not py_eq(xs[i], ys[i]) {
            return false;
        }
    }
    true
}

// a + b and a - b on numbers: ints (and bools) stay ints.
fn num_add(a: ref V, b: ref V) -> V {
    if is_float(a) or is_float(b) {
        V.Float(num_of(a) + num_of(b))
    } else {
        V.Int(int_of(a) + int_of(b))
    }
}

fn num_sub(a: ref V, b: ref V) -> V {
    if is_float(a) or is_float(b) {
        V.Float(num_of(a) - num_of(b))
    } else {
        V.Int(int_of(a) - int_of(b))
    }
}

fn num_lt(a: ref V, b: ref V) -> bool {
    if is_float(a) or is_float(b) {
        num_of(a) < num_of(b)
    } else {
        int_of(a) < int_of(b)
    }
}

fn truthy(v: ref V) -> bool {
    match v {
        V.Nil => false,
        V.Bool(b) => *b,
        V.Int(n) => *n != 0,
        V.Float(x) => *x != 0.0,
        V.Str(t) => t.len() > 0,
        V.List(xs) => xs.len() > 0,
        V.Tuple(xs) => xs.len() > 0,
    }
}

fn int_list(xs: ref Vec[i64]) -> Vec[V] {
    let mut out: Vec[V] = Vec.new();
    for x in xs.iter() {
        out.push(V.Int(*x));
    }
    out
}

fn ints_of(v: ref V) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    match v {
        V.List(xs) => {
            for x in xs.iter() {
                out.push(int_of(x));
            }
        }
        V.Tuple(xs) => {
            for x in xs.iter() {
                out.push(int_of(x));
            }
        }
        _ => {}
    }
    out
}

// iter(v) / tuple(v): lists and tuples give their items, a string its
// characters.
fn items_of(v: ref V) -> Result[Vec[V], Exc] {
    match v {
        V.List(xs) => Ok(xs.clone()),
        V.Tuple(xs) => Ok(xs.clone()),
        V.Str(t) => {
            let mut out: Vec[V] = Vec.new();
            for c in t.chars() {
                out.push(V.Str(c.to_string()));
            }
            Ok(out)
        }
        _ => Err(exc("TypeError", f"'{type_name(v)}' object is not iterable")),
    }
}

// bytearray(v), as Message.copy() turns a new data value into one.
fn bytearray_of(v: ref V) -> Result[Vec[i64], Exc] {
    match v {
        V.Bool(_) => zeros(int_of(v)),
        V.Int(n) => zeros(*n),
        V.Str(_) => Err(exc("TypeError", "string argument without an encoding".to_string())),
        V.List(xs) => byte_items(xs),
        V.Tuple(xs) => byte_items(xs),
        _ => Err(exc("TypeError", f"cannot convert '{type_name(v)}' object to bytearray")),
    }
}

fn zeros(n: i64) -> Result[Vec[i64], Exc] {
    if n < 0 {
        return Err(exc("ValueError", "negative count".to_string()));
    }
    let mut out: Vec[i64] = Vec.new();
    for _ in 0..n {
        out.push(0);
    }
    Ok(out)
}

fn byte_items(xs: ref Vec[V]) -> Result[Vec[i64], Exc] {
    let mut out: Vec[i64] = Vec.new();
    for x in xs.iter() {
        if not is_integral(x) {
            return Err(exc("TypeError", f"'{type_name(x)}' object cannot be interpreted as an integer"));
        }
        let n = int_of(x);
        if n < 0 or n > 255 {
            return Err(exc("ValueError", "byte must be in range(0, 256)".to_string()));
        }
        out.push(n);
    }
    Ok(out)
}

// f'{byte:02X}'.
fn hex_byte(v: ref V) -> Result[String, Exc] {
    if not is_integral(v) {
        return Err(exc("ValueError", f"Unknown format code 'X' for object of type '{type_name(v)}'"));
    }
    let n = int_of(v);
    if n < 0 {
        let m = -n;
        return Ok(f"-{m:X}");
    }
    Ok(f"{n:02X}")
}

fn hex_lower(b: ref Vec[u8], sep: Str) -> String {
    let mut parts: Vec[String] = Vec.new();
    for x in b.iter() {
        parts.push(f"{x:02x}");
    }
    join(parts, sep)
}

// repr(bytearray(b)).
fn bytes_repr(b: ref Vec[u8]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for x in b.iter() {
        if *x == 39 {
            has_single = true;
        } else if *x == 34 {
            has_double = true;
        }
    }
    let quote: u8 = if has_single and not has_double { 34 } else { 39 };
    let mut out = String.new();
    out.push_str("bytearray(b");
    out.push(quote as char);
    for x in b.iter() {
        let c = *x;
        if c == 39 or c == 92 {
            out.push('\\');
            out.push(c as char);
        } else if c == 9 {
            out.push_str("\\t");
        } else if c == 10 {
            out.push_str("\\n");
        } else if c == 13 {
            out.push_str("\\r");
        } else if c < 32 or c >= 127 {
            out.push_str(f"\\x{c:02x}");
        } else {
            out.push(c as char);
        }
    }
    out.push(quote as char);
    out.push(')');
    out
}

fn hexdump(b: ref Vec[u8], indent: Str) {
    let mut i = 0;
    while i < b.len() {
        let mut chunk: Vec[u8] = Vec.new();
        let mut j = i;
        while j < i + 16 and j < b.len() {
            chunk.push(b[j]);
            j += 1;
        }
        println(f"{indent}{i:04x}: {hex_lower(chunk, " ")}");
        i += 16;
    }
}

// float(text): whitespace around it, underscores only between digits,
// and inf / nan spelled any way.
fn py_float(t: ref String) -> Option[f64] {
    let all = chars(t);
    let mut lo = 0;
    let mut hi = all.len();
    while lo < hi and is_py_space(all[lo]) {
        lo += 1;
    }
    while hi > lo and is_py_space(all[hi - 1]) {
        hi -= 1;
    }
    let v: Vec[char] = from_chars(all, lo, hi).chars().collect();
    let mut clean = String.new();
    for i in 0..v.len() {
        if v[i] == '_' {
            if i == 0 or i + 1 >= v.len() or not is_dig(v[i - 1]) or not is_dig(v[i + 1]) {
                return None;
            }
        } else {
            clean.push(v[i]);
        }
    }
    let low = clean.to_lowercase();
    let neg = low.starts_with("-");
    let body = if low.starts_with("+") or neg { slice(low, 1, low.len()) } else { low.clone() };
    if body == "inf" or body == "infinity" or body == "nan" {
        let x = if body == "nan" { f64.NAN } else { 1.0 / 0.0 };
        return Some(if neg { -x } else { x });
    }
    let b = chars(body);
    let mut i = 0;
    let mut digits = 0;
    while i < b.len() and is_dig(b[i]) {
        i += 1;
        digits += 1;
    }
    if i < b.len() and b[i] == '.' {
        i += 1;
        while i < b.len() and is_dig(b[i]) {
            i += 1;
            digits += 1;
        }
    }
    if digits == 0 {
        return None;
    }
    if i < b.len() and b[i] == 'e' {
        i += 1;
        if i < b.len() and (b[i] == '+' or b[i] == '-') {
            i += 1;
        }
        let start = i;
        while i < b.len() and is_dig(b[i]) {
            i += 1;
        }
        if i == start {
            return None;
        }
    }
    if i != b.len() {
        return None;
    }
    match f64.parse(clean) {
        Ok(x) => Some(x),
        Err(_) => None,
    }
}

// round(x) for a float: halves go to the even neighbour.
fn py_round(x: f64) -> i64 {
    let f = x.floor();
    let d = x - f;
    let n = f as i64;
    if d > 0.5 {
        n + 1
    } else if d < 0.5 {
        n
    } else if n % 2 == 0 {
        n
    } else {
        n + 1
    }
}

// str.split() with no separator.
fn split_ws(t: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    let mut in_word = false;
    for c in t.chars() {
        if is_py_space(c) {
            if in_word {
                out.push(cur.clone());
                cur = String.new();
                in_word = false;
            }
        } else {
            cur.push(c);
            in_word = true;
        }
    }
    if in_word {
        out.push(cur);
    }
    out
}

fn py_strip(t: ref String) -> String {
    let cs = chars(t);
    let mut lo = 0;
    let mut hi = cs.len();
    while lo < hi and is_py_space(cs[lo]) {
        lo += 1;
    }
    while hi > lo and is_py_space(cs[hi - 1]) {
        hi -= 1;
    }
    from_chars(cs, lo, hi)
}

// The first index of `sep` in t (by characters), or -1.
fn find_str(t: ref String, sep: Str) -> i64 {
    let cs = chars(t);
    let ss: Vec[char] = sep.chars().collect();
    if ss.len() == 0 {
        return 0;
    }
    let mut i = 0;
    while i + ss.len() <= cs.len() {
        let mut ok = true;
        for k in 0..ss.len() {
            if cs[i + k] != ss[k] {
                ok = false;
                break;
            }
        }
        if ok {
            return i;
        }
        i += 1;
    }
    -1
}

fn replace_all(t: ref String, from: ref String, to: ref String) -> String {
    if from.len() == 0 {
        return t.clone();
    }
    let cs = chars(t);
    let fs: Vec[char] = from.chars().collect();
    let mut out = String.new();
    let mut i = 0;
    while i < cs.len() {
        let mut ok = i + fs.len() <= cs.len();
        if ok {
            for k in 0..fs.len() {
                if cs[i + k] != fs[k] {
                    ok = false;
                    break;
                }
            }
        }
        if ok {
            out.push_str(to);
            i += fs.len();
        } else {
            out.push(cs[i]);
            i += 1;
        }
    }
    out
}

fn split_on(t: ref String, sep: char) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in t.chars() {
        if c == sep {
            out.push(cur.clone());
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn bool_str(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}
// ------------------------------------------------------------ specs
// messages/specs.py: one entry for each message type. A length of -1 is
// sysex's float('inf').

#[derive(Clone)]
struct Spec {
    status: i64,
    kind: String,
    names: Vec[String],
    length: i64,
}

fn spec(status: i64, kind: Str, names: Vec[Str], length: i64) -> Spec {
    let mut ns: Vec[String] = Vec.new();
    for n in names.iter() {
        ns.push(n.to_string());
    }
    Spec { status: status, kind: kind.to_string(), names: ns, length: length }
}

fn all_specs() -> Vec[Spec] {
    let mut v: Vec[Spec] = Vec.new();
    v.push(spec(0x80, "note_off", vec!["channel", "note", "velocity"], 3));
    v.push(spec(0x90, "note_on", vec!["channel", "note", "velocity"], 3));
    v.push(spec(0xa0, "polytouch", vec!["channel", "note", "value"], 3));
    v.push(spec(0xb0, "control_change", vec!["channel", "control", "value"], 3));
    v.push(spec(0xc0, "program_change", vec!["channel", "program"], 2));
    v.push(spec(0xd0, "aftertouch", vec!["channel", "value"], 2));
    v.push(spec(0xe0, "pitchwheel", vec!["channel", "pitch"], 3));
    v.push(spec(0xf0, "sysex", vec!["data"], -1));
    v.push(spec(0xf1, "quarter_frame", vec!["frame_type", "frame_value"], 2));
    v.push(spec(0xf2, "songpos", vec!["pos"], 3));
    v.push(spec(0xf3, "song_select", vec!["song"], 2));
    v.push(spec(0xf6, "tune_request", Vec.new(), 1));
    v.push(spec(0xf8, "clock", Vec.new(), 1));
    v.push(spec(0xfa, "start", Vec.new(), 1));
    v.push(spec(0xfb, "continue", Vec.new(), 1));
    v.push(spec(0xfc, "stop", Vec.new(), 1));
    v.push(spec(0xfe, "active_sensing", Vec.new(), 1));
    v.push(spec(0xff, "reset", Vec.new(), 1));
    v
}

fn spec_by_type(t: ref String) -> Option[Spec] {
    for s in all_specs().into_iter() {
        if s.kind == *t {
            return Some(s);
        }
    }
    None
}

fn is_channel_status(b: i64) -> bool {
    b >= 0x80 and b < 0xf0
}

// SPEC_BY_STATUS: a channel message is found under all sixteen of its
// status bytes.
fn spec_by_status(b: i64) -> Option[Spec] {
    let key = if is_channel_status(b) { b & 0xf0 } else { b };
    for s in all_specs().into_iter() {
        if s.status == key {
            return Some(s);
        }
    }
    None
}

fn is_realtime_type(t: ref String) -> bool {
    *t == "tune_request" or *t == "clock" or *t == "start" or *t == "continue" or *t == "stop"
}

fn default_value(name: ref String) -> V {
    if *name == "data" {
        V.Tuple(Vec.new())
    } else if *name == "velocity" {
        V.Int(64)
    } else {
        V.Int(0)
    }
}

// ------------------------------------------------------------ messages

// A message's attributes, in the order vars(msg) holds them.
#[derive(Clone)]
struct Attr {
    name: String,
    val: V,
}

#[derive(Clone, PartialEq)]
enum Cls {
    Plain,
    Meta,
    Unknown,
}

#[derive(Clone)]
struct Msg {
    cls: Cls,
    frozen: bool,
    vars: Vec[Attr],
}

fn attr(name: Str, val: own V) -> Attr {
    Attr { name: name.to_string(), val: val }
}

fn get_var(vars: ref Vec[Attr], name: Str) -> Option[V] {
    for a in vars.iter() {
        if a.name == name {
            return Some(a.val.clone());
        }
    }
    None
}

fn has_var(vars: ref Vec[Attr], name: ref String) -> bool {
    for a in vars.iter() {
        if a.name == *name {
            return true;
        }
    }
    false
}

// dict.update with one key: it keeps its place and takes the new value.
fn put_var(vars: mut ref Vec[Attr], name: ref String, val: own V) {
    let mut i = 0;
    while i < vars.len() {
        if vars[i].name == *name {
            vars[i].val = val;
            return;
        }
        i += 1;
    }
    vars.push(Attr { name: name.clone(), val: val });
}

fn var_of(m: ref Msg, name: Str) -> V {
    get_var(m.vars, name).unwrap_or(V.Nil)
}

fn msg_type(m: ref Msg) -> String {
    text_val(var_of(m, "type"))
}

fn names_has(names: ref Vec[String], name: ref String) -> bool {
    for n in names.iter() {
        if *n == *name {
            return true;
        }
    }
    false
}

// ------------------------------------------------------------ checks

fn check_channel(v: ref V) -> Result[(), Exc] {
    if not is_integral(v) {
        return Err(exc("TypeError", "channel must be int".to_string()));
    }
    let n = int_of(v);
    if n < 0 or n > 15 {
        return Err(exc("ValueError", "channel must be in range 0..15".to_string()));
    }
    Ok(())
}

fn check_pos(v: ref V) -> Result[(), Exc] {
    if not is_integral(v) {
        return Err(exc("TypeError", "song pos must be int".to_string()));
    }
    let n = int_of(v);
    if n < 0 or n > 16383 {
        return Err(exc("ValueError", "song pos must be in range 0..16383".to_string()));
    }
    Ok(())
}

fn check_pitch(v: ref V) -> Result[(), Exc] {
    if not is_integral(v) {
        return Err(exc("TypeError", "pichwheel value must be int".to_string()));
    }
    let n = int_of(v);
    if n < -8192 or n > 8191 {
        return Err(exc("ValueError", "pitchwheel value must be in range -8192..8191".to_string()));
    }
    Ok(())
}

fn check_data(v: ref V) -> Result[(), Exc] {
    for b in items_of(v)? {
        check_data_byte(b)?;
    }
    Ok(())
}

fn check_range(v: ref V, what: Str, hi: i64) -> Result[(), Exc] {
    if not is_integral(v) {
        return Err(exc("TypeError", f"{what} must be int"));
    }
    let n = int_of(v);
    if n < 0 or n > hi {
        return Err(exc("ValueError", f"{what} must be in range 0..{hi}"));
    }
    Ok(())
}

fn check_data_byte(v: ref V) -> Result[(), Exc] {
    check_range(v, "data byte", 127)
}

fn check_time(v: ref V) -> Result[(), Exc] {
    if not is_real(v) {
        return Err(exc("TypeError", "time must be int or float".to_string()));
    }
    Ok(())
}

fn check_value(name: ref String, v: ref V) -> Result[(), Exc] {
    let n = name.as_str();
    if n == "channel" {
        check_channel(v)
    } else if n == "control" or n == "note" or n == "program" or n == "song" or n == "value" or n == "velocity" {
        check_data_byte(v)
    } else if n == "data" {
        check_data(v)
    } else if n == "frame_type" {
        check_range(v, "frame_type", 7)
    } else if n == "frame_value" {
        check_range(v, "frame_value", 15)
    } else if n == "pitch" {
        check_pitch(v)
    } else if n == "pos" {
        check_pos(v)
    } else if n == "time" {
        check_time(v)
    } else if n == "type" {
        let ok = match v {
            V.Str(t) => spec_by_type(t).is_some(),
            _ => false,
        };
        if ok {
            Ok(())
        } else {
            Err(exc("ValueError", f"invalid message type {repr(v)}"))
        }
    } else {
        Err(exc("KeyError", str_repr(name)))
    }
}

fn check_msgdict(vars: ref Vec[Attr]) -> Result[(), Exc] {
    let t = text_val(get_var(vars, "type").unwrap_or(V.Nil));
    let sp = match spec_by_type(t) {
        Some(s) => s,
        None => return Err(exc("ValueError", f"unknown message type {str_repr(t)}")),
    };
    for a in vars.iter() {
        if a.name != "type" and a.name != "time" and not names_has(sp.names, a.name) {
            return Err(exc("ValueError", f"{sp.kind} message has no attribute {a.name}"));
        }
        check_value(a.name, a.val)?;
    }
    Ok(())
}

fn make_msgdict(t: ref String, overrides: ref Vec[Attr]) -> Result[Vec[Attr], Exc] {
    let sp = match spec_by_type(t) {
        Some(s) => s,
        None => return Err(exc("LookupError", f"Unknown message type {str_repr(t)}")),
    };
    let mut vars: Vec[Attr] = Vec.new();
    vars.push(attr("type", V.Str(t.clone())));
    vars.push(attr("time", V.Int(0)));
    for n in sp.names.iter() {
        vars.push(Attr { name: n.clone(), val: default_value(n) });
    }
    for o in overrides.iter() {
        put_var(mut vars, o.name, o.val.clone());
    }
    Ok(vars)
}

// Message(type, skip_checks=skip, **kw).
fn new_message(t: ref String, kw: ref Vec[Attr], skip: bool) -> Result[Msg, Exc] {
    let mut vars = make_msgdict(t, kw)?;
    if *t == "sysex" {
        let d = items_of(var_of_vars(vars, "data"))?;
        put_var(mut vars, "data".to_string(), V.Tuple(d));
    }
    if not skip {
        check_msgdict(vars)?;
    }
    Ok(Msg { cls: Cls.Plain, frozen: false, vars: vars })
}

fn var_of_vars(vars: ref Vec[Attr], name: Str) -> V {
    get_var(vars, name).unwrap_or(V.Nil)
}

// ------------------------------------------------------------ encode

fn encode_message(vars: ref Vec[Attr]) -> Vec[V] {
    let t = text_val(var_of_vars(vars, "type"));
    let ch = int_of(var_of_vars(vars, "channel"));
    let mut out: Vec[V] = Vec.new();
    if t == "pitchwheel" {
        let p = int_of(var_of_vars(vars, "pitch")) + 8192;
        out.push(V.Int(0xe0 | ch));
        out.push(V.Int(p & 0x7f));
        out.push(V.Int(p >> 7));
    } else if t == "sysex" {
        out.push(V.Int(0xf0));
        match items_of(var_of_vars(vars, "data")) {
            Ok(xs) => {
                for x in xs.into_iter() {
                    out.push(x);
                }
            }
            Err(_) => {}
        }
        out.push(V.Int(0xf7));
    } else if t == "quarter_frame" {
        let ft = int_of(var_of_vars(vars, "frame_type"));
        let fv = int_of(var_of_vars(vars, "frame_value"));
        out.push(V.Int(0xf1));
        out.push(V.Int((ft << 4) | fv));
    } else if t == "songpos" {
        let p = int_of(var_of_vars(vars, "pos"));
        out.push(V.Int(0xf2));
        out.push(V.Int(p & 0x7f));
        out.push(V.Int(p >> 7));
    } else {
        let sp = spec_by_type(t).unwrap();
        let status = if is_channel_status(sp.status) { sp.status | ch } else { sp.status };
        out.push(V.Int(status));
        for n in sp.names.iter() {
            if *n != "channel" {
                out.push(var_of_vars(vars, n.as_str()));
            }
        }
    }
    out
}

// ------------------------------------------------------------ decode

fn decode_message(b: ref Vec[i64], time: ref V) -> Result[Vec[Attr], Exc] {
    if b.len() == 0 {
        return Err(exc("ValueError", "message is 0 bytes long".to_string()));
    }
    let status = b[0];
    let mut data: Vec[i64] = Vec.new();
    for i in 1..b.len() {
        data.push(b[i]);
    }
    let sp = match spec_by_status(status) {
        Some(s) => s,
        None => return Err(exc("ValueError", f"invalid status byte {status}")),
    };
    let mut vars: Vec[Attr] = Vec.new();
    vars.push(Attr { name: "type".to_string(), val: V.Str(sp.kind.clone()) });
    vars.push(Attr { name: "time".to_string(), val: time.clone() });
    if status == 0xf0 {
        if data.len() < 1 {
            return Err(exc("ValueError", "sysex without end byte".to_string()));
        }
        let end = data[data.len() - 1];
        data.pop();
        if end != 0xf7 {
            return Err(exc("ValueError", f"invalid sysex end byte {end}"));
        }
    }
    for x in data.iter() {
        if *x < 0 or *x > 127 {
            return Err(exc("ValueError", "data byte must be in range 0..127".to_string()));
        }
    }
    let special = (status >= 0xe0 and status <= 0xef) or status == 0xf0 or status == 0xf1 or status == 0xf2;
    if special {
        if is_channel_status(status) {
            vars.push(attr("channel", V.Int(status & 0x0f)));
        }
        if status == 0xf0 {
            vars.push(attr("data", V.Tuple(int_list(data))));
        } else if status == 0xf1 {
            if data.len() < 1 {
                return Err(exc("IndexError", "list index out of range".to_string()));
            }
            vars.push(attr("frame_type", V.Int(data[0] >> 4)));
            vars.push(attr("frame_value", V.Int(data[0] & 15)));
        } else {
            if data.len() < 2 {
                return Err(exc("IndexError", "list index out of range".to_string()));
            }
            if status == 0xf2 {
                vars.push(attr("pos", V.Int(data[0] | (data[1] << 7))));
            } else {
                vars.push(attr("pitch", V.Int(data[0] | ((data[1] << 7) + -8192))));
            }
        }
        return Ok(vars);
    }
    if data.len() != sp.length - 1 {
        return Err(exc("ValueError", f"wrong number of bytes for {sp.kind} message"));
    }
    let mut k = 0;
    for n in sp.names.iter() {
        if *n != "channel" {
            vars.push(Attr { name: n.clone(), val: V.Int(data[k]) });
            k += 1;
        }
    }
    if is_channel_status(status) {
        vars.push(attr("channel", V.Int(status & 0x0f)));
    }
    Ok(vars)
}

fn from_bytes(b: ref Vec[i64], time: ref V) -> Result[Msg, Exc] {
    let vars = decode_message(b, time)?;
    Ok(Msg { cls: Cls.Plain, frozen: false, vars: vars })
}

// bytearray.fromhex(text), with its error positions.
fn fromhex(t: ref String) -> Result[Vec[i64], Exc] {
    let cs = chars(t);
    for i in 0..cs.len() {
        if cs[i] as i64 > 127 {
            return Err(fromhex_error(i));
        }
    }
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < cs.len() {
        if is_ascii_space(cs[i]) {
            while i < cs.len() and is_ascii_space(cs[i]) {
                i += 1;
            }
            if i >= cs.len() {
                break;
            }
        }
        let top = hex_digit(cs[i]);
        if top < 0 {
            return Err(fromhex_error(i));
        }
        let bot = if i + 1 < cs.len() { hex_digit(cs[i + 1]) } else { -1 };
        if bot < 0 {
            return Err(fromhex_error(i + 1));
        }
        out.push(top * 16 + bot);
        i += 2;
    }
    Ok(out)
}

fn fromhex_error(i: i64) -> Exc {
    exc("ValueError", f"non-hexadecimal number found in fromhex() arg at position {i}")
}

fn is_ascii_space(c: char) -> bool {
    c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == '\u{b}' or c == '\u{c}'
}

fn hex_digit(c: char) -> i64 {
    if c >= '0' and c <= '9' {
        c as i64 - 48
    } else if c >= 'a' and c <= 'f' {
        c as i64 - 87
    } else if c >= 'A' and c <= 'F' {
        c as i64 - 55
    } else {
        -1
    }
}

// re.sub(r'\s', ' ', text).
fn spaces_for_ws(t: ref String) -> String {
    let mut out = String.new();
    for c in t.chars() {
        if is_py_space(c) {
            out.push(' ');
        } else {
            out.push(c);
        }
    }
    out
}

fn from_hex(t: ref String, sep: ref Option[String]) -> Result[Msg, Exc] {
    let mut text = spaces_for_ws(t);
    if let Some(s) = sep {
        let mut pad = String.new();
        for _ in s.chars() {
            pad.push(' ');
        }
        text = replace_all(text, s, pad);
    }
    let b = fromhex(text)?;
    from_bytes(b, V.Int(0))
}

// ------------------------------------------------------------ strings

fn msg2str(vars: ref Vec[Attr], include_time: bool) -> String {
    let t = text_val(var_of_vars(vars, "type"));
    let sp = spec_by_type(t).unwrap();
    let mut words: Vec[String] = Vec.new();
    words.push(t.clone());
    for n in sp.names.iter() {
        let v = var_of_vars(vars, n.as_str());
        if *n == "data" {
            let mut parts: Vec[String] = Vec.new();
            match items_of(v) {
                Ok(xs) => {
                    for x in xs.iter() {
                        parts.push(pstr(x));
                    }
                }
                Err(_) => {}
            }
            words.push(f"{n}=({join(parts, ",")})");
        } else {
            words.push(f"{n}={pstr(v)}");
        }
    }
    if include_time {
        words.push(f"time={pstr(var_of_vars(vars, "time"))}");
    }
    join(words, " ")
}

fn parse_time(t: ref String) -> Result[V, Exc] {
    if let Some(n) = parse_py_int(t) {
        return Ok(V.Int(n));
    }
    if let Some(x) = py_float(t) {
        return Ok(V.Float(x));
    }
    Err(exc("ValueError", f"invalid time {str_repr(t)}"))
}

fn parse_data(t: ref String) -> Result[V, Exc] {
    if not t.starts_with("(") and t.ends_with(")") {
        return Err(exc("ValueError", "missing parentheses in data message".to_string()));
    }
    let cs = chars(t);
    let inner = from_chars(cs, 1, cs.len() - 1);
    let mut out: Vec[V] = Vec.new();
    for part in split_on(inner, ',') {
        match parse_py_int(part) {
            Some(n) => out.push(V.Int(n)),
            None => return Err(exc("ValueError", "unable to parse data bytes".to_string())),
        }
    }
    Ok(V.List(out))
}

// str2msg(text): the type and the message dict.
fn str2msg(text: ref String) -> Result[Vec[Attr], Exc] {
    let words = split_ws(text);
    if words.len() == 0 {
        return Err(exc("IndexError", "list index out of range".to_string()));
    }
    let mut args: Vec[Attr] = Vec.new();
    for i in 1..words.len() {
        let w = words[i].clone();
        let at = find_str(w, "=");
        if at < 0 {
            return Err(exc("ValueError", "not enough values to unpack (expected 2, got 1)".to_string()));
        }
        let cs = chars(w);
        let name = from_chars(cs, 0, at);
        let value = from_chars(cs, at + 1, cs.len());
        let v = if name == "time" {
            parse_time(value)?
        } else if name == "data" {
            parse_data(value)?
        } else {
            match parse_py_int(value) {
                Some(n) => V.Int(n),
                None => return Err(exc("ValueError", f"invalid literal for int() with base 10: {str_repr(value)}")),
            }
        };
        put_var(mut args, name, v);
    }
    make_msgdict(words[0], args)
}

// Message(**msgdict): the type is the positional argument, the rest are
// keyword arguments.
fn message_from_dict(vars: ref Vec[Attr], skip: bool) -> Result[Msg, Exc] {
    let t = text_val(var_of_vars(vars, "type"));
    let mut kw: Vec[Attr] = Vec.new();
    for a in vars.iter() {
        if a.name != "type" {
            kw.push(a.clone());
        }
    }
    new_message(t, kw, skip)
}

fn from_str(text: ref String) -> Result[Msg, Exc] {
    let d = str2msg(text)?;
    message_from_dict(d, false)
}

// ------------------------------------------------------------ behaviour

fn class_name(m: ref Msg) -> String {
    let base = match m.cls {
        Cls.Plain => "Message",
        Cls.Meta => "MetaMessage",
        Cls.Unknown => "UnknownMetaMessage",
    };
    if m.frozen { f"Frozen{base}" } else { base.to_string() }
}

fn value_names(m: ref Msg) -> Vec[String] {
    let t = msg_type(m);
    let mut out: Vec[String] = Vec.new();
    if m.cls == Cls.Plain {
        out = spec_by_type(t).unwrap().names;
    } else {
        match meta_spec_by_type(t) {
            Some(s) => {
                out = s.attrs;
            }
            None => {}
        }
    }
    out.push("time".to_string());
    out
}

fn msg_repr(m: ref Msg) -> String {
    if m.cls == Cls.Unknown {
        let body = f"UnknownMetaMessage(type_byte={pstr(var_of(m, "type_byte"))}, data={pstr(var_of(m, "data"))}, time={pstr(var_of(m, "time"))})";
        return if m.frozen { f"Frozen{body}" } else { body };
    }
    let mut items: Vec[String] = Vec.new();
    items.push(str_repr(msg_type(m)));
    for n in value_names(m) {
        items.push(f"{n}={repr(var_of(m, n.as_str()))}");
    }
    f"{class_name(m)}({join(items, ", ")})"
}

fn msg_str(m: ref Msg) -> String {
    if m.cls == Cls.Plain {
        msg2str(m.vars, true)
    } else {
        msg_repr(m)
    }
}

fn msg_len(m: ref Msg) -> Result[i64, Exc] {
    if m.cls != Cls.Plain {
        return Err(exc("TypeError", f"object of type '{class_name(m)}' has no len()"));
    }
    let t = msg_type(m);
    if t == "sysex" {
        return Ok(2 + items_of(var_of(m, "data"))?.len());
    }
    Ok(spec_by_type(t).unwrap().length)
}

fn msg_dict(m: ref Msg) -> String {
    let mut parts: Vec[String] = Vec.new();
    let sysex = msg_type(m) == "sysex";
    for a in m.vars.iter() {
        let v = if sysex and a.name == "data" {
            match items_of(a.val) {
                Ok(xs) => V.List(xs),
                Err(_) => a.val.clone(),
            }
        } else {
            a.val.clone()
        };
        parts.push(f"{str_repr(a.name)}: {repr(v)}");
    }
    f"{{{join(parts, ", ")}}}"
}

// msg.bytes(), in the charset meta text is encoded with.
fn msg_bytes(m: ref Msg, charset: ref String) -> Result[Vec[V], Exc] {
    match m.cls {
        Cls.Plain => Ok(encode_message(m.vars)),
        Cls.Meta => meta_bytes(m, charset),
        Cls.Unknown => {
            let data = items_of(var_of(m, "data"))?;
            let mut out: Vec[V] = Vec.new();
            out.push(V.Int(0xff));
            out.push(var_of(m, "type_byte"));
            for x in encode_variable_int(V.Int(data.len()))? {
                out.push(V.Int(x));
            }
            for x in data.into_iter() {
                out.push(x);
            }
            Ok(out)
        }
    }
}

fn msg_hex(m: ref Msg, sep: ref String) -> Result[String, Exc] {
    let mut parts: Vec[String] = Vec.new();
    for b in msg_bytes(m, "latin1".to_string())? {
        parts.push(hex_byte(b)?);
    }
    Ok(join(parts, sep.as_str()))
}

fn bytes_of(xs: ref Vec[V]) -> Result[Vec[u8], Exc] {
    let mut out: Vec[u8] = Vec.new();
    for n in byte_items(xs)? {
        out.push(n as u8);
    }
    Ok(out)
}

fn msg_bin(m: ref Msg) -> Result[Vec[u8], Exc] {
    bytes_of(msg_bytes(m, "latin1".to_string())?)
}

fn is_meta(m: ref Msg) -> bool {
    m.cls != Cls.Plain
}

fn is_realtime(m: ref Msg) -> bool {
    is_realtime_type(msg_type(m))
}

fn vars_eq(a: ref Vec[Attr], b: ref Vec[Attr]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for x in a.iter() {
        match get_var(b, x.name.as_str()) {
            Some(y) => {
                if not py_eq(x.val, y) {
                    return false;
                }
            }
            None => return false,
        }
    }
    true
}

fn msg_eq(a: ref Msg, b: ref Msg) -> bool {
    vars_eq(a.vars, b.vars)
}

// setattr(msg, name, value).
fn set_attr(m: mut ref Msg, name: ref String, v: ref V) -> Result[(), Exc] {
    if m.frozen {
        return Err(exc("ValueError", "frozen message is immutable".to_string()));
    }
    match m.cls {
        Cls.Plain => {
            if *name == "type" {
                return Err(exc("AttributeError", "type attribute is read only".to_string()));
            }
            if not has_var(m.vars, name) {
                return Err(exc("AttributeError", f"{msg_type(m)} message has no attribute {name}"));
            }
            check_value(name, v)?;
            if *name == "data" {
                let d = items_of(v)?;
                put_var(mut m.vars, name, V.Tuple(d));
            } else {
                put_var(mut m.vars, name, v.clone());
            }
            Ok(())
        }
        Cls.Meta => meta_setattr(mut m, name, v),
        Cls.Unknown => {
            put_var(mut m.vars, name, v.clone());
            Ok(())
        }
    }
}

fn find_attr(kw: ref Vec[Attr], name: Str) -> Option[V] {
    get_var(kw, name)
}

// msg.copy(**overrides). `skip` is the skip_checks keyword: for Message
// it is a parameter of copy() itself, while for meta messages it is one
// more override.
fn msg_copy(m: ref Msg, overrides: ref Vec[Attr], skip: ref Option[bool]) -> Result[Msg, Exc] {
    let empty = overrides.len() == 0 and (m.cls == Cls.Plain or skip.is_none());
    if empty {
        return Ok(m.clone());
    }
    if let Some(t) = find_attr(overrides, "type") {
        if not py_eq(t, var_of(m, "type")) {
            return Err(exc("ValueError", "copy must be same message type".to_string()));
        }
    }
    let skip_checks = skip.unwrap_or(false);
    match m.cls {
        Cls.Plain => {
            let mut d = m.vars.clone();
            for o in overrides.iter() {
                if o.name == "data" {
                    let b = bytearray_of(o.val)?;
                    put_var(mut d, o.name, V.List(int_list(b)));
                } else {
                    put_var(mut d, o.name, o.val.clone());
                }
            }
            if not skip_checks {
                check_msgdict(d)?;
            }
            let mut out = message_from_dict(d, skip_checks)?;
            out.frozen = m.frozen;
            Ok(out)
        }
        Cls.Meta => {
            let mut d = m.vars.clone();
            for o in overrides.iter() {
                put_var(mut d, o.name, o.val.clone());
            }
            let t = text_val(var_of_vars(d, "type"));
            let mut kw: Vec[Attr] = Vec.new();
            for a in d.iter() {
                if a.name != "type" {
                    kw.push(a.clone());
                }
            }
            let mut out = new_meta(t, kw, skip_checks)?;
            out.frozen = m.frozen;
            Ok(out)
        }
        Cls.Unknown => {
            let mut d = m.vars.clone();
            for o in overrides.iter() {
                put_var(mut d, o.name, o.val.clone());
            }
            let mut out = new_unknown(var_of_vars(d, "type_byte"), var_of_vars(d, "data"), var_of_vars(d, "time"), var_of_vars(d, "type"))?;
            out.frozen = m.frozen;
            Ok(out)
        }
    }
}

// msg.copy(time=t) with skip_checks given, as the track functions call it.
fn copy_time(m: ref Msg, t: ref V, skip: bool) -> Result[Msg, Exc] {
    let mut o: Vec[Attr] = Vec.new();
    o.push(Attr { name: "time".to_string(), val: t.clone() });
    msg_copy(m, o, Some(skip))
}

fn new_unknown(type_byte: ref V, data: ref V, time: ref V, kind: ref V) -> Result[Msg, Exc] {
    let d = match data {
        V.Nil => Vec.new(),
        _ => items_of(data)?,
    };
    let mut vars: Vec[Attr] = Vec.new();
    vars.push(Attr { name: "type".to_string(), val: kind.clone() });
    vars.push(Attr { name: "type_byte".to_string(), val: type_byte.clone() });
    vars.push(Attr { name: "data".to_string(), val: V.Tuple(d) });
    vars.push(Attr { name: "time".to_string(), val: time.clone() });
    Ok(Msg { cls: Cls.Unknown, frozen: false, vars: vars })
}

fn freeze(m: ref Msg) -> Msg {
    let mut out = m.clone();
    out.frozen = true;
    out
}

fn thaw(m: ref Msg) -> Msg {
    let mut out = m.clone();
    out.frozen = false;
    out
}
// ------------------------------------------------------------ meta specs
// midifiles/meta.py: the meta message kinds a MIDI file can hold.

#[derive(Clone)]
struct MSpec {
    byte: i64,
    kind: String,
    attrs: Vec[String],
    defaults: Vec[V],
}

fn mspec(byte: i64, kind: Str, attrs: Vec[Str], defaults: own Vec[V]) -> MSpec {
    let mut a: Vec[String] = Vec.new();
    for x in attrs.iter() {
        a.push(x.to_string());
    }
    MSpec { byte: byte, kind: kind.to_string(), attrs: a, defaults: defaults }
}

fn text_spec(byte: i64, kind: Str, attr_name: Str) -> MSpec {
    let mut d: Vec[V] = Vec.new();
    d.push(V.Str(String.new()));
    mspec(byte, kind, vec![attr_name], d)
}

fn int_defaults(xs: Vec[i64]) -> Vec[V] {
    int_list(xs)
}

fn all_meta_specs() -> Vec[MSpec] {
    let mut v: Vec[MSpec] = Vec.new();
    v.push(mspec(0x00, "sequence_number", vec!["number"], int_defaults(vec![0])));
    v.push(text_spec(0x01, "text", "text"));
    v.push(text_spec(0x02, "copyright", "text"));
    v.push(text_spec(0x03, "track_name", "name"));
    v.push(text_spec(0x04, "instrument_name", "name"));
    v.push(text_spec(0x05, "lyrics", "text"));
    v.push(text_spec(0x06, "marker", "text"));
    v.push(text_spec(0x07, "cue_marker", "text"));
    v.push(text_spec(0x09, "device_name", "name"));
    v.push(mspec(0x20, "channel_prefix", vec!["channel"], int_defaults(vec![0])));
    v.push(mspec(0x21, "midi_port", vec!["port"], int_defaults(vec![0])));
    v.push(mspec(0x2f, "end_of_track", Vec.new(), Vec.new()));
    v.push(mspec(0x51, "set_tempo", vec!["tempo"], int_defaults(vec![500000])));
    v.push(mspec(0x54, "smpte_offset", vec!["frame_rate", "hours", "minutes", "seconds", "frames", "sub_frames"],
        int_defaults(vec![24, 0, 0, 0, 0, 0])));
    v.push(mspec(0x58, "time_signature", vec!["numerator", "denominator", "clocks_per_click", "notated_32nd_notes_per_beat"],
        int_defaults(vec![4, 4, 24, 8])));
    let mut kd: Vec[V] = Vec.new();
    kd.push(V.Str("C".to_string()));
    v.push(mspec(0x59, "key_signature", vec!["key"], kd));
    let mut sd: Vec[V] = Vec.new();
    sd.push(V.List(Vec.new()));
    v.push(mspec(0x7f, "sequencer_specific", vec!["data"], sd));
    v
}

fn meta_spec_by_type(t: ref String) -> Option[MSpec] {
    for s in all_meta_specs().into_iter() {
        if s.kind == *t {
            return Some(s);
        }
    }
    None
}

fn meta_spec_by_byte(b: i64) -> Option[MSpec] {
    for s in all_meta_specs().into_iter() {
        if s.byte == b {
            return Some(s);
        }
    }
    None
}

fn is_text_kind(k: ref String) -> bool {
    *k == "text" or *k == "copyright" or *k == "track_name" or *k == "instrument_name" or *k == "lyrics"
        or *k == "marker" or *k == "cue_marker" or *k == "device_name"
}

// The keys of _key_signature_decode, in its order: (sharps or -flats,
// mode) and the key letter.
struct KeySig {
    key: i64,
    mode: i64,
    name: String,
}

fn key_table() -> Vec[KeySig] {
    let major = vec!["Cb", "Gb", "Db", "Ab", "Eb", "Bb", "F", "C", "G", "D", "A", "E", "B", "F#", "C#"];
    let minor = vec!["Abm", "Ebm", "Bbm", "Fm", "Cm", "Gm", "Dm", "Am", "Em", "Bm", "F#m", "C#m", "G#m", "D#m", "A#m"];
    let mut v: Vec[KeySig] = Vec.new();
    for i in 0..15 {
        v.push(KeySig { key: i - 7, mode: 0, name: major[i].to_string() });
    }
    for i in 0..15 {
        v.push(KeySig { key: i - 7, mode: 1, name: minor[i].to_string() });
    }
    v
}

fn smpte_rates() -> Vec[V] {
    let mut v: Vec[V] = Vec.new();
    v.push(V.Int(24));
    v.push(V.Int(25));
    v.push(V.Float(29.97));
    v.push(V.Int(30));
    v
}

// ------------------------------------------------------------ meta checks

fn check_int(v: ref V, lo: i64, hi: i64) -> Result[(), Exc] {
    if not is_integral(v) {
        return Err(exc("TypeError", "attribute must be an integer".to_string()));
    }
    let n = int_of(v);
    if n < lo or n > hi {
        return Err(exc("ValueError", f"attribute must be in range {lo}..{hi}"));
    }
    Ok(())
}

fn is_hashable(v: ref V) -> bool {
    match v {
        V.List(_) => false,
        V.Tuple(xs) => {
            for x in xs.iter() {
                if not is_hashable(x) {
                    return false;
                }
            }
            true
        }
        _ => true,
    }
}

fn unhashable(v: ref V) -> Exc {
    exc("TypeError", f"unhashable type: '{type_name(v)}'")
}

fn meta_check(kind: ref String, name: ref String, v: ref V) -> Result[(), Exc] {
    if *kind == "sequence_number" {
        return check_int(v, 0, 0xffff);
    }
    if is_text_kind(kind) {
        return match v {
            V.Str(_) => Ok(()),
            _ => Err(exc("TypeError", "attribute must be a string".to_string())),
        };
    }
    if *kind == "channel_prefix" or *kind == "midi_port" {
        return check_int(v, 0, 0xff);
    }
    if *kind == "set_tempo" {
        return check_int(v, 0, 0xffffff);
    }
    if *kind == "smpte_offset" {
        if *name == "frame_rate" {
            if not is_hashable(v) {
                return Err(unhashable(v));
            }
            let mut found = false;
            for r in smpte_rates() {
                if not matches_bool(v) and py_eq(v, r) {
                    found = true;
                }
            }
            if not found {
                // ', '.join(sorted(keys)) fails on its first int.
                return Err(exc("TypeError", "sequence item 0: expected str instance, int found".to_string()));
            }
            return Ok(());
        } else if *name == "hours" or *name == "frames" {
            return check_int(v, 0, 255);
        } else if *name == "minutes" or *name == "seconds" {
            return check_int(v, 0, 59);
        } else if *name == "sub_frames" {
            return check_int(v, 0, 99);
        }
        return Ok(());
    }
    if *kind == "time_signature" {
        if *name == "denominator" {
            if not is_integral(v) {
                return Err(exc("TypeError", "attribute must be an integer".to_string()));
            }
            if int_of(v) < 1 {
                return Err(exc("ValueError", "attribute must be in range 1..57896044618658097711785492504343953926634992332820282019728792003956564819968".to_string()));
            }
            let e = log2(int_of(v));
            if e != e.floor() {
                return Err(exc("ValueError", "denominator must be a power of 2".to_string()));
            }
            return Ok(());
        }
        return check_int(v, 0, 255);
    }
    if *kind == "key_signature" {
        if not is_hashable(v) {
            return Err(unhashable(v));
        }
        let ok = match v {
            V.Str(t) => key_of_name(t).is_some(),
            _ => false,
        };
        if not ok {
            return Err(exc("ValueError", f"invalid key {repr(v)}"));
        }
        return Ok(());
    }
    Ok(())
}

// True and False hash as 1 and 0, which are not frame rates.
fn matches_bool(v: ref V) -> bool {
    match v {
        V.Bool(_) => true,
        _ => false,
    }
}

// math.log(n, 2).
fn log2(n: i64) -> f64 {
    (n as f64).ln() / (2.0).ln()
}

fn key_of_name(t: ref String) -> Option[KeySig] {
    for k in key_table().into_iter() {
        if k.name == *t {
            return Some(k);
        }
    }
    None
}

// ------------------------------------------------------------ meta messages

// MetaMessage(type, skip_checks=skip, **kw).
fn new_meta(t: ref String, kw: ref Vec[Attr], skip: bool) -> Result[Msg, Exc] {
    let sp = match meta_spec_by_type(t) {
        Some(s) => s,
        None => return Err(exc("KeyError", str_repr(t))),
    };
    if not skip {
        for a in kw.iter() {
            if a.name != "time" and not names_has(sp.attrs, a.name) {
                return Err(exc("ValueError", f"{a.name} is not a valid argument for this message type"));
            }
        }
    }
    let mut vars: Vec[Attr] = Vec.new();
    vars.push(attr("type", V.Str(t.clone())));
    for i in 0..sp.attrs.len() {
        vars.push(Attr { name: sp.attrs[i].clone(), val: sp.defaults[i].clone() });
    }
    vars.push(attr("time", V.Int(0)));
    let mut m = Msg { cls: Cls.Meta, frozen: false, vars: vars };
    for a in kw.iter() {
        meta_setattr(mut m, a.name, a.val)?;
    }
    Ok(m)
}

fn meta_setattr(m: mut ref Msg, name: ref String, v: ref V) -> Result[(), Exc] {
    let t = msg_type(m);
    let sp = meta_spec_by_type(t).unwrap();
    if *name == "time" or names_has(sp.attrs, name) {
        if *name == "time" {
            check_time(v)?;
        } else {
            meta_check(t, name, v)?;
        }
        put_var(mut m.vars, name, v.clone());
        return Ok(());
    }
    if has_var(m.vars, name) {
        return Err(exc("AttributeError", f"{name} attribute is read only"));
    }
    Err(exc("AttributeError", f"{t} message has no attribute {name}"))
}

fn meta_data(m: ref Msg, charset: ref String) -> Result[Vec[V], Exc] {
    let t = msg_type(m);
    let mut out: Vec[V] = Vec.new();
    if t == "sequence_number" {
        let n = int_of(var_of(m, "number"));
        out.push(V.Int(n >> 8));
        out.push(V.Int(n & 0xff));
    } else if is_text_kind(t) {
        let field = if t == "track_name" or t == "instrument_name" or t == "device_name" { "name" } else { "text" };
        for b in encode_string(text_val(var_of(m, field)), charset)? {
            out.push(V.Int(b));
        }
    } else if t == "channel_prefix" {
        out.push(var_of(m, "channel"));
    } else if t == "midi_port" {
        out.push(var_of(m, "port"));
    } else if t == "set_tempo" {
        let n = int_of(var_of(m, "tempo"));
        out.push(V.Int(n >> 16));
        out.push(V.Int((n >> 8) & 0xff));
        out.push(V.Int(n & 0xff));
    } else if t == "smpte_offset" {
        let rate = var_of(m, "frame_rate");
        let rates = smpte_rates();
        let mut code = -1;
        for i in 0..rates.len() {
            if py_eq(rate, rates[i]) {
                code = i;
            }
        }
        if code < 0 {
            return Err(exc("KeyError", repr(rate)));
        }
        out.push(V.Int((code << 5) | int_of(var_of(m, "hours"))));
        out.push(var_of(m, "minutes"));
        out.push(var_of(m, "seconds"));
        out.push(var_of(m, "frames"));
        out.push(var_of(m, "sub_frames"));
    } else if t == "time_signature" {
        out.push(var_of(m, "numerator"));
        out.push(V.Int(log2(int_of(var_of(m, "denominator"))) as i64));
        out.push(var_of(m, "clocks_per_click"));
        out.push(var_of(m, "notated_32nd_notes_per_beat"));
    } else if t == "key_signature" {
        let key = var_of(m, "key");
        let k = match key_of_name(text_val(key)) {
            Some(k) => k,
            None => return Err(exc("KeyError", repr(key))),
        };
        out.push(V.Int(k.key & 0xff));
        out.push(V.Int(k.mode));
    } else if t == "sequencer_specific" {
        out = items_of(var_of(m, "data"))?;
    }
    Ok(out)
}

fn meta_bytes(m: ref Msg, charset: ref String) -> Result[Vec[V], Exc] {
    let sp = meta_spec_by_type(msg_type(m)).unwrap();
    let data = meta_data(m, charset)?;
    let mut out: Vec[V] = Vec.new();
    out.push(V.Int(0xff));
    out.push(V.Int(sp.byte));
    for x in encode_variable_int(V.Int(data.len()))? {
        out.push(V.Int(x));
    }
    for x in data.into_iter() {
        out.push(x);
    }
    Ok(out)
}

fn index_error() -> Exc {
    exc("IndexError", "list index out of range".to_string())
}

fn at(data: ref Vec[i64], i: i64) -> Result[i64, Exc] {
    if i >= data.len() {
        return Err(index_error());
    }
    Ok(data[i])
}

fn set_meta(m: mut ref Msg, name: Str, v: own V) -> Result[(), Exc] {
    meta_setattr(mut m, name.to_string(), v)
}

// build_meta_message(): a meta message from a file's bytes. An unknown
// kind becomes an UnknownMetaMessage, and loses its delta time.
fn build_meta_message(byte: i64, data: ref Vec[i64], delta: ref V, charset: ref String) -> Result[Msg, Exc] {
    let sp = match meta_spec_by_byte(byte) {
        Some(s) => s,
        None => return new_unknown(V.Int(byte), V.List(int_list(data)), V.Int(0), V.Str("unknown_meta".to_string())),
    };
    let mut kw: Vec[Attr] = Vec.new();
    kw.push(Attr { name: "time".to_string(), val: delta.clone() });
    let mut m = new_meta(sp.kind, kw, false)?;
    let t = sp.kind.clone();
    if t == "sequence_number" {
        if data.len() == 0 {
            set_meta(mut m, "number", V.Int(0))?;
        } else {
            let hi = at(data, 0)?;
            let lo = at(data, 1)?;
            set_meta(mut m, "number", V.Int((hi << 8) | lo))?;
        }
    } else if is_text_kind(t) {
        let field = if t == "track_name" or t == "instrument_name" or t == "device_name" { "name" } else { "text" };
        set_meta(mut m, field, V.Str(decode_string(data, charset)?))?;
    } else if t == "channel_prefix" {
        set_meta(mut m, "channel", V.Int(at(data, 0)?))?;
    } else if t == "midi_port" {
        if data.len() == 0 {
            set_meta(mut m, "port", V.Int(0))?;
        } else {
            set_meta(mut m, "port", V.Int(data[0]))?;
        }
    } else if t == "set_tempo" {
        let a = at(data, 0)?;
        let b = at(data, 1)?;
        let c = at(data, 2)?;
        set_meta(mut m, "tempo", V.Int((a << 16) | (b << 8) | c))?;
    } else if t == "smpte_offset" {
        let d0 = at(data, 0)?;
        let rates = smpte_rates();
        let code = d0 >> 5;
        if code > 3 {
            return Err(exc("KeyError", f"{code}"));
        }
        set_meta(mut m, "frame_rate", rates[code].clone())?;
        set_meta(mut m, "hours", V.Int(d0 & 0x1f))?;
        set_meta(mut m, "minutes", V.Int(at(data, 1)?))?;
        set_meta(mut m, "seconds", V.Int(at(data, 2)?))?;
        set_meta(mut m, "frames", V.Int(at(data, 3)?))?;
        set_meta(mut m, "sub_frames", V.Int(at(data, 4)?))?;
    } else if t == "time_signature" {
        set_meta(mut m, "numerator", V.Int(at(data, 0)?))?;
        set_meta(mut m, "denominator", V.Int(1 << at(data, 1)?))?;
        set_meta(mut m, "clocks_per_click", V.Int(at(data, 2)?))?;
        set_meta(mut m, "notated_32nd_notes_per_beat", V.Int(at(data, 3)?))?;
    } else if t == "key_signature" {
        let key = signed_byte(at(data, 0)?);
        let mode = at(data, 1)?;
        let mut name: Option[String] = None;
        for k in key_table().into_iter() {
            if k.key == key and k.mode == mode {
                name = Some(k.name.clone());
            }
        }
        match name {
            Some(n) => set_meta(mut m, "key", V.Str(n))?,
            None => {
                let msg = if key < 7 {
                    f"Could not decode key with {key.abs()} flats and mode {mode}"
                } else {
                    f"Could not decode key with {key} sharps and mode {mode}"
                };
                return Err(exc("KeySignatureError", msg));
            }
        }
    } else if t == "sequencer_specific" {
        set_meta(mut m, "data", V.Tuple(int_list(data)))?;
    }
    Ok(m)
}

fn signed_byte(n: i64) -> i64 {
    if n >= 128 { n - 256 } else { n }
}

// MetaMessage.from_bytes(): the length is found by trying ever longer
// prefixes until one says how many bytes follow.
fn meta_from_bytes(b: ref Vec[i64]) -> Result[Msg, Exc] {
    if b.len() == 0 or b[0] != 0xff {
        return Err(exc("ValueError", "bytes does not correspond to a MetaMessage.".to_string()));
    }
    let mut scan_end = 2;
    let mut data: Vec[i64] = Vec.new();
    let mut flag = true;
    while flag and scan_end < b.len() {
        scan_end += 1;
        let mut length_data: Vec[i64] = Vec.new();
        for i in 2..scan_end {
            length_data.push(b[i]);
        }
        let length = decode_variable_int(length_data);
        data = Vec.new();
        for i in scan_end..b.len() {
            data.push(b[i]);
        }
        if length == data.len() {
            flag = false;
        }
    }
    if flag {
        return Err(exc("ValueError", "Bad data. Cannot be converted to message.".to_string()));
    }
    build_meta_message(b[1], data, V.Int(0), "latin1".to_string())
}

// ------------------------------------------------------------ variable ints

fn encode_variable_int(v: ref V) -> Result[Vec[i64], Exc] {
    if not is_integral(v) or int_of(v) < 0 {
        return Err(exc("ValueError", "variable int must be a non-negative integer".to_string()));
    }
    let mut value = int_of(v);
    let mut out: Vec[i64] = Vec.new();
    while value != 0 {
        out.push(value & 0x7f);
        value = value >> 7;
    }
    if out.len() == 0 {
        out.push(0);
        return Ok(out);
    }
    out.reverse();
    let n = out.len();
    for i in 0..(n - 1) {
        out[i] = out[i] | 0x80;
    }
    Ok(out)
}

// Only the bytes before the last lose their high bit.
fn decode_variable_int(value: ref Vec[i64]) -> i64 {
    let mut val = 0;
    for i in 0..value.len() {
        let b = if i + 1 < value.len() { value[i] & 0x7f } else { value[i] };
        val = (val << 7) | b;
    }
    val
}

// signed(to_type, n): struct.pack with one format, unpack with the
// other. 'long' is the native 8-byte long.
fn signed_conv(to_type: ref String, n: i64) -> Result[i64, Exc] {
    let t = to_type.as_str();
    let (pack, bits) = if t == "byte" {
        ('B', 8)
    } else if t == "short" {
        ('H', 16)
    } else if t == "long" {
        ('L', 64)
    } else if t == "ubyte" {
        ('b', 8)
    } else if t == "ushort" {
        ('h', 16)
    } else if t == "ulong" {
        ('l', 64)
    } else {
        return Err(exc("ValueError", f"invalid integer type {to_type}"));
    };
    let unsigned_in = pack == 'B' or pack == 'H' or pack == 'L';
    if bits < 64 {
        let span = 1 << bits;
        let (lo, hi) = if unsigned_in { (0, span - 1) } else { (-(span / 2), span / 2 - 1) };
        if n < lo or n > hi {
            return Err(exc("ValueError", f"'{pack}' format requires {lo} <= number <= {hi}"));
        }
        if unsigned_in {
            return Ok(if n >= span / 2 { n - span } else { n });
        }
        return Ok(if n < 0 { n + span } else { n });
    }
    Ok(n)
}

// ------------------------------------------------------------ charsets

fn codec_name(charset: ref String) -> String {
    if *charset == "latin1" {
        "latin-1".to_string()
    } else {
        charset.clone()
    }
}

fn escape_cp(cp: i64) -> String {
    if cp < 0x100 {
        f"\\x{cp:02x}"
    } else if cp < 0x10000 {
        f"\\u{cp:04x}"
    } else {
        f"\\U{cp:08x}"
    }
}

// text.encode(charset).
fn encode_string(t: ref String, charset: ref String) -> Result[Vec[i64], Exc] {
    let mut out: Vec[i64] = Vec.new();
    if *charset == "utf-8" {
        for b in t.bytes() {
            out.push(b as i64);
        }
        return Ok(out);
    }
    let limit = if *charset == "ascii" { 128 } else { 256 };
    let cs = chars(t);
    let mut i = 0;
    while i < cs.len() {
        let cp = cs[i] as i64;
        if cp >= limit {
            let mut j = i;
            while j + 1 < cs.len() and cs[j + 1] as i64 >= limit {
                j += 1;
            }
            let codec = codec_name(charset);
            let msg = if j == i {
                f"'{codec}' codec can't encode character '{escape_cp(cp)}' in position {i}: ordinal not in range({limit})"
            } else {
                f"'{codec}' codec can't encode characters in position {i}-{j}: ordinal not in range({limit})"
            };
            return Err(exc("UnicodeEncodeError", msg));
        }
        out.push(cp);
        i += 1;
    }
    Ok(out)
}

// bytearray(data).decode(charset).
fn decode_string(data: ref Vec[i64], charset: ref String) -> Result[String, Exc] {
    let mut out = String.new();
    if *charset == "utf-8" {
        let mut b: Vec[u8] = Vec.new();
        for x in data.iter() {
            b.push(*x as u8);
        }
        for cp in utf8_decode(b)? {
            out.push(char.try_from(cp as u32).unwrap_or('?'));
        }
        return Ok(out);
    }
    for i in 0..data.len() {
        let x = data[i];
        if *charset == "ascii" and x > 127 {
            return Err(exc("UnicodeDecodeError", f"'ascii' codec can't decode byte 0x{x:02x} in position {i}: ordinal not in range(128)"));
        }
        out.push(char.try_from(x as u32).unwrap_or('?'));
    }
    Ok(out)
}
// ------------------------------------------------------------ tracks
// midifiles/tracks.py: a track is a list of messages with delta times.

fn track_repr(t: ref Vec[Msg]) -> String {
    if t.len() == 0 {
        return "MidiTrack()".to_string();
    }
    if t.len() == 1 {
        return f"MidiTrack([{msg_str(t[0])}])";
    }
    let mut parts: Vec[String] = Vec.new();
    for m in t.iter() {
        parts.push(msg_repr(m));
    }
    f"MidiTrack([\n  {join(parts, ",\n  ")}])"
}

fn track_name(t: ref Vec[Msg]) -> V {
    for m in t.iter() {
        if msg_type(m) == "track_name" {
            return var_of(m, "name");
        }
    }
    V.Str(String.new())
}

fn set_track_name(t: mut ref Vec[Msg], name: ref V) -> Result[(), Exc] {
    let mut i = 0;
    while i < t.len() {
        if msg_type(t[i]) == "track_name" {
            return set_attr(mut t[i], "name".to_string(), name);
        }
        i += 1;
    }
    let mut kw: Vec[Attr] = Vec.new();
    kw.push(Attr { name: "name".to_string(), val: name.clone() });
    kw.push(attr("time", V.Int(0)));
    let m = new_meta("track_name".to_string(), kw, false)?;
    t.insert(0, m);
    Ok(())
}

fn end_of_track(time: ref V) -> Result[Msg, Exc] {
    let mut kw: Vec[Attr] = Vec.new();
    kw.push(Attr { name: "time".to_string(), val: time.clone() });
    new_meta("end_of_track".to_string(), kw, false)
}

// fix_end_of_track(): every end_of_track goes, its time added to the next
// message, and one is put at the end.
fn fix_end_of_track(msgs: ref Vec[Msg], skip: bool) -> Result[Vec[Msg], Exc] {
    let mut out: Vec[Msg] = Vec.new();
    let mut accum = V.Int(0);
    for m in msgs.iter() {
        if msg_type(m) == "end_of_track" {
            accum = num_add(accum, var_of(m, "time"));
        } else if truthy(accum) {
            let delta = num_add(accum, var_of(m, "time"));
            out.push(copy_time(m, delta, skip)?);
            accum = V.Int(0);
        } else {
            out.push(m.clone());
        }
    }
    out.push(end_of_track(accum)?);
    Ok(out)
}

// merge_tracks(): every message in absolute time, sorted (a stable sort,
// as list.sort is), and back to delta times.
fn merge_tracks(tracks: ref Vec[Vec[Msg]], skip: bool) -> Result[Vec[Msg], Exc] {
    let mut all: Vec[Msg] = Vec.new();
    for t in tracks.iter() {
        let mut now = V.Int(0);
        for m in t.iter() {
            now = num_add(now, var_of(m, "time"));
            all.push(copy_time(m, now, skip)?);
        }
    }
    let sorted = sort_by_time(all);
    let mut rel: Vec[Msg] = Vec.new();
    let mut now = V.Int(0);
    for m in sorted.iter() {
        let t = var_of(m, "time");
        rel.push(copy_time(m, num_sub(t, now), skip)?);
        now = t;
    }
    fix_end_of_track(rel, skip)
}

fn sort_by_time(xs: own Vec[Msg]) -> Vec[Msg] {
    if xs.len() <= 1 {
        return xs;
    }
    let mid = xs.len() / 2;
    let mut left: Vec[Msg] = Vec.new();
    let mut right: Vec[Msg] = Vec.new();
    for i in 0..xs.len() {
        if i < mid {
            left.push(xs[i].clone());
        } else {
            right.push(xs[i].clone());
        }
    }
    let a = sort_by_time(left);
    let b = sort_by_time(right);
    let mut out: Vec[Msg] = Vec.new();
    let mut i = 0;
    let mut j = 0;
    while i < a.len() or j < b.len() {
        if j >= b.len() or (i < a.len() and not num_lt(var_of(b[j], "time"), var_of(a[i], "time"))) {
            out.push(a[i].clone());
            i += 1;
        } else {
            out.push(b[j].clone());
            j += 1;
        }
    }
    out
}

// ------------------------------------------------------------ units

fn tick2second(tick: ref V, tpb: ref V, tempo: ref V) -> Result[f64, Exc] {
    let d = num_of(tpb);
    if d == 0.0 {
        return Err(exc("ZeroDivisionError", "float division by zero".to_string()));
    }
    let scale = num_of(tempo) * 1e-6 / d;
    Ok(num_of(tick) * scale)
}

fn second2tick(second: ref V, tpb: ref V, tempo: ref V) -> Result[i64, Exc] {
    let d = num_of(tpb);
    if d == 0.0 {
        return Err(exc("ZeroDivisionError", "float division by zero".to_string()));
    }
    let scale = num_of(tempo) * 1e-6 / d;
    Ok(py_round(num_of(second) / scale))
}

fn bpm2tempo(bpm: ref V, ts1: i64) -> Result[i64, Exc] {
    let b = num_of(bpm);
    if b == 0.0 {
        return Err(exc("ZeroDivisionError", "float division by zero".to_string()));
    }
    Ok(py_round(60.0 * 1e6 / b * (ts1 as f64) / 4.0))
}

fn tempo2bpm(tempo: ref V, ts1: i64) -> Result[f64, Exc] {
    let t = num_of(tempo);
    if t == 0.0 {
        return Err(exc("ZeroDivisionError", "float division by zero".to_string()));
    }
    Ok(60.0 * 1e6 / t * (ts1 as f64) / 4.0)
}

// ------------------------------------------------------------ MIDI files

#[derive(Clone)]
struct MidiFile {
    kind: i64,
    tpb: i64,
    charset: String,
    tracks: Vec[Vec[Msg]],
}

fn new_file(kind: i64, tpb: i64, charset: ref String) -> Result[MidiFile, Exc] {
    if kind < 0 or kind > 2 {
        return Err(exc("ValueError", "invalid format <built-in function format> (must be 0, 1 or 2)".to_string()));
    }
    Ok(MidiFile { kind: kind, tpb: tpb, charset: charset.clone(), tracks: Vec.new() })
}

fn file_repr(f: ref MidiFile) -> String {
    let mut tracks_str = String.new();
    if f.tracks.len() > 0 {
        let mut parts: Vec[String] = Vec.new();
        for t in f.tracks.iter() {
            parts.push(track_repr(t));
        }
        let body = replace_all(join(parts, ",\n"), "\n".to_string(), "\n  ".to_string());
        tracks_str = f", tracks=[\n  {body}\n]";
    }
    f"MidiFile(type={f.kind}, ticks_per_beat={f.tpb}{tracks_str})"
}

fn merged_track(f: ref MidiFile) -> Result[Vec[Msg], Exc] {
    if f.kind == 2 {
        return Err(exc("TypeError", "can't merge tracks in type 2 (asynchronous) file".to_string()));
    }
    merge_tracks(f.tracks, true)
}

// iter(midifile): the merged track with times in seconds since the last
// message, following the tempo changes.
fn play(f: ref MidiFile) -> Result[Vec[Msg], Exc] {
    let mut tempo = V.Int(500000);
    let mut out: Vec[Msg] = Vec.new();
    for m in merged_track(f)? {
        let t = var_of(m, "time");
        let delta = if num_lt(V.Int(0), t) {
            V.Float(tick2second(t, V.Int(f.tpb), tempo)?)
        } else {
            V.Int(0)
        };
        out.push(copy_time(m, delta, true)?);
        if msg_type(m) == "set_tempo" {
            tempo = var_of(m, "tempo");
        }
    }
    Ok(out)
}

fn file_length(f: ref MidiFile) -> Result[V, Exc] {
    if f.kind == 2 {
        return Err(exc("ValueError", "impossible to compute length for type 2 (asynchronous) file".to_string()));
    }
    let mut times: Vec[V] = Vec.new();
    for m in play(f)? {
        times.push(var_of(m, "time"));
    }
    Ok(py_sum(times))
}

// sum(xs) as Python 3.12 adds numbers: ints exactly until the first
// float, then floats with Neumaier's compensation (ints after that are
// added plainly).
fn py_sum(xs: ref Vec[V]) -> V {
    let mut i_result = 0;
    let mut k = 0;
    while k < xs.len() and not is_float(xs[k]) {
        i_result += int_of(xs[k]);
        k += 1;
    }
    if k == xs.len() {
        return V.Int(i_result);
    }
    let mut f_result = i_result as f64;
    let mut c = 0.0;
    while k < xs.len() {
        if is_float(xs[k]) {
            let x = num_of(xs[k]);
            let t = f_result + x;
            if f_result.abs() >= x.abs() {
                c += (f_result - t) + x;
            } else {
                c += (x - t) + f_result;
            }
            f_result = t;
        } else {
            f_result += int_of(xs[k]) as f64;
        }
        k += 1;
    }
    if c != 0.0 and c.is_finite() {
        f_result += c;
    }
    V.Float(f_result)
}

fn print_tracks(f: ref MidiFile, meta_only: bool) {
    for i in 0..f.tracks.len() {
        println(f"=== Track {i}");
        for m in f.tracks[i].iter() {
            if is_meta(m) or not meta_only {
                println(msg_repr(m));
            }
        }
    }
}

// The file being read, and DebugFileWrapper's dump of every byte read.
struct Reader {
    data: Vec[u8],
    pos: i64,
    debug: bool,
}

fn rd(r: mut ref Reader, n: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut k = 0;
    while k < n and r.pos < r.data.len() {
        out.push(r.data[r.pos]);
        r.pos += 1;
        k += 1;
    }
    if r.debug {
        for b in out.iter() {
            print_byte(*b, r.pos);
        }
    }
    out
}

fn print_byte(b: u8, pos: i64) {
    let printable = b > 32 and b < 127;
    let c = if printable { (b as char).to_string() } else { ".".to_string() };
    println(f"  {pos:06x}: {b:02x}  {c}");
}

fn dbg_line(r: ref Reader, text: ref String) {
    if r.debug {
        println(text);
    }
}

fn eof() -> Exc {
    exc("EOFError", String.new())
}

fn os_error(msg: own String) -> Exc {
    exc("OSError", msg)
}

fn read_byte(r: mut ref Reader) -> Result[i64, Exc] {
    let b = rd(mut r, 1);
    if b.len() == 0 {
        return Err(eof());
    }
    Ok(b[0] as i64)
}

fn read_bytes(r: mut ref Reader, size: i64) -> Result[Vec[i64], Exc] {
    if size > 1000000 {
        return Err(os_error(f"Message length {size} exceeds maximum length 1000000"));
    }
    let mut out: Vec[i64] = Vec.new();
    for _ in 0..size {
        out.push(read_byte(mut r)?);
    }
    Ok(out)
}

fn be(b: ref Vec[u8], lo: i64, n: i64) -> i64 {
    let mut v = 0;
    for i in lo..(lo + n) {
        v = (v << 8) | (b[i] as i64);
    }
    v
}

fn be_signed16(b: ref Vec[u8], lo: i64) -> i64 {
    let v = be(b, lo, 2);
    if v >= 0x8000 { v - 0x10000 } else { v }
}

fn chunk_name(b: ref Vec[u8]) -> String {
    let mut s = String.new();
    for i in 0..4 {
        s.push(b[i] as char);
    }
    s
}

fn read_chunk_header(r: mut ref Reader) -> Result[(String, i64), Exc] {
    let h = rd(mut r, 8);
    if h.len() < 8 {
        return Err(eof());
    }
    Ok((chunk_name(h), be(h, 4, 4)))
}

fn read_variable_int(r: mut ref Reader) -> Result[i64, Exc] {
    let mut delta = 0;
    loop {
        let b = read_byte(mut r)?;
        delta = (delta << 7) | (b & 0x7f);
        if b < 0x80 {
            return Ok(delta);
        }
    }
}

fn read_message(r: mut ref Reader, status: i64, peek: ref Vec[i64], delta: i64, clip: bool) -> Result[Msg, Exc] {
    let sp = match spec_by_status(status) {
        Some(s) => s,
        None => return Err(os_error(f"undefined status byte 0x{status:02x}")),
    };
    let size = sp.length - 1 - peek.len();
    let mut data = peek.clone();
    for b in read_bytes(mut r, size)? {
        data.push(b);
    }
    let mut full: Vec[i64] = Vec.new();
    full.push(status);
    for b in data.iter() {
        if clip {
            full.push(if *b < 127 { *b } else { 127 });
        } else {
            if *b > 127 {
                return Err(os_error("data byte must be in range 0..127".to_string()));
            }
            full.push(*b);
        }
    }
    from_bytes(full, V.Int(delta))
}

fn read_sysex(r: mut ref Reader, delta: i64, clip: bool) -> Result[Msg, Exc] {
    let length = read_variable_int(mut r)?;
    let mut data = read_bytes(mut r, length)?;
    if data.len() > 0 and data[0] == 0xf0 {
        data.remove(0);
    }
    if data.len() > 0 and data[data.len() - 1] == 0xf7 {
        data.pop();
    }
    if clip {
        let mut c: Vec[i64] = Vec.new();
        for b in data.iter() {
            c.push(if *b < 127 { *b } else { 127 });
        }
        data = c;
    }
    let mut kw: Vec[Attr] = Vec.new();
    kw.push(attr("data", V.List(int_list(data))));
    kw.push(attr("time", V.Int(delta)));
    new_message("sysex".to_string(), kw, false)
}

fn read_track(r: mut ref Reader, clip: bool, charset: ref String) -> Result[Vec[Msg], Exc] {
    let mut track: Vec[Msg] = Vec.new();
    let (name, size) = read_chunk_header(mut r)?;
    if name != "MTrk" {
        return Err(os_error("no MTrk header at start of track".to_string()));
    }
    dbg_line(r, f"-> size={size}");
    dbg_line(r, String.new());
    let start = r.pos;
    let mut last_status: i64 = -1;
    loop {
        if r.pos - start == size {
            break;
        }
        dbg_line(r, "Message:".to_string());
        let delta = read_variable_int(mut r)?;
        dbg_line(r, f"-> delta={delta}");
        let mut status = read_byte(mut r)?;
        let mut peek: Vec[i64] = Vec.new();
        if status < 0x80 {
            if last_status < 0 {
                return Err(os_error("running status without last_status".to_string()));
            }
            peek.push(status);
            status = last_status;
        } else if status != 0xff {
            last_status = status;
        }
        let msg = if status == 0xff {
            let kind = read_byte(mut r)?;
            let length = read_variable_int(mut r)?;
            let data = read_bytes(mut r, length)?;
            build_meta_message(kind, data, V.Int(delta), charset)?
        } else if status == 0xf0 or status == 0xf7 {
            read_sysex(mut r, delta, clip)?
        } else {
            read_message(mut r, status, peek, delta, clip)?
        };
        dbg_line(r, f"-> {msg_repr(msg)}");
        dbg_line(r, String.new());
        track.push(msg);
    }
    Ok(track)
}

fn not_found(p: ref String) -> Exc {
    exc("FileNotFoundError", f"[Errno 2] No such file or directory: {str_repr(p)}")
}

fn read_file_bytes(p: ref String) -> Result[Vec[u8], Exc] {
    if not fs.exists(p.clone()) {
        return Err(not_found(p));
    }
    match fs.read_bytes(p.clone()) {
        Ok(b) => Ok(b),
        Err(e) => Err(exc("OSError", f"{e}")),
    }
}

// MidiFile(filename, charset=..., debug=..., clip=...).
fn load_file(p: ref String, charset: ref String, debug: bool, clip: bool) -> Result[MidiFile, Exc] {
    let mut f = new_file(1, 480, charset)?;
    let data = read_file_bytes(p)?;
    let mut r = Reader { data: data, pos: 0, debug: debug };
    dbg_line(r, "Header:".to_string());
    let (name, size) = read_chunk_header(mut r)?;
    if name != "MThd" {
        return Err(os_error("MThd not found. Probably not a MIDI file".to_string()));
    }
    let h = rd(mut r, size);
    if h.len() < 6 {
        return Err(eof());
    }
    f.kind = be_signed16(h, 0);
    let num_tracks = be_signed16(h, 2);
    f.tpb = be_signed16(h, 4);
    dbg_line(r, f"-> type={f.kind}, tracks={num_tracks}, ticks_per_beat={f.tpb}");
    dbg_line(r, String.new());
    for i in 0..num_tracks {
        dbg_line(r, f"Track {i}:");
        let t = read_track(mut r, clip, charset)?;
        f.tracks.push(t);
    }
    Ok(f)
}

fn push_vlq(out: mut ref Vec[u8], v: ref V) -> Result[(), Exc] {
    for b in encode_variable_int(v)? {
        out.push(b as u8);
    }
    Ok(())
}

fn push_vals(out: mut ref Vec[u8], xs: ref Vec[V]) -> Result[(), Exc] {
    for b in bytes_of(xs)? {
        out.push(b);
    }
    Ok(())
}

fn write_track(t: ref Vec[Msg], charset: ref String) -> Result[Vec[u8], Exc] {
    let mut data: Vec[u8] = Vec.new();
    let mut running: i64 = -1;
    for m in fix_end_of_track(t, false)? {
        let time = var_of(m, "time");
        if not is_integral(time) {
            return Err(exc("ValueError", "message time must be int in MIDI file".to_string()));
        }
        if int_of(time) < 0 {
            return Err(exc("ValueError", "message time must be non-negative in MIDI file".to_string()));
        }
        if is_realtime(m) {
            return Err(exc("ValueError", "realtime messages are not allowed in MIDI files".to_string()));
        }
        push_vlq(mut data, time)?;
        if is_meta(m) {
            push_vals(mut data, msg_bytes(m, charset)?)?;
            running = -1;
        } else if msg_type(m) == "sysex" {
            let d = items_of(var_of(m, "data"))?;
            data.push(0xf0);
            push_vlq(mut data, V.Int(d.len() + 1))?;
            push_vals(mut data, d)?;
            data.push(0xf7);
            running = -1;
        } else {
            let b = msg_bytes(m, charset)?;
            let status = int_of(b[0]);
            if status == running {
                let mut rest: Vec[V] = Vec.new();
                for i in 1..b.len() {
                    rest.push(b[i].clone());
                }
                push_vals(mut data, rest)?;
            } else {
                push_vals(mut data, b)?;
            }
            running = if status < 0xf0 { status } else { -1 };
        }
    }
    Ok(data)
}

fn push_chunk(out: mut ref Vec[u8], name: Str, data: ref Vec[u8]) {
    for b in name.bytes() {
        out.push(b);
    }
    let n = data.len();
    out.push(((n >> 24) & 0xff) as u8);
    out.push(((n >> 16) & 0xff) as u8);
    out.push(((n >> 8) & 0xff) as u8);
    out.push((n & 0xff) as u8);
    for b in data.iter() {
        out.push(*b);
    }
}

fn pack_h(out: mut ref Vec[u8], n: i64) -> Result[(), Exc] {
    if n < -32768 or n > 32767 {
        return Err(exc("error", "'h' format requires -32768 <= number <= 32767".to_string()));
    }
    let u = n & 0xffff;
    out.push(((u >> 8) & 0xff) as u8);
    out.push((u & 0xff) as u8);
    Ok(())
}

fn file_bytes(f: ref MidiFile, out: mut ref Vec[u8]) -> Result[(), Exc] {
    let mut header: Vec[u8] = Vec.new();
    pack_h(mut header, f.kind)?;
    pack_h(mut header, f.tracks.len())?;
    pack_h(mut header, f.tpb)?;
    push_chunk(mut out, "MThd", header);
    for t in f.tracks.iter() {
        let data = write_track(t, f.charset)?;
        push_chunk(mut out, "MTrk", data);
    }
    Ok(())
}

// MidiFile.save(filename): the file is opened before the tracks are
// encoded, so a failure leaves what was written before it.
fn save_file(f: ref MidiFile, p: ref String) -> Result[Vec[u8], Exc] {
    if f.kind == 0 and f.tracks.len() != 1 {
        return Err(exc("ValueError", "type 0 file must have exactly 1 track".to_string()));
    }
    let mut out: Vec[u8] = Vec.new();
    let r = file_bytes(f, mut out);
    if let Err(e) = fs.write_bytes(p.clone(), out.clone()) {
        return Err(exc("OSError", f"{e}"));
    }
    r?;
    Ok(out)
}

// ------------------------------------------------------------ parser

// tokenizer.py's Tokenizer: splits a byte stream into messages' bytes.
struct Tokenizer {
    status: i64,
    bytes: Vec[i64],
    messages: Vec[Vec[i64]],
    want: i64,
}

fn new_tokenizer() -> Tokenizer {
    Tokenizer { status: 0, bytes: Vec.new(), messages: Vec.new(), want: 0 }
}

fn feed_status_byte(t: mut ref Tokenizer, status: i64) {
    if status == 0xf7 {
        if t.status == 0xf0 {
            t.bytes.push(0xf7);
            t.messages.push(t.bytes.clone());
        }
        t.status = 0;
    } else if status >= 0xf8 {
        if t.status != 0xf0 {
            t.status = 0;
        }
        if spec_by_status(status).is_some() {
            let mut one: Vec[i64] = Vec.new();
            one.push(status);
            t.messages.push(one);
        }
    } else {
        match spec_by_status(status) {
            Some(sp) => {
                if sp.length == 1 {
                    let mut one: Vec[i64] = Vec.new();
                    one.push(status);
                    t.messages.push(one);
                    t.status = 0;
                } else {
                    t.status = status;
                    t.bytes = Vec.new();
                    t.bytes.push(status);
                    t.want = sp.length;
                }
            }
            None => {}
        }
    }
}

fn feed_data_byte(t: mut ref Tokenizer, b: i64) {
    if t.status != 0 {
        t.bytes.push(b);
        if t.bytes.len() == t.want {
            t.messages.push(t.bytes.clone());
            t.status = 0;
        }
    }
}

fn tok_feed_byte(t: mut ref Tokenizer, v: ref V) -> Result[(), Exc] {
    if not is_integral(v) {
        return Err(exc("TypeError", "message byte must be integer".to_string()));
    }
    let b = int_of(v);
    if b < 0 or b > 255 {
        return Err(exc("ValueError", f"invalid byte value {repr(v)}"));
    }
    if b <= 127 {
        feed_data_byte(mut t, b);
    } else {
        feed_status_byte(mut t, b);
    }
    Ok(())
}

fn tok_feed(t: mut ref Tokenizer, data: ref Vec[V]) -> Result[(), Exc] {
    for v in data.iter() {
        tok_feed_byte(mut t, v)?;
    }
    Ok(())
}

struct MidiParser {
    tok: Tokenizer,
    messages: Vec[Msg],
}

fn new_parser() -> MidiParser {
    MidiParser { tok: new_tokenizer(), messages: Vec.new() }
}

fn parser_decode(p: mut ref MidiParser) -> Result[(), Exc] {
    let toks = p.tok.messages.clone();
    p.tok.messages = Vec.new();
    for b in toks.iter() {
        p.messages.push(from_bytes(b, V.Int(0))?);
    }
    Ok(())
}

fn parser_feed(p: mut ref MidiParser, data: ref Vec[V]) -> Result[(), Exc] {
    tok_feed(mut p.tok, data)?;
    parser_decode(mut p)
}

fn parser_feed_byte(p: mut ref MidiParser, v: ref V) -> Result[(), Exc] {
    tok_feed_byte(mut p.tok, v)?;
    parser_decode(mut p)
}

fn parser_get(p: mut ref MidiParser) -> Option[Msg] {
    if p.messages.len() == 0 {
        return None;
    }
    Some(p.messages.remove(0))
}

fn parse_all(data: ref Vec[V]) -> Result[Vec[Msg], Exc] {
    let mut p = new_parser();
    if data.len() > 0 {
        parser_feed(mut p, data)?;
    }
    Ok(p.messages)
}

// ------------------------------------------------------------ syx files

fn read_syx(p: ref String) -> Result[Vec[Msg], Exc] {
    let data = read_file_bytes(p)?;
    if data.len() == 0 {
        return Ok(Vec.new());
    }
    let mut parser = new_parser();
    if data[0] == 240 {
        let mut vs: Vec[V] = Vec.new();
        for b in data.iter() {
            vs.push(V.Int(*b as i64));
        }
        parser_feed(mut parser, vs)?;
    } else {
        let mut text = String.new();
        for b in data.iter() {
            text.push(*b as char);
        }
        let bytes = fromhex(spaces_for_ws(text))?;
        parser_feed(mut parser, int_list(bytes))?;
    }
    let mut out: Vec[Msg] = Vec.new();
    for m in parser.messages.into_iter() {
        if msg_type(m) == "sysex" {
            out.push(m);
        }
    }
    Ok(out)
}

fn write_syx(p: ref String, msgs: ref Vec[Msg], plaintext: bool) -> Result[(), Exc] {
    let mut out: Vec[u8] = Vec.new();
    for m in msgs.iter() {
        if msg_type(m) != "sysex" {
            continue;
        }
        if plaintext {
            for b in msg_hex(m, " ".to_string())?.bytes() {
                out.push(b);
            }
            out.push(10);
        } else {
            for b in msg_bin(m)? {
                out.push(b);
            }
        }
    }
    match fs.write_bytes(p.clone(), out) {
        Ok(_) => Ok(()),
        Err(e) => Err(exc("OSError", f"{e}")),
    }
}

// ------------------------------------------------------------ ports
// ports.py's EchoPort: what is sent comes back out, in order.

struct Port {
    name: String,
    closed: bool,
    autoreset: bool,
    messages: Vec[Msg],
}

fn port_repr(p: ref Port) -> String {
    let state = if p.closed { "closed" } else { "open" };
    f"<{state} I/O port {str_repr(p.name)} (EchoPort)>"
}

fn port_send(p: mut ref Port, m: ref Msg) -> Result[(), Exc] {
    if m.cls != Cls.Plain {
        return Err(exc("TypeError", "argument to send() must be a Message".to_string()));
    }
    if p.closed {
        return Err(exc("ValueError", "send() called on closed port".to_string()));
    }
    p.messages.push(m.clone());
    Ok(())
}

fn port_poll(p: mut ref Port) -> Option[Msg] {
    if p.messages.len() > 0 {
        return Some(p.messages.remove(0));
    }
    None
}

fn port_receive(p: mut ref Port) -> Result[Msg, Exc] {
    if p.messages.len() > 0 {
        return Ok(p.messages.remove(0));
    }
    if p.closed {
        return Err(exc("ValueError", "receive() called on closed port".to_string()));
    }
    Err(exc("RuntimeError", "receive() would wait for ever".to_string()))
}

fn control_change(channel: i64, control: i64) -> Msg {
    let mut kw: Vec[Attr] = Vec.new();
    kw.push(attr("channel", V.Int(channel)));
    kw.push(attr("control", V.Int(control)));
    new_message("control_change".to_string(), kw, false).unwrap()
}

fn port_reset(p: mut ref Port) {
    if p.closed {
        return;
    }
    for ch in 0..16 {
        for c in vec![123, 121] {
            let m = control_change(ch, c);
            port_send(mut p, m).unwrap();
        }
    }
}

fn port_panic(p: mut ref Port) {
    if p.closed {
        return;
    }
    for ch in 0..16 {
        let m = control_change(ch, 120);
        port_send(mut p, m).unwrap();
    }
}

fn port_close(p: mut ref Port) {
    if not p.closed {
        if p.autoreset {
            port_reset(mut p);
        }
        p.closed = true;
    }
}

fn port_drain(p: mut ref Port) -> Vec[Msg] {
    let out = p.messages.clone();
    p.messages = Vec.new();
    out
}

// ------------------------------------------------------------ the jobs

// What a job's variable can hold.
#[derive(Clone)]
enum Obj {
    M(Msg),
    T(Vec[Msg]),
    F(MidiFile),
    P(MidiParser),
    Pt(Port),
}

struct Env {
    names: Vec[String],
    vals: Vec[Obj],
}

impl Env {
    fn find(ref self, name: ref String) -> Option[i64] {
        let mut i = 0;
        while i < self.names.len() {
            if self.names[i] == *name {
                return Some(i);
            }
            i += 1;
        }
        None
    }

    fn get(ref self, name: ref String) -> Option[Obj] {
        match self.find(name) {
            Some(i) => Some(self.vals[i].clone()),
            None => None,
        }
    }

    fn put(mut ref self, name: ref String, v: own Obj) {
        match self.find(name) {
            Some(i) => {
                self.vals[i] = v;
            }
            None => {
                self.names.push(name.clone());
                self.vals.push(v);
            }
        }
    }

    fn msg(ref self, name: ref String) -> Msg {
        match self.get(name) {
            Some(Obj.M(m)) => m,
            _ => Msg { cls: Cls.Plain, frozen: false, vars: Vec.new() },
        }
    }

    fn track(ref self, name: ref String) -> Vec[Msg] {
        match self.get(name) {
            Some(Obj.T(t)) => t,
            _ => Vec.new(),
        }
    }

    fn file(ref self, name: ref String) -> MidiFile {
        match self.get(name) {
            Some(Obj.F(f)) => f,
            _ => MidiFile { kind: 1, tpb: 480, charset: "latin1".to_string(), tracks: Vec.new() },
        }
    }

    fn parser(ref self, name: ref String) -> MidiParser {
        match self.get(name) {
            Some(Obj.P(p)) => p,
            _ => new_parser(),
        }
    }

    fn port(ref self, name: ref String) -> Port {
        match self.get(name) {
            Some(Obj.Pt(p)) => p,
            _ => Port { name: String.new(), closed: false, autoreset: false, messages: Vec.new() },
        }
    }
}

fn jitems(j: ref J) -> Vec[J] {
    match j {
        J.Arr(items) => items.clone(),
        _ => Vec.new(),
    }
}

fn jfield(j: ref J, name: Str) -> J {
    match j {
        J.Obj(ms) => member(ms, name).unwrap_or(J.Null),
        _ => J.Null,
    }
}

fn jtext(j: ref J) -> String {
    match j {
        J.Str(t) => t.clone(),
        _ => String.new(),
    }
}

fn jnames(j: ref J) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for x in jitems(j).iter() {
        out.push(jtext(x));
    }
    out
}

// **kw: every key with its value.
fn kwargs(j: ref J) -> Vec[Attr] {
    let mut out: Vec[Attr] = Vec.new();
    match j {
        J.Obj(ms) => {
            for m in ms.iter() {
                out.push(Attr { name: m.key.clone(), val: from_j(m.val) });
            }
        }
        _ => {}
    }
    out
}

// The keywords without skip_checks, and skip_checks if it was given.
fn split_skip(kw: ref Vec[Attr]) -> (Vec[Attr], Option[bool]) {
    let mut out: Vec[Attr] = Vec.new();
    let mut skip: Option[bool] = None;
    for a in kw.iter() {
        if a.name == "skip_checks" {
            skip = Some(truthy(a.val));
        } else {
            out.push(a.clone());
        }
    }
    (out, skip)
}

fn kw_val(kw: ref Vec[Attr], name: Str) -> Option[V] {
    get_var(kw, name)
}

fn data_path(p: ref String) -> String {
    f"data/{p}"
}

fn show_value(what: ref String, m: ref Msg) -> Result[String, Exc] {
    let w = what.as_str();
    if w == "repr" {
        return Ok(msg_repr(m));
    }
    if w == "str" {
        return Ok(msg_str(m));
    }
    if w == "bytes" {
        return Ok(repr(V.List(msg_bytes(m, "latin1".to_string())?)));
    }
    if w == "hex" {
        return Ok(str_repr(msg_hex(m, " ".to_string())?));
    }
    if w.starts_with("hex/") {
        return Ok(str_repr(msg_hex(m, slice(what, 4, chars(what).len()))?));
    }
    if w == "bin" {
        return Ok(bytes_repr(msg_bin(m)?));
    }
    if w == "len" {
        return Ok(f"{msg_len(m)?}");
    }
    if w == "len_text" {
        return Ok(f"{chars(text_val(var_of(m, "text"))).len()}");
    }
    if w == "dict" {
        return Ok(msg_dict(m));
    }
    if w == "is_cc" {
        return Ok(bool_str(msg_type(m) == "control_change"));
    }
    if w.starts_with("is_cc=") {
        let n = parse_py_int(slice(what, 6, chars(what).len())).unwrap_or(0);
        let yes = msg_type(m) == "control_change" and py_eq(var_of(m, "control"), V.Int(n));
        return Ok(bool_str(yes));
    }
    if w == "is_meta" {
        return Ok(bool_str(is_meta(m)));
    }
    if w == "is_realtime" {
        return Ok(bool_str(is_realtime(m)));
    }
    if w == "frozen" {
        return Ok(bool_str(m.frozen));
    }
    let name = slice(what, 2, chars(what).len());
    match get_var(m.vars, name.as_str()) {
        Some(v) => Ok(repr(v)),
        None => Err(exc("AttributeError", f"'{class_name(m)}' object has no attribute '{name}'")),
    }
}

fn print_lines(text: ref String, indent: Str) {
    for line in split_on(text, '\n').iter() {
        println(f"{indent}{line}");
    }
}

fn show_file(what: ref String, f: ref MidiFile) {
    let w = what.as_str();
    if w == "repr" {
        println("  repr:");
        print_lines(file_repr(f), "    ");
    } else if w == "type" {
        println(f"  type: {f.kind}");
    } else if w == "tpb" {
        println(f"  ticks_per_beat: {f.tpb}");
    } else if w == "length" {
        match file_length(f) {
            Ok(v) => println(f"  length: {repr(v)}"),
            Err(e) => println(f"  length: {failure(e)}"),
        }
    } else if w == "print_tracks" or w == "print_meta" {
        println(f"  {w}:");
        print_tracks(f, w == "print_meta");
    } else if w == "play_list" {
        println("  play:");
        match play(f) {
            Ok(ms) => {
                for m in ms.iter() {
                    println(f"    {msg_repr(m)}");
                }
            }
            Err(e) => println(f"    {failure(e)}"),
        }
    } else if w == "merged" {
        match merged_track(f) {
            Ok(t) => println(f"  merged: {track_repr(t)}"),
            Err(e) => println(f"  merged: {failure(e)}"),
        }
    }
}

fn ints_repr_list(xs: ref Vec[i64]) -> String {
    repr(V.List(int_list(xs)))
}

fn msgs_repr(ms: ref Vec[Msg]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for m in ms.iter() {
        parts.push(msg_repr(m));
    }
    f"[{join(parts, ", ")}]"
}

fn opt_msg_repr(m: ref Option[Msg]) -> String {
    match m {
        Some(x) => msg_repr(x),
        None => "None".to_string(),
    }
}

fn read_or_empty(p: ref String) -> Vec[u8] {
    match fs.read_bytes(p.clone()) {
        Ok(b) => b,
        Err(_) => Vec.new(),
    }
}

fn track_items(env: ref Env, names: ref Vec[String]) -> Vec[Vec[Msg]] {
    let mut out: Vec[Vec[Msg]] = Vec.new();
    for n in names.iter() {
        out.push(env.track(n));
    }
    out
}

fn step_msgs(st: ref Vec[J], env: mut ref Env) -> Result[bool, Exc] {
    let op = jtext(st[0]);
    let o = op.as_str();
    if o == "msg" or o == "meta" {
        let v = jtext(st[1]);
        let kind = jtext(st[2]);
        let (kw, skip) = split_skip(kwargs(st[3]));
        let r = if o == "msg" { new_message(kind, kw, skip.unwrap_or(false)) } else { new_meta(kind, kw, skip.unwrap_or(false)) };
        match r {
            Ok(m) => {
                println(f"  {v} = {msg_repr(m)}");
                env.put(v, Obj.M(m));
            }
            Err(e) => println(f"  {v}: {failure(e)}"),
        }
    } else if o == "unknown" {
        let v = jtext(st[1]);
        let m = new_unknown(from_j(st[2]), from_j(st[3]), from_j(st[4]), V.Str("unknown_meta".to_string()))?;
        println(f"  {v} = {msg_repr(m)}");
        env.put(v, Obj.M(m));
    } else if o == "from_bytes" or o == "from_hex" or o == "from_str" or o == "meta_bytes" {
        let v = jtext(st[1]);
        let r = if o == "from_bytes" {
            from_bytes(ints_of(from_j(st[2])), from_j(st[3]))
        } else if o == "from_hex" {
            let sep = match st[3] {
                J.Str(t) => Some(t.clone()),
                _ => None,
            };
            from_hex(jtext(st[2]), sep)
        } else if o == "from_str" {
            from_str(jtext(st[2]))
        } else {
            meta_from_bytes(ints_of(from_j(st[2])))
        };
        match r {
            Ok(m) => {
                println(f"  {v} = {msg_repr(m)}");
                env.put(v, Obj.M(m));
            }
            Err(e) => println(f"  {v}: {failure(e)}"),
        }
    } else if o == "show" {
        let v = jtext(st[1]);
        if env.find(v).is_none() {
            println(f"  {v}: no value");
            return Ok(true);
        }
        let m = env.msg(v);
        for i in 2..st.len() {
            let what = jtext(st[i]);
            match show_value(what, m) {
                Ok(t) => println(f"  {v}.{what}: {t}"),
                Err(e) => println(f"  {v}.{what}: {failure(e)}"),
            }
        }
    } else if o == "set" {
        let v = jtext(st[1]);
        let name = jtext(st[2]);
        let value = from_j(st[3]);
        let mut m = env.msg(v);
        match set_attr(mut m, name, value) {
            Ok(_) => {
                println(f"  {v}.{name} = {repr(value)}: ok");
                env.put(v, Obj.M(m));
            }
            Err(e) => println(f"  {v}.{name} = {repr(value)}: {failure(e)}"),
        }
    } else if o == "copy" {
        let v = jtext(st[1]);
        let new = jtext(st[2]);
        let (kw, skip) = split_skip(kwargs(st[3]));
        match msg_copy(env.msg(v), kw, skip) {
            Ok(m) => {
                println(f"  {new} = {msg_repr(m)}");
                env.put(new, Obj.M(m));
            }
            Err(e) => println(f"  {new}: {failure(e)}"),
        }
    } else if o == "eq" {
        let a = jtext(st[1]);
        let b = jtext(st[2]);
        println(f"  {a} == {b}: {bool_str(msg_eq(env.msg(a), env.msg(b)))}");
    } else if o == "eq_val" {
        let a = jtext(st[1]);
        let x = from_j(st[2]);
        println(f"  {a} == {repr(x)}: TypeError: can't compare message to <class '{type_name(x)}'>");
    } else if o == "format" {
        let a = jtext(st[1]);
        let t = match st[2] {
            J.Bool(b) => *b,
            _ => false,
        };
        let m = env.msg(a);
        println(f"  format_as_string({a}, include_time={bool_str(t)}): {str_repr(msg2str(m.vars, t))}");
    } else if o == "freeze" or o == "thaw" {
        let a = jtext(st[1]);
        let b = jtext(st[2]);
        let m = env.msg(a);
        let out = if o == "freeze" { freeze(m) } else { thaw(m) };
        println(f"  {b} = {msg_repr(out)}");
        env.put(b, Obj.M(out));
    } else {
        return Ok(false);
    }
    Ok(true)
}

fn step_parse(st: ref Vec[J], env: mut ref Env) -> Result[bool, Exc] {
    let op = jtext(st[0]);
    let o = op.as_str();
    if o == "parse" or o == "parse_all" {
        let data = items_of(from_j(st[1]))?;
        let shown = repr(V.List(data.clone()));
        if o == "parse" {
            let mut p = new_parser();
            match parser_feed(mut p, data) {
                Ok(_) => println(f"  parse {shown}: {opt_msg_repr(parser_get(mut p))}"),
                Err(e) => println(f"  parse {shown}: {failure(e)}"),
            }
        } else {
            match parse_all(data) {
                Ok(ms) => println(f"  parse_all {shown}: {msgs_repr(ms)}"),
                Err(e) => println(f"  parse_all {shown}: {failure(e)}"),
            }
        }
    } else if o == "parser" {
        let v = jtext(st[1]);
        env.put(v, Obj.P(new_parser()));
        println(f"  {v} = Parser()");
    } else if o == "feed" or o == "feed_byte" {
        let v = jtext(st[1]);
        let x = from_j(st[2]);
        let mut p = env.parser(v);
        let r = if o == "feed" { parser_feed(mut p, items_of(x)?) } else { parser_feed_byte(mut p, x) };
        match r {
            Ok(_) => println(f"  {o} {repr(x)}: ok"),
            Err(e) => println(f"  {o} {repr(x)}: {failure(e)}"),
        }
        env.put(v, Obj.P(p));
    } else if o == "pending" {
        let p = env.parser(jtext(st[1]));
        println(f"  pending: {p.messages.len()}");
    } else if o == "get" {
        let v = jtext(st[1]);
        let mut p = env.parser(v);
        let m = parser_get(mut p);
        println(f"  get_message: {opt_msg_repr(m)}");
        env.put(v, Obj.P(p));
    } else if o == "drain" {
        let v = jtext(st[1]);
        let mut p = env.parser(v);
        let ms = p.messages.clone();
        p.messages = Vec.new();
        println(f"  drained: {msgs_repr(ms)}");
        env.put(v, Obj.P(p));
    } else if o == "tokenize" {
        let data = items_of(from_j(st[1]))?;
        let mut t = new_tokenizer();
        tok_feed(mut t, data)?;
        let mut parts: Vec[String] = Vec.new();
        for b in t.messages.iter() {
            parts.push(ints_repr_list(b));
        }
        println(f"  tokens of {repr(V.List(data))}: [{join(parts, ", ")}]");
    } else if o == "stream" {
        println("  stream:");
        let mut lines: Vec[String] = Vec.new();
        for x in jitems(st[1]).iter() {
            lines.push(jtext(x));
        }
        let s = parse_string_stream(lines);
        for it in s.items.iter() {
            match it {
                Ok(m) => println(f"    {msg_repr(m)}, None"),
                Err(t) => println(f"    None, {str_repr(t)}"),
            }
        }
        if let Some(e) = s.stop {
            println(f"    {failure(e)}");
        }
    } else {
        return Ok(false);
    }
    Ok(true)
}

// parse_string_stream: each line's message, or the error for it. An
// error that is not a ValueError stops the stream, after the lines
// before it.
struct Stream {
    items: Vec[Result[Msg, String]],
    stop: Option[Exc],
}

fn parse_string_stream(lines: ref Vec[String]) -> Stream {
    let mut out: Vec[Result[Msg, String]] = Vec.new();
    let mut n = 0;
    for raw in lines.iter() {
        n += 1;
        let mut line = raw.clone();
        let hash = find_str(line, "#");
        if hash >= 0 {
            line = slice(line, 0, hash);
        }
        line = py_strip(line);
        if line.len() == 0 {
            continue;
        }
        match from_str(line) {
            Ok(m) => out.push(Ok(m)),
            Err(e) => {
                if e.kind == "ValueError" {
                    out.push(Err(f"line {n}: {e.msg}"));
                } else {
                    return Stream { items: out, stop: Some(e) };
                }
            }
        }
    }
    Stream { items: out, stop: None }
}

fn step_units(st: ref Vec[J]) -> Result[bool, Exc] {
    let op = jtext(st[0]);
    let o = op.as_str();
    if o == "t2s" or o == "s2t" {
        let a = from_j(st[1]);
        let b = from_j(st[2]);
        let c = from_j(st[3]);
        let mut args: Vec[V] = Vec.new();
        args.push(a.clone());
        args.push(b.clone());
        args.push(c.clone());
        let shown = repr(V.Tuple(args));
        if o == "t2s" {
            match tick2second(a, b, c) {
                Ok(x) => println(f"  tick2second{shown}: {float_repr(x)}"),
                Err(e) => println(f"  tick2second{shown}: {failure(e)}"),
            }
        } else {
            match second2tick(a, b, c) {
                Ok(x) => println(f"  second2tick{shown}: {x}"),
                Err(e) => println(f"  second2tick{shown}: {failure(e)}"),
            }
        }
    } else if o == "bpm2tempo" or o == "tempo2bpm" {
        let a = from_j(st[1]);
        let mut args: Vec[V] = Vec.new();
        args.push(a.clone());
        let mut ts1 = 4;
        match st[2] {
            J.Null => {}
            _ => {
                let ts = items_of(from_j(st[2]))?;
                ts1 = int_of(ts[1]);
                args.push(V.Tuple(ts));
            }
        }
        let shown = repr(V.Tuple(args));
        if o == "bpm2tempo" {
            match bpm2tempo(a, ts1) {
                Ok(x) => println(f"  {o}{shown}: {x}"),
                Err(e) => println(f"  {o}{shown}: {failure(e)}"),
            }
        } else {
            match tempo2bpm(a, ts1) {
                Ok(x) => println(f"  {o}{shown}: {float_repr(x)}"),
                Err(e) => println(f"  {o}{shown}: {failure(e)}"),
            }
        }
    } else if o == "varint" {
        let a = from_j(st[1]);
        match encode_variable_int(a) {
            Ok(xs) => println(f"  encode_variable_int({repr(a)}): {ints_repr_list(xs)}"),
            Err(e) => println(f"  encode_variable_int({repr(a)}): {failure(e)}"),
        }
    } else if o == "devarint" {
        let xs = ints_of(from_j(st[1]));
        println(f"  decode_variable_int({ints_repr_list(xs)}): {decode_variable_int(xs)}");
    } else if o == "signed" or o == "unsigned" {
        let t = jtext(st[1]);
        let n = int_of(from_j(st[2]));
        let to = if o == "signed" { t.clone() } else { f"u{t}" };
        match signed_conv(to, n) {
            Ok(x) => println(f"  {o}({str_repr(t)}, {n}): {x}"),
            Err(e) => println(f"  {o}({str_repr(t)}, {n}): {failure(e)}"),
        }
    } else {
        return Ok(false);
    }
    Ok(true)
}

fn step_tracks(st: ref Vec[J], env: mut ref Env) -> Result[bool, Exc] {
    let op = jtext(st[0]);
    let o = op.as_str();
    if o == "track" {
        let v = jtext(st[1]);
        let names = jnames(st[2]);
        let mut t: Vec[Msg] = Vec.new();
        for n in names.iter() {
            t.push(env.msg(n));
        }
        println(f"  {v} = MidiTrack of {names.len()}");
        env.put(v, Obj.T(t));
    } else if o == "tshow" {
        let v = jtext(st[1]);
        let t = env.track(v);
        for i in 2..st.len() {
            let what = jtext(st[i]);
            if what == "repr" {
                println(f"  {v}.repr:");
                print_lines(track_repr(t), "    ");
            } else if what == "len" {
                println(f"  {v}.len: {t.len()}");
            } else if what == "name" {
                println(f"  {v}.name: {repr(track_name(t))}");
            }
        }
    } else if o == "tname" {
        let v = jtext(st[1]);
        let name = from_j(st[2]);
        let mut t = env.track(v);
        match set_track_name(mut t, name) {
            Ok(_) => {
                println(f"  {v}.name = {repr(name)}: ok");
                env.put(v, Obj.T(t));
            }
            Err(e) => println(f"  {v}.name = {repr(name)}: {failure(e)}"),
        }
    } else if o == "tslice" {
        let v = jtext(st[1]);
        let w = jtext(st[2]);
        let lo = int_of(from_j(st[3]));
        let hi = int_of(from_j(st[4]));
        let t = env.track(v);
        let mut out: Vec[Msg] = Vec.new();
        let mut i = lo;
        while i < hi and i < t.len() {
            out.push(t[i].clone());
            i += 1;
        }
        println(f"  {w} = {v}[{lo}:{hi}]");
        env.put(w, Obj.T(out));
    } else if o == "tindex" {
        let v = jtext(st[1]);
        let i = int_of(from_j(st[2]));
        let w = jtext(st[3]);
        let t = env.track(v);
        let k = if i < 0 { i + t.len() } else { i };
        if k < 0 or k >= t.len() {
            println(f"  {w}: IndexError: list index out of range");
        } else {
            println(f"  {w} = {v}[{i}]");
            env.put(w, Obj.M(t[k].clone()));
        }
    } else if o == "tadd" {
        let a = jtext(st[1]);
        let b = jtext(st[2]);
        let w = jtext(st[3]);
        let mut t = env.track(a);
        for m in env.track(b).into_iter() {
            t.push(m);
        }
        println(f"  {w} = {a} + {b}");
        env.put(w, Obj.T(t));
    } else if o == "tmul" {
        let a = jtext(st[1]);
        let n = int_of(from_j(st[2]));
        let w = jtext(st[3]);
        let src = env.track(a);
        let mut t: Vec[Msg] = Vec.new();
        for _k in 0..n {
            for m in src.iter() {
                t.push(m.clone());
            }
        }
        println(f"  {w} = {a} * {n}");
        env.put(w, Obj.T(t));
    } else if o == "tappend" {
        let a = jtext(st[1]);
        let b = jtext(st[2]);
        let mut t = env.track(a);
        t.push(env.msg(b));
        println(f"  {a}.append({b})");
        env.put(a, Obj.T(t));
    } else if o == "fix_eot" {
        let a = jtext(st[1]);
        let b = jtext(st[2]);
        let t = fix_end_of_track(env.track(a), false)?;
        println(f"  {b} = fix_end_of_track({a})");
        env.put(b, Obj.T(t));
    } else if o == "merge" {
        let v = jtext(st[1]);
        let names = jnames(st[2]);
        let skip = match st[3] {
            J.Bool(b) => *b,
            _ => false,
        };
        match merge_tracks(track_items(env, names), skip) {
            Ok(t) => {
                println(f"  {v} = merge_tracks({join(names, ", ")})");
                env.put(v, Obj.T(t));
            }
            Err(e) => println(f"  {v}: {failure(e)}"),
        }
    } else {
        return Ok(false);
    }
    Ok(true)
}

fn step_files(st: ref Vec[J], env: mut ref Env) -> Result[bool, Exc] {
    let op = jtext(st[0]);
    let o = op.as_str();
    if o == "file" {
        let v = jtext(st[1]);
        let kw = kwargs(st[2]);
        let kind = int_of(kw_val(kw, "type").unwrap_or(V.Int(1)));
        let tpb = int_of(kw_val(kw, "ticks_per_beat").unwrap_or(V.Int(480)));
        let charset = text_val(kw_val(kw, "charset").unwrap_or(V.Str("latin1".to_string())));
        match new_file(kind, tpb, charset) {
            Ok(f) => {
                let mut f = f;
                f.tracks = track_items(env, jnames(st[3]));
                println(f"  {v} = MidiFile with {f.tracks.len()} tracks");
                env.put(v, Obj.F(f));
            }
            Err(e) => println(f"  {v}: {failure(e)}"),
        }
    } else if o == "add_track" {
        let v = jtext(st[1]);
        let name = from_j(st[2]);
        let mut f = env.file(v);
        let mut t: Vec[Msg] = Vec.new();
        match name {
            V.Nil => {}
            _ => set_track_name(mut t, name)?,
        }
        println(f"  add_track({repr(name)}): {track_repr(t)}");
        f.tracks.push(t);
        env.put(v, Obj.F(f));
    } else if o == "save" {
        let v = jtext(st[1]);
        let p = jtext(st[2]);
        match save_file(env.file(v), data_path(p)) {
            Ok(b) => {
                println(f"  saved {p}: {b.len()} bytes");
                hexdump(b, "    ");
            }
            Err(e) => println(f"  save {p}: {failure(e)}"),
        }
    } else if o == "load" {
        let v = jtext(st[1]);
        let p = jtext(st[2]);
        let kw = kwargs(st[3]);
        let charset = text_val(kw_val(kw, "charset").unwrap_or(V.Str("latin1".to_string())));
        let debug = truthy(kw_val(kw, "debug").unwrap_or(V.Bool(false)));
        let clip = truthy(kw_val(kw, "clip").unwrap_or(V.Bool(false)));
        match load_file(data_path(p), charset, debug, clip) {
            Ok(f) => {
                println(f"  {v} = {p}: type {f.kind}, {f.tracks.len()} tracks");
                env.put(v, Obj.F(f));
            }
            Err(e) => println(f"  {v}: {failure(e)}"),
        }
    } else if o == "fshow" {
        let v = jtext(st[1]);
        if env.find(v).is_none() {
            println(f"  {v}: no value");
            return Ok(true);
        }
        let f = env.file(v);
        for i in 2..st.len() {
            show_file(jtext(st[i]), f);
        }
    } else if o == "same_file" {
        let a = jtext(st[1]);
        let b = jtext(st[2]);
        let x = read_or_empty(data_path(a));
        let y = read_or_empty(data_path(b));
        println(f"  {a} == {b}: {bool_str(x == y)}");
    } else if o == "read_syx" {
        let p = jtext(st[1]);
        match read_syx(data_path(p)) {
            Ok(ms) => {
                println(f"  read_syx_file {p}: {ms.len()} messages");
                for m in ms.iter() {
                    println(f"    {msg_repr(m)}");
                }
            }
            Err(e) => println(f"  read_syx_file {p}: {failure(e)}"),
        }
    } else if o == "write_syx" {
        let p = jtext(st[1]);
        let mut ms: Vec[Msg] = Vec.new();
        for n in jnames(st[2]).iter() {
            ms.push(env.msg(n));
        }
        let plain = match st[3] {
            J.Bool(b) => *b,
            _ => false,
        };
        write_syx(data_path(p), ms, plain)?;
        println(f"  write_syx_file {p} plaintext={bool_str(plain)}");
    } else if o == "dump" {
        let p = jtext(st[1]);
        let b = read_or_empty(data_path(p));
        println(f"  {p}: {b.len()} bytes");
        hexdump(b, "    ");
    } else {
        return Ok(false);
    }
    Ok(true)
}

fn step_ports(st: ref Vec[J], env: mut ref Env) -> Result[bool, Exc] {
    let op = jtext(st[0]);
    let o = op.as_str();
    let v = jtext(st[1]);
    if o == "port" {
        let auto = match st[3] {
            J.Bool(b) => *b,
            _ => false,
        };
        let p = Port { name: jtext(st[2]), closed: false, autoreset: auto, messages: Vec.new() };
        println(f"  {v} = {port_repr(p)}");
        env.put(v, Obj.Pt(p));
        return Ok(true);
    }
    let mut p = env.port(v);
    if o == "prepr" {
        println(f"  {v}: {port_repr(p)}");
    } else if o == "send" {
        let n = jtext(st[2]);
        match port_send(mut p, env.msg(n)) {
            Ok(_) => println(f"  send {n}: ok"),
            Err(e) => println(f"  send {n}: {failure(e)}"),
        }
    } else if o == "send_new" {
        let kind = jtext(st[2]);
        let m = new_message(kind, kwargs(st[3]), false)?;
        port_send(mut p, m)?;
        println(f"  send {kind}: ok");
    } else if o == "poll" {
        println(f"  poll: {opt_msg_repr(port_poll(mut p))}");
    } else if o == "receive" {
        match port_receive(mut p) {
            Ok(m) => println(f"  receive: {msg_repr(m)}"),
            Err(e) => println(f"  receive: {failure(e)}"),
        }
    } else if o == "iter" {
        let ms = port_drain(mut p);
        println(f"  iter_pending: {ms.len()} messages");
        for m in ms.iter() {
            println(f"    {msg_str(m)}");
        }
    } else if o == "count" {
        println(f"  pending on {v}: {p.messages.len()}");
    } else if o == "close" {
        port_close(mut p);
        println(f"  closed {v}");
    } else if o == "reset" {
        port_reset(mut p);
        println(f"  reset {v}");
    } else if o == "panic" {
        port_panic(mut p);
        println(f"  panic {v}");
    } else {
        return Ok(false);
    }
    env.put(v, Obj.Pt(p));
    Ok(true)
}

fn run_step(st: ref Vec[J], env: mut ref Env) -> Result[(), Exc] {
    if step_msgs(st, mut env)? {
        return Ok(());
    }
    if step_parse(st, mut env)? {
        return Ok(());
    }
    if step_units(st)? {
        return Ok(());
    }
    if step_tracks(st, mut env)? {
        return Ok(());
    }
    if step_files(st, mut env)? {
        return Ok(());
    }
    if step_ports(st, mut env)? {
        return Ok(());
    }
    Err(exc("AssertionError", jtext(st[0])))
}

fn read_text(p: ref String) -> Result[String, Exc] {
    match fs.read_bytes(p.clone()) {
        Ok(b) => Ok(cps_string(utf8_decode(b)?)),
        Err(e) => Err(exc("OSError", f"{e}")),
    }
}

fn run_jobs() -> Result[(), Exc] {
    let text = read_text("data/jobs.jsonl".to_string())?;
    for line in text.lines() {
        if line.len() == 0 {
            continue;
        }
        let j = loads_str(line.to_string())?;
        println(f"== {jtext(jfield(j, "name"))}");
        let mut env = Env { names: Vec.new(), vals: Vec.new() };
        for st in jitems(jfield(j, "steps")).iter() {
            run_step(jitems(st), mut env)?;
        }
    }
    Ok(())
}

// ------------------------------------------------------------ programs

fn note_name(n: i64) -> String {
    let names = vec!["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];
    f"{names[n % 12]}{n / 12 - 1}"
}

// The files in data/<dir> whose names end in `ext`, sorted.
fn listing(dir: Str, ext: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    match fs.read_dir(f"data/{dir}") {
        Ok(names) => {
            for n in names.iter() {
                if n.ends_with(ext) {
                    out.push(n.clone());
                }
            }
        }
        Err(_) => {}
    }
    out.sort();
    out
}

struct Count {
    kind: String,
    n: i64,
}

fn bump(counts: mut ref Vec[Count], kind: ref String) {
    for c in counts.iter_mut() {
        if c.kind == *kind {
            c.n += 1;
            return;
        }
    }
    counts.push(Count { kind: kind.clone(), n: 1 });
}

fn sorted_counts(counts: own Vec[Count]) -> Vec[Count] {
    let mut out = counts;
    out.sort_by(|a, b| a.kind.cmp(b.kind));
    out
}

fn note_of(m: ref Msg) -> i64 {
    int_of(var_of(m, "note"))
}

fn channel_of(m: ref Msg) -> i64 {
    int_of(var_of(m, "channel"))
}

fn is_sounding_on(m: ref Msg) -> bool {
    msg_type(m) == "note_on" and int_of(var_of(m, "velocity")) > 0
}

fn report_track(i: i64, t: ref Vec[Msg]) {
    let mut counts: Vec[Count] = Vec.new();
    for m in t.iter() {
        bump(mut counts, msg_type(m));
    }
    let mut kinds: Vec[String] = Vec.new();
    for c in sorted_counts(counts).iter() {
        kinds.push(f"{c.kind} {c.n}");
    }
    let name = track_name(t);
    let label = if truthy(name) { name } else { V.Str("(no name)".to_string()) };
    println(f"  track {i} {repr(label)}: {t.len()} messages: {join(kinds, ", ")}");
    let mut notes: Vec[i64] = Vec.new();
    let mut chans: Vec[i64] = Vec.new();
    for m in t.iter() {
        if is_sounding_on(m) {
            notes.push(note_of(m));
        }
        if msg_type(m) == "note_on" and not chans.contains(channel_of(m)) {
            chans.push(channel_of(m));
        }
    }
    if notes.len() > 0 {
        chans.sort();
        let mut cs: Vec[String] = Vec.new();
        for c in chans.iter() {
            cs.push(f"{c}");
        }
        let mut lo = notes[0];
        let mut hi = notes[0];
        for n in notes.iter() {
            if *n < lo {
                lo = *n;
            }
            if *n > hi {
                hi = *n;
            }
        }
        println(f"    {notes.len()} notes on channel {join(cs, ", ")}, {note_name(lo)} to {note_name(hi)}");
    }
}

fn report_file(name: ref String, f: ref MidiFile) -> Result[(), Exc] {
    println(f"{name}: format {f.kind}, {f.tracks.len()} tracks, {f.tpb} ticks per beat");
    for i in 0..f.tracks.len() {
        report_track(i, f.tracks[i]);
    }
    if f.kind == 2 {
        println("  tracks play on their own; no tempo map or length");
        return Ok(());
    }
    let mut now = V.Int(0);
    let mut sounding: Vec[(i64, i64)] = Vec.new();
    for m in merged_track(f)? {
        now = num_add(now, var_of(m, "time"));
        let t = msg_type(m);
        if t == "set_tempo" {
            let bpm = tempo2bpm(var_of(m, "tempo"), 4)?;
            println(f"  tick {repr(now)}: {bpm:.2} bpm");
        } else if t == "time_signature" {
            println(f"  tick {repr(now)}: {pstr(var_of(m, "numerator"))}/{pstr(var_of(m, "denominator"))} time");
        } else if t == "key_signature" {
            println(f"  tick {repr(now)}: key of {pstr(var_of(m, "key"))}");
        } else if is_sounding_on(m) {
            let k = (channel_of(m), note_of(m));
            if not sounding.contains(k) {
                sounding.push(k);
            }
        } else if t == "note_on" or t == "note_off" {
            let k = (channel_of(m), note_of(m));
            let mut kept: Vec[(i64, i64)] = Vec.new();
            for s in sounding.iter() {
                if *s != k {
                    kept.push(*s);
                }
            }
            sounding = kept;
        }
    }
    let length = num_of(file_length(f)?);
    println(f"  ends at tick {repr(now)}, {length:.3} seconds");
    if sounding.len() > 0 {
        sounding.sort();
        let mut held: Vec[String] = Vec.new();
        for s in sounding.iter() {
            let (c, n) = *s;
            held.push(f"{note_name(n)} on {c}");
        }
        println(f"  still sounding at the end: {join(held, ", ")}");
    }
    Ok(())
}

fn report() -> Result[(), Exc] {
    println("== program: report");
    for name in listing("songs", ".mid").iter() {
        match load_file(f"data/songs/{name}", "latin1".to_string(), false, false) {
            Ok(f) => report_file(name, f)?,
            Err(e) => println(f"{name}: cannot read: {failure(e)}"),
        }
    }
    Ok(())
}

fn tracks_equal(a: ref Vec[Msg], b: ref Vec[Msg]) -> i64 {
    // How many of the zipped pairs differ.
    let mut diffs = 0;
    let mut i = 0;
    while i < a.len() and i < b.len() {
        if not msg_eq(a[i], b[i]) {
            diffs += 1;
        }
        i += 1;
    }
    diffs
}

fn one_override(name: Str, v: own V) -> Vec[Attr] {
    let mut kw: Vec[Attr] = Vec.new();
    kw.push(attr(name, v));
    kw
}

fn transpose() -> Result[(), Exc] {
    println("== program: transpose");
    let mut f = load_file("data/songs/minuet.mid".to_string(), "latin1".to_string(), false, false)?;
    let mut changed = 0;
    for ti in 0..f.tracks.len() {
        let mut t = f.tracks[ti].clone();
        for i in 0..t.len() {
            let m = t[i].clone();
            let kind = msg_type(m);
            if kind == "note_on" or kind == "note_off" {
                let ch = channel_of(m);
                let shift = if ch == 0 { 5 } else if ch == 1 { -12 } else { 0 };
                let n = note_of(m) + shift;
                if n >= 0 and n <= 127 {
                    t[i] = msg_copy(m, one_override("note", V.Int(n)), None)?;
                    changed += 1;
                }
            } else if kind == "set_tempo" {
                let bpm = tempo2bpm(var_of(m, "tempo"), 4)? * 1.25;
                let tempo = bpm2tempo(V.Float(bpm), 4)?;
                t[i] = msg_copy(m, one_override("tempo", V.Int(tempo)), None)?;
                println(f"  tempo {pstr(var_of(m, "tempo"))} -> {tempo} ({bpm:.2} bpm)");
            } else if kind == "key_signature" {
                t[i] = msg_copy(m, one_override("key", V.Str("C".to_string())), None)?;
            }
        }
        let name = track_name(t);
        if truthy(name) {
            set_track_name(mut t, V.Str(f"{text_val(name)} (in C)"))?;
        }
        f.tracks[ti] = t;
    }
    println(f"  {changed} note messages moved");
    let out = "data/out/minuet_in_c.mid".to_string();
    let b = save_file(f, out)?;
    let length = num_of(file_length(f)?);
    println(f"  saved out/minuet_in_c.mid: {b.len()} bytes, length {length:.3} seconds");
    let mut head: Vec[u8] = Vec.new();
    for i in 0..48 {
        if i < b.len() {
            head.push(b[i]);
        }
    }
    hexdump(head, "    ");
    let g = load_file(out, "latin1".to_string(), false, false)?;
    let mut same = true;
    let mut ti = 0;
    while ti < f.tracks.len() and ti < g.tracks.len() {
        if tracks_equal(f.tracks[ti], g.tracks[ti]) > 0 {
            same = false;
        }
        ti += 1;
    }
    println(f"  reloaded: {g.tracks.len()} tracks, same messages: {bool_str(same)}");
    let orig = load_file("data/songs/minuet.mid".to_string(), "latin1".to_string(), false, false)?;
    let mut i = 0;
    while i < orig.tracks.len() and i < g.tracks.len() {
        let tb = g.tracks[i].clone();
        let diffs = tracks_equal(orig.tracks[i], tb);
        println(f"  track {i} {repr(track_name(tb))}: {diffs} of {tb.len()} messages differ from the original");
        i += 1;
    }
    println("  first notes:");
    let mut shown = 0;
    for m in g.tracks[1].iter() {
        if msg_type(m) == "note_on" and shown < 6 {
            println(f"    {msg_str(m)} ({note_name(note_of(m))})");
            shown += 1;
        }
    }
    Ok(())
}

// d[lo:hi], as Python slices a tuple.
fn sl(d: ref Vec[i64], lo: i64, hi: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = if lo < 0 { 0 } else { lo };
    let end = if hi > d.len() { d.len() } else { hi };
    while i < end {
        out.push(d[i]);
        i += 1;
    }
    out
}

fn maker(b: i64) -> String {
    if b == 0x41 {
        "Roland".to_string()
    } else if b == 0x43 {
        "Yamaha".to_string()
    } else if b == 0x7e {
        "universal non-realtime".to_string()
    } else if b == 0x7f {
        "universal realtime".to_string()
    } else {
        f"maker 0x{b:02x}"
    }
}

fn describe(m: ref Msg) -> String {
    let d = ints_of(var_of(m, "data"));
    if d.len() == 0 {
        return "empty".to_string();
    }
    let who = maker(d[0]);
    let n = d.len();
    if d[0] == 0x41 and n >= 5 and d[3] == 0x12 {
        let addr = sl(d, 4, 8);
        let body = sl(d, 8, n - 1);
        let cs = d[n - 1];
        let mut total = 0;
        for x in addr.iter() {
            total += *x;
        }
        for x in body.iter() {
            total += *x;
        }
        let want = (128 - total % 128) % 128;
        let ok = if cs == want { "ok".to_string() } else { f"bad, want {want:02X}" };
        let mut text = String.new();
        for x in body.iter() {
            if *x >= 32 and *x < 127 {
                text.push(*x as u8 as char);
            } else {
                text.push('.');
            }
        }
        let mut ab: Vec[u8] = Vec.new();
        for x in addr.iter() {
            ab.push(*x as u8);
        }
        return f"{who} DT1 model 0x{d[2]:02x} device 0x{d[1]:02x} address {hex_lower(ab, "")} {body.len()} bytes {str_repr(text)} checksum {cs:02X} {ok}";
    }
    if d[0] == 0x7e and sl(d, 2, 4) == vec![0x09, 0x01] {
        return f"{who}: General MIDI on";
    }
    if d[0] == 0x7f and sl(d, 2, 4) == vec![0x04, 0x01] and n >= 6 {
        return f"{who}: master volume {d[4] | d[5] << 7}";
    }
    if d[0] == 0x43 and sl(d, 2, n) == vec![0x4c, 0x00, 0x00, 0x7e, 0x00] {
        return f"{who}: XG system on";
    }
    f"{who}: {n} bytes"
}

fn contains_msg(ms: ref Vec[Msg], m: ref Msg) -> bool {
    for x in ms.iter() {
        if msg_eq(x, m) {
            return true;
        }
    }
    false
}

fn msgs_eq(a: ref Vec[Msg], b: ref Vec[Msg]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if not msg_eq(a[i], b[i]) {
            return false;
        }
    }
    true
}

fn librarian() -> Result[(), Exc] {
    println("== program: librarian");
    let mut keep: Vec[Msg] = Vec.new();
    for name in listing("patches", ".syx").iter() {
        match read_syx(f"data/patches/{name}") {
            Ok(ms) => {
                println(f"{name}: {ms.len()} messages");
                for m in ms.iter() {
                    let line = describe(m);
                    println(f"  {line}");
                    if find_str(line, "bad") < 0 and not contains_msg(keep, m) {
                        keep.push(m.clone());
                    }
                }
            }
            Err(e) => println(f"{name}: {failure(e)}"),
        }
    }
    println(f"keeping {keep.len()} messages");
    write_syx("data/out/library.syx".to_string(), keep, false)?;
    write_syx("data/out/library.txt.syx".to_string(), keep, true)?;
    for p in vec!["out/library.syx", "out/library.txt.syx"] {
        let b = read_or_empty(f"data/{p}");
        let back = read_syx(f"data/{p}")?;
        println(f"{p}: {b.len()} bytes, reads back {back.len()} messages, same: {bool_str(msgs_eq(back, keep))}");
    }
    print(read_text("data/out/library.txt.syx".to_string())?);
    Ok(())
}

fn compose() -> Result[(), Exc] {
    println("== program: compose");
    let tempo = bpm2tempo(V.Int(100), 4)?;
    let tpb = 480;
    for name in listing("events", ".txt").iter() {
        let stem = slice(name, 0, chars(name).len() - 4);
        println(f"{stem}.txt:");
        let text = read_text(f"data/events/{name}")?;
        let mut lines: Vec[String] = Vec.new();
        for l in text.lines() {
            lines.push(l.to_string());
        }
        let s = parse_string_stream(lines);
        let mut msgs: Vec[Msg] = Vec.new();
        for it in s.items.iter() {
            match it {
                Ok(m) => msgs.push(m.clone()),
                Err(t) => println(f"  skipped: {t}"),
            }
        }
        if let Some(e) = s.stop {
            println(f"  stopped: {failure(e)}");
            continue;
        }
        let mut seconds = V.Float(0.0);
        let mut last = 0;
        let mut t: Vec[Msg] = Vec.new();
        set_track_name(mut t, V.Str(stem.clone()))?;
        let mut kw: Vec[Attr] = Vec.new();
        kw.push(attr("tempo", V.Int(tempo)));
        t.push(new_meta("set_tempo".to_string(), kw, false)?);
        for m in msgs.iter() {
            seconds = num_add(seconds, var_of(m, "time"));
            let tick = second2tick(seconds, V.Int(tpb), V.Int(tempo))?;
            t.push(copy_time(m, V.Int(tick - last), false)?);
            last = tick;
        }
        let mut f = new_file(1, tpb, "latin1".to_string())?;
        f.tracks.push(t);
        let out = f"out/{stem}.mid";
        save_file(f, data_path(out))?;
        let g = load_file(data_path(out), "latin1".to_string(), false, false)?;
        let size = read_or_empty(data_path(out)).len();
        let length = num_of(file_length(g)?);
        println(f"  {msgs.len()} messages, {repr(seconds)} seconds; saved {out}: {size} bytes, length {length:.3}");
        print_tracks(g, false);
    }
    Ok(())
}

fn thru() -> Result[(), Exc] {
    println("== program: thru");
    let mut port = Port { name: "thru".to_string(), closed: false, autoreset: true, messages: Vec.new() };
    println(f"  {port_repr(port)}");
    let f = load_file("data/songs/minuet.mid".to_string(), "latin1".to_string(), false, false)?;
    let mut sent = 0;
    let mut dropped = 0;
    let mut clock = V.Float(0.0);
    for m in play(f)? {
        clock = num_add(clock, var_of(m, "time"));
        if is_meta(m) {
            continue;
        }
        let kind = msg_type(m);
        if kind == "program_change" and channel_of(m) == 1 {
            dropped += 1;
            continue;
        }
        let mut out = m.clone();
        if is_sounding_on(m) and channel_of(m) == 0 {
            let v = (int_of(var_of(m, "velocity")) as f64 * 0.8) as i64;
            out = msg_copy(m, one_override("velocity", V.Int(v)), None)?;
        }
        port_send(mut port, out)?;
        sent += 1;
    }
    println(f"  sent {sent}, dropped {dropped}, played {repr(clock)} seconds");
    let pending = port_drain(mut port);
    let mut counts: Vec[Count] = Vec.new();
    for m in pending.iter() {
        bump(mut counts, msg_type(m));
    }
    for c in sorted_counts(counts).iter() {
        println(f"  received {c.n} {c.kind}");
    }
    let mut i = 0;
    while i < 5 and i < pending.len() {
        println(f"    {msg_str(pending[i])}");
        i += 1;
    }
    port_close(mut port);
    println(f"  {port_repr(port)}");
    let after = port_drain(mut port);
    println(f"  after close: {after.len()} pending, first {msg_str(after[0])}, last {msg_str(after[after.len() - 1])}");
    if let Err(e) = port_receive(mut port) {
        println(f"  receive: {failure(e)}");
    }
    Ok(())
}

fn run() -> Result[(), Exc] {
    if let Err(e) = fs.create_dir_all("data/out".to_string()) {
        return Err(exc("OSError", f"{e}"));
    }
    run_jobs()?;
    report()?;
    transpose()?;
    librarian()?;
    compose()?;
    thru()?;
    Ok(())
}

// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    v
}

fn data_part_0(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("note_on channel=0 note=60 velocity=90 time=0\n");
    t.push_str("note_off channel=0 note=60 time=0.5\n");
    t.push_str("noteon channel=0 note=62 time=0\n");
    t.push_str("note_on channel=0 note=64 time=0\n");
    v.push(DataFile { path: "events/broken.txt".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("note_on channel=1 note=48 velocity=70 time=0\n");
    t.push_str("note_on channel=1 note=55 velocity=70 time=0\n");
    t.push_str("note_on channel=1 note=64 velocity=70 time=0\n");
    t.push_str("note_off channel=1 note=48 time=1.2\n");
    t.push_str("note_off channel=1 note=55 time=0\n");
    t.push_str("note_off channel=1 note=64 time=0\n");
    t.push_str("note_on channel=1 note=50 velocity=70 time=0\n");
    t.push_str("note_off channel=1 note=50 time=+1\n");
    t.push_str("aftertouch channel=1 value=40 time=0.25\n");
    v.push(DataFile { path: "events/chords.txt".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("# a riff for the compose program: one message a line, as str(msg)\n");
    t.push_str("# writes it; time is the gap in seconds since the line before.\n");
    t.push_str("program_change channel=0 program=24 time=0\n");
    t.push_str("control_change channel=0 control=7 value=100 time=0\n");
    t.push_str("note_on channel=0 note=64 velocity=90 time=0\n");
    t.push_str("note_off channel=0 note=64 velocity=64 time=0.3\n");
    t.push_str("note_on channel=0 note=67 velocity=90 time=0\n");
    t.push_str("note_off channel=0 note=67 velocity=64 time=0.3   # a held note\n");
    t.push_str("note_on channel=0 note=69 velocity=95 time=0\n");
    t.push_str("note_on channel=16 note=60 velocity=90 time=0\n");
    t.push_str("note_off channel=0 note=69 velocity=64 time=0.6\n");
    t.push_str("pitchwheel channel=0 pitch=9000 time=0\n");
    t.push_str("pitchwheel channel=0 pitch=-2048 time=0.05\n");
    t.push_str("pitchwheel channel=0 pitch=0 time=0.05\n");
    t.push_str("note_on channel=0 note=6O velocity=90 time=0\n");
    t.push_str("sysex data=(65,16,66,18) time=0.1\n");
    t.push_str("sysex data=1,2,3 time=0\n");
    t.push_str("note_on channel=0 note time=0\n");
    t.push_str("\n");
    t.push_str("note_on channel=0 note=72 velocity=100 time=1_0e-1\n");
    t.push_str("note_off channel=0 note=72 velocity=64 time=0.45\n");
    t.push_str("control_change channel=0 control=64 value=127 time=0\n");
    t.push_str("control_change channel=0 control=64 value=0 time=1\n");
    v.push(DataFile { path: "events/riff.txt".to_string(), hex: false, body: t });
    let mut t = String.new();
    t.push_str("{\"name\": \"note_on with defaults\", \"steps\": [[\"msg\", \"m\", \"note_on\", {}], [\"show\", \"m\", \"repr\", \"str\", \"bytes\", \"hex\", \"len\", \"dict\", \"is_meta\", \"is_realtime\", \"is_cc\"]]}\n");
    t.push_str("{\"name\": \"note_on with values\", \"steps\": [[\"msg\", \"m\", \"note_on\", {\"channel\": 9, \"note\": 36, \"velocity\": 100, \"time\": 12}], [\"show\", \"m\", \"repr\", \"str\", \"bytes\", \"hex\", \"len\", \"dict\", \"a:note\", \"a:channel\"]]}\n");
    t.push_str("{\"name\": \"note_off\", \"steps\": [[\"msg\", \"m\", \"note_off\", {\"note\": 60}], [\"show\", \"m\", \"repr\", \"hex\", \"dict\"]]}\n");
    t.push_str("{\"name\": \"every channel message\", \"steps\": [[\"msg\", \"a\", \"polytouch\", {\"channel\": 2, \"note\": 61, \"value\": 30}], [\"show\", \"a\", \"repr\", \"hex\", \"len\"], [\"msg\", \"b\", \"control_change\", {\"channel\": 3, \"control\": 7, \"value\": 90}], [\"show\", \"b\", \"repr\", \"hex\", \"is_cc\", \"is_cc=7\", \"is_cc=10\"], [\"msg\", \"c\", \"program_change\", {\"channel\": 4, \"program\": 19}], [\"show\", \"c\", \"repr\", \"hex\", \"len\"], [\"msg\", \"d\", \"aftertouch\", {\"channel\": 5, \"value\": 64}], [\"show\", \"d\", \"repr\", \"hex\", \"len\"], [\"msg\", \"e\", \"pitchwheel\", {\"channel\": 6, \"pitch\": -8192}], [\"show\", \"e\", \"repr\", \"hex\", \"len\"], [\"msg\", \"f\", \"pitchwheel\", {\"pitch\": 8191}], [\"show\", \"f\", \"hex\"], [\"msg\", \"g\", \"pitchwheel\", {\"pitch\": 0}], [\"show\", \"g\", \"hex\"]]}\n");
    t.push_str("{\"name\": \"system common messages\", \"steps\": [[\"msg\", \"a\", \"sysex\", {\"data\": [1, 2, 3]}], [\"show\", \"a\", \"repr\", \"str\", \"bytes\", \"hex\", \"len\", \"dict\"], [\"msg\", \"b\", \"quarter_frame\", {\"frame_type\": 3, \"frame_value\": 9}], [\"show\", \"b\", \"repr\", \"hex\", \"len\"], [\"msg\", \"c\", \"songpos\", {\"pos\": 16383}], [\"show\", \"c\", \"repr\", \"hex\", \"len\"], [\"msg\", \"d\", \"song_select\", {\"song\": 5}], [\"show\", \"d\", \"repr\", \"hex\"], [\"msg\", \"e\", \"tune_request\", {}], [\"show\", \"e\", \"repr\", \"hex\", \"is_realtime\"]]}\n");
    t.push_str("{\"name\": \"realtime messages\", \"steps\": [[\"msg\", \"a\", \"clock\", {}], [\"show\", \"a\", \"repr\", \"hex\", \"is_realtime\"], [\"msg\", \"b\", \"start\", {}], [\"show\", \"b\", \"hex\", \"is_realtime\"], [\"msg\", \"c\", \"continue\", {}], [\"show\", \"c\", \"hex\", \"is_realtime\"], [\"msg\", \"d\", \"stop\", {}], [\"show\", \"d\", \"hex\", \"is_realtime\"], [\"msg\", \"e\", \"active_sensing\", {}], [\"show\", \"e\", \"hex\", \"is_realtime\"], [\"msg\", \"f\", \"reset\", {}], [\"show\", \"f\", \"hex\", \"is_realtime\", \"len\"]]}\n");
    t.push_str("{\"name\": \"sysex data forms\", \"steps\": [[\"msg\", \"a\", \"sysex\", {}], [\"show\", \"a\", \"repr\", \"str\", \"len\", \"hex\"], [\"msg\", \"b\", \"sysex\", {\"data\": [125]}], [\"show\", \"b\", \"repr\", \"str\", \"dict\"], [\"msg\", \"c\", \"sysex\", {\"data\": {\"tuple\": [65, 16, 66]}}], [\"show\", \"c\", \"repr\", \"str\", \"bin\"], [\"msg\", \"d\", \"sysex\", {\"data\": \"AB\"}], [\"msg\", \"e\", \"sysex\", {\"data\": 5}], [\"msg\", \"f\", \"sysex\", {\"data\": [1, 200]}], [\"msg\", \"g\", \"sysex\", {\"data\": [true, false]}], [\"show\", \"g\", \"repr\", \"hex\", \"bytes\"]]}\n");
    t.push_str("{\"name\": \"hex with a separator\", \"steps\": [[\"msg\", \"m\", \"note_on\", {\"channel\": 1, \"note\": 60, \"velocity\": 127}], [\"show\", \"m\", \"hex\", \"hex/:\", \"hex/\", \"hex/ - \"]]}\n");
    t.push_str("{\"name\": \"bin keeps the bytes\", \"steps\": [[\"msg\", \"m\", \"note_on\", {\"note\": 60, \"velocity\": 64}], [\"show\", \"m\", \"bin\"], [\"msg\", \"q\", \"sysex\", {\"data\": [9, 10, 13, 39, 92, 34]}], [\"show\", \"q\", \"bin\"], [\"msg\", \"r\", \"sysex\", {\"data\": [39]}], [\"show\", \"r\", \"bin\"], [\"msg\", \"s\", \"sysex\", {\"data\": [39, 34]}], [\"show\", \"s\", \"bin\"]]}\n");
    t.push_str("{\"name\": \"unknown type\", \"steps\": [[\"msg\", \"m\", \"note_up\", {}], [\"msg\", \"n\", \"Note_on\", {}]]}\n");
    t.push_str("{\"name\": \"checks on values\", \"steps\": [[\"msg\", \"a\", \"note_on\", {\"channel\": 16}], [\"msg\", \"b\", \"note_on\", {\"channel\": -1}], [\"msg\", \"c\", \"note_on\", {\"channel\": 1.0}], [\"msg\", \"d\", \"note_on\", {\"note\": 128}], [\"msg\", \"e\", \"note_on\", {\"velocity\": \"loud\"}], [\"msg\", \"f\", \"note_on\", {\"note\": null}], [\"msg\", \"g\", \"pitchwheel\", {\"pitch\": 8192}], [\"msg\", \"h\", \"pitchwheel\", {\"pitch\": 1.5}], [\"msg\", \"i\", \"songpos\", {\"pos\": 16384}], [\"msg\", \"j\", \"songpos\", {\"pos\": \"1\"}], [\"msg\", \"k\", \"quarter_frame\", {\"frame_type\": 8}], [\"msg\", \"l\", \"quarter_frame\", {\"frame_value\": 16}], [\"msg\", \"m\", \"quarter_frame\", {\"frame_type\": \"x\"}], [\"msg\", \"n\", \"program_change\", {\"program\": -3}]]}\n");
    t.push_str("{\"name\": \"bools pass as ints\", \"steps\": [[\"msg\", \"a\", \"note_on\", {\"channel\": true, \"note\": false, \"velocity\": true}], [\"show\", \"a\", \"repr\", \"str\", \"hex\", \"dict\"], [\"msg\", \"b\", \"pitchwheel\", {\"pitch\": true}], [\"show\", \"b\", \"repr\", \"hex\"]]}\n");
    t.push_str("{\"name\": \"time checks\", \"steps\": [[\"msg\", \"a\", \"clock\", {\"time\": 0.25}], [\"show\", \"a\", \"repr\", \"str\"], [\"msg\", \"b\", \"clock\", {\"time\": -3}], [\"show\", \"b\", \"repr\"], [\"msg\", \"c\", \"clock\", {\"time\": true}], [\"show\", \"c\", \"repr\"], [\"msg\", \"d\", \"clock\", {\"time\": \"now\"}], [\"msg\", \"e\", \"clock\", {\"time\": null}], [\"msg\", \"f\", \"clock\", {\"time\": 1e-05}], [\"show\", \"f\", \"repr\", \"str\"], [\"msg\", \"g\", \"clock\", {\"time\": 123456789.5}], [\"show\", \"g\", \"repr\"], [\"msg\", \"h\", \"clock\", {\"time\": 1e+16}], [\"show\", \"h\", \"repr\"]]}\n");
    t.push_str("{\"name\": \"unknown attribute\", \"steps\": [[\"msg\", \"a\", \"note_on\", {\"pitch\": 3}], [\"msg\", \"b\", \"clock\", {\"channel\": 0}], [\"msg\", \"c\", \"note_on\", {\"channel\": 99, \"pitch\": 3}], [\"msg\", \"d\", \"note_on\", {\"pitch\": 3, \"channel\": 99}], [\"msg\", \"e\", \"note_on\", {\"time\": \"x\", \"pitch\": 3}]]}\n");
    t.push_str("{\"name\": \"skip_checks lets anything in\", \"steps\": [[\"msg\", \"a\", \"note_on\", {\"channel\": 99, \"note\": -5, \"skip_checks\": true}], [\"show\", \"a\", \"repr\", \"str\", \"dict\"], [\"msg\", \"b\", \"note_on\", {\"pitch\": 3, \"skip_checks\": true}], [\"show\", \"b\", \"repr\", \"dict\"], [\"msg\", \"c\", \"note_on\", {\"channel\": 20, \"note\": 1, \"velocity\": 2, \"skip_checks\": true}], [\"show\", \"c\", \"hex\"]]}\n");
