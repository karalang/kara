    s.push_str("stem\tdisabled\n");
    s.push_str("stem\tcontrolling\n");
    s.push_str("stem\thappy\n");
    s.push_str("stem\tsky\n");
    s.push_str("stem\tcry\n");
    s.push_str("stem\tcrying\n");
