// mini_snowball — a port of snowballstemmer 3.1.1 (BSD-3-Clause; Dr Martin
// Porter and the Snowball project), the stemming library used across search
// and NLP to collapse inflected words to a common root. This port is its
// English **Porter** stemmer, generated by Snowball from porter.sbl.
//
// It follows basestemmer.py and porter_stemmer.py exactly: the snowball string
// cursor (cursor / limit / limit_backward / bra / ket over a byte buffer), the
// Among-table suffix lookup (here a longest-matching-suffix scan, which is what
// find_among_b computes when every table entry has method=None, as all six
// Porter tables do), the slice splice operations, the backward grouping scans,
// and the eight r_Step state functions. The snowball `lab` gotos are rewritten
// as plain flags and if/else; the forward y->Y consonant mapping and its final
// restore are written as direct scans. Words are ASCII lowercase. See README.md.

fn str_bytes(s: String) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for b in s.bytes() {
        v.push(b);
    }
    v
}

// The snowball string-cursor state (BaseStemmer): `cur` is the working buffer,
// `limit` its logical length, `lb` the backward limit, `bra`/`ket` the slice
// bracket, `p1`/`p2` the R1/R2 region boundaries.
struct St {
    cur: Vec[u8],
    cursor: i64,
    limit: i64,
    lb: i64,
    bra: i64,
    ket: i64,
    p1: i64,
    p2: i64,
}

fn st_new(word: String) -> St {
    let cur = str_bytes(word);
    let n = cur.len();
    St { cur: cur, cursor: 0, limit: n, lb: 0, bra: 0, ket: n, p1: 0, p2: 0 }
}

// Group membership: which == 0 is g_v {a,e,i,o,u,y}; which == 1 is
// g_v_WXY {Y,a,e,i,o,u,w,x,y}.
fn in_group(b: u8, which: i64) -> bool {
    if which == 0 {
        b == 97 or b == 101 or b == 105 or b == 111 or b == 117 or b == 121
    } else {
        b == 89 or b == 97 or b == 101 or b == 105 or b == 111 or b == 117
            or b == 119 or b == 120 or b == 121
    }
}

// replace_s: splice `s` in for cur[c_bra:c_ket], adjusting limit and cursor
// exactly as BaseStemmer.replace_s does. Returns the length adjustment.
fn replace_s(st: mut ref St, c_bra: i64, c_ket: i64, s: ref Vec[u8]) -> i64 {
    let adj = s.len() - (c_ket - c_bra);
    let mut nv: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < c_bra {
        nv.push(st.cur[i]);
        i = i + 1;
    }
    let mut k = 0;
    while k < s.len() {
        nv.push(s[k]);
        k = k + 1;
    }
    let mut j = c_ket;
    let n = st.cur.len();
    while j < n {
        nv.push(st.cur[j]);
        j = j + 1;
    }
    st.cur = nv;
    st.limit = st.limit + adj;
    if st.cursor >= c_ket {
        st.cursor = st.cursor + adj;
    } else if st.cursor > c_bra {
        st.cursor = c_bra;
    }
    adj
}

fn slice_from(st: mut ref St, s: ref Vec[u8]) {
    let b = st.bra;
    let k = st.ket;
    replace_s(mut st, b, k, s);
    st.ket = st.bra + s.len();
}

fn slice_del(st: mut ref St) {
    let e: Vec[u8] = Vec.new();
    slice_from(mut st, e);
}

// insert "e" at the cursor (snowball insert(cursor,cursor,"e")); bra/ket shift.
fn insert_e(st: mut ref St) {
    let mut e: Vec[u8] = Vec.new();
    e.push(101);
    let cb = st.cursor;
    let adj = replace_s(mut st, cb, cb, e);
    if cb <= st.bra {
        st.bra = st.bra + adj;
    }
    if cb <= st.ket {
        st.ket = st.ket + adj;
    }
}

// ---------------- backward grouping scans ----------------

fn out_grouping_b(st: mut ref St, which: i64) -> bool {
    if st.cursor <= st.lb {
        false
    } else {
        let b = st.cur[st.cursor - 1];
        if in_group(b, which) {
            false
        } else {
            st.cursor = st.cursor - 1;
            true
        }
    }
}

fn in_grouping_b(st: mut ref St, which: i64) -> bool {
    if st.cursor <= st.lb {
        false
    } else {
        let b = st.cur[st.cursor - 1];
        if in_group(b, which) {
            st.cursor = st.cursor - 1;
            true
        } else {
            false
        }
    }
}

fn go_out_grouping_b(st: mut ref St, which: i64) -> bool {
    let mut found = false;
    let mut go = true;
    while go and st.cursor > st.lb {
        let b = st.cur[st.cursor - 1];
        if in_group(b, which) {
            found = true;
            go = false;
        } else {
            st.cursor = st.cursor - 1;
        }
    }
    found
}

// ---------------- longest-suffix lookup (find_among_b) ----------------

// If cur ends with `s` at the cursor (within lb), move the cursor back past it
// and return true; otherwise leave the cursor untouched and return false.
fn take_b(st: mut ref St, s: String) -> bool {
    let sb = str_bytes(s);
    let n = sb.len();
    let mut ok = st.cursor - n >= st.lb;
    if ok {
        let mut k = 0;
        while k < n {
            if st.cur[st.cursor - n + k] != sb[k] {
                ok = false;
                k = n;
            } else {
                k = k + 1;
            }
        }
    }
    if ok {
        st.cursor = st.cursor - n;
    }
    ok
}

// The six Porter Among tables, each tried longest-suffix first (which reproduces
// find_among_b for method-free tables). 0 means "no entry matched".

fn fa_a0(st: mut ref St) -> i64 {
    if take_b(mut st, "sses") { 1 }
    else if take_b(mut st, "ies") { 2 }
    else if take_b(mut st, "ss") { -1 }
    else if take_b(mut st, "s") { 3 }
    else { 0 }
}

fn fa_a1(st: mut ref St) -> i64 {
    if take_b(mut st, "bb") { 2 }
    else if take_b(mut st, "dd") { 2 }
    else if take_b(mut st, "ff") { 2 }
    else if take_b(mut st, "gg") { 2 }
    else if take_b(mut st, "mm") { 2 }
    else if take_b(mut st, "nn") { 2 }
    else if take_b(mut st, "pp") { 2 }
    else if take_b(mut st, "rr") { 2 }
    else if take_b(mut st, "tt") { 2 }
    else if take_b(mut st, "bl") { 1 }
    else if take_b(mut st, "at") { 1 }
    else if take_b(mut st, "iz") { 1 }
    else { 3 }
}

fn fa_a2(st: mut ref St) -> i64 {
    if take_b(mut st, "eed") { 1 }
    else if take_b(mut st, "ing") { 2 }
    else if take_b(mut st, "ed") { 2 }
    else { 0 }
}

fn fa_a3(st: mut ref St) -> i64 {
    if take_b(mut st, "ational") { 8 }
    else if take_b(mut st, "ization") { 7 }
    else if take_b(mut st, "iveness") { 12 }
    else if take_b(mut st, "fulness") { 10 }
    else if take_b(mut st, "ousness") { 11 }
    else if take_b(mut st, "tional") { 1 }
    else if take_b(mut st, "biliti") { 13 }
    else if take_b(mut st, "ation") { 8 }
    else if take_b(mut st, "alism") { 9 }
    else if take_b(mut st, "aliti") { 9 }
    else if take_b(mut st, "iviti") { 12 }
    else if take_b(mut st, "ousli") { 11 }
    else if take_b(mut st, "entli") { 5 }
    else if take_b(mut st, "enci") { 2 }
    else if take_b(mut st, "anci") { 3 }
    else if take_b(mut st, "abli") { 4 }
    else if take_b(mut st, "izer") { 7 }
    else if take_b(mut st, "ator") { 8 }
    else if take_b(mut st, "alli") { 9 }
    else if take_b(mut st, "eli") { 6 }
    else { 0 }
}

fn fa_a4(st: mut ref St) -> i64 {
    if take_b(mut st, "icate") { 2 }
    else if take_b(mut st, "ative") { 3 }
    else if take_b(mut st, "alize") { 1 }
    else if take_b(mut st, "iciti") { 2 }
    else if take_b(mut st, "ical") { 2 }
    else if take_b(mut st, "ness") { 3 }
    else if take_b(mut st, "ful") { 3 }
    else { 0 }
}

fn fa_a5(st: mut ref St) -> i64 {
    if take_b(mut st, "ement") { 1 }
    else if take_b(mut st, "ance") { 1 }
    else if take_b(mut st, "ence") { 1 }
    else if take_b(mut st, "able") { 1 }
    else if take_b(mut st, "ible") { 1 }
    else if take_b(mut st, "ment") { 1 }
    else if take_b(mut st, "ate") { 1 }
    else if take_b(mut st, "ive") { 1 }
    else if take_b(mut st, "ize") { 1 }
    else if take_b(mut st, "iti") { 1 }
    else if take_b(mut st, "ism") { 1 }
    else if take_b(mut st, "ion") { 2 }
    else if take_b(mut st, "ous") { 1 }
    else if take_b(mut st, "ant") { 1 }
    else if take_b(mut st, "ent") { 1 }
    else if take_b(mut st, "ic") { 1 }
    else if take_b(mut st, "al") { 1 }
    else if take_b(mut st, "er") { 1 }
    else if take_b(mut st, "ou") { 1 }
    else { 0 }
}

// Replacement strings for Step 2 (as_3) and Step 3 (as_4), by among result.
fn as3(av: i64) -> Vec[u8] {
    if av == 1 { str_bytes("tion") }
    else if av == 2 { str_bytes("ence") }
    else if av == 3 { str_bytes("ance") }
    else if av == 4 { str_bytes("able") }
    else if av == 5 { str_bytes("ent") }
    else if av == 6 { str_bytes("e") }
    else if av == 7 { str_bytes("ize") }
    else if av == 8 { str_bytes("ate") }
    else if av == 9 { str_bytes("al") }
    else if av == 10 { str_bytes("ful") }
    else if av == 11 { str_bytes("ous") }
    else if av == 12 { str_bytes("ive") }
    else { str_bytes("ble") }
}

fn as4(av: i64) -> Vec[u8] {
    if av == 1 { str_bytes("al") }
    else if av == 2 { str_bytes("ic") }
    else { str_bytes("") }
}

// ---------------- region tests and short-vowel check ----------------

fn r_r1(st: ref St) -> bool {
    st.p1 <= st.cursor
}

fn r_r2(st: ref St) -> bool {
    st.p2 <= st.cursor
}

fn r_shortv(st: mut ref St) -> bool {
    if out_grouping_b(mut st, 1) {
        if in_grouping_b(mut st, 0) {
            out_grouping_b(mut st, 0)
        } else {
            false
        }
    } else {
        false
    }
}

// ---------------- the eight Porter steps (backward processing) ----------------

fn step_1a(st: mut ref St) {
    st.ket = st.cursor;
    let av = fa_a0(mut st);
    if av == 0 {
    } else {
        st.bra = st.cursor;
        if av > 0 {
            let mut rep: Vec[u8] = Vec.new();
            if av == 1 {
                rep = str_bytes("ss");
            } else if av == 2 {
                rep = str_bytes("i");
            }
            slice_from(mut st, rep);
        }
    }
}

fn step_1b(st: mut ref St) {
    st.ket = st.cursor;
    let av = fa_a2(mut st);
    if av == 0 {
    } else {
        st.bra = st.cursor;
        if av == 1 {
            if r_r1(st) {
                let rep = str_bytes("ee");
                slice_from(mut st, rep);
            }
        } else {
            let v_1 = st.limit - st.cursor;
            if go_out_grouping_b(mut st, 0) {
                st.cursor = st.cursor - 1;
                st.cursor = st.limit - v_1;
                slice_del(mut st);
                let v_2 = st.limit - st.cursor;
                let av2 = fa_a1(mut st);
                st.cursor = st.limit - v_2;
                if av2 == 1 {
                    let c = st.cursor;
                    insert_e(mut st);
                    st.cursor = c;
                } else if av2 == 2 {
                    st.ket = st.cursor;
                    if st.cursor <= st.lb {
                    } else {
                        st.cursor = st.cursor - 1;
                        st.bra = st.cursor;
                        slice_del(mut st);
                    }
                } else {
                    if st.cursor != st.p1 {
                    } else {
                        let v_3 = st.limit - st.cursor;
                        if r_shortv(mut st) {
                            st.cursor = st.limit - v_3;
                            let c2 = st.cursor;
                            insert_e(mut st);
                            st.cursor = c2;
                        }
                    }
                }
            }
        }
    }
}

fn step_1c(st: mut ref St) {
    st.ket = st.cursor;
    let mut matched = false;
    if st.cursor > st.lb {
        let b = st.cur[st.cursor - 1];
        if b == 121 or b == 89 {
            st.cursor = st.cursor - 1;
            matched = true;
        }
    }
    if matched {
        st.bra = st.cursor;
        if go_out_grouping_b(mut st, 0) {
            st.cursor = st.cursor - 1;
            let rep = str_bytes("i");
            slice_from(mut st, rep);
        }
    }
}

fn step_2(st: mut ref St) {
    st.ket = st.cursor;
    let av = fa_a3(mut st);
    if av == 0 {
    } else {
        st.bra = st.cursor;
        if r_r1(st) {
            let rep = as3(av);
            slice_from(mut st, rep);
        }
    }
}

fn step_3(st: mut ref St) {
    st.ket = st.cursor;
    let av = fa_a4(mut st);
    if av == 0 {
    } else {
        st.bra = st.cursor;
        if r_r1(st) {
            let rep = as4(av);
            slice_from(mut st, rep);
        }
    }
}

fn step_4(st: mut ref St) {
    st.ket = st.cursor;
    let av = fa_a5(mut st);
    if av == 0 {
    } else {
        st.bra = st.cursor;
        if r_r2(st) {
            if av == 1 {
                slice_del(mut st);
            } else {
                let mut okst = false;
                if st.cursor > st.lb {
                    let b = st.cur[st.cursor - 1];
                    if b == 115 or b == 116 {
                        st.cursor = st.cursor - 1;
                        okst = true;
                    }
                }
                if okst {
                    slice_del(mut st);
                }
            }
        }
    }
}

fn step_5a(st: mut ref St) {
    st.ket = st.cursor;
    let mut has_e = false;
    if st.cursor > st.lb {
        if st.cur[st.cursor - 1] == 101 {
            has_e = true;
        }
    }
    if has_e {
        st.cursor = st.cursor - 1;
        st.bra = st.cursor;
        let mut ok = false;
        if r_r2(st) {
            ok = true;
        } else {
            if r_r1(st) {
                let v_1 = st.limit - st.cursor;
                if r_shortv(mut st) {
                    ok = false;
                } else {
                    st.cursor = st.limit - v_1;
                    ok = true;
                }
            }
        }
        if ok {
            slice_del(mut st);
        }
    }
}

fn step_5b(st: mut ref St) {
    st.ket = st.cursor;
    let mut has_l = false;
    if st.cursor > st.lb {
        if st.cur[st.cursor - 1] == 108 {
            has_l = true;
        }
    }
    if has_l {
        st.cursor = st.cursor - 1;
        st.bra = st.cursor;
        if r_r2(st) {
            let mut has_l2 = false;
            if st.cursor > st.lb {
                if st.cur[st.cursor - 1] == 108 {
                    has_l2 = true;
                }
            }
            if has_l2 {
                st.cursor = st.cursor - 1;
                slice_del(mut st);
            }
        }
    }
}

// ---------------- forward y-mapping and the R1/R2 region ----------------

// Replace a word-initial y, and any y preceded by a vowel, with Y (so those y's
// count as consonants). Returns whether any replacement happened.
fn mark_y(st: mut ref St) -> bool {
    let mut found = false;
    if st.limit > 0 {
        if st.cur[0] == 121 {
            st.cur[0] = 89 as u8;
            found = true;
        }
    }
    let mut i = 1;
    while i < st.limit {
        if in_group(st.cur[i - 1], 0) and st.cur[i] == 121 {
            st.cur[i] = 89 as u8;
            found = true;
        }
        i = i + 1;
    }
    found
}

// Advance past chars NOT in g_v; stop at (return the index of) the first vowel,
// or limit if none — snowball go_out_grouping over the forward string.
fn fscan_out(st: ref St, start: i64) -> i64 {
    let mut c = start;
    let mut go = true;
    while go and c < st.limit {
        if in_group(st.cur[c], 0) {
            go = false;
        } else {
            c = c + 1;
        }
    }
    c
}

// Advance past chars IN g_v; stop at the first consonant — go_in_grouping.
fn fscan_in(st: ref St, start: i64) -> i64 {
    let mut c = start;
    let mut go = true;
    while go and c < st.limit {
        if in_group(st.cur[c], 0) {
            c = c + 1;
        } else {
            go = false;
        }
    }
    c
}

fn compute_p1_p2(st: mut ref St) {
    st.p1 = st.limit;
    st.p2 = st.limit;
    let c1 = fscan_out(st, 0);
    if c1 < st.limit {
        let c3 = fscan_in(st, c1 + 1);
        if c3 < st.limit {
            st.p1 = c3 + 1;
            let c5 = fscan_out(st, c3 + 1);
            if c5 < st.limit {
                let c7 = fscan_in(st, c5 + 1);
                if c7 < st.limit {
                    st.p2 = c7 + 1;
                }
            }
        }
    }
}

fn restore_y(st: mut ref St) {
    let mut i = 0;
    while i < st.limit {
        if st.cur[i] == 89 {
            st.cur[i] = 121 as u8;
        }
        i = i + 1;
    }
}

// ---------------- the whole stemmer ----------------

fn stem(word: String) -> String {
    let mut st = st_new(word);
    let b_y = mark_y(mut st);
    compute_p1_p2(mut st);
    st.lb = 0;
    st.cursor = st.limit;
    step_1a(mut st);
    st.cursor = st.limit;
    step_1b(mut st);
    st.cursor = st.limit;
    step_1c(mut st);
    st.cursor = st.limit;
    step_2(mut st);
    st.cursor = st.limit;
    step_3(mut st);
    st.cursor = st.limit;
    step_4(mut st);
    st.cursor = st.limit;
    step_5a(mut st);
    st.cursor = st.limit;
    step_5b(mut st);
    if b_y {
        restore_y(mut st);
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < st.limit {
        out.push(st.cur[i]);
        i = i + 1;
    }
    String.from_utf8(out).unwrap_or("")
}

fn main_run() -> String {
    let data = jobs_text();
    let db = str_bytes(data.clone());
    let n = db.len();
    let mut out = String.new();
    let mut i = 0;
    let mut ls = 0;
    while i <= n {
        if i == n or db[i] == 10 {
            if i > ls {
                let line = data.substring(ls, i);
                let lb = str_bytes(line.clone());
                let mut tab = -1;
                let mut t = 0;
                while t < lb.len() {
                    if lb[t] == 9 {
                        tab = t;
                        t = lb.len();
                    } else {
                        t = t + 1;
                    }
                }
                if tab >= 0 {
                    let op = line.substring(0, tab);
                    let arg = line.substring(tab + 1, lb.len());
                    if op == "stem" {
                        out.push_str(stem(arg.clone()));
                        out.push_str("\n");
                    }
                }
            }
            ls = i + 1;
        }
        i = i + 1;
    }
    out
}

fn main() {
    print(main_run());
}

