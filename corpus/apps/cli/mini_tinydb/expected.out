['a', 'b', 'c']
> c['a']
1
> c.lru
['b', 'c', 'a']
> c['d'] = 4
> c.lru
['c', 'a', 'd']
> c.get('b')
None
> c.get('b', 'none')
none
> c['b']
error KeyError: 'b'
> len(c)
3
> c.length
3
> c['a'] = 0
> c.lru
['c', 'd', 'a']
> c['a']
0
> c.get('a')
0
> c['e'] = 5
> c.lru
['d', 'a', 'e']
> c['e'] = 6
> c.lru
['d', 'a', 'e']
> c.get('e')
6
> c.lru
['d', 'a', 'e']
> c.clear()
None
> c.lru
[]
> u = LRUCache()
> u['x'] = None
> u.get('x', 'gone')
gone
> u['x']
error KeyError: 'x'
> u.length
1
> freeze({'a': [1, {'b': 2}], 'c': 3})
{'a': (1, {'b': 2}), 'c': 3}
> freeze([1, [2, 3]])
(1, (2, 3))
> freeze('s')
s
> freeze({'a': 1}) == {'a': 1}
True
> freeze([1, 2]) == (1, 2)
True
> hash(freeze({'b': 1, 'a': 2})) == hash(freeze({'a': 2, 'b': 1}))
True
> f = freeze({'a': 1})
> f.update({'b': 2})
error TypeError: object is immutable
> f.pop('a')
error TypeError: object is immutable
> f.clear()
error TypeError: object is immutable
> f
{'a': 1}

