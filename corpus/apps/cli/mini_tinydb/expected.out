# Queries: equality, hashing and repr
> a = Query().name == 'Ann'
> b = where('name') == 'Ann'
> a
QueryImpl('==', ('name',), 'Ann')
> b
QueryImpl('==', ('name',), 'Ann')
> a == b
True
> Query().age > 3
QueryImpl('>', ('age',), 3)
> Query().age >= 3.5
QueryImpl('>=', ('age',), 3.5)
> Query().address.city.exists()
QueryImpl('exists', ('address', 'city'))
> Query().tags.any(['a', 'b'])
QueryImpl('any', ('tags',), ('a', 'b'))
> Query().tags.all(['a'])
QueryImpl('all', ('tags',), ('a',))
> Query().name.one_of(['x'])
QueryImpl('one_of', ('name',), ('x',))
> Query().name.matches('a+')
QueryImpl('matches', ('name',), 'a+')
> Query().name.search('b', re.I)
QueryImpl('search', ('name',), 'b')
> Query().fragment({'a': 1, 'b': [2]})
QueryImpl('fragment', {'a': 1, 'b': (2,)})
> Query().name
Query()
> Query()
Query()
> Query().noop()
QueryImpl()
> ~(Query().x == 1)
QueryImpl('not', ('==', ('x',), 1))
> ~~(Query().x == 1)
QueryImpl('not', ('not', ('==', ('x',), 1)))
> ((Query().a == 1) & (Query().b == 2)) == ((Query().b == 2) & (Query().a == 1))
True
> ((Query().a == 1) | (Query().b == 2)) == ((Query().b == 2) | (Query().a == 1))
True
> ((Query().a == 1) & (Query().b == 2)) == ((Query().a == 1) | (Query().b == 2))
False
> (Query().a == 1) == (Query().a == 1.0)
True
> (Query().a == 1) == (Query().a == True)
True
> (Query().a == [1, 2]) == (Query().a == (1, 2))
True
> (Query().a == 1) == (Query().b == 1)
False
> (Query().a == 1) == 1
False
> (Query().a == 1).is_cacheable()
True
> Query().a.map(lower).is_cacheable()
False
> (Query().a.map(lower) == 'x').is_cacheable()
False
> ((Query().a.map(lower) == 'x') & (Query().b == 1)).is_cacheable()
False
> (Query().a.test(is_even)).is_cacheable()
True
> (Query().a.test(is_even)) == (Query().a.test(is_even))
True
> (Query().a.test(is_even)) == (Query().a.test(starts_with))
False
> (Query().a.test(starts_with, 'x')) == (Query().a.test(starts_with, 'y'))
False
> (Query().a == {'k': 1}) == (Query().a == {'k': 1})
True

# Tables
