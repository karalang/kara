
# Getting started
> db = TinyDB('data/db/db.json')
> db.insert({'type': 'apple', 'count': 7})
1
> db.insert({'type': 'peach', 'count': 3})
2
> db.all()
[{'type': 'apple', 'count': 7}, {'type': 'peach', 'count': 3}]
> len(db)
2
> Fruit = Query()
> db.search(Fruit.type == 'peach')
[{'type': 'peach', 'count': 3}]
> db.search(Fruit.count > 5)
[{'type': 'apple', 'count': 7}]
> db.update({'count': 10}, Fruit.type == 'apple')
[1]
> db.all()
[{'type': 'apple', 'count': 10}, {'type': 'peach', 'count': 3}]
> db.remove(Fruit.count < 5)
[2]
> db.all()
[{'type': 'apple', 'count': 10}]
> db/db.json
  db/db.json (1 lines)
  | {"_default": {"1": {"type": "apple", "count": 10}}}
> db.truncate()
None
> db.all()
[]
> db/db.json
  db/db.json (1 lines)
  | {"_default": {}}
> db.insert({'name': 'John', 'age': 22})
1
> db.insert({'name': 'Mary', 'age': 31})
2
> User = Query()
> db.search(User.name == 'John')
[{'name': 'John', 'age': 22}]
> db.search(User.age > 30)
[{'name': 'Mary', 'age': 31}]
> db.search(where('name') == 'Mary')
[{'name': 'Mary', 'age': 31}]
> db.get(User.name == 'Mary')
{'name': 'Mary', 'age': 31}
> db.get(User.name == 'Nobody')
None
> db.contains(User.name == 'John')
True
> db.count(User.age >= 22)
2
> sorted(db.tables())
['_default']
> db/db.json
  db/db.json (1 lines)
  | {"_default": {"1": {"name": "John", "age": 22}, "2": {"name": "Mary", "age": 31}}}

# Queries: comparisons and paths
> db = TinyDB(storage=MemoryStorage)
> db.insert_multiple([{'name': 'Ann', 'age': 34, 'city': 'Berlin', 'score': 4.5}, {'name': 'Bo', 'age': 27, 'city': 'Paris', 'score': 3}, {'name': 'Cy', 'age': 41, 'city': 'Berlin'}, {'name': 'Di', 'age': '19', 'city': 'Seoul', 'score': 2.0}, {'name': 'Ed', 'city': None, 'score': True}])
[1, 2, 3, 4, 5]
> q = Query()
> db.search(q.city == 'Berlin')
[{'name': 'Ann', 'age': 34, 'city': 'Berlin', 'score': 4.5}, {'name': 'Cy', 'age': 41, 'city': 'Berlin'}]
> db.search(q.city != 'Berlin')
[{'name': 'Bo', 'age': 27, 'city': 'Paris', 'score': 3}, {'name': 'Di', 'age': '19', 'city': 'Seoul', 'score': 2.0}, {'name': 'Ed', 'city': None, 'score': True}]
> db.search(q.city == None)
[{'name': 'Ed', 'city': None, 'score': True}]
> db.search(q.score == 3)
[{'name': 'Bo', 'age': 27, 'city': 'Paris', 'score': 3}]
> db.search(q.score == 3.0)
[{'name': 'Bo', 'age': 27, 'city': 'Paris', 'score': 3}]
> db.search(q.score == 1)
[{'name': 'Ed', 'city': None, 'score': True}]
> db.search(q.score == 2)
[{'name': 'Di', 'age': '19', 'city': 'Seoul', 'score': 2.0}]
> db.search(q.score >= 3)
[{'name': 'Ann', 'age': 34, 'city': 'Berlin', 'score': 4.5}, {'name': 'Bo', 'age': 27, 'city': 'Paris', 'score': 3}]
> db.search(q.score > 2.5)
[{'name': 'Ann', 'age': 34, 'city': 'Berlin', 'score': 4.5}, {'name': 'Bo', 'age': 27, 'city': 'Paris', 'score': 3}]
> db.search(q.age < 30)
error TypeError: '<' not supported between instances of 'str' and 'int'
> db.search(q.age <= 34)
error TypeError: '<=' not supported between instances of 'str' and 'int'
> db.search(q.name > 'B')
[{'name': 'Bo', 'age': 27, 'city': 'Paris', 'score': 3}, {'name': 'Cy', 'age': 41, 'city': 'Berlin'}, {'name': 'Di', 'age': '19', 'city': 'Seoul', 'score': 2.0}, {'name': 'Ed', 'city': None, 'score': True}]
> db.search(q.name >= 'Cy')
[{'name': 'Cy', 'age': 41, 'city': 'Berlin'}, {'name': 'Di', 'age': '19', 'city': 'Seoul', 'score': 2.0}, {'name': 'Ed', 'city': None, 'score': True}]
> db.search(q.city < 'P')
error TypeError: '<' not supported between instances of 'NoneType' and 'str'
> db.search(q.missing == 1)
[]
> db.search(q.missing != 1)
[]
> db.search(q['name'] == 'Ann')
[{'name': 'Ann', 'age': 34, 'city': 'Berlin', 'score': 4.5}]
> db.search(q.name.first == 'A')
[]
> db.search(where('city') == 'Seoul')
[{'name': 'Di', 'age': '19', 'city': 'Seoul', 'score': 2.0}]

# Queries: nested documents
> db = TinyDB(storage=MemoryStorage)
> db.insert({'name': 'Ann', 'address': {'city': 'Berlin', 'geo': {'lat': 52.5, 'lon': 13.4}}, 'langs': ['de', 'en']})
1
> db.insert({'name': 'Bo', 'address': {'city': 'Paris'}, 'langs': ['fr']})
2
> db.insert({'name': 'Cy', 'address': 'unknown', 'langs': 'en'})
3
> db.insert({'name': 'Di', 'address': None, 'langs': []})
4
> q = Query()
> db.search(q.address.city == 'Berlin')
[{'name': 'Ann', 'address': {'city': 'Berlin', 'geo': {'lat': 52.5, 'lon': 13.4}}, 'langs': ['de', 'en']}]
> db.search(q.address.geo.lat > 50)
[{'name': 'Ann', 'address': {'city': 'Berlin', 'geo': {'lat': 52.5, 'lon': 13.4}}, 'langs': ['de', 'en']}]
> db.search(q.address.city.exists())
[{'name': 'Ann', 'address': {'city': 'Berlin', 'geo': {'lat': 52.5, 'lon': 13.4}}, 'langs': ['de', 'en']}, {'name': 'Bo', 'address': {'city': 'Paris'}, 'langs': ['fr']}]
> db.search(q.address.exists())
[{'name': 'Ann', 'address': {'city': 'Berlin', 'geo': {'lat': 52.5, 'lon': 13.4}}, 'langs': ['de', 'en']}, {'name': 'Bo', 'address': {'city': 'Paris'}, 'langs': ['fr']}, {'name': 'Cy', 'address': 'unknown', 'langs': 'en'}, {'name': 'Di', 'address': None, 'langs': []}]
> db.search(q['address']['city'] == 'Paris')
[{'name': 'Bo', 'address': {'city': 'Paris'}, 'langs': ['fr']}]
> db.search(q.langs == ['fr'])
[{'name': 'Bo', 'address': {'city': 'Paris'}, 'langs': ['fr']}]
> db.search(q.langs == [])
[{'name': 'Di', 'address': None, 'langs': []}]
> db.search(q.langs == 'en')
[{'name': 'Cy', 'address': 'unknown', 'langs': 'en'}]
> db.search(q.langs.lang == 'en')
[]
> db.search(q.address == {'city': 'Paris'})
[{'name': 'Bo', 'address': {'city': 'Paris'}, 'langs': ['fr']}]
> db.search(q.address != {'city': 'Paris'})
[{'name': 'Ann', 'address': {'city': 'Berlin', 'geo': {'lat': 52.5, 'lon': 13.4}}, 'langs': ['de', 'en']}, {'name': 'Cy', 'address': 'unknown', 'langs': 'en'}, {'name': 'Di', 'address': None, 'langs': []}]

# Queries: logic
> db.search((q.name == 'Ann') | (q.name == 'Bo'))
[{'name': 'Ann', 'address': {'city': 'Berlin', 'geo': {'lat': 52.5, 'lon': 13.4}}, 'langs': ['de', 'en']}, {'name': 'Bo', 'address': {'city': 'Paris'}, 'langs': ['fr']}]
> db.search((q.address.city == 'Berlin') & (q.langs == ['de', 'en']))
[{'name': 'Ann', 'address': {'city': 'Berlin', 'geo': {'lat': 52.5, 'lon': 13.4}}, 'langs': ['de', 'en']}]
> db.search(~(q.name == 'Ann'))
[{'name': 'Bo', 'address': {'city': 'Paris'}, 'langs': ['fr']}, {'name': 'Cy', 'address': 'unknown', 'langs': 'en'}, {'name': 'Di', 'address': None, 'langs': []}]
> db.search(~q.address.city.exists())
[{'name': 'Cy', 'address': 'unknown', 'langs': 'en'}, {'name': 'Di', 'address': None, 'langs': []}]
> db.search((q.name == 'Ann') & ~(q.name == 'Ann'))
[]
> db.search(~~(q.name == 'Cy'))
[{'name': 'Cy', 'address': 'unknown', 'langs': 'en'}]
> db.search((q.name == 'Ann') | (q.name == 'Bo') | (q.name == 'Cy'))
[{'name': 'Ann', 'address': {'city': 'Berlin', 'geo': {'lat': 52.5, 'lon': 13.4}}, 'langs': ['de', 'en']}, {'name': 'Bo', 'address': {'city': 'Paris'}, 'langs': ['fr']}, {'name': 'Cy', 'address': 'unknown', 'langs': 'en'}]
> db.search(q.noop())
[{'name': 'Ann', 'address': {'city': 'Berlin', 'geo': {'lat': 52.5, 'lon': 13.4}}, 'langs': ['de', 'en']}, {'name': 'Bo', 'address': {'city': 'Paris'}, 'langs': ['fr']}, {'name': 'Cy', 'address': 'unknown', 'langs': 'en'}, {'name': 'Di', 'address': None, 'langs': []}]
> db.search(q.noop() & (q.name == 'Di'))
[{'name': 'Di', 'address': None, 'langs': []}]
> db.search(~q.noop())
[]

# Queries: matches, search and test
> db = TinyDB(storage=MemoryStorage)
> db.insert_multiple([{'name': 'John Smith', 'email': 'john@example.com'}, {'name': 'jane doe', 'email': 'jane@EXAMPLE.org'}, {'name': 'Bob', 'email': None}, {'name': 'Alice Johnson', 'email': 'alice@example.com', 'nick': 42}])
[1, 2, 3, 4]
> q = Query()
> db.search(q.name.matches('J'))
[{'name': 'John Smith', 'email': 'john@example.com'}]
> db.search(q.name.matches('j'))
[{'name': 'jane doe', 'email': 'jane@EXAMPLE.org'}]
> db.search(q.name.matches('[Jj]'))
[{'name': 'John Smith', 'email': 'john@example.com'}, {'name': 'jane doe', 'email': 'jane@EXAMPLE.org'}]
> db.search(q.name.matches('j', flags=re.IGNORECASE))
[{'name': 'jane doe', 'email': 'jane@EXAMPLE.org'}]
> db.search(q.name.matches('John'))
[{'name': 'John Smith', 'email': 'john@example.com'}]
> db.search(q.name.search('John'))
[{'name': 'John Smith', 'email': 'john@example.com'}, {'name': 'Alice Johnson', 'email': 'alice@example.com', 'nick': 42}]
> db.search(q.name.search('o[a-z]+n'))
[{'name': 'John Smith', 'email': 'john@example.com'}, {'name': 'Alice Johnson', 'email': 'alice@example.com', 'nick': 42}]
> db.search(q.name.matches('.*son$'))
[{'name': 'Alice Johnson', 'email': 'alice@example.com', 'nick': 42}]
> db.search(q.name.matches('[A-Z][a-z]+ [A-Z][a-z]+$'))
[{'name': 'John Smith', 'email': 'john@example.com'}, {'name': 'Alice Johnson', 'email': 'alice@example.com', 'nick': 42}]
> db.search(q.name.matches('\\w+$'))
[{'name': 'Bob', 'email': None}]
> db.search(q.email.search('@example\\.(com|org)'))
[{'name': 'John Smith', 'email': 'john@example.com'}, {'name': 'Alice Johnson', 'email': 'alice@example.com', 'nick': 42}]
> db.search(q.email.search('example', re.I))
[{'name': 'John Smith', 'email': 'john@example.com'}, {'name': 'jane doe', 'email': 'jane@EXAMPLE.org'}, {'name': 'Alice Johnson', 'email': 'alice@example.com', 'nick': 42}]
> db.search(q.email.matches('[a-z]+@'))
[{'name': 'John Smith', 'email': 'john@example.com'}, {'name': 'jane doe', 'email': 'jane@EXAMPLE.org'}, {'name': 'Alice Johnson', 'email': 'alice@example.com', 'nick': 42}]
> db.search(q.nick.matches('4'))
[]
> db.search(q.name.search('^B'))
[{'name': 'Bob', 'email': None}]
> db.search(q.name.search('b$'))
[{'name': 'Bob', 'email': None}]
> db.search(q.name.matches('(Bob|jane)'))
[{'name': 'jane doe', 'email': 'jane@EXAMPLE.org'}, {'name': 'Bob', 'email': None}]
> db.search(q.name.matches('a{2,}'))
[]
> db.search(q.name.search('[^a-z ]{2}'))
[]
> db.search(q.name.search('\\s'))
[{'name': 'John Smith', 'email': 'john@example.com'}, {'name': 'jane doe', 'email': 'jane@EXAMPLE.org'}, {'name': 'Alice Johnson', 'email': 'alice@example.com', 'nick': 42}]
> db.search(q.name.search('\\S+\\s+\\S+n$'))
[{'name': 'Alice Johnson', 'email': 'alice@example.com', 'nick': 42}]
> db.search(q.name.matches('.{3}$'))
[{'name': 'Bob', 'email': None}]
> db.search(q.name.search('o.?n'))
[{'name': 'John Smith', 'email': 'john@example.com'}, {'name': 'Alice Johnson', 'email': 'alice@example.com', 'nick': 42}]
> db.search(q.name.search('J.*?n'))
[{'name': 'John Smith', 'email': 'john@example.com'}, {'name': 'Alice Johnson', 'email': 'alice@example.com', 'nick': 42}]
> db.search(q.email.matches('\\w+@\\w+\\.\\w{3}'))
[{'name': 'John Smith', 'email': 'john@example.com'}, {'name': 'jane doe', 'email': 'jane@EXAMPLE.org'}, {'name': 'Alice Johnson', 'email': 'alice@example.com', 'nick': 42}]
> db.search(q.name.test(starts_with, 'J'))
[{'name': 'John Smith', 'email': 'john@example.com'}]
> db.search(q.name.test(starts_with, 'j'))
[{'name': 'jane doe', 'email': 'jane@EXAMPLE.org'}]
> db.search(q.email.test(is_none))
[{'name': 'Bob', 'email': None}]
> db.search(q.nick.test(is_even))
[{'name': 'Alice Johnson', 'email': 'alice@example.com', 'nick': 42}]
> db.search(q.name.map(lower).matches('j'))
[{'name': 'John Smith', 'email': 'john@example.com'}, {'name': 'jane doe', 'email': 'jane@EXAMPLE.org'}]
> db.search(q.name.map(lower) == 'bob')
[{'name': 'Bob', 'email': None}]
> db.search(q.name.map(words).test(longer_than, 1))
[{'name': 'John Smith', 'email': 'john@example.com'}, {'name': 'jane doe', 'email': 'jane@EXAMPLE.org'}, {'name': 'Alice Johnson', 'email': 'alice@example.com', 'nick': 42}]
> db.search(q.email.map(lower).search('example.org'))
error AttributeError: 'NoneType' object has no attribute 'lower'

# Queries: lists
> db = TinyDB(storage=MemoryStorage)
> db.insert_multiple([{'name': 'Ann', 'tags': ['admin', 'ops'], 'groups': [{'name': 'staff', 'level': 2}, {'name': 'root', 'level': 9}]}, {'name': 'Bo', 'tags': ['dev'], 'groups': [{'name': 'staff', 'level': 1}]}, {'name': 'Cy', 'tags': [], 'groups': []}, {'name': 'Di', 'tags': 'dev', 'groups': 'none'}, {'name': 'Ed', 'tags': {'dev': 1}, 'groups': None}])
[1, 2, 3, 4, 5]
> q = Query()
> db.search(q.tags.any(['ops', 'dev']))
[{'name': 'Ann', 'tags': ['admin', 'ops'], 'groups': [{'name': 'staff', 'level': 2}, {'name': 'root', 'level': 9}]}, {'name': 'Bo', 'tags': ['dev'], 'groups': [{'name': 'staff', 'level': 1}]}, {'name': 'Ed', 'tags': {'dev': 1}, 'groups': None}]
> db.search(q.tags.any(['admin']))
[{'name': 'Ann', 'tags': ['admin', 'ops'], 'groups': [{'name': 'staff', 'level': 2}, {'name': 'root', 'level': 9}]}]
> db.search(q.tags.any(['d', 'v']))
[{'name': 'Di', 'tags': 'dev', 'groups': 'none'}]
> db.search(q.tags.all(['admin', 'ops']))
[{'name': 'Ann', 'tags': ['admin', 'ops'], 'groups': [{'name': 'staff', 'level': 2}, {'name': 'root', 'level': 9}]}]
> db.search(q.tags.all(['dev']))
[{'name': 'Bo', 'tags': ['dev'], 'groups': [{'name': 'staff', 'level': 1}]}, {'name': 'Di', 'tags': 'dev', 'groups': 'none'}, {'name': 'Ed', 'tags': {'dev': 1}, 'groups': None}]
> db.search(q.tags.all([]))
[{'name': 'Ann', 'tags': ['admin', 'ops'], 'groups': [{'name': 'staff', 'level': 2}, {'name': 'root', 'level': 9}]}, {'name': 'Bo', 'tags': ['dev'], 'groups': [{'name': 'staff', 'level': 1}]}, {'name': 'Cy', 'tags': [], 'groups': []}, {'name': 'Di', 'tags': 'dev', 'groups': 'none'}, {'name': 'Ed', 'tags': {'dev': 1}, 'groups': None}]
> db.search(q.tags.any([]))
[]
> db.search(q.groups.any(q.name == 'root'))
[{'name': 'Ann', 'tags': ['admin', 'ops'], 'groups': [{'name': 'staff', 'level': 2}, {'name': 'root', 'level': 9}]}]
> db.search(q.groups.any(q.level > 1))
[{'name': 'Ann', 'tags': ['admin', 'ops'], 'groups': [{'name': 'staff', 'level': 2}, {'name': 'root', 'level': 9}]}]
> db.search(q.groups.all(q.name == 'staff'))
[{'name': 'Bo', 'tags': ['dev'], 'groups': [{'name': 'staff', 'level': 1}]}, {'name': 'Cy', 'tags': [], 'groups': []}]
> db.search(q.groups.all(q.level >= 1))
[{'name': 'Ann', 'tags': ['admin', 'ops'], 'groups': [{'name': 'staff', 'level': 2}, {'name': 'root', 'level': 9}]}, {'name': 'Bo', 'tags': ['dev'], 'groups': [{'name': 'staff', 'level': 1}]}, {'name': 'Cy', 'tags': [], 'groups': []}]
> db.search(q.groups.any(q.name.exists()))
[{'name': 'Ann', 'tags': ['admin', 'ops'], 'groups': [{'name': 'staff', 'level': 2}, {'name': 'root', 'level': 9}]}, {'name': 'Bo', 'tags': ['dev'], 'groups': [{'name': 'staff', 'level': 1}]}]
> db.search(q.name.one_of(['Ann', 'Cy', 'Zed']))
[{'name': 'Ann', 'tags': ['admin', 'ops'], 'groups': [{'name': 'staff', 'level': 2}, {'name': 'root', 'level': 9}]}, {'name': 'Cy', 'tags': [], 'groups': []}]
> db.search(q.tags.one_of([['dev'], 'dev']))
[{'name': 'Bo', 'tags': ['dev'], 'groups': [{'name': 'staff', 'level': 1}]}, {'name': 'Di', 'tags': 'dev', 'groups': 'none'}]
> db.search(q.tags.one_of('dev'))
error TypeError: 'in <string>' requires string as left operand, not list
> db.search(q.fragment({'name': 'Bo'}))
[{'name': 'Bo', 'tags': ['dev'], 'groups': [{'name': 'staff', 'level': 1}]}]
> db.search(q.fragment({'name': 'Bo', 'tags': ['dev']}))
[{'name': 'Bo', 'tags': ['dev'], 'groups': [{'name': 'staff', 'level': 1}]}]
> db.search(q.fragment({'tags': []}))
[{'name': 'Cy', 'tags': [], 'groups': []}]
> db.search(q.fragment({}))
[{'name': 'Ann', 'tags': ['admin', 'ops'], 'groups': [{'name': 'staff', 'level': 2}, {'name': 'root', 'level': 9}]}, {'name': 'Bo', 'tags': ['dev'], 'groups': [{'name': 'staff', 'level': 1}]}, {'name': 'Cy', 'tags': [], 'groups': []}, {'name': 'Di', 'tags': 'dev', 'groups': 'none'}, {'name': 'Ed', 'tags': {'dev': 1}, 'groups': None}]
> db.search(q.groups.fragment({'name': 'staff'}))
error TypeError: argument of type 'NoneType' is not iterable
> db.search(q.groups.any(q.fragment({'name': 'staff', 'level': 1})))
[{'name': 'Bo', 'tags': ['dev'], 'groups': [{'name': 'staff', 'level': 1}]}]

