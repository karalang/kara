[]
> users.insert({'name': 'Ann'})
1
> sorted(db.tables())
['users']
> orders.insert_multiple([{'item': 'lamp', 'qty': 2}, {'item': 'cable', 'qty': 5}])
[1, 2]
> db.insert({'note': 'default table'})
1
> sorted(db.tables())
['_default', 'orders', 'users']
> users.name
users
> db.table('users') is users
True
> len(users)
1
> len(orders)
2
> len(db)
1
> orders.all()
[{'item': 'lamp', 'qty': 2}, {'item': 'cable', 'qty': 5}]
> list(orders)
[{'item': 'lamp', 'qty': 2}, {'item': 'cable', 'qty': 5}]
> db.table('users').all()
[{'name': 'Ann'}]
