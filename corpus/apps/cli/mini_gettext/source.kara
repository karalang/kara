// mini_gettext: a shop's UI in nine languages, translated the way
// Python 3.13's gettext does it:
// - a .po compiler, modelled on CPython's Tools/i18n/msgfmt.py, that
//   reads comments, fuzzy flags, msgctxt, plural entries and escapes,
//   and writes .mo files byte for byte as msgfmt.py lays them out;
// - the GNUTranslations loader for little- and big-endian .mo files,
//   with its metadata rules, charsets (UTF-8 and ISO-8859-1) and every
//   OSError it raises;
// - gettext's plural-form compiler (c2py): its tokenizer, its C
//   precedence parser, the Python expression it generates, its errors
//   and limits, and the expression's value under Python's arithmetic;
// - gettext, ngettext, pgettext and npgettext through fallback chains.
//
// The inputs are the files in data/. expected.out is the output of
// oracle.py, the same program written with gettext.

// ------------------------------------------------------------ bytes and text

fn byte_str(b: ref Vec[u8], from: i64, to: i64) -> String {
    let mut v: Vec[u8] = Vec.new();
    for i in from..to {
        v.push(b[i]);
    }
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn to_bytes(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn from_bytes(v: Vec[u8]) -> String {
    String.from_utf8(v).unwrap_or("?".to_string())
}

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn is_alpha(c: u8) -> bool {
    (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z')
}

fn is_alnum(c: u8) -> bool {
    is_digit(c) or is_alpha(c)
}

// White space, as `\s` and str.strip see it.
fn is_ws(c: u8) -> bool {
    c == b' ' or c == b'\t' or c == b'\n' or c == b'\r' or c == 11 or c == 12
}

fn lower_byte(c: u8) -> u8 {
    if c >= b'A' and c <= b'Z' { c + 32 } else { c }
}

fn lower(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        out.push(lower_byte(b[i]));
    }
    from_bytes(out)
}

fn strip(s: Str) -> String {
    let b = to_bytes(s);
    let mut i: i64 = 0;
    let mut j = b.len();
    while i < j and is_ws(b[i]) {
        i += 1;
    }
    while j > i and is_ws(b[j - 1]) {
        j -= 1;
    }
    byte_str(b, i, j)
}

fn split_ws(s: Str) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        while i < b.len() and is_ws(b[i]) {
            i += 1;
        }
        let st = i;
        while i < b.len() and not is_ws(b[i]) {
            i += 1;
        }
        if i > st {
            out.push(byte_str(b, st, i));
        }
    }
    out
}

fn split_on(s: Str, sep: u8) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut st: i64 = 0;
    for i in 0..b.len() {
        if b[i] == sep {
            out.push(byte_str(b, st, i));
            st = i + 1;
        }
    }
    out.push(byte_str(b, st, b.len()));
    out
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

// The lines of a file, without their newlines.
fn lines_of(text: Str) -> Vec[String] {
    let mut v = split_on(text, b'\n');
    if v.len() > 0 and v[v.len() - 1].len() == 0 {
        v.pop();
    }
    v
}

// Python's repr of a str.
fn py_repr(s: Str) -> String {
    let b = to_bytes(s);
    let mut has_single = false;
    let mut has_double = false;
    for i in 0..b.len() {
        if b[i] == b'\'' {
            has_single = true;
        }
        if b[i] == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let hex = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    out.push(q);
    let mut skip = false;
    for i in 0..b.len() {
        let c = b[i];
        if skip {
            skip = false;
            continue;
        }
        // U+0080 to U+00A0 and U+00AD are not printable either
        let next: u8 = if i + 1 < b.len() { b[i + 1] } else { 0 };
        if c == 0xC2 and next >= 0x80 and (next <= 0xA0 or next == 0xAD) {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(next / 16) as i64]);
            out.push(hex[(next % 16) as i64]);
            skip = true;
        } else if c == q or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c < 32 or c == 127 {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    from_bytes(out)
}

fn upper(s: Str) -> String {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        let c = b[i];
        out.push(if c >= b'a' and c <= b'z' { c - 32 } else { c });
    }
    from_bytes(out)
}

// Whether `pat` occurs in `b` at `i`.
fn starts_at(b: ref Vec[u8], i: i64, pat: Str) -> bool {
    let p = to_bytes(pat);
    if i < 0 or i + p.len() > b.len() {
        return false;
    }
    for k in 0..p.len() {
        if b[i + k] != p[k] {
            return false;
        }
    }
    true
}

fn starts_with(s: Str, pat: Str) -> bool {
    starts_at(to_bytes(s), 0, pat)
}

fn find_str(s: Str, pat: Str) -> i64 {
    let b = to_bytes(s);
    for i in 0..b.len() + 1 {
        if starts_at(b, i, pat) {
            return i;
        }
    }
    -1
}

fn first_byte(s: Str) -> u8 {
    let b = to_bytes(s);
    if b.len() > 0 { b[0] } else { 0 }
}

fn slice_from(s: Str, i: i64) -> String {
    let b = to_bytes(s);
    byte_str(b, i, b.len())
}

fn is_hex(c: u8) -> bool {
    is_digit(c) or (c >= b'a' and c <= b'f') or (c >= b'A' and c <= b'F')
}

fn hex_val(c: u8) -> u8 {
    if is_digit(c) {
        c - b'0'
    } else if c >= b'a' and c <= b'f' {
        c - b'a' + 10
    } else {
        c - b'A' + 10
    }
}

fn find_byte(s: Str, c: u8) -> i64 {
    let b = to_bytes(s);
    for i in 0..b.len() {
        if b[i] == c {
            return i;
        }
    }
    -1
}

fn rfind_byte(s: Str, c: u8) -> i64 {
    let b = to_bytes(s);
    let mut i = b.len() - 1;
    while i >= 0 {
        if b[i] == c {
            return i;
        }
        i -= 1;
    }
    -1
}

fn has_byte(s: Str, c: u8) -> bool {
    find_byte(s, c) >= 0
}

fn slice(s: Str, from: i64, to: i64) -> String {
    byte_str(to_bytes(s), from, to)
}

// str.partition and str.rpartition on one byte: (before, found, after).
fn partition(s: Str, c: u8) -> (String, bool, String) {
    let i = find_byte(s, c);
    if i < 0 {
        return (s.to_string(), false, String.new());
    }
    (slice(s, 0, i), true, slice_from(s, i + 1))
}

fn rpartition(s: Str, c: u8) -> (String, bool, String) {
    let i = rfind_byte(s, c);
    if i < 0 {
        return (String.new(), false, s.to_string());
    }
    (slice(s, 0, i), true, slice_from(s, i + 1))
}

// Python's repr of a bytes object.
fn bytes_repr(b: ref Vec[u8]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for i in 0..b.len() {
        if b[i] == b'\'' {
            has_single = true;
        }
        if b[i] == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let hex = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    out.push(b'b');
    out.push(q);
    for i in 0..b.len() {
        let c = b[i];
        if c == q or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c < 32 or c >= 127 {
            out.push(b'\\');
            out.push(b'x');
            out.push(hex[(c / 16) as i64]);
            out.push(hex[(c % 16) as i64]);
        } else {
            out.push(c);
        }
    }
    out.push(q);
    from_bytes(out)
}

fn is_ascii(s: Str) -> bool {
    let b = to_bytes(s);
    for i in 0..b.len() {
        if b[i] >= 0x80 {
            return false;
        }
    }
    true
}

fn py_int(s: Str) -> Option[i64] {
    let b = to_bytes(strip(s));
    let mut i: i64 = 0;
    let mut neg = false;
    if i < b.len() and (b[i] == b'+' or b[i] == b'-') {
        neg = b[i] == b'-';
        i += 1;
    }
    if i >= b.len() {
        return None;
    }
    let mut n: i64 = 0;
    let mut prev_digit = false;
    while i < b.len() {
        let c = b[i];
        if is_digit(c) {
            n = n * 10 + (c - b'0') as i64;
            prev_digit = true;
        } else if c == b'_' and prev_digit and i + 1 < b.len() and is_digit(b[i + 1]) {
            prev_digit = false;
        } else {
            return None;
        }
        i += 1;
    }
    if neg { Some(-n) } else { Some(n) }
}

// The code points of a string.
fn code_points(s: Str) -> Vec[i64] {
    let b = to_bytes(s);
    let mut out: Vec[i64] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | (b[i + 1] as i64 & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | ((b[i + 1] as i64 & 0x3F) << 6) | (b[i + 2] as i64 & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | ((b[i + 1] as i64 & 0x3F) << 12) | ((b[i + 2] as i64 & 0x3F) << 6) | (b[i + 3] as i64 & 0x3F));
            i += 4;
        }
    }
    out
}

fn push_code_point(out: mut ref Vec[u8], cp: i64) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push(((cp >> 6) | 0xC0) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    } else if cp < 0x10000 {
        out.push(((cp >> 12) | 0xE0) as u8);
        out.push((((cp >> 6) & 0x3F) | 0x80) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    } else {
        out.push(((cp >> 18) | 0xF0) as u8);
        out.push((((cp >> 12) & 0x3F) | 0x80) as u8);
        out.push((((cp >> 6) & 0x3F) | 0x80) as u8);
        out.push(((cp & 0x3F) | 0x80) as u8);
    }
}

// ------------------------------------------------------------ the .po compiler

fn sub(b: ref Vec[u8], from: i64, to: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for i in from..to {
        out.push(b[i]);
    }
    out
}

fn has_prefix(b: ref Vec[u8], p: Str) -> bool {
    starts_at(b, 0, p)
}

fn append(a: mut ref Vec[u8], b: ref Vec[u8]) {
    for i in 0..b.len() {
        a.push(b[i]);
    }
}

fn contains_seq(b: ref Vec[u8], p: Str) -> bool {
    for i in 0..b.len() {
        if starts_at(b, i, p) {
            return true;
        }
    }
    false
}

fn contains_u8(b: ref Vec[u8], c: u8) -> bool {
    for i in 0..b.len() {
        if b[i] == c {
            return true;
        }
    }
    false
}

fn strip_bytes(b: ref Vec[u8]) -> Vec[u8] {
    let mut i: i64 = 0;
    let mut j = b.len();
    while i < j and is_ws(b[i]) {
        i += 1;
    }
    while j > i and is_ws(b[j - 1]) {
        j -= 1;
    }
    sub(b, i, j)
}

// bytes.decode("latin-1"): one code point per byte.
fn latin1(b: ref Vec[u8]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for i in 0..b.len() {
        push_code_point(mut out, b[i] as i64);
    }
    from_bytes(out)
}

fn unescape(s: ref Vec[u8], lno: i64) -> Result[Vec[u8], String] {
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i < s.len() {
        let c = s[i];
        if c == b'\\' {
            i += 1;
            let e: u8 = if i < s.len() { s[i] } else { 0 };
            if e == b'n' {
                out.push(b'\n');
            } else if e == b't' {
                out.push(b'\t');
            } else if e == b'r' {
                out.push(b'\r');
            } else if e == b'"' or e == b'\\' {
                out.push(e);
            } else {
                let shown = if i < s.len() { latin1(sub(s, i, i + 1)) } else { String.new() };
                return Err(f"line {lno}: unknown escape \\{shown}");
            }
        } else {
            out.push(c);
        }
        i += 1;
    }
    Ok(out)
}

// One compiled message: the key (msgctxt EOT msgid, msgid NUL plural)
// and the value (the msgstrs joined by NUL).
#[derive(Clone)]
struct Msg {
    key: Vec[u8],
    value: Vec[u8],
}

struct Compiled {
    msgs: Vec[Msg],
    fuzzy: i64,
    empty: i64,
}

const ID: i64 = 1;
const STR: i64 = 2;
const CTXT: i64 = 3;

// The parser's state between lines.
struct Po {
    section: i64,
    has_ctxt: bool,
    msgctxt: Vec[u8],
    msgid: Vec[u8],
    msgstr: Vec[u8],
    fuzzy: bool,
    is_plural: bool,
    out: Compiled,
}

impl Po {
    // Ends the entry being read: keeps it unless it is fuzzy or has no
    // translation.
    fn add(mut ref self) {
        if self.fuzzy {
            self.out.fuzzy += 1;
            return;
        }
        let mut any = false;
        for i in 0..self.msgstr.len() {
            if self.msgstr[i] != 0 {
                any = true;
            }
        }
        if not any {
            self.out.empty += 1;
            return;
        }
        let mut key: Vec[u8] = Vec.new();
        if self.has_ctxt {
            append(mut key, self.msgctxt);
            key.push(4);
        }
        append(mut key, self.msgid);
        // a later entry with the same key replaces the earlier one
        for i in 0..self.out.msgs.len() {
            if self.out.msgs[i].key == key {
                self.out.msgs[i].value = self.msgstr.clone();
                return;
            }
        }
        self.out.msgs.push(Msg { key: key, value: self.msgstr.clone() });
    }
}

fn msgfmt(text: ref Vec[u8]) -> Result[Compiled, String] {
    let mut p = Po {
        section: 0,
        has_ctxt: false,
        msgctxt: Vec.new(),
        msgid: Vec.new(),
        msgstr: Vec.new(),
        fuzzy: false,
        is_plural: false,
        out: Compiled { msgs: Vec.new(), fuzzy: 0, empty: 0 },
    };
    let mut lines: Vec[Vec[u8]] = Vec.new();
    let mut st: i64 = 0;
    for i in 0..text.len() {
        if text[i] == b'\n' {
            lines.push(sub(text, st, i));
            st = i + 1;
        }
    }
    lines.push(sub(text, st, text.len()));
    for k in 0..lines.len() {
        let lno = k + 1;
        let mut l = lines[k].clone();
        let hash = l.len() > 0 and l[0] == b'#';
        if hash and p.section == STR {
            p.add();
            p.section = 0;
            p.has_ctxt = false;
            p.fuzzy = false;
        }
        if has_prefix(l, "#,") and contains_seq(l, "fuzzy") {
            p.fuzzy = true;
        }
        if hash {
            continue;
        }
        if has_prefix(l, "msgctxt") {
            if p.section == STR {
                p.add();
                p.fuzzy = false;
            }
            p.section = CTXT;
            p.has_ctxt = true;
            p.msgctxt = Vec.new();
            l = sub(l, 7, l.len());
        } else if has_prefix(l, "msgid_plural") {
            if p.section != ID {
                return Err(f"line {lno}: msgid_plural not preceded by msgid");
            }
            l = sub(l, 12, l.len());
            p.msgid.push(0);
            p.is_plural = true;
        } else if has_prefix(l, "msgid") {
            if p.section == STR {
                p.add();
                p.has_ctxt = false;
                p.fuzzy = false;
            }
            p.section = ID;
            l = sub(l, 5, l.len());
            p.msgid = Vec.new();
            p.msgstr = Vec.new();
            p.is_plural = false;
        } else if has_prefix(l, "msgstr") {
            p.section = STR;
            if has_prefix(l, "msgstr[") {
                if not p.is_plural {
                    return Err(f"line {lno}: plural without msgid_plural");
                }
                let mut j: i64 = 0;
                while j < l.len() and l[j] != b']' {
                    j += 1;
                }
                l = sub(l, j + 1, l.len());
                if p.msgstr.len() > 0 {
                    p.msgstr.push(0);
                }
            } else {
                if p.is_plural {
                    return Err(f"line {lno}: indexed msgstr required for plural");
                }
                l = sub(l, 6, l.len());
            }
        }
        l = strip_bytes(l);
        if l.len() == 0 {
            continue;
        }
        if l.len() < 2 or l[0] != b'"' or l[l.len() - 1] != b'"' {
            return Err(f"line {lno}: syntax error before: {latin1(l)}");
        }
        let s = unescape(sub(l, 1, l.len() - 1), lno)?;
        if p.section == CTXT {
            append(mut p.msgctxt, s);
        } else if p.section == ID {
            append(mut p.msgid, s);
        } else if p.section == STR {
            append(mut p.msgstr, s);
        } else {
            return Err(f"line {lno}: syntax error before: {latin1(l)}");
        }
    }
    if p.section == STR {
        p.add();
    }
    Ok(p.out)
}

fn bytes_lt(a: ref Vec[u8], b: ref Vec[u8]) -> bool {
    let mut i: i64 = 0;
    while i < a.len() and i < b.len() {
        if a[i] != b[i] {
            return a[i] < b[i];
        }
        i += 1;
    }
    a.len() < b.len()
}

fn push_u32(out: mut ref Vec[u8], v: i64, big: bool) {
    for k in 0..4 {
        let shift = if big { 8 * (3 - k) } else { 8 * k };
        out.push(((v >> shift) & 0xFF) as u8);
    }
}

// msgfmt.py's generate(): the header, the key and value tables, then
// the keys and the values, each NUL-terminated.
fn generate(msgs: ref Vec[Msg]) -> Vec[u8] {
    let mut keys = msgs.clone();
    for i in 1..keys.len() {
        let mut j = i;
        while j > 0 and bytes_lt(keys[j].key, keys[j - 1].key) {
            keys.swap(j - 1, j);
            j -= 1;
        }
    }
    let n = keys.len();
    let mut ids: Vec[u8] = Vec.new();
    let mut strs: Vec[u8] = Vec.new();
    let mut table: Vec[i64] = Vec.new();
    let keystart = 7 * 4 + 16 * n;
    let mut idlen: i64 = 0;
    for i in 0..n {
        idlen += keys[i].key.len() + 1;
    }
    let valuestart = keystart + idlen;
    let mut vtable: Vec[i64] = Vec.new();
    for i in 0..n {
        table.push(keys[i].key.len());
        table.push(ids.len() + keystart);
        vtable.push(keys[i].value.len());
        vtable.push(strs.len() + valuestart);
        append(mut ids, keys[i].key);
        ids.push(0);
        append(mut strs, keys[i].value);
        strs.push(0);
    }
    let mut out: Vec[u8] = Vec.new();
    push_u32(mut out, 0x950412de, false);
    push_u32(mut out, 0, false);
    push_u32(mut out, n, false);
    push_u32(mut out, 28, false);
    push_u32(mut out, 28 + n * 8, false);
    push_u32(mut out, 0, false);
    push_u32(mut out, 0, false);
    for i in 0..table.len() {
        push_u32(mut out, table[i], false);
    }
    for i in 0..vtable.len() {
        push_u32(mut out, vtable[i], false);
    }
    append(mut out, ids);
    append(mut out, strs);
    out
}

fn hex_of(b: ref Vec[u8], n: i64) -> String {
    let digits = to_bytes("0123456789abcdef");
    let mut out: Vec[u8] = Vec.new();
    for i in 0..n {
        out.push(digits[(b[i] / 16) as i64]);
        out.push(digits[(b[i] % 16) as i64]);
    }
    from_bytes(out)
}

// ------------------------------------------------------------ plural forms

fn is_word(c: u8) -> bool {
    is_alnum(c) or c == b'_' or c >= 0x80
}

// gettext._tokenize: the tokens, with each invalid one kept so that the
// error is raised only when the parser reaches it, as the generator
// does. The last token is "".
#[derive(Clone)]
struct PTok {
    invalid: bool,
    text: String,
}

fn tokenize(s: Str) -> Vec[PTok] {
    let b = to_bytes(s);
    let mut out: Vec[PTok] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let c = b[i];
        if c == b' ' or c == b'\t' {
            i += 1;
            continue;
        }
        if is_digit(c) {
            let mut j = i;
            while j < b.len() and is_digit(b[j]) {
                j += 1;
            }
            if j == b.len() or not is_word(b[j]) {
                out.push(PTok { invalid: false, text: byte_str(b, i, j) });
                i = j;
                continue;
            }
        }
        if c == b'n' and (i + 1 == b.len() or not is_word(b[i + 1])) {
            out.push(PTok { invalid: false, text: "n".to_string() });
            i += 1;
            continue;
        }
        if c == b'(' or c == b')' or c == b'-' or c == b'*' or c == b'/' or c == b'%' or c == b'+' or c == b'?' or c == b':' {
            out.push(PTok { invalid: false, text: byte_str(b, i, i + 1) });
            i += 1;
            continue;
        }
        if c == b'>' or c == b'<' or c == b'!' {
            let n = if i + 1 < b.len() and b[i + 1] == b'=' { 2 } else { 1 };
            out.push(PTok { invalid: false, text: byte_str(b, i, i + n) });
            i += n;
            continue;
        }
        if i + 1 < b.len() and ((c == b'=' and b[i + 1] == b'=') or (c == b'&' and b[i + 1] == b'&') or (c == b'|' and b[i + 1] == b'|')) {
            out.push(PTok { invalid: false, text: byte_str(b, i, i + 2) });
            i += 2;
            continue;
        }
        // \w+ or any one character
        let mut j = i + 1;
        if is_word(c) {
            while j < b.len() and is_word(b[j]) {
                j += 1;
            }
        } else if c >= 0x80 {
            while j < b.len() and b[j] >= 0x80 and b[j] < 0xC0 {
                j += 1;
            }
        }
        out.push(PTok { invalid: true, text: byte_str(b, i, j) });
        i = j;
    }
    out.push(PTok { invalid: false, text: String.new() });
    out
}

const NUM: i64 = 0;
const VAR: i64 = 1;
const NOT: i64 = 2;
const BIN: i64 = 3;
const COND: i64 = 4;

// An expression node; a, b and c index other nodes.
#[derive(Clone)]
struct PNode {
    kind: i64,
    op: String,
    v: i64,
    a: i64,
    b: i64,
    c: i64,
}

struct Plural {
    toks: Vec[PTok],
    at: i64,
    nodes: Vec[PNode],
}

fn binary_priority(t: Str) -> i64 {
    if t == "||" {
        1
    } else if t == "&&" {
        2
    } else if t == "==" or t == "!=" {
        3
    } else if t == "<" or t == ">" or t == "<=" or t == ">=" {
        4
    } else if t == "+" or t == "-" {
        5
    } else if t == "*" or t == "/" or t == "%" {
        6
    } else {
        0
    }
}

fn py_op(t: Str) -> String {
    if t == "||" {
        "or".to_string()
    } else if t == "&&" {
        "and".to_string()
    } else if t == "/" {
        "//".to_string()
    } else {
        t.to_string()
    }
}

fn unexpected(t: Str) -> String {
    if t.len() > 0 { f"unexpected token in plural form: {t}" } else { "unexpected end of plural form".to_string() }
}

impl Plural {
    fn next(mut ref self) -> Result[String, String] {
        let t = self.toks[self.at].clone();
        self.at += 1;
        if t.invalid {
            return Err(f"invalid token in plural form: {t.text}");
        }
        Ok(t.text)
    }

    fn node(mut ref self, kind: i64, op: Str, v: i64, a: i64, b: i64, c: i64) -> i64 {
        self.nodes.push(PNode { kind: kind, op: op.to_string(), v: v, a: a, b: b, c: c });
        self.nodes.len() - 1
    }

    // gettext._parse: the Python text, the node, and the next token.
    fn parse(mut ref self, priority: i64) -> Result[(String, i64, String), String] {
        let mut result = String.new();
        let mut nots: i64 = 0;
        let mut tok = self.next()?;
        while tok == "!" {
            result.push_str("not ");
            nots += 1;
            tok = self.next()?;
        }
        let mut node: i64 = -1;
        if tok == "(" {
            let (sub, sn, close) = self.parse(-1)?;
            result = f"{result}({sub})";
            node = sn;
            if close != ")" {
                return Err("unbalanced parenthesis in plural form".to_string());
            }
        } else if tok == "n" {
            result.push_str("n");
            node = self.node(VAR, "", 0, -1, -1, -1);
        } else {
            let b = to_bytes(tok);
            if b.len() == 0 or not all_digits(b) {
                return Err(unexpected(tok));
            }
            let mut v: i64 = 0;
            for i in 0..b.len() {
                v = v * 10 + (b[i] - b'0') as i64;
            }
            result.push_str(f"{v}");
            node = self.node(NUM, "", v, -1, -1, -1);
        }
        for _ in 0..nots {
            node = self.node(NOT, "", 0, node, -1, -1);
        }
        if starts_with(result, "not ") {
            result = f"({result})";
        }
        tok = self.next()?;
        let mut j: i64 = 100;
        while binary_priority(tok) > 0 {
            let i = binary_priority(tok);
            if i < priority {
                break;
            }
            if (i == 3 or i == 4) and (j == 3 or j == 4) {
                result = f"({result})";
            }
            let (right, rn, after) = self.parse(i + 1)?;
            result = f"{result} {py_op(tok)} {right}";
            node = self.node(BIN, tok, 0, node, rn, -1);
            tok = after;
            j = i;
        }
        if j == priority and priority == 4 {
            result = f"({result})";
        }
        if tok == "?" and priority <= 0 {
            let (yes, yn, colon) = self.parse(0)?;
            if colon != ":" {
                return Err(unexpected(colon));
            }
            let (no, nn, after) = self.parse(-1)?;
            result = f"{yes} if {result} else {no}";
            node = self.node(COND, "", 0, node, yn, nn);
            tok = after;
            if priority == 0 {
                result = f"({result})";
            }
        }
        Ok((result, node, tok))
    }
}

fn all_digits(b: ref Vec[u8]) -> bool {
    for i in 0..b.len() {
        if not is_digit(b[i]) {
            return false;
        }
    }
    true
}

// A compiled Plural-Forms expression: the Python source c2py builds and
// the tree that computes it.
#[derive(Clone)]
struct PluralFn {
    source: String,
    nodes: Vec[PNode],
    root: i64,
}

// gettext.c2py
fn c2py(s: Str) -> Result[PluralFn, String] {
    if code_points(s).len() > 1000 {
        return Err("plural form expression is too long".to_string());
    }
    let mut p = Plural { toks: tokenize(s), at: 0, nodes: Vec.new() };
    let (result, root, tok) = p.parse(-1)?;
    if tok.len() > 0 {
        return Err(unexpected(tok));
    }
    let rb = to_bytes(result);
    let mut depth: i64 = 0;
    for i in 0..rb.len() {
        if rb[i] == b'(' {
            depth += 1;
            if depth > 20 {
                return Err("plural form expression is too complex".to_string());
            }
        } else if rb[i] == b')' {
            depth -= 1;
        }
    }
    Ok(PluralFn { source: result, nodes: p.nodes, root: root })
}

fn germanic() -> PluralFn {
    c2py("n != 1").unwrap_or(PluralFn { source: String.new(), nodes: Vec.new(), root: -1 })
}

fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

// The value under Python's rules: // and % round down, `and` and `or`
// give one of their operands, and only the branch taken is evaluated.
fn eval_node(f: ref PluralFn, i: i64, n: i64) -> Result[i64, String] {
    let k = f.nodes[i].clone();
    if k.kind == NUM {
        return Ok(k.v);
    }
    if k.kind == VAR {
        return Ok(n);
    }
    if k.kind == NOT {
        let x = eval_node(f, k.a, n)?;
        return Ok(if x == 0 { 1 } else { 0 });
    }
    if k.kind == COND {
        let c = eval_node(f, k.a, n)?;
        return if c != 0 { eval_node(f, k.b, n) } else { eval_node(f, k.c, n) };
    }
    let x = eval_node(f, k.a, n)?;
    if k.op == "&&" {
        return if x == 0 { Ok(x) } else { eval_node(f, k.b, n) };
    }
    if k.op == "||" {
        return if x != 0 { Ok(x) } else { eval_node(f, k.b, n) };
    }
    let y = eval_node(f, k.b, n)?;
    let r = if k.op == "==" {
        if x == y { 1 } else { 0 }
    } else if k.op == "!=" {
        if x != y { 1 } else { 0 }
    } else if k.op == "<" {
        if x < y { 1 } else { 0 }
    } else if k.op == ">" {
        if x > y { 1 } else { 0 }
    } else if k.op == "<=" {
        if x <= y { 1 } else { 0 }
    } else if k.op == ">=" {
        if x >= y { 1 } else { 0 }
    } else if k.op == "+" {
        x + y
    } else if k.op == "-" {
        x - y
    } else if k.op == "*" {
        x * y
    } else if k.op == "/" {
        if y == 0 {
            return Err("integer division or modulo by zero".to_string());
        }
        floor_div(x, y)
    } else {
        if y == 0 {
            return Err("integer modulo by zero".to_string());
        }
        x - floor_div(x, y) * y
    };
    Ok(r)
}

fn plural_of(f: ref PluralFn, n: i64) -> Result[i64, String] {
    eval_node(f, f.root, n)
}

// ------------------------------------------------------------ GNUTranslations

struct Catalog {
    info_keys: Vec[String],
    info_vals: Vec[String],
    charset: Option[String],
    plural: PluralFn,
    // msgid (with any context) -> msgstr
    single: Map[String, String],
    // "index|msgid" -> msgstr
    plurals: Map[String, String],
    count: i64,
}

fn u32_at(b: ref Vec[u8], at: i64, big: bool) -> Result[i64, String] {
    if at < 0 or at + 4 > b.len() {
        return Err("struct.error: unpack requires a buffer of 4 bytes".to_string());
    }
    let mut x: i64 = 0;
    for k in 0..4 {
        let byte = if big { b[at + k] } else { b[at + 3 - k] };
        x = (x << 8) | (byte as i64);
    }
    Ok(x)
}

// str(bytes, charset)
fn decode(b: ref Vec[u8], charset: Str) -> String {
    let c = lower(charset);
    if c == "iso-8859-1" or c == "latin-1" or c == "latin1" or c == "iso8859-1" {
        return latin1(b);
    }
    from_bytes(b.clone())
}

fn os_error(msg: Str, path: Str) -> String {
    f"OSError: [Errno 0] {msg}: {py_repr(path)}"
}

fn set_info(c: mut ref Catalog, k: Str, v: Str) {
    for i in 0..c.info_keys.len() {
        if c.info_keys[i] == k {
            c.info_vals[i] = v.to_string();
            return;
        }
    }
    c.info_keys.push(k.to_string());
    c.info_vals.push(v.to_string());
}

fn add_info(c: mut ref Catalog, k: Str, more: Str) {
    for i in 0..c.info_keys.len() {
        if c.info_keys[i] == k {
            c.info_vals[i] = f"{c.info_vals[i]}\n{more}";
        }
    }
}

// The metadata entry: "Key: value" lines, continuation lines, and the
// charset and plural rule it sets.
fn parse_header(c: mut ref Catalog, tmsg: ref Vec[u8]) -> Result[(), String] {
    let mut lastk = String.new();
    for line in split_on(from_bytes(tmsg.clone()), b'\n') {
        let item = strip(line);
        if item.len() == 0 {
            continue;
        }
        if starts_with(item, "#-#-#-#-#") and ends_with(item, "#-#-#-#-#") {
            continue;
        }
        if has_byte(item, b':') {
            let (k0, _, v0) = partition(item, b':');
            let k = lower(strip(k0));
            let v = strip(v0);
            set_info(mut c, k, v);
            lastk = k.clone();
            if k == "content-type" {
                let at = find_str(v, "charset=");
                c.charset = Some(slice_from(v, at + 8));
            } else if k == "plural-forms" {
                let parts = split_on(v, b';');
                let at = find_str(parts[1], "plural=");
                c.plural = match c2py(slice_from(parts[1], at + 7)) {
                    Ok(f) => f,
                    Err(e) => return Err(f"ValueError: {e}"),
                };
            }
        } else if lastk.len() > 0 {
            add_info(mut c, lastk, item);
        }
    }
    Ok(())
}

fn ends_with(s: Str, p: Str) -> bool {
    let b = to_bytes(s);
    starts_at(b, b.len() - p.len(), p)
}

fn load_mo(buf: ref Vec[u8], path: Str) -> Result[Catalog, String] {
    let mut c = Catalog {
        info_keys: Vec.new(),
        info_vals: Vec.new(),
        charset: None,
        plural: germanic(),
        single: Map.new(),
        plurals: Map.new(),
        count: 0,
    };
    let buflen = buf.len();
    let magic = u32_at(buf, 0, false)?;
    let big = if magic == 0x950412de {
        false
    } else if magic == 0xde120495 {
        true
    } else {
        return Err(os_error("Bad magic number", path));
    };
    let version = u32_at(buf, 4, big)?;
    let msgcount = u32_at(buf, 8, big)?;
    let mut masteridx = u32_at(buf, 12, big)?;
    let mut transidx = u32_at(buf, 16, big)?;
    let major = version >> 16;
    if major != 0 and major != 1 {
        return Err(os_error(f"Bad version number {major}", path));
    }
    for _ in 0..msgcount {
        let mlen = u32_at(buf, masteridx, big)?;
        let moff = u32_at(buf, masteridx + 4, big)?;
        let tlen = u32_at(buf, transidx, big)?;
        let toff = u32_at(buf, transidx + 4, big)?;
        let mend = moff + mlen;
        let tend = toff + tlen;
        if not (mend < buflen and tend < buflen) {
            return Err(os_error("File is corrupt", path));
        }
        let msg = sub(buf, moff, mend);
        let tmsg = sub(buf, toff, tend);
        if mlen == 0 {
            parse_header(mut c, tmsg)?;
        }
        let charset = c.charset.clone().unwrap_or("ascii".to_string());
        if contains_u8(msg, 0) {
            let mut z: i64 = 0;
            while msg[z] != 0 {
                z += 1;
            }
            let msgid1 = decode(sub(msg, 0, z), charset);
            let mut st: i64 = 0;
            let mut form: i64 = 0;
            for i in 0..tmsg.len() + 1 {
                if i == tmsg.len() or tmsg[i] == 0 {
                    let key = f"{form}|{msgid1}";
                    if not c.plurals.contains_key(key) {
                        c.count += 1;
                    }
                    c.plurals.insert(key, decode(sub(tmsg, st, i), charset));
                    form += 1;
                    st = i + 1;
                }
            }
        } else {
            let key = decode(msg, charset);
            if not c.single.contains_key(key) {
                c.count += 1;
            }
            c.single.insert(key, decode(tmsg, charset));
        }
        masteridx += 8;
        transidx += 8;
    }
    Ok(c)
}

fn get_single(c: ref Catalog, k: Str) -> Option[String] {
    match c.single.get(k) {
        Some(v) => Some(v.clone()),
        None => None,
    }
}

fn get_plural(c: ref Catalog, k: Str, n: i64) -> Option[String] {
    let i = match plural_of(c.plural, n) {
        Ok(i) => i,
        Err(_) => return None,
    };
    match c.plurals.get(f"{i}|{k}") {
        Some(v) => Some(v.clone()),
        None => None,
    }
}

// gettext and pgettext down a chain of catalogs and their fallbacks.
fn lookup(chain: ref Vec[Catalog], at: i64, key: Str, message: Str) -> String {
    if at == chain.len() {
        return message.to_string();
    }
    if let Some(v) = get_single(chain[at], key) {
        return v;
    }
    if let Some(v) = get_plural(chain[at], key, 1) {
        return v;
    }
    lookup(chain, at + 1, key, message)
}

// ngettext and npgettext
fn nlookup(chain: ref Vec[Catalog], at: i64, key: Str, one: Str, many: Str, n: i64) -> String {
    if at == chain.len() {
        return if n == 1 { one.to_string() } else { many.to_string() };
    }
    if let Some(v) = get_plural(chain[at], key, n) {
        return v;
    }
    nlookup(chain, at + 1, key, one, many, n)
}

fn gettext(chain: ref Vec[Catalog], msg: Str) -> String {
    lookup(chain, 0, msg, msg)
}

fn pgettext(chain: ref Vec[Catalog], ctx: Str, msg: Str) -> String {
    lookup(chain, 0, f"{ctx}\u{4}{msg}", msg)
}

fn ngettext(chain: ref Vec[Catalog], one: Str, many: Str, n: i64) -> String {
    nlookup(chain, 0, one, one, many, n)
}

fn npgettext(chain: ref Vec[Catalog], ctx: Str, one: Str, many: Str, n: i64) -> String {
    nlookup(chain, 0, f"{ctx}\u{4}{one}", one, many, n)
}

