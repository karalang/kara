}

fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn unhex(s: String) -> Vec[u8] {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data/broken")?;
    put_bytes("data/broken/badplural.mo", unhex(file_0()))?;
    put_bytes("data/broken/be.mo", unhex(file_1()))?;
    put_bytes("data/broken/corrupt.mo", unhex(file_2()))?;
    put_bytes("data/broken/magic.mo", unhex(file_3()))?;
    put_bytes("data/broken/multiline.mo", unhex(file_4()))?;
    put_bytes("data/broken/version1.mo", unhex(file_5()))?;
    put_bytes("data/broken/version2.mo", unhex(file_6()))?;
    make_dir("data")?;
    put("data/langs.txt", file_7())?;
    put("data/plurals.txt", file_8())?;
    make_dir("data/po")?;
    put("data/po/ar.po", file_9())?;
    put("data/po/de.po", file_10())?;
    put("data/po/fr.po", file_11())?;
    put("data/po/ga.po", file_12())?;
    put("data/po/ja.po", file_13())?;
    put("data/po/pl.po", file_14())?;
    put("data/po/pt.po", file_15())?;
    put_bytes("data/po/pt_BR.po", unhex(file_16()))?;
    put("data/po/ru.po", file_17())?;
    put("data/po/xx.po", file_18())?;
    put("data/ui.txt", file_19())?;
    Ok(())
}

// ------------------------------------------------------------ the reports

const SAMPLES: Array[i64, 16] = [0, 1, 2, 3, 4, 5, 7, 11, 12, 21, 22, 25, 100, 101, 111, 1000];

fn read(path: Str) -> Result[String, String] {
    match fs.read_to_string(path.to_string()) {
        Ok(t) => Ok(t),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

fn read_bytes(path: Str) -> Result[Vec[u8], String] {
    match fs.read_bytes(path.to_string()) {
        Ok(b) => Ok(b),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

fn sorted_names(dir: Str) -> Result[Vec[String], String] {
    let mut names = match fs.read_dir(dir.to_string()) {
        Ok(v) => v,
        Err(e) => return Err(f"cannot list {dir}: {e}"),
    };
    for i in 1..names.len() {
        let mut j = i;
        while j > 0 and names[j] < names[j - 1] {
            names.swap(j - 1, j);
            j -= 1;
        }
    }
    Ok(names)
}

fn compile_all() -> Result[(), String] {
    println("== compile");
    for name in sorted_names("data/po")? {
        let lang = slice(name, 0, name.len() - 3);
        let text = read_bytes(f"data/po/{name}")?;
        let c = match msgfmt(text) {
            Ok(c) => c,
            Err(e) => {
                println(f"{name}: {e}");
                continue;
            }
        };
        let data = generate(c.msgs);
        let dir = f"data/locale/{lang}/LC_MESSAGES";
        if let Err(e) = fs.create_dir_all(dir.clone()) {
            return Err(f"cannot create {dir}: {e}");
        }
        if let Err(e) = fs.write_bytes(f"{dir}/shop.mo", data.clone()) {
            return Err(f"cannot write {dir}/shop.mo: {e}");
        }
        let mut plural: i64 = 0;
        let mut ctx: i64 = 0;
        for i in 0..c.msgs.len() {
            if contains_u8(c.msgs[i].key, 0) {
                plural += 1;
            }
            if contains_u8(c.msgs[i].key, 4) {
                ctx += 1;
            }
        }
        println(f"{name}: {c.msgs.len()} messages ({plural} plural, {ctx} with context), {c.fuzzy} fuzzy and {c.empty} untranslated left out, {data.len()} bytes, head {hex_of(data, 28)}");
    }
    Ok(())
}

fn load(path: Str) -> Result[Catalog, String] {
    let buf = read_bytes(path)?;
    load_mo(buf, path)
}

fn int_list(v: ref Vec[i64]) -> String {
    let mut out = "[".to_string();
    for i in 0..v.len() {
        if i > 0 {
            out.push_str(", ");
        }
        out.push_str(f"{v[i]}");
    }
    out.push_str("]");
    out
}

fn show_catalog(path: Str) -> Option[Catalog] {
    let c = match load(path) {
        Ok(c) => c,
        Err(e) => {
            println(f"{path}: {e}");
            return None;
        }
    };
    let cs = c.charset.clone().unwrap_or("None".to_string());
    println(f"{path}: charset {cs}, {c.count} entries");
    let mut order: Vec[i64] = Vec.new();
    for i in 0..c.info_keys.len() {
        order.push(i);
    }
    for i in 1..order.len() {
        let mut j = i;
        while j > 0 and c.info_keys[order[j]] < c.info_keys[order[j - 1]] {
            order.swap(j - 1, j);
            j -= 1;
        }
    }
    for k in 0..order.len() {
        let i = order[k];
        println(f"  {c.info_keys[i]}: {py_repr(c.info_vals[i])}");
    }
    let mut forms: Vec[i64] = Vec.new();
    for n in SAMPLES {
        forms.push(plural_of(c.plural, n).unwrap_or(-1));
    }
    println(f"  plural: {int_list(forms)}");
    Some(c)
}

fn replace_all(s: Str, from: Str, to: Str) -> String {
    let b = to_bytes(s);
    let mut out = String.new();
    let mut i: i64 = 0;
    let mut st: i64 = 0;
    while i < b.len() {
        if starts_at(b, i, from) {
            out.push_str(byte_str(b, st, i));
            out.push_str(to);
            i += from.len();
            st = i;
        } else {
            i += 1;
        }
    }
    out.push_str(byte_str(b, st, b.len()));
    out
}

fn render(chain: ref Vec[Catalog], line: Str) -> Vec[String] {
    let (kind, _, rest) = partition(line, b' ');
    let mut out: Vec[String] = Vec.new();
    if kind == "_" {
        let msg = replace_all(rest, "\\n", "\n");
        let t = replace_all(replace_all(gettext(chain, msg), "{shop}", "Kāra Books"), "{id}", "1042");
        out.push(py_repr(t));
        return out;
    }
    let parts = split_on(rest, b'|');
    if kind == "p" {
        out.push(f"{parts[0]}: {py_repr(pgettext(chain, parts[0], parts[1]))}");
        return out;
    }
    if kind == "n" {
        for n in split_on(parts[2], b' ') {
            let k = py_int(n).unwrap_or(0);
            out.push(f"{n}: {py_repr(replace_all(ngettext(chain, parts[0], parts[1], k), "{n}", n))}");
        }
        return out;
    }
    for n in split_on(parts[3], b' ') {
        let k = py_int(n).unwrap_or(0);
        out.push(f"{parts[0]} {n}: {py_repr(replace_all(npgettext(chain, parts[0], parts[1], parts[2], k), "{n}", n))}");
    }
    out
}

fn show_ui() -> Result[(), String] {
    println("== ui");
    let mut ui: Vec[String] = Vec.new();
    for l in lines_of(read("data/ui.txt")?) {
        if l.len() > 0 and first_byte(l) != b'#' {
            ui.push(l.clone());
        }
    }
    for line in lines_of(read("data/langs.txt")?) {
        let langs = split_on(line, b' ');
        println(f"-- {join(langs, " -> ")} -> source");
        let mut chain: Vec[Catalog] = Vec.new();
        for lang in langs {
            chain.push(load(f"data/locale/{lang}/LC_MESSAGES/shop.mo")?);
        }
        for u in ui {
            let (kind, _, _) = partition(u, b' ');
            for out in render(chain, u) {
                println(f"  {kind} {out}");
            }
        }
    }
    Ok(())
}

fn show_plurals() -> Result[(), String] {
    println("== plural forms");
    let text = read("data/plurals.txt")?;
    let mut all = split_on(text, b'\n');
    all.pop();
    for p in all {
        let cps = code_points(p);
        let shown = if cps.len() < 60 { p.clone() } else { f"{slice(p, 0, 57)}..." };
        let f = match c2py(p) {
            Ok(f) => f,
            Err(e) => {
                println(f"{py_repr(shown)}: ValueError: {e}");
                continue;
            }
        };
        let mut vals: Vec[String] = Vec.new();
        for n in SAMPLES {
            vals.push(match plural_of(f, n) {
                Ok(v) => f"{v}",
                Err(_) => "ZeroDivisionError".to_string(),
            });
        }
        let src = if f.source.len() < 90 { f.source.clone() } else { f"{slice(f.source, 0, 87)}..." };
        println(f"{py_repr(shown)}: {src}");
        println(f"  {join(vals, " ")}");
    }
    Ok(())
}

fn show_broken() -> Result[(), String] {
    println("== broken");
    for name in sorted_names("data/broken")? {
        if let Some(c) = show_catalog(f"data/broken/{name}") {
            let mut chain: Vec[Catalog] = Vec.new();
            chain.push(c);
            println(f"  {py_repr(gettext(chain, "Your cart"))} {py_repr(ngettext(chain, "{n} day left", "{n} days left", 2))} {py_repr(ngettext(chain, "b", "bs", 5))} {py_repr(gettext(chain, "b"))}");
        }
    }
    Ok(())
}

fn run() -> Result[(), String] {
    write_data()?;
    compile_all()?;
    println("== catalogs");
    for name in sorted_names("data/locale")? {
        let _ = show_catalog(f"data/locale/{name}/LC_MESSAGES/shop.mo");
    }
    show_ui()?;
    show_plurals()?;
    show_broken()
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_gettext: {e}");
    }
}
