// mini_wcwidth: how many terminal cells a string takes, as wcwidth 0.2.13
// works it out. wcwidth() gives one character's width for any of the 19
// Unicode versions wcwidth knows (zero width marks, wide East Asian and
// emoji characters, -1 for controls), wcswidth() adds a string up with its
// handling of zero width joiners and variation selector 16, and the
// version a caller asks for is matched to one of the 19 the way
// _wcmatch_version does it, warnings and int() parsing included.
//
// The jobs in data/jobs.jsonl measure characters and strings across the
// versions and match version strings, and then do what a terminal
// program needs widths for: lay file names out in columns like ls, draw a
// table with cells cut to fit, wrap chat messages, and show log lines with
// tabs expanded and controls made visible.

// ------------------------------------------------------------ JSON in

// The jobs file holds strings, numbers, booleans, arrays and objects.
#[derive(Clone)]
enum J {
    S(String),
    N(i64),
    A(Vec[J]),
    O(Vec[(String, J)]),
    B(bool),
    Null,
}

fn json_space(c: char) -> bool {
    c == ' ' or c == '\n' or c == '\r' or c == '\t'
}

struct JsonIn {
    cs: Vec[char],
    pos: i64,
}

impl JsonIn {
    fn ws(mut ref self) {
        while self.pos < self.cs.len() and json_space(self.cs[self.pos]) {
            self.pos += 1;
        }
    }

    fn word(mut ref self, w: Str) -> bool {
        let wc: Vec[char] = w.chars().collect();
        if self.pos + wc.len() > self.cs.len() {
            return false;
        }
        let mut k = 0;
        while k < wc.len() {
            if self.cs[self.pos + k] != wc[k] {
                return false;
            }
            k += 1;
        }
        self.pos += wc.len();
        true
    }

    fn hex4(mut ref self) -> u32 {
        let mut n: u32 = 0;
        let mut k = 0;
        while k < 4 {
            let c = self.cs[self.pos];
            let d = if c >= '0' and c <= '9' {
                (c as u32) - ('0' as u32)
            } else if c >= 'a' and c <= 'f' {
                (c as u32) - ('a' as u32) + 10
            } else {
                (c as u32) - ('A' as u32) + 10
            };
            n = n * 16 + d;
            self.pos += 1;
            k += 1;
        }
        n
    }

    fn value(mut ref self) -> Result[J, String] {
        self.ws();
        if self.pos >= self.cs.len() {
            return Err("unexpected end of JSON".to_string());
        }
        let c = self.cs[self.pos];
        if c == '[' {
            self.pos += 1;
            let mut items: Vec[J] = Vec.new();
            self.ws();
            if self.pos < self.cs.len() and self.cs[self.pos] == ']' {
                self.pos += 1;
                return Ok(J.A(items));
            }
            loop {
                items.push(self.value()?);
                self.ws();
                if self.pos >= self.cs.len() {
                    return Err("unterminated JSON array".to_string());
                }
                let d = self.cs[self.pos];
                self.pos += 1;
                if d == ']' {
                    return Ok(J.A(items));
                }
                if d != ',' {
                    return Err(f"bad JSON array separator {d}");
                }
            }
        }
        if c == '{' {
            self.pos += 1;
            let mut members: Vec[(String, J)] = Vec.new();
            self.ws();
            if self.pos < self.cs.len() and self.cs[self.pos] == '}' {
                self.pos += 1;
                return Ok(J.O(members));
            }
            loop {
                let key = match self.value()? {
                    J.S(k) => k,
                    _ => return Err("JSON object key is not a string".to_string()),
                };
                self.ws();
                if self.pos >= self.cs.len() or self.cs[self.pos] != ':' {
                    return Err("missing ':' in JSON object".to_string());
                }
                self.pos += 1;
                let v = self.value()?;
                members.push((key, v));
                self.ws();
                if self.pos >= self.cs.len() {
                    return Err("unterminated JSON object".to_string());
                }
                let d = self.cs[self.pos];
                self.pos += 1;
                if d == '}' {
                    return Ok(J.O(members));
                }
                if d != ',' {
                    return Err(f"bad JSON object separator {d}");
                }
            }
        }
        if self.word("true") {
            return Ok(J.B(true));
        }
        if self.word("false") {
            return Ok(J.B(false));
        }
        if self.word("null") {
            return Ok(J.Null);
        }
        if c == '-' or (c >= '0' and c <= '9') {
            let mut neg = false;
            if c == '-' {
                neg = true;
                self.pos += 1;
            }
            let mut n: i64 = 0;
            while self.pos < self.cs.len() and self.cs[self.pos] >= '0' and self.cs[self.pos] <= '9' {
                n = n * 10 + ((self.cs[self.pos] as u32) - ('0' as u32)) as i64;
                self.pos += 1;
            }
            return Ok(J.N(if neg { -n } else { n }));
        }
        if c != '"' {
            return Err(f"unexpected JSON character {c}");
        }
        self.pos += 1;
        let mut s = String.new();
        while self.pos < self.cs.len() {
            let d = self.cs[self.pos];
            self.pos += 1;
            if d == '"' {
                return Ok(J.S(s));
            }
            if d != '\\' {
                s.push(d);
                continue;
            }
            let e = self.cs[self.pos];
            self.pos += 1;
            if e == 'n' {
                s.push('\n');
            } else if e == 't' {
                s.push('\t');
            } else if e == 'r' {
                s.push('\r');
            } else if e == 'b' {
                s.push('\u{8}');
            } else if e == 'f' {
                s.push('\u{c}');
            } else if e == 'u' {
                let mut n = self.hex4();
                if n >= 0xD800 and n < 0xDC00 {
                    self.pos += 2;
                    let lo = self.hex4();
                    n = 0x10000 + ((n - 0xD800) << 10) + (lo - 0xDC00);
                }
                s.push(char.try_from(n).unwrap_or('?'));
            } else {
                s.push(e);
            }
        }
        Err("unterminated JSON string".to_string())
    }
}

fn json_line(l: ref String) -> Result[J, String] {
    let mut p = JsonIn { cs: l.chars().collect(), pos: 0 };
    p.value()
}

fn j_get(j: ref J, key: Str) -> J {
    match j {
        J.O(members) => {
            for (k, v) in members.iter() {
                if k == key {
                    return v.clone();
                }
            }
            J.Null
        }
        _ => J.Null,
    }
}

fn j_has(j: ref J, key: Str) -> bool {
    match j_get(j, key) {
        J.Null => false,
        _ => true,
    }
}

fn j_str(j: ref J, key: Str) -> String {
    match j_get(j, key) {
        J.S(s) => s,
        _ => String.new(),
    }
}

fn j_int(j: ref J, key: Str, default: i64) -> i64 {
    match j_get(j, key) {
        J.N(n) => n,
        _ => default,
    }
}

fn j_bool(j: ref J, key: Str) -> bool {
    match j_get(j, key) {
        J.B(b) => b,
        _ => false,
    }
}

fn j_strs(j: ref J, key: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    if let J.A(items) = j_get(j, key) {
        for it in items.iter() {
            if let J.S(s) = it {
                out.push(s.clone());
            }
        }
    }
    out
}

// ------------------------------------------------------------ text as code points

fn cps(s: Str) -> Vec[i64] {
    codepoints(s.bytes())
}

fn cps_of(s: ref String) -> Vec[i64] {
    codepoints(s.bytes())
}

fn cat(a: ref Vec[i64], b: ref Vec[i64]) -> Vec[i64] {
    let mut out = a.clone();
    push_all(mut out, b);
    out
}

fn cat_ascii(a: ref Vec[i64], s: Str) -> Vec[i64] {
    let mut out = a.clone();
    push_ascii(mut out, s);
    out
}

fn index_of(s: ref Vec[i64], c: i64) -> i64 {
    let mut i = 0;
    while i < s.len() {
        if s[i] == c {
            return i;
        }
        i += 1;
    }
    -1
}

fn has(s: ref Vec[i64], c: i64) -> bool {
    index_of(s, c) >= 0
}

// `needle in s` for str
fn contains_seq(s: ref Vec[i64], needle: ref Vec[i64]) -> bool {
    find_seq(s, needle, 0) >= 0
}

fn find_seq(s: ref Vec[i64], needle: ref Vec[i64], from: i64) -> i64 {
    let mut i = from;
    while i + needle.len() <= s.len() {
        let mut k = 0;
        while k < needle.len() and s[i + k] == needle[k] {
            k += 1;
        }
        if k == needle.len() {
            return i;
        }
        i += 1;
    }
    -1
}

fn starts_with_seq(s: ref Vec[i64], p: Str) -> bool {
    let n = cps(p);
    if n.len() > s.len() {
        return false;
    }
    let mut k = 0;
    while k < n.len() {
        if s[k] != n[k] {
            return false;
        }
        k += 1;
    }
    true
}

fn eq_ascii(s: ref Vec[i64], p: Str) -> bool {
    same(s, cps(p))
}

// One character in a str of ASCII choices.
fn in_ascii(c: i64, set: Str) -> bool {
    for b in set.bytes() {
        if (b as i64) == c {
            return true;
        }
    }
    false
}

// str.replace
fn replace_seq(s: ref Vec[i64], old: ref Vec[i64], new: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < s.len() {
        if old.len() > 0 and i + old.len() <= s.len() {
            let mut k = 0;
            while k < old.len() and s[i + k] == old[k] {
                k += 1;
            }
            if k == old.len() {
                push_all(mut out, new);
                i += old.len();
                continue;
            }
        }
        out.push(s[i]);
        i += 1;
    }
    out
}

fn replace_char(s: ref Vec[i64], old: i64, new: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s {
        if c == old {
            push_all(mut out, new);
        } else {
            out.push(c);
        }
    }
    out
}

fn repeat(c: i64, n: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < n {
        out.push(c);
        k += 1;
    }
    out
}

// str.split(sep) for a one-character separator
fn split_on(s: ref Vec[i64], sep: i64) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    for c in s {
        if c == sep {
            out.push(cur);
            cur = Vec.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn strip(s: ref Vec[i64]) -> Vec[i64] {
    let mut a = 0;
    let mut b = s.len();
    while a < b and is_space(s[a], false) {
        a += 1;
    }
    while b > a and is_space(s[b - 1], false) {
        b -= 1;
    }
    slice(s, a, b)
}


// The value of a decimal digit: the decimal digits come in runs of ten.
fn digit_value(c: i64) -> i64 {
    if c < 0x80 {
        return c - 48;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return c - s;
        }
    }
    0
}

// str.isdigit, for the strings date_convert looks at
fn all_decimal(s: ref Vec[i64]) -> bool {
    if s.len() == 0 {
        return false;
    }
    for c in s {
        if not is_decimal(c) {
            return false;
        }
    }
    true
}

fn pad_n(n: i64, width: i64) -> String {
    let mut s = f"{n}";
    while s.len() < width {
        s = f"0{s}";
    }
    s
}

fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

fn floor_mod(a: i64, b: i64) -> i64 {
    a - floor_div(a, b) * b
}

// -------------------------------------------------------------- text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for cp in s {
        if cp < 0x80 {
            out.push(cp as u8);
        } else if cp < 0x800 {
            out.push((0xC0 | (cp >> 6)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else if cp < 0x10000 {
            out.push((0xE0 | (cp >> 12)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (cp >> 18)) as u8);
            out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
            out.push((0x80 | (cp & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn hex_n(cp: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// str.isprintable() from U+0080 up, from the table of code points that
// are not printable.
fn is_printable(c: i64, un: ref Vec[(i64, i64)]) -> bool {
    bisearch(c, un) == 0
}

fn str_repr(s: ref Vec[i64], out: mut ref Vec[i64], un: ref Vec[(i64, i64)]) {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c, un) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
}


fn repr_of(s: ref Vec[i64], un: ref Vec[(i64, i64)]) -> String {
    let mut out: Vec[i64] = Vec.new();
    str_repr(s, mut out, un);
    to_string(out)
}

// ----------------------------------------------------- character kinds

fn is_decimal(c: i64) -> bool {
    if c < 0x80 {
        return c >= 48 and c <= 57;
    }
    let starts = [0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6, 0xD66, 0xDE6, 0xE50, 0xED0, 0xF20, 0x1040, 0x1090, 0x17E0, 0x1810, 0x1946, 0x19D0, 0x1A80, 0x1A90, 0x1B50, 0x1BB0, 0x1C40, 0x1C50, 0xA620, 0xA8D0, 0xA900, 0xA9D0, 0xA9F0, 0xAA50, 0xABF0, 0xFF10, 0x104A0, 0x10D30, 0x11066, 0x110F0, 0x11136, 0x111D0, 0x112F0, 0x11450, 0x114D0, 0x11650, 0x116C0, 0x11730, 0x118E0, 0x11950, 0x11C50, 0x11D50, 0x11DA0, 0x11F50, 0x16A60, 0x16AC0, 0x16B50, 0x1D7CE, 0x1D7D8, 0x1D7E2, 0x1D7EC, 0x1D7F6, 0x1E140, 0x1E2F0, 0x1E4F0, 0x1E950, 0x1FBF0];
    for s in starts {
        if c >= s and c < s + 10 {
            return true;
        }
    }
    false
}

fn is_space(c: i64, ascii: bool) -> bool {
    if c == 32 or (c >= 9 and c <= 13) {
        return true;
    }
    if ascii {
        return false;
    }
    (c >= 0x1C and c <= 0x1F) or c == 0x85 or c == 0xA0 or c == 0x1680 or (c >= 0x2000 and c <= 0x200A) or c == 0x2028 or c == 0x2029 or c == 0x202F or c == 0x205F or c == 0x3000
}


// ------------------------------------------------------------ int()

// What int(s, base) makes of a str, for base 10 or 16, as CPython reads
// it: Unicode spaces and decimal digits are first turned into ASCII, then
// surrounding whitespace, a sign, a 0x prefix (base 16, with one
// underscore allowed after it), and single underscores between digits.
// `big` is set when the value does not fit a u128.
struct PyInt {
    neg: bool,
    val: u128,
    big: bool,
}

fn u128_max() -> u128 {
    (0xFFFF_FFFF_FFFF_FFFFu128 << 64) | 0xFFFF_FFFF_FFFF_FFFFu128
}

fn ascii_digit(c: i64, base: i64) -> i64 {
    let d = if c >= 48 and c <= 57 {
        c - 48
    } else if c >= 97 and c <= 122 {
        c - 87
    } else if c >= 65 and c <= 90 {
        c - 55
    } else {
        99
    };
    if d < base { d } else { -1 }
}

fn py_int(s: ref Vec[i64], base: i64) -> Option[PyInt] {
    // _PyUnicode_TransformDecimalAndSpaceToASCII
    let mut a: Vec[i64] = Vec.new();
    for c in s.iter() {
        if *c < 0x80 {
            a.push(*c);
        } else if is_space(*c, false) {
            a.push(32);
        } else if is_decimal(*c) {
            a.push(48 + digit_value(*c));
        } else {
            a.push(63);
        }
    }
    let n = a.len();
    let mut i = 0;
    while i < n and is_space(a[i], true) {
        i += 1;
    }
    let mut neg = false;
    if i < n and (a[i] == 43 or a[i] == 45) {
        neg = a[i] == 45;
        i += 1;
    }
    if base == 16 and i + 1 < n and a[i] == 48 and (a[i + 1] == 120 or a[i + 1] == 88) {
        i += 2;
        if i < n and a[i] == 95 {
            i += 1;
        }
    }
    if i < n and a[i] == 95 {
        return None;
    }
    let mut val: u128 = 0;
    let mut big = false;
    let mut digits = 0;
    let mut prev = 0;
    while i < n and (ascii_digit(a[i], base) >= 0 or a[i] == 95) {
        if a[i] == 95 {
            if prev == 95 {
                return None;
            }
        } else {
            let d = ascii_digit(a[i], base) as u128;
            let b = base as u128;
            if big or val > (u128_max() - d) / b {
                big = true;
            } else {
                val = val * b + d;
            }
            digits += 1;
        }
        prev = a[i];
        i += 1;
    }
    if prev == 95 or digits == 0 {
        return None;
    }
    while i < n and is_space(a[i], true) {
        i += 1;
    }
    if i != n {
        return None;
    }
    Some(PyInt { neg: neg, val: val, big: big })
}


// ------------------------------------------------------------ tables

// A table is a sorted list of code point ranges, both ends included.
fn parse_ranges(t: ref String) -> Vec[(i64, i64)] {
    let mut out: Vec[(i64, i64)] = Vec.new();
    if t.is_empty() {
        return out;
    }
    for part in t.split(",") {
        let ends: Vec[Str] = part.split("-").collect();
        let a = hex_value(ends[0]);
        let b = if ends.len() > 1 { hex_value(ends[1]) } else { a };
        out.push((a, b));
    }
    out
}

fn hex_value(s: Str) -> i64 {
    let mut v = 0;
    for b in s.bytes() {
        let d = if b >= b'a' { (b - b'a') as i64 + 10 } else { (b - b'0') as i64 };
        v = v * 16 + d;
    }
    v
}

// _bisearch: 1 when ucs is in one of the table's ranges, else 0.
fn bisearch(ucs: i64, table: ref Vec[(i64, i64)]) -> i64 {
    let mut lbound = 0;
    let mut ubound = table.len() - 1;
    if ubound < 0 {
        return 0;
    }
    if ucs < table[0].0 or ucs > table[ubound].1 {
        return 0;
    }
    while ubound >= lbound {
        let mid = (lbound + ubound) / 2;
        if ucs > table[mid].1 {
            lbound = mid + 1;
        } else if ucs < table[mid].0 {
            ubound = mid - 1;
        } else {
            return 1;
        }
    }
    0
}

struct Tables {
    versions: Vec[String],
    zero: Vec[Vec[(i64, i64)]],
    wide: Vec[Vec[(i64, i64)]],
    vs16: Vec[(i64, i64)],
    unprintable: Vec[(i64, i64)],
}

fn load_tables() -> Tables {
    let versions = versions();
    let mut zero: Vec[Vec[(i64, i64)]] = Vec.new();
    let mut wide: Vec[Vec[(i64, i64)]] = Vec.new();
    let mut k = 0;
    while k < versions.len() {
        zero.push(parse_ranges(table_text(true, k)));
        wide.push(parse_ranges(table_text(false, k)));
        k += 1;
    }
    Tables {
        versions: versions,
        zero: zero,
        wide: wide,
        vs16: parse_ranges(vs16_text()),
        unprintable: parse_ranges(unprintable_text()),
    }
}

// ------------------------------------------------------------ versions

// What one job keeps between calls: the UNICODE_VERSION it runs under,
// the version strings already matched (wcwidth caches those, so each one
// warns only the first time), and the warnings not yet shown.
struct Job {
    env: Option[String],
    seen: Vec[(String, i64)],
    warnings: Vec[String],
}

fn new_job(env: own Option[String]) -> Job {
    Job { env: env, seen: Vec.new(), warnings: Vec.new() }
}

// _wcversion_value: the version split on dots, each part read by int().
fn version_value(s: ref String) -> Option[Vec[i64]] {
    let mut out: Vec[i64] = Vec.new();
    for part in split_on(cps_of(s), 46) {
        match py_int(part, 10) {
            Some(p) => {
                let v = if p.big or p.val > 0x7FFF_FFFF_FFFF_FFFFu128 {
                    0x7FFF_FFFF_FFFF_FFFF
                } else {
                    p.val as i64
                };
                out.push(if p.neg { -v } else { v });
            }
            None => return None,
        }
    }
    Some(out)
}

// Python's tuple comparison: -1, 0 or 1.
fn cmp_tuple(a: ref Vec[i64], b: ref Vec[i64]) -> i64 {
    let mut k = 0;
    while k < a.len() and k < b.len() {
        if a[k] < b[k] {
            return -1;
        }
        if a[k] > b[k] {
            return 1;
        }
        k += 1;
    }
    if a.len() < b.len() {
        return -1;
    }
    if a.len() > b.len() {
        return 1;
    }
    0
}

fn prefix(a: ref Vec[i64], n: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut k = 0;
    while k < n and k < a.len() {
        out.push(a[k]);
        k += 1;
    }
    out
}

fn repr_str(s: ref String, t: ref Tables) -> String {
    repr_of(cps_of(s), t.unprintable)
}

// _wcmatch_version: which of the versions a given version string means,
// as an index into t.versions.
fn match_version(t: ref Tables, job: mut ref Job, given: ref String) -> i64 {
    for (g, k) in job.seen.iter() {
        if g == given {
            return *k;
        }
    }
    let k = match_uncached(t, mut job, given);
    job.seen.push((given.clone(), k));
    k
}

fn match_uncached(t: ref Tables, job: mut ref Job, given0: ref String) -> i64 {
    let last = t.versions.len() - 1;
    let mut given = given0.clone();
    if given == "auto" {
        given = match ref job.env {
            Some(e) => e.clone(),
            None => "latest".to_string(),
        };
    }
    if given == "latest" {
        return last;
    }
    let mut k = 0;
    while k <= last {
        if t.versions[k] == given {
            return k;
        }
        k += 1;
    }
    let cmp_given = match version_value(given) {
        Some(v) => v,
        None => {
            let g = repr_str(given, t);
            let l = repr_str(t.versions[last], t);
            job.warnings.push(f"UNICODE_VERSION value, {g}, is invalid. Value should be in form of `integer[.]+', the latest supported unicode version {l} has been inferred.");
            return last;
        }
    };
    let earliest = version_value(t.versions[0]).unwrap();
    if cmp_tuple(cmp_given, earliest) <= 0 {
        let g = repr_str(given, t);
        let e = repr_str(t.versions[0], t);
        job.warnings.push(f"UNICODE_VERSION value, {g}, is lower than any available unicode version. Returning lowest version level, {e}");
        return 0;
    }
    let mut idx = 0;
    while idx < last {
        let next = version_value(t.versions[idx + 1]).unwrap();
        if cmp_tuple(cmp_given, prefix(next, cmp_given.len())) == 0 {
            return idx + 1;
        }
        if cmp_tuple(next, cmp_given) > 0 {
            return idx;
        }
        idx += 1;
    }
    last
}

// ------------------------------------------------------------ widths

// wcwidth(): the cells one character takes, 0 for none, -1 for a control.
// Python passes a str, so an empty one counts as NUL and a longer one is
// an error.
fn wcwidth(t: ref Tables, job: mut ref Job, wc: ref Vec[i64], version: ref String) -> Result[i64, String] {
    if wc.len() > 1 {
        let n = wc.len();
        return Err(f"TypeError: ord() expected a character, but string of length {n} found");
    }
    let ucs = if wc.len() == 1 { wc[0] } else { 0 };
    Ok(char_width(t, mut job, ucs, version))
}

fn char_width(t: ref Tables, job: mut ref Job, ucs: i64, version: ref String) -> i64 {
    if ucs >= 32 and ucs < 0x7f {
        return 1;
    }
    if (ucs != 0 and ucs < 32) or (ucs >= 0x7f and ucs < 0xa0) {
        return -1;
    }
    let k = match_version(t, mut job, version);
    if bisearch(ucs, t.zero[k]) == 1 {
        return 0;
    }
    1 + bisearch(ucs, t.wide[k])
}

// wcswidth(): the cells a string takes, or -1 when it holds a control.
// A zero width joiner hides the character after it, and VS16 makes the
// character before it wide when the table says so (from Unicode 9 on).
fn wcswidth(t: ref Tables, job: mut ref Job, s: ref Vec[i64], n: Option[i64], version: ref String) -> Result[i64, String] {
    let end = match n {
        Some(k) => k,
        None => s.len(),
    };
    let mut vs16_on: Option[bool] = None;
    let mut width = 0;
    let mut idx = 0;
    let mut last: Option[i64] = None;
    while idx < end {
        if idx >= s.len() {
            return Err("IndexError: string index out of range".to_string());
        }
        let c = s[idx];
        if c == 0x200D {
            idx += 2;
            continue;
        }
        if c == 0xFE0F and last.is_some() {
            if vs16_on.is_none() {
                let k = match_version(t, mut job, version);
                vs16_on = Some(k >= 10);
            }
            if vs16_on == Some(true) {
                width += bisearch(last.unwrap(), t.vs16);
                last = None;
            }
            idx += 1;
            continue;
        }
        let w = char_width(t, mut job, c, version);
        if w < 0 {
            return Ok(w);
        }
        if w > 0 {
            last = Some(c);
        }
        width += w;
        idx += 1;
    }
    Ok(width)
}

// ------------------------------------------------------------ jobs

fn emit(s: ref String) {
    println(s);
}

fn read_data(name: ref String) -> String {
    match fs.read_to_string(f"data/{name}") {
        Ok(t) => t,
        Err(e) => {
            eprintln(f"cannot read data/{name}: {e}");
            String.new()
        }
    }
}

// The file's lines, without the newline at the end of the last one.
fn read_lines(name: ref String) -> Vec[Vec[i64]] {
    let text = read_data(name);
    let mut lines = split_on(cps_of(text), 10);
    if lines.len() > 0 and lines[lines.len() - 1].len() == 0 {
        lines.pop();
    }
    lines
}

fn j_ints(j: ref J, key: Str) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    if let J.A(items) = j_get(j, key) {
        for it in items.iter() {
            if let J.N(n) = it {
                out.push(*n);
            }
        }
    }
    out
}

fn int_list(v: ref Vec[i64]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for x in v.iter() {
        parts.push(f"{x}");
    }
    let inner = parts.join(", ");
    f"[{inner}]"
}

fn flush_warnings(job: mut ref Job) {
    for w in job.warnings.iter() {
        emit(f"    warning: {w}");
    }
    job.warnings.clear();
}

fn version_of(j: ref J) -> String {
    if j_has(j, "version") { j_str(j, "version") } else { "auto".to_string() }
}

fn run_wcwidth(t: ref Tables, job: mut ref Job, j: ref J) {
    let v = version_of(j);
    for s in j_strs(j, "texts").iter() {
        let c = cps_of(s);
        let r = repr_of(c, t.unprintable);
        match wcwidth(t, mut job, c, v) {
            Ok(w) => emit(f"  {r} {w}"),
            Err(e) => emit(f"  {r} {e}"),
        }
        flush_warnings(mut job);
    }
}

fn run_wcswidth(t: ref Tables, job: mut ref Job, j: ref J) {
    let v = version_of(j);
    let n = if j_has(j, "n") { Some(j_int(j, "n", 0)) } else { None };
    for s in j_strs(j, "texts").iter() {
        let c = cps_of(s);
        let r = repr_of(c, t.unprintable);
        match wcswidth(t, mut job, c, n, v) {
            Ok(w) => emit(f"  {r} {w}"),
            Err(e) => emit(f"  {r} {e}"),
        }
        flush_warnings(mut job);
    }
}

fn run_match(t: ref Tables, job: mut ref Job, j: ref J) {
    for g in j_strs(j, "given").iter() {
        let k = match_version(t, mut job, g);
        let a = repr_str(g, t);
        let b = repr_str(t.versions[k], t);
        emit(f"  {a} -> {b}");
        flush_warnings(mut job);
    }
}

// ------------------------------------------------------------ reports

// The width of a string the reports have already cleaned of controls.
fn width(t: ref Tables, job: mut ref Job, s: ref Vec[i64]) -> i64 {
    wcswidth(t, mut job, s, None, "auto".to_string()).unwrap()
}

// Controls shown as '?', the way ls -q shows them.
fn clean(t: ref Tables, job: mut ref Job, s: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s.iter() {
        if char_width(t, mut job, *c, "auto".to_string()) < 0 {
            out.push(63);
        } else {
            out.push(*c);
        }
    }
    out
}

fn spaces(n: i64) -> Vec[i64] {
    repeat(32, n)
}

// ls -C: the most columns that fit, filled top to bottom.
fn run_columns(t: ref Tables, job: mut ref Job, j: ref J) {
    let mut names: Vec[Vec[i64]] = Vec.new();
    let mut ws: Vec[i64] = Vec.new();
    for raw in read_lines(j_str(j, "file")).iter() {
        let n = clean(t, mut job, raw);
        ws.push(width(t, mut job, n));
        names.push(n);
    }
    let n = names.len();
    let w = j_int(j, "width", 80);
    let mut cols = n;
    let mut rows = 1;
    let mut colw: Vec[i64] = Vec.new();
    while cols > 0 {
        rows = (n + cols - 1) / cols;
        if (cols - 1) * rows >= n {
            cols -= 1;
            continue;
        }
        colw = Vec.new();
        let mut total = 2 * (cols - 1);
        let mut c = 0;
        while c < cols {
            let mut m = 0;
            let mut i = c * rows;
            while i < (c + 1) * rows and i < n {
                if ws[i] > m {
                    m = ws[i];
                }
                i += 1;
            }
            colw.push(m);
            total += m;
            c += 1;
        }
        if total <= w or cols == 1 {
            break;
        }
        cols -= 1;
    }
    let cw = int_list(colw);
    emit(f"  {cols} columns, {rows} rows, widths {cw}");
    let mut r = 0;
    while r < rows {
        let mut line: Vec[i64] = Vec.new();
        let mut c = 0;
        while c < cols {
            let i = c * rows + r;
            if i >= n {
                break;
            }
            push_all(mut line, names[i]);
            if (c + 1) * rows + r < n {
                push_all(mut line, spaces(colw[c] - ws[i] + 2));
            }
            c += 1;
        }
        let l = to_string(line);
        emit(f"  |{l}");
        r += 1;
    }
}

// The string cut to w cells, with an ellipsis when anything was cut.
fn fit(t: ref Tables, job: mut ref Job, s: ref Vec[i64], w: i64) -> Vec[i64] {
    if width(t, mut job, s) <= w {
        return s.clone();
    }
    if w <= 0 {
        return Vec.new();
    }
    let mut k = 0;
    while k < s.len() and width(t, mut job, slice(s, 0, k + 1)) <= w - 1 {
        k += 1;
    }
    let mut out = slice(s, 0, k);
    out.push(0x2026);
    out
}

fn pad(t: ref Tables, job: mut ref Job, s: ref Vec[i64], w: i64, how: i64) -> Vec[i64] {
    let gap = w - width(t, mut job, s);
    if gap <= 0 {
        return s.clone();
    }
    if how == 60 {
        return cat(s, spaces(gap));
    }
    if how == 62 {
        return cat(spaces(gap), s);
    }
    let left = gap / 2;
    cat(cat(spaces(left), s), spaces(gap - left))
}

fn rule(ws: ref Vec[i64], a: i64, m: i64, b: i64) -> String {
    let mut out: Vec[i64] = vec![a];
    let mut k = 0;
    while k < ws.len() {
        if k > 0 {
            out.push(m);
        }
        push_all(mut out, repeat(0x2500, ws[k] + 2));
        k += 1;
    }
    out.push(b);
    to_string(out)
}

fn run_table(t: ref Tables, job: mut ref Job, j: ref J) {
    let mut rows: Vec[Vec[Vec[i64]]] = Vec.new();
    for line in read_lines(j_str(j, "file")).iter() {
        let mut cells: Vec[Vec[i64]] = Vec.new();
        for c in split_on(line, 44).iter() {
            cells.push(clean(t, mut job, c));
        }
        rows.push(cells);
    }
    let mut ws = j_ints(j, "widths");
    let mut c = 0;
    while c < ws.len() {
        if ws[c] == 0 {
            let mut m = 0;
            for r in rows.iter() {
                let x = width(t, mut job, r[c]);
                if x > m {
                    m = x;
                }
            }
            ws[c] = m;
        }
        c += 1;
    }
    let align = cps_of(j_str(j, "align"));
    let top = rule(ws, 0x250c, 0x252c, 0x2510);
    emit(f"  {top}");
    let mut k = 0;
    while k < rows.len() {
        let mut out: Vec[i64] = vec![0x2502, 32];
        let mut c = 0;
        while c < ws.len() {
            if c > 0 {
                push_all(mut out, vec![32, 0x2502, 32]);
            }
            let cell = fit(t, mut job, rows[k][c], ws[c]);
            push_all(mut out, pad(t, mut job, cell, ws[c], align[c]));
            c += 1;
        }
        push_all(mut out, vec![32, 0x2502]);
        let l = to_string(out);
        emit(f"  {l}");
        if k == 0 {
            let mid = rule(ws, 0x251c, 0x253c, 0x2524);
            emit(f"  {mid}");
        }
        k += 1;
    }
    let bottom = rule(ws, 0x2514, 0x2534, 0x2518);
    emit(f"  {bottom}");
}

// Greedy wrapping by cells: words go on the line while it fits, and a
// word wider than the line is cut into pieces that fit.
fn wrap(t: ref Tables, job: mut ref Job, text: ref Vec[i64], w: i64) -> Vec[Vec[i64]] {
    let mut lines: Vec[Vec[i64]] = Vec.new();
    let mut line: Vec[i64] = Vec.new();
    for word0 in split_on(text, 32).iter() {
        if word0.len() == 0 {
            continue;
        }
        let mut word = word0.clone();
        let cand = if line.len() == 0 {
            word.clone()
        } else {
            let mut c = line.clone();
            c.push(32);
            push_all(mut c, word);
            c
        };
        if width(t, mut job, cand) <= w {
            line = cand;
            continue;
        }
        if line.len() > 0 {
            lines.push(line);
            line = Vec.new();
        }
        while width(t, mut job, word) > w {
            let mut take = 1;
            while take < word.len() and width(t, mut job, slice(word, 0, take + 1)) <= w {
                take += 1;
            }
            lines.push(slice(word, 0, take));
            word = slice(word, take, word.len());
        }
        line = word;
    }
    if line.len() > 0 {
        lines.push(line);
    }
    lines
}

fn run_wrap(t: ref Tables, job: mut ref Job, j: ref J) {
    for raw in read_lines(j_str(j, "file")).iter() {
        let msg = clean(t, mut job, raw);
        let k = find_seq(msg, cps(": "), 0);
        let who = slice(msg, 0, k + 2);
        let indent = width(t, mut job, who);
        let mut w = j_int(j, "width", 80) - indent;
        if w < 1 {
            w = 1;
        }
        let mut lines = wrap(t, mut job, slice(msg, k + 2, msg.len()), w);
        if lines.len() == 0 {
            lines.push(Vec.new());
        }
        let a = to_string(who);
        let b = to_string(lines[0]);
        emit(f"  {a}{b}");
        let pad = to_string(spaces(indent));
        let mut i = 1;
        while i < lines.len() {
            let l = to_string(lines[i]);
            emit(f"  {pad}{l}");
            i += 1;
        }
    }
}

// Tabs expanded to the next multiple of 8 cells, and controls written
// out: ^X for C0, ^? for DEL, \xNN for C1.
fn expand(t: ref Tables, job: mut ref Job, s: ref Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut col = 0;
    for c in s.iter() {
        let u = *c;
        if u == 9 {
            let n = 8 - col % 8;
            push_all(mut out, spaces(n));
            col += n;
            continue;
        }
        if u < 32 {
            out.push(94);
            out.push(u + 64);
        } else if u == 0x7F {
            push_ascii(mut out, "^?");
        } else if u >= 0x80 and u < 0xA0 {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(u, 2));
        } else {
            out.push(u);
        }
        col = width(t, mut job, out);
    }
    out
}

fn run_tail(t: ref Tables, job: mut ref Job, j: ref J) {
    let w = j_int(j, "width", 80);
    for line in read_lines(j_str(j, "file")).iter() {
        let s = fit(t, mut job, expand(t, mut job, line), w);
        let l = to_string(pad(t, mut job, s, w, 60));
        emit(f"  |{l}|");
    }
}

// The job line: its kind, then what it was given, in a fixed order.
fn describe(t: ref Tables, j: ref J) -> String {
    let mut parts: Vec[String] = vec![j_str(j, "kind")];
    for k in ["version", "env", "n", "file", "width", "widths", "align"] {
        if not j_has(j, k) {
            continue;
        }
        let v = match j_get(j, k) {
            J.S(s) => repr_str(s, t),
            J.N(n) => f"{n}",
            J.A(_) => int_list(j_ints(j, k)),
            _ => "?".to_string(),
        };
        parts.push(f"{k}={v}");
    }
    parts.join(" ")
}

fn run() -> Result[(), String] {
    let t = load_tables();
    let vs = t.versions.join(", ");
    emit(f"wcwidth 0.2.13, Unicode {vs}");
    let text = read_data("jobs.jsonl".to_string());
    let mut n = 0;
    for line in text.lines() {
        if line.is_empty() {
            continue;
        }
        let j = json_line(line.to_string())?;
        n += 1;
        let d = describe(t, j);
        emit(f"job {n}: {d}");
        let env = if j_has(j, "env") { Some(j_str(j, "env")) } else { None };
        let mut job = new_job(env);
        let kind = j_str(j, "kind");
        if kind == "wcwidth" {
            run_wcwidth(t, mut job, j);
        } else if kind == "wcswidth" {
            run_wcswidth(t, mut job, j);
        } else if kind == "match" {
            run_match(t, mut job, j);
        } else if kind == "columns" {
            run_columns(t, mut job, j);
        } else if kind == "table" {
            run_table(t, mut job, j);
        } else if kind == "wrap" {
            run_wrap(t, mut job, j);
        } else if kind == "tail" {
            run_tail(t, mut job, j);
        }
        flush_warnings(mut job);
    }
    Ok(())
}

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn hex_val(c: u8) -> u8 {
    if c >= b'a' { c - b'a' + 10 } else { c - b'0' }
}

fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    if let Err(e) = run() {
        eprintln(e);
    }
}

// ------------------------------------------------------------ the tables

// The Unicode versions the tables are for, oldest first.
fn versions() -> Vec[String] {
    vec!["4.1.0".to_string(), "5.0.0".to_string(), "5.1.0".to_string(), "5.2.0".to_string(), "6.0.0".to_string(), "6.1.0".to_string(), "6.2.0".to_string(), "6.3.0".to_string(), "7.0.0".to_string(), "8.0.0".to_string(), "9.0.0".to_string(), "10.0.0".to_string(), "11.0.0".to_string(), "12.0.0".to_string(), "12.1.0".to_string(), "13.0.0".to_string(), "14.0.0".to_string(), "15.0.0".to_string(), "15.1.0".to_string()]
}

// The table text for version k of versions(): zero width when `zero`,
// else wide.
fn table_text(zero: bool, k: i64) -> String {
    match (zero, k) {
        (true, 0) => zero_0(),
        (true, 1) => zero_1(),
        (true, 2) => zero_2(),
        (true, 3) => zero_3(),
        (true, 4) => zero_4(),
        (true, 5) => zero_5(),
        (true, 6) => zero_6(),
        (true, 7) => zero_7(),
        (true, 8) => zero_8(),
        (true, 9) => zero_9(),
        (true, 10) => zero_10(),
        (true, 11) => zero_11(),
        (true, 12) => zero_12(),
        (true, 13) => zero_13(),
        (true, 14) => zero_14(),
        (true, 15) => zero_15(),
        (true, 16) => zero_16(),
        (true, 17) => zero_17(),
        (true, 18) => zero_18(),
        (false, 0) => wide_0(),
        (false, 1) => wide_1(),
        (false, 2) => wide_2(),
        (false, 3) => wide_3(),
        (false, 4) => wide_4(),
        (false, 5) => wide_5(),
        (false, 6) => wide_6(),
        (false, 7) => wide_7(),
        (false, 8) => wide_8(),
        (false, 9) => wide_9(),
        (false, 10) => wide_10(),
        (false, 11) => wide_11(),
        (false, 12) => wide_12(),
        (false, 13) => wide_13(),
        (false, 14) => wide_14(),
        (false, 15) => wide_15(),
        (false, 16) => wide_16(),
        (false, 17) => wide_17(),
        (false, 18) => wide_18(),
        _ => String.new(),
    }
}

