    s.push_str("crypt 'Hello world!' '$5$rounds=1000$saltstringsaltstring'\n");
    s.push_str("crypt pw '$6$rounds=10$tiny'\n");
    s.push_str("crypt pw '$1$abc'\n");
    s.push_str("crypt pw '$9$what'\n");
    s.push_str("# htpasswd files.\n");
    s.push_str("htpasswd -vb data/htpasswd alice apache\n");
    s.push_str("htpasswd -vb data/htpasswd alice wrong\n");
    s.push_str("htpasswd -vb data/htpasswd bob secret\n");
    s.push_str("htpasswd -vb data/htpasswd carol pa55word\n");
    s.push_str("htpasswd -vb data/htpasswd dave wonderland\n");
    s.push_str("htpasswd -vb data/htpasswd erin x\n");
    s.push_str("htpasswd -vb data/htpasswd frank plaintext\n");
    s.push_str("htpasswd -vb data/htpasswd zed x\n");
    s.push_str("# Changing aging and locks.\n");
    s.push_str("chage -R data/sys -d 2026-10-01 -M 60 -W 10 alice\n");
    s.push_str("chage -R data/sys -l alice\n");
    s.push_str("chage -R data/sys -E 2026-12-31 -I 5 bob\n");
    s.push_str("chage -R data/sys -l bob\n");
    s.push_str("chage -R data/sys -E -1 frank\n");
    s.push_str("login data/sys frank s3cret\n");
    s.push_str("chage -R data/sys -d 0 alice\n");
    s.push_str("login data/sys alice wonderland\n");
    s.push_str("chage -R data/sys -d 2026-02-30 -m 3 dave\n");
    s.push_str("chage -R data/sys -l dave\n");
    s.push_str("chage -R data/sys -M x alice\n");
    s.push_str("chage -R data/sys -d garbage alice\n");
    s.push_str("chage -R data/sys -m 5 zed\n");
    s.push_str("passwd -R data/sys -l bob\n");
    s.push_str("passwd -R data/sys -S bob\n");
    s.push_str("login data/sys bob builder42\n");
    s.push_str("passwd -R data/sys -u bob\n");
    s.push_str("passwd -R data/sys -u ivan\n");
    s.push_str("passwd -R data/sys -d carol\n");
    s.push_str("passwd -R data/sys -S carol\n");
    s.push_str("login data/sys carol whatever\n");
    s.push_str("passwd -R data/sys -e erin\n");
    s.push_str("passwd -R data/sys -S erin\n");
    s.push_str("passwd -R data/sys -n 2 -x 45 -w 3 -i 9 root\n");
    s.push_str("passwd -R data/sys -S root\n");
    s.push_str("passwd -R data/sys -x many root\n");
    s.push_str("passwd -R data/sys -l zed\n");
    s.push_str("cat data/sys/etc/shadow\n");
    s
}

fn data_files() -> Vec[(String, String)] {
    let mut v: Vec[(String, String)] = Vec.new();
    v.push(("sys/layout.txt".to_string(), file_0()));
    v.push(("sys/etc/passwd".to_string(), file_1()));
    v.push(("sys/etc/shadow".to_string(), file_2()));
    v.push(("sys/etc/group".to_string(), file_3()));
    v.push(("broken/layout.txt".to_string(), file_4()));
    v.push(("broken/etc/passwd".to_string(), file_5()));
    v.push(("broken/etc/shadow".to_string(), file_6()));
    v.push(("broken/etc/group".to_string(), file_7()));
    v.push(("htpasswd".to_string(), file_8()));
    v.push(("jobs.txt".to_string(), file_9()));
    v
}

// The usage message shadow 4.13 prints after an error.
fn chage_usage() -> String {
    let mut s = String.new();
    s.push_str("Usage: chage [options] LOGIN\n");
    s.push_str("\n");
    s.push_str("Options:\n");
    s.push_str("  -d, --lastday LAST_DAY        set date of last password change to LAST_DAY\n");
    s.push_str("  -E, --expiredate EXPIRE_DATE  set account expiration date to EXPIRE_DATE\n");
    s.push_str("  -h, --help                    display this help message and exit\n");
    s.push_str("  -i, --iso8601                 use YYYY-MM-DD when printing dates\n");
    s.push_str("  -I, --inactive INACTIVE       set password inactive after expiration\n");
    s.push_str("                                to INACTIVE\n");
    s.push_str("  -l, --list                    show account aging information\n");
    s.push_str("  -m, --mindays MIN_DAYS        set minimum number of days before password\n");
    s.push_str("                                change to MIN_DAYS\n");
    s.push_str("  -M, --maxdays MAX_DAYS        set maximum number of days before password\n");
    s.push_str("                                change to MAX_DAYS\n");
    s.push_str("  -R, --root CHROOT_DIR         directory to chroot into\n");
    s.push_str("  -W, --warndays WARN_DAYS      set expiration warning days to WARN_DAYS\n");
    s.push_str("\n");
    s
}

// The usage message shadow 4.13 prints after an error.
fn passwd_usage() -> String {
    let mut s = String.new();
    s.push_str("Usage: passwd [options] [LOGIN]\n");
    s.push_str("\n");
    s.push_str("Options:\n");
    s.push_str("  -a, --all                     report password status on all accounts\n");
    s.push_str("  -d, --delete                  delete the password for the named account\n");
    s.push_str("  -e, --expire                  force expire the password for the named account\n");
    s.push_str("  -h, --help                    display this help message and exit\n");
    s.push_str("  -k, --keep-tokens             change password only if expired\n");
    s.push_str("  -i, --inactive INACTIVE       set password inactive after expiration\n");
    s.push_str("                                to INACTIVE\n");
    s.push_str("  -l, --lock                    lock the password of the named account\n");
    s.push_str("  -n, --mindays MIN_DAYS        set minimum number of days before password\n");
    s.push_str("                                change to MIN_DAYS\n");
    s.push_str("  -q, --quiet                   quiet mode\n");
    s.push_str("  -r, --repository REPOSITORY   change password in REPOSITORY repository\n");
    s.push_str("  -R, --root CHROOT_DIR         directory to chroot into\n");
    s.push_str("  -S, --status                  report password status on the named account\n");
    s.push_str("  -u, --unlock                  unlock the password of the named account\n");
    s.push_str("  -w, --warndays WARN_DAYS      set expiration warning days to WARN_DAYS\n");
    s.push_str("  -x, --maxdays MAX_DAYS        set maximum number of days before password\n");
    s.push_str("                                change to MAX_DAYS\n");
    s.push_str("\n");
    s
}


fn write_data() -> Result[(), String] {
    for (name, text) in data_files().into_iter() {
        let path = f"data/{name}";
        let cut = path.len() - before(reverse(path), b'/').len() - 1;
        let dir = slice(path, 0, cut);
        if let Err(e) = fs.create_dir_all(dir.clone()) {
            return Err(f"cannot create {dir}: {e}");
        }
        if let Err(e) = fs.write(path.clone(), text) {
            return Err(f"cannot write {path}: {e}");
        }
    }
    Ok(())
}

fn reverse(s: Str) -> String {
    let b = to_bytes(s);
    let mut v: Vec[u8] = Vec.new();
    let mut i = b.len() - 1;
    while i >= 0 {
        v.push(b[i]);
        i -= 1;
    }
    from_bytes(v)
}

// The directories and empty programs pwck looks for in each root.
fn build_roots() -> Result[(), String] {
    for r in ["sys", "broken"] {
        for line in read_lines(f"data/{r}/layout.txt") {
            let w = split_on(line, b' ');
            let full = f"data/{r}/{w[1]}";
            if w[0] == "d" {
                if let Err(e) = fs.create_dir_all(full.clone()) {
                    return Err(f"cannot create {full}: {e}");
                }
            } else {
                let cut = full.len() - before(reverse(full), b'/').len() - 1;
                let dir = slice(full, 0, cut);
                if let Err(e) = fs.create_dir_all(dir.clone()) {
                    return Err(f"cannot create {dir}: {e}");
                }
                if let Err(e) = fs.write(full.clone(), "".to_string()) {
                    return Err(f"cannot write {full}: {e}");
                }
            }
        }
    }
    Ok(())
}

// ------------------------------------------------------------ the jobs

fn run_line(job: mut ref Job, line: Str) {
    let w = shell_words(line);
    let args: Vec[String] = w[1..].to_vec();
    if w[0] == "pwck" {
        pwck(mut job, args);
    } else if w[0] == "chage" {
        chage(mut job, args);
    } else if w[0] == "passwd" {
        passwd(mut job, args);
    } else if w[0] == "login" {
        login(mut job, args);
    } else if w[0] == "openssl" {
        openssl(mut job, args);
    } else if w[0] == "crypt" {
        job.out.push_str(f"{crypt(args[0], args[1])}\n");
    } else if w[0] == "htpasswd" {
        htpasswd(mut job, args);
    } else if w[0] == "cat" {
        job.out.push_str(fs.read_to_string(args[0].clone()).unwrap_or(String.new()));
    }
}

fn run() -> Result[(), String] {
    if fs.symlink_metadata("data".to_string()).is_ok() {
        if let Err(e) = fs.remove_dir_all("data".to_string()) {
            return Err(f"cannot remove data: {e}");
        }
    }
    write_data()?;
    build_roots()?;
    for line in read_lines("data/jobs.txt") {
        if line.len() == 0 or starts_with(line, "#") {
            continue;
        }
        let mut job = Job { out: String.new(), err: String.new(), status: 0 };
        run_line(mut job, line);
        let mut out = f"$ {line}\n";
        out.push_str(job.out);
        out.push_str(job.err);
        if job.status != 0 {
            out.push_str(f"[exit status {job.status}]\n");
        }
        println(out);
    }
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        println(f"error: {e}");
    }
}
