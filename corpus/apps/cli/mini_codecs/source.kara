// mini_codecs: Python 3.13's codecs machinery, ported from
// Lib/codecs.py, Lib/encodings/ and the C codecs in Objects/unicodeobject.c
// and Python/codecs.c: codecs.lookup (the C-side lowering, the
// encodings package's normalize_encoding and alias table, and the rule
// that only a codec module may answer), the codecs themselves (ascii,
// latin-1, utf-8, utf-8-sig, utf-16 and utf-32 with and without a byte
// order, unicode_escape, raw_unicode_escape, and the 8-bit charmap
// codecs cp1252, cp1251, iso8859-15, koi8-r, mac-roman, cp437 and
// cp850), every built-in error handler (strict, ignore, replace,
// backslashreplace, xmlcharrefreplace, namereplace, surrogateescape and
// surrogatepass), the error ranges and messages each codec reports, and
// the incremental decoders, with the buffering they do between pieces.
//
// Text is a Vec[i64] of code points, as a Python str is, so it can hold
// the lone surrogates surrogateescape and surrogatepass make; bytes are
// a Vec[i64] of values below 256. Nothing with a surrogate in it is
// printed except through repr.
//
// data/ holds the tables the port reads at startup (each codec module's
// name, the aliases, each charmap's decoding table and the character
// names namereplace uses), jobs.tsv, which calls the codecs, and the
// files for four programs: a converter from legacy code pages to UTF-8,
// a CSV upload reader that sniffs byte order marks and falls back from
// UTF-8 to cp1252, a log sanitiser that keeps undecodable bytes through
// surrogateescape, and a mojibake fixer. expected.out is the output of
// oracle.py, which runs the same jobs and programs through Python.

// ------------------------------------------------------------ text

fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn cp(s: Str) -> Vec[i64] {
    codepoints(s.bytes())
}

fn cps(s: ref String) -> Vec[i64] {
    codepoints(s.bytes())
}

// Text with no surrogates in it, as a String.
fn to_string(s: ref Vec[i64]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for c in s {
        if c < 0x80 {
            out.push(c as u8);
        } else if c < 0x800 {
            out.push((0xC0 | (c >> 6)) as u8);
            out.push((0x80 | (c & 0x3F)) as u8);
        } else if c < 0x10000 {
            out.push((0xE0 | (c >> 12)) as u8);
            out.push((0x80 | ((c >> 6) & 0x3F)) as u8);
            out.push((0x80 | (c & 0x3F)) as u8);
        } else {
            out.push((0xF0 | (c >> 18)) as u8);
            out.push((0x80 | ((c >> 12) & 0x3F)) as u8);
            out.push((0x80 | ((c >> 6) & 0x3F)) as u8);
            out.push((0x80 | (c & 0x3F)) as u8);
        }
    }
    String.from_utf8(out).unwrap()
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn push_all(out: mut ref Vec[i64], s: ref Vec[i64]) {
    for c in s {
        out.push(c);
    }
}

fn slice(s: ref Vec[i64], start: i64, end: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i]);
        i += 1;
    }
    out
}

fn same(a: ref Vec[i64], b: ref Vec[i64]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn starts_with(s: ref Vec[i64], p: ref Vec[i64]) -> bool {
    if p.len() > s.len() {
        return false;
    }
    for i in 0..p.len() {
        if s[i] != p[i] {
            return false;
        }
    }
    true
}

fn hex_n(c: i64, width: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = (width - 1) * 4;
    while shift >= 0 {
        out.push(digits[(c >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

fn hex_val(c: i64) -> i64 {
    if c >= 48 and c <= 57 {
        return c - 48;
    }
    if c >= 97 and c <= 102 {
        return c - 87;
    }
    if c >= 65 and c <= 70 {
        return c - 55;
    }
    -1
}

fn split_cp(s: ref Vec[i64], sep: i64) -> Vec[Vec[i64]] {
    let mut out: Vec[Vec[i64]] = Vec.new();
    let mut cur: Vec[i64] = Vec.new();
    for c in s {
        if c == sep {
            out.push(cur);
            cur = Vec.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn split_tabs(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == '\t' {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

// the lines of a file, without their \n, as Python's iteration gives
// them
fn text_lines(s: ref String) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == '\n' {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    if not cur.is_empty() {
        out.push(cur);
    }
    out
}

fn sort_strings(v: mut ref Vec[String]) {
    let mut i = 1;
    while i < v.len() {
        let mut j = i;
        while j > 0 and v[j] < v[j - 1] {
            let t = v[j].clone();
            v[j] = v[j - 1].clone();
            v[j - 1] = t;
            j -= 1;
        }
        i += 1;
    }
}

fn py_bool(b: bool) -> String {
    if b { "True".to_string() } else { "False".to_string() }
}

fn is_surrogate(c: i64) -> bool {
    c >= 0xD800 and c <= 0xDFFF
}

// ------------------------------------------------------------ reprs

// str.isprintable outside ASCII, for repr: controls, format characters,
// separators other than space, surrogates and private use are not.
fn is_printable(c: i64) -> bool {
    if c < 0x20 or (c >= 0x7F and c <= 0xA0) or c == 0xAD {
        return false;
    }
    if (c >= 0x600 and c <= 0x605) or c == 0x61C or c == 0x6DD or c == 0x70F or c == 0x180E {
        return false;
    }
    if c == 0x1680 or (c >= 0x2000 and c <= 0x200F) or (c >= 0x2028 and c <= 0x202F) {
        return false;
    }
    if (c >= 0x205F and c <= 0x206F) or c == 0x3000 or (c >= 0xD800 and c <= 0xF8FF) {
        return false;
    }
    if c == 0xFEFF or (c >= 0xFFF9 and c <= 0xFFFB) or c >= 0xF0000 {
        return false;
    }
    true
}

// repr() of a str
fn repr_of(s: ref Vec[i64]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for c in s {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    let mut out: Vec[i64] = Vec.new();
    out.push(quote);
    for c in s {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c == 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c < 0x7F or is_printable(c) {
            out.push(c);
        } else if c <= 0xFF {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else if c <= 0xFFFF {
            push_ascii(mut out, "\\u");
            push_ascii(mut out, hex_n(c, 4));
        } else {
            push_ascii(mut out, "\\U");
            push_ascii(mut out, hex_n(c, 8));
        }
    }
    out.push(quote);
    to_string(out)
}

fn pr(s: ref String) -> String {
    repr_of(cps(s))
}

// repr() of a bytes
fn bytes_repr(b: ref Vec[i64]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for c in b {
        if c == 39 {
            has_single = true;
        } else if c == 34 {
            has_double = true;
        }
    }
    let quote = if has_single and not has_double { 34 } else { 39 };
    let mut out: Vec[i64] = Vec.new();
    out.push(98);
    out.push(quote);
    for c in b {
        if c == quote or c == 92 {
            out.push(92);
            out.push(c);
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c >= 0x7F {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(c, 2));
        } else {
            out.push(c);
        }
    }
    out.push(quote);
    to_string(out)
}

// bytes.hex()
fn hex_of(b: ref Vec[i64]) -> String {
    let mut out = String.new();
    for c in b {
        out.push_str(hex_n(c, 2));
    }
    out
}

// How a codec message shows one character: always escaped.
fn char_esc(c: i64) -> String {
    if c < 0x100 {
        f"\\x{hex_n(c, 2)}"
    } else if c < 0x10000 {
        f"\\u{hex_n(c, 4)}"
    } else {
        f"\\U{hex_n(c, 8)}"
    }
}

// ------------------------------------------------------------ literals

// ast.literal_eval of a str or bytes literal: the prefix, the quotes and
// the escapes Python knows; \N{...} is not supported.
fn literal(s: ref String) -> Vec[i64] {
    let v = cps(s);
    let mut i = 0;
    let mut is_bytes = false;
    if v[0] == 98 {
        is_bytes = true;
        i = 1;
    }
    let quote = v[i];
    i += 1;
    let end = v.len() - 1;
    let mut out: Vec[i64] = Vec.new();
    while i < end {
        let c = v[i];
        if c != 92 {
            out.push(c);
            i += 1;
            continue;
        }
        let e = v[i + 1];
        i += 2;
        if e == 110 {
            out.push(10);
        } else if e == 116 {
            out.push(9);
        } else if e == 114 {
            out.push(13);
        } else if e == 97 {
            out.push(7);
        } else if e == 98 {
            out.push(8);
        } else if e == 102 {
            out.push(12);
        } else if e == 118 {
            out.push(11);
        } else if e >= 48 and e <= 55 {
            let mut x = e - 48;
            let mut k = 0;
            while k < 2 and i < end and v[i] >= 48 and v[i] <= 55 {
                x = x * 8 + v[i] - 48;
                i += 1;
                k += 1;
            }
            out.push(x);
        } else if e == 120 or (not is_bytes and (e == 117 or e == 85)) {
            let count = if e == 120 { 2 } else if e == 117 { 4 } else { 8 };
            let mut x = 0;
            for _ in 0..count {
                x = x * 16 + hex_val(v[i]);
                i += 1;
            }
            out.push(x);
        } else if e == 92 or e == 39 or e == 34 or e == 10 {
            if e != 10 {
                out.push(e);
            }
        } else {
            out.push(92);
            out.push(e);
        }
    }
    let _ = quote;
    out
}

// ------------------------------------------------------------ exceptions

// A Python exception: its type's name and str(e).
#[derive(Clone)]
struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: own String) -> Exc {
    Exc { kind: kind.to_string(), msg: msg }
}

fn fail(e: ref Exc) -> String {
    f"! {e.kind}: {e.msg}"
}

// str(UnicodeDecodeError(enc, input, start, end, reason))
fn decode_exc(enc: ref String, input: ref Vec[i64], start: i64, end: i64, reason: ref String) -> Exc {
    if end - start == 1 {
        return exc("UnicodeDecodeError", f"'{enc}' codec can't decode byte 0x{hex_n(input[start], 2)} in position {start}: {reason}");
    }
    exc("UnicodeDecodeError", f"'{enc}' codec can't decode bytes in position {start}-{end - 1}: {reason}")
}

// str(UnicodeEncodeError(enc, text, start, end, reason))
fn encode_exc(enc: ref String, text: ref Vec[i64], start: i64, end: i64, reason: ref String) -> Exc {
    if end - start == 1 {
        return exc("UnicodeEncodeError", f"'{enc}' codec can't encode character '{char_esc(text[start])}' in position {start}: {reason}");
    }
    exc("UnicodeEncodeError", f"'{enc}' codec can't encode characters in position {start}-{end - 1}: {reason}")
}

// ------------------------------------------------------------ tables

const K_ASCII: i64 = 0;
const K_LATIN1: i64 = 1;
const K_UTF8: i64 = 2;
const K_UTF8_SIG: i64 = 3;
const K_UTF16: i64 = 4;
const K_UTF32: i64 = 5;
const K_UNICODE_ESCAPE: i64 = 6;
const K_RAW_ESCAPE: i64 = 7;
const K_CHARMAP: i64 = 8;

// A CodecInfo: the module that registered it, its name, and how it
// works. order is the byte order of utf-16 and utf-32: 0 for the codec
// that reads or writes a BOM, -1 little-endian, 1 big-endian. map is the
// charmap's index in Tables.maps.
#[derive(Clone)]
struct Codec {
    module: String,
    name: String,
    kind: i64,
    order: i64,
    map: i64,
}

// An 8-bit codec's decoding table (-1 where a byte is undefined) and the
// encoding table charmap_build makes from it.
struct CharMap {
    module: String,
    decode: Vec[i64],
    encode: Vec[(i64, i64)],
}

struct Tables {
    codecs: Vec[Codec],
    aliases: Vec[(String, String)],
    maps: Vec[CharMap],
    names: Vec[(i64, String)],
}

fn read_text(rel: ref String) -> Result[String, Exc] {
    match fs.read_to_string(f"data/{rel}") {
        Ok(s) => Ok(s),
        Err(_) => Err(exc("FileNotFoundError", f"[Errno 2] No such file or directory: {pr(f"data/{rel}")}")),
    }
}

fn kind_of(module: ref String) -> (i64, i64) {
    if module == "ascii" {
        (K_ASCII, 0)
    } else if module == "latin_1" {
        (K_LATIN1, 0)
    } else if module == "utf_8" {
        (K_UTF8, 0)
    } else if module == "utf_8_sig" {
        (K_UTF8_SIG, 0)
    } else if module == "utf_16" {
        (K_UTF16, 0)
    } else if module == "utf_16_le" {
        (K_UTF16, -1)
    } else if module == "utf_16_be" {
        (K_UTF16, 1)
    } else if module == "utf_32" {
        (K_UTF32, 0)
    } else if module == "utf_32_le" {
        (K_UTF32, -1)
    } else if module == "utf_32_be" {
        (K_UTF32, 1)
    } else if module == "unicode_escape" {
        (K_UNICODE_ESCAPE, 0)
    } else if module == "raw_unicode_escape" {
        (K_RAW_ESCAPE, 0)
    } else {
        (K_CHARMAP, 0)
    }
}

fn parse_hex(s: ref String) -> i64 {
    let mut x = 0;
    for b in s.bytes() {
        x = x * 16 + hex_val(b as i64);
    }
    x
}

fn load_tables() -> Result[Tables, Exc] {
    let mut maps: Vec[CharMap] = Vec.new();
    for line in text_lines(read_text("charmaps.txt".to_string())?) {
        let f = split_tabs(line);
        let mut decode: Vec[i64] = Vec.new();
        let mut encode: Vec[(i64, i64)] = Vec.new();
        let mut b = 0;
        for h in f[1].split(" ") {
            if h == "-" {
                decode.push(-1);
            } else {
                let c = parse_hex(h.to_string());
                decode.push(c);
                encode.push((c, b));
            }
            b += 1;
        }
        maps.push(CharMap { module: f[0].clone(), decode: decode, encode: encode });
    }
    let mut codecs: Vec[Codec] = Vec.new();
    for line in text_lines(read_text("codecs.txt".to_string())?) {
        let f = split_tabs(line);
        let (kind, order) = kind_of(f[0]);
        let mut map = -1;
        for i in 0..maps.len() {
            if maps[i].module == f[0] {
                map = i;
            }
        }
        codecs.push(Codec { module: f[0].clone(), name: f[1].clone(), kind: kind, order: order, map: map });
    }
    let mut aliases: Vec[(String, String)] = Vec.new();
    for line in text_lines(read_text("aliases.txt".to_string())?) {
        let f = split_tabs(line);
        aliases.push((f[0].clone(), f[1].clone()));
    }
    let mut names: Vec[(i64, String)] = Vec.new();
    for line in text_lines(read_text("names.txt".to_string())?) {
        let f = split_tabs(line);
        names.push((parse_hex(f[0]), f[1].clone()));
    }
    Ok(Tables { codecs: codecs, aliases: aliases, maps: maps, names: names })
}

// ------------------------------------------------------------ lookup

// encodings.normalize_encoding: runs of characters that are neither
// alphanumeric nor '.' become one '_', dropped at either end; letters
// outside ASCII are dropped without breaking a run. (Any character
// outside ASCII counts as alphanumeric here.)
fn normalize_encoding(name: ref Vec[i64]) -> String {
    let mut out = String.new();
    let mut punct = false;
    for c in name {
        let alnum = (c >= 48 and c <= 57) or (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 46 or c >= 0x80;
        if alnum {
            if punct and not out.is_empty() {
                out.push('_');
            }
            if c < 0x80 {
                out.push(c as u8 as char);
            }
            punct = false;
        } else {
            punct = true;
        }
    }
    out
}

fn alias_of(t: ref Tables, name: ref String) -> Option[String] {
    for (a, m) in t.aliases.iter() {
        if a == name {
            return Some(m.clone());
        }
    }
    None
}

fn module_codec(t: ref Tables, module: ref String) -> Option[Codec] {
    for c in t.codecs.iter() {
        if c.module == *module {
            return Some(c.clone());
        }
    }
    None
}

// codecs.lookup: the C side lowers ASCII letters, then the encodings
// package's search function tries the alias of the normalized name (and
// of that name with '.' made '_'), then the name itself, as a module of
// the encodings package. A name with a '.' in it is never imported.
fn lookup(t: ref Tables, name: ref String) -> Result[Codec, Exc] {
    let mut lowered: Vec[i64] = Vec.new();
    for c in cps(name) {
        if c >= 65 and c <= 90 {
            lowered.push(c + 32);
        } else {
            lowered.push(c);
        }
    }
    let norm = normalize_encoding(lowered);
    let mut aliased = alias_of(t, norm);
    if aliased.is_none() {
        aliased = alias_of(t, norm.replace(".", "_"));
    }
    let mut modnames: Vec[String] = Vec.new();
    if let Some(a) = aliased {
        modnames.push(a);
    }
    modnames.push(norm);
    for m in modnames.iter() {
        if m.is_empty() or m.contains(".") {
            continue;
        }
        if let Some(c) = module_codec(t, m) {
            return Ok(c);
        }
    }
    Err(exc("LookupError", f"unknown encoding: {name}"))
}

fn charmap_encode_char(m: ref CharMap, c: i64) -> i64 {
    for (u, b) in m.encode.iter() {
        if u == c {
            return b;
        }
    }
    -1
}

fn name_of(t: ref Tables, c: i64) -> Option[String] {
    for (u, n) in t.names.iter() {
        if u == c {
            return Some(n.clone());
        }
    }
    None
}

// ------------------------------------------------------------ error handlers

fn unknown_handler(h: ref String) -> Exc {
    exc("LookupError", f"unknown error handler name {pr(h)}")
}

// get_standard_encoding in Python/codecs.c: which UTF surrogatepass
// knows the codec as, and how many bytes a code unit takes. 0 for a
// codec it does not know.
fn standard_encoding(enc: ref String) -> (i64, i64) {
    if enc == "utf-8" {
        (8, 3)
    } else if enc == "utf-16-le" or enc == "utf-16" {
        (-16, 2)
    } else if enc == "utf-16-be" {
        (16, 2)
    } else if enc == "utf-32-le" or enc == "utf-32" {
        (-32, 4)
    } else if enc == "utf-32-be" {
        (32, 4)
    } else {
        (0, 0)
    }
}

// The decoding error handler `h`, for input[start..end): it adds the
// replacement to out and gives the position to go on from.
fn decode_error(h: ref String, enc: ref String, input: ref Vec[i64], start: i64, end: i64, reason: Str,
                out: mut ref Vec[i64]) -> Result[i64, Exc] {
    let why = reason.to_string();
    if h == "strict" {
        return Err(decode_exc(enc, input, start, end, why));
    }
    if h == "ignore" {
        return Ok(end);
    }
    if h == "replace" {
        out.push(0xFFFD);
        return Ok(end);
    }
    if h == "backslashreplace" {
        for i in start..end {
            push_ascii(mut out, "\\x");
            push_ascii(mut out, hex_n(input[i], 2));
        }
        return Ok(end);
    }
    if h == "surrogateescape" {
        // up to four bytes, but never an ASCII one
        let mut k = 0;
        while k < 4 and start + k < end and input[start + k] >= 128 {
            out.push(0xDC00 + input[start + k]);
            k += 1;
        }
        if k == 0 {
            return Err(decode_exc(enc, input, start, end, why));
        }
        return Ok(start + k);
    }
    if h == "surrogatepass" {
        let (code, width) = standard_encoding(enc);
        if code == 0 or input.len() - start < width {
            return Err(decode_exc(enc, input, start, end, why));
        }
        let b0 = input[start];
        let mut c = -1;
        if code == 8 {
            let b1 = input[start + 1];
            let b2 = input[start + 2];
            if (b0 & 0xF0) == 0xE0 and (b1 & 0xC0) == 0x80 and (b2 & 0xC0) == 0x80 {
                c = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F);
            }
        } else if code == -16 {
            c = b0 | (input[start + 1] << 8);
        } else if code == 16 {
            c = (b0 << 8) | input[start + 1];
        } else if code == -32 {
            c = b0 | (input[start + 1] << 8) | (input[start + 2] << 16) | (input[start + 3] << 24);
        } else {
            c = (b0 << 24) | (input[start + 1] << 16) | (input[start + 2] << 8) | input[start + 3];
        }
        if not is_surrogate(c) {
            return Err(decode_exc(enc, input, start, end, why));
        }
        out.push(c);
        return Ok(start + width);
    }
    if h == "xmlcharrefreplace" or h == "namereplace" {
        return Err(exc("TypeError", "don't know how to handle UnicodeDecodeError in error callback".to_string()));
    }
    Err(unknown_handler(h))
}

// What an encoding error handler gives back: text the codec encodes in
// its place (always ASCII here), or bytes it takes as they are.
struct Rep {
    is_bytes: bool,
    data: Vec[i64],
    resume: i64,
}

fn push_backslash(out: mut ref Vec[i64], c: i64) {
    if c < 0x100 {
        push_ascii(mut out, "\\x");
        push_ascii(mut out, hex_n(c, 2));
    } else if c < 0x10000 {
        push_ascii(mut out, "\\u");
        push_ascii(mut out, hex_n(c, 4));
    } else {
        push_ascii(mut out, "\\U");
        push_ascii(mut out, hex_n(c, 8));
    }
}

// The encoding error handler `h`, for text[start..end). `narrow` is set
// by the codecs whose C fast path for surrogateescape writes the good
// characters itself and hands the handler only what is left, from the
// first character it cannot escape.
fn encode_error(t: ref Tables, h: ref String, enc: ref String, text: ref Vec[i64], start: i64, end: i64,
                reason: Str, narrow: bool) -> Result[Rep, Exc] {
    let why = reason.to_string();
    let mut data: Vec[i64] = Vec.new();
    if h == "strict" {
        return Err(encode_exc(enc, text, start, end, why));
    }
    if h == "ignore" {
        return Ok(Rep { is_bytes: false, data: data, resume: end });
    }
    if h == "replace" {
        for _ in start..end {
            data.push(63);
        }
        return Ok(Rep { is_bytes: false, data: data, resume: end });
    }
    if h == "backslashreplace" {
        for i in start..end {
            push_backslash(mut data, text[i]);
        }
        return Ok(Rep { is_bytes: false, data: data, resume: end });
    }
    if h == "xmlcharrefreplace" {
        for i in start..end {
            push_ascii(mut data, f"&#{text[i]};");
        }
        return Ok(Rep { is_bytes: false, data: data, resume: end });
    }
    if h == "namereplace" {
        for i in start..end {
            match name_of(t, text[i]) {
                Some(n) => {
                    push_ascii(mut data, "\\N{");
                    push_ascii(mut data, n);
                    push_ascii(mut data, "}");
                }
                None => push_backslash(mut data, text[i]),
            }
        }
        return Ok(Rep { is_bytes: false, data: data, resume: end });
    }
    if h == "surrogateescape" {
        for i in start..end {
            let c = text[i];
            if c < 0xDC80 or c > 0xDCFF {
                let from = if narrow { i } else { start };
                return Err(encode_exc(enc, text, from, end, why));
            }
            data.push(c - 0xDC00);
        }
        return Ok(Rep { is_bytes: true, data: data, resume: end });
    }
    if h == "surrogatepass" {
        let (code, _) = standard_encoding(enc);
        if code == 0 {
            return Err(encode_exc(enc, text, start, end, why));
        }
        for i in start..end {
            let c = text[i];
            if not is_surrogate(c) {
                return Err(encode_exc(enc, text, start, end, why));
            }
            if code == 8 {
                data.push(0xE0 | (c >> 12));
                data.push(0x80 | ((c >> 6) & 0x3F));
                data.push(0x80 | (c & 0x3F));
            } else if code == -16 {
                data.push(c & 0xFF);
                data.push(c >> 8);
            } else if code == 16 {
                data.push(c >> 8);
                data.push(c & 0xFF);
            } else if code == -32 {
                data.push(c & 0xFF);
                data.push((c >> 8) & 0xFF);
                data.push(0);
                data.push(0);
            } else {
                data.push(0);
                data.push(0);
                data.push((c >> 8) & 0xFF);
                data.push(c & 0xFF);
            }
        }
        return Ok(Rep { is_bytes: true, data: data, resume: end });
    }
    Err(unknown_handler(h))
}

// ------------------------------------------------------------ decoders

// A decoder's result: the text, how much of the input it used (less
// than all of it only when `at_end` is false and the input stops part
// way through a character), and the byte order a utf-16 or utf-32 BOM
// named.
struct Dec {
    out: Vec[i64],
    consumed: i64,
    order: i64,
}

fn done(out: own Vec[i64], consumed: i64, order: i64) -> Result[Dec, Exc] {
    Ok(Dec { out: out, consumed: consumed, order: order })
}

fn ascii_decode(h: ref String, input: ref Vec[i64], limit: i64) -> Result[Dec, Exc] {
    let enc = if limit == 128 { "ascii".to_string() } else { "latin-1".to_string() };
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < input.len() {
        let b = input[i];
        if b < limit {
            out.push(b);
            i += 1;
        } else {
            i = decode_error(h, enc, input, i, i + 1, "ordinal not in range(128)", mut out)?;
        }
    }
    done(out, input.len(), 0)
}

fn charmap_decode(t: ref Tables, h: ref String, input: ref Vec[i64], map: i64) -> Result[Dec, Exc] {
    let enc = "charmap".to_string();
    let m = t.maps[map].decode.clone();
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < input.len() {
        let c = m[input[i]];
        if c >= 0 {
            out.push(c);
            i += 1;
        } else {
            i = decode_error(h, enc, input, i, i + 1, "character maps to <undefined>", mut out)?;
        }
    }
    done(out, input.len(), 0)
}

// The UTF-8 decoder of unicodeobject.c. A sequence that cannot be
// completed is an error as long as the bytes after its first one: 1 for
// a bad start byte or a bad second byte, 2 for a bad third, 3 for a bad
// fourth. One cut off by the end of the input is "unexpected end of
// data", for all that is left, unless `at_end` is false.
fn utf8_decode(h: ref String, input: ref Vec[i64], at_end: bool) -> Result[Dec, Exc] {
    let enc = "utf-8".to_string();
    let n = input.len();
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        let b = input[i];
        if b < 0x80 {
            out.push(b);
            i += 1;
            continue;
        }
        let mut need = 0;
        let mut lo = 0x80;
        let mut hi = 0xBF;
        if b >= 0xC2 and b <= 0xDF {
            need = 1;
        } else if b >= 0xE0 and b <= 0xEF {
            need = 2;
            if b == 0xE0 {
                lo = 0xA0;
            }
            if b == 0xED {
                hi = 0x9F;
            }
        } else if b >= 0xF0 and b <= 0xF4 {
            need = 3;
            if b == 0xF0 {
                lo = 0x90;
            }
            if b == 0xF4 {
                hi = 0x8F;
            }
        }
        if need == 0 {
            i = decode_error(h, enc, input, i, i + 1, "invalid start byte", mut out)?;
            continue;
        }
        let mut k = 1;
        let mut bad = false;
        while k <= need {
            if i + k >= n {
                break;
            }
            let c = input[i + k];
            let low = if k == 1 { lo } else { 0x80 };
            let high = if k == 1 { hi } else { 0xBF };
            if c < low or c > high {
                bad = true;
                break;
            }
            k += 1;
        }
        if bad {
            i = decode_error(h, enc, input, i, i + k, "invalid continuation byte", mut out)?;
            continue;
        }
        if k <= need {
            if not at_end {
                return done(out, i, 0);
            }
            i = decode_error(h, enc, input, i, n, "unexpected end of data", mut out)?;
            continue;
        }
        let c = if need == 1 {
            ((b & 0x1F) << 6) | (input[i + 1] & 0x3F)
        } else if need == 2 {
            ((b & 0x0F) << 12) | ((input[i + 1] & 0x3F) << 6) | (input[i + 2] & 0x3F)
        } else {
            ((b & 0x07) << 18) | ((input[i + 1] & 0x3F) << 12) | ((input[i + 2] & 0x3F) << 6) | (input[i + 3] & 0x3F)
        };
        out.push(c);
        i += need + 1;
    }
    done(out, n, 0)
}

fn bom_utf8() -> Vec[i64] {
    vec![0xEF, 0xBB, 0xBF]
}

// utf_8_sig.decode: a whole BOM at the start goes, then UTF-8 decodes
// the rest, with positions counted from after the BOM.
fn utf8_sig_decode(h: ref String, input: ref Vec[i64], at_end: bool) -> Result[Dec, Exc] {
    if starts_with(input, bom_utf8()) {
        let d = utf8_decode(h, slice(input, 3, input.len()), at_end)?;
        return done(d.out, d.consumed + 3, 0);
    }
    utf8_decode(h, input, at_end)
}

fn unit16(input: ref Vec[i64], i: i64, order: i64) -> i64 {
    if order == 1 {
        (input[i] << 8) | input[i + 1]
    } else {
        input[i] | (input[i + 1] << 8)
    }
}

// The UTF-16 decoder. With order 0 a BOM at the start sets the byte
// order and is dropped; without one the order is the machine's
// (little-endian). The order found comes back in Dec.order, 0 if there
// was no BOM.
fn utf16_decode(h: ref String, input: ref Vec[i64], at_end: bool, order0: i64) -> Result[Dec, Exc] {
    let n = input.len();
    let mut order = order0;
    let mut i = 0;
    if order == 0 and n >= 2 {
        if input[0] == 0xFF and input[1] == 0xFE {
            order = -1;
            i = 2;
        } else if input[0] == 0xFE and input[1] == 0xFF {
            order = 1;
            i = 2;
        }
    }
    let eff = if order == 0 { -1 } else { order };
    let enc = if eff == 1 { "utf-16-be".to_string() } else { "utf-16-le".to_string() };
    let mut out: Vec[i64] = Vec.new();
    while i < n {
        if i + 1 >= n {
            if not at_end {
                return done(out, i, order);
            }
            i = decode_error(h, enc, input, i, n, "truncated data", mut out)?;
            continue;
        }
        let u = unit16(input, i, eff);
        if u < 0xD800 or u > 0xDFFF {
            out.push(u);
            i += 2;
            continue;
        }
        if u >= 0xDC00 {
            i = decode_error(h, enc, input, i, i + 2, "illegal encoding", mut out)?;
            continue;
        }
        if i + 3 >= n {
            if not at_end {
                return done(out, i, order);
            }
            i = decode_error(h, enc, input, i, n, "unexpected end of data", mut out)?;
            continue;
        }
        let u2 = unit16(input, i + 2, eff);
        if u2 >= 0xDC00 and u2 <= 0xDFFF {
            out.push(0x10000 + ((u - 0xD800) << 10) + (u2 - 0xDC00));
            i += 4;
        } else {
            i = decode_error(h, enc, input, i, i + 2, "illegal UTF-16 surrogate", mut out)?;
        }
    }
    done(out, n, order)
}

// The UTF-32 decoder, with BOMs as utf16_decode has them.
fn utf32_decode(h: ref String, input: ref Vec[i64], at_end: bool, order0: i64) -> Result[Dec, Exc] {
    let n = input.len();
    let mut order = order0;
    let mut i = 0;
    if order == 0 and n >= 4 {
        if input[0] == 0xFF and input[1] == 0xFE and input[2] == 0 and input[3] == 0 {
            order = -1;
            i = 4;
        } else if input[0] == 0 and input[1] == 0 and input[2] == 0xFE and input[3] == 0xFF {
            order = 1;
            i = 4;
        }
    }
    let eff = if order == 0 { -1 } else { order };
    let enc = if eff == 1 { "utf-32-be".to_string() } else { "utf-32-le".to_string() };
    let mut out: Vec[i64] = Vec.new();
    while i < n {
        if i + 3 >= n {
            if not at_end {
                return done(out, i, order);
            }
            i = decode_error(h, enc, input, i, n, "truncated data", mut out)?;
            continue;
        }
        let c = if eff == 1 {
            (input[i] << 24) | (input[i + 1] << 16) | (input[i + 2] << 8) | input[i + 3]
        } else {
            input[i] | (input[i + 1] << 8) | (input[i + 2] << 16) | (input[i + 3] << 24)
        };
        if c > 0x10FFFF {
            i = decode_error(h, enc, input, i, i + 4, "code point not in range(0x110000)", mut out)?;
        } else if is_surrogate(c) {
            i = decode_error(h, enc, input, i, i + 4, "code point in surrogate code point range(0xd800, 0xe000)", mut out)?;
        } else {
            out.push(c);
            i += 4;
        }
    }
    done(out, n, order)
}

fn is_octal(c: i64) -> bool {
    c >= 48 and c <= 55
}

// \x, \u or \U and its hex digits, from input[i] on (the backslash is at
// start). Ok((code point or -1 on an error that was handled, new i)), or
// None when the input stops before the digits do and `at_end` is false.
fn hex_escape(h: ref String, enc: ref String, input: ref Vec[i64], start: i64, i0: i64, count: i64,
              msg: Str, at_end: bool, out: mut ref Vec[i64]) -> Result[Option[i64], Exc] {
    let mut i = i0;
    let mut x = 0;
    let mut k = 0;
    while k < count {
        if i >= input.len() {
            if not at_end {
                return Ok(None);
            }
            return Ok(Some(decode_error(h, enc, input, start, i, msg, mut out)?));
        }
        let d = hex_val(input[i]);
        if d < 0 {
            return Ok(Some(decode_error(h, enc, input, start, i, msg, mut out)?));
        }
        x = x * 16 + d;
        i += 1;
        k += 1;
    }
    if x > 0x10FFFF {
        let why = if enc == "unicodeescape" { "illegal Unicode character" } else { "\\Uxxxxxxxx out of range" };
        return Ok(Some(decode_error(h, enc, input, start, i, why, mut out)?));
    }
    out.push(x);
    Ok(Some(i))
}

fn escape_count(c: i64) -> (i64, Str) {
    if c == 120 {
        (2, "truncated \\xXX escape")
    } else if c == 117 {
        (4, "truncated \\uXXXX escape")
    } else {
        (8, "truncated \\UXXXXXXXX escape")
    }
}

// unicode_escape: bytes other than a backslash are Latin-1 characters.
// An escape the input stops inside is kept for the next piece when
// `at_end` is false. An unknown escape keeps its backslash (Python warns
// about it); \N{...} is not supported.
fn unicode_escape_decode(h: ref String, input: ref Vec[i64], at_end: bool) -> Result[Dec, Exc] {
    let enc = "unicodeescape".to_string();
    let n = input.len();
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        let b = input[i];
        if b != 92 {
            out.push(b);
            i += 1;
            continue;
        }
        let start = i;
        i += 1;
        if i >= n {
            if not at_end {
                return done(out, start, 0);
            }
            i = decode_error(h, enc, input, start, n, "\\ at end of string", mut out)?;
            continue;
        }
        let c = input[i];
        i += 1;
        if c == 10 {
        } else if c == 92 or c == 39 or c == 34 {
            out.push(c);
        } else if c == 98 {
            out.push(8);
        } else if c == 102 {
            out.push(12);
        } else if c == 116 {
            out.push(9);
        } else if c == 110 {
            out.push(10);
        } else if c == 114 {
            out.push(13);
        } else if c == 118 {
            out.push(11);
        } else if c == 97 {
            out.push(7);
        } else if is_octal(c) {
            let mut x = c - 48;
            if i < n and is_octal(input[i]) {
                x = x * 8 + input[i] - 48;
                i += 1;
                if i < n and is_octal(input[i]) {
                    x = x * 8 + input[i] - 48;
                    i += 1;
                }
            }
            out.push(x);
        } else if c == 120 or c == 117 or c == 85 {
            let (count, msg) = escape_count(c);
            match hex_escape(h, enc, input, start, i, count, msg, at_end, mut out)? {
                Some(next) => i = next,
                None => return done(out, start, 0),
            }
        } else {
            out.push(92);
            out.push(c);
        }
    }
    done(out, n, 0)
}

// raw_unicode_escape: only \u and \U are escapes, and only after an odd
// number of backslashes.
fn raw_escape_decode(h: ref String, input: ref Vec[i64], at_end: bool) -> Result[Dec, Exc] {
    let enc = "rawunicodeescape".to_string();
    let n = input.len();
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        let b = input[i];
        if b != 92 {
            out.push(b);
            i += 1;
            continue;
        }
        let run_start = i;
        while i < n and input[i] == 92 {
            out.push(92);
            i += 1;
        }
        let odd = (i - run_start) % 2 == 1;
        if not odd {
            continue;
        }
        if i >= n {
            if not at_end {
                out.pop();
                return done(out, i - 1, 0);
            }
            continue;
        }
        let c = input[i];
        if c != 117 and c != 85 {
            continue;
        }
        out.pop();
        let start = i - 1;
        let (count, msg) = escape_count(c);
        match hex_escape(h, enc, input, start, i + 1, count, msg, at_end, mut out)? {
            Some(next) => i = next,
            None => return done(out, start, 0),
        }
    }
    done(out, n, 0)
}

// codec.decode(input, errors, at_end): the stateless decoder, or one
// step of the stateful one when `at_end` is false. order is the byte
// order a utf-16 or utf-32 decoder already knows.
fn decode_step(t: ref Tables, c: ref Codec, h: ref String, input: ref Vec[i64], at_end: bool,
               order: i64) -> Result[Dec, Exc] {
    if c.kind == K_ASCII {
        ascii_decode(h, input, 128)
    } else if c.kind == K_LATIN1 {
        ascii_decode(h, input, 256)
    } else if c.kind == K_UTF8 {
        utf8_decode(h, input, at_end)
    } else if c.kind == K_UTF8_SIG {
        utf8_sig_decode(h, input, at_end)
    } else if c.kind == K_UTF16 {
        utf16_decode(h, input, at_end, if c.order != 0 { c.order } else { order })
    } else if c.kind == K_UTF32 {
        utf32_decode(h, input, at_end, if c.order != 0 { c.order } else { order })
    } else if c.kind == K_UNICODE_ESCAPE {
        unicode_escape_decode(h, input, at_end)
    } else if c.kind == K_RAW_ESCAPE {
        raw_escape_decode(h, input, at_end)
    } else {
        charmap_decode(t, h, input, c.map)
    }
}

fn decode(t: ref Tables, c: ref Codec, h: ref String, input: ref Vec[i64]) -> Result[Vec[i64], Exc] {
    Ok(decode_step(t, c, h, input, true, 0)?.out)
}

// ------------------------------------------------------------ encoders

fn push_utf8(out: mut ref Vec[i64], c: i64) {
    if c < 0x80 {
        out.push(c);
    } else if c < 0x800 {
        out.push(0xC0 | (c >> 6));
        out.push(0x80 | (c & 0x3F));
    } else if c < 0x10000 {
        out.push(0xE0 | (c >> 12));
        out.push(0x80 | ((c >> 6) & 0x3F));
        out.push(0x80 | (c & 0x3F));
    } else {
        out.push(0xF0 | (c >> 18));
        out.push(0x80 | ((c >> 12) & 0x3F));
        out.push(0x80 | ((c >> 6) & 0x3F));
        out.push(0x80 | (c & 0x3F));
    }
}

// A handler's replacement into the output: bytes as they are, text one
// byte a character (it is ASCII, which every codec here writes as one
// byte except utf-16 and utf-32, which encode their own).
fn push_rep(out: mut ref Vec[i64], rep: ref Rep) {
    for c in rep.data.iter() {
        out.push(*c);
    }
}

// ascii and latin-1: the characters at or above `limit` that come
// together go to the handler as one range.
fn ascii_encode(t: ref Tables, h: ref String, text: ref Vec[i64], limit: i64) -> Result[Vec[i64], Exc] {
    let enc = if limit == 128 { "ascii".to_string() } else { "latin-1".to_string() };
    let reason = if limit == 128 { "ordinal not in range(128)" } else { "ordinal not in range(256)" };
    let n = text.len();
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        if text[i] < limit {
            out.push(text[i]);
            i += 1;
            continue;
        }
        let mut end = i;
        while end < n and text[end] >= limit {
            end += 1;
        }
        let rep = encode_error(t, h, enc, text, i, end, reason, true)?;
        push_rep(mut out, rep);
        i = rep.resume;
    }
    Ok(out)
}

// UTF-8: a run of surrogates goes to the handler as one range.
fn utf8_encode(t: ref Tables, h: ref String, text: ref Vec[i64]) -> Result[Vec[i64], Exc] {
    let enc = "utf-8".to_string();
    let n = text.len();
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        if not is_surrogate(text[i]) {
            push_utf8(mut out, text[i]);
            i += 1;
            continue;
        }
        let mut end = i;
        while end < n and is_surrogate(text[end]) {
            end += 1;
        }
        let rep = encode_error(t, h, enc, text, i, end, "surrogates not allowed", true)?;
        push_rep(mut out, rep);
        i = rep.resume;
    }
    Ok(out)
}

fn push_unit(out: mut ref Vec[i64], u: i64, width: i64, order: i64) {
    if width == 2 {
        if order == 1 {
            out.push(u >> 8);
            out.push(u & 0xFF);
        } else {
            out.push(u & 0xFF);
            out.push(u >> 8);
        }
    } else if order == 1 {
        out.push((u >> 24) & 0xFF);
        out.push((u >> 16) & 0xFF);
        out.push((u >> 8) & 0xFF);
        out.push(u & 0xFF);
    } else {
        out.push(u & 0xFF);
        out.push((u >> 8) & 0xFF);
        out.push((u >> 16) & 0xFF);
        out.push((u >> 24) & 0xFF);
    }
}

// UTF-16 (width 2) and UTF-32 (width 4). Order 0 writes a BOM and then
// the machine's order (little-endian). Each surrogate goes to the
// handler by itself; replacement text is encoded a code unit a
// character.
fn utf16_32_encode(t: ref Tables, h: ref String, text: ref Vec[i64], width: i64, order: i64) -> Result[Vec[i64], Exc] {
    let bits = if width == 2 { "16" } else { "32" };
    let enc = if order == -1 { f"utf-{bits}-le" } else if order == 1 { f"utf-{bits}-be" } else { f"utf-{bits}" };
    let eff = if order == 0 { -1 } else { order };
    let mut out: Vec[i64] = Vec.new();
    if order == 0 {
        push_unit(mut out, 0xFEFF, width, eff);
    }
    let mut i = 0;
    while i < text.len() {
        let c = text[i];
        if not is_surrogate(c) {
            if width == 2 and c >= 0x10000 {
                push_unit(mut out, 0xD800 + ((c - 0x10000) >> 10), 2, eff);
                push_unit(mut out, 0xDC00 + ((c - 0x10000) & 0x3FF), 2, eff);
            } else {
                push_unit(mut out, c, width, eff);
            }
            i += 1;
            continue;
        }
        let rep = encode_error(t, h, enc, text, i, i + 1, "surrogates not allowed", false)?;
        if rep.is_bytes {
            push_rep(mut out, rep);
        } else {
            for r in rep.data.iter() {
                push_unit(mut out, *r, width, eff);
            }
        }
        i = rep.resume;
    }
    Ok(out)
}

// An 8-bit codec: the characters its table cannot write that come
// together go to the handler as one range.
fn charmap_encode(t: ref Tables, h: ref String, text: ref Vec[i64], map: i64) -> Result[Vec[i64], Exc] {
    let enc = "charmap".to_string();
    let m = ref t.maps[map];
    let n = text.len();
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < n {
        let b = charmap_encode_char(m, text[i]);
        if b >= 0 {
            out.push(b);
            i += 1;
            continue;
        }
        let mut end = i;
        while end < n and charmap_encode_char(m, text[end]) < 0 {
            end += 1;
        }
        let rep = encode_error(t, h, enc, text, i, end, "character maps to <undefined>", false)?;
        if rep.is_bytes {
            push_rep(mut out, rep);
        } else {
            for r in rep.data.iter() {
                out.push(charmap_encode_char(m, *r));
            }
        }
        i = rep.resume;
    }
    Ok(out)
}

// unicode_escape writes ASCII: printable ASCII as it is, a backslash
// doubled, \t \n \r, then \x, \u or \U by size. raw_unicode_escape
// writes everything below U+0100 as one byte and escapes the rest.
fn escape_encode(text: ref Vec[i64], raw: bool) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in text {
        if raw {
            if c < 0x100 {
                out.push(c);
            } else {
                push_backslash(mut out, c);
            }
        } else if c == 92 {
            push_ascii(mut out, "\\\\");
        } else if c == 9 {
            push_ascii(mut out, "\\t");
        } else if c == 10 {
            push_ascii(mut out, "\\n");
        } else if c == 13 {
            push_ascii(mut out, "\\r");
        } else if c < 0x20 or c >= 0x7F {
            push_backslash(mut out, c);
        } else {
            out.push(c);
        }
    }
    out
}

fn encode(t: ref Tables, c: ref Codec, h: ref String, text: ref Vec[i64]) -> Result[Vec[i64], Exc] {
    if c.kind == K_ASCII {
        ascii_encode(t, h, text, 128)
    } else if c.kind == K_LATIN1 {
        ascii_encode(t, h, text, 256)
    } else if c.kind == K_UTF8 {
        utf8_encode(t, h, text)
    } else if c.kind == K_UTF8_SIG {
        let mut out = bom_utf8();
        push_all(mut out, utf8_encode(t, h, text)?);
        Ok(out)
    } else if c.kind == K_UTF16 {
        utf16_32_encode(t, h, text, 2, c.order)
    } else if c.kind == K_UTF32 {
        utf16_32_encode(t, h, text, 4, c.order)
    } else if c.kind == K_UNICODE_ESCAPE {
        Ok(escape_encode(text, false))
    } else if c.kind == K_RAW_ESCAPE {
        Ok(escape_encode(text, true))
    } else {
        charmap_encode(t, h, text, c.map)
    }
}

// ------------------------------------------------------------ incremental decoders

// codecs.getincrementaldecoder(name)(errors). The codecs built on
// BufferedIncrementalDecoder keep what a piece leaves undecoded and put
// it in front of the next one; the others decode each piece by itself.
// utf-16 and utf-32 learn their byte order from the first piece that
// has a BOM, and a stream that starts with anything else is an error;
// utf-8-sig waits until it has seen three bytes, or fewer that cannot
// be a BOM.
struct IncDec {
    codec: Codec,
    errors: String,
    buffer: Vec[i64],
    order: i64,
    first: bool,
}

fn new_decoder(c: ref Codec, errors: ref String) -> IncDec {
    IncDec { codec: c.clone(), errors: errors.clone(), buffer: Vec.new(), order: c.order, first: true }
}

fn is_buffered(c: ref Codec) -> bool {
    c.kind == K_UTF8 or c.kind == K_UTF8_SIG or c.kind == K_UTF16 or c.kind == K_UTF32 or c.kind == K_UNICODE_ESCAPE or c.kind == K_RAW_ESCAPE
}

fn feed(t: ref Tables, d: mut ref IncDec, input: ref Vec[i64], at_end: bool) -> Result[Vec[i64], Exc] {
    if not is_buffered(d.codec) {
        return decode(t, d.codec, d.errors, input);
    }
    let mut data = d.buffer.clone();
    push_all(mut data, input);
    let h = d.errors.clone();
    let k = d.codec.kind;
    let mut r = Dec { out: Vec.new(), consumed: 0, order: 0 };
    if k == K_UTF8_SIG and d.first {
        let bom = bom_utf8();
        if data.len() < 3 {
            if starts_with(bom, data) {
                d.buffer = data;
                return Ok(Vec.new());
            }
            d.first = false;
            r = utf8_decode(h, data, at_end)?;
        } else {
            d.first = false;
            r = utf8_sig_decode(h, data, at_end)?;
        }
    } else if k == K_UTF8_SIG {
        r = utf8_decode(h, data, at_end)?;
    } else if (k == K_UTF16 or k == K_UTF32) and d.order == 0 {
        let width = if k == K_UTF16 { 2 } else { 4 };
        r = if k == K_UTF16 { utf16_decode(h, data, at_end, 0)? } else { utf32_decode(h, data, at_end, 0)? };
        if r.order == 0 and r.consumed >= width {
            let enc = if k == K_UTF16 { "utf-16".to_string() } else { "utf-32".to_string() };
            return Err(decode_exc(enc, data, 0, width, "Stream does not start with BOM".to_string()));
        }
        d.order = r.order;
    } else {
        r = decode_step(t, d.codec, h, data, at_end, d.order)?;
    }
    d.buffer = slice(data, r.consumed, data.len());
    Ok(r.out)
}

// ------------------------------------------------------------ jobs

fn show_result(r: ref Result[String, Exc]) -> String {
    match r {
        Ok(s) => s.clone(),
        Err(e) => fail(e),
    }
}

fn do_decode(t: ref Tables, enc: ref String, h: ref String, input: ref Vec[i64]) -> Result[Vec[i64], Exc] {
    let c = lookup(t, enc)?;
    decode(t, c, h, input)
}

fn do_encode(t: ref Tables, enc: ref String, h: ref String, text: ref Vec[i64]) -> Result[Vec[i64], Exc] {
    let c = lookup(t, enc)?;
    encode(t, c, h, text)
}

fn run_feed(t: ref Tables, f: ref Vec[String]) {
    println(f"feed {f[1]} {f[2]}");
    let c = match lookup(t, f[1]) {
        Ok(c) => c,
        Err(e) => {
            println(f"  {fail(e)}");
            return;
        }
    };
    let mut d = new_decoder(c, f[2]);
    let mut i = 3;
    while i < f.len() {
        let last = i == f.len() - 1;
        match feed(t, mut d, literal(f[i]), last) {
            Ok(out) => {
                let mark = if last { " final" } else { "" };
                println(f"  {f[i]}{mark} -> {repr_of(out)}");
            }
            Err(e) => {
                println(f"  {f[i]} -> {fail(e)}");
                return;
            }
        }
        i += 1;
    }
}

fn run_jobs(t: ref Tables) -> Result[(), Exc] {
    for line in text_lines(read_text("jobs.tsv".to_string())?) {
        let f = split_tabs(line);
        let op = f[0].clone();
        if op == "job" {
            println(f"== {f[1]}");
        } else if op == "lookup" {
            let r = match lookup(t, f[1]) {
                Ok(c) => Ok(pr(c.name)),
                Err(e) => Err(e),
            };
            println(f"lookup {pr(f[1])} -> {show_result(r)}");
        } else if op == "decode" {
            let r = match do_decode(t, f[1], f[2], literal(f[3])) {
                Ok(s) => Ok(repr_of(s)),
                Err(e) => Err(e),
            };
            println(f"decode {f[1]} {f[2]} {f[3]} -> {show_result(r)}");
        } else if op == "encode" {
            let r = match do_encode(t, f[1], f[2], literal(f[3])) {
                Ok(b) => Ok(bytes_repr(b)),
                Err(e) => Err(e),
            };
            println(f"encode {f[1]} {f[2]} {f[3]} -> {show_result(r)}");
        } else if op == "feed" {
            run_feed(t, f);
        }
    }
    Ok(())
}

// ------------------------------------------------------------ files

fn os_err(e: ref IoError, path: ref String) -> Exc {
    match e {
        IoError.NotFound => exc("FileNotFoundError", f"[Errno 2] No such file or directory: {pr(path)}"),
        IoError.PermissionDenied => exc("PermissionError", f"[Errno 13] Permission denied: {pr(path)}"),
        _ => exc("OSError", pr(path)),
    }
}

fn read_bytes(path: ref String) -> Result[Vec[i64], Exc] {
    match fs.read_bytes(path.clone()) {
        Ok(b) => {
            let mut out: Vec[i64] = Vec.new();
            for x in b.iter() {
                out.push(*x as i64);
            }
            Ok(out)
        }
        Err(e) => Err(os_err(e, path)),
    }
}

fn write_bytes(path: ref String, b: ref Vec[i64]) -> Result[(), Exc] {
    let mut raw: Vec[u8] = Vec.new();
    for x in b {
        raw.push(x as u8);
    }
    match fs.write_bytes(path.clone(), raw) {
        Ok(_) => Ok(()),
        Err(e) => Err(os_err(e, path)),
    }
}

fn utf8_text(b: ref Vec[i64]) -> Result[Vec[i64], Exc] {
    Ok(utf8_decode("strict".to_string(), b, true)?.out)
}

fn count_seq(s: ref Vec[i64], p: ref Vec[i64]) -> i64 {
    let mut n = 0;
    let mut i = 0;
    while i + p.len() <= s.len() {
        let mut ok = true;
        for k in 0..p.len() {
            if s[i + k] != p[k] {
                ok = false;
            }
        }
        if ok {
            n += 1;
            i += p.len();
        } else {
            i += 1;
        }
    }
    n
}

fn endings(b: ref Vec[i64]) -> String {
    let crlf = count_seq(b, vec![13, 10]);
    let cr = count_seq(b, vec![13]) - crlf;
    let lf = count_seq(b, vec![10]) - crlf;
    f"crlf={crlf} cr={cr} lf={lf}"
}

// ------------------------------------------------------------ programs

// Converts each file the manifest lists to UTF-8 with \n line endings,
// and flags text that looks like the wrong codec was named.
fn convert_legacy(t: ref Tables) -> Result[(), Exc] {
    println("== convert legacy files to utf-8");
    let strict = "strict".to_string();
    for line in text_lines(read_text("legacy/manifest.tsv".to_string())?) {
        let f = split_tabs(line);
        let name = f[0].clone();
        let enc = f[1].clone();
        println(f"{name} ({enc})");
        let info = match lookup(t, enc) {
            Ok(c) => c,
            Err(e) => {
                println(f"  {fail(e)}");
                continue;
            }
        };
        let raw = match read_bytes(f"data/legacy/{name}") {
            Ok(b) => b,
            Err(e) => {
                println(f"  {fail(e)}");
                continue;
            }
        };
        let text0 = match decode(t, info, strict, raw) {
            Ok(s) => s,
            Err(e) => {
                println(f"  {fail(e)}");
                continue;
            }
        };
        println(f"  codec {info.name}, {raw.len()} bytes, {endings(raw)}");
        // C1 controls, or three or more characters in a row from
        // U+00C0..U+00FF, usually mean the file is in another codec
        let mut c1 = 0;
        let mut best = 0;
        let mut run = 0;
        let mut start = 0;
        let mut at = 0;
        for i in 0..text0.len() {
            let c = text0[i];
            if c >= 0x80 and c < 0xA0 {
                c1 += 1;
            }
            if c >= 0xC0 and c <= 0xFF {
                if run == 0 {
                    start = i;
                }
                run += 1;
                if run > best {
                    best = run;
                    at = start;
                }
            } else {
                run = 0;
            }
        }
        if c1 > 0 or best >= 3 {
            println(f"  suspicious: {c1} C1 controls, longest run {repr_of(slice(text0, at, at + best))}");
        }
        let mut text: Vec[i64] = Vec.new();
        let mut i = 0;
        while i < text0.len() {
            if text0[i] == 13 {
                text.push(10);
                if i + 1 < text0.len() and text0[i + 1] == 10 {
                    i += 1;
                }
            } else {
                text.push(text0[i]);
            }
            i += 1;
        }
        let out = utf8_encode(t, strict, text)?;
        let dest = f"work/{name}";
        write_bytes(dest, out)?;
        let back = utf8_text(read_bytes(dest)?)?;
        let mut lines = 0;
        for c in text.iter() {
            if *c == 10 {
                lines += 1;
            }
        }
        println(f"  wrote {dest}: {out.len()} bytes, {lines} lines, same={py_bool(same(back, text))}");
        for part in split_cp(text, 10) {
            if not part.is_empty() {
                println(f"  | {repr_of(part)}");
            }
        }
        let again = encode(t, info, "replace".to_string(), text)?;
        println(f"  back to {info.name}: {again.len()} bytes");
    }
    Ok(())
}

// Reads CSV uploads of unknown encoding: a BOM names the codec, then
// UTF-8 is tried, then cp1252, then UTF-8 with replacement characters.
fn read_uploads(t: ref Tables) -> Result[(), Exc] {
    println("== read csv uploads");
    let boms: Vec[(Vec[i64], Str)] = vec![
        (vec![0xFF, 0xFE, 0, 0], "utf-32"),
        (vec![0, 0, 0xFE, 0xFF], "utf-32"),
        (vec![0xEF, 0xBB, 0xBF], "utf-8-sig"),
        (vec![0xFF, 0xFE], "utf-16"),
        (vec![0xFE, 0xFF], "utf-16"),
    ];
    let strict = "strict".to_string();
    let mut names = match fs.read_dir("data/uploads".to_string()) {
        Ok(v) => v,
        Err(e) => return Err(os_err(e, "data/uploads".to_string())),
    };
    sort_strings(mut names);
    for name in names.iter() {
        let raw = read_bytes(f"data/uploads/{name}")?;
        let mut enc = String.new();
        for (bom, codec) in boms.iter() {
            if starts_with(raw, bom) {
                enc = codec.to_string();
                println(f"{name}: {raw.len()} bytes, BOM {hex_of(bom)} -> {codec}");
                break;
            }
        }
        let text = if not enc.is_empty() {
            do_decode(t, enc, strict, raw)?
        } else {
            match do_decode(t, "utf-8".to_string(), strict, raw) {
                Ok(s) => {
                    println(f"{name}: {raw.len()} bytes, utf-8");
                    s
                }
                Err(e) => {
                    println(f"{name}: {raw.len()} bytes, not utf-8 ({e.msg})");
                    match do_decode(t, "cp1252".to_string(), strict, raw) {
                        Ok(s) => {
                            println("  fallback cp1252");
                            s
                        }
                        Err(e2) => {
                            println(f"  not cp1252 ({e2.msg})");
                            println("  fallback utf-8 with replacement");
                            do_decode(t, "utf-8".to_string(), "replace".to_string(), raw)?
                        }
                    }
                }
            }
        };
        for row in split_cp(text, 10) {
            if row.is_empty() {
                continue;
            }
            let mut cells: Vec[String] = Vec.new();
            for cell in split_cp(row, 44) {
                cells.push(repr_of(cell));
            }
            println(f"  {cells.join(" | ")}");
        }
    }
    Ok(())
}

// Keeps undecodable bytes in a log through surrogateescape, so that the
// line can be written back unchanged, and shows a safe view.
fn sanitise_log(t: ref Tables) -> Result[(), Exc] {
    println("== sanitise server.log");
    let raw = read_bytes("data/server.log".to_string())?;
    let mut n = 0;
    for line in split_cp(raw, 10) {
        n += 1;
        if line.is_empty() {
            continue;
        }
        let text = utf8_decode("surrogateescape".to_string(), line, true)?.out;
        let mut bad = 0;
        for c in text.iter() {
            if *c >= 0xDC80 and *c <= 0xDCFF {
                bad += 1;
            }
        }
        println(f"line {n}: {line.len()} bytes, {text.len()} chars, {bad} undecodable");
        println(f"  escaped  {repr_of(text)}");
        let shown = utf8_decode("backslashreplace".to_string(), line, true)?.out;
        println(f"  shown    {to_string(shown)}");
        let ascii = ascii_encode(t, "backslashreplace".to_string(), text, 128)?;
        println(f"  ascii    {to_string(ascii)}");
        match utf8_encode(t, "strict".to_string(), text) {
            Ok(_) => println("  strict encode ok"),
            Err(e) => println(f"  strict encode {fail(e)}"),
        }
        let back = utf8_encode(t, "surrogateescape".to_string(), text)?;
        println(f"  round trip {py_bool(same(back, line))}");
        let words = split_cp(text, 32);
        let mut user: Vec[i64] = Vec.new();
        let mut path: Vec[i64] = Vec.new();
        for w in 2..words.len() {
            let kv = words[w].clone();
            let mut eq = 0;
            while kv[eq] != 61 {
                eq += 1;
            }
            let key = to_string(slice(kv, 0, eq));
            let value = slice(kv, eq + 1, kv.len());
            if key == "user" {
                user = value;
            } else if key == "path" {
                path = value;
            }
        }
        println(f"  user={repr_of(user)} path={repr_of(path)}");
    }
    Ok(())
}

// Undoes UTF-8 that was read as cp1252.
fn fix_mojibake(t: ref Tables) -> Result[(), Exc] {
    println("== fix mojibake");
    let strict = "strict".to_string();
    let text = utf8_text(read_bytes("data/mojibake.txt".to_string())?)?;
    for line in split_cp(text, 10) {
        if line.is_empty() {
            continue;
        }
        println(repr_of(line));
        let fixed = match do_encode(t, "cp1252".to_string(), strict, line) {
            Ok(b) => do_decode(t, "utf-8".to_string(), strict, b),
            Err(e) => Err(e),
        };
        match fixed {
            Ok(s) => {
                if same(s, line) {
                    println("  unchanged");
                } else {
                    println(f"  fixed {repr_of(s)}");
                }
            }
            Err(e) => println(f"  cannot fix: {fail(e)}"),
        }
    }
    Ok(())
}

// ------------------------------------------------------------ main

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn unhex(s: ref String) -> Vec[i64] {
    let d = cps(s);
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i + 1 < d.len() {
        out.push(hex_val(d[i]) * 16 + hex_val(d[i + 1]));
        i += 2;
    }
    out
}

fn write_data() -> Result[(), Exc] {
    for dir in vec!["data/legacy", "data/uploads", "work"] {
        if let Err(e) = fs.create_dir_all(dir.to_string()) {
            return Err(os_err(e, dir.to_string()));
        }
    }
    for file in data_files() {
        let p = f"data/{file.path}";
        if file.hex {
            write_bytes(p, unhex(file.body))?;
        } else if let Err(e) = fs.write(p.clone(), file.body.clone()) {
            return Err(os_err(e, p));
        }
    }
    Ok(())
}

fn run() -> Result[(), Exc] {
    if fs.exists("work") {
        if let Err(e) = fs.remove_dir_all("work") {
            return Err(os_err(e, "work".to_string()));
        }
    }
    write_data()?;
    let t = load_tables()?;
    run_jobs(t)?;
    convert_legacy(t)?;
    read_uploads(t)?;
    sanitise_log(t)?;
    fix_mojibake(t)?;
    Ok(())
}

fn main() {
    if let Err(e) = run() {
        eprintln(fail(e));
    }
}

// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    data_part_2(mut v);
    v
}

fn data_part_0(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("1251\tcp1251\n");
    t.push_str("1252\tcp1252\n");
    t.push_str("437\tcp437\n");
    t.push_str("646\tascii\n");
    t.push_str("850\tcp850\n");
    t.push_str("8859\tlatin_1\n");
    t.push_str("ansi_x3.4_1968\tascii\n");
    t.push_str("ansi_x3.4_1986\tascii\n");
    t.push_str("ansi_x3_4_1968\tascii\n");
    t.push_str("cp367\tascii\n");
    t.push_str("cp65001\tutf_8\n");
    t.push_str("cp819\tlatin_1\n");
    t.push_str("csascii\tascii\n");
    t.push_str("csisolatin1\tlatin_1\n");
    t.push_str("cskoi8r\tkoi8_r\n");
    t.push_str("cspc850multilingual\tcp850\n");
    t.push_str("cspc8codepage437\tcp437\n");
    t.push_str("ibm367\tascii\n");
