== oauth1 escape
-- {"op": "escape", "s": "Ladies + Gentlemen"}
   'Ladies + Gentlemen' -> 'Ladies%20%2B%20Gentlemen' -> 'Ladies + Gentlemen'
-- {"op": "escape", "s": "An encoded string!"}
   'An encoded string!' -> 'An%20encoded%20string%21' -> 'An encoded string!'
-- {"op": "escape", "s": "Dogs, Cats & Mice"}
   'Dogs, Cats & Mice' -> 'Dogs%2C%20Cats%20%26%20Mice' -> 'Dogs, Cats & Mice'
-- {"op": "escape", "s": "☃"}
   '☃' -> '%E2%98%83' -> '☃'
-- {"op": "escape", "s": "-._~"}
   '-._~' -> '-._~' -> '-._~'
-- {"op": "escape", "s": "a/b?c=d#e"}
   'a/b?c=d#e' -> 'a%2Fb%3Fc%3Dd%23e' -> 'a/b?c=d#e'
-- {"op": "escape", "s": ""}
   '' -> '' -> ''
-- {"op": "escape", "s": "100%"}
   '100%' -> '100%25' -> '100%'
-- {"op": "escape", "s": "日本語 text"}
   '日本語 text' -> '%E6%97%A5%E6%9C%AC%E8%AA%9E%20text' -> '日本語 text'
-- {"op": "escape", "s": "oauth_token=x&y"}
   'oauth_token=x&y' -> 'oauth_token%3Dx%26y' -> 'oauth_token=x&y'
-- {"op": "unescape", "s": "%7E%2f%2F"}
   '%7E%2f%2F' -> '~//'
-- {"op": "unescape", "s": "a+b"}
   'a+b' -> 'a+b'
-- {"op": "unescape", "s": "%E2%98%83"}
   '%E2%98%83' -> '☃'
-- {"op": "unescape", "s": "%zz"}
   '%zz' -> '%zz'
-- {"op": "unescape", "s": "%"}
   '%' -> '%'
-- {"op": "unescape", "s": "caf%C3%A9"}
   'caf%C3%A9' -> 'café'
== oauth1 urldecode
-- {"op": "urldecode", "q": "a=1&b=2"}
   [('a', '1'), ('b', '2')]
-- {"op": "urldecode", "q": "c2&a3=2+q"}
   [('c2', ''), ('a3', '2 q')]
-- {"op": "urldecode", "q": "a=%20&b="}
   [('a', ' '), ('b', '')]
-- {"op": "urldecode", "q": "x=1;y=2"}
   [('x', '1;y=2')]
-- {"op": "urldecode", "q": "a=1&&b=2"}
   [('a', '1'), ('b', '2')]
-- {"op": "urldecode", "q": "name=caf%C3%A9"}
   [('name', 'café')]
-- {"op": "urldecode", "q": "q=hello world"}
   raised ValueError: Error trying to decode a non urlencoded string. Found invalid characters: {' '} in the string: 'q=hello world'. Please ensure the request/response body is x-www-form-urlencoded.
-- {"op": "urldecode", "q": "a=<b"}
   raised ValueError: Error trying to decode a non urlencoded string. Found invalid characters: {'<'} in the string: 'a=<b'. Please ensure the request/response body is x-www-form-urlencoded.
-- {"op": "urldecode", "q": "a=%zz"}
   raised ValueError: Invalid hex encoding in query string.
-- {"op": "urldecode", "q": "a=%4"}
   [('a', '%4')]
-- {"op": "urldecode", "q": "a=%4G"}
   raised ValueError: Invalid hex encoding in query string.
-- {"op": "urldecode", "q": "a=%"}
   [('a', '%')]
-- {"op": "urldecode", "q": ""}
   []
-- {"op": "urldecode", "q": "=v&k="}
   [('', 'v'), ('k', '')]
-- {"op": "urldecode", "q": "a=1&a=2"}
   [('a', '1'), ('a', '2')]
-- {"op": "urldecode", "q": "path=/x/y?z"}
   [('path', '/x/y?z')]
-- {"op": "urldecode", "q": "a=é"}
   raised ValueError: Error trying to decode a non urlencoded string. Found invalid characters: {'é'} in the string: 'a=é'. Please ensure the request/response body is x-www-form-urlencoded.
-- {"op": "urldecode", "q": "tilde=~&star=*"}
   [('tilde', '~'), ('star', '*')]
== oauth1 authorization header
-- {"op": "authheader", "h": "OAuth realm=\"Example\", oauth_consumer_key=\"9djdj82h48djs9d2\", oauth_token=\"kkk9d7dh3k39sjv7\""}
   [('realm', 'Example'), ('oauth_consumer_key', '9djdj82h48djs9d2'), ('oauth_token', 'kkk9d7dh3k39sjv7')]
-- {"op": "authheader", "h": "oauth oauth_nonce=\"7d8f3e4a\", oauth_version=\"1.0\""}
   [('oauth_nonce', '7d8f3e4a'), ('oauth_version', '1.0')]
-- {"op": "authheader", "h": "OAuth oauth_callback=\"http%3A%2F%2Fprinter.example.com%2Fready\""}
   [('oauth_callback', 'http%3A%2F%2Fprinter.example.com%2Fready')]
-- {"op": "authheader", "h": "OAuth a=\"1,2\", b=\"x\\\"y\""}
   [('a', '1,2'), ('b', 'x"y')]
-- {"op": "authheader", "h": "OAuth a=plain, b=\"quoted\""}
   [('a', 'plain'), ('b', 'quoted')]
-- {"op": "authheader", "h": "OAuth a=\"1\", a=\"2\""}
   [('a', '2')]
-- {"op": "authheader", "h": "OAuth a="}
   raised ValueError: Malformed authorization header
-- {"op": "authheader", "h": "OAuth novalue"}
   raised ValueError: Malformed authorization header
-- {"op": "authheader", "h": "Bearer abc"}
   raised ValueError: Malformed authorization header
-- {"op": "authheader", "h": "OAuth "}
   []
-- {"op": "authheader", "h": "OAuth a=\"1\",,b=\"2\""}
   raised ValueError: Malformed authorization header
-- {"op": "authheader", "h": "OAUTH x=\"y\""}
   [('x', 'y')]
== oauth1 base string URI
-- {"op": "bsuri", "uri": "http://EXAMPLE.COM:80/r%20v/X?id=123"}
   'http://example.com/r%20v/X'
-- {"op": "bsuri", "uri": "https://www.example.net:8080/?q=1"}
   'https://www.example.net:8080/'
-- {"op": "bsuri", "uri": "https://api.example.com:443/1/statuses"}
   'https://api.example.com/1/statuses'
-- {"op": "bsuri", "uri": "http://api.example.com:443/1/statuses"}
   'http://api.example.com:443/1/statuses'
-- {"op": "bsuri", "uri": "HTTPS://Example.com"}
   'https://example.com/'
-- {"op": "bsuri", "uri": "https://example.com/a b;p=1?x#frag"}
   'https://example.com/a%20b;p=1'
-- {"op": "bsuri", "uri": "http://[2001:DB8:0:0:0:0:0:1]:8000/v1"}
   'http://[2001:db8::1]:8000/v1'
-- {"op": "bsuri", "uri": "http://[::FFFF:0:0:1]/"}
   'http://[::ffff:0:0:1]/'
-- {"op": "bsuri", "uri": "http://[fe80:0:0:0:200:f8ff:fe21:67cf]:80/"}
   'http://[fe80::200:f8ff:fe21:67cf]/'
-- {"op": "bsuri", "uri": "http://192.168.000.001/x"}
   'http://192.168.000.001/x'
-- {"op": "bsuri", "uri": "http://10.0.0.1:0/x"}
   raised ValueError: port out of range
-- {"op": "bsuri", "uri": "http://example.com:99999/x"}
   raised ValueError: Port out of range 0-65535
-- {"op": "bsuri", "uri": "http://example.com:8x/x"}
   raised ValueError: Port could not be cast to integer value as '8x'
-- {"op": "bsuri", "uri": "/relative/path"}
   raised ValueError: missing scheme
-- {"op": "bsuri", "uri": "http:///nohost"}
   raised ValueError: missing host
-- {"op": "bsuri", "uri": "https://internal:8443/token", "host": "api.Example.com"}
   'https://api.example.com/token'
-- {"op": "bsuri", "uri": "https://internal:8443/token", "host": "api.example.com:9000"}
   'https://api.example.com:9000/token'
-- {"op": "bsuri", "uri": "http://internal/token", "host": "proxy.example.com:80"}
   'http://proxy.example.com/token'
-- {"op": "bsuri", "uri": "https://internal/token", "host": "[::1]:8443"}
   'https://[::1]:8443/token'
-- {"op": "bsuri", "uri": "mailto:someone@example.com"}
   raised ValueError: missing host
== oauth1 collect and normalize
-- {"op": "collect", "query": "b5=%3D%253D&a3=a&c%40=&a2=r%20b", "body": "c2&a3=2+q", "headers": {"Authorization": "OAuth realm=\"Example\", oauth_consumer_key=\"9djdj82h48djs9d2\", oauth_token=\"kkk9d7dh3k39sjv7\", oauth_signature_method=\"HMAC-SHA1\", oauth_timestamp=\"137131201\", oauth_nonce=\"7d8f3e4a\", oauth_signature=\"djosJKDKJSD8743243%2Fjdk33klY%3D\""}}
   [('b5', '=%3D'), ('a3', 'a'), ('c@', ''), ('a2', 'r b'), ('oauth_consumer_key', '9djdj82h48djs9d2'), ('oauth_token', 'kkk9d7dh3k39sjv7'), ('oauth_signature_method', 'HMAC-SHA1'), ('oauth_timestamp', '137131201'), ('oauth_nonce', '7d8f3e4a'), ('c2', ''), ('a3', '2 q')]
-- {"op": "collect", "query": "b5=%3D%253D&a3=a&c%40=&a2=r%20b", "body": "c2&a3=2+q", "headers": {"authorization": "OAuth realm=\"Example\", oauth_consumer_key=\"9djdj82h48djs9d2\", oauth_token=\"kkk9d7dh3k39sjv7\", oauth_signature_method=\"HMAC-SHA1\", oauth_timestamp=\"137131201\", oauth_nonce=\"7d8f3e4a\", oauth_signature=\"djosJKDKJSD8743243%2Fjdk33klY%3D\""}, "with_realm": true, "exclude_sig": false}
   [('b5', '=%3D'), ('a3', 'a'), ('c@', ''), ('a2', 'r b'), ('realm', 'Example'), ('oauth_consumer_key', '9djdj82h48djs9d2'), ('oauth_token', 'kkk9d7dh3k39sjv7'), ('oauth_signature_method', 'HMAC-SHA1'), ('oauth_timestamp', '137131201'), ('oauth_nonce', '7d8f3e4a'), ('oauth_signature', 'djosJKDKJSD8743243/jdk33klY='), ('c2', ''), ('a3', '2 q')]
-- {"op": "collect", "query": "", "body": [["a", "1"], ["oauth_x", "%41"]], "headers": {}}
   [('a', '1'), ('oauth_x', 'A')]
-- {"op": "collect", "query": "oauth_extra=%2541", "body": null, "headers": {"Content-Type": "text/plain"}}
   [('oauth_extra', 'A')]
-- {"op": "collect", "query": "", "body": "{\"json\": true}", "headers": {}}
   []
-- {"op": "collect", "query": "a=1", "body": "", "headers": {"Authorization": "Basic Zm9vOmJhcg=="}}
   raised ValueError: Malformed authorization header
-- {"op": "normalize", "params": [["b5", "=%3D"], ["a3", "a"], ["c@", ""], ["a2", "r b"], ["oauth_consumer_key", "9djdj82h48djs9d2"], ["oauth_token", "kkk9d7dh3k39sjv7"], ["oauth_signature_method", "HMAC-SHA1"], ["oauth_timestamp", "137131201"], ["oauth_nonce", "7d8f3e4a"], ["c2", ""], ["a3", "2 q"]]}
   'a2=r%20b&a3=2%20q&a3=a&b5=%3D%253D&c%40=&c2=&oauth_consumer_key=9djdj82h48djs9d2&oauth_nonce=7d8f3e4a&oauth_signature_method=HMAC-SHA1&oauth_timestamp=137131201&oauth_token=kkk9d7dh3k39sjv7'
-- {"op": "normalize", "params": [["z", "1"], ["a", "2"], ["a", "10"], ["A", "1"], ["é", "x"], ["a b", "~"]]}
   '%C3%A9=x&A=1&a=10&a=2&a%20b=~&z=1'
-- {"op": "normalize", "params": []}
   ''
-- {"op": "basestring", "method": "post", "uri": "http://example.com/request", "params": "a2=r%20b&a3=2%20q&a3=a&b5=%3D%253D&c%40=&c2=&oauth_consumer_key=9djdj82h48djs9d2"}
   'POST&http%3A%2F%2Fexample.com%2Frequest&a2%3Dr%2520b%26a3%3D2%2520q%26a3%3Da%26b5%3D%253D%25253D%26c%2540%3D%26c2%3D%26oauth_consumer_key%3D9djdj82h48djs9d2'
