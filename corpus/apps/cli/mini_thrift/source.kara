// mini_thrift: a port of Apache Thrift 0.21.0 (Apache-2.0; the Apache
// Software Foundation), the RPC framework and serialization format that
// Facebook-born services, Scribe log pipelines, HBase and Cassandra
// clients, and event logs written by a dozen languages share. This is its
// pure Python library: the binary, compact, JSON and simple JSON
// protocols, the memory, framed, buffered and file transports, the
// generic struct reader and writer every generated class calls, the
// multiplexed processor, and TApplicationException.
//
// The Python library never sees a .thrift file itself: the thrift
// compiler turns one into classes. Here data/app.thrift (the Thrift
// tutorial's Calculator service plus a shop's record types) is compiled
// the way `thrift --gen py:dynamic` would compile it, into classes with a
// thrift_spec, an argument and a result class per method, and the
// generated client and processor logic. data/jobs.tsv (see mk.py) then
// encodes and decodes those records in every protocol, decodes damaged
// and hand-built bytes, dumps records without a schema, writes and reads
// framed files, and makes calls to a Calculator server through a request
// and a response file. Four programs close it: an event log written in
// one protocol and summarised, read again with a newer schema, and a user
// table migrated from one schema and protocol to another and exported as
// JSON lines.
//
// Python is dynamic and so is the library: a struct field holds whatever
// value the caller put there, and the protocols fail on the wrong one the
// way struct.pack, bytes(), base64 and int() fail. Values are therefore
// Python values here (Val), and the error each protocol raises for each
// kind of value is the one Python raises.

// ------------------------------------------------------------ text helpers

fn hex_val(c: char) -> i64 {
    if c >= '0' and c <= '9' {
        c as i64 - 48
    } else if c >= 'a' and c <= 'f' {
        c as i64 - 87
    } else if c >= 'A' and c <= 'F' {
        c as i64 - 55
    } else {
        -1
    }
}

fn hex_bytes(s: ref String) -> Vec[u8] {
    let cs: Vec[char] = s.chars().collect();
    let mut bytes: Vec[u8] = Vec.new();
    let mut k = 0;
    while k + 1 < cs.len() {
        bytes.push((hex_val(cs[k]) * 16 + hex_val(cs[k + 1])) as u8);
        k += 2;
    }
    bytes
}

fn hex_string(s: ref String) -> String {
    match String.from_utf8(hex_bytes(s)) {
        Ok(t) => t,
        Err(_) => String.new(),
    }
}

fn split_on(s: ref String, sep: char) -> Vec[String] {
    let mut pieces: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            pieces.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    pieces.push(cur);
    pieces
}

fn join_strs(xs: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    let mut first = true;
    for x in xs {
        if not first {
            out.push_str(sep);
        }
        out.push_str(x);
        first = false;
    }
    out
}

fn atoi(s: ref String) -> i64 {
    match i64.parse(s.clone()) {
        Ok(n) => n,
        Err(_) => 0,
    }
}

fn chr(n: i64) -> char {
    match char.try_from(n) {
        Ok(c) => c,
        Err(_) => '?',
    }
}

const HEX: Str = "0123456789abcdef";

fn hex2(n: i64) -> String {
    let ds: Vec[char] = HEX.chars().collect();
    let mut out = String.new();
    out.push(ds[(n / 16) % 16]);
    out.push(ds[n % 16]);
    out
}

fn hexn(n: i64, width: i64) -> String {
    let ds: Vec[char] = HEX.chars().collect();
    let mut digits: Vec[char] = Vec.new();
    let mut m = n;
    while m > 0 {
        digits.push(ds[m % 16]);
        m = m / 16;
    }
    while digits.len() < width {
        digits.push('0');
    }
    let mut out = String.new();
    let mut i = digits.len() - 1;
    while i >= 0 {
        out.push(digits[i]);
        i -= 1;
    }
    out
}

fn pad_left(s: ref String, n: i64) -> String {
    let mut out = String.new();
    let mut k = s.chars().count();
    while k < n {
        out.push(' ');
        k += 1;
    }
    out.push_str(s);
    out
}

fn pad_right(s: ref String, n: i64) -> String {
    let mut out = s.clone();
    let mut k = s.chars().count();
    while k < n {
        out.push(' ');
        k += 1;
    }
    out
}

fn zpad(n: i64, w: i64) -> String {
    let s = f"{n}";
    let mut out = String.new();
    let mut k = s.len();
    while k < w {
        out.push('0');
        k += 1;
    }
    out.push_str(s);
    out
}


// Whether str.isprintable() holds: the controls, the C1 range, the spaces
// other than U+0020, the line and paragraph separators, the format
// characters and the private use area are not printable.
fn printable(n: i64) -> bool {
    if n < 32 or (n >= 127 and n <= 160) or n == 173 or n == 0x1680 {
        return false;
    }
    if (n >= 0x2000 and n <= 0x200F) or (n >= 0x2028 and n <= 0x202F) or (n >= 0x205F and n <= 0x2064) {
        return false;
    }
    if n == 0x3000 or n == 0xFEFF or (n >= 0xFFF9 and n <= 0xFFFB) {
        return false;
    }
    not (n >= 0xE000 and n <= 0xF8FF)
}

// repr() of a str.
fn str_repr(s: ref String) -> String {
    let q = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    let mut out = String.new();
    out.push(q);
    for c in s.chars() {
        let n = c as i64;
        if c == q or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if not printable(n) {
            if n < 256 {
                out.push_str("\\x");
                out.push_str(hex2(n));
            } else if n < 0x10000 {
                out.push_str("\\u");
                out.push_str(hexn(n, 4));
            } else {
                out.push_str("\\U");
                out.push_str(hexn(n, 8));
            }
        } else {
            out.push(c);
        }
    }
    out.push(q);
    out
}

fn sub(b: ref Vec[u8], from: i64, to: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut i = from;
    while i < to {
        out.push(b[i]);
        i += 1;
    }
    out
}

fn chars_str(cs: ref Vec[char], from: i64, to: i64) -> String {
    let mut out = String.new();
    let mut i = from;
    while i < to {
        out.push(cs[i]);
        i += 1;
    }
    out
}

// ------------------------------------------------------------ exceptions

// A Python exception: the class as the job output names it and str(e).
fn dirname_of(path: ref String) -> String {
    let cs: Vec[char] = path.chars().collect();
    let mut cut = 0;
    let mut i = 0;
    while i < cs.len() {
        if cs[i] == '/' {
            cut = i;
        }
        i += 1;
    }
    chars_str(cs, 0, cut)
}


fn hex_of(b: ref Vec[u8]) -> String {
    let mut out = String.new();
    for x in b {
        out.push_str(hex2(x as i64));
    }
    out
}

fn from_utf8_lossy(b: ref Vec[u8]) -> String {
    match String.from_utf8(b.clone()) {
        Ok(s) => s,
        Err(_) => String.new(),
    }
}

fn utf8_of(s: ref String) -> Vec[u8] {
    s.bytes().to_vec()
}

fn append(a: mut ref Vec[u8], b: ref Vec[u8]) {
    for x in b {
        a.push(x);
    }
}

fn starts_with(s: ref String, p: Str) -> bool {
    s.starts_with(p)
}

fn from_str(s: ref String, at: i64) -> String {
    let cs: Vec[char] = s.chars().collect();
    chars_str(cs, at, cs.len())
}

// bytes repr().
fn bytes_repr(b: ref Vec[u8]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for x in b {
        if x == b'\'' {
            has_single = true;
        }
        if x == b'"' {
            has_double = true;
        }
    }
    let q: u8 = if has_single and not has_double { b'"' } else { b'\'' };
    let mut out = String.new();
    out.push('b');
    out.push(chr(q as i64));
    for c in b {
        if c == q or c == b'\\' {
            out.push('\\');
            out.push(chr(c as i64));
        } else if c == b'\n' {
            out.push_str("\\n");
        } else if c == b'\r' {
            out.push_str("\\r");
        } else if c == b'\t' {
            out.push_str("\\t");
        } else if c < 32 or c >= 127 {
            out.push_str("\\x");
            out.push_str(hex2(c as i64));
        } else {
            out.push(chr(c as i64));
        }
    }
    out.push(chr(q as i64));
    out
}

// ------------------------------------------------------------ exceptions

// A Python exception: its class as err() names it (module and qualname,
// the module left out for builtins), str(e), and for the IDL's own
// exceptions the instance itself, which a processor sends back.
#[derive(Clone)]
struct Exc {
    cls: String,
    msg: String,
    obj: Val,
}

fn exc(cls: Str, msg: own String) -> Exc {
    Exc { cls: cls.to_string(), msg: msg, obj: Val.Non }
}

fn type_error(msg: own String) -> Exc {
    exc("TypeError", msg)
}

fn value_error(msg: own String) -> Exc {
    exc("ValueError", msg)
}

fn proto_error(msg: own String) -> Exc {
    exc("thrift.protocol.TProtocol.TProtocolException", msg)
}

fn transport_error(msg: own String) -> Exc {
    exc("thrift.transport.TTransport.TTransportException", msg)
}

fn struct_error(msg: own String) -> Exc {
    exc("struct.error", msg)
}

fn eof_error() -> Exc {
    exc("EOFError", String.new())
}

fn assertion(msg: own String) -> Exc {
    exc("AssertionError", msg)
}

fn not_found(path: ref String) -> Exc {
    exc("FileNotFoundError", f"[Errno 2] No such file or directory: {str_repr(path)}")
}

fn err_line(e: ref Exc) -> String {
    f"error {e.cls}: {e.msg}"
}

// ------------------------------------------------------------ Python values

// A Python value: the scalars, the containers and the generated struct
// instances (Obj: the class, then the slot values in IDL order). Set
// keeps its members in insertion order without duplicates, Dict its keys
// in insertion order, as dict does.
#[derive(Clone)]
enum Val {
    Non,
    Bool(bool),
    Int(i64),
    Float(f64),
    Str(String),
    Bytes(Vec[u8]),
    List(Vec[Val]),
    Set(Vec[Val]),
    Dict(Vec[Val], Vec[Val]),
    Obj(i64, Vec[Val]),
}

fn is_none(v: ref Val) -> bool {
    match v {
        Val.Non => true,
        _ => false,
    }
}

fn is_number(v: ref Val) -> bool {
    match v {
        Val.Bool(_) => true,
        Val.Int(_) => true,
        Val.Float(_) => true,
        _ => false,
    }
}

// The value of an int (a bool counts), or None.
fn int_of(v: ref Val) -> Option[i64] {
    match v {
        Val.Bool(b) => Some(if b { 1 } else { 0 }),
        Val.Int(n) => Some(n),
        _ => None,
    }
}

fn float_of(v: ref Val) -> f64 {
    match v {
        Val.Bool(b) => if b { 1.0 } else { 0.0 },
        Val.Int(n) => n as f64,
        Val.Float(x) => x,
        _ => 0.0,
    }
}

fn str_of(v: ref Val) -> String {
    match v {
        Val.Str(s) => s.clone(),
        _ => String.new(),
    }
}

fn truthy(v: ref Val) -> bool {
    match v {
        Val.Non => false,
        Val.Bool(b) => b,
        Val.Int(n) => n != 0,
        Val.Float(x) => x != 0.0,
        Val.Str(s) => s.len() > 0,
        Val.Bytes(b) => b.len() > 0,
        Val.List(xs) => xs.len() > 0,
        Val.Set(xs) => xs.len() > 0,
        Val.Dict(ks, _) => ks.len() > 0,
        Val.Obj(_, _) => true,
    }
}

fn is_hashable(v: ref Val) -> bool {
    match v {
        Val.List(_) => false,
        Val.Set(_) => false,
        Val.Dict(_, _) => false,
        Val.Obj(_, _) => false,
        _ => true,
    }
}

fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    if x == f64.INFINITY {
        return "inf".to_string();
    }
    if x == -f64.INFINITY {
        return "-inf".to_string();
    }
    if x == 0.0 {
        return if x.to_bits() >> 63 == 1 { "-0.0".to_string() } else { "0.0".to_string() };
    }
    f"{x}"
}

// a == b, as Python compares them (NaN equals nothing).
fn py_eq(a: ref Val, b: ref Val) -> bool {
    if is_number(a) and is_number(b) {
        match (a, b) {
            (Val.Float(_), _) => return float_of(a) == float_of(b),
            (_, Val.Float(_)) => return float_of(a) == float_of(b),
            _ => return int_of(a) == int_of(b),
        }
    }
    match (a, b) {
        (Val.Non, Val.Non) => true,
        (Val.Str(x), Val.Str(y)) => x == y,
        (Val.Bytes(x), Val.Bytes(y)) => x == y,
        (Val.List(x), Val.List(y)) => {
            if x.len() != y.len() {
                return false;
            }
            for i in 0..x.len() {
                if not py_eq(x[i], y[i]) {
                    return false;
                }
            }
            true
        }
        (Val.Set(x), Val.Set(y)) => {
            if x.len() != y.len() {
                return false;
            }
            for e in x {
                if index_of(y, e) < 0 {
                    return false;
                }
            }
            true
        }
        (Val.Dict(xk, xv), Val.Dict(yk, yv)) => {
            if xk.len() != yk.len() {
                return false;
            }
            for i in 0..xk.len() {
                let j = index_of(yk, xk[i]);
                if j < 0 or not py_eq(xv[i], yv[j]) {
                    return false;
                }
            }
            true
        }
        (Val.Obj(c1, s1), Val.Obj(c2, s2)) => {
            if c1 != c2 {
                return false;
            }
            for i in 0..s1.len() {
                if not py_eq(s1[i], s2[i]) {
                    return false;
                }
            }
            true
        }
        _ => false,
    }
}

fn index_of(xs: ref Vec[Val], v: ref Val) -> i64 {
    for i in 0..xs.len() {
        if py_eq(xs[i], v) {
            return i;
        }
    }
    -1
}

// set.add(v)
fn set_add(xs: mut ref Vec[Val], v: own Val) {
    if index_of(xs, v) < 0 {
        xs.push(v);
    }
}

// d[k] = v: an equal key keeps its place and takes the new value.
fn dict_set(ks: mut ref Vec[Val], vs: mut ref Vec[Val], k: own Val, v: own Val) {
    let i = index_of(ks, k);
    if i >= 0 {
        vs[i] = v;
    } else {
        ks.push(k);
        vs.push(v);
    }
}

// a < b for the members of a set (numbers, strings, bytes).
fn py_lt(a: ref Val, b: ref Val) -> bool {
    if is_number(a) and is_number(b) {
        return float_of(a) < float_of(b);
    }
    match (a, b) {
        (Val.Str(x), Val.Str(y)) => x < y,
        (Val.Bytes(x), Val.Bytes(y)) => {
            let n = if x.len() < y.len() { x.len() } else { y.len() };
            for i in 0..n {
                if x[i] != y[i] {
                    return x[i] < y[i];
                }
            }
            x.len() < y.len()
        }
        _ => false,
    }
}

// sorted(), which is stable.
fn sorted_pvs(xs: ref Vec[Val]) -> Vec[Val] {
    let mut v = xs.clone();
    let mut i = 1;
    while i < v.len() {
        let mut j = i;
        while j > 0 and py_lt(v[j], v[j - 1]) {
            let t = v[j].clone();
            v[j] = v[j - 1].clone();
            v[j - 1] = t;
            j -= 1;
        }
        i += 1;
    }
    v
}

// ------------------------------------------------------------ TType

const T_STOP: i64 = 0;
const T_BOOL: i64 = 2;
const T_BYTE: i64 = 3;
const T_DOUBLE: i64 = 4;
const T_I16: i64 = 6;
const T_I32: i64 = 8;
const T_I64: i64 = 10;
const T_STRING: i64 = 11;
const T_STRUCT: i64 = 12;
const T_MAP: i64 = 13;
const T_SET: i64 = 14;
const T_LIST: i64 = 15;

const M_CALL: i64 = 1;
const M_REPLY: i64 = 2;
const M_EXCEPTION: i64 = 3;
const M_ONEWAY: i64 = 4;

fn tname(t: i64) -> String {
    if t == T_BOOL {
        "bool".to_string()
    } else if t == T_BYTE {
        "byte".to_string()
    } else if t == T_I16 {
        "i16".to_string()
    } else if t == T_I32 {
        "i32".to_string()
    } else if t == T_I64 {
        "i64".to_string()
    } else if t == T_DOUBLE {
        "double".to_string()
    } else if t == T_STRING {
        "string".to_string()
    } else if t == T_STRUCT {
        "struct".to_string()
    } else if t == T_MAP {
        "map".to_string()
    } else if t == T_SET {
        "set".to_string()
    } else if t == T_LIST {
        "list".to_string()
    } else {
        f"type{t}"
    }
}

// ------------------------------------------------------------ the compiled IDL

// A type as a thrift_spec carries it: the TType, whether a string is
// binary, the struct class, and the element (or key) and value types.
struct Ty {
    t: i64,
    bin: bool,
    cls: i64,
    a: i64,
    b: i64,
}

// One thrift_spec entry: (fid, ttype, name, type args, default).
#[derive(Clone)]
struct Field {
    fid: i64,
    name: String,
    ty: i64,
}

// A generated class: TBase (or TExceptionBase) with __slots__ in IDL
// order, the IDL defaults the constructor deep-copies, and thrift_spec,
// a tuple indexed by field id (spec[i] is the field there, or -1 for
// None).
#[derive(Clone)]
struct Class {
    name: String,
    module: String,
    exc: bool,
    slots: Vec[String],
    defaults: Vec[Val],
    fields: Vec[Field],
    spec: Vec[i64],
}

#[derive(Clone)]
struct Method {
    service: String,
    name: String,
    oneway: bool,
    has_ret: bool,
    args: i64,
    result: i64,
    throws: Vec[String],
}

struct Service {
    name: String,
    base: String,
    methods: Vec[String],
}

struct Model {
    tys: Vec[Ty],
    classes: Vec[Class],
    enum_names: Vec[String],
    enum_members: Vec[Vec[String]],
    enum_values: Vec[Vec[i64]],
    const_names: Vec[String],
    const_values: Vec[Val],
    services: Vec[Service],
    methods: Vec[Method],
}

fn class_id(m: ref Model, name: ref String) -> i64 {
    for i in 0..m.classes.len() {
        if m.classes[i].name == name {
            return i;
        }
    }
    -1
}

fn ty_t(m: ref Model, ty: i64) -> i64 {
    m.tys[ty].t
}

// type(v).__name__
fn type_name(m: ref Model, v: ref Val) -> String {
    match v {
        Val.Non => "NoneType".to_string(),
        Val.Bool(_) => "bool".to_string(),
        Val.Int(_) => "int".to_string(),
        Val.Float(_) => "float".to_string(),
        Val.Str(_) => "str".to_string(),
        Val.Bytes(_) => "bytes".to_string(),
        Val.List(_) => "list".to_string(),
        Val.Set(_) => "set".to_string(),
        Val.Dict(_, _) => "dict".to_string(),
        Val.Obj(c, _) => m.classes[c].name.clone(),
    }
}

// A new instance: positional arguments, then keyword ones, then the IDL
// defaults (deep copies).
fn new_obj(m: ref Model, cls: i64, args: ref Vec[Val], kw_names: ref Vec[String], kw_vals: ref Vec[Val]) -> Result[Val, Exc] {
    let c = m.classes[cls].clone();
    let mut used: Vec[bool] = Vec.new();
    for _ in 0..kw_names.len() {
        used.push(false);
    }
    let mut slots: Vec[Val] = Vec.new();
    for i in 0..c.slots.len() {
        if i < args.len() {
            slots.push(args[i].clone());
            continue;
        }
        let mut found = -1;
        for k in 0..kw_names.len() {
            if kw_names[k] == c.slots[i] and not used[k] {
                found = k;
            }
        }
        if found >= 0 {
            used[found] = true;
            slots.push(kw_vals[found].clone());
        } else {
            slots.push(c.defaults[i].clone());
        }
    }
    for k in 0..kw_names.len() {
        if not used[k] {
            return Err(type_error(f"{c.name}.__init__() got an unexpected keyword argument '{kw_names[k]}'"));
        }
    }
    Ok(Val.Obj(cls, slots))
}

fn empty_obj(m: ref Model, cls: i64) -> Val {
    let none: Vec[Val] = Vec.new();
    let names: Vec[String] = Vec.new();
    match new_obj(m, cls, none, names, none) {
        Ok(v) => v,
        Err(_) => Val.Non,
    }
}

fn slot_index(m: ref Model, cls: i64, name: Str) -> i64 {
    let c = m.classes[cls].clone();
    for i in 0..c.slots.len() {
        if c.slots[i] == name {
            return i;
        }
    }
    -1
}

fn get_attr(m: ref Model, v: ref Val, name: Str) -> Result[Val, Exc] {
    match v {
        Val.Obj(c, slots) => {
            let i = slot_index(m, c, name);
            if i >= 0 {
                return Ok(slots[i].clone());
            }
            Err(exc("AttributeError", f"'{m.classes[c].name}' object has no attribute '{name}'"))
        }
        _ => Err(exc("AttributeError", f"'{type_name(m, v)}' object has no attribute '{name}'")),
    }
}

fn set_attr(m: ref Model, v: mut ref Val, name: Str, val: own Val) {
    match v {
        Val.Obj(c, slots) => {
            let i = slot_index(m, c, name);
            if i >= 0 {
                slots[i] = val;
            }
        }
        _ => {}
    }
}

// repr(), with a set's members sorted (CPython orders a set of str by a
// per-process hash).
fn show(m: ref Model, v: ref Val) -> String {
    match v {
        Val.Non => "None".to_string(),
        Val.Bool(b) => if b { "True".to_string() } else { "False".to_string() },
        Val.Int(n) => f"{n}",
        Val.Float(x) => float_repr(x),
        Val.Str(s) => str_repr(s),
        Val.Bytes(b) => bytes_repr(b),
        Val.List(xs) => {
            let mut parts: Vec[String] = Vec.new();
            for x in xs {
                parts.push(show(m, x));
            }
            f"[{join_strs(parts, ", ")}]"
        }
        Val.Set(xs) => {
            if xs.len() == 0 {
                return "set()".to_string();
            }
            let mut parts: Vec[String] = Vec.new();
            for x in sorted_pvs(xs) {
                parts.push(show(m, x));
            }
            f"{{{join_strs(parts, ", ")}}}"
        }
        Val.Dict(ks, vs) => {
            let mut parts: Vec[String] = Vec.new();
            for i in 0..ks.len() {
                parts.push(f"{show(m, ks[i])}: {show(m, vs[i])}");
            }
            f"{{{join_strs(parts, ", ")}}}"
        }
        Val.Obj(c, slots) => {
            let cl = m.classes[c].clone();
            let mut parts: Vec[String] = Vec.new();
            for i in 0..cl.slots.len() {
                parts.push(f"{cl.slots[i]}={show(m, slots[i])}");
            }
            f"{cl.name}({join_strs(parts, ", ")})"
        }
    }
}

// str(): what '{0}'.format(v) gives.
fn py_str(m: ref Model, v: ref Val) -> String {
    match v {
        Val.Str(s) => s.clone(),
        _ => show(m, v),
    }
}

// Sets become sorted lists, so a re-encoded record is the same bytes in
// every run.
fn canon(v: ref Val) -> Val {
    match v {
        Val.List(xs) => {
            let mut out: Vec[Val] = Vec.new();
            for x in xs {
                out.push(canon(x));
            }
            Val.List(out)
        }
        Val.Set(xs) => {
            let mut out: Vec[Val] = Vec.new();
            for x in sorted_pvs(xs) {
                out.push(canon(x));
            }
            Val.List(out)
        }
        Val.Dict(ks, vs) => {
            let mut out: Vec[Val] = Vec.new();
            for x in vs {
                out.push(canon(x));
            }
            Val.Dict(ks.clone(), out)
        }
        Val.Obj(c, slots) => {
            let mut out: Vec[Val] = Vec.new();
            for x in slots {
                out.push(canon(x));
            }
            Val.Obj(c, out)
        }
        _ => v.clone(),
    }
}

fn py_len(m: ref Model, v: ref Val) -> Result[i64, Exc] {
    match v {
        Val.Str(s) => Ok(s.chars().count()),
        Val.Bytes(b) => Ok(b.len()),
        Val.List(xs) => Ok(xs.len()),
        Val.Set(xs) => Ok(xs.len()),
        Val.Dict(ks, _) => Ok(ks.len()),
        _ => Err(type_error(f"object of type '{type_name(m, v)}' has no len()")),
    }
}

// iter(v): a str gives its characters, bytes its ints, a dict its keys.
fn py_iter(m: ref Model, v: ref Val) -> Result[Vec[Val], Exc] {
    match v {
        Val.Str(s) => {
            let mut out: Vec[Val] = Vec.new();
            for c in s.chars() {
                out.push(Val.Str(c.to_string()));
            }
            Ok(out)
        }
        Val.Bytes(b) => {
            let mut out: Vec[Val] = Vec.new();
            for x in b {
                out.push(Val.Int(x as i64));
            }
            Ok(out)
        }
        Val.List(xs) => Ok(xs.clone()),
        Val.Set(xs) => Ok(xs.clone()),
        Val.Dict(ks, _) => Ok(ks.clone()),
        _ => Err(type_error(f"'{type_name(m, v)}' object is not iterable")),
    }
}

// ------------------------------------------------------------ the IDL

// A token: 0 identifier (dots included, as in Level.INFO), 1 number,
// 2 string, 3 punctuation, 4 end.
#[derive(Clone)]
struct Tok {
    k: i64,
    s: String,
    v: Val,
}

fn is_alpha(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z')
}

fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn is_alnum(c: char) -> bool {
    is_alpha(c) or is_digit(c)
}

// int(word, 0) for the IDL's integers.
fn idl_int(word: ref String) -> i64 {
    let cs: Vec[char] = word.chars().collect();
    let mut i = 0;
    let mut neg = false;
    if i < cs.len() and (cs[i] == '+' or cs[i] == '-') {
        neg = cs[i] == '-';
        i += 1;
    }
    let mut n = 0;
    if i + 1 < cs.len() and cs[i] == '0' and (cs[i + 1] == 'x' or cs[i + 1] == 'X') {
        i += 2;
        while i < cs.len() {
            n = n * 16 + hex_val(cs[i]);
            i += 1;
        }
    } else {
        while i < cs.len() {
            n = n * 10 + (cs[i] as i64 - 48);
            i += 1;
        }
    }
    if neg { -n } else { n }
}

fn tokenize(text: ref String) -> Vec[Tok] {
    let cs: Vec[char] = text.chars().collect();
    let n = cs.len();
    let mut toks: Vec[Tok] = Vec.new();
    let mut i = 0;
    while i < n {
        let c = cs[i];
        if c == ' ' or c == '\t' or c == '\r' or c == '\n' {
            i += 1;
        } else if (c == '/' and i + 1 < n and cs[i + 1] == '/') or c == '#' {
            while i < n and cs[i] != '\n' {
                i += 1;
            }
        } else if c == '/' and i + 1 < n and cs[i + 1] == '*' {
            let mut j = i + 2;
            while j + 1 < n and not (cs[j] == '*' and cs[j + 1] == '/') {
                j += 1;
            }
            i = j + 2;
        } else if c == '"' or c == '\'' {
            let mut j = i + 1;
            let mut buf = String.new();
            while cs[j] != c {
                if cs[j] == '\\' {
                    j += 1;
                    let e = cs[j];
                    buf.push(if e == 'n' { '\n' } else if e == 't' { '\t' } else { e });
                } else {
                    buf.push(cs[j]);
                }
                j += 1;
            }
            toks.push(Tok { k: 2, s: buf.clone(), v: Val.Str(buf) });
            i = j + 1;
        } else if is_digit(c) or ((c == '+' or c == '-') and i + 1 < n and is_digit(cs[i + 1])) {
            let mut j = i + 1;
            while j < n and (is_alnum(cs[j]) or cs[j] == '.' or cs[j] == '+' or cs[j] == '-')
                and not ((cs[j] == '+' or cs[j] == '-') and cs[j - 1] != 'e' and cs[j - 1] != 'E') {
                j += 1;
            }
            let word = chars_str(cs, i, j);
            let lower = word.to_lowercase();
            let is_hex = lower.starts_with("0x") or lower.starts_with("-0x") or lower.starts_with("+0x");
            let v = if (word.contains(".") or lower.contains("e")) and not is_hex {
                Val.Float(f64.parse(word.clone()).unwrap_or(0.0))
            } else {
                Val.Int(idl_int(word))
            };
            toks.push(Tok { k: 1, s: word, v: v });
            i = j;
        } else if is_alpha(c) or c == '_' {
            let mut j = i;
            while j < n and (is_alnum(cs[j]) or cs[j] == '_' or cs[j] == '.') {
                j += 1;
            }
            toks.push(Tok { k: 0, s: chars_str(cs, i, j), v: Val.Non });
            i = j;
        } else {
            toks.push(Tok { k: 3, s: c.to_string(), v: Val.Non });
            i += 1;
        }
    }
    toks
}

struct Lexer {
    toks: Vec[Tok],
    pos: i64,
}

fn peek_tok(t: ref Lexer) -> Tok {
    if t.pos < t.toks.len() {
        t.toks[t.pos].clone()
    } else {
        Tok { k: 4, s: String.new(), v: Val.Non }
    }
}

fn next_tok(t: mut ref Lexer) -> Tok {
    let tok = peek_tok(t);
    t.pos += 1;
    tok
}

fn take_tok(t: mut ref Lexer, s: Str) -> bool {
    let tok = peek_tok(t);
    if tok.k != 4 and tok.k != 1 and tok.s == s {
        t.pos += 1;
        return true;
    }
    false
}

fn expect_tok(t: mut ref Lexer, s: Str) {
    let _ = next_tok(mut t);
}

// A type as written: 0 a name, 1 list<a>, 2 set<a>, 3 map<a,b>.
#[derive(Clone)]
struct RawTy {
    kind: i64,
    name: String,
    a: i64,
    b: i64,
}

// A constant value as written: a literal, a list, a map or a reference
// to an enum member or another constant.
#[derive(Clone)]
enum RawVal {
    Lit(Val),
    List(Vec[RawVal]),
    Map(Vec[RawVal], Vec[RawVal]),
    Ref(String),
}

#[derive(Clone)]
struct RawField {
    fid: i64,
    name: String,
    ty: i64,
    default: Option[RawVal],
}

struct RawMethod {
    name: String,
    oneway: bool,
    ret: i64,
    args: Vec[RawField],
    throws: Vec[RawField],
}

struct Idl {
    raw: Vec[RawTy],
    typedef_names: Vec[String],
    typedef_tys: Vec[i64],
    const_names: Vec[String],
    const_vals: Vec[RawVal],
    enum_names: Vec[String],
    enum_members: Vec[Vec[String]],
    enum_values: Vec[Vec[i64]],
    decl_names: Vec[String],
    decl_exc: Vec[bool],
    decl_fields: Vec[Vec[RawField]],
    svc_names: Vec[String],
    svc_bases: Vec[String],
    svc_methods: Vec[Vec[RawMethod]],
}

fn parse_type(t: mut ref Lexer, idl: mut ref Idl) -> i64 {
    let tok = next_tok(mut t);
    if tok.s == "list" or tok.s == "set" {
        expect_tok(mut t, "<");
        let e = parse_type(mut t, mut idl);
        expect_tok(mut t, ">");
        idl.raw.push(RawTy { kind: if tok.s == "list" { 1 } else { 2 }, name: String.new(), a: e, b: -1 });
        return idl.raw.len() - 1;
    }
    if tok.s == "map" {
        expect_tok(mut t, "<");
        let k = parse_type(mut t, mut idl);
        expect_tok(mut t, ",");
        let v = parse_type(mut t, mut idl);
        expect_tok(mut t, ">");
        idl.raw.push(RawTy { kind: 3, name: String.new(), a: k, b: v });
        return idl.raw.len() - 1;
    }
    idl.raw.push(RawTy { kind: 0, name: tok.s, a: -1, b: -1 });
    idl.raw.len() - 1
}

fn parse_value(t: mut ref Lexer) -> RawVal {
    let tok = next_tok(mut t);
    if tok.k == 1 or tok.k == 2 {
        return RawVal.Lit(tok.v);
    }
    if tok.s == "[" {
        let mut items: Vec[RawVal] = Vec.new();
        while not take_tok(mut t, "]") {
            items.push(parse_value(mut t));
            let _ = take_tok(mut t, ",");
        }
        return RawVal.List(items);
    }
    if tok.s == "{" {
        let mut ks: Vec[RawVal] = Vec.new();
        let mut vs: Vec[RawVal] = Vec.new();
        while not take_tok(mut t, "}") {
            ks.push(parse_value(mut t));
            expect_tok(mut t, ":");
            vs.push(parse_value(mut t));
            let _ = take_tok(mut t, ",");
        }
        return RawVal.Map(ks, vs);
    }
    if tok.s == "true" {
        return RawVal.Lit(Val.Bool(true));
    }
    if tok.s == "false" {
        return RawVal.Lit(Val.Bool(false));
    }
    RawVal.Ref(tok.s)
}

fn take_sep(t: mut ref Lexer) {
    if not take_tok(mut t, ",") {
        let _ = take_tok(mut t, ";");
    }
}

fn parse_fields(t: mut ref Lexer, idl: mut ref Idl, close: Str) -> Vec[RawField] {
    let mut fields: Vec[RawField] = Vec.new();
    while not take_tok(mut t, close) {
        let mut fid = -1;
        if peek_tok(t).k == 1 {
            fid = int_of(next_tok(mut t).v).unwrap_or(-1);
            expect_tok(mut t, ":");
        }
        let p = peek_tok(t);
        if p.s == "required" or p.s == "optional" {
            let _ = next_tok(mut t);
        }
        let ty = parse_type(mut t, mut idl);
        let name = next_tok(mut t).s;
        let mut default: Option[RawVal] = None;
        if take_tok(mut t, "=") {
            default = Some(parse_value(mut t));
        }
        take_sep(mut t);
        fields.push(RawField { fid: fid, name: name, ty: ty, default: default });
    }
    fields
}

fn parse_idl(text: ref String) -> Idl {
    let mut t = Lexer { toks: tokenize(text), pos: 0 };
    let mut idl = Idl {
        raw: Vec.new(),
        typedef_names: Vec.new(),
        typedef_tys: Vec.new(),
        const_names: Vec.new(),
        const_vals: Vec.new(),
        enum_names: Vec.new(),
        enum_members: Vec.new(),
        enum_values: Vec.new(),
        decl_names: Vec.new(),
        decl_exc: Vec.new(),
        decl_fields: Vec.new(),
        svc_names: Vec.new(),
        svc_bases: Vec.new(),
        svc_methods: Vec.new(),
    };
    while peek_tok(t).k != 4 {
        let kw = next_tok(mut t).s;
        if kw == "namespace" {
            let _ = next_tok(mut t);
            let _ = next_tok(mut t);
        } else if kw == "typedef" {
            let ty = parse_type(mut t, mut idl);
            idl.typedef_names.push(next_tok(mut t).s);
            idl.typedef_tys.push(ty);
        } else if kw == "const" {
            let _ = parse_type(mut t, mut idl);
            let name = next_tok(mut t).s;
            expect_tok(mut t, "=");
            idl.const_names.push(name);
            idl.const_vals.push(parse_value(mut t));
            take_sep(mut t);
        } else if kw == "enum" {
            idl.enum_names.push(next_tok(mut t).s);
            expect_tok(mut t, "{");
            let mut members: Vec[String] = Vec.new();
            let mut values: Vec[i64] = Vec.new();
            let mut nxt = 0;
            while not take_tok(mut t, "}") {
                members.push(next_tok(mut t).s);
                if take_tok(mut t, "=") {
                    nxt = int_of(next_tok(mut t).v).unwrap_or(0);
                }
                values.push(nxt);
                nxt += 1;
                take_sep(mut t);
            }
            idl.enum_members.push(members);
            idl.enum_values.push(values);
        } else if kw == "struct" or kw == "exception" {
            idl.decl_names.push(next_tok(mut t).s);
            idl.decl_exc.push(kw == "exception");
            expect_tok(mut t, "{");
            let fields = parse_fields(mut t, mut idl, "}");
            idl.decl_fields.push(fields);
        } else if kw == "service" {
            idl.svc_names.push(next_tok(mut t).s);
            let mut base = String.new();
            if take_tok(mut t, "extends") {
                base = next_tok(mut t).s;
            }
            idl.svc_bases.push(base);
            expect_tok(mut t, "{");
            let mut methods: Vec[RawMethod] = Vec.new();
            while not take_tok(mut t, "}") {
                let oneway = take_tok(mut t, "oneway");
                let mut ret = -1;
                if peek_tok(t).s == "void" {
                    let _ = next_tok(mut t);
                } else {
                    ret = parse_type(mut t, mut idl);
                }
                let mname = next_tok(mut t).s;
                expect_tok(mut t, "(");
                let args = parse_fields(mut t, mut idl, ")");
                let mut throws: Vec[RawField] = Vec.new();
                if take_tok(mut t, "throws") {
                    expect_tok(mut t, "(");
                    throws = parse_fields(mut t, mut idl, ")");
                }
                take_sep(mut t);
                methods.push(RawMethod { name: mname, oneway: oneway, ret: ret, args: args, throws: throws });
            }
            idl.svc_methods.push(methods);
        }
    }
    idl
}

// ------------------------------------------------------------ what `thrift --gen py:dynamic` emits


fn base_ttype(name: ref String) -> i64 {
    if name == "bool" {
        T_BOOL
    } else if name == "byte" or name == "i8" {
        T_BYTE
    } else if name == "i16" {
        T_I16
    } else if name == "i32" {
        T_I32
    } else if name == "i64" {
        T_I64
    } else if name == "double" {
        T_DOUBLE
    } else if name == "string" or name == "binary" {
        T_STRING
    } else {
        -1
    }
}

fn resolve_raw(idl: ref Idl, r: i64) -> i64 {
    let mut cur = r;
    loop {
        let node = idl.raw[cur].clone();
        if node.kind != 0 {
            return cur;
        }
        let mut found = -1;
        for i in 0..idl.typedef_names.len() {
            if idl.typedef_names[i] == node.name {
                found = idl.typedef_tys[i];
            }
        }
        if found < 0 {
            return cur;
        }
        cur = found;
    }
}

fn enum_index(m: ref Model, name: ref String) -> i64 {
    for i in 0..m.enum_names.len() {
        if m.enum_names[i] == name {
            return i;
        }
    }
    -1
}

// The thrift_spec type of a raw type, added to m.tys.
fn spec_ty(idl: ref Idl, m: mut ref Model, r: i64) -> i64 {
    let node = idl.raw[resolve_raw(idl, r)].clone();
    let ty = if node.kind == 1 or node.kind == 2 {
        let e = spec_ty(idl, mut m, node.a);
        Ty { t: if node.kind == 1 { T_LIST } else { T_SET }, bin: false, cls: -1, a: e, b: -1 }
    } else if node.kind == 3 {
        let k = spec_ty(idl, mut m, node.a);
        let v = spec_ty(idl, mut m, node.b);
        Ty { t: T_MAP, bin: false, cls: -1, a: k, b: v }
    } else if base_ttype(node.name) >= 0 {
        Ty { t: base_ttype(node.name), bin: node.name == "binary", cls: -1, a: -1, b: -1 }
    } else if enum_index(m, node.name) >= 0 {
        Ty { t: T_I32, bin: false, cls: -1, a: -1, b: -1 }
    } else {
        Ty { t: T_STRUCT, bin: false, cls: class_id(m, node.name), a: -1, b: -1 }
    };
    m.tys.push(ty);
    m.tys.len() - 1
}

fn const_value(idl: ref Idl, m: ref Model, v: ref RawVal) -> Val {
    match v {
        RawVal.Lit(x) => x.clone(),
        RawVal.List(items) => {
            let mut out: Vec[Val] = Vec.new();
            for x in items {
                out.push(const_value(idl, m, x));
            }
            Val.List(out)
        }
        RawVal.Map(ks, vs) => {
            let mut keys: Vec[Val] = Vec.new();
            let mut vals: Vec[Val] = Vec.new();
            for i in 0..ks.len() {
                dict_set(mut keys, mut vals, const_value(idl, m, ks[i]), const_value(idl, m, vs[i]));
            }
            Val.Dict(keys, vals)
        }
        RawVal.Ref(name) => {
            match name.find(".") {
                Some(dot) => {
                    let en = name[0..dot].to_string();
                    let mem = name[(dot + 1)..].to_string();
                    let e = enum_index(m, en);
                    if e >= 0 {
                        for i in 0..m.enum_members[e].len() {
                            if m.enum_members[e][i] == mem {
                                return Val.Int(m.enum_values[e][i]);
                            }
                        }
                    }
                    Val.Non
                }
                None => {
                    for i in 0..idl.const_names.len() {
                        if idl.const_names[i] == name {
                            return const_value(idl, m, idl.const_vals[i]);
                        }
                    }
                    Val.Non
                }
            }
        }
    }
}

fn add_class(idl: ref Idl, m: mut ref Model, name: ref String, module: ref String, exc_: bool, fields: ref Vec[RawField]) -> i64 {
    let mut slots: Vec[String] = Vec.new();
    let mut defaults: Vec[Val] = Vec.new();
    for f in fields {
        slots.push(f.name.clone());
        defaults.push(match f.default {
            Some(d) => const_value(idl, m, d),
            None => Val.Non,
        });
    }
    m.classes.push(Class {
        name: name.clone(),
        module: module.clone(),
        exc: exc_,
        slots: slots,
        defaults: defaults,
        fields: Vec.new(),
        spec: Vec.new(),
    });
    m.classes.len() - 1
}

fn compile_idl(text: ref String) -> Model {
    let idl = parse_idl(text);
    let mut m = Model {
        tys: Vec.new(),
        classes: Vec.new(),
        enum_names: idl.enum_names.clone(),
        enum_members: idl.enum_members.clone(),
        enum_values: idl.enum_values.clone(),
        const_names: Vec.new(),
        const_values: Vec.new(),
        services: Vec.new(),
        methods: Vec.new(),
    };
    for i in 0..idl.const_names.len() {
        m.const_names.push(idl.const_names[i].clone());
        let v = const_value(idl, m, idl.const_vals[i]);
        m.const_values.push(v);
    }
    // The classes in the order the generator emits them, with each one's
    // fields, so the specs can be filled in once every class exists.
    let mut order_fields: Vec[Vec[RawField]] = Vec.new();
    for i in 0..idl.decl_names.len() {
        let _ = add_class(idl, mut m, idl.decl_names[i], "app.ttypes".to_string(), idl.decl_exc[i], idl.decl_fields[i]);
        order_fields.push(idl.decl_fields[i].clone());
    }
    for s in 0..idl.svc_names.len() {
        let sname = idl.svc_names[s].clone();
        let module = f"app.{sname}";
        let mut names: Vec[String] = Vec.new();
        for meth in idl.svc_methods[s] {
            let a = add_class(idl, mut m, f"{meth.name}_args", module, false, meth.args);
            order_fields.push(meth.args.clone());
            let mut r = -1;
            if not meth.oneway {
                let mut rf: Vec[RawField] = Vec.new();
                if meth.ret >= 0 {
                    rf.push(RawField { fid: 0, name: "success".to_string(), ty: meth.ret, default: None });
                }
                for f in meth.throws {
                    rf.push(f.clone());
                }
                r = add_class(idl, mut m, f"{meth.name}_result", module, false, rf);
                order_fields.push(rf);
            }
            let mut throws: Vec[String] = Vec.new();
            for f in meth.throws {
                throws.push(f.name.clone());
            }
            m.methods.push(Method {
                service: sname.clone(),
                name: meth.name.clone(),
                oneway: meth.oneway,
                has_ret: meth.ret >= 0,
                args: a,
                result: r,
                throws: throws,
            });
            names.push(meth.name.clone());
        }
        m.services.push(Service { name: sname, base: idl.svc_bases[s].clone(), methods: names });
    }
    for c in 0..order_fields.len() {
        let fields = order_fields[c].clone();
        if fields.len() == 0 {
            continue;
        }
        let mut top = 0;
        for f in fields {
            if f.fid > top {
                top = f.fid;
            }
        }
        let mut spec: Vec[i64] = Vec.new();
        for _ in 0..(top + 1) {
            spec.push(-1);
        }
        let mut out: Vec[Field] = Vec.new();
        for f in fields {
            let ty = spec_ty(idl, mut m, f.ty);
            spec[f.fid] = out.len();
            out.push(Field { fid: f.fid, name: f.name.clone(), ty: ty });
        }
        m.classes[c].fields = out;
        m.classes[c].spec = spec;
    }
    m
}

// A service's methods, inherited ones first, as (service, method).
fn service_methods(m: ref Model, sname: ref String) -> Vec[(String, String)] {
    let mut out: Vec[(String, String)] = Vec.new();
    for s in m.services {
        if s.name == sname {
            if s.base.len() > 0 {
                out = service_methods(m, s.base);
            }
            for name in s.methods {
                out.push((sname.clone(), name.clone()));
            }
        }
    }
    out
}

fn method_of(m: ref Model, sname: ref String, name: ref String) -> i64 {
    let mut service = String.new();
    for (s, n) in service_methods(m, sname) {
        if n == name {
            service = s.clone();
        }
    }
    for i in 0..m.methods.len() {
        if m.methods[i].service == service and m.methods[i].name == name {
            return i;
        }
    }
    -1
}

// ------------------------------------------------------------ transports

const TR_PLAIN: i64 = 0;
const TR_FRAMED: i64 = 1;
const TR_BUFFERED: i64 = 2;

// A transport over bytes: TMemoryBuffer or TFileObjectTransport (plain),
// or TFramedTransport / TBufferedTransport over one. src and pos are the
// underlying stream being read, out what has reached the underlying
// stream, rbuf the framed transport's current frame and wbuf the bytes a
// framed or buffered transport holds until flush().
struct Trans {
    kind: i64,
    src: Vec[u8],
    pos: i64,
    rbuf: Vec[u8],
    rpos: i64,
    out: Vec[u8],
    wbuf: Vec[u8],
}

fn trans_new(kind: i64, src: own Vec[u8]) -> Trans {
    Trans { kind: kind, src: src, pos: 0, rbuf: Vec.new(), rpos: 0, out: Vec.new(), wbuf: Vec.new() }
}

fn base_read(t: mut ref Trans, sz: i64) -> Vec[u8] {
    let mut end = t.pos + sz;
    if end > t.src.len() {
        end = t.src.len();
    }
    let got = sub(t.src, t.pos, end);
    t.pos = end;
    got
}

// TTransportBase.readAll over the underlying stream.
fn base_read_all(t: mut ref Trans, sz: i64) -> Result[Vec[u8], Exc] {
    let mut buff: Vec[u8] = Vec.new();
    while buff.len() < sz {
        let chunk = base_read(mut t, sz - buff.len());
        if chunk.len() == 0 {
            return Err(eof_error());
        }
        append(mut buff, chunk);
    }
    Ok(buff)
}

fn take_rbuf(t: mut ref Trans, sz: i64) -> Vec[u8] {
    let mut end = t.rpos + sz;
    if end > t.rbuf.len() {
        end = t.rbuf.len();
    }
    let got = sub(t.rbuf, t.rpos, end);
    t.rpos = end;
    got
}

// trans.read(sz): the framed transport reads a whole frame when its
// current one is used up.
fn t_read(t: mut ref Trans, sz: i64) -> Result[Vec[u8], Exc] {
    if t.kind != TR_FRAMED {
        return Ok(base_read(mut t, sz));
    }
    let ret = take_rbuf(mut t, sz);
    if ret.len() != 0 {
        return Ok(ret);
    }
    let head = base_read_all(mut t, 4)?;
    let size = be_int(head);
    t.rbuf = base_read_all(mut t, size)?;
    t.rpos = 0;
    Ok(take_rbuf(mut t, sz))
}

fn t_read_all(t: mut ref Trans, sz: i64) -> Result[Vec[u8], Exc] {
    let mut buff: Vec[u8] = Vec.new();
    while buff.len() < sz {
        let chunk = t_read(mut t, sz - buff.len())?;
        if chunk.len() == 0 {
            return Err(eof_error());
        }
        append(mut buff, chunk);
    }
    Ok(buff)
}

fn t_write(t: mut ref Trans, b: ref Vec[u8]) {
    if t.kind == TR_PLAIN {
        append(mut t.out, b);
    } else {
        append(mut t.wbuf, b);
    }
}

fn t_flush(t: mut ref Trans) {
    if t.kind == TR_FRAMED {
        let n = t.wbuf.len();
        append(mut t.out, be_bytes(n, 4));
        let w = t.wbuf.clone();
        append(mut t.out, w);
    } else if t.kind == TR_BUFFERED {
        let w = t.wbuf.clone();
        append(mut t.out, w);
    }
    t.wbuf = Vec.new();
}

// ------------------------------------------------------------ byte packing

fn be_bytes(n: i64, w: i64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut i = w - 1;
    while i >= 0 {
        out.push(((n >> (8 * i)) & 0xFF) as u8);
        i -= 1;
    }
    out
}

// A signed big-endian integer.
fn be_int(b: ref Vec[u8]) -> i64 {
    let mut u: u64 = 0;
    for x in b {
        u = (u << 8) | (x as u64);
    }
    let mut n = u as i64;
    let w = b.len();
    if w < 8 and n >= (1 << (8 * w - 1)) {
        n -= 1 << (8 * w);
    }
    n
}

fn f64_be(x: f64) -> Vec[u8] {
    let bits = x.to_bits();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 7;
    while i >= 0 {
        out.push(((bits >> ((8 * i) as u64)) & 0xFF) as u8);
        i -= 1;
    }
    out
}

fn f64_le(x: f64) -> Vec[u8] {
    let mut b = f64_be(x);
    b.reverse();
    b
}

fn f64_of_be(b: ref Vec[u8]) -> f64 {
    let mut bits: u64 = 0;
    for x in b {
        bits = (bits << 8) | (x as u64);
    }
    bits.bits_as_f64()
}

fn int_range(fmt: char) -> (i64, i64) {
    if fmt == 'b' {
        (-128, 127)
    } else if fmt == 'B' {
        (0, 255)
    } else if fmt == 'h' {
        (-32768, 32767)
    } else if fmt == 'i' {
        (-2147483648, 2147483647)
    } else {
        (-9223372036854775807 - 1, 9223372036854775807)
    }
}

// struct.pack's integer conversion: an int (a bool counts) in range.
fn pack_int(v: ref Val, fmt: char) -> Result[i64, Exc] {
    match int_of(v) {
        Some(n) => {
            let (lo, hi) = int_range(fmt);
            if n < lo or n > hi {
                return Err(struct_error(f"'{fmt}' format requires {lo} <= number <= {hi}"));
            }
            Ok(n)
        }
        None => Err(struct_error("required argument is not an integer".to_string())),
    }
}

// struct.pack's float conversion.
fn pack_float(v: ref Val) -> Result[f64, Exc] {
    if is_number(v) {
        Ok(float_of(v))
    } else {
        Err(struct_error("required argument is not a float".to_string()))
    }
}

fn bits_range(bits: i64) -> (i64, i64) {
    if bits == 8 {
        int_range('b')
    } else if bits == 16 {
        int_range('h')
    } else if bits == 32 {
        int_range('i')
    } else {
        int_range('q')
    }
}

// checkIntegerLimits(i, bits): `i < lo or i > hi`, which a float passes
// in range and anything else fails to compare.
fn check_limits(m: ref Model, v: ref Val, bits: i64) -> Result[(), Exc] {
    let (lo, hi) = bits_range(bits);
    let bad = match v {
        Val.Float(x) => x < lo as f64 or x > hi as f64,
        _ => match int_of(v) {
            Some(n) => n < lo or n > hi,
            None => return Err(type_error(f"'<' not supported between instances of '{type_name(m, v)}' and 'int'")),
        },
    };
    if bad {
        return Err(proto_error(f"i{bits} requires {lo} <= number <= {hi}"));
    }
    Ok(())
}

// makeZigZag(n, bits)
fn zigzag(m: ref Model, v: ref Val, bits: i64) -> Result[u64, Exc] {
    check_limits(m, v, bits)?;
    match int_of(v) {
        Some(n) => Ok(((n as u64) << 1) ^ ((n >> (bits - 1)) as u64)),
        None => Err(type_error("unsupported operand type(s) for <<: 'float' and 'int'".to_string())),
    }
}

fn varint_bytes(n: u64) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut x = n;
    loop {
        if x < 0x80 {
            out.push(x as u8);
            return out;
        }
        out.push(((x & 0xFF) | 0x80) as u8);
        x = x >> 7;
    }
}

// ------------------------------------------------------------ base64

const B64_ALPHABET: Str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

fn b64encode(b: ref Vec[u8]) -> Vec[u8] {
    let alpha = B64_ALPHABET.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let x0 = b[i] as i64;
        let x1 = if i + 1 < b.len() { b[i + 1] as i64 } else { 0 };
        let x2 = if i + 2 < b.len() { b[i + 2] as i64 } else { 0 };
        let n = (x0 << 16) | (x1 << 8) | x2;
        out.push(alpha[(n >> 18) & 63]);
        out.push(alpha[(n >> 12) & 63]);
        out.push(if i + 1 < b.len() { alpha[(n >> 6) & 63] } else { b'=' });
        out.push(if i + 2 < b.len() { alpha[n & 63] } else { b'=' });
        i += 3;
    }
    out
}

fn b64_value(c: u8) -> i64 {
    if c >= b'A' and c <= b'Z' {
        c as i64 - 65
    } else if c >= b'a' and c <= b'z' {
        c as i64 - 71
    } else if c >= b'0' and c <= b'9' {
        c as i64 + 4
    } else if c == b'+' {
        62
    } else if c == b'/' {
        63
    } else {
        -1
    }
}

// base64.b64decode(s) of a str: ASCII only, then binascii.a2b_base64 in
// its default, non-strict mode, which skips characters outside the
// alphabet and padding inside the data, and needs enough padding after
// the last quad's data.
fn b64decode(s: ref String) -> Result[Vec[u8], Exc] {
    let raw = utf8_of(s);
    for c in raw {
        if c >= 0x80 {
            return Err(value_error("string argument should contain only ASCII characters".to_string()));
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut quad = 0;
    let mut left = 0;
    let mut pads = 0;
    for c in raw {
        if c == b'=' {
            pads += 1;
            continue;
        }
        let v = b64_value(c);
        if v < 0 {
            continue;
        }
        pads = 0;
        if quad == 0 {
            quad = 1;
            left = v;
        } else if quad == 1 {
            quad = 2;
            out.push(((left << 2) | (v >> 4)) as u8);
            left = v & 0x0F;
        } else if quad == 2 {
            quad = 3;
            out.push((((left << 4) | (v >> 2)) & 0xFF) as u8);
            left = v & 0x03;
        } else {
            quad = 0;
            out.push((((left << 6) | v) & 0xFF) as u8);
            left = 0;
        }
    }
    if quad == 1 {
        return Err(exc("binascii.Error", f"Invalid base64-encoded string: number of data characters ({out.len() / 3 * 4 + 1}) cannot be 1 more than a multiple of 4"));
    }
    if quad != 0 and quad + pads < 4 {
        return Err(exc("binascii.Error", "Incorrect padding".to_string()));
    }
    Ok(out)
}

// ------------------------------------------------------------ protocols

const P_BINARY: i64 = 0;
const P_COMPACT: i64 = 1;
const P_JSON: i64 = 2;
const P_SJSON: i64 = 3;

// TCompactProtocol's states.
const CLEAR: i64 = 0;
const FIELD_WRITE: i64 = 1;
const VALUE_WRITE: i64 = 2;
const CONTAINER_WRITE: i64 = 3;
const BOOL_WRITE: i64 = 4;
const FIELD_READ: i64 = 5;
const CONTAINER_READ: i64 = 6;
const VALUE_READ: i64 = 7;
const BOOL_READ: i64 = 8;

// A JSON context: 0 base, 1 list (commas), 2 pair (colons and commas).
#[derive(Clone)]
struct Ctx {
    kind: i64,
    first: bool,
    colon: bool,
}

// One protocol object over its transport, with each protocol's state:
// the binary protocol's strictness and limits, the compact protocol's
// state machine, last field id and pending bool, and the JSON protocol's
// context stack and one-byte lookahead (data -1 is b'').
struct Proto {
    kind: i64,
    strict_read: bool,
    strict_write: bool,
    slim: i64,
    clim: i64,
    tr: Trans,
    state: i64,
    last_fid: i64,
    bool_fid: i64,
    bool_value: bool,
    st_state: Vec[i64],
    st_fid: Vec[i64],
    containers: Vec[i64],
    ctxs: Vec[Ctx],
    has_data: bool,
    data: i64,
    service: String,
}

fn proto_new(name: ref String, tr: own Trans, slim: i64, clim: i64) -> Result[Proto, Exc] {
    let kind = if name == "binary" or name == "binary-strict" or name == "binary-loose" {
        P_BINARY
    } else if name == "compact" {
        P_COMPACT
    } else if name == "json" {
        P_JSON
    } else if name == "sjson" {
        P_SJSON
    } else {
        return Err(value_error(f"no protocol {name}"));
    };
    let mut ctxs: Vec[Ctx] = Vec.new();
    ctxs.push(Ctx { kind: 0, first: true, colon: false });
    Ok(Proto {
        kind: kind,
        strict_read: name == "binary-strict",
        strict_write: name != "binary-loose",
        slim: if kind == P_JSON or kind == P_SJSON { -1 } else { slim },
        clim: if kind == P_JSON or kind == P_SJSON { -1 } else { clim },
        tr: tr,
        state: CLEAR,
        last_fid: 0,
        bool_fid: 0,
        bool_value: false,
        st_state: Vec.new(),
        st_fid: Vec.new(),
        containers: Vec.new(),
        ctxs: ctxs,
        has_data: false,
        data: -1,
        service: String.new(),
    })
}

fn is_json(p: ref Proto) -> bool {
    p.kind == P_JSON or p.kind == P_SJSON
}

fn write_raw(p: mut ref Proto, b: ref Vec[u8]) {
    t_write(mut p.tr, b);
}

fn write_str_raw(p: mut ref Proto, s: Str) {
    let b = s.bytes().to_vec();
    t_write(mut p.tr, b);
}

// --- binary and compact primitives over plain integers

fn bin_i(p: mut ref Proto, n: i64, w: i64) {
    let b = be_bytes(n, w);
    t_write(mut p.tr, b);
}

fn varint(p: mut ref Proto, n: u64) {
    let b = varint_bytes(n);
    t_write(mut p.tr, b);
}

fn ubyte(p: mut ref Proto, n: i64) -> Result[(), Exc] {
    if n < 0 or n > 255 {
        return Err(struct_error("'B' format requires 0 <= number <= 255".to_string()));
    }
    bin_i(mut p, n, 1);
    Ok(())
}

fn compact_header(p: mut ref Proto, ctype: i64, fid: i64) -> Result[(), Exc] {
    let delta = fid - p.last_fid;
    if delta > 0 and delta <= 15 {
        ubyte(mut p, (delta << 4) | ctype)?;
    } else {
        bin_i(mut p, ctype, 1);
        let z = zigzag_int(fid, 16)?;
        varint(mut p, z);
    }
    p.last_fid = fid;
    Ok(())
}

fn zigzag_int(n: i64, bits: i64) -> Result[u64, Exc] {
    let (lo, hi) = bits_range(bits);
    if n < lo or n > hi {
        return Err(proto_error(f"i{bits} requires {lo} <= number <= {hi}"));
    }
    Ok(((n as u64) << 1) ^ ((n >> (bits - 1)) as u64))
}

fn compact_type(t: i64) -> i64 {
    if t == T_BOOL {
        1
    } else if t == T_BYTE {
        3
    } else if t == T_I16 {
        4
    } else if t == T_I32 {
        5
    } else if t == T_I64 {
        6
    } else if t == T_DOUBLE {
        7
    } else if t == T_STRING {
        8
    } else if t == T_LIST {
        9
    } else if t == T_SET {
        10
    } else if t == T_MAP {
        11
    } else if t == T_STRUCT {
        12
    } else {
        0
    }
}

fn json_type(t: i64) -> Str {
    if t == T_BOOL {
        "tf"
    } else if t == T_BYTE {
        "i8"
    } else if t == T_I16 {
        "i16"
    } else if t == T_I32 {
        "i32"
    } else if t == T_I64 {
        "i64"
    } else if t == T_DOUBLE {
        "dbl"
    } else if t == T_STRING {
        "str"
    } else if t == T_STRUCT {
        "rec"
    } else if t == T_LIST {
        "lst"
    } else if t == T_SET {
        "set"
    } else {
        "map"
    }
}

// --- the JSON contexts

fn ctx_top(p: ref Proto) -> Ctx {
    if p.ctxs.len() == 0 {
        Ctx { kind: 0, first: true, colon: false }
    } else {
        p.ctxs[p.ctxs.len() - 1].clone()
    }
}

fn ctx_set(p: mut ref Proto, c: own Ctx) {
    let n = p.ctxs.len();
    if n > 0 {
        p.ctxs[n - 1] = c;
    }
}

// context.write(): the separator before the next value.
fn ctx_write(p: mut ref Proto) {
    let mut c = ctx_top(p);
    if c.kind == 1 {
        if c.first {
            c.first = false;
        } else {
            write_str_raw(mut p, ",");
        }
    } else if c.kind == 2 {
        if c.first {
            c.first = false;
            c.colon = true;
        } else {
            write_str_raw(mut p, if c.colon { ":" } else { "," });
            c.colon = not c.colon;
        }
    }
    ctx_set(mut p, c);
}

fn escape_num(p: ref Proto) -> bool {
    let c = ctx_top(p);
    c.kind == 2 and c.colon
}

fn push_ctx(p: mut ref Proto, kind: i64) {
    p.ctxs.push(Ctx { kind: kind, first: true, colon: kind == 2 });
}

fn pop_ctx(p: mut ref Proto) {
    let _ = p.ctxs.pop();
}

fn json_escape_char(c: char) -> Option[Str] {
    if c == '"' {
        Some("\\\"")
    } else if c == '\\' {
        Some("\\\\")
    } else if c == '\u{8}' {
        Some("\\b")
    } else if c == '\u{c}' {
        Some("\\f")
    } else if c == '\n' {
        Some("\\n")
    } else if c == '\r' {
        Some("\\r")
    } else if c == '\t' {
        Some("\\t")
    } else {
        None
    }
}

// writeJSONString(string): it iterates whatever it is given and joins the
// pieces, escaping the one-character strings that need it.
fn json_write_string(m: ref Model, p: mut ref Proto, v: ref Val) -> Result[(), Exc] {
    ctx_write(mut p);
    let items = py_iter(m, v)?;
    for it in items {
        if not is_hashable(it) {
            return Err(type_error(f"unhashable type: '{type_name(m, it)}'"));
        }
    }
    let mut text = "\"".to_string();
    let mut k = 1;
    for it in items {
        match it {
            Val.Str(s) => {
                let cs: Vec[char] = s.chars().collect();
                let mut done = false;
                if cs.len() == 1 {
                    match json_escape_char(cs[0]) {
                        Some(e) => {
                            text.push_str(e);
                            done = true;
                        }
                        None => {}
                    }
                }
                if not done {
                    text.push_str(s);
                }
            }
            _ => return Err(type_error(f"sequence item {k}: expected str instance, {type_name(m, it)} found")),
        }
        k += 1;
    }
    text.push('"');
    write_str_raw(mut p, text);
    Ok(())
}

fn json_write_str(p: mut ref Proto, s: ref String) {
    ctx_write(mut p);
    let mut text = "\"".to_string();
    for c in s.chars() {
        match json_escape_char(c) {
            Some(e) => text.push_str(e),
            None => text.push(c),
        }
    }
    text.push('"');
    write_str_raw(mut p, text);
}

// writeJSONNumber(number): quoted where the context escapes numbers.
fn json_write_number(p: mut ref Proto, text: ref String) {
    ctx_write(mut p);
    if escape_num(p) {
        write_str_raw(mut p, "\"");
        write_str_raw(mut p, text);
        write_str_raw(mut p, "\"");
    } else {
        write_str_raw(mut p, text);
    }
}

// The text the number is written as must be ASCII.
fn ascii_check(s: ref String) -> Result[(), Exc] {
    let cs: Vec[char] = s.chars().collect();
    let mut i = 0;
    while i < cs.len() {
        if cs[i] as i64 >= 128 {
            let mut j = i;
            while j < cs.len() and cs[j] as i64 >= 128 {
                j += 1;
            }
            if j - i == 1 {
                let n = cs[i] as i64;
                let r = if n < 256 { f"\\x{hex2(n)}" } else if n < 65536 { f"\\u{hexn(n, 4)}" } else { f"\\U{hexn(n, 8)}" };
                return Err(exc("UnicodeEncodeError", f"'ascii' codec can't encode character '{r}' in position {i}: ordinal not in range(128)"));
            }
            return Err(exc("UnicodeEncodeError", f"'ascii' codec can't encode characters in position {i}-{j - 1}: ordinal not in range(128)"));
        }
        i += 1;
    }
    Ok(())
}

fn json_write_base64(m: ref Model, p: mut ref Proto, v: ref Val) -> Result[(), Exc] {
    ctx_write(mut p);
    write_str_raw(mut p, "\"");
    match v {
        Val.Bytes(b) => {
            let e = b64encode(b);
            write_raw(mut p, e);
        }
        _ => return Err(type_error(f"a bytes-like object is required, not '{type_name(m, v)}'")),
    }
    write_str_raw(mut p, "\"");
    Ok(())
}

fn json_object_start(p: mut ref Proto) {
    ctx_write(mut p);
    write_str_raw(mut p, "{");
    push_ctx(mut p, 2);
}

fn json_object_end(p: mut ref Proto) {
    pop_ctx(mut p);
    write_str_raw(mut p, "}");
}

fn json_array_start(p: mut ref Proto) {
    ctx_write(mut p);
    write_str_raw(mut p, "[");
    push_ctx(mut p, 1);
}

fn json_array_end(p: mut ref Proto) {
    pop_ctx(mut p);
    write_str_raw(mut p, "]");
}

fn reset_write_context(p: mut ref Proto) {
    p.ctxs = Vec.new();
    p.ctxs.push(Ctx { kind: 0, first: true, colon: false });
}

// '{0:.17g}'.format(v)
fn format_g17(m: ref Model, v: ref Val) -> Result[String, Exc] {
    match v {
        Val.Str(_) => Err(value_error("Unknown format code 'g' for object of type 'str'".to_string())),
        _ => {
            if not is_number(v) {
                return Err(type_error(f"unsupported format string passed to {type_name(m, v)}.__format__"));
            }
            let x = float_of(v);
            let neg = x < 0.0 or (x == 0.0 and x.to_bits() >> 63 == 1);
            let a = if neg { -x } else { x };
            let body = float_body(a, 'g', 17, false, false);
            Ok(if neg { f"-{body}" } else { body })
        }
    }
}

// --- the generic writes

fn write_message_begin(p: mut ref Proto, name0: ref String, mtype: i64, seqid: i64) -> Result[(), Exc] {
    let name = if p.service.len() > 0 and (mtype == M_CALL or mtype == M_ONEWAY) {
        f"{p.service}:{name0}"
    } else {
        name0.clone()
    };
    if p.kind == P_BINARY {
        if p.strict_write {
            let v = -2147418112 | mtype;
            bin_i(mut p, v, 4);
            let b = utf8_of(name);
            bin_i(mut p, b.len(), 4);
            write_raw(mut p, b);
            bin_i(mut p, seqid, 4);
        } else {
            let b = utf8_of(name);
            bin_i(mut p, b.len(), 4);
            write_raw(mut p, b);
            let t = pack_int(Val.Int(mtype), 'b')?;
            bin_i(mut p, t, 1);
            bin_i(mut p, seqid, 4);
        }
    } else if p.kind == P_COMPACT {
        ubyte(mut p, 0x82)?;
        ubyte(mut p, 1 | (mtype << 5))?;
        let s = if seqid < 0 { 4294967296 + seqid } else { seqid };
        varint(mut p, s as u64);
        let b = utf8_of(name);
        varint(mut p, b.len() as u64);
        write_raw(mut p, b);
        p.state = VALUE_WRITE;
    } else if p.kind == P_JSON {
        reset_write_context(mut p);
        json_array_start(mut p);
        json_write_number(mut p, "1".to_string());
        json_write_str(mut p, name);
        json_write_number(mut p, f"{mtype}");
        json_write_number(mut p, f"{seqid}");
    } else {
        reset_write_context(mut p);
    }
    Ok(())
}

fn write_message_end(p: mut ref Proto) {
    if p.kind == P_COMPACT {
        p.state = CLEAR;
    } else if p.kind == P_JSON {
        json_array_end(mut p);
    }
}

fn write_struct_begin(p: mut ref Proto) {
    if p.kind == P_COMPACT {
        p.st_state.push(p.state);
        p.st_fid.push(p.last_fid);
        p.state = FIELD_WRITE;
        p.last_fid = 0;
    } else if is_json(p) {
        json_object_start(mut p);
    }
}

fn write_struct_end(p: mut ref Proto) {
    if p.kind == P_COMPACT {
        p.state = p.st_state.pop().unwrap_or(CLEAR);
        p.last_fid = p.st_fid.pop().unwrap_or(0);
    } else if is_json(p) {
        json_object_end(mut p);
    }
}

fn write_field_begin(p: mut ref Proto, name: ref String, t: i64, fid: i64) -> Result[(), Exc] {
    if p.kind == P_BINARY {
        bin_i(mut p, t, 1);
        bin_i(mut p, fid, 2);
    } else if p.kind == P_COMPACT {
        if t == T_BOOL {
            p.state = BOOL_WRITE;
            p.bool_fid = fid;
        } else {
            p.state = VALUE_WRITE;
            compact_header(mut p, compact_type(t), fid)?;
        }
    } else if p.kind == P_JSON {
        json_write_number(mut p, f"{fid}");
        json_object_start(mut p);
        json_write_str(mut p, json_type(t).to_string());
    } else {
        json_write_str(mut p, name);
    }
    Ok(())
}

fn write_field_end(p: mut ref Proto) {
    if p.kind == P_COMPACT {
        p.state = FIELD_WRITE;
    } else if p.kind == P_JSON {
        json_object_end(mut p);
    }
}

fn write_field_stop(p: mut ref Proto) {
    if p.kind == P_BINARY or p.kind == P_COMPACT {
        bin_i(mut p, 0, 1);
    }
}

fn write_collection_begin(p: mut ref Proto, et: i64, size: i64) -> Result[(), Exc] {
    if p.kind == P_BINARY {
        bin_i(mut p, et, 1);
        let n = pack_int(Val.Int(size), 'i')?;
        bin_i(mut p, n, 4);
    } else if p.kind == P_COMPACT {
        if size <= 14 {
            ubyte(mut p, (size << 4) | compact_type(et))?;
        } else {
            ubyte(mut p, 0xF0 | compact_type(et))?;
            varint(mut p, size as u64);
        }
        p.containers.push(p.state);
        p.state = CONTAINER_WRITE;
    } else if p.kind == P_JSON {
        json_array_start(mut p);
        json_write_str(mut p, json_type(et).to_string());
        json_write_number(mut p, f"{size}");
    } else {
        json_array_start(mut p);
    }
    Ok(())
}

fn write_collection_end(p: mut ref Proto) {
    if p.kind == P_COMPACT {
        p.state = p.containers.pop().unwrap_or(CLEAR);
    } else if is_json(p) {
        json_array_end(mut p);
    }
}

fn write_map_begin(p: mut ref Proto, kt: i64, vt: i64, size: i64) -> Result[(), Exc] {
    if p.kind == P_BINARY {
        bin_i(mut p, kt, 1);
        bin_i(mut p, vt, 1);
        let n = pack_int(Val.Int(size), 'i')?;
        bin_i(mut p, n, 4);
    } else if p.kind == P_COMPACT {
        if size == 0 {
            bin_i(mut p, 0, 1);
        } else {
            varint(mut p, size as u64);
            ubyte(mut p, (compact_type(kt) << 4) | compact_type(vt))?;
        }
        p.containers.push(p.state);
        p.state = CONTAINER_WRITE;
    } else if p.kind == P_JSON {
        json_array_start(mut p);
        json_write_str(mut p, json_type(kt).to_string());
        json_write_str(mut p, json_type(vt).to_string());
        json_write_number(mut p, f"{size}");
        json_object_start(mut p);
    } else {
        json_object_start(mut p);
    }
    Ok(())
}

fn write_map_end(p: mut ref Proto) {
    if p.kind == P_COMPACT {
        p.state = p.containers.pop().unwrap_or(CLEAR);
    } else if p.kind == P_JSON {
        json_object_end(mut p);
        json_array_end(mut p);
    } else if p.kind == P_SJSON {
        json_object_end(mut p);
    }
}

// --- the value writes, each failing on a wrong value the way the
// protocol's Python code does

fn write_bool(p: mut ref Proto, v: ref Val) -> Result[(), Exc] {
    if is_json(p) {
        let one = match v {
            Val.Bool(b) => b,
            _ => false,
        };
        json_write_number(mut p, if one { "1".to_string() } else { "0".to_string() });
        return Ok(());
    }
    let b = truthy(v);
    if p.kind == P_BINARY {
        bin_i(mut p, if b { 1 } else { 0 }, 1);
    } else if p.state == BOOL_WRITE {
        let f = p.bool_fid;
        compact_header(mut p, if b { 1 } else { 2 }, f)?;
    } else if p.state == CONTAINER_WRITE {
        bin_i(mut p, if b { 1 } else { 2 }, 1);
    } else {
        return Err(assertion("Invalid state in compact protocol".to_string()));
    }
    Ok(())
}

fn write_int(m: ref Model, p: mut ref Proto, bits: i64, v: ref Val) -> Result[(), Exc] {
    if p.kind == P_BINARY {
        let fmt = if bits == 8 { 'b' } else if bits == 16 { 'h' } else if bits == 32 { 'i' } else { 'q' };
        let n = pack_int(v, fmt)?;
        bin_i(mut p, n, bits / 8);
    } else if p.kind == P_COMPACT {
        if bits == 8 {
            let n = pack_int(v, 'b')?;
            bin_i(mut p, n, 1);
        } else {
            let z = zigzag(m, v, bits)?;
            varint(mut p, z);
        }
    } else {
        check_limits(m, v, bits)?;
        let text = py_str(m, v);
        json_write_number(mut p, text);
    }
    Ok(())
}

fn write_double(m: ref Model, p: mut ref Proto, v: ref Val) -> Result[(), Exc] {
    if p.kind == P_BINARY {
        let x = pack_float(v)?;
        let b = f64_be(x);
        write_raw(mut p, b);
    } else if p.kind == P_COMPACT {
        let x = pack_float(v)?;
        let b = f64_le(x);
        write_raw(mut p, b);
    } else if p.kind == P_JSON {
        let text = format_g17(m, v)?;
        json_write_number(mut p, text);
    } else {
        ctx_write(mut p);
        let text = py_str(m, v);
        ascii_check(text)?;
        if escape_num(p) {
            write_str_raw(mut p, "\"");
            write_str_raw(mut p, text);
            write_str_raw(mut p, "\"");
        } else {
            write_str_raw(mut p, text);
        }
    }
    Ok(())
}

// writeBinary(v): len(v), then the transport takes only bytes.
fn write_binary(m: ref Model, p: mut ref Proto, v: ref Val) -> Result[(), Exc] {
    if is_json(p) {
        return json_write_base64(m, mut p, v);
    }
    let n = py_len(m, v)?;
    if p.kind == P_BINARY {
        let k = pack_int(Val.Int(n), 'i')?;
        bin_i(mut p, k, 4);
    } else {
        varint(mut p, n as u64);
    }
    match v {
        Val.Bytes(b) => write_raw(mut p, b),
        _ => return Err(type_error(f"a bytes-like object is required, not '{type_name(m, v)}'")),
    }
    Ok(())
}

// writeString(v): bytes(v, 'utf8') first, except in JSON.
fn write_string(m: ref Model, p: mut ref Proto, v: ref Val) -> Result[(), Exc] {
    if is_json(p) {
        return json_write_string(m, mut p, v);
    }
    match v {
        Val.Str(s) => write_binary(m, mut p, Val.Bytes(utf8_of(s))),
        _ => Err(type_error("encoding without a string argument".to_string())),
    }
}

// writeFieldByTType: the value as the spec's type, containers element by
// element.
fn write_val(m: ref Model, p: mut ref Proto, ty: i64, v: ref Val) -> Result[(), Exc] {
    let t = m.tys[ty].t;
    if t == T_BOOL {
        write_bool(mut p, v)
    } else if t == T_BYTE {
        write_int(m, mut p, 8, v)
    } else if t == T_I16 {
        write_int(m, mut p, 16, v)
    } else if t == T_I32 {
        write_int(m, mut p, 32, v)
    } else if t == T_I64 {
        write_int(m, mut p, 64, v)
    } else if t == T_DOUBLE {
        write_double(m, mut p, v)
    } else if t == T_STRING {
        if m.tys[ty].bin {
            write_binary(m, mut p, v)
        } else {
            write_string(m, mut p, v)
        }
    } else if t == T_STRUCT {
        write_obj(m, mut p, v)
    } else if t == T_LIST or t == T_SET {
        let et = m.tys[ty].a;
        let n = py_len(m, v)?;
        write_collection_begin(mut p, m.tys[et].t, n)?;
        for x in py_iter(m, v)? {
            write_val(m, mut p, et, x)?;
        }
        write_collection_end(mut p);
        Ok(())
    } else {
        let kt = m.tys[ty].a;
        let vt = m.tys[ty].b;
        let n = py_len(m, v)?;
        write_map_begin(mut p, m.tys[kt].t, m.tys[vt].t, n)?;
        match v {
            Val.Dict(ks, vs) => {
                for i in 0..ks.len() {
                    write_val(m, mut p, kt, ks[i])?;
                    write_val(m, mut p, vt, vs[i])?;
                }
            }
            _ => return Err(exc("AttributeError", f"'{type_name(m, v)}' object has no attribute 'keys'")),
        }
        write_map_end(mut p);
        Ok(())
    }
}

// obj.write(oprot): TBase.write, which is writeStruct with the object's
// own class.
fn write_obj(m: ref Model, p: mut ref Proto, v: ref Val) -> Result[(), Exc] {
    match v {
        Val.Obj(c, slots) => {
            write_struct_begin(mut p);
            let cl = m.classes[c].clone();
            for idx in cl.spec {
                if idx < 0 {
                    continue;
                }
                let f = cl.fields[idx].clone();
                let si = slot_index(m, c, f.name);
                let val = slots[si].clone();
                if is_none(val) {
                    continue;
                }
                write_field_begin(mut p, f.name, m.tys[f.ty].t, f.fid)?;
                write_val(m, mut p, f.ty, val)?;
                write_field_end(mut p);
            }
            write_field_stop(mut p);
            write_struct_end(mut p);
            Ok(())
        }
        _ => Err(exc("AttributeError", f"'{type_name(m, v)}' object has no attribute 'write'")),
    }
}

// ------------------------------------------------------------ float formatting and float()

fn chars(s: ref String) -> Vec[char] {
    s.chars().collect()
}

fn text(v: ref Vec[char]) -> String {
    v.iter().collect()
}

fn slice(v: ref Vec[char], lo: i64, hi: i64) -> Vec[char] {
    let mut a = lo;
    let mut b = hi;
    if a < 0 {
        a = 0;
    }
    if b > v.len() {
        b = v.len();
    }
    if a >= b {
        return Vec.new();
    }
    v[a..b].to_vec()
}


// str.isspace, which str.strip, str.split and float() use.
fn py_space(c: char) -> bool {
    c.is_whitespace() or (c >= '\u{1c}' and c <= '\u{1f}')
}

fn py_strip(s: ref String) -> String {
    let v = chars(s);
    let mut lo = 0;
    let mut hi = v.len();
    while lo < hi and py_space(v[lo]) {
        lo += 1;
    }
    while hi > lo and py_space(v[hi - 1]) {
        hi -= 1;
    }
    text(slice(v, lo, hi))
}

fn ascii_lower(s: ref String) -> String {
    let mut out = String.new();
    for c in s.chars() {
        if c >= 'A' and c <= 'Z' {
            out.push(char.try_from(c as i64 + 32).unwrap_or(c));
        } else {
            out.push(c);
        }
    }
    out
}


fn exact_decimal(x: f64) -> (Vec[i64], i64) {
    let bits = x.to_bits() as i64;
    let e = (bits >> 52) & 0x7FF;
    let mut mant = bits & 0xFFFFFFFFFFFFF;
    let mut e2 = 0;
    if e == 0 {
        e2 = -1074;
    } else {
        mant = mant | 0x10000000000000;
        e2 = e - 1075;
    }
    while e2 < 0 and mant % 2 == 0 {
        mant = mant / 2;
        e2 += 1;
    }
    // Little-endian decimal digits of mant * 2^e2 (or * 5^-e2).
    let mut n: Vec[i64] = Vec.new();
    let mut t = mant;
    while t > 0 {
        n.push(t % 10);
        t = t / 10;
    }
    let factor = if e2 >= 0 { 2 } else { 5 };
    let times = if e2 >= 0 { e2 } else { 0 - e2 };
    for _ in 0..times {
        let mut carry = 0;
        for i in 0..n.len() {
            let v = n[i] * factor + carry;
            n[i] = v % 10;
            carry = v / 10;
        }
        while carry > 0 {
            n.push(carry % 10);
            carry = carry / 10;
        }
    }
    n.reverse();
    (n, if e2 >= 0 { 0 } else { e2 })
}

// The first `keep` digits of d (zero-padded), rounded half to even on the
// rest. When the rounding carries out, the result has keep + 1 digits.
fn round_digits(d: ref Vec[i64], keep: i64) -> Vec[i64] {
    let mut r: Vec[i64] = Vec.new();
    for i in 0..keep {
        r.push(if i < d.len() { d[i] } else { 0 });
    }
    if keep < 0 or keep >= d.len() {
        return r;
    }
    let first = d[keep];
    let mut rest = false;
    for i in (keep + 1)..d.len() {
        if d[i] != 0 {
            rest = true;
        }
    }
    let odd = keep > 0 and r[keep - 1] % 2 == 1;
    let up = first > 5 or (first == 5 and (rest or odd));
    if not up {
        return r;
    }
    let mut i = keep - 1;
    while i >= 0 {
        if r[i] == 9 {
            r[i] = 0;
            i -= 1;
        } else {
            r[i] += 1;
            return r;
        }
    }
    r.insert(0, 1);
    r
}

fn digit_text(d: ref Vec[i64], lo: i64, hi: i64) -> String {
    let mut s = String.new();
    for i in lo..hi {
        s.push(char.try_from(48 + d[i]).unwrap_or('?'));
    }
    s
}

// x >= 0 to `precision` places ('f').
fn fixed_text(x: f64, precision: i64, alt: bool) -> String {
    let mut n: Vec[i64] = Vec.new();
    if x != 0.0 {
        let (d, e) = exact_decimal(x);
        let keep = d.len() + e + precision;
        if keep >= 0 {
            n = round_digits(d, keep);
        }
    }
    // n is round(x * 10^precision); give it precision + 1 digits at least.
    while n.len() < precision + 1 {
        n.insert(0, 0);
    }
    let mut lead = 0;
    while lead < n.len() - precision - 1 and n[lead] == 0 {
        lead += 1;
    }
    let point = n.len() - precision;
    let mut s = digit_text(n, lead, point);
    if precision > 0 {
        s.push('.');
        s.push_str(digit_text(n, point, n.len()));
    } else if alt {
        s.push('.');
    }
    s
}

// x >= 0 rounded to p significant digits: (exactly p digits, the decimal
// exponent of the first).
fn significant(x: f64, p: i64) -> (Vec[i64], i64) {
    if x == 0.0 {
        let mut z: Vec[i64] = Vec.new();
        for _ in 0..p {
            z.push(0);
        }
        return (z, 0);
    }
    let (d, e) = exact_decimal(x);
    let mut exp = d.len() + e - 1;
    let mut r = round_digits(d, p);
    if r.len() > p {
        r.pop();
        exp += 1;
    }
    (r, exp)
}

fn exp_text(e: i64, upper: bool) -> String {
    let mark = if upper { 'E' } else { 'e' };
    let sign = if e < 0 { '-' } else { '+' };
    let a = if e < 0 { -e } else { e };
    if a < 10 {
        f"{mark}{sign}0{a}"
    } else {
        f"{mark}{sign}{a}"
    }
}

// PyOS_double_to_string of x >= 0 for the types e, f, g and r.
fn float_body(x: f64, t: char, precision: i64, alt: bool, add_dot_0: bool) -> String {
    let upper = t == 'E' or t == 'F' or t == 'G';
    if x != x {
        return if upper { "NAN".to_string() } else { "nan".to_string() };
    }
    if x == f64.INFINITY {
        return if upper { "INF".to_string() } else { "inf".to_string() };
    }
    if t == 'f' or t == 'F' {
        return fixed_text(x, precision, alt);
    }
    if t == 'r' {
        let mut s = float_repr(x);
        if alt and not s.contains(".") {
            s = match s.find("e") {
                Some(k) => f"{s[0..k]}.{s[k..]}",
                None => f"{s}.",
            };
        }
        return s;
    }
    if t == 'e' or t == 'E' {
        let (d, e) = significant(x, precision + 1);
        let mut s = digit_text(d, 0, 1);
        if precision > 0 or alt {
            s.push('.');
        }
        s.push_str(digit_text(d, 1, d.len()));
        s.push_str(exp_text(e, upper));
        return s;
    }
    // 'g'
    let p = if precision == 0 { 1 } else { precision };
    let (d, e) = significant(x, p);
    let mut n = d.len();
    if not alt {
        while n > 1 and d[n - 1] == 0 {
            n -= 1;
        }
    }
    let decpt = e + 1;
    let limit = if add_dot_0 { p - 1 } else { p };
    let mut s = String.new();
    if decpt <= -4 or decpt > limit {
        s.push_str(digit_text(d, 0, 1));
        if n > 1 or alt {
            s.push('.');
        }
        s.push_str(digit_text(d, 1, n));
        s.push_str(exp_text(e, upper));
        return s;
    }
    if decpt <= 0 {
        s.push_str("0.");
        for _ in 0..(0 - decpt) {
            s.push('0');
        }
        s.push_str(digit_text(d, 0, n));
    } else if decpt >= n {
        s.push_str(digit_text(d, 0, n));
        for _ in 0..(decpt - n) {
            s.push('0');
        }
        if alt {
            s.push('.');
        }
    } else {
        s.push_str(digit_text(d, 0, decpt));
        s.push('.');
        s.push_str(digit_text(d, decpt, n));
    }
    if add_dot_0 and not s.contains(".") {
        s.push_str(".0");
    }
    s
}

// The digits of s[lo..hi] with Python's underscores: each '_' sits between
// two digits. None if anything else is there.
fn digits_with_underscores(v: ref Vec[char], lo: i64, hi: i64) -> Option[String] {
    let mut out = String.new();
    for k in lo..hi {
        let c = v[k];
        if is_digit(c) {
            out.push(c);
        } else if c == '_' and k > lo and k + 1 < hi and is_digit(v[k - 1]) and is_digit(v[k + 1]) {
            continue;
        } else {
            return None;
        }
    }
    Some(out)
}


// float(s), or None where it raises.
fn py_float(s: ref String) -> Option[f64] {
    let v = chars(py_strip(s));
    let mut i = 0;
    let mut neg = false;
    if i < v.len() and (v[i] == '+' or v[i] == '-') {
        neg = v[i] == '-';
        i += 1;
    }
    let rest = ascii_lower(text(slice(v, i, v.len())));
    if rest == "inf" or rest == "infinity" {
        return Some(if neg { -f64.INFINITY } else { f64.INFINITY });
    }
    if rest == "nan" {
        return Some(f64.NAN);
    }
    let n = v.len();
    let mut k = i;
    while k < n and (is_digit(v[k]) or v[k] == '_') {
        k += 1;
    }
    let int_part = digits_with_underscores(v, i, k)?;
    let mut frac_part = String.new();
    if k < n and v[k] == '.' {
        let f0 = k + 1;
        k += 1;
        while k < n and (is_digit(v[k]) or v[k] == '_') {
            k += 1;
        }
        frac_part = digits_with_underscores(v, f0, k)?;
    }
    if int_part.is_empty() and frac_part.is_empty() {
        return None;
    }
    let mut exp_part = "0".to_string();
    if k < n and (v[k] == 'e' or v[k] == 'E') {
        k += 1;
        let mut sign = String.new();
        if k < n and (v[k] == '+' or v[k] == '-') {
            sign.push(v[k]);
            k += 1;
        }
        let e0 = k;
        while k < n and (is_digit(v[k]) or v[k] == '_') {
            k += 1;
        }
        let e = digits_with_underscores(v, e0, k)?;
        if e.is_empty() {
            return None;
        }
        exp_part = f"{sign}{e}";
    }
    if k != n {
        return None;
    }
    let ip = if int_part.is_empty() { "0".to_string() } else { int_part };
    let fp = if frac_part.is_empty() { "0".to_string() } else { frac_part };
    let sign = if neg { "-" } else { "" };
    let lit = f"{sign}{ip}.{fp}e{exp_part}";
    match f64.parse(lit) {
        Ok(x) => Some(x),
        Err(_) => None,
    }
}

// ------------------------------------------------------------ UTF-8

fn is_cont(x: u8) -> bool {
    x >= 0x80 and x <= 0xBF
}

fn decode_error(b: ref Vec[u8], from: i64, to: i64, why: Str) -> Exc {
    if to - from == 1 {
        exc("UnicodeDecodeError", f"'utf-8' codec can't decode byte 0x{hex2(b[from] as i64)} in position {from}: {why}")
    } else {
        exc("UnicodeDecodeError", f"'utf-8' codec can't decode bytes in position {from}-{to - 1}: {why}")
    }
}

// The incremental UTF-8 decoder's decode(b, final): the text and how many
// bytes it used. A sequence cut off at the end waits for the next call
// unless final; any other bad byte is an error with CPython's message.
fn decode_utf8(b: ref Vec[u8], is_final: bool) -> Result[(String, i64), Exc] {
    let mut out = String.new();
    let n = b.len();
    let mut i = 0;
    while i < n {
        let x = b[i] as i64;
        if x < 0x80 {
            out.push(chr(x));
            i += 1;
            continue;
        }
        let need = if x >= 0xC2 and x <= 0xDF { 1 } else if x >= 0xE0 and x <= 0xEF { 2 } else if x >= 0xF0 and x <= 0xF4 { 3 } else { 0 };
        if need == 0 {
            return Err(decode_error(b, i, i + 1, "invalid start byte"));
        }
        let mut good = 0;
        let mut k = 1;
        while k <= need and i + k < n {
            let y = b[i + k];
            let ok = if k == 1 and x == 0xE0 {
                y >= 0xA0 and y <= 0xBF
            } else if k == 1 and x == 0xED {
                y >= 0x80 and y <= 0x9F
            } else if k == 1 and x == 0xF0 {
                y >= 0x90 and y <= 0xBF
            } else if k == 1 and x == 0xF4 {
                y >= 0x80 and y <= 0x8F
            } else {
                is_cont(y)
            };
            if not ok {
                break;
            }
            good += 1;
            k += 1;
        }
        if good == need {
            let mut cp = if need == 1 { x - 0xC0 } else if need == 2 { x - 0xE0 } else { x - 0xF0 };
            let mut j = 1;
            while j <= need {
                cp = cp * 64 + (b[i + j] as i64 - 0x80);
                j += 1;
            }
            out.push(chr(cp));
            i += need + 1;
            continue;
        }
        if i + 1 + good >= n {
            if not is_final {
                return Ok((out, i));
            }
            return Err(decode_error(b, i, n, "unexpected end of data"));
        }
        return Err(decode_error(b, i, i + 1 + good, "invalid continuation byte"));
    }
    Ok((out, n))
}



// ------------------------------------------------------------ reading

fn not_implemented() -> Exc {
    exc("NotImplementedError", String.new())
}

fn read_n(p: mut ref Proto, n: i64) -> Result[Vec[u8], Exc] {
    t_read_all(mut p.tr, n)
}

fn read_signed(p: mut ref Proto, w: i64) -> Result[i64, Exc] {
    let b = read_n(mut p, w)?;
    Ok(be_int(b))
}

fn read_ubyte(p: mut ref Proto) -> Result[i64, Exc] {
    let b = read_n(mut p, 1)?;
    Ok(b[0] as i64)
}

fn check_length(limit: i64, length: i64) -> Result[(), Exc] {
    if length < 0 {
        return Err(transport_error(f"Negative length: {length}"));
    }
    if limit >= 0 and length > limit {
        return Err(transport_error(f"Length exceeded max allowed: {limit}"));
    }
    Ok(())
}

fn read_varint(p: mut ref Proto) -> Result[u64, Exc] {
    let mut result: u64 = 0;
    let mut shift: u64 = 0;
    loop {
        let byte = read_ubyte(mut p)? as u64;
        if shift < 64 {
            result = result | ((byte & 0x7F) << shift);
        }
        if byte >> 7 == 0 {
            return Ok(result);
        }
        shift += 7;
    }
}

fn from_zigzag(n: u64) -> i64 {
    ((n >> 1) as i64) ^ (0 - ((n & 1) as i64))
}

// TTYPES[byte & 0x0f], a KeyError for 13 to 15.
fn ttype_of_compact(ct: i64) -> Result[i64, Exc] {
    if ct == 0 {
        Ok(T_STOP)
    } else if ct == 1 or ct == 2 {
        Ok(T_BOOL)
    } else if ct == 3 {
        Ok(T_BYTE)
    } else if ct == 4 {
        Ok(T_I16)
    } else if ct == 5 {
        Ok(T_I32)
    } else if ct == 6 {
        Ok(T_I64)
    } else if ct == 7 {
        Ok(T_DOUBLE)
    } else if ct == 8 {
        Ok(T_STRING)
    } else if ct == 9 {
        Ok(T_LIST)
    } else if ct == 10 {
        Ok(T_SET)
    } else if ct == 11 {
        Ok(T_MAP)
    } else if ct == 12 {
        Ok(T_STRUCT)
    } else {
        Err(exc("KeyError", f"{ct}"))
    }
}

// JTYPES[name]
fn ttype_of_json(name: ref String) -> Result[i64, Exc] {
    for t in [T_BOOL, T_BYTE, T_I16, T_I32, T_I64, T_DOUBLE, T_STRING, T_STRUCT, T_LIST, T_SET, T_MAP] {
        if json_type(t) == name {
            return Ok(t);
        }
    }
    Err(exc("KeyError", str_repr(name)))
}

// The compact protocol's `assert self.state in (...), self.state`.
fn compact_state(p: ref Proto, a: i64, b: i64) -> Result[(), Exc] {
    if p.state == a or p.state == b {
        Ok(())
    } else {
        Err(assertion(f"{p.state}"))
    }
}

// The @reader decorator's assertion.
fn compact_reader(p: ref Proto) -> Result[(), Exc] {
    if p.state == VALUE_READ or p.state == CONTAINER_READ {
        Ok(())
    } else {
        Err(assertion(f"({p.state}, {VALUE_READ}, {CONTAINER_READ})"))
    }
}

fn decode_strict(b: ref Vec[u8]) -> Result[String, Exc] {
    let (s, _) = decode_utf8(b, true)?;
    Ok(s)
}

// --- the JSON reader: LookaheadReader over trans.read(1)

fn read_one(p: mut ref Proto) -> Result[i64, Exc] {
    let b = t_read(mut p.tr, 1)?;
    if b.len() == 0 {
        Ok(-1)
    } else {
        Ok(b[0] as i64)
    }
}

fn reader_read(p: mut ref Proto) -> Result[i64, Exc] {
    if p.has_data {
        p.has_data = false;
    } else {
        p.data = read_one(mut p)?;
    }
    Ok(p.data)
}

fn reader_peek(p: mut ref Proto) -> Result[i64, Exc] {
    if not p.has_data {
        p.data = read_one(mut p)?;
    }
    p.has_data = true;
    Ok(p.data)
}

fn byte_repr(c: i64) -> String {
    let mut b: Vec[u8] = Vec.new();
    if c >= 0 {
        b.push(c as u8);
    }
    bytes_repr(b)
}

fn read_syntax(p: mut ref Proto, ch: u8) -> Result[(), Exc] {
    let cur = reader_read(mut p)?;
    if cur != ch as i64 {
        return Err(proto_error(f"Unexpected character: {byte_repr(cur)}"));
    }
    Ok(())
}

fn ord_error() -> Exc {
    type_error("ord() expected a character, but string of length 0 found".to_string())
}

fn ctx_read(p: mut ref Proto) -> Result[(), Exc] {
    let mut c = ctx_top(p);
    if c.kind == 1 {
        if c.first {
            c.first = false;
        } else {
            read_syntax(mut p, b',')?;
        }
    } else if c.kind == 2 {
        if c.first {
            c.first = false;
            c.colon = true;
        } else {
            read_syntax(mut p, if c.colon { b':' } else { b',' })?;
            c.colon = not c.colon;
        }
    }
    ctx_set(mut p, c);
    Ok(())
}

// int(s, 16): whitespace around, a sign, an optional 0x, and underscores
// between digits.
fn py_int16(s: ref String) -> Result[i64, Exc] {
    let bad = value_error(f"invalid literal for int() with base 16: {str_repr(s)}");
    let v = chars(py_strip(s));
    let mut i = 0;
    let mut neg = false;
    if i < v.len() and (v[i] == '+' or v[i] == '-') {
        neg = v[i] == '-';
        i += 1;
    }
    let mut after_prefix = false;
    if i + 1 < v.len() and v[i] == '0' and (v[i + 1] == 'x' or v[i + 1] == 'X') {
        i += 2;
        after_prefix = true;
    }
    let mut n = 0;
    let mut digits = 0;
    let mut prev_digit = after_prefix;
    while i < v.len() {
        let c = v[i];
        let h = hex_val(c);
        if h >= 0 {
            n = n * 16 + h;
            digits += 1;
            prev_digit = true;
        } else if c == '_' and prev_digit and i + 1 < v.len() and hex_val(v[i + 1]) >= 0 {
            prev_digit = false;
        } else {
            return Err(bad);
        }
        i += 1;
    }
    if digits == 0 {
        return Err(bad);
    }
    Ok(if neg { -n } else { n })
}

fn json_escape_value(c: i64) -> i64 {
    if c == b'"' as i64 or c == b'\\' as i64 or c == b'/' as i64 {
        c
    } else if c == b'b' as i64 {
        8
    } else if c == b'f' as i64 {
        12
    } else if c == b'n' as i64 {
        10
    } else if c == b'r' as i64 {
        13
    } else if c == b't' as i64 {
        9
    } else {
        -1
    }
}

fn chr_checked(n: i64) -> Result[String, Exc] {
    if n < 0 or n > 0x10FFFF {
        return Err(value_error("chr() arg not in range(0x110000)".to_string()));
    }
    Ok(chr(n).to_string())
}

// readJSONString(skipContext)
fn read_json_string(p: mut ref Proto, skip_context: bool) -> Result[String, Exc] {
    let mut high = -1;
    let mut out = String.new();
    if not skip_context {
        ctx_read(mut p)?;
    }
    read_syntax(mut p, b'"')?;
    loop {
        let ch = reader_read(mut p)?;
        if ch == b'"' as i64 {
            break;
        }
        if ch < 0 {
            return Err(ord_error());
        }
        let mut piece = String.new();
        if ch == b'\\' as i64 {
            let e = reader_read(mut p)?;
            if e < 0 {
                return Err(ord_error());
            }
            if e == b'u' as i64 {
                let raw = t_read(mut p.tr, 4)?;
                for k in 0..raw.len() {
                    if raw[k] >= 0x80 {
                        return Err(exc("UnicodeDecodeError", f"'ascii' codec can't decode byte 0x{hex2(raw[k] as i64)} in position {k}: ordinal not in range(128)"));
                    }
                }
                let code = py_int16(from_utf8_lossy(raw))?;
                if code >= 0xD800 and code <= 0xDBFF {
                    if high >= 0 {
                        return Err(proto_error("Expected low surrogate char".to_string()));
                    }
                    high = code;
                    continue;
                } else if code >= 0xDC00 and code <= 0xDFFF {
                    if high < 0 {
                        return Err(proto_error("Expected high surrogate char".to_string()));
                    }
                    piece = chr_checked(0x10000 + ((high & 0x3FF) << 10) + (code & 0x3FF))?;
                    high = -1;
                } else {
                    piece = chr_checked(code)?;
                }
            } else {
                let v = json_escape_value(e);
                if v < 0 {
                    return Err(proto_error("Expected control char".to_string()));
                }
                piece = chr(v).to_string();
            }
        } else {
            let mut group: Vec[u8] = Vec.new();
            group.push(ch as u8);
            loop {
                let pk = reader_peek(mut p)?;
                if pk < 0 {
                    return Err(ord_error());
                }
                if pk < 0x80 {
                    break;
                }
                let b = reader_read(mut p)?;
                group.push(b as u8);
            }
            piece = decode_strict(group)?;
        }
        out.push_str(piece);
        if high >= 0 {
            return Err(proto_error("Expected low surrogate char".to_string()));
        }
    }
    Ok(out)
}

fn is_numeric_char(c: i64) -> bool {
    c == b'+' as i64 or c == b'-' as i64 or c == b'.' as i64 or c == b'E' as i64 or c == b'e' as i64
        or (c >= b'0' as i64 and c <= b'9' as i64)
}

// readJSONNumericChars. (At the end of the input Python's loop never
// ends, since b'' is "found" in the numeric characters; it stops here.)
fn read_numeric_chars(p: mut ref Proto) -> Result[String, Exc] {
    let mut out = String.new();
    loop {
        let c = reader_peek(mut p)?;
        if c < 0 or not is_numeric_char(c) {
            return Ok(out);
        }
        let b = reader_read(mut p)?;
        out.push(chr(b));
    }
}

fn bad_numeric() -> Exc {
    proto_error("Bad data encounted in numeric data".to_string())
}

// int() of the numeric characters: a sign and digits.
fn json_int_value(s: ref String) -> Result[i64, Exc] {
    let cs = chars(s);
    let mut i = 0;
    if i < cs.len() and (cs[i] == '+' or cs[i] == '-') {
        i += 1;
    }
    if i >= cs.len() {
        return Err(bad_numeric());
    }
    while i < cs.len() {
        if not is_digit(cs[i]) {
            return Err(bad_numeric());
        }
        i += 1;
    }
    let digits = if starts_with(s, "+") { from_str(s, 1) } else { s.clone() };
    match i64.parse(digits) {
        Ok(n) => Ok(n),
        Err(_) => Err(bad_numeric()),
    }
}

fn read_json_quotes(p: mut ref Proto) -> Result[(), Exc] {
    if escape_num(p) {
        read_syntax(mut p, b'"')?;
    }
    Ok(())
}

fn read_json_integer(p: mut ref Proto) -> Result[i64, Exc] {
    ctx_read(mut p)?;
    read_json_quotes(mut p)?;
    let numeric = read_numeric_chars(mut p)?;
    read_json_quotes(mut p)?;
    json_int_value(numeric)
}

// readJSONDouble: a quoted double is accepted anywhere (the library's
// check against that compares a method with False), and float() parses
// it, inf and nan included.
fn read_json_double(p: mut ref Proto) -> Result[f64, Exc] {
    ctx_read(mut p)?;
    if reader_peek(mut p)? == b'"' as i64 {
        let s = read_json_string(mut p, true)?;
        return match py_float(s) {
            Some(x) => Ok(x),
            None => Err(bad_numeric()),
        };
    }
    if escape_num(p) {
        read_syntax(mut p, b'"')?;
    }
    let numeric = read_numeric_chars(mut p)?;
    match py_float(numeric) {
        Some(x) => Ok(x),
        None => Err(bad_numeric()),
    }
}

fn read_json_base64(p: mut ref Proto) -> Result[Vec[u8], Exc] {
    let mut s = read_json_string(mut p, false)?;
    let size = s.chars().count();
    let rem = size % 4;
    if rem != 0 {
        for _ in 0..(4 - rem) {
            s.push('=');
        }
    }
    b64decode(s)
}

fn json_object_start_read(p: mut ref Proto) -> Result[(), Exc] {
    ctx_read(mut p)?;
    read_syntax(mut p, b'{')?;
    push_ctx(mut p, 2);
    Ok(())
}

fn json_object_end_read(p: mut ref Proto) -> Result[(), Exc] {
    read_syntax(mut p, b'}')?;
    pop_ctx(mut p);
    Ok(())
}

fn json_array_start_read(p: mut ref Proto) -> Result[(), Exc] {
    ctx_read(mut p)?;
    read_syntax(mut p, b'[')?;
    push_ctx(mut p, 1);
    Ok(())
}

fn json_array_end_read(p: mut ref Proto) -> Result[(), Exc] {
    read_syntax(mut p, b']')?;
    pop_ctx(mut p);
    Ok(())
}

// --- the generic reads

fn read_binary_raw(p: mut ref Proto) -> Result[Vec[u8], Exc] {
    let size = if p.kind == P_BINARY { read_signed(mut p, 4)? } else { read_varint(mut p)? as i64 };
    check_length(p.slim, size)?;
    read_n(mut p, size)
}

fn read_message_begin(p: mut ref Proto) -> Result[(String, i64, i64), Exc] {
    if p.kind == P_BINARY {
        let sz = read_signed(mut p, 4)?;
        if sz < 0 {
            if (sz & -65536) != -2147418112 {
                return Err(proto_error(f"Bad version in readMessageBegin: {sz}"));
            }
            let mtype = sz & 0xFF;
            let name = read_string(mut p)?;
            let seqid = read_signed(mut p, 4)?;
            return Ok((name, mtype, seqid));
        }
        if p.strict_read {
            return Err(proto_error("No protocol version header".to_string()));
        }
        let raw = read_n(mut p, sz)?;
        let name = decode_strict(raw)?;
        let mtype = read_signed(mut p, 1)?;
        let seqid = read_signed(mut p, 4)?;
        return Ok((name, mtype, seqid));
    }
    if p.kind == P_COMPACT {
        if p.state != CLEAR {
            return Err(assertion(String.new()));
        }
        let proto_id = read_ubyte(mut p)?;
        if proto_id != 0x82 {
            return Err(proto_error(f"Bad protocol id in the message: {proto_id}"));
        }
        let ver_type = read_ubyte(mut p)?;
        let mtype = (ver_type >> 5) & 7;
        let version = ver_type & 0x1F;
        if version != 1 {
            return Err(proto_error(f"Bad version: {version} (expect 1)"));
        }
        let mut seqid = read_varint(mut p)? as i64;
        if seqid > 2147483647 {
            seqid -= 4294967296;
        }
        let raw = read_binary_raw(mut p)?;
        let name = decode_strict(raw)?;
        return Ok((name, mtype, seqid));
    }
    if p.kind == P_SJSON {
        return Err(not_implemented());
    }
    reset_write_context(mut p);
    p.has_data = false;
    p.data = -1;
    json_array_start_read(mut p)?;
    if read_json_integer(mut p)? != 1 {
        return Err(proto_error("Message contained bad version.".to_string()));
    }
    let name = read_json_string(mut p, false)?;
    let mtype = read_json_integer(mut p)?;
    let seqid = read_json_integer(mut p)?;
    Ok((name, mtype, seqid))
}

fn read_message_end(p: mut ref Proto) -> Result[(), Exc] {
    if p.kind == P_COMPACT {
        if p.state != CLEAR or p.st_state.len() != 0 {
            return Err(assertion(String.new()));
        }
    } else if p.kind == P_JSON {
        json_array_end_read(mut p)?;
    } else if p.kind == P_SJSON {
        return Err(not_implemented());
    }
    Ok(())
}

fn read_struct_begin(p: mut ref Proto) -> Result[(), Exc] {
    if p.kind == P_COMPACT {
        if p.state != CLEAR and p.state != CONTAINER_READ and p.state != VALUE_READ {
            return Err(assertion(f"{p.state}"));
        }
        p.st_state.push(p.state);
        p.st_fid.push(p.last_fid);
        p.state = FIELD_READ;
        p.last_fid = 0;
    } else if p.kind == P_JSON {
        json_object_start_read(mut p)?;
    } else if p.kind == P_SJSON {
        return Err(not_implemented());
    }
    Ok(())
}

fn read_struct_end(p: mut ref Proto) -> Result[(), Exc] {
    if p.kind == P_COMPACT {
        if p.state != FIELD_READ {
            return Err(assertion(String.new()));
        }
        p.state = p.st_state.pop().unwrap_or(CLEAR);
        p.last_fid = p.st_fid.pop().unwrap_or(0);
    } else if p.kind == P_JSON {
        json_object_end_read(mut p)?;
    } else if p.kind == P_SJSON {
        return Err(not_implemented());
    }
    Ok(())
}

// readFieldBegin: (ttype, fid), ttype T_STOP at the end.
fn read_field_begin(p: mut ref Proto) -> Result[(i64, i64), Exc] {
    if p.kind == P_BINARY {
        let t = read_signed(mut p, 1)?;
        if t == T_STOP {
            return Ok((T_STOP, 0));
        }
        let fid = read_signed(mut p, 2)?;
        return Ok((t, fid));
    }
    if p.kind == P_COMPACT {
        if p.state != FIELD_READ {
            return Err(assertion(f"{p.state}"));
        }
        let b = read_ubyte(mut p)?;
        if b & 0x0F == 0 {
            return Ok((T_STOP, 0));
        }
        let delta = b >> 4;
        let fid = if delta == 0 { from_zigzag(read_varint(mut p)?) } else { p.last_fid + delta };
        p.last_fid = fid;
        let ct = b & 0x0F;
        if ct == 1 {
            p.state = BOOL_READ;
            p.bool_value = true;
        } else if ct == 2 {
            p.state = BOOL_READ;
            p.bool_value = false;
        } else {
            p.state = VALUE_READ;
        }
        let t = ttype_of_compact(ct)?;
        return Ok((t, fid));
    }
    let c = reader_peek(mut p)?;
    if c == b'}' as i64 {
        return Ok((T_STOP, 0));
    }
    let fid = read_json_integer(mut p)?;
    json_object_start_read(mut p)?;
    let name = read_json_string(mut p, false)?;
    let t = ttype_of_json(name)?;
    Ok((t, fid))
}

fn read_field_end(p: mut ref Proto) -> Result[(), Exc] {
    if p.kind == P_COMPACT {
        compact_state(p, VALUE_READ, BOOL_READ)?;
        p.state = FIELD_READ;
    } else if is_json(p) {
        json_object_end_read(mut p)?;
    }
    Ok(())
}

// readListBegin / readSetBegin: (element ttype, size).
fn read_collection_begin(p: mut ref Proto) -> Result[(i64, i64), Exc] {
    if p.kind == P_BINARY {
        let et = read_signed(mut p, 1)?;
        let size = read_signed(mut p, 4)?;
        check_length(p.clim, size)?;
        return Ok((et, size));
    }
    if p.kind == P_COMPACT {
        compact_state(p, VALUE_READ, CONTAINER_READ)?;
        let st = read_ubyte(mut p)?;
        let mut size = st >> 4;
        let et = ttype_of_compact(st & 0x0F)?;
        if size == 15 {
            size = read_varint(mut p)? as i64;
        }
        check_length(p.clim, size)?;
        p.containers.push(p.state);
        p.state = CONTAINER_READ;
        return Ok((et, size));
    }
    json_array_start_read(mut p)?;
    let name = read_json_string(mut p, false)?;
    let et = ttype_of_json(name)?;
    let size = read_json_integer(mut p)?;
    Ok((et, size))
}

fn read_collection_end(p: mut ref Proto) -> Result[(), Exc] {
    if p.kind == P_COMPACT {
        if p.state != CONTAINER_READ {
            return Err(assertion(f"{p.state}"));
        }
        p.state = p.containers.pop().unwrap_or(CLEAR);
    } else if is_json(p) {
        json_array_end_read(mut p)?;
    }
    Ok(())
}

fn read_map_begin(p: mut ref Proto) -> Result[(i64, i64, i64), Exc] {
    if p.kind == P_BINARY {
        let kt = read_signed(mut p, 1)?;
        let vt = read_signed(mut p, 1)?;
        let size = read_signed(mut p, 4)?;
        check_length(p.clim, size)?;
        return Ok((kt, vt, size));
    }
    if p.kind == P_COMPACT {
        compact_state(p, VALUE_READ, CONTAINER_READ)?;
        let size = read_varint(mut p)? as i64;
        check_length(p.clim, size)?;
        let types = if size > 0 { read_ubyte(mut p)? } else { 0 };
        let vt = ttype_of_compact(types & 0x0F)?;
        let kt = ttype_of_compact((types >> 4) & 0x0F)?;
        p.containers.push(p.state);
        p.state = CONTAINER_READ;
        return Ok((kt, vt, size));
    }
    json_array_start_read(mut p)?;
    let kname = read_json_string(mut p, false)?;
    let kt = ttype_of_json(kname)?;
    let vname = read_json_string(mut p, false)?;
    let vt = ttype_of_json(vname)?;
    let size = read_json_integer(mut p)?;
    json_object_start_read(mut p)?;
    Ok((kt, vt, size))
}

fn read_map_end(p: mut ref Proto) -> Result[(), Exc] {
    if p.kind == P_COMPACT {
        return read_collection_end(mut p);
    }
    if is_json(p) {
        json_object_end_read(mut p)?;
        json_array_end_read(mut p)?;
    }
    Ok(())
}

fn read_bool(p: mut ref Proto) -> Result[bool, Exc] {
    if p.kind == P_BINARY {
        return Ok(read_signed(mut p, 1)? != 0);
    }
    if p.kind == P_COMPACT {
        if p.state == BOOL_READ {
            return Ok(p.bool_value);
        }
        if p.state == CONTAINER_READ {
            return Ok(read_signed(mut p, 1)? == 1);
        }
        return Err(assertion(f"Invalid state in compact protocol: {p.state}"));
    }
    Ok(read_json_integer(mut p)? != 0)
}

fn read_int(p: mut ref Proto, bits: i64) -> Result[i64, Exc] {
    if p.kind == P_BINARY {
        return read_signed(mut p, bits / 8);
    }
    if p.kind == P_COMPACT {
        compact_reader(p)?;
        if bits == 8 {
            return read_signed(mut p, 1);
        }
        return Ok(from_zigzag(read_varint(mut p)?));
    }
    read_json_integer(mut p)
}

fn read_double(p: mut ref Proto) -> Result[f64, Exc] {
    if p.kind == P_BINARY {
        let b = read_n(mut p, 8)?;
        return Ok(f64_of_be(b));
    }
    if p.kind == P_COMPACT {
        compact_reader(p)?;
        let mut b = read_n(mut p, 8)?;
        b.reverse();
        return Ok(f64_of_be(b));
    }
    read_json_double(mut p)
}

fn read_binary(p: mut ref Proto) -> Result[Vec[u8], Exc] {
    if is_json(p) {
        return read_json_base64(mut p);
    }
    if p.kind == P_COMPACT {
        compact_reader(p)?;
    }
    read_binary_raw(mut p)
}

fn read_string(p: mut ref Proto) -> Result[String, Exc] {
    if is_json(p) {
        return read_json_string(mut p, false);
    }
    let b = read_binary(mut p)?;
    decode_strict(b)
}

// TProtocolBase.skip
fn skip(p: mut ref Proto, t: i64) -> Result[(), Exc] {
    if t == T_BOOL {
        let _ = read_bool(mut p)?;
    } else if t == T_BYTE {
        let _ = read_int(mut p, 8)?;
    } else if t == T_I16 {
        let _ = read_int(mut p, 16)?;
    } else if t == T_I32 {
        let _ = read_int(mut p, 32)?;
    } else if t == T_I64 {
        let _ = read_int(mut p, 64)?;
    } else if t == T_DOUBLE {
        let _ = read_double(mut p)?;
    } else if t == T_STRING {
        let _ = read_string(mut p)?;
    } else if t == T_STRUCT {
        read_struct_begin(mut p)?;
        loop {
            let (ft, _) = read_field_begin(mut p)?;
            if ft == T_STOP {
                break;
            }
            skip(mut p, ft)?;
            read_field_end(mut p)?;
        }
        read_struct_end(mut p)?;
    } else if t == T_MAP {
        let (kt, vt, size) = read_map_begin(mut p)?;
        for _ in 0..size {
            skip(mut p, kt)?;
            skip(mut p, vt)?;
        }
        read_map_end(mut p)?;
    } else if t == T_SET or t == T_LIST {
        let (et, size) = read_collection_begin(mut p)?;
        for _ in 0..size {
            skip(mut p, et)?;
        }
        read_collection_end(mut p)?;
    } else {
        return Err(proto_error("invalid TType".to_string()));
    }
    Ok(())
}

fn islice_error() -> Exc {
    value_error("Stop argument for islice() must be None or an integer: 0 <= x <= sys.maxsize.".to_string())
}

// readFieldByTType: the value as the spec's type, whatever element types
// the wire names.
fn read_val(m: ref Model, p: mut ref Proto, ty: i64) -> Result[Val, Exc] {
    let t = m.tys[ty].t;
    if t == T_BOOL {
        Ok(Val.Bool(read_bool(mut p)?))
    } else if t == T_BYTE {
        Ok(Val.Int(read_int(mut p, 8)?))
    } else if t == T_I16 {
        Ok(Val.Int(read_int(mut p, 16)?))
    } else if t == T_I32 {
        Ok(Val.Int(read_int(mut p, 32)?))
    } else if t == T_I64 {
        Ok(Val.Int(read_int(mut p, 64)?))
    } else if t == T_DOUBLE {
        Ok(Val.Float(read_double(mut p)?))
    } else if t == T_STRING {
        if m.tys[ty].bin {
            Ok(Val.Bytes(read_binary(mut p)?))
        } else {
            Ok(Val.Str(read_string(mut p)?))
        }
    } else if t == T_STRUCT {
        read_obj(m, mut p, m.tys[ty].cls)
    } else if t == T_LIST {
        let (_, size) = read_collection_begin(mut p)?;
        if size < 0 {
            return Err(islice_error());
        }
        let et = m.tys[ty].a;
        let mut items: Vec[Val] = Vec.new();
        for _ in 0..size {
            items.push(read_val(m, mut p, et)?);
        }
        read_collection_end(mut p)?;
        Ok(Val.List(items))
    } else if t == T_SET {
        let (_, size) = read_collection_begin(mut p)?;
        if size < 0 {
            return Err(islice_error());
        }
        let et = m.tys[ty].a;
        let mut items: Vec[Val] = Vec.new();
        for _ in 0..size {
            let x = read_val(m, mut p, et)?;
            if not is_hashable(x) {
                return Err(type_error(f"unhashable type: '{type_name(m, x)}'"));
            }
            set_add(mut items, x);
        }
        read_collection_end(mut p)?;
        Ok(Val.Set(items))
    } else {
        let (_, _, size) = read_map_begin(mut p)?;
        if size < 0 {
            return Err(islice_error());
        }
        let kt = m.tys[ty].a;
        let vt = m.tys[ty].b;
        let mut ks: Vec[Val] = Vec.new();
        let mut vs: Vec[Val] = Vec.new();
        for _ in 0..size {
            let k = read_val(m, mut p, kt)?;
            let v = read_val(m, mut p, vt)?;
            if not is_hashable(k) {
                return Err(type_error(f"unhashable type: '{type_name(m, k)}'"));
            }
            dict_set(mut ks, mut vs, k, v);
        }
        read_map_end(mut p)?;
        Ok(Val.Dict(ks, vs))
    }
}

// obj.read(iprot): readStruct, which looks a field up with Python
// indexing (a negative id counts from the end, one past it is skipped)
// and skips a field whose wire type is not the spec's.
fn read_obj(m: ref Model, p: mut ref Proto, cls: i64) -> Result[Val, Exc] {
    let mut obj = empty_obj(m, cls);
    read_struct_begin(mut p)?;
    let n = m.classes[cls].spec.len();
    loop {
        let (ft, fid) = read_field_begin(mut p)?;
        if ft == T_STOP {
            break;
        }
        let mut idx = fid;
        if idx < 0 {
            idx += n;
        }
        if idx < 0 or idx >= n {
            skip(mut p, ft)?;
        } else {
            let fi = m.classes[cls].spec[idx];
            if fi < 0 or ft != m.tys[m.classes[cls].fields[fi].ty].t {
                skip(mut p, ft)?;
            } else {
                let f = m.classes[cls].fields[fi].clone();
                let v = read_val(m, mut p, f.ty)?;
                set_attr(m, mut obj, f.name, v);
            }
        }
        read_field_end(mut p)?;
    }
    read_struct_end(mut p)?;
    Ok(obj)
}

// ------------------------------------------------------------ the schema-less dump

fn walk(p: mut ref Proto, t: i64, depth: i64, lines: mut ref Vec[String], label: ref String) -> Result[(), Exc] {
    let mut pad = String.new();
    for _ in 0..depth {
        pad.push_str("  ");
    }
    if t == T_STRUCT {
        lines.push(f"{pad}{label}struct");
        read_struct_begin(mut p)?;
        loop {
            let (ft, fid) = read_field_begin(mut p)?;
            if ft == T_STOP {
                break;
            }
            walk(mut p, ft, depth + 1, mut lines, f"{fid}: ")?;
            read_field_end(mut p)?;
        }
        read_struct_end(mut p)?;
    } else if t == T_LIST or t == T_SET {
        let (et, n) = read_collection_begin(mut p)?;
        lines.push(f"{pad}{label}{tname(t)}<{tname(et)}> {n}");
        for i in 0..n {
            walk(mut p, et, depth + 1, mut lines, f"[{i}] ")?;
        }
        read_collection_end(mut p)?;
    } else if t == T_MAP {
        let (kt, vt, n) = read_map_begin(mut p)?;
        lines.push(f"{pad}{label}map<{tname(kt)},{tname(vt)}> {n}");
        for _ in 0..n {
            walk(mut p, kt, depth + 1, mut lines, "key ".to_string())?;
            walk(mut p, vt, depth + 1, mut lines, "val ".to_string())?;
        }
        read_map_end(mut p)?;
    } else if t == T_STRING and is_json(p) {
        let s = read_string(mut p)?;
        lines.push(f"{pad}{label}string {str_repr(s)}");
    } else if t == T_STRING {
        let b = read_binary(mut p)?;
        match decode_utf8(b, true) {
            Ok((s, _)) => lines.push(f"{pad}{label}string {str_repr(s)}"),
            Err(_) => lines.push(f"{pad}{label}binary {hex_of(b)}"),
        }
    } else if t == T_BOOL {
        let b = read_bool(mut p)?;
        lines.push(f"{pad}{label}bool {if b { "True" } else { "False" }}");
    } else if t == T_BYTE {
        lines.push(f"{pad}{label}byte {read_int(mut p, 8)?}");
    } else if t == T_I16 {
        lines.push(f"{pad}{label}i16 {read_int(mut p, 16)?}");
    } else if t == T_I32 {
        lines.push(f"{pad}{label}i32 {read_int(mut p, 32)?}");
    } else if t == T_I64 {
        lines.push(f"{pad}{label}i64 {read_int(mut p, 64)?}");
    } else if t == T_DOUBLE {
        lines.push(f"{pad}{label}double {float_repr(read_double(mut p)?)}");
    } else {
        return Err(value_error(f"cannot dump type {t}"));
    }
    Ok(())
}

// ------------------------------------------------------------ files

fn read_file(path: ref String) -> Result[Vec[u8], Exc] {
    match fs.read_bytes(path.clone()) {
        Ok(b) => Ok(b),
        Err(_) => Err(not_found(path)),
    }
}

fn read_text(path: ref String) -> Result[String, Exc] {
    match fs.read_to_string(path.clone()) {
        Ok(s) => Ok(s),
        Err(_) => Err(not_found(path)),
    }
}

fn write_file(path: ref String, b: ref Vec[u8]) -> Result[(), Exc] {
    match fs.write_bytes(path.clone(), b.clone()) {
        Ok(_) => Ok(()),
        Err(e) => Err(exc("OSError", f"{e}")),
    }
}

fn out(s: ref String) {
    println(f"  {s}");
}

fn tf(b: bool) -> String {
    if b {
        "True".to_string()
    } else {
        "False".to_string()
    }
}

// int(s)
fn py_int(s: ref String) -> Result[i64, Exc] {
    let t = py_strip(s);
    let body = if starts_with(t, "+") { from_str(t, 1) } else { t.clone() };
    match i64.parse(body) {
        Ok(n) => Ok(n),
        Err(_) => Err(value_error(f"invalid literal for int() with base 10: {str_repr(s)}")),
    }
}

// int(s, 16)
fn py_int16_arg(s: ref String) -> Result[i64, Exc] {
    let cs = chars(py_strip(s));
    if cs.len() == 0 {
        return Err(value_error(f"invalid literal for int() with base 16: {str_repr(s)}"));
    }
    let mut n = 0;
    for c in cs {
        let v = hex_val(c);
        if v < 0 {
            return Err(value_error(f"invalid literal for int() with base 16: {str_repr(s)}"));
        }
        n = n * 16 + v;
    }
    Ok(n)
}

// ------------------------------------------------------------ job literals

// The jobs write their values as Python literals: numbers, strings and
// bytes, lists, dicts, True / False / None, inf and nan, Enum.MEMBER, and
// generated classes called with positional and keyword arguments.
struct LitParser {
    cs: Vec[char],
    i: i64,
}

fn bad_literal() -> Exc {
    value_error("bad literal".to_string())
}

fn lp_at(p: ref LitParser) -> char {
    if p.i < p.cs.len() {
        p.cs[p.i]
    } else {
        '\0'
    }
}

fn lp_ws(p: mut ref LitParser) {
    while p.i < p.cs.len() and py_space(p.cs[p.i]) {
        p.i += 1;
    }
}

fn lp_ident(p: mut ref LitParser) -> String {
    let start = p.i;
    while p.i < p.cs.len() and (is_alnum(p.cs[p.i]) or p.cs[p.i] == '_') {
        p.i += 1;
    }
    text(slice(p.cs, start, p.i))
}

fn lit(m: ref Model, s: ref String) -> Result[Val, Exc] {
    let mut p = LitParser { cs: chars(s), i: 0 };
    let v = lit_expr(m, mut p)?;
    lp_ws(mut p);
    if p.i != p.cs.len() {
        return Err(bad_literal());
    }
    Ok(v)
}

fn lit_number(p: mut ref LitParser, neg: bool) -> Result[Val, Exc] {
    let start = p.i;
    let mut is_float = false;
    while p.i < p.cs.len() {
        let c = p.cs[p.i];
        if is_digit(c) or c == '_' {
            p.i += 1;
        } else if c == '.' {
            is_float = true;
            p.i += 1;
        } else if c == 'e' or c == 'E' {
            is_float = true;
            p.i += 1;
            if p.i < p.cs.len() and (p.cs[p.i] == '+' or p.cs[p.i] == '-') {
                p.i += 1;
            }
        } else {
            break;
        }
    }
    let mut t = text(slice(p.cs, start, p.i));
    if neg {
        t = f"-{t}";
    }
    if is_float {
        match py_float(t) {
            Some(x) => Ok(Val.Float(x)),
            None => Err(bad_literal()),
        }
    } else {
        match i64.parse(t) {
            Ok(n) => Ok(Val.Int(n)),
            Err(_) => Err(bad_literal()),
        }
    }
}

fn lit_hex(p: mut ref LitParser, k: i64) -> Result[i64, Exc] {
    let mut n = 0;
    for _ in 0..k {
        if p.i >= p.cs.len() {
            return Err(bad_literal());
        }
        let v = hex_val(p.cs[p.i]);
        if v < 0 {
            return Err(bad_literal());
        }
        n = n * 16 + v;
        p.i += 1;
    }
    Ok(n)
}

fn lit_string(p: mut ref LitParser, bytes: bool) -> Result[Val, Exc] {
    let q = p.cs[p.i];
    p.i += 1;
    let mut codes: Vec[i64] = Vec.new();
    loop {
        if p.i >= p.cs.len() {
            return Err(bad_literal());
        }
        let c = p.cs[p.i];
        p.i += 1;
        if c == q {
            break;
        }
        if c != '\\' {
            codes.push(c as i64);
            continue;
        }
        if p.i >= p.cs.len() {
            return Err(bad_literal());
        }
        let e = p.cs[p.i];
        p.i += 1;
        if e == 'n' {
            codes.push(10);
        } else if e == 't' {
            codes.push(9);
        } else if e == 'r' {
            codes.push(13);
        } else if e == '0' {
            codes.push(0);
        } else if e == '\\' or e == '\'' or e == '"' {
            codes.push(e as i64);
        } else if e == 'x' {
            codes.push(lit_hex(mut p, 2)?);
        } else if e == 'u' and not bytes {
            codes.push(lit_hex(mut p, 4)?);
        } else {
            codes.push(92);
            codes.push(e as i64);
        }
    }
    if bytes {
        let mut b: Vec[u8] = Vec.new();
        for c in codes {
            b.push(c as u8);
        }
        Ok(Val.Bytes(b))
    } else {
        let mut s = String.new();
        for c in codes {
            s.push(chr(c));
        }
        Ok(Val.Str(s))
    }
}

fn negate(v: own Val) -> Result[Val, Exc] {
    match v {
        Val.Int(n) => Ok(Val.Int(-n)),
        Val.Bool(b) => Ok(Val.Int(if b { -1 } else { 0 })),
        Val.Float(x) => Ok(Val.Float(-x)),
        _ => Err(bad_literal()),
    }
}

fn enum_member(m: ref Model, name: ref String, member: ref String) -> Result[Val, Exc] {
    for e in 0..m.enum_names.len() {
        if m.enum_names[e] == name {
            for k in 0..m.enum_members[e].len() {
                if m.enum_members[e][k] == member {
                    return Ok(Val.Int(m.enum_values[e][k]));
                }
            }
            return Err(exc("AttributeError", f"type object '{name}' has no attribute '{member}'"));
        }
    }
    Err(exc("KeyError", str_repr(name)))
}

fn lit_call(m: ref Model, p: mut ref LitParser, name: ref String) -> Result[Val, Exc] {
    p.i += 1;
    let mut args: Vec[Val] = Vec.new();
    let mut kw_names: Vec[String] = Vec.new();
    let mut kw_vals: Vec[Val] = Vec.new();
    loop {
        lp_ws(mut p);
        if lp_at(p) == ')' {
            p.i += 1;
            break;
        }
        let save = p.i;
        let mut keyword = false;
        if is_alpha(lp_at(p)) or lp_at(p) == '_' {
            let k = lp_ident(mut p);
            lp_ws(mut p);
            if lp_at(p) == '=' and (p.i + 1 >= p.cs.len() or p.cs[p.i + 1] != '=') {
                p.i += 1;
                keyword = true;
                kw_names.push(k);
                kw_vals.push(lit_expr(m, mut p)?);
            } else {
                p.i = save;
            }
        }
        if not keyword {
            args.push(lit_expr(m, mut p)?);
        }
        lp_ws(mut p);
        if lp_at(p) == ',' {
            p.i += 1;
        } else if lp_at(p) == ')' {
            p.i += 1;
            break;
        } else {
            return Err(bad_literal());
        }
    }
    let cls = class_id(m, name);
    if cls < 0 {
        return Err(exc("KeyError", str_repr(name)));
    }
    new_obj(m, cls, args, kw_names, kw_vals)
}

fn lit_expr(m: ref Model, p: mut ref LitParser) -> Result[Val, Exc] {
    lp_ws(mut p);
    if p.i >= p.cs.len() {
        return Err(bad_literal());
    }
    let c = p.cs[p.i];
    if c == '-' {
        p.i += 1;
        lp_ws(mut p);
        if is_digit(lp_at(p)) or lp_at(p) == '.' {
            return lit_number(mut p, true);
        }
        let v = lit_expr(m, mut p)?;
        return negate(v);
    }
    if is_digit(c) or c == '.' {
        return lit_number(mut p, false);
    }
    if c == '\'' or c == '"' {
        return lit_string(mut p, false);
    }
    if c == '[' {
        p.i += 1;
        let mut items: Vec[Val] = Vec.new();
        loop {
            lp_ws(mut p);
            if lp_at(p) == ']' {
                p.i += 1;
                break;
            }
            items.push(lit_expr(m, mut p)?);
            lp_ws(mut p);
            if lp_at(p) == ',' {
                p.i += 1;
            } else if lp_at(p) == ']' {
                p.i += 1;
                break;
            } else {
                return Err(bad_literal());
            }
        }
        return Ok(Val.List(items));
    }
    if c == '{' {
        p.i += 1;
        let mut ks: Vec[Val] = Vec.new();
        let mut vs: Vec[Val] = Vec.new();
        loop {
            lp_ws(mut p);
            if lp_at(p) == '}' {
                p.i += 1;
                break;
            }
            let k = lit_expr(m, mut p)?;
            lp_ws(mut p);
            if lp_at(p) != ':' {
                return Err(bad_literal());
            }
            p.i += 1;
            let v = lit_expr(m, mut p)?;
            if not is_hashable(k) {
                return Err(type_error(f"unhashable type: '{type_name(m, k)}'"));
            }
            dict_set(mut ks, mut vs, k, v);
            lp_ws(mut p);
            if lp_at(p) == ',' {
                p.i += 1;
            } else if lp_at(p) == '}' {
                p.i += 1;
                break;
            } else {
                return Err(bad_literal());
            }
        }
        return Ok(Val.Dict(ks, vs));
    }
    if is_alpha(c) or c == '_' {
        let name = lp_ident(mut p);
        if (name == "b" or name == "B") and (lp_at(p) == '\'' or lp_at(p) == '"') {
            return lit_string(mut p, true);
        }
        if name == "True" {
            return Ok(Val.Bool(true));
        }
        if name == "False" {
            return Ok(Val.Bool(false));
        }
        if name == "None" {
            return Ok(Val.Non);
        }
        if lp_at(p) == '.' {
            p.i += 1;
            let member = lp_ident(mut p);
            return enum_member(m, name, member);
        }
        if lp_at(p) == '(' {
            return lit_call(m, mut p, name);
        }
        if name == "inf" {
            return Ok(Val.Float(f64.INFINITY));
        }
        if name == "nan" {
            return Ok(Val.Float(f64.NAN));
        }
        return Err(value_error(f"unknown name {name}"));
    }
    Err(bad_literal())
}

// ------------------------------------------------------------ payloads

// spec[2:].encode("utf-8").decode("unicode_escape").encode("latin-1")
fn unicode_escape(b: ref Vec[u8]) -> Result[Vec[u8], Exc] {
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i];
        i += 1;
        if c != b'\\' or i >= b.len() {
            out.push(c);
            continue;
        }
        let e = b[i];
        i += 1;
        if e == b'\\' or e == b'\'' or e == b'"' {
            out.push(e);
        } else if e == b'n' {
            out.push(10);
        } else if e == b't' {
            out.push(9);
        } else if e == b'r' {
            out.push(13);
        } else if e == b'x' {
            let mut n = 0;
            for _ in 0..2 {
                let v = if i < b.len() { hex_val(b[i] as char) } else { -1 };
                if v < 0 {
                    return Err(exc("UnicodeDecodeError", "'unicodeescape' codec can't decode bytes: truncated \\xXX escape".to_string()));
                }
                n = n * 16 + v;
                i += 1;
            }
            out.push(n as u8);
        } else if e == b'\n' {
            continue;
        } else {
            out.push(b'\\');
            out.push(e);
        }
    }
    Ok(out)
}

// x:<hex> is bytes, t:<text> text with \xNN escapes, @path a file.
fn payload(spec: ref String) -> Result[Vec[u8], Exc] {
    if starts_with(spec, "x:") {
        return Ok(hex_bytes(from_str(spec, 2)));
    }
    if starts_with(spec, "t:") {
        return unicode_escape(utf8_of(from_str(spec, 2)));
    }
    if starts_with(spec, "@") {
        return read_file(from_str(spec, 1));
    }
    Err(value_error("bad payload".to_string()))
}

fn is_text(proto: ref String) -> bool {
    proto == "json" or proto == "sjson"
}

fn wire(proto: ref String, b: ref Vec[u8]) -> String {
    if is_text(proto) {
        bytes_repr(b)
    } else if b.len() == 0 {
        "(empty)".to_string()
    } else {
        hex_of(b)
    }
}

fn encode(m: ref Model, proto: ref String, obj: ref Val, slim: i64, clim: i64) -> Result[Vec[u8], Exc] {
    let mut p = proto_new(proto, trans_new(TR_PLAIN, Vec.new()), slim, clim)?;
    write_obj(m, mut p, obj)?;
    Ok(p.tr.out.clone())
}

fn decode(m: ref Model, proto: ref String, cname: ref String, data: ref Vec[u8], slim: i64, clim: i64) -> Result[(Val, i64), Exc] {
    let cls = class_id(m, cname);
    if cls < 0 {
        return Err(exc("KeyError", str_repr(cname)));
    }
    let mut p = proto_new(proto, trans_new(TR_PLAIN, data.clone()), slim, clim)?;
    let obj = read_obj(m, mut p, cls)?;
    Ok((obj, data.len() - p.tr.pos))
}

// A fresh protocol object over the same transport.
fn proto_reset(p: mut ref Proto) {
    p.state = CLEAR;
    p.last_fid = 0;
    p.bool_fid = 0;
    p.bool_value = false;
    p.st_state = Vec.new();
    p.st_fid = Vec.new();
    p.containers = Vec.new();
    let mut ctxs: Vec[Ctx] = Vec.new();
    ctxs.push(Ctx { kind: 0, first: true, colon: false });
    p.ctxs = ctxs;
    p.has_data = false;
    p.data = -1;
}

fn transport_kind(kind: ref String) -> i64 {
    if kind == "framed" {
        TR_FRAMED
    } else if kind == "buffered" {
        TR_BUFFERED
    } else {
        TR_PLAIN
    }
}

// ------------------------------------------------------------ the tutorial's handler

// CalculatorHandler, with its log of results by logid (which outlives a
// call), and what the logging module captured during one server turn.
struct Handler {
    keys: Vec[Val],
    vals: Vec[Val],
    logs: Vec[String],
}

fn obj_class(v: ref Val) -> i64 {
    match v {
        Val.Obj(c, _) => c,
        _ => -1,
    }
}

// An instance of one of the IDL's exceptions, raised.
fn exc_of(m: ref Model, v: ref Val) -> Exc {
    let c = obj_class(v);
    let cls = if c >= 0 { f"{m.classes[c].module}.{m.classes[c].name}" } else { "Exception".to_string() };
    Exc { cls: cls, msg: show(m, v), obj: v.clone() }
}

fn app_exc(kind: i64, msg: own String) -> Exc {
    let text = if msg.len() > 0 {
        msg
    } else if kind == 1 {
        "Unknown method".to_string()
    } else if kind == 2 {
        "Invalid message type".to_string()
    } else if kind == 3 {
        "Wrong method name".to_string()
    } else if kind == 4 {
        "Bad sequence ID".to_string()
    } else if kind == 5 {
        "Missing result".to_string()
    } else if kind == 6 {
        "Internal error".to_string()
    } else if kind == 7 {
        "Protocol error".to_string()
    } else if kind == 8 {
        "Invalid transform".to_string()
    } else if kind == 9 {
        "Invalid protocol".to_string()
    } else if kind == 10 {
        "Unsupported client type".to_string()
    } else {
        "Default (unknown) TApplicationException".to_string()
    };
    exc("thrift.Thrift.TApplicationException", text)
}

// '%d' % v
fn fmt_d(m: ref Model, v: ref Val) -> Result[String, Exc] {
    match v {
        Val.Int(n) => Ok(f"{n}"),
        Val.Bool(b) => Ok(if b { "1".to_string() } else { "0".to_string() }),
        Val.Float(x) => {
            if x != x {
                return Err(value_error("cannot convert float NaN to integer".to_string()));
            }
            if x == f64.INFINITY or x == -f64.INFINITY {
                return Err(exc("OverflowError", "cannot convert float infinity to integer".to_string()));
            }
            Ok(f"{x as i64}")
        }
        _ => Err(type_error(f"%d format: a real number is required, not {type_name(m, v)}")),
    }
}

fn no_operand(m: ref Model, op: char, a: ref Val, b: ref Val) -> Exc {
    type_error(f"unsupported operand type(s) for {op}: '{type_name(m, a)}' and '{type_name(m, b)}'")
}

// a + b, a - b, a * b and a / b over Python numbers.
fn py_arith(m: ref Model, op: char, a: ref Val, b: ref Val) -> Result[Val, Exc] {
    if not is_number(a) or not is_number(b) {
        return Err(no_operand(m, op, a, b));
    }
    let floats = match (a, b) {
        (Val.Float(_), _) => true,
        (_, Val.Float(_)) => true,
        _ => false,
    };
    if op == '/' or floats {
        let x = float_of(a);
        let y = float_of(b);
        let r = if op == '+' { x + y } else if op == '-' { x - y } else if op == '*' { x * y } else { x / y };
        return Ok(Val.Float(r));
    }
    let x = int_of(a).unwrap_or(0);
    let y = int_of(b).unwrap_or(0);
    let r = if op == '+' { x + y } else if op == '-' { x - y } else { x * y };
    Ok(Val.Int(r))
}

fn invalid_op(m: ref Model, op: ref Val, why: Str) -> Exc {
    let c = class_id(m, "InvalidOperation".to_string());
    let mut args: Vec[Val] = Vec.new();
    args.push(op.clone());
    args.push(Val.Str(why.to_string()));
    let names: Vec[String] = Vec.new();
    let none: Vec[Val] = Vec.new();
    match new_obj(m, c, args, names, none) {
        Ok(v) => exc_of(m, v),
        Err(e) => e,
    }
}

// The Operation enum: ADD 1, SUBTRACT 2, MULTIPLY 3, DIVIDE 4.
fn h_calculate(m: ref Model, h: mut ref Handler, logid: ref Val, work: ref Val) -> Result[Val, Exc] {
    let d = fmt_d(m, logid)?;
    out(f"server: calculate({d}, {show(m, work)})");
    let op = get_attr(m, work, "op")?;
    let val = if py_eq(op, Val.Int(1)) {
        py_arith(m, '+', get_attr(m, work, "num1")?, get_attr(m, work, "num2")?)?
    } else if py_eq(op, Val.Int(2)) {
        py_arith(m, '-', get_attr(m, work, "num1")?, get_attr(m, work, "num2")?)?
    } else if py_eq(op, Val.Int(3)) {
        py_arith(m, '*', get_attr(m, work, "num1")?, get_attr(m, work, "num2")?)?
    } else if py_eq(op, Val.Int(4)) {
        let n2 = get_attr(m, work, "num2")?;
        if py_eq(n2, Val.Int(0)) {
            return Err(invalid_op(m, op, "Cannot divide by 0"));
        }
        py_arith(m, '/', get_attr(m, work, "num1")?, n2)?
    } else {
        return Err(invalid_op(m, op, "Invalid operation"));
    };
    let sc = class_id(m, "SharedStruct".to_string());
    let mut log = empty_obj(m, sc);
    set_attr(m, mut log, "key", logid.clone());
    let text = fmt_d(m, val)?;
    set_attr(m, mut log, "value", Val.Str(text));
    dict_set(mut h.keys, mut h.vals, logid.clone(), log);
    Ok(val)
}

fn call_handler(m: ref Model, h: mut ref Handler, name: ref String, args: ref Vec[Val]) -> Result[Val, Exc] {
    if name == "ping" {
        out("server: ping()".to_string());
        Ok(Val.Non)
    } else if name == "add" {
        let a = fmt_d(m, args[0])?;
        let b = fmt_d(m, args[1])?;
        out(f"server: add({a},{b})");
        py_arith(m, '+', args[0], args[1])
    } else if name == "calculate" {
        h_calculate(m, mut h, args[0], args[1])
    } else if name == "getStruct" {
        let d = fmt_d(m, args[0])?;
        out(f"server: getStruct({d})");
        let i = index_of(h.keys, args[0]);
        if i < 0 {
            return Err(exc("KeyError", show(m, args[0])));
        }
        Ok(h.vals[i].clone())
    } else {
        out("server: zip()".to_string());
        Ok(Val.Non)
    }
}

// ------------------------------------------------------------ the processors

const CALC: Str = "Calculator";

fn write_app_exc(m: ref Model, p: mut ref Proto, kind: i64, msg: ref String) -> Result[(), Exc] {
    write_struct_begin(mut p);
    write_field_begin(mut p, "message".to_string(), T_STRING, 1)?;
    write_string(m, mut p, Val.Str(msg.clone()))?;
    write_field_end(mut p);
    write_field_begin(mut p, "type".to_string(), T_I32, 2)?;
    write_int(m, mut p, 32, Val.Int(kind))?;
    write_field_end(mut p);
    write_field_stop(mut p);
    write_struct_end(mut p);
    Ok(())
}

fn read_app_exc(p: mut ref Proto) -> Result[Exc, Exc] {
    let mut message = String.new();
    let mut kind = 0;
    read_struct_begin(mut p)?;
    loop {
        let (ft, fid) = read_field_begin(mut p)?;
        if ft == T_STOP {
            break;
        }
        if fid == 1 and ft == T_STRING {
            message = read_string(mut p)?;
        } else if fid == 2 and ft == T_I32 {
            kind = read_int(mut p, 32)?;
        } else {
            skip(mut p, ft)?;
        }
        read_field_end(mut p)?;
    }
    read_struct_end(mut p)?;
    Ok(app_exc(kind, message))
}

// Calculator.Processor.process once the message header is read: the
// generated dispatch, a declared exception in the result, anything else
// an INTERNAL_ERROR.
fn process_msg(m: ref Model, h: mut ref Handler, ip: mut ref Proto, op: mut ref Proto, name: ref String, seqid: i64) -> Result[(), Exc] {
    let mi = method_of(m, CALC.to_string(), name);
    if mi < 0 {
        skip(mut ip, T_STRUCT)?;
        read_message_end(mut ip)?;
        write_message_begin(mut op, name, M_EXCEPTION, seqid)?;
        write_app_exc(m, mut op, 1, f"Unknown function {name}")?;
        write_message_end(mut op);
        t_flush(mut op.tr);
        return Ok(());
    }
    let meth = m.methods[mi].clone();
    let args = read_obj(m, mut ip, meth.args)?;
    read_message_end(mut ip)?;
    let argv = match args {
        Val.Obj(_, slots) => slots.clone(),
        _ => Vec.new(),
    };
    let res = call_handler(m, mut h, name, argv);
    if meth.oneway {
        if res.is_err() {
            h.logs.push("Exception in oneway handler".to_string());
        }
        return Ok(());
    }
    let mut result = empty_obj(m, meth.result);
    let mut mtype = M_REPLY;
    let mut internal = false;
    match res {
        Ok(v) => {
            if meth.has_ret {
                set_attr(m, mut result, "success", v);
            }
        }
        Err(e) => {
            if e.cls == "thrift.transport.TTransport.TTransportException" {
                return Err(e);
            }
            let mut caught = false;
            let rc = m.classes[meth.result].clone();
            for t in meth.throws {
                for f in rc.fields {
                    if not caught and f.name == t {
                        let want = m.tys[f.ty].cls;
                        if want >= 0 and obj_class(e.obj) == want {
                            caught = true;
                            set_attr(m, mut result, t, e.obj.clone());
                        }
                    }
                }
            }
            if not caught {
                h.logs.push("Unexpected exception in handler".to_string());
                mtype = M_EXCEPTION;
                internal = true;
            }
        }
    }
    write_message_begin(mut op, name, mtype, seqid)?;
    if internal {
        write_app_exc(m, mut op, 6, "Internal error".to_string())?;
    } else {
        write_obj(m, mut op, result)?;
    }
    write_message_end(mut op);
    t_flush(mut op.tr);
    Ok(())
}

// TMultiplexedProcessor.process, with Calculator registered.
fn mux_process(m: ref Model, h: mut ref Handler, ip: mut ref Proto, op: mut ref Proto) -> Result[(), Exc] {
    let (name, mtype, seqid) = read_message_begin(mut ip)?;
    if mtype != M_CALL and mtype != M_ONEWAY {
        return Err(proto_error("TMultiplexedProtocol only supports CALL & ONEWAY".to_string()));
    }
    let cs = chars(name);
    let mut index = -1;
    for i in 0..cs.len() {
        if index < 0 and cs[i] == ':' {
            index = i;
        }
    }
    if index < 0 {
        return Err(proto_error(f"Service name not found in message name: {name}.  Did you forget to use TMultiplexedProtocol in your client?"));
    }
    let service = text(slice(cs, 0, index));
    let call = text(slice(cs, index + 1, cs.len()));
    if service != CALC {
        return Err(proto_error(f"Service name not found: {service}.  Did you forget to call registerProcessor()?"));
    }
    process_msg(m, mut h, mut ip, mut op, call, seqid)
}

fn serve_turn(m: ref Model, h: mut ref Handler, ip: mut ref Proto, op: mut ref Proto, mux: bool) -> Result[(), Exc] {
    if mux {
        return mux_process(m, mut h, mut ip, mut op);
    }
    let (name, _, seqid) = read_message_begin(mut ip)?;
    process_msg(m, mut h, mut ip, mut op, name, seqid)
}

// One server turn: reads the request file, writes the response file.
fn serve(m: ref Model, h: mut ref Handler, proto: ref String, kind: ref String, mux: bool) -> Result[(), Exc] {
    let req = read_file("data/out/req.bin".to_string())?;
    let tk = transport_kind(kind);
    let mut ip = proto_new(proto, trans_new(tk, req), -1, -1)?;
    let mut op = proto_new(proto, trans_new(tk, Vec.new()), -1, -1)?;
    if let Err(e) = serve_turn(m, mut h, mut ip, mut op, mux) {
        out(f"server {err_line(e)}");
    }
    for msg in h.logs {
        out(f"server log: {msg}");
    }
    h.logs = Vec.new();
    write_file("data/out/resp.bin".to_string(), op.tr.out)?;
    out(f"response {wire(proto, op.tr.out)}");
    Ok(())
}

// The generated Client.send_<method>; its sequence id stays 0.
fn send_call(m: ref Model, p: mut ref Proto, mi: i64, vals: ref Vec[String]) -> Result[(), Exc] {
    let meth = m.methods[mi].clone();
    let mut args: Vec[Val] = Vec.new();
    for x in vals {
        args.push(lit(m, x)?);
    }
    let names: Vec[String] = Vec.new();
    let none: Vec[Val] = Vec.new();
    let obj = new_obj(m, meth.args, args, names, none)?;
    write_message_begin(mut p, meth.name, if meth.oneway { M_ONEWAY } else { M_CALL }, 0)?;
    write_obj(m, mut p, obj)?;
    write_message_end(mut p);
    t_flush(mut p.tr);
    Ok(())
}

// The generated Client.recv_<method>.
fn recv(m: ref Model, p: mut ref Proto, mi: i64) -> Result[Val, Exc] {
    let meth = m.methods[mi].clone();
    let (_, mtype, _) = read_message_begin(mut p)?;
    if mtype == M_EXCEPTION {
        let e = read_app_exc(mut p)?;
        read_message_end(mut p)?;
        return Err(e);
    }
    let result = read_obj(m, mut p, meth.result)?;
    read_message_end(mut p)?;
    if meth.has_ret {
        let s = get_attr(m, result, "success")?;
        if not is_none(s) {
            return Ok(s);
        }
    }
    for t in meth.throws {
        let v = get_attr(m, result, t)?;
        if not is_none(v) {
            return Err(exc_of(m, v));
        }
    }
    if not meth.has_ret {
        return Ok(Val.Non);
    }
    Err(app_exc(5, f"{meth.name} failed: unknown result"))
}

fn op_call(m: ref Model, h: mut ref Handler, a: ref Vec[String]) -> Result[(), Exc] {
    let proto = a[0].clone();
    let kind = a[1].clone();
    let sname = a[2].clone();
    let method = a[3].clone();
    h.logs = Vec.new();
    let req_path = "data/out/req.bin".to_string();
    let tk = transport_kind(kind);
    let mut p = proto_new(proto, trans_new(tk, Vec.new()), -1, -1)?;
    if sname != "-" {
        p.service = sname.clone();
    }
    let mi = method_of(m, CALC.to_string(), method);
    if mi < 0 {
        write_file(req_path, Vec.new())?;
        return Err(exc("KeyError", str_repr(method)));
    }
    let mut vals: Vec[String] = Vec.new();
    for i in 4..a.len() {
        vals.push(a[i].clone());
    }
    let sent = send_call(m, mut p, mi, vals);
    write_file(req_path, p.tr.out)?;
    sent?;
    out(f"request {wire(proto, p.tr.out)}");
    serve(m, mut h, proto, kind, sname != "-")?;
    if m.methods[mi].oneway {
        return Ok(());
    }
    let resp = read_file("data/out/resp.bin".to_string())?;
    let mut rp = proto_new(proto, trans_new(tk, resp), -1, -1)?;
    let v = recv(m, mut rp, mi)?;
    out(f"result {show(m, v)}");
    Ok(())
}

// ------------------------------------------------------------ the app's programs

// Yields each framed record of the file, read as cname, into recs.
fn read_frames(m: ref Model, proto: ref String, path: ref String, cname: ref String, recs: mut ref Vec[Val]) -> Result[(), Exc] {
    let data = read_file(path)?;
    let size = data.len();
    let cls = class_id(m, cname);
    let mut p = proto_new(proto, trans_new(TR_FRAMED, data), -1, -1)?;
    while p.tr.pos < size {
        if cls < 0 {
            return Err(exc("KeyError", str_repr(cname)));
        }
        proto_reset(mut p);
        let obj = read_obj(m, mut p, cls)?;
        recs.push(obj);
    }
    Ok(())
}

fn tsv_rows(path: Str) -> Result[Vec[Vec[String]], Exc] {
    let body = read_text(path.to_string())?;
    let lines = split_on(body, '\n');
    let mut rows: Vec[Vec[String]] = Vec.new();
    for i in 1..lines.len() {
        if lines[i].len() > 0 {
            rows.push(split_on(lines[i], '\t'));
        }
    }
    Ok(rows)
}

fn kw_obj(m: ref Model, cname: Str, names: ref Vec[String], vals: ref Vec[Val]) -> Result[Val, Exc] {
    let none: Vec[Val] = Vec.new();
    new_obj(m, class_id(m, cname.to_string()), none, names, vals)
}

fn names_of(text: Str) -> Vec[String] {
    split_on(text.to_string(), ' ')
}

fn eventlog_write(m: ref Model, proto: ref String, path: ref String) -> Result[(), Exc] {
    let mut p = proto_new(proto, trans_new(TR_FRAMED, Vec.new()), -1, -1)?;
    let names = names_of("ts kind user ms attrs");
    let mut n = 0;
    for f in tsv_rows("data/events.tsv")? {
        let mut ks: Vec[Val] = Vec.new();
        let mut vs: Vec[Val] = Vec.new();
        if f[4].len() > 0 {
            for kv in split_on(f[4], ';') {
                let cs = chars(kv);
                let mut eq = 0;
                while eq < cs.len() and cs[eq] != '=' {
                    eq += 1;
                }
                let k = text(slice(cs, 0, eq));
                let v = text(slice(cs, eq + 1, cs.len()));
                dict_set(mut ks, mut vs, Val.Str(k), Val.Str(v));
            }
        }
        let mut vals: Vec[Val] = Vec.new();
        vals.push(Val.Int(atoi(f[0])));
        vals.push(Val.Str(f[1].clone()));
        vals.push(Val.Int(atoi(f[2])));
        vals.push(Val.Float(py_float(f[3]).unwrap_or(0.0)));
        vals.push(Val.Dict(ks, vs));
        let ev = kw_obj(m, "Event", names, vals)?;
        write_obj(m, mut p, ev)?;
        t_flush(mut p.tr);
        n += 1;
    }
    write_file(path, p.tr.out)?;
    out(f"wrote {n} events, {p.tr.out.len()} bytes");
    Ok(())
}

fn eventlog_report(m: ref Model, proto: ref String, path: ref String, cname: ref String) -> Result[(), Exc] {
    let mut recs: Vec[Val] = Vec.new();
    let r = read_frames(m, proto, path, cname, mut recs);
    let mut kinds: Vec[Val] = Vec.new();
    let mut counts: Vec[i64] = Vec.new();
    let mut totals: Vec[f64] = Vec.new();
    let mut maxes: Vec[f64] = Vec.new();
    let mut users: Vec[Val] = Vec.new();
    let mut n = 0;
    for ev in recs {
        n += 1;
        let kind = get_attr(m, ev, "kind")?;
        let mut i = index_of(kinds, kind);
        if i < 0 {
            kinds.push(kind.clone());
            counts.push(0);
            totals.push(0.0);
            maxes.push(0.0);
            i = kinds.len() - 1;
        }
        let ms = float_of(get_attr(m, ev, "ms")?);
        counts[i] += 1;
        totals[i] += ms;
        if ms > maxes[i] {
            maxes[i] = ms;
        }
        set_add(mut users, get_attr(m, ev, "user")?);
        if cname == "EventV2" and n <= 3 {
            let extra = show(m, get_attr(m, ev, "extra")?);
            let flag = show(m, get_attr(m, ev, "flag")?);
            out(f"v2 {py_str(m, kind)} extra={extra} flag={flag}");
        }
    }
    out(f"{n} events from {users.len()} users");
    for kind in sorted_pvs(kinds) {
        let i = index_of(kinds, kind);
        let count = f"{counts[i]}";
        let mean = fixed_text(totals[i] / (counts[i] as f64), 2, false);
        let mx = fixed_text(maxes[i], 2, false);
        out(f"{pad_right(py_str(m, kind), 8)} {pad_left(count, 3)}  mean {pad_left(mean, 8)} ms  max {pad_left(mx, 8)} ms");
    }
    r
}

// The old service's writer: UserV1 records, one frame each.
fn legacy_write(m: ref Model, proto: ref String, path: ref String) -> Result[(), Exc] {
    let mut p = proto_new(proto, trans_new(TR_FRAMED, Vec.new()), -1, -1)?;
    let names = names_of("id name email");
    let rows = tsv_rows("data/users.tsv")?;
    for f in rows {
        let mut vals: Vec[Val] = Vec.new();
        vals.push(Val.Int(atoi(f[0])));
        vals.push(Val.Str(f[1].clone()));
        vals.push(Val.Str(f[2].clone()));
        let u = kw_obj(m, "UserV1", names, vals)?;
        write_obj(m, mut p, u)?;
        t_flush(mut p.tr);
    }
    write_file(path, p.tr.out)?;
    out(f"wrote {rows.len()} users, {p.tr.out.len()} bytes");
    Ok(())
}

fn ends_with(s: ref String, suffix: Str) -> bool {
    s.ends_with(suffix)
}

// Reads UserV1 frames as UserV2 (the new fields take their IDL defaults),
// grants roles, and writes UserV2 frames.
fn migrate(m: ref Model, inproto: ref String, inpath: ref String, outproto: ref String, outpath: ref String) -> Result[(), Exc] {
    let mut admins: Vec[String] = Vec.new();
    for line in split_on(read_text("data/admins.txt".to_string())?, '\n') {
        if line.len() > 0 {
            admins.push(line.clone());
        }
    }
    let mut p = proto_new(outproto, trans_new(TR_FRAMED, Vec.new()), -1, -1)?;
    let mut recs: Vec[Val] = Vec.new();
    let r = read_frames(m, inproto, inpath, "UserV2".to_string(), mut recs);
    let mut n = 0;
    for rec in recs {
        let mut u = rec.clone();
        let email = get_attr(m, u, "email")?;
        let is_admin = match email {
            Val.Str(ref e) => admins.contains(e),
            _ => false,
        };
        if is_admin {
            let mut roles = get_attr(m, u, "roles")?;
            let admin = Val.Str("admin".to_string());
            let has = match roles {
                Val.List(ref xs) => index_of(xs, admin) >= 0,
                _ => true,
            };
            if not has {
                match roles {
                    Val.List(mut ref xs) => xs.push(admin),
                    _ => {}
                }
                set_attr(m, mut u, "roles", roles);
            }
        }
        match email {
            Val.Str(e) => {
                if ends_with(e, "@example.invalid") {
                    set_attr(m, mut u, "active", Val.Bool(false));
                }
            }
            _ => return Err(exc("AttributeError", f"'{type_name(m, email)}' object has no attribute 'endswith'")),
        }
        let name_len = py_len(m, get_attr(m, u, "name")?)?;
        set_attr(m, mut u, "score", Val.Float((name_len as f64) / 4.0));
        write_obj(m, mut p, u)?;
        t_flush(mut p.tr);
        n += 1;
    }
    write_file(outpath, p.tr.out)?;
    r?;
    out(f"migrated {n} users, {p.tr.out.len()} bytes");
    Ok(())
}

// One SimpleJSON line a record.
fn export(m: ref Model, inproto: ref String, inpath: ref String, cname: ref String, outpath: ref String) -> Result[(), Exc] {
    let mut recs: Vec[Val] = Vec.new();
    read_frames(m, inproto, inpath, cname, mut recs)?;
    let mut lines: Vec[Vec[u8]] = Vec.new();
    let sjson = "sjson".to_string();
    for u in recs {
        lines.push(encode(m, sjson, canon(u), -1, -1)?);
    }
    let mut all: Vec[u8] = Vec.new();
    for i in 0..lines.len() {
        if i > 0 {
            all.push(10);
        }
        append(mut all, lines[i]);
    }
    all.push(10);
    write_file(outpath, all)?;
    for ln in lines {
        out(from_utf8_lossy(ln));
    }
    Ok(())
}

// ------------------------------------------------------------ jobs

fn arg(a: ref Vec[String], i: i64) -> Result[String, Exc] {
    if i < a.len() {
        Ok(a[i].clone())
    } else {
        Err(exc("IndexError", "list index out of range".to_string()))
    }
}

fn dump_into(p: mut ref Proto, mode: ref String, lines: mut ref Vec[String]) -> Result[(), Exc] {
    if mode == "message" {
        let (name, mtype, seqid) = read_message_begin(mut p)?;
        lines.push(f"message {str_repr(name)} type {mtype} seqid {seqid}");
        walk(mut p, T_STRUCT, 1, mut lines, String.new())?;
        read_message_end(mut p)?;
    } else {
        walk(mut p, T_STRUCT, 0, mut lines, String.new())?;
    }
    Ok(())
}

fn frames_write(m: ref Model, p: mut ref Proto, a: ref Vec[String]) -> Result[(), Exc] {
    for i in 2..a.len() {
        let v = lit(m, a[i])?;
        write_obj(m, mut p, v)?;
        t_flush(mut p.tr);
    }
    Ok(())
}

fn run(m: ref Model, h: mut ref Handler, parts: ref Vec[String]) -> Result[(), Exc] {
    let op = parts[0].clone();
    let mut a: Vec[String] = Vec.new();
    for i in 1..parts.len() {
        a.push(parts[i].clone());
    }
    if op == "enc" {
        let v = lit(m, a[1])?;
        let b = encode(m, a[0], v, -1, -1)?;
        out(f"{b.len()} {wire(a[0], b)}");
    } else if op == "dec" {
        let data = payload(a[2])?;
        let (obj, rest) = decode(m, a[0], a[1], data, -1, -1)?;
        let tail = if rest == 0 { String.new() } else { f"  rest {rest}" };
        out(f"{show(m, obj)}{tail}");
    } else if op == "lim" {
        let s = py_int(a[1])?;
        let c = py_int(a[2])?;
        let data = payload(a[4])?;
        let (obj, _) = decode(m, a[0], a[3], data, s, c)?;
        out(show(m, obj));
    } else if op == "rt" {
        let obj = lit(m, a[1])?;
        let b = encode(m, a[0], obj, -1, -1)?;
        out(f"{b.len()} {wire(a[0], b)}");
        let (back, _) = decode(m, a[0], type_name(m, obj), b, -1, -1)?;
        out(show(m, back));
        out(f"equal {tf(py_eq(back, obj))}");
    } else if op == "sizes" {
        let obj = lit(m, a[0])?;
        for proto in names_of("binary compact json sjson") {
            let b = encode(m, proto, obj, -1, -1)?;
            let n = f"{b.len()}";
            out(f"{pad_right(proto, 8)} {pad_left(n, 4)}");
        }
    } else if op == "msgw" {
        let mut p = proto_new(a[0], trans_new(TR_PLAIN, Vec.new()), -1, -1)?;
        let mtype = py_int(a[2])?;
        let seqid = py_int(a[3])?;
        write_message_begin(mut p, a[1], mtype, seqid)?;
        write_struct_begin(mut p);
        write_field_stop(mut p);
        write_struct_end(mut p);
        write_message_end(mut p);
        out(f"{p.tr.out.len()} {wire(a[0], p.tr.out)}");
    } else if op == "msgr" {
        let data = payload(a[1])?;
        let mut p = proto_new(a[0], trans_new(TR_PLAIN, data), -1, -1)?;
        let (name, mtype, seqid) = read_message_begin(mut p)?;
        out(f"name {str_repr(name)} type {mtype} seqid {seqid}");
    } else if op == "dump" {
        let data = payload(a[1])?;
        let mut p = proto_new(a[0], trans_new(TR_PLAIN, data.clone()), -1, -1)?;
        let mut lines: Vec[String] = Vec.new();
        let r = match arg(a, 2) {
            Ok(mode) => dump_into(mut p, mode, mut lines),
            Err(e) => Err(e),
        };
        for ln in lines {
            out(ln);
        }
        r?;
        let rest = data.len() - p.tr.pos;
        if rest != 0 {
            out(f"rest {rest}");
        }
    } else if op == "skip" {
        let data = payload(a[2])?;
        let mut p = proto_new(a[0], trans_new(TR_PLAIN, data.clone()), -1, -1)?;
        let t = py_int(a[1])?;
        skip(mut p, t)?;
        out(f"skipped {p.tr.pos} of {data.len()} bytes");
    } else if op == "frames" {
        write_file(a[1], Vec.new())?;
        let mut p = proto_new(a[0], trans_new(TR_FRAMED, Vec.new()), -1, -1)?;
        let r = frames_write(m, mut p, a);
        write_file(a[1], p.tr.out)?;
        r?;
        out(f"{p.tr.out.len()} bytes");
    } else if op == "readframes" {
        let mut recs: Vec[Val] = Vec.new();
        let r = read_frames(m, a[0], a[1], a[2], mut recs);
        for x in recs {
            out(show(m, x));
        }
        out(f"{recs.len()} records");
        r?;
    } else if op == "file" {
        let b = read_file(a[0])?;
        let shown = if b.len() == 0 {
            "(empty)".to_string()
        } else if b.len() <= 96 {
            hex_of(b)
        } else {
            f"{hex_of(sub(b, 0, 96))}..."
        };
        out(f"{b.len()} {shown}");
    } else if op == "patch" {
        let mut b = read_file(a[0])?;
        let mut i = py_int(a[1])?;
        let v = py_int16_arg(a[2])?;
        if i < 0 {
            i += b.len();
        }
        if i < 0 or i >= b.len() {
            return Err(exc("IndexError", "bytearray index out of range".to_string()));
        }
        if v > 255 {
            return Err(value_error("byte must be in range(0, 256)".to_string()));
        }
        b[i] = v as u8;
        write_file(a[0], b)?;
        out("patched".to_string());
    } else if op == "truncate" {
        let b = read_file(a[0])?;
        let n = py_int(a[1])?;
        let mut end = if n < 0 { n + b.len() } else { n };
        if end < 0 {
            end = 0;
        }
        if end > b.len() {
            end = b.len();
        }
        write_file(a[0], sub(b, 0, end))?;
        out(f"truncated to {n}");
    } else if op == "call" {
        op_call(m, mut h, a)?;
    } else if op == "raw" {
        h.logs = Vec.new();
        let data = payload(a[3])?;
        write_file("data/out/req.bin".to_string(), data)?;
        serve(m, mut h, a[0], a[1], a[2] == "mux")?;
    } else if op == "eventlog" {
        if a[0] == "write" {
            eventlog_write(m, a[1], a[2])?;
        } else {
            eventlog_report(m, a[1], a[2], a[3])?;
        }
    } else if op == "legacy" {
        legacy_write(m, a[0], a[1])?;
    } else if op == "migrate" {
        migrate(m, a[0], a[1], a[2], a[3])?;
    } else if op == "export" {
        export(m, a[0], a[1], a[2], a[3])?;
    } else if op == "const" {
        for i in 0..m.const_names.len() {
            if m.const_names[i] == a[0] {
                out(show(m, m.const_values[i]));
                return Ok(());
            }
        }
        return Err(exc("KeyError", str_repr(a[0])));
    } else if op == "enum" {
        for e in 0..m.enum_names.len() {
            if m.enum_names[e] == a[0] {
                // sorted by value; a stable selection keeps ties in order
                let n = m.enum_values[e].len();
                let mut used: Vec[bool] = Vec.new();
                for _ in 0..n {
                    used.push(false);
                }
                let mut parts: Vec[String] = Vec.new();
                for _ in 0..n {
                    let mut best = -1;
                    for k in 0..n {
                        if not used[k] and (best < 0 or m.enum_values[e][k] < m.enum_values[e][best]) {
                            best = k;
                        }
                    }
                    used[best] = true;
                    parts.push(f"{m.enum_members[e][best]}={m.enum_values[e][best]}");
                }
                out(join_strs(parts, ", "));
                return Ok(());
            }
        }
        return Err(exc("KeyError", str_repr(a[0])));
    } else if op == "spec" {
        let c = class_id(m, a[0]);
        if c < 0 {
            return Err(exc("KeyError", str_repr(a[0])));
        }
        let cl = m.classes[c].clone();
        out(f"slots {join_strs(cl.slots, ", ")}");
        for idx in cl.spec {
            if idx < 0 {
                out("-".to_string());
            } else {
                let f = cl.fields[idx].clone();
                out(f"{f.fid} {f.name} {tname(m.tys[f.ty].t)}");
            }
        }
    } else {
        return Err(value_error(f"unknown op {op}"));
    }
    Ok(())
}

fn write_inputs() -> Result[(), String] {
    for line in split_on(inputs_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let f = split_on(line, ' ');
        let path = f"data/{f[0]}";
        let _ = fs.create_dir_all(dirname_of(path));
        let bytes = if f.len() > 1 { hex_bytes(f[1]) } else { Vec.new() };
        if let Err(e) = fs.write_bytes(path, bytes) {
            return Err(f"cannot write {f[0]}: {e}");
        }
    }
    let _ = fs.remove_dir_all("data/out".to_string());
    if let Err(e) = fs.create_dir_all("data/out".to_string()) {
        return Err(f"cannot create data/out: {e}");
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_inputs() {
        eprintln(e);
        return;
    }
    let idl = match fs.read_to_string("data/app.thrift".to_string()) {
        Ok(s) => s,
        Err(e) => {
            eprintln(f"cannot read data/app.thrift: {e}");
            return;
        }
    };
    let m = compile_idl(idl);
    let mut h = Handler { keys: Vec.new(), vals: Vec.new(), logs: Vec.new() };
    let mut n = 0;
    let mut nerr = 0;
    for line in split_on(jobs_text(), '\n') {
        if line.len() == 0 {
            continue;
        }
        let parts = split_on(hex_string(line), '\t');
        println(f"> {join_strs(parts, " ")}");
        if let Err(e) = run(m, mut h, parts) {
            println(f"  {err_line(e)}");
            nerr += 1;
        }
        n += 1;
    }
    println(f"{n} jobs, {nerr} ended in an error");
}

