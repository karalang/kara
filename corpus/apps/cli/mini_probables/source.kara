// mini_probables — a port of pyprobables 0.7.0 (MIT; Tyler Barrus), the
// probabilistic-data-structures library used for stream analytics and dedup.
// This port is its Count-Min Sketch: a width×depth counter table that estimates
// how many times each key has been seen, under the library's default 64-bit
// FNV-1a hashing and all three estimators (min, mean, mean-min). It follows
// countminsketch.py and hashes.py exactly: the same wrapping FNV-1a (done here
// with 16-bit-limb multiplication so the 64-bit wraparound is exact), the same
// (hash % width) + i*width bin indexing, the same INT32 saturation on add/remove,
// and the same sorted-estimator queries. One shared sketch (width 997, depth 5)
// accumulates across every job. Keys are ASCII. See README.md.

fn str_bytes(s: String) -> Vec[u8] {
    let mut v: Vec[u8] = Vec.new();
    for b in s.bytes() {
        v.push(b);
    }
    v
}

fn itoa(n: i64) -> String {
    let mut digs: Vec[u8] = Vec.new();
    let mut neg = false;
    let mut v = n;
    if v < 0 {
        neg = true;
        v = -v;
    }
    if v == 0 {
        digs.push(48);
    }
    while v > 0 {
        digs.push((48 + (v % 10)) as u8);
        v = v / 10;
    }
    if neg {
        digs.push(45);
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i = digs.len();
    while i > 0 {
        out.push(digs[i - 1]);
        i = i - 1;
    }
    String.from_utf8(out).unwrap_or("")
}

// ---------------- bitwise helpers over i64 bit patterns ----------------

// x ^ y via (x | y) - (x & y); exact for any two's-complement bit patterns.
fn xor64(x: i64, y: i64) -> i64 {
    (x | y) - (x & y)
}

// a * b mod 2^64, via 16-bit limbs (a, b are arbitrary 64-bit patterns).
fn wrapmul64(a: i64, b: i64) -> i64 {
    let a0 = a & 65535;
    let a1 = (a >> 16) & 65535;
    let a2 = (a >> 32) & 65535;
    let a3 = (a >> 48) & 65535;
    let b0 = b & 65535;
    let b1 = (b >> 16) & 65535;
    let b2 = (b >> 32) & 65535;
    let b3 = (b >> 48) & 65535;
    let c0 = a0 * b0;
    let c1 = a0 * b1 + a1 * b0;
    let c2 = a0 * b2 + a1 * b1 + a2 * b0;
    let c3 = a0 * b3 + a1 * b2 + a2 * b1 + a3 * b0;
    let r0 = c0 & 65535;
    let t1 = c1 + (c0 >> 16);
    let r1 = t1 & 65535;
    let t2 = c2 + (t1 >> 16);
    let r2 = t2 & 65535;
    let t3 = c3 + (t2 >> 16);
    let r3 = t3 & 65535;
    r0 | (r1 << 16) | (r2 << 32) | (r3 << 48)
}

// 2^63 mod m, by doubling.
fn pow2_63_mod(m: i64) -> i64 {
    let mut r = 1;
    let mut i = 0;
    while i < 63 {
        r = (r * 2) % m;
        i = i + 1;
    }
    r
}

// Unsigned modulo: x is a 64-bit pattern (the sign bit, if set, means a value
// >= 2^63); return (x as u64) % m for 0 < m.
fn umod(x: i64, m: i64) -> i64 {
    if x >= 0 {
        x % m
    } else {
        let low = x & 9223372036854775807;  // clear the sign bit (low 63 bits)
        (low % m + pow2_63_mod(m)) % m
    }
}

// The 64-bit FNV-1a hash of `data` (byte/codepoint values) with a seed. The
// offset basis 14695981039346656037 is > i64::MAX, so it is written as its
// signed-i64 bit pattern; the prime 1099511628211 fits. Masking to 2^64 is
// implicit in the i64 bit pattern + wrapmul64.
fn fnv_1a(data: Vec[i64], seed: i64) -> i64 {
    let mut hval = -3750763034362895579 + 31 * seed;
    let mut i = 0;
    while i < data.len() {
        hval = xor64(hval, data[i]);
        hval = wrapmul64(hval, 1099511628211);
        i = i + 1;
    }
    hval
}

// ---------------- Count-Min Sketch ----------------

struct Cms {
    width: i64,
    depth: i64,
    bins: Vec[i64],
    added: i64,
    qt: i64,  // 0 = min, 1 = mean, 2 = mean-min
}

fn cms_new(width: i64, depth: i64) -> Cms {
    let mut bins: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < width * depth {
        bins.push(0);
        i = i + 1;
    }
    Cms { width: width, depth: depth, bins: bins, added: 0, qt: 0 }
}

fn key_data(key: String) -> Vec[i64] {
    let b = str_bytes(key.clone());
    let mut v: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        v.push(b[i] as i64);
        i = i + 1;
    }
    v
}

// The depth bin indices for a key: (hash_i % width) + i*width.
fn bins_for(cms: ref Cms, data: Vec[i64]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < cms.depth {
        let h = fnv_1a(data, i);
        out.push(umod(h, cms.width) + i * cms.width);
        i = i + 1;
    }
    out
}

fn sort_vec(v: Vec[i64]) -> Vec[i64] {
    let mut a = v.clone();
    let n = a.len();
    let mut i = 1;
    while i < n {
        let key = a[i];
        let mut j = i;
        while j > 0 and a[j - 1] > key {
            a[j] = a[j - 1];
            j = j - 1;
        }
        a[j] = key;
        i = i + 1;
    }
    a
}

// Floor division for b > 0 (Python's //).
fn fdiv(a: i64, b: i64) -> i64 {
    let q = a / b;
    let r = a - q * b;
    if r != 0 and a < 0 {
        q - 1
    } else {
        q
    }
}

// The estimator over a set of bin values (not assumed sorted here).
fn query(cms: ref Cms, vals: Vec[i64]) -> i64 {
    let s = sort_vec(vals);
    let d = cms.depth;
    if cms.qt == 0 {
        s[0]
    } else if cms.qt == 1 {
        let mut sum = 0;
        let mut i = 0;
        while i < s.len() {
            sum = sum + s[i];
            i = i + 1;
        }
        fdiv(sum, d)
    } else {
        if s[0] == 0 and s[s.len() - 1] == 0 {
            0
        } else {
            let mut mm: Vec[i64] = Vec.new();
            let mut i = 0;
            while i < s.len() {
                let diff = cms.added - s[i];
                mm.push(s[i] - fdiv(diff, cms.width - 1));
                i = i + 1;
            }
            let ms = sort_vec(mm);
            if d % 2 == 0 {
                (ms[d / 2] + ms[d / 2 - 1]) / 2
            } else {
                ms[d / 2]
            }
        }
    }
}

fn cms_add(cms: mut ref Cms, data: Vec[i64], num: i64) -> i64 {
    let bins = bins_for(cms, data);
    let mut vals: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < bins.len() {
        let idx = bins[i];
        let mut val = cms.bins[idx] + num;
        if val > 2147483647 {
            val = 2147483647;
        }
        cms.bins[idx] = val;
        vals.push(val);
        i = i + 1;
    }
    cms.added = cms.added + num;
    query(cms, vals)
}

fn cms_remove(cms: mut ref Cms, data: Vec[i64], num: i64) -> i64 {
    let bins = bins_for(cms, data);
    let mut vals: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < bins.len() {
        let idx = bins[i];
        let mut val = cms.bins[idx] - num;
        if val > -2147483648 {
            cms.bins[idx] = val;
        } else {
            val = -2147483648;
            cms.bins[idx] = val;
        }
        vals.push(val);
        i = i + 1;
    }
    cms.added = cms.added - num;
    query(cms, vals)
}

fn cms_check(cms: ref Cms, data: Vec[i64]) -> i64 {
    let bins = bins_for(cms, data);
    let mut vals: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < bins.len() {
        vals.push(cms.bins[bins[i]]);
        i = i + 1;
    }
    query(cms, vals)
}

fn join_ints(v: Vec[i64]) -> String {
    let mut s = String.new();
    let mut i = 0;
    while i < v.len() {
        if i > 0 {
            s.push_str(" ");
        }
        s.push_str(itoa(v[i]));
        i = i + 1;
    }
    s
}

// Split "key n" into (key, n); returns n = 1 when no number is present.
fn split_key_num(arg: String) -> i64 {
    let b = str_bytes(arg.clone());
    let mut i = 0;
    while i < b.len() and b[i] != 32 {
        i = i + 1;
    }
    if i >= b.len() {
        1
    } else {
        let rest = arg.substring(i + 1, b.len());
        let rb = str_bytes(rest.clone());
        let mut v = 0;
        let mut j = 0;
        while j < rb.len() and rb[j] >= 48 and rb[j] <= 57 {
            v = v * 10 + ((rb[j] - 48) as i64);
            j = j + 1;
        }
        v
    }
}

fn key_part(arg: String) -> String {
    let b = str_bytes(arg.clone());
    let mut i = 0;
    while i < b.len() and b[i] != 32 {
        i = i + 1;
    }
    arg.substring(0, i)
}

fn main_run() -> String {
    let mut cms = cms_new(997, 5);
    let data = jobs_text();
    let db = str_bytes(data.clone());
    let n = db.len();
    let mut out = String.new();
    let mut i = 0;
    let mut ls = 0;
    while i <= n {
        if i == n or db[i] == 10 {
            if i > ls {
                let line = data.substring(ls, i);
                let lb = str_bytes(line.clone());
                let mut tab = -1;
                let mut t = 0;
                while t < lb.len() {
                    if lb[t] == 9 {
                        tab = t;
                        t = lb.len();
                    } else {
                        t = t + 1;
                    }
                }
                if tab >= 0 {
                    let op = line.substring(0, tab);
                    let arg = line.substring(tab + 1, lb.len());
                    if op == "bins" {
                        out.push_str(join_ints(bins_for(cms, key_data(arg.clone()))));
                    } else if op == "add" {
                        let num = split_key_num(arg.clone());
                        let r = cms_add(mut cms, key_data(key_part(arg.clone())), num);
                        out.push_str(itoa(r));
                    } else if op == "remove" {
                        let num = split_key_num(arg.clone());
                        let r = cms_remove(mut cms, key_data(key_part(arg.clone())), num);
                        out.push_str(itoa(r));
                    } else if op == "check" {
                        out.push_str(itoa(cms_check(cms, key_data(arg.clone()))));
                    } else if op == "query" {
                        if arg == "mean" {
                            cms.qt = 1;
                        } else if arg == "mean-min" {
                            cms.qt = 2;
                        } else {
                            cms.qt = 0;
                        }
                        out.push_str("query=");
                        out.push_str(arg);
                    }
                    out.push_str("\n");
                }
            }
            ls = i + 1;
        }
        i = i + 1;
    }
    out
}

fn main() {
    print(main_run());
}

