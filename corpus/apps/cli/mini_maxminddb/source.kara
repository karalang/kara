// mini_maxminddb: MaxMind's `maxminddb` 2.6.2 reader and `geoip2` 4.8.1
// database models (both Apache-2.0) in Kara.
//
// The MaxMind DB format: the binary search tree with 24, 28 and 32-bit
// records, the IPv4 subtree of an IPv6 database, the data section's
// decoder (pointers, strings, doubles, bytes, unsigned integers to 128
// bits, maps, int32, arrays, booleans and floats), the metadata, network
// iteration, the pure-Python Reader's error messages, the subset of
// Python's `ipaddress` it uses, and geoip2's City, Country and ASN models
// with their locale fallback. The jobs in data/jobs.txt drive it, then an
// access-log annotator and a geo firewall over data/access.log.
//
// A decoded value is a `Val`. Python's `dict` keeps its insertion order,
// so a map is a Vec of (key, value) pairs.

#[derive(Clone)]
enum Val {
    Str(String),
    Double(f64),
    Bytes(Vec[u8]),
    // an unsigned integer of any width, big-endian
    UInt(Vec[u8]),
    Map(Vec[(String, Val)]),
    Int(i64),
    Arr(Vec[Val]),
    Bool(bool),
    // a float32, widened as struct.unpack widens it
    Float(f64),
}

// A Python exception: its class name and str(exception). An
// AddressNotFoundError also carries the address and prefix length its
// `network` property is built from.
#[derive(Clone)]
struct Exc {
    kind: String,
    msg: String,
    ip: String,
    prefix: i64,
}

fn exc(kind: Str, msg: Str) -> Exc {
    Exc { kind: kind.to_string(), msg: msg.to_string(), ip: String.new(), prefix: 0 }
}

fn invalid_db(msg: Str) -> Exc {
    exc("InvalidDatabaseError", msg)
}

fn value_error(msg: Str) -> Exc {
    exc("ValueError", msg)
}

fn index_error() -> Exc {
    exc("IndexError", "index out of range")
}

fn struct_error(need: i64) -> Exc {
    exc("error", f"unpack requires a buffer of {need} bytes")
}

fn show_exc(e: ref Exc) -> String {
    f"{e.kind}: {e.msg}"
}

fn dict_get(d: ref Vec[(String, Val)], key: Str) -> Option[Val] {
    for p in d {
        if p.0 == key {
            return Some(p.1.clone());
        }
    }
    None
}

// d[key] = v: a new key goes last, an existing one keeps its place.
fn dict_set(d: mut ref Vec[(String, Val)], key: Str, v: own Val) {
    for i in 0..d.len() {
        if d[i].0 == key {
            d[i].1 = v;
            return;
        }
    }
    d.push((key.to_string(), v));
}

fn hex_n(n: i64, width: i64) -> String {
    let mut digits: Vec[char] = Vec.new();
    let mut v = n;
    while v > 0 {
        let d = v % 16;
        let code = if d < 10 { 48 + d } else { 87 + d };
        digits.push(char.try_from(code as u32).unwrap_or('0'));
        v = v / 16;
    }
    while (digits.len() as i64) < width {
        digits.push('0');
    }
    let mut out = String.new();
    let mut i = digits.len() as i64 - 1;
    while i >= 0 {
        out.push(digits[i]);
        i -= 1;
    }
    out
}

fn hex_val(c: char) -> i64 {
    let n = c as i64;
    if n >= 48 and n <= 57 {
        return n - 48;
    }
    if n >= 97 and n <= 102 {
        return n - 87;
    }
    if n >= 65 and n <= 70 {
        return n - 55;
    }
    -1
}

fn from_hex(s: Str) -> Vec[u8] {
    let cs: Vec[char] = s.chars().collect();
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < cs.len() as i64 {
        out.push((hex_val(cs[i]) * 16 + hex_val(cs[i + 1])) as u8);
        i += 2;
    }
    out
}

// str.isprintable(): the Other and Separator categories are not
// printable, the ASCII space is. Unassigned code points count as
// printable here.
fn is_printable(n: u32) -> bool {
    if n < 0x20 or (n >= 0x7F and n <= 0x9F) {
        return false;
    }
    if n == 0xA0 or n == 0xAD or n == 0x1680 or (n >= 0x2000 and n <= 0x200F) {
        return false;
    }
    if (n >= 0x2028 and n <= 0x202F) or (n >= 0x205F and n <= 0x2064) or (n >= 0x2066 and n <= 0x206F) {
        return false;
    }
    if n == 0x3000 or n == 0xFEFF or (n >= 0xFFF9 and n <= 0xFFFB) {
        return false;
    }
    if (n >= 0x600 and n <= 0x605) or n == 0x61C or n == 0x6DD or n == 0x70F or n == 0x890
        or n == 0x891 or n == 0x8E2 or n == 0x180E {
        return false;
    }
    if (n >= 0xE000 and n <= 0xF8FF) or n >= 0xF0000 {
        return false;
    }
    true
}

fn py_str_repr(s: Str) -> String {
    let quote = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    let mut out = String.new();
    out.push(quote);
    for c in s.chars() {
        let n = c as u32;
        if c == quote or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if n < 0x20 or n == 0x7F {
            out.push_str(f"\\x{hex_n(n as i64, 2)}");
        } else if n < 0x7F or is_printable(n) {
            out.push(c);
        } else if n <= 0xFF {
            out.push_str(f"\\x{hex_n(n as i64, 2)}");
        } else if n <= 0xFFFF {
            out.push_str(f"\\u{hex_n(n as i64, 4)}");
        } else {
            out.push_str(f"\\U{hex_n(n as i64, 8)}");
        }
    }
    out.push(quote);
    out
}

fn py_bytes_repr(b: ref Vec[u8]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for x in b {
        if *x == 39 {
            has_single = true;
        }
        if *x == 34 {
            has_double = true;
        }
    }
    let quote: u8 = if has_single and not has_double { 34 } else { 39 };
    let mut out = String.new();
    out.push('b');
    out.push(quote as char);
    for x in b {
        let v = *x;
        if v == quote or v == 92 {
            out.push('\\');
            out.push(v as char);
        } else if v == 9 {
            out.push_str("\\t");
        } else if v == 10 {
            out.push_str("\\n");
        } else if v == 13 {
            out.push_str("\\r");
        } else if v < 32 or v >= 127 {
            out.push_str(f"\\x{hex_n(v as i64, 2)}");
        } else {
            out.push(v as char);
        }
    }
    out.push(quote as char);
    out
}

// bytes.decode('utf-8') with CPython's strict error messages.
fn utf8_decode(b: ref Vec[u8]) -> Result[String, Exc] {
    let end = b.len() as i64;
    let mut i: i64 = 0;
    while i < end {
        let c = b[i] as i64;
        if c < 0x80 {
            i += 1;
            continue;
        }
        let need: i64 = if c >= 0xC2 and c < 0xE0 {
            1
        } else if c >= 0xE0 and c < 0xF0 {
            2
        } else if c >= 0xF0 and c < 0xF5 {
            3
        } else {
            0
        };
        if need == 0 {
            return Err(utf8_error(b, i, i + 1, "invalid start byte"));
        }
        let mut k: i64 = 1;
        while k <= need {
            if i + k >= end {
                return Err(utf8_error(b, i, end, "unexpected end of data"));
            }
            let d = b[i + k] as i64;
            let mut lo: i64 = 0x80;
            let mut hi: i64 = 0xBF;
            if k == 1 {
                if c == 0xE0 {
                    lo = 0xA0;
                } else if c == 0xED {
                    hi = 0x9F;
                } else if c == 0xF0 {
                    lo = 0x90;
                } else if c == 0xF4 {
                    hi = 0x8F;
                }
            }
            if d < lo or d > hi {
                return Err(utf8_error(b, i, i + k, "invalid continuation byte"));
            }
            k += 1;
        }
        i += need + 1;
    }
    Ok(String.from_utf8(b.clone()).unwrap_or(String.new()))
}

fn utf8_error(b: ref Vec[u8], a: i64, e: i64, reason: Str) -> Exc {
    if e - a == 1 {
        let byte = hex_n(b[a] as i64, 2);
        return exc("UnicodeDecodeError", f"'utf-8' codec can't decode byte 0x{byte} in position {a}: {reason}");
    }
    exc("UnicodeDecodeError", f"'utf-8' codec can't decode bytes in position {a}-{e - 1}: {reason}")
}

fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    f"{x}"
}

// int.from_bytes(b, "big") in decimal, by long division.
fn uint_digits(b: ref Vec[u8]) -> String {
    let mut num: Vec[i64] = Vec.new();
    for x in b {
        if num.len() > 0 or *x != 0 {
            num.push(*x as i64);
        }
    }
    if num.len() == 0 {
        return "0".to_string();
    }
    let mut ds: Vec[char] = Vec.new();
    while num.len() > 0 {
        let mut rem: i64 = 0;
        let mut next: Vec[i64] = Vec.new();
        for k in 0..num.len() {
            let cur = rem * 256 + num[k];
            let q = cur / 10;
            rem = cur % 10;
            if next.len() > 0 or q != 0 {
                next.push(q);
            }
        }
        ds.push(char.try_from((48 + rem) as u32).unwrap_or('0'));
        num = next;
    }
    let mut out = String.new();
    let mut i = ds.len() as i64 - 1;
    while i >= 0 {
        out.push(ds[i]);
        i -= 1;
    }
    out
}

// A big-endian unsigned integer as an i64, saturating; the metadata's
// counts and sizes are small.
fn uint_i64(b: ref Vec[u8]) -> i64 {
    let mut v: i64 = 0;
    for x in b {
        if v > 0x7FFFFFFFFFFFFF {
            return 0x7FFFFFFFFFFFFFFF;
        }
        v = v * 256 + *x as i64;
    }
    v
}

fn py_repr(v: ref Val) -> String {
    match v {
        Val.Str(s) => py_str_repr(s),
        Val.Double(x) => float_repr(*x),
        Val.Float(x) => float_repr(*x),
        Val.Bytes(b) => py_bytes_repr(b),
        Val.UInt(b) => uint_digits(b),
        Val.Int(n) => f"{n}",
        Val.Bool(b) => if *b { "True".to_string() } else { "False".to_string() },
        Val.Map(d) => {
            let mut parts: Vec[String] = Vec.new();
            for p in d {
                parts.push(f"{py_str_repr(p.0)}: {py_repr(p.1)}");
            }
            f"{{{parts.join(", ")}}}"
        },
        Val.Arr(items) => {
            let mut parts: Vec[String] = Vec.new();
            for x in items {
                parts.push(py_repr(x));
            }
            f"[{parts.join(", ")}]"
        },
    }
}

// str(v)
fn py_str(v: ref Val) -> String {
    match v {
        Val.Str(s) => s.clone(),
        _ => py_repr(v),
    }
}

// The value as a Python int, for the metadata's numbers.
fn int_of(v: ref Val) -> i64 {
    match v {
        Val.UInt(b) => uint_i64(b),
        Val.Int(n) => *n,
        Val.Bool(b) => if *b { 1 } else { 0 },
        _ => 0,
    }
}

// bool(v)
fn truthy(v: ref Val) -> bool {
    match v {
        Val.Str(s) => s.len() > 0,
        Val.Double(x) => *x != 0.0,
        Val.Float(x) => *x != 0.0,
        Val.Bytes(b) => b.len() > 0,
        Val.UInt(b) => uint_i64(b) != 0,
        Val.Int(n) => *n != 0,
        Val.Bool(b) => *b,
        Val.Map(d) => d.len() > 0,
        Val.Arr(items) => items.len() > 0,
    }
}

// ------------------------------------------------------------ the decoder

// self._buffer[i]
fn byte_at(buf: ref Vec[u8], i: i64) -> Result[i64, Exc] {
    if i < 0 or i >= buf.len() as i64 {
        return Err(index_error());
    }
    Ok(buf[i] as i64)
}

// self._buffer[a:b], which a short buffer cuts short.
fn slice(buf: ref Vec[u8], a: i64, b: i64) -> Vec[u8] {
    let n = buf.len() as i64;
    let lo = if a < 0 { 0 } else if a > n { n } else { a };
    let hi = if b > n { n } else if b < lo { lo } else { b };
    buf[lo..hi].to_vec()
}

// struct.unpack of a big-endian unsigned integer `need` bytes wide.
fn unpack_be(b: ref Vec[u8], need: i64) -> Result[u64, Exc] {
    if b.len() as i64 != need {
        return Err(struct_error(need));
    }
    let mut v: u64 = 0;
    for x in b {
        v = (v << 8) | *x as u64;
    }
    Ok(v)
}

fn verify_size(expected: i64, actual: i64) -> Result[(), Exc] {
    if expected != actual {
        return Err(invalid_db("The MaxMind DB file's data section contains bad data (unknown data type or corrupt data)"));
    }
    Ok(())
}

// Decoder.decode: the value at `offset` and the offset after it. `base`
// is the pointer base: the data section's start, or the metadata's.
fn decode(buf: ref Vec[u8], base: i64, offset: i64) -> Result[(Val, i64), Exc] {
    let mut at = offset + 1;
    let ctrl = byte_at(buf, offset)?;
    let mut type_num = ctrl >> 5;
    if type_num == 0 {
        type_num = byte_at(buf, at)? + 7;
        at += 1;
    }
    if type_num == 12 or type_num == 13 or type_num > 15 {
        return Err(invalid_db(f"Unexpected type number ({type_num}) encountered"));
    }
    let (size, at2) = size_from_ctrl(buf, ctrl, at, type_num)?;
    decode_type(buf, base, type_num, size, at2)
}

fn size_from_ctrl(buf: ref Vec[u8], ctrl: i64, offset: i64, type_num: i64) -> Result[(i64, i64), Exc] {
    let size = ctrl & 0x1F;
    if type_num == 1 or size < 29 {
        return Ok((size, offset));
    }
    if size == 29 {
        return Ok((29 + byte_at(buf, offset)?, offset + 1));
    }
    if size == 30 {
        let v = unpack_be(slice(buf, offset, offset + 2), 2)?;
        return Ok((285 + v as i64, offset + 2));
    }
    let mut b: Vec[u8] = [0u8].to_vec();
    for x in slice(buf, offset, offset + 3) {
        b.push(x);
    }
    let v = unpack_be(b, 4)?;
    Ok((v as i64 + 65821, offset + 3))
}

fn decode_type(buf: ref Vec[u8], base: i64, type_num: i64, size: i64, offset: i64) -> Result[(Val, i64), Exc] {
    if type_num == 1 {
        return decode_pointer(buf, base, size, offset);
    }
    if type_num == 2 {
        let s = utf8_decode(slice(buf, offset, offset + size))?;
        return Ok((Val.Str(s), offset + size));
    }
    if type_num == 3 {
        verify_size(size, 8)?;
        let bits = unpack_be(slice(buf, offset, offset + size), 8)?;
        return Ok((Val.Double(bits.bits_as_f64()), offset + size));
    }
    if type_num == 4 {
        return Ok((Val.Bytes(slice(buf, offset, offset + size)), offset + size));
    }
    if type_num == 5 or type_num == 6 or type_num == 9 or type_num == 10 {
        return Ok((Val.UInt(slice(buf, offset, offset + size)), offset + size));
    }
    if type_num == 7 {
        let mut d: Vec[(String, Val)] = Vec.new();
        let mut at = offset;
        for _ in 0..size {
            let (key, a1) = decode(buf, base, at)?;
            let (value, a2) = decode(buf, base, a1)?;
            dict_set(mut d, py_str(key), value);
            at = a2;
        }
        return Ok((Val.Map(d), at));
    }
    if type_num == 8 {
        if size == 0 {
            return Ok((Val.Int(0), offset));
        }
        let mut b = slice(buf, offset, offset + size);
        if size != 4 {
            while (b.len() as i64) < 4 {
                b.insert(0, 0);
            }
        }
        let v = unpack_be(b, 4)? as i64;
        let signed = if v >= 0x80000000 { v - 0x100000000 } else { v };
        return Ok((Val.Int(signed), offset + size));
    }
    if type_num == 11 {
        let mut items: Vec[Val] = Vec.new();
        let mut at = offset;
        for _ in 0..size {
            let (value, a1) = decode(buf, base, at)?;
            items.push(value);
            at = a1;
        }
        return Ok((Val.Arr(items), at));
    }
    if type_num == 14 {
        return Ok((Val.Bool(size != 0), offset));
    }
    verify_size(size, 4)?;
    let bits = unpack_be(slice(buf, offset, offset + size), 4)?;
    Ok((Val.Float((bits as u32).bits_as_f32() as f64), offset + size))
}

fn decode_pointer(buf: ref Vec[u8], base: i64, size: i64, offset: i64) -> Result[(Val, i64), Exc] {
    let psize = (size >> 3) + 1;
    let raw = slice(buf, offset, offset + psize);
    let mut b: Vec[u8] = Vec.new();
    if psize == 2 {
        b.push(0);
    }
    if psize < 4 {
        b.push((size & 7) as u8);
    }
    for x in raw {
        b.push(x);
    }
    let pointer = if psize == 1 {
        unpack_be(b, 2)? as i64 + base
    } else if psize == 2 {
        unpack_be(b, 4)? as i64 + 2048 + base
    } else if psize == 3 {
        unpack_be(b, 4)? as i64 + 526336 + base
    } else {
        unpack_be(b, 4)? as i64 + base
    };
    let (value, _) = decode(buf, base, pointer)?;
    Ok((value, offset + psize))
}

// ------------------------------------------------------------ the reader

const DATA_SECTION_SEPARATOR_SIZE: i64 = 16;
const METADATA_KEYS: Array[Str, 9] = ["node_count", "record_size", "ip_version", "database_type", "languages",
    "binary_format_major_version", "binary_format_minor_version", "build_epoch", "description"];

struct Db {
    buf: Vec[u8],
    // Metadata.__dict__, in its order
    md: Vec[(String, Val)],
    node_count: i64,
    record_size: i64,
    ip_version: i64,
    db_type: String,
    node_byte_size: i64,
    tree_size: i64,
    ipv4_start: i64,
}

// b"\xab\xcd\xefMaxMind.com"
fn metadata_marker() -> Vec[u8] {
    let mut m: Vec[u8] = [0xABu8, 0xCDu8, 0xEFu8].to_vec();
    for x in "MaxMind.com".bytes() {
        m.push(x);
    }
    m
}

// buf.rfind(marker, start)
fn rfind(buf: ref Vec[u8], marker: ref Vec[u8], start: i64) -> i64 {
    let m = marker.len() as i64;
    let mut i = buf.len() as i64 - m;
    while i >= start {
        let mut k: i64 = 0;
        while k < m and buf[i + k] == marker[k] {
            k += 1;
        }
        if k == m {
            return i;
        }
        i -= 1;
    }
    -1
}

// maxminddb.open_database(path, MODE_MEMORY)
fn open_db(path: Str) -> Result[Db, Exc] {
    let buf = match fs.read_bytes(path) {
        Ok(b) => b,
        Err(_) => return Err(exc("FileNotFoundError", f"[Errno 2] No such file or directory: {py_str_repr(path)}")),
    };
    let size = buf.len() as i64;
    let start = if size > 128 * 1024 { size - 128 * 1024 } else { 0 };
    let marker = metadata_marker();
    let found = rfind(buf, marker, start);
    if found == -1 {
        return Err(invalid_db(f"Error opening database file ({path}). Is this a valid MaxMind DB file?"));
    }
    let md_start = found + marker.len() as i64;
    let (meta, _) = decode(buf, md_start, md_start)?;
    let raw = match meta {
        Val.Map(d) => d,
        _ => return Err(invalid_db(f"Error reading metadata in database file ({path}).")),
    };
    let mut md: Vec[(String, Val)] = Vec.new();
    for key in METADATA_KEYS {
        match dict_get(raw, key) {
            Some(v) => md.push((key.to_string(), v)),
            None => return Err(exc("KeyError", py_str_repr(key))),
        }
    }
    let node_count = int_of(md[0].1);
    let record_size = int_of(md[1].1);
    let node_byte_size = record_size / 4;
    let mut db = Db {
        buf: buf,
        md: md.clone(),
        node_count: node_count,
        record_size: record_size,
        ip_version: int_of(md[2].1),
        db_type: py_str(md[3].1),
        node_byte_size: node_byte_size,
        tree_size: node_count * node_byte_size,
        ipv4_start: 0,
    };
    if db.ip_version == 6 {
        let mut node: i64 = 0;
        for _ in 0..96 {
            if node >= db.node_count {
                break;
            }
            node = read_node(db, node, 0)?;
        }
        db.ipv4_start = node;
    }
    Ok(db)
}

fn metadata_repr(db: ref Db) -> String {
    let mut parts: Vec[String] = Vec.new();
    for p in db.md {
        parts.push(f"{p.0}={py_repr(p.1)}");
    }
    f"maxminddb.reader.Metadata({parts.join(", ")})"
}

fn read_node(db: ref Db, node: i64, index: i64) -> Result[i64, Exc] {
    let base_offset = node * db.node_byte_size;
    if db.record_size == 24 {
        let offset = base_offset + index * 3;
        let mut b: Vec[u8] = [0u8].to_vec();
        for x in slice(db.buf, offset, offset + 3) {
            b.push(x);
        }
        return Ok(unpack_be(b, 4)? as i64);
    }
    if db.record_size == 28 {
        let offset = base_offset + 3 * index;
        let mut b = slice(db.buf, offset, offset + 4);
        if index != 0 {
            if b.len() == 0 {
                return Err(exc("IndexError", "bytearray index out of range"));
            }
            b[0] = b[0] & 0x0F;
        } else {
            if b.len() == 0 {
                return Err(exc("IndexError", "pop from empty bytearray"));
            }
            let last = b.pop().unwrap_or(0);
            b.insert(0, (last & 0xF0) >> 4);
        }
        return Ok(unpack_be(b, 4)? as i64);
    }
    if db.record_size == 32 {
        let offset = base_offset + index * 4;
        return Ok(unpack_be(slice(db.buf, offset, offset + 4), 4)? as i64);
    }
    Err(invalid_db(f"Unknown record size: {db.record_size}"))
}

// The bit of a `width`-bit address, most significant first.
fn addr_bit(n: u128, width: i64, i: i64) -> i64 {
    ((n >> ((width - 1 - i) as u32)) & 1) as i64
}

fn find_address_in_tree(db: ref Db, a: ref Addr) -> Result[(i64, i64), Exc] {
    let bit_count: i64 = if a.v6 { 128 } else { 32 };
    let mut node = if db.ip_version == 6 and bit_count == 32 { db.ipv4_start } else { 0 };
    let mut i: i64 = 0;
    while i < bit_count and node < db.node_count {
        node = read_node(db, node, addr_bit(a.n, bit_count, i))?;
        i += 1;
    }
    if node == db.node_count {
        return Ok((0, i));
    }
    if node > db.node_count {
        return Ok((node, i));
    }
    Err(invalid_db("Invalid node in search tree"))
}

fn resolve_data_pointer(db: ref Db, pointer: i64) -> Result[Val, Exc] {
    let resolved = pointer - db.node_count + db.tree_size;
    if resolved >= db.buf.len() as i64 {
        return Err(invalid_db("The MaxMind DB file's search tree is corrupt"));
    }
    let (value, _) = decode(db.buf, db.tree_size + DATA_SECTION_SEPARATOR_SIZE, resolved)?;
    Ok(value)
}

// Reader.get_with_prefix_len
fn get_with_prefix_len(db: ref Db, ip: Str) -> Result[(Option[Val], i64), Exc] {
    let a = ip_address(ip)?;
    if a.v6 and db.ip_version == 4 {
        return Err(value_error(f"Error looking up {ip}. You attempted to look up an IPv6 address in an IPv4-only database."));
    }
    let (pointer, prefix_len) = find_address_in_tree(db, a)?;
    if pointer != 0 {
        return Ok((Some(resolve_data_pointer(db, pointer)?), prefix_len));
    }
    Ok((None, prefix_len))
}

// Reader.__iter__: the networks and their records in tree order. A
// failure ends the walk; what came before it is kept in `out`.
fn walk(db: ref Db, node: i64, depth: i64, acc: u128, out: mut ref Vec[(String, Val)]) -> Result[(), Exc] {
    if acc != 0 and node == db.ipv4_start {
        return Ok(());
    }
    if node > db.node_count {
        let bits: i64 = if db.ip_version == 6 { 128 } else { 32 };
        let shift = bits - depth;
        let full: u128 = if shift >= 128 { 0 } else { acc << (shift as u32) };
        let mut plen = depth;
        if full <= 4294967296 and bits == 128 {
            plen -= 96;
        }
        let net = network_from_int(full, plen)?;
        let value = resolve_data_pointer(db, node)?;
        out.push((net, value));
    } else if node < db.node_count {
        let left = read_node(db, node, 0)?;
        walk(db, left, depth + 1, acc << 1, mut out)?;
        let right = read_node(db, node, 1)?;
        walk(db, right, depth + 1, (acc << 1) | 1, mut out)?;
    }
    Ok(())
}

// ------------------------------------------------------------ ipaddress

// An IPv4Address (v6 false, n below 2**32) or an IPv6Address.
#[derive(Clone)]
struct Addr {
    v6: bool,
    n: u128,
}

fn is_hex_digit(c: char) -> bool {
    hex_val(c) >= 0
}

// IPv4Address._parse_octet
fn parse_octet(s: Str) -> Option[u128] {
    let cs: Vec[char] = s.chars().collect();
    if cs.len() == 0 or cs.len() > 3 {
        return None;
    }
    let mut v: u128 = 0;
    for c in cs {
        if c < '0' or c > '9' {
            return None;
        }
        v = v * 10 + (c as u32 - 48) as u128;
    }
    if cs.len() > 1 and cs[0] == '0' {
        return None;
    }
    if v > 255 {
        return None;
    }
    Some(v)
}

// IPv4Address(s)
fn parse_v4(s: Str) -> Option[u128] {
    if s.len() == 0 or s.contains("/") {
        return None;
    }
    let octets: Vec[Str] = s.split(".").collect();
    if octets.len() != 4 {
        return None;
    }
    let mut n: u128 = 0;
    for o in octets {
        n = (n << 8) | parse_octet(o)?;
    }
    Some(n)
}

// IPv6Address._parse_hextet
fn parse_hextet(s: Str) -> Option[u128] {
    let cs: Vec[char] = s.chars().collect();
    if cs.len() == 0 or cs.len() > 4 {
        return None;
    }
    let mut v: u128 = 0;
    for c in cs {
        if not is_hex_digit(c) {
            return None;
        }
        v = v * 16 + hex_val(c) as u128;
    }
    Some(v)
}

// IPv6Address(s), without scope ids.
fn parse_v6(s: Str) -> Option[u128] {
    if s.len() == 0 or s.len() > 45 or s.contains("/") or s.contains("%") {
        return None;
    }
    let mut parts: Vec[String] = Vec.new();
    for p in s.split(":") {
        parts.push(p.to_string());
    }
    if parts.len() < 3 {
        return None;
    }
    let last = parts[parts.len() - 1].clone();
    if last.contains(".") {
        let v4 = parse_v4(last)?;
        parts.pop();
        parts.push(f"{hex_n(((v4 >> 16) & 0xFFFF) as i64, 1)}");
        parts.push(f"{hex_n((v4 & 0xFFFF) as i64, 1)}");
    }
    if parts.len() > 9 {
        return None;
    }
    let count = parts.len() as i64;
    let mut skip: i64 = -1;
    let mut i: i64 = 1;
    while i < count - 1 {
        if parts[i].len() == 0 {
            if skip >= 0 {
                return None;
            }
            skip = i;
        }
        i += 1;
    }
    let mut hi: i64 = 0;
    let mut lo: i64 = 0;
    let mut skipped: i64 = 0;
    if skip >= 0 {
        hi = skip;
        lo = count - skip - 1;
        if parts[0].len() == 0 {
            hi -= 1;
            if hi != 0 {
                return None;
            }
        }
        if parts[count - 1].len() == 0 {
            lo -= 1;
            if lo != 0 {
                return None;
            }
        }
        skipped = 8 - (hi + lo);
        if skipped < 1 {
            return None;
        }
    } else {
        if count != 8 or parts[0].len() == 0 or parts[count - 1].len() == 0 {
            return None;
        }
        hi = count;
    }
    let mut n: u128 = 0;
    for k in 0..hi {
        n = (n << 16) | parse_hextet(parts[k])?;
    }
    if skipped >= 8 {
        n = 0;
    } else if skipped > 0 {
        n = n << ((16 * skipped) as u32);
    }
    let mut k = count - lo;
    while k < count {
        n = (n << 16) | parse_hextet(parts[k])?;
        k += 1;
    }
    Some(n)
}

// ipaddress.ip_address(s)
fn ip_address(s: Str) -> Result[Addr, Exc] {
    if let Some(n) = parse_v4(s) {
        return Ok(Addr { v6: false, n: n });
    }
    if let Some(n) = parse_v6(s) {
        return Ok(Addr { v6: true, n: n });
    }
    Err(value_error(f"{py_str_repr(s)} does not appear to be an IPv4 or IPv6 address"))
}

fn v4_str(n: u128) -> String {
    f"{(n >> 24) & 255}.{(n >> 16) & 255}.{(n >> 8) & 255}.{n & 255}"
}

// IPv6Address.__str__: the longest run of two or more zero hextets
// (the first of equal runs) becomes "::", and an IPv4-mapped address
// ends in its dotted quad.
fn v6_str(n: u128) -> String {
    if (n >> 32) == 0xFFFF {
        return f"::ffff:{v4_str(n & 0xFFFFFFFF)}";
    }
    let mut hextets: Vec[String] = Vec.new();
    for k in 0..8 {
        let h = ((n >> ((112 - 16 * k) as u32)) & 0xFFFF) as i64;
        hextets.push(if h == 0 { "0".to_string() } else { hex_n(h, 1) });
    }
    let mut best_start: i64 = -1;
    let mut best_len: i64 = 0;
    let mut start: i64 = -1;
    let mut run: i64 = 0;
    for k in 0..8 {
        if hextets[k] == "0" {
            run += 1;
            if start == -1 {
                start = k;
            }
            if run > best_len {
                best_len = run;
                best_start = start;
            }
        } else {
            run = 0;
            start = -1;
        }
    }
    if best_len <= 1 {
        return hextets.join(":");
    }
    let mut head: Vec[String] = Vec.new();
    for k in 0..best_start {
        head.push(hextets[k].clone());
    }
    let mut tail: Vec[String] = Vec.new();
    let mut k = best_start + best_len;
    while k < 8 {
        tail.push(hextets[k].clone());
        k += 1;
    }
    f"{head.join(":")}::{tail.join(":")}"
}

fn addr_str(a: ref Addr) -> String {
    if a.v6 { v6_str(a.n) } else { v4_str(a.n) }
}

fn mask_bits(n: u128, width: i64, plen: i64) -> u128 {
    let host = width - plen;
    if host >= 128 {
        return 0;
    }
    (n >> (host as u32)) << (host as u32)
}

// ipaddress.ip_network(f"{ip}/{prefix_len}", False)
fn network_of(ip: Str, prefix_len: i64) -> Result[String, Exc] {
    let a = ip_address(ip)?;
    let width: i64 = if a.v6 { 128 } else { 32 };
    if prefix_len < 0 or prefix_len > width {
        let text = f"{ip}/{prefix_len}";
        return Err(value_error(f"{py_str_repr(text)} does not appear to be an IPv4 or IPv6 network"));
    }
    let net = Addr { v6: a.v6, n: mask_bits(a.n, width, prefix_len) };
    Ok(f"{addr_str(net)}/{prefix_len}")
}

// ipaddress.ip_network((n, prefix_len)), which the reader's iterator
// builds: an IPv4Network when n fits in 32 bits, else an IPv6Network.
fn network_from_int(n: u128, prefix_len: i64) -> Result[String, Exc] {
    if n <= 0xFFFFFFFF and prefix_len >= 0 and prefix_len <= 32 {
        return Ok(f"{v4_str(n)}/{prefix_len}");
    }
    if prefix_len >= 0 and prefix_len <= 128 and mask_bits(n, 128, prefix_len) == n {
        return Ok(f"{v6_str(n)}/{prefix_len}");
    }
    Err(value_error(f"({uint_digits(u128_bytes(n))}, {prefix_len}) does not appear to be an IPv4 or IPv6 network"))
}

fn u128_bytes(n: u128) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    for k in 0..16 {
        out.push(((n >> ((120 - 8 * k) as u32)) & 255) as u8);
    }
    out
}

// ------------------------------------------------------------ geoip2

// geoip2.database.Reader: a database and the locales its names use.
struct Geo {
    db: Db,
    locales: Vec[String],
}

fn geo_open(path: Str, locales: Str) -> Result[Geo, Exc] {
    let db = open_db(path)?;
    let mut locs: Vec[String] = Vec.new();
    for l in locales.split(",") {
        locs.push(l.to_string());
    }
    Ok(Geo { db: db, locales: locs })
}

fn py_type_name(v: ref Val) -> String {
    let name = match v {
        Val.Str(_) => "str",
        Val.Double(_) => "float",
        Val.Float(_) => "float",
        Val.Bytes(_) => "bytes",
        Val.UInt(_) => "int",
        Val.Int(_) => "int",
        Val.Bool(_) => "bool",
        Val.Map(_) => "dict",
        Val.Arr(_) => "list",
    };
    name.to_string()
}

// Reader._get: the record and its prefix length, for a method the
// database type allows.
fn geo_get(g: ref Geo, wanted: Str, method: Str, ip: Str) -> Result[(Vec[(String, Val)], i64), Exc] {
    if not g.db.db_type.contains(wanted) {
        return Err(exc("TypeError", f"The {method} method cannot be used with the {g.db.db_type} database"));
    }
    let (record, prefix_len) = get_with_prefix_len(g.db, ip)?;
    match record {
        None => Err(Exc {
            kind: "AddressNotFoundError".to_string(),
            msg: f"The address {ip} is not in the database.",
            ip: ip.to_string(),
            prefix: prefix_len,
        }),
        Some(Val.Map(d)) => Ok((d, prefix_len)),
        Some(other) => Err(exc("AttributeError", f"'{py_type_name(other)}' object has no attribute 'setdefault'")),
    }
}

fn map_of(v: ref Val) -> Vec[(String, Val)] {
    match v {
        Val.Map(d) => d.clone(),
        _ => Vec.new(),
    }
}

// raw.get(key, {})
fn sub(m: ref Vec[(String, Val)], key: Str) -> Vec[(String, Val)] {
    match dict_get(m, key) {
        Some(Val.Map(d)) => d,
        _ => Vec.new(),
    }
}

fn show(v: ref Option[Val]) -> String {
    match v {
        Some(x) => py_str(x),
        None => "-".to_string(),
    }
}

// PlaceRecord.name: the name in the first locale that has one.
fn place_name(m: ref Vec[(String, Val)], locales: ref Vec[String]) -> Option[Val] {
    let names = sub(m, "names");
    for loc in locales {
        if let Some(v) = dict_get(names, loc) {
            return Some(v);
        }
    }
    None
}

// A place as `name (iso)`, or `-`.
fn place(m: ref Vec[(String, Val)], locales: ref Vec[String]) -> String {
    let name = place_name(m, locales);
    let iso = dict_get(m, "iso_code");
    match iso {
        Some(code) => f"{show(name)} ({py_str(code)})",
        None => show(name),
    }
}

fn flag(m: ref Vec[(String, Val)], key: Str) -> bool {
    match dict_get(m, key) {
        Some(v) => truthy(v),
        None => false,
    }
}

const TRAIT_FLAGS: Array[Str, 4] = ["is_anonymous_proxy", "is_anycast", "is_satellite_provider", "is_legitimate_proxy"];

fn country_lines(raw: ref Vec[(String, Val)], locales: ref Vec[String], ip: Str, prefix_len: i64) -> Result[Vec[String], Exc] {
    let country = sub(raw, "country");
    let eu = dict_get(country, "is_in_european_union").unwrap_or(Val.Bool(false));
    let continent = sub(raw, "continent");
    let rep = sub(raw, "represented_country");
    let traits = sub(raw, "traits");
    let mut flags: Vec[String] = Vec.new();
    for k in TRAIT_FLAGS {
        if flag(traits, k) {
            flags.push(k.to_string());
        }
    }
    let flag_text = if flags.len() == 0 { "-".to_string() } else { flags.join(",") };
    let mut out: Vec[String] = Vec.new();
    out.push(f"country {place(country, locales)} eu={py_str(eu)} geoname={show(dict_get(country, "geoname_id"))}");
    out.push(f"continent {show(dict_get(continent, "code"))} {show(place_name(continent, locales))}");
    out.push(f"registered {place(sub(raw, "registered_country"), locales)}");
    out.push(f"represented {place(rep, locales)} type={show(dict_get(rep, "type"))}");
    out.push(f"traits ip {ip} network {network_of(ip, prefix_len)?} flags {flag_text}");
    Ok(out)
}

fn city_lines(raw: ref Vec[(String, Val)], locales: ref Vec[String], ip: Str, prefix_len: i64) -> Result[Vec[String], Exc] {
    let city = sub(raw, "city");
    let mut subs: Vec[Vec[(String, Val)]] = Vec.new();
    if let Some(Val.Arr(items)) = dict_get(raw, "subdivisions") {
        for x in items {
            match x {
                Val.Map(d) => subs.push(d.clone()),
                _ => subs.push(Vec.new()),
            }
        }
    }
    let most_specific = if subs.len() > 0 { subs[subs.len() - 1].clone() } else { Vec.new() };
    let mut sub_line = f"subdivision {place(most_specific, locales)} of {subs.len()}";
    for s in subs {
        let iso = match dict_get(s, "iso_code") {
            Some(v) => py_str(v),
            None => "None".to_string(),
        };
        sub_line.push_str(f" / {iso}");
    }
    let loc = sub(raw, "location");
    let mut out: Vec[String] = Vec.new();
    out.push(f"city {show(place_name(city, locales))} geoname={show(dict_get(city, "geoname_id"))}");
    out.push(sub_line);
    out.push(f"location {show(dict_get(loc, "latitude"))},{show(dict_get(loc, "longitude"))} radius={show(dict_get(loc, "accuracy_radius"))} tz={show(dict_get(loc, "time_zone"))} metro={show(dict_get(loc, "metro_code"))}");
    out.push(f"postal {show(dict_get(sub(raw, "postal"), "code"))}");
    for ln in country_lines(raw, locales, ip, prefix_len)?.into_iter() {
        out.push(ln);
    }
    Ok(out)
}

fn geo_city(g: ref Geo, ip: Str) -> Result[(Vec[(String, Val)], i64), Exc] {
    geo_get(g, "City", "city", ip)
}

fn geo_asn(g: ref Geo, ip: Str) -> Result[(Vec[(String, Val)], i64), Exc] {
    geo_get(g, "GeoLite2-ASN", "asn", ip)
}

// ------------------------------------------------------------ the jobs

fn job_meta(path: Str) -> Result[(), Exc] {
    let db = open_db(path)?;
    println(metadata_repr(db));
    println(f"node_byte_size={db.node_byte_size} search_tree_size={db.tree_size}");
    Ok(())
}

fn job_get(path: Str, ip: Str) -> Result[(), Exc] {
    let db = open_db(path)?;
    let (record, prefix_len) = get_with_prefix_len(db, ip)?;
    let text = match record {
        Some(v) => py_repr(v),
        None => "None".to_string(),
    };
    println(f"/{prefix_len} {text}");
    Ok(())
}

fn job_dump(path: Str, short: bool) -> Result[(), Exc] {
    let db = open_db(path)?;
    let mut out: Vec[(String, Val)] = Vec.new();
    let walked = walk(db, 0, 0, 0, mut out);
    for p in out {
        if short {
            let country = match dict_get(sub(map_of(p.1), "country"), "iso_code") {
                Some(v) => py_str(v),
                None => "--".to_string(),
            };
            let city = match dict_get(sub(sub(map_of(p.1), "city"), "names"), "en") {
                Some(v) => py_str(v),
                None => "-".to_string(),
            };
            println(f"{p.0} {country} {city}");
        } else {
            println(f"{p.0} {py_repr(p.1)}");
        }
    }
    walked?;
    println(f"{out.len()} networks");
    Ok(())
}

fn job_city(path: Str, ip: Str, locales: Str) -> Result[(), Exc] {
    let g = geo_open(path, locales)?;
    let (raw, prefix_len) = geo_city(g, ip)?;
    for ln in city_lines(raw, g.locales, ip, prefix_len)? {
        println(ln);
    }
    Ok(())
}

fn job_country(path: Str, ip: Str, locales: Str) -> Result[(), Exc] {
    let g = geo_open(path, locales)?;
    let (raw, prefix_len) = geo_get(g, "Country", "country", ip)?;
    for ln in country_lines(raw, g.locales, ip, prefix_len)? {
        println(ln);
    }
    Ok(())
}

fn job_asn(path: Str, ip: Str, locales: Str) -> Result[(), Exc] {
    let g = geo_open(path, locales)?;
    let (raw, prefix_len) = geo_asn(g, ip)?;
    let number = show(dict_get(raw, "autonomous_system_number"));
    let org = show(dict_get(raw, "autonomous_system_organization"));
    println(f"AS{number} {org} network {network_of(ip, prefix_len)?} ip {ip}");
    Ok(())
}

fn read_text(path: Str) -> Result[String, Exc] {
    match fs.read_to_string(path) {
        Ok(s) => Ok(s),
        Err(_) => Err(exc("FileNotFoundError", f"[Errno 2] No such file or directory: {py_str_repr(path)}")),
    }
}

// s.split(sep)[k]
fn split_at(s: Str, sep: Str, k: i64) -> Result[String, Exc] {
    let parts: Vec[Str] = s.split(sep).collect();
    if k >= parts.len() as i64 {
        return Err(exc("IndexError", "list index out of range"));
    }
    Ok(parts[k].to_string())
}

// int(s) for the log's byte counts
fn parse_int(s: Str) -> Result[i64, Exc] {
    let mut v: i64 = 0;
    if s.len() == 0 {
        return Err(value_error(f"invalid literal for int() with base 10: {py_str_repr(s)}"));
    }
    for c in s.chars() {
        if c < '0' or c > '9' {
            return Err(value_error(f"invalid literal for int() with base 10: {py_str_repr(s)}"));
        }
        v = v * 10 + (c as u32 - 48) as i64;
    }
    Ok(v)
}

fn job_annotate(log: Str) -> Result[(), Exc] {
    let city = geo_open("city.mmdb", "en")?;
    let asn = geo_open("asn.mmdb", "en")?;
    let mut by_country: Vec[(String, i64, i64)] = Vec.new();
    let mut by_asn: Vec[(i64, i64, i64)] = Vec.new();
    let mut unknown: i64 = 0;
    let text = read_text(log)?;
    let mut no: i64 = 0;
    for line in text.split("\n") {
        no += 1;
        if line.len() == 0 {
            continue;
        }
        let ip = split_at(line, " ", 0)?;
        let size = match line.rfind(" ") {
            Some(k) => parse_int(line[k + 1..])?,
            None => return Err(exc("IndexError", "list index out of range")),
        };
        if let Err(e) = ip_address(ip) {
            println(f"line {no}: {e.msg}");
            continue;
        }
        let mut key = "??".to_string();
        let where_ = match geo_city(city, ip) {
            Ok((raw, _)) => {
                let iso = dict_get(sub(raw, "country"), "iso_code");
                key = match iso {
                    Some(ref v) => py_str(v),
                    None => "--".to_string(),
                };
                f"{show(iso)} {show(place_name(sub(raw, "city"), city.locales))}"
            },
            Err(e) => {
                if e.kind != "AddressNotFoundError" {
                    return Err(e);
                }
                unknown += 1;
                f"not found ({network_of(e.ip, e.prefix)?})"
            },
        };
        let (who, akey) = match geo_asn(asn, ip) {
            Ok((raw, _)) => {
                let number = dict_get(raw, "autonomous_system_number");
                let n = match number {
                    Some(ref v) => int_of(v),
                    None => 0,
                };
                let shown = match number {
                    Some(v) => py_str(v),
                    None => "None".to_string(),
                };
                (f"AS{shown}", n)
            },
            Err(e) => {
                if e.kind != "AddressNotFoundError" {
                    return Err(e);
                }
                ("AS?".to_string(), 0)
            },
        };
        println(f"{no} {ip} {where_} {who}");
        let mut found = false;
        for i in 0..by_country.len() {
            if by_country[i].0 == key {
                by_country[i].1 += 1;
                by_country[i].2 += size;
                found = true;
            }
        }
        if not found {
            by_country.push((key, 1, size));
        }
        found = false;
        for i in 0..by_asn.len() {
            if by_asn[i].0 == akey {
                by_asn[i].1 += 1;
                by_asn[i].2 += size;
                found = true;
            }
        }
        if not found {
            by_asn.push((akey, 1, size));
        }
    }
    by_country.sort_by(|a, b| if a.1 != b.1 { b.1.cmp(a.1) } else { a.0.cmp(b.0) });
    by_asn.sort_by(|a, b| if a.1 != b.1 { b.1.cmp(a.1) } else { a.0.cmp(b.0) });
    for c in by_country {
        println(f"country {c.0}: {c.1} requests, {c.2} bytes");
    }
    let mut shown: i64 = 0;
    for a in by_asn {
        if shown == 6 {
            break;
        }
        println(f"asn {a.0}: {a.1} requests, {a.2} bytes");
        shown += 1;
    }
    println(f"{unknown} addresses not in the city database");
    Ok(())
}

struct Rule {
    no: i64,
    text: String,
    words: Vec[String],
}

fn parse_policy(path: Str) -> Result[Vec[Rule], Exc] {
    let text = read_text(path)?;
    let mut rules: Vec[Rule] = Vec.new();
    let mut no: i64 = 0;
    for raw in text.split("\n") {
        no += 1;
        let line = raw.trim();
        if line.len() == 0 or line.starts_with("#") {
            continue;
        }
        let mut words: Vec[String] = Vec.new();
        for w in line.split(" ") {
            words.push(w.to_string());
        }
        if words[0] != "allow" and words[0] != "deny" and words[0] != "default" {
            return Err(value_error(f"policy line {no}: unknown action {py_str_repr(words[0])}"));
        }
        rules.push(Rule { no: no, text: line.to_string(), words: words });
    }
    Ok(rules)
}

fn iso_is(m: ref Vec[(String, Val)], key: Str, field: Str, want: Str) -> bool {
    match dict_get(sub(m, key), field) {
        Some(Val.Str(s)) => s == want,
        _ => false,
    }
}

fn rule_matches(words: ref Vec[String], c: ref Option[Vec[(String, Val)]], a: ref Option[Vec[(String, Val)]]) -> Result[bool, Exc] {
    if words.len() < 2 {
        return Err(exc("IndexError", "list index out of range"));
    }
    let what = words[1].clone();
    if what == "allow" or what == "deny" {
        return Ok(true);
    }
    let arg = if words.len() > 2 { words[2].clone() } else { String.new() };
    if what == "unknown" {
        return Ok(c.is_none());
    }
    if what == "asn" {
        return Ok(match a {
            Some(raw) => {
                let shown = match dict_get(raw, "autonomous_system_number") {
                    Some(v) => py_str(v),
                    None => "None".to_string(),
                };
                shown == arg
            },
            None => false,
        });
    }
    if what != "country" and what != "registered" and what != "represented" and what != "continent"
        and what != "anycast" and what != "satellite" {
        return Err(value_error(f"unknown condition {py_str_repr(what)}"));
    }
    let raw = match c {
        Some(r) => r,
        None => return Ok(false),
    };
    if what == "country" {
        return Ok(iso_is(raw, "country", "iso_code", arg));
    }
    if what == "registered" {
        return Ok(iso_is(raw, "registered_country", "iso_code", arg));
    }
    if what == "represented" {
        return Ok(iso_is(raw, "represented_country", "type", arg));
    }
    if what == "continent" {
        return Ok(iso_is(raw, "continent", "code", arg));
    }
    if what == "anycast" {
        return Ok(flag(sub(raw, "traits"), "is_anycast"));
    }
    Ok(flag(sub(raw, "traits"), "is_satellite_provider"))
}

// A lookup that finds nothing is None; any other failure stops the run.
fn lookup(r: own Result[(Vec[(String, Val)], i64), Exc]) -> Result[Option[Vec[(String, Val)]], Exc] {
    match r {
        Ok((raw, _)) => Ok(Some(raw)),
        Err(e) => if e.kind == "AddressNotFoundError" { Ok(None) } else { Err(e) },
    }
}

fn job_firewall(policy: Str, log: Str) -> Result[(), Exc] {
    let rules = parse_policy(policy)?;
    let city = geo_open("city.mmdb", "en")?;
    let asn = geo_open("asn.mmdb", "en")?;
    let mut hits: Vec[i64] = Vec.filled(rules.len(), 0);
    let mut allowed: i64 = 0;
    let mut denied: i64 = 0;
    let text = read_text(log)?;
    let mut no: i64 = 0;
    for line in text.split("\n") {
        no += 1;
        if line.len() == 0 {
            continue;
        }
        let ip = split_at(line, " ", 0)?;
        let path = split_at(split_at(line, "\"", 1)?, " ", 1)?;
        if ip_address(ip).is_err() {
            println(f"line {no}: skipped, bad address {py_str_repr(ip)}");
            continue;
        }
        let c = lookup(geo_city(city, ip))?;
        let a = lookup(geo_asn(asn, ip))?;
        for i in 0..rules.len() {
            if rule_matches(rules[i].words, c, a)? {
                hits[i] += 1;
                let w = rules[i].words.clone();
                let action = if w[0] != "default" { w[0].clone() } else { w[1].clone() };
                if action == "deny" {
                    denied += 1;
                    println(f"line {no}: deny {ip} {path} (rule {rules[i].no}: {rules[i].text})");
                } else {
                    allowed += 1;
                }
                break;
            }
        }
    }
    for i in 0..rules.len() {
        println(f"rule {rules[i].no} {rules[i].text}: {hits[i]}");
    }
    println(f"{allowed} allowed, {denied} denied");
    Ok(())
}

// ------------------------------------------------------------ main

fn hex_text(s: Str) -> String {
    String.from_utf8(from_hex(s)).unwrap_or(String.new())
}

fn unrle(s: Str) -> Vec[u8] {
    let cs: Vec[char] = s.chars().collect();
    let n = cs.len() as i64;
    let mut out: Vec[u8] = Vec.new();
    let mut k: i64 = 0;
    while k < n {
        if cs[k] == 'z' {
            let mut j = k + 1;
            let mut count: i64 = 0;
            while cs[j] != '.' {
                count = count * 10 + (cs[j] as i64 - 48);
                j += 1;
            }
            for _ in 0..count {
                out.push(0);
            }
            k = j + 1;
        } else {
            out.push((hex_val(cs[k]) * 16 + hex_val(cs[k + 1])) as u8);
            k += 2;
        }
    }
    out
}

// The input files, from inputs_text(), written to the working
// directory; returns their names.
fn write_inputs() -> Result[Vec[String], String] {
    let mut names: Vec[String] = Vec.new();
    for line in inputs_text().split("\n") {
        if line.len() == 0 {
            continue;
        }
        let (name, body) = match line.find(" ") {
            Some(k) => (line[..k].to_string(), line[k + 1..].to_string()),
            None => (line.to_string(), String.new()),
        };
        if let Err(e) = fs.write_bytes(name.clone(), unrle(body)) {
            return Err(f"cannot write {name}: {e}");
        }
        names.push(name);
    }
    Ok(names)
}

fn arg(args: ref Vec[String], k: i64) -> String {
    if k < args.len() as i64 { args[k].clone() } else { String.new() }
}

fn run_job(args: ref Vec[String]) -> Result[(), Exc] {
    let kind = arg(args, 0);
    if kind == "meta" {
        return job_meta(arg(args, 1));
    }
    if kind == "get" {
        return job_get(arg(args, 1), arg(args, 2));
    }
    if kind == "dump" {
        return job_dump(arg(args, 1), false);
    }
    if kind == "networks" {
        return job_dump(arg(args, 1), true);
    }
    if kind == "city" {
        return job_city(arg(args, 1), arg(args, 2), arg(args, 3));
    }
    if kind == "country" {
        return job_country(arg(args, 1), arg(args, 2), arg(args, 3));
    }
    if kind == "asn" {
        return job_asn(arg(args, 1), arg(args, 2), arg(args, 3));
    }
    if kind == "annotate" {
        return job_annotate(arg(args, 1));
    }
    if kind == "firewall" {
        return job_firewall(arg(args, 1), arg(args, 2));
    }
    Err(exc("KeyError", py_str_repr(kind)))
}

fn main() {
    let names = match write_inputs() {
        Ok(n) => n,
        Err(e) => {
            eprintln(e);
            return;
        },
    };
    for hex_line in jobs_text().split("\n") {
        if hex_line.len() == 0 {
            continue;
        }
        let line = hex_text(hex_line);
        let mut args: Vec[String] = Vec.new();
        for a in line.split("\t") {
            args.push(a.to_string());
        }
        println(f"== {args.join(" | ")}");
        if let Err(e) = run_job(args) {
            println(show_exc(e));
        }
    }
    for name in names {
        let _ = fs.remove_file(name);
    }
}

