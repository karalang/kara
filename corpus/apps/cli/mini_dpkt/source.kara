// BY_CODE.get(code)
fn suite_by_code(code: i64) -> Option[Suite] {
    if code <= 0x00af {
        suites_0(code)
    } else if code <= 0xc04f {
        suites_1(code)
    } else {
        suites_2(code)
    }
}
