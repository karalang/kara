fn data_1() -> DataFile {
    let mut t = String.new();
    t.push_str("# mini_dpkt jobs\n");
    t.push_str("info office.pcap\n");
    t.push_str("info capture.pcapng\n");
    t.push_str("info nano.pcap\n");
    t.push_str("info notes.txt\n");
    t.push_str("list office.pcap\n");
    t.push_str("list capture.pcapng\n");
    t.push_str("list nano.pcap\n");
    t.push_str("repr office.pcap 1 3 5 6 8 12 14 19 22 24 25 27 28 29 31 33 34 36 37 38\n");
    t.push_str("hexdump office.pcap 1 26\n");
    t.push_str("dns office.pcap\n");
    t.push_str("dhcp office.pcap\n");
    t.push_str("ntp office.pcap\n");
    t.push_str("http office.pcap\n");
    t.push_str("http capture.pcapng\n");
    t.push_str("tls office.pcap\n");
    t.push_str("checksums office.pcap\n");
    t.push_str("stats office.pcap\n");
    t.push_str("ngblocks capture.pcapng\n");
    t.push_str("build\n");
    t.push_str("errors\n");
    t.push_str("summary\n");
    DataFile { path: "jobs.txt".to_string(), body: t, hex: false }
}

