// mini_natsort: natural sorting as natsort 8.4.0 does it, the library
// Python programs use to put file names, versions and labels in the
// order a person expects ("file2" before "file10"). The port covers:
// - natsorted, realsorted, index_natsorted, index_realsorted and
//   order_by_index, with reverse, a key function and PRESORT;
// - the key natsort builds: the string normalized to NFD (or NFKD with
//   COMPATIBILITYNORMALIZE), split around its numbers by natsort's
//   regular expressions, the numbers converted as fastnumbers would
//   (here, its pure-Python stand-in), and separators put between them;
// - the int, float, signed and exponent-free number forms, Unicode
//   digits, superscripts and fractions, inf and nan;
// - IGNORECASE, LOWERCASEFIRST, GROUPLETTERS, NANLAST and NUMAFTER;
// - PATH, which splits a path into its parts and the file name into its
//   base and up to two suffixes;
// - keys for numbers, None and nested lists, where ints and floats
//   compare exactly as Python compares them, however long the int;
// - the natsort command line: -p, -f, -F, -e, -r, -t, -s, --nosign and
//   --noexp.
//
// Python's float() is ported too: Unicode digits and spaces, underscores,
// and correct rounding for any number of digits. The character data
// (decompositions, case mappings, combining classes, numeric values) is
// read from data/unicode.txt, which mk.py takes from Python's
// unicodedata. expected.out is the output of oracle.py, which runs the
// jobs through natsort itself.

// ------------------------------------------------------------ text

fn chars_of(s: Str) -> Vec[char] {
    s.chars().collect()
}

fn str_of(cs: ref Vec[char]) -> String {
    let mut s = String.new();
    for c in cs.iter() {
        s.push(*c);
    }
    s
}

fn sub_chars(cs: ref Vec[char], from: i64, to: i64) -> Vec[char] {
    let mut v: Vec[char] = Vec.new();
    for i in from..to {
        v.push(cs[i]);
    }
    v
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    for i in 0..parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
    }
    out
}

fn ascii_lower(c: char) -> char {
    if c >= 'A' and c <= 'Z' {
        char.try_from((c as u32) + 32).unwrap_or(c)
    } else {
        c
    }
}

fn hex_char(n: u32) -> char {
    let h: Vec[char] = "0123456789abcdef".chars().collect();
    h[(n & 15) as i64]
}

// n in lowercase hex, padded with zeros to width digits.
fn hex_pad(n: u32, width: i64) -> String {
    let mut ds: Vec[char] = Vec.new();
    let mut m = n;
    while m > 0 {
        ds.push(hex_char(m));
        m = m / 16;
    }
    while ds.len() < width {
        ds.push('0');
    }
    let mut s = String.new();
    let mut i = ds.len() - 1;
    while i >= 0 {
        s.push(ds[i]);
        i -= 1;
    }
    s
}

fn hex_parse(s: Str) -> u64 {
    let mut n: u64 = 0;
    for c in s.chars() {
        let d = if c >= '0' and c <= '9' {
            (c as u32) - ('0' as u32)
        } else {
            (c as u32) - ('a' as u32) + 10
        };
        n = n * 16 + (d as u64);
    }
    n
}

fn dec_parse(s: Str) -> i64 {
    let mut n: i64 = 0;
    for c in s.chars() {
        n = n * 10 + ((c as u32) - ('0' as u32)) as i64;
    }
    n
}

// ------------------------------------------------------------ JSON in

// The jobs file holds strings, numbers, booleans, null, arrays and
// objects. An int keeps its digits, since some are wider than 64 bits.
#[derive(Clone)]
enum J {
    S(String),
    N(String),
    F(f64),
    A(Vec[J]),
    O(Vec[(String, J)]),
    B(bool),
    Null,
}

fn json_space(c: char) -> bool {
    c == ' ' or c == '\n' or c == '\r' or c == '\t'
}

fn json_num_char(c: char) -> bool {
    (c >= '0' and c <= '9') or c == '-' or c == '+' or c == '.' or c == 'e' or c == 'E'
}

struct JsonIn {
    cs: Vec[char],
    pos: i64,
}

impl JsonIn {
    fn ws(mut ref self) {
        while self.pos < self.cs.len() and json_space(self.cs[self.pos]) {
            self.pos += 1;
        }
    }

    fn word(mut ref self, w: Str) -> bool {
        let wc: Vec[char] = w.chars().collect();
        if self.pos + wc.len() > self.cs.len() {
            return false;
        }
        let mut k = 0;
        while k < wc.len() {
            if self.cs[self.pos + k] != wc[k] {
                return false;
            }
            k += 1;
        }
        self.pos += wc.len();
        true
    }

    fn hex4(mut ref self) -> u32 {
        let mut n: u32 = 0;
        let mut k = 0;
        while k < 4 {
            let c = ascii_lower(self.cs[self.pos]);
            let d = if c >= '0' and c <= '9' {
                (c as u32) - ('0' as u32)
            } else {
                (c as u32) - ('a' as u32) + 10
            };
            n = n * 16 + d;
            self.pos += 1;
            k += 1;
        }
        n
    }

    fn value(mut ref self, uni: ref Uni) -> Result[J, String] {
        self.ws();
        if self.pos >= self.cs.len() {
            return Err("unexpected end of JSON".to_string());
        }
        let c = self.cs[self.pos];
        if c == '[' {
            self.pos += 1;
            let mut items: Vec[J] = Vec.new();
            self.ws();
            if self.pos < self.cs.len() and self.cs[self.pos] == ']' {
                self.pos += 1;
                return Ok(J.A(items));
            }
            loop {
                items.push(self.value(uni)?);
                self.ws();
                if self.pos >= self.cs.len() {
                    return Err("unterminated JSON array".to_string());
                }
                let d = self.cs[self.pos];
                self.pos += 1;
                if d == ']' {
                    return Ok(J.A(items));
                }
                if d != ',' {
                    return Err(f"bad JSON array separator {d}");
                }
            }
        }
        if c == '{' {
            self.pos += 1;
            let mut members: Vec[(String, J)] = Vec.new();
            self.ws();
            if self.pos < self.cs.len() and self.cs[self.pos] == '}' {
                self.pos += 1;
                return Ok(J.O(members));
            }
            loop {
                let key = match self.value(uni)? {
                    J.S(k) => k,
                    _ => return Err("JSON object key is not a string".to_string()),
                };
                self.ws();
                if self.pos >= self.cs.len() or self.cs[self.pos] != ':' {
                    return Err("missing ':' in JSON object".to_string());
                }
                self.pos += 1;
                let v = self.value(uni)?;
                members.push((key, v));
                self.ws();
                if self.pos >= self.cs.len() {
                    return Err("unterminated JSON object".to_string());
                }
                let d = self.cs[self.pos];
                self.pos += 1;
                if d == '}' {
                    return Ok(J.O(members));
                }
                if d != ',' {
                    return Err(f"bad JSON object separator {d}");
                }
            }
        }
        if self.word("true") {
            return Ok(J.B(true));
        }
        if self.word("false") {
            return Ok(J.B(false));
        }
        if self.word("null") {
            return Ok(J.Null);
        }
        if c == '-' or (c >= '0' and c <= '9') {
            let st = self.pos;
            let mut is_float = false;
            while self.pos < self.cs.len() and json_num_char(self.cs[self.pos]) {
                let d = self.cs[self.pos];
                if d == '.' or d == 'e' or d == 'E' {
                    is_float = true;
                }
                self.pos += 1;
            }
            let text = sub_chars(self.cs, st, self.pos);
            if is_float {
                return match py_float(text, uni) {
                    Some(x) => Ok(J.F(x)),
                    None => Err(f"bad JSON number {str_of(text)}"),
                };
            }
            return match py_int(text, uni) {
                Some(n) => Ok(J.N(n)),
                None => Err(f"bad JSON number {str_of(text)}"),
            };
        }
        if c != '"' {
            return Err(f"unexpected JSON character {c}");
        }
        self.pos += 1;
        let mut s = String.new();
        while self.pos < self.cs.len() {
            let d = self.cs[self.pos];
            self.pos += 1;
            if d == '"' {
                return Ok(J.S(s));
            }
            if d != '\\' {
                s.push(d);
                continue;
            }
            let e = self.cs[self.pos];
            self.pos += 1;
            if e == 'n' {
                s.push('\n');
            } else if e == 't' {
                s.push('\t');
            } else if e == 'r' {
                s.push('\r');
            } else if e == 'b' {
                s.push('\u{8}');
            } else if e == 'f' {
                s.push('\u{c}');
            } else if e == 'u' {
                let mut n = self.hex4();
                if n >= 0xD800 and n < 0xDC00 {
                    self.pos += 2;
                    let lo = self.hex4();
                    n = 0x10000 + ((n - 0xD800) << 10) + (lo - 0xDC00);
                }
                s.push(char.try_from(n).unwrap_or('?'));
            } else {
                s.push(e);
            }
        }
        Err("unterminated JSON string".to_string())
    }
}

fn json_line(l: ref String, uni: ref Uni) -> Result[J, String] {
    let mut p = JsonIn { cs: l.chars().collect(), pos: 0 };
    p.value(uni)
}

fn j_get(j: ref J, key: Str) -> J {
    match j {
        J.O(members) => {
            for (k, v) in members.iter() {
                if k == key {
                    return v.clone();
                }
            }
            J.Null
        }
        _ => J.Null,
    }
}

fn j_str(j: ref J, key: Str) -> String {
    match j_get(j, key) {
        J.S(s) => s,
        _ => String.new(),
    }
}

fn j_bool(j: ref J, key: Str) -> bool {
    match j_get(j, key) {
        J.B(b) => b,
        _ => false,
    }
}

fn j_strs(j: ref J, key: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    if let J.A(items) = j_get(j, key) {
        for it in items.iter() {
            if let J.S(s) = it {
                out.push(s.clone());
            }
        }
    }
    out
}

// Whether the object has the member at all.
fn j_present(j: ref J, key: Str) -> bool {
    if let J.O(members) = j {
        for (k, _) in members.iter() {
            if k == key {
                return true;
            }
        }
    }
    false
}


// ------------------------------------------------------------ characters

// What unicodedata says about one character. A mapping that is empty
// means the character maps to itself.
struct UInfo {
    nfd: Vec[char],
    nfkd: Vec[char],
    fold: Vec[char],
    swap: Vec[char],
    printable: bool,
    space: bool,
    // In natsort's own table of numeric characters (numeric_hex).
    listed: bool,
    ccc: i64,
    // -1 when the character has none.
    dec: i64,
    dig: i64,
    has_num: bool,
    num: f64,
}

struct Uni {
    index: Map[i64, i64],
    infos: Vec[UInfo],
}

fn cp_list(s: Str) -> Vec[char] {
    let mut out: Vec[char] = Vec.new();
    if s.len() == 0 {
        return out;
    }
    for h in s.split(" ") {
        out.push(char.try_from(hex_parse(h) as u32).unwrap_or('?'));
    }
    out
}

fn has_flag(flags: Str, f: char) -> bool {
    for c in flags.chars() {
        if c == f {
            return true;
        }
    }
    false
}

fn opt_int(s: Str) -> i64 {
    if s.len() == 0 { -1 } else { dec_parse(s) }
}

fn load_uni(text: ref String) -> Uni {
    let mut u = Uni { index: Map.new(), infos: Vec.new() };
    for line in text.lines() {
        if line.len() == 0 or line.starts_with("#") {
            continue;
        }
        let f: Vec[Str] = line.split(";").collect();
        let cp = hex_parse(f[0]) as i64;
        let has_num = f[9].len() > 0;
        let info = UInfo {
            nfd: cp_list(f[1]),
            nfkd: cp_list(f[2]),
            fold: cp_list(f[3]),
            swap: cp_list(f[4]),
            printable: not has_flag(f[5], 'p'),
            space: has_flag(f[5], 'w'),
            listed: has_flag(f[5], 'n'),
            ccc: if f[6].len() == 0 { 0 } else { dec_parse(f[6]) },
            dec: opt_int(f[7]),
            dig: opt_int(f[8]),
            has_num: has_num,
            num: if has_num { hex_parse(f[9]).bits_as_f64() } else { 0.0 },
        };
        u.index.insert(cp, u.infos.len());
        u.infos.push(info);
    }
    u
}

impl Uni {
    fn at(ref self, c: char) -> i64 {
        match self.index.get((c as u32) as i64) {
            Some(i) => *i,
            None => -1,
        }
    }

    fn ccc(ref self, c: char) -> i64 {
        let i = self.at(c);
        if i < 0 { 0 } else { self.infos[i].ccc }
    }

    fn dec(ref self, c: char) -> i64 {
        let i = self.at(c);
        if i < 0 { -1 } else { self.infos[i].dec }
    }

    fn dig(ref self, c: char) -> i64 {
        let i = self.at(c);
        if i < 0 { -1 } else { self.infos[i].dig }
    }

    fn is_space(ref self, c: char) -> bool {
        let i = self.at(c);
        i >= 0 and self.infos[i].space
    }

    fn printable(ref self, c: char) -> bool {
        let i = self.at(c);
        i < 0 or self.infos[i].printable
    }

    // \d in a str pattern: a decimal digit of any script.
    fn is_decimal(ref self, c: char) -> bool {
        self.dec(c) >= 0
    }

    // In natsort's digits_no_decimals: a digit such as a superscript.
    fn digit_class(ref self, c: char) -> bool {
        let i = self.at(c);
        i >= 0 and self.infos[i].listed and self.infos[i].dig >= 0 and self.infos[i].dec < 0
    }

    // In natsort's numeric_no_decimals: a fraction, a Roman numeral, a
    // circled number and the like, as well as the digits above.
    fn numeric_class(ref self, c: char) -> bool {
        let i = self.at(c);
        i >= 0 and self.infos[i].listed and self.infos[i].has_num and self.infos[i].dec < 0
    }

    // In natsort's decimal_chars.
    fn listed_decimal(ref self, c: char) -> bool {
        let i = self.at(c);
        i >= 0 and self.infos[i].listed and self.infos[i].dec >= 0
    }

    fn map_chars(ref self, cs: ref Vec[char], which: i64) -> Vec[char] {
        let mut out: Vec[char] = Vec.new();
        for c in cs.iter() {
            let i = self.at(*c);
            if i < 0 {
                out.push(*c);
                continue;
            }
            let m = if which == 0 {
                self.infos[i].nfd.clone()
            } else if which == 1 {
                self.infos[i].nfkd.clone()
            } else if which == 2 {
                self.infos[i].fold.clone()
            } else {
                self.infos[i].swap.clone()
            };
            if m.len() == 0 {
                out.push(*c);
            } else {
                for d in m.iter() {
                    out.push(*d);
                }
            }
        }
        out
    }

    // unicodedata.normalize("NFD" or "NFKD"): each character's full
    // decomposition, then the marks of each run put in canonical order.
    fn normalize(ref self, cs: ref Vec[char], compat: bool) -> Vec[char] {
        let mut out = self.map_chars(cs, if compat { 1 } else { 0 });
        let mut i = 1;
        while i < out.len() {
            let mut j = i;
            while j > 0 and self.ccc(out[j]) != 0 and self.ccc(out[j - 1]) > self.ccc(out[j]) {
                let t = out[j];
                out[j] = out[j - 1];
                out[j - 1] = t;
                j -= 1;
            }
            i += 1;
        }
        out
    }

    fn casefold(ref self, cs: ref Vec[char]) -> Vec[char] {
        self.map_chars(cs, 2)
    }

    fn swapcase(ref self, cs: ref Vec[char]) -> Vec[char] {
        self.map_chars(cs, 3)
    }

    // natsort's groupletters: each character's casefold, then the
    // character, so "Ab" becomes "aAbb".
    fn groupletters(ref self, cs: ref Vec[char]) -> Vec[char] {
        let mut out: Vec[char] = Vec.new();
        for c in cs.iter() {
            let one: Vec[char] = [*c];
            for d in self.casefold(one).iter() {
                out.push(*d);
            }
            out.push(*c);
        }
        out
    }

    // str.strip() and str.lstrip().
    fn strip(ref self, cs: ref Vec[char], right: bool) -> Vec[char] {
        let mut a = 0;
        while a < cs.len() and self.is_space(cs[a]) {
            a += 1;
        }
        let mut b = cs.len();
        if right {
            while b > a and self.is_space(cs[b - 1]) {
                b -= 1;
            }
        }
        sub_chars(cs, a, b)
    }

    // repr() of a str.
    fn repr(ref self, cs: ref Vec[char]) -> String {
        let mut has_single = false;
        let mut has_double = false;
        for c in cs.iter() {
            if *c == '\'' {
                has_single = true;
            }
            if *c == '"' {
                has_double = true;
            }
        }
        let q = if has_single and not has_double { '"' } else { '\'' };
        let mut out = String.new();
        out.push(q);
        for c in cs.iter() {
            let x = *c;
            let n = x as u32;
            if x == q or x == '\\' {
                out.push('\\');
                out.push(x);
            } else if x == '\t' {
                out.push_str("\\t");
            } else if x == '\n' {
                out.push_str("\\n");
            } else if x == '\r' {
                out.push_str("\\r");
            } else if n < 32 or n == 127 {
                out.push_str("\\x");
                out.push_str(hex_pad(n, 2));
            } else if n < 128 or self.printable(x) {
                out.push(x);
            } else if n < 256 {
                out.push_str("\\x");
                out.push_str(hex_pad(n, 2));
            } else if n < 65536 {
                out.push_str("\\u");
                out.push_str(hex_pad(n, 4));
            } else {
                out.push_str("\\U");
                out.push_str(hex_pad(n, 8));
            }
        }
        out.push(q);
        out
    }
}

// ------------------------------------------------------------ big integers

// Magnitudes as 32-bit limbs, least significant first, with no high
// zero limbs (zero is the empty vector).
fn big_trim(a: mut ref Vec[u32]) {
    while a.len() > 0 and a[a.len() - 1] == 0 {
        a.pop();
    }
}

fn big_mul_add(a: mut ref Vec[u32], m: u64, add: u64) {
    let mut carry = add;
    for i in 0..a.len() {
        let t = (a[i] as u64) * m + carry;
        a[i] = (t & 4294967295) as u32;
        carry = t >> 32;
    }
    while carry > 0 {
        a.push((carry & 4294967295) as u32);
        carry = carry >> 32;
    }
}

fn big_from_digits(ds: ref Vec[u8]) -> Vec[u32] {
    let mut a: Vec[u32] = Vec.new();
    for d in ds.iter() {
        big_mul_add(mut a, 10, *d as u64);
    }
    big_trim(mut a);
    a
}

fn big_pow10(n: i64) -> Vec[u32] {
    let mut a: Vec[u32] = [1];
    let mut k = n;
    while k >= 9 {
        big_mul_add(mut a, 1000000000, 0);
        k -= 9;
    }
    while k > 0 {
        big_mul_add(mut a, 10, 0);
        k -= 1;
    }
    a
}

fn big_mul(a: ref Vec[u32], b: ref Vec[u32]) -> Vec[u32] {
    let mut out: Vec[u32] = Vec.new();
    for _ in 0..(a.len() + b.len()) {
        out.push(0);
    }
    for i in 0..a.len() {
        let mut carry: u64 = 0;
        for j in 0..b.len() {
            let t = (a[i] as u64) * (b[j] as u64) + (out[i + j] as u64) + carry;
            out[i + j] = (t & 4294967295) as u32;
            carry = t >> 32;
        }
        let mut k = i + b.len();
        while carry > 0 {
            let t = (out[k] as u64) + carry;
            out[k] = (t & 4294967295) as u32;
            carry = t >> 32;
            k += 1;
        }
    }
    big_trim(mut out);
    out
}

fn big_bitlen(a: ref Vec[u32]) -> i64 {
    if a.len() == 0 {
        return 0;
    }
    let mut top = a[a.len() - 1];
    let mut n: i64 = 0;
    while top > 0 {
        n += 1;
        top = top >> 1;
    }
    (a.len() - 1) * 32 + n
}

fn big_shl(a: ref Vec[u32], bits: i64) -> Vec[u32] {
    let mut out: Vec[u32] = Vec.new();
    for _ in 0..(bits / 32) {
        out.push(0);
    }
    let s = bits % 32;
    let mut carry: u64 = 0;
    for i in 0..a.len() {
        let t = ((a[i] as u64) << s) | carry;
        out.push((t & 4294967295) as u32);
        carry = t >> 32;
    }
    if carry > 0 {
        out.push(carry as u32);
    }
    big_trim(mut out);
    out
}

fn big_shr1(a: mut ref Vec[u32]) {
    let mut i = 0;
    while i < a.len() {
        let hi: u32 = if i + 1 < a.len() { a[i + 1] & 1 } else { 0 };
        a[i] = (a[i] >> 1) | (hi << 31);
        i += 1;
    }
    big_trim(mut a);
}

fn big_cmp(a: ref Vec[u32], b: ref Vec[u32]) -> i64 {
    if a.len() != b.len() {
        return if a.len() < b.len() { -1 } else { 1 };
    }
    let mut i = a.len() - 1;
    while i >= 0 {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 };
        }
        i -= 1;
    }
    0
}

// a -= b, where a >= b.
fn big_sub(a: mut ref Vec[u32], b: ref Vec[u32]) {
    let mut borrow: i64 = 0;
    for i in 0..a.len() {
        let bv: i64 = if i < b.len() { b[i] as i64 } else { 0 };
        let mut t = (a[i] as i64) - bv - borrow;
        if t < 0 {
            t += 4294967296;
            borrow = 1;
        } else {
            borrow = 0;
        }
        a[i] = t as u32;
    }
    big_trim(mut a);
}

// ------------------------------------------------------------ decimal to float

// The f64 nearest to digits * 10**exp10, ties to even, as CPython's
// float() gives it. digits holds the digit values without leading zeros.
fn decimal_to_f64(digits: ref Vec[u8], exp10: i64, neg: bool) -> f64 {
    let mut ds = digits.clone();
    let mut e10 = exp10;
    while ds.len() > 0 and ds[ds.len() - 1] == 0 {
        ds.pop();
        e10 += 1;
    }
    let sign: f64 = if neg { -1.0 } else { 1.0 };
    if ds.len() == 0 {
        return sign * 0.0;
    }
    let n = ds.len();
    if n + e10 > 310 {
        return sign * f64.INFINITY;
    }
    if n + e10 < -330 {
        return sign * 0.0;
    }
    // The digits and the power of ten are exact, so one operation
    // rounds correctly.
    if n <= 15 and e10 >= -22 and e10 <= 22 {
        let mut m: f64 = 0.0;
        for d in ds.iter() {
            m = m * 10.0 + (*d as f64);
        }
        let mut p: f64 = 1.0;
        let mut k = if e10 < 0 { -e10 } else { e10 };
        while k > 0 {
            p *= 10.0;
            k -= 1;
        }
        return sign * (if e10 < 0 { m / p } else { m * p });
    }
    let mut num = big_from_digits(ds);
    let mut den: Vec[u32] = [1];
    if e10 >= 0 {
        num = big_mul(num, big_pow10(e10));
    } else {
        den = big_pow10(-e10);
    }
    // q = floor(num * 2**s / den) with 54 bits: the 53 of the result
    // and one to round on.
    let mut s = 54 - (big_bitlen(num) - big_bitlen(den));
    if s > 1075 {
        s = 1075;
    }
    let mut q: u64 = 0;
    let mut rem: Vec[u32] = Vec.new();
    let mut tries = 0;
    while tries < 2 {
        let mut n2 = if s > 0 { big_shl(num, s) } else { num.clone() };
        let d2 = if s < 0 { big_shl(den, -s) } else { den.clone() };
        let mut dd = big_shl(d2, 55);
        q = 0;
        let mut bit = 55;
        while bit >= 0 {
            if big_cmp(n2, dd) >= 0 {
                big_sub(mut n2, dd);
                q = q | ((1 as u64) << bit);
            }
            big_shr1(mut dd);
            bit -= 1;
        }
        rem = n2;
        if q >= ((1 as u64) << 54) and s < 1075 {
            s -= 1;
            tries += 1;
            continue;
        }
        if q < ((1 as u64) << 53) and s < 1075 {
            s += 1;
            tries += 1;
            continue;
        }
        break;
    }
    let mut mant = q >> 1;
    let round = (q & 1) == 1;
    let sticky = rem.len() > 0;
    if round and (sticky or (mant & 1) == 1) {
        mant += 1;
    }
    // The value is mant * 2**(1 - s).
    let mut e2 = 1 - s;
    if mant == ((1 as u64) << 53) {
        mant = mant >> 1;
        e2 += 1;
    }
    let bits: u64 = if mant < ((1 as u64) << 52) {
        // Subnormal: s is 1075 and the exponent field is zero.
        mant
    } else {
        let biased = e2 + 1075;
        if biased >= 2047 {
            return sign * f64.INFINITY;
        }
        ((biased as u64) << 52) | (mant & (((1 as u64) << 52) - 1))
    };
    sign * bits.bits_as_f64()
}

// ------------------------------------------------------------ float() and int()

fn is_ascii_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

fn ascii_space(c: char) -> bool {
    c == ' ' or c == '\t' or c == '\n' or c == '\r' or c == '\u{b}' or c == '\u{c}'
}

// What float() and int() do first: Unicode white space becomes a space
// and a Unicode decimal digit its ASCII digit; any other non-ASCII
// character makes the text invalid. Then the white space at the ends is
// stripped and underscores between digits removed.
fn number_text(cs: ref Vec[char], uni: ref Uni) -> Option[Vec[char]] {
    let mut t: Vec[char] = Vec.new();
    for c in cs.iter() {
        let n = *c as u32;
        if n < 128 {
            t.push(*c);
        } else if uni.is_space(*c) {
            t.push(' ');
        } else if uni.dec(*c) >= 0 {
            t.push(char.try_from(48 + uni.dec(*c) as u32).unwrap_or('?'));
        } else {
            return None;
        }
    }
    let mut a = 0;
    while a < t.len() and ascii_space(t[a]) {
        a += 1;
    }
    let mut b = t.len();
    while b > a and ascii_space(t[b - 1]) {
        b -= 1;
    }
    let mut out: Vec[char] = Vec.new();
    let mut prev = ' ';
    for i in a..b {
        let c = t[i];
        if c == '_' {
            if not is_ascii_digit(prev) {
                return None;
            }
        } else {
            if prev == '_' and not is_ascii_digit(c) {
                return None;
            }
            out.push(c);
        }
        prev = c;
    }
    if prev == '_' {
        return None;
    }
    Some(out)
}

fn lower_word(cs: ref Vec[char], from: i64) -> String {
    let mut s = String.new();
    for i in from..cs.len() {
        s.push(ascii_lower(cs[i]));
    }
    s
}

// float() of a str; None where it raises ValueError.
fn py_float(cs: ref Vec[char], uni: ref Uni) -> Option[f64] {
    let t = number_text(cs, uni)?;
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == '+' or t[i] == '-') {
        neg = t[i] == '-';
        i += 1;
    }
    let sign: f64 = if neg { -1.0 } else { 1.0 };
    let w = lower_word(t, i);
    if w == "inf" or w == "infinity" {
        return Some(sign * f64.INFINITY);
    }
    if w == "nan" {
        return Some(f64.INFINITY - f64.INFINITY);
    }
    let mut digits: Vec[u8] = Vec.new();
    let mut seen = false;
    let mut exp10: i64 = 0;
    while i < t.len() and is_ascii_digit(t[i]) {
        seen = true;
        let d = ((t[i] as u32) - 48) as u8;
        if digits.len() > 0 or d != 0 {
            digits.push(d);
        }
        i += 1;
    }
    if i < t.len() and t[i] == '.' {
        i += 1;
        while i < t.len() and is_ascii_digit(t[i]) {
            seen = true;
            let d = ((t[i] as u32) - 48) as u8;
            if digits.len() > 0 or d != 0 {
                digits.push(d);
            }
            exp10 -= 1;
            i += 1;
        }
    }
    if not seen {
        return None;
    }
    if i < t.len() and (t[i] == 'e' or t[i] == 'E') {
        i += 1;
        let mut eneg = false;
        if i < t.len() and (t[i] == '+' or t[i] == '-') {
            eneg = t[i] == '-';
            i += 1;
        }
        let st = i;
        let mut e: i64 = 0;
        while i < t.len() and is_ascii_digit(t[i]) {
            if e < 100000000 {
                e = e * 10 + ((t[i] as u32) - 48) as i64;
            }
            i += 1;
        }
        if i == st {
            return None;
        }
        exp10 += if eneg { -e } else { e };
    }
    if i != t.len() {
        return None;
    }
    Some(decimal_to_f64(digits, exp10, neg))
}

// The digits of an int, with a '-' when it is below zero.
fn norm_int(neg: bool, ds: ref Vec[char]) -> String {
    let mut s = String.new();
    let mut started = false;
    for c in ds.iter() {
        if *c != '0' {
            started = true;
        }
        if started {
            s.push(*c);
        }
    }
    if not started {
        return "0".to_string();
    }
    if neg { f"-{s}" } else { s }
}

// int() of a str; None where it raises ValueError.
fn py_int(cs: ref Vec[char], uni: ref Uni) -> Option[String] {
    let t = number_text(cs, uni)?;
    let mut i = 0;
    let mut neg = false;
    if i < t.len() and (t[i] == '+' or t[i] == '-') {
        neg = t[i] == '-';
        i += 1;
    }
    if i == t.len() {
        return None;
    }
    let mut ds: Vec[char] = Vec.new();
    while i < t.len() {
        if not is_ascii_digit(t[i]) {
            return None;
        }
        ds.push(t[i]);
        i += 1;
    }
    Some(norm_int(neg, ds))
}

// ------------------------------------------------------------ comparing numbers

fn int_neg(a: ref String) -> bool {
    a.starts_with("-")
}

fn int_abs(a: ref String) -> String {
    if int_neg(a) {
        let cs = chars_of(a);
        str_of(sub_chars(cs, 1, cs.len()))
    } else {
        a.clone()
    }
}

// Compares two magnitudes written in decimal without leading zeros.
fn cmp_mag(a: ref String, b: ref String) -> i64 {
    if a.len() != b.len() {
        return if a.len() < b.len() { -1 } else { 1 };
    }
    if a < b {
        -1
    } else if a == b {
        0
    } else {
        1
    }
}

fn cmp_int(a: ref String, b: ref String) -> i64 {
    let na = int_neg(a);
    let nb = int_neg(b);
    if na != nb {
        return if na { -1 } else { 1 };
    }
    let c = cmp_mag(int_abs(a), int_abs(b));
    if na { -c } else { c }
}

fn cmp_f(a: f64, b: f64) -> i64 {
    if a < b {
        -1
    } else if a > b {
        1
    } else {
        0
    }
}

// The integer part of |x| in decimal, and whether x has a fraction.
fn float_int_part(x: f64) -> (String, bool) {
    let bits = x.to_bits();
    let ef = ((bits >> 52) & 2047) as i64;
    let fr = bits & (((1 as u64) << 52) - 1);
    let (m, e) = if ef == 0 { (fr, -1074) } else { (fr | ((1 as u64) << 52), ef - 1075) };
    if e < 0 {
        let sh = -e;
        if sh >= 64 {
            return ("0".to_string(), m != 0);
        }
        let ip = m >> sh;
        return (f"{ip}", (m & (((1 as u64) << sh) - 1)) != 0);
    }
    // m * 2**e, doubling a little-endian list of decimal digits.
    let mut ds: Vec[u8] = Vec.new();
    let mut k = m;
    while k > 0 {
        ds.push((k % 10) as u8);
        k = k / 10;
    }
    for _ in 0..e {
        let mut carry: u8 = 0;
        for i in 0..ds.len() {
            let t = ds[i] * 2 + carry;
            ds[i] = t % 10;
            carry = t / 10;
        }
        if carry > 0 {
            ds.push(carry);
        }
    }
    let mut s = String.new();
    let mut i = ds.len() - 1;
    while i >= 0 {
        s.push(char.try_from(48 + ds[i] as u32).unwrap_or('?'));
        i -= 1;
    }
    (s, false)
}

// Compares an int with a float that is not NaN, exactly, as Python does.
fn cmp_int_float(a: ref String, x: f64) -> i64 {
    if x == f64.INFINITY {
        return -1;
    }
    if x == -f64.INFINITY {
        return 1;
    }
    let mag = int_abs(a);
    if mag.len() <= 15 {
        return cmp_f(dec_parse(mag) as f64 * (if int_neg(a) { -1.0 } else { 1.0 }), x);
    }
    let na = int_neg(a);
    if na and x >= 0.0 {
        return -1;
    }
    if not na and x < 0.0 {
        return 1;
    }
    let ax = if x < 0.0 { -x } else { x };
    let (ip, frac) = float_int_part(ax);
    let c = cmp_mag(mag, ip);
    if not na {
        if c == 0 and frac { -1 } else { c }
    } else {
        if c == 0 and frac { 1 } else { -c }
    }
}

// ------------------------------------------------------------ keys

// One element of a natsort key: a str, an int, a float or a tuple.
#[derive(Clone)]
enum K {
    S(String),
    I(String),
    F(f64),
    T(Vec[K]),
}

// The ns flags that matter without a locale.
#[derive(Clone)]
struct Alg {
    float: bool,
    signed: bool,
    noexp: bool,
    path: bool,
    ignorecase: bool,
    lowerfirst: bool,
    group: bool,
    nanlast: bool,
    compat: bool,
    numafter: bool,
    presort: bool,
}

fn alg_none() -> Alg {
    Alg {
        float: false,
        signed: false,
        noexp: false,
        path: false,
        ignorecase: false,
        lowerfirst: false,
        group: false,
        nanlast: false,
        compat: false,
        numafter: false,
        presort: false,
    }
}

// The ns flags by name, or None for a name that is not one.
fn alg_of(names: ref Vec[String]) -> Option[Alg] {
    let mut a = alg_none();
    for n in names.iter() {
        if n == "FLOAT" {
            a.float = true;
        } else if n == "SIGNED" {
            a.signed = true;
        } else if n == "REAL" {
            a.float = true;
            a.signed = true;
        } else if n == "NOEXP" {
            a.noexp = true;
        } else if n == "PATH" {
            a.path = true;
        } else if n == "IGNORECASE" {
            a.ignorecase = true;
        } else if n == "LOWERCASEFIRST" {
            a.lowerfirst = true;
        } else if n == "GROUPLETTERS" {
            a.group = true;
        } else if n == "NANLAST" {
            a.nanlast = true;
        } else if n == "COMPATIBILITYNORMALIZE" {
            a.compat = true;
        } else if n == "NUMAFTER" {
            a.numafter = true;
        } else if n == "PRESORT" {
            a.presort = true;
        } else if n == "UNGROUPLETTERS" {
            // Only does anything with LOCALE.
        } else {
            return None;
        }
    }
    Some(a)
}

fn is_num(k: ref K) -> bool {
    match k {
        K.I(_) => true,
        K.F(_) => true,
        _ => false,
    }
}

// The str natsort puts before a number: empty, or with NUMAFTER twenty
// copies of the highest code point, so numbers sort after letters.
fn sep_of(alg: ref Alg) -> String {
    let mut s = String.new();
    if alg.numafter {
        for _ in 0..20 {
            s.push('\u{10FFFF}');
        }
    }
    s
}

fn run_of_decimals(cs: ref Vec[char], from: i64, uni: ref Uni) -> i64 {
    let mut i = from;
    while i < cs.len() and uni.is_decimal(cs[i]) {
        i += 1;
    }
    i
}

fn is_sign(c: char) -> bool {
    c == '-' or c == '+'
}

// The end of (?:\d+\.?\d*|\.\d+) at k, then the exponent unless NOEXP,
// or -1.
fn float_body(cs: ref Vec[char], k: i64, noexp: bool, uni: ref Uni) -> i64 {
    let n = cs.len();
    let mut e: i64 = -1;
    let d = run_of_decimals(cs, k, uni);
    if d > k {
        e = d;
        if e < n and cs[e] == '.' {
            e = run_of_decimals(cs, e + 1, uni);
        }
    } else if k < n and cs[k] == '.' {
        let d2 = run_of_decimals(cs, k + 1, uni);
        if d2 > k + 1 {
            e = d2;
        }
    }
    if e < 0 or noexp {
        return e;
    }
    if e < n and (cs[e] == 'e' or cs[e] == 'E') {
        let mut t = e + 1;
        if t < n and is_sign(cs[t]) {
            t += 1;
        }
        let u = run_of_decimals(cs, t, uni);
        if u > t {
            e = u;
        }
    }
    e
}

// Where natsort's number regular expression, matched at i, ends; -1 if
// it does not match there.
fn number_at(cs: ref Vec[char], i: i64, alg: ref Alg, uni: ref Uni) -> i64 {
    let k = if alg.signed and is_sign(cs[i]) { i + 1 } else { i };
    if alg.float {
        let e = float_body(cs, k, alg.noexp, uni);
        if e > 0 {
            return e;
        }
        if uni.numeric_class(cs[i]) { i + 1 } else { -1 }
    } else {
        let e = run_of_decimals(cs, k, uni);
        if e > k {
            return e;
        }
        if uni.digit_class(cs[i]) { i + 1 } else { -1 }
    }
}

// re.split with the number pattern: the text between numbers and the
// numbers, in order, each with whether it is a number.
fn split_numbers(cs: ref Vec[char], alg: ref Alg, uni: ref Uni) -> Vec[(Vec[char], bool)] {
    let mut out: Vec[(Vec[char], bool)] = Vec.new();
    let mut last = 0;
    let mut i = 0;
    while i < cs.len() {
        let e = number_at(cs, i, alg, uni);
        if e > i {
            out.push((sub_chars(cs, last, i), false));
            out.push((sub_chars(cs, i, e), true));
            i = e;
            last = e;
        } else {
            i += 1;
        }
    }
    out.push((sub_chars(cs, last, cs.len()), false));
    out
}

// POTENTIAL_FIRST_CHAR in natsort's stand-in for fastnumbers.
fn first_char(c: char, uni: ref Uni) -> bool {
    is_ascii_digit(c) or c == '+' or c == '-' or c == '.' or uni.listed_decimal(c)
}

// Whether the text, after leading white space, starts with something
// that might be inf or nan (NAN_INF: "inf", "nan", or a sign and "in"
// or "na", in any case).
fn maybe_nan_inf(cs: ref Vec[char], uni: ref Uni) -> bool {
    let t = uni.strip(cs, false);
    if t.len() < 3 {
        return false;
    }
    let w = lower_word(sub_chars(t, 0, 3), 0);
    if w == "inf" or w == "nan" {
        return true;
    }
    let w2 = lower_word(sub_chars(t, 1, 3), 0);
    is_sign(t[0]) and (w2 == "in" or w2 == "na")
}

fn on_fail(cs: ref Vec[char], alg: ref Alg, uni: ref Uni) -> K {
    if alg.group {
        K.S(str_of(uni.groupletters(cs)))
    } else {
        K.S(str_of(cs))
    }
}

// fast_int and fast_float from natsort's fake_fastnumbers.
fn convert(cs: ref Vec[char], alg: ref Alg, uni: ref Uni) -> K {
    let c0 = cs[0];
    if alg.float {
        if first_char(c0, uni) or maybe_nan_inf(cs, uni) {
            if let Some(x) = py_float(cs, uni) {
                if x != x {
                    return K.F(if alg.nanlast { f64.INFINITY } else { -f64.INFINITY });
                }
                return K.F(x);
            }
        }
        let i = uni.at(c0);
        if cs.len() == 1 and i >= 0 and uni.infos[i].has_num {
            return K.F(uni.infos[i].num);
        }
        return on_fail(cs, alg, uni);
    }
    if first_char(c0, uni) {
        if let Some(n) = py_int(cs, uni) {
            return K.I(n);
        }
    }
    if cs.len() == 1 and uni.dig(c0) >= 0 {
        return K.I(f"{uni.dig(c0)}");
    }
    on_fail(cs, alg, uni)
}

// natsort's key for one str (or one part of a path).
fn str_key(s: ref Vec[char], alg: ref Alg, uni: ref Uni) -> K {
    let mut t = uni.normalize(s, alg.compat);
    if alg.lowerfirst {
        t = uni.swapcase(t);
    }
    if alg.ignorecase {
        t = uni.casefold(t);
    }
    let sep = sep_of(alg);
    let mut out: Vec[K] = Vec.new();
    let mut prev_num = true;
    for (piece, _) in split_numbers(t, alg, uni).iter() {
        if piece.len() == 0 {
            continue;
        }
        let k = convert(piece, alg, uni);
        let num = is_num(k);
        if num and prev_num {
            out.push(K.S(sep.clone()));
        }
        prev_num = num;
        out.push(k);
    }
    K.T(out)
}

// natsort's path_splitter: the parts of a PurePosixPath, with the file
// name split into its base and up to two suffixes.
fn path_parts(s: ref Vec[char], uni: ref Uni) -> Vec[Vec[char]] {
    let mut parts: Vec[Vec[char]] = Vec.new();
    let n = s.len();
    let mut i = 0;
    if n > 0 and s[0] == '/' {
        if n > 1 and s[1] == '/' and not (n > 2 and s[2] == '/') {
            parts.push(['/', '/']);
        } else {
            parts.push(['/']);
        }
    }
    let mut cur: Vec[char] = Vec.new();
    while i <= n {
        if i == n or s[i] == '/' {
            if cur.len() > 0 and not (cur.len() == 1 and cur[0] == '.') {
                parts.push(cur.clone());
            }
            cur = Vec.new();
        } else {
            cur.push(s[i]);
        }
        i += 1;
    }
    let base = if parts.len() == 0 { ['.'] } else { parts.pop().unwrap() };
    // PurePath(base).suffixes, from the last.
    let is_root = base.len() > 0 and base[0] == '/';
    let mut sufs: Vec[Vec[char]] = Vec.new();
    if not is_root and base[base.len() - 1] != '.' {
        let mut a = 0;
        while a < base.len() and base[a] == '.' {
            a += 1;
        }
        let name = sub_chars(base, a, base.len());
        let mut all: Vec[Vec[char]] = Vec.new();
        let mut cur2: Vec[char] = Vec.new();
        let mut first = true;
        for c in name.iter() {
            if *c == '.' {
                if not first {
                    all.push(cur2.clone());
                }
                first = false;
                cur2 = ['.'];
            } else {
                cur2.push(*c);
            }
        }
        if not first {
            all.push(cur2);
        }
        let mut k = all.len() - 1;
        let mut taken = 0;
        while k >= 0 {
            let suf = all[k].clone();
            let digit_after = suf.len() > 1 and uni.is_decimal(suf[1]);
            if digit_after or taken > 1 or suf.len() > 5 {
                break;
            }
            sufs.insert(0, suf);
            taken += 1;
            k -= 1;
        }
    }
    // base.replace("".join(suffixes), ""): every occurrence goes.
    let mut joined: Vec[char] = Vec.new();
    for suf in sufs.iter() {
        for c in suf.iter() {
            joined.push(*c);
        }
    }
    let mut b2: Vec[char] = Vec.new();
    if joined.len() == 0 {
        b2 = base.clone();
    } else {
        let mut j = 0;
        while j < base.len() {
            let mut hit = j + joined.len() <= base.len();
            let mut m = 0;
            while hit and m < joined.len() {
                if base[j + m] != joined[m] {
                    hit = false;
                }
                m += 1;
            }
            if hit {
                j += joined.len();
            } else {
                b2.push(base[j]);
                j += 1;
            }
        }
    }
    if b2.len() > 0 {
        parts.push(b2);
    }
    for suf in sufs.iter() {
        parts.push(suf.clone());
    }
    parts
}

// num_func: the key of a number or None.
fn num_key(v: ref J, alg: ref Alg) -> K {
    let sep = K.S(sep_of(alg));
    let rep = if alg.nanlast { f64.INFINITY } else { -f64.INFINITY };
    let mut out: Vec[K] = Vec.new();
    match v {
        J.F(x) => {
            let x = x;
            if x != x {
                out = [sep, K.F(rep), K.S((if alg.nanlast { "3" } else { "1" }).to_string())];
            } else if x == rep {
                out = [sep, K.F(rep), K.S((if alg.nanlast { "1" } else { "3" }).to_string())];
            } else {
                out = [sep, K.F(x)];
            }
        }
        J.N(n) => {
            out = [sep, K.I(n.clone())];
        }
        J.B(b) => {
            out = [sep, K.I((if b { "1" } else { "0" }).to_string())];
        }
        _ => {
            out = [sep, K.F(rep), K.S("2".to_string())];
        }
    }
    if alg.path {
        K.T([K.T(out)])
    } else {
        K.T(out)
    }
}

// natsort_key: a str goes through the string parser, a list (or the keys
// of a dict) element by element, anything else through num_func.
fn natsort_key(v: ref J, alg: ref Alg, uni: ref Uni) -> K {
    match v {
        J.S(s) => {
            let cs = chars_of(s);
            if alg.path {
                let mut parts: Vec[K] = Vec.new();
                for p in path_parts(cs, uni).iter() {
                    parts.push(str_key(p, alg, uni));
                }
                K.T(parts)
            } else {
                str_key(cs, alg, uni)
            }
        }
        J.A(items) => {
            let mut out: Vec[K] = Vec.new();
            for it in items.iter() {
                out.push(natsort_key(it, alg, uni));
            }
            K.T(out)
        }
        J.O(members) => {
            let mut out: Vec[K] = Vec.new();
            for (k, _) in members.iter() {
                out.push(natsort_key(J.S(k.clone()), alg, uni));
            }
            K.T(out)
        }
        _ => num_key(v, alg),
    }
}

// ------------------------------------------------------------ comparing keys

// -1, 0 or 1, or 2 where Python would raise TypeError ('<' between a str
// and a number).
fn k_cmp(a: ref K, b: ref K) -> i64 {
    match (a, b) {
        (K.S(x), K.S(y)) => {
            if x < y {
                -1
            } else if x == y {
                0
            } else {
                1
            }
        }
        (K.I(x), K.I(y)) => cmp_int(x, y),
        (K.F(x), K.F(y)) => cmp_f(x, y),
        (K.I(x), K.F(y)) => cmp_int_float(x, y),
        (K.F(x), K.I(y)) => -cmp_int_float(y, x),
        (K.T(x), K.T(y)) => {
            let mut i = 0;
            while i < x.len() and i < y.len() {
                let c = k_cmp(x[i], y[i]);
                if c != 0 {
                    return c;
                }
                i += 1;
            }
            cmp_f(x.len() as f64, y.len() as f64)
        }
        _ => 2,
    }
}

// A stable merge sort of 0..n by keys, descending when reverse (equal
// keys keep their order either way, as with sorted(reverse=True)).
fn sort_order(keys: ref Vec[K], reverse: bool, err: mut ref bool) -> Vec[i64] {
    let mut idx: Vec[i64] = Vec.new();
    for i in 0..keys.len() {
        idx.push(i);
    }
    let mut width = 1;
    while width < idx.len() {
        let mut next: Vec[i64] = Vec.new();
        let mut lo = 0;
        while lo < idx.len() {
            let mid = if lo + width < idx.len() { lo + width } else { idx.len() };
            let hi = if lo + 2 * width < idx.len() { lo + 2 * width } else { idx.len() };
            let mut i = lo;
            let mut j = mid;
            while i < mid and j < hi {
                let c = if reverse { k_cmp(keys[idx[i]], keys[idx[j]]) } else { k_cmp(keys[idx[j]], keys[idx[i]]) };
                if c == 2 {
                    *err = true;
                }
                if c == -1 {
                    next.push(idx[j]);
                    j += 1;
                } else {
                    next.push(idx[i]);
                    i += 1;
                }
            }
            while i < mid {
                next.push(idx[i]);
                i += 1;
            }
            while j < hi {
                next.push(idx[j]);
                j += 1;
            }
            lo = hi;
        }
        idx = next;
        width *= 2;
    }
    idx
}

// ------------------------------------------------------------ repr

fn float_repr(x: f64) -> String {
    f"{x}"
}

fn k_repr(k: ref K, uni: ref Uni) -> String {
    match k {
        K.S(s) => uni.repr(chars_of(s)),
        K.I(n) => n.clone(),
        K.F(x) => float_repr(x),
        K.T(items) => {
            let mut parts: Vec[String] = Vec.new();
            for it in items.iter() {
                parts.push(k_repr(it, uni));
            }
            if parts.len() == 1 {
                f"({parts[0]},)"
            } else {
                let inner = join(parts, ", ");
                f"({inner})"
            }
        }
    }
}

fn j_repr(v: ref J, uni: ref Uni) -> String {
    match v {
        J.S(s) => uni.repr(chars_of(s)),
        J.N(n) => n.clone(),
        J.F(x) => float_repr(x),
        J.B(b) => (if b { "True" } else { "False" }).to_string(),
        J.Null => "None".to_string(),
        J.A(items) => {
            let mut parts: Vec[String] = Vec.new();
            for it in items.iter() {
                parts.push(j_repr(it, uni));
            }
            let inner = join(parts, ", ");
            f"[{inner}]"
        }
        J.O(members) => {
            let mut parts: Vec[String] = Vec.new();
            for (k, x) in members.iter() {
                let kr = uni.repr(chars_of(k));
                let xr = j_repr(x, uni);
                parts.push(f"{kr}: {xr}");
            }
            let inner = join(parts, ", ");
            "{".to_string() + inner + "}"
        }
    }
}

// str() of an item, for PRESORT.
fn j_str_of(v: ref J, uni: ref Uni) -> String {
    match v {
        J.S(s) => s.clone(),
        _ => j_repr(v, uni),
    }
}

// ------------------------------------------------------------ sorting

// natsorted and friends: the order the items end up in, or the error.
fn sorted_order(items: ref Vec[J], key_field: ref Option[String], alg: ref Alg, reverse: bool, uni: ref Uni) -> Result[Vec[i64], String] {
    let mut order: Vec[i64] = Vec.new();
    for i in 0..items.len() {
        order.push(i);
    }
    let mut err = false;
    if alg.presort {
        let mut keys: Vec[K] = Vec.new();
        for it in items.iter() {
            keys.push(K.S(j_str_of(it, uni)));
        }
        order = sort_order(keys, reverse, mut err);
    }
    let mut keys: Vec[K] = Vec.new();
    for i in order.iter() {
        let it = items[*i].clone();
        let v = match key_field {
            Some(f) => j_get(it, f),
            None => it,
        };
        keys.push(natsort_key(v, alg, uni));
    }
    let o2 = sort_order(keys, reverse, mut err);
    if err {
        return Err("TypeError: '<' not supported between a str and a number".to_string());
    }
    let mut out: Vec[i64] = Vec.new();
    for k in o2.iter() {
        out.push(order[*k]);
    }
    Ok(out)
}

fn label_of(names: ref Vec[String]) -> String {
    if names.len() == 0 { "DEFAULT".to_string() } else { join(names, "|") }
}

fn run_sort(op: ref J, uni: ref Uni) {
    let func = j_str(op, "fn");
    let names = j_strs(op, "alg");
    let reverse = j_bool(op, "reverse");
    let items = match j_get(op, "items") {
        J.A(v) => v,
        _ => Vec.new(),
    };
    let mut head = f"-- {func} {label_of(names)}";
    if reverse {
        head.push_str(" reverse");
    }
    let key_field: Option[String] = if j_present(op, "key") { Some(j_str(op, "key")) } else { None };
    if let Some(f) = key_field.clone() {
        head.push_str(" key=");
        head.push_str(f);
    }
    println(head);
    let real = func == "realsorted" or func == "index_realsorted";
    let mut alg = match alg_of(names) {
        Some(a) => a,
        None => {
            // natsort tests alg against PRESORT (realsorted ORs in REAL)
            // before it checks where alg came from.
            let opch = if real { "|" } else { "&" };
            println(f"error: TypeError: unsupported operand type(s) for {opch}: 'str' and 'ns'");
            return;
        }
    };
    if real {
        alg.float = true;
        alg.signed = true;
    }
    let order = match sorted_order(items, key_field, alg, reverse, uni) {
        Ok(o) => o,
        Err(e) => {
            println(f"error: {e}");
            return;
        }
    };
    let mut parts: Vec[String] = Vec.new();
    for i in order.iter() {
        if func == "index_natsorted" or func == "index_realsorted" {
            parts.push(f"{*i}");
        } else {
            parts.push(j_repr(items[*i], uni));
        }
    }
    let inner = join(parts, ", ");
    println(f"[{inner}]");
}

fn run_key(op: ref J, uni: ref Uni) {
    let names = j_strs(op, "alg");
    let item = j_get(op, "item");
    println(f"-- key {label_of(names)} {j_repr(item, uni)}");
    match alg_of(names) {
        Some(a) => println(k_repr(natsort_key(item, a, uni), uni)),
        None => println("error: bad alg"),
    }
}

// ------------------------------------------------------------ the command line

struct Cli {
    paths: bool,
    filters: Vec[(f64, f64)],
    has_filter: bool,
    rfilters: Vec[(f64, f64)],
    has_rfilter: bool,
    exclude: Vec[f64],
    reverse: bool,
    number_type: String,
    signed: bool,
    exp: bool,
    entries: Vec[String],
}

fn arg_float(args: ref Vec[String], i: i64, uni: ref Uni) -> Result[f64, String] {
    if i >= args.len() {
        return Err("expected an argument".to_string());
    }
    match py_float(chars_of(args[i]), uni) {
        Some(x) => Ok(x),
        None => Err(f"invalid float value: {uni.repr(chars_of(args[i]))}"),
    }
}

// argparse, for natsort's options. An argument that looks like a
// negative number is a value, since no option does.
fn parse_cli(args: ref Vec[String], uni: ref Uni) -> Result[Cli, String] {
    let mut c = Cli {
        paths: false,
        filters: Vec.new(),
        has_filter: false,
        rfilters: Vec.new(),
        has_rfilter: false,
        exclude: Vec.new(),
        reverse: false,
        number_type: "int".to_string(),
        signed: false,
        exp: true,
        entries: Vec.new(),
    };
    let mut i = 0;
    while i < args.len() {
        let a = args[i].clone();
        if a == "-p" or a == "--paths" {
            c.paths = true;
        } else if a == "-f" or a == "--filter" {
            let lo = arg_float(args, i + 1, uni)?;
            let hi = arg_float(args, i + 2, uni)?;
            c.filters.push((lo, hi));
            c.has_filter = true;
            i += 2;
        } else if a == "-F" or a == "--reverse-filter" {
            let lo = arg_float(args, i + 1, uni)?;
            let hi = arg_float(args, i + 2, uni)?;
            c.rfilters.push((lo, hi));
            c.has_rfilter = true;
            i += 2;
        } else if a == "-e" or a == "--exclude" {
            c.exclude.push(arg_float(args, i + 1, uni)?);
            i += 1;
        } else if a == "-r" or a == "--reverse" {
            c.reverse = true;
        } else if a == "-t" or a == "--number-type" or a == "--number_type" {
            if i + 1 >= args.len() {
                return Err("expected one argument".to_string());
            }
            c.number_type = args[i + 1].clone();
            i += 1;
        } else if a == "--nosign" {
            c.signed = false;
        } else if a == "-s" or a == "--sign" {
            c.signed = true;
        } else if a == "--noexp" {
            c.exp = false;
        } else {
            c.entries.push(a);
        }
        i += 1;
    }
    Ok(c)
}

fn check_filters(fs: ref Vec[(f64, f64)]) -> Result[(), String] {
    for (lo, hi) in fs.iter() {
        if lo >= hi {
            return Err("Error in --filter: low >= high".to_string());
        }
    }
    Ok(())
}

fn conv_float(cs: ref Vec[char], uni: ref Uni) -> Result[f64, String] {
    match py_float(cs, uni) {
        Some(x) => Ok(x),
        None => Err(f"could not convert string to float: {uni.repr(cs)}"),
    }
}

fn numbers_in(entry: ref String, alg: ref Alg, uni: ref Uni) -> Vec[Vec[char]] {
    let mut out: Vec[Vec[char]] = Vec.new();
    for (piece, is_n) in split_numbers(chars_of(entry), alg, uni).iter() {
        if is_n {
            out.push(piece.clone());
        }
    }
    out
}

// keep_entry_range: whether a number in the entry falls in a range,
// converting lazily as the generator does.
fn in_ranges(entry: ref String, fs: ref Vec[(f64, f64)], alg: ref Alg, uni: ref Uni) -> Result[bool, String] {
    for num in numbers_in(entry, alg, uni).iter() {
        for (lo, hi) in fs.iter() {
            let x = conv_float(num, uni)?;
            if lo <= x and x <= hi {
                return Ok(true);
            }
        }
    }
    Ok(false)
}

fn run_cli_main(args: ref Vec[String], uni: ref Uni) -> Result[(), String] {
    let c = parse_cli(args, uni)?;
    if c.has_filter {
        check_filters(c.filters)?;
    }
    if c.has_rfilter {
        check_filters(c.rfilters)?;
    }
    let mut entries: Vec[String] = Vec.new();
    for e in c.entries.iter() {
        entries.push(str_of(uni.strip(chars_of(e), true)));
    }
    let t = c.number_type.clone();
    let is_float = t == "float" or t == "real" or t == "f" or t == "r";
    let signed = c.signed or t == "real" or t == "r";
    let mut alg = alg_none();
    alg.float = is_float;
    alg.signed = signed;
    alg.noexp = not c.exp;
    alg.path = c.paths;
    if c.has_filter or c.has_rfilter or c.exclude.len() > 0 {
        let mut inp = alg_none();
        inp.float = is_float;
        inp.signed = signed;
        inp.noexp = not c.exp;
        if c.has_filter {
            let mut kept: Vec[String] = Vec.new();
            for e in entries.iter() {
                if in_ranges(e, c.filters, inp, uni)? {
                    kept.push(e.clone());
                }
            }
            entries = kept;
        }
        if c.has_rfilter {
            let mut kept: Vec[String] = Vec.new();
            for e in entries.iter() {
                if not in_ranges(e, c.rfilters, inp, uni)? {
                    kept.push(e.clone());
                }
            }
            entries = kept;
        }
        if c.exclude.len() > 0 {
            let mut kept: Vec[String] = Vec.new();
            for e in entries.iter() {
                let mut hit = false;
                for num in numbers_in(e, inp, uni).iter() {
                    let x = conv_float(num, uni)?;
                    for v in c.exclude.iter() {
                        if *v == x {
                            hit = true;
                        }
                    }
                    if hit {
                        break;
                    }
                }
                if not hit {
                    kept.push(e.clone());
                }
            }
            entries = kept;
        }
    }
    let mut items: Vec[J] = Vec.new();
    for e in entries.iter() {
        items.push(J.S(e.clone()));
    }
    let order = sorted_order(items, None, alg, c.reverse, uni)?;
    for i in order.iter() {
        println(entries[*i]);
    }
    Ok(())
}

fn run_cli(op: ref J, uni: ref Uni) {
    let args = j_strs(op, "args");
    let mut shown: Vec[String] = Vec.new();
    for a in args.iter() {
        shown.push(uni.repr(chars_of(a)));
    }
    println(f"-- cli {join(shown, " ")}");
    if let Err(e) = run_cli_main(args, uni) {
        println(f"exit: {e}");
    }
}

// ------------------------------------------------------------ the jobs

fn run() -> Result[(), String] {
    let table = match fs.read_to_string("data/unicode.txt") {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/unicode.txt: {e}"),
    };
    let uni = load_uni(table);
    let jobs = match fs.read_to_string("data/jobs.jsonl") {
        Ok(t) => t,
        Err(e) => return Err(f"cannot read data/jobs.jsonl: {e}"),
    };
    for line in jobs.lines() {
        if line.len() == 0 {
            continue;
        }
        let job = json_line(line.to_string(), uni)?;
        println(f"== {j_str(job, "name")}");
        if let J.A(ops) = j_get(job, "ops") {
            for op in ops.iter() {
                let kind = j_str(op, "op");
                if kind == "sort" {
                    run_sort(op, uni);
                } else if kind == "key" {
                    run_key(op, uni);
                } else {
                    run_cli(op, uni);
                }
            }
        }
    }
    Ok(())
}

struct DataFile {
    path: String,
    hex: bool,
    body: String,
}

fn hex_val(c: u8) -> u8 {
    if c >= b'a' { c - b'a' + 10 } else { c - b'0' }
}

fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn make_parent(path: ref String) -> Result[(), String] {
    let parts: Vec[Str] = path.split("/").collect();
    let mut dir = "data".to_string();
    let mut k = 0;
    while k + 1 < parts.len() {
        dir = f"{dir}/{parts[k]}";
        k += 1;
    }
    if let Err(e) = fs.create_dir_all(dir.clone()) {
        return Err(f"cannot create {dir}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    for file in data_files() {
        make_parent(file.path)?;
        let written = if file.hex {
            fs.write_bytes(f"data/{file.path}", unhex(file.body))
        } else {
            fs.write(f"data/{file.path}", file.body.clone())
        };
        if let Err(e) = written {
            return Err(f"cannot write {file.path}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    if let Err(e) = run() {
        eprintln(e);
    }
}

// ------------------------------------------------------------ data

// The files under data/, in path order.
fn data_files() -> Vec[DataFile] {
    let mut v: Vec[DataFile] = Vec.new();
    data_part_0(mut v);
    data_part_1(mut v);
    v
}

fn data_part_0(v: mut ref Vec[DataFile]) {
