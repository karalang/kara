fn put(path: Str, text: String) -> Result[(), String] {
    if let Err(e) = fs.write(path.to_string(), text) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn unhex(s: String) -> Vec[u8] {
    let b = to_bytes(s);
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < b.len() {
        out.push(hex_val(b[i]) * 16 + hex_val(b[i + 1]));
        i += 2;
    }
    out
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn make_dir(path: Str) -> Result[(), String] {
    if let Err(e) = fs.create_dir_all(path.to_string()) {
        return Err(f"cannot create {path}: {e}");
    }
    Ok(())
}

fn write_data() -> Result[(), String] {
    make_dir("data")?;
    put("data/deltas.txt", file_0())?;
    put("data/iso.txt", file_1())?;
    make_dir("data/logs")?;
    put("data/logs/access.log", file_2())?;
    put("data/logs/app.log", file_3())?;
    put("data/logs/catalina.out", file_4())?;
    put("data/logs/edge.log", file_5())?;
    put("data/logs/error.log", file_6())?;
    put("data/logs/events.csv", file_7())?;
    put("data/logs/line3.log", file_8())?;
    put("data/logs/mail.log", file_9())?;
    put("data/logs/syslog.log", file_10())?;
    put("data/sources.txt", file_11())?;
    put("data/strftime.txt", file_12())?;
    put("data/strptime.txt", file_13())?;
    Ok(())
}

// ------------------------------------------------------------ the reports

fn read(path: Str) -> Result[String, String] {
    match fs.read_to_string(path.to_string()) {
        Ok(t) => Ok(t),
        Err(e) => Err(f"cannot read {path}: {e}"),
    }
}

// The lines of a data file that are not empty and not comments.
fn data_lines(path: Str) -> Result[Vec[String], String] {
    let mut out: Vec[String] = Vec.new();
    for l in split_on(read(path)?, b'\n') {
        if l.len() > 0 and first_byte(l) != b'#' {
            out.push(l.clone());
        }
    }
    Ok(out)
}

// str.split(sep) and str.partition(sep) on a separator of several bytes.
fn split_str(s: Str, sep: Str) -> Vec[String] {
    let b = to_bytes(s);
    let mut out: Vec[String] = Vec.new();
    let mut st: i64 = 0;
    let mut i: i64 = 0;
    while i < b.len() {
        if starts_at(b, i, sep) {
            out.push(byte_str(b, st, i));
            i += sep.len();
            st = i;
        } else {
            i += 1;
        }
    }
    out.push(byte_str(b, st, b.len()));
    out
}

fn partition_str(s: Str, sep: Str) -> (String, String) {
    let i = find_str(s, sep);
    if i < 0 {
        return (s.to_string(), String.new());
    }
    (slice(s, 0, i), slice_from(s, i + sep.len()))
}

fn rjust(s: Str, width: i64) -> String {
    let mut out = String.new();
    let mut n = s.len();
    while n < width {
        out.push_str(" ");
        n += 1;
    }
    out.push_str(s);
    out
}

fn ljust(s: Str, width: i64) -> String {
    let mut out = s.to_string();
    while out.len() < width {
        out.push_str(" ");
    }
    out
}

fn section_strptime() -> Result[(), String] {
    println("== strptime");
    for l in data_lines("data/strptime.txt")? {
        let (s, f) = partition_str(l, " | ");
        let out = match strptime(s, f) {
            Ok(dt) => show_dt(dt),
            Err(e) => e,
        };
        println(f"{py_repr(s)} {py_repr(f)}: {out}");
    }
    Ok(())
}

fn samples() -> Vec[DateTime] {
    let mut v: Vec[DateTime] = Vec.new();
    v.push(with_zone(naive(2026, 10, 15, 8, 0, 1, 250000), 2 * 3600 * US_PER_SEC, String.new()));
    v.push(naive(2027, 1, 1, 0, 0, 0, 0));
    v.push(naive(5, 1, 2, 3, 4, 5, 0));
    v.push(with_zone(naive(2024, 2, 29, 23, 59, 59, 999999), -(3 * 3600 + 30 * 60) * US_PER_SEC, String.new()));
    v.push(with_zone(naive(2026, 12, 28, 12, 30, 0, 0), 0, String.new()));
    v
}

fn section_strftime() -> Result[(), String] {
    println("== strftime");
    let all = samples();
    for f in data_lines("data/strftime.txt")? {
        println(py_repr(f));
        for d in all {
            println(f"  {dt_iso(d, "T", "auto")}: {py_repr(py_strftime(f, d))}");
        }
    }
    Ok(())
}

fn section_iso() -> Result[(), String] {
    println("== fromisoformat");
    for l in data_lines("data/iso.txt")? {
        let (cls, out) = if starts_with(l, "date ") {
            let s = slice_from(l, 5);
            let r = match date_fromisoformat(s) {
                Ok(d) => date_iso(d),
                Err(e) => e,
            };
            ("date", f"{py_repr(s)}): {r}")
        } else if starts_with(l, "time ") {
            let s = slice_from(l, 5);
            let r = match time_fromisoformat(s) {
                Ok(t) => show_time(t),
                Err(e) => e,
            };
            ("time", f"{py_repr(s)}): {r}")
        } else {
            let r = match datetime_fromisoformat(l) {
                Ok(d) => show_dt(d),
                Err(e) => e,
            };
            ("datetime", f"{py_repr(l)}): {r}")
        };
        println(f"{cls}.fromisoformat({out}");
    }
    Ok(())
}

// timedelta(**fields) from words like hours=-25.
fn delta(fields: ref Vec[String]) -> Result[Delta, String] {
    let mut days: i64 = 0;
    let mut secs: i64 = 0;
    let mut us: i64 = 0;
    for f in fields {
        let (k, _, v) = partition(f, b'=');
        let n = match py_int(v) {
            Some(n) => n,
            None => return Err(f"ValueError: invalid literal for int() with base 10: {py_repr(v)}"),
        };
        if k == "weeks" {
            days += n * 7;
        } else if k == "days" {
            days += n;
        } else if k == "hours" {
            secs += n * 3600;
        } else if k == "minutes" {
            secs += n * 60;
        } else if k == "seconds" {
            secs += n;
        } else if k == "milliseconds" {
            us += n * 1000;
        } else if k == "microseconds" {
            us += n;
        } else {
            return Err(f"TypeError: '{k}' is an invalid keyword argument for __new__()");
        }
    }
    td_new(days, secs, us)
}

fn show_td(t: ref Delta) -> String {
    f"{td_str(t)} = {td_repr(t)}"
}

fn words_from(w: ref Vec[String], from: i64, to: i64) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    for i in from..to {
        out.push(w[i].clone());
    }
    out
}

fn run_delta(cmd: Str, w: ref Vec[String]) -> Result[String, String] {
    if cmd == "td" {
        return Ok(show_td(delta(w)?));
    }
    if cmd == "add" {
        let d = datetime_fromisoformat(w[0])?;
        let t = delta(words_from(w, 1, w.len()))?;
        return Ok(show_dt(dt_add(d, t)?));
    }
    if cmd == "sub" {
        let a = datetime_fromisoformat(w[0])?;
        let b = datetime_fromisoformat(w[1])?;
        return Ok(show_td(dt_sub(a, b)?));
    }
    if cmd == "mul" {
        let mut i: i64 = 0;
        while i < w.len() and has_byte(w[i], b'=') {
            i += 1;
        }
        let t = delta(words_from(w, 0, i))?;
        let n = py_int(w[i]).unwrap_or(0);
        return Ok(show_td(td_new(t.days * n, t.secs * n, t.us * n)?));
    }
    if cmd == "floordiv" or cmd == "mod" {
        let mut k: i64 = 0;
        while w[k] != "/" {
            k += 1;
        }
        let a = td_us(delta(words_from(w, 0, k))?);
        let b = td_us(delta(words_from(w, k + 1, w.len()))?);
        if b == 0 {
            return Err("ZeroDivisionError: integer division or modulo by zero".to_string());
        }
        if cmd == "floordiv" {
            return Ok(f"{fdiv(a, b)}");
        }
        return Ok(show_td(td_from_us(fmod(a, b))?));
    }
    let t = delta(w)?;
    if cmd == "neg" or t.days < 0 {
        return Ok(show_td(td_neg(t)?));
    }
    Ok(show_td(t))
}

fn section_deltas() -> Result[(), String] {
    println("== timedelta");
    for l in data_lines("data/deltas.txt")? {
        let words = split_on(l, b' ');
        let out = match run_delta(words[0], words_from(words, 1, words.len())) {
            Ok(s) => s,
            Err(e) => e,
        };
        println(f"{l}: {out}");
    }
    Ok(())
}

// ------------------------------------------------------------ the normalizer

fn find_stamp(line: Str, rule: Str) -> Option[String] {
    if rule == "bracket" {
        let b = to_bytes(line);
        let a = find_byte(line, b'[');
        let mut e: i64 = -1;
        let mut i = a + 1;
        while i < b.len() {
            if b[i] == b']' {
                e = i;
                break;
            }
            i += 1;
        }
        if a >= 0 and e >= 0 {
            return Some(byte_str(b, a + 1, e));
        }
        return None;
    }
    let (kind, _, arg) = partition(rule, b':');
    let words = split_on(line, b' ');
    if kind == "field" {
        let n = py_int(arg).unwrap_or(0);
        return if words.len() >= n { Some(words[n - 1].clone()) } else { None };
    }
    if kind == "fields" {
        let n = py_int(arg).unwrap_or(0);
        return if words.len() >= n { Some(join(words_from(words, 0, n), " ")) } else { None };
    }
    let i = find_str(line, arg);
    if i >= 0 { Some(slice(line, 0, i)) } else { None }
}

fn all_digits(s: Str) -> bool {
    let b = to_bytes(s);
    if b.len() == 0 {
        return false;
    }
    for i in 0..b.len() {
        if not is_digit(b[i]) {
            return false;
        }
    }
    true
}

fn parse_stamp(s: Str, fmt: Str) -> Result[DateTime, String] {
    if fmt == "iso" {
        return datetime_fromisoformat(s);
    }
    if fmt == "epoch" {
        let (whole, _, frac) = partition(s, b'.');
        if not all_digits(whole) or (frac.len() > 0 and not all_digits(frac)) or frac.len() > 6 {
            return Err(f"ValueError: not an epoch time: {py_repr(s)}");
        }
        let mut f = frac.clone();
        while f.len() < 6 {
            f.push_str("0");
        }
        let us = py_int(f).unwrap_or(0);
        let epoch = with_zone(naive(1970, 1, 1, 0, 0, 0, 0), 0, String.new());
        let t = td_new(0, py_int(whole).unwrap_or(0), us)?;
        return dt_add(epoch, t);
    }
    strptime(s, fmt)
}

// The offset for naive times, "+HH:MM", in microseconds.
fn offset_of(s: Str) -> i64 {
    let sign: i64 = if first_byte(s) == b'-' { -1 } else { 1 };
    let h = py_int(slice(s, 1, 3)).unwrap_or(0);
    let m = py_int(slice(s, 4, 6)).unwrap_or(0);
    sign * (h * 3600 + m * 60) * US_PER_SEC
}

// str.replace(cut, "", 1)
fn remove_first(s: Str, cut: Str) -> String {
    let i = find_str(s, cut);
    if i < 0 {
        return s.to_string();
    }
    f"{slice(s, 0, i)}{slice_from(s, i + cut.len())}"
}

// str.strip(" ,|")
fn strip_punct(s: Str) -> String {
    let b = to_bytes(s);
    let mut i: i64 = 0;
    let mut j = b.len();
    while i < j and has_byte(" ,|", b[i]) {
        i += 1;
    }
    while j > i and has_byte(" ,|", b[j - 1]) {
        j -= 1;
    }
    byte_str(b, i, j)
}

#[derive(Clone)]
struct Ev {
    utc: i64,
    k: i64,
    n: i64,
    name: String,
    dt: DateTime,
    assumed: bool,
    rest: String,
}

fn ev_before(a: ref Ev, b: ref Ev) -> bool {
    if a.utc != b.utc {
        return a.utc < b.utc;
    }
    if a.k != b.k {
        return a.k < b.k;
    }
    a.n < b.n
}

fn utc_dt(us: i64) -> Result[DateTime, String] {
    from_wall(us, with_zone(naive(1, 1, 1, 0, 0, 0, 0), 0, String.new()))
}

fn section_normalize() -> Result[(), String] {
    println("== normalize");
    let mut events: Vec[Ev] = Vec.new();
    let sources = data_lines("data/sources.txt")?;
    for k in 0..sources.len() {
        let parts = split_str(sources[k], " | ");
        let name = parts[0].clone();
        let rule = parts[2].clone();
        let fmt = parts[3].clone();
        let mut good: i64 = 0;
        let mut bad: i64 = 0;
        let mut notes: Vec[String] = Vec.new();
        let mut last: Option[i64] = None;
        let lines = data_lines(f"data/logs/{parts[1]}")?;
        for i in 0..lines.len() {
            let n = i + 1;
            let line = lines[i].clone();
            let found = find_stamp(line, rule);
            let parsed = match found {
                Some(st) => parse_stamp(st, fmt),
                None => Err("ValueError: no timestamp found".to_string()),
            };
            let mut dt = match parsed {
                Ok(d) => d,
                Err(e) => {
                    bad += 1;
                    notes.push(f"  line {n}: {e}");
                    continue;
                }
            };
            let assumed = not dt.aware;
            if assumed {
                dt = with_zone(dt, offset_of(parts[4]), String.new());
            }
            let utc = utc_us(dt);
            if let Some(l) = last {
                if utc < l {
                    notes.push(f"  line {n}: {td_str(td_from_us(utc - l)?)} out of order");
                }
            }
            last = Some(utc);
            good += 1;
            let stamp = find_stamp(line, rule).unwrap_or(String.new());
            let cut = if rule == "bracket" { f"[{stamp}]" } else { stamp };
            let rest = strip_punct(join(split_ws(remove_first(line, cut)), " "));
            events.push(Ev { utc: utc, k: k, n: n, name: name.clone(), dt: dt, assumed: assumed, rest: rest });
        }
        println(f"{name}: {good + bad} lines, {good} parsed, {bad} failed");
        for x in notes {
            println(x);
        }
    }
    for i in 1..events.len() {
        let mut j = i;
        while j > 0 and ev_before(events[j], events[j - 1]) {
            events.swap(j - 1, j);
            j -= 1;
        }
    }
    println("-- timeline (UTC)");
    for i in 0..events.len() {
        let e = events[i].clone();
        let gap = if i == 0 { "-".to_string() } else { td_str(td_from_us(e.utc - events[i - 1].utc)?) };
        let mark = if e.assumed { "*" } else { " " };
        let u = utc_dt(e.utc)?;
        println(f"{dt_iso(u, "T", "milliseconds")} {rjust(gap, 15)} {ljust(e.name, 8)} {dt_iso(e.dt, " ", "microseconds")}{mark} {e.rest}");
    }
    println("-- per minute");
    let minute: i64 = 60 * US_PER_SEC;
    let mut i: i64 = 0;
    while i < events.len() {
        let key = events[i].utc - events[i].utc % minute;
        let mut count: i64 = 0;
        while i < events.len() and events[i].utc - events[i].utc % minute == key {
            count += 1;
            i += 1;
        }
        let mut bar = String.new();
        for _ in 0..count {
            bar.push_str("#");
        }
        println(f"{py_strftime("%m-%d %H:%M", utc_dt(key)?)} {bar} {count}");
    }
    let first = events[0].utc;
    let last = events[events.len() - 1].utc;
    println(f"span {dt_iso(utc_dt(first)?, "T", "auto")} to {dt_iso(utc_dt(last)?, "T", "auto")}: {td_str(td_from_us(last - first)?)}, {events.len()} events");
    Ok(())
}

fn run() -> Result[(), String] {
    write_data()?;
    section_strptime()?;
    section_strftime()?;
    section_iso()?;
    section_deltas()?;
    section_normalize()
}

fn main() {
    if let Err(e) = run() {
        println(f"mini_datetime: {e}");
    }
}
