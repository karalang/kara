// data/deltas.txt
fn file_0() -> String {
    """
# td <fields>, add <datetime> <fields>, sub <datetime> <datetime>,
# mul <fields> <n>, floordiv <fields> / <fields>, mod <fields> / <fields>,
# neg <fields>, abs <fields>
td days=1 hours=-25
td seconds=-1
td microseconds=-1
td weeks=2 days=3 hours=4 minutes=5 seconds=6 milliseconds=7 microseconds=8
td hours=-24
td minutes=90
td days=0
td days=999999999 hours=23 minutes=59 seconds=59 microseconds=999999
td days=1000000000
td days=-999999999
td days=-999999999 microseconds=-1
add 2026-10-15T08:00:00 days=30
add 2026-12-31T23:59:59.999999 microseconds=1
add 2024-02-28T12:00:00+02:00 days=1 hours=12
add 9999-12-31T00:00:00 days=1
add 0001-01-01T00:00:00 seconds=-1
sub 2026-03-08T12:00:00+02:00 2026-03-01T00:00:00-05:00
sub 2026-10-15T08:00:00 2026-10-15T08:00:00.000001
sub 2026-10-15T08:00:00 2026-10-15T08:00:00+00:00
mul days=1 hours=6 3
mul hours=-1 minutes=-1 2
floordiv hours=1 / minutes=7
floordiv hours=-1 / minutes=7
floordiv hours=1 / days=0
mod hours=1 / minutes=7
mod hours=-1 / minutes=7
neg hours=1
neg days=-1 seconds=1
abs days=-1 seconds=1

"""
}

// data/iso.txt
fn file_1() -> String {
    """
# datetime.fromisoformat, or date/time with a `date ` or `time ` prefix
2026-10-15
20261015
2026-W42
2026-W42-4
2026W424
2026-288
