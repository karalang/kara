== timedelta
td days=1 hours=-25: -1 day, 23:00:00 = datetime.timedelta(days=-1, seconds=82800)
td seconds=-1: -1 day, 23:59:59 = datetime.timedelta(days=-1, seconds=86399)
td microseconds=-1: -1 day, 23:59:59.999999 = datetime.timedelta(days=-1, seconds=86399, microseconds=999999)
td weeks=2 days=3 hours=4 minutes=5 seconds=6 milliseconds=7 microseconds=8: 17 days, 4:05:06.007008 = datetime.timedelta(days=17, seconds=14706, microseconds=7008)
td hours=-24: -1 day, 0:00:00 = datetime.timedelta(days=-1)
td minutes=90: 1:30:00 = datetime.timedelta(seconds=5400)
td days=0: 0:00:00 = datetime.timedelta(0)
td days=999999999 hours=23 minutes=59 seconds=59 microseconds=999999: 999999999 days, 23:59:59.999999 = datetime.timedelta(days=999999999, seconds=86399, microseconds=999999)
td days=1000000000: OverflowError: days=1000000000; must have magnitude <= 999999999
td days=-999999999: -999999999 days, 0:00:00 = datetime.timedelta(days=-999999999)
td days=-999999999 microseconds=-1: OverflowError: days=-1000000000; must have magnitude <= 999999999
add 2026-10-15T08:00:00 days=30: 2026-11-14T08:00:00
add 2026-12-31T23:59:59.999999 microseconds=1: 2027-01-01T00:00:00
add 2024-02-28T12:00:00+02:00 days=1 hours=12: 2024-03-01T00:00:00+02:00 [UTC+02:00]
add 9999-12-31T00:00:00 days=1: OverflowError: date value out of range
add 0001-01-01T00:00:00 seconds=-1: OverflowError: date value out of range
sub 2026-03-08T12:00:00+02:00 2026-03-01T00:00:00-05:00: 7 days, 5:00:00 = datetime.timedelta(days=7, seconds=18000)
sub 2026-10-15T08:00:00 2026-10-15T08:00:00.000001: -1 day, 23:59:59.999999 = datetime.timedelta(days=-1, seconds=86399, microseconds=999999)
sub 2026-10-15T08:00:00 2026-10-15T08:00:00+00:00: TypeError: can't subtract offset-naive and offset-aware datetimes
mul days=1 hours=6 3: 3 days, 18:00:00 = datetime.timedelta(days=3, seconds=64800)
mul hours=-1 minutes=-1 2: -1 day, 21:58:00 = datetime.timedelta(days=-1, seconds=79080)
