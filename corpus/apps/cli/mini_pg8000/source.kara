// mini_pg8000: pg8000 1.31.2, the pure-Python PostgreSQL driver, with the
// scramp 1.4.5 SCRAM client it authenticates through, ported to Kāra.
//
// Each session talks to a fake socket that replays a server's bytes from
// data/<session>.bin and prints every message the client flushes, so the
// whole wire exchange shows: startup, cleartext, MD5 and SCRAM
// authentication, simple and extended queries, prepared statements, COPY
// in both directions, errors, notices and notifications. The other jobs
// drive pg8000's pure functions: the :name placeholder rewriter, the five
// DB-API paramstyles, identifier() and literal(), and every in- and
// out-converter, printed as Python's repr() would.

const BIG_INT: i128 = 100000000000000000000000000000000000000;

struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: Str, msg: Str) -> Exc {
    Exc { kind: kind.to_string(), msg: msg.to_string() }
}


fn type_error(msg: Str) -> Exc {
    exc("TypeError", msg)
}

fn value_error(msg: Str) -> Exc {
    exc("ValueError", msg)
}

fn key_error(key: Str) -> Exc {
    exc("KeyError", py_str_repr(key))
}

fn show_exc(e: ref Exc) -> String {
    f"{e.kind}: {e.msg}"
}


fn hex_n(n: i64, width: i64) -> String {
    let mut digits: Vec[char] = Vec.new();
    let mut v = n;
    while v > 0 {
        let d = v % 16;
        let code = if d < 10 { 48 + d } else { 87 + d };
        digits.push(char.try_from(code as u32).unwrap_or('0'));
        v = v / 16;
    }
    while (digits.len() as i64) < width {
        digits.push('0');
    }
    let mut out = String.new();
    let mut i = digits.len() as i64 - 1;
    while i >= 0 {
        out.push(digits[i]);
        i -= 1;
    }
    out
}

fn hex_of(b: ref Vec[u8]) -> String {
    let mut out = String.new();
    for x in b {
        out.push_str(hex_n(*x as i64, 2));
    }
    out
}

fn hex_val(c: char) -> i64 {
    let n = c as i64;
    if n >= 48 and n <= 57 {
        return n - 48;
    }
    if n >= 97 and n <= 102 {
        return n - 87;
    }
    if n >= 65 and n <= 70 {
        return n - 55;
    }
    -1
}

// bytes.fromhex: ASCII whitespace may sit between the byte pairs.
fn from_hex(s: Str) -> Option[Vec[u8]] {
    let cs: Vec[char] = s.chars().collect();
    let n = cs.len() as i64;
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i < n {
        if is_ascii_space(cs[i]) {
            i += 1;
            continue;
        }
        if i + 1 >= n {
            return None;
        }
        let hi = hex_val(cs[i]);
        let lo = hex_val(cs[i + 1]);
        if hi < 0 or lo < 0 {
            return None;
        }
        out.push((hi * 16 + lo) as u8);
        i += 2;
    }
    Some(out)
}


fn is_ascii_space(c: char) -> bool {
    c == ' ' or c == '\t' or c == '\n' or c == '\r' or c as u32 == 11 or c as u32 == 12
}

// str.isspace(), which str.strip(), int() and float() use.
fn is_py_space(c: char) -> bool {
    let n = c as u32;
    if n <= 32 {
        return n == 32 or (n >= 9 and n <= 13) or (n >= 28 and n <= 31);
    }
    n == 0x85 or n == 0xA0 or n == 0x1680 or (n >= 0x2000 and n <= 0x200A) or n == 0x2028
        or n == 0x2029 or n == 0x202F or n == 0x205F or n == 0x3000
}

fn py_strip(s: Str) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut a: i64 = 0;
    let mut b = cs.len() as i64;
    while a < b and is_py_space(cs[a]) {
        a += 1;
    }
    while b > a and is_py_space(cs[b - 1]) {
        b -= 1;
    }
    let mut out = String.new();
    let mut i = a;
    while i < b {
        out.push(cs[i]);
        i += 1;
    }
    out
}

// str.isprintable(): the Other and Separator categories are not
// printable, the ASCII space is. Unassigned code points count as
// printable here.
fn is_printable(n: u32) -> bool {
    if n < 0x20 or (n >= 0x7F and n <= 0x9F) {
        return false;
    }
    if n == 0xA0 or n == 0xAD or n == 0x1680 or (n >= 0x2000 and n <= 0x200F) {
        return false;
    }
    if (n >= 0x2028 and n <= 0x202F) or (n >= 0x205F and n <= 0x2064) or (n >= 0x2066 and n <= 0x206F) {
        return false;
    }
    if n == 0x3000 or n == 0xFEFF or (n >= 0xFFF9 and n <= 0xFFFB) {
        return false;
    }
    if (n >= 0x600 and n <= 0x605) or n == 0x61C or n == 0x6DD or n == 0x70F or n == 0x890
        or n == 0x891 or n == 0x8E2 or n == 0x180E {
        return false;
    }
    if n == 0x110BD or n == 0x110CD or (n >= 0x13430 and n <= 0x1343F) or (n >= 0x1BCA0 and n <= 0x1BCA3)
        or (n >= 0x1D173 and n <= 0x1D17A) or n == 0xE0001 or (n >= 0xE0020 and n <= 0xE007F) {
        return false;
    }
    if (n >= 0xE000 and n <= 0xF8FF) or n >= 0xF0000 {
        return false;
    }
    true
}

fn py_str_repr(s: Str) -> String {
    let quote = if s.contains("'") and not s.contains("\"") { '"' } else { '\'' };
    let mut out = String.new();
    out.push(quote);
    for c in s.chars() {
        let n = c as u32;
        if c == quote or c == '\\' {
            out.push('\\');
            out.push(c);
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if n < 0x20 or n == 0x7F {
            out.push_str(f"\\x{hex_n(n as i64, 2)}");
        } else if n < 0x7F or is_printable(n) {
            out.push(c);
        } else if n <= 0xFF {
            out.push_str(f"\\x{hex_n(n as i64, 2)}");
        } else if n <= 0xFFFF {
            out.push_str(f"\\u{hex_n(n as i64, 4)}");
        } else {
            out.push_str(f"\\U{hex_n(n as i64, 8)}");
        }
    }
    out.push(quote);
    out
}

fn py_bytes_repr(b: ref Vec[u8]) -> String {
    let mut has_single = false;
    let mut has_double = false;
    for x in b {
        if *x == 39 {
            has_single = true;
        }
        if *x == 34 {
            has_double = true;
        }
    }
    let quote: u8 = if has_single and not has_double { 34 } else { 39 };
    let mut out = String.new();
    out.push('b');
    out.push(quote as char);
    for x in b {
        let v = *x;
        if v == quote or v == 92 {
            out.push('\\');
            out.push(v as char);
        } else if v == 9 {
            out.push_str("\\t");
        } else if v == 10 {
            out.push_str("\\n");
        } else if v == 13 {
            out.push_str("\\r");
        } else if v < 32 or v >= 127 {
            out.push_str(f"\\x{hex_n(v as i64, 2)}");
        } else {
            out.push(v as char);
        }
    }
    out.push(quote as char);
    out
}

// bytes.decode('utf-8') with CPython's strict error messages.
fn utf8_decode(b: ref Vec[u8], start: i64, end: i64) -> Result[String, Exc] {
    let mut i = start;
    while i < end {
        let c = b[i] as i64;
        if c < 0x80 {
            i += 1;
            continue;
        }
        let need: i64 = if c >= 0xC2 and c < 0xE0 {
            1
        } else if c >= 0xE0 and c < 0xF0 {
            2
        } else if c >= 0xF0 and c < 0xF5 {
            3
        } else {
            0
        };
        if need == 0 {
            return Err(utf8_error(b, start, i, i + 1, "invalid start byte"));
        }
        let mut k: i64 = 1;
        while k <= need {
            if i + k >= end {
                return Err(utf8_error(b, start, i, end, "unexpected end of data"));
            }
            let d = b[i + k] as i64;
            let mut lo: i64 = 0x80;
            let mut hi: i64 = 0xBF;
            if k == 1 {
                if c == 0xE0 {
                    lo = 0xA0;
                } else if c == 0xED {
                    hi = 0x9F;
                } else if c == 0xF0 {
                    lo = 0x90;
                } else if c == 0xF4 {
                    hi = 0x8F;
                }
            }
            if d < lo or d > hi {
                return Err(utf8_error(b, start, i, i + k, "invalid continuation byte"));
            }
            k += 1;
        }
        i += need + 1;
    }
    Ok(String.from_utf8(b[start..end].to_vec()).unwrap_or(String.new()))
}

fn utf8_error(b: ref Vec[u8], base: i64, a: i64, e: i64, reason: Str) -> Exc {
    if e - a == 1 {
        let byte = hex_n(b[a] as i64, 2);
        return exc("UnicodeDecodeError", f"'utf-8' codec can't decode byte 0x{byte} in position {a - base}: {reason}");
    }
    exc("UnicodeDecodeError", f"'utf-8' codec can't decode bytes in position {a - base}-{e - 1 - base}: {reason}")
}

// A JSON string as json.dumps writes it with ensure_ascii.

fn json_str(s: Str) -> String {
    let mut out = String.new();
    out.push('"');
    for c in s.chars() {
        let n = c as u32;
        if c == '"' {
            out.push_str("\\\"");
        } else if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\r' {
            out.push_str("\\r");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if n == 8 {
            out.push_str("\\b");
        } else if n == 12 {
            out.push_str("\\f");
        } else if n >= 0x20 and n <= 0x7E {
            out.push(c);
        } else if n > 0xFFFF {
            let v = n as i64 - 0x10000;
            out.push_str(f"\\u{hex_n(0xD800 + v / 1024, 4)}\\u{hex_n(0xDC00 + v % 1024, 4)}");
        } else {
            out.push_str(f"\\u{hex_n(n as i64, 4)}");
        }
    }
    out.push('"');
    out
}


fn char_count(s: Str) -> i64 {
    s.chars().count() as i64
}

// s[i] by code point, with Python's negative indexes.
fn char_at(s: Str, i: i64) -> Result[char, Exc] {
    let cs: Vec[char] = s.chars().collect();
    let n = cs.len() as i64;
    let k = if i < 0 { i + n } else { i };
    if k < 0 or k >= n {
        return Err(exc("IndexError", "string index out of range"));
    }
    Ok(cs[k])
}

// s[a:b] by code point; a and b already clamped to the string.
fn char_slice(cs: ref Vec[char], a: i64, b: i64) -> String {
    let mut out = String.new();
    let mut i = a;
    while i < b {
        out.push(cs[i]);
        i += 1;
    }
    out
}

// ---- numbers: Python's int() and float() on str, and Decimal128 ----


fn is_digit(c: char) -> bool {
    c >= '0' and c <= '9'
}

// The digits of int(s, base) for base 10 or 16, as CPython parses a str:
// surrounding whitespace, a sign, a 0x prefix in base 16 and single
// underscores between digits.
fn py_int_digits(s: Str, base: i64) -> Result[(bool, Vec[i64]), Exc] {
    let bad = value_error(f"invalid literal for int() with base {base}: {py_str_repr(s)}");
    let cs: Vec[char] = py_strip(s).chars().collect();
    let n = cs.len() as i64;
    let mut i: i64 = 0;
    let mut neg = false;
    if i < n and (cs[i] == '+' or cs[i] == '-') {
        neg = cs[i] == '-';
        i += 1;
    }
    let mut prefixed = false;
    if base == 16 and i + 1 < n and cs[i] == '0' and (cs[i + 1] == 'x' or cs[i + 1] == 'X') {
        i += 2;
        prefixed = true;
    }
    let mut digits: Vec[i64] = Vec.new();
    let mut last_underscore = false;
    while i < n {
        let c = cs[i];
        if c == '_' {
            if last_underscore or (digits.len() == 0 and not prefixed) {
                return Err(bad);
            }
            last_underscore = true;
            i += 1;
            continue;
        }
        let d = hex_val(c);
        if d < 0 or d >= base {
            return Err(bad);
        }
        digits.push(d);
        last_underscore = false;
        i += 1;
    }
    if digits.len() == 0 or last_underscore {
        return Err(bad);
    }
    Ok((neg, digits))
}

// int(s, base); a value past BIG_INT saturates there.
fn py_int(s: Str, base: i64) -> Result[i128, Exc] {
    let (neg, digits) = py_int_digits(s, base)?;
    let mut v: i128 = 0;
    for d in digits {
        if v >= BIG_INT / 16 {
            v = BIG_INT;
        } else {
            v = v * (base as i128) + (d as i128);
        }
    }
    Ok(if neg { -v } else { v })
}

// float(s) on a str.
fn py_float(s: Str) -> Result[f64, Exc] {
    let bad = value_error(f"could not convert string to float: {py_str_repr(s)}");
    let t = py_strip(s);
    let cs: Vec[char] = t.chars().collect();
    let n = cs.len() as i64;
    let mut i: i64 = 0;
    let mut clean = String.new();
    if i < n and (cs[i] == '+' or cs[i] == '-') {
        clean.push(cs[i]);
        i += 1;
    }
    let word = char_slice(cs, i, n).to_lowercase();
    if word == "inf" or word == "infinity" or word == "nan" {
        clean.push_str(word);
        return match f64.parse(clean) {
            Ok(x) => Ok(x),
            Err(_) => Err(bad),
        };
    }
    let mut mantissa: i64 = 0;
    // part 0: integer digits, 1: fraction digits, 2: exponent digits
    let mut part: i64 = 0;
    let mut part_digits: i64 = 0;
    let mut prev_digit = false;
    while i < n {
        let c = cs[i];
        if is_digit(c) {
            clean.push(c);
            part_digits += 1;
            if part < 2 {
                mantissa += 1;
            }
            prev_digit = true;
        } else if c == '_' {
            if not prev_digit or i + 1 >= n or not is_digit(cs[i + 1]) {
                return Err(bad);
            }
            prev_digit = false;
        } else if c == '.' and part == 0 {
            clean.push(c);
            part = 1;
            part_digits = 0;
            prev_digit = false;
        } else if (c == 'e' or c == 'E') and part < 2 and mantissa > 0 {
            clean.push('e');
            part = 2;
            part_digits = 0;
            prev_digit = false;
            if i + 1 < n and (cs[i + 1] == '+' or cs[i + 1] == '-') {
                clean.push(cs[i + 1]);
                i += 1;
            }
        } else {
            return Err(bad);
        }
        i += 1;
    }
    if mantissa == 0 or (part == 2 and part_digits == 0) {
        return Err(bad);
    }
    match f64.parse(clean) {
        Ok(x) => Ok(x),
        Err(_) => Err(bad),
    }
}

// ------------------------------------------------------------ MD5 (RFC 1321)

const MD5_S: Array[i64, 64] = [
    7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
    5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
    4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
    6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21,
];

const MD5_K: Array[u32, 64] = [
    0xd76aa478u32, 0xe8c7b756u32, 0x242070dbu32, 0xc1bdceeeu32, 0xf57c0fafu32, 0x4787c62au32, 0xa8304613u32, 0xfd469501u32,
    0x698098d8u32, 0x8b44f7afu32, 0xffff5bb1u32, 0x895cd7beu32, 0x6b901122u32, 0xfd987193u32, 0xa679438eu32, 0x49b40821u32,
    0xf61e2562u32, 0xc040b340u32, 0x265e5a51u32, 0xe9b6c7aau32, 0xd62f105du32, 0x02441453u32, 0xd8a1e681u32, 0xe7d3fbc8u32,
    0x21e1cde6u32, 0xc33707d6u32, 0xf4d50d87u32, 0x455a14edu32, 0xa9e3e905u32, 0xfcefa3f8u32, 0x676f02d9u32, 0x8d2a4c8au32,
    0xfffa3942u32, 0x8771f681u32, 0x6d9d6122u32, 0xfde5380cu32, 0xa4beea44u32, 0x4bdecfa9u32, 0xf6bb4b60u32, 0xbebfbc70u32,
    0x289b7ec6u32, 0xeaa127fau32, 0xd4ef3085u32, 0x04881d05u32, 0xd9d4d039u32, 0xe6db99e5u32, 0x1fa27cf8u32, 0xc4ac5665u32,
    0xf4292244u32, 0x432aff97u32, 0xab9423a7u32, 0xfc93a039u32, 0x655b59c3u32, 0x8f0ccc92u32, 0xffeff47du32, 0x85845dd1u32,
    0x6fa87e4fu32, 0xfe2ce6e0u32, 0xa3014314u32, 0x4e0811a1u32, 0xf7537e82u32, 0xbd3af235u32, 0x2ad7d2bbu32, 0xeb86d391u32,
];

// The message padded to whole 64- or 128-byte blocks, with its bit
// length in `lenbytes` bytes, big- or little-endian.
fn md_pad(msg: ref Vec[u8], block: i64, lenbytes: i64, big: bool) -> Vec[u8] {
    let mut m = msg.clone();
    let bits = msg.len() * 8;
    m.push(0x80);
    while m.len() % block != block - lenbytes {
        m.push(0);
    }
    for k in 0..lenbytes {
        let shift = if big { 8 * (lenbytes - 1 - k) } else { 8 * k };
        let b = if shift >= 64 { 0 } else { (bits >> shift) & 0xFF };
        m.push(b as u8);
    }
    m
}

fn le32(b: ref Vec[u8], i: i64) -> u32 {
    (b[i] as u32) | ((b[i + 1] as u32) << 8) | ((b[i + 2] as u32) << 16) | ((b[i + 3] as u32) << 24)
}

fn be32(b: ref Vec[u8], i: i64) -> u32 {
    ((b[i] as u32) << 24) | ((b[i + 1] as u32) << 16) | ((b[i + 2] as u32) << 8) | (b[i + 3] as u32)
}

fn be64(b: ref Vec[u8], i: i64) -> u64 {
    let mut v: u64 = 0;
    for k in 0..8 {
        v = (v << 8) | (b[i + k] as u64);
    }
    v
}

fn le64(b: ref Vec[u8], i: i64) -> u64 {
    let mut v: u64 = 0;
    let mut k: i64 = 7;
    while k >= 0 {
        v = (v << 8) | (b[i + k] as u64);
        k -= 1;
    }
    v
}

fn push_le32(out: mut ref Vec[u8], x: u32) {
    for k in 0..4 {
        out.push(((x >> ((8 * k) as u32)) & 0xFFu32) as u8);
    }
}

fn push_be32(out: mut ref Vec[u8], x: u32) {
    let mut k: i64 = 3;
    while k >= 0 {
        out.push(((x >> ((8 * k) as u32)) & 0xFFu32) as u8);
        k -= 1;
    }
}

fn push_be64(out: mut ref Vec[u8], x: u64) {
    let mut k: i64 = 7;
    while k >= 0 {
        out.push(((x >> ((8 * k) as u64)) & 0xFFu64) as u8);
        k -= 1;
    }
}

fn md5(msg: ref Vec[u8]) -> Vec[u8] {
    let m = md_pad(msg, 64, 8, false);
    let mut h: Vec[u32] = Vec.new();
    for x in [0x67452301u32, 0xefcdab89u32, 0x98badcfeu32, 0x10325476u32] {
        h.push(x);
    }
    let mut blk: i64 = 0;
    while blk < m.len() {
        let mut a = h[0];
        let mut b = h[1];
        let mut c = h[2];
        let mut d = h[3];
        for i in 0..64 {
            let mut f: u32 = 0;
            let mut g: i64 = 0;
            if i < 16 {
                f = (b & c) | ((b ^ 0xFFFFFFFFu32) & d);
                g = i;
            } else if i < 32 {
                f = (d & b) | ((d ^ 0xFFFFFFFFu32) & c);
                g = (5 * i + 1) % 16;
            } else if i < 48 {
                f = b ^ c ^ d;
                g = (3 * i + 5) % 16;
            } else {
                f = c ^ (b | (d ^ 0xFFFFFFFFu32));
                g = (7 * i) % 16;
            }
            let x = a.wrapping_add(f).wrapping_add(MD5_K[i]).wrapping_add(le32(m, blk + 4 * g));
            a = d;
            d = c;
            c = b;
            b = b.wrapping_add(x.rotate_left(MD5_S[i] as u32));
        }
        h[0] = h[0].wrapping_add(a);
        h[1] = h[1].wrapping_add(b);
        h[2] = h[2].wrapping_add(c);
        h[3] = h[3].wrapping_add(d);
        blk += 64;
    }
    let mut out: Vec[u8] = Vec.new();
    for x in h {
        push_le32(mut out, x);
    }
    out
}

// ------------------------------------------------------------ SHA-1 and SHA-2 (FIPS 180-4)

fn sha1(msg: ref Vec[u8]) -> Vec[u8] {
    let m = md_pad(msg, 64, 8, true);
    let mut h: Vec[u32] = Vec.new();
    for x in [0x67452301u32, 0xEFCDAB89u32, 0x98BADCFEu32, 0x10325476u32, 0xC3D2E1F0u32] {
        h.push(x);
    }
    let mut w: Vec[u32] = Vec.new();
    for _ in 0..80 {
        w.push(0u32);
    }
    let mut blk: i64 = 0;
    while blk < m.len() {
        for t in 0..16 {
            w[t] = be32(m, blk + 4 * t);
        }
        for t in 16..80 {
            w[t] = (w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16]).rotate_left(1);
        }
        let mut a = h[0];
        let mut b = h[1];
        let mut c = h[2];
        let mut d = h[3];
        let mut e = h[4];
        for t in 0..80 {
            let mut f: u32 = 0;
            let mut k: u32 = 0;
            if t < 20 {
                f = (b & c) | ((b ^ 0xFFFFFFFFu32) & d);
                k = 0x5A827999u32;
            } else if t < 40 {
                f = b ^ c ^ d;
                k = 0x6ED9EBA1u32;
            } else if t < 60 {
                f = (b & c) | (b & d) | (c & d);
                k = 0x8F1BBCDCu32;
            } else {
                f = b ^ c ^ d;
                k = 0xCA62C1D6u32;
            }
            let tmp = a.rotate_left(5).wrapping_add(f).wrapping_add(e).wrapping_add(k).wrapping_add(w[t]);
            e = d;
            d = c;
            c = b.rotate_left(30);
            b = a;
            a = tmp;
        }
        h[0] = h[0].wrapping_add(a);
        h[1] = h[1].wrapping_add(b);
        h[2] = h[2].wrapping_add(c);
        h[3] = h[3].wrapping_add(d);
        h[4] = h[4].wrapping_add(e);
        blk += 64;
    }
    let mut out: Vec[u8] = Vec.new();
    for x in h {
        push_be32(mut out, x);
    }
    out
}

const SHA256_K: Array[u32, 64] = [
    0x428a2f98u32, 0x71374491u32, 0xb5c0fbcfu32, 0xe9b5dba5u32, 0x3956c25bu32, 0x59f111f1u32, 0x923f82a4u32, 0xab1c5ed5u32,
    0xd807aa98u32, 0x12835b01u32, 0x243185beu32, 0x550c7dc3u32, 0x72be5d74u32, 0x80deb1feu32, 0x9bdc06a7u32, 0xc19bf174u32,
    0xe49b69c1u32, 0xefbe4786u32, 0x0fc19dc6u32, 0x240ca1ccu32, 0x2de92c6fu32, 0x4a7484aau32, 0x5cb0a9dcu32, 0x76f988dau32,
    0x983e5152u32, 0xa831c66du32, 0xb00327c8u32, 0xbf597fc7u32, 0xc6e00bf3u32, 0xd5a79147u32, 0x06ca6351u32, 0x14292967u32,
    0x27b70a85u32, 0x2e1b2138u32, 0x4d2c6dfcu32, 0x53380d13u32, 0x650a7354u32, 0x766a0abbu32, 0x81c2c92eu32, 0x92722c85u32,
    0xa2bfe8a1u32, 0xa81a664bu32, 0xc24b8b70u32, 0xc76c51a3u32, 0xd192e819u32, 0xd6990624u32, 0xf40e3585u32, 0x106aa070u32,
    0x19a4c116u32, 0x1e376c08u32, 0x2748774cu32, 0x34b0bcb5u32, 0x391c0cb3u32, 0x4ed8aa4au32, 0x5b9cca4fu32, 0x682e6ff3u32,
    0x748f82eeu32, 0x78a5636fu32, 0x84c87814u32, 0x8cc70208u32, 0x90befffau32, 0xa4506cebu32, 0xbef9a3f7u32, 0xc67178f2u32,
];

// SHA-256, or SHA-224 with its own initial values and a shorter result.
fn sha256_family(msg: ref Vec[u8], is224: bool) -> Vec[u8] {
    let m = md_pad(msg, 64, 8, true);
    let mut h: Vec[u32] = Vec.new();
    if is224 {
        for x in [0xc1059ed8u32, 0x367cd507u32, 0x3070dd17u32, 0xf70e5939u32, 0xffc00b31u32, 0x68581511u32, 0x64f98fa7u32, 0xbefa4fa4u32] {
            h.push(x);
        }
    } else {
        for x in [0x6a09e667u32, 0xbb67ae85u32, 0x3c6ef372u32, 0xa54ff53au32, 0x510e527fu32, 0x9b05688cu32, 0x1f83d9abu32, 0x5be0cd19u32] {
            h.push(x);
        }
    }
    let mut w: Vec[u32] = Vec.new();
    for _ in 0..64 {
        w.push(0u32);
    }
    let mut blk: i64 = 0;
    while blk < m.len() {
        for t in 0..16 {
            w[t] = be32(m, blk + 4 * t);
        }
        for t in 16..64 {
            let s0 = w[t - 15].rotate_right(7) ^ w[t - 15].rotate_right(18) ^ (w[t - 15] >> 3u32);
            let s1 = w[t - 2].rotate_right(17) ^ w[t - 2].rotate_right(19) ^ (w[t - 2] >> 10u32);
            w[t] = w[t - 16].wrapping_add(s0).wrapping_add(w[t - 7]).wrapping_add(s1);
        }
        let mut v: Vec[u32] = h.clone();
        for t in 0..64 {
            let e = v[4];
            let a = v[0];
            let s1 = e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25);
            let ch = (e & v[5]) ^ ((e ^ 0xFFFFFFFFu32) & v[6]);
            let t1 = v[7].wrapping_add(s1).wrapping_add(ch).wrapping_add(SHA256_K[t]).wrapping_add(w[t]);
            let s0 = a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22);
            let maj = (a & v[1]) ^ (a & v[2]) ^ (v[1] & v[2]);
            let t2 = s0.wrapping_add(maj);
            v[7] = v[6];
            v[6] = v[5];
            v[5] = v[4];
            v[4] = v[3].wrapping_add(t1);
            v[3] = v[2];
            v[2] = v[1];
            v[1] = v[0];
            v[0] = t1.wrapping_add(t2);
        }
        for i in 0..8 {
            h[i] = h[i].wrapping_add(v[i]);
        }
        blk += 64;
    }
    let mut out: Vec[u8] = Vec.new();
    let n = if is224 { 7 } else { 8 };
    for i in 0..n {
        push_be32(mut out, h[i]);
    }
    out
}

// ------------------------------------------------------------ HMAC and PBKDF2, for SCRAM

const D_MD5: i64 = 0;
const D_SHA1: i64 = 1;
const D_SHA256: i64 = 2;

fn digest(kind: i64, msg: ref Vec[u8]) -> Vec[u8] {
    if kind == D_MD5 {
        md5(msg)
    } else if kind == D_SHA1 {
        sha1(msg)
    } else {
        sha256_family(msg, false)
    }
}

fn digest_size(kind: i64) -> i64 {
    if kind == D_MD5 {
        16
    } else if kind == D_SHA1 {
        20
    } else {
        32
    }
}

fn cat(a: ref Vec[u8], b: ref Vec[u8]) -> Vec[u8] {
    let mut out = a.clone();
    for x in b {
        out.push(x);
    }
    out
}

// hmac.new(key, msg, hf).digest()
fn hmac(kind: i64, key: ref Vec[u8], msg: ref Vec[u8]) -> Vec[u8] {
    let mut k = if key.len() > 64 { digest(kind, key) } else { key.clone() };
    while k.len() < 64 {
        k.push(0);
    }
    let mut ipad: Vec[u8] = Vec.new();
    let mut opad: Vec[u8] = Vec.new();
    for x in k {
        ipad.push(x ^ 0x36);
        opad.push(x ^ 0x5c);
    }
    let inner = digest(kind, cat(ipad, msg));
    digest(kind, cat(opad, inner))
}

fn xor_bytes(a: ref Vec[u8], b: ref Vec[u8]) -> Vec[u8] {
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < a.len() and i < b.len() {
        out.push(a[i] ^ b[i]);
        i += 1;
    }
    out
}

// scramp.utils.hi: PBKDF2 with one block, the digest's own length.
fn hi(kind: i64, password: ref Vec[u8], salt: ref Vec[u8], iterations: i64) -> Vec[u8] {
    let mut first = salt.clone();
    for b in [0u8, 0u8, 0u8, 1u8] {
        first.push(b);
    }
    let mut ui = hmac(kind, password, first);
    let mut u = ui.clone();
    let mut i = 0;
    while i < iterations - 1 {
        ui = hmac(kind, password, ui);
        u = xor_bytes(u, ui);
        i += 1;
    }
    u
}

// ------------------------------------------------------------ base64

const BASE64_CHARS: Str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

fn b64encode_alt(b: ref Vec[u8], alt: Str) -> String {
    let mut map: Vec[char] = BASE64_CHARS.chars().collect();
    let a: Vec[char] = alt.chars().collect();
    if a.len() == 2 {
        map[62] = a[0];
        map[63] = a[1];
    }
    let mut out = String.new();
    let mut i = 0;
    while i + 2 < b.len() {
        let n = ((b[i] as i64) << 16) | ((b[i + 1] as i64) << 8) | (b[i + 2] as i64);
        out.push(map[(n >> 18) & 63]);
        out.push(map[(n >> 12) & 63]);
        out.push(map[(n >> 6) & 63]);
        out.push(map[n & 63]);
        i += 3;
    }
    let rest = b.len() - i;
    if rest == 1 {
        let n = (b[i] as i64) << 16;
        out.push(map[(n >> 18) & 63]);
        out.push(map[(n >> 12) & 63]);
        out.push_str("==");
    } else if rest == 2 {
        let n = ((b[i] as i64) << 16) | ((b[i + 1] as i64) << 8);
        out.push(map[(n >> 18) & 63]);
        out.push(map[(n >> 12) & 63]);
        out.push(map[(n >> 6) & 63]);
        out.push('=');
    }
    out
}

fn b64encode(b: ref Vec[u8]) -> String {
    b64encode_alt(b, "")
}

fn std_b64_value(c: u8) -> i64 {
    if c >= b'A' and c <= b'Z' {
        (c - b'A') as i64
    } else if c >= b'a' and c <= b'z' {
        (c - b'a') as i64 + 26
    } else if c >= b'0' and c <= b'9' {
        (c - b'0') as i64 + 52
    } else if c == b'+' {
        62
    } else if c == b'/' {
        63
    } else {
        -1
    }
}

// binascii.a2b_base64 in its default, non-strict mode: characters outside
// the alphabet are skipped and a complete pad sequence ends the input.
// Its errors come out as binascii.Error, which the job output prints as
// "Error".
fn a2b_base64(data: ref Vec[u8]) -> Result[Vec[u8], Exc] {
    let mut out: Vec[u8] = Vec.new();
    let mut quad = 0;
    let mut left: i64 = 0;
    let mut pads = 0;
    let mut i = 0;
    while i < data.len() {
        let c = data[i];
        i += 1;
        if c == b'=' {
            if quad >= 2 {
                pads += 1;
                if quad + pads >= 4 {
                    return Ok(out);
                }
            }
            continue;
        }
        let v = std_b64_value(c);
        if v < 0 {
            continue;
        }
        pads = 0;
        if quad == 0 {
            quad = 1;
            left = v;
        } else if quad == 1 {
            quad = 2;
            out.push((((left << 2) | (v >> 4)) & 255) as u8);
            left = v & 15;
        } else if quad == 2 {
            quad = 3;
            out.push((((left << 4) | (v >> 2)) & 255) as u8);
            left = v & 3;
        } else {
            quad = 0;
            out.push((((left << 6) | v) & 255) as u8);
            left = 0;
        }
    }
    if quad != 0 {
        if quad == 1 {
            let n = out.len() / 3 * 4 + 1;
            return Err(exc("Error", f"Invalid base64-encoded string: number of data characters ({n}) cannot be 1 more than a multiple of 4"));
        }
        return Err(exc("Error", "Incorrect padding".to_string()));
    }
    Ok(out)
}


// ---- json.loads: the C scanner from mini_json, over code points ----

enum J {
    Null,
    Bool(bool),
    Int(String),
    Float(f64),
    Str(Vec[i64]),
    Arr(Vec[J]),
    Obj(Vec[Member]),
}

struct Member {
    key: Vec[i64],
    val: J,
}
fn codepoints(b: ref Slice[u8]) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i] as i64;
        if c < 0x80 {
            out.push(c);
            i += 1;
        } else if c < 0xE0 {
            out.push(((c & 0x1F) << 6) | ((b[i + 1] as i64) & 0x3F));
            i += 2;
        } else if c < 0xF0 {
            out.push(((c & 0x0F) << 12) | (((b[i + 1] as i64) & 0x3F) << 6) | ((b[i + 2] as i64) & 0x3F));
            i += 3;
        } else {
            out.push(((c & 0x07) << 18) | (((b[i + 1] as i64) & 0x3F) << 12) | (((b[i + 2] as i64) & 0x3F) << 6) | ((b[i + 3] as i64) & 0x3F));
            i += 4;
        }
    }
    out
}

fn push_utf8(out: mut ref Vec[u8], cp: i64) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push((0xC0 | (cp >> 6)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else if cp < 0x10000 {
        out.push((0xE0 | (cp >> 12)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else {
        out.push((0xF0 | (cp >> 18)) as u8);
        out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    }
}

fn is_surrogate(cp: i64) -> bool {
    cp >= 0xD800 and cp <= 0xDFFF
}

fn hex4(cp: i64) -> String {
    let digits = "0123456789abcdef".bytes();
    let mut out: Vec[u8] = Vec.new();
    let mut shift = 12;
    while shift >= 0 {
        out.push(digits[(cp >> shift) & 15]);
        shift -= 4;
    }
    String.from_utf8(out).unwrap()
}

// str.encode("utf-8"): a lone surrogate cannot be encoded, and the error
// names the first run of them by position.
fn to_utf8(s: ref Vec[i64]) -> Result[String, Exc] {
    let mut out: Vec[u8] = Vec.new();
    let mut i = 0;
    while i < s.len() {
        let c = s[i];
        if is_surrogate(c) {
            let mut j = i;
            while j < s.len() and is_surrogate(s[j]) {
                j += 1;
            }
            let reason = "surrogates not allowed";
            if j - i == 1 {
                return Err(exc("UnicodeEncodeError", f"'utf-8' codec can't encode character '\\u{hex4(c)}' in position {i}: {reason}"));
            }
            return Err(exc("UnicodeEncodeError", f"'utf-8' codec can't encode characters in position {i}-{j - 1}: {reason}"));
        }
        push_utf8(mut out, c);
        i += 1;
    }
    Ok(String.from_utf8(out).unwrap())
}

fn push_ascii(out: mut ref Vec[i64], s: Str) {
    for b in s.bytes() {
        out.push(b as i64);
    }
}

fn ascii_string(s: ref Vec[i64], start: i64, end: i64) -> String {
    let mut out: Vec[u8] = Vec.new();
    let mut i = start;
    while i < end {
        out.push(s[i] as u8);
        i += 1;
    }
    String.from_utf8(out).unwrap()
}

fn cmp_cps(a: ref Vec[i64], b: ref Vec[i64]) -> i64 {
    let mut i = 0;
    while i < a.len() and i < b.len() {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 };
        }
        i += 1;
    }
    a.len() - b.len()
}

// ---------------------------------------------------------- decoding

// The C scanner in Modules/_json.c, over code points.
struct Scanner {
    s: Vec[i64],
}

fn j_digit(c: i64) -> bool {
    c >= 48 and c <= 57
}

fn hex_value(c: i64) -> i64 {
    if c >= 48 and c <= 57 {
        c - 48
    } else if c >= 97 and c <= 102 {
        c - 87
    } else if c >= 65 and c <= 70 {
        c - 55
    } else {
        -1
    }
}

impl Scanner {
    fn at(ref self, i: i64) -> i64 {
        if i >= 0 and i < self.s.len() { self.s[i] } else { -1 }
    }

    // JSONDecodeError's message: the line and column are counted from the
    // newlines before the position.
    fn fail(ref self, msg: Str, pos: i64) -> Exc {
        let mut line = 1;
        let mut last = -1;
        let mut i = 0;
        while i < pos {
            if self.s[i] == 10 {
                line += 1;
                last = i;
            }
            i += 1;
        }
        exc("JSONDecodeError", f"{msg}: line {line} column {pos - last} (char {pos})")
    }

    fn skip_ws(ref self, start: i64) -> i64 {
        let mut i = start;
        while i < self.s.len() {
            let c = self.s[i];
            if c != 32 and c != 9 and c != 10 and c != 13 {
                break;
            }
            i += 1;
        }
        i
    }

    fn matches(ref self, i: i64, word: Str) -> bool {
        let w = word.bytes();
        if i + w.len() > self.s.len() {
            return false;
        }
        let mut k = 0;
        while k < w.len() {
            if self.s[i + k] != w[k] as i64 {
                return false;
            }
            k += 1;
        }
        true
    }

    fn scan_once(ref self, idx: i64) -> Result[(J, i64), Exc] {
        let c = self.at(idx);
        if c == 34 {
            let (text, end) = self.scan_string(idx + 1)?;
            return Ok((J.Str(text), end));
        }
        if c == 123 {
            return self.parse_object(idx + 1);
        }
        if c == 91 {
            return self.parse_array(idx + 1);
        }
        if c == 110 and self.matches(idx, "null") {
            return Ok((J.Null, idx + 4));
        }
        if c == 116 and self.matches(idx, "true") {
            return Ok((J.Bool(true), idx + 4));
        }
        if c == 102 and self.matches(idx, "false") {
            return Ok((J.Bool(false), idx + 5));
        }
        if c == 78 and self.matches(idx, "NaN") {
            return Ok((J.Float(0.0 / 0.0), idx + 3));
        }
        if c == 73 and self.matches(idx, "Infinity") {
            return Ok((J.Float(1.0 / 0.0), idx + 8));
        }
        if c == 45 and self.matches(idx, "-Infinity") {
            return Ok((J.Float(-1.0 / 0.0), idx + 9));
        }
        self.match_number(idx)
    }

    // -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][-+]?[0-9]+)?, then int() or float()
    // of the text. Anything else at a value's place is "Expecting value".
    fn match_number(ref self, start: i64) -> Result[(J, i64), Exc] {
        let end_idx = self.s.len() - 1;
        let mut idx = start;
        if self.at(idx) == 45 {
            idx += 1;
            if idx > end_idx {
                return Err(self.fail("Expecting value", start));
            }
        }
        let c = self.at(idx);
        if c >= 49 and c <= 57 {
            idx += 1;
            while idx <= end_idx and j_digit(self.s[idx]) {
                idx += 1;
            }
        } else if c == 48 {
            idx += 1;
        } else {
            return Err(self.fail("Expecting value", start));
        }
        let mut is_float = false;
        if idx < end_idx and self.s[idx] == 46 and j_digit(self.s[idx + 1]) {
            is_float = true;
            idx += 2;
            while idx <= end_idx and j_digit(self.s[idx]) {
                idx += 1;
            }
        }
        if idx < end_idx and (self.s[idx] == 101 or self.s[idx] == 69) {
            let e_start = idx;
            idx += 1;
            if idx < end_idx and (self.s[idx] == 45 or self.s[idx] == 43) {
                idx += 1;
            }
            while idx <= end_idx and j_digit(self.s[idx]) {
                idx += 1;
            }
            if j_digit(self.s[idx - 1]) {
                is_float = true;
            } else {
                idx = e_start;
            }
        }
        let text = ascii_string(self.s, start, idx);
        if is_float {
            return match f64.parse(text) {
                Ok(x) => Ok((J.Float(x), idx)),
                Err(_) => Err(exc("ValueError", f"could not convert string to float: '{text}'")),
            };
        }
        let digits = if self.s[start] == 45 { idx - start - 1 } else { idx - start };
        if digits > 4300 {
            return Err(exc("ValueError", f"Exceeds the limit (4300 digits) for integer string conversion: value has {digits} digits; use sys.set_int_max_str_digits() to increase the limit"));
        }
        if text == "-0" {
            return Ok((J.Int("0".to_string()), idx));
        }
        Ok((J.Int(text), idx))
    }

    fn hex_escape(ref self, at: i64) -> Option[i64] {
        let mut v = 0;
        let mut k = 0;
        while k < 4 {
            let d = hex_value(self.at(at + k));
            if d < 0 {
                return None;
            }
            v = v * 16 + d;
            k += 1;
        }
        Some(v)
    }

    // scanstring: `start` is just past the opening quote.
    fn scan_string(ref self, start: i64) -> Result[(Vec[i64], i64), Exc] {
        let len = self.s.len();
        let begin = start - 1;
        let mut out: Vec[i64] = Vec.new();
        let mut end = start;
        loop {
            let mut next = end;
            let mut c = 0;
            while next < len {
                c = self.s[next];
                if c == 34 or c == 92 {
                    break;
                }
                if c <= 0x1F {
                    return Err(self.fail("Invalid control character at", next));
                }
                out.push(c);
                next += 1;
            }
            if next == len {
                return Err(self.fail("Unterminated string starting at", begin));
            }
            next += 1;
            if c == 34 {
                return Ok((out, next));
            }
            if next == len {
                return Err(self.fail("Unterminated string starting at", begin));
            }
            let e = self.s[next];
            if e != 117 {
                end = next + 1;
                let ch = match e {
                    34 => 34,
                    92 => 92,
                    47 => 47,
                    98 => 8,
                    102 => 12,
                    110 => 10,
                    114 => 13,
                    116 => 9,
                    _ => 0,
                };
                if ch == 0 {
                    return Err(self.fail("Invalid \\escape", end - 2));
                }
                out.push(ch);
            } else {
                next += 1;
                end = next + 4;
                if end >= len {
                    return Err(self.fail("Invalid \\uXXXX escape", next - 1));
                }
                let mut cp = match self.hex_escape(next) {
                    Some(v) => v,
                    None => return Err(self.fail("Invalid \\uXXXX escape", end - 5)),
                };
                // A high surrogate followed by an escaped low one is a pair;
                // followed by anything else it stays on its own.
                if cp >= 0xD800 and cp <= 0xDBFF and end + 6 < len and self.s[end] == 92 and self.s[end + 1] == 117 {
                    let low = match self.hex_escape(end + 2) {
                        Some(v) => v,
                        None => return Err(self.fail("Invalid \\uXXXX escape", end + 1)),
                    };
                    if low >= 0xDC00 and low <= 0xDFFF {
                        cp = 0x10000 + (((cp - 0xD800) << 10) | (low - 0xDC00));
                        end += 6;
                    }
                }
                out.push(cp);
            }
        }
    }

    fn parse_object(ref self, start: i64) -> Result[(J, i64), Exc] {
        let mut members: Vec[Member] = Vec.new();
        let mut idx = self.skip_ws(start);
        if self.at(idx) != 125 {
            loop {
                if self.at(idx) != 34 {
                    return Err(self.fail("Expecting property name enclosed in double quotes", idx));
                }
                let (key, after_key) = self.scan_string(idx + 1)?;
                idx = self.skip_ws(after_key);
                if self.at(idx) != 58 {
                    return Err(self.fail("Expecting ':' delimiter", idx));
                }
                idx = self.skip_ws(idx + 1);
                let (val, after_val) = self.scan_once(idx)?;
                put_member(mut members, key, val);
                idx = self.skip_ws(after_val);
                if self.at(idx) == 125 {
                    break;
                }
                if self.at(idx) != 44 {
                    return Err(self.fail("Expecting ',' delimiter", idx));
                }
                let comma = idx;
                idx = self.skip_ws(idx + 1);
                if self.at(idx) == 125 {
                    return Err(self.fail("Illegal trailing comma before end of object", comma));
                }
            }
        }
        Ok((J.Obj(members), idx + 1))
    }

    fn parse_array(ref self, start: i64) -> Result[(J, i64), Exc] {
        let mut items: Vec[J] = Vec.new();
        let mut idx = self.skip_ws(start);
        if self.at(idx) != 93 {
            loop {
                let (val, after) = self.scan_once(idx)?;
                items.push(val);
                idx = self.skip_ws(after);
                if self.at(idx) == 93 {
                    break;
                }
                if self.at(idx) != 44 {
                    return Err(self.fail("Expecting ',' delimiter", idx));
                }
                let comma = idx;
                idx = self.skip_ws(idx + 1);
                if self.at(idx) == 93 {
                    return Err(self.fail("Illegal trailing comma before end of array", comma));
                }
            }
        }
        Ok((J.Arr(items), idx + 1))
    }
}

// dict(pairs): a key seen again keeps its place and takes the new value.
fn put_member(members: mut ref Vec[Member], key: own Vec[i64], val: own J) {
    let mut j = 0;
    while j < members.len() {
        if cmp_cps(members[j].key, key) == 0 {
            members[j].val = val;
            return;
        }
        j += 1;
    }
    members.push(Member { key: key, val: val });
}

// json.loads on a str.
fn loads(text: ref Vec[i64]) -> Result[J, Exc] {
    let sc = Scanner { s: text.clone() };
    if sc.at(0) == 0xFEFF {
        return Err(sc.fail("Unexpected UTF-8 BOM (decode using utf-8-sig)", 0));
    }
    let start = sc.skip_ws(0);
    let (value, end) = sc.scan_once(start)?;
    let stop = sc.skip_ws(end);
    if stop != sc.s.len() {
        return Err(sc.fail("Extra data", stop));
    }
    Ok(value)
}

// ---------------------------------------------------------- encoding


// ---- Python values: what the jobs pass in and what pg8000 hands back ----

// A datetime's tzinfo: none, datetime.timezone.utc, a fixed
// datetime.timezone, dateutil's tzoffset(None, n) or dateutil's tzutc().
#[derive(Clone)]
enum Tz {
    Naive,
    Utc,
    Fixed(i64),
    Off(i64),
    DUtc,
}

// date, time, datetime and timedelta share one record; a timedelta uses
// d for its days, s for its seconds and us for its microseconds.
#[derive(Clone)]
struct Dt {
    y: i64,
    mo: i64,
    d: i64,
    h: i64,
    mi: i64,
    s: i64,
    us: i64,
    tz: Tz,
}

// An IPv4/IPv6 address, or a network when net is set.
#[derive(Clone)]
struct Ipa {
    v6: bool,
    ip: u128,
    plen: i64,
    net: bool,
}

#[derive(Clone)]
enum V {
    None,
    Bool(bool),
    Int(i128),
    Float(f64),
    Str(String),
    Bytes(Vec[u8]),
    BArr(Vec[u8]),
    List(Vec[V]),
    Tuple(Vec[V]),
    // keys and values alternate
    Dict(Vec[V]),
    // the Decimal's str()
    Dec(String),
    Date(Dt),
    Time(Dt),
    Dtm(Dt),
    Td(Dt),
    // 32 lowercase hex digits
    Uuid(String),
    Ip(Ipa),
    // lower, upper, bounds (Str), is_empty (Bool)
    Range(Vec[V]),
    // millennia .. microseconds, None where unset
    Interval(Vec[V]),
    // a collections.deque with maxlen=100
    Deque(Vec[V]),
    Bio(Vec[u8]),
    Sio(String),
}

const INTERVAL_FIELDS: Array[Str, 11] = [
    "millennia", "centuries", "decades", "years", "months", "weeks", "days", "hours", "minutes",
    "seconds", "microseconds",
];

fn field_index(name: Str) -> i64 {
    let mut i: i64 = 0;
    while i < 11 {
        if INTERVAL_FIELDS[i] == name {
            return i;
        }
        i += 1;
    }
    -1
}

fn empty_interval() -> Vec[V] {
    let mut f: Vec[V] = Vec.new();
    let mut i = 0;
    while i < 11 {
        f.push(V.None);
        i += 1;
    }
    f
}

fn mk_dt(y: i64, mo: i64, d: i64, h: i64, mi: i64, s: i64, us: i64, tz: own Tz) -> Dt {
    Dt { y: y, mo: mo, d: d, h: h, mi: mi, s: s, us: us, tz: tz }
}

fn sv(s: Str) -> V {
    V.Str(s.to_string())
}

fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b;
    if (a % b != 0) and ((a < 0) != (b < 0)) { q - 1 } else { q }
}

fn floor_mod(a: i64, b: i64) -> i64 {
    a - floor_div(a, b) * b
}

fn pad(n: i64, w: i64) -> String {
    let mut s = f"{n}";
    while (s.len() as i64) < w {
        s = f"0{s}";
    }
    s
}

fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    f"{x}"
}

fn join(parts: ref Vec[String], sep: Str) -> String {
    let mut out = String.new();
    let mut i = 0;
    while i < parts.len() {
        if i > 0 {
            out.push_str(sep);
        }
        out.push_str(parts[i]);
        i += 1;
    }
    out
}

fn replace_all(s: Str, from: Str, to: Str) -> String {
    s.replace(from, to)
}

// ---- calendar ----

fn is_leap(y: i64) -> bool {
    (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
}

fn days_in_month(y: i64, m: i64) -> i64 {
    if m == 2 {
        return if is_leap(y) { 29 } else { 28 };
    }
    if m == 4 or m == 6 or m == 9 or m == 11 { 30 } else { 31 }
}

// Days since 1970-01-01 of a proleptic Gregorian date.
fn days_from_civil(y0: i64, m: i64, d: i64) -> i64 {
    let y = if m <= 2 { y0 - 1 } else { y0 };
    let era = floor_div(y, 400);
    let yoe = y - era * 400;
    let mp = if m > 2 { m - 3 } else { m + 9 };
    let doy = (153 * mp + 2) / 5 + d - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

fn civil_from_days(z0: i64) -> (i64, i64, i64) {
    let z = z0 + 719468;
    let era = floor_div(z, 146097);
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let y = yoe + era * 400;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = if mp < 10 { mp + 3 } else { mp - 9 };
    (if m <= 2 { y + 1 } else { y }, m, d)
}

fn check_date(y: i64, m: i64, d: i64) -> Result[(), Exc] {
    if y < 1 or y > 9999 {
        return Err(value_error(f"year {y} is out of range"));
    }
    if m < 1 or m > 12 {
        return Err(value_error("month must be in 1..12"));
    }
    if d < 1 or d > days_in_month(y, m) {
        return Err(value_error("day is out of range for month"));
    }
    Ok(())
}

fn check_time(h: i64, mi: i64, s: i64, us: i64) -> Result[(), Exc] {
    if h < 0 or h > 23 {
        return Err(value_error("hour must be in 0..23"));
    }
    if mi < 0 or mi > 59 {
        return Err(value_error("minute must be in 0..59"));
    }
    if s < 0 or s > 59 {
        return Err(value_error("second must be in 0..59"));
    }
    if us < 0 or us > 999999 {
        return Err(value_error("microsecond must be in 0..999999"));
    }
    Ok(())
}

fn tz_offset(tz: ref Tz) -> Option[i64] {
    match tz {
        Tz.Naive => None,
        Tz.Utc => Some(0),
        Tz.DUtc => Some(0),
        Tz.Fixed(n) => Some(n),
        Tz.Off(n) => Some(n),
    }
}

// datetime.astimezone(timezone.utc) of an aware datetime.
fn to_utc(t: ref Dt) -> Dt {
    let off = tz_offset(t.tz).unwrap_or(0);
    let secs = days_from_civil(t.y, t.mo, t.d) * 86400 + t.h * 3600 + t.mi * 60 + t.s - off;
    let days = floor_div(secs, 86400);
    let rem = floor_mod(secs, 86400);
    let (y, m, d) = civil_from_days(days);
    mk_dt(y, m, d, rem / 3600, (rem % 3600) / 60, rem % 60, t.us, Tz.Utc)
}

// timedelta's normal form from a total of microseconds.
fn td_from_us(total: i128) -> Dt {
    let day: i128 = 86400000000;
    let mut days = total / day;
    let mut rem = total - days * day;
    if rem < 0 {
        days -= 1;
        rem += day;
    }
    let secs = rem / 1000000;
    let us = rem - secs * 1000000;
    mk_dt(0, 0, days as i64, 0, 0, secs as i64, us as i64, Tz.Naive)
}

fn iso_date(t: ref Dt) -> String {
    f"{pad(t.y, 4)}-{pad(t.mo, 2)}-{pad(t.d, 2)}"
}

fn iso_time(t: ref Dt) -> String {
    let base = f"{pad(t.h, 2)}:{pad(t.mi, 2)}:{pad(t.s, 2)}";
    if t.us != 0 { f"{base}.{pad(t.us, 6)}" } else { base }
}

fn off_str(n: i64) -> String {
    let sign = if n < 0 { "-" } else { "+" };
    let a = if n < 0 { -n } else { n };
    let base = f"{sign}{pad(a / 3600, 2)}:{pad((a % 3600) / 60, 2)}";
    if a % 60 != 0 { f"{base}:{pad(a % 60, 2)}" } else { base }
}

fn dt_iso(t: ref Dt, sep: Str) -> String {
    let base = f"{iso_date(t)}{sep}{iso_time(t)}";
    match tz_offset(t.tz) {
        Some(n) => f"{base}{off_str(n)}",
        None => base,
    }
}

fn td_repr(t: ref Dt) -> String {
    let mut parts: Vec[String] = Vec.new();
    if t.d != 0 {
        parts.push(f"days={t.d}");
    }
    if t.s != 0 {
        parts.push(f"seconds={t.s}");
    }
    if t.us != 0 {
        parts.push(f"microseconds={t.us}");
    }
    if parts.len() == 0 {
        return "datetime.timedelta(0)".to_string();
    }
    f"datetime.timedelta({join(parts, ", ")})"
}

fn td_str(t: ref Dt) -> String {
    let hh = t.s / 3600;
    let mm = (t.s % 3600) / 60;
    let ss = t.s % 60;
    let mut out = f"{hh}:{pad(mm, 2)}:{pad(ss, 2)}";
    if t.d != 0 {
        let plural = if t.d == 1 or t.d == -1 { "" } else { "s" };
        out = f"{t.d} day{plural}, {out}";
    }
    if t.us != 0 {
        out = f"{out}.{pad(t.us, 6)}";
    }
    out
}

fn tz_repr(tz: ref Tz) -> String {
    match tz {
        Tz.Naive => "None".to_string(),
        Tz.Utc => "datetime.timezone.utc".to_string(),
        Tz.DUtc => "tzutc()".to_string(),
        Tz.Fixed(n) => f"datetime.timezone({td_repr(td_from_us((n as i128) * 1000000))})",
        Tz.Off(n) => f"tzoffset(None, {n})",
    }
}

fn trimmed_fields(fields: ref Vec[i64]) -> String {
    let mut n = fields.len();
    if fields[n - 1] == 0 {
        n -= 1;
        if fields[n - 1] == 0 {
            n -= 1;
        }
    }
    let mut parts: Vec[String] = Vec.new();
    let mut i = 0;
    while i < n {
        parts.push(f"{fields[i]}");
        i += 1;
    }
    join(parts, ", ")
}

fn dtm_repr(t: ref Dt) -> String {
    let fields: Vec[i64] = vec![t.y, t.mo, t.d, t.h, t.mi, t.s, t.us];
    let body = trimmed_fields(fields);
    match t.tz {
        Tz.Naive => f"datetime.datetime({body})",
        _ => f"datetime.datetime({body}, tzinfo={tz_repr(t.tz)})",
    }
}

fn time_repr(t: ref Dt) -> String {
    let fields: Vec[i64] = vec![t.h, t.mi, t.s, t.us];
    f"datetime.time({trimmed_fields(fields)})"
}

// ---- uuid and ipaddress ----

fn uuid_str(h: Str) -> String {
    let cs: Vec[char] = h.chars().collect();
    let mut out = String.new();
    let mut i = 0;
    while i < 32 {
        if i == 8 or i == 12 or i == 16 or i == 20 {
            out.push('-');
        }
        out.push(cs[i]);
        i += 1;
    }
    out
}

fn hex_str(x: u128) -> String {
    if x == 0 {
        return "0".to_string();
    }
    let digits: Vec[char] = "0123456789abcdef".chars().collect();
    let mut rev: Vec[char] = Vec.new();
    let mut v = x;
    while v > 0 {
        rev.push(digits[(v & 15) as i64]);
        v = v >> 4;
    }
    let mut out = String.new();
    let mut i = rev.len() as i64 - 1;
    while i >= 0 {
        out.push(rev[i]);
        i -= 1;
    }
    out
}

fn v4_str(ip: u128) -> String {
    f"{(ip >> 24) & 255}.{(ip >> 16) & 255}.{(ip >> 8) & 255}.{ip & 255}"
}

// _compress_hextets: the longest run of two or more zero hextets becomes "".
fn compress(ip: u128) -> String {
    let mut h: Vec[String] = Vec.new();
    let mut k: i64 = 112;
    while k >= 0 {
        h.push(hex_str((ip >> k) & 0xFFFF));
        k -= 16;
    }
    let mut best_start: i64 = -1;
    let mut best_len: i64 = 0;
    let mut start: i64 = -1;
    let mut len: i64 = 0;
    let mut i: i64 = 0;
    while i < 8 {
        if h[i] == "0" {
            len += 1;
            if start == -1 {
                start = i;
            }
            if len > best_len {
                best_len = len;
                best_start = start;
            }
        } else {
            len = 0;
            start = -1;
        }
        i += 1;
    }
    if best_len > 1 {
        let end = best_start + best_len;
        let mut out: Vec[String] = Vec.new();
        if best_start == 0 {
            out.push(String.new());
        }
        let mut j: i64 = 0;
        while j < best_start {
            out.push(h[j].clone());
            j += 1;
        }
        out.push(String.new());
        j = end;
        while j < 8 {
            out.push(h[j].clone());
            j += 1;
        }
        if end == 8 {
            out.push(String.new());
        }
        return join(out, ":");
    }
    join(h, ":")
}

fn ip_addr_str(v6: bool, ip: u128) -> String {
    if not v6 {
        return v4_str(ip);
    }
    if (ip >> 32) == 0xFFFF {
        return f"{compress(ip >> 32)}:{v4_str(ip & 0xFFFFFFFF)}";
    }
    compress(ip)
}

fn ip_str(a: ref Ipa) -> String {
    let base = ip_addr_str(a.v6, a.ip);
    if a.net { f"{base}/{a.plen}" } else { base }
}

fn ip_class(a: ref Ipa) -> String {
    let v = if a.v6 { 6 } else { 4 };
    let kind = if a.net { "Network" } else { "Address" };
    f"IPv{v}{kind}"
}

// ---- repr() and str() ----

fn repr_items(xs: ref Vec[V]) -> String {
    let mut parts: Vec[String] = Vec.new();
    for x in xs {
        parts.push(repr(x));
    }
    join(parts, ", ")
}

fn repr(v: ref V) -> String {
    match v {
        V.None => "None".to_string(),
        V.Bool(b) => if b { "True".to_string() } else { "False".to_string() },
        V.Int(n) => f"{n}",
        V.Float(x) => float_repr(x),
        V.Str(s) => py_str_repr(s),
        V.Bytes(b) => py_bytes_repr(b),
        V.BArr(b) => f"bytearray({py_bytes_repr(b)})",
        V.List(xs) => f"[{repr_items(xs)}]",
        V.Tuple(xs) => if xs.len() == 1 { f"({repr(xs[0])},)" } else { f"({repr_items(xs)})" },
        V.Dict(kv) => {
            let mut parts: Vec[String] = Vec.new();
            let mut i = 0;
            while i + 1 < kv.len() {
                parts.push(f"{repr(kv[i])}: {repr(kv[i + 1])}");
                i += 2;
            }
            f"{{{join(parts, ", ")}}}"
        }
        V.Dec(s) => f"Decimal('{s}')",
        V.Date(t) => f"datetime.date({t.y}, {t.mo}, {t.d})",
        V.Time(t) => time_repr(t),
        V.Dtm(t) => dtm_repr(t),
        V.Td(t) => td_repr(t),
        V.Uuid(h) => f"UUID('{uuid_str(h)}')",
        V.Ip(a) => f"{ip_class(a)}('{ip_str(a)}')",
        V.Range(r) => f"<Range {range_str(r)}>",
        V.Interval(f) => f"<PGInterval {interval_str(f)}>",
        V.Deque(xs) => f"deque([{repr_items(xs)}], maxlen=100)",
        V.Bio(_) => "<_io.BytesIO object>".to_string(),
        V.Sio(_) => "<_io.StringIO object>".to_string(),
    }
}

fn pstr(v: ref V) -> String {
    match v {
        V.Str(s) => s.clone(),
        V.Dec(s) => s.clone(),
        V.Date(t) => iso_date(t),
        V.Time(t) => iso_time(t),
        V.Dtm(t) => dt_iso(t, " "),
        V.Td(t) => td_str(t),
        V.Uuid(h) => uuid_str(h),
        V.Ip(a) => ip_str(a),
        V.Range(r) => range_str(r),
        V.Interval(f) => interval_str(f),
        _ => repr(v),
    }
}

fn is_none(v: ref V) -> bool {
    match v {
        V.None => true,
        _ => false,
    }
}

fn range_bounds(r: ref Vec[V]) -> Vec[char] {
    match r[2] {
        V.Str(s) => s.chars().collect(),
        _ => "[)".chars().collect(),
    }
}

fn range_empty(r: ref Vec[V]) -> bool {
    match r[3] {
        V.Bool(b) => b,
        _ => false,
    }
}

fn range_str(r: ref Vec[V]) -> String {
    if range_empty(r) {
        return "empty".to_string();
    }
    let b = range_bounds(r);
    let lo = if is_none(r[0]) { String.new() } else { pstr(r[0]) };
    let hi = if is_none(r[1]) { String.new() } else { pstr(r[1]) };
    f"{b[0]}{lo},{hi}{b[b.len() - 1]}"
}

fn interval_str(f: ref Vec[V]) -> String {
    let mut parts: Vec[String] = Vec.new();
    let mut i: i64 = 0;
    while i < 11 {
        if not is_none(f[i]) {
            parts.push(f"{pstr(f[i])} {INTERVAL_FIELDS[i]}");
        }
        i += 1;
    }
    join(parts, " ")
}

fn type_name(v: ref V) -> String {
    let n = match v {
        V.None => "NoneType",
        V.Bool(_) => "bool",
        V.Int(_) => "int",
        V.Float(_) => "float",
        V.Str(_) => "str",
        V.Bytes(_) => "bytes",
        V.BArr(_) => "bytearray",
        V.List(_) => "list",
        V.Tuple(_) => "tuple",
        V.Dict(_) => "dict",
        V.Dec(_) => "Decimal",
        V.Date(_) => "date",
        V.Time(_) => "time",
        V.Dtm(_) => "datetime",
        V.Td(_) => "timedelta",
        V.Uuid(_) => "UUID",
        V.Ip(a) => if a.v6 { if a.net { "IPv6Network" } else { "IPv6Address" } } else { if a.net { "IPv4Network" } else { "IPv4Address" } },
        V.Range(_) => "Range",
        V.Interval(_) => "PGInterval",
        V.Deque(_) => "deque",
        V.Bio(_) => "BytesIO",
        V.Sio(_) => "StringIO",
    };
    n.to_string()
}

// repr(type(v))
fn class_repr(v: ref V) -> String {
    let n = type_name(v);
    let module = match v {
        V.Dec(_) => "decimal.",
        V.Date(_) => "datetime.",
        V.Time(_) => "datetime.",
        V.Dtm(_) => "datetime.",
        V.Td(_) => "datetime.",
        V.Uuid(_) => "uuid.",
        V.Ip(_) => "ipaddress.",
        V.Range(_) => "pg8000.types.",
        V.Interval(_) => "pg8000.types.",
        V.Deque(_) => "collections.",
        V.Bio(_) => "_io.",
        V.Sio(_) => "_io.",
        _ => "",
    };
    f"<class '{module}{n}'>"
}

// ---- Decimal, UUID and ipaddress parsing ----

fn invalid_operation() -> Exc {
    exc("InvalidOperation", "[<class 'decimal.ConversionSyntax'>]")
}

fn strip_zeros(digits: ref Vec[char]) -> String {
    let mut i: i64 = 0;
    while i < digits.len() as i64 - 1 and digits[i] == '0' {
        i += 1;
    }
    char_slice(digits, i, digits.len() as i64)
}

// Decimal(str), kept as its str(): Decimal.__str__ in scientific form.
fn dec_parse(s0: Str) -> Result[String, Exc] {
    let t = py_strip(s0).replace("_", "");
    let cs: Vec[char] = t.chars().collect();
    let n = cs.len() as i64;
    let mut i: i64 = 0;
    let mut sign = String.new();
    if i < n and (cs[i] == '+' or cs[i] == '-') {
        if cs[i] == '-' {
            sign.push('-');
        }
        i += 1;
    }
    let word = char_slice(cs, i, n).to_lowercase();
    if word == "inf" or word == "infinity" {
        return Ok(f"{sign}Infinity");
    }
    let wc: Vec[char] = word.chars().collect();
    let mut special = String.new();
    let mut skip: i64 = 0;
    if word.starts_with("snan") {
        special = "sNaN".to_string();
        skip = 4;
    } else if word.starts_with("nan") {
        special = "NaN".to_string();
        skip = 3;
    }
    if special.len() > 0 {
        let payload = char_slice(wc, skip, wc.len() as i64);
        let pc: Vec[char] = payload.chars().collect();
        for c in pc {
            if not is_digit(c) {
                return Err(invalid_operation());
            }
        }
        let p = if pc.len() > 0 { strip_zeros(pc) } else { String.new() };
        let p2 = if p == "0" { String.new() } else { p };
        return Ok(f"{sign}{special}{p2}");
    }
    let mut digits: Vec[char] = Vec.new();
    let mut frac: i64 = 0;
    let mut seen_dot = false;
    let mut any = false;
    while i < n and (is_digit(cs[i]) or (cs[i] == '.' and not seen_dot)) {
        if cs[i] == '.' {
            seen_dot = true;
        } else {
            digits.push(cs[i]);
            any = true;
            if seen_dot {
                frac += 1;
            }
        }
        i += 1;
    }
    if not any {
        return Err(invalid_operation());
    }
    let mut exp: i64 = 0;
    if i < n and (cs[i] == 'e' or cs[i] == 'E') {
        i += 1;
        let mut eneg = false;
        if i < n and (cs[i] == '+' or cs[i] == '-') {
            eneg = cs[i] == '-';
            i += 1;
        }
        let start = i;
        while i < n and is_digit(cs[i]) {
            exp = exp * 10 + (cs[i] as i64 - 48);
            i += 1;
        }
        if i == start {
            return Err(invalid_operation());
        }
        if eneg {
            exp = -exp;
        }
    }
    if i != n {
        return Err(invalid_operation());
    }
    exp -= frac;
    let coeff: Vec[char] = strip_zeros(digits).chars().collect();
    let len = coeff.len() as i64;
    let leftdigits = exp + len;
    let dotplace = if exp <= 0 and leftdigits > -6 { leftdigits } else { 1 };
    let mut intpart = String.new();
    let mut fracpart = String.new();
    if dotplace <= 0 {
        intpart.push('0');
        fracpart.push('.');
        let mut k: i64 = 0;
        while k < -dotplace {
            fracpart.push('0');
            k += 1;
        }
        fracpart.push_str(char_slice(coeff, 0, len));
    } else if dotplace >= len {
        intpart.push_str(char_slice(coeff, 0, len));
        let mut k = len;
        while k < dotplace {
            intpart.push('0');
            k += 1;
        }
    } else {
        intpart.push_str(char_slice(coeff, 0, dotplace));
        fracpart.push('.');
        fracpart.push_str(char_slice(coeff, dotplace, len));
    }
    let mut out = f"{sign}{intpart}{fracpart}";
    if leftdigits != dotplace {
        let e = leftdigits - dotplace;
        let es = if e >= 0 { f"+{e}" } else { f"{e}" };
        out = f"{out}E{es}";
    }
    Ok(out)
}

// uuid.UUID(hex)
fn uuid_parse(s: Str) -> Result[String, Exc] {
    let mut h = s.replace("urn:", "").replace("uuid:", "");
    let cs: Vec[char] = h.chars().collect();
    let mut a: i64 = 0;
    let mut b = cs.len() as i64;
    while a < b and (cs[a] == '{' or cs[a] == '}') {
        a += 1;
    }
    while b > a and (cs[b - 1] == '{' or cs[b - 1] == '}') {
        b -= 1;
    }
    h = char_slice(cs, a, b).replace("-", "");
    if h.chars().count() != 32 {
        return Err(value_error("badly formed hexadecimal UUID string"));
    }
    let (_, digits) = py_int_digits(h, 16)?;
    let mut out = String.new();
    let mut k = digits.len() as i64;
    while k < 32 {
        out.push('0');
        k += 1;
    }
    let hexd: Vec[char] = "0123456789abcdef".chars().collect();
    for d in digits {
        out.push(hexd[d]);
    }
    Ok(out)
}

fn all_digits(s: Str) -> bool {
    let mut any = false;
    for c in s.chars() {
        if not is_digit(c) {
            return false;
        }
        any = true;
    }
    any
}

fn split_char(s: Str, sep: char) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if c == sep {
            out.push(cur);
            cur = String.new();
        } else {
            cur.push(c);
        }
    }
    out.push(cur);
    out
}

fn small_int(s: Str) -> i64 {
    let mut v: i64 = 0;
    for c in s.chars() {
        let d = hex_val(c);
        if v < 100000000 {
            v = v * 10 + d;
        }
    }
    v
}

fn v4_int(s: Str) -> Option[u128] {
    let parts = split_char(s, '.');
    if parts.len() != 4 {
        return None;
    }
    let mut ip: u128 = 0;
    for p in parts {
        if not all_digits(p) or p.len() > 3 {
            return None;
        }
        if p.len() > 1 and p.starts_with("0") {
            return None;
        }
        let v = small_int(p);
        if v > 255 {
            return None;
        }
        ip = (ip << 8) | (v as u128);
    }
    Some(ip)
}

fn hextet(s: Str) -> Option[u128] {
    if s.len() == 0 or s.len() > 4 {
        return None;
    }
    let mut v: u128 = 0;
    for c in s.chars() {
        let d = hex_val(c);
        if d < 0 or (c as u32) > 127 {
            return None;
        }
        v = v * 16 + (d as u128);
    }
    Some(v)
}

// IPv6Address._ip_int_from_string
fn v6_int(s: Str) -> Option[u128] {
    let mut parts = split_char(s, ':');
    if parts.len() < 3 {
        return None;
    }
    let last = parts[parts.len() - 1].clone();
    if last.contains(".") {
        let v4 = v4_int(last)?;
        parts.pop();
        parts.push(hex_str((v4 >> 16) & 0xFFFF));
        parts.push(hex_str(v4 & 0xFFFF));
    }
    let np = parts.len() as i64;
    if np > 9 {
        return None;
    }
    let mut skip: i64 = -1;
    let mut i: i64 = 1;
    while i < np - 1 {
        if parts[i].len() == 0 {
            if skip >= 0 {
                return None;
            }
            skip = i;
        }
        i += 1;
    }
    let mut hi: i64 = np;
    let mut lo: i64 = 0;
    let mut skipped: i64 = 0;
    if skip >= 0 {
        hi = skip;
        lo = np - skip - 1;
        if parts[0].len() == 0 {
            hi -= 1;
            if hi != 0 {
                return None;
            }
        }
        if parts[np - 1].len() == 0 {
            lo -= 1;
            if lo != 0 {
                return None;
            }
        }
        skipped = 8 - (hi + lo);
        if skipped < 1 {
            return None;
        }
    } else {
        if np != 8 or parts[0].len() == 0 or parts[np - 1].len() == 0 {
            return None;
        }
    }
    let mut ip: u128 = 0;
    let mut k: i64 = 0;
    while k < hi {
        ip = (ip << 16) | hextet(parts[k])?;
        k += 1;
    }
    ip = ip << (16 * skipped);
    k = np - lo;
    while k < np {
        ip = (ip << 16) | hextet(parts[k])?;
        k += 1;
    }
    Some(ip)
}

fn ip_parse(s: Str, v6: bool) -> Option[Ipa] {
    let ip = if v6 { v6_int(s)? } else { v4_int(s)? };
    Some(Ipa { v6: v6, ip: ip, plen: if v6 { 128 } else { 32 }, net: false })
}

// IPv4Network(s, strict) / IPv6Network(s, strict)
fn net_parse(s: Str, v6: bool, strict: bool) -> Option[Ipa] {
    let parts = split_char(s, '/');
    if parts.len() > 2 {
        return None;
    }
    let mut a = ip_parse(parts[0], v6)?;
    let maxp: i64 = if v6 { 128 } else { 32 };
    let mut plen = maxp;
    if parts.len() == 2 {
        if not all_digits(parts[1]) {
            return None;
        }
        plen = small_int(parts[1]);
        if plen > maxp {
            return None;
        }
    }
    let host_bits = maxp - plen;
    let mask: u128 = if host_bits == 128 { 0 } else { ((if v6 { 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFu128 } else { 0xFFFFFFFF }) >> host_bits) << host_bits };
    let base = a.ip & mask;
    if strict and base != a.ip {
        return None;
    }
    a.ip = base;
    a.plen = plen;
    a.net = true;
    Some(a)
}

fn ip_address(s: Str) -> Result[V, Exc] {
    match ip_parse(s, false) {
        Some(a) => return Ok(V.Ip(a)),
        None => {}
    }
    match ip_parse(s, true) {
        Some(a) => Ok(V.Ip(a)),
        None => Err(value_error(f"{py_str_repr(s)} does not appear to be an IPv4 or IPv6 address")),
    }
}

fn ip_network(s: Str) -> Result[V, Exc] {
    match net_parse(s, false, false) {
        Some(a) => return Ok(V.Ip(a)),
        None => {}
    }
    match net_parse(s, true, false) {
        Some(a) => Ok(V.Ip(a)),
        None => Err(value_error(f"{py_str_repr(s)} does not appear to be an IPv4 or IPv6 network")),
    }
}

// ---- the jobs' value literals: Python literals and a few constructors ----

struct Px {
    cs: Vec[char],
    i: i64,
}

fn px_at(p: ref Px, k: i64) -> char {
    let j = p.i + k;
    if j < p.cs.len() as i64 { p.cs[j] } else { '\u{0}' }
}

fn px_ws(p: mut ref Px) {
    while p.i < p.cs.len() as i64 and p.cs[p.i] == ' ' {
        p.i += 1;
    }
}

fn syntax(p: ref Px) -> Exc {
    exc("SyntaxError", f"bad value literal at {p.i}")
}

fn is_ident_start(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_'
}

fn is_ident(c: char) -> bool {
    is_ident_start(c) or is_digit(c)
}

fn px_hex(p: mut ref Px, n: i64) -> Result[i64, Exc] {
    let mut v: i64 = 0;
    let mut k: i64 = 0;
    while k < n {
        let d = hex_val(px_at(p, 0));
        if d < 0 {
            return Err(syntax(p));
        }
        v = v * 16 + d;
        p.i += 1;
        k += 1;
    }
    Ok(v)
}

fn px_string(p: mut ref Px, is_bytes: bool) -> Result[V, Exc] {
    let quote = px_at(p, 0);
    p.i += 1;
    let mut text = String.new();
    let mut raw: Vec[u8] = Vec.new();
    loop {
        if p.i >= p.cs.len() as i64 {
            return Err(syntax(p));
        }
        let c = p.cs[p.i];
        if c == quote {
            p.i += 1;
            break;
        }
        let mut code: i64 = c as i64;
        if c == '\\' {
            let e = px_at(p, 1);
            p.i += 2;
            code = match e {
                'n' => 10,
                't' => 9,
                'r' => 13,
                'a' => 7,
                'b' => 8,
                'f' => 12,
                'v' => 11,
                '0' => 0,
                'x' => px_hex(mut p, 2)?,
                'u' => px_hex(mut p, 4)?,
                _ => e as i64,
            };
            if e != '\\' and e != '\'' and e != '"' and code == e as i64 {
                // an unknown escape keeps its backslash
                if is_bytes {
                    raw.push(92);
                } else {
                    text.push('\\');
                }
            }
        } else {
            p.i += 1;
        }
        if is_bytes {
            raw.push(code as u8);
        } else {
            text.push(char.try_from(code as u32).unwrap_or('?'));
        }
    }
    if is_bytes { Ok(V.Bytes(raw)) } else { Ok(V.Str(text)) }
}

fn px_number(p: mut ref Px) -> Result[V, Exc] {
    let start = p.i;
    let mut is_float = false;
    while is_digit(px_at(p, 0)) or px_at(p, 0) == '.' {
        if px_at(p, 0) == '.' {
            is_float = true;
        }
        p.i += 1;
    }
    let c = px_at(p, 0);
    if c == 'e' or c == 'E' {
        is_float = true;
        p.i += 1;
        if px_at(p, 0) == '+' or px_at(p, 0) == '-' {
            p.i += 1;
        }
        while is_digit(px_at(p, 0)) {
            p.i += 1;
        }
    }
    let text = char_slice(p.cs, start, p.i);
    if is_float {
        return match f64.parse(text) {
            Ok(x) => Ok(V.Float(x)),
            Err(_) => Err(syntax(p)),
        };
    }
    Ok(V.Int(py_int(text, 10)?))
}

fn px_items(p: mut ref Px, close: char) -> Result[(Vec[V], bool), Exc] {
    let mut items: Vec[V] = Vec.new();
    let mut comma = false;
    loop {
        px_ws(mut p);
        if px_at(p, 0) == close {
            p.i += 1;
            break;
        }
        items.push(px_expr(mut p)?);
        px_ws(mut p);
        if px_at(p, 0) == ',' {
            comma = true;
            p.i += 1;
        } else if px_at(p, 0) == close {
            p.i += 1;
            break;
        } else {
            return Err(syntax(p));
        }
    }
    Ok((items, comma))
}

fn px_expr(p: mut ref Px) -> Result[V, Exc] {
    px_ws(mut p);
    let c = px_at(p, 0);
    if c == '-' {
        p.i += 1;
        let v = px_expr(mut p)?;
        return match v {
            V.Int(n) => Ok(V.Int(-n)),
            V.Float(x) => Ok(V.Float(-x)),
            _ => Err(syntax(p)),
        };
    }
    if c == '\'' or c == '"' {
        return px_string(mut p, false);
    }
    if (c == 'b' or c == 'B') and (px_at(p, 1) == '\'' or px_at(p, 1) == '"') {
        p.i += 1;
        return px_string(mut p, true);
    }
    if is_digit(c) {
        return px_number(mut p);
    }
    if c == '[' {
        p.i += 1;
        let (items, _) = px_items(mut p, ']')?;
        return Ok(V.List(items));
    }
    if c == '(' {
        p.i += 1;
        let mut (items, comma) = px_items(mut p, ')')?;
        if items.len() == 1 and not comma {
            return Ok(items.remove(0));
        }
        return Ok(V.Tuple(items));
    }
    if c == '{' {
        p.i += 1;
        let mut kv: Vec[V] = Vec.new();
        loop {
            px_ws(mut p);
            if px_at(p, 0) == '}' {
                p.i += 1;
                break;
            }
            let k = px_expr(mut p)?;
            px_ws(mut p);
            if px_at(p, 0) != ':' {
                return Err(syntax(p));
            }
            p.i += 1;
            let v = px_expr(mut p)?;
            dict_put(mut kv, k, v);
            px_ws(mut p);
            if px_at(p, 0) == ',' {
                p.i += 1;
            }
        }
        return Ok(V.Dict(kv));
    }
    if is_ident_start(c) {
        let start = p.i;
        while is_ident(px_at(p, 0)) {
            p.i += 1;
        }
        let name = char_slice(p.cs, start, p.i);
        if name == "None" {
            return Ok(V.None);
        }
        if name == "True" {
            return Ok(V.Bool(true));
        }
        if name == "False" {
            return Ok(V.Bool(false));
        }
        if px_at(p, 0) != '(' {
            return Err(syntax(p));
        }
        p.i += 1;
        let mut args: Vec[V] = Vec.new();
        let mut kw: Vec[(String, V)] = Vec.new();
        loop {
            px_ws(mut p);
            if px_at(p, 0) == ')' {
                p.i += 1;
                break;
            }
            let mut j = p.i;
            while j < p.cs.len() as i64 and is_ident(p.cs[j]) {
                j += 1;
            }
            if j > p.i and j < p.cs.len() as i64 and p.cs[j] == '=' {
                let key = char_slice(p.cs, p.i, j);
                p.i = j + 1;
                kw.push((key, px_expr(mut p)?));
            } else {
                args.push(px_expr(mut p)?);
            }
            px_ws(mut p);
            if px_at(p, 0) == ',' {
                p.i += 1;
            }
        }
        return ctor(name, args, kw);
    }
    Err(syntax(p))
}

fn parse_value(src: Str) -> Result[V, Exc] {
    let mut p = Px { cs: src.chars().collect(), i: 0 };
    let v = px_expr(mut p)?;
    px_ws(mut p);
    if p.i != p.cs.len() as i64 {
        return Err(syntax(p));
    }
    Ok(v)
}

fn dict_get(kv: ref Vec[V], key: ref V) -> Option[V] {
    let k = repr(key);
    let mut i = 0;
    while i + 1 < kv.len() {
        if repr(kv[i]) == k {
            return Some(kv[i + 1].clone());
        }
        i += 2;
    }
    None
}

// d[k] = v: a key already there keeps its place.
fn dict_put(kv: mut ref Vec[V], key: own V, val: own V) {
    let k = repr(key);
    let mut i = 0;
    while i + 1 < kv.len() {
        if repr(kv[i]) == k {
            kv[i + 1] = val;
            return;
        }
        i += 2;
    }
    kv.push(key);
    kv.push(val);
}

fn arg(args: ref Vec[V], kw: ref Vec[(String, V)], idx: i64, name: Str) -> Option[V] {
    for (k, v) in kw {
        if k == name {
            return Some(v.clone());
        }
    }
    if idx >= 0 and idx < args.len() as i64 {
        return Some(args[idx].clone());
    }
    None
}

fn as_int(v: Option[V]) -> i64 {
    match v {
        Some(V.Int(n)) => n as i64,
        Some(V.Bool(b)) => if b { 1 } else { 0 },
        _ => 0,
    }
}

fn as_str(v: ref V) -> String {
    match v {
        V.Str(s) => s.clone(),
        _ => String.new(),
    }
}

fn as_bytes(v: ref V) -> Vec[u8] {
    match v {
        V.Bytes(b) => b.clone(),
        V.BArr(b) => b.clone(),
        _ => Vec.new(),
    }
}

fn ctor(name: Str, args: ref Vec[V], kw: ref Vec[(String, V)]) -> Result[V, Exc] {
    let first = if args.len() > 0 { args[0].clone() } else { V.None };
    if name == "Decimal" {
        return Ok(V.Dec(dec_parse(as_str(first))?));
    }
    if name == "UUID" {
        return Ok(V.Uuid(uuid_parse(as_str(first))?));
    }
    if name == "date" {
        let (y, m, d) = (as_int(arg(args, kw, 0, "year")), as_int(arg(args, kw, 1, "month")), as_int(arg(args, kw, 2, "day")));
        check_date(y, m, d)?;
        return Ok(V.Date(mk_dt(y, m, d, 0, 0, 0, 0, Tz.Naive)));
    }
    if name == "time" {
        let h = as_int(arg(args, kw, 0, "hour"));
        let mi = as_int(arg(args, kw, 1, "minute"));
        let s = as_int(arg(args, kw, 2, "second"));
        let us = as_int(arg(args, kw, 3, "microsecond"));
        check_time(h, mi, s, us)?;
        return Ok(V.Time(mk_dt(1900, 1, 1, h, mi, s, us, Tz.Naive)));
    }
    if name == "datetime" {
        let y = as_int(arg(args, kw, 0, "year"));
        let m = as_int(arg(args, kw, 1, "month"));
        let d = as_int(arg(args, kw, 2, "day"));
        let h = as_int(arg(args, kw, 3, "hour"));
        let mi = as_int(arg(args, kw, 4, "minute"));
        let s = as_int(arg(args, kw, 5, "second"));
        let us = as_int(arg(args, kw, 6, "microsecond"));
        check_date(y, m, d)?;
        check_time(h, mi, s, us)?;
        let tz = match arg(args, kw, -1, "tz") {
            Some(V.Int(n)) => if n == 0 { Tz.Utc } else { Tz.Fixed(n as i64) },
            _ => Tz.Naive,
        };
        return Ok(V.Dtm(mk_dt(y, m, d, h, mi, s, us, tz)));
    }
    if name == "timedelta" {
        let d = as_int(arg(args, kw, 0, "days")) as i128;
        let s = as_int(arg(args, kw, 1, "seconds")) as i128;
        let us = as_int(arg(args, kw, 2, "microseconds")) as i128;
        return Ok(V.Td(td_from_us(d * 86400000000 + s * 1000000 + us)));
    }
    if name == "bytearray" {
        return Ok(V.BArr(as_bytes(first)));
    }
    if name == "float" {
        return Ok(V.Float(py_float(as_str(first))?));
    }
    if name == "IPv4Address" or name == "IPv6Address" or name == "IPv4Network" or name == "IPv6Network" {
        let v6 = name.starts_with("IPv6");
        let s = as_str(first);
        let r = if name.ends_with("Network") { net_parse(s, v6, true) } else { ip_parse(s, v6) };
        return match r {
            Some(a) => Ok(V.Ip(a)),
            None => Err(value_error(f"bad {name} {py_str_repr(s)}")),
        };
    }
    if name == "Range" {
        let lo = arg(args, kw, 0, "lower").unwrap_or(V.None);
        let hi = arg(args, kw, 1, "upper").unwrap_or(V.None);
        let bounds = arg(args, kw, 2, "bounds").unwrap_or(sv("[)"));
        let empty = arg(args, kw, 3, "is_empty").unwrap_or(V.Bool(false));
        return Ok(V.Range(vec![lo, hi, bounds, empty]));
    }
    if name == "PGInterval" {
        let mut f = empty_interval();
        let mut i: i64 = 0;
        while i < 11 {
            f[i] = arg(args, kw, i, INTERVAL_FIELDS[i]).unwrap_or(V.None);
            i += 1;
        }
        return Ok(V.Interval(f));
    }
    if name == "out_bytes" {
        return Ok(V.Bio(Vec.new()));
    }
    if name == "out_text" {
        return Ok(V.Sio(String.new()));
    }
    if name == "in_lines" {
        return Ok(first);
    }
    if name == "in_bytes" {
        return Ok(V.Bio(as_bytes(first)));
    }
    if name == "in_text" {
        return Ok(V.Sio(as_str(first)));
    }
    Err(value_error(f"unsupported value {name}"))
}

// Splits on spaces outside quotes and brackets.
fn split_top(src: Str) -> Vec[String] {
    let cs: Vec[char] = src.chars().collect();
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    let mut depth: i64 = 0;
    let mut quote: char = '\u{0}';
    let mut i: i64 = 0;
    let n = cs.len() as i64;
    while i < n {
        let c = cs[i];
        if quote != '\u{0}' {
            cur.push(c);
            if c == '\\' {
                if i + 1 < n {
                    cur.push(cs[i + 1]);
                }
                i += 1;
            } else if c == quote {
                quote = '\u{0}';
            }
        } else if c == '\'' or c == '"' {
            quote = c;
            cur.push(c);
        } else if c == '(' or c == '[' or c == '{' {
            depth += 1;
            cur.push(c);
        } else if c == ')' or c == ']' or c == '}' {
            depth -= 1;
            cur.push(c);
        } else if c == ' ' and depth == 0 {
            if cur.len() > 0 {
                out.push(cur);
            }
            cur = String.new();
        } else {
            cur.push(c);
        }
        i += 1;
    }
    if cur.len() > 0 {
        out.push(cur);
    }
    out
}

fn kwargs(words: ref Vec[String], from: i64) -> Result[Vec[(String, V)], Exc] {
    let mut out: Vec[(String, V)] = Vec.new();
    let mut i = from;
    while i < words.len() as i64 {
        let w = words[i].clone();
        let at = match w.find("=") {
            Some(k) => k,
            None => return Err(value_error(f"not enough values to unpack (expected 2, got 1)")),
        };
        let key = w.substring(0, at);
        let val = parse_value(w.substring(at + 1, w.len()))?;
        out.push((key, val));
        i += 1;
    }
    Ok(out)
}

// ---- datetime.strptime for the formats pg8000 uses ----

// The directive regexes of _strptime.TimeRE, matched the way re.match
// would: alternatives in order, backtracking across directives.
fn dch(cs: ref Vec[char], i: i64) -> char {
    if i >= 0 and i < cs.len() as i64 { cs[i] } else { '\u{0}' }
}

fn din(cs: ref Vec[char], i: i64, lo: char, hi: char) -> bool {
    let c = dch(cs, i);
    c >= lo and c <= hi
}

// End positions a directive can match at i, in the regex's order.
fn directive_ends(d: char, cs: ref Vec[char], i: i64) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    if d == 'Y' {
        if din(cs, i, '0', '9') and din(cs, i + 1, '0', '9') and din(cs, i + 2, '0', '9') and din(cs, i + 3, '0', '9') {
            out.push(i + 4);
        }
    } else if d == 'm' {
        if dch(cs, i) == '1' and din(cs, i + 1, '0', '2') {
            out.push(i + 2);
        }
        if dch(cs, i) == '0' and din(cs, i + 1, '1', '9') {
            out.push(i + 2);
        }
        if din(cs, i, '1', '9') {
            out.push(i + 1);
        }
    } else if d == 'd' {
        if dch(cs, i) == '3' and din(cs, i + 1, '0', '1') {
            out.push(i + 2);
        }
        if din(cs, i, '1', '2') and din(cs, i + 1, '0', '9') {
            out.push(i + 2);
        }
        if dch(cs, i) == '0' and din(cs, i + 1, '1', '9') {
            out.push(i + 2);
        }
        if din(cs, i, '1', '9') {
            out.push(i + 1);
        }
        if dch(cs, i) == ' ' and din(cs, i + 1, '1', '9') {
            out.push(i + 2);
        }
    } else if d == 'H' {
        if dch(cs, i) == '2' and din(cs, i + 1, '0', '3') {
            out.push(i + 2);
        }
        if din(cs, i, '0', '1') and din(cs, i + 1, '0', '9') {
            out.push(i + 2);
        }
        if din(cs, i, '0', '9') {
            out.push(i + 1);
        }
        if dch(cs, i) == ' ' and din(cs, i + 1, '0', '9') {
            out.push(i + 2);
        }
    } else if d == 'M' {
        if din(cs, i, '0', '5') and din(cs, i + 1, '0', '9') {
            out.push(i + 2);
        }
        if din(cs, i, '0', '9') {
            out.push(i + 1);
        }
    } else if d == 'S' {
        if dch(cs, i) == '6' and din(cs, i + 1, '0', '1') {
            out.push(i + 2);
        }
        if din(cs, i, '0', '5') and din(cs, i + 1, '0', '9') {
            out.push(i + 2);
        }
        if din(cs, i, '0', '9') {
            out.push(i + 1);
        }
    } else if d == 'f' {
        let mut n: i64 = 0;
        while n < 6 and din(cs, i + n, '0', '9') {
            n += 1;
        }
        while n >= 1 {
            out.push(i + n);
            n -= 1;
        }
    } else if d == 'z' {
        // [+-]\d\d:?[0-5]\d(:?[0-5]\d(\.\d{1,6})?)?|Z
        if (dch(cs, i) == '+' or dch(cs, i) == '-') and din(cs, i + 1, '0', '9') and din(cs, i + 2, '0', '9') {
            let mut colon_opts: Vec[i64] = Vec.new();
            if dch(cs, i + 3) == ':' {
                colon_opts.push(i + 4);
            }
            colon_opts.push(i + 3);
            for a in colon_opts {
                if din(cs, a, '0', '5') and din(cs, a + 1, '0', '9') {
                    let b = a + 2;
                    let mut sec_opts: Vec[i64] = Vec.new();
                    if dch(cs, b) == ':' {
                        sec_opts.push(b + 1);
                    }
                    sec_opts.push(b);
                    for c in sec_opts {
                        if din(cs, c, '0', '5') and din(cs, c + 1, '0', '9') {
                            let e = c + 2;
                            if dch(cs, e) == '.' {
                                let mut n: i64 = 0;
                                while n < 6 and din(cs, e + 1 + n, '0', '9') {
                                    n += 1;
                                }
                                while n >= 1 {
                                    out.push(e + 1 + n);
                                    n -= 1;
                                }
                            }
                            out.push(e);
                        }
                    }
                    out.push(b);
                }
            }
        }
        if dch(cs, i) == 'Z' {
            out.push(i + 1);
        }
    }
    out
}

fn is_re_space(c: char) -> bool {
    c == ' ' or c == '\t' or c == '\n' or c == '\r' or c as u32 == 11 or c as u32 == 12
}

// Matches fmt[fi..] at data[i..]; caps holds each directive's text.
// Returns the end of the match, or -1.
fn sp_match(cs: ref Vec[char], i: i64, f: ref Vec[char], fi: i64, caps: mut ref Vec[(char, String)]) -> i64 {
    if fi >= f.len() as i64 {
        return i;
    }
    let c = f[fi];
    if c == '%' {
        let d = f[fi + 1];
        for e in directive_ends(d, cs, i) {
            caps.push((d, char_slice(cs, i, e)));
            let r = sp_match(cs, e, f, fi + 2, mut caps);
            if r >= 0 {
                return r;
            }
            caps.pop();
        }
        return -1;
    }
    if c == ' ' {
        let mut n: i64 = 0;
        while is_re_space(dch(cs, i + n)) {
            n += 1;
        }
        while n >= 1 {
            let r = sp_match(cs, i + n, f, fi + 1, mut caps);
            if r >= 0 {
                return r;
            }
            n -= 1;
        }
        return -1;
    }
    let x = dch(cs, i);
    if x != '\u{0}' and x.to_lowercase().to_string() == c.to_lowercase().to_string() {
        return sp_match(cs, i + 1, f, fi + 1, mut caps);
    }
    -1
}

fn strptime(data: Str, fmt: Str) -> Result[Dt, Exc] {
    let cs: Vec[char] = data.chars().collect();
    let f: Vec[char] = fmt.chars().collect();
    let mut caps: Vec[(char, String)] = Vec.new();
    let end = sp_match(cs, 0, f, 0, mut caps);
    if end < 0 {
        return Err(value_error(f"time data {py_str_repr(data)} does not match format {py_str_repr(fmt)}"));
    }
    if end != cs.len() as i64 {
        return Err(value_error(f"unconverted data remains: {char_slice(cs, end, cs.len() as i64)}"));
    }
    let mut t = mk_dt(1900, 1, 1, 0, 0, 0, 0, Tz.Naive);
    for (d, text) in caps {
        let txt = text.trim().to_string();
        if d == 'Y' {
            t.y = small_int(txt);
        } else if d == 'm' {
            t.mo = small_int(txt);
        } else if d == 'd' {
            t.d = small_int(txt);
        } else if d == 'H' {
            t.h = small_int(txt);
        } else if d == 'M' {
            t.mi = small_int(txt);
        } else if d == 'S' {
            t.s = small_int(txt);
        } else if d == 'f' {
            let mut s = txt.clone();
            while s.len() < 6 {
                s.push('0');
            }
            t.us = small_int(s);
        } else if d == 'z' {
            if text == "Z" {
                t.tz = Tz.Utc;
                continue;
            }
            let mut zc: Vec[char] = text.chars().collect();
            if zc[3] == ':' {
                zc.remove(3);
                if zc.len() > 5 {
                    if zc[5] != ':' {
                        return Err(value_error(f"Inconsistent use of : in {text}"));
                    }
                    zc.remove(5);
                }
            }
            let hours = small_int(char_slice(zc, 1, 3));
            let minutes = small_int(char_slice(zc, 3, 5));
            let seconds = if zc.len() >= 7 { small_int(char_slice(zc, 5, 7)) } else { 0 };
            let mut off = hours * 3600 + minutes * 60 + seconds;
            if zc[0] == '-' {
                off = -off;
            }
            t.tz = if off == 0 { Tz.Utc } else { Tz.Fixed(off) };
        }
    }
    check_date(t.y, t.mo, t.d)?;
    check_time(t.h, t.mi, t.s, t.us)?;
    Ok(t)
}

// ---- the dateutil.parser.parse subset pg8000 falls back to ----

fn digits_at(cs: ref Vec[char], i: i64, lo: i64, hi: i64) -> i64 {
    let mut n: i64 = 0;
    while n < hi and din(cs, i + n, '0', '9') {
        n += 1;
    }
    if n < lo { -1 } else { n }
}

// "Y-m-d H:M:S[.f]" with an optional numeric zone or a trailing zone
// name. An unknown name warns and leaves the datetime naive.
fn du_parse(s: Str, warns: mut ref Vec[String]) -> Option[V] {
    let cs: Vec[char] = s.chars().collect();
    let n = cs.len() as i64;
    if digits_at(cs, 0, 4, 5) != 4 or dch(cs, 4) != '-' {
        return None;
    }
    let mut i: i64 = 5;
    let mut nums: Vec[i64] = vec![small_int(char_slice(cs, 0, 4))];
    let seps: Vec[char] = vec!['-', ' ', ':', ':', '\u{0}'];
    let mut k: i64 = 0;
    while k < 5 {
        let w = digits_at(cs, i, 1, 2);
        if w < 0 {
            return None;
        }
        nums.push(small_int(char_slice(cs, i, i + w)));
        i += w;
        if k < 4 {
            if dch(cs, i) != seps[k] {
                return None;
            }
            i += 1;
        }
        k += 1;
    }
    let mut us: i64 = 0;
    if dch(cs, i) == '.' {
        let w = digits_at(cs, i + 1, 1, 20);
        if w < 0 {
            return None;
        }
        let mut frac = char_slice(cs, i + 1, i + 1 + if w > 6 { 6 } else { w });
        while frac.len() < 6 {
            frac.push('0');
        }
        us = small_int(frac);
        i += 1 + w;
    }
    let mut tz = Tz.Naive;
    if i < n and (cs[i] == '+' or cs[i] == '-') {
        let rest = char_slice(cs, i + 1, n);
        let rc: Vec[char] = rest.chars().collect();
        let mut hh: i64 = 0;
        let mut mm: i64 = 0;
        if rc.len() == 2 and all_digits(rest) {
            hh = small_int(rest);
        } else if rc.len() == 4 and all_digits(rest) {
            hh = small_int(char_slice(rc, 0, 2));
            mm = small_int(char_slice(rc, 2, 4));
        } else if rc.len() == 5 and rc[2] == ':' and all_digits(char_slice(rc, 0, 2)) and all_digits(char_slice(rc, 3, 5)) {
            hh = small_int(char_slice(rc, 0, 2));
            mm = small_int(char_slice(rc, 3, 5));
        } else {
            return None;
        }
        let mut off = hh * 3600 + mm * 60;
        if cs[i] == '-' {
            off = -off;
        }
        tz = if off == 0 { Tz.DUtc } else { Tz.Off(off) };
    } else if i < n {
        if cs[i] != ' ' {
            return None;
        }
        let name = char_slice(cs, i + 1, n);
        let mut alpha = name.len() > 0;
        for c in name.chars() {
            if not ((c >= 'A' and c <= 'Z') or (c >= 'a' and c <= 'z')) {
                alpha = false;
            }
        }
        if not alpha {
            return None;
        }
        if name == "UTC" or name == "GMT" or name == "Z" or name == "z" {
            tz = Tz.DUtc;
        } else {
            warns.push(f"UnknownTimezoneWarning: tzname {name} identified but not understood.  Pass `tzinfos` argument in order to correctly return a timezone-aware datetime.  In a future version, this will raise an exception.");
        }
    }
    let t = mk_dt(nums[0], nums[1], nums[2], nums[3], nums[4], nums[5], us, tz);
    if check_date(t.y, t.mo, t.d).is_err() or check_time(t.h, t.mi, t.s, t.us).is_err() {
        return None;
    }
    Some(V.Dtm(t))
}

// ---- PGInterval.from_str ----

fn split_ws(s: Str) -> Vec[String] {
    let mut out: Vec[String] = Vec.new();
    let mut cur = String.new();
    for c in s.chars() {
        if is_py_space(c) {
            if cur.len() > 0 {
                out.push(cur);
                cur = String.new();
            }
        } else {
            cur.push(c);
        }
    }
    if cur.len() > 0 {
        out.push(cur);
    }
    out
}

fn unit_field(k: Str) -> i64 {
    let name = if k == "millennium" {
        "millennia"
    } else if k == "century" {
        "centuries"
    } else if k == "decade" {
        "decades"
    } else if k == "year" {
        "years"
    } else if k == "month" or k == "mon" or k == "mons" {
        "months"
    } else if k == "week" {
        "weeks"
    } else if k == "day" {
        "days"
    } else if k == "hour" {
        "hours"
    } else if k == "minute" or k == "mins" {
        "minutes"
    } else if k == "secs" or k == "second" {
        "seconds"
    } else if k == "microsecond" {
        "microseconds"
    } else {
        k
    };
    if name == "millennia" or name == "centuries" or name == "decades" or name == "years" or name == "months"
        or name == "weeks" or name == "days" or name == "hours" or name == "minutes" or name == "seconds"
        or name == "microseconds" {
        return field_index(name);
    }
    -1
}

fn unpack_error(want: i64, got: i64) -> Exc {
    if got < want {
        return value_error(f"not enough values to unpack (expected {want}, got {got})");
    }
    value_error(f"too many values to unpack (expected {want})")
}

fn int_v(s: Str) -> Result[V, Exc] {
    Ok(V.Int(py_int(s, 10)?))
}

fn negate(v: ref V) -> V {
    match v {
        V.Int(n) => V.Int(-n),
        V.Float(x) => V.Float(-1.0 * x),
        _ => v.clone(),
    }
}

fn times_sign(v: ref V, sign: i64) -> V {
    if sign < 0 { negate(v) } else { v.clone() }
}

fn interval_iso(s: Str) -> Result[Vec[V], Exc] {
    let mut f = empty_interval();
    let cs: Vec[char] = s.chars().collect();
    let mut date_part = true;
    let mut val = String.new();
    let mut i: i64 = 1;
    while i < cs.len() as i64 {
        let c = cs[i];
        if c == 'T' {
            date_part = false;
        } else if is_digit(c) or c == '-' or c == '.' {
            val.push(c);
        } else {
            let name = if date_part {
                if c == 'Y' { "years" } else if c == 'M' { "months" } else if c == 'D' { "days" } else { "" }
            } else {
                if c == 'H' { "hours" } else if c == 'M' { "minutes" } else if c == 'S' { "seconds" } else { "" }
            };
            if name == "" {
                return Err(key_error(c.to_string()));
            }
            let v = if name == "seconds" { V.Float(py_float(val)?) } else { int_v(val)? };
            f[field_index(name)] = v;
            val = String.new();
        }
        i += 1;
    }
    Ok(f)
}

fn interval_postgres(s: Str) -> Result[Vec[V], Exc] {
    let mut f = empty_interval();
    let mut curr = V.None;
    for k in split_ws(s) {
        if k.contains(":") {
            let hms = split_char(k, ':');
            if hms.len() != 3 {
                return Err(unpack_error(3, hms.len() as i64));
            }
            let hours = py_int(hms[0], 10)?;
            if hours != 0 {
                f[7] = V.Int(hours);
            }
            let minutes = py_int(hms[1], 10)?;
            if minutes != 0 {
                f[8] = V.Int(minutes);
            }
            let seconds = py_float(hms[2])?;
            if seconds != 0.0 {
                f[9] = V.Float(seconds);
            }
        } else if k == "@" {
            continue;
        } else if k == "ago" {
            let mut i: i64 = 0;
            while i < 11 {
                if not is_none(f[i]) {
                    f[i] = negate(f[i]);
                }
                i += 1;
            }
        } else {
            match py_int(k, 10) {
                Ok(n) => curr = V.Int(n),
                Err(_) => {
                    let idx = unit_field(k);
                    if idx < 0 {
                        return Err(key_error(k));
                    }
                    f[idx] = curr.clone();
                }
            }
        }
    }
    Ok(f)
}

fn interval_sql(s: Str) -> Result[Vec[V], Exc] {
    let mut f = empty_interval();
    let parts = split_ws(s);
    let np = parts.len() as i64;
    let mut month_part = String.new();
    let mut has_month = false;
    let mut day_parts: Vec[String] = Vec.new();
    if np == 1 {
        month_part = parts[0].clone();
        has_month = true;
    } else if np == 2 {
        day_parts = parts.clone();
    } else {
        if np == 0 {
            return Err(exc("IndexError", "list index out of range"));
        }
        month_part = parts[0].clone();
        has_month = true;
        let mut i: i64 = 1;
        while i < np {
            day_parts.push(parts[i].clone());
            i += 1;
        }
    }
    if has_month {
        let (sign, p) = if month_part.starts_with("-") { (-1, month_part.substring(1, month_part.len())) } else { (1, month_part.clone()) };
        let ym = split_char(p, '-');
        if ym.len() != 2 {
            return Err(unpack_error(2, ym.len() as i64));
        }
        f[3] = V.Int(py_int(ym[0], 10)? * (sign as i128));
        f[4] = V.Int(py_int(ym[1], 10)? * (sign as i128));
    }
    if day_parts.len() > 0 {
        f[6] = V.Int(py_int(day_parts[0], 10)?);
        let tp = day_parts[1].clone();
        let (sign, p) = if tp.starts_with("-") { (-1, tp.substring(1, tp.len())) } else { (1, tp.clone()) };
        let hms = split_char(p, ':');
        if hms.len() != 3 {
            return Err(unpack_error(3, hms.len() as i64));
        }
        f[7] = V.Int(py_int(hms[0], 10)? * (sign as i128));
        f[8] = V.Int(py_int(hms[1], 10)? * (sign as i128));
        f[9] = V.Float(py_float(hms[2])? * (sign as f64));
    }
    Ok(f)
}

fn interval_from_str(s: Str) -> Result[Vec[V], Exc] {
    if s.starts_with("P") {
        return interval_iso(s);
    }
    if s.starts_with("@") {
        return interval_postgres(s);
    }
    let parts = split_ws(s);
    let first_alpha = if parts.len() > 1 {
        let c = parts[1].chars().next().unwrap_or('0');
        is_alpha(c)
    } else {
        false
    };
    if first_alpha or (parts.len() == 1 and parts[0].contains(":")) {
        return interval_postgres(s);
    }
    interval_sql(s)
}

fn us_of(v: ref V, scale: i128) -> i128 {
    match v {
        V.Int(n) => n * scale,
        V.Float(x) => {
            let y = x * (scale as f64);
            let r = y.round();
            // round half to even, as timedelta does
            let adj = if (r - y).abs() == 0.5 and (r as i128) % 2 != 0 { r - (r - y) * 2.0 } else { r };
            adj as i128
        }
        _ => 0,
    }
}

// PGInterval.to_timedelta, or the interval itself when a field cannot
// fit a timedelta.
fn interval_value(f: own Vec[V]) -> V {
    let mut i: i64 = 0;
    while i < 6 {
        if not is_none(f[i]) {
            return V.Interval(f);
        }
        i += 1;
    }
    let total = us_of(f[6], 86400000000) + us_of(f[7], 3600000000) + us_of(f[8], 60000000) + us_of(f[9], 1000000)
        + us_of(f[10], 1);
    V.Td(td_from_us(total))
}

// ---- json ----

fn cps_string(cps: ref Vec[i64]) -> String {
    let mut out = String.new();
    for c in cps {
        out.push(char.try_from(*c as u32).unwrap_or('\u{FFFD}'));
    }
    out
}

fn j_to_v(j: ref J) -> V {
    match j {
        J.Null => V.None,
        J.Bool(b) => V.Bool(b),
        J.Int(digits) => V.Int(py_int(digits, 10).unwrap_or(0)),
        J.Float(x) => V.Float(x),
        J.Str(s) => V.Str(cps_string(s)),
        J.Arr(items) => {
            let mut out: Vec[V] = Vec.new();
            for it in items {
                out.push(j_to_v(it));
            }
            V.List(out)
        }
        J.Obj(members) => {
            let mut kv: Vec[V] = Vec.new();
            for m in members {
                kv.push(V.Str(cps_string(m.key)));
                kv.push(j_to_v(m.val));
            }
            V.Dict(kv)
        }
    }
}

fn str_cps(s: Str) -> Vec[i64] {
    let mut out: Vec[i64] = Vec.new();
    for c in s.chars() {
        out.push(c as i64);
    }
    out
}

fn json_loads(s: Str) -> Result[V, Exc] {
    let j = loads(str_cps(s))?;
    Ok(j_to_v(j))
}

fn json_float(x: f64) -> String {
    if x != x {
        return "NaN".to_string();
    }
    if x == 1.0 / 0.0 {
        return "Infinity".to_string();
    }
    if x == -1.0 / 0.0 {
        return "-Infinity".to_string();
    }
    float_repr(x)
}

// json.dumps with its defaults.
fn json_dumps(v: ref V) -> Result[String, Exc] {
    match v {
        V.None => Ok("null".to_string()),
        V.Bool(b) => Ok(if b { "true".to_string() } else { "false".to_string() }),
        V.Int(n) => Ok(f"{n}"),
        V.Float(x) => Ok(json_float(x)),
        V.Str(s) => Ok(json_str(s)),
        V.List(xs) => json_items(xs),
        V.Tuple(xs) => json_items(xs),
        V.Dict(kv) => {
            let mut parts: Vec[String] = Vec.new();
            let mut i = 0;
            while i + 1 < kv.len() {
                let key = match kv[i] {
                    V.Str(s) => json_str(s),
                    V.Int(n) => json_str(f"{n}"),
                    V.Float(x) => json_str(json_float(x)),
                    V.Bool(b) => json_str(if b { "true" } else { "false" }),
                    V.None => json_str("null"),
                    _ => return Err(type_error(f"keys must be str, int, float, bool or None, not {type_name(kv[i])}")),
                };
                parts.push(f"{key}: {json_dumps(kv[i + 1])?}");
                i += 2;
            }
            Ok(f"{{{join(parts, ", ")}}}")
        }
        _ => Err(type_error(f"Object of type {type_name(v)} is not JSON serializable")),
    }
}

fn json_items(xs: ref Vec[V]) -> Result[String, Exc] {
    let mut parts: Vec[String] = Vec.new();
    for x in xs {
        parts.push(json_dumps(x)?);
    }
    Ok(f"[{join(parts, ", ")}]")
}

// ---- the out-converters: make_param over PY_TYPES ----

fn bytes_out(b: ref Vec[u8]) -> String {
    f"\\x{hex_of(b)}"
}

fn datetime_out(t: ref Dt) -> String {
    match t.tz {
        Tz.Naive => dt_iso(t, "T"),
        _ => dt_iso(to_utc(t), "T"),
    }
}

fn opt_str(v: ref V) -> String {
    if is_none(v) { "None".to_string() } else { pstr(v) }
}

fn make_param(v: ref V) -> Result[Option[String], Exc] {
    let s = match v {
        V.None => return Ok(None),
        V.Bool(b) => if b { "true".to_string() } else { "false".to_string() },
        V.Int(n) => f"{n}",
        V.Float(x) => float_repr(x),
        V.Str(s) => s.clone(),
        V.Bytes(b) => bytes_out(b),
        V.BArr(b) => bytes_out(b),
        V.Dec(s) => s.clone(),
        V.Date(t) => iso_date(t),
        V.Time(t) => iso_time(t),
        V.Dtm(t) => datetime_out(t),
        V.Td(t) => f"{t.d} days {t.s} seconds {t.us} microseconds",
        V.Interval(f) => f"{opt_str(f[6])} days {opt_str(f[9])} seconds {opt_str(f[10])} microseconds",
        V.Uuid(h) => uuid_str(h),
        V.Ip(a) => ip_str(a),
        V.Dict(_) => json_dumps(v)?,
        V.List(xs) => array_out(xs)?,
        V.Tuple(xs) => composite_out(xs)?,
        V.Range(r) => range_out(r)?,
        _ => pstr(v),
    };
    Ok(Some(s))
}

fn param_text(v: ref V) -> Result[String, Exc] {
    Ok(make_param(v)?.unwrap_or(String.new()))
}

fn array_string_escape(v: Str) -> String {
    let mut val = String.new();
    for c in v.chars() {
        if c == '\\' or c == '"' {
            val.push('\\');
        }
        val.push(c);
    }
    let mut special = val.len() == 0 or val == "NULL";
    for c in val.chars() {
        if is_py_space(c) or c == '{' or c == '}' or c == ',' or c == '\\' {
            special = true;
        }
    }
    if special { f"\"{val}\"" } else { val }
}

fn array_elem(v: ref V, in_array: bool) -> Result[String, Exc] {
    match v {
        V.List(xs) => array_out(xs),
        V.Tuple(xs) => if in_array { Ok(f"\"{composite_out(xs)?}\"") } else { composite_out(xs) },
        V.None => Ok(if in_array { "NULL".to_string() } else { String.new() }),
        V.Dict(_) => Ok(array_string_escape(json_dumps(v)?)),
        V.Bytes(b) => Ok(f"\"\\{bytes_out(b)}\""),
        V.BArr(b) => Ok(f"\"\\{bytes_out(b)}\""),
        V.Str(s) => Ok(array_string_escape(s)),
        _ => param_text(v),
    }
}

fn array_out(xs: ref Vec[V]) -> Result[String, Exc] {
    let mut parts: Vec[String] = Vec.new();
    for x in xs {
        parts.push(array_elem(x, true)?);
    }
    Ok(f"{{{join(parts, ",")}}}")
}

fn composite_out(xs: ref Vec[V]) -> Result[String, Exc] {
    let mut parts: Vec[String] = Vec.new();
    for x in xs {
        parts.push(array_elem(x, false)?);
    }
    Ok(f"({join(parts, ",")})")
}

fn range_out(r: ref Vec[V]) -> Result[String, Exc] {
    if range_empty(r) {
        return Ok("empty".to_string());
    }
    let b = range_bounds(r);
    let lo = if is_none(r[0]) { String.new() } else { param_text(r[0])? };
    let hi = if is_none(r[1]) { String.new() } else { param_text(r[1])? };
    Ok(f"{b[0]}{lo},{hi}{b[b.len() - 1]}")
}

// ---- identifier() and literal() ----

// str.isalpha(): ASCII letters, and every letter of Latin-1 and above
// (the jobs use no non-letter there).
fn is_alpha(c: char) -> bool {
    let n = c as u32;
    if n < 128 {
        return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z');
    }
    n == 0xAA or n == 0xB5 or n == 0xBA or (n >= 0xC0 and n != 0xD7 and n != 0xF7)
}

fn identifier(v: ref V) -> Result[String, Exc] {
    let sql = match v {
        V.Str(s) => s.clone(),
        _ => return Err(exc("InterfaceError", "identifier must be a str")),
    };
    let cs: Vec[char] = sql.chars().collect();
    if cs.len() == 0 {
        return Err(exc("InterfaceError", "identifier must be > 0 characters in length"));
    }
    let mut quote = not is_alpha(cs[0]);
    let mut i: i64 = 1;
    while i < cs.len() as i64 {
        let c = cs[i];
        if not (is_alpha(c) or is_digit(c) or c == '_' or c == '$') {
            if c as u32 == 0 {
                return Err(exc("InterfaceError", "identifier cannot contain the code zero character"));
            }
            quote = true;
            break;
        }
        i += 1;
    }
    if quote {
        return Ok(f"\"{sql.replace("\"", "\"\"")}\"");
    }
    Ok(sql)
}

fn literal(v: ref V) -> Result[String, Exc] {
    match v {
        V.None => Ok("NULL".to_string()),
        V.Bool(b) => Ok(if b { "TRUE".to_string() } else { "FALSE".to_string() }),
        V.Int(_) => Ok(pstr(v)),
        V.Float(_) => Ok(pstr(v)),
        V.Dec(_) => Ok(pstr(v)),
        V.Bytes(b) => Ok(f"X'{hex_of(b)}'"),
        V.BArr(b) => Ok(f"X'{hex_of(b)}'"),
        V.Dtm(t) => Ok(f"'{datetime_out(t)}'"),
        V.Date(t) => Ok(f"'{iso_date(t)}'"),
        V.Time(t) => Ok(f"'{iso_time(t)}'"),
        V.Td(_) => Ok(f"'{param_text(v)?}'"),
        V.List(xs) => Ok(f"'{array_out(xs)?}'"),
        _ => Ok(f"'{pstr(v).replace("'", "''")}'"),
    }
}

// ---- the in-converters: PG_TYPES by oid ----

// Element kinds; a range adds 100, a multirange 200, an array 1000.
const K_STR: i64 = 0;
const K_INT: i64 = 1;
const K_FLOAT: i64 = 2;
const K_BOOL: i64 = 3;
const K_BYTES: i64 = 4;
const K_DATE: i64 = 5;
const K_TIME: i64 = 6;
const K_TS: i64 = 7;
const K_TSTZ: i64 = 8;
const K_INTERVAL: i64 = 9;
const K_JSON: i64 = 10;
const K_NUMERIC: i64 = 11;
const K_POINT: i64 = 12;
const K_RECORD: i64 = 13;
const K_VECTOR: i64 = 14;
const K_UUID: i64 = 15;
const K_INET: i64 = 16;
// a range's timestamp bound, with its quotes
const K_TS_Q: i64 = 17;
const K_TSTZ_Q: i64 = 18;

fn oid_kind(oid: i64) -> i64 {
    match oid {
        20 => K_INT,
        21 => K_INT,
        23 => K_INT,
        26 => K_INT,
        28 => K_INT,
        1016 => 1000 + K_INT,
        1005 => 1000 + K_INT,
        1007 => 1000 + K_INT,
        16 => K_BOOL,
        1000 => 1000 + K_BOOL,
        17 => K_BYTES,
        1001 => 1000 + K_BYTES,
        1014 => 1000 + K_STR,
        1263 => 1000 + K_STR,
        791 => 1000 + K_STR,
        1003 => 1000 + K_STR,
        1009 => 1000 + K_STR,
        1015 => 1000 + K_STR,
        651 => 1000 + K_INET,
        1082 => K_DATE,
        1182 => 1000 + K_DATE,
        4535 => 200 + K_DATE,
        6155 => 1200 + K_DATE,
        3912 => 100 + K_DATE,
        3913 => 1100 + K_DATE,
        701 => K_FLOAT,
        700 => K_FLOAT,
        1022 => 1000 + K_FLOAT,
        1021 => 1000 + K_FLOAT,
        869 => K_INET,
        1041 => 1000 + K_INET,
        4451 => 200 + K_INT,
        6150 => 1200 + K_INT,
        3904 => 100 + K_INT,
        3905 => 1100 + K_INT,
        4536 => 200 + K_INT,
        6157 => 1200 + K_INT,
        3926 => 100 + K_INT,
        3927 => 1100 + K_INT,
        114 => K_JSON,
        3802 => K_JSON,
        199 => 1000 + K_JSON,
        3807 => 1000 + K_JSON,
        1700 => K_NUMERIC,
        1231 => 1000 + K_NUMERIC,
        3906 => 100 + K_NUMERIC,
        3907 => 1100 + K_NUMERIC,
        4532 => 200 + K_NUMERIC,
        6151 => 1200 + K_NUMERIC,
        600 => K_POINT,
        1186 => K_INTERVAL,
        1187 => 1000 + K_INTERVAL,
        2249 => K_RECORD,
        22 => K_VECTOR,
        1083 => K_TIME,
        1183 => 1000 + K_TIME,
        1114 => K_TS,
        1115 => 1000 + K_TS,
        1184 => K_TSTZ,
        1185 => 1000 + K_TSTZ,
        4533 => 200 + K_TS_Q,
        6152 => 1200 + K_TS_Q,
        3908 => 100 + K_TS_Q,
        3909 => 1100 + K_TS_Q,
        4534 => 200 + K_TSTZ_Q,
        6153 => 1200 + K_TSTZ_Q,
        3910 => 100 + K_TSTZ_Q,
        3911 => 1100 + K_TSTZ_Q,
        2951 => 1000 + K_UUID,
        2950 => K_UUID,
        _ => K_STR,
    }
}

fn date_in(s: Str) -> V {
    if s == "infinity" or s == "-infinity" {
        return sv(s);
    }
    match strptime(s, "%Y-%m-%d") {
        Ok(t) => V.Date(mk_dt(t.y, t.mo, t.d, 0, 0, 0, 0, Tz.Naive)),
        Err(_) => sv(s),
    }
}

fn time_in(s: Str) -> Result[V, Exc] {
    let pattern = if s.contains(".") { "%H:%M:%S.%f" } else { "%H:%M:%S" };
    let t = strptime(s, pattern)?;
    Ok(V.Time(t))
}

fn timestamp_in(s: Str, warns: mut ref Vec[String]) -> V {
    if s == "infinity" or s == "-infinity" {
        return sv(s);
    }
    let pattern = if s.contains(".") { "%Y-%m-%d %H:%M:%S.%f" } else { "%Y-%m-%d %H:%M:%S" };
    match strptime(s, pattern) {
        Ok(t) => V.Dtm(t),
        Err(_) => du_parse(s, mut warns).unwrap_or(sv(s)),
    }
}

fn timestamptz_in(s: Str, warns: mut ref Vec[String]) -> V {
    if s == "infinity" or s == "-infinity" {
        return sv(s);
    }
    let pattern = if s.contains(".") { "%Y-%m-%d %H:%M:%S.%f%z" } else { "%Y-%m-%d %H:%M:%S%z" };
    match strptime(f"{s}00", pattern) {
        Ok(t) => V.Dtm(t),
        Err(_) => du_parse(s, mut warns).unwrap_or(sv(s)),
    }
}

// bytes.fromhex
fn fromhex(s: Str) -> Result[Vec[u8], Exc] {
    let cs: Vec[char] = s.chars().collect();
    let n = cs.len() as i64;
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    loop {
        while i < n and is_ascii_space(cs[i]) {
            i += 1;
        }
        if i >= n {
            break;
        }
        let top = hex_val(cs[i]);
        if top < 0 or (cs[i] as u32) > 127 {
            return Err(value_error(f"non-hexadecimal number found in fromhex() arg at position {i}"));
        }
        let bot = if i + 1 < n and (cs[i + 1] as u32) < 128 { hex_val(cs[i + 1]) } else { -1 };
        if bot < 0 {
            return Err(value_error(f"non-hexadecimal number found in fromhex() arg at position {i + 1}"));
        }
        out.push((top * 16 + bot) as u8);
        i += 2;
    }
    Ok(out)
}

fn drop_ends(s: Str) -> String {
    let cs: Vec[char] = s.chars().collect();
    let n = cs.len() as i64;
    if n < 2 {
        return String.new();
    }
    char_slice(cs, 1, n - 1)
}

fn elem_in(k: i64, s: Str, warns: mut ref Vec[String]) -> Result[V, Exc] {
    if k >= 1000 {
        return parse_array(s, k - 1000, mut warns);
    }
    if k >= 200 {
        return multirange_in(s, k - 100, mut warns);
    }
    if k >= 100 {
        return range_in(s, k - 100, mut warns);
    }
    match k {
        1 => int_v(s),
        2 => Ok(V.Float(py_float(s)?)),
        3 => Ok(V.Bool(s == "t")),
        4 => {
            let cs: Vec[char] = s.chars().collect();
            Ok(V.Bytes(fromhex(char_slice(cs, if cs.len() >= 2 { 2 } else { cs.len() as i64 }, cs.len() as i64))?))
        }
        5 => Ok(date_in(s)),
        6 => time_in(s),
        7 => Ok(timestamp_in(s, mut warns)),
        8 => Ok(timestamptz_in(s, mut warns)),
        9 => Ok(interval_value(interval_from_str(s)?)),
        10 => json_loads(s),
        11 => Ok(V.Dec(dec_parse(s)?)),
        12 => {
            let mut xs: Vec[V] = Vec.new();
            for p in split_char(drop_ends(s), ',') {
                xs.push(V.Float(py_float(p)?));
            }
            Ok(V.Tuple(xs))
        }
        13 => Ok(record_in(s)),
        14 => {
            let mut xs: Vec[V] = Vec.new();
            for p in split_ws(s) {
                xs.push(int_v(p)?);
            }
            Ok(V.List(xs))
        }
        15 => Ok(V.Uuid(uuid_parse(s)?)),
        16 => if s.contains("/") { ip_network(s) } else { ip_address(s) },
        17 => Ok(timestamp_in(drop_ends(s), mut warns)),
        18 => Ok(timestamptz_in(drop_ends(s), mut warns)),
        _ => Ok(sv(s)),
    }
}

fn range_in(s: Str, k: i64, warns: mut ref Vec[String]) -> Result[V, Exc] {
    if s == "empty" {
        return Ok(V.Range(vec![V.None, V.None, sv("[)"), V.Bool(true)]));
    }
    let parts = split_char(drop_ends(s), ',');
    if parts.len() != 2 {
        return Err(unpack_error(2, parts.len() as i64));
    }
    let mut ends: Vec[V] = Vec.new();
    for p in parts {
        ends.push(if p.len() == 0 { V.None } else { elem_in(k, p, mut warns)? });
    }
    let cs: Vec[char] = s.chars().collect();
    let bounds = f"{cs[0]}{cs[cs.len() - 1]}";
    let hi = ends.pop().unwrap_or(V.None);
    let lo = ends.pop().unwrap_or(V.None);
    Ok(V.Range(vec![lo, hi, V.Str(bounds), V.Bool(false)]))
}

fn multirange_in(s: Str, rk: i64, warns: mut ref Vec[String]) -> Result[V, Exc] {
    let mut in_range = false;
    let mut out: Vec[V] = Vec.new();
    let mut val = String.new();
    for c in s.chars() {
        if in_range {
            val.push(c);
            if c == ']' or c == ')' {
                out.push(elem_in(rk, val, mut warns)?);
                val = String.new();
                in_range = false;
            }
        } else if c == '[' or c == '(' {
            val.push(c);
            in_range = true;
        }
    }
    Ok(V.List(out))
}

const PS_STRING: i64 = 1;
const PS_ESCAPE: i64 = 2;
const PS_VALUE: i64 = 3;
const PS_OUT: i64 = 4;

fn parse_array(s: Str, k: i64, warns: mut ref Vec[String]) -> Result[V, Exc] {
    let mut state = PS_OUT;
    let mut stack: Vec[Vec[V]] = vec![Vec.new()];
    let mut val = String.new();
    for c in s.chars() {
        if state == PS_VALUE {
            if c == '}' or c == ',' {
                let item = if val == "NULL" { V.None } else { elem_in(k, val, mut warns)? };
                let top = stack.len() - 1;
                stack[top].push(item);
                state = PS_OUT;
            } else {
                val.push(c);
            }
        }
        if state == PS_OUT {
            if c == '{' {
                stack.push(Vec.new());
            } else if c == '}' {
                let done = stack.pop().unwrap_or(Vec.new());
                if stack.len() == 0 {
                    return Err(exc("IndexError", "list index out of range"));
                }
                let top = stack.len() - 1;
                stack[top].push(V.List(done));
            } else if c == ',' {
            } else if c == '"' {
                val = String.new();
                state = PS_STRING;
            } else {
                val = c.to_string();
                state = PS_VALUE;
            }
        } else if state == PS_STRING {
            if c == '"' {
                let item = elem_in(k, val, mut warns)?;
                let top = stack.len() - 1;
                stack[top].push(item);
                state = PS_OUT;
            } else if c == '\\' {
                state = PS_ESCAPE;
            } else {
                val.push(c);
            }
        } else if state == PS_ESCAPE {
            val.push(c);
            state = PS_STRING;
        }
    }
    if stack.len() == 0 or stack[0].len() == 0 {
        return Err(exc("IndexError", "list index out of range"));
    }
    Ok(stack[0][0].clone())
}

fn record_in(s: Str) -> V {
    let mut state = PS_OUT;
    let mut results: Vec[V] = Vec.new();
    let mut val = String.new();
    for c in s.chars() {
        if state == PS_VALUE {
            if c == ')' or c == ',' {
                results.push(if val.len() == 0 { V.None } else { V.Str(val.clone()) });
                val = String.new();
                state = PS_OUT;
            } else {
                val.push(c);
            }
        }
        if state == PS_OUT {
            if c == '(' or c == ')' or c == ',' {
            } else if c == '"' {
                state = PS_STRING;
            } else {
                val.push(c);
                state = PS_VALUE;
            }
        } else if state == PS_STRING {
            if c == '"' {
                results.push(V.Str(val.clone()));
                val = String.new();
                state = PS_OUT;
            } else if c == '\\' {
                state = PS_ESCAPE;
            } else {
                val.push(c);
            }
        } else if state == PS_ESCAPE {
            val.push(c);
            state = PS_STRING;
        }
    }
    V.Tuple(results)
}

fn pg_in(oid: i64, s: Str, warns: mut ref Vec[String]) -> Result[V, Exc] {
    elem_in(oid_kind(oid), s, mut warns)
}

// ---- client encodings ----

const ENC_UTF8: i64 = 0;
const ENC_LATIN1: i64 = 1;
const ENC_CP1252: i64 = 2;
const ENC_ASCII: i64 = 3;
const ENC_OTHER: i64 = 4;

const CP1252_HIGH: Array[u32, 32] = [
    0x20AC, 0xFFFD, 0x201A, 0x192, 0x201E, 0x2026, 0x2020, 0x2021, 0x2C6, 0x2030, 0x160, 0x2039, 0x152,
    0xFFFD, 0x17D, 0xFFFD, 0xFFFD, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014, 0x2DC,
    0x2122, 0x161, 0x203A, 0x153, 0xFFFD, 0x17E, 0x178,
];

// PG_PY_ENCODINGS.get(name.lower(), name.lower()), for the codecs here.
fn encoding_of(name: Str) -> i64 {
    let n = name.to_lowercase();
    if n == "utf8" or n == "unicode" {
        ENC_UTF8
    } else if n == "latin1" {
        ENC_LATIN1
    } else if n == "win1252" {
        ENC_CP1252
    } else if n == "sql_ascii" {
        ENC_ASCII
    } else {
        ENC_OTHER
    }
}

fn codec_name(enc: i64) -> String {
    let n = if enc == ENC_UTF8 { "utf-8" } else if enc == ENC_LATIN1 { "latin-1" } else if enc == ENC_ASCII { "ascii" } else { "charmap" };
    n.to_string()
}

fn encode(s: Str, enc: i64) -> Result[Vec[u8], Exc] {
    if enc == ENC_UTF8 {
        return Ok(s.bytes().to_vec());
    }
    let mut out: Vec[u8] = Vec.new();
    let mut pos: i64 = 0;
    for c in s.chars() {
        let n = c as u32;
        let mut code: i64 = -1;
        if n < 128 {
            code = n as i64;
        } else if enc == ENC_LATIN1 and n < 256 {
            code = n as i64;
        } else if enc == ENC_CP1252 {
            if n >= 0xA0 and n < 256 {
                code = n as i64;
            } else {
                let mut k: i64 = 0;
                while k < 32 {
                    if CP1252_HIGH[k] == n and n != 0xFFFD {
                        code = 0x80 + k;
                    }
                    k += 1;
                }
            }
        }
        if code < 0 {
            let cr = py_str_repr(c.to_string());
            let why = if enc == ENC_LATIN1 { "ordinal not in range(256)" } else if enc == ENC_ASCII { "ordinal not in range(128)" } else { "character maps to <undefined>" };
            return Err(exc("UnicodeEncodeError", f"'{codec_name(enc)}' codec can't encode character {cr} in position {pos}: {why}"));
        }
        out.push(code as u8);
        pos += 1;
    }
    Ok(out)
}

fn decode(b: ref Vec[u8], enc: i64, replace: bool) -> Result[String, Exc] {
    if enc == ENC_UTF8 {
        match utf8_decode(b, 0, b.len() as i64) {
            Ok(s) => return Ok(s),
            Err(e) => {
                if not replace {
                    return Err(e);
                }
                // simplified "replace": past the first bad sequence every
                // non-ASCII byte becomes U+FFFD
                let mut out = String.new();
                for x in b {
                    out.push(if *x < 128 { *x as char } else { '\u{FFFD}' });
                }
                return Ok(out);
            }
        }
    }
    let mut out = String.new();
    let mut i: i64 = 0;
    while i < b.len() as i64 {
        let x = b[i] as u32;
        let mut cp: u32 = x;
        if x >= 128 and enc == ENC_ASCII {
            cp = 0xFFFD;
        } else if x >= 0x80 and x < 0xA0 and enc == ENC_CP1252 {
            cp = CP1252_HIGH[(x - 0x80) as i64];
        }
        if cp == 0xFFFD and not replace {
            let why = if enc == ENC_ASCII { "ordinal not in range(128)" } else { "character maps to <undefined>" };
            return Err(exc("UnicodeDecodeError", f"'{codec_name(enc)}' codec can't decode byte 0x{hex_n(x as i64, 2)} in position {i}: {why}"));
        }
        out.push(char.try_from(cp).unwrap_or('\u{FFFD}'));
        i += 1;
    }
    Ok(out)
}

fn ascii_text(b: ref Vec[u8]) -> String {
    let mut out = String.new();
    for x in b {
        out.push(char.try_from(*x as u32).unwrap_or('?'));
    }
    out
}

// ---- byte helpers ----

fn i32_bytes(n: i64) -> Vec[u8] {
    let u = (n as u32);
    vec![((u >> 24) & 255) as u8, ((u >> 16) & 255) as u8, ((u >> 8) & 255) as u8, (u & 255) as u8]
}

fn i16_bytes(n: i64) -> Vec[u8] {
    let u = (n as u32);
    vec![((u >> 8) & 255) as u8, (u & 255) as u8]
}

fn get_i32(b: ref Vec[u8], i: i64) -> i64 {
    let u = ((b[i] as u32) << 24) | ((b[i + 1] as u32) << 16) | ((b[i + 2] as u32) << 8) | (b[i + 3] as u32);
    (u as i32) as i64
}

fn get_i16(b: ref Vec[u8], i: i64) -> i64 {
    let u = ((b[i] as u32) << 8) | (b[i + 1] as u32);
    ((u as u16) as i16) as i64
}

fn get_u16(b: ref Vec[u8], i: i64) -> i64 {
    (((b[i] as u32) << 8) | (b[i + 1] as u32)) as i64
}

fn find_nul(b: ref Vec[u8], from: i64) -> i64 {
    let mut i = from;
    while i < b.len() as i64 {
        if b[i] == 0 {
            return i;
        }
        i += 1;
    }
    -1
}

fn slice(b: ref Vec[u8], from: i64, to: i64) -> Vec[u8] {
    let n = b.len() as i64;
    let a = if from < 0 { 0 } else if from > n { n } else { from };
    let e = if to < a { a } else if to > n { n } else { to };
    b[a..e].to_vec()
}

fn split_nul(b: ref Vec[u8]) -> Vec[Vec[u8]] {
    let mut out: Vec[Vec[u8]] = Vec.new();
    let mut cur: Vec[u8] = Vec.new();
    for x in b {
        if *x == 0 {
            out.push(cur);
            cur = Vec.new();
        } else {
            cur.push(*x);
        }
    }
    out.push(cur);
    out
}

fn bytes_of(s: Str) -> Vec[u8] {
    s.bytes().to_vec()
}

fn append(out: mut ref Vec[u8], b: ref Vec[u8]) {
    for x in b {
        out.push(*x);
    }
}

fn interface_error(msg: Str) -> Exc {
    exc("InterfaceError", msg)
}

fn scram_error(msg: Str, server_error: Str) -> Exc {
    if server_error.len() > 0 {
        return exc("ScramException", f"{msg}: {server_error}");
    }
    exc("ScramException", msg)
}

// ---- scramp's client side ----

const MECHANISMS: Array[Str, 8] = [
    "SCRAM-SHA-1", "SCRAM-SHA-1-PLUS", "SCRAM-SHA-256", "SCRAM-SHA-256-PLUS", "SCRAM-SHA-512",
    "SCRAM-SHA-512-PLUS", "SCRAM-SHA3-512", "SCRAM-SHA3-512-PLUS",
];

struct Scram {
    kind: i64,
    name: String,
    c_nonce: String,
    username: String,
    password: String,
    bare: String,
    server_first: String,
    nonce: String,
    salt: String,
    iterations: i64,
    server_signature: String,
}

// saslprep for ASCII text: no mapping applies, NFKC changes nothing and
// only the control characters are prohibited.
fn saslprep(s: Str) -> Result[String, Exc] {
    for c in s.chars() {
        let n = c as u32;
        if n < 0x20 or n == 0x7F {
            return Err(scram_error("control characters forbidden", "invalid-encoding"));
        }
    }
    Ok(s.to_string())
}

fn next_nonce(k: mut ref i64) -> String {
    let base: u128 = 0x5f3a91c2d8e64b07a1c39e2f4d6b8a10;
    let v = base + 7919 * (*k as u128);
    *k += 1;
    let mut h = hex_str(v);
    while h.len() < 32 {
        h = f"0{h}";
    }
    h
}

fn scram_new(mechs: ref Vec[String], user: Str, password: Str, nonces: mut ref i64) -> Result[Scram, Exc] {
    let mut best: i64 = -1;
    for m in mechs {
        let mut idx: i64 = -1;
        let mut k: i64 = 0;
        while k < 8 {
            if MECHANISMS[k] == m {
                idx = k;
            }
            k += 1;
        }
        if idx < 0 {
            let mut names: Vec[String] = Vec.new();
            let mut j: i64 = 0;
            while j < 8 {
                names.push(py_str_repr(MECHANISMS[j]));
                j += 1;
            }
            return Err(scram_error(f"The mechanism name {py_str_repr(m)} is not supported. The supported mechanisms are ({join(names, ", ")}).", ""));
        }
        // no channel binding, so the -PLUS mechanisms are dropped
        if idx % 2 == 0 and idx >= best {
            best = idx;
        }
    }
    if best < 0 {
        let mut items: Vec[V] = Vec.new();
        for m in mechs {
            items.push(V.Str(m.clone()));
        }
        return Err(scram_error(f"There are no suitable mechanisms in the list provided: {repr(V.List(items))}", ""));
    }
    let kind = if best == 0 { D_SHA1 } else if best == 2 { D_SHA256 } else { -1 };
    if kind < 0 {
        return Err(scram_error(f"{MECHANISMS[best]} is not implemented in this port", ""));
    }
    Ok(Scram {
        kind: kind,
        name: MECHANISMS[best].to_string(),
        c_nonce: next_nonce(mut nonces),
        username: user.to_string(),
        password: password.to_string(),
        bare: String.new(),
        server_first: String.new(),
        nonce: String.new(),
        salt: String.new(),
        iterations: 0,
        server_signature: String.new(),
    })
}

// _parse_message: the attributes in order of first appearance, the last
// value of each.
fn parse_scram(msg: Str, desc: Str, validations: ref Vec[String]) -> Result[Vec[(String, String)], Exc] {
    let parts = split_char(msg, ',');
    for p in parts {
        let pc: Vec[char] = p.chars().collect();
        if pc.len() < 2 or pc[1] != '=' {
            return Err(scram_error(f"Malformed {desc} message. Attributes must be separated by a ',' and each attribute must start with a letter followed by a '='", "other-error"));
        }
    }
    let mut m: Vec[(String, String)] = Vec.new();
    for p in parts {
        let pc: Vec[char] = p.chars().collect();
        let key = pc[0].to_string();
        let val = char_slice(pc, 2, pc.len() as i64);
        let mut found = false;
        for entry in m.iter_mut() {
            if entry.0 == key {
                entry.1 = val.clone();
                found = true;
            }
        }
        if not found {
            m.push((key, val));
        }
    }
    let mut keystr = String.new();
    for (k, _) in m {
        keystr.push_str(k);
    }
    for v in validations {
        if keystr == v {
            return Ok(m);
        }
    }
    let val_str = if validations.len() == 1 {
        f"'{validations[0]}'"
    } else {
        let mut items: Vec[String] = Vec.new();
        for v in validations {
            items.push(py_str_repr(v));
        }
        f"one of ({join(items, ", ")})"
    };
    Err(scram_error(f"Malformed {desc} message. Expected the attribute list to be {val_str} but found '{keystr}'", "other-error"))
}

fn attr(m: ref Vec[(String, String)], key: Str) -> Option[String] {
    for (k, v) in m {
        if k == key {
            return Some(v.clone());
        }
    }
    None
}

fn scram_client_first(sc: mut ref Scram) -> Result[String, Exc] {
    let u = match saslprep(sc.username) {
        Ok(u) => u,
        Err(e) => return Err(exc("ScramException", f"{e.msg.replace(": invalid-encoding", "")}: invalid-username-encoding")),
    };
    sc.bare = f"n={u},r={sc.c_nonce}";
    Ok(f"n,,{sc.bare}")
}

fn scram_set_server_first(sc: mut ref Scram, msg: Str) -> Result[(), Exc] {
    sc.server_first = msg.to_string();
    let m = parse_scram(msg, "server first", vec!["rsi".to_string()])?;
    match attr(m, "e") {
        Some(e) => return Err(scram_error(f"The server returned the error: {e}", "")),
        None => {}
    }
    let nonce = attr(m, "r").unwrap_or(String.new());
    sc.salt = attr(m, "s").unwrap_or(String.new());
    sc.iterations = py_int(attr(m, "i").unwrap_or(String.new()), 10)? as i64;
    if not nonce.starts_with(sc.c_nonce) {
        return Err(scram_error("Client nonce doesn't match.", "other-error"));
    }
    sc.nonce = nonce;
    Ok(())
}

fn scram_client_final(sc: mut ref Scram) -> Result[String, Exc] {
    let salt = a2b_base64(bytes_of(sc.salt))?;
    let pw = bytes_of(saslprep(sc.password)?);
    let salted = hi(sc.kind, pw, salt, sc.iterations);
    let client_key = hmac(sc.kind, salted, bytes_of("Client Key"));
    let stored_key = digest(sc.kind, client_key);
    let server_key = hmac(sc.kind, salted, bytes_of("Server Key"));
    let without_proof = f"c={b64encode(bytes_of("n,,"))},r={sc.nonce}";
    let auth_msg = bytes_of(f"{sc.bare},{sc.server_first},{without_proof}");
    let client_signature = hmac(sc.kind, stored_key, auth_msg);
    let proof = xor_bytes(client_key, client_signature);
    sc.server_signature = b64encode(hmac(sc.kind, server_key, auth_msg));
    Ok(f"{without_proof},p={b64encode(proof)}")
}

fn scram_set_server_final(sc: ref Scram, msg: Str) -> Result[(), Exc] {
    let m = parse_scram(msg, "server final", vec!["v".to_string(), "e".to_string()])?;
    match attr(m, "e") {
        Some(e) => return Err(scram_error(f"The server returned the error: {e}", "")),
        None => {}
    }
    if attr(m, "v").unwrap_or(String.new()) != sc.server_signature {
        return Err(scram_error("The server signature doesn't match.", "other-error"));
    }
    Ok(())
}

// ---- the connection, over a fake socket that replays the server ----

struct Ctx {
    statement: Option[String],
    rows: Option[Vec[V]],
    row_count: i64,
    columns: Option[Vec[V]],
    oids: Vec[i64],
    stream: V,
    // how COPY OUT writes: 0 not set, 1 bytes, 2 decoded text
    write_mode: i64,
    error: Option[Exc],
}

fn ctx_new(statement: own Option[String], stream: own V, columns: own Option[Vec[V]], oids: own Vec[i64]) -> Ctx {
    let rows: Option[Vec[V]] = match columns {
        Some(_) => Some(Vec.new()),
        None => None,
    };
    Ctx { statement: statement, rows: rows, row_count: -1, columns: columns, oids: oids, stream: stream, write_mode: 0, error: None }
}

struct Conn {
    inp: Vec[u8],
    pos: i64,
    out: Vec[u8],
    started: bool,
    open: bool,
    enc: i64,
    user: Vec[u8],
    password: Option[Vec[u8]],
    status: V,
    key: V,
    params: Vec[V],
    notices: Vec[V],
    notifications: Vec[V],
    stmt_names: Vec[Vec[u8]],
    scram: Option[Scram],
    last: Option[Ctx],
}

fn deque_push(q: mut ref Vec[V], v: own V) {
    q.push(v);
    if q.len() > 100 {
        q.remove(0);
    }
}

fn write(c: mut ref Conn, b: ref Vec[u8]) -> Result[(), Exc] {
    if not c.open {
        return Err(interface_error("connection is closed"));
    }
    append(mut c.out, b);
    Ok(())
}

fn send_message(c: mut ref Conn, code: u8, data: ref Vec[u8]) -> Result[(), Exc] {
    let mut m: Vec[u8] = vec![code];
    append(mut m, i32_bytes(data.len() as i64 + 4));
    append(mut m, data);
    write(mut c, m)
}

fn send_empty(c: mut ref Conn, code: u8) -> Result[(), Exc] {
    send_message(mut c, code, Vec.new())
}

// FakeSock.flush: prints each message the client wrote since the last one.
fn flush(c: mut ref Conn) {
    let b = c.out.clone();
    c.out.clear();
    let n = b.len() as i64;
    let mut i: i64 = 0;
    if not c.started and n >= 4 {
        let len = get_i32(b, 0);
        println(f"    > startup {py_bytes_repr(slice(b, 4, len))}");
        i = len;
        c.started = true;
    }
    while i + 5 <= n {
        let len = get_i32(b, i + 1);
        let code = (b[i] as char).to_string();
        println(f"    > {code} {py_bytes_repr(slice(b, i + 5, i + 1 + len))}");
        i += 1 + len;
    }
}

fn read(c: mut ref Conn, n: i64) -> Result[Vec[u8], Exc] {
    if c.pos + n > c.inp.len() as i64 {
        c.pos = c.inp.len() as i64;
        return Err(interface_error("network error"));
    }
    let b = slice(c.inp, c.pos, c.pos + n);
    c.pos += n;
    Ok(b)
}

fn close(c: mut ref Conn) -> Result[(), Exc] {
    if not c.open {
        return Err(interface_error("connection is closed"));
    }
    send_empty(mut c, b'X')?;
    flush(mut c);
    c.open = false;
    Ok(())
}

fn known_code(code: u8) -> bool {
    let codes = "NRSKZTEIDC123sntAcdGH".bytes();
    for x in codes {
        if x == code {
            return true;
        }
    }
    false
}

fn handle_auth(c: mut ref Conn, data: ref Vec[u8], nonces: mut ref i64) -> Result[(), Exc] {
    let code = get_i32(data, 0);
    if code == 0 {
        return Ok(());
    }
    if code == 3 {
        let pw = match c.password {
            Some(p) => p.clone(),
            None => return Err(interface_error("server requesting password authentication, but no password was provided")),
        };
        let mut m = pw;
        m.push(0);
        send_message(mut c, b'p', m)?;
        flush(mut c);
        return Ok(());
    }
    if code == 5 {
        let salt = slice(data, 4, 8);
        let pw = match c.password {
            Some(p) => p.clone(),
            None => return Err(interface_error("server requesting MD5 password authentication, but no password was provided")),
        };
        let inner = hex_of(md5(cat(pw, c.user)));
        let outer = hex_of(md5(cat(bytes_of(inner), salt)));
        let mut m = bytes_of(f"md5{outer}");
        m.push(0);
        send_message(mut c, b'p', m)?;
        flush(mut c);
        return Ok(());
    }
    if code == 10 {
        let mut mechs: Vec[String] = Vec.new();
        for m in split_nul(slice(data, 4, data.len() as i64 - 2)) {
            mechs.push(ascii_text(m));
        }
        let user = decode(c.user, ENC_UTF8, false)?;
        let password = match c.password {
            Some(p) => decode(p, ENC_UTF8, false)?,
            None => return Err(exc("AttributeError", "'NoneType' object has no attribute 'decode'")),
        };
        let mut sc = scram_new(mechs, user, password, mut nonces)?;
        let init = bytes_of(scram_client_first(mut sc)?);
        let mut m = bytes_of(sc.name);
        m.push(0);
        append(mut m, i32_bytes(init.len() as i64));
        append(mut m, init);
        c.scram = Some(sc);
        send_message(mut c, b'p', m)?;
        flush(mut c);
        return Ok(());
    }
    if code == 11 {
        let msg = decode(slice(data, 4, data.len() as i64), ENC_UTF8, false)?;
        let mut sc = match c.scram.take() {
            Some(s) => s,
            None => return Err(exc("AttributeError", "'Connection' object has no attribute 'auth'")),
        };
        let r = scram_set_server_first(mut sc, msg);
        let fin = match r {
            Ok(()) => scram_client_final(mut sc),
            Err(e) => Err(e),
        };
        c.scram = Some(sc);
        let text = fin?;
        send_message(mut c, b'p', bytes_of(text))?;
        flush(mut c);
        return Ok(());
    }
    if code == 12 {
        let msg = decode(slice(data, 4, data.len() as i64), ENC_UTF8, false)?;
        return match c.scram {
            Some(sc) => scram_set_server_final(sc, msg),
            None => Err(exc("AttributeError", "'Connection' object has no attribute 'auth'")),
        };
    }
    if code == 2 or code == 4 or code == 6 or code == 7 or code == 8 or code == 9 {
        return Err(interface_error(f"Authentication method {code} not supported by pg8000."));
    }
    Err(interface_error(f"Authentication method {code} not recognized by pg8000."))
}

fn first_word_upper(s: Str) -> Result[String, Exc] {
    let words = split_ws(s);
    if words.len() == 0 {
        return Err(exc("IndexError", "list index out of range"));
    }
    let mut w = words[0].clone();
    while w.ends_with(";") {
        w = w.substring(0, w.len() - 1);
    }
    Ok(w.to_uppercase())
}

fn handle(c: mut ref Conn, code: u8, data: ref Vec[u8], ctx: mut ref Ctx, warns: mut ref Vec[String], nonces: mut ref i64) -> Result[(), Exc] {
    if code == b'N' {
        let mut d: Vec[V] = Vec.new();
        for s in split_nul(data) {
            dict_put(mut d, V.Bytes(slice(s, 0, 1)), V.Bytes(slice(s, 1, s.len() as i64)));
        }
        deque_push(mut c.notices, V.Dict(d));
    } else if code == b'R' {
        handle_auth(mut c, data, mut nonces)?;
    } else if code == b'S' {
        let p = find_nul(data, 0);
        let key = ascii_text(slice(data, 0, p));
        let value = decode(slice(data, p + 1, data.len() as i64 - 1), c.enc, false)?;
        if key == "client_encoding" {
            c.enc = encoding_of(value);
        }
        dict_put(mut c.params, V.Str(key), V.Str(value));
    } else if code == b'K' {
        c.key = V.Bytes(data.clone());
    } else if code == b'Z' {
        c.status = V.Bytes(data.clone());
    } else if code == b'T' {
        let count = get_u16(data, 0);
        let mut idx: i64 = 2;
        let mut columns: Vec[V] = Vec.new();
        let mut oids: Vec[i64] = Vec.new();
        let mut k: i64 = 0;
        while k < count {
            let end = find_nul(data, idx);
            let name = slice(data, idx, end);
            idx += name.len() as i64 + 1;
            let type_oid = get_i32(data, idx + 6);
            let col: Vec[V] = vec![
                sv("table_oid"), V.Int(get_i32(data, idx) as i128),
                sv("column_attrnum"), V.Int(get_i16(data, idx + 4) as i128),
                sv("type_oid"), V.Int(type_oid as i128),
                sv("type_size"), V.Int(get_i16(data, idx + 10) as i128),
                sv("type_modifier"), V.Int(get_i32(data, idx + 12) as i128),
                sv("format"), V.Int(get_i16(data, idx + 16) as i128),
                sv("name"), V.Str(decode(name, c.enc, false)?),
            ];
            idx += 18;
            columns.push(V.Dict(col));
            oids.push(type_oid);
            k += 1;
        }
        ctx.columns = Some(columns);
        ctx.oids = oids;
        if ctx.rows.is_none() {
            ctx.rows = Some(Vec.new());
        }
    } else if code == b'E' {
        let mut d: Vec[V] = Vec.new();
        for s in split_nul(data) {
            if s.len() > 0 {
                dict_put(mut d, V.Str(ascii_text(slice(s, 0, 1))), V.Str(decode(slice(s, 1, s.len() as i64), c.enc, true)?));
            }
        }
        ctx.error = Some(exc("DatabaseError", repr(V.Dict(d))));
    } else if code == b'D' {
        let mut idx: i64 = 2;
        let mut row: Vec[V] = Vec.new();
        for oid in ctx.oids.clone() {
            let vlen = get_i32(data, idx);
            idx += 4;
            if vlen == -1 {
                row.push(V.None);
            } else {
                let text = decode(slice(data, idx, idx + vlen), c.enc, false)?;
                row.push(pg_in(oid, text, mut warns)?);
                idx += vlen;
            }
        }
        match ctx.rows {
            Some(rows) => rows.push(V.List(row)),
            None => return Err(exc("AttributeError", "'NoneType' object has no attribute 'append'")),
        }
    } else if code == b'C' {
        let failed = match c.status {
            V.Bytes(b) => b.len() == 1 and b[0] == b'E',
            _ => false,
        };
        if failed and ctx.error.is_none() {
            let sql = match ctx.statement {
                Some(s) => first_word_upper(s)?,
                None => return Err(exc("AttributeError", "'NoneType' object has no attribute 'split'")),
            };
            if sql != "ROLLBACK" {
                ctx.error = Some(interface_error("in failed transaction block"));
            }
        }
        let words = split_char(ascii_text(slice(data, 0, data.len() as i64 - 1)), ' ');
        match py_int(words[words.len() - 1], 10) {
            Ok(n) => {
                if ctx.row_count == -1 {
                    ctx.row_count = n as i64;
                } else {
                    ctx.row_count += n as i64;
                }
            }
            Err(_) => {}
        }
    } else if code == b'A' {
        let pid = get_i32(data, 0);
        let nul = find_nul(data, 4);
        let channel = ascii_text(slice(data, 4, nul));
        let payload = ascii_text(slice(data, nul + 1, data.len() as i64 - 1));
        deque_push(mut c.notifications, V.Tuple(vec![V.Int(pid as i128), V.Str(channel), V.Str(payload)]));
    } else if code == b'H' {
        let is_binary = (data[0] as i8) != 0;
        match ctx.stream {
            V.None => return Err(interface_error("An output stream is required for the COPY OUT response.")),
            V.Sio(_) => {
                if is_binary {
                    return Err(interface_error("The COPY OUT stream is binary, but the stream parameter is text."));
                }
                ctx.write_mode = 2;
            }
            V.Bio(_) => ctx.write_mode = 1,
            _ => return Err(exc("AttributeError", f"'{type_name(ctx.stream)}' object has no attribute 'write'")),
        }
    } else if code == b'd' {
        if ctx.write_mode == 1 {
            match ctx.stream {
                V.Bio(buf) => { for x in data { buf.push(*x); } }
                _ => {}
            }
        } else if ctx.write_mode == 2 {
            let text = decode(data, c.enc, false)?;
            match ctx.stream {
                V.Sio(buf) => buf.push_str(text),
                _ => {}
            }
        } else {
            return Err(exc("AttributeError", "'Context' object has no attribute 'stream_write'"));
        }
    } else if code == b'G' {
        copy_in(mut c, data, mut ctx)?;
    }
    Ok(())
}

fn copy_in(c: mut ref Conn, data: ref Vec[u8], ctx: mut ref Ctx) -> Result[(), Exc] {
    let is_binary = (data[0] as i8) != 0;
    match ctx.stream.clone() {
        V.None => return Err(interface_error("The 'stream' parameter is required for the COPY IN response. The 'stream' parameter can be an I/O stream or an iterable.")),
        V.Sio(text) => {
            if is_binary {
                return Err(interface_error("The COPY IN stream is binary, but the stream parameter is a text stream."));
            }
            let cs: Vec[char] = text.chars().collect();
            let mut at: i64 = 0;
            while at < cs.len() as i64 {
                let end = if at + 4096 < cs.len() as i64 { at + 4096 } else { cs.len() as i64 };
                let chunk = encode(char_slice(cs, at, end), c.enc)?;
                send_message(mut c, b'd', chunk)?;
                flush(mut c);
                at = end;
            }
            ctx.stream = V.Sio(String.new());
        }
        V.Bio(buf) => {
            let mut at: i64 = 0;
            while at < buf.len() as i64 {
                let end = if at + 8192 < buf.len() as i64 { at + 8192 } else { buf.len() as i64 };
                send_message(mut c, b'd', slice(buf, at, end))?;
                flush(mut c);
                at = end;
            }
        }
        V.List(items) => {
            for k in items {
                let b = match k {
                    V.Str(s) => {
                        if is_binary {
                            return Err(interface_error("The COPY IN stream is binary, but the stream parameter is an iterable with str type items."));
                        }
                        encode(s, c.enc)?
                    }
                    V.Bytes(b) => b.clone(),
                    V.BArr(b) => b.clone(),
                    _ => return Err(type_error(f"a bytes-like object is required, not '{type_name(k)}'")),
                };
                send_message(mut c, b'd', b)?;
                flush(mut c);
            }
        }
        _ => return Err(type_error(f"'{type_name(ctx.stream)}' object is not iterable")),
    }
    send_empty(mut c, b'c')?;
    send_empty(mut c, b'S')?;
    flush(mut c);
    Ok(())
}

fn read_message(c: mut ref Conn, ctx: mut ref Ctx, warns: mut ref Vec[String], nonces: mut ref i64) -> Result[u8, Exc] {
    let head = read(mut c, 5)?;
    let code = head[0];
    if not known_code(code) {
        return Err(exc("KeyError", py_bytes_repr(vec![code])));
    }
    let data = read(mut c, get_i32(head, 1) - 4)?;
    handle(mut c, code, data, mut ctx, mut warns, mut nonces)?;
    Ok(code)
}

fn handle_messages(c: mut ref Conn, ctx: mut ref Ctx, warns: mut ref Vec[String], nonces: mut ref i64) -> Result[(), Exc] {
    loop {
        let code = read_message(mut c, mut ctx, mut warns, mut nonces)?;
        if code == b'Z' {
            break;
        }
    }
    match ctx.error.take() {
        Some(e) => Err(e),
        None => Ok(()),
    }
}

fn param_bytes(opts: ref Vec[(String, V)], name: Str) -> Result[Option[Vec[u8]], Exc] {
    for (k, v) in opts {
        if k == name {
            return match v {
                V.Str(s) => Ok(Some(bytes_of(s))),
                V.None => Ok(None),
                V.Bytes(b) => Ok(Some(b.clone())),
                V.BArr(b) => Ok(Some(b.clone())),
                _ => Err(interface_error(f"The parameter {name} can't be of type {class_repr(v)}.")),
            };
        }
    }
    Ok(None)
}

fn connect(user: ref V, opts: ref Vec[(String, V)], ssl: ref V, data: own Vec[u8], warns: mut ref Vec[String], nonces: mut ref i64) -> Result[Conn, Exc] {
    if is_none(user) {
        return Err(interface_error("The 'user' connection parameter cannot be None"));
    }
    let mut all: Vec[(String, V)] = vec![("user".to_string(), user.clone())];
    for (k, v) in opts {
        all.push((k.clone(), v.clone()));
    }
    let mut init: Vec[(String, Vec[u8])] = Vec.new();
    for name in ["user", "database", "application_name", "replication"] {
        match param_bytes(all, name)? {
            Some(b) => init.push((name.to_string(), b)),
            None => {}
        }
    }
    let password = param_bytes(all, "password")?;
    let mut c = Conn {
        inp: data,
        pos: 0,
        out: Vec.new(),
        started: false,
        open: true,
        enc: ENC_UTF8,
        user: init[0].1.clone(),
        password: password,
        status: V.None,
        key: V.None,
        params: Vec.new(),
        notices: Vec.new(),
        notifications: Vec.new(),
        stmt_names: Vec.new(),
        scram: None,
        last: None,
    };
    let use_ssl = match ssl {
        V.Bool(b) => b,
        V.None => true,
        _ => true,
    };
    if use_ssl {
        let mut req = i32_bytes(8);
        append(mut req, i32_bytes(80877103));
        println(f"    > ssl-request {py_bytes_repr(req)}");
        let resp = if c.pos < c.inp.len() as i64 { c.pos += 1; c.inp[c.pos - 1] } else { 0 };
        if resp == b'S' {
            return Err(interface_error("TLS is not available in this port"));
        }
        if not is_none(ssl) {
            return Err(interface_error("Server refuses SSL"));
        }
    }
    let mut val = i32_bytes(196608);
    for (k, v) in init {
        append(mut val, bytes_of(k));
        val.push(0);
        append(mut val, v);
        val.push(0);
    }
    val.push(0);
    write(mut c, i32_bytes(val.len() as i64 + 4))?;
    write(mut c, val)?;
    flush(mut c);
    let mut ctx = ctx_new(None, V.None, None, Vec.new());
    let mut r: Result[(), Exc] = Ok(());
    loop {
        match read_message(mut c, mut ctx, mut warns, mut nonces) {
            Ok(code) => {
                if code == b'Z' or code == b'E' {
                    break;
                }
            }
            Err(e) => {
                r = Err(e);
                break;
            }
        }
    }
    if r.is_ok() {
        match ctx.error.take() {
            Some(e) => r = Err(e),
            None => {}
        }
    }
    match r {
        Ok(()) => {}
        Err(e) => {
            close(mut c)?;
            return Err(e);
        }
    }
    c.status = V.None;
    Ok(c)
}

// ---- native.to_statement ----

const ST_OUT: i64 = 0;
const ST_SQ: i64 = 1;
const ST_QI: i64 = 2;
const ST_ES: i64 = 3;
const ST_PN: i64 = 4;
const ST_CO: i64 = 5;
const ST_DQ: i64 = 6;

fn is_alnum(c: char) -> bool {
    is_alpha(c) or is_digit(c)
}

fn to_statement(query: Str) -> Result[(String, Vec[String]), Exc] {
    let cs: Vec[char] = query.chars().collect();
    let n = cs.len() as i64;
    let mut in_quote_escape = false;
    let mut placeholders: Vec[String] = Vec.new();
    let mut out = String.new();
    let mut state = ST_OUT;
    let mut prev: char = '\u{0}';
    let mut i: i64 = 0;
    while i < n {
        let c = cs[i];
        let has_next = i + 1 < n;
        let next: char = if has_next { cs[i + 1] } else { '\u{0}' };
        if state == ST_OUT {
            if c == '\'' {
                out.push(c);
                state = if prev == 'E' { ST_ES } else { ST_SQ };
            } else if c == '"' {
                out.push(c);
                state = ST_QI;
            } else if c == '-' {
                out.push(c);
                if prev == '-' {
                    state = ST_CO;
                }
            } else if c == '$' {
                out.push(c);
                if prev == '$' {
                    state = ST_DQ;
                }
            } else if c == ':' and not (has_next and (next == ':' or next == '=')) and prev != ':' {
                state = ST_PN;
                placeholders.push(String.new());
            } else {
                out.push(c);
            }
        } else if state == ST_SQ {
            if c == '\'' {
                if in_quote_escape {
                    in_quote_escape = false;
                } else if has_next and next == '\'' {
                    in_quote_escape = true;
                } else {
                    state = ST_OUT;
                }
            }
            out.push(c);
        } else if state == ST_QI {
            if c == '"' {
                state = ST_OUT;
            }
            out.push(c);
        } else if state == ST_ES {
            if c == '\'' and prev != '\\' {
                state = ST_OUT;
            }
            out.push(c);
        } else if state == ST_PN {
            let last = placeholders.len() - 1;
            placeholders[last].push(c);
            if not has_next or (not is_alnum(next) and next != '_') {
                state = ST_OUT;
                let name = placeholders[last].clone();
                let mut pidx: i64 = -1;
                let mut k: i64 = 0;
                while k < last as i64 {
                    if placeholders[k] == name {
                        pidx = k;
                        break;
                    }
                    k += 1;
                }
                if pidx >= 0 {
                    out.push_str(f"${pidx + 1}");
                    placeholders.pop();
                } else {
                    out.push_str(f"${placeholders.len()}");
                }
            }
        } else if state == ST_CO {
            out.push(c);
            if c == '\n' {
                state = ST_OUT;
            }
        } else if state == ST_DQ {
            out.push(c);
            if c == '$' and prev == '$' {
                state = ST_OUT;
            }
        }
        prev = c;
        i += 1;
    }
    for reserved in ["types", "stream"] {
        for p in placeholders {
            if p == reserved {
                return Err(interface_error(f"The name '{reserved}' can't be used as a placeholder because it's used for another purpose."));
            }
        }
    }
    Ok((out, placeholders))
}

fn make_vals(placeholders: ref Vec[String], args: ref Vec[(String, V)], missing_none: bool) -> Result[Vec[V], Exc] {
    let mut vals: Vec[V] = Vec.new();
    for p in placeholders {
        let mut found: Option[V] = None;
        for (k, v) in args {
            if k == p {
                found = Some(v.clone());
            }
        }
        match found {
            Some(v) => vals.push(v),
            None => {
                if missing_none {
                    vals.push(V.None);
                } else {
                    return Err(interface_error(f"There's a placeholder '{p}' in the query, but no matching keyword argument."));
                }
            }
        }
    }
    Ok(vals)
}

// ---- dbapi.convert_paramstyle ----

fn convert_paramstyle(style0: Str, query: Str, args: ref V) -> Result[V, Exc] {
    let mut style = style0.to_string();
    let cs: Vec[char] = query.chars().collect();
    let n = cs.len() as i64;
    let mut in_quote_escape = false;
    let mut in_param_escape = false;
    let mut placeholders: Vec[String] = Vec.new();
    let mut out = String.new();
    let mut param_idx: i64 = 0;
    let mut state = ST_OUT;
    let mut prev: char = '\u{0}';
    let mut i: i64 = 0;
    while i < n {
        let c = cs[i];
        let has_next = i + 1 < n;
        let next: char = if has_next { cs[i + 1] } else { '\u{0}' };
        let colon_param = c == ':' and not (has_next and (next == ':' or next == '=')) and prev != ':';
        if state == ST_OUT {
            if c == '\'' {
                out.push(c);
                state = if prev == 'E' { ST_ES } else { ST_SQ };
            } else if c == '"' {
                out.push(c);
                state = ST_QI;
            } else if c == '-' {
                out.push(c);
                if prev == '-' {
                    state = ST_CO;
                }
            } else if c == '$' {
                out.push(c);
                if prev == '$' {
                    state = ST_DQ;
                }
            } else if style == "qmark" and c == '?' {
                param_idx += 1;
                out.push_str(f"${param_idx}");
            } else if style == "numeric" and colon_param {
                out.push('$');
            } else if style == "named" and colon_param {
                state = ST_PN;
                placeholders.push(String.new());
            } else if style == "pyformat" and c == '%' and has_next and next == '(' {
                state = ST_PN;
                placeholders.push(String.new());
            } else if (style == "format" or style == "pyformat") and c == '%' {
                style = "format".to_string();
                if in_param_escape {
                    in_param_escape = false;
                    out.push(c);
                } else if has_next and next == '%' {
                    in_param_escape = true;
                } else if has_next and next == 's' {
                    state = ST_PN;
                    param_idx += 1;
                    out.push_str(f"${param_idx}");
                } else {
                    return Err(interface_error("Only %s and %% are supported in the query."));
                }
            } else {
                out.push(c);
            }
        } else if state == ST_SQ {
            if c == '\'' {
                if in_quote_escape {
                    in_quote_escape = false;
                } else if has_next and next == '\'' {
                    in_quote_escape = true;
                } else {
                    state = ST_OUT;
                }
            }
            out.push(c);
        } else if state == ST_QI {
            if c == '"' {
                state = ST_OUT;
            }
            out.push(c);
        } else if state == ST_ES {
            if c == '\'' and prev != '\\' {
                state = ST_OUT;
            }
            out.push(c);
        } else if state == ST_DQ {
            if c == '$' and prev == '$' {
                state = ST_OUT;
            }
            out.push(c);
        } else if state == ST_PN {
            if style == "named" {
                let last = placeholders.len() - 1;
                placeholders[last].push(c);
                if not has_next or (not is_alnum(next) and next != '_') {
                    state = ST_OUT;
                    named_slot(mut placeholders, mut out);
                }
            } else if style == "pyformat" {
                if prev == ')' and c == 's' {
                    state = ST_OUT;
                    named_slot(mut placeholders, mut out);
                } else if c == '(' or c == ')' {
                } else {
                    let last = placeholders.len() - 1;
                    placeholders[last].push(c);
                }
            } else if style == "format" {
                state = ST_OUT;
            }
        } else if state == ST_CO {
            out.push(c);
            if c == '\n' {
                state = ST_OUT;
            }
        }
        prev = c;
        i += 1;
    }
    let vals = if style == "numeric" or style == "qmark" or style == "format" {
        args.clone()
    } else {
        let mut vs: Vec[V] = Vec.new();
        for p in placeholders {
            match args {
                V.Dict(kv) => match dict_get(kv, V.Str(p.clone())) {
                    Some(v) => vs.push(v),
                    None => return Err(key_error(p)),
                },
                _ => return Err(type_error("tuple indices must be integers or slices, not str")),
            }
        }
        V.Tuple(vs)
    };
    Ok(V.Tuple(vec![V.Str(out), vals]))
}

fn named_slot(placeholders: mut ref Vec[String], out: mut ref String) {
    let last = placeholders.len() - 1;
    let name = placeholders[last].clone();
    let mut k: i64 = 0;
    while k < last as i64 {
        if placeholders[k] == name {
            out.push_str(f"${k + 1}");
            placeholders.pop();
            return;
        }
        k += 1;
    }
    out.push_str(f"${placeholders.len()}");
}

// ---- core: the simple, unnamed and named statement flows ----

fn send_parse(c: mut ref Conn, name: ref Vec[u8], statement: Str, oids: ref Vec[V]) -> Result[(), Exc] {
    let mut val = name.clone();
    append(mut val, encode(statement, c.enc)?);
    val.push(0);
    append(mut val, i16_bytes(oids.len() as i64));
    for oid in oids {
        match oid {
            V.Int(n) => append(mut val, i32_bytes(if n == -1 { 0 } else { n as i64 })),
            _ => return Err(exc("error", "required argument is not an integer")),
        }
    }
    send_message(mut c, b'P', val)?;
    send_empty(mut c, b'H')
}

fn send_describe(c: mut ref Conn, name: ref Vec[u8]) -> Result[(), Exc] {
    let mut val: Vec[u8] = vec![b'S'];
    append(mut val, name);
    send_message(mut c, b'D', val)?;
    send_empty(mut c, b'H')
}

fn send_bind(c: mut ref Conn, name: ref Vec[u8], params: ref Vec[Option[String]]) -> Result[(), Exc] {
    let mut val: Vec[u8] = vec![0];
    append(mut val, name);
    append(mut val, i16_bytes(0));
    append(mut val, i16_bytes(params.len() as i64));
    for p in params {
        match p {
            None => append(mut val, i32_bytes(-1)),
            Some(s) => {
                let b = encode(s, c.enc)?;
                append(mut val, i32_bytes(b.len() as i64));
                append(mut val, b);
            }
        }
    }
    append(mut val, i16_bytes(0));
    send_message(mut c, b'B', val)?;
    send_empty(mut c, b'H')
}

fn send_execute(c: mut ref Conn) -> Result[(), Exc] {
    let mut val: Vec[u8] = vec![0];
    append(mut val, i32_bytes(0));
    send_message(mut c, b'E', val)?;
    send_empty(mut c, b'H')
}

fn make_params(vals: ref Vec[V]) -> Result[Vec[Option[String]], Exc] {
    let mut out: Vec[Option[String]] = Vec.new();
    for v in vals {
        out.push(make_param(v)?);
    }
    Ok(out)
}

struct Env {
    warns: Vec[String],
    nonces: i64,
}

fn execute_simple(c: mut ref Conn, sql: Str, env: mut ref Env) -> Result[Ctx, Exc] {
    let mut ctx = ctx_new(Some(sql.to_string()), V.None, None, Vec.new());
    let mut q = encode(sql, c.enc)?;
    q.push(0);
    send_message(mut c, b'Q', q)?;
    flush(mut c);
    handle_messages(mut c, mut ctx, mut env.warns, mut env.nonces)?;
    Ok(ctx)
}

fn execute_unnamed(c: mut ref Conn, statement: Str, vals: ref Vec[V], oids: ref Vec[V], stream: own V, env: mut ref Env) -> Result[Ctx, Exc] {
    let mut ctx = ctx_new(Some(statement.to_string()), stream, None, Vec.new());
    let unnamed: Vec[u8] = vec![0];
    send_parse(mut c, unnamed, statement, oids)?;
    send_empty(mut c, b'S')?;
    flush(mut c);
    handle_messages(mut c, mut ctx, mut env.warns, mut env.nonces)?;
    send_describe(mut c, unnamed)?;
    send_empty(mut c, b'S')?;
    flush(mut c);
    let params = make_params(vals)?;
    send_bind(mut c, unnamed, params)?;
    handle_messages(mut c, mut ctx, mut env.warns, mut env.nonces)?;
    send_execute(mut c)?;
    send_empty(mut c, b'S')?;
    flush(mut c);
    handle_messages(mut c, mut ctx, mut env.warns, mut env.nonces)?;
    Ok(ctx)
}

struct Prepared {
    statement: String,
    placeholders: Vec[String],
    name: Vec[u8],
    cols: Option[Vec[V]],
    oids: Vec[i64],
    columns: Option[Vec[V]],
}

fn prepare(c: mut ref Conn, sql: Str, env: mut ref Env) -> Result[Prepared, Exc] {
    let (statement, placeholders) = to_statement(sql)?;
    let mut k: i64 = 0;
    let mut name: Vec[u8] = Vec.new();
    loop {
        name = bytes_of(f"pg8000_statement_{k}");
        name.push(0);
        let mut taken = false;
        for s in c.stmt_names {
            if *s == name {
                taken = true;
            }
        }
        if not taken {
            c.stmt_names.push(name.clone());
            break;
        }
        k += 1;
    }
    let none: Vec[V] = Vec.new();
    send_parse(mut c, name, statement, none)?;
    send_describe(mut c, name)?;
    send_empty(mut c, b'S')?;
    flush(mut c);
    let mut ctx = ctx_new(Some(statement.clone()), V.None, None, Vec.new());
    handle_messages(mut c, mut ctx, mut env.warns, mut env.nonces)?;
    Ok(Prepared { statement: statement, placeholders: placeholders, name: name, cols: ctx.columns, oids: ctx.oids, columns: None })
}

fn execute_named(c: mut ref Conn, ps: ref Prepared, params: ref Vec[Option[String]], env: mut ref Env) -> Result[Ctx, Exc] {
    let mut ctx = ctx_new(Some(ps.statement.clone()), V.None, ps.cols.clone(), ps.oids.clone());
    send_bind(mut c, ps.name, params)?;
    send_execute(mut c)?;
    send_empty(mut c, b'S')?;
    flush(mut c);
    handle_messages(mut c, mut ctx, mut env.warns, mut env.nonces)?;
    Ok(ctx)
}

fn close_prepared(c: mut ref Conn, name: ref Vec[u8], env: mut ref Env) -> Result[(), Exc] {
    let mut val: Vec[u8] = vec![b'S'];
    append(mut val, name);
    send_message(mut c, b'C', val)?;
    send_empty(mut c, b'H')?;
    send_empty(mut c, b'S')?;
    flush(mut c);
    let mut ctx = ctx_new(None, V.None, None, Vec.new());
    handle_messages(mut c, mut ctx, mut env.warns, mut env.nonces)?;
    let mut keep: Vec[Vec[u8]] = Vec.new();
    for s in c.stmt_names {
        if *s != *name {
            keep.push(s.clone());
        }
    }
    c.stmt_names = keep;
    Ok(())
}

// native.Connection.run
fn run(c: mut ref Conn, sql: Str, kw: ref Vec[(String, V)], env: mut ref Env) -> Result[Ctx, Exc] {
    let mut stream = V.None;
    let mut types = V.None;
    let mut params: Vec[(String, V)] = Vec.new();
    for (k, v) in kw {
        if k == "stream" {
            stream = v.clone();
        } else if k == "types" {
            types = v.clone();
        } else {
            params.push((k.clone(), v.clone()));
        }
    }
    if params.len() == 0 and is_none(stream) {
        return execute_simple(mut c, sql, mut env);
    }
    let (statement, placeholders) = to_statement(sql)?;
    let oids = match types {
        V.None => Vec.new(),
        V.Dict(kv) => {
            let mut pairs: Vec[(String, V)] = Vec.new();
            let mut i = 0;
            while i + 1 < kv.len() {
                pairs.push((pstr(kv[i]), kv[i + 1].clone()));
                i += 2;
            }
            make_vals(placeholders, pairs, true)?
        }
        _ => return Err(type_error("types must be a dict")),
    };
    let vals = make_vals(placeholders, params, false)?;
    execute_unnamed(mut c, statement, vals, oids, stream, mut env)
}

fn opt_list_repr(v: ref Option[Vec[V]]) -> String {
    match v {
        Some(xs) => f"[{repr_items(xs)}]",
        None => "None".to_string(),
    }
}

fn show_warnings(env: mut ref Env) {
    for w in env.warns {
        println(f"    warning {w}");
    }
    env.warns.clear();
}

fn session_op(c: mut ref Conn, op: Str, stmts: mut ref Vec[(String, Prepared)], env: mut ref Env) -> Result[(), Exc] {
    let words = split_top(op);
    let cmd = words[0].clone();
    if cmd == "run" {
        let sql = as_str(parse_value(words[1])?);
        let kw = kwargs(words, 2)?;
        let ctx = run(mut c, sql, kw, mut env)?;
        show_warnings(mut env);
        println(f"    rows {opt_list_repr(ctx.rows)}");
        println(f"    columns {opt_list_repr(ctx.columns)}");
        println(f"    row_count {ctx.row_count}");
        if sql.contains("TO STDOUT") {
            match ctx.stream.clone() {
                V.Bio(b) => println(f"    stream {py_bytes_repr(b)}"),
                V.Sio(s) => println(f"    stream {py_str_repr(s)}"),
                _ => {}
            }
        }
        c.last = Some(ctx);
    } else if cmd == "prepare" {
        let ps = prepare(mut c, as_str(parse_value(words[2])?), mut env)?;
        println(f"    name {py_bytes_repr(ps.name)} columns {opt_list_repr(ps.cols)}");
        stmts.push((words[1].clone(), ps));
    } else if cmd == "exec" {
        let kw = kwargs(words, 2)?;
        let mut idx: i64 = -1;
        let mut k: i64 = 0;
        while k < stmts.len() as i64 {
            if stmts[k].0 == words[1] {
                idx = k;
            }
            k += 1;
        }
        if idx < 0 {
            return Err(key_error(words[1]));
        }
        let vals = make_vals(stmts[idx].1.placeholders, kw, false)?;
        let params = make_params(vals)?;
        let ctx = execute_named(mut c, stmts[idx].1, params, mut env)?;
        stmts[idx].1.columns = ctx.columns.clone();
        println(f"    rows {opt_list_repr(ctx.rows)}");
        println(f"    columns {opt_list_repr(stmts[idx].1.columns)}");
    } else if cmd == "closestmt" {
        let mut name: Vec[u8] = Vec.new();
        let mut found = false;
        for (k, ps) in stmts {
            if k == words[1] {
                name = ps.name.clone();
                found = true;
            }
        }
        if not found {
            return Err(key_error(words[1]));
        }
        close_prepared(mut c, name, mut env)?;
    } else if cmd == "show" {
        println(f"    status {repr(c.status)} key {repr(c.key)}");
        println(f"    parameter_statuses {repr(V.Dict(c.params.clone()))}");
        println(f"    notices {repr(V.Deque(c.notices.clone()))}");
        println(f"    notifications {repr(V.Deque(c.notifications.clone()))}");
    } else if cmd == "close" {
        close(mut c)?;
    }
    Ok(())
}

fn take_opt(o: mut ref Vec[(String, V)], key: Str) -> Result[V, Exc] {
    let mut i: i64 = 0;
    while i < o.len() as i64 {
        if o[i].0 == key {
            let (_, v) = o.remove(i);
            return Ok(v);
        }
        i += 1;
    }
    Err(key_error(key))
}

fn run_session(name: Str, opts: ref Vec[String], ops: ref Vec[String], env: mut ref Env) -> Result[(), Exc] {
    let mut o = kwargs(opts, 0)?;
    let ssl = take_opt(mut o, "ssl")?;
    let user = take_opt(mut o, "user")?;
    let data = match fs.read_bytes(f"data/{name}.bin") {
        Ok(b) => b,
        Err(e) => return Err(exc("OSError", f"cannot read {name}.bin: {e}")),
    };
    let mut c = match connect(user, o, ssl, data, mut env.warns, mut env.nonces) {
        Ok(c) => c,
        Err(e) => {
            println(f"    error {show_exc(e)}");
            return Ok(());
        }
    };
    println("    connected");
    let mut stmts: Vec[(String, Prepared)] = Vec.new();
    for op in ops {
        println(f"  op {op}");
        match session_op(mut c, op, mut stmts, mut env) {
            Ok(()) => {}
            Err(e) => {
                show_warnings(mut env);
                println(f"    error {show_exc(e)}");
            }
        }
    }
    Ok(())
}

fn split_once(s: Str) -> (String, String) {
    match s.find(" ") {
        Some(i) => (s.substring(0, i), s.substring(i + 1, s.len())),
        None => (s.to_string(), String.new()),
    }
}

fn names_of(s: Str) -> Vec[String] {
    if s == "-" {
        return Vec.new();
    }
    split_char(s, ',')
}

fn run_job(job: Str, env: mut ref Env) -> Result[(), Exc] {
    let (kind, rest) = split_once(job);
    if kind == "stmt" {
        let (names, sql) = split_once(rest);
        let (statement, placeholders) = to_statement(as_str(parse_value(sql)?))?;
        println(f"    {py_str_repr(statement)}");
        let mut args: Vec[(String, V)] = Vec.new();
        for n in names_of(names) {
            args.push((n.clone(), V.Str(n.clone())));
        }
        let vals = make_vals(placeholders, args, false)?;
        println(f"    vals {repr(V.Tuple(vals))}");
    } else if kind == "style" {
        let (style, more) = split_once(rest);
        let (names, sql) = split_once(more);
        let ns = names_of(names);
        let args = if style == "named" or style == "pyformat" {
            let mut kv: Vec[V] = Vec.new();
            for n in ns {
                dict_put(mut kv, V.Str(n.clone()), V.Str(n.clone()));
            }
            V.Dict(kv)
        } else {
            let mut xs: Vec[V] = Vec.new();
            for n in ns {
                xs.push(V.Str(n.clone()));
            }
            V.Tuple(xs)
        };
        let r = convert_paramstyle(style, as_str(parse_value(sql)?), args)?;
        println(f"    {repr(r)}");
    } else if kind == "ident" {
        println(f"    {py_str_repr(identifier(parse_value(rest)?)?)}");
    } else if kind == "literal" {
        println(f"    {py_str_repr(literal(parse_value(rest)?)?)}");
    } else if kind == "out" {
        let v = make_param(parse_value(rest)?)?;
        match v {
            Some(s) => println(f"    {py_str_repr(s)}"),
            None => println("    None"),
        }
    } else if kind == "in" {
        let (oid, text) = split_once(rest);
        let v = pg_in(small_int(oid), as_str(parse_value(text)?), mut env.warns)?;
        show_warnings(mut env);
        println(f"    {repr(v)}");
    }
    Ok(())
}

// ---- main ----

fn unesc(s: ref String) -> String {
    let cs: Vec[char] = s.chars().collect();
    let mut out = String.new();
    let mut i: i64 = 0;
    while i < cs.len() as i64 {
        if cs[i] == '~' and i + 1 < cs.len() as i64 {
            let c = cs[i + 1];
            out.push(if c == 't' { '~' } else if c == 'b' { '\\' } else if c == 'q' { '"' } else if c == 'o' { '{' } else { '}' });
            i += 2;
        } else {
            out.push(cs[i]);
            i += 1;
        }
    }
    out
}

fn unrle(s: ref String) -> Vec[u8] {
    let cs: Vec[char] = s.chars().collect();
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i < cs.len() as i64 {
        if cs[i] == 'z' {
            let mut n: i64 = 0;
            i += 1;
            while cs[i] != '.' {
                n = n * 10 + hex_val(cs[i]);
                i += 1;
            }
            i += 1;
            let mut k: i64 = 0;
            while k < n {
                out.push(0);
                k += 1;
            }
        } else {
            out.push((hex_val(cs[i]) * 16 + hex_val(cs[i + 1])) as u8);
            i += 2;
        }
    }
    out
}

// Writes data/ from the copies embedded below; the jobs then read it back.
fn write_data() -> Result[(), String] {
    if let Err(e) = fs.create_dir_all("data") {
        return Err(f"cannot create data: {e}");
    }
    let mut jobs = String.new();
    for line in jobs_text().split("\n") {
        if line.len() > 0 {
            jobs.push_str(unesc(line.to_string()));
            jobs.push('\n');
        }
    }
    if let Err(e) = fs.write("data/jobs.txt", jobs) {
        return Err(f"cannot write jobs.txt: {e}");
    }
    for line in inputs_text().split("\n") {
        if line.len() == 0 {
            continue;
        }
        let (name, body) = split_once(line);
        if let Err(e) = fs.write_bytes(f"data/{name}", unrle(body)) {
            return Err(f"cannot write {name}: {e}");
        }
    }
    Ok(())
}

fn main() {
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    let text = match fs.read_to_string("data/jobs.txt") {
        Ok(t) => t,
        Err(e) => {
            eprintln(f"cannot read jobs.txt: {e}");
            return;
        }
    };
    let mut lines: Vec[String] = Vec.new();
    for l in text.split("\n") {
        if l.len() > 0 {
            lines.push(l.to_string());
        }
    }
    let mut env = Env { warns: Vec.new(), nonces: 0 };
    let mut i: i64 = 0;
    while i < lines.len() as i64 {
        let job = lines[i].clone();
        println(f"> {job}");
        if job.starts_with("session ") {
            let (_, rest) = split_once(job);
            let (name, opts) = split_once(rest);
            let mut j = i + 1;
            let mut ops: Vec[String] = Vec.new();
            while lines[j] != "end" {
                ops.push(lines[j].substring(3, lines[j].len()));
                j += 1;
            }
            match run_session(name, split_top(opts), ops, mut env) {
                Ok(()) => {}
                Err(e) => println(f"    error {show_exc(e)}"),
            }
            i = j + 1;
            continue;
        }
        match run_job(job, mut env) {
            Ok(()) => {}
            Err(e) => {
                show_warnings(mut env);
                println(f"    error {show_exc(e)}");
            }
        }
        i += 1;
    }
}

