// mini_exifread: ExifRead 3.5.1 (BSD-3-Clause, Gene Cash, Ianaré Sévi
// and contributors), the pure-Python EXIF reader behind many photo
// organisers and upload pipelines, ported module by module: the format
// finders of core/find_exif.py, core/jpeg.py, core/heic.py and core/jxl.py,
// ExifHeader with its IFD walker and maker-note decoders
// (core/exif_header.py), the tag formatters of tags/str_utils.py and
// tags/makernote, serialize.convert_types, utils.get_gps_coords and the
// command line of cli.py.
//
// The tag tables of exifread/tags are embedded by gen_kara.py as
// tables_text(), and the jobs (data/jobs.tsv, photo files written by
// mk.py) as jobs_text(). Each job prints "== " and its fields, then what
// the command line prints, or the GPS coordinates, or the extracted
// thumbnail; an exception the library lets escape prints as
// "error <Class>: <message>".
//
// No compiler gaps were hit.

// ------------------------------------------------------------ values

// A Python value as ExifRead holds it. Rat is utils.Ratio (a Fraction, kept
// unreduced when the denominator is zero), Tup the 1-tuple struct.unpack
// returns for a float, Str a decoded ASCII field and Bytes one that is not
// valid UTF-8.
#[derive(Clone)]
enum Val {
    Int(i64),
    Rat(i64, i64),
    Float(f64),
    Tup(Vec[Val]),
    Str(String),
    Bytes(Vec[u8]),
    List(Vec[Val]),
    Nil,
}

#[derive(Clone)]
struct Exc {
    kind: String,
    msg: String,
}

fn exc(kind: ref String, msg: ref String) -> Exc {
    Exc { kind: kind.to_string(), msg: msg.to_string() }
}

fn index_error(v: ref Val) -> Exc {
    match v {
        Val.Str(_) => exc("IndexError", "string index out of range"),
        Val.Bytes(_) => exc("IndexError", "index out of range"),
        _ => exc("IndexError", "list index out of range"),
    }
}

fn gcd(a: i64, b: i64) -> i64 {
    let mut x = if a < 0 { -a } else { a };
    let mut y = if b < 0 { -b } else { b };
    while y != 0 {
        let t = x % y;
        x = y;
        y = t;
    }
    x
}

// Ratio(n, d): reduced with the sign on the numerator, or kept as is when
// d is zero (Fraction raises ZeroDivisionError and Ratio catches it).
fn ratio(n: i64, d: i64) -> Val {
    if d == 0 {
        return Val.Rat(n, 0);
    }
    let mut g = gcd(n, d);
    if d < 0 {
        g = -g;
    }
    Val.Rat(n / g, d / g)
}

fn pymod(a: i64, m: i64) -> i64 {
    let r = a % m;
    if r != 0 and ((r < 0) != (m < 0)) { r + m } else { r }
}

fn float_repr(x: f64) -> String {
    if x != x {
        return "nan".to_string();
    }
    f"{x}"
}

fn hex_digit(n: u8) -> u8 {
    if n < 10 { b'0' + n } else { b'a' + n - 10 }
}

fn push_esc(out: mut ref Vec[u8], c: u32) {
    out.push(b'\\');
    out.push(b'x');
    out.push(hex_digit((c / 16) as u8));
    out.push(hex_digit((c % 16) as u8));
}

fn bytes_repr(b: ref Vec[u8]) -> String {
    let quote = if b.contains(b'\'') and not b.contains(b'"') { b'"' } else { b'\'' };
    let mut out: Vec[u8] = Vec.new();
    out.push(b'b');
    out.push(quote);
    for c in b.iter() {
        let c = *c;
        if c == quote or c == b'\\' {
            out.push(b'\\');
            out.push(c);
        } else if c == b'\t' {
            out.push(b'\\');
            out.push(b't');
        } else if c == b'\n' {
            out.push(b'\\');
            out.push(b'n');
        } else if c == b'\r' {
            out.push(b'\\');
            out.push(b'r');
        } else if c < 32 or c >= 127 {
            push_esc(mut out, c as u32);
        } else {
            out.push(c);
        }
    }
    out.push(quote);
    String.from_utf8(out).unwrap()
}

// The code points of a UTF-8 string, each with its bytes.
fn code_points(s: ref String) -> Vec[(u32, Vec[u8])] {
    let b = s.bytes().to_vec();
    let mut out: Vec[(u32, Vec[u8])] = Vec.new();
    let mut i: i64 = 0;
    while i < b.len() {
        let c = b[i];
        let n: i64 = if c < 0x80 { 1 } else if c < 0xE0 { 2 } else if c < 0xF0 { 3 } else { 4 };
        let mut cp: u32 = if n == 1 {
            c as u32
        } else if n == 2 {
            (c & 0x1F) as u32
        } else if n == 3 {
            (c & 0x0F) as u32
        } else {
            (c & 0x07) as u32
        };
        let mut k: i64 = 1;
        while k < n {
            cp = (cp << 6) | ((b[i + k] & 0x3F) as u32);
            k += 1;
        }
        out.push((cp, b[i..i + n].to_vec()));
        i += n;
    }
    out
}

fn char_len(s: ref String) -> i64 {
    let mut n: i64 = 0;
    for c in s.bytes() {
        if (c & 0xC0) != 0x80 {
            n += 1;
        }
    }
    n
}

// Python's str repr. Of the non-ASCII characters only those of Latin-1
// that Python does not print are escaped; the rest are taken as printable.
fn str_repr(s: ref String) -> String {
    let b = s.bytes().to_vec();
    let quote = if b.contains(b'\'') and not b.contains(b'"') { b'"' } else { b'\'' };
    let mut out: Vec[u8] = Vec.new();
    out.push(quote);
    for (cp, raw) in code_points(s).into_iter() {
        if cp == (quote as u32) or cp == 92 {
            out.push(b'\\');
            out.push(cp as u8);
        } else if cp == 9 {
            out.push(b'\\');
            out.push(b't');
        } else if cp == 10 {
            out.push(b'\\');
            out.push(b'n');
        } else if cp == 13 {
            out.push(b'\\');
            out.push(b'r');
        } else if cp < 32 or (cp >= 127 and cp <= 160) or cp == 173 {
            push_esc(mut out, cp);
        } else {
            for x in raw.iter() {
                out.push(*x);
            }
        }
    }
    out.push(quote);
    String.from_utf8(out).unwrap()
}

fn rat_str(n: i64, d: i64) -> String {
    if d == 1 { f"{n}" } else { f"{n}/{d}" }
}

fn join_repr(xs: ref Vec[Val]) -> String {
    let mut out = String.new();
    let mut first = true;
    for x in xs.iter() {
        if not first {
            out.push_str(", ");
        }
        first = false;
        out.push_str(repr(x));
    }
    out
}

fn repr(v: ref Val) -> String {
    match v {
        Val.Int(n) => f"{n}",
        Val.Rat(n, d) => rat_str(n, d),
        Val.Float(x) => float_repr(x),
        Val.Tup(xs) => {
            if xs.len() == 1 {
                let inner = repr(xs[0]);
                f"({inner},)"
            } else {
                let inner = join_repr(xs);
                f"({inner})"
            }
        }
        Val.Str(s) => str_repr(s),
        Val.Bytes(b) => bytes_repr(b),
        Val.List(xs) => {
            let inner = join_repr(xs);
            f"[{inner}]"
        }
        Val.Nil => "None".to_string(),
    }
}

fn str_of(v: ref Val) -> String {
    match v {
        Val.Str(s) => s.to_string(),
        _ => repr(v),
    }
}

fn type_name(v: ref Val) -> String {
    match v {
        Val.Int(_) => "int".to_string(),
        Val.Rat(_, _) => "Ratio".to_string(),
        Val.Float(_) => "float".to_string(),
        Val.Tup(_) => "tuple".to_string(),
        Val.Str(_) => "str".to_string(),
        Val.Bytes(_) => "bytes".to_string(),
        Val.List(_) => "list".to_string(),
        Val.Nil => "NoneType".to_string(),
    }
}

// The items `for x in v` yields: list elements, one-character strings, or
// the ints of a bytes object.
fn items(v: ref Val) -> Vec[Val] {
    match v {
        Val.List(xs) => xs.clone(),
        Val.Tup(xs) => xs.clone(),
        Val.Str(s) => {
            let mut out: Vec[Val] = Vec.new();
            for (_, raw) in code_points(s).into_iter() {
                out.push(Val.Str(String.from_utf8(raw).unwrap()));
            }
            out
        }
        Val.Bytes(b) => {
            let mut out: Vec[Val] = Vec.new();
            for c in b.iter() {
                out.push(Val.Int(*c as i64));
            }
            out
        }
        _ => Vec.new(),
    }
}

fn length(v: ref Val) -> i64 {
    match v {
        Val.List(xs) => xs.len(),
        Val.Tup(xs) => xs.len(),
        Val.Str(s) => char_len(s),
        Val.Bytes(b) => b.len(),
        _ => 0,
    }
}

fn index(v: ref Val, i: i64) -> Result[Val, Exc] {
    let xs = items(v);
    if i < xs.len() {
        Ok(xs[i].clone())
    } else {
        Err(index_error(v))
    }
}

// v[a:b] for 0 <= a, with Python's clamping.
fn slice(v: ref Val, a: i64, b: i64) -> Val {
    let n = length(v);
    let x = if a > n { n } else { a };
    let y = if b > n { n } else { b };
    match v {
        Val.Bytes(d) => {
            if x >= y { Val.Bytes(Vec.new()) } else { Val.Bytes(d[x..y].to_vec()) }
        }
        Val.Str(s) => {
            let mut out: Vec[u8] = Vec.new();
            let mut i: i64 = 0;
            for (_, raw) in code_points(s).into_iter() {
                if i >= x and i < y {
                    for c in raw.iter() {
                        out.push(*c);
                    }
                }
                i += 1;
            }
            Val.Str(String.from_utf8(out).unwrap())
        }
        _ => {
            let xs = items(v);
            let mut out: Vec[Val] = Vec.new();
            let mut i = x;
            while i < y {
                out.push(xs[i].clone());
                i += 1;
            }
            Val.List(out)
        }
    }
}

// The int a value equals, as a dict lookup or a list comparison sees it.
fn int_key(v: ref Val) -> Option[i64] {
    match v {
        Val.Int(n) => Some(n),
        Val.Rat(n, d) => if d == 1 { Some(n) } else { None },
        _ => None,
    }
}

fn ints_equal(v: ref Val, want: ref Vec[i64]) -> bool {
    match v {
        Val.List(xs) => {
            if xs.len() != want.len() {
                return false;
            }
            let mut i: i64 = 0;
            while i < xs.len() {
                match int_key(xs[i]) {
                    Some(n) => {
                        if n != want[i] {
                            return false;
                        }
                    }
                    None => return false,
                }
                i += 1;
            }
            true
        }
        _ => false,
    }
}

// ------------------------------------------------------------ bytes and text

fn starts(d: ref Vec[u8], p: ref String) -> bool {
    let pb = p.bytes().to_vec();
    if d.len() < pb.len() {
        return false;
    }
    let mut i: i64 = 0;
    while i < pb.len() {
        if d[i] != pb[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn same(a: ref Vec[u8], b: ref Vec[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut i: i64 = 0;
    while i < a.len() {
        if a[i] != b[i] {
            return false;
        }
        i += 1;
    }
    true
}

fn is_text(d: ref Vec[u8], p: ref String) -> bool {
    d.len() == p.len() and starts(d, p)
}

// d[a:b] for 0 <= a <= b, clamped.
fn sub(d: ref Vec[u8], a: i64, b: i64) -> Vec[u8] {
    let x = if a > d.len() { d.len() } else { a };
    let y = if b > d.len() { d.len() } else { b };
    if x >= y { Vec.new() } else { d[x..y].to_vec() }
}

fn byte_at(d: ref Vec[u8], i: i64) -> Result[i64, Exc] {
    if i >= 0 and i < d.len() {
        Ok(d[i] as i64)
    } else {
        Err(exc("IndexError", "index out of range"))
    }
}

fn hex(d: ref Vec[u8]) -> String {
    let mut out: Vec[u8] = Vec.new();
    for c in d.iter() {
        out.push(hex_digit(*c / 16));
        out.push(hex_digit(*c % 16));
    }
    String.from_utf8(out).unwrap()
}

fn hex_value(c: u8) -> u8 {
    if c >= b'0' and c <= b'9' { c - b'0' } else { c - b'a' + 10 }
}

fn unhex(s: ref String) -> Vec[u8] {
    let b = s.bytes().to_vec();
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < b.len() {
        out.push(hex_value(b[i]) * 16 + hex_value(b[i + 1]));
        i += 2;
    }
    out
}

// "%04X" % n for n >= 0
fn hex4(n: i64) -> String {
    let digits = "0123456789ABCDEF".bytes().to_vec();
    let mut v = n;
    let mut tmp: Vec[u8] = Vec.new();
    while v > 0 or tmp.len() < 4 {
        tmp.push(digits[v % 16]);
        v = v / 16;
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i = tmp.len() - 1;
    while i >= 0 {
        out.push(tmp[i]);
        i -= 1;
    }
    String.from_utf8(out).unwrap()
}

fn utf8_char(out: mut ref Vec[u8], c: i64) {
    if c < 128 {
        out.push(c as u8);
    } else {
        out.push((0xC0 | (c >> 6)) as u8);
        out.push((0x80 | (c & 63)) as u8);
    }
}

// str.strip(" \x00")
fn strip_sp_nul(s: ref String) -> String {
    let b = s.bytes().to_vec();
    let mut a: i64 = 0;
    let mut z = b.len();
    while a < z and (b[a] == b' ' or b[a] == 0) {
        a += 1;
    }
    while z > a and (b[z - 1] == b' ' or b[z - 1] == 0) {
        z -= 1;
    }
    String.from_utf8(b[a..z].to_vec()).unwrap()
}

// bytes.strip(chars)
fn strip_bytes(b: ref Vec[u8], chars: ref Vec[u8]) -> Vec[u8] {
    let mut a: i64 = 0;
    let mut z = b.len();
    while a < z and chars.contains(b[a]) {
        a += 1;
    }
    while z > a and chars.contains(b[z - 1]) {
        z -= 1;
    }
    b[a..z].to_vec()
}

fn is_py_space(cp: u32) -> bool {
    (cp >= 9 and cp <= 13) or (cp >= 28 and cp <= 32) or cp == 0x85 or cp == 0xA0 or cp == 0x1680
        or (cp >= 0x2000 and cp <= 0x200A) or cp == 0x2028 or cp == 0x2029 or cp == 0x202F
        or cp == 0x205F or cp == 0x3000
}

// str.strip()
fn strip_space(s: ref String) -> String {
    let cps = code_points(s);
    let mut a: i64 = 0;
    let mut z = cps.len();
    while a < z and is_py_space(cps[a].0) {
        a += 1;
    }
    while z > a and is_py_space(cps[z - 1].0) {
        z -= 1;
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i = a;
    while i < z {
        for c in cps[i].1.iter() {
            out.push(*c);
        }
        i += 1;
    }
    String.from_utf8(out).unwrap()
}

fn count_byte(s: ref String, c: u8) -> i64 {
    let mut n: i64 = 0;
    for x in s.bytes() {
        if x == c {
            n += 1;
        }
    }
    n
}

// s.replace(":", "-", limit), limit < 0 for all.
fn colons_to_dashes(s: ref String, limit: i64) -> String {
    let mut out: Vec[u8] = Vec.new();
    let mut done: i64 = 0;
    for x in s.bytes() {
        if x == b':' and (limit < 0 or done < limit) {
            out.push(b'-');
            done += 1;
        } else {
            out.push(x);
        }
    }
    String.from_utf8(out).unwrap()
}

fn ascii_upper(s: ref String) -> String {
    let mut out: Vec[u8] = Vec.new();
    for x in s.bytes() {
        if x >= b'a' and x <= b'z' {
            out.push(x - 32);
        } else {
            out.push(x);
        }
    }
    String.from_utf8(out).unwrap()
}

fn find_text(hay: ref String, needle: ref String, from: i64) -> i64 {
    let h = hay.bytes().to_vec();
    let n = needle.bytes().to_vec();
    let mut i = from;
    while i + n.len() <= h.len() {
        let mut k: i64 = 0;
        while k < n.len() and h[i + k] == n[k] {
            k += 1;
        }
        if k == n.len() {
            return i;
        }
        i += 1;
    }
    -1
}

fn ends_with(hay: ref String, needle: ref String) -> bool {
    let h = hay.len();
    let n = needle.len();
    h >= n and find_text(hay, needle, h - n) == h - n
}

fn is_word(c: u8) -> bool {
    (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z') or (c >= b'0' and c <= b'9') or c == b'_' or c >= 128
}

// re.search(r"\bWORD\b", s)
fn has_word(s: ref String, w: ref String) -> bool {
    let b = s.bytes().to_vec();
    let mut from: i64 = 0;
    loop {
        let i = find_text(s, w, from);
        if i < 0 {
            return false;
        }
        let j = i + w.len();
        let left = i == 0 or not is_word(b[i - 1]);
        let right = j == b.len() or not is_word(b[j]);
        if left and right {
            return true;
        }
        from = i + 1;
    }
}

// ------------------------------------------------------------ tag tables

const EXIF_TAGS: i64 = 0;
const NIKON_OLD: i64 = 3;
const NIKON_NEW: i64 = 4;
const OLYMPUS: i64 = 5;
const CASIO: i64 = 6;
const SONY: i64 = 7;
const FUJIFILM: i64 = 8;
const APPLE: i64 = 9;
const DJI: i64 = 10;
const CANON: i64 = 11;

// One tag of a table: its name and how its printable is made ("n" none,
// "d" a dict, "f" a function, "s" a sub-IFD with its own table).
#[derive(Clone)]
struct Def {
    name: String,
    kind: String,
    arg: i64,
    func: String,
    ifd_name: String,
}

struct Tables {
    tags: Vec[Map[i64, Def]],
    dicts: Vec[Map[i64, String]],
}

fn fields(line: ref String) -> Vec[String] {
    let mut f: Vec[String] = Vec.new();
    for x in line.split("\t") {
        f.push(x.to_string());
    }
    f
}

fn num(s: ref String) -> i64 {
    i64.parse(s.to_string()).unwrap()
}

fn load_tables() -> Tables {
    let mut tags: Vec[Map[i64, Def]] = Vec.new();
    let mut dicts: Vec[Map[i64, String]] = Vec.new();
    for line in tables_text().split("\n") {
        if line.is_empty() {
            continue;
        }
        let f = fields(line.to_string());
        if f[0] == "T" {
            let tid = num(f[1]);
            while tags.len() <= tid {
                tags.push(Map.new());
            }
            let mut d = Def { name: f[3].clone(), kind: f[4].clone(), arg: 0, func: String.new(), ifd_name: String.new() };
            if f[4] == "d" {
                d.arg = num(f[5]);
            } else if f[4] == "f" {
                d.func = f[5].clone();
            } else if f[4] == "s" {
                d.arg = num(f[5]);
                d.ifd_name = f[6].clone();
            }
            tags[tid].insert(num(f[2]), d);
        } else {
            let did = num(f[1]);
            while dicts.len() <= did {
                dicts.push(Map.new());
            }
            dicts[did].insert(num(f[2]), f[3].clone());
        }
    }
    Tables { tags: tags, dicts: dicts }
}

// tags/fields.py
fn type_length(t: i64) -> i64 {
    if t == 1 or t == 2 or t == 6 or t == 7 {
        1
    } else if t == 3 or t == 8 {
        2
    } else if t == 4 or t == 9 or t == 11 or t == 13 {
        4
    } else if t == 5 or t == 10 or t == 12 {
        8
    } else {
        0
    }
}

fn type_name_of(t: i64) -> String {
    let names = vec![
        "Proprietary", "Byte", "ASCII", "Short", "Long", "Ratio", "Signed Byte", "Undefined",
        "Signed Short", "Signed Long", "Signed Ratio", "Single-Precision Floating Point (32-bit)",
        "Double-Precision Floating Point (64-bit)", "IFD",
    ];
    names[t].to_string()
}

// ------------------------------------------------------------ the file

struct Fh {
    d: Vec[u8],
    pos: i64,
}

// BytesIO.read: a negative count reads to the end; reading at or past the
// end returns nothing and leaves the position where it was.
fn read(f: mut ref Fh, n: i64) -> Vec[u8] {
    if f.pos >= f.d.len() or n == 0 {
        return Vec.new();
    }
    let end = if n < 0 or f.pos + n > f.d.len() { f.d.len() } else { f.pos + n };
    let out = f.d[f.pos..end].to_vec();
    f.pos = end;
    out
}

fn le_uint(b: ref Vec[u8]) -> i64 {
    let mut v: i64 = 0;
    let mut i = b.len() - 1;
    while i >= 0 {
        v = (v << 8) | (b[i] as i64);
        i -= 1;
    }
    v
}

fn be_uint(b: ref Vec[u8]) -> i64 {
    let mut v: i64 = 0;
    for c in b.iter() {
        v = (v << 8) | (*c as i64);
    }
    v
}

// ------------------------------------------------------------ ExifHeader

#[derive(Clone)]
struct Tag {
    printable: String,
    tag: i64,
    ftype: i64,
    values: Val,
    field_offset: i64,
    field_length: i64,
    prefer: bool,
}

struct World {
    out: String,
    // heic.Box.subs: a class attribute, so shared by every box of every file.
    subs: Map[String, HBox],
}

fn log(w: mut ref World, msg: ref String) {
    w.out.push_str(msg);
    w.out.push_str("\n");
}

struct Hdr {
    fh: Fh,
    endian: u8,
    offset: i64,
    fake_exif: bool,
    strict: bool,
    detailed: bool,
    tags: Map[String, Tag],
    jpeg_thumb: Option[Vec[u8]],
}

fn s2n(h: mut ref Hdr, off: i64, length: i64, signed: bool, w: mut ref World) -> i64 {
    h.fh.pos = h.offset + off;
    let buf = read(mut h.fh, length);
    if buf.is_empty() {
        return 0;
    }
    if buf.len() != length {
        log(mut w, f"Unexpected slice length: {buf.len()}");
        return 0;
    }
    let v = if h.endian == b'I' { le_uint(buf) } else { be_uint(buf) };
    if signed {
        let top: i64 = 1 << (length * 8 - 1);
        if v >= top {
            return v - 2 * top;
        }
    }
    v
}

fn signed_type(t: i64) -> bool {
    t == 6 or t == 8 or t == 9 or t == 10
}

fn process_field(h: mut ref Hdr, tag_name: ref String, count: i64, ftype: i64, tl: i64, start: i64, w: mut ref World) -> Vec[Val] {
    let mut values: Vec[Val] = Vec.new();
    let signed = signed_type(ftype);
    let mut offset = start;
    if count < 1000 {
        let mut k: i64 = 0;
        while k < count {
            if ftype == 5 or ftype == 10 {
                let n = s2n(mut h, offset, 4, signed, mut w);
                let d = s2n(mut h, offset + 4, 4, signed, mut w);
                values.push(ratio(n, d));
            } else if ftype == 11 or ftype == 12 {
                h.fh.pos = h.offset + offset;
                let b = read(mut h.fh, tl);
                if b.len() == tl {
                    let bits = if h.endian == b'I' { le_uint(b) } else { be_uint(b) };
                    let x = if ftype == 11 { (bits as u32).bits_as_f32() as f64 } else { (bits as u64).bits_as_f64() };
                    values.push(Val.Tup(vec![Val.Float(x)]));
                } else {
                    log(mut w, f"Possibly corrupted field {tag_name}");
                }
            } else {
                values.push(Val.Int(s2n(mut h, offset, tl, signed, mut w)));
            }
            offset += tl;
            k += 1;
        }
    } else if tag_name == "MakerNote" or tag_name == "MakerNote Tag 0x000D" {
        let mut k: i64 = 0;
        while k < count {
            values.push(Val.Int(s2n(mut h, offset, tl, signed, mut w)));
            offset += tl;
            k += 1;
        }
    }
    values
}

fn process_ascii_field(h: mut ref Hdr, ifd_name: ref String, tag_name: ref String, count: i64, offset: i64, w: mut ref World) -> Val {
    if count == 0 {
        return Val.Str(String.new());
    }
    h.fh.pos = h.offset + offset;
    let raw = read(mut h.fh, count);
    let mut cut: Vec[u8] = Vec.new();
    for c in raw.iter() {
        if *c == 0 {
            break;
        }
        cut.push(*c);
    }
    match String.from_utf8(cut.clone()) {
        Ok(s) => Val.Str(s),
        Err(_) => {
            log(mut w, f"Possibly corrupted field {tag_name} in {ifd_name} IFD");
            Val.Bytes(cut)
        }
    }
}

// ------------------------------------------------------------ tag formatters

// tags/str_utils.make_string: keep the characters 32..255, else fall back
// to the values joined (or to str of the sequence), then strip " \x00".
fn make_string(seq: ref Val) -> String {
    match seq {
        Val.Str(s) => strip_sp_nul(s),
        Val.Bytes(b) => {
            let mut out: Vec[u8] = Vec.new();
            for c in b.iter() {
                if *c >= 32 {
                    utf8_char(mut out, *c as i64);
                }
            }
            if out.is_empty() {
                return strip_sp_nul(bytes_repr(b));
            }
            strip_sp_nul(String.from_utf8(out).unwrap())
        }
        Val.List(xs) => {
            let mut out: Vec[u8] = Vec.new();
            for x in xs.iter() {
                match x {
                    Val.Int(n) => {
                        if n >= 32 and n < 256 {
                            utf8_char(mut out, n);
                        }
                    }
                    _ => {}
                }
            }
            if out.is_empty() {
                let mut joined = String.new();
                for x in xs.iter() {
                    joined.push_str(str_of(x));
                }
                if not joined.is_empty() and count_byte(joined, b'0') == joined.len() {
                    return String.new();
                }
                return strip_sp_nul(joined);
            }
            strip_sp_nul(String.from_utf8(out).unwrap())
        }
        _ => strip_sp_nul(str_of(seq)),
    }
}

// tags/str_utils.make_string_uc: drop a valid 8-byte character-code prefix.
fn make_string_uc(seq: ref Val) -> String {
    match seq {
        Val.Str(_) => make_string(seq),
        _ => {
            let code = ascii_upper(make_string(slice(seq, 0, 8)));
            if code == "ASCII" or code == "UNICODE" or code == "JIS" or code == "" {
                make_string(slice(seq, 8, length(seq)))
            } else {
                make_string(seq)
            }
        }
    }
}

fn int_item(v: ref Val, i: i64) -> Result[i64, Exc] {
    match index(v, i)? {
        Val.Int(n) => Ok(n),
        Val.Str(_) => Err(exc("TypeError", "'>' not supported between instances of 'str' and 'int'")),
        other => {
            let tn = type_name(other);
            Err(exc("TypeError", f"unsupported operand type(s): '{tn}'"))
        }
    }
}

// tags/makernote/nikon.ev_bias
fn ev_bias(seq: ref Val) -> Result[String, Exc] {
    if length(seq) < 4 {
        return Ok(String.new());
    }
    if ints_equal(seq, vec![252, 1, 6, 0]) {
        return Ok("-2/3 EV".to_string());
    }
    if ints_equal(seq, vec![253, 1, 6, 0]) {
        return Ok("-1/2 EV".to_string());
    }
    if ints_equal(seq, vec![254, 1, 6, 0]) {
        return Ok("-1/3 EV".to_string());
    }
    if ints_equal(seq, vec![0, 1, 6, 0]) {
        return Ok("0 EV".to_string());
    }
    if ints_equal(seq, vec![2, 1, 6, 0]) {
        return Ok("+1/3 EV".to_string());
    }
    if ints_equal(seq, vec![3, 1, 6, 0]) {
        return Ok("+1/2 EV".to_string());
    }
    if ints_equal(seq, vec![4, 1, 6, 0]) {
        return Ok("+2/3 EV".to_string());
    }
    let mut i = int_item(seq, 0)?;
    if i == 0 {
        return Ok("0 EV".to_string());
    }
    let mut ret = String.new();
    if i > 127 {
        i = 256 - i;
        ret.push_str("-");
    } else {
        ret.push_str("+");
    }
    let step = int_item(seq, 2)?;
    if step == 0 {
        return Err(exc("ZeroDivisionError", "division by zero"));
    }
    let whole = (i as f64) / (step as f64);
    i = pymod(i, step);
    if whole != 0.0 {
        let ws = float_repr(whole);
        ret.push_str(f"{ws} ");
    }
    if i == 0 {
        ret.push_str("EV");
    } else {
        ret.push_str(str_of(ratio(i, step)));
        ret.push_str(" EV");
    }
    Ok(ret)
}

// tags/makernote/olympus.special_mode
fn special_mode(val: ref Val) -> Result[String, Exc] {
    if length(val) == 0 {
        return Ok(String.new());
    }
    let m1 = match int_key(index(val, 0)?) {
        Some(0) => "Normal",
        Some(1) => "Unknown",
        Some(2) => "Fast",
        Some(3) => "Panorama",
        _ => "Unknown",
    };
    let m2 = match int_key(index(val, 2)?) {
        Some(0) => "Non-panoramic",
        Some(1) => "Left to right",
        Some(2) => "Right to left",
        Some(3) => "Bottom to top",
        Some(4) => "Top to bottom",
        _ => "Unknown",
    };
    let seq = int_item(val, 1)?;
    Ok(f"{m1} - Sequence {seq} - {m2}")
}

// tags/makernote/canon.convert_temp
fn convert_temp(v: ref Val) -> Result[String, Exc] {
    match v {
        Val.Int(n) => {
            let c = n - 128;
            Ok(f"{c} C")
        }
        other => {
            let tn = type_name(other);
            Err(exc("TypeError", f"unsupported operand type(s) for -: '{tn}' and 'int'"))
        }
    }
}

fn call_func(name: ref String, values: ref Val) -> Result[String, Exc] {
    if name == "ms" {
        Ok(make_string(values))
    } else if name == "uc" {
        Ok(make_string_uc(values))
    } else if name == "ev" {
        ev_bias(values)
    } else if name == "sm" {
        special_mode(values)
    } else {
        convert_temp(values)
    }
}

// ------------------------------------------------------------ IFD walking

fn get_printable(h: mut ref Hdr, t: ref Tables, count: i64, values: ref Val, ftype: i64, def: ref Option[Def], stop: ref String, w: mut ref World) -> Result[(String, bool), Exc] {
    let is_str = match values {
        Val.Str(_) => true,
        _ => false,
    };
    let mut printable = if count == 1 and ftype != 2 {
        str_of(index(values, 0)?)
    } else if count > 50 and length(values) > 20 and not is_str {
        let head = repr(slice(values, 0, 20));
        let cut = head[0..head.len() - 1].to_string();
        f"{cut}, ... ]"
    } else {
        str_of(values)
    };
    let mut prefer = false;
    match def {
        Some(d) => {
            if d.kind != "n" {
                prefer = true;
                if d.kind == "f" {
                    printable = call_func(d.func, values)?;
                } else if d.kind == "s" {
                    match index(values, 0) {
                        Ok(v) => dump_ifd(mut h, t, v, d.ifd_name, d.arg, false, stop, mut w)?,
                        Err(_) => log(mut w, f"No values found for {d.ifd_name} SubIFD"),
                    }
                } else {
                    printable = String.new();
                    for v in items(values).into_iter() {
                        let hit = match int_key(v) {
                            Some(k) => t.dicts[d.arg].get(k),
                            None => None,
                        };
                        match hit {
                            Some(name) => printable.push_str(name),
                            None => printable.push_str(repr(v)),
                        }
                    }
                }
            }
        }
        None => {}
    }
    Ok((printable, prefer))
}

fn process_tag(h: mut ref Hdr, t: ref Tables, ifd: i64, ifd_name: ref String, def: ref Option[Def], entry: i64, tag: i64, tag_name: ref String, relative: bool, stop: ref String, w: mut ref World) -> Result[(), Exc] {
    let ftype = s2n(mut h, entry + 2, 2, false, mut w);
    if ftype == 0 or ftype > 13 {
        if h.strict {
            let hx = hex4(tag);
            return Err(exc("ValueError", f"Unknown field type {ftype} in tag 0x{hx}"));
        }
        return Ok(());
    }
    let tl = type_length(ftype);
    let count = s2n(mut h, entry + 4, 4, false, mut w);
    let mut offset = entry + 8;
    if count * tl > 4 {
        if relative {
            let tmp = s2n(mut h, offset, 4, false, mut w);
            offset = tmp + ifd - 8;
            if h.fake_exif {
                offset += 18;
            }
        } else {
            offset = s2n(mut h, offset, 4, false, mut w);
        }
    }
    let values = if ftype == 2 {
        process_ascii_field(mut h, ifd_name, tag_name, count, offset, mut w)
    } else {
        Val.List(process_field(mut h, tag_name, count, ftype, tl, offset, mut w))
    };
    let (printable, prefer) = get_printable(mut h, t, count, values, ftype, def, stop, mut w)?;
    let key = f"{ifd_name} {tag_name}";
    h.tags.insert(key, Tag {
        printable: printable,
        tag: tag,
        ftype: ftype,
        values: values,
        field_offset: offset,
        field_length: count * tl,
        prefer: prefer,
    });
    Ok(())
}

fn ignored(tag: i64) -> bool {
    tag == 0x02BC or tag == 0x927C or tag == 0x9286
}

fn dump_ifd(h: mut ref Hdr, t: ref Tables, at: ref Val, ifd_name: ref String, table: i64, relative: bool, stop: ref String, w: mut ref World) -> Result[(), Exc] {
    let ifd = match at {
        Val.Int(n) => n,
        _ => {
            log(mut w, f"Possibly corrupted IFD: {ifd_name}");
            return Ok(());
        }
    };
    let entries = s2n(mut h, ifd, 2, false, mut w);
    let mut i: i64 = 0;
    while i < entries {
        let entry = ifd + 2 + 12 * i;
        let tag = s2n(mut h, entry, 2, false, mut w);
        let def = match t.tags[table].get(tag) {
            Some(d) => Some(d.clone()),
            None => None,
        };
        let tag_name = match def {
            Some(ref d) => d.name.clone(),
            None => {
                let hx = hex4(tag);
                f"Tag 0x{hx}"
            }
        };
        if h.detailed or not ignored(tag) {
            process_tag(mut h, t, ifd, ifd_name, def, entry, tag, tag_name, relative, stop, mut w)?;
        }
        if tag_name == *stop {
            break;
        }
        i += 1;
    }
    Ok(())
}

fn next_ifd(h: mut ref Hdr, ifd: i64, w: mut ref World) -> i64 {
    let entries = s2n(mut h, ifd, 2, false, mut w);
    let nxt = s2n(mut h, ifd + 2 + 12 * entries, 4, false, mut w);
    if nxt == ifd { 0 } else { nxt }
}

fn list_ifd(h: mut ref Hdr, w: mut ref World) -> Vec[i64] {
    let mut i = s2n(mut h, 4, 4, false, mut w);
    let mut ifds: Vec[i64] = Vec.new();
    while i != 0 {
        if ifds.contains(i) {
            log(mut w, "IFD loop detected.");
            break;
        }
        ifds.push(i);
        i = next_ifd(mut h, i, mut w);
    }
    ifds
}

// ------------------------------------------------------------ thumbnails and maker notes

fn as_offset(v: ref Val) -> Result[i64, Exc] {
    match v {
        Val.Int(n) => Ok(n),
        Val.Rat(_, _) => Err(exc("TypeError", "'Ratio' object cannot be interpreted as an integer")),
        other => {
            let tn = type_name(other);
            Err(exc("TypeError", f"unsupported operand type(s) for +: 'int' and '{tn}'"))
        }
    }
}

fn tag_of(h: ref Hdr, key: ref String) -> Option[Tag] {
    match h.tags.get(key.to_string()) {
        Some(t) => Some(t.clone()),
        None => None,
    }
}

// ExifHeader.extract_jpeg_thumbnail. (extract_tiff_thumbnail starts by
// asking for a Compression printable of "Uncompressed TIFF", which the
// Compression table spells "Uncompressed", so it never runs.)
fn extract_jpeg_thumbnail(h: mut ref Hdr) -> Result[(), Exc] {
    let off = tag_of(h, "Thumbnail JPEGInterchangeFormat");
    let len = tag_of(h, "Thumbnail JPEGInterchangeFormatLength");
    match (off, len) {
        (Some(o), Some(l)) => {
            let at = as_offset(index(o.values, 0)?)?;
            h.fh.pos = h.offset + at;
            let size = as_offset(index(l.values, 0)?)?;
            h.jpeg_thumb = Some(read(mut h.fh, size));
        }
        _ => {}
    }
    if h.jpeg_thumb.is_none() {
        match tag_of(h, "MakerNote JPEGThumbnail") {
            Some(m) => {
                let at = as_offset(index(m.values, 0)?)?;
                h.fh.pos = h.offset + at;
                h.jpeg_thumb = Some(read(mut h.fh, m.field_length));
            }
            None => {}
        }
    }
    Ok(())
}

fn fake_tag(h: mut ref Hdr, name: ref String, val: own Val) {
    h.tags.insert(f"MakerNote {name}", Tag {
        printable: str_of(val),
        tag: 0,
        ftype: 0,
        values: val,
        field_offset: 0,
        field_length: 0,
        prefer: true,
    });
}

// ExifHeader._canon_decode_tag
fn canon_decode_tag(h: mut ref Hdr, t: ref Tables, value: ref Val, table: i64) -> Result[(), Exc] {
    let xs = items(value);
    let mut idx: i64 = 1;
    while idx < xs.len() {
        let x = xs[idx].clone();
        let (name, val) = match t.tags[table].get(idx) {
            None => ("Unknown".to_string(), x),
            Some(d) => {
                if d.kind == "f" {
                    (d.name.clone(), Val.Str(convert_temp(x)?))
                } else if d.kind == "d" {
                    let hit = match int_key(x) {
                        Some(k) => t.dicts[d.arg].get(k),
                        None => None,
                    };
                    match hit {
                        Some(s) => (d.name.clone(), Val.Str(s.clone())),
                        None => (d.name.clone(), Val.Str("Unknown".to_string())),
                    }
                } else {
                    (d.name.clone(), x)
                }
            }
        };
        fake_tag(mut h, name, val);
        idx += 1;
    }
    Ok(())
}

// tags/makernote/canon.CAMERA_INFO_*: (offset, name, size, func).
fn camera_info_map(model: ref String) -> Option[Vec[(i64, String, i64, String)]] {
    if ends_with(model, "EOS 5D") {
        return Some(vec![
            (23, "CameraTemperature".to_string(), 1, "ct".to_string()),
            (204, "DirectoryIndex".to_string(), 4, "sub".to_string()),
            (208, "FileIndex".to_string(), 2, "add".to_string()),
        ]);
    }
    if ends_with(model, "EOS 5D Mark II") {
        return Some(vec![
            (25, "CameraTemperature".to_string(), 1, "ct".to_string()),
            (443, "FileIndex".to_string(), 4, "add".to_string()),
            (455, "DirectoryIndex".to_string(), 4, "sub".to_string()),
        ]);
    }
    if ends_with(model, "EOS 5D Mark III") {
        return Some(vec![
            (27, "CameraTemperature".to_string(), 1, "ct".to_string()),
            (652, "FileIndex".to_string(), 4, "add".to_string()),
            (656, "FileIndex2".to_string(), 4, "add".to_string()),
            (664, "DirectoryIndex".to_string(), 4, "sub".to_string()),
            (668, "DirectoryIndex2".to_string(), 4, "sub".to_string()),
        ]);
    }
    if has_word(model, "600D") or has_word(model, "REBEL T3i") or has_word(model, "Kiss X5") {
        return Some(vec![
            (25, "CameraTemperature".to_string(), 1, "ct".to_string()),
            (475, "FileIndex".to_string(), 4, "add".to_string()),
            (487, "DirectoryIndex".to_string(), 4, "sub".to_string()),
        ]);
    }
    None
}

// ExifHeader._canon_decode_camera_info
fn canon_decode_camera_info(h: mut ref Hdr, info: ref Tag) -> Result[(), Exc] {
    let model = match tag_of(h, "Image Model") {
        Some(m) => m.printable,
        None => return Ok(()),
    };
    let fields = match camera_info_map(model) {
        Some(f) => f,
        None => return Ok(()),
    };
    if info.ftype != 1 and info.ftype != 7 {
        return Ok(());
    }
    let mut data: Vec[u8] = Vec.new();
    for v in items(info.values).into_iter() {
        match v {
            Val.Int(n) => data.push(n as u8),
            _ => {}
        }
    }
    for (offset, name, size, func) in fields.into_iter() {
        if data.len() < offset + size {
            continue;
        }
        let v = le_uint(data[offset..offset + size].to_vec());
        let tv = if func == "ct" {
            let c = v - 128;
            Val.Str(f"{c} C")
        } else if func == "add" {
            Val.Int(v + 1)
        } else {
            Val.Int(v - 1)
        };
        fake_tag(mut h, name, tv);
    }
    Ok(())
}

fn with_frame(h: mut ref Hdr, t: ref Tables, endian: u8, shift: i64, ifd: i64, table: i64, w: mut ref World) -> Result[(), Exc] {
    let e = h.endian;
    let o = h.offset;
    h.endian = endian;
    h.offset = o + shift;
    dump_ifd(mut h, t, Val.Int(ifd), "MakerNote", table, false, "UNDEF", mut w)?;
    h.endian = e;
    h.offset = o;
    Ok(())
}

// ExifHeader.decode_maker_note
fn decode_maker_note(h: mut ref Hdr, t: ref Tables, w: mut ref World) -> Result[(), Exc] {
    let note = tag_of(h, "EXIF MakerNote").unwrap();
    let make = tag_of(h, "Image Make").unwrap().printable;
    let fo = note.field_offset;
    if find_text(make, "NIKON", 0) >= 0 {
        if ints_equal(slice(note.values, 0, 7), vec![78, 105, 107, 111, 110, 0, 1]) {
            dump_ifd(mut h, t, Val.Int(fo + 8), "MakerNote", NIKON_OLD, false, "UNDEF", mut w)?;
        } else if ints_equal(slice(note.values, 0, 7), vec![78, 105, 107, 111, 110, 0, 2]) {
            let m = slice(note.values, 12, 14);
            if not ints_equal(m, vec![0, 42]) and not ints_equal(m, vec![42, 0]) {
                return Err(exc("ValueError", "Missing marker tag 42 in MakerNote."));
            }
            dump_ifd(mut h, t, Val.Int(fo + 18), "MakerNote", NIKON_NEW, true, "UNDEF", mut w)?;
        } else {
            dump_ifd(mut h, t, Val.Int(fo), "MakerNote", NIKON_NEW, false, "UNDEF", mut w)?;
        }
        return Ok(());
    }
    if make.starts_with("OLYMPUS") {
        dump_ifd(mut h, t, Val.Int(fo + 8), "MakerNote", OLYMPUS, false, "UNDEF", mut w)?;
    }
    if find_text(make, "CASIO", 0) >= 0 or find_text(make, "Casio", 0) >= 0 {
        dump_ifd(mut h, t, Val.Int(fo), "MakerNote", CASIO, false, "UNDEF", mut w)?;
        return Ok(());
    }
    if find_text(make, "SONY", 0) >= 0 {
        dump_ifd(mut h, t, Val.Int(fo), "MakerNote", SONY, false, "UNDEF", mut w)?;
        return Ok(());
    }
    if make == "FUJIFILM" {
        return with_frame(mut h, t, b'I', fo, 12, FUJIFILM, mut w);
    }
    if make == "Apple" and ints_equal(slice(note.values, 0, 10), vec![65, 112, 112, 108, 101, 32, 105, 79, 83, 0]) {
        let e = h.endian;
        return with_frame(mut h, t, e, fo + 14, 0, APPLE, mut w);
    }
    if make == "DJI" {
        return with_frame(mut h, t, b'I', fo, 0, DJI, mut w);
    }
    if make == "Canon" {
        dump_ifd(mut h, t, Val.Int(fo), "MakerNote", CANON, false, "UNDEF", mut w)?;
        let offset_tags: Vec[(i64, i64)] = vec![(0x0001, 12), (0x0002, 13), (0x0004, 14), (0x0012, 15), (0x0026, 16), (0x0093, 17)];
        for (tag_id, table) in offset_tags.into_iter() {
            let hx = hex4(tag_id);
            let key = f"MakerNote Tag 0x{hx}";
            match tag_of(h, key) {
                Some(tg) => {
                    canon_decode_tag(mut h, t, tg.values, table)?;
                    h.tags.remove(key);
                }
                None => {}
            }
        }
        match tag_of(h, "MakerNote Tag 0x000D") {
            Some(tg) => {
                canon_decode_camera_info(mut h, tg)?;
                h.tags.remove("MakerNote Tag 0x000D".to_string());
            }
            None => {}
        }
    }
    Ok(())
}

// ------------------------------------------------------------ HEIC and JPEG XL boxes (core/heic.py, core/jxl.py)

#[derive(Clone)]
struct HBox {
    name: String,
    size: i64,
    after: i64,
    pos: i64,
    version: i64,
    major_brand: Vec[u8],
    minor_version: i64,
    item_id: i64,
    item_type: Vec[u8],
    exif_infe: Option[i64],
    locs: Map[i64, Vec[(i64, i64)]],
}

fn new_box(name: ref String) -> HBox {
    HBox {
        name: name.to_string(),
        size: 0,
        after: 0,
        pos: 0,
        version: 0,
        major_brand: Vec.new(),
        minor_version: 0,
        item_id: 0,
        item_type: Vec.new(),
        exif_infe: None,
        locs: Map.new(),
    }
}

fn hget(f: mut ref Fh, n: i64) -> Result[Vec[u8], Exc] {
    let r = read(mut f, n);
    if r.is_empty() {
        return Err(exc("EOFError", ""));
    }
    if r.len() != n {
        let got = r.len();
        let at = f.pos;
        return Err(exc("BadSize", f"get(nbytes={n}) found {got} bytes at position {at}"));
    }
    Ok(r)
}

fn hget_n(f: mut ref Fh, n: i64) -> Result[i64, Exc] {
    Ok(be_uint(hget(mut f, n)?))
}

fn hget_int(f: mut ref Fh, size: i64) -> Result[i64, Exc] {
    if size == 2 or size == 4 or size == 8 {
        hget_n(mut f, size)
    } else if size == 0 {
        Ok(0)
    } else {
        Err(exc("BadSize", f"{size}"))
    }
}

fn ascii_check(b: ref Vec[u8]) -> Result[String, Exc] {
    let mut i: i64 = 0;
    while i < b.len() {
        if b[i] >= 128 {
            let hx = hex(b[i..i + 1].to_vec());
            return Err(exc("UnicodeDecodeError", f"'ascii' codec can't decode byte 0x{hx} in position {i}: ordinal not in range(128)"));
        }
        i += 1;
    }
    Ok(String.from_utf8(b.clone()).unwrap())
}

fn next_box(f: mut ref Fh) -> Result[HBox, Exc] {
    let pos = f.pos;
    let size = hget_n(mut f, 4)?;
    let kind = ascii_check(hget(mut f, 4)?)?;
    let mut b = new_box(kind);
    if size == 0 {
        return Err(exc("NotImplementedError", ""));
    }
    if size == 1 {
        let big = hget_n(mut f, 8)?;
        b.size = big - 16;
        b.after = pos + big;
    } else {
        b.size = size - 8;
        b.after = pos + size;
    }
    b.pos = f.pos;
    Ok(b)
}

fn has_parser(name: ref String) -> bool {
    name == "ftyp" or name == "meta" or name == "infe" or name == "iinf" or name == "iloc" or name == "hdlr"
        or name == "pitm" or name == "iref" or name == "idat" or name == "dinf" or name == "iprp"
}

fn get_full(f: mut ref Fh, b: mut ref HBox) -> Result[(), Exc] {
    let v = hget_n(mut f, 4)?;
    b.version = v >> 24;
    Ok(())
}

fn parse_inner(f: mut ref Fh, b: mut ref HBox, w: mut ref World) -> Result[(), Exc] {
    if b.name == "ftyp" {
        b.major_brand = hget(mut f, 4)?;
        b.minor_version = hget_n(mut f, 4)?;
        let mut size = b.size - 8;
        while size > 0 {
            hget(mut f, 4)?;
            size -= 4;
        }
    } else if b.name == "meta" {
        get_full(mut f, mut b)?;
        while f.pos < b.after {
            let mut s = next_box(mut f)?;
            if has_parser(s.name) {
                parse_inner(mut f, mut s, mut w)?;
                w.subs.insert(s.name.clone(), s.clone());
            }
            f.pos = s.after;
        }
    } else if b.name == "infe" {
        get_full(mut f, mut b)?;
        if b.version >= 2 {
            if b.version == 2 {
                b.item_id = hget_n(mut f, 2)?;
            } else if b.version == 3 {
                b.item_id = hget_n(mut f, 4)?;
            }
            hget_n(mut f, 2)?;
            b.item_type = hget(mut f, 4)?;
            loop {
                let c = hget(mut f, 1)?;
                if c[0] == 0 {
                    break;
                }
            }
        }
    } else if b.name == "iinf" {
        get_full(mut f, mut b)?;
        let count = hget_n(mut f, 2)?;
        b.exif_infe = None;
        let mut k: i64 = 0;
        while k < count {
            let infe = expect_parse(mut f, "infe", mut w)?;
            if is_text(infe.item_type, "Exif") {
                b.exif_infe = Some(infe.item_id);
                break;
            }
            k += 1;
        }
    } else if b.name == "iloc" {
        get_full(mut f, mut b)?;
        let s01 = hget_n(mut f, 1)?;
        let s23 = hget_n(mut f, 1)?;
        let offset_size = s01 >> 4;
        let length_size = s01 & 15;
        let base_offset_size = s23 >> 4;
        let index_size = s23 & 15;
        let count = if b.version < 2 {
            hget_n(mut f, 2)?
        } else if b.version == 2 {
            hget_n(mut f, 4)?
        } else {
            let v = b.version;
            return Err(exc("BoxVersion", f"(2, {v})"));
        };
        b.locs = Map.new();
        let mut k: i64 = 0;
        while k < count {
            let item_id = if b.version < 2 { hget_n(mut f, 2)? } else { hget_n(mut f, 4)? };
            if b.version == 1 or b.version == 2 {
                hget_n(mut f, 2)?;
            }
            hget_n(mut f, 2)?;
            hget_int(mut f, base_offset_size)?;
            let extent_count = hget_n(mut f, 2)?;
            let mut extents: Vec[(i64, i64)] = Vec.new();
            let mut e: i64 = 0;
            while e < extent_count {
                if (b.version == 1 or b.version == 2) and index_size > 0 {
                    hget_int(mut f, index_size)?;
                }
                let off = hget_int(mut f, offset_size)?;
                let len = hget_int(mut f, length_size)?;
                extents.push((off, len));
                e += 1;
            }
            b.locs.insert(item_id, extents);
            k += 1;
        }
    }
    Ok(())
}

fn expect_parse(f: mut ref Fh, name: ref String, w: mut ref World) -> Result[HBox, Exc] {
    loop {
        let mut b = next_box(mut f)?;
        if b.name == *name {
            if has_parser(b.name) {
                parse_inner(mut f, mut b, mut w)?;
            }
            f.pos = b.after;
            return Ok(b);
        }
        f.pos = b.after;
    }
}

fn assertion() -> Exc {
    exc("AssertionError", "")
}

fn heic_find_exif(f: mut ref Fh, w: mut ref World) -> Result[(i64, Vec[u8]), Exc] {
    let ftyp = expect_parse(mut f, "ftyp", mut w)?;
    let brand = ftyp.major_brand;
    if not (is_text(brand, "heic") or is_text(brand, "avif") or is_text(brand, "mif1")) or ftyp.minor_version != 0 {
        return Ok((0, Vec.new()));
    }
    expect_parse(mut f, "meta", mut w)?;
    let iinf = match w.subs.get("iinf".to_string()) {
        Some(b) => b.clone(),
        None => return Err(exc("KeyError", "'iinf'")),
    };
    let item_id = match iinf.exif_infe {
        Some(id) => id,
        None => return Ok((0, Vec.new())),
    };
    let iloc = match w.subs.get("iloc".to_string()) {
        Some(b) => b.clone(),
        None => return Err(exc("KeyError", "'iloc'")),
    };
    let extents = match iloc.locs.get(item_id) {
        Some(e) => e.clone(),
        None => return Err(exc("KeyError", f"{item_id}")),
    };
    if extents.len() != 1 {
        return Err(assertion());
    }
    f.pos = extents[0].0;
    let hoff = hget_n(mut f, 4)?;
    if hoff == 0 {
        return Ok((0, vec![b'?']));
    }
    if hoff < 6 {
        return Err(assertion());
    }
    let head = hget(mut f, hoff)?;
    if not is_text(head[head.len() - 6..head.len()].to_vec(), "Exif\x00\x00") {
        return Err(assertion());
    }
    let offset = f.pos;
    Ok((offset, read(mut f, 1)))
}

fn find_heic_tiff(f: mut ref Fh) -> Result[(i64, Vec[u8]), Exc] {
    let data = read(mut f, 4);
    let order = sub(data, 0, 2);
    if is_text(order, "II") or is_text(order, "MM") {
        if byte_at(data, 2)? == 42 and byte_at(data, 3)? == 0 {
            let offset = f.pos - 4;
            f.pos = offset;
            return Ok((offset, order));
        }
    }
    Err(exc("InvalidExif", "Exif pointer to zeros"))
}

fn jxl_find_exif(f: mut ref Fh, w: mut ref World) -> Result[(i64, Vec[u8]), Exc] {
    let ftyp = expect_parse(mut f, "ftyp", mut w)?;
    if not is_text(ftyp.major_brand, "jxl ") or ftyp.minor_version != 0 {
        return Err(assertion());
    }
    let ex = expect_parse(mut f, "Exif", mut w)?;
    let offset = ex.pos + 4;
    f.pos = offset - 8;
    if not starts(hget(mut f, 8)?, "Exif\x00\x00") {
        return Err(assertion());
    }
    Ok((offset, read(mut f, 1)))
}

// ------------------------------------------------------------ finding the TIFF header (core/find_exif.py, core/jpeg.py)

fn not_found(msg: ref String) -> Exc {
    exc("ExifNotFound", msg)
}

fn invalid(msg: ref String) -> Exc {
    exc("InvalidExif", msg)
}

fn find_webp_exif(f: mut ref Fh) -> Result[(i64, Vec[u8]), Exc] {
    let data = read(mut f, 5);
    if is_text(sub(data, 0, 4), "VP8X") and (byte_at(data, 4)? & 8) != 0 {
        f.pos += 13;
        loop {
            let d = read(mut f, 8);
            if d.len() != 8 {
                return Err(invalid("Invalid webp file chunk header."));
            }
            if is_text(sub(d, 0, 4), "EXIF") {
                f.pos += 6;
                let offset = f.pos;
                return Ok((offset, read(mut f, 1)));
            }
            f.pos += le_uint(sub(d, 4, 8));
        }
    }
    Err(not_found("Webp file does not have exif data."))
}

fn find_png_exif(f: mut ref Fh) -> Result[(i64, Vec[u8]), Exc] {
    f.pos = 8;
    loop {
        let d = read(mut f, 8);
        let chunk = sub(d, 4, 8);
        ascii_check(chunk)?;
        if chunk.is_empty() or is_text(chunk, "IEND") {
            break;
        }
        if is_text(chunk, "eXIf") {
            let offset = f.pos;
            return Ok((offset, read(mut f, 1)));
        }
        let size = be_uint(sub(d, 0, 4));
        f.pos = f.pos + size + 4;
    }
    Err(not_found("PNG file does not have exif data."))
}

fn increment_base(data: ref Vec[u8], base: i64) -> Result[i64, Exc] {
    Ok(byte_at(data, base + 2)? * 256 + byte_at(data, base + 3)? + 2)
}

fn get_base(start: i64, data: ref Vec[u8]) -> Result[i64, Exc] {
    let mut base = start;
    loop {
        let m = sub(data, base, base + 2);
        let marker = if m.len() == 2 and m[0] == 0xFF { m[1] as i64 } else { -1 };
        if marker == 0xE1 {
            if is_text(sub(data, base + 4, base + 8), "Exif") {
                base -= 2;
                break;
            }
            base += increment_base(data, base)?;
        } else if marker == 0xE0 or marker == 0xE2 or marker == 0xEE or marker == 0xD8 or marker == 0xEC {
            base += increment_base(data, base)?;
        } else if marker == 0xDB {
            break;
        } else {
            match increment_base(data, base) {
                Ok(i) => base += i,
                Err(_) => return Err(invalid("Unexpected/unhandled segment type or file content.")),
            }
        }
    }
    Ok(base)
}

fn find_jpeg_exif(f: mut ref Fh, head: ref Vec[u8]) -> Result[(i64, Vec[u8], bool), Exc] {
    let mut data = head.clone();
    let mut base: i64 = 2;
    let mut fake = false;
    byte_at(data, 2)?;
    byte_at(data, 3)?;
    loop {
        if byte_at(data, 2)? != 0xFF {
            break;
        }
        let code = sub(data, 6, 10);
        if not (is_text(code, "JFIF") or is_text(code, "JFXX") or is_text(code, "OLYM") or is_text(code, "Phot")) {
            break;
        }
        let length = byte_at(data, 4)? * 256 + byte_at(data, 5)?;
        read(mut f, length - 8);
        let mut next: Vec[u8] = vec![0xFF, 0x00];
        for c in read(mut f, 10).iter() {
            next.push(*c);
        }
        data = next;
        fake = true;
        if base > 2 {
            base = base + length + 4 - 2;
        } else {
            base = length + 4;
        }
    }
    f.pos = 0;
    let data = read(mut f, base + 4000);
    let base = get_base(base, data)?;
    f.pos = base + 12;
    let c = byte_at(data, 2 + base)?;
    if c == 0xFF and (is_text(sub(data, 6 + base, 10 + base), "Exif") or is_text(sub(data, 6 + base, 11 + base), "Ducky")
        or is_text(sub(data, 6 + base, 11 + base), "Adobe")) {
        let offset = f.pos;
        return Ok((offset, read(mut f, 1), fake));
    }
    Err(invalid("No EXIF header expected"))
}

fn determine_type(f: mut ref Fh, w: mut ref World) -> Result[(i64, Vec[u8], bool), Exc] {
    let data = read(mut f, 12);
    let two = sub(data, 0, 2);
    let brand = sub(data, 4, 12);
    if is_text(two, "II") or is_text(two, "MM") {
        f.pos = 0;
        let endian = read(mut f, 1);
        read(mut f, 1);
        return Ok((0, endian, false));
    }
    if is_text(brand, "ftypheic") or is_text(brand, "ftypavif") or is_text(brand, "ftypmif1") {
        f.pos = 0;
        let (offset, endian) = heic_find_exif(mut f, mut w)?;
        if offset == 0 {
            let (o2, e2) = find_heic_tiff(mut f)?;
            return Ok((o2, e2, false));
        }
        return Ok((offset, endian, false));
    }
    if is_text(sub(data, 0, 4), "RIFF") and is_text(sub(data, 8, 12), "WEBP") {
        let (offset, endian) = find_webp_exif(mut f)?;
        return Ok((offset, endian, false));
    }
    if two.len() == 2 and two[0] == 0xFF and two[1] == 0xD8 {
        return find_jpeg_exif(mut f, data);
    }
    if same(sub(data, 0, 8), vec![0x89, b'P', b'N', b'G', 13, 10, 0x1A, 10]) {
        let (offset, endian) = find_png_exif(mut f)?;
        return Ok((offset, endian, false));
    }
    if same(data, vec![0, 0, 0, 12, b'J', b'X', b'L', b' ', 13, 10, 0x87, 10]) {
        f.pos = 0;
        let (offset, endian) = jxl_find_exif(mut f, mut w)?;
        if offset > 0 {
            return Ok((offset, endian, false));
        }
        return Err(not_found("JPEG XL file does not have exif data."));
    }
    Err(not_found("File format not recognized."))
}

// ------------------------------------------------------------ process_file (exifread/__init__.py)

struct Opts {
    detailed: bool,
    strict: bool,
    builtin: bool,
    stop: String,
}

fn process_file(data: ref Vec[u8], o: ref Opts, t: ref Tables, w: mut ref World) -> Result[Option[Hdr], Exc] {
    let mut f = Fh { d: data.clone(), pos: 0 };
    let (offset, endian_bytes, fake) = match determine_type(mut f, mut w) {
        Ok(x) => x,
        Err(e) => {
            if e.kind == "ExifNotFound" {
                log(mut w, e.msg);
                return Ok(None);
            }
            if e.kind == "InvalidExif" {
                return Ok(None);
            }
            return Err(e);
        }
    };
    let endian = byte_at(endian_bytes, 0)? as u8;
    let mut h = Hdr {
        fh: f,
        endian: endian,
        offset: offset,
        fake_exif: fake,
        strict: o.strict,
        detailed: o.detailed,
        tags: Map.new(),
        jpeg_thumb: None,
    };
    let mut thumb_ifd: i64 = 0;
    let mut ctr: i64 = 0;
    for ifd in list_ifd(mut h, mut w).into_iter() {
        let name = if ctr == 0 {
            "Image".to_string()
        } else if ctr == 1 {
            thumb_ifd = ifd;
            "Thumbnail".to_string()
        } else {
            f"IFD {ctr}"
        };
        dump_ifd(mut h, t, Val.Int(ifd), name, EXIF_TAGS, false, o.stop, mut w)?;
        ctr += 1;
    }
    match tag_of(h, "Image ExifOffset") {
        Some(tg) => {
            let at = index(tg.values, 0)?;
            dump_ifd(mut h, t, at, "EXIF", EXIF_TAGS, false, o.stop, mut w)?;
        }
        None => {}
    }
    if o.detailed {
        match tag_of(h, "Image SubIFDs") {
            Some(tg) => {
                let mut i: i64 = 0;
                for at in items(tg.values).into_iter() {
                    dump_ifd(mut h, t, at, f"EXIF SubIFD{i}", EXIF_TAGS, false, o.stop, mut w)?;
                    i += 1;
                }
            }
            None => {}
        }
    }
    if o.detailed and h.tags.contains_key("EXIF MakerNote".to_string()) and h.tags.contains_key("Image Make".to_string()) {
        match decode_maker_note(mut h, t, mut w) {
            Ok(_) => {}
            Err(e) => {
                if e.kind != "ValueError" or o.strict {
                    return Err(e);
                }
            }
        }
    }
    if thumb_ifd != 0 and o.detailed {
        extract_jpeg_thumbnail(mut h)?;
    }
    Ok(Some(h))
}

// ------------------------------------------------------------ serialize.convert_types

fn to_bytes(xs: ref Vec[Val]) -> Result[Vec[u8], Exc] {
    let mut out: Vec[u8] = Vec.new();
    for x in xs.iter() {
        match x {
            Val.Int(n) => {
                if n < 0 or n > 255 {
                    return Err(exc("ValueError", "bytes must be in range(0, 256)"));
                }
                out.push(n as u8);
            }
            other => {
                let tn = type_name(other);
                return Err(exc("TypeError", f"'{tn}' object cannot be interpreted as an integer"));
            }
        }
    }
    Ok(out)
}

fn decoded(b: own Vec[u8]) -> Val {
    if b.is_empty() {
        return Val.Nil;
    }
    match String.from_utf8(b.clone()) {
        Ok(s) => Val.Str(s),
        Err(_) => Val.Bytes(b),
    }
}

fn convert_bytes(name: ref String, values: ref Val, gps_version: bool) -> Result[Val, Exc] {
    let xs = items(values);
    if xs.len() == 1 {
        return Ok(xs[0].clone());
    }
    if gps_version and name == "GPS GPSVersionID" {
        let mut out = String.new();
        let mut first = true;
        for x in xs.iter() {
            if not first {
                out.push_str(".");
            }
            first = false;
            out.push_str(str_of(x));
        }
        return Ok(Val.Str(out));
    }
    let b = to_bytes(xs)?;
    Ok(decoded(strip_bytes(b, vec![b' ', 0])))
}

fn convert_ascii(name: ref String, values: ref Val) -> Result[Val, Exc] {
    match values {
        Val.Str(s) => {
            let mut out = s.to_string();
            if find_text(name, "DateTime", 0) >= 0 and char_len(out) == 19 and count_byte(out, b':') == 4 {
                out = colons_to_dashes(out, 2);
            } else if name == "GPS GPSDate" and char_len(out) == 10 and count_byte(out, b':') == 2 {
                out = colons_to_dashes(out, -1);
            }
            let out = strip_space(out);
            if out.is_empty() { Ok(Val.Nil) } else { Ok(Val.Str(out)) }
        }
        Val.Bytes(b) => {
            if (find_text(name, "DateTime", 0) >= 0 and b.len() == 19) or (name == "GPS GPSDate" and b.len() == 10) {
                return Err(exc("TypeError", "argument should be integer or bytes-like object, not 'str'"));
            }
            Ok(decoded(strip_bytes(b, vec![b' ', 9, 10, 11, 12, 13])))
        }
        other => Ok(other.clone()),
    }
}

fn convert_numeric(values: ref Val) -> Val {
    let xs = items(values);
    if xs.is_empty() {
        Val.Nil
    } else if xs.len() == 1 {
        xs[0].clone()
    } else {
        Val.List(xs)
    }
}

fn convert_ratio(values: ref Val) -> Val {
    let mut out: Vec[Val] = Vec.new();
    for x in items(values).into_iter() {
        match x {
            Val.Rat(n, d) => {
                let f = if d == 0 { n as f64 } else { (n as f64) / (d as f64) };
                if f == f.floor() {
                    out.push(Val.Int(f as i64));
                } else {
                    out.push(Val.Float(f));
                }
            }
            other => out.push(other),
        }
    }
    if out.is_empty() {
        Val.Nil
    } else if out.len() == 1 {
        out[0].clone()
    } else {
        Val.List(out)
    }
}

fn convert_tag(name: ref String, tg: ref Tag) -> Result[Val, Exc] {
    let ft = tg.ftype;
    if tg.prefer or ft == 0 {
        if tg.printable.is_empty() or tg.printable == "[]" {
            return Ok(Val.Nil);
        }
        return Ok(Val.Str(tg.printable.clone()));
    }
    if ft == 1 or ft == 13 {
        convert_bytes(name, tg.values, true)
    } else if ft == 2 {
        convert_ascii(name, tg.values)
    } else if ft == 5 or ft == 10 {
        Ok(convert_ratio(tg.values))
    } else if ft == 7 {
        convert_bytes(name, tg.values, false)
    } else {
        Ok(convert_numeric(tg.values))
    }
}

fn sorted_keys(h: ref Hdr) -> Vec[String] {
    let mut keys: Vec[String] = Vec.new();
    for (k, _) in h.tags.iter() {
        keys.push(k.clone());
    }
    keys.sort();
    keys
}

fn convert_types(h: ref Hdr) -> Result[Map[String, Val], Exc] {
    let mut out: Map[String, Val] = Map.new();
    for k in sorted_keys(h).into_iter() {
        let tg = h.tags.get(k.clone()).unwrap().clone();
        let v = convert_tag(k, tg)?;
        out.insert(k, v);
    }
    Ok(out)
}

// ------------------------------------------------------------ utils.get_gps_coords

const LAT: Str = "GPS GPSLatitude";
const LAT_REF: Str = "GPS GPSLatitudeRef";
const LNG: Str = "GPS GPSLongitude";
const LNG_REF: Str = "GPS GPSLongitudeRef";

fn degrees_to_decimal(xs: ref Vec[f64]) -> Result[f64, Exc] {
    let n = xs.len();
    if n == 0 {
        return Err(exc("TypeError", "_degrees_to_decimal() missing 3 required positional arguments: 'degrees', 'minutes', and 'seconds'"));
    }
    if n == 1 {
        return Err(exc("TypeError", "_degrees_to_decimal() missing 2 required positional arguments: 'minutes' and 'seconds'"));
    }
    if n == 2 {
        return Err(exc("TypeError", "_degrees_to_decimal() missing 1 required positional argument: 'seconds'"));
    }
    if n > 3 {
        return Err(exc("TypeError", f"_degrees_to_decimal() takes 3 positional arguments but {n} were given"));
    }
    Ok(xs[0] + xs[1] / 60.0 + xs[2] / 3600.0)
}

fn decimals(v: ref Val) -> Result[Vec[f64], Exc] {
    let mut out: Vec[f64] = Vec.new();
    for c in items(v).into_iter() {
        match c {
            Val.Rat(n, d) => {
                if d == 0 {
                    return Err(exc("ZeroDivisionError", "division by zero"));
                }
                out.push((n as f64) / (d as f64));
            }
            other => {
                let tn = type_name(other);
                return Err(exc("AttributeError", f"'{tn}' object has no attribute 'decimal'"));
            }
        }
    }
    Ok(out)
}

fn plain_numbers(v: ref Val) -> Vec[f64] {
    let mut out: Vec[f64] = Vec.new();
    for c in items(v).into_iter() {
        match c {
            Val.Int(n) => out.push(n as f64),
            Val.Float(x) => out.push(x),
            _ => {}
        }
    }
    out
}

fn is_text_val(v: ref Val, s: ref String) -> bool {
    match v {
        Val.Str(x) => x == *s,
        _ => false,
    }
}

fn finish_coords(lat_c: ref Vec[f64], lat_ref: ref Val, lng_c: ref Vec[f64], lng_ref: ref Val) -> Result[String, Exc] {
    let mut lat = degrees_to_decimal(lat_c)?;
    if is_text_val(lat_ref, "S") {
        lat *= -1.0;
    }
    let mut lng = degrees_to_decimal(lng_c)?;
    if is_text_val(lng_ref, "W") {
        lng *= -1.0;
    }
    let a = float_repr(lat);
    let b = float_repr(lng);
    Ok(f"({a}, {b})")
}

fn gps_coords(h: ref Hdr) -> Result[String, Exc] {
    for k in vec![LAT.clone(), LAT_REF.clone(), LNG.clone(), LNG_REF.clone()].iter() {
        if not h.tags.contains_key(k.to_string()) {
            return Ok("None".to_string());
        }
    }
    let lat_c = decimals(h.tags.get(LAT.to_string()).unwrap().values)?;
    let lng_c = decimals(h.tags.get(LNG.to_string()).unwrap().values)?;
    let lat_ref = h.tags.get(LAT_REF.to_string()).unwrap().values.clone();
    let lng_ref = h.tags.get(LNG_REF.to_string()).unwrap().values.clone();
    finish_coords(lat_c, lat_ref, lng_c, lng_ref)
}

// The same on serialized tags: lists pass through, anything else is asked
// for its .values.
fn gps_coords_builtin(d: ref Map[String, Val]) -> Result[String, Exc] {
    for k in vec![LAT.clone(), LAT_REF.clone(), LNG.clone(), LNG_REF.clone()].iter() {
        if not d.contains_key(k.to_string()) {
            return Ok("None".to_string());
        }
    }
    let lat = d.get(LAT.to_string()).unwrap().clone();
    match lat {
        Val.List(_) => {}
        other => {
            let tn = type_name(other);
            return Err(exc("AttributeError", f"'{tn}' object has no attribute 'values'"));
        }
    }
    let lng = d.get(LNG.to_string()).unwrap().clone();
    let lat_ref = d.get(LAT_REF.to_string()).unwrap().clone();
    let lng_ref = d.get(LNG_REF.to_string()).unwrap().clone();
    finish_coords(plain_numbers(lat), lat_ref, plain_numbers(lng), lng_ref)
}

// ------------------------------------------------------------ the jobs (cli.py)

fn options(flags: ref String) -> Opts {
    let mut o = Opts { detailed: true, strict: false, builtin: false, stop: String.new() };
    if flags == "-" {
        return o;
    }
    for f in flags.split(",") {
        if f == "q" {
            o.detailed = false;
        } else if f == "s" {
            o.strict = true;
        } else if f == "b" {
            o.builtin = true;
        } else {
            o.stop = f[2..].to_string();
        }
    }
    o
}

fn cli(o: ref Opts, name: ref String, data: ref Vec[u8], t: ref Tables, w: mut ref World) -> Result[(), Exc] {
    log(mut w, f"Opening: {name}");
    let found = match process_file(data, o, t, mut w)? {
        Some(h) => {
            if h.tags.is_empty() and h.jpeg_thumb.is_none() { None } else { Some(h) }
        }
        None => None,
    };
    let h = match found {
        Some(h) => h,
        None => {
            log(mut w, "No EXIF information found");
            log(mut w, "");
            return Ok(());
        }
    };
    let conv = if o.builtin { Some(convert_types(h)?) } else { None };
    if h.jpeg_thumb.is_some() {
        log(mut w, "File has JPEG thumbnail");
    }
    for k in sorted_keys(h).into_iter() {
        match conv {
            Some(ref c) => {
                let v = c.get(k.clone()).unwrap();
                let tn = type_name(v);
                let r = repr(v);
                log(mut w, f"{k} ({tn}): {r}");
            }
            None => {
                let tg = h.tags.get(k.clone()).unwrap();
                let tn = type_name_of(tg.ftype);
                let p = tg.printable.clone();
                log(mut w, f"{k} ({tn}): {p}");
            }
        }
    }
    log(mut w, "");
    Ok(())
}

fn run_job(f: ref Vec[String], t: ref Tables, w: mut ref World) -> Result[(), Exc] {
    let o = options(f[1]);
    let data = unhex(f[3]);
    if f[0] == "cli" {
        return cli(o, f[2], data, t, mut w);
    }
    let found = process_file(data, o, t, mut w)?;
    if f[0] == "gps" {
        let coords = match found {
            None => "None".to_string(),
            Some(h) => {
                if o.builtin {
                    gps_coords_builtin(convert_types(h)?)?
                } else {
                    gps_coords(h)?
                }
            }
        };
        log(mut w, f"coords {coords}");
    } else {
        let thumb = match found {
            Some(h) => h.jpeg_thumb.clone(),
            None => None,
        };
        match thumb {
            Some(b) => {
                let hx = hex(b);
                log(mut w, f"JPEGThumbnail {b.len()} {hx}");
            }
            None => log(mut w, "JPEGThumbnail none"),
        }
        log(mut w, "TIFFThumbnail none");
    }
    Ok(())
}

fn main() {
    let t = load_tables();
    let mut w = World { out: String.new(), subs: Map.new() };
    for line in jobs_text().split("\n") {
        if line.is_empty() {
            continue;
        }
        let f = fields(line.to_string());
        let size = f[3].len() / 2;
        w.out.push_str(f"== {f[0]} {f[1]} {f[2]} ({size} bytes)\n");
        match run_job(f, t, mut w) {
            Ok(_) => {}
            Err(e) => {
                w.out.push_str(f"error {e.kind}: {e.msg}\n\n");
            }
        }
    }
    print(w.out);
}

