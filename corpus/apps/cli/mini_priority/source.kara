    s.push_str("insert\t2\t-\t16\t0\n");
    s.push_str("insert\t3\t-\t8\t0\n");
    s.push_str("sched\t14\n");
    s.push_str("tree\t1000\n");
    s.push_str("insert\t1\t-\t16\t0\n");
    s.push_str("insert\t3\t1\t16\t0\n");
    s.push_str("insert\t5\t1\t16\t0\n");
    s.push_str("block\t1\n");
    s.push_str("sched\t8\n");
    s.push_str("unblock\t1\n");
    s.push_str("sched\t4\n");
    s.push_str("tree\t1000\n");
    s.push_str("insert\t1\t-\t16\t0\n");
    s.push_str("insert\t3\t-\t16\t0\n");
    s.push_str("insert\t5\t1\t16\t1\n");
    s.push_str("sched\t6\n");
    s.push_str("tree\t1000\n");
    s.push_str("insert\t1\t-\t16\t0\n");
    s.push_str("insert\t3\t-\t16\t0\n");
    s.push_str("insert\t5\t-\t16\t0\n");
    s.push_str("reprio\t5\t1\t16\t1\n");
    s.push_str("sched\t6\n");
    s.push_str("tree\t1000\n");
    s.push_str("insert\t1\t-\t16\t0\n");
    s.push_str("insert\t3\t1\t16\t0\n");
    s.push_str("insert\t5\t3\t16\t0\n");
    s.push_str("remove\t3\n");
    s.push_str("sched\t6\n");
    s.push_str("tree\t1000\n");
    s.push_str("insert\t1\t-\t200\t0\n");
    s.push_str("insert\t3\t-\t100\t0\n");
    s.push_str("reprio\t1\t3\t64\t0\n");
    s.push_str("sched\t10\n");
    s.push_str("tree\t1000\n");
    s.push_str("insert\t1\t-\t16\t0\n");
    s.push_str("insert\t1\t-\t16\t0\n");
    s.push_str("tree\t1000\n");
    s.push_str("reprio\t9\t-\t16\t0\n");
    s.push_str("tree\t1000\n");
    s.push_str("remove\t9\n");
    s.push_str("tree\t1000\n");
    s.push_str("block\t9\n");
    s.push_str("tree\t1000\n");
    s.push_str("reprio\t0\t-\t16\t0\n");
    s.push_str("tree\t1000\n");
    s.push_str("remove\t0\n");
    s.push_str("tree\t1000\n");
    s.push_str("block\t0\n");
    s.push_str("tree\t1000\n");
    s.push_str("insert\t1\t1\t16\t0\n");
    s.push_str("tree\t1000\n");
    s.push_str("insert\t1\t-\t0\t0\n");
    s.push_str("tree\t1000\n");
    s.push_str("insert\t1\t-\t257\t0\n");
    s.push_str("tree\t2\n");
    s.push_str("insert\t1\t-\t16\t0\n");
    s.push_str("insert\t3\t-\t16\t0\n");
    s.push_str("tree\t1000\n");
    s.push_str("insert\t1\t-\t16\t0\n");
    s.push_str("insert\t3\t-\t16\t0\n");
    s.push_str("block\t1\n");
    s.push_str("block\t3\n");
    s.push_str("sched\t3\n");
