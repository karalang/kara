// mini_tsdb: a time-series database in the shape of Prometheus. It reads
// scrapes in the text exposition format (one file per host, parsed in a
// task each), appends them to per-series heads with Prometheus's
// out-of-order and duplicate rules, cuts each series into chunks of 120
// samples compressed the Gorilla way (delta-of-delta timestamps, XOR'd
// float bits), writes the block to disk, reads it back, and answers a
// small PromQL: selectors with label matchers, range vectors, rate and
// increase with Prometheus's extrapolation, the *_over_time functions,
// aggregations by label, and instant and range queries.

const FIRST_SCRAPE: i64 = 1700000000000;
const CHUNK: i64 = 120;
const LOOKBACK: i64 = 300000;

// ------------------------------------------------------------ text

fn is_digit(c: u8) -> bool {
    c >= b'0' and c <= b'9'
}

fn is_digits(s: Str) -> bool {
    s.len() > 0 and s.bytes().iter().all(|c| is_digit(c))
}

// A decimal number as the scrapes write it: an optional minus, digits,
// and an optional fraction.
fn is_number(s: Str) -> bool {
    let body = s.strip_prefix("-") ?? s;
    match body.find(".") {
        Some(i) => is_digits(body.substring(0, i)) and is_digits(body.substring(i + 1)),
        None => is_digits(body),
    }
}

fn is_name_start(c: u8) -> bool {
    (c >= b'a' and c <= b'z') or (c >= b'A' and c <= b'Z') or c == b'_' or c == b':'
}

fn is_name_char(c: u8) -> bool {
    is_name_start(c) or is_digit(c)
}

fn number(s: Str) -> i64 {
    i64.parse(s).unwrap_or(0)
}

fn float(s: Str) -> f64 {
    f64.parse(s).unwrap_or(0.0)
}

fn fmt(v: f64) -> String {
    f"{v:.4}"
}

type Labels = SortedMap[String, String];

// `name{a="x",b="y"}`, the labels in name order; a bare name when there
// are no other labels, and `{...}` when there is no name.
fn show(labels: ref Labels) -> String {
    let name = labels.get("__name__").cloned() ?? "".to_string();
    let mut rest: Vec[String] = Vec.new();
    for (k, v) in labels.iter() {
        if k != "__name__" {
            rest.push(f"{k}=\"{v}\"");
        }
    }
    if name.len() > 0 and rest.is_empty() {
        return name;
    }
    f"{name}{{{rest.join(",")}}}"
}

// The labels back from `show`'s text.
fn labels_of(key: Str) -> Labels {
    let mut labels: Labels = SortedMap.new();
    let (name, body) = match key.find("{") {
        Some(i) => (key.substring(0, i), key.substring(i + 1, key.len() - 1)),
        None => (key.to_string(), "".to_string()),
    };
    if name.len() > 0 {
        labels.insert("__name__".to_string(), name);
    }
    for part in body.split("\",") {
        if let Some(i) = part.find("=\"") {
            let v = part.substring(i + 2);
            let v = v.strip_suffix("\"") ?? v.as_str();
            labels.insert(part.substring(0, i), v.to_string());
        }
    }
    labels
}

// ------------------------------------------------------------ scrapes

struct Sample {
    labels: Labels,
    value: f64,
    ts: i64,
}

fn parse_sample(line: Str) -> Result[Sample, String] {
    let b = line.bytes();
    let mut i = 0;
    while i < b.len() and (if i == 0 { is_name_start(b[i]) } else { is_name_char(b[i]) }) {
        i += 1;
    }
    if i == 0 {
        return Err("missing metric name".to_string());
    }
    let mut labels: Labels = SortedMap.new();
    labels.insert("__name__".to_string(), line.substring(0, i));
    if i < b.len() and b[i] == b'{' {
        i += 1;
        loop {
            if i < b.len() and b[i] == b'}' {
                i += 1;
                break;
            }
            let mut j = i;
            while j < b.len() and is_name_char(b[j]) {
                j += 1;
            }
            if j == i or j >= b.len() or b[j] != b'=' {
                return Err("bad label".to_string());
            }
            let key = line.substring(i, j);
            if j + 1 >= b.len() or b[j + 1] != b'"' {
                return Err(f"the value of label {key} must be quoted");
            }
            let mut k = j + 2;
            while k < b.len() and b[k] != b'"' {
                k += 1;
            }
            if k >= b.len() {
                return Err(f"the value of label {key} is not closed");
            }
            labels.insert(key, line.substring(j + 2, k));
            i = k + 1;
            if i < b.len() and b[i] == b',' {
                i += 1;
            } else if not (i < b.len() and b[i] == b'}') {
                return Err("bad label".to_string());
            }
        }
    }
    let tail = line.substring(i);
    let rest: Vec[Str] = tail.split(" ").collect();
    if rest.len() < 2 or rest[0] != "" {
        return Err("expected a space and a value".to_string());
    }
    if not is_number(rest[1]) {
        return Err(f"bad value \"{rest[1]}\"");
    }
    if rest.len() < 3 {
        return Err("missing timestamp".to_string());
    }
    if rest.len() > 3 or not is_digits(rest[2]) {
        return Err(f"bad timestamp \"{rest[2..rest.len()].join(" ")}\"");
    }
    Ok(Sample { labels, value: float(rest[1]), ts: number(rest[2]) })
}

// Every sample line of a scrape file with its line number, parsed or not.
fn parse_file(text: String) -> Vec[(i64, Result[Sample, String])] {
    let mut out = Vec.new();
    let mut no = 0;
    for line in text.split("\n") {
        no += 1;
        if line.len() == 0 or line.starts_with("#") {
            continue;
        }
        out.push((no, parse_sample(line)));
    }
    out
}

// ------------------------------------------------------------ gorilla

struct BitWriter {
    bytes: Vec[u8],
    nbits: i64,
}

impl BitWriter {
    fn bit(mut ref self, b: u64) {
        if self.nbits % 8 == 0 {
            self.bytes.push(0);
        }
        if b != 0 {
            let last = self.bytes.len() - 1;
            self.bytes[last] = self.bytes[last] | (0x80u8 >> ((self.nbits % 8) as u32));
        }
        self.nbits += 1;
    }

    fn bits(mut ref self, v: u64, n: i64) {
        let mut k = n - 1;
        while k >= 0 {
            self.bit((v >> (k as u32)) & 1);
            k -= 1;
        }
    }
}

struct BitReader {
    data: Vec[u8],
    pos: i64,
}

impl BitReader {
    fn bit(mut ref self) -> u64 {
        let byte = self.data[self.pos / 8];
        let b = (byte >> ((7 - self.pos % 8) as u32)) & 1;
        self.pos += 1;
        b
    }

    fn bits(mut ref self, n: i64) -> u64 {
        let mut v: u64 = 0;
        for _ in 0..n {
            v = (v << 1) | self.bit();
        }
        v
    }
}

// The delta-of-delta buckets after the first bit: a prefix of that many
// bits, then the value in that many bits.
const BUCKETS: Array[(i64, i64), 3] = [(2, 14), (3, 17), (4, 20)];

fn mask(n: i64) -> u64 {
    if n == 64 { 0xffffffffffffffff } else { (1u64 << (n as u32)) - 1 }
}

fn encode(samples: Slice[(i64, f64)]) -> Vec[u8] {
    let mut w = BitWriter { bytes: Vec.new(), nbits: 0 };
    w.bits(samples.len() as u64, 16);
    let mut (pt, pv) = samples[0];
    w.bits(pt as u64, 64);
    w.bits(pv.to_bits(), 64);
    let mut pdelta = 0;
    let mut lead: i64 = 255;
    let mut trail: i64 = 0;
    for (t, v) in samples[1..samples.len()].iter() {
        let delta = t - pt;
        let dod = delta - pdelta;
        if dod == 0 {
            w.bit(0);
        } else {
            let mut done = false;
            for (prefix, nb) in BUCKETS.iter() {
                let half = 1 << (nb - 1);
                if not done and dod >= -(half - 1) and dod <= half {
                    w.bits(((1 << prefix) - 2) as u64, prefix);
                    w.bits((dod as u64) & mask(nb), nb);
                    done = true;
                }
            }
            if not done {
                w.bits(0b1111, 4);
                w.bits(dod as u64, 64);
            }
        }
        let x = v.to_bits() ^ pv.to_bits();
        if x == 0 {
            w.bit(0);
        } else {
            w.bit(1);
            let l = x.leading_zeros().min(31);
            let tr = x.trailing_zeros();
            if lead != 255 and l >= lead and tr >= trail {
                w.bit(0);
                w.bits(x >> (trail as u32), 64 - lead - trail);
            } else {
                lead = l;
                trail = tr;
                w.bit(1);
                w.bits(l as u64, 5);
                let sig = 64 - l - tr;
                w.bits((sig & 63) as u64, 6);
                w.bits(x >> (tr as u32), sig);
            }
        }
        pdelta = delta;
        pt = t;
        pv = v;
    }
    w.bytes
}

fn decode(data: own Vec[u8]) -> Vec[(i64, f64)] {
    let mut r = BitReader { data, pos: 0 };
    let n = r.bits(16) as i64;
    let mut t = r.bits(64) as i64;
    let mut vb = r.bits(64);
    let mut out = vec![(t, vb.bits_as_f64())];
    let mut delta = 0;
    let mut lead = 0;
    let mut trail = 0;
    for _ in 1..n {
        let mut dod = 0;
        if r.bit() == 1 {
            let mut nb = 0;
            for (_, size) in BUCKETS.iter() {
                if nb == 0 and r.bit() == 0 {
                    nb = size;
                }
            }
            if nb == 0 {
                dod = r.bits(64) as i64;
            } else {
                dod = r.bits(nb) as i64;
                if dod > (1 << (nb - 1)) {
                    dod -= 1 << nb;
                }
            }
        }
        delta += dod;
        t += delta;
        if r.bit() == 1 {
            if r.bit() == 1 {
                lead = r.bits(5) as i64;
                let mut sig = r.bits(6) as i64;
                if sig == 0 {
                    sig = 64;
                }
                trail = 64 - lead - sig;
            }
            vb = vb ^ (r.bits(64 - lead - trail) << (trail as u32));
        }
        out.push((t, vb.bits_as_f64()));
    }
    out
}

// ------------------------------------------------------------ the database

struct Series {
    labels: Labels,
    samples: Vec[(i64, f64)],
}

struct Db {
    series: Map[String, Series],
    out: Vec[String],
}

impl Db {
    fn ingest(mut ref self, name: Str, parsed: own Vec[(i64, Result[Sample, String])]) {
        let mut added = 0;
        let mut dups = 0;
        let mut rejects: Vec[String] = Vec.new();
        let mut touched: Set[String] = Set.new();
        for (no, sample) in parsed.into_iter() {
            let s = match sample {
                Ok(s) => s,
                Err(e) => {
                    rejects.push(f"  ! line {no}: {e}");
                    continue;
                }
            };
            let key = show(s.labels);
            if not self.series.contains_key(key) {
                self.series.insert(key.clone(), Series { labels: s.labels, samples: Vec.new() });
            }
            if let Some((lt, lv)) = self.series[key].samples.last() {
                if s.ts < lt {
                    rejects.push(f"  ! line {no}: out of order sample for {key} at {s.ts}");
                    continue;
                }
                if s.ts == lt {
                    if s.value == lv {
                        dups += 1;
                    } else {
                        rejects.push(f"  ! line {no}: {key} already has a different value at {s.ts}");
                    }
                    continue;
                }
            }
            self.series[key].samples.push((s.ts, s.value));
            touched.insert(key);
            added += 1;
        }
        let mut line = f"{name}: {added} samples added to {touched.len()} series";
        if dups == 1 {
            line.push_str(", 1 duplicate ignored");
        } else if dups > 1 {
            line.push_str(f", {dups} duplicates ignored");
        }
        if not rejects.is_empty() {
            line.push_str(f", {rejects.len()} rejected");
        }
        self.out.push(line);
        self.out.extend(rejects);
    }

    fn write_block(mut ref self) -> Result[(), String] {
        let mut blob: Vec[u8] = Vec.new();
        let mut index: Vec[String] = Vec.new();
        let mut total = 0;
        let mut nchunks = 0;
        let mut nseries = 0;
        self.out.push("== block".to_string());
        let mut keys: Vec[String] = self.series.keys().cloned().collect();
        keys.sort();
        for key in keys.iter() {
            let samples = ref self.series[key].samples;
            if samples.is_empty() {
                continue;
            }
            let start = blob.len();
            let mut chunks: Vec[String] = Vec.new();
            let mut i = 0;
            while i < samples.len() {
                let end = (i + CHUNK).min(samples.len());
                let part = samples[i..end];
                let c = encode(part);
                chunks.push(f"chunk {blob.len()} {c.len()} {part[0].0} {part[part.len() - 1].0} {part.len()}");
                blob.extend(c);
                i = end;
            }
            let s = if chunks.len() != 1 { "s" } else { "" };
            self.out.push(f"{key}: {samples.len()} samples in {chunks.len()} chunk{s}, {blob.len() - start} bytes");
            index.push(f"series {key} {chunks.len()}");
            total += samples.len();
            nchunks += chunks.len();
            nseries += 1;
            index.extend(chunks);
        }
        if fs.write_bytes("data/run/chunks".to_string(), blob.clone()).is_err() {
            return Err("cannot write data/run/chunks".to_string());
        }
        if fs.write("data/run/index".to_string(), index.join("\n") + "\n").is_err() {
            return Err("cannot write data/run/index".to_string());
        }
        let per = (blob.len() as f64) / (total as f64);
        self.out.push(f"{nseries} series, {total} samples, {nchunks} chunks, {blob.len()} bytes, {per:.2} bytes a sample");
        Ok(())
    }
}

// Reads the block back: each series with every sample of its chunks.
fn load_block() -> Result[Vec[(String, Vec[(i64, f64)])], String] {
    let blob = match fs.read_bytes("data/run/chunks".to_string()) {
        Ok(b) => b,
        Err(_) => return Err("cannot read data/run/chunks".to_string()),
    };
    let text = match fs.read_to_string("data/run/index".to_string()) {
        Ok(t) => t,
        Err(_) => return Err("cannot read data/run/index".to_string()),
    };
    let mut series: Vec[(String, Vec[(i64, f64)])] = Vec.new();
    for l in text.split("\n") {
        let w: Vec[Str] = l.split(" ").collect();
        if w[0] == "series" {
            series.push((w[1].to_string(), Vec.new()));
        } else if w[0] == "chunk" and not series.is_empty() {
            let (off, n) = (number(w[1]), number(w[2]));
            let got = decode(blob[off..off + n].to_vec());
            if got.len() != number(w[5]) or got[0].0 != number(w[3]) or got[got.len() - 1].0 != number(w[4]) {
                return Err(f"chunk at {off} does not match the index");
            }
            let last = series.len() - 1;
            series[last].1.extend(got);
        }
    }
    Ok(series)
}

// ------------------------------------------------------------ queries

#[derive(Clone, PartialEq)]
enum Kind {
    Name,
    Num,
    Text,
    Op,
    End,
}

#[derive(Clone)]
struct Token {
    kind: Kind,
    text: String,
    col: i64,
}

fn tokenize(src: Str) -> Result[Vec[Token], String] {
    let b = src.bytes();
    let mut toks: Vec[Token] = Vec.new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i];
        let col = i + 1;
        if c == b' ' {
            i += 1;
        } else if is_name_start(c) {
            let mut j = i;
            while j < b.len() and is_name_char(b[j]) {
                j += 1;
            }
            toks.push(Token { kind: Kind.Name, text: src.substring(i, j), col });
            i = j;
        } else if is_digit(c) {
            let mut j = i;
            while j < b.len() and (is_name_char(b[j]) or b[j] == b'.') and b[j] != b'_' and b[j] != b':' {
                j += 1;
            }
            toks.push(Token { kind: Kind.Num, text: src.substring(i, j), col });
            i = j;
        } else if c == b'"' {
            let mut j = i + 1;
            while j < b.len() and b[j] != b'"' {
                j += 1;
            }
            if j >= b.len() {
                return Err(f"parse error at column {col}: a string is not closed");
            }
            toks.push(Token { kind: Kind.Text, text: src.substring(i + 1, j), col });
            i = j + 1;
        } else if c == b'!' and i + 1 < b.len() and b[i + 1] == b'=' {
            toks.push(Token { kind: Kind.Op, text: "!=".to_string(), col });
            i += 2;
        } else if "(){}[],=*/".contains(src.substring(i, i + 1)) {
            toks.push(Token { kind: Kind.Op, text: src.substring(i, i + 1), col });
            i += 1;
        } else {
            return Err(f"parse error at column {col}: unexpected {src.substring(i, i + 1)}");
        }
    }
    toks.push(Token { kind: Kind.End, text: "".to_string(), col: src.len() + 1 });
    Ok(toks)
}

fn duration_ms(s: Str) -> Option[i64] {
    let unit = match s.substring(s.len() - 1) {
        "s" => 1000,
        "m" => 60000,
        "h" => 3600000,
        _ => return None,
    };
    let digits = s.substring(0, s.len() - 1);
    if not is_digits(digits) {
        return None;
    }
    Some(number(digits) * unit)
}

#[derive(Clone)]
struct Matcher {
    label: String,
    equal: bool,
    value: String,
}

shared enum Expr {
    Select(Vec[Matcher]),
    Range { matchers: Vec[Matcher], ms: i64 },
    Scalar { times: bool, n: f64, inner: Expr },
    Func { name: String, arg: Expr },
    Agg { op: String, by: Option[Vec[String]], inner: Expr },
}

fn is_agg(s: Str) -> bool {
    ["sum", "avg", "max", "min", "count"].contains(s.to_string())
}

fn is_func(s: Str) -> bool {
    ["rate", "increase", "avg_over_time", "max_over_time", "min_over_time", "count_over_time"].contains(s.to_string())
}

struct QueryParser {
    toks: Vec[Token],
    i: i64,
}

fn parse_error(t: ref Token, what: Str) -> String {
    f"parse error at column {t.col}: {what}"
}

impl QueryParser {
    fn peek(self) -> Token {
        self.toks[self.i].clone()
    }

    fn take(mut ref self) -> Token {
        self.i += 1;
        self.toks[self.i - 1].clone()
    }

    // The next token is this operator or keyword.
    fn at(self, text: Str) -> bool {
        let t = ref self.toks[self.i];
        t.text == text and (t.kind == Kind.Op or t.kind == Kind.Name)
    }

    fn expect(mut ref self, text: Str) -> Result[(), String] {
        let t = self.take();
        if t.kind == Kind.End or t.kind == Kind.Text or t.text != text {
            return Err(parse_error(t, f"expected {text}"));
        }
        Ok(())
    }

    fn parse(mut ref self) -> Result[Expr, String] {
        let e = self.expr()?;
        let t = self.peek();
        if t.kind != Kind.End {
            return Err(parse_error(t, f"unexpected {t.text}"));
        }
        Ok(e)
    }

    fn expr(mut ref self) -> Result[Expr, String] {
        let mut e = self.unary()?;
        while self.at("*") or self.at("/") {
            let times = self.take().text == "*";
            let t = self.take();
            if t.kind != Kind.Num or not is_number(t.text) {
                return Err(parse_error(t, "expected a number"));
            }
            e = Expr.Scalar { times, n: float(t.text), inner: e };
        }
        Ok(e)
    }

    fn unary(mut ref self) -> Result[Expr, String] {
        let t = self.take();
        if t.kind != Kind.Name {
            return Err(parse_error(t, "expected a metric, function or aggregation"));
        }
        if is_agg(t.text) and (self.at("by") or self.at("(")) {
            let mut by: Option[Vec[String]] = None;
            if self.at("by") {
                self.take();
                self.expect("(")?;
                let mut names: Vec[String] = Vec.new();
                loop {
                    let n = self.take();
                    if n.kind != Kind.Name {
                        return Err(parse_error(n, "expected a label name"));
                    }
                    names.push(n.text);
                    if self.at(",") {
                        self.take();
                    } else {
                        self.expect(")")?;
                        break;
                    }
                }
                by = Some(names);
            }
            self.expect("(")?;
            let inner = self.expr()?;
            self.expect(")")?;
            return Ok(Expr.Agg { op: t.text, by, inner });
        }
        if is_func(t.text) and self.at("(") {
            self.take();
            let arg = self.expr()?;
            self.expect(")")?;
            return Ok(Expr.Func { name: t.text, arg });
        }
        let mut matchers = vec![Matcher { label: "__name__".to_string(), equal: true, value: t.text }];
        if self.at("{") {
            self.take();
            while not self.at("}") {
                let n = self.take();
                if n.kind != Kind.Name {
                    return Err(parse_error(n, "expected a label name"));
                }
                let op = self.take();
                if op.kind != Kind.Op or (op.text != "=" and op.text != "!=") {
                    return Err(parse_error(op, "expected = or !="));
                }
                let v = self.take();
                if v.kind != Kind.Text {
                    return Err(parse_error(v, "expected a quoted value"));
                }
                matchers.push(Matcher { label: n.text, equal: op.text == "=", value: v.text });
                if self.at(",") {
                    self.take();
                } else if not self.at("}") {
                    return Err(parse_error(self.peek(), "expected , or }"));
                }
            }
            self.take();
        }
        if self.at("[") {
            self.take();
            let d = self.take();
            let ms = if d.kind == Kind.Num { duration_ms(d.text) } else { None };
            let ms = match ms {
                Some(ms) => ms,
                None => return Err(parse_error(d, "expected a duration like 5m")),
            };
            self.expect("]")?;
            return Ok(Expr.Range { matchers, ms });
        }
        Ok(Expr.Select(matchers))
    }
}

type Vector = Vec[(Labels, f64)];

struct Engine {
    series: Vec[(Labels, Vec[(i64, f64)])],
}

fn matches(labels: ref Labels, matchers: ref Vec[Matcher]) -> bool {
    matchers.iter().all(|m| ((labels.get(m.label).cloned() ?? "".to_string()) == m.value) == m.equal)
}

fn without_name(labels: ref Labels) -> Labels {
    let mut l = labels.clone();
    l.remove("__name__");
    l
}

impl Engine {
    fn eval(self, e: ref Expr, t: i64) -> Result[Vector, String] {
        match e {
            Expr.Select(matchers) => {
                let mut out: Vector = Vec.new();
                for (labels, samples) in self.series.iter() {
                    if not matches(labels, matchers) {
                        continue;
                    }
                    let mut last: Option[f64] = None;
                    for (ts, v) in samples.iter() {
                        if ts > t - LOOKBACK and ts <= t {
                            last = Some(v);
                        }
                    }
                    if let Some(v) = last {
                        out.push((labels.clone(), v));
                    }
                }
                Ok(out)
            }
            Expr.Range { .. } => Err("a range vector needs a function such as rate around it".to_string()),
            Expr.Scalar { times, n, inner } => {
                let mut out: Vector = Vec.new();
                for (labels, v) in self.eval(inner, t)?.into_iter() {
                    out.push((without_name(labels), if times { v * n } else { v / n }));
                }
                Ok(out)
            }
            Expr.Func { name, arg } => {
                let (matchers, range) = match arg {
                    Expr.Range { matchers, ms } => (matchers, ms),
                    _ => return Err(f"{name} takes a range vector, like {name}(x[5m])"),
                };
                let mut out: Vector = Vec.new();
                for (labels, samples) in self.series.iter() {
                    if not matches(labels, matchers) {
                        continue;
                    }
                    let win: Vec[(i64, f64)] = samples.iter().filter(|(ts, _)| ts > t - range and ts <= t).collect();
                    if let Some(r) = over_time(name, win, t - range, t, range) {
                        out.push((without_name(labels), r));
                    }
                }
                Ok(out)
            }
            Expr.Agg { op, by, inner } => {
                let mut input = self.eval(inner, t)?;
                input.sort_by_key(|(l, _)| show(l));
                let mut order: Vec[String] = Vec.new();
                let mut groups: Map[String, (Labels, Vec[f64])] = Map.new();
                for (labels, v) in input.into_iter() {
                    let mut g: Labels = SortedMap.new();
                    if let Some(names) = by {
                        for k in names.iter() {
                            if let Some(x) = labels.get(k) {
                                g.insert(k.clone(), x.clone());
                            }
                        }
                    }
                    let key = show(g);
                    match groups.get_mut(key) {
                        Some(entry) => entry.1.push(v),
                        None => {
                            order.push(key.clone());
                            groups.insert(key, (g, vec![v]));
                        }
                    }
                }
                let mut out: Vector = Vec.new();
                for key in order.iter() {
                    let (g, vs) = groups.remove(key).unwrap();
                    out.push((g, aggregate(op, vs)));
                }
                Ok(out)
            }
        }
    }
}

fn aggregate(op: Str, vs: Vec[f64]) -> f64 {
    match op {
        "sum" | "avg" => {
            let mut r = 0.0;
            for v in vs.iter() {
                r += v;
            }
            if op == "avg" { r / (vs.len() as f64) } else { r }
        }
        "max" => {
            let mut r = vs[0];
            for v in vs[1..vs.len()].iter() {
                if v > r {
                    r = v;
                }
            }
            r
        }
        "min" => {
            let mut r = vs[0];
            for v in vs[1..vs.len()].iter() {
                if v < r {
                    r = v;
                }
            }
            r
        }
        _ => vs.len() as f64,
    }
}

// A function over the samples of one series in (start, end].
fn over_time(name: Str, win: Vec[(i64, f64)], start: i64, end: i64, range: i64) -> Option[f64] {
    if win.is_empty() {
        return None;
    }
    match name {
        "count_over_time" => return Some(win.len() as f64),
        "avg_over_time" => {
            let mut s = 0.0;
            for (_, v) in win.iter() {
                s += v;
            }
            return Some(s / (win.len() as f64));
        }
        "max_over_time" | "min_over_time" => {
            let mut r = win[0].1;
            for (_, v) in win[1..win.len()].iter() {
                if (name == "max_over_time" and v > r) or (name == "min_over_time" and v < r) {
                    r = v;
                }
            }
            return Some(r);
        }
        _ => {}
    }
    if win.len() < 2 {
        return None;
    }
    Some(extrapolated_rate(win, start, end, range, name == "rate"))
}

// Prometheus's extrapolatedRate for a counter: the increase across the
// window, with resets added back, stretched towards the window's edges
// when the samples come close enough to them.
fn extrapolated_rate(win: Vec[(i64, f64)], start: i64, end: i64, range: i64, per_second: bool) -> f64 {
    let (ft, fv) = win[0];
    let (lt, lv) = win[win.len() - 1];
    let mut result = lv - fv;
    let mut prev = fv;
    for (_, v) in win[1..win.len()].iter() {
        if v < prev {
            result += prev;
        }
        prev = v;
    }
    let mut dur_start = ((ft - start) as f64) / 1000.0;
    let dur_end = ((end - lt) as f64) / 1000.0;
    let sampled = ((lt - ft) as f64) / 1000.0;
    let avg_dur = sampled / ((win.len() - 1) as f64);
    if result > 0.0 and fv >= 0.0 {
        let dur_zero = sampled * (fv / result);
        if dur_zero < dur_start {
            dur_start = dur_zero;
        }
    }
    let threshold = avg_dur * 1.1;
    let mut extrap = sampled;
    extrap += if dur_start < threshold { dur_start } else { avg_dur / 2.0 };
    extrap += if dur_end < threshold { dur_end } else { avg_dur / 2.0 };
    result = result * (extrap / sampled);
    if per_second {
        result = result / ((range as f64) / 1000.0);
    }
    result
}

fn rows_or_none(rows: own Vec[String]) -> Vec[String] {
    if rows.is_empty() { vec!["  (no data)".to_string()] } else { rows }
}

fn run_query(engine: ref Engine, line: Str) -> Vec[String] {
    let mut out = vec![f"> {line}"];
    match query(engine, line) {
        Ok(rows) => out.extend(rows_or_none(rows)),
        Err(e) => out.push(f"  ! {e}"),
    }
    out
}

fn query(engine: ref Engine, line: Str) -> Result[Vec[String], String] {
    let w: Vec[Str] = line.split(" ").collect();
    if w[0] == "instant" and w.len() >= 3 and is_digits(w[1]) {
        let e = QueryParser { toks: tokenize(w[2..w.len()].join(" "))?, i: 0 }.parse()?;
        let res = engine.eval(e, FIRST_SCRAPE + number(w[1]) * 1000)?;
        let mut rows: Vec[(String, f64)] = res.iter().map(|(l, v)| (show(l), v)).collect();
        rows.sort_by(|a, b| a.0.cmp(b.0));
        return Ok(rows.iter().map(|(k, v)| f"  {k} {fmt(v)}").collect());
    }
    if w[0] == "range" and w.len() >= 5 and w[1..4].iter().all(|x| is_digits(x)) {
        let (start, end, step) = (number(w[1]), number(w[2]), number(w[3]));
        if end < start or step == 0 {
            return Err("a range needs start <= end and a step above 0".to_string());
        }
        let e = QueryParser { toks: tokenize(w[4..w.len()].join(" "))?, i: 0 }.parse()?;
        let mut rows: SortedMap[String, Vec[String]] = SortedMap.new();
        let mut t = start;
        while t <= end {
            for (l, v) in engine.eval(e, FIRST_SCRAPE + t * 1000)?.iter() {
                let key = show(l);
                let cell = f"{t}={fmt(v)}";
                match rows.get(key) {
                    Some(cells) => {
                        let mut cells = cells.clone();
                        cells.push(cell);
                        rows.insert(key, cells);
                    }
                    None => {
                        rows.insert(key, vec![cell]);
                    }
                }
            }
            t += step;
        }
        return Ok(rows.iter().map(|(k, cells)| f"  {k} {cells.join(" ")}").collect());
    }
    Err("a query is: instant <t> <expr>, or range <start> <end> <step> <expr>".to_string())
}

// ------------------------------------------------------------ files

fn is_hexd(c: u8) -> bool {
    (c >= b'0' and c <= b'9') or (c >= b'a' and c <= b'f') or (c >= b'A' and c <= b'F')
}

fn hex_val(c: u8) -> u8 {
    if c >= b'0' and c <= b'9' {
        c - b'0'
    } else if c >= b'a' and c <= b'f' {
        c - b'a' + 10
    } else {
        c - b'A' + 10
    }
}

fn unhex(s: Str) -> Vec[u8] {
    let mut digits: Vec[u8] = Vec.new();
    for c in s.bytes() {
        if is_hexd(c) {
            digits.push(hex_val(c));
        }
    }
    let mut out: Vec[u8] = Vec.new();
    let mut i: i64 = 0;
    while i + 1 < digits.len() {
        out.push(digits[i] * 16 + digits[i + 1]);
        i += 2;
    }
    out
}

fn put_bytes(path: Str, b: Vec[u8]) -> Result[(), String] {
    if let Err(e) = fs.write_bytes(path.to_string(), b) {
        return Err(f"cannot write {path}: {e}");
    }
    Ok(())
}

fn main() {
    if let Err(e) = fs.create_dir_all("data/run".to_string()) {
        eprintln(f"cannot create data/run: {e}");
        return;
    }
    if let Err(e) = write_data() {
        eprintln(e);
        return;
    }
    let mut names: Vec[String] = match fs.read_dir("data".to_string()) {
        Ok(n) => n.into_iter().filter(|n| n.ends_with(".prom")).collect(),
        Err(e) => {
            eprintln(f"cannot list data: {e}");
            return;
        }
    };
    names.sort();
    // Each scrape file is parsed in a task of its own; the samples are
    // appended in file name order.
    let group = TaskGroup.new();
    let mut handles = Vec.new();
    for name in names.iter() {
        let text = match fs.read_to_string(f"data/{name}") {
            Ok(t) => t,
            Err(e) => {
                eprintln(f"cannot read {name}: {e}");
                return;
            }
        };
        handles.push(group.spawn(|| parse_file(text)));
    }
    let mut db = Db { series: Map.new(), out: vec!["== ingest".to_string()] };
    for (name, h) in names.iter().zip(handles.into_iter()) {
        db.ingest(name, h.join());
    }
    if let Err(e) = db.write_block() {
        eprintln(e);
        return;
    }
    let series = match load_block() {
        Ok(s) => s,
        Err(e) => {
            eprintln(e);
            return;
        }
    };
    for (key, samples) in series.iter() {
        if db.series[key].samples != samples {
            eprintln(f"{key} decodes differently");
            return;
        }
    }
    db.out.push("every chunk decodes back to its samples".to_string());
    let engine = Engine { series: series.into_iter().map(|(k, s)| (labels_of(k), s)).collect() };
    db.out.push("== queries".to_string());
    let text = match fs.read_to_string("data/queries.promql".to_string()) {
        Ok(t) => t,
        Err(e) => {
            eprintln(f"cannot read the queries: {e}");
            return;
        }
    };
    for line in text.split("\n") {
        if line.len() > 0 and not line.starts_with("#") {
            db.out.extend(run_query(engine, line));
        }
    }
    println(db.out.join("\n"));
}

// ============================================================ data

// The files under data/, in name order.
fn write_data() -> Result[(), String] {
    put_bytes("data/h1.prom", unhex(file_0()))?;
    put_bytes("data/h2.prom", unhex(file_1()))?;
    put_bytes("data/h3.prom", unhex(file_2()))?;
    put_bytes("data/queries.promql", unhex(file_3()))?;
    put_bytes("data/zz_late.prom", unhex(file_4()))?;
    Ok(())
}

