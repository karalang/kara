fn data_part_1(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("// Service configuration, with environment overrides.\n");
    t.push_str("const env = typeof process !== 'undefined' ? process.env : {};\n");
    t.push_str("\n");
    t.push_str("const int = (name, fallback) => {\n");
    t.push_str("  const raw = env[name];\n");
    t.push_str("  return raw === undefined || raw === '' ? fallback : parseInt(raw, 10);\n");
    t.push_str("};\n");
    t.push_str("\n");
    t.push_str("const FEATURE_PREFIX = 'FEATURE_';\n");
    t.push_str("\n");
    t.push_str("export const config = {\n");
    t.push_str("  port: int('PORT', 8080),\n");
    t.push_str("  api: { prefix: '/api/v1', version: \"1.4.2\" },\n");
    t.push_str("  db: {\n");
    t.push_str("    url: env.DB_URL || 'mem://orders',\n");
    t.push_str("    latency: int('DB_LATENCY_MS', 0),\n");
    t.push_str("    maxDocs: 5e4,\n");
    t.push_str("  },\n");
    t.push_str("  limits: {\n");
    t.push_str("    body: 0x100000,\n");
    t.push_str("    'requests-per-minute': 600,\n");
    t.push_str("    timeoutMs: 30 * 1000,\n");
    t.push_str("  },\n");
    t.push_str("  features: Object.keys(env)\n");
    t.push_str("    .filter((k) => k.indexOf(FEATURE_PREFIX) === 0)\n");
    t.push_str("    .reduce((acc, k) => ({ ...acc, [k.slice(FEATURE_PREFIX.length).toLowerCase()]: env[k] === '1' }), {}),\n");
    t.push_str("  get production() {\n");
    t.push_str("    return env.NODE_ENV === 'production';\n");
    t.push_str("  },\n");
    t.push_str("  describe() {\n");
    t.push_str("    return `port ${this.port}, db ${this.db.url}${this.production ? ' (production)' : ''}`;\n");
    t.push_str("  },\n");
    t.push_str("};\n");
    t.push_str("\n");
    t.push_str("export const tiers = [\n");
    t.push_str("  { name: 'free', rate: 0, quota: 1e3 },\n");
    t.push_str("  { name: 'team', rate: 12.5, quota: 25e3 },\n");
    t.push_str("  { name: 'business', rate: 49.99, quota: 1e6 },\n");
    t.push_str("];\n");
    v.push(DataFile { path: "src/app/config.js".to_string(), body: t });
    let mut t = String.new();
    t.push_str("/* In-memory document store with the same interface as the real driver.\n");
    t.push_str(" * Every operation is async so callers do not change when it is swapped. */\n");
    t.push_str("import { deepClone, sleep } from './util.js';\n");
    t.push_str("\n");
    t.push_str("const DEFAULTS = { latency: 0, maxDocs: 10000 };\n");
    t.push_str("\n");
    t.push_str("export default class Database {\n");
    t.push_str("  constructor(options) {\n");
    t.push_str("    this.options = Object.assign({}, DEFAULTS, options);\n");
    t.push_str("    this.tables = new Map();\n");
    t.push_str("    this.nextId = 1;\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  table(name) {\n");
    t.push_str("    let t = this.tables.get(name);\n");
    t.push_str("    if (t === undefined) {\n");
    t.push_str("      t = new Map();\n");
    t.push_str("      this.tables.set(name, t);\n");
    t.push_str("    }\n");
    t.push_str("    return t;\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  async find(name, id) {\n");
    t.push_str("    await sleep(this.options.latency);\n");
    t.push_str("    const doc = this.table(name).get(id);\n");
    t.push_str("    return doc ? deepClone(doc) : null;\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  async insert(name, doc) {\n");
    t.push_str("    const t = this.table(name);\n");
    t.push_str("    if (t.size >= this.options.maxDocs) {\n");
    t.push_str("      throw new Error(`table ${name} is full (${this.options.maxDocs} documents)`);\n");
    t.push_str("    }\n");
    t.push_str("    const id = this.nextId++;\n");
    t.push_str("    t.set(id, Object.freeze({ ...deepClone(doc), id }));\n");
    t.push_str("    return id;\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  async remove(name, id) {\n");
    t.push_str("    return this.table(name).delete(id);\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  *scan(name, predicate = () => true) {\n");
    t.push_str("    for (const [id, doc] of this.table(name)) {\n");
    t.push_str("      if (predicate(doc, id)) {\n");
    t.push_str("        yield doc;\n");
    t.push_str("      }\n");
    t.push_str("    }\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  async count(name, predicate) {\n");
    t.push_str("    let n = 0;\n");
    t.push_str("    for (const _ of this.scan(name, predicate)) n += 1;\n");
    t.push_str("    return n;\n");
    t.push_str("  }\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("export async function connect({ url, latency = 0, ...rest }) {\n");
    t.push_str("  if (!/^mem:\\/\\/[a-z][\\w-]*$/i.test(url)) {\n");
    t.push_str("    throw new TypeError('expected a mem:// url, got ' + JSON.stringify(url));\n");
    t.push_str("  }\n");
    t.push_str("  const db = new Database({ latency, ...rest });\n");
    t.push_str("  db.url = url;\n");
    t.push_str("  return db;\n");
    t.push_str("}\n");
    v.push(DataFile { path: "src/app/db.js".to_string(), body: t });
    let mut t = String.new();
    t.push_str("// A small router: routes are a method, a string or a regular expression,\n");
    t.push_str("// and an async handler.\n");
    t.push_str("import { escapeRegExp } from './util.js';\n");
    t.push_str("\n");
    t.push_str("export class NotFound extends Error {\n");
    t.push_str("  constructor(what) {\n");
    t.push_str("    super(`not found: ${what}`);\n");
    t.push_str("    this.name = 'NotFound';\n");
    t.push_str("  }\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("const METHODS = ['get', 'post', 'put', 'delete', 'patch'];\n");
    t.push_str("\n");
    t.push_str("export class Router {\n");
    t.push_str("  constructor({ prefix = '', strict = false } = {}) {\n");
    t.push_str("    this.prefix = prefix;\n");
    t.push_str("    this.strict = strict;\n");
    t.push_str("    this.routes = [];\n");
    t.push_str("    this._hits = 0;\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  static compile(path) {\n");
    t.push_str("    if (path instanceof RegExp) {\n");
    t.push_str("      return path;\n");
    t.push_str("    }\n");
    t.push_str("    const source = path\n");
    t.push_str("      .split('/')\n");
    t.push_str("      .map((part) => (part.startsWith(':') ? '([^/]+)' : escapeRegExp(part)))\n");
    t.push_str("      .join('\\\\/');\n");
    t.push_str("    return new RegExp('^' + source + '$');\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  get size() {\n");
    t.push_str("    return this.routes.length;\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  get hits() {\n");
    t.push_str("    return this._hits;\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  set hits(value) {\n");
    t.push_str("    if (value < 0) throw new RangeError('hits must not be negative');\n");
    t.push_str("    this._hits = value;\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  add(method, path, handler) {\n");
    t.push_str("    this.routes.push({ method: method.toUpperCase(), pattern: Router.compile(path), handler });\n");
    t.push_str("    return this;\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  *match(method, url) {\n");
    t.push_str("    const path = url.startsWith(this.prefix) ? url.slice(this.prefix.length) : url;\n");
    t.push_str("    for (const route of this.routes) {\n");
    t.push_str("      if (route.method !== method) continue;\n");
    t.push_str("      const m = route.pattern.exec(this.strict ? path : path.replace(/\\/+$/, ''));\n");
    t.push_str("      if (m !== null) yield [route, m.slice(1)];\n");
    t.push_str("    }\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  async dispatch(req, res) {\n");
    t.push_str("    this.hits++;\n");
    t.push_str("    for (const [route, params] of this.match(req.method, req.url)) {\n");
    t.push_str("      const result = await route.handler(req, res, params);\n");
    t.push_str("      if (result !== undefined) return result;\n");
    t.push_str("    }\n");
    t.push_str("    throw new NotFound(req.url);\n");
    t.push_str("  }\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("for (const method of METHODS) {\n");
    t.push_str("  Router.prototype[method] = function (path, handler) {\n");
    t.push_str("    return this.add(method, path, handler);\n");
    t.push_str("  };\n");
    t.push_str("}\n");
    v.push(DataFile { path: "src/app/router.js".to_string(), body: t });
}

fn data_part_2(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("// HTTP entry point for the orders service.\n");
    t.push_str("import http from 'node:http';\n");
    t.push_str("import { Router, NotFound } from './router.js';\n");
    t.push_str("import Database, { connect as openDb } from './db.js';\n");
    t.push_str("import * as util from './util.js';\n");
    t.push_str("import { config } from './config.js';\n");
    t.push_str("\n");
    t.push_str("const router = new Router({ prefix: config.api.prefix });\n");
    t.push_str("let db = null;\n");
    t.push_str("\n");
    t.push_str("/**\n");
    t.push_str(" * Reads the whole request body as text.\n");
    t.push_str(" */\n");
    t.push_str("function readBody(req, limit = config.limits.body) {\n");
    t.push_str("  return new Promise((resolve, reject) => {\n");
    t.push_str("    const chunks = [];\n");
    t.push_str("    let size = 0;\n");
    t.push_str("    req.on('data', (chunk) => {\n");
    t.push_str("      size += chunk.length;\n");
    t.push_str("      if (size > limit) {\n");
    t.push_str("        reject(new Error(`body larger than ${util.formatBytes(limit)}`));\n");
    t.push_str("        req.destroy();\n");
    t.push_str("        return;\n");
    t.push_str("      }\n");
    t.push_str("      chunks.push(chunk);\n");
    t.push_str("    });\n");
    t.push_str("    req.on('end', () => resolve(Buffer.concat(chunks).toString('utf8')));\n");
    t.push_str("    req.on('error', reject);\n");
    t.push_str("  });\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("router.get(/^\\/orders\\/(\\d+)$/, async (req, res, [id]) => {\n");
    t.push_str("  const order = await db.find('orders', Number(id));\n");
    t.push_str("  if (!order) {\n");
    t.push_str("    throw new NotFound(`order ${id}`);\n");
    t.push_str("  }\n");
    t.push_str("  return { status: 200, body: order };\n");
    t.push_str("});\n");
    t.push_str("\n");
    t.push_str("router.post('/orders', async (req, res) => {\n");
    t.push_str("  const text = await readBody(req);\n");
    t.push_str("  let input;\n");
    t.push_str("  try {\n");
    t.push_str("    input = JSON.parse(text);\n");
    t.push_str("  } catch (err) {\n");
    t.push_str("    return { status: 400, body: { error: 'invalid JSON', detail: err.message } };\n");
    t.push_str("  }\n");
    t.push_str("  const { customer, items = [], ...rest } = input;\n");
    t.push_str("  if (typeof customer !== 'string' || items.length === 0) {\n");
    t.push_str("    return { status: 422, body: { error: 'customer and items are required' } };\n");
    t.push_str("  }\n");
    t.push_str("  const total = items.reduce((sum, { price, qty = 1 }) => sum + price * qty, 0);\n");
    t.push_str("  const id = await db.insert('orders', { customer, items, total, ...rest, created: Date.now() });\n");
    t.push_str("  return { status: 201, body: { id, total: util.round(total, 2) } };\n");
    t.push_str("});\n");
    t.push_str("\n");
    t.push_str("router.delete(/^\\/orders\\/(\\d+)$/, async (req, res, [id]) => {\n");
    t.push_str("  const removed = await db.remove('orders', +id);\n");
    t.push_str("  return removed ? { status: 204 } : { status: 404, body: { error: 'no such order' } };\n");
    t.push_str("});\n");
    t.push_str("\n");
    t.push_str("const log = util.debounce((line) => console.log(line), 50);\n");
    t.push_str("\n");
    t.push_str("async function handle(req, res) {\n");
    t.push_str("  const started = process.hrtime.bigint ? process.hrtime() : [0, 0];\n");
    t.push_str("  let result;\n");
    t.push_str("  try {\n");
    t.push_str("    result = await router.dispatch(req, res);\n");
    t.push_str("  } catch (err) {\n");
    t.push_str("    result = err instanceof NotFound\n");
    t.push_str("      ? { status: 404, body: { error: err.message } }\n");
    t.push_str("      : { status: 500, body: { error: 'internal error' } };\n");
    t.push_str("  } finally {\n");
    t.push_str("    const [s, ns] = process.hrtime(started);\n");
    t.push_str("    log(`${req.method} ${req.url} ${result && result.status} ${(s * 1e3 + ns / 1e6).toFixed(1)}ms`);\n");
    t.push_str("  }\n");
    t.push_str("  res.writeHead(result.status, { 'content-type': 'application/json' });\n");
    t.push_str("  res.end(result.body === undefined ? '' : JSON.stringify(result.body));\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("export async function start(port = config.port) {\n");
    t.push_str("  db = await openDb(config.db);\n");
    t.push_str("  const server = http.createServer(handle);\n");
    t.push_str("  await new Promise((resolve) => server.listen(port, resolve));\n");
    t.push_str("  return server;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("export default start;\n");
    v.push(DataFile { path: "src/app/server.js".to_string(), body: t });
    let mut t = String.new();
    t.push_str("// Helpers shared by the service.\n");
    t.push_str("\n");
    t.push_str("export const KB = 1 << 10;\n");
    t.push_str("export const MB = KB * KB;\n");
    t.push_str("const UNITS = ['B', 'KiB', 'MiB', 'GiB', 'TiB'];\n");
    t.push_str("\n");
    t.push_str("export function debounce(fn, wait = 100) {\n");
    t.push_str("  let timer = null;\n");
    t.push_str("  return function (...args) {\n");
    t.push_str("    clearTimeout(timer);\n");
    t.push_str("    timer = setTimeout(() => fn.apply(this, args), wait);\n");
    t.push_str("  };\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("export function throttle(fn, interval) {\n");
    t.push_str("  let last = -Infinity, pending = null;\n");
    t.push_str("  return (...args) => {\n");
    t.push_str("    const now = Date.now();\n");
    t.push_str("    if (now - last >= interval) {\n");
    t.push_str("      last = now;\n");
    t.push_str("      fn(...args);\n");
    t.push_str("    } else {\n");
    t.push_str("      pending = args;\n");
    t.push_str("    }\n");
    t.push_str("  };\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("export const sleep = (ms) => new Promise((r) => setTimeout(r, ms));\n");
    t.push_str("\n");
    t.push_str("export function round(x, digits = 0) {\n");
    t.push_str("  const f = 10 ** digits;\n");
    t.push_str("  return Math.round(x * f) / f;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("function formatBytes(n) {\n");
    t.push_str("  let i = 0;\n");
    t.push_str("  while (n >= 1024 && i < UNITS.length - 1) {\n");
    t.push_str("    n /= 1024;\n");
    t.push_str("    i++;\n");
    t.push_str("  }\n");
    t.push_str("  return `${i === 0 ? n : n.toFixed(1)} ${UNITS[i]}`;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("function deepClone(value, seen = new WeakMap()) {\n");
    t.push_str("  if (value === null || typeof value !== 'object') return value;\n");
    t.push_str("  if (seen.has(value)) return seen.get(value);\n");
    t.push_str("  if (value instanceof Date) return new Date(value.getTime());\n");
    t.push_str("  const copy = Array.isArray(value) ? [] : {};\n");
    t.push_str("  seen.set(value, copy);\n");
    t.push_str("  for (const key of Object.keys(value)) {\n");
    t.push_str("    copy[key] = deepClone(value[key], seen);\n");
    t.push_str("  }\n");
    t.push_str("  return copy;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("const group = (n) => String(n).replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',');\n");
    t.push_str("\n");
    t.push_str("export function escapeRegExp(s) {\n");
    t.push_str("  return s.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("export function hash32(text) {\n");
    t.push_str("  let h = 0x811c9dc5;\n");
    t.push_str("  for (let i = 0; i < text.length; i++) {\n");
    t.push_str("    h ^= text.charCodeAt(i);\n");
    t.push_str("    h = (h * 0x01000193) >>> 0;\n");
    t.push_str("  }\n");
    t.push_str("  return h.toString(16).padStart(8, '0');\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("export { formatBytes, deepClone, group as groupDigits };\n");
    v.push(DataFile { path: "src/app/util.js".to_string(), body: t });
}

fn data_part_3(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("// Polyfills for the browsers in the support matrix that lack them.\n");
    t.push_str("if (!Array.prototype.includes) {\n");
    t.push_str("  Object.defineProperty(Array.prototype, 'includes', {\n");
    t.push_str("    value: function (search, fromIndex) {\n");
    t.push_str("      if (this == null) {\n");
    t.push_str("        throw new TypeError('\"this\" is null or not defined');\n");
    t.push_str("      }\n");
    t.push_str("      var o = Object(this);\n");
    t.push_str("      var len = o.length >>> 0;\n");
    t.push_str("      if (len === 0) {\n");
    t.push_str("        return false;\n");
    t.push_str("      }\n");
    t.push_str("      var n = fromIndex | 0;\n");
    t.push_str("      var k = Math.max(n >= 0 ? n : len - Math.abs(n), 0);\n");
    t.push_str("      function sameValueZero(x, y) {\n");
    t.push_str("        return x === y || (typeof x === 'number' && typeof y === 'number' && isNaN(x) && isNaN(y));\n");
    t.push_str("      }\n");
    t.push_str("      while (k < len) {\n");
    t.push_str("        if (sameValueZero(o[k], search)) {\n");
    t.push_str("          return true;\n");
    t.push_str("        }\n");
    t.push_str("        k++;\n");
    t.push_str("      }\n");
    t.push_str("      return false;\n");
    t.push_str("    }\n");
    t.push_str("  });\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("if (typeof Object.assign !== 'function') {\n");
    t.push_str("  Object.assign = function assign(target) {\n");
    t.push_str("    if (target == null) {\n");
    t.push_str("      throw new TypeError('Cannot convert undefined or null to object');\n");
    t.push_str("    }\n");
    t.push_str("    var to = Object(target);\n");
    t.push_str("    for (var index = 1; index < arguments.length; index++) {\n");
    t.push_str("      var source = arguments[index];\n");
    t.push_str("      if (source != null) {\n");
    t.push_str("        for (var key in source) {\n");
    t.push_str("          if (Object.prototype.hasOwnProperty.call(source, key)) {\n");
    t.push_str("            to[key] = source[key];\n");
    t.push_str("          }\n");
    t.push_str("        }\n");
    t.push_str("      }\n");
    t.push_str("    }\n");
    t.push_str("    return to;\n");
    t.push_str("  };\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("if (!String.prototype.padStart) {\n");
    t.push_str("  String.prototype.padStart = function padStart(targetLength, padString) {\n");
    t.push_str("    targetLength = targetLength >> 0;\n");
    t.push_str("    padString = String(typeof padString !== 'undefined' ? padString : ' ');\n");
    t.push_str("    if (this.length >= targetLength) {\n");
    t.push_str("      return String(this);\n");
    t.push_str("    }\n");
    t.push_str("    targetLength = targetLength - this.length;\n");
    t.push_str("    if (targetLength > padString.length) {\n");
    t.push_str("      padString += padString.repeat(targetLength / padString.length);\n");
    t.push_str("    }\n");
    t.push_str("    return padString.slice(0, targetLength) + String(this);\n");
    t.push_str("  };\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("(function () {\n");
    t.push_str("  var lastTime = 0, vendors = ['ms', 'moz', 'webkit', 'o'];\n");
    t.push_str("  for (var x = 0; x < vendors.length && !window.requestAnimationFrame; ++x) {\n");
    t.push_str("    window.requestAnimationFrame = window[vendors[x] + 'RequestAnimationFrame'];\n");
    t.push_str("  }\n");
    t.push_str("  if (!window.requestAnimationFrame) {\n");
    t.push_str("    window.requestAnimationFrame = function (callback) {\n");
    t.push_str("      var currTime = new Date().getTime();\n");
    t.push_str("      var timeToCall = Math.max(0, 16 - (currTime - lastTime));\n");
    t.push_str("      var id = window.setTimeout(function () { callback(currTime + timeToCall); }, timeToCall);\n");
    t.push_str("      lastTime = currTime + timeToCall;\n");
    t.push_str("      return id;\n");
    t.push_str("    };\n");
    t.push_str("  }\n");
    t.push_str("  do {\n");
    t.push_str("    lastTime--;\n");
    t.push_str("  } while (lastTime > 0 && false);\n");
    t.push_str("}());\n");
    v.push(DataFile { path: "src/legacy/polyfill.js".to_string(), body: t });
    let mut t = String.new();
    t.push_str("/*!\n");
    t.push_str(" * Tabs plugin v2.3.1, the jQuery version the admin pages still load.\n");
    t.push_str(" */\n");
    t.push_str(";(function ($, window, document, undefined) {\n");
    t.push_str("  'use strict';\n");
    t.push_str("\n");
    t.push_str("  var pluginName = 'tabs',\n");
    t.push_str("      defaults = {\n");
    t.push_str("        active: 0,\n");
    t.push_str("        activeClass: 'is-active',\n");
    t.push_str("        animate: true,\n");
    t.push_str("        duration: 200\n");
    t.push_str("      };\n");
    t.push_str("\n");
    t.push_str("  function Plugin(element, options) {\n");
    t.push_str("    this.element = element;\n");
    t.push_str("    this.settings = $.extend({}, defaults, options);\n");
    t.push_str("    this._defaults = defaults;\n");
    t.push_str("    this._name = pluginName;\n");
    t.push_str("    this.init();\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  $.extend(Plugin.prototype, {\n");
    t.push_str("    init: function () {\n");
    t.push_str("      var self = this, $el = $(this.element);\n");
    t.push_str("      this.$tabs = $el.find('[role=\"tab\"]');\n");
    t.push_str("      this.$panels = $el.find('[role=\"tabpanel\"]');\n");
    t.push_str("      this.$tabs.on('click.' + pluginName, function (e) {\n");
    t.push_str("        e.preventDefault();\n");
    t.push_str("        self.show(self.$tabs.index(this));\n");
    t.push_str("      });\n");
    t.push_str("      $el.on('keydown.' + pluginName, function (e) {\n");
    t.push_str("        switch (e.which) {\n");
    t.push_str("          case 37: // left\n");
    t.push_str("          case 38: // up\n");
    t.push_str("            self.show(self.current - 1);\n");
    t.push_str("            break;\n");
    t.push_str("          case 39:\n");
    t.push_str("          case 40:\n");
    t.push_str("            self.show(self.current + 1);\n");
    t.push_str("            break;\n");
    t.push_str("          case 36:\n");
    t.push_str("            self.show(0);\n");
    t.push_str("            break;\n");
    t.push_str("          case 35:\n");
    t.push_str("            self.show(self.$tabs.length - 1);\n");
    t.push_str("            break;\n");
    t.push_str("          default:\n");
    t.push_str("            return;\n");
    t.push_str("        }\n");
    t.push_str("        e.preventDefault();\n");
    t.push_str("      });\n");
    t.push_str("      this.show(this.settings.active, true);\n");
    t.push_str("    },\n");
    t.push_str("\n");
    t.push_str("    show: function (index, instant) {\n");
    t.push_str("      var n = this.$tabs.length;\n");
    t.push_str("      if (n === 0) return;\n");
    t.push_str("      index = ((index % n) + n) % n;\n");
    t.push_str("      this.$tabs.removeClass(this.settings.activeClass).attr('aria-selected', 'false');\n");
    t.push_str("      this.$tabs.eq(index).addClass(this.settings.activeClass).attr('aria-selected', 'true');\n");
    t.push_str("      this.$panels.hide();\n");
    t.push_str("      if (this.settings.animate && !instant) {\n");
    t.push_str("        this.$panels.eq(index).fadeIn(this.settings.duration);\n");
    t.push_str("      } else {\n");
    t.push_str("        this.$panels.eq(index).show();\n");
    t.push_str("      }\n");
    t.push_str("      this.current = index;\n");
    t.push_str("      $(this.element).trigger('shown.' + pluginName, [index]);\n");
    t.push_str("    },\n");
    t.push_str("\n");
    t.push_str("    destroy: function () {\n");
    t.push_str("      this.$tabs.off('.' + pluginName);\n");
    t.push_str("      $(this.element).off('.' + pluginName).removeData('plugin_' + pluginName);\n");
    t.push_str("    }\n");
    t.push_str("  });\n");
    t.push_str("\n");
    t.push_str("  $.fn[pluginName] = function (options) {\n");
    t.push_str("    var args = Array.prototype.slice.call(arguments, 1);\n");
    t.push_str("    return this.each(function () {\n");
    t.push_str("      var instance = $.data(this, 'plugin_' + pluginName);\n");
    t.push_str("      if (!instance) {\n");
    t.push_str("        $.data(this, 'plugin_' + pluginName, new Plugin(this, options));\n");
    t.push_str("      } else if (typeof options === 'string' && options.charAt(0) !== '_' && typeof instance[options] === 'function') {\n");
    t.push_str("        instance[options].apply(instance, args);\n");
    t.push_str("      }\n");
    t.push_str("    });\n");
    t.push_str("  };\n");
    t.push_str("})(jQuery, window, document);\n");
    v.push(DataFile { path: "src/legacy/tabs.js".to_string(), body: t });
}

fn data_part_4(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("// RFC 4180 CSV reader as a character state machine.\n");
    t.push_str("var FIELD_START = 0, UNQUOTED = 1, QUOTED = 2, QUOTE_IN_QUOTED = 3;\n");
    t.push_str("\n");
    t.push_str("function parseCSV(text, delimiter) {\n");
    t.push_str("  delimiter = delimiter || ',';\n");
    t.push_str("  var rows = [], row = [], field = '', state = FIELD_START;\n");
    t.push_str("  var i, c;\n");
    t.push_str("  for (i = 0; i < text.length; i += 1) {\n");
    t.push_str("    c = text.charAt(i);\n");
    t.push_str("    switch (state) {\n");
    t.push_str("      case FIELD_START:\n");
    t.push_str("        if (c === '\"') { state = QUOTED; break; }\n");
    t.push_str("        state = UNQUOTED;\n");
    t.push_str("        /* falls through */\n");
    t.push_str("      case UNQUOTED:\n");
    t.push_str("        if (c === delimiter) {\n");
    t.push_str("          row.push(field); field = ''; state = FIELD_START;\n");
    t.push_str("        } else if (c === '\\n' || c === '\\r') {\n");
    t.push_str("          if (c === '\\r' && text.charAt(i + 1) === '\\n') i++;\n");
    t.push_str("          row.push(field); rows.push(row);\n");
    t.push_str("          row = []; field = ''; state = FIELD_START;\n");
    t.push_str("        } else {\n");
    t.push_str("          field += c;\n");
    t.push_str("        }\n");
    t.push_str("        break;\n");
    t.push_str("      case QUOTED:\n");
    t.push_str("        if (c === '\"') state = QUOTE_IN_QUOTED;\n");
    t.push_str("        else field += c;\n");
    t.push_str("        break;\n");
    t.push_str("      case QUOTE_IN_QUOTED:\n");
    t.push_str("        if (c === '\"') { field += '\"'; state = QUOTED; }\n");
    t.push_str("        else if (c === delimiter) { row.push(field); field = ''; state = FIELD_START; }\n");
    t.push_str("        else if (c === '\\n') { row.push(field); rows.push(row); row = []; field = ''; state = FIELD_START; }\n");
    t.push_str("        else throw new SyntaxError('unexpected ' + JSON.stringify(c) + ' after closing quote at ' + i);\n");
    t.push_str("        break;\n");
    t.push_str("    }\n");
    t.push_str("  }\n");
    t.push_str("  if (state === QUOTED) throw new SyntaxError('unterminated quoted field');\n");
    t.push_str("  if (field !== '' || row.length > 0) { row.push(field); rows.push(row); }\n");
    t.push_str("  return rows;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("function toObjects(rows) {\n");
    t.push_str("  var header = rows[0], out = [], r, o, j;\n");
    t.push_str("  for (r = 1; r < rows.length; r++) {\n");
    t.push_str("    o = {};\n");
    t.push_str("    for (j = 0; j < header.length; j++) o[header[j]] = j < rows[r].length ? rows[r][j] : null;\n");
    t.push_str("    out[out.length] = o;\n");
    t.push_str("  }\n");
    t.push_str("  return out;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("var SAMPLE = 'name,city,note\\n\"Okafor, J.\",Lagos,\"said \"\"hi\"\"\"\\r\\nUeda,Kyoto,\\t\u{442}\u{435}\u{441}\u{442}\\u00e9\\n';\n");
    t.push_str("\n");
    t.push_str("if (typeof module !== 'undefined') module.exports = { parseCSV: parseCSV, toObjects: toObjects, SAMPLE: SAMPLE };\n");
    v.push(DataFile { path: "src/lib/csv.js".to_string(), body: t });
    let mut t = String.new();
    t.push_str("// A typed event emitter with once(), off() and async waiting.\n");
    t.push_str("export class Emitter {\n");
    t.push_str("  constructor() {\n");
    t.push_str("    this.listeners = new Map();\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  on(event, fn, { once = false, prepend = false } = {}) {\n");
    t.push_str("    const list = this.listeners.get(event) || [];\n");
    t.push_str("    const entry = { fn, once };\n");
    t.push_str("    prepend ? list.unshift(entry) : list.push(entry);\n");
    t.push_str("    this.listeners.set(event, list);\n");
    t.push_str("    return () => this.off(event, fn);\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  once(event, fn) {\n");
    t.push_str("    return this.on(event, fn, { once: true });\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  off(event, fn) {\n");
    t.push_str("    const list = this.listeners.get(event);\n");
    t.push_str("    if (!list) return false;\n");
    t.push_str("    const i = list.findIndex((e) => e.fn === fn);\n");
    t.push_str("    if (i < 0) return false;\n");
    t.push_str("    list.splice(i, 1);\n");
    t.push_str("    if (list.length === 0) this.listeners.delete(event);\n");
    t.push_str("    return true;\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  emit(event, ...args) {\n");
    t.push_str("    const list = this.listeners.get(event);\n");
    t.push_str("    if (!list) {\n");
    t.push_str("      if (event === 'error') throw args[0] instanceof Error ? args[0] : new Error(String(args[0]));\n");
    t.push_str("      return false;\n");
    t.push_str("    }\n");
    t.push_str("    for (const entry of [...list]) {\n");
    t.push_str("      if (entry.once) this.off(event, entry.fn);\n");
    t.push_str("      entry.fn.apply(this, args);\n");
    t.push_str("    }\n");
    t.push_str("    return true;\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  wait(event, timeoutMs = 0) {\n");
    t.push_str("    return new Promise((resolve, reject) => {\n");
    t.push_str("      let timer;\n");
    t.push_str("      const done = this.once(event, (...args) => {\n");
    t.push_str("        clearTimeout(timer);\n");
    t.push_str("        resolve(args.length <= 1 ? args[0] : args);\n");
    t.push_str("      });\n");
    t.push_str("      if (timeoutMs > 0) {\n");
    t.push_str("        timer = setTimeout(() => {\n");
    t.push_str("          done();\n");
    t.push_str("          reject(new Error(`timed out waiting for ${event} after ${timeoutMs}ms`));\n");
    t.push_str("        }, timeoutMs);\n");
    t.push_str("      }\n");
    t.push_str("    });\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  static mixin(target) {\n");
    t.push_str("    const e = new Emitter();\n");
    t.push_str("    for (const name of ['on', 'once', 'off', 'emit', 'wait']) {\n");
    t.push_str("      target[name] = e[name].bind(e);\n");
    t.push_str("    }\n");
    t.push_str("    return target;\n");
    t.push_str("  }\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("export const bus = new Emitter();\n");
    v.push(DataFile { path: "src/lib/events.js".to_string(), body: t });
}

fn data_part_5(v: mut ref Vec[DataFile]) {
    let mut t = String.new();
    t.push_str("// Iteration helpers: lazy sequences built on generators.\n");
    t.push_str("function* range(start, stop, step = 1) {\n");
    t.push_str("  if (stop === undefined) {\n");
    t.push_str("    [start, stop] = [0, start];\n");
    t.push_str("  }\n");
    t.push_str("  for (let i = start; step > 0 ? i < stop : i > stop; i += step) yield i;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("function* take(n, iterable) {\n");
    t.push_str("  if (n <= 0) return;\n");
    t.push_str("  for (const x of iterable) {\n");
    t.push_str("    yield x;\n");
    t.push_str("    if (--n === 0) return;\n");
    t.push_str("  }\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("function* chunk(iterable, size) {\n");
    t.push_str("  let buf = [];\n");
    t.push_str("  for (const x of iterable) {\n");
    t.push_str("    buf.push(x);\n");
    t.push_str("    if (buf.length === size) {\n");
    t.push_str("      yield buf;\n");
    t.push_str("      buf = [];\n");
    t.push_str("    }\n");
    t.push_str("  }\n");
    t.push_str("  if (buf.length) yield buf;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("function* flatten(iterable, depth = Infinity) {\n");
    t.push_str("  for (const x of iterable) {\n");
    t.push_str("    if (depth > 0 && x != null && typeof x[Symbol.iterator] === 'function' && typeof x !== 'string') {\n");
    t.push_str("      yield* flatten(x, depth - 1);\n");
    t.push_str("    } else {\n");
    t.push_str("      yield x;\n");
    t.push_str("    }\n");
    t.push_str("  }\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("const zip = (...its) => ({\n");
    t.push_str("  *[Symbol.iterator]() {\n");
    t.push_str("    const iters = its.map((it) => it[Symbol.iterator]());\n");
    t.push_str("    while (true) {\n");
    t.push_str("      const steps = iters.map((it) => it.next());\n");
    t.push_str("      if (steps.some((s) => s.done)) return;\n");
    t.push_str("      yield steps.map((s) => s.value);\n");
    t.push_str("    }\n");
    t.push_str("  },\n");
    t.push_str("});\n");
    t.push_str("\n");
    t.push_str("function find2d(grid, target) {\n");
    t.push_str("  let found = null;\n");
    t.push_str("  search: for (let r = 0; r < grid.length; r++) {\n");
    t.push_str("    for (let c = 0; c < grid[r].length; c++) {\n");
    t.push_str("      if (grid[r][c] === target) {\n");
    t.push_str("        found = { r, c };\n");
    t.push_str("        break search;\n");
    t.push_str("      }\n");
    t.push_str("      if (grid[r][c] > target) continue search;\n");
    t.push_str("    }\n");
    t.push_str("  }\n");
    t.push_str("  return found;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("const html = (strings, ...values) =>\n");
    t.push_str("  strings.reduce((out, s, i) => out + s + (i < values.length ? String(values[i]).replace(/[&<>\"]/g, (ch) => `&#${ch.charCodeAt(0)};`) : ''), '');\n");
    t.push_str("\n");
    t.push_str("const row = (cells) => html`<tr>${cells.map((c) => `<td>${c}</td>`).join('')}</tr>`;\n");
    t.push_str("\n");
    t.push_str("const sum = async (promises) => (await Promise.all(promises)).reduce((a, b) => a + b, 0);\n");
    t.push_str("const square = async x => x ** 2;\n");
    t.push_str("let total = 0;\n");
    t.push_str("total **= 2;\n");
    t.push_str("total = void 0, total = typeof total === 'undefined' ? 0 : total;\n");
    t.push_str("\n");
    t.push_str("function Point(x, y) {\n");
    t.push_str("  if (!new.target) return new Point(x, y);\n");
    t.push_str("  this.x = x;\n");
    t.push_str("  this.y = y;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("const base = {\n");
    t.push_str("  greet() { return 'hello'; },\n");
    t.push_str("};\n");
    t.push_str("const derived = {\n");
    t.push_str("  __proto__: base,\n");
    t.push_str("  greet() { return super.greet() + ', world'; },\n");
    t.push_str("};\n");
    v.push(DataFile { path: "src/lib/iter.js".to_string(), body: t });
    let mut t = String.new();
    t.push_str("// A job queue with bounded concurrency and retries (uses class fields).\n");
    t.push_str("import { Emitter } from './events.js';\n");
    t.push_str("\n");
    t.push_str("export class Queue extends Emitter {\n");
    t.push_str("  static defaults = { concurrency: 4, retries: 2, backoffMs: 250 };\n");
    t.push_str("  running = 0;\n");
    t.push_str("  done = 0;\n");
    t.push_str("  failed = 0;\n");
    t.push_str("  pending = [];\n");
    t.push_str("\n");
    t.push_str("  constructor(options = {}) {\n");
    t.push_str("    super();\n");
    t.push_str("    this.options = { ...Queue.defaults, ...options };\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  push(task, meta = {}) {\n");
    t.push_str("    this.pending.push({ task, meta, attempt: 0 });\n");
    t.push_str("    this.emit('queued', meta);\n");
    t.push_str("    this.tick();\n");
    t.push_str("    return this;\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  tick() {\n");
    t.push_str("    while (this.running < this.options.concurrency && this.pending.length > 0) {\n");
    t.push_str("      this.run(this.pending.shift());\n");
    t.push_str("    }\n");
    t.push_str("    if (this.running === 0 && this.pending.length === 0) this.emit('drain', { done: this.done, failed: this.failed });\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  async run(job) {\n");
    t.push_str("    this.running++;\n");
    t.push_str("    try {\n");
    t.push_str("      const value = await job.task(job.meta);\n");
    t.push_str("      this.done++;\n");
    t.push_str("      this.emit('done', job.meta, value);\n");
    t.push_str("    } catch (err) {\n");
    t.push_str("      if (job.attempt < this.options.retries) {\n");
    t.push_str("        job.attempt += 1;\n");
    t.push_str("        const delay = this.options.backoffMs * 2 ** (job.attempt - 1);\n");
    t.push_str("        setTimeout(() => {\n");
    t.push_str("          this.pending.unshift(job);\n");
    t.push_str("          this.tick();\n");
    t.push_str("        }, delay);\n");
    t.push_str("      } else {\n");
    t.push_str("        this.failed++;\n");
    t.push_str("        this.emit('failed', job.meta, err);\n");
    t.push_str("      }\n");
    t.push_str("    } finally {\n");
    t.push_str("      this.running--;\n");
    t.push_str("      this.tick();\n");
    t.push_str("    }\n");
    t.push_str("  }\n");
    t.push_str("\n");
    t.push_str("  get size() {\n");
    t.push_str("    return this.pending.length + this.running;\n");
    t.push_str("  }\n");
    t.push_str("}\n");
    v.push(DataFile { path: "src/lib/queue.js".to_string(), body: t });
}

