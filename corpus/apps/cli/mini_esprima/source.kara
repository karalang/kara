    let mut t = String.new();
    t.push_str("function* g() { yield; yield a; yield* b; x = yield; }\n");
    t.push_str("var yield = 1;\n");
    v.push(DataFile { path: "src/snip/yield_forms.js".to_string(), body: t });
    let mut t = String.new();
    t.push_str("'use strict';\n");
    t.push_str("// node tools/report.js <log> [--top N] [--since YYYY-MM-DD]\n");
    t.push_str("const fs = require('fs');\n");
    t.push_str("const path = require('path');\n");
    t.push_str("const { promisify } = require('util');\n");
    t.push_str("\n");
    t.push_str("const readFile = promisify(fs.readFile);\n");
    t.push_str("const LINE = /^(\\S+) \\S+ \\S+ \\[([^\\]]+)\\] \"(\\w+) ([^\"]*?) HTTP\\/[\\d.]+\" (\\d{3}) (\\d+|-)/;\n");
    t.push_str("\n");
    t.push_str("function parseArgs(argv) {\n");
    t.push_str("  const opts = { top: 10, since: null, files: [] };\n");
    t.push_str("  for (let i = 0; i < argv.length; i++) {\n");
    t.push_str("    const arg = argv[i];\n");
    t.push_str("    switch (arg) {\n");
    t.push_str("      case '--top':\n");
    t.push_str("        opts.top = parseInt(argv[++i], 10);\n");
    t.push_str("        break;\n");
    t.push_str("      case '--since':\n");
    t.push_str("        opts.since = new Date(argv[++i]);\n");
    t.push_str("        break;\n");
    t.push_str("      default:\n");
    t.push_str("        if (arg.startsWith('--')) {\n");
    t.push_str("          throw new Error('unknown option ' + arg);\n");
    t.push_str("        }\n");
    t.push_str("        opts.files.push(path.resolve(arg));\n");
    t.push_str("    }\n");
    t.push_str("  }\n");
    t.push_str("  return opts;\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("function tally(lines, since) {\n");
    t.push_str("  const byPath = Object.create(null);\n");
    t.push_str("  let bytes = 0, errors = 0, skipped = 0;\n");
    t.push_str("  outer: for (const line of lines) {\n");
    t.push_str("    const m = LINE.exec(line);\n");
    t.push_str("    if (!m) {\n");
    t.push_str("      skipped++;\n");
    t.push_str("      continue;\n");
    t.push_str("    }\n");
    t.push_str("    const [, ip, when, method, url, status, size] = m;\n");
    t.push_str("    if (since && new Date(when.replace(':', ' ')) < since) continue outer;\n");
    t.push_str("    const key = method + ' ' + url.split('?')[0];\n");
    t.push_str("    const entry = byPath[key] || (byPath[key] = { hits: 0, bytes: 0, ips: new Set() });\n");
    t.push_str("    entry.hits += 1;\n");
    t.push_str("    entry.ips.add(ip);\n");
    t.push_str("    if (size !== '-') {\n");
    t.push_str("      entry.bytes += +size;\n");
    t.push_str("      bytes += +size;\n");
    t.push_str("    }\n");
    t.push_str("    if (status[0] === '5') errors++;\n");
    t.push_str("  }\n");
    t.push_str("  return { byPath, bytes, errors, skipped };\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("async function main() {\n");
    t.push_str("  const opts = parseArgs(process.argv.slice(2));\n");
    t.push_str("  const texts = await Promise.all(opts.files.map((f) => readFile(f, 'utf8')));\n");
    t.push_str("  const lines = [].concat(...texts.map((t) => t.split(/\\r?\\n/)));\n");
    t.push_str("  const { byPath, bytes, errors, skipped } = tally(lines, opts.since);\n");
    t.push_str("  const rows = Object.keys(byPath)\n");
    t.push_str("    .map((k) => [k, byPath[k]])\n");
    t.push_str("    .sort((a, b) => b[1].hits - a[1].hits || (a[0] < b[0] ? -1 : 1))\n");
    t.push_str("    .slice(0, opts.top);\n");
    t.push_str("  for (const [key, { hits, bytes: b, ips }] of rows) {\n");
    t.push_str("    console.log(`${String(hits).padStart(7)}  ${String(ips.size).padStart(5)}  ${(b / 1024).toFixed(1).padStart(9)}K  ${key}`);\n");
    t.push_str("  }\n");
    t.push_str("  console.log(`${lines.length} lines, ${skipped} skipped, ${errors} 5xx, ${bytes} bytes`);\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("if (require.main === module) {\n");
    t.push_str("  main().catch((err) => {\n");
    t.push_str("    console.error(err.stack || String(err));\n");
    t.push_str("    process.exitCode = 1;\n");
    t.push_str("  });\n");
    t.push_str("}\n");
    t.push_str("\n");
    t.push_str("module.exports = { parseArgs, tally };\n");
    v.push(DataFile { path: "src/tools/report.js".to_string(), body: t });
}
